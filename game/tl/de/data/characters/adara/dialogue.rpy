    # ADARA @ shock "Ah, so soon?"
    ADARA @ shock "Ah, so bald?"

# game/data/characters/adara/dialogue.rpy:24
translate de adara_bye_8c5c4de9:

    # ADARA @ sad "Well ... alright then, I'll see you soon I guess."
    ADARA @ sad "Nun ... in Ordnung dann, ich sehe dich wohl bald."

# game/data/characters/adara/dialogue.rpy:38
translate de adara_talk_howareyou_84011970:

    # ADARA @ sad "Father has been a little more unwell than usual today, so I've been quite busy tending to his health."
    ADARA @ sad "Vater geht es heute ein wenig schlechter als sonst, daher war ich ziemlich damit beschäftigt, mich um seine Gesundheit zu kümmern."

# game/data/characters/adara/dialogue.rpy:40
translate de adara_talk_howareyou_c0e90cb6:

    # ADARA @ talk "Hm? Same as always I suppose..."
    ADARA @ talk "Hm? Wie immer, nehme ich an..."

# game/data/characters/adara/dialogue.rpy:42
translate de adara_talk_howareyou_666024d3:

    # ADARA @ smile "I am well, [player_name!t], thank you for asking."
    ADARA @ smile "Mir geht es gut, [player_name!t], danke der Nachfrage."

# game/data/characters/adara/dialogue.rpy:44
translate de adara_talk_howareyou_7fe3643a:

    # ADARA @ talk "Did you hear about the commotion in the pleasure district? Some kind of ... {i}monster{/i} attacked one of the gangs, at least, that's the rumour."
    ADARA @ talk "Hast du von dem Aufruhr im Vergnügungsviertel gehört? Eine Art ... {i}Monster{/i} hat eine der Banden angegriffen, zumindest geht das Gerücht."

# game/data/characters/adara/dialogue.rpy:46
translate de adara_talk_howareyou_0c7cccc7:

    # ADARA @ smile "I am well thank you! Have you seen that new market stall selling Ramonian food? It's very popular!"
    ADARA @ smile "Mir geht es gut, danke! Hast du den neuen Marktstand gesehen, der ramonisches Essen verkauft? Er ist sehr beliebt!"

# game/data/characters/adara/dialogue.rpy:48
translate de adara_talk_howareyou_003c1185:

    # ADARA @ smile "You're making quite a name for yourself, aren't you? Congratulations on moving up ranks in the adventurers guild!"
    ADARA @ smile "Du machst dir einen ganz schönen Namen, nicht wahr? Herzlichen Glückwunsch zum Aufstieg in der Abenteurergilde!"

