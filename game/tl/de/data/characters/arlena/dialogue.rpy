translate de arlena_room_first_entry_341a0073:

    # "Arlena's boxed room was compact but filled with drawings of schematics littered all about the place."
    "Arlenas kastenförmiges Zimmer war kompakt, aber voller Zeichnungen von Schaltplänen, die überall verstreut waren."

# game/data/characters/arlena/dialogue.rpy:33
translate de arlena_room_first_entry_9caafbc0:

    # "Here and there were the essentials, a single soft straw bed, a draw for some clothes and a workbench for her to sit at."
    "Hier und da gab es das Nötigste: ein einzelnes weiches Strohbett, eine Schublade für Kleidung und eine Werkbank, an der sie sitzen konnte."

# game/data/characters/arlena/dialogue.rpy:37
translate de arlena_room_first_entry_07a0d7a5:

    # MC "{b}OUCH!{/b}"
    MC "{b}Autsch!{/b}"

# game/data/characters/arlena/dialogue.rpy:38
translate de arlena_room_first_entry_3d8c7c56:

    # ARLENA @ angry "[player_name!t]?! Fucking idiot, what's wrong with you sneaking around like that?!"
    ARLENA @ angry "[player_name!t]?! Verdammter Idiot, was fällt dir ein, dich so herumzuschleichen?!"

# game/data/characters/arlena/dialogue.rpy:39
translate de arlena_room_first_entry_d49d44c5:

    # MC "Sorry! The door was unlocked..."
    MC "Tut mir leid! Die Tür war nicht abgeschlossen..."

# game/data/characters/arlena/dialogue.rpy:40
translate de arlena_room_first_entry_e4a3cc26:

    # MC "Did you just hit me with a-"
    MC "Hast du mich gerade mit einem-"

# game/data/characters/arlena/dialogue.rpy:41
translate de arlena_room_first_entry_2e815ce5:

    # ARLENA @ angry "YES! A stool!"
    ARLENA @ angry "JA! Ein Hocker!"

# game/data/characters/arlena/dialogue.rpy:42
translate de arlena_room_first_entry_eaf74097:

    # "Surprisingly, Arlena seemed to cool down right before my eyes."
    "Überraschenderweise schien sich Arlena direkt vor meinen Augen zu beruhigen."

# game/data/characters/arlena/dialogue.rpy:43
translate de arlena_room_first_entry_1d9cbd20:

    # "Perhaps I really {i}did{/i} sneak up on her."
    "Vielleicht habe ich mich {i}wirklich{/i} an sie herangeschlichen."

# game/data/characters/arlena/dialogue.rpy:44
translate de arlena_room_first_entry_c8d99ccc:

    # ARLENA "Anyway, welcome to my High Castle."
    ARLENA "Wie dem auch sei, willkommen in meiner Hohen Burg."

# game/data/characters/arlena/dialogue.rpy:45
translate de arlena_room_first_entry_bf198958:

    # ARLENA "I sketch out some of the more unique designs for armour and weapons here."
    ARLENA "Ich skizziere hier einige der einzigartigeren Designs für Rüstungen und Waffen."

# game/data/characters/arlena/dialogue.rpy:46
translate de arlena_room_first_entry_648653a1:

    # ARLENA "There is something else I’ve been working on too..."
    ARLENA "Es gibt noch etwas anderes, woran ich auch gearbeitet habe..."

# game/data/characters/arlena/dialogue.rpy:47
translate de arlena_room_first_entry_49a216f8:

    # ARLENA "Now if you don't mind, I'd rather get back to work."
    ARLENA "Wenn es dir nichts ausmacht, würde ich lieber wieder an die Arbeit gehen."

# game/data/characters/arlena/dialogue.rpy:49
translate de arlena_room_first_entry_1eed06d6:

    # ARLENA "...idiot."
    ARLENA "...Idiot."

