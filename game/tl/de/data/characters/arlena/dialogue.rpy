    # ARLENA "Yes? What is it?"
    ARLENA "Ja? Was gibt es?"

# game/data/characters/arlena/dialogue.rpy:62
translate de arlena_bye_8b373c54:

    # ARLENA "Alright, see ya 'round."
    ARLENA "Alles klar, man sieht sich."

