# game/data/characters/arwen/dialogue.rpy:76
translate de arwen_talk_celeste_6d79cabc:

    # MC @ talk "Hey Arwen."
    MC @ talk "Hey Arwen."

# game/data/characters/arwen/dialogue.rpy:77
translate de arwen_talk_celeste_324c5a69:

    # ARWEN @ talk "Why hello there brave adventurer!"
    ARWEN @ talk "Na hallo, tapferer Abenteurer!"

# game/data/characters/arwen/dialogue.rpy:78
translate de arwen_talk_celeste_30f5cc47:

    # ARWEN @ talk "Tell me, {i}how much coin would you pay to spend a night with the beautiful Celeste?{/i}"
    ARWEN @ talk "Sag mal, {i}wie viel Gold würdest du bezahlen, um eine Nacht mit der schönen Celeste zu verbringen?{/i}"

# game/data/characters/arwen/dialogue.rpy:79
translate de arwen_talk_celeste_4f6d740f:

    # ARWEN @ talk "Actually, don't even answer that!"
    ARWEN @ talk "Eigentlich, antworte gar nicht erst darauf!"

# game/data/characters/arwen/dialogue.rpy:80
translate de arwen_talk_celeste_da29d70f:

    # ARWEN @ talk "We both know that such priceless things would be worth their weight in gold... {i}till now.{/i}"
    ARWEN @ talk "Wir wissen beide, dass solch unbezahlbare Dinge ihr Gewicht in Gold wert wären... {i}bis jetzt.{/i}"

# game/data/characters/arwen/dialogue.rpy:85
translate de arwen_bye_cel_84e04ea5:

    # ARWEN @ talk "Very well."
    ARWEN @ talk "Na schön."

# game/data/characters/arwen/dialogue.rpy:89
translate de arwen_whyCeleste_259711d9:

    # ARWEN @ laugh "Because... {i}Who doesn't want to fuck the most beautiful, famous heroine around?{/i}"
    ARWEN @ laugh "Denn... {i}Wer will nicht die schönste, berühmteste Heldin weit und breit ficken?{/i}"

# game/data/characters/arwen/dialogue.rpy:90
translate de arwen_whyCeleste_9530a2ec:

    # ARWEN @ talk "People will pay whatever I ask if they think they'll get at least a taste of what it might be like to have her."
    ARWEN @ talk "Die Leute zahlen, was immer ich verlange, wenn sie denken, dass sie wenigstens einen Vorgeschmack darauf bekommen, wie es wäre, sie zu haben."

# game/data/characters/arwen/dialogue.rpy:91
translate de arwen_whyCeleste_e7a80d41:

    # ARWEN @ talk "Fantasy is a powerful thing... The reality of something rarely meets the expectation."
    ARWEN @ talk "Fantasie ist eine mächtige Sache... Die Realität von etwas entspricht selten der Erwartung."

# game/data/characters/arwen/dialogue.rpy:92
translate de arwen_whyCeleste_67cb03f1:

    # MC @ talk "Very insightful of you."
    MC @ talk "Sehr scharfsinnig von dir."

# game/data/characters/arwen/dialogue.rpy:93
translate de arwen_whyCeleste_aa10a873:

    # ARWEN @ laugh "I try."
    ARWEN @ laugh "Ich gebe mir Mühe."

# game/data/characters/arwen/dialogue.rpy:97
translate de dialogue_arwen_services_cel_ec508417:

    # ARWEN @ talk "Fifteen hundred coins and {i}Celeste{/i} is all yours."
    ARWEN @ talk "Fünfzehnhundert Münzen und {i}Celeste{/i} gehört ganz dir."

# game/data/characters/arwen/dialogue.rpy:98
translate de dialogue_arwen_services_cel_8b30ba46:

    # MC @ talk "That's more than your normal rates..."
    MC @ talk "Das ist mehr als deine üblichen Preise..."

# game/data/characters/arwen/dialogue.rpy:99
translate de dialogue_arwen_services_cel_779f3c4e:

    # ARWEN @ angry "Do you know how much this outfit cost to make?"
    ARWEN @ angry "Weißt du, wie viel dieses Outfit gekostet hat?"

# game/data/characters/arwen/dialogue.rpy:100
translate de dialogue_arwen_services_cel_0f93cc2b:

    # ARWEN @ talk "Plus all the rallies and things I had to attend to learn to act like her a bit."
    ARWEN @ talk "Außerdem all die Kundgebungen und Dinge, an denen ich teilnehmen musste, um ein bisschen wie sie zu handeln."

# game/data/characters/arwen/dialogue.rpy:101
translate de dialogue_arwen_services_cel_84c11618:

    # ARWEN @ laugh "Besides... I offer a {i}unique{/i} experience unlike what my clients normally get."
    ARWEN @ laugh "Außerdem... biete ich eine {i}einzigartige{/i} Erfahrung, anders als das, was meine Kunden normalerweise bekommen."

# game/data/characters/arwen/dialogue.rpy:102
translate de dialogue_arwen_services_cel_c7c5bcc5:

    # ARWEN @ talk "So, fifteen hundred. Interested?"
    ARWEN @ talk "Also, fünfzehnhundert. Interessiert?"

# game/data/characters/arwen/dialogue.rpy:105
translate de dialogue_arwen_services_cel_67a3c006:

    # ARWEN @ talk "Then if you don't mind, other customers are waiting."
    ARWEN @ talk "Dann, wenn es dir nichts ausmacht, warten andere Kunden."

