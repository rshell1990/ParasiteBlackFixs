translate de dialogue_arwen_othergirls_d6300ee5:

    # ARWEN @ talk "Tell me darling, who in all of Mirnos would you want to talk about them... when {i}I'm{/i} by your side?"
    ARWEN @ talk "Sag mir, Liebling, mit wem in ganz Mirnos würdest du über sie reden wollen ... wenn {i}ich{/i} an deiner Seite bin?"

# game/data/characters/arwen/scr_dialogue.rpy:5
translate de dialogue_arwen_othergirls_menu_bbb61fd6:

    # ARWEN @ blush "Gods... I bet you have half the women in this city wrapped around your finger, don't you handsome?"
    ARWEN @ blush "Götter ... ich wette, du hast die Hälfte der Frauen in dieser Stadt um den Finger gewickelt, nicht wahr, Hübscher?"

# game/data/characters/arwen/scr_dialogue.rpy:6
translate de dialogue_arwen_othergirls_menu_e8995dc3:

    # MC @ smile "{i}Would you like to be wrapped around my finger, Arwen?{/i}"
    MC @ smile "{i}Möchtest du um meinen Finger gewickelt sein, Arwen?{/i}"

# game/data/characters/arwen/scr_dialogue.rpy:7
translate de dialogue_arwen_othergirls_menu_7bca3054:

    # ARWEN @ laugh "Haha! Alright..."
    ARWEN @ laugh "Haha! In Ordnung ..."

# game/data/characters/arwen/scr_dialogue.rpy:8
translate de dialogue_arwen_othergirls_menu_bcc3804b:

    # ARWEN @ talk "What do you want to know?"
    ARWEN @ talk "Was möchtest du wissen?"

# game/data/characters/arwen/scr_dialogue.rpy:11
translate de dialogue_arwen_othergirls_menu_f72c231a:

    # ARWEN @ talk "Well... Now you're speaking a girls favourite language!"
    ARWEN @ talk "Nun ... jetzt sprichst du die Lieblingssprache eines Mädchens!"

# game/data/characters/arwen/scr_dialogue.rpy:13
translate de dialogue_arwen_othergirls_menu_ab602309:

    # ARWEN @ talk "Was there someone specific you wanted to ask about?"
    ARWEN @ talk "Gab es jemand Bestimmtes, über den du etwas fragen wolltest?"

# game/data/characters/arwen/scr_dialogue.rpy:16
translate de dialogue_arwen_othergirls_menu_paid_5c4b33c4:

    # ARWEN @ angry "Hm? Oh, {i}her{/i} I'd avoid her if I was you."
    ARWEN @ angry "Hm? Oh, {i}sie{/i} ... ich würde sie meiden, wenn ich du wäre."

# game/data/characters/arwen/scr_dialogue.rpy:17
translate de dialogue_arwen_othergirls_menu_paid_d42b7565:

    # ARWEN @ angry "Overpriced to put it mildly, you'd think she was a virgin princess with how highly she views herself."
    ARWEN @ angry "Überteuert, um es milde auszudrücken, man könnte meinen, sie wäre eine jungfräuliche Prinzessin, so hoch, wie sie sich selbst einschätzt."

# game/data/characters/arwen/scr_dialogue.rpy:18
translate de dialogue_arwen_othergirls_menu_paid_1950d15a:

    # ARWEN @ blush "Don't worry though, I'll show you what a {i}real{/i} woman can do."
    ARWEN @ blush "Keine Sorge, ich zeige dir, was eine {i}richtige{/i} Frau kann."

# game/data/characters/arwen/scr_dialogue.rpy:21
translate de dialogue_arwen_othergirls_menu_paid_77c1d01c:

    # ARWEN @ think "Hmm, nice enough girl."
    ARWEN @ think "Hmm, ganz nettes Mädchen."

# game/data/characters/arwen/scr_dialogue.rpy:22
translate de dialogue_arwen_othergirls_menu_paid_879dd5c5:

    # ARWEN @ talk "But I think she's a little {i}too{/i} desperate to work in here."
    ARWEN @ talk "Aber ich glaube, sie ist ein wenig {i}zu{/i} verzweifelt, um hier zu arbeiten."

# game/data/characters/arwen/scr_dialogue.rpy:23
translate de dialogue_arwen_othergirls_menu_paid_35cb4a19:

    # ARWEN @ talk "As far as I know, they let her stay and serve clients outside for a reduced rate, but I doubt she'll get through the door."
    ARWEN @ talk "Soweit ich weiß, lassen sie sie draußen bleiben und Kunden zu einem reduzierten Preis bedienen, aber ich bezweifle, dass sie durch die Tür kommt."

# game/data/characters/arwen/scr_dialogue.rpy:24
translate de dialogue_arwen_othergirls_menu_paid_da22f4ce:

    # MC @ talk "Why's that?"
    MC @ talk "Warum das?"

# game/data/characters/arwen/scr_dialogue.rpy:25
translate de dialogue_arwen_othergirls_menu_paid_8e2a16c2:

    # ARWEN @ talk "Look around you, we're not the {i}Black Diamond,{/i} we general serve adventurers and merchants with coin to burn."
    ARWEN @ talk "Schau dich um, wir sind nicht der {i}Black Diamond,{/i} wir bedienen meist Abenteurer und Händler mit Geld zum Verbrennen."

# game/data/characters/arwen/scr_dialogue.rpy:26
translate de dialogue_arwen_othergirls_menu_paid_e4fcf857:

    # ARWEN @ talk "And she's out there letting the city guard take put it in her ass behind a wall... Hardly a good fit."
    ARWEN @ talk "Und sie da draußen lässt sich von der Stadtwache hinter einer Mauer den Arsch besorgen... Kaum eine gute Wahl."

# game/data/characters/arwen/scr_dialogue.rpy:27
translate de dialogue_arwen_othergirls_menu_paid_33eafac5:

    # MC @ talk "That seems rather harsh..."
    MC @ talk "Das scheint ziemlich hart..."

# game/data/characters/arwen/scr_dialogue.rpy:28
translate de dialogue_arwen_othergirls_menu_paid_8c61c9e1:

    # ARWEN @ talk "It's just business darling... it's always cut-throat, no matter the trade."
    ARWEN @ talk "Es ist nur Geschäft, Liebling... es geht immer knallhart zu, egal in welcher Branche."

# game/data/characters/arwen/scr_dialogue.rpy:31
translate de dialogue_arwen_othergirls_menu_paid_480f5c90:

    # ARWEN @ talk "Alright then, was there something else?"
    ARWEN @ talk "Also gut, gab es sonst noch etwas?"

# game/data/characters/arwen/scr_dialogue.rpy:34
translate de dialogue_arwen_othergirls_menu_paid_7417b5c7:

    # ARWEN @ talk "Alright then, let's hear it."
    ARWEN @ talk "Also gut, dann lass hören."

