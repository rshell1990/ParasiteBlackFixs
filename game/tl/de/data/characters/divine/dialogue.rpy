# TODO: Translation updated at 2026-08-04 03:41

# game/data/characters/divine/dialogue.rpy:28
translate de divine_talk_90c8d59c:

    # DIVINE "How can I help you, child?"
    DIVINE "Wie kann ich dir helfen, Kind?"

# game/data/characters/divine/dialogue.rpy:33
translate de divine_bye_65c4d26d:

    # DIVINE "Be well, child."
    DIVINE "Sei gesund, Kind."

# game/data/characters/divine/dialogue.rpy:38
translate de divine_questions1_528d4f7e:

    # DIVINE "You’ve come here for a lesson?"
    DIVINE "Bist du wegen einer Lektion hierhergekommen?"

# game/data/characters/divine/dialogue.rpy:39
translate de divine_questions1_b6ffd923:

    # MC "I know the basics..."
    MC "Ich kenne die Grundlagen..."

# game/data/characters/divine/dialogue.rpy:40
translate de divine_questions1_81705d71:

    # DIVINE "... It is said the great goddess Palam was born Palon, God of Love."
    DIVINE "... Man sagt, die große Göttin Palam wurde als Palon, Gott der Liebe, geboren."

# game/data/characters/divine/dialogue.rpy:41
translate de divine_questions1_2fb56672:

    # DIVINE "Palon watched and meddled in the romantic affairs of both our realm and the realm of the gods. "
    DIVINE "Palon beobachtete die romantischen Angelegenheiten sowohl unseres Reiches als auch des Reiches der Götter und mischte sich ein."

# game/data/characters/divine/dialogue.rpy:42
translate de divine_questions1_1687c0e9:

    # DIVINE "Uniting couples rarely thought a good match by many, but he always knew better."
    DIVINE "Er vereinte Paare, die von vielen selten als gute Verbindung angesehen wurden, aber er wusste es immer besser."

# game/data/characters/divine/dialogue.rpy:43
translate de divine_questions1_197036a6:

    # DIVINE "... But Palon was displeased with his form... He wanted his outer beauty to reflect the inner love he lavished upon us Alderians."
    DIVINE "... Aber Palon war mit seiner Form unzufrieden... Er wollte, dass seine äußere Schönheit die innere Liebe widerspiegelt, mit der er uns Alderianer überschüttete."

# game/data/characters/divine/dialogue.rpy:44
translate de divine_questions1_d31444e6:

    # DIVINE "Envious of the female forms around him and feeling trapped in despair at the male form he occupied, he cast himself into the Great Blue Lagoon, emerging as the beautiful goddess Palam."
    DIVINE "Neidisch auf die weiblichen Gestalten um ihn herum und gefangen in Verzweiflung über die männliche Form, die er bewohnte, stürzte er sich in die Große Blaue Lagune und tauchte als die schöne Göttin Palam wieder auf."

# game/data/characters/divine/dialogue.rpy:45
translate de divine_questions1_88ca4f57:

    # DIVINE "The great goddess Palam bestows upon those born with her favour the greatest powers of healing in the realm."
    DIVINE "Die große Göttin Palam verleiht denen, die mit ihrer Gunst geboren werden, die größten Heilkräfte im Reich."

# game/data/characters/divine/dialogue.rpy:46
translate de divine_questions1_91554ae3:

    # DIVINE "Through her wisdom and guidance, our bodies are also changed to her desired form."
    DIVINE "Durch ihre Weisheit und Führung werden auch unsere Körper in ihre gewünschte Form verwandelt."

# game/data/characters/divine/dialogue.rpy:47
translate de divine_questions1_7a9989a8:

    # MC "Is that why all the mages under her blessing were born as... born as..."
    MC "Ist das der Grund, warum alle Magier unter ihrem Segen als... als..."

# game/data/characters/divine/dialogue.rpy:48
translate de divine_questions1_d23314df:

    # DIVINE "... Men?"
    DIVINE "... Männer?"

# game/data/characters/divine/dialogue.rpy:49
translate de divine_questions1_07266d13:

    # MC "Yes."
    MC "Ja."

# game/data/characters/divine/dialogue.rpy:50
translate de divine_questions1_8241ba3e:

    # DIVINE "We all were once... But once the change has begun there is little difference."
    DIVINE "Wir alle waren es einmal... Aber sobald die Veränderung begonnen hat, gibt es kaum einen Unterschied."

# game/data/characters/divine/dialogue.rpy:51
translate de divine_questions1_85be0231:

    # MC "But you have... {i}*Cough*{/i}"
    MC "Aber du hast... {i}*Hust*{/i}"

# game/data/characters/divine/dialogue.rpy:52
translate de divine_questions1_7aa6d0fb:

    # "Sister Divine raised an eyebrow and smirked as I tripped over the words. "
    "Schwester Divine hob eine Augenbraue und grinste, als ich über die Worte stolperte."

# game/data/characters/divine/dialogue.rpy:53
translate de divine_questions1_84878a10:

    # DIVINE "{i}Both sets?{/i}"
    DIVINE "{i}Beide Sätze?{/i}"

# game/data/characters/divine/dialogue.rpy:54
translate de divine_questions1_054508a6:

    # MC "U-Uhh... Well..."
    MC "Ä-Äh... Nun..."

# game/data/characters/divine/dialogue.rpy:55
translate de divine_questions1_cf86a073:

    # MC "That... must be difficult."
    MC "Das... muss schwierig sein."

# game/data/characters/divine/dialogue.rpy:56
translate de divine_questions1_365ffb04:

    # "Sister Divine smiled mischievously as she leaned forward."
    "Schwester Divine lächelte verschmitzt, als sie sich vorbeugte."

# game/data/characters/divine/dialogue.rpy:57
translate de divine_questions1_b1140467:

    # DIVINE "If you’re that curious, why don’t you ask one of our mages?"
    DIVINE "Wenn du so neugierig bist, warum fragst du nicht einen unserer Magier?"

# game/data/characters/divine/dialogue.rpy:58
translate de divine_questions1_1c2f036e:

    # DIVINE "Our goddess, unlike most, demands we take no vows of chastity, you know..."
    DIVINE "Unsere Göttin, anders als die meisten, verlangt von uns kein Keuschheitsgelübde, weißt du ..."

# game/data/characters/divine/dialogue.rpy:59
translate de divine_questions1_61f8f826:

    # "Sister Divine playfully winked before her back straightened once again."
    "Schwester Divine zwinkerte spielerisch, bevor sich ihr Rücken wieder aufrichtete."

# game/data/characters/divine/dialogue.rpy:62
translate de divine_questions1_f399730a:

    # "She laughed at the comment."
    "Sie lachte über die Bemerkung."

# game/data/characters/divine/dialogue.rpy:63
translate de divine_questions1_eea35513:

    # DIVINE "{i}Interesting...{/i}"
    DIVINE "{i}Interessant ...{/i}"

# game/data/characters/divine/dialogue.rpy:64
translate de divine_questions1_04e3a2bf:

    # "Her eyes scanned over me, almost dismissively."
    "Ihre Augen musterten mich, fast abweisend."

# game/data/characters/divine/dialogue.rpy:70
translate de divine_questions2_3054d177:

    # DIVINE "There is only ever a few hundred of us at one time... As the goddess wills..."
    DIVINE "Es gibt nur immer ein paar Hundert von uns gleichzeitig ... Wie die Göttin will ..."

# game/data/characters/divine/dialogue.rpy:71
translate de divine_questions2_5a08631f:

    # MC "Why?"
    MC "Warum?"

# game/data/characters/divine/dialogue.rpy:72
translate de divine_questions2_ef2c2d25:

    # DIVINE "We do not know... Only some are chosen, it’s not our place to question her decisions."
    DIVINE "Wir wissen es nicht ... Nur einige werden auserwählt, es steht uns nicht zu, ihre Entscheidungen zu hinterfragen."

# game/data/characters/divine/dialogue.rpy:77
translate de divine_firstmeet_28ad9124:

    # "The beautiful Mages of Palam, for all accounts were still human, though no cursory glance would make this obvious."
    "Die schönen Magierinnen von Palam, denn sie waren in jeder Hinsicht noch menschlich, auch wenn dies auf den ersten Blick nicht offensichtlich war."

# game/data/characters/divine/dialogue.rpy:78
translate de divine_firstmeet_18aa2714:

    # "Born with the blessings of the goddess Palam, their bodies were morphed and now bore a blue complexion the goddess’ divine will moulds those chosen into her most desired form and then blesses them with her gift of divine healing."
    "Geboren mit den Segnungen der Göttin Palam, wurden ihre Körper verwandelt und trugen nun eine blaue Hautfarbe, der göttliche Wille der Göttin formt die Auserwählten in ihre begehrteste Gestalt und segnet sie dann mit ihrer Gabe der göttlichen Heilung."

# game/data/characters/divine/dialogue.rpy:79
translate de divine_firstmeet_587bb450:

    # "It is a place of ancient tradition, libraries of books piled high and strange hieroglyphs and runes on the floor in chalk that glowed different shades. "
    "Es ist ein Ort uralter Tradition, voller Bibliotheken mit hoch gestapelten Büchern und seltsamen Hieroglyphen und Runen auf dem Boden, mit Kreide gezeichnet, die in verschiedenen Farbtönen leuchteten."

# game/data/characters/divine/dialogue.rpy:80
translate de divine_firstmeet_67703533:

    # "Taking centre stage was a great statue of the goddess Palam, her arms and wings outstretched. Here and there I glimpsed robed figures, their soft, blue faces barely visible before they quickly shuffled away with their spell books. "
    "Im Mittelpunkt stand eine große Statue der Göttin Palam, ihre Arme und Flügel ausgebreitet. Hin und wieder erhaschte ich einen Blick auf vermummte Gestalten, deren sanfte, blaue Gesichter kaum zu sehen waren, bevor sie schnell mit ihren Zauberbüchern davoneilten."

# game/data/characters/divine/dialogue.rpy:81
translate de divine_firstmeet_95f6331a:

    # "A voice called out, sultry, but mature with age. "
    "Eine Stimme rief, verführerisch, aber reif vor Alter."

# game/data/characters/divine/dialogue.rpy:82
translate de divine_firstmeet_216aba99:

    # UNKNOWN "... Quite the sight, is it not?"
    UNKNOWN "... Ein beeindruckender Anblick, nicht wahr?"

# game/data/characters/divine/dialogue.rpy:84
translate de divine_firstmeet_44548582:

    # "I turned to look at the beautiful figure before me."
    "Ich drehte mich um, um die wunderschöne Gestalt vor mir anzusehen."

# game/data/characters/divine/dialogue.rpy:85
translate de divine_firstmeet_696b9602:

    # MC "Oh, I’m sorry I didn’t see you there, sister."
    MC "Oh, Entschuldigung, ich habe Sie dort nicht gesehen, Schwester."

# game/data/characters/divine/dialogue.rpy:86
translate de divine_firstmeet_d9b3b42c:

    # DIVINE "You may call me Sister Divine... Now..."
    DIVINE "Du darfst mich Schwester Divine nennen... Nun..."

