    # DRAX "No, that won't do."
    DRAX "Nein, das reicht nicht."

# game/data/characters/drax/dialogue.rpy:91
translate de drax_bronzeDeliverRepeat_f30b4de7:

    # DRAX "Come back after you've scavenged more bronze."
    DRAX "Komm zurück, nachdem du mehr Bronze gesammelt hast."

