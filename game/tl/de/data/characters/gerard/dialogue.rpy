# game/data/characters/gerard/dialogue.rpy:46
translate de gerard_firstmeet_5344a7f6:

    # "Upon seeing me, Gerard, Adara's father withdrew further into his seat."
    "Als Gerard, Adaras Vater, mich sah, zog er sich weiter in seinen Sitz zurück."

# game/data/characters/gerard/dialogue.rpy:48
translate de gerard_firstmeet_c4349c69:

    # GERARD @ shock "Who... Who are you?"
    GERARD @ shock "Wer... Wer bist du?"

# game/data/characters/gerard/dialogue.rpy:49
translate de gerard_firstmeet_5d03fbc4:

    # GERARD @ angry "What are you doing in my home?"
    GERARD @ angry "Was machst du in meinem Haus?"

# game/data/characters/gerard/dialogue.rpy:50
translate de gerard_firstmeet_473b8004:

    # MC @ surprised "Gerard, it's me! It's [player_name!t]!"
    MC @ surprised "Gerard, ich bin's! Es ist [player_name!t]!"

# game/data/characters/gerard/dialogue.rpy:51
translate de gerard_firstmeet_dc142611:

    # "Gerard's eyes wandered over me from top to bottom, as though unconvinced."
    "Gerards Blicke wanderten über mich von oben bis unten, als ob er nicht überzeugt wäre."

# game/data/characters/gerard/dialogue.rpy:52
translate de gerard_firstmeet_a01e7045:

    # "Then, when the realization hit, he smiled brightly."
    "Dann, als ihm die Erkenntnis kam, lächelte er strahlend."

# game/data/characters/gerard/dialogue.rpy:53
translate de gerard_firstmeet_863787d9:

    # GERARD @ happy "Ah! [player_name!t]! It's good to see you!"
    GERARD @ happy "Ah! [player_name!t]! Schön, dich zu sehen!"

# game/data/characters/gerard/dialogue.rpy:54
translate de gerard_firstmeet_c419d1f7:

    # MC @ smile "Hello. Gerard, how do you fair?"
    MC @ smile "Hallo. Gerard, wie geht es dir?"

# game/data/characters/gerard/dialogue.rpy:55
translate de gerard_firstmeet_1d579dac:

    # "Adara's father coughed and spluttered before offering a faint, sickly smile."
    "Adaras Vater hustete und stotterte, bevor er ein schwaches, kränkliches Lächeln anbot."

# game/data/characters/gerard/dialogue.rpy:56
translate de gerard_firstmeet_4ff4c591:

    # GERARD @ happy "I struggle to move around much these days, but I keep going all the same."
    GERARD @ happy "Ich kämpfe damit, mich heutzutage viel zu bewegen, aber ich mache trotzdem weiter."

# game/data/characters/gerard/dialogue.rpy:57
translate de gerard_firstmeet_31bef116:

    # GERARD @ shock "By the gods though, you've changed!"
    GERARD @ shock "Bei den Göttern, du hast dich aber verändert!"

# game/data/characters/gerard/dialogue.rpy:58
translate de gerard_firstmeet_0db8be50:

    # MC @ smile "Ah, well, a lot's happened since you last saw me..."
    MC @ smile "Ah, nun ja, es ist viel passiert, seit du mich das letzte Mal gesehen hast..."

# game/data/characters/gerard/dialogue.rpy:59
translate de gerard_firstmeet_58db3fa1:

    # "Adara emerged from the upstairs, calling out to her father."
    "Adara kam aus dem oberen Stockwerk und rief nach ihrem Vater."

# game/data/characters/gerard/dialogue.rpy:61
translate de gerard_firstmeet_0ea16926:

    # ADARA @ talk "Father, I've prepared your bed for-"
    ADARA @ talk "Vater, ich habe dein Bett vorbereitet für-"

# game/data/characters/gerard/dialogue.rpy:62
translate de gerard_firstmeet_3a50d24d:

    # "Adara's eyes widened when she saw me."
    "Adaras Augen weiteten sich, als sie mich sah."

# game/data/characters/gerard/dialogue.rpy:63
translate de gerard_firstmeet_a6a414a3:

    # ADARA @ shock "[player_name!t]!"
    ADARA @ shock "[player_name!t]!"

# game/data/characters/gerard/dialogue.rpy:65
translate de gerard_firstmeet_a9ee7ae1:

    # ADARA "W-What are you doing here?"
    ADARA "W-Was machst du hier?"

# game/data/characters/gerard/dialogue.rpy:66
translate de gerard_firstmeet_fb51ca06:

    # GERARD "Yes, that is a good question..."
    GERARD "Ja, das ist eine gute Frage..."

# game/data/characters/gerard/dialogue.rpy:67
translate de gerard_firstmeet_9ba588d3:

    # GERARD "What brings you here, [player_name!t]?"
    GERARD "Was führt dich hierher, [player_name!t]?"

# game/data/characters/gerard/dialogue.rpy:68
translate de gerard_firstmeet_821aecf2:

    # MC @ lewd "Ah, I actually came to see how Adara was doing..."
    MC @ lewd "Ah, ich bin eigentlich gekommen, um zu sehen, wie es Adara geht..."

# game/data/characters/gerard/dialogue.rpy:69
translate de gerard_firstmeet_63c7d2ef:

    # "Adara's cheeks burned red as her father looked back and forth from me to her."
    "Adaras Wangen brannten rot, als ihr Vater hin und her von mir zu ihr blickte."

# game/data/characters/gerard/dialogue.rpy:70
translate de gerard_firstmeet_e0dd8443:

    # ADARA "Y-You don't need to trouble yourself worrying about me."
    ADARA "D-Du musst dir keine Sorgen um mich machen."

# game/data/characters/gerard/dialogue.rpy:71
translate de gerard_firstmeet_0cc6e9de:

    # "Gerard smiled and nodded."
    "Gerard lächelte und nickte."

# game/data/characters/gerard/dialogue.rpy:72
translate de gerard_firstmeet_475bdcd4:

    # GERARD @ happy "Well, you're welcome in our home anytime, [player_name!t]."
    GERARD @ happy "Nun, du bist jederzeit in unserem Zuhause willkommen, [player_name!t]."

# game/data/characters/gerard/dialogue.rpy:73
translate de gerard_firstmeet_fb898fac:

    # GERARD @ happy "Now when are you going to make an honest woman of my daughter?"
    GERARD @ happy "Wann wirst du endlich eine ehrbare Frau aus meiner Tochter machen?"

# game/data/characters/gerard/dialogue.rpy:74
translate de gerard_firstmeet_229b9884:

    # "Adara's eyes widened in horror."
    "Adaras Augen weiteten sich vor Entsetzen."

# game/data/characters/gerard/dialogue.rpy:75
translate de gerard_firstmeet_0f68b999:

    # ADARA @ shock "FATHER!"
    ADARA @ shock "VATER!"

# game/data/characters/gerard/dialogue.rpy:76
translate de gerard_firstmeet_90918178:

    # MC @ surprised "U-Uhh...!"
    MC @ surprised "Ä-Ähm...!"

# game/data/characters/gerard/dialogue.rpy:77
translate de gerard_firstmeet_abf6ffcf:

    # "Gerard laughed, and that laugh soon turned into another cough and splutter."
    "Gerard lachte, und das Lachen verwandelte sich bald in erneutes Husten und Prusten."

# game/data/characters/gerard/dialogue.rpy:78
translate de gerard_firstmeet_c596294a:

    # GERARD @ happy "What? You two have known each other since you were small, I always {i}presumed{/i} it was coming one day."
    GERARD @ happy "Was? Ihr beiden kennt euch seit ihr klein wart, ich bin immer davon {i}ausgegangen{/i}, dass es eines Tages passieren würde."

# game/data/characters/gerard/dialogue.rpy:79
translate de gerard_firstmeet_1dcbc052:

    # ADARA "W-We're just friends, that's all."
    ADARA "W-Wir sind nur Freunde, das ist alles."

# game/data/characters/gerard/dialogue.rpy:80
translate de gerard_firstmeet_771eca78:

    # GERARD "Friends, hm?"
    GERARD "Freunde, hm?"

# game/data/characters/gerard/dialogue.rpy:81
translate de gerard_firstmeet_1900663f:

    # GERARD "Me and your mother used to say the same-"
    GERARD "Ich und deine Mutter haben früher das Gleiche gesagt-"

# game/data/characters/gerard/dialogue.rpy:83
translate de gerard_firstmeet_3ba1263d:

    # "Adara's father began to cough and splutter once again, the persistent cough this time refusing to let up."
    "Adaras Vater begann erneut zu husten und zu prusten, der hartnäckige Husten ließ dieses Mal nicht nach."

# game/data/characters/gerard/dialogue.rpy:84
translate de gerard_firstmeet_3a531e08:

    # "Adara gave Gerard some water and gently rubbed his back."
    "Adara gab Gerard etwas Wasser und rieb sanft seinen Rücken."

# game/data/characters/gerard/dialogue.rpy:85
translate de gerard_firstmeet_f37451d8:

    # GERARD "Urghh ... I need some more rest it seems."
    GERARD "Urghh ... Ich brauche wohl noch etwas Ruhe."

# game/data/characters/gerard/dialogue.rpy:86
translate de gerard_firstmeet_dc85f7a9:

