# game/data/characters/giselra/dialogue.rpy:22
translate de giselra_talk_firstmeet_14cc07a6:

    # "The tailor's voice called from the back of the store."
    "Die Stimme der Schneiderin rief aus dem hinteren Teil des Ladens."

# game/data/characters/giselra/dialogue.rpy:23
translate de giselra_talk_firstmeet_97f4d434:

    # GISELRA "One moment please!"
    GISELRA "Einen Moment bitte!"

# game/data/characters/giselra/dialogue.rpy:24
translate de giselra_talk_firstmeet_e38541a5:

    # "I turned slowly, looking at the many intricately crafted dresses on display."
    "Ich drehte mich langsam um und betrachtete die vielen aufwendig gearbeiteten Kleider, die ausgestellt waren."

# game/data/characters/giselra/dialogue.rpy:25
translate de giselra_talk_firstmeet_a05f0e9d:

    # "Whoever this tailor was, she was indeed of exceptional skill."
    "Wer auch immer diese Schneiderin war, sie besaß tatsächlich außergewöhnliches Geschick."

# game/data/characters/giselra/dialogue.rpy:26
translate de giselra_talk_firstmeet_e71e1997:

    # "I heard soft footsteps, turning my head as an older, black woman stepped forward,"
    "Ich hörte leise Schritte und drehte den Kopf, als eine ältere, schwarze Frau vortrat,"

# game/data/characters/giselra/dialogue.rpy:27
translate de giselra_talk_firstmeet_cfa5b9c1:

    # "With an infectiously warm smile, she greeted me."
    "Mit einem ansteckend warmen Lächeln begrüßte sie mich."

# game/data/characters/giselra/dialogue.rpy:29
translate de giselra_talk_firstmeet_44893887:

    # GISELRA @ smile "Welcome to Giselra's handsome."
    GISELRA @ smile "Willkommen bei Giselra, Hübscher."

# game/data/characters/giselra/dialogue.rpy:30
translate de giselra_talk_firstmeet_ec7dbf09:

    # GISELRA @ smile "The finest tailor in ALL of Hamun."
    GISELRA @ smile "Die beste Schneiderin in GANZ Hamun."

# game/data/characters/giselra/dialogue.rpy:31
translate de giselra_talk_firstmeet_e5ba6b5b:

    # MC @ smile "The finest you say?"
    MC @ smile "Die beste, sagen Sie?"

# game/data/characters/giselra/dialogue.rpy:32
translate de giselra_talk_firstmeet_e713de8a:

    # GISELRA @ talk "Of course, whatever clothes you desire, I can see them crafted."
    GISELRA @ talk "Natürlich, welche Kleidung auch immer Sie sich wünschen, ich kann sie anfertigen lassen."

# game/data/characters/giselra/dialogue.rpy:33
translate de giselra_talk_firstmeet_ddff3fa8:

    # GISELRA @ smile "{i}For a price, of course...{/i}"
    GISELRA @ smile "{i}Für einen Preis, natürlich...{/i}"

# game/data/characters/giselra/dialogue.rpy:34
translate de giselra_talk_firstmeet_c79a39bc:

    # GISELRA @ talk "Let me know if my services are of used."
    GISELRA @ talk "Lass es mich wissen, falls meine Dienste nützlich sind."

# game/data/characters/giselra/dialogue.rpy:35
translate de giselra_talk_firstmeet_81658a7e:

    # MC @ talk "Will do."
    MC @ talk "Wird gemacht."

# game/data/characters/giselra/dialogue.rpy:37
translate de giselra_talk_firstmeet_f8120a53:

    # MC "(Always handy to know a good tailor.)"
    MC "(Immer praktisch, einen guten Schneider zu kennen.)"

# game/data/characters/giselra/dialogue.rpy:44
translate de giselra_talk_a70b638e:

    # GISELRA @ shock "Welcome to Giselra’s!"
    GISELRA @ shock "Willkommen bei Giselra!"

# game/data/characters/giselra/dialogue.rpy:45
translate de giselra_talk_c34ff831:

    # GISELRA @ smile "Looking for something tailored, perhaps?"
    GISELRA @ smile "Auf der Suche nach etwas Maßgeschneidertem, vielleicht?"

# game/data/characters/giselra/dialogue.rpy:50
translate de giselra_bye_412dc7b0:

    # GISELRA @ smile "Bye, lovely."
    GISELRA @ smile "Tschüss, Schönheit."

