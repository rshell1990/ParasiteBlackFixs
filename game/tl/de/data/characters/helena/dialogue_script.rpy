# game/data/characters/helena/dialogue_script.rpy:4
translate de nov_helena_firstmeet_a4c50776:

    # HELENA @ talk "Ahh, good evening sir."
    HELENA @ talk "Ahh, guten Abend, Sir."

# game/data/characters/helena/dialogue_script.rpy:5
translate de nov_helena_firstmeet_fcddae28:

    # HELENA @ talk "How do you find yourself this Evening?"
    HELENA @ talk "Wie geht es Ihnen an diesem Abend?"

# game/data/characters/helena/dialogue_script.rpy:6
translate de nov_helena_firstmeet_e63ccf3e:

    # HELENA @ smile "I am Helena, and yourself?"
    HELENA @ smile "Ich bin Helena, und Sie?"

# game/data/characters/helena/dialogue_script.rpy:7
translate de nov_helena_firstmeet_638d46d2:

    # MC @ talk "A pleasure to meet you Helena, I am called [player_name!t]."
    MC @ talk "Es freut mich, Sie kennenzulernen, Helena. Ich heiße [player_name!t]."

# game/data/characters/helena/dialogue_script.rpy:8
translate de nov_helena_firstmeet_48a9321b:

    # HELENA @ talk "Hmm, your name sounds familiar..."
    HELENA @ talk "Hmm, Ihr Name kommt mir bekannt vor..."

# game/data/characters/helena/dialogue_script.rpy:9
translate de nov_helena_firstmeet_4659a883:

    # HELENA @ shock "Wait, I know of you."
    HELENA @ shock "Moment, ich habe von Ihnen gehört."

# game/data/characters/helena/dialogue_script.rpy:10
translate de nov_helena_firstmeet_e1f13c50:

    # HELENA @ talk "You and your friend are the scouts who survived the recent expedition."
    HELENA @ talk "Sie und Ihr Freund sind die Späher, die die jüngste Expedition überlebt haben."

# game/data/characters/helena/dialogue_script.rpy:11
translate de nov_helena_firstmeet_d2fa7c7f:

    # HELENA @ lewd "I see they did not exagerrate when they spoke of how handsome you are."
    HELENA @ lewd "Ich sehe, sie haben nicht übertrieben, als sie davon sprachen, wie gutaussehend Sie sind."

# game/data/characters/helena/dialogue_script.rpy:17
translate de nov_helena_services_c3c21da7:

    # HELENA @ talk "I am afraid my services aren't for you."
    HELENA @ talk "Ich fürchte, meine Dienste sind nichts für Sie."

# game/data/characters/helena/dialogue_script.rpy:18
translate de nov_helena_services_c513028d:

    # MC @ talk "Wait, what?"
    MC @ talk "Moment, was?"

# game/data/characters/helena/dialogue_script.rpy:19
translate de nov_helena_services_46c3977b:

    # HELENA @ smile "My clients are a small reserved of a certain social class."
    HELENA @ smile "Meine Klienten sind ein kleiner Kreis einer bestimmten sozialen Schicht."

# game/data/characters/helena/dialogue_script.rpy:20
translate de nov_helena_services_1a47015e:

    # HELENA @ talk "Only a certain social class I'm afraid."
    HELENA @ talk "Nur eine bestimmte soziale Schicht, fürchte ich."

# game/data/characters/helena/dialogue_script.rpy:21
translate de nov_helena_services_2a12bf32:

    # MC @ talk "You mean aristocrats and nobles then?"
    MC @ talk "Du meinst also Aristokraten und Adelige?"

# game/data/characters/helena/dialogue_script.rpy:22
translate de nov_helena_services_052927c7:

    # HELENA @ lewd2 "Not necessarily... I make special priced exceptions for men who have truly carved out a name for themselves."
    HELENA @ lewd2 "Nicht unbedingt... Ich mache preisliche Ausnahmen für Männer, die sich wirklich einen Namen gemacht haben."

# game/data/characters/helena/dialogue_script.rpy:23
translate de nov_helena_services_074a27e5:

    # HELENA @ smile "Men who get tongues wagging when they see me speaking with them."
    HELENA @ smile "Männer, über die die Leute ins Tuscheln geraten, wenn sie mich mit ihnen sprechen sehen."

# game/data/characters/helena/dialogue_script.rpy:24
translate de nov_helena_services_aa047f0d:

    # MC @ talk "Such as?"
    MC @ talk "Zum Beispiel?"

# game/data/characters/helena/dialogue_script.rpy:25
translate de nov_helena_services_a5c33d70:

    # HELENA @ smile "I never kiss and tell."
    HELENA @ smile "Ich küsse und erzähle nicht."

# game/data/characters/helena/dialogue_script.rpy:26
translate de nov_helena_services_ca2c4f8b:

    # HELENA @ joy "But let's just say some adventurers who'd rather have their names kept a secret have come to me before."
    HELENA @ joy "Aber sagen wir einfach, einige Abenteurer, die ihre Namen lieber geheim halten würden, sind schon zu mir gekommen."

# game/data/characters/helena/dialogue_script.rpy:27
translate de nov_helena_services_60e8bb1f:

    # MC @ talk "Humor me, what are your normal prices."
    MC @ talk "Amüsiere mich, was sind deine normalen Preise."

# game/data/characters/helena/dialogue_script.rpy:28
translate de nov_helena_services_e1271a49:

    # HELENA @ smile "A night with me would cost you more than ten thousand coins."
    HELENA @ smile "Eine Nacht mit mir würde dich mehr als zehntausend Münzen kosten."

# game/data/characters/helena/dialogue_script.rpy:29
translate de nov_helena_services_74ca5542:

    # "I felt the blood drain from my face."
    "Ich spürte, wie mir das Blut aus dem Gesicht wich."

# game/data/characters/helena/dialogue_script.rpy:30
translate de nov_helena_services_0449bb90:

    # MC @ talk "T-Ten... thousand?"
    MC @ talk "Z-Zehn... tausend?"

# game/data/characters/helena/dialogue_script.rpy:31
translate de nov_helena_services_99b30993:

    # MC @ talk "What about charging per act?"
    MC @ talk "Was ist mit einer Abrechnung pro Akt?"

# game/data/characters/helena/dialogue_script.rpy:32
translate de nov_helena_services_307909da:

    # HELENA @ talk "I'm afraid such a thing is far more becoming of a common whore than a courtesan."
    HELENA @ talk "Ich fürchte, so etwas steht einer gewöhnlichen Hure viel eher an als einer Kurtisane."

# game/data/characters/helena/dialogue_script.rpy:33
translate de nov_helena_services_9bb1df98:

    # HELENA @ talk "The clients a courtesan takes on expect us to be more reserved and discreit, our bodies not used by every passing traveler."
    HELENA @ talk "Die Klienten, die eine Kurtisane annimmt, erwarten von uns, dass wir zurückhaltender und diskreter sind und unsere Körper nicht von jedem vorbeikommenden Reisenden benutzt werden."

# game/data/characters/helena/dialogue_script.rpy:34
translate de nov_helena_services_f2a6779b:

    # HELENA @ sad "Such a thing could ruin a courtesan's reputation should she behave like an ordinary lady of the night."
    HELENA @ sad "So etwas könnte den Ruf einer Kurtisane ruinieren, wenn sie sich wie eine gewöhnliche Dirne verhält."

# game/data/characters/helena/dialogue_script.rpy:35
translate de nov_helena_services_326690ca:

    # HELENA @ talk "Thus, our companionship is sold for the whole evening... Partly to avoid too much scrutiny."
    HELENA @ talk "Daher wird unsere Begleitung für den ganzen Abend verkauft... Teilweise, um zu viel Aufmerksamkeit zu vermeiden."

# game/data/characters/helena/dialogue_script.rpy:36
translate de nov_helena_services_dc064c48:

    # HELENA @ smile "And sometimes our clients simply want us to be a delight on their arms and make other lords and such jealous."
    HELENA @ smile "Und manchmal wollen unsere Klienten einfach, dass wir eine Zierde an ihrem Arm sind und andere Adlige und dergleichen eifersüchtig machen."

# game/data/characters/helena/dialogue_script.rpy:37
translate de nov_helena_services_dd4dfd06:

    # MC @ talk "Hmm, I see."
    MC @ talk "Hmm, ich verstehe."

# game/data/characters/helena/dialogue_script.rpy:38
translate de nov_helena_services_771bb20d:

    # MC "(Unless I want to spend a small fortune on her, I'll need to build my reputation through adventuring and such before she offers me better rates for her 'sevices'.)"
    MC "(Es sei denn, ich will ein kleines Vermögen für sie ausgeben, dann muss ich meinen Ruf durch Abenteuer und Ähnliches aufbauen, bevor sie mir bessere Preise für ihre 'Dienste' anbietet.)"

# game/data/characters/helena/dialogue_script.rpy:42
translate de nov_helena_about_a754025e:

    # HELENA @ talk "Hm? I prefer to keep my past to myself... I find men are more drawn to what they see as some alluring mystery."
    HELENA @ talk "Hm? Ich behalte meine Vergangenheit lieber für mich ... Ich finde, Männer fühlen sich eher zu dem hingezogen, was sie für ein verlockendes Geheimnis halten."

# game/data/characters/helena/dialogue_script.rpy:43
translate de nov_helena_about_8999f46f:

    # HELENA @ lewd2 "Perhaps one day I will tell you."
    HELENA @ lewd2 "Vielleicht werde ich es dir eines Tages erzählen."

# game/data/characters/helena/dialogue_script.rpy:47
translate de nov_helena_bye_a0f4734c:

    # HELENA @ talk "Speak soon."
    HELENA @ talk "Bis bald."

