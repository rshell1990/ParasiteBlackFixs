# game/data/characters/katiya/dialogue.rpy:74
translate de katiya_store_talk_6f815309:

    # KATIYA "How may Katiya help you today?"
    KATIYA "Wie kann Katiya dir heute helfen?"

# game/data/characters/katiya/dialogue.rpy:81
translate de katiya_trade_ffd38123:

    # KATIYA "Katiya has many things to show... For a price."
    KATIYA "Katiya hat viele Dinge zu zeigen... Für einen Preis."

# game/data/characters/katiya/dialogue.rpy:83
translate de katiya_trade_e3565c59:

    # KATIYA "You will be back soon, I can tell!"
    KATIYA "Du wirst bald zurück sein, das merke ich!"

# game/data/characters/katiya/dialogue.rpy:88
translate de katiya_bye_72bda86e:

    # KATIYA "Sure, feel free to."
    KATIYA "Klar, nur zu."

# game/data/characters/katiya/dialogue.rpy:93
translate de katiya_good_alderian_6eda821e:

    # KATIYA "Is that so?"
    KATIYA "Ist das so?"

# game/data/characters/katiya/dialogue.rpy:94
translate de katiya_good_alderian_66a4d476:

    # KATIYA "My father is Alderian, he taught me to speak your tongue well from a young age."
    KATIYA "Mein Vater ist Alderianer, er hat mir von klein auf beigebracht, deine Sprache fließend zu sprechen."

# game/data/characters/katiya/dialogue.rpy:95
translate de katiya_good_alderian_fd9e21cd:

    # MC @ smile "Oh, that’s impressive."
    MC @ smile "Oh, das ist beeindruckend."

# game/data/characters/katiya/dialogue.rpy:96
translate de katiya_good_alderian_38d06199:

    # MC @ talk "Is your father still well?"
    MC @ talk "Geht es deinem Vater noch gut?"

# game/data/characters/katiya/dialogue.rpy:97
translate de katiya_good_alderian_785bcc2d:

    # KATIYA "Tsch... He is a drunkard who left me and my mother for some Alderian merchants daughter."
    KATIYA "Tsch... Er ist ein Trunkenbold, der mich und meine Mutter für die Tochter eines alderianischen Kaufmanns verlassen hat."

# game/data/characters/katiya/dialogue.rpy:98
translate de katiya_good_alderian_832c1e56:

    # MC @ sad "Oh, I’m... Sorry."
    MC @ sad "Oh, es tut mir... leid."

# game/data/characters/katiya/dialogue.rpy:99
translate de katiya_good_alderian_78167e0b:

    # KATIYA "It is life. Many daughters have had worse fathers."
    KATIYA "So ist das Leben. Viele Töchter hatten schon schlimmere Väter."

# game/data/characters/katiya/dialogue.rpy:103
translate de katiya_flash_ask_3b52cb1a:

    # KATIYA "Fifty coins and I’ll let you look, but no touch."
    KATIYA "Fünfzig Münzen und ich lasse dich schauen, aber nicht anfassen."

# game/data/characters/katiya/dialogue.rpy:107
translate de katiya_flash_ask_c6b8d76d:

    # KATIYA "Enjoy thinking about them tonight ~"
    KATIYA "Genieße es, heute Nacht an sie zu denken ~"

# game/data/characters/katiya/dialogue.rpy:117
translate de katiya_flash_ask_c84964e3:

    # KATIYA "When you have the coin, you let me know."
    KATIYA "Wenn du die Münze hast, lass es mich wissen."

