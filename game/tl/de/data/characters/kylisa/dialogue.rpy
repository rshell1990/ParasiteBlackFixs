# game/data/characters/kylisa/dialogue.rpy:37
translate de kylisa_talk_985be56a:

    # KYLISA @ talk "You have returned... How may I help you?"
    KYLISA @ talk "Ihr seid zurückgekehrt... Wie kann ich Euch helfen?"

# game/data/characters/kylisa/dialogue.rpy:42
translate de kylisa_bye_9bb97fc5:

    # KYLISA @ talk "May the blessings of the gods be with you."
    KYLISA @ talk "Mögen die Segnungen der Götter mit Euch sein."

# game/data/characters/kylisa/dialogue.rpy:46
translate de kylisa_whoareyou_52dd919a:

    # KYLISA @ talk "I am the royal Mage, but given the... {i}change in leadership,{/i}"
    KYLISA @ talk "Ich bin der königliche Magier, aber angesichts des... {i}Führungswechsels,{/i}"

# game/data/characters/kylisa/dialogue.rpy:47
translate de kylisa_whoareyou_e97fcb71:

    # KYLISA @ talk "I now serve at the Emperor's pleasure."
    KYLISA @ talk "Ich diene nun zur Zufriedenheit des Kaisers."

# game/data/characters/kylisa/dialogue.rpy:50
translate de kylisa_whoareyou_d2173e34:

    # KYLISA @ angry "You should be careful asking such questions..."
    KYLISA @ angry "Ihr solltet vorsichtig sein, solche Fragen zu stellen..."

# game/data/characters/kylisa/dialogue.rpy:51
translate de kylisa_whoareyou_32ed9419:

    # KYLISA @ angry "One could take that question the wrong way."
    KYLISA @ angry "Man könnte diese Frage falsch auffassen."

# game/data/characters/kylisa/dialogue.rpy:52
translate de kylisa_whoareyou_b11273ac:

    # MC @ talk "Forgive me, I did not mean any ill with it."
    MC @ talk "Verzeiht mir, ich habe es nicht böse gemeint."

# game/data/characters/kylisa/dialogue.rpy:53
translate de kylisa_whoareyou_94c63cb9:

    # KYLISA @ sad "...He was kinder."
    KYLISA @ sad "...Er war gütiger."

# game/data/characters/kylisa/dialogue.rpy:54
translate de kylisa_whoareyou_037383db:

    # KYLISA @ sad "Most talk of how Alcott saved us all and Mesamore would have doomed us all."
    KYLISA @ sad "Die meisten sprechen davon, wie Alcott uns alle gerettet hat und Mesamore uns alle ins Verderben gestürzt hätte."

# game/data/characters/kylisa/dialogue.rpy:55
translate de kylisa_whoareyou_badfec21:

    # KYLISA @ sad "But many forget how we prospered under Mesamore before."
    KYLISA @ sad "Aber viele vergessen, wie wir zuvor unter Mesamore gediehen."

# game/data/characters/kylisa/dialogue.rpy:56
translate de kylisa_whoareyou_676e62d6:

    # KYLISA @ sad "He was a kind king, one determined to tackle poverty in ways his predecessors never did, and life was good under him."
    KYLISA @ sad "Er war ein gütiger König, einer, der entschlossen war, die Armut auf eine Weise zu bekämpfen, wie es seine Vorgänger nie getan hatten, und das Leben unter ihm war gut."

# game/data/characters/kylisa/dialogue.rpy:57
translate de kylisa_whoareyou_e9272224:

    # KYLISA @ sad "He may not he been the strongest military mind, but what king could have ever been prepared for the threat of the Demorai in such short notice?"
    KYLISA @ sad "Er mochte nicht der stärkste militärische Denker gewesen sein, aber welcher König hätte jemals auf eine solche Bedrohung durch die Demorai in so kurzer Zeit vorbereitet sein können?"

# game/data/characters/kylisa/dialogue.rpy:58
translate de kylisa_whoareyou_86eb7477:

    # KYLISA @ talk "Alcott tried time and time again to push for more control over the lives of the realms citizens, and each time, Mesamore pushed back."
    KYLISA @ talk "Alcott versuchte immer wieder, mehr Kontrolle über das Leben der Bürger des Reiches zu erlangen, und jedes Mal wehrte sich Mesamore dagegen."

# game/data/characters/kylisa/dialogue.rpy:59
translate de kylisa_whoareyou_66935207:

    # KYLISA @ talk "Despite the war he faced, Mesamore always wanted us to see a future beyond it, he never wanted the realm to become nothing but the violent war machine it is today."
    KYLISA @ talk "Trotz des Krieges, dem er sich stellen musste, wollte Mesamore immer, dass wir eine Zukunft jenseits davon sehen, er wollte nie, dass das Reich zu nichts anderem wird als der gewalttätigen Kriegsmaschine, die es heute ist."

# game/data/characters/kylisa/dialogue.rpy:60
translate de kylisa_whoareyou_c2947f18:

    # KYLISA @ sad "Now? We are all just expendable pieces for a meat grinder as we fight inch by inch for every piece of land."
    KYLISA @ sad "Jetzt? Wir sind alle nur entbehrliche Teilchen für einen Fleischwolf, während wir Zoll für Zoll um jedes Stück Land kämpfen."

# game/data/characters/kylisa/dialogue.rpy:61
translate de kylisa_whoareyou_bd6b1af1:

    # KYLISA @ talk "There are no names remembered anymore when it comes to the war council, just numbers... Numbers thrown against other numbers."
    KYLISA @ talk "Es werden keine Namen mehr erinnert, wenn es um den Kriegsrat geht, nur Zahlen... Zahlen, die gegen andere Zahlen geworfen werden."

# game/data/characters/kylisa/dialogue.rpy:62
translate de kylisa_whoareyou_36931427:

    # MC @ talk "But did we have any other choice?"
    MC @ talk "Aber hatten wir eine andere Wahl?"

# game/data/characters/kylisa/dialogue.rpy:63
translate de kylisa_whoareyou_5d28ca3c:

    # KYLISA @ talk "In stopping the war? No... I feel that it was inevitable."
    KYLISA @ talk "Den Krieg aufzuhalten? Nein... Ich habe das Gefühl, dass er unvermeidlich war."

# game/data/characters/kylisa/dialogue.rpy:64
translate de kylisa_whoareyou_e82d8ab8:

    # KYLISA @ angry "In what we've {i}become{/i} trying to win this war? Absolutely."
    KYLISA @ angry "In dem, was wir {i}geworden{/i} sind, um diesen Krieg zu gewinnen? Absolut."

# game/data/characters/kylisa/dialogue.rpy:66
translate de kylisa_whoareyou_f9be3333:

    # KYLISA @ talk "Speak your mind."
    KYLISA @ talk "Sag deine Meinung."

# game/data/characters/kylisa/dialogue.rpy:73
translate de kylisa_blessing_2e104e0a:

    # "Kylisa paused for a moment, then replied calmly:"
    "Kylisa hielt einen Moment inne und antwortete dann ruhig:"

# game/data/characters/kylisa/dialogue.rpy:74
translate de kylisa_blessing_c2d9f055:

    # KYLISA @ talk "The gods seem to already stand by your side, [player_name!t]."
    KYLISA @ talk "Die Götter scheinen bereits an deiner Seite zu stehen, [player_name!t]."

# game/data/characters/kylisa/dialogue.rpy:81
translate de kylisa_cleansing_12864e63:

    # KYLISA @ talk "The old or the new?"
    KYLISA @ talk "Die alten oder die neuen?"

# game/data/characters/kylisa/dialogue.rpy:82
translate de kylisa_cleansing_1d31c4e5:

    # MC @ talk "Whoever will listen."
    MC @ talk "Wer auch immer zuhören wird."

# game/data/characters/kylisa/dialogue.rpy:83
translate de kylisa_cleansing_afaa155c:

    # KYLISA @ talk "I may grant you their blessing..."
    KYLISA @ talk "Ich mag dir ihren Segen gewähren..."

# game/data/characters/kylisa/dialogue.rpy:84
translate de kylisa_cleansing_2ac6342c:

    # "She raised her head a bit, and from beneath her hood I saw a pair of glaring eyes, scanning into the very depths of my soul."
    "Sie hob den Kopf ein wenig, und unter ihrer Kapuze sah ich ein Paar funkelnder Augen, die in die tiefsten Tiefen meiner Seele blickten."

# game/data/characters/kylisa/dialogue.rpy:85
translate de kylisa_cleansing_83721d0b:

    # "A gentle, barely-noticeable pulse of energy waved through my entire body, followed by a harsh, painful jitter:"
    "Ein sanfter, kaum spürbarer Energiepuls durchlief meinen ganzen Körper, gefolgt von einem harschen, schmerzhaften Zittern:"

# game/data/characters/kylisa/dialogue.rpy:86
translate de kylisa_cleansing_28a75444:

    # BLACK "{b}THAT'S CLOSE ENOUGH.{/b}"
    BLACK "{b}DAS IST NAHE GENUG.{/b}"

# game/data/characters/kylisa/dialogue.rpy:87
translate de kylisa_cleansing_9dfd0bef:

    # "Kylisa took half-a step back and murmured to herself:"
    "Kylisa trat einen halben Schritt zurück und murmelte vor sich hin:"

# game/data/characters/kylisa/dialogue.rpy:88
translate de kylisa_cleansing_3b48ba2d:

    # KYLISA @ talk "That energy... It is not Demorai, yet so strong..."
    KYLISA @ talk "Diese Energie... Sie ist nicht Demorai, doch so stark..."

# game/data/characters/kylisa/dialogue.rpy:89
translate de kylisa_cleansing_f9a3b82b:

    # "She recomposed herself and concluded:"
    "Sie sammelte sich wieder und schloss:"

# game/data/characters/kylisa/dialogue.rpy:90
translate de kylisa_cleansing_f6b8311c:

    # KYLISA @ talk "I don't know what exactly you came in contact with, [player_name!t], but I might be able to help."
    KYLISA @ talk "Ich weiß nicht, womit genau du in Kontakt gekommen bist, [player_name!t], aber ich könnte vielleicht helfen."

# game/data/characters/kylisa/dialogue.rpy:91
translate de kylisa_cleansing_e98a2fd8:

    # KYLISA @ talk "I believe I can douse this... black flame that is devouring your soul."
    KYLISA @ talk "Ich glaube, ich kann diese... schwarze Flamme löschen, die deine Seele verschlingt."

# game/data/characters/kylisa/dialogue.rpy:92
translate de kylisa_cleansing_cdf02e73:

    # "I gulped at the 'devouring' part."
    "Ich schluckte bei dem Wort 'verschlingt'."

# game/data/characters/kylisa/dialogue.rpy:93
translate de kylisa_cleansing_df3a112b:

    # KYLISA @ talk "I can only do so much as to set back it's {i}progress{/i}."
    KYLISA @ talk "Ich kann nur so viel tun, um seinen {i}Fortschritt{/i} zurückzusetzen."

# game/data/characters/kylisa/dialogue.rpy:94
translate de kylisa_cleansing_d7f274bb:

    # KYLISA @ talk "Five hundred coin."
    KYLISA @ talk "Fünfhundert Münzen."

# game/data/characters/kylisa/dialogue.rpy:97
translate de kylisa_cleansing_1d60de78:

    # KYLISA @ talk "I can help you douse the black flame, [player_name!t]."
    KYLISA @ talk "Ich kann dir helfen, die schwarze Flamme zu löschen, [player_name!t]."

# game/data/characters/kylisa/dialogue.rpy:98
translate de kylisa_cleansing_38174cec:

    # KYLISA @ talk "You should seek a more... permanent solution though, for I can see the flame leaving it's scorching marks on your soul as we speak."
    KYLISA @ talk "Du solltest allerdings eine... dauerhaftere Lösung suchen, denn ich kann sehen, wie die Flamme schon jetzt ihre sengenden Spuren auf deiner Seele hinterlässt."

# game/data/characters/kylisa/dialogue.rpy:99
translate de kylisa_cleansing_d7f274bb_1:

    # KYLISA @ talk "Five hundred coin."
    KYLISA @ talk "Fünfhundert Münzen."

# game/data/characters/kylisa/dialogue.rpy:101
translate de kylisa_cleansing_4f3629c4:

    # KYLISA @ talk "I cannot do this again, [player_name!t]."
    KYLISA @ talk "Ich kann das nicht noch einmal machen, [player_name!t]."

# game/data/characters/kylisa/dialogue.rpy:102
translate de kylisa_cleansing_9e0beb61:

    # KYLISA @ talk "I need to regain my strength."
    KYLISA @ talk "Ich muss meine Kraft wiedererlangen."

# game/data/characters/kylisa/dialogue.rpy:103
translate de kylisa_cleansing_70884999:

    # KYLISA @ talk "Come find me tomorrow, I will help you with your... condition."
    KYLISA @ talk "Komm morgen zu mir, ich helfe dir bei deinem... Zustand."

# game/data/characters/kylisa/dialogue.rpy:104
translate de kylisa_cleansing_6188caea:

    # MC @ talk "I see."
    MC @ talk "Ich verstehe."

# game/data/characters/kylisa/dialogue.rpy:110
translate de kylisa_cleansing_27517054:

    # "Pain began to quickly consume my body just as Kylisa raised her staff and pointed it at me:"
    "Schmerz begann, meinen Körper schnell zu verzehren, gerade als Kylisa ihren Stab hob und ihn auf mich richtete:"

# game/data/characters/kylisa/dialogue.rpy:118
translate de kylisa_cleansing_2a9f7495:

    # KYLISA @ talk "It is done."
    KYLISA @ talk "Es ist vollbracht."

# game/data/characters/kylisa/dialogue.rpy:119
translate de kylisa_cleansing_700ec46a:

    # "Feeling refreshed and... in control again, I exhaled."
    "Erfrischt und... wieder unter Kontrolle, hauchte ich aus."

# game/data/characters/kylisa/dialogue.rpy:120
translate de kylisa_cleansing_ec3d2f8f:

    # MC @ talk "Thanks, Kylisa."
    MC @ talk "Danke, Kylisa."

# game/data/characters/kylisa/dialogue.rpy:121
translate de kylisa_cleansing_3b24004c:

    # KYLISA @ talk "It is my pleasure, [player_name!t]."
    KYLISA @ talk "Es ist mir ein Vergnügen, [player_name!t]."

# game/data/characters/kylisa/dialogue.rpy:124
translate de kylisa_cleansing_51095b9f:

    # KYLISA @ talk "Very well."
    KYLISA @ talk "Sehr gut."

# game/data/characters/kylisa/dialogue.rpy:128
translate de kylisa_teachmeaboutgods_585e28d8:

    # KYLISA @ talk "One would hope your education would have taught you this already."
    KYLISA @ talk "Man würde hoffen, deine Erziehung hätte dir dies bereits beigebracht."

# game/data/characters/kylisa/dialogue.rpy:129
translate de kylisa_teachmeaboutgods_47f46502:

    # MC @ talk "It has been some time since I last read the holy text... I could do with a refresher."
    MC @ talk "Es ist einige Zeit her, seit ich das heilige Buch das letzte Mal gelesen habe... Ich könnte eine Auffrischung gebrauchen."

# game/data/characters/kylisa/dialogue.rpy:130
translate de kylisa_teachmeaboutgods_4913f092:

    # KYLISA @ talk "Very well, what do you wish to know about?"
    KYLISA @ talk "Sehr gut, worüber möchtest du etwas wissen?"

# game/data/characters/kylisa/dialogue.rpy:133
translate de kylisa_teachmeaboutgods_menu_fd8d020e:

    # KYLISA @ talk "In the beginning, Al'Vazah, the great creator, formed the old gods and gave them dominion across the stars."
    KYLISA @ talk "Am Anfang formte Al'Vazah, der große Schöpfer, die alten Götter und gab ihnen Herrschaft über die Sterne."

# game/data/characters/kylisa/dialogue.rpy:134
translate de kylisa_teachmeaboutgods_menu_82262e83:

    # KYLISA @ talk "As life flourished, the old gods grew accustomed to their worship, and saw themselves as higher beings who became obsessed with their own power games against each other."
    KYLISA @ talk "Als das Leben erblühte, gewöhnten sich die alten Götter an ihre Verehrung und sahen sich als höhere Wesen, die besessen von ihren eigenen Machtspielen gegeneinander wurden."

# game/data/characters/kylisa/dialogue.rpy:135
translate de kylisa_teachmeaboutgods_menu_3f1a19fe:

    # KYLISA @ talk "The old gods would often toy with those they viewed as lesser beings, and could only be roused to help with the offer of bargains and sacrifices."
    KYLISA @ talk "Die alten Götter spielten oft mit denen, die sie als niedere Wesen betrachteten, und konnten nur durch Opfergaben und Handel dazu bewegt werden, zu helfen."

# game/data/characters/kylisa/dialogue.rpy:136
translate de kylisa_teachmeaboutgods_menu_d2783f91:

    # KYLISA @ talk "Al'Vazah, displeased with what had become of the old gods, formed the new gods and also gave them powerful dominions to rule across the stars."
    KYLISA @ talk "Al'Vazah, unzufrieden mit dem, was aus den alten Göttern geworden war, formte die neuen Götter und gab auch ihnen mächtige Reiche, um über die Sterne zu herrschen."

# game/data/characters/kylisa/dialogue.rpy:137
translate de kylisa_teachmeaboutgods_menu_581b3849:

    # KYLISA @ talk "The new gods in contrast, believed it was their duty to guide the mortal races to a higher state of being."
    KYLISA @ talk "Die neuen Götter hingegen glaubten, es sei ihre Pflicht, die sterblichen Rassen zu einem höheren Zustand des Seins zu führen."

# game/data/characters/kylisa/dialogue.rpy:138
translate de kylisa_teachmeaboutgods_menu_7964fec4:

    # KYLISA @ talk "They openly chose to walk amongst us, and pull back the veil of secrecy that the old gods always maintained."
    KYLISA @ talk "Sie entschieden sich offen dafür, unter uns zu wandeln und den Schleier der Geheimhaltung zu lüften, den die alten Götter stets aufrechterhalten hatten."

# game/data/characters/kylisa/dialogue.rpy:139
translate de kylisa_teachmeaboutgods_menu_b4f9b1d2:

    # KYLISA @ talk "Threatened, the old gods battled the new gods for supremacy in a great war we now know as the first war of the gods."
    KYLISA @ talk "Bedroht kämpften die alten Götter gegen die neuen Götter um die Vorherrschaft in einem großen Krieg, den wir heute als den ersten Krieg der Götter kennen."

# game/data/characters/kylisa/dialogue.rpy:140
translate de kylisa_teachmeaboutgods_menu_69aae19d:

    # KYLISA @ talk "The new gods emerged victorious, led Al'Vazah's champion and the most powerful of all the gods, Tzenvachican."
    KYLISA @ talk "Die neuen Götter gingen siegreich hervor, angeführt von Al'Vazahs Champion und dem mächtigsten aller Götter, Tzenvachican."

# game/data/characters/kylisa/dialogue.rpy:141
translate de kylisa_teachmeaboutgods_menu_2257425a:

    # KYLISA @ talk "The old gods agreed to an uneasy truce talk, their dominion greatly reduced as the new gods triumphed over them."
    KYLISA @ talk "Die alten Götter stimmten einer unbehaglichen Waffenstillstandsverhandlung zu, ihr Einflussbereich war stark reduziert, da die neuen Götter über sie triumphierten."

# game/data/characters/kylisa/dialogue.rpy:142
translate de kylisa_teachmeaboutgods_menu_7cf2ca4a:

    # KYLISA @ talk "And thus began the longest long golden age of history till Malakai's war."
    KYLISA @ talk "Und so begann das längste goldene Zeitalter der Geschichte bis zu Malakais Krieg."

# game/data/characters/kylisa/dialogue.rpy:145
translate de kylisa_teachmeaboutgods_menu_9b93dd68:

    # KYLISA @ talk "Over at least ten thousand years had passed since the end of the first War of the gods."
    KYLISA @ talk "Mindestens zehntausend Jahre waren seit dem Ende des ersten Krieges der Götter vergangen."

# game/data/characters/kylisa/dialogue.rpy:146
translate de kylisa_teachmeaboutgods_menu_83ff4786:

    # KYLISA @ talk "It is said, the uneasy peace between the old gods and the new had become more strenuous than ever, as the old gods had begun to rally around their own Champion, Shal'krin who they saw might restore them to former glory."
    KYLISA @ talk "Es heißt, der unbehagliche Friede zwischen den alten und neuen Göttern sei angespannter als je zuvor gewesen, da die alten Götter begonnen hatten, sich um ihren eigenen Champion Shal'krin zu scharen, von dem sie glaubten, er könnte sie zu alter Größe zurückführen."

# game/data/characters/kylisa/dialogue.rpy:147
translate de kylisa_teachmeaboutgods_menu_ca20eac1:

    # KYLISA @ talk "But it was not Shal'Krin who bought about the second war of the gods."
    KYLISA @ talk "Doch nicht Shal'Krin löste den zweiten Krieg der Götter aus."

# game/data/characters/kylisa/dialogue.rpy:148
translate de kylisa_teachmeaboutgods_menu_87e758b6:

    # KYLISA @ talk "Malakai the curious and kind, was decieved by the goddess of chaos, Gimera, that the only way to prevent the coming war was to open the Necronimis, a ancient box formed and sealed away by Al'Vazah at the start of his great creation."
    KYLISA @ talk "Malakai, der Neugierige und Gütige, wurde von der Göttin des Chaos, Gimera, getäuscht, dass der einzige Weg, den drohenden Krieg zu verhindern, darin bestehe, die Necronimis zu öffnen, eine uralte Kiste, die von Al'Vazah zu Beginn seiner großen Schöpfung erschaffen und versiegelt worden war."

# game/data/characters/kylisa/dialogue.rpy:149
translate de kylisa_teachmeaboutgods_menu_0330a784:

    # KYLISA @ talk "Malakai opened the box hoping to learn the knowledge inside and use it for good, but instead, he absorbed all the darkness and evils of life itself."
    KYLISA @ talk "Malakai öffnete die Kiste in der Hoffnung, das darin enthaltene Wissen zu erlangen und es für das Gute zu nutzen, doch stattdessen absorbierte er die gesamte Dunkelheit und die Übel des Lebens selbst."

# game/data/characters/kylisa/dialogue.rpy:150
translate de kylisa_teachmeaboutgods_menu_05c3b3b7:

    # KYLISA @ talk "Reborn as Malakai the deciever, the dark shifter, the prince of blood and the lord of darkness."
    KYLISA @ talk "Wiedergeboren als Malakai der Betrüger, der dunkle Gestaltwandler, der Fürst des Blutes und der Herr der Finsternis."

# game/data/characters/kylisa/dialogue.rpy:151
translate de kylisa_teachmeaboutgods_menu_edff8c10:

    # KYLISA @ talk "Malakai overthrew Shal'Krin and declared himself god of gods, declaring war against Al'Vazah and Tzenvachian."
    KYLISA @ talk "Malakai stürzte Shal'Krin und erklärte sich selbst zum Gott der Götter, indem er Al'Vazah und Tzenvachian den Krieg erklärte."

# game/data/characters/kylisa/dialogue.rpy:152
translate de kylisa_teachmeaboutgods_menu_707d5d08:

    # KYLISA @ talk "Both old and new gods become factioned within themselves, taking sides either with Tzenvachian's forces or with Malakai's."
    KYLISA @ talk "Sowohl alte als auch neue Götter spalteten sich in Fraktionen und ergriffen Partei, entweder für die Streitkräfte Tzenvachians oder für die Malakais."

# game/data/characters/kylisa/dialogue.rpy:153
translate de kylisa_teachmeaboutgods_menu_469a5e24:

    # KYLISA @ talk "Brother slew brother, and old enemies now found themselves fighting shoulder to shoulder."
    KYLISA @ talk "Bruder erschlug Bruder, und alte Feinde fanden sich nun Seite an Seite kämpfend."

# game/data/characters/kylisa/dialogue.rpy:154
translate de kylisa_teachmeaboutgods_menu_b06b04db:

    # KYLISA @ talk "Some followed Malakai out of fear, while others, genuinely believed in the warped vision of the mad god that he alone could bring about the {i}perfect{/i} world."
    KYLISA @ talk "Einige folgten Malakai aus Angst, während andere aufrichtig an die verdrehte Vision des wahnsinnigen Gottes glaubten, dass er allein die {i}perfekte{/i} Welt herbeiführen könne."

# game/data/characters/kylisa/dialogue.rpy:155
translate de kylisa_teachmeaboutgods_menu_a4c8291c:

    # KYLISA @ talk "While little is fully understood of what happened next, we know that thousands of mortal races joined the great war, and world upon world was engulfed in flames."
    KYLISA @ talk "Während nur wenig von dem, was als Nächstes geschah, vollständig verstanden wird, wissen wir, dass Tausende sterblicher Rassen sich dem großen Krieg anschlossen und eine Welt nach der anderen in Flammen aufging."

# game/data/characters/kylisa/dialogue.rpy:156
translate de kylisa_teachmeaboutgods_menu_e1af33ed:

    # KYLISA @ talk "The gods that had once flourished, were decimated, until finally, Malakai himself faced off with Tzenvachian."
    KYLISA @ talk "Die Götter, die einst geblüht hatten, wurden dezimiert, bis schließlich Malakai selbst Tzenvachian gegenübertrat."

# game/data/characters/kylisa/dialogue.rpy:157
translate de kylisa_teachmeaboutgods_menu_f08591e2:

    # KYLISA @ talk "There battle, as it was written, is beyond our comprehension, but the result seems to be that Malakai's physical form was destroyed at the cost of both Tzenvachian sacrificing himself by trapping their souls in some eternal battle."
    KYLISA @ talk "Ihr Kampf, wie es geschrieben steht, liegt jenseits unseres Verständnisses, aber das Ergebnis scheint zu sein, dass Malakais physische Form zerstört wurde, auf Kosten von Tzenvachians eigener Opferung, indem er ihre Seelen in einem ewigen Kampf gefangen hielt."

# game/data/characters/kylisa/dialogue.rpy:158
translate de kylisa_teachmeaboutgods_menu_4abad51c:

    # KYLISA @ talk "Thus ending the second war of the gods."
    KYLISA @ talk "Damit endete der zweite Krieg der Götter."

# game/data/characters/kylisa/dialogue.rpy:161
translate de kylisa_teachmeaboutgods_menu_37a59d9c:

    # KYLISA @ talk "Hmm, not much is written on this part."
    KYLISA @ talk "Hmm, über diesen Teil ist nicht viel geschrieben."

# game/data/characters/kylisa/dialogue.rpy:162
translate de kylisa_teachmeaboutgods_menu_a03c6b89:

    # KYLISA @ talk "Only the passing words of troubled surviving gods who have, throughout the ages, passed through our world and alluded to what happened."
    KYLISA @ talk "Nur die flüchtigen Worte von geplagten überlebenden Göttern, die im Laufe der Zeitalter durch unsere Welt zogen und auf das Geschehene anspielten."

# game/data/characters/kylisa/dialogue.rpy:163
translate de kylisa_teachmeaboutgods_menu_372845a7:

    # KYLISA @ talk "But it's... difficult to always decipher their meaning."
    KYLISA @ talk "Aber es ist... schwierig, ihre Bedeutung immer zu entschlüsseln."

# game/data/characters/kylisa/dialogue.rpy:164
translate de kylisa_teachmeaboutgods_menu_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "Was meinst du?"

# game/data/characters/kylisa/dialogue.rpy:165
translate de kylisa_teachmeaboutgods_menu_af75ed5d:

    # KYLISA @ talk "Do keep in mind, much of this is heavily debated by scholars and such, I cannot speak from official doctrine when I discuss it."
    KYLISA @ talk "Bedenke, dass vieles davon unter Gelehrten stark umstritten ist, ich kann nicht aus offizieller Lehre sprechen, wenn ich darüber rede."

# game/data/characters/kylisa/dialogue.rpy:166
translate de kylisa_teachmeaboutgods_menu_5bae4f2d:

    # KYLISA @ talk "From the various legends and smaller texts I have gathered, some of the scarred surviving gods explained that the old wars were fought with 'mechanical dragons that surfed the stars' and other such strange things."
    KYLISA @ talk "Aus den verschiedenen Legenden und kleineren Texten, die ich gesammelt habe, erklärten einige der vernarbten überlebenden Götter, dass die alten Kriege mit 'mechanischen Drachen, die die Sterne beflogen', und anderen solch seltsamen Dingen geführt wurden."

# game/data/characters/kylisa/dialogue.rpy:167
translate de kylisa_teachmeaboutgods_menu_9c944004:

    # KYLISA @ talk "These dragons they struggled to feed in the aftermath of the war, and as food and other resources dwindled, they fought amongst each other for what very little remained."
    KYLISA @ talk "Diese Drachen zu ernähren, kämpften sie in der Nachkriegszeit, und als Nahrung und andere Ressourcen schwanden, kämpften sie untereinander um das Wenige, was noch übrig war."

# game/data/characters/kylisa/dialogue.rpy:168
translate de kylisa_teachmeaboutgods_menu_0132bbc2:

    # KYLISA @ talk "Apparently it was the darkest of times..."
    KYLISA @ talk "Anscheinend war es die dunkelste aller Zeiten..."

# game/data/characters/kylisa/dialogue.rpy:169
translate de kylisa_teachmeaboutgods_menu_48a85e92:

    # "Kylisa smiled."
    "Kylisa lächelte."

# game/data/characters/kylisa/dialogue.rpy:170
translate de kylisa_teachmeaboutgods_menu_1f4113f5:

    # KYLISA @ smile "We don't know for sure about that part."
    KYLISA @ smile "Wir wissen diesen Teil nicht sicher."

# game/data/characters/kylisa/dialogue.rpy:171
translate de kylisa_teachmeaboutgods_menu_828e0014:

    # KYLISA @ smile "Mechanical dragons flying through the stars... What a strange idea."
    KYLISA @ smile "Mechanische Drachen, die durch die Sterne fliegen... Was für eine seltsame Vorstellung."

# game/data/characters/kylisa/dialogue.rpy:172
translate de kylisa_teachmeaboutgods_menu_9b93778a:

    # KYLISA @ smile "I do wonder sometimes what the gods could have meant by that."
    KYLISA @ smile "Ich frage mich manchmal, was die Götter damit gemeint haben könnten."

# game/data/characters/kylisa/dialogue.rpy:175
translate de kylisa_teachmeaboutgods_menu_ea6b7d7e:

    # KYLISA @ talk "As you wish."
    KYLISA @ talk "Wie du wünschst."

# game/data/characters/kylisa/dialogue.rpy:176
translate de kylisa_teachmeaboutgods_menu_ff8a948b:

    # KYLISA @ talk "Anything else?"
    KYLISA @ talk "Noch etwas?"

# game/data/characters/kylisa/dialogue.rpy:184
translate de nov_kylisa_firstmeet_2c51f77f:

    # KYLISA @ talk "Ah, it is good to see you walking."
    KYLISA @ talk "Ah, es ist schön, dich laufen zu sehen."

# game/data/characters/kylisa/dialogue.rpy:185
translate de nov_kylisa_firstmeet_68041ff4:

    # MC @ talk "Huh? Have we met before?"
    MC @ talk "Hm? Haben wir uns schon mal getroffen?"

# game/data/characters/kylisa/dialogue.rpy:186
translate de nov_kylisa_firstmeet_c69e673f:

    # KYLISA @ smile "Have you forgotten so quickly when I helped tend to your wounds?"
    KYLISA @ smile "Hast du so schnell vergessen, dass ich dir half, deine Wunden zu versorgen?"

# game/data/characters/kylisa/dialogue.rpy:187
translate de nov_kylisa_firstmeet_483c32a8:

    # "I remembered her now, the mage who arrived with Alcott."
    "Jetzt erinnerte ich mich an sie, die Magierin, die mit Alcott ankam."

# game/data/characters/kylisa/dialogue.rpy:188
translate de nov_kylisa_firstmeet_cb39066d:

    # MC @ surprised "You're the Emperor's Mage!"
    MC @ surprised "Du bist die Kaisermagierin!"

# game/data/characters/kylisa/dialogue.rpy:189
translate de nov_kylisa_firstmeet_33f2b025:

    # KYLISA @ talk "Kylisa."
    KYLISA @ talk "Kylisa."

# game/data/characters/kylisa/dialogue.rpy:190
translate de nov_kylisa_firstmeet_375219c2:

    # KYLISA @ talk "Tell me, what brings you here?"
    KYLISA @ talk "Sag mir, was führt dich hierher?"

# game/data/characters/kylisa/dialogue.rpy:191
translate de nov_kylisa_firstmeet_021d7d2c:

    # KYLISA @ talk "Have you come to pray to the gods?"
    KYLISA @ talk "Bist du hergekommen, um zu den Göttern zu beten?"

