# game/data/characters/luna/dialogue_luna.rpy:20
translate de luna_talk_fe2ebf70:

    # LUNA @ smile "Hello! May I help you with something?"
    LUNA @ smile "Hallo! Kann ich Ihnen mit etwas helfen?"

# game/data/characters/luna/dialogue_luna.rpy:25
translate de luna_bye_e42febf0:

    # LUNA "See you around!"
    LUNA "Man sieht sich!"

# game/data/characters/luna/dialogue_luna.rpy:30
translate de luna_talk_cantgothere_58ea8463:

    # LUNA "Hey! You can't just walk in there."
    LUNA "Hey! Sie können da nicht einfach reinspazieren."

# game/data/characters/luna/dialogue_luna.rpy:35
translate de luna_use_baths_03aa7676:

    # LUNA @ smile "Certainly!"
    LUNA @ smile "Gewiss!"

# game/data/characters/luna/dialogue_luna.rpy:36
translate de luna_use_baths_2f547f8a:

    # LUNA @ smile "For you and your companions that'll be two hundred and fifty coins."
    LUNA @ smile "Für Sie und Ihre Begleiter macht das zweihundertfünfzig Münzen."

# game/data/characters/luna/dialogue_luna.rpy:42
translate de luna_use_baths_c0c26f2f:

    # LUNA @ talk "Okay then, should you make the decision, the {i}Princess' Dream{/i} is always ready to recieve guests."
    LUNA @ talk "Nun gut, sollten Sie sich entscheiden, der {i}Traum der Prinzessin{/i} ist jederzeit bereit, Gäste zu empfangen."

# game/data/characters/luna/dialogue_luna.rpy:48
translate de luna_questions_9469500d:

    # LUNA @ talk "Hm? Questions?"
    LUNA @ talk "Hm? Fragen?"

# game/data/characters/luna/dialogue_luna.rpy:49
translate de luna_questions_46ef7612:

    # LUNA @ talk "What do you want to know?"
    LUNA @ talk "Was möchten Sie wissen?"

# game/data/characters/luna/dialogue_luna.rpy:52
translate de luna_questions_menu_71d4ef92:

    # LUNA @ talk "Ahh..."
    LUNA @ talk "Ahh..."

# game/data/characters/luna/dialogue_luna.rpy:53
translate de luna_questions_menu_64ef36ae:

    # LUNA @ talk "My husband was sea captain of a small merchant vessel."
    LUNA @ talk "Mein Mann war Kapitän eines kleinen Handelsschiffs."

# game/data/characters/luna/dialogue_luna.rpy:54
translate de luna_questions_menu_2b407674:

    # LUNA @ talk "The coin was good, but the months at sea were long."
    LUNA @ talk "Die Münze war gut, aber die Monate auf See waren lang."

# game/data/characters/luna/dialogue_luna.rpy:55
translate de luna_questions_menu_c067ca27:

    # LUNA @ think "That's why we saved up what money we could,"
    LUNA @ think "Deshalb sparten wir, was wir an Geld konnten,"

# game/data/characters/luna/dialogue_luna.rpy:56
translate de luna_questions_menu_7c370a02:

    # MC @ talk "He planned to retire and have us open up a store."
    MC @ talk "Er plante, in Rente zu gehen und uns einen Laden eröffnen zu lassen."

# game/data/characters/luna/dialogue_luna.rpy:57
translate de luna_questions_menu_51681a50:

    # LUNA @ sad "That is... until his ship was taken by a storm."
    LUNA @ sad "Das war... bis sein Schiff von einem Sturm verschlungen wurde."

# game/data/characters/luna/dialogue_luna.rpy:58
translate de luna_questions_menu_234263d1:

    # MC @ sad "I am sorry to hear that."
    MC @ sad "Das tut mir leid."

# game/data/characters/luna/dialogue_luna.rpy:59
translate de luna_questions_menu_02f03353:

    # LUNA @ sad "It's alright, it was a long time ago now."
    LUNA @ sad "Schon gut, das ist schon lange her."

# game/data/characters/luna/dialogue_luna.rpy:60
translate de luna_questions_menu_e8411806:

    # LUNA @ sad "It's... easier to talk about now."
    LUNA @ sad "Es ist... jetzt einfacher, darüber zu reden."

# game/data/characters/luna/dialogue_luna.rpy:61
translate de luna_questions_menu_b6df5634:

    # LUNA @ think "Anyway, after my husband died, I was left with the coin we had managed to save up."
    LUNA @ think "Jedenfalls, nachdem mein Mann gestorben war, blieb mir die Münze, die wir hatten sparen können."

# game/data/characters/luna/dialogue_luna.rpy:62
translate de luna_questions_menu_465a393c:

    # LUNA @ smile "I thought, well, no point running off with my tail between my leg."
    LUNA @ smile "Ich dachte, nun ja, es bringt nichts, mit eingezogenem Schwanz davonzulaufen."

# game/data/characters/luna/dialogue_luna.rpy:63
translate de luna_questions_menu_34b15857:

    # LUNA @ smile "So, I looked around, and decided instead of a store,"
    LUNA @ smile "Also sah ich mich um und beschloss, anstatt eines Ladens,"

# game/data/characters/luna/dialogue_luna.rpy:64
translate de luna_questions_menu_e4722a60:

    # LUNA @ smile "A bathhouse sounded more fun to run."
    LUNA @ smile "Ein Badehaus zu betreiben klang lustiger."

# game/data/characters/luna/dialogue_luna.rpy:65
translate de luna_questions_menu_661169f5:

    # LUNA @ smile "Heh... Plus I get a warm bath whenever I want now."
    LUNA @ smile "Heh... Außerdem bekomme ich jetzt ein warmes Bad, wann immer ich will."

# game/data/characters/luna/dialogue_luna.rpy:66
translate de luna_questions_menu_8a3ca43c:

    # LUNA @ talk "Hope that answers your question."
    LUNA @ talk "Hoffe, das beantwortet deine Frage."

# game/data/characters/luna/dialogue_luna.rpy:69
translate de luna_questions_menu_94fb1e89:

    # LUNA @ talk "There's not many other places for a katai to start a business."
    LUNA @ talk "Es gibt nicht viele andere Orte, an denen ein Katai ein Geschäft eröffnen kann."

# game/data/characters/luna/dialogue_luna.rpy:70
translate de luna_questions_menu_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Was?"

# game/data/characters/luna/dialogue_luna.rpy:71
translate de luna_questions_menu_86a14c5e:

    # MC @ think "It's illegal for a katai to own a businss in Novaras or something?"
    MC @ think "Ist es illegal für einen Katai, in Novaras ein Geschäft zu besitzen oder so?"

# game/data/characters/luna/dialogue_luna.rpy:72
translate de luna_questions_menu_23fd0367:

    # LUNA @ think "Not exactly."
    LUNA @ think "Nicht genau."

# game/data/characters/luna/dialogue_luna.rpy:73
translate de luna_questions_menu_4b66451e:

    # LUNA @ sad "They just don't refuse to hand out any business licences."
    LUNA @ sad "Sie weigern sich einfach nicht, irgendwelche Geschäftslizenzen auszustellen."

# game/data/characters/luna/dialogue_luna.rpy:74
translate de luna_questions_menu_d4ac178e:

    # MC @ think "... None?"
    MC @ think "... Keine?"

# game/data/characters/luna/dialogue_luna.rpy:75
translate de luna_questions_menu_9432b0bb:

    # LUNA @ talk "Well, they either outright refuse to grant permits and licences,"
    LUNA @ talk "Nun, sie weigern sich entweder rundheraus, Genehmigungen und Lizenzen zu erteilen,"

# game/data/characters/luna/dialogue_luna.rpy:76
translate de luna_questions_menu_9b87abaa:

    # LUNA @ talk "Or, they charge ludicrous rates that no one in their right mind would pay."
    LUNA @ talk "Oder sie verlangen lächerliche Preise, die niemand bei klarem Verstand bezahlen würde."

# game/data/characters/luna/dialogue_luna.rpy:77
translate de luna_questions_menu_f068c751:

    # LUNA @ talk "Sometimes as high as five times as much the asking price of a normal human."
    LUNA @ talk "Manchmal bis zu fünfmal so viel wie der geforderte Preis für einen normalen Menschen."

# game/data/characters/luna/dialogue_luna.rpy:78
translate de luna_questions_menu_5fae091a:

    # LUNA @ sad "They tolerate some of the more powerful merchants when it comes to trade."
    LUNA @ sad "Sie tolerieren einige der mächtigeren Händler im Handel."

# game/data/characters/luna/dialogue_luna.rpy:79
translate de luna_questions_menu_8866674a:

    # LUNA @ sad "For the rest of us though?"
    LUNA @ sad "Für den Rest von uns jedoch?"

# game/data/characters/luna/dialogue_luna.rpy:80
translate de luna_questions_menu_9b6f6a12:

    # LUNA @ sad "They're only interested in hiring us katai as either servants or whores."
    LUNA @ sad "Sie sind nur daran interessiert, uns Katai als Diener oder Huren einzustellen."

# game/data/characters/luna/dialogue_luna.rpy:81
translate de luna_questions_menu_209bb546:

    # MC @ talk "So that's why katai come here instead?"
    MC @ talk "Deshalb kommen Katai also stattdessen hierher?"

# game/data/characters/luna/dialogue_luna.rpy:82
translate de luna_questions_menu_6a433e62:

    # LUNA @ talk "As dangerous as the free city is, it's {i}free.{/i}"
    LUNA @ talk "So gefährlich die freie Stadt auch ist, sie ist {i}frei.{/i}"

# game/data/characters/luna/dialogue_luna.rpy:83
translate de luna_questions_menu_804b4e81:

    # LUNA @ talk "At least here, we can etch out a life for ourselves."
    LUNA @ talk "Wenigstens können wir uns hier ein Leben aufbauen."

# game/data/characters/luna/dialogue_luna.rpy:86
translate de luna_questions_menu_393b14e5:

    # LUNA @ talk "Alright then."
    LUNA @ talk "Also gut."

