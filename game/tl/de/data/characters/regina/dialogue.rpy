translate de regina_talk_55b8a330:

    # REGINA @ talk "Ah! There you are!"
    REGINA @ talk "Ah! Da bist du ja!"

# game/data/characters/regina/dialogue.rpy:33
translate de regina_askAllRight_5d1257bc:

    # REGINA @ talk "Hm? Everything’s fine, dear! "
    REGINA @ talk "Hm? Alles ist in Ordnung, Liebling!"

# game/data/characters/regina/dialogue.rpy:35
translate de regina_askAllRight_a71bc698:

    # REGINA @ talk "I’m just about to put some food on, will you be staying long?"
    REGINA @ talk "Ich bin gerade dabei, etwas zu essen zu machen. Bleibst du lange?"

# game/data/characters/regina/dialogue.rpy:37
translate de regina_askAllRight_18a361e9:

    # REGINA @ talk "That Town Crier is still ranting about how Newheart will save us all... Doesn’t he ever give up?"
    REGINA @ talk "Der Ausrufer schreit immer noch darüber, wie Newheart uns alle retten wird... Gibt er denn nie auf?"

# game/data/characters/regina/dialogue.rpy:39
translate de regina_askAllRight_673ae436:

    # REGINA @ talk "Have you been to a temple recently? It might be a good idea to receive some blessings from the Gods after what’s happened..."
    REGINA @ talk "Warst du in letzter Zeit in einem Tempel? Es wäre vielleicht eine gute Idee, nach dem, was passiert ist, einen Segen von den Göttern zu empfangen..."

# game/data/characters/regina/dialogue.rpy:43
translate de regina_askSubMenu_1c73d4db:

    # REGINA @ talk "What do you want to ask?"
    REGINA @ talk "Was möchtest du fragen?"

# game/data/characters/regina/dialogue.rpy:47
translate de regina_askFather_f4aa87d5:

    # REGINA @ talk "Yes, apparently he’s working on some kind of excavation, with Lord Psydon’s blessing..."
    REGINA @ talk "Ja, anscheinend arbeitet er an einer Art Ausgrabung, mit dem Segen von Lord Psydon..."

# game/data/characters/regina/dialogue.rpy:48
translate de regina_askFather_b0926daa:

    # REGINA @ talk "No idea what it’s all about but he’s alright, dear."
    REGINA @ talk "Keine Ahnung, worum es dabei geht, aber er ist in Ordnung, Liebling."

# game/data/characters/regina/dialogue.rpy:52
translate de regina_askErika_e28593af:

    # REGINA @ talk "Erika is just fine, like I said, she’s off galivanting around with those Inquisitors doing God only knows what."
    REGINA @ talk "Erika geht es gut, wie ich schon sagte, sie treibt sich mit diesen Inquisitoren herum und tut Gott weiß was."

# game/data/characters/regina/dialogue.rpy:53
translate de regina_askErika_3b7377a3:

    # MC @ talk "That’s all you know?"
    MC @ talk "Das ist alles, was du weißt?"

# game/data/characters/regina/dialogue.rpy:54
translate de regina_askErika_dbb029de:

    # REGINA @ talk "I’m afraid she doesn’t share much else, not even with me."
    REGINA @ talk "Ich fürchte, sie teilt nicht viel anderes mit, nicht einmal mit mir."

# game/data/characters/regina/dialogue.rpy:55
translate de regina_askErika_5c391be4:

    # REGINA @ talk "Very top secret and all that. "
    REGINA @ talk "Sehr streng geheim und so weiter."

# game/data/characters/regina/dialogue.rpy:59
translate de regina_askAdara_43aee9c0:

    # REGINA @ talk "Oh yes, you should see her if you haven’t already."
    REGINA @ talk "Oh ja, du solltest sie sehen, wenn du es noch nicht getan hast."

# game/data/characters/regina/dialogue.rpy:60
translate de regina_askAdara_d7388496:

    # REGINA @ talk "The girl has been quite frantic without you."
    REGINA @ talk "Das Mädchen war ganz verzweifelt ohne dich."

# game/data/characters/regina/dialogue.rpy:61
translate de regina_askAdara_1e36f099:

    # REGINA @ talk "And maybe just a tad bit annoying..."
    REGINA @ talk "Und vielleicht nur ein kleines bisschen nervig..."

# game/data/characters/regina/dialogue.rpy:62
translate de regina_askAdara_cdfb6f3a:

    # MC @ talk "[regina_ref_cap!t]!"
    MC @ talk "[regina_ref_cap!t]!"

# game/data/characters/regina/dialogue.rpy:63
translate de regina_askAdara_3d2ba6aa:

    # REGINA @ talk "What? She came by ALL the time, it was sweet, but it got old after the hundredth time..."
    REGINA @ talk "Was? Sie kam die GANZE Zeit vorbei, es war süß, aber es wurde nach dem hundertsten Mal alt..."

# game/data/characters/regina/dialogue.rpy:67
translate de regina_goodbye_3cf37582:

    # REGINA @ talk "Be safe!"
    REGINA @ talk "Sei vorsichtig!"

