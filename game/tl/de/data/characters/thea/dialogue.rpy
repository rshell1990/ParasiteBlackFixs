# game/data/characters/thea/dialogue.rpy:28
translate de nov_thea_talk_5f6496d4:

    # THEA @ smile "Oh hey! Can I help you with something?"
    THEA @ smile "Oh hey! Kann ich dir mit etwas helfen?"

# game/data/characters/thea/dialogue.rpy:33
translate de nov_thea_bye_9e54ad83:

    # THEA @ talk "Alright, see ya around!"
    THEA @ talk "Alles klar, wir sehen uns!"

# game/data/characters/thea/dialogue.rpy:34
translate de nov_thea_bye_d20135b7:

    # THEA @ smile "Good luck on your adventures!"
    THEA @ smile "Viel Glück bei deinen Abenteuern!"

# game/data/characters/thea/dialogue.rpy:38
translate de nov_thea_adv_questions_1a2ee70f:

    # THEA @ talk "Ask away."
    THEA @ talk "Frag einfach."

# game/data/characters/thea/dialogue.rpy:41
translate de nov_thea_adv_questions_menu_bbc22857:

    # THEA @ talk "Over on the board over there is our list of current jobs needing to be done."
    THEA @ talk "Auf der Tafel dort drüben ist unsere Liste der aktuellen Aufträge, die erledigt werden müssen."

# game/data/characters/thea/dialogue.rpy:42
translate de nov_thea_adv_questions_menu_0ab4d2cb:

    # THEA @ talk "Just select the one you want, and we'll handle the paperwork while you get to work."
    THEA @ talk "Wähle einfach den aus, den du willst, und wir kümmern uns um den Papierkram, während du dich an die Arbeit machst."

# game/data/characters/thea/dialogue.rpy:43
translate de nov_thea_adv_questions_menu_e0200cc9:

    # THEA @ talk "Remember though, you can only choose a quest within your rank as an adventurer."
    THEA @ talk "Denk aber daran, du kannst nur einen Auftrag innerhalb deines Rangs als Abenteurer wählen."

# game/data/characters/thea/dialogue.rpy:46
translate de nov_thea_adv_questions_menu_d0988ac6:

    # THEA @ talk "It's important to understand how the ranking works."
    THEA @ talk "Es ist wichtig zu verstehen, wie das Rangsystem funktioniert."

# game/data/characters/thea/dialogue.rpy:47
translate de nov_thea_adv_questions_menu_a160af5e:

    # THEA @ talk "All beginner adventurers are ranked as D-listers."
    THEA @ talk "Alle Anfänger-Abenteurer werden als D-Rang eingestuft."

# game/data/characters/thea/dialogue.rpy:48
translate de nov_thea_adv_questions_menu_691c77f1:

    # THEA @ talk "These are the most straightforward and simple quests available to any adventurer."
    THEA @ talk "Dies sind die unkompliziertesten und einfachsten Aufträge, die für jeden Abenteurer verfügbar sind."

# game/data/characters/thea/dialogue.rpy:49
translate de nov_thea_adv_questions_menu_359a935e:

    # THEA @ talk "Ranking progresses from D-tier all the way to S-Tier, the rank of legendary adventurers."
    THEA @ talk "Das Ranking reicht von D-Stufe bis hin zur S-Stufe, dem Rang legendärer Abenteurer."

# game/data/characters/thea/dialogue.rpy:50
translate de nov_thea_adv_questions_menu_71f3b316:

    # THEA @ talk "Of course, as the danger and difficulty of the quests increase each rank, so does the rewards to compensate."
    THEA @ talk "Natürlich, da die Gefahr und der Schwierigkeitsgrad der Quests mit jedem Rang steigen, steigen auch die Belohnungen zum Ausgleich."

# game/data/characters/thea/dialogue.rpy:53
translate de nov_thea_adv_questions_menu_9ae80558:

    # THEA @ talk "There's a set number of quests per rank that will need to be completed a minimum of at least once."
    THEA @ talk "Es gibt eine festgelegte Anzahl an Quests pro Rang, die mindestens einmal abgeschlossen werden müssen."

# game/data/characters/thea/dialogue.rpy:54
translate de nov_thea_adv_questions_menu_42fcd1da:

    # THEA @ talk "After you've beaten your ranks guild quests, a special one-time quest will open up that once you've completed, your rank will increase."
    THEA @ talk "Nachdem du die Gildenquests deines Ranges bestanden hast, wird eine einmalige Spezialquest freigeschaltet. Sobald du diese abgeschlossen hast, steigt dein Rang."

# game/data/characters/thea/dialogue.rpy:55
translate de nov_thea_adv_questions_menu_0b3f27c1:

    # THEA @ talk "Oh ... And don't worry about running out of quests."
    THEA @ talk "Oh ... Und mach dir keine Sorgen, dass dir die Quests ausgehen."

# game/data/characters/thea/dialogue.rpy:56
translate de nov_thea_adv_questions_menu_003922e8:

    # THEA @ talk "Outside of the special guild quests, most guild quests are usually full time occupations in themselves, you'll be able to re-do those quests as many times as you like."
    THEA @ talk "Abgesehen von den speziellen Gildenquests sind die meisten Gildenquests an sich Vollzeitaufgaben. Du kannst diese Quests so oft wiederholen, wie du möchtest."

# game/data/characters/thea/dialogue.rpy:59
translate de nov_thea_adv_questions_menu_fa5b1639:

    # THEA @ talk "Sure, was there anything else?"
    THEA @ talk "Sicher, gab es sonst noch etwas?"

# game/data/characters/thea/dialogue.rpy:63
translate de nov_thea_adv_questions_notAdventurer_dff28a07:

    # THEA @ talk "Sorry, but I don't remember you being an adventurer."
    THEA @ talk "Entschuldigung, aber ich erinnere mich nicht, dass du ein Abenteurer bist."

# game/data/characters/thea/dialogue.rpy:64
translate de nov_thea_adv_questions_notAdventurer_4a075af6:

    # MC "What do you mean?"
    MC "Was meinst du?"

# game/data/characters/thea/dialogue.rpy:65
translate de nov_thea_adv_questions_notAdventurer_bd5ff809:

    # THEA @ talk "Well, you can get yourself a drink or something, but I can't waste my time explaining the inner workings of the guild to you."
    THEA @ talk "Nun, du kannst dir einen Drink holen oder so, aber ich kann meine Zeit nicht damit verschwenden, dir die internen Abläufe der Gilde zu erklären."

# game/data/characters/thea/dialogue.rpy:66
translate de nov_thea_adv_questions_notAdventurer_e1770810:

    # MC "Can I become an adventurer?"
    MC "Kann ich ein Abenteurer werden?"

# game/data/characters/thea/dialogue.rpy:67
translate de nov_thea_adv_questions_notAdventurer_416abe62:

    # "Thea let out a quiet sigh..."
    "Thea seufzte leise..."

# game/data/characters/thea/dialogue.rpy:68
translate de nov_thea_adv_questions_notAdventurer_e5da05a6:

    # THEA @ talk "That's a three-hundred fifty-something time I've been asked this."
    THEA @ talk "Das ist ungefähr das dreihundertfünfzigste Mal, dass ich das gefragt werde."

# game/data/characters/thea/dialogue.rpy:69
translate de nov_thea_adv_questions_notAdventurer_811a066b:

    # THEA @ talk "Have you reached your Terminus yet?"
    THEA @ talk "Hast du schon deinen Terminus erreicht?"

# game/data/characters/thea/dialogue.rpy:70
translate de nov_thea_adv_questions_notAdventurer_5d73558e:

    # "I swallowed hard."
    "Ich schluckte schwer."

# game/data/characters/thea/dialogue.rpy:71
translate de nov_thea_adv_questions_notAdventurer_7b56f981:

    # MC "Y-yeah."
    MC "J-ja."

# game/data/characters/thea/dialogue.rpy:72
translate de nov_thea_adv_questions_notAdventurer_2da5a787:

    # THEA @ talk "You did? Well, that is how you become an adventurer, you're {i}assigned{/i} this role at your Terminus."
    THEA @ talk "Hast du? Nun, so wird man ein Abenteurer, dir wird diese Rolle an deinem Terminus {i}zugewiesen{/i}."

# game/data/characters/thea/dialogue.rpy:73
translate de nov_thea_adv_questions_notAdventurer_fe9f792d:

    # THEA @ talk "What role did the kingdom bestow upon you?"
    THEA @ talk "Welche Rolle hat dir das Königreich verliehen?"

# game/data/characters/thea/dialogue.rpy:74
translate de nov_thea_adv_questions_notAdventurer_522de8a4:

    # MC "(Cannon fodder.)"
    MC "(Kanonenfutter.)"

# game/data/characters/thea/dialogue.rpy:75
translate de nov_thea_adv_questions_notAdventurer_e8f39a65:

    # MC "I... I should go."
    MC "Ich... ich sollte gehen."

# game/data/characters/thea/dialogue.rpy:76
translate de nov_thea_adv_questions_notAdventurer_4349caf7:

    # "Thea raised an eyebrow."
    "Thea zog eine Augenbraue hoch."

# game/data/characters/thea/dialogue.rpy:77
translate de nov_thea_adv_questions_notAdventurer_d34359c3:

    # THEA @ talk "Okay, safe travels then!"
    THEA @ talk "Okay, dann gute Reise!"

# game/data/characters/thea/dialogue.rpy:79
translate de nov_thea_adv_questions_notAdventurer_bfd46478:

    # MC "I should get to the fort now."
    MC "Ich sollte jetzt zum Fort gehen."

# game/data/characters/thea/dialogue.rpy:84
translate de nov_thea_drink_4968c955:

    # THEA @ talk "Improve your standing at the guild and maybe we'll talk."
    THEA @ talk "Verbessere dein Ansehen in der Gilde und vielleicht reden wir dann."

# game/data/characters/thea/dialogue.rpy:88
translate de nov_thea_drink_8bb85580:

    # THEA @ smile "I hope you don't think you're the first one to try that."
    THEA @ smile "Ich hoffe, du denkst nicht, dass du der Erste bist, der das versucht."

# game/data/characters/thea/dialogue.rpy:89
translate de nov_thea_drink_cef616c3:

    # MC @ smile "I was hoping I'd be the first one you'd say yes to."
    MC @ smile "Ich hatte gehofft, ich wäre der Erste, zu dem du Ja sagst."

# game/data/characters/thea/dialogue.rpy:90
translate de nov_thea_drink_af5adb3e:

    # THEA @ talk "Hmm, well, I'll think about it ..."
    THEA @ talk "Hmm, na ja, ich werde darüber nachdenken ..."

# game/data/characters/thea/dialogue.rpy:91
translate de nov_thea_drink_4d231e9b:

    # THEA @ talk "I'm sure you're used to girls just falling into your lap, but it takes a little more than that to get me interested."
    THEA @ talk "Ich bin mir sicher, du bist es gewohnt, dass dir die Mädchen einfach so in den Schoß fallen, aber es braucht etwas mehr, um mein Interesse zu wecken."

# game/data/characters/thea/dialogue.rpy:92
translate de nov_thea_drink_e9545907:

    # MC @ smile "Oh?"
    MC @ smile "Oh?"

# game/data/characters/thea/dialogue.rpy:93
translate de nov_thea_drink_08d238b8:

    # THEA @ smile "{i}I wanna see what you can do.{/i}"
    THEA @ smile "{i}Ich will sehen, was du kannst.{/i}"

# game/data/characters/thea/dialogue.rpy:94
translate de nov_thea_drink_fb6bc2c6:

    # MC @ think "What I can do?"
    MC @ think "Was kann ich tun?"

# game/data/characters/thea/dialogue.rpy:95
translate de nov_thea_drink_95135937:

    # THEA @ smile "Here, {i}at this guild.{/i}"
    THEA @ smile "Hier, {i}in dieser Gilde.{/i}"

# game/data/characters/thea/dialogue.rpy:96
translate de nov_thea_drink_306fe303:

    # THEA @ smile2 "There's something about this place that just-"
    THEA @ smile2 "Dieser Ort hat etwas an sich, das einfach-"

# game/data/characters/thea/dialogue.rpy:97
translate de nov_thea_drink_c7bdae38:

    # THEA @ smile "Mmm ... Better not think too hard on it, need to stay focused for work."
    THEA @ smile "Mmm ... Besser, ich denke nicht zu viel darüber nach, ich muss mich auf die Arbeit konzentrieren."

# game/data/characters/thea/dialogue.rpy:98
translate de nov_thea_drink_ef2975b7:

    # MC @ talk "So, you've got a thing for Adventurers then?"
    MC @ talk "Also, du stehst auf Abenteurer, oder?"

# game/data/characters/thea/dialogue.rpy:99
translate de nov_thea_drink_79a5953f:

    # THEA @ smile2 "A-Ah...Maybe a little?"
    THEA @ smile2 "A-Ah... Vielleicht ein bisschen?"

# game/data/characters/thea/dialogue.rpy:100
translate de nov_thea_drink_c0c81c71:

    # THEA @ smile "But not just any adventurer walking in off the street, one whose metal has been seriously proven."
    THEA @ smile "Aber nicht irgendein Abenteurer, der von der Straße hereinkommt, sondern einer, dessen Können ernsthaft unter Beweis gestellt wurde."

# game/data/characters/thea/dialogue.rpy:101
translate de nov_thea_drink_211b3ff7:

    # THEA @ blush "Think you've got what it takes?"
    THEA @ blush "Glaubst du, du hast das Zeug dazu?"

# game/data/characters/thea/dialogue.rpy:102
translate de nov_thea_drink_8ba32743:

    # MC @ talk "I guess we'll see, won't we?"
    MC @ talk "Ich schätze, wir werden sehen, nicht wahr?"

translate de strings:

    # game/data/characters/thea/dialogue.rpy:14
    old "Talk to Thea"
    new "Sprich mit Thea"

