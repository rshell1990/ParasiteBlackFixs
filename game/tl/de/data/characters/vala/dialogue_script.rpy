# game/data/characters/vala/dialogue_script.rpy:4
translate de nov_vala_scr_firstmeet_1c716be8:

    # "As I stepped into the Library, I was greeted by the sudden warmth as I stepped through the door, the fire going as musky books laid scattered around on various tables."
    "Als ich die Bibliothek betrat, empfing mich plötzliche Wärme, als ich durch die Tür trat; das Feuer brannte und moschusartige Bücher lagen verstreut auf verschiedenen Tischen herum."

# game/data/characters/vala/dialogue_script.rpy:5
translate de nov_vala_scr_firstmeet_9b7620e7:

    # MC @ talk "Hello? Is anyone here?"
    MC @ talk "Hallo? Ist jemand hier?"

# game/data/characters/vala/dialogue_script.rpy:6
translate de nov_vala_scr_firstmeet_1e9e0401:

    # VALA "Just a minute!"
    VALA "Einen Moment!"

# game/data/characters/vala/dialogue_script.rpy:7
translate de nov_vala_scr_firstmeet_b7a4fdc6:

    # "Peering around, I noticed a blonde girl high up on some ladder, putting away a few old books they she slides back into place."
    "Als ich mich umsah, bemerkte ich ein blondes Mädchen hoch oben auf einer Leiter, das ein paar alte Bücher zurückstellte, die sie an ihren Platz schob."

# game/data/characters/vala/dialogue_script.rpy:9
translate de nov_vala_scr_firstmeet_3ed51ef9:

    # "Reaching onto her tip toes, the girl out-stretched her arms as she tried to reach the bookshelf, and her skirt begin to hike up, revealing the soft panties she wore beneath."
    "Sie streckte sich auf die Zehenspitzen, das Mädchen streckte die Arme aus, als sie versuchte, das Bücherregal zu erreichen, und ihr Rock begann hochzurutschen und enthüllte die weichen Höschen, die sie darunter trug."

# game/data/characters/vala/dialogue_script.rpy:11
translate de nov_vala_scr_firstmeet_7a78c0c0:

    # VALA "Just... a little more!"
    VALA "Nur... noch ein kleines bisschen!"

# game/data/characters/vala/dialogue_script.rpy:13
translate de nov_vala_scr_firstmeet_2ab10cd7:

    # MC @ talk "Are you okay up there? That ladder looks a little... {i}old.{/i}"
    MC @ talk "Bist du da oben in Ordnung? Die Leiter sieht etwas... {i}alt{/i} aus."

# game/data/characters/vala/dialogue_script.rpy:14
translate de nov_vala_scr_firstmeet_4cc79bf2:

    # VALA "I’ll be fine! We’re getting a new-"
    VALA "Mir geht's gut! Wir bekommen eine neue-"

# game/data/characters/vala/dialogue_script.rpy:15
translate de nov_vala_scr_firstmeet_d2a7a758:

    # "Suddenly, the weak ladder snapped beneath her foot as the girl began falling down!"
    "Plötzlich brach die schwache Leiter unter ihrem Fuß, als das Mädchen hinunterzufallen begann!"

# game/data/characters/vala/dialogue_script.rpy:20
translate de nov_vala_scr_firstmeet_e7b98bff:

    # VALA "AHHHHH!"
    VALA "AHHHHH!"

# game/data/characters/vala/dialogue_script.rpy:21
translate de nov_vala_scr_firstmeet_061f8483:

    # "Running forward, I managed to catch the girl just in time with my agile reflexes, gently letting her down safely."
    "Nach vorne laufend, gelang es mir, das Mädchen mit meinen flinken Reflexen rechtzeitig aufzufangen und sie sanft sicher abzusetzen."

# game/data/characters/vala/dialogue_script.rpy:24
translate de nov_vala_scr_firstmeet_93bbef6a:

    # VALA "Phew...! Thank you for that!"
    VALA "Puh...! Danke dafür!"

# game/data/characters/vala/dialogue_script.rpy:25
translate de nov_vala_scr_firstmeet_9eb70956:

    # "Stood before me, I now finally had a good chance to look at the girl properly, she was short, with long blonde hair and spectacle glasses."
    "Da stand sie nun vor mir, und ich hatte endlich eine gute Gelegenheit, das Mädchen richtig anzusehen; sie war klein, hatte lange blonde Haare und trug eine Brille."

# game/data/characters/vala/dialogue_script.rpy:27
translate de nov_vala_scr_firstmeet_214f3a9e:

    # "Smiling cutely at me, I looked down to see the curves of her body and felt the tinge of the Parasite getting excited once again."
    "Sie lächelte mich süß an, ich schaute hinab auf die Kurven ihres Körpers und spürte, wie der Parasit wieder erregt wurde."

# game/data/characters/vala/dialogue_script.rpy:28
translate de nov_vala_scr_firstmeet_0a1deb0a:

    # MC @ talk "No problem."
    MC @ talk "Kein Problem."

# game/data/characters/vala/dialogue_script.rpy:29
translate de nov_vala_scr_firstmeet_9dcd4662:

    # "The girl outstretched her hand for it to be shaken."
    "Das Mädchen streckte ihre Hand zum Schütteln aus."

# game/data/characters/vala/dialogue_script.rpy:30
translate de nov_vala_scr_firstmeet_16215314:

    # VALA "Vala Bluestone at your service!"
    VALA "Vala Bluestone, zu Ihren Diensten!"

# game/data/characters/vala/dialogue_script.rpy:32
translate de nov_vala_scr_firstmeet_90781931:

    # "I reached out my hand to shake hers."
    "Ich streckte meine Hand aus, um ihre zu schütteln."

# game/data/characters/vala/dialogue_script.rpy:33
translate de nov_vala_scr_firstmeet_6fa3a6ae:

    # MC @ talk "A pleasure to meet you Vala Bluestone, I am [player_name!t]."
    MC @ talk "Freut mich, Vala Bluestone kennenzulernen, ich bin [player_name!t]."

# game/data/characters/vala/dialogue_script.rpy:34
translate de nov_vala_scr_firstmeet_ce593ffd:

    # VALA "So, what brings you here?"
    VALA "Also, was führt dich hierher?"

# game/data/characters/vala/dialogue_script.rpy:35
translate de nov_vala_scr_firstmeet_0ad6f9ca:

    # MC @ talk "I was perhaps hoping to read a book or two..."
    MC @ talk "Ich hatte vielleicht gehofft, ein oder zwei Bücher zu lesen..."

# game/data/characters/vala/dialogue_script.rpy:36
translate de nov_vala_scr_firstmeet_c606f5f8:

    # VALA "Ah, well the library is free for all, and always open."
    VALA "Ah, nun, die Bibliothek ist für alle kostenlos und immer geöffnet."

# game/data/characters/vala/dialogue_script.rpy:37
translate de nov_vala_scr_firstmeet_f0e406e2:

    # VALA "Just remember, while we can put books in the hold for you to keep reading once you come back, we can’t allow you to take any of the books with you."
    VALA "Denk nur daran, dass wir zwar Bücher für dich reservieren können, damit du weiterlesen kannst, wenn du wiederkommst, aber wir können dir nicht erlauben, Bücher mitzunehmen."

# game/data/characters/vala/dialogue_script.rpy:38
translate de nov_vala_scr_firstmeet_7c81cc89:

    # "After so many students complained and asked for the library to be opened due to the ever-growing stress around studies, the education board agreed to give it extra funding to do so."
    "Nachdem so viele Studenten sich beschwert und verlangt hatten, die Bibliothek wegen des ständig wachsenden Stresses im Studium zu öffnen, stimmte der Bildungsausschuss zu, dafür zusätzliche Mittel bereitzustellen."

# game/data/characters/vala/dialogue_script.rpy:39
translate de nov_vala_scr_firstmeet_c486209e:

    # "Me and Markus, albeit reluctantly, were forced to spend a fair few of our evenings here."
    "Markus und ich mussten, wenn auch widerwillig, einige unserer Abende hier verbringen."

# game/data/characters/vala/dialogue_script.rpy:40
translate de nov_vala_scr_firstmeet_ef9ee76e:

    # "How long ago that all seems now..."
    "Wie lange das alles jetzt her zu sein scheint..."

# game/data/characters/vala/dialogue_script.rpy:41
translate de nov_vala_scr_firstmeet_0d47b440:

    # VALA "Is something the matter?"
    VALA "Ist etwas nicht in Ordnung?"

# game/data/characters/vala/dialogue_script.rpy:42
translate de nov_vala_scr_firstmeet_bf61c54a:

    # MC @ talk "Hmm?"
    MC @ talk "Hmm?"

# game/data/characters/vala/dialogue_script.rpy:43
translate de nov_vala_scr_firstmeet_c9952985:

    # VALA "You seemed... {i}lost in thought{/i} for a second there."
    VALA "Du schienst... {i}in Gedanken versunken{/i} für einen Moment."

# game/data/characters/vala/dialogue_script.rpy:44
translate de nov_vala_scr_firstmeet_d5717343:

    # MC @ talk "Oh, never mind."
    MC @ talk "Oh, schon gut."

# game/data/characters/vala/dialogue_script.rpy:45
translate de nov_vala_scr_firstmeet_67a9c63c:

    # MC @ talk "Just remembering some things, nothing important."
    MC @ talk "Erinnere mich nur an ein paar Dinge, nichts Wichtiges."

# game/data/characters/vala/dialogue_script.rpy:46
translate de nov_vala_scr_firstmeet_bf0e67a2:

    # VALA "Well, if you need anything, I’ll be around! Okay?"
    VALA "Nun, wenn du etwas brauchst, ich bin in der Nähe! Okay?"

# game/data/characters/vala/dialogue_script.rpy:47
translate de nov_vala_scr_firstmeet_830159c6:

    # MC @ talk "Sounds good."
    MC @ talk "Klingt gut."

# game/data/characters/vala/dialogue_script.rpy:48
translate de nov_vala_scr_firstmeet_618cb924:

    # "As Vala smiled and waved shyly, I watched her cute butt as she sauntered off to go grab more books."
    "Während Vala schüchtern lächelte und winkte, beobachtete ich ihren süßen Hintern, als sie davonschlenderte, um mehr Bücher zu holen."

# game/data/characters/vala/dialogue_script.rpy:51
translate de nov_vala_scr_firstmeet_db0c26de:

    # BLACK "Her heartbeat raised when she saw you, and her hands began to sweat."
    BLACK "Ihr Herzschlag beschleunigte sich, als sie dich sah, und ihre Hände begannen zu schwitzen."

# game/data/characters/vala/dialogue_script.rpy:52
translate de nov_vala_scr_firstmeet_a97dcc2e:

    # BLACK "With some commitment, she would be a willing and good mate."
    BLACK "Mit etwas Hingabe wäre sie eine willige und gute Gefährtin."

# game/data/characters/vala/dialogue_script.rpy:53
translate de nov_vala_scr_firstmeet_7be498ca:

    # MC "Stop... I... "
    MC "Hör auf... ich..."

# game/data/characters/vala/dialogue_script.rpy:54
translate de nov_vala_scr_firstmeet_81498102:

    # "I shook my head to try push aside the dark thoughts."
    "Ich schüttelte den Kopf, um die dunklen Gedanken beiseite zu schieben."

# game/data/characters/vala/dialogue_script.rpy:55
translate de nov_vala_scr_firstmeet_bd8e6530:

    # MC @ angry "We’re here to try and gather some information, not hunting for another ‘mate’"
    MC @ angry "Wir sind hier, um Informationen zu sammeln, nicht um eine weitere ‘Gefährtin’ zu jagen."

# game/data/characters/vala/dialogue_script.rpy:56
translate de nov_vala_scr_firstmeet_296d9d43:

    # BLACK "As you wish."
    BLACK "Wie du wünschst."

# game/data/characters/vala/dialogue_script.rpy:57
translate de nov_vala_scr_firstmeet_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Seufz*{/i}"

# game/data/characters/vala/dialogue_script.rpy:58
translate de nov_vala_scr_firstmeet_7c3d9a85:

    # "Now, where to start? This place is huge..."
    "Nun, wo soll ich anfangen? Dieser Ort ist riesig..."

