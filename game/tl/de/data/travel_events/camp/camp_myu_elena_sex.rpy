    ELENA @ shock "... Oh!"

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:18
translate de travel_event_camp_myu_elena_0d8300a8:

    # ELENA @ sad "I - I didn't realize you already had company."
    ELENA @ sad "Ich - ich wusste nicht, dass du schon Gesellschaft hast."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:19
translate de travel_event_camp_myu_elena_0930e0d4:

    # "Elena rubbed at her arms as she shyly looked away from the scene before her."
    "Elena rieb sich die Arme, während sie schüchtern von der Szene vor ihr wegschaute."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:20
translate de travel_event_camp_myu_elena_a9437f7d:

    # ELENA @ sad "... I should go."
    ELENA @ sad "... Ich sollte gehen."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:25
translate de travel_event_camp_myu_elena_89400a48:

    # "Myu flung herself onto me, nuzzling her head against my chest as she threw her leg over me."
    "Myu warf sich auf mich und schmiegte ihren Kopf an meine Brust, während sie ihr Bein über mich warf."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:26
translate de travel_event_camp_myu_elena_246d123a:

    # MYU "Mmmm... ❤️"
    MYU "Mmmm... ❤️"

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:27
translate de travel_event_camp_myu_elena_af690cfc:

    # MC "...Like that."
    MC "...Genau so."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:28
translate de travel_event_camp_myu_elena_0f083396:

    # "Elena sheepishly looked around the tent, nervously standing there for a couple moments as she wondered how to proceed."
    "Elena sah sich schüchtern im Zelt um und stand einen Moment nervös da, während sie überlegte, wie sie weitermachen sollte."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:29
translate de travel_event_camp_myu_elena_b700f5c1:

    # "As she brushed her hair over her shoulder, she dropped to the floor, nervously snuggling herself up against me."
    "Als sie sich das Haar über die Schulter strich, ließ sie sich auf den Boden fallen und kuschelte sich nervös an mich."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:30
translate de travel_event_camp_myu_elena_75c0c7e1:

    # ELENA "...T-This is nice."
    ELENA "...D-Das ist schön."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:31
translate de travel_event_camp_myu_elena_d4501970:

    # ELENA "Strange, but nice."
    ELENA "Seltsam, aber schön."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:32
translate de travel_event_camp_myu_elena_7f90dede:

    # "Elena slowly began to relax, her hand gently running down my chest as Myu closed her {i}eyes.{/i}"
    "Elena begann sich langsam zu entspannen, ihre Hand strich sanft über meine Brust, während Myu ihre {i}Augen{/i} schloss."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:33
translate de travel_event_camp_myu_elena_b953866c:

    # "I wasn't sure if she was actually asleep or merely resting, but she was content."
    "Ich war mir nicht sicher, ob sie tatsächlich schlief oder nur ruhte, aber sie war zufrieden."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:34
translate de travel_event_camp_myu_elena_b92ed8e4:

    # ELENA "...G-Goodnight, [player_name!t]."
    ELENA "...G-Gute Nacht, [player_name!t]."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:35
translate de travel_event_camp_myu_elena_afe70de2:

    # MC "Goodnight, Elena."
    MC "Gute Nacht, Elena."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:36
translate de travel_event_camp_myu_elena_76c514e1:

    # MYU "{i}Grumbles{/i} ❤️"
    MYU "{i}Grummelt{/i} ❤️"

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:37
translate de travel_event_camp_myu_elena_c7480b4b:

    # "Gently I slowly closed my own eyes, relaxing as I felt the light swish of Elena's tail brush soothingly past me..."
    "Sanft schloss ich langsam meine eigenen Augen, entspannte mich, während ich das leichte Wedeln von Elenas Schwanz spürte, das beruhigend an mir vorbeistrich..."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:43
translate de travel_event_camp_myu_elena_28d3612a:

    # "As Elena hurried out of the tent, Myu turned towards me."
    "Als Elena aus dem Zelt eilte, drehte sich Myu zu mir um."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:45
translate de travel_event_camp_myu_elena_3823d36e:

    # MYU @ think "...We play?"
    MYU @ think "...Wir spielen?"

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:52
translate de travel_event_camp_myu_elena_4328424e:

    # "Rising to her feet, Myu stood cutely before me, her arms outstretched as her hands clasped and closed repeatedly."
    "Sich auf die Füße erhebend, stand Myu niedlich vor mir, die Arme ausgestreckt, während ihre Hände sich wiederholt öffneten und schlossen."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:53
translate de travel_event_camp_myu_elena_4eb2d271:

    # MYU "{i}Cuddles please?{/i}"
    MYU "{i}Kuscheln bitte?{/i}"

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:57
translate de travel_event_camp_myu_elena_2c16c89f:

    # "Patting some of the quilts beside me, Myu hurried over, nestling herself up against me."
    "Auf einige der Steppdecken neben mir klopfend, eilte Myu herüber und kuschelte sich an mich."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:58
translate de travel_event_camp_myu_elena_049a1853:

    # "She was still cool, but her pleasant rumbling was relaxing as she rested one of her hands on my chest."
    "Sie war noch kühl, aber ihr angenehmes Schnurren war entspannend, während sie eine ihrer Hände auf meine Brust legte."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:59
translate de travel_event_camp_myu_elena_1e7fb7a4:

    # MYU "Myuuu..."
    MYU "Myuuu..."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:60
translate de travel_event_camp_myu_elena_98765296:

    # "With her eyes gently closed, the cuddly, sleepy Myu quickly began to drift off."
    "Mit sanft geschlossenen Augen begann die kuschelige, schläfrige Myu schnell einzudösen."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:61
translate de travel_event_camp_myu_elena_be149f33:

    # "Only occasionally squirming in my arms, I couldn't help but appreciate how cute Myu was."
    "Nur gelegentlich zappelte sie in meinen Armen, musste ich mich einfach daran erfreuen, wie niedlich Myu war."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:62
translate de travel_event_camp_myu_elena_aee49722:

    # "... One might also forget how lethal a predator she could actually be."
    "... Man könnte auch vergessen, wie tödlich ein Raubtier sie tatsächlich sein könnte."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:63
translate de travel_event_camp_myu_elena_be7ca318:

    # "Slowly, content and warm with my companion for the evening, I too began to drift off to sleep..."
    "Langsam, zufrieden und warm mit meiner Gefährtin für den Abend, begann auch ich in den Schlaf zu gleiten ..."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:67
translate de travel_event_camp_myu_elena_3ef1dfb5:

