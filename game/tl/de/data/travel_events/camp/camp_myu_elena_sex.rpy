    # MC @ smile "What brings you here at this hour, Myu?"
    MC @ smile "Was führt dich zu dieser Stunde hierher, Myu?"

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:9
translate de travel_event_camp_myu_elena_913b3bf1:

    # MC @ lewd "Looking for some entertainment perhaps?"
    MC @ lewd "Vielleicht auf der Suche nach etwas Unterhaltung?"

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:10
translate de travel_event_camp_myu_elena_b0b921e1:

    # "Myu stepped closer towards me alluringly."
    "Myu trat verführerisch näher an mich heran."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:11
translate de travel_event_camp_myu_elena_74826638:

    # MYU @ blush "Myuuuu... ❤️"
    MYU @ blush "Myuuuu... ❤️"

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:15
translate de travel_event_camp_myu_elena_92dbace3:

    # "Abruptly, the two of us heard the fabric ruffle again as Elena stepped into the tent."
    "Plötzlich hörten wir beide erneut das Stoffrascheln, als Elena das Zelt betrat."

# game/data/travel_events/camp/camp_myu_elena_sex.rpy:16
translate de travel_event_camp_myu_elena_10552de8:

    # ELENA @ lewd "[player_name!t], are you still-"
