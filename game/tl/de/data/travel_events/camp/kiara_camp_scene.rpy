translate de travel_event_kiara_camp_scene_firsttime_4b3178ef:

    # KIARA @ sad "We didn't really talk much about me..."
    KIARA @ sad "Wir haben nicht wirklich viel über mich geredet..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:31
translate de travel_event_kiara_camp_scene_firsttime_f8a3119b:

