    MC @ talk "... Sterben?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:33
translate de travel_event_kiara_camp_scene_firsttime_524b0452:

    # KIARA @ sad "Aye... That."
    KIARA @ sad "Ja... Das."

# game/data/travel_events/camp/kiara_camp_scene.rpy:34
translate de travel_event_kiara_camp_scene_firsttime_a53ec0e4:

    # KIARA @ sad "Must have been quite a shock seeing me again."
    KIARA @ sad "Muss ein ziemlicher Schock gewesen sein, mich wiederzusehen."

# game/data/travel_events/camp/kiara_camp_scene.rpy:37
translate de travel_event_kiara_camp_scene_firsttime_8c65e156:

    # KIARA @ sad "F-Fucking seven hells."
    KIARA @ sad "V-Verdammte sieben Höllen."

# game/data/travel_events/camp/kiara_camp_scene.rpy:38
translate de travel_event_kiara_camp_scene_firsttime_60a0e842:

    # KIARA @ sad "Do you know how hard it is hearing you say that?"
    KIARA @ sad "Weißt du, wie schwer es ist, dich das sagen zu hören?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:39
translate de travel_event_kiara_camp_scene_firsttime_6fa81a86:

    # MC @ talk "You always said what we had wasn't serious... Just while we served."
    MC @ talk "Du hast immer gesagt, was wir hatten, sei nicht ernst ... Nur solange wir gedient haben."

# game/data/travel_events/camp/kiara_camp_scene.rpy:40
translate de travel_event_kiara_camp_scene_firsttime_be3ffab8:

    # KIARA @ angry "I-"
    KIARA @ angry "Ich-"

# game/data/travel_events/camp/kiara_camp_scene.rpy:41
translate de travel_event_kiara_camp_scene_firsttime_c1e76b31:

    # KIARA @ sad "... Fuck."
    KIARA @ sad "... Scheiße."

# game/data/travel_events/camp/kiara_camp_scene.rpy:45
translate de travel_event_kiara_camp_scene_firsttime_54fcc01c:

    # KIARA @ laugh "Ha...That's the spirit!"
    KIARA @ laugh "Ha... Das ist die richtige Einstellung!"

# game/data/travel_events/camp/kiara_camp_scene.rpy:46
translate de travel_event_kiara_camp_scene_firsttime_40117c11:

    # KIARA @ smile "Now you're just inviting me to try to see if I can out-do coming back from the dead!"
    KIARA @ smile "Jetzt lädst du mich ja geradezu ein, zu versuchen, ob ich die Rückkehr von den Toten noch übertreffen kann!"

# game/data/travel_events/camp/kiara_camp_scene.rpy:47
translate de travel_event_kiara_camp_scene_firsttime_1438a0de:

    # MC @ smile "Preferably not with the part where you actually died this time."
    MC @ smile "Am besten ohne den Teil, wo du dieses Mal tatsächlich gestorben bist."

# game/data/travel_events/camp/kiara_camp_scene.rpy:48
translate de travel_event_kiara_camp_scene_firsttime_32dc16af:

    # "The smile faded from her face."
    "Das Lächeln verschwand von ihrem Gesicht."

# game/data/travel_events/camp/kiara_camp_scene.rpy:49
translate de travel_event_kiara_camp_scene_firsttime_3cb30d17:

    # KIARA @ sad "H-Ha..."
    KIARA @ sad "H-Ha..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:52
translate de travel_event_kiara_camp_scene_firsttime_fdb33363:

    # KIARA @ sad "... There's something I need to talk to you about."
    KIARA @ sad "... Es gibt etwas, worüber ich mit dir reden muss."

# game/data/travel_events/camp/kiara_camp_scene.rpy:53
translate de travel_event_kiara_camp_scene_firsttime_5030e47d:

    # MC @ think "What is it?"
    MC @ think "Was ist es?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:54
translate de travel_event_kiara_camp_scene_firsttime_e1630907:

    # KIARA @ sad "The truth."
    KIARA @ sad "Die Wahrheit."

# game/data/travel_events/camp/kiara_camp_scene.rpy:55
translate de travel_event_kiara_camp_scene_firsttime_8bd20bd0:

    # KIARA @ sad "The truth about our time together before... back in the scouts."
    KIARA @ sad "Die Wahrheit über unsere gemeinsame Zeit damals... bei den Pfadfindern."

# game/data/travel_events/camp/kiara_camp_scene.rpy:56
translate de travel_event_kiara_camp_scene_firsttime_3060f99f:

    # MC @ talk "What are you talking about?"
    MC @ talk "Wovon redest du?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:57
translate de travel_event_kiara_camp_scene_firsttime_4dd93a67:

    # KIARA @ sad "I wasn't... entirely honest with you."
    KIARA @ sad "Ich war... nicht ganz ehrlich zu dir."

# game/data/travel_events/camp/kiara_camp_scene.rpy:58
translate de travel_event_kiara_camp_scene_firsttime_1e040a8b:

    # MC @ surprised "I have no idea still what you're going on about."
    MC @ surprised "Ich habe immer noch keine Ahnung, wovon du redest."

# game/data/travel_events/camp/kiara_camp_scene.rpy:59
translate de travel_event_kiara_camp_scene_firsttime_f9a1248b:

    # KIARA @ sad "You know, no matter what you say when I tell you, I still think you and I are destined to be together, the gods-"
    KIARA @ sad "Weißt du, egal was du sagst, wenn ich es dir sage, ich denke immer noch, dass du und ich füreinander bestimmt sind, die Götter-"

# game/data/travel_events/camp/kiara_camp_scene.rpy:60
translate de travel_event_kiara_camp_scene_firsttime_1c8bb848:

    # MC @ serious "Kiara, get to the point."
    MC @ serious "Kiara, komm zum Punkt."

# game/data/travel_events/camp/kiara_camp_scene.rpy:61
translate de travel_event_kiara_camp_scene_firsttime_1a4fd4fd_1:

    # KIARA @ sad "..."
    KIARA @ sad "..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:62
translate de travel_event_kiara_camp_scene_firsttime_affd8216:

    # KIARA @ sad "{b}I was using you.{/b}"
    KIARA @ sad "{b}Ich habe dich benutzt.{/b}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:63
translate de travel_event_kiara_camp_scene_firsttime_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "Was?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:64
translate de travel_event_kiara_camp_scene_firsttime_89f2db6e:

    # KIARA @ sad "{i}*Sigh*{/i}"
    KIARA @ sad "{i}*Seufz*{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:65
translate de travel_event_kiara_camp_scene_firsttime_888187da:

    # KIARA @ sad "Why'd you think they let men and women intermingle in the scouts?"
    KIARA @ sad "Warum glaubst du, lassen sie Männer und Frauen bei den Pfadfindern miteinander verkehren?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:66
translate de travel_event_kiara_camp_scene_firsttime_46633f98:

    # MC @ think "Because... There are not enough men alone to fill every division?"
    MC @ think "Weil... Es gibt nicht genug Männer allein, um jede Abteilung zu füllen?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:67
translate de travel_event_kiara_camp_scene_firsttime_cf352f0d:

    # KIARA @ sad "Partly... But not exactly."
    KIARA @ sad "Teilweise... Aber nicht genau."

# game/data/travel_events/camp/kiara_camp_scene.rpy:68
translate de travel_event_kiara_camp_scene_firsttime_c8f4555b:

    # KIARA @ sad "If a girl happens to get herself knocked up, they send you back home and let you leave the scouts."
    KIARA @ sad "Wenn ein Mädchen zufällig schwanger wird, schicken sie dich nach Hause und lassen dich die Pfadfinder verlassen."

# game/data/travel_events/camp/kiara_camp_scene.rpy:69
translate de travel_event_kiara_camp_scene_firsttime_1836dfa5:

    # KIARA @ sad "... If you're willing to give up the little one, let em' be raised to be whatever they need, another soldier probably."
    KIARA @ sad "... Wenn du bereit bist, das Kleine aufzugeben, lass sie es zu dem aufziehen, was sie brauchen, wahrscheinlich ein weiterer Soldat."

# game/data/travel_events/camp/kiara_camp_scene.rpy:70
translate de travel_event_kiara_camp_scene_firsttime_632c0396:

    # "The realization slowly dawned upon me as I felt my heart drop to the floor."
    "Langsam dämmerte mir die Erkenntnis, während ich fühlte, wie mein Herz zu Boden sank."

# game/data/travel_events/camp/kiara_camp_scene.rpy:71
translate de travel_event_kiara_camp_scene_firsttime_34d215e9:

    # MC @ sad "You..."
    MC @ sad "Du..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:72
translate de travel_event_kiara_camp_scene_firsttime_180aa05d:

    # "Sadness and confusion quickly turn to hot anger."
    "Trauer und Verwirrung schlagen schnell in heiße Wut um."

# game/data/travel_events/camp/kiara_camp_scene.rpy:73
translate de travel_event_kiara_camp_scene_firsttime_8b6e37bb:

    # MC @ angry "You were going to what? Have my child and then just sell them off for your own life!?"
    MC @ angry "Du wolltest was? Mein Kind bekommen und es dann einfach für dein eigenes Leben verkaufen!?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:74
translate de travel_event_kiara_camp_scene_firsttime_38977ef9:

    # KIARA @ sad "What choice did I have?"
    KIARA @ sad "Welche Wahl hatte ich?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:75
translate de travel_event_kiara_camp_scene_firsttime_8755bf58:

    # MC @ angry "And then what? Ride off into the sunset, forget I existed, and just pretend it was all some bad dream?"
    MC @ angry "Und dann was? In den Sonnenuntergang reiten, vergessen, dass ich existiere, und einfach so tun, als wäre alles nur ein böser Traum gewesen?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:76
translate de travel_event_kiara_camp_scene_firsttime_44c375b1:

    # KIARA @ shock "No! I promise you, I..."
    KIARA @ shock "Nein! Ich verspreche dir, ich..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:77
translate de travel_event_kiara_camp_scene_firsttime_c39b4765:

    # KIARA @ sad "{i}I don't know if I was going to look for you after I got out.{/i}"
    KIARA @ sad "{i}Ich weiß nicht, ob ich nach dir gesucht hätte, nachdem ich rausgekommen wäre.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:78
translate de travel_event_kiara_camp_scene_firsttime_62301bb6:

    # KIARA @ shock "But I promise you, I was going to use my funds to try and have her sent to serve in Angharad where it was safe!"
    KIARA @ shock "Aber ich verspreche dir, ich wollte meine Mittel nutzen, um zu versuchen, sie zum Dienst in Angharad schicken zu lassen, wo es sicher war!"

# game/data/travel_events/camp/kiara_camp_scene.rpy:79
translate de travel_event_kiara_camp_scene_firsttime_336217af:

    # KIARA @ shock "On my life, it's the truth!"
    KIARA @ shock "Bei meinem Leben, es ist die Wahrheit!"

# game/data/travel_events/camp/kiara_camp_scene.rpy:80
translate de travel_event_kiara_camp_scene_firsttime_72ff3adf:

    # MC @ surprised "... {i}Her?{/i}"
    MC @ surprised "... {i}Sie?{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:81
translate de travel_event_kiara_camp_scene_firsttime_1a4fd4fd_2:

    # KIARA @ sad "..."
    KIARA @ sad "..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:82
translate de travel_event_kiara_camp_scene_firsttime_8718f334:

    # MC @ surprised "What do you mean by {i}her?{/i}"
    MC @ surprised "Was meinst du mit {i}ihr?{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:83
translate de travel_event_kiara_camp_scene_firsttime_14996f0a:

    # "Kiara's eyes dropped down towards her stomach as she gently rested her hands over it."
    "Kiaras Blick senkte sich auf ihren Bauch, während sie sanft ihre Hände darauf legte."

# game/data/travel_events/camp/kiara_camp_scene.rpy:84
translate de travel_event_kiara_camp_scene_firsttime_1a4fd4fd_3:

    # KIARA @ sad "..."
    KIARA @ sad "..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:85
translate de travel_event_kiara_camp_scene_firsttime_d0bf63b7:

    # "An empty void filled my soul as I felt my heart shatter into pieces."
    "Eine leere Leere erfüllte meine Seele, als ich spürte, wie mein Herz in Stücke zerbrach."

# game/data/travel_events/camp/kiara_camp_scene.rpy:86
translate de travel_event_kiara_camp_scene_firsttime_f82c8dad:

    # MC @ sad "...No, Kiara, don't tell me-"
    MC @ sad "...Nein, Kiara, sag mir nicht-"

# game/data/travel_events/camp/kiara_camp_scene.rpy:87
translate de travel_event_kiara_camp_scene_firsttime_440b56a8:

    # KIARA @ sad "I was going to tell you."
    KIARA @ sad "Ich wollte es dir sagen."

# game/data/travel_events/camp/kiara_camp_scene.rpy:88
translate de travel_event_kiara_camp_scene_firsttime_2613c5f8:

    # MC @ sad "But... You..."
    MC @ sad "Aber... du..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:89
translate de travel_event_kiara_camp_scene_firsttime_35b75b80:

    # KIARA @ cry "I'm sorry."
    KIARA @ cry "Es tut mir leid."

# game/data/travel_events/camp/kiara_camp_scene.rpy:90
translate de travel_event_kiara_camp_scene_firsttime_736d4e23:

    # KIARA @ cry "I'm so sorry."
    KIARA @ cry "Es tut mir so leid."

# game/data/travel_events/camp/kiara_camp_scene.rpy:91
translate de travel_event_kiara_camp_scene_firsttime_64f208cb:

    # MC @ sad "Kiara..."
    MC @ sad "Kiara..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:92
translate de travel_event_kiara_camp_scene_firsttime_622ab2db:

    # KIARA @ cry "You and I both know it was a miracle's miracle that we both walked out of the scouts alive."
    KIARA @ cry "Du und ich wissen beide, dass es ein Wunder aller Wunder war, dass wir beide lebend aus dem Spähtrupp entkommen sind."

# game/data/travel_events/camp/kiara_camp_scene.rpy:93
translate de travel_event_kiara_camp_scene_firsttime_923ed3c3:

    # KIARA @ cry "I couldn't..."
    KIARA @ cry "Ich konnte nicht..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:94
translate de travel_event_kiara_camp_scene_firsttime_be1e549f:

    # "Kiara stopped herself, biting down on her lip as she turned her head away, closing her eyes as she pushed away the memories."
    "Kiara hielt inne, biss sich auf die Lippe, wandte den Kopf ab und schloss die Augen, während sie die Erinnerungen verdrängte."

# game/data/travel_events/camp/kiara_camp_scene.rpy:95
translate de travel_event_kiara_camp_scene_firsttime_1adec665:

    # KIARA @ sad "I understand if you hate me right now."
    KIARA @ sad "Ich verstehe, wenn du mich jetzt hasst."

# game/data/travel_events/camp/kiara_camp_scene.rpy:96
translate de travel_event_kiara_camp_scene_firsttime_01276b13:

    # KIARA @ sad "Believe me... I've been fucking hating myself for months over it."
    KIARA @ sad "Glaub mir... ich hasse mich verdammt noch mal seit Monaten selbst dafür."

# game/data/travel_events/camp/kiara_camp_scene.rpy:97
translate de travel_event_kiara_camp_scene_firsttime_12bb06cf:

    # KIARA @ sad "... {i}But I'm here now.{/i}"
    KIARA @ sad "... {i}Aber jetzt bin ich hier.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:98
translate de travel_event_kiara_camp_scene_firsttime_31776f58:

    # KIARA @ sad "{i}If you can forgive me.{/i}"
    KIARA @ sad "{i}Falls du mir vergeben kannst.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:101
translate de travel_event_kiara_camp_scene_firsttime_5590950f:

    # KIARA @ shock "You... What?"
    KIARA @ shock "Du... Was?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:102
translate de travel_event_kiara_camp_scene_firsttime_1e861f16:

    # KIARA @ sad "I... I thought you might need more time, or-"
    KIARA @ sad "Ich... Ich dachte, du brauchst vielleicht mehr Zeit, oder-"

# game/data/travel_events/camp/kiara_camp_scene.rpy:103
translate de travel_event_kiara_camp_scene_firsttime_5b9c7529:

    # MC @ sad "We both know either of us would have done anything to get out of the scouts."
    MC @ sad "Wir wissen beide, dass jeder von uns alles getan hätte, um aus den Pfadfindern herauszukommen."

# game/data/travel_events/camp/kiara_camp_scene.rpy:104
translate de travel_event_kiara_camp_scene_firsttime_c431b350:

    # MC @ sad "It was just..."
    MC @ sad "Es war nur..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:105
translate de travel_event_kiara_camp_scene_firsttime_7ecb044e:

    # "I ponder the next painful words carefully."
    "Ich überlege die nächsten schmerzhaften Worte sorgfältig."

# game/data/travel_events/camp/kiara_camp_scene.rpy:106
translate de travel_event_kiara_camp_scene_firsttime_0cbc4d83:

    # MC @ sad "{i}Impossible choices for everyone.{/i}"
    MC @ sad "{i}Unmögliche Entscheidungen für alle.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:107
translate de travel_event_kiara_camp_scene_firsttime_3c6dc7c0:

    # "Impossible choices."
    "Unmögliche Entscheidungen."

# game/data/travel_events/camp/kiara_camp_scene.rpy:108
translate de travel_event_kiara_camp_scene_firsttime_3ee06bd1:

    # "If only I was stronger back then."
    "Wenn ich damals nur stärker gewesen wäre."

# game/data/travel_events/camp/kiara_camp_scene.rpy:109
translate de travel_event_kiara_camp_scene_firsttime_1b49f8c7:

    # "{i}If only.{/i}"
    "{i}Wenn nur.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:110
translate de travel_event_kiara_camp_scene_firsttime_6d1790f3:

    # "{b}I could have-{/b}"
    "{b}Ich hätte-{/b}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:111
translate de travel_event_kiara_camp_scene_firsttime_99fd29a1:

    # "I closed my eyes and sighed, banishing the thought."
    "Ich schloss die Augen und seufzte und verbannte den Gedanken."

# game/data/travel_events/camp/kiara_camp_scene.rpy:112
translate de travel_event_kiara_camp_scene_firsttime_5dc7a41e:

    # "No one can change the past, I can't look back."
    "Niemand kann die Vergangenheit ändern, ich kann nicht zurückblicken."

# game/data/travel_events/camp/kiara_camp_scene.rpy:113
translate de travel_event_kiara_camp_scene_firsttime_1b1b7357:

    # "{i}Otherwise I may never be able to look away...{/i}"
    "{i}Sonst könnte ich vielleicht nie wegsehen können...{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:114
translate de travel_event_kiara_camp_scene_firsttime_5efcab3c:

    # "Kiara's eyes dropped to the floor, as her hand carefully reached out to take mine."
    "Kiaras Augen senkten sich auf den Boden, während ihre Hand vorsichtig nach meiner griff."

# game/data/travel_events/camp/kiara_camp_scene.rpy:116
translate de travel_event_kiara_camp_scene_firsttime_8274ab4f:

    # KIARA @ sad "{i}I can stay with you tonight if you want.{/i}"
    KIARA @ sad "{i}Ich kann heute Nacht bei dir bleiben, wenn du willst.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:117
translate de travel_event_kiara_camp_scene_firsttime_06f07860:

    # KIARA @ sad "{i}I can make it go away.{/i}"
    KIARA @ sad "{i}Ich kann es verschwinden lassen.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:122
translate de travel_event_kiara_camp_scene_firsttime_2f191525:

    # "Kiara gasped as I pulled her to the floor with me."
    "Kiara keuchte, als ich sie mit mir auf den Boden zog."

# game/data/travel_events/camp/kiara_camp_scene.rpy:123
translate de travel_event_kiara_camp_scene_firsttime_f1cd9f29:

    # "With nervous breathes, she looked up towards me as we stripped off our clothes."
    "Mit nervösen Atemzügen blickte sie zu mir auf, während wir uns auszogen."

# game/data/travel_events/camp/kiara_camp_scene.rpy:128
translate de travel_event_kiara_camp_scene_firsttime_0aa4abf5:

    # KIARA "Are you... Are you sure about this?"
    KIARA "Bist du... Bist du dir dabei sicher?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:129
translate de travel_event_kiara_camp_scene_firsttime_c957f184:

    # KIARA "I don't want you to feel you need to rush this."
    KIARA "Ich möchte nicht, dass du das Gefühl hast, du müsstest das überstürzen."

# game/data/travel_events/camp/kiara_camp_scene.rpy:130
