# TODO: Translation updated at 2026-08-04 03:41

# game/data/travel_events/crashed_ship.rpy:13
translate de travel_event_crashed_ship_c7f49737:

    # BLACK "{i}...Going wrong way.{/i}"
    BLACK "{i}...Falsche Richtung.{/i}"

# game/data/travel_events/crashed_ship.rpy:15
translate de travel_event_crashed_ship_73790772:

    # MC @ angry "We are not going the wrong way!"
    MC @ angry "Wir gehen nicht in die falsche Richtung!"

# game/data/travel_events/crashed_ship.rpy:16
translate de travel_event_crashed_ship_1cd0e33a:

    # BLACK "{i}We are lost.{/i}"
    BLACK "{i}Wir haben uns verlaufen.{/i}"

# game/data/travel_events/crashed_ship.rpy:17
translate de travel_event_crashed_ship_71d2cf05:

    # MC @ angry "We are not lost!"
    MC @ angry "Wir haben uns nicht verlaufen!"

# game/data/travel_events/crashed_ship.rpy:19
translate de travel_event_crashed_ship_66dfd255:

    # MC @ talk "We just—"
    MC @ talk "Wir müssen nur—"

# game/data/travel_events/crashed_ship.rpy:21
translate de travel_event_crashed_ship_90844184:

    # MC @ talk "We just need to find our—"
    MC @ talk "Wir müssen nur unsere—"

# game/data/travel_events/crashed_ship.rpy:23
translate de travel_event_crashed_ship_88b2ee55:

    # "Suddenly, I felt the earth crumble beneath me."
    "Plötzlich spürte ich, wie die Erde unter mir nachgab."

# game/data/travel_events/crashed_ship.rpy:26
translate de travel_event_crashed_ship_934fef82:

    # "I gasped as I plummeted into a great chasm below."
    "Ich schnappte nach Luft, als ich in eine große Kluft unter mir stürzte."

# game/data/travel_events/crashed_ship.rpy:28
translate de travel_event_crashed_ship_a4b26b88:

    # "The fall lasted only moments, wind whipping past as panic surged through me."
    "Der Sturz dauerte nur Augenblicke, der Wind peitschte vorbei und Panik durchflutete mich."

# game/data/travel_events/crashed_ship.rpy:29
translate de travel_event_crashed_ship_b71673c2:

    # "One of my blackened tentacles shot out, anchoring into the wall and halting my descent."
    "Einer meiner geschwärzten Tentakel schoss hervor, verankerte sich in der Wand und stoppte meinen Absturz."

# game/data/travel_events/crashed_ship.rpy:30
translate de travel_event_crashed_ship_e352090c:

    # MARKUS @ shock "[player_name!t]!"
    MARKUS @ shock "[player_name!t]!"

# game/data/travel_events/crashed_ship.rpy:32
translate de travel_event_crashed_ship_81a47010:

    # "Lowering myself carefully, I landed on a patch of dirt below, lit faintly by the chasm's natural opening."
    "Langsam ließ ich mich herab und landete auf einem Fleckchen Erde darunter, schwach beleuchtet von der natürlichen Öffnung der Schlucht."

# game/data/travel_events/crashed_ship.rpy:33
translate de travel_event_crashed_ship_dda0aa4b:

    # MARKUS "Can you hear me?!"
    MARKUS "Kannst du mich hören?!"

# game/data/travel_events/crashed_ship.rpy:34
translate de travel_event_crashed_ship_354115c9:

    # MC @ talk "I'm alright."
    MC @ talk "Mir geht's gut."

# game/data/travel_events/crashed_ship.rpy:35
translate de travel_event_crashed_ship_6baba279:

    # "As my eyes adjusted, the full scale of the pit became clear."
    "Als meine Augen sich daran gewöhnt hatten, wurde die volle Ausdehnung der Grube klar."

# game/data/travel_events/crashed_ship.rpy:41
translate de travel_event_crashed_ship_141d7189:

    # MC @ think "Is this... some kind of cave?"
    MC @ think "Ist das... eine Art Höhle?"

# game/data/travel_events/crashed_ship.rpy:43
translate de travel_event_crashed_ship_f02ac22b:

    # "There, partially submerged in shallow water, was something metallic—a ship?"
    "Dort, teilweise unter flachem Wasser, war etwas Metallisches – ein Schiff?"

# game/data/travel_events/crashed_ship.rpy:44
translate de travel_event_crashed_ship_e26d324c:

    # "Ruined and entangled in vines, the strange relic beckoned."
    "Zerstört und von Ranken umschlungen lockte das seltsame Relikt."

# game/data/travel_events/crashed_ship.rpy:45
translate de travel_event_crashed_ship_b3c9f1a5:

    # MARKUS "What do you see down there?!"
    MARKUS "Was siehst du da unten?!"

# game/data/travel_events/crashed_ship.rpy:46
translate de travel_event_crashed_ship_8ec5fa0b:

    # MC @ serious "You might want to come down here."
    MC @ serious "Vielleicht möchtest du hier runterkommen."

# game/data/travel_events/crashed_ship.rpy:48
translate de travel_event_crashed_ship_4001a4a4:

    # "The others climbed down with caution."
    "Die anderen kletterten vorsichtig hinab."

# game/data/travel_events/crashed_ship.rpy:50
translate de travel_event_crashed_ship_f5a0c50b:

    # MARKUS @ shock "What in seven hells is that thing?"
    MARKUS @ shock "Was in sieben Höllen ist das für ein Ding?"

# game/data/travel_events/crashed_ship.rpy:51
translate de travel_event_crashed_ship_11bcc543:

    # MC @ think "Some kind of ship?"
    MC @ think "Irgendeine Art Schiff?"

# game/data/travel_events/crashed_ship.rpy:52
translate de travel_event_crashed_ship_539ee9fb:

    # MARKUS @ talk "Where are its sails?"
    MARKUS @ talk "Wo sind seine Segel?"

# game/data/travel_events/crashed_ship.rpy:53
translate de travel_event_crashed_ship_3dad54df:

    # MC @ think "Never seen a vessel like this... and this far from any sea?"
    MC @ think "Noch nie ein solches Schiff gesehen ... und so weit von jeglichem Meer entfernt?"

# game/data/travel_events/crashed_ship.rpy:57
translate de travel_event_crashed_ship_0208f36a:

    # MYU @ scared "M-Myu? Metal thing scary..."
    MYU @ scared "M-Myu? Metallding gruselig..."

# game/data/travel_events/crashed_ship.rpy:62
translate de travel_event_crashed_ship_8138fa88:

    # VES @ think "I've heard rumors of the Greater Trading Company reinforcing ships with armor, but this..."
    VES @ think "Ich habe Gerüchte gehört, dass die Große Handelskompanie Schiffe mit Rüstung verstärkt, aber das..."

# game/data/travel_events/crashed_ship.rpy:63
translate de travel_event_crashed_ship_e9cd7d09:

    # VES @ talk "This is nothing like anything I've ever seen."
    VES @ talk "Das ist ganz anders als alles, was ich je gesehen habe."

# game/data/travel_events/crashed_ship.rpy:68
translate de travel_event_crashed_ship_ba8e8344:

    # ELENA @ grumpy "Perhaps... a relic of the old gods?"
    ELENA @ grumpy "Vielleicht... ein Relikt der alten Götter?"

# game/data/travel_events/crashed_ship.rpy:69
translate de travel_event_crashed_ship_c90ffbe7:

    # ELENA @ grumpy "Judging by how deep this cavern is, it must've been buried here for thousands of years."
    ELENA @ grumpy "Gemessen an der Tiefe dieser Höhle muss es hier seit Tausenden von Jahren vergraben sein."

# game/data/travel_events/crashed_ship.rpy:75
translate de travel_event_crashed_ship_985866dd:

    # SYPHA @ talk "{i}And so, in ages past, they rode mechanical beasts across the stars.{/i}"
    SYPHA @ talk "{i}Und so ritten sie in vergangenen Zeiten auf mechanischen Bestien durch die Sterne.{/i}"

# game/data/travel_events/crashed_ship.rpy:76
translate de travel_event_crashed_ship_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Was?"

# game/data/travel_events/crashed_ship.rpy:77
translate de travel_event_crashed_ship_c24c1193:

    # SYPHA @ think "Nothing. Just old legends from childhood."
    SYPHA @ think "Nichts. Nur alte Legenden aus der Kindheit."

# game/data/travel_events/crashed_ship.rpy:84
translate de travel_event_crashed_ship_16bf6a3c:

    # MC @ serious "Whatever it is, I don't like it."
    MC @ serious "Was auch immer es ist, ich mag es nicht."

# game/data/travel_events/crashed_ship.rpy:85
translate de travel_event_crashed_ship_cfd774db:

    # MC @ talk "Let's leave sleeping ghosts to rest."
    MC @ talk "Lasst uns die schlafenden Geister ruhen lassen."

# game/data/travel_events/crashed_ship.rpy:86
translate de travel_event_crashed_ship_516553f1:

    # MARKUS @ talk "Agreed. Nothing good comes from disturbing the dead."
    MARKUS @ talk "Einverstanden. Nichts Gutes kommt dabei heraus, die Toten zu stören."

# game/data/travel_events/crashed_ship.rpy:88
translate de travel_event_crashed_ship_013b3791:

    # "We climbed back out of the rift and resumed our journey."
    "Wir kletterten aus der Spalte zurück und setzten unsere Reise fort."

# game/data/travel_events/crashed_ship.rpy:95
translate de travel_event_crashed_ship_inside_4a677239:

    # "Carefully, I approached the wreck."
    "Vorsichtig näherte ich mich dem Wrack."

# game/data/travel_events/crashed_ship.rpy:96
translate de travel_event_crashed_ship_inside_c1071274:

    # "I stepped into the freezing water and laid my hand on the cold metal hull."
    "Ich trat in das eiskalte Wasser und legte meine Hand auf die kalte Metallhülle."

# game/data/travel_events/crashed_ship.rpy:99
translate de travel_event_crashed_ship_inside_08beff35:

    # MARKUS @ shock "[player_name!t]! What are you doing?"
    MARKUS @ shock "[player_name!t]! Was machst du da?"

# game/data/travel_events/crashed_ship.rpy:101
translate de travel_event_crashed_ship_inside_9ec1a37a:

    # "A hiss of steam sounded as the metal twisted open like a door."
    "Ein Zischen von Dampf ertönte, als sich das Metall wie eine Tür aufdrehte."

# game/data/travel_events/crashed_ship.rpy:102
translate de travel_event_crashed_ship_inside_79a0bb39:

    # MARKUS @ shock "You're not actually going inside that thing, are you?"
    MARKUS @ shock "Du gehst doch nicht wirklich in dieses Ding hinein, oder?"

# game/data/travel_events/crashed_ship.rpy:103
translate de travel_event_crashed_ship_inside_026bc247:

    # "I stepped in."
    "Ich trat ein."

# game/data/travel_events/crashed_ship.rpy:104
translate de travel_event_crashed_ship_inside_970d0f74:

    # MARKUS @ angry "Gods be damned, man."
    MARKUS @ angry "Götter verdammt, Mann."

# game/data/travel_events/crashed_ship.rpy:109
translate de travel_event_crashed_ship_inside_bc2341db:

    # "Inside, it was cold."
    "Drinnen war es kalt."

# game/data/travel_events/crashed_ship.rpy:112
translate de travel_event_crashed_ship_inside_4f0eba80:

    # "Our footsteps echoed across the metal floor."
    "Unsere Schritte hallten über den Metallboden."

# game/data/travel_events/crashed_ship.rpy:113
translate de travel_event_crashed_ship_inside_b2b6c7a4:

    # "Pipes snaked along the walls, choked in vines and pierced by jagged rock."
    "Rohre schlängelten sich die Wände entlang, von Ranken erstickt und von gezacktem Fels durchbohrt."

# game/data/travel_events/crashed_ship.rpy:118
translate de travel_event_crashed_ship_inside_bd8053a5:

    # "A ghostly figure flickered into view inside a glowing circle."
    "Eine geisterhafte Gestalt flackerte in einem leuchtenden Kreis auf."

# game/data/travel_events/crashed_ship.rpy:119
translate de travel_event_crashed_ship_inside_472ec9d8:

    # MC @ angry "Who are you, specter?"
    MC @ angry "Wer bist du, Gespenst?"

# game/data/travel_events/crashed_ship.rpy:120
translate de travel_event_crashed_ship_inside_bf2aaff8:

    # ANDRAS "This is Captain Andras of the Maylark."
    ANDRAS "Dies ist Captain Andras von der Maylark."

# game/data/travel_events/crashed_ship.rpy:121
translate de travel_event_crashed_ship_inside_365bbf88:

    # ANDRAS "Day four-hundred and ninety-six since the end of... well, everything."
    ANDRAS "Tag vierhundertsechsundneunzig seit dem Ende von ... nun ja, allem."

# game/data/travel_events/crashed_ship.rpy:122
translate de travel_event_crashed_ship_inside_bf38bc6e:

    # MARKUS @ think "Uhhh... hello?"
    MARKUS @ think "Ähhh ... hallo?"

# game/data/travel_events/crashed_ship.rpy:123
translate de travel_event_crashed_ship_inside_18baf767:

    # MC @ think "I don't think he can hear us."
    MC @ think "Ich glaube nicht, dass er uns hören kann."

# game/data/travel_events/crashed_ship.rpy:124
translate de travel_event_crashed_ship_inside_b20d5e02:

    # ANDRAS "...{i}*Sigh*{/i} I don't even know why I bother with these things anymore."
    ANDRAS "...{i}*Seufz*{/i} Ich weiß nicht einmal, warum ich mich mit diesen Dingen überhaupt noch abgebe."

# game/data/travel_events/crashed_ship.rpy:125
translate de travel_event_crashed_ship_inside_96afb379:

    # ANDRAS "It's not like there's actually anyone left to log it."
    ANDRAS "Es ist ja nicht so, als ob tatsächlich noch jemand übrig wäre, um es aufzuzeichnen."

# game/data/travel_events/crashed_ship.rpy:126
translate de travel_event_crashed_ship_inside_62cfcc16:

    # ANDRAS "For over a year and a half we've jumped from one dead star to the next."
    ANDRAS "Seit über anderthalb Jahren springen wir von einem toten Stern zum nächsten."

# game/data/travel_events/crashed_ship.rpy:127
translate de travel_event_crashed_ship_inside_881f07eb:

    # ANDRAS "One nightmarish, monster infested world to another, searching for someplace safe."
    ANDRAS "Von einer albtraumhaften, von Monstern verseuchten Welt zur nächsten, auf der Suche nach einem sicheren Ort."

# game/data/travel_events/crashed_ship.rpy:128
translate de travel_event_crashed_ship_inside_e84fa312:

    # ANDRAS "I still tell the crew that's what we're looking for... Someplace safe."
    ANDRAS "Ich erzähle der Crew immer noch, dass das ist, wonach wir suchen ... Ein sicherer Ort."

# game/data/travel_events/crashed_ship.rpy:129
translate de travel_event_crashed_ship_inside_ec95d44a:

    # ANDRAS "I'd just settle for finding some food, fuel... anything now."
    ANDRAS "Ich würde mich inzwischen schon mit etwas Nahrung, Treibstoff ... irgendetwas zufriedengeben."

# game/data/travel_events/crashed_ship.rpy:130
translate de travel_event_crashed_ship_inside_b3b6925c:

    # ANDRAS "It's been months since we found any survivors."
    ANDRAS "Es ist Monate her, seit wir das letzte Mal Überlebende gefunden haben."

# game/data/travel_events/crashed_ship.rpy:131
translate de travel_event_crashed_ship_inside_9fb46d95:

    # ANDRAS "Well, unless you count the cannibals and freaks."
    ANDRAS "Nun, es sei denn, du zählst die Kannibalen und Freaks."

# game/data/travel_events/crashed_ship.rpy:132
translate de travel_event_crashed_ship_inside_89d8f69d:

    # ANDRAS "... We have enough fuel for one last try, some unknown world ready on the edge of the Zelma ring."
    ANDRAS "... Wir haben genug Treibstoff für einen letzten Versuch, eine unbekannte Welt, bereit am Rande des Zelma-Rings."

# game/data/travel_events/crashed_ship.rpy:133
translate de travel_event_crashed_ship_inside_5b2a8029:

    # ANDRAS "Atmospheric readings look good from orbit, and there seems to be no visual signs of corruption."
    ANDRAS "Die Atmosphärenwerte sehen vom Orbit aus gut aus, und es scheint keine sichtbaren Anzeichen von Verderbnis zu geben."

# game/data/travel_events/crashed_ship.rpy:134
translate de travel_event_crashed_ship_inside_8cd54f27:

    # ANDRAS "We'll probably stall out on the landing, but hopefully with power routed to the shields, we can at least survive the crash."
    ANDRAS "Wir werden bei der Landung wohl einen Triebwerksausfall haben, aber hoffentlich können wir, wenn wir die Energie zu den Schilden umleiten, den Absturz zumindest überleben."

# game/data/travel_events/crashed_ship.rpy:135
translate de travel_event_crashed_ship_inside_bfea744e:

    # ANDRAS "May the new gods... Ahhh, fuck it."
    ANDRAS "Mögen die neuen Götter... Ahhh, scheiß drauf."

# game/data/travel_events/crashed_ship.rpy:136
translate de travel_event_crashed_ship_inside_737f7819:

    # ANDRAS "{i}It's not like they're listening anymore anyway.{/i}"
    ANDRAS "{i}Es ist ja nicht so, dass sie noch zuhören würden.{/i}"

# game/data/travel_events/crashed_ship.rpy:137
translate de travel_event_crashed_ship_inside_9e72f391:

    # "There was momentary flickering of the strange figure summoned."
    "Die seltsame beschworene Gestalt flackerte kurz auf."

# game/data/travel_events/crashed_ship.rpy:138
translate de travel_event_crashed_ship_inside_0742b26c:

    # ANDRAS "Day, five hundred and two."
    ANDRAS "Tag fünfhundertzwei."

# game/data/travel_events/crashed_ship.rpy:139
translate de travel_event_crashed_ship_inside_ce1c3d26:

    # ANDRAS "We survived the landing, but the ship's hull is too badly damaged to repair."
    ANDRAS "Wir haben die Landung überlebt, aber der Rumpf des Schiffs ist zu stark beschädigt, um repariert zu werden."

# game/data/travel_events/crashed_ship.rpy:140
translate de travel_event_crashed_ship_inside_7ca46618:

    # ANDRAS "{i}*Chuckles*{/i} Not that we have to fuel left to go anywhere anyway."
    ANDRAS "{i}*Kichert*{/i} Nicht, dass wir noch Treibstoff hätten, um überhaupt irgendwohin zu kommen."

# game/data/travel_events/crashed_ship.rpy:141
translate de travel_event_crashed_ship_inside_ece942c3:

    # ANDRAS "The crew and I have decided to salvage what we can from the ship and head out."
    ANDRAS "Die Crew und ich haben beschlossen, zu bergen, was wir vom Schiff können, und aufzubrechen."

# game/data/travel_events/crashed_ship.rpy:142
translate de travel_event_crashed_ship_inside_7d01dea4:

    # ANDRAS "Maybe we can etch out some kind of existence out here."
    ANDRAS "Vielleicht können wir uns hier draußen irgendeine Existenz aufbauen."

# game/data/travel_events/crashed_ship.rpy:143
translate de travel_event_crashed_ship_inside_9c0c2393:

    # ANDRAS "It might be a simple life... {i}But at least we're alive.{/i}"
    ANDRAS "Es könnte ein einfaches Leben sein ... {i}Aber wenigstens leben wir.{/i}"

# game/data/travel_events/crashed_ship.rpy:144
translate de travel_event_crashed_ship_inside_2d52d85d:

    # ANDRAS "... The gods."
    ANDRAS "... Die Götter."

# game/data/travel_events/crashed_ship.rpy:145
translate de travel_event_crashed_ship_inside_6c5751a7:

    # ANDRAS "How the fuck did it come to this?"
    ANDRAS "Wie zum Teufel ist es dazu gekommen?"

# game/data/travel_events/crashed_ship.rpy:146
translate de travel_event_crashed_ship_inside_94c58f75:

    # ANDRAS "We blame it all on Malakai and his damned war, but in the end, maybe it was just our blind faith that sealed our fates."
    ANDRAS "Wir schieben alles auf Malakai und seinen verdammten Krieg, aber am Ende war es vielleicht nur unser blinder Glaube, der unser Schicksal besiegelte."

# game/data/travel_events/crashed_ship.rpy:147
translate de travel_event_crashed_ship_inside_2820ff0b:

    # ANDRAS "We always presumed the gods were better than us, wiser, {i}more{/i} than us."
    ANDRAS "Wir haben immer angenommen, dass die Götter besser sind als wir, weiser, {i}mehr{/i} als wir."

# game/data/travel_events/crashed_ship.rpy:148
translate de travel_event_crashed_ship_inside_b9ea5e3e:

    # ANDRAS "{i}But in the end, they fell to all the same trappings we do.{/i}"
    ANDRAS "{i}Aber am Ende verfielen sie denselben Fallstricken wie wir.{/i}"

# game/data/travel_events/crashed_ship.rpy:149
translate de travel_event_crashed_ship_inside_e5b270d3:

    # ANDRAS "{i}And they dragged everyone down with them.{/i}"
    ANDRAS "{i}Und sie zogen alle mit sich hinunter.{/i}"

# game/data/travel_events/crashed_ship.rpy:150
translate de travel_event_crashed_ship_inside_8a41f029:

    # ANDRAS "... Fuck the gods."
    ANDRAS "... Scheiß auf die Götter."

# game/data/travel_events/crashed_ship.rpy:151
translate de travel_event_crashed_ship_inside_1216340c:

    # ANDRAS "This is Captain Andras of the Maylark, signing off for the last time."
    ANDRAS "Hier spricht Captain Andras von der Maylark und verabschiedet sich zum letzten Mal."

# game/data/travel_events/crashed_ship.rpy:152
translate de travel_event_crashed_ship_inside_10ce0df8:

    # "The image flickered, then began replaying."
    "Das Bild flackerte und begann dann erneut zu spielen."

# game/data/travel_events/crashed_ship.rpy:155
translate de travel_event_crashed_ship_inside_9d9f6087:

    # MC @ think "What do you make of that?"
    MC @ think "Was hältst du davon?"

# game/data/travel_events/crashed_ship.rpy:157
translate de travel_event_crashed_ship_inside_df5f47d2:

    # MARKUS @ talk "Jumping stars... Malakai's war... If this is from the Second War of the Gods... it's ancient."
    MARKUS @ talk "Springende Sterne ... Malakais Krieg ... Wenn das aus dem Zweiten Krieg der Götter stammt ... ist es uralt."

# game/data/travel_events/crashed_ship.rpy:161
translate de travel_event_crashed_ship_inside_ad56e14d:

    # SYPHA @ talk "We shouldn't linger."
    SYPHA @ talk "Wir sollten nicht verweilen."

# game/data/travel_events/crashed_ship.rpy:162
translate de travel_event_crashed_ship_inside_613528ce:

    # SYPHA @ think "Let ghosts rest."
    SYPHA @ think "Lasst die Geister ruhen."

# game/data/travel_events/crashed_ship.rpy:171
translate de travel_event_crashed_ship_inside_17813b31:

    # "Most of it had decayed."
    "Das meiste davon war verfallen."

# game/data/travel_events/crashed_ship.rpy:172
translate de travel_event_crashed_ship_inside_1bcd7585:

    # "Anything that once had purpose crumbled in my hands."
    "Alles, was einst einen Zweck hatte, zerfiel in meinen Händen."

# game/data/travel_events/crashed_ship.rpy:173
translate de travel_event_crashed_ship_inside_e4d9e770:

    # "Except... one thing."
    "Außer ... einer Sache."

# game/data/travel_events/crashed_ship.rpy:174
translate de travel_event_crashed_ship_inside_d79ab9c3:

    # "A small metal box."
    "Eine kleine Metallbox."

# game/data/travel_events/crashed_ship.rpy:175
translate de travel_event_crashed_ship_inside_4b38b6fa:

    # "Inside, a glowing blue crystal pulsed rhythmically."
    "Drinnen pulsierte ein leuchtend blauer Kristall rhythmisch."

# game/data/travel_events/crashed_ship.rpy:179
translate de travel_event_crashed_ship_inside_50da1bb3:

    # "I reached in and took the orb."
    "Ich griff hinein und nahm die Kugel."

# game/data/travel_events/crashed_ship.rpy:180
translate de travel_event_crashed_ship_inside_1343b6dc:

    # "It detached easily from its cables."
    "Sie löste sich leicht von ihren Kabeln."

