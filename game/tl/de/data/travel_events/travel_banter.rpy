# TODO: Translation updated at 2026-08-04 03:41

# game/data/travel_events/travel_banter.rpy:38
translate de travelmodebanter_map_elena_mc_1_1d4d5faf:

    # ELENA @ talk "Have you ever thought about leaving Alderay?"
    ELENA @ talk "Hast du jemals darüber nachgedacht, Alderay zu verlassen?"

# game/data/travel_events/travel_banter.rpy:39
translate de travelmodebanter_map_elena_mc_1_4a2613e4:

    # MC @ think "Where'd that come from?"
    MC @ think "Woher kommt das denn?"

# game/data/travel_events/travel_banter.rpy:40
translate de travelmodebanter_map_elena_mc_1_9828a89f:

    # ELENA @ talk "Just... curiosity."
    ELENA @ talk "Nur... Neugierde."

# game/data/travel_events/travel_banter.rpy:41
translate de travelmodebanter_map_elena_mc_1_e722756d:

    # ELENA @ talk "Growing up at Thornfalls, I dreamt of faraway places and adventures."
    ELENA @ talk "Als ich in Thornfalls aufwuchs, träumte ich von fernen Orten und Abenteuern."

# game/data/travel_events/travel_banter.rpy:42
translate de travelmodebanter_map_elena_mc_1_6308ffa5:

    # ELENA @ smile "It seems silly now, but... I still think about the places I want to see."
    ELENA @ smile "Jetzt erscheint es albern, aber... ich denke immer noch über die Orte nach, die ich sehen möchte."

# game/data/travel_events/travel_banter.rpy:45
translate de travelmodebanter_map_elena_mc_1_96b1d0a3:

    # ELENA @ shock "Just like that?"
    ELENA @ shock "Einfach so?"

# game/data/travel_events/travel_banter.rpy:46
translate de travelmodebanter_map_elena_mc_1_bb7eda56:

    # MC @ smile "There's a whole world out there."
    MC @ smile "Da draußen gibt es eine ganze Welt."

# game/data/travel_events/travel_banter.rpy:47
translate de travelmodebanter_map_elena_mc_1_c579fce3:

    # ELENA @ smile "And would there be room for one more?"
    ELENA @ smile "Und gäbe es Platz für einen mehr?"

# game/data/travel_events/travel_banter.rpy:48
translate de travelmodebanter_map_elena_mc_1_6bc977b7:

    # MC @ smile2 "I'm sure I could fit you in."
    MC @ smile2 "Ich bin sicher, ich könnte dich unterbringen."

# game/data/travel_events/travel_banter.rpy:49
translate de travelmodebanter_map_elena_mc_1_5b4dee46:

    # ELENA @ smile "I must admit, I'm surprised."
    ELENA @ smile "Ich muss zugeben, ich bin überrascht."

# game/data/travel_events/travel_banter.rpy:50
translate de travelmodebanter_map_elena_mc_1_082ad89d:

    # ELENA @ smile "Markus told me all you two wanted was a quiet life behind palace walls."
    ELENA @ smile "Markus hat mir erzählt, dass ihr beide nur ein ruhiges Leben hinter Palastmauern wolltet."

# game/data/travel_events/travel_banter.rpy:51
translate de travelmodebanter_map_elena_mc_1_0d739712:

    # MC @ talk "Funny, isn't it?"
    MC @ talk "Komisch, nicht wahr?"

# game/data/travel_events/travel_banter.rpy:52
translate de travelmodebanter_map_elena_mc_1_995149d2:

    # MC @ talk "That dream started feeling more like a cage after... everything."
    MC @ talk "Dieser Traum fühlte sich nach... allem eher wie ein Käfig an."

# game/data/travel_events/travel_banter.rpy:53
translate de travelmodebanter_map_elena_mc_1_e5753e06:

    # ELENA @ smile "No. Not strange at all. Not to me."
    ELENA @ smile "Nein. Überhaupt nicht seltsam. Für mich nicht."

# game/data/travel_events/travel_banter.rpy:55
translate de travelmodebanter_map_elena_mc_1_19758ec6:

    # ELENA @ talk "Ahh, you seem more like a homebody."
    ELENA @ talk "Ahh, du wirkst eher wie ein Stubenhocker."

# game/data/travel_events/travel_banter.rpy:56
translate de travelmodebanter_map_elena_mc_1_b3517fc1:

    # MC @ think "Oh?"
    MC @ think "Oh?"

# game/data/travel_events/travel_banter.rpy:57
translate de travelmodebanter_map_elena_mc_1_01b971be:

    # ELENA @ grumpy "You and Markus dreamed of royal service, didn't you?"
    ELENA @ grumpy "Du und Markus habt von königlichem Dienst geträumt, nicht wahr?"

# game/data/travel_events/travel_banter.rpy:58
translate de travelmodebanter_map_elena_mc_1_6204f33e:

    # ELENA @ smile "Not exactly an adventurous life."
    ELENA @ smile "Nicht gerade ein abenteuerliches Leben."

# game/data/travel_events/travel_banter.rpy:59
translate de travelmodebanter_map_elena_mc_1_ab966d56:

    # MC @ talk "Is wanting a quiet life so wrong?"
    MC @ talk "Ist es so falsch, ein ruhiges Leben zu wollen?"

# game/data/travel_events/travel_banter.rpy:60
translate de travelmodebanter_map_elena_mc_1_4ca3d53f:

    # ELENA @ smile "Not at all."
    ELENA @ smile "Überhaupt nicht."

# game/data/travel_events/travel_banter.rpy:61
translate de travelmodebanter_map_elena_mc_1_b2753dd2:

    # ELENA @ smile "It's your life to live."
    ELENA @ smile "Es ist dein Leben."

# game/data/travel_events/travel_banter.rpy:62
translate de travelmodebanter_map_elena_mc_1_cdd397f7:

    # MC @ think "{i}... And when this war is one day over.{/i}"
    MC @ think "{i}... Und wenn dieser Krieg eines Tages vorbei ist.{/i}"

# game/data/travel_events/travel_banter.rpy:63
translate de travelmodebanter_map_elena_mc_1_1cfe520f:

    # MC @ think "{i}Is it a life you'd want to be a part of?{/i}"
    MC @ think "{i}Ist es ein Leben, an dem du teilhaben möchtest?{/i}"

# game/data/travel_events/travel_banter.rpy:64
translate de travelmodebanter_map_elena_mc_1_4c9bb63b:

    # ELENA @ lewd "L-Let's leave that question for another day."
    ELENA @ lewd "L-Lassen wir diese Frage für einen anderen Tag."

# game/data/travel_events/travel_banter.rpy:74
translate de travelmodebanter_map_elena_mc_2_dfcc99a2:

    # ELENA @ grumpy "...Does it hurt?"
    ELENA @ grumpy "... Tut es weh?"

# game/data/travel_events/travel_banter.rpy:76
translate de travelmodebanter_map_elena_mc_2_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Was?"

# game/data/travel_events/travel_banter.rpy:77
translate de travelmodebanter_map_elena_mc_2_4b60e47a:

    # ELENA @ grumpy "When you change into that thing... does it hurt?"
    ELENA @ grumpy "Wenn du dich in dieses Ding verwandelst... tut es weh?"

# game/data/travel_events/travel_banter.rpy:78
translate de travelmodebanter_map_elena_mc_2_3496abfa:

    # MC @ talk "It... did. At first."
    MC @ talk "Es... hat wehgetan. Am Anfang."

# game/data/travel_events/travel_banter.rpy:80
translate de travelmodebanter_map_elena_mc_2_0a297aba:

    # MC @ talk "It was agony."
    MC @ talk "Es war eine Qual."

# game/data/travel_events/travel_banter.rpy:81
translate de travelmodebanter_map_elena_mc_2_54e3ddd7:

    # MC @ talk "But it gets easier every time."
    MC @ talk "Aber es wird jedes Mal einfacher."

# game/data/travel_events/travel_banter.rpy:83
translate de travelmodebanter_map_elena_mc_2_c2fc29a5:

    # MC @ talk "Why do you ask?"
    MC @ talk "Warum fragst du?"

# game/data/travel_events/travel_banter.rpy:84
translate de travelmodebanter_map_elena_mc_2_ede2ccf2:

    # ELENA @ sad "Just worried about you."
    ELENA @ sad "Ich mache mir nur Sorgen um dich."

# game/data/travel_events/travel_banter.rpy:85
translate de travelmodebanter_map_elena_mc_2_7cedfe97:

    # ELENA @ talk "How are you holding up? After everything that's happened so fast..."
    ELENA @ talk "Wie hältst du dich? Nach allem, was so schnell passiert ist ..."

# game/data/travel_events/travel_banter.rpy:88
translate de travelmodebanter_map_elena_mc_2_cf94bad7:

    # ELENA @ shock "Really? I'm surprised... most people would struggle."
    ELENA @ shock "Wirklich? Das überrascht mich ... die meisten würden zu kämpfen haben."

# game/data/travel_events/travel_banter.rpy:89
translate de travelmodebanter_map_elena_mc_2_094bce6b:

    # MC @ talk "There are doubts, sure. But we can actually change things now."
    MC @ talk "Es gibt Zweifel, klar. Aber wir können jetzt tatsächlich Dinge verändern."

# game/data/travel_events/travel_banter.rpy:90
translate de travelmodebanter_map_elena_mc_2_e1f4d040:

    # MC @ smile "Before the gift, I felt powerless. Like my life wasn't mine."
    MC @ smile "Vor dem Geschenk fühlte ich mich machtlos. Als ob mein Leben nicht mir gehörte."

# game/data/travel_events/travel_banter.rpy:91
translate de travelmodebanter_map_elena_mc_2_92dfa1e6:

    # MC @ smile "Now? It's like we finally have... {i}hope.{/i}"
    MC @ smile "Jetzt? Es ist, als hätten wir endlich ... {i}Hoffnung.{/i}"

# game/data/travel_events/travel_banter.rpy:92
translate de travelmodebanter_map_elena_mc_2_73c0b9f3:

    # ELENA @ smile "You're starting to sound like a hero from the old tales."
    ELENA @ smile "Du fängst an, wie ein Held aus den alten Erzählungen zu klingen."

# game/data/travel_events/travel_banter.rpy:93
translate de travelmodebanter_map_elena_mc_2_f18990c6:

    # MC @ smile "Let's not go that far."
    MC @ smile "Lass uns nicht so weit gehen."

# game/data/travel_events/travel_banter.rpy:94
translate de travelmodebanter_map_elena_mc_2_91c8e0b3:

    # ELENA @ smile "Come. Let's keep moving."
    ELENA @ smile "Komm. Lass uns weitergehen."

# game/data/travel_events/travel_banter.rpy:96
translate de travelmodebanter_map_elena_mc_2_a4311795:

    # ELENA @ sad "That's... a relief. You can talk to me, you know."
    ELENA @ sad "Das ist... eine Erleichterung. Du kannst mit mir reden, weißt du."

# game/data/travel_events/travel_banter.rpy:97
translate de travelmodebanter_map_elena_mc_2_b067621a:

    # MC @ smile "That means more than you think."
    MC @ smile "Das bedeutet mehr, als du denkst."

# game/data/travel_events/travel_banter.rpy:98
translate de travelmodebanter_map_elena_mc_2_42ddcd91:

    # ELENA @ smile "Come on. Let's keep moving."
    ELENA @ smile "Komm schon. Lass uns weitergehen."

# game/data/travel_events/travel_banter.rpy:100
translate de travelmodebanter_map_elena_mc_2_2f15a7d9:

    # ELENA @ sad "I'm here if you want to talk."
    ELENA @ sad "Ich bin hier, wenn du reden willst."

# game/data/travel_events/travel_banter.rpy:101
translate de travelmodebanter_map_elena_mc_2_30d77ce8:

    # ELENA @ sad "It weighs heavy, doesn't it? Memories that won't let go..."
    ELENA @ sad "Es wiegt schwer, nicht wahr? Erinnerungen, die nicht loslassen..."

# game/data/travel_events/travel_banter.rpy:102
translate de travelmodebanter_map_elena_mc_2_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/travel_events/travel_banter.rpy:103
translate de travelmodebanter_map_elena_mc_2_6c08d76e:

    # ELENA @ sad "A-Anyway! I just wanted you to know you're not alone."
    ELENA @ sad "Wie auch immer! Ich wollte nur, dass du weißt, dass du nicht allein bist."

# game/data/travel_events/travel_banter.rpy:104
translate de travelmodebanter_map_elena_mc_2_1a43d7a9:

    # ELENA @ talk "I'm here if you need me."
    ELENA @ talk "Ich bin da, wenn du mich brauchst."

# game/data/travel_events/travel_banter.rpy:105
translate de travelmodebanter_map_elena_mc_2_ddf70b53:

    # MC @ smile "Thank you, Elena."
    MC @ smile "Danke, Elena."

# game/data/travel_events/travel_banter.rpy:106
translate de travelmodebanter_map_elena_mc_2_0403d166:

    # ELENA @ smile "Come. Let's keep going."
    ELENA @ smile "Komm. Lass uns weitergehen."

# game/data/travel_events/travel_banter.rpy:116
translate de travelmodebanter_map_elena_mc_3_romance_ed8a1411:

    # "While walking, something soft brushed against my side."
    "Während des Gehens strich etwas Weiches an meiner Seite entlang."

# game/data/travel_events/travel_banter.rpy:118
translate de travelmodebanter_map_elena_mc_3_romance_899cf127:

    # "Elena passed me with a coy smile and a soft hum."
    "Elena ging mit einem schelmischen Lächeln und einem leisen Summen an mir vorbei."

# game/data/travel_events/travel_banter.rpy:119
translate de travelmodebanter_map_elena_mc_3_romance_fe9303c4:

    # ELENA @ smile "{i}*Happy humming*{/i}"
    ELENA @ smile "{i}*Fröhliches Summen*{/i}"

# game/data/travel_events/travel_banter.rpy:120
translate de travelmodebanter_map_elena_mc_3_romance_3321ea6a:

    # MC @ smile "Someone's in a good mood."
    MC @ smile "Jemand ist gut gelaunt."

# game/data/travel_events/travel_banter.rpy:122
translate de travelmodebanter_map_elena_mc_3_romance_07f53f05:

    # ELENA @ smile "Of course. The weather's pleasant, the air is clean..."
    ELENA @ smile "Natürlich. Das Wetter ist angenehm, die Luft ist sauber..."

# game/data/travel_events/travel_banter.rpy:123
translate de travelmodebanter_map_elena_mc_3_romance_bc9974f6:

    # "She glanced back, her sultry eyes dancing."
    "Sie blickte zurück, ihre verführerischen Augen tanzten."

# game/data/travel_events/travel_banter.rpy:124
translate de travelmodebanter_map_elena_mc_3_romance_3f6ec57a:

    # ELENA @ smile "And {i}the view{/i} is quite nice, too."
    ELENA @ smile "Und {i}die Aussicht{/i} ist auch ganz schön."

# game/data/travel_events/travel_banter.rpy:125
translate de travelmodebanter_map_elena_mc_3_romance_eaad9ebd:

    # MC @ smile "The view, huh?"
    MC @ smile "Die Aussicht, hm?"

# game/data/travel_events/travel_banter.rpy:126
translate de travelmodebanter_map_elena_mc_3_romance_80da6f9e:

    # "Her tail brushed me again playfully as she walked ahead."
    "Ihr Schwanz striff mich erneut spielerisch, als sie vorausging."

# game/data/travel_events/travel_banter.rpy:127
translate de travelmodebanter_map_elena_mc_3_romance_f4fe840d:

    # ELENA @ smile "Yes. It's been on my mind a lot lately."
    ELENA @ smile "Ja. Das beschäftigt mich in letzter Zeit sehr."

# game/data/travel_events/travel_banter.rpy:130
translate de travelmodebanter_map_elena_mc_3_romance_c670f114:

    # MC @ smile "(Cute.)"
    MC @ smile "(Süß.)"

# game/data/travel_events/travel_banter.rpy:137
translate de travelmodebanter_map_elena_markus_1_ddfff1fd:

    # MARKUS @ think "So, you're a lady, then?"
    MARKUS @ think "Also, du bist eine Lady?"

# game/data/travel_events/travel_banter.rpy:139
translate de travelmodebanter_map_elena_markus_1_abecf88a:

    # ELENA @ talk "Yes, I do indeed belong to the female gender."
    ELENA @ talk "Ja, ich gehöre tatsächlich dem weiblichen Geschlecht an."

# game/data/travel_events/travel_banter.rpy:140
translate de travelmodebanter_map_elena_markus_1_d0033b5e:

    # MARKUS @ angry "You know that wasn't what I was talking about!"
    MARKUS @ angry "Du weißt genau, dass ich das nicht gemeint habe!"

# game/data/travel_events/travel_banter.rpy:141
translate de travelmodebanter_map_elena_markus_1_3213a1a5:

    # MARKUS @ talk "I mean, you're a *lady* lady. Like, you grew up in some huge estate house."
    MARKUS @ talk "Ich meine, du bist eine *Lady* Lady. Also, du bist in so einem riesigen Gutshaus aufgewachsen."

# game/data/travel_events/travel_banter.rpy:142
translate de travelmodebanter_map_elena_markus_1_9316f5fc:

    # ELENA @ smile "Yes. The ones with the very long tables and lots of food on them."
    ELENA @ smile "Ja. Die mit den sehr langen Tischen und dem vielen Essen darauf."

# game/data/travel_events/travel_banter.rpy:143
translate de travelmodebanter_map_elena_markus_1_f6ced7d6:

    # ELENA @ smile "Are you going somewhere with this?"
    ELENA @ smile "Worauf willst du hinaus?"

# game/data/travel_events/travel_banter.rpy:144
translate de travelmodebanter_map_elena_markus_1_a54c70bc:

    # MARKUS @ talk "Sensitive much?"
    MARKUS @ talk "Empfindlich, oder?"

# game/data/travel_events/travel_banter.rpy:146
translate de travelmodebanter_map_elena_markus_1_2de858ba:

    # ELENA @ talk "I can assure you, manor house or not, my time at the Thornfalls was... difficult."
    ELENA @ talk "Ich kann dir versichern, Herrenhaus hin oder her, meine Zeit bei den Thornfalls war... schwierig."

# game/data/travel_events/travel_banter.rpy:147
translate de travelmodebanter_map_elena_markus_1_6211068f:

    # MARKUS @ think "I find that hard to believe."
    MARKUS @ think "Das kann ich kaum glauben."

# game/data/travel_events/travel_banter.rpy:148
translate de travelmodebanter_map_elena_markus_1_298cf6f7:

    # MARKUS @ think "Did you ever have to worry about where your next meal would come from?"
    MARKUS @ think "Hast du dich je darum sorgen müssen, woher deine nächste Mahlzeit kommen würde?"

# game/data/travel_events/travel_banter.rpy:149
translate de travelmodebanter_map_elena_markus_1_24473bcf:

    # MARKUS @ think "Or constantly wonder when, not if, the next loved one would be taken by this infernal war?"
    MARKUS @ think "Oder ständig fragen, wann, nicht ob, der nächste geliebte Mensch von diesem höllischen Krieg genommen wird?"

# game/data/travel_events/travel_banter.rpy:150
translate de travelmodebanter_map_elena_markus_1_3cdbde5f:

    # ELENA @ angry "No..."
    ELENA @ angry "Nein..."

# game/data/travel_events/travel_banter.rpy:152
translate de travelmodebanter_map_elena_markus_1_77cdaa2f:

    # ELENA @ angry "I just spent every night living in fear."
    ELENA @ angry "Ich habe einfach jede Nacht in Angst gelebt."

# game/data/travel_events/travel_banter.rpy:153
translate de travelmodebanter_map_elena_markus_1_d313e372:

    # ELENA @ angry "Let me tell you something, Markus."
    ELENA @ angry "Lass mich dir etwas erzählen, Markus."

# game/data/travel_events/travel_banter.rpy:154
translate de travelmodebanter_map_elena_markus_1_f52bc4d7:

    # ELENA @ angry "It's one kind of hell to starve... it's another entirely to wonder if every meal you're served will be your last."
    ELENA @ angry "Es ist die eine Art von Hölle zu verhungern... es ist eine ganz andere, sich zu fragen, ob jede Mahlzeit, die dir serviert wird, deine letzte sein wird."

# game/data/travel_events/travel_banter.rpy:164
translate de travelmodebanter_map_elena_markus_2_6b1dd249:

    # MARKUS @ talk "Tell me, Elena."
    MARKUS @ talk "Erzähl mir, Elena."

# game/data/travel_events/travel_banter.rpy:166
translate de travelmodebanter_map_elena_markus_2_10d78c40:

    # MARKUS @ talk "You must have spent some time traveling around before meeting us."
    MARKUS @ talk "Du musst eine Zeit lang herumgereist sein, bevor du uns getroffen hast."

# game/data/travel_events/travel_banter.rpy:167
translate de travelmodebanter_map_elena_markus_2_2f0ee648:

    # MARKUS @ smile "Got any interesting stories to tell?"
    MARKUS @ smile "Hast du interessante Geschichten zu erzählen?"

# game/data/travel_events/travel_banter.rpy:168
translate de travelmodebanter_map_elena_markus_2_c983087c:

    # ELENA @ grumpy "...A while back, while I was in Newyark, I heard about a 'wolf woman' and naturally, my interest was piqued."
    ELENA @ grumpy "...Vor einer Weile, als ich in Newyark war, hörte ich von einer 'Wolfsfrau' und natürlich war mein Interesse geweckt."

# game/data/travel_events/travel_banter.rpy:169
translate de travelmodebanter_map_elena_markus_2_71871438:

    # ELENA @ talk "It didn't sound like any kind of Katai, so I thought perhaps I might finally find another of my kind."
    ELENA @ talk "Es klang nach keiner Art von Katai, also dachte ich, dass ich vielleicht endlich einen anderen meiner Art finden würde."

# game/data/travel_events/travel_banter.rpy:170
translate de travelmodebanter_map_elena_markus_2_e936c5f8:

    # MARKUS @ think "What did you find?"
    MARKUS @ think "Was hast du gefunden?"

# game/data/travel_events/travel_banter.rpy:171
translate de travelmodebanter_map_elena_markus_2_2dd61dd9:

    # ELENA @ shock "It was a woman who had made some kind of... fur suit from different pelts of wolves."
    ELENA @ shock "Es war eine Frau, die eine Art... Pelzanzug aus verschiedenen Wolfsfellen gemacht hatte."

# game/data/travel_events/travel_banter.rpy:173
translate de travelmodebanter_map_elena_markus_2_03538783:

    # ELENA @ shock "She was running around on stage pretending to be a wolf!"
    ELENA @ shock "Sie rannte auf der Bühne herum und gab vor, ein Wolf zu sein!"

# game/data/travel_events/travel_banter.rpy:174
translate de travelmodebanter_map_elena_markus_2_cc301a3c:

    # ELENA @ shock "Can you imagine people doing such a strange thing?"
    ELENA @ shock "Kannst du dir vorstellen, dass Leute so etwas Seltsames tun?"

# game/data/travel_events/travel_banter.rpy:175
translate de travelmodebanter_map_elena_markus_2_0f3ab35d:

    # MARKUS @ think "...Too much salt in the air from the sea."
    MARKUS @ think "...Zu viel Salz in der Luft vom Meer."

# game/data/travel_events/travel_banter.rpy:176
translate de travelmodebanter_map_elena_markus_2_f1fa7ebb:

    # MARKUS @ think "That's why all those Newyark folk are so strange."
    MARKUS @ think "Deshalb sind all diese Newyark-Leute so seltsam."

# game/data/travel_events/travel_banter.rpy:186
translate de travelmodebanter_map_elena_markus_3_8008183f:

    # ELENA @ smile "Markus, I'm curious about something..."
    ELENA @ smile "Markus, ich bin neugierig auf etwas..."

# game/data/travel_events/travel_banter.rpy:188
translate de travelmodebanter_map_elena_markus_3_a04187b6:

    # MARKUS @ talk "Ask away."
    MARKUS @ talk "Frag einfach."

# game/data/travel_events/travel_banter.rpy:189
translate de travelmodebanter_map_elena_markus_3_aaf4f0d0:

    # ELENA @ talk "I'm aware of [player_name!t]'s... umm, {i}paramours and dalliances.{/i}"
    ELENA @ talk "Ich bin mir [player_name!t]'s... ähm, {i}Liebhaber und Affären.{/i} bewusst."

# game/data/travel_events/travel_banter.rpy:190
translate de travelmodebanter_map_elena_markus_3_10dd5267:

    # ELENA @ grumpy "But I never see you with anyone."
    ELENA @ grumpy "Aber ich sehe dich nie mit jemandem."

# game/data/travel_events/travel_banter.rpy:191
translate de travelmodebanter_map_elena_markus_3_33702753:

