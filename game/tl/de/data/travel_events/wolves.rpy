# game/data/travel_events/wolves.rpy:3
translate de travel_event_wolves_d9365df9:

    # "While trekking my way through the forests, I heard the distinct sound of...{i}howling?{/i}"
    "Als ich durch die Wälder wanderte, hörte ich einen deutlichen Ton von...{i}Heulen?{/i}"

# game/data/travel_events/wolves.rpy:4
translate de travel_event_wolves_9123a2e4:

    # "From the tree lines, a pack of hungry wolves descended upon me, snarling and circling."
    "Aus den Baumreihen fiel ein Rudel hungriger Wölfe über mich her, knurrend und umkreisend."

# game/data/travel_events/wolves.rpy:7
translate de travel_event_wolves_b05c7a7b:

    # "The wolves whined and howled as they scattered the winds."
    "Die Wölfe winselten und heulten, als sie sich in alle Winde zerstreuten."

# game/data/travel_events/wolves.rpy:8
translate de travel_event_wolves_cda900f2:

    # MC "(Damn beasts!)"
    MC "(Verdammte Biester!)"

# game/data/travel_events/wolves.rpy:16
translate de travel_event_wolves_f567ab41:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Als der letzte Wolf vor quälenden Schmerzen aufjaulte, erlöste ich das arme Ding schnell von seinem Leiden."

# game/data/travel_events/wolves.rpy:17
translate de travel_event_wolves_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Seufz*{/i}"

# game/data/travel_events/wolves.rpy:18
translate de travel_event_wolves_ed59b7aa:

    # MC "(These poor things are half-starved, no wonder they're attacking on sight...)"
    MC "(Diese armen Dinger sind halb verhungert, kein Wunder, dass sie sofort angreifen...)"

# game/data/travel_events/wolves.rpy:22
translate de travel_event_wolves_04301006:

    # MC @ think "I don't suppose {i}you{/i} could handle this?"
    MC @ think "Ich nehme an, {i}du{/i} könntest das nicht erledigen?"

# game/data/travel_events/wolves.rpy:23
translate de travel_event_wolves_c3f644c4:

    # ELENA "I mean, {i}I could try.{/i}"
    ELENA "Ich meine, {i}ich könnte es versuchen.{/i}"

# game/data/travel_events/wolves.rpy:25
translate de travel_event_wolves_b6bd6149:

    # "Elena stepped forward and snarled towards the wolves, who tilted their heads curiously in understanding."
    "Elena trat vor und knurrte die Wölfe an, die neugierig und verständnisvoll die Köpfe neigten."

# game/data/travel_events/wolves.rpy:26
translate de travel_event_wolves_632809bd:

    # "After some brief barking, Elena turns towards you."
    "Nach kurzem Bellen dreht sich Elena zu dir um."

# game/data/travel_events/wolves.rpy:27
translate de travel_event_wolves_6b567ed4:

    # ELENA @ sad "They're starving... They only want some food, and they'll leave us alone."
    ELENA @ sad "Sie verhungern... Sie wollen nur etwas Futter, und dann lassen sie uns in Ruhe."

# game/data/travel_events/wolves.rpy:35
translate de travel_event_wolves_5484d21a:

    # "Tossing the meat towards them, the wolves happily whined and barked as they chowed down."
    "Das Fleisch zu ihnen werfend, winselten und bellten die Wölfe glücklich, während sie es fraßen."

# game/data/travel_events/wolves.rpy:36
translate de travel_event_wolves_a23af468:

    # "Satisfied with their meal, they sped off into the forests, their leader looking back to give one last bark of appreciation."
    "Zufrieden mit ihrer Mahlzeit, stürmten sie in die Wälder davon, wobei ihr Anführer zurückblickte, um ein letztes anerkennendes Bellen von sich zu geben."

# game/data/travel_events/wolves.rpy:38
translate de travel_event_wolves_058c8ebb:

    # ELENA @ smile "Looks like you've made a few new friends..."
    ELENA @ smile "Sieht aus, als hättest du ein paar neue Freunde gefunden..."

# game/data/travel_events/wolves.rpy:41
translate de travel_event_wolves_937daf18:

    # "The wolves sadly whined... but then, once more, they began to snarl and bear their fangs."
    "Die Wölfe winselten traurig... aber dann, erneut, begannen sie zu knurren und ihre Zähne zu fletschen."

# game/data/travel_events/wolves.rpy:42
translate de travel_event_wolves_3b747ef8:

    # ELENA "I don't think they're taking no for an answer!"
    ELENA "Ich glaube nicht, dass sie ein Nein als Antwort akzeptieren!"

# game/data/travel_events/wolves.rpy:48
translate de travel_event_wolves_f567ab41_1:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Als der letzte Wolf vor Schmerz aufheulte, erlöste ich ihn schnell von seinem Leid."

# game/data/travel_events/wolves.rpy:49
translate de travel_event_wolves_a4f1e169_1:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Seufz*{/i}"

# game/data/travel_events/wolves.rpy:50
translate de travel_event_wolves_579541dd:

    # MC "(Well, that could have gone better.)"
    MC "(Nun ja, das hätte besser laufen können.)"

