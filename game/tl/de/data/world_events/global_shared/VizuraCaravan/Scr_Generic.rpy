    VIZURA @ happy "Ahh! Willkommen zurück!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:10
translate de vizura_caravan_revisit_talk_950e49d7:

    # VIZURA @ talk "How's the roads treatin' ya? What can Vizura do for you?"
    VIZURA @ talk "Wie haben dich die Straßen behandelt? Was kann Vizura für dich tun?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:17
translate de vizura_caravan_talk_menu_917cd195:

    # VIZURA @ happy "Ho ho! Take a looksie!"
    VIZURA @ happy "Ho ho! Wirf mal einen Blick!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:27
translate de vizura_caravan_talk_menu_3194ac1b:

    # VIZURA @ happy "Anything else you need?"
    VIZURA @ happy "Brauchst du sonst noch etwas?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:32
translate de vizura_caravan_talk_menu_5afb3c15:

    # VIZURA @ talk "Hmm, tempting."
    VIZURA @ talk "Hmm, verlockend."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:33
translate de vizura_caravan_talk_menu_e6fc278d:

    # VIZURA @ talk "But sadly, I ain't got time to roll around in the hay with you, we gotta be on the move soon."
    VIZURA @ talk "Aber leider habe ich keine Zeit, mich mit dir im Heu zu wälzen, wir müssen bald weiter."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:34
translate de vizura_caravan_talk_menu_b9b03a72:

    # VIZURA @ talk "Let me know if you want anything else though."
    VIZURA @ talk "Lass es mich wissen, falls du sonst noch etwas willst."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:37
translate de vizura_caravan_talk_menu_da7af367:

    # VIZURA @ lewd "Fufu, couldn't stop thinking about this green arse, hm?"
    VIZURA @ lewd "Fufu, konntest nicht aufhören, an diesen grünen Arsch zu denken, hm?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:40
translate de vizura_caravan_talk_menu_9179da90:

    # "Vizura stripped her clothes off in front of me, uncaring at anyone who might see as she smirked."
    "Vizura zog sich vor mir aus, ohne sich darum zu kümmern, ob jemand zusah, und grinste."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:41
translate de vizura_caravan_talk_menu_806a9b32:

    # VIZURA @ lewd "Step into my office, {i}love.{/i}"
    VIZURA @ lewd "Komm in mein Büro, {i}Liebling.{/i}"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:49
translate de vizura_caravan_talk_menu_8fb87d97:

    # VIZURA @ think "You got some kinda funny seed?"
    VIZURA @ think "Ihr habt so 'nen komischen Samen?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:50
translate de vizura_caravan_talk_menu_93cb9ef4:

    # VIZURA @ surp "He's bigger and stronger than any other littlun I've ever seen!"
    VIZURA @ surp "Er ist größer und stärker als jeder andere Kleine, den ich je gesehen hab!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:51
translate de vizura_caravan_talk_menu_b09dd3ff:

    # VIZURA @ lewd "Let's go make another! Just thinking about how strong our children are is doing it for me!"
    VIZURA @ lewd "Los, machen wir noch einen! Allein der Gedanke daran, wie stark unsere Kinder sind, macht mich schon an!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:53
translate de vizura_caravan_talk_menu_36553582:

    # VIZURA @ talk "Fufu, aren't you a sweetheart, worryin' about our spawn?"
    VIZURA @ talk "Fufu, bist du nicht ein Schatz, dass du dich um unsere Brut sorgst?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:54
translate de vizura_caravan_talk_menu_edf7ca9e:

    # VIZURA @ happy "Don't you worry, he's doing just fine."
    VIZURA @ happy "Keine Sorge, ihm geht's bestens."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:55
translate de vizura_caravan_talk_menu_46ac6ffc:

    # VIZURA @ talk "Lookin' at the size of his {i}'sword'{/i} already, he's gonna make some goblin girls very happy when we head home!"
    VIZURA @ talk "Schau dir mal die Größe von seinem {i}'Schwert'{/i} an, der wird ein paar Goblin-Mädchen sehr glücklich machen, wenn wir heimkehren!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:57
translate de vizura_caravan_talk_menu_40ce4b7f:

    # VIZURA @ surp "Ehh?! You really wanna know?"
    VIZURA @ surp "Ehh?! Willst du das wirklich wissen?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:58
translate de vizura_caravan_talk_menu_76f84bda:

    # VIZURA @ lewd "Fufu, I'm gonna come back and expect you to put another in me soon if you keep being sweet like that you know..."
    VIZURA @ lewd "Fufu, wenn du weiter so süß bist, komme ich zurück und erwarte, dass du mir bald wieder einen reinsteckst, weißt du ..."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:59
translate de vizura_caravan_talk_menu_caefbebb:

    # VIZURA @ talk "And the littlun's fine, gonna prove one strong bastard when he's grown up fully!"
    VIZURA @ talk "Und der Kleine ist wohlauf, wird sich als ein starker Bastard erweisen, wenn er erst mal ausgewachsen ist!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:60
translate de vizura_caravan_talk_menu_b178677a:

    # VIZURA @ think "He might even become a chieftain if he keeps growin' at this rate..."
    VIZURA @ think "Vielleicht wird er sogar ein Häuptling, wenn er so weiterwächst ..."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:64
translate de vizura_caravan_talk_menu_cd87ab5b:

    # VIZURA @ talk "Fine, but make them quick, time is money and all that."
    VIZURA @ talk "In Ordnung, aber mach es kurz, Zeit ist Geld und so weiter."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:67
translate de vizura_caravan_talk_menu_questions_b47f48a1:

    # VIZURA @ angry "Tsch! You tryna' say somethin' human?"
    VIZURA @ angry "Tsch! Willste was sagen, Mensch?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:68
translate de vizura_caravan_talk_menu_questions_da37266b:

    # VIZURA @ angry "Ain't nothin' illegal about a goblin travellin!'"
    VIZURA @ angry "Is' doch nix Illegales dran, wenn 'n Goblin reist!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:69
translate de vizura_caravan_talk_menu_questions_969aa5fb:

    # VIZURA @ talk "Well, if you must know, I'm what they call a {i}freehelm{/i} goblin."
    VIZURA @ talk "Nun, wenn du es unbedingt wissen musst, ich bin das, was man einen {i}Freikufen{/i}-Goblin nennt."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:70
translate de vizura_caravan_talk_menu_questions_60a0fb7e:

    # VIZURA @ talk "We get permission and what-not with the various kingdoms to travel across borders and do some business as we go."
    VIZURA @ talk "Wir kriegen Erlaubnis und so von den verschiedenen Königreichen, um über Grenzen zu reisen und unterwegs Geschäfte zu machen."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:71
translate de vizura_caravan_talk_menu_questions_be6c2f06:

    # MC @ talk "And the rulers don't mind that?"
    MC @ talk "Und die Herrscher haben nichts dagegen?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:72
translate de vizura_caravan_talk_menu_questions_e798e29c:

    # VIZURA @ talk "Don't matter if they {i}don't{/i} like it, if you're gonna be allied to Irydian, one of the terms are to allow us freehelm folk passage to do business."
    VIZURA @ talk "Spielt keine Rolle, ob es ihnen {i}nicht{/i} gefällt, wenn ihr euch mit Irydian verbünden wollt, eine der Bedingungen ist, uns Freikufenvolk Durchreise zu erlauben, um Geschäfte zu machen."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:73
translate de vizura_caravan_talk_menu_questions_98785572:

    # VIZURA @ talk "We don't intervere with human politics and what-not, so most just begrudingly accept us for the sake of wider trade."
    VIZURA @ talk "Wir mischen uns nicht in die menschliche Politik und so was ein, also werden wir von den meisten widerwillig akzeptiert, zugunsten des umfassenderen Handels."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:77
translate de vizura_caravan_talk_menu_questions_8c818204:

    # VIZURA @ surp "AND PAY TAXES? ARE YOU FUCKING CRAZY HUMAN?"
    VIZURA @ surp "UND STEUERN ZAHLEN? BIST DU VERDAMMT VERRÜCKT, MENSCH?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:78
translate de vizura_caravan_talk_menu_questions_81579575:

    # VIZURA @ angry "Bloody thiefing bastards!"
    VIZURA @ angry "Verdammte diebische Bastarde!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:79
translate de vizura_caravan_talk_menu_questions_b34488ef:

    # VIZURA @ talk "{i}Oooh! We use your taxes to improve the roads and things though!{/i}"
    VIZURA @ talk "{i}Oooh! Aber wir verwenden Ihre Steuern, um die Straßen und so zu verbessern!{/i}"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:80
translate de vizura_caravan_talk_menu_questions_4d98591a:

    # VIZURA @ angry "You seen the roads recently? My ass is fucking sore from bouncing on all the uneven bumps!"
    VIZURA @ angry "Hast du in letzter Zeit die Straßen gesehen? Mein Arsch ist verdammt wund vom Hüpfen auf all den unebenen Schlaglöchern!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:84
translate de vizura_caravan_talk_menu_questions_36bd8a82:

    # VIZURA @ talk "I dunno, like, a dozen of us maybe?"
    VIZURA @ talk "Keine Ahnung, vielleicht so ein Dutzend von uns?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:85
translate de vizura_caravan_talk_menu_questions_9cb7ffb4:

    # MC @ talk "Why so many?"
    MC @ talk "Warum so viele?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:86
translate de vizura_caravan_talk_menu_questions_c7e022a9:

    # VIZURA @ talk "Goblins are strong in numbers, gotta keep the caravan safe in case of thieves and what-not."
    VIZURA @ talk "Goblins sind in der Überzahl stark, müssen die Karawane sicher halten, falls es Diebe oder so gibt."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:90
translate de vizura_caravan_talk_menu_questions_69c8d000:

    # VIZURA @ talk "Great, any other business?"
    VIZURA @ talk "Großartig, gibt es sonst noch etwas zu besprechen?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:94
translate de vizura_caravan_talk_menu_questions_889d49a4:

    # VIZURA @ happy "Very well, until next time, handsome."
    VIZURA @ happy "Sehr gut, bis zum nächsten Mal, Hübscher."

