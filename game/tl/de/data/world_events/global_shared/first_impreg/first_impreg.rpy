    MC "(Scheiße! SCHEIßE!)"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:18
translate de ev_first_impreg_8db674d9:

    # MC "(What do I do now?)"
    MC "(Was mache ich jetzt?)"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:19
translate de ev_first_impreg_35bcf768:

    # BLACK "{i}(Relax){/i}"
    BLACK "{i}(Entspann dich){/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:20
translate de ev_first_impreg_44ebc6d0:

    # MC "(My child... Will it have the same affliction as I do?)"
    MC "(Mein Kind... Wird es dasselbe Leiden haben wie ich?)"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:21
translate de ev_first_impreg_3be7ae15:

    # MC "(Will it have it's own {i}dark passenger?{/i})"
    MC "(Wird es seinen eigenen {i}dunklen Passagier{/i} haben?)"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:22
translate de ev_first_impreg_55c22c73:

    # BLACK "{i}(No).{/i}"
    BLACK "{i}(Nein).{/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:23
translate de ev_first_impreg_9f83c5b8:

    # BLACK "{i}(Our sired seed will have enhanced strength, speed, and other enhanced traits due to the genetic mutations).{/i}"
    BLACK "{i}(Unser gezeugter Nachwuchs wird aufgrund der genetischen Mutationen verbesserte Stärke, Geschwindigkeit und andere verbesserte Merkmale haben).{/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:24
translate de ev_first_impreg_20057462:

    # BLACK "{i}(But they will not be parasites).{/i}"
    BLACK "{i}(Aber sie werden keine Parasiten sein).{/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:25
translate de ev_first_impreg_e80b32bf:

    # MC "(I don't understand, why not?)"
    MC "(Ich verstehe nicht, warum nicht?)"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:26
translate de ev_first_impreg_57fb72bd:

    # BLACK "{i}(The genetic change is too drastic, trying to convert a species into one of us without any prior genetic code mutation can result in massive organ failure).{/i}"
    BLACK "{i}(Die genetische Veränderung ist zu drastisch, der Versuch, eine Spezies ohne vorherige Mutation des genetischen Codes in eine von uns zu verwandeln, kann zu massivem Organversagen führen).{/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:27
translate de ev_first_impreg_102544c9:

    # BLACK "{i}(Therefore, our species prefers to breed during the first wave, then, the sired offspring will be mated with to produce Parasites).{/i}"
    BLACK "{i}(Daher bevorzugt unsere Spezies es, sich während der ersten Welle zu paaren, dann werden die gezeugten Nachkommen verpaart, um Parasiten zu erzeugen).{/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:28
translate de ev_first_impreg_0b35c596:

    # BLACK "{i}(It is far safer to produce our kind with the sired offsprings genetic code as a foundation).{/i}"
    BLACK "{i}(Es ist weit sicherer, unsere Art mit dem genetischen Code der gezeugten Nachkommen als Grundlage zu erzeugen).{/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:29
translate de ev_first_impreg_ed861807:

    # MC "(So... They will be okay?)"
    MC "(Also... Werden sie in Ordnung sein?)"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:30
translate de ev_first_impreg_fb23857a:

    # BLACK "{i}(Yes){/i}"
    BLACK "{i}(Ja){/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:31
translate de ev_first_impreg_fb2ccbba:

    # BLACK "{i}(Our species are designed to breed, I expect you will be driven to sire more young){/i}."
    BLACK "{i}(Unsere Spezies ist zum Fortpflanzen bestimmt, ich erwarte, dass du getrieben wirst, mehr Nachkommen zu zeugen){/i}."

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:32
translate de ev_first_impreg_fefa14c9:

    # MC "(I'm not so sure about that, but... At least I know the children won't be cursed as I am.)"
    MC "(Ich bin mir da nicht so sicher, aber... Wenigstens weiß ich, dass die Kinder nicht so verflucht sein werden wie ich.)"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:33
translate de ev_first_impreg_b13e11c4:

    # BLACK "{i}(Curses... Blessings... These concepts hold little meaning to me, we are as our nature intended, nothing more).{/i}"
    BLACK "{i}(Flüche... Segen... Diese Konzepte bedeuten mir wenig, wir sind, wie unsere Natur es vorgesehen hat, nichts weiter).{/i}"

# game/data/world_events/global_shared/first_impreg/first_impreg.rpy:34
translate de ev_first_impreg_9e741bff:

    # MC "(Yeah... I thought you might say something like that.)"
    MC "(Ja... Ich dachte mir, dass du so etwas sagen würdest.)"

