# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:35
translate de ev_KrishanaDay_ca2695ed:

    # "Suddenly, [regina_ref!t] came bursting through the door."
    "Plötzlich stürmte [regina_ref!t] durch die Tür."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:37
translate de ev_KrishanaDay_c6cc7f86:

    # REGINA @ smile "Happy Krishana day!"
    REGINA @ smile "Frohen Krishana-Tag!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:38
translate de ev_KrishanaDay_ac3da786:

