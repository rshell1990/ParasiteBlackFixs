# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:39
translate de ev_KrishanaDay_fe4e77b1:

    # REGINA @ shock "I know you've been busy lately with your quests, but did you seriously forget what day it is?"
    REGINA @ shock "Ich weiß, du warst in letzter Zeit mit deinen Quests beschäftigt, aber hast du ernsthaft vergessen, welcher Tag heute ist?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:40
translate de ev_KrishanaDay_4d92be9a:

    # REGINA @ smile "It used to be your favorite day when you were younger you know!"
