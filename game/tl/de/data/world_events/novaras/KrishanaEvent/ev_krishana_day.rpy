    ADARA @ smile "I-Ich wollte dir nur einen fröhlichen Krishana-Tag wünschen, schätze ich..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:150
translate de ev_KrishanaDay_regina_dialogue_menu_d64c644f:

    # "Adara paused sheepishly, her hands clasping at her dress tightly."
    "Adara hielt verschämt inne, ihre Hände umklammerten fest ihr Kleid."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:151
translate de ev_KrishanaDay_regina_dialogue_menu_7a497736:

    # ADARA @ shame "I was wondering if perhaps maybe we c-could..."
    ADARA @ shame "Ich habe mich gefragt, ob wir vielleicht vielleicht k-könnten..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:152
translate de ev_KrishanaDay_regina_dialogue_menu_54779c02:

    # ADARA @ joy "G-Go for a walk?"
    ADARA @ joy "E-Einen Spaziergang machen?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:154
translate de ev_KrishanaDay_regina_dialogue_menu_7c3775eb:

    # MC @ lewd "Where shall we head to?"
    MC @ lewd "Wohin sollen wir gehen?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:155
translate de ev_KrishanaDay_regina_dialogue_menu_0abbaba0:

    # ADARA @ smile "There's quite a lot going on at the Market I'm told, perhaps we should head there?"
    ADARA @ smile "Wie ich gehört habe, ist auf dem Markt ziemlich viel los, vielleicht sollten wir dorthin gehen?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:156
translate de ev_KrishanaDay_regina_dialogue_menu_ce53fb2e:

    # MC @ smile2 "Alright, that sounds good to me."
    MC @ smile2 "In Ordnung, das hört sich gut an."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:159
translate de ev_KrishanaDay_regina_dialogue_menu_a3ef7502:

    # "The two of us made our way through the winding Novaras streets, the gentle snow falling onto the ground as children hurried through excitedly to meet their friends."
    "Wir beide machten uns auf den Weg durch die verwinkelten Straßen von Novaras, der sanfte Schnee fiel auf den Boden, während Kinder aufgeregt zu ihren Freunden eilten."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:165
translate de ev_KrishanaDay_regina_dialogue_menu_042dbacd:

    # "At the Market, it was like a kind of festive carnival."
    "Auf dem Markt war es wie eine Art festlicher Karneval."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:166
translate de ev_KrishanaDay_regina_dialogue_menu_e76869d8:

    # "Merchants, roasted meat over open fires that filled the air with a sweet aroma, with small crowds gathering around eager for a taste."
    "Händler, über offenem Feuer gegrilltes Fleisch, das die Luft mit einem süßen Duft erfüllte, und kleine Menschenmengen, die sich begierig versammelten, um zu kosten."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:167
translate de ev_KrishanaDay_regina_dialogue_menu_c36b411f:

    # "Children hurried around, throwing snowballs at their friends, parents watched and chatted amongst themselves from afar."
    "Kinder liefen geschäftig umher, warfen Schneebälle auf ihre Freunde, während die Eltern aus der Ferne zusahen und sich unterhielten."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:168
translate de ev_KrishanaDay_regina_dialogue_menu_be8b2752:

    # "One merchant with huge mead barrels opened, poured patrons small cups who huddled together and laughed to themselves merrily."
    "Ein Händler mit riesigen Metfässern öffnete, schenkte den Gästen kleine Becher ein, die sich zusammenkauerten und fröhlich vor sich hin lachten."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:169
translate de ev_KrishanaDay_regina_dialogue_menu_3d1b9cdc:

    # "For a brief moment in time, it was as though everyone forgot about the wars existence outside these city walls..."
    "Für einen kurzen Augenblick war es, als hätte jeder die Existenz des Krieges außerhalb dieser Stadtmauern vergessen..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:170
translate de ev_KrishanaDay_regina_dialogue_menu_da28cac1:

    # ADARA @ smile "Isn't it nice to see everyone out and so cheery?"
    ADARA @ smile "Ist es nicht schön, alle draußen und so fröhlich zu sehen?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:171
translate de ev_KrishanaDay_regina_dialogue_menu_684e7350:

    # MC @ think "The last time it was like this was when-"
    MC @ think "Das letzte Mal, dass es so war, war, als-"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:172
translate de ev_KrishanaDay_regina_dialogue_menu_db480df9:

    # "I pushed the thought of the Terminus ceremony to the back of my mind."
    "Ich verdrängte den Gedanken an die Terminus-Zeremonie in den Hinterkopf."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:173
translate de ev_KrishanaDay_regina_dialogue_menu_1833ec0b:

    # "This was a happy time."
    "Das war eine glückliche Zeit."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:174
translate de ev_KrishanaDay_regina_dialogue_menu_681613ed:

    # ADARA @ smile "Look at this place! Isn't it wonderful?"
    ADARA @ smile "Schau dir diesen Ort an! Ist er nicht wunderbar?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:175
translate de ev_KrishanaDay_regina_dialogue_menu_8c941941:

    # "I smiled as the children chasing each other with snowballs hurried out in front of us."
    "Ich lächelte, als die Kinder, die sich mit Schneebällen jagten, vor uns her eilten."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:176
translate de ev_KrishanaDay_regina_dialogue_menu_99be07bb:

    # MC @ smile2 "Yes, it's nice."
    MC @ smile2 "Ja, es ist schön."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:177
translate de ev_KrishanaDay_regina_dialogue_menu_149e2884:

    # ADARA @ joy "What should we do now?"
    ADARA @ joy "Was sollen wir jetzt tun?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:181
translate de ev_KrishanaDay_regina_dialogue_menu_664cc199:

    # "The time went by quickly as we had fun, it was always easy letting time drift by with Adara."
    "Die Zeit verging schnell, da wir Spaß hatten, es war immer einfach, die Zeit mit Adara verstreichen zu lassen."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:183
translate de ev_KrishanaDay_regina_dialogue_menu_c8fe2941:

    # MAD_PROPHET "GATHER! GATHER ALL!"
    MAD_PROPHET "VERSAMMELT EUCH! VERSAMMELT EUCH ALLE!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:189
translate de ev_KrishanaDay_regina_dialogue_menu_397e2913:

    # ADARA @ shock "Isn't he cold wearing so little in this weather?"
    ADARA @ shock "Ist ihm nicht kalt, wenn er bei diesem Wetter so wenig trägt?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:190
translate de ev_KrishanaDay_regina_dialogue_menu_58374c5f:

    # MAD_PROPHET "Come and hear the tale of Krishana the ice dragon!"
    MAD_PROPHET "Kommt und hört die Geschichte von Krishana, dem Eisdrachen!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:191
translate de ev_KrishanaDay_regina_dialogue_menu_5506bc64:

    # ADARA @ smile "What do you think? Wanna listen?"
    ADARA @ smile "Was denkst du? Willst du zuhören?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:198
translate de ev_KrishanaDay_regina_dialogue_menu_53aaa9a4:

    # "The two of us stepped closer and joined the growing crowd, mainly comprised of children but a few adults lingered."
    "Wir beide traten näher und schlossen uns der wachsenden Menge an, die hauptsächlich aus Kindern bestand, aber ein paar Erwachsene verweilten noch."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:199
translate de ev_KrishanaDay_regina_dialogue_menu_8b9e7ec0:

    # MAD_PROPHET "And so we begin, centuries long past, Krishana, the great ice dragon, sat on her ice throne in the mountains of Angmurus!"
    MAD_PROPHET "Und so beginnen wir, vor Jahrhunderten, Krishana, der große Eisdrache, saß auf ihrem Eisthron in den Bergen von Angmurus!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:200
translate de ev_KrishanaDay_regina_dialogue_menu_7a95d963:

    # MAD_PROPHET "{i}Bored!{/i}"
    MAD_PROPHET "{i}Gelangweilt!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:201
translate de ev_KrishanaDay_regina_dialogue_menu_e98b016a:

    # "The crowd laughed a little."
    "Die Menge lachte ein wenig."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:202
translate de ev_KrishanaDay_regina_dialogue_menu_b6989b01:

    # MAD_PROPHET "{i}'I know!'{/i} Thought the mighty dragon, {i}'I shall see what the humans down south are up to!'{/i}"
    MAD_PROPHET "{i}‚Ich weiß!‘{/i} Dachte der mächtige Drache, {i}‚Ich werde sehen, was die Menschen im Süden so treiben!‘{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:203
translate de ev_KrishanaDay_regina_dialogue_menu_e6c8eed8:

    # MAD_PROPHET "As her mighty wings soared, she headed down south, perching herself up on a small mountain, watching the villagers down below!"
    MAD_PROPHET "Als ihre mächtigen Schwingen sich erhoben, flog sie nach Süden, ließ sich auf einem kleinen Berg nieder und beobachtete die Dorfbewohner unten!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:204
translate de ev_KrishanaDay_regina_dialogue_menu_5452de45:

    # MAD_PROPHET "The people revered but feared the mighty dragons! And each parent warned the children not to approach the great Krishana!"
    MAD_PROPHET "Die Menschen verehrten, aber fürchteten die mächtigen Drachen! Und alle Eltern warnten ihre Kinder davor, sich der großen Krishana zu nähern!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:205
translate de ev_KrishanaDay_regina_dialogue_menu_bf4a2f15:

    # MAD_PROPHET "Some young children, brave and adventurous, ignoring their parents advice, scaled the small mountain and approached the dragoness!"
    MAD_PROPHET "Einige mutige und abenteuerlustige junge Kinder, die den Rat ihrer Eltern ignorierten, erklommen den kleinen Berg und näherten sich der Drachin!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:206
translate de ev_KrishanaDay_regina_dialogue_menu_7e9a0589:

    # MAD_PROPHET "{i}'But what brings you small humans here?'{/i} The dragoness asked!"
    MAD_PROPHET "{i}'Aber was führt euch kleine Menschen hierher?'{/i} fragte die Drachin!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:207
translate de ev_KrishanaDay_regina_dialogue_menu_aa79a142:

    # MAD_PROPHET "{i}'Oh great Krishana! It has not snowed in these lands for so long! Can you not make it so?{/i}"
    MAD_PROPHET "{i}'Oh große Krishana! Es hat in diesen Landen schon so lange nicht geschneit! Kannst du es denn nicht so machen?{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:208
translate de ev_KrishanaDay_regina_dialogue_menu_5fa83f8d:

    # MAD_PROPHET "The dragon laughed, and laughed and laughed!"
    MAD_PROPHET "Die Drachin lachte und lachte und lachte!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:209
translate de ev_KrishanaDay_regina_dialogue_menu_7ecbd013:

    # MAD_PROPHET "{i}But what in return shall thy give thee?{/i} The dragoness asked."
    MAD_PROPHET "{i}Aber was sollt ihr mir dafür geben?{/i} fragte die Drachin."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:210
translate de ev_KrishanaDay_regina_dialogue_menu_1a3da702:

    # MAD_PROPHET "{i}For my hordes of gold are vast, and I never suffer hunger long!{/i}"
    MAD_PROPHET "{i}Denn meine Horte an Gold sind gewaltig, und ich leide nie lange an Hunger!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:211
translate de ev_KrishanaDay_regina_dialogue_menu_ef09375e:

    # MAD_PROPHET "{i}What could you possibly have to offer me?{/i}"
    MAD_PROPHET "{i}Was könntet ihr mir möglicherweise bieten?{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:212
translate de ev_KrishanaDay_regina_dialogue_menu_8f1a64cc:

    # MAD_PROPHET "The children looked amongst themselves for a moment, till one stepped forward and offered the great Krishana a small stone."
    MAD_PROPHET "Die Kinder schauten sich einen Moment lang an, bis eines vorwärts trat und der großen Krishana einen kleinen Stein anbot."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:213
translate de ev_KrishanaDay_regina_dialogue_menu_70d2ab96:

    # MAD_PROPHET "{i}But what is this?{/i} The dragoness asked."
    MAD_PROPHET "{i}Aber was ist das?{/i} fragte die Drachin."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:214
translate de ev_KrishanaDay_regina_dialogue_menu_d33e7b2d:

    # MAD_PROPHET "{i}It is a waystone!{/i} the child answered!"
    MAD_PROPHET "{i}Es ist ein Wegstein!{/i} antwortete das Kind!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:215
translate de ev_KrishanaDay_regina_dialogue_menu_60db9f86:

    # MAD_PROPHET "{i}So no matter where you fly, you will always be able to find your way home here!{/i}"
    MAD_PROPHET "{i}Also, egal wohin du fliegst, du wirst immer den Weg hierher nach Hause finden können!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:216
translate de ev_KrishanaDay_regina_dialogue_menu_9e7dd2b0:

    # MAD_PROPHET "Krishana took the small gift, and boomed, {i}'HOME? HERE? FOR ME?'{/i}"
    MAD_PROPHET "Krishana nahm das kleine Geschenk und donnerte: {i}'ZUHAUSE? HIER? FÜR MICH?'{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:217
translate de ev_KrishanaDay_regina_dialogue_menu_0229275b:

    # MAD_PROPHET "The dragoness, so touched by the gift, said with a cool blow of air, {i}I've never had a home before.{/i}"
    MAD_PROPHET "Die Drachin, so gerührt von dem Geschenk, sagte mit einem kühlen Lufthauch: {i}Ich hatte noch nie zuvor ein Zuhause.{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:218
translate de ev_KrishanaDay_regina_dialogue_menu_2bb02a72:

    # MAD_PROPHET "Before the children could answer, the mighty Kirshana unleashed her icy breath into the sky, and the children celebrated as the snow fell down!"
    MAD_PROPHET "Bevor die Kinder antworten konnten, entfesselte die mächtige Kirshana ihren eisigen Atem in den Himmel, und die Kinder feierten, als der Schnee herabfiel!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:219
translate de ev_KrishanaDay_regina_dialogue_menu_dda3abaf:

    # MAD_PROPHET "And so it was, Krishana returned every year to bring forth the snow in exchange for the children's gifts!"
    MAD_PROPHET "Und so kehrte Krishana jedes Jahr zurück, um den Schnee zu bringen, im Austausch für die Geschenke der Kinder!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:220
translate de ev_KrishanaDay_regina_dialogue_menu_9885251b:

    # MAD_PROPHET "And thus, that is why yearly we share gifts amongst loved ones and friends! To celebrate this most joyous of times!"
    MAD_PROPHET "Und deshalb teilen wir alljährlich Geschenke unter unseren Lieben und Freunden! Um diese freudigste aller Zeiten zu feiern!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:221
translate de ev_KrishanaDay_regina_dialogue_menu_c64f40ac:

    # "The crowd clapped and handed over some coins towards the man, who collected them in a small jar."
    "Die Menge klatschte und reichte dem Mann einige Münzen, der sie in einem kleinen Glas sammelte."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:226
translate de ev_KrishanaDay_regina_dialogue_menu_29f9f809:

    # ADARA @ smile "Krishana was always one of my favorite stories growing up."
    ADARA @ smile "Krishana war schon immer eine meiner Lieblingsgeschichten, als ich aufwuchs."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:227
translate de ev_KrishanaDay_regina_dialogue_menu_51eae6f2:

    # ADARA @ smile "Isn't it nice to just hear a story not always about death and violence once in a while?"
    ADARA @ smile "Ist es nicht schön, einfach mal eine Geschichte zu hören, die nicht ständig von Tod und Gewalt handelt?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:229
translate de ev_KrishanaDay_regina_dialogue_menu_ed83f52f:

    # ADARA @ talk "Ah, okay then..."
    ADARA @ talk "Ah, okay dann..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:230
translate de ev_KrishanaDay_regina_dialogue_menu_5ccedec9:

    # ADARA @ talk "It's getting quite late."
    ADARA @ talk "Es wird ziemlich spät."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:231
translate de ev_KrishanaDay_regina_dialogue_menu_46b5b0ad:

    # ADARA @ shame "Do you mind walking me home?"
    ADARA @ shame "Würde es dir etwas ausmachen, mich nach Hause zu begleiten?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:232
translate de ev_KrishanaDay_regina_dialogue_menu_0ca268ac:

    # MC @ lewd "Do you even need to ask that?"
    MC @ lewd "Musst du das überhaupt fragen?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:233
translate de ev_KrishanaDay_regina_dialogue_menu_1454db55:

    # "Adara smiled."
    "Adara lächelte."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:235
translate de ev_KrishanaDay_regina_dialogue_menu_e2b4bf66:

    # ADARA @ talk "C-Come on then, it's cold just standing here talking!"
    ADARA @ talk "K-Komm schon, es ist kalt, nur hier zu stehen und zu reden!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:243
translate de ev_KrishanaDay_regina_dialogue_menu_6f95fffc:

    # "{i}After a short walk back to Adara's home...{/i}"
    "{i}Nach einem kurzen Spaziergang zurück zu Adaras Zuhause...{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:248
translate de ev_KrishanaDay_regina_dialogue_menu_2af513bf:

    # ADARA @ talk "Thank you for walking me home, [player_name!t]."
    ADARA @ talk "Danke, dass du mich nach Hause begleitet hast, [player_name!t]."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:249
translate de ev_KrishanaDay_regina_dialogue_menu_cf81e8c8:

    # MC @ smile "Anytime, Adara."
    MC @ smile "Jederzeit, Adara."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:250
translate de ev_KrishanaDay_regina_dialogue_menu_12bba5cb:

    # MC @ lewd "And uhh, I hope you had a nice time today."
    MC @ lewd "Und ähm, ich hoffe, du hattest heute einen schönen Tag."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:251
translate de ev_KrishanaDay_regina_dialogue_menu_9feb8b98:

    # ADARA @ joy "M-Mmm, I did..."
    ADARA @ joy "M-Mmm, das hatte ich ..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:252
translate de ev_KrishanaDay_regina_dialogue_menu_c660c009:

    # "The two of us paused awkwardly for a moment, not knowing what to say to each other other."
    "Wir beide hielten einen Moment unbeholfen inne, ohne zu wissen, was wir uns sagen sollten."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:253
translate de ev_KrishanaDay_regina_dialogue_menu_2a09e3c5:

    # MC @ think "Is... Your father not home?"
    MC @ think "Ist... Dein Vater nicht zu Hause?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:254
translate de ev_KrishanaDay_regina_dialogue_menu_b951f8e6:

    # ADARA @ talk "He's probably resting right now ... He gets tired quite easily these days."
    ADARA @ talk "Er ruht sich jetzt wahrscheinlich aus ... Er wird in letzter Zeit ziemlich schnell müde."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:255
translate de ev_KrishanaDay_regina_dialogue_menu_755359e9:

    # MC @ talk "Ah, of course."
    MC @ talk "Ach, natürlich."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:256
translate de ev_KrishanaDay_regina_dialogue_menu_956ad2ae:

    # ADARA @ shame "..."
    ADARA @ shame "..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:258
translate de ev_KrishanaDay_regina_dialogue_menu_5a3c4ad1:

    # MC @ surprised "...I should, um, probably get going."
    MC @ surprised "...Ich sollte, ähm, wahrscheinlich langsam gehen."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:259
translate de ev_KrishanaDay_regina_dialogue_menu_11f2acbe:

    # MC @ smile2 "Markus is going to wonder where I am."
    MC @ smile2 "Markus wird sich fragen, wo ich bin."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:260
translate de ev_KrishanaDay_regina_dialogue_menu_6440fcc8:

    # ADARA @ shame "R-Right, of course."
    ADARA @ shame "R-Richtig, natürlich."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:262
translate de ev_KrishanaDay_regina_dialogue_menu_3685d847:

    # "As I turned to leave, suddenly-"
    "Als ich mich zum Gehen umdrehte, plötzlich-"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:263
translate de ev_KrishanaDay_regina_dialogue_menu_86744dd1:

    # ADARA @ shock "[player_name!t]! Wait!"
