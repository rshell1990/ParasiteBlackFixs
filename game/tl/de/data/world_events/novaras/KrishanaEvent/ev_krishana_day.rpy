# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:41
translate de ev_KrishanaDay_5c394690:

    # MC @ smile "A-Ah ... It's come around so fast this year."
    MC @ smile "A-Ah ... Dieses Jahr ist er so schnell gekommen."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:42
translate de ev_KrishanaDay_17578760:

    # MC @ think "Guess I really have just been losing track of time these last few days."
    MC @ think "Ich habe wohl wirklich in den letzten Tagen das Zeitgefühl verloren."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:43
translate de ev_KrishanaDay_008dc34c:

