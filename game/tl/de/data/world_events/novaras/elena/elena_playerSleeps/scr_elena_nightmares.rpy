    ELENA "...{i}Nein... Nein...!{/i}"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:8
translate de event_Elena_nightmares_9b248385:

    # "During the dead of night, I awoke to sounds of whines and other strange sounds."
    "In tiefer Nacht erwachte ich von Winseln und anderen seltsamen Lauten."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:9
translate de event_Elena_nightmares_576834c9:

    # "Looking up from my bed still half-asleep, I saw Elena, writhing around on the floor, feverish with a sweat."
    "Noch halb im Schlaf blickte ich von meinem Bett auf und sah Elena, wie sie sich fiebrig und schweißnass auf dem Boden wand."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:14
translate de event_Elena_nightmares_25b88e12:

    # ELENA "Stop... Please my lord!"
    ELENA "Hör auf... Bitte, mein Herr!"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:15
translate de event_Elena_nightmares_c3ae80f2:

    # "Elena dripped with sweat, her sleeptalk giving the unmistakable impression of some horrible nightmare plaguing her this evening."
    "Elena triefte vor Schweiß, und ihr Schlafreden vermittelte unverkennbar den Eindruck eines schrecklichen Albtraums, der sie in dieser Nacht plagte."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:16
translate de event_Elena_nightmares_fab8cade:

    # MC @ talk "Elena! Wake up!"
    MC @ talk "Elena! Wach auf!"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:17
translate de event_Elena_nightmares_1159c1f1:

    # "I reached down and lightly shook Elena."
    "Ich beugte mich hinunter und rüttelte Elena leicht."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:18
translate de event_Elena_nightmares_940877ae:

    # ELENA "No! Not again! Please!"
    ELENA "Nein! Nicht schon wieder! Bitte!"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:19
translate de event_Elena_nightmares_25f13b42:

    # ELENA "I'll be good!"
    ELENA "Ich werde brav sein!"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:20
translate de event_Elena_nightmares_a1215f79:

    # MC @ talk "Elena!"
    MC @ talk "Elena!"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:21
translate de event_Elena_nightmares_a9178f70:

    # "Elena's eyes began to half open as she looked dazed and confused at me."
    "Elenas Augen öffneten sich halb, während sie mich benommen und verwirrt ansah."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:27
translate de event_Elena_nightmares_b6d61644:

    # ELENA @ shock "H-Huh?"
    ELENA @ shock "H-Hä?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:28
translate de event_Elena_nightmares_95337e49:

    # ELENA @ sad "Where am I?"
    ELENA @ sad "Wo bin ich?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:29
translate de event_Elena_nightmares_5aa60ad9:

    # MC @ sad "It's alright Elena... You were having a nightmare."
    MC @ sad "Es ist alles in Ordnung, Elena... Du hattest einen Albtraum."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:30
translate de event_Elena_nightmares_70bf9362:

    # MC @ talk "You're safe now."
    MC @ talk "Du bist jetzt sicher."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:31
translate de event_Elena_nightmares_3ff63ec7:

    # ELENA @ shock "I..."
    ELENA @ shock "Ich..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:32
translate de event_Elena_nightmares_b67df899:

    # ELENA @ sad "I'm sorry for waking you."
    ELENA @ sad "Es tut mir leid, dass ich dich geweckt habe."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:33
translate de event_Elena_nightmares_b226d146:

    # MC @ talk "What was your nightmare about?"
    MC @ talk "Worum ging es in deinem Albtraum?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:34
translate de event_Elena_nightmares_d5a6231d:

    # ELENA @ sad "It... It was nothing."
    ELENA @ sad "Es... Es war nichts."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:35
translate de event_Elena_nightmares_9d46b364:

    # MC @ talk "You were pleading with Lord Vront not to do something."
    MC @ talk "Du hast Lord Vront angefleht, etwas nicht zu tun."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:36
translate de event_Elena_nightmares_a45689b3:

    # "Elena's eyes widened."
    "Elenas Augen weiteten sich."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:37
translate de event_Elena_nightmares_7f61c46d:

    # ELENA @ shock "You heard that?"
    ELENA @ shock "Du hast das gehört?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:38
translate de event_Elena_nightmares_16f5c04e:

    # ELENA @ cry "You weren't supposed to hear that!"
    ELENA @ cry "Das solltest du nicht hören!"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:39
translate de event_Elena_nightmares_58db6ac2:

    # MC @ sad "Elena... What happened?"
    MC @ sad "Elena... Was ist passiert?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:40
translate de event_Elena_nightmares_a23fd01e:

    # MC @ talk "Did Vront do something to you?"
    MC @ talk "Hat Vront dir etwas angetan?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:41
translate de event_Elena_nightmares_3dd7af0a:

    # ELENA @ sad "...Only when I misbehaved."
    ELENA @ sad "...Nur wenn ich mich daneben benommen habe."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:42
translate de event_Elena_nightmares_fece7692:

    # MC @ talk "Elena, what did he do?"
    MC @ talk "Elena, was hat er getan?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:43
translate de event_Elena_nightmares_4c67c501:

    # ELENA @ sad "He didn't hurt me... He knew he didn't need to."
    ELENA @ sad "Er hat mir nicht wehgetan... Er wusste, dass er das nicht musste."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:44
translate de event_Elena_nightmares_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "Was meinst du?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:45
translate de event_Elena_nightmares_219a7915:

    # ELENA @ sad "When I misbehaved too much, he would have the staff take me down to the old Thornfall mines."
    ELENA @ sad "Wenn ich mich zu sehr daneben benahm, ließ er mich vom Personal in die alten Thornfall-Minen hinunterbringen."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:46
translate de event_Elena_nightmares_ad25dd50:

    # ELENA @ sad "He would have me put into a steel cage and lowered into the mines, long abandoned by this point but..."
    ELENA @ sad "Er hätte mich in einen Stahlkäfig stecken und in die Minen hinablassen lassen, längst verlassen zu diesem Zeitpunkt, aber..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:47
translate de event_Elena_nightmares_a3d31628:

    # ELENA @ sad "{i}Things... Moved down there.{/i}"
    ELENA @ sad "{i}Dinge... Bewegten sich dort unten.{/i}"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:48
translate de event_Elena_nightmares_7950d08f:

    # ELENA @ cry "I would spend the whole night in terror, frozen."
    ELENA @ cry "Ich würde die ganze Nacht in Schrecken verbringen, erstarrt."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:49
translate de event_Elena_nightmares_eb32411e:

    # ELENA @ cry "When I told I saw {i}things{/i} down there, horrible things..."
    ELENA @ cry "Als ich erzählte, dass ich {i}Dinge{/i} dort unten gesehen hätte, schreckliche Dinge..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:50
translate de event_Elena_nightmares_c2ced3cf:

    # ELENA @ sad "He always warned me one day, if I kept misbehaving, he would send me down there {i}without{/i} the cage."
    ELENA @ sad "Er warnte mich immer, dass er mich eines Tages, wenn ich mich weiter schlecht benehmen würde, {i}ohne{/i} den Käfig dorthin schicken würde."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:53
translate de event_Elena_nightmares_86c99dd5:

    # ELENA @ sad "Maybe..."
    ELENA @ sad "Vielleicht..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:54
translate de event_Elena_nightmares_e7853050:

    # ELENA @ cry "But he was still the closest thing I had to a father."
    ELENA @ cry "Aber er war immer noch das Nächste zu einem Vater, was ich hatte."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:55
translate de event_Elena_nightmares_39d76480:

    # ELENA @ sad "So, what is to be done?"
    ELENA @ sad "Also, was ist zu tun?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:57
translate de event_Elena_nightmares_84b440c8:

    # ELENA @ sad "Maybe... But I think in some dark, twisted way."
    ELENA @ sad "Vielleicht... Aber ich denke auf eine dunkle, verdrehte Weise."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:58
translate de event_Elena_nightmares_8aba1e91:

    # ELENA @ sad "He {i}wanted{/i} me to misbehave."
    ELENA @ sad "Er {i}wollte{/i}, dass ich mich schlecht benehme."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:59
translate de event_Elena_nightmares_a84141f4:

    # MC @ talk "Why do you say that?"
    MC @ talk "Warum sagst du das?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:60
translate de event_Elena_nightmares_b908d857:

    # ELENA @ sad "I don't know... I think beneath the veneer of his wealth and his kindness and all of him..."
    ELENA @ sad "Ich weiß nicht... Ich glaube, unter der Fassade seines Reichtums und seiner Freundlichkeit und allem an ihm..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:61
translate de event_Elena_nightmares_1760313a:

    # ELENA @ shock "Something dark lurked."
    ELENA @ shock "Etwas Dunkles lauerte."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:62
translate de event_Elena_nightmares_14f9b5ea:

    # ELENA @ sad "And only sometimes, I was unfortunate enough to catch a glimpse of it."
    ELENA @ sad "Und nur manchmal hatte ich das Pech, einen flüchtigen Blick darauf zu erhaschen."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:64
translate de event_Elena_nightmares_0aae521e:

    # MC @ sad "Elena, if he did that to you, why are you determined to find the Lady Grace?"
    MC @ sad "Elena, wenn er dir das angetan hat, warum bist du dann entschlossen, Lady Grace zu finden?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:65
translate de event_Elena_nightmares_657099bb:

    # MC @ talk "It's sounds more like they used you, that they abused you than anything else..."
    MC @ talk "Es klingt mehr danach, dass sie dich ausgenutzt, dich missbraucht haben, als sonst etwas..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:66
translate de event_Elena_nightmares_f28a909b:

    # ELENA @ sad "Maybe so..."
    ELENA @ sad "Mag sein..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:67
translate de event_Elena_nightmares_c9329dcf:

    # ELENA @ sad "But they are the only family I've ever known."
    ELENA @ sad "Aber sie sind die einzige Familie, die ich je gekannt habe."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:68
translate de event_Elena_nightmares_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:69
translate de event_Elena_nightmares_2396cfa8:

    # MC @ sad "...Elena... How often do you have nightmares about the mines?"
    MC @ sad "...Elena... Wie oft hast du Albträume von den Minen?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:70
translate de event_Elena_nightmares_73e8d429:

    # "Elena looked away to avoid the question, before, she gulped and turned to look me in the eyes, changing the subject quickly."
    "Elena sah weg, um der Frage auszuweichen, bevor sie schluckte und sich umdrehte, um mir in die Augen zu sehen, und schnell das Thema wechselte."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:71
translate de event_Elena_nightmares_32c1494d:

    # ELENA @ sad "...Can I stay in the bed with you tonight?"
    ELENA @ sad "...Kann ich heute Nacht bei dir im Bett bleiben?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:72
translate de event_Elena_nightmares_4e2078b1:

    # MC @ talk "Yes, if that's what you wish."
    MC @ talk "Ja, wenn das dein Wunsch ist."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:73
translate de event_Elena_nightmares_91b2fd52:

    # ELENA @ sad "Thank you."
    ELENA @ sad "Danke."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:75
translate de event_Elena_nightmares_4ce1bdf7:

    # ELENA @ sad "The nightmares will pass... {i}They always pass.{/i}"
    ELENA @ sad "Die Albträume werden vorbeigehen... {i}Sie gehen immer vorbei.{/i}"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:76
translate de event_Elena_nightmares_f8dfe42c:

    # MC @ sad "...{i}Elena.{/i}"
    MC @ sad "...{i}Elena.{/i}"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:77
translate de event_Elena_nightmares_e22dd8f7:

    # ELENA @ sad "Just hold me while I sleep..."
    ELENA @ sad "Halte mich einfach, während ich schlafe..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:78
translate de event_Elena_nightmares_40cfa765:

    # "Elena climbed up onto the bed, resting her warm body against mine as I tenderly brushed against her fur."
    "Elena kletterte auf das Bett und legte ihren warmen Körper an meinen, während ich zärtlich über ihr Fell strich."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:81
translate de event_Elena_nightmares_9acbdc33:

    # ELENA @ sad "{i}One day...{/i}"
    ELENA @ sad "{i}Eines Tages...{/i}"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:82
translate de event_Elena_nightmares_b64131e2:

    # "She murmured."
    "Murmelte sie."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:83
translate de event_Elena_nightmares_c55a9f2e:

    # ELENA @ cry "{i}I think the nightmares will be gone for good.{/i}"
    ELENA @ cry "{i}Ich denke, die Albträume werden endgültig verschwunden sein.{/i}"

translate de strings:

    # game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:52
    old "He sounds like a monster!"
    new "Er klingt wie ein Monster!"

    # game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:56
    old "He was just trying to toughen you up, I doubt he would have let anything happen to you."
    new "Er hat nur versucht, dich abzuhärten, ich bezweifle, dass er zugelassen hätte, dass dir etwas passiert."

