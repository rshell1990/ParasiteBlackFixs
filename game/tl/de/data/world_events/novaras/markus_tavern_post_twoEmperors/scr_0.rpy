translate de ev_Markus_tavern_postTwoEmps_84a066bb:

    # MC @ talk "There you are!"
    MC @ talk "Da bist du ja!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:9
translate de ev_Markus_tavern_postTwoEmps_edbac16b:

    # MARKUS "Ahh, sorry about that earlier."
    MARKUS "Ahh, entschuldige das von vorhin."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:10
translate de ev_Markus_tavern_postTwoEmps_f7814228:

    # MC @ talk "What was that?"
    MC @ talk "Was war das?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:11
translate de ev_Markus_tavern_postTwoEmps_40ffa254:

    # "Markus became somewhat flustered as he answered."
    "Markus wurde etwas verlegen, als er antwortete."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:12
translate de ev_Markus_tavern_postTwoEmps_4ef130cb:

    # MARKUS "I uh, needed to get {i}the thing we share{/i} under control..."
    MARKUS "Ich, äh, musste {i}das, was wir teilen{/i} unter Kontrolle bringen..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:13
translate de ev_Markus_tavern_postTwoEmps_edd5d8a3:

    # MC @ talk "Huh? Have you not-"
    MC @ talk "Hä? Hast du nicht-"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:14
translate de ev_Markus_tavern_postTwoEmps_636345a2:

    # MARKUS "Yes, don't worry so much."
    MARKUS "Ja, mach dir nicht so viele Sorgen."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:15
translate de ev_Markus_tavern_postTwoEmps_b89d8aea:

    # MARKUS "It's fine now."
    MARKUS "Jetzt ist alles gut."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:16
translate de ev_Markus_tavern_postTwoEmps_4a383f91:

    # MARKUS "Anyway, how did it go after with Officer Lukkan?"
    MARKUS "Wie auch immer, wie ist es danach mit Officer Lukkan gelaufen?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:17
translate de ev_Markus_tavern_postTwoEmps_5d226a8a:

    # MC @ talk "Well... About that..."
    MC @ talk "Nun... Was das betrifft..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:23
translate de ev_Markus_tavern_postTwoEmps_313f6245:

    # MARKUS @ shock "...Y-You're joking, right?"
    MARKUS @ shock "...D-Du machst Witze, oder?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:24
translate de ev_Markus_tavern_postTwoEmps_1f2d9a15:

    # "Markus' confusion and shock soon turned to frustration, and then finally anger."
    "Markus' Verwirrung und Schock verwandelten sich bald in Frustration und schließlich in Wut."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:25
translate de ev_Markus_tavern_postTwoEmps_6e3b82dd:

    # MARKUS @ angry "Those fucking bastards!"
    MARKUS @ angry "Diese verdammten Bastarde!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:26
translate de ev_Markus_tavern_postTwoEmps_4a7d71c0:

    # MARKUS @ sad "All these years..."
    MARKUS @ sad "All diese Jahre..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:27
translate de ev_Markus_tavern_postTwoEmps_4784b9d3:

    # MARKUS @ angry "Nothing but lies!"
    MARKUS @ angry "Nichts als Lügen!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:28
translate de ev_Markus_tavern_postTwoEmps_17b31c2a:

    # MC @ talk "We've always known we were being lied to about certain things."
    MC @ talk "Wir wussten immer, dass wir in Bezug auf bestimmte Dinge belogen wurden."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:29
translate de ev_Markus_tavern_postTwoEmps_b12d1541:

    # MARKUS @ angry "Not this! Not fucking this!"
    MARKUS @ angry "Nicht das! Nicht verdammt noch mal das!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:30
translate de ev_Markus_tavern_postTwoEmps_95a99166:

    # MARKUS "Surely you can't agree with what they've done?"
    MARKUS "Du kannst doch nicht etwa gutheißen, was sie getan haben?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:33
translate de ev_Markus_tavern_postTwoEmps_c399b696:

    # MARKUS @ angry "What? How can you say that!"
    MARKUS @ angry "Was? Wie kannst du das sagen!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:34
translate de ev_Markus_tavern_postTwoEmps_a2cc5969:

    # MC @ talk "What does it really change?"
    MC @ talk "Was ändert es wirklich?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:35
translate de ev_Markus_tavern_postTwoEmps_329e2755:

    # MC @ talk "If the Demorai really aren't willing to stop, should people really know?"
    MC @ talk "Wenn die Demorai wirklich nicht bereit sind aufzuhören, sollten die Leute das wirklich wissen?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:36
translate de ev_Markus_tavern_postTwoEmps_6fc25b58:

    # MC @ talk "I mean, doesn't it make it {i}easier{/i} to fight them thinking they really are just savage beasts?"
    MC @ talk "Ich meine, macht es das nicht {i}einfacher{/i}, gegen sie zu kämpfen, wenn man denkt, sie seien wirklich nur wilde Bestien?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:37
translate de ev_Markus_tavern_postTwoEmps_034b71f7:

    # MC @ talk "Do {i}you{/i} really want to be thinking every time we have fight one of those things about who they are?"
    MC @ talk "Willst {i}du{/i} wirklich jedes Mal, wenn wir gegen eines dieser Dinger kämpfen müssen, darüber nachdenken, wer sie sind?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:38
translate de ev_Markus_tavern_postTwoEmps_0fa3928a:

    # MC @ talk "{i}Do they have families? Children and loved ones waiting at home like us? Do they mourn when their brothers and sisters fall?{/i}"
    MC @ talk "{i}Haben sie Familien? Kinder und geliebte Menschen, die wie bei uns zu Hause auf sie warten? Trauern sie, wenn ihre Brüder und Schwestern fallen?{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:39
translate de ev_Markus_tavern_postTwoEmps_b1427ed4:

    # MC @ talk "Are those the kind of questions you really want to be putting in people's heads during a war?"
    MC @ talk "Sind das die Art von Fragen, die du den Leuten wirklich während eines Krieges in den Kopf setzen willst?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:40
translate de ev_Markus_tavern_postTwoEmps_e33600fa:

    # MARKUS @ angry "We've been lied to since we were children, [player_name!t]."
    MARKUS @ angry "Wir sind seit unserer Kindheit belogen worden, [player_name!t]."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:41
translate de ev_Markus_tavern_postTwoEmps_df78f4bd:

    # MARKUS @ angry "Who knows what else they've been keeping from us."
    MARKUS @ angry "Wer weiß, was sie uns noch alles verschwiegen haben."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:43
translate de ev_Markus_tavern_postTwoEmps_f0f60350:

    # MC @ talk "That Demorai... That girl back in those ruins, Sypha."
    MC @ talk "Diese Demorai... Dieses Mädchen damals in diesen Ruinen, Sypha."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:45
translate de ev_Markus_tavern_postTwoEmps_40666aed:

    # MC @ talk "She led us out safely like she said she would."
    MC @ talk "Sie hat uns sicher herausgeführt, wie sie es gesagt hat."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:46
translate de ev_Markus_tavern_postTwoEmps_0750dbb7:

    # MC @ talk "AND she showed a willingness to work together... That means there has to be hope for other Demorai to do the same."
    MC @ talk "UND sie hat die Bereitschaft gezeigt, zusammenzuarbeiten... Das bedeutet, es muss Hoffnung geben, dass andere Demorai das Gleiche tun."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:48
translate de ev_Markus_tavern_postTwoEmps_4f5c25bc:

    # MC @ talk "She tried to help us and... We didn't listen."
    MC @ talk "Sie versuchte uns zu helfen und... Wir haben nicht zugehört."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:49
translate de ev_Markus_tavern_postTwoEmps_e7a5d09d:

    # MC @ talk "{i}She was telling the truth.{/i}"
    MC @ talk "{i}Sie hat die Wahrheit gesagt.{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:50
translate de ev_Markus_tavern_postTwoEmps_b4a91270:

    # MC @ talk "If we can't keep our minds open at all to even the {i}possibility{/i} of negotiations or peace, we rule them out entirely before they have a chance."
    MC @ talk "Wenn wir nicht einmal die {i}Möglichkeit{/i} von Verhandlungen oder Frieden in Betracht ziehen, schließen wir sie völlig aus, bevor sie eine Chance haben."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:51
translate de ev_Markus_tavern_postTwoEmps_02222f86:

    # MARKUS "So, you {i}do{/i} think there's a chance for peace talks?"
    MARKUS "Also, du denkst {i}wirklich{/i}, es gibt eine Chance auf Friedensgespräche?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:52
translate de ev_Markus_tavern_postTwoEmps_4b8ffdf3:

    # MC @ talk "Not with any of the current leadership on both sides it seems..."
    MC @ talk "Mit keiner der aktuellen Führungen auf beiden Seiten, wie es scheint..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:53
translate de ev_Markus_tavern_postTwoEmps_2b1192e5:

    # MC @ talk "But there are parties {i}within both camps{/i} who probably would be willing to talk."
    MC @ talk "Aber es gibt Parteien {i}in beiden Lagern{/i}, die wahrscheinlich zu Gesprächen bereit wären."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:54
translate de ev_Markus_tavern_postTwoEmps_2e542c81:

    # MARKUS "Hmm... I'm mad about being lied to, but-"
    MARKUS "Hmm... Ich bin sauer, dass ich angelogen wurde, aber-"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:55
translate de ev_Markus_tavern_postTwoEmps_bf69bc6c:

    # MARKUS "I'm not so sure if I like the idea of negotiations with those {i}'things'{/i} after everything they've done."
    MARKUS "Ich bin mir nicht so sicher, ob mir die Idee von Verhandlungen mit diesen {i}'Dingern'{/i} gefällt, nach allem, was sie getan haben."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:56
translate de ev_Markus_tavern_postTwoEmps_b25bf2ac:

    # MARKUS "{i}*Sigh*{/i}"
    MARKUS "{i}*Seufz*{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:57
translate de ev_Markus_tavern_postTwoEmps_3ce1f6b0:

    # MARKUS "I guess none of this really matters though, right?"
    MARKUS "Ich schätze, das alles spielt aber keine wirkliche Rolle, oder?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:58
translate de ev_Markus_tavern_postTwoEmps_d149b11e:

    # MARKUS "I mean, we're just two nobodies from the Adventurers Guild, so..."
    MARKUS "Ich meine, wir sind nur zwei Niemande aus der Abenteurergilde, also..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:59
translate de ev_Markus_tavern_postTwoEmps_08467006:

    # MARKUS "Its not like either of us are going to be making a real difference anytime soon."
    MARKUS "Es ist nicht so, als ob irgendeiner von uns in nächster Zeit einen echten Unterschied machen würde."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:60
translate de ev_Markus_tavern_postTwoEmps_3488caf3:

    # "I couldn't help but feel slightly depressed at Markus' comment, he was of course, correct."
    "Ich konnte nicht anders, als mich bei Markus' Kommentar etwas deprimiert zu fühlen, er hatte natürlich recht."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:61
translate de ev_Markus_tavern_postTwoEmps_208e182d:

    # "Even with all this knowledge and revelations, what difference could we really make?"
    "Selbst mit all diesem Wissen und diesen Offenbarungen, welchen Unterschied könnten wir wirklich machen?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:62
translate de ev_Markus_tavern_postTwoEmps_cdea2e4d:

    # "Even with our dark gifts, there was a sense of real powerlessness that even after learning all we had, it changed nothing."
    "Selbst mit unseren dunklen Gaben gab es ein Gefühl echter Machtlosigkeit, dass selbst nachdem wir alles gelernt hatten, es nichts änderte."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:63
translate de ev_Markus_tavern_postTwoEmps_e6bb031a:

    # MC @ sad "Yeah... I guess you're right."
    MC @ sad "Ja... ich schätze, du hast recht."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:64
translate de ev_Markus_tavern_postTwoEmps_d6316cc9:

    # MARKUS @ smile "...Hey, wanna get drunk and forget all this?"
    MARKUS @ smile "...Hey, wollen wir uns betrinken und das alles vergessen?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:65
translate de ev_Markus_tavern_postTwoEmps_1bda44aa:

    # MC @ talk "{i}Absolutely.{/i}"
    MC @ talk "{i}Absolut.{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:67
translate de ev_Markus_tavern_postTwoEmps_ee8b9654:

    # "After a couple drinks, me and Markus managed to push what had learned aside as we enjoyed having a merry conversation while reminiscing once again."
    "Nach ein paar Drinks gelang es Markus und mir, das Gelernte beiseite zu schieben, während wir ein fröhliches Gespräch führten und erneut in Erinnerungen schwelgten."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:68
translate de ev_Markus_tavern_postTwoEmps_31857223:

    # "The Tavern by now had begun to pick up, and soon the place was heaving with other patrons like us."
    "Die Taverne hatte inzwischen begonnen, sich zu füllen, und bald war der Ort voll von anderen Gästen wie uns."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:73
translate de ev_Markus_tavern_postTwoEmps_90b6d8d2:

    # MARKUS @ smile "Haha! I almost forgot about that one!"
    MARKUS @ smile "Haha! Das hätte ich fast vergessen!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:74
translate de ev_Markus_tavern_postTwoEmps_039915af:

    # MARKUS @ smile "Gods, whatever happened to Joana Tepeha?"
    MARKUS @ smile "Götter, was ist eigentlich aus Joana Tepeha geworden?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:75
translate de ev_Markus_tavern_postTwoEmps_9115411d:

    # MARKUS @ smile "Did those two actually marry in the end?"
    MARKUS @ smile "Haben die beiden am Ende tatsächlich geheiratet?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:76
translate de ev_Markus_tavern_postTwoEmps_8aabdc78:

    # MC @ smile "I'm pretty sure the engagement was called off after {i}THAT{/i} and she headed off with her family to Borusmark in Skarshire."
    MC @ smile "Ich bin mir ziemlich sicher, dass die Verlobung nach {i}DEM{/i} aufgelöst wurde und sie mit ihrer Familie nach Borusmark in Skarshire aufgebrochen ist."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:78
translate de ev_Markus_tavern_postTwoEmps_7a4484c0:

    # ADARA @ smile "I see you two are enjoying yourselves."
    ADARA @ smile "Ich sehe, ihr beiden amüsiert euch."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:79
translate de ev_Markus_tavern_postTwoEmps_8cbd62f9:

    # MARKUS @ joy "Adara!"
    MARKUS @ joy "Adara!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:80
translate de ev_Markus_tavern_postTwoEmps_5e85024c:

    # MARKUS @ smile "Where have you been?"
    MARKUS @ smile "Wo warst du?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:81
translate de ev_Markus_tavern_postTwoEmps_4fd49c32:

    # ADARA @ talk "Been busy between working and looking after father."
    ADARA @ talk "War beschäftigt mit Arbeiten und der Betreuung von Vater."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:82
translate de ev_Markus_tavern_postTwoEmps_45400e55:

    # ADARA @ talk "Are you two celebrating something?"
    ADARA @ talk "Feiert ihr beiden etwas?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:83
translate de ev_Markus_tavern_postTwoEmps_1813f22d:

    # MC @ talk "Uhh, not quite."
    MC @ talk "Äh, nicht ganz."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:84
translate de ev_Markus_tavern_postTwoEmps_c5655818:

    # MC @ talk "Just getting drunk after a... {i}difficult{/i} quest."
    MC @ talk "Betrinke mich nur nach einer... {i}schwierigen{/i} Mission."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:85
translate de ev_Markus_tavern_postTwoEmps_11ba5d0e:

    # ADARA @ sad "O-Oh... I'll leave you both be."
    ADARA @ sad "O-Oh... Ich lasse euch beide in Ruhe."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:86
translate de ev_Markus_tavern_postTwoEmps_aea6a095:

    # ADARA @ talk "You probably don't want me ruining your night."
    ADARA @ talk "Du willst wahrscheinlich nicht, dass ich euch den Abend verderbe."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:87
translate de ev_Markus_tavern_postTwoEmps_1817d2f9:

    # MARKUS @ smile "Nonsense, Adara!"
    MARKUS @ smile "Unsinn, Adara!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:88
translate de ev_Markus_tavern_postTwoEmps_60bf2b19:

    # MARKUS "I'm heading up to get another round, would you like one?"
    MARKUS "Ich gehe kurz eine neue Runde holen, möchtest du auch eine?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:89
translate de ev_Markus_tavern_postTwoEmps_5b9ffa10:

    # ADARA @ talk "Umm, perhaps just {i}one{/i} drink won't hurt."
    ADARA @ talk "Ähm, vielleicht kann genau {i}ein{/i} Drink nicht schaden."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:90
translate de ev_Markus_tavern_postTwoEmps_18e24e75:

    # MARKUS @ smile "That's the spirit! I'll be right back!"
    MARKUS @ smile "Das ist die richtige Einstellung! Ich bin gleich wieder da!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:92
translate de ev_Markus_tavern_postTwoEmps_138083ce:

    # "As Markus did his best to fight his way over to order some drinks, Adara moved closer to me."
    "Während Markus sich nach besten Kräften durchkämpfte, um Getränke zu bestellen, rückte Adara näher zu mir."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:94
translate de ev_Markus_tavern_postTwoEmps_95db9b8e:

    # ADARA @ sad "Are you okay?"
    ADARA @ sad "Alles okay?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:95
translate de ev_Markus_tavern_postTwoEmps_0a7f8a9b:

    # MC @ talk "I'm fine, Adara."
    MC @ talk "Mir geht es gut, Adara."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:96
translate de ev_Markus_tavern_postTwoEmps_3796113b:

    # MC @ smile "It's good to see you."
    MC @ smile "Schön, dich zu sehen."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:97
translate de ev_Markus_tavern_postTwoEmps_885013fd:

    # ADARA @ sad "If... If something happened and you want to talk about it."
    ADARA @ sad "Wenn... Wenn etwas passiert ist und du darüber reden möchtest."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:98
translate de ev_Markus_tavern_postTwoEmps_a42160e3:

    # ADARA @ sad "We can go somewhere private if you want..."
    ADARA @ sad "Wir können irgendwo hingehen, wo es privat ist, wenn du möchtest..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:99
translate de ev_Markus_tavern_postTwoEmps_68c4b9a6:

    # MC @ sad "No, Adara... I-"
    MC @ sad "Nein, Adara... Ich-"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:104
translate de ev_Markus_tavern_postTwoEmps_32221592:

    # "Suddenly, between the heaving crowds, something caught my eye."
    "Plötzlich, zwischen den wogenden Menschenmengen, erregte etwas meine Aufmerksamkeit."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:105
translate de ev_Markus_tavern_postTwoEmps_8d8d34bc:

    # "A robed figure amongst them, staring right at me."
    "Eine verhüllte Gestalt unter ihnen, die mich direkt anstarrte."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:106
