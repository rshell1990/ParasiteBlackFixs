# game/data/world_events/novaras/nijah_rescue/ev_nijah_rescue.rpy:59
translate de ev_nijah_rescue_0_f3d96e92:

    # "Making my way through the streets of Novaras, In the distance, I heard the shrieking sounds of a cry and panicked pleading."
    "Auf meinem Weg durch die Straßen von Novaras hörte ich in der Ferne die schrillen Schreie von Weinen und panischem Flehen."

# game/data/world_events/novaras/nijah_rescue/ev_nijah_rescue.rpy:60
translate de ev_nijah_rescue_0_51009b86:

    # "Looking around, People went about their business obliviously, unable to hear the cries that to me were almost deafening."
    "Als ich mich umsah, gingen die Leute ahnungslos ihren Geschäften nach, unfähig, die Schreie zu hören, die für mich fast ohrenbetäubend waren."

# game/data/world_events/novaras/nijah_rescue/ev_nijah_rescue.rpy:61
translate de ev_nijah_rescue_0_a041d644:

    # MC "(What is that sound?)"
    MC "(Was ist das für ein Geräusch?)"

# game/data/world_events/novaras/nijah_rescue/ev_nijah_rescue.rpy:62
translate de ev_nijah_rescue_0_f2f55c46:

    # MC "(It sounds like it's nearby...)"
    MC "(Es klingt, als wäre es in der Nähe...)"

