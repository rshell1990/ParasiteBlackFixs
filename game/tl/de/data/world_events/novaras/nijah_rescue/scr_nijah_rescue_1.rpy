# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:3
translate de evscr_nijah_rescue_1_53260509:

    # MC "Sounds like sure trouble... Should I?" nointeract
    MC "Das klingt nach sicherem Ärger ... Sollte ich?" nointeract

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:6
translate de evscr_nijah_rescue_1_f8d6d024:

    # "I turned sharply as I made my way through a series of dark and fetid alleyways, chasing the sounds."
    "Ich bog scharf ab, während ich mich durch eine Reihe dunkler und stinkender Gassen bahnte, den Geräuschen nachjagend."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:7
translate de evscr_nijah_rescue_1_843b0aa0:

    # "Stumbling over dislodged cobblestones and piles of rubbish, I finally came across a woman, terrified and cowering."
    "Über lose Pflastersteine und Müllhaufen stolpernd, stieß ich schließlich auf eine verängstigte, kauernde Frau."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:8
translate de evscr_nijah_rescue_1_bba0ea96:

    # "Her face was shrouded by rags as the men surrounded her brandishing their blades."
    "Ihr Gesicht war von Lumpen verhüllt, als die Männer sie umringten und ihre Klingen schwangen."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:9
translate de evscr_nijah_rescue_1_db49222d:

    # "The largest amongst them, a fat, repulsive bearded thug, towered over her."
    "Der Größte unter ihnen, ein fetter, abstoßender bärtiger Schläger, ragte über ihr auf."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:10
translate de evscr_nijah_rescue_1_275c7a43:

    # THUG @ talk "Stupid fucking whore."
    THUG @ talk "Dumme verdammte Hure."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:11
translate de evscr_nijah_rescue_1_9caf38da:

    # THUG @ talk "You still owe us gold, girl!"
    THUG @ talk "Du schuldest uns immer noch Gold, Mädchen!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:12
translate de evscr_nijah_rescue_1_9e522f02:

    # "The frightened, muffled voice pleaded back."
    "Die verängstigte, gedämpfte Stimme flehte zurück."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:13
translate de evscr_nijah_rescue_1_87ee3a0e:

    # UNKNOWN @ talk "Please! Need time!"
    UNKNOWN @ talk "Bitte! Brauche Zeit!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:14
translate de evscr_nijah_rescue_1_39c7b05d:

    # THUG @ talk "No more time, you pay NOW!"
    THUG @ talk "Keine Zeit mehr, du bezahlst JETZT!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:19
translate de evscr_nijah_rescue_1_afadeed1:

    # "From the shadows I emerged, and the men turned to face me."
    "Aus den Schatten trat ich hervor, und die Männer wandten sich mir zu."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:20
translate de evscr_nijah_rescue_1_568bf043:

    # THUG @ talk "Who are you?"
    THUG @ talk "Wer bist du?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:21
translate de evscr_nijah_rescue_1_5a8de8fb:

    # THUG @ talk "Stay out of this, this does nor a concern you."
    THUG @ talk "Halt dich da raus, das geht dich nichts an."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:22
translate de evscr_nijah_rescue_1_73cc7d0a:

    # "Looking around, I could see dozens of eyes watching from every open crevice and window."
    "Als ich mich umsah, konnte ich Dutzende Augen sehen, die aus jeder offenen Ritze und jedem Fenster starrten."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:23
translate de evscr_nijah_rescue_1_cef271a4:

    # MC "(Damn... I better be careful here, it’s too risky to transform)"
    MC "(Verdammt ... Ich sollte hier besser vorsichtig sein, es ist zu riskant, mich zu verwandeln.)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:24
translate de evscr_nijah_rescue_1_d5d88d8b:

    # MC "(If I fight them, I’ll have to do it in my normal form)"
    MC "(Wenn ich gegen sie kämpfe, muss ich es in meiner normalen Gestalt tun.)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:37
translate de evscr_nijah_rescue_1_thugsmenu_0ba34b00:

    # THUG @ talk "Bah! There are three of us and only one of you!"
    THUG @ talk "Bah! Wir sind zu dritt und du nur einer!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:38
translate de evscr_nijah_rescue_1_thugsmenu_e049bb73:

    # THUG @ talk "You’ll have to do better than that!"
    THUG @ talk "Da musst du schon mehr bieten!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:43
translate de evscr_nijah_rescue_1_thugsmenu_b57efaae:

    # THUG @ talk "Kill him, you fools!"
    THUG @ talk "Tötet ihn, ihr Narren!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:48
translate de evscr_nijah_rescue_1_thugsmenu_6e045b1a:

    # "As their lifeless bodies littered the alleyway, the blood flowed freely into the cracks of the cobblestone."
    "Während ihre leblosen Körper die Gasse übersäten, floss das Blut ungehindert in die Ritzen des Kopfsteinpflasters."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:49
translate de evscr_nijah_rescue_1_thugsmenu_350520a2:

    # "I sighed with relief, wiping the sweat from my brow but quickly realised I couldn’t stay here long or else I risked drawing the ire of the guards."
    "Ich seufzte erleichtert und wischte mir den Schweiß von der Stirn, doch mir wurde schnell klar, dass ich hier nicht lange verweilen konnte, sonst zöge ich den Zorn der Wachen auf mich."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:53
translate de evscr_nijah_rescue_1_thugsmenu_83ae0dcb:

    # THUG @ talk "This is not your business, stranger!"
    THUG @ talk "Das geht dich nichts an, Fremder!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:54
translate de evscr_nijah_rescue_1_thugsmenu_f5ad7f49:

    # THUG @ talk "This woman owes us money and she will pay it!"
    THUG @ talk "Diese Frau schuldet uns Geld und sie wird es bezahlen!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:55
translate de evscr_nijah_rescue_1_thugsmenu_03518bd4:

    # MC @ talk "How much is her debt?"
    MC @ talk "Wie hoch ist ihre Schuld?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:56
translate de evscr_nijah_rescue_1_thugsmenu_b02d4725:

    # THUG @ talk "Two hundred coins now... the rest later."
    THUG @ talk "Zweihundert Münzen jetzt... der Rest später."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:60
translate de evscr_nijah_rescue_1_thugsmenu_3a22e377:

    # THUG @ talk "Hmm..."
    THUG @ talk "Hmm..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:61
translate de evscr_nijah_rescue_1_thugsmenu_9a589a68:

    # THUG @ talk "You have bought yourself some time, {i}for now,{/i} girl..."
    THUG @ talk "Du hast dir etwas Zeit erkauft, {i}fürs Erste,{/i} Mädchen..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:62
translate de evscr_nijah_rescue_1_thugsmenu_276b253c:

    # THUG @ talk "Pleasure doing business with you, stranger, heh..."
    THUG @ talk "Angenehm, mit dir Geschäfte zu machen, Fremder, heh..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:66
translate de evscr_nijah_rescue_1_thugsmenu_6dfebd14:

    # THUG @ talk "Men! Draw your blades!"
    THUG @ talk "Männer! Zieht eure Klingen!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:74
translate de evscr_nijah_rescue_1_thugsmenu_b711464f:

    # THUG @ talk "A wise decision..."
    THUG @ talk "Eine weise Entscheidung..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:78
translate de evscr_nijah_rescue_1_thugsmenu_f5d8de19:

    # MC "(As I left the alley, I could hear the strangely familiar voice pleading behind me for mercy.)"
    MC "(Als ich die Gasse verließ, konnte ich hinter mir die seltsam vertraute Stimme um Gnade flehen hören.)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:80
translate de evscr_nijah_rescue_1_thugsmenu_cd817b72:

    # MC "(As I left the alley, I could hear a female voice pleading behind me for mercy.)"
    MC "(Als ich die Gasse verließ, konnte ich hinter mir eine weibliche Stimme um Gnade flehen hören.)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:81
translate de evscr_nijah_rescue_1_thugsmenu_316d5d01:

    # MC "(I wondered if I could, or should, have done something different there.)"
    MC "(Ich fragte mich, ob ich dort etwas hätte anders machen können oder sollen.)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:82
translate de evscr_nijah_rescue_1_thugsmenu_8dd41211:

    # MC "(But, it's best to leave Ramonians to handle their own affairs.)"
    MC "(Aber es ist besser, die Ramonier ihre eigenen Angelegenheiten regeln zu lassen.)"

