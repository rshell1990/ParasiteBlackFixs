# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:3
translate de evscr_nijah_rescue_3_175fd358:

    # "Leading Nijah back to mine, Regina smiled as she heard the door open, her face quickly turning to bewilderment when she caught sight of Nijah."
    "Als Regina Nijah zu mir nach Hause führte, lächelte sie, als sie die Tür öffnen hörte, doch ihr Gesicht verwandelte sich schnell in Verwirrung, als sie Nijah erblickte."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:7
translate de evscr_nijah_rescue_3_a1a75d38:

    # REGINA @ talk "[player_name!t]! There you—"
    REGINA @ talk "[player_name!t]! Da bist du ja—"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:8
translate de evscr_nijah_rescue_3_fe41ff6b:

    # REGINA @ talk "Uhhh... Who’s—"
    REGINA @ talk "Ähhh... Wer ist—"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:10
translate de evscr_nijah_rescue_3_9490682d:

    # MC @ talk "She’s a friend of mine."
    MC @ talk "Sie ist eine Freundin von mir."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:11
translate de evscr_nijah_rescue_3_05f128d2:

    # "Regina raised a curious eyebrow."
    "Regina zog eine neugierige Augenbraue hoch."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:12
translate de evscr_nijah_rescue_3_b6bea8e5:

    # REGINA @ talk "... A ‘friend’ hmm?"
    REGINA @ talk "... Eine 'Freundin', hmm?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:13
translate de evscr_nijah_rescue_3_c4975cf6:

    # REGINA @ talk "Well... Aren’t you going to introduce me to this {i}'friend?'{/i}"
    REGINA @ talk "Nun... Willst du mich nicht dieser {i}'Freundin?'{/i} vorstellen?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:15
translate de evscr_nijah_rescue_3_a7c1a9f3:

    # MC @ talk "Long story, I was just out when I heard some screaming."
    MC @ talk "Lange Geschichte, ich war gerade unterwegs, als ich Schreie hörte."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:16
translate de evscr_nijah_rescue_3_5cab427d:

    # MC @ talk "I followed the cries and found her being attacked by some street gangs."
    MC @ talk "Ich folgte den Schreien und fand sie, wie sie von einigen Straßengangs angegriffen wurde."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:17
translate de evscr_nijah_rescue_3_43b17049:

    # "Nijah shyly hide behind me."
    "Nijah versteckte sich schüchtern hinter mir."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:18
translate de evscr_nijah_rescue_3_a6907109:

    # NIJAH "F-Friend saved me."
    NIJAH "F-Freund hat mich gerettet."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:19
translate de evscr_nijah_rescue_3_6ad0ef4d:

    # "Regina folded her arms."
    "Regina verschränkte die Arme."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:20
translate de evscr_nijah_rescue_3_ecf833b4:

    # REGINA @ talk "...So instead of just going to the guards, you thought to bring her {i}here?{/i}"
    REGINA @ talk "...Also anstatt einfach zur Wache zu gehen, dachtest du, sie {i}hierher{/i} zu bringen?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:21
translate de evscr_nijah_rescue_3_3ec77cbf:

    # MC @ talk "Well I didn't know where else to take her!"
    MC @ talk "Nun, ich wusste nicht, wohin ich sie sonst bringen sollte!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:22
translate de evscr_nijah_rescue_3_26be51c2:

    # REGINA @ talk "{i}*Sigh*{/i} Well, does she have a name?"
    REGINA @ talk "{i}*Seufz*{/i} Nun, hat sie einen Namen?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:23
translate de evscr_nijah_rescue_3_07a546f5:

    # MC @ talk "[regina_ref_cap!t], this is Nijah."
    MC @ talk "[regina_ref_cap!t], das ist Nijah."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:24
translate de evscr_nijah_rescue_3_c9f3fab8:

    # MC @ talk "Nijah, this is [regina_ref!t]."
    MC @ talk "Nijah, das ist [regina_ref!t]."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:25
translate de evscr_nijah_rescue_3_aef9a2f5:

    # "Nijah softly waved her hand shyly,"
    "Nijah winkte sanft und schüchtern mit der Hand,"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:26
translate de evscr_nijah_rescue_3_fd8403c3:

    # NIJAH "H-Hello..."
    NIJAH "H-Hallo..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:27
translate de evscr_nijah_rescue_3_8449e550:

    # NIJAH "It iz good to make your..."
    NIJAH "Es is' gut, Ihre..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:28
translate de evscr_nijah_rescue_3_183b3aa9:

    # "Nijah struggled on the word."
    "Nijah kämpfte mit dem Wort."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:29
translate de evscr_nijah_rescue_3_8181da29:

    # NIJAH "It iz good to meet you!"
    NIJAH "Es isch gut, dich zu treffen!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:30
translate de evscr_nijah_rescue_3_1705f125:

    # "Regina smiled uncomfortably."
    "Regina lächelte unbehaglich."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:31
translate de evscr_nijah_rescue_3_171d3055:

    # REGINA @ talk "Uhh, yes. likewise, dear."
    REGINA @ talk "Ähh, ja. Ebenso, meine Liebe."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:32
translate de evscr_nijah_rescue_3_0af8f422:

    # MC @ talk "Nijah, go wait in my room a moment."
    MC @ talk "Nijah, warte einen Moment in meinem Zimmer."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:33
translate de evscr_nijah_rescue_3_d46309fa:

    # "Nijah looked puzzled as she looked around for a second."
    "Nijah wirkte verwirrt, als sie sich kurz umblickte."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:34
translate de evscr_nijah_rescue_3_73c7df59:

    # NIJAH "Such big home..."
    NIJAH "So ein großes Haus..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:35
translate de evscr_nijah_rescue_3_5e79a079:

    # REGINA @ talk "..."
    REGINA @ talk "..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:36
translate de evscr_nijah_rescue_3_dbb6bba6:

    # MC @ talk "My room is just there down the Hall."
    MC @ talk "Mein Zimmer ist gleich da den Flur runter."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:37
translate de evscr_nijah_rescue_3_39dfb4c3:

    # "With my hand on her back, I pointed towards the door at the end of the hallway which Nijah nervously headed towards,"
    "Mit meiner Hand auf ihrem Rücken deutete ich auf die Tür am Ende des Flurs, auf die Nijah nervös zuging,"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:39
translate de evscr_nijah_rescue_3_16d764cf:

    # "With her hand on the door handle, she anxiously looking back at me again to be sure, to which I once again waved to tell her go in."
    "Mit ihrer Hand an der Türklinke blickte sie ängstlich noch einmal zu mir zurück, um sich zu vergewissern, und ich winkte ihr erneut, um ihr zu bedeuten, dass sie hineingehen soll."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:40
translate de evscr_nijah_rescue_3_3f8ef0b7:

    # "As soon as Nijah stepped inside and was out of sight, [regina_ref!t] turned and snapped at me."
    "Sobald Nijah hineingetreten und außer Sichtweite war, drehte sich [regina_ref!t] um und fauchte mich an."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:41
translate de evscr_nijah_rescue_3_b77d275d:

    # REGINA @ talk "What in the seven hells do you think you're doing?!"
    REGINA @ talk "Was in sieben Höllen glaubst du, was du da tust?!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:42
translate de evscr_nijah_rescue_3_d83a1db9:

    # MC @ talk "It’s not what you think!"
    MC @ talk "Es ist nicht, was du denkst!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:43
translate de evscr_nijah_rescue_3_46d8770f:

    # REGINA @ talk "Oh? So that isn’t some Ramonian girl in your room right now?"
    REGINA @ talk "Oh? Ist das also kein ramonisches Mädchen, das gerade in deinem Zimmer ist?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:44
translate de evscr_nijah_rescue_3_b7804041:

    # MC @ talk "Well... Yes, but—"
    MC @ talk "Nun... Ja, aber—"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:45
translate de evscr_nijah_rescue_3_e7db4a26:

    # REGINA @ talk "You know she can’t stay here, right?"
    REGINA @ talk "Du weißt, dass sie nicht hierbleiben kann, oder?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:46
translate de evscr_nijah_rescue_3_97ab3581:

    # REGINA @ talk "If the guards find us giving residency to refugees without the right paperwork, we could be imprisoned!"
    REGINA @ talk "Wenn die Wachen herausfinden, dass wir Flüchtlingen ohne die richtigen Papiere Unterkunft geben, könnten wir eingesperrt werden!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:47
translate de evscr_nijah_rescue_3_48308e13:

    # MC @ talk "She was being attacked! What was I supposed to do? Sit back and let it happen?"
    MC @ talk "Sie wurde angegriffen! Was hätte ich tun sollen? Einfach zusehen und es geschehen lassen?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:48
translate de evscr_nijah_rescue_3_d67fc98f:

    # REGINA @ talk "{i}*Sigh*{/i} Please tell me you aren’t in love with her..."
    REGINA @ talk "{i}*Seufz*{/i} Bitte sag mir, dass du nicht in sie verliebt bist..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:49
translate de evscr_nijah_rescue_3_a021a920:

    # MC @ talk "What? No..."
    MC @ talk "Was? Nein..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:50
translate de evscr_nijah_rescue_3_f0b20964:

    # REGINA @ talk "Then tell me she isn't pregnant."
    REGINA @ talk "Dann sag mir, dass sie nicht schwanger ist."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:51
translate de evscr_nijah_rescue_3_f4492d92:

    # MC @ talk "Of course not!"
    MC @ talk "Natürlich nicht!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:52
translate de evscr_nijah_rescue_3_8b7025b9:

    # BLACK "{b}YET.{/b}"
    BLACK "{b}NOCH.{/b}"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:53
translate de evscr_nijah_rescue_3_f9032156:

    # MC @ talk "I told you! I just saved her back there!"
    MC @ talk "Ich habe es dir gesagt! Ich habe sie doch gerade da hinten gerettet!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:54
translate de evscr_nijah_rescue_3_23b6fc4c:

    # REGINA @ talk "Good, because she can’t stay here."
    REGINA @ talk "Gut, denn sie kann nicht hier bleiben."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:55
translate de evscr_nijah_rescue_3_3ce837b8:

    # MC @ talk "I can’t turn her back out onto the streets, people are after her!"
    MC @ talk "Ich kann sie nicht wieder auf die Straße schicken, Leute sind hinter ihr her!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:56
translate de evscr_nijah_rescue_3_b41b73a8:

    # REGINA @ talk "We don’t have a choice in the matter."
    REGINA @ talk "Wir haben da keine Wahl."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:57
translate de evscr_nijah_rescue_3_9aed3643:

    # REGINA @ talk "What don't you understand? It's a crime!"
    REGINA @ talk "Was verstehst du nicht? Es ist ein Verbrechen!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:58
translate de evscr_nijah_rescue_3_3d823c19:

    # REGINA "{i}*Sigh*{/i}"
    REGINA "{i}*Seufz*{/i}"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:59
translate de evscr_nijah_rescue_3_eb1a89b2:

    # "Regina rubbed her brow in exasperation."
    "Regina rieb sich vor Verärgerung die Stirn."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:60
translate de evscr_nijah_rescue_3_e88e6824:

    # REGINA @ talk "She can stay the night but... that’s the best I can do, I’m sorry, dear."
    REGINA @ talk "Sie kann hier übernachten, aber... mehr kann ich wirklich nicht tun, es tut mir leid, Liebes."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:61
translate de evscr_nijah_rescue_3_8e8b1c12:

    # MC @ talk "... Alright, I’ll figure something out."
    MC @ talk "... In Ordnung, ich werde mir etwas einfallen lassen."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:62
translate de evscr_nijah_rescue_3_e2f66630:

    # "As I passed by [regina_ref!t], she sighed dejectedly. She wasn’t a cruel person by nature, but she knew the dangers of defying the law in Alderay."
    "Als ich an [regina_ref!t] vorbeiging, seufzte sie niedergeschlagen. Sie war von Natur aus kein grausamer Mensch, aber sie kannte die Gefahren, das Gesetz in Alderay zu missachten."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:64
translate de evscr_nijah_rescue_3_6d31a4d7:

    # "Still, it left me little time to deal with quite the predicament."
    "Trotzdem blieb mir wenig Zeit, mich um diese missliche Lage zu kümmern."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_3.rpy:65
translate de evscr_nijah_rescue_3_18c0825a:

    # MC "(Nijah is waiting in my room, I should speak to her there.)"
    MC "(Nijah wartet in meinem Zimmer, ich sollte dort mit ihr sprechen.)"

