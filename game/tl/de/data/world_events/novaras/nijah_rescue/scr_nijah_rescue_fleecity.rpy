# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:2
translate de evscr_nijah_rescue_fleecity_1bd3e812:

    # MC @ talk "I think you should flee the city."
    MC @ talk "Ich denke, du solltest aus der Stadt fliehen."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:3
translate de evscr_nijah_rescue_fleecity_c68400fe:

    # NIJAH "You mean... Leave?"
    NIJAH "Du meinst... Gehen?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:4
translate de evscr_nijah_rescue_fleecity_05dbc256:

    # MC @ talk "Yes, get out of here before these thugs get to you one way or another."
    MC @ talk "Ja, verschwinde von hier, bevor diese Schläger dich auf die eine oder andere Weise kriegen."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:5
translate de evscr_nijah_rescue_fleecity_bfa35e45:

    # NIJAH "But I will need gold..."
    NIJAH "Aber ich werde Gold brauchen..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:6
translate de evscr_nijah_rescue_fleecity_555f5491:

    # MC @ talk "I'll help you with that."
    MC @ talk "Ich helfe dir damit."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:7
translate de evscr_nijah_rescue_fleecity_204559f8:

    # MC "(500 gold should suffice for her to leave safely)"
    MC "(500 Gold sollten ausreichen, damit sie sicher fortgehen kann.)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:10
translate de evscr_nijah_rescue_fleecity_b178399b:

    # NIJAH "I-I shall wait here."
    NIJAH "I-Ich werde hier warten."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:15
translate de evscr_nijah_rescue_fleecity_7ecaf1b7:

    # "As Nijah took the coin, she seemed even more lost and confused than before:"
    "Als Nijah die Münze nahm, schien sie noch verlorener und verwirrter als zuvor:"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:16
translate de evscr_nijah_rescue_fleecity_f1d5be5f:

    # NIJAH "But where... Where will I go?"
    NIJAH "Aber wohin... Wohin werde ich gehen?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:17
translate de evscr_nijah_rescue_fleecity_8e8c2e72:

    # MC @ talk "I don’t know Nijah, head towards one of the villages but stay in the North."
    MC @ talk "Ich weiß nicht, Nijah, geh in Richtung eines der Dörfer, aber bleib im Norden."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:18
translate de evscr_nijah_rescue_fleecity_ee8cb889:

    # MC @ talk "Do {i}not{/i} try crossing the Valley of Death to get to the the Free city."
    MC @ talk "Versuche {i}nicht{/i} das Tal des Todes zu durchqueren, um zur freien Stadt zu gelangen."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:19
translate de evscr_nijah_rescue_fleecity_51554d47:

    # "Dejected and defeated, Nijah leaned forward to hug me."
    "Niedergeschlagen und besiegt, lehnte sich Nijah vor, um mich zu umarmen."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:20
translate de evscr_nijah_rescue_fleecity_1711c02d:

    # NIJAH "Thank zu for saving me... {i}friend.{/i}"
    NIJAH "Danke, dass du mich gerettet hast... {i}Freund.{/i}"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:21
translate de evscr_nijah_rescue_fleecity_bf703b93:

    # NIJAH "I will pay zu back one day... If I can."
    NIJAH "Ich werde es dir eines Tages zurückzahlen... Wenn ich kann."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:22
translate de evscr_nijah_rescue_fleecity_35fc147e:

    # MC @ talk "... Take some food and gold with you at least."
    MC @ talk "... Nimm wenigstens etwas Essen und Gold mit."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:23
translate de evscr_nijah_rescue_fleecity_1fd87699:

    # "As tears began to swell in her eyes, Nijah added pitifully:"
    "Als Tränen in ihre Augen stiegen, fügte Nijah mitleiderregend hinzu:"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:25
translate de evscr_nijah_rescue_fleecity_30593b01:

    # NIJAH "You are the only Alderian to treat with kindness..."
    NIJAH "Du bist der einzige Alderianer, der mich mit Freundlichkeit behandelt hat..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:30
translate de evscr_nijah_rescue_fleecity_48f5640a:

    # "Placing the handful of gold I gave her in a small pouch with some food, Nijah tearfully waved as she headed off towards the city gate..."
    "Die Handvoll Gold, die ich ihr gegeben hatte, zusammen mit etwas Essen in einen kleinen Beutel steckend, winkte Nijah tränenreich, als sie sich auf den Weg zum Stadttor machte..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:31
translate de evscr_nijah_rescue_fleecity_a1698216:

    # "No one would stop a refugee from wanting to leave."
    "Niemand würde einen Flüchtling davon abhalten, gehen zu wollen."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:32
translate de evscr_nijah_rescue_fleecity_a1b4912b:

    # "No one would enquire or care."
    "Niemand würde nachfragen oder sich darum kümmern."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:33
translate de evscr_nijah_rescue_fleecity_e8d5fbd0:

    # "I wondered if I’d made the right choice, but in the end... it was perhaps the most sensible."
    "Ich fragte mich, ob ich die richtige Wahl getroffen hatte, aber am Ende... war es vielleicht das Vernünftigste."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:34
translate de evscr_nijah_rescue_fleecity_79d87d53:

    # "Maybe one day she’ll find a better life."
    "Vielleicht findet sie eines Tages ein besseres Leben."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:35
translate de evscr_nijah_rescue_fleecity_e141c216:

    # "Maybe one day we’ll cross paths again..."
    "Vielleicht kreuzen sich unsere Wege eines Tages wieder..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:42
translate de evscr_nijah_rescue_fleecity_c79bcb5f:

    # NIJAH "H-Huh?"
    NIJAH "H-Hä?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:43
translate de evscr_nijah_rescue_fleecity_e8d0a824:

    # NIJAH "Then what are you going to do?"
    NIJAH "Was wirst du dann tun?"

