# game/data/world_events/novaras/slime_jar/logic.rpy:20
translate de ev_slime_jar_98dac472:

    # "I could feel the slimelark shifting and moving around in the container as it bashed against the walls."
    "Ich spürte, wie der Schleimling im Behälter hin- und herglitt und -wanderte, während er gegen die Wände stieß."

# game/data/world_events/novaras/slime_jar/logic.rpy:21
translate de ev_slime_jar_1871a92c:

    # MC "(Hm... Maybe this wasn't such a good idea.)"
    MC "(Hm... Vielleicht war das doch keine so gute Idee.)"

# game/data/world_events/novaras/slime_jar/logic.rpy:22
translate de ev_slime_jar_fe1ed16e:

    # MC "(I should inspect it somewhere private.)"
    MC "(Ich sollte es irgendwo im Privaten untersuchen.)"

# game/data/world_events/novaras/slime_jar/logic.rpy:23
translate de ev_slime_jar_0f3cd446:

    # MC "(My bedroom?)"
    MC "(Mein Schlafzimmer?)"

# game/data/world_events/novaras/slime_jar/logic.rpy:31
translate de ev_slime_jar_2_6864d366:

    # "As I gently opened up the container to peer inside, the young slime slithered and moved around slowly in there, but it was clearly curious about my presence."
    "Als ich den Behälter vorsichtig öffnete, um hineinzuschauen, schlängelte sich der junge Schleim langsam umher, war aber eindeutig neugierig auf meine Anwesenheit."

# game/data/world_events/novaras/slime_jar/logic.rpy:32
translate de ev_slime_jar_2_54fc81c1:

    # MC "(Hmm... Maybe it's hungry?)"
    MC "(Hmm... Vielleicht hat es Hunger?)"

# game/data/world_events/novaras/slime_jar/logic.rpy:33
translate de ev_slime_jar_2_c3fd151d:

    # "I considered for a moment that maybe taking this creature in was a bad idea, but I had already gone this far now, and felt some responsibility for it."
    "Ich überlegte kurz, ob es vielleicht keine gute Idee gewesen war, diese Kreatur aufzunehmen, aber ich war jetzt schon so weit gegangen und fühlte mich irgendwie verantwortlich."

# game/data/world_events/novaras/slime_jar/logic.rpy:36
translate de ev_slime_jar_2_9f972684:

    # MC "(Knowing what these things eat...)"
    MC "(Wenn ich bedenke, was diese Dinger fressen...)"

# game/data/world_events/novaras/slime_jar/logic.rpy:37
translate de ev_slime_jar_2_a4c81daa:

    # MC "(Perhaps some meat?)"
    MC "(Vielleicht etwas Fleisch?)"

# game/data/world_events/novaras/slime_jar/logic.rpy:39
translate de ev_slime_jar_2_71d8c3ba:

    # MC "(Should I just try feed it some?)"
    MC "(Sollte ich einfach versuchen, ihm etwas zu füttern?)"

# game/data/world_events/novaras/slime_jar/logic.rpy:42
translate de ev_slime_jar_2_57f879d3:

    # "I have stashed the container under my bed and set out to get some meat."
    "Ich habe den Behälter unter meinem Bett verstaut und mich aufgemacht, um etwas Fleisch zu besorgen."

translate de strings:

    # game/data/world_events/novaras/slime_jar/logic.rpy:2
