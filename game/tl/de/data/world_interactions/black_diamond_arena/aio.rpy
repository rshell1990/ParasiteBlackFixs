# game/data/world_interactions/black_diamond_arena/aio.rpy:38
translate de black_diamond_arena_firstEnter_2471c171:

    # "As I stumbled down the flight of stairs, I heard the bellowing roar of cheers and something snarling down below."
    "Als ich die Treppe hinunterstolperte, hörte ich das dröhnende Gebrüll von Jubel und etwas Knurrendes von unten."

# game/data/world_interactions/black_diamond_arena/aio.rpy:39
translate de black_diamond_arena_firstEnter_1352313f:

    # "Coming upon a great darkened underground Arena, men gathered around and cheered as two reptilian beasts slashed and tore at each other in the fight pit below."
    "Als ich eine große dunkle unterirdische Arena betrat, versammelten sich Männer und jubelten, während zwei reptilienartige Bestien in der Kampfgrube unten aufeinander losgingen und sich gegenseitig zerfleischten."

# game/data/world_interactions/black_diamond_arena/aio.rpy:40
translate de black_diamond_arena_firstEnter_8b799890:

    # "The one leapt and gripped the others throat with its teeth, ripping it out in a violent bloody display that the crowd roared with pleasure too."
    "Der eine sprang und packte den anderen mit den Zähnen an der Kehle, riss sie in einer brutalen blutigen Darbietung heraus, über die die Menge ebenfalls vor Vergnügen brüllte."

# game/data/world_interactions/black_diamond_arena/aio.rpy:41
translate de black_diamond_arena_firstEnter_b2c9c7fd:

    # MC "(What is this place?)"
    MC "(Was ist das für ein Ort?)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:45
translate de black_diamond_arena_firstEnter_51fba3e4:

    # BOOKKEEPER "Oi!"
    BOOKKEEPER "Oi!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:46
translate de black_diamond_arena_firstEnter_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "Häh?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:47
translate de black_diamond_arena_firstEnter_557daccb:

    # BOOKKEEPER "Zer are no freeloaders! Either place a bet, or fuck off!"
    BOOKKEEPER "Hier gibt's keine Schmarotzer! Setz 'ne Wette, oder verpiss dich!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:48
translate de black_diamond_arena_firstEnter_fc48861a:

    # MC @ talk "A bet?"
    MC @ talk "Eine Wette?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:49
translate de black_diamond_arena_firstEnter_6faeae54:

    # BOOKKEEPER "Iz stupid or something?"
    BOOKKEEPER "Bist du blöd oder was?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:56
translate de black_diamond_bookkeeper_talk_2fb4960b:

    # BOOKKEEPER "No. You off limit. Come back in a few dayz."
    BOOKKEEPER "Nein. Du hast hier Zutrittsverbot. Komm in ein paar Tagen wieder."

# game/data/world_interactions/black_diamond_arena/aio.rpy:57
translate de black_diamond_bookkeeper_talk_615eedc7:

    # MC "Okay."
    MC "Okay."

# game/data/world_interactions/black_diamond_arena/aio.rpy:59
translate de black_diamond_bookkeeper_talk_73727c63:

    # BOOKKEEPER "Beasts fight below, you bet."
    BOOKKEEPER "Bestien kämpfen unten, du wettest."

# game/data/world_interactions/black_diamond_arena/aio.rpy:60
translate de black_diamond_bookkeeper_talk_376ff848:

    # BOOKKEEPER "Your beast wins, you get coin."
    BOOKKEEPER "Deine Bestie gewinnt, du bekommst Münzen."

# game/data/world_interactions/black_diamond_arena/aio.rpy:61
translate de black_diamond_bookkeeper_talk_cba48cb5:

    # BOOKKEEPER "Zat's it, you want bet?"
    BOOKKEEPER "Das ist es, willst du wetten?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:64
translate de black_diamond_bookkeeper_talk_menu_26b1e50b:

    # BOOKKEEPER "How much?"
    BOOKKEEPER "Wie viel?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:76
translate de black_diamond_bookkeeper_talk_menu_8a0c5ec4:

    # BOOKKEEPER "Very good!"
    BOOKKEEPER "Sehr gut!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:77
translate de black_diamond_bookkeeper_talk_menu_83429a1e:

    # BOOKKEEPER "Enjoy fight! Collect coin after if win!"
    BOOKKEEPER "Genieße den Kampf! Sammle Münzen danach, wenn du gewinnst!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:80
translate de black_diamond_bookkeeper_talk_menu_577c9037:

    # BOOKKEEPER "Rules iz simple!"
    BOOKKEEPER "Regeln sind einfach!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:81
translate de black_diamond_bookkeeper_talk_menu_824d265f:

    # BOOKKEEPER "You bet on either creature to win, first to kill zer other wins."
    BOOKKEEPER "Du wettest auf eine der Kreaturen. Die, die zuerst die andere tötet, gewinnt."

# game/data/world_interactions/black_diamond_arena/aio.rpy:82
translate de black_diamond_bookkeeper_talk_menu_ba9aaef0:

    # BOOKKEEPER "Az newbie, you iz only able to bet one thousand coins a week."
    BOOKKEEPER "Als Neuling kannst du nur eintausend Münzen pro Woche wetten."

# game/data/world_interactions/black_diamond_arena/aio.rpy:83
translate de black_diamond_bookkeeper_talk_menu_ec70c2c2:

    # BOOKKEEPER "Coin pay upfront before bet go on."
    BOOKKEEPER "Münze im Voraus zahlen, bevor die Wette beginnt."

# game/data/world_interactions/black_diamond_arena/aio.rpy:84
translate de black_diamond_bookkeeper_talk_menu_b6289d56:

    # MC @ talk "That seems odd, why the limit?"
    MC @ talk "Das kommt mir seltsam vor, warum die Begrenzung?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:85
translate de black_diamond_bookkeeper_talk_menu_40d9f557:

    # BOOKKEEPER "Too many try cheat."
    BOOKKEEPER "Zu viele versuchen zu betrügen."

# game/data/world_interactions/black_diamond_arena/aio.rpy:86
translate de black_diamond_bookkeeper_talk_menu_2ade3781:

    # BOOKKEEPER "One try poisoning a beasty and placing huge bet on other."
    BOOKKEEPER "Einer hat versucht, ein Biest zu vergiften und eine riesige Wette auf das andere zu platzieren."

# game/data/world_interactions/black_diamond_arena/aio.rpy:87
translate de black_diamond_bookkeeper_talk_menu_f8b9be59:

    # BOOKKEEPER "Now, only trusted members can make big bets."
    BOOKKEEPER "Jetzt können nur vertrauenswürdige Mitglieder große Wetten platzieren."

# game/data/world_interactions/black_diamond_arena/aio.rpy:90
translate de black_diamond_bookkeeper_talk_menu_b72566e1:

    # BOOKKEEPER "Than leave already!"
    BOOKKEEPER "Dann verschwinde schon!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:108
translate de black_diamond_arena_fight_349520bc:

    # MC "(Damn... I lost.)"
    MC "(Verdammt... ich habe verloren.)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:110
translate de black_diamond_arena_fight_3b26aa88:

    # MC "(Well... That's wasn't the easiest thing to watch.)"
    MC "(Nun... das war nicht das einfachste, was man sich ansehen kann.)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:111
translate de black_diamond_arena_fight_e66f7113:

    # MC "(Looks like I won though!)"
    MC "(Sieht aber ganz so aus, als hätte ich gewonnen!)"

