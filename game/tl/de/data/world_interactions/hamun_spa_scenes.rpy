# game/data/world_interactions/hamun_spa_scenes.rpy:364
translate de hamun_spa_tf_solo_ba0bd0dc:

    # MARBELLA "No offense, of course."
    MARBELLA "Nichts für ungut, natürlich."

# game/data/world_interactions/hamun_spa_scenes.rpy:365
translate de hamun_spa_tf_solo_2c9f3cbe:

    # NUMA "It's... complicated."
    NUMA "Es ist ... kompliziert."

# game/data/world_interactions/hamun_spa_scenes.rpy:366
translate de hamun_spa_tf_solo_a8c56fcd:

    # NUMA "Females of my species can be quite... {i}territorial.{/i}"
    NUMA "Weibchen meiner Spezies können ziemlich... {i}territorial{/i} sein."

# game/data/world_interactions/hamun_spa_scenes.rpy:367
translate de hamun_spa_tf_solo_dd2f4edf:

    # NUMA "There are all sorts of politics and things."
    NUMA "Es gibt alle möglichen politischen Dinge und so."

# game/data/world_interactions/hamun_spa_scenes.rpy:368
translate de hamun_spa_tf_solo_1b4cdd14:

    # NUMA "Me inviting another female to a {i}human{/i} bathhouse could be taken the wrong way."
    NUMA "Dass ich ein anderes Weibchen in ein {i}menschliches{/i} Badehaus einlade, könnte falsch aufgefasst werden."

# game/data/world_interactions/hamun_spa_scenes.rpy:369
translate de hamun_spa_tf_solo_92739cd6:

    # MARBELLA "So they're a bunch of bitches then?"
    MARBELLA "Also sind sie ein Haufen Zicken?"

# game/data/world_interactions/hamun_spa_scenes.rpy:370
translate de hamun_spa_tf_solo_2aeb9446:

    # "Numa laughed."
    "Numa lachte."

# game/data/world_interactions/hamun_spa_scenes.rpy:371
translate de hamun_spa_tf_solo_300b1064:

    # NUMA "I suppose they can be."
    NUMA "Ich schätze, das können sie sein."

# game/data/world_interactions/hamun_spa_scenes.rpy:372
translate de hamun_spa_tf_solo_9a73d3be:

    # MARBELLA "Ite' but then, {i}why me?{/i}"
    MARBELLA "Ite', aber dann, {i}warum ich?{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:373
translate de hamun_spa_tf_solo_86a4db16:

    # NUMA "You are different, are you not?"
    NUMA "Du bist anders, oder nicht?"

# game/data/world_interactions/hamun_spa_scenes.rpy:374
translate de hamun_spa_tf_solo_a95671b2:

    # MARBELLA "You mean, because I'm a dwarf?"
    MARBELLA "Du meinst, weil ich ein Zwerg bin?"

# game/data/world_interactions/hamun_spa_scenes.rpy:375
translate de hamun_spa_tf_solo_fb215289:

    # MARBELLA "This better not be no pity party fin girl!"
    MARBELLA "Das ist hoffentlich keine Mitleidsparty, Flossenmädchen!"

# game/data/world_interactions/hamun_spa_scenes.rpy:376
translate de hamun_spa_tf_solo_df13d749:

    # NUMA "No."
    NUMA "Nein."

# game/data/world_interactions/hamun_spa_scenes.rpy:377
translate de hamun_spa_tf_solo_b784ee76:

    # NUMA "You just understand better than the rest of them."
    NUMA "Du verstehst es einfach besser als die anderen."

# game/data/world_interactions/hamun_spa_scenes.rpy:378
translate de hamun_spa_tf_solo_2f2ec65b:

    # NUMA "{i}... And you make me laugh.{/i}"
    NUMA "{i}... Und du bringst mich zum Lachen.{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:379
translate de hamun_spa_tf_solo_3db893f8:

    # MARBELLA "Too-fucking right I do!"
    MARBELLA "Verdammt richtig, und ob!"

# game/data/world_interactions/hamun_spa_scenes.rpy:380
translate de hamun_spa_tf_solo_9fa54d39:

    # MARBELLA "...Quick question though."
    MARBELLA "...Kurze Frage allerdings."

# game/data/world_interactions/hamun_spa_scenes.rpy:381
translate de hamun_spa_tf_solo_ae2f8bb2:

    # NUMA "What's that?"
    NUMA "Was denn?"

# game/data/world_interactions/hamun_spa_scenes.rpy:382
translate de hamun_spa_tf_solo_0cd2a189:

    # MARBELLA "Whose cock is better, yer fishy men, or human?"
    MARBELLA "Wessen Schwanz ist besser, deine Fischmänner oder ein menschlicher?"

# game/data/world_interactions/hamun_spa_scenes.rpy:383
translate de hamun_spa_tf_solo_b569a7d0:

    # "Once more Numa laughed."
    "Noch einmal lachte Numa."

# game/data/world_interactions/hamun_spa_scenes.rpy:384
translate de hamun_spa_tf_solo_4a4458f6:

    # NUMA "I'll tell you the answer if you buy the food later."
    NUMA "Ich verrate dir die Antwort, wenn du später das Essen kaufst."

# game/data/world_interactions/hamun_spa_scenes.rpy:385
translate de hamun_spa_tf_solo_47a2899c:

    # MARBELLA "Bloody cheapskate!"
    MARBELLA "Verdammter Geizkragen!"

# game/data/world_interactions/hamun_spa_scenes.rpy:387
translate de hamun_spa_tf_solo_d191d93c:

    # "Reluctantly, I slipped away from the scene, careful to return back before anyone noticed I was gone."
    "Widerwillig schlüpfte ich von der Szene weg, vorsichtig darauf bedacht, zurückzukehren, bevor jemand bemerkte, dass ich weg war."

# game/data/world_interactions/hamun_spa_scenes.rpy:394
translate de hamun_spa_tf_solo_9e714d53:

    # "Kiara hummed happilly to herself as she sat, her feet in the water as she bathed herself."
    "Kiara summte glücklich vor sich hin, während sie saß, ihre Füße im Wasser, als sie sich badete."

# game/data/world_interactions/hamun_spa_scenes.rpy:395
translate de hamun_spa_tf_solo_05c5ac01:

    # KIARA "{i}O love, I swear, when the night is through,{/i}"
    KIARA "{i}O Liebe, ich schwöre, wenn die Nacht vorbei ist,{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:396
translate de hamun_spa_tf_solo_a08cc947:

    # KIARA "{i}My weary heart will return to you.{/i}"
    KIARA "{i}Mein müdes Herz wird zu dir zurückkehren.{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:397
translate de hamun_spa_tf_solo_c2afe0b4:

    # KIARA "{i}Though fate may call, I’ll fight, I’ll strive,{/i}"
    KIARA "{i}Obwohl das Schicksal ruft, werde ich kämpfen, werde ich streben,{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:398
translate de hamun_spa_tf_solo_1b8e8033:

    # KIARA "{i}For your embrace, I long to live.{/i}"
    KIARA "{i}Für deine Umarmung sehne ich mich zu leben.{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:399
translate de hamun_spa_tf_solo_ad03ac4b:

    # "Her voice is strangely hypnotic, I feel as though I could listen to her sing day and night."
    "Ihre Stimme ist seltsam hypnotisierend, ich fühle, als könnte ich ihr Tag und Nacht beim Singen zuhören."

# game/data/world_interactions/hamun_spa_scenes.rpy:400
translate de hamun_spa_tf_solo_5180c4ee:

    # "My eyes wander over her lovely body, hypnotic in the light, and reluctantly, I pull myself away from her before anyone notices I've been gone too long already."
    "Meine Augen schweifen über ihren lieblichen Körper, hypnotisch im Licht, und widerwillig reiße ich mich von ihr los, bevor jemand bemerkt, dass ich schon zu lange weg bin."

# game/data/world_interactions/hamun_spa_scenes.rpy:408
translate de hamun_spa_tf_solo_aa65a7f3:

    # "Three naked, lush bodies sat around the pool, laughing and talking as I swore I recognised one of the women."
    "Drei nackte, üppige Körper saßen um den Pool herum, lachten und redeten, während ich schwor, eine der Frauen zu erkennen."

# game/data/world_interactions/hamun_spa_scenes.rpy:409
translate de hamun_spa_tf_solo_f1ffb8e5:

    # KATIYA "So, Kala, Venya, how fares things with your husbands?"
    KATIYA "Also, Kala, Venya, wie läuft es mit euren Ehemännern?"

# game/data/world_interactions/hamun_spa_scenes.rpy:410
translate de hamun_spa_tf_solo_5f9874fb:

    # KALA "Really? You invite us out here and want to talk about those bores?"
    KALA "Wirklich? Du lädst uns hierher ein und willst über diese Langweiler reden?"

# game/data/world_interactions/hamun_spa_scenes.rpy:411
translate de hamun_spa_tf_solo_6c1b441f:

    # FAYE "Speak for yourself, Kala!"
    FAYE "Sprich für dich selbst, Kala!"

# game/data/world_interactions/hamun_spa_scenes.rpy:412
translate de hamun_spa_tf_solo_6c39586b:

    # FAYE "Just last week, my husband took me to this lord's party, and-"
    FAYE "Erst letzte Woche hat mein Mann mich zu dieser Feier des Lords mitgenommen, und-"

# game/data/world_interactions/hamun_spa_scenes.rpy:413
translate de hamun_spa_tf_solo_7a3e8808:

    # KALA "We both know what you and your husband get up to."
    KALA "Wir wissen beide, was du und dein Mann treibt."

# game/data/world_interactions/hamun_spa_scenes.rpy:414
translate de hamun_spa_tf_solo_9db14af2:

    # KALA "But if I recall, you two aren't exactly spending much time {i}together.{/i}"
    KALA "Aber wenn ich mich recht erinnere, verbringt ihr zwei nicht gerade viel Zeit {i}miteinander.{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:415
translate de hamun_spa_tf_solo_05621e5d:

    # KATIYA "Kala!"
    KATIYA "Kala!"

# game/data/world_interactions/hamun_spa_scenes.rpy:416
translate de hamun_spa_tf_solo_961f53ba:

    # FAYE "So what?"
    FAYE "Na und?"

# game/data/world_interactions/hamun_spa_scenes.rpy:417
translate de hamun_spa_tf_solo_bd4310e5:

    # FAYE "He get's what he wants and I get what I want."
    FAYE "Er bekommt, was er will, und ich bekomme, was ich will."

# game/data/world_interactions/hamun_spa_scenes.rpy:418
translate de hamun_spa_tf_solo_94179cf5:

    # FAYE "What's wrong with that?"
    FAYE "Was ist daran falsch?"

# game/data/world_interactions/hamun_spa_scenes.rpy:419
translate de hamun_spa_tf_solo_a5aaa31e:

    # FAYE "And you can hardly talk, when was the last time you and your husband... {i}you know.{/i}"
    FAYE "Und du kannst kaum reden, wann war das letzte Mal, dass du und dein Mann... {i}du weißt schon.{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:420
translate de hamun_spa_tf_solo_d9071032:

    # KALA "Don't remind me."
    KALA "Erinnere mich nicht daran."

# game/data/world_interactions/hamun_spa_scenes.rpy:421
translate de hamun_spa_tf_solo_d4b6a322:

    # KALA "I think soon I might need to... {i}find other solutions,{/i} if he doesn't do SOMETHING soon."
    KALA "Ich glaube, bald muss ich vielleicht... {i}andere Lösungen finden,{/i} wenn er nicht bald ETWAS tut."

# game/data/world_interactions/hamun_spa_scenes.rpy:422
translate de hamun_spa_tf_solo_1026a768:

    # KALA "How long is someone supposed to suffer?"
    KALA "Wie lange soll jemand leiden?"

# game/data/world_interactions/hamun_spa_scenes.rpy:423
translate de hamun_spa_tf_solo_762a8ea5:

    # KATIYA "Wait, you're thinking about having an affair?!"
    KATIYA "Warte, denkst du etwa an eine Affäre?!"

# game/data/world_interactions/hamun_spa_scenes.rpy:424
translate de hamun_spa_tf_solo_76fea7d9:

    # KALA "What else am I supposed to do at this point?"
    KALA "Was soll ich an diesem Punkt sonst machen?"

# game/data/world_interactions/hamun_spa_scenes.rpy:425
translate de hamun_spa_tf_solo_6a4a701f:

    # KALA "Divorce is out of the question, our families would kill us..."
    KALA "Eine Scheidung kommt nicht in Frage, unsere Familien würden uns umbringen..."

# game/data/world_interactions/hamun_spa_scenes.rpy:426
translate de hamun_spa_tf_solo_66bb0a60:

    # FAYE "What about you, Katiya?"
    FAYE "Und du, Katiya?"

# game/data/world_interactions/hamun_spa_scenes.rpy:427
translate de hamun_spa_tf_solo_bffa51bb:

    # FAYE "Is there a special someone in your life?"
    FAYE "Gibt es da jemand Besonderen in deinem Leben?"

# game/data/world_interactions/hamun_spa_scenes.rpy:428
translate de hamun_spa_tf_solo_410ed763:

    # KATIYA "Haha, I am far too busy for such things."
    KATIYA "Haha, ich bin viel zu beschäftigt für so etwas."

# game/data/world_interactions/hamun_spa_scenes.rpy:429
translate de hamun_spa_tf_solo_5f389d89:

    # FAYE "Booo.... BOOOO!"
    FAYE "Buuuh... BUUUH!"

# game/data/world_interactions/hamun_spa_scenes.rpy:430
translate de hamun_spa_tf_solo_0c43ccf2:

    # KALA "There must be one man in this city who catches your eye."
    KALA "Es muss einen Mann in dieser Stadt geben, der dir ins Auge fällt."

# game/data/world_interactions/hamun_spa_scenes.rpy:431
translate de hamun_spa_tf_solo_6f15ab10:

    # KATIYA "W-Well..."
    KATIYA "N-Nun ..."

# game/data/world_interactions/hamun_spa_scenes.rpy:432
translate de hamun_spa_tf_solo_54a356e5:

    # KATIYA "I did see one man recently."
    KATIYA "Ich habe kürzlich tatsächlich einen Mann gesehen."

# game/data/world_interactions/hamun_spa_scenes.rpy:433
translate de hamun_spa_tf_solo_635f61e7:

    # FAYE "Ooooh! Tell us everything!"
    FAYE "Ooooh! Erzähl uns alles!"

# game/data/world_interactions/hamun_spa_scenes.rpy:434
translate de hamun_spa_tf_solo_82229c32:

    # KATIYA "Haha, there's not much to tell... He came into my store and he was just very handsome."
    KATIYA "Haha, es gibt nicht viel zu erzählen ... Er kam in meinen Laden und er war einfach sehr gutaussehend."

# game/data/world_interactions/hamun_spa_scenes.rpy:435
translate de hamun_spa_tf_solo_ab1816c0:

    # KALA "And you're hoping he comes back?"
    KALA "Und du hoffst, dass er wiederkommt?"

# game/data/world_interactions/hamun_spa_scenes.rpy:436
translate de hamun_spa_tf_solo_a7dc8e2d:

    # KATIYA "I... {i}wouldn't say no to seeing him again.{/i}"
    KATIYA "Ich... {i}würde nicht nein sagen, ihn wiederzusehen.{/i}"

# game/data/world_interactions/hamun_spa_scenes.rpy:438
translate de hamun_spa_tf_solo_8ab2beba:

    # "The women continued to giggle and chatter."
    "Die Frauen kicherten und plauderten weiter."

# game/data/world_interactions/hamun_spa_scenes.rpy:440
translate de hamun_spa_tf_solo_3d01252f:

    # "Deciding I had seen enough, I turned to leave before anyone realized I'd been away for too long."
    "Da ich beschloss, genug gesehen zu haben, drehte ich mich um, um zu gehen, bevor jemand bemerkte, dass ich zu lange weggewesen war."

