    DARK_MAGE "Warum, wofür denn?"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:101
translate de qst_guild_darkmage_wall_enter_menu_193437d2:

    # DARK_MAGE "With my creations, we may finally be able to start winning this war!"
    DARK_MAGE "Mit meinen Kreationen könnten wir diesen Krieg endlich gewinnen!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:102
translate de qst_guild_darkmage_wall_enter_menu_2005edc7:

    # MC @ angry "What in all of the names of the gods are you talking about?"
    MC @ angry "Was in aller Götter Namen redest du da?"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:103
translate de qst_guild_darkmage_wall_enter_menu_b0cc10b3_1:

    # DARK_MAGE "{i}Camen! Come!{/i}"
    DARK_MAGE "{i}Camen! Komm!{/i}"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:105
translate de qst_guild_darkmage_wall_enter_menu_bedd8dbf:

    # DARK_MAGE "Ooooh! I see!"
    DARK_MAGE "Ooooh! Ich verstehe!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:106
translate de qst_guild_darkmage_wall_enter_menu_abb8d959:

    # DARK_MAGE "You're here to steal my research!"
    DARK_MAGE "Du bist hier, um meine Forschung zu stehlen!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:107
translate de qst_guild_darkmage_wall_enter_menu_7eb01417:

    # DARK_MAGE "Well you can't have it! IT'S MINE!"
    DARK_MAGE "Du kannst sie nicht haben! SIE GEHÖRT MIR!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:108
translate de qst_guild_darkmage_wall_enter_menu_770920f3:

    # DARK_MAGE "With it, I'll be able to finally win this war and they'll recognize my work for the heroism it deserves!"
    DARK_MAGE "Damit werde ich endlich diesen Krieg gewinnen können, und sie werden meine Arbeit für den Heldenmut anerkennen, den sie verdient!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:109
translate de qst_guild_darkmage_wall_enter_menu_ce472ad7:

    # MC @ angry "You're gutting women like fish ... What 'heroism' is there to recognize here you lunatic?"
    MC @ angry "Du weidest Frauen aus wie Fische ... Welcher 'Heldenmut' gibt es hier zu erkennen, du Wahnsinniger?"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:110
translate de qst_guild_darkmage_wall_enter_menu_671136e8:

    # DARK_MAGE "HO HO HO!"
    DARK_MAGE "HO HO HO!"

