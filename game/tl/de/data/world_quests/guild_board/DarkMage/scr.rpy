    DARKMAGE_WALL_FACE @ talk "Drei Rätsel sind der Schlüssel zum Durchgang jenseits dieses Schleiers."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:47
translate de qst_guild_darkmage_shelf_click_88ad74f0:

    # DARKMAGE_WALL_FACE @ talk "For each wrong you give, in blood shall you pay."
    DARKMAGE_WALL_FACE @ talk "Für jede falsche Antwort bezahlst du mit Blut."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:69
translate de qst_guild_darkmage_riddle_wrong_answer_8c9dfcdc:

    # "A bolt of lightning from the faces' eyes painfully zapped at me before dispersing."
    "Ein Blitz aus den Augen der Gesichter traf mich schmerzhaft, bevor er sich auflöste."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:70
translate de qst_guild_darkmage_riddle_wrong_answer_59e799f7:

