translate de qst_guild_price_life_daughter_start_64373531:

    # MC "{b}Would you like to resume negotiations?{/b}"
    MC "{b}Möchten Sie die Verhandlungen wiederaufnehmen?{/b}"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:57
translate de qst_guild_price_life_daughter_start_bac28c56:

    # "The fumbling leader of the marauders mumbled yes as he stared up and down horrified at the creature before him."
    "Der tollpatschige Anführer der Marodeure murmelte ja, während er entsetzt das Geschöpf vor ihm von oben bis unten anstarrte."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:66
