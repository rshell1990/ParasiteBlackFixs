translate de qst_guild_price_life_daughter_negotiate_c70bdcd9:

    # MARAUDER_LEADER "Piss off! I'm better off trying to sell her to the Greater trading company!"
    MARAUDER_LEADER "Verpiss dich! Ich versuch's lieber, sie an die Greater Trading Company zu verkaufen!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:88
translate de qst_guild_price_life_daughter_negotiate_12c9101e:

    # MARAUDER_LEADER "Hmm ... I suppose after all the trouble she's caused, the sooner I get her out of my hands, the better."
