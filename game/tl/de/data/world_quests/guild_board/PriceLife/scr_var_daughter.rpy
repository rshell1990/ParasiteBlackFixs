    CALLIE @ sad "Ich werde es nicht! ICH WERDE ES NICHT!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:140
translate de qst_guild_price_life_daughter_kidnappers_leave_ba7415b1:

    # CALLIE @ sad "I promise!"
    CALLIE @ sad "Ich verspreche es!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:141
translate de qst_guild_price_life_daughter_kidnappers_leave_905b7fc4:

    # "I sighed, having the briefest dark thought about killing the girl to keep my secret, but..."
    "Ich seufzte, hatte den flüchtigsten düsteren Gedanken, das Mädchen zu töten, um mein Geheimnis zu bewahren, aber ..."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:142
translate de qst_guild_price_life_daughter_kidnappers_leave_fa0aa388:

    # "{i}No, I couldn't.{/i}"
    "{i}Nein, das konnte ich nicht.{/i}"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:143
translate de qst_guild_price_life_daughter_kidnappers_leave_30444804:

    # "Morality aside, the last thing I needed was some merchant lord investigating his daughter's death and raising hell on the matter."
    "Moral beiseite, das Letzte, was ich brauchte, war, dass irgendein Handelsherr den Tod seiner Tochter untersuchte und deswegen die Hölle losmachte."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:144
translate de qst_guild_price_life_daughter_kidnappers_leave_a28ecfd1:

    # "{i}Even more eyes on all this was the last thing I needed.{/i}"
    "{i}Noch mehr Augen auf all das war das Letzte, was ich brauchte.{/i}"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:145
translate de qst_guild_price_life_daughter_kidnappers_leave_82bda708:

    # CALLIE @ sad "... I... I presume father sent you then?"
    CALLIE @ sad "... Ich ... ich nehme an, Vater hat dich dann geschickt?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:146
translate de qst_guild_price_life_daughter_kidnappers_leave_60a8e8e8:

    # CALLIE "My name is Callie."
    CALLIE "Mein Name ist Callie."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:148
translate de qst_guild_price_life_daughter_kidnappers_leave_0f35b04d:

    # CALLIE " {i}... What are you?{/i}"
    CALLIE "{i}... Was bist du?{/i}"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:149
translate de qst_guild_price_life_daughter_kidnappers_leave_25ec6b4d:

    # MC "That doesn't matter, what matters is we get you home."
    MC "Das spielt keine Rolle, wichtig ist, dass wir dich nach Hause bringen."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:150
translate de qst_guild_price_life_daughter_kidnappers_leave_6917fd49:

    # "Callie nodded."
    "Callie nickte."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:151
translate de qst_guild_price_life_daughter_kidnappers_leave_cc11e025:

    # CALLIE "Yes, I think I've had quite enough 'adventure' recently."
    CALLIE "Ja, ich glaube, ich hatte in letzter Zeit genug 'Abenteuer'."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:152
translate de qst_guild_price_life_daughter_kidnappers_leave_8fa1d149:

