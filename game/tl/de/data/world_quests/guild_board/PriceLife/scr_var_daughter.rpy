translate de qst_guild_price_life_daughter_threaten_2b17c70f:

    # "There was some grumbling from the rest of the marauders, but none of them dared to speak up."
    "Es gab einiges Gemurre von den übrigen Marodeuren, aber keiner von ihnen wagte es, etwas zu sagen."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:76
translate de qst_guild_price_life_daughter_threaten_2d9bb792:

    # MC "Release the girl ... {i}Now.{/i}"
    MC "Lasst das Mädchen frei ... {i}Sofort.{/i}"

