translate de qst_guild_price_life_daughter_kidnappers_leave_d88d0d94:

    # "The katai blushed, nodding as she stared me up and down."
    "Die katai errötete und nickte, während sie mich von oben bis unten musterte."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:138
translate de qst_guild_price_life_daughter_kidnappers_leave_ed0f8e0e:

