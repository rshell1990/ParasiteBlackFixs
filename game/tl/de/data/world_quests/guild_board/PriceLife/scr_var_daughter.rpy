    MARAUDER_LEADER "Also gut, gib uns die Münzen und sie gehört dir."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:93
translate de qst_guild_price_life_daughter_negotiate_41bd92a2:

    # "Throwing over the bags filled with coin, the gang grinned as they inspected the coins inside, nodding with approval to their leader that it was all there."
