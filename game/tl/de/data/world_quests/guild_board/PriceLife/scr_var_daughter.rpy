# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:4
translate de qst_guild_price_life_daughter_start_345114d3:

    # "Following the instructions left by both the Merchant and the marauders ransom note, I headed East towards the forests."
    "Den Anweisungen folgend, die sowohl der Händler als auch die Lösegeldforderung der Marodeure hinterlassen hatten, machte ich mich auf den Weg nach Osten in die Wälder."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:8
translate de qst_guild_price_life_daughter_start_b904e1a2:

    # "Deep into the woods after several hours of travel, I stumbled into the marauders camp, where the Merchants daughter, a feline looking humanoid, was held captive in a cage."
    "Tief im Wald, nach mehreren Stunden Reise, stolperte ich in das Lager der Marodeure, wo die Tochter des Händlers, eine katzenartig aussehende Humanoide, in einem Käfig gefangen gehalten wurde."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:14
translate de qst_guild_price_life_daughter_start_d5a2cd76:

    # MARAUDER_LEADER "About time one of you showed up."
    MARAUDER_LEADER "Es wurde auch Zeit, dass einer von euch auftaucht."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:15
translate de qst_guild_price_life_daughter_start_79ae2277:

    # MARAUDER_LEADER "You here for the girl then?"
    MARAUDER_LEADER "Du bist also wegen des Mädchens hier?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:16
translate de qst_guild_price_life_daughter_start_cefa4cbb:

    # MC @ talk "I am. Is she unharmed?"
    MC @ talk "Bin ich. Ist sie unversehrt?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:17
translate de qst_guild_price_life_daughter_start_72957a32:

    # MARAUDER_LEADER "Ask her yourself."
    MARAUDER_LEADER "Frag sie selbst."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:18
translate de qst_guild_price_life_daughter_start_be6599fc:

    # "The marauder turned back towards the girl trapped in her cage."
    "Der Marodeur wandte sich wieder dem Mädchen zu, das in ihrem Käfig gefangen war."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:20
translate de qst_guild_price_life_daughter_start_efea22f5:

    # MARAUDER_LEADER "OI! YOU'RE FINE AREN'T YOU GIRL?"
    MARAUDER_LEADER "HEY! DIR GEHT'S DOCH GUT, ODER, MÄDCHEN?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:21
translate de qst_guild_price_life_daughter_start_b822ae60:

    # "The katai growled from her cage."
    "Die Katai knurrte aus ihrem Käfig."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:22
translate de qst_guild_price_life_daughter_start_b4dbb2c8:

    # CALLIE "Release me now! Or else my father will-"
    CALLIE "Lasst mich sofort frei! Oder mein Vater wird-"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:23
translate de qst_guild_price_life_daughter_start_48f4a742:

    # MARAUDER_LEADER "SHUT IT CUNT!"
    MARAUDER_LEADER "HALT DIE KLAPPE, FOTZE!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:25
translate de qst_guild_price_life_daughter_start_bc5fa8ed:

    # MARAUDER_LEADER "... See? She's fine, mouthy as ever ... Now, onto business then."
    MARAUDER_LEADER "... Siehst du? Sie ist in Ordnung, so großmäulig wie immer ... Jetzt zum Geschäft."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:26
translate de qst_guild_price_life_daughter_start_9f35492d:

    # MARAUDER_LEADER "Did you bring the coin?"
    MARAUDER_LEADER "Hast du das Geld mitgebracht?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:27
translate de qst_guild_price_life_daughter_start_b628b1a8:

    # MC @ talk "I did."
    MC @ talk "Hab ich."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:28
translate de qst_guild_price_life_daughter_start_1d8e510d:

    # "The Marauder leader smiled."
    "Der Anführer der Plünderer lächelte."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:29
translate de qst_guild_price_life_daughter_start_b9fb7973:

    # MARAUDER_LEADER "Well then, this is just perfect."
    MARAUDER_LEADER "Nun denn, das ist einfach perfekt."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:30
translate de qst_guild_price_life_daughter_start_d2f11601:

    # MARAUDER_LEADER "What's to stop me just killing you, keeping the ransom coin for ourselves and selling this little slut off as a slave?"
    MARAUDER_LEADER "Was hält mich davon ab, dich einfach zu töten, das Lösegeld für uns zu behalten und diese kleine Schlampe als Sklavin zu verkaufen?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:31
translate de qst_guild_price_life_daughter_start_c8195006:

    # MARAUDER_LEADER "We outnumber you three to one."
    MARAUDER_LEADER "Wir sind dir zahlenmäßig drei zu eins überlegen."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:34
translate de qst_guild_price_life_daughter_start_721fefca:

    # MARAUDER_LEADER "HA! I'll take my chances!"
    MARAUDER_LEADER "HA! Ich riskiere es!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:35
translate de qst_guild_price_life_daughter_start_007cc25b:

    # MARAUDER_LEADER "Now drop the sword."
    MARAUDER_LEADER "Jetzt lass das Schwert fallen."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:36
translate de qst_guild_price_life_daughter_start_7d5e397b:

    # "The leader whistled and pointed at one of the men, who moved to place a blade towards the girl in the cage."
    "Der Anführer pfiff und deutete auf einen der Männer, der sich bewegte, um eine Klinge auf das Mädchen im Käfig zu richten."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:37
translate de qst_guild_price_life_daughter_start_f7c121b5:

    # CALLIE "P-PLEASE DON'T KILL ME!"
    CALLIE "B-BITTE TÖTET MICH NICHT!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:38
translate de qst_guild_price_life_daughter_start_bc4faf8e:

    # MC @ angry "(Fuck.)"
    MC @ angry "(Verdammt.)"

