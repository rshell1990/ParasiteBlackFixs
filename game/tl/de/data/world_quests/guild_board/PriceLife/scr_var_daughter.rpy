translate de qst_guild_price_life_daughter_start_c24aa716:

    # MC @ angry "(I can't just drop my blade, but if I don't, they'll just kill the girl!)"
    MC @ angry "(Ich kann meine Klinge nicht einfach fallen lassen, aber wenn ich es nicht tue, werden sie das Mädchen einfach töten!)"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:40
translate de qst_guild_price_life_daughter_start_6ee558b5:

    # MARAUDER_LEADER "What are you waiting for, boy?"
    MARAUDER_LEADER "Worauf wartest du, Junge?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:41
translate de qst_guild_price_life_daughter_start_c1284482:

    # MARAUDER_LEADER "DROP IT!"
    MARAUDER_LEADER "LASS ES FALLEN!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:42
translate de qst_guild_price_life_daughter_start_d8a8d0cf:

    # MC @ angry "(Fuck, I can't believe I'm going to do this!)"
    MC @ angry "(Verdammt, ich kann nicht glauben, dass ich das tun werde!)"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:49
translate de qst_guild_price_life_daughter_start_efd0e7b1:

    # "Stepping a few feet away from the Marauders, their eyes widened in horror as I tore at my own flesh, revealing the monstrous form beneath."
    "Als ich ein paar Schritte von den Marodeuren entfernt trat, weiteten sich ihre Augen entsetzt, als ich an meinem eigenen Fleisch riss und die monströse Gestalt darunter enthüllte."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:55
translate de qst_guild_price_life_daughter_start_1407cf85:

    # MARAUDER_LEADER "WHAT THE FUCK?!"
    MARAUDER_LEADER "WAS ZUM TEUFEL?!"

