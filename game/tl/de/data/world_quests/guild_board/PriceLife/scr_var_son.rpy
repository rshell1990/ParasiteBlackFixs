    MARAUDER_LEADER "Aw! Scheiß drauf!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:129
translate de qst_guild_price_life_son_kidnappers_leave_6dfc0395:

    # "The kidnappers said nothing else, moving quickly to pack up what they could before hurrying off in the opposite direction."
    "Die Entführer sagten nichts weiter, packten schnell zusammen, was sie konnten, und hasteten dann in die entgegengesetzte Richtung davon."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:134
translate de qst_guild_price_life_son_kidnappers_leave_6d52e8b8:

    # MC "Are you okay?"
    MC "Geht es dir gut?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:135
translate de qst_guild_price_life_son_kidnappers_leave_0858a352:

    # "The katai blushed, nodding as he stared me up and down."
    "Der Katai errötete und nickte, während er mich von oben bis unten musterte."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:136
translate de qst_guild_price_life_son_kidnappers_leave_ed0f8e0e:

    # MC "If you tell anyone what you've seen-"
    MC "Wenn du irgendjemandem erzählst, was du gesehen hast-"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:137
translate de qst_guild_price_life_son_kidnappers_leave_cf84f358:

    # TRAYAN @ sad "I won't! I WON'T!"
    TRAYAN @ sad "Das werde ich nicht! ICH WERDE ES NICHT!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:138
translate de qst_guild_price_life_son_kidnappers_leave_5bc59883:

    # TRAYAN @ sad "I promise!"
    TRAYAN @ sad "Ich verspreche es!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:139
translate de qst_guild_price_life_son_kidnappers_leave_b298c5ee:

    # "I sighed, having the briefest dark thought about killing the boy to keep my secret, but..."
    "Ich seufzte und hatte den kürzesten dunklen Gedanken, den Jungen zu töten, um mein Geheimnis zu wahren, aber..."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:140
translate de qst_guild_price_life_son_kidnappers_leave_fa0aa388:

    # "{i}No, I couldn't.{/i}"
    "{i}Nein, das könnte ich nicht.{/i}"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:141
translate de qst_guild_price_life_son_kidnappers_leave_621d3217:

    # "Morality aside, the last thing I needed was some merchant lord investigating his son's death and raising hell on the matter."
    "Von Moral mal abgesehen, das Letzte, was ich brauchte, war, dass irgendein Handelsherr den Tod seines Sohnes untersucht und deswegen die Hölle losmacht."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:142
translate de qst_guild_price_life_son_kidnappers_leave_a28ecfd1:

    # "{i}Even more eyes on all this was the last thing I needed.{/i}"
    "{i}Noch mehr Augen auf all das war das Letzte, was ich brauchte.{/i}"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:143
translate de qst_guild_price_life_son_kidnappers_leave_4edf36c6:

    # TRAYAN @ sad "...D-Did my father send you?"
    TRAYAN @ sad "...H-Hat mein Vater dich geschickt?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:144
translate de qst_guild_price_life_son_kidnappers_leave_ca479905:

    # TRAYAN "My name is Trayan."
    TRAYAN "Mein Name ist Trayan."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:146
translate de qst_guild_price_life_son_kidnappers_leave_27ddc8a8:

    # TRAYAN " {i}... What are you?{/i}"
    TRAYAN "{i}... Was bist du?{/i}"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:147
translate de qst_guild_price_life_son_kidnappers_leave_25ec6b4d:

    # MC "That doesn't matter, what matters is we get you home."
    MC "Das spielt keine Rolle, wichtig ist, dass wir dich nach Hause bringen."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:148
translate de qst_guild_price_life_son_kidnappers_leave_2b113eda:

    # "Trayan gulped and nodded anxiously."
    "Trayan schluckte und nickte ängstlich."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:149
translate de qst_guild_price_life_son_kidnappers_leave_ce53b364:

    # TRAYAN "Y-Yes, of course."
    TRAYAN "J-Ja, natürlich."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:150
translate de qst_guild_price_life_son_kidnappers_leave_ab55578a:

    # TRAYAN "Lead the way."
    TRAYAN "Geh voran."

