translate de qst_guild_price_life_son_offer_own_money_86c25f6b:

    # MARAUDER_LEADER "Heh heh! Glad to see you've come to your senses!"
    MARAUDER_LEADER "Heh heh! Schön, dass du zur Vernunft gekommen bist!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:110
translate de qst_guild_price_life_son_offer_own_money_5132ac66:

    # MC "Release the boy, and the coin is yours."
    MC "Lass den Jungen frei, und das Geld gehört dir."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:111
translate de qst_guild_price_life_son_offer_own_money_3b1f0187:

    # "Grinning, the marauder whistled as the cage was opened, and the boy sheepishly scurried out to hide behind me."
    "Grinsend pfiff der Plünderer, als der Käfig geöffnet wurde, und der Junge huschte verlegen heraus, um sich hinter mir zu verstecken."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:112
translate de qst_guild_price_life_son_offer_own_money_a5cbd40d:

    # MARAUDER_LEADER "Now, hand over the coin."
    MARAUDER_LEADER "Jetzt übergib die Münze."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:117
translate de qst_guild_price_life_son_offer_own_money_41bd92a2:

    # "Throwing over the bags filled with coin, the gang grinned as they inspected the coins inside, nodding with approval to their leader that it was all there."
    "Als sie die mit Münzen gefüllten Beutel hinüberwarfen, grinste die Bande, während sie die Münzen darin prüften und ihrem Anführer mit einem zustimmenden Nicken signalisierten, dass alles da war."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:118
translate de qst_guild_price_life_son_offer_own_money_be18cf29:

    # MARAUDER_LEADER "Pleasure doing business with you."
    MARAUDER_LEADER "Freut mich, mit dir Geschäfte zu machen."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:122
translate de qst_guild_price_life_son_offer_own_money_25312e44:

    # MARAUDER_LEADER "We had a fucking deal!"
    MARAUDER_LEADER "Wir hatten einen verdammten Deal!"

