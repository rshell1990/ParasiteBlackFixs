translate de qst_guild_price_life_son_done_talking_4c12d3a5:

    # MARAUDER_LEADER "BOYS! DRAW YOUR BLADES!"
    MARAUDER_LEADER "JUNGS! ZIEHT EURE KLINGEN!"

