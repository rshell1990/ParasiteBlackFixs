# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:4
translate de qst_guild_price_life_son_start_345114d3:

    # "Following the instructions left by both the Merchant and the marauders ransom note, I headed East towards the forests."
    "Den Anweisungen, die sowohl der Händler als auch die Lösegeldforderung der Plünderer hinterlassen hatten, folgend, machte ich mich auf den Weg nach Osten in Richtung der Wälder."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:8
translate de qst_guild_price_life_son_start_1240d067:

    # "Deep into the woods after several hours of travel, I stumbled into the marauders camp, where the Merchants son, a feline looking humanoid, was held captive in a cage."
    "Tief im Wald, nach mehreren Stunden Reise, stieß ich auf das Lager der Plünderer, wo der Sohn des Händlers, ein katzenartiger Humanoid, in einem Käfig gefangen gehalten wurde."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:14
translate de qst_guild_price_life_son_start_d5a2cd76:

    # MARAUDER_LEADER "About time one of you showed up."
    MARAUDER_LEADER "Es wurde auch Zeit, dass einer von euch auftaucht."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:15
translate de qst_guild_price_life_son_start_bf7565b1:

    # MARAUDER_LEADER "You here for the boy then?"
    MARAUDER_LEADER "Sie sind also wegen des Jungen hier?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:16
translate de qst_guild_price_life_son_start_797eb940:

    # MC @ talk "I am. Is he unharmed?"
    MC @ talk "Das bin ich. Ist er unverletzt?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:17
translate de qst_guild_price_life_son_start_8cddc005:

    # MARAUDER_LEADER "Ask him yourself."
    MARAUDER_LEADER "Fragen Sie ihn selbst."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:18
translate de qst_guild_price_life_son_start_ad676679:

    # "The marauder turned back towards the boy trapped in his cage."
    "Der Plünderer drehte sich zu dem Jungen um, der in seinem Käfig gefangen war."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:20
translate de qst_guild_price_life_son_start_bb83fc3c:

    # MARAUDER_LEADER "OI! YOU'RE FINE AREN'T YOU BOY?"
    MARAUDER_LEADER "HE! DIR GEHT'S DOCH GUT, ODER NICHT, JUNGE?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:21
translate de qst_guild_price_life_son_start_130b5b72:

    # "The katai meekly nodded, but I noticed a few darkened bruises around his body."
    "Der Katai nickte zaghaft, doch ich bemerkte einige dunkle blaue Flecken an seinem Körper."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:23
translate de qst_guild_price_life_son_start_7f9b2145:

    # MARAUDER_LEADER "See? He's fine... Now, onto business then."
    MARAUDER_LEADER "Sehen Sie? Er ist in Ordnung... Nun, dann zum Geschäft."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:24
translate de qst_guild_price_life_son_start_9f35492d:

    # MARAUDER_LEADER "Did you bring the coin?"
    MARAUDER_LEADER "Hast du die Münze mitgebracht?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:25
translate de qst_guild_price_life_son_start_b628b1a8:

    # MC @ talk "I did."
    MC @ talk "Hab ich."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:26
translate de qst_guild_price_life_son_start_1d8e510d:

    # "The Marauder leader smiled."
    "Der Anführer der Marodeure lächelte."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:27
translate de qst_guild_price_life_son_start_b9fb7973:

    # MARAUDER_LEADER "Well then, this is just perfect."
    MARAUDER_LEADER "Nun, das ist einfach perfekt."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:28
translate de qst_guild_price_life_son_start_d067d3c1:

    # MARAUDER_LEADER "What's to stop me just killing you, keeping the ransom coin for ourselves and selling this little cunt off as a slave?"
    MARAUDER_LEADER "Was hält mich davon ab, dich einfach zu töten, das Lösegeld für uns zu behalten und diese kleine Fotze als Sklavin zu verkaufen?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:29
translate de qst_guild_price_life_son_start_c8195006:

    # MARAUDER_LEADER "We outnumber you three to one."
    MARAUDER_LEADER "Wir sind euch drei zu eins überlegen."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:32
translate de qst_guild_price_life_son_start_721fefca:

    # MARAUDER_LEADER "HA! I'll take my chances!"
    MARAUDER_LEADER "HA! Ich riskier's!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:33
translate de qst_guild_price_life_son_start_007cc25b:

    # MARAUDER_LEADER "Now drop the sword."
    MARAUDER_LEADER "Jetzt lass das Schwert fallen."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:34
translate de qst_guild_price_life_son_start_b87ea3bf:

    # "The leader whistled and pointed at one of the men, who moved to place a blade towards the boy in the cage."
    "Der Anführer pfiff und zeigte auf einen der Männer, der daraufhin eine Klinge auf den Jungen im Käfig richtete."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:35
translate de qst_guild_price_life_son_start_f0c18936:

    # "He could only whimper and cry from his confinement, pleading for his life."
    "Er konnte nur winseln und weinen in seinem Gefängnis, um sein Leben flehen."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:36
translate de qst_guild_price_life_son_start_bc4faf8e:

    # MC @ angry "(Fuck.)"
    MC @ angry "(Scheiße.)"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:37
translate de qst_guild_price_life_son_start_b1e01235:

    # MC @ angry "(I can't just drop my blade, but if I don't, they'll just kill the boy!)"
    MC @ angry "(Ich kann meine Klinge nicht einfach fallen lassen, aber wenn ich es nicht tue, werden sie den Jungen einfach töten!)"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:38
translate de qst_guild_price_life_son_start_6ee558b5:

    # MARAUDER_LEADER "What are you waiting for, boy?"
    MARAUDER_LEADER "Worauf wartest du, Junge?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:39
translate de qst_guild_price_life_son_start_c1284482:

    # MARAUDER_LEADER "DROP IT!"
    MARAUDER_LEADER "LASS ES FALLEN!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:40
translate de qst_guild_price_life_son_start_d8a8d0cf:

    # MC @ angry "(Fuck, I can't believe I'm going to do this!)"
    MC @ angry "(Scheiße, ich kann nicht glauben, dass ich das tun werde!)"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:47
translate de qst_guild_price_life_son_start_efd0e7b1:

    # "Stepping a few feet away from the Marauders, their eyes widened in horror as I tore at my own flesh, revealing the monstrous form beneath."
    "Als ich ein paar Schritte von den Plünderern zurücktrat, weiteten sich ihre Augen vor Entsetzen, als ich mein eigenes Fleisch aufriss und die monströse Gestalt darunter zum Vorschein brachte."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:53
translate de qst_guild_price_life_son_start_1407cf85:

    # MARAUDER_LEADER "WHAT THE FUCK?!"
    MARAUDER_LEADER "WAS ZUM TEUFEL?!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:54
translate de qst_guild_price_life_son_start_64373531:

    # MC "{b}Would you like to resume negotiations?{/b}"
    MC "{b}Möchten Sie die Verhandlungen wieder aufnehmen?{/b}"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:55
translate de qst_guild_price_life_son_start_bac28c56:

    # "The fumbling leader of the marauders mumbled yes as he stared up and down horrified at the creature before him."
    "Der unbeholfene Anführer der Plünderer murmelte ja, während er entsetzt die Kreatur vor ihm von oben bis unten anstarrte."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:64
translate de qst_guild_price_life_son_threaten_72cfa3d5:

    # MARAUDER_LEADER "... Fuck off!"
    MARAUDER_LEADER "... Verpiss dich!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:65
translate de qst_guild_price_life_son_threaten_426baa97:

    # MARAUDER_LEADER "You think we're just going to walk away from here with nothing after risking our necks?!"
    MARAUDER_LEADER "Du denkst, wir gehen einfach mit nichts hier weg, nachdem wir unseren Hals riskiert haben?!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:68
translate de qst_guild_price_life_son_threaten_cf373bd0:

    # MARAUDER_LEADER "What? F-fuck..."
    MARAUDER_LEADER "Was? S-scheiße..."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:72
translate de qst_guild_price_life_son_threaten_01bba6d6:

    # MARAUDER_LEADER "...Boys, let's uh ... Let's go."
    MARAUDER_LEADER "...Jungs, lasst uns äh... Lasst uns gehen."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:73
translate de qst_guild_price_life_son_threaten_2b17c70f:

    # "There was some grumbling from the rest of the marauders, but none of them dared to speak up."
    "Es gab ein Murren von den übrigen Marodeuren, aber keiner von ihnen wagte es, etwas zu sagen."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:74
translate de qst_guild_price_life_son_threaten_5eba6441:

    # MC "Release the boy ... {i}Now.{/i}"
    MC "Lasst den Jungen frei ... {i}Jetzt.{/i}"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:75
translate de qst_guild_price_life_son_threaten_8b1d0d51:

    # "Letting the Merchant's son out of the cage, he sheepishly hurried to hide behind me."
    "Man ließ den Sohn des Händlers aus dem Käfig, und er eilte verlegen, um sich hinter mir zu verstecken."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:76
translate de qst_guild_price_life_son_threaten_a6b2f2ca:

    # MC "... Now leave."
    MC "... Jetzt geht."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:80
translate de qst_guild_price_life_son_negotiate_a85a5ce0:

    # MARAUDER_LEADER "... Is this a fucking joke?"
    MARAUDER_LEADER "... Soll das ein verdammter Witz sein?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:82
translate de qst_guild_price_life_son_negotiate_cbede69b:

    # MARAUDER_LEADER "Half? {i}Fucking half!{/i}"
    MARAUDER_LEADER "Die Hälfte? {i}Die verdammte Hälfte!{/i}"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:83
translate de qst_guild_price_life_son_negotiate_4c65ccf0:

    # MARAUDER_LEADER "Piss off! I'm better off trying to sell him to the Greater trading company!"
    MARAUDER_LEADER "Verpiss dich! Ich bin besser dran, wenn ich versuche, ihn an die Großhandelsgesellschaft zu verkaufen!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:86
translate de qst_guild_price_life_son_negotiate_8db2fb38:

    # MARAUDER_LEADER "Hmm ... I suppose after all the trouble he's caused, the sooner I get him out of my hands, the better."
    MARAUDER_LEADER "Hmm ... Ich schätze, nach all dem Ärger, den er verursacht hat, ist es umso besser, je schneller ich ihn loswerde."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:87
translate de qst_guild_price_life_son_negotiate_9ade727a:

    # MARAUDER_LEADER "Fine, give us the coin and he's yours."
    MARAUDER_LEADER "Na schön, gib uns das Geld und er gehört dir."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:91
translate de qst_guild_price_life_son_negotiate_41bd92a2:

    # "Throwing over the bags filled with coin, the gang grinned as they inspected the coins inside, nodding with approval to their leader that it was all there."
    "Die Bande warf die mit Münzen gefüllten Beutel herüber und grinste, während sie die Münzen darin inspizierte, und nickte ihrem Anführer zustimmend zu, dass alles da war."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:92
translate de qst_guild_price_life_son_negotiate_be18cf29:

    # MARAUDER_LEADER "Pleasure doing business with you."
    MARAUDER_LEADER "War ein Vergnügen, mit dir Geschäfte zu machen."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:96
translate de qst_guild_price_life_son_negotiate_25312e44:

    # MARAUDER_LEADER "We had a fucking deal!"
    MARAUDER_LEADER "Wir hatten einen verdammten Deal!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:97
translate de qst_guild_price_life_son_negotiate_2e2c17b1:

    # MC "And I'm changing it."
    MC "Und ich ändere ihn."

