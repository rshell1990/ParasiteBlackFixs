translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7760b7a8:

    # MC @ talk "Are you there? "
    MC @ talk "Bist du da?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:140
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_f9ca0dad:

    # MC @ talk "{i}Spirit?{/i}"
    MC @ talk "{i}Geist?{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:141
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_b28233a2:

    # "Unsurprisingly, no answer came."
    "Wenig überraschend kam keine Antwort."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:142
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_2bcf7e2a:

    # MC "Hm..."
    MC "Hm..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:143
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_e4b866cd:

    # "Heading over to my old bed, I flopped down onto it."
    "Ich ging zu meinem alten Bett und ließ mich darauf fallen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:144
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_db3474b8:

    # "The frame creaked, struggling more than ever to support me, but as I sunk into the softness of it, I sighed with relief."
    "Das Gestell knarrte, es hatte mehr denn je zu kämpfen, mich zu tragen, aber als ich in seine Weichheit einsank, seufzte ich erleichtert auf."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:145
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9ee2712d:

    # "I hadn’t felt something so comfortable in months, the luxuriousness of it was almost like some distant memory."
    "Ich hatte seit Monaten nichts so Bequemes mehr gespürt, die Üppigkeit davon war fast wie eine ferne Erinnerung."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:147
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_af59c89a:

    # "Closing my eyes for a moment, I felt..."
    "Ich schloss für einen Moment die Augen und fühlte..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:156
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_b19e38ff:

    # "My eyes shot open as I sat upright, desperately gasping for air."
    "Meine Augen rissen auf, als ich mich aufsetzte und verzweifelt nach Luft schnappte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:159
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_4a651378:

    # MC @ surprised "{i}... Fuck.{/i}"
    MC @ surprised "{i}... Scheiße.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:161
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9477c75e:

    # "I heard the front door swing open once again to announce [regina_ref!t]'s return."
    "Ich hörte, wie die Haustür erneut aufschwang und [regina_ref!t]s Rückkehr ankündigte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:162
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_274476ae:

    # REGINA @ talk "Are you still here?"
    REGINA @ talk "Bist du noch da?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:163
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_bb6054c4:

    # MC @ talk "I’m just in my room."
    MC @ talk "Ich bin nur in meinem Zimmer."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:164
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_6aaa7d1e:

    # "After listening out, a few moments later I heard some soft footsteps as the door crept open and [regina_ref!t] peeked inside."
    "Nachdem ich gelauscht hatte, hörte ich wenige Augenblicke später leise Schritte, als die Tür sich langsam öffnete und [regina_ref!t] hereinschaute."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:166
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_8798cba0:

    # REGINA @ talk "Is everything okay, dear?"
    REGINA @ talk "Ist alles in Ordnung, Liebes?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:167
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_90bda528:

    # MC @ talk "I’m fine..."
    MC @ talk "Mir geht's gut..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:168
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_b7b3534a:

    # MC @ talk "It’s just..."
    MC @ talk "Es ist nur..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:169
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_a2d8a856:

    # MC @ talk "Strange being back here, is all."
    MC @ talk "Es ist nur seltsam, wieder hier zu sein."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:170
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_71d4718f:

    # "Regina gave me a sympathetic look as she nodded in some small understanding."
    "Regina warf mir einen mitfühlenden Blick zu und nickte mit einem Anflug von Verständnis."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:171
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_d03d1560:

    # REGINA @ sad_talk "Come, I’m about to put the stew on for you."
    REGINA @ sad_talk "Komm, ich setze gleich den Eintopf für dich auf."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:172
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_c0c1b183:

    # MC @ talk "Alright..."
    MC @ talk "In Ordnung..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:173
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_e381c644:

    # MC @ talk "... [regina_ref_cap!t]?"
    MC @ talk "... [regina_ref_cap!t]?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:174
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_2b9cda49:

    # REGINA @ talk "Yes?"
    REGINA @ talk "Ja?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:175
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_f2baaa22:

    # MC @ talk "Thank you, for everything."
    MC @ talk "Danke, für alles."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:176
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_be966e8f:

    # "Regina smiled warmly, her eyes welling up ever so slightly before sliding out of the doorway back towards her cooking pot."
    "Regina lächelte warmherzig, ihre Augen füllten sich ganz leicht mit Tränen, bevor sie aus der Türöffnung zurück zu ihrem Kochtopf glitt."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:180
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7e88966e:

    # "A short while later, the homely food was served and I devoured every last scrap of it."
    "Kurze Zeit später wurde das hausgemachte Essen serviert, und ich aß jeden letzten Krümel davon."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:181
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9913f732:

    # "We talked about many things, the good and the bad of my experiences with the Scouts, but I did my best to avoid discussing the fort and Duprey and Borras’ deaths."
    "Wir sprachen über viele Dinge, die guten und die schlechten meiner Erfahrungen mit den Pfadfindern, aber ich gab mein Bestes, um das Fort und den Tod von Duprey und Borras nicht zu erwähnen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:182
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_34f338ce:

    # "Regina informed me that Adara had visited nearly every day to find out if I’d written any letters home that she could read."
    "Regina erzählte mir, dass Adara fast jeden Tag vorbeigekommen war, um herauszufinden, ob ich Briefe nach Hause geschrieben hatte, die sie lesen könnte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:183
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_addc3724:

    # "I explained to [regina_ref!t] that I was a part of the Adventurers' guild now. It made her uncomfortable given that I had barely survived my trek with the Scouts..."
    "Ich erklärte [regina_ref!t], dass ich jetzt der Abenteurergilde angehörte. Es war ihr unangenehm, da ich meinen Ausflug mit den Pfadfindern kaum überlebt hatte..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:184
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_42e29a17:

    # "...But she didn’t let her displeasure be known through anything other than pursing her lips and going a little quiet."
    "...Aber sie ließ sich ihre Unzufriedenheit nur anmerken, indem sie die Lippen zusammenpresste und etwas still wurde."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:185
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_2ece8a6b:

    # "Finally, placing my bowl down onto the table, I rose from my seat."
    "Schließlich stellte ich meine Schüssel auf den Tisch und erhob mich von meinem Stuhl."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:190
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_c229410b:

    # MC @ talk "I have to go meet Markus now, we’ve got to show up at the Adventurers' Guild."
    MC @ talk "Ich muss jetzt Markus treffen, wir müssen uns bei der Abenteurergilde melden."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:192
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_8f36c5e5:

    # REGINA @ talk "Will you be back later?"
    REGINA @ talk "Kommst du später wieder?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:193
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_5bbe96f5:

    # MC @ talk "Of course, though it might not be till quite a bit later..."
    MC @ talk "Natürlich, aber es könnte ziemlich spät werden..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:194
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_a5e8ce64:

    # MC @ talk "Do you need anything?"
    MC @ talk "Brauchst du etwas?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:195
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_21b02044:

    # REGINA @ talk "Hmm... Well, if you’re offering..."
    REGINA @ talk "Hmm... Nun, wenn du es anbietest..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:196
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_66035ecd:

    # REGINA @ talk "Could you pick up something for me from the Blacksmiths?"
    REGINA @ talk "Könntest du etwas für mich vom Schmied holen?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:197
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_2f447204:

    # MC @ talk "What is it?"
    MC @ talk "Was ist es?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:198
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_dbff95b5:

    # MC @ talk "[regina_ref_cap!t] blushed as she spoke but waved off the question before I could ask any more."
    MC @ talk "[regina_ref_cap!t] errötete, als sie sprach, winkte aber ab, bevor ich noch mehr fragen konnte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:199
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_0a2b8690:

    # REGINA @ talk "Nothing, just a little something for myself..."
    REGINA @ talk "Nichts, nur eine Kleinigkeit für mich selbst..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:200
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_2ded8107:

    # REGINA @ talk "It should be wrapped in a box, just tell them it’s for me."
    REGINA @ talk "Es sollte in einer Schachtel verpackt sein, sag ihnen einfach, es ist für mich."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:201
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_f1f0b2cc:

    # MC @ talk "Sure."
    MC @ talk "Sicher."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:203
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_5d0f376e:

    # MC @ talk "Well, I best get a move on."
    MC @ talk "Nun, ich mache mich besser auf den Weg."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:204
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_266a8d3f:

    # REGINA @ talk "Okay, dear."
    REGINA @ talk "Okay, Liebes."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:205
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_a6585a75:

