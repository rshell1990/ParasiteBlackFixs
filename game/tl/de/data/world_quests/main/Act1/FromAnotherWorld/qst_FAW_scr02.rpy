# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:8
translate de qst_FromAnotherWorld_ReturnHome_9f80cd8f:

    # "As I pushed open the door, I was instantly greeted by the wide-eyed, shocked look of Regina who rushed towards me, pulling me into an embrace so tight I struggled to breathe."
    "Als ich die Tür aufstieß, wurde ich sofort von Reginas weit aufgerissenen, geschockten Blick begrüßt, die auf mich zustürmte und mich so fest umarmte, dass ich kaum atmen konnte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:10
translate de qst_FromAnotherWorld_ReturnHome_2d845ee8:

    # REGINA @ shock "{i}*Gasp!*{/i}"
    REGINA @ shock "{i}*Keuch!*{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:11
translate de qst_FromAnotherWorld_ReturnHome_924e671b:

    # REGINA @ shock_talk "You’re home!"
    REGINA @ shock_talk "Du bist zu Hause!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:12
translate de qst_FromAnotherWorld_ReturnHome_e3fcdbfa:

    # MC @ talk "Yes, everything is gonna be alright now."
    MC @ talk "Ja, jetzt wird alles wieder gut."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:13
translate de qst_FromAnotherWorld_ReturnHome_f539344e:

    # MC @ talk "Both me and Markus are safe."
    MC @ talk "Mir und Markus geht es gut."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:14
translate de qst_FromAnotherWorld_ReturnHome_45c85e46:

    # REGINA @ shock_talk "When they said you and Markus were the only survivors, I couldn’t believe it!"
    REGINA @ shock_talk "Als sie sagten, dass du und Markus die einzigen Überlebenden seid, konnte ich es nicht glauben!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:15
translate de qst_FromAnotherWorld_ReturnHome_0fd458a8:

    # MC @ talk "Who told you?"
    MC @ talk "Wer hat es dir gesagt?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:16
translate de qst_FromAnotherWorld_ReturnHome_82b06c87:

    # REGINA @ shock_talk "Haven’t you heard the criers in the streets?"
    REGINA @ shock_talk "Hast du nicht die Ausrufer auf den Straßen gehört?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:17
translate de qst_FromAnotherWorld_ReturnHome_3fde6b24:

    # REGINA @ shock_talk "Your posters have been put up everywhere!"
    REGINA @ shock_talk "Deine Plakate wurden überall aufgehängt!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:18
translate de qst_FromAnotherWorld_ReturnHome_d1e8628e:

    # REGINA @ shock_talk "You’re basically famous!"
    REGINA @ shock_talk "Du bist quasi berühmt!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:19
translate de qst_FromAnotherWorld_ReturnHome_fea71089:

    # REGINA @ talk "When I told them I thought it was you, they brought me in to identify you both."
    REGINA @ talk "Als ich ihnen sagte, dass ich dachte, du wärst es, holten sie mich, um euch beide zu identifizieren."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:20
translate de qst_FromAnotherWorld_ReturnHome_a99eb354:

    # MC @ talk "I’m sorry you had to see me like that."
    MC @ talk "Es tut mir leid, dass du mich so sehen musstest."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:21
translate de qst_FromAnotherWorld_ReturnHome_7e7939d7:

    # REGINA @ sad_talk "It was better than not seeing you at all."
    REGINA @ sad_talk "Es war besser, als dich gar nicht zu sehen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:22
translate de qst_FromAnotherWorld_ReturnHome_d9589509:

    # "Tears began to well in her eyes and she cupped my face with her warm hands before wrapping her arms around me for a second time, clinging to me for as long as I let her."
    "Tränen stiegen in ihren Augen auf und sie legte ihre warmen Hände um mein Gesicht, bevor sie ihre Arme erneut um mich schlang und sich an mich klammerte, solange ich es zuließ."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:23
translate de qst_FromAnotherWorld_ReturnHome_9fa7811a:

    # REGINA @ smile_talk "Gods be praised."
    REGINA @ smile_talk "Gepriesen seien die Götter."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:24
translate de qst_FromAnotherWorld_ReturnHome_de6a39b0:

    # REGINA @ smile_talk "It’s a miracle you’re both alive."
    REGINA @ smile_talk "Es ist ein Wunder, dass ihr beide noch am Leben seid."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:29
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_ffb1c6be:

    # REGINA @ talk "I think they were suspicious that you and Markus had managed to survive through some sort of black magecraft."
    REGINA @ talk "Ich glaube, sie waren misstrauisch, dass du und Markus es geschafft habt, durch irgendeine Art von schwarzer Magie zu überleben."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:30
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_498911e8:

    # REGINA @ talk "They searched your room but found nothing."
    REGINA @ talk "Sie durchsuchten dein Zimmer, fanden aber nichts."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:31
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9c998003:

    # MC @ talk "What did you tell them?"
    MC @ talk "Was hast du ihnen gesagt?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:32
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_e169a1c3:

    # REGINA @ talk "Just that you weren’t blessed with any kind of magecraft, let alone black."
    REGINA @ talk "Nur, dass du mit keinerlei Magie gesegnet bist, geschweige denn schwarzer."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:33
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7112280f:

    # REGINA @ talk "It’s on your school record either way, don’t know why they made such a fuss."
    REGINA @ talk "Es steht sowieso in deiner Schulakte, ich weiß nicht, warum sie so einen Wirbel gemacht haben."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:34
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_074ecab7:

    # MC @ talk "... I see."
    MC @ talk "... Ich verstehe."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:35
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_000e9a42:

    # REGINA @ talk "The investigation was brief, Erika helped ease things along without too much trouble."
    REGINA @ talk "Die Untersuchung war kurz, Erika hat geholfen, die Dinge ohne große Schwierigkeiten zu erleichtern."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:39
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_79a7badb:

    # REGINA @ talk "I’m fine."
    REGINA @ talk "Mir geht es gut."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:40
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_0b8ddf41:

    # REGINA @ talk "Been worried sick about the pair of you ever since you left but other than that I’m okay."
    REGINA @ talk "Ich habe mir seit eurer Abreise krankhafte Sorgen um euch beide gemacht, aber ansonsten geht es mir gut."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:41
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_5d14884b:

    # MC @ talk "We made it back, that’s what matters."
    MC @ talk "Wir sind zurückgekommen, das ist, was zählt."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:45
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_6fae0609:

    # REGINA @ talk "Busy dealing with her usual Inquisitor business... You know how she is, always busy."
    REGINA @ talk "Beschäftigt mit ihren üblichen Inquisitor-Geschäften... Du weißt, wie sie ist, immer beschäftigt."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:46
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_5e5d29c1:

    # MC @ talk "Did she visit me on the ward?"
    MC @ talk "Hat sie mich auf der Station besucht?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:47
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_60784276:

    # REGINA @ talk "I don’t know, but she came to see me to make sure I was coping alright."
    REGINA @ talk "Ich weiß es nicht, aber sie kam zu mir, um sicherzustellen, dass ich klarkomme."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:48
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_d825194b:

    # MC @ talk "... I’m sorry for putting you both through so much."
    MC @ talk "... Es tut mir leid, dass ich euch beide so viel durchmachen ließ."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:49
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_d20e97c2:

    # REGINA @ angry_talk "Don’t talk nonsense!"
    REGINA @ angry_talk "Rede keinen Unsinn!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:50
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_49508680:

    # REGINA @ talk "We’re both just relieved you’re alive."
    REGINA @ talk "Wir sind beide einfach nur erleichtert, dass du am Leben bist."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:53
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_1d04ed6f:

    # "Regina pulled back to look at me properly, examining my new physique."
    "Regina zog sich zurück, um mich richtig anzusehen, und musterte meine neue Statur."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:54
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_321c8c4e:

    # REGINA @ shy_talk "You... {i}You got taller.{/i}"
    REGINA @ shy_talk "Du... {i}Du bist größer geworden.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:55
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_5528f248:

    # MC @ talk "Uhh... yeah."
    MC @ talk "Uhh... ja."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:56
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7153c2b9:

    # REGINA @ shy_talk "And, so much... um... {i}bigger.{/i}"
    REGINA @ shy_talk "Und, so viel... ähm... {i}größer.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:57
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_3795a481:

    # MC @ talk "Y-Yes... The Scouts had us training rigorously... a lot."
    MC @ talk "J-Ja... Die Scouts haben uns hart trainieren lassen... eine Menge."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:58
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7647683f:

    # "Regina raised a sceptical eyebrow, obviously not buying my excuse but letting it slide for now."
    "Regina hob eine skeptische Augenbraue, nahm mir meine Ausrede offensichtlich nicht ab, ließ es aber für den Moment durchgehen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:59
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_3a10b65e:

    # REGINA @ talk "What happened to you both out there?"
    REGINA @ talk "Was ist mit euch beiden da draußen passiert?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:60
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_300bd8d7:

    # MC @ talk "I..."
    MC @ talk "Ich..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:61
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7ca38eb6:

    # MC @ talk "I don’t really know."
    MC @ talk "Ich weiß es nicht wirklich."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:62
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_cd733010:

    # REGINA @ talk "Well, I’ve heard everything from you both stole horses and fought your way back like a pair of men possessed, riding day and night till you got home..."
    REGINA @ talk "Nun, ich habe alles gehört, von der Geschichte, dass ihr beide Pferde gestohlen habt und wie Besessene den Weg zurückgekämpft habt, Tag und Nacht geritten seid, bis ihr nach Hause kamt..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:63
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_caa43f22:

    # REGINA @ talk "To the spirit of Newheart himself helped guide you back."
    REGINA @ talk "Bis hin zu der Geschichte, dass der Geist von Newheart selbst euch zurückgeführt hat."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:64
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_19ae015d:

    # MC @ talk "I can safely assure you that a ghost didn’t save us."
    MC @ talk "Ich kann euch mit Sicherheit versichern, dass uns kein Geist gerettet hat."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:65
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_a78a0340:

    # REGINA @ talk "Then what really happened out there?"
    REGINA @ talk "Was ist dann wirklich da draußen passiert?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:66
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_5241621d:

    # REGINA @ talk "Nobody even knows what you were all doing so deep in Demorai lands."
    REGINA @ talk "Niemand weiß überhaupt, was ihr alle so tief im Land der Demorai gemacht habt."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:67
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7d151e13:

    # REGINA @ talk "No one’s been sent that far in years, and for what reason?"
    REGINA @ talk "Seit Jahren wurde niemand so weit geschickt, und aus welchem Grund?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:68
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_59aa134e:

    # MC @ talk "I don’t fully remember..."
    MC @ talk "Ich erinnere mich nicht ganz..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:69
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_508f3f19:

    # MC @ talk "We were brought in to investigate some old, abandoned fort and..."
    MC @ talk "Wir wurden hergebracht, um eine alte, verlassene Festung zu untersuchen, und..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:70
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_aede12e3:

    # MC @ talk "{i}There was an attack.{/i}"
    MC @ talk "{i}Es gab einen Angriff.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:71
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_28f35834:

    # REGINA @ talk "How did you survive?"
    REGINA @ talk "Wie hast du überlebt?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:72
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_13416fda:

    # MC @ talk "Me and Markus fled deeper into this cave..."
    MC @ talk "Ich und Markus flohen tiefer in diese Höhle ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:73
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_b6a603ef:

    # MC @ talk "There was some type of laboratory inside and we managed to seal the door to it shut."
    MC @ talk "Es gab eine Art Labor im Inneren und wir schafften es, die Tür dahinter zu verschließen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:74
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_2e07282d:

    # REGINA @ shock_talk "... Laboratory?"
    REGINA @ shock_talk "... Labor?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:75
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9407902e:

    # REGINA @ talk "What happened next?"
    REGINA @ talk "Was geschah als Nächstes?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:78
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_3688fe08:

    # MC @ talk "There were... {i}these pillars{/i}."
    MC @ talk "Da waren ... {i}diese Säulen{/i}."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:79
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_e53ca9af:

    # MC @ talk "White and black marble things..."
    MC @ talk "Weiße und schwarze Marmordinger ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:80
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_eb747741:

    # MC @ talk "When we touched them, something leapt onto us."
    MC @ talk "Als wir sie berührten, sprang etwas auf uns."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:81
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7ae97ce6:

    # "Regina’s expression was unusually neutral as I told her what little I could remember."
    "Reginas Miene war ungewöhnlich neutral, als ich ihr von dem wenigen erzählte, woran ich mich erinnern konnte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:82
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9ff1a694:

    # MC @ talk "... And that was it, we just woke up on the ward."
    MC @ talk "... Und das war's, wir wachten einfach auf der Station auf."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:83
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_d769237b:

    # REGINA @ talk "... Tell no one what you’ve just told me."
    REGINA @ talk "... Sag niemandem, was du mir gerade erzählt hast."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:84
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_db3e5b15:

    # MC @ talk "What? But— "
    MC @ talk "Was? Aber—"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:85
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_22a3dca5:

    # REGINA @ angry_talk "Tell. No. One."
    REGINA @ angry_talk "Sag. Es. Niemandem."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:86
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9cdbbeed:

    # REGINA @ talk "People will think you were possessed by some dark spirit or something."
    REGINA @ talk "Die Leute werden denken, du wärst von einem dunklen Geist oder so besessen gewesen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:87
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_73fea2b8:

    # MC @ talk "But... {i}what if I was?{/i}"
    MC @ talk "Aber... {i}was, wenn ich es war?{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:88
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_648e39e8:

    # REGINA @ talk "Then be thankful that the spirit saved your life and keep your mouth shut."
    REGINA @ talk "Dann sei dankbar, dass der Geist dir das Leben gerettet hat, und halt den Mund."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:89
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_81d493e8:

    # REGINA @ talk "If it turns out that {i}was{/i} a spirit that’s attached itself to you and it’s dangerous, then I will deal with it."
    REGINA @ talk "Falls sich herausstellt, dass es {i}ein Geist war{/i}, der sich an dich gehängt hat, und er gefährlich ist, dann werde ich mich darum kümmern."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:90
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_13cc2820:

    # MC @ talk "How are you going to do that?"
    MC @ talk "Wie willst du das machen?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:91
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_a832f186:

    # REGINA @ talk "Don’t concern yourself with that."
    REGINA @ talk "Mach dir darum keine Gedanken."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:92
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_87609c84:

    # REGINA @ talk "{i}I have my ways.{/i}"
    REGINA @ talk "{i}Ich habe meine Methoden.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:93
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_699f0e8c:

    # MC @ talk "So... you just want me to be quiet in the meantime?"
    MC @ talk "Also ... du willst einfach, dass ich in der Zwischenzeit still bin?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:94
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_8db10537:

    # REGINA @ talk "We don’t understand what happened... Scaring people with no actual knowledge and a load of aggrandized speculation will just make matters worse."
    REGINA @ talk "Wir verstehen nicht, was passiert ist ... Leute zu verängstigen ohne wirkliches Wissen und mit einer Menge übertriebener Spekulationen macht die Sache nur noch schlimmer."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:95
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_5393c762:

    # REGINA @ talk "If you notice anything strange..."
    REGINA @ talk "Wenn du etwas Seltsames bemerkst ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:96
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_80fae3b6:

    # REGINA @ talk "Come to me and only me right away."
    REGINA @ talk "Komm sofort zu mir und nur zu mir."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:97
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_4a1911c5:

    # MC @ talk "... There was... a voice last night..."
    MC @ talk "... Es gab ... eine Stimme letzte Nacht ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:98
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_66115aa9:

    # REGINA @ shock_talk "What kind of voice?"
    REGINA @ shock_talk "Was für eine Stimme?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:99
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_bbdd87f3:

    # MC @ talk "I think whatever it is... or {i}was{/i}... wanted to keep me safe."
    MC @ talk "Ich glaube, was auch immer es ist ... oder {i}war{/i} ... wollte mich beschützen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:100
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_cbd68443:

    # REGINA @ talk "... Hmm."
    REGINA @ talk "... Hmm."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:101
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_b49f6fdc:

    # REGINA @ talk "I see."
    REGINA @ talk "Verstehe."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:102
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_c28408c1:

    # MC @ talk "Do you think I should be worried? How serious is this?"
    MC @ talk "Glaubst du, ich sollte mir Sorgen machen? Wie ernst ist das?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:103
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_e09176d9:

    # REGINA @ talk "I think you should {i}keep quiet{/i} till we know more about what exactly it is we’re dealing with."
    REGINA @ talk "Ich denke, du solltest {i}schweigen{/i}, bis wir mehr darüber wissen, womit genau wir es zu tun haben."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:104
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_014d1605:

    # REGINA @ talk "... But thank you for trusting me."
    REGINA @ talk "... Aber danke, dass du mir vertraust."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:107
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_e9b7963c:

    # MC @ talk "I can’t remember anything after that..."
    MC @ talk "Ich kann mich danach an nichts mehr erinnern..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:108
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_c243cf46:

    # REGINA @ talk "Hmm... I see."
    REGINA @ talk "Hmm... Ich verstehe."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:109
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_f76b73df:

    # REGINA @ talk "Well, we best keep an eye on you for the next few days."
    REGINA @ talk "Nun, wir sollten dich die nächsten Tage besser im Auge behalten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:110
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_77bb2010:

    # REGINA @ talk "But I’m glad you’re home safe, I’ve really missed you."
    REGINA @ talk "Aber ich bin froh, dass du sicher zu Hause bist, ich habe dich wirklich vermisst."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:111
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_1a999818:

    # "Regina looked back to the brewing pot then snapped her fingers with realisation."
    "Regina blickte zurück zum kochenden Topf und schnippte dann mit den Fingern, als sie es begriff."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:112
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_0439d3e0:

    # REGINA @ shock_talk "I didn’t buy enough food for two!"
    REGINA @ shock_talk "Ich habe nicht genug Essen für zwei gekauft!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:113
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_092fcd93:

    # MC @ talk "[regina_ref_cap!t], it’s no problem."
    MC @ talk "[regina_ref_cap!t], es ist kein Problem."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:114
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_1818426b:

    # REGINA @ talk "No, wait here!"
    REGINA @ talk "Nein, warte hier!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:115
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_b1043635:

    # REGINA @ talk "I’ll come back with some more vegetables to make you a decent stew, it’s the least I can do."
    REGINA @ talk "Ich komme mit mehr Gemüse zurück, um dir einen ordentlichen Eintopf zu machen, das ist das Mindeste, was ich tun kann."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:116
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9e88cc83:

    # MC @ talk "I’m meant to be meeting Mark—"
    MC @ talk "Ich sollte mich eigentlich mit Mark treffen—"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:117
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_ac49d286:

    # REGINA @ smile_talk "I’ll be back in just a moment!"
    REGINA @ smile_talk "Ich bin gleich wieder da!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:120
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_70efe6d8:

    # "Before I could stop her, [regina_ref!t] was out of the door hurrying to buy some food."
    "Bevor ich sie aufhalten konnte, war [regina_ref!t] aus der Tür geeilt, um Essen zu kaufen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:121
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9d8f7bf6:

    # MC @ talk "{i}*Sigh*{/i}"
    MC @ talk "{i}*Seufz*{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:126
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_7fd05c85:

    # "Peering at the crack in the doorway to my bedroom, I ventured inside."
    "Als ich auf den Spalt in der Tür zu meinem Schlafzimmer starrte, wagte ich mich hinein."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:127
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_2f9b1637:

    # "The room was warm, but untouched since I had last been in it."
    "Das Zimmer war warm, aber unberührt, seit ich das letzte Mal darin gewesen war."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:128
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_611d7f4f:

    # "[regina_ref_cap!t] had made sure to dust and make the bed, maintaining it for my improbable return."
    "[regina_ref_cap!t] hatte dafür gesorgt, dass abgestaubt und das Bett gemacht wurde, und hielt es für meine unwahrscheinliche Rückkehr instand."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:129
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_ea71628f:

    # "It was odd standing in it again."
    "Es war seltsam, wieder darin zu stehen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:130
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_e99550db:

    # "It felt like it belonged to some different time from a world now far away that I was no longer a part of."
    "Es fühlte sich an, als gehörte es zu einer anderen Zeit, aus einer Welt, die nun weit entfernt war und von der ich kein Teil mehr war."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:132
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_69e7ddcf:

    # "All of mine and Markus’ nights of scheming unfolded here, often spent dreamily looking out towards the palace."
    "Alle nächtlichen Pläneschmieden von Markus und mir entfalteten sich hier, oft verbracht damit, verträumt auf den Palast zu blicken."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:133
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_caf32118:

    # "It all seemed so simple back then... even in a world as chaotic as this one."
    "Damals schien alles so einfach... selbst in einer Welt, die so chaotisch ist wie diese."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:134
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_c41f0caa:

    # "Now, everything seems so uncertain, like we are charting a course into some terrible storm, unable to stop ourselves as we are pulled into the watery ravages of the dreaded Black Ocean."
    "Jetzt scheint alles so ungewiss, als würden wir einen Kurs in einen schrecklichen Sturm steuern, unfähig uns aufzuhalten, während wir in die wässrigen Verwüstungen des gefürchteten Schwarzen Ozeans gezogen werden."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:136
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_2898c036:

    # "Both of us should have died that night at the fort, and a part of me {i}still feels like we did{/i}."
    "Wir beide hätten in jener Nacht in der Festung sterben sollen, und ein Teil von mir {i}fühlt sich immer noch so an, als hätten wir das getan{/i}."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:137
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_9fd34d7c:

    # "Turning to look at the old, cracked mirror, I stared into it, hoping to invoke that strange voice from last night."
    "Ich drehte mich um, um in den alten, gesprungenen Spiegel zu schauen, starrte hinein und hoffte, jene seltsame Stimme von letzter Nacht heraufzubeschwören."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:138
translate de qst_FromAnotherWorld_ReturnHome_ReginaTalk_b371400e:

    # MC @ talk "...Hello?"
    MC @ talk "...Hallo?"

