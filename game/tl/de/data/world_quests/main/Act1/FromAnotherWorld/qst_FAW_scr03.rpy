# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:3
translate de qst_FromAnotherWorld_GoToMarkusHouse_f7213481:

    # "Markus’ house was only slightly smaller than mine but felt much more cramped."
    "Markus’ Haus war nur geringfügig kleiner als meines, fühlte sich aber viel beengter an."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:4
translate de qst_FromAnotherWorld_GoToMarkusHouse_8d7cfe15:

    # "Littered about the place were various strange and extraordinary items his brother had collected over the years that clogged up much of the space, hence why me and Markus spent less time here growing up."
    "Überall verstreut lagen diverse seltsame und außergewöhnliche Gegenstände, die sein Bruder im Laufe der Jahre gesammelt hatte und die viel Platz verstopften, weshalb Markus und ich hier in unserer Jugend weniger Zeit verbrachten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:9
translate de qst_FromAnotherWorld_GoToMarkusHouse_209c6d2f:

    # "Entering through a door open ajar, I've realized that I walked into what could be described as a family conversation:"
    "Als ich durch eine angelehnte Tür eintrat, wurde mir klar, dass ich in etwas geraten war, das man als Familiengespräch bezeichnen könnte:"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:11
translate de qst_FromAnotherWorld_GoToMarkusHouse_340883f3:

    # "It was Skallion, Markus' brother."
    "Es war Skallion, Markus' Bruder."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:12
translate de qst_FromAnotherWorld_GoToMarkusHouse_d6aaf9ed:

    # "Having lost both of his parents during the war, Skallion, who used to live alone, was forced to take the young Markus under his wing."
    "Nachdem er beide Eltern im Krieg verloren hatte, war Skallion, der zuvor allein gelebt hatte, gezwungen, den jungen Markus unter seine Fittiche zu nehmen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:13
translate de qst_FromAnotherWorld_GoToMarkusHouse_00a28245:

    # "He was taller and more muscular than both of us has been before we joined the Scouts, but now we towered over him."
    "Er war größer und muskulöser gewesen, als wir beide es waren, bevor wir den Scouts beitraten, aber jetzt überragten wir ihn."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:15
translate de qst_FromAnotherWorld_GoToMarkusHouse_ba816de9:

    # SKALLION "What I'm saying is, Markus..."
    SKALLION "Was ich sagen will, Markus..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:17
translate de qst_FromAnotherWorld_GoToMarkusHouse_447fd455:

    # SKALLION "Bah!"
    SKALLION "Bah!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:18
translate de qst_FromAnotherWorld_GoToMarkusHouse_fbc49fa5:

    # SKALLION "Not you too!"
    SKALLION "Nicht du auch noch!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:19
translate de qst_FromAnotherWorld_GoToMarkusHouse_16665f31:

    # MARKUS "[player_name!t]!"
    MARKUS "[player_name!t]!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:20
translate de qst_FromAnotherWorld_GoToMarkusHouse_56169cb1:

    # SKALLION "What have they been feeding the two of you?!"
    SKALLION "Was haben sie euch beiden bloß gefüttert?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:21
translate de qst_FromAnotherWorld_GoToMarkusHouse_85613c44:

    # MC @ talk "U-Uhhh, plenty of meat?"
    MC @ talk "Ä-Ähm, jede Menge Fleisch?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:22
translate de qst_FromAnotherWorld_GoToMarkusHouse_de517d45:

    # SKALLION "Some bloody good meat..."
    SKALLION "Verdammt gutes Fleisch ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:23
translate de qst_FromAnotherWorld_GoToMarkusHouse_3e325f63:

    # SKALLION "Anyway, you two should go to the Adventurers Guild now."
    SKALLION "Wie auch immer, ihr beide solltet jetzt zur Abenteurergilde gehen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:24
translate de qst_FromAnotherWorld_GoToMarkusHouse_274ddbfe:

    # SKALLION "Try not to get into any trouble on your way there."
    SKALLION "Versucht, auf dem Weg dorthin keinen Ärger zu bekommen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:25
translate de qst_FromAnotherWorld_GoToMarkusHouse_ef6ac64b:

    # "Skallion nodded briefly in my direction."
    "Skallion nickte kurz in meine Richtung."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:26
translate de qst_FromAnotherWorld_GoToMarkusHouse_fb5e296b:

    # SKALLION "It’s good to see you, [player_name!t]."
    SKALLION "Schön, dich zu sehen, [player_name!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:27
translate de qst_FromAnotherWorld_GoToMarkusHouse_dbd12c1a:

    # SKALLION "Try and stop Markus from getting too drunk, if that’s even possible."
    SKALLION "Versuch, Markus davon abzuhalten, zu viel zu trinken, wenn das überhaupt möglich ist."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:28
translate de qst_FromAnotherWorld_GoToMarkusHouse_3e187933:

    # MARKUS "Urgh, I’m not a child anymore you know."
    MARKUS "Urgh, ich bin kein Kind mehr, weißt du."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:29
translate de qst_FromAnotherWorld_GoToMarkusHouse_aff511e7:

    # SKALLION "I know I know..."
    SKALLION "Ich weiß, ich weiß ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:30
translate de qst_FromAnotherWorld_GoToMarkusHouse_393000c5:

    # SKALLION "You’re an OVERGROWN child with a drinking problem."
    SKALLION "Du bist ein ÜBERWACHSENES Kind mit einem Alkoholproblem."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:31
translate de qst_FromAnotherWorld_GoToMarkusHouse_9c42a8b9:

    # "Markus pulled an unimpressed expression as Skallion snickered to himself."
    "Markus machte einen unbeeindruckten Gesichtsausdruck, während Skallion vor sich hin kicherte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:32
translate de qst_FromAnotherWorld_GoToMarkusHouse_6eef8ce4:

    # SKALLION "Oh, and don’t disturb me in my room plase..."
    SKALLION "Oh, und stör mich bitte nicht in meinem Zimmer ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:33
translate de qst_FromAnotherWorld_GoToMarkusHouse_8a710b07:

    # SKALLION "I’m working on a little project."
    SKALLION "Ich arbeite an einem kleinen Projekt."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:34
translate de qst_FromAnotherWorld_GoToMarkusHouse_2e478c4d:

    # MARKUS "Is this another one of your secret projects?"
    MARKUS "Ist das wieder eines deiner geheimen Projekte?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:35
translate de qst_FromAnotherWorld_GoToMarkusHouse_d6f4eb56:

    # SKALLION "{i}Perhaps.{/i}"
    SKALLION "{i}Vielleicht.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:36
translate de qst_FromAnotherWorld_GoToMarkusHouse_b2eb23c8:

    # MARKUS "Will we ever see one of these secret projects of yours?"
    MARKUS "Werden wir jemals eines dieser geheimen Projekte von dir sehen?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:37
translate de qst_FromAnotherWorld_GoToMarkusHouse_2af2a567:

    # SKALLION "When it’s done, of course!"
    SKALLION "Wenn es fertig ist, natürlich!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:38
translate de qst_FromAnotherWorld_GoToMarkusHouse_78403189:

    # MARKUS "...Will it {i}ever{/i} be done?"
    MARKUS "...Wird es {i}jemals{/i} fertig sein?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:39
translate de qst_FromAnotherWorld_GoToMarkusHouse_b89fc0b4:

    # SKALLION "Such little faith you have, younger brother."
    SKALLION "So wenig Vertrauen hast du, kleiner Bruder."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:40
translate de qst_FromAnotherWorld_GoToMarkusHouse_bfb62c86:

    # SKALLION "I promise you, when this is done, we’ll be swimming in gold."
    SKALLION "Ich verspreche dir, wenn das erledigt ist, werden wir in Gold schwimmen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:41
translate de qst_FromAnotherWorld_GoToMarkusHouse_4295ca1f:

    # MARKUS "For that I cannot wait!"
    MARKUS "Darauf kann ich nicht warten!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:43
translate de qst_FromAnotherWorld_GoToMarkusHouse_77459e11:

    # "Skallion smirked to himself as he headed back into his room, closing the door firmly behind him."
    "Skallion grinste vor sich hin, als er zurück in sein Zimmer ging und die Tür fest hinter sich schloss."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:44
translate de qst_FromAnotherWorld_GoToMarkusHouse_136008ab:

    # "Markus nodded and motioned for me to come into his room."
    "Markus nickte und bedeutete mir, in sein Zimmer zu kommen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:51
translate de qst_FromAnotherWorld_GoToMarkusHouse_ef0e71b9:

    # "The room was smaller than mine, little more than box really with just two shelves and a chest."
    "Das Zimmer war kleiner als meines, eigentlich kaum mehr als eine Kiste mit nur zwei Regalen und einer Truhe."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:52
translate de qst_FromAnotherWorld_GoToMarkusHouse_d96e4bf4:

    # "His room used to be a place Skallion stored things before the young Markus abruptly arrived."
    "Sein Zimmer war früher ein Ort, an dem Skallion Dinge lagerte, bevor der junge Markus plötzlich ankam."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:54
translate de qst_FromAnotherWorld_GoToMarkusHouse_6994bdf6:

    # "Grabbing the small pouch from the shelf, Markus turned to dangle it in front of me."
    "Er griff den kleinen Beutel vom Regal, drehte sich um und ließ ihn vor meinen Augen baumeln."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:55
translate de qst_FromAnotherWorld_GoToMarkusHouse_e94e0fb2:

    # "I heard the rustle of coin inside."
    "Ich hörte das Klimpern von Münzen darin."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:56
translate de qst_FromAnotherWorld_GoToMarkusHouse_98fb41e8:

    # MARKUS "Say hello to tonight's entertainment."
    MARKUS "Sag hallo zur heutigen Abendunterhaltung."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:57
translate de qst_FromAnotherWorld_GoToMarkusHouse_5cf8e7c0:

    # MARKUS "[player_name!t]? You in there?"
    MARKUS "[player_name!t]? Bist du da drin?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:58
translate de qst_FromAnotherWorld_GoToMarkusHouse_c96f0405:

    # MC @ talk "No, nevermind me, I'm just estimating the amount of effort it will take to stop you from drinking this all up."
    MC @ talk "Nein, ach, vergiss mich, ich schätze nur ab, wie viel Mühe es kosten wird, dich davon abzuhalten, das alles zu trinken."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:59
translate de qst_FromAnotherWorld_GoToMarkusHouse_8dca3bcc:

    # MARKUS "Haha! No, I'm not really in the mood for getting {i}too drunk{/i} now..."
    MARKUS "Haha! Nein, ich bin jetzt nicht wirklich in der Stimmung, {i}zu betrunken{/i} zu werden..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:60
translate de qst_FromAnotherWorld_GoToMarkusHouse_1ba5839d:

    # MARKUS "Ever since the... The thing happened."
    MARKUS "Seitdem das... das Ganze passiert ist."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:61
translate de qst_FromAnotherWorld_GoToMarkusHouse_cef1ea26:

    # "An eerie silence enveloped the room as we involuntarily recalled bits and pieces of the events at the fort."
    "Eine unheimliche Stille erfüllte den Raum, als wir uns unwillkürlich an Bruchstücke der Ereignisse in der Festung erinnerten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:62
translate de qst_FromAnotherWorld_GoToMarkusHouse_ba56ef01:

    # "I broke the silence with a probing question:"
    "Ich durchbrach die Stille mit einer bohrenden Frage:"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:63
translate de qst_FromAnotherWorld_GoToMarkusHouse_f17dba09:

    # MC @ talk "Say Markus, what do you remember about what happened to us?"
    MC @ talk "Sag mal, Markus, woran erinnerst du dich, was mit uns passiert ist?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:64
translate de qst_FromAnotherWorld_GoToMarkusHouse_8f28c026:

    # MARKUS "*Sigh* Must we do this now?"
    MARKUS "*Seufz* Müssen wir das jetzt tun?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:65
translate de qst_FromAnotherWorld_GoToMarkusHouse_82e23bb3:

    # MARKUS "I’d rather have a pint of ale or two first."
    MARKUS "Ich würde lieber erst ein oder zwei Krüge Ale trinken."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:66
translate de qst_FromAnotherWorld_GoToMarkusHouse_c1be730c:

    # MC @ talk "I just need to know."
    MC @ talk "Ich muss es einfach wissen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:67
translate de qst_FromAnotherWorld_GoToMarkusHouse_68b4cda3:

    # MC @ talk "Have you been hearing voices?"
    MC @ talk "Hast du in letzter Zeit Stimmen gehört?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:68
translate de qst_FromAnotherWorld_GoToMarkusHouse_6229010b:

    # "Markus paused uncomfortably as his face turned sullen and uneasy."
    "Markus hielt unbehaglich inne, als sein Gesicht mürrisch und unruhig wurde."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:69
translate de qst_FromAnotherWorld_GoToMarkusHouse_88e4876b:

    # MARKUS "... Yes."
    MARKUS "... Ja."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:70
translate de qst_FromAnotherWorld_GoToMarkusHouse_c3f1a405:

    # MC @ talk "What did the voice say?"
    MC @ talk "Was sagte die Stimme?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:71
translate de qst_FromAnotherWorld_GoToMarkusHouse_4ea298cc:

    # MARKUS "That it was here to help, that it had saved me."
    MARKUS "Dass es hier war, um zu helfen, dass es mich gerettet hatte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:72
translate de qst_FromAnotherWorld_GoToMarkusHouse_17a55499:

    # MARKUS "I would really rather not think—"
    MARKUS "Ich möchte wirklich lieber nicht denken—"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:73
translate de qst_FromAnotherWorld_GoToMarkusHouse_d675b20e:

    # "Suddenly, Markus’ eyes widened in surprise as he stumbled backwards clumsily, shock etched on his face."
    "Plötzlich weiteten sich Markus’ Augen überrascht, als er ungeschickt rückwärts stolperte, und Schock zeichnete sich auf seinem Gesicht ab."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:74
translate de qst_FromAnotherWorld_GoToMarkusHouse_19524cd6:

    # MC @ talk "... Markus?"
    MC @ talk "... Markus?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:75
translate de qst_FromAnotherWorld_GoToMarkusHouse_178c19a8:

    # "Turning pale white, Markus collapsed, but his hand reached out to grab onto one of the shelves, dragging everything off from it in one clean sweep as he fell backwards onto his bed."
    "Kreidebleich werdend brach Markus zusammen, doch seine Hand griff nach einem der Regale und riss alles in einem sauberen Zug herunter, während er rückwärts auf sein Bett fiel."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:76
translate de qst_FromAnotherWorld_GoToMarkusHouse_8362d5b0:

    # MC @ talk "Markus!"
    MC @ talk "Markus!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:78
translate de qst_FromAnotherWorld_GoToMarkusHouse_d87a50e5:

    # "Stepping forward to help him, I suddenly felt an intense burning heat within my chest, like my lungs were filling with ash."
    "Als ich vortrat, um ihm zu helfen, spürte ich plötzlich eine intensive brennende Hitze in meiner Brust, als ob sich meine Lungen mit Asche füllten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:84
translate de qst_FromAnotherWorld_GoToMarkusHouse_d7341b8a:

    # "Something began to swirl and froth inside of me, I could feel it moving under my skin, stretching and splitting me."
    "Etwas begann in mir zu wirbeln und zu schäumen, ich konnte fühlen, wie es sich unter meiner Haut bewegte, mich dehnte und spaltete."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:85
translate de qst_FromAnotherWorld_GoToMarkusHouse_45c57fa0:

    # "Frantically, the two of us began to pull off our clothes to see what horror was beneath, we found a hot mass swelling on both of our chests, Markus’ white, mine black."
    "Verzweifelt begannen wir beide, uns die Kleider vom Leib zu reißen, um zu sehen, welcher Horror sich darunter verbarg; wir fanden eine heiße Masse, die auf unseren beiden Brustkörben anschwoll, Markus’ weiß, meine schwarz."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:89
translate de qst_FromAnotherWorld_GoToMarkusHouse_bbb10b86:

    # "We looked to each other, frozen in terror."
    "Wir sahen uns an, vor Schreck erstarrt."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:90
translate de qst_FromAnotherWorld_GoToMarkusHouse_39b6c7fa:

    # "Before we could say anything, they moulded and took form; extending out of our bodies, the two liquids coiled around each other."
    "Bevor wir etwas sagen konnten, formten sie sich und nahmen Gestalt an; aus unseren Körpern austretend, wanden sich die beiden Flüssigkeiten umeinander."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:91
translate de qst_FromAnotherWorld_GoToMarkusHouse_e87013db:

    # "What appeared to be their heads now became bug-like in appearance with sharp pincers extending out of them as the creatures looked quizzically at each other before gradually retreating."
    "Was ihre Köpfe zu sein schienen, wurde nun käferartig mit scharfen Zangen, die aus ihnen herausragten, während die Kreaturen sich neugierig ansahen, bevor sie sich allmählich zurückzogen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:92
translate de qst_FromAnotherWorld_GoToMarkusHouse_fa6b4545:

    # "My heart stopped, I thought that at any moment these things that were inhabiting our bodies were going to split through our skin and kill us in some wretched, macabre display of violence."
    "Mein Herz blieb stehen, ich dachte, dass diese Dinger, die unsere Körper bewohnten, jeden Moment durch unsere Haut brechen und uns in einer elenden, makabren Zurschaustellung von Gewalt töten würden."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:93
translate de qst_FromAnotherWorld_GoToMarkusHouse_ea0bfa1f:

    # "We both looked at each other, half in disbelief, half in terror."
    "Wir sahen uns beide an, halb ungläubig, halb vor Schreck."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:94
translate de qst_FromAnotherWorld_GoToMarkusHouse_4ed832ba:

    # "Now angled towards us, the things looked us dead in the eye and turned their strange heads inwards in curiosity."
    "Nun auf uns ausgerichtet, sahen uns die Dinger direkt in die Augen und drehten ihre seltsamen Köpfe neugierig nach innen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:95
translate de qst_FromAnotherWorld_GoToMarkusHouse_e1050380:

    # "Then... {i}they spoke without mouths{/i}."
    "Dann... {i}sprachen sie ohne Münder{/i}."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:96
translate de qst_FromAnotherWorld_GoToMarkusHouse_66bfe193:

    # BLACK "{i}Hello...{/i}"
    BLACK "{i}Hallo...{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:97
translate de qst_FromAnotherWorld_GoToMarkusHouse_652e3355:

    # "Me and Markus shared a look of panic as we waited for what came next."
    "Markus und ich tauschten einen panischen Blick, während wir darauf warteten, was als Nächstes kommen würde."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:98
translate de qst_FromAnotherWorld_GoToMarkusHouse_b70c4b70:

    # WHITE "{i}Do not be alarmed.{/i}"
    WHITE "{i}Keine Angst.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:99
translate de qst_FromAnotherWorld_GoToMarkusHouse_e54e64e2:

    # BLACK "{i}You are our hosts, we wish you no harm.{/i}"
    BLACK "{i}Ihr seid unsere Gastgeber, wir wollen euch nichts antun.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:100
translate de qst_FromAnotherWorld_GoToMarkusHouse_7c963290:

    # MC @ talk "How... How can we hear you?"
    MC @ talk "Wie... Wie können wir euch hören?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:101
translate de qst_FromAnotherWorld_GoToMarkusHouse_08ff171f:

    # WHITE "{i}We have formed a link to communicate.{/i}"
    WHITE "{i}Wir haben eine Verbindung hergestellt, um zu kommunizieren.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:102
translate de qst_FromAnotherWorld_GoToMarkusHouse_56d495c1:

    # BLACK "{i}We have been learning your language from the archives of your memories.{/i}"
    BLACK "{i}Wir haben eure Sprache aus den Archiven eurer Erinnerungen gelernt.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:103
translate de qst_FromAnotherWorld_GoToMarkusHouse_2637d9a3:

    # MARKUS "W-What are you?"
    MARKUS "W-Was seid ihr?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:104
translate de qst_FromAnotherWorld_GoToMarkusHouse_52f48309:

    # MARKUS "What are you doing inside of us?"
    MARKUS "Was macht ihr in uns?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:105
translate de qst_FromAnotherWorld_GoToMarkusHouse_061b5fe4:

    # WHITE "{i}No choice.{/i}"
    WHITE "{i}Keine Wahl.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:106
translate de qst_FromAnotherWorld_GoToMarkusHouse_a60c5b71:

    # BLACK "{i}No choice.{/i}"
    BLACK "{i}Keine Wahl.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:107
translate de qst_FromAnotherWorld_GoToMarkusHouse_b8e49765:

    # BLACK "{i}Must find a host or die... We cannot survive without one.{/i}"
    BLACK "{i}Muss einen Wirt finden oder sterben... Wir können ohne einen nicht überleben.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:108
translate de qst_FromAnotherWorld_GoToMarkusHouse_f36d192e:

    # MC @ talk "... You were the things that attached to us at the fort."
    MC @ talk "... Ihr wart die Dinger, die sich an uns in der Festung geheftet haben."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:109
translate de qst_FromAnotherWorld_GoToMarkusHouse_11191076:

    # WHITE "{i}Yes.{/i}"
    WHITE "{i}Ja.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:110
translate de qst_FromAnotherWorld_GoToMarkusHouse_1068949a:

    # WHITE "{i}We used our reserves of energy to return you to this city.{/i}"
    WHITE "{i}Wir haben unsere Energiereserven genutzt, um euch in diese Stadt zurückzubringen.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:111
translate de qst_FromAnotherWorld_GoToMarkusHouse_7990dc48:

    # BLACK "{i}Now we have recovered to an extent and we wish to communicate with you.{/i}"
    BLACK "{i}Jetzt haben wir uns einigermaßen erholt und möchten mit euch kommunizieren.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:112
translate de qst_FromAnotherWorld_GoToMarkusHouse_3609049d:

    # MC @ talk "Why is one of you white and the other black?"
    MC @ talk "Warum ist einer von euch weiß und der andere schwarz?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:113
translate de qst_FromAnotherWorld_GoToMarkusHouse_f74462d3:

    # WHITE "{i}We are different strains of the same species.{/i}"
    WHITE "{i}Wir sind verschiedene Stämme derselben Art.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:114
translate de qst_FromAnotherWorld_GoToMarkusHouse_5416e6b1:

    # BLACK "{i}We are different in many ways, yet the same in many others.{/i}"
    BLACK "{i}Wir unterscheiden uns in vielerlei Hinsicht, sind uns aber in vielen anderen gleich.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:115
translate de qst_FromAnotherWorld_GoToMarkusHouse_7e05aa22:

    # MARKUS "... W-What do you want from us?"
    MARKUS "... W-Was wollt ihr von uns?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:116
translate de qst_FromAnotherWorld_GoToMarkusHouse_0dfe344b:

    # BLACK "{i}As we speak... we are travelling up your nervous system to complete the infection of your cerebral cortex.{/i}"
    BLACK "{i}Während wir sprechen... bewegen wir uns euer Nervensystem hinauf, um die Infektion eurer Großhirnrinde abzuschließen.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:117
translate de qst_FromAnotherWorld_GoToMarkusHouse_bdfe7a0e:

    # WHITE "{i}Once this is complete, the host shall be in our control.{/i}"
    WHITE "{i}Sobald dies abgeschlossen ist, wird der Wirt unter unserer Kontrolle sein.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:118
translate de qst_FromAnotherWorld_GoToMarkusHouse_49579012:

    # MC @ talk "You— You’re killing us?!"
    MC @ talk "Du— Du bringst uns um?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:119
translate de qst_FromAnotherWorld_GoToMarkusHouse_a2d2271f:

    # MARKUS "You said you meant us no harm!"
    MARKUS "Du sagtest, du wolltest uns nichts antun!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:120
translate de qst_FromAnotherWorld_GoToMarkusHouse_420bcbe2:

    # BLACK "{i}We do not... This function is an autonomic response.{/i}"
    BLACK "{i}Wir tun es nicht... Diese Funktion ist eine autonome Reaktion.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:121
translate de qst_FromAnotherWorld_GoToMarkusHouse_c884cc99:

    # MC @ talk "A what now?"
    MC @ talk "Ein was jetzt?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:122
translate de qst_FromAnotherWorld_GoToMarkusHouse_5e7aad89:

    # WHITE "{i}We cannot prevent or stop it any more than you could will your heart to stop.{/i}"
    WHITE "{i}Wir können es ebenso wenig verhindern oder stoppen, wie du dein Herz zum Stillstand bringen könntest.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:123
translate de qst_FromAnotherWorld_GoToMarkusHouse_728306f3:

    # MC @ talk "Then how are you going to help us?"
    MC @ talk "Wie willst du uns dann helfen?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:124
translate de qst_FromAnotherWorld_GoToMarkusHouse_e4b05d3e:

    # BLACK "{i}Our autonomic response occurs when the primary function is not being met.{/i}"
    BLACK "{i}Unsere autonome Reaktion tritt auf, wenn die primäre Funktion nicht erfüllt wird.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:125
translate de qst_FromAnotherWorld_GoToMarkusHouse_31f802db:

    # BLACK "{i}A lack of viable breeding hosts.{/i}"
    BLACK "{i}Ein Mangel an geeigneten Brutwirten.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:126
translate de qst_FromAnotherWorld_GoToMarkusHouse_8ad95643:

    # MARKUS "What?! What are you talking about?"
    MARKUS "Was?! Wovon redest du?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:127
translate de qst_FromAnotherWorld_GoToMarkusHouse_28072495:

    # WHITE "{i}The autonomic response can be halted or even regress when this function is met.{/i}"
    WHITE "{i}Die autonome Reaktion kann gestoppt oder sogar rückläufig werden, wenn diese Funktion erfüllt ist.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:128
translate de qst_FromAnotherWorld_GoToMarkusHouse_45c7fd19:

    # BLACK "{i}Breeding triggers a chemical reaction that informs us the needs of the hive are being met.{/i}"
    BLACK "{i}Die Fortpflanzung löst eine chemische Reaktion aus, die uns mitteilt, dass die Bedürfnisse des Schwarms erfüllt werden.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:129
translate de qst_FromAnotherWorld_GoToMarkusHouse_a0065923:

    # BLACK "{i}The autonomic response from mating is one that reduces us to a more feral, but incredibly powerful state.{/i}"
    BLACK "{i}Die autonome Reaktion durch Paarung versetzt uns in einen wilderen, aber unglaublich mächtigen Zustand.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:130
translate de qst_FromAnotherWorld_GoToMarkusHouse_5942f1a0:

    # BLACK "{i}It is designed only to aid a dying hive.{/i}"
    BLACK "{i}Es ist nur dazu bestimmt, einem sterbenden Schwarm zu helfen.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:131
translate de qst_FromAnotherWorld_GoToMarkusHouse_0649121c:

    # MC @ talk "Hive? Are you some kind of bug or something?"
    MC @ talk "Schwarm? Bist du eine Art Insekt oder so?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:132
translate de qst_FromAnotherWorld_GoToMarkusHouse_2db601d1:

    # WHITE "{i}We are both a symbiotic and parasitic race.{/i}"
    WHITE "{i}Wir sind sowohl eine symbiotische als auch parasitäre Rasse.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:133
translate de qst_FromAnotherWorld_GoToMarkusHouse_3e58b722:

    # BLACK "{i}We have no name.{/i}"
    BLACK "{i}Wir haben keinen Namen.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:134
translate de qst_FromAnotherWorld_GoToMarkusHouse_b73cec58:

    # WHITE "{i}We instil upon our hosts enhanced traits, you may have already noticed a drastic increase of muscle tissue in your body.{/i}"
    WHITE "{i}Wir verleihen unseren Wirten verbesserte Eigenschaften. Möglicherweise hast du bereits eine drastische Zunahme von Muskelgewebe in deinem Körper bemerkt.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:135
translate de qst_FromAnotherWorld_GoToMarkusHouse_84d9a782:

    # MARKUS "So... let me get this straight..."
    MARKUS "Also... lass mich das mal richtig verstehen..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:136
translate de qst_FromAnotherWorld_GoToMarkusHouse_4a5ff0ab:

    # MARKUS "It’s either fuck or die?"
    MARKUS "Entweder ficken oder sterben?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:137
translate de qst_FromAnotherWorld_GoToMarkusHouse_8b662edd:

    # BLACK "{i}... This analysis is primitive but correct.{/i}"
    BLACK "{i}... Diese Analyse ist primitiv, aber korrekt.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:138
translate de qst_FromAnotherWorld_GoToMarkusHouse_96ac6875:

    # WHITE "{i}The hive must survive.{/i}"
    WHITE "{i}Der Schwarm muss überleben.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:139
translate de qst_FromAnotherWorld_GoToMarkusHouse_36733e27:

    # BLACK "{i}The hive must {b}always{/b} survive.{/i}"
    BLACK "{i}Der Schwarm muss {b}immer{/b} überleben.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:140
translate de qst_FromAnotherWorld_GoToMarkusHouse_4ad788ff:

    # MARKUS "Well, what if we just try cut you both out?"
    MARKUS "Nun, was, wenn wir einfach versuchen, euch beide herauszuschneiden?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:141
translate de qst_FromAnotherWorld_GoToMarkusHouse_6672d803:

    # "I gaped at Markus, incredulous at his stupidity, he just shrugged in my direction."
    "Ich starrte Markus ungläubig an angesichts seiner Dummheit, er zuckte nur in meine Richtung mit den Schultern."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:142
translate de qst_FromAnotherWorld_GoToMarkusHouse_a318fd77:

    # "In that same moment, both me and Markus felt a sharp pain in our hearts, like something was tightening around them, restricting the space in which they had to beat."
    "Im selben Moment verspürten sowohl ich als auch Markus einen stechenden Schmerz in unseren Herzen, als würde sich etwas um sie zusammenziehen und den Raum einschränken, in dem sie schlagen mussten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:143
translate de qst_FromAnotherWorld_GoToMarkusHouse_65c71e17:

    # WHITE "{i}Without a host, we will die.{/i}"
    WHITE "{i}Ohne einen Wirt werden wir sterben.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:144
translate de qst_FromAnotherWorld_GoToMarkusHouse_b3ba7ad2:

    # BLACK "{i}If we die, the hive dies.{/i}"
    BLACK "{i}Wenn wir sterben, stirbt der Schwarm.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:145
translate de qst_FromAnotherWorld_GoToMarkusHouse_95870c13:

    # WHITE "{i}And the hive must always survive.{/i}"
    WHITE "{i}Und der Schwarm muss immer überleben.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:146
translate de qst_FromAnotherWorld_GoToMarkusHouse_25e81cc2:

    # BLACK "{i}Attempting to remove us will be treated as an act of aggression.{/i}"
    BLACK "{i}Der Versuch, uns zu entfernen, wird als feindseliger Akt betrachtet.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:147
translate de qst_FromAnotherWorld_GoToMarkusHouse_9288eda9:

    # BLACK "{i}We will defend ourselves.{/i}"
    BLACK "{i}Wir werden uns verteidigen.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:148
translate de qst_FromAnotherWorld_GoToMarkusHouse_e05c4e15:

    # MARKUS "But then if you kill us! You’ll die!"
    MARKUS "Aber wenn ihr uns tötet! Ihr werdet sterben!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:149
translate de qst_FromAnotherWorld_GoToMarkusHouse_63fc53f3:

    # WHITE "{i}This analysis is correct... But if you were to attempt to cut us out we would have nothing to lose, so hopefully this shall suffice to dissuade you from attempting to forcibly remove us.{/i}"
    WHITE "{i}Diese Analyse ist korrekt... Aber wenn ihr versuchen würdet, uns herauszuschneiden, hätten wir nichts zu verlieren, also wird dies hoffentlich genügen, euch davon abzuhalten, uns gewaltsam zu entfernen.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:150
translate de qst_FromAnotherWorld_GoToMarkusHouse_462191c8:

    # "The pain in our chests ceased as they loosened their grip."
    "Der Schmerz in unseren Brustkörben hörte auf, als sie ihren Griff lockerten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:151
translate de qst_FromAnotherWorld_GoToMarkusHouse_0a626611:

    # MC @ talk "Tell me something... {i}*huff*{/i} ... why even tell us? Why not just let the autonomic response take over?"
    MC @ talk "Sag mir etwas... {i}*keuch*{/i} ... warum sagt ihr es uns überhaupt? Warum nicht einfach die autonome Reaktion übernehmen lassen?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:152
translate de qst_FromAnotherWorld_GoToMarkusHouse_20b89e14:

    # BLACK "{i}Sentience will be lost if we enter our feral stage.{/i}"
    BLACK "{i}Unser Bewusstsein geht verloren, wenn wir in unser wildes Stadium eintreten.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:153
translate de qst_FromAnotherWorld_GoToMarkusHouse_52a066a9:

    # WHITE "{i}It is death for us.{/i}"
    WHITE "{i}Das ist der Tod für uns.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:154
translate de qst_FromAnotherWorld_GoToMarkusHouse_af945d5e:

    # BLACK "{i}To enter the feral stage is a last resort for hive survival, it is a sacrifice of the individual.{/i}"
    BLACK "{i}In das wilde Stadium einzutreten, ist ein letzter Ausweg für das Überleben des Schwarms, es ist ein Opfer des Individuums.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:159
translate de act1scene4menu_48cefb19:

    # BLACK "{i}We can release pheromones that aid in the act of attracting mates.{/i}"
    BLACK "{i}Wir können Pheromone freisetzen, die bei der Anziehung von Partnern helfen.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:160
translate de act1scene4menu_5384002a:

    # WHITE "{i}You may also transform into our secondary forms for combat or any other purposes you so wish.{/i}"
    WHITE "{i}Ihr könnt euch auch in unsere sekundären Formen verwandeln, für den Kampf oder andere Zwecke, die ihr wünscht.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:161
translate de act1scene4menu_b9f07923:

    # MC @ talk "We... We can change into what?"
    MC @ talk "Wir... Wir können uns in was verwandeln?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:162
translate de act1scene4menu_fd69c436:

    # BLACK "{i}Our secondary forms, they are optimal in the use of the primary functions, should you so require.{/i}"
    BLACK "{i}Unsere sekundären Formen, sie sind optimal für die Nutzung der Primärfunktionen, solltest du dies benötigen.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:163
translate de act1scene4menu_78508801:

    # MC @ talk "How do we change into your... secondary form?"
    MC @ talk "Wie verwandeln wir uns in deine... sekundäre Form?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:164
translate de act1scene4menu_f6b8d387:

    # BLACK "{i}It is like having another limb... Focus on using it and you will transform.{/i}"
    BLACK "{i}Es ist, als hättest du ein weiteres Glied... Konzentriere dich darauf, es zu benutzen, und du wirst dich verwandeln.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:165
translate de act1scene4menu_1acd9b2d:

    # BLACK "{i}The first time will be painful.{/i}"
    BLACK "{i}Das erste Mal wird schmerzhaft sein.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:169
translate de act1scene4menu_e57cd7e3:

    # BLACK "{i}A week.{/i}"
    BLACK "{i}Eine Woche.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:170
translate de act1scene4menu_53822368:

    # MC @ talk "A week?! That’s it?"
    MC @ talk "Eine Woche?! Das ist alles?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:171
translate de act1scene4menu_79e6c264:

    # BLACK "Mating reverses the feral process... Our species was genetically built to breed and multiply, failure to do so causes... Mutations."
    BLACK "Die Paarung kehrt den wilden Prozess um... Unsere Spezies wurde genetisch darauf ausgelegt, sich zu paaren und zu vermehren; scheitert man daran, führt das zu... Mutationen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:175
translate de act1scene4menu_1039e80d:

    # BLACK "{i}We do not remember.{/i}"
    BLACK "{i}Wir erinnern uns nicht.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:176
translate de act1scene4menu_e94eda9d:

    # MC @ talk "How do you not know?"
    MC @ talk "Wie kannst du das nicht wissen?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:177
translate de act1scene4menu_24103354:

    # WHITE "{i}Such functions are not deemed necessary for survival... Only the primary function remains.{/i}"
    WHITE "{i}Solche Funktionen werden als nicht überlebensnotwendig erachtet... Nur die primäre Funktion bleibt.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:178
translate de act1scene4menu_0a347215:

    # BLACK "{i}... And what we have assimilated from you.{/i}"
    BLACK "{i}... Und was wir von euch assimiliert haben.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:182
translate de act1scene4menu_ea525212:

    # BLACK "{i}Yes...{/i}"
    BLACK "{i}Ja...{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:185
translate de act1scene4menu_eb3b32fe:

    # WHITE "{i}Work with us. Do not fight us.{/i}"
    WHITE "{i}Arbeitet mit uns. Kämpft nicht gegen uns.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:186
translate de act1scene4menu_f9cff37b:

    # BLACK "{i}There are many benefits to a relationship such as this one.{/i}"
    BLACK "{i}Es gibt viele Vorteile an einer solchen Beziehung.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:187
translate de act1scene4menu_531a0dc0:

    # WHITE "{i}Rest is needed now...{/i}"
    WHITE "{i}Jetzt ist Ruhe nötig...{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:188
translate de act1scene4menu_fbd8fa7c:

    # BLACK "{i}Yes... More rest.{/i}"
    BLACK "{i}Ja... Mehr Ruhe.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:189
translate de act1scene4menu_f7c46184:

    # "The voices fell silent."
    "Die Stimmen verstummten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:190
translate de act1scene4menu_1657b476:

    # "Ever so slowly, the things retreated back into our chests and, eventually, our breathing calmed and our hearts stopped threatening to shudder to a stop."
    "Ganz langsam zogen sich die Dinger in unsere Brust zurück und schließlich beruhigte sich unser Atem und unsere Herzen hörten auf, drohend zu stocken."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:195
translate de act1scene4menu_6d707ebd:

    # MARKUS "... Hello?"
    MARKUS "... Hallo?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:196
translate de act1scene4menu_815cee38:

