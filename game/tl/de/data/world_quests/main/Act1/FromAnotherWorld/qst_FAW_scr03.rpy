    # MC @ talk "... Markus... You heard them."
    MC @ talk "... Markus... Du hast sie gehört."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:200
translate de act1scene4menu_e3cd0bf4:

    # "Before Markus could veer off into some screaming rant, the door swung open and Skallion peered in."
    "Bevor Markus in eine schreiende Tirade ausbrechen konnte, schwang die Tür auf und Skallion spähte herein."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:204
translate de act1scene4menu_5cead7ae:

    # SKALLION "What’s going on in here?"
    SKALLION "Was geht hier vor sich?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:205
translate de act1scene4menu_da0afb61:

    # SKALLION "What you both wailing about?"
    SKALLION "Worüber jammert ihr beide?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:206
translate de act1scene4menu_c7d2ca96:

    # MC @ talk "I— We were just leaving, right, Markus?"
    MC @ talk "Ich— Wir wollten gerade gehen, richtig, Markus?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:208
translate de act1scene4menu_91516288:

    # "Markus hesitated, I could see his mind racing as I caught his glance."
    "Markus zögerte, ich konnte sehen, wie sein Verstand raste, als ich seinen Blick auffing."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:209
translate de act1scene4menu_b7ac5572:

    # MARKUS "I... Yes, let's go, [player_name!t]."
    MARKUS "Ich... Ja, lass uns gehen, [player_name!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:212
translate de act1scene4menu_4145fea3:

    # "Skallion took a step into the room and scrutinised us both."
    "Skallion machte einen Schritt ins Zimmer und musterte uns beide prüfend."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:214
translate de act1scene4menu_6fbdac84:

    # SKALLION "You two look like you’ve seen a bloody ghost!"
    SKALLION "Ihr zwei seht aus, als hättet ihr einen verdammten Geist gesehen!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:215
translate de act1scene4menu_52fc1cce:

    # MARKUS "Don't worry, it's nothing."
    MARKUS "Keine Sorge, es ist nichts."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:216
translate de act1scene4menu_1139a12b:

    # MARKUS "Let's go, [player_name!t]."
    MARKUS "Lass uns gehen, [player_name!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:218
translate de act1scene4menu_aa200a6b:

    # "Before I could reply, Markus stormed out of the house."
    "Bevor ich antworten konnte, stürmte Markus aus dem Haus."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:219
translate de act1scene4menu_0123a36d:

    # MC @ talk "Umm, nice seeing you again, Skallion..."
    MC @ talk "Ähm, schön dich wiederzusehen, Skallion..."

