translate de qst_FromAnotherWorld_GoToValleyWithMarkus_446a87c0:

    # VES @ talk "From my many salvage exploits in this land."
    VES @ talk "Von meinen vielen Bergungsaktionen in diesem Land."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:433
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_b4e00217:

    # MARKUS "You never told us what you’re doing all the way out here."
    MARKUS "Du hast uns nie erzählt, was du ganz hier draußen machst."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:434
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_8787c2d8:

    # VES @ talk "I am lost from my clan."
    VES @ talk "Ich bin von meinem Clan getrennt."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:435
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_eb72ccf2:

    # MC @ talk "You mean there’s more of you?"
    MC @ talk "Du meinst, es gibt noch mehr von euch?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:436
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_9ad80ba1:

    # MARKUS "Oh great... more of you."
    MARKUS "Oh großartig... mehr von euch."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:437
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_311d15dc:

    # "Ves growled, not quite under her breath."
    "Ves knurrte, nicht ganz unter ihrem Atem."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:438
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_39b039a2:

    # VES @ talk "I will say no more."
    VES @ talk "Ich werde nichts mehr sagen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:439
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_77d7f3b2:

    # MC @ talk "Do you know where the others went?"
    MC @ talk "Weißt du, wohin die anderen gegangen sind?"

