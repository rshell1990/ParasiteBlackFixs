translate de qst_FromAnotherWorld_GoToValleyWithMarkus_af6f2d3f:

    # MC @ talk "What the fuck is that?"
    MC @ talk "Was zur Hölle ist das?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:99
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_ad2ec80d:

    # MARKUS "I’m trying to channel my thoughts to focus!"
    MARKUS "Ich versuche, meine Gedanken zu bündeln, um mich zu konzentrieren!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:100
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_45dd95ce:

    # MC @ talk "By going ‘Hmmmmm’ loudly?"
    MC @ talk "Indem du laut ‚Hmmmmm‘ machst?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:101
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_ae17cf69:

    # MARKUS "Well, if you’ve got a better idea let’s hear it! "
    MARKUS "Tja, wenn du eine bessere Idee hast, dann lass sie hören!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:102
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_8349b364:

    # MC @ talk "It wasn’t my idea to stand bollock naked in the middle of the desert! "
    MC @ talk "Es war nicht meine Idee, splitterfasernackt mitten in der Wüste zu stehen!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:103
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_9edeebac:

    # MARKUS "Gah! We just need to focus! And this is the safest place to test it! "
    MARKUS "Gah! Wir müssen uns nur konzentrieren! Und das ist der sicherste Ort, um es zu testen!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:104
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_039cad1a:

    # MC @ talk "Fine. Whatever."
    MC @ talk "Na gut. Wie auch immer."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:105
