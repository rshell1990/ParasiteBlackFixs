translate de qst_FromAnotherWorld_GoToValleyWithMarkus_be283dc6:

    # MC @ talk "The real enemy is the Demorai, REMEMBER that."
    MC @ talk "Der wahre Feind sind die Demorai, VERGISS das nicht."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:382
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_9baa98b0:

