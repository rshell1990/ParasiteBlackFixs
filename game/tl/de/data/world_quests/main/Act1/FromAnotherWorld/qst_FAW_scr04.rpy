    # MC @ talk "We mean you no harm."
    MC @ talk "Wir wollen dir nichts tun."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:386
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_d2f6cd4f:

    # MC @ talk "Ves answered hesitantly."
    MC @ talk "Ves antwortete zögernd."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:387
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_a7a9e275:

    # VES @ talk "I have my own camp, yes."
    VES @ talk "Ich habe mein eigenes Lager, ja."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:388
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_fa13c08a:

    # MC @ talk "Then let us escort you there."
    MC @ talk "Dann lass uns dich dorthin begleiten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:389
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_3618aa06:

    # VES @ talk "I’m fine."
    VES @ talk "Mir geht es gut."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:390
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_fd038f47:

    # MC @ talk "You’re hurt."
    MC @ talk "Du bist verletzt."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:391
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_87a37788:

    # MC @ talk "And you have no idea how many other Demorai linger."
    MC @ talk "Und du hast keine Ahnung, wie viele andere Demorai noch verweilen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:392
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_d0daa289:

    # MC @ talk "Ves sized me up as she tried to decipher whether I was telling the truth or not."
    MC @ talk "Ves musterte mich, während sie zu entschlüsseln versuchte, ob ich die Wahrheit sagte oder nicht."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:393
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_8a6cda6d:

    # VES @ talk "How do I know you won’t just send other humans after me once I’ve shown you the camp?"
    VES @ talk "Woher soll ich wissen, dass du nicht einfach andere Menschen hinter mir herschickst, sobald ich dir das Lager gezeigt habe?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:394
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_cab756f3:

    # MC @ talk "Because you’ve seen our other forms."
    MC @ talk "Weil du unsere anderen Formen gesehen hast."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:395
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f91c8b09:

    # MC @ talk "They’re just as likely to imprison or kill us as they are you."
    MC @ talk "Sie werden uns genauso wahrscheinlich einsperren oder töten wie dich."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:396
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_318a1947:

    # VES @ talk "... Fine."
    VES @ talk "... In Ordnung."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:397
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_7dca5bb3:

    # VES @ talk "But only because you are not fully human, I lend you this trust."
    VES @ talk "Aber nur weil du nicht vollständig menschlich bist, schenke ich dir dieses Vertrauen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:399
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f504d473:

    # "I nodded in understanding."
    "Ich nickte verständnisvoll."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:400
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_d38b4da3:

    # VES @ talk "Stay a few feet behind me..."
    VES @ talk "Bleib ein paar Schritte hinter mir..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:401
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_7330bee0:

    # VES @ talk "I trust neither of you THAT much."
    VES @ talk "Ich vertraue keinem von euch so sehr."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:402
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_d8414235:

    # "Ves began to march across the hot desert sand as Markus placed his hand on my shoulder from behind."
    "Ves begann, über den heißen Wüstensand zu marschieren, als Markus von hinten seine Hand auf meine Schulter legte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:404
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_57043d3c:

    # MARKUS "And now..."
    MARKUS "Und nun ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:405
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_e05217fb:

    # MARKUS "We’re willingly following her into an orc ambush... Great."
    MARKUS "Wir folgen ihr freiwillig in einen Ork-Hinterhalt ... Großartig."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:406
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_67c8c556:

    # MC @ talk "You don’t know that."
    MC @ talk "Das weißt du nicht."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:407
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_2b83dcd7:

    # MARKUS "She’s an orc, or have you forgotten Kalliban’s first war?"
    MARKUS "Sie ist ein Ork, oder hast du Kallibans ersten Krieg vergessen?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:408
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_5a06cd1f:

    # "Markus trapsed on ahead, letting his displeasure with the situation be known with every step."
    "Markus stapfte voran und ließ bei jedem Schritt seinen Unmut über die Situation erkennen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:409
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_2e68127a:

    # MARKUS "She’s the last thing we should be trusting..."
    MARKUS "Sie ist das Letzte, dem wir vertrauen sollten ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:411
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_7173cdcb:

    # "After about twenty minutes of wandering through the hot desert, we finally arrived at Ves’ camp."
    "Nach etwa zwanzig Minuten Wandern durch die heiße Wüste kamen wir endlich in Ves' Lager an."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:421
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_fdfee624:

    # "It was small but well-equipped from the outside."
    "Von außen war es klein, aber gut ausgestattet."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:422
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_ec1cb5b9:

    # "A large tent had been erected, with some stones cobbled together around what looked to be a hastily constructed spit roast fire that was burning in an almost cheerful manner."
    "Ein großes Zelt war aufgestellt worden, mit einigen Steinen, die um etwas herum zusammengewürfelt waren, das nach einem hastig gebauten Bratspießfeuer aussah und fast fröhlich brannte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:423
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_252c94a6:

    # "Littered around the place was the occasional bowl that, presumably, she kept out to gather what water she could when it rained."
    "Über den Ort verteilt standen gelegentlich Schüsseln, die sie vermutlich draußen hielt, um bei Regen so viel Wasser wie möglich zu sammeln."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:424
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_c6230fe6:

    # VES @ talk "Well, this is my camp."
    VES @ talk "Nun, das ist mein Lager."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:425
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_7ae53218:

    # VES @ talk "Thank you for... your assistance."
    VES @ talk "Danke für... deine Hilfe."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:426
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_2a91549c:

    # VES @ talk "Here, take this."
    VES @ talk "Hier, nimm das."

