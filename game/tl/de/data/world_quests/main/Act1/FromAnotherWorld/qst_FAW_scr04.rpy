translate de qst_FromAnotherWorld_GoToValleyWithMarkus_b6a04c88:

    # VES @ talk "No... We were separated while moving camp."
    VES @ talk "Nein... Wir wurden getrennt, als wir das Lager verlegt haben."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:441
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_2e8ee320:

    # VES @ talk "I am alone."
    VES @ talk "Ich bin allein."

