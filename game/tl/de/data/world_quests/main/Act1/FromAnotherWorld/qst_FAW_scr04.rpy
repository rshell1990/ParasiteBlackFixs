translate de qst_FromAnotherWorld_GoToValleyWithMarkus_28d8e035:

    # "Markus didn’t seem to entirely believe her story, but he didn’t argue with it either."
    "Markus schien ihre Geschichte nicht ganz zu glauben, aber er widersprach ihr auch nicht."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:443
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_331311b2:

    # MARKUS "Well, as fun as this has been..."
    MARKUS "Nun, so viel Spaß das auch gemacht hat..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:444
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_905cc806:

    # MARKUS "We must get back to Novaras soon."
    MARKUS "Wir müssen bald zurück nach Novaras."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:445
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_775fe98e:

    # "As Markus turned to leave, I couldn’t help but ask Ves..."
    "Als Markus sich zum Gehen wandte, konnte ich nicht anders, als Ves zu fragen..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:446
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_eaa19993:

    # MC @ talk "Would you mind me coming to check in on you sometime if I’m out this way?"
    MC @ talk "Würde es dir etwas ausmachen, wenn ich irgendwann mal vorbeikomme, um nach dir zu sehen, falls ich in der Gegend bin?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:447
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_a787910b:

    # VES @ talk "... Why?"
    VES @ talk "... Warum?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:448
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_597402b2:

    # MC @ talk "I’m worried about you being out here on your own like this, it’s dangerous."
    MC @ talk "Ich mache mir Sorgen, dass du so alleine hier draußen bist, es ist gefährlich."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:449
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_fea238c3:

    # VES @ talk "It’s more dangerous to move in large groups."
    VES @ talk "Es ist gefährlicher, sich in großen Gruppen zu bewegen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:450
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_57f23063:

    # VES @ talk "I am fine, I can take care of myself."
    VES @ talk "Mir geht es gut, ich kann auf mich selbst aufpassen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:451
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_bc5fff60:

    # "Ves sighed and relented slightly."
    "Ves seufzte und gab leicht nach."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:452
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_7e74d92d:

    # VES @ talk "But..."
    VES @ talk "Aber..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:453
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_5651fc94:

    # VES @ talk "Do as you wish."
    VES @ talk "Tu, was du willst."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:454
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_8c115df7:

    # VES @ talk "I will welcome you if you come."
    VES @ talk "Ich werde dich willkommen heißen, wenn du kommst."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:455
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_48384169:

    # "Markus gave me a {i}look.{/i}"
    "Markus warf mir einen {i}Blick{/i} zu."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:456
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_94d2e812:

    # MARKUS "Okay, I'll be heading out back to Novaras."
    MARKUS "Okay, ich mache mich auf den Weg zurück nach Novaras."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:457
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_362f6e55:

    # MARKUS "Meet me at the tavern later, [player_name!t]."
    MARKUS "Triff mich später in der Taverne, [player_name!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:458
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_afe1882c:

    # MARKUS "We have to figure out what to do next."
    MARKUS "Wir müssen herausfinden, was als Nächstes zu tun ist."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:459
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_778cdb73:

    # MARKUS "Goodbye."
    MARKUS "Auf Wiedersehen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:460
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f041bd88:

    # MARKUS "And you, orc lady."
    MARKUS "Und du, Orkdame."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:462
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_43de5b53:

    # "Markus left, leaving us two alone in the Valley."
    "Markus ging und ließ uns beide allein im Tal zurück."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:464
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_9f4e4d23:

    # "Indifferent to me, Ves headed off to her tent and slid inside."
    "Mir gegenüber gleichgültig, ging Ves zu ihrem Zelt und schlüpfte hinein."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:465
