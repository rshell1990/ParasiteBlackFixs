# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:10
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_14c45b53:

    # MC "We are so fucked."
    MC "Wir sind so am Arsch."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:11
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_9db36875:

    # MC "Those things... If what they’re saying is true..."
    MC "Diese Dinger... Wenn das, was sie sagen, wahr ist..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:12
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f45c2726:

    # MARKUS "Let's go now."
    MARKUS "Lass uns jetzt gehen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:13
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_57421384:

    # MC "Yeah, I doubt the Guild will be as scary as the Scouts..."
    MC "Ja, ich bezweifle, dass die Gilde so gruselig sein wird wie die Scouts..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:14
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_57f6ae64:

    # MARKUS "We're not going to the guild. Not yet."
    MARKUS "Wir gehen nicht zur Gilde. Noch nicht."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:15
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_e1a9bffd:

    # MC @ talk "Huh?"
    MC @ talk "Hä?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:16
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_95b51cb1:

    # MARKUS "Come now, we’re heading into {i}the Valley of Death{/i}."
    MARKUS "Komm schon, wir gehen ins {i}Tal des Todes{/i}."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:17
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_1c1920d2:

    # MC @ talk "What?!"
    MC @ talk "Was?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:18
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_5728f581:

    # MARKUS "It's going to be alright."
    MARKUS "Es wird alles gut."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:19
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_b1f50d7d:

    # MARKUS "We just need to get out of sight to practice changing into..."
    MARKUS "Wir müssen nur außer Sichtweite gehen, um zu üben, uns zu verwandeln in..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:20
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_e3011a99:

    # MARKUS "{i}Whatever{/i} it is we’re going to change into."
    MARKUS "{i}Was auch immer{/i} es ist, in das wir uns verwandeln werden."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:21
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_e9e72c1d:

    # MC @ talk "Markus?!"
    MC @ talk "Markus?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:29
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_c5ba082c:

    # MC @ talk "Markus? Hold up!"
    MC @ talk "Markus? Warte!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:30
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_db826fed:

    # MARKUS "I’ve thought about what they said..."
    MARKUS "Ich habe über das nachgedacht, was sie gesagt haben..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:32
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_19c7f03a:

    # "Markus looked around, making sure no one listens in:"
    "Markus sah sich um und stellte sicher, dass niemand zuhört:"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:33
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_0014df9f:

    # MARKUS "If what they say is true, perhaps this could be the key to having the life we’ve always wanted."
    MARKUS "Wenn das, was sie sagen, wahr ist, könnte das vielleicht der Schlüssel zu dem Leben sein, das wir uns immer gewünscht haben."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:34
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_6dfc9096:

    # MC @ talk "By being cursed?"
    MC @ talk "Indem wir verflucht sind?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:35
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f52b36e0:

    # MARKUS "It’s not a curse if we can manage it."
    MARKUS "Es ist kein Fluch, wenn wir damit umgehen können."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:36
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_87e3f786:

    # MARKUS "Anyway, you heard them... they have already given us a lot of benefits."
    MARKUS "Wie auch immer, du hast sie gehört... sie haben uns bereits viele Vorteile gebracht."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:37
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_2374f272:

    # MARKUS "AND we owe those things our lives."
    MARKUS "UND wir schulden diesen Dingen unser Leben."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:38
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_c24ddfec:

    # MC @ talk "Markus, we have no actual idea of what’s going on with us!"
    MC @ talk "Markus, wir haben keine Ahnung, was mit uns los ist!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:39
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_a83dacb2:

    # MARKUS "And we’re not ever going to know if we don’t at least try to understand them!"
    MARKUS "Und wir werden es nie erfahren, wenn wir nicht wenigstens versuchen, sie zu verstehen!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:40
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_1a988a98:

    # MARKUS "We have to give them a chance."
    MARKUS "Wir müssen ihnen eine Chance geben."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:41
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_32d97cab:

    # MARKUS "If what those {i}things{/i} told us is true, this is the only way."
    MARKUS "Wenn das, was diese {i}Dinger{/i} uns gesagt haben, wahr ist, ist dies der einzige Weg."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:49
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f86ed6dc:

    # "As we passed through the city gate, I felt all kinds of distressing thoughts popping in and out of existence."
    "Als wir durch das Stadttor gingen, spürte ich, wie alle möglichen beunruhigenden Gedanken aufkamen und wieder verschwanden."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:51
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_83b48436:

    # MC "(What are we doing? Will whatever Markus has in mind work? What exactly is going to happen to us now? Is there a 'cure' or something?)"
    MC "(Was tun wir hier? Wird das, was Markus im Sinn hat, funktionieren? Was wird jetzt genau mit uns passieren? Gibt es eine 'Heilung' oder so etwas?)"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:53
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f7d13ea9:

    # "Confident, Markus simply began making his way towards the expanse of the desert."
    "Voll Zuversicht machte sich Markus einfach auf den Weg in die Weite der Wüste."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:54
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_7424c0b1:

    # MARKUS "Keep up, [player_name!t]!"
    MARKUS "Halt mit, [player_name!t]!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:55
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_6cc0ac7f:

    # MC "Snapping out of it, I followed Markus."
    MC "Ich riss mich zusammen und folgte Markus."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:64
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_4a46d39e:

    # MC @ talk "... I still don’t like this."
    MC @ talk "... Ich mag das immer noch nicht."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:65
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_51fb4329:

    # MC @ talk "How will we explain to anyone what we were doing beyond the walls?"
    MC @ talk "Wie werden wir jemandem erklären, was wir außerhalb der Mauern gemacht haben?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:66
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_832fb5ad:

    # MARKUS "Easy, we’re part of the Adventurer’s Guild now, remember? Just say we were patrolling for enemies or whatever..."
    MARKUS "Ganz einfach, wir sind jetzt Teil der Abenteurergilde, erinnerst du dich? Sag einfach, wir hätten nach Feinden Ausschau gehalten oder so ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:67
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_be0c9c6e:

    # MARKUS "Come on, as long as we’re out of view of the wall it should be safe enough for us."
    MARKUS "Komm schon, solange wir außer Sichtweite der Mauer sind, sollte es sicher genug für uns sein."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:68
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_78360619:

    # MC @ talk "As long as we don’t get clawed or bitten or disembowelled by some passing Demorai..."
    MC @ talk "Solange wir nicht von einem vorbeikommenden Demorai gekratzt, gebissen oder ausgeweidet werden ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:69
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_c0c49e59:

    # "Trekking towards the great dunes of the valley, we finally arrived at a spot safely away from the gaze of any watchers on the walls."
    "Wir stapften zu den großen Dünen des Tals und erreichten schließlich eine Stelle, die sicher vor den Blicken jeglicher Beobachter auf den Mauern war."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:70
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_fa07fe14:

    # MARKUS "Okay... This should do."
    MARKUS "Okay ... Das sollte reichen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:71
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_2b9f8100:

    # MC @ talk "...Well, what now?"
    MC @ talk "...Nun, was jetzt?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:72
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_3e4c2a46:

    # MARKUS "I guess, we just change..."
    MARKUS "Ich schätze, wir ziehen uns einfach um ..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:73
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_ebf63fbe:

    # MC @ talk "...How do we do it exactly?"
    MC @ talk "...Wie machen wir das genau?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:74
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_b55c30a7:

    # MARKUS "They said we needed to focus, like it was some extra limb that we just needed to think about using."
    MARKUS "Sie sagten, wir müssten uns konzentrieren, als wäre es ein zusätzliches Körperteil, an dessen Benutzung wir nur denken müssten."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:75
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_ebdf1655:

    # MC @ talk "Easier said than done! "
    MC @ talk "Leichter gesagt als getan!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:76
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_91821a33:

    # "Without warning, Markus began to strip off his clothes."
    "Ohne Vorwarnung begann Markus, sich auszuziehen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:77
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_4239b98e:

    # MC @ talk "...What are you doing?"
    MC @ talk "...Was machst du da?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:78
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_b16baa77:

    # MARKUS "Whatever we change into is likely to tear through our clothes, right?"
    MARKUS "Worin auch immer wir uns verwandeln, es wird vermutlich unsere Kleidung zerreißen, oder?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:79
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_5118a23d:

    # MARKUS "I don’t particularly want to have to walk through Novaras naked when we return."
    MARKUS "Ich möchte nicht unbedingt nackt durch Novaras laufen müssen, wenn wir zurückkehren."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:80
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_0033c658:

    # MC @ talk "...You sure you’re into girls?"
    MC @ talk "...Bist du sicher, dass du auf Mädchen stehst?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:81
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f1f40c61:

    # MC @ talk "Because this might be the clumsiest come on ever."
    MC @ talk "Weil das der plumpste Anmachversuch aller Zeiten sein könnte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:82
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_b76c5147:

    # "Markus shot me a look of ‘shut up and just do it’, clearly taking this too seriously to acknowledge the ridiculousness of the situation."
    "Markus warf mir einen Blick zu, der 'Halt den Mund und tu es einfach' sagte, und nahm das offensichtlich zu ernst, um die Lächerlichkeit der Situation anzuerkennen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:83
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_16cfcfe4:

    # "I sighed and begrudgingly began to strip."
    "Ich seufzte und begann widerwillig, mich auszuziehen."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:84
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_0845cb17:

    # MARKUS "We’ll keep the clothes by this rock for when we return."
    MARKUS "Wir lassen die Kleidung bei diesem Felsen, bis wir zurückkehren."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:85
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_864ca015:

    # MARKUS "Should be easy to find with that dead hooked tree over there nearby."
    MARKUS "Mit dem toten, gekrümmten Baum da drüben in der Nähe sollte es leicht zu finden sein."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:88
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_3ae1d182:

    # MC @ talk "If you say so."
    MC @ talk "Wenn du meinst."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:91
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_f817b1cf:

    # "Now stark naked, I looked to Markus awaiting his next suggestion."
    "Nun splitternackt, blickte ich zu Markus und wartete auf seinen nächsten Vorschlag."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:92
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_53b5a59f:

    # MARKUS "Okay... Let’s just try and think."
    MARKUS "Okay... Versuchen wir einfach nachzudenken."

