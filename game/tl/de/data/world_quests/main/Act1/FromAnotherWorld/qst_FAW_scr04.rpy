translate de qst_FromAnotherWorld_GoToValleyWithMarkus_26079539:

    # MC "It doesn’t matter! They’re going to rip her apart!"
    MC "Das spielt keine Rolle! Sie werden sie in Stücke reißen!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:214
translate de qst_FromAnotherWorld_GoToValleyWithMarkus_3fea1c49:

