# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2957
translate de qst_JudgementDay_Trial_questions_1406027e:

    # JUDGE_FALWIND "I see... does the defense have any witnesses to call?"
    JUDGE_FALWIND "Ich verstehe... hat die Verteidigung Zeugen aufzurufen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2978
translate de qst_JudgementDay_TrialStart_SummonMenu_1c34fc27:

    # "Sister Divine entered, her presence causing a hush to fall over the room."
    "Schwester Divine trat ein, ihre Anwesenheit ließ eine Stille über den Raum fallen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2980
translate de qst_JudgementDay_TrialStart_SummonMenu_503a3720:

    # "Even the judges bowed their heads in respect as she approached."
    "Sogar die Richter senkten respektvoll die Köpfe, als sie sich näherte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2981
translate de qst_JudgementDay_TrialStart_SummonMenu_ffd09729:

    # JUDGE_FALWIND "Sister Divine, you have been called to testify on behalf of the defendant."
    JUDGE_FALWIND "Schwester Divine, Sie sind aufgerufen, im Namen des Angeklagten auszusagen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2982
translate de qst_JudgementDay_TrialStart_SummonMenu_2d692969:

    # JUDGE_FALWIND "Do you believe this creature to be a threat?"
    JUDGE_FALWIND "Glauben Sie, dass diese Kreatur eine Bedrohung darstellt?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2983
translate de qst_JudgementDay_TrialStart_SummonMenu_071277ef:

    # "Sister Divine closed her eyes, inhaling deeply."
    "Schwester Divine schloss die Augen und atmete tief ein."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2984
translate de qst_JudgementDay_TrialStart_SummonMenu_5f3ec5b4:

    # DIVINE @ talk "No."
    DIVINE @ talk "Nein."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2985
translate de qst_JudgementDay_TrialStart_SummonMenu_ace9c56b:

    # DIVINE @ talk "I have known this man. I have seen his heart."
    DIVINE @ talk "Ich habe diesen Mann gekannt. Ich habe sein Herz gesehen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2986
translate de qst_JudgementDay_TrialStart_SummonMenu_e3689e66:

    # DIVINE @ talk "And I have witnessed firsthand his courage and mercy."
    DIVINE @ talk "Und ich habe aus erster Hand seinen Mut und seine Barmherzigkeit miterlebt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2988
translate de qst_JudgementDay_TrialStart_SummonMenu_a15ec0d3:

    # "Some in the jury murmured approvingly."
    "Einige in der Jury murmelten zustimmend."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2989
translate de qst_JudgementDay_TrialStart_SummonMenu_372eca07:

    # JUDGE_FALWIND "Does the prosecution wish to question the witness?"
    JUDGE_FALWIND "Möchte die Anklage den Zeugen befragen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2991
translate de qst_JudgementDay_TrialStart_SummonMenu_29cde297:

    # MARION @ angry "Actually—I do."
    MARION @ angry "Eigentlich – das möchte ich."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2995
translate de qst_JudgementDay_TrialStart_SummonMenu_31be36fd:

    # "Gasps rippled through the court as Marion's lips curled into a sinister smile."
    "Ein Raunen ging durch den Gerichtssaal, als sich Marions Lippen zu einem finsteren Lächeln verzogen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2996
translate de qst_JudgementDay_TrialStart_SummonMenu_2ef95f8d:

    # MARION @ smile "Tell me, Sister—"
    MARION @ smile "Sagen Sie mir, Schwester –"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2997
translate de qst_JudgementDay_TrialStart_SummonMenu_7ca11c6e:

    # MARION @ smile "{i}When did your affair with the defendant begin?{/i}"
    MARION @ smile "{i}Wann begann Ihre Affäre mit dem Angeklagten?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2998
translate de qst_JudgementDay_TrialStart_SummonMenu_7db1deb9:

    # "The room exploded into murmurs."
    "Der Saal brach in Gemurmel aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3000
translate de qst_JudgementDay_TrialStart_SummonMenu_bfd4b635:

    # JUDGE_FALWIND "Order! ORDER IN THE COURT!"
    JUDGE_FALWIND "Ruhe! RUHE IM GERICHTSSAAL!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3001
translate de qst_JudgementDay_TrialStart_SummonMenu_35b27b44:

    # DIVINE @ shock "I—"
    DIVINE @ shock "I—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3002
translate de qst_JudgementDay_TrialStart_SummonMenu_e1d5c551:

    # "Sister Divine looked around the courtroom—trapped."
    "Schwester Divine sah sich im Gerichtssaal um – gefangen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3003
translate de qst_JudgementDay_TrialStart_SummonMenu_3626a067:

    # MARION @ talk "He seduced you, didn't he?"
    MARION @ talk "Er hat Sie verführt, nicht wahr?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3004
translate de qst_JudgementDay_TrialStart_SummonMenu_d813463e:

    # DIVINE @ shock "No!"
    DIVINE @ shock "Nein!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3005
translate de qst_JudgementDay_TrialStart_SummonMenu_28ea01f3:

    # MARION @ smile "She admits it! The creature {i}corrupted{/i} a holy woman!"
    MARION @ smile "Sie gibt es zu! Die Kreatur hat eine heilige Frau {i}korrumpiert{/i}!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3007
translate de qst_JudgementDay_TrialStart_SummonMenu_f043427c:

    # "The jury erupted in outrage."
    "Die Jury brach in Empörung aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3009
translate de qst_JudgementDay_TrialStart_SummonMenu_da8978b7:

    # JUDGE_FALWIND "Order! ORDER!"
    JUDGE_FALWIND "Ruhe! RUHE!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3010
translate de qst_JudgementDay_TrialStart_SummonMenu_d13725af:

    # JUDGE_FALWIND "BE SILENT, OR I WILL HAVE YOU REMOVED FROM THIS COURT!"
    JUDGE_FALWIND "SEID STILL, ODER ICH LASSE SIE AUS DIESEM GERICHTSSAAL ENTFERNEN!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3011
translate de qst_JudgementDay_TrialStart_SummonMenu_98992faf:

    # MARION @ smile "Your honor, I formally request that Sister Divine's testimony be stripped from the record."
    MARION @ smile "Euer Ehren, ich beantrage förmlich, dass Schwester Divines Aussage aus dem Protokoll gestrichen wird."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3012
translate de qst_JudgementDay_TrialStart_SummonMenu_b7017868:

    # DIVINE @ angry "WILL I BE ALLOWED TO SPEAK FOR MYSELF?"
    DIVINE @ angry "DARF ICH FÜR MICH SELBST SPRECHEN?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3013
translate de qst_JudgementDay_TrialStart_SummonMenu_f3faa976:

    # JUDGE_FALWIND "Sister Divine, please answer the question clearly and directly."
    JUDGE_FALWIND "Schwester Divine, bitte beantworten Sie die Frage klar und direkt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3014
translate de qst_JudgementDay_TrialStart_SummonMenu_f6d6475a:

    # JUDGE_FALWIND "Do you know the defendant carnally?"
    JUDGE_FALWIND "Kennen Sie den Angeklagten fleischlich?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3015
translate de qst_JudgementDay_TrialStart_SummonMenu_e77266f2:

    # DIVINE @ angry "It's not illegal for a mage of Palam to—"
    DIVINE @ angry "Es ist für einen Magier aus Palam nicht illegal, zu—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3016
translate de qst_JudgementDay_TrialStart_SummonMenu_c03f04ee:

    # JUDGE_FALWIND "Sister Divine."
    JUDGE_FALWIND "Schwester Divine."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3017
translate de qst_JudgementDay_TrialStart_SummonMenu_c3bd00f9:

    # JUDGE_FALWIND "The question. Please."
    JUDGE_FALWIND "Die Frage. Bitte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3018
translate de qst_JudgementDay_TrialStart_SummonMenu_4480da11:

    # DIVINE @ sad "... Y-Yes."
    DIVINE @ sad "... J-Ja."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3019
translate de qst_JudgementDay_TrialStart_SummonMenu_55e5c120:

    # DIVINE @ shock "BUT—"
    DIVINE @ shock "ABER—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3022
translate de qst_JudgementDay_TrialStart_SummonMenu_f5658d09:

    # "The gavel came crashing down."
    "Der Hammer krachte nieder."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3023
translate de qst_JudgementDay_TrialStart_SummonMenu_56925272:

    # JUDGE_FALWIND "I am sorry, Sister Divine, but I must strip your testimony from the trial."
    JUDGE_FALWIND "Es tut mir leid, Schwester Divine, aber ich muss Ihre Aussage aus dem Verfahren streichen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3024
translate de qst_JudgementDay_TrialStart_SummonMenu_55ff70ff:

    # JUDGE_FALWIND "And further condemn the wickedness of the defendant for his most cruel seduction!"
    JUDGE_FALWIND "Und verurteile weiter die Bosheit des Angeklagten für seine äußerst grausame Verführung!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3026
translate de qst_JudgementDay_TrialStart_SummonMenu_e97c0e18:

    # DIVINE @ angry "I HAVE A VOICE!"
    DIVINE @ angry "ICH HABE EINE STIMME!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3027
translate de qst_JudgementDay_TrialStart_SummonMenu_e9d288dd:

    # DIVINE @ angry "It is not a crime for me to lay with a man, and I am not some foolish woman who would let it sway my opinion in ANY court!"
    DIVINE @ angry "Es ist kein Verbrechen für mich, mit einem Mann zu schlafen, und ich bin keine törichte Frau, die sich dadurch in IRGENDEINEM Gericht beeinflussen lassen würde!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3028
translate de qst_JudgementDay_TrialStart_SummonMenu_066c1dc6:

    # DIVINE @ angry "They fought bravely! They—"
    DIVINE @ angry "Sie kämpften tapfer! Sie—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3029
translate de qst_JudgementDay_TrialStart_SummonMenu_f7962c4a:

    # JUDGE_FALWIND "That's enough, Sister Divine."
    JUDGE_FALWIND "Das reicht, Schwester Divine."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3030
translate de qst_JudgementDay_TrialStart_SummonMenu_884fdc51:

    # JUDGE_FALWIND "It is clear you are not thinking clearly, and your testimony remains stripped."
    JUDGE_FALWIND "Es ist offensichtlich, dass Sie nicht klar denken, und Ihre Aussage bleibt gestrichen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3031
translate de qst_JudgementDay_TrialStart_SummonMenu_66900a42:

    # JUDGE_FALWIND "Now please, Sister, I do not wish to have the guards forcibly remove you from the stand..."
    JUDGE_FALWIND "Nun bitte, Schwester, ich möchte nicht, dass die Wachen Sie gewaltsam vom Zeugenstand entfernen lassen müssen..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3033
translate de qst_JudgementDay_TrialStart_SummonMenu_b24898f9:

    # "Sister Divine opened her mouth to protest, but stopped herself."
    "Schwester Divine öffnete den Mund, um zu protestieren, hielt sich jedoch zurück."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3034
translate de qst_JudgementDay_TrialStart_SummonMenu_af52441c:

    # "Burning with shame and rage, her emotions silenced by the court, she turned away and left the stand."
    "Vor Scham und Wut brennend, ihre Emotionen vom Gericht zum Schweigen gebracht, wandte sie sich ab und verließ den Zeugenstand."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3035
translate de qst_JudgementDay_TrialStart_SummonMenu_6fc0de19:

    # "Her eyes met mine—a flicker of anger, then sorrow, before she looked away."
    "Ihre Augen trafen meine – ein Aufflackern von Wut, dann Trauer, bevor sie wegsah."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3036
translate de qst_JudgementDay_TrialStart_SummonMenu_0beb578c:

    # JUDGE_FALWIND "Now then, let us proceed..."
    JUDGE_FALWIND "Nun dann, lasst uns fortfahren..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3038
translate de qst_JudgementDay_TrialStart_SummonMenu_8bb4924e:

    # MARION @ talk "No, your honor."
    MARION @ talk "Nein, Euer Ehren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3044
translate de qst_JudgementDay_TrialStart_SummonMenu_46f91a75:

    # "The court doors swung open, and Lady Sophira Marginott entered, her posture regal and her expression unreadable."
    "Die Gerichtstüren schwangen auf, und Lady Sophira Marginott trat ein, ihre Haltung majestätisch und ihr Gesichtsausdruck unlesbar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3046
translate de qst_JudgementDay_TrialStart_SummonMenu_f4199cc1:

    # JUDGE_FALWIND "Lady Marginott, the court trusts you are well?"
    JUDGE_FALWIND "Lady Marginott, das Gericht hofft, dass es Ihnen gut geht?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3047
translate de qst_JudgementDay_TrialStart_SummonMenu_6627355c:

    # SOPHIRA @ talk "I am, my lord."
    SOPHIRA @ talk "Ich bin es, mein Lord."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3048
translate de qst_JudgementDay_TrialStart_SummonMenu_8fa4ab23:

    # JUDGE_FALWIND "The defense has summoned you as a witness. Will you recount the events of the siege?"
    JUDGE_FALWIND "Die Verteidigung hat Euch als Zeugin geladen. Werdet Ihr die Ereignisse der Belagerung schildern?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3049
translate de qst_JudgementDay_TrialStart_SummonMenu_f9279766:

    # SOPHIRA @ talk "Of course, if the court so pleases."
    SOPHIRA @ talk "Natürlich, wenn es dem Gericht so gefällt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3051
translate de qst_JudgementDay_TrialStart_SummonMenu_e53b8418:

    # "Lady Marginott recounted the horrific ordeal of the siege, detailing the chaos and bloodshed."
    "Lady Marginott schilderte die schreckliche Tortur der Belagerung und beschrieb dabei Chaos und Blutvergießen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3052
translate de qst_JudgementDay_TrialStart_SummonMenu_c4a0ec18:

    # "Then, she arrived at the moment she met us."
    "Dann kam sie zu dem Moment, als sie uns begegnete."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3057
translate de qst_JudgementDay_TrialStart_SummonMenu_fb01e9b0:

    # SOPHIRA @ sad "I must admit..."
    SOPHIRA @ sad "Ich muss zugeben ..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3058
translate de qst_JudgementDay_TrialStart_SummonMenu_1f5d00ec:

    # SOPHIRA @ sad "When I first laid eyes upon them, I thought them monsters."
    SOPHIRA @ sad "Als ich sie zum ersten Mal erblickte, hielt ich sie für Monster."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3059
translate de qst_JudgementDay_TrialStart_SummonMenu_ae2b4e4f:

    # SOPHIRA @ sad "I believed they had come to kill us all."
    SOPHIRA @ sad "Ich glaubte, sie seien gekommen, um uns alle zu töten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3060
translate de qst_JudgementDay_TrialStart_SummonMenu_92fdc9f7:

    # SOPHIRA @ sad "... But—"
    SOPHIRA @ sad "... Aber—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3061
translate de qst_JudgementDay_TrialStart_SummonMenu_b3423dae:

    # "Sophira hesitated, scanning the room."
    "Sophira zögerte und blickte durch den Raum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3062
translate de qst_JudgementDay_TrialStart_SummonMenu_56b7a1e0:

    # "Praising a monster? Even one who saved her?"
    "Ein Monster zu loben? Selbst eines, das sie gerettet hat?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3063
translate de qst_JudgementDay_TrialStart_SummonMenu_3bd900e6:

    # "The scandal alone could ruin her standing."
    "Der Skandal allein könnte ihre Stellung ruinieren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3064
translate de qst_JudgementDay_TrialStart_SummonMenu_c7e4c791:

    # SOPHIRA @ talk "They fought as bravely, and as valiantly, as any knight in the realm."
    SOPHIRA @ talk "Sie kämpften so tapfer und heldenhaft wie jeder Ritter im Königreich."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3065
translate de qst_JudgementDay_TrialStart_SummonMenu_25e4778c:

    # "A ripple of murmurs spread through the court."
    "Ein Raunen ging durch den Hof."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3066
translate de qst_JudgementDay_TrialStart_SummonMenu_a029fa91:

    # "A noblewoman... speaking on behalf of a monster?"
    "Eine Adlige... spricht für ein Monster?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3067
translate de qst_JudgementDay_TrialStart_SummonMenu_6635e292:

    # SOPHIRA @ talk "I can scarcely believe that the men before me today are the same creatures from that night."
    SOPHIRA @ talk "Ich kann kaum glauben, dass die Männer vor mir heute dieselben Kreaturen sind wie in jener Nacht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3068
translate de qst_JudgementDay_TrialStart_SummonMenu_9b76c90d:

    # SOPHIRA @ talk "But I would take stock of their courage before rendering judgment."
    SOPHIRA @ talk "Doch würde ich ihren Mut in Betracht ziehen, bevor ich ein Urteil fälle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3069
translate de qst_JudgementDay_TrialStart_SummonMenu_3db56853:

    # JUDGE_FALWIND "Thank you, Lady Marginott."
    JUDGE_FALWIND "Danke, Lady Marginott."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3071
translate de qst_JudgementDay_TrialStart_SummonMenu_da6a8e90:

    # JUDGE_FALWIND "Does the prosecution have any questions for the witness?"
    JUDGE_FALWIND "Hat die Anklage Fragen an die Zeugin?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3072
translate de qst_JudgementDay_TrialStart_SummonMenu_b7f6f1a5:

    # MARION @ angry "... No, your honor."
    MARION @ angry "... Nein, Euer Ehren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3073
translate de qst_JudgementDay_TrialStart_SummonMenu_68cdad91:

    # MARION @ talk "None at this time."
    MARION @ talk "Im Moment keine."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3074
translate de qst_JudgementDay_TrialStart_SummonMenu_2002683a:

    # JUDGE_FALWIND "Then the witness is dismissed."
    JUDGE_FALWIND "Dann ist die Zeugin entlassen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3076
translate de qst_JudgementDay_TrialStart_SummonMenu_577ae9c6:

    # "With a final nod, Lady Marginott left the stand, casting me a sympathetic smile before stepping away."
    "Mit einem letzten Nicken verließ Lady Marginott den Zeugenstand und warf mir ein mitfühlendes Lächeln zu, bevor sie sich entfernte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3082
translate de qst_JudgementDay_TrialStart_SummonMenu_0eca602a:

    # MARION @ angry "Hold."
    MARION @ angry "Moment."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3083
translate de qst_JudgementDay_TrialStart_SummonMenu_8f35c0bf:

    # MARION @ angry "I object to this witness's testimony."
    MARION @ angry "Ich erhebe Einspruch gegen die Aussage dieser Zeugin."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3084
translate de qst_JudgementDay_TrialStart_SummonMenu_53e4fd5b:

    # JUDGE_FALWIND "On what grounds?"
    JUDGE_FALWIND "Auf welcher Grundlage?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3085
translate de qst_JudgementDay_TrialStart_SummonMenu_717b7ab4:

    # MARION @ talk "The witness is a childhood friend of the accused and has openly admitted to harboring deep affections for him."
    MARION @ talk "Die Zeugin ist eine Jugendfreundin des Angeklagten und hat offen zugegeben, tiefe Zuneigung für ihn zu hegen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3086
translate de qst_JudgementDay_TrialStart_SummonMenu_1a2207ce:

    # MARION @ talk "Any testimony she delivers is undoubtedly tainted by personal bias."
    MARION @ talk "Jede Aussage, die sie macht, ist zweifellos durch persönliche Voreingenommenheit verfälscht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3087
translate de qst_JudgementDay_TrialStart_SummonMenu_19bd6b31:

    # MARION @ talk "Furthermore, she is a commoner. Are we truly to weigh the words of a commoner against the ruling elite of this court?"
    MARION @ talk "Außerdem ist sie eine Bürgerliche. Sollen wir wirklich die Worte einer Bürgerlichen gegen die herrschende Elite dieses Gerichts abwägen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3088
translate de qst_JudgementDay_TrialStart_SummonMenu_3b8bd5f1:

    # JUDGE_FALWIND "...Hmm."
    JUDGE_FALWIND "...Hmm."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3089
translate de qst_JudgementDay_TrialStart_SummonMenu_9ec36590:

    # JUDGE_FALWIND "I must rule in favor of the prosecution."
    JUDGE_FALWIND "Ich muss zugunsten der Anklage entscheiden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3090
translate de qst_JudgementDay_TrialStart_SummonMenu_f8f7a27e:

    # JUDGE_FALWIND "The court will not hear from Ms. Adara today."
    JUDGE_FALWIND "Das Gericht wird Frau Adara heute nicht anhören."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3092
translate de qst_JudgementDay_TrialStart_SummonMenu_31befe5e:

    # JUDGE_FALWIND "Does the defense have another witness to call?"
    JUDGE_FALWIND "Hat die Verteidigung einen weiteren Zeugen aufzurufen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3098
translate de qst_JudgementDay_TrialStart_SummonMenu_ca5239c7:

    # MARION @ angry "Objection, your honor!"
    MARION @ angry "Einspruch, Euer Ehren!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3099
translate de qst_JudgementDay_TrialStart_SummonMenu_37cf1448:

    # MARION @ talk "Only Alderian citizens may give testimony in a trial of this magnitude."
    MARION @ talk "Nur alderianische Bürger dürfen in einem Prozess dieses Ausmaßes aussagen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3100
translate de qst_JudgementDay_TrialStart_SummonMenu_84eb541e:

    # MARION @ talk "And the opinion of a Ramonian whore is hardly worth considering."
    MARION @ talk "Und die Meinung einer ramonischen Hure ist kaum der Beachtung wert."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3101
translate de qst_JudgementDay_TrialStart_SummonMenu_a9215bab:

    # JUDGE_FALWIND "Agreed. I cannot allow a foreigner to testify in this court."
    JUDGE_FALWIND "Einverstanden. Ich kann nicht zulassen, dass eine Ausländerin vor diesem Gericht aussagt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3103
translate de qst_JudgementDay_TrialStart_SummonMenu_78fc9297:

    # JUDGE_FALWIND "Does the defense have a different witness to call forth?"
    JUDGE_FALWIND "Hat die Verteidigung einen anderen Zeugen aufzurufen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3107
translate de qst_JudgementDay_TrialStart_SummonMenu_ce31a9d3:

    # JUDGE_FALWIND "Very well."
    JUDGE_FALWIND "In Ordnung."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3108
translate de qst_JudgementDay_TrialStart_SummonMenu_1d549ebf:

    # JUDGE_FALWIND "The jury shall now discuss your sentencing in private."
    JUDGE_FALWIND "Die Jury wird nun in privater Sitzung über Ihr Strafmaß beraten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3109
translate de qst_JudgementDay_TrialStart_SummonMenu_e2133de6:

    # JUDGE_FALWIND "A verdict shall be rendered upon your return to this court."
    JUDGE_FALWIND "Ein Urteil wird bei Ihrer Rückkehr an dieses Gericht verkündet."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3110
translate de qst_JudgementDay_TrialStart_SummonMenu_bfd244e2:

    # "The gavel slammed down, sealing my fate—for better or worse."
    "Der Hammer schlug nieder und besiegelte mein Schicksal – im Guten wie im Schlechten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3123
translate de qst_JudgementDay_TrialOver_Execution_fe40017f:

    # "Dragged away from the court in chains once more alongside Markus… I waited. And waited. And waited."
    "Erneut in Ketten vom Gericht weggeschleppt, zusammen mit Markus … Ich wartete. Und wartete. Und wartete."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3124
translate de qst_JudgementDay_TrialOver_Execution_62b795ad:

    # "Until at last, I was dragged back into the silent courtroom to await judgment."
    "Bis ich schließlich wieder in den stillen Gerichtssaal gezerrt wurde, um das Urteil zu erwarten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3128
translate de qst_JudgementDay_TrialOver_Execution_00f7f3ce:

    # JUDGE_FALWIND "Having consulted the jury's verdict, and given the overwhelming evidence, I shall now render judgment."
    JUDGE_FALWIND "Nachdem ich das Urteil der Geschworenen zurate gezogen habe und angesichts der erdrückenden Beweislage, werde ich nun das Urteil verkünden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3129
translate de qst_JudgementDay_TrialOver_Execution_b7a3bc33:

    # JUDGE_FALWIND "For the crime of treason, and for consorting with dark magecraft, we find you…"
    JUDGE_FALWIND "Für das Verbrechen des Hochverrats und den Umgang mit dunkler Magie befinden wir Sie …"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3130
translate de qst_JudgementDay_TrialOver_Execution_2e1e1edd:

    # "... A heavy silence filled the chamber, the entire court holding its breath in anticipation."
    "… Eine schwere Stille erfüllte den Saal, der gesamte Gerichtshof hielt in Erwartung den Atem an."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3131
translate de qst_JudgementDay_TrialOver_Execution_9fd51d0b:

    # JUDGE_FALWIND "GUILTY!"
    JUDGE_FALWIND "SCHULDIG!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3133
translate de qst_JudgementDay_TrialOver_Execution_19884929:

    # MC @ surprised "WHAT?!"
    MC @ surprised "WAS?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3135
translate de qst_JudgementDay_TrialOver_Execution_9320d748:

    # MC @ angry "No! I—"
    MC @ angry "Nein! Ich—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3137
translate de qst_JudgementDay_TrialOver_Execution_c5513172:

    # JUDGE_FALWIND "You and your companions are hereby sentenced to death!"
    JUDGE_FALWIND "Du und deine Gefährten werden hiermit zum Tode verurteilt!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3139
translate de qst_JudgementDay_TrialOver_Execution_780b4046:

    # MC @ surprised "Death?!"
    MC @ surprised "Tod?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3141
translate de qst_JudgementDay_TrialOver_Execution_7295898c:

    # MC @ angry "WE SAVED THIS CITY! WE—"
    MC @ angry "WIR HABEN DIESE STADT GERETTET! WIR—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3153
translate de qst_JudgementDay_TrialOver_Banishment_fe40017f:

    # "Dragged away from the court in chains once more alongside Markus… I waited. And waited. And waited."
    "Wieder in Ketten vom Gericht weggeschleift, zusammen mit Markus … Ich wartete. Und wartete. Und wartete."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3154
translate de qst_JudgementDay_TrialOver_Banishment_62b795ad:

    # "Until at last, I was dragged back into the silent courtroom to await judgment."
    "Bis ich schließlich wieder in den stillen Gerichtssaal geschleift wurde, um auf mein Urteil zu warten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3159
translate de qst_JudgementDay_TrialOver_Banishment_6d453a1e:

    # JUDGE_FALWIND "I must apologize for the delay in this matter, the jury deliberated for much longer than expected."
    JUDGE_FALWIND "Ich muss mich für die Verzögerung in dieser Angelegenheit entschuldigen, die Jury beriet viel länger als erwartet."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3160
translate de qst_JudgementDay_TrialOver_Banishment_ca6450d6:

    # JUDGE_FALWIND "On the charge of treason, given the severe lack of evidence, you and your companions are found…"
    JUDGE_FALWIND "Bezüglich des Vorwurfs des Hochverrats, und aufgrund des erheblichen Mangels an Beweisen, werden du und deine Gefährten für …"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3161
translate de qst_JudgementDay_TrialOver_Banishment_c368aac4:

    # JUDGE_FALWIND "NOT GUILTY!"
    JUDGE_FALWIND "NICHT SCHULDIG!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3162
translate de qst_JudgementDay_TrialOver_Banishment_a0fe577c:

    # "A ripple of applause spread through the jury, and for a fleeting moment, relief washed over me."
    "Ein beifälliges Raunen breitete sich in der Jury aus, und für einen flüchtigen Moment überkam mich Erleichterung."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3163
translate de qst_JudgementDay_TrialOver_Banishment_449d174c:

    # "... Until the judge brought his gavel down once more."
    "... bis der Richter erneut seinen Hammer niedersausen ließ."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3165
translate de qst_JudgementDay_TrialOver_Banishment_4f3e803b:

    # JUDGE_FALWIND "SILENCE!"
    JUDGE_FALWIND "RUHE!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3166
translate de qst_JudgementDay_TrialOver_Banishment_9155a3a4:

    # JUDGE_FALWIND "I have not finished!"
    JUDGE_FALWIND "Ich bin noch nicht fertig!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3167
translate de qst_JudgementDay_TrialOver_Banishment_2548ea41:

    # "The room fell into an uneasy hush, my body tensing once more."
    "Der Raum fiel in eine unbehagliche Stille, mein Körper spannte sich erneut an."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3168
translate de qst_JudgementDay_TrialOver_Banishment_675eab15:

    # JUDGE_FALWIND "… On the charge of association with dark magecraft, however…"
    JUDGE_FALWIND "… Zur Anklage der Verbindung mit dunkler Magie jedoch…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3169
translate de qst_JudgementDay_TrialOver_Banishment_a8fe0311:

    # JUDGE_FALWIND "The jury has been unable to reach a verdict."
    JUDGE_FALWIND "Die Jury konnte kein Urteil fällen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3171
translate de qst_JudgementDay_TrialOver_Banishment_4b3fa348:

    # MARION @ angry "Then under Article 46 of the Dark Magecraft Law, they are to be retried in an inquisition-only trial!"
    MARION @ angry "Dann werden sie gemäß Artikel 46 des Gesetzes über dunkle Magie in einem reinen Inquisitionsprozess erneut verhandelt!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3173
translate de qst_JudgementDay_TrialOver_Banishment_7da17868:

    # MC @ angry "That's absurd! Where is the justice in sending us to a court where the verdict is ALWAYS guilty?!"
    MC @ angry "Das ist absurd! Wo bleibt da die Gerechtigkeit, uns vor ein Gericht zu schicken, das IMMER nur schuldig spricht?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3174
translate de qst_JudgementDay_TrialOver_Banishment_c21c0838:

    # MARION @ angry "Hold your tongue, dark spawn!"
    MARION @ angry "Halt den Mund, dunkle Brut!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3175
translate de qst_JudgementDay_TrialOver_Banishment_82635a87:

    # MC @ angry "You know it's true—and so does everyone here!"
    MC @ angry "Du weißt, dass es wahr ist – und alle hier wissen es auch!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3176
translate de qst_JudgementDay_TrialOver_Banishment_4c0358b1:

    # "The jury erupted into arguments, their voices clashing as the courtroom descended into chaos."
    "Die Jury brach in Streit aus, ihre Stimmen prallten aufeinander, während der Gerichtssaal ins Chaos stürzte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3178
translate de qst_JudgementDay_TrialOver_Banishment_d4fec73d:

    # "Judge Falwind smashed his gavel down repeatedly, but the room was already spiraling out of control."
    "Richter Falwind schlug wiederholt mit seinem Hammer auf, aber der Saal geriet bereits außer Kontrolle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3179
translate de qst_JudgementDay_TrialOver_Banishment_53bfae89:

    # "At some point, one of the jury members threw a punch at another, and soon, the entire courtroom broke into a small brawl."
    "Irgendwann schlug ein Geschworener auf einen anderen ein, und bald brach im ganzen Gerichtssaal eine kleine Schlägerei aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3181
translate de qst_JudgementDay_TrialOver_Banishment_b7f53723:

    # JUDGE_FALWIND "ORDER! ORDER!"
    JUDGE_FALWIND "ORDNUNG! ORDNUNG!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3182
translate de qst_JudgementDay_TrialOver_Banishment_c4828506:

    # "Guards rushed in to break apart the scuffling jury members."
    "Wachen stürzten herein, um die raufenden Geschworenen zu trennen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3183
translate de qst_JudgementDay_TrialOver_Banishment_cb8903f3:

    # "Then, suddenly, the grand doors of the courtroom swung open with force."
    "Dann schwangen plötzlich die großen Türen des Gerichtssaals mit Wucht auf."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3186
translate de qst_JudgementDay_TrialOver_Banishment_3d95a00f:

    # GUARD "Presenting Her Royal Highness, Princess Cecilia!"
    GUARD "Ihre Königliche Hoheit, Prinzessin Cecilia!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3188
translate de qst_JudgementDay_TrialOver_Banishment_c3cc9b29:

    # "At once, the chaos ceased."
    "Sofort hörte das Chaos auf."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3189
translate de qst_JudgementDay_TrialOver_Banishment_ae4a3d99:

    # "A reverent silence filled the air as the Princess stepped forward, graceful and composed."
    "Eine ehrfürchtige Stille erfüllte den Raum, als die Prinzessin anmutig und gefasst nach vorne trat."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3190
translate de qst_JudgementDay_TrialOver_Banishment_dbf5b32e:

    # "Many members of the jury immediately fell to their knees in her presence."
    "Viele Geschworene fielen in ihrer Gegenwart sofort auf die Knie."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3194
translate de qst_JudgementDay_TrialOver_Banishment_f94d83a6:

    # "I did my best to bow graciously, though the chains binding my limbs made it an awkward, stiff gesture."
    "Ich bemühte mich nach Kräften, mich anmutig zu verbeugen, doch die Fesseln, die meine Glieder banden, machten daraus eine unbeholfene, steife Geste."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3196
translate de qst_JudgementDay_TrialOver_Banishment_d8f22788:

    # "I remained standing as the Princess approached, meeting her gaze directly."
    "Ich blieb stehen, als die Prinzessin näher kam, und erwiderte direkt ihren Blick."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3198
translate de qst_JudgementDay_TrialOver_Banishment_13d6ba25:

    # JUDGE_FALWIND "Princess Cecilia! A court such as this is no place for—"
    JUDGE_FALWIND "Prinzessin Cecilia! Ein Hof wie dieser ist kein Ort für—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3199
translate de qst_JudgementDay_TrialOver_Banishment_cfaadad3:

    # PRINCESS_CECILIA "You will be silent, good judge."
    PRINCESS_CECILIA "Ihr werdet schweigen, guter Richter."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3200
translate de qst_JudgementDay_TrialOver_Banishment_f6e05147:

    # "Judge Falwind quickly shut his mouth as the Princess turned to face the entire court."
    "Richter Falwind schloss schnell den Mund, als die Prinzessin sich umwandte, um dem gesamten Hof gegenüberzutreten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3201
translate de qst_JudgementDay_TrialOver_Banishment_2a5cb127:

    # PRINCESS_CECILIA "I have come to speak on behalf of the defendants."
    PRINCESS_CECILIA "Ich bin gekommen, um im Namen der Angeklagten zu sprechen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3202
translate de qst_JudgementDay_TrialOver_Banishment_3c956fcd:

    # JUDGE_FALWIND "P-Princess, you—"
    JUDGE_FALWIND "P-Prinzessin, Ihr—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3203
translate de qst_JudgementDay_TrialOver_Banishment_d7a467ab:

    # PRINCESS_CECILIA "Without their aid, I would not be standing here today."
    PRINCESS_CECILIA "Ohne ihre Hilfe würde ich heute nicht hier stehen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3204
translate de qst_JudgementDay_TrialOver_Banishment_6322e9c2:

    # PRINCESS_CECILIA "They fought not only to retrieve my brother during the siege but also to save my life."
    PRINCESS_CECILIA "Sie kämpften nicht nur, um meinen Bruder während der Belagerung zu bergen, sondern auch, um mein Leben zu retten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3205
translate de qst_JudgementDay_TrialOver_Banishment_8a460d03:

    # "A murmur rippled through the chamber."
    "Ein Gemurmel ging durch den Saal."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3206
translate de qst_JudgementDay_TrialOver_Banishment_8460f0a6:

    # PRINCESS_CECILIA "Even the Silver Knight himself has offered written testimony in their defense."
    PRINCESS_CECILIA "Sogar der Silberne Ritter selbst hat ein schriftliches Zeugnis zu ihrer Verteidigung vorgelegt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3207
translate de qst_JudgementDay_TrialOver_Banishment_0cb1aaa4:

    # PRINCESS_CECILIA "Therefore, I ask for a royal pardon for these creatures."
    PRINCESS_CECILIA "Daher bitte ich um eine königliche Begnadigung für diese Kreaturen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3208
translate de qst_JudgementDay_TrialOver_Banishment_f84a14e9:

    # MARION @ talk "Your Highness… The jury cannot determine if these beings are creations of dark magecraft."
    MARION @ talk "Eure Hoheit… Die Jury kann nicht feststellen, ob diese Wesen Schöpfungen dunkler Magie sind."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3209
translate de qst_JudgementDay_TrialOver_Banishment_5f7d0965:

    # MARION @ talk "The law, as decreed by both the Emperor and your father, the late King, is final."
    MARION @ talk "Das Gesetz, wie es sowohl vom Kaiser als auch von Eurem Vater, dem verstorbenen König, erlassen wurde, ist endgültig."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3210
translate de qst_JudgementDay_TrialOver_Banishment_de720fb1:

    # JUDGE_FALWIND "... Perhaps, there is a compromise."
    JUDGE_FALWIND "... Vielleicht gibt es einen Kompromiss."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3211
translate de qst_JudgementDay_TrialOver_Banishment_ec7e0b62:

    # MARION @ fury "A compromise?"
    MARION @ fury "Ein Kompromiss?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3212
translate de qst_JudgementDay_TrialOver_Banishment_20023437:

    # JUDGE_FALWIND @ talk "In light of these highly unusual circumstances, and given the testimony of the Princess herself…"
    JUDGE_FALWIND @ talk "Angesichts dieser höchst ungewöhnlichen Umstände und der Aussage der Prinzessin selbst…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3213
translate de qst_JudgementDay_TrialOver_Banishment_09113569:

    # JUDGE_FALWIND "I hereby decree that you, and your companions, are to be {b}banished{/b} from the city of Novaras."
    JUDGE_FALWIND "Hiermit verfüge ich, dass Ihr und Eure Gefährten aus der Stadt Novaras {b}verbannt{/b} seid."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3214
translate de qst_JudgementDay_TrialOver_Banishment_8a527a85:

    # MC @ surprised "... Banished?"
    MC @ surprised "... Verbannt?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3218
translate de qst_JudgementDay_TrialOver_Banishment_b404536b:

    # JUDGE_FALWIND "As for your other companions..."
    JUDGE_FALWIND "Was Eure anderen Gefährten betrifft..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3221
translate de qst_JudgementDay_TrialOver_Banishment_343be284:

