    SILVER_KNIGHT "Ich schulde dir meinen Dank."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1787
translate de qst_JudgementDay_RescueMages_MoveOn_d03a2c08:

    # MYU "Myu helped too!"
    MYU "Myu hat auch geholfen!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1789
translate de qst_JudgementDay_RescueMages_MoveOn_408a648a:

    # MYU "As did Elena!"
    MYU "Elena auch!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1790
translate de qst_JudgementDay_RescueMages_MoveOn_9ce74b32:

