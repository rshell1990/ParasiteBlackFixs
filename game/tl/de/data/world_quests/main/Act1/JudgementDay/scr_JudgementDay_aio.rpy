# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3470
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_593d5f52:

    # VES @ smile "You got a problem with that?"
    VES @ smile "Hast du ein Problem damit?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3471
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_1c642d17:

    # KIARA @ happy "None at all, but-"
    KIARA @ happy "Gar keins, aber-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3472
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_c6f5afdb:

    # KIARA @ talk "You should probably know, I'm not exactly-"
    KIARA @ talk "Du solltest wahrscheinlich wissen, ich bin nicht gerade-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3474
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_2f953db0:

    # VES @ talk "Don't care."
    VES @ talk "Egal."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3476
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_794fffe8:

    # "Without another word, Ves turned to begin gathering up what essential supplies she'd need for the journey."
    "Ohne ein weiteres Wort drehte sich Ves um und begann, die wichtigsten Vorräte zusammenzusuchen, die sie für die Reise benötigte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3479
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_e265cbe1:

    # KIARA @ talk "... Is she always such a charmer?"
    KIARA @ talk "... Ist sie immer so ein Charmeur?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3480
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_b3794603:

    # MC @ talk "She's... {i}very direct.{/i}"
    MC @ talk "Sie ist... {i}sehr direkt.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3481
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_175bd0d1:

    # MC @ smile "A bit like someone else I happen to know."
    MC @ smile "Ein bisschen wie jemand anders, den ich zufällig kenne."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3482
translate de qst_JudgementDay_PostQuestTravelToHamun_KiaraTalk2_6ad52e1f:

    # KIARA @ happy "Come, pack what you need, and let's head off!"
    KIARA @ happy "Komm, pack, was du brauchst, und lass uns losziehen!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3520
translate de qst_JudgementDay_PostQuestArrivedToHamun_13fe37de:

    # "{i}After days of travel...{/i}"
    "{i}Nach Tagen des Reisens...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3524
translate de qst_JudgementDay_PostQuestArrivedToHamun_b0ee4ab2:

    # "The great free city of Hamun laid stretched before us, a shining coastal oasis beside the roaring desert dunes."
    "Die große freie Stadt Hamun erstreckte sich vor uns, eine glänzende Küstenoase neben den tosenden Wüstendünen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3525
translate de qst_JudgementDay_PostQuestArrivedToHamun_12c7f6f4:

    # "Now under the control of the powerful merchant lords, the city had flourished into one of great splendour... And danger."
    "Nun unter der Kontrolle der mächtigen Handelsherren war die Stadt zu einer von großer Pracht erblüht... und Gefahr."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3526
translate de qst_JudgementDay_PostQuestArrivedToHamun_9a6564ac:

    # "For beneath it's shiny exterior, there were no {i}laws{/i} as such anymore in Hamun,"
    "Denn unter ihrer glänzenden Fassade gab es in Hamun keine {i}Gesetze{/i} mehr als solche,"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3527
translate de qst_JudgementDay_PostQuestArrivedToHamun_72f3238d:

    # "Only the many armed guards the various merchant factions paid to maintain their control gave some semblance of peace."
    "Nur die vielen bewaffneten Wachen, die die verschiedenen Handelsfraktionen bezahlten, um ihre Kontrolle aufrechtzuerhalten, gaben einen Anschein von Frieden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3531
translate de qst_JudgementDay_PostQuestArrivedToHamun_b2cbe1ec:

    # "But beyond the ever looming threat not to to cause unncessary trouble, the city was truly free."
    "Aber jenseits der allgegenwärtigen Drohung, bloß keinen unnötigen Ärger zu verursachen, war die Stadt wirklich frei."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3534
translate de qst_JudgementDay_PostQuestArrivedToHamun_7b096b57:

    # GUARD "HALT!"
    GUARD "HALT!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3535
translate de qst_JudgementDay_PostQuestArrivedToHamun_30a13115:

    # GUARD "What's your business in the free city?"
    GUARD "Was habt ihr in der freien Stadt zu suchen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3536
translate de qst_JudgementDay_PostQuestArrivedToHamun_04843039:

    # MC @ serious "Does it matter?"
    MC @ serious "Spielt das eine Rolle?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3537
translate de qst_JudgementDay_PostQuestArrivedToHamun_ad7dd3d2:

    # "The guard looked us up and down before laughing."
    "Der Wächter musterte uns von oben bis unten und lachte dann."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3538
translate de qst_JudgementDay_PostQuestArrivedToHamun_7454ce35:

    # GUARD "Only if you cause trouble."
    GUARD "Nur wenn du Ärger machst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3539
translate de qst_JudgementDay_PostQuestArrivedToHamun_9786878e:

    # GUARD "You start something, don't be surprised if you find yourself losing your head."
    GUARD "Wenn du etwas anfängst, wundere dich nicht, wenn du deinen Kopf verlierst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3543
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_233a9947:

    # GUARD "Neigh."
    GUARD "Wieher."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3544
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_a5c97cc1:

    # GUARD "But no laws doesn't mean no ones in charge."
    GUARD "Aber keine Gesetze bedeutet nicht, dass niemand das Sagen hat."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3545
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_592f6245:

    # GUARD "Pretty much every business in the city has some kind of security... Fuck around, and you'll find yourself skewed on the pointy end of one of them."
    GUARD "So ziemlich jedes Geschäft in der Stadt hat irgendeine Art von Sicherheitspersonal... Mach Scheiße, und du wirst am spitzen Ende eines von ihnen aufgespießt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3548
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_1b30c97c:

    # GUARD "{i}Lord{/i} Iryiad runs the most powerful clique, the Zizi, they run the security detail around the city and control the docks."
    GUARD "{i}Lord{/i} Iryiad führt die mächtigste Clique an, die Zizi, sie betreiben den Sicherheitsdienst in der Stadt und kontrollieren die Docks."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3549
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_148038fe:

    # GUARD "But there's also the Quaygon, the Vulmar and an endless sea of smaller gangs who manage the whores, the raza, and the {i}'protection'{/i} of the local businesses."
    GUARD "Aber es gibt auch die Quaygon, die Vulmar und ein endloses Meer von kleineren Banden, die sich um die Huren, den Raza und den {i}'Schutz'{/i} der örtlichen Geschäfte kümmern."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3550
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_3712bd09:

    # MC @ think "You seem very forthcoming with all this."
    MC @ think "Du scheinst mit all dem sehr freimütig zu sein."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3551
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_659b07b0:

    # GUARD "Some people come here and think because we've no laws they can just do {i}whatever{/i} they like."
    GUARD "Einige Leute kommen hierher und denken, weil wir keine Gesetze haben, können sie einfach {i}tun, was sie wollen{/i}."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3552
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_2750a12b:

    # GUARD "It's best to let them know that would be a poor choice."
    GUARD "Es ist am besten, sie wissen zu lassen, dass das eine schlechte Wahl wäre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3555
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_d13669b0:

    # GUARD "Do I look like a tour guide?"
    GUARD "Sehe ich aus wie ein Fremdenführer?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3556
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_d3bb6433:

    # GUARD "Fuck off, buy yourself a couple sellswords and have them show you around!"
    GUARD "Verpiss dich, kauf dir ein paar Söldner und lass sie dir die Gegend zeigen!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3560
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_276c314a:

    # GUARD "Go on then, in ya get."
    GUARD "Na los, rein mit dir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3568
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_15e2997a:

    # KIARA @ happy "Ahh... Finally! We've made it."
    KIARA @ happy "Ahh... Endlich! Wir haben es geschafft."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3569
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_310c3340:

    # MC @ talk "What now?"
    MC @ talk "Was nun?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3570
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_3a698037:

    # KIARA @ talk "{i}The Pale Dragon.{/i}"
    KIARA @ talk "{i}Der blasse Drache.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3571
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6351a36b:

    # KIARA @ talk "It's an inn nearby, we have a room already prepared for us."
    KIARA @ talk "Es ist ein Gasthaus in der Nähe, wir haben bereits ein Zimmer für uns vorbereitet."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3574
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_3dc1a544:

    # MARKUS @ shock "Gods... Look at this place!"
    MARKUS @ shock "Götter... Schau dir diesen Ort an!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3575
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_b702726f:

    # MARKUS @ shock "I had heard rumors about how much the city had changed since it broke away, but-"
    MARKUS @ shock "Ich hatte Gerüchte gehört, wie sehr sich die Stadt verändert hatte, seit sie sich losgesagt hat, aber-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3576
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_095355cd:

    # MARKUS @ joy "It's certainly an impressive sight."
    MARKUS @ joy "Es ist auf jeden Fall ein beeindruckender Anblick."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3582
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_4999deb8:

    # VES @ talk "..."
    VES @ talk "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3584
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_93e74526:

    # MC @ talk "Ves? Are you alright?"
    MC @ talk "Ves? Geht es dir gut?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3585
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_2fda7f15:

    # VES @ talk "Yes... Just-"
    VES @ talk "Ja... Nur-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3586
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_a866539e:

    # VES @ blush "It's been a long time since I've been around so many people."
    VES @ blush "Es ist lange her, dass ich unter so vielen Menschen war."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3587
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6eec3fc9:

    # MC @ talk "So, what's your plan now you're here?"
    MC @ talk "Also, was hast du jetzt vor, wo du hier bist?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3591
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_64bb87e3:

    # VES @ talk "I'm looking for someone."
    VES @ talk "Ich suche jemanden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3592
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_17dd6ac1:

    # VES @ blush "... But, perhaps if you don't mind, I could stay with you and the others for a while."
    VES @ blush "... Aber vielleicht könnte ich, wenn es dir nichts ausmacht, eine Weile bei dir und den anderen bleiben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3593
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6a80da6d:

    # MC @ think "Who are you looking for?"
    MC @ think "Wen suchst du?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3594
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_1b256352:

    # "Ves opened her mouth to say something, but she paused and smiled awkwardly, changing the subject quickly."
    "Ves öffnete den Mund, um etwas zu sagen, aber sie hielt inne und lächelte verlegen, wobei sie schnell das Thema wechselte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3595
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_2c8bbd11:

    # VES @ smile "I'll... tell you about it another time."
    VES @ smile "Ich... erzähle dir ein andermal davon."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3596
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_f97d9bbc:

    # VES @ talk "Come, I'm tired... Let's find this {i}Pale Dragon.{/i}"
    VES @ talk "Komm, ich bin müde... Lass uns diesen {i}Blassen Drachen.{/i} finden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3610
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_bad11f44:

    # "Smoke rose from every corner of the inn, a mixture of strange, hot aromas like that of sweet, crushed flowers all mixed in."
    "Rauch stieg aus jeder Ecke der Taverne, eine Mischung aus seltsamen, heißen Düften wie von süßen, zerstoßenen Blumen, die sich alle darin vermischten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3611
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_8ac356c7:

    # "With every breath, you could feel a small surge of energy as the whole place seemed embraced by a hazy fog."
    "Mit jedem Atemzug konnte man einen kleinen Energieschub spüren, während der ganze Ort von einem dunstigen Nebel umarmt schien."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3612
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_a9959744:

    # "Sat hudled around tables, men, women, {i}other things,{/i} sat smoking from their pipes as the raza choked the air."
    "An den Tischen zusammengedrängt saßen Männer, Frauen, {i}andere Dinge,{/i} und rauchten aus ihren Pfeifen, während der Raza die Luft verqualmte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3613
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_007901a8:

    # "In and around the place were guards, always watching, already ready for trouble, as the loosely dressed women served drinks."
    "Überall im und um das Lokal herum waren Wachen, stets wachsam, schon bereit für Ärger, während die leicht bekleideten Frauen Getränke servierten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3617
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_4e4e3c61:

    # RANIA @ talk "Welcome... Welcome to {i}The Pale dragon,{/i} I am your host, Rania."
    RANIA @ talk "Willkommen... Willkommen im {i}Blassen Drachen,{/i} ich bin eure Gastgeberin, Rania."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3619
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_456841ec:

    # RANIA @ talk "What pleasures do you and your companions seek?"
    RANIA @ talk "Welche Vergnügungen sucht ihr und eure Begleiter?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3620
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_72b4870f:

    # RANIA @ smile "Perhaps some Raza or... {i}companionship?{/i}"
    RANIA @ smile "Vielleicht etwas Raza oder... {i}Gesellschaft?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3621
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_e06794ab:

    # "The woman looked towards me and Markus, pulling down her dress slightly to expose a breast as she winked."
    "Die Frau blickte zu mir und Markus hinüber, zog ihr Kleid leicht herunter, um eine Brust zu entblößen, während sie zwinkerte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3622
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_b4652a2d:

    # MC @ lewd "Well-"
    MC @ lewd "Nun-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3623
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_b70528c0:

    # KIARA @ angry "We should be meeting a friend here in one of the rooms upstairs."
    KIARA @ angry "Wir sollten hier in einem der Zimmer oben einen Freund treffen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3624
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_0d2e6967:

    # KIARA @ talk "{i}The one with a view so you might see the dragon to the east.{/i}"
    KIARA @ talk "{i}Das mit der Aussicht, so dass Sie vielleicht den Drachen im Osten sehen können.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3625
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6b161c8d:

    # "Rania's eyes widened as she smiled."
    "Ranias Augen weiteten sich, als sie lächelte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3626
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_26dbca39:

    # RANIA @ smile "Ahh... Yes."
    RANIA @ smile "Ahh... Ja."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3627
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_18a797f5:

    # RANIA @ smile "Everything is already ready for you, first room on the left upstairs."
    RANIA @ smile "Alles ist bereits für Sie vorbereitet, das erste Zimmer links oben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3628
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_9856acc2:

    # "Rania's eyes glanced over towards those with me."
    "Ranias Blick glitt zu meinen Begleitern."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3629
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_8f3729b3:

    # RANIA @ talk "For your companions, we have some rooms further down the hall."
    RANIA @ talk "Für Ihre Begleiter haben wir einige Zimmer weiter den Gang hinunter."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3630
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_367b6b8c:

    # RANIA @ smile "We hope you enjoy your stay with us."
    RANIA @ smile "Wir hoffen, Sie genießen Ihren Aufenthalt bei uns."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3640
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_8baba82b:

    # MC @ talk "... Now what?"
    MC @ talk "... Was nun?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3641
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_95d5d7eb:

    # KIARA @ talk "Rest. Stay here the night where it's safe, in the morning then, my mistress should join us."
    KIARA @ talk "Ruhen Sie sich aus. Bleiben Sie die Nacht hier, wo es sicher ist, am Morgen dann sollte meine Herrin zu uns stoßen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3642
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_9483b162:

    # MC @ think "You still haven't explained everything like you said you would."
    MC @ think "Du hast immer noch nicht alles erklärt, wie du es versprochen hattest."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3643
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_384a3513:

    # KIARA @ talk "In time, for now, just rest."
    KIARA @ talk "Alles zu seiner Zeit. Ruhe dich jetzt erstmal aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3644
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_5303acdd:

    # KIARA @ talk "It's been quite the journey just to get here."
    KIARA @ talk "Es war eine ziemliche Reise, nur um hierherzukommen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3645
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_4e981b88:

    # MC @ serious "... Fine."
    MC @ serious "... In Ordnung."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3646
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_5e60fe78:

    # KIARA @ talk "Just call if you need me."
    KIARA @ talk "Ruf einfach, wenn du mich brauchst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3653
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6b3d694c:

    # MC "(...Just what am I walking into now?)"
    MC "(...Worin gerate ich jetzt nur hinein?)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3654
translate de qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_78e5b98a:

    # MC "(I should get some rest.)"
    MC "(Ich sollte mich etwas ausruhen.)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3684
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_b2f9b151:

    # "... Swirling around me, an endless black sea cut through by a rift of stars and strange colors."
    "... Um mich herum wirbelnd, ein endloses schwarzes Meer, durchschnitten von einem Riss aus Sternen und seltsamen Farben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3685
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_f69770e0:

    # "Three bright suns surrounded a great dark circle, radiating a strange power."
    "Drei helle Sonnen umgaben einen großen dunklen Kreis, der eine seltsame Macht ausstrahlte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3686
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_df7c51ac:

    # "Stood on some strange rock platform, the two figures, unlike anything I'd ever seen before, turned their gaze towards me."
    "Auf einer seltsamen Felsplattform stehend, wandten die beiden Gestalten, wie ich sie noch nie zuvor gesehen hatte, ihren Blick mir zu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3687
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_dc2b54fd:

    # MC "Where... Where am I?"
    MC "Wo... Wo bin ich?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3688
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_ff987929:

    # "I looked down, gazing for where my hands, my body, {i}something{/i} should be."
    "Ich blickte nach unten und suchte nach der Stelle, wo meine Hände, mein Körper, {i}etwas{/i} sein sollte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3689
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_a4b95f12:

    # "But there was nothing... It was as though I was just two floating, unblinking eyes, unable to move."
    "Aber da war nichts... Es war, als wäre ich nur zwei schwebende, unbewegliche Augen, unfähig mich zu bewegen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3696
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_545bd3fb:

    # "I spoke... And yet my mouth did not move."
    "Ich sprach... Und doch bewegte sich mein Mund nicht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3697
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_46bc43b7:

    # HIRRAH "Greetings... [player_name!t]."
    HIRRAH "Grüße... [player_name!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3698
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_088be4d0:

    # HIRRAH "Or is it, {i}Shyahtan?{/i}"
    HIRRAH "Oder ist es, {i}Shyahtan?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3699
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_d745a6ac:

    # "The strange being seemed to chuckle, her soft voice so strangely hypnotic and soothing."
    "Das seltsame Wesen schien zu kichern, ihre sanfte Stimme so seltsam hypnotisierend und beruhigend."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3700
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_4989ee90:

    # HIRRAH "Always so hard to keep up these days."
    HIRRAH "Heutzutage immer so schwer mitzuhalten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3701
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_82579f71:

    # PHOAH @ angry "We're wasting time, Hirrah."
    PHOAH @ angry "Wir verschwenden Zeit, Hirrah."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3702
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_e85088b4:

    # HIRRAH "The last thing we need is to frighten him."
    HIRRAH "Das Letzte, was wir brauchen, ist, ihn zu erschrecken."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3703
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_5800b448:

    # MC "Who... Who are you both?"
    MC "Wer... Wer seid ihr beide?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3704
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_fad590e3:

    # MC "What am I doing here?!"
    MC "Was mache ich hier?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3705
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_270e83dd:

    # PHOAH @ angry "See? Now the human is panicking anyway!"
    PHOAH @ angry "Siehst du? Jetzt gerät der Mensch sowieso in Panik!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3706
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_c5966931:

    # HIRRAH "Human might be quite the stretch given the circumstances."
    HIRRAH "Mensch ist vielleicht ziemlich hochgegriffen, angesichts der Umstände."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3707
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_914501fa:

    # MC "W-Where am I?"
    MC "W-Wo bin ich?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3708
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_8899306e:

    # MC "What is this place??"
    MC "Was ist das für ein Ort??"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3709
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_3249a9fb:

    # MC "WHO ARE YOU?"
    MC "WER SEID IHR?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3710
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_b8c817a1:

    # PHOAH @ talk "{i}*Sigh*{/i}"
    PHOAH @ talk "{i}*Seufz*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3711
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_03dbc9d5:

    # PHOAH @ angry "I am Phoah, goddess of justice."
    PHOAH @ angry "Ich bin Phoah, Göttin der Gerechtigkeit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3712
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_2025b956:

    # PHOAH @ talk "This is Hirrah, goddess of fertility."
    PHOAH @ talk "Das ist Hirrah, Göttin der Fruchtbarkeit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3713
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_9ef7dad6:

    # "I stared at the strange beings before me in disbelief."
    "Ich starrte ungläubig auf die seltsamen Wesen vor mir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3714
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_741be655:

    # "Were they..."
    "Waren sie..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3715
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_3e1c9fce:

    # "No, gods and goddesses... Such a ridiculous thing!"
    "Nein, Götter und Göttinnen... Was für eine lächerliche Sache!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3716
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_901a1c10:

    # "This was nothing but some fever dream! A trick of the mind! A-"
    "Das war nichts als ein Fiebertraum! Ein Trick des Verstandes! Ein-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3717
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_390ecba2:

    # PHOAH @ talk "We're real."
    PHOAH @ talk "Wir sind real."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3718
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_6ddce6b3:

    # MC "You... You can hear my thoughts?"
    MC "Du... Du kannst meine Gedanken hören?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3719
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_10192e1c:

    # HIRRAH "This place is not real, rather, a neural link projection we've created to speak to you."
    HIRRAH "Dieser Ort ist nicht real, sondern eine neuronale Verbindungsprojektion, die wir erschaffen haben, um mit dir zu sprechen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3720
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_8749ecba:

    # MC "...{i}A what?{/i}"
    MC "...{i}Ein was?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3721
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_601508d9:

    # HIRRAH "... I-"
    HIRRAH "... Ich-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3722
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_826861e5:

    # HIRRAH "It matters not."
    HIRRAH "Es spielt keine Rolle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3723
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_fda2299b:

    # PHOAH @ angry "Look, human, we need your help."
    PHOAH @ angry "Schau, Mensch, wir brauchen deine Hilfe."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3724
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_a6825e69:

    # MC "{i}Me?{/i}"
    MC "{i}Ich?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3725
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_36f9cc51:

    # PHOAH @ talk "Listen carefully, human."
    PHOAH @ talk "Hör gut zu, Mensch."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3726
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_c0534bbf:

    # PHOAH @ talk "This world... It has become the focus of the great deciever's dark plan."
    PHOAH @ talk "Diese Welt... Sie ist zum Fokus des dunklen Plans des großen Betrügers geworden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3727
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_eabc2515:

    # MC "{i}... The great deciever?{/i}"
    MC "{i}... Der große Betrüger?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3728
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_de037a92:

    # "The goddess' hands tightened into tight fists."
    "Die Hände der Göttin ballten sich zu festen Fäusten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3729
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_9fb2387c:

    # PHOAH @ angry "The lord of lies..."
    PHOAH @ angry "Der Herr der Lügen..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3730
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_024f2b0d:

    # PHOAH @ angry "{b}Malakai.{/b}"
    PHOAH @ angry "{b}Malakai.{/b}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3731
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_013508b0:

    # PHOAH @ angry "The one who bought ruin upon both the old gods and the new with his treacherous war."
    PHOAH @ angry "Derjenige, der mit seinem verräterischen Krieg Verderben über die alten wie die neuen Götter brachte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3732
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_89848511:

    # PHOAH @ angry "No doubt he yearns to take a physical form once more."
    PHOAH @ angry "Zweifellos sehnt er sich danach, erneut eine physische Form anzunehmen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3733
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_75a790db:

    # MC "I... I don't understand."
    MC "Ich... ich verstehe nicht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3734
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_a323a245:

    # MC "Malakai? {i}The{/i} Malakai?"
    MC "Malakai? {i}Der{/i} Malakai?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3735
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_3126cf19:

    # "The dark god himself... Every child in Alderay knew the story of Malakai."
    "Der dunkle Gott selbst... Jedes Kind in Alderay kannte die Geschichte von Malakai."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3736
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_5c7fea02:

    # "Legend speak of how his betrayal destroyed the old and new gods in the greatest war to ever be fought."
    "Die Legende spricht davon, wie sein Verrat die alten und neuen Götter im größten Krieg, der je geführt wurde, zerstörte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3737
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_5e1d502e:

    # MC "This is... This cannot be..."
    MC "Das ist... Das kann nicht sein..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3738
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_61b39614:

    # MC "He... {i}He's real?{/i}"
    MC "Er... {i}Er ist real?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3739
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_c2ee7902:

    # HIRRAH "His flesh may be gone, but his spirit survives... Trapped beyond the gate of midnight."
    HIRRAH "Sein Fleisch mag vergangen sein, aber sein Geist überlebt... Gefangen jenseits des Tors der Mitternacht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3740
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_b514f426:

    # HIRRAH "{i}Imprisoned with Arda.{/i}"
    HIRRAH "{i}Gefangen mit Arda.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3741
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_50736f37:

    # PHOAH @ talk "Zanarak, his chosen champion has arrived to serve some purpose we do not fully understand."
    PHOAH @ talk "Zanarak, sein auserwählter Champion, ist angekommen, um einem Zweck zu dienen, den wir nicht vollständig verstehen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3742
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_2419d9f9:

    # PHOAH @ talk "And if that wasn't enough proof, {i}she{/i} is here."
    PHOAH @ talk "Und wenn das nicht genug Beweis wäre, {i}sie{/i} ist hier."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3743
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_e6bffe1a:

    # PHOAH @ talk "Malakai's right hand, the chaos goddess, Gimera has taken form once more and walks this place."
    PHOAH @ talk "Malakais rechte Hand, die Chaosgöttin Gimera, hat wieder Gestalt angenommen und wandelt an diesem Ort."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3744
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_0bf94686:

    # HIRRAH "Human... You must help us."
    HIRRAH "Mensch... Du musst uns helfen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3745
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_a7e0d8f5:

    # HIRRAH "Serve as our champion."
    HIRRAH "Diene als unser Champion."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3746
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_4f4136b8:

    # HIRRAH "While we find and stop Gimera, we must work together!"
    HIRRAH "Während wir Gimera finden und aufhalten, müssen wir zusammenarbeiten!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3747
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_e91157ba:

    # HIRRAH "No matter the cost..."
    HIRRAH "Um jeden Preis..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3748
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_644eb481:

    # HIRRAH "{i}Malakai can never be allowed to walk the physical planes once more.{/i}"
    HIRRAH "{i}Malakai darf niemals wieder die physischen Ebenen betreten.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3751
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_8e7bf52d:

    # PHOAH @ talk "Malakai destroyed everything we had built."
    PHOAH @ talk "Malakai hat alles zerstört, was wir aufgebaut hatten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3752
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2b4ac252:

    # PHOAH @ talk "All our hopes and dreams, everything Arda spent countless millenia working to achieve."
    PHOAH @ talk "All unsere Hoffnungen und Träume, alles, wofür Arda unzählige Jahrtausende gearbeitet hat."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3753
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2c206515:

    # PHOAH @ talk "{i}The gateways to unite the realms, the unity of the old gods and new...{/i}"
    PHOAH @ talk "{i}Die Tore, um die Reiche zu vereinen, die Einheit der alten und neuen Götter...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3754
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_0eb52d5f:

    # PHOAH @ talk "All of it was undone by Malakai in his quest to re-forge reality in his image."
    PHOAH @ talk "All das wurde von Malakai zunichtegemacht, als er die Realität nach seinem Ebenbild neu formen wollte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3755
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_782b7b35:

    # "Phoah paused for a moment, the rage slightly softening as she seemed to be thinking back to those dark days."
    "Phoah hielt einen Moment inne, die Wut ließ etwas nach, als sie an jene dunklen Tage zurückzudenken schien."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3756
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2e97c5dc:

    # PHOAH @ sad "{i}... It wasn't always so though.{/i}"
    PHOAH @ sad "{i}... Es war jedoch nicht immer so.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3757
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2dc1e7da:

    # PHOAH @ sad "Before that monster, Gimera decieved him into opening the {i}Macarum,{/i} Malakai went by a different name."
    PHOAH @ sad "Bevor jenes Monster, Gimera, ihn dazu brachte, das {i}Macarum{/i} zu öffnen, trug Malakai einen anderen Namen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3758
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_b127e26a:

    # PHOAH @ sad "Malayan the curious."
    PHOAH @ sad "Malayan der Neugierige."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3759
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2a09741c:

    # MC "The Macarum?"
    MC "Das Macarum?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3760
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_cbdac6af:

    # PHOAH @ talk "{i}When Arda was born, he was a made a being of pure good, pure love.{/i}"
    PHOAH @ talk "{i}Als Arda geboren wurde, wurde er zu einem Wesen reiner Güte, reiner Liebe gemacht.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3761
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_f3b5dcfb:

    # PHOAH @ talk "... But in order to become that, he cast off his darkness... sealed it away into a forbidden box beyond the knowledge and reach of even the gods."
    PHOAH @ talk "... Aber um das zu werden, warf er seine Dunkelheit ab... versiegelte sie in einer verbotenen Kiste, jenseits des Wissens und der Reichweite selbst der Götter."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3762
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_062aedaa:

    # PHOAH @ angry "Guided by terrible visions of an impending war between the old gods and the new, Gimera decieved Malayan that only the power of the box could prevent the war."
    PHOAH @ angry "Von schrecklichen Visionen eines bevorstehenden Krieges zwischen den alten und den neuen Göttern geleitet, täuschte Gimera Malayan und machte ihm glauben, dass nur die Macht der Kiste den Krieg verhindern könnte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3763
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_c432b0f4:

    # PHOAH @ sad "Little did Malayan know by opening it, the visions he fought to stop would come true."
    PHOAH @ sad "Malayan wusste nicht, dass durch das Öffnen der Kiste die Visionen, die er zu verhindern kämpfte, wahr werden würden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3767
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_36b03c3f:

    # "Hirrah let out a sharp chuckle."
    "Hirrah stieß ein scharfes Kichern aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3768
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_cd066754:

    # HIRRAH "And who is supposed to answer?"
    HIRRAH "Und wer soll antworten?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3769
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_5abe17b2:

    # PHOAH @ angry "Hirrah!"
    PHOAH @ angry "Hirrah!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3770
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_418142c0:

    # HIRRAH "Do not coddle the human... Letting him put his faith in what can never answer will lead him down a path of destruction."
    HIRRAH "Verhätschele den Menschen nicht... Ihn sein Vertrauen in das setzen zu lassen, was niemals antworten kann, wird ihn auf einen zerstörerischen Pfad führen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3771
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7208330b:

    # MC "{i}The... The gods no longer heard us?{/i}"
    MC "{i}Die... Die Götter haben uns nicht mehr erhört?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3772
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_88785898:

    # PHOAH @ talk "After the war, so few of us remain, even now."
    PHOAH @ talk "Nach dem Krieg sind selbst jetzt noch so wenige von uns übrig."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3773
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_ac5cf9c8:

    # PHOAH @ sad "So many died... Yhoshan... Taruna... Palam."
    PHOAH @ sad "So viele starben... Yhoshan... Taruna... Palam."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3774
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_59eb52b3:

    # HIRRAH "Once, during Arda's reign, thousands of us roamed the stars."
    HIRRAH "Einst, während Ardas Herrschaft, durchstreiften Tausende von uns die Sterne."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3775
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_91cef8f1:

    # HIRRAH "Now, perhaps only a few hundred remain... {i}if that.{/i}"
    HIRRAH "Jetzt sind vielleicht nur noch ein paar Hundert übrig... {i}wenn überhaupt.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3776
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7cc2b286:

    # MC "... So, we truly stand alone then?"
    MC "... Also stehen wir dann wirklich allein?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3777
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_9cadd45f:

    # PHOAH @ talk "{i}The gods won't answer your prayers, because the gods can't even save themselves right now.{/i}"
    PHOAH @ talk "{i}Die Götter werden deine Gebete nicht erhören, denn die Götter können sich im Moment nicht einmal selbst retten.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3781
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2b832d9a:

    # PHOAH @ talk "Surely you know the stories?"
    PHOAH @ talk "Sicherlich kennst du die Geschichten?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3782
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_492b8793:

    # PHOAH @ talk "Has it truly been that long that truth has become some kind of warped myth?"
    PHOAH @ talk "Ist es wirklich so lange her, dass die Wahrheit zu einer Art verzerrtem Mythos geworden ist?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3783
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_59d51f4b:

    # MC "I know he waged war against Tzenvachian and the new gods."
    MC "Ich weiß, dass er Krieg gegen Tzenvachian und die neuen Götter geführt hat."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3784
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_5370bf83:

    # "The two goddess' shared a strange look with each other."
    "Die beiden Göttinnen warfen sich einen seltsamen Blick zu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3785
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_76aa7f84:

    # PHOAH @ talk "Tzenvachian...?"
    PHOAH @ talk "Tzenvachian...?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3786
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_00d0e69d:

    # PHOAH @ talk "Hmm... Arda took many names, I wonder where that one came from?"
    PHOAH @ talk "Hmm... Arda nahm viele Namen an, ich frage mich, wo dieser herkam?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3787
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_1dcbee42:

    # MC "His name was {i}Arda?{/i}"
    MC "Sein Name war {i}Arda?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3788
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_eec23752:

    # PHOAH @ talk "That is how {i}we{/i} knew him long ago..."
    PHOAH @ talk "So kannten {i}wir{/i} ihn vor langer Zeit..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3789
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_fc689b9a:

    # PHOAH @ sad "So very... very, long ago."
    PHOAH @ sad "So sehr... sehr, sehr lange her."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3790
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_c16eb2ef:

    # "The goddess seemed to drift off into thought before her focus returned to the present."
    "Die Göttin schien in Gedanken abzuschweifen, bevor ihre Aufmerksamkeit in die Gegenwart zurückkehrte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3791
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_a33ccf8d:

    # PHOAH @ talk "He is trapped with Malakai beyond the gate of midnight."
    PHOAH @ talk "Er ist mit Malakai jenseits des Tors der Mitternacht gefangen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3792
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7b5e1c34:

    # PHOAH @ sad "His... sacrifice saved us all."
    PHOAH @ sad "Sein... Opfer hat uns alle gerettet."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3796
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_5810aa0a:

    # "The two goddesses looked at each other."
    "Die beiden Göttinnen sahen sich an."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3797
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_ce1de7b4:

    # HIRRAH "Ah... It's probably been so long since of your kind has seen us, it is little surprise you don't know."
    HIRRAH "Ah... Es ist wahrscheinlich so lange her, dass jemand eurer Art uns gesehen hat, es ist wenig überraschend, dass du es nicht weißt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3798
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_8bba6f6b:

    # HIRRAH "I am one of the {i}old gods,{/i} crafted in Al'Vazah's original vision."
    HIRRAH "Ich bin einer der {i}alten Götter,{/i} erschaffen in Al'Vazahs ursprünglicher Vision."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3799
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_558da106:

    # PHOAH @ talk "And I was born with the new gods, under Arda's light."
    PHOAH @ talk "Und ich wurde mit den neuen Göttern geboren, unter Ardas Licht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3800
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_ade75c27:

    # MC "I thought the old gods and the new hated each other?"
    MC "Ich dachte, die alten Götter und die neuen hassen einander?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3801
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_f7fa8558:

    # HIRRAH "{i}Not all of us.{/i}"
    HIRRAH "{i}Nicht alle von uns.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3802
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_536cc37e:

    # HIRRAH "This one's company help's starve off at least a couple centuries of boredom."
    HIRRAH "Die Gesellschaft dieser einen hilft, wenigstens ein paar Jahrhunderte Langeweile abzuwehren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3803
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_0ba21b83:

    # "The goddess Phoah shot her an irritable glance."
    "Die Göttin Phoah warf ihr einen gereizten Blick zu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3804
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_4d24952c:

    # PHOAH @ angry "I do wonder {i}why{/i} I keep you around sometimes."
    PHOAH @ angry "Ich frage mich schon {i}warum{/i} ich dich manchmal noch bei mir behalte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3805
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_8e58abc8:

    # HIRRAH "Because you'd continue to spiral and despair with the rest of the gods if I didn't drag you to your feet."
    HIRRAH "Weil du weiterhin mit den restlichen Göttern in Verzweiflung und Verfall versinkst, wenn ich dich nicht auf die Beine ziehe."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3806
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2a746e81:

    # "The goddess let out a heavy sigh."
    "Die Göttin stieß einen schweren Seufzer aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3807
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_564f281f:

    # PHOAH @ talk "There are so few of us left, the old wars hardly seem to matter anymore."
    PHOAH @ talk "Es sind so wenige von uns übrig, die alten Kriege scheinen kaum noch von Bedeutung zu sein."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3808
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_746c0279:

    # PHOAH @ talk "Just surviving... Just... Hoping Al'Vazah brings us a new light."
    PHOAH @ talk "Einfach nur überleben... Einfach nur... Hoffen, dass Al'Vazah uns ein neues Licht bringt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3809
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_6e92921d:

    # HIRRAH "{i}That's her way of saying she means we're friends.{/i}"
    HIRRAH "{i}Auf ihre Weise meint sie damit, dass wir Freunde sind.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3814
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_d88f683e:

    # PHOAH @ talk "With the being now awakened and attached to you, it cannot be a coincidence that Gimera has decided to suddenly return now."
    PHOAH @ talk "Bei dem Wesen, das jetzt erwacht und an dich gebunden ist, kann es kein Zufall sein, dass Gimera sich nun plötzlich entschieden hat zurückzukehren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3815
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_950d62e6:

    # MC "{i}Why?{/i} What is so special about the creature...Shyahtan, or whatever it's name is?"
    MC "{i}Warum?{/i} Was ist so besonders an dem Wesen... Shyahtan, oder wie auch immer es heißt?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3816
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_3884832b:

    # HIRRAH "We do not know."
    HIRRAH "Wir wissen es nicht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3817
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_e8c384f7:

    # MC "What?! Then how can-"
    MC "Was?! Wie kann dann-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3818
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_398147e3:

    # PHOAH @ talk "The being that is attached itself to you has some kind of great significance to Malakai."
    PHOAH @ talk "Das Wesen, das sich an dich gebunden hat, hat eine große Bedeutung für Malakai."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3819
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_51e583f1:

    # PHOAH @ talk "I have no doubt Zanarak... Gimera herself perhaps."
    PHOAH @ talk "Ich habe keinen Zweifel, Zanarak ... Gimera selbst vielleicht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3820
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_de78d651:

    # PHOAH @ angry "{i}Something is coming for you.{/i}"
    PHOAH @ angry "{i}Etwas kommt auf dich zu.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3821
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_e675ec55:

    # MC "I don't understand... Malakai... He was defeated! He's gone!"
    MC "Ich verstehe nicht ... Malakai ... Er wurde besiegt! Er ist fort!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3822
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_3b7a05a9:

    # HIRRAH "He was only imprisoned."
    HIRRAH "Er wurde nur eingesperrt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3823
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_f8a407f5:

    # HIRRAH "His spirit if allowed a vessel, may yet break free of his chains."
    HIRRAH "Sein Geist, wenn ihm ein Gefäß gewährt wird, könnte sich noch aus seinen Ketten befreien."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3824
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_c8c3acb9:

    # MC "But he... How can he harm us?"
    MC "Aber er ... Wie kann er uns schaden?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3825
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_009531cc:

    # HIRRAH "His shadow stretches far, even beyond his confinment."
    HIRRAH "Sein Schatten reicht weit, selbst über seine Gefangenschaft hinaus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3826
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_3e4f6113:

    # PHOAH @ talk "When the time comes, human, stand with us."
    PHOAH @ talk "Wenn die Zeit gekommen ist, Mensch, steh an unserer Seite."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3827
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7101f9fa:

    # PHOAH @ talk "{i}Or the darkness will consume us all...{/i}"
    PHOAH @ talk "{i}Oder die Dunkelheit wird uns alle verschlingen ...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3828
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_bb70e29a:

    # HIRRAH "Phoah... Do you feel that?"
    HIRRAH "Puh... Spürst du das?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3829
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_f949dd11:

    # PHOAH @ shock "What? That can't be-"
    PHOAH @ shock "Was? Das kann nicht sein-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3830
translate de qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_da322b39:

    # HIRRAH "Sever the connection! He's here! He's-"
    HIRRAH "Trennt die Verbindung! Er ist hier! Er ist-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3845
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_3746dc62:

    # "Springing from the bed, I found myself confronting some strange, naked, bat like creature who pulled back startled when they realized I was awake."
    "Aus dem Bett springend sah ich mich einer seltsamen, nackten, fledermausartigen Kreatur gegenüber, die erschrocken zurückwich, als sie merkte, dass ich wach war."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3846
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_eaabee22:

    # KIARA @ scared "{i}*Gasp!*{/i}"
    KIARA @ scared "{i}*Keuchen!*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3847
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_31159433:

    # "As my hand quickly morphed into a set of claws and lunged forward, the creature pulled back and cried out in a familiar voice."
    "Als meine Hand sich schnell in eine Reihe von Klauen verwandelte und nach vorne stieß, wich die Kreatur zurück und rief mit vertrauter Stimme aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3849
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_b4b7dbed:

    # KIARA @ scared "Wait! [player_name!t]! It's me!"
    KIARA @ scared "Warte! [player_name!t]! Ich bin's!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3850
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_0f9e1586:

    # KIARA @ scared "It's Kiara!"
    KIARA @ scared "Es ist Kiara!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3851
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_a980e7bc:

    # "As the image before me came clearer, the pale, beautiful bat-like woman waited sheepishly, trembling slightly with fear."
    "Als das Bild vor mir klarer wurde, wartete die bleiche, schöne, fledermausartige Frau verlegen und zitterte leicht vor Angst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3852
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_93885b50:

    # MC @ surprised "... Kiara?"
    MC @ surprised "... Kiara?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3853
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_533c965f:

    # MC @ surprised "Is that... Really you?"
    MC @ surprised "Bist du das... wirklich?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3854
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_fc54bc90:

    # "She nodded."
    "Sie nickte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3855
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_4cfffe6f:

    # KIARA @ sad "I... I'm sorry."
    KIARA @ sad "Ich... Es tut mir leid."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3856
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_9c626fac:

    # KIARA @ sad "I came to see you tonight, I wanted to talk and explain things in private."
    KIARA @ sad "Ich bin heute Abend gekommen, um dich zu sehen, ich wollte unter vier Augen mit dir reden und die Dinge erklären."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3857
translate de qst_JudgementDay_PostQuestArrivedToHamun_WakeUp_63c6ca8f:

    # MC @ angry "What in the hells is going on?!"
    MC @ angry "Was zum Teufel ist hier los?!"

