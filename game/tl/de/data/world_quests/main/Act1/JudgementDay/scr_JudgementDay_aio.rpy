    "Elena wandte nervös ihren Blick ab."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1791
translate de qst_JudgementDay_RescueMages_MoveOn_eb378171:

    # ELENA "H-Hello…"
    ELENA "H-Hallo…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1792
translate de qst_JudgementDay_RescueMages_MoveOn_538e24d3:

    # SILVER_KNIGHT "…Then you also have my thanks."
    SILVER_KNIGHT "…Dann habt Ihr auch meinen Dank."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1794
translate de qst_JudgementDay_RescueMages_MoveOn_6186d54d:

    # ERIKA "We're heading up the wall. Is the prince safe?"
    ERIKA "Wir gehen die Mauer hinauf. Ist der Prinz sicher?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1795
translate de qst_JudgementDay_RescueMages_MoveOn_c6f5af92:

    # "The knight nodded slightly."
    "Der Ritter nickte leicht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1796
translate de qst_JudgementDay_RescueMages_MoveOn_d71c3886:

    # SILVER_KNIGHT "He is safe now, my prince."
    SILVER_KNIGHT "Er ist jetzt in Sicherheit, mein Prinz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1797
translate de qst_JudgementDay_RescueMages_MoveOn_aeb7f7dd:

    # "From behind a narrow alley, a short, timid figure emerged."
    "Hinter einer schmalen Gasse trat eine kleine, schüchterne Gestalt hervor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1799
translate de qst_JudgementDay_RescueMages_MoveOn_0adbee41:

    # "His features were delicate, almost effeminate."
    "Seine Gesichtszüge waren zart, fast weiblich."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1800
translate de qst_JudgementDay_RescueMages_MoveOn_70af855b:

    # "His wide, uncertain eyes flickered between me and my companions."
    "Seine großen, unsicheren Augen huschten zwischen mir und meinen Gefährten hin und her."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1801
translate de qst_JudgementDay_RescueMages_MoveOn_efd77777:

    # SILVER_KNIGHT "They are not a threat, my lord."
    SILVER_KNIGHT "Sie sind keine Bedrohung, mein Lord."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1802
translate de qst_JudgementDay_RescueMages_MoveOn_a4943c53:

    # "The young prince hesitated, his voice soft and uncertain."
    "Der junge Prinz zögerte, seine Stimme weich und unsicher."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1803
translate de qst_JudgementDay_RescueMages_MoveOn_60479631:

    # PRINCE_NARAN "Volsta… W-What manner of creatures are these?"
    PRINCE_NARAN "Volsta… W-Was für Wesen sind das?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1804
translate de qst_JudgementDay_RescueMages_MoveOn_6a63e30d:

    # SILVER_KNIGHT "I do not know, my prince."
    SILVER_KNIGHT "Das weiß ich nicht, mein Prinz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1805
translate de qst_JudgementDay_RescueMages_MoveOn_cfc016bf:

    # SILVER_KNIGHT "But we must return you to the castle at once."
    SILVER_KNIGHT "Aber wir müssen Euch sofort zum Schloss zurückbringen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1806
translate de qst_JudgementDay_RescueMages_MoveOn_557191f0:

    # PRINCE_NARAN "But… those monsters are still everywhere!"
    PRINCE_NARAN "Aber … diese Monster sind immer noch überall!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1807
translate de qst_JudgementDay_RescueMages_MoveOn_d0d11aac:

    # "The prince clung tightly to the Silver Knight, trembling."
    "Der Prinz klammerte sich zitternd fest an den Silberritter."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1808
translate de qst_JudgementDay_RescueMages_MoveOn_f110ccdb:

    # SILVER_KNIGHT "I will keep you safe, Naran."
    SILVER_KNIGHT "Ich werde dich beschützen, Naran."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1810
translate de qst_JudgementDay_RescueMages_MoveOn_5346539a:

    # SILVER_KNIGHT "But we must move now."
    SILVER_KNIGHT "Aber wir müssen uns jetzt bewegen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1812
translate de qst_JudgementDay_RescueMages_MoveOn_b772a928:

    # "Above us, a deafening explosion rocked the sky as a section of the wall burst into flames."
    "Über uns erschütterte eine ohrenbetäubende Explosion den Himmel, als ein Teil der Mauer in Flammen aufging."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1813
translate de qst_JudgementDay_RescueMages_MoveOn_1b696125:

    # ERIKA "We need to hurry, quickly!"
    ERIKA "Wir müssen uns beeilen, schnell!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1818
translate de qst_JudgementDay_RescueMages_MoveOn_71348209:

    # "Suddenly, from the surrounding buildings and alleyways, a chorus of unnatural growls echoed."
    "Plötzlich hallte ein Chor unnatürlicher Knurrlaute aus den umliegenden Gebäuden und Gassen wider."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1819
translate de qst_JudgementDay_RescueMages_MoveOn_010ca37a:

    # "More of those monstrous ghouls began to emerge, shambling toward us from every direction."
    "Noch mehr dieser monströsen Ghule tauchten auf und schlurften von allen Seiten auf uns zu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1820
translate de qst_JudgementDay_RescueMages_MoveOn_29b99d09:

    # PRINCE_NARAN "J-Jaras!"
    PRINCE_NARAN "J-Jaras!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1821
translate de qst_JudgementDay_RescueMages_MoveOn_9a9ed357:

    # "The prince recoiled, hiding behind the Silver Knight as he slowly unsheathed his blade."
    "Der Prinz zuckte zurück und versteckte sich hinter dem Silbernen Ritter, während er langsam seine Klinge zog."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1822
translate de qst_JudgementDay_RescueMages_MoveOn_990d309c:

    # SILVER_KNIGHT "Stay behind me, my prince."
    SILVER_KNIGHT "Bleibt hinter mir, mein Prinz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1823
translate de qst_JudgementDay_RescueMages_MoveOn_1047baf5:

    # "The knight briefly glanced toward us."
    "Der Ritter warf uns einen kurzen Blick zu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1824
translate de qst_JudgementDay_RescueMages_MoveOn_d64ff1da:

    # SILVER_KNIGHT "Go. Secure the wall."
    SILVER_KNIGHT "Geht. Sichert die Mauer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1825
translate de qst_JudgementDay_RescueMages_MoveOn_576c8cba:

    # SILVER_KNIGHT "{i}I will handle the monsters…{/i}"
    SILVER_KNIGHT "{i}Ich kümmere mich um die Monster…{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1831
translate de qst_JudgementDay_GotToTheWall_3fcc22a5:

    # "We didn't waste a second, sprinting toward the large wooden lift."
    "Wir verloren keine Sekunde und sprinteten zu dem großen hölzernen Aufzug."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1832
translate de qst_JudgementDay_GotToTheWall_6073686b:

    # ERIKA "This should take us straight to the top."
    ERIKA "Der sollte uns direkt nach oben bringen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1834
translate de qst_JudgementDay_GotToTheWall_9dbc9a64:

    # MARKUS "We'll be completely exposed up there!"
    MARKUS "Da oben sind wir völlig ungeschützt!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1835
translate de qst_JudgementDay_GotToTheWall_27615f39:

    # MARKUS "Does it even still work?"
    MARKUS "Funktioniert der überhaupt noch?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1836
translate de qst_JudgementDay_GotToTheWall_aa491b95:

    # ERIKA "We don't have time to take the stairs! We're going up now!"
    ERIKA "Wir haben keine Zeit, die Treppe zu nehmen! Wir fahren jetzt hoch!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1837
translate de qst_JudgementDay_GotToTheWall_0897d6bb:

    # "With a sharp pull of the lever, the mechanical gears below groaned as the wooden lift jolted to life, carrying us upward."
    "Mit einem kräftigen Zug am Hebel ächzten die mechanischen Zahnräder unter uns, als der hölzerne Aufzug ruckartig zum Leben erwachte und uns nach oben beförderte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1838
translate de qst_JudgementDay_GotToTheWall_16d33ca3:

    # "As we ascended, the devastation of the city became clearer."
    "Während wir aufstiegen, wurde die Verwüstung der Stadt deutlicher."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1839
translate de qst_JudgementDay_GotToTheWall_bacb7b9b:

    # "The once-proud walls of Novaras were engulfed in fire and smoke."
    "Die einst stolzen Mauern von Novaras waren in Feuer und Rauch gehüllt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1840
translate de qst_JudgementDay_GotToTheWall_00f72ca3:

    # "From above, Demorai siege weapons continued their relentless assault, launching massive fireballs against the city's defenses."
    "Von oben setzten die Belagerungswaffen der Demorai ihren unerbittlichen Angriff fort und schleuderten gewaltige Feuerbälle gegen die Verteidigungsanlagen der Stadt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1841
translate de qst_JudgementDay_GotToTheWall_2c227e01:

    # MARKUS "By the gods… Will there even be a city left after this?"
    MARKUS "Bei den Göttern … Wird nach all dem überhaupt noch eine Stadt übrig sein?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1844
translate de qst_JudgementDay_GotToTheWall_fa61c815:

    # MYU @ sad "…M-Myu."
    MYU @ sad "…M-Myu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1846
translate de qst_JudgementDay_GotToTheWall_25b4d31a:

    # ELENA @ grumpy "Cities can be rebuilt."
    ELENA @ grumpy "Städte können wieder aufgebaut werden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1847
translate de qst_JudgementDay_GotToTheWall_656dce71:

    # ELENA @ grumpy "But battles can only be won or lost once."
    ELENA @ grumpy "Aber Schlachten können nur einmal gewonnen oder verloren werden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1849
translate de qst_JudgementDay_GotToTheWall_f908c05a:

    # ERIKA "Stay focused. We're almost at the top."
    ERIKA "Bleib konzentriert. Wir sind fast oben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1857
translate de qst_JudgementDay_GotToTheWall_a17a25b5:

    # "After a few agonizing minutes, the lift finally came to a grinding halt."
    "Nach einigen quälenden Minuten kam der Aufzug endlich knirschend zum Stehen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1858
translate de qst_JudgementDay_GotToTheWall_f29fff7d:

    # "The scene atop the wall was grim—scattered corpses of Alderian soldiers and Demorai invaders lay piled on top of one another."
    "Der Anblick oben auf der Mauer war düster – verstreute Leichen von alderischen Soldaten und Demorai-Invasoren lagen übereinandergehäuft."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1859
translate de qst_JudgementDay_GotToTheWall_d8b69886:

    # "A few Demorai ladders had made it onto the ramparts, their corpses still clinging to the edges where they had been cut down."
    "Einige Demorai-Leitern hatten es auf die Brustwehren geschafft, ihre Leichen klammerten sich noch an den Rändern fest, wo sie niedergemetzelt worden waren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1860
translate de qst_JudgementDay_GotToTheWall_c9bf0fae:

    # "Archers and mages fired relentlessly at the invading forces below, doing everything in their power to hold the line."
    "Bogenschützen und Magier feuerten unerbittlich auf die Invasoren unten und taten alles in ihrer Macht Stehende, um die Linie zu halten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1863
translate de qst_JudgementDay_GotToTheWall_71f4d550:

    # MC "…Fuck."
    MC "…Scheiße."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1865
translate de qst_JudgementDay_GotToTheWall_21733e58:

    # ERIKA "Come on. Don't get distracted."
    ERIKA "Komm schon. Lass dich nicht ablenken."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1866
translate de qst_JudgementDay_GotToTheWall_5429ae5b:

    # ERIKA "We need to clear whatever's disrupting the—"
    ERIKA "Wir müssen klären, was auch immer die Sache stört –"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1867
translate de qst_JudgementDay_GotToTheWall_4a94010a:

    # GUARD "GRAAAGHHHH!"
    GUARD "GRAAAGHHHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1868
translate de qst_JudgementDay_GotToTheWall_98ed862f:

    # "A severed body flew past us, crashing into the stone wall with a sickening crunch."
    "Ein abgetrennter Körper flog an uns vorbei und krachte mit einem widerlichen Knirschen gegen die Steinmauer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1869
translate de qst_JudgementDay_GotToTheWall_4913ab10:

    # "In that instant, I heard it—that terrifying, inhuman screech."
    "In diesem Augenblick hörte ich es – diesen schrecklichen, unmenschlichen Schrei."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1870
translate de qst_JudgementDay_GotToTheWall_fd6c3497:

    # "The one I had tried so desperately to forget."
    "Der, den ich so verzweifelt zu vergessen versucht hatte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1871
translate de qst_JudgementDay_GotToTheWall_99243f1e:

    # ERIKA "This way! Hurry!"
    ERIKA "Hier entlang! Schnell!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1874
translate de qst_JudgementDay_GotToTheWall_de2902b7:

    # "We raced forward, just in time to see the last few remaining soldiers fall before… {i}him.{/i}"
    "Wir stürmten vorwärts, gerade rechtzeitig, um die letzten verbliebenen Soldaten vor … {i}ihm{/i} fallen zu sehen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1875
translate de qst_JudgementDay_GotToTheWall_e1cfaba3:

    # "A towering figure, his body thick as though it was armor, stood in the center of the carnage."
    "Eine hochgewachsene Gestalt, sein Körper so massiv, als wäre er eine Rüstung, stand inmitten des Gemetzels."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1876
translate de qst_JudgementDay_GotToTheWall_f0fe6ce7:

    # "His wicked, jagged spear dripped with fresh blood."
    "Sein grotesker, gezackter Speer triefte vor frischem Blut."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1877
translate de qst_JudgementDay_GotToTheWall_34948751:

    # "His eyes locked onto mine."
    "Seine Augen hefteten sich auf meine."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1878
translate de qst_JudgementDay_GotToTheWall_c929a621:

    # "A grin spread across his face—sharp, cruel, and filled with bloodlust."
    "Ein Grinsen breitete sich auf seinem Gesicht aus – scharf, grausam und voller Blutdurst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1879
translate de qst_JudgementDay_GotToTheWall_af76e327:

    # "My heart sank."
    "Mein Herz sank."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1880
translate de qst_JudgementDay_GotToTheWall_2d82985c:

    # MC "…Zanarak."
    MC "…Zanarak."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1884
translate de qst_JudgementDay_GotToTheWall_e37ec79a:

    # "A suffocating, oppressive darkness seemed to fall over the wall."
    "Eine erstickende, bedrückende Dunkelheit schien über die Mauer hereinzubrechen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1885
translate de qst_JudgementDay_GotToTheWall_1e1e9d23:

    # "Even Erika, normally calm and collected, turned pale, her hand trembling over the hilt of her sword."
    "Sogar Erika, normalerweise ruhig und gefasst, wurde blass, ihre Hand zitterte über dem Griff ihres Schwertes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1888
translate de qst_JudgementDay_GotToTheWall_57628c6b:

    # ELENA "{i}*Scared whine*{/i}"
    ELENA "{i}*Ängstliches Wimmern*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1890
translate de qst_JudgementDay_GotToTheWall_a056d149:

    # MYU @ scared "{i}M-Monster…{/i}"
    MYU @ scared "{i}M-Monster…{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1895
translate de qst_JudgementDay_GotToTheWall_72762340:

    # "Zanarak slowly turned, his gaze fixed solely on me."
    "Zanarak drehte sich langsam um, sein Blick allein auf mich gerichtet."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1896
translate de qst_JudgementDay_GotToTheWall_22388e3f:

    # "And then, without warning, he lunged."
    "Und dann, ohne Vorwarnung, stürzte er sich auf mich."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1906
translate de qst_JudgementDay_GotToTheWall_40b7d132:

    # "The battle was unlike anything I had faced until now."
    "Der Kampf war anders als alles, was ich bisher erlebt hatte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1907
translate de qst_JudgementDay_GotToTheWall_39c25025:

    # "Zanarak, despite his immense size, moved with unsettling grace—dodging effortlessly, his massive frame reacting as though unhindered by weight."
    "Zanarak bewegte sich trotz seiner immensen Größe mit beunruhigender Anmut – wich mühelos aus, sein massiger Körper reagierte, als wäre er von Gewicht unbehindert."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1908
translate de qst_JudgementDay_GotToTheWall_d8ea2162:

    # "Even when an attack did land, he merely shrugged it off as if it were nothing."
    "Selbst wenn ein Angriff traf, schüttelte er ihn einfach ab, als wäre es nichts."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1909
translate de qst_JudgementDay_GotToTheWall_2e2557b1:

    # "As I glanced at my companions, exhausted and barely holding on, I realized the horrifying truth…"
    "Als ich einen Blick auf meine Gefährten warf, erschöpft und kaum noch auf den Beinen, wurde mir die schreckliche Wahrheit klar…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1910
translate de qst_JudgementDay_GotToTheWall_47ec6fe6:

    # "He wasn't struggling."
    "Er hatte keine Mühe."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1911
translate de qst_JudgementDay_GotToTheWall_32467e73:

    # "He wasn't even fighting seriously."
    "Er kämpfte nicht einmal ernsthaft."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1912
translate de qst_JudgementDay_GotToTheWall_a7597b61:

    # "{i}He was toying with us.{/i}"
    "{i}Er spielte mit uns.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1913
translate de qst_JudgementDay_GotToTheWall_c61a2c46:

    # ERIKA "HRGHHH!"
    ERIKA "HRGHHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1914
translate de qst_JudgementDay_GotToTheWall_15950112:

    # "With a final desperate cry, Erika launched herself forward, her blade raised high."
    "Mit einem letzten verzweifelten Schrei stürzte sich Erika nach vorne, die Klinge hoch erhoben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1915
translate de qst_JudgementDay_GotToTheWall_4285eebc:

    # "But Zanarak was too fast."
    "Aber Zanarak war zu schnell."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1916
translate de qst_JudgementDay_GotToTheWall_af60ec47:

    # "Before she could react, he struck with the wooden end of his spear—sending her sprawling across the ground, knocked unconscious from the sheer force."
    "Bevor sie reagieren konnte, schlug er mit dem hölzernen Ende seines Speeres zu – und schleuderte sie quer über den Boden, wo sie durch die schiere Wucht bewusstlos liegen blieb."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1919
translate de qst_JudgementDay_GotToTheWall_d0c83444:

    # "Elena snarled, lunging forward with everything she had."
    "Elena knurrte und stürzte sich mit allem, was sie hatte, nach vorne."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1921
translate de qst_JudgementDay_GotToTheWall_bb941210:

    # "But with one swift motion, Zanarak slammed his massive arm downward, smashing her into the ground."
    "Doch mit einer schnellen Bewegung schlug Zanarak mit seinem massiven Arm nach unten und schmetterte sie zu Boden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1922
translate de qst_JudgementDay_GotToTheWall_9abbc337:

    # MC "ELENA!"
    MC "ELENA!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1923
translate de qst_JudgementDay_GotToTheWall_aeed41b1:

    # "She let out a weak, pitiful whimper, her body spasming as blood pooled beneath her."
    "Sie stieß ein schwaches, erbärmliches Wimmern aus, während ihr Körper zuckte und sich Blut unter ihr sammelte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1925
translate de qst_JudgementDay_GotToTheWall_f1d6d252:

    # MYU "NO HURT FRIENDS!"
    MYU "KEINE FREUNDE VERLETZEN!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1926
translate de qst_JudgementDay_GotToTheWall_3b2ec697:

    # "Myu sprang forward, dissolving her form and wrapping herself around Zanarak's body like a suffocating mass."
    "Myu sprang vorwärts, löste ihre Form auf und schlang sich wie eine erstickende Masse um Zanaraks Körper."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1927
translate de qst_JudgementDay_GotToTheWall_ab518742:

    # "For the first time, he seemed irritated as Myu stabbed and slashed at him relentlessly."
    "Zum ersten Mal schien er gereizt, als Myu unerbittlich auf ihn einstach und einschlug."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1929
translate de qst_JudgementDay_GotToTheWall_315df7ea:

    # "But then, with a wave of his arm, flames erupted from his form, and Myu let out a pained cry."
    "Aber dann, mit einer Handbewegung, brachen Flammen aus seiner Gestalt hervor, und Myu stieß einen schmerzerfüllten Schrei aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1930
translate de qst_JudgementDay_GotToTheWall_36b19fae:

    # "Scorched and weakened, she collapsed to the ground—a melted puddle, unable to reform."
    "Versengt und geschwächt brach sie zu Boden – eine geschmolzene Pfütze, unfähig, sich wieder zu formen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1933
translate de qst_JudgementDay_GotToTheWall_68b83c20:

    # MARKUS "Together, brother! We strike together!"
    MARKUS "Gemeinsam, Bruder! Wir schlagen gemeinsam zu!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1934
translate de qst_JudgementDay_GotToTheWall_92e2c614:

    # "Markus and I attacked in unison, our combined strength focusing on one final, desperate assault."
    "Markus und ich griffen gleichzeitig an, unsere vereinte Kraft auf einen letzten, verzweifelten Angriff konzentriert."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1935
translate de qst_JudgementDay_GotToTheWall_a397fbb9:

    # "But it was over before it had even begun."
    "Aber es war vorbei, bevor es überhaupt begonnen hatte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1936
translate de qst_JudgementDay_GotToTheWall_dff9c915:

    # "Markus' punch connected—solid and forceful—yet Zanarak barely acknowledged it."
    "Markus' Schlag traf – fest und kraftvoll – doch Zanarak nahm ihn kaum wahr."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1937
translate de qst_JudgementDay_GotToTheWall_f3aea9b7:

    # "With a swift motion, his tail slashed through the air, carving deep into Markus' side."
    "Mit einer schnellen Bewegung peitschte sein Schwanz durch die Luft und schnitt tief in Markus' Seite."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1938
translate de qst_JudgementDay_GotToTheWall_d399b9f1:

    # MARKUS "G-GAGHHH!"
    MARKUS "G-GAGHHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1939
translate de qst_JudgementDay_GotToTheWall_c2430590:

    # "He collapsed onto his knees, clutching at the deep wound."
    "Er brach auf die Knie zusammen und umklammerte die tiefe Wunde."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1940
translate de qst_JudgementDay_GotToTheWall_1a3b9a59:

    # "Blood seeped between his fingers, but he couldn't move—he was finished."
    "Blut sickerte zwischen seinen Fingern hindurch, aber er konnte sich nicht bewegen – er war erledigt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1941
translate de qst_JudgementDay_GotToTheWall_17d17147:

    # MC "MARKUS! Stay down!"
    MC "MARKUS! Bleib unten!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1942
translate de qst_JudgementDay_GotToTheWall_1e82d5e2:

    # MARKUS "[player_name!t]... Go! Run!"
    MARKUS "[player_name!t]... Geh! Lauf!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1943
translate de qst_JudgementDay_GotToTheWall_70508f78:

    # MARKUS "GAHHHRHH!"
    MARKUS "GAHHHRHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1944
translate de qst_JudgementDay_GotToTheWall_f9921ced:

    # "I had no time to react."
    "Ich hatte keine Zeit zu reagieren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1945
translate de qst_JudgementDay_GotToTheWall_c82c9475:

    # "With every swipe of my claws, every desperate slash of my tail, Zanarak effortlessly dodged or deflected each blow."
    "Mit jedem Hieb meiner Klauen, jedem verzweifelten Schlag meines Schwanzes wich Zanarak mühelos jedem Schlag aus oder wehrte ihn ab."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1946
translate de qst_JudgementDay_GotToTheWall_a8e9a2dc:

    # "Then, in an instant, I felt it."
    "Dann, in einem Augenblick, spürte ich es."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1948
translate de qst_JudgementDay_GotToTheWall_42369323:

    # "His massive hand shot forward, seizing two of my tentacles in a vice-like grip."
    "Seine riesige Hand schoss vor und packte zwei meiner Tentakel mit eisernem Griff."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1950
translate de qst_JudgementDay_GotToTheWall_21b2696c:

    # "A sharp, sickening *RIP.*"
    "Ein scharfes, widerliches *RIP.*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1951
translate de qst_JudgementDay_GotToTheWall_11ee58d3:

    # "The agony was beyond anything I had ever felt before."
    "Die Qual war jenseits von allem, was ich je zuvor gefühlt hatte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1952
translate de qst_JudgementDay_GotToTheWall_72b5c84c:

    # "My vision blurred as my severed limbs fell to the ground, blood oozing from the torn flesh."
    "Meine Sicht verschwamm, als meine abgetrennten Gliedmaßen zu Boden fielen und Blut aus dem zerfetzten Fleisch sickerte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1953
translate de qst_JudgementDay_GotToTheWall_a5adb4b7:

    # MC "AAARRRRGHHHHH!"
    MC "AAARRRRGHHHHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1954
translate de qst_JudgementDay_GotToTheWall_2132aa90:

    # MARKUS "NOOOO!"
    MARKUS "NEEEIN!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1955
translate de qst_JudgementDay_GotToTheWall_a9ab8759:

    # MARKUS "S-STOP! JUST RUN! RUN, YOU FOOL!"
    MARKUS "S-STOPP! LAUF EINFACH! LAUF, DU NARR!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1956
translate de qst_JudgementDay_GotToTheWall_69a05f56:

    # "But it was too late."
    "Aber es war zu spät."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1957
translate de qst_JudgementDay_GotToTheWall_2d81aa1a:

    # "My body was breaking apart."
    "Mein Körper zerbrach."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1959
translate de qst_JudgementDay_GotToTheWall_6b0ff152:

    # "Each strike that landed sent fresh waves of pain through my already shattered form."
    "Jeder Treffer, der landete, sandte frische Schmerzwellen durch meine bereits zerschmetterte Gestalt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1960
translate de qst_JudgementDay_GotToTheWall_336845b8:

    # "Cracks formed beneath my hardened skin as bones snapped, each breath becoming more labored, more painful."
    "Risse bildeten sich unter meiner verhärteten Haut, als Knochen brachen, jeder Atemzug wurde mühsamer, schmerzhafter."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1961
translate de qst_JudgementDay_GotToTheWall_b6de2780:

    # "I could taste the blood pooling in my mouth, feel it seeping from my eyes."
    "Ich konnte das Blut schmecken, das sich in meinem Mund sammelte, und spürte, wie es aus meinen Augen sickerte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1962
translate de qst_JudgementDay_GotToTheWall_b2ad3240:

    # "Panic. Desperation. Fear."
    "Panik. Verzweiflung. Angst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1963
translate de qst_JudgementDay_GotToTheWall_d479b378:

    # "Death loomed before me, his form taking the shape of Zanarak himself."
    "Der Tod ragte vor mir auf, seine Gestalt nahm die Form von Zanarak selbst an."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1964
translate de qst_JudgementDay_GotToTheWall_f9ffc254:

    # "With one final, desperate swing, I lashed out—"
    "Mit einem letzten, verzweifelten Schlag holte ich aus—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1965
translate de qst_JudgementDay_GotToTheWall_ca581d5d:

    # "But Zanarak caught my arm effortlessly."
    "Aber Zanarak fing meinen Arm mühelos auf."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1966
translate de qst_JudgementDay_GotToTheWall_9e796c9e:

    # "Before I could even react, his fingers tightened around my throat."
    "Bevor ich auch nur reagieren konnte, schlossen sich seine Finger um meine Kehle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1967
translate de qst_JudgementDay_GotToTheWall_88204d76:

    # "I gasped, my body thrashing uselessly in his grip."
    "Ich keuchte, mein Körper zuckte nutzlos in seinem Griff."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1968
translate de qst_JudgementDay_GotToTheWall_397f1252:

    # "He barely needed to exert any force—his strength was so absolute, I could hardly move."
    "Er brauchte kaum Kraft aufzuwenden—seine Stärke war so absolut, dass ich mich kaum bewegen konnte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1969
translate de qst_JudgementDay_GotToTheWall_8e67d57c:

    # "He pulled me closer, his sharp teeth gleaming in the firelight, his eyes filled with amusement."
    "Er zog mich näher, seine scharfen Zähne glänzten im Feuerschein, seine Augen voller Belustigung."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1970
translate de qst_JudgementDay_GotToTheWall_f74c514b:

    # "A short, cruel snort escaped him."
    "Ein kurzes, grausames Schnauben entfuhr ihm."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1971
translate de qst_JudgementDay_GotToTheWall_00289bc1:

    # ZANARAK "{i}Is that ALL you have?{/i}"
    ZANARAK "{i}Ist das ALLES, was du hast?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1972
translate de qst_JudgementDay_GotToTheWall_57bf87e0:

    # "I knew this was it."
    "Ich wusste, das war es."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1973
translate de qst_JudgementDay_GotToTheWall_81c6a098:

    # "But even if I was going to die here, at the very least—"
    "Aber selbst wenn ich hier sterben würde, zumindest—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1974
translate de qst_JudgementDay_GotToTheWall_a0852290:

    # "I wanted to wipe that smug, twisted grin from his face."
    "Ich wollte dieses selbstgefällige, verdrehte Grinsen von seinem Gesicht wischen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1975
translate de qst_JudgementDay_GotToTheWall_07c94f4f:

    # "With the last of my strength, I lunged forward—slamming my forehead into his."
    "Mit letzter Kraft stürzte ich mich nach vorne—und rammte meine Stirn gegen seine."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1976
translate de qst_JudgementDay_GotToTheWall_c4c09bc4:

    # "For the first time, his expression changed."
    "Zum ersten Mal veränderte sich sein Gesichtsausdruck."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1977
translate de qst_JudgementDay_GotToTheWall_4b867086:

    # "Not pain. Not fear. But… irritation."
    "Nicht Schmerz. Nicht Angst. Sondern… Gereiztheit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1978
translate de qst_JudgementDay_GotToTheWall_9f038ff7:

    # "Then, with a single swing, he hurled me across the battlefield like a broken doll."
    "Dann, mit einem einzigen Schlag, schleuderte er mich wie eine kaputte Puppe über das Schlachtfeld."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1980
translate de qst_JudgementDay_GotToTheWall_aae3b595:

    # "I crashed into the stone wall, my body limp, useless."
    "Ich krachte gegen die Steinmauer, mein Körper schlaff, nutzlos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1981
translate de qst_JudgementDay_GotToTheWall_0cd19f7e:

    # "I couldn't move."
    "Ich konnte mich nicht bewegen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1982
translate de qst_JudgementDay_GotToTheWall_a864ad24:

    # "Even the smallest motion felt impossible."
    "Selbst die kleinste Bewegung fühlte sich unmöglich an."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1983
translate de qst_JudgementDay_GotToTheWall_b48ebd90:

    # "My body was broken—shattered."
    "Mein Körper war gebrochen – zerschmettert."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1984
translate de qst_JudgementDay_GotToTheWall_196aa8c1:

    # "All I could do was breathe."
    "Alles, was ich tun konnte, war atmen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1985
translate de qst_JudgementDay_GotToTheWall_5a0477a4:

    # "Breathe in."
    "Atme ein."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1986
translate de qst_JudgementDay_GotToTheWall_ada46278:

    # "Breathe out."
    "Atme aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1990
translate de qst_JudgementDay_GotToTheWall_0ec89b66:

    # "Each breath was excruciating."
    "Jeder Atemzug war qualvoll."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1991
translate de qst_JudgementDay_GotToTheWall_e96a5b75:

    # "The battlefield faded into white noise."
    "Das Schlachtfeld verblasste zu weißem Rauschen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1994
translate de qst_JudgementDay_GotToTheWall_84cee36c:

    # "Was this really it?"
    "War es das wirklich?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1995
translate de qst_JudgementDay_GotToTheWall_3f826642:

    # "Was this how I was going to die?"
    "Würde ich so sterben?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1996
translate de qst_JudgementDay_GotToTheWall_777b1e75:

    # "My thoughts swirled in a haze as I saw Zanarak approaching."
    "Meine Gedanken wirbelten in einem Dunst, als ich Zanarak näherkommen sah."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1997
translate de qst_JudgementDay_GotToTheWall_eb19f7e5:

    # "His spear was raised high, glistening in the firelight—ready to deliver the final blow."
    "Sein Speer war hoch erhoben und glitzerte im Feuerschein – bereit, den letzten Schlag zu führen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1998
translate de qst_JudgementDay_GotToTheWall_84a9b709:

    # MC "(Adara... everyone... I'm sorry...)"
    MC "(Adara ... alle ... es tut mir leid ...)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2000
translate de qst_JudgementDay_GotToTheWall_e2f007ac:

    # "I closed my eyes, waiting for the end."
    "Ich schloss die Augen und wartete auf das Ende."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2001
translate de qst_JudgementDay_GotToTheWall_14d8434b:

    # REGINA "{i}*Whistles*{/i}"
    REGINA "{i}*Pfeift*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2002
translate de qst_JudgementDay_GotToTheWall_cecab571:

    # "My eyes fluttered open—just barely."
    "Meine Augen öffneten sich flatternd – kaum merklich."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2010
translate de qst_JudgementDay_GotToTheWall_c8f6334b:

    # "A silhouette stood before me, dressed in flowing black robes."
    "Eine Silhouette stand vor mir, in wallende schwarze Roben gehüllt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2011
translate de qst_JudgementDay_GotToTheWall_8f8d6fbd:

    # "Her piercing gaze…"
    "Ihr durchdringender Blick …"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2012
translate de qst_JudgementDay_GotToTheWall_8cd09fc7:

    # "Her eyes were burning, glowing with an eerie purple light."
    "Ihre Augen brannten, glühten in einem unheimlichen violetten Licht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2013
translate de qst_JudgementDay_GotToTheWall_f48a3502:

    # "{i}Regina?{/i}"
    "{i}Regina?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2014
translate de qst_JudgementDay_GotToTheWall_67c3a78d:

    # "Zanarak paused, his attention snapping toward her."
    "Zanarak hielt inne, sein Blick schnellte zu ihr."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2015
translate de qst_JudgementDay_GotToTheWall_29f53885:

    # "For the first time, he hesitated."
    "Zum ersten Mal zögerte er."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2016
translate de qst_JudgementDay_GotToTheWall_810d77d2:

    # REGINA "I'm afraid that one belongs to me."
    REGINA "Ich fürchte, das gehört mir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2017
translate de qst_JudgementDay_GotToTheWall_2d783a8c:

    # REGINA "{i}You{/i} cannot have them, Lord of Death."
    REGINA "{i}Du{/i} kannst sie nicht haben, Herr des Todes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2018
translate de qst_JudgementDay_GotToTheWall_30ba9b7b:

    # "A low growl rumbled from Zanarak's throat."
    "Ein tiefes Knurren dröhnte aus Zanaraks Kehle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2019
translate de qst_JudgementDay_GotToTheWall_65b1c4dc:

    # "But then, his body tensed as Regina lifted her hand."
    "Doch dann spannte sich sein Körper, als Regina ihre Hand hob."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2025
translate de qst_JudgementDay_GotToTheWall_8784d294:

    # "A blinding burst of pure energy surged from her palm, slamming into him with the force of a divine hammer."
    "Ein blendender Strahl reiner Energie schoss aus ihrer Handfläche und traf ihn mit der Wucht eines göttlichen Hammers."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2029
translate de qst_JudgementDay_GotToTheWall_5f0f8fc6:

    # "Then another."
    "Dann noch einer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2034
translate de qst_JudgementDay_GotToTheWall_ced8bc7e:

    # "And another."
    "Und noch einer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2035
translate de qst_JudgementDay_GotToTheWall_2f33beef:

    # REGINA "Go back to your master!"
    REGINA "Geh zurück zu deinem Meister!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2036
translate de qst_JudgementDay_GotToTheWall_3e00d2ef:

    # REGINA "Crawl back to that realm of shadows and LET US BE!"
    REGINA "Kriech zurück in dieses Reich der Schatten und LASS UNS IN RUHE!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2037
translate de qst_JudgementDay_GotToTheWall_1b87c9c9:

    # "The final explosion of energy was unlike anything I had ever seen."
    "Die letzte Energieexplosion war anders als alles, was ich je gesehen hatte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2041
translate de qst_JudgementDay_GotToTheWall_b3ab840a:

    # "A radiant light so brilliant that, for a brief moment, it eclipsed the night itself."
    "Ein strahlendes Licht, so gleißend, dass es für einen kurzen Moment die Nacht selbst überstrahlte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2042
translate de qst_JudgementDay_GotToTheWall_ebd6e601:

    # "It could be seen across the entire battlefield."
    "Es war auf dem gesamten Schlachtfeld zu sehen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2043
translate de qst_JudgementDay_GotToTheWall_2ad66e87:

    # "Zanarak reeled back—his body, for the first time, truly *pushed.*"
    "Zanarak wich zurück – sein Körper wurde zum ersten Mal wirklich *zurückgestoßen*."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2045
translate de qst_JudgementDay_GotToTheWall_c5f3ac16:

    # "And then, like some dark, fallen god, he plummeted from the edge of the city wall."
    "Und dann stürzte er, wie ein dunkler, gefallener Gott, vom Rand der Stadtmauer hinab."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2046
translate de qst_JudgementDay_GotToTheWall_94704099:

    # "The monstrous figure fell."
    "Die monströse Gestalt fiel."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2047
translate de qst_JudgementDay_GotToTheWall_98bfc091:

    # "His enormous wings stretched wide as he tumbled downward—down into the abyss below."
    "Seine riesigen Flügel breiteten sich weit aus, als er hinabstürzte – hinab in den Abgrund darunter."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2053
translate de qst_JudgementDay_GotToTheWall_bdc11f58:

    # "My vision blurred again."
    "Meine Sicht verschwamm erneut."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2054
translate de qst_JudgementDay_GotToTheWall_2812f4c6:

    # "I barely registered Regina kneeling beside me."
    "Ich nahm kaum wahr, dass Regina neben mir kniete."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2055
translate de qst_JudgementDay_GotToTheWall_5d30c702:

    # "Her soft fingers caressed my face, her touch almost… soothing."
    "Ihre weichen Finger streichelten mein Gesicht, ihre Berührung fast… beruhigend."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2056
translate de qst_JudgementDay_GotToTheWall_874f76db:

    # REGINA "Don't worry, dear."
    REGINA "Mach dir keine Sorgen, Liebes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2057
translate de qst_JudgementDay_GotToTheWall_3e3d9a73:

    # REGINA "{i}I'll always keep you safe.{/i}"
    REGINA "{i}Ich werde dich immer beschützen.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2060
translate de qst_JudgementDay_GotToTheWall_f67029cc:

    # "Then, in an instant, she was gone."
    "Dann, im nächsten Augenblick, war sie verschwunden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2061
translate de qst_JudgementDay_GotToTheWall_7387828c:

    # "Her form melted into a swirling mass of black crows that scattered into the night."
    "Ihre Gestalt zerfloss zu einer wirbelnden Masse schwarzer Krähen, die sich in die Nacht zerstreuten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2062
translate de qst_JudgementDay_GotToTheWall_00bde783:

    # MC "...[regina_ref!t]."
    MC "...[regina_ref!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2069
translate de qst_JudgementDay_GotToTheWall_9b612355:

    # "As my consciousness faded, I saw armored figures rushing toward me."
    "Als mein Bewusstsein schwand, sah ich gepanzerte Gestalten auf mich zustürmen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2070
translate de qst_JudgementDay_GotToTheWall_1c3a213e:

    # "Guards."
    "Wachen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2071
translate de qst_JudgementDay_GotToTheWall_4db81c85:

    # "Inquisitors."
    "Inquisitoren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2072
translate de qst_JudgementDay_GotToTheWall_199dcb7a:

    # "Soon, the sharp glint of spearheads surrounded me."
    "Bald umgab mich das scharfe Glitzern von Speerspitzen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2076
translate de qst_JudgementDay_GotToTheWall_b8778a4d:

    # "And then… nothing."
    "Und dann… nichts."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2077
translate de qst_JudgementDay_GotToTheWall_c58b41a1:

    # "Darkness."
    "Dunkelheit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2078
translate de qst_JudgementDay_GotToTheWall_913e0985:

    # "A deep, endless sleep."
    "Ein tiefer, endloser Schlaf."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2114
translate de qst_JudgementDay_SiegeOverPrison_87c14c86:

    # "...Once again, I found myself confined to a cell. I waited. Wondered. Hoped for the best."
    "...Wieder einmal fand ich mich in einer Zelle eingesperrt. Ich wartete. Rätselte. Hoffte auf das Beste."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2115
translate de qst_JudgementDay_SiegeOverPrison_4d77ac33:

    # "My secret was out, and now, I lay at the mercy of an empire that saw me as just another monster."
    "Mein Geheimnis war gelüftet, und nun lag ich in der Gnade eines Imperiums, das mich nur als ein weiteres Monster betrachtete."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2123
translate de qst_JudgementDay_SiegeOverPrison_96c6f6da:

    # "Days drifted by in agonizing slowness."
    "Tage vergingen in quälender Langsamkeit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2124
translate de qst_JudgementDay_SiegeOverPrison_a441eaa1:

    # "A thousand times, I considered escaping, but I knew my fate would be sealed to a lifetime in exile if I tried... or worse."
    "Tausendmal erwog ich zu fliehen, aber ich wusste, dass mein Schicksal bei einem Versuch zu lebenslanger Verbannung besiegelt wäre... oder Schlimmerem."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2125
translate de qst_JudgementDay_SiegeOverPrison_a5ff08fc:

    # "My thoughts wandered to Markus, Adara, the others..."
    "Meine Gedanken wanderten zu Markus, Adara, den anderen..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2126
translate de qst_JudgementDay_SiegeOverPrison_c2501ff3:

    # "Were they safe? What was happening beyond these walls?"
    "Waren sie in Sicherheit? Was geschah jenseits dieser Mauern?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2127
translate de qst_JudgementDay_SiegeOverPrison_b3f25241:

    # "The guards told me nothing."
    "Die Wachen sagten mir nichts."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2128
translate de qst_JudgementDay_SiegeOverPrison_9715e826:

    # "They simply came, delivered bowls of food, and left in silence, leaving me to wait."
    "Sie kamen einfach, brachten Schüsseln mit Essen und gingen schweigend, ließen mich warten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2130
translate de qst_JudgementDay_SiegeOverPrison_f7c2f1a3:

    # "And wait."
    "Und warten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2132
translate de qst_JudgementDay_SiegeOverPrison_f7c2f1a3_1:

    # "And wait."
    "Und warten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2134
translate de qst_JudgementDay_SiegeOverPrison_5344897f:

    # "Each passing moment, my body betrayed me further."
    "Mit jedem vergehenden Moment verriet mich mein Körper mehr."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2136
translate de qst_JudgementDay_SiegeOverPrison_6e40bbe3:

    # BLACK "(We must find a mate soon...)"
    BLACK "(Wir müssen bald einen Partner finden...)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2139
translate de qst_JudgementDay_SiegeOverPrison_29a0ab50:

    # MC "(If we leave now, we're finished. We'll never be able to return.)"
    MC "(Wenn wir jetzt gehen, sind wir erledigt. Wir werden nie zurückkehren können.)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2142
translate de qst_JudgementDay_SiegeOverPrison_101103bd:

    # "I grimaced, feeling the burning sensation coursing through my veins—hot, relentless, growing stronger with each day."
    "Ich verzog das Gesicht und spürte das brennende Gefühl, das durch meine Adern strömte – heiß, unerbittlich, mit jedem Tag stärker werdend."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2145
translate de qst_JudgementDay_SiegeOverPrison_4922c733:

    # BLACK "(It matters not... We must find a mate soon.)"
    BLACK "(Es spielt keine Rolle... Wir müssen bald einen Partner finden.)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2146
translate de qst_JudgementDay_SiegeOverPrison_5d4653ce:

    # BLACK "(Or we will die.)"
    BLACK "(Oder wir werden sterben.)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2149
translate de qst_JudgementDay_SiegeOverPrison_71253890:

    # "Sweat dripped from my skin as my body rebelled against me, wracked with an agonizing need that would not subside."
    "Schweiß tropfte von meiner Haut, während mein Körper gegen mich rebellierte, geplagt von einer quälenden Begierde, die nicht nachließ."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2151
translate de qst_JudgementDay_SiegeOverPrison_53a8addf:

    # "And then, at last…"
    "Und dann, endlich…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2152
translate de qst_JudgementDay_SiegeOverPrison_a66ed92c:

    # "Something changed."
    "Etwas hat sich verändert."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2153
translate de qst_JudgementDay_SiegeOverPrison_58147323:

    # "A distant echo of boots striking stone."
    "Ein fernes Echo von Stiefeln, die auf Stein schlagen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2154
translate de qst_JudgementDay_SiegeOverPrison_6752c6f5:

    # "A key turning in the heavy lock."
    "Ein Schlüssel, der sich im schweren Schloss dreht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2160
translate de qst_JudgementDay_SiegeOverPrison_7644cf54:

    # "Standing before me, flanked by four guards, was Emperor Alcott himself."
    "Vor mir stand, flankiert von vier Wachen, Kaiser Alcott selbst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2161
translate de qst_JudgementDay_SiegeOverPrison_088a2959:

    # ALCOTT "...Leave us."
    ALCOTT "...Lasst uns allein."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2164
translate de qst_JudgementDay_SiegeOverPrison_9332edfd:

    # "The guards hesitated for only a moment before silently obeying, stepping out of the cell and sealing the door behind them."
    "Die Wachen zögerten nur einen Moment, bevor sie still gehorchten, aus der Zelle traten und die Tür hinter sich versiegelten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2165
translate de qst_JudgementDay_SiegeOverPrison_dbb8e0fc:

    # "And so, to my surreal disbelief, I found myself alone in a cell... with the Emperor himself."
    "Und so fand ich mich, zu meinem surrealen Unglauben, allein in einer Zelle wieder... mit dem Kaiser selbst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2166
translate de qst_JudgementDay_SiegeOverPrison_7b1d605a:

    # ALCOTT @ talk "...So, we meet again."
    ALCOTT @ talk "...So, wir treffen uns also wieder."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2167
translate de qst_JudgementDay_SiegeOverPrison_e39eb2b6:

    # ALCOTT @ talk "[player_name!t], isn't it?"
    ALCOTT @ talk "[player_name!t], nicht wahr?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2168
translate de qst_JudgementDay_SiegeOverPrison_f8d1acbc:

    # MC "...Yes."
    MC "...Ja."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2169
translate de qst_JudgementDay_SiegeOverPrison_5a0b7088:

    # ALCOTT "Ahh... Yes, I've read the reports."
    ALCOTT "Ahh... Ja, ich habe die Berichte gelesen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2171
translate de qst_JudgementDay_SiegeOverPrison_f9593db4:

    # ALCOTT @ talk "The reports of your performance during the battle are most impressive."
    ALCOTT @ talk "Die Berichte über Ihre Leistung während der Schlacht sind äußerst beeindruckend."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2172
translate de qst_JudgementDay_SiegeOverPrison_1b7ddb02:

    # ALCOTT @ talk "Not only did you save the princess, but many accounts credit you with actively repelling the enemy inside the walls."
    ALCOTT @ talk "Nicht nur haben Sie die Prinzessin gerettet, sondern viele Berichte schreiben Ihnen zu, den Feind innerhalb der Mauern aktiv zurückgeschlagen zu haben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2173
translate de qst_JudgementDay_SiegeOverPrison_b775b62f:

    # ALCOTT @ smile "Even the Silver Knight himself has offered written testimony on your behalf."
    ALCOTT @ smile "Sogar der Silberne Ritter selbst hat schriftliches Zeugnis zu Ihren Gunsten abgegeben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2174
translate de qst_JudgementDay_SiegeOverPrison_4c68ef56:

    # ALCOTT @ talk "Quite the feat... for a monster."
    ALCOTT @ talk "Eine beachtliche Leistung... für ein Monster."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2175
translate de qst_JudgementDay_SiegeOverPrison_eb5cb3da:

    # MC @ talk "I am no monster."
    MC @ talk "Ich bin kein Monster."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2176
translate de qst_JudgementDay_SiegeOverPrison_9a24afbf:

    # "There was a breathless exhaustion in my voice."
    "Es lag eine atemlose Erschöpfung in meiner Stimme."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2177
translate de qst_JudgementDay_SiegeOverPrison_c46207f1:

    # MC @ talk "I was born a man."
    MC @ talk "Ich wurde als Mann geboren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2178
translate de qst_JudgementDay_SiegeOverPrison_b9847f1b:

    # ALCOTT @ talk "What you were is irrelevant to what you {i}are{/i} now."
    ALCOTT @ talk "Was du warst, ist unwichtig dafür, was du jetzt {i}bist{/i}."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2181
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_c9a63b4d:

    # ALCOTT @ talk "They have all been detained for the time being."
    ALCOTT @ talk "Sie sind alle vorerst in Gewahrsam genommen worden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2182
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_05ecc8fa:

    # ALCOTT @ talk "But your companions are alive."
    ALCOTT @ talk "Aber deine Gefährten leben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2186
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_cb82d705:

    # ALCOTT @ talk "The battle raged on, of course. The city suffered heavy losses..."
    ALCOTT @ talk "Die Schlacht tobte natürlich weiter. Die Stadt erlitt schwere Verluste..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2187
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_be06700b:

    # ALCOTT @ talk "But with the internal threat dealt with, we were able to refocus on repelling the Demorai."
    ALCOTT @ talk "Doch nachdem die innere Bedrohung beseitigt war, konnten wir uns wieder darauf konzentrieren, die Demorai zurückzuschlagen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2188
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_e6e9eae5:

    # ALCOTT @ talk "It seems that without you and your companions... this city would have fallen."
    ALCOTT @ talk "Es scheint, dass diese Stadt ohne dich und deine Gefährten... gefallen wäre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2189
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_17cf0b94:

    # MC @ talk "And my thanks is to be bound in chains..."
    MC @ talk "Und mein Dank ist, in Ketten gelegt zu werden..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2190
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_c7418592:

    # ALCOTT @ talk "For now, yes."
    ALCOTT @ talk "Im Moment ja."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2196
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_bd3be56d:

    # ALCOTT @ talk "I want answers."
    ALCOTT @ talk "Ich will Antworten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2197
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_185f7f09:

    # ALCOTT @ talk "And if you speak the truth, I {i}might{/i} spare your life."
    ALCOTT @ talk "Und wenn du die Wahrheit sagst, {i}könnte{/i} ich dein Leben verschonen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2198
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_f90a1334:

    # ALCOTT @ talk "What are you?"
    ALCOTT @ talk "Was bist du?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2199
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_ccc5fb1f:

    # ALCOTT @ talk "Even Alderay's finest scholars and mages remain clueless as to your nature."
    ALCOTT @ talk "Selbst Alderays beste Gelehrte und Magier sind über deine Natur noch völlig ahnungslos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2200
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_70c726e6:

    # ALCOTT @ talk "So tell me, creature."
    ALCOTT @ talk "Also sag mir, Kreatur."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2201
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_e2e4dace:

    # ALCOTT @ talk "Are you more man... or beast?"
    ALCOTT @ talk "Bist du mehr Mensch... oder Bestie?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2204
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_89549a6e:

    # ALCOTT @ talk "Hmm... Interesting."
    ALCOTT @ talk "Hmm... Interessant."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2206
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_dcaf0f9e:

    # ALCOTT @ talk "Is that so?"
    ALCOTT @ talk "Ist das so?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2208
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_59a9666f:

    # ALCOTT @ joy "Ha! Coin, is it?"
    ALCOTT @ joy "Ha! Münze, nicht wahr?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2209
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_c952c787:

    # ALCOTT @ talk "Well, you wouldn't be the first whose allegiance is for sale."
    ALCOTT @ talk "Nun, du wärst nicht der Erste, dessen Loyalität käuflich ist."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2210
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_2e83dd0c:

    # ALCOTT @ talk "You served under Captain Duprey in the scouts, did you not?"
    ALCOTT @ talk "Du hast unter Hauptmann Duprey bei den Spähern gedient, nicht wahr?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2211
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_ec863f7f:

    # MC @ talk "Yes."
    MC @ talk "Ja."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2212
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_cd7b9399:

    # ALCOTT @ talk "And you didn't even finish basic training before you and your division were sent to investigate a fort just beyond the Valley of Death, correct?"
    ALCOTT @ talk "Und du hast nicht einmal die Grundausbildung abgeschlossen, bevor du und deine Einheit ausgesandt wurdet, ein Fort jenseits des Tals des Todes zu untersuchen, richtig?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2213
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_690fff87:

    # MC @ talk "...Yes."
    MC @ talk "...Ja."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2214
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_2e4a0e45:

    # "Alcott exhaled sharply, shaking his head with a smirk."
    "Alcott stieß scharf die Luft aus, schüttelte mit einem Grinsen den Kopf."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2215
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_5e4c3121:

    # ALCOTT @ smile "{i}It seems the old man still has a few tricks up his sleeve.{/i}"
    ALCOTT @ smile "{i}Es scheint, der alte Mann hat noch ein paar Tricks auf Lager.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2216
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Was?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2217
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_31a4284b:

    # ALCOTT @ talk "You and your division were never supposed to head that way."
    ALCOTT @ talk "Du und deine Division sollten nie in diese Richtung gehen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2218
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_38aa86ea:

    # ALCOTT @ talk "Your orders were to patrol the valley briefly before heading west to Inma for six months."
    ALCOTT @ talk "Eure Befehle lauteten, das Tal kurz zu patrouillieren und dann für sechs Monate nach Westen nach Inma zu ziehen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2219
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_dcc2b33d:

    # ALCOTT @ talk "Instead, you were pushed deep into Demorai territory."
    ALCOTT @ talk "Stattdessen wurdet ihr tief in das Gebiet von Demorai getrieben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2220
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_bde6c2b6_1:

    # MC @ think "What?"
    MC @ think "Was?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2221
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_27b88659:

    # MC @ think "Why...?"
    MC @ think "Warum...?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2222
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_f14a5541:

    # ALCOTT @ angry "The old man has been quietly trying to consolidate power beneath my nose."
    ALCOTT @ angry "Der alte Mann hat heimlich versucht, Macht hinter meinem Rücken zu konsolidieren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2223
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_ef171253:

    # MC @ think "The old man?"
    MC @ think "Der alte Mann?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2224
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_2e52da60:

    # MC @ talk "You mean... King Mesamor?"
    MC @ talk "Du meinst... König Mesamor?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2225
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_f6454f13:

    # ALCOTT @ angry "Indeed."
    ALCOTT @ angry "In der Tat."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2226
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_47e7bf0f:

    # ALCOTT @ angry "The official scouting orders that landed on my desk were a forgery."
    ALCOTT @ angry "Die offiziellen Erkundungsbefehle, die auf meinem Schreibtisch landeten, waren eine Fälschung."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2227
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_8c53fbb1:

    # ALCOTT @ angry "I had no idea where you had been sent."
    ALCOTT @ angry "Ich hatte keine Ahnung, wohin man dich geschickt hatte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2228
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_7d949375:

    # ALCOTT @ talk "It seems Mesamor was determined to recover {i}something{/i} from that fortress."
    ALCOTT @ talk "Es scheint, Mesamor war entschlossen, {i}etwas{/i} aus dieser Festung zu bergen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2229
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_aa4068c8:

    # "His gaze shifted toward me, scrutinizing."
    "Sein Blick wanderte zu mir, prüfend."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2230
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_965393ab:

    # ALCOTT @ talk "And if I were a betting man, I'd wager that you and your friend found whatever he was looking for."
    ALCOTT @ talk "Und wenn ich wetten müsste, würde ich sagen, dass du und dein Freund das gefunden habt, wonach er gesucht hat."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2232
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_7aaa9916:

    # "Memories flooded back."
    "Erinnerungen strömten zurück."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2234
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_f398cb0c:

    # "The journey into that cursed place."
    "Die Reise in diesen verfluchten Ort."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2236
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_a7a05937:

    # "The fortress."
    "Die Festung."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2237
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_951d5029:

    # "Zanarak."
    "Zanarak."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2238
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_b7801f90:

    # "Was that why he pointed at me?"
    "War das der Grund, warum er auf mich zeigte?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2239
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_ed94e83a:

    # "Did he know?"
    "Wusste er es?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2241
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_0d2fbda3:

    # "Did he know what lay beneath that ruin?"
    "Wusste er, was unter dieser Ruine lag?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2246
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_65a91521:

    # ALCOTT @ talk "Don't lie to me now, boy."
    ALCOTT @ talk "Lüg mich jetzt nicht an, Junge."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2247
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_6ea9380f:

    # ALCOTT @ talk "Tell me everything that happened."
    ALCOTT @ talk "Erzähl mir alles, was passiert ist."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2248
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_42ed14f9:

    # MC @ talk "You've read the reports."
    MC @ talk "Du hast die Berichte gelesen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2251
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_950ba974:

    # ALCOTT @ angry "I don't care about the {i}fucking{/i} reports—I care about the truth."
    ALCOTT @ angry "Mir sind die {i}verdammten{/i} Berichte egal – mir geht es um die Wahrheit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2252
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_d8be92f6:

    # ALCOTT @ talk "Now tell me."
    ALCOTT @ talk "Jetzt erzähl es mir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2253
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_d7d42906:

    # ALCOTT @ talk "{i}What really happened out there?{/i}"
    ALCOTT @ talk "{i}Was ist da draußen wirklich passiert?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2254
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2257
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_466d3e9c:

    # "Over the next hour, I told the Emperor everything."
    "Im Laufe der nächsten Stunde erzählte ich dem Kaiser alles."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2258
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_0dd1f5a3:

    # "Every detail. Every horror. The worst nightmare of my life laid bare before him."
    "Jedes Detail. Jedes Grauen. Der schlimmste Albtraum meines Lebens, vor ihm offengelegt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2259
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_1749ec58:

    # "He listened."
    "Er hörte zu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2260
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_0194d765:

    # "He asked questions."
    "Er stellte Fragen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2261
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_43a3cc0a:

    # "He watched me intently."
    "Er beobachtete mich aufmerksam."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2262
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_3f6bb1b9:

    # "And when I was finished, he asked one final question."
    "Und als ich fertig war, stellte er eine letzte Frage."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2267
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_8dacec90:

    # ALCOTT @ talk "And if you {i}don't{/i} find a mate… what happens?"
    ALCOTT @ talk "Und wenn du {i}keinen{/i} Partner findest… was passiert dann?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2268
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_9d0be046:

    # "For the first time in the past few hours, I heard the voice of my dark passenger whisper to me."
    "Zum ersten Mal in den letzten Stunden hörte ich die Stimme meines dunklen Passagiers, die mir zuflüsterte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2269
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_ac7925e3:

    # "Or rather... Shyahtan."
    "Oder besser gesagt... Shyahtan."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2270
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_63ca37b2:

    # SHYAHTAN "({i}Lie.{/i})"
    SHYAHTAN "({i}Lüge.{/i})"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2272
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_5d73558e:

    # "I swallowed hard."
    "Ich schluckte schwer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2273
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_6e6d66fc:

    # "And for the first time since this conversation began... I lied."
    "Und zum ersten Mal, seit dieses Gespräch begonnen hatte, log ich."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2274
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_44dbc736:

    # MC "I would die, my liege."
    MC "Ich würde sterben, mein Lehnsherr."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2275
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_81722666:

    # "The Emperor's sharp gaze lingered on me, as if searching for any trace of deceit."
    "Der scharfe Blick des Kaisers verweilte auf mir, als suche er nach jeder Spur von Täuschung."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2276
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_1a8f0822:

    # "And technically, I {i}would{/i} die."
    "Und technisch gesehen {i}würde{/i} ich sterben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2277
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_0929f946:

    # "But what happened afterward—what the monster inside me would become—I kept that part to myself."
    "Aber was danach geschah – was das Monster in mir werden würde – diesen Teil behielt ich für mich."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2278
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_43a5f33c:

    # ALCOTT @ talk "...I see."
    ALCOTT @ talk "...Ich verstehe."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2279
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_50efc387:

    # "The Emperor exhaled, smirking slightly."
    "Der Kaiser atmete aus und grinste leicht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2280
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_984c10df:

    # ALCOTT @ smile "So the old man wanted Duprey to recover you and your companions' 'dark gifts.'"
    ALCOTT @ smile "Also wollte der alte Mann, dass Duprey dich und die 'dunklen Gaben' deiner Gefährten zurückholt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2281
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_d39a4df5:

    # ALCOTT @ smile "Likely hoping to use them against me... to reclaim his power."
    ALCOTT @ smile "Wahrscheinlich in der Hoffnung, sie gegen mich einzusetzen... um seine Macht zurückzuerlangen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2282
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_29ad01d1:

    # ALCOTT @ smile "I must admit, I'm {i}almost{/i} impressed."
    ALCOTT @ smile "Ich muss zugeben, ich bin {i}fast{/i} beeindruckt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2283
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_93de30dc:

    # ALCOTT @ smile "Had his plan been less reckless, it might have even succeeded."
    ALCOTT @ smile "Wäre sein Plan weniger rücksichtslos gewesen, hätte er vielleicht sogar Erfolg gehabt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2284
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_b97820ef:

    # "I said nothing."
    "Ich sagte nichts."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2285
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_d559bb1e:

    # "I simply waited."
    "Ich wartete einfach."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2286
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_66987d33:

    # ALCOTT @ talk "Your trial is scheduled for the morning."
    ALCOTT @ talk "Dein Prozess ist für morgen früh angesetzt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2287
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_5a0681e6:

    # MC @ angry "What am I even charged with?"
    MC @ angry "Womit werde ich überhaupt angeklagt?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2289
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_d6bc35d8:

    # MC @ angry "We saved this city!"
    MC @ angry "Wir haben diese Stadt gerettet!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2290
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_1afd1403:

    # ALCOTT @ talk "Head Inquisitor Marion has charged you with treason and consorting with dark mages."
    ALCOTT @ talk "Oberinquisitor Marion hat dich wegen Hochverrats und Umgangs mit dunklen Magiern angeklagt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2291
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_de3508db:

    # MC @ think "What?!"
    MC @ think "Was?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2292
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_1ab3ff90:

    # ALCOTT @ talk "You have been accused of spying for the Demorai."
    ALCOTT @ talk "Du wurdest beschuldigt, für die Demorai spioniert zu haben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2293
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_5ee94fb5:

    # MC @ angry "That's absurd! I fought against them! I saved {i}hundreds!{/i}"
    MC @ angry "Das ist absurd! Ich habe gegen sie gekämpft! Ich habe {i}Hunderte{/i} gerettet!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2294
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_346ecd1f:

    # ALCOTT @ talk "It does not matter."
    ALCOTT @ talk "Das spielt keine Rolle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2295
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_dc9687c2:

    # ALCOTT @ talk "Marion doesn't need to be {i}right{/i}—she only needs to convince the lords that you are too great a threat to keep alive."
    ALCOTT @ talk "Marion muss nicht {i}recht haben{/i}—sie muss die Lords nur davon überzeugen, dass du eine zu große Bedrohung darstellst, um am Leben gelassen zu werden."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2296
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_403fc54c:

    # MC @ talk "...So, will you speak on my behalf?"
    MC @ talk "...Also, wirst du für mich sprechen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2297
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_5ba55a50:

    # ALCOTT @ talk "I cannot."
    ALCOTT @ talk "Ich kann nicht."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2298
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_3b4ca7fc:

    # ALCOTT @ talk "I must remain impartial."
    ALCOTT @ talk "Ich muss unparteiisch bleiben."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2299
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_24886635:

    # MC @ angry "Then why are you here?"
    MC @ angry "Warum bist du dann hier?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2300
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_0fe20ea3:

    # ALCOTT @ talk "...Because you can still win this trial."
    ALCOTT @ talk "...Weil du diesen Prozess noch immer gewinnen kannst."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2301
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_8bcd69fe:

    # ALCOTT @ talk "Marion will prey on their fear."
    ALCOTT @ talk "Marion wird ihre Angst ausnutzen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2302
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_81b3050a:

    # ALCOTT @ talk "So {i}you{/i} must prey on their {i}greed.{/i}"
    ALCOTT @ talk "Also {i}musst du{/i} ihre {i}Gier{/i} ausnutzen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2306
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_78268096:

    # "The Emperor turned away, calling for the guards."
    "Der Kaiser wandte sich ab und rief nach den Wachen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2308
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_ad603be8:

    # MC "...Prey on their hope."
    MC "...Nutze ihre Hoffnung aus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2309
translate de qst_JudgementDay_SiegeOverPrison_alcott_menu_8d25bef7:

    # MC "(Prey on their greed...)"
    MC "(Nutze ihre Gier aus...)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2316
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_a9cf84ff:

    # "As darkness fell in my cell that night, I waited restlessly for my trial to come."
    "Als in jener Nacht die Dunkelheit in meiner Zelle hereinbrach, wartete ich unruhig auf meine Verhandlung."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2319
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_2d1c7d48:

    # "The aching agony continued to burn, to scorch my hot blood."
    "Die quälende Qual brannte weiter, versengte mein heißes Blut."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2320
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_0264d4d3:

    # "I became pale, sweat dripping profusely from me as I dazed in and out of consciousness."
    "Ich wurde blass, und der Schweiß rann mir in Strömen herab, während ich zwischen Bewusstsein und Ohnmacht hin- und hertaumelte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2321
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_fd3655df:

    # "Would I even make it to the trial by morning's light?"
    "Würde ich es überhaupt bis zur Verhandlung bei Tagesanbruch schaffen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2322
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_e6f0d6bf:

    # REGINA "... Oh, dear."
    REGINA "... Oh je."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2325
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_fac0e51d:

    # "I looked up to the black shadow stood beyond the bars of my cell."
    "Ich blickte zu dem schwarzen Schatten auf, der hinter den Gittern meiner Zelle stand."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2326
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_8d9e3641:

    # "Shifting and moving, they took form as [regina_ref!t] emerged from the shadows."
    "Sich verschiebend und bewegend, nahmen sie Gestalt an, als [regina_ref!t] aus den Schatten trat."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2327
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_dc72f708:

    # REGINA @ sad "You poor thing... You look like you're in so much pain."
    REGINA @ sad "Du armes Ding... Du siehst aus, als hättest du so große Schmerzen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2328
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_c7036a05:

    # "Her attire was different now, from head to toe she wore black, with a strange pointed hat, and the way she carried herself felt different, it felt... {i}dangerous.{/i}"
    "Ihre Kleidung war jetzt anders, von Kopf bis Fuß trug sie Schwarz, mit einem seltsamen spitzen Hut, und die Art, wie sie sich gab, fühlte sich anders an, es fühlte sich... {i}gefährlich.{/i} an."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2329
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_f56dd946:

    # "Her hands reached through the bars."
    "Ihre Hände griffen durch die Gitterstäbe."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2330
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_5ffe3e24:

    # REGINA "Poor baby, come... Come to [regina_ref!t]."
    REGINA "Armes Baby, komm... Komm zu [regina_ref!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2331
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_da06ef9c:

    # "I slapped her hand away as I pulled back."
    "Ich schlug ihre Hand weg, als ich mich zurückzog."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2332
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_615f5fd0:

    # MC @ angry "... Who are you?"
    MC @ angry "... Wer bist du?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2333
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_6eb8fe7a:

    # "[regina_ref_cap!t] delicately pulled back her hand, her face slightly crestfellen."
    "[regina_ref_cap!t] zog ihre Hand vorsichtig zurück, ihr Gesicht leicht betroffen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2334
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_407ed983:

    # REGINA @ sad "You know who I am... I'm still the same person I've always been."
    REGINA @ sad "Du weißt, wer ich bin... Ich bin immer noch dieselbe Person, die ich immer war."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2335
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_38cab1e6:

    # MC @ angry "Don't lie to me! Not anymore!"
    MC @ angry "Lüg mich nicht an! Nicht mehr!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2336
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_39ba6b8c:

    # REGINA @ angry "I've been trying to protect you!"
    REGINA @ angry "Ich habe versucht, dich zu beschützen!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2337
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_4acb35e3:

    # MC @ angry "All these years... All these years I've pretended not to see what's staring me in the face."
    MC @ angry "All die Jahre ... All die Jahre habe ich so getan, als würde ich nicht sehen, was mir direkt ins Gesicht starrt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2338
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_f834a9d3:

    # MC @ angry "Our whole lives you've been LYING to me and Erika about who and what you really are!"
    MC @ angry "Unser ganzes Leben lang hast du mir und Erika VORGELOGEN, wer und was du wirklich bist!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2339
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_7be10a23:

    # MC @ angry "No more! Who are you really?"
    MC @ angry "Schluss damit! Wer bist du wirklich?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2340
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_c0bf3f94:

    # MC @ angry "...{i}What are you?{/i}"
    MC @ angry "...{i}Was bist du?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2341
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_e57e169f:

    # "The concerning softness on [regina_ref!t]'s expression faded, as in a moment, she became completely calm and collected, with a cold quality to her tone."
    "Die beunruhigende Sanftheit in [regina_ref!t]s Ausdruck verblasste, und im nächsten Moment wurde sie vollkommen ruhig und gefasst, mit einem kalten Unterton in ihrer Stimme."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2342
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_4f5e4d50:

    # REGINA @ talk "... I was born four centuries ago in the village of Lockshire."
    REGINA @ talk "... Ich wurde vor vier Jahrhunderten im Dorf Lockshire geboren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2343
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_2467e2ae:

    # "I listened intently, feeling the room close in around us."
    "Ich hörte aufmerksam zu und spürte, wie der Raum um uns herum enger wurde."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2344
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_e116d747:

    # REGINA @ talk "Times were different then, my people were just another school of magecraft, one often misunderstood... And yet, respected as the others were."
    REGINA @ talk "Die Zeiten waren damals anders, mein Volk war nur eine weitere Schule der Magie, eine, die oft missverstanden wurde ... Und doch, respektiert wie die anderen auch."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2345
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_4fc3f3e9:

    # "I felt the sickly blood turn ice cold as I listened."
    "Ich fühlte, wie das widerliche Blut eiskalt wurde, während ich zuhörte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2346
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_6beb8743:

    # MC @ surprised "So it is true then..."
    MC @ surprised "Es ist also wahr ..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2347
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_fac91196:

    # MC @ surprised "{i}You're a dark mage.{/i}"
    MC @ surprised "{i}Du bist ein dunkler Magier.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2348
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_689c49b0:

    # REGINA "..."
    REGINA "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2349
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_d58b1863:

    # MC @ angry "... Say it!"
    MC @ angry "... Sag es!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2355
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_fee25212:

    # REGINA @ talk "... I am."
    REGINA @ talk "... Das bin ich."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2356
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_11b77947:

    # "Her confession stung like a hot knife pressed into my very soul."
    "Ihr Geständnis brannte wie ein heißes Messer, das sich in meine Seele bohrte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2357
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_a5a156cc:

    # MC @ surprised "Oh gods..."
    MC @ surprised "Oh Götter ..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2358
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_289a6298:

    # MC @ surprised "No... I..."
    MC @ surprised "Nein ... Ich ..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2359
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_bbefb2bd:

    # MC @ sad "How could I not see it?"
    MC @ sad "Wie konnte ich es nicht sehen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2360
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_499c67ea:

    # REGINA @ talk "I was going to tell you... One day."
    REGINA @ talk "Ich wollte es dir sagen ... Eines Tages."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2361
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_f9e5c130:

    # MC @ angry "Grghh! And you let Erika become an inquisitor anyway?!"
    MC @ angry "Grghh! Und du hast Erika trotzdem zur Inquisitorin werden lassen?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2362
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_2491c2c1:

    # MC @ angry "Knowing full well what you are!"
    MC @ angry "Dabei weißt du ganz genau, was du bist!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2363
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_fd3fbd07:

    # MC @ angry "ARE YOU MAD?!"
    MC @ angry "BIST DU VERRÜCKT?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2364
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_1d2de62a:

    # REGINA @ talk "You and her happiness, is the only thing I care about."
    REGINA @ talk "Dein und ihr Glück ist das Einzige, was für mich zählt."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2365
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_1cf2a9ea:

    # REGINA @ talk "If Erika chooses to hate me, then so be it."
    REGINA @ talk "Wenn Erika sich entscheidet, mich zu hassen, dann soll es so sein."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2366
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_278ef5ad:

    # REGINA @ talk "But I knew one way or another, if Erika never learned to channel her magecraft, she would only resent herself."
    REGINA @ talk "Aber ich wusste, so oder so, wenn Erika nie gelernt hätte, ihre Magie zu kanalisieren, würde sie sich nur selbst verabscheuen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2367
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_2d6ae603:

    # MC @ angry "Don't try and pretend this is just about OUR happiness!"
    MC @ angry "Tu nicht so, als ginge es hier nur um UNSER Glück!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2368
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_89d68b37:

    # MC @ angry "You could have done more! We would have understood!"
    MC @ angry "Du hättest mehr tun können! Wir hätten es verstanden!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2369
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_dce9bff1:

    # REGINA @ angry "And confined you to a life of keeping secrets?"
    REGINA @ angry "Und euch zu einem Leben voller Geheimnisse verdammen?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2370
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_bd5c3416:

    # REGINA @ talk "No... I wanted you both to live a normal life, I wanted you both to be happy and make choices for yourselves, not because of me."
    REGINA @ talk "Nein... Ich wollte, dass ihr beide ein normales Leben führt, ich wollte, dass ihr beide glücklich seid und eure eigenen Entscheidungen trefft, nicht wegen mir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2371
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_52300684:

    # MC @ sad "... Is Regina even your real name?"
    MC @ sad "... Ist Regina überhaupt dein echter Name?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2372
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_f397476d:

    # REGINA @ talk "I've gone by many names over the years."
    REGINA @ talk "Im Laufe der Jahre bin ich unter vielen Namen aufgetreten."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2373
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_2ae14994:

    # REGINA @ talk "But Regina was the name I was born with."
    REGINA @ talk "Aber Regina war der Name, mit dem ich geboren wurde."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2374
translate de qst_JudgementDay_SiegeOverPrison_ReginaVisit_f587dd25:

    # REGINA @ talk "I brought it back because I wanted to hear you two call me it."
