# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:214
translate de qst_JudgementDay_SiegeStart_cc74b041:

    # "Having knocked the thing back with her body and managing to tear a chunk from one of the creature's hands, she barked defiantly!"
    "Nachdem sie das Ding mit ihrem Körper zurückgestoßen und es geschafft hatte, ein Stück aus einer der Hände der Kreatur zu reißen, bellte sie trotzig!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:216
translate de qst_JudgementDay_SiegeStart_017cd4e0:

    # ELENA "{i}*BARK!*{/i}"
    ELENA "{i}*WUFF!*{/i}"

