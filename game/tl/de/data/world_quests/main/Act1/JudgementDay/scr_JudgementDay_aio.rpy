    "Der Silver Knight musterte mich sorgfältig, bevor er seinen Blick auf Erika richtete."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1770
translate de qst_JudgementDay_RescueMages_MoveOn_f04727a6:

    # SILVER_KNIGHT "Princess Cecilia should be in the castle."
    SILVER_KNIGHT "Prinzessin Cecilia sollte im Schloss sein."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1771
translate de qst_JudgementDay_RescueMages_MoveOn_2be6c7a0:

