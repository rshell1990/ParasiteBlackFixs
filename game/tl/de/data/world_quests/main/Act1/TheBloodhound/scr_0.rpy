# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:2
translate de qst_bloodhound_0_pitch_8a8224c2:

    # NYX @ talk "Well, looks like you can handle yourself at least."
    NYX @ talk "Nun, es scheint, du kannst zumindest auf dich selbst aufpassen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:3
translate de qst_bloodhound_0_pitch_8c24fcd7:

    # NYX @ talk "I have another job for you, if you're still interested in a bit more coin that is."
    NYX @ talk "Ich habe noch einen Auftrag für dich, falls du immer noch Interesse an etwas mehr Münze hast."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:4
translate de qst_bloodhound_0_pitch_42970179:

    # MC @ talk "Tell me about the job first."
    MC @ talk "Erzähl mir zuerst von dem Auftrag."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:5
translate de qst_bloodhound_0_pitch_cf6ed62f:

    # NYX @ talk "An informant of ours named Azul has gone missing and I can't spare the men to check on him."
    NYX @ talk "Ein Informant von uns namens Azul ist verschwunden, und ich kann keine Männer entbehren, um nach ihm zu sehen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:7
translate de qst_bloodhound_0_pitch_aa937f61:

    # NYX @ talk "The last time he made contact he was... {i}erratic.{/i}"
    NYX @ talk "Das letzte Mal, als er Kontakt aufnahm, war er... {i}unberechenbar.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:8
translate de qst_bloodhound_0_pitch_fb490735:

    # NYX @ talk "I think he was on to something heavy, but now, no one can find him."
    NYX @ talk "Ich glaube, er war einer großen Sache auf der Spur, aber jetzt kann ihn niemand finden."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:9
translate de qst_bloodhound_0_pitch_2aa577bc:

    # MC @ talk "Is he dead?"
    MC @ talk "Ist er tot?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:10
translate de qst_bloodhound_0_pitch_5ef3b5fb:

    # NYX @ shock "I hope not, he's one of our best."
    NYX @ shock "Ich hoffe nicht, er ist einer unserer Besten."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:11
translate de qst_bloodhound_0_pitch_268c87af:

    # NYX @ talk "You can't miss him, he carries around that fucking bird on his shoulder wherever he goes..."
    NYX @ talk "Du kannst ihn nicht verfehlen, er trägt diesen verdammten Vogel auf seiner Schulter, wo auch immer er hingeht ..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:12
translate de qst_bloodhound_0_pitch_5498adaf:

    # NYX @ angry "Damn thing shit all over my desk once."
    NYX @ angry "Das verdammte Ding hat einmal auf meinen ganzen Schreibtisch geschissen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:13
translate de qst_bloodhound_0_pitch_2f501b8f:

    # NYX @ talk "So... What do you say?"
    NYX @ talk "Also... Was sagst du?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:16
translate de qst_bloodhound_0_pitch_260c1b2a:

    # NYX @ talk "Look, I have a limited fund I can spare on you, unlike {i}some{/i} divisions."
    NYX @ talk "Schau, ich habe ein begrenztes Budget, das ich für dich erübrigen kann, anders als {i}manche{/i} Abteilungen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:17
translate de qst_bloodhound_0_pitch_50c41c6b:

    # NYX @ talk "I don't have some infinite pool of coin and resources to pull from."
    NYX @ talk "Ich habe keinen unendlichen Vorrat an Münzen und Ressourcen, aus dem ich schöpfen kann."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:18
translate de qst_bloodhound_0_pitch_2414a40b:

    # NYX @ talk "That said, you'll be paid well enough."
    NYX @ talk "Davon abgesehen wirst du anständig genug bezahlt."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:19
translate de qst_bloodhound_0_pitch_0e46659a:

    # NYX @ talk "How does five hundred coins sound?"
    NYX @ talk "Wie klingen fünfhundert Münzen?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:22
translate de qst_bloodhound_0_pitch_1f41cbe0:

    # NYX @ talk "...Fine, six hundred coins and not coin more."
    NYX @ talk "...Na gut, sechshundert Münzen und keine Münze mehr."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:26
translate de qst_bloodhound_0_pitch_004e4ebe:

    # NYX @ talk "I can't give you anything from the armory but, here, take these from my personal stash."
    NYX @ talk "Ich kann dir nichts aus der Waffenkammer geben, aber hier, nimm diese aus meinem persönlichen Vorrat."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:31
translate de qst_bloodhound_0_pitch_fd5c4a81:

    # NYX @ laugh "Excellent."
    NYX @ laugh "Ausgezeichnet."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:32
translate de qst_bloodhound_0_pitch_529b6398:

    # NYX @ talk "There you go."
    NYX @ talk "Bitte sehr."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:36
translate de qst_bloodhound_0_pitch_d49b20da:

    # NYX @ angry "Don't waste my time, return when you've made up your mind."
    NYX @ angry "Verschwende nicht meine Zeit, komm zurück, wenn du dich entschieden hast."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:39
translate de qst_bloodhound_0_pitch_5c47a36b:

    # NYX @ talk "Last time Azul was seen, he was speaking to some Adventurers at the Guild."
