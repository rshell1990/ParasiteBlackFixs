# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:2
translate de qst_bloodhound_2_camp_050d01c5:

    # MC "(Seems like this is the Guardians' camp.)"
    MC "(Scheint das Lager der Wächter zu sein.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:3
translate de qst_bloodhound_2_camp_0495c238:

    # MC "(Let's take a closer look.)"
    MC "(Sehen wir es uns genauer an.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:6
translate de qst_bloodhound_2_camp_menu_c13e11b1:

    # MC "(A blade covered in blood... But whose?)"
    MC "(Eine mit Blut bedeckte Klinge... Aber von wem?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:9
translate de qst_bloodhound_2_camp_menu_c66edf03:

    # MC "(Some torn up clothes... Not a good omen.)"
    MC "(Zerrissene Kleidung... Kein gutes Omen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:12
translate de qst_bloodhound_2_camp_menu_b8f7998f:

    # MC "(It's been snapped right in two.)"
    MC "(Es ist direkt entzwei gebrochen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:15
translate de qst_bloodhound_2_camp_menu_8f187d87:

    # MC "(Hm? Why's this box been chained up?)"
    MC "(Hm? Warum ist diese Kiste mit Ketten verschlossen?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:16
translate de qst_bloodhound_2_camp_menu_e0a8dfaa:

    # MC "(I could try tear it open... But I might damage whatever is inside.)"
    MC "(Ich könnte versuchen, sie aufzureißen ... aber ich könnte den Inhalt beschädigen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:17
translate de qst_bloodhound_2_camp_menu_27834b37:

    # MC "(Maybe I should try and find a key first?)"
    MC "(Vielleicht sollte ich zuerst nach einem Schlüssel suchen?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:21
translate de qst_bloodhound_2_camp_menu_c356aa46:

    # MC "(Let's try open this...)"
    MC "(Versuchen wir, das zu öffnen...)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:24
translate de qst_bloodhound_2_camp_menu_5ce602f5:

    # MC "(This looks like a guild party sigil... It must be them!)"
    MC "(Das sieht aus wie das Siegel einer Gildentruppe... Das müssen sie sein!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:25
translate de qst_bloodhound_2_camp_menu_8de7d72a:

    # MC "(But... Where are they? There's nobody in sight.)"
    MC "(Aber... Wo sind sie? Es ist niemand in Sicht.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:29
translate de qst_bloodhound_2_camp_menu_cd3844b9:

    # MC "(An extinguished fire pit... Been dead for a while now.)"
    MC "(Eine erloschene Feuerstelle... Schon seit einer Weile erloschen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:30
translate de qst_bloodhound_2_camp_menu_07b572b5:

    # MC "(...Wait, there's something there in the pit!)"
    MC "(...Warte, da ist etwas in der Grube!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:31
translate de qst_bloodhound_2_camp_menu_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:32
translate de qst_bloodhound_2_camp_menu_43190bbe:

    # MC "(A letter?)"
    MC "(Ein Brief?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:33
translate de qst_bloodhound_2_camp_menu_1031de16:

    # "{i}We've captured a baby slimelark as per the clients request, but the big one is getting more and more agitated.{/i}"
    "{i}Wir haben eine Baby-Schleimlerche gemäß Kundenwunsch gefangen, aber die Große wird immer aufgebrachter.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:34
translate de qst_bloodhound_2_camp_menu_4d7ce016:

    # "{i}...Managed to hold it at bay for now, but-{/i}"
    "{i}...Konnte es bisher in Schach halten, aber-{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:35
translate de qst_bloodhound_2_camp_menu_dac4dbf1:

    # MC "(The rest of it is burned beyond readability.)"
    MC "(Der Rest davon ist bis zur Unlesbarkeit verbrannt.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:36
translate de qst_bloodhound_2_camp_menu_6bf2865f:

    # MC "(I best stay away from the bank... For now at least.)"
    MC "(Ich halte mich besser vom Ufer fern... Zumindest vorerst.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:40
translate de qst_bloodhound_2_camp_menu_c9614dee:

    # MC "(Let's move on.)"
    MC "(Lass uns weitergehen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:49
translate de qst_bloodhound_2_lake_openbox_9d3fcc85:

    # "As the lock dropped off the from the box, I opened it up to peer inside."
    "Als das Schloss von der Kiste fiel, öffnete ich sie, um hineinzuschauen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:50
translate de qst_bloodhound_2_lake_openbox_9ff2a2e4:

    # "Inside, a jar with an enchantment on it was filled with the slimelark-like substance."
    "Im Inneren war ein Glas mit einer Verzauberung darauf, gefüllt mit der schlicklerchenartigen Substanz."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:51
translate de qst_bloodhound_2_lake_openbox_2302ca8f:

    # MC "(This is what they came for.)"
    MC "(Das ist, weswegen sie kamen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:52
translate de qst_bloodhound_2_lake_openbox_138ba29f:

    # MC "(A baby slimelark.)"
    MC "(Eine Baby-Schlicklerche.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:53
translate de qst_bloodhound_2_lake_openbox_a497c3f3:

    # MC "(Well, what should I do with it?)"
    MC "(Nun, was soll ich damit machen?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:56
translate de qst_bloodhound_2_lake_openbox_b4080175:

    # "While what happened here was no doubt horrific, something about punishing the youngling felt wrong."
    "Während das, was hier passiert war, zweifellos entsetzlich war, fühlte sich etwas daran, das Junge zu bestrafen, falsch an."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:57
translate de qst_bloodhound_2_lake_openbox_f3f2fecd:

    # "Even if it {i}was{/i} the offspring of a slimelark."
    "Selbst wenn es {i}der Nachwuchs{/i} einer Schlicklerche war."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:58
translate de qst_bloodhound_2_lake_openbox_3fafabb6:

    # "With the jar in hand, I threw it straight into the lake, watching as it plumetted down with a splash."
    "Mit dem Glas in der Hand warf ich es direkt in den See und sah zu, wie es mit einem Platschen hinabstürzte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:61
translate de qst_bloodhound_2_lake_openbox_407d78e6:

    # "Looking around at the horror inflicted by one of these beasts, I decided it was simply too much risk to keep it alive."
    "Angesichts des Schreckens, den eines dieser Biester angerichtet hatte, entschied ich, dass es einfach zu riskant war, es am Leben zu lassen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:62
translate de qst_bloodhound_2_lake_openbox_f8ceeff3:

    # "It was young now... But it would grow up."
    "Es war jetzt jung ... Aber es würde erwachsen werden."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:63
translate de qst_bloodhound_2_lake_openbox_7f274017:

    # "Shattering the glass, the slimelark squealed in a death cry as I hacked away at the thing till it dissolved like its parent."
    "Beim Zerschmettern des Glases stieß die Schleimlerche einen Todesschrei aus, während ich auf das Ding einhackte, bis es sich wie sein Elternteil auflöste."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:67
translate de qst_bloodhound_2_lake_openbox_927f5c91:

    # "For some strange reason, I felt compelled to take the jar with me."
    "Aus irgendeinem seltsamen Grund fühlte ich mich gezwungen, das Glas mitzunehmen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:68
translate de qst_bloodhound_2_lake_openbox_1a2610a5:

    # "Oddly, as I held up the jar to inspect it more, the colour of the slime briefly turned pink."
    "Seltsamerweise, als ich das Glas hochhielt, um es genauer zu betrachten, verfärbte sich der Schleim kurz rosa."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:69
translate de qst_bloodhound_2_lake_openbox_94e3d87f:

    # "I thought for a moment I could hear a soft cooing sound from inside the jar, but after a few seconds more of inspection, the thing was silent again."
    "Ich dachte für einen Moment, ich könnte ein leises Gurren aus dem Glas hören, aber nach ein paar weiteren Sekunden der Inspektion war das Ding wieder still."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:71
translate de qst_bloodhound_2_lake_openbox_156904e7:

    # MC "(I hope I don't end up regretting this.)"
    MC "(Ich hoffe, ich bereue das am Ende nicht.)"

