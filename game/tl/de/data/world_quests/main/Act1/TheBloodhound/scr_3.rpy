    MC "(Sollte ich?..)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:31
translate de qst_bloodhound_3_azul_rug_04a0c64d:

    # MC "(Let's see...)"
    MC "(Mal sehen...)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:34
translate de qst_bloodhound_3_azul_rug_af52d390:

    # "Removing the rug revealed a large, sturdy hatch underneath."
    "Als ich den Teppich entfernte, kam eine große, stabile Luke darunter zum Vorschein."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:37
translate de qst_bloodhound_3_azul_rug_c88c7c23:

    # MC "(Huh?)"
    MC "(Hä?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:38
translate de qst_bloodhound_3_azul_rug_eb3cacb3:

    # "I tried to open it, but it won't budge."
    "Ich versuchte, sie zu öffnen, aber sie rührte sich nicht."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:39
translate de qst_bloodhound_3_azul_rug_c48dce8a:

    # MC "(Who would ever lock their own basement?)"
    MC "(Wer würde schon seinen eigenen Keller abschließen?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:43
translate de qst_bloodhound_3_azul_rug_367afb7f:

    # MC "(Nah, it really ties the room together.)"
    MC "(Nee, es bringt den Raum wirklich zusammen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:48
translate de qst_bloodhound_3_azul_mad_ramblings_ee0c2976:

    # MC "(What's with all this paper? Had Azul lost his mind?)"
    MC "(Was hat es mit all diesem Papier auf sich? Hatte Azul den Verstand verloren?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:49
translate de qst_bloodhound_3_azul_mad_ramblings_7a0d2639:

    # MC "({i}'He is watching?'{/i})"
    MC "({i}'Er beobachtet?{/i})"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:50
translate de qst_bloodhound_3_azul_mad_ramblings_5da93c84:

    # MC "(Was someone stalking him?)"
    MC "(Wurde er verfolgt?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:55
translate de qst_bloodhound_3_azul_filthy_bed_21cc5fef:

    # MC "(His bed is filthy.)"
    MC "(Sein Bett ist schmutzig.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:56
translate de qst_bloodhound_3_azul_filthy_bed_bbbc6ca1:

    # MC "(Spellbooks and other such things....)"
    MC "(Zauberbücher und andere derartige Dinge....)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:57
translate de qst_bloodhound_3_azul_filthy_bed_72447cf9:

    # MC "(A lot of protection spells and rituals seem to be marked.)"
    MC "(Viele Schutzzauber und Rituale scheinen markiert zu sein.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:58
translate de qst_bloodhound_3_azul_filthy_bed_f2980c91:

    # MC "(What was he trying to protect himself from?)"
    MC "(Wovor versuchte er sich zu schützen?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:63
translate de qst_bloodhound_3_azul_strange_book_ae2991a1:

    # MC "(Hm? This book looks odd.)"
    MC "(Hm? Dieses Buch sieht seltsam aus.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:64
translate de qst_bloodhound_3_azul_strange_book_388c9d1a:

    # "As I tried to pull one of the books..."
    "Als ich versuchte, eines der Bücher herauszuziehen..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:67
translate de qst_bloodhound_3_azul_strange_book_c88c7c23:

    # MC "(Huh?)"
    MC "(Huch?)"

