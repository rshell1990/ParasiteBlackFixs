    # MC "(The man is no stranger to decoration.)"
    MC "(Der Mann kennt sich mit Dekoration aus.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:27
translate de qst_bloodhound_3_azul_rug_36d76dac:

    # MC "(Hey... Looks like there is something underneath this rug.)"
    MC "(Hey... Sieht aus, als wäre etwas unter diesem Teppich.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:28
translate de qst_bloodhound_3_azul_rug_184e59d5:

