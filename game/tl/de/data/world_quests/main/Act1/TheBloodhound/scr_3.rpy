# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:22
translate de qst_bloodhound_3_fireplace_dbfcdf89:

    # MC "(It's cold and a little damp... Been a while since someone used this fireplace.)"
    MC "(Es ist kalt und ein wenig feucht... Es ist eine Weile her, seit jemand diesen Kamin benutzt hat.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:26
