translate de qst_bloodhound_3_azul_strange_book_090d1f66:

    # MC "(That sounds like it opened something.)"
    MC "(Das klingt, als hätte es etwas geöffnet.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:72
translate de qst_bloodhound_3_azul_hatch_cant_unlock_2889f0eb:

    # MC "(The hatch is locked.)"
    MC "(Die Luke ist verschlossen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:76
translate de qst_bloodhound_3_azul_hatch_unlock_e7bb0b19:

    # MC "(Let's try this...)"
    MC "(Versuchen wir es mal...)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:77
translate de qst_bloodhound_3_azul_hatch_unlock_fd6c6924:

    # "Pulling hard on the handle I stumbled backwards as the hatch flew open easily."
    "Ich zog hart am Griff und stolperte rückwärts, als die Luke mühelos aufflog."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:79
translate de qst_bloodhound_3_azul_hatch_unlock_702ba8f8:

    # MC "(Whoa, okay now...)"
    MC "(Whoa, okay jetzt...)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:84
translate de qst_bloodhound_3_azul_basement_hatch_c3758bc4:

    # MC "(Something is down there... I can feel it.)"
    MC "(Da unten ist etwas... Ich kann es fühlen.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:85
translate de qst_bloodhound_3_azul_basement_hatch_ceb83781:

    # MC "(I should be prepared before heading down.)"
    MC "(Ich sollte vorbereitet sein, bevor ich hinuntergehe.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:95
translate de qst_bloodhound_3_toBasement_eaa30016:

    # "Heading down into the darkness with a lit torch, each step echoing as I descended down."
    "Mit einer brennenden Fackel in die Dunkelheit hinabsteigend, hallte jeder Schritt, während ich tiefer hinabstieg."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:98
translate de qst_bloodhound_3_toBasement_510bae7c:

    # "Down the stairs, I could hear the sound of dripping grow louder."
    "Die Treppe hinunter konnte ich das Tropfgeräusch lauter werden hören."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:99
translate de qst_bloodhound_3_toBasement_04b96fb8:

    # "Through a small underground passage, I could see a light at the end of the tunnel."
    "Durch einen kleinen unterirdischen Gang konnte ich ein Licht am Ende des Tunnels sehen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:100
translate de qst_bloodhound_3_toBasement_c439e1b9:

    # "Moving towards and peering around the corner..."
    "Ich bewegte mich darauf zu und spähte um die Ecke..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:101
translate de qst_bloodhound_3_toBasement_69649a42:

    # "A nightmare awaited me."
    "Ein Albtraum erwartete mich."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:108
translate de qst_bloodhound_3_toBasement_6706efee:

    # "The man I presumed to be Azul hung upside down, his lower jaw broken and hang by the thinnest thread of flesh."
    "Der Mann, den ich für Azul hielt, hing kopfüber, sein Unterkiefer war gebrochen und hing nur noch an einem dünnen Fetzen Fleisch."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:109
translate de qst_bloodhound_3_toBasement_8f6c41e0:

    # "His eyes were torn out leaving red trails of blood decorating his horrified, pale face."
    "Seine Augen waren herausgerissen, rote Blutspuren schmückten sein entsetztes, blasses Gesicht."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:110
translate de qst_bloodhound_3_toBasement_0d45b3d7:

    # "His body desecrated, long hooks dug into the flesh pulling back sheets of flesh as a pool of blood circled his body beneath."
    "Sein Körper war geschändet, lange Haken gruben sich ins Fleisch und zogen Hautlappen zurück, während sich unter ihm eine Blutlache bildete."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:111
translate de qst_bloodhound_3_toBasement_661276f1:

    # "In his exposed ribcage, a crude cage was formed with sharp metal shards, inside a black crow cried as it pecked at his insides angrily."
    "In seinem freigelegten Brustkorb war aus scharfen Metallsplittern ein primitiver Käfig geformt, in dem eine schwarze Krähe wütend krächzte und an seinen Eingeweiden pickte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:112
translate de qst_bloodhound_3_toBasement_810f6de6:

    # MC @ talk "{i}...Gods.{/i}"
    MC @ talk "{i}...Götter.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:113
translate de qst_bloodhound_3_toBasement_3f254257:

    # "The repugnant smell of rotting flesh began to make me nearly hurl as a dozen flies circled around the pale flesh."
    "Der widerliche Geruch von verfaultem Fleisch ließ mich fast erbrechen, während ein Dutzend Fliegen um das bleiche Fleisch schwirrten."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:114
translate de qst_bloodhound_3_toBasement_c3c642d0:

    # "Behind me, I heard the sounds of some mechanism ticking..."
    "Hinter mir hörte ich das Ticken irgendeines Mechanismus..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:117
translate de qst_bloodhound_3_toBasement_19ed433f:

    # "Sensing danger, I turned."
    "Ich spürte die Gefahr und drehte mich um."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:121
translate de qst_bloodhound_3_toBasement_c0466f52:

    # "A man in black stood before me, his face not visible behind the mask and strange goggles, unnerving ticking sound coming from inside his chest."
    "Ein schwarz gekleideter Mann stand vor mir, sein Gesicht hinter der Maske und seltsamen Schutzbrillen nicht zu erkennen, ein beunruhigendes Ticken kam aus seiner Brust."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:122
translate de qst_bloodhound_3_toBasement_988c5159:

    # "The thing moved jankily, making strange sounds as it curiously turned its head to look at me before drawing out the long blades from its arms."
    "Das Ding bewegte sich ruckartig, gab seltsame Geräusche von sich, während es neugierig den Kopf wandte, um mich anzusehen, bevor es die langen Klingen aus seinen Armen zog."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:123
translate de qst_bloodhound_3_toBasement_4277bc35:

    # MC @ angry "I take it talking is out of the question?"
    MC @ angry "Ich nehme an, reden kommt nicht in Frage?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:124
translate de qst_bloodhound_3_toBasement_c8cb10b4:

    # "The thing stepped forward, its hand shaking slightly."
    "Das Ding trat vor, seine Hand zitterte leicht."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:129
translate de qst_bloodhound_3_toBasement_9a8e3593:

    # MC @ angry "Fuck!"
    MC @ angry "Scheiße!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:137
translate de qst_bloodhound_3_toBasement_3ff24643:

    # "Once again, I quickly tore from my flesh just as the thing was about to strike, barely blocking it in time with my own claws and managing to push it back."
    "Noch einmal riss ich mich schnell von meinem Fleisch los, gerade als das Ding zuschlagen wollte, wehrte es mit meinen eigenen Klauen kaum rechtzeitig ab und schaffte es, es zurückzudrängen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:139
translate de qst_bloodhound_3_toBasement_ee112fff:

    # MC "No choice now!"
    MC "Keine Wahl mehr!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:154
translate de qst_bloodhound_3_toBasement_c0b25ad9:

    # "Dodging left and right, the man in black moved quicker than I anticipated, dodging most of my strikes and managing to land hit after hit against me."
    "Der Mann in Schwarz wich links und rechts aus und bewegte sich schneller, als ich erwartet hatte. Er wich den meisten meiner Schläge aus und schaffte es, einen Treffer nach dem anderen gegen mich zu landen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:155
translate de qst_bloodhound_3_toBasement_ec059881:

    # "Its blades were unlike any other blade I'd seen before."
    "Seine Klingen waren anders als jede andere Klinge, die ich zuvor gesehen hatte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:156
translate de qst_bloodhound_3_toBasement_4532cba5:

    # "Perhaps they were enchanted, but they seemed sharper and able to cut at my flesh unlike any other."
    "Vielleicht waren sie verzaubert, aber sie schienen schärfer zu sein und konnten mein Fleisch schneiden wie keine andere."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:157
translate de qst_bloodhound_3_toBasement_b7befe8a:

    # "I managed to strike it with my tail, piercing a gaping hole through its chest."
    "Es gelang mir, es mit meinem Schwanz zu treffen, und durchbohrte eine klaffende Wunde in seiner Brust."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:158
translate de qst_bloodhound_3_toBasement_1c0b9dcc:

    # "But instead of turning limp, it slashed down, causing a painful wound in my tail as it continued on despite its horrific injury."
    "Aber statt schlaff zu werden, schlug es nach unten und verursachte eine schmerzhafte Wunde an meinem Schwanz, während es trotz seiner entsetzlichen Verletzung weitermachte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:159
translate de qst_bloodhound_3_toBasement_40f4935f:

    # MC "(What the fuck is this thing?!)"
    MC "(Was zur Hölle ist das?!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:160
translate de qst_bloodhound_3_toBasement_b29379dc:

    # MC "(Is it even killable?)"
    MC "(Lässt es sich überhaupt töten?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:161
translate de qst_bloodhound_3_toBasement_323868cf:

    # "Once again, the thing leapt forward, and after a few clashes of our blades, it suddenly pierced through me with one of it's claw hands."
    "Noch einmal sprang das Ding vorwärts, und nach ein paar Zusammenstößen unserer Klingen durchbohrte es mich plötzlich mit einer seiner Klauenhände."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:162
translate de qst_bloodhound_3_toBasement_d327c627:

    # "Screaming in pain, I charged forward, managing to knock the man in black against the opposing wall but it dodged my subsequent lethal swipe to take its head off."
    "Vor Schmerzen schreiend stürmte ich vorwärts und schaffte es, den Mann in Schwarz gegen die gegenüberliegende Wand zu stoßen, aber es wich meinem anschließenden tödlichen Hieb aus, der ihm den Kopf abschlagen sollte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:163
translate de qst_bloodhound_3_toBasement_39009672:

    # "It felt like a horrific dance as the thing moved around me, taking piece after piece."
    "Es fühlte sich an wie ein schrecklicher Tanz, während das Ding sich um mich herum bewegte und Stück für Stück von mir nahm."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:164
translate de qst_bloodhound_3_toBasement_b5c60d7e:

    # "I began to feel dizzy and increasingly weak..."
    "Mir wurde schwindelig und ich fühlte mich immer schwächer ..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:165
translate de qst_bloodhound_3_toBasement_3f7ba3ac:

    # "Just how much longer could I keep this up?"
    "Wie lange könnte ich das noch durchhalten?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:166
translate de qst_bloodhound_3_toBasement_733ec587:

    # MC "(F-Fuck! Can you help me out here?)"
    MC "(F-Fuck! Kannst du mir hier raushelfen?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:167
translate de qst_bloodhound_3_toBasement_d0ca6432:

    # BLACK "Flee."
    BLACK "Flieh."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:168
translate de qst_bloodhound_3_toBasement_e28f5ee5:

    # MC "(Flee?! You can't be serious!)"
    MC "(Fliehen?! Das kann nicht dein Ernst sein!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:169
translate de qst_bloodhound_3_toBasement_6e2d0cec:

    # BLACK "Cannot stabilize damage much longer."
    BLACK "Kann den Schaden nicht mehr lange stabilisieren."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:170
translate de qst_bloodhound_3_toBasement_60f0bc89:

    # BLACK "His blades are coated with something slowing the rapid healing response."
    BLACK "Seine Klingen sind mit etwas beschichtet, das die schnelle Heilreaktion verlangsamt."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:171
translate de qst_bloodhound_3_toBasement_872010a3:

    # MC "(Fuck! FUCK!)"
    MC "(Verdammt! VERDAMMT!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:172
translate de qst_bloodhound_3_toBasement_35522119:

    # "I looked towards the stairs once again."
    "Ich blickte noch einmal zur Treppe."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:173
translate de qst_bloodhound_3_toBasement_2dbdb956:

    # "The man in black blocked my path, blades ready."
    "Der Mann in Schwarz versperrte mir den Weg, die Klingen bereit."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:174
translate de qst_bloodhound_3_toBasement_92f5db33:

    # MC "(I have to try, I just need to get past!)"
    MC "(Ich muss es versuchen, ich muss einfach vorbei!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:175
translate de qst_bloodhound_3_toBasement_05ee5938:

    # "I darted onto the side wall, springing off from my foot to bounce off as I twisted my whole body and swung my tail to try and knock the man back."
    "Ich schnellte auf die Seitenwand, stieß mich mit dem Fuß ab und prallte zurück, während ich meinen ganzen Körper verdrehte und meinen Schwanz schwang, um zu versuchen, den Mann zurückzustoßen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:176
translate de qst_bloodhound_3_toBasement_6a1754bb:

    # "It grabbed onto my tail as I slammed it against the wall, sending shards of stone flying."
    "Es packte meinen Schwanz, als ich ihn gegen die Wand schlug, sodass Steinsplitter umherflogen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:177
translate de qst_bloodhound_3_toBasement_d7df702e:

    # "The man in black refused to give up, forcing blades through my tail."
    "Der Mann in Schwarz weigerte sich aufzugeben und trieb Klingen durch meinen Schwanz."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:178
translate de qst_bloodhound_3_toBasement_20d8f036:

    # "I screeched out in pain but the man in black kept coming no matter what I did."
    "Ich kreischte vor Schmerz auf, doch der Mann in Schwarz kam weiter, egal was ich tat."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:179
translate de qst_bloodhound_3_toBasement_cb953dbd:

    # "Only now did I realize how close death was..."
    "Erst jetzt wurde mir klar, wie nah der Tod war..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:180
translate de qst_bloodhound_3_toBasement_0e939507:

    # UNKNOWN "{i}*Whistles*{/i}"
    UNKNOWN "{i}*Pfeift*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:182
translate de qst_bloodhound_3_toBasement_9afc807c:

    # "As the man in black turned sharply towards the sound, he was suddenly blasted back by a bolt of lightning."
    "Als der Mann in Schwarz sich abrupt dem Geräusch zuwandte, wurde er plötzlich von einem Blitz zurückgeschleudert."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:183
translate de qst_bloodhound_3_toBasement_13c9ce29:

    # "Beside Captain Nyx, four mages stood at the ready, their staffs pointed towards the convulsing automaton."
    "Neben Captain Nyx standen vier Magier bereit, ihre Stäbe auf den zuckenden Automaten gerichtet."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:211
translate de qst_bloodhound_3_toBasement_98ef091a:

    # "It struggled and rose to its feet again, charging towards the Captain and the mages."
    "Es kämpfte sich hoch und stand wieder auf, stürmte auf den Captain und die Magier zu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:218
translate de qst_bloodhound_3_toBasement_9304bfda:

    # "...But another blast sent him wheeling backwards."
    "...Aber ein weiterer Schuss schleuderte ihn rückwärts."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:220
translate de qst_bloodhound_3_toBasement_18e5bb6b:

    # "Clambering back to its feet before they could finish it off, the man in black charged forward, dodging the third blast right through the Captain and her mages, scurrying its way up the stairs."
    "Bevor sie ihn erledigen konnten, rappelte sich der Mann in Schwarz wieder auf, stürmte vorwärts, wich dem dritten Schuss aus, direkt durch den Captain und ihre Magier hindurch, und huschte die Treppe hinauf."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:221
translate de qst_bloodhound_3_toBasement_53131c31:

    # NYX @ angry "AFTER HIM!"
    NYX @ angry "HINTERHER!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:222
translate de qst_bloodhound_3_toBasement_03084257:

    # MAGE "But... What about the other one?"
    MAGE "Aber... Was ist mit dem anderen?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:223
translate de qst_bloodhound_3_toBasement_f1f00a2f:

    # NYX @ angry "Leave him!"
    NYX @ angry "Lasst ihn!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:224
translate de qst_bloodhound_3_toBasement_235c9198:

    # NYX @ angry "{i}He's with us.{/i}"
    NYX @ angry "{i}Er ist bei uns.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:233
translate de qst_bloodhound_3_toBasement_26742987:

    # "The mages followed after him as I weakly stumbled behind them deliriously, blood pouring out of me."
    "Die Magier folgten ihm, während ich benommen schwach hinter ihnen her stolperte und Blut aus mir strömte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:235
translate de qst_bloodhound_3_toBasement_e2baa4ae:

    # "Dizzy, I saw mages and Nyx fight the thing relentlessly."
    "Schwindelig sah ich, wie Magier und Nyx unerbittlich gegen das Ding kämpften."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:236
translate de qst_bloodhound_3_toBasement_45fc3d08:

    # "After a few blows, the Man in black knocked back Captain Nyx before leaping through one of the glass windows, shattering it."
    "Nach einigen Schlägen schleuderte der Mann in Schwarz Captain Nyx zurück, bevor er durch eines der Glasfenster sprang und es zerschmetterte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:242
translate de qst_bloodhound_3_toBasement_b7f2c043:

    # "From outside, we watched as he contorted his body with unnatural speed, dragging himself up unto a building and moving away too fast for us to even see."
    "Von draußen sahen wir, wie er seinen Körper mit unnatürlicher Geschwindigkeit verrenkte, sich auf ein Gebäude hinaufzog und sich so schnell fortbewegte, dass wir ihn nicht einmal sehen konnten."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:243
translate de qst_bloodhound_3_toBasement_58688400:

    # MAGE "Captain! Do we pursue?"
    MAGE "Captain! Verfolgen wir ihn?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:244
translate de qst_bloodhound_3_toBasement_b9c6a5a9:

    # SECOND_MAGE "We need more time to prepare another charge!"
    SECOND_MAGE "Wir brauchen mehr Zeit, um einen weiteren Angriff vorzubereiten!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:258
translate de qst_bloodhound_3_toBasement_fdeb4bdc:

    # NYX @ angry "No... Whatever that thing is, its gone."
    NYX @ angry "Nein… Was auch immer dieses Ding ist, es ist weg."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:259
translate de qst_bloodhound_3_toBasement_d1beeab3:

    # "Unable to handle a single step more my buckling legs gave and I dropped to my knees."
    "Unfähig, noch einen einzigen Schritt zu machen, gaben meine nachgebenden Beine nach und ich fiel auf die Knie."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:261
translate de qst_bloodhound_3_toBasement_2fb16082:

    # "Blood poured from all over my mangled body as I crashed forward with a thud."
    "Blut strömte überall aus meinem zerschundenen Körper, als ich mit einem dumpfen Aufprall nach vorne stürzte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:264
translate de qst_bloodhound_3_toBasement_6859ac9e:

    # NYX "SHIT!"
    NYX "SCHEIẞE!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:265
translate de qst_bloodhound_3_toBasement_c58b41a1:

    # "Darkness."
    "Dunkelheit."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:280
translate de qst_bloodhound_3_toBasement_3e507460:

    # NYX @ shock "...Hey, HEY! He's opening his eyes!"
    NYX @ shock "...Hey, HEY! Er öffnet die Augen!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:281
translate de qst_bloodhound_3_toBasement_96bf910a:

    # MC "Urghh..."
    MC "Urghh..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:282
translate de qst_bloodhound_3_toBasement_ad80ee54:

    # MAGE_TALL "We did our best to heal the creatures wounds but-"
    MAGE_TALL "Wir taten unser Bestes, um die Wunden der Kreatur zu heilen, aber-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:283
translate de qst_bloodhound_3_toBasement_1d30ae43:

    # MAGE_TALL "Captain... What is this thing?"
    MAGE_TALL "Kapitän... Was ist dieses Ding?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:284
translate de qst_bloodhound_3_toBasement_113a6d97:

    # MAGE_SLIM "It... It looks like a man, but earlier-"
    MAGE_SLIM "Es... Es sieht aus wie ein Mann, aber vorhin-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:285
translate de qst_bloodhound_3_toBasement_52521e89:

    # NYX @ angry "Never you mind."
    NYX @ angry "Kümmere dich nicht darum."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:286
translate de qst_bloodhound_3_toBasement_a42b3df1:

    # NYX @ talk "Now help him back to his feet!"
    NYX @ talk "Jetzt hilf ihm wieder auf die Beine!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:289
translate de qst_bloodhound_3_toBasement_c6e0476f:

    # "The mages weakly helped me back to my feet which trembled and shook, barely able to hold me upright."
    "Die Magier halfen mir schwach wieder auf die Beine, die zitterten und bebten und mich kaum aufrecht halten konnten."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:308
translate de qst_bloodhound_3_toBasement_07dd01bf:

    # MC @ talk "{i}*Cough*{/i} How did you-"
    MC @ talk "{i}*Husten*{/i} Wie hast du-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:309
translate de qst_bloodhound_3_toBasement_06fdd052:

    # NYX @ talk "We will talk later, I will explain everything soon."
    NYX @ talk "Wir werden später reden, ich werde bald alles erklären."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:310
translate de qst_bloodhound_3_toBasement_9ae00cf0:

    # "Captain Nyx turned towards the other mages."
    "Captain Nyx wandte sich den anderen Magiern zu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:313
translate de qst_bloodhound_3_toBasement_33bce3a6:

    # NYX @ angry "None of you will speak of what you have seen today, understand?"
    NYX @ angry "Niemand von euch wird über das sprechen, was ihr heute gesehen habt, verstanden?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:314
translate de qst_bloodhound_3_toBasement_f9a9e350:

    # "The mages look at each other sheepishly."
    "Die Magier schauen einander verlegen an."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:315
translate de qst_bloodhound_3_toBasement_675dbf11:

    # NYX @ angry "I assure you, {i}the fates will not favor you for a lack of discretion, ladies.{/i}"
    NYX @ angry "Ich versichere euch, {i}die Schicksalsgöttinnen werden euch nicht wohlgesonnen sein, wenn es euch an Diskretion mangelt, meine Damen.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:316
translate de qst_bloodhound_3_toBasement_4abde0dd:

    # "The mages all nervously nodded."
    "Die Magier nickten alle nervös."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:326
translate de qst_bloodhound_3_toBasement_d626dae3:

    # NYX @ talk "Now help me dress him."
    NYX @ talk "Jetzt helft mir, ihn anzuziehen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:330
translate de qst_bloodhound_3_toBasement_4896de1a:

    # "The Mages eyes looked downwards as their cheeks flushed red."
    "Die Augen der Magier senkten sich, während ihre Wangen rot anliefen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:331
translate de qst_bloodhound_3_toBasement_7a8a690f:

    # NYX @ angry "...Oh for the love of-"
    NYX @ angry "...Oh um Himmels willen-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:332
translate de qst_bloodhound_3_toBasement_28ca6b76:

    # NYX @ blush "Sisters... {i}Eyes up{/i} and focus."
    NYX @ blush "Schwestern... {i}Augen auf{/i} und konzentriert euch."

translate de strings:

    # game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:30
    old "Pull the rug to the side"
    new "Zieh den Teppich zur Seite."

