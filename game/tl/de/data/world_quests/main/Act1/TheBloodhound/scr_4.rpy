# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:2
translate de qst_bloodhound_4_atFort_aed6965c:

    # "The next hour was a kind of blur as the mages dressed me and helped me stumble by way back towards Fort Sebastian."
    "Die nächste Stunde verschwamm, während die Magier mich ankleideten und mir halfen, zurück zur Festung Sebastian zu stolpern."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:5
translate de qst_bloodhound_4_atFort_dbd56900:

    # "Brought into the Medical Ward, the nuns hurried over to treat me alongside the influx of other poor bastards."
    "In die Krankenstation gebracht, eilten die Nonnen herbei, um mich zusammen mit dem Zustrom anderer armer Kerle zu behandeln."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:8
translate de qst_bloodhound_4_atFort_6af63c0b:

    # "Here and there I noticed were a few Scouts."
    "Hier und da bemerkte ich ein paar Späher."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:9
translate de qst_bloodhound_4_atFort_5d3a3559:

    # "Battered, broken, some had limbs missing."
    "Zerschlagen, gebrochen, manchen fehlten Gliedmaßen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:10
translate de qst_bloodhound_4_atFort_7327635b:

    # "Laying beside them, I remembered how I hoped never to end up here again."
    "Als ich neben ihnen lag, erinnerte ich mich, wie ich gehofft hatte, nie wieder hier zu landen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:11
translate de qst_bloodhound_4_atFort_b0c99eb3:

    # "Yet, here I was."
    "Und doch, hier war ich."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:15
translate de qst_bloodhound_4_atFort_08507bf0:

    # "Captain Nyx spoke to some of the Nuns."
    "Hauptmann Nyx sprach mit einigen der Nonnen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:19
translate de qst_bloodhound_4_atFort_3357746f:

    # "As I struggled to stay awake, I couldn't focus on what was being said..."
    "Während ich darum kämpfte, wach zu bleiben, konnte ich mich nicht darauf konzentrieren, was gesagt wurde ..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:23
translate de qst_bloodhound_4_atFort_1c58eea8:

    # "At some point, one of the nuns came to see me and fed me some holly sap for the pain."
    "Irgendwann kam eine der Nonnen zu mir und gab mir etwas Stechpalmentaft gegen die Schmerzen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:27
translate de qst_bloodhound_4_atFort_217b2342:

    # "Since my {i}change{/i}, I hadn't experienced pain like this."
    "Seit meiner {i}Veränderung{/i} hatte ich solche Schmerzen nicht mehr erlebt."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:31
translate de qst_bloodhound_4_atFort_32efdd9d:

    # "Every muscle ached as I felt numerous broken bones inside me struggling to mend."
    "Jeder Muskel schmerzte, als ich spürte, wie zahlreiche gebrochene Knochen in meinem Inneren darum kämpften, zu heilen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:35
translate de qst_bloodhound_4_atFort_fc7016e4:

    # MC "(What happened back there?)"
    MC "(Was ist da hinten passiert?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:36
translate de qst_bloodhound_4_atFort_e7f55388:

    # MC "(Shit shit! How in all the damn hells did she know about me?)"
    MC "(Scheiße, Scheiße! Wie in aller verdammten Hölle wusste sie von mir?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:37
translate de qst_bloodhound_4_atFort_0422337d:

    # MC "(Urghh... Why is the healing taking so long?)"
    MC "(Urghh... Warum dauert die Heilung so lange?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:38
translate de qst_bloodhound_4_atFort_78cfcf79:

    # BLACK "The effects of the poison are still active within our bloodstream."
    BLACK "Die Wirkungen des Giftes sind immer noch aktiv in unserem Blutkreislauf."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:39
translate de qst_bloodhound_4_atFort_6f610828:

    # MC "(That thing it... {i}It nearly killed us{/i}.)"
    MC "(Dieses Ding, es... {i}Es hat uns fast umgebracht{/i}.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:40
translate de qst_bloodhound_4_atFort_4ba8b71c:

    # BLACK "Yes."
    BLACK "Ja."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:41
translate de qst_bloodhound_4_atFort_10d9725d:

    # MC "(But how? I thought we were like, nearly impossible to kill or something!)"
    MC "(Aber wie? Ich dachte, wir wären quasi fast unmöglich zu töten oder so!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:42
translate de qst_bloodhound_4_atFort_0be017dd:

    # BLACK "This assessment is incorrect."
    BLACK "Diese Einschätzung ist falsch."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:43
translate de qst_bloodhound_4_atFort_14f01e94:

    # MC "(What? Well... We've handled everything until now!)"
    MC "(Was? Nun... Wir haben bis jetzt alles gemeistert!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:44
translate de qst_bloodhound_4_atFort_f1fae085:

    # BLACK "Our battle form is durable but {i}not invincible{/i}, there are no doubt plenty of beings capable of killing us."
    BLACK "Unsere Kampfform ist widerstandsfähig, aber {i}nicht unbesiegbar{/i}, es gibt zweifellos viele Wesen, die uns töten können."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:45
translate de qst_bloodhound_4_atFort_cc99b660:

    # MC "(Well, there goes my power fantasy I guess.)"
    MC "(Nun, das war's wohl mit meiner Machtfantasie.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:46
translate de qst_bloodhound_4_atFort_5e79a34e:

    # BLACK "The battle form, like all abilities, must be nurtured to develop."
    BLACK "Die Kampfform muss, wie alle Fähigkeiten, gepflegt werden, um sich zu entwickeln."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:47
translate de qst_bloodhound_4_atFort_c7d003c0:

    # MC "(You mean like, I have to train more?)"
    MC "(Du meinst, ich muss mehr trainieren?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:48
translate de qst_bloodhound_4_atFort_e6b63194:

    # BLACK "Yes, your body will adapt and evolve to handle greater threats."
    BLACK "Ja, dein Körper wird sich anpassen und weiterentwickeln, um mit größeren Bedrohungen fertig zu werden."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:49
translate de qst_bloodhound_4_atFort_f7a97492:

    # MC "(Great... That's something at least.)"
    MC "(Großartig... Das ist wenigstens etwas.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:51
translate de qst_bloodhound_4_atFort_17a87d51:

    # "The thought of facing that {i}thing{/i} again filled me with dread."
    "Der Gedanke, diesem {i}Ding{/i} noch einmal gegenüberzutreten, erfüllte mich mit Grauen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:52
translate de qst_bloodhound_4_atFort_339483ae:

    # "As the holly sap took effect, I drifted off to sleep, haunted by the images of it's horrible face charging towards me."
    "Als der Stechpalmen-Saft zu wirken begann, schlief ich ein und wurde von den Bildern seines schrecklichen Gesichts heimgesucht, das auf mich zustürmte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:59
translate de qst_bloodhound_4_atFort_b88fb49b:

    # "Towards {i}us{/i}."
    "Auf {i}uns{/i} zu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:64
translate de qst_bloodhound_4_atFort_0cf7c79e:

    # "A few hours later..."
    "Ein paar Stunden später..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:73
translate de qst_bloodhound_4_atFort_9efa6cee:

    # NYX @ shock "Feeing alright?"
    NYX @ shock "Geht's dir gut?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:75
translate de qst_bloodhound_4_atFort_b8905269:

    # MC @ talk "Yeah... Never better."
    MC @ talk "Ja... Besser denn je."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:76
translate de qst_bloodhound_4_atFort_359034a0:

    # NYX @ talk "You look like shit."
    NYX @ talk "Du siehst scheiße aus."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:77
translate de qst_bloodhound_4_atFort_dfbe28ad:

    # MC @ talk "Well, I feel like shit so..."
    MC @ talk "Tja, ich fühl mich beschissen, also..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:79
translate de qst_bloodhound_4_atFort_b9fc5142:

    # "Captain Nyx forced a faint smile before nodding softly."
    "Captain Nyx rang sich ein schwaches Lächeln ab, bevor sie sanft nickte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:80
translate de qst_bloodhound_4_atFort_b01b2cf5:

    # NYX @ talk "I suppose you've got questions."
    NYX @ talk "Ich nehme an, du hast Fragen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:81
translate de qst_bloodhound_4_atFort_291c5b81:

    # MC @ talk "Damn right."
    MC @ talk "Verdammt richtig."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:86
translate de qst_bloodhound_4_hospital_nyxChoices_e4ee6136:

    # NYX @ talk "I've had you both followed since your return."
    NYX @ talk "Ich habe euch beide seit eurer Rückkehr beschatten lassen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:87
translate de qst_bloodhound_4_hospital_nyxChoices_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "Was?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:88
translate de qst_bloodhound_4_hospital_nyxChoices_27426e03:

    # NYX @ angry "When you and your friend returned, under the circumstances you did, I didn't buy that you just strolled your way back to Novaras in record time."
    NYX @ angry "Als du und dein Freund unter diesen Umständen zurückkamt, hab ich es euch nicht abgekauft, dass ihr einfach so in Rekordzeit nach Novaras spaziert seid."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:89
translate de qst_bloodhound_4_hospital_nyxChoices_b21889a2:

    # NYX @ angry "At first, I considered you being Demorai spies."
    NYX @ angry "Zuerst hielt ich euch für Demorai-Spione."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:90
translate de qst_bloodhound_4_hospital_nyxChoices_6004d9d1:

    # NYX @ talk "So, I called in some favors and had you followed."
    NYX @ talk "Also rief ich einige Gefallen ein und ließ euch verfolgen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:91
translate de qst_bloodhound_4_hospital_nyxChoices_9e1a4c12:

    # MC @ angry "Why not just tell me!"
    MC @ angry "Warum hast du es mir nicht einfach gesagt!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:92
translate de qst_bloodhound_4_hospital_nyxChoices_b1ccbf77:

    # NYX @ talk "I needed to test where your loyalties laid."
    NYX @ talk "Ich musste herausfinden, wo eure Loyalitäten liegen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:93
translate de qst_bloodhound_4_hospital_nyxChoices_c5e54f3e:

    # NYX @ laugh "Oh, and the whole strolling into the desert to change thing? Not very smart."
    NYX @ laugh "Oh, und die ganze Sache mit dem Spaziergang in die Wüste, um sich zu verwandeln? Nicht besonders klug."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:94
translate de qst_bloodhound_4_hospital_nyxChoices_bae1966c:

    # NYX @ angry "Did you really think heading out there wasn't going to draw some attention?"
    NYX @ angry "Hast du wirklich gedacht, dass das Hinausgehen keine Aufmerksamkeit erregen würde?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:95
translate de qst_bloodhound_4_hospital_nyxChoices_2221d04f:

    # NYX @ talk "You're going to need to learn to be smarter than that."
    NYX @ talk "Du wirst lernen müssen, klüger als das zu sein."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:96
translate de qst_bloodhound_4_hospital_nyxChoices_98840fbf:

    # MC @ angry "You used me."
    MC @ angry "Du hast mich benutzt."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:97
translate de qst_bloodhound_4_hospital_nyxChoices_c9fb01dc:

    # NYX @ angry "This is war, you'll get used to being used."
    NYX @ angry "Das ist Krieg, du wirst dich daran gewöhnen, benutzt zu werden."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:101
translate de qst_bloodhound_4_hospital_nyxChoices_9310a365:

    # NYX @ talk "I have no idea."
    NYX @ talk "Ich habe keine Ahnung."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:102
translate de qst_bloodhound_4_hospital_nyxChoices_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "Was?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:103
translate de qst_bloodhound_4_hospital_nyxChoices_1b3b6fcb:

    # NYX @ shock "I knew Azul was onto something big but... I didn't anticipate that."
    NYX @ shock "Ich wusste, dass Azul etwas Großem auf der Spur war, aber ... das habe ich nicht erwartet."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:104
translate de qst_bloodhound_4_hospital_nyxChoices_d155dda6:

    # NYX @ angry "All of Azul's private documents and scrolls have been taken, no doubt destroyed."
    NYX @ angry "Alle privaten Dokumente und Schriftrollen von Azul sind mitgenommen worden, zweifellos zerstört."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:108
translate de qst_bloodhound_4_hospital_nyxChoices_564cd451:

    # NYX @ shock "...I'm sorry, I predicted there might be a trap waiting for whoever I sent."
    NYX @ shock "...Es tut mir leid, ich habe vorhergesehen, dass eine Falle auf den warten könnte, den ich schickte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:109
translate de qst_bloodhound_4_hospital_nyxChoices_1a9930c7:

    # NYX @ talk "I knew that, with your abilities, you had a better chance handling whatever was thrown at you."
    NYX @ talk "Ich wusste, dass du mit deinen Fähigkeiten eine bessere Chance hattest, mit allem fertig zu werden, was auf dich zukam."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:110
translate de qst_bloodhound_4_hospital_nyxChoices_c34a59ad:

    # NYX @ talk "But I still made sure to tail you, I couldn't be sure for whatever was waiting and expected the worst."
    NYX @ talk "Aber ich habe trotzdem dafür gesorgt, dir zu folgen, ich konnte mir nie sicher sein, was dort lauern würde, und habe das Schlimmste erwartet."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:111
translate de qst_bloodhound_4_hospital_nyxChoices_1efaa6b8:

    # MC @ talk "Could have done better with you about five minutes earlier into the fight."
    MC @ talk "Du hättest etwa fünf Minuten früher in den Kampf kommen können."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:112
translate de qst_bloodhound_4_hospital_nyxChoices_6442fbae:

    # NYX @ angry "We moved as quickly as we could without drawing attention."
    NYX @ angry "Wir haben uns so schnell wie möglich bewegt, ohne Aufmerksamkeit zu erregen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:116
translate de qst_bloodhound_4_hospital_nyxChoices_230bd269:

    # NYX @ talk "No."
    NYX @ talk "Nein."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:117
translate de qst_bloodhound_4_hospital_nyxChoices_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:118
translate de qst_bloodhound_4_hospital_nyxChoices_69710195:

    # NYX @ talk "You're a valuable asset, and I'm fairly confident now whose side you're on."
    NYX @ talk "Du bist eine wertvolle Stütze, und ich bin mir jetzt ziemlich sicher, auf wessen Seite du stehst."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:119
translate de qst_bloodhound_4_hospital_nyxChoices_e9e95609:

    # NYX @ angry "That said, others may not feel the same."
    NYX @ angry "Das gesagt, könnten andere das anders sehen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:120
translate de qst_bloodhound_4_hospital_nyxChoices_bb396a64:

    # MC @ talk "So... No one else knows?"
    MC @ talk "Also... Weiß sonst niemand davon?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:121
translate de qst_bloodhound_4_hospital_nyxChoices_8e345629:

    # NYX @ talk "Your secret is still safe."
    NYX @ talk "Dein Geheimnis ist immer noch sicher."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:122
translate de qst_bloodhound_4_hospital_nyxChoices_27b1a111:

    # MC @ talk "But, the inquisitors-"
    MC @ talk "Aber die Inquisitoren-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:123
translate de qst_bloodhound_4_hospital_nyxChoices_543f491c:

    # NYX @ angry "Fuck the inquisitors."
    NYX @ angry "Scheiß auf die Inquisitoren."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:124
translate de qst_bloodhound_4_hospital_nyxChoices_078ca3b0:

    # NYX @ angry "And fuck Lukkan and the others."
    NYX @ angry "Und scheiß auf Lukkan und die anderen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:125
translate de qst_bloodhound_4_hospital_nyxChoices_e295341a:

    # NYX @ angry "The city Watch needs all the help it can get, and none of those fuckers are willing to lift a damn finger to help if it involves pulling from their precious sectors."
    NYX @ angry "Die Stadtwache braucht jede Hilfe, die sie kriegen kann, und keiner dieser Scheißer ist bereit, auch nur einen verdammten Finger zu rühren, wenn es bedeutet, Kräfte aus ihren kostbaren Sektoren abzuziehen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:126
translate de qst_bloodhound_4_hospital_nyxChoices_3ff61c69:

    # NYX @ talk "I may call upon you again, for help."
    NYX @ talk "Ich werde mich vielleicht erneut an dich wenden, um Hilfe zu bitten."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:127
translate de qst_bloodhound_4_hospital_nyxChoices_0466bb7a:

    # NYX @ angry "You may be one of the only few in this wretched city I actually know I can trust."
    NYX @ angry "Du könntest einer der wenigen in dieser elenden Stadt sein, von denen ich tatsächlich weiß, dass ich ihnen vertrauen kann."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:130
translate de qst_bloodhound_4_hospital_nyxChoices_0f796eb3:

    # MC @ talk "I'm done with questions..."
    MC @ talk "Ich habe genug von Fragen ..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:131
translate de qst_bloodhound_4_hospital_nyxChoices_310c3340:

    # MC @ talk "What now?"
    MC @ talk "Was jetzt?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:132
translate de qst_bloodhound_4_hospital_nyxChoices_c93cf8f4:

    # NYX @ talk "Not much, you go back to doing whatever it is you were doing before."
    NYX @ talk "Nicht viel, du machst einfach da weiter, wo du vorher aufgehört hast."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:133
translate de qst_bloodhound_4_hospital_nyxChoices_8d9965eb:

    # MC @ talk "But... The investigation?"
    MC @ talk "Aber ... die Ermittlung?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:134
translate de qst_bloodhound_4_hospital_nyxChoices_d08d005d:

    # NYX @ talk "Not your responsibility anymore."
    NYX @ talk "Nicht mehr deine Verantwortung."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:135
translate de qst_bloodhound_4_hospital_nyxChoices_e5b291a8:

    # NYX @ talk "At least, until I can do some more digging into what Azul found."
    NYX @ talk "Zumindest, bis ich tiefer graben kann, was Azul gefunden hat."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:137
translate de qst_bloodhound_4_hospital_nyxChoices_83b8fbc8:

    # MC @ talk "...That {i}thing.{/i}"
    MC @ talk "...Dieses {i}Ding.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:138
translate de qst_bloodhound_4_hospital_nyxChoices_df7f4b5b:

    # NYX @ talk "Returned to its master, no doubt."
    NYX @ talk "Wurde zweifellos an seinen Meister zurückgegeben."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:139
translate de qst_bloodhound_4_hospital_nyxChoices_4bcd9b36:

    # MC @ talk "{i}Master?{/i} You mean-"
    MC @ talk "{i}Meister?{/i} Du meinst -"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:140
translate de qst_bloodhound_4_hospital_nyxChoices_c9c2e169:

    # NYX @ angry "Yes, that thing serves to cover the tracks of it's master."
    NYX @ angry "Ja, dieses Ding dient dazu, die Spuren seines Meisters zu verwischen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:141
translate de qst_bloodhound_4_hospital_nyxChoices_2207c685:

    # MC @ talk "How do you know?"
    MC @ talk "Woher weißt du?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:142
translate de qst_bloodhound_4_hospital_nyxChoices_c5aabc37:

    # NYX @ talk "Whatever Azul uncovered brought him into the sights of some {i}powerful{/i} people."
    NYX @ talk "Was auch immer Azul aufgedeckt hat, brachte ihn ins Visier einiger {i}mächtiger{/i} Leute."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:143
translate de qst_bloodhound_4_hospital_nyxChoices_a0d4bfdb:

    # NYX @ talk "That thing didn't just kill him, it destroyed all of the sensitive information Azul had been gathering."
    NYX @ talk "Dieses Ding hat ihn nicht nur getötet, es hat alle sensiblen Informationen zerstört, die Azul gesammelt hatte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:144
translate de qst_bloodhound_4_hospital_nyxChoices_c1fe3b09:

    # NYX @ angry "Whatever he found, Azul got too close."
    NYX @ angry "Was auch immer er gefunden hat, Azul ist zu nah herangekommen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:145
translate de qst_bloodhound_4_hospital_nyxChoices_a70e4233:

    # MC @ talk "...If that {i}thing{/i} had already killed Azul, why leave the body like that?"
    MC @ talk "...Wenn dieses {i}Ding{/i} Azul bereits getötet hatte, warum die Leiche so zurücklassen?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:146
translate de qst_bloodhound_4_hospital_nyxChoices_7eb21b6a:

    # MC @ talk "Why was the thing still down there... {i}waiting?{/i}"
    MC @ talk "Warum war das Ding noch da unten... {i}wartend?{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:147
translate de qst_bloodhound_4_hospital_nyxChoices_19b37a1a:

    # NYX @ angry "I believe it was waiting {i}for me.{/i}"
    NYX @ angry "Ich glaube, es hat auf {i}mich{/i} gewartet."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:148
translate de qst_bloodhound_4_hospital_nyxChoices_0a6e91e3:

    # NYX @ angry "No doubt whoever is at play here knows of my involvement and would rather have me silenced."
    NYX @ angry "Kein Zweifel, dass wer auch immer hier im Spiel ist, von meiner Beteiligung weiß und mich lieber zum Schweigen bringen würde."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:149
translate de qst_bloodhound_4_hospital_nyxChoices_a8914fff:

    # NYX @ angry "As for why the body was left there?"
    NYX @ angry "Und warum die Leiche dort zurückgelassen wurde?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:150
translate de qst_bloodhound_4_hospital_nyxChoices_4b0c0176:

    # NYX @ angry "Perhaps as a warning... A message, in case that monster failed."
    NYX @ angry "Vielleicht als Warnung... Eine Botschaft, falls dieses Monster versagte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:151
translate de qst_bloodhound_4_hospital_nyxChoices_4331e288:

    # "I felt ill with the thought."
    "Mir wurde bei dem Gedanken übel."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:152
translate de qst_bloodhound_4_hospital_nyxChoices_47394e6f:

    # "What kind of a person leaves a warning like {i}that?{/i}"
    "Was für ein Mensch hinterlässt eine Warnung wie {i}die?{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:153
translate de qst_bloodhound_4_hospital_nyxChoices_91172795:

    # NYX @ talk "...Oh, that reminds me, here."
    NYX @ talk "...Ach ja, da fällt mir noch was ein, hier."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:154
translate de qst_bloodhound_4_hospital_nyxChoices_c565abe5:

    # NYX @ talk "Your reward."
    NYX @ talk "Deine Belohnung."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:157
translate de qst_bloodhound_4_hospital_nyxChoices_718bb0b3:

    # NYX @ talk "Well, I best leave you be for now."
    NYX @ talk "Nun, ich sollte dich jetzt am besten in Ruhe lassen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:158
translate de qst_bloodhound_4_hospital_nyxChoices_480d38ed:

    # NYX @ talk "Watch yourself [player_name!t]..."
    NYX @ talk "Pass auf dich auf, [player_name!t]..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:159
translate de qst_bloodhound_4_hospital_nyxChoices_dadbefbb:

    # NYX @ angry "{i}You might be in their sights too now.{/i}"
    NYX @ angry "{i}Du könntest jetzt auch in ihrem Visier sein.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:161
translate de qst_bloodhound_4_hospital_nyxChoices_9ee63cbf:

    # "As Nyx left, I dropped my head back onto the pillow."
    "Als Nyx gegangen war, ließ ich meinen Kopf wieder auf das Kissen sinken."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:165
translate de qst_bloodhound_4_hospital_nyxChoices_081ba91b:

    # MC "(...Fucking great.)"
    MC "(...Verdammt toll.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:170
translate de qst_bloodhound_4_hospital_nyxChoices_9650db8e:

    # "A couple hours later, a nun came by and said I could leave now."
    "Ein paar Stunden später kam eine Nonne vorbei und sagte, ich könne jetzt gehen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:171
translate de qst_bloodhound_4_hospital_nyxChoices_15ffe5e3:

    # "Leaving the hospital ward, I let out a grim chuckle at myself hoping to not end up here again."
    "Als ich die Krankenstation verließ, entkam mir ein grimmiges Lachen über mich selbst, in der Hoffnung, nicht wieder hier zu landen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:172
translate de qst_bloodhound_4_hospital_nyxChoices_aca943c2:

    # MC "(Back into the world of the living...)"
    MC "(Zurück in die Welt der Lebenden...)"

