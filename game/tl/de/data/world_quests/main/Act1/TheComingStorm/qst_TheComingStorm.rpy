# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:374
translate de qst_TheComingStorm_NovarasGatesCantExit_28b524f3:

    # "At the city gates, dozens of wagons sat motionless, traders, merchants, and families arguing for their right to leave."
    "An den Stadttoren standen dutzende Wagen regungslos, Händler, Kaufleute und Familien, die um ihr Recht, die Stadt zu verlassen, stritten."

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:375
translate de qst_TheComingStorm_NovarasGatesCantExit_1bacfdc5:

    # "Each was denied by the stationed guards."
    "Jeder wurde von den stationierten Wachen abgewiesen."

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:377
translate de qst_TheComingStorm_NovarasGatesCantExit_7b096b57:

