    GUARD "HALT!"

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:379
translate de qst_TheComingStorm_NovarasGatesCantExit_ec7a938e:

    # GUARD "By order of the Emperor, no one may leave Novaras until the siege threat has passed!"
    GUARD "Auf Befehl des Kaisers darf niemand Novaras verlassen, bis die Belagerungsgefahr vorüber ist!"

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:386
translate de qst_TheComingStorm_NovarasGatesCantExit_4e2858dd:

    # GUARD "Official permits are only granted to high lords or ranking military officials."
    GUARD "Offizielle Genehmigungen werden nur an Hochlords oder ranghohe Militärbeamte erteilt."

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:387
translate de qst_TheComingStorm_NovarasGatesCantExit_606ce54b:

    # GUARD "Neither of which you are... Move along."
    GUARD "Nichts davon seid ihr... Weitergehen!"

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:388
