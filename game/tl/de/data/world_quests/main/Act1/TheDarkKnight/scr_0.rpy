# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:6
translate de qst_DarkKnight_0_startEvent_5edd6a24:

    # REGINA @ talk "Ah, [player_name!t], there you are."
    REGINA @ talk "Ah, [player_name!t], da bist du ja."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:7
translate de qst_DarkKnight_0_startEvent_cef4d643:

    # MC @ talk "[regina_ref_cap!t]? What is it?"
    MC @ talk "[regina_ref_cap!t]? Was ist es?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:8
translate de qst_DarkKnight_0_startEvent_bdd287cb:

    # REGINA @ talk "An Officer came by with some men today, Lukkan I think it was?"
    REGINA @ talk "Ein Offizier kam heute mit ein paar Männern vorbei, Lukkan, glaube ich, war es?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:9
translate de qst_DarkKnight_0_startEvent_a927b653:

    # REGINA @ talk "He brought a letter which I've left on your bed, says he has some urgent work for you to do."
    REGINA @ talk "Er brachte einen Brief, den ich auf dein Bett gelegt habe, er sagt, er habe dringende Arbeit für dich zu erledigen."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:10
translate de qst_DarkKnight_0_startEvent_84357043:

    # REGINA @ talk "Any idea what all this is about?"
    REGINA @ talk "Irgendeine Ahnung, worum es bei alldem geht?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:11
translate de qst_DarkKnight_0_startEvent_e50dbf2b:

    # MC @ talk "No clue."
    MC @ talk "Keine Ahnung."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:12
translate de qst_DarkKnight_0_startEvent_7e740501:

    # REGINA @ talk "Hmm, well, hopefully it's nothing too dangerous dear..."
    REGINA @ talk "Hmm, nun ja, hoffentlich ist es nichts allzu Gefährliches, mein Schatz..."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:15
translate de qst_DarkKnight_0_startEvent_e0397941:

    # REGINA @ talk "I know you will dear."
    REGINA @ talk "Ich weiß, du wirst es tun, Schatz."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:16
translate de qst_DarkKnight_0_startEvent_063e1639:

    # REGINA @ talk "I know you can handle yourself, but that doesn't mean you're invincible."
    REGINA @ talk "Ich weiß, du kannst auf dich selbst aufpassen, aber das heißt nicht, dass du unverwundbar bist."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:17
translate de qst_DarkKnight_0_startEvent_66b69b31:

    # REGINA @ talk "Take your time and prepare for something if you don't feel ready."
    REGINA @ talk "Lass dir Zeit und bereite dich auf etwas vor, wenn du dich nicht bereit fühlst."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:20
translate de qst_DarkKnight_0_startEvent_15705e04:

    # REGINA @ talk "No, he just 'congratulated' me for raising one of the Scouts' finest and told me to give you that letter."
    REGINA @ talk "Nein, er hat mich nur 'beglückwünscht', dass ich einen der Besten der Späher großgezogen habe, und mir gesagt, dir diesen Brief zu geben."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:21
translate de qst_DarkKnight_0_startEvent_dd26150b:

    # MC @ talk "I take it you didn't like him?"
    MC @ talk "Ich nehme an, du mochtest ihn nicht?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:22
translate de qst_DarkKnight_0_startEvent_5588edc5:

    # REGINA @ talk "Hmph, not him but say... More I'd never trust anyone in the Alderian government."
    REGINA @ talk "Hmph, nicht ihn, aber sagen wir... Eher würde ich niemandem in der alderianischen Regierung vertrauen."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:25
translate de qst_DarkKnight_0_startEvent_d6ab8297:

    # "[regina_ref_cap!t] feigned a smile at the remark."
    "[regina_ref_cap!t] täuschte ein Lächeln bei der Bemerkung vor."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:26
translate de qst_DarkKnight_0_startEvent_eb02d764:

    # REGINA @ talk "Dear... You need to learn to use more than your fists to win every fight."
    REGINA @ talk "Liebes... Du musst lernen, mehr als deine Fäuste einzusetzen, um jeden Kampf zu gewinnen."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:27
translate de qst_DarkKnight_0_startEvent_c4f2687f:

    # MC @ talk "That's why I have my blade."
    MC @ talk "Deshalb habe ich meine Klinge."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:28
translate de qst_DarkKnight_0_startEvent_ab8e2076:

    # REGINA @ talk "That's not..."
    REGINA @ talk "Das ist nicht..."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:29
translate de qst_DarkKnight_0_startEvent_da54c8ca:

    # MC @ talk "Don't worry [regina_ref!t], I know what you meant."
    MC @ talk "Keine Sorge, [regina_ref!t], ich weiß, was du gemeint hast."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:31
translate de qst_DarkKnight_0_startEvent_c065d263:

    # REGINA @ talk "Anyway, I shall leave you to it."
    REGINA @ talk "Wie auch immer, ich lasse dich jetzt."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:32
translate de qst_DarkKnight_0_startEvent_90397aa1:

    # MC @ talk "Thanks [regina_ref!t]."
    MC @ talk "Danke, [regina_ref!t]."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:39
translate de qst_DarkKnight_0_startEvent_7efd249c:

    # MC "(Hmm...)"
    MC "(Hmm...)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:40
translate de qst_DarkKnight_0_startEvent_05049959:

    # MC "(The letter has the official seal on it, so it looks like it means business.)"
    MC "(Der Brief trägt das offizielle Siegel, also scheint es ernst zu sein.)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:41
translate de qst_DarkKnight_0_startEvent_04a0c64d:

    # MC "(Let's see...)"
    MC "(Mal sehen...)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:42
translate de qst_DarkKnight_0_startEvent_d27c8688:

    # LUKKAN "[player_name!t], it has come to my attention that Captain Nyx of the City Watch is in dire need of some support tackling security issues inside and outside the Capital."
    LUKKAN "[player_name!t], mir ist zu Ohren gekommen, dass Hauptmann Nyx von der Stadtwache dringend Unterstützung bei der Bewältigung von Sicherheitsproblemen innerhalb und außerhalb der Hauptstadt benötigt."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:43
translate de qst_DarkKnight_0_startEvent_988d3553:

    # LUKKAN "I have put forward your name for this endeavor, and request you speak to her as soon as possible - Head down to her office at the city fort."
    LUKKAN "Ich habe deinen Namen für dieses Vorhaben vorgeschlagen und bitte dich, sie so bald wie möglich aufzusuchen – Geh zu ihrem Büro im Stadtfort."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:44
translate de qst_DarkKnight_0_startEvent_d00256d8:

    # LUKKAN "Any work you do for her will be graciously rewarded."
    LUKKAN "Jede Arbeit, die du für sie erledigst, wird großzügig belohnt."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:45
translate de qst_DarkKnight_0_startEvent_94652cee:

    # MC "(Great... So much for all our worries being behind us.)"
    MC "(Großartig... So viel dazu, dass all unsere Sorgen hinter uns liegen.)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:46
translate de qst_DarkKnight_0_startEvent_68f73bdc:

    # MC "(I should look into this as soon as I can... It's not wise to keep officials waiting.)"
    MC "(Ich sollte mich so schnell wie möglich darum kümmern... Es ist nicht klug, Beamte warten zu lassen.)"

