# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:151
translate de qst_TwoEmperors_temple_clickableWater_5c07169a:

    # "Peering into the depths of the stagnant water over the edges of the erected stone pathways gave me an uneasy feeling."
    "In die Tiefen des stagnierenden Wassers über die Ränder der aufgestellten Steinpfade zu spähen, gab mir ein ungutes Gefühl."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:152
translate de qst_TwoEmperors_temple_clickableWater_75e29588:

    # "I could not see what was down there, but I could sense movement beneath that blackened water all the same."
    "Ich konnte nicht sehen, was dort unten war, aber ich spürte trotzdem eine Bewegung unter diesem geschwärzten Wasser."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:153
translate de qst_TwoEmperors_temple_clickableWater_16c00e6b:

    # "Just how deep did these waters run?"
    "Wie tief reichten diese Gewässer wohl?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:156
translate de qst_TwoEmperors_temple_clickableWater_d126116d:

    # "I leant down and gently submerged my hand in the cold waters watching the water ripple."
    "Ich beugte mich hinunter und tauchte vorsichtig meine Hand in das kalte Wasser, während ich die Wasserwellen beobachtete."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:157
translate de qst_TwoEmperors_temple_clickableWater_5171c464:

    # "{i}Something{/i} splashed up-ahead in the water once the wave of my ripple passed it."
    "{i}Etwas{/i} platschte voraus im Wasser, sobald die Welle meiner Kräuselung es erreichte."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:158
translate de qst_TwoEmperors_temple_clickableWater_0e4edc86:

    # "I quickly pulled my hand out."
    "Ich zog schnell meine Hand heraus."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:159
translate de qst_TwoEmperors_temple_clickableWater_907c3645:

    # MC "(Probably not a good idea to do that again...)"
    MC "(Wahrscheinlich keine gute Idee, das noch einmal zu tun...)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:163
translate de qst_TwoEmperors_temple_clickableWater_af42c0e5:

    # "Placing my hand into the water, the ripples once again waved across the still waters."
    "Als ich meine Hand ins Wasser hielt, breiteten sich erneut Wellen über das stille Wasser aus."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:167
translate de qst_TwoEmperors_temple_clickableWater_fc27693d:

    # "This time though, bursting out of the waters came a fury of tentacles thrashing wildly!"
    "Diesmal jedoch brach eine wilde Wut aus Tentakeln aus dem Wasser hervor, die wild um sich schlugen!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:168
translate de qst_TwoEmperors_temple_clickableWater_a70c5cab:

    # MC "(FUCK!)"
    MC "(VERDAMMT!)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:179
translate de qst_TwoEmperors_temple_clickableWater_d9bfe972:

    # "Whipping us away with it's powerful tentacles before retreating into the black depths of the water once more."
    "Es peitschte uns mit seinen mächtigen Tentakeln weg, bevor es sich wieder in die schwarzen Tiefen des Wassers zurückzog."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:184
translate de qst_TwoEmperors_temple_clickableWater_ecac9484:

    # "Dazed, me and Markus turned to each other."
    "Benommen drehten Markus und ich uns zueinander um."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:185
translate de qst_TwoEmperors_temple_clickableWater_4cb4fb7b:

    # MARKUS "That thing nearly killed us!"
    MARKUS "Dieses Ding hat uns fast umgebracht!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:186
translate de qst_TwoEmperors_temple_clickableWater_ededc0e0:

    # MC "(We should avoid that thing for now... I don't think it's going to give us a second chance.)"
    MC "(Wir sollten dieses Ding vorerst meiden... Ich glaube nicht, dass es uns eine zweite Chance gibt.)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:191
translate de qst_TwoEmperors_temple_clickableWater_4f11fb8d:

    # "After slashing and tearing off one of the beasts' tentacles that dropped down into the waters, the beast howled in rage as it quickly retreated and submerged itself back into the black depths from where it came."
    "Nachdem wir einen der Tentakel des Biests, der ins Wasser gefallen war, abgeschnitten und abgerissen hatten, heulte das Biest wütend auf, zog sich schnell zurück und tauchte erneut in die schwarzen Tiefen hinab, aus denen es gekommen war."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:199
translate de qst_TwoEmperors_temple_clickableWater_d8fde908:

    # MARKUS "{i}*Huff*{/i}... Would you please stop touching everything?!"
    MARKUS "{i}*Huff*{/i}... Würdest du bitte aufhören, alles anzufassen?!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:201
translate de qst_TwoEmperors_temple_clickableWater_ee79b738:

    # MC "{i}...How the hell does that thing even live down here?{/i}"
