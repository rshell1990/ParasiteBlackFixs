    MC @ talk "Was? {i}Jetzt?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:7
translate de qst_TwoEmperors_3_7d9382a1:

    # MC @ talk "We need to speak to Officer Lukkan!"
    MC @ talk "Wir müssen mit Officer Lukkan sprechen!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:8
translate de qst_TwoEmperors_3_897a6f98:

    # "Markus was unusually dripping with sweat, his face seemingly paler white than before."
    "Markus war ungewöhnlich schweißgebadet, sein Gesicht schien noch blasser als zuvor."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:9
translate de qst_TwoEmperors_3_66683ae0:

    # MARKUS "I'm sorry, I just... I need to go, okay?"
    MARKUS "Es tut mir leid, ich muss einfach... ich muss gehen, okay?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:10
translate de qst_TwoEmperors_3_efcf3d92:

    # MC @ talk "...Fine."
    MC @ talk "...In Ordnung."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:11
translate de qst_TwoEmperors_3_4a32993e:

    # MARKUS "Meet me after at the Iron Unicorn, we can talk more there!"
    MARKUS "Triff mich nachher im Iron Unicorn, dort können wir weiterreden!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:13
translate de qst_TwoEmperors_3_dd722163:

    # "Markus hurried off before I could stop him."
    "Markus eilte davon, bevor ich ihn aufhalten konnte."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:14
translate de qst_TwoEmperors_3_8362d5b0:

    # MC @ talk "Markus!"
    MC @ talk "Markus!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:15
translate de qst_TwoEmperors_3_f8fb3fb3:

    # MC "(...Damn it, what's gotten into him?)"
    MC "(...Verdammt, was ist nur in ihn gefahren?)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:16
translate de qst_TwoEmperors_3_246529dc:

    # MC "(I should head over to speak to Officer Lukkan as soon as possible.)"
    MC "(Ich sollte so bald wie möglich zu Officer Lukkan gehen, um mit ihm zu sprechen.)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:22
translate de qst_TwoEmperors_3_guardDebrief_15273af3:

    # "Entering the city, I heard ringing of armour plates approaching from behind."
    "Als ich die Stadt betrat, hörte ich das Klirren von Rüstungsplatten, die sich von hinten näherten."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:28
translate de qst_TwoEmperors_3_guardDebrief_9ff1ce7e:

    # GUARD "The Emperor wishes to speak to you."
    GUARD "Der Imperator wünscht, mit Ihnen zu sprechen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:29
translate de qst_TwoEmperors_3_guardDebrief_b932b683:

    # GUARD "Right away."
    GUARD "Sofort."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:30
translate de qst_TwoEmperors_3_guardDebrief_fcfd1a28:

    # MC @ think "The Emperor?"
    MC @ think "Der Imperator?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:31
translate de qst_TwoEmperors_3_guardDebrief_d695d013:

    # MC @ talk "But, I'm supposed to report to-"
    MC @ talk "Aber ich soll mich melden bei-"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:32
translate de qst_TwoEmperors_3_guardDebrief_195911eb:

    # GUARD "The Emperor wishes to hear your report directly."
    GUARD "Der Imperator wünscht, Ihren Bericht direkt zu hören."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:33
translate de qst_TwoEmperors_3_guardDebrief_9b85a882:

    # MC @ talk "Where is he?"
    MC @ talk "Wo ist er?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:34
translate de qst_TwoEmperors_3_guardDebrief_d5d543cb:

    # GUARD "He is waiting in Captain Nyx's Office."
    GUARD "Er wartet im Büro von Captain Nyx."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:35
translate de qst_TwoEmperors_3_guardDebrief_3f907879:

    # GUARD "He requests you come immediately."
    GUARD "Er bittet Sie, sofort zu kommen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:36
translate de qst_TwoEmperors_3_guardDebrief_f0b76b43:

    # MC "Well, lead the way then."
    MC "Also, dann geh voran."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:40
translate de qst_TwoEmperors_3_guardDebrief_7dc379c8:

    # "Upon entering Captain Nyx's Office, she was in a fierce mood as she argued with the stoic Emperor."
    "Als wir das Büro von Captain Nyx betraten, war sie in aufgebrachter Stimmung und stritt mit dem stoischen Kaiser."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:46
translate de qst_TwoEmperors_3_guardDebrief_fabade8f:

    # NYX @ angry "I have no more men to pull! My resources are stretched thin as it is!"
    NYX @ angry "Ich habe keine Männer mehr, die ich abziehen kann! Meine Mittel sind ohnehin schon strapaziert!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:47
translate de qst_TwoEmperors_3_guardDebrief_d544e067:

    # ALCOTT @ talk "Did Lukkan not send you that someone from the Adventurers Guild?"
    ALCOTT @ talk "Hat Lukkan euch nicht jemanden von der Abenteurergilde geschickt?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:48
translate de qst_TwoEmperors_3_guardDebrief_f42166ff:

    # ALCOTT @ talk "Did he not succeed in his tasks as instructed?"
    ALCOTT @ talk "Hat er seine Aufgaben nicht wie angewiesen erfüllt?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:49
translate de qst_TwoEmperors_3_guardDebrief_413a23ba:

    # NYX @ angry "Y-Yes!"
    NYX @ angry "J-Ja!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:50
translate de qst_TwoEmperors_3_guardDebrief_b6e613a3:

    # NYX @ angry "But it was a band wrap solution to a gaping wound!"
    NYX @ angry "Aber es war eine Notlösung für eine klaffende Wunde!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:51
translate de qst_TwoEmperors_3_guardDebrief_3783ce75:

    # NYX @ angry "I need {i}more{/i} men to keep this city under control! Not less!"
    NYX @ angry "Ich brauche {i}mehr{/i} Männer, um diese Stadt unter Kontrolle zu halten! Nicht weniger!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:52
translate de qst_TwoEmperors_3_guardDebrief_1f135222:

    # ALCOTT @ talk "Then I will pull some lower tier Adventurers from their quests to assist you for a few months till the situation settles."
    ALCOTT @ talk "Dann werde ich einige Abenteurer niedriger Stufe von ihren Aufträgen abziehen, um euch für ein paar Monate zu unterstützen, bis sich die Situation beruhigt hat."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:53
translate de qst_TwoEmperors_3_guardDebrief_85d58729:

    # ALCOTT @ talk "But for now, it's far more important some of your men are posted elsewhere."
    ALCOTT @ talk "Aber im Moment ist es viel wichtiger, dass einige deiner Männer anderswo stationiert werden."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:54
translate de qst_TwoEmperors_3_guardDebrief_381ff1e6:

    # "Captain Nyx stared in disbelief."
    "Captain Nyx starrte ungläubig."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:55
translate de qst_TwoEmperors_3_guardDebrief_33ced028:

    # NYX @ shock "...{i}The Adventurers Guild?{/i}"
    NYX @ shock "...{i}Die Abenteurergilde?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:56
translate de qst_TwoEmperors_3_guardDebrief_f0d187ab:

    # NYX @ angry "Emperor... Please, I need trained men."
    NYX @ angry "Imperator... Bitte, ich brauche ausgebildete Männer."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:57
translate de qst_TwoEmperors_3_guardDebrief_570f78ed:

    # NYX @ angry "Not a bunch of undisciplined mercenaries!"
    NYX @ angry "Nicht einen Haufen undisziplinierter Söldner!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:58
translate de qst_TwoEmperors_3_guardDebrief_95a85796:

    # ALCOTT @ angry "Captain Nyx, you will follow orders whether you like them or not, are we clear?"
    ALCOTT @ angry "Captain Nyx, Sie werden Befehle befolgen, ob es Ihnen gefällt oder nicht, haben wir uns verstanden?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:59
translate de qst_TwoEmperors_3_guardDebrief_b1118b3b:

    # NYX "...Yes... Emperor."
    NYX "...Ja... Imperator."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:60
translate de qst_TwoEmperors_3_guardDebrief_9dc3c60d:

    # NYX "My apologies for my conduct."
    NYX "Meine Entschuldigungen für mein Verhalten."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:61
translate de qst_TwoEmperors_3_guardDebrief_e64ef127:

    # "The Emperor finally turned to notice me stood waiting in the doorway."
    "Der Imperator drehte sich schließlich um und bemerkte mich, wie ich wartend in der Tür stand."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:62
translate de qst_TwoEmperors_3_guardDebrief_98335569:

    # ALCOTT @ talk "Ah, there you are."
    ALCOTT @ talk "Ah, da sind Sie ja."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:63
translate de qst_TwoEmperors_3_guardDebrief_a29f96a6:

    # ALCOTT @ talk "Captain Nyx, you are dismissed."
    ALCOTT @ talk "Captain Nyx, Sie sind entlassen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:64
translate de qst_TwoEmperors_3_guardDebrief_2bf3e2d4:

    # NYX @ shock "But this is my-"
    NYX @ shock "Aber das ist mein-"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:65
translate de qst_TwoEmperors_3_guardDebrief_67f093d8:

    # ALCOTT @ angry "I would speak with my man now, {i}alone.{/i}"
    ALCOTT @ angry "Ich möchte jetzt mit meinem Mann sprechen, {i}allein.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:66
translate de qst_TwoEmperors_3_guardDebrief_a73acec6:

    # ALCOTT @ angry "You are dismissed, Captain Nyx."
    ALCOTT @ angry "Sie sind entlassen, Captain Nyx."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:67
translate de qst_TwoEmperors_3_guardDebrief_93c383a5:

    # NYX "...Very well, Emperor."
    NYX "...Sehr wohl, Imperator."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:68
translate de qst_TwoEmperors_3_guardDebrief_8ade1e4a:

    # "Captain Nyx after bringing her fist against her chest in a salute, turned to leave."
    "Captain Nyx, nachdem sie ihre Faust zum Salut gegen die Brust geschlagen hatte, drehte sich um und ging."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:71
translate de qst_TwoEmperors_3_guardDebrief_ed969e90:

    # "As she passed by me, we both shared a knowing glance as the guards closed the door behind her."
    "Als sie an mir vorbeiging, tauschten wir beide einen wissenden Blick, während die Wachen die Tür hinter ihr schlossen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:75
translate de qst_TwoEmperors_3_guardDebrief_bbda2531:

    # ALCOTT @ talk "So, what news do you bring?"
    ALCOTT @ talk "Also, welche Neuigkeiten bringst du?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:76
translate de qst_TwoEmperors_3_guardDebrief_a6fe90e1:

    # ALCOTT @ talk "And where is your friend? I had the two of you sent."
    ALCOTT @ talk "Und wo ist dein Freund? Ich habe euch beide geschickt."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:77
translate de qst_TwoEmperors_3_guardDebrief_c2e57570:

    # MC @ talk "He's fine, just... Perhaps a little shaken by what we saw."
    MC @ talk "Ihm geht es gut, nur... Vielleicht etwas erschüttert von dem, was wir gesehen haben."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:78
translate de qst_TwoEmperors_3_guardDebrief_6125bb1e:

    # "Alcott raised an eyebrow at the comment, waiting on me to elaborate."
    "Alcott zog bei der Bemerkung eine Augenbraue hoch und wartete darauf, dass ich es näher erkläre."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:80
translate de qst_TwoEmperors_3_guardDebrief_caa1b21f:

    # "After relaying the events to him to the best of my knowledge..."
    "Nachdem ich ihm die Ereignisse nach bestem Wissen und Gewissen geschildert habe..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:88
translate de qst_TwoEmperors_3_guardDebrief_8e5b9894:

    # ALCOTT @ talk "...Hmm, I see."
    ALCOTT @ talk "...Hmm, ich verstehe."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:89
translate de qst_TwoEmperors_3_guardDebrief_515de8c1:

    # ALCOTT @ talk "So another major offensive is likely being planned soon."
    ALCOTT @ talk "Es wird also wahrscheinlich bald eine weitere Großoffensive geplant."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:90
translate de qst_TwoEmperors_3_guardDebrief_6bddee75:

    # ALCOTT @ talk "It is as I feared."
    ALCOTT @ talk "Es ist, wie ich befürchtet habe."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:91
translate de qst_TwoEmperors_3_guardDebrief_82fa4775:

    # MC @ think "Uhh, you don't seem very surprised."
    MC @ think "Ähh, Sie wirken nicht sehr überrascht."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:92
translate de qst_TwoEmperors_3_guardDebrief_e896e76d:

    # ALCOTT @ talk "That's because I'm not."
    ALCOTT @ talk "Das liegt daran, dass ich es nicht bin."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:93
translate de qst_TwoEmperors_3_guardDebrief_cda1b98f:

    # ALCOTT @ talk "I've known for quite some time about their dark {i}Emperor.{/i}"
    ALCOTT @ talk "Ich weiß schon seit geraumer Zeit von ihrem finsteren {i}Imperator.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:94
translate de qst_TwoEmperors_3_guardDebrief_a65f726f:

    # "I felt my heart sink into my stomach, turning pale white as I took a step back in disbelief."
    "Ich spürte, wie mir das Herz in die Hose rutschte, wurde kreidebleich und trat ungläubig einen Schritt zurück."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:95
translate de qst_TwoEmperors_3_guardDebrief_406e523a:

    # "They knew... After all these years of telling us the Demorai were nothing more than savage monsters of primitive mind, {i}they knew the truth.{/i}"
    "Sie wussten es... Nach all den Jahren, in denen sie uns erzählten, die Demorai seien nichts weiter als wilde Monster mit primitivem Verstand, {i}kannten sie die Wahrheit.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:96
translate de qst_TwoEmperors_3_guardDebrief_b431e554:

    # MC @ surprised "You... {i}You knew?{/i}"
    MC @ surprised "Sie... {i}Sie wussten es?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:97
translate de qst_TwoEmperors_3_guardDebrief_d7350415:

    # MC @ surprised "But... The Demorai... They're not supposed to be-"
    MC @ surprised "Aber... die Demorai... Sie sollten nicht-"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:98
translate de qst_TwoEmperors_3_guardDebrief_2851dedb:

    # ALCOTT @ angry "As far as most people are concerned, the Demorai are just savage beasts ready to rip and tear."
    ALCOTT @ angry "Soweit es die meisten Leute betrifft, sind die Demorai nur wilde Bestien, bereit zu reißen und zu zerfetzen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:99
translate de qst_TwoEmperors_3_guardDebrief_e7ea30f8:

    # ALCOTT @ talk "It is best for everyone's sake we keep it that way."
    ALCOTT @ talk "Es ist zu jedermanns Bestem, dass wir es so beibehalten."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:100
translate de qst_TwoEmperors_3_guardDebrief_e22de872:

    # ALCOTT @ talk "Muddying the waters only invites unnecessary divisive discussions."
    ALCOTT @ talk "Die Gewässer zu trüben, lädt nur zu unnötigen spaltenden Diskussionen ein."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:105
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_8b289247:

    # ALCOTT @ talk "It is a soft lie that the Demorai are unintelligible savages."
    ALCOTT @ talk "Es ist eine sanfte Lüge, dass die Demorai unverständliche Wilde sind."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:106
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_dc64c7cf:

    # ALCOTT @ angry "Make no mistake, intelligent or not, their only goal is to see our destruction."
    ALCOTT @ angry "Machen Sie keinen Fehler, intelligent oder nicht, ihr einziges Ziel ist es, unsere Vernichtung zu sehen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:107
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_1eaa1316:

    # ALCOTT @ talk "We must keep that {i}ethical debate{/i} door shut, for questioning our means will only lead us astray."
    ALCOTT @ talk "Wir müssen diese Tür der {i}ethischen Debatte{/i} geschlossen halten, denn unsere Mittel in Frage zu stellen, wird uns nur in die Irre führen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:108
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_509e5fae:

    # ALCOTT @ talk "We must focus on military victory only; we cannot afford to be distracted and risk dividing ourselves further."
    ALCOTT @ talk "Wir müssen uns nur auf den militärischen Sieg konzentrieren; wir können es uns nicht leisten, abgelenkt zu werden und zu riskieren, uns noch weiter zu spalten."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:111
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_136c0ac1:

    # ALCOTT @ joy "Ha!"
    ALCOTT @ joy "Ha!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:112
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_3b36fad1:

    # ALCOTT @ angry "Listen to me now, and listen good, boy."
    ALCOTT @ angry "Hör mir jetzt zu, und hör genau zu, Junge."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:113
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_832d1377:

    # ALCOTT @ talk "The Demorai have zero interest in any sort of {i}negotiations{/i} while their 'Emperor' rules over them."
    ALCOTT @ talk "Die Demorai haben keinerlei Interesse an irgendwelchen {i}Verhandlungen{/i}, solange ihr 'Imperator' über sie herrscht."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:114
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_0a615b3b:

    # MC @ talk "But why? Why are they doing all this?"
    MC @ talk "Aber warum? Warum tun sie das alles?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:115
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_5ada5ffe:

    # ALCOTT @ talk "Even I do not know that..."
    ALCOTT @ talk "Selbst ich weiß das nicht..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:116
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_a5ca9e15:

    # ALCOTT @ talk "But I know for us there is no seat for us at any negotiations table."
    ALCOTT @ talk "Aber ich weiß, für uns gibt es keinen Platz an irgendeinem Verhandlungstisch."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:117
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_b9e9e364:

    # ALCOTT @ talk "We are no more to them than vermin that need to be wiped out."
    ALCOTT @ talk "Wir sind für sie nicht mehr als Ungeziefer, das ausgerottet werden muss."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:119
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_f3683e6e:

    # ALCOTT @ talk "I don't have all day, so speak quickly."
    ALCOTT @ talk "Ich habe nicht den ganzen Tag, also sprich schnell."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:123
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_e5d688df:

    # ALCOTT "{i}*Sigh*{/i}"
    ALCOTT "{i}*Seufz*{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:124
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_73773068:

    # ALCOTT @ talk "While we do not know much of their society, much like ours, it seems to be at least somewhat factional."
    ALCOTT @ talk "Obwohl wir nicht viel über ihre Gesellschaft wissen, scheint sie, ähnlich wie unsere, zumindest einigermaßen in Fraktionen gespalten zu sein."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:125
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_3f6c32f7:

    # ALCOTT @ talk "{i}One{/i} of these factions has conducted secret meetings with us."
    ALCOTT @ talk "{i}Eine{/i} dieser Fraktionen hat geheime Treffen mit uns abgehalten."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:126
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_39a762c7:

    # MC @ talk "You... {i}Meetings with the Demorai?{/i}"
    MC @ talk "Ihr... {i}Treffen mit den Demorai?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:127
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_cacc4648:

    # ALCOTT @ talk "{i}A faction of Demorai,{/i} yes."
    ALCOTT @ talk "{i}Eine Fraktion der Demorai,{/i} ja."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:128
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_3a49c1c8:

    # ALCOTT @ talk "And while they have been very vague on exactly what their intentions are, they have made it clear they want this war ended."
    ALCOTT @ talk "Und obwohl sie sehr vage darüber sind, was genau ihre Absichten sind, haben sie klargemacht, dass sie diesen Krieg beenden wollen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:131
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_d94b4801:

    # ALCOTT @ talk "I said {i}while{/i} their Emperor rules there is no room for negotiation."
    ALCOTT @ talk "Ich sagte, {i}solange{/i} ihr Imperator herrscht, gibt es keinen Raum für Verhandlungen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:132
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_402dde06:

    # MC @ think "Wait... Does that mean they want-"
    MC @ think "Warte... Heißt das, sie wollen-"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:133
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_9389c8ee:

    # ALCOTT @ talk "I do not know for sure, but before, we have privately assisted each other in matters of intelligence."
    ALCOTT @ talk "Ich weiß es nicht genau, aber zuvor haben wir uns privat in Geheimdienstangelegenheiten gegenseitig unterstützt."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:134
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_b81b0a56:

    # ALCOTT @ talk "And while they are not our allies by any stretch of the imagination... I do believe they perhaps have their own designs outside of their dark Emperors plans."
    ALCOTT @ talk "Und obwohl sie keineswegs unsere Verbündeten sind, glaube ich, dass sie vielleicht ihre eigenen Absichten außerhalb der Pläne ihres dunklen Imperators haben."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:136
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_a6618470:

    # ALCOTT @ talk "We don't know fully."
    ALCOTT @ talk "Wir wissen es nicht vollständig."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:137
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_9b21440b:

    # ALCOTT @ talk "All I have is one contact to communicate with them through."
    ALCOTT @ talk "Alles, was ich habe, ist ein Kontakt, über den ich mit ihnen kommunizieren kann."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:138
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_6eb471bf:

    # ALCOTT @ talk "And no, I'm not sharing who the contact is, before you ask."
    ALCOTT @ talk "Und nein, ich verrate nicht, wer der Kontakt ist, bevor du fragst."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:141
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_dbc0a2fa:

    # "Alcott smiled, but it had no warmth to it."
    "Alcott lächelte, aber es hatte keine Wärme."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:142
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_3b67a2ce:

    # ALCOTT @ smile "{i}...My reasons are my own.{/i}"
    ALCOTT @ smile "{i}...Meine Gründe sind meine eigenen.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:143
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_226f494e:

    # ALCOTT @ talk "Now, you've served the realm well, here, your coin as promised."
    ALCOTT @ talk "Nun, du hast dem Reich gut gedient, hier dein versprochenes Geld."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:145
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_e87d4ae5:

    # ALCOTT @ talk "Oh, and suffice to say..."
    ALCOTT @ talk "Oh, und es genügt zu sagen..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:146
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_bcd2aa9e:

    # ALCOTT @ talk "Nothing I have said leaves this room, are we clear?"
    ALCOTT @ talk "Nichts von dem, was ich gesagt habe, verlässt diesen Raum, ist das klar?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:147
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_850c7dda:

    # ALCOTT @ talk "There would be {i}severe{/i} consequences for that."
    ALCOTT @ talk "Das hätte {i}schwerwiegende{/i} Konsequenzen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:148
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_51f735a3:

    # "Understanding the implication, I nodded."
    "Ich verstand die Andeutung und nickte."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:149
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_856a2fed:

    # MC @ talk "Yes... Emperor."
    MC @ talk "Ja... Kaiser."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:150
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_32dc7ef4:

    # ALCOTT @ talk "Now, you are dismissed."
    ALCOTT @ talk "Nun, du bist entlassen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:153
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_b4d63e3d:

    # "Deciding it unwise to stay any longer, I turned to leave and was escorted out of the Fort by the guards."
    "Da ich es für unklug hielt, noch länger zu bleiben, drehte ich mich um, um zu gehen, und wurde von den Wachen aus dem Fort eskortiert."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:154
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_40224433:

    # MC "(I need to meet with Markus at the {i}Iron Unicorn{/i} later.)"
    MC "(Ich muss mich später mit Markus im {i}Eisernen Einhorn{/i} treffen.)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:155
translate de qst_TwoEmperors_3_guardDebrief_rootMenu_bc0cbfce:

    # MC "(I need to tell him what I know.)"
    MC "(Ich muss ihm sagen, was ich weiß.)"

translate de strings:

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:103
    old "So all this time you've been lying to people!?"
    new "Du hast also die ganze Zeit Leute angelogen!?"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:110
    old "But this means we can talk to the Demorai! Perhaps even negotiate a ceasefire or something!"
    new "Aber das bedeutet, wir können mit den Demorai sprechen! Vielleicht sogar einen Waffenstillstand oder so aushandeln!"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:118
    old "I still have more questions!"
    new "Ich habe noch mehr Fragen!"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:121
    old "How did you know?"
    new "Woher wusstest du das?"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:130
    old "I thought you said there was no room for negotiation?"
    new "Ich dachte, du hast gesagt, es gäbe keinen Verhandlungsspielraum?"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:135
    old "Who is this faction you speak of?"
    new "Wer ist diese Fraktion, von der du sprichst?"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:140
    old "Why are you telling me all this?"
    new "Warum erzählst du mir das alles?"

