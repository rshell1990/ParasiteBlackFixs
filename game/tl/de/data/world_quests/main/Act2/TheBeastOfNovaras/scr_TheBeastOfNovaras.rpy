translate de qst_TheBeastOfNovaras_ZanzibatHouse_5033cf1d:

    # "I gave a curtly bow."
    "Ich machte eine knappe Verbeugung."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1901
translate de qst_TheBeastOfNovaras_ZanzibatHouse_938a175d:

    # MC @ talk "You honour me with this meeting."
    MC @ talk "Ihr ehrt mich mit diesem Treffen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1902
translate de qst_TheBeastOfNovaras_ZanzibatHouse_7d53c472:

    # ZANZIBAT @ talk "Well, how could I resist a chance to meet the saviour of Novaras?"
    ZANZIBAT @ talk "Nun, wie könnte ich der Gelegenheit widerstehen, den Retter von Novaras zu treffen?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1903
translate de qst_TheBeastOfNovaras_ZanzibatHouse_9421f81a:

    # ZANZIBAT @ talk "And especially after that arena performance..."
    ZANZIBAT @ talk "Und besonders nach dieser Arena-Vorstellung..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1904
translate de qst_TheBeastOfNovaras_ZanzibatHouse_06bfc572:

    # MC @ smile "It was a little closer than I would have liked."
    MC @ smile "Es war ein wenig knapper, als mir lieb gewesen wäre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1905
translate de qst_TheBeastOfNovaras_ZanzibatHouse_192088ef:

    # ZANZIBAT @ smile "Mmm... I did think for a moment your blood might spill on the sands."
    ZANZIBAT @ smile "Mmm... Ich dachte tatsächlich für einen Moment, dein Blut könnte auf den Sand spritzen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1906
translate de qst_TheBeastOfNovaras_ZanzibatHouse_f00b249b:

    # ZANZIBAT @ smile "But that rage at the end... It was..."
    ZANZIBAT @ smile "Aber diese Wut am Ende... Das war..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1907
translate de qst_TheBeastOfNovaras_ZanzibatHouse_88c629bd:

    # ZANZIBAT @ smile "Spectacular."
    ZANZIBAT @ smile "Spektakulär."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1908
translate de qst_TheBeastOfNovaras_ZanzibatHouse_d96919ec:

    # "That rage... That blinding hot rage where my body moved without me, where the dark passenger – Shyahtan or whatever his name was, took full control."
    "Diese Wut... Diese blendend heiße Wut, bei der sich mein Körper ohne mich bewegte, bei der der dunkle Passagier – Shyahtan oder wie immer er hieß – die volle Kontrolle übernahm."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1909
translate de qst_TheBeastOfNovaras_ZanzibatHouse_530f4eb0:

    # "I couldn't help but feel... Uncomfortable by the thought."
    "Ich konnte nicht anders, als mich... unwohl bei dem Gedanken zu fühlen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1910
translate de qst_TheBeastOfNovaras_ZanzibatHouse_6549fa11:

    # MC @ talk "... I've come here to ask something of you."
    MC @ talk "... Ich bin hergekommen, um dich um etwas zu bitten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1911
translate de qst_TheBeastOfNovaras_ZanzibatHouse_e858e11e:

    # ZANZIBAT @ smile "Oh, this is a first."
    ZANZIBAT @ smile "Oh, das ist eine Premiere."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1912
translate de qst_TheBeastOfNovaras_ZanzibatHouse_6b05abff:

    # ZANZIBAT @ talk "Normally, I make the offer and let you think on it."
    ZANZIBAT @ talk "Normalerweise mache ich das Angebot und lasse dich darüber nachdenken."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1913
translate de qst_TheBeastOfNovaras_ZanzibatHouse_8997b2f2:

    # ZANZIBAT @ talk "Now you have my attention, what is it you want?"
    ZANZIBAT @ talk "Jetzt hast du meine Aufmerksamkeit, was willst du?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1914
translate de qst_TheBeastOfNovaras_ZanzibatHouse_d934f6d3:

    # MC @ talk "You're one of the last barriers blocking the deal between Novaras and the Greater Trading Company... I want you to let it pass."
    MC @ talk "Du bist eine der letzten Barrieren, die das Geschäft zwischen Novaras und der Großen Handelsgesellschaft blockieren... Ich möchte, dass du es durchlässt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1915
translate de qst_TheBeastOfNovaras_ZanzibatHouse_443ecd71:

    # "Lord Zanzibat considered my words carefully as he slowly paced around the room, gently brushing his hand along one of the plants."
    "Lord Zanzibat bedachte meine Worte sorgfältig, während er langsam im Raum auf und ab ging und sanft mit der Hand über eine der Pflanzen strich."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1916
translate de qst_TheBeastOfNovaras_ZanzibatHouse_61aa857f:

    # ZANZIBAT @ talk "Tell me... do you know why Hamun is still free?"
    ZANZIBAT @ talk "Sag mir... weißt du, warum Hamun immer noch frei ist?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1917
translate de qst_TheBeastOfNovaras_ZanzibatHouse_37dad121:

    # MC @ talk "Because no side dares try to conquer it yet?"
    MC @ talk "Weil noch keine Seite es wagt, es zu erobern?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1918
translate de qst_TheBeastOfNovaras_ZanzibatHouse_f7524e3f:

    # ZANZIBAT @ smile "In part. But the truth is simpler: Hamun sells its table to *all* sides, and takes none."
    ZANZIBAT @ smile "Teilweise. Aber die Wahrheit ist einfacher: Hamun verkauft seinen Tisch an *alle* Seiten und nimmt keine."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1919
translate de qst_TheBeastOfNovaras_ZanzibatHouse_c0766e48:

    # ZANZIBAT @ smile "Kings, rebels, merchants, priests, each can bargain here."
    ZANZIBAT @ smile "Könige, Rebellen, Händler, Priester, jeder kann hier verhandeln."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1920
translate de qst_TheBeastOfNovaras_ZanzibatHouse_0ae0fa98:

    # ZANZIBAT @ smile "That is our shield."
    ZANZIBAT @ smile "Das ist unser Schild."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1921
translate de qst_TheBeastOfNovaras_ZanzibatHouse_bfc3b19b:

    # ZANZIBAT @ serious "The Greater Trading Company would break that balance."
    ZANZIBAT @ serious "Die Große Handelsgesellschaft würde dieses Gleichgewicht brechen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1922
translate de qst_TheBeastOfNovaras_ZanzibatHouse_c263fb66:

    # ZANZIBAT @ serious "They are not merchants, they are parasites."
    ZANZIBAT @ serious "Sie sind keine Händler, sie sind Parasiten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1923
translate de qst_TheBeastOfNovaras_ZanzibatHouse_686f45a6:

    # ZANZIBAT @ serious "Once they take root, they twist every throne they touch."
    ZANZIBAT @ serious "Sobald sie Wurzeln schlagen, verdrehen sie jeden Thron, den sie berühren."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1924
translate de qst_TheBeastOfNovaras_ZanzibatHouse_86307e7e:

    # ZANZIBAT @ talk "Do you know the fate of the People of Wei?"
    ZANZIBAT @ talk "Kennst du das Schicksal des Volkes von Wei?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1925
translate de qst_TheBeastOfNovaras_ZanzibatHouse_11d4edaf:

    # ZANZIBAT @ talk "In less than fifty years, the GTC bought their land, scattered their bloodline, and sold the survivors on the backs of Paruh beasts."
    ZANZIBAT @ talk "In weniger als fünfzig Jahren kaufte die GTC ihr Land, zerstreute ihre Blutlinie und verkaufte die Überlebenden auf den Rücken von Paruh-Bestien."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1926
translate de qst_TheBeastOfNovaras_ZanzibatHouse_e72be1c9:

    # ZANZIBAT @ smile "So tell me... why should I welcome that fate here?"
    ZANZIBAT @ smile "Also sag mir... warum sollte ich dieses Schicksal hier willkommen heißen?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1933
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_350fd090:

    # ZANZIBAT @ talk "It shall, but it's the difference between the deal passing in the next three months and the next three years."
    ZANZIBAT @ talk "Das wird es, aber es ist der Unterschied, ob der Deal in den nächsten drei Monaten oder den nächsten drei Jahren durchgeht."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1937
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_d3c8843a:

    # ZANZIBAT @ talk "I have had dealings with them in the past."
    ZANZIBAT @ talk "Ich hatte bereits in der Vergangenheit mit ihnen zu tun."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1938
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_d466e272:

    # ZANZIBAT @ talk "None of which have ended well... For anyone involved."
    ZANZIBAT @ talk "Keines davon endete gut... Für alle Beteiligten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1939
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_8de44649:

    # ZANZIBAT @ talk "You would do well to be parted from their 'business' as soon as you can."
    ZANZIBAT @ talk "Du tätest gut daran, dich so bald wie möglich von ihren 'Geschäften' zu trennen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1944
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_3f011ce2:

    # MC "Then what would it take to persuade you?"
    MC "Was würde es dann brauchen, um dich zu überzeugen?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1945
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_c21c67dc:

    # ZANZIBAT @ talk "... Hmm."
    ZANZIBAT @ talk "... Hmm."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1946
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_9fdbb0e5:

    # ZANZIBAT @ talk "The shipping rights."
    ZANZIBAT @ talk "Die Schifffahrtsrechte."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1947
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Was?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1948
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_9e7a2320:

    # ZANZIBAT @ talk "I want them to agree to only use my ships to transport the goods from Alderay to Skarshire and vice versa."
    ZANZIBAT @ talk "Ich möchte, dass sie zustimmen, nur meine Schiffe für den Transport der Waren von Alderay nach Skarshire und umgekehrt zu nutzen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1949
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_3f36b076:

    # MC @ serious "For someone so against them, you seem more than ready to jump into business with them again."
    MC @ serious "Für jemanden, der so gegen sie ist, scheinst du mehr als bereit zu sein, wieder Geschäfte mit ihnen zu machen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1950
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_483cf438:

    # ZANZIBAT @ smile "It's as the old proverb says."
    ZANZIBAT @ smile "Es ist, wie das alte Sprichwort sagt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1951
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_f5dd4b8d:

    # ZANZIBAT @ talk "{i}Keep your friends close, and keep your enemies even closer.{/i}"
    ZANZIBAT @ talk "{i}Halte deine Freunde nah bei dir, und deine Feinde noch näher.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1952
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_a872cabc:

    # ZANZIBAT @ talk "Tell the GTC my answer."
    ZANZIBAT @ talk "Übermittle dem GTC meine Antwort."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1954
translate de qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_a72b3584:

    # ZANZIBAT @ talk "{i}I will expect the agreement in writing... and on their god.{/i}"
    ZANZIBAT @ talk "{i}Ich erwarte die Vereinbarung schriftlich ... und bei ihrem Gott.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1962
translate de qst_TheBeastOfNovaras_TalkToGarenBar_0a1e03ae:

    # GAREN "Can I help you with something?"
    GAREN "Kann ich dir mit etwas helfen?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1965
translate de qst_TheBeastOfNovaras_TalkToGarenBar_66b0402a:

    # GAREN @ think "Go on?"
    GAREN @ think "Weiter?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1966
translate de qst_TheBeastOfNovaras_TalkToGarenBar_fb0e6d2b:

    # MC @ talk "He will step aside and allow the deal to pass {i}if{/i} his ships are used to transport the cargo to and from Skarshire."
    MC @ talk "Er wird zur Seite treten und den Deal zulassen, {i}wenn{/i} seine Schiffe für den Transport der Fracht von und nach Skarshire genutzt werden."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1967
translate de qst_TheBeastOfNovaras_TalkToGarenBar_995dd8b9:

    # GAREN @ smile "... Very well, I shall arrange the papers for him."
    GAREN @ smile "... Nun gut, ich werde die Papiere für ihn vorbereiten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1968
translate de qst_TheBeastOfNovaras_TalkToGarenBar_4ee67eb4:

    # MC @ think "Just like that?"
    MC @ think "Einfach so?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1969
translate de qst_TheBeastOfNovaras_TalkToGarenBar_4fb6e909:

    # MC @ think "No bartering, no negotiation?"
    MC @ think "Kein Feilschen, keine Verhandlung?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1970
translate de qst_TheBeastOfNovaras_TalkToGarenBar_d8251d85:

    # GAREN @ smile "The desert fox has made his offer."
    GAREN @ smile "Der Wüstenfuchs hat sein Angebot gemacht."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1971
translate de qst_TheBeastOfNovaras_TalkToGarenBar_58c3d475:

    # GAREN @ smile "I am sure he will obsess over every word of the papers I send, but within a few days at the most we will conclude our business."
    GAREN @ smile "Ich bin sicher, er wird jedes Wort der Papiere, die ich sende, genau unter die Lupe nehmen, aber innerhalb weniger Tage werden wir unser Geschäft abschließen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1972
translate de qst_TheBeastOfNovaras_TalkToGarenBar_edbe0460:

    # MC @ talk "How can you be so sure?"
    MC @ talk "Wie könnt Ihr da so sicher sein?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1973
translate de qst_TheBeastOfNovaras_TalkToGarenBar_00346b84:

    # GAREN @ talk "Because despite his hatred of us, he's always more than willing to do business with us."
    GAREN @ talk "Weil er, trotz seines Hasses auf uns, immer mehr als bereit ist, mit uns Geschäfte zu machen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1974
translate de qst_TheBeastOfNovaras_TalkToGarenBar_11568e73:

    # GAREN @ talk "It is a game to him, I believe, to see if he can outsmart us."
    GAREN @ talk "Es ist ein Spiel für ihn, glaube ich, um zu sehen, ob er uns überlisten kann."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1975
translate de qst_TheBeastOfNovaras_TalkToGarenBar_69989a6a:

    # MC @ think "If you're just giving him everything he wants, doesn't that mean he's already won?"
    MC @ think "Wenn Ihr ihm einfach alles gebt, was er will, bedeutet das nicht, dass er bereits gewonnen hat?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1976
translate de qst_TheBeastOfNovaras_TalkToGarenBar_903ddcb0:

    # GAREN @ smile "{i}Only if he can keep to his end of the bargain.{/i}"
    GAREN @ smile "{i}Nur wenn er seinen Teil der Abmachung einhalten kann.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1977
translate de qst_TheBeastOfNovaras_TalkToGarenBar_2192f037:

    # MC @ think "What do you mean by that?"
    MC @ think "Was meinst du damit?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1978
translate de qst_TheBeastOfNovaras_TalkToGarenBar_252641ae:

    # GAREN @ talk "{i}We are bound only by the wording of our contract... Nothing more.{/i}"
    GAREN @ talk "{i}Wir sind nur an den Wortlaut unseres Vertrags gebunden... Nichts weiter.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1979
translate de qst_TheBeastOfNovaras_TalkToGarenBar_6a444706:

    # GAREN @ smile "If you have a moment, I could humour you with a tale."
    GAREN @ smile "Wenn du einen Moment Zeit hast, könnte ich dich mit einer Geschichte unterhalten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1982
translate de qst_TheBeastOfNovaras_TalkToGarenBar_2cff701a:

    # GAREN @ talk "There was once a lord who swore, if we armed him and filled his ranks with our mercenaries, he would crush his rival within the year."
    GAREN @ talk "Es war einmal ein Lord, der schwor, wenn wir ihn bewaffneten und seine Reihen mit unseren Söldnern füllten, würde er seinen Rivalen innerhalb eines Jahres vernichten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1983
translate de qst_TheBeastOfNovaras_TalkToGarenBar_6884319c:

    # GAREN @ talk "Payment was guaranteed. And if not, his castle would be ours."
    GAREN @ talk "Die Bezahlung war garantiert. Und falls nicht, würde seine Burg uns gehören."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1984
translate de qst_TheBeastOfNovaras_TalkToGarenBar_4dd2ec1a:

    # GAREN @ talk "A bold deal. Too bold. Because his rival came to us with the very same request."
    GAREN @ talk "Ein kühner Handel. Zu kühn. Denn sein Rivale kam mit genau derselben Bitte zu uns."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1985
translate de qst_TheBeastOfNovaras_TalkToGarenBar_e47a45b8:

    # MC @ surprised "Surely that's a conflict of interest?"
    MC @ surprised "Das ist doch sicher ein Interessenkonflikt?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1986
translate de qst_TheBeastOfNovaras_TalkToGarenBar_869b5883:

    # GAREN @ smile "Not if the contract doesn't forbid it."
    GAREN @ smile "Nicht, wenn der Vertrag es nicht verbietet."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1987
translate de qst_TheBeastOfNovaras_TalkToGarenBar_ff958f57:

    # GAREN @ talk "So we sold both sides weapons. We took both their coin. And when their coffers ran dry... we took collateral."
    GAREN @ talk "Also verkauften wir beiden Seiten Waffen. Wir nahmen beider Münzen. Und als ihre Kassen leer waren... nahmen wir Sicherheiten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1988
translate de qst_TheBeastOfNovaras_TalkToGarenBar_f88c955e:

    # GAREN @ talk "First land. Then blood. Piece by piece, both lords fed us their realms rather than admit defeat."
    GAREN @ talk "Erst Land. Dann Blut. Stück für Stück fütterten uns beide Lords ihre Reiche, anstatt die Niederlage einzugestehen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1989
translate de qst_TheBeastOfNovaras_TalkToGarenBar_5078ca82:

    # GAREN @ smile "By the second year, neither could pay another coin. One was hanged in the square. The other drowned in his own bath."
    GAREN @ smile "Bis zum zweiten Jahr konnte keiner mehr eine Münze zahlen. Einer wurde auf dem Platz gehängt. Der andere ertrank in seiner eigenen Badewanne."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1990
translate de qst_TheBeastOfNovaras_TalkToGarenBar_0f8d033b:

    # MC @ scared "... That's monstrous."
    MC @ scared "... Das ist ungeheuerlich."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1991
translate de qst_TheBeastOfNovaras_TalkToGarenBar_564c8dd2:

    # GAREN @ think "Is it? They could have stopped. Pride kept them blind."
    GAREN @ think "Ist es das? Sie hätten aufhören können. Ihr Stolz machte sie blind."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1992
translate de qst_TheBeastOfNovaras_TalkToGarenBar_14d8e3ee:

    # GAREN @ smile "That is the true lesson: greed makes men puppets, and we hold the strings."
    GAREN @ smile "Das ist die wahre Lektion: Gier macht Männer zu Marionetten, und wir halten die Fäden."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1996
translate de qst_TheBeastOfNovaras_TalkToGarenBar_106b3d3e:

    # GAREN @ smile "Of course, another time perhaps."
    GAREN @ smile "Natürlich, vielleicht ein anderes Mal."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2000
translate de qst_TheBeastOfNovaras_TalkToGarenBar_cd7f5b31:

    # GAREN @ talk "Until the ink meets the page then."
    GAREN @ talk "Bis dann die Tinte auf das Papier trifft."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2003
translate de qst_TheBeastOfNovaras_TalkToGarenBar_e8b55b4e:

    # GAREN @ smile "You have done well here."
    GAREN @ smile "Du hast hier gute Arbeit geleistet."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2004
translate de qst_TheBeastOfNovaras_TalkToGarenBar_d452e86b:

    # MC @ think "All this trouble... Why not just ask Lord Zanzibat yourselves?"
    MC @ think "All dieser Aufwand... Warum fragt ihr Lord Zanzibat nicht einfach selbst?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2005
translate de qst_TheBeastOfNovaras_TalkToGarenBar_7ee32d5e:

    # MC @ think "Why use me?"
    MC @ think "Warum benutzt ihr mich?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2006
translate de qst_TheBeastOfNovaras_TalkToGarenBar_b540657a:

    # GAREN @ talk "Because Lord Zanzibat only plays the {i}great game{/i} on his terms."
    GAREN @ talk "Weil Lord Zanzibat das {i}große Spiel{/i} nur zu seinen Bedingungen spielt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2007
translate de qst_TheBeastOfNovaras_TalkToGarenBar_d1abcf29:

    # GAREN @ talk "He would {i}expect{/i} some kind of enticing offer to even bring him to the table."
    GAREN @ talk "Er würde {i}erwarten{/i}, dass ein verlockendes Angebot ihn überhaupt erst an den Tisch bringt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2008
translate de qst_TheBeastOfNovaras_TalkToGarenBar_d6e1ac52:

    # GAREN @ talk "...And."
    GAREN @ talk "...Und."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2009
translate de qst_TheBeastOfNovaras_TalkToGarenBar_4e56044d:

    # "Garen's face slowly shifts into a smile without any warmth."
    "Garens Gesicht verzieht sich langsam zu einem Lächeln ohne jede Wärme."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2010
translate de qst_TheBeastOfNovaras_TalkToGarenBar_83130464:

    # GAREN @ smile "The Greater Trading Company is always looking for new assets."
    GAREN @ smile "Die Greater Trading Company sucht immer nach neuen Vermögenswerten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2011
translate de qst_TheBeastOfNovaras_TalkToGarenBar_8455a15f:

    # GAREN @ smile "{i}You are so far proving yourself a valuable asset.{/i}"
    GAREN @ smile "{i}Bis jetzt erweist du dich als wertvolles Gut.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2012
translate de qst_TheBeastOfNovaras_TalkToGarenBar_9429e63d:

    # GAREN @ talk "I shall return soon after I handle Lord Zanzibat."
    GAREN @ talk "Ich werde bald zurückkehren, nachdem ich mich um Lord Zanzibat gekümmert habe."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2013
translate de qst_TheBeastOfNovaras_TalkToGarenBar_736ebcd9:

    # MC @ think "What am I to do until then?"
    MC @ think "Was soll ich bis dahin tun?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2014
translate de qst_TheBeastOfNovaras_TalkToGarenBar_a513ccf1:

    # GAREN @ talk "Whatever you so desire."
    GAREN @ talk "Was immer du wünschst."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2015
translate de qst_TheBeastOfNovaras_TalkToGarenBar_f1c8b685:

    # GAREN @ talk "{i}... The GTC is pleased with your progress.{/i}"
    GAREN @ talk "{i}... Die GTC ist mit deinen Fortschritten zufrieden.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2016
translate de qst_TheBeastOfNovaras_TalkToGarenBar_2cc04117:

    # GAREN @ talk "{i}Good work.{/i}"
    GAREN @ talk "{i}Gute Arbeit.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2018
translate de qst_TheBeastOfNovaras_TalkToGarenBar_1a65813e:

    # "With a small, curtly tilt of his head towards me, Garen Quiltshire left {i}The Pale Dragon.{/i}"
    "Mit einer kleinen, knappen Kopfneigung in meine Richtung verließ Garen Quiltshire {i}Der blasse Drache{/i}."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2019
translate de qst_TheBeastOfNovaras_TalkToGarenBar_d47561b9:

    # "Once more, leaving me without direction."
    "Wieder einmal ließ er mich richtungslos zurück."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2020
translate de qst_TheBeastOfNovaras_TalkToGarenBar_695d4c57:

    # "As I stood there directionless I felt the brush of a soft hand on the back of my arm."
    "Als ich so richtungslos dastand, spürte ich die zarte Berührung einer Hand auf der Rückseite meines Arms."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2022
translate de qst_TheBeastOfNovaras_TalkToGarenBar_7506c8bd:

    # "Sypha appeared alongside me, smiling softly."
    "Sypha erschien neben mir und lächelte sanft."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2023
translate de qst_TheBeastOfNovaras_TalkToGarenBar_ed3729c1:

    # SYPHA @ happy "You and I."
    SYPHA @ happy "Du und ich."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2024
translate de qst_TheBeastOfNovaras_TalkToGarenBar_f33904df:

    # SYPHA @ happy "Tonight... we slip away."
    SYPHA @ happy "Heute Nacht... schleichen wir uns davon."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2025
translate de qst_TheBeastOfNovaras_TalkToGarenBar_8ec2dc43:

    # SYPHA @ happy "{i}Just the two of us.{/i}"
    SYPHA @ happy "{i}Nur wir beide.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2026
translate de qst_TheBeastOfNovaras_TalkToGarenBar_64b99b7e:

    # MC @ think "I thought you would still be angry with me?"
    MC @ think "Ich dachte, du wärst immer noch wütend auf mich?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2027
translate de qst_TheBeastOfNovaras_TalkToGarenBar_b58f3630:

    # SYPHA @ happy "Oh, I am."
    SYPHA @ happy "Oh, das bin ich."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2028
translate de qst_TheBeastOfNovaras_TalkToGarenBar_f9cd6c18:

    # SYPHA @ happy "But anger burns bright... and bright flames can be put to better use, don't you think?"
    SYPHA @ happy "Aber Wut brennt hell... und helle Flammen lassen sich besser nutzen, findest du nicht?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2029
translate de qst_TheBeastOfNovaras_TalkToGarenBar_5994274b:

    # MC @ think "You change your mind quickly."
    MC @ think "Du änderst schnell deine Meinung."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2030
translate de qst_TheBeastOfNovaras_TalkToGarenBar_544cdd6c:

    # "A soft, coy smile curved on her lips, eyes gleaming with something equal parts danger and desire."
    "Ein sanftes, kokettes Lächeln spielte um ihre Lippen, ihre Augen glänzten mit etwas, das ebenso aus Gefahr wie aus Verlangen bestand."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2031
translate de qst_TheBeastOfNovaras_TalkToGarenBar_342f3455:

    # SYPHA @ happy "There's a night market. Music, smoke, secrets for sale."
    SYPHA @ happy "Es gibt einen Nachtmarkt. Musik, Rauch, Geheimnisse zu verkaufen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2032
translate de qst_TheBeastOfNovaras_TalkToGarenBar_4690fb80:

    # SYPHA @ happy "Meet me there after dark, and I'll give you what you're craving."
    SYPHA @ happy "Triff mich dort nach Einbruch der Dunkelheit, und ich gebe dir, wonach du dich sehnst."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2033
translate de qst_TheBeastOfNovaras_TalkToGarenBar_93d92d0b:

    # MC @ serious "Answers?"
    MC @ serious "Antworten?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2034
translate de qst_TheBeastOfNovaras_TalkToGarenBar_cf587495:

    # SYPHA @ happy "Some answers... some temptations."
    SYPHA @ happy "Einige Antworten ... einige Versuchungen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2035
translate de qst_TheBeastOfNovaras_TalkToGarenBar_29779741:

    # SYPHA @ happy "Enough to keep you coming back for more."
    SYPHA @ happy "Genug, um dich immer wieder zurückkommen zu lassen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2036
translate de qst_TheBeastOfNovaras_TalkToGarenBar_1b15e7ec:

    # "She brushed herself along my arm deliberately, her breath hot against my ear."
    "Sie strich absichtlich an meinem Arm entlang, ihr Atem heiß an meinem Ohr."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2037
translate de qst_TheBeastOfNovaras_TalkToGarenBar_a691ecc2:

    # SYPHA @ perv "Don't be late... {i}dear.{/i}"
    SYPHA @ perv "Komm nicht zu spät ... {i}Liebes.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2039
translate de qst_TheBeastOfNovaras_TalkToGarenBar_cacf25ce:

    # MC @ serious "(Well... I have some time before Garen returns.)"
    MC @ serious "(Nun ... ich habe etwas Zeit, bevor Garen zurückkommt.)"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2040
translate de qst_TheBeastOfNovaras_TalkToGarenBar_00dfcaa0:

    # MC @ serious "(I should tread careful with this Sypha, she's no doubt toying with me.)"
    MC @ serious "(Ich sollte vorsichtig sein mit dieser Sypha, sie spielt zweifellos mit mir.)"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2041
translate de qst_TheBeastOfNovaras_TalkToGarenBar_c1b28386:

