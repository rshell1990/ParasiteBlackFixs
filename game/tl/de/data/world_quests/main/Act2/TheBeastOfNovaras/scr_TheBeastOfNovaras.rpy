# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1764
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_113b25c0:

    # SHYAHTAN "Correct."
    SHYAHTAN "Richtig."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1765
