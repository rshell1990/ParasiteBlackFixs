    # SHYAHTAN "Pieces. Wars beneath strange skies. Feasts after slaughter. Concubines by the hundred, nameless, blurred."
    SHYAHTAN "Stücke. Kriege unter fremden Himmeln. Feste nach dem Gemetzel. Konkubinen zu Hunderten, namenlos, verschwommen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1745
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_9d4fc3c1:

    # SHYAHTAN "There is more. Locked away. Waiting."
    SHYAHTAN "Es gibt mehr. Weggesperrt. Wartend."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1749
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_527b51a7:

    # SHYAHTAN "I do not know."
    SHYAHTAN "Ich weiß es nicht."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1750
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_116cb9b7:

    # SHYAHTAN "Out there still, among the stars."
    SHYAHTAN "Noch immer da draußen, unter den Sternen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1751
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_9ac4149d:

    # SHYAHTAN "{i}I have no idea how I ended up on this world...{/i}"
    SHYAHTAN "{i}Ich habe keine Ahnung, wie ich auf diese Welt gekommen bin...{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1756
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_b5ce9a16:

    # MC "That... Terran at the end of the dream... {i}didn't it kind of look like Markus?{/i}"
    MC "Dieser... Terraner am Ende des Traums... {i}sah er nicht irgendwie aus wie Markus?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1759
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_fb2ef6b1:

    # SHYAHTAN "Yes... And we must not let it know."
    SHYAHTAN "Ja... Und wir dürfen es nicht wissen lassen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1760
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_9e37ba5f:

