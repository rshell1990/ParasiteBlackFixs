    YARRICK @ talk "Ein Teil der Münzen, die ich verdient hatte, war..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1809
translate de qst_TheBeastOfNovaras_ReturnToYarrickAfterCaltrack_yarrickreturntalk_d46b452e:

    # YARRICK @ sad "{i}Confiscated.{/i}"
    YARRICK @ sad "{i}Konfisziert.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1810
translate de qst_TheBeastOfNovaras_ReturnToYarrickAfterCaltrack_yarrickreturntalk_8c33dda3:

