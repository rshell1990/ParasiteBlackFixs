translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_436bd99a:

    # HIVE_LORD "{b}Or could it be because you know your *true* feelings toward me would be laid bare for all to see?{/b}"
    HIVE_LORD "{b}Oder könnte es sein, weil du weißt, dass deine *wahren* Gefühle für mich für alle sichtbar offenbart würden?{/b}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1206
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_d9acc812:

    # SHYAHTAN "..."
    SHYAHTAN "..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1207
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_044ee0d7:

    # SHYAHTAN "...Great Hive Lord, my true feelings for you are nothing but-"
    SHYAHTAN "...Großer Hive Lord, meine wahren Gefühle für Euch sind nichts als-"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1208
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_c2888de1:

    # "For the faintest moment I paused, the words coming out awkwardly."
    "Für den winzigsten Moment hielt ich inne, die Worte kamen unbeholfen heraus."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1209
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_4c1502e6:

    # SHYAHTAN "{b}Loyalty and adoration.{/b}"
    SHYAHTAN "{b}Loyalität und Verehrung.{/b}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1210
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_7a86e66e:

    # HIVE_LORD "..."
    HIVE_LORD "..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1211
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_aa95d732:

    # "The Great Hive Lord tilted his head forward once more."
    "Der Große Hive Lord neigte seinen Kopf erneut nach vorne."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1212
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_5a555836:

    # HIVE_LORD "{i}Of course, Shyahtan... my greatest general.{/i}"
    HIVE_LORD "{i}Natürlich, Shyahtan... mein größter General.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1213
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_c5a16420:

    # HIVE_LORD "Never have I doubted your loyalty."
    HIVE_LORD "Niemals habe ich an deiner Loyalität gezweifelt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1214
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_b9e35433:

    # HIVE_LORD "{i}...Though some believe you are destined to become the new Hive Lord once I return to our great father.{/i}"
    HIVE_LORD "{i}...Obwohl einige glauben, dass du dazu bestimmt bist, der neue Hive-Lord zu werden, sobald ich zu unserem großen Vater zurückkehre.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1215
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_9cb9c1a8:

    # SHYAHTAN "Then give me these traitors' names and I will see to it my Zarpod feasts upon them."
    SHYAHTAN "Dann gib mir die Namen dieser Verräter, und ich werde dafür sorgen, dass mein Zarpod sich an ihnen labt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1216
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_8ba529fe:

    # HIVE_LORD "...Do you remember the Hive Wars, Shyahtan?"
    HIVE_LORD "Erinnerst du dich an die Hive-Kriege, Shyahtan?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1217
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_a3e3e6f7:

    # SHYAHTAN "Those of us who survived could never forget, Hive Lord."
    SHYAHTAN "Wir, die überlebt haben, können das niemals vergessen, Hive-Lord."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1218
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_6810b3ed:

    # SHYAHTAN "{i}Do {b}you{/b} remember, Hive Lord, how we fought side by side to exterminate the rogue hive?{/i}"
    SHYAHTAN "{i}Erinnerst {b}du{/b} dich, Hive-Lord, wie wir Seite an Seite gekämpft haben, um das abtrünnige Hive auszurotten?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1219
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_375ba8bb:

    # "The Hive Lord didn't answer."
    "Der Hive-Lord antwortete nicht."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1220
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_f2942cf3:

    # "With a heavy sigh, he turned fully to face me."
    "Mit einem schweren Seufzer drehte er sich vollständig um, mir gegenüberzustehen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1221
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_ba3f361a:

    # HIVE_LORD "I have someone I wish for you to meet."
    HIVE_LORD "Ich habe jemanden, den ich dir vorstellen möchte."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1222
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_eba7a4c2:

    # HIVE_LORD "A new strain I have helped develop."
    HIVE_LORD "Eine neue Rasse, bei deren Entwicklung ich geholfen habe."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1223
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_c887cb4f:

    # HIVE_LORD "I hope you will adopt him under your clan's banners for now."
    HIVE_LORD "Ich hoffe, du wirst ihn vorerst unter den Bannern deines Klans aufnehmen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1224
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_52a67e0e:

    # "The Hive Lord turned to his personal guard."
    "Der Schwarmlord wandte sich an seine persönliche Wache."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1225
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_cbd3a895:

    # HIVE_LORD "Bring in Eight-Six-One."
    HIVE_LORD "Bringt Acht-Sechs-Eins herein."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1226
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_d350cc90:

    # SHYAHTAN "One of your pet projects?"
    SHYAHTAN "Eines deiner Lieblingsprojekte?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1227
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_8c343811:

    # HIVE_LORD "{i}Something like that.{/i}"
    HIVE_LORD "{i}So etwas in der Art.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1231
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_6c73278f:

    # "As the fleshy spiral doors opened, a skinny, pale-white Terran approached."
    "Als sich die fleischigen Spiraltüren öffneten, näherte sich ein dürrer, blassweißer Terraner."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1234
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_e5272129:

    # EIGHT_SIX_ONE "...G-Greetings, Lord Shyahtan."
    EIGHT_SIX_ONE "...G-Grüße, Lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1235
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_5f84324c:

    # MARKUS "WAKE UP!"
    MARKUS "WACH AUF!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1236
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_47333513:

    # SHYAHTAN "A white strain?"
    SHYAHTAN "Ein weißer Stamm?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1237
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_2daa1143:

    # SHYAHTAN "What is he-"
    SHYAHTAN "Was ist er-"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1238
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_6b39ce73:

    # "I felt the claws of the Hive Lord rest on my shoulder."
    "Ich spürte, wie die Klauen des Schwarmlords auf meiner Schulter ruhten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1239
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_6995b2a0:

    # HIVE_LORD "I will watch his performance with great interest, Lord Shyahtan."
    HIVE_LORD "Ich werde seine Vorstellung mit großem Interesse verfolgen, Lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1240
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_5f59a957:

    # "The skinny Terran offered a nervous, curt bow."
    "Der dünne Terraner machte eine nervöse, knappe Verbeugung."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1243
translate de qst_TheBeastOfNovaras_ReturnFromMerlanians_072968fa:

    # EIGHT_SIX_ONE "I am... at your s-service, my lord."
    EIGHT_SIX_ONE "Ich stehe... zu Ihren D-Diensten, mein Lord."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1258
