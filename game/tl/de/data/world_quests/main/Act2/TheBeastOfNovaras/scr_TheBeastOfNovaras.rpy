    MC @ think "Was, warum?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1761
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_6c09e5d4:

    # SHYAHTAN "I have the faintest memory that only the most dangerous and unstable genes of my species were placed into stasis."
    SHYAHTAN "Ich habe die schwächste Erinnerung daran, dass nur die gefährlichsten und instabilsten Gene meiner Spezies in Stasis versetzt wurden."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1762
