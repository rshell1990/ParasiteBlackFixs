    "Als Yarrick vortrat, versperrte ihm die Wache den Weg."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1870
translate de qst_TheBeastOfNovaras_ZanzibatHouse_ed310237:

    # GUARD "Not you."
    GUARD "Nicht du."

