# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:97
translate de qst_TheBeastOfNovaras_BarSceneShared_0177b3c5:

    # MARKUS @ angry "Not yet. Still deciding if I'm meant to follow orders... or gut a snake before it coils too tight."
    MARKUS @ angry "Noch nicht. Entscheide noch, ob ich Befehlen folgen soll ... oder eine Schlange ausweide, bevor sie sich zu fest zusammenrollt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:100
translate de qst_TheBeastOfNovaras_BarSceneShared_28e9a95b:

    # SYPHA @ laugh "Oh, delightful! A tongue as sharp as a sword."
    SYPHA @ laugh "Oh, entzückend! Eine Zunge so scharf wie ein Schwert."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:101
translate de qst_TheBeastOfNovaras_BarSceneShared_480928c6:

    # SYPHA @ laugh "Amusing, really. HILARIOUS even!"
    SYPHA @ laugh "Amüsant, wirklich. Sogar LUSTIG!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:102
translate de qst_TheBeastOfNovaras_BarSceneShared_6a8ca7ac:

    # SYPHA @ happy "But be careful, jokes can get men killed. Try me, and I'll see your head displayed on a pike before dusk."
    SYPHA @ happy "Aber sei vorsichtig, Witze können Männer das Leben kosten. Versuch es mit mir, und ich sorge dafür, dass dein Kopf noch vor Einbruch der Dunkelheit auf einem Spieß prangt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:103
translate de qst_TheBeastOfNovaras_BarSceneShared_f7981739:

    # MARKUS @ angry "That a threat?"
    MARKUS @ angry "Eine Drohung?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:104
translate de qst_TheBeastOfNovaras_BarSceneShared_126ffe60:

    # SYPHA @ happy "No. A certainty you haven't earned yet."
    SYPHA @ happy "Nein. Eine Gewissheit, die du dir noch nicht verdient hast."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:107
translate de qst_TheBeastOfNovaras_BarSceneShared_6712b7b4:

    # "I glanced around the tavern and saw no alarm nor heard no whispers."
    "Ich blickte in der Taverne umher und sah weder Besorgnis noch vernahm ich Geflüster."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:108
translate de qst_TheBeastOfNovaras_BarSceneShared_db7dc0f2:

    # "To them, Sypha was nothing more than another foreigner, perhaps a dark elf in fine dress."
    "Für sie war Sypha nichts weiter als eine weitere Ausländerin, vielleicht eine Dunkelelfe in feiner Kleidung."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:109
translate de qst_TheBeastOfNovaras_BarSceneShared_03a7646f:

    # "Only those who had glimpsed true Demorai horrors could see the shadow beneath her smile."
    "Nur diejenigen, die einen flüchtigen Blick auf die wahren Schrecken der Demorai erhascht hatten, konnten den Schatten unter ihrem Lächeln sehen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:112
translate de qst_TheBeastOfNovaras_BarSceneShared_83ddba9d:

    # "Beside her loomed a silent man in gold-trimmed robes, a sigil of quilt and coin stitched at his shoulder."
    "Neben ihr ragte ein schweigsamer Mann in goldverzierten Roben auf, ein Wappen aus Steppdecke und Münze auf seine Schulter gestickt."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:113
translate de qst_TheBeastOfNovaras_BarSceneShared_05a35ac3:

    # "His silence spoke of power born from ink, not steel."
    "Seine Stille sprach von Macht, die aus Tinte geboren war, nicht aus Stahl."

