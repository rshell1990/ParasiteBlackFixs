    new "Ich weiß nicht ... Ich könnte durchaus genießen, sie ein paar Stunden lang anzuschauen."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:63
    old "Would you both knock it off?"
    new "Würdet ihr beide damit aufhören?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:186
    old "What business does the Greater Trading Company have in Alderay? Weren't you cast out?"
    new "Was hat die Greater Trading Company in Alderay zu suchen? Wurdet ihr nicht verstoßen?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:198
    old "I have an orc companion... {i}Is this going to be a problem?{/i}"
    new "Ich habe einen Ork-Gefährten... {i}Wird das ein Problem werden?{/i}"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:219
    old "What do you want... Garen Quiltshire?"
    new "Was willst du... Garen Quiltshire?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:278
    old "And if we refuse?"
    new "Und wenn wir uns weigern?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:322
    old "Who are these merchants?"
    new "Wer sind diese Händler?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:533
    old "I'm ready..."
    new "Ich bin bereit..."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:539
    old "I'm not ready yet."
    new "Ich bin noch nicht bereit."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:546
