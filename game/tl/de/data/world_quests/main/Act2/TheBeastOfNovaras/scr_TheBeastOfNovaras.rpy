# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1710
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_d34a606a:

    # SYPHA @ angry "{i}Need I remind you we are at war?{/i}"
    SYPHA @ angry "{i}Muss ich dich daran erinnern, dass wir im Krieg sind?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1711
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_c710af10:

    # SYPHA @ angry "Make no mistake, this alliance of ours is for convenience and nothing more... {i}'husband.'{/i}"
    SYPHA @ angry "Täusch dich nicht, dieses Bündnis von uns ist aus Zweckmäßigkeit und sonst nichts... {i}'Ehemann.'{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1712
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_7c9fd58a:

    # "Sypha made her way towards the door."
    "Sypha machte sich auf den Weg zur Tür."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1713
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_d9f014da:

    # MC @ angry "So what, you just expect me to play along and stay in the dark while you move pawns from the shadows?"
    MC @ angry "Also was, du erwartest einfach, dass ich mitspiele und im Dunkeln bleibe, während du Bauern aus dem Schatten bewegst?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1714
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_3cecdb0b:

    # "Her hand lingered on the doorframe, just long enough for me to notice the tremor in her fingers. When she spoke, her voice was velvet and steel at once."
    "Ihre Hand verweilte am Türrahmen, gerade lange genug, dass ich das Zittern ihrer Finger bemerkte. Als sie sprach, war ihre Stimme zugleich Samt und Stahl."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1715
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_015d4d4d:

    # SYPHA @ happy "{i}... Thank you for saving my life the other day.{/i}"
    SYPHA @ happy "{i}... Danke, dass du mir neulich das Leben gerettet hast.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1716
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_6f088407:

    # SYPHA @ angry "Now please."
    SYPHA @ angry "Jetzt bitte."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1717
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_380e0a9b:

    # SYPHA @ angry "{i}Trust me, and let me fucking save yours.{/i}"
    SYPHA @ angry "{i}Vertrau mir und lass mich verdammt noch mal deines retten.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1721
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_bd8058e8:

    # "With a loud thud, Sypha slammed the door shut."
    "Mit einem lauten Knall schlug Sypha die Tür zu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1725
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_f8487f08:

    # SHYAHTAN "... A fine mate she shall make."
    SHYAHTAN "... Eine feine Gefährtin wird sie abgeben."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1732
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_eebd995f:

    # SHYAHTAN "I {i}was{/i} different."
    SHYAHTAN "Ich {i}war{/i} anders."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1733
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_e1dce769:

    # SHYAHTAN "I saw banners burning beneath twin suns. Screams. Concubines without faces. A child's hand reaching... then nothing."
    SHYAHTAN "Ich sah Banner unter zwei Sonnen brennen. Schreie. Konkubinen ohne Gesichter. Eine Kinderhand, die sich ausstreckte ... dann nichts."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1734
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_02828b98:

    # SHYAHTAN "Fragments. Nothing whole."
    SHYAHTAN "Fragmente. Nichts Ganzes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1738
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_21c07cf7:

    # SHYAHTAN "Flashes. Wars on nameless worlds."
    SHYAHTAN "Blitze. Kriege auf namenlosen Welten."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1739
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_33a7dc7e:

    # SHYAHTAN "Blood rivers, screams in alien tongues."
    SHYAHTAN "Blutflüsse, Schreie in fremden Zungen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1740
translate de qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_5b5f717f:

    # SHYAHTAN "I do not like these feelings. They are heavy... illogical. Painful."
    SHYAHTAN "Ich mag diese Gefühle nicht. Sie sind schwer... unlogisch. Schmerzhaft."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1744
