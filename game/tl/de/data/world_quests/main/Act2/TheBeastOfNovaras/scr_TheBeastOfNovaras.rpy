    YARRICK @ smile "Ich höre, es gibt sogar ein neues Bardenlied über den großen Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1797
translate de qst_TheBeastOfNovaras_ReturnToYarrickAfterCaltrack_bfcf74f4:

    # MC @ sad "R-Right..."
    MC @ sad "R-Richtig..."

