    new "Hamun-Arena, Blutwerk"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:575
    old "Did your mother not like you, giving you a name like that?"
    new "Hat deine Mutter dich nicht gemocht, dass sie dir so einen Namen gegeben hat?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:578
    old "Anyone who has to call themselves 'savage' couldn't fight his way out of a tavern brawl."
    new "Jeder, der sich 'wild' nennen muss, könnte sich nicht aus einer Wirtshausschlägerei herauskämpfen."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:580
    old "..."
    new "..."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:631
    old "Hamun arena"
    new "Hamun-Arena"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:817
    old "Parasite Ship Main Deck"
    new "Hauptdeck des Parasitenschiffs"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:891
    old "Merlanian city"
    new "Merlanische Stadt"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:985
    old "Merlanian temple"
    new "Merlanischer Tempel"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1085
    old "Parasite Ship, private quarters"
    new "Parasitenschiff, Privatquartiere"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1185
    old "Parasite Ship, great chamber"
    new "Parasitenschiff, große Kammer"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1339
    old "Home?"
    new "Zuhause?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1390
    old "I... Maybe?"
    new "Ich... Vielleicht?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1474
    old "There's no time for that, I want answers!"
    new "Dafür ist keine Zeit, ich will Antworten!"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1486
    old "Where are you?"
    new "Wo bist du?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1492
    old "How is everyone?"
    new "Wie geht es allen?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1523
    old "What's happened since the battle?"
    new "Was ist seit der Schlacht passiert?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1617
    old "How did I end up here?"
    new "Wie bin ich hier gelandet?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1623
    old "How long was I out?"
    new "Wie lange war ich bewusstlos?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1629
    old "How many are dead?"
    new "Wie viele sind tot?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1639
    old "What... What exactly happened?"
    new "Was ... Was genau ist passiert?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1730
    old "You seemed so... {i}different{/i} in the memory."
    new "Du wirkst so ... {i}anders{/i} in der Erinnerung."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1736
    old "Do you remember anything else other than what we saw?"
    new "Erinnerst du dich an irgendetwas anderes außer dem, was wir gesehen haben?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1742
    old "Do you remember much of your people?"
    new "Erinnerst du dich an viel von deinem Volk?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1747
    old "Where are your people now? How did you end up... here?"
    new "Wo ist dein Volk jetzt? Wie bist du ... hier gelandet?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1753
    old "That... Terran at the end of the dream... {i}didn't it kind of look like Markus?{/i}"
    new "Dieser ... Terraner am Ende des Traums ... {i}sah er nicht irgendwie aus wie Markus?{/i}"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1805
    old "Did you not get in trouble for what happened with the Caltrack?"
    new "Hast du keine Schwierigkeiten bekommen für das, was mit dem Caltrack passiert ist?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1814
    old "I lived up to my end of the deal, now it's time for you to fulfill yours."
    new "Ich habe meinen Teil der Abmachung erfüllt, jetzt ist es an der Zeit, dass du deinen erfüllst."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1931
    old "The deal will pass anyway, will it not?"
    new "Der Deal wird so oder so durchgehen, oder?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1935
    old "You seem to hate them."
    new "Du scheinst sie zu hassen."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1941
    old "Then what would it take to persuade you?"
    new "Was würde es dann brauchen, um dich zu überzeugen?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1964
    old "Lord Zanzibat has an offer he wishes to put forward with regards to the deal..."
    new "Lord Zanzibat hat ein Angebot, das er in Bezug auf den Deal unterbreiten möchte..."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1981
    old "Go ahead."
    new "Nur zu."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1995
    old "I'm afraid I have other business to tend to."
    new "Ich fürchte, ich muss mich um andere Angelegenheiten kümmern."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2072
    old "When do you plan to live up to your end of the deal and actually give me some answers?"
    new "Wann planst du, deinen Teil der Abmachung zu erfüllen und mir tatsächlich einige Antworten zu geben?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2112
    old "Half of the jewels in this are sub-par quality, it's worth five-hundred at the most."
    new "Die Hälfte der Juwelen hier sind von minderer Qualität, es ist höchstens fünfhundert wert."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2126
    old "How about seven-fifty? My... {i}'fiancee'{/i} and I don't have much coin."
    new "Wie wär's mit siebenhundertfünfzig? Meine... {i}'Verlobte'{/i} und ich haben nicht viele Münzen."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2136
    old "I don't have that kind of coin, Sypha."
    new "So viele Münzen habe ich nicht, Sypha."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2159
    old "You do know I have to agree to something like that, right?"
    new "Du weißt schon, dass ich so etwas zustimmen muss, oder?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2170
    old "I don't think you fully know what a 'husband' and 'wife' actually is..."
    new "Ich glaube nicht, dass du wirklich weißt, was ein 'Ehemann' und eine 'Ehefrau' eigentlich sind..."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2186
    old "What do you {i}really{/i} want, Sypha?"
    new "Was willst du {i}wirklich{/i}, Sypha?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2277
    old "Bathhouse, private room"
    new "Badehaus, Privatzimmer"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2330
    old "Yes, if the Demorai were actually willing to talk..."
    new "Ja, wenn die Demorai tatsächlich bereit wären zu reden..."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2336
    old "No... They are invaders."
    new "Nein... Sie sind Eindringlinge."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2341
    old "I don't know."
    new "Ich weiß es nicht."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2346
    old "Where did your people come from?"
    new "Woher kommt dein Volk?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2356
    old "Why do all the Demorai look so... different?"
    new "Warum sehen alle Demorai so... anders aus?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2364
    old "What do your people want?"
    new "Was will dein Volk?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2375
    old "I would crush all dissent, including those still loyal to Alcott."
    new "Ich würde jeglichen Widerstand zerschlagen, einschließlich derer, die Alcott noch treu sind."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2381
    old "I would focus on unity, bringing together the fractured kingdoms."
    new "Ich würde mich auf Einheit konzentrieren und die zersplitterten Königreiche zusammenbringen."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2386
    old "I would focus more on reform and economics... Things cannot improve till the rot on the inside is removed"
    new "Ich würde mich mehr auf Reformen und die Wirtschaft konzentrieren... Die Dinge können sich nicht verbessern, bis die Fäulnis im Inneren beseitigt ist."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2394
    old "Who was that man in the cave?"
    new "Wer war dieser Mann in der Höhle?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2401
    old "Who is Zanarak to the Demorai?"
    new "Wer ist Zanarak für die Demorai?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2410
    old "What are your people like?"
    new "Wie sind deine Leute?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2443
    old "{image=[ICON.HEART]} Kiss her."
    new "{image=[ICON.HEART]} Küsse sie."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2517
    old "Reject her"
    new "Weise sie zurück."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2571
    old "Very well."
    new "In Ordnung."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2584
    old "I'm too drunk and too tired... It'll have to wait till the morning."
    new "Ich bin zu betrunken und zu müde... Das muss bis morgen warten."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2623
    old "Refuse."
    new "Ablehnen."

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2745
    old "Is this kind of thing... Normal for Demorai?"
    new "Ist so etwas... normal für Demorai?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2750
    old "Did you really mean what you said about killing someone?"
    new "Hast du das mit dem Töten von jemandem wirklich ernst gemeint?"

    # game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2757
    old "Is this really what your people call love and romance?"
    new "Ist das wirklich das, was deine Leute Liebe und Romantik nennen?"

