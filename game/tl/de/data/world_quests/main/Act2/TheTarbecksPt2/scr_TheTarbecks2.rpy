# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:557
translate de qst_TheTarbecks2_tea_party2_f342f3a0:

    # LADY_TARBECK @ happy "But as you know, it could be quite the scandal for you to attend my home given my husband's eccentric reputation."
    LADY_TARBECK @ happy "Aber wie Sie wissen, könnte es ein ziemlicher Skandal sein, wenn Sie mein Haus besuchen, angesichts des exzentrischen Rufs meines Mannes."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:558
translate de qst_TheTarbecks2_tea_party2_204eeb3d:

    # "A small crack appeared on Lady Belamore's face, her words now carefully crafted."
    "Ein kleiner Riss zeigte sich auf Lady Belamores Gesicht, ihre Worte nun sorgfältig gewählt."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:559
