# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:5
translate de qst_TheTarbecks2_enter_manor_db0d0daf:

    # GUARD "Ah, Lady Tarbeck said to escort you straight to her upon arrival."
    GUARD "Ah, Lady Tarbeck sagte, Sie direkt nach Ihrer Ankunft zu ihr zu bringen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:6
translate de qst_TheTarbecks2_enter_manor_349cc5c0:

    # GUARD "Please, come with me."
    GUARD "Bitte, kommen Sie mit mir."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:12
translate de qst_TheTarbecks2_enter_manor_481fbd81:

    # "Following the guard, he led me towards the dining room where Lady Tarbeck sat, carefully sipping at her tea."
    "Der Wache folgend, führte er mich zum Esszimmer, wo Lady Tarbeck saß und sorgfältig an ihrem Tee nippte."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:14
translate de qst_TheTarbecks2_enter_manor_fc103b1a:

    # "Her eyes slowly lifted towards me with distant displeasure."
    "Ihre Augen hoben sich langsam mit entferntem Missfallen zu mir."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:15
translate de qst_TheTarbecks2_enter_manor_c393822e:

    # LADY_TARBECK @ think "Thank you for coming."
    LADY_TARBECK @ think "Danke, dass Sie gekommen sind."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:16
translate de qst_TheTarbecks2_enter_manor_fce49781:

    # LADY_TARBECK @ angry "Now that you're here, I want to make one thing clear..."
    LADY_TARBECK @ angry "Jetzt, wo Sie hier sind, möchte ich eines klarstellen..."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:17
translate de qst_TheTarbecks2_enter_manor_13abf134:

    # LADY_TARBECK @ angry "{i}I have no need of you, nor do I have any interest in my husband's perverted games.{/i}"
    LADY_TARBECK @ angry "{i}Ich habe keinen Bedarf an Ihnen, noch habe ich irgendein Interesse an den perversen Spielen meines Mannes.{/i}"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:18
translate de qst_TheTarbecks2_enter_manor_9e811334:

    # LADY_TARBECK @ angry "And I CERTAINLY have no interest in helping those ghoulish GTC monsters."
    LADY_TARBECK @ angry "Und ich habe GANZ SICHER kein Interesse daran, diesen scheußlichen GTC-Monstern zu helfen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:19
translate de qst_TheTarbecks2_enter_manor_00a57388:

    # LADY_TARBECK @ happy "So, I'm afraid you're just wasting your time here."
    LADY_TARBECK @ happy "Also, ich fürchte, Sie verschwenden hier nur Ihre Zeit."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:20
translate de qst_TheTarbecks2_enter_manor_db3b6296:

    # SHYAHTAN "(Slow... Go slow for this one.)"
    SHYAHTAN "(Langsam... Gehen Sie bei diesem hier langsam vor.)"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:21
translate de qst_TheTarbecks2_enter_manor_842a0196:

    # MC @ talk "... Very well."
    MC @ talk "... Nun gut."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:22
translate de qst_TheTarbecks2_enter_manor_6cbfaf09:

    # MC @ smile "Then at least allow me to walk with you and guard you for the day."
    MC @ smile "Dann erlaubt mir wenigstens, mit Euch zu gehen und Euch für den Tag zu beschützen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:23
translate de qst_TheTarbecks2_enter_manor_8d946ca7:

    # LADY_TARBECK @ think "Didn't you just hear what I said?"
    LADY_TARBECK @ think "Habt Ihr nicht gerade gehört, was ich gesagt habe?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:24
translate de qst_TheTarbecks2_enter_manor_6119f1bd:

    # LADY_TARBECK @ angry "I have no interest in these games!"
    LADY_TARBECK @ angry "Ich habe kein Interesse an diesen Spielen!"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:25
translate de qst_TheTarbecks2_enter_manor_6ce06e3a:

    # MC @ talk "Be it so, my lady, your husband won't be pleased should we do nothing."
    MC @ talk "Sei's drum, meine Dame, Euer Gemahl wird nicht erfreut sein, sollten wir nichts tun."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:26
translate de qst_TheTarbecks2_enter_manor_f88170b4:

    # MC @ smile "So what is the harm in letting me walk with you?"
    MC @ smile "Was schadet es also, mich mit Euch gehen zu lassen?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:27
translate de qst_TheTarbecks2_enter_manor_de2b975a:

    # MC @ talk "It's not like Hamun isn't a dangerous place..."
    MC @ talk "Es ist ja nicht so, als wäre Hamun kein gefährlicher Ort..."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:28
translate de qst_TheTarbecks2_enter_manor_b80e2687:

    # MC @ smile "Is it truly so terrible to have the savior of Novaras as your guard for the day?"
    MC @ smile "Ist es wirklich so schrecklich, den Retter von Novaras für den Tag als Eure Wache zu haben?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:29
translate de qst_TheTarbecks2_enter_manor_67689c8d:

    # LADY_TARBECK "Funny... I hear people still call you the beast of Novaras."
    LADY_TARBECK "Lustig... Ich höre, die Leute nennen Euch immer noch die Bestie von Novaras."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:30
translate de qst_TheTarbecks2_enter_manor_33e402dd:

    # LADY_TARBECK "So which is it? Are you a noble man, or just a beast?"
    LADY_TARBECK "Was also ist es? Seid Ihr ein edler Mann oder nur eine Bestie?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:33
translate de qst_TheTarbecks2_enter_manor_b3c29779:

    # LADY_TARBECK @ sad "How... Unreassuring."
    LADY_TARBECK @ sad "Wie... wenig beruhigend."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:35
translate de qst_TheTarbecks2_enter_manor_7e622f10:

    # LADY_TARBECK @ angry "Many a man has said something similar to justify the terrible things he's done."
    LADY_TARBECK @ angry "Schon mancher Mann hat etwas Ähnliches gesagt, um die schrecklichen Dinge zu rechtfertigen, die er getan hat."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:37
translate de qst_TheTarbecks2_enter_manor_04a88133:

    # LADY_TARBECK @ think "And you're content with that?"
    LADY_TARBECK @ think "Und damit gibst du dich zufrieden?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:38
translate de qst_TheTarbecks2_enter_manor_3a02a8f2:

    # LADY_TARBECK @ sad "How... Sad."
    LADY_TARBECK @ sad "Wie... traurig."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:39
translate de qst_TheTarbecks2_enter_manor_2b8107ad:

    # MC @ talk "Well... What will it be, my lady?"
    MC @ talk "Nun... Was soll es sein, meine Dame?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:40
translate de qst_TheTarbecks2_enter_manor_0ecc95c4:

    # "Lady Tarbeck paused for a long moment before sighing."
    "Lady Tarbeck hielt einen langen Moment inne, bevor sie seufzte."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:41
translate de qst_TheTarbecks2_enter_manor_c84a19ee:

    # LADY_TARBECK @ talk "Fine..."
    LADY_TARBECK @ talk "Na schön..."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:42
translate de qst_TheTarbecks2_enter_manor_62f4d186:

    # LADY_TARBECK @ angry "But you ask nothing of me and expect nothing for this."
    LADY_TARBECK @ angry "Aber du verlangst nichts von mir und erwartest nichts dafür."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:43
translate de qst_TheTarbecks2_enter_manor_1a666479:

    # LADY_TARBECK @ angry "I do this only to appease my husband so he might relent."
    LADY_TARBECK @ angry "Ich tue dies nur, um meinen Mann zu besänftigen, damit er vielleicht nachgibt."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:44
translate de qst_TheTarbecks2_enter_manor_847e9558:

    # LADY_TARBECK @ talk "And hopefully this foolishness of his can end and we can all go back to being just miserable again."
    LADY_TARBECK @ talk "Und hoffentlich hat dieser Unsinn von ihm ein Ende und wir können alle wieder einfach nur miserabel sein."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:45
translate de qst_TheTarbecks2_enter_manor_f93acea7:

    # MC @ talk "... Did you have anywhere you wished to go today, my lady?"
    MC @ talk "… Hatten Sie heute irgendwohin gehen wollen, Mylady?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:46
translate de qst_TheTarbecks2_enter_manor_a407e266:

    # LADY_TARBECK @ talk "Hmph."
    LADY_TARBECK @ talk "Hmpf."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:47
translate de qst_TheTarbecks2_enter_manor_fa36d093:

    # LADY_TARBECK @ angry "No talking. Just follow."
    LADY_TARBECK @ angry "Kein Reden. Folgt einfach."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:49
translate de qst_TheTarbecks2_enter_manor_40b4a315:

    # "As Lady Tarbeck stormed her way past me, I shadowed behind her..."
    "Als Lady Tarbeck an mir vorbeistürmte, schlich ich ihr hinterher …"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:51
translate de qst_TheTarbecks2_enter_manor_2c13a07f:

    # MC "(This needs to work, you know.)"
    MC "(Das muss klappen, weißt du.)"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:52
translate de qst_TheTarbecks2_enter_manor_aa1d7b31:

    # SHYAHTAN "(It will.)"
    SHYAHTAN "(Wird es.)"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:58
translate de qst_TheTarbecks2_enter_manor_79728c74:

    # "... Following Lady Tarbeck's lead, I watched as she turned down towards the city markets."
    "… Lady Tarbecks Führung folgend, beobachtete ich, wie sie in die Straße zu den Stadtmärkten einbog."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:60
translate de qst_TheTarbecks2_enter_manor_c3521b26:

    # "Behind us, always shadowing in the distance, at least three to four guards."
    "Hinter uns, stets in der Ferne wie Schatten, mindestens drei bis vier Wachen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:61
translate de qst_TheTarbecks2_enter_manor_50be7b0b:

    # "And those were just the ones I could see."
    "Und das waren nur die, die ich sehen konnte."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:66
translate de qst_TheTarbecks2_enter_manor_c10c881a:

    # "Carefully I watched as Lady Tarbeck explored around the different market stalls."
    "Aufmerksam beobachtete ich, wie Lady Tarbeck die verschiedenen Marktstände erkundete."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:67
translate de qst_TheTarbecks2_enter_manor_8f73a92d:

    # MC @ think "I must admit, my lady, this doesn't quite seem like the place for a lady of your station."
    MC @ think "Ich muss zugeben, meine Dame, dies scheint nicht ganz der richtige Ort für eine Dame Ihres Standes zu sein."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:68
translate de qst_TheTarbecks2_enter_manor_d12b1466:

    # LADY_TARBECK @ talk "I'm a merchant lord's wife, I'd be laughed out of true noble circles, make no mistake."
    LADY_TARBECK @ talk "Ich bin die Frau eines Handelsherrn, aus den wahren Adelskreisen würde man mich auslachen, da können Sie sicher sein."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:69
translate de qst_TheTarbecks2_enter_manor_cc37fb0d:

    # MC @ talk "But here-"
    MC @ talk "Aber hier-"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:71
translate de qst_TheTarbecks2_enter_manor_e2122402:

    # LADY_TARBECK @ angry "Your job isn't to speak."
    LADY_TARBECK @ angry "Ihre Aufgabe ist es nicht zu sprechen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:73
translate de qst_TheTarbecks2_enter_manor_599d8a10:

    # LADY_TARBECK @ talk "It's to follow and protect me... silently."
    LADY_TARBECK @ talk "Denn Sie sollen mir folgen und mich beschützen... still."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:75
translate de qst_TheTarbecks2_enter_manor_c7714909:

    # "I pulled back, allowing Lady Tarbeck to inspect some jewelled trinkets which she bartered softly over."
    "Ich trat zurück und erlaubte Lady Tarbeck, einige juwelenbesetzte Schmuckstücke zu inspizieren, um die sie leise feilschte."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:76
translate de qst_TheTarbecks2_enter_manor_9ef0ed63:

    # "Handing over a pouch of coins for a small, almost gimmicky wrist piece, she smiled at it before turning her soft gaze towards me and sighing."
    "Sie übergab ein Münzsäckchen für ein kleines, fast kitschiges Armstück, lächelte es an, bevor sie ihren sanften Blick zu mir wandte und seufzte."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:78
translate de qst_TheTarbecks2_enter_manor_f6c28dbf:

    # LADY_TARBECK @ think "I am done here, come."
    LADY_TARBECK @ think "Ich bin hier fertig, kommen Sie."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:81
translate de qst_TheTarbecks2_enter_manor_42b79bb8:

    # "As the lady wandered off in another direction, I couldn't help but roll my eyes."
    "Während die Dame in eine andere Richtung davonschlenderte, konnte ich nicht anders, als die Augen zu verdrehen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:83
translate de qst_TheTarbecks2_enter_manor_6d326a9d:

    # MC "(Am I even going to {i}want{/i} to fuck her at the end of this?)"
    MC "(Werde ich sie am Ende des Ganzen überhaupt {i}ficken wollen{/i}?)"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:87
translate de qst_TheTarbecks2_enter_manor_83e1a223:

    # "The next hour was spent within the libraries of Hamun, as Lady Tarbeck traced her fingers along the books."
    "Die nächste Stunde verbrachten wir in den Bibliotheken von Hamun, während Lady Tarbeck mit ihren Fingern über die Bücher strich."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:88
translate de qst_TheTarbecks2_enter_manor_b7a2dd24:

    # "Occasionally, she would pull one out to read a few pages before carefully putting it back."
    "Gelegentlich zog sie eines heraus, um ein paar Seiten zu lesen, bevor sie es vorsichtig zurückstellte."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:93
translate de qst_TheTarbecks2_enter_manor_85098d37:

    # MC @ think "... Do you come here to read often, my lady?"
    MC @ think "... Kommt Ihr oft hierher, um zu lesen, meine Dame?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:94
translate de qst_TheTarbecks2_enter_manor_340461e1:

    # LADY_TARBECK @ think "I thought we were walking in silence?"
    LADY_TARBECK @ think "Ich dachte, wir gehen schweigend?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:95
translate de qst_TheTarbecks2_enter_manor_859d0af0:

    # MC @ talk "Well first you might actually want to find a book you like before we drag out the silence."
    MC @ talk "Nun, zuerst solltet Ihr vielleicht tatsächlich ein Buch finden, das Euch gefällt, bevor wir die Stille in die Länge ziehen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:96
translate de qst_TheTarbecks2_enter_manor_9aa8d5db:

    # LADY_TARBECK @ angry "And you're going to recommend me my next read?"
    LADY_TARBECK @ angry "Und Ihr werdet mir meine nächste Lektüre empfehlen?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:97
translate de qst_TheTarbecks2_enter_manor_a3f448cf:

    # "She folded her arms, her brow creasing."
    "Sie verschränkte die Arme, ihre Stirn legte sich in Falten."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:98
translate de qst_TheTarbecks2_enter_manor_5fb6b12c:

    # LADY_TARBECK @ angry "As you refuse to shut up, let's hear it then."
    LADY_TARBECK @ angry "Da Ihr Euch weigert, den Mund zu halten, dann lasst hören."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:101
translate de qst_TheTarbecks2_enter_manor_ba86ccff:

    # LADY_TARBECK @ angry "Macabre."
    LADY_TARBECK @ angry "Makaber."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:102
translate de qst_TheTarbecks2_enter_manor_81b7be15:

    # LADY_TARBECK @ think "Something for teenage girls to swoon over."
    LADY_TARBECK @ think "Etwas für junge Mädchen zum Schwärmen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:103
translate de qst_TheTarbecks2_enter_manor_631d7823:

    # LADY_TARBECK @ think "No respectable woman would be interested in such a beast."
    LADY_TARBECK @ think "Keine anständige Frau würde sich für so ein Biest interessieren."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:105
translate de qst_TheTarbecks2_enter_manor_eda52db6:

    # LADY_TARBECK @ think "Boring."
    LADY_TARBECK @ think "Langweilig."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:106
translate de qst_TheTarbecks2_enter_manor_61c855ed:

    # MC @ surprised "It's a classic!"
    MC @ surprised "Es ist ein Klassiker!"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:107
translate de qst_TheTarbecks2_enter_manor_7de0a37d:

    # LADY_TARBECK @ think "Yes, and it was all the rage... Ten years ago."
    LADY_TARBECK @ think "Ja, und es war der letzte Schrei... vor zehn Jahren."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:108
translate de qst_TheTarbecks2_enter_manor_55e59348:

    # LADY_TARBECK @ think "I and every other woman who can afford to have already read it."
    LADY_TARBECK @ think "Ich und jede andere Frau, die es sich leisten kann, haben es bereits gelesen."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:110
translate de qst_TheTarbecks2_enter_manor_7ead8010:

    # LADY_TARBECK @ sad "Crass... Very, very crass."
    LADY_TARBECK @ sad "Plump... Sehr, sehr plump."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:111
translate de qst_TheTarbecks2_enter_manor_2bc325e7:

    # LADY_TARBECK @ sad "Besides, my husband is already on volume eight."
    LADY_TARBECK @ sad "Außerdem ist mein Mann schon bei Band acht."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:114
translate de qst_TheTarbecks2_enter_manor_739083b5:

    # "Rubbing her brow, once more Lady Tarbeck let out another sigh."
    "Sich über die Stirn reibend, seufzte Lady Tarbeck erneut."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:115
translate de qst_TheTarbecks2_enter_manor_b8dd344b:

    # LADY_TARBECK @ sad "This isn't going to work."
