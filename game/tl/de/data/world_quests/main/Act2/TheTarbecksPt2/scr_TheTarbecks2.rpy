translate de qst_TheTarbecks2_enter_manor_7dbb0263:

    # LADY_NARISHA @ sad "Does it get lonely being an adventurer?"
    LADY_NARISHA @ sad "Wird es einsam, ein Abenteurer zu sein?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:297
