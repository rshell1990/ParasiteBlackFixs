translate de qst_TheDarkPass_ObelisksRoomCheckObelisks_635c96ff:

    # ALCOTT "Good. I will leave you to rest now."
    ALCOTT "Gut. Ich lasse euch jetzt ruhen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1598
translate de qst_TheDarkPass_ObelisksRoomCheckObelisks_1a378d60:

