translate de qst_TheDarkPass_CampTalkDuprey_5adf567d:

    # MC "Fine I think, sir."
    MC "Gut, denke ich, Sir."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:362
translate de qst_TheDarkPass_CampTalkDuprey_b05e07d5:

    # DUPREY "Good, good..."
    DUPREY "Gut, gut..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:363
translate de qst_TheDarkPass_CampTalkDuprey_d7ab3938:

    # MC "... Could I ask you about a couple things, sir?"
    MC "... Könnte ich Sie ein paar Dinge fragen, Sir?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:364
translate de qst_TheDarkPass_CampTalkDuprey_0c3978ea:

    # DUPREY "Hm?"
    DUPREY "Hm?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:365
translate de qst_TheDarkPass_CampTalkDuprey_d0300c61:

    # MC "If you don’t mind..."
    MC "Wenn es Ihnen nichts ausmacht..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:366
translate de qst_TheDarkPass_CampTalkDuprey_13a1b492:

    # DUPREY "Aye, feel free."
    DUPREY "Ja, nur zu."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:374
translate de qst_TheDarkPass_CampTalkDuprey_menu_7bb579f6:

    # DUPREY "Lost count a long time ago."
    DUPREY "Habe vor langer Zeit aufgehört zu zählen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:375
translate de qst_TheDarkPass_CampTalkDuprey_menu_6c8a02b9:

    # DUPREY "I’ve been here since the beginning..."
    DUPREY "Ich bin von Anfang an hier..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:376
translate de qst_TheDarkPass_CampTalkDuprey_menu_dcc31424:

    # MC "You mean—"
    MC "Sie meinen—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:377
translate de qst_TheDarkPass_CampTalkDuprey_menu_c9e369aa:

    # DUPREY "When it all first started, we never took it seriously, far more concerned with the threat of Kalliban O’Nok and his army of orcs crossing the seas to invade..."
    DUPREY "Als alles anfing, nahmen wir es nie ernst, waren viel mehr besorgt über die Bedrohung durch Kalliban O’Nok und seine Orkarmee, die die Meere überqueren, um einzufallen..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:378
translate de qst_TheDarkPass_CampTalkDuprey_menu_d579e16c:

    # MC "{i}The winter of 1149.{/i}"
    MC "{i}Der Winter 1149.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:379
translate de qst_TheDarkPass_CampTalkDuprey_menu_9b165412:

    # DUPREY "Alright, clever clogs. That’s what they called it, aye."
    DUPREY "In Ordnung, Klugscheißer. So haben sie es genannt, ja."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:380
translate de qst_TheDarkPass_CampTalkDuprey_menu_2d277bc7:

    # DUPREY "Villagers talked about {i}‘ghosts in the night’{/i} snatching people up... We figured it was just bandits."
    DUPREY "Die Dorfbewohner sprachen von {i}„Geistern der Nacht“{/i}, die Leute entführten ... Wir dachten, es seien nur Banditen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:381
translate de qst_TheDarkPass_CampTalkDuprey_menu_4792dca5:

    # DUPREY "More ‘n’ more had been spotted what with all the famine; we were preoccupied with the kind of threats we could understand."
    DUPREY "Immer mehr waren wegen der ganzen Hungersnot gesichtet worden; wir waren mit den Arten von Bedrohungen beschäftigt, die wir verstehen konnten."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:382
translate de qst_TheDarkPass_CampTalkDuprey_menu_8ba9597e:

    # MC "I know this part! After they found more and more bloody scenes, The High Lords and King Mesamor finally relented and got the High Mages and Inquisitors to investigate."
    MC "Ich kenne diesen Teil! Nachdem sie immer mehr blutige Szenen fanden, gaben die Hohen Lords und König Mesamor endlich nach und ließen die Hohen Magier und Inquisitoren ermitteln."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:383
translate de qst_TheDarkPass_CampTalkDuprey_menu_f269264d:

    # "Captain Duprey raised a curious eyebrow."
    "Captain Duprey zog eine neugierige Augenbraue hoch."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:384
translate de qst_TheDarkPass_CampTalkDuprey_menu_ecde942b:

    # DUPREY @ think "Hmm... How’d you know all that? Most don’t know the full story."
    DUPREY @ think "Hmm ... Woher weißt du das alles? Die meisten kennen nicht die ganze Geschichte."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:385
translate de qst_TheDarkPass_CampTalkDuprey_menu_1cc6d473:

    # MC "I studied it."
    MC "Ich habe es studiert."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:386
translate de qst_TheDarkPass_CampTalkDuprey_menu_b77999dc:

    # DUPREY @ laugh "Ha! How very wise of you..."
    DUPREY @ laugh "Ha! Wie weise von dir ..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:387
translate de qst_TheDarkPass_CampTalkDuprey_menu_c8488904:

    # DUPREY "Always good to know how you got to where you’re at but I’m afraid there aren’t many more lessons to learn from it that’d be useful."
    DUPREY "Es ist immer gut zu wissen, wie man dorthin gekommen ist, wo man ist, aber ich fürchte, es gibt nicht viele weitere nützliche Lektionen, die man daraus lernen kann."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:388
translate de qst_TheDarkPass_CampTalkDuprey_menu_424524d9:

    # DUPREY "We underestimated the enemy, and we still thought at the time it was all some grand scheme from Kalliban. We overestimated him."
    DUPREY "Wir haben den Feind unterschätzt, und damals dachten wir noch, es sei alles ein großer Plan von Kalliban. Wir haben ihn überschätzt."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:389
translate de qst_TheDarkPass_CampTalkDuprey_menu_04cc0520:

    # DUPREY "We were ordered to defend the neighbouring villages and towns when we should have had the army brought in and amassed an all-out assault, they’d caught us on the backfoot. We were still naive then."
    DUPREY "Uns wurde befohlen, die benachbarten Dörfer und Städte zu verteidigen, als wir die Armee hätten einberufen und einen umfassenden Angriff starten sollen, sie haben uns auf dem falschen Fuß erwischt. Wir waren damals noch naiv."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:390
translate de qst_TheDarkPass_CampTalkDuprey_menu_52865a48:

    # "Captain Duprey took another sip of his drink, he seemed lost in his memories."
    "Captain Duprey nahm einen weiteren Schluck von seinem Getränk, er schien in seinen Erinnerungen verloren zu sein."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:391
translate de qst_TheDarkPass_CampTalkDuprey_menu_9841065b:

    # DUPREY "We paid the price for those mistakes at Meadow Plains."
    DUPREY "Wir bezahlten den Preis für diese Fehler bei Meadow Plains."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:392
translate de qst_TheDarkPass_CampTalkDuprey_menu_1d6c3970:

    # MC "{i}You{/i} were at The Battle of Meadow Plains?"
    MC "{i}Du{/i} warst bei der Schlacht von Meadow Plains?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:393
translate de qst_TheDarkPass_CampTalkDuprey_menu_a7267a8b:

    # DUPREY "That I was."
    DUPREY "Das war ich."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:394
translate de qst_TheDarkPass_CampTalkDuprey_menu_3e8e0a2d:

    # DUPREY "I remember the bloodshed in the streets from the towns that had been annihilated."
    DUPREY "Ich erinnere mich an das Blutvergießen in den Straßen der vernichteten Städte."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:395
translate de qst_TheDarkPass_CampTalkDuprey_menu_22d390e2:

    # DUPREY "Every corner you turned around had death waiting for you on the other side."
    DUPREY "An jeder Ecke, um die man bog, wartete der Tod auf der anderen Seite."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:396
translate de qst_TheDarkPass_CampTalkDuprey_menu_36fdb802:

    # DUPREY "And there was the mad rush of thousands fleeing to Novaras to hide behind its walls."
    DUPREY "Und da war der wahnsinnige Ansturm von Tausenden, die nach Novaras flohen, um sich hinter seinen Mauern zu verstecken."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:397
translate de qst_TheDarkPass_CampTalkDuprey_menu_06bc1e0b:

    # DUPREY "The butchered bodies of the mages and Inquisitors before we arrived to offer relief."
    DUPREY "Die geschlachteten Körper der Magier und Inquisitoren, bevor wir zur Entlastung eintrafen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:398
translate de qst_TheDarkPass_CampTalkDuprey_menu_2020af46:

    # DUPREY "But most of all, I remember THAT battle."
    DUPREY "Aber vor allem erinnere ich mich an DIESE Schlacht."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:399
translate de qst_TheDarkPass_CampTalkDuprey_menu_92a7cec2:

    # "We had all heard tales about the first great battle for Alderay and of how the ‘legendary General Newheart’ fell trying to relieve Fort Rook, the supposedly impenetrable Fortress of the South."
    "Wir hatten alle Geschichten über die erste große Schlacht um Alderay gehört und darüber, wie der ‚legendäre General Neuherz‘ fiel, als er versuchte, Fort Rook, die angeblich uneinnehmbare Festung des Südens, zu entsetzen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:400
translate de qst_TheDarkPass_CampTalkDuprey_menu_6539d583:

    # MC "... Were you there when General Newheart—"
    MC "... Warst du dabei, als General Neuherz—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:401
translate de qst_TheDarkPass_CampTalkDuprey_menu_db751ab3:

    # DUPREY "Old Iron Heart? Aye, we were friends."
    DUPREY "Alter Eisenherz? Ja, wir waren Freunde."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:403
translate de qst_TheDarkPass_CampTalkDuprey_menu_975a2b8e:

    # MC "... No way!"
    MC "... Das kann nicht sein!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:404
translate de qst_TheDarkPass_CampTalkDuprey_menu_9b54e0a7:

    # MC "You knew General Newheart?"
    MC "Du kanntest General Neuherz?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:405
translate de qst_TheDarkPass_CampTalkDuprey_menu_de87c018:

    # MC "As in, THE Newheart? "
    MC "So wie, DER Newheart?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:406
translate de qst_TheDarkPass_CampTalkDuprey_menu_e1d8f53c:

    # DUPREY "He always hated how they changed his name, Lucan Erunheart was his real name before he was ‘blessed’ with ‘Newheart, Defender of The Realm’."
    DUPREY "Er hasste es immer, wie sie seinen Namen änderten, Lucan Erunheart war sein richtiger Name, bevor er mit ‚Neuherz, Verteidiger des Reiches‘ ‚gesegnet‘ wurde."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:407
translate de qst_TheDarkPass_CampTalkDuprey_menu_409e8321:

    # DUPREY "But yes, I knew him alright."
    DUPREY "Aber ja, ich kannte ihn durchaus."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:408
translate de qst_TheDarkPass_CampTalkDuprey_menu_191438df:

    # DUPREY "I was there at the war table with him; we strategized many a battle together."
    DUPREY "Ich war mit ihm am Kriegstisch; wir haben viele Schlachten zusammen geplant."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:409
translate de qst_TheDarkPass_CampTalkDuprey_menu_8d6c11d2:

    # DUPREY "It was the two of us that pushed back Kalliban’s first invasion AND the Dark Elf King’s encroach. "
    DUPREY "Wir beide waren es, die Kallibans erste Invasion UND das Vordringen des Dunkelelfenkönigs zurückschlugen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:410
translate de qst_TheDarkPass_CampTalkDuprey_menu_89a0558d:

    # MC "That’s... That’s incredible!"
    MC "Das ist... Das ist unglaublich!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:411
translate de qst_TheDarkPass_CampTalkDuprey_menu_8523b42e:

    # DUPREY "Bah... I was a younger man back then, I ain’t as fast as I used to be."
    DUPREY "Bah... Damals war ich ein jüngerer Mann, ich bin nicht mehr so schnell wie früher."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:412
translate de qst_TheDarkPass_CampTalkDuprey_menu_77f64d26:

    # DUPREY "Newheart though? The best warrior I’d ever met and a brilliant commander in the field."
    DUPREY "Newheart aber? Der beste Krieger, den ich je getroffen habe, und ein brillanter Kommandant im Felde."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:413
translate de qst_TheDarkPass_CampTalkDuprey_menu_bc2aaa32:

    # DUPREY "Handsome bastard as well, got all the girls swooning after him."
    DUPREY "Ein gutaussehender Kerl noch dazu, der alle Mädchen zum Schmachten brachte."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:414
translate de qst_TheDarkPass_CampTalkDuprey_menu_0f58b1c0:

    # DUPREY "They still singing about him?"
    DUPREY "Singen sie immer noch von ihm?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:415
translate de qst_TheDarkPass_CampTalkDuprey_menu_0453fc0f:

    # MC "All the time! The man’s a legend!"
    MC "Die ganze Zeit! Der Mann ist eine Legende!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:416
translate de qst_TheDarkPass_CampTalkDuprey_menu_d3379069:

    # MC "I can’t believe you actually met him! You’re bound to hear at least one song about him in any of the taverns once people have had a drink or two!"
    MC "Ich kann nicht glauben, dass du ihn wirklich getroffen hast! Du wirst garantiert mindestens ein Lied über ihn in jeder Taverne hören, sobald die Leute ein oder zwei Gläser intus haben!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:417
translate de qst_TheDarkPass_CampTalkDuprey_menu_3829efd5:

    # DUPREY @ think "Hmph..."
    DUPREY @ think "Hmpf..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:418
translate de qst_TheDarkPass_CampTalkDuprey_menu_cc702e61:

    # MC "... Where did it all go wrong?"
    MC "... Wo ist das alles schiefgegangen?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:419
translate de qst_TheDarkPass_CampTalkDuprey_menu_56d22cd3:

    # "The Captain had become morose as he reminisced, but his anger was now evident as his eyes glared into the embers of the fire."
    "Der Hauptmann war beim Rückblick melancholisch geworden, aber sein Zorn war jetzt offensichtlich, als seine Augen in die Glut des Feuers starrten."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:420
translate de qst_TheDarkPass_CampTalkDuprey_menu_c44cfa87:

    # DUPREY "{i}Mesamor happened.{/i}"
    DUPREY "{i}Mesamor geschah.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:421
translate de qst_TheDarkPass_CampTalkDuprey_menu_4a075af6:

    # MC "What do you mean?"
    MC "Was meinst du?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:422
translate de qst_TheDarkPass_CampTalkDuprey_menu_95893d7d:

    # DUPREY "I mean that old prick decided the siege tactics we had laid out would have taken too long."
    DUPREY "Ich meine, dass dieser alte Sack entschied, dass die Belagerungstaktiken, die wir ausgearbeitet hatten, zu lange gedauert hätten."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:423
translate de qst_TheDarkPass_CampTalkDuprey_menu_182fc79b:

    # DUPREY "So, he decided in his infinite fucking wisdom to push through some other general’s much more aggressive strategy."
    DUPREY "Also entschied er in seiner unendlichen verdammten Weisheit, die viel aggressivere Strategie eines anderen Generals durchzudrücken."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:424
translate de qst_TheDarkPass_CampTalkDuprey_menu_546d1fd8:

    # DUPREY "Mesamor couldn’t stand the idea of a prolonged war, he wanted to take back Fort Rook as quickly as possible and march south to take back everything else he’d lost."
    DUPREY "Mesamor konnte den Gedanken an einen langwierigen Krieg nicht ertragen, er wollte Fort Rook so schnell wie möglich zurückerobern und nach Süden marschieren, um alles andere zurückzuerobern, was er verloren hatte."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:425
translate de qst_TheDarkPass_CampTalkDuprey_menu_90a9bd26:

    # MC "I take it you didn’t approve."
    MC "Ich nehme an, du warst nicht einverstanden."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:426
translate de qst_TheDarkPass_CampTalkDuprey_menu_07a85dee:

    # DUPREY "Years of actual battle experience and advice were cast out the window for the sake of bureaucracy, what do you think?"
    DUPREY "Jahrelange echte Kampferfahrung und Ratschläge wurden für die Bürokratie über Bord geworfen, was denkst du?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:427
translate de qst_TheDarkPass_CampTalkDuprey_menu_fdd64753:

    # MC "... So, what do you remember of the battle itself?"
    MC "... Also, woran erinnerst du dich von der Schlacht selbst?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:428
translate de qst_TheDarkPass_CampTalkDuprey_menu_42fc440a:

    # DUPREY "Lots of fighting... Dead everywhere... I saw more bodies that day than most men see in a lifetime."
    DUPREY "Viel Kampf... Überall Tote... Ich habe an diesem Tag mehr Leichen gesehen, als die meisten Männer in ihrem ganzen Leben sehen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:429
translate de qst_TheDarkPass_CampTalkDuprey_menu_719f6fe6:

    # DUPREY "From all the smoke and what felt like an avalanche of blood, it was hard just to breathe, never mind making sense of the field..."
    DUPREY "Wegen all dem Rauch und dem, was sich wie eine Lawine von Blut anfühlte, war es schwer, nur zu atmen, geschweige denn, das Schlachtfeld zu verstehen ..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:430
translate de qst_TheDarkPass_CampTalkDuprey_menu_5b6ff3e4:

    # DUPREY "Across the way on a small hill, I saw Newheart in that shimmering armour you lot like singing about so much. "
    DUPREY "Auf der anderen Seite auf einem kleinen Hügel sah ich Newheart in dieser schimmernden Rüstung, von der ihr so gerne singt."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:431
translate de qst_TheDarkPass_CampTalkDuprey_menu_021f89e6:

    # DUPREY "He stood alone against the Demorai General, a monstrous thing I can’t seem to forget even when I try..."
    DUPREY "Er stand allein gegen den General der Demorai, ein monströses Ding, das ich selbst dann nicht vergessen kann, wenn ich es versuche..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:432
translate de qst_TheDarkPass_CampTalkDuprey_menu_5d817988:

    # DUPREY "{i}Zanarak.{/i}"
    DUPREY "{i}Zanarak.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:433
translate de qst_TheDarkPass_CampTalkDuprey_menu_cff33da7:

    # "{i}Zanarak{/i}, the bogeyman of every child in Alderay."
    "{i}Zanarak{/i}, der Schreckgespenst jedes Kindes in Alderay."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:434
translate de qst_TheDarkPass_CampTalkDuprey_menu_0d9c3b4c:

    # "Stories spread far and wide of a supposed leader of the Demorai’s armies, unstoppable and ruthless, wings so large they could block out the sun and plunge an entire battlefield into a darkness as awful as himself..."
    "Geschichten verbreiteten sich weit und breit von einem angeblichen Anführer der Armeen der Demorai, unaufhaltsam und gnadenlos, mit Flügeln so groß, dass sie die Sonne verdecken und ein ganzes Schlachtfeld in eine Finsternis stürzen konnten, so furchtbar wie er selbst..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:435
translate de qst_TheDarkPass_CampTalkDuprey_menu_6cc1af85:

    # "Some doubt if he ever existed, so few survivors remain whenever he’s claimed to have been sighted and the tales they told were wilder than the legends of Newheart."
    "Manche bezweifeln, dass er je existiert hat, so wenige Überlebende bleiben, wann immer behauptet wird, er sei gesichtet worden, und die Geschichten, die sie erzählten, waren wilder als die Legenden über Newheart."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:436
translate de qst_TheDarkPass_CampTalkDuprey_menu_ba79f724:

    # MC "He’s... {i}real?{/i}"
    MC "Er ist... {i}echt?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:437
translate de qst_TheDarkPass_CampTalkDuprey_menu_42eb289b:

    # DUPREY "As real as you and me, boy... Make no mistake about that."
    DUPREY "So echt wie du und ich, Junge... Mach dir da nichts vor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:438
translate de qst_TheDarkPass_CampTalkDuprey_menu_aaabade5:

    # DUPREY "{i}*Sigh*{/i} He fought bravely..."
    DUPREY "{i}*Seufz*{/i} Er kämpfte tapfer..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:439
translate de qst_TheDarkPass_CampTalkDuprey_menu_445ed618:

    # MC "How did—"
    MC "Wie hat—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:440
translate de qst_TheDarkPass_CampTalkDuprey_menu_ab292432:

    # DUPREY "It took his head."
    DUPREY "Es riss seinen Kopf ab."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:441
translate de qst_TheDarkPass_CampTalkDuprey_menu_7c0a6889:

    # DUPREY "I still remember that thing clutching him by the hair and holding it up for us all to see..."
    DUPREY "Ich erinnere mich noch daran, wie dieses Ding ihn an den Haaren packte und es hochhielt, damit wir alle es sehen konnten ..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:442
translate de qst_TheDarkPass_CampTalkDuprey_menu_42c2bad6:

    # DUPREY "Boasting of his kill, gloating at how easy it had been to take down the very best of us."
    DUPREY "Prahlte mit seiner Beute, verhöhnte uns, wie einfach es gewesen war, den Besten von uns zur Strecke zu bringen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:443
translate de qst_TheDarkPass_CampTalkDuprey_menu_5ee5ad2c:

    # "A chilling sense of dread slithered into every bone in my body... {i}What if we encountered some monster Zanarak while we were scouting out here now?{/i}"
    "Ein eiskaltes Gefühl der Angst kroch in jeden Knochen meines Körpers ... {i}Was, wenn wir jetzt hier draußen beim Kundschaften auf ein Monster wie Zanarak treffen würden?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:444
translate de qst_TheDarkPass_CampTalkDuprey_menu_aa8fdbe9:

    # DUPREY "After that, you know the rest."
    DUPREY "Danach kennst du den Rest."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:445
translate de qst_TheDarkPass_CampTalkDuprey_menu_e8c1063f:

    # DUPREY "Lots of fighting, {i}Daggerfall.{/i}"
    DUPREY "Viele Kämpfe, {i}Daggerfall.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:446
translate de qst_TheDarkPass_CampTalkDuprey_menu_f2837818:

    # DUPREY "Mesamor deposed and Alcott declaring himself Emperor..."
    DUPREY "Mesamor abgesetzt und Alcott, der sich selbst zum Kaiser erklärte ..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:447
translate de qst_TheDarkPass_CampTalkDuprey_menu_eaa48d0c:

    # MC "Can I hear some more about Daggerfall?"
    MC "Kann ich noch mehr über Daggerfall hören?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:448
translate de qst_TheDarkPass_CampTalkDuprey_menu_75f1addb:

    # DUPREY "I’m not a history teacher, lad."
    DUPREY "Ich bin kein Geschichtslehrer, Junge."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:449
translate de qst_TheDarkPass_CampTalkDuprey_menu_d246bf3c:

    # MC "I know sir, sorry I... guess I just to wish to hear from someone who was actually there."
    MC "Ich weiß, Sir, tut mir leid, ich ... schätze, ich wollte einfach von jemandem hören, der tatsächlich dort war."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:450
translate de qst_TheDarkPass_CampTalkDuprey_menu_e1044f79:

    # MC "I’m not sure how reliable those books we were given are."
    MC "Ich bin mir nicht sicher, wie zuverlässig die Bücher sind, die man uns gegeben hat."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:451
translate de qst_TheDarkPass_CampTalkDuprey_menu_0014520a:

    # DUPREY "Hmph... Wise boy, you are... They probably try to paint a rosier picture than it really was."
    DUPREY "Hmpf... Kluger Junge, das bist du... Sie versuchen wahrscheinlich, ein rosigeres Bild zu malen, als es wirklich war."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:452
translate de qst_TheDarkPass_CampTalkDuprey_menu_e9a51bd0:

    # DUPREY "Don’t wanna give you kids too many nightmares, we’d never get you fighting for us otherwise!"
    DUPREY "Wir wollen euch Kindern nicht zu viele Albträume machen, sonst würden wir euch nie dazu bekommen, für uns zu kämpfen!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:453
translate de qst_TheDarkPass_CampTalkDuprey_menu_69ce2041:

    # DUPREY "Operation Daggerfall was our last real gamble."
    DUPREY "Operation Daggerfall war unser letztes richtiges Wagnis."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:454
translate de qst_TheDarkPass_CampTalkDuprey_menu_a90a9028:

    # DUPREY "We had managed some years before, when the war with the Demorai first really started, to suspend previous conflicts and form a loose alliance with the other kingdoms and races;"
    DUPREY "Es war uns einige Jahre zuvor, als der Krieg mit den Demorai wirklich begann, gelungen, vorherige Konflikte auszusetzen und ein lockeres Bündnis mit den anderen Königreichen und Völkern zu schließen;"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:455
translate de qst_TheDarkPass_CampTalkDuprey_menu_077b901a:

    # DUPREY "Elves, Dwarves, Orcs, even the bloody Greater Trading Company..."
    DUPREY "Elfen, Zwerge, Orks, sogar die verdammte Große Handelsgesellschaft..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:456
translate de qst_TheDarkPass_CampTalkDuprey_menu_005134d0:

    # DUPREY "Didn’t do much good though when the bastards kept showing up everywhere."
    DUPREY "Hat aber nicht viel genützt, als die Bastarde überall weiter auftauchten."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:457
translate de qst_TheDarkPass_CampTalkDuprey_menu_c64175ec:

    # DUPREY "Following the failure of The Great Demorai Siege, we were in high spirits after our first major win."
    DUPREY "Nach dem Scheitern der Großen Belagerung der Demorai waren wir nach unserem ersten großen Sieg in Hochstimmung."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:458
translate de qst_TheDarkPass_CampTalkDuprey_menu_55e137af:

    # DUPREY "We tried pushing back harder and faster to reclaim the South, but we were losing far too many men."
    DUPREY "Wir versuchten, härter und schneller zurückzuschlagen, um den Süden zurückzuerobern, aber wir verloren viel zu viele Männer."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:459
translate de qst_TheDarkPass_CampTalkDuprey_menu_3792fe3b:

    # DUPREY "We had left people starving on the home front and many were starting to think the whole thing was a mistake, that a new strategy was needed."
    DUPREY "Wir ließen die Leute an der Heimatfront hungern, und viele begannen zu denken, dass das Ganze ein Fehler war, dass eine neue Strategie nötig war."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:460
translate de qst_TheDarkPass_CampTalkDuprey_menu_5e0c932f:

    # DUPREY "I still remember stealing boots from some dead lieutenant because mine were literally rotting away..."
    DUPREY "Ich erinnere mich noch, wie ich Stiefel von einem toten Leutnant gestohlen habe, weil meine buchstäblich verrotteten ..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:461
translate de qst_TheDarkPass_CampTalkDuprey_menu_c8369a76:

    # DUPREY "{i}*Sigh*{/i} Then came {i}Daggerfall{/i}."
    DUPREY "{i}*Seufz*{/i} Dann kam {i}Daggerfall{/i}."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:462
translate de qst_TheDarkPass_CampTalkDuprey_menu_928e3931:

    # "The Captain took another uneasy swig of his drink, as if pushing down some vile memory."
    "Der Hauptmann nahm einen weiteren unbehaglichen Schluck von seinem Getränk, als ob er eine abscheuliche Erinnerung hinunterspülen würde."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:463
translate de qst_TheDarkPass_CampTalkDuprey_menu_dbc2b92f:

    # DUPREY "{i}Fucking Daggerfall.{/i}"
    DUPREY "{i}Verdammtes Daggerfall.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:464
translate de qst_TheDarkPass_CampTalkDuprey_menu_6883b9ab:

    # MC "They tried to tell us in class that {i}Daggerfall{/i} wasn’t a total failure, that—"
    MC "Sie versuchten uns im Unterricht beizubringen, dass {i}Daggerfall{/i} kein totaler Fehlschlag war, dass—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:465
translate de qst_TheDarkPass_CampTalkDuprey_menu_99061ed9:

    # DUPREY "Oh, did they now?"
    DUPREY "Oh, tatsächlich?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:466
translate de qst_TheDarkPass_CampTalkDuprey_menu_78fa766f:

    # DUPREY "Bullshit, it was a disaster, and don’t you ever let any fancy prick in shiny armour who wasn’t even there tell you otherwise."
    DUPREY "Blödsinn, es war eine Katastrophe, und lass dir nie von irgendeinem feinen Kerl in glänzender Rüstung, der nicht einmal dabei war, etwas anderes einreden."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:467
translate de qst_TheDarkPass_CampTalkDuprey_menu_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:468
translate de qst_TheDarkPass_CampTalkDuprey_menu_fcc5db74:

    # DUPREY "It was Mesamor’s last real throw of the dice."
    DUPREY "Es war Mesamors letzter echter Würfelwurf."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:469
translate de qst_TheDarkPass_CampTalkDuprey_menu_bd72acb9:

    # DUPREY "He thought to divide the army in two and have them sweep down like scythes, hoping to crush the enemy between them on two fronts."
    DUPREY "Er dachte, die Armee in zwei Teile zu teilen und sie wie Sensen herabfegen zu lassen, in der Hoffnung, den Feind zwischen ihnen an zwei Fronten zu zermalmen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:470
translate de qst_TheDarkPass_CampTalkDuprey_menu_b1240136:

    # DUPREY "By that point, what was it? 1155? 1156 maybe?"
    DUPREY "Zu diesem Zeitpunkt, was war es? 1155? Vielleicht 1156?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:471
translate de qst_TheDarkPass_CampTalkDuprey_menu_d1ee329d:

    # DUPREY "Either way, we had neither the manpower nor the resources to pull it off, they quickly broke through our lines and we had to retreat, weaker than ever."
    DUPREY "Wie auch immer, wir hatten weder die Leute noch die Mittel, um es durchzuziehen, sie durchbrachen schnell unsere Linien und wir mussten uns zurückziehen, schwächer als je zuvor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:472
translate de qst_TheDarkPass_CampTalkDuprey_menu_2e122687:

    # DUPREY "... After that, Alcott led his coup, Mesamor became just a puppet, a monarch in name and nothing more, and the kingdom got split into factions."
    DUPREY "... Danach führte Alcott seinen Putsch durch, Mesamor wurde nur eine Marionette, ein Monarch dem Namen nach und nicht mehr, und das Königreich spaltete sich in Fraktionen auf."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:473
translate de qst_TheDarkPass_CampTalkDuprey_menu_c49fd91e:

    # MC "... I see."
    MC "... Ich verstehe."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:477
translate de qst_TheDarkPass_CampTalkDuprey_menu_e3b0a5e0:

    # DUPREY "Don’t know, orders are to secure the site and bring back the relics, that’s it."
    DUPREY "Keine Ahnung, die Befehle lauten, das Gelände zu sichern und die Relikte zurückzubringen, das war's."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:478
translate de qst_TheDarkPass_CampTalkDuprey_menu_35505111:

    # DUPREY "Frankly, I couldn’t give a shit about what we’re picking up."
    DUPREY "Ehrlich gesagt, es ist mir scheißegal, was wir aufheben."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:479
translate de qst_TheDarkPass_CampTalkDuprey_menu_4a7e500e:

    # DUPREY "In and out is my only concern."
    DUPREY "Rein und raus, das ist meine einzige Sorge."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:482
translate de qst_TheDarkPass_CampTalkDuprey_menu_439e127d:

    # DUPREY "My wife passed to fever."
    DUPREY "Meine Frau ist am Fieber gestorben."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:483
translate de qst_TheDarkPass_CampTalkDuprey_menu_328b738e:

    # MC "Oh... I’m sorry, sir."
    MC "Oh... Es tut mir leid, Sir."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:484
translate de qst_TheDarkPass_CampTalkDuprey_menu_1b214ce0:

    # DUPREY "It’s alright, it was during the mass fleeing to Novaras, wasn’t just people hiding behind those walls but plague and famine as well..."
    DUPREY "Es ist in Ordnung, es war während der Massenflucht nach Novaras, hinter diesen Mauern versteckten sich nicht nur Menschen, sondern auch Pest und Hungersnot..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:485
translate de qst_TheDarkPass_CampTalkDuprey_menu_0b409594:

    # DUPREY "My wife was a beauty... She was ravaged by the plague and her body just gave up eventually."
    DUPREY "Meine Frau war eine Schönheit... Sie wurde von der Pest heimgesucht und ihr Körper gab schließlich einfach auf."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:486
translate de qst_TheDarkPass_CampTalkDuprey_menu_2a4eac44:

    # DUPREY "My daughter is alive though, somewhere up north in Angmurus, helping with the negotiations."
    DUPREY "Meine Tochter lebt aber, irgendwo oben im Norden in Angmurus, wo sie bei den Verhandlungen hilft."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:487
translate de qst_TheDarkPass_CampTalkDuprey_menu_2d204a49_1:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:488
translate de qst_TheDarkPass_CampTalkDuprey_menu_28466b5a:

    # DUPREY @ happy "Feisty little thing let me know straight up she’d learn how to swing an axe like me! Ha!"
    DUPREY @ happy "Die kleine Draufgängerin sagte mir direkt, dass sie lernen würde, eine Axt zu schwingen wie ich! Ha!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:489
translate de qst_TheDarkPass_CampTalkDuprey_menu_912dda56:

    # DUPREY "Lord... I haven’t seen her in... {i}eight years{/i} now."
    DUPREY "Herr... Ich habe sie seit... {i}acht Jahren{/i} nicht mehr gesehen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:490
translate de qst_TheDarkPass_CampTalkDuprey_menu_ad9d3945:

    # MC "Do you know if she’s okay?"
    MC "Weißt du, ob es ihr gut geht?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:491
translate de qst_TheDarkPass_CampTalkDuprey_menu_c343a50d:

    # DUPREY "We exchange letters monthly, and I still receive reports on her from time to time, mostly trouble that she’s been causing..."
    DUPREY "Wir tauschen monatlich Briefe aus, und ich bekomme immer noch gelegentlich Berichte über sie, meistens über den Ärger, den sie verursacht..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:492
translate de qst_TheDarkPass_CampTalkDuprey_menu_d3e2f307:

    # DUPREY "When this is over, it’ll be good to see her again... I’d like to see that axe swing of her myself one day!"
    DUPREY "Wenn das hier vorbei ist, wird es schön sein, sie wiederzusehen... Ich würde gerne eines Tages selbst sehen, wie sie die Axt schwingt!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:493
translate de qst_TheDarkPass_CampTalkDuprey_menu_3be6f501:

    # DUPREY "... How about you? Anyone back home?"
    DUPREY "... Und du? Irgendjemand zu Hause?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:494
translate de qst_TheDarkPass_CampTalkDuprey_menu_eeb626c5:

    # MC "Yeah... There’s a few people waiting for me."
    MC "Ja... Da warten ein paar Leute auf mich."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:495
translate de qst_TheDarkPass_CampTalkDuprey_menu_ad8c989c:

    # DUPREY "Hm... That’s good... You think of them... They’ll give you a reason to survive when you need it."
    DUPREY "Hm... Das ist gut... Denk an sie... Sie werden dir einen Grund zum Überleben geben, wenn du es brauchst."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:500
translate de qst_TheDarkPass_CampTalkDuprey_menu_e7e53552:

    # MC "That's all, sir."
    MC "Das ist alles, Sir."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:501
translate de qst_TheDarkPass_CampTalkDuprey_menu_a5617ab8:

    # DUPREY "Enjoy your evening, boy."
    DUPREY "Genieß deinen Abend, Junge."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:502
translate de qst_TheDarkPass_CampTalkDuprey_menu_cec2f66c:

    # MC "Captain."
    MC "Captain."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:507
translate de qst_TheDarkPass_CampTalkDuprey_rep_cec2f66c:

    # MC "Captain."
    MC "Captain."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:508
translate de qst_TheDarkPass_CampTalkDuprey_rep_df42c9dc:

    # DUPREY "Enjoy the rest of your evening now, boy."
    DUPREY "Genieß jetzt den Rest deines Abends, Junge."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:509
translate de qst_TheDarkPass_CampTalkDuprey_rep_d3f4e1d4:

    # MC "Aye Captain."
    MC "Aye, Captain."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:517
translate de qst_TheDarkPass_CampTalkBorras_8c638585:

    # MC "Sir."
    MC "Sir."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:518
translate de qst_TheDarkPass_CampTalkBorras_aee6c745:

    # BORRAS "Hm? Oh, it’s you."
    BORRAS "Hm? Oh, du bist es."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:519
translate de qst_TheDarkPass_CampTalkBorras_0a1b45ef:

    # BORRAS "Nicely done out there on the ridge earlier."
    BORRAS "Gut gemacht da draußen auf dem Grat vorhin."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:520
translate de qst_TheDarkPass_CampTalkBorras_b4e53b47:

    # MC "Thank you, sir."
    MC "Vielen Dank, Sir."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:521
translate de qst_TheDarkPass_CampTalkBorras_5d38c9d0:

    # BORRAS "I’d stay and chat, but I need to consult with some of the other lieutenants, farewell."
    BORRAS "Ich würde bleiben und plaudern, aber ich muss mich mit einigen der anderen Leutnants beraten, leb wohl."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:522
translate de qst_TheDarkPass_CampTalkBorras_3e3c1fc1:

    # MC "Farewell, sir."
    MC "Leben Sie wohl, Sir."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:523
translate de qst_TheDarkPass_CampTalkBorras_c0a6ed25:

    # "He seems tense... Maybe there’s something he’s not telling us."
    "Er wirkt angespannt... Vielleicht gibt es etwas, das er uns nicht sagt."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:529
translate de qst_TheDarkPass_CampPlayCards_0fb92a86:

    # "As I headed over towards the men gathered around playing cards, one of them pulled up a seat for me."
    "Als ich zu den Männern hinüberging, die sich zum Kartenspielen versammelt hatten, zog einer von ihnen einen Stuhl für mich heran."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:530
translate de qst_TheDarkPass_CampPlayCards_87fc99d0:

    # RANDOM_SOLDIER "Oi oi! Fancy a game of cards?"
    RANDOM_SOLDIER "Oi oi! Lust auf eine Runde Karten?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:531
translate de qst_TheDarkPass_CampPlayCards_690b7417:

    # MC "Sure."
    MC "Klar."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:533
translate de qst_TheDarkPass_CampPlayCards_f405fbcf:

    # "We ran some rounds of Steel Maidens."
    "Wir spielten ein paar Runden Stahljungfrauen."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:534
