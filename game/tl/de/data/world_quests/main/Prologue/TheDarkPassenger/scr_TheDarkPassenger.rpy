# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1659
translate de qst_TheDarkPass_ObelisksRoomCheckObelisks_6a046336:

    # "A beautiful, purple-skinned Demorai woman was wandering around the scattered dead in the abandoned fort..."
    "Eine wunderschöne, purpurhäutige Demorai-Frau wanderte zwischen den verstreuten Toten in der verlassenen Festung umher..."

