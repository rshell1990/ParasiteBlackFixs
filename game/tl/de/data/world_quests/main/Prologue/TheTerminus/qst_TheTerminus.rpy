translate de qst_Terminus_PathBlockTavern2_d372b0e7:

    # MC "*Sigh* time to head home for today."
    MC "*Seufz* Zeit, für heute nach Hause zu gehen."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:356
translate de qst_Terminus_PathBlockBordelloInterior_17b6376a:

    # MC "I've had enough 'fun' today..."
