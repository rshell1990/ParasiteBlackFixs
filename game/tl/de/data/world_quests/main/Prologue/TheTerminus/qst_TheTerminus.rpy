# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:289
translate de qst_Terminus_PathBlockGates_2c4ccd68:

    # "As I approached the city gates, I couldn't help but marvel at the colossal defenses."
    "Als ich mich den Stadttoren näherte, konnte ich nicht anders, als die kolossalen Verteidigungsanlagen zu bestaunen."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:290
translate de qst_Terminus_PathBlockGates_fab2fd55:

    # MC "These gates are the only way in and out of the city."
    MC "Diese Tore sind der einzige Weg in die Stadt hinein und wieder hinaus."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:291
translate de qst_Terminus_PathBlockGates_79e20ae5:

    # MC "Encircled by walls so formidable, Novaras truly is an impenetrable city."
    MC "Umgeben von so gewaltigen Mauern ist Novaras wirklich eine uneinnehmbare Stadt."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:292
translate de qst_Terminus_PathBlockGates_f5ef103a:

    # MC "...or, a death trap."
    MC "...oder eine Todesfalle."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:296
translate de qst_Terminus_PathBlockSebastian_e082facf:

    # MC "The great Fort Sebastian. City garrison is stationed here, along with a considerable detachment of Emperor Alcott's army."
    MC "Das große Fort Sebastian. Die Stadtgarnison ist hier stationiert, zusammen mit einer beträchtlichen Abteilung von Kaiser Alcotts Armee."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:297
translate de qst_Terminus_PathBlockSebastian_2b3b2820:

    # "As I was ogling the walls and towers of the old but well-maintained fort, a guard strolled over my way."
    "Während ich die Mauern und Türme des alten, aber gut instand gehaltenen Forts begaffte, schlenderte ein Wachmann auf mich zu."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:299
translate de qst_Terminus_PathBlockSebastian_671b5a1a:

    # GUARD "Citizen! Shouldn't you be at the ceremony?"
    GUARD "Bürger! Solltet Ihr nicht bei der Zeremonie sein?"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:300
translate de qst_Terminus_PathBlockSebastian_86ce00c5:

    # MC "Oh, I'm on my way there."
    MC "Oh, ich bin auf dem Weg dorthin."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:301
translate de qst_Terminus_PathBlockSebastian_b2c4cc1d:

    # "The guard observed me suspiciously as I moved on."
    "Der Wächter beobachtete mich misstrauisch, als ich weiterging."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:305
translate de qst_Terminus_WalkIntoMarket_afeb28d0:

    # MC "This place is the heart of the city's commerce."
    MC "Dieser Ort ist das Herz des Handels der Stadt."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:306
translate de qst_Terminus_WalkIntoMarket_48731046:

    # MC "{b}Everything{/b} is being bought or sold here, especially during such an important day of the year."
    MC "{b}Alles{/b} wird hier gekauft oder verkauft, besonders an einem so wichtigen Tag des Jahres."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:307
translate de qst_Terminus_WalkIntoMarket_f4161ff2:

    # "As I walked through the market, I heard various merchants hollering at an agitated crowd of commoners headed towards the Royal Palace."
    "Als ich durch den Markt ging, hörte ich verschiedene Händler, die eine aufgeregte Menge von Bürgern anbrüllten, die auf dem Weg zum königlichen Palast waren."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:308
translate de qst_Terminus_WalkIntoMarket_d7f4f1ec:

    # MC "What exactly am I doing wandering about here?"
    MC "Was genau treibe ich mich hier herum?"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:312
translate de qst_Terminus_PathBlockClothesStore_056fedf8:

    # MC "If memory serves, this place is where all the top ladies go to get some... exquisite garments."
    MC "Wenn ich mich recht erinnere, ist dies der Ort, an den alle vornehmen Damen gehen, um einige... exquisite Kleidungsstücke zu bekommen."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:313
translate de qst_Terminus_PathBlockClothesStore_4bbd5a66:

    # MC "Not that I needed something like that at the moment."
    MC "Nicht, dass ich so etwas im Moment gebraucht hätte."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:317
translate de qst_Terminus_PathBlockClothesStore_2_2e7bef50:

    # MC "That's weird, the place seems to be locked down in a hurry."
    MC "Das ist seltsam, der Ort scheint in Eile abgeriegelt worden zu sein."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:318
translate de qst_Terminus_PathBlockClothesStore_2_52ddd3cb:

    # MC "There's a paper nailed to the front door..."
    MC "Da ist ein Zettel an die Vordertür genagelt..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:319
translate de qst_Terminus_PathBlockClothesStore_2_91d70ba4:

    # "{i}I had to shut down the store and move out of the city.{/i}"
    "{i}Ich musste den Laden schließen und aus der Stadt wegziehen.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:320
translate de qst_Terminus_PathBlockClothesStore_2_1e78dfdf:

    # "{i}I present my sincerest apology to all the regular clientele.{/i}"
    "{i}Ich entschuldige mich aufrichtig bei all meinen Stammkunden.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:321
translate de qst_Terminus_PathBlockClothesStore_2_d7106dd8:

    # "{i}It was the only way to avoid a preposterous scandal.{/i}"
    "{i}Es war der einzige Weg, einen lächerlichen Skandal zu vermeiden.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:322
translate de qst_Terminus_PathBlockClothesStore_2_5becfda9:

    # "{i}I won't go into further details here, the only thing I will say is, {b}fuck elves.{/b}{/i}"
    "{i}Ich werde hier nicht weiter ins Detail gehen, das Einzige, was ich sage, ist: {b}Scheiß auf Elfen.{/b}{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:323
translate de qst_Terminus_PathBlockClothesStore_2_fa7b7aba:

    # "{i}— Klaus Nevelinge, your humble fashionista.{/i}"
    "{i}— Klaus Nevelinge, euer bescheidener Modeexperte.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:324
translate de qst_Terminus_PathBlockClothesStore_2_6465b0fc:

