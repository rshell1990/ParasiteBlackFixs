# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:361
translate de qst_Terminus_PathBlockWitchHouse_891058fa:

    # MC "Even standing nearby that cabin gives me the creeps..."
    MC "Schon in der Nähe dieser Hütte zu stehen, jagt mir Angst ein ..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:362
translate de qst_Terminus_PathBlockWitchHouse_b2fa8c73:

    # MC "I should go to the ceremony."
    MC "Ich sollte zur Zeremonie gehen."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:366
translate de qst_Terminus_CantSleep_350d2cb3:

    # MC "Now is not the time to rest."
    MC "Jetzt ist nicht die Zeit zum Ausruhen."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:367
translate de qst_Terminus_CantSleep_87513176:

    # MC "That comes later."
    MC "Das kommt später."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:371
translate de qst_Terminus_CantGoHomeNow_569f96b2:

    # MC "I... No."
    MC "Ich ... Nein."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:372
translate de qst_Terminus_CantGoHomeNow_64c586e5:

    # MC "I cannot make [regina_ref!t] go through any more of this..."
    MC "Ich kann [regina_ref!t] nicht noch mehr davon durchmachen lassen ..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:373
translate de qst_Terminus_CantGoHomeNow_f68170be:

    # MC "Let's get on with it and go to Fort Sebastian."
    MC "Lass uns weitermachen und nach Fort Sebastian gehen."

translate de strings:

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Get gold from the chest"
    new "Gold aus der Truhe holen"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "I will certainly need some currency to handle whatever today brings. There must be some in my chest."
    new "Ich werde sicherlich etwas Geld brauchen, um mit dem zurechtzukommen, was der heutige Tag bringt. Es muss etwas in meiner Truhe sein."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Head out of your room"
    new "Verlasse dein Zimmer"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "It's time to head out."
    new "Es ist Zeit, loszugehen."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Attend the Terminus Ceremony"
    new "Nimm an der Terminus-Zeremonie teil"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "The Terminus Ceremony is held in the Royal Palace, at the very heart of the City of Novaras. I should make haste."
    new "Die Terminus-Zeremonie findet im Königspalast statt, im Herzen der Stadt Novaras. Ich sollte mich beeilen."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Meet Adara at the tavern\nor visit the bordello"
    new "Triff Adara in der Taverne\noder besuche das Bordell"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Struck by the prospect of joining the Scouts Corp, I am unsure how to spend the remainder of today. Markus went for the pleasure district to get laid. I remember Adara talking about catching up at the Iron Unicorn tavern, after the ceremony."
    new "Überwältigt von der Aussicht, dem Späherkorps beizutreten, bin ich unsicher, wie ich den Rest des Tages verbringen soll. Markus ist ins Vergnügungsviertel gegangen, um sich zu vergnügen. Ich erinnere mich, dass Adara davon sprach, sich nach der Zeremonie in der Taverne 'Zum Eisernen Einhorn' zu treffen."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Return home"
    new "Kehre nach Hause zurück"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "There goes my last night in the city as a free citizen. I should head home and try to get some sleep."
    new "Das ist meine letzte Nacht in der Stadt als freier Bürger. Ich sollte nach Hause gehen und versuchen, etwas Schlaf zu bekommen."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Report to Fort Sebastian"
    new "Melde dich in Fort Sebastian"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "During the Terminus Ceremony held yesterday I have found out that I am to be a part of the Scouts Corp, the reconnaissance branch of Emperor Alcott's army. I am to report to Fort Sebastian to begin my training. Some graduation..."
    new "Während der gestrigen Terminus-Zeremonie habe ich erfahren, dass ich dem Späherkorps angehören soll, dem Aufklärungszweig der Armee von Kaiser Alcott. Ich soll mich in Fort Sebastian melden, um meine Ausbildung zu beginnen. Was für ein Abschluss..."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:24
    old "The Terminus"
    new "Der Terminus"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:25
    old "As I have come of age, the Terminus Ceremony is about to decide my future for life. I will find out what fate has our kingdom blessed me with. Hopefully, I am prepared for it."
    new "Da ich volljährig geworden bin, steht die Terminus-Zeremonie kurz davor, mein zukünftiges Leben zu entscheiden. Ich werde herausfinden, mit welchem Schicksal mich unser Königreich gesegnet hat. Hoffentlich bin ich darauf vorbereitet."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:64
