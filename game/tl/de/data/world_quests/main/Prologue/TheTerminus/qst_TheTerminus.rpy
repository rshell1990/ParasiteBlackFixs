translate de qst_Terminus_PathBlockTavern_d08ca8f4:

    # MC "I can only imagine what the place will turn into after today's celebration..."
    MC "Ich kann mir nur vorstellen, was aus dem Ort nach der heutigen Feier wird..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:351
translate de qst_Terminus_PathBlockTavern2_1e32b18e:

