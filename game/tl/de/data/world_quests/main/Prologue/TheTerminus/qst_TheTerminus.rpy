# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:333
translate de qst_Terminus_PathBlockAdventurersGuild_5dbfbf31:

    # MC "Oh, the Adventurers Guild."
    MC "Oh, die Abenteurergilde."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:334
translate de qst_Terminus_PathBlockAdventurersGuild_44f3d8b3:

    # MC "A very bizzare way to encourage people to deal with the problems the Emperor's regime can't handle..."
    MC "Eine sehr bizarre Art, die Leute dazu zu ermutigen, sich um die Probleme zu kümmern, mit denen das kaiserliche Regime nicht fertig wird …"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:335
translate de qst_Terminus_PathBlockAdventurersGuild_e0788ece:

    # MC "Although the guild members are quite popular, given the nature of the job."
    MC "Auch wenn die Gildenmitglieder recht beliebt sind, angesichts der Art des Jobs."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:339
translate de qst_Terminus_GuildBoard_fda4112a:

    # MC "A guild quest board."
    MC "Eine Gildenauftragstafel."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:340
translate de qst_Terminus_GuildBoard_df11ef65:

    # MC "From what I know about the guild, it is {i}the{/i} way the adventurers are employed."
    MC "Soweit ich über die Gilde weiß, ist es {i}die{/i} Art, wie die Abenteurer angestellt sind."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:341
translate de qst_Terminus_GuildBoard_c2463f28:

    # MC "Any trouble the state can't handle can be turned into a 'quest' for the guild to present as a contract."
    MC "Jedes Problem, mit dem der Staat nicht fertig wird, kann zu einer 'Quest' für die Gilde werden, die sie als Auftrag präsentiert."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:342
translate de qst_Terminus_GuildBoard_308e9108:

    # MC "Not like I'll be involved in any of this, now that I'm a scout..."
    MC "Nicht so, als würde ich in so etwas verwickelt sein, jetzt, wo ich ein Späher bin..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:346
translate de qst_Terminus_PathBlockTavern_f0943a05:

    # MC "The Iron Unicorn, a place me and Markus are regulars of."
    MC "Das Eiserne Einhorn, ein Ort, in dem Markus und ich Stammgäste sind."

