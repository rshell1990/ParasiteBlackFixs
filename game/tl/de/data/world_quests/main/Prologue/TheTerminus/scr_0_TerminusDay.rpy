    # MARKUS "Ow! Fuck! That hurt!"
    MARKUS "Au! Scheiße! Das tat weh!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:417
translate de qst_Terminus_EnterPalace_10b26e90:

    # ADARA @ angry "Hmph! Teach you to be so crude..."
    ADARA @ angry "Hmph! Das wird dich lehren, nicht so grob zu sein ..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:420
translate de qst_Terminus_EnterPalace_e3aa6700:

    # ADARA @ shock "S-Shut up!"
    ADARA @ shock "H-Halt den Mund!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:421
translate de qst_Terminus_EnterPalace_762dcae9:

    # ADARA @ angry "Someone has to stop you idiots getting your heads put on sticks!"
    ADARA @ angry "Jemand muss euch Idioten davon abhalten, dass eure Köpfe auf Stöcke gesteckt werden!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:430
translate de qst_Terminus_EnterPalace_ea8481dd:

    # "The murmurs of the crowd died down suddenly; the sense of festivities soon became eerie silence."
    "Das Gemurmel der Menge erstarb plötzlich; die festliche Stimmung wich unheimlicher Stille."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:431
translate de qst_Terminus_EnterPalace_33948c6a:

    # "All heads turned to see our ‘Emperor’, Kendrick Alcott, as he slowly made his way towards the podium, donned in his thick golden armour that clanged with every step, his elite guard marching behind."
    "Alle Köpfe wandten sich, um unseren 'Kaiser', Kendrick Alcott, zu sehen, wie er langsam zum Podest schritt, angetan mit seiner dicken goldenen Rüstung, die bei jedem Schritt klirrte, seine Elitegarde marschierte hinter ihm her."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:432
translate de qst_Terminus_EnterPalace_842aed12:

    # "There were murmurs and whispers amongst the crowd, Alcott was not popular by any metric, but he was respected, and above all... {i}feared.{/i}"
    "Es gab Gemurmel und Geflüster in der Menge, Alcott war in keiner Hinsicht beliebt, aber er wurde respektiert und vor allem ... {i}gefürchtet.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:435
translate de qst_Terminus_EnterPalace_8ff1bc91:

    # ALCOTT "... Today is a special day for this kingdom."
    ALCOTT "... Heute ist ein besonderer Tag für dieses Königreich."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:436
translate de qst_Terminus_EnterPalace_1e39f10a:

    # ALCOTT @ smile "It has been fourteen years since our war with the Demorai began. Fourteen years of sacrifices..."
    ALCOTT @ smile "Es ist vierzehn Jahre her, seit unser Krieg mit den Demorai begann. Vierzehn Jahre der Opfer ..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:437
translate de qst_Terminus_EnterPalace_4872ab72:

    # ALCOTT " Fourteen years of losses too great to put into words."
    ALCOTT "Vierzehn Jahre Verluste, die sich kaum in Worte fassen lassen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:438
translate de qst_Terminus_EnterPalace_8be50508:

    # ALCOTT "Each of us has lost someone in this conflict, but the battle continues even now, with many of our kin away from home helping to secure and restore our once great kingdom!"
    ALCOTT "Jeder von uns hat in diesem Konflikt jemanden verloren, aber der Kampf geht weiter, selbst jetzt, wo viele unserer Verwandten fern der Heimat dabei helfen, unser einst großes Königreich zu sichern und wiederherzustellen!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:439
translate de qst_Terminus_EnterPalace_5dd048a4:

    # ALCOTT "The road ahead is hard, it is brutal... {i}and it is bloody.{/i} "
    ALCOTT "Der Weg vor uns ist hart, er ist brutal... {i}und er ist blutig.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:440
translate de qst_Terminus_EnterPalace_a11fa683:

    # ALCOTT "But today is a day of new hope!"
    ALCOTT "Aber heute ist ein Tag neuer Hoffnung!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:441
translate de qst_Terminus_EnterPalace_a9388680:

    # ALCOTT "A day for a new generation to lead the fight!"
    ALCOTT "Ein Tag für eine neue Generation, den Kampf anzuführen!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:442
translate de qst_Terminus_EnterPalace_a1dfe190:

    # ALCOTT "And we WILL be victorious in this conflict!"
    ALCOTT "Und wir WERDEN in diesem Konflikt siegreich sein!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:443
translate de qst_Terminus_EnterPalace_7395f2c2:

    # ALCOTT "We will survive and we WILL thrive once again!"
    ALCOTT "Wir werden überleben und wir WERDEN wieder gedeihen!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:444
translate de qst_Terminus_EnterPalace_b5393478:

    # ALCOTT "And most importantly, we will do it for them!"
    ALCOTT "Und vor allem werden wir es für sie tun!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:445
translate de qst_Terminus_EnterPalace_fdf784a9:

    # ALCOTT "We will build the world they fought for, the world they wanted you to have!"
    ALCOTT "Wir werden die Welt aufbauen, für die sie gekämpft haben, die Welt, die sie euch geben wollten!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:446
translate de qst_Terminus_EnterPalace_5b213438:

    # ALCOTT "To those of you now bearing the responsibility of helping us restore this kingdom to its former glory, whether soldier or baker, blacksmith or humble street sweeper..."
    ALCOTT "An diejenigen unter euch, die nun die Verantwortung tragen, uns zu helfen, dieses Königreich zu seiner früheren Pracht wiederherzustellen, ob Soldat oder Bäcker, Schmied oder bescheidener Straßenkehrer..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:447
translate de qst_Terminus_EnterPalace_9a4b160d:

    # ALCOTT "I salute you!"
    ALCOTT "Ich grüße euch!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:448
translate de qst_Terminus_EnterPalace_d9a239d2:

    # ALCOTT "HEIL!"
    ALCOTT "HEIL!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:451
translate de qst_Terminus_EnterPalace_4834d82f:

    # CROWD "HEIL EMPEROR ALCOTT! HEIL THE NEW ALDERIAN EMPIRE!"
    CROWD "HEIL KAISER ALCOTT! HEIL DEM NEUEN ALDERIANISCHEN IMPERIUM!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:452
translate de qst_Terminus_EnterPalace_debab30d:

    # ALCOTT "Go now and do your Emperor proud! Do your country proud and do yourselves proud!"
    ALCOTT "Geht jetzt und macht euren Kaiser stolz! Macht euer Land stolz und macht euch selbst stolz!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:459
translate de qst_Terminus_EnterPalace_bbe6fc24:

    # "And with that, Emperor Alcott descended from the podium, escorted back towards the fort from which he ruled and administered his government duties from."
    "Und damit stieg Kaiser Alcott vom Podium, zurück zur Festung geleitet, von der aus er regierte und seine Regierungsgeschäfte führte."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:460
translate de qst_Terminus_EnterPalace_47d3e974:

    # "As he passed by me, he looked at me for a moment, with the coldest eyes I had ever seen, as though his gaze could cut through and freeze my very soul."
    "Als er an mir vorbeiging, sah er mich einen Augenblick lang mit den kältesten Augen an, die ich je gesehen hatte, als ob sein Blick meine Seele durchdringen und einfrieren könnte."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:465
translate de qst_Terminus_EnterPalace_a8edd937:

    # ADARA @ talk "He’s so scary..."
    ADARA @ talk "Er ist so unheimlich ..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:466
translate de qst_Terminus_EnterPalace_afc8cc1f:

    # MC "Yeah..."
    MC "Ja ..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:467
translate de qst_Terminus_EnterPalace_49080373:

    # MARKUS "He might be scary, but without him this city would have fallen long ago."
    MARKUS "Er mag unheimlich sein, aber ohne ihn wäre diese Stadt schon längst gefallen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:468
translate de qst_Terminus_EnterPalace_525dee60:

    # MARKUS "We need more leaders like him. Leaders who will do what has to be done."
    MARKUS "Wir brauchen mehr Anführer wie ihn. Anführer, die tun, was getan werden muss."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:469
translate de qst_Terminus_EnterPalace_6fa51ea6:

    # ADARA @ talk "Mmm, I’m not so sure... Not after deposing the King like that..."
    ADARA @ talk "Mhm, da bin ich mir nicht so sicher ... Nicht nachdem der König so abgesetzt wurde ..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:470
translate de qst_Terminus_EnterPalace_db5a5efc:

    # MARKUS "Alcott led troops and repelled The Great Invasion from taking Novaras while the King continued to squander more troops lives pointlessly."
    MARKUS "Alcott führte Truppen und wehrte die Große Invasion davon ab, Novaras einzunehmen, während der König weiterhin sinnlos weitere Soldatenleben vergeudete."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:471
translate de qst_Terminus_EnterPalace_ae457738:

    # MARKUS "If it wasn’t for him, this place would have fallen in 1152."
    MARKUS "Ohne ihn wäre dieser Ort im Jahr 1152 gefallen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:472
translate de qst_Terminus_EnterPalace_48dd72c2:

    # ADARA @ talk "He also split the alliance in half with his little coup!"
    ADARA @ talk "Er hat mit seinem kleinen Putsch das Bündnis in zwei Hälften gespalten!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:473
translate de qst_Terminus_EnterPalace_39239c03:

    # MC "Urgh, do you two need to keep arguing politics?"
    MC "Urgh, müsst ihr zwei euch ständig über Politik streiten?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:474
translate de qst_Terminus_EnterPalace_fc35ca54:

    # ADARA @ angry "Hmph..."
    ADARA @ angry "Hmph..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:475
translate de qst_Terminus_EnterPalace_fc582d37:

    # MARKUS "Alright, let’s just drop it."
    MARKUS "In Ordnung, lassen wir das Thema fallen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:476
translate de qst_Terminus_EnterPalace_315cc143:

    # MARKUS "Anyway, come on, it’s time we finally got our results, [player_name!t]!"
    MARKUS "Wie auch immer, komm schon, es ist Zeit, dass wir endlich unsere Ergebnisse bekommen, [player_name!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:477
translate de qst_Terminus_EnterPalace_8bbd0124:

    # MC "Ah, right."
    MC "Ah, stimmt."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:478
translate de qst_Terminus_EnterPalace_6fd5686c:

    # ADARA @ talk "Goodluck, guys, I best get in my queue as well!"
    ADARA @ talk "Viel Glück, Leute, ich sollte mich auch in meine Schlange einreihen!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:480
translate de qst_Terminus_EnterPalace_bf5aeb7d:

    # MC "Good luck, Adara!"
    MC "Viel Glück, Adara!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:482
translate de qst_Terminus_EnterPalace_8da82e65:

    # MARKUS "Same, good luck to you."
    MARKUS "Gleichfalls, viel Glück dir."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:485
translate de qst_Terminus_EnterPalace_052cae9b:

    # "Each of us headed over to our respective queues, where hundreds of students would now wait for hours to receive the letter that would decide their life."
    "Jeder von uns begab sich zu seiner jeweiligen Warteschlange, wo Hunderte von Studenten nun stundenlang warten würden, um den Brief zu erhalten, der über ihr Leben entscheiden würde."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:486
translate de qst_Terminus_EnterPalace_488e3fc8:

    # "Sometimes, the wait would leave some to not find out until the early hours of the next morning..."
    "Manchmal führte das Warten dazu, dass manche erst in den frühen Morgenstunden des nächsten Tages erfahren würden..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:487
translate de qst_Terminus_EnterPalace_19e073a7:

    # "After five hours, I finally arrived at the stall."
    "Nach fünf Stunden erreichte ich endlich den Schalter."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:489
translate de qst_Terminus_EnterPalace_e7442a13:

    # "Markus had already come and gone half an hour before, after he’d managed to slip into the queue slightly ahead of me."
    "Markus war bereits eine halbe Stunde zuvor gekommen und gegangen, nachdem er es geschafft hatte, sich etwas vor mir in die Warteschlange zu mogeln."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:490
translate de qst_Terminus_EnterPalace_386634eb:

    # "He’d promised to meet me afterwards outside his home, then we’d head out to celebrate together."
    "Er hatte versprochen, sich danach vor seinem Haus mit mir zu treffen, und dann würden wir zusammen feiern gehen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:493
translate de qst_Terminus_EnterPalace_dedd2831:

    # "The woman looked up at me, smiling warmly."
    "Die Frau sah zu mir auf und lächelte warm."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:494
translate de qst_Terminus_EnterPalace_3f349202:

    # WOMAN "Name?"
    WOMAN "Name?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:495
translate de qst_Terminus_EnterPalace_af2df090:

    # MC "[player_name!t]."
    MC "[player_name!t]."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:496
translate de qst_Terminus_EnterPalace_210a4852:

    # WOMAN "Class number?"
    WOMAN "Klassennummer?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:497
translate de qst_Terminus_EnterPalace_a75d1844:

    # MC "4D."
    MC "4D."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:498
translate de qst_Terminus_EnterPalace_a088cd90:

    # WOMAN "Student number?"
    WOMAN "Studentennummer?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:499
translate de qst_Terminus_EnterPalace_675612db:

    # MC "Three-Two-Six-Nine-One."
    MC "Drei-Zwei-Sechs-Neun-Eins."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:500
translate de qst_Terminus_EnterPalace_757e00c2:

    # "The woman shuffled through the envelopes stamped down with the red wax seal of the Royal Court, and after finding mine, handed it over to me which I snatched greedily from her hands."
    "Die Frau blätterte durch die Umschläge, die mit dem roten Wachssiegel des königlichen Hofes versehen waren, und nachdem sie meinen gefunden hatte, überreichte sie ihn mir, den ich gierig aus ihren Händen riss."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:501
translate de qst_Terminus_EnterPalace_70c7cba8:

    # WOMAN "Good luck!"
    WOMAN "Viel Glück!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:502
translate de qst_Terminus_EnterPalace_19f340fd:

    # MC "Thank you!"
    MC "Danke!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:503
translate de qst_Terminus_EnterPalace_12fca38c:

    # "This is it! This is my destiny in my hands!"
    "Das ist es! Das ist mein Schicksal in meinen Händen!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:504
translate de qst_Terminus_EnterPalace_403df7de:

    # "All these years of work are finally going to pay off!"
    "All die Jahre der Arbeit werden sich endlich auszahlen!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:505
translate de qst_Terminus_EnterPalace_40d11fb3:

    # "Feverishly, I ripped into the letter with sweaty hands, my heart beating frantically."
    "Fieberhaft riss ich mit verschwitzten Händen den Brief auf, mein Herz schlug wild."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:520
translate de qst_Terminus_EnterPalace_85bbe6f7:

    # "I read that tiny bit of text a couple times over before it actually started to make sense..."
    "Ich las diesen winzigen Text ein paar Mal, bevor er tatsächlich anfing, Sinn zu ergeben ..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:521
translate de qst_Terminus_EnterPalace_27570ac7:

    # MC "My... Training?"
    MC "Mein... Training?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:522
translate de qst_Terminus_EnterPalace_a20cefa7:

    # "..."
    "..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:523
translate de qst_Terminus_EnterPalace_5c3e3f1d:

    # MC "Capital... What?!"
    MC "Hauptstadt... Was?!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:524
translate de qst_Terminus_EnterPalace_1d5e8c4b:

    # MC "I... {i}I’m going to the Scouts?{/i}"
    MC "Ich... {i}Ich gehe zu den Scouts?{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:525
translate de qst_Terminus_EnterPalace_b8535060:

    # MC "... No... No! This is... This is wrong!"
    MC "... Nein... Nein! Das ist... Das ist falsch!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:526
translate de qst_Terminus_EnterPalace_20b35e97:

    # MC "I can’t be in the Scouts! This is..."
    MC "Ich kann nicht bei den Scouts sein! Das ist..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:530
translate de qst_Terminus_EnterPalace_b1631114:

    # "Looking up, I hurried back over the stall, frantically trying to speak to the lady but was immediately restrained by the guards."
    "Als ich aufblickte, eilte ich zurück zum Stand, versuchte verzweifelt, mit der Frau zu sprechen, wurde jedoch sofort von den Wachen festgehalten."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:531
translate de qst_Terminus_EnterPalace_5f57996f:

    # "Other students berated me for cutting the line."
    "Andere Schüler beschimpften mich, weil ich mich vorgedrängelt hatte."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:532
translate de qst_Terminus_EnterPalace_170b6a29:

    # WOMAN "Sir! Please wait in line for—"
    WOMAN "Herr! Bitte warten Sie in der Schlange, bis—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:533
translate de qst_Terminus_EnterPalace_5818611d:

    # MC "This! This has to be a mistake! I can’t be in the Scouts! I’m not—"
    MC "Das! Das muss ein Fehler sein! Ich kann nicht bei den Scouts sein! Ich bin nicht—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:534
translate de qst_Terminus_EnterPalace_4f67789a:

    # WOMAN "If it’s got your name on the front and that’s what’s written, then I’m afraid you are, sir."
    WOMAN "Wenn vorne Ihr Name draufsteht und das da geschrieben steht, dann sind Sie es wohl, Sir."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:535
translate de qst_Terminus_EnterPalace_4475949c:

    # MC "But I... I—"
    MC "Aber ich... ich—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:536
translate de qst_Terminus_EnterPalace_95125b1b:

    # GUARD "Oi! Go on, son! Get out of here now!"
    GUARD "Oi! Los, Junge! Raus hier, sofort!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:537
translate de qst_Terminus_EnterPalace_25dc304d:

    # "The guard shoved me back sharply, making me stumble as I fell on my ass, tears springing behind my eyes as I muttered to myself."
    "Der Wächter schubste mich heftig zurück, sodass ich stolperte und auf meinem Hintern landete, Tränen stiegen mir in die Augen, während ich vor mich hin murmelte."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:538
translate de qst_Terminus_EnterPalace_52378a4f:

    # MC "No... {i}No this can’t be!{/i}"
    MC "Nein... {i}Nein, das kann nicht sein!{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:539
translate de qst_Terminus_EnterPalace_f20c8d0d:

    # MC "I can’t... {i}This...{/i}... This is a nightmare!"
    MC "Ich kann nicht... {i}Das...{/i}... Das ist ein Albtraum!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:540
translate de qst_Terminus_EnterPalace_fd8e9f7a:

    # MC "{i}It can’t be real!{/i}"
    MC "{i}Das kann nicht echt sein!{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:546
translate de qst_Terminus_EnterPalace_903a92c1:

    # "Dazed, I walked the streets aimlessly for what seemed like an eternity, until I found myself in the housing district."
    "Benommen lief ich ziellos durch die Straßen, was sich wie eine Ewigkeit anfühlte, bis ich mich im Wohnviertel wiederfand."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:547
translate de qst_Terminus_EnterPalace_62f22980:

    # "I dragged myself over to Markus’ home, dejected, destroyed... {i}broken.{/i}"
    "Ich schleppte mich zu Markus' Haus, niedergeschlagen, zerstört... {i}gebrochen.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:554
translate de qst_Terminus_EnterPalace_0c816036:

    # "I found him slouched against the wall by his front door, a solemn look on his face as he turned to me, still holding his own sheet in his hands."
    "Ich fand ihn gegen die Wand an seiner Haustür gelehnt, einen ernsten Ausdruck im Gesicht, als er sich zu mir umdrehte, immer noch sein eigenes Blatt in den Händen haltend."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:555
translate de qst_Terminus_EnterPalace_25c532ca:

    # MARKUS "... I’ve been placed in the Scouts."
    MARKUS "… Ich wurde den Pfadfindern zugeteilt."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:556
translate de qst_Terminus_EnterPalace_d92e9348:

    # "He said with a lifeless look in his eyes, my eyes widened in shock."
    "Sagte er mit einem leblosen Blick in den Augen, meine Augen weiteten sich vor Schock."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:557
translate de qst_Terminus_EnterPalace_dd0c95fc:

    # MC "... Y-You’re..."
    MC "… D-Du bist…"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:558
translate de qst_Terminus_EnterPalace_06928b06:

    # MARKUS "Yes."
    MARKUS "Ja."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:559
translate de qst_Terminus_EnterPalace_569f4dc6:

    # "I gulped hard, nodding."
    "Ich schluckte schwer und nickte."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:560
translate de qst_Terminus_EnterPalace_55c52802:

    # MC "... {i}Me too.{/i}"
    MC "… {i}Ich auch.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:561
translate de qst_Terminus_EnterPalace_e70ab855:

    # "Markus’ mouth hung open in shock, all our dreams and hopes... just like that, {i}gone.{/i}"
    "Markus’ Mund stand vor Schock offen, all unsere Träume und Hoffnungen… einfach so, {i}weg.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:562
translate de qst_Terminus_EnterPalace_01020745:

    # MARKUS "... No, you mean—"
    MARKUS "… Nein, du meinst—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:563
translate de qst_Terminus_EnterPalace_605f37ff:

    # MC "... Heh... Well, looks like we’re still stuck together... Just..."
    MC "… Heh… Tja, sieht aus, als steckten wir immer noch zusammen… Nur…"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:564
translate de qst_Terminus_EnterPalace_0f584615:

    # MC "Not in the way we hoped."
    MC "Nicht so, wie wir gehofft hatten."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:565
translate de qst_Terminus_EnterPalace_66cfca50:

    # MARKUS "... Yeah..."
    MARKUS "... Ja..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:566
translate de qst_Terminus_EnterPalace_57bce272:

    # MARKUS "Instead of eating well and wooing court ladies together."
    MARKUS "Anstatt gut zu essen und gemeinsam Hofdamen zu umwerben."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:567
translate de qst_Terminus_EnterPalace_063f8be5:

    # MARKUS "{i}We’re gonna fucking die...{/i}"
    MARKUS "{i}Wir werden verdammt nochmal sterben...{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:568
translate de qst_Terminus_EnterPalace_d58e0d46:

    # MC "We don’t know that! Come on, we’ll—"
    MC "Das wissen wir nicht! Komm schon, wir werden—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:569
translate de qst_Terminus_EnterPalace_026a4575:

    # MARKUS "Look, [player_name!t], you and I both know full well that the Scouts has the shortest life expectancy, short of just jumping off the fucking wall."
    MARKUS "Schau, [player_name!t], du und ich wissen beide ganz genau, dass die Aufklärer die kürzeste Lebenserwartung haben, abgesehen davon, einfach von der verdammten Mauer zu springen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:570
translate de qst_Terminus_EnterPalace_555ad1e1:

    # MARKUS "Frankly, I’m half tempted just to get a rope and save myself the agony of dying by {i}their{/i} hands."
    MARKUS "Ehrlich gesagt, bin ich halb versucht, mir einfach ein Seil zu schnappen und mir die Qual zu ersparen, durch {i}ihre{/i} Hände zu sterben."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:571
translate de qst_Terminus_EnterPalace_1ebe35b7:

    # MC "Don’t joke about that!"
    MC "Mach keine Witze darüber!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:572
translate de qst_Terminus_EnterPalace_80e3fd99:

    # MARKUS "Why not? We’re fucked anyway."
    MARKUS "Warum nicht? Wir sind sowieso am Arsch."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:573
translate de qst_Terminus_EnterPalace_ed1242e8:

    # MC "Well, you’ll definitely be fucked if you do that!"
    MC "Nun, du wirst definitiv am Arsch sein, wenn du das tust!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:574
translate de qst_Terminus_EnterPalace_e160c276:

    # MC "And you’ll be fucking me over! I need someone to have my back out {i}there!{/i}"
    MC "Und du wirst mich verarschen! Ich brauche jemanden, der mir da {i}draußen{/i} den Rücken freihält!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:575
translate de qst_Terminus_EnterPalace_be4d18bb:

    # MARKUS "[player_name!t]..."
    MARKUS "[player_name!t]..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:576
translate de qst_Terminus_EnterPalace_f699c54d:

    # MC "Don’t give me that shit! We’ve stuck together since we were kids, we’re gonna stick together and get through this now! Understand?"
    MC "Erzähl mir keinen Scheiß! Wir haben zusammengehalten, seit wir Kinder waren, und wir werden auch jetzt zusammenhalten und das durchstehen! Verstanden?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:577
translate de qst_Terminus_EnterPalace_d42ade9c:

    # "Markus sighed deeply, not really believing me but playing along anyway."
    "Markus seufzte tief, glaubte mir nicht wirklich, spielte aber trotzdem mit."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:578
translate de qst_Terminus_EnterPalace_571fda6d:

    # MARKUS "... Yeah... We’ll make it out."
    MARKUS "... Ja... Wir schaffen das."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:579
translate de qst_Terminus_EnterPalace_72a150fc:

    # MARKUS "{i}*Sigh*{/i} Look, I don’t know about you, but for my last goddamn night of freedom I’m gonna head down the Pleasure District, you coming?"
    MARKUS "{i}*Seufz*{/i} Schau, ich weiß nicht, wie es bei dir ist, aber für meine letzte verdammte Nacht in Freiheit gehe ich ins Vergnügungsviertel, kommst du mit?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:580
translate de qst_Terminus_EnterPalace_27a83521:

    # "My eyes lit up in surprise."
    "Meine Augen leuchteten überrascht auf."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:581
translate de qst_Terminus_EnterPalace_8009daa6:

    # MC "You’re... You’re going to get a girl {i}down there?{/i}"
    MC "Du... Du willst dir {i}da unten{/i} ein Mädchen holen?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:582
translate de qst_Terminus_EnterPalace_5c828bc0:

    # MARKUS "Come on, we both know you’re not a virgin."
    MARKUS "Komm schon, wir wissen beide, dass du keine Jungfrau mehr bist."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:583
translate de qst_Terminus_EnterPalace_cf6a14ef:

    # MC "Y-Yeah, but..."
    MC "J-Ja, aber..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:584
translate de qst_Terminus_EnterPalace_45164ee2:

    # MC "{i}It’s not really my thing...{/i}"
    MC "{i}Das ist nicht wirklich mein Ding...{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:585
translate de qst_Terminus_EnterPalace_6051b7dd:

    # MARKUS "It’s not mine either, but chances are we aren’t going to get any for a couple months... and that’s assuming we survive so, I want to make the most of the time I have left."
    MARKUS "Es ist auch nicht meins, aber wahrscheinlich bekommen wir für ein paar Monate keins ... und das setzt voraus, dass wir überleben, also will ich das Beste aus der Zeit machen, die mir bleibt."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:586
translate de qst_Terminus_EnterPalace_2d204a49_1:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:587
translate de qst_Terminus_EnterPalace_f1887912:

    # MARKUS "... So, you coming?"
    MARKUS "... Also, kommst du mit?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:588
translate de qst_Terminus_EnterPalace_9cfa39df:

    # MC "I was thinking about joining Adara at the tavern."
    MC "Ich hatte überlegt, Adara in der Taverne zu treffen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:589
translate de qst_Terminus_EnterPalace_9606cbca:

    # MARKUS "Hmm... I guess that’s fair enough."
    MARKUS "Hmm... Das ist wohl fair genug."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:590
translate de qst_Terminus_EnterPalace_186dd28b:

    # MC "I'll think about it..."
    MC "Ich werde darüber nachdenken..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:591
translate de qst_Terminus_EnterPalace_4e7af60a:

    # MARKUS "{i}*Sigh*{/i} Either way, I guess we'll see each other tomorrow, at the fort."
    MARKUS "{i}*Seufz*{/i} Wie auch immer, ich denke, wir sehen uns morgen in der Festung."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:592
translate de qst_Terminus_EnterPalace_8c2da12d:

    # MC "Y-Yeah..."
    MC "J-Ja..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:593
translate de qst_Terminus_EnterPalace_fd64cc7f:

    # MARKUS "... [player_name!t]?"
    MARKUS "... [player_name!t]?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:594
translate de qst_Terminus_EnterPalace_dd7df583:

    # MC "Yeah?"
    MC "Ja?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:595
translate de qst_Terminus_EnterPalace_f3a2929b:

    # MARKUS "If you do go and meet Adara, tell her how you really feel..."
    MARKUS "Wenn du Adara triffst, sag ihr, wie du wirklich fühlst ..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:596
translate de qst_Terminus_EnterPalace_02043c53:

    # MARKUS "{i}You might not get another chance.{/i}"
    MARKUS "{i}Vielleicht bekommst du keine weitere Gelegenheit.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:598
translate de qst_Terminus_EnterPalace_209a0a1a:

    # "Markus turned slowly, dragging his feet as he trudged over and made his way towards the Pleasure District."
    "Markus drehte sich langsam um, schleppte sich müde hinüber und machte sich auf den Weg zum Vergnügungsviertel."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:599
translate de qst_Terminus_EnterPalace_5ed3e91d:

    # "I stood there, unsure what to do, dark thoughts trailing around me."
    "Ich stand da, unsicher, was ich tun sollte, während dunkle Gedanken um mich kreisten."

