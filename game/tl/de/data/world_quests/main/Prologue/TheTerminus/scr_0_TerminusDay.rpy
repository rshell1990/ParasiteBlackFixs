    ERIKA @ smile_talk "Geschmack, der deutlich über deinem Stand ist, möchte ich hinzufügen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:168
translate de qst_Terminus_KitchenEnterMorning_3f3dc3f8:

