translate de qst_Terminus_KitchenEnterMorning_02dde3ac:

    # MC "You shouldn’t have, it’s too expensive."
    MC "Das hättest du nicht tun sollen, es ist zu teuer."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:261
translate de qst_Terminus_KitchenEnterMorning_4dc4a3ba:

    # REGINA @ talk "I won’t hear none of it! It’s your big day!"
    REGINA @ talk "Ich will nichts davon hören! Es ist dein großer Tag!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:262
translate de qst_Terminus_KitchenEnterMorning_52311849:

    # REGINA @ talk "Now, go on, shoo!"
    REGINA @ talk "Nun, geh schon, husch!"

