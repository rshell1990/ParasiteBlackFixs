translate de qst_Terminus_KitchenEnterMorning_b7fa50d6:

    # ERIKA @ talk "I’ve seen with my own eyes some of the horrors from their twisted magic."
    ERIKA @ talk "Ich habe mit eigenen Augen einige der Schrecken ihrer verdrehten Magie gesehen."

