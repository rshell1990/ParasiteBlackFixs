translate de qst_Terminus_KitchenEnterMorning_36627c23:

    # REGINA @ sad_talk "... Hunting more Dark Mages, I suppose?"
    REGINA @ sad_talk "... Noch mehr Dunkelmagier jagen, vermute ich?"

