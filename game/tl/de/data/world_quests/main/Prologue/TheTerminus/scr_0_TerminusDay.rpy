translate de qst_Terminus_KitchenEnterMorning_96760879:

    # ERIKA @ sad_talk "We will {i}not{/i} allow tainted magic into Novaras."
    ERIKA @ sad_talk "Wir werden {i}nicht{/i} zulassen, dass verdorbene Magie nach Novaras gelangt."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:200
translate de qst_Terminus_KitchenEnterMorning_ab53317b:

