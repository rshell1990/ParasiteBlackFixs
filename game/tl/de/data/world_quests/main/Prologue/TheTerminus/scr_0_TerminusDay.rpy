    ERIKA @ talk "Du hast recht, jetzt ist nicht die Zeit, um über Politik zu debattieren."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:221
translate de qst_Terminus_KitchenEnterMorning_5b77c2d3:

    # ERIKA @ talk "Especially matters as important as this."
    ERIKA @ talk "Besonders so wichtige Angelegenheiten wie diese."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:223
translate de qst_Terminus_KitchenEnterMorning_513aa734:

    # MC "Will you be back when I get home, Erika?"
    MC "Wirst du wieder da sein, wenn ich nach Hause komme, Erika?"

