    REGINA "Also, ich nehme an, ihr plant immer noch, Verwalter am Königshof zu werden, nicht wahr?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:172
translate de qst_Terminus_KitchenEnterMorning_b61df758:

    # ERIKA @ smile_talk "Hoping for a nice easy life, huh?"
    ERIKA @ smile_talk "Hofft ihr auf ein schönes, leichtes Leben, was?"

