translate de qst_Terminus_KitchenEnterMorning_60a64ecb:

    # REGINA @ lewd_talk "Oh, umm... I perhaps dipped into the savings a little for a special occasion such as this..."
    REGINA @ lewd_talk "Oh, ähm... Ich habe vielleicht ein wenig von den Ersparnissen abgezweigt für einen so besonderen Anlass wie diesen..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:258
translate de qst_Terminus_KitchenEnterMorning_d7e14922:

    # MC "[regina_ref_cap!t]!"
    MC "[regina_ref_cap!t]!"

