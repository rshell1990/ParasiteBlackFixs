    # MARKUS "What? Come onnnn, it’s just a little fun, right, [player_name!t]?"
    MARKUS "Was? Komm schooooon, es ist doch nur ein bisschen Spaß, oder, [player_name!t]?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:380
translate de qst_Terminus_EnterPalace_7b6a0436:

    # ADARA @ angry "The royal family is our oldest and most respected institute!"
    ADARA @ angry "Die königliche Familie ist unsere älteste und am meisten respektierte Institution!"

