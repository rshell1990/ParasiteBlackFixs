translate de qst_Terminus_KitchenEnterMorning_7434d5e2:

    # REGINA @ talk "Oh stop, Erika! Him and every other student is hoping to be designated a nicer role like that."
    REGINA @ talk "Ach hör auf, Erika! Er und jeder andere Student hofft darauf, eine schönere Rolle wie diese zugewiesen zu bekommen."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:174
translate de qst_Terminus_KitchenEnterMorning_2a39ea4a:

