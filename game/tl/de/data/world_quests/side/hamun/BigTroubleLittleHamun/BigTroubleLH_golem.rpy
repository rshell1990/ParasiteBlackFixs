# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:460
translate de qst_BigTroubleLHamun_temple_obelisk_first_enter_5f452910:

    # "Peering into the strange cylinders scattered around the room, I rubbed my hand across the filthy glass to see inside."
    "Ich spähte in die seltsamen Zylinder, die im Raum verstreut waren, und rieb mit der Hand über das schmutzige Glas, um hineinzusehen."

# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:461
translate de qst_BigTroubleLHamun_temple_obelisk_first_enter_3bd13883:

    # "Only rotten, skeletal remains lay within."
    "Nur verweste, skelettartige Überreste lagen darin."

# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:462
translate de qst_BigTroubleLHamun_temple_obelisk_first_enter_43ae0882:

