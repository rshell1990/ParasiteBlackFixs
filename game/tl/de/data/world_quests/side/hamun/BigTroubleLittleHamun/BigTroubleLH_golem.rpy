# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:444
translate de qst_BigTroubleLHamun_temple_dials_solved_d83e9b05:

    # "Upon the final dial clicking into place, the dials sank inward as they spun."
    "Als das letzte Zifferblatt an seinem Platz einrastete, versanken die Zifferblätter, während sie sich drehten."

# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:446
translate de qst_BigTroubleLHamun_temple_dials_solved_df29678d:

    # "Stone ground against stone, revealing a hidden compartment."
    "Stein rieb an Stein und enthüllte ein verstecktes Fach."

# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:447
translate de qst_BigTroubleLHamun_temple_dials_solved_0c475dc6:

