translate de qst_dreamhouse_l4_toys_menu_f5ca12d9:

    # "Picking up the one marked 'ILLUSION', a small key fell out from the back of it."
    "Als ich das mit 'ILLUSION' markierte aufhob, fiel ein kleiner Schlüssel aus seiner Rückseite."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1755
translate de qst_dreamhouse_l4_toys_menu_26255cc6:

    # MC "(Huh... This must be useful.)"
    MC "(Huch... Das muss nützlich sein.)"

