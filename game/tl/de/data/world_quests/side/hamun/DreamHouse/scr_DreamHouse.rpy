    "Ich griff nach dem nächstgelegenen Stuhl,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1195
translate de qst_dreamhouse_l3_granny_diningroom_6959b464:

    # "As the door burst open, I flung it towards her before fleeing!"
    "Als die Tür aufsprang, schleuderte ich es ihr entgegen, bevor ich floh!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1197
translate de qst_dreamhouse_l3_granny_diningroom_476cb8e0:

    # GRANNY_OH_DREARY "YOU CAN'T RUN FOREVER!"
    GRANNY_OH_DREARY "DU KANNST NICHT EWIG WEGLAUFEN!"

