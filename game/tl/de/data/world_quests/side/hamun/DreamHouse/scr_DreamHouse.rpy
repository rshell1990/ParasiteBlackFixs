    SERAFINA @ smile "Es ist in Ordnung... Vater."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2501
translate de qst_dreamhouse_final_housescene_b6d8e9f9:

    # SERAFINA @ smile "We did it, we sealed it away!"
    SERAFINA @ smile "Wir haben es geschafft, wir haben es versiegelt!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2502
translate de qst_dreamhouse_final_housescene_6c3e818e:

    # DAVIK "Thank the gods..."
    DAVIK "Den Göttern sei Dank..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2503
translate de qst_dreamhouse_final_housescene_cfd08e31:

    # "Davik turned towards me."
    "Davik drehte sich zu mir um."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2506
translate de qst_dreamhouse_final_housescene_33c95ccd:

    # DAVIK "You have my eternal thanks for helping save my daughter."
    DAVIK "Du hast meinen ewigen Dank für die Hilfe bei der Rettung meiner Tochter."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2509
translate de qst_dreamhouse_final_housescene_c7d70e1d:

    # DAVIK "Come, Serafina, let's go..."
    DAVIK "Komm, Serafina, lass uns gehen..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2510
translate de qst_dreamhouse_final_housescene_e9b40ebe:

    # MC @ think "Wait, hold for a moment."
    MC @ think "Warte, warte einen Moment."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2511
translate de qst_dreamhouse_final_housescene_3f368aa9:

    # MC @ talk "I've been ordered to bring Serafina back to her mother."
    MC @ talk "Mir wurde befohlen, Serafina zu ihrer Mutter zurückzubringen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2514
translate de qst_dreamhouse_final_housescene_3553ec16:

    # DAVIK "You must think me a fool to just hand her back over!"
    DAVIK "Du musst mich für einen Narren halten, sie einfach so zurückzugeben!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2515
translate de qst_dreamhouse_final_housescene_33a83dce:

    # DAVIK "Not after all these years!"
    DAVIK "Nicht nach all den Jahren!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2516
translate de qst_dreamhouse_final_housescene_f6b52ec0:

    # VIRGO "WAIT!"
    VIRGO "WARTET!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2517
translate de qst_dreamhouse_final_housescene_7d375837:

    # VIRGO "Both of you..."
    VIRGO "Ihr beide..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2520
translate de qst_dreamhouse_final_housescene_2e1f113b:

    # "Slowly, the dark mage rose back to his feet."
    "Langsam erhob sich der dunkle Magier wieder auf die Beine."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2521
translate de qst_dreamhouse_final_housescene_39f0c626:

    # VIRGO "Bring the girl back to her mothers and let me take the girl as an apprentice."
    VIRGO "Bring das Mädchen zurück zu ihren Müttern und lass mich das Mädchen als Lehrling nehmen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2522
translate de qst_dreamhouse_final_housescene_56420d6a:

    # DAVIK "ARE YOU INSANE?"
    DAVIK "BIST DU VERRÜCKT?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2523
translate de qst_dreamhouse_final_housescene_28cb88a0:

    # DAVIK "Your vile services were hired just to help me protect MY daughter!"
    DAVIK "Deine abscheulichen Dienste wurden nur angeheuert, um mir zu helfen, MEINE Tochter zu beschützen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2524
translate de qst_dreamhouse_final_housescene_d926361c:

    # DAVIK "I'm an inquisitor! You really think I'm going to let a fucking dark mage tutor her?"
    DAVIK "Ich bin ein Inquisitor! Glaubst du wirklich, ich lasse einen verdammten dunklen Magier sie unterrichten?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2525
translate de qst_dreamhouse_final_housescene_f101a247:

    # DAVIK "No! She will come back with me to Novaras. There, she will learn under the Inquisition."
    DAVIK "Nein! Sie wird mit mir nach Novaras zurückkommen. Dort wird sie unter der Inquisition lernen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2526
translate de qst_dreamhouse_final_housescene_442d1d68:

    # VIRGO "Don't be a fool!"
    VIRGO "Sei kein Narr!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2527
translate de qst_dreamhouse_final_housescene_bcb28e67:

    # VIRGO "The Inquisition will only leash her!"
    VIRGO "Die Inquisition wird sie nur an die Leine legen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2528
translate de qst_dreamhouse_final_housescene_56e4b672:

    # VIRGO "Her power is too valuable! With my help, she could learn to master it and turn the tide of this war!"
    VIRGO "Ihre Macht ist zu wertvoll! Mit meiner Hilfe könnte sie lernen, sie zu meistern und das Blatt dieses Krieges zu wenden!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2529
translate de qst_dreamhouse_final_housescene_f231572e:

    # SERAFINA @ shock "S-STOP FIGHTING!"
    SERAFINA @ shock "H-HÖRT AUF ZU KÄMPFEN!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2530
translate de qst_dreamhouse_final_housescene_2c9605f9:

    # SERAFINA @ sad "... You."
    SERAFINA @ sad "... Du."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2531
translate de qst_dreamhouse_final_housescene_3f9d9321:

    # "Serafina's gaze turns towards me."
    "Serafinas Blick wendet sich mir zu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2532
translate de qst_dreamhouse_final_housescene_3c96fcdf:

    # SERAFINA @ sad "What do you think I should do?"
    SERAFINA @ sad "Was denkst du, sollte ich tun?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2533
translate de qst_dreamhouse_final_housescene_53426c3f:

    # DAVIK "You can't seriously be—"
    DAVIK "Du kannst doch nicht ernsthaft—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2534
translate de qst_dreamhouse_final_housescene_417f4d9c:

    # SERAFINA @ talk "I saw him... {i}father.{/i}"
    SERAFINA @ talk "Ich sah ihn... {i}Vater.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2535
translate de qst_dreamhouse_final_housescene_580bfb09:

    # SERAFINA @ talk "In my dreams."
    SERAFINA @ talk "In meinen Träumen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2536
translate de qst_dreamhouse_final_housescene_5241ae73:

    # SERAFINA @ talk "I think he's the one to tell me which way to go!"
    SERAFINA @ talk "Ich glaube, er ist derjenige, der mir den Weg weist!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2537
translate de qst_dreamhouse_final_housescene_58544e5d:

    # VIRGO "... Interesting."
    VIRGO "... Interessant."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2538
translate de qst_dreamhouse_final_housescene_d5521272:

    # SERAFINA @ talk "So then... What do you think I should do?"
    SERAFINA @ talk "Also dann... Was denkst du, sollte ich tun?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2543
translate de qst_dreamhouse_final_housescene_706a2cac:

    # SERAFINA @ sad "If... If that is the path you think I should take."
    SERAFINA @ sad "Wenn... Wenn das der Weg ist, den du für richtig hältst."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2544
translate de qst_dreamhouse_final_housescene_2deb28e8:

    # SERAFINA @ talk "Father, I'll come with you."
    SERAFINA @ talk "Vater, ich komme mit dir."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2545
translate de qst_dreamhouse_final_housescene_91c9e242:

    # VIRGO "Damn fools."
    VIRGO "Verdammte Narren."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2546
translate de qst_dreamhouse_final_housescene_a3cb29c2:

    # VIRGO "You're wasting your potential with the Inquisition!"
    VIRGO "Du verschwendest dein Potenzial mit der Inquisition!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2547
translate de qst_dreamhouse_final_housescene_bd12dc3f:

    # VIRGO "They'll show you the ceiling, but never show you how to break through it!"
    VIRGO "Sie zeigen dir die Decke, aber nie, wie du sie durchbrechen kannst!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2548
translate de qst_dreamhouse_final_housescene_341ba180:

    # DAVIK "And that's fine with me!"
    DAVIK "Und das ist mir recht!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2549
translate de qst_dreamhouse_final_housescene_4c9801a7:

    # DAVIK "She's my daughter, not a damn weapon!"
    DAVIK "Sie ist meine Tochter, keine verdammte Waffe!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2550
translate de qst_dreamhouse_final_housescene_c53b35fd:

    # VIRGO "No... Now she's going to become something worse."
    VIRGO "Nein ... Jetzt wird sie zu etwas Schlimmerem."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2551
translate de qst_dreamhouse_final_housescene_d7f40314:

    # VIRGO "Just a puppet for the Inquisition."
    VIRGO "Nur eine Marionette für die Inquisition."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2552
translate de qst_dreamhouse_final_housescene_a355eb8e:

    # "Davik carefully took his daughter's hand."
    "Davik nahm vorsichtig die Hand seiner Tochter."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2553
translate de qst_dreamhouse_final_housescene_d65f64a0:

    # DAVIK "Come on, let's leave this place. We have a long journey ahead of us."
    DAVIK "Komm, lass uns diesen Ort verlassen. Wir haben eine lange Reise vor uns."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2556
translate de qst_dreamhouse_final_housescene_de24f820:

    # "Davik turned to me once more, nodding."
    "Davik wandte sich mir noch einmal zu und nickte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2557
translate de qst_dreamhouse_final_housescene_5ef15c38:

    # DAVIK "I promise you, I will repay this debt."
    DAVIK "Ich verspreche dir, ich werde diese Schuld zurückzahlen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2558
translate de qst_dreamhouse_final_housescene_24db7a4b:

    # VIRGO "Tschh...!"
    VIRGO "Tschh...!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2559
translate de qst_dreamhouse_final_housescene_91f28077:

    # SERAFINA @ shock "Wait! Father!"
    SERAFINA @ shock "Warte! Vater!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2562
translate de qst_dreamhouse_final_housescene_326b28e0:

    # SERAFINA @ talk "Before we go..."
    SERAFINA @ talk "Bevor wir gehen..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2565
translate de qst_dreamhouse_final_housescene_b77e439d:

    # VIRGO "Finally, someone making sense."
    VIRGO "Endlich mal jemand, der Vernunft zeigt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2566
translate de qst_dreamhouse_final_housescene_7220859e:

    # DAVIK "You cannot seriously expect me to just let you take—"
    DAVIK "Du kannst doch nicht ernsthaft erwarten, dass ich dich einfach nehmen lasse—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2567
translate de qst_dreamhouse_final_housescene_684132be:

    # "As he reached for the hilt of his blade, Serafina stepped in to stop him, grabbing at his hands."
    "Als er nach dem Knauf seiner Klinge griff, trat Serafina ein, um ihn aufzuhalten, und griff nach seinen Händen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2568
translate de qst_dreamhouse_final_housescene_e883d34b:

    # SERAFINA @ shock "Father! No!"
    SERAFINA @ shock "Vater! Nein!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2569
translate de qst_dreamhouse_final_housescene_274b4ace:

    # DAVIK "Serafina, I—"
    DAVIK "Serafina, ich—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2570
translate de qst_dreamhouse_final_housescene_05f887e3:

    # SERAFINA @ sad "He's right, father."
    SERAFINA @ sad "Er hat Recht, Vater."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2571
translate de qst_dreamhouse_final_housescene_686c395b:

    # SERAFINA @ sad "This power... If I can wield it better, I can do some good."
    SERAFINA @ sad "Diese Macht... Wenn ich sie besser einsetzen kann, kann ich etwas Gutes bewirken."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2572
translate de qst_dreamhouse_final_housescene_3993813b:

    # DAVIK "You cannot trust a dark mage, Serafina!"
    DAVIK "Du kannst einem dunklen Magier nicht vertrauen, Serafina!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2573
translate de qst_dreamhouse_final_housescene_5771ca4f:

    # DAVIK "If you walk this path... I... I don't know if I can—"
    DAVIK "Wenn du diesen Weg gehst ... Ich ... ich weiß nicht, ob ich—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2574
translate de qst_dreamhouse_final_housescene_dce16f76:

    # SERAFINA @ sad "Father... {i}I have to do this.{/i}"
    SERAFINA @ sad "Vater ... {i}Ich muss das tun.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2575
translate de qst_dreamhouse_final_housescene_edebb3fa:

    # SERAFINA @ sad "I have to try."
    SERAFINA @ sad "Ich muss es versuchen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2576
translate de qst_dreamhouse_final_housescene_ace00135:

    # DAVIK "..."
    DAVIK "..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2579
translate de qst_dreamhouse_final_housescene_cfd08e31_1:

    # "Davik turned towards me."
    "Davik drehte sich zu mir um."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2580
translate de qst_dreamhouse_final_housescene_d3329b40:

    # DAVIK "I won't forgive you for this."
    DAVIK "Ich werde dir das nicht verzeihen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2583
translate de qst_dreamhouse_final_housescene_504123c6:

    # VIRGO "Come, Serafina."
    VIRGO "Komm, Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2584
translate de qst_dreamhouse_final_housescene_9cc00ff6:

    # VIRGO "Let us take you home."
    VIRGO "Lass uns dich nach Hause bringen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2585
translate de qst_dreamhouse_final_housescene_505899f4:

    # SERAFINA @ talk "Wait!"
    SERAFINA @ talk "Warte!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2587
translate de qst_dreamhouse_final_housescene_e7afb7c7:

    # SERAFINA @ sad "... In my dreams, I saw {i}things.{/i}"
    SERAFINA @ sad "... In meinen Träumen sah ich {i}Dinge.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2588
translate de qst_dreamhouse_final_housescene_ede36390:

    # MC @ think "Things?"
    MC @ think "Dinge?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2589
translate de qst_dreamhouse_final_housescene_2ee42113:

    # SERAFINA @ sad "I saw you on a throne with a blood-stained crown."
    SERAFINA @ sad "Ich sah dich auf einem Thron mit einer blutbefleckten Krone."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2590
translate de qst_dreamhouse_final_housescene_5d618e6e:

    # SERAFINA @ sad "Amidst a battlefield, skulls at your feet."
    SERAFINA @ sad "Inmitten eines Schlachtfelds, Schädel zu deinen Füßen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2591
translate de qst_dreamhouse_final_housescene_4eb7a167:

    # SERAFINA @ sad "... And a dozen knives in your back."
    SERAFINA @ sad "... und ein Dutzend Messer in deinem Rücken."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2592
translate de qst_dreamhouse_final_housescene_522cf4e9:

    # MC @ surprised "I..."
    MC @ surprised "Ich..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2593
translate de qst_dreamhouse_final_housescene_f90ffdfa:

    # SERAFINA @ sad "I wish you well in what's to come."
    SERAFINA @ sad "Ich wünsche dir alles Gute für das, was kommt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2594
translate de qst_dreamhouse_final_housescene_14fadba7:

    # SERAFINA @ sad "... I think you're going to need it."
    SERAFINA @ sad "... Ich glaube, du wirst es brauchen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2595
translate de qst_dreamhouse_final_housescene_e7a4c5bd:

    # MC @ serious "Your dreams then, they can show you the future?"
    MC @ serious "Deine Träume also, sie können dir die Zukunft zeigen?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2596
translate de qst_dreamhouse_final_housescene_3a0a209c:

    # SERAFINA @ sad "No... More like something that can be."
    SERAFINA @ sad "Nein... Eher wie etwas, das sein kann."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2597
translate de qst_dreamhouse_final_housescene_abcfa321:

    # "She lowered her head."
    "Sie senkte den Kopf."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2598
translate de qst_dreamhouse_final_housescene_e57c9609:

    # SERAFINA @ sad "I'm sorry I can't help you more,"
    SERAFINA @ sad "Es tut mir leid, dass ich dir nicht mehr helfen kann,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2599
translate de qst_dreamhouse_final_housescene_dc6508fc:

    # SERAFINA @ sad "but while we are here..."
    SERAFINA @ sad "aber während wir hier sind..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2600
translate de qst_dreamhouse_final_housescene_2c790cbd:

    # "Closing her eyes, Serafina waved her hand towards us."
    "Sie schloss die Augen und winkte uns zu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2601
translate de qst_dreamhouse_final_housescene_556de380:

    # SERAFINA @ talk "{i}I can dream you and your friends are better.{/i}"
    SERAFINA @ talk "{i}Ich kann träumen, dass es dir und deinen Freunden besser geht.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2606
translate de qst_dreamhouse_final_housescene_29d4805e:

    # MC @ surprised "That was..."
    MC @ surprised "Das war..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2607
translate de qst_dreamhouse_final_housescene_ab56e9d7:

    # SERAFINA @ talk "Before I go."
    SERAFINA @ talk "Bevor ich gehe."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2608
translate de qst_dreamhouse_final_housescene_ece9d172:

    # SERAFINA @ smile "What is your name?"
    SERAFINA @ smile "Wie heißt du?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2609
translate de qst_dreamhouse_final_housescene_26aa9e2a:

    # MC @ smile "[player_name]."
    MC @ smile "[player_name]."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2610
translate de qst_dreamhouse_final_housescene_fc79dc84:

    # "Serafina smiles warmly."
    "Serafina lächelt warm."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2611
translate de qst_dreamhouse_final_housescene_24f43961:

    # SERAFINA @ smile "Then I look forward to seeing you again soon, [player_name]."
    SERAFINA @ smile "Dann freue ich mich darauf, dich bald wiederzusehen, [player_name]."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2613
translate de qst_dreamhouse_final_housescene_27ae9ddc:

    # "With that, Serafina snapped her fingers, and there was a bright flash."
    "Daraufhin schnippte Serafina mit den Fingern, und es gab einen hellen Blitz."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2623
translate de qst_dreamhouse_final_housescene_7e250470:

    # MC @ surprised "I... Where are—"
    MC @ surprised "Ich... Wo sind—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2626
translate de qst_dreamhouse_final_housescene_d80294f0:

    # MARKUS @ smile "Oh, thank the gods we made it out of that place!"
    MARKUS @ smile "Oh, den Göttern sei Dank, dass wir es aus diesem Ort geschafft haben!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2628
translate de qst_dreamhouse_final_housescene_49b2b098:

    # KIARA @ smile "Air... Sunlight... Warmth!"
    KIARA @ smile "Luft... Sonnenlicht... Wärme!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2630
translate de qst_dreamhouse_final_housescene_e01bdb19:

    # "Sypha pointed towards something."
    "Sypha zeigte auf etwas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2631
translate de qst_dreamhouse_final_housescene_28eaf8ce:

    # SYPHA @ think "Is that not the wagon that the shop woman was looking for?"
    SYPHA @ think "Ist das nicht der Wagen, den die Händlerin gesucht hat?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2632
translate de qst_dreamhouse_final_housescene_a66f3e45:

    # "I turned to follow her finger, and indeed, now placed as though it had always been there, a wagon and two horses."
    "Ich folgte ihrem Finger mit dem Blick, und tatsächlich, jetzt standen dort, als wären sie schon immer da gewesen, ein Wagen und zwei Pferde."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2633
translate de qst_dreamhouse_final_housescene_96697eea:

    # MC @ smile "I think it is."
    MC @ smile "Ich glaube schon."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2637
translate de qst_dreamhouse_final_housescene_45a632e3:

    # VES @ think "How did it get here?"
    VES @ think "Wie ist er hierher gekommen?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2638
translate de qst_dreamhouse_final_housescene_bcc3ced6:

    # MARKUS @ smile "Don't know, don't care!"
    MARKUS @ smile "Weiß nicht, ist mir egal!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2639
translate de qst_dreamhouse_final_housescene_e8c91bb4:

    # MARKUS @ smile "First bit of luck we've had since taking on this wretched job!"
    MARKUS @ smile "Das erste bisschen Glück, das wir seit der Übernahme dieses elenden Jobs hatten!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2645
translate de qst_dreamhouse_final_housescene_4c520ce9:

    # MC @ talk "Well, at least this makes the journey back easier."
    MC @ talk "Nun, zumindest erleichtert das die Rückreise."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2647
translate de qst_dreamhouse_final_housescene_1a041c15:

    # MC "(I just hope Serafina and the others are alright.)"
    MC "(Ich hoffe nur, dass Serafina und die anderen in Ordnung sind.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2648
translate de qst_dreamhouse_final_housescene_ec62b857:

    # MC @ serious "(What she said about her dream with me...)"
    MC @ serious "(Was sie über ihren Traum mit mir gesagt hat...)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2649
translate de qst_dreamhouse_final_housescene_1c2daed2:

    # MC @ serious "(Surely that was just some trickery, right?)"
    MC @ serious "(Das war doch sicher nur eine List, oder?)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2650
translate de qst_dreamhouse_final_housescene_143c5545:

    # MC @ smile "(Me... A crown? A throne? I mean, it's not possible, I don't—)"
    MC @ smile "(Ich... Eine Krone? Ein Thron? Ich meine, es ist nicht möglich, ich—)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2652
translate de qst_dreamhouse_final_housescene_cd2a9d8d:

    # MARKUS "Stop standing there and smirking to yourself and get in!"
    MARKUS "Hör auf, da zu stehen und selbstgefällig zu grinsen, und steig ein!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2653
translate de qst_dreamhouse_final_housescene_8047a9c0:

    # MC @ talk "Oh, right...!"
    MC @ talk "Oh, richtig...!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2665
translate de qst_dreamhouse_final_housescene_77a5914f:

    # "... The ride back was long,"
    "... Die Rückfahrt war lang,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2666
translate de qst_dreamhouse_final_housescene_e3c21322:

    # "but certainly quicker than how we had travelled before."
    "aber sicherlich schneller als unsere vorherige Reise."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2667
translate de qst_dreamhouse_final_housescene_2d453ab3:

    # "When we arrived upon Hamun, I returned the wagon to Katiya."
    "Als wir in Hamun ankamen, gab ich den Wagen an Katiya zurück."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2673
translate de qst_dreamhouse_final_housescene_23927e6e:

    # KATIYA @ happy "You're alive!"
    KATIYA @ happy "Du lebst!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2674
translate de qst_dreamhouse_final_housescene_427f3ee1:

    # KATIYA @ talk "I mean, uh... Well done!"
    KATIYA @ talk "Ich meine, äh... Gut gemacht!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2678
translate de qst_dreamhouse_final_housescene_369d5f6d:

    # KATIYA @ think "And my man, is he..."
    KATIYA @ think "Und mein Mann, ist er..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2679
translate de qst_dreamhouse_final_housescene_07d8606a:

    # MC @ sad "I'm sorry, we didn't find him."
    MC @ sad "Es tut mir leid, wir haben ihn nicht gefunden."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2680
translate de qst_dreamhouse_final_housescene_779acb85:

    # KATIYA @ sad "I see..."
    KATIYA @ sad "Ich verstehe..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2681
translate de qst_dreamhouse_final_housescene_93691235:

    # KATIYA @ sad "Well, all our fates are in the hands of the gods in the end."
    KATIYA @ sad "Nun, letztendlich liegen alle unsere Schicksale in den Händen der Götter."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2682
translate de qst_dreamhouse_final_housescene_f8c47ef7:

    # KATIYA @ sad "Perhaps he just got lucky and..."
    KATIYA @ sad "Vielleicht hatte er einfach Glück und..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2683
translate de qst_dreamhouse_final_housescene_666e0eda:

    # "She doesn't finish the sentence."
    "Sie beendet den Satz nicht."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2684
translate de qst_dreamhouse_final_housescene_61f0ad3e:

    # KATIYA @ talk "Anyway, I won't keep you."
    KATIYA @ talk "Jedenfalls, ich werde dich nicht aufhalten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2685
translate de qst_dreamhouse_final_housescene_48ec5d3a:

    # KATIYA @ talk "Come by the shop anytime if you need anything."
    KATIYA @ talk "Komm jederzeit im Laden vorbei, wenn du etwas brauchst."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2686
translate de qst_dreamhouse_final_housescene_0b7947b7:

    # MC @ smile "Will do, Katiya."
    MC @ smile "Mach ich, Katiya."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2690
translate de qst_dreamhouse_final_housescene_7235b76e:

    # MC "(Now to report back to the Faymore women and conclude this business at last.)"
    MC "(Nun melde ich mich bei den Faymore-Frauen zurück und schließe diese Angelegenheit endlich ab.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2697
translate de qst_dreamhouse_return_after_rescue_ce6ca9f7:

    # "DEBUG: set serafina decision to? currently set to '[QstDreamhouse().SerafOutcome]'"
    "DEBUG: set serafina decision to? currently set to '[QstDreamhouse().SerafOutcome]'"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2703
translate de qst_dreamhouse_return_after_rescue_73a1c60d:

