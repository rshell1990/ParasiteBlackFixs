    "DEBUG: set reward chosen to? currently set to '[QstDreamhouse().ChosenReward]' (0 == ass 1 == coin)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2718
translate de qst_dreamhouse_conclusion_serafina_father_ed5b7a7a:

    # "No sooner had I entered the estate's walls than I was beset by a furious Chanyi and a tearful Anya."
    "Kaum hatte ich die Mauern des Anwesens betreten, wurde ich von einer wütenden Chanyi und einer weinenden Anya überfallen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2722
translate de qst_dreamhouse_conclusion_serafina_father_c0fe1dc4:

    # CHANYI @ angry "WHERE IS SHE?"
    CHANYI @ angry "WO IST SIE?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2723
translate de qst_dreamhouse_conclusion_serafina_father_12e894c8:

    # CHANYI @ angry "WHERE IS OUR DAUGHTER?"
    CHANYI @ angry "WO IST UNSERE TOCHTER?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2724
translate de qst_dreamhouse_conclusion_serafina_father_2e4978d6:

    # ANYA @ sad "Serafina wrote us a letter. She said she is safe but is heading to Novaras with her father!"
    ANYA @ sad "Serafina hat uns einen Brief geschrieben. Sie sagte, sie sei in Sicherheit, aber sie sei mit ihrem Vater auf dem Weg nach Novaras!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2725
translate de qst_dreamhouse_conclusion_serafina_father_2f62b8e9:

    # MC @ talk "Your daughter is safe."
    MC @ talk "Eure Tochter ist in Sicherheit."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2726
translate de qst_dreamhouse_conclusion_serafina_father_5f9e5376:

    # MC @ talk "But she is with her father to learn how to—"
    MC @ talk "Aber sie ist bei ihrem Vater, um zu lernen, wie man—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2727
translate de qst_dreamhouse_conclusion_serafina_father_37ad2343:

    # "Anya burst into tears, covering her face with her hands."
    "Anya brach in Tränen aus und bedeckte ihr Gesicht mit den Händen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2729
translate de qst_dreamhouse_conclusion_serafina_father_06e1034f:

    # ANYA @ sad "No!"
    ANYA @ sad "Nein!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2731
translate de qst_dreamhouse_conclusion_serafina_father_e7d871d8:

    # CHANYI @ angry "You idiot! You were supposed to bring her back to us!"
    CHANYI @ angry "Du Idiot! Du solltest sie zu uns zurückbringen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2735
translate de qst_dreamhouse_conclusion_serafina_father_328fc3ae:

    # CHANYI @ angry "FUCK THE INQUISITION!"
    CHANYI @ angry "SCHEISS AUF DIE INQUISITION!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2736
translate de qst_dreamhouse_conclusion_serafina_father_09829f3d:

    # CHANYI @ angry "Damn you! It wasn't your choice to make!"
    CHANYI @ angry "Verdammt! Das war nicht deine Entscheidung!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2737
translate de qst_dreamhouse_conclusion_serafina_father_e7da20b9:

    # ANYA @ sad "Chanyi... I..."
    ANYA @ sad "Chanyi... Ich..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2738
translate de qst_dreamhouse_conclusion_serafina_father_23a61086:

    # ANYA @ sad "Maybe it's for the best."
    ANYA @ sad "Vielleicht ist es das Beste."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2739
translate de qst_dreamhouse_conclusion_serafina_father_2b5ddd82:

    # CHANYI @ shock "What?!"
    CHANYI @ shock "Was?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2740
translate de qst_dreamhouse_conclusion_serafina_father_9f79da27:

    # ANYA @ sad "Serafina... She needs... She needs people who can help her, who can—"
    ANYA @ sad "Serafina... Sie braucht... Sie braucht Leute, die ihr helfen können, die können—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2741
translate de qst_dreamhouse_conclusion_serafina_father_99b75564:

    # CHANYI @ angry "It wasn't his choice to make!"
    CHANYI @ angry "Es war nicht seine Entscheidung zu treffen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2745
translate de qst_dreamhouse_conclusion_serafina_father_00599a34:

    # CHANYI @ angry "What was best for her was bringing her back to US!"
    CHANYI @ angry "Das Beste für sie war, sie zu UNS zurückzubringen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2746
translate de qst_dreamhouse_conclusion_serafina_father_d42bf7c2:

    # CHANYI @ angry "Her fucking father is an inquisitor!"
    CHANYI @ angry "Ihr verdammter Vater ist ein Inquisitor!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2747
translate de qst_dreamhouse_conclusion_serafina_father_9b82ec0a:

    # CHANYI @ angry "What if they just decide she's too dangerous to keep alive, hmm?"
    CHANYI @ angry "Was, wenn sie einfach entscheiden, dass sie zu gefährlich ist, um am Leben zu bleiben, hmm?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2748
translate de qst_dreamhouse_conclusion_serafina_father_f6632a9b:

    # CHANYI @ angry "Or that her powers are tainted by dark magecraft?"
    CHANYI @ angry "Oder dass ihre Kräfte durch dunkle Magierkunst verdorben sind?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2750
translate de qst_dreamhouse_conclusion_serafina_father_edb464fc:

    # CHANYI @ angry "WHAT THEN, HMM?"
    CHANYI @ angry "WAS DANN, HMM?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2751
translate de qst_dreamhouse_conclusion_serafina_father_be3d8041:

    # ANYA @ sad "Chanyi... Please... Please stop."
    ANYA @ sad "Chanyi... Bitte... Bitte hör auf."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2754
translate de qst_dreamhouse_conclusion_serafina_father_dba22c89:

    # MC @ sad "I'm sorry, but if you saw what I saw..."
    MC @ sad "Es tut mir leid, aber wenn du gesehen hättest, was ich gesehen habe..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2755
translate de qst_dreamhouse_conclusion_serafina_father_b3b7bba7:

    # MC @ sad "you'd understand why her powers need guidance and—"
    MC @ sad "würdest du verstehen, warum ihre Kräfte Führung brauchen und—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2757
translate de qst_dreamhouse_conclusion_serafina_father_e8f8e2a2:

    # CHANYI @ angry "Get out, GET OUT!"
    CHANYI @ angry "Verschwinde, VERSCHWINDE!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2758
translate de qst_dreamhouse_conclusion_serafina_father_0a0dece0:

    # CHANYI @ angry "FUCKING LEAVE US!"
    CHANYI @ angry "VERDAMMT NOCH MAL, LASST UNS IN RUHE!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2759
translate de qst_dreamhouse_conclusion_serafina_father_e74343d2:

    # "Grabbing a half bag of coins, Chanyi flung it towards me angrily."
    "Chanyi schnappte sich einen halben Beutel Münzen und warf ihn wütend in meine Richtung."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2760
translate de qst_dreamhouse_conclusion_serafina_father_e00aed57:

    # CHANYI @ angry "Half pay for half a fucking job!"
    CHANYI @ angry "Halbe Bezahlung für einen halben Job, verdammt!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2767
translate de qst_dreamhouse_conclusion_serafina_father_f67e5017:

    # MC @ sad "... That could have gone better."
    MC @ sad "... Das hätte besser laufen können."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2769
translate de qst_dreamhouse_conclusion_serafina_father_f8d932a1:

    # KIARA @ sad "Did you really expect any other reaction from them?"
    KIARA @ sad "Hast du wirklich eine andere Reaktion von ihnen erwartet?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2770
translate de qst_dreamhouse_conclusion_serafina_father_86d91e81:

    # MC @ think "So you think I chose wrong?"
    MC @ think "Also denkst du, ich habe mich falsch entschieden?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2771
translate de qst_dreamhouse_conclusion_serafina_father_3e37dc95:

    # KIARA @ sad "No, just... I don't think they'd ever see it that way."
    KIARA @ sad "Nein, nur... Ich glaube nicht, dass sie es jemals so sehen würden."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2773
translate de qst_dreamhouse_conclusion_serafina_father_f560d240:

    # MARKUS @ talk "You made the right call... They mean well, but..."
    MARKUS @ talk "Du hast die richtige Entscheidung getroffen... Sie meinen es gut, aber..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2774
translate de qst_dreamhouse_conclusion_serafina_father_d45fc904:

    # MARKUS @ talk "If she doesn't learn to control that power and get a grip on it, she could become too dangerous."
    MARKUS @ talk "Wenn sie nicht lernt, diese Kraft zu kontrollieren und sie in den Griff zu bekommen, könnte sie zu gefährlich werden."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2777
translate de qst_dreamhouse_conclusion_serafina_father_9215089c:

    # SYPHA @ sad "With your inquisitors, she may now never fully know what she was capable of."
    SYPHA @ sad "Mit deinen Inquisitoren wird sie vielleicht nie vollständig erfahren, wozu sie fähig war."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2778
translate de qst_dreamhouse_conclusion_serafina_father_0ad7945a:

    # SYPHA @ sad "How... sad."
    SYPHA @ sad "Wie... traurig."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2779
translate de qst_dreamhouse_conclusion_serafina_father_197454c8:

    # MC @ think "Do you really think another dark mage is what this world needs?"
    MC @ think "Glaubst du wirklich, dass ein weiterer dunkler Magier das ist, was diese Welt braucht?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2780
translate de qst_dreamhouse_conclusion_serafina_father_04f63e19:

    # SYPHA @ talk "Are you so sure it doesn't?"
    SYPHA @ talk "Bist du dir da so sicher?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2783
translate de qst_dreamhouse_conclusion_serafina_father_216065cb:

    # VES @ talk "She's a strong girl."
    VES @ talk "Sie ist ein starkes Mädchen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2784
translate de qst_dreamhouse_conclusion_serafina_father_a1a240d6:

    # VES @ smile "I believe whatever path she walks, she will be alright."
    VES @ smile "Ich glaube, welchen Weg sie auch einschlägt, es wird ihr gut gehen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2796
translate de qst_dreamhouse_conclusion_serafina_virgo_45227697:

    # "Upon entry, the two Faymore women stood beside Serafina, but their eyes were firmly locked onto the dark mage beside her, explaining everything."
    "Beim Eintreten standen die beiden Faymore-Frauen neben Serafina, aber ihre Augen waren fest auf den dunklen Magier neben ihr gerichtet, was alles erklärte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2797
translate de qst_dreamhouse_conclusion_serafina_virgo_7e0c1a59:

    # VIRGO "So you see, that is why it is imperative you allow me to continue her—"
    VIRGO "Also, siehst du, deshalb ist es zwingend notwendig, dass du mir erlaubst, sie weiterhin zu —"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2799
translate de qst_dreamhouse_conclusion_serafina_virgo_bda4c517:

    # SERAFINA @ smile "[player_name]!"
    SERAFINA @ smile "[player_name]!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2800
translate de qst_dreamhouse_conclusion_serafina_virgo_8688d268:

    # MC @ smile "Serafina."
    MC @ smile "Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2801
translate de qst_dreamhouse_conclusion_serafina_virgo_ed77b680:

    # CHANYI @ talk "This... mage here was explaining everything that has happened."
    CHANYI @ talk "Dieser... Magier hier hat alles erklärt, was passiert ist."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2803
translate de qst_dreamhouse_conclusion_serafina_virgo_5ede04a0:

    # ANYA @ happy "Thank you, thank you, thank you, thank you!"
    ANYA @ happy "Danke, danke, danke, danke!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2804
translate de qst_dreamhouse_conclusion_serafina_virgo_16e34a54:

    # ANYA @ happy "You've brought our daughter home!"
    ANYA @ happy "Du hast unsere Tochter nach Hause gebracht!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2805
translate de qst_dreamhouse_conclusion_serafina_virgo_d22bb5ed:

    # "Chanyi smiled as well, but she seemed more... reserved and unsure."
    "Chanyi lächelte ebenfalls, aber sie wirkte eher... zurückhaltend und unsicher."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2806
translate de qst_dreamhouse_conclusion_serafina_virgo_483c07bc:

    # CHANYI @ serious "So just to be clear, you wish to stay here and tutor our daughter, yes?"
    CHANYI @ serious "Also nur um klarzustellen, du möchtest hierbleiben und unsere Tochter unterrichten, ja?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2807
translate de qst_dreamhouse_conclusion_serafina_virgo_d0e7e352:

    # VIRGO "Yes."
    VIRGO "Ja."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2808
translate de qst_dreamhouse_conclusion_serafina_virgo_09d74b6f:

    # CHANYI @ serious "And you are..."
    CHANYI @ serious "Und du bist..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2809
translate de qst_dreamhouse_conclusion_serafina_virgo_ea9d704a:

    # "She paused for a moment."
    "Sie hielt einen Moment inne."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2810
translate de qst_dreamhouse_conclusion_serafina_virgo_8ece934a:

    # CHANYI @ serious "A dark mage, yes?"
    CHANYI @ serious "Ein dunkler Magier, ja?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2811
translate de qst_dreamhouse_conclusion_serafina_virgo_4db1a38d:

    # VIRGO "... Yes."
    VIRGO "... Ja."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2812
translate de qst_dreamhouse_conclusion_serafina_virgo_5a4b0412:

    # "There was a long, awkward pause."
    "Es gab eine lange, unangenehme Pause."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2813
translate de qst_dreamhouse_conclusion_serafina_virgo_b482beec:

    # CHANYI @ serious "You can see why this might make us worried, right?"
    CHANYI @ serious "Sie können verstehen, warum uns das Sorgen bereiten könnte, nicht wahr?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2814
translate de qst_dreamhouse_conclusion_serafina_virgo_ce0e1768:

    # VIRGO "I do."
    VIRGO "Das tue ich."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2815
translate de qst_dreamhouse_conclusion_serafina_virgo_a6226ffc:

    # SERAFINA @ talk "Mothers, I promise you."
    SERAFINA @ talk "Mütter, ich verspreche es euch."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2816
translate de qst_dreamhouse_conclusion_serafina_virgo_1783b98a:

    # SERAFINA @ talk "Virgo is a good man, he's just... {i}different.{/i}"
    SERAFINA @ talk "Virgo ist ein guter Mann, er ist nur... {i}anders.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2817
translate de qst_dreamhouse_conclusion_serafina_virgo_feb57514:

    # "The mage didn't shift an inch."
    "Der Magier rührte sich keinen Zentimeter."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2818
translate de qst_dreamhouse_conclusion_serafina_virgo_bf5ee927:

    # "Chanyi stared, but didn't answer."
    "Chanyi starrte, antwortete aber nicht."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2819
translate de qst_dreamhouse_conclusion_serafina_virgo_a9047292:

    # "Anya, though, clapped her hands together and smiled."
    "Anya jedoch klatschte in die Hände und lächelte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2820
translate de qst_dreamhouse_conclusion_serafina_virgo_4085dc85:

    # ANYA @ happy "We shall have a guest room made up for you."
    ANYA @ happy "Wir werden ein Gästezimmer für Sie herrichten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2821
translate de qst_dreamhouse_conclusion_serafina_virgo_6d5c0c3a:

    # "The mage offered a curt bow."
    "Der Magier deutete eine knappe Verbeugung an."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2822
translate de qst_dreamhouse_conclusion_serafina_virgo_38f3a53f:

    # VIRGO "You honor me."
    VIRGO "Sie beehren mich."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2823
translate de qst_dreamhouse_conclusion_serafina_virgo_d5030ccf:

    # CHANYI @ serious "... We will discuss later what you plan to teach our daughter."
    CHANYI @ serious "... Wir werden später besprechen, was du unserer Tochter beibringen willst."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2824
translate de qst_dreamhouse_conclusion_serafina_virgo_600a89f8:

    # CHANYI @ serious "{i}And boundaries.{/i}"
    CHANYI @ serious "{i}Und Grenzen.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2825
translate de qst_dreamhouse_conclusion_serafina_virgo_fd17dd74:

    # SERAFINA @ shock "Mother!"
    SERAFINA @ shock "Mutter!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2826
translate de qst_dreamhouse_conclusion_serafina_virgo_d62fdfb9:

    # CHANYI @ serious "This is for the best, Serafina."
    CHANYI @ serious "Das ist zu deinem Besten, Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2827
translate de qst_dreamhouse_conclusion_serafina_virgo_6a7145ed:

    # ANYA @ sad "Chanyi is right, Sera, we have to keep you safe, and this is still—"
    ANYA @ sad "Chanyi hat recht, Sera, wir müssen dich beschützen, und das ist immer noch—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2828
translate de qst_dreamhouse_conclusion_serafina_virgo_e0f5d574:

    # VIRGO "It is only fair you are concerned for your daughter's wellbeing."
    VIRGO "Es ist nur fair, dass du um das Wohlergehen deiner Tochter besorgt bist."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2829
translate de qst_dreamhouse_conclusion_serafina_virgo_f1a7a6e5:

    # VIRGO "I can assure you, I do not seek to harm her."
    VIRGO "Ich kann dir versichern, ich will ihr nicht schaden."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2830
translate de qst_dreamhouse_conclusion_serafina_virgo_dc8cd6cd:

    # VIRGO "{i}... Only to study and learn more myself of her great power.{/i}"
    VIRGO "{i}... Nur um selbst ihre große Macht zu studieren und mehr darüber zu lernen.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2831
translate de qst_dreamhouse_conclusion_serafina_virgo_081cc627:

    # "For some reason, that answer hadn't quite sat right with me."
    "Aus irgendeinem Grund hatte diese Antwort für mich nicht ganz gestimmt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2832
translate de qst_dreamhouse_conclusion_serafina_virgo_97d47faf:

    # "But... all mages pursue knowledge of magecraft."
    "Aber... alle Magier streben nach Wissen über die Magiekunst."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2833
translate de qst_dreamhouse_conclusion_serafina_virgo_b462fac7:

    # "Especially dark mages."
    "Besonders dunkle Magier."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2834
translate de qst_dreamhouse_conclusion_serafina_virgo_b0a3443c:

    # SERAFINA @ smile "I'm pretty tired, so I might lay down for a while to rest."
    SERAFINA @ smile "Ich bin ziemlich müde, also werde ich mich vielleicht eine Weile hinlegen, um mich auszuruhen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2835
translate de qst_dreamhouse_conclusion_serafina_virgo_4dcfd2a9:

    # VIRGO "We will begin training soon, young mistress."
    VIRGO "Wir werden bald mit dem Training beginnen, junge Herrin."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2836
translate de qst_dreamhouse_conclusion_serafina_virgo_23b65982:

    # SERAFINA @ think "You know I hate it when you call me that..."
    SERAFINA @ think "Du weißt, ich hasse es, wenn du mich so nennst..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2837
translate de qst_dreamhouse_conclusion_serafina_virgo_674fa142:

    # VIRGO "Yes... Serafina."
    VIRGO "Ja... Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2840
translate de qst_dreamhouse_conclusion_serafina_virgo_c7b21bdd:

    # "Serafina returned to her quarters as Virgo was escorted away by one of the servants."
    "Serafina kehrte in ihre Gemächer zurück, während Virgo von einem der Diener weggeführt wurde."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2842
translate de qst_dreamhouse_conclusion_serafina_virgo_5c48df66:

    # CHANYI @ think "Well... I can't say I don't have mixed feelings on the outcome."
    CHANYI @ think "Nun... Ich kann nicht sagen, dass ich keine gemischten Gefühle bezüglich des Ergebnisses habe."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2843
translate de qst_dreamhouse_conclusion_serafina_virgo_7db27c31:

    # ANYA @ happy "Our daughter is back, Chanyi, that's all that matters."
    ANYA @ happy "Unsere Tochter ist zurück, Chanyi, das ist alles, was zählt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2844
translate de qst_dreamhouse_conclusion_serafina_virgo_13e9b148:

    # CHANYI @ laugh "{i}*Sigh*{/i} I suppose it is."
    CHANYI @ laugh "{i}*Seufz*{/i} Ich nehme an, das ist es."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2845
translate de qst_dreamhouse_conclusion_serafina_virgo_aa6e1e19:

    # CHANYI @ laugh "Now then..."
    CHANYI @ laugh "Nun denn..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2846
translate de qst_dreamhouse_conclusion_serafina_virgo_02cfb407:

    # "Chanyi raised a brow."
    "Chanyi hob eine Augenbraue."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2847
translate de qst_dreamhouse_conclusion_serafina_virgo_c967f3fd:

    # CHANYI @ laugh "Let us discuss your reward."
    CHANYI @ laugh "Lassen Sie uns über Ihre Belohnung sprechen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2849
translate de qst_dreamhouse_conclusion_serafina_virgo_76a64a87:

    # ANYA @ happy "Here, please, take it."
    ANYA @ happy "Hier, bitte, nehmen Sie es."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2852
translate de qst_dreamhouse_conclusion_serafina_virgo_753aa434:

    # CHANYI @ laugh "And we mentioned something a little more {i}special{/i} than just coin, didn't we?"
    CHANYI @ laugh "Und wir erwähnten etwas ein wenig {i}Besonderes{/i} als nur Münzen, nicht wahr?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2853
translate de qst_dreamhouse_conclusion_serafina_virgo_44e6d2a9:

    # "With a snap of her fingers, servants entered the room with some of the most beautiful armor I had ever seen, radiating a soft magecraft."
    "Mit einem Fingerschnippen betraten Diener den Raum mit einer der schönsten Rüstungen, die ich je gesehen hatte, die eine sanfte Magie ausstrahlte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2854
translate de qst_dreamhouse_conclusion_serafina_virgo_c622ff1c:

    # MC @ surprised "What is this?"
    MC @ surprised "Was ist das?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2855
translate de qst_dreamhouse_conclusion_serafina_virgo_5db94aec:

    # ANYA @ happy "Armor worn by my great, great grandfather."
    ANYA @ happy "Rüstung, die von meinem Ururgroßvater getragen wurde."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2856
translate de qst_dreamhouse_conclusion_serafina_virgo_9b81e36f:

    # ANYA @ happy "Strigon Faymore."
    ANYA @ happy "Strigon Faymore."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2857
translate de qst_dreamhouse_conclusion_serafina_virgo_2484da8b:

    # ANYA @ happy "One of the greatest knights of his age."
    ANYA @ happy "Einer der größten Ritter seiner Zeit."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2858
translate de qst_dreamhouse_conclusion_serafina_virgo_4a13d053:

    # ANYA @ happy "For generations, we have done our best to maintain his armor."
    ANYA @ happy "Seit Generationen haben wir unser Bestes getan, seine Rüstung zu erhalten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2859
translate de qst_dreamhouse_conclusion_serafina_virgo_6af9c22b:

    # ANYA @ talk "And now... we gift it to you."
    ANYA @ talk "Und jetzt... schenken wir es dir."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2862
translate de qst_dreamhouse_conclusion_serafina_virgo_75a4cd2b:

    # CHANYI @ talk "And with that, our business is concluded."
    CHANYI @ talk "Und damit ist unser Geschäft abgeschlossen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2863
translate de qst_dreamhouse_conclusion_serafina_virgo_96f28379:

    # CHANYI @ talk "Do come by from time to time, I do believe Serafina would appreciate it."
    CHANYI @ talk "Komm doch ab und zu vorbei, ich glaube, Serafina würde es zu schätzen wissen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2864
translate de qst_dreamhouse_conclusion_serafina_virgo_b57311bf:

    # CHANYI @ serious "... And it might help keep that dark mage in line."
    CHANYI @ serious "... Und es könnte helfen, diesen dunklen Magier im Zaum zu halten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2866
translate de qst_dreamhouse_conclusion_serafina_virgo_6174399d:

    # "The two women shared a knowing look at each other, Anya's cheeks flushed red as she bit at her lower lip."
    "Die beiden Frauen warfen sich einen wissenden Blick zu, Anyas Wangen erröteten, als sie sich auf die Unterlippe biss."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2867
translate de qst_dreamhouse_conclusion_serafina_virgo_6e685004:

    # "Chanyi's tail swished back and forth seductively as she grinned."
    "Chanyis Schwanz wedelte aufreizend hin und her, während sie grinste."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2868
translate de qst_dreamhouse_conclusion_serafina_virgo_2a1755a5:

    # CHANYI @ talk "Come back tomorrow evening."
    CHANYI @ talk "Komm morgen Abend wieder."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2869
translate de qst_dreamhouse_conclusion_serafina_virgo_bb53172d:

    # CHANYI @ laugh "{i}We'll be waiting.{/i}"
    CHANYI @ laugh "{i}Wir werden warten.{/i}"

