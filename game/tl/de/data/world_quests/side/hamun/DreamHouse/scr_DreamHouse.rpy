translate de qst_dreamhouse_l3_granny_kitchen_7cc40527:

    # "I crawled beneath the kitchen table and waited, hoping the monstrous figure would simply pass on by."
    "Ich kroch unter den Küchentisch und wartete, in der Hoffnung, dass die monströse Gestalt einfach vorbeigehen würde."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1214
translate de qst_dreamhouse_l3_granny_kitchen_76c47b00:

    # "The kitchen door swung open, shears snapping violently and tormentingly as she walked,"
    "Die Küchentür schwang auf, die Scheren schnappten gewaltsam und quälend zu, während sie ging,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1215
translate de qst_dreamhouse_l3_granny_kitchen_86895518:

    # GRANNY_OH_DREARY "There's no need to run!"
    GRANNY_OH_DREARY "Es gibt keinen Grund wegzulaufen!"

