translate de qst_dreamhouse_final_housescene_7a3da93b:

    # "what I thought was supposed to be the master bedroom."
    "was ich für das Hauptschlafzimmer hielt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2417
translate de qst_dreamhouse_final_housescene_bdc04444:

    # "Looking behind me, I could see everyone was back—dazed and confused, perhaps—but... alive and present."
    "Als ich mich umdrehte, sah ich, dass alle zurück waren – benommen und verwirrt vielleicht – aber... lebendig und anwesend."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2424
translate de qst_dreamhouse_final_housescene_8c5e33ae:

    # "A blonde girl turned to face me as I entered. Stood stoically behind her, an elderly mage watched."
    "Ein blondes Mädchen drehte sich zu mir um, als ich eintrat. Stoisch hinter ihr stand ein älterer Magier und beobachtete."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2425
translate de qst_dreamhouse_final_housescene_6a42290d:

    # VIRGO "Ah, good, you made it through."
    VIRGO "Ah, gut, du hast es geschafft."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2426
translate de qst_dreamhouse_final_housescene_0ba9a927:

    # SERAFINA @ shock "You..."
    SERAFINA @ shock "Du..."

