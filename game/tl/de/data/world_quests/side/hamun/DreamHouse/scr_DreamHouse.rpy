    # "It says it wants to be free."
    "Es sagt, es will frei sein."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2037
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_fa9c241b:

    # "That my mind is a prison."
    "Dass mein Geist ein Gefängnis ist."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2038
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_2b614b72:

    # "... It... It's just another nightmare."
    "... Es... Es ist nur ein weiterer Albtraum."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2039
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_9979a58c:

    # "Right?"
    "Oder?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2043
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_2938cfcc:

    # "{i}He said no.{/i}"
    "{i}Er sagte nein.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2045
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_9f2a8d42:

    # "The book suddenly burst into flames in my hands!"
    "Das Buch ging plötzlich in meinen Händen in Flammen auf!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2046
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_dbff601d:

    # MC @ surprised "FUCK!"
    MC @ surprised "VERDAMMT!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2049
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_8210fe36:

    # "Mother has just told me her friend, the lady with the cat tail, is now also my mommy."
    "Mutter hat mir gerade gesagt, dass ihre Freundin, die Dame mit dem Katzenschwanz, jetzt auch meine Mama ist."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2050
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_be1e4a83:

    # "She seems nice, but maybe a little strict."
    "Sie scheint nett zu sein, aber vielleicht ein bisschen streng."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2051
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_103805ec:

    # "... But I don't think I need another mother."
    "... Aber ich glaube nicht, dass ich eine weitere Mutter brauche."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2052
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_cda5af69:

    # "I just really miss father."
    "Ich vermisse Vater einfach wirklich sehr."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2055
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_f05f2d15:

    # "I see father less and less."
    "Ich sehe Vater immer weniger."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2056
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_99c2275b:

    # "It's been months now."
    "Es sind jetzt Monate."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2057
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_e03bcff2:

    # "... Maybe he's just never coming back?"
    "... Vielleicht kommt er einfach nie wieder?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2058
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_382f2858:

    # "Mother is talking about us leaving and heading to live in a place far away."
    "Mutter spricht davon, dass wir wegziehen und an einem weit entfernten Ort leben werden."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2059
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_a0bb76e0:

    # "If that happens, will father still visit?"
    "Wenn das passiert, wird Vater uns dann noch besuchen?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2060
translate de qst_dreamhouse_l4_library_bookshelf_1_menu_11402407:

    # "{i}... Does he still love me?{/i}"
    "{i}... Liebt er mich noch?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2071
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_99cef191:

    # "A man tried to kidnap me tonight. Thankfully, our guards managed to stop him."
    "Ein Mann hat heute Nacht versucht, mich zu entführen. Zum Glück konnten unsere Wachen ihn aufhalten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2072
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_5db348b5:

    # "My mothers are terrified, but..."
    "Meine Mütter sind verängstigt, aber..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2073
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_514db6e3:

    # "I'm more frightened about what I might dream happens tonight."
    "Ich habe mehr Angst davor, was ich heute Nacht träumen könnte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2074
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_ca0a8285:

    # "... Between the pages, a green skull key fell out."
    "... Zwischen den Seiten fiel ein grüner Totenkopfschlüssel heraus."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2078
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_5ac5c20e:

    # "I wish I had more actual friends."
    "Ich wünschte, ich hätte mehr echte Freunde."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2079
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_a1157de1:

    # "I mean, the people at the academy are fine,"
    "Ich meine, die Leute an der Akademie sind ja ganz nett,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2080
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_e5f52d0d:

    # "but it's all cliques and coin and..."
    "aber es geht nur um Cliquen und Geld und..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2081
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_fa990cff:

    # "No one is friends with anyone, really. It's all just strategic alignments."
    "Niemand ist wirklich mit jemandem befreundet. Es sind alles nur strategische Allianzen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2082
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_9b223944:

    # "... Fuck, I just wish someone was real for once."
    "... Verdammt, ich wünschte, jemand wäre auch mal echt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2085
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_d47f9121:

    # "Father returned with a strange man."
    "Vater kehrte mit einem seltsamen Mann zurück."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2086
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_c3456a70:

    # "He said the two of them were going to help me get rid of the nightmares once and for all."
    "Er sagte, sie beide würden mir helfen, die Albträume ein für alle Mal loszuwerden."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2087
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_4ef80800:

    # "Father... You still remembered me!"
    "Vater ... Du hast dich noch an mich erinnert!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2090
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_b537a0dd:

    # "I had a strange dream tonight. A man, handsome with black hair."
    "Ich hatte heute Nacht einen seltsamen Traum. Ein Mann, gutaussehend mit schwarzen Haaren."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2091
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_d64178bc:

    # "But he wasn't fully human. Inside of him... there was another soul."
    "Aber er war nicht ganz menschlich. In ihm ... war eine andere Seele."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2092
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_1b253a90:

    # "He swore he would save me, but it's so strange..."
    "Er schwor, er würde mich retten, aber es ist so seltsam..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2093
translate de qst_dreamhouse_l4_library_bookshelf_2_menu_7b0b2236:

    # "I've never even seen this man before in my life?"
    "Diesen Mann habe ich noch nie in meinem Leben gesehen?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2101
translate de qst_dreamhouse_l4_library_portrait_8ffbc82d:

    # "Why would anyone paint this?"
    "Warum sollte jemand das malen?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2121
translate de qst_dreamhouse_l5_start_352f5d88:

    # "As we pushed on once more through the bright light, we found ourselves again in the entrance hallway of the house,"
    "Als wir erneut durch das helle Licht vordrangen, befanden wir uns wieder im Eingangsflur des Hauses,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2122
translate de qst_dreamhouse_l5_start_5122da77:

    # "only to face a brand new horror..."
    "nur um einem brandneuen Schrecken gegenüberzustehen..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2123
translate de qst_dreamhouse_l5_start_b10dd20e:

    # MARKUS @ scared "The house is flooded!"
    MARKUS @ scared "Das Haus ist überflutet!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2127
translate de qst_dreamhouse_l5_start_486c0433:

    # SYPHA @ angry "Urgh... This better not ruin my clothes!"
    SYPHA @ angry "Urgh... Das ruiniert hoffentlich nicht meine Kleidung!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2130
translate de qst_dreamhouse_l5_start_062c2bf8:

    # VES @ talk "How much more of this damn house is there?!"
    VES @ talk "Wie viel mehr von diesem verdammten Haus gibt es noch?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2132
translate de qst_dreamhouse_l5_start_17f2980a:

    # KIARA @ sad "Brrr! This water's so cold!"
    KIARA @ sad "Brrr! Dieses Wasser ist so kalt!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2134
translate de qst_dreamhouse_l5_start_7f9a289d:

    # KIARA @ sad "I can't see a damn thing beneath it!"
    KIARA @ sad "Ich kann verdammt nochmal nichts darunter sehen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2138
translate de qst_dreamhouse_l5_start_65d8894b:

    # "Hearing something splash, I quickly turned my attention toward it."
    "Als ich ein Platschen hörte, lenkte ich schnell meine Aufmerksamkeit darauf."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2140
translate de qst_dreamhouse_l5_start_90d542c5:

    # MC @ serious "What was that?"
    MC @ serious "Was war das?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2142
translate de qst_dreamhouse_l5_start_65e22635:

    # SYPHA @ talk "I don't know, but the last thing we should do is wait around and find out..."
    SYPHA @ talk "Ich weiß es nicht, aber das Letzte, was wir tun sollten, ist hier herumzuwarten und es herauszufinden..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2149
translate de qst_dreamhouse_l5_bathtub_f1bb8145:

    # "It's completely rotten away and covered in mold."
    "Es ist völlig verrottet und mit Schimmel bedeckt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2153
translate de qst_dreamhouse_l5_mirror_46c2824e:

    # "It's caked in so much dirt, I can't see anything reflected."
    "Es ist so mit Schmutz verkrustet, dass ich nichts Spiegelndes sehen kann."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2159
translate de qst_dreamhouse_l5_upstairs_to_hallway2_13142b1a:

    # MC "(Locked...)"
    MC "(Verschlossen...)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2164
translate de qst_dreamhouse_l5_upstairs_to_hallway2_5b5c4c81:

    # MC "(That does it.)"
    MC "(Das reicht.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2173
translate de qst_dreamhouse_l5_toys_c3af8770:

    # "The toys are completely ruined by the damp..."
    "Die Spielsachen sind durch die Nässe völlig ruiniert..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2178
translate de qst_dreamhouse_l5_crib_d13de5d6:

    # "The crib is damp and covered in mold. The wood is completely rotten."
    "Das Kinderbett ist feucht und mit Schimmel bedeckt. Das Holz ist völlig verrottet."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2179
translate de qst_dreamhouse_l5_crib_291f0001:

    # "There is a key inside."
    "Darin befindet sich ein Schlüssel."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2185
translate de qst_dreamhouse_l5_bedroom_door_aeb91391:

    # MC "(It's locked.)"
    MC "(Es ist verschlossen.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2186
translate de qst_dreamhouse_l5_bedroom_door_0560ff66:

    # MC "(I need a key...)"
    MC "(Ich brauche einen Schlüssel...)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2191
translate de qst_dreamhouse_l5_bedroom_door_827f0e2a:

    # MC "(There...)"
    MC "(Dort...)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2201
translate de qst_dreamhouse_l5_candle_9e5e67e3:

    # MC @ think "(A purple flame now...)"
    MC @ think "(Jetzt eine violette Flamme...)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2208
translate de qst_dreamhouse_l5_table_a88f00bd:

    # "(The table is completely rotten and overrun with mold and vines.)"
    "(Der Tisch ist völlig verfault und von Schimmel und Ranken überwuchert.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2212
translate de qst_dreamhouse_l5_head_531289b1:

    # "(The mounted head of a lizard, eroded and filthy.)"
    "(Der präparierte Kopf einer Eidechse, verwittert und schmutzig.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2216
translate de qst_dreamhouse_l5_portrait_b6db3355:

    # "A portrait of a derelict house in swamp land."
    "Ein Porträt eines verwahrlosten Hauses im Sumpfland."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2224
translate de qst_dreamhouse_l5_kitchen_cupboards_397be328:

    # "Completely empty and rotten."
    "Völlig leer und verfault."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2228
translate de qst_dreamhouse_l5_kitchen_pot_18209317:

    # MC "(The fire is out. There's nothing in the pot other than black, pungent water.)"
    MC "(Das Feuer ist aus. Im Topf ist nichts außer schwarzem, stechendem Wasser.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2234
translate de qst_dreamhouse_l5_kitchen_to_cellar_13142b1a:

    # MC "(Locked...)"
    MC "(Verschlossen...)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2239
translate de qst_dreamhouse_l5_kitchen_to_cellar_5b5c4c81:

    # MC "(That does it.)"
    MC "(Das reicht.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2246
translate de qst_dreamhouse_l5_cellar_barrel_535a074c:

    # "There's nothing left..."
    "Es ist nichts mehr übrig..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2251
translate de qst_dreamhouse_l5_cellar_paper_7a9d7dbc:

    # "There... carefully placed in the center of the desk, a purple skull key."
    "Da... sorgfältig platziert in der Mitte des Schreibtisches, ein violetter Schädelschlüssel."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2260
translate de qst_dreamhouse_l5_library_fireplace_699ae0c6:

    # "The fire is out and completely soaked."
    "Das Feuer ist aus und völlig durchnässt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2261
translate de qst_dreamhouse_l5_library_fireplace_70a8c622:

    # "There though, hidden beneath a wet, rotten log, is a key with a lizard-shaped head."
    "Dort jedoch, versteckt unter einem nassen, morschen Baumstamm, ist ein Schlüssel mit einem echsenförmigen Kopf."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2267
translate de qst_dreamhouse_l5_library_bookshelf_1_187f9b50:

    # "The books are all soaking wet and destroyed."
    "Die Bücher sind alle durchnässt und zerstört."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2272
translate de qst_dreamhouse_l5_library_bookshelf_2_be2c8e3d:

    # "The pages are completely illegible."
    "Die Seiten sind vollkommen unleserlich."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2273
translate de qst_dreamhouse_l5_library_bookshelf_2_bacadf70:

    # "A book literally rots away in my hand as I try to pick it up."
    "Ein Buch verrottet buchstäblich in meiner Hand, als ich versuche, es aufzuheben."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2278
translate de qst_dreamhouse_l5_library_portrait_2280a906:

    # "... Creepy."
    "... Gruselig."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2305
translate de qst_dreamhouse_l5_gator_counter_e1669797:

    # "Suddenly, erupting from the water, a terrible, lizard-like creature snapping its jaws blocked our path!"
    "Plötzlich brach aus dem Wasser ein schreckliches, echsenartiges Wesen hervor, schnappte mit seinen Kiefern und versperrte uns den Weg!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2307
translate de qst_dreamhouse_l5_gator_counter_1049c4ec:

    # MC @ angry "Shit!"
    MC @ angry "Scheiße!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2323
translate de qst_dreamhouse_l5_gator_counter_0d42adda:

    # KIARA @ scared "What in the world is that thing?!"
    KIARA @ scared "Was um alles in der Welt ist das für ein Ding?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2324
translate de qst_dreamhouse_l5_gator_counter_295a28bc:

    # KIARA @ talk "Phew... That was close, he almost-"
    KIARA @ talk "Puh... Das war knapp, er hätte fast-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2325
translate de qst_dreamhouse_l5_gator_counter_827b9835:

    # "The creature suddenly lunged forward, grabbing hold of Kiara as it dragged her down towards the black water."
    "Die Kreatur stürzte plötzlich vorwärts, packte Kiara und zog sie hinunter zum schwarzen Wasser."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2327
translate de qst_dreamhouse_l5_gator_counter_e813cad7:

    # KIARA "AHHHHH!"
    KIARA "AHHHHH!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2332
translate de qst_dreamhouse_l5_gator_counter_090deb00:

    # MC @ surprised "KIARA!"
    MC @ surprised "KIARA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2333
translate de qst_dreamhouse_l5_gator_counter_5cbd19a1:

    # "The creature dived."
    "Die Kreatur tauchte ab."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2335
translate de qst_dreamhouse_l5_gator_counter_cd964f7d:

    # "It moved quickly, its scaled tail swaying through the black water for a moment before it dipped beneath the darkness."
    "Sie bewegte sich schnell, ihr geschuppter Schwanz schwankte einen Moment durch das schwarze Wasser, bevor sie in der Dunkelheit untertauchte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2337
translate de qst_dreamhouse_l5_gator_counter_490feea7:

    # MC @ surprised "KIARA! CAN YOU HEAR ME? KIARA!"
    MC @ surprised "KIARA! KANNST DU MICH HÖREN? KIARA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2338
translate de qst_dreamhouse_l5_gator_counter_26ac48a8:

    # MC "(Damn it!)"
    MC "(Verdammt!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2344
translate de qst_dreamhouse_l5_gator_counter_5b6981da:

    # "Ves wrestled with the creature as it snarled and hissed."
    "Ves rang mit der Kreatur, während sie knurrte und fauchte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2346
translate de qst_dreamhouse_l5_gator_counter_3817f6a6:

    # VES @ angry "BACK YOU BEAST! I SAID-"
    VES @ angry "ZURÜCK, DU BESTIE! ICH SAGTE-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2347
translate de qst_dreamhouse_l5_gator_counter_1fc4e2f6:

    # "With a swipe of its tail, it tripped Ves to the floor."
    "Mit einem Hieb seines Schwanzes brachte es Ves zu Fall."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2350
translate de qst_dreamhouse_l5_gator_counter_6137c806:

    # "She gasped, as the creature grabbed at her leg and began to pull her away with tremendous speed and power!"
    "Sie keuchte, als die Kreatur nach ihrem Bein griff und begann, sie mit ungeheurer Geschwindigkeit und Kraft wegzuziehen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2352
translate de qst_dreamhouse_l5_gator_counter_a384740f:

    # MC @ surprised "VES!"
    MC @ surprised "VES!"

