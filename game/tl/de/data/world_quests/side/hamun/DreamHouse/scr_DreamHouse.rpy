# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:679
translate de qst_dreamhouse_l1_study_desk_d8dcbcd3:

    # "As I grabbed the red skull key, I heard a sharp scream."
    "Als ich den roten Schädelschlüssel griff, hörte ich einen scharfen Schrei."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:681
translate de qst_dreamhouse_l1_study_desk_bc4ea560:

    # MC @ surprised "Upstairs!"
    MC @ surprised "Oben!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:693
translate de qst_dreamhouse_l2_start_77e9e664:

    # MC @ surprised "... What the f-"
    MC @ surprised "... Was zum T-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:703
translate de qst_dreamhouse_l2_start_9865fb96:

    # MARKUS @ scared "How in the hells did we end up back down here?!"
    MARKUS @ scared "Wie zum Teufel sind wir wieder hier unten gelandet?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:706
translate de qst_dreamhouse_l2_start_eae3cdc8:

    # KIARA @ scared "Uhh... Does this place look..."
    KIARA @ scared "Ähh... Sieht dieser Ort..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:707
translate de qst_dreamhouse_l2_start_00107977:

    # KIARA @ scared "{i}Different?{/i}"
    KIARA @ scared "{i}Anders aus?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:708
translate de qst_dreamhouse_l2_start_cd543de7:

    # "As I looked around, I realized Kiara was indeed right."
    "Als ich mich umsah, wurde mir klar, dass Kiara tatsächlich recht hatte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:710
translate de qst_dreamhouse_l2_start_39e3975c:

    # "The house had become an even more twisted version of itself, now drenched in blood, with tombstones littered around the place as a light fog swept through."
    "Das Haus war zu einer noch verdrehteren Version seiner selbst geworden, nun blutgetränkt, mit überall verstreuten Grabsteinen, während ein leichter Nebel durchzog."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:711
translate de qst_dreamhouse_l2_start_81bf3e55:

    # "The house itself seemed to breathe, when suddenly, wounded and stumbling through the corridor towards us..."
    "Das Haus selbst schien zu atmen, als plötzlich, verwundet und durch den Korridor auf uns zustolpernd..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:712
translate de qst_dreamhouse_l2_start_0c6c5de5:

    # "... An inquisitor?"
    "... Ein Inquisitor?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:714
translate de qst_dreamhouse_l2_start_5a2f5fba:

    # UNKNOWN "Who the fuck are you?!"
    UNKNOWN "Wer zum Teufel bist du?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:715
translate de qst_dreamhouse_l2_start_cb46b19f:

    # UNKNOWN "Help me! QUICKLY!"
    UNKNOWN "Hilf mir! SCHNELL!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:716
translate de qst_dreamhouse_l2_start_d2876313:

    # "Before I could answer him, hurling itself around the corner, came a horde of walking corpses."
    "Bevor ich ihm antworten konnte, stürzte sich eine Horde wandelnder Leichen um die Ecke."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:719
translate de qst_dreamhouse_l2_start_a2f921c8:

    # "I barely had time to reach for my sword before they were upon us!"
    "Ich hatte kaum Zeit, mein Schwert zu ziehen, bevor sie über uns herfielen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:721
translate de qst_dreamhouse_l2_start_637933df:

    # "Slaying the last of the creatures with a clean swipe to sever its head, I turned towards inquisitor."
    "Mit einem sauberen Hieb, der ihm den Kopf abschlug, tötete ich die letzte Kreatur und wandte mich dem Inquisitor zu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:727
translate de qst_dreamhouse_l2_start_ef2310fb:

    # MC @ serious "What in the hells is this?"
    MC @ serious "Was zum Teufel ist das?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:728
translate de qst_dreamhouse_l2_start_0189c0ba:

    # UNKNOWN "Ahhh! Damn things tore right through my armour..."
    UNKNOWN "Ahhh! Diese verdammten Dinger haben sich direkt durch meine Rüstung gerissen..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:729
translate de qst_dreamhouse_l2_start_5c2fec4a:

    # UNKNOWN "My name is Davik."
    UNKNOWN "Mein Name ist Davik."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:730
translate de qst_dreamhouse_l2_start_5f66bb5c:

    # DAVIK "Who sent you? You people shouldn't be here!"
    DAVIK "Wer hat euch geschickt? Ihr solltet nicht hier sein!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:731
translate de qst_dreamhouse_l2_start_7252ef9f:

    # MC @ talk "I was sent by the Faymore Estate to bring back their daughter."
    MC @ talk "Ich wurde vom Faymore-Anwesen geschickt, um ihre Tochter zurückzubringen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:732
translate de qst_dreamhouse_l2_start_206ba41c:

    # DAVIK "{i}*Sigh*{/i} Of fucking course you were."
    DAVIK "{i}*Seufz*{/i} Natürlich warst du das, verdammt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:733
translate de qst_dreamhouse_l2_start_0d13c2c9:

    # DAVIK "Well, you're trapped here now, same as everyone who enters this place."
    DAVIK "Nun, du bist jetzt hier gefangen, genau wie jeder, der diesen Ort betritt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:734
translate de qst_dreamhouse_l2_start_35dc42b6:

    # MC @ serious "Start giving me some answers."
    MC @ serious "Fang an, mir Antworten zu geben."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:735
translate de qst_dreamhouse_l2_start_c4c51bc0:

    # MC @ think "What the fuck is going on?"
    MC @ think "Was zum Teufel geht hier vor?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:736
translate de qst_dreamhouse_l2_start_fd640b80:

    # DAVIK "This place... She made it all."
    DAVIK "Dieser Ort... Sie hat das alles erschaffen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:737
translate de qst_dreamhouse_l2_start_c9b24c7b:

    # DAVIK "She conjured it up in her dream."
    DAVIK "Sie hat es in ihrem Traum heraufbeschworen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:738
translate de qst_dreamhouse_l2_start_8370e8af:

    # DAVIK "It was supposed to contain all her nightmares and set her free, but..."
    DAVIK "Es sollte all ihre Albträume enthalten und sie befreien, aber..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:739
translate de qst_dreamhouse_l2_start_b6aaa31d:

    # DAVIK "The house hungers, it's taking a life of its own."
    DAVIK "Das Haus hungert, es entwickelt ein Eigenleben."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:740
translate de qst_dreamhouse_l2_start_9cce26fd:

    # MC @ surprised "{i}This house... came from her dreams?{/i}"
    MC @ surprised "{i}Dieses Haus... stammt aus ihren Träumen?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:741
translate de qst_dreamhouse_l2_start_e4e07003:

    # DAVIK "Yes..."
    DAVIK "Ja..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:744
translate de qst_dreamhouse_l2_start_menu_f48bc021:

    # DAVIK "I... Only a few hours!"
    DAVIK "Ich... Nur ein paar Stunden!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:745
translate de qst_dreamhouse_l2_start_menu_f40870e9:

    # MC @ think "Davik... It's been over a month since the disappearance."
    MC @ think "Davik... Es ist über einen Monat seit dem Verschwinden her."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:746
translate de qst_dreamhouse_l2_start_menu_ae25cb01:

    # DAVIK "I... No."
    DAVIK "Ich... Nein."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:747
translate de qst_dreamhouse_l2_start_menu_b530f543:

    # DAVIK "This house is... It's messing with me!"
    DAVIK "Dieses Haus... Es spielt verrückt mit mir!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:750
translate de qst_dreamhouse_l2_start_menu_cd19d76d:

    # DAVIK "Dead."
    DAVIK "Tot."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:751
translate de qst_dreamhouse_l2_start_menu_b6258352:

    # DAVIK "I've been running from room to room, nightmare to nightmare, trying to reach Serafina."
    DAVIK "Ich bin von Zimmer zu Zimmer, von Albtraum zu Albtraum gerannt und habe versucht, Serafina zu erreichen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:752
translate de qst_dreamhouse_l2_start_menu_81ac1bae:

    # DAVIK "My men, one by one, have been picked off by... {i}things.{/i}"
    DAVIK "Meine Männer wurden einer nach dem anderen von... {i}Dingen{/i} erledigt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:753
translate de qst_dreamhouse_l2_start_menu_1488c923:

    # DAVIK "Trust me, the walking dead is the least of your worries."
    DAVIK "Vertrau mir, die wandelnden Toten sind deine geringste Sorge."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:756
translate de qst_dreamhouse_l2_start_menu_124e6aae:

    # DAVIK "Nightmares made flesh."
    DAVIK "Zu Fleisch gewordene Albträume."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:757
translate de qst_dreamhouse_l2_start_menu_35bc71c1:

    # DAVIK "Whatever it is, the house is responding to one of Serafina's fears."
    DAVIK "Was auch immer es ist, das Haus reagiert auf eine von Serafinas Ängsten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:762
translate de qst_dreamhouse_l2_start_menu_fdfafa9a:

    # DAVIK "I had no choice!"
    DAVIK "Ich hatte keine Wahl!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:763
translate de qst_dreamhouse_l2_start_menu_715e6591:

    # DAVIK "Once I confirmed how dangerous her powers had become, I knew I had to find a way to help her contain them!"
    DAVIK "Als ich bestätigt hatte, wie gefährlich ihre Kräfte geworden waren, wusste ich, dass ich einen Weg finden musste, um ihr zu helfen, sie zu bändigen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:764
translate de qst_dreamhouse_l2_start_menu_40021d59:

    # DAVIK "{i}... Else my brothers and sisters would treat her as something too dangerous to live.{/i}"
    DAVIK "{i}... Sonst würden meine Brüder und Schwestern sie als zu gefährlich zum Leben ansehen.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:765
translate de qst_dreamhouse_l2_start_menu_a12cdbf1:

    # MC @ think "So you found a dark mage?"
    MC @ think "Also hast du einen Dunkelmagier gefunden?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:766
translate de qst_dreamhouse_l2_start_menu_92b1c15d:

    # DAVIK "How did you-"
    DAVIK "Wie hast du-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:767
translate de qst_dreamhouse_l2_start_menu_93e278f0:

    # DAVIK "{i}*Sigh*{/i} Yes, a man named Virgo."
    DAVIK "{i}*Seufz*{/i} Ja, ein Mann namens Virgo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:768
translate de qst_dreamhouse_l2_start_menu_1ce3dafb:

    # DAVIK "He promised to help me contain her powers. In return, I set him free."
    DAVIK "Er versprach, mir zu helfen, ihre Kräfte zu bändigen. Im Gegenzug ließ ich ihn frei."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:769
translate de qst_dreamhouse_l2_start_menu_a622a66c:

    # MARKUS @ shock "Are you mad?"
    MARKUS @ shock "Bist du verrückt?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:770
translate de qst_dreamhouse_l2_start_menu_de4f638e:

    # MARKUS @ angry "YOU... An inquisitor set a dark mage free!"
    MARKUS @ angry "DU... Ein Inquisitor hat einen Dunkelmagier freigelassen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:771
translate de qst_dreamhouse_l2_start_menu_fdfafa9a_1:

    # DAVIK "I had no choice!"
    DAVIK "Ich hatte keine Wahl!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:772
translate de qst_dreamhouse_l2_start_menu_eca32403:

    # DAVIK "Virgo might be mad, but he's at least more reasonable than the rest."
    DAVIK "Virgo mag verrückt sein, aber er ist zumindest vernünftiger als die anderen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:773
translate de qst_dreamhouse_l2_start_menu_ae18ced1:

    # DAVIK "He told us the ritual would at least take a day."
    DAVIK "Er sagte uns, das Ritual würde mindestens einen Tag dauern."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:774
translate de qst_dreamhouse_l2_start_menu_340b03a0:

    # DAVIK "This house, he helped her channel her dream to forge it."
    DAVIK "Dieses Haus, er half ihr, ihren Traum zu kanalisieren, um es zu formen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:775
translate de qst_dreamhouse_l2_start_menu_4080b336:

    # DAVIK "It was supposed to be a prison for her nightmares, but it's..."
    DAVIK "Es sollte ein Gefängnis für ihre Albträume sein, aber es ist..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:776
translate de qst_dreamhouse_l2_start_menu_1b051032:

    # "There was a loud crash, the sounds of groaning as the dead banged on the windows from outside."
    "Es gab einen lauten Krach, das Stöhnen der Toten, die von draußen an die Fenster hämmerten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:777
translate de qst_dreamhouse_l2_start_menu_59e4ce8f:

    # DAVIK "Damn it!"
    DAVIK "Verdammt!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:778
translate de qst_dreamhouse_l2_start_menu_db576fef:

    # DAVIK "Find the keys, do you hear me?"
    DAVIK "Finde die Schlüssel, hörst du mich?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:779
translate de qst_dreamhouse_l2_start_menu_164ad445:

    # DAVIK "Serafina and Virgo are at the core of this nightmare!"
    DAVIK "Serafina und Virgo sind im Kern dieses Albtraums!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:780
translate de qst_dreamhouse_l2_start_menu_fe86acf9:

    # DAVIK "Each key through the master bedroom will take you one layer closer!"
    DAVIK "Jeder Schlüssel durch das Hauptschlafzimmer bringt dich eine Schicht näher!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:783
translate de qst_dreamhouse_l2_start_menu_2a477ca6:

    # MC @ surprised "Wait! Where are you going?"
    MC @ surprised "Warte! Wohin gehst du?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:784
translate de qst_dreamhouse_l2_start_menu_68507330:

    # DAVIK "We're not on the same layer right now, not really!"
    DAVIK "Wir sind gerade nicht auf derselben Ebene, nicht wirklich!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:785
translate de qst_dreamhouse_l2_start_menu_0c900b16:

    # DAVIK "The key I need to find isn't the same as yours!"
    DAVIK "Der Schlüssel, den ich finden muss, ist nicht derselbe wie deiner!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:786
translate de qst_dreamhouse_l2_start_menu_cd345043:

    # DAVIK "Go, hurry!"
    DAVIK "Los, beeil dich!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:787
translate de qst_dreamhouse_l2_start_menu_933bc08f:

    # DAVIK "I will meet you at the center!"
    DAVIK "Ich treffe dich in der Mitte!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:788
translate de qst_dreamhouse_l2_start_menu_732a35ab:

    # DAVIK "Then we can get my daughter out of this!"
    DAVIK "Dann können wir meine Tochter da rausholen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:791
translate de qst_dreamhouse_l2_start_menu_162cd578:

    # MC @ surprised "Wait! Hold on a min-"
    MC @ surprised "Warte! Moment mal-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:792
translate de qst_dreamhouse_l2_start_menu_d1ed37c2:

    # "Davik hurried as quickly as he could around a corner, slightly limping as he did so."
    "Davik eilte so schnell er konnte um eine Ecke, dabei leicht humpelnd."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:794
translate de qst_dreamhouse_l2_start_menu_b047e486:

    # "I tried to stop him, but as he exited through one of the doors, it slammed shut behind him."
    "Ich versuchte, ihn aufzuhalten, aber als er durch eine der Türen ging, schlug sie hinter ihm zu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:795
translate de qst_dreamhouse_l2_start_menu_70252298:

    # "Markus hurried over to try and rip the door open, only to find it bolted shut."
    "Markus eilte herbei, um zu versuchen, die Tür aufzureißen, nur um festzustellen, dass sie verriegelt war."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:799
translate de qst_dreamhouse_l2_start_menu_8fcd722f:

    # MARKUS @ angry "It's locked!"
    MARKUS @ angry "Es ist abgeschlossen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:801
translate de qst_dreamhouse_l2_start_menu_1049c4ec:

    # MC @ angry "Shit!"
    MC @ angry "Scheiße!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:802
translate de qst_dreamhouse_l2_start_menu_90df1efb:

    # MC @ think "The key has to be somewhere here... We just need to find it."
    MC @ think "Der Schlüssel muss hier irgendwo sein... Wir müssen ihn nur finden."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:803
translate de qst_dreamhouse_l2_start_menu_e1c93801:

    # KIARA @ scared "Sure... As long as we don't get eaten first."
    KIARA @ scared "Klar... Solange wir nicht zuerst gefressen werden."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:808
translate de qst_dreamhouse_l2_bathtub_39e9d55f:

    # "Looks like a mercenary... Maybe one of Davik's men?"
    "Sieht aus wie ein Söldner... Vielleicht einer von Daviks Männern?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:809
translate de qst_dreamhouse_l2_bathtub_e44e84bf:

    # "I noticed something shimmer in the mixed blood water of the bath."
    "Ich bemerkte etwas, das im blutvermischten Wasser des Bades schimmerte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:812
translate de qst_dreamhouse_l2_bathtub_427359f5:

    # "Shoving my hand into the bloody water, I pulled out a small, dull key."
    "Ich steckte meine Hand in das blutige Wasser und zog einen kleinen, stumpfen Schlüssel heraus."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:815
translate de qst_dreamhouse_l2_bathtub_854dd011:

    # KIARA @ scared "I think I might be sick..."
    KIARA @ scared "Ich glaube, mir wird übel..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:818
translate de qst_dreamhouse_l2_bathtub_dd99af82:

    # "(No way am I putting my hand in that.)"
    "(Auf keinen Fall stecke ich meine Hand da rein.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:823
translate de qst_dreamhouse_l2_mirror_665c1b26:

    # "Looks like there was a struggle in here."
    "Sieht so aus, als hätte es hier einen Kampf gegeben."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:830
translate de qst_dreamhouse_l2_bathroom_oneoff_ca772e26:

    # "Entering the bathroom, a man lay dead in the tub, half-eaten as a strange specter appeared to be laping up his blood."
    "Beim Betreten des Badezimmers lag ein Mann tot in der Badewanne, halb aufgefressen, während ein seltsamer Geist sein Blut zu lecken schien."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:831
translate de qst_dreamhouse_l2_bathroom_oneoff_d56cf1ec:

    # "It tilted its head towards me as I drew my blade!"
    "Es neigte seinen Kopf zu mir, als ich meine Klinge zog!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:838
translate de qst_dreamhouse_l2_bathroom_oneoff_8e572365:

    # MC @ surprised "Was that a fucking ghost?!"
    MC @ surprised "War das ein verdammter Geist?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:839
translate de qst_dreamhouse_l2_bathroom_oneoff_2d14ed26:

    # KIARA @ scared "No, no, no, no, no!"
    KIARA @ scared "Nein, nein, nein, nein, nein!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:840
translate de qst_dreamhouse_l2_bathroom_oneoff_05a808cd:

    # KIARA @ scared "You've got to be kidding me!"
    KIARA @ scared "Du machst wohl Witze!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:847
translate de qst_dreamhouse_l2_nursery_oneoff_aec2ef82:

    # "Entering the room, the twisted corpses inside turned their attention towards us."
    "Beim Betreten des Raumes wandten sich die verdrehten Leichen darin uns zu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:848
translate de qst_dreamhouse_l2_nursery_oneoff_f98f618e:

    # MC @ scared "Shit!"
    MC @ scared "Scheiße!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:860
translate de qst_dreamhouse_l2_toys_caf4fb7b:

    # "Blood-stained and torn up toys."
    "Blutverschmierte und zerfetzte Spielzeuge."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:864
translate de qst_dreamhouse_l2_crib_fd87f1dd:

    # "A crib stained in blood."
    "Ein blutverschmiertes Kinderbett."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:869
translate de qst_dreamhouse_l2_bedroom_door_8e18cd77:

    # MC "(We need the key to unlock this!)"
    MC "(Wir brauchen den Schlüssel, um das aufzuschließen!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:873
translate de qst_dreamhouse_l2_bedroom_door_918f304d:

    # "Inserting the key into the lock, the door swung open as we scrambled through,"
    "Als wir den Schlüssel ins Schloss steckten, schwang die Tür auf, während wir hindurchhasteten,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:876
translate de qst_dreamhouse_l2_bedroom_door_538a8f11:

    # "a bright white light enveloping us all as we did so."
    "Ein helles weißes Licht umhüllte uns alle, als wir das taten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:884
translate de qst_dreamhouse_l2_candle_4040ce45:

    # MC @ think "(A blue flame... Why?)"
    MC @ think "(Eine blaue Flamme... Warum?)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:890
translate de qst_dreamhouse_l2_dining_oneoff_82f181a3:

    # "Entering the dining hall, the table had become a ghoulish display of gore, as the creatures crowded around it."
    "Als wir den Speisesaal betraten, war der Tisch zu einer makabren Zurschaustellung von Blut und Innereien geworden, während die Kreaturen sich darum drängten."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:891
translate de qst_dreamhouse_l2_dining_oneoff_d8a8a7a0:

    # "Guts, blood, and indiscernible flesh sprawled across the table as they grabbed at the meat with their bare hands and devoured it."
    "Eingeweide, Blut und unkenntliches Fleisch lagen auf dem Tisch ausgebreitet, als sie mit bloßen Händen nach dem Fleisch griffen und es verschlangen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:892
translate de qst_dreamhouse_l2_dining_oneoff_d34ae079:

    # "The wretched smell of rot and death was too much for Kiara, who hurled onto the floor."
    "Der widerliche Geruch von Verwesung und Tod war zu viel für Kiara, die sich auf den Boden übergab."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:893
translate de qst_dreamhouse_l2_dining_oneoff_fdae0222:

    # KIARA @ scared "Oh gods..."
    KIARA @ scared "Oh Götter..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:894
translate de qst_dreamhouse_l2_dining_oneoff_6f1abb01:

    # "As she did so, the dead looked up, dropping the meat in their hands as they began shambling towards us!"
    "Als sie das tat, blickten die Toten auf, ließen das Fleisch in ihren Händen fallen und begannen auf uns zuzuschlurfen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:897
translate de qst_dreamhouse_l2_dining_oneoff_6e8ae10d:

    # MARKUS @ angry "I FUCKING HATE THIS HOUSE!"
    MARKUS @ angry "ICH HASSE DIESES VERDAMMTE HAUS!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:905
translate de qst_dreamhouse_l2_dining_oneoff_a623fccf:

    # MARKUS @ shock "{i}*Huff*{/i} I think that's the last of them."
    MARKUS @ shock "{i}*Keuch*{/i} Ich glaube, das war der Letzte von ihnen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:908
translate de qst_dreamhouse_l2_dining_oneoff_fdd90545:

    # VES @ angry "These creatures only fall when their head is cleaved from their neck!"
    VES @ angry "Diese Kreaturen fallen nur, wenn ihr Kopf vom Hals getrennt wird!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:910
translate de qst_dreamhouse_l2_dining_oneoff_b8b1ec09:

    # VES @ angry "How tedious!"
    VES @ angry "Wie mühsam!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:913
translate de qst_dreamhouse_l2_dining_oneoff_4b748bc8:

    # SYPHA @ think "We can't stay here, come on."
    SYPHA @ think "Wir können hier nicht bleiben, komm schon."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:918
translate de qst_dreamhouse_l2_table_f89a89b8:

    # "(... Gods, what a nightmare.)"
    "(... Götter, was für ein Albtraum.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:923
translate de qst_dreamhouse_l2_wolfhead_a1f17cb0:

    # "BARK!"
    "WAU!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:924
translate de qst_dreamhouse_l2_wolfhead_4f314bba:

    # "The mounted head snapped towards me with its jaws."
    "Der montierte Kopf schnappte mit seinen Kiefern nach mir."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:925
translate de qst_dreamhouse_l2_wolfhead_41224f04:

    # "(Is it... Is it still alive?)"
    "(Ist es... Ist es noch am Leben?)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:930
translate de qst_dreamhouse_l2_portrait_d934f7a2:

    # "That's... disturbing."
    "Das ist... verstörend."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:936
translate de qst_dreamhouse_l2_kitchen_oneoff_b0b44ff1:

    # "As we entered the kitchen, I heard the slamming of the cleaver as we looked to find one of the dead,"
    "Als wir die Küche betraten, hörte ich das Schlagen des Hackmessers und sah einen der Toten,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:938
translate de qst_dreamhouse_l2_kitchen_oneoff_f0272186:

    # "a huge, decrepit, bulking figure hacking away at a man."
    "eine riesige, verfallene, massige Gestalt, die auf einen Mann einhackte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:939
translate de qst_dreamhouse_l2_kitchen_oneoff_ec7e5b88:

    # "Still barely alive and choking on blood, the man reached out towards us in one desperate final act, only for the creature to hack off his fingers with the cleaver."
    "Noch kaum am Leben und an Blut erstickend, streckte der Mann in einer verzweifelten letzten Tat die Hand nach uns aus, nur damit die Kreatur ihm mit dem Hackbeil die Finger abhackte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:940
translate de qst_dreamhouse_l2_kitchen_oneoff_e99e910f:

    # "As the fingers dropped to the floor, the ghoulish creature turned towards us, placing down a platter of the man's remains on the table,"
    "Als die Finger auf den Boden fielen, drehte sich die grausige Kreatur zu uns um und stellte eine Platte mit den Überresten des Mannes auf den Tisch,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:941
translate de qst_dreamhouse_l2_kitchen_oneoff_b108b59f:

    # "it then stared blankly towards us, expectantly."
    "dann starrte es ausdruckslos und erwartungsvoll zu uns."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:942
translate de qst_dreamhouse_l2_kitchen_oneoff_64cf87e1:

    # MARKUS @ scared "Does... Does this fucking thing expect us to eat that?!"
    MARKUS @ scared "Erwartet... erwartet dieses verdammte Ding etwa, dass wir das essen?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:945
translate de qst_dreamhouse_l2_kitchen_oneoff_53d44a4b:

    # "Carefully, I reached over to grab a piece of the meat."
    "Vorsichtig griff ich hinüber, um ein Stück des Fleisches zu nehmen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:946
translate de qst_dreamhouse_l2_kitchen_oneoff_2f9ce75e:

    # "With a shaky hand, I pushed the wet meat into my mouth as the creature offered a drooling grin of approval."
    "Mit zitternder Hand schob ich das feuchte Fleisch in meinen Mund, während die Kreatur ein sabberndes Grinsen der Zustimmung zeigte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:947
translate de qst_dreamhouse_l2_kitchen_oneoff_ed932dcd:

    # "Markus pulled back in revulsion as Kiara looked like she was about to hurl."
    "Markus wich angewidert zurück, während Kiara aussah, als müsste sie sich gleich übergeben."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:948
translate de qst_dreamhouse_l2_kitchen_oneoff_2bce3932:

    # "The wet meat squeelched between my teeth, almost making me wretch as my eyes began to water from the foul taste."
    "Das feuchte Fleisch quietschte zwischen meinen Zähnen und brachte mich fast zum Würgen, während meine Augen von dem widerlichen Geschmack zu tränen begannen."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:949
translate de qst_dreamhouse_l2_kitchen_oneoff_cf947b80:

    # KIARA @ sad "Oh gods... I might... I think I'm gonna be sick."
    KIARA @ sad "Oh Götter... Ich glaube... ich glaube, mir wird schlecht."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:950
translate de qst_dreamhouse_l2_kitchen_oneoff_d069021e:

    # MARKUS @ scared "What in the hells is wrong with you?"
    MARKUS @ scared "Was zum Teufel ist los mit dir?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:951
translate de qst_dreamhouse_l2_kitchen_oneoff_d73d8a37:

    # SYPHA @ think "... Is this is some kind of masochistic ritual humans perform?"
    SYPHA @ think "... Ist das eine Art masochistisches Ritual, das Menschen durchführen?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:954
translate de qst_dreamhouse_l2_kitchen_oneoff_18ca7ff7:

    # VES @ think "... Why no salt?"
    VES @ think "... Warum kein Salz?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:956
translate de qst_dreamhouse_l2_kitchen_oneoff_c5034d4e:

    # "Seemingly satisfied that I had tasted his *food,* the creature went back to cooking, seemingly ignoring us and allowing us to pass."
    "Scheinbar zufrieden, dass ich sein *Essen* probiert hatte, widmete sich das Wesen wieder dem Kochen, ignorierte uns scheinbar und ließ uns passieren."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:960
translate de qst_dreamhouse_l2_kitchen_oneoff_806c733b:

    # "The ghoulish dead creature stared for a moment,"
    "Das grausige tote Wesen starrte einen Moment lang,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:961
translate de qst_dreamhouse_l2_kitchen_oneoff_1eb9fc7b:

    # "and realizing none of us will eat its {i}food,{/i}"
    "und als es merkte, dass keiner von uns sein {i}Essen{/i} essen würde,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:962
translate de qst_dreamhouse_l2_kitchen_oneoff_5633d180:

    # "it grabbed for the cleaver and swung it wildly towards us!"
    "griff es nach dem Hackbeil und schwang es wild in unsere Richtung!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:970
translate de qst_dreamhouse_l2_kitchen_oneoff_4dc50c36:

    # "Stumbling backwards, blood running from the seeping gash in its head from where I struck,"
    "Taumelnd nach hinten, Blut floss aus der sickernden Wunde an seinem Kopf, wo ich es geschlagen hatte,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:971
translate de qst_dreamhouse_l2_kitchen_oneoff_4e90e46e:

    # "in the creature's final moments, it reached up to grab a chunk of meat, stuffing its mouth full of it before it fell silent."
    "in den letzten Momenten des Wesens griff es nach einem Stück Fleisch, stopfte sich den Mund damit voll, bevor es still wurde."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:978
translate de qst_dreamhouse_l2_kitchen_cupboards_57333fb4:

    # "The cupboards bled and were filled with nothing but pungent meat in a gory mess."
    "Die Schränke bluteten und waren mit nichts als beißendem Fleisch in einer blutigen Sauerei gefüllt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:979
translate de qst_dreamhouse_l2_kitchen_cupboards_529ca2a3:

    # MC "(I think I'll pass on dessert.)"
    MC "(Ich glaube, auf Nachtisch verzichte ich.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:984
translate de qst_dreamhouse_l2_kitchen_pot_4b656435:

    # MC "A boiled, severed head floated to the top of the blood stew."
    MC "Ein gekochter, abgetrennter Kopf trieb oben auf dem Bluteintopf."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:989
translate de qst_dreamhouse_l2_kitchen_table_0fe1d924:

    # "{i}Why does no one believe me?{/i}"
    "{i}Warum glaubt mir niemand?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:990
translate de qst_dreamhouse_l2_kitchen_table_00252d94:

    # "{i}We buried the servant boy the other day, mother says his lungs were sick.{/i}"
    "{i}Wir haben den Dienerjungen neulich beerdigt, Mutter sagt, seine Lungen waren krank.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:991
translate de qst_dreamhouse_l2_kitchen_table_e5462dc5:

    # "{i}I swear I saw him move, but no one believed me.{/i}"
    "{i}Ich schwöre, ich habe ihn sich bewegen sehen, aber niemand hat mir geglaubt.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:992
translate de qst_dreamhouse_l2_kitchen_table_d7e1df6c:

    # "{i}I dreamed he was still moving in that box, and he came to see me that night.{/i}"
    "{i}Ich träumte, dass er sich in dieser Kiste noch bewegte und in jener Nacht zu mir kam.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:993
translate de qst_dreamhouse_l2_kitchen_table_d2e54c8d:

    # "{i}He was all mangled and gross, I screamed, but he was gone when mother came...{/i}"
    "{i}Er war ganz zerfleischt und eklig, ich schrie, aber er war fort, als Mutter kam ...{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:998
translate de qst_dreamhouse_l2_kitchen_to_cellar_9dd37f09:

    # MC @ think "Damn, it's locked!"
    MC @ think "Verdammt, es ist abgeschlossen!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1003
translate de qst_dreamhouse_l2_kitchen_to_cellar_d24c6466:

    # "The door clicked as it unlocked."
    "Die Tür klickte, als sie sich entriegelte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1012
translate de qst_dreamhouse_l2_cellar_barrel_61b14339:

    # "No wine, only blood it seems... warm to the touch."
    "Kein Wein, nur Blut, wie es scheint ... fühlt sich warm an."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1018
translate de qst_dreamhouse_l2_dead_mercenary_5b189511:

    # "Inspecting the corpse of the man, I found clutched in his coiled, dead hand, the blue skull key."
    "Als ich die Leiche des Mannes untersuchte, fand ich in seiner verkrampften, toten Hand den blauen Schädelschlüssel."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1025
translate de qst_dreamhouse_l2_library_oneoff_b461b23a:

    # "Upon entering the room, the swarm of dead shuffling around turned their attention towards us!"
    "Als wir den Raum betraten, richtete die Horde der umherwankenden Toten ihre Aufmerksamkeit auf uns!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1035
translate de qst_dreamhouse_l2_library_fireplace_9aefa7d9:

    # "A still-lit fireplace."
    "Ein noch brennender Kamin."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1036
translate de qst_dreamhouse_l2_library_fireplace_a3ca41df:

    # "The fire crackled as it burned the wood, but it radiated no warmth."
    "Das Feuer knisterte, während es das Holz verbrannte, aber es strahlte keine Wärme aus."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1041
translate de qst_dreamhouse_l2_library_bookshelf_1_29465ee2:

    # "The pages were ruined and covered in blood."
    "Die Seiten waren ruiniert und blutüberströmt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1046
translate de qst_dreamhouse_l2_library_bookshelf_2_0a77bcf4:

    # "... Just what kind of nightmares did this girl have?"
    "... Was für Albträume hatte dieses Mädchen nur?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1051
translate de qst_dreamhouse_l2_library_portrait_26eb8738:

    # "There's a depiction of what seems to be a man devouring raw, bloody, flesh... How macabre."
    "Da ist eine Darstellung von etwas, das ein Mann zu sein scheint, der rohes, blutiges Fleisch verschlingt... Wie makaber."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1052
translate de qst_dreamhouse_l2_library_portrait_dcac9c61:

    # "There's no keyhole this time."
    "Diesmal gibt es kein Schlüsselloch."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1068
translate de qst_dreamhouse_l3_start_e6b4e9df:

    # MC @ surprised "Gods, what is this place?"
    MC @ surprised "Götter, was ist das für ein Ort?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1069
translate de qst_dreamhouse_l3_start_594000fe:

    # MC @ think "Does anyone-"
    MC @ think "Weiß jemand-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1071
translate de qst_dreamhouse_l3_start_af6f165f:

    # "As I turned to look back, I realized the others were not with me."
    "Als ich mich umdrehte, um zurückzublicken, bemerkte ich, dass die anderen nicht bei mir waren."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1072
translate de qst_dreamhouse_l3_start_0ce3e770:

    # MC @ surprised "Markus?"
    MC @ surprised "Markus?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1073
translate de qst_dreamhouse_l3_start_3e21602a:

    # MC @ surprised "Kiara?"
    MC @ surprised "Kiara?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1075
translate de qst_dreamhouse_l3_start_3ef76725:

    # MC @ surprised "{i}Anyone?{/i}"
    MC @ surprised "{i}Irgendjemand?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1077
translate de qst_dreamhouse_l3_start_cbea66c9:

    # MC @ serious "... Fuck."
    MC @ serious "... Verdammt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1078
translate de qst_dreamhouse_l3_start_8bdaee21:

    # MC "(Alright, you know what to do. Find the key, move onto the next floor.)"
    MC "(In Ordnung, du weißt, was zu tun ist. Finde den Schlüssel, gehe zur nächsten Etage.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1079
translate de qst_dreamhouse_l3_start_d7232d72:

    # MC @ sad "(I just hope the others are fine.)"
    MC @ sad "(Ich hoffe nur, dass die anderen in Ordnung sind.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1085
translate de qst_dreamhouse_l3_bathtub_c67fdbca:

    # "The water is black..."
    "Das Wasser ist schwarz..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1091
translate de qst_dreamhouse_l3_mirror_0d811e85:

    # "Looking into it, I saw my own reflection, but it was distorted."
    "Als ich hineinschaute, sah ich mein eigenes Spiegelbild, aber es war verzerrt."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1095
translate de qst_dreamhouse_l3_mirror_44dde62d:

    # "As I placed my hand onto the mirror, I felt it go {i}through{/i} the glass into the other side."
    "Als ich meine Hand auf den Spiegel legte, spürte ich, wie sie {i}durch{/i} das Glas auf die andere Seite ging."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1096
translate de qst_dreamhouse_l3_mirror_8f466d6a:

    # "It was cool, and as I pushed my hand deeper, I grabbed at something."
    "Es war kühl, und als ich meine Hand tiefer schob, griff ich nach etwas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1098
translate de qst_dreamhouse_l3_mirror_a6a16a82:

    # "Pulling my hand and whatever it was out, something clawed at me!"
    "Als ich meine Hand und was auch immer es war herauszog, kratzte mich etwas!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1101
translate de qst_dreamhouse_l3_mirror_eaf73d4a:

    # MC @ surprised "AHH!"
    MC @ surprised "AHH!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1102
translate de qst_dreamhouse_l3_mirror_84c4e35d:

    # "I ripped back my hand, staring at the gash of blood."
    "Ich riss meine Hand zurück und starrte auf die blutige Wunde."

