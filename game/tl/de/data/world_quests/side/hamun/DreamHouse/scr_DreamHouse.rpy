# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1359
translate de qst_dreamhouse_l3_crib_2548988e:

    # MC @ scared "... I'm looking for-"
    MC @ scared "... Ich suche nach-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1360
