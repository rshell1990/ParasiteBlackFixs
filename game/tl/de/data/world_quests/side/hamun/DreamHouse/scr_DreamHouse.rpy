translate de qst_dreamhouse_final_housescene_6d447bc0:

    # MC @ surprised "Here we go!"
    MC @ surprised "Los geht's!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2477
translate de qst_dreamhouse_final_housescene_786f0070:

    # MC @ angry "ALL AT ONCE!"
    MC @ angry "ALLE AUF EINMAL!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2481
translate de qst_dreamhouse_final_housescene_cd8088ca:

    # VIRGO "NOW!"
    VIRGO "JETZT!"

