    ARLENA @ angry "PERVERSER!!!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:26
translate de qst_ADazzlingTail_02_night_31ca3adc:

    # ARLENA @ angry "Haven’t you heard of knocking first?"
    ARLENA @ angry "Hast du noch nie was von Anklopfen gehört?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:27
translate de qst_ADazzlingTail_02_night_008a1273:

    # MC @ talk "I just heard a suspicious noise! The door to the smithy was open! I-I didn’t think!"
    MC @ talk "Ich habe gerade ein verdächtiges Geräusch gehört! Die Tür zur Schmiede war offen! I-Ich habe nicht nachgedacht!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:29
translate de qst_ADazzlingTail_02_night_074f38cc:

    # "Arlena folded her arms across her chest and pouted as she stared at the floor, furious."
    "Arlena verschränkte die Arme vor der Brust und schmollte, während sie wütend auf den Boden starrte."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:30
translate de qst_ADazzlingTail_02_night_c6bd8a87:

    # MC @ talk "... Were you trying them out for—"
