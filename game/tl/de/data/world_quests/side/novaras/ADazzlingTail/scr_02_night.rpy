# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:44
translate de qst_ADazzlingTail_02_night_3e671db7:

    # ARLENA "Well... that’s good..."
    ARLENA "Nun... das ist gut..."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:45
translate de qst_ADazzlingTail_02_night_1b5f35b1:

    # ARLENA "Glad you enjoyed the view, pervert!"
    ARLENA "Schön, dass dir der Anblick gefallen hat, Perverser!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:47
translate de qst_ADazzlingTail_02_night_a44207c9:

    # "Arlena thought about the idea for moment, saying nothing as her cheeks turned a soft shade of pink."
    "Arlena dachte einen Moment lang über die Idee nach, sagte nichts, während ihre Wangen eine zarte rosa Farbe annahmen."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:49
translate de qst_ADazzlingTail_02_night_37355111:

    # "Dropping the quilt down, she turned around to give me a full view as she shyly looked over her shoulder to gauge my reaction."
    "Sie ließ die Decke fallen, drehte sich um, um mir den vollen Anblick zu gewähren, während sie schüchtern über die Schulter blickte, um meine Reaktion einzuschätzen."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:50
translate de qst_ADazzlingTail_02_night_3fbe8a9c_1:

