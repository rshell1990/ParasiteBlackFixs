# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:53
translate de qst_ADazzlingTail_02_night_61562a8f:

    # "As I stared at her magnificent behind, utterly entranced, Arlena didn’t wait for my answer before she covered herself once again with the blanket."
    "Als ich wie gebannt auf ihren prächtigen Hintern starrte, wartete Arlena nicht auf meine Antwort, bevor sie sich wieder mit der Decke zudeckte."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:54
translate de qst_ADazzlingTail_02_night_9f929f49:

