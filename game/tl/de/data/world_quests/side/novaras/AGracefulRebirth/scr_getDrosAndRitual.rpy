# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:4
translate de dros_4_getDros_c3e1c3d1:

    # DROS @ shock "A-Already?"
    DROS @ shock "S-Schon?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:5
translate de dros_4_getDros_b46ef0f5:

    # DROS @ talk "Very well, lead the way."
    DROS @ talk "Nun gut, geh voran."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:14
translate de dros_4_getDros_a45925f9:

    # DIVINE "Ah, Dros... You've arrived."
    DIVINE "Ah, Dros... Du bist da."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:15
translate de dros_4_getDros_e9db4a2e:

    # DROS @ smile "It is good to see you, Sister Divine."
    DROS @ smile "Es ist schön, dich zu sehen, Schwester Divine."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:16
translate de dros_4_getDros_8d01fe15:

    # DIVINE @ angry "Given the trouble you've caused us in the past, I normally could not say the same..."
    DIVINE @ angry "Angesichts der Probleme, die du uns in der Vergangenheit bereitet hast, könnte ich das normalerweise nicht sagen..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:17
translate de dros_4_getDros_0f98b4f3:

    # DIVINE "But I suppose these are special circumstances."
    DIVINE "Aber ich nehme an, dies sind besondere Umstände."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:18
translate de dros_4_getDros_33d35a12:

    # DROS @ sad "A-Ah... My behaviour has perhaps not always been the best, I admit, b-but-"
    DROS @ sad "A-Ah... Mein Verhalten war vielleicht nicht immer das Beste, ich gebe es zu, a-aber-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:19
translate de dros_4_getDros_38babc78:

    # DIVINE "Come, Dros, I have prepared the ritual."
    DIVINE "Komm, Dros, ich habe das Ritual vorbereitet."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:20
translate de dros_4_getDros_251fb961:

    # DROS @ sad "Will... Will it hurt?"
    DROS @ sad "Wird... Wird es weh tun?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:21
translate de dros_4_getDros_5e8d612e:

    # DIVINE "...Hopefully not, Dros."
    DIVINE "...Hoffentlich nicht, Dros."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:22
translate de dros_4_getDros_e213b104:

    # DIVINE "Are you truly sure you wish to-"
    DIVINE "Bist du wirklich sicher, dass du-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:23
translate de dros_4_getDros_70e62fbb:

    # DROS @ talk "Yes... I'm sure."
    DROS @ talk "Ja... ich bin sicher."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:24
translate de dros_4_getDros_62e755a5:

    # DIVINE "Very well, follow me then."
    DIVINE "Nun gut, folge mir dann."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:25
translate de dros_4_getDros_11db2ad8:

    # "As Dros and Sister Divine headed down one of the Hallways, Sister Divine stopped me."
    "Als Dros und Schwester Divine einen der Flure entlanggingen, hielt Schwester Divine mich an."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:26
translate de dros_4_getDros_22b78691:

    # DIVINE "I'm afraid this is as far as you go."
    DIVINE "Ich fürchte, hier endet dein Weg."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:27
translate de dros_4_getDros_6a7a9ddd:

    # DIVINE "There are certain rules and traditions us Mages must follow."
    DIVINE "Es gibt bestimmte Regeln und Traditionen, die wir Magier einhalten müssen."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:28
translate de dros_4_getDros_1d3ecee1:

    # DIVINE "You need to wait here."
    DIVINE "Du musst hier warten."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:29
translate de dros_4_getDros_0f5e1ab6:

    # DIVINE "We will return when ready."
    DIVINE "Wir kommen zurück, wenn wir bereit sind."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:30
translate de dros_4_getDros_85fc1f08:

    # MC @ talk "Very well."
    MC @ talk "Nun gut."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:31
translate de dros_4_getDros_1f14740f:

    # "Dros sheepishly glanced over his shoulder and looked at me as Sister Divine led him on."
    "Dros warf einen verlegenen Blick über die Schulter und sah mich an, während Schwester Divine ihn weiterführte."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:32
translate de dros_4_getDros_52993c9d:

    # "After turning a corner, the two of them were finally out of sight, and I was left completely alone to ponder my thoughts."
    "Nachdem sie um eine Ecke gebogen waren, waren die beiden endlich außer Sichtweite, und ich blieb völlig allein zurück, um über meine Gedanken nachzudenken."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:34
translate de dros_4_getDros_eb2e433a:

    # MC "(Hm, I hope this was the right decision.)"
    MC "(Hm, ich hoffe, das war die richtige Entscheidung.)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:36
translate de dros_4_getDros_7812e635:

    # "It felt like I was waiting for hours, when I heard the sudden strange sounds and bright lights flash from around the corner Dros and Sister Divine headed down."
    "Es fühlte sich an, als würde ich stundenlang warten, als ich plötzlich seltsame Geräusche hörte und helle Lichter um die Ecke blitzten, in die Dros und Schwester Divine gegangen waren."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:38
translate de dros_4_getDros_e9cbe315:

    # "With my hand at my blade, I took a few steps forward, when suddenly, Sister Divine emerged once again, smiling triumphantly."
    "Mit der Hand an meiner Klinge trat ich ein paar Schritte vor, als plötzlich Schwester Divine wieder auftauchte und triumphierend lächelte."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:43
translate de dros_4_getDros_f06c2614:

    # DIVINE "It pleases me to say, it was a success."
    DIVINE "Es freut mich, sagen zu können, es war ein Erfolg."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:44
translate de dros_4_getDros_19b296f9:

    # MC @ talk "Where is Dros?"
    MC @ talk "Wo ist Dros?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:45
translate de dros_4_getDros_846690e3:

    # DIVINE "Dros is gone..."
    DIVINE "Dros ist verschwunden..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:46
translate de dros_4_getDros_43179f5d:

    # DIVINE "Draya! Come here!"
    DIVINE "Draya! Komm her!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:52
translate de dros_4_getDros_924ba1fb:

    # "From around the corner, the beautiful elven girl shyly approached."
    "Um die Ecke kam das schöne Elfenmädchen schüchtern näher."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:55
translate de dros_4_getDros_c325415b:

    # "For a moment, I did not recognize him, from the softening of the face to the widening of the hips, he looked so different than before."
    "Einen Moment lang erkannte ich ihn nicht, von der weicheren Gesichtszügen bis zu den breiteren Hüften sah er so anders aus als zuvor."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:56
translate de dros_4_getDros_5a77c6d2:

    # "As he spoke, the voice was a higher pitch, and unmistakenly feminine."
    "Als er sprach, war die Stimme höher und unverkennbar weiblich."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:57
translate de dros_4_getDros_fdb5396b:

    # DROS @ talk "H-Hello."
    DROS @ talk "H-Hallo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:58
translate de dros_4_getDros_3d7deb1d:

    # MC @ talk "Dros? Is that really-"
    MC @ talk "Dros? Bist du das wirklich-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:59
translate de dros_4_getDros_e9f0f02d:

    # DROS @ smile "{i}*Cough*{/i} I prefer to go by Draya now."
    DROS @ smile "{i}*Hust*{/i} Ich nenne mich jetzt lieber Draya."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:60
translate de dros_4_getDros_df31ef06:

    # MC @ talk "Oh... I see."
    MC @ talk "Oh... Ich verstehe."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:61
translate de dros_4_getDros_3e63ffe0:

    # DIVINE "My work here is done."
    DIVINE "Meine Arbeit hier ist erledigt."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:62
translate de dros_4_getDros_4a3811a7:

    # MC @ talk "What do I owe you for your services, Sister?"
    MC @ talk "Was schulde ich Ihnen für Ihre Dienste, Schwester?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:63
translate de dros_4_getDros_61070ae7:

    # DIVINE "Nothing."
    DIVINE "Nichts."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:64
translate de dros_4_getDros_662a3f30:

    # DIVINE "This spell was... enlightening."
    DIVINE "Dieser Zauber war... erleuchtend."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:65
translate de dros_4_getDros_2034d8f3:

    # DIVINE "Consider it a gift."
    DIVINE "Betrachten Sie es als Geschenk."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:66
translate de dros_4_getDros_cf18f36a:

    # MC @ talk "Thank you."
    MC @ talk "Danke."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:67
translate de dros_4_getDros_796540ce:

    # DIVINE "You're most welcome... Now, if you don't mind."
    DIVINE "Gern geschehen... Nun, wenn es dir nichts ausmacht."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:68
translate de dros_4_getDros_f475c049:

    # DIVINE "I have other business to attend."
    DIVINE "Ich habe andere Dinge zu erledigen."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:69
translate de dros_4_getDros_638c51ac:

    # MC @ talk "Of course."
    MC @ talk "Natürlich."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:71
translate de dros_4_getDros_0ea1a5c9:

    # "Sister Divine led us outside, and an ecstatic Draya leapt into my arms to hug me before I pulled her off."
    "Schwester Divine führte uns nach draußen, und eine ekstatische Draya sprang in meine Arme, um mich zu umarmen, bevor ich sie von mir löste."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:78
translate de dros_4_getDros_1da34f0d:

    # DROS @ smile "I... I can't believe it."
    DROS @ smile "Ich... ich kann es nicht glauben."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:79
translate de dros_4_getDros_9866b910:

    # DROS @ smile "After all this time, I'm-"
    DROS @ smile "Nach all dieser Zeit, bin ich-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:80
translate de dros_4_getDros_bf8269dc:

    # DROS @ smile "I feel so alive!"
    DROS @ smile "Ich fühle mich so lebendig!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:81
translate de dros_4_getDros_985848dc:

    # MC @ talk "I am glad to help you, {i}Draya.{/i}"
    MC @ talk "Ich bin froh, dir zu helfen, {i}Draya.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:83
translate de dros_4_getDros_c222fa2d:

    # DROS @ talk "And don't think I forgot what we mentioned."
    DROS @ talk "Und denk nicht, ich hätte vergessen, was wir erwähnt haben."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:84
translate de dros_4_getDros_d9034de3:

    # DROS @ smile "I'll give you a permanent fifteen percent discount on my store from now on."
    DROS @ smile "Ich gewähre dir ab sofort einen dauerhaften Rabatt von fünfzehn Prozent in meinem Laden."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:89
translate de dros_4_getDros_87568343:

    # DROS @ talk "{i}*Cough*{/i} I see you still drive a hard bargain... Very well, twenty percent."
    DROS @ talk "{i}*Hust*{/i} Ich sehe, du feilschst immer noch hart ... Na gut, zwanzig Prozent."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:92
translate de dros_4_getDros_660a0896:

    # "Draya began to blush."
    "Draya begann zu erröten."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:96
translate de dros_4_getDros_c92f763d:

    # DROS @ lewd "There um, is {i}one{/i} more thing I wanted to talk with you about."
    DROS @ lewd "Es gibt, ähm, noch {i}eine{/i} Sache, über die ich mit dir sprechen wollte."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:97
translate de dros_4_getDros_e46ff672:

    # MC @ talk "Oh?"
    MC @ talk "Oh?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:98
translate de dros_4_getDros_fe2fa700:

    # DROS @ lewd "I suppose I should just come out and say it, shouldn't I?"
    DROS @ lewd "Ich glaube, ich sollte es einfach offen sagen, oder?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:99
translate de dros_4_getDros_2994bbc9:

    # DROS @ lewd "You're... {i}Very attractive.{/i}"
    DROS @ lewd "Du bist... {i}Sehr attraktiv.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:100
translate de dros_4_getDros_11b3ff7b:

    # "The comment was a surprising one, if they had given any hints prior to this, they certainly went over my head."
    "Die Bemerkung war überraschend; falls sie vorher irgendwelche Andeutungen gemacht haben, sind sie mir jedenfalls völlig entgangen."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:101
translate de dros_4_getDros_027e0d9e:

    # DROS @ smile "I mean, you've done so much for me."
    DROS @ smile "Ich meine, du hast so viel für mich getan."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:102
translate de dros_4_getDros_89e312b0:

    # DROS @ smile "And now I look like this, I finally feel I have the confidence to ask these things."
    DROS @ smile "Und jetzt, da ich so aussehe, habe ich endlich das Selbstvertrauen, diese Dinge zu fragen."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:103
translate de dros_4_getDros_06fcfb5f:

    # MC @ talk "Draya, I..."
    MC @ talk "Draya, ich..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:104
translate de dros_4_getDros_b5f20c3b:

    # DROS @ shock "D-Don't feel you have to say yes!"
    DROS @ shock "D-Du musst nicht Ja sagen!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:105
translate de dros_4_getDros_0fff7896:

    # DROS @ sad "I mean, I would understand if not... Just..."
    DROS @ sad "Ich meine, ich würde es verstehen, wenn nicht... Nur..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:106
translate de dros_4_getDros_9897dbce:

    # "Draya smiled shyly."
    "Draya lächelte schüchtern."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:107
translate de dros_4_getDros_2eef98ba:

    # DROS @ talk "Well?"
    DROS @ talk "Nun?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:120
translate de dros_4_getDros_c0933bab:

    # "Despite her claims I did not have to say yes, my answer clearly left her a little deflated."
    "Obwohl sie behauptet hatte, ich müsse nicht Ja sagen, ließ meine Antwort sie offensichtlich ein wenig enttäuscht zurück."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:121
translate de dros_4_getDros_f09331be:

    # DROS @ sad "I... I see."
    DROS @ sad "Ich... Ich verstehe."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:122
translate de dros_4_getDros_23ad4bbb:

    # DROS @ sad "Well, thank for being honest at least."
    DROS @ sad "Nun, danke, dass du wenigstens ehrlich warst."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:123
translate de dros_4_getDros_ccac0064:

    # DROS @ talk "It's no matter though! I shall see you around, {i}friend.{/i}"
    DROS @ talk "Es macht aber nichts! Ich werde dich schon noch sehen, {i}Freund.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:124
translate de dros_4_getDros_a330cb86:

    # "With that, Draya headed off, presumably back to their Tailor shop."
    "Damit ging Draya weg, vermutlich zurück zu ihrer Schneiderei."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:127
translate de dros_4_getDros_b23df8f0:

    # DROS @ shock "You... You do?"
    DROS @ shock "Du... Das tust du?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:128
translate de dros_4_getDros_5dca7b91:

    # DROS @ lewd "I... Well, that's good!"
    DROS @ lewd "Ich... Nun, das ist gut!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:129
translate de dros_4_getDros_88578b00:

    # "Draya seemed to ponder the thought before giggling."
    "Draya schien über den Gedanken nachzudenken, bevor sie kicherte."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:130
translate de dros_4_getDros_9465b4d8:

    # DROS @ lewd "So, what are we?"
    DROS @ lewd "Also, was sind wir?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:131
translate de dros_4_getDros_0ca03866:

    # DROS @ lewd "I'm sorry, I'm still getting used to all this."
    DROS @ lewd "Es tut mir leid, ich gewöhne mich noch an all das."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:132
translate de dros_4_getDros_93c8966a:

    # DROS @ lewd "What should I call you, [player_name!t]?"
    DROS @ lewd "Wie soll ich dich nennen, [player_name!t]?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:135
translate de dros_4_getDros_03d15310:

    # DROS @ smile "[dros_player_ref!t]? Well... If that's what you wish."
    DROS @ smile "[dros_player_ref!t]? Nun... Wenn du das wünschst."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:136
translate de dros_4_getDros_038709e6:

    # DROS @ talk "I have to speak to the Madam and change some details about my arrangement with her."
    DROS @ talk "Ich muss mit der Madam sprechen und einige Details meiner Vereinbarung mit ihr ändern."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:137
translate de dros_4_getDros_03ea6e8e:

    # MC @ surprised "You still intend to work at the Brothel?"
    MC @ surprised "Du willst immer noch im Bordell arbeiten?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:138
translate de dros_4_getDros_c1d7def0:

    # DROS @ smile "No, not at all."
    DROS @ smile "Nein, überhaupt nicht."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:139
translate de dros_4_getDros_00278a48:

    # DROS @ lewd "But we will need a safer place than my shop for more... {i}intimate{/i} moments."
    DROS @ lewd "Aber wir werden einen sichereren Ort als mein Geschäft für ... {i}intimere{/i} Momente brauchen."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:140
translate de dros_4_getDros_7ed39a12:

    # DROS @ angry "Having you come and go from the shop too much may draw some unwanted attention... Even with me like this."
    DROS @ angry "Wenn du zu oft ein- und ausgehst, könnte das unerwünschte Aufmerksamkeit erregen ... selbst wenn ich so bin wie jetzt."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:141
translate de dros_4_getDros_be78d9d6:

    # DROS @ angry "Last thing I need is inquisitors or someone poking into my business."
    DROS @ angry "Das Letzte, was ich brauche, sind Inquisitoren oder jemand, der in meinen Angelegenheiten herumschnüffelt."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:142
translate de dros_4_getDros_eedd2591:

    # MC @ talk "So, what will you do?"
    MC @ talk "Also, was wirst du tun?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:143
translate de dros_4_getDros_2a4df126:

    # DROS @ smile "It's simple, {i}I'm going to pay for the room myself.{/i}"
    DROS @ smile "Ganz einfach, {i}ich werde das Zimmer selbst bezahlen.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:144
translate de dros_4_getDros_8d5d3adc:

    # MC @ talk "Will that not be costly?"
    MC @ talk "Wird das nicht teuer sein?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:145
translate de dros_4_getDros_9ae59753:

    # DROS @ smile "I can afford it... Being a tailor does have its perks."
    DROS @ smile "Ich kann es mir leisten ... Schneiderin zu sein hat so seine Vorteile."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:146
translate de dros_4_getDros_788db69a:

    # DROS @ lewd "Besides, {i}I cannot wait to see you there, [dros_player_ref!t].{/i}"
    DROS @ lewd "Außerdem {i}kann ich es kaum erwarten, dich dort zu sehen, [dros_player_ref!t].{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:147
translate de dros_4_getDros_1baa56b0:

    # MC @ smile "I will see you there then, Draya."
    MC @ smile "Dann sehen wir uns dort, Draya."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:148
translate de dros_4_getDros_5bc8ea6d:

    # "Draya smiled once again as she leaned forward to kiss me on the cheek before hurrying off."
    "Draya lächelte erneut, beugte sich vor, um mich auf die Wange zu küssen, bevor sie davoneilte."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:150
translate de dros_4_getDros_d346d243:

    # "All of that usual anger seemed to have washed away."
    "All die übliche Wut schien verflogen zu sein."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:152
translate de dros_4_getDros_9f25939c:

    # MC "(Something tells me I'm in for a good time the next time I see them.)"
    MC "(Irgendetwas sagt mir, dass ich beim nächsten Treffen Spaß haben werde.)"

