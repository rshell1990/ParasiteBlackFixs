translate de ev_AdaraDream_KO_posttavern_6642b38c:

    # REGINA "Are you alright?"
    REGINA "Geht es dir gut?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:38
translate de ev_AdaraDream_KO_posttavern_1b37691e:

    # "I felt... Alright?"
    "Ich fühlte mich... gut?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:39
