# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:274
translate de ev_AdaraDream_ef15c9ea:

    # "Regina smiled, throwing down some fresh clothes for me as she turned to close the door behind her again."
    "Regina lächelte und warf mir frische Kleidung hin, während sie sich umdrehte, um die Tür wieder hinter sich zu schließen."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:275
