# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:31
translate de ev_AdaraDream_KO_posttavern_29e4acaa:

    # "A vertigo of familiar street corners, heat waves pulsing inside my skull, I found myself at home."
    "Ein Schwindel von vertrauten Straßenecken, Hitzewellen pulsierten in meinem Schädel, und ich fand mich zu Hause wieder."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:32
translate de ev_AdaraDream_KO_posttavern_dcd31083:

    # "I muttered something to [regina_ref!t] as I headed towards my bedroom."
    "Ich murmelte etwas zu [regina_ref!t], als ich zu meinem Schlafzimmer ging."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:35
translate de ev_AdaraDream_KO_posttavern_ee31d30b:

    # "Falling on my bed face-first I could not force myself to react as [regina_ref!t] followed me, her unnerved voice trying to reach out to me."
    "Als ich mit dem Gesicht zuerst auf mein Bett fiel, konnte ich mich nicht zwingen zu reagieren, während [regina_ref!t] mir folgte und ihre beunruhigte Stimme versuchte, mich zu erreichen."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:36
translate de ev_AdaraDream_KO_posttavern_57feea09:

    # REGINA "[player_name!t]?"
    REGINA "[player_name!t]?"

