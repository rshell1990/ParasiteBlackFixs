    REGINA @ talk "Ich kümmere mich von hier aus um die Dinge."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:261
translate de ev_AdaraDream_6160a550:

    # "Adara turned to me and smiled politely."
