# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:11
translate de qst_reunion_tavern_69dfa24c:

    # ADARA @ talk "[player_name!t]! There you are!"
    ADARA @ talk "[player_name!t]! Da bist du ja!"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:12
translate de qst_reunion_tavern_7fc824f0:

    # MC @ talk "Come, let’s grab ourselves a table somewhere quiet..."
    MC @ talk "Komm, lass uns einen Tisch in einer ruhigen Ecke suchen..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:13
translate de qst_reunion_tavern_58b0c698:

    # MC @ talk "I imagine we both have a lot to talk about."
    MC @ talk "Ich schätze, wir haben beide eine Menge zu besprechen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:16
translate de qst_reunion_tavern_6b73f9d6:

    # ADARA @ talk "...I must admit, you look so... {i}different.{/i}"
    ADARA @ talk "...Ich muss zugeben, du siehst so... {i}anders{/i} aus."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:17
translate de qst_reunion_tavern_1c41f56e:

    # ADARA @ talk "Is the same for Markus?"
    ADARA @ talk "Gilt das auch für Markus?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:18
translate de qst_reunion_tavern_acde7642:

    # MC @ talk "Uhh, yes... We both look a little different now."
    MC @ talk "Äh, ja... Wir sehen jetzt beide ein bisschen anders aus."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:19
translate de qst_reunion_tavern_813ff63a:

    # ADARA @ talk "I don’t understand... It’s only been a few months and-"
    ADARA @ talk "Ich verstehe nicht... Es sind nur ein paar Monate vergangen und-"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:20
translate de qst_reunion_tavern_b789ba22:

    # ADARA @ talk "{i}It’s like you’re a different person!{/i}"
    ADARA @ talk "{i}Es ist, als wärst du eine ganz andere Person!{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:21
translate de qst_reunion_tavern_f752d247:

    # MC @ talk "There’s... a lot that happened while out there, Adara."
    MC @ talk "Es ist... eine Menge passiert, während ich da draußen war, Adara."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:24
translate de qst_reunion_tavern_e1e17d6f:

    # "Adara’s hand reached out to touch mine, it was warm and soft to the touch."
    "Adaras Hand streckte sich aus, um meine zu berühren, sie fühlte sich warm und weich an."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:25
translate de qst_reunion_tavern_4fe18085:

    # "Her eyes widened and seemed to almost sparkle against the slightly flickering flames of the candles."
    "Ihre Augen weiteten sich und schienen fast zu funkeln im leicht flackernden Licht der Kerzen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:26
translate de qst_reunion_tavern_d5b8bcd8:

    # ADARA @ talk "What happened?"
    ADARA @ talk "Was ist passiert?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:27
translate de qst_reunion_tavern_2844dd59:

    # ADARA @ talk "It must have been terrible... whatever you saw."
    ADARA @ talk "Es muss schrecklich gewesen sein... was auch immer du gesehen hast."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:39
translate de qst_reunion_tavern_244b3124:

    # MC @ talk "...It wasn’t good."
    MC @ talk "...Es war nicht gut."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:40
translate de qst_reunion_tavern_5f313f68:

    # MC @ talk "I try not to think about it or it all comes back at once."
    MC @ talk "Ich versuche, nicht daran zu denken, sonst kommt alles auf einmal zurück."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:41
translate de qst_reunion_tavern_5a8ca22f:

    # "Adara’s hand squeezed mine."
    "Adaras Hand drückte meine."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:42
translate de qst_reunion_tavern_b09400bd:

    # ADARA @ talk "How did you both get home so fast?"
    ADARA @ talk "Wie seid ihr beide so schnell nach Hause gekommen?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:43
translate de qst_reunion_tavern_2e830799:

    # MC @ talk "Honestly Adara, I can hardly remember."
    MC @ talk "Ehrlich, Adara, ich kann mich kaum erinnern."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:44
translate de qst_reunion_tavern_f8170d9f:

    # MC @ talk "The battle was something ferocious and everything was a haze."
    MC @ talk "Die Schlacht war etwas Wildes, und alles war ein Dunst."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:45
translate de qst_reunion_tavern_534575e3:

    # MC @ talk "We just woke up in the Hospital beds."
    MC @ talk "Wir sind einfach in den Krankenhausbetten aufgewacht."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:46
translate de qst_reunion_tavern_8c75144e:

    # ADARA @ talk "Why were you all even sent out in such a hurry?"
    ADARA @ talk "Warum wurdet ihr alle überhaupt so eilig losgeschickt?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:47
translate de qst_reunion_tavern_40bb5d85:

    # MC @ talk "I can’t really talk too much about it..."
    MC @ talk "Ich kann nicht wirklich viel darüber reden..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:48
translate de qst_reunion_tavern_2d522b4d:

    # ADARA @ talk "What do you mean?"
    ADARA @ talk "Was meinst du?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:49
translate de qst_reunion_tavern_94d2d6c7:

    # ADARA @ talk "We were only told you were heading towards Inma to help with the increased attacks around the border there."
    ADARA @ talk "Man hat uns nur gesagt, dass ihr nach Inma unterwegs seid, um bei den verstärkten Angriffen an der Grenze dort zu helfen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:50
translate de qst_reunion_tavern_5486eff0:

    # MC @ talk "That was a lie."
    MC @ talk "Das war eine Lüge."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:51
translate de qst_reunion_tavern_9d023411:

    # MC @ talk "The real mission was kept a secret, we scouted deeper into Demorai territory beyond the Valley of Death."
    MC @ talk "Die wahre Mission wurde geheim gehalten, wir sind tiefer in das Gebiet von Demorai vorgedrungen, jenseits des Tals des Todes."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:52
translate de qst_reunion_tavern_a9843996:

    # ADARA @ talk "Huh..."
    ADARA @ talk "Hm..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:53
translate de qst_reunion_tavern_d4453d34:

    # MC @ talk "We were sent to check up on some old fort when we were attacked there."
    MC @ talk "Wir wurden geschickt, um eine alte Festung zu überprüfen, als wir dort angegriffen wurden."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:54
translate de qst_reunion_tavern_e7393b81:

    # ADARA @ talk "How many?"
    ADARA @ talk "Wie viele?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:55
translate de qst_reunion_tavern_e3c5c024:

    # MC @ talk "Hundreds... Maybe thousands, I can hardly remember with the chaos of it all."
    MC @ talk "Hunderte... Vielleicht Tausende, ich kann mich bei dem ganzen Chaos kaum erinnern."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:56
translate de qst_reunion_tavern_0f65e518:

    # ADARA @ talk "[player_name!t]..."
    ADARA @ talk "[player_name!t]..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:57
translate de qst_reunion_tavern_bcd3015d:

    # MC @ talk "Me and Markus were the last ones left, we headed down into the underground of the fort and sealed ourselves in this small cavern."
    MC @ talk "Markus und ich waren die Letzten, wir gingen in den Untergrund der Festung hinab und schlossen uns in dieser kleinen Höhle ein."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:58
translate de qst_reunion_tavern_ff512f24:

    # ADARA @ talk "Then what happened?"
    ADARA @ talk "Und was geschah dann?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:59
translate de qst_reunion_tavern_390e3879:

    # MC @ talk "Well..."
    MC @ talk "Nun..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:60
translate de qst_reunion_tavern_7c56712f:

    # ADARA @ talk "...[player_name!t]?"
    ADARA @ talk "...[player_name!t]?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:61
translate de qst_reunion_tavern_24263e73:

    # ADARA @ talk "You can tell me anything, you know that."
    ADARA @ talk "Du kannst mir alles erzählen, das weißt du."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:65
translate de qst_reunion_tavern_6c707b23:

    # "...I can’t tell her everything, but at least I can tell her some part of the truth about what happened back then."
    "...Ich kann ihr nicht alles erzählen, aber wenigstens kann ich ihr einen Teil der Wahrheit über das erzählen, was damals passiert ist."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:66
translate de qst_reunion_tavern_a05811dc:

    # MC @ talk "...Look, you can’t tell anyone about this, okay?"
    MC @ talk "...Pass auf, du darfst niemandem davon erzählen, okay?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:67
translate de qst_reunion_tavern_66d97588:

    # MC @ talk "It’s not safe for me to even be talking about this."
    MC @ talk "Es ist nicht sicher für mich, überhaupt darüber zu sprechen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:68
translate de qst_reunion_tavern_b46267dc:

    # ADARA @ talk "I won’t say a word."
    ADARA @ talk "Ich werde kein Wort sagen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:69
translate de qst_reunion_tavern_5f9e4020:

    # MC @ talk "There were these... {i}things{/i} down there."
    MC @ talk "Es gab da unten diese... {i}Dinger{/i}."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:70
translate de qst_reunion_tavern_e41768a2:

    # ADARA @ talk "{i}’Things?’{/i}"
    ADARA @ talk "{i}’Dinger?’{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:71
translate de qst_reunion_tavern_f8ab7057:

    # MC @ talk "Like pillars but, containing {i}something{/i} inside them."
    MC @ talk "Wie Säulen, aber mit {i}etwas{/i} darin."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:72
translate de qst_reunion_tavern_5d142415:

    # MC @ talk "When we touched them, we blacked out and woke up in the Hospital back here."
    MC @ talk "Als wir sie berührten, wurden wir ohnmächtig und wachten hier im Krankenhaus wieder auf."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:73
translate de qst_reunion_tavern_4d770eb5:

    # ADARA @ talk "You don’t remember a thing?"
    ADARA @ talk "Du erinnerst dich an gar nichts?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:74
translate de qst_reunion_tavern_fd21584e:

    # MC @ talk "I... No."
    MC @ talk "Ich... Nein."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:75
translate de qst_reunion_tavern_e24026a9:

    # MC @ talk "But something happened in there and it {i}changed{/i} us."
    MC @ talk "Aber da drin ist etwas passiert, und es hat uns {i}verändert{/i}."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:76
translate de qst_reunion_tavern_834d1f41:

    # ADARA @ talk "You mean... {i}Something is inside of you both now?{/i}"
    ADARA @ talk "Du meinst... {i}Es ist jetzt etwas in euch beiden?{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:77
translate de qst_reunion_tavern_024e1267:

    # MC @ talk "Don’t say it out loud!"
    MC @ talk "Sag das nicht laut!"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:78
translate de qst_reunion_tavern_977f2828:

    # MC @ talk "Gods only know what the inquisitors would do if they found out..."
    MC @ talk "Nur die Götter wissen, was die Inquisitoren tun würden, wenn sie es herausfänden..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:79
translate de qst_reunion_tavern_58485fca:

    # ADARA @ talk "But... [player_name!t], what if it’s dangerous?"
    ADARA @ talk "Aber... [player_name!t], was, wenn es gefährlich ist?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:80
translate de qst_reunion_tavern_c7d8ed95:

    # ADARA @ talk "[player_name!t], you need to see a mage or someone about it!"
    ADARA @ talk "[player_name!t], du musst damit zu einem Magier oder jemandem gehen!"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:81
translate de qst_reunion_tavern_e840b16a:

    # MC @ talk "Adara, you have to keep quiet about this."
    MC @ talk "Adara, du musst darüber schweigen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:82
translate de qst_reunion_tavern_972a7844:

    # ADARA @ talk "And I will but..."
    ADARA @ talk "Und das werde ich, aber..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:83
translate de qst_reunion_tavern_5921e895:

    # MC @ talk "Adara, I’m fine, okay?"
    MC @ talk "Adara, mir geht's gut, okay?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:84
translate de qst_reunion_tavern_cb51eacf:

    # MC @ talk "Just don’t worry."
    MC @ talk "Mach dir einfach keine Sorgen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:85
translate de qst_reunion_tavern_3ab605e9:

    # ADARA @ talk "How can you ask me to not worry about you?"
    ADARA @ talk "Wie kannst du mich bitten, mir keine Sorgen um dich zu machen?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:86
translate de qst_reunion_tavern_df83141d:

    # MC @ talk "Adara, {i}I’m fine.{/i}"
    MC @ talk "Adara, {i}mir geht's gut.{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:87
translate de qst_reunion_tavern_af768121:

    # MC @ talk "I {i}feel{/i} fine."
    MC @ talk "Ich {i}fühle{/i} mich gut."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:88
translate de qst_reunion_tavern_45e38243:

    # ADARA @ talk "...Alright, if you say so."
    ADARA @ talk "...Na gut, wenn du das sagst."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:89
translate de qst_reunion_tavern_80c2c498:

    # ADARA @ talk "But if something happens you have to promise me you’ll get it looked at."
    ADARA @ talk "Aber wenn etwas passiert, musst du mir versprechen, dass du es untersuchen lässt."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:90
translate de qst_reunion_tavern_0c84ba6a:

    # MC @ talk "I promise."
    MC @ talk "Ich verspreche es."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:91
translate de qst_reunion_tavern_0a8b4028:

    # "Adara smiled faintly, still anxious and perhaps not entirely believing towards my comment."
    "Adara lächelte schwach, immer noch ängstlich und vielleicht nicht ganz überzeugt von meiner Bemerkung."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:94
translate de qst_reunion_tavern_ab73a38f:

    # MC @ talk "I can hardly remember much of it."
    MC @ talk "Ich kann mich kaum noch an viel davon erinnern."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:95
translate de qst_reunion_tavern_7453a280:

    # MC @ talk "There was just too much adrenaline coursing through both of us."
    MC @ talk "Es strömte einfach zu viel Adrenalin durch uns beide."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:96
translate de qst_reunion_tavern_b6dfe4f8:

    # MC @ talk "We managed to find a back passage out and just kept riding back to Novaras as fast as we could."
    MC @ talk "Wir schafften es, einen Hinterausgang zu finden, und ritten einfach so schnell wie möglich zurück nach Novaras."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:97
translate de qst_reunion_tavern_6e95d48d:

    # ADARA @ talk "Where did the horses come from?"
    ADARA @ talk "Woher kamen die Pferde?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:98
translate de qst_reunion_tavern_67eacfe5:

    # MC @ talk "They uh, they were just roaming."
    MC @ talk "Sie, ähm, sie sind einfach herumgelaufen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:99
translate de qst_reunion_tavern_42cc88be:

    # MC @ talk "I think they had bolted from the battle and a few had stumbled their way around where we were."
    MC @ talk "Ich denke, sie sind aus der Schlacht davongestürmt, und ein paar sind in unsere Nähe gestolpert."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:100
translate de qst_reunion_tavern_77748251:

    # ADARA @ talk "...R-Right."
    ADARA @ talk "...R-Richtig."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:101
translate de qst_reunion_tavern_0ecc4fca:

    # MC @ talk "Adara didn’t seem entirely convinced with my story, not that it was exactly a very good one."
    MC @ talk "Adara schien von meiner Geschichte nicht ganz überzeugt, die allerdings auch nicht wirklich gut war."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:102
translate de qst_reunion_tavern_c473d9e4:

    # ADARA @ talk "...But how did you get back so fast?"
    ADARA @ talk "...Aber wie bist du so schnell zurückgekommen?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:103
translate de qst_reunion_tavern_dad6bcef:

    # ADARA @ talk "I mean, I heard you came back {i}in a week.{/i}"
    ADARA @ talk "Ich meine, ich habe gehört, du bist {i}in einer Woche{/i} zurückgekommen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:104
translate de qst_reunion_tavern_48a07b7c:

    # MC @ talk "Oh, uh..."
    MC @ talk "Oh, äh..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:105
translate de qst_reunion_tavern_cc2d6668:

    # MC @ talk "Well you see, we {i}actually{/i} arrived back about a month ago."
    MC @ talk "Nun, weißt du, wir sind {i}eigentlich{/i} schon vor etwa einem Monat zurückgekommen."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:106
translate de qst_reunion_tavern_3526ce6c:

    # ADARA @ talk "A month?"
    ADARA @ talk "Ein Monat?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:107
translate de qst_reunion_tavern_45e3abcc:

    # MC @ talk "Yeah, apparently we just collapsed and we’ve been bed-ridden and in and out of consciousness for days."
    MC @ talk "Ja, anscheinend sind wir einfach zusammengebrochen und waren tagelang bettlägerig und zeitweise bewusstlos."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:108
translate de qst_reunion_tavern_0f5a8f6f:

    # ADARA @ talk "Really?"
    ADARA @ talk "Wirklich?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:109
translate de qst_reunion_tavern_ba0e1c6b:

    # MC @ talk "Yeah... really."
    MC @ talk "Ja... wirklich."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:110
translate de qst_reunion_tavern_d5d1bb96:

    # "I hate lying to her like this, but it’s for the best."
    "Ich hasse es, sie so anzulügen, aber es ist das Beste."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:111
translate de qst_reunion_tavern_8dd6d326:

    # MC @ talk "Sorry to be the bearer of bad news."
    MC @ talk "Tut mir leid, dass ich der Überbringer schlechter Nachrichten bin."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:112
translate de qst_reunion_tavern_b42f44d2:

    # MC @ talk "Our ‘legendary’ ride home is quite the exaggeration."
    MC @ talk "Unsere 'legendäre' Heimfahrt ist ganz schön übertrieben."

