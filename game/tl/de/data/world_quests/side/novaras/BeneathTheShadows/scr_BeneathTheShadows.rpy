    MC @ think "Einer dieser Wölfe, von denen du sprichst?"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:97
translate de qst_beneath_shadows_enter_bordello_meet_carina_899c34da:

    # CARINA @ talk "Of a sort... I know my place in the den, and I'm happy to continue {i}keeping{/i} it as is."
    CARINA @ talk "So ungefähr... Ich kenne meinen Platz im Bau und bin zufrieden, ihn so {i}zu behalten{/i}, wie er ist."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:98
translate de qst_beneath_shadows_enter_bordello_meet_carina_0873a34f:

    # MC @ serious "I still fail to see what this has to do with me."
    MC @ serious "Ich sehe immer noch nicht, was das mit mir zu tun hat."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:99
translate de qst_beneath_shadows_enter_bordello_meet_carina_3343c5fa:

    # CARINA @ talk "It's quite simple, Captain Nyx and I have an... {i}arrangement.{/i}"
    CARINA @ talk "Es ist ganz einfach, Captain Nyx und ich haben eine... {i}Vereinbarung.{/i}"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:100
translate de qst_beneath_shadows_enter_bordello_meet_carina_cf19f942:

    # CARINA @ talk "She ignores some of the businesses, and I supply her with the necessary information about the real goings on of the city."
    CARINA @ talk "Sie ignoriert einige der Geschäfte, und ich liefere ihr die nötigen Informationen über die wahren Vorgänge in der Stadt."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:101
translate de qst_beneath_shadows_enter_bordello_meet_carina_2fc732a7:

    # MC @ serious "And you're telling me this because...?"
    MC @ serious "Und das erzählst du mir, weil...?"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:102
translate de qst_beneath_shadows_enter_bordello_meet_carina_e01f936c:

