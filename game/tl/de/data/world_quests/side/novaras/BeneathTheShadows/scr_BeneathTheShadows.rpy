    # CARINA @ smile "She is quite a talented woman, always willing to do what's necessary to maintain law and order."
    CARINA @ smile "Sie ist eine ziemlich talentierte Frau, immer bereit, das Notwendige zu tun, um Recht und Ordnung aufrechtzuerhalten."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:114
translate de qst_beneath_shadows_enter_bordello_meet_carina_menu_01fec8ee:

    # CARINA @ talk "Despite her limited resources."
    CARINA @ talk "Trotz ihrer begrenzten Mittel."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:115
translate de qst_beneath_shadows_enter_bordello_meet_carina_menu_b4a4d14a:

    # CARINA @ talk "It's almost a shame though... With a body like hers, she could have easily avoided half the stress in her life if she chose a different path!"
    CARINA @ talk "Es ist allerdings fast schade... Mit einem Körper wie ihrem hätte sie die Hälfte des Stresses in ihrem Leben leicht vermeiden können, wenn sie einen anderen Weg gewählt hätte!"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:116
translate de qst_beneath_shadows_enter_bordello_meet_carina_menu_2aff2c96:

    # MC @ angry "Is this going somewhere?"
    MC @ angry "Führt das irgendwo hin?"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:117
translate de qst_beneath_shadows_enter_bordello_meet_carina_menu_8b2bb420:

    # CARINA @ talk "It's quite simple; the dear captain is usually in an impossible situation."
    CARINA @ talk "Es ist ganz einfach; der liebe Kapitän steckt normalerweise in einer unmöglichen Situation."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:118
translate de qst_beneath_shadows_enter_bordello_meet_carina_menu_50ecba4b:

