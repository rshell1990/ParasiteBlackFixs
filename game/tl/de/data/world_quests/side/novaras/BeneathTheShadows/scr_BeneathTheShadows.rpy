    "Die Frau lachte."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:110
translate de qst_beneath_shadows_enter_bordello_meet_carina_menu_49384175:

    # CARINA @ laugh "Oh my...!"
    CARINA @ laugh "Oh mein...!"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:111
translate de qst_beneath_shadows_enter_bordello_meet_carina_menu_f43ff085:

