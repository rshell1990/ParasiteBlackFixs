# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:2
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_16e30b1d:

    # "You notice a suspiciously-looking man, no doubt a Vulshan, head off down one of the many winding back alleyways through the marketplace."
    "Du bemerkst einen verdächtig aussehenden Mann, zweifellos ein Vulshan, der in eine der vielen verwinkelten Gassen des Marktplatzes verschwindet."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:3
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_296a71e1:

    # "Do you follow him? You have a strong sense it will be dangerous..."
    "Folgst du ihm? Du hast ein starkes Gefühl, dass es gefährlich sein wird..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:12
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_b7f7fd31:

    # "Stalking the man through the many winding alleyways, I nearly lost him multiple times through the labyrinth like turns as we descended deeper into the bowels of the city."
    "Als ich den Mann durch die vielen verwinkelten Gassen verfolgte, verlor ich ihn fast mehrmals bei den labyrinthartigen Abzweigungen, während wir tiefer in die Eingeweide der Stadt hinabstiegen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:13
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_15d6403f:

    # "Finally, I hide behind a wall as the man arrived upon some upon some small opening where the buildings converged."
    "Schließlich versteckte ich mich hinter einer Mauer, als der Mann auf eine kleine Öffnung stieß, wo die Gebäude zusammenliefen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:14
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_78a590ce:

    # "From the shadows, the Khazahs and Vulshan appeared."
    "Aus den Schatten traten die Khazahs und Vulshan hervor."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:16
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_204ab2ae:

    # KHAZAH_LEADER "So... Have you thought more on our terms?"
    KHAZAH_LEADER "Also... Habt ihr weiter über unsere Bedingungen nachgedacht?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:17
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_8508067e:

    # VULSHAN_LEADER "We have, yet there is still much to be discussed."
    VULSHAN_LEADER "Das haben wir, doch es gibt noch viel zu besprechen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:18
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_9945ea8c:

    # KHAZAH_LEADER "What is the problem now?"
    KHAZAH_LEADER "Was ist nun das Problem?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:19
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_e019d8a9:

    # KHAZAH_LEADER "This is the problem with you Vulshans, so... hesitant."
    KHAZAH_LEADER "Das ist das Problem mit euch Vulshans, so... zögerlich."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:20
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_700594ac:

    # VULSHAN_LEADER "Our will is as strong as yours, do not doubt that."
    VULSHAN_LEADER "Unser Wille ist genauso stark wie eurer, zweifelt nicht daran."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:21
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_b710cda8:

    # VULSHAN_LEADER "But we are not so reckless as to throw ourselves to any cause for short term coin... Like a Khazhah."
    VULSHAN_LEADER "Aber wir sind nicht so leichtsinnig, uns für kurzfristigen Gewinn in jede Sache zu stürzen ... Wie ein Khazhah."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:22
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_a3a5f302:

    # KHAZAH_LEADER "Tsch, fool."
    KHAZAH_LEADER "Tsch, Narr."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:23
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_16c0fa2a:

    # KHAZAH_LEADER "Tarek's days are numbered, the Boshu, the Tumak, even the Zatsu are turning."
    KHAZAH_LEADER "Tareks Tage sind gezählt, die Boshu, die Tumak, selbst die Zatsu wenden sich ab."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:24
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_2b9f1fce:

    # KHAZAH_LEADER "They stand with us as long as we are willing to absorb them into our ranks."
    KHAZAH_LEADER "Sie stehen zu uns, solange wir bereit sind, sie in unsere Reihen aufzunehmen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:25
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_c7070d88:

    # VULSHAN_LEADER "He has done much for us, without him, you and I would still be spilling each others blood right now..."
    VULSHAN_LEADER "Er hat viel für uns getan, ohne ihn würden du und ich uns jetzt immer noch gegenseitig Blut vergießen ..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:26
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_4657c99a:

    # KHAZAH_LEADER "He will be the death of us."
    KHAZAH_LEADER "Er wird unser Tod sein."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:27
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_8374922b:

    # KHAZAH_LEADER "He knows we are the biggest threat to his power and he seeks to weaken us."
    KHAZAH_LEADER "Er weiß, dass wir die größte Bedrohung für seine Macht sind, und er versucht, uns zu schwächen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:28
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_25156e44:

    # VULSHAN_LEADER "Your proof? The Vulshan made a vow, we are honor bound to-"
    VULSHAN_LEADER "Dein Beweis? Die Vulshan haben einen Schwur geleistet, wir sind durch unsere Ehre verpflichtet zu-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:29
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_9154a9d7:

    # KHAZAH_LEADER "There is no time for honor Vulshan."
    KHAZAH_LEADER "Für Ehre ist keine Zeit, Vulshan."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:30
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_5c7fe2a2:

    # KHAZAH_LEADER "He plans to split our territories further with the lesser factions, with us further fractured, he believes he will be able to control us easier."
    KHAZAH_LEADER "Er plant, unsere Gebiete weiter mit den kleineren Fraktionen aufzuteilen, und glaubt, uns mit weiterer Zersplitterung leichter kontrollieren zu können."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:31
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_b607196c:

    # VULSHAN_LEADER "And your proof of this?"
    VULSHAN_LEADER "Und Ihr Beweis dafür?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:32
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_18e354dd:

    # "The Khazah pulled from his robes a scroll which he tossed over towards the Vulshan leader who picked it up and began reading it."
    "Der Khazah zog aus seinen Gewändern eine Schriftrolle, die er dem Vulshan-Anführer zuwarf, der sie aufhob und zu lesen begann."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:33
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_4a4b656c:

    # KHAZAH_LEADER "One of our spies stole this from his office, a letter he sent secretly to the Yahvom."
    KHAZAH_LEADER "Einer unserer Spione stahl dies aus seinem Büro, einen Brief, den er heimlich an die Yahvom gesandt hatte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:34
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_eb970728:

    # KHAZAH_LEADER "Satisfied?"
    KHAZAH_LEADER "Zufrieden?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:35
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_daa84826:

    # VULSHAN_LEADER "...Yes, this will suffice."
    VULSHAN_LEADER "...Ja, das wird genügen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:36
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_05115bc6:

    # MC "(That's the proof I need.)"
    MC "(Das ist der Beweis, den ich brauche.)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:37
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_068aa4d2:

    # KHAZAH_LEADER "Good, then in the next three days, we shall-"
    KHAZAH_LEADER "Gut, dann werden wir in den nächsten drei Tagen-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:38
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_da309b27:

    # "Stepping onto a piece of glass accidentally beneath my feet, the loud crunching sound alerting the men to my presence."
    "Als ich versehentlich auf eine Glasscherbe unter meinen Füßen trat, alarmierte das laute Knirschen die Männer und verriet meine Anwesenheit."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:40
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_e470a966:

    # MC "(Fuck!)"
    MC "(Scheiße!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:44
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_4b5c6465:

    # KHAZAH_LEADER "A SPY! QUICKLY!"
    KHAZAH_LEADER "EIN SPION! SCHNELL!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:48
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_b0917694:

    # "With the last of the men bloodied and dead on the ground, I reached down to pluck the bloodied scroll from one of their hands."
    "Mit dem letzten der blutigen und toten Männer am Boden, bückte ich mich, um die blutige Schriftrolle aus einer ihrer Hände zu ziehen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:51
translate de scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_c02cd5f1:

    # MC "(I just hope this suffices enough for evidence...)"
    MC "(Ich hoffe nur, das genügt als Beweis...)"

