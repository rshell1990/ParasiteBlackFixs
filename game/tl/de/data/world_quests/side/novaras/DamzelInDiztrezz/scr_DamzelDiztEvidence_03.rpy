translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_2a800512:

    # "Knocking on the iron door, a slider opened as two piercing eyes looked the other side."
    "An die Eisentür klopfend, öffnete sich eine Schiebeklappe, während zwei durchdringende Augen von der anderen Seite blickten."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:4
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6037568e:

    # THUG @ talk "Password?"
    THUG @ talk "Passwort?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:5
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_12b02307:

    # MC @ talk "Silver tits on top of a golden ass."
    MC @ talk "Silberne Titten auf einem goldenen Arsch."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:6
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3b865931:

    # THUG @ talk "Wha~"
    THUG @ talk "Wha~"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:7
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d6761cbb:

    # MC @ talk "Go tell Tarek we've brought proof!"
    MC @ talk "Geh und sag Tarek, wir haben den Beweis gebracht!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:9
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c2d8c402:

    # "After some muffled cursing, I heard the thug on the other side shuffle away."
    "Nach einigem gedämpften Fluchen hörte ich, wie der Schläger auf der anderen Seite davonschlurfte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:10
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_bd24aa47:

    # "In a moment, a door opened and we were let in."
    "Im nächsten Moment öffnete sich eine Tür und wir wurden eingelassen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:11
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_45402abc:

    # "Tarek awaited in his office."
    "Tarek erwartete uns in seinem Büro."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:19
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_24c2dbf9:

    # MC @ talk "I have the proof you require Tarek."
    MC @ talk "Ich habe den Beweis, den du brauchst, Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:20
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_9b7fdd62:

    # TAREK @ shock "What?! Show me!"
    TAREK @ shock "Was?! Zeig es mir!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:24
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_61e1b66d:

    # "I handed over the bloodied scroll to Tarek."
    "Ich überreichte Tarek die blutbefleckte Schriftrolle."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:25
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_a8317f86:

    # MC @ talk "The other factions are about to turn on you, the Vulshan and Khazah's know you are trying to weaken them by handing over their territory to the lesser factions."
    MC @ talk "Die anderen Fraktionen sind kurz davor, sich gegen dich zu wenden. Die Vulshan und Khazahs wissen, dass du versuchst, sie zu schwächen, indem du ihr Territorium an die geringeren Fraktionen übergibst."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:26
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_60cee6bc:

    # TAREK "I-"
    TAREK "Ich-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:27
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5380f6ab:

    # "Tarek's face became sullen as the reality dawned on him."
    "Tareks Gesicht verdüsterte sich, als ihm die Realität bewusst wurde."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:28
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_b804709f:

    # TAREK @ sad "Yes... I can see now, it's all falling apart."
    TAREK @ sad "Ja... jetzt sehe ich es, alles fällt auseinander."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:29
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_579d4c44:

    # MC @ talk "Surely you must have known trying to weaken their factions would result on them to turn on you?"
    MC @ talk "Du musst doch gewusst haben, dass der Versuch, ihre Fraktionen zu schwächen, dazu führen würde, dass sie sich gegen dich wenden?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:30
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_1d4e9018:

    # TAREK "The Vulshan and Khazahs have been fighting for decades, I knew both were undermining my authority so what else was I supposed to do?"
    TAREK "Die Vulshan und Khazahs kämpfen seit Jahrzehnten. Ich wusste, dass beide meine Autorität untergraben. Was sollte ich sonst tun?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:31
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6ca2cf51:

    # TAREK @ sad "Not that it matters now... You were right it seems, this was inevitable."
    TAREK @ sad "Nicht, dass es jetzt noch von Bedeutung wäre... Du hattest wohl recht, das war unvermeidlich."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:32
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_74bf3445:

    # MC @ talk "What will you do now?"
    MC @ talk "Was wirst du jetzt tun?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:33
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3e90c048:

    # TAREK "Worry not, I will keep my word and leave..."
    TAREK "Keine Sorge, ich werde mein Wort halten und gehen..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:34
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_36997e06:

    # TAREK "...But not before I let loose and hand over all the information I have to the inquisitors!"
    TAREK "...Aber nicht bevor ich loslege und den Inquisitoren alle Informationen übergebe, die ich habe!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:35
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4ff0ec6b:

    # MC @ talk "You'll try strike a deal with them?"
    MC @ talk "Du wirst versuchen, mit ihnen einen Handel abzuschließen?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:36
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e1c147f8:

    # TAREK "Why not? As it stands, I am a dead man... At least if I can offer them something in return, perhaps I may just walk away from all this with something to show still..."
    TAREK "Warum nicht? So wie die Dinge liegen, bin ich ein toter Mann... Wenigstens wenn ich ihnen etwas im Gegenzug anbieten kann, komme ich vielleicht noch mit etwas vorzuweisen aus all dem heraus..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:37
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_33c1f58a:

    # MC @ talk "...And Nijah?"
    MC @ talk "...Und Nijah?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:38
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d4b7407a:

    # TAREK "Consider her debt settled."
    TAREK "Betrachte ihre Schuld als beglichen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:39
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_06188b6a:

    # TAREK "Before I go, you should know in my absence things may become more... {i}violent{/i} for a while."
    TAREK "Bevor ich gehe, solltest du wissen, dass in meiner Abwesenheit die Dinge für eine Weile... {i}gewalttätiger{/i} werden könnten."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:40
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_257af9a7:

    # TAREK @ angry "The violence I've tried to hold back will spill out in the power struggle to follow."
    TAREK @ angry "Die Gewalt, die ich zurückzuhalten versucht habe, wird sich im folgenden Machtkampf entladen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:41
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_64af8631:

    # MC @ talk "Where will you go?"
    MC @ talk "Wohin wirst du gehen?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:42
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffa0994f:

    # TAREK "Who knows!"
    TAREK "Wer weiß!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:43
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4bef9a69:

    # TAREK "Perhaps we may even run into each other again..."
    TAREK "Vielleicht laufen wir uns sogar noch einmal über den Weg..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:44
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6074ce3c:

    # TAREK "Don't worry, I won't forget what you did for me here today."
    TAREK "Keine Sorge, ich werde nicht vergessen, was du heute hier für mich getan hast."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:45
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c9b5c36a:

    # TAREK "You could have just tried to kill me."
    TAREK "Du hättest einfach versuchen können, mich zu töten."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:46
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5d2a16c6:

    # MC @ talk "That's not my way."
    MC @ talk "Das ist nicht meine Art."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:47
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffbfa8ae:

    # TAREK "Hm... Perhaps there are still honest men in this land then."
    TAREK "Hm... Vielleicht gibt es dann noch ehrliche Männer in diesem Land."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:48
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e81bba9c:

    # TAREK "Farewell friend, I will be gone by nightfall."
    TAREK "Leb wohl, Freund, ich werde bei Einbruch der Nacht fort sein."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:51
translate de scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_52dc527f:

    # MC @ talk "Farewell, Tarek."
    MC @ talk "Leb wohl, Tarek."

