# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:17
translate de qst_DamzelDizzt_2_frontal_postScout_bd44b73f:

    # "We clambered onto a rooftop of a building near the Black Diamond as soon as night fell across Novaras."
    "Wir kletterten auf das Dach eines Gebäudes in der Nähe des Black Diamond, sobald die Nacht über Novaras hereinbrach."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:18
translate de qst_DamzelDizzt_2_frontal_postScout_165aa9d8:

    # "Both me and Markus waited in position in our {i}‘other’{/i} forms as we listened out for the loud whizzing sounds of the fire sticks."
    "Sowohl ich als auch Markus warteten in Position, in unseren {i}‘anderen’{/i} Gestalten, während wir auf die lauten zischenden Geräusche der Feuerstäbe lauschten."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:19
translate de qst_DamzelDizzt_2_frontal_postScout_cc2f6184:

    # "Explosions loudly began to boom as they began blossoming into pretty color patterns, lighting up the night sky."
    "Explosionen begannen laut zu donnern, als sie in hübschen Farbmustern erblühten und den Nachthimmel erleuchteten."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:21
translate de qst_DamzelDizzt_2_frontal_postScout_475abc9b:

    # MC "Looks like Nijah came through..."
    MC "Sieht so aus, als hätte Nijah es geschafft..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:22
translate de qst_DamzelDizzt_2_frontal_postScout_c5bd6c6c:

    # "Markus turned to me and nodded."
    "Markus drehte sich zu mir um und nickte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:27
translate de qst_DamzelDizzt_2_frontal_postScout_8e0c6225:

    # "Clambering down, we moved swiftly over towards the doors of the Black Diamond, and together,"
    "Wir kletterten hinunter, bewegten uns schnell zu den Türen des Black Diamond, und gemeinsam,"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:28
translate de qst_DamzelDizzt_2_frontal_postScout_c515447b:

    # "We wasted no time bashing our way through inside."
    "Wir vergeudeten keine Zeit und bahnten uns mit Gewalt den Weg hinein."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:32
translate de qst_DamzelDizzt_2_frontal_postScout_0e6f8a15:

    # "Screams and shouts erupted as half naked dancers fled for the nearest exits."
    "Schreie und Rufe brachen aus, als halbnackte Tänzer zu den nächsten Ausgängen flohen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:33
translate de qst_DamzelDizzt_2_frontal_postScout_21020f3b:

    # "Tables filled with coin and cards were flipped as the guards drew their sabres onto us in a frenzied panic, shouting to each other about monsters."
    "Tische voller Münzen und Karten wurden umgestoßen, als die Wachen in wilder Panik ihre Säbel auf uns zogen und einander etwas über Monster zuriefen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:34
translate de qst_DamzelDizzt_2_frontal_postScout_7500ee8a:

    # "Those in the drug induced haze of the opium turn to look at us from their beds with confusion in their eyes,"
    "Diejenigen, die im drogeninduzierten Rausch des Opiums lagen, drehten sich von ihren Betten aus zu uns um, mit Verwirrung in den Augen,"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:35
translate de qst_DamzelDizzt_2_frontal_postScout_a96ead46:

    # "Unsure if what they saw were seeing was some illusion from chasing the dragon."
    "Unsicher, ob das, was sie sahen, eine Illusion vom Drachenjagen war."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:38
translate de qst_DamzelDizzt_2_frontal_postScout_a09cd1e4:

    # BANDIT @ talk "Monsters! MONSTERS! Kill them! Kill them now!"
    BANDIT @ talk "Monster! MONSTER! Tötet sie! Tötet sie jetzt!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:39
translate de qst_DamzelDizzt_2_frontal_postScout_2310b5cd:

    # MC "(We don't have long! We have to finish this before the guards arrive!)"
    MC "(Wir haben nicht viel Zeit! Wir müssen das erledigen, bevor die Wachen eintreffen!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:48
translate de qst_DamzelDizzt_2_frontal_postScout_2d761257:

    # MC "{i}*Huff* *Huff*{/i}"
    MC "{i}*Keuch* *Keuch*{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:49
translate de qst_DamzelDizzt_2_frontal_postScout_71883944:

    # MC "(Hell, there's more!)"
    MC "(Verdammt, da sind noch mehr!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:56
translate de qst_DamzelDizzt_2_frontal_postScout_1ff369e4:

    # "The Black Diamond became a fury of red mist and screams as the two of us cut down man after man as they came for us."
    "Der Schwarze Diamant wurde zu einer brodelnden roten Nebelwand voller Schreie, während wir beide einen nach dem anderen niedermetzelten, die auf uns zugestürmt kamen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:57
translate de qst_DamzelDizzt_2_frontal_postScout_b7c99f9e:

    # "Limb from limb we tore and slashed, the walls painted in long streaks of red blood as the adrenaline coursed through me."
    "Wir rissen und schlitzten Glied für Glied ab, die Wände waren mit langen Streifen roten Blutes bemalt, während das Adrenalin durch meine Adern schoss."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:58
translate de qst_DamzelDizzt_2_frontal_postScout_4cd980b2:

    # "I could hardly control myself anymore, the dark impulses inside of me seemed to steer my every move as my claws stained with blood dripped onto the cold floor."
    "Ich konnte mich kaum noch beherrschen, die dunklen Impulse in mir schienen jede meiner Bewegungen zu lenken, während das Blut von meinen befleckten Klauen auf den kalten Boden tropfte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:59
translate de qst_DamzelDizzt_2_frontal_postScout_91a51787:

    # "Fear, panic, {i}fury{/i} the emotions run a gauntlet as we turned the place into a kind of nightmare scarely read about only in the darkest of tales."
    "Angst, Panik, {i}Wut{/i} – die Emotionen jagten einander, während wir den Ort in einen Albtraum verwandelten, wie man ihn nur aus den dunkelsten Sagen kennt."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:60
translate de qst_DamzelDizzt_2_frontal_postScout_e2568e7e:

    # "Finally, I heard a whistle and twisted my body to look towards the sound."
    "Schließlich hörte ich ein Pfeifen und drehte meinen Körper, um in Richtung des Geräuschs zu schauen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:66
translate de qst_DamzelDizzt_2_frontal_postScout_27b9fc48:

    # TAREK @ angry "So... The inquisitors have finally made their move I see."
    TAREK @ angry "Also... Die Inquisitoren haben endlich ihren Zug gemacht, wie ich sehe."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:67
translate de qst_DamzelDizzt_2_frontal_postScout_fe3619a2:

    # TAREK @ angry "And they send monsters to slay me!"
    TAREK @ angry "Und sie schicken Monster, um mich zu töten!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:68
translate de qst_DamzelDizzt_2_frontal_postScout_a98c6e63:

    # "I growled and began to step towards Tarek as he drew his blade."
    "Ich knurrte und begann, auf Tarek zuzugehen, während er seine Klinge zog."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:69
translate de qst_DamzelDizzt_2_frontal_postScout_726f617c:

    # "Markus followed behind as we snarled towards him, ready to leap forward and slash and tear him to pieces!"
    "Markus folgte hinter mir, während wir ihn anknurrten, bereit, vorzuspringen und ihn zu zerfleischen!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:70
translate de qst_DamzelDizzt_2_frontal_postScout_59da8ec9:

    # TAREK @ angry "NOW!"
    TAREK @ angry "JETZT!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:72
translate de qst_DamzelDizzt_2_frontal_postScout_00407283:

    # "Suddenly, from the upper floors poured out more men to surround us, and beneath us we felt the floor open up and swallow us whole."
    "Plötzlich strömten von den oberen Stockwerken weitere Männer hervor, um uns zu umzingeln, und unter uns spürten wir, wie sich der Boden öffnete und uns ganz verschluckte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:73
translate de qst_DamzelDizzt_2_frontal_postScout_362c82ca:

    # "I tried to use my tentacles to grip into the walls, but they coated in a thick black like slime that I couldn't get any grip into."
    "Ich versuchte, meine Tentakel einzusetzen, um mich an den Wänden festzuhalten, aber sie waren mit einem dicken schwarzen Schleim überzogen, an dem ich keinen Halt finden konnte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:74
translate de qst_DamzelDizzt_2_frontal_postScout_55413c12:

    # "Markus tried to fly upwards but I collided against him, sending us tumbling down in freefall."
    "Markus versuchte, nach oben zu fliegen, aber ich prallte gegen ihn, und wir stürzten im freien Fall hinab."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:75
translate de qst_DamzelDizzt_2_frontal_postScout_c680916b:

    # "Faling deep into the darkness, we finally slammed into the concrete ground below."
    "Tief in die Dunkelheit fallend, schlugen wir schließlich auf dem Betonboden unten auf."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:76
translate de qst_DamzelDizzt_2_frontal_postScout_e3195a34:

    # "Slightly dazed, I rose from my feet to see we had fallen into some section of the sewers below."
    "Leicht benommen erhob ich mich und sah, dass wir in einen Abschnitt der Kanalisation unten gefallen waren."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:85
translate de qst_DamzelDizzt_2_frontal_postScout_f1a3637e:

    # "Looking up towards the opening of the trap door above us, I could hear Tarek's men laugh as he crouched down over the hole to torment us."
    "Als ich zur Öffnung der Falltür über uns hinaufsah, konnte ich Tareks Männer lachen hören, während er sich über das Loch hockte, um uns zu quälen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:86
translate de qst_DamzelDizzt_2_frontal_postScout_d1826011:

    # TAREK @ smile "I know not what beasts you are, but did you truly think you could just walk in here and kill me?"
    TAREK @ smile "Ich weiß nicht, was für Bestien ihr seid, aber habt ihr wirklich gedacht, ihr könntet einfach hier hereinkommen und mich töten?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:87
translate de qst_DamzelDizzt_2_frontal_postScout_f0582794:

    # "From the darkness I could hear feet loudly scuttering towards us."
    "Aus der Dunkelheit konnte ich Füße laut auf uns zukrabbeln hören."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:88
translate de qst_DamzelDizzt_2_frontal_postScout_4a46adb2:

    # TAREK @ smile "Took us weeks to capture her, they've been turning up all over the Valley of Death recently."
    TAREK @ smile "Wir haben Wochen gebraucht, um sie zu fangen. In letzter Zeit tauchen sie überall im Tal des Todes auf."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:89
translate de qst_DamzelDizzt_2_frontal_postScout_ab641191:

    # TAREK "Took out a few of our best to take her in, but I think it was worth it in the end!"
    TAREK "Es hat einige unserer Besten das Leben gekostet, sie zu fangen, aber ich denke, am Ende hat es sich gelohnt!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:90
translate de qst_DamzelDizzt_2_frontal_postScout_e0635590:

    # MARKUS "(Fuck! [player_name!t]! What do we do?)"
    MARKUS "(Scheiße! [player_name!t]! Was machen wir?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:91
translate de qst_DamzelDizzt_2_frontal_postScout_19d411bc:

    # MC "(Shit! He can't mean-)"
    MC "(Mist! Er kann nicht meinen-)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:92
translate de qst_DamzelDizzt_2_frontal_postScout_ee2a11b8:

    # TAREK "Ever heard of Choza? Its like the opposite to Raza... They used to give it to Ramonian warriors before battle, make sure they would fucking slaughter anything in their path."
    TAREK "Schon mal von Choza gehört? Es ist wie das Gegenteil von Raza... Sie gaben es Ramonianischen Kriegern vor der Schlacht, um sicherzustellen, dass sie alles in ihrem Weg verdammt noch mal abschlachten würden."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:93
translate de qst_DamzelDizzt_2_frontal_postScout_cc6d58e8:

    # TAREK "They stopped using it when the men went insane."
    TAREK "Sie hörten damit auf, als die Männer wahnsinnig wurden."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:94
translate de qst_DamzelDizzt_2_frontal_postScout_dba6500a:

    # TAREK @ smile "So we figured, {i}'why not feed it some of that with every meal?'{/i}"
    TAREK @ smile "Also dachten wir, {i}'warum füttern wir es nicht mit jeder Mahlzeit davon?'{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:96
translate de qst_DamzelDizzt_2_frontal_postScout_9e57c03d:

    # UNKNOWN "{i}*Clatter! Clatter! Clatter!*{/i}"
    UNKNOWN "{i}*Ratter! Ratter! Ratter!*{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:97
translate de qst_DamzelDizzt_2_frontal_postScout_146ba5db:

    # "In that moment, from the darkness it appears, snapping it's claws as it scurried out from the darkness."
    "In diesem Moment erscheint es aus der Finsternis, schnappt mit seinen Klauen, während es aus der Dunkelheit huscht."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:99
translate de qst_DamzelDizzt_2_frontal_postScout_02c3f02a:

    # TAREK @ angry "Dinner time Betsy!"
    TAREK @ angry "Essenszeit, Betsy!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:101
translate de qst_DamzelDizzt_2_frontal_postScout_a70c5cab:

    # MC "(FUCK!)"
    MC "(VERDAMMT!)"

