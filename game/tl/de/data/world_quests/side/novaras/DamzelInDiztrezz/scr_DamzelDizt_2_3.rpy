    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:59
    old "{image=[ICON.DEATH]} I'll tear you limb from fucking limb!"
    new "{image=[ICON.DEATH]} Ich reiße dich in Stücke, verdammt!"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:140
    old "Okay! Give us the girl and you can live!"
    new "Okay! Gib uns das Mädchen und du kannst leben!"

