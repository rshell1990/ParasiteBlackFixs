    new "{image=[ICON.HEART_BROKE]} Wir wollen Gold im Austausch für Nijah, wir wissen, dass du sie willst."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:19
    old "{image=[ICON.SWORDS]} Are you ready for the sweet embrace of death?"
    new "{image=[ICON.SWORDS]} Bist du bereit für die süße Umarmung des Todes?"

