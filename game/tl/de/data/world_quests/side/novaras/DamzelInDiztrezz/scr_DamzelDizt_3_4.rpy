    MC @ talk "Zum Mitnehmen auf deinen Reisen. Ein Begleiter für... {i}all deine Bedürfnisse.{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:110
translate de qst_DamzelDizzt_3_talkTarek_successCharm_4e34dc0e:

    # "Nijah looked away in disgust as Tarek smiled."
    "Nijah blickte angewidert weg, als Tarek lächelte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:111
translate de qst_DamzelDizzt_3_talkTarek_successCharm_26a45b77:

    # TAREK "I suppose something good has come from this."
    TAREK "Ich nehme an, dass etwas Gutes daraus entstanden ist."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:112
translate de qst_DamzelDizzt_3_talkTarek_successCharm_dde0c440:

    # "Pouring out the cup of wine, I handed it to him."
    "Ich goss den Becher Wein aus und reichte ihn ihm."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:113
translate de qst_DamzelDizzt_3_talkTarek_successCharm_92e1c239:

    # MC @ talk "For the riches yet to come."
    MC @ talk "Für die Reichtümer, die noch kommen werden."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:114
translate de qst_DamzelDizzt_3_talkTarek_successCharm_e877fb5b:

    # TAREK "Well... That sounds like something I might be willing to drink to."
    TAREK "Nun... Das klingt nach etwas, auf das ich vielleicht anstoßen würde."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:115
translate de qst_DamzelDizzt_3_talkTarek_successCharm_e573f174:

    # "As Tarek held up the cup, he tormentingly remarked to Nijah."
    "Als Tarek den Becher hochhielt, bemerkte er quälend zu Nijah."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:116
translate de qst_DamzelDizzt_3_talkTarek_successCharm_540e8055:

    # TAREK "I always told you in the end you would be mine Nijah, one way or another."
    TAREK "Ich habe dir immer gesagt, dass du am Ende mir gehören würdest, Nijah, auf die eine oder andere Weise."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:117
translate de qst_DamzelDizzt_3_talkTarek_successCharm_fbd49721:

    # NIJAH "..."
    NIJAH "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:118
translate de qst_DamzelDizzt_3_talkTarek_successCharm_dff85687:

    # TAREK "Friends, drink with me."
    TAREK "Freunde, trinkt mit mir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:119
translate de qst_DamzelDizzt_3_talkTarek_successCharm_248b2a40:

    # "Me and Markus shared a nervous glance for a moment."
    "Markus und ich tauschten für einen Moment einen nervösen Blick."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:120
translate de qst_DamzelDizzt_3_talkTarek_successCharm_78f307c6:

    # BLACK "Drink... Fear not..."
    BLACK "Trinkt... Fürchtet euch nicht..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:121
translate de qst_DamzelDizzt_3_talkTarek_successCharm_8ddf6569:

    # "Tarek stared at us uncertainly, guaging our delay and reaction."
    "Tarek starrte uns unsicher an und schätzte unsere Verzögerung und Reaktion ab."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:122
translate de qst_DamzelDizzt_3_talkTarek_successCharm_51d7ad26:

    # TAREK "...Is something wrong friends?"
    TAREK "...Stimmt etwas nicht, Freunde?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:123
translate de qst_DamzelDizzt_3_talkTarek_successCharm_707f20c7:

    # MC @ talk "Not at all Tarek, we just prefer not to drink on the job ourselves."
    MC @ talk "Überhaupt nicht, Tarek, wir ziehen es nur vor, bei der Arbeit selbst nichts zu trinken."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:124
translate de qst_DamzelDizzt_3_talkTarek_successCharm_407c76e6:

    # "Feigning as much confidence as I could, I poured me and Markus a cup each."
    "So viel Selbstvertrauen vortäuschend, wie ich konnte, schenkte ich Markus und mir je eine Tasse ein."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:125
translate de qst_DamzelDizzt_3_talkTarek_successCharm_892f9cf9:

    # MC "(Fuck fuck fuck, are we actually about to drink poison? By the gods monster if you're-)"
    MC "(Scheiße, Scheiße, Scheiße, sind wir wirklich dabei, Gift zu trinken? Bei den Göttern, Monster, wenn du-)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:126
translate de qst_DamzelDizzt_3_talkTarek_successCharm_e70f96ee:

    # BLACK "Trust"
    BLACK "Vertraut"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:127
translate de qst_DamzelDizzt_3_talkTarek_successCharm_730215d9:

    # WHITE "Us."
    WHITE "Uns."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:128
translate de qst_DamzelDizzt_3_talkTarek_successCharm_48d0f839:

    # MC "(Should I?)"
    MC "(Sollte ich?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:129
translate de qst_DamzelDizzt_3_talkTarek_successCharm_2ddadf32:

    # MC "(So far these things inside of us have not lied before.)"
    MC "(Bisher haben diese Dinge in uns noch nicht gelogen.)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:130
translate de qst_DamzelDizzt_3_talkTarek_successCharm_09613066:

    # MC "(But now they are asking us to trust them and drink literal poison...)"
    MC "(Aber jetzt verlangen sie von uns, ihnen zu vertrauen und buchstäblich Gift zu trinken...)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:133
translate de qst_DamzelDizzt_3_talkTarek_successCharm_275b6aad:

    # MC @ talk "Neither of us drink, sorry."
    MC @ talk "Keiner von uns trinkt, sorry."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:134
translate de qst_DamzelDizzt_3_talkTarek_successCharm_d10f1028:

    # "Tarek looked down at the cup, the swirling red liquid in his drink before his eyes raised and looked deathly towards us."
    "Tarek blickte auf den Becher hinab, auf die wirbelnde rote Flüssigkeit in seinem Getränk, bevor seine Augen sich hoben und er uns todbringend ansah."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:135
translate de qst_DamzelDizzt_3_talkTarek_successCharm_080e9ca4:

    # TAREK "{i}...Deceivers.{/i}"
    TAREK "{i}...Betrüger.{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:136
