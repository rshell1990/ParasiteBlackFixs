# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:11
translate de qst_DamzelDizzt_5_evidence_d2a4f060:

    # TAREK @ angry "Are you threatening me?"
    TAREK @ angry "Drohst du mir?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:14
translate de qst_DamzelDizzt_5_evidence_396c4462:

    # TAREK @ smile "You are a fool, aren't you?"
    TAREK @ smile "Du bist ein Narr, nicht wahr?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:15
translate de qst_DamzelDizzt_5_evidence_4ea9546e:

    # TAREK @ angry "You think I am not aware of the danger?"
    TAREK @ angry "Glaubst du, ich bin mir der Gefahr nicht bewusst?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:16
translate de qst_DamzelDizzt_5_evidence_72c00c07:

    # TAREK @ angry "Unlike you Alderians, we Ramonians have little rights here, THIS is the only life for many of us thanks to your government!"
    TAREK @ angry "Anders als ihr Alderianer haben wir Ramonianer hier kaum Rechte, DAS ist das einzige Leben für viele von uns, dank eurer Regierung!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:17
translate de qst_DamzelDizzt_5_evidence_41ecf059:

    # MC @ angry "Easy to say now, not so much when the daggers are drawn and surrounding you."
    MC @ angry "Jetzt leicht gesagt, nicht so sehr, wenn die Dolche gezogen sind und dich umzingeln."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:18
translate de qst_DamzelDizzt_5_evidence_6c5e6385:

    # TAREK "Hmph... And Nijah here, why do you care about some Ramonian whore?"
    TAREK "Hmph... Und Nijah hier, warum kümmert dich eine ramonische Hure?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:19
translate de qst_DamzelDizzt_5_evidence_631c5d6b:

    # MC @ talk "My reasons are my own."
    MC @ talk "Meine Gründe sind meine eigenen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:20
translate de qst_DamzelDizzt_5_evidence_b2280e93:

    # TAREK "So you come here, with veiled threats that I will be killed, demand I abandon my kin AND forgive the debt of this whore?"
    TAREK "Also kommst du hierher, mit verschleierten Drohungen, dass ich getötet werde, verlangst, dass ich meine Familie verlasse UND die Schulden dieser Hure erlasse?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:21
translate de qst_DamzelDizzt_5_evidence_94a186ba:

    # TAREK "I have one simple question... Why?"
    TAREK "Ich habe eine einfache Frage... Warum?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:23
translate de qst_DamzelDizzt_5_evidence_fff17fc1:

    # TAREK "I'm strong enough to hold them together."
    TAREK "Ich bin stark genug, um sie zusammenzuhalten."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:24
translate de qst_DamzelDizzt_5_evidence_46d2a07b:

    # TAREK "Under my leadership we've taken more territory than any of them could have hoped to achieve on their own!"
    TAREK "Unter meiner Führung haben wir mehr Territorium eingenommen, als jeder von ihnen allein zu erreichen hoffen konnte!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:25
translate de qst_DamzelDizzt_5_evidence_6ca294ce:

    # TAREK "Why would they risk giving that up?"
    TAREK "Warum sollten sie riskieren, das aufzugeben?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:26
translate de qst_DamzelDizzt_5_evidence_92dc542e:

    # MC @ talk "And what about when you aren't there to hold them together?"
    MC @ talk "Und was, wenn du nicht da bist, um sie zusammenzuhalten?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:27
translate de qst_DamzelDizzt_5_evidence_5ea0bac2:

    # TAREK "What are you talking about?"
    TAREK "Wovon redest du?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:28
translate de qst_DamzelDizzt_5_evidence_9a1ae1bb:

    # TAREK @ angry "Do not try to fool me with mind games!"
    TAREK @ angry "Versuch nicht, mich mit Gedankenspielen zu täuschen!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:29
translate de qst_DamzelDizzt_5_evidence_00141b5b:

    # MC @ talk "I'm not, what about if you get sick or you're arrested by the guards?"
    MC @ talk "Das tue ich nicht, aber was, wenn du krank wirst oder von den Wachen verhaftet wirst?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:30
translate de qst_DamzelDizzt_5_evidence_d444ee8b:

    # MC @ talk "How long will they last without you?"
    MC @ talk "Wie lange werden sie ohne dich durchhalten?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:31
translate de qst_DamzelDizzt_5_evidence_67d49cb2:

    # MC @ talk "The moment you leave, the ensuing void of power in your absence will cause infighting."
    MC @ talk "Sobald du fort bist, wird das Machtvakuum in deiner Abwesenheit zu internen Kämpfen führen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:32
translate de qst_DamzelDizzt_5_evidence_b3581dcf:

    # TAREK @ smile "The guards will never arrest me! Half of them are in my pocket and I am not weak, no sickness will keep me down for long!"
    TAREK @ smile "Die Wachen werden mich nie verhaften! Die Hälfte von ihnen steckt in meiner Tasche, und ich bin nicht schwach – keine Krankheit wird mich lange niederhalten!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:33
translate de qst_DamzelDizzt_5_evidence_038f84ca:

    # MC @ talk "You're missing the point, the moment they sense weakness, this alliance you've formed will turn on you."
    MC @ talk "Du verfehlst den Punkt. Sobald sie Schwäche spüren, wird sich das Bündnis, das du geschmiedet hast, gegen dich wenden."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:34
translate de qst_DamzelDizzt_5_evidence_c30c93a9:

    # MC @ talk "If the guards arrest you even on some fake charge, you'll still be imprisoned for at best, a few days, at worse, months."
    MC @ talk "Wenn die Wachen dich unter einem fadenscheinigen Vorwurf verhaften, wirst du bestenfalls für ein paar Tage, schlimmstenfalls für Monate eingesperrt."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:35
translate de qst_DamzelDizzt_5_evidence_e5ae870b:

    # MC @ talk "How long do you give it before the Vulshans and Khazahs are at each others throats again?"
    MC @ talk "Wie lange, glaubst du, dauert es, bis die Vulshaner und Khazahs sich wieder an die Gurgel gehen?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:36
translate de qst_DamzelDizzt_5_evidence_d73a5865:

    # MC @ talk "How long till one faction decides to try and tip the scales of the alliance in their favor? Or begins pushing other alliance members territory boundaries?"
    MC @ talk "Wie lange dauert es, bis eine Fraktion versucht, das Kräfteverhältnis innerhalb des Bündnisses zu ihren Gunsten zu kippen? Oder damit beginnt, die territorialen Grenzen anderer Bündnismitglieder zu verschieben?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:37
translate de qst_DamzelDizzt_5_evidence_7be73ad4:

    # TAREK "Then I will just bring them back into line once I return!"
    TAREK "Dann werde ich sie einfach wieder auf Linie bringen, wenn ich zurückkehre!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:38
translate de qst_DamzelDizzt_5_evidence_a2b4f7d1:

    # MC @ talk "Tarek... You know this cannot last."
    MC @ talk "Tarek... Du weißt, dass das nicht von Dauer sein kann."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:39
translate de qst_DamzelDizzt_5_evidence_f0ce33c5:

    # MC @ talk "If you are the only thing holding them them together, collapse is inevitable."
    MC @ talk "Wenn du das Einzige bist, das sie zusammenhält, ist der Zusammenbruch unvermeidlich."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:40
translate de qst_DamzelDizzt_5_evidence_1d17e49b:

    # TAREK "...Hmph, perhaps you speak some truth."
    TAREK "...Hmph, vielleicht sprichst du etwas Wahres."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:41
translate de qst_DamzelDizzt_5_evidence_db2b4442:

    # TAREK "But I cannot just abandon my men, not after all we have achieved."
    TAREK "Aber ich kann meine Männer nicht einfach im Stich lassen, nicht nach allem, was wir erreicht haben."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:42
translate de qst_DamzelDizzt_5_evidence_2f2c5a86:

    # MC @ talk "What if I found you proof?"
    MC @ talk "Was, wenn ich dir einen Beweis finde?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:43
translate de qst_DamzelDizzt_5_evidence_287bd128:

    # TAREK "Of what?"
    TAREK "Wovon?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:44
translate de qst_DamzelDizzt_5_evidence_b859745f:

    # MC @ talk "That one of these gang factions is going to betray you."
    MC @ talk "Dass eine dieser Bandenfraktionen dich verraten wird."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:45
translate de qst_DamzelDizzt_5_evidence_a8d72f52:

    # "Tarek pondered the thought for a moment, his eyes staring into my very soul before he spoke."
    "Tarek dachte einen Moment lang über den Gedanken nach, seine Augen starrten in meine Seele, bevor er sprach."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:46
translate de qst_DamzelDizzt_5_evidence_4feb84c7:

    # TAREK "...You're very strange, normally someone would just try and poison me or something."
    TAREK "...Du bist sehr seltsam, normalerweise würde jemand einfach versuchen, mich zu vergiften oder so."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:47
translate de qst_DamzelDizzt_5_evidence_fa11ec69:

    # TAREK @ smile "{i}You{/i} on the other hand, just walk in here and ask me to leave..."
    TAREK @ smile "{i}Du{/i} hingegen spazierst hier einfach rein und verlangst, dass ich gehe..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:48
translate de qst_DamzelDizzt_5_evidence_cb8da35c:

    # MC @ talk "Conflict is not always the answer, I believe I can persuade you to leave peacefully."
    MC @ talk "Konflikt ist nicht immer die Antwort, ich glaube, ich kann dich überreden, friedlich zu gehen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:49
translate de qst_DamzelDizzt_5_evidence_1697554e:

    # TAREK "Tsch, are you a holy man or something? Look around you... There's little room left for mercy in this world."
    TAREK "Tsch, bist du ein Heiliger oder so? Sieh dich um... Es gibt nur noch wenig Platz für Gnade in dieser Welt."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:50
translate de qst_DamzelDizzt_5_evidence_5e998718:

    # MC @ talk "You're wrong, there's always time for mercy."
    MC @ talk "Du irrst dich, es gibt immer Zeit für Gnade."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:51
translate de qst_DamzelDizzt_5_evidence_4be23034:

    # TAREK "...{i}*Sigh*{/i} I cannot believe I am agreeing to this, but very well."
    TAREK "...{i}*Seufz*{/i} Ich kann nicht glauben, dass ich dem zustimme, aber gut."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:52
translate de qst_DamzelDizzt_5_evidence_5e89564a:

    # TAREK "If you can find me proof of impending betrayal, proof that all of {i}this{/i} will fall apart soon."
    TAREK "Wenn du mir Beweise für einen bevorstehenden Verrat bringen kannst, Beweise, dass all {i}das{/i} bald auseinanderfallen wird."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:53
translate de qst_DamzelDizzt_5_evidence_df15c8b7:

    # TAREK "Then I shall take my leave."
    TAREK "Dann werde ich meinen Abschied nehmen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:54
translate de qst_DamzelDizzt_5_evidence_778dd24f:

    # MC @ talk "Then it's settled, I shall find some proof."
    MC @ talk "Dann ist es abgemacht, ich werde Beweise finden."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:55
translate de qst_DamzelDizzt_5_evidence_979fe1f7:

    # TAREK @ angry "Hmph... Don't return unless you have something to show me."
    TAREK @ angry "Hmph... Kehr nicht zurück, es sei denn, du hast mir etwas zu zeigen."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:56
translate de qst_DamzelDizzt_5_evidence_e6efa2ee:

    # TAREK @ angry "Otherwise, you will not walk out of here alive..."
    TAREK @ angry "Andernfalls wirst du hier nicht lebend herausgehen..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:61
translate de qst_DamzelDizzt_5_evidence_632c0c6f:

    # TAREK @ angry "GUARDS! INTRUDER!"
    TAREK @ angry "Wachen! Eindringling!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:62
translate de qst_DamzelDizzt_5_evidence_05bcedd1:

    # MARKUS "You just had to fucking show how ballsy you are, didn't you?"
    MARKUS "Du musstest ja verdammt nochmal zeigen, was für Eier du hast, oder?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:80
translate de qst_DamzelDizzt_5_evidence_initial_40c1fb55:

    # MARKUS @ shock "Why the sudden change in plan?"
    MARKUS @ shock "Warum der plötzliche Planwechsel?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:81
translate de qst_DamzelDizzt_5_evidence_initial_a83e49bb:

    # MC @ talk "If I can avoid unnecessary bloodshed, then so be it."
    MC @ talk "Wenn ich unnötiges Blutvergießen vermeiden kann, dann soll es so sein."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:82
translate de qst_DamzelDizzt_5_evidence_initial_91cfda01:

    # MARKUS "Hmph... Well, next time let me know before you change course suddenly."
    MARKUS "Hmph... Also, nächstes Mal sag mir Bescheid, bevor du plötzlich den Kurs änderst."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:83
translate de qst_DamzelDizzt_5_evidence_initial_2fc786d2:

    # MARKUS @ angry "I was ready to leap across the table and go for his throat!"
    MARKUS @ angry "Ich war bereit, über den Tisch zu springen und ihm an die Kehle zu gehen!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:84
translate de qst_DamzelDizzt_5_evidence_initial_628528ac:

    # MC @ talk "I know but, I feel this is the best way."
    MC @ talk "Ich weiß, aber ich denke, das ist der beste Weg."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:85
translate de qst_DamzelDizzt_5_evidence_initial_49b1ed00:

    # NIJAH @ angry "I do not understand... Tarek iz bad man, everyone would be better off if he were dead!"
    NIJAH @ angry "Ich verstehe nicht... Tarek ist ein schlechter Mensch, alle wären besser dran, wenn er tot wäre!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:86
translate de qst_DamzelDizzt_5_evidence_initial_f2d3ab38:

    # MC @ talk "This is my choice, I prefer not to kill unless I have to."
    MC @ talk "Das ist meine Entscheidung, ich töte lieber nicht, es sei denn, ich muss."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:87
translate de qst_DamzelDizzt_5_evidence_initial_9914b0ff:

    # "Nijah seemed unsure of my decision, but begrudgingly remained silent."
    "Nijah schien sich meiner Entscheidung unsicher, blieb aber widerwillig stumm."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:88
translate de qst_DamzelDizzt_5_evidence_initial_46784c00:

    # MARKUS "What now? Where are we to find this 'proof' that may not even exist?"
    MARKUS "Was nun? Wo sollen wir diesen 'Beweis' finden, der vielleicht gar nicht existiert?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:89
translate de qst_DamzelDizzt_5_evidence_initial_76c17866:

    # MC @ talk "There will be proof, of that I'm certain."
    MC @ talk "Es wird einen Beweis geben, da bin ich mir sicher."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:90
translate de qst_DamzelDizzt_5_evidence_initial_f4dfcfd8:

    # MC @ talk "With all these factions baying for blood, someone will know something around here..."
    MC @ talk "Bei all diesen Fraktionen, die nach Blut lechzen, wird jemand hier etwas wissen..."

