translate de qst_DaughterOfMetal_01_7fb745e1:

    # ARLENA "Yes."
    ARLENA "Ja."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:20
translate de qst_DaughterOfMetal_01_75b10289:

    # MC @ talk "... To have some drinks?"
    MC @ talk "... Um etwas zu trinken?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:21
translate de qst_DaughterOfMetal_01_7fb745e1_1:

