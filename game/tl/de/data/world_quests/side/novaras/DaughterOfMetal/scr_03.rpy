# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:5
translate de qst_DaughterOfMetal_03_3daa2383:

    # ARLENA "Urgh..."
    ARLENA "Urgh..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:6
translate de qst_DaughterOfMetal_03_556151b8:

    # MC @ talk "Morning."
    MC @ talk "Morgen."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:7
translate de qst_DaughterOfMetal_03_8fcc028b:

    # ARLENA "Please, not so loud... Did you come here to drop off some materials?"
    ARLENA "Bitte, nicht so laut... Bist du gekommen, um ein paar Materialien abzugeben?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:8
translate de qst_DaughterOfMetal_03_6a40696d:

    # MC @ talk "No, I came to check in on you."
    MC @ talk "Nein, ich bin gekommen, um nach dir zu sehen."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:9
translate de qst_DaughterOfMetal_03_8c79161e:

    # ARLENA "Hm? Oh, uh..."
    ARLENA "Hm? Oh, äh..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:10
translate de qst_DaughterOfMetal_03_05633e19:

    # ARLENA "I’m okay... other than this splitting headache."
    ARLENA "Mir geht's gut... abgesehen von diesen rasenden Kopfschmerzen."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:11
translate de qst_DaughterOfMetal_03_99100f07:

    # MC @ talk "Anything I can do to help?"
    MC @ talk "Kann ich irgendetwas tun, um zu helfen?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:12
translate de qst_DaughterOfMetal_03_e537525c:

    # ARLENA "Urgh... No, but thanks anyway."
    ARLENA "Urgh... Nein, aber trotzdem danke."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:13
translate de qst_DaughterOfMetal_03_349f1271:

    # "As I turned to leave, Arlena called me back."
    "Als ich mich zum Gehen wandte, rief Arlena mich zurück."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:14
translate de qst_DaughterOfMetal_03_5664a04c:

    # ARLENA "Hey..."
    ARLENA "Hey..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:15
translate de qst_DaughterOfMetal_03_efdddc36:

    # ARLENA "Check in a couple days from now... if you want..."
    ARLENA "Melde dich in ein paar Tagen... wenn du willst..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:16
translate de qst_DaughterOfMetal_03_9e7d1e4e:

    # ARLENA "Think I might have a little job for you if you’re interested."
    ARLENA "Ich denke, ich habe vielleicht einen kleinen Job für dich, wenn du interessiert bist."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:17
translate de qst_DaughterOfMetal_03_2f447204:

    # MC @ talk "What is it?"
    MC @ talk "Was ist es?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:18
translate de qst_DaughterOfMetal_03_c72dbe14:

    # ARLENA "You'll see."
    ARLENA "Du wirst sehen."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:19
translate de qst_DaughterOfMetal_03_5de3e30f:

    # ARLENA "Now if you’ll excuse me, I'd like to go feel sorry for myself some more and lie down in the darkness for a bit..."
    ARLENA "Nun, wenn du mich entschuldigst, ich würde gerne noch ein bisschen Selbstmitleid haben und mich für eine Weile im Dunkeln hinlegen..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:20
translate de qst_DaughterOfMetal_03_a8c8799b:

    # "And with that, still clutching at her head painfully, she limped off to the sanctuary of her bedroom."
    "Und damit humpelte sie, noch immer schmerzhaft ihren Kopf haltend, zur Zuflucht ihres Schlafzimmers."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:23
translate de qst_DaughterOfMetal_03_79212085:

    # DRAX "Bloody girl needs to stop drinking so much!"
    DRAX "Das verdammte Mädchen muss aufhören, so viel zu trinken!"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:26
translate de qst_DaughterOfMetal_03_5921ea83:

    # "Drax piped in with, shaking his head as he continued to work at one of the anvils."
    "Drax warf ein, den Kopf schüttelnd, während er an einem der Ambosse weiterarbeitete."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:27
translate de qst_DaughterOfMetal_03_490e54a5:

    # MC "{i}I wonder what the job is?{/i}"
    MC "{i}Ich frage mich, was der Job wohl ist?{/i}"

