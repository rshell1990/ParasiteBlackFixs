    "Mikas Hände ballten sich zu Fäusten, die sie zusammendrückte."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:915
translate de qst_a_best_friends_path_10_6484a695:

    # MIKA @ sad "I wanted them to know what happened, I wanted-"
    MIKA @ sad "Ich wollte, dass sie wissen, was passiert ist, ich wollte-"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:916
translate de qst_a_best_friends_path_10_13cb12b2:

    # MIKA @ cry "I wanted to tell them I was sorry for failing my friends back then."
    MIKA @ cry "Ich wollte ihnen sagen, dass es mir leid tut, dass ich meine Freunde damals im Stich gelassen habe."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:917
translate de qst_a_best_friends_path_10_632248c1:

    # MC @ sad "...Mika."
    MC @ sad "...Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:918
translate de qst_a_best_friends_path_10_ffbed2c5:

    # DIVINE "You never failed your friends, Mika."
    DIVINE "Du hast deine Freunde nie im Stich gelassen, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:921
translate de qst_a_best_friends_path_10_ce7fc004:

    # "Mika gasped in shock as Sister Divine stepped into the light from the stairway behind us."
    "Mika keuchte vor Schreck, als Schwester Divine aus dem Treppenhaus hinter uns ins Licht trat."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:922
translate de qst_a_best_friends_path_10_5fed5006:

    # MIKA @ shock "S-Siter Divine!"
    MIKA @ shock "S-Schwester Divine!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:925
translate de qst_a_best_friends_path_10_7d803879:

    # DIVINE @ sad "It saddens my heart greatly that you never felt you could share the weight of such a burden with me."
    DIVINE @ sad "Es betrübt mein Herz zutiefst, dass du nie das Gefühl hattest, die Last einer solchen Bürde mit mir teilen zu können."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:926
translate de qst_a_best_friends_path_10_04adfbfb:

    # MIKA @ shock "H-How do you know?"
    MIKA @ shock "W-Woher weißt du das?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:927
translate de qst_a_best_friends_path_10_8977624b:

    # DIVINE @ sad "Zara, after your argument with her, came to my office."
    DIVINE @ sad "Zara kam nach eurem Streit zu mir ins Büro."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:928
translate de qst_a_best_friends_path_10_3e267ff5:

    # DIVINE @ sad "She told me everything about the promise you girls had made to keep things a secret."
    DIVINE @ sad "Sie hat mir alles über das Versprechen erzählt, das ihr Mädchen gegeben hattet, die Dinge geheim zu halten."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:929
translate de qst_a_best_friends_path_10_b4a79b10:

    # "Tears began to sting Mika's face as she was overwhelmed with emotion."
    "Tränen begannen auf Mikas Gesicht zu brennen, als sie von Emotionen überwältigt wurde."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:930
translate de qst_a_best_friends_path_10_1928f7ea:

    # MIKA @ sad "I ... I ..."
    MIKA @ sad "Ich ... ich ..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:931
translate de qst_a_best_friends_path_10_1b3a2e03:

    # "Dropping to her knees, Mika began to sob openly as Sister Divine gently rubbed at her back."
    "Auf die Knie fallend, begann Mika offen zu schluchzen, während Schwester Divine sanft ihren Rücken rieb."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:933
translate de qst_a_best_friends_path_10_c4d7691b:

    # MIKA @ cry "I hate myself! I HATE MYSELF SO MUCH!"
    MIKA @ cry "Ich hasse mich! Ich HASSE MICH SO SEHR!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:934
translate de qst_a_best_friends_path_10_c892c3fb:

    # MIKA @ cry "They were my friends!"
    MIKA @ cry "Sie waren meine Freunde!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:935
translate de qst_a_best_friends_path_10_f2c3d8a4:

    # "Her scratched voice broke and began a high-pitched, desperate cry."
    "Ihre kratzige Stimme brach und begann ein hohes, verzweifeltes Weinen."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:936
translate de qst_a_best_friends_path_10_24c102b0:

    # MIKA @ cry "... I failed them! I failed them all!"
    MIKA @ cry "... Ich habe sie im Stich gelassen! Ich habe sie alle im Stich gelassen!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:937
translate de qst_a_best_friends_path_10_225af866:

    # DIVINE @ sad "Mika! It's alright, Mika!"
    DIVINE @ sad "Mika! Es ist in Ordnung, Mika!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:938
translate de qst_a_best_friends_path_10_90aa22af:

    # "Sister Divine began to cradle Mika's head, pulling her into an embrace."
    "Schwester Divine begann, Mikas Kopf zu wiegen und zog sie in eine Umarmung."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:939
translate de qst_a_best_friends_path_10_197900a1:

    # DIVINE @ sad "No one blames you, you silly girl."
    DIVINE @ sad "Niemand macht dir Vorwürfe, du albernes Mädchen."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:940
translate de qst_a_best_friends_path_10_e4d9561e:

    # DIVINE @ sad "For god's sake, Mika."
    DIVINE @ sad "Um Himmels willen, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:941
translate de qst_a_best_friends_path_10_fcc5cb7d:

    # DIVINE @ sad "Why did you never say? Were you so afraid I would yell at you?"
    DIVINE @ sad "Warum hast du es nie gesagt? Hattest du solche Angst, dass ich dich anschreien würde?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:942
translate de qst_a_best_friends_path_10_191c2dcb:

    # MIKA @ cry "I was afraid I'd only disappoint you again."
    MIKA @ cry "Ich hatte Angst, dass ich dich nur wieder enttäuschen würde."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:943
translate de qst_a_best_friends_path_10_9e2d50df:

    # "Her words seem to have struck a chord with Sister Divine, whose mouth opened to say something, but instead. she chose to simply embrace the girl once again."
    "Ihre Worte schienen bei Schwester Divine etwas ausgelöst zu haben; sie öffnete den Mund, um etwas zu sagen, aber stattdessen. sie entschied sich, das Mädchen einfach noch einmal zu umarmen."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:944
translate de qst_a_best_friends_path_10_5a76c718:

    # DIVINE @ sad "You foolish, foolish girl..."
    DIVINE @ sad "Du törichtes, törichtes Mädchen..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:945
translate de qst_a_best_friends_path_10_a11957d4:

    # "Sister Divine wiped away Mika's tears with her sleeve."
    "Schwester Divine wischte Mika mit ihrem Ärmel die Tränen weg."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:946
translate de qst_a_best_friends_path_10_29e9743d:

    # DIVINE @ sad "You have never been a disappointment to me, Mika."
    DIVINE @ sad "Du warst mir nie eine Enttäuschung, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:947
translate de qst_a_best_friends_path_10_6fee3cf3:

    # DIVINE @ sad "You, nor any of the other girls."
    DIVINE @ sad "Du, und kein einziges der anderen Mädchen."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:948
translate de qst_a_best_friends_path_10_c2471857:

    # "Mika didn't answer; she bowed her head ashamedly to the floor, still sniffling."
    "Mika antwortete nicht; sie senkte beschämt den Kopf zum Boden, immer noch schniefend."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:949
translate de qst_a_best_friends_path_10_4d3cd16e:

    # DIVINE @ sad "We'll speak of this again, just the two of us, do you understand?"
    DIVINE @ sad "Wir werden noch einmal darüber sprechen, nur wir beide, verstehst du?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:950
translate de qst_a_best_friends_path_10_f4592411:

    # "Mika nodded lightly."
    "Mika nickte leicht."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:951
translate de qst_a_best_friends_path_10_5008c17b:

    # DIVINE @ sad "Return to the girl's dorm, Mika."
    DIVINE @ sad "Kehr ins Mädchenwohnheim zurück, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:952
translate de qst_a_best_friends_path_10_f80bce0e:

    # "Mika looked up sheepishly towards me."
    "Mika blickte verlegen zu mir auf."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:953
translate de qst_a_best_friends_path_10_7eb78366:

    # MIKA @ sad "T-Tomorrow..."
    MIKA @ sad "M-Morgen..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:954
translate de qst_a_best_friends_path_10_aca475ab:

    # MIKA @ shock "I won't let you down! I promise!"
    MIKA @ shock "Ich werde dich nicht enttäuschen! Ich verspreche es!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:958
translate de qst_a_best_friends_path_10_39bb73e7:

    # MC @ talk "...Will the families ever receive those letters she wrote?"
    MC @ talk "...Werden die Familien jemals die Briefe erhalten, die sie geschrieben hat?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:959
translate de qst_a_best_friends_path_10_fb9ddaad:

    # DIVINE @ think "No."
    DIVINE @ think "Nein."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:961
translate de qst_a_best_friends_path_10_86429564:

    # DIVINE @ think "To let them out would risk another scandal we can't afford."
    DIVINE @ think "Sie herauszulassen würde einen weiteren Skandal riskieren, den wir uns nicht leisten können."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:962
translate de qst_a_best_friends_path_10_314a3574:

    # "Sister Divine tilted her head towards me, her eyes meeting mine."
    "Schwester Divine neigte ihren Kopf zu mir, ihre Augen trafen meine."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:963
translate de qst_a_best_friends_path_10_4ae73fa7:

    # DIVINE @ think "{i}And Mika must never know that the letters never arrived.{/i}"
    DIVINE @ think "{i}Und Mika darf niemals erfahren, dass die Briefe nie angekommen sind.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:964
translate de qst_a_best_friends_path_10_cd44bde4:

    # "Understanding that was an order, not a suggestion, I nodded in agreement."
    "Da ich verstand, dass dies ein Befehl und kein Vorschlag war, nickte ich zustimmend."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:965
translate de qst_a_best_friends_path_10_a95a5c84:

    # DIVINE @ think "I can sense a great change within Mika... Tomorrow, her training will be complete."
    DIVINE @ think "Ich spüre eine große Veränderung in Mika... Morgen wird ihre Ausbildung abgeschlossen sein."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:967
translate de qst_a_best_friends_path_10_d789b742:

    # MC @ think "How can you be sure?"
    MC @ think "Wie kannst du dir so sicher sein?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:968
translate de qst_a_best_friends_path_10_9dc108f5:

    # DIVINE @ happy "She's still afraid... But she's no longer letting it hold her back."
    DIVINE @ happy "Sie hat immer noch Angst... Aber sie lässt sich nicht mehr davon zurückhalten."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:970
translate de qst_a_best_friends_path_10_fe801dfc:

    # "Sister Divine, without another word, almost glided across the floor as she left."
    "Schwester Divine, ohne ein weiteres Wort, glitt fast über den Boden, als sie ging."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:971
translate de qst_a_best_friends_path_10_e9eb2636:

    # "Her expression was stern, but the pain beneath the mask was visible beneath the cracks."
    "Ihr Ausdruck war streng, aber der Schmerz unter der Maske war durch die Risse sichtbar."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:982
translate de qst_a_best_friends_path_12_796311fa:

    # MIKA @ talk "I - I'm ready for my final test!"
    MIKA @ talk "Ich - ich bin bereit für meine letzte Prüfung!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:985
translate de qst_a_best_friends_path_12_dbf800f2:

    # MIKA @ smile "This time, I'll definitely win!"
    MIKA @ smile "Dieses Mal werde ich definitiv gewinnen!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:995
translate de qst_a_best_friends_path_12_7b2ca3a2:

    # MIKA @ sad "D-Damn it!"
    MIKA @ sad "V-Verdammt!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:996
translate de qst_a_best_friends_path_12_a17c8474:

    # MC @ talk "{i}*Huff*{/i} Don't put yourself down..."
    MC @ talk "{i}*Huff*{/i} Mach dich nicht selbst runter..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:997
translate de qst_a_best_friends_path_12_5aa7d33e:

    # MC @ smile "You're ready, Mika."
    MC @ smile "Du bist bereit, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:998
translate de qst_a_best_friends_path_12_ea52f159:

    # MIKA @ shock "But... {i}I lost!{/i}"
    MIKA @ shock "Aber... {i}Ich habe verloren!{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:999
translate de qst_a_best_friends_path_12_251b742b:

    # MC @ smile "Trust me, you can handle a few Demorai."
    MC @ smile "Vertrau mir, du kannst mit ein paar Demorai fertig werden."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1000
translate de qst_a_best_friends_path_12_4a01728e:

    # MC @ smile "{i}You're ready.{/i}"
    MC @ smile "{i}Du bist bereit.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1002
translate de qst_a_best_friends_path_12_56a568cd:

    # MIKA @ shock "I... {i}I did it!{/i}"
    MIKA @ shock "Ich... {i}Ich habe es geschafft!{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1003
translate de qst_a_best_friends_path_12_d3e6b05e:

    # MC @ smile "Well done, Mika."
    MC @ smile "Gut gemacht, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1004
translate de qst_a_best_friends_path_12_949782d6:

    # MC @ smile "You're definitely ready."
    MC @ smile "Du bist definitiv bereit."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1006
translate de qst_a_best_friends_path_12_805ce692:

    # "Mika leapt into my arms for a tight hug, squealing happily before pulling herself away."
    "Mika sprang in meine Arme für eine feste Umarmung, quiekte glücklich, bevor sie sich zurückzog."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1007
translate de qst_a_best_friends_path_12_a5cfade8:

    # MIKA @ smile "I did it! I can't believe I actually did it!"
    MIKA @ smile "Ich habe es geschafft! Ich kann nicht glauben, dass ich es tatsächlich geschafft habe!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1008
translate de qst_a_best_friends_path_12_48530dcf:

    # MC @ smile "I'll let Sister Divine know you're ready."
    MC @ smile "Ich werde Schwester Divine mitteilen, dass du bereit bist."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1009
translate de qst_a_best_friends_path_12_e1e68368:

    # MIKA @ smile "T-Thank you... [player_name!t]."
    MIKA @ smile "D-Danke... [player_name!t]."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1010
translate de qst_a_best_friends_path_12_458cfc4d:

    # MIKA @ smile "For believing in me."
    MIKA @ smile "Dass du an mich geglaubt hast."

