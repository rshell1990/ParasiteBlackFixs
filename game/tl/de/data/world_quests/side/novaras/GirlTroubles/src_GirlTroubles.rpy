    MC @ talk "Sag es?"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:83
translate de qst_girl_troubles_main_label_menu_4_56ff34f3:

    # DIVINE @ talk "A great white bear, exceptionally rare and particularly aggressive, known as a {i}rhuvan.{/i}"
    DIVINE @ talk "Ein großer weißer Bär, außergewöhnlich selten und besonders aggressiv, bekannt als {i}Rhuvan{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:84
translate de qst_girl_troubles_main_label_menu_4_3f57fbb1:

    # DIVINE @ talk "Their hide is exceptionally prized and could be used as a gift to carry favor with many a lord and such."
    DIVINE @ talk "Ihr Fell ist außergewöhnlich begehrt und könnte als Geschenk genutzt werden, um die Gunst vieler Lords und dergleichen zu erlangen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:85
translate de qst_girl_troubles_main_label_menu_4_2e78ce9d:

    # DIVINE @ talk "Should you be able to slay one of them and bring me its hide, I could give Mika her gardening patch in return."
    DIVINE @ talk "Solltet ihr in der Lage sein, einen von ihnen zu erlegen und mir sein Fell zu bringen, könnte ich Mika im Gegenzug ihr Gartenbeet geben."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:86
translate de qst_girl_troubles_main_label_menu_4_d4880874:

    # MC @ think "Hm, I shall think on it."
    MC @ think "Hm, ich werde darüber nachdenken."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:91
translate de qst_girl_troubles_main_label_menu_4_ea37f955:

    # DIVINE @ happy "Yes, I've {i}seen.{/i}"
    DIVINE @ happy "Ja, ich habe es {i}gesehen.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:92
translate de qst_girl_troubles_main_label_menu_4_ad7cb217:

    # DIVINE @ happy "She's come so much out of her shell since you've started helping her."
    DIVINE @ happy "Sie ist so sehr aus sich herausgekommen, seit ihr angefangen habt, ihr zu helfen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:93
translate de qst_girl_troubles_main_label_menu_4_6648b615:

    # MC @ talk "She's ready to face whatever's out there."
    MC @ talk "Sie ist bereit, sich allem zu stellen, was da draußen ist."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:94
translate de qst_girl_troubles_main_label_menu_4_d48d0774:

    # DIVINE @ talk "Well... No one's truly ever {i}ready.{/i}"
    DIVINE @ talk "Nun… Niemand ist jemals wirklich {i}bereit.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:95
translate de qst_girl_troubles_main_label_menu_4_fdf7a669:

    # DIVINE @ talk "But I think now her fate is in the hands of the gods to keep her safe."
    DIVINE @ talk "Aber ich denke, jetzt liegt ihr Schicksal in den Händen der Götter, um sie zu beschützen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:96
translate de qst_girl_troubles_main_label_menu_4_c7d53906:

    # DIVINE @ happy "Well done, [player_name!t], here's your reward..."
    DIVINE @ happy "Gut gemacht, [player_name!t], hier ist deine Belohnung…"

