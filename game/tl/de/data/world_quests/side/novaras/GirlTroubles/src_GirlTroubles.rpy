translate de qst_girl_troubles_main_label_menu_4_c3ec61e5:

    # DIVINE @ talk "Well ... There is {i}one{/i} thing that I believe could persuade me."
    DIVINE @ talk "Nun ... Es gibt {i}eine{/i} Sache, von der ich glaube, dass sie mich überzeugen könnte."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:82
translate de qst_girl_troubles_main_label_menu_4_fd215e94:

