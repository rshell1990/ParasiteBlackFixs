translate de qst_girl_troubles_main_label_menu_3_4caa9ae7:

    # MC @ lewd "Oh, don't worry, I plan on making it {i}unforgettable{/i} for you."
    MC @ lewd "Oh, mach dir keine Sorgen, ich habe vor, es für dich {i}unvergesslich{/i} zu machen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:57
translate de qst_girl_troubles_main_label_menu_3_8422454d:

    # "Sister Divine let out another excited, trembling hot breath as she tried to keep herself composed."
    "Schwester Divine stieß einen weiteren aufgeregten, zitternden heißen Atem aus, während sie versuchte, sich zu fassen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:58
translate de qst_girl_troubles_main_label_menu_3_37a611c2:

    # DIVINE @ lewd "I look forward to it ... Now tell Mika she has her farming patch, for now, at least."
    DIVINE @ lewd "Ich freue mich darauf ... Sag Mika jetzt, dass sie ihr Ackerbeet hat, zumindest vorerst."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:63
translate de qst_girl_troubles_main_label_menu_3_3b9bc389:

    # DIVINE @ talk "Hmm ... I suppose coin would certainly soften the blow of any criticisms at the next council meeting."
    DIVINE @ talk "Hmm ... Ich nehme an, Münzen würden die Wucht etwaiger Kritik bei der nächsten Ratssitzung sicherlich abfedern."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:64
