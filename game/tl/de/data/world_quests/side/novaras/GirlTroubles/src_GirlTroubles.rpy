translate de qst_girl_troubles_main_label_menu_4_e2005c67:

    # DIVINE @ happy "Very good. Tell Mika the patch she wants is hers, at least for now."
    DIVINE @ happy "Sehr gut. Sag Mika, dass das Beet, das sie will, ihr gehört, zumindest vorerst."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:74
translate de qst_girl_troubles_main_label_menu_4_fddc0898:

    # DIVINE @ talk "Urgh, very well, I suppose I can make do with two thousand ... But not a coin less!"
    DIVINE @ talk "Urgh, nun gut, ich nehme an, ich kann mit zweitausend auskommen ... Aber keine Münze weniger!"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:77
translate de qst_girl_troubles_main_label_menu_4_0659d7ff:

    # DIVINE @ talk "I can't go to the council without some kind of offering to ease any questions."
    DIVINE @ talk "Ich kann nicht zum Rat gehen, ohne eine Art Opfergabe, um eventuelle Fragen zu beschwichtigen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:78
translate de qst_girl_troubles_main_label_menu_4_7fefe1d1:

    # DIVINE @ talk "Return when you have the coin..."
    DIVINE @ talk "Komm zurück, wenn du die Münzen hast ..."

