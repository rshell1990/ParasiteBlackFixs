translate de qst_girl_troubles_main_label_menu_4_c0800976:

    # DIVINE @ talk "{i}Intimate?{/i}"
    DIVINE @ talk "{i}Intim?{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:104
translate de qst_girl_troubles_main_label_menu_4_46740ede:

    # "Suddenly realizing what Mika was asking for, Sister Divine panicked as she offered sheepish protest."
    "Plötzlich erkennend, wonach Mika verlangte, geriet Schwester Divine in Panik und protestierte verlegen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:105
translate de qst_girl_troubles_main_label_menu_4_f18d7bb4:

    # DIVINE @ shock "I- I never cross boundaries with any of the girls! I-I'm their-"
    DIVINE @ shock "I- Ich überschreite niemals Grenzen bei den Mädchen! I-Ich bin ihre-"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:106
translate de qst_girl_troubles_main_label_menu_4_289c6df4:

    # MC @ talk "Sister Divine, Mika told me everything."
    MC @ talk "Schwester Divine, Mika hat mir alles erzählt."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:107
translate de qst_girl_troubles_main_label_menu_4_d9eff049:

    # DIVINE @ sad "... I see."
    DIVINE @ sad "... Ich verstehe."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:108
translate de qst_girl_troubles_main_label_menu_4_61e8ed36:

    # DIVINE @ sad "I - I understand this probably isn't something you approve of, but..."
    DIVINE @ sad "Ich - ich verstehe, das ist wahrscheinlich nichts, was Sie gutheißen, aber..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:109
translate de qst_girl_troubles_main_label_menu_4_d23b7c9a:

    # DIVINE @ sad "Kindly keep this knowledge to yourself."
    DIVINE @ sad "Behalten Sie dieses Wissen bitte für sich."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:110
translate de qst_girl_troubles_main_label_menu_4_7bdaee64:

    # DIVINE @ sad "The girls ... Us Mages of Palam, it's a terribly lonely life."
    DIVINE @ sad "Die Mädchen ... Wir Magierinnen von Palam, es ist ein schrecklich einsames Leben."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:111
translate de qst_girl_troubles_main_label_menu_4_e13d3ea2:

    # DIVINE @ sad "The expectations to be these saint-like figures is crushing, especially for those who don't want it."
    DIVINE @ sad "Die Erwartungen, diese heiligenartigen Gestalten zu sein, sind erdrückend, besonders für die, die es nicht wollen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:112
translate de qst_girl_troubles_main_label_menu_4_d6fdf35c:

    # DIVINE @ sad "A life without love is terrible, and love to a Mage of Palam is a delicate, often impossible thing to keep."
    DIVINE @ sad "Ein Leben ohne Liebe ist schrecklich, und Liebe ist für eine Magierin von Palam etwas Zartes, oft Unmögliches zu bewahren."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:113
translate de qst_girl_troubles_main_label_menu_4_3a76119c:

    # DIVINE @ sad "But grown women still have needs ... So we find what we can of it amongst ourselves."
    DIVINE @ sad "Aber erwachsene Frauen haben immer noch Bedürfnisse ... Also finden wir untereinander, was wir davon kriegen können."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:114
translate de qst_girl_troubles_main_label_menu_4_10285b36:

    # MC @ talk "You don't need to explain yourself to me, sister."
    MC @ talk "Du musst dich mir nicht erklären, Schwester."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:115
translate de qst_girl_troubles_main_label_menu_4_4014a5dc:

    # MC @ talk "I only mentioned it because Mika has asked me to persuade you to give her the same affection as you give the others."
    MC @ talk "Ich habe es nur erwähnt, weil Mika mich gebeten hat, dich zu überreden, ihr die gleiche Zuneigung zu schenken wie den anderen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:116
translate de qst_girl_troubles_main_label_menu_4_c7f64210:

    # DIVINE @ sad "I-"
    DIVINE @ sad "Ich-"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:117
translate de qst_girl_troubles_main_label_menu_4_cc9e4cc1:

    # DIVINE @ talk "I didn't quite realize she felt that way, I never intended to make her feel unwanted."
    DIVINE @ talk "Mir war nicht ganz klar, dass sie so empfindet, ich wollte nie, dass sie sich unerwünscht fühlt."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:118
translate de qst_girl_troubles_main_label_menu_4_91c8563f:

    # DIVINE @ embar "... Very well, tell Mika to meet me in the tower bathhouse tonight."
    DIVINE @ embar "... Na gut, sag Mika, sie soll mich heute Abend im Turmbad treffen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:119
translate de qst_girl_troubles_main_label_menu_4_6ab76246:

    # DIVINE @ embar "I shall make it up to her in full."
    DIVINE @ embar "Ich werde es voll und ganz bei ihr wiedergutmachen."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:124
translate de qst_girl_troubles_main_label_menu_4_281e28d6:

    # DIVINE @ talk "Very well then."
    DIVINE @ talk "Also gut."

