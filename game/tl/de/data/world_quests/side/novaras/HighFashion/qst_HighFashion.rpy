# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:33
translate de divine_dros_crystal_057ee5b6:

    # DIVINE "Oh... {i}That elf.{/i}"
    DIVINE "Oh... {i}Diese Elfe.{/i}"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:34
translate de divine_dros_crystal_c1d19001:

    # MC @ talk "Could you help me out at all?"
    MC @ talk "Könntest du mir irgendwie helfen?"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:35
translate de divine_dros_crystal_4cb9c127:

    # DIVINE "Hmm... As I explained to him, even if we COULD sell him one, power crystals such as these are not the easiest things to come by..."
    DIVINE "Hmm... Wie ich ihm erklärte, selbst wenn wir ihm einen verkaufen KÖNNTEN, sind solche Kraftkristalle nicht gerade einfach zu bekommen..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:36
translate de divine_dros_crystal_7cefc073:

    # DIVINE "{i}Or the cheapest.{/i}"
    DIVINE "{i}Oder die günstigsten.{/i}"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:37
translate de divine_dros_crystal_bffffd5e:

    # MC @ talk "There must be something I can do..."
    MC @ talk "Es muss doch etwas geben, das ich tun kann..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:38
translate de divine_dros_crystal_fedb36ea:

    # DIVINE "... Well, we are having a small crisis at the moment in the Sub-Basement."
    DIVINE "... Nun, wir haben gerade eine kleine Krise im Untergeschoss."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:39
translate de divine_dros_crystal_e291577e:

    # MC @ talk "... Crisis?"
    MC @ talk "... Krise?"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:40
translate de divine_dros_crystal_f55710b2:

    # DIVINE "Sister Gracen took it upon herself to fool around with a couple of conjurors in the Sub-Basement."
    DIVINE "Schwester Gracen nahm es auf sich, mit ein paar Beschwörern im Untergeschoss herumzuspielen."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:41
translate de divine_dros_crystal_7f18fdc8:

    # DIVINE "Apparently, they were merely trying to see if they could conjure up some form of light spirit."
    DIVINE "Offenbar versuchten sie lediglich herauszufinden, ob sie eine Art Lichtgeist beschwören könnten."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:42
translate de divine_dros_crystal_ca98255b:

    # MC @ talk "... They didn’t conjure up a ‘light spirit’, I take it?"
    MC @ talk "... Sie haben wohl keinen ‚Lichtgeist‘ beschworen, oder?"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:43
translate de divine_dros_crystal_db29dc8e:

    # DIVINE "{i}No... No, they did not.{/i}"
    DIVINE "{i}Nein... Nein, das haben sie nicht.{/i}"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:44
translate de divine_dros_crystal_92e008b1:

    # DIVINE "We’ve sealed off the Sub-Basement until the Inquisitors can arrive to deal with the matter but..."
    DIVINE "Wir haben den Unterkeller abgeriegelt, bis die Inquisitoren eintreffen können, um sich der Sache anzunehmen, aber..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:45
translate de divine_dros_crystal_7442450d:

    # DIVINE "If {i}you{/i} can sort it out somehow and we were able to avoid an investigation, I would be eternally grateful."
    DIVINE "Wenn {i}du{/i} es irgendwie regeln könntest und wir eine Untersuchung vermeiden könnten, wäre ich dir auf ewig dankbar."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:46
translate de divine_dros_crystal_63606700:

    # MC @ talk "Uhh... I’m just a human though."
    MC @ talk "Ähh... Ich bin doch nur ein Mensch."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:48
translate de divine_dros_crystal_67412659:

    # "Sister Divine curiously smiled at the comment."
    "Schwester Divine lächelte neugierig über die Bemerkung."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:49
translate de divine_dros_crystal_a26b14a4:

    # DIVINE "... Of course you are."
    DIVINE "... Natürlich bist du das."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:50
translate de divine_dros_crystal_a5ac5435:

    # MC "(... Does she suspect something about me?)"
    MC "(... Verdächtigt sie mich etwa?)"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:52
translate de divine_dros_crystal_49f56af4:

    # BLACK "(Her heart rate has remained at a steady rate this whole time... She is totally calm.)"
    BLACK "(Ihre Herzfrequenz ist die ganze Zeit konstant geblieben... Sie ist völlig ruhig.)"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:53
translate de divine_dros_crystal_112212b1:

    # DIVINE "Or... We could skip the pleasantries."
    DIVINE "Oder... Wir könnten die Höflichkeiten überspringen."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:54
translate de divine_dros_crystal_489ffcef:

    # DIVINE "You can have the crystal for 1500 gold."
    DIVINE "Du kannst den Kristall für 1500 Gold haben."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:58
translate de divine_dros_crystal_menu_01e4fbde:

    # DIVINE "Your call, warrior."
    DIVINE "Deine Entscheidung, Krieger."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:62
translate de divine_dros_crystal_menu_009b0b7e:

    # DIVINE "... Hm... Disappointing but..."
    DIVINE "... Hm... Enttäuschend, aber..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:63
translate de divine_dros_crystal_menu_1eb99ef3:

    # DIVINE "Very well, here is the crystal you seek..."
    DIVINE "Nun gut, hier ist der Kristall, den du suchst..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:65
translate de divine_dros_crystal_menu_6a32abb5:

    # DIVINE "{i}*Sigh*{/i} Now to wait for the Inquisitors to arrive, I suppose."
    DIVINE "{i}*Seufz*{/i} Jetzt heißt es wohl warten, bis die Inquisitoren eintreffen."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:66
translate de divine_dros_crystal_menu_229aea30:

    # DIVINE "What a bloody mess."
    DIVINE "Was für ein verdammtes Chaos."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:70
translate de divine_dros_crystal_menu_d0b37451:

    # DIVINE "Wonderful!"
    DIVINE "Wunderbar!"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:71
translate de divine_dros_crystal_menu_cfda152c:

    # DIVINE "I’ll lead you to the entrance to the Sub-Basement."
    DIVINE "Ich führe dich zum Eingang zum Untergeschoss."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:75
translate de divine_dros_crystal_menu_e1f6066f:

    # DIVINE "Don’t take too long... Every moment you wait, the more likely it becomes that the Inquisitors will arrive and start asking impertinent questions."
    DIVINE "Lass dir nicht zu viel Zeit... Je länger du wartest, desto wahrscheinlicher wird es, dass die Inquisitoren eintreffen und anfangen, unverschämte Fragen zu stellen."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:79
translate de dros_givecrystal_43c6f871:

    # DROS @ talk "Did you bring the crystal?"
    DROS @ talk "Hast du den Kristall mitgebracht?"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:80
translate de dros_givecrystal_558dfff1:

    # MC @ talk "Yep, here it is."
    MC @ talk "Jap, hier ist er."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:81
translate de dros_givecrystal_9882bcbd:

    # DROS @ talk "Give it to me!"
    DROS @ talk "Gib es mir!"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:85
translate de dros_givecrystal_d7d75f1a:

    # MC @ talk "Whoa, whoa, remember your end of the deal?"
    MC @ talk "Wow, wow, denk an unsere Abmachung?"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:86
translate de dros_givecrystal_de9f44ad:

    # DROS @ talk "Urgh, fine!"
    DROS @ talk "Urgh, na gut!"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:87
translate de dros_givecrystal_bf788972:

    # DROS @ talk "Here, your gold..."
    DROS @ talk "Hier, dein Gold..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:94
translate de dros_givecrystal_6da9f557:

    # "Taking the crystal, Dros Ulvrak slotted it into some strange contraption."
    "Den Kristall nehmend, steckte Dros Ulvrak ihn in eine seltsame Vorrichtung."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:99
translate de dros_givecrystal_a4265441:

    # "I watched dumfounded as the whole shop abruptly came to life."
    "Ich sah verblüfft zu, wie der ganze Laden plötzlich zum Leben erwachte."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:100
translate de dros_givecrystal_8efa0a34:

    # "The strange machines were no longer motionless, coming alive, they began to work in synchronized automated unison as they stitched away at fancy fabrics on the workshop bench."
    "Die seltsamen Maschinen waren nicht mehr bewegungslos; sie erwachten zum Leben und begannen in synchronisierter automatischer Einheit zu arbeiten, während sie auf der Werkbank an edlen Stoffen nähten."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:102
translate de dros_givecrystal_feda201a:

    # DROS @ smile "Perfect!"
    DROS @ smile "Perfekt!"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:103
translate de dros_givecrystal_794b11b3:

    # DROS @ talk "Time to work some beauty into this city!"
    DROS @ talk "Zeit, dieser Stadt etwas Schönheit zu verleihen!"

