translate de scr_ReadingMaterial_primer_cf0b02d4:

    # ELENA @ talk "It's fine, I'll just wander around in my wolf form and bring you what I find."
    ELENA @ talk "Es ist in Ordnung, ich werde einfach in meiner Wolfsgestalt herumstreifen und dir bringen, was ich finde."

# game/data/world_quests/side/novaras/ReadingMaterial/scr_ReadingMaterial.rpy:21
