# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:2
translate de scr_SharedInThorns_luciusClue_19f59329:

    # LUCIUSMAL "Hmm?"
    LUCIUSMAL "Hmm?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:3
translate de scr_SharedInThorns_luciusClue_d47f39e8:

    # LUCIUSMAL "The Thornfalls you say? As in the now deceased Lord Vront's line?"
    LUCIUSMAL "Die Thornfalls, sagst du? Wie in der Linie des nun verstorbenen Lord Vront?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:4
translate de scr_SharedInThorns_luciusClue_04ca5118:

    # LUCIUSMAL "Hmmmm... Yes, I know one or two things told to me by some little birds through the grape vine."
    LUCIUSMAL "Hmmmm... Ja, ich weiß das ein oder andere, was mir einige kleine Vögelchen durch die Gerüchteküche zugetragen haben."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:5
translate de scr_SharedInThorns_luciusClue_bb12bf45:

    # LUCIUSMAL "But tell me, what is this information worth to you?"
    LUCIUSMAL "Aber sag mir, was ist dir diese Information wert?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:6
translate de scr_SharedInThorns_luciusClue_b544dc14:

    # MC @ angry "Let me guess, your pouch is awfully light of coin today, right?"
    MC @ angry "Lass mich raten, dein Beutel ist heute schrecklich leicht an Münzen, oder?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:7
translate de scr_SharedInThorns_luciusClue_114051c4:

    # LUCIUSMAL "How wise you are!"
    LUCIUSMAL "Wie weise du bist!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:8
translate de scr_SharedInThorns_luciusClue_9da937b8:

    # LUCIUSMAL "I should think... Two hundred coins should suffice!"
    LUCIUSMAL "Ich denke... Zweihundert Münzen sollten genügen!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:9
translate de scr_SharedInThorns_luciusClue_6aa48ae3:

    # ELENA "{i}*Growls*{/i}"
    ELENA "{i}*Knurrt*{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:10
translate de scr_SharedInThorns_luciusClue_70f8b79f:

    # "As Elena stepped forward snarling, the Merchant pulled back, his face quite afraid."
    "Als Elena knurrend nach vorne trat, zog sich der Händler zurück, sein Gesicht voller Angst."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:11
translate de scr_SharedInThorns_luciusClue_631d28de:

    # LUCIUSMAL "Y-Your pet is snarling at me!"
    LUCIUSMAL "D-Dein Haustier knurrt mich an!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:12
translate de scr_SharedInThorns_luciusClue_3e052b3e:

    # MC @ talk "Oooh, she definitely doesn't like to be called that."
    MC @ talk "Oooh, sie mag es definitiv nicht, so genannt zu werden."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:13
translate de scr_SharedInThorns_luciusClue_79c49f58:

    # LUCIUSMAL "B-Back! Back you animal!"
    LUCIUSMAL "Z-Zurück! Zurück, du Tier!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:16
translate de scr_SharedInThorns_luciusClue_3f8dc976:

    # "Elena continue to snarl as she stepped forward, jumping forward to knock the startled Merchant down where she barked in front of his petrified face."
    "Elena knurrte weiter, als sie nach vorne trat, sprang vor, um den erschrockenen Händler niederzuwerfen, und bellte direkt vor seinem erstarrten Gesicht."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:17
translate de scr_SharedInThorns_luciusClue_eb41e7b4:

    # LUCIUSMAL "Get her off me! GET HER OFF ME!"
    LUCIUSMAL "Holt sie von mir runter! HOLT SIE VON MIR RUNTER!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:18
translate de scr_SharedInThorns_luciusClue_57f2ff02:

    # MC @ talk "Will you tell us what we want to know?"
    MC @ talk "Wirst du uns sagen, was wir wissen wollen?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:19
translate de scr_SharedInThorns_luciusClue_55400f1b:

    # LUCIUSMAL "Yes! YES! ANYTHING!"
    LUCIUSMAL "Ja! JA! ALLES!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:20
translate de scr_SharedInThorns_luciusClue_a1215f79:

    # MC @ talk "Elena!"
    MC @ talk "Elena!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:21
translate de scr_SharedInThorns_luciusClue_498a46ec:

    # "Elena leapt off from the Merchant's chest and returned to my side."
    "Elena sprang von der Brust des Händlers herab und kehrte an meine Seite zurück."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:22
translate de scr_SharedInThorns_luciusClue_ff71850b:

    # "The sheepishly white Merchant rose to his feet, shaking with fear."
    "Der schüchtern-bleiche Händler erhob sich zitternd vor Angst."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:23
translate de scr_SharedInThorns_luciusClue_38eff685:

    # LUCIUSMAL "That mutt should be put down!"
    LUCIUSMAL "Dieser Köter sollte eingeschläfert werden!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:24
translate de scr_SharedInThorns_luciusClue_6e09eb2e:

    # MC @ talk "Do not speak ill of Elena again Merchant."
    MC @ talk "Redet nicht wieder schlecht über Elena, Händler."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:25
translate de scr_SharedInThorns_luciusClue_27e4ef7d:

    # MC @ talk "I can assure you, {i}she{/i} won't be the one put down."
    MC @ talk "Ich kann dir versichern, {i}sie{/i} wird nicht diejenige sein, die eingeschläfert wird."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:26
translate de scr_SharedInThorns_luciusClue_50372fd6:

    # LUCIUSMAL "I... I will tell you what you want! Please!"
    LUCIUSMAL "Ich... ich werde dir sagen, was du willst! Bitte!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:27
translate de scr_SharedInThorns_luciusClue_dd25831c:

    # MC @ talk "Speak Merchant."
    MC @ talk "Sprich, Händler."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:31
translate de scr_SharedInThorns_luciusClue_4e7f8e39:

    # "Deciding it was best not to let Elena continue to threaten the Merchant, I pulled her back."
    "Ich entschied, dass es das Beste war, Elena nicht weiter den Händler bedrohen zu lassen, und zog sie zurück."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:32
translate de scr_SharedInThorns_luciusClue_0ace945e:

    # LUCIUSMAL "So, what say you? Fifty gold and I'll tell you what I know."
    LUCIUSMAL "Also, was sagst du? Fünfzig Gold und ich sage dir, was ich weiß."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:35
translate de scr_SharedInThorns_luciusClue_bae8bb6f:

    # LUCIUSMAL "Of course... My information isn't going anywhere."
    LUCIUSMAL "Natürlich... Meine Informationen gehen nirgendwohin."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:43
translate de scr_SharedInThorns_luciusTellMe_2ae75a68:

    # MC @ talk "Now, tell me what I want to know."
    MC @ talk "Jetzt sag mir, was ich wissen will."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:44
translate de scr_SharedInThorns_luciusTellMe_432f2a11:

    # LUCIUSMAL "For many years, the Lord of Thornfall has privately funded various archaeological sites in Ramon."
    LUCIUSMAL "Seit vielen Jahren finanziert der Herr von Thornfall heimlich verschiedene archäologische Stätten in Ramon."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:45
translate de scr_SharedInThorns_luciusTellMe_d45b776f:

    # MC @ talk "{i}Yes, Ramon.{/i}"
    MC @ talk "{i}Ja, Ramon.{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:46
translate de scr_SharedInThorns_luciusTellMe_4f6344db:

    # LUCIUSMAL "Very secretive, many speculate he is, or rather, {i}was{/i} digging up old buried temples for their treasures, but no one involved is willing to talk."
    LUCIUSMAL "Sehr geheimnisvoll, viele spekulieren, dass er alte vergrabene Tempel nach Schätzen ausgräbt, oder besser gesagt, {i}ausgegraben hat{/i}, aber niemand, der daran beteiligt ist, will darüber reden."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:47
translate de scr_SharedInThorns_luciusTellMe_575b2e58:

    # LUCIUSMAL "Those who have muttered strange things about what they've seen... Well, let's just say many of them vanish under very mysterious circumstances."
    LUCIUSMAL "Diejenigen, die seltsame Dinge über das gemurmelt haben, was sie gesehen haben... Nun, sagen wir einfach, viele von ihnen verschwinden unter sehr mysteriösen Umständen."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:48
translate de scr_SharedInThorns_luciusTellMe_e23de5ac:

    # LUCIUSMAL "Lord Vront's daughter was last seen around Ramon not long ago before she vanished."
    LUCIUSMAL "Lord Vronts Tochter wurde zuletzt vor nicht allzu langer Zeit in der Nähe von Ramon gesehen, bevor sie verschwand."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:52
translate de scr_SharedInThorns_luciusTellMe_menu_fcf5d370:

    # LUCIUSMAL "I only hear rumours... Strange underground temples, things glowing... Monsters."
    LUCIUSMAL "Ich höre nur Gerüchte... Seltsame unterirdische Tempel, leuchtende Dinge... Monster."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:53
translate de scr_SharedInThorns_luciusTellMe_menu_1fba0dd5:

    # LUCIUSMAL "The ravings of mad men."
    LUCIUSMAL "Das Geschwätz von Verrückten."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:57
translate de scr_SharedInThorns_luciusTellMe_menu_3cebbd3e:

    # LUCIUSMAL "I know nothing!"
    LUCIUSMAL "Ich weiß nichts!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:58
translate de scr_SharedInThorns_luciusTellMe_menu_a32e126f:

    # LUCIUSMAL "The lady travelled to Ramon some years ago now, her business affair are even more secretive than her fathers!"
    LUCIUSMAL "Die Dame reiste vor einigen Jahren nach Ramon, ihre geschäftlichen Angelegenheiten sind noch geheimnisvoller als die ihres Vaters!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:59
translate de scr_SharedInThorns_luciusTellMe_menu_99f8b48c:

    # MC @ talk "Hm... I see."
    MC @ talk "Hm... Ich verstehe."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:62
translate de scr_SharedInThorns_luciusTellMe_menu_b9c26c8f:

    # LUCIUSMAL "That's all I know! Now get out of my damn store!"
    LUCIUSMAL "Das ist alles, was ich weiß! Und jetzt raus aus meinem verdammten Laden!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:63
translate de scr_SharedInThorns_luciusTellMe_menu_38e67625:

    # MC @ talk "Thank you for your help."
    MC @ talk "Vielen Dank für Ihre Hilfe."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:64
translate de scr_SharedInThorns_luciusTellMe_menu_1a74b5b2:

    # LUCIUSMAL "Tsch!"
    LUCIUSMAL "Tsch!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:67
translate de scr_SharedInThorns_luciusTellMe_menu_db00b836:

    # MC "(Hm... {i}Buried temples...{/i} Perhaps he was seeking some kind of enchantment or artefact?)"
    MC "(Hm... {i}Vergrabene Tempel...{/i} Vielleicht war er auf der Suche nach einer Art Verzauberung oder einem Artefakt?)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:68
translate de scr_SharedInThorns_luciusTellMe_menu_0a0350b1:

    # "Elena looked up towards me, her eyes troubled by what she heard."
    "Elena blickte zu mir auf, ihre Augen beunruhigt durch das, was sie gehört hatte."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:69
translate de scr_SharedInThorns_luciusTellMe_menu_8c84f86b:

    # MC @ talk "Don't worry."
    MC @ talk "Keine Sorge."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:70
translate de scr_SharedInThorns_luciusTellMe_menu_a67b5f70:

    # MC @ talk "We'll talk about it when we get home."
    MC @ talk "Wir reden darüber, wenn wir zu Hause sind."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:78
translate de scr_SharedInThorns_luciusTellMe_menu_50112bf0:

    # LUCIUSMAL "A pleasure doing business with you as always."
    LUCIUSMAL "Wie immer ein Vergnügen, mit Ihnen Geschäfte zu machen."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:79
translate de scr_SharedInThorns_luciusTellMe_menu_d25181cc:

    # MC @ talk "Goodbye Lucius."
    MC @ talk "Auf Wiedersehen, Lucius."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:82
translate de scr_SharedInThorns_luciusTellMe_menu_db00b836_1:

    # MC "(Hm... {i}Buried temples...{/i} Perhaps he was seeking some kind of enchantment or artefact?)"
    MC "(Hm... {i}Vergrabene Tempel...{/i} Vielleicht war er auf der Suche nach einer Art Verzauberung oder einem Artefakt?)"

