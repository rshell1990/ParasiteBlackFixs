translate de scr_SharedInThorns_valaClue_77d67554:

    # MC @ talk "Uh, this is Elena, my new...{i}pet.{/i}"
    MC @ talk "Äh, das ist Elena, mein neues ... {i}Haustier.{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:6
