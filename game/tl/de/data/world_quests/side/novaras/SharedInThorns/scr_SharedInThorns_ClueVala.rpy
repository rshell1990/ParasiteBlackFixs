translate de scr_SharedInThorns_valaClue_9ad04144:

    # MC @ talk "Don't just glare at me like that!"
    MC @ talk "Starr mich nicht einfach so an!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:25
translate de scr_SharedInThorns_valaClue_d3f6e928:

    # MC @ talk "Is this because of the pet comment?"
    MC @ talk "Ist das wegen des Haustier-Kommentars?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:26
translate de scr_SharedInThorns_valaClue_0f0a5a94:

    # ELENA "{i}Bark!{/i}"
    ELENA "{i}Wuff!{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:27
translate de scr_SharedInThorns_valaClue_9148adcd:

    # MC @ talk "Urghh! Do you want me to read this thing or not?"
    MC @ talk "Urghh! Willst du, dass ich dieses Ding lese oder nicht?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:28
translate de scr_SharedInThorns_valaClue_40bb1387:

    # ELENA "..."
    ELENA "..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:29
translate de scr_SharedInThorns_valaClue_dc3809d1:

    # MC @ talk "That's what I thought..."
    MC @ talk "Das dachte ich mir..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:30
translate de scr_SharedInThorns_valaClue_331e40b5:

    # MC "(Alright, let's read this thing.)"
    MC "(Also gut, lesen wir dieses Ding.)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:34
translate de scr_SharedInThorns_valaClue_a785402a:

    # MC "(All of his wives passed away during their pregnancies until he returned with the lady Grace...)"
    MC "(Alle seine Ehefrauen starben während ihrer Schwangerschaften, bis er mit Lady Grace zurückkehrte...)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:35
translate de scr_SharedInThorns_valaClue_f44e62f4:

    # MC "(...To which no one ever saw the mother.)"
    MC "(...Zu dem niemand jemals die Mutter sah.)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:36
translate de scr_SharedInThorns_valaClue_4e368b15:

    # BLACK "(You do not believe the child is his?)"
    BLACK "(Du glaubst nicht, dass das Kind seines ist?)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:37
translate de scr_SharedInThorns_valaClue_a2cb6377:

    # MC "(I don't know, but something foul is afoot... This kind of misfortune cannot be natural.)"
    MC "(Ich weiß nicht, aber etwas Faules ist im Gange... Diese Art von Unglück kann nicht natürlich sein.)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:38
translate de scr_SharedInThorns_valaClue_de6d1a88:

    # BLACK "(A curse?)"
    BLACK "(Ein Fluch?)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:39
translate de scr_SharedInThorns_valaClue_cb1b3a90:

    # MC "(I believe so, but the full nature of it alludes me.)"
    MC "(Das glaube ich, aber die volle Natur davon entzieht sich mir.)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:41
translate de scr_SharedInThorns_valaClue_892547e5:

    # MC @ talk "Elena, do you know anything about this?"
    MC @ talk "Elena, weißt du etwas darüber?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:42
translate de scr_SharedInThorns_valaClue_c599e4cf:

    # "Elena barked and shook her head."
    "Elena bellte und schüttelte den Kopf."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:43
translate de scr_SharedInThorns_valaClue_4be6d7d8:

    # MC @ talk "Hm... Looks like we're going to need to keep digging."
    MC @ talk "Hm... Sieht aus, als müssten wir weiter graben."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:44
translate de scr_SharedInThorns_valaClue_a1838ab7:

    # MC @ talk "And we're still no closer to finding the Lady Grace."
    MC @ talk "Und wir sind Lady Grace immer noch nicht näher gekommen."

