translate de qst_HumanExp_6_cityTour_5a4637c8:

    # MYU "Are the people here... {i}not needed?{/i}"
    MYU "Sind die Menschen hier... {i}nicht gebraucht?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:301
translate de qst_HumanExp_6_cityTour_82fc95a5:

    # MC @ smile "The people here are the most important, they keep everything going."
    MC @ smile "Die Menschen hier sind die wichtigsten, sie halten alles am Laufen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:302
translate de qst_HumanExp_6_cityTour_a03f9770:

    # MYU "...Then why do they not live in the nice districts?"
    MYU "...Warum leben sie dann nicht in den schönen Distrikten?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:303
translate de qst_HumanExp_6_cityTour_0e744dc8:

    # MC @ sad "It's... complicated."
    MC @ sad "Es ist... kompliziert."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:304
translate de qst_HumanExp_6_cityTour_4fd8abf7:

    # MC @ sad "Things are harder now because of the war."
    MC @ sad "Die Dinge sind jetzt wegen des Krieges schwieriger."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:305
translate de qst_HumanExp_6_cityTour_cd8d44d9:

    # MC @ talk "Hopefully after the war, people will go back to living much better lives like they used to before."
    MC @ talk "Hoffentlich werden die Menschen nach dem Krieg wieder ein viel besseres Leben führen wie früher."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:306
translate de qst_HumanExp_6_cityTour_d81b8530:

    # MYU "Do the rich people live harder lives as well?"
    MYU "Leben die Reichen auch ein härteres Leben?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:307
translate de qst_HumanExp_6_cityTour_d37ab87f:

    # MC @ think "Well, not exactly."
    MC @ think "Nun, nicht ganz genau."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:308
translate de qst_HumanExp_6_cityTour_092e4223_2:

    # MYU "...Why?"
    MYU "...Warum?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:309
translate de qst_HumanExp_6_cityTour_0e70507b:

    # MC @ talk "It depends on the person, Myu."
    MC @ talk "Das hängt von der Person ab, Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:310
translate de qst_HumanExp_6_cityTour_a8c013cf:

    # MC @ talk "Even if they have suffered because of the war, many still have enough wealth to get by comfortably."
    MC @ talk "Selbst wenn sie unter dem Krieg gelitten haben, haben viele immer noch genug Vermögen, um bequem zurechtzukommen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:311
translate de qst_HumanExp_6_cityTour_27ce3319:

    # MC @ talk "Let's move on now."
    MC @ talk "Lass uns jetzt weitermachen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:312
translate de qst_HumanExp_6_cityTour_6060f786:

    # MC @ talk "There's much more to see."
    MC @ talk "Es gibt noch viel mehr zu sehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:320
translate de qst_HumanExp_6_cityTour_a636ce6d:

    # MC @ talk "There is where students come to learn how to use their magic."
    MC @ talk "Dort kommen die Schüler, um zu lernen, wie sie ihre Magie anwenden."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:321
translate de qst_HumanExp_6_cityTour_05fa9bc8:

    # MYU "Do you have magic?"
    MYU "Hast du Magie?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:322
translate de qst_HumanExp_6_cityTour_4800c544:

    # MC @ talk "No, I failed every test on it."
    MC @ talk "Nein, ich bin bei jedem Test darin durchgefallen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:323
translate de qst_HumanExp_6_cityTour_d75e8604:

    # MC @ talk "You're either born with magic, like my [erika_ref!t] Erika, where you're then taken off to study at one of the Academy's here."
    MC @ talk "Du wirst entweder mit Magie geboren, wie meine [erika_ref!t] Erika, und wirst dann an einer der hiesigen Akademien zum Studium geschickt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:324
translate de qst_HumanExp_6_cityTour_39c86d5f:

    # MC @ talk "Or, you get stuck with the regular schooling like the rest of us."
    MC @ talk "Oder du bleibst in der regulären Schule stecken, wie der Rest von uns."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:325
translate de qst_HumanExp_6_cityTour_3235e42a:

    # MYU "...Is Myu magic?"
    MYU "...Ist Myu magisch?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:326
translate de qst_HumanExp_6_cityTour_c8bb141f:

    # MC @ think "You're a being of magical descent, so you likely have {i}some{/i} magic."
    MC @ think "Du bist ein Wesen magischer Abstammung, also hast du wahrscheinlich {i}etwas{/i} Magie."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:327
translate de qst_HumanExp_6_cityTour_bfd4899f:

    # MYU "Hrghhhhh!"
    MYU "Hrghhhhh!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:328
translate de qst_HumanExp_6_cityTour_60ccbb87:

    # MC @ surprised "What are you doing?"
    MC @ surprised "Was machst du da?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:329
translate de qst_HumanExp_6_cityTour_9209d41d:

    # MYU "Trying to magic! I wanna see if I can make bacon appear!"
    MYU "Ich versuche zu zaubern! Ich will sehen, ob ich Speck erscheinen lassen kann!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:330
translate de qst_HumanExp_6_cityTour_75426a97:

    # MC @ smile2 "It doesn't quite work like that."
    MC @ smile2 "So funktioniert das nicht ganz."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:331
translate de qst_HumanExp_6_cityTour_b0674f86:

    # MYU "Aww..."
    MYU "Aww..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:332
translate de qst_HumanExp_6_cityTour_d3335976:

    # MC @ talk "There's a lot of rules to magic, all of which, I don't even fully understand myself."
    MC @ talk "Es gibt viele Regeln für Magie, von denen ich selbst nicht alle vollständig verstehe."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:333
translate de qst_HumanExp_6_cityTour_0dc3a2f7:

    # MC @ talk "Anyway, let's keep moving, shall we?"
    MC @ talk "Wie auch immer, lass uns weitergehen, einverstanden?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:341
translate de qst_HumanExp_6_cityTour_89b56d18:

    # MC @ talk "There is where farmers work and live."
    MC @ talk "Dort arbeiten und leben die Bauern."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:342
translate de qst_HumanExp_6_cityTour_6ff4798e:

    # MC @ talk "Huge fields of land inside these walls are used for farming so that Novaras can sustain itself in the event of a siege."
    MC @ talk "Riesige Felder innerhalb dieser Mauern werden für die Landwirtschaft genutzt, damit Novaras sich im Falle einer Belagerung selbst versorgen kann."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:343
translate de qst_HumanExp_6_cityTour_f47ac91e:

    # MYU "Siege?"
    MYU "Belagerung?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:344
translate de qst_HumanExp_6_cityTour_fccbf799:

    # MC @ serious "If the Demorai tries to take this place, we could hold out for months, hopefully waiting on reinforcements from the North."
    MC @ serious "Falls die Demorai versuchen, diesen Ort einzunehmen, könnten wir monatelang ausharren und hoffentlich auf Verstärkung aus dem Norden warten."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:345
translate de qst_HumanExp_6_cityTour_a450f072:

    # MYU "Ooooooh."
    MYU "Ooooooh."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:346
translate de qst_HumanExp_6_cityTour_bb20e0aa:

    # MYU "So, can we get food here?"
    MYU "Können wir hier also Essen bekommen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:347
translate de qst_HumanExp_6_cityTour_c02730c7:

    # MYU "Myu, hungry."
    MYU "Myu, hungrig."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:348
translate de qst_HumanExp_6_cityTour_a640ddce:

    # MC @ talk "No, the food here is rationed out to the army and districts."
    MC @ talk "Nein, das Essen hier wird an die Armee und die Bezirke rationiert."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:349
translate de qst_HumanExp_6_cityTour_10d1c41a:

    # MC @ talk "Everyone is given a bit of food, some more than others depending on their district."
    MC @ talk "Jeder bekommt ein bisschen Essen, manche mehr als andere je nach Bezirk."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:350
translate de qst_HumanExp_6_cityTour_9eee31e8:

    # MC @ talk "But you can buy additional food from what they allocate to the merchants to sell."
    MC @ talk "Aber du kannst zusätzliches Essen von dem kaufen, was sie den Händlern zum Verkauf zuteilen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:351
translate de qst_HumanExp_6_cityTour_45ea512f:

    # MYU "Why..."
    MYU "Warum..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:352
translate de qst_HumanExp_6_cityTour_06a8db09:

    # "Myu puzzled out her thoughts."
    "Myu versuchte, ihre Gedanken zu ordnen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:353
translate de qst_HumanExp_6_cityTour_95c66aed:

    # MYU "Some get more than others?"
    MYU "Bekommen manche mehr als andere?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:354
translate de qst_HumanExp_6_cityTour_4c622349:

    # MYU "If they are rich, Why they not just buy more food anyway?"
    MYU "Wenn sie reich sind, warum kaufen sie dann nicht einfach mehr Essen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:355
translate de qst_HumanExp_6_cityTour_07a7a739:

    # MYU "Then more food... For poor."
    MYU "Dann mehr Essen... Für die Armen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:356
translate de qst_HumanExp_6_cityTour_2ca9bbe8:

    # MC @ think "Well, yes..."
    MC @ think "Nun ja..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:357
translate de qst_HumanExp_6_cityTour_3b20968d:

    # MC @ smile "I guess no one's ever really thought about it much."
    MC @ smile "Ich schätze, niemand hat je wirklich viel darüber nachgedacht."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:358
translate de qst_HumanExp_6_cityTour_a812c05c:

    # MC @ think "This is all some of us have ever known."
    MC @ think "Das ist alles, was manche von uns jemals gekannt haben."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:359
translate de qst_HumanExp_6_cityTour_0d3e6227:

    # MYU "Not seem fair."
    MYU "Das scheint nicht fair."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:362
translate de qst_HumanExp_6_cityTour_aff12971:

    # MYU "...Okay, Myu think on what you said."
    MYU "...Okay, Myu denkt über das nach, was du gesagt hast."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:363
translate de qst_HumanExp_6_cityTour_e55b4a01:

    # MYU "But, if they {i}aren't{/i} responsible with money and power, is it not okay to punish them then?"
    MYU "Aber wenn sie {i}nicht{/i} verantwortungsvoll mit Geld und Macht umgehen, ist es dann nicht in Ordnung, sie zu bestrafen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:365
translate de qst_HumanExp_6_cityTour_556bd6d7:

    # MYU "Mmm, won't people get hurt if you try get rid of them though?"
    MYU "Mmm, aber werden nicht Leute verletzt, wenn du versuchst, sie loszuwerden?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:366
translate de qst_HumanExp_6_cityTour_e624755c:

    # MYU "Myu would be sad to see people hurt."
    MYU "Myu wäre traurig, Menschen verletzt zu sehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:367
translate de qst_HumanExp_6_cityTour_f6a22ab9:

    # MYU "And more people might be upset if you DO get rid of them, so even more people get hurt then."
    MYU "Und mehr Leute könnten verärgert sein, wenn du sie WIRKLICH loswirst, dann werden noch mehr Menschen verletzt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:368
translate de qst_HumanExp_6_cityTour_607c1516:

    # MC @ smile "Very perceptive, Myu."
    MC @ smile "Sehr aufmerksam, Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:370
translate de qst_HumanExp_6_cityTour_b82a42dc:

    # MYU "But, who put them in charge?"
    MYU "Aber, wer hat sie eingesetzt?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:371
translate de qst_HumanExp_6_cityTour_989e19c4:

    # MYU "It sounds to Myu like they also {i}have{/i} more just for making choices for everyone else."
    MYU "Für Myu klingt es so, als hätten sie auch {i}mehr{/i}, nur weil sie Entscheidungen für alle anderen treffen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:372
translate de qst_HumanExp_6_cityTour_ee1c3eb6:

    # MYU "And, those choices seem to be more good for them than everyone."
    MYU "Und diese Entscheidungen scheinen ihnen mehr zu nützen als allen anderen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:373
translate de qst_HumanExp_6_cityTour_a3f80df8:

    # MC @ smile "Heh, you're learning to speak and think way too fast for your own good sometimes, Myu."
    MC @ smile "Heh, du lernst manchmal viel zu schnell zu sprechen und zu denken, Myu, was nicht immer gut für dich ist."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:374
translate de qst_HumanExp_6_cityTour_7368d55b:

    # MYU "... Myu do bad?"
    MYU "... Hat Myu etwas falsch gemacht?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:375
translate de qst_HumanExp_6_cityTour_48449b6e:

    # MC @ smile "Not at all, Myu."
    MC @ smile "Überhaupt nicht, Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:376
translate de qst_HumanExp_6_cityTour_0d7cba86:

    # MC @ talk "Anyway, moving on..."
    MC @ talk "Jedenfalls, weiter geht's..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:384
translate de qst_HumanExp_6_cityTour_6dadeaea:

    # MC @ talk "This is where most normal students are taught."
    MC @ talk "Hier werden die meisten normalen Schüler unterrichtet."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:385
translate de qst_HumanExp_6_cityTour_7506ecb0:

    # MYU "Its so big!"
    MYU "Es ist so groß!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:386
translate de qst_HumanExp_6_cityTour_208990a5:

    # MC @ talk "Hundreds if not thousands are taught here every day."
    MC @ talk "Hunderte, wenn nicht Tausende, werden hier jeden Tag unterrichtet."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:387
translate de qst_HumanExp_6_cityTour_4667a551:

    # MYU "What do you learn?"
    MYU "Was lernt man hier?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:388
translate de qst_HumanExp_6_cityTour_9f10a707:

    # MC @ smile "A lot actually, everything from basic defense to economics to about a hundred other things."
    MC @ smile "Ziemlich viel sogar, alles von grundlegender Verteidigung über Wirtschaft bis hin zu etwa hundert anderen Dingen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:389
translate de qst_HumanExp_6_cityTour_fe04ca43:

    # MC @ talk "The idea is they delegate you into a job best suited to your results during a festival we call the Terminus ceremony."
    MC @ talk "Die Idee ist, dass sie dich während eines Festes, das wir die Terminus-Zeremonie nennen, einem Job zuteilen, der am besten zu deinen Ergebnissen passt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:390
translate de qst_HumanExp_6_cityTour_0f714875:

    # MYU "What if you get a job you don't like?"
    MYU "Was ist, wenn du einen Job bekommst, der dir nicht gefällt?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:391
translate de qst_HumanExp_6_cityTour_c971a6fc:

    # MC @ talk "Well, you're stuck with it."
    MC @ talk "Tja, du hängst jetzt damit fest."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:392
translate de qst_HumanExp_6_cityTour_7a523241:

    # MC @ talk "At least, until this war is over."
    MC @ talk "Zumindest, bis dieser Krieg vorbei ist."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:393
translate de qst_HumanExp_6_cityTour_0d4f6c3b:

    # MC @ talk "But it doesn't always stay that way anyway, I mean, I was a scout, and now I'm officially employed by the Adventurers Guild."
    MC @ talk "Aber so bleibt es sowieso nicht immer, ich meine, ich war ein Späher, und jetzt bin ich offiziell bei der Abenteurergilde angestellt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:394
translate de qst_HumanExp_6_cityTour_2656b8c9:

    # MC @ talk "But those changes aren't the norm, more like, special circumstances."
    MC @ talk "Aber solche Veränderungen sind nicht die Norm, eher besondere Umstände."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:395
translate de qst_HumanExp_6_cityTour_d31503ba:

    # MYU "Myu see."
    MYU "Myu, siehst du."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:396
translate de qst_HumanExp_6_cityTour_7bd3d9dc:

    # MYU "Do all students learn together?"
    MYU "Lernen alle Schüler zusammen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:397
translate de qst_HumanExp_6_cityTour_cc27e227:

    # MC @ talk "Mostly."
    MC @ talk "Größtenteils."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:398
translate de qst_HumanExp_6_cityTour_f2f40a67:

    # MYU "{i}...Mostly?{/i}"
    MYU "{i}...Größtenteils?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:399
translate de qst_HumanExp_6_cityTour_f19c15dd:

    # MC @ talk "The rich students tend to have different teachers and some additional classes than most of us."
    MC @ talk "Die reichen Schüler haben in der Regel andere Lehrer und einige zusätzliche Kurse als die meisten von uns."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:400
translate de qst_HumanExp_6_cityTour_d5c5fa1d:

    # MC @ talk "But other than that, yeah, we share lessons."
    MC @ talk "Aber abgesehen davon, ja, wir nehmen am gleichen Unterricht teil."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:401
translate de qst_HumanExp_6_cityTour_dbf0e0be:

    # MYU "So, do rich students get jobs they don't like?"
    MYU "Also, bekommen reiche Studenten Jobs, die sie nicht mögen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:402
translate de qst_HumanExp_6_cityTour_69419140:

    # MC @ think "Uhh, that doesn't really happen."
    MC @ think "Äh, das passiert nicht wirklich."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:403
translate de qst_HumanExp_6_cityTour_092e4223_3:

    # MYU "...Why?"
    MYU "...Warum?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:404
translate de qst_HumanExp_6_cityTour_b8e27f65:

    # MC @ talk "Because it's expected that those students will fill in for their parents when they're gone."
    MC @ talk "Weil es erwartet wird, dass diese Studenten für ihre Eltern einspringen, wenn sie nicht mehr da sind."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:405
translate de qst_HumanExp_6_cityTour_a5acadba:

    # MYU "But what if they're dumb?"
    MYU "Aber was, wenn sie dumm sind?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:406
translate de qst_HumanExp_6_cityTour_0d40bee1:

    # MC @ smile "Well, bad luck for all of us I guess!"
    MC @ smile "Tja, Pech für uns alle, schätze ich!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:407
translate de qst_HumanExp_6_cityTour_5fc0802e:

    # MYU "Except the dumb person?"
    MYU "Außer für die dumme Person?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:408
translate de qst_HumanExp_6_cityTour_f2390457:

    # MC @ talk "Come on, enough of this place, there's still a couple more places to see."
    MC @ talk "Komm schon, genug von diesem Ort, es gibt noch ein paar mehr Orte zu sehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:416
translate de qst_HumanExp_6_cityTour_7ee12f29:

    # MC @ talk "This is um, where people go for {i}'entertainment.'{/i}"
    MC @ talk "Das ist ähm, wo die Leute zur {i}'Unterhaltung'{/i} hingehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:417
translate de qst_HumanExp_6_cityTour_64c31593:

    # MYU "{i}Entertainment?{/i}"
    MYU "{i}Unterhaltung?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:418
translate de qst_HumanExp_6_cityTour_78f17fa7:

    # MC @ talk "Uhh, well, it's kinda a place for people to have fun."
    MC @ talk "Ähh, nun ja, es ist so eine Art Ort, an dem Leute Spaß haben können."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:419
translate de qst_HumanExp_6_cityTour_1bf65bb8:

    # MC @ talk "And a big part of that is what happens when men and women {i}really{/i} like each other and-"
    MC @ talk "Und ein großer Teil davon ist, was passiert, wenn Männer und Frauen sich {i}wirklich{/i} mögen und-"

