    SHAY @ talk "Was möchtest du?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:563
translate de qst_HumanExp_8_shayGetBetterFood_662d04b2:

    # MC @ talk "(Hmm... Perhaps a finer meat is what Myu needs?)"
    MC @ talk "(Hmm... Vielleicht braucht Myu feineres Fleisch?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:564
translate de qst_HumanExp_8_shayGetBetterFood_05c7ee73:

    # MC @ talk "Do you perhaps have any deer, or..."
    MC @ talk "Haben Sie vielleicht Reh, oder ..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:565
translate de qst_HumanExp_8_shayGetBetterFood_ec094a4f:

    # SHAY @ shock "{i}Deer?{/i}"
    SHAY @ shock "{i}Reh?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:566
translate de qst_HumanExp_8_shayGetBetterFood_9b5154b7:

    # SHAY @ think "W-Well... We have some, but it's expensive."
    SHAY @ think "N-Nun... Wir haben welches, aber es ist teuer."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:567
translate de qst_HumanExp_8_shayGetBetterFood_bb094c1f:

    # SHAY @ smile "Three hundred coins."
    SHAY @ smile "Dreihundert Münzen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:573
translate de qst_HumanExp_8_shayGetBetterFood_d7c88993:

    # SHAY @ talk "Alright, just let me know if you change your mind."
    SHAY @ talk "In Ordnung, lassen Sie es mich wissen, falls Sie Ihre Meinung ändern."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:575
translate de qst_HumanExp_8_shayGetBetterFood_4ab5a188:

    # SHAY @ smile2 "Ah! Oh my!"
    SHAY @ smile2 "Ah! Oh mein!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:576
translate de qst_HumanExp_8_shayGetBetterFood_3d7e21ca:

    # SHAY @ shy "We haven't had to prep a deer in months!"
    SHAY @ shy "Wir mussten seit Monaten kein Reh zubereiten!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:577
translate de qst_HumanExp_8_shayGetBetterFood_11346f9d:

    # SHAY @ talk "Here, take a seat."
    SHAY @ talk "Hier, setz dich."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:578
translate de qst_HumanExp_8_shayGetBetterFood_356e3a8b:

    # SHAY @ talk "What drink shall I bring you?"
    SHAY @ talk "Welches Getränk soll ich dir bringen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:579
translate de qst_HumanExp_8_shayGetBetterFood_2432045f:

    # MC @ smile "An Ale will suffice."
    MC @ smile "Ein Ale genügt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:580
translate de qst_HumanExp_8_shayGetBetterFood_25fcf3e3:

    # SHAY @ smile "Very well, I will be back shortly."
    SHAY @ smile "Sehr gut, ich bin gleich zurück."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:582
translate de qst_HumanExp_8_shayGetBetterFood_cedf9ed1:

    # "As I sat down at one of the tables, Shay returned after a short while with my food and drink."
    "Als ich mich an einen der Tische setzte, kehrte Shay nach kurzer Zeit mit meinem Essen und Getränk zurück."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:583
translate de qst_HumanExp_8_shayGetBetterFood_b9c578ac:

    # "The piping hot deer smelt amazing; it had been a long time since I had enjoyed a meal quite so expensive."
    "Das dampfend heiße Reh roch fantastisch; es war lange her, dass ich eine so teure Mahlzeit genossen hatte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:584
translate de qst_HumanExp_8_shayGetBetterFood_49313434:

    # "A meal such as this now, was a reserved treat father would have bought us to celebrate Harvest Day once a year."
    "Ein solches Mahl war früher ein besonderer Leckerbissen, den der Vater uns einmal im Jahr zum Erntedankfest kaufte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:585
translate de qst_HumanExp_8_shayGetBetterFood_8551840f:

    # "Many would not even think of wasting the coin on such a thing, and it was simply unattainable for most."
    "Viele hätten nicht einmal daran gedacht, das Geld für so etwas zu verschwenden, und für die meisten war es einfach unerschwinglich."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:586
translate de qst_HumanExp_8_shayGetBetterFood_260eee86:

    # "Here I was though, not only able to afford it, but enjoying it almost as though it was like any other meal."
    "Hier war ich nun, nicht nur in der Lage, es mir zu leisten, sondern ich genoss es fast, als ob es eine ganz gewöhnliche Mahlzeit wäre."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:587
translate de qst_HumanExp_8_shayGetBetterFood_c7ae9e21:

    # "Despite the inherent danger... The mercenary life paid well alright."
    "Trotz der inhärenten Gefahr ... Das Söldnerleben warf ordentlich Geld ab."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:588
translate de qst_HumanExp_8_shayGetBetterFood_4017ecb0:

    # "Beneath the table, I rested the container holding Myu, and would every so often palm a piece of the meat under the table which she would take from my hand gently with a tentacle to consume."
    "Unter dem Tisch stellte ich den Behälter mit Myu ab und schob ihr von Zeit zu Zeit heimlich ein Stück Fleisch unter den Tisch, das sie sanft mit einem Tentakel aus meiner Hand nahm, um es zu fressen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:589
translate de qst_HumanExp_8_shayGetBetterFood_aa209940:

    # "Finally, once the meal was finished, I gathered Myu back into my possession once again and rose to my feet."
    "Schließlich, als das Essen beendet war, nahm ich Myu wieder an mich und erhob mich."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:593
translate de qst_HumanExp_8_shayGetBetterFood_69ba816e:

    # SHAY @ talk "How was it?"
    SHAY @ talk "Wie war es?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:594
translate de qst_HumanExp_8_shayGetBetterFood_858c1d3b:

    # MC @ smile2 "It was perfect."
    MC @ smile2 "Es war perfekt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:595
translate de qst_HumanExp_8_shayGetBetterFood_0980d96f:

    # SHAY @ smile "Ah! I'm so glad to hear that!"
    SHAY @ smile "Ah! Das freut mich so sehr zu hören!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:596
translate de qst_HumanExp_8_shayGetBetterFood_b5f23e75:

    # SHAY @ talk "Nice to see my cooking is still up to standard then!"
    SHAY @ talk "Schön zu sehen, dass meine Kochkünste also immer noch den Standard halten!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:597
translate de qst_HumanExp_8_shayGetBetterFood_a4ec6299:

    # MC @ talk "You cooked it?"
    MC @ talk "Das hast du gekocht?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:598
translate de qst_HumanExp_8_shayGetBetterFood_267641f9:

    # SHAY @ talk "Ha... Did you think we hired a cook or something?"
    SHAY @ talk "Ha... Hast du gedacht, wir hätten einen Koch angestellt oder so?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:599
translate de qst_HumanExp_8_shayGetBetterFood_772372eb:

    # SHAY @ talk "No, just me and my husband."
    SHAY @ talk "Nein, nur ich und mein Mann."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:600
translate de qst_HumanExp_8_shayGetBetterFood_6188caea:

    # MC @ talk "I see."
    MC @ talk "Verstehe."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:601
translate de qst_HumanExp_8_shayGetBetterFood_f8b95ddd:

    # "The box Myu was in rumbled."
    "Die Kiste, in der Myu war, rumpelte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:602
translate de qst_HumanExp_8_shayGetBetterFood_26ac48a8:

    # MC "(Damn it!)"
    MC "(Verdammt!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:603
translate de qst_HumanExp_8_shayGetBetterFood_2e450c2d:

    # MC "(Keep still!)"
    MC "(Halt still!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:604
translate de qst_HumanExp_8_shayGetBetterFood_b4884869:

    # SHAY @ shock "Hm? Is everything okay?"
    SHAY @ shock "Hm? Ist alles in Ordnung?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:605
translate de qst_HumanExp_8_shayGetBetterFood_22539f1d:

    # SHAY @ think "You seem a little... pre-occupied with something."
    SHAY @ think "Du wirkst ein wenig... mit etwas beschäftigt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:606
translate de qst_HumanExp_8_shayGetBetterFood_0d25517b:

    # MC @ surprised "Oh, uh...!"
    MC @ surprised "Oh, ähm...!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:607
translate de qst_HumanExp_8_shayGetBetterFood_d87999d3:

    # MC @ talk "I just remembered I had something to do is all!"
    MC @ talk "Ich hab mich nur gerade erinnert, dass ich was zu tun habe, das ist alles!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:608
translate de qst_HumanExp_8_shayGetBetterFood_548feb58:

    # SHAY @ shock "Oh, um, okay."
    SHAY @ shock "Oh, ähm, okay."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:609
translate de qst_HumanExp_8_shayGetBetterFood_f5269d9a:

    # SHAY @ talk "Well, don't let me-"
    SHAY @ talk "Na, lass mich nicht-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:610
translate de qst_HumanExp_8_shayGetBetterFood_1fb61035:

    # "Feeling the box continue to rumble more erratically, I hurried off outside before even finishing my conversation with Shay."
    "Als ich spürte, wie die Schachtel immer unregelmäßiger rumpelte, eilte ich nach draußen, ohne mein Gespräch mit Shay zu beenden."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:611
translate de qst_HumanExp_8_shayGetBetterFood_71a9b09a:

    # MC "Thanks for the food! Talk soon!"
    MC "Danke fürs Essen! Wir reden bald!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:612
translate de qst_HumanExp_8_shayGetBetterFood_47794d20:

    # SHAY @ talk "...Keep you here."
    SHAY @ talk "...Behalte dich hier."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:613
translate de qst_HumanExp_8_shayGetBetterFood_52236020:

    # SHAY "(What was up with him back there?)"
    SHAY "(Was war los mit ihm da hinten?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:614
translate de qst_HumanExp_8_shayGetBetterFood_1771326a:

    # SHAY "(He's an odd one, isn't he?)"
    SHAY "(Er ist ein seltsamer Kerl, nicht wahr?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:620
translate de qst_HumanExp_8_shayGetBetterFood_9bd8eed0:

    # "In a hushed tone, I pulled Myu's container towards me."
    "Mit gedämpfter Stimme zog ich Myus Behälter zu mir heran."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:621
translate de qst_HumanExp_8_shayGetBetterFood_2bce9f55:

    # MC @ angry "Myu! Be quiet damn it!"
    MC @ angry "Myu! Sei verdammt noch mal leise!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:623
translate de qst_HumanExp_8_shayGetBetterFood_3eb6e334:

    # "The container continued to rumble."
    "Der Behälter rumpelte weiter."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:624
translate de qst_HumanExp_8_shayGetBetterFood_6162c6ef:

    # MC "(Damn it, I need to get her home and see what's wrong.)"
    MC "(Verdammt, ich muss sie nach Hause bringen und sehen, was los ist.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:630
translate de qst_HumanExp_8_shayGetBetterFood_4a832edb:

    # "Myu erupted out of the container on her hands and knees, violently shaking as she began to throw up the half-dissolved food."
    "Myu brach aus dem Behälter auf Händen und Knien hervor, zitterte heftig, als sie anfing, das halb aufgelöste Essen zu erbrechen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:633
translate de qst_HumanExp_8_shayGetBetterFood_501e6795:

    # MC @ surprised "Myu!"
    MC @ surprised "Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:634
translate de qst_HumanExp_8_shayGetBetterFood_28c0b8c4:

    # "Myu weakly rose back to her feet trembling."
    "Myu erhob sich zitternd schwach wieder auf die Füße."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:635
translate de qst_HumanExp_8_shayGetBetterFood_08983c0c:

    # MYU @ sad "M-Myu... Not good."
    MYU @ sad "M-Myu... Nicht gut."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:636
translate de qst_HumanExp_8_shayGetBetterFood_4e49aec7:

    # "Myu, too weak to hold her form, collapsed into a puddle on the floor and dragged herself into a corner miserably."
    "Myu, zu schwach um ihre Form zu halten, brach zu einer Pfütze auf dem Boden zusammen und schleppte sich elend in eine Ecke."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:638
translate de qst_HumanExp_8_shayGetBetterFood_872010a3:

    # MC "(Fuck! FUCK!)"
    MC "(Scheiße! SCHEIßE!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:639
translate de qst_HumanExp_8_shayGetBetterFood_b95aa3b6:

    # MC "(What did I do wrong?)"
    MC "(Was habe ich falsch gemacht?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:640
translate de qst_HumanExp_8_shayGetBetterFood_a9e4dcc3:

    # MC "(S-Shit!)"
    MC "(S-Scheiße!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:641
translate de qst_HumanExp_8_shayGetBetterFood_c33b3aeb:

    # MC "(There has to be something I can do... Maybe I can find a book to read up on them or something?)"
    MC "(Es muss etwas geben, das ich tun kann... Vielleicht kann ich ein Buch finden, um mich über sie zu informieren oder so?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:642
translate de qst_HumanExp_8_shayGetBetterFood_e768b575:

    # MC "(What am I missing?)"
    MC "(Was übersehe ich?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:643
translate de qst_HumanExp_8_shayGetBetterFood_bebd2464:

    # MC "(She ate the meat fine before, why not now?)"
    MC "(Sie hat das Fleisch vorher problemlos gegessen, warum jetzt nicht?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:648
translate de qst_HumanExp_9_valaLearnSlimelarks_3b987541:

    # VALA "Slimelarks?"
    VALA "Slimelarks?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:649
translate de qst_HumanExp_9_valaLearnSlimelarks_cfc74e71:

    # VALA "Umm, I think they're mentioned in a couple bestiaries, but there's nothing devoted just to them."
    VALA "Ähm, ich glaube, sie werden in ein paar Bestiarien erwähnt, aber es gibt nichts, das sich nur mit ihnen beschäftigt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:650
translate de qst_HumanExp_9_valaLearnSlimelarks_fbc08ab9:

    # MC @ talk "Do you have one of these bestiaries?"
    MC @ talk "Hast du eines dieser Bestiarien?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:651
translate de qst_HumanExp_9_valaLearnSlimelarks_e33b273c:

    # VALA "I can try gather you up some if that's what you want..."
    VALA "Ich kann versuchen, dir welche zu besorgen, wenn du das willst ..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:652
translate de qst_HumanExp_9_valaLearnSlimelarks_29beeb65:

    # VALA "What's this about?"
    VALA "Worum geht es denn?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:653
translate de qst_HumanExp_9_valaLearnSlimelarks_7943dd4f:

    # VALA "It might help if I knew what you were looking to find out about them."
    VALA "Es könnte helfen, wenn ich wüsste, wonach du suchst oder was du über sie herausfinden möchtest."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:654
translate de qst_HumanExp_9_valaLearnSlimelarks_0ce2104b:

    # MC @ think "Uhh, their diet I guess."
    MC @ think "Äh, ihre Ernährung, schätze ich."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:655
translate de qst_HumanExp_9_valaLearnSlimelarks_db9498b4:

    # VALA "Their diet?"
    VALA "Ihre Ernährung?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:656
translate de qst_HumanExp_9_valaLearnSlimelarks_5f9b271e:

    # VALA "OOOH! Are you writing a new research journal on them?!"
    VALA "OOOH! Schreibst du ein neues Forschungsjournal über sie?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:657
translate de qst_HumanExp_9_valaLearnSlimelarks_f4e0442a:

    # MC @ think "Uhh, not exactly..."
    MC @ think "Äh, nicht direkt ..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:658
translate de qst_HumanExp_9_valaLearnSlimelarks_3eab76be:

    # VALA "Hmmmm, interesting."
    VALA "Hmmmm, interessant."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:659
translate de qst_HumanExp_9_valaLearnSlimelarks_d5f50d4e:

    # VALA "Well, okay then."
    VALA "Nun, in Ordnung dann."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:660
translate de qst_HumanExp_9_valaLearnSlimelarks_1522084b:

    # VALA "I'll try narrow down the books to the most useful for you then."
    VALA "Ich werde versuchen, die Bücher auf die nützlichsten für dich einzugrenzen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:661
translate de qst_HumanExp_9_valaLearnSlimelarks_400bf3f5:

    # MC @ smile "Thank you, Vala."
    MC @ smile "Danke, Vala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:662
translate de qst_HumanExp_9_valaLearnSlimelarks_b76cebc3:

    # VALA "Don't mention it! Always happy to help a fellow keen mind!"
    VALA "Nichts zu danken! Immer gerne einem scharfen Verstand behilflich!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:664
translate de qst_HumanExp_9_valaLearnSlimelarks_1e512692:

    # "A while later..."
    "Eine Weile später..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:668
translate de qst_HumanExp_9_valaLearnSlimelarks_0ba33670:

    # MC "(Damn it, what's taking so long? It's nearly been an hour!)"
    MC "(Verdammt, was dauert so lange? Es ist fast eine Stunde her!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:669
translate de qst_HumanExp_9_valaLearnSlimelarks_3a1b2e7e:

    # MC "(I need to get back and-)"
    MC "(Ich muss zurück und-)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:671
translate de qst_HumanExp_9_valaLearnSlimelarks_3b14a3b0:

    # VALA "Phew!"
    VALA "Puh!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:672
translate de qst_HumanExp_9_valaLearnSlimelarks_b19bd620:

    # VALA "Well, there was a lot on Slimelarks but not much talking about what they eat."
    VALA "Nun, es gab viel über Schleimlerchen, aber kaum etwas darüber, was sie fressen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:673
translate de qst_HumanExp_9_valaLearnSlimelarks_cbdd3e29:

    # MC @ talk "What did you find?"
    MC @ talk "Was hast du gefunden?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:674
translate de qst_HumanExp_9_valaLearnSlimelarks_e36d030e:

    # VALA "This seems to be the best source of reference."
    VALA "Das scheint die beste Referenzquelle zu sein."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:675
translate de qst_HumanExp_9_valaLearnSlimelarks_f7233d18:

    # VALA "It was one of the earlier studies on Slimelarks, but it's one of the few that goes into their natural lives rather than just discussing the quickest way to kill them."
    VALA "Es war eine der früheren Studien über Slimelarks, aber es ist eine der wenigen, die auf ihr natürliches Leben eingeht, anstatt nur die schnellste Art, sie zu töten, zu besprechen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:676
translate de qst_HumanExp_9_valaLearnSlimelarks_1003da7c:

    # MC @ talk "Ah, thank you, Vala."
    MC @ talk "Ah, danke, Vala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:677
translate de qst_HumanExp_9_valaLearnSlimelarks_60f52a26:

    # VALA "Just leave the book here when you're done."
    VALA "Lass das Buch einfach hier, wenn du fertig bist."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:679
translate de qst_HumanExp_9_valaLearnSlimelarks_8de5398c:

    # "{i}Slimelarks, by their very nature, are omnivorous predators.{/i}"
    "{i}Slimelarks sind von Natur aus allesfressende Raubtiere.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:680
translate de qst_HumanExp_9_valaLearnSlimelarks_0069e7e7:

    # "{i}In their infancy, they rely far more on raw meat, often provided to them by their mothers, in order to build up their strength.{/i}"
    "{i}In ihrer Kindheit sind sie viel mehr auf rohes Fleisch angewiesen, das ihnen oft von ihren Müttern gegeben wird, um ihre Stärke aufzubauen.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:681
translate de qst_HumanExp_9_valaLearnSlimelarks_8bfd7566:

    # "{i}However, this is only one component of the slimelarks diet, it is essential for their growth they then move on to consume other substances, such as wildflower.{/i}"
    "{i}Allerdings ist dies nur ein Bestandteil der Slimelark-Diät; für ihr Wachstum ist es entscheidend, dass sie danach andere Substanzen wie Wildblumen verzehren.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:682
translate de qst_HumanExp_9_valaLearnSlimelarks_d31c9191:

    # "{i}Slimelarks do not possess any sort of organs similar to mammals, and thus, they rely on consuming various substances in order to compensate for their internal processes.{/i}"
    "{i}Slimelarks besitzen keinerlei Organe, die denen von Säugetieren ähneln, und sind daher darauf angewiesen, verschiedene Substanzen zu konsumieren, um ihre inneren Prozesse auszugleichen.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:683
translate de qst_HumanExp_9_valaLearnSlimelarks_26377531:

    # "{i}For example, the wild flowers helps the slimelarks with internal acidic production, allowing them to break down the meat and other foods they consume, without it, a slimelark can very quickly become sick.{/i}"
    "{i}Zum Beispiel helfen die Wildblumen den Slimelarks bei der inneren Säureproduktion, sodass sie das Fleisch und andere Nahrungsmittel, die sie zu sich nehmen, zersetzen können; ohne sie kann ein Slimelark sehr schnell krank werden.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:684
translate de qst_HumanExp_9_valaLearnSlimelarks_a7a71b6b:

    # MC "(Wildflower... Perhaps I could gather some by the Lake?)"
    MC "(Wildblume... Vielleicht könnte ich welche am See sammeln?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:689
translate de qst_HumanExp_11_returnFlowers_c53c2393:

    # "With the wildflower ready in my pouch, I practically burst through the door hurrying inside."
    "Mit der Wildblume bereit in meiner Tasche stürmte ich praktisch durch die Tür und eilte hinein."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:691
translate de qst_HumanExp_11_returnFlowers_ce8edcdf:

    # MC @ talk "Myu! Where are you?"
    MC @ talk "Myu! Wo bist du?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:692
translate de qst_HumanExp_11_returnFlowers_197c8e3a:

    # MC @ scared "MYU!"
    MC @ scared "MYU!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:694
translate de qst_HumanExp_11_returnFlowers_f2d51170:

    # MC "(Oh fuck... Fuck! Where did she go?)"
    MC "(Oh Scheiße... Scheiße! Wohin ist sie gegangen?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:695
translate de qst_HumanExp_11_returnFlowers_0f3104bf:

    # MC "(I have to find her!)"
    MC "(Ich muss sie finden!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:696
translate de qst_HumanExp_11_returnFlowers_44e1d950:

    # "I noticed that outside the window, my house was seen."
    "Ich bemerkte, dass mein Haus draußen vor dem Fenster zu sehen war."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:697
translate de qst_HumanExp_11_returnFlowers_747bdc68:

    # MC "(Could she?...)"
    MC "(Könnte sie?...)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:698
translate de qst_HumanExp_11_returnFlowers_d9975ab3:

    # MC "(Oh no!)"
    MC "(Oh nein!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:707
translate de qst_HumanExp_11_returnFlowers_8f96e94b:

    # "As I stepped inside my home, I was greeted by the sudden sight of Myu sat patiently at the dinner table as [regina_ref!t] served her a plate of vegetables."
    "Als ich mein Zuhause betrat, wurde ich vom plötzlichen Anblick von Myu begrüßt, die geduldig am Esstisch saß, während [regina_ref!t] ihr einen Teller Gemüse servierte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:708
translate de qst_HumanExp_11_returnFlowers_134b160e:

    # MC @ surprised "MYU?!"
    MC @ surprised "MYU?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:709
translate de qst_HumanExp_11_returnFlowers_fd2968c6:

    # REGINA @ smile "Ah! There you are dear!"
    REGINA @ smile "Ah! Da bist du ja, Liebling!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:710
translate de qst_HumanExp_11_returnFlowers_688bf939:

    # REGINA @ talk "Are those wildflowers? I'll take them."
    REGINA @ talk "Sind das Wildblumen? Ich nehme sie."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:711
translate de qst_HumanExp_11_returnFlowers_0d2cad68:

    # MC @ surprised "I... Wait, I can-"
    MC @ surprised "Ich... Warte, ich kann-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:712
translate de qst_HumanExp_11_returnFlowers_15ac1080:

    # REGINA @ talk "Explain why a slimelark broke into our home asking for you?"
    REGINA @ talk "Erkläre, warum eine Schleimlerche in unser Haus eingebrochen ist und nach dir gefragt hat?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:713
translate de qst_HumanExp_11_returnFlowers_b20781fb:

    # REGINA @ talk "{i}Yes, yes you can.{/i}"
    REGINA @ talk "{i}Ja, ja, das kannst du.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:715
translate de qst_HumanExp_11_returnFlowers_e6e17ca6:

    # "Taking the wild flower from my shaking hands, [regina_ref!t] poured the wild flower over Myu's food."
    "[regina_ref!t] nahm die Wildblume aus meinen zitternden Händen und streute sie über Myus Essen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:716
translate de qst_HumanExp_11_returnFlowers_b175dbec:

    # REGINA @ smile "Enjoy, Myu."
    REGINA @ smile "Guten Appetit, Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:717
translate de qst_HumanExp_11_returnFlowers_6645af26:

    # MYU @ joy "T-Tha... Thanks!"
    MYU @ joy "D-Da... Danke!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:719
translate de qst_HumanExp_11_returnFlowers_9f775ce0:

    # "Myu began to devour the food with both hands quickly as [regina_ref!t] turned to face me, her calm smiling expression giving away her obvious displeasure of the situation."
    "Myu begann, das Essen schnell mit beiden Händen zu verschlingen, als [regina_ref!t] sich zu mir umdrehte, wobei ihr ruhiger lächelnder Gesichtsausdruck ihre offensichtliche Unzufriedenheit mit der Situation verriet."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:720
translate de qst_HumanExp_11_returnFlowers_d6731342:

    # REGINA @ smile "Dear, if you could be so kind as to explain to me..."
    REGINA @ smile "Liebling, wenn du so freundlich wärst, mir zu erklären..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:721
translate de qst_HumanExp_11_returnFlowers_4ec5fc0a:

    # REGINA @ angry "{i}...Why there is a slimelark in our home?{/i}"
    REGINA @ angry "{i}...Warum ist ein Schleimlerche in unserem Zuhause?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:722
translate de qst_HumanExp_11_returnFlowers_32915c92:

    # MC "(...Shit.)"
    MC "(...Mist.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:724
translate de qst_HumanExp_11_returnFlowers_582ca55f:

    # "During the next ten minutes, I explained the full story as best as I could to [regina_ref!t]."
    "In den nächsten zehn Minuten erklärte ich [regina_ref!t] die ganze Geschichte, so gut ich konnte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:730
translate de qst_HumanExp_11_returnFlowers_1df27a57:

    # REGINA @ angry "Are you crazy? Do you even know the first thing about caring for Slimelarks?"
    REGINA @ angry "Bist du verrückt? Weißt du überhaupt das Erste über die Pflege von Schleimlerchen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:731
translate de qst_HumanExp_11_returnFlowers_727d021d:

    # MC @ scared "Well, I-"
    MC @ scared "Nun, ich-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:732
translate de qst_HumanExp_11_returnFlowers_247695ac:

    # REGINA @ angry "The answer is clearly no, the poor thing you've just been feeding meat and nothing else, haven't you?"
    REGINA @ angry "Die Antwort ist eindeutig nein, das arme Ding hast du doch nur mit Fleisch gefüttert und sonst nichts, oder?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:733
translate de qst_HumanExp_11_returnFlowers_1ae31068:

    # MC @ scared "Well... Yes, but..."
    MC @ scared "Nun... Ja, aber..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:734
translate de qst_HumanExp_11_returnFlowers_07fa0e19:

    # MC @ scared "She got sick so I-"
    MC @ scared "Sie wurde krank, also habe ich-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:735
translate de qst_HumanExp_11_returnFlowers_eff6b809:

    # REGINA @ talk "I know she became sick!"
    REGINA @ talk "Ich weiß, dass sie krank wurde!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:736
translate de qst_HumanExp_11_returnFlowers_0acce0b5:

    # REGINA @ talk "She came crawling in here asking for you and threw up all over the floor."
    REGINA @ talk "Sie kroch hier rein und fragte nach dir und übergab sich auf den ganzen Boden."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:737
translate de qst_HumanExp_11_returnFlowers_9887c669:

    # MC @ think "{i}...Oh.{/i}"
    MC @ think "{i}...Oh.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:738
translate de qst_HumanExp_11_returnFlowers_f3a70aa8:

    # MC "(Fuck! I pray no one noticed her outside.)"
    MC "(Verdammt! Ich bete, dass niemand sie draußen bemerkt hat.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:739
translate de qst_HumanExp_11_returnFlowers_07f65605:

    # REGINA @ sad "{i}*Sigh*{/i}"
    REGINA @ sad "{i}*Seufz*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:740
translate de qst_HumanExp_11_returnFlowers_fc81c3c9:

    # REGINA @ sad "Well, at least it was a good idea taking her to that abandoned safe house outside."
    REGINA @ sad "Na ja, wenigstens war es eine gute Idee, sie zu dem verlassenen sicheren Haus draußen zu bringen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:741
translate de qst_HumanExp_11_returnFlowers_c07a5e79:

    # "I glanced over towards Myu, who smiled and waved at me as she continued to make happy sounds while she ate and devoured her food."
    "Ich warf einen Blick zu Myu, die mich anlächelte und winkte, während sie fröhliche Geräusche machte, während sie ihr Essen aß und verschlang."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:742
translate de qst_HumanExp_11_returnFlowers_f8ae2a36:

    # "As the food passed into Myu, I could see it being dissolved inside of her body till nothing was left."
    "Als das Essen in Myu gelangte, konnte ich sehen, wie es sich in ihrem Körper auflöste, bis nichts mehr übrig war."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:743
translate de qst_HumanExp_11_returnFlowers_f406d867:

    # MC @ smile "She seems better now at least."
    MC @ smile "Sie scheint jetzt zumindest besser zu sein."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:744
translate de qst_HumanExp_11_returnFlowers_5b669abb:

    # MC @ think "But, how did you know what she needed?"
    MC @ think "Aber wie wusstest du, was sie brauchte?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:745
translate de qst_HumanExp_11_returnFlowers_d19bb13e:

    # REGINA @ talk "That doesn't matter, I used to live nearby to some slimelarks when I was younger, that's all."
    REGINA @ talk "Das spielt keine Rolle, ich habe früher in der Nähe von einigen Slimelarks gelebt, als ich jünger war, das ist alles."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:746
translate de qst_HumanExp_11_returnFlowers_af69fb7c:

    # MC @ surprised "Wait, you lived by-"
    MC @ surprised "Warte, du hast in der Nähe von-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:747
translate de qst_HumanExp_11_returnFlowers_333cabda:

    # REGINA @ talk "Don't try and change the subject mister!"
    REGINA @ talk "Versuche nicht, das Thema zu wechseln, Mister!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:748
translate de qst_HumanExp_11_returnFlowers_a1505d7b:

    # REGINA @ talk "It's {i}imprinted{/i} itself onto you now, so you're stuck with it."
    REGINA @ talk "Es hat sich jetzt {i}in dich eingeprägt{/i}, also wirst du es nicht mehr los."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:749
translate de qst_HumanExp_11_returnFlowers_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "Was?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:750
translate de qst_HumanExp_11_returnFlowers_2be6f483:

    # REGINA @ talk "Oh for the love of..."
    REGINA @ talk "Oh, um Himmels willen..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:751
translate de qst_HumanExp_11_returnFlowers_a9426621:

    # REGINA @ talk "Do you think it just took that form for the fun of it?"
    REGINA @ talk "Glaubst du, es hat diese Form nur zum Spaß angenommen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:752
translate de qst_HumanExp_11_returnFlowers_fe2efdd0:

    # REGINA @ talk "It thinks you are its {i}mate.{/i}"
    REGINA @ talk "Es denkt, du bist sein {i}Gefährte.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:753
translate de qst_HumanExp_11_returnFlowers_4b4637e3:

    # MC @ surprised "Wait, what?!"
    MC @ surprised "Warte, was?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:754
translate de qst_HumanExp_11_returnFlowers_cab220c6:

    # REGINA @ talk "It took a form it thought would be pleasing to you."
    REGINA @ talk "Es nahm eine Form an, von der es dachte, dass sie dir gefallen würde."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:755
translate de qst_HumanExp_11_returnFlowers_7e36f89f:

    # REGINA @ talk "Its also probably been copying your memories, that's how she's learning so fast."
    REGINA @ talk "Es hat wahrscheinlich auch deine Erinnerungen kopiert, deshalb lernt sie so schnell."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:756
translate de qst_HumanExp_11_returnFlowers_30c50d49:

    # MC @ talk "{i}It's... copying my memories?{/i}"
    MC @ talk "{i}Es... kopiert meine Erinnerungen?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:757
translate de qst_HumanExp_11_returnFlowers_ad206be8:

    # REGINA @ talk "Slimelarks are able to learn {i}a lot{/i} through touch alone."
    REGINA @ talk "Slimelarks können allein durch Berührung {i}eine Menge{/i} lernen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:758
translate de qst_HumanExp_11_returnFlowers_90d01518:

    # REGINA @ talk "Why do you think she's so affectionate?"
    REGINA @ talk "Warum, glaubst du, ist sie so anhänglich?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:759
translate de qst_HumanExp_11_returnFlowers_2ce76fc5:

    # REGINA @ talk "She's trying to learn quicker {i}through{/i} touch."
    REGINA @ talk "Sie versucht, schneller {i}durch{/i} Berührung zu lernen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:760
translate de qst_HumanExp_11_returnFlowers_5897852c:

    # REGINA @ talk "It's how they learn to form new shapes so quickly."
    REGINA @ talk "So lernen sie, so schnell neue Formen zu bilden."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:761
translate de qst_HumanExp_11_returnFlowers_04b7cbd0:

    # MC @ talk "So, what should I do?"
    MC @ talk "Also, was soll ich tun?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:762
translate de qst_HumanExp_11_returnFlowers_07f65605_1:

    # REGINA @ sad "{i}*Sigh*{/i}"
    REGINA @ sad "{i}*Seufz*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:763
translate de qst_HumanExp_11_returnFlowers_eea95404:

    # REGINA @ sad "She's {i}Your{/i} responsibility now, just be prepared to accept all that entails."
    REGINA @ sad "Sie ist jetzt {i}deine{/i} Verantwortung, sei einfach bereit, alles zu akzeptieren, was das mit sich bringt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:764
translate de qst_HumanExp_11_returnFlowers_45209266:

    # REGINA @ talk "And she needs fresh blood."
    REGINA @ talk "Und sie braucht frisches Blut."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:765
translate de qst_HumanExp_11_returnFlowers_01622adf:

    # MC @ scared "Fresh... {i}blood?{/i}"
    MC @ scared "Frisches... {i}Blut?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:766
translate de qst_HumanExp_11_returnFlowers_0c79eca4:

    # REGINA @ talk "She's a predator, [player_name!t]."
    REGINA @ talk "Sie ist ein Raubtier, [player_name!t]."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:767
translate de qst_HumanExp_11_returnFlowers_dfa83bf5:

    # REGINA @ talk "When she wants meat, her hunting instincts take over."
    REGINA @ talk "Wenn sie Fleisch will, übernehmen ihre Jagdinstinkte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:768
translate de qst_HumanExp_11_returnFlowers_8af93a51:

    # "Grabbing the kitchen knife in hand, Regina gently nipped at her finger with the blade till it was dripping blood."
    "Mit dem Küchenmesser in der Hand ritzte Regina vorsichtig an ihrem Finger, bis Blut tropfte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:770
translate de qst_HumanExp_11_returnFlowers_40f0cc8e:

    # MC @ surprised "[regina_ref_cap!t]!"
    MC @ surprised "[regina_ref_cap!t]!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:771
translate de qst_HumanExp_11_returnFlowers_dc3f9e2d:

    # REGINA @ talk "Watch."
    REGINA @ talk "Schau."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:772
translate de qst_HumanExp_11_returnFlowers_b635db92:

    # "Regina gently presented her bleeding finger to Myu, who immediately lunged forward and began to suckle on the finger."
    "Regina hielt Myu vorsichtig ihren blutenden Finger hin, woraufhin diese sofort nach vorne stürzte und anfing, am Finger zu saugen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:773
translate de qst_HumanExp_11_returnFlowers_72b5a632:

    # REGINA @ talk "See? She still craves fresh blood and meat as well."
    REGINA @ talk "Siehst du? Sie verlangt immer noch nach frischem Blut und auch nach Fleisch."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:774
translate de qst_HumanExp_11_returnFlowers_da5ccd94:

    # "Regina pulled her finger away from Myu who reluctantly gave it up."
    "Regina zog ihren Finger von Myu weg, die ihn nur widerwillig losließ."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:775
translate de qst_HumanExp_11_returnFlowers_5373e925:

    # MC @ talk "So, what should I do when that happens?"
    MC @ talk "Also, was soll ich tun, wenn das passiert?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:776
translate de qst_HumanExp_11_returnFlowers_17ababba:

    # REGINA @ talk "Find her a human to eat."
    REGINA @ talk "Finde ihr einen Menschen zum Fressen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:777
translate de qst_HumanExp_11_returnFlowers_87334860:

    # MC @ surprised "Wha~"
    MC @ surprised "Wa~"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:778
translate de qst_HumanExp_11_returnFlowers_0d654dec:

    # "Shivers ran down my spine as I realized that she was not kidding."
    "Mir lief ein Schauer über den Rücken, als mir klar wurde, dass sie es ernst meinte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:779
translate de qst_HumanExp_11_returnFlowers_6fd4d1c5:

    # MC @ surprised "{i}... Human?{/i}"
    MC @ surprised "{i}... Mensch?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:780
translate de qst_HumanExp_11_returnFlowers_60808fed:

    # REGINA @ talk "For conveniences sake at the very least, yes."
    REGINA @ talk "Der Bequemlichkeit halber, ja."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:781
translate de qst_HumanExp_11_returnFlowers_d27c7c2d:

    # REGINA @ talk "Unless you plan to spend all your coin on buying her meat, or forever hunting in woodlands to feed her daily ... Which by the way, could draw unnecessary attention."
    REGINA @ talk "Es sei denn, du hast vor, dein ganzes Geld für den Kauf von Fleisch für sie auszugeben, oder für immer in Wäldern zu jagen, um sie täglich zu füttern ... Was übrigens unnötige Aufmerksamkeit erregen könnte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:782
translate de qst_HumanExp_11_returnFlowers_f3358772:

    # REGINA @ talk "Then she's going to need to hone her natural skills, isn't she?"
    REGINA @ talk "Dann muss sie wohl ihre natürlichen Fähigkeiten verfeinern, nicht wahr?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:783
translate de qst_HumanExp_11_returnFlowers_3314daed:

    # REGINA @ talk "If you're going to be risking your life and presumably she'll be there to protect you, it only makes sense she then eats what you kill."
    REGINA @ talk "Wenn du schon dein Leben riskierst und sie vermutlich da sein wird, um dich zu beschützen, dann ergibt es nur Sinn, dass sie das isst, was du tötest."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:784
translate de qst_HumanExp_11_returnFlowers_93620a4e:

    # REGINA @ talk "Not like there's a shortage of criminals these days either."
    REGINA @ talk "Schließlich herrscht heutzutage auch kein Mangel an Verbrechern."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:785
translate de qst_HumanExp_11_returnFlowers_dc4c5a11:

    # MC @ talk "Just, find some... bandits?"
    MC @ talk "Such einfach ... ein paar Banditen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:786
translate de qst_HumanExp_11_returnFlowers_d8c8a264:

    # MC @ talk "And let her {b}eat them?{/b}"
    MC @ talk "Und sie {b}auffressen lassen?{/b}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:787
translate de qst_HumanExp_11_returnFlowers_83dd4c14:

    # REGINA @ talk "Is there any real difference in nobility between you killing people and her eating them?"
    REGINA @ talk "Ist es wirklich ein Unterschied an Edelmut, ob du Menschen tötest oder sie sie frisst?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:788
translate de qst_HumanExp_11_returnFlowers_71c402fc:

    # REGINA @ talk "The end result is the same."
    REGINA @ talk "Das Endergebnis ist dasselbe."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:789
translate de qst_HumanExp_11_returnFlowers_6e20213e:

    # MC "(Is it still her talking to me right now?)"
    MC "(Spricht sie gerade immer noch mit mir?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:790
translate de qst_HumanExp_11_returnFlowers_40cfe544:

    # MC "([regina_ref_cap!t]?)"
    MC "([regina_ref_cap!t]?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:795
translate de qst_HumanExp_11_returnFlowers_menu_736bb546:

    # REGINA @ talk "What part of {i}imprinting{/i} do you not understand?"
    REGINA @ talk "Welchen Teil von {i}Prägung{/i} verstehst du nicht?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:796
translate de qst_HumanExp_11_returnFlowers_menu_73400365:

    # REGINA @ talk "She will just come crawling straight back, and now, other slimelarks are likely to reject her."
    REGINA @ talk "Sie wird direkt zurückgekrochen kommen, und jetzt werden andere Slimelarks sie wahrscheinlich ablehnen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:797
translate de qst_HumanExp_11_returnFlowers_menu_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "Was meinst du?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:798
translate de qst_HumanExp_11_returnFlowers_menu_1870a9f8:

    # REGINA @ talk "Slimelarks can tell when one of their own has been... {i}tainted,{/i} so to speak."
    REGINA @ talk "Slimelarks können erkennen, wenn einer der ihren... {i}befleckt{/i} wurde, sozusagen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:799
translate de qst_HumanExp_11_returnFlowers_menu_9f7c7726:

    # REGINA @ talk "If you {i}did{/i} manage to get rid of her, she'd be all alone."
    REGINA @ talk "Wenn es dir {i}tatsächlich{/i} gelingen würde, sie loszuwerden, wäre sie ganz allein."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:803
translate de qst_HumanExp_11_returnFlowers_menu_06a01ce2:

    # REGINA @ talk "Hm?"
    REGINA @ talk "Hm?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:804
translate de qst_HumanExp_11_returnFlowers_menu_33baed23:

    # MC @ think "Well, I figured you would be more afraid."
    MC @ think "Nun, ich dachte, du hättest mehr Angst."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:805
translate de qst_HumanExp_11_returnFlowers_menu_a8a1870f:

    # MC @ think "Instead, you seem more... {i}Annoyed.{/i}"
    MC @ think "Stattdessen wirkst du eher... {i}genervt.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:806
translate de qst_HumanExp_11_returnFlowers_menu_d364f8b2:

    # REGINA @ talk "It's like I said, I grew nearby to some, now can we change the subject please?"
    REGINA @ talk "Wie ich schon sagte, ich bin in der Nähe von einigen aufgewachsen, können wir jetzt bitte das Thema wechseln?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:807
translate de qst_HumanExp_11_returnFlowers_menu_21ce3cf3:

    # MC "(I have the distinct feeling she's hiding something from me.)"
    MC "(Ich habe das deutliche Gefühl, dass sie etwas vor mir verheimlicht.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:811
translate de qst_HumanExp_11_returnFlowers_menu_d9a46452:

    # "[regina_ref_cap!t] frowned."
    "[regina_ref_cap!t] runzelte die Stirn."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:812
translate de qst_HumanExp_11_returnFlowers_menu_635b928b:

    # REGINA @ angry "Just keep her out of sight, understand?"
    REGINA @ angry "Halte sie einfach außer Sichtweite, verstanden?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:813
translate de qst_HumanExp_11_returnFlowers_menu_d245c096:

    # REGINA @ talk "Inquisitors and their lot won't take kindly to a slimelark living within Novaras."
    REGINA @ talk "Inquisitoren und ihresgleichen werden es nicht gutheißen, dass eine Schleimlerche in Novaras lebt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:814
translate de qst_HumanExp_11_returnFlowers_menu_333a0828:

    # MYU @ joy "All done!"
    MYU @ joy "Alles fertig!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:815
translate de qst_HumanExp_11_returnFlowers_menu_65bb192a:

    # "Myu proudly presented her empty plate to show she was finished, and Regina took it from her with a smile."
    "Myu präsentierte stolz ihren leeren Teller, um zu zeigen, dass sie fertig war, und Regina nahm ihn ihr mit einem Lächeln ab."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:816
translate de qst_HumanExp_11_returnFlowers_menu_57258f18:

    # REGINA @ smile "Very good, Myu!"
    REGINA @ smile "Sehr gut, Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:817
translate de qst_HumanExp_11_returnFlowers_menu_e8c47127:

    # REGINA @ talk "Now we will continue teaching you Alderian the next time you visit, yes?"
    REGINA @ talk "Wir werden dir beim nächsten Besuch weiter Alderianisch beibringen, ja?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:818
translate de qst_HumanExp_11_returnFlowers_menu_c8c179ed:

    # MYU @ joy "Yes!"
    MYU @ joy "Ja!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:819
translate de qst_HumanExp_11_returnFlowers_menu_f2a3ff78:

    # REGINA @ talk "Good."
    REGINA @ talk "Gut."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:820
translate de qst_HumanExp_11_returnFlowers_menu_261bc297:

    # "Regina flashed one more look at me making it clear I needed to get a grip on this, {i}quickly.{/i}"
    "Regina warf mir einen letzten Blick zu, der deutlich machte, dass ich das {i}schnell{/i} in den Griff bekommen musste."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:822
translate de qst_HumanExp_11_returnFlowers_menu_7078d917:

    # MC "(Shit... I guess I should do what [regina_ref!t] says and take her out {i}hunting{/i} one night.)"
    MC "(Scheiße... Ich sollte wohl tun, was [regina_ref!t] sagt, und sie eines Nachts {i}auf die Jagd{/i} mitnehmen.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:823
translate de qst_HumanExp_11_returnFlowers_menu_e6faef72:

    # MC "(Hunting {i}people...{/i})"
    MC "(Die Jagd auf {i}Menschen...{/i})"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:824
translate de qst_HumanExp_11_returnFlowers_menu_87c233dd:

    # "Something about the wording of it made me slightly queasy, but [regina_ref!t] was right."
    "Etwas an der Wortwahl machte mich leicht mulmig, aber [regina_ref!t] hatte recht."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:825
translate de qst_HumanExp_11_returnFlowers_menu_310dae3a:

    # "Myu was a predator... And Myu would need to hunt."
    "Myu war ein Raubtier... Und Myu würde jagen müssen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:829
translate de qst_HumanExp_11_returnFlowers_menu_8dd667da:

    # "After that, I headed back to the abandoned safe house with a much healthier Myu."
    "Danach kehrte ich mit einer viel gesünderen Myu zum verlassenen Unterschlupf zurück."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:830
translate de qst_HumanExp_11_returnFlowers_menu_5421c183:

    # "[regina_ref_cap!t] followed us too at her insistence, in case she ever needed to visit the safe house and check on Myu herself."
    "[regina_ref_cap!t] folgte uns auf ihr Drängen hin auch, falls sie jemals den Unterschlupf besuchen und selbst nach Myu sehen müsste."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:837
translate de qst_HumanExp_11_returnFlowers_menu_c47cff1a:

    # REGINA @ talk "Ah, so this is the place."
    REGINA @ talk "Ah, das ist also der Ort."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:838
translate de qst_HumanExp_11_returnFlowers_menu_6750e14d:

    # REGINA @ smile "...Not very homely, is it?"
    REGINA @ smile "...Nicht sehr gemütlich, oder?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:839
translate de qst_HumanExp_11_returnFlowers_menu_e1e58f16:

    # MC @ talk "It's the best I could do on short notice."
    MC @ talk "Es ist das Beste, was ich so kurzfristig tun konnte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:840
translate de qst_HumanExp_11_returnFlowers_menu_0c652db2:

    # REGINA @ talk "It'll serve it's purpose."
    REGINA @ talk "Es wird seinen Zweck erfüllen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:841
translate de qst_HumanExp_11_returnFlowers_menu_911b8b2a:

    # "[regina_ref_cap!t] smiled as she turned to face Myu."
    "[regina_ref_cap!t] lächelte, als sie sich Myu zuwandte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:842
translate de qst_HumanExp_11_returnFlowers_menu_f137887c:

    # REGINA @ smile "Anyway, it was nice to meet you Myu!"
    REGINA @ smile "Jedenfalls, es war schön, dich kennenzulernen, Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:843
translate de qst_HumanExp_11_returnFlowers_menu_26d2afaf:

    # MYU @ joy "Thank you for food!"
    MYU @ joy "Danke für das Essen!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:844
translate de qst_HumanExp_11_returnFlowers_menu_7284c4cb:

    # REGINA @ smile "You're very welcome."
    REGINA @ smile "Gern geschehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:845
translate de qst_HumanExp_11_returnFlowers_menu_8b420002:

    # REGINA @ talk "Now, I must make my leave so..."
    REGINA @ talk "Nun muss ich mich verabschieden, also..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:847
translate de qst_HumanExp_11_returnFlowers_menu_fb7f6298:

    # REGINA @ talk "Goodbye both!"
    REGINA @ talk "Auf Wiedersehen, ihr beiden!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:848
translate de qst_HumanExp_11_returnFlowers_menu_badd5920:

    # MC @ talk "Bye [regina_ref!t]."
    MC @ talk "Tschüss [regina_ref!t]."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:849
translate de qst_HumanExp_11_returnFlowers_menu_2b826f25:

    # MYU @ joy "Bye bye nice lady!"
    MYU @ joy "Tschüss, nette Dame!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:850
translate de qst_HumanExp_11_returnFlowers_menu_8f359bd6:

    # "[regina_ref_cap!t] chuckled as she closed the door behind her."
    "[regina_ref_cap!t] kicherte, als sie die Tür hinter sich schloss."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:857
translate de qst_HumanExp_11_returnFlowers_menu_716247c1:

    # REGINA @ talk "Make sure to notify me the next time the two of them leave together, understand?"
    REGINA @ talk "Stell sicher, dass du mich das nächste Mal benachrichtigst, wenn die beiden zusammen gehen, verstanden?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:860
translate de qst_HumanExp_11_returnFlowers_menu_e09b5916:

    # RAVEN "{i}*Squarks!*{/i}"
    RAVEN "{i}*Krächz!*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:868
translate de qst_HumanExp_12_goHunting_4996d099:

    # "Myu tilted her head as she puzzled out my words."
    "Myu legte den Kopf schief, als sie meine Worte zu entschlüsseln versuchte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:869
translate de qst_HumanExp_12_goHunting_b2346d4e:

    # MYU @ think "...Hunt?"
    MYU @ think "...Jagen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:870
translate de qst_HumanExp_12_goHunting_50364f9b:

    # MC @ talk "Yeah, can you get back into-"
    MC @ talk "Ja, kannst du zurück in-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:871
translate de qst_HumanExp_12_goHunting_c2604d4b:

    # "Looking down at the container, I could see after last time, it now had a large crack running down it."
    "Als ich auf den Behälter hinabsah, konnte ich sehen, dass er nach dem letzten Mal einen großen Riss hatte, der sich daran entlangzog."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:872
translate de qst_HumanExp_12_goHunting_94ca2038:

    # MC "(Fuck, this is no good.)"
    MC "(Scheiße, das ist nicht gut.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:873
translate de qst_HumanExp_12_goHunting_f60cdd99:

    # MC @ talk "Myu, wait here while I look for something for you to hide in."
    MC @ talk "Myu, warte hier, während ich etwas suche, worin du dich verstecken kannst."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:874
translate de qst_HumanExp_12_goHunting_13e96976:

    # MYU @ talk "No... Myu... help."
    MYU @ talk "Nein ... Myu ... Hilfe."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:876
translate de qst_HumanExp_12_goHunting_969ccaed:

    # MC @ think "Help? What are you-"
    MC @ think "Hilfe? Was machst du-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:877
translate de qst_HumanExp_12_goHunting_c89dc97f:

    # "Myu dropped down into her puddle like form once again, crawling toward me quickly as she clambered up through the crevices of my armour."
    "Myu ließ sich erneut in ihre pfützenartige Form fallen, kroch schnell auf mich zu und kletterte durch die Ritzen meiner Rüstung hinauf."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:879
translate de qst_HumanExp_12_goHunting_c21dc864:

    # MC @ surprised "WHAT ARE YOU-"
    MC @ surprised "WAS MACHST DU-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:880
translate de qst_HumanExp_12_goHunting_ff3394d5:

    # "I could feel Myu warmly resting beneath my armour, she was calm, and only lightly shifting beneath me."
    "Ich konnte fühlen, wie Myu warm unter meiner Rüstung ruhte, sie war ruhig und bewegte sich nur leicht unter mir."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:881
translate de qst_HumanExp_12_goHunting_aaa82b0f:

    # "To the untrained eye, no one would know the difference."
    "Für das ungeübte Auge würde niemand den Unterschied bemerken."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:882
translate de qst_HumanExp_12_goHunting_1c145803:

    # MYU "Myu! Myu!"
    MYU "Myu! Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:883
translate de qst_HumanExp_12_goHunting_794ce1cb:

    # MC @ lewd "H-Hey! Easy down there!"
    MC @ lewd "H-Hey! Vorsichtig da unten!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:884
translate de qst_HumanExp_12_goHunting_93cc5246:

    # MYU "Myu... Hide... People... No see."
    MYU "Myu... Verstecken... Leute... Nicht sehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:885
translate de qst_HumanExp_12_goHunting_01091c43:

    # MC "(It's almost alarming how fast she's learning to speak Alderian.)"
    MC "(Es ist fast beunruhigend, wie schnell sie Alderianisch sprechen lernt.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:886
translate de qst_HumanExp_12_goHunting_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Seufz*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:888
translate de qst_HumanExp_12_goHunting_22924bcd:

    # MC @ serious "Okay, Myu, but no coming out till I say, okay?"
    MC @ serious "Okay, Myu, aber komm erst raus, wenn ich es sage, okay?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:889
translate de qst_HumanExp_12_goHunting_61b6bc4f:

    # MYU "Okay!"
    MYU "Okay!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:890
translate de qst_HumanExp_12_goHunting_da78808d:

    # "Beneath all the shifting under my armour, I felt what seemed like a lone tentacle sneakily moving further down than the others."
    "Unter all dem Geschiebe unter meiner Rüstung spürte ich, wie sich ein einzelner Tentakel heimlich weiter als die anderen nach unten bewegte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:892
translate de qst_HumanExp_12_goHunting_2e20f6ad:

    # MC @ talk "Myu... What are you doing?"
    MC @ talk "Myu... Was machst du da?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:893
translate de qst_HumanExp_12_goHunting_3643d5ca:

    # "The tentacle quickly retreated."
    "Der Tentakel zog sich schnell zurück."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:894
translate de qst_HumanExp_12_goHunting_663dc8eb:

    # MYU "{i}...Nothing!{/i}"
    MYU "{i}...Nichts!{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:895
translate de qst_HumanExp_12_goHunting_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:897
translate de qst_HumanExp_12_goHunting_5cfca60c:

    # "With Myu shuffling beneath my armour, the two of us headed out into the Evening."
    "Während Myu unter meiner Rüstung herumzappelte, machten wir uns beide auf den Weg in den Abend."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:898
translate de qst_HumanExp_12_goHunting_f6a007ce:

    # "The first thing I did was head into the darkened back streets, away from too many prying eyes where I knew bandits and other unsavoury figures tended to linger."
    "Als Erstes begab ich mich in die dunklen Seitenstraßen, fern von zu vielen neugierigen Augen, wo sich meines Wissens Banditen und andere zwielichtige Gestalten herumtrieben."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:899
translate de qst_HumanExp_12_goHunting_7275f098:

    # "It didn't take long before I was surrounded by a group of thugs, blades drawn ready."
    "Es dauerte nicht lange, bis ich von einer Gruppe bewaffneter Schläger umzingelt war."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:909
translate de qst_HumanExp_12_goHunting_60b56d76:

    # THUG "Enjoying a little evening stroll, are we?"
    THUG "Genießt du einen kleinen Abendspaziergang?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:910
translate de qst_HumanExp_12_goHunting_60f36fe8:

    # THUG "Hand over your coin and we'll let you walk."
    THUG "Gib dein Geld her und wir lassen dich laufen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:911
translate de qst_HumanExp_12_goHunting_96541c35:

    # MC @ talk "...Myu, are you ready?"
    MC @ talk "...Myu, bist du bereit?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:912
translate de qst_HumanExp_12_goHunting_bb741f1e:

    # MYU "..."
    MYU "..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:913
translate de qst_HumanExp_12_goHunting_db4a1e82:

    # "Myu said nothing, but I can feel something {i}changing{/i} beneath my armour."
    "Myu sagte nichts, aber ich spüre, wie sich etwas unter meiner Rüstung {i}verändert{/i}."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:914
translate de qst_HumanExp_12_goHunting_bf69987f:

    # "She might not have been able to understand all the words said just now, but she could {i}sense{/i} the men before her were hostile, and just like that, her animal instincts kicked in."
    "Vielleicht hatte sie nicht alle Worte, die gerade gesprochen wurden, verstehen können, aber sie konnte {i}spüren{/i}, dass die Männer vor ihr feindselig waren, und augenblicklich erwachten ihre tierischen Instinkte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:915
translate de qst_HumanExp_12_goHunting_37060419:

    # "Pouring out of my armour, she re-formed herself in a frightening visage of sharp blades and teeth, snarling at the terrified bandits who immediately began to panic."
    "Aus meiner Rüstung herausschwappend, formte sie sich zu einer furchterregenden Erscheinung aus scharfen Klingen und Zähnen, die die verängstigten Banditen anfauchte, welche sofort in Panik gerieten."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:918
translate de qst_HumanExp_12_goHunting_81f87009:

    # MYU "{i}*Snarls!*{/i}"
    MYU "{i}*Fauchen!*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:923
translate de qst_HumanExp_12_goHunting_d39f0328:

    # THUG "WHAT THE FUCK IS THAT?!"
    THUG "WAS ZUM TEUFEL IST DAS?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:924
translate de qst_HumanExp_12_goHunting_74096ffd:

    # THUG "Kill it! KILL IT NOW!"
    THUG "Töte es! TÖTE ES JETZT!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:928
translate de qst_HumanExp_12_goHunting_49fa8301:

    # "As I drew my blade down across the last thug, I turned to see Myu."
    "Als ich meine Klinge über den letzten Schläger zog, wandte ich mich um und sah Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:934
translate de qst_HumanExp_12_goHunting_2cd07a6f:

    # "Having eviscerated one of the bandits into a bloody pulp of flesh and blood, she was dissolving and devouring his flesh."
    "Nachdem sie einen der Banditen zu einem blutigen Brei aus Fleisch und Blut zerfetzt hatte, löste sie gerade sein Fleisch auf und verschlang es."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:935
translate de qst_HumanExp_12_goHunting_022d254d:

    # "The Blood splatter on her body was absorbed through her skin, and the cute innocence she had conveyed until now was all but gone."
    "Die Blutspritzer auf ihrem Körper wurden durch ihre Haut absorbiert, und die süße Unschuld, die sie bis jetzt ausgestrahlt hatte, war so gut wie verschwunden."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:936
translate de qst_HumanExp_12_goHunting_fa64eac2:

    # "Only this ghastly nightmare stood before me, lapping up the warm blood like milk."
    "Nur dieser grauenhafte Albtraum stand vor mir und schlabberte das warme Blut wie Milch auf."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:937
translate de qst_HumanExp_12_goHunting_c728332a:

    # "One of the bandits still squirmed as she pressed her bladed hand into his body."
    "Einer der Banditen zappelte noch, als sie ihre klingenbewehrte Hand in seinen Körper drückte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:939
translate de qst_HumanExp_12_goHunting_796deab9:

    # "Small tendrils pushed through his ripped open eye sockets and mouth."
    "Kleine Ranken drangen durch seine aufgerissenen Augenhöhlen und seinen Mund."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:940
translate de qst_HumanExp_12_goHunting_011a31cb:

    # "Tentacles tore their way through his body and could be seen shifting about beneath the skin."
    "Tentakel fraßen sich durch seinen Körper und waren darunter der Haut zu sehen, wie sie sich hin und her bewegten."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:942
translate de qst_HumanExp_12_goHunting_cc0c4ed1:

    # "He gargled and choked as the tentacles seemed to puppeteer him briefly till he finally fell still, dead and drained pale white."
    "Er gurgelte und würgte, als die Tentakel ihn kurz zu marionettisieren schienen, bis er schließlich reglos liegenblieb, tot und blassweiß ausgesaugt."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:943
translate de qst_HumanExp_12_goHunting_d06fcedc:

    # "For a moment, I considered abandoning this... {i}thing{/i} right here."
    "Für einen Moment erwog ich, dieses ... {i}Ding{/i} hier einfach aufzugeben."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:944
translate de qst_HumanExp_12_goHunting_fbf28920:

    # "I could escape, let the City Guard handle this {i}monster{/i} standing before me."
    "Ich könnte entkommen und die Stadtwache sich um dieses {i}Monster{/i} vor mir kümmern lassen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:946
translate de qst_HumanExp_12_goHunting_5512e3fe:

    # "Myu, noticing my expression, stopped eating and dragged her way towards me, the voice once again sweet as that innocent face of hers returned."
    "Myu, die meinen Gesichtsausdruck bemerkte, hörte auf zu essen und schleppte sich zu mir herüber, wobei ihre Stimme wieder süß wurde, als ihr unschuldiges Gesicht zurückkehrte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:950
translate de qst_HumanExp_12_goHunting_2534e2b7:

    # MYU @ sad "We... Go?"
    MYU @ sad "Wir... gehen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:951
translate de qst_HumanExp_12_goHunting_f41c9653:

    # MC @ sad "...Y-Yes, we go."
    MC @ sad "...J-Ja, wir gehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:955
translate de qst_HumanExp_12_goHunting_49eba397:

    # "The two of us hurried as we slipped away into the darkness back home before the guards stumbled upon the grizzly scene left in our wake."
    "Wir beide eilten uns, in die Dunkelheit nach Hause zu schlüpfen, bevor die Wachen auf die grausige Szene stießen, die wir hinterlassen hatten."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:961
translate de qst_HumanExp_12_goHunting_b449b2ec:

    # MYU @ sad "...[player_name!t]?"
    MYU @ sad "...[player_name!t]?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:962
translate de qst_HumanExp_12_goHunting_4ac8c646:

    # MC @ talk "Myu? What is it?"
    MC @ talk "Myu? Was ist los?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:963
translate de qst_HumanExp_12_goHunting_6010b8f6:

    # MYU @ sad "{i}Why... Look at Myu like that...{/i}"
    MYU @ sad "{i}Warum... schaue ich Myu so an...{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:964
translate de qst_HumanExp_12_goHunting_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "Hä?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:965
translate de qst_HumanExp_12_goHunting_72fee8b8:

    # MYU @ sad "Back in alley..."
    MYU @ sad "Zurück in der Gasse..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:966
translate de qst_HumanExp_12_goHunting_0299ab02:

    # MYU @ sad "Not seen look at me like that before."
    MYU @ sad "So einen Blick noch nie auf mir gesehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:967
translate de qst_HumanExp_12_goHunting_02c4c377:

    # MYU @ sad "Was Myu bad?"
    MYU @ sad "War Myu böse?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:968
translate de qst_HumanExp_12_goHunting_69c9834e:

    # MC @ sad "I-"
    MC @ sad "Ich-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:969
translate de qst_HumanExp_12_goHunting_89017916:

    # MC @ sad "No, Myu, you weren't bad."
    MC @ sad "Nein, Myu, du warst nicht böse."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:970
translate de qst_HumanExp_12_goHunting_14f50b3f:

    # MC @ talk "I've just never seen you like that before."
    MC @ talk "Ich habe dich einfach noch nie so gesehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:971
translate de qst_HumanExp_12_goHunting_b51439e1:

    # MYU @ sad "Like what?"
    MYU @ sad "Wie was?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:972
translate de qst_HumanExp_12_goHunting_f47d7bb8:

    # MC @ think "Just..."
    MC @ think "Einfach..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:973
translate de qst_HumanExp_12_goHunting_ed3f878c:

    # "I didn't know how to answer her, what {i}could{/i} I say after what I just saw?"
    "Ich wusste nicht, wie ich ihr antworten sollte, was {i}könnte{/i} ich sagen nach dem, was ich gerade gesehen hatte?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:974
translate de qst_HumanExp_12_goHunting_7d580b52:

    # MC @ smile "Myu, why don't you get some rest?"
    MC @ smile "Myu, warum ruhst du dich nicht etwas aus?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:975
translate de qst_HumanExp_12_goHunting_11db02de:

    # MC @ smile "Its been a long night."
    MC @ smile "Es war eine lange Nacht."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:976
translate de qst_HumanExp_12_goHunting_89de05dc:

    # "Myu nodded softly, making her way towards the bedroom."
    "Myu nickte sanft und machte sich auf den Weg zum Schlafzimmer."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:980
translate de qst_HumanExp_12_goHunting_73488014:

    # REGINA @ talk "How did it go?"
    REGINA @ talk "Wie ist es gelaufen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:982
translate de qst_HumanExp_12_goHunting_ab4c4d36:

    # MC @ surprised "[regina_ref_cap!t]! How long have you-"
    MC @ surprised "[regina_ref_cap!t]! Wie lange bist du schon-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:983
translate de qst_HumanExp_12_goHunting_46eac9a6:

    # REGINA @ smile "Oh, I just slipped in earlier to see how Myu was doing!"
    REGINA @ smile "Oh, ich bin vorhin nur reingeschlüpft, um zu sehen, wie es Myu geht!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:984
translate de qst_HumanExp_12_goHunting_ee978acf:

    # REGINA @ talk "When I noticed she was gone, I figured the two of you must have been {i}out,{/i} so I decided to wait for you."
    REGINA @ talk "Als ich bemerkte, dass sie weg war, dachte ich, ihr beiden müsst {i}unterwegs{/i} gewesen sein, also beschloss ich, auf euch zu warten."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:985
translate de qst_HumanExp_12_goHunting_b1b3ce81:

    # MC @ think "O-Oh, right, of course."
    MC @ think "O-Oh, richtig, natürlich."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:989
translate de qst_HumanExp_12_goHunting_b78cb548:

    # REGINA @ sad "...So, how was it?"
    REGINA @ sad "...Also, wie war es?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:990
translate de qst_HumanExp_12_goHunting_b060895f:

    # MC @ serious "It was... Difficult seeing her do that."
    MC @ serious "Es war... schwierig, sie so etwas tun zu sehen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:991
translate de qst_HumanExp_12_goHunting_b0c66fe1:

    # MC @ sad "Like, it felt like I was dealing with another {i}monster.{/i}"
    MC @ sad "Irgendwie fühlte es sich an, als hätte ich es mit einem weiteren {i}Monster{/i} zu tun."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:992
translate de qst_HumanExp_12_goHunting_07f65605:

    # REGINA @ sad "{i}*Sigh*{/i}"
    REGINA @ sad "{i}*Seufz*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:993
translate de qst_HumanExp_12_goHunting_5c6cb119:

    # REGINA @ sad "It's her nature, [player_name!t], no matter how much she learns to be around humans, that killer instinct will always be there."
    REGINA @ sad "Es liegt in ihrer Natur, [player_name!t], egal wie sehr sie lernt, mit Menschen umzugehen, dieser Killerinstinkt wird immer da sein."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:994
translate de qst_HumanExp_12_goHunting_1ccd9609:

    # MC @ talk "...Is she safe to keep around?"
    MC @ talk "...Ist es sicher, sie in der Nähe zu behalten?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:995
translate de qst_HumanExp_12_goHunting_d3a8eb26:

    # "[regina_ref_cap!t] shrugged."
    "[regina_ref_cap!t] zuckte mit den Schultern."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:996
translate de qst_HumanExp_12_goHunting_e3a90034:

    # REGINA @ talk "People have kept and trained slimes before."
    REGINA @ talk "Leute haben schon zuvor Schleime gehalten und trainiert."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:997
translate de qst_HumanExp_12_goHunting_f3037070:

    # REGINA @ talk "But its not like keeping a dog."
    REGINA @ talk "Aber es ist nicht so, als würde man einen Hund halten."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:998
translate de qst_HumanExp_12_goHunting_fa93a8fa:

    # REGINA @ talk "Even if they {i}*can*{/i} speak, they can still switch at a moment's notice."
    REGINA @ talk "Selbst wenn sie {i}*sprechen*{/i} können, können sie trotzdem jederzeit umschlagen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:999
translate de qst_HumanExp_12_goHunting_84335a2a:

    # MC @ surprised "But, you said she's imprinted on me, right?"
    MC @ surprised "Aber du hast gesagt, sie hat sich auf mich geprägt, oder?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1000
translate de qst_HumanExp_12_goHunting_a399f7bc:

    # REGINA @ talk "Doesn't mean she wont attack others if she gets overwhelmed or any number of things could happen..."
    REGINA @ talk "Das heißt nicht, dass sie nicht andere angreift, wenn sie überfordert wird, oder dass eine Menge anderer Dinge passieren könnten..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1001
translate de qst_HumanExp_12_goHunting_7821a17c:

    # MC @ talk "Then what should I do with her?"
    MC @ talk "Was soll ich dann mit ihr machen?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1002
translate de qst_HumanExp_12_goHunting_9898c219:

    # REGINA @ talk "Just keep an eye on her, that's all."
    REGINA @ talk "Behalte sie einfach im Auge, das ist alles."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1003
translate de qst_HumanExp_12_goHunting_4d3c2876:

    # REGINA @ talk "Only time will tell."
    REGINA @ talk "Nur die Zeit wird es zeigen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1004
translate de qst_HumanExp_12_goHunting_9d8f7bf6:

    # MC @ talk "{i}*Sigh*{/i}"
    MC @ talk "{i}*Seufz*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1005
translate de qst_HumanExp_12_goHunting_4f113424:

    # MC @ talk "I need some room."
    MC @ talk "Ich brauche etwas Platz."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1012
translate de qst_HumanExp_12_goHunting_a1873268:

    # MYU @ sad "..."
    MYU @ sad "..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1013
translate de qst_HumanExp_12_goHunting_7159a1e6:

    # MYU @ sad "Myu is..."
    MYU @ sad "Myu ist..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1014
translate de qst_HumanExp_12_goHunting_3a796eb3:

    # MYU @ sad "{i}Monster.{/i}"
    MYU @ sad "{i}Monster.{/i}"

translate de strings:

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:82
    old "I'm hoping to improve my own mastery of the language."
    new "Ich hoffe, meine eigenen Sprachkenntnisse zu verbessern."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:87
    old "My reasons are my own."
    new "Meine Gründe sind meine eigenen."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:89
    old "I'm trying to teach someone."
    new "Ich versuche, jemandem etwas beizubringen."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:110
    old "Is there no way you could sell it to me cheaper?"
    new "Gibt es keine Möglichkeit, dass du es mir billiger verkaufen könntest?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:121
    old "Here is the coin."
    new "Hier ist die Münze."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:138
    old "I will be back soon."
    new "Ich werde bald zurück sein."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:226
    old "How about we get to know each other a little more first?"
    new "Wie wäre es, wenn wir uns zuerst ein wenig besser kennenlernen?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:233
    old "Oh yeah, your ass belongs to me."
    new "Oh ja, dein Arsch gehört mir."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:256
    old "Myu, I'm sorry, I don't see you that way."
    new "Myu, es tut mir leid, ich sehe dich nicht so."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:361
    old "There's a difference between expecting people with more money and power to be more responsible, and {i}punishing{/i} them for their wealth."
    new "Es gibt einen Unterschied zwischen der Erwartung, dass Menschen mit mehr Geld und Macht verantwortungsvoller sind, und sie {i}für ihren Reichtum zu bestrafen{/i}."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:364
    old "Personally, I think we could do without any of the Aristocracy... We could manage better on our own."
    new "Ich persönlich denke, wir könnten auf die gesamte Aristokratie verzichten... Wir könnten es besser allein schaffen."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:369
    old "Someone needs to be in charge, they have tough decisions to make themselves."
    new "Jemand muss das Sagen haben, sie müssen selbst schwierige Entscheidungen treffen."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:572
    old "Hm, I will come back another time then."
    new "Hm, dann komme ich ein andermal wieder."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:793
    old "So, you {i}don't{/i} want me to get rid of her?"
    new "Also, du willst {i}nicht{/i}, dass ich sie loswerde?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:801
    old "I figured you'd be more afraid when you saw her..."
    new "Ich dachte, du wärst ängstlicher, als du sie gesehen hast..."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:809
    old "So... What now?"
    new "Also... Was nun?"

