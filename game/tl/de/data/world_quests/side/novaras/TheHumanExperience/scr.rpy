translate de qst_HumanExp_1_feedMyu_After_98973b50:

    # MC "(I guess I should try devoting some time to teaching Myu some Alderian.)"
    MC "(Ich schätze, ich sollte versuchen, etwas Zeit darauf zu verwenden, Myu etwas Alderian beizubringen.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:55
translate de qst_HumanExp_1_feedMyu_After_acc4f47d:

    # MC "(Being able to talk to her more will at least make life easier.)"
    MC "(Dass ich mehr mit ihr reden kann, wird das Leben zumindest einfacher machen.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:56
translate de qst_HumanExp_1_feedMyu_After_76fd22d3:

    # MC "(Maybe then I'll be able to figure out what to do with her at least.)"
    MC "(Vielleicht kann ich dann zumindest herausfinden, was ich mit ihr tun soll.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:61
translate de qst_HumanExp_2_lesson_9713ef32:

    # MYU @ smile "O-Okay!"
    MYU @ smile "O-Okay!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:63
translate de qst_HumanExp_2_lesson_bc5ee01a:

    # "After spending some time teaching Myu the basics, starting with just pointing to various objects and having her say the word associated with them, Myu began to pick things up very quickly."
    "Nachdem ich einige Zeit damit verbracht hatte, Myu die Grundlagen beizubringen, angefangen damit, einfach auf verschiedene Objekte zu zeigen und sie das dazugehörige Wort sagen zu lassen, begann Myu, die Dinge sehr schnell aufzunehmen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:65
translate de qst_HumanExp_2_lesson_1957c04c:

    # "Afterwards, we moved onto slowly walking her through some simple phrases and things, and Myu enthusiastically got to grips with these too."
    "Danach gingen wir dazu über, ihr langsam einige einfache Sätze und Dinge beizubringen, und Myu machte sich enthusiastisch auch mit diesen vertraut."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:70
translate de qst_HumanExp_2_lesson_48bcb9f8:

    # MC @ smile "Very good, Myu, you're learning fast."
    MC @ smile "Sehr gut, Myu, du lernst schnell."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:71
translate de qst_HumanExp_2_lesson_47e9e2a2:

    # MC "({i}Very fast{/i}.)"
    MC "({i}Sehr schnell{/i}.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:72
translate de qst_HumanExp_2_lesson_56ad8f9c:

    # MC "(If she keeps this up she'll be speaking fluent Alderian in no time.)"
    MC "(Wenn sie so weitermacht, wird sie im Nu fließend Alderian sprechen.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:73
translate de qst_HumanExp_2_lesson_913b976a:

    # MYU @ joy "Myu... Happy... Learn."
    MYU @ joy "Myu... Glücklich... Lernen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:74
translate de qst_HumanExp_2_lesson_8a326381:

    # MC "(Maybe I could buy her some kind of reading material to help teach her?)"
    MC "(Vielleicht könnte ich ihr irgendein Lesematerial kaufen, um ihr beim Lernen zu helfen?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:79
translate de qst_HumanExp_3_grabBook_atLibrary_3e696818:

    # VALA "Hm?"
    VALA "Hm?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:80
translate de qst_HumanExp_3_grabBook_atLibrary_55eed43e:

    # VALA "What do you need that for?"
    VALA "Wofür brauchst du das?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:83
translate de qst_HumanExp_3_grabBook_atLibrary_5e1118c2:

    # VALA "Oh my..."
    VALA "Oh je..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:85
translate de qst_HumanExp_3_grabBook_atLibrary_b2e2530f:

    # VALA "That's quite the noble commitment!"
    VALA "Das ist eine ziemlich edle Verpflichtung!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:86
translate de qst_HumanExp_3_grabBook_atLibrary_80e741f6:

    # VALA "Always nice to see someone showing more appreciation for the nuances of our language!"
    VALA "Es ist immer schön zu sehen, wenn jemand die Nuancen unserer Sprache mehr zu schätzen weiß!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:88
translate de qst_HumanExp_3_grabBook_atLibrary_06a0a691:

    # VALA "Hm, well, okay then."
    VALA "Hm, nun, okay dann."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:90
translate de qst_HumanExp_3_grabBook_atLibrary_9b101baa:

    # VALA "I never took you for a teacher!"
    VALA "Ich hätte dich nie für einen Lehrer gehalten!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:91
translate de qst_HumanExp_3_grabBook_atLibrary_df7a811d:

    # VALA "How old are the students? Are they perhaps younger relatives of yours?"
    VALA "Wie alt sind die Schüler? Sind es vielleicht jüngere Verwandte von dir?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:92
translate de qst_HumanExp_3_grabBook_atLibrary_d96a0689:

    # MC @ talk "Uhh, not exactly..."
    MC @ talk "Ähm, nicht genau..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:93
translate de qst_HumanExp_3_grabBook_atLibrary_b42e9824:

    # VALA "Well, I'm always happy to help when it comes to education!"
    VALA "Nun, ich helfe immer gerne, wenn es um Bildung geht!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:94
translate de qst_HumanExp_3_grabBook_atLibrary_fe95b892:

    # MC @ talk "Do you perhaps have have a selection of books?"
    MC @ talk "Hast du vielleicht eine Auswahl an Büchern?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:95
translate de qst_HumanExp_3_grabBook_atLibrary_2f4b0394:

    # MC @ think "Something to teach a beginner to something more advanced?"
    MC @ think "Etwas, um einen Anfänger bis zu etwas Fortgeschrittenerem zu unterrichten?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:96
translate de qst_HumanExp_3_grabBook_atLibrary_9fb423eb:

    # VALA "Well, you are in luck."
    VALA "Nun, du hast Glück."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:97
translate de qst_HumanExp_3_grabBook_atLibrary_06ff84dd:

    # VALA "I know we have plenty of copies of {i}'Agathons learning Alderian.'{/i}"
    VALA "Ich weiß, wir haben viele Exemplare von {i}'Agathons Alderianisch lernen.'{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:98
translate de qst_HumanExp_3_grabBook_atLibrary_19812dbd:

    # MC @ think "I don't remember studying from that collection."
    MC @ think "Ich erinnere mich nicht, aus dieser Sammlung gelernt zu haben."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:99
translate de qst_HumanExp_3_grabBook_atLibrary_0ca76cef:

    # VALA "You very likely wouldn't have, it's not mandatory for students."
    VALA "Das hätten Sie höchstwahrscheinlich auch nicht, es ist für Studenten nicht verpflichtend."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:100
translate de qst_HumanExp_3_grabBook_atLibrary_720db266:

    # VALA "It's very popular amongst Aristocrats teaching their children, however."
    VALA "Es ist jedoch sehr beliebt bei Aristokraten, die ihre Kinder unterrichten."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:101
translate de qst_HumanExp_3_grabBook_atLibrary_95cb92d2:

    # MC @ talk "Hmm... I see."
    MC @ talk "Hmm... Ich verstehe."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:102
translate de qst_HumanExp_3_grabBook_atLibrary_82bb45ee:

    # MC @ talk "How much for a copy of the collection?"
    MC @ talk "Wie viel kostet eine Kopie der Sammlung?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:103
translate de qst_HumanExp_3_grabBook_atLibrary_3745d995:

    # VALA @ sad "Hmm, well, this is the difficult part."
    VALA @ sad "Hmm, nun, das ist der schwierige Teil."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:104
translate de qst_HumanExp_3_grabBook_atLibrary_e86ecd57:

    # VALA @ sad "At least five hundred coins for the collection."
    VALA @ sad "Mindestens fünfhundert Münzen für die Sammlung."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:105
translate de qst_HumanExp_3_grabBook_atLibrary_7d84e5f7:

    # MC @ surprised "Five hundred?!"
    MC @ surprised "Fünfhundert?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:106
translate de qst_HumanExp_3_grabBook_atLibrary_78f75768:

    # VALA @ sad "... How do you think they keep the books circulating strictly amongst aristocracy?"
    VALA @ sad "... Was glauben Sie, wie sie die Bücher ausschließlich unter der Aristokratie in Umlauf halten?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:107
translate de qst_HumanExp_3_grabBook_atLibrary_44d5519c:

    # VALA @ sad "Make it too expensive a commodity for the common people of course."
    VALA @ sad "Indem man es natürlich zu einem zu teuren Gut für das gemeine Volk macht."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:108
translate de qst_HumanExp_3_grabBook_atLibrary_a6681280:

    # "I pushed my disgust aside, no good came from dwelling on it now."
    "Ich schob meinen Ekel beiseite, es brachte nichts, jetzt darüber nachzugrübeln."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:113
translate de qst_HumanExp_3_grabBook_atLibrary_menu_e8c0c2aa:

    # VALA "I... There is a slightly damaged copy of the collection that I could sell it to you at a slight discount?"
    VALA "Ich... Es gibt eine leicht beschädigte Ausgabe der Sammlung, die ich Ihnen mit einem kleinen Rabatt verkaufen könnte?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:114
translate de qst_HumanExp_3_grabBook_atLibrary_menu_a8baf491:

    # VALA "It's still perfectly fine, but no aristocratic family would want it."
    VALA "Sie ist noch vollkommen in Ordnung, aber keine aristokratische Familie würde sie wollen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:115
translate de qst_HumanExp_3_grabBook_atLibrary_menu_c7145360:

    # MC @ smile "That would be great if you could."
    MC @ smile "Das wäre großartig, wenn Sie das könnten."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:116
translate de qst_HumanExp_3_grabBook_atLibrary_menu_e25e3cca:

    # VALA "Alright, I can get away with selling it for four hundred coins."
    VALA "In Ordnung, ich komme damit durch, sie für vierhundert Münzen zu verkaufen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:117
translate de qst_HumanExp_3_grabBook_atLibrary_menu_1e29d615:

    # VALA "Any less, and its my job on the line."
    VALA "Weniger, und mein Job steht auf dem Spiel."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:118
translate de qst_HumanExp_3_grabBook_atLibrary_menu_5c6a435e:

    # VALA "So, four hundred it is."
    VALA "Also, dann sind es vierhundert."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:122
translate de qst_HumanExp_3_grabBook_atLibrary_menu_b8c5118e:

    # VALA "Ah! Okay!"
    VALA "Ah! Okay!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:124
translate de qst_HumanExp_3_grabBook_atLibrary_menu_90316531:

    # VALA "Let me just bind the collection for you and it's all yours!"
    VALA "Lassen Sie mich nur schnell die Sammlung für Sie binden, dann gehört sie Ihnen!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:130
translate de qst_HumanExp_3_grabBook_atLibrary_menu_188f15c4:

    # VALA "Here you go!"
    VALA "Hier, bitte!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:134
translate de qst_HumanExp_3_grabBook_atLibrary_menu_400bf3f5:

    # MC @ smile "Thank you, Vala."
    MC @ smile "Danke, Vala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:135
translate de qst_HumanExp_3_grabBook_atLibrary_menu_389afce0:

    # MC "(I better get this back to Myu.)"
    MC "(Ich sollte das besser zu Myu zurückbringen.)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:140
translate de qst_HumanExp_3_grabBook_atLibrary_menu_684a3850:

    # VALA "I'll keep the books ready for you."
    VALA "Ich halte die Bücher für dich bereit."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:145
translate de qst_HumanExp_3_grabBook_atLibrary_revisit_0b639321:

    # VALA "Yeah, it's five hundred coins for the collection of books on Alderian language."
    VALA "Ja, es sind fünfhundert Münzen für die Sammlung von Büchern über die alderianische Sprache."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:147
translate de qst_HumanExp_3_grabBook_atLibrary_revisit_4f5efc7e:

    # VALA "Yeah, four hundred coins and the collection is yours."
    VALA "Ja, vierhundert Münzen und die Sammlung gehört dir."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:152
translate de qst_HumanExp_3_grabBook_atLibrary_revisit_menu_e8c0c2aa:

