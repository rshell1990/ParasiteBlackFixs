    MC @ talk "Hallo! Ist da jemand?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:184
translate de qst_NewMyu_4_findMyuChurch_47dd0b3c:

    # KYLISA @ smile "We meet again, [player_name!t]."
    KYLISA @ smile "Wir treffen uns wieder, [player_name!t]."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:185
translate de qst_NewMyu_4_findMyuChurch_488f936c:

    # MC @ surprised "Wait, I know you, you're-"
    MC @ surprised "Warte, ich kenne dich, du bist-"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:186
translate de qst_NewMyu_4_findMyuChurch_07c5cfca:

    # KYLISA @ talk "Kylisa, the royal mage."
    KYLISA @ talk "Kylisa, die königliche Magierin."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:187
translate de qst_NewMyu_4_findMyuChurch_faa8ace4:

    # KYLISA @ talk "I was there when you were brought into the Hospital to check you for any Demorai taint."
    KYLISA @ talk "Ich war dort, als du ins Krankenhaus gebracht wurdest, um dich auf eine Demorai-Verderbnis zu überprüfen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:190
translate de qst_NewMyu_4_findMyuChurch_5170b6ec:

    # KYLISA @ talk "Can I help you with something?"
    KYLISA @ talk "Kann ich dir mit etwas helfen?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:191
translate de qst_NewMyu_4_findMyuChurch_4e2dfed7:

    # KYLISA @ talk "There're no services today."
    KYLISA @ talk "Es gibt heute keine Gottesdienste."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:192
translate de qst_NewMyu_4_findMyuChurch_fd21584e:

    # MC @ talk "I... No."
    MC @ talk "Ich... Nein."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:193
translate de qst_NewMyu_4_findMyuChurch_c7142664:

    # KYLISA @ talk "Then you should-"
    KYLISA @ talk "Dann solltest du-"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:195
translate de qst_NewMyu_4_findMyuChurch_767c08bb:

    # "I heard a soft voice calling from inside the Church hall."
    "Ich hörte eine sanfte Stimme aus dem Inneren der Kirchenhalle rufen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:196
translate de qst_NewMyu_4_findMyuChurch_8c646798:

    # MYU "It's okay..{i}*Sniff*{/i} It's him."
    MYU "Es ist okay..{i}*Schnief*{/i} Es ist er."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:197
translate de qst_NewMyu_4_findMyuChurch_fe643940:

    # KYLISA @ sad "Ah..."
    KYLISA @ sad "Ah..."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:198
translate de qst_NewMyu_4_findMyuChurch_5c9466f6:

    # KYLISA @ talk "Your {i}friend{/i} said you would look for her."
    KYLISA @ talk "Deine {i}Freundin{/i} sagte, du würdest nach ihr suchen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:199
translate de qst_NewMyu_4_findMyuChurch_d47da673:

    # MC @ sad "What is Myu doing in there?"
    MC @ sad "Was macht Myu da drin?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:200
translate de qst_NewMyu_4_findMyuChurch_cbf62435:

    # KYLISA @ sad "I found the poor thing sobbing in the pews telling me she was a monster over and over again."
    KYLISA @ sad "Ich fand das arme Ding in den Kirchenbänken schluchzend, und sie sagte mir immer wieder, sie sei ein Monster."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:201
translate de qst_NewMyu_4_findMyuChurch_e71bf7fc:

    # KYLISA @ sad "So, I canceled the services for today."
    KYLISA @ sad "Also habe ich die Gottesdienste für heute abgesagt."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:206
translate de qst_NewMyu_4_findMyuChurch_menu_d512b3b1:

    # KYLISA @ angry "Because some of us can still remember when times were better and we fought back against the over-reach of the inquisitors."
    KYLISA @ angry "Weil sich einige von uns noch daran erinnern, als die Zeiten besser waren und wir uns gegen die Übergriffe der Inquisitoren zur Wehr setzten."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:207
translate de qst_NewMyu_4_findMyuChurch_menu_de7ef835:

    # KYLISA @ talk "The inquisitors destroy whatever they fear, but there was a time we strived to understand different races."
    KYLISA @ talk "Die Inquisitoren zerstören alles, was sie fürchten, aber es gab eine Zeit, da wir danach strebten, verschiedene Rassen zu verstehen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:208
translate de qst_NewMyu_4_findMyuChurch_menu_e90b93c7:

    # KYLISA @ talk "I must admit, I was a little taken aback at first by a slimelark, but our faith is not one to turn away the weary, whoever or whatever they may be."
    KYLISA @ talk "Ich muss zugeben, ich war anfangs etwas verblüfft von einer Schleimlerche, aber unser Glaube ist nicht einer, der die Müden abweist, wer oder was auch immer sie sein mögen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:211
translate de qst_NewMyu_4_findMyuChurch_menu_d72d0c11:

    # KYLISA @ talk "Of course, but be gentle with her."
    KYLISA @ talk "Natürlich, aber sei sanft zu ihr."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:212
translate de qst_NewMyu_4_findMyuChurch_menu_17fcf1b7:

    # KYLISA @ talk "She's quite... fragile."
    KYLISA @ talk "Sie ist ziemlich... zerbrechlich."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:223
translate de qst_NewMyu_4_findMyuChurch_menu_0fae614a:

    # "When I entered the Church, Myu continued to cry softly, and when she saw me she stood up and slowly approached anxiously."
    "Als ich die Kirche betrat, weinte Myu weiterhin leise, und als sie mich sah, stand sie auf und näherte sich langsam und ängstlich."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:225
translate de qst_NewMyu_4_findMyuChurch_menu_fad080da:

    # MYU @ sad "...Myu feels like such a fool."
    MYU @ sad "...Myu kommt sich so dumm vor."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:226
translate de qst_NewMyu_4_findMyuChurch_menu_56282f41:

    # MC @ sad "Myu, what happened back there?"
    MC @ sad "Myu, was ist gerade passiert?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:227
translate de qst_NewMyu_4_findMyuChurch_menu_bd7c742b:

    # MC @ talk "Why were you feeding on someone in your room?"
    MC @ talk "Warum hast du dich in deinem Zimmer von jemandem ernährt?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:228
translate de qst_NewMyu_4_findMyuChurch_menu_ff5f2a2b:

    # MC @ talk "Why didn't you just tell me you wanted to hunt?"
    MC @ talk "Warum hast du mir nicht einfach gesagt, dass du jagen wolltest?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:229
translate de qst_NewMyu_4_findMyuChurch_menu_047dff7d:

    # "Myu fumbled on her words, struggling to get out what she wanted to say."
    "Myu verhaspelte sich und rang darum, herauszubekommen, was sie sagen wollte."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:230
translate de qst_NewMyu_4_findMyuChurch_menu_9e1d8414:

    # MYU @ sad "{i}...Myu wanted to show you she could be normal.{/i}"
    MYU @ sad "{i}...Myu wollte dir zeigen, dass sie normal sein kann.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:231
translate de qst_NewMyu_4_findMyuChurch_menu_dcfad6aa:

    # MYU @ sad "{i}Myu wanted to prove she wasn't a monster...{/i}"
    MYU @ sad "{i}Myu wollte beweisen, dass sie kein Monster war...{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:232
translate de qst_NewMyu_4_findMyuChurch_menu_a6bd4ad4:

    # MYU @ sad "So Myu tried eating like everyone else."
    MYU @ sad "Also versuchte Myu, wie alle anderen zu essen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:233
translate de qst_NewMyu_4_findMyuChurch_menu_7564ec5b:

    # MYU @ sad "But it just kept making Myu more and more sick."
    MYU @ sad "Aber es machte Myu nur immer kränker."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:234
translate de qst_NewMyu_4_findMyuChurch_menu_87e50561:

    # MYU sad "Till Myu was soooo hungry."
    MYU sad "Bis Myu soooo hungrig war."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:235
translate de qst_NewMyu_4_findMyuChurch_menu_0a99c764:

    # MYU @ sad "Myu couldn't stop herself anymore... All Myu could think about was food."
    MYU @ sad "Myu konnte sich nicht mehr zurückhalten... Alles, woran Myu denken konnte, war Essen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:236
translate de qst_NewMyu_4_findMyuChurch_menu_542b671d:

    # MYU @ sad "Myu saw the way you looked at her last time, Myu so... {i}dirty.{/i}"
    MYU @ sad "Myu sah, wie du sie letztes Mal angeschaut hast, Myu so... {i}schmutzig.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:237
translate de qst_NewMyu_4_findMyuChurch_menu_4077d558:

    # MYU @ sad "Myu didn't want you to feel dirty again, no matter how hungry she got."
    MYU @ sad "Myu wollte nicht, dass du dich wieder schmutzig fühlst, egal wie hungrig sie wurde."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:238
translate de qst_NewMyu_4_findMyuChurch_menu_275e2d28:

    # MYU @ sad "So, Myu hunted alone, wanted to hide it from you so you wouldn't see Myu like that again."
    MYU @ sad "Also jagte Myu allein, wollte es vor dir verstecken, damit du Myu nicht wieder so siehst."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:239
translate de qst_NewMyu_4_findMyuChurch_menu_3040230e:

    # "Myu began to sob."
    "Myu begann zu schluchzen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:240
translate de qst_NewMyu_4_findMyuChurch_menu_b40b56f3:

    # MC @ sad "...Oh, Myu."
    MC @ sad "...Oh, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:241
translate de qst_NewMyu_4_findMyuChurch_menu_d9dfd88f:

    # "I gently wiped away one of her tears."
    "Ich wischte sanft eine ihrer Tränen weg."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:242
translate de qst_NewMyu_4_findMyuChurch_menu_9d7e2515:

    # MC @ sad "Listen to me, Myu."
    MC @ sad "Hör mir zu, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:243
translate de qst_NewMyu_4_findMyuChurch_menu_ef65510d:

    # MC @ think "Everyone has... {i}darkness{/i} inside of them."
    MC @ think "Jeder hat... {i}Dunkelheit{/i} in sich."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:244
translate de qst_NewMyu_4_findMyuChurch_menu_9e6aecb3:

    # MC @ talk "And sometimes, that darkness can be a little scary."
    MC @ talk "Und manchmal kann diese Dunkelheit ein wenig beängstigend sein."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:245
translate de qst_NewMyu_4_findMyuChurch_menu_2634160e:

    # MC @ serious "But you're not defined by what you are, but {i}who{/i} you are."
    MC @ serious "Aber du wirst nicht durch das definiert, was du bist, sondern {i}wer{/i} du bist."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:246
translate de qst_NewMyu_4_findMyuChurch_menu_43cccb6a:

    # MYU @ sad "...Is [player_name!t] scared of Myu?"
    MYU @ sad "...Hat [player_name!t] Angst vor Myu?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:247
translate de qst_NewMyu_4_findMyuChurch_menu_667c4a7d:

    # MC @ talk "...No, Myu."
    MC @ talk "...Nein, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:248
translate de qst_NewMyu_4_findMyuChurch_menu_5feaf410:

    # MYU @ sad "W-Why?"
    MYU @ sad "W-Warum?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:249
translate de qst_NewMyu_4_findMyuChurch_menu_44cf84ff:

    # MYU @ sad "{i}You said Myu was a monster.{/i}"
    MYU @ sad "{i}Du hast gesagt, Myu sei ein Monster.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:250
translate de qst_NewMyu_4_findMyuChurch_menu_b62129ee:

    # MYU @ sad "Monsters are bad, monsters are the worst..."
    MYU @ sad "Monster sind böse, Monster sind das Schlimmste..."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:251
translate de qst_NewMyu_4_findMyuChurch_menu_916c466a:

    # MC @ talk "You're not a monster Myu... You're just a scared girl trying to understand a scary world."
    MC @ talk "Du bist kein Monster, Myu... Du bist nur ein verängstigtes Mädchen, das versucht, eine beängstigende Welt zu verstehen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:252
translate de qst_NewMyu_4_findMyuChurch_menu_0ea19dfc:

    # MC @ talk "I'm sorry I made you feel the way you did, and truth is, you {i}did{/i} scare me a little."
    MC @ talk "Es tut mir leid, dass ich dich so fühlen ließ, und um ehrlich zu sein, du hast mir {i}wirklich{/i} ein bisschen Angst gemacht."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:253
translate de qst_NewMyu_4_findMyuChurch_menu_d5d364dc:

    # "Myu's eyes dropped to the floor dejectedly."
    "Myus Augen senkten sich niedergeschlagen zu Boden."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:254
translate de qst_NewMyu_4_findMyuChurch_menu_8b40679b:

    # MC @ talk "But... That's okay."
    MC @ talk "Aber... das ist in Ordnung."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:255
translate de qst_NewMyu_4_findMyuChurch_menu_01cd8043:

    # MC @ smile "{i}Because I guess I'm kinda scary too sometimes.{/i}"
    MC @ smile "{i}Weil ich schätze, ich bin auch manchmal irgendwie unheimlich.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:256
translate de qst_NewMyu_4_findMyuChurch_menu_3443b8a7:

    # MC @ smile "And just because you're a little different, it doesn't make you a monster."
    MC @ smile "Und nur weil du ein bisschen anders bist, macht dich das nicht zu einem Monster."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:257
translate de qst_NewMyu_4_findMyuChurch_menu_bb741f1e:

    # MYU "..."
    MYU "..."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:262
translate de qst_NewMyu_4_findMyuChurch_menu_51e28bb2:

    # "Myu leapt forward to hug me."
    "Myu sprang vor, um mich zu umarmen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:263
translate de qst_NewMyu_4_findMyuChurch_menu_6dca0e04:

    # MC "Whoa, easy now!"
    MC "Whoa, immer mit der Ruhe!"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:264
translate de qst_NewMyu_4_findMyuChurch_menu_587718cb:

    # MYU "{i}*Sniff*{/i} Myu is ready to go home now."
    MYU "{i}*Schnief*{/i} Myu ist jetzt bereit, nach Hause zu gehen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:265
translate de qst_NewMyu_4_findMyuChurch_menu_75df1b81:

    # MC "Come then, Myu, let's get you home."
    MC "Komm, Myu, bringen wir dich nach Hause."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:267
translate de qst_NewMyu_4_findMyuChurch_menu_397c7208:

    # KYLISA @ talk "I take it all is resolved?"
    KYLISA @ talk "Ich nehme an, alles ist geklärt?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:272
translate de qst_NewMyu_4_findMyuChurch_menu_d07dee5f:

    # MC @ smile "I think so."
    MC @ smile "Das denke ich."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:273
translate de qst_NewMyu_4_findMyuChurch_menu_1918d395:

    # KYLISA @ smile "Good."
    KYLISA @ smile "Gut."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:274
translate de qst_NewMyu_4_findMyuChurch_menu_1ae85692:

    # MC @ talk "Thank you for helping her."
    MC @ talk "Danke, dass du ihr geholfen hast."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:275
translate de qst_NewMyu_4_findMyuChurch_menu_5c7b44a3:

    # MC @ talk "I know many wouldn't."
    MC @ talk "Ich weiß, viele würden das nicht tun."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:276
translate de qst_NewMyu_4_findMyuChurch_menu_15eff0cd:

    # KYLISA @ talk "I am sure one day in the future, you may return this act of kindness."
    KYLISA @ talk "Ich bin mir sicher, dass du eines Tages in der Zukunft diese freundliche Geste erwidern könntest."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:277
translate de qst_NewMyu_4_findMyuChurch_menu_1fd3c380:

    # KYLISA @ talk "...Tell me something though."
    KYLISA @ talk "...Aber erzähl mir etwas."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:278
translate de qst_NewMyu_4_findMyuChurch_menu_d669e126:

    # KYLISA @ talk "Why are {i}you{/i} helping this slimelark?"
    KYLISA @ talk "Warum hilfst {i}du{/i} diesem Schleimlerch?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:281
translate de qst_NewMyu_4_findMyuChurch_menu_6824b63e:

    # KYLISA @ talk "...Very well, as good an answer as any I suppose."
    KYLISA @ talk "...Nun gut, eine so gute Antwort wie jede andere, vermute ich."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:283
translate de qst_NewMyu_4_findMyuChurch_menu_54991cbc:

    # KYLISA @ talk "...I see."
    KYLISA @ talk "...Ich verstehe."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:284
translate de qst_NewMyu_4_findMyuChurch_menu_f9a7a2d5:

    # KYLISA @ talk "Well I hope you and your companion chose wisely in this war and the wars to come."
    KYLISA @ talk "Nun, ich hoffe, du und dein Gefährte habt in diesem Krieg und den kommenden Kriegen weise gewählt."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:286
translate de qst_NewMyu_4_findMyuChurch_menu_f0530664:

    # "...The phrase jumped out of me in a tone so... {i}alien{/i}."
    "...Der Satz kam in einem Ton aus mir heraus, der so... {i}fremdartig{/i} war."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:287
translate de qst_NewMyu_4_findMyuChurch_menu_277775a1:

    # KYLISA @ blush "I... Right, well, as long as {i}she's{/i} happy with that as well I suppose."
    KYLISA @ blush "Ich... Richtig, nun, solange {i}sie{/i} damit auch glücklich ist, vermute ich."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:288
translate de qst_NewMyu_4_findMyuChurch_menu_d87ee605:

    # KYLISA @ talk "Perhaps you might want to consider leaving Novaras if that's your long term-plan with her."
    KYLISA @ talk "Vielleicht möchtest du in Erwägung ziehen, Novaras zu verlassen, wenn das dein langfristiger Plan mit ihr ist."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:289
translate de qst_NewMyu_4_findMyuChurch_menu_3f3c80c2:

    # KYLISA @ talk "The inquisition have punished many... With child or not."
    KYLISA @ talk "Die Inquisition hat viele bestraft... Ob mit Kind oder nicht."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:290
translate de qst_NewMyu_4_findMyuChurch_menu_843d3cc8:

    # KYLISA @ talk "Anyway, you two should leave now, before someone else comes inquiring."
    KYLISA @ talk "Wie auch immer, ihr beide solltet jetzt gehen, bevor jemand anderes kommt und nachfragt."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:291
translate de qst_NewMyu_4_findMyuChurch_menu_6fd3619a:

    # MC @ talk "Thank you, Kylisa."
    MC @ talk "Danke, Kylisa."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:293
translate de qst_NewMyu_4_findMyuChurch_menu_e2cf7747:

    # "After that, the two of us slipped away back home safely."
    "Danach sind wir beide sicher nach Hause geschlichen."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:301
translate de qst_NewMyu_4_findMyuChurch_menu_a00b8bf6:

    # MYU @ talk "Myu tired, can... can we talk more soon?"
    MYU @ talk "Myu müde, können... können wir bald mehr reden?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:302
translate de qst_NewMyu_4_findMyuChurch_menu_b7078ada:

    # MC @ talk "Of course, Myu."
    MC @ talk "Natürlich, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:306
translate de qst_NewMyu_4_findMyuChurch_menu_7d6bdbfd:

    # "Before she dissolved, Myu turned to face me once more."
    "Bevor sie sich auflöste, drehte sich Myu noch einmal zu mir um."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:307
translate de qst_NewMyu_4_findMyuChurch_menu_e0576a98:

    # MYU @ talk "Do... [player_name!t] not want to be Myu husband?"
    MYU @ talk "Will... [player_name!t] nicht Myus Ehemann sein?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:308
translate de qst_NewMyu_4_findMyuChurch_menu_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "Was?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:309
translate de qst_NewMyu_4_findMyuChurch_menu_6d33c1a7:

    # MYU @ sad "Myu... Understand now, things not as she thought."
    MYU @ sad "Myu... Verstehe jetzt, die Dinge sind nicht so, wie sie dachte."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:310
translate de qst_NewMyu_4_findMyuChurch_menu_fa435c59:

    # MYU @ sad "Even though Myu wants [player_name!t], not fair to force someone to love who doesn't love back."
    MYU @ sad "Auch wenn Myu [player_name!t] will, es ist nicht fair, jemanden zu zwingen, jemanden zu lieben, der nicht zurückliebt."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:311
translate de qst_NewMyu_4_findMyuChurch_menu_8bcea43e:

    # MYU @ sad "So, what does [player_name!t] want?"
    MYU @ sad "Also, was will [player_name!t]?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:317
translate de qst_NewMyu_4_findMyuChurch_menu_9fdc3e39:

    # MYU @ sad "Myu... Myu understand."
    MYU @ sad "Myu... Myu versteht."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:318
translate de qst_NewMyu_4_findMyuChurch_menu_31ceb390:

    # MYU @ sad "Myu is sorry for trying to force what cannot be."
    MYU @ sad "Myu tut es leid, dass sie versucht hat zu erzwingen, was nicht sein kann."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:319
translate de qst_NewMyu_4_findMyuChurch_menu_c2a891a5:

    # MC @ talk "I will still keep you safe and look after you Myu, I promise."
    MC @ talk "Ich werde dich trotzdem beschützen und auf dich aufpassen, Myu, ich verspreche es."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:320
translate de qst_NewMyu_4_findMyuChurch_menu_a1015a7d:

    # MC @ talk "I just can't be what you {i}want{/i} me to be."
    MC @ talk "Ich kann einfach nicht sein, was du {i}willst{/i}, dass ich bin."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:321
translate de qst_NewMyu_4_findMyuChurch_menu_2a791db4:

    # MYU @ sad "...Very well, Myu will help when she can."
    MYU @ sad "...Na gut, Myu wird helfen, wenn sie kann."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:322
translate de qst_NewMyu_4_findMyuChurch_menu_59807ae7:

    # MYU @ smile "And maybe, along the way, Myu will find someone who {i}does{/i} want her that way."
    MYU @ smile "Und vielleicht wird Myu unterwegs jemanden finden, der sie {i}wirklich{/i} so will."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:323
translate de qst_NewMyu_4_findMyuChurch_menu_e2d535af:

    # MC @ talk "Maybe Myu, maybe."
    MC @ talk "Vielleicht Myu, vielleicht."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:324
translate de qst_NewMyu_4_findMyuChurch_menu_4c680e03:

    # MC "(I hope I have made the right choice with this.)"
    MC "(Ich hoffe, ich habe damit die richtige Wahl getroffen.)"

translate de strings:

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:14
    old "I'd be eternally grateful if you could sell me that wine a little cheaper."
    new "Ich wäre Ihnen ewig dankbar, wenn Sie mir diesen Wein etwas günstiger verkaufen könnten."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:29
    old "I'll be back."
    new "Ich komme wieder."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:174
    old "Step away from the Church"
    new "Entfernen Sie sich von der Kirche"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:204
    old "Why did you help Myu?"
    new "Warum hast du Myu geholfen?"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:210
    old "May I enter to see her?"
    new "Darf ich eintreten, um sie zu sehen?"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:280
    old "I guess because it's the right thing to do?"
    new "Ich nehme an, weil es das Richtige ist?"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:282
    old "She is my companion."
    new "Sie ist meine Begleiterin."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:285
    old "{i}I intend to breed her well, she shall sire me great warriors.{/i}"
    new "{i}Ich habe vor, sie gut zu züchten, sie soll mir große Krieger gebären.{/i}"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:313
    old "{image=[ICON.HEART]} You're mine, Myu."
    new "{image=[ICON.HEART]} Du gehörst mir, Myu."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:316
    old "{image=[ICON.HEART_CROSS]} Myu, I think it's best we just stay friends."
    new "{image=[ICON.HEART_CROSS]} Myu, ich denke, es ist am besten, wenn wir nur Freunde bleiben."

