# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:175
translate de qst_NewMyu_4_findMyuChurch_50928813:

    # MC "(I should check on this place later.)"
    MC "(Ich sollte später mal hier nachsehen.)"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:180
translate de qst_NewMyu_4_findMyuChurch_1f04c9e2:

