# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:2
translate de divine_ves_med_4d14a89f:

    # DIVINE "Oh? What kind of medicine do you seek, child?"
    DIVINE "Oh? Welche Art von Medizin suchst du, Kind?"

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:3
translate de divine_ves_med_090fe2ee:

    # MC "The general kind, anything to treat wounds or afflictions common to the Valley of Death."
    MC "Die allgemeine Art, alles, was Wunden oder Leiden behandelt, die im Tal des Todes üblich sind."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:4
translate de divine_ves_med_d9603056:

    # DIVINE "The Valley of Death, you say? "
    DIVINE "Das Tal des Todes, sagst du?"

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:5
translate de divine_ves_med_7d36b20d:

    # MC "I do a lot of travelling through there... Some emergency supplies would be of great use."
    MC "Ich reise viel dort durch... Ein paar Notfallvorräte wären sehr nützlich."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:6
translate de divine_ves_med_535ff0b0:

    # "Sister Divine pondered the thought for a moment."
    "Schwester Divine dachte einen Moment über den Gedanken nach."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:7
translate de divine_ves_med_5f9214e2:

    # DIVINE "Hmm, yes..."
    DIVINE "Hmm, ja..."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:8
translate de divine_ves_med_048319e1:

    # DIVINE "I could cobble together a list of some of the essentials for you."
    DIVINE "Ich könnte eine Liste mit ein paar der wichtigsten Dinge für dich zusammenstellen."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:10
translate de divine_ves_med_92bcfc49:

    # DIVINE "But it won’t be for free."
    DIVINE "Aber nicht umsonst."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:11
translate de divine_ves_med_9629aa17:

    # DIVINE "A hundred coins."
    DIVINE "Hundert Münzen."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:21
translate de divine_ves_med_menu_6e018644:

    # "Sister Divine blushed for a moment, whatever thought passing through her head as she bit at her lower lip. "
    "Schwester Divine errötete einen Moment, während ihr ein Gedanke durch den Kopf ging und sie sich auf die Unterlippe biss."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:22
translate de divine_ves_med_menu_583f5d72:

    # DIVINE "Well... Our goddess is a magnanimous one after all..."
    DIVINE "Nun... Unsere Göttin ist schließlich eine Großmütige..."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:23
translate de divine_ves_med_menu_3aa86164:

    # DIVINE "Perhaps this one time I could mercifully offer a discount."
    DIVINE "Vielleicht könnte ich dieses eine Mal gnädig einen Rabatt gewähren."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:24
translate de divine_ves_med_menu_cb6c0b9f:

    # MC "You’re too kind..."
    MC "Du bist zu gütig..."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:27
translate de divine_ves_med_menu_dd0c5335:

    # DIVINE "I’ll be waiting should you change your mind."
    DIVINE "Ich werde warten, solltest du deine Meinung ändern."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:32
translate de divine_ves_med_get_d4222246:

    # DIVINE "One moment, please..."
    DIVINE "Einen Moment, bitte..."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:36
translate de divine_ves_med_get_328d8dee:

    # "Sister Divine left for a short while, returning with basket in hand filled with assorted medicines in various bottles."
    "Schwester Divine entfernte sich für eine kurze Weile und kehrte mit einem Korb voller verschiedener Medikamente in unterschiedlichen Flaschen zurück."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:40
translate de divine_ves_med_get_8f57f3ae:

    # DIVINE "My apologies for keeping you waiting..."
    DIVINE "Es tut mir leid, dass ich dich habe warten lassen..."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:42
translate de divine_ves_med_get_669131ce:

    # DIVINE "Here you go... This should cover everything you need out there, or at least, the most common ailments that plague those who frequent the barren lands."
    DIVINE "Hier, bitte... Das sollte alles Nötige für draußen abdecken, oder zumindest die häufigsten Leiden, die diejenigen plagen, die das karge Land durchstreifen."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:43
translate de divine_ves_med_get_df15a2dd:

    # DIVINE "Come back if you need to restock."
    DIVINE "Komm zurück, falls du Vorräte auffüllen musst."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:44
translate de divine_ves_med_get_c61a4d8f:

    # MC @ talk "Thanks."
    MC @ talk "Danke."

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:45
translate de divine_ves_med_get_c97a0b9a:

    # MC "(Now, to Ves' camp)"
    MC "(Nun zu Ves' Lager)"

# game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:51
translate de divine_ves_med_revisit_3ac60644:

    # DIVINE "Ah, a hundred coins and it's yours, child."
    DIVINE "Ah, hundert Münzen und es gehört dir, Kind."

translate de strings:

    # game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:13
    old "There you go."
    new "Hier, bitte."

    # game/data/world_quests/side/valleyOfDeath/GreenFever/scr_DivineMeds.rpy:19
    old "Is there no way I can get it at a more generous rate?"
    new "Gibt es denn keine Möglichkeit, es zu einem großzügigeren Preis zu bekommen?"

