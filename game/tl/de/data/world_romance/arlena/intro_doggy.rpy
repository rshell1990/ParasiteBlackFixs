# game/data/world_romance/arlena/intro_doggy.rpy:2
translate de rom_ArlenaIntroDoggy_f6e99e92:

    # "The door opened inch by inch as Arlena’s face peeped surreptitiously through the gap."
    "Die Tür öffnete sich Zentimeter für Zentimeter, während Arlenas Gesicht verstohlen durch den Spalt lugte."

# game/data/world_romance/arlena/intro_doggy.rpy:3
translate de rom_ArlenaIntroDoggy_47123286:

    # "She averted her gaze as the air touched her rosy cheeks."
    "Sie wandte den Blick ab, als die Luft ihre rosigen Wangen berührte."

# game/data/world_romance/arlena/intro_doggy.rpy:4
translate de rom_ArlenaIntroDoggy_c41453c7:

    # MC @ talk "Arlena? Is everything alright?"
    MC @ talk "Arlena? Ist alles in Ordnung?"

# game/data/world_romance/arlena/intro_doggy.rpy:5
translate de rom_ArlenaIntroDoggy_250c2268:

    # ARLENA "Yes, just give me a moment..."
    ARLENA "Ja, gib mir nur einen Moment..."

# game/data/world_romance/arlena/intro_doggy.rpy:10
translate de rom_ArlenaIntroDoggy_2b255700:

    # "She sealed the door shut for a moment before opening it fully to allow me to inspect what was on the other side."
    "Sie schloss die Tür für einen Moment ganz, bevor sie sie vollständig öffnete, damit ich sehen konnte, was auf der anderen Seite war."

# game/data/world_romance/arlena/intro_doggy.rpy:11
translate de rom_ArlenaIntroDoggy_f160d8e1:

    # "Arlena smiled, wrapped in a warm furry blanket that hung off her bare shoulders."
    "Arlena lächelte, eingehüllt in eine warme, flauschige Decke, die von ihren nackten Schultern hing."

# game/data/world_romance/arlena/intro_doggy.rpy:12
translate de rom_ArlenaIntroDoggy_17cf5076:

    # "I had to tear my eyes away from the cute little mole on her collar bone, wanting nothing more than to reach out and touch her."
    "Ich musste meinen Blick von dem süßen kleinen Leberfleck auf ihrem Schlüsselbein losreißen und wollte nichts mehr, als nach ihr zu greifen und sie zu berühren."

# game/data/world_romance/arlena/intro_doggy.rpy:13
translate de rom_ArlenaIntroDoggy_dfb9c9c2:

    # "She had placed various candles around the room, illuminating it with a warm, soft kind of light."
    "Sie hatte verschiedene Kerzen im Raum verteilt, die ihn mit einem warmen, sanften Licht erhellten."

# game/data/world_romance/arlena/intro_doggy.rpy:14
translate de rom_ArlenaIntroDoggy_8a2997f2:

    # "Placed on the floor was a small white blanket, keenly laid out with a few pieces of food she had managed to pull together in a wooden bowl."
    "Auf dem Boden lag eine kleine weiße Decke, sorgfältig ausgebreitet mit ein paar Essensstücken, die sie in einer Holzschüssel zusammengesucht hatte."

# game/data/world_romance/arlena/intro_doggy.rpy:15
translate de rom_ArlenaIntroDoggy_0f98a9a9:

    # "Sat beside it was a half empty bottle of wine with two glasses already poured out waiting for us."
    "Daneben stand eine halbleere Flasche Wein, mit zwei bereits eingeschenkten Gläsern, die auf uns warteten."

# game/data/world_romance/arlena/intro_doggy.rpy:16
translate de rom_ArlenaIntroDoggy_360d119a:

    # ARLENA "It isn’t much but..."
    ARLENA "Es ist nicht viel, aber..."

# game/data/world_romance/arlena/intro_doggy.rpy:17
translate de rom_ArlenaIntroDoggy_2aa2b523:

    # ARLENA "It’s all I could cobble together."
    ARLENA "Es ist alles, was ich zusammenbasteln konnte."

# game/data/world_romance/arlena/intro_doggy.rpy:20
translate de rom_ArlenaIntroDoggy_60ace262:

    # ARLENA "And ruin the surprise? Please."
    ARLENA "Und die Überraschung verderben? Bitte."

# game/data/world_romance/arlena/intro_doggy.rpy:21
translate de rom_ArlenaIntroDoggy_e3382014:

    # ARLENA "You’re a guest, I didn’t want to trouble you with petty tasks after everything you’ve done for me already."
    ARLENA "Du bist ein Gast, ich wollte dich nach allem, was du schon für mich getan hast, nicht mit Kleinigkeiten belästigen."

# game/data/world_romance/arlena/intro_doggy.rpy:22
translate de rom_ArlenaIntroDoggy_bf065817:

    # MC @ talk "Look at you being nice."
    MC @ talk "Schau mal, du bist nett."

# game/data/world_romance/arlena/intro_doggy.rpy:24
translate de rom_ArlenaIntroDoggy_5638156f:

    # ARLENA "Glad you think so."
    ARLENA "Freut mich, dass du das denkst."

# game/data/world_romance/arlena/intro_doggy.rpy:26
translate de rom_ArlenaIntroDoggy_9d365dc3:

    # ARLENA "It’s... It’s cold is all!"
    ARLENA "Es ist... Es ist nur kalt!"

# game/data/world_romance/arlena/intro_doggy.rpy:27
translate de rom_ArlenaIntroDoggy_96c1e2d5:

    # ARLENA "Come on, let’s dig in..."
    ARLENA "Komm schon, lass uns reinhauen..."

# game/data/world_romance/arlena/intro_doggy.rpy:29
translate de rom_ArlenaIntroDoggy_97590d4b:

    # "We split the food in the bowl between us and laughed over old stories as we made our way through the wine."
    "Wir teilten das Essen in der Schüssel unter uns auf und lachten über alte Geschichten, während wir den Wein genossen."

# game/data/world_romance/arlena/intro_doggy.rpy:30
translate de rom_ArlenaIntroDoggy_6364ebb4:

    # ARLENA "Hahaha! Do you remember Viktor’s ‘Great Potato Scam’?"
    ARLENA "Hahaha! Erinnerst du dich an Viktors 'Großen Kartoffelschwindel'?"

# game/data/world_romance/arlena/intro_doggy.rpy:31
translate de rom_ArlenaIntroDoggy_b6285f18:

    # MC @ talk "Oh yes, he swore hands down he had figured out a way to grow them himself faster than all the farmers could combined."
    MC @ talk "Oh ja, er schwor hoch und heilig, dass er einen Weg gefunden hatte, sie selbst schneller anzubauen, als alle Bauern zusammen."

# game/data/world_romance/arlena/intro_doggy.rpy:32
translate de rom_ArlenaIntroDoggy_5521c0f9:

    # MC @ talk "He was offering huge sacks of potatoes for practically nothing."
    MC @ talk "Er bot riesige Säcke Kartoffeln für fast nichts an."

# game/data/world_romance/arlena/intro_doggy.rpy:37
translate de rom_ArlenaIntroDoggy_b285fc8e:

    # "Between snorts of laughter, Arlena struggled to hold down her mouthful of wine as she reminisced."
    "Zwischen lachenden Schnauben kämpfte Arlena darum, ihren Mund voll Wein hinunterzuhalten, während sie sich erinnerte."

# game/data/world_romance/arlena/intro_doggy.rpy:38
translate de rom_ArlenaIntroDoggy_1342b385:

    # ARLENA @ smile "The little shit only had the top layer be actual potatoes, beneath all that he’d just painted a load of rocks! "
    ARLENA @ smile "Der kleine Scheißer hatte nur die oberste Schicht mit echten Kartoffeln, darunter hatte er einfach einen Haufen Steine angemalt!"

# game/data/world_romance/arlena/intro_doggy.rpy:39
translate de rom_ArlenaIntroDoggy_663dcfdf:

    # ARLENA @ smile "I still remember the mob chasing him now!"
    ARLENA @ smile "Ich erinnere mich immer noch daran, wie der Mob ihn jagte!"

# game/data/world_romance/arlena/intro_doggy.rpy:40
translate de rom_ArlenaIntroDoggy_a613ced5:

    # MC @ talk "He swore blind they were just funny shaped, hard, ‘exotic’ potatoes!"
    MC @ talk "Er schwor Stein und Bein, es seien nur lustig geformte, harte, 'exotische' Kartoffeln!"

# game/data/world_romance/arlena/intro_doggy.rpy:41
translate de rom_ArlenaIntroDoggy_d757d49d:

    # ARLENA "Didn’t someone break his nose for that?"
    ARLENA "Hat ihm dafür nicht jemand die Nase gebrochen?"

# game/data/world_romance/arlena/intro_doggy.rpy:42
translate de rom_ArlenaIntroDoggy_51202ee1:

    # MC @ talk "Yes! When he caught up to him, he said something like ‘here’s something ‘exotic’ for you to try, boy!’ "
    MC @ talk "Ja! Als er ihn einholte, sagte er so etwas wie: 'Hier hast du was 'Exotisches' zum Probieren, Junge!'"

# game/data/world_romance/arlena/intro_doggy.rpy:43
translate de rom_ArlenaIntroDoggy_7366dea8:

    # "Arlena laughed once again as we remembered Viktor being dropped by the old farmer’s punch."
    "Arlena lachte wieder einmal, als wir uns daran erinnerten, wie Viktor von dem Faustschlag des alten Bauern zu Boden gestreckt wurde."

# game/data/world_romance/arlena/intro_doggy.rpy:44
translate de rom_ArlenaIntroDoggy_b3a9f82c:

    # ARLENA "As much of an ass he was, he was quite cute."
    ARLENA "So ein Arschloch er auch war, er war ziemlich süß."

# game/data/world_romance/arlena/intro_doggy.rpy:45
translate de rom_ArlenaIntroDoggy_f8f38e67:

    # MC @ talk "Who? The old farmer?"
    MC @ talk "Wer? Der alte Bauer?"

# game/data/world_romance/arlena/intro_doggy.rpy:46
translate de rom_ArlenaIntroDoggy_bb71a8bc:

    # ARLENA "Noooo, Viktor of course!"
    ARLENA "Neeiin, natürlich Viktor!"

# game/data/world_romance/arlena/intro_doggy.rpy:47
translate de rom_ArlenaIntroDoggy_bf6f3526:

    # ARLENA "{i}Dumbass.{/i}"
    ARLENA "{i}Idiot.{/i}"

# game/data/world_romance/arlena/intro_doggy.rpy:48
translate de rom_ArlenaIntroDoggy_68d1fd89:

    # MC @ talk "Oh no..."
    MC @ talk "Oh nein..."

# game/data/world_romance/arlena/intro_doggy.rpy:49
translate de rom_ArlenaIntroDoggy_722badb0:

    # ARLENA "He was! He had this little button nose!"
    ARLENA "War er! Er hatte diese kleine Stupsnase!"

# game/data/world_romance/arlena/intro_doggy.rpy:50
translate de rom_ArlenaIntroDoggy_4931e836:

    # MC @ talk "His voice sounded like a cat drowning."
    MC @ talk "Seine Stimme klang wie eine ertrinkende Katze."

# game/data/world_romance/arlena/intro_doggy.rpy:51
translate de rom_ArlenaIntroDoggy_f2f0745d:

    # ARLENA "Well, I liked him."
    ARLENA "Nun, ich mochte ihn."

# game/data/world_romance/arlena/intro_doggy.rpy:52
translate de rom_ArlenaIntroDoggy_98ae856a:

    # MC @ talk "... You liked Viktor?"
    MC @ talk "... Du mochtest Viktor?"

# game/data/world_romance/arlena/intro_doggy.rpy:53
translate de rom_ArlenaIntroDoggy_7b6bb866:

    # ARLENA "We went out once..."
    ARLENA "Wir sind einmal ausgegangen..."

# game/data/world_romance/arlena/intro_doggy.rpy:54
translate de rom_ArlenaIntroDoggy_5e90ebf6:

    # MC @ talk "Oh? Just the once?"
    MC @ talk "Oh? Nur das eine Mal?"

# game/data/world_romance/arlena/intro_doggy.rpy:55
translate de rom_ArlenaIntroDoggy_ba8c73f7:

    # ARLENA "Yeah, but nothing happened or anything like that."
    ARLENA "Ja, aber es ist nichts passiert oder so."

# game/data/world_romance/arlena/intro_doggy.rpy:56
translate de rom_ArlenaIntroDoggy_44044d4c:

    # ARLENA "Just didn’t feel right."
    ARLENA "Es fühlte sich einfach nicht richtig an."

# game/data/world_romance/arlena/intro_doggy.rpy:57
translate de rom_ArlenaIntroDoggy_159bf8b3:

    # MC @ talk "How come?"
    MC @ talk "Wieso?"

# game/data/world_romance/arlena/intro_doggy.rpy:58
translate de rom_ArlenaIntroDoggy_5180d965:

    # "Arlena paused for a moment, choosing her words with care as she took a sip of her wine."
    "Arlena hielt einen Moment inne und wählte ihre Worte mit Bedacht, während sie einen Schluck Wein nahm."

# game/data/world_romance/arlena/intro_doggy.rpy:59
translate de rom_ArlenaIntroDoggy_6d1923e8:

    # ARLENA "Well..."
    ARLENA "Nun ja..."

# game/data/world_romance/arlena/intro_doggy.rpy:60
translate de rom_ArlenaIntroDoggy_304e9042:

    # ARLENA "I had someone else on my mind at the time, so..."
    ARLENA "Ich hatte damals jemand anderen im Kopf, also..."

# game/data/world_romance/arlena/intro_doggy.rpy:61
translate de rom_ArlenaIntroDoggy_d674520f:

    # "As Arlena shyly looked away, it dawned on me exactly {i}who{/i} had been on her mind."
    "Als Arlena schüchtern wegsah, dämmerte mir genau, {i}wer{/i} ihr im Kopf gewesen war."

# game/data/world_romance/arlena/intro_doggy.rpy:62
translate de rom_ArlenaIntroDoggy_186fc647:

    # MC @ talk "... Ah."
    MC @ talk "... Ah."

# game/data/world_romance/arlena/intro_doggy.rpy:63
translate de rom_ArlenaIntroDoggy_8a61850d:

    # ARLENA "It’s fine, it was a long time ago, my standards were extremely low."
    ARLENA "Es ist okay, das ist lange her, meine Ansprüche waren extrem niedrig."

# game/data/world_romance/arlena/intro_doggy.rpy:64
translate de rom_ArlenaIntroDoggy_20af471b:

    # ARLENA "... And you were an ass."
    ARLENA "... Und du warst ein Arschloch."

# game/data/world_romance/arlena/intro_doggy.rpy:65
translate de rom_ArlenaIntroDoggy_22ff4802:

    # MC @ talk "... But I’m likable now, huh?"
    MC @ talk "... Aber jetzt bin ich sympathisch, was?"

# game/data/world_romance/arlena/intro_doggy.rpy:66
translate de rom_ArlenaIntroDoggy_90004009:

    # "Arlena smiled alluringly before once again reaching to grab her wine."
    "Arlena lächelte verführerisch, bevor sie erneut nach ihrem Wein griff."

# game/data/world_romance/arlena/intro_doggy.rpy:67
translate de rom_ArlenaIntroDoggy_a1831a05:

    # ARLENA "Yes..."
    ARLENA "Ja..."

# game/data/world_romance/arlena/intro_doggy.rpy:68
translate de rom_ArlenaIntroDoggy_1627ab5c:

    # ARLENA "You are {i}tolerable{/i}."
    ARLENA "Du bist {i}erträglich{/i}."

# game/data/world_romance/arlena/intro_doggy.rpy:69
translate de rom_ArlenaIntroDoggy_64ecede6:

    # MC @ talk "As are you, m’lady."
    MC @ talk "Du ebenfalls, Milady."

# game/data/world_romance/arlena/intro_doggy.rpy:70
translate de rom_ArlenaIntroDoggy_8983e408:

    # "I raised my drink."
    "Ich hob mein Glas."

# game/data/world_romance/arlena/intro_doggy.rpy:71
translate de rom_ArlenaIntroDoggy_fb88f9c8:

    # MC @ talk "Here’s to being tolerable."
    MC @ talk "Auf das Erträglichsein."

# game/data/world_romance/arlena/intro_doggy.rpy:72
translate de rom_ArlenaIntroDoggy_d25deed9:

    # "Arlena playfully clinked her drink against mine, but after swigging the last of it down and reaching over for the bottle to refill it, she realised it was empty."
    "Arlena stieß spielerisch mit ihrem Glas gegen meins, aber nachdem sie den letzten Schluck hinuntergekippt und nach der Flasche gegriffen hatte, um nachzuschenken, bemerkte sie, dass sie leer war."

# game/data/world_romance/arlena/intro_doggy.rpy:73
translate de rom_ArlenaIntroDoggy_4ec86ff2:

    # ARLENA "Oh! We’re out of wine..."
    ARLENA "Oh! Wir haben keinen Wein mehr..."

# game/data/world_romance/arlena/intro_doggy.rpy:74
translate de rom_ArlenaIntroDoggy_c5bed80f:

    # ARLENA "Heh... Time flies, huh? "
    ARLENA "Heh... Wie die Zeit vergeht, was?"

# game/data/world_romance/arlena/intro_doggy.rpy:80
translate de rom_ArlenaIntroDoggy_adc08c4b:

    # "Changing the subject, we spent the rest of the... date contentedly chatting about other things till finally, she waved me off into the cool night air to make my way home."
    "Das Thema wechselnd, verbrachten wir den Rest des... Dates zufrieden damit, über andere Dinge zu plaudern, bis sie mich schließlich in die kühle Nachtluft hinauswinkte, um mich auf den Heimweg zu machen."

# game/data/world_romance/arlena/intro_doggy.rpy:81
translate de rom_ArlenaIntroDoggy_b39cecf2:

    # "I couldn’t help but notice, despite the pleasantness of the evening, there was {i}a tinge of disappointment{/i} in her voice as I made my move to leave."
    "Ich konnte nicht anders, als zu bemerken, dass trotz der angenehmen Atmosphäre des Abends {i}ein Hauch von Enttäuschung{/i} in ihrer Stimme lag, als ich Anstalten machte zu gehen."

# game/data/world_romance/arlena/intro_doggy.rpy:86
translate de rom_ArlenaIntroDoggy_dfe1d604:

    # ARLENA "Thanks for a good time, turns out you CAN be a gentleman when you put your mind to it."
    ARLENA "Danke für die schöne Zeit, es stellt sich heraus, dass du ein Gentleman sein KANNST, wenn du es wirklich willst."

# game/data/world_romance/arlena/intro_doggy.rpy:87
translate de rom_ArlenaIntroDoggy_afd647ee:

    # MC @ talk "Yeah, thank you too!"
    MC @ talk "Ja, danke dir auch!"

# game/data/world_romance/arlena/intro_doggy.rpy:88
translate de rom_ArlenaIntroDoggy_a51aef82:

    # MC @ talk "I'll be going now."
    MC @ talk "Ich werde jetzt gehen."

# game/data/world_romance/arlena/intro_doggy.rpy:89
translate de rom_ArlenaIntroDoggy_cee7a7a3:

    # MC @ talk "Take care, Arlena."
    MC @ talk "Pass auf dich auf, Arlena."

# game/data/world_romance/arlena/intro_doggy.rpy:90
translate de rom_ArlenaIntroDoggy_d633fcc7:

    # "With a heavy heart, I left the smithy."
    "Mit schwerem Herzen verließ ich die Schmiede."

# game/data/world_romance/arlena/intro_doggy.rpy:96
translate de rom_ArlenaIntroDoggy_0bd83054:

    # ARLENA "W-What do you mean?"
    ARLENA "W-Was meinst du?"

# game/data/world_romance/arlena/intro_doggy.rpy:97
translate de rom_ArlenaIntroDoggy_9d168846:

    # MC @ talk "... Well."
    MC @ talk "... Nun."

# game/data/world_romance/arlena/intro_doggy.rpy:98
translate de rom_ArlenaIntroDoggy_173d1d2a:

    # MC @ talk "It’s just, tell me if I’m reading this wrong but..."
    MC @ talk "Es ist nur, sag mir, ob ich das falsch verstehe, aber..."

# game/data/world_romance/arlena/intro_doggy.rpy:99
translate de rom_ArlenaIntroDoggy_27744584:

    # MC @ talk "You didn’t just invite me here tonight to reminisce about our time at school, did you?"
    MC @ talk "Du hast mich heute Abend nicht nur eingeladen, um über unsere Schulzeit zu schwelgen, oder?"

# game/data/world_romance/arlena/intro_doggy.rpy:100
translate de rom_ArlenaIntroDoggy_640ae29c:

    # "Arlena said nothing, her mouth hung slightly open as she stared wide eyed at me in waiting."
    "Arlena sagte nichts, ihr Mund hing leicht geöffnet, während sie mich mit großen Augen erwartungsvoll anstarrte."

# game/data/world_romance/arlena/intro_doggy.rpy:103
translate de rom_ArlenaIntroDoggy_f684eedb:

    # "I inched towards Arlena, never breaking eye contact before placing a tender kiss onto her lips."
    "Ich bewegte mich langsam auf Arlena zu, ohne den Augenkontakt zu unterbrechen, bevor ich einen zärtlichen Kuss auf ihre Lippen drückte."

# game/data/world_romance/arlena/intro_doggy.rpy:104
translate de rom_ArlenaIntroDoggy_641115a0:

    # "For just a moment, Arlena hesitated, her breath hot and heavy on my face, before she sunk into the kiss and slipped her soft tongue into my mouth."
    "Für einen kurzen Moment zögerte Arlena, ihr Atem heiß und schwer auf meinem Gesicht, bevor sie sich dem Kuss hingab und ihre weiche Zunge in meinen Mund gleiten ließ."

# game/data/world_romance/arlena/intro_doggy.rpy:105
translate de rom_ArlenaIntroDoggy_baa8fc70:

    # ARLENA "... Fuck it."
    ARLENA "... Scheiß drauf."

# game/data/world_romance/arlena/intro_doggy.rpy:109
translate de rom_ArlenaIntroDoggy_edf29e6c:

    # "Dropping the fur blanket to the floor, Arlena revealed the see-through night gown she wore beneath."
    "Die Pelzdecke auf den Boden fallen lassend, enthüllte Arlena das durchsichtige Nachthemd, das sie darunter trug."

# game/data/world_romance/arlena/intro_doggy.rpy:110
translate de rom_ArlenaIntroDoggy_d114ebfb:

    # "It hung off her small frame, slipping over the curves of her body like silk."
    "Es hing von ihrem zierlichen Körper, glitt wie Seide über die Kurven ihres Körpers."

# game/data/world_romance/arlena/intro_doggy.rpy:111
translate de rom_ArlenaIntroDoggy_f4816b4f:

    # "She took my hand and lead me over to her bed with another passionate kiss."
    "Sie nahm meine Hand und führte mich mit einem weiteren leidenschaftlichen Kuss zu ihrem Bett."

# game/data/world_romance/arlena/intro_doggy.rpy:112
translate de rom_ArlenaIntroDoggy_ff443ffc:

    # ARLENA "Mmm..."
    ARLENA "Mmm..."

# game/data/world_romance/arlena/intro_doggy.rpy:113
translate de rom_ArlenaIntroDoggy_56b416ba:

    # ARLENA "I’ve wanted this for a long time."
    ARLENA "Ich wollte das schon lange."

# game/data/world_romance/arlena/intro_doggy.rpy:114
translate de rom_ArlenaIntroDoggy_72ca64ae:

    # MC @ talk "How do you—"
    MC @ talk "Wie willst du—"

# game/data/world_romance/arlena/intro_doggy.rpy:115
translate de rom_ArlenaIntroDoggy_2d300459:

    # ARLENA "Shut up and take me."
    ARLENA "Halt den Mund und nimm mich."

# game/data/world_romance/arlena/intro_doggy.rpy:116
translate de rom_ArlenaIntroDoggy_b38f62b2:

    # "She began stripping my clothes off with an animal like passion, ripping my shirt over my head and then tracing the lines of my muscles with her fingertips."
    "Sie begann, mir mit animalischer Leidenschaft die Kleider vom Leib zu reißen, riss mir das Hemd über den Kopf und fuhr dann mit den Fingerspitzen die Linien meiner Muskeln nach."

# game/data/world_romance/arlena/intro_doggy.rpy:117
translate de rom_ArlenaIntroDoggy_dcef3b16:

    # "As she took off my trousers, her eyes widened when she saw the size of my hardening member."
    "Als sie mir die Hose auszog, weiteten sich ihre Augen, als sie die Größe meines steif werdenden Gliedes sah."

# game/data/world_romance/arlena/intro_doggy.rpy:118
translate de rom_ArlenaIntroDoggy_e59c4837:

    # ARLENA "That’s... {i}big.{/i}"
    ARLENA "Das ist... {i}groß.{/i}"

# game/data/world_romance/arlena/intro_doggy.rpy:119
translate de rom_ArlenaIntroDoggy_7a30e52d:

    # MC @ talk "... Do you—"
    MC @ talk "... Glaubst du—"

