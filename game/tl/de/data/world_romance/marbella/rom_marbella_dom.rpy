    "Marbellas Kinnlade klappte fast auf den Tisch, als die Zwerge um sie herum jubelten."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1267
translate de rom_marbella_dom_meet_at_pale_dragon_cb07df8c:

    # DAKKAN "Fuck you, Gavkat! You said she'd try it with one of us!"
    DAKKAN "Fick dich, Gavkat! Du hast gesagt, sie würde es mit einem von uns versuchen!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1268
translate de rom_marbella_dom_meet_at_pale_dragon_12abb99b:

    # GAVKAT "You cheatin' bastard! The bet was just that she'd find someone to shag in the next three months!"
    GAVKAT "Du betrügerischer Bastard! Die Wette war nur, dass sie in den nächsten drei Monaten jemanden zum Vögeln findet!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1269
translate de rom_marbella_dom_meet_at_pale_dragon_ca8e8c30:

    # MARBELLA @ shock "WHAT?!"
    MARBELLA @ shock "WAS?!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1270
translate de rom_marbella_dom_meet_at_pale_dragon_ad6b1350:

    # MARBELLA @ shock "YOU'VE ALL BEEN BETTING ON MY LOVE LIFE?!"
    MARBELLA @ shock "IHR HABT ALLE AUF MEIN LIEBESLEBEN GEWETTET?!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1271
translate de rom_marbella_dom_meet_at_pale_dragon_e87fada4:

    # GAVKAT "Look, lass... We love what you do for us."
    GAVKAT "Schau, Mädel... Wir lieben, was du für uns tust."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1272
translate de rom_marbella_dom_meet_at_pale_dragon_9d754a23:

    # GAVKAT "But fuck me, have you been a headache these past few months, running us all ragged."
    GAVKAT "Aber verdammt, du warst in den letzten Monaten ein Kopfschmerz, du hast uns alle völlig fertig gemacht."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1273
translate de rom_marbella_dom_meet_at_pale_dragon_a6304db8:

    # MARBELLA @ angry "I've been workin' my arse off trying to keep this business afloat!"
    MARBELLA @ angry "Ich hab mir den Arsch abgerackert, um dieses Geschäft am Laufen zu halten!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1274
translate de rom_marbella_dom_meet_at_pale_dragon_5cb2d973:

    # GAVKAT "We know, lass, and we love you for it..."
    GAVKAT "Wir wissen es, Mädel, und wir lieben dich dafür..."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1275
translate de rom_marbella_dom_meet_at_pale_dragon_41d04131:

    # GAVKAT @ think "But by Daliman's pick, you've run yourself ragged."
    GAVKAT @ think "Aber bei Dalimans Picke, du hast dich selbst völlig fertig gemacht."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1276
translate de rom_marbella_dom_meet_at_pale_dragon_fc06c7c0:

    # DAKKAN "AND US!"
    DAKKAN "UND UNS!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1277
translate de rom_marbella_dom_meet_at_pale_dragon_c21431d1:

    # GAVKAT "We've all noticed since you've been getting some of your own, you've been a lot calmer, you know!"
    GAVKAT "Wir haben alle bemerkt, seit du selbst etwas bekommst, bist du viel ruhiger, weißt du!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1278
translate de rom_marbella_dom_meet_at_pale_dragon_69c4c609:

    # MARBELLA @ shock "Y-You knew already?"
    MARBELLA @ shock "D-Du wusstest es schon?"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1279
translate de rom_marbella_dom_meet_at_pale_dragon_aaf7eae7:

    # GAVKAT "Lass... These last couple days, it's like you've been floating around the office instead of the usual sad sack of shit we're used to."
    GAVKAT "Mädel... Die letzten paar Tage ist es, als würdest du durchs Büro schweben, anstatt des üblichen traurigen Haufens Scheiße, den wir gewohnt sind."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1280
translate de rom_marbella_dom_meet_at_pale_dragon_f7170700:

    # GAVKAT "We ain't fuckin' stupid, girl. We knew something had changed."
    GAVKAT "Wir sind doch nicht blöd, Mädchen. Wir wussten, dass sich was verändert hat."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1281
translate de rom_marbella_dom_meet_at_pale_dragon_c6b7661a:

    # MC "So, you're fine with us then?"
    MC "Also, du hast kein Problem mit uns?"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1282
translate de rom_marbella_dom_meet_at_pale_dragon_de4a87dd:

    # GAVKAT @ smile "Course we are!"
    GAVKAT @ smile "Klar sind wir das!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1283
translate de rom_marbella_dom_meet_at_pale_dragon_7d884615:

    # GAVKAT @ think "Why wouldn't we be?"
    GAVKAT @ think "Warum sollten wir nicht?"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1284
translate de rom_marbella_dom_meet_at_pale_dragon_91266b19:

    # MARBELLA @ emb "But I... I thought you guys wouldn't be able to respect me anymore if you knew I was..."
    MARBELLA @ emb "Aber ich... ich dachte, ihr würdet mich nicht mehr respektieren, wenn ihr wüsstet, dass ich..."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1285
translate de rom_marbella_dom_meet_at_pale_dragon_da3b757d:

    # MARBELLA @ emb "You know."
    MARBELLA @ emb "Du weißt schon."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1286
translate de rom_marbella_dom_meet_at_pale_dragon_c1c06e58:

    # GAVKAT @ smile "... You are aware me and the boys are blowing our wages monthly in those Katai brothels, right?"
    GAVKAT @ smile "... Du weißt schon, dass ich und die Jungs unser Gehalt monatlich in diesen Katai-Bordellen verjubeln, oder?"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1287
translate de rom_marbella_dom_meet_at_pale_dragon_fd7fa19d:

    # MARBELLA @ shock "WHAT?! NO!"
    MARBELLA @ shock "WAS?! NEIN!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1288
translate de rom_marbella_dom_meet_at_pale_dragon_6e5ae6c2:

    # MARBELLA @ angry "YOU WERE SUPPOSED TO FUCKING SAVE SOME FOR WHEN YOU RETURN TO IRYIAD!"
    MARBELLA @ angry "DU HÄTTEST VERDAMMT NOCH MAL ETWAS FÜR DEINE RÜCKKEHR NACH IRYIAD AUFHEBEN SOLLEN!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1289
translate de rom_marbella_dom_meet_at_pale_dragon_7fa88c49:

    # GAVKAT @ angry "...Bahhh!"
    GAVKAT @ angry "...Bahhh!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1290
translate de rom_marbella_dom_meet_at_pale_dragon_93814734:

    # GAVKAT @ smile "You'll figure it out, deduct a bit from our wages or something."
    GAVKAT @ smile "Du wirst das schon hinbekommen, zieh einfach ein bisschen was von unserem Lohn ab oder so."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1291
translate de rom_marbella_dom_meet_at_pale_dragon_be7342f4:

    # MARBELLA @ angry "Urghh!"
    MARBELLA @ angry "Urghh!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1292
translate de rom_marbella_dom_meet_at_pale_dragon_2d3d55ad:

    # "Marbella's head dropped onto the table in frustration as Gavkat nudged me."
    "Marbella ließ frustriert den Kopf auf den Tisch sinken, als Gavkat mich anstupste."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1293
translate de rom_marbella_dom_meet_at_pale_dragon_9be2bd46:

    # GAVKAT "Quick! Yer needed again!"
    GAVKAT "Schnell! Du wirst schon wieder gebraucht!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1294
translate de rom_marbella_dom_meet_at_pale_dragon_c56cb944:

    # "The dwarves roared with laughter, and the rest of the evening was spent in splendid drunkenness and banter."
    "Die Zwerge brüllten vor Lachen, und der restliche Abend verging in prächtiger Trunkenheit und Scherzerei."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1296
translate de rom_marbella_dom_meet_at_pale_dragon_addcc49c:

    # "Eventually, as the evening died down, Marbella and I were left alone."
    "Schließlich, als der Abend sich dem Ende zuneigte, waren Marbella und ich allein."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1298
translate de rom_marbella_dom_meet_at_pale_dragon_a34496fa:

    # MARBELLA @ emb "Gods, they're so bloody embarrassing..."
    MARBELLA @ emb "Götter, die sind so verdammt peinlich..."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1299
translate de rom_marbella_dom_meet_at_pale_dragon_8dc069cf:

    # MC @ smile "You should be happy."
    MC @ smile "Du solltest glücklich sein."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1300
translate de rom_marbella_dom_meet_at_pale_dragon_ebc6be8e:

    # MARBELLA @ shock "I am!"
    MARBELLA @ shock "Ich bin's!"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1301
translate de rom_marbella_dom_meet_at_pale_dragon_d0ab179a:

    # MARBELLA @ emb "It's just..."
    MARBELLA @ emb "Es ist nur..."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1302
translate de rom_marbella_dom_meet_at_pale_dragon_28227119:

    # MARBELLA @ emb "Umm, I'm still not great with all this stuff."
    MARBELLA @ emb "Ähm, ich bin mit all dem noch nicht so gut."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1303
translate de rom_marbella_dom_meet_at_pale_dragon_5e8bb0f7:

    # MC @ smile "That's why I'm here."
    MC @ smile "Deshalb bin ich hier."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1304
translate de rom_marbella_dom_meet_at_pale_dragon_92e54bb3:

    # "I gently lifted her chin to look at me."
    "Ich hob sanft ihr Kinn an, damit sie mich ansah."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1305
translate de rom_marbella_dom_meet_at_pale_dragon_14ac36d5:

    # MC @ smile "I'll take care of everything."
    MC @ smile "Ich kümmere mich um alles."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1306
translate de rom_marbella_dom_meet_at_pale_dragon_482b4f20:

    # MARBELLA @ emb "Y-Yes..."
    MARBELLA @ emb "J-Ja..."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1307
translate de rom_marbella_dom_meet_at_pale_dragon_836c1cdd:

    # MARBELLA @ emb "Just... come see me real soon, alright?"
    MARBELLA @ emb "Komm... besuch mich einfach ganz bald, okay?"

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1308
translate de rom_marbella_dom_meet_at_pale_dragon_0e758d77:

    # MC @ smile "Will do."
    MC @ smile "Wird gemacht."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1310
translate de rom_marbella_dom_meet_at_pale_dragon_dbc58564:

    # "With a soft, nervous smile, Marbella left."
    "Mit einem sanften, nervösen Lächeln ging Marbella."

# game/data/world_romance/marbella/rom_marbella_dom.rpy:1312
translate de rom_marbella_dom_meet_at_pale_dragon_0e435b07:

    # MC @ smile "(I should visit her again soon when I want some more 'fun.')"
    MC @ smile "(Ich sollte sie bald wieder besuchen, wenn ich wieder etwas mehr 'Spaß' will.)"

