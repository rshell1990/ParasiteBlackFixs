translate de rom_marbella_shared_the_face_7af6f9a4:

    # SHYAHTAN "(I have its scent.)"
    SHYAHTAN "(Ich habe seine Witterung.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:8
translate de rom_marbella_shared_the_face_049df98c:

    # MC @ think "(You mean whatever's killing the Khazah?)"
    MC @ think "(Du meinst das, was die Khazah tötet?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:9
translate de rom_marbella_shared_the_face_6b394e0f:

    # SHYAHTAN "(We can pursue it... should you wish.)"
    SHYAHTAN "(Wir können es verfolgen... wenn du möchtest.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:11
translate de rom_marbella_shared_the_face_7af6f9a4_1:

    # SHYAHTAN "(I have its scent.)"
    SHYAHTAN "(Ich habe seine Witterung.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:12
translate de rom_marbella_shared_the_face_d1649a6b:

    # SHYAHTAN "(We should pursue.)"
    SHYAHTAN "(Wir sollten es verfolgen.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:18
translate de rom_marbella_shared_the_face_4c5cd0e2:

    # SHYAHTAN "(The creature will return to hunt another night, no doubt...)"
    SHYAHTAN "(Die Kreatur wird ohne Zweifel in einer anderen Nacht wieder jagen...)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:25
translate de rom_marbella_shared_the_face_68b0d87d:

    # "The scent was thick with heavy blood. Had the creature found a victim?"
    "Der Geruch war schwer von dickem Blut. Hatte die Kreatur ein Opfer gefunden?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:26
translate de rom_marbella_shared_the_face_adb713b3:

    # "What even was it?"
    "Was war es überhaupt?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:30
translate de rom_marbella_shared_the_face_e49976b9:

    # "Down the dark alleyways, kicking up cold sand, I turned a corner to see... {i}it.{/i}"
    "Die dunklen Gassen hinunter, kalten Sand aufwirbelnd, bog ich um eine Ecke und sah... {i}es.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:31
translate de rom_marbella_shared_the_face_c9566933:

    # "A woman — a prostitute — pressing a man up against a wall."
    "Eine Frau – eine Prostituierte –, die einen Mann gegen eine Wand drückt."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:32
translate de rom_marbella_shared_the_face_2c12ecca:

    # "Her red lips were pressed to his throat, his eyes rolled back, his face deathly white."
    "Ihre roten Lippen waren an seinen Hals gepresst, seine Augen waren nach hinten gerollt, sein Gesicht totenbleich."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:33
translate de rom_marbella_shared_the_face_1bcca6ca:

    # "The creature snapped her neck toward me, revealing the huge, gaping wound in the man's neck and the blood splattered around her mouth."
    "Die Kreatur riss ihren Kopf zu mir herum und enthüllte die riesige, klaffende Wunde am Hals des Mannes und das Blut, das um ihren Mund herum verspritzt war."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:34
translate de rom_marbella_shared_the_face_a2c1a49b:

    # "Her eyes glowed yellow as she inched closer, taking in a deep inhale."
    "Ihre Augen leuchteten gelb, als sie näher kroch und tief einatmete."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:35
translate de rom_marbella_shared_the_face_a9c43efc:

    # "Before I knew it, the fleshy skin of the woman dropped to the floor as though it was a suit... her severed head rolling along the floor."
    "Bevor ich mich versah, fiel die fleischige Haut der Frau zu Boden, als wäre sie ein Anzug... ihr abgetrennter Kopf rollte über den Boden."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:36
translate de rom_marbella_shared_the_face_29b36423:

    # "The creature... The real creature, perhaps sensing something was {i}different{/i} about me too,"
    "Die Kreatur... Die wahre Kreatur, die vielleicht spürte, dass auch an mir etwas {i}anders{/i} war,"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:37
translate de rom_marbella_shared_the_face_05e13833:

    # "appeared before me in all it's hideous, terror."
    "erschien vor mir in all ihrem abscheulichen Schrecken."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:42
translate de rom_marbella_shared_the_face_a857fd35:

    # THE_FACE "You're not human."
    THE_FACE "Du bist kein Mensch."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:43
translate de rom_marbella_shared_the_face_1c4ec264:

    # THE_FACE "At least not fully... Who are you?"
    THE_FACE "Zumindest nicht vollständig... Wer bist du?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:44
translate de rom_marbella_shared_the_face_a7e9b266:

    # THE_FACE "{i}... What are you?{/i}"
    THE_FACE "{i}... Was bist du?{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:49
translate de rom_marbella_shared_the_face_menu_c6af2dbb:

    # "The creature grinned."
    "Die Kreatur grinste."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:50
translate de rom_marbella_shared_the_face_menu_19136f53:

    # THE_FACE "I'm you."
    THE_FACE "Ich bin du."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:51
translate de rom_marbella_shared_the_face_menu_107c286b:

    # THE_FACE "I'm them."
    THE_FACE "Ich bin sie."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:52
translate de rom_marbella_shared_the_face_menu_f9227432:

    # THE_FACE "I'm whatever face I wear."
    THE_FACE "Ich bin jedes Gesicht, das ich trage."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:56
translate de rom_marbella_shared_the_face_menu_6dc791f0:

    # THE_FACE "Cheap imitations."
    THE_FACE "Billige Nachahmungen."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:57
translate de rom_marbella_shared_the_face_menu_1359da5a:

    # THE_FACE "Toys of the one called Zanarak."
    THE_FACE "Spielzeuge desjenigen, der Zanarak genannt wird."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:58
translate de rom_marbella_shared_the_face_menu_8268f71e:

    # "The face grinned."
    "Das Gesicht grinste."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:59
translate de rom_marbella_shared_the_face_menu_00cbccde:

    # THE_FACE "We are older."
    THE_FACE "Wir sind älter."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:60
translate de rom_marbella_shared_the_face_menu_0e779db2:

    # MC @ think "Is there many of you left?"
    MC @ think "Sind noch viele von euch übrig?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:61
translate de rom_marbella_shared_the_face_menu_c2715630:

    # THE_FACE "I have not sensed another of my kind in over four-hundred years."
    THE_FACE "Ich habe seit über vierhundert Jahren keinen anderen meiner Art gespürt."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:62
translate de rom_marbella_shared_the_face_menu_7eff8b9b:

    # MC @ think "... Then maybe you're the last?"
    MC @ think "... Dann bist du vielleicht der Letzte?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:63
translate de rom_marbella_shared_the_face_menu_c6af2dbb_1:

    # "The creature grinned."
    "Die Kreatur grinste."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:64
translate de rom_marbella_shared_the_face_menu_ffd72ac8:

    # THE_FACE "{i}No.{/i}"
    THE_FACE "{i}Nein.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:70
translate de rom_marbella_shared_the_face_menu_87f6b424:

    # THE_FACE "And what do you want... [player_name!t]?"
    THE_FACE "Und was willst du... [player_name!t]?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:72
translate de rom_marbella_shared_the_face_menu_9c9ec1b9:

    # SHYAHTAN "{i}To eat you.{/i}"
    SHYAHTAN "{i}Dich zu fressen.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:73
translate de rom_marbella_shared_the_face_menu_aa8b5630:

    # MC "(Gods be damned, man! Why would you blurt that out?!)"
    MC "(Verdammt noch mal, Mann! Warum musst du das so herausplatzen?!)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:74
translate de rom_marbella_shared_the_face_menu_f6e6be2e:

    # THE_FACE "... Interesting."
    THE_FACE "... Interessant."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:75
translate de rom_marbella_shared_the_face_menu_6c6fde8c:

    # THE_FACE "Then let me make you an offer."
    THE_FACE "Dann lass mich dir ein Angebot machen."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:76
translate de rom_marbella_shared_the_face_menu_e3946eb2:

    # THE_FACE "I will give you a piece to eat if you leave me alone."
    THE_FACE "Ich gebe dir ein Stück zu essen, wenn du mich in Ruhe lässt."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:77
translate de rom_marbella_shared_the_face_menu_1dacda77:

    # MC "... What?"
    MC "... Was?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:78
translate de rom_marbella_shared_the_face_menu_692a2e7d:

    # MC "(This thing is unnerving as all seven hells.)"
    MC "(Dieses Ding ist so beunruhigend wie alle sieben Höllen.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:79
translate de rom_marbella_shared_the_face_menu_2c2b6b44:

    # MC "(Should we take its offer?)"
    MC "(Sollten wir sein Angebot annehmen?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:80
translate de rom_marbella_shared_the_face_menu_2643f325:

    # MC "(Will a piece of it be enough?)"
    MC "(Wird ein Stück davon ausreichen?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:81
translate de rom_marbella_shared_the_face_menu_ead25a14:

    # SHYAHTAN "(Yes.)"
    SHYAHTAN "(Ja.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:82
translate de rom_marbella_shared_the_face_menu_7bd068a0:

    # "My eyes drifted toward the poor bastard the creature was devouring."
    "Meine Augen wanderten zu dem armen Bastard, den die Kreatur verschlang."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:83
translate de rom_marbella_shared_the_face_menu_6db09147:

    # SHYAHTAN "(That is, if you are fine with letting this creature continue what it's doing...)"
    SHYAHTAN "(Das heißt, wenn du damit einverstanden bist, dass diese Kreatur weitermacht...)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:86
translate de rom_marbella_shared_the_face_menu_b2b6d0b3:

    # MC @ talk "You to leave this city."
    MC @ talk "Du sollst diese Stadt verlassen."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:87
translate de rom_marbella_shared_the_face_menu_cb4efca3:

    # THE_FACE "And why would I do that?"
    THE_FACE "Und warum sollte ich das tun?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:88
translate de rom_marbella_shared_the_face_menu_3c3b1657:

    # MC @ talk "You've preyed on the wrong people. They sent me to deal with you, one way or another."
    MC @ talk "Du hast die falschen Leute zur Beute gemacht. Sie haben mich geschickt, um mich um dich zu kümmern, so oder so."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:89
translate de rom_marbella_shared_the_face_menu_2e8c2376:

    # THE_FACE "And why should I not just kill you... and then kill them?"
    THE_FACE "Und warum sollte ich dich nicht einfach töten ... und dann sie töten?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:90
translate de rom_marbella_shared_the_face_menu_1bf20a23:

    # THE_FACE "I rather like this hunting ground."
    THE_FACE "Ich mag dieses Jagdrevier ziemlich gern."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:96
translate de rom_marbella_shared_the_face_menu_ddd9a544:

    # THE_FACE "I can always find a new face to wear."
    THE_FACE "Ich kann immer ein neues Gesicht zum Tragen finden."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:97
translate de rom_marbella_shared_the_face_menu_bc03026e:

    # MC @ serious "But whatever the hells you are, you need to feed."
    MC @ serious "Aber was zum Teufel du auch bist, du musst dich ernähren."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:98
translate de rom_marbella_shared_the_face_menu_ed137a9a:

    # MC @ think "The bodies are stacking up. It won't be long before the merchant lords hire inquisitors or someone worse."
    MC @ think "Die Leichen stapeln sich. Es wird nicht lange dauern, bis die Handelsherren Inquisitoren oder etwas Schlimmeres anheuern."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:99
translate de rom_marbella_shared_the_face_menu_6755aa3d:

    # MC @ talk "Then it's only a matter of time."
    MC @ talk "Dann ist es nur noch eine Frage der Zeit."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:100
translate de rom_marbella_shared_the_face_menu_4867ba98:

    # "The creature seemed to contemplate my words."
    "Die Kreatur schien über meine Worte nachzudenken."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:101
translate de rom_marbella_shared_the_face_menu_b2c0a385:

    # THE_FACE "... Hm."
    THE_FACE "... Hm."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:102
translate de rom_marbella_shared_the_face_menu_63f5e52d:

    # THE_FACE "Perhaps it is time I found a new hunting ground."
    THE_FACE "Vielleicht ist es an der Zeit, ein neues Jagdgebiet zu finden."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:108
translate de rom_marbella_shared_the_face_menu_03235ba9:

    # "The creature grinned as it ripped off its arm and threw it toward me."
    "Die Kreatur grinste, als sie sich den Arm abriss und ihn mir zuwarf."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:109
translate de rom_marbella_shared_the_face_menu_5c574a52:

    # "Strange tendrils still writhed from the open flesh wound."
    "Seltsame Ranken wanden sich immer noch aus der offenen Fleischwunde."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:110
translate de rom_marbella_shared_the_face_menu_4e2c4d3e:

    # MC @ scared "... What. The. Fuck."
    MC @ scared "... Was. Zum. Teufel."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:111
translate de rom_marbella_shared_the_face_menu_42ddfa67:

    # THE_FACE "A wise choice."
    THE_FACE "Eine weise Wahl."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:116
translate de rom_marbella_shared_the_face_menu_8761e6c2:

    # THE_FACE "... Wearing your skin is going to be fun."
    THE_FACE "... Deine Haut zu tragen wird Spaß machen."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:120
translate de rom_marbella_shared_the_face_menu_7e6a4ecc:

    # "With a death rattle, the creature writhed on the ground in agony."
    "Mit einem Todesröcheln wand sich die Kreatur qualvoll auf dem Boden."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:121
translate de rom_marbella_shared_the_face_menu_cf5660e2:

    # "A pool of blood spread from its wounds until at last it lay still."
    "Eine Blutlache breitete sich aus ihren Wunden aus, bis sie schließlich reglos dalag."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:125
translate de rom_marbella_shared_the_face_menu_465c70d7:

    # MC @ scared "(... What in the hells was that?)"
    MC @ scared "(... Was zur Hölle war das?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:128
translate de rom_marbella_shared_the_face_menu_7c9c4372:

    # SHYAHTAN "(Just another predator trying to survive.)"
    SHYAHTAN "(Nur ein weiteres Raubtier, das versucht zu überleben.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:129
translate de rom_marbella_shared_the_face_menu_1ba06388:

    # MC @ think "(Well... I should head back to the Khazah at least.)"
    MC @ think "(Nun... ich sollte zumindest zurück zu den Khazah gehen.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:131
translate de rom_marbella_shared_the_face_menu_aeebd902:

    # SHYAHTAN "(Food.)"
    SHYAHTAN "(Essen.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:132
translate de rom_marbella_shared_the_face_menu_79ad5e9a:

    # MC @ angry "(Is that really all you can think about?!)"
    MC @ angry "(Ist das wirklich alles, woran du denken kannst?!)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:133
translate de rom_marbella_shared_the_face_menu_261fccd8:

    # "I felt my own hand fight against me, rising toward the creature's body."
    "Ich spürte, wie meine eigene Hand gegen mich kämpfte und sich zum Körper der Kreatur erhob."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:134
translate de rom_marbella_shared_the_face_menu_647fb08d:

    # "Black tendrils pushed out, wrapping around and inspecting the corpse."
    "Schwarze Ranken schoben sich heraus, umwickelten und inspizierten die Leiche."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:135
translate de rom_marbella_shared_the_face_menu_b4187bec:

    # "Suddenly, one of the tendrils pierced the flesh, draining it until, within moments, it became a withered husk."
    "Plötzlich durchbohrte eine der Ranken das Fleisch, saugte es aus, bis es innerhalb weniger Augenblicke zu einer verdorrten Hülle wurde."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:136
translate de rom_marbella_shared_the_face_menu_4aea6492:

    # MC @ talk "Uhh, you got what you needed?"
    MC @ talk "Ähm, hast du bekommen, was du brauchtest?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:137
translate de rom_marbella_shared_the_face_menu_a240a5ea:

    # SHYAHTAN "Yes."
    SHYAHTAN "Ja."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:138
translate de rom_marbella_shared_the_face_menu_9f7a6c71:

    # SHYAHTAN "Now we can return to our mate tomorrow."
    SHYAHTAN "Jetzt können wir morgen zu unserem Gefährten zurückkehren."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:139
translate de rom_marbella_shared_the_face_menu_56c9cbc1:

    # MC "Right..."
    MC "Richtig..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:144
translate de rom_marbella_shared_the_face_negotiate_0909f5b7:

    # "To my horror, I watched as the creature made short work of the man, stuffing it's face with his inards before turning it's gaze back towards the lifeless body of the woman."
    "Zu meinem Entsetzen sah ich, wie die Kreatur kurzen Prozess mit dem Mann machte, sich das Gesicht mit seinen Innereien vollstopfte, bevor sie ihren Blick wieder auf den leblosen Körper der Frau richtete."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:145
translate de rom_marbella_shared_the_face_negotiate_03091605:

    # "Clambering back inside of her, the skin stretching over the flesh unnaturally, and then, it began to settle over the the strange creature's body as it contorted itself into shape."
    "Es krabbelte wieder in sie hinein, die Haut spannte sich unnatürlich über das Fleisch, und dann begann sie, sich über den Körper der seltsamen Kreatur zu legen, während diese sich in Form wand."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:146
translate de rom_marbella_shared_the_face_negotiate_c2f1fa26:

    # "Bones breaking and snapping into place as the creature shrink, fitting itself inside of her."
    "Knochen brachen und rasteten ein, als die Kreatur schrumpfte und sich in ihr zurechtfand."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:147
translate de rom_marbella_shared_the_face_negotiate_98122aeb:

    # "It grabbed the severed head, with tendrils protruding from the open wound of the neck and connected the head there, almost as if it was screwing the head back on."
    "Sie ergriff den abgetrennten Kopf, Ranken ragten aus der offenen Wunde des Halses und verbanden den Kopf dort, fast so, als würde sie den Kopf wieder festschrauben."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:148
translate de rom_marbella_shared_the_face_negotiate_76fbf04d:

    # "From the open wound where his head had been, the lifeless face moved once more."
    "Aus der offenen Wunde, wo sein Kopf gewesen war, bewegte sich das leblose Gesicht noch einmal."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:149
translate de rom_marbella_shared_the_face_negotiate_1eda4053:

    # "In a few gory moments, sinew, flesh, and skin covered all wounds."
    "Binnen weniger blutiger Augenblicke bedeckten Sehnen, Fleisch und Haut alle Wunden."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:150
translate de rom_marbella_shared_the_face_negotiate_80623e6a:

    # "The eyes opened."
    "Die Augen öffneten sich."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:151
translate de rom_marbella_shared_the_face_negotiate_e7dbd68e:

    # "{i}It looked like a normal woman.{/i}"
    "{i}Es sah aus wie eine normale Frau.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:156
translate de rom_marbella_shared_the_face_negotiate_da31ff86:

    # "It smiled at me."
    "Es lächelte mich an."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:157
translate de rom_marbella_shared_the_face_negotiate_ce2bbed9:

    # THE_FACE @ smile "Now I take my leave."
    THE_FACE @ smile "Nun verabschiede ich mich."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:158
translate de rom_marbella_shared_the_face_negotiate_de8d54d9:

    # THE_FACE @ smile "Perhaps we will meet again one day?"
    THE_FACE @ smile "Vielleicht treffen wir uns eines Tages wieder?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:159
translate de rom_marbella_shared_the_face_negotiate_8129db98:

    # THE_FACE "You are..."
    THE_FACE "Du bist..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:160
translate de rom_marbella_shared_the_face_negotiate_9aa8c348:

    # THE_FACE @ smile "{i}Interesting.{/i}"
    THE_FACE @ smile "{i}Interessant.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:161
translate de rom_marbella_shared_the_face_negotiate_6cc75be9:

    # MC @ talk "You never told me your name."
    MC @ talk "Du hast mir nie deinen Namen verraten."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:162
translate de rom_marbella_shared_the_face_negotiate_259b0362:

    # "The creature grinned again, its eyes black as it bared razor-thin teeth."
    "Die Kreatur grinste erneut, ihre Augen schwarz, als sie messerscharfe Zähne fletschte."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:163
translate de rom_marbella_shared_the_face_negotiate_3070413d:

    # THE_FACE @ smile "I don't have a name... I just take them."
    THE_FACE @ smile "Ich habe keinen Namen... Ich nehme sie mir einfach."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:164
translate de rom_marbella_shared_the_face_negotiate_9266cbab:

    # THE_FACE "... People like to think when they're alone, they're safe."
    THE_FACE "... Die Leute glauben gerne, dass sie sicher sind, wenn sie allein sind."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:165
translate de rom_marbella_shared_the_face_negotiate_307da707:

    # "It stepped back, disappearing into the darkness."
    "Es trat zurück und verschwand in der Dunkelheit."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:167
translate de rom_marbella_shared_the_face_negotiate_47aac664:

    # "The last thing I saw were its razor teeth and glowing yellow eyes."
    "Das Letzte, was ich sah, waren seine messerscharfen Zähne und leuchtend gelben Augen."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:168
translate de rom_marbella_shared_the_face_negotiate_ba425c3c:

    # THE_FACE "{i}But we are waiting for them every night.{/i}"
    THE_FACE "{i}Aber wir warten jede Nacht auf sie.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:169
translate de rom_marbella_shared_the_face_negotiate_197a0fbf:

    # "And with that, it was gone."
    "Und damit war es verschwunden."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:171
translate de rom_marbella_shared_the_face_negotiate_d9d519af:

    # MC @ scared "That... thing..."
    MC @ scared "Dieses... Ding..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:172
translate de rom_marbella_shared_the_face_negotiate_307cc04c:

    # MC @ scared "How many of those things walk among us?"
    MC @ scared "Wie viele dieser Dinger laufen unter uns herum?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:173
translate de rom_marbella_shared_the_face_negotiate_8dd99207:

    # SHYAHTAN "(In our travels, I have occasionally sensed their presence.)"
    SHYAHTAN "(Auf unseren Reisen habe ich gelegentlich ihre Anwesenheit gespürt.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:174
translate de rom_marbella_shared_the_face_negotiate_e51f39a9:

    # SHYAHTAN "(They are very few in number.)"
    SHYAHTAN "(Es sind sehr wenige an der Zahl.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:175
translate de rom_marbella_shared_the_face_negotiate_de542541:

    # SHYAHTAN "({i}But they are out there...{/i})"
    SHYAHTAN "({i}Aber sie sind da draußen...{/i})"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:176
translate de rom_marbella_shared_the_face_negotiate_e3faf380:

    # "Pushing the thought aside, I looked down at the severed arm and reached to pick it up."
    "Ich schob den Gedanken beiseite, blickte auf den abgetrennten Arm hinab und griff danach, um ihn aufzuheben."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:178
translate de rom_marbella_shared_the_face_negotiate_f7b4d877:

    # MC @ think "(With that sorted, I should head back to the Khazah and let them know this won't be a problem anymore.)"
    MC @ think "(Nachdem das erledigt ist, sollte ich zu den Khazah zurückkehren und ihnen mitteilen, dass dies kein Problem mehr sein wird.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:180
translate de rom_marbella_shared_the_face_negotiate_71bd67e9:

    # "From my other hand, Shyahtan's black tendrils pushed out, wrapping around and inspecting the arm."
    "Aus meiner anderen Hand drangen Shyahtans schwarze Ranken hervor, wickelten sich um den Arm und untersuchten ihn."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:181
translate de rom_marbella_shared_the_face_negotiate_b4187bec:

    # "Suddenly, one of the tendrils pierced the flesh, draining it until, within moments, it became a withered husk."
    "Plötzlich durchbohrte eine der Ranken das Fleisch und saugte es aus, bis es innerhalb von Augenblicken zu einer vertrockneten Hülle wurde."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:182
translate de rom_marbella_shared_the_face_negotiate_4aea6492:

    # MC @ talk "Uhh, you got what you needed?"
    MC @ talk "Äh, hast du, was du brauchtest?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:183
translate de rom_marbella_shared_the_face_negotiate_a240a5ea:

    # SHYAHTAN "Yes."
    SHYAHTAN "Ja."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:184
translate de rom_marbella_shared_the_face_negotiate_9f7a6c71:

    # SHYAHTAN "Now we can return to our mate tomorrow."
    SHYAHTAN "Jetzt können wir morgen zu unserem Gefährten zurückkehren."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:185
translate de rom_marbella_shared_the_face_negotiate_7a5082fa:

    # MC "If you say so..."
    MC "Wenn du meinst..."

