# game/data/world_romance/mika/preg_mika.rpy:70
translate de rom_mika_first_post_impreg_scene_a0182c6c:

    # "Mika opened her mouth to say something, but as Sister Divine snapped her a knowing look, she quickly averted her gaze."
    "Mika öffnete den Mund, um etwas zu sagen, doch als Schwester Divine ihr einen wissenden Blick zuwarf, wandte sie schnell den Blick ab."

# game/data/world_romance/mika/preg_mika.rpy:71
translate de rom_mika_first_post_impreg_scene_ddd7ccc1:

    # DIVINE @ happy "You must forgive her, [player_name!t]."
    DIVINE @ happy "Sie müssen ihr verzeihen, [player_name!t]."

# game/data/world_romance/mika/preg_mika.rpy:72
translate de rom_mika_first_post_impreg_scene_9b12449d:

    # DIVINE @ angry "No doubt all reason has left her thanks to the goddess' blessing filling her womb."
    DIVINE @ angry "Zweifellos hat sie den Verstand verloren, dank des Segens der Göttin, der ihren Schoß erfüllt."

# game/data/world_romance/mika/preg_mika.rpy:73
translate de rom_mika_first_post_impreg_scene_52203584:

    # "Mika shyly continued to look away."
    "Mika schaute schüchtern weiter weg."

# game/data/world_romance/mika/preg_mika.rpy:74
translate de rom_mika_first_post_impreg_scene_2524957b:

    # DIVINE @ happy "But I trust you can keep quiet about this... {i}miraclulous conception.{/i}"
    DIVINE @ happy "Aber ich vertraue darauf, dass Sie darüber Stillschweigen bewahren können... {i}wundersame Empfängnis.{/i}"

# game/data/world_romance/mika/preg_mika.rpy:75
translate de rom_mika_first_post_impreg_scene_41db3958:

    # DIVINE @ happy "We wouldn't want anyone to question the purity of our holy ordained mages, would we?"
    DIVINE @ happy "Wir möchten doch nicht, dass jemand die Reinheit unserer heilig ordinierten Magier in Frage stellt, nicht wahr?"

# game/data/world_romance/mika/preg_mika.rpy:76
translate de rom_mika_first_post_impreg_scene_268408e4:

    # MC @ talk "Of course... Sister, my lips are sealed."
    MC @ talk "Natürlich... Schwester, meine Lippen sind versiegelt."

# game/data/world_romance/mika/preg_mika.rpy:77
translate de rom_mika_first_post_impreg_scene_8979052c:

    # "Seemingly satisfied with my answer, Sister Divine bowed gracefully before leaving."
    "Scheinbar zufrieden mit meiner Antwort, verbeugte sich Schwester Divine anmutig, bevor sie ging."

# game/data/world_romance/mika/preg_mika.rpy:80
translate de rom_mika_first_post_impreg_scene_25b22225:

    # MIKA @ sad "I'm sorry about that..."
    MIKA @ sad "Es tut mir leid deswegen..."

# game/data/world_romance/mika/preg_mika.rpy:81
translate de rom_mika_first_post_impreg_scene_af0c5fd3:

    # MIKA @ sad "This isn't the first time something like this has happened with other girls."
    MIKA @ sad "Es ist nicht das erste Mal, dass so etwas mit anderen Mädchen passiert ist."

# game/data/world_romance/mika/preg_mika.rpy:82
translate de rom_mika_first_post_impreg_scene_076c04c6:

    # MC @ sad "Will I still be allowed to see the child?"
    MC @ sad "Werde ich das Kind noch sehen dürfen?"

# game/data/world_romance/mika/preg_mika.rpy:83
translate de rom_mika_first_post_impreg_scene_eadfcb05:

    # MIKA @ shock "I-If you want to!"
    MIKA @ shock "W-Wenn du willst!"

# game/data/world_romance/mika/preg_mika.rpy:84
translate de rom_mika_first_post_impreg_scene_d312bea7:

    # "Mika seemed more surprised than anything that I'd want to still be involved with the child."
    "Mika schien mehr als alles andere überrascht, dass ich immer noch mit dem Kind zu tun haben wollte."

# game/data/world_romance/mika/preg_mika.rpy:85
translate de rom_mika_first_post_impreg_scene_81c5870a:

    # MIKA @ sad "But, there's no expectations for you... Between myself and the other mages of Palam, the child would be raised in one of the towers if they're born with the goddess' blessing."
    MIKA @ sad "Aber es gibt keine Erwartungen an dich... Unter mir und den anderen Magiern von Palam würde das Kind in einem der Türme aufgezogen werden, wenn es mit dem Segen der Göttin geboren wird."

# game/data/world_romance/mika/preg_mika.rpy:86
translate de rom_mika_first_post_impreg_scene_67db46b8:

    # MIKA @ talk "Y-You'd still be allowed to be involved in the child's life if you wish."
    MIKA @ talk "D-Du würdest immer noch in das Leben des Kindes einbezogen werden dürfen, wenn du möchtest."

# game/data/world_romance/mika/preg_mika.rpy:87
translate de rom_mika_first_post_impreg_scene_3c837fa7:

    # MIKA @ talk "As l-long as you could keep the fact you're their father a secret."
    MIKA @ talk "S-solange du die Tatsache, dass du ihr Vater bist, geheim halten könntest."

# game/data/world_romance/mika/preg_mika.rpy:88
translate de rom_mika_first_post_impreg_scene_efbc1159:

    # MC @ surprised "I-"
    MC @ surprised "Ich-"

# game/data/world_romance/mika/preg_mika.rpy:89
translate de rom_mika_first_post_impreg_scene_8f291bb8:

    # MIKA @ shock "Y-You don't need to answer now..."
    MIKA @ shock "D-Du musst jetzt nicht antworten..."

# game/data/world_romance/mika/preg_mika.rpy:90
translate de rom_mika_first_post_impreg_scene_9523aff0:

    # MIKA @ smile "It's... alright, honestly."
    MIKA @ smile "Es ist... in Ordnung, ehrlich."

# game/data/world_romance/mika/preg_mika.rpy:91
translate de rom_mika_first_post_impreg_scene_2e10b7d6:

    # MIKA @ talk "I c-can't ask you to stay here just for me."
    MIKA @ talk "I-Ich k-kann dich nicht bitten, nur meinetwegen hier zu bleiben."

# game/data/world_romance/mika/preg_mika.rpy:92
translate de rom_mika_first_post_impreg_scene_70145710:

    # MIKA @ smile "B-But if {i}you want to...{/i}"
    MIKA @ smile "A-Aber wenn {i}du willst...{/i}"

# game/data/world_romance/mika/preg_mika.rpy:93
translate de rom_mika_first_post_impreg_scene_7c054f36:

    # MIKA @ blush "{i}W-We{/i} can be a part of your life."
    MIKA @ blush "{i}W-Wir{/i} können ein Teil deines Lebens sein."

# game/data/world_romance/mika/preg_mika.rpy:94
translate de rom_mika_first_post_impreg_scene_af5af2a1:

    # "As I reached out to touch Mika, whose heart was no doubt racing at her declaration, she quickly turned heel and hurried off."
    "Als ich die Hand ausstreckte, um Mika zu berühren, deren Herz bei ihrer Erklärung zweifellos raste, drehte sie sich schnell um und eilte davon."

# game/data/world_romance/mika/preg_mika.rpy:97
translate de rom_mika_first_post_impreg_scene_3c747424:

    # MC @ surprised "Mika!"
    MC @ surprised "Mika!"

# game/data/world_romance/mika/preg_mika.rpy:99
translate de rom_mika_first_post_impreg_scene_f672be65:

    # MC "(That girl...)"
    MC "(Dieses Mädchen...)"

# game/data/world_romance/mika/preg_mika.rpy:100
translate de rom_mika_first_post_impreg_scene_3991244b:

    # MC "(I might not be able to see her as much as I'd like, but I won't abandon her and our child!)"
    MC "(Ich kann sie vielleicht nicht so oft sehen, wie ich möchte, aber ich werde sie und unser Kind nicht im Stich lassen!)"

# game/data/world_romance/mika/preg_mika.rpy:101
translate de rom_mika_first_post_impreg_scene_6595b2ca:

    # MC "(It's so strange... I thought I might be more afraid; instead, all I feel is a surge of pride and...)"
    MC "(Es ist so seltsam... Ich dachte, ich hätte vielleicht mehr Angst; stattdessen spüre ich nur einen Anflug von Stolz und...)"

# game/data/world_romance/mika/preg_mika.rpy:102
translate de rom_mika_first_post_impreg_scene_74c38427:

    # MC "(Protectiveness.)"
    MC "(Beschützerinstinkt.)"

# game/data/world_romance/mika/preg_mika.rpy:103
translate de rom_mika_first_post_impreg_scene_69152bd2:

    # BLACK "({i}Our offspring must be protected.{/i})"
    BLACK "({i}Unser Nachwuchs muss beschützt werden.{/i})"

# game/data/world_romance/mika/preg_mika.rpy:104
translate de rom_mika_first_post_impreg_scene_0f76f6b0:

    # BLACK "({i}I have made sure such doubts are removed from your mind... Our sired young are precious.{/i})"
    BLACK "({i}Ich habe dafür gesorgt, dass solche Zweifel aus deinem Geist entfernt werden... Unser gezeugter Nachwuchs ist kostbar.{/i})"

# game/data/world_romance/mika/preg_mika.rpy:105
translate de rom_mika_first_post_impreg_scene_0e7b0e47:

    # MC @ think "(You're the reason for that?)"
    MC @ think "(Du bist der Grund dafür?)"

# game/data/world_romance/mika/preg_mika.rpy:106
translate de rom_mika_first_post_impreg_scene_8b36f1a8:

    # BLACK "({i}It would not serve us well for you to fear creating our spawns... I ensure with every new one created, your mind is filled with serotonin and dopamine.{/i})"
    BLACK "({i}Es wäre nicht gut für uns, wenn du Angst davor hättest, unsere Brut zu erschaffen... Ich sorge dafür, dass bei jeder neuen Schöpfung dein Geist mit Serotonin und Dopamin erfüllt wird.{/i})"

# game/data/world_romance/mika/preg_mika.rpy:107
translate de rom_mika_first_post_impreg_scene_64e6bda4:

    # MC @ think "(Sero- what?)"
    MC @ think "(Sero- was?)"

# game/data/world_romance/mika/preg_mika.rpy:108
translate de rom_mika_first_post_impreg_scene_b8468052:

    # MC @ serious "(Is this some kind of sorcery you speak of?)"
    MC @ serious "(Ist das eine Art Zauberei, von der du sprichst?)"

# game/data/world_romance/mika/preg_mika.rpy:109
translate de rom_mika_first_post_impreg_scene_90f3ed05:

    # BLACK "({i}No sorcery, only biology.{/i})"
    BLACK "({i}Keine Zauberei, nur Biologie.{/i})"

# game/data/world_romance/mika/preg_mika.rpy:110
translate de rom_mika_first_post_impreg_scene_f35300e1:

    # BLACK "({i}Relax... You and I are one in the same.{/i})"
    BLACK "({i}Entspann dich... Du und ich sind ein und dasselbe.{/i})"

# game/data/world_romance/mika/preg_mika.rpy:111
translate de rom_mika_first_post_impreg_scene_52059e1f:

    # BLACK "({i}Whatever I do, is for our benefit.{/i})"
    BLACK "({i}Was auch immer ich tue, es dient unserem Vorteil.{/i})"

# game/data/world_romance/mika/preg_mika.rpy:112
translate de rom_mika_first_post_impreg_scene_001dee26:

    # "I can't say I particularly always trusted the intent of the strange, dark passenger inside my mind."
    "Ich kann nicht sagen, dass ich den Absichten des seltsamen, dunklen Passagiers in meinem Kopf jemals besonders vertraut hätte."

# game/data/world_romance/mika/preg_mika.rpy:113
translate de rom_mika_first_post_impreg_scene_017bd3b4:

    # "But if there was one thing I could trust, it was the obsessive nature over 'breeding' the voice inside me had."
    "Aber wenn es eine Sache gab, der ich vertrauen konnte, dann war es die obsessive Besessenheit mit der 'Fortpflanzung', die die Stimme in mir hatte."

# game/data/world_romance/mika/preg_mika.rpy:114
translate de rom_mika_first_post_impreg_scene_fea06f6f:

    # MC "(How many young exactly do you expect me to sire?)"
    MC "(Wie viele Junge genau erwartest du, dass ich zeuge?)"

# game/data/world_romance/mika/preg_mika.rpy:115
translate de rom_mika_first_post_impreg_scene_e473a079:

    # MC "(...Hello?)"
    MC "(...Hallo?)"

# game/data/world_romance/mika/preg_mika.rpy:116
translate de rom_mika_first_post_impreg_scene_345f8548:

    # MC "(Hmph... I suppose that answers that then.)"
    MC "(Hmph... Ich nehme an, das beantwortet das dann.)"

# game/data/world_romance/mika/preg_mika.rpy:124
translate de rom_mika_first_post_birth_scene_bad16d95:

    # "Entering into the great halls of the tower of Palam, alerted to my presence, Sister Divine came hurrying over."
    "Als ich die großen Hallen des Turms von Palam betrat, eilte Schwester Divine, auf meine Anwesenheit aufmerksam geworden, herbei."

# game/data/world_romance/mika/preg_mika.rpy:125
translate de rom_mika_first_post_birth_scene_0692a380:

    # DIVINE @ talk "Come with me."
    DIVINE @ talk "Komm mit mir."

# game/data/world_romance/mika/preg_mika.rpy:126
translate de rom_mika_first_post_birth_scene_c047edf6:

    # MC @ think "Sister?"
    MC @ think "Schwester?"

# game/data/world_romance/mika/preg_mika.rpy:127
translate de rom_mika_first_post_birth_scene_da42dc57:

    # DIVINE @ talk "Follow..."
    DIVINE @ talk "Folge..."

# game/data/world_romance/mika/preg_mika.rpy:128
translate de rom_mika_first_post_birth_scene_f5a1c246:

    # "Leading me down the winding paths and hallways, Divine led me straight towards the girls' quarters, where Mika stood proudly, nursing a small, gurgling, blue baby in her arms."
    "Führte mich die gewundenen Pfade und Gänge entlang, Divine führte mich direkt zu den Mädchenquartieren, wo Mika stolz stand und ein kleines, gurgelndes, blaues Baby in ihren Armen hielt."

# game/data/world_romance/mika/preg_mika.rpy:136
translate de rom_mika_first_post_birth_scene_001d5deb:

    # MIKA @ smile "Hush now, little one..."
    MIKA @ smile "Psst, Kleines ..."

# game/data/world_romance/mika/preg_mika.rpy:137
translate de rom_mika_first_post_birth_scene_9375a217:

    # MIKA @ smile "D-Daddy is here."
    MIKA @ smile "P-Papa ist da."

# game/data/world_romance/mika/preg_mika.rpy:138
translate de rom_mika_first_post_birth_scene_a59cc2d3:

    # "I felt the shortness of my breath as I nervously approached the two of them."
    "Ich spürte, wie mir der Atem stockte, als ich nervös auf die beiden zuging."

# game/data/world_romance/mika/preg_mika.rpy:139
translate de rom_mika_first_post_birth_scene_6f877ae5:

    # "Seeing my... {i}our{/i} child in her arms."
    "Als ich mein... {i}unser{/i} Kind in ihren Armen sah."

# game/data/world_romance/mika/preg_mika.rpy:140
translate de rom_mika_first_post_birth_scene_d7dc6da3:

    # "The feeling was overwhelming."
    "Das Gefühl war überwältigend."

# game/data/world_romance/mika/preg_mika.rpy:141
translate de rom_mika_first_post_birth_scene_cde0bbce:

    # MIKA @ blush "S-She has the blessing."
    MIKA @ blush "S-Sie hat den Segen."

# game/data/world_romance/mika/preg_mika.rpy:142
translate de rom_mika_first_post_birth_scene_f05bb023:

    # MIKA @ blush "She's a mage of Palam."
    MIKA @ blush "Sie ist eine Magierin von Palam."

# game/data/world_romance/mika/preg_mika.rpy:143
translate de rom_mika_first_post_birth_scene_1516e22a:

    # "As I reached out, one of the small hands of {i}our{/i} baby reached out, ever so gently wrapping around my finger."
    "Als ich die Hand ausstreckte, streckte eine der kleinen Hände {i}unseres{/i} Babys sich aus und umschloss ganz sanft meinen Finger."

# game/data/world_romance/mika/preg_mika.rpy:144
translate de rom_mika_first_post_birth_scene_ba119603:

    # MIKA @ blush "{i}S-She likes you.{/i}"
    MIKA @ blush "{i}S-Sie mag dich.{/i}"

# game/data/world_romance/mika/preg_mika.rpy:145
translate de rom_mika_first_post_birth_scene_4ec9e531:

    # "Sister Divine stood vanguard over the scene, and while she tried to remain somewhat stoic and pragmatic about the whole thing, her lips curled ever so slightly into a soft smile."
    "Schwester Divine stand Wache über die Szene, und während sie versuchte, etwas stoisch und pragmatisch zu bleiben, verzogen sich ihre Lippen ganz leicht zu einem sanften Lächeln."

# game/data/world_romance/mika/preg_mika.rpy:146
translate de rom_mika_first_post_birth_scene_6bed4c10:

    # DIVINE @ happy "You should pick a name for her."
    DIVINE @ happy "Du solltest einen Namen für sie aussuchen."

# game/data/world_romance/mika/preg_mika.rpy:147
translate de rom_mika_first_post_birth_scene_3404d621:

    # MIKA @ shock "I - I haven't even thought about names!"
    MIKA @ shock "Ich - Ich habe noch nicht einmal über Namen nachgedacht!"

# game/data/world_romance/mika/preg_mika.rpy:148
translate de rom_mika_first_post_birth_scene_0d32f532:

    # MIKA @ blush "D-Do you have any ideas?"
    MIKA @ blush "H-Hast du irgendwelche Ideen?"

# game/data/world_romance/mika/preg_mika.rpy:150
translate de rom_mika_first_post_birth_scene_4c19876c:

    # MIKA @ smile "Hmm... I like it."
    MIKA @ smile "Hmm... Mir gefällt er."

# game/data/world_romance/mika/preg_mika.rpy:151
translate de rom_mika_first_post_birth_scene_d2a754f2:

    # DIVINE @ talk "You should rest now, Mika."
    DIVINE @ talk "Du solltest dich jetzt ausruhen, Mika."

# game/data/world_romance/mika/preg_mika.rpy:152
translate de rom_mika_first_post_birth_scene_02c18156:

    # MIKA @ smile "Mm, yes... Rest sounds good."
    MIKA @ smile "Mm, ja... Ausruhen klingt gut."

# game/data/world_romance/mika/preg_mika.rpy:153
translate de rom_mika_first_post_birth_scene_53ba2be1:

    # MIKA @ smile "C-Come see us soon."
    MIKA @ smile "K-Komm uns bald besuchen."

# game/data/world_romance/mika/preg_mika.rpy:154
translate de rom_mika_first_post_birth_scene_35dec9f8:

    # MIKA @ smile "{i}... My love.{/i}"
    MIKA @ smile "{i}... Meine Liebe.{/i}"

# game/data/world_romance/mika/preg_mika.rpy:155
translate de rom_mika_first_post_birth_scene_1718897b:

    # "Just saying those words made Mika's cheeks burn red from embarrassment, but after a gentle kiss on her soft lips and the child's forehead, I stepped back, escorted out by Sister Divine."
    "Allein diese Worte ließen Mikas Wangen vor Verlegenheit rot glühen, aber nach einem sanften Kuss auf ihre weichen Lippen und die Stirn des Kindes trat ich zurück und wurde von Schwester Divine hinausbegleitet."

# game/data/world_romance/mika/preg_mika.rpy:156
translate de rom_mika_first_post_birth_scene_4379ebd8:

    # DIVINE @ talk "Give her a day or so to recover, then come see her."
    DIVINE @ talk "Gib ihr ungefähr einen Tag, um sich zu erholen, und dann besuche sie."

# game/data/world_romance/mika/preg_mika.rpy:164
translate de rom_mika_first_post_birth_scene_d976317a:

    # MC @ talk "Sister Divine..."
    MC @ talk "Schwester Divine..."

# game/data/world_romance/mika/preg_mika.rpy:165
translate de rom_mika_first_post_birth_scene_46386729:

    # MC @ talk "I suspected you might be more upset about all of this."
