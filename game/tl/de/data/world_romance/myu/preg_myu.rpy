translate de rom_myu_post_birth_scene_cc0f2740:

    # "Myu, somewhere between absolute joy and a strange smug pride, hurried around the room holding the small, strange translucent child in her arms."
    "Myu, irgendwo zwischen absoluter Freude und einem seltsamen, selbstgefälligen Stolz, eilte durch den Raum und hielt das kleine, seltsame, durchscheinende Kind in ihren Armen."

# game/data/world_romance/myu/preg_myu.rpy:79
translate de rom_myu_post_birth_scene_27f87399:

    # "Myu held out the baby towards me."
    "Myu hielt mir das Baby entgegen."

# game/data/world_romance/myu/preg_myu.rpy:80
translate de rom_myu_post_birth_scene_5db1c2bb:

    # MYU @ smile "See? We do good!"
    MYU @ smile "Siehst du? Wir machen das gut!"

# game/data/world_romance/myu/preg_myu.rpy:81
translate de rom_myu_post_birth_scene_300bd8d7:

