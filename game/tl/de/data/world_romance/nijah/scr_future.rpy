# game/data/world_romance/nijah/scr_future.rpy:2
translate de rom_Nijah_stage1_future_lines_98050e9d:

    # MC @ talk "Say... Now that Tarek is dealt with, what are you going to do?"
    MC @ talk "Sag mal ... Jetzt, wo Tarek erledigt ist, was wirst du tun?"

# game/data/world_romance/nijah/scr_future.rpy:3
translate de rom_Nijah_stage1_future_lines_aaa26ffd:

    # "Nijah pondered the thought for a moment, unsure of an opportunity she had never expected to have."
    "Nijah dachte einen Moment über den Gedanken nach, unsicher über eine Gelegenheit, mit der sie nie gerechnet hätte."

# game/data/world_romance/nijah/scr_future.rpy:4
translate de rom_Nijah_stage1_future_lines_7138364c:

    # NIJAH "I don’t know..."
    NIJAH "Ich weiß nicht..."

# game/data/world_romance/nijah/scr_future.rpy:5
translate de rom_Nijah_stage1_future_lines_57b30ffe:

    # NIJAH "I suppose I could go back to working at za Pleasure District..."
    NIJAH "Ich schätze, ich könnte wieder im za Pleasure District arbeiten..."

# game/data/world_romance/nijah/scr_future.rpy:6
translate de rom_Nijah_stage1_future_lines_c606d148:

    # NIJAH "... The money is good, but iz not the safest job..."
    NIJAH "... Das Geld ist gut, aber es ist nicht der sicherste Job..."

# game/data/world_romance/nijah/scr_future.rpy:7
translate de rom_Nijah_stage1_future_lines_43fc26ca:

    # MC @ talk "... Is that your only option?"
    MC @ talk "... Ist das deine einzige Option?"

# game/data/world_romance/nijah/scr_future.rpy:8
translate de rom_Nijah_stage1_future_lines_a57cee14:

    # NIJAH "There is other way, but I’d need investors."
    NIJAH "Es gibt einen anderen Weg, aber ich bräuchte Investoren."

# game/data/world_romance/nijah/scr_future.rpy:9
translate de rom_Nijah_stage1_future_lines_6e7816fb:

    # MC @ talk "Investors? What are you planning?"
    MC @ talk "Investoren? Was hast du vor?"

# game/data/world_romance/nijah/scr_future.rpy:10
translate de rom_Nijah_stage1_future_lines_dd91a10a:

    # NIJAH "I can cook food..."
    NIJAH "Ich kann kochen..."

# game/data/world_romance/nijah/scr_future.rpy:11
translate de rom_Nijah_stage1_future_lines_0a687ef1:

    # MC @ talk "What? Like bakery food?"
    MC @ talk "Was? Wie Backwaren?"

# game/data/world_romance/nijah/scr_future.rpy:12
translate de rom_Nijah_stage1_future_lines_8199ae0d:

    # NIJAH "No, no... Ramonian street food!"
    NIJAH "Nein, nein... ramonisches Straßenessen!"

# game/data/world_romance/nijah/scr_future.rpy:13
translate de rom_Nijah_stage1_future_lines_a41c5243:

    # NIJAH "Food quick, tasty for people to eat while on go..."
    NIJAH "Schnelles, leckeres Essen für unterwegs..."

# game/data/world_romance/nijah/scr_future.rpy:14
translate de rom_Nijah_stage1_future_lines_9e9890a6:

    # MC @ smile "Ha-ha! You're full of surprises..."
    MC @ smile "Ha-ha! Du steckst voller Überraschungen..."

# game/data/world_romance/nijah/scr_future.rpy:15
translate de rom_Nijah_stage1_future_lines_09e880c3:

    # MC @ talk "Well how much do you need?"
    MC @ talk "Nun, wie viel brauchst du?"

# game/data/world_romance/nijah/scr_future.rpy:16
translate de rom_Nijah_stage1_future_lines_e049698d:

    # NIJAH "Enough for stall... Plus ingredients and cooking equipment..."
    NIJAH "Genug für einen Stand... plus Zutaten und Kochausrüstung..."

# game/data/world_romance/nijah/scr_future.rpy:17
translate de rom_Nijah_stage1_future_lines_6ca852ee:

    # NIJAH "At least thousand gold..."
    NIJAH "Mindestens tausend Gold..."

# game/data/world_romance/nijah/scr_future.rpy:18
translate de rom_Nijah_stage1_future_lines_806b841b:

    # "(That’s quite a lot.)"
    "(Das ist ganz schön viel.)"

# game/data/world_romance/nijah/scr_future.rpy:19
translate de rom_Nijah_stage1_future_lines_8c4ad5bf:

    # "(What should I encourage her to do?)"
    "(Wozu sollte ich sie ermutigen?)"

# game/data/world_romance/nijah/scr_future.rpy:22
translate de rom_Nijah_stage1_future_lines_menu_02182bf6:

    # NIJAH @ happy "...!"
    NIJAH @ happy "...!"

# game/data/world_romance/nijah/scr_future.rpy:23
translate de rom_Nijah_stage1_future_lines_menu_d82da894:

    # NIJAH @ smile "You will?"
    NIJAH @ smile "Du willst?"

# game/data/world_romance/nijah/scr_future.rpy:24
translate de rom_Nijah_stage1_future_lines_menu_9f0aa4e9:

    # NIJAH @ smile "A thousand gold?"
    NIJAH @ smile "Tausend Gold?"

# game/data/world_romance/nijah/scr_future.rpy:25
translate de rom_Nijah_stage1_future_lines_menu_d58cad19:

    # NIJAH "I... I cannot ask you to do zis!"
    NIJAH "Ich... ich kann dich nicht bitten, zis zu tun!"

# game/data/world_romance/nijah/scr_future.rpy:30
translate de rom_Nijah_stage1_future_lines_menu_97fa787e:

    # NIJAH "Zis is..."
    NIJAH "Zis ist..."

# game/data/world_romance/nijah/scr_future.rpy:31
translate de rom_Nijah_stage1_future_lines_menu_cdf45d1e:

    # "Nijah started to cry"
    "Nijah begann zu weinen."

# game/data/world_romance/nijah/scr_future.rpy:32
translate de rom_Nijah_stage1_future_lines_menu_04f17e1e:

    # NIJAH @ sad "... You haz done too much for me."
    NIJAH @ sad "... Du haz zu viel für mich getan."

# game/data/world_romance/nijah/scr_future.rpy:34
translate de rom_Nijah_stage1_future_lines_menu_a6b98d5f:

    # "Nijah hurried forward, wrapping her arms around me in a tight hug, when she pulled back, she smiled warmly, tears streaming down her cheeks in joy."
    "Nijah eilte vorwärts, schlang ihre Arme fest um mich, als sie zurückwich, lächelte sie warm, und Tränen strömten vor Freude ihre Wangen hinab."

# game/data/world_romance/nijah/scr_future.rpy:38
translate de rom_Nijah_stage1_future_lines_menu_a997409b:

    # NIJAH "Alright... I trust you... I shall wait for you."
    NIJAH "In Ordnung... Ich vertraue dir... Ich werde auf dich warten."

# game/data/world_romance/nijah/scr_future.rpy:42
translate de rom_Nijah_stage1_future_lines_menu_b41866ee:

    # NIJAH "You... Vat?"
    NIJAH "Du... was?"

# game/data/world_romance/nijah/scr_future.rpy:43
translate de rom_Nijah_stage1_future_lines_menu_88ce21a9:

    # MC @ talk "I’ll pay for you to have your own room."
    MC @ talk "Ich bezahle dir ein eigenes Zimmer."

# game/data/world_romance/nijah/scr_future.rpy:44
translate de rom_Nijah_stage1_future_lines_menu_ba9be3de:

    # MC @ talk "As a Novaras citizen, I can quickly and legally get the paperwork you need."
    MC @ talk "Als Bürger von Novaras kann ich schnell und legal die Papiere besorgen, die du brauchst."

# game/data/world_romance/nijah/scr_future.rpy:45
translate de rom_Nijah_stage1_future_lines_menu_1ef1adfd:

    # MC @ talk "I can also guarantee you have some protection that before you was not privy to."
    MC @ talk "Ich kann dir auch versichern, dass du einen Schutz hast, von dem du vorher nichts wusstest."

# game/data/world_romance/nijah/scr_future.rpy:46
translate de rom_Nijah_stage1_future_lines_menu_a4b7cc57:

    # MC "Nijah pondered the thought a moment, hesistant about the idea of returning to her old line of work."
    MC "Nijah dachte einen Moment über den Gedanken nach, zögerlich bei der Vorstellung, zu ihrer alten Arbeit zurückzukehren."

# game/data/world_romance/nijah/scr_future.rpy:47
translate de rom_Nijah_stage1_future_lines_menu_9cc15501:

    # NIJAH "This... would be better."
    NIJAH "Das... wäre besser."

# game/data/world_romance/nijah/scr_future.rpy:48
translate de rom_Nijah_stage1_future_lines_menu_1364cda5:

    # NIJAH "{i}But...{/i}"
    NIJAH "{i}Aber...{/i}"

# game/data/world_romance/nijah/scr_future.rpy:49
translate de rom_Nijah_stage1_future_lines_menu_e66bab01:

    # MC "Nijah opened her mouth to protest, but instead, her eyes simply dropped to the floor as she reached and grabbed at her other arm anxiously."
    MC "Nijah öffnete den Mund, um zu protestieren, aber stattdessen senkte sie einfach den Blick auf den Boden, während sie ängstlich nach ihrem anderen Arm griff und ihn packte."

# game/data/world_romance/nijah/scr_future.rpy:50
translate de rom_Nijah_stage1_future_lines_menu_6f13d691:

    # NIJAH "In return, you want share of gold I earn?"
    NIJAH "Im Gegenzug willst du einen Anteil an dem Gold, das ich verdiene?"

# game/data/world_romance/nijah/scr_future.rpy:51
translate de rom_Nijah_stage1_future_lines_menu_83589d81:

    # MC @ talk "I do."
    MC @ talk "Das tue ich."

# game/data/world_romance/nijah/scr_future.rpy:52
translate de rom_Nijah_stage1_future_lines_menu_79b06185:

    # NIJAH "... Thirty percent?"
    NIJAH "... Dreißig Prozent?"

# game/data/world_romance/nijah/scr_future.rpy:55
translate de rom_Nijah_stage1_future_lines_menu_568c2bf8:

    # MC @ talk "Yeah, that's a deal."
    MC @ talk "Ja, das ist ein Deal."

# game/data/world_romance/nijah/scr_future.rpy:58
translate de rom_Nijah_stage1_future_lines_menu_991a9c2d:

    # NIJAH "Alright... I suppose after all you have done zis iz fair..."
    NIJAH "In Ordnung... Ich nehme an, nach allem, was du getan hast, ist das fair..."

# game/data/world_romance/nijah/scr_future.rpy:59
translate de rom_Nijah_stage1_future_lines_menu_25a09a38:

    # NIJAH "I come with you to speak to men in charge of district..."
    NIJAH "Ich komme mit dir, um mit den Männern zu sprechen, die für den Bezirk zuständig sind ..."

# game/data/world_romance/nijah/scr_future.rpy:62
translate de rom_Nijah_stage1_future_lines_menu_ded37cfe:

    # "Following Nijah down to the District, she introduced me to one of the officials there, a tall and uninspiring rake of a man who sat down in one of the few ‘offices’ littered around the District that the girls use when they want to lodge complaints."
    "Ich folgte Nijah hinunter zum Bezirk, und sie stellte mich einem der Beamten dort vor, einem großen und uninspirierenden, schlaksigen Mann, der in einem der wenigen ‘Büros’ saß, die über den Bezirk verstreut sind und die die Mädchen nutzen, wenn sie Beschwerden einreichen wollen."

# game/data/world_romance/nijah/scr_future.rpy:63
translate de rom_Nijah_stage1_future_lines_menu_620526a0:

    # "When I showed him my gold, it didn’t exactly take long to have the right paperwork and such in place. In just a few hours, we were set to go..."
    "Als ich ihm mein Gold zeigte, dauerte es nicht lange, die richtigen Papiere und so weiter bereitzustellen. In nur wenigen Stunden waren wir startklar ..."

# game/data/world_romance/nijah/scr_future.rpy:64
translate de rom_Nijah_stage1_future_lines_menu_59f434a3:

    # "Nijah had her own room, and it was known to all that she was a protected girl now."
    "Nijah hatte ihr eigenes Zimmer, und alle wussten, dass sie jetzt ein geschütztes Mädchen war."

# game/data/world_romance/nijah/scr_future.rpy:71
translate de rom_Nijah_stage1_future_lines_menu_8f0508e3:

    # NIJAH "Zat was... very quick."
    NIJAH "Das war... sehr schnell."

# game/data/world_romance/nijah/scr_future.rpy:72
translate de rom_Nijah_stage1_future_lines_menu_a8cbf7ee:

    # NIJAH "It would take a Ramonian like me weeks to get anywhere with them."
    NIJAH "Ein Ramonianer wie ich würde Wochen brauchen, um bei ihnen etwas zu erreichen."

# game/data/world_romance/nijah/scr_future.rpy:73
translate de rom_Nijah_stage1_future_lines_menu_5f7e87c5:

    # MC @ talk "Being a citizen has its benefits."
    MC @ talk "Bürger zu sein, hat seine Vorteile."

# game/data/world_romance/nijah/scr_future.rpy:74
translate de rom_Nijah_stage1_future_lines_menu_7e9393ab:

    # NIJAH "I suppose I better get back to za work... Stop by to collect your money once a fortnight."
    NIJAH "Ich sollte wohl zurück zur Arbeit ... Komm alle zwei Wochen vorbei, um dein Geld abzuholen."

# game/data/world_romance/nijah/scr_future.rpy:75
translate de rom_Nijah_stage1_future_lines_menu_e35850f4:

    # MC @ talk "Let me know if there are any problems, remember, you are protected by me now."
    MC @ talk "Lass mich wissen, wenn es irgendwelche Probleme gibt. Denk daran, du stehst jetzt unter meinem Schutz."

# game/data/world_romance/nijah/scr_future.rpy:76
translate de rom_Nijah_stage1_future_lines_menu_518f3315:

    # MC @ talk "I will see to it that no harm comes to you."
    MC @ talk "Ich werde dafür sorgen, dass dir kein Schaden zugefügt wird."

# game/data/world_romance/nijah/scr_future.rpy:77
translate de rom_Nijah_stage1_future_lines_menu_4e16aac8:

    # "Nijah smiled unconvincingly, but nodded anyway."
    "Nijah lächelte nicht überzeugend, nickte aber trotzdem."

# game/data/world_romance/nijah/scr_future.rpy:78
translate de rom_Nijah_stage1_future_lines_menu_7b19a276:

    # NIJAH "T-Thank you... Now if you excuse me, I should get ready."
    NIJAH "D-Danke... Wenn du mich jetzt entschuldigst, sollte ich mich fertig machen."

# game/data/world_romance/nijah/scr_future.rpy:79
translate de rom_Nijah_stage1_future_lines_menu_10f6a25a:

    # MC "I watched as Nijah headed off, no doubt to prepare for her {i}'clients'{/i}"
    MC "Ich sah zu, wie Nijah davonging, zweifellos um sich auf ihre {i}'Kunden'{/i} vorzubereiten."

# game/data/world_romance/nijah/scr_future.rpy:81
translate de rom_Nijah_stage1_future_lines_menu_49528545:

    # "And just like that, Nijah returned to her old work... A part of me wondered if I’d made the right choice, if perhaps, Nijah wanted and deserved better than this life?"
    "Und einfach so kehrte Nijah zu ihrer alten Arbeit zurück... Ein Teil von mir fragte sich, ob ich die richtige Wahl getroffen hatte, ob Nijah vielleicht etwas Besseres als dieses Leben wollte und verdiente?"

# game/data/world_romance/nijah/scr_future.rpy:82
translate de rom_Nijah_stage1_future_lines_menu_da7e2faa:

    # "But, as I reminded myself, she was now safer than before... And my pockets were going to get a lot heavier. Morality aside, maybe this was for the best."
    "Aber, wie ich mich selbst erinnerte, war sie jetzt sicherer als zuvor... Und meine Taschen würden deutlich schwerer werden. Moral beiseite, vielleicht war das das Beste."

