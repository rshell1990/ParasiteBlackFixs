translate de rom_nijah_howIsBaby_94f50b3d:

    # NIJAH "I can feel zer baby kick a lot today."
    NIJAH "Ich spüre heute, wie das Baby oft tritt."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:5
translate de rom_nijah_howIsBaby_a3912238:

    # NIJAH "He will be strong like his father no doubt!"
    NIJAH "Er wird zweifellos stark wie sein Vater!"

# game/data/world_romance/nijah/scr_howIsPreg.rpy:7
translate de rom_nijah_howIsBaby_7a8a70e5:

    # NIJAH "L-Lot of pain today."
    NIJAH "V-Viel Schmerz heute."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:8
translate de rom_nijah_howIsBaby_900d2ac1:

    # NIJAH "Need to sit down more..."
    NIJAH "Muss mich öfter hinsetzen ..."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:10
translate de rom_nijah_howIsBaby_25d7ff2c:

    # "Nijah laughed as she rubbed at her round belly."
    "Nijah lachte, während sie ihren runden Bauch rieb."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:11
translate de rom_nijah_howIsBaby_4a31d51e:

    # NIJAH "Iz silly, but I keep rubbing my belly."
    NIJAH "Es ist albern, aber ich reibe ständig meinen Bauch."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:12
translate de rom_nijah_howIsBaby_29041c7b:

    # NIJAH "And when I think it iz our child, I am very happy!"
    NIJAH "Und wenn ich denke, dass es unser Kind ist, bin ich sehr glücklich!"

