translate de rom_nijah_howarethings_395b2ec1:

    # NIJAH "I tried to buy a new dress today, but the store would not sell to me."
    NIJAH "Ich habe heute versucht, ein neues Kleid zu kaufen, aber der Laden wollte es mir nicht verkaufen."

# game/data/world_romance/nijah/scr_howarethings.rpy:11
