# game/data/world_romance/nijah/scr_secondpreg.rpy:5
translate de preg_Nijah_secondPreg_b75b342e:

    # NIJAH "Uhh, my love?"
    NIJAH "Uhh, meine Liebe?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:6
translate de preg_Nijah_secondPreg_ccbd6626:

    # MC @ talk "What is it, Nijah?"
    MC @ talk "Was ist los, Nijah?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:7
translate de preg_Nijah_secondPreg_c62c397f:

    # NIJAH @ smile "You did it again."
    NIJAH @ smile "Du hast es wieder getan."

# game/data/world_romance/nijah/scr_secondpreg.rpy:8
translate de preg_Nijah_secondPreg_2b7a6d10:

    # "Nijah happily rubbed her belly."
    "Nijah rieb glücklich ihren Bauch."

# game/data/world_romance/nijah/scr_secondpreg.rpy:9
translate de preg_Nijah_secondPreg_2c6a0c4d:

    # NIJAH @ smile "I am with child once more."
    NIJAH @ smile "Ich bin wieder schwanger."

# game/data/world_romance/nijah/scr_secondpreg.rpy:10
translate de preg_Nijah_secondPreg_530a0797:

    # "Nijah took my hand and placed it over her belly, where once again I could feel the swelling life and power coursing inside of her."
    "Nijah nahm meine Hand und legte sie auf ihren Bauch, wo ich erneut das anschwellende Leben und die Kraft spüren konnte, die in ihr strömte."

# game/data/world_romance/nijah/scr_secondpreg.rpy:11
translate de preg_Nijah_secondPreg_c9ecd207:

    # NIJAH "Are you pleased, master?"
    NIJAH "Bist du zufrieden, Meister?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:12
translate de preg_Nijah_secondPreg_43ba64e3:

    # MC @ smile "Very much so, Nijah."
    MC @ smile "Sehr sogar, Nijah."

# game/data/world_romance/nijah/scr_secondpreg.rpy:13
translate de preg_Nijah_secondPreg_f2c2b4bc:

    # NIJAH @ smile "I have missed you much, come... Let me serve you food."
    NIJAH @ smile "Ich habe dich sehr vermisst, komm... Lass mich dir Essen servieren."

# game/data/world_romance/nijah/scr_secondpreg.rpy:14
translate de preg_Nijah_secondPreg_0ff7edaf:

    # NIJAH @ smile "Iz good our children will have lots of brothers and sisters!"
    NIJAH @ smile "Es ist gut, dass unsere Kinder viele Brüder und Schwestern haben werden!"

# game/data/world_romance/nijah/scr_secondpreg.rpy:16
translate de preg_Nijah_secondPreg_9053ae27:

    # "Nijah did her best to chat away with me as she cooked and served me some food."
    "Nijah gab ihr Bestes, um mit mir zu plaudern, während sie kochte und mir etwas zu essen servierte."

# game/data/world_romance/nijah/scr_secondpreg.rpy:17
translate de preg_Nijah_secondPreg_3ad40bab:

    # "Her Alderian was still broken, but she did her best to learn and was constantly moving between rooms, attending to our already born children and devoting lavishly on me."
    "Ihr Alderian war immer noch gebrochen, aber sie gab ihr Bestes zu lernen und war ständig zwischen den Räumen unterwegs, um sich um unsere bereits geborenen Kinder zu kümmern und mich großzügig zu verwöhnen."

# game/data/world_romance/nijah/scr_secondpreg.rpy:18
translate de preg_Nijah_secondPreg_2500c393:

    # "Finally, with a kiss goodbye and a squeeze of her round ass, I was off once again, assuring Nijah I would return."
    "Schließlich, mit einem Abschiedskuss und einem Drücken ihres runden Hinterns, war ich wieder unterwegs und versicherte Nijah, dass ich zurückkehren würde."

