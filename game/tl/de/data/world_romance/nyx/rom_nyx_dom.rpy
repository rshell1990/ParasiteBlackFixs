# game/data/world_romance/nyx/rom_nyx_dom.rpy:249
translate de rom_nyx_dominant_1_de672406:

    # MC "You'll cause her more trouble by causing a scene..."
    MC "Sie werden ihr mehr Ärger machen, wenn Sie eine Szene machen..."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:251
translate de rom_nyx_dominant_1_60aa7d62_1:

    # GUARD "But she's-"
    GUARD "Aber sie ist-"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:252
translate de rom_nyx_dominant_1_7f430b87_1:

    # MC @ talk "What do you think will happen if word travels that she's collapsed?"
    MC @ talk "Was glauben Sie, was passiert, wenn sich herumspricht, dass sie zusammengebrochen ist?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:253
translate de rom_nyx_dominant_1_41d0d15c_1:

    # MC @ angry "Do you really want to risk her potential enemies knowing she's in such a state right now?"
    MC @ angry "Wollen Sie wirklich riskieren, dass ihre potenziellen Feinde erfahren, dass sie sich gerade in einem solchen Zustand befindet?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:254
translate de rom_nyx_dominant_1_37eab4be_1:

    # GUARD "I ... I understand sir."
    GUARD "Ich ... ich verstehe, Sir."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:255
translate de rom_nyx_dominant_1_36bbc1fb_1:

    # MC @ talk "Good, now forget what you've seen here and leave."
    MC @ talk "Gut, vergessen Sie jetzt, was Sie hier gesehen haben, und gehen Sie."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:256
translate de rom_nyx_dominant_1_93b337a6_1:

    # GUARD "You ... wish for me to leave you alone with her?"
    GUARD "Sie ... wünschen, dass ich Sie mit ihr allein lasse?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:257
translate de rom_nyx_dominant_1_8266342d_1:

    # GUARD "Very well, should her health take a turn for the worst, I will need to report it however."
    GUARD "Nun gut, sollte sich ihr Gesundheitszustand verschlechtern, muss ich es jedoch melden."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:258
translate de rom_nyx_dominant_1_3eb4fec4:

    # GUARD "Now I must ask that you come with me."
    GUARD "Nun muss ich Sie bitten, mit mir zu kommen."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:259
translate de rom_nyx_dominant_1_78758db9:

    # GUARD "I cannot leave you unattended with the captain without her expressed permission."
    GUARD "Ich kann Sie nicht unbeaufsichtigt mit der Kapitänin lassen, ohne ihre ausdrückliche Erlaubnis."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:260
translate de rom_nyx_dominant_1_a91dbf80_2:

    # MC @ talk "Very well, I'll return to check on her in the morning."
    MC @ talk "Sehr wohl, ich werde morgen früh zurückkommen, um nach ihr zu sehen."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:262
translate de rom_nyx_dominant_1_b739de25_2:

    # "Afterwards, the guard led me outside."
    "Danach führte mich die Wache hinaus."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:274
translate de rom_nyx_dominant_2_8a057542:

    # MC "Nyx isn't here. I'll try tomorrow."
    MC "Nyx ist nicht hier. Ich versuche es morgen noch einmal."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:280
translate de rom_nyx_dominant_2_e5095c39:

    # "When Nyx saw me enter her Office chambers, her eyes widened as she struggled to fumble out and form a sentence."
    "Als Nyx mich in ihre Bürogemächer eintreten sah, weiteten sich ihre Augen, während sie mühsam Worte zu finden versuchte."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:281
translate de rom_nyx_dominant_2_2e59a533:

    # NYX @ shock "Y-You ... You...!"
    NYX @ shock "D-Du ... Du...!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:282
translate de rom_nyx_dominant_2_cbbd9c11:

    # NYX @ angry "{i}YOU!{/i}"
    NYX @ angry "{i}DU!{/i}"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:284
translate de rom_nyx_dominant_2_e26fc5ad:

    # NYX @ angry "What in all of the seven hells did you do to me the other night?!"
    NYX @ angry "Was in allen sieben Höllen hast du mir neulich nachts angetan?!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:285
translate de rom_nyx_dominant_2_8109bc45:

    # MC @ smile "Obviously I won our bet."
    MC @ smile "Offensichtlich habe ich unsere Wette gewonnen."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:286
translate de rom_nyx_dominant_2_fbdcff0b:

    # "Nyx's cheeks were burning bright red as she gritted her teeth."
    "Nyx' Wangen brannten hellrot, als sie die Zähne zusammenbiss."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:287
translate de rom_nyx_dominant_2_d07f9079:

    # NYX @ angry "That was ... That was absolutely not-!"
    NYX @ angry "Das war ... Das war absolut nicht-!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:289
translate de rom_nyx_dominant_2_2046b17b:

    # "I grabbed at Captain Nyx's shoulders, and she gasped, trembling beneath my hands as I held the usually stoic Captain."
    "Ich packte Captain Nyx an den Schultern, und sie keuchte, zitternd unter meinen Händen, während ich die sonst so stoische Captain festhielt."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:290
translate de rom_nyx_dominant_2_f644c593:

    # MC @ smile "You're shaking, are you alright my love?"
    MC @ smile "Du zitterst, geht es dir gut, meine Liebe?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:291
translate de rom_nyx_dominant_2_502204f4:

    # "Captain Nyx's cheeks burned red as she struggled to form a sentence before angrily pushing me back."
    "Captain Nyx' Wangen brannten rot, während sie versuchte, einen Satz zu bilden, bevor sie mich wütend zurückstieß."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:293
translate de rom_nyx_dominant_2_e8e76008:

    # NYX @ shock "Get back!"
    NYX @ shock "Zurück!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:294
translate de rom_nyx_dominant_2_71dfe640:

    # NYX @ angry "I don't know what you did to me, but it ... It was cheating!"
    NYX @ angry "Ich weiß nicht, was du mit mir gemacht hast, aber es ... Es war Betrug!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:295
translate de rom_nyx_dominant_2_313f6d56:

    # MC @ think "How so?"
    MC @ think "Inwiefern?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:296
translate de rom_nyx_dominant_2_bd5e4218:

    # NYX @ angry "I ... I don't know! It just was!"
    NYX @ angry "Ich ... Ich weiß es nicht! Es war einfach so!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:297
translate de rom_nyx_dominant_2_270a2d97:

    # "I couldn't help but laugh at the absurdity of her denial."
    "Ich konnte nicht anders, als über die Absurdität ihrer Verleugnung zu lachen."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:299
translate de rom_nyx_dominant_2_efeb97ac:

    # MC @ smile "Are you always this stubborn?"
    MC @ smile "Bist du immer so stur?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:300
translate de rom_nyx_dominant_2_9af4f84b:

    # NYX @ shock "I-!"
    NYX @ shock "Ich-!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:301
translate de rom_nyx_dominant_2_a2b181ac:

    # NYX @ sad "...Why are you doing this?"
    NYX @ sad "...Warum tust du das?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:302
translate de rom_nyx_dominant_2_a04e7bc6:

    # NYX @ sad "I could arrange for you to have a dozen women."
    NYX @ sad "Ich könnte dafür sorgen, dass du ein Dutzend Frauen hast."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:303
translate de rom_nyx_dominant_2_f04a34d5:

    # NYX @ shock "By the gods, you shouldn't have any trouble finding women on your own anyway!"
    NYX @ shock "Bei den Göttern, du solltest sowieso keine Probleme haben, Frauen auf eigene Faust zu finden!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:305
translate de rom_nyx_dominant_2_5f2034e8:

    # NYX @ sad "So, why me? What game are you playing?"
    NYX @ sad "Also, warum ich? Welches Spiel spielst du?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:306
translate de rom_nyx_dominant_2_4218d3bc:

    # MC @ smile "Was that a compliment I just heard nestled into that rambling?"
    MC @ smile "War das ein Kompliment, das ich gerade in deinem Geschwafel versteckt gehört habe?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:307
translate de rom_nyx_dominant_2_cdf51bab:

    # NYX @ shock "N-No! Of course not!"
    NYX @ shock "N-Nein! Natürlich nicht!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:308
translate de rom_nyx_dominant_2_c105faeb:

    # NYX @ shock "I was just commenting on how lots of women {i}would{/i} be interested in you anyway s-so..."
    NYX @ shock "Ich habe nur angemerkt, dass sowieso viele Frauen an dir interessiert {i}wären{/i}, a-also..."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:309
translate de rom_nyx_dominant_2_450fe644:

    # "Captain Nyx shook her head."
    "Captain Nyx schüttelte den Kopf."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:311
translate de rom_nyx_dominant_2_11658783:

    # NYX @ angry "And stop avoiding the question!"
    NYX @ angry "Und hör auf, der Frage auszuweichen!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:312
translate de rom_nyx_dominant_2_9b95634b:

    # MC @ bitelip "No game, Nyx, I simply like you."
    MC @ bitelip "Kein Spiel, Nyx, ich mag dich einfach."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:313
translate de rom_nyx_dominant_2_40041e97:

    # MC @ smile "And I've decided to make you mine."
    MC @ smile "Und ich habe beschlossen, dich zu meiner zu machen."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:314
translate de rom_nyx_dominant_2_40bb087b:

    # NYX @ angry "I'm not some plaything for you to play with and then discard like one of your whores!"
    NYX @ angry "Ich bin nicht irgendein Spielzeug, mit dem du spielen und das du dann wie eine deiner Huren wegwerfen kannst!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:315
translate de rom_nyx_dominant_2_dc5d472d:

    # MC @ smile "I'm afraid you've already agreed to be my plaything when you took the bet."
    MC @ smile "Ich fürchte, du hast bereits zugestimmt, mein Spielzeug zu sein, als du die Wette eingegangen bist."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:316
translate de rom_nyx_dominant_2_780be4b8:

    # "Captain Nyx grinded her teeth in impotent rage."
    "Captain Nyx knirschte ohnmächtig vor Wut mit den Zähnen."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:317
translate de rom_nyx_dominant_2_1cbc10cd:

    # NYX @ angry "You think you're the first man to try pull something like this?"
    NYX @ angry "Glaubst du, du bist der erste Mann, der so etwas versucht?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:318
translate de rom_nyx_dominant_2_0abd29a1:

    # NYX @ angry "You think I haven't dealt with men who see me as some amusing little thing playing dress-up?"
    NYX @ angry "Glaubst du, ich hätte noch nie mit Männern zu tun gehabt, die mich als ein amüsantes kleines Ding sehen, das Verkleiden spielt?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:319
translate de rom_nyx_dominant_2_026b51da:

    # MC @ talk "I am no ordinary man."
    MC @ talk "Ich bin kein gewöhnlicher Mann."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:320
translate de rom_nyx_dominant_2_e17cb5e2:

    # MC @ talk "And am I to take it then, given everything said, that your word truly does mean nothing, and you won't keep to your end of the deal?"
    MC @ talk "Und soll ich also, nach allem, was gesagt wurde, davon ausgehen, dass dein Wort wirklich nichts bedeutet und du dich nicht an deinen Teil der Abmachung halten wirst?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:321
translate de rom_nyx_dominant_2_635a232b:

    # NYX @ angry "Don't talk to me about my fucking word! When I give it, I keep it!"
    NYX @ angry "Sprich nicht mit mir über mein verdammtes Wort! Wenn ich es gebe, halte ich es!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:322
translate de rom_nyx_dominant_2_935c1ddf:

    # MC @ talk "Is that so?"
    MC @ talk "Ist das so?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:323
translate de rom_nyx_dominant_2_b0eb6485:

    # NYX @ angry "Yes!"
    NYX @ angry "Ja!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:324
translate de rom_nyx_dominant_2_0c3ee219:

    # MC @ smile "Perfect then!"
    MC @ smile "Perfekt dann!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:327
translate de rom_nyx_dominant_2_450897ab:

    # "Smiling, I stepped forward closer towards Nyx, and instinctively she moved back till she hit the desk, her hands sprawled out as she waited with bated breath for what comes next."
    "Lächelnd trat ich einen Schritt näher auf Nyx zu, und instinktiv wich sie zurück, bis sie an den Schreibtisch stieß. Ihre Hände breiteten sich aus, während sie mit angehaltenem Atem darauf wartete, was als Nächstes kommen würde."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:328
translate de rom_nyx_dominant_2_b14b198f:

    # NYX @ shock "H-Hold on a-"
    NYX @ shock "H-Halt mal-"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:329
translate de rom_nyx_dominant_2_132c673c:

    # "Captain Nyx's heart raced as her breathing became hot and heavy."
    "Kapitän Nyx' Herz raste und ihr Atem wurde heiß und schwer."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:330
translate de rom_nyx_dominant_2_cad8da5b:

    # NYX @ angry "N-No matter what you do, I'll never be your-"
    NYX @ angry "E-Egal was du tust, ich werde niemals dein-"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:334
translate de rom_nyx_dominant_2_a1f7de82:

    # "I silenced her with a kiss, my hands reaching behind her to grope and squeeze at her ass."
    "Ich brachte sie mit einem Kuss zum Schweigen, meine Hände griffen hinter sie und betatschten und drückten ihren Hintern."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:339
translate de rom_nyx_dominant_2_2290dbf2:

    # "After my tongue danced in her hot mouth for a moment, I gently pulled back and brushed her hair aside as she looked dazed towards me."
    "Nachdem meine Zunge einen Moment lang in ihrem heißen Mund getanzt hatte, zog ich mich sanft zurück und strich ihr Haar zur Seite, während sie mich benommen ansah."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:341
translate de rom_nyx_dominant_2_09f473b4:

    # MC "We shall see about that."
    MC "Das werden wir ja sehen."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:342
translate de rom_nyx_dominant_2_56fbecf3:

    # "Nyx simply stared into my eyes, she was shaking in anxiety as I felt the resistance drain away."
    "Nyx starrte mir einfach in die Augen, sie zitterte vor Angst, während ich spürte, wie der Widerstand aus ihr wich."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:343
translate de rom_nyx_dominant_2_08d74154:

    # MC @ smile "Do you want me to kiss you again?"
    MC @ smile "Möchtest du, dass ich dich noch einmal küsse?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:344
translate de rom_nyx_dominant_2_1ac07b03:

    # NYX @ shock "T-This doesn't prove anything."
    NYX @ shock "D-Das beweist nichts."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:345
translate de rom_nyx_dominant_2_8b5780ad:

    # MC @ talk "Doesn't it become tedious having to be strong all the time?"
    MC @ talk "Wird es nicht mühsam, ständig stark sein zu müssen?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:346
translate de rom_nyx_dominant_2_c0621607:

    # MC @ talk "Aren't you exhausted never showing a moments weakness in case the men around you judge you?"
    MC @ talk "Bist du nicht erschöpft, nie einen Moment der Schwäche zu zeigen, falls die Männer um dich herum dich verurteilen?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:348
translate de rom_nyx_dominant_2_637230fe:

    # NYX @ sad "...S-Stop."
    NYX @ sad "...H-Hör auf."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:349
translate de rom_nyx_dominant_2_5e744bb1:

    # MC @ talk "Wouldn't it be nice to have something where you didn't have to worry about all that?"
    MC @ talk "Wäre es nicht schön, etwas zu haben, bei dem du dir um all das keine Sorgen machen müsstest?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:350
translate de rom_nyx_dominant_2_4abd75bc:

    # NYX @ sad "I-I'm warning you...!"
    NYX @ sad "I-Ich warne dich...!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:351
translate de rom_nyx_dominant_2_e2c487e8:

    # MC @ talk "Somewhere where you didn't have to give orders and think and stress? A place where you could just ... {i}let someone else do all that for you?{/i}"
    MC @ talk "Irgendwo, wo du keine Befehle geben und nicht denken und dich stressen müsstest? Ein Ort, an dem du einfach ... {i}jemand anderem all das für dich machen lassen könntest?{/i}"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:352
translate de rom_nyx_dominant_2_1561b3bc:

    # NYX @ sad "I'll call the guards! I swear!"
    NYX @ sad "Ich rufe die Wachen! Ich schwöre!"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:353
translate de rom_nyx_dominant_2_7330b0e2:

    # MC @ talk "Then why don't you then?"
    MC @ talk "Warum tust du es dann nicht?"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:354
translate de rom_nyx_dominant_2_831c4b75:

    # NYX "..."
    NYX "..."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:355
translate de rom_nyx_dominant_2_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:356
translate de rom_nyx_dominant_2_bb02201e:

    # NYX @ sad "P-Please, I'm not ... I'm not like other women."
    NYX @ sad "B-Bitte, ich bin nicht ... ich bin nicht wie andere Frauen."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:357
translate de rom_nyx_dominant_2_1673eb87:

    # NYX @ sad "I don't even know {i}how{/i} to be a proper woman any-"
    NYX @ sad "Ich weiß nicht einmal, {i}wie{/i} man eine richtige Frau ist, meh-"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:363
translate de rom_nyx_dominant_2_ee11345a:

    # "I pulled Nyx in closer once again and pressed my lips against her."
    "Ich zog Nyx erneut näher an mich und presste meine Lippen auf ihre."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:365
translate de rom_nyx_dominant_2_aca7cd3f:

    # "I could feel her practically melt away in my arms as she sunk deeper into the kiss."
    "Ich konnte spüren, wie sie in meinen Armen förmlich dahinschmolz, als sie sich tiefer in den Kuss sinken ließ."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:366
translate de rom_nyx_dominant_2_475c706d:

    # "My hands once again fondled and squeezed at her ass, but she didn't seem to mind."
    "Meine Hände betatschten und kneteten erneut ihren Hintern, aber sie schien es nicht zu stören."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:371
translate de rom_nyx_dominant_2_ff0950be:

    # "When I pulled back from her, she lightly shoved me away shyly."
    "Als ich mich von ihr löste, schob sie mich schüchtern leicht von sich."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:374
translate de rom_nyx_dominant_2_ee2db4ef:

    # NYX @ shock "...If you tell anyone about this-"
    NYX @ shock "...Wenn du jemandem davon erzählst-"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:375
translate de rom_nyx_dominant_2_5713a9e1:

    # MC @ smile "I won't."
    MC @ smile "Werde ich nicht."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:376
translate de rom_nyx_dominant_2_a8706728:

    # NYX @ angry "I mean it, there are lots of people who would use this against me."
    NYX @ angry "Ich meine es ernst, es gibt viele Leute, die das gegen mich verwenden würden."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:378
translate de rom_nyx_dominant_2_0a101a47:

    # NYX @ sad "{i}And you.{/i}"
    NYX @ sad "{i}Und dich.{/i}"

# game/data/world_romance/nyx/rom_nyx_dom.rpy:379
translate de rom_nyx_dominant_2_49a32b0f:

    # MC @ smile "My lips are sealed."
    MC @ smile "Meine Lippen sind versiegelt."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:380
translate de rom_nyx_dominant_2_1d53ff30:

    # "Nervously, Captain Nyx reached behind her desk to take out a small key which she handed to me."
    "Nervös griff Captain Nyx hinter ihren Schreibtisch, um einen kleinen Schlüssel herauszuholen, den sie mir reichte."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:383
translate de rom_nyx_dominant_2_2d59c694:

    # NYX @ blush "My quarters."
    NYX @ blush "Meine Quartiere."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:384
translate de rom_nyx_dominant_2_6bd218f7:

    # NYX @ blush "I expect absolute discretion with this."
    NYX @ blush "Ich erwarte absolute Diskretion in dieser Angelegenheit."

# game/data/world_romance/nyx/rom_nyx_dom.rpy:385
