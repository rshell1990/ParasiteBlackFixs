# TODO: Translation updated at 2026-08-04 03:41

# game/data/world_romance/thea/rom_thea_scr.rpy:3
translate de rom_thea_invite_335cb5c3:

    # THEA @ smile "... Would you be interested perhaps in buying me a drink this evening?"
    THEA @ smile "... Wären Sie vielleicht interessiert, mir heute Abend einen Drink zu spendieren?"

# game/data/world_romance/thea/rom_thea_scr.rpy:4
translate de rom_thea_invite_0cfc087b:

    # MC @ smile "What's brought this on?"
    MC @ smile "Was hat dich darauf gebracht?"

# game/data/world_romance/thea/rom_thea_scr.rpy:5
translate de rom_thea_invite_caddc8f2:

    # THEA @ blush "I've been watching you ... You're already C-tier so fast, normally, it would take adventurers weeks or even months to get where you are."
    THEA @ blush "Ich habe Sie beobachtet ... Sie sind schon so schnell C-Rang, normalerweise würden Abenteurer Wochen oder sogar Monate brauchen, um dahin zu kommen, wo Sie jetzt sind."

# game/data/world_romance/thea/rom_thea_scr.rpy:6
translate de rom_thea_invite_5b9971e5:

    # THEA @ blush "I suppose I want to see what's so special."
    THEA @ blush "Ich nehme an, ich möchte sehen, was so besonders ist."

# game/data/world_romance/thea/rom_thea_scr.rpy:9
translate de rom_thea_invite_8737dc3f:

    # THEA @ blush "I would like that."
    THEA @ blush "Das würde ich gerne."

# game/data/world_romance/thea/rom_thea_scr.rpy:10
translate de rom_thea_invite_488d699c:

    # THEA @ smile "I'll be waiting for you there ..."
    THEA @ smile "Ich werde dort auf Sie warten ..."

# game/data/world_romance/thea/rom_thea_scr.rpy:16
translate de rom_thea_invite_aeabb3e0:

    # THEA @ talk "I-"
    THEA @ talk "Ich-"

# game/data/world_romance/thea/rom_thea_scr.rpy:17
translate de rom_thea_invite_51503df8:

    # THEA @ talk "Very well, let me know when you're more free, perhaps."
    THEA @ talk "Sehr gut, lassen Sie mich wissen, wenn Sie mehr Zeit haben, vielleicht."

# game/data/world_romance/thea/rom_thea_scr.rpy:23
translate de rom_thea_unicorn_12d98976:

    # MC "(I shouldn't bother her anymore tonight.)"
    MC "(Ich sollte sie heute Abend nicht mehr stören.)"

# game/data/world_romance/thea/rom_thea_scr.rpy:30
translate de rom_thea_unicorn_3345d6b7:

    # "When Thea saw me from across the room, she smiled and waved, coaxing me over."
    "Als Thea mich von der anderen Seite des Raumes sah, lächelte und winkte sie und lockte mich zu sich."

# game/data/world_romance/thea/rom_thea_scr.rpy:31
translate de rom_thea_unicorn_8a756982:

    # THEA @ talk "So glad you could make it."
    THEA @ talk "Schön, dass du es geschafft hast."

# game/data/world_romance/thea/rom_thea_scr.rpy:32
translate de rom_thea_unicorn_fc4b9d6f:

    # THEA @ smile "Come, join me for a while ..."
    THEA @ smile "Komm, leiste mir eine Weile Gesellschaft ..."

# game/data/world_romance/thea/rom_thea_scr.rpy:36
translate de rom_thea_unicorn_menu1_7429efc5:

    # THEA @ smile2 "Mmm, eager to spend all that coin you've earned adventuring, are you?"
    THEA @ smile2 "Mmm, du bist wohl ganz wild darauf, all das Geld auszugeben, das du beim Abenteuern verdient hast, was?"

# game/data/world_romance/thea/rom_thea_scr.rpy:37
translate de rom_thea_unicorn_menu1_432f2bae:

    # THEA @ smile "There's a nice wine bottle I've been eyeing up, {i}'Huville Cépage'{/i}"
    THEA @ smile "Da ist eine schöne Weinflasche, die ich schon länger im Auge habe, {i}'Huville Cépage'{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:38
translate de rom_thea_unicorn_menu1_2eadc668:

    # THEA @ talk "What do you say we share it?"
    THEA @ talk "Was sagst du, wollen wir sie teilen?"

# game/data/world_romance/thea/rom_thea_scr.rpy:45
translate de rom_thea_unicorn_menu2_c07e4cd5:

    # THEA @ smile2 "Oooh!"
    THEA @ smile2 "Oooh!"

# game/data/world_romance/thea/rom_thea_scr.rpy:46
translate de rom_thea_unicorn_menu2_c94f142b:

    # "I ordered for the bottle to be fetched, placing the small pouch of coins in Shay's hand as she grabbed it for us."
    "Ich ließ die Flasche kommen und legte den kleinen Münzbeutel in Shays Hand, als sie ihn für uns entgegennahm."

# game/data/world_romance/thea/rom_thea_scr.rpy:47
translate de rom_thea_unicorn_menu2_7eaabd57:

    # THEA @ smile "Cheers!"
    THEA @ smile "Prost!"

# game/data/world_romance/thea/rom_thea_scr.rpy:48
translate de rom_thea_unicorn_menu2_ce8ed3e8:

    # MC @ talk "So then, how does a girl like you end up running the Adventures Guild in Novaras?"
    MC @ talk "Und wie kommt es, dass ein Mädchen wie du die Abenteurergilde in Novaras leitet?"

# game/data/world_romance/thea/rom_thea_scr.rpy:49
translate de rom_thea_unicorn_menu2_8f95d09a:

    # THEA @ smile "Ahh ... good question!"
    THEA @ smile "Ahh ... gute Frage!"

# game/data/world_romance/thea/rom_thea_scr.rpy:50
translate de rom_thea_unicorn_menu2_9f46be7b:

    # THEA @ talk "My parents travelled to Alderay to settle when I was very young."
    THEA @ talk "Meine Eltern reisten nach Alderay, um sich dort niederzulassen, als ich sehr jung war."

# game/data/world_romance/thea/rom_thea_scr.rpy:51
translate de rom_thea_unicorn_menu2_e416d7df:

    # THEA @ talk "Back then, Alderay was welcoming skilled businesses and migrants, and the old owner of the guild house here was ready to retire."
    THEA @ talk "Damals hieß Alderay qualifizierte Unternehmen und Migranten willkommen, und der alte Besitzer des Gildenhauses hier war bereit, in den Ruhestand zu gehen."

# game/data/world_romance/thea/rom_thea_scr.rpy:52
translate de rom_thea_unicorn_menu2_b6c617a0:

    # THEA @ talk "So, we bought it off them, and the rest is history."
    THEA @ talk "Also kauften wir es ihnen ab, und der Rest ist Geschichte."

# game/data/world_romance/thea/rom_thea_scr.rpy:53
translate de rom_thea_unicorn_menu2_ac230468:

    # MC @ talk "Where did you come from originally?"
    MC @ talk "Woher stammst du ursprünglich?"

# game/data/world_romance/thea/rom_thea_scr.rpy:54
translate de rom_thea_unicorn_menu2_eb131af5:

    # THEA @ talk "Ah, my family comes from Ramon."
    THEA @ talk "Ah, meine Familie kommt aus Ramon."

# game/data/world_romance/thea/rom_thea_scr.rpy:55
translate de rom_thea_unicorn_menu2_12edaa55:

    # MC @ surprised "Ramon? But, you're-"
    MC @ surprised "Ramon? Aber du bist-"

# game/data/world_romance/thea/rom_thea_scr.rpy:56
translate de rom_thea_unicorn_menu2_7b41d1ba:

    # "I stopped myself from prodding too deeply, but Thea just smiled."
    "Ich hielt mich davon ab, zu sehr nachzuhaken, aber Thea lächelte nur."

# game/data/world_romance/thea/rom_thea_scr.rpy:57
translate de rom_thea_unicorn_menu2_44532423:

    # THEA @ smile "It's fine, people always ask about my complexion."
    THEA @ smile "Es ist in Ordnung, die Leute fragen immer nach meiner Hautfarbe."

# game/data/world_romance/thea/rom_thea_scr.rpy:58
translate de rom_thea_unicorn_menu2_4808f1cb:

    # THEA @ talk "You see, we all come from Ramon, but my people, the Khashan, come from the eastern side of the Darjan desert."
    THEA @ talk "Siehst du, wir alle kommen aus Ramon, aber mein Volk, die Khashan, stammt von der Ostseite der Darjan-Wüste."

# game/data/world_romance/thea/rom_thea_scr.rpy:59
translate de rom_thea_unicorn_menu2_8cc07133:

    # THEA @ talk "The first of us travelled to Alderay to avoid the many hardships of the land."
    THEA @ talk "Die ersten von uns reisten nach Alderay, um den vielen Härten des Landes zu entgehen."

# game/data/world_romance/thea/rom_thea_scr.rpy:60
translate de rom_thea_unicorn_menu2_f57c063a:

    # THEA @ talk "Unlike the West and South-Lands, the East of Ramon is a hard place to live ... Nothing truly grows beneath the scorched sun."
    THEA @ talk "Anders als die West- und Südländer ist der Osten von Ramon ein harter Ort zum Leben ... Unter der sengenden Sonne wächst wirklich nichts."

# game/data/world_romance/thea/rom_thea_scr.rpy:65
translate de rom_thea_unicorn_menu3_4b1f9620:

    # THEA @ talk "Hmm ... I miss the Darjan mountains, they stretched as far as the eye could see."
    THEA @ talk "Hmm ... Ich vermisse die Darjan-Berge, sie erstreckten sich, so weit das Auge reichte."

# game/data/world_romance/thea/rom_thea_scr.rpy:66
translate de rom_thea_unicorn_menu3_8fe065a0:

    # THEA @ talk "As barren and brutal a place as it was to live, it was quite beautiful."
    THEA @ talk "So karg und brutal der Ort zum Leben auch war, er war recht schön."

# game/data/world_romance/thea/rom_thea_scr.rpy:72
translate de rom_thea_unicorn_menu3_3dfa0b6a:

    # THEA @ angry "What's there to say? They're a greedy, ungrateful bunch."
    THEA @ angry "Was soll man sagen? Sie sind ein gieriger, undankbarer Haufen."

# game/data/world_romance/thea/rom_thea_scr.rpy:73
translate de rom_thea_unicorn_menu3_8742f5fd:

    # MC @ talk "That's ... surprising to hear."
    MC @ talk "Das ... ist überraschend zu hören."

# game/data/world_romance/thea/rom_thea_scr.rpy:74
translate de rom_thea_unicorn_menu3_93fcdb03:

    # THEA @ sad "Sorry, Ramonian politics is a difficult thing."
    THEA @ sad "Tut mir leid, die Politik von Ramon ist eine schwierige Sache."

# game/data/world_romance/thea/rom_thea_scr.rpy:75
translate de rom_thea_unicorn_menu3_06c01088:

    # THEA @ angry "Let's just say there are reasons we headed to Alderay and didn't just join our cousins in the West."
    THEA @ angry "Sagen wir einfach, es gibt Gründe, warum wir nach Alderay gegangen sind und uns nicht einfach unseren Vettern im Westen angeschlossen haben."

# game/data/world_romance/thea/rom_thea_scr.rpy:76
translate de rom_thea_unicorn_menu3_b488a395:

    # THEA @ angry "They spent years being the oppressors, and now expect sympathy when they wouldn't shed a tear for the rest of us."
    THEA @ angry "Sie waren jahrelang die Unterdrücker und erwarten jetzt Mitleid, obwohl sie keine Träne für den Rest von uns vergossen hätten."

# game/data/world_romance/thea/rom_thea_scr.rpy:82
translate de rom_thea_unicorn_menu3_dc53db05:

    # THEA @ smile "Ahh, it was ... different!"
    THEA @ smile "Ahh, es war ... anders!"

# game/data/world_romance/thea/rom_thea_scr.rpy:83
translate de rom_thea_unicorn_menu3_ce050630:

    # THEA @ talk "I grew up watching adventurers come and go."
    THEA @ talk "Ich bin aufgewachsen und habe zugesehen, wie Abenteurer kamen und gingen."

# game/data/world_romance/thea/rom_thea_scr.rpy:84
translate de rom_thea_unicorn_menu3_c48d55de:

    # THEA @ smile "I quickly learned to pick up which ones I thought had a chance of climbing the ranks, and I usually got pretty good predicting where their limit would be."
    THEA @ smile "Ich lernte schnell zu erkennen, von welchen ich dachte, dass sie die Chance hatten, in den Rängen aufzusteigen, und ich wurde meistens ziemlich gut darin, vorherzusagen, wo ihre Grenze liegen würde."

# game/data/world_romance/thea/rom_thea_scr.rpy:91
translate de rom_thea_unicorn_menu3_3328c8e0:

    # THEA @ smile "Where's the fun in telling you that?"
    THEA @ smile "Wo ist der Spaß dabei, dir das zu sagen?"

# game/data/world_romance/thea/rom_thea_scr.rpy:92
translate de rom_thea_unicorn_menu3_d535c815:

    # THEA @ smile2 "{i}... Surprise me.{/i}"
    THEA @ smile2 "{i}... Überrasch mich.{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:95
translate de rom_thea_unicorn_menu3_14af6c46:

    # THEA @ talk "Quite a few."
    THEA @ talk "Ziemlich viele."

# game/data/world_romance/thea/rom_thea_scr.rpy:96
translate de rom_thea_unicorn_menu3_96fa62ee:

    # THEA @ talk "Lohan the Great, Marhaka {i}'the silver arrow.'{/i}"
    THEA @ talk "Lohan der Große, Marhaka {i}'der silberne Pfeil.'{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:97
translate de rom_thea_unicorn_menu3_9561e086:

    # THEA @ sad "But that was all when I was still little."
    THEA @ sad "Aber das war alles, als ich noch klein war."

# game/data/world_romance/thea/rom_thea_scr.rpy:98
translate de rom_thea_unicorn_menu3_0679a78b:

    # THEA @ talk "There aren't really many names left who'd I'd think qualify as legendary these days."
    THEA @ talk "Heutzutage gibt es wirklich nicht mehr viele Namen, von denen ich denken würde, dass sie als legendär gelten."

# game/data/world_romance/thea/rom_thea_scr.rpy:99
translate de rom_thea_unicorn_menu3_13f5176a:

    # MC @ talk "What about Celeste?"
    MC @ talk "Und was ist mit Celeste?"

# game/data/world_romance/thea/rom_thea_scr.rpy:100
translate de rom_thea_unicorn_menu3_82af972f:

    # THEA @ sad "I-"
    THEA @ sad "Ich-"

# game/data/world_romance/thea/rom_thea_scr.rpy:101
translate de rom_thea_unicorn_menu3_f59122f5:

    # THEA @ sad "There's something about her I don't like ... But I can't put my finger on why."
    THEA @ sad "Da ist etwas an ihr, das ich nicht mag ... Aber ich kann nicht genau sagen, warum."

# game/data/world_romance/thea/rom_thea_scr.rpy:104
translate de rom_thea_unicorn_menu3_bccad9a6:

    # MC @ smile "So, why did you only agree to meet with me now?"
    MC @ smile "Warum hast du erst jetzt zugestimmt, dich mit mir zu treffen?"

# game/data/world_romance/thea/rom_thea_scr.rpy:105
translate de rom_thea_unicorn_menu3_612151ad:

    # "Thea smiled, twirling her hair."
    "Thea lächelte und wirbelte ihr Haar."

# game/data/world_romance/thea/rom_thea_scr.rpy:106
translate de rom_thea_unicorn_menu3_cef13fe0:

    # THEA @ smile "Well ... You see, the thing is."
    THEA @ smile "Nun ja ... Weißt du, die Sache ist die."

# game/data/world_romance/thea/rom_thea_scr.rpy:107
translate de rom_thea_unicorn_menu3_fcd2fdda:

    # THEA @ smile "I usually spent my time growing up watching adventurers flirt with my mother, and I guess it kinda rubbed off on me."
    THEA @ smile "Als ich aufwuchs, habe ich meistens damit verbracht, zuzusehen, wie Abenteurer mit meiner Mutter flirteten, und ich schätze, das hat irgendwie auf mich abgefärbt."

# game/data/world_romance/thea/rom_thea_scr.rpy:108
translate de rom_thea_unicorn_menu3_40e310f1:

    # MC @ talk "What about your father, though? He couldn't have liked that."
    MC @ talk "Aber was ist mit deinem Vater? Das kann ihm nicht gefallen haben."

# game/data/world_romance/thea/rom_thea_scr.rpy:109
translate de rom_thea_unicorn_menu3_8ff3ce86:

    # THEA @ talk "There wasn't a lot he could do, besides, Mother was just flirting to buy a few more rounds between quests."
    THEA @ talk "Es gab nicht viel, was er tun konnte, außerdem flirtete Mutter nur, um zwischen den Quests noch ein paar Runden auszugeben."

# game/data/world_romance/thea/rom_thea_scr.rpy:110
translate de rom_thea_unicorn_menu3_d0c386b6:

    # THEA @ blush "T-Though sometimes the adventurers did get a little 'handsy' with her, I suppose."
    THEA @ blush "O-Obwohl die Abenteurer manchmal ein wenig 'zudringlich' mit ihr wurden, nehme ich an."

# game/data/world_romance/thea/rom_thea_scr.rpy:111
translate de rom_thea_unicorn_menu3_40b97817:

    # THEA @ smile "But I'm sure she never let it go too far!"
    THEA @ smile "Aber ich bin sicher, sie hat es nie zu weit kommen lassen!"

# game/data/world_romance/thea/rom_thea_scr.rpy:112
translate de rom_thea_unicorn_menu3_55848778:

    # MC "(I think I'm beginning to see where this fetish of hers has come from)."
    MC "(Ich glaube, ich beginne zu verstehen, woher dieser Fetisch von ihr kommt)."

# game/data/world_romance/thea/rom_thea_scr.rpy:113
translate de rom_thea_unicorn_menu3_79def2ed:

    # THEA @ smile2 "So, how would you like to come back to mine this evening?"
    THEA @ smile2 "Also, wie würdest du es finden, heute Abend zu mir zu kommen?"

# game/data/world_romance/thea/rom_thea_scr.rpy:114
translate de rom_thea_unicorn_menu3_78109663:

    # THEA @ blush "I think I might have something to help {i}'motivate'{/i} you on your quests."
    THEA @ blush "Ich glaube, ich habe etwas, das dich bei deinen Quests {i}'motivieren'{/i} könnte."

# game/data/world_romance/thea/rom_thea_scr.rpy:117
translate de rom_thea_unicorn_menu3_7e4761fb:

    # THEA @ smile2 "Follow me."
    THEA @ smile2 "Folge mir."

# game/data/world_romance/thea/rom_thea_scr.rpy:120
translate de rom_thea_unicorn_menu3_ffc63a93:

    # THEA @ sad "Oh? Well ... Alright then."
    THEA @ sad "Oh? Nun... Also gut."

# game/data/world_romance/thea/rom_thea_scr.rpy:125
translate de rom_thea_unicorn_menu3_3b8245a4:

    # THEA @ smile "It is."
    THEA @ smile "Ist es."

# game/data/world_romance/thea/rom_thea_scr.rpy:126
translate de rom_thea_unicorn_menu3_31d970ec:

    # THEA @ smile2 "But do you think I'm worth it?"
    THEA @ smile2 "Aber glaubst du, ich bin es wert?"

# game/data/world_romance/thea/rom_thea_scr.rpy:132
translate de rom_thea_unicorn_menu3_10603dd0:

    # THEA @ sad "{i}*Sigh*{/i}... Never mind then."
    THEA @ sad "{i}*Seufz*{/i}... Dann eben nicht."

# game/data/world_romance/thea/rom_thea_scr.rpy:133
translate de rom_thea_unicorn_menu3_cc5378c3:

    # THEA @ talk "Mmm, don't you think you should at least buy a girl a drink first?"
    THEA @ talk "Mmm, findest du nicht, du solltest einem Mädchen wenigstens erst einen Drink spendieren?"

# game/data/world_romance/thea/rom_thea_scr.rpy:134
translate de rom_thea_unicorn_menu3_db87ce59:

    # THEA @ talk "You should definitely buy me one when you have some more coin... I'd love to hear more of your adventuring tales."
    THEA @ talk "Du solltest mir definitiv einen spendieren, wenn du etwas mehr Münzen hast... Ich würde gerne mehr deiner Abenteuergeschichten hören."

# game/data/world_romance/thea/rom_thea_scr.rpy:139
translate de rom_thea_unicorn_menu3_9a148b52:

    # THEA @ talk "Booo ..."
    THEA @ talk "Buh..."

# game/data/world_romance/thea/rom_thea_scr.rpy:140
translate de rom_thea_unicorn_menu3_06d4a6e1:

    # THEA @ smile "Well maybe next time then."
    THEA @ smile "Na dann vielleicht beim nächsten Mal."

# game/data/world_romance/thea/rom_thea_scr.rpy:153
translate de rom_thea_after_date_e86c7592:

    # "Thea led me back towards the Adventurers Guild, but this time, she led me behind the counter up the stairs towards her bedroom."
    "Thea führte mich zurück zur Abenteurergilde, aber dieses Mal führte sie mich hinter den Tresen die Treppe hinauf zu ihrem Schlafzimmer."

# game/data/world_romance/thea/rom_thea_scr.rpy:159
translate de rom_thea_after_date_6b744a36:

    # "Into her bedroom, Thea led me, quickly getting the fire going before she twirled around and smiled alluringly."
    "In ihr Schlafzimmer führte Thea mich, machte schnell das Feuer an, bevor sie sich herumwirbelte und verführerisch lächelte."

# game/data/world_romance/thea/rom_thea_scr.rpy:160
translate de rom_thea_after_date_cd42ee40:

    # MC @ smile "So then, what was it you wanted to give me?"
    MC @ smile "Also, was war es, das du mir geben wolltest?"

# game/data/world_romance/thea/rom_thea_scr.rpy:165
translate de rom_thea_after_date_e56d5240:

    # THEA @ smile "Ah, hello again... I trust you've been busy with all your adventures?"
    THEA @ smile "Ah, hallo nochmal... Ich nehme an, du warst beschäftigt mit all deinen Abenteuern?"

# game/data/world_romance/thea/rom_thea_scr.rpy:167
translate de rom_thea_after_date_6917aa30:

    # THEA @ talk "Do you mind waiting here for a moment, this will only take a few minutes."
    THEA @ talk "Macht es dir etwas aus, hier einen Moment zu warten? Das dauert nur ein paar Minuten."

# game/data/world_romance/thea/rom_thea_scr.rpy:168
translate de rom_thea_after_date_a3b52944:

    # MC @ smile "Of course."
    MC @ smile "Natürlich."

# game/data/world_romance/thea/rom_thea_scr.rpy:170
translate de rom_thea_after_date_2ecf6da7:

    # "Thea hurried off for a few moments, and after briefly looking around her room, the door swung open, and Thea re-emerged."
    "Thea eilte für ein paar Augenblicke davon, und nachdem ich mich kurz in ihrem Zimmer umgesehen hatte, schwang die Tür auf und Thea tauchte wieder auf."

# game/data/world_romance/thea/rom_thea_scr.rpy:174
translate de rom_thea_after_date_42fc426f:

    # THEA @ blush "{i}... Do you think 'this' will help motivate you?{/i}"
    THEA @ blush "{i}... Glaubst du, 'das' wird dir helfen, dich zu motivieren?{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:175
translate de rom_thea_after_date_4c4699f9:

    # MC @ lewd "I'm feeling motivated already."
    MC @ lewd "Ich fühle mich bereits motiviert."

# game/data/world_romance/thea/rom_thea_scr.rpy:178
translate de rom_thea_after_date_9c1a9a0d:

    # "Giggling to herself, Thea stepped forward and pushed me down onto her bed, moving swiftly to strip the clothes off of me."
    "Kichernd trat Thea vor und stieß mich auf ihr Bett, um mir schnell die Kleider vom Leib zu reißen."

# game/data/world_romance/thea/rom_thea_scr.rpy:179
translate de rom_thea_after_date_9fc4282e:

    # THEA "I've been working on a little ... {i}dance{/i} that I want to show you."
    THEA "Ich habe an einem kleinen ... {i}Tanz{/i} gearbeitet, den ich dir zeigen möchte."

# game/data/world_romance/thea/rom_thea_scr.rpy:180
translate de rom_thea_after_date_a092ffec:

