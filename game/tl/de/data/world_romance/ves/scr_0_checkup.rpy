# game/data/world_romance/ves/scr_0_checkup.rpy:2
translate de rom_Ves_0_checkup_48262153:

    # "Ves raised a curious eyebrow at my comment."
    "Ves hob eine neugierige Augenbraue bei meiner Bemerkung."

# game/data/world_romance/ves/scr_0_checkup.rpy:3
translate de rom_Ves_0_checkup_469dc015:

    # VES @ talk "... I’m fine."
    VES @ talk "... Mir geht es gut."

# game/data/world_romance/ves/scr_0_checkup.rpy:4
translate de rom_Ves_0_checkup_ed5670c3:

    # VES @ talk "Why do you ask, human?”"
    VES @ talk "Warum fragst du, Mensch?”"

# game/data/world_romance/ves/scr_0_checkup.rpy:5
translate de rom_Ves_0_checkup_a42cd6a3:

    # MC @ talk "Just out of concern, you’re out here all alone."
    MC @ talk "Nur aus Sorge, du bist hier ganz allein draußen."

# game/data/world_romance/ves/scr_0_checkup.rpy:6
translate de rom_Ves_0_checkup_c1e12f59:

    # MC @ talk "It’s not safe."
    MC @ talk "Es ist nicht sicher."

# game/data/world_romance/ves/scr_0_checkup.rpy:7
translate de rom_Ves_0_checkup_b340494c:

    # VES @ talk "... Where is safe for an orc in this land?"
    VES @ talk "... Wo ist es sicher für einen Ork in diesem Land?"

# game/data/world_romance/ves/scr_0_checkup.rpy:8
translate de rom_Ves_0_checkup_45eff587:

    # VES @ talk "I have survived this long... I will find my kin eventually and leave this empty place."
    VES @ talk "Ich habe so lange überlebt ... Ich werde meine Sippe irgendwann finden und diesen leeren Ort verlassen."

# game/data/world_romance/ves/scr_0_checkup.rpy:9
translate de rom_Ves_0_checkup_ed4c078c:

    # MC @ talk "And what if you don’t find them?"
    MC @ talk "Und was, wenn du sie nicht findest?"

# game/data/world_romance/ves/scr_0_checkup.rpy:10
translate de rom_Ves_0_checkup_744ae15a:

    # VES @ talk "I will."
    VES @ talk "Das werde ich."

# game/data/world_romance/ves/scr_0_checkup.rpy:11
translate de rom_Ves_0_checkup_62e7a458:

    # MC @ talk "But what if you {i}don’t?{/i}"
    MC @ talk "Aber was, wenn du {i}es nicht tust?{/i}"

# game/data/world_romance/ves/scr_0_checkup.rpy:12
translate de rom_Ves_0_checkup_ba851fe0:

    # VES @ talk "{i}Tsch...{/i} Why do you care what happens to an orc anyway?"
    VES @ talk "{i}Tsch...{/i} Warum kümmert es dich überhaupt, was mit einem Ork passiert?"

# game/data/world_romance/ves/scr_0_checkup.rpy:13
translate de rom_Ves_0_checkup_7d0e199f:

    # VES @ talk "Humans and orcs do not mix."
    VES @ talk "Menschen und Orks vertragen sich nicht."

# game/data/world_romance/ves/scr_0_checkup.rpy:14
translate de rom_Ves_0_checkup_5c4216b3:

    # MC @ talk "You weren’t complaining when we saved you the other day."
    MC @ talk "Du hast dich nicht beschwert, als wir dich neulich gerettet haben."

# game/data/world_romance/ves/scr_0_checkup.rpy:15
translate de rom_Ves_0_checkup_129b2aec:

    # "Ves growled menacingly at the comment."
    "Ves knurrte bedrohlich bei der Bemerkung."

# game/data/world_romance/ves/scr_0_checkup.rpy:16
translate de rom_Ves_0_checkup_26e75fc3:

    # VES @ talk "First off, you didn’t {i}save{/i} me."
    VES @ talk "Erstens, du hast mich nicht {i}gerettet{/i}."

# game/data/world_romance/ves/scr_0_checkup.rpy:17
translate de rom_Ves_0_checkup_40079bd4:

    # VES @ talk "I could have handled that just fine on my own."
    VES @ talk "Ich hätte das auch alleine gut geschafft."

# game/data/world_romance/ves/scr_0_checkup.rpy:18
translate de rom_Ves_0_checkup_c6813cab:

    # MC @ talk "... I didn’t come here to fight."
    MC @ talk "... Ich bin nicht hergekommen, um zu kämpfen."

# game/data/world_romance/ves/scr_0_checkup.rpy:19
translate de rom_Ves_0_checkup_2592e15a:

    # VES @ talk "Then why did you come here?"
    VES @ talk "Warum bist du dann hergekommen?"

# game/data/world_romance/ves/scr_0_checkup.rpy:20
translate de rom_Ves_0_checkup_cefa8f2f:

    # "Ves pointed her axe towards me."
    "Ves richtete ihre Axt auf mich."

# game/data/world_romance/ves/scr_0_checkup.rpy:21
translate de rom_Ves_0_checkup_f49d81a0:

    # VES @ talk "You may not be fully human..."
    VES @ talk "Du bist vielleicht nicht ganz menschlich..."

# game/data/world_romance/ves/scr_0_checkup.rpy:22
translate de rom_Ves_0_checkup_d48f8d2a:

    # VES @ talk "But I’ve come to know the ways of man."
    VES @ talk "Aber ich habe die Wege der Menschen kennengelernt."

# game/data/world_romance/ves/scr_0_checkup.rpy:23
translate de rom_Ves_0_checkup_35d87cd4:

    # VES @ talk "You’ll be no different to the rest of them."
    VES @ talk "Du wirst nicht anders sein als der Rest von ihnen."

# game/data/world_romance/ves/scr_0_checkup.rpy:24
translate de rom_Ves_0_checkup_32a697de:

    # MC @ talk "... Do you need some hel— "
    MC @ talk "... Brauchst du etwas Hil—"

# game/data/world_romance/ves/scr_0_checkup.rpy:25
translate de rom_Ves_0_checkup_56c871d8:

    # VES @ talk "No."
    VES @ talk "Nein."

# game/data/world_romance/ves/scr_0_checkup.rpy:26
translate de rom_Ves_0_checkup_2be4cc67:

    # "Rising from her feet, Ves stretched and sauntered out the tent with her axe in hand, barging past my shoulder as she remarked."
    "Von ihren Füßen aufstehend, streckte sich Ves und schlenderte mit ihrer Axt in der Hand aus dem Zelt, wobei sie an meiner Schulter vorbeidrängte, während sie bemerkte."

# game/data/world_romance/ves/scr_0_checkup.rpy:27
translate de rom_Ves_0_checkup_c025746f:

    # VES @ talk "You’ve seen that I am well... Now {i}leave.{/i}"
    VES @ talk "Du hast gesehen, dass es mir gut geht... Jetzt {i}verschwinde.{/i}"

# game/data/world_romance/ves/scr_0_checkup.rpy:30
translate de rom_Ves_0_checkup_5664a9d7:

    # "With that, I watched as Ves made her way alone across the dunes of the Valley of Death, slowly disappearing into the distant blistering waves of heat."
    "Daraufhin sah ich, wie Ves allein über die Dünen des Tals des Todes zog, langsam in den fernen, sengenden Hitzewellen verschwand."

# game/data/world_romance/ves/scr_0_checkup.rpy:31
translate de rom_Ves_0_checkup_f0a51a0c:

    # "I called after her, asking where she was going, and she turned, still walking backwards as she cried out ‘to hunt!’ And like that, she was gone... Leaving me alone in the swirling hot sands of her campsite."
    "Ich rief ihr hinterher und fragte, wohin sie gehe, und sie drehte sich um, während sie rückwärts weiterging und rief: 'Jagen!' Und so war sie fort... Mich allein im wirbelnden heißen Sand ihres Lagerplatzes zurücklassend."

# game/data/world_romance/ves/scr_0_checkup.rpy:32
translate de rom_Ves_0_checkup_1343e993:

    # MC @ talk "(... Well... That could have gone better.) "
    MC @ talk "(... Nun ja... Das hätte besser laufen können.)"

# game/data/world_romance/ves/scr_0_checkup.rpy:33
translate de rom_Ves_0_checkup_fdc78933:

    # MC @ talk "(Maybe I should check on her another time?)"
    MC @ talk "(Vielleicht sollte ich ein andermal nach ihr sehen?)"

