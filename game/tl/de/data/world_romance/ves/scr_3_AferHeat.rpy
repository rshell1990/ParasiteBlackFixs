# game/data/world_romance/ves/scr_3_AferHeat.rpy:4
translate de rom_Ves_3_AfterHeat_b7d400f5:

    # "I found Ves sat rather sombrely on a rock as she inspected the fang-toothed necklace she usually wore, gently running her fingers along it."
    "Ich fand Ves eher düster auf einem Felsen sitzen, während sie die Halskette mit den Fangzähnen, die sie normalerweise trug, inspizierte und sanft mit den Fingern darüber strich."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:7
translate de rom_Ves_3_AfterHeat_f4884dab:

    # VES @ sad_talk "... I didn’t think you’d come back."
    VES @ sad_talk "... Ich dachte nicht, dass du zurückkommen würdest."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:8
translate de rom_Ves_3_AfterHeat_92817a56:

    # MC @ talk "I’m a glutton for punishment."
    MC @ talk "Ich bin ein Masochist."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:9
translate de rom_Ves_3_AfterHeat_f30a46bb:

    # VES @ sad_talk "... Do you know what this is?"
    VES @ sad_talk "... Weißt du, was das ist?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:10
translate de rom_Ves_3_AfterHeat_edcc99e9:

    # "Ves dangled the necklace in front of me."
    "Ves ließ die Halskette vor mir baumeln."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:11
translate de rom_Ves_3_AfterHeat_64e756eb:

    # MC @ talk "I take it it’s something important to you?"
    MC @ talk "Ich nehme an, es ist etwas, das dir wichtig ist?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:12
translate de rom_Ves_3_AfterHeat_20b900d5:

    # VES @ sad_talk "I was smuggled away when I was just a baby by the other tribes."
    VES @ sad_talk "Ich wurde von den anderen Stämmen weggeschmuggelt, als ich noch ein Baby war."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:13
translate de rom_Ves_3_AfterHeat_1c02388f:

    # VES @ sad_talk "This is the only thing of my mother’s I have left."
    VES @ sad_talk "Das ist das Einzige, was mir von meiner Mutter geblieben ist."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:14
translate de rom_Ves_3_AfterHeat_aa290b42:

    # MC sad "..."
    MC sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:15
translate de rom_Ves_3_AfterHeat_fde1246b:

    # "Ves turned to look at me with sullen eyes."
    "Ves drehte sich um und sah mich mit finsteren Augen an."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:16
translate de rom_Ves_3_AfterHeat_559624de:

    # VES @ sad_talk "Both of my parents were slaves."
    VES @ sad_talk "Beide meiner Eltern waren Sklaven."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:17
translate de rom_Ves_3_AfterHeat_fca7a546:

    # VES @ sad_talk "After giving birth to me, my mother was beaten and raped by the master’s right-hand man, a man named Lavak... She died shortly afterwards."
    VES @ sad_talk "Nach meiner Geburt wurde meine Mutter vom rechten Hand des Meisters, einem Mann namens Lavak, geschlagen und vergewaltigt... Sie starb kurz darauf."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:18
translate de rom_Ves_3_AfterHeat_9f648ae6:

    # VES @ sad_talk "My father was killed when he tried to protect her."
    VES @ sad_talk "Mein Vater wurde getötet, als er versuchte, sie zu beschützen."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:19
translate de rom_Ves_3_AfterHeat_ebc8397b:

    # MC @ sad "... Ves."
    MC @ sad "... Ves."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:20
translate de rom_Ves_3_AfterHeat_7272ceaa:

    # VES @ sad_talk "My tribe is all I have left, but the thought of {i}vengeance{/i} has kept me alive so far."
    VES @ sad_talk "Mein Stamm ist alles, was mir noch bleibt, aber der Gedanke an {i}Rache{/i} hat mich bisher am Leben gehalten."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:24
translate de rom_Ves_3_AfterHeat_7ddac0a5:

    # MC @ talk "... There is no redeeming monsters like that."
    MC @ talk "... Es gibt keine Erlösung für solche Monster."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:25
translate de rom_Ves_3_AfterHeat_b1ff3d7a:

    # MC @ talk "What they did was... {i}unforgivable.{/i}"
    MC @ talk "Was sie getan haben, war... {i}unverzeihlich.{/i}"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:26
translate de rom_Ves_3_AfterHeat_4f90784e:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:27
translate de rom_Ves_3_AfterHeat_1114e285:

    # MC @ talk "Ves, you will have your vengeance."
    MC @ talk "Ves, du wirst deine Rache bekommen."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:28
translate de rom_Ves_3_AfterHeat_b3c4eb96:

    # VES @ talk "... How do you know?"
    VES @ talk "... Woher weißt du das?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:29
translate de rom_Ves_3_AfterHeat_c25c53b8:

    # MC @ talk "{i}Because I’ll help you.{/i}"
    MC @ talk "{i}Weil ich dir helfen werde.{/i}"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:32
translate de rom_Ves_3_AfterHeat_da215aef:

    # MC @ talk "... Vengeance won’t bring them back and it won’t heal the wounds left, Ves."
    MC @ talk "... Rache wird sie nicht zurückbringen und sie wird die hinterlassenen Wunden nicht heilen, Ves."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:33
translate de rom_Ves_3_AfterHeat_4f90784e_1:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:34
translate de rom_Ves_3_AfterHeat_fcfcfbc0:

    # MC @ talk "You have to be better than them... You’re not a cold-blooded killer."
    MC @ talk "Du musst besser sein als sie... Du bist kein kaltblütiger Mörder."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:35
translate de rom_Ves_3_AfterHeat_9740dc5f:

    # VES @ talk "What makes you so sure of that?"
    VES @ talk "Was macht dich da so sicher?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:36
translate de rom_Ves_3_AfterHeat_8bd8ab3f:

    # VES @ talk "What makes you think I don’t intend to cut down THEIR women and children like they did to ours?"
    VES @ talk "Was lässt dich denken, dass ich nicht vorhabe, IHRE Frauen und Kinder niederzumetzeln, wie sie es mit unseren getan haben?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:37
translate de rom_Ves_3_AfterHeat_afceff91:

    # VES @ talk "Like they did to MY family?"
    VES @ talk "Wie sie es mit MEINER Familie getan haben?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:38
translate de rom_Ves_3_AfterHeat_db6839b5:

    # MC @ talk "Because, Ves, I’ll help you bring them to justice... But I won’t help you become a monster yourself."
    MC @ talk "Weil, Ves, ich dir helfen werde, sie vor Gericht zu bringen... Aber ich werde dir nicht helfen, selbst ein Monster zu werden."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:39
translate de rom_Ves_3_AfterHeat_ca8f6395:

    # MC @ talk "You need to be better than them."
    MC @ talk "Du musst besser sein als sie."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:40
translate de rom_Ves_3_AfterHeat_550c9aed:

    # VES @ angry_talk "Why?"
    VES @ angry_talk "Warum?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:41
translate de rom_Ves_3_AfterHeat_cf3fda9d:

    # VES @ angry_talk "There has been no justice for my people! Why must I be better than them? What have they done to deserve that?"
    VES @ angry_talk "Es gab keine Gerechtigkeit für mein Volk! Warum muss ich besser sein als sie? Was haben sie getan, um das zu verdienen?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:42
translate de rom_Ves_3_AfterHeat_e80284ea:

    # VES @ angry_talk "Why should I not just inflict on them the suffering they have inflicted on others? "
    VES @ angry_talk "Warum sollte ich ihnen nicht einfach das Leid zufügen, das sie anderen zugefügt haben?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:43
translate de rom_Ves_3_AfterHeat_26543181:

    # MC @ talk "Because, Ves, vengeance is a fleeting thing... As soon as you have it, it’s over."
    MC @ talk "Weil, Ves, Rache eine flüchtige Sache ist... Sobald du sie hast, ist es vorbei."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:44
translate de rom_Ves_3_AfterHeat_575e87ea:

    # MC @ talk "Justice is meant to be more than that though."
    MC @ talk "Gerechtigkeit soll aber mehr sein als das."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:45
translate de rom_Ves_3_AfterHeat_47c29c9a:

    # MC @ talk "It’s about making them answer for their crimes and letting the world know the truth of what they did so that history cannot repeat itself."
    MC @ talk "Es geht darum, sie für ihre Verbrechen zur Rechenschaft zu ziehen und die Welt die Wahrheit über das, was sie getan haben, wissen zu lassen, damit sich die Geschichte nicht wiederholen kann."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:46
translate de rom_Ves_3_AfterHeat_2a634cce:

    # VES @ talk "... Hmph. I will think on your words."
    VES @ talk "... Hmph. Ich werde über deine Worte nachdenken."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:47
translate de rom_Ves_3_AfterHeat_0d71c69a:

    # MC @ talk "I’m glad to hear that."
    MC @ talk "Das freut mich zu hören."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:48
translate de rom_Ves_3_AfterHeat_612727b6:

    # VES @ talk "... You are a strange human."
    VES @ talk "... Du bist ein seltsamer Mensch."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:49
translate de rom_Ves_3_AfterHeat_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:50
translate de rom_Ves_3_AfterHeat_28bf2f6f:

    # VES @ talk "But I don’t think you’re a bad one."
    VES @ talk "Aber ich glaube nicht, dass du ein schlechter bist."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:52
translate de rom_Ves_3_AfterHeat_4a4febb6:

    # VES @ talk "... You know you don’t have to help me with this, right?"
    VES @ talk "... Du weißt, dass du mir damit nicht helfen musst, oder?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:53
translate de rom_Ves_3_AfterHeat_d595c4f8:

    # VES @ talk "I don’t even know when... {i}if{/i} I’ll ever get a chance to return to Skarshire again..."
    VES @ talk "Ich weiß nicht einmal, wann... {i}falls{/i} ich jemals die Gelegenheit bekommen werde, wieder nach Skarshire zurückzukehren..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:54
translate de rom_Ves_3_AfterHeat_ab2f88eb:

    # MC @ talk "{i}When{/i} we do, Ves, I promise you you’ll get your chance..."
    MC @ talk "{i}Wenn{/i} wir es tun, Ves, verspreche ich dir, dass du deine Chance bekommst..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:55
translate de rom_Ves_3_AfterHeat_58ad8d11:

    # "Ves stared awkwardly down at the sand before her wide, glassy eyes looked up to stare into mine."
    "Ves starrte verlegen auf den Sand hinab, bevor ihre großen, glasigen Augen aufblickten, um in meine zu schauen."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:60
translate de rom_Ves_3_AfterHeat_b0e01b52:

    # "Suddenly, without saying a word she lunged forward from her spot to hug me tightly."
    "Plötzlich, ohne ein Wort zu sagen, stürzte sie von ihrem Platz nach vorne, um mich fest zu umarmen."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:61
translate de rom_Ves_3_AfterHeat_b908e1e2:

    # "Gently, I wrapped my arms slowly around her, at the sudden affection before she shyly pulled back and looked at me again."
    "Sanft legte ich langsam meine Arme um sie, bei der plötzlichen Zuneigung, bevor sie schüchtern zurückzog und mich wieder ansah."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:66
translate de rom_Ves_3_AfterHeat_b9152cde:

    # VES @ talk "You... Most humans would have run away at the very sight of me."
    VES @ talk "Du... Die meisten Menschen wären bei meinem bloßen Anblick weggelaufen."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:67
translate de rom_Ves_3_AfterHeat_cf8239fd:

    # VES @ talk "Why did you not?"
    VES @ talk "Warum hast du es nicht getan?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:68
translate de rom_Ves_3_AfterHeat_f74f06a2:

    # VES @ talk "To be an orc is to be an ugly thing..."
    VES @ talk "Ein Ork zu sein bedeutet, ein hässliches Ding zu sein..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:75
translate de rom_Ves_3_AfterHeat_3b48b116:

    # "Ves cheeks flushed red as my finger and thumb gently cupped under her chin. Nervously, she stepped back, her eyes darting towards the sand. "
    "Ves' Wangen erröteten, als mein Finger und Daumen sanft ihr Kinn umfassten. Nervös trat sie zurück, ihre Augen huschten zum Sand."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:76
translate de rom_Ves_3_AfterHeat_5d5c96a8:

    # VES @ talk "I... I have things I need to prepare for the next hunt! "
    VES @ talk "Ich... ich habe Dinge, die ich für die nächste Jagd vorbereiten muss!"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:77
translate de rom_Ves_3_AfterHeat_afacf1f3:

    # VES @ talk "Leave me! Come back another time!"
    VES @ talk "Lass mich! Komm ein anderes Mal wieder!"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:79
translate de rom_Ves_3_AfterHeat_0fe2cec9:

    # "I reached out to stop her, but Ves had already scarpered off into the tent, and seemingly wasn’t coming out again. "
    "Ich streckte die Hand aus, um sie aufzuhalten, aber Ves war bereits ins Zelt geflitzt und schien nicht wieder herauszukommen."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:81
translate de rom_Ves_3_AfterHeat_34a3c8ba:

    # VES @ talk "I... I thank you."
    VES @ talk "Ich... ich danke dir."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:82
translate de rom_Ves_3_AfterHeat_1e125e35:

    # VES @ talk "gradually slipped out from my arms."
    VES @ talk "glitt allmählich aus meinen Armen."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:83
translate de rom_Ves_3_AfterHeat_a267d18a:

    # VES @ talk "Perhaps... Just perhaps..."
    VES @ talk "Vielleicht... nur vielleicht..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:84
translate de rom_Ves_3_AfterHeat_c53302ea:

    # VES @ talk "{i}Not all{/i} of you are bad."
    VES @ talk "{i}Nicht alle{/i} von euch sind schlecht."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:86
translate de rom_Ves_3_AfterHeat_38f3f17f:

    # "Ves smiled, her eyes seeming to well up slightly as she solemnly dragged herself back into her tent."
    "Ves lächelte, ihre Augen schienen ein wenig feucht zu werden, während sie sich feierlich zurück in ihr Zelt schleppte."

translate de strings:

    # game/data/world_romance/ves/scr_3_AferHeat.rpy:23
    old "Promise Ves her vengeance."
    new "Versprich Ves deine Rache."

    # game/data/world_romance/ves/scr_3_AferHeat.rpy:31
    old "Tell Ves she should seek justice, not vengeance."
    new "Sag Ves, sie soll Gerechtigkeit suchen, nicht Rache."

    # game/data/world_romance/ves/scr_3_AferHeat.rpy:70
    old "Ves... You are a {i}beautiful{/i} thing..."
    new "Ves... Du bist ein {i}wunderschönes{/i} Ding..."

    # game/data/world_romance/ves/scr_3_AferHeat.rpy:80
    old "It’s not my place to judge you."
    new "Es steht mir nicht zu, dich zu verurteilen."

