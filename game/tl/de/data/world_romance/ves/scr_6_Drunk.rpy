    MC @ talk "Ich weiß nicht, was."

# game/data/world_romance/ves/scr_6_Drunk.rpy:126
translate de rom_Ves_6_Drunk_cf401c13:

    # VES @ talk "So... You and this other human friend of yours, Marcus... Are you close?"
    VES @ talk "Also... Du und dieser andere menschliche Freund von dir, Marcus... Steht ihr euch nahe?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:127
translate de rom_Ves_6_Drunk_9c9de6c1:

    # MC @ talk "Like brothers... We’ve known each other since we were little."
    MC @ talk "Wie Brüder... Wir kennen uns, seit wir klein waren."

# game/data/world_romance/ves/scr_6_Drunk.rpy:128
translate de rom_Ves_6_Drunk_824d1dca:

    # VES @ talk "He is... different to you."
    VES @ talk "Er ist... anders als du."

# game/data/world_romance/ves/scr_6_Drunk.rpy:129
translate de rom_Ves_6_Drunk_ade481c7:

    # MC @ talk "He’s a good man."
    MC @ talk "Er ist ein guter Mann."

# game/data/world_romance/ves/scr_6_Drunk.rpy:130
translate de rom_Ves_6_Drunk_2be47c87:

    # MC @ talk "But he’s got his issues, even before the fighting, I think."
    MC @ talk "Aber er hat seine Probleme, schon vor den Kämpfen, glaube ich."

# game/data/world_romance/ves/scr_6_Drunk.rpy:131
translate de rom_Ves_6_Drunk_72fcfee0:

    # VES @ talk "... So, how did you become warriors?"
    VES @ talk "... Also, wie seid ihr Krieger geworden?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:132
translate de rom_Ves_6_Drunk_e268bbee:

    # MC @ talk "We didn’t get much say in the matter..."
    MC @ talk "Wir hatten nicht viel Mitspracherecht in der Angelegenheit..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:133
translate de rom_Ves_6_Drunk_7a4b33f3:

    # MC @ talk "Called up to be part of the noble Scouts."
    MC @ talk "Einberufen, um Teil der edlen Späher zu sein."

# game/data/world_romance/ves/scr_6_Drunk.rpy:134
translate de rom_Ves_6_Drunk_6347eb66:

    # VES @ talk "You didn’t choose to become a warrior?"
    VES @ talk "Ihr habt euch nicht entschieden, Krieger zu werden?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:135
translate de rom_Ves_6_Drunk_d4498740:

    # VES @ talk "Surely this is a great honour!"
    VES @ talk "Sicherlich ist das eine große Ehre!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:136
translate de rom_Ves_6_Drunk_829f86a7:

    # MC @ talk "Not to us..."
    MC @ talk "Nicht für uns..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:137
translate de rom_Ves_6_Drunk_ced6b3ea:

    # VES @ talk "... I don’t understand."
    VES @ talk "... Ich verstehe nicht."

# game/data/world_romance/ves/scr_6_Drunk.rpy:138
translate de rom_Ves_6_Drunk_3cb19faa:

    # MC @ talk "There’s no glory dying in some wretched field for a pointless skirmish watching as your friends are being slaughtered around you."
    MC @ talk "Es gibt keinen Ruhm, auf einem elenden Feld für ein sinnloses Scharmützel zu sterben und dabei zuzusehen, wie eure Freunde um euch herum abgeschlachtet werden."

# game/data/world_romance/ves/scr_6_Drunk.rpy:139
translate de rom_Ves_6_Drunk_2384c6dc:

    # MC @ talk "Dying for SOMETHING, for ANYTHING would make it better..."
    MC @ talk "Für ETWAS, für IRGENDETWAS zu sterben, würde es besser machen..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:140
translate de rom_Ves_6_Drunk_4d97dec6:

    # MC @ talk "More bearable."
    MC @ talk "Ertragbarer."

# game/data/world_romance/ves/scr_6_Drunk.rpy:141
translate de rom_Ves_6_Drunk_2ac5b574:

    # MC @ talk "But most of us would just die unceremoniously, in cruel, painful deaths with no one to remember... or even care that we’re gone or what our mission even was in the first place."
    MC @ talk "Aber die meisten von uns würden einfach unrühmlich sterben, in grausamen, schmerzhaften Toden, ohne dass sich jemand erinnert ... oder sich überhaupt darum kümmert, dass wir nicht mehr da sind oder was unsere Mission überhaupt war."

# game/data/world_romance/ves/scr_6_Drunk.rpy:142
translate de rom_Ves_6_Drunk_4999deb8:

    # VES @ talk "..."
    VES @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:143
translate de rom_Ves_6_Drunk_d0ba7df3:

    # MC @ talk "Praying... always praying you’d somehow get home... Praying you’d never have to venture beyond those walls again."
    MC @ talk "Beten ... immer beten, dass du irgendwie nach Hause kommst ... Beten, dass du nie wieder hinter diese Mauern vordringen musst."

# game/data/world_romance/ves/scr_6_Drunk.rpy:144
translate de rom_Ves_6_Drunk_74b54e64:

    # VES @ talk "... And yet, here you are!"
    VES @ talk "... Und trotzdem, hier bist du!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:145
translate de rom_Ves_6_Drunk_8b056b19:

    # VES @ smile_talk "Made stronger by surviving beyond the walls!"
    VES @ smile_talk "Stärker gemacht durch das Überleben jenseits der Mauern!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:146
translate de rom_Ves_6_Drunk_dc6c7127:

    # MC @ talk "... Yeah, I suppose so."
    MC @ talk "... Ja, das nehme ich an."

# game/data/world_romance/ves/scr_6_Drunk.rpy:147
translate de rom_Ves_6_Drunk_690c0c4e:

    # VES @ talk "And you and I would never have met if you were still too afraid to leave the safety of your walls."
    VES @ talk "Und du und ich hätten uns niemals getroffen, wenn du immer noch zu viel Angst gehabt hättest, die Sicherheit deiner Mauern zu verlassen."

# game/data/world_romance/ves/scr_6_Drunk.rpy:148
translate de rom_Ves_6_Drunk_6c282d37:

    # MC @ talk "... Me and Marcus only survived because of {i}what happened...{/i}"
    MC @ talk "... Marcus und ich haben nur überlebt, wegen dem, {i}was passiert ist ...{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:149
translate de rom_Ves_6_Drunk_e6596336:

    # MC @ talk "For anyone else, they’d be..."
    MC @ talk "Für jeden anderen wären sie ..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:150
translate de rom_Ves_6_Drunk_5e6d1b2b:

    # "Ves’ hand moved to shush my lips."
    "Ves' Hand bewegte sich, um mich zum Schweigen zu bringen."

# game/data/world_romance/ves/scr_6_Drunk.rpy:151
translate de rom_Ves_6_Drunk_bd2d8643:

    # VES @ talk "And yet, {i}you live to fight another day...{/i}"
    VES @ talk "Und doch, {i}lebst du, um ein andermal zu kämpfen...{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:152
translate de rom_Ves_6_Drunk_b5181c29:

    # VES @ talk "This is what matters."
    VES @ talk "Das ist, was zählt."

# game/data/world_romance/ves/scr_6_Drunk.rpy:153
translate de rom_Ves_6_Drunk_30ecfac2:

    # VES @ talk "O’rlarak commands you to live and fight on. For those who were not so fortunate. For those who have been denied what you have."
    VES @ talk "O’rlarak befiehlt dir zu leben und weiterzukämpfen. Für die, die nicht so glücklich waren. Für die, denen verwehrt wurde, was du hast."

# game/data/world_romance/ves/scr_6_Drunk.rpy:154
translate de rom_Ves_6_Drunk_6bede656:

    # MC @ talk "O’rlarak?"
    MC @ talk "O’rlarak?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:155
translate de rom_Ves_6_Drunk_30eba78e:

    # VES @ talk "{i}The greatest of all chiefs who now reigns in the sky.{/i}"
    VES @ talk "{i}Der größte aller Häuptlinge, der nun im Himmel herrscht.{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:156
translate de rom_Ves_6_Drunk_a7615141:

    # MC @ talk "... Ves..."
    MC @ talk "... Ves..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:157
translate de rom_Ves_6_Drunk_c03a963b:

    # VES @ talk "To my people, to die in battle protecting those we love... those we care for..."
    VES @ talk "Für mein Volk, im Kampf zu sterben, um die zu schützen, die wir lieben... die, für die wir sorgen..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:158
translate de rom_Ves_6_Drunk_e9ffc2f1:

    # VES @ talk "There is no better way to die."
    VES @ talk "Es gibt keine bessere Art zu sterben."

# game/data/world_romance/ves/scr_6_Drunk.rpy:161
translate de rom_Ves_6_Drunk_b9fc2750:

    # VES @ talk "... Strange."
    VES @ talk "... Seltsam."

# game/data/world_romance/ves/scr_6_Drunk.rpy:162
translate de rom_Ves_6_Drunk_e6ddc3fe:

    # MC @ talk "What, why is that strange?"
    MC @ talk "Was, warum ist das seltsam?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:163
translate de rom_Ves_6_Drunk_c667afcd:

    # VES @ talk "Most orcs see life as a short arrangement... A brief deal with the Great Chiefs paid for in blood."
    VES @ talk "Die meisten Orks sehen das Leben als eine kurze Vereinbarung ... Ein kurzer Pakt mit den Großen Häuptlingen, bezahlt mit Blut."

# game/data/world_romance/ves/scr_6_Drunk.rpy:164
translate de rom_Ves_6_Drunk_02e3c328:

    # VES @ talk "We are prepared to die from the day we are born."
    VES @ talk "Wir sind vom Tag unserer Geburt an bereit zu sterben."

# game/data/world_romance/ves/scr_6_Drunk.rpy:165
translate de rom_Ves_6_Drunk_f9f2d041:

    # VES @ talk "But you see it as lasting... {i}longer.{/i}"
    VES @ talk "Aber du siehst es als dauerhaft ... {i}länger.{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:166
translate de rom_Ves_6_Drunk_366f724b:

    # MC @ talk "There’s more to life than death, Ves."
    MC @ talk "Es gibt mehr im Leben als den Tod, Ves."

# game/data/world_romance/ves/scr_6_Drunk.rpy:167
translate de rom_Ves_6_Drunk_3292e2bf:

    # VES @ talk "... I’d like you to show me this one day."
    VES @ talk "... Ich möchte, dass du mir das eines Tages zeigst."

# game/data/world_romance/ves/scr_6_Drunk.rpy:169
translate de rom_Ves_6_Drunk_6d5279b0:

    # VES @ talk "A brothel?"
    VES @ talk "Ein Bordell?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:170
translate de rom_Ves_6_Drunk_fd6d73ae:

    # MC @ smile "It’s... Never mind."
    MC @ smile "Es ist ... Schon gut."

# game/data/world_romance/ves/scr_6_Drunk.rpy:171
translate de rom_Ves_6_Drunk_a5781452:

    # VES @ talk "What kind of place is that?"
    VES @ talk "Was für ein Ort ist das?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:172
translate de rom_Ves_6_Drunk_331874a8:

    # MC @ talk "It’s a place where humans pay to have sex."
    MC @ talk "Es ist ein Ort, an dem Menschen für Sex bezahlen."

# game/data/world_romance/ves/scr_6_Drunk.rpy:173
translate de rom_Ves_6_Drunk_7926c541:

    # VES @ talk "... Humans... {i}pay{/i} to have sex?"
    VES @ talk "... Menschen ... {i}bezahlen{/i} für Sex?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:174
translate de rom_Ves_6_Drunk_b9f291e3:

    # VES @ talk "Do you not have matriarchs?"
    VES @ talk "Habt ihr keine Matriarchinnen?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:175
translate de rom_Ves_6_Drunk_3eb7e210:

    # MC @ talk "Uhh, what?"
    MC @ talk "Hä, was?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:176
translate de rom_Ves_6_Drunk_26d490a6:

    # VES @ talk "Every tribe has a few matriarchs... Women devoted just to breeding."
    VES @ talk "Jeder Stamm hat ein paar Matriarchinnen ... Frauen, die sich nur der Fortpflanzung widmen."

# game/data/world_romance/ves/scr_6_Drunk.rpy:177
translate de rom_Ves_6_Drunk_14252312:

    # MC @ talk "Wait, what?!"
    MC @ talk "Moment, was?!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:178
translate de rom_Ves_6_Drunk_660ccc51:

    # VES @ talk "A great number of orcs die young or in battle... Numbers need to be replenished quickly or we risk extinction."
    VES @ talk "Eine große Zahl Orks stirbt jung oder im Kampf ... Die Zahl muss schnell wieder aufgefüllt werden, sonst riskieren wir das Aussterben."

# game/data/world_romance/ves/scr_6_Drunk.rpy:179
translate de rom_Ves_6_Drunk_64d864e1:

    # VES @ talk "Matriarchs can even request to break in newly bonded husbands."
    VES @ talk "Matriarchinnen können sogar darum bitten, frisch verbundene Ehemänner einzuweihen."

# game/data/world_romance/ves/scr_6_Drunk.rpy:180
translate de rom_Ves_6_Drunk_8c056903:

    # MC @ talk "How do the wives feel about that?"
    MC @ talk "Wie fühlen sich die Ehefrauen dabei?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:181
translate de rom_Ves_6_Drunk_8cb295ba:

    # VES @ talk "It is an old tradition... Some don’t like it but..."
    VES @ talk "Es ist eine alte Tradition ... Einige mögen es nicht, aber ..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:182
translate de rom_Ves_6_Drunk_988d95b0:

    # MC @ smile "I can imagine!"
    MC @ smile "Das kann ich mir vorstellen!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:183
translate de rom_Ves_6_Drunk_a3045e18:

    # "Ves shrugged apathetically."
    "Ves zuckte apathisch mit den Schultern."

# game/data/world_romance/ves/scr_6_Drunk.rpy:184
translate de rom_Ves_6_Drunk_aa67bb4f:

    # VES @ talk "Matriarchs often have the children of several males, and it is forbidden for them to devote themselves to just one mate."
    VES @ talk "Matriarchinnen haben oft die Kinder mehrerer Männchen, und es ist ihnen verboten, sich nur einem einzigen Gefährten zu widmen."

# game/data/world_romance/ves/scr_6_Drunk.rpy:185
translate de rom_Ves_6_Drunk_4f7c58c4:

    # VES @ talk "So, it is seen as different to betraying your mate to be with them. It is for the good of the clan."
    VES @ talk "Daher wird es als anders angesehen, seinen Gefährten zu betrügen, um bei ihnen zu sein. Es dient dem Wohl des Clans."

# game/data/world_romance/ves/scr_6_Drunk.rpy:186
translate de rom_Ves_6_Drunk_4d2eaece:

    # MC @ talk "That’s... a very openminded culture."
    MC @ talk "Das ist... eine sehr aufgeschlossene Kultur."

# game/data/world_romance/ves/scr_6_Drunk.rpy:187
translate de rom_Ves_6_Drunk_b6085730:

    # MC @ talk "I’m not sure humans would feel the same."
    MC @ talk "Ich bin mir nicht sicher, ob Menschen das gleiche empfinden würden."

# game/data/world_romance/ves/scr_6_Drunk.rpy:189
translate de rom_Ves_6_Drunk_9ef627e9:

    # VES @ smile_talk "Of course I am right!"
    VES @ smile_talk "Natürlich habe ich recht!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:190
translate de rom_Ves_6_Drunk_58ed8680:

    # VES @ talk "I may not have studied like you, but I have learned many things..."
    VES @ talk "Ich habe vielleicht nicht so studiert wie du, aber ich habe viele Dinge gelernt..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:193
translate de rom_Ves_6_Drunk_2a911be7:

    # VES @ talk "So... you still haven’t told me how you became..."
    VES @ talk "Also... du hast mir immer noch nicht erzählt, wie du... geworden bist..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:194
translate de rom_Ves_6_Drunk_8ce9bf6a:

    # MC @ talk "Ah... Well..."
    MC @ talk "Ah... Nun..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:195
translate de rom_Ves_6_Drunk_abf098b8:

    # "I spent the next while recounting my tale to Ves, the perilous journey lead by Captain Duprey, the abandoned fort and the strange underground lab..."
    "Die nächste Zeit verbrachte ich damit, Ves meine Geschichte zu erzählen, die gefährliche Reise unter der Führung von Captain Duprey, das verlassene Fort und das seltsame unterirdische Labor..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:196
translate de rom_Ves_6_Drunk_66477c9e:

    # "Finally, I went into detail about the strange creatures that had attached themselves to me and Marcus, and the terms and conditions of our survival for their ‘gift’."
    "Schließlich ging ich detailliert auf die seltsamen Kreaturen ein, die sich an mich und Marcus geheftet hatten, und auf die Bedingungen unseres Überlebens im Austausch für ihr 'Geschenk'."

# game/data/world_romance/ves/scr_6_Drunk.rpy:197
translate de rom_Ves_6_Drunk_aef1c638:

    # VES @ talk "... I see."
    VES @ talk "... Ich verstehe."

# game/data/world_romance/ves/scr_6_Drunk.rpy:198
translate de rom_Ves_6_Drunk_fec7b863:

    # "Ves sighed morosely."
    "Ves seufzte trübsinnig."

# game/data/world_romance/ves/scr_6_Drunk.rpy:199
translate de rom_Ves_6_Drunk_6d6a4d50:

    # MC @ talk "... What is it?"
    MC @ talk "... Was ist los?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:200
translate de rom_Ves_6_Drunk_1c27f260:

    # VES @ talk "... Nothing."
    VES @ talk "... Nichts."

# game/data/world_romance/ves/scr_6_Drunk.rpy:201
translate de rom_Ves_6_Drunk_8d168b3c:

    # MC @ talk "No, something’s bothering you."
    MC @ talk "Nein, etwas bedrückt dich."

# game/data/world_romance/ves/scr_6_Drunk.rpy:202
translate de rom_Ves_6_Drunk_733c4389:

    # VES @ talk "I..."
    VES @ talk "Ich..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:203
translate de rom_Ves_6_Drunk_3d13c0ad:

    # VES @ talk "Would like to have you for myself..."
    VES @ talk "Würde dich gern für mich allein haben..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:204
translate de rom_Ves_6_Drunk_8418a966:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:205
translate de rom_Ves_6_Drunk_025adeea:

    # VES @ talk "{i}Just{/i} for myself."
    VES @ talk "{i}Nur{/i} für mich allein."

# game/data/world_romance/ves/scr_6_Drunk.rpy:206
translate de rom_Ves_6_Drunk_9bbca015:

    # VES @ talk "But... I know this is probably not possible, is it?"
    VES @ talk "Aber... ich weiß, das ist wahrscheinlich nicht möglich, oder?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:207
translate de rom_Ves_6_Drunk_83848d0a:

    # MC @ talk "It is... difficult."
    MC @ talk "Es ist... schwierig."

# game/data/world_romance/ves/scr_6_Drunk.rpy:208
translate de rom_Ves_6_Drunk_f7250a82:

    # MC @ talk "When I was fully human, I could have—"
    MC @ talk "Als ich noch ganz Mensch war, hätte ich—"

# game/data/world_romance/ves/scr_6_Drunk.rpy:209
translate de rom_Ves_6_Drunk_b13cb8e5:

    # VES @ talk "No... It’s okay."
    VES @ talk "Nein... Es ist in Ordnung."

# game/data/world_romance/ves/scr_6_Drunk.rpy:210
translate de rom_Ves_6_Drunk_2b3bb5cd:

    # VES @ smile_talk "I am just happy to be with you."
    VES @ smile_talk "Ich bin einfach nur glücklich, bei dir zu sein."

# game/data/world_romance/ves/scr_6_Drunk.rpy:211
translate de rom_Ves_6_Drunk_8cfba628:

    # VES @ talk "... And grateful for the patience you have shown me."
    VES @ talk "... Und dankbar für die Geduld, die du mir entgegengebracht hast."

# game/data/world_romance/ves/scr_6_Drunk.rpy:212
translate de rom_Ves_6_Drunk_fe794908:

    # "Gently, I caressed Ves’ face with my hand, she leaned forward to press another kiss onto me."
    "Sanft streichelte ich Ves' Gesicht mit meiner Hand, sie beugte sich vor, um mir einen weiteren Kuss zu geben."

# game/data/world_romance/ves/scr_6_Drunk.rpy:213
translate de rom_Ves_6_Drunk_257b57b9:

    # VES @ smile_talk "... Goodnight, [player_name!t]."
    VES @ smile_talk "... Gute Nacht, [player_name!t]."

# game/data/world_romance/ves/scr_6_Drunk.rpy:214
translate de rom_Ves_6_Drunk_a0f70b38:

    # MC @ smile "Hey! You said my name!"
    MC @ smile "Hey! Du hast meinen Namen gesagt!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:215
translate de rom_Ves_6_Drunk_e23ae25b:

    # VES @ talk "{i}*Grumbles*{/i}"
    VES @ talk "{i}*brummelt*{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:216
translate de rom_Ves_6_Drunk_8418a966_1:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:218
translate de rom_Ves_6_Drunk_5702411e:

    # MC @ talk "Goodnight, Ves..."
    MC @ talk "Gute Nacht, Ves..."

translate de strings:

    # game/data/world_romance/ves/scr_6_Drunk.rpy:109
    old "It all began when I was born, everyone realised I was the most handsome man in all of Alderay."
    new "Alles begann mit meiner Geburt: Alle erkannten, dass ich der attraktivste Mann in ganz Alderay war."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:117
    old "Not much to say really... Most of your time growing up in Novaras is spent studying if you’re smart."
    new "Eigentlich nicht viel zu sagen... Wenn man klug ist, verbringt man den Großteil seiner Jugend in Novaras mit Lernen."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:160
    old "I’d prefer dying old and grey with my family around me."
    new "Ich würde lieber alt und grau im Kreise meiner Familie sterben."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:168
    old "I dunno, dying in a brothel sounds like a lot more fun."
    new "Keine Ahnung, in einem Bordell zu sterben klingt nach viel mehr Spaß."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:188
    old "I suppose you’re right..."
    new "Ich schätze, du hast recht..."

