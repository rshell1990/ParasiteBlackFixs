# game/engine/gallery/babazhul_label.rpy:5
translate de nov_soothsayer_gallery_f7cac0c8:

    # BABAZHUL @ talk "So be it..."
    BABAZHUL @ talk "So sei es..."

# game/engine/gallery/babazhul_label.rpy:7
translate de nov_soothsayer_gallery_e2fab751:

    # BABAZHUL @ talk "But remember child, the past has already come and gone, only the present is a gift."
    BABAZHUL @ talk "Aber denk daran, Kind, die Vergangenheit ist bereits gekommen und gegangen, nur die Gegenwart ist ein Geschenk."

# game/engine/gallery/babazhul_label.rpy:8
translate de nov_soothsayer_gallery_7ad6ec43:

    # BABAZHUL @ talk "Do not linger too long on the shadows that have already vanished."
    BABAZHUL @ talk "Verweile nicht zu lange bei den Schatten, die bereits vergangen sind."

# game/engine/gallery/babazhul_label.rpy:9
translate de nov_soothsayer_gallery_57fdbdbd:

    # BABAZHUL @ talk "How easy it is to become lost to their sweetness..."
    BABAZHUL @ talk "Wie leicht es ist, sich in ihrer Süße zu verlieren..."

# game/engine/gallery/babazhul_label.rpy:56
translate de nov_soothsayer_gallery_4424f154:

    # BABAZHUL @ talk "You do not possess enough coin, child, return when you do."
    BABAZHUL @ talk "Du hast nicht genug Münzen, Kind, komm zurück, wenn du genug hast."

