# game/engine/hamun_arena/arena_aio.rpy:154
translate de hamun_arena_master_talk_first_time_b424163d:

    # HAMUN_ARENA_MASTER "Greetings... Are you here to watch a battle in the arena, or to rank?"
    HAMUN_ARENA_MASTER "Grüße... Bist du hier, um einen Kampf in der Arena zu sehen, oder um zu ranken?"

# game/engine/hamun_arena/arena_aio.rpy:155
translate de hamun_arena_master_talk_first_time_5c68a77d:

    # MC @ talk "To rank."
    MC @ talk "Um zu ranken."

# game/engine/hamun_arena/arena_aio.rpy:156
translate de hamun_arena_master_talk_first_time_8e665699:

    # HAMUN_ARENA_MASTER "Excellent."
    HAMUN_ARENA_MASTER "Ausgezeichnet."

# game/engine/hamun_arena/arena_aio.rpy:157
translate de hamun_arena_master_talk_first_time_b3a82bdf:

    # "The figure slid over some paperwork with an inked quill."
    "Die Gestalt schob einige Papiere mit einer getauchten Feder herüber."

# game/engine/hamun_arena/arena_aio.rpy:158
translate de hamun_arena_master_talk_first_time_c1906bc5:

    # HAMUN_ARENA_MASTER "Any questions?"
    HAMUN_ARENA_MASTER "Irgendwelche Fragen?"

# game/engine/hamun_arena/arena_aio.rpy:161
translate de hamun_arena_master_questions_menu_first_time_94a74e82:

    # HAMUN_ARENA_MASTER "You pay in blood here."
    HAMUN_ARENA_MASTER "Hier zahlt man mit Blut."

# game/engine/hamun_arena/arena_aio.rpy:164
translate de hamun_arena_master_questions_menu_first_time_beb6daa1:

    # HAMUN_ARENA_MASTER "There are five ranks within the arena."
    HAMUN_ARENA_MASTER "Es gibt fünf Ränge innerhalb der Arena."

# game/engine/hamun_arena/arena_aio.rpy:165
translate de hamun_arena_master_questions_menu_first_time_5d206716:

    # HAMUN_ARENA_MASTER "To move between ranks, you must defeat ten opponents in each rank."
    HAMUN_ARENA_MASTER "Um zwischen den Rängen aufzusteigen, musst du in jedem Rang zehn Gegner besiegen."

# game/engine/hamun_arena/arena_aio.rpy:166
translate de hamun_arena_master_questions_menu_first_time_f1d4b60a:

    # HAMUN_ARENA_MASTER "Followed by a special match of our choosing."
    HAMUN_ARENA_MASTER "Gefolgt von einem besonderen Kampf unserer Wahl."

# game/engine/hamun_arena/arena_aio.rpy:167
translate de hamun_arena_master_questions_menu_first_time_1b9223ca:

    # HAMUN_ARENA_MASTER "...As a word of warning, we may restrict your access to some of the higher ranks if we don't feel you're ready."
    HAMUN_ARENA_MASTER "...Zur Warnung, wir könnten dir den Zugang zu einigen der höheren Ränge verwehren, wenn wir nicht das Gefühl haben, dass du bereit bist."

# game/engine/hamun_arena/arena_aio.rpy:168
translate de hamun_arena_master_questions_menu_first_time_5b2e12c5:

    # HAMUN_ARENA_MASTER "We want a glorious battle on the sand... not a bloody massacre before the audience even sits down."
    HAMUN_ARENA_MASTER "Wir wollen einen glorreichen Kampf auf dem Sand ... kein blutiges Gemetzel, bevor das Publikum überhaupt Platz genommen hat."

# game/engine/hamun_arena/arena_aio.rpy:171
translate de hamun_arena_master_questions_menu_first_time_ab7228a3:

    # HAMUN_ARENA_MASTER "Monsters, warriors... strange creatures from faraway lands."
    HAMUN_ARENA_MASTER "Monster, Krieger ... seltsame Kreaturen aus fernen Ländern."

# game/engine/hamun_arena/arena_aio.rpy:172
translate de hamun_arena_master_questions_menu_first_time_0fec0d5e:

    # HAMUN_ARENA_MASTER "Whatever we think will draw in the most crowds."
    HAMUN_ARENA_MASTER "Was auch immer unserer Meinung nach die größten Menschenmengen anzieht."

# game/engine/hamun_arena/arena_aio.rpy:175
translate de hamun_arena_master_questions_menu_first_time_88523b26:

    # HAMUN_ARENA_MASTER "The higher the ranked matches, the higher the coin."
    HAMUN_ARENA_MASTER "Je höher die Ränge der Kämpfe, desto mehr Münzen."

# game/engine/hamun_arena/arena_aio.rpy:176
translate de hamun_arena_master_questions_menu_first_time_5c0ba242:

    # HAMUN_ARENA_MASTER "Though sometimes, rewards may be offered in place of coin."
    HAMUN_ARENA_MASTER "Manchmal werden jedoch Belohnungen anstelle von Münzen angeboten."

# game/engine/hamun_arena/arena_aio.rpy:179
translate de hamun_arena_master_questions_menu_first_time_0197c051:

    # HAMUN_ARENA_MASTER "Good... Now shall we discuss arranging a match?"
    HAMUN_ARENA_MASTER "Gut ... Sollen wir jetzt über die Organisation eines Kampfes sprechen?"

# game/engine/hamun_arena/arena_aio.rpy:185
translate de hamun_arena_master_talk_aaca8c6f:

    # HAMUN_ARENA_MASTER "Yes?"
    HAMUN_ARENA_MASTER "Ja?"

# game/engine/hamun_arena/arena_aio.rpy:187
translate de hamun_arena_master_talk_8a0e5bbb:

    # HAMUN_ARENA_MASTER "Yes, Sun Forged?"
    HAMUN_ARENA_MASTER "Ja, Sun Forged?"

# game/engine/hamun_arena/arena_aio.rpy:194
translate de hamun_arena_master_signup_449b8311:

    # HAMUN_ARENA_MASTER "The sun is set, it's too late now."
    HAMUN_ARENA_MASTER "Die Sonne ist untergegangen, es ist jetzt zu spät."

# game/engine/hamun_arena/arena_aio.rpy:195
translate de hamun_arena_master_signup_989e2dce:

    # HAMUN_ARENA_MASTER "Come back tomorrow."
    HAMUN_ARENA_MASTER "Komm morgen wieder."

# game/engine/hamun_arena/arena_aio.rpy:198
translate de hamun_arena_master_signup_bfaf9441:

    # HAMUN_ARENA_MASTER "The crowd have seen enough of you for today, warrior."
    HAMUN_ARENA_MASTER "Die Menge hat heute genug von dir gesehen, Krieger."

# game/engine/hamun_arena/arena_aio.rpy:199
translate de hamun_arena_master_signup_2d4f6bd9:

    # HAMUN_ARENA_MASTER "Come back tomorrow for another fight."
    HAMUN_ARENA_MASTER "Komm morgen für einen weiteren Kampf wieder."

# game/engine/hamun_arena/arena_aio.rpy:201
translate de hamun_arena_master_signup_54e5c8f4:

    # HAMUN_ARENA_MASTER "Heh... Whose blood shall stain the sacred sands, then?"
    HAMUN_ARENA_MASTER "Heh... Wessen Blut soll dann den heiligen Sand beflecken?"

# game/engine/hamun_arena/arena_aio.rpy:228
translate de hamun_arena_master_signup_aa724bd9:

    # HAMUN_ARENA_MASTER "Stop wasting my time."
    HAMUN_ARENA_MASTER "Hör auf, meine Zeit zu verschwenden."

# game/engine/hamun_arena/arena_aio.rpy:294
translate de hamun_arena_master_rank_advanced_4c202287:

    # HAMUN_ARENA_MASTER "Quite a fight, warrior!"
    HAMUN_ARENA_MASTER "Ein beachtlicher Kampf, Krieger!"

# game/engine/hamun_arena/arena_aio.rpy:295
translate de hamun_arena_master_rank_advanced_ee81b14e:

