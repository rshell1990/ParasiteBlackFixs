    # ADARA @ shock "Ah, so soon?"
    ADARA @ shock "Ah, ¿tan pronto?"

# game/data/characters/adara/dialogue.rpy:28
translate es adara_bye_8c5c4de9:

    # ADARA @ sad "Well ... alright then, I'll see you soon I guess."
    ADARA @ sad "Bueno... de acuerdo entonces, supongo que nos veremos pronto."

# game/data/characters/adara/dialogue.rpy:44
translate es adara_talk_howareyou_84011970:

    # ADARA @ sad "Father has been a little more unwell than usual today, so I've been quite busy tending to his health."
    ADARA @ sad "Padre ha estado hoy un poco más indispuesto de lo habitual, así que he estado bastante ocupada atendiendo su salud."

# game/data/characters/adara/dialogue.rpy:46
translate es adara_talk_howareyou_c0e90cb6:

    # ADARA @ talk "Hm? Same as always I suppose..."
    ADARA @ talk "¿Hm? Lo mismo de siempre, supongo..."

# game/data/characters/adara/dialogue.rpy:42
translate es adara_talk_howareyou_666024d3:

    # ADARA @ smile "I am well, [player_name!t], thank you for asking."
    ADARA @ smile "Estoy bien, [player_name!t], gracias por preguntar."

# game/data/characters/adara/dialogue.rpy:50
translate es adara_talk_howareyou_7fe3643a:

    # ADARA @ talk "Did you hear about the commotion in the pleasure district? Some kind of ... {i}monster{/i} attacked one of the gangs, at least, that's the rumour."
    ADARA @ talk "¿Has oído hablar de la conmoción en el distrito de placer? Una especie de... {i}monstruo{/i} atacó a una de las bandas, al menos, ese es el rumor."

# game/data/characters/adara/dialogue.rpy:52
translate es adara_talk_howareyou_0c7cccc7:

    # ADARA @ smile "I am well thank you! Have you seen that new market stall selling Ramonian food? It's very popular!"
    ADARA @ smile "Estoy bien, gracias. ¿Has visto ese nuevo puesto del mercado que vende comida ramoniana? ¡Es muy popular!"

# game/data/characters/adara/dialogue.rpy:54
translate es adara_talk_howareyou_003c1185:

    # ADARA @ smile "You're making quite a name for yourself, aren't you? Congratulations on moving up ranks in the adventurers guild!"
    ADARA @ smile "Te estás haciendo un verdadero renombre, ¿verdad? ¡Enhorabuena por ascender en el gremio de aventureros!"

