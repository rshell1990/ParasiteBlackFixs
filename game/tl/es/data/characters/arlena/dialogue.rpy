

# game/data/characters/arlena/dialogue.rpy:31
translate es arlena_room_first_entry_341a0073:

    # "Arlena's boxed room was compact but filled with drawings of schematics littered all about the place."
    "La habitación de Arlena era compacta, pero estaba llena de dibujos y esquemas por todas partes."

# game/data/characters/arlena/dialogue.rpy:32
translate es arlena_room_first_entry_9caafbc0:

    # "Here and there were the essentials, a single soft straw bed, a draw for some clothes and a workbench for her to sit at."
    "Aquí y allá había lo esencial, una cama individual de paja suave, un cajón para algo de ropa y un banco de trabajo para sentarse."

# game/data/characters/arlena/dialogue.rpy:36
translate es arlena_room_first_entry_07a0d7a5:

    # MC "{b}OUCH!{/b}"
    MC "{b}¡AY!{/b}"

# game/data/characters/arlena/dialogue.rpy:38
translate es arlena_room_first_entry_3d8c7c56:

    # ARLENA @ angry "[player_name!t]?! Fucking idiot, what's wrong with you sneaking around like that?!"
    ARLENA @ angry "¡¿[player_name!t]?! FMaldito idiota, ¡¿porque entras así a escondidas?!"

# game/data/characters/arlena/dialogue.rpy:38
translate es arlena_room_first_entry_d49d44c5:

    # MC "Sorry! The door was unlocked..."
    MC "¡Perdón! La puerta estaba abierta..."

# game/data/characters/arlena/dialogue.rpy:39
translate es arlena_room_first_entry_e4a3cc26:

    # MC "Did you just hit me with a-"
    MC "¿Acabas de golpearme con un-"

# game/data/characters/arlena/dialogue.rpy:40
translate es arlena_room_first_entry_2e815ce5:

    # ARLENA @ angry "YES! A stool!"
    ARLENA @ angry "¡SÍ! ¡Un taburete!"

# game/data/characters/arlena/dialogue.rpy:41
translate es arlena_room_first_entry_eaf74097:

    # "Surprisingly, Arlena seemed to cool down right before my eyes."
    "Sorprendentemente, Arlena pareció calmarse ante mis ojos."

# game/data/characters/arlena/dialogue.rpy:42
translate es arlena_room_first_entry_1d9cbd20:

    # "Perhaps I really {i}did{/i} sneak up on her."
    "Tal vez {i}realmente{/i} me acerqué sigilosamente."

# game/data/characters/arlena/dialogue.rpy:41
translate es arlena_room_first_entry_c8d99ccc:

    # ARLENA "Anyway, welcome to my High Castle."
    ARLENA "En fin, bienvenido a mi taller."

# game/data/characters/arlena/dialogue.rpy:42
translate es arlena_room_first_entry_bf198958:

    # ARLENA "I sketch out some of the more unique designs for armour and weapons here."
    ARLENA "Aquí esbozo algunos de los diseños más singulares de armaduras y armas."

# game/data/characters/arlena/dialogue.rpy:43
translate es arlena_room_first_entry_648653a1:

    # ARLENA "There is something else I’ve been working on too..."
    ARLENA "Hay algo más en lo que también he estado trabajando..."

# game/data/characters/arlena/dialogue.rpy:44
translate es arlena_room_first_entry_49a216f8:

    # ARLENA "Now if you don't mind, I'd rather get back to work."
    ARLENA "Ahora, si no te importa, prefiero volver al trabajo."

# game/data/characters/arlena/dialogue.rpy:48
