# game/data/characters/arwen/dialogue.rpy:76
translate es arwen_talk_celeste_6d79cabc:

    # MC @ talk "Hey Arwen."
    MC @ talk "Hola Arwen."

# game/data/characters/arwen/dialogue.rpy:77
translate es arwen_talk_celeste_324c5a69:

    # ARWEN @ talk "Why hello there brave adventurer!"
    ARWEN @ talk "¡Hola, valiente aventurero!"

# game/data/characters/arwen/dialogue.rpy:78
translate es arwen_talk_celeste_30f5cc47:

    # ARWEN @ talk "Tell me, {i}how much coin would you pay to spend a night with the beautiful Celeste?{/i}"
    ARWEN @ talk "Dime, {i}¿cuánto pagarías por pasar una noche con la bella Celeste?{/i}"

# game/data/characters/arwen/dialogue.rpy:79
translate es arwen_talk_celeste_4f6d740f:

    # ARWEN @ talk "Actually, don't even answer that!"
    ARWEN @ talk "De hecho, ¡ni siquiera respondas a eso!"

# game/data/characters/arwen/dialogue.rpy:80
translate es arwen_talk_celeste_da29d70f:

    # ARWEN @ talk "We both know that such priceless things would be worth their weight in gold... {i}till now.{/i}"
    ARWEN @ talk "Ambos sabemos que esas cosas de valor incalculable valdrían su peso en oro... {i}hasta ahora.{/i}"

# game/data/characters/arwen/dialogue.rpy:85
translate es arwen_bye_cel_84e04ea5:

    # ARWEN @ talk "Very well."
    ARWEN @ talk "Muy bien."

# game/data/characters/arwen/dialogue.rpy:89
translate es arwen_whyCeleste_259711d9:

    # ARWEN @ laugh "Because... {i}Who doesn't want to fuck the most beautiful, famous heroine around?{/i}"
    ARWEN @ laugh "Porque... {i}¿Quién no quiere follarse a la heroína más guapa y famosa?{/i}"

# game/data/characters/arwen/dialogue.rpy:90
translate es arwen_whyCeleste_9530a2ec:

    # ARWEN @ talk "People will pay whatever I ask if they think they'll get at least a taste of what it might be like to have her."
    ARWEN @ talk "La gente pagará lo que yo pida si cree que al menos va a saborear lo que podría ser tenerla."

# game/data/characters/arwen/dialogue.rpy:91
translate es arwen_whyCeleste_e7a80d41:

    # ARWEN @ talk "Fantasy is a powerful thing... The reality of something rarely meets the expectation."
    ARWEN @ talk "La fantasía es muy poderosa... La realidad de algo rara vez cumple las expectativas."

# game/data/characters/arwen/dialogue.rpy:92
translate es arwen_whyCeleste_67cb03f1:

    # MC @ talk "Very insightful of you."
    MC @ talk "Muy perspicaz por tu parte."

# game/data/characters/arwen/dialogue.rpy:93
translate es arwen_whyCeleste_aa10a873:

    # ARWEN @ laugh "I try."
    ARWEN @ laugh "Lo intento."

# game/data/characters/arwen/dialogue.rpy:97
translate es dialogue_arwen_services_cel_ec508417:

    # ARWEN @ talk "Fifteen hundred coins and {i}Celeste{/i} is all yours."
    ARWEN @ talk "Mil quinientas monedas y {i}Celeste{/i} es toda tuya."

# game/data/characters/arwen/dialogue.rpy:98
translate es dialogue_arwen_services_cel_8b30ba46:

    # MC @ talk "That's more than your normal rates..."
    MC @ talk "Eso es más que tus tarifas normales..."

# game/data/characters/arwen/dialogue.rpy:99
translate es dialogue_arwen_services_cel_779f3c4e:

    # ARWEN @ angry "Do you know how much this outfit cost to make?"
    ARWEN @ angry "¿Sabes cuánto costó hacer este conjunto?"

# game/data/characters/arwen/dialogue.rpy:100
translate es dialogue_arwen_services_cel_0f93cc2b:

    # ARWEN @ talk "Plus all the rallies and things I had to attend to learn to act like her a bit."
    ARWEN @ talk "Además de todos los mítines y cosas a las que tuve que asistir para aprender a comportarme un poco como ella."

# game/data/characters/arwen/dialogue.rpy:101
translate es dialogue_arwen_services_cel_84c11618:

    # ARWEN @ laugh "Besides... I offer a {i}unique{/i} experience unlike what my clients normally get."
    ARWEN @ laugh "Además... Ofrezco una experiencia {i}única{/i} a diferencia de lo que mis clientes obtienen normalmente."

# game/data/characters/arwen/dialogue.rpy:102
translate es dialogue_arwen_services_cel_c7c5bcc5:

    # ARWEN @ talk "So, fifteen hundred. Interested?"
    ARWEN @ talk "Entonces, mil quinientas. ¿Te interesa?"

# game/data/characters/arwen/dialogue.rpy:105
translate es dialogue_arwen_services_cel_67a3c006:

    # ARWEN @ talk "Then if you don't mind, other customers are waiting."
    ARWEN @ talk "Entonces, si no te importa, otros clientes están esperando."

