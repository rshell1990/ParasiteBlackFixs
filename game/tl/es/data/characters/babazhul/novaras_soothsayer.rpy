

# game/data/characters/babazhul/novaras_soothsayer.rpy:41
translate es nov_soothsayer_firstmeet_90717a1f:

    # "Entering into the darkened room of the soothsayer I looked around."
    "Al entrar en la oscura habitación de la adivina, miré a mi alrededor."

# game/data/characters/babazhul/novaras_soothsayer.rpy:42
translate es nov_soothsayer_firstmeet_7bd2c3f6:

    # "The room was dimly lit only by pale candle light, with strange trinkets from faraway lands adorning every corner of the room, strange skulls and books in ancient tongues long since dead."
    "La habitación estaba tenuemente iluminada solo por la pálida luz de las velas, con extrañas baratijas de tierras lejanas adornando cada rincón de la estancia, extrañas calaveras y libros en lenguas antiguas."

# game/data/characters/babazhul/novaras_soothsayer.rpy:43
translate es nov_soothsayer_firstmeet_406bc049:

    # "Here and there was a stuffed bird or some scroll with strange markings on it littered around on the floor amongst the pile of many books."
    "Aquí y allá había un pájaro disecado o algún pergamino con extrañas marcas tirado por el suelo entre la pila de muchos libros."

# game/data/characters/babazhul/novaras_soothsayer.rpy:44
translate es nov_soothsayer_firstmeet_5d595e11:

    # "The old hag was sat down at her seat, hunched over her desk looming over a crystal ball as she looked towards me expectantly."
    "La vieja bruja estaba sentada en su asiento, encorvada sobre su escritorio y pendiente de una bola de cristal mientras miraba hacia mí expectante."

# game/data/characters/babazhul/novaras_soothsayer.rpy:75
translate es nov_soothsayer_firstmeet_725e3592:

    # BABAZHUL @ talk "{i}I knew you would come,{/i} [player_name!t]."
    BABAZHUL @ talk "{i}Sabía que vendrías,{/i} [player_name!t]."

# game/data/characters/babazhul/novaras_soothsayer.rpy:47
translate es nov_soothsayer_firstmeet_3d82d3ee:

    # MC "How did you know my name?"
    MC "¿Cómo sabes mi nombre?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:48
translate es nov_soothsayer_firstmeet_f14bc448:

    # BABAZHUL @ talk "Babazhul knows many names, many things that have passed and are yet to pass."
    BABAZHUL @ talk "Babazhul conoce muchos nombres, muchas cosas pasadas y por pasar."

# game/data/characters/babazhul/novaras_soothsayer.rpy:50
translate es nov_soothsayer_firstmeet_ea08ba0d:

    # BABAZHUL @ talk "Now tell me child of tooth and claw, do you seek your past... {i}or your future?{/i}"
    BABAZHUL @ talk "Ahora dime hijo del diente y la garra, ¿buscas tu pasado... {i}o tu futuro?{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:51
translate es nov_soothsayer_firstmeet_c58e7a45:

    # BABAZHUL @ talk "For but five gold, it can be yours..."
    BABAZHUL @ talk "Por solo cinco monedas de oro, puede ser tuyo..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:61
translate es nov_soothsayer_talk_c96029cf:

    # BABAZHUL @ talk "Welcome back, child of tooth and claw."
    BABAZHUL @ talk "Bienvenido de nuevo, hijo del diente y la garra."

# game/data/characters/babazhul/novaras_soothsayer.rpy:62
translate es nov_soothsayer_talk_ea89362c:

    # BABAZHUL @ talk "Make your choice."
    BABAZHUL @ talk "Haz tu elección."

# game/data/characters/babazhul/novaras_soothsayer.rpy:72
translate es nov_soothsayer_future_b2637f25:

    # BABAZHUL @ talk "So be it."
    BABAZHUL @ talk "Que así sea."

# game/data/characters/babazhul/novaras_soothsayer.rpy:75
translate es nov_soothsayer_future_c6eccf04:

    # "Babazhul hands lightly touched over her crystal ball, which brightly began to glow and illuminate as she stared deeply into it with her half blind eyes."
    "Las manos de Babazhul tocaron ligeramente su bola de cristal, que comenzó a brillar e iluminarse mientras la miraba fijamente con sus ojos medio ciegos."

# game/data/characters/babazhul/novaras_soothsayer.rpy:86
translate es nov_soothsayer_future_3add1f07:

    # BABAZHUL @ talk "In time, perhaps, there might be clarity..."
    BABAZHUL @ talk "Con el tiempo, tal vez, podría haber claridad..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:87
translate es nov_soothsayer_future_fbf25a5c:

    # BABAZHUL @ talk "For now, I can see no more."
    BABAZHUL @ talk "Por ahora, no puedo ver más."

# game/data/characters/babazhul/novaras_soothsayer.rpy:91
translate es nov_soothsayer_future_4424f154:

    # BABAZHUL @ talk "You do not possess enough coin, child, return when you do."
    BABAZHUL @ talk "No posees suficientes monedas, hijo, regresa cuando las tengas."

# game/data/characters/babazhul/novaras_soothsayer.rpy:98
translate es nov_soothsayer_goodbye_91ee6e03:

    # BABAZHUL @ talk "{i}*Laughs*{/i} Of course you will return... I've already foreseen it."
    BABAZHUL @ talk "{i}*Risas*{/i} Por supuesto que volverás... Ya he visto el futuro."

# game/data/characters/babazhul/novaras_soothsayer.rpy:107
translate es nov_soothsayer_future0_bd41ac2b:

    # BABAZHUL @ talk "I see a great shadow following you, a warrior of a thousand worlds."
    BABAZHUL @ talk "Veo una gran sombra que te sigue, un guerrero de mil mundos."

# game/data/characters/babazhul/novaras_soothsayer.rpy:108
translate es nov_soothsayer_future0_62ae2cf6:

    # BABAZHUL @ talk "Sitting on a throne of bones, so alone and so cold."
    BABAZHUL @ talk "Sentado en un trono de huesos, tan solo y tan frío."

# game/data/characters/babazhul/novaras_soothsayer.rpy:109
translate es nov_soothsayer_future0_1c0474f3:

    # BABAZHUL @ talk "He would sit forever... Enjoy the silence, if not for his master's call."
    BABAZHUL @ talk "Se sentaría para siempre... disfrutando del silencio, si no fuera por la llamada de su amo."

# game/data/characters/babazhul/novaras_soothsayer.rpy:117
translate es nov_soothsayer_future1_c59e6106:

    # BABAZHUL @ talk "Hahaha! I see her fire, Princess raised by shadows and knives, born into a lie."
    BABAZHUL @ talk "¡Jajaja! Veo su fuego, una princesa criada por sombras y cuchillos, nacida en una mentira."

# game/data/characters/babazhul/novaras_soothsayer.rpy:118
translate es nov_soothsayer_future1_34e35823:

    # BABAZHUL @ talk "The great stars lay before her, and perhaps you at her side."
    BABAZHUL @ talk "Las grandes estrellas yacen ante ella, y tal vez tú a su lado."

# game/data/characters/babazhul/novaras_soothsayer.rpy:119
translate es nov_soothsayer_future1_36bd14f0:

    # BABAZHUL @ talk "Oh child of tooth and claw, we shall see if love can truly conquer all!"
    BABAZHUL @ talk "Oh, hijo del diente y la garra, ¡veremos si el amor puede realmente conquistarlo todo!"

# game/data/characters/babazhul/novaras_soothsayer.rpy:127
translate es nov_soothsayer_future2_d966afcc:

    # BABAZHUL @ talk "The imitation stalks these lands, a beautiful souless beast."
    BABAZHUL @ talk "La imitación acecha estas tierras, una bella bestia sin alma."

# game/data/characters/babazhul/novaras_soothsayer.rpy:128
translate es nov_soothsayer_future2_beae5065:

    # BABAZHUL @ talk "Nothing but death awaits, yet how sweet will she be when she poisons your soul with honey."
    BABAZHUL @ talk "Solo la muerte aguarda, pero qué dulce será cuando envenene tu alma con miel."

# game/data/characters/babazhul/novaras_soothsayer.rpy:129
translate es nov_soothsayer_future2_9bd746f0:

    # BABAZHUL @ talk "See past the lies and beware, beware child of tooth and claw:"
    BABAZHUL @ talk "Ve más allá de las mentiras y ten cuidado, ten cuidado hijo del diente y la garra:"

# game/data/characters/babazhul/novaras_soothsayer.rpy:130
translate es nov_soothsayer_future2_02815b56:

    # BABAZHUL @ talk "The beautiful souless beast may be your demise."
    BABAZHUL @ talk "La bella bestia sin alma puede ser tu perdición."

# game/data/characters/babazhul/novaras_soothsayer.rpy:138
translate es nov_soothsayer_future3_f914e12e:

    # BABAZHUL @ talk "My my, child! Such sweet fruits await! One in green, one in blue, one with scales, one so small, you could carry four! Hahaha!"
    BABAZHUL @ talk "¡Mi hijo! ¡Qué frutas tan dulces te esperan! Una verde, una azul, una con escamas, una tan pequeña, ¡que podrías llevar cuatro! ¡Jajaja!"

# game/data/characters/babazhul/novaras_soothsayer.rpy:139
translate es nov_soothsayer_future3_5a07672c:

    # BABAZHUL @ talk "Their love will guide you through the darkness to come, cling to it, embrace it, hold them dear and close."
    BABAZHUL @ talk "Su amor te guiará a través de la oscuridad que se avecina, aférrate a él, abrázalo, mantenlas apreciadas y cerca."

# game/data/characters/babazhul/novaras_soothsayer.rpy:140
translate es nov_soothsayer_future3_f7410e2c:

    # BABAZHUL @ talk "For when the time comes, you must face the darkness alone..."
    BABAZHUL @ talk "Porque cuando llegue el momento, deberás enfrentarte solo a la oscuridad..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:148
translate es nov_soothsayer_future4_37ac8a1d:

    # BABAZHUL @ talk "He sits at the helm of ultimate destruction, more ghost than man but he will return home."
    BABAZHUL @ talk "Se sienta al timón de la destrucción definitiva, más fantasma que hombre, pero volverá a casa."

# game/data/characters/babazhul/novaras_soothsayer.rpy:149
translate es nov_soothsayer_future4_68e013f7:

    # BABAZHUL @ talk "Oh child of tooth and claw, to forever be reaching for the past is a terrible thing."
    BABAZHUL @ talk "Oh, hijo del diente y la garra, aferrarse para siempre al pasado es algo terrible."

# game/data/characters/babazhul/novaras_soothsayer.rpy:150
translate es nov_soothsayer_future4_41a33087:

    # BABAZHUL @ talk "It may make monsters of us all..."
    BABAZHUL @ talk "Puede convertirnos a todos en monstruos..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:158
translate es nov_soothsayer_future5_521823e0:

    # BABAZHUL @ talk "I see two brothers, stood on opposite cliffs."
    BABAZHUL @ talk "Veo a dos hermanos, de pie en acantilados opuestos."

# game/data/characters/babazhul/novaras_soothsayer.rpy:159
translate es nov_soothsayer_future5_9eb10f6e:

    # BABAZHUL @ talk "A terrible storm rages, the black waves thrashing beneath their feet."
    BABAZHUL @ talk "Una terrible tormenta azota las olas negras bajo sus pies."

# game/data/characters/babazhul/novaras_soothsayer.rpy:160
translate es nov_soothsayer_future5_60b3ce80:

    # BABAZHUL @ talk "Both weep... But the fire inside makes them scream."
    BABAZHUL @ talk "Ambos lloran... Pero el fuego interior les hace gritar."

# game/data/characters/babazhul/novaras_soothsayer.rpy:161
translate es nov_soothsayer_future5_2126ec51:

    # BABAZHUL @ talk "How the ones we love cut so deep."
    BABAZHUL @ talk "Cómo los que amamos llegan tan profundo."

# game/data/characters/babazhul/novaras_soothsayer.rpy:169
translate es nov_soothsayer_future6_7454759e:

    # BABAZHUL @ talk "Grief... I feel his grief."
    BABAZHUL @ talk "Dolor... Siento su dolor."

# game/data/characters/babazhul/novaras_soothsayer.rpy:170
translate es nov_soothsayer_future6_d647c32f:

    # BABAZHUL @ talk "It has made a monster of him, and it drives him to do terrible things."
    BABAZHUL @ talk "Lo ha convertido en un monstruo y lo lleva a hacer cosas terribles."

# game/data/characters/babazhul/novaras_soothsayer.rpy:171
translate es nov_soothsayer_future6_7a7c1972:

    # BABAZHUL @ talk "But his fate is not yet sealed."
    BABAZHUL @ talk "Pero su destino aún no está decidido."

# game/data/characters/babazhul/novaras_soothsayer.rpy:172
translate es nov_soothsayer_future6_c96105ba:

    # BABAZHUL @ talk "What will become of him?"
    BABAZHUL @ talk "¿Qué será de él?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:45
translate es nov_soothsayer_firstmeet_f1746c4b:

    # BABAZHUL "Greetings, child of tooth and claw."
    BABAZHUL "Saludos, hijo del diente y la garra."

# game/data/characters/babazhul/novaras_soothsayer.rpy:46
translate es nov_soothsayer_firstmeet_783baad9:

    # BABAZHUL "How may Babazhul help you?"
    BABAZHUL "¿Cómo puede ayudarte Babazhul?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:47
translate es nov_soothsayer_firstmeet_44f8b91f:

    # MC "Hm? Child of what?"
    MC "¿Eh? ¿Hijo de qué?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:48
translate es nov_soothsayer_firstmeet_5ce13e03:

    # MC "What are you talking about?"
    MC "¿De qué estás hablando?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:53
translate es nov_soothsayer_firstmeet_70e666cf:

    # BABAZHUL "{i}The old gods stir with the new, the great games' next chapter shall soon begin.{/i}"
    BABAZHUL "{i}Los viejos dioses se agitan con los nuevos, pronto comenzará el próximo capítulo de los grandes juegos.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:54
translate es nov_soothsayer_firstmeet_909f2c0d:

    # BABAZHUL "{i}A great warrior shall join you, the great tooth and claw, a forgotten lord from a time lost beyond the stars.{/i}"
    BABAZHUL "{i}Un gran guerrero se unirá a ti, el gran diente y garra, un señor olvidado de un tiempo perdido más allá de las estrellas.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:55
translate es nov_soothsayer_firstmeet_92a43a18:

    # BABAZHUL "{i}To battle the dreaming king, whose restless fury shall scorch these lands.{/i}"
    BABAZHUL "{i}Para combatir al rey soñador, cuya furia inquieta abrasará estas tierras.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:56
translate es nov_soothsayer_firstmeet_127488ac:

    # MC "What the~"
    MC "¿Qué?~"

# game/data/characters/babazhul/novaras_soothsayer.rpy:57
translate es nov_soothsayer_firstmeet_086e21f9:

    # MC "Gods? A Dreaming king? Great warriors?"
    MC "¿Dioses? ¿Un rey soñador? ¿Grandes guerreros?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:60
translate es nov_soothsayer_firstmeet_8e3236f6:

    # "The soothsayer went silent for a moment, before continuing in her raspy voice:"
    "La adivina guardó silencio un momento, antes de continuar con su voz ronca:"

# game/data/characters/babazhul/novaras_soothsayer.rpy:70
translate es nov_soothsayer_firstmeet_ccab7ebe:

    # BABAZHUL "In time ... All will be clear, [player_name!t]."
    BABAZHUL "on el tiempo... Todo se aclarará, [player_name!t]."

# game/data/characters/babazhul/novaras_soothsayer.rpy:62
translate es nov_soothsayer_firstmeet_9cbf7f9a:

    # MC "...How did you know my-"
    MC "...¿Cómo sabías que mi-"

# game/data/characters/babazhul/novaras_soothsayer.rpy:63
translate es nov_soothsayer_firstmeet_f1768875:

    # BABAZHUL "Hahahaha!"
    BABAZHUL "¡Jajajaja!"


translate es strings:

    # game/data/characters/babazhul/novaras_soothsayer.rpy:21
    old "Talk to Babazhul"
    new "Hablar con Babazhul"

    # game/data/characters/babazhul/novaras_soothsayer.rpy:29
    old "Speak to me of the future, soothsayer."
    new "Háblame del futuro, adivina."

    # game/data/characters/babazhul/novaras_soothsayer.rpy:31
    old "I long to walk through my past once again."
    new "Anhelo caminar por mi pasado una vez más."

    # game/data/characters/babazhul/novaras_soothsayer.rpy:33
    old "I will return in time."
    new "Volveré con el tiempo."

    # game/data/characters/babazhul/novaras_soothsayer.rpy:49
    old "Babazhul"
    new "Babazhul"
