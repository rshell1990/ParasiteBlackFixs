    new "Hablemos de otra cosa..."

    # game/data/characters/bordello/arwen/scr_dialogue.rpy:18
    old "What do you think of Helena?"
    new "¿Qué opinas de Helena?"

    # game/data/characters/bordello/arwen/scr_dialogue.rpy:18
    old "What do you think of Shani?"
    new "¿Qué opinas de Shani?"

