

# game/data/characters/bordello/arwen/scr_dialogue.rpy:2
translate es dialogue_arwen_othergirls_d6300ee5:

    # ARWEN @ talk "Tell me darling, who in all of Mirnos would you want to talk about them... when {i}I'm{/i} by your side?"
    ARWEN @ talk "Dime querido, ¿quién en todo Mirnos le gustaría hablar de ellas... cuando {i}yo{/i} estoy a tu lado?"

# game/data/characters/bordello/arwen/scr_dialogue.rpy:15
translate es dialogue_arwen_othergirls_menu_f72c231a:

    # ARWEN @ talk "Well... Now you're speaking a girls favourite language!"
    ARWEN @ talk "Bien... ¡Ahora estás hablando el idioma favorito de las chicas!"

# game/data/characters/bordello/arwen/scr_dialogue.rpy:17
translate es dialogue_arwen_othergirls_menu_ab602309:

    # ARWEN @ talk "Was there someone specific you wanted to ask about?"
    ARWEN @ talk "¿Querías preguntar por alguien en concreto?"

# game/data/characters/bordello/arwen/scr_dialogue.rpy:20
translate es dialogue_arwen_othergirls_menu_paid_5c4b33c4:

    # ARWEN @ angry "Hm? Oh, {i}her{/i} I'd avoid her if I was you."
    ARWEN @ angry "¿Hmm? Oh, {i}ella{/i}, la evitaría si fuera tú."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:21
translate es dialogue_arwen_othergirls_menu_paid_d42b7565:

    # ARWEN @ angry "Overpriced to put it mildly, you'd think she was a virgin princess with how highly she views herself."
    ARWEN @ angry "Demasiado cara, por decirlo suavemente, cualquiera diría que es una princesa virgen con lo bien que se ve a sí misma."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:22
translate es dialogue_arwen_othergirls_menu_paid_1950d15a:

    # ARWEN @ blush "Don't worry though, I'll show you what a {i}real{/i} woman can do."
    ARWEN @ blush "Pero no te preocupes, te enseñaré lo que puede hacer una mujer {i}de verdad{/i}."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:25
translate es dialogue_arwen_othergirls_menu_paid_77c1d01c:

    # ARWEN @ think "Hmm, nice enough girl."
    ARWEN @ think "Hmm, una chica bastante agradable."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:26
translate es dialogue_arwen_othergirls_menu_paid_879dd5c5:

    # ARWEN @ talk "But I think she's a little {i}too{/i} desperate to work in here."
    ARWEN @ talk "Pero creo que está {i}un poco{/i} desesperada para trabajar aquí."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:27
translate es dialogue_arwen_othergirls_menu_paid_35cb4a19:

    # ARWEN @ talk "As far as I know, they let her stay and serve clients outside for a reduced rate, but I doubt she'll get through the door."
    ARWEN @ talk "Por lo que sé, la dejan quedarse y atender a los clientes fuera por una tarifa reducida, pero dudo que pase por la puerta."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:28
translate es dialogue_arwen_othergirls_menu_paid_da22f4ce:

    # MC @ talk "Why's that?"
    MC @ talk "¿Por qué?"

# game/data/characters/bordello/arwen/scr_dialogue.rpy:29
translate es dialogue_arwen_othergirls_menu_paid_8e2a16c2:

    # ARWEN @ talk "Look around you, we're not the {i}Black Diamond,{/i} we general serve adventurers and merchants with coin to burn."
    ARWEN @ talk "Mira a tu alrededor, no somos el {i}Diamante Negro,{/i}  en general servimos a aventureros y comerciantes con monedas para gastar."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:30
translate es dialogue_arwen_othergirls_menu_paid_e4fcf857:

    # ARWEN @ talk "And she's out there letting the city guard take put it in her ass behind a wall... Hardly a good fit."
    ARWEN @ talk "Y ella está por ahí dejando que la guardia municipal se la meta por el culo detrás de un muro... Difícilmente encajaría bien."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:31
translate es dialogue_arwen_othergirls_menu_paid_33eafac5:

    # MC @ talk "That seems rather harsh..."
    MC @ talk "Eso parece bastante duro..."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:32
translate es dialogue_arwen_othergirls_menu_paid_8c61c9e1:

    # ARWEN @ talk "It's just business darling... it's always cut-throat, no matter the trade."
    ARWEN @ talk "Son solo negocios, cariño... siempre son despiadados, no importa el oficio."

# game/data/characters/bordello/arwen/scr_dialogue.rpy:35
translate es dialogue_arwen_othergirls_menu_paid_480f5c90:

    # ARWEN @ talk "Alright then, was there something else?"
    ARWEN @ talk "De acuerdo entonces, ¿había algo más?"

# game/data/characters/bordello/arwen/scr_dialogue.rpy:38
translate es dialogue_arwen_othergirls_menu_paid_7417b5c7:

    # ARWEN @ talk "Alright then, let's hear it."
    ARWEN @ talk "Muy bien, escuchémoslo."

