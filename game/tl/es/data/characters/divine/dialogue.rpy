

# game/data/characters/divine/dialogue.rpy:32
translate es divine_talk_90c8d59c:

    # DIVINE "How can I help you, child?"
    DIVINE "¿En qué puedo ayudarte, hijo?"

# game/data/characters/divine/dialogue.rpy:38
translate es divine_bye_65c4d26d:

    # DIVINE "Be well, child."
    DIVINE "Cuídate, hijo."

# game/data/characters/divine/dialogue.rpy:44
translate es divine_questions1_528d4f7e:

    # DIVINE "You’ve come here for a lesson?"
    DIVINE "¿Has venido aquí para una lección?"

# game/data/characters/divine/dialogue.rpy:47
translate es divine_questions1_b6ffd923:

    # MC "I know the basics..."
    MC "Sé lo básico..."

# game/data/characters/divine/dialogue.rpy:46
translate es divine_questions1_81705d71:

    # DIVINE "... It is said the great goddess Palam was born Palon, God of Love."
    DIVINE "...Se dice que la gran diosa Palam nació como Palon, Dios del amor."

# game/data/characters/divine/dialogue.rpy:47
translate es divine_questions1_2fb56672:

    # DIVINE "Palon watched and meddled in the romantic affairs of both our realm and the realm of the gods. "
    DIVINE "Palon observaba y se entrometía en los asuntos románticos tanto de nuestro reino como del reino de los dioses. "

# game/data/characters/divine/dialogue.rpy:48
translate es divine_questions1_1687c0e9:

    # DIVINE "Uniting couples rarely thought a good match by many, but he always knew better."
    DIVINE "Muchos pensaban que unir parejas no era una buena idea, pero él siempre supo que no era así."

# game/data/characters/divine/dialogue.rpy:49
translate es divine_questions1_197036a6:

    # DIVINE "... But Palon was displeased with his form... He wanted his outer beauty to reflect the inner love he lavished upon us Alderians."
    DIVINE "...Pero Palon estaba disgustado con su forma... Quería que su belleza exterior reflejara el amor interior que nos prodigaba a los alderianos."

# game/data/characters/divine/dialogue.rpy:50
translate es divine_questions1_d31444e6:

    # DIVINE "Envious of the female forms around him and feeling trapped in despair at the male form he occupied, he cast himself into the Great Blue Lagoon, emerging as the beautiful goddess Palam."
    DIVINE "Envidioso de las formas femeninas a su alrededor y sintiéndose atrapado en la desesperación de la forma masculina que ocupaba, se arrojó a la Gran Laguna Azul, emergiendo como la hermosa diosa Palam."

# game/data/characters/divine/dialogue.rpy:51
translate es divine_questions1_88ca4f57:

    # DIVINE "The great goddess Palam bestows upon those born with her favour the greatest powers of healing in the realm."
    DIVINE "La gran diosa Palam otorga a los nacidos con su favor los mayores poderes curativos del reino."

# game/data/characters/divine/dialogue.rpy:52
translate es divine_questions1_91554ae3:

    # DIVINE "Through her wisdom and guidance, our bodies are also changed to her desired form."
    DIVINE "A través de su sabiduría y guía, nuestros cuerpos también cambian a su forma deseada."

# game/data/characters/divine/dialogue.rpy:55
translate es divine_questions1_7a9989a8:

    # MC "Is that why all the mages under her blessing were born as... born as..."
    MC "¿Es por eso que todos los magos bajo su bendición nacieron como... nacieron como..."

# game/data/characters/divine/dialogue.rpy:54
translate es divine_questions1_d23314df:

    # DIVINE "... Men?"
    DIVINE "...¿Hombres?"

# game/data/characters/divine/dialogue.rpy:57
translate es divine_questions1_07266d13:

    # MC "Yes."
    MC "Sí."

# game/data/characters/divine/dialogue.rpy:56
translate es divine_questions1_8241ba3e:

    # DIVINE "We all were once... But once the change has begun there is little difference."
    DIVINE "Todos lo fuimos alguna vez... Pero una vez que el cambio ha comenzado hay poca diferencia."

# game/data/characters/divine/dialogue.rpy:59
translate es divine_questions1_85be0231:

    # MC "But you have... {i}*Cough*{/i}"
    MC "Pero tienes... {i}*Tose*{/i}"

# game/data/characters/divine/dialogue.rpy:60
translate es divine_questions1_7aa6d0fb:

    # "Sister Divine raised an eyebrow and smirked as I tripped over the words. "
    "La hermana e enarcó una ceja y sonrió con satisfacción cuando tropecé con las palabras. "

# game/data/characters/divine/dialogue.rpy:59
translate es divine_questions1_84878a10:

    # DIVINE "{i}Both sets?{/i}"
    DIVINE "{i}¿Ambos?{/i}"

# game/data/characters/divine/dialogue.rpy:62
translate es divine_questions1_054508a6:

    # MC "U-Uhh... Well..."
    MC "U-Uhh... bueno..."

# game/data/characters/divine/dialogue.rpy:63
translate es divine_questions1_cf86a073:

    # MC "That... must be difficult."
    MC "Eso... debe ser difícil."

# game/data/characters/divine/dialogue.rpy:64
translate es divine_questions1_365ffb04:

    # "Sister Divine smiled mischievously as she leaned forward."
    "La hermana Divine sonrió con picardía mientras se inclinaba hacia delante."

# game/data/characters/divine/dialogue.rpy:63
translate es divine_questions1_b1140467:

    # DIVINE "If you’re that curious, why don’t you ask one of our mages?"
    DIVINE "Si tienes tanta curiosidad, ¿por qué no preguntas a una de nuestras magas?"

# game/data/characters/divine/dialogue.rpy:64
translate es divine_questions1_1c2f036e:

    # DIVINE "Our goddess, unlike most, demands we take no vows of chastity, you know..."
    DIVINE "Nuestra diosa, a diferencia de la mayoría, exige que no hagamos votos de castidad, ¿sabes?..."

# game/data/characters/divine/dialogue.rpy:67
translate es divine_questions1_61f8f826:

    # "Sister Divine playfully winked before her back straightened once again."
    "La hermana Divine guiñó un ojo juguetonamente antes de que su espalda se enderezara una vez más."

# game/data/characters/divine/dialogue.rpy:70
translate es divine_questions1_f399730a:

    # "She laughed at the comment."
    "Se rió ante el comentario."

# game/data/characters/divine/dialogue.rpy:69
translate es divine_questions1_eea35513:

    # DIVINE "{i}Interesting...{/i}"
    DIVINE "{i}Interesante...{/i}"

# game/data/characters/divine/dialogue.rpy:72
translate es divine_questions1_04e3a2bf:

    # "Her eyes scanned over me, almost dismissively."
    "Sus ojos me recorrieron, casi con desdén."

# game/data/characters/divine/dialogue.rpy:76
translate es divine_questions2_3054d177:

    # DIVINE "There is only ever a few hundred of us at one time... As the goddess wills..."
    DIVINE "Solo somos unas pocas cientos a la vez... como la diosa desea..."

# game/data/characters/divine/dialogue.rpy:79
translate es divine_questions2_5a08631f:

    # MC "Why?"
    MC "¿Por qué?"

# game/data/characters/divine/dialogue.rpy:78
translate es divine_questions2_ef2c2d25:

    # DIVINE "We do not know... Only some are chosen, it’s not our place to question her decisions."
    DIVINE "No lo sabemos... Solo algunas son elegidas, no nos corresponde a nosotros cuestionar sus decisiones."

# game/data/characters/divine/dialogue.rpy:96
translate es divine_firstmeet_28ad9124:

    # "The beautiful Mages of Palam, for all accounts were still human, though no cursory glance would make this obvious."
    "Las bellas magas de Palam, por lo que se ve, seguían siendo humanas, aunque ninguna mirada superficial lo haría evidente."

# game/data/characters/divine/dialogue.rpy:97
translate es divine_firstmeet_18aa2714:

    # "Born with the blessings of the goddess Palam, their bodies were morphed and now bore a blue complexion the goddess’ divine will moulds those chosen into her most desired form and then blesses them with her gift of divine healing."
    "Nacidas con las bendiciones de la diosa Palam, sus cuerpos se transformaron y ahora tienen una tez azul. La voluntad divina de la diosa moldea a los elegidos en su forma más deseada y luego los bendice con su don de curación divina."

# game/data/characters/divine/dialogue.rpy:98
translate es divine_firstmeet_587bb450:

    # "It is a place of ancient tradition, libraries of books piled high and strange hieroglyphs and runes on the floor in chalk that glowed different shades. "
    "Es un lugar de tradición antigua, con bibliotecas de libros apilados en lo alto y extraños jeroglíficos y runas en el suelo de tiza que brillaban con diferentes tonalidades. "

# game/data/characters/divine/dialogue.rpy:99
translate es divine_firstmeet_67703533:

    # "Taking centre stage was a great statue of the goddess Palam, her arms and wings outstretched. Here and there I glimpsed robed figures, their soft, blue faces barely visible before they quickly shuffled away with their spell books. "
    "En el centro del patio había una gran estatua de la diosa Palam, con los brazos y las alas extendidos. Aquí y allá vislumbré figuras con túnicas, cuyos rostros azules y suaves apenas eran visibles antes de que se alejaran rápidamente con sus libros de hechizos. "

# game/data/characters/divine/dialogue.rpy:100
translate es divine_firstmeet_95f6331a:

    # "A voice called out, sultry, but mature with age. "
    "Se oyó una voz sensual, pero madura por la edad. "

# game/data/characters/divine/dialogue.rpy:101
translate es divine_firstmeet_216aba99:

    # UNKNOWN "... Quite the sight, is it not?"
    UNKNOWN "... Todo un espectáculo, ¿verdad?"

# game/data/characters/divine/dialogue.rpy:104
translate es divine_firstmeet_44548582:

    # "I turned to look at the beautiful figure before me."
    "Me giré para contemplar la hermosa figura que tenía ante mí."

# game/data/characters/divine/dialogue.rpy:105
translate es divine_firstmeet_696b9602:

    # MC "Oh, I’m sorry I didn’t see you there, sister."
    MC "Oh, siento no haberte visto, hermana."

# game/data/characters/divine/dialogue.rpy:92
translate es divine_firstmeet_d9b3b42c:

    # DIVINE "You may call me Sister Divine... Now..."
    DIVINE "Puedes llamarme hermana Divine..."
    
translate es strings:

    # game/data/characters/divine/dialogue.rpy:15
    old "Talk to Divine"
    new "Hablar con Divine"

    # game/data/characters/divine/dialogue.rpy:19
    old "Can you tell me more about the goddess Palam?"
    new "¿Puedes hablarme más de la diosa Palam?"

    # game/data/characters/divine/dialogue.rpy:20
    old "How many of you are there?"
    new "¿Cuántas sois?"

    # game/data/characters/divine/dialogue.rpy:23
    old "That is all. Thank you, sister."
    new "Eso es todo. Gracias, hermana."

    # game/data/characters/divine/dialogue.rpy:68
    old "I think I’d rather ask you, Sister Divine..."
    new "Creo que prefiero preguntarte a ti, hermana Divine..."

    # game/data/characters/divine/dialogue.rpy:68
    old "I... Uh, right..."
    new "Yo... Uh, cierto..."
