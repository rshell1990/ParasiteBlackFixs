translate es drax_questions_53c1e4f7:

    # DRAX "What do you want to know?"
    DRAX "¿Qué quieres saber?"

# game/data/characters/drax/dialogue.rpy:81
translate es drax_qChanges_3056e47e:

    # DRAX "Not much to be honest, business carries on as usual here."
    DRAX "No mucho para ser honesto, el negocio sigue como de costumbre aquí."

# game/data/characters/drax/dialogue.rpy:82
translate es drax_qChanges_90be5fd6:

    # DRAX "Usual petty neighbour drama shite, more Black Mages getting caught..."
    DRAX "El drama habitual de los vecinos, más magos negros atrapados..."

# game/data/characters/drax/dialogue.rpy:83
translate es drax_qChanges_7d6bd86a:

    # DRAX "Biggest thing that’s happened for a while is you two coming home the way you did!"
    DRAX "¡Lo más grande que ha pasado desde hace tiempo es que vosotros dos hayáis vuelto a casa como lo habéis hecho!"

# game/data/characters/drax/dialogue.rpy:87
translate es drax_qBooks_629545c6:

    # DRAX "If you figure that one out..."
    DRAX "Si lo descubres..."

# game/data/characters/drax/dialogue.rpy:88
translate es drax_qBooks_ddd935a1:

    # "Drax placed his hand on my shoulder as he smiled."
    "Drax puso su mano en mi hombro mientras sonreía."

# game/data/characters/drax/dialogue.rpy:89
translate es drax_qBooks_27cb4f61:

    # DRAX "... Let me know!"
    DRAX "... ¡Házmelo saber!"

# game/data/characters/drax/dialogue.rpy:93
translate es drax_qEnd_d0d69c30:

    # DRAX "What else do you need?"
    DRAX "¿Qué más necesitas?"

# game/data/characters/drax/dialogue.rpy:97
translate es drax_bye_987ddf0d:

    # DRAX "Come back anytime."
    DRAX "Vuelve cuando quieras."

translate es strings:

    # game/data/characters/drax/dialogue.rpy:24
    old "Let me see your stock."
    new "Déjame ver qué tienes."

# game/data/characters/drax/dialogue.rpy:139
translate es drax_craft_00afb801:

    # DRAX "Anytime."
    DRAX "Cuando quieras."

# game/data/characters/drax/dialogue.rpy:144
translate es drax_craft_b9b6a99a:

    # DRAX "I can smelt you just about any kind of armor and weapons you'd like, trouble is, it ain't just about the coin."
    DRAX "Puedo fabricarte casi cualquier tipo de armadura y armas que quieras, el problema es que no se trata solo del dinero."

# game/data/characters/drax/dialogue.rpy:145
translate es drax_craft_78db8fb0:

    # DRAX "There's a shortage of raw materials coming in, and most of what {i}does{/i} come in goes to the war effort."
    DRAX "Hay escasez de materias primas, y la mayor parte de lo que {i}llega{/i} se destina al esfuerzo bélico."

# game/data/characters/drax/dialogue.rpy:146
translate es drax_craft_54c95bbc:

    # DRAX "If you want me to make you something, you may have to source the raw materials yourself..."
    DRAX "Si quieres que te haga algo, es posible que tengas que conseguir tú mismo las materias primas..."

# game/data/characters/drax/dialogue.rpy:150
translate es drax_craft_8e531321:

    # DRAX "Very well then... Let me know if you need anything!"
    DRAX "Muy bien entonces... ¡Avísame si necesitas algo!"

translate es strings:

    # game/data/characters/drax/dialogue.rpy:2
    old "Drax needs bronze scraps"
    new "Drax necesita chatarra de bronce"

    # game/data/characters/drax/dialogue.rpy:2
    old "A blacksmith of Novaras will take any bronze scraps I might scavenge in exchange for gold. He is only interested in batches of five, for whatever reason."
    new "Un herrero de Novaras aceptará la chatarra de bronce que pueda recoger a cambio de oro. Solo le interesan los lotes de cinco, por la razón que sea."

    # game/data/characters/drax/dialogue.rpy:22
    old "Here is some more bronze you wanted."
    new "Aquí tienes más bronce del que querías."

    # game/data/characters/drax/dialogue.rpy:25
    old "Can I see your wares?"
    new "¿Puedo ver tu mercancía?"
 
    # game/data/characters/drax/dialogue.rpy:26
    old "I have a few questions..."
    new "Tengo algunas preguntas..."

    # game/data/characters/drax/dialogue.rpy:27
    old "Has much changed since I left?"
    new "¿Ha cambiado mucho desde que me fui?"

    # game/data/characters/drax/dialogue.rpy:28
    old "Any ideas on getting into Arlena’s good books?"
    new "¿Alguna idea para conseguir impresionar a Arlena?"

    # game/data/characters/drax/dialogue.rpy:29
    old "I wanted to talk to you about crafting something for me."
    new "Quería hablar contigo sobre la elaboración de algo para mí."

    # game/data/characters/drax/dialogue.rpy:135
    old "Yes, there's something I'd like you to make for me..."
    new "Sí, hay algo que me gustaría que hicieras para mí..."

    # game/data/characters/drax/dialogue.rpy:135
    old "Could you explain it to me?"
    new "¿Podrías explicármelo?"

    # game/data/characters/drax/dialogue.rpy:135
    old "Nevermind, I've changed my mind."
    new "No importa, he cambiado de opinión."

    # game/data/characters/drax/dialogue.rpy:29
    old "That’s all for now."
    new "Eso es todo por ahora."

# game/data/characters/drax/dialogue.rpy:134
translate es drax_craft_a1dec31f:

    # DRAX "Ah! You need something forged?"
    DRAX "¡Ah! ¿Necesitas algo forjado?"
