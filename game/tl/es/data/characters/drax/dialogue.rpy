    # DRAX "No, that won't do."
    DRAX "No, eso no servirá."

# game/data/characters/drax/dialogue.rpy:65
translate es drax_bronzeDeliverRepeat_f30b4de7:

    # DRAX "Come back after you've scavenged more bronze."
    DRAX "Vuelve cuando hayas conseguido más bronce."

# game/data/characters/drax/dialogue.rpy:70
translate es drax_bronzeDeliverRepeat_5650b7ba:

    # DRAX "ARLENAAAAA!"
    DRAX "¡ARLENAAAAA!"

# game/data/characters/drax/dialogue.rpy:71
translate es drax_bronzeDeliverRepeat_0492f5f9:

    # DRAX "WE HAVE BRONZE!"
    DRAX "¡TENEMOS BRONCE!"

# game/data/characters/drax/dialogue.rpy:73
translate es drax_bronzeDeliverRepeat_ba0ec503:

    # "Arlena emerged once again with her arms folded."
    "Arlena salió de nuevo con los brazos cruzados"

# game/data/characters/drax/dialogue.rpy:78
translate es drax_bronzeDeliverRepeat_d11ff72d:

    # ARLENA "Not bad... Who knows? Maybe one day you'll be able to improve your personality like you've done your work ethic!"
    ARLENA "No está mal... ¿Quién sabe? ¡Quizá algún día puedas mejorar tu personalidad como has hecho con tu ética laboral!"

# game/data/characters/drax/dialogue.rpy:80
translate es drax_bronzeDeliverRepeat_dfe83138:

    # ARLENA "Hmph... It's better than nothing I suppose. Don't be getting sloppy on us now!"
    ARLENA "Hmph... Es mejor que nada, supongo. ¡No seas negligente con nosotros ahora!"

# game/data/characters/drax/dialogue.rpy:82
translate es drax_bronzeDeliverRepeat_b203b2ec:

    # ARLENA "I'm almost impressed!"
    ARLENA "¡Estoy casi impresionada!"

# game/data/characters/drax/dialogue.rpy:84
translate es drax_bronzeDeliverRepeat_269c09d7:

    # ARLENA "Urgh... Just take your gold and get out of here, I'm in no mood for you today."
    ARLENA "Urgh... Solo toma tu oro y vete de aquí, no estoy de humor para ti hoy."

# game/data/characters/drax/dialogue.rpy:90
