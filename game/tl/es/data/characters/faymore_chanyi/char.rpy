# game/data/characters/faymore_chanyi/char.rpy:60
translate es dialogue_temp_2_01b56d52:

    # ANYA @ sad "But I also understand {i}why{/i}, at least."
    ANYA @ sad "Pero también entiendo {i}por qué{/i}, al menos."

# game/data/characters/faymore_chanyi/char.rpy:61
translate es dialogue_temp_2_f16af576:

    # ANYA @ talk "I just hope he manages to find his own happiness."
    ANYA @ talk "Solo espero que consiga encontrar su propia felicidad."

# game/data/characters/faymore_chanyi/char.rpy:64
translate es dialogue_temp_2_9793a0f7:

    # ANYA @ happy "Serafina is doing {i}very{/i} well."
