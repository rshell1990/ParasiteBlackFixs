# game/data/characters/faymore_chanyi/char.rpy:58
translate es dialogue_temp_2_2c5ca7a4:

    # ANYA @ sad "No... And I don't suspect we will."
    ANYA @ sad "No... Y no creo que lo hagamos."

# game/data/characters/faymore_chanyi/char.rpy:59
translate es dialogue_temp_2_7829c0ee:

    # ANYA @ sad "I can't say I'm not furious at him for what he's done..."
