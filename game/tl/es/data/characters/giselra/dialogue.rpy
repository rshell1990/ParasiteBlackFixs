

# game/data/characters/giselra/dialogue.rpy:22
translate es giselra_talk_firstmeet_14cc07a6:

    # "The tailor's voice called from the back of the store."
    "La voz de la sastre resonó desde el fondo de la tienda."

# game/data/characters/giselra/dialogue.rpy:23
translate es giselra_talk_firstmeet_97f4d434:

    # GISELRA "One moment please!"
    GISELRA "¡Un momento, por favor!"

# game/data/characters/giselra/dialogue.rpy:24
translate es giselra_talk_firstmeet_e38541a5:

    # "I turned slowly, looking at the many intricately crafted dresses on display."
    "Me giré lentamente y contemplé los numerosos vestidos de intrincada confección que había expuestos."

# game/data/characters/giselra/dialogue.rpy:25
translate es giselra_talk_firstmeet_a05f0e9d:

    # "Whoever this tailor was, she was indeed of exceptional skill."
    "Fuera quien fuera esta sastre, sin duda poseía una habilidad excepcional."

# game/data/characters/giselra/dialogue.rpy:26
translate es giselra_talk_firstmeet_e71e1997:

    # "I heard soft footsteps, turning my head as an older, black woman stepped forward,"
    "Oí unos pasos suaves y giré la cabeza justo cuando una mujer negra de edad avanzada se acercaba."

# game/data/characters/giselra/dialogue.rpy:27
translate es giselra_talk_firstmeet_cfa5b9c1:

    # "With an infectiously warm smile, she greeted me."
    "Con una sonrisa cálida y contagiosa, me saludó."

# game/data/characters/giselra/dialogue.rpy:28
translate es giselra_talk_firstmeet_44893887:

    # GISELRA @ smile "Welcome to Giselra's handsome."
    GISELRA @ smile "Bienvenido a la tienda de Giselra, guapo."

# game/data/characters/giselra/dialogue.rpy:29
translate es giselra_talk_firstmeet_ec7dbf09:

    # GISELRA @ smile "The finest tailor in ALL of Hamun."
    GISELRA @ smile "La mejor sastre de TODO Hamun."

# game/data/characters/giselra/dialogue.rpy:30
translate es giselra_talk_firstmeet_e5ba6b5b:

    # MC @ smile "The finest you say?"
    MC @ smile "¿La mejor, dices?"

# game/data/characters/giselra/dialogue.rpy:31
translate es giselra_talk_firstmeet_e713de8a:

    # GISELRA @ talk "Of course, whatever clothes you desire, I can see them crafted."
    GISELRA @ talk "Por supuesto, sea cual sea la ropa que desees, podré confeccionarla."

# game/data/characters/giselra/dialogue.rpy:32
translate es giselra_talk_firstmeet_ddff3fa8:

    # GISELRA @ smile "{i}For a price, of course...{/i}"
    GISELRA @ smile "{i}Por un precio, claro...{/i}"

# game/data/characters/giselra/dialogue.rpy:33
translate es giselra_talk_firstmeet_c79a39bc:

    # GISELRA @ talk "Let me know if my services are of used."
    GISELRA @ talk "Avísame si te interesan mis servicios."

# game/data/characters/giselra/dialogue.rpy:34
translate es giselra_talk_firstmeet_81658a7e:

    # MC @ talk "Will do."
    MC @ talk "Lo haré."

# game/data/characters/giselra/dialogue.rpy:35
translate es giselra_talk_firstmeet_f8120a53:

    # MC "(Always handy to know a good tailor.)"
    MC "(Siempre viene bien conocer a una buena sastre)."

# game/data/characters/giselra/dialogue.rpy:42
translate es giselra_talk_a70b638e:

    # GISELRA @ shock "Welcome to Giselra’s!"
    GISELRA @ shock "¡Bienvenido a la tienda de Giselra!"

# game/data/characters/giselra/dialogue.rpy:43
translate es giselra_talk_c34ff831:

    # GISELRA @ smile "Looking for something tailored, perhaps?"
    GISELRA @ smile "¿Buscas algo a medida, tal vez?"

# game/data/characters/giselra/dialogue.rpy:48
translate es giselra_bye_412dc7b0:

    # GISELRA @ smile "Bye, lovely."
    GISELRA @ smile "Adiós, cariño."

