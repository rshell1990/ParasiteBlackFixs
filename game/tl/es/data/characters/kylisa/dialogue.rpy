

# game/data/characters/kylisa/dialogue.rpy:30
translate es kylisa_talk_985be56a:

    # KYLISA @ talk "You have returned... How may I help you?"
    KYLISA @ talk "Has vuelto... ¿En qué puedo ayudarte?"

# game/data/characters/kylisa/dialogue.rpy:37
translate es kylisa_bye_9bb97fc5:

    # KYLISA @ talk "May the blessings of the gods be with you."
    KYLISA @ talk "Que las bendiciones de los dioses te acompañen."

# game/data/characters/kylisa/dialogue.rpy:43
translate es kylisa_whoareyou_52dd919a:

    # KYLISA @ talk "I am the royal Mage, but given the... {i}change in leadership,{/i}"
    KYLISA @ talk "Soy la maga real, pero dado el... {i}cambio de liderazgo,{/i}"

# game/data/characters/kylisa/dialogue.rpy:44
translate es kylisa_whoareyou_e97fcb71:

    # KYLISA @ talk "I now serve at the Emperor's pleasure."
    KYLISA @ talk "Ahora sirvo a voluntad del Emperador."

# game/data/characters/kylisa/dialogue.rpy:47
translate es kylisa_whoareyou_d2173e34:

    # KYLISA @ angry "You should be careful asking such questions..."
    KYLISA @ angry "Debes tener cuidado al hacer estas preguntas..."

# game/data/characters/kylisa/dialogue.rpy:48
translate es kylisa_whoareyou_32ed9419:

    # KYLISA @ angry "One could take that question the wrong way."
    KYLISA @ angry "Alguien podría tomarse esa pregunta mal."

# game/data/characters/kylisa/dialogue.rpy:49
translate es kylisa_whoareyou_b11273ac:

    # MC @ talk "Forgive me, I did not mean any ill with it."
    MC @ talk "Perdóname, no pretendía nada malo con ello."

# game/data/characters/kylisa/dialogue.rpy:50
translate es kylisa_whoareyou_94c63cb9:

    # KYLISA @ sad "...He was kinder."
    KYLISA @ sad "...Él era más amable."

# game/data/characters/kylisa/dialogue.rpy:51
translate es kylisa_whoareyou_037383db:

    # KYLISA @ sad "Most talk of how Alcott saved us all and Mesamore would have doomed us all."
    KYLISA @ sad "La mayoría habla de cómo Alcott nos salvó a todos y Mesamore nos habría condenado a todos."

# game/data/characters/kylisa/dialogue.rpy:52
translate es kylisa_whoareyou_badfec21:

    # KYLISA @ sad "But many forget how we prospered under Mesamore before."
    KYLISA @ sad "Pero muchos olvidan cómo prosperamos antes con Mesamore."

# game/data/characters/kylisa/dialogue.rpy:53
translate es kylisa_whoareyou_676e62d6:

    # KYLISA @ sad "He was a kind king, one determined to tackle poverty in ways his predecessors never did, and life was good under him."
    KYLISA @ sad "Era un rey bondadoso, decidido a luchar contra la pobreza como nunca lo hicieron sus predecesores, y la vida era buena bajo su reinado."

# game/data/characters/kylisa/dialogue.rpy:54
translate es kylisa_whoareyou_e9272224:

    # KYLISA @ sad "He may not he been the strongest military mind, but what king could have ever been prepared for the threat of the Demorai in such short notice?"
    KYLISA @ sad "Puede que no fuera la mente militar más fuerte, pero ¿qué rey podría haber estado preparado para la amenaza de los Demorai en tan poco tiempo?"

# game/data/characters/kylisa/dialogue.rpy:55
translate es kylisa_whoareyou_86eb7477:

    # KYLISA @ talk "Alcott tried time and time again to push for more control over the lives of the realms citizens, and each time, Mesamore pushed back."
    KYLISA @ talk "Alcott intentó una y otra vez ejercer un mayor control sobre la vida de los ciudadanos del reino, pero Mesamore se opuso."

# game/data/characters/kylisa/dialogue.rpy:56
translate es kylisa_whoareyou_66935207:

    # KYLISA @ talk "Despite the war he faced, Mesamore always wanted us to see a future beyond it, he never wanted the realm to become nothing but the violent war machine it is today."
    KYLISA @ talk "A pesar de la guerra a la que se enfrentó, Mesamore siempre quiso que viéramos un futuro más allá de ella, nunca quiso que el reino se convirtiera en nada más que la violenta máquina de guerra que es hoy."

# game/data/characters/kylisa/dialogue.rpy:58
translate es kylisa_whoareyou_bd6b1af1:

    # KYLISA @ talk "There are no names remembered anymore when it comes to the war council, just numbers... Numbers thrown against other numbers."
    KYLISA @ talk "Ya no se recuerdan nombres cuando se trata del consejo de guerra, solo números... Números lanzados contra otros números."

# game/data/characters/kylisa/dialogue.rpy:59
translate es kylisa_whoareyou_36931427:

    # MC @ talk "But did we have any other choice?"
    MC @ talk "Pero, ¿teníamos otra opción?"

# game/data/characters/kylisa/dialogue.rpy:60
translate es kylisa_whoareyou_5d28ca3c:

    # KYLISA @ talk "In stopping the war? No... I feel that it was inevitable."
    KYLISA @ talk "¿Para detener la guerra? No... Creo que era inevitable."

# game/data/characters/kylisa/dialogue.rpy:61
translate es kylisa_whoareyou_e82d8ab8:

    # KYLISA @ angry "In what we've {i}become{/i} trying to win this war? Absolutely."
    KYLISA @ angry "¿En lo que nos hemos {i}convertido{/i} tratando de ganar esta guerra? Absolutamente."

# game/data/characters/kylisa/dialogue.rpy:62
translate es kylisa_whoareyou_c2947f18:

    # KYLISA @ sad "Now? We are all just expendable pieces for a meat grinder as we fight inch by inch for every piece of land."
    KYLISA @ sad "¿Y ahora? Todos somos piezas prescindibles para una picadora de carne mientras luchamos palmo a palmo por cada pedazo de tierra."

# game/data/characters/kylisa/dialogue.rpy:63
translate es kylisa_whoareyou_f9be3333:

    # KYLISA @ talk "Speak your mind."
    KYLISA @ talk "Di lo que piensas."

# game/data/characters/kylisa/dialogue.rpy:75
translate es kylisa_blessing_2e104e0a:

    # "Kylisa paused for a moment, then replied calmly:"
    "Kylisa se detuvo un momento y respondió con calma:"

# game/data/characters/kylisa/dialogue.rpy:74
translate es kylisa_blessing_c2d9f055:

    # KYLISA @ talk "The gods seem to already stand by your side, [player_name!t]."
    KYLISA @ talk "Los dioses parecen estar ya a tu lado,, [player_name!t]."

# game/data/characters/kylisa/dialogue.rpy:83
translate es kylisa_cleansing_12864e63:

    # KYLISA @ talk "The old or the new?"
    KYLISA @ talk "¿Lo viejo o lo nuevo?"

# game/data/characters/kylisa/dialogue.rpy:84
translate es kylisa_cleansing_1d31c4e5:

    # MC @ talk "Whoever will listen."
    MC @ talk "A quien quiera escuchar."

# game/data/characters/kylisa/dialogue.rpy:85
translate es kylisa_cleansing_afaa155c:

    # KYLISA @ talk "I may grant you their blessing..."
    KYLISA @ talk "Puedo concederte su bendición..."

# game/data/characters/kylisa/dialogue.rpy:86
translate es kylisa_cleansing_2ac6342c:

    # "She raised her head a bit, and from beneath her hood I saw a pair of glaring eyes, scanning into the very depths of my soul."
    "Levantó un poco la cabeza y, bajo su capucha, vi un par de ojos brillantes que escudriñaban en lo más profundo de mi alma."

# game/data/characters/kylisa/dialogue.rpy:87
translate es kylisa_cleansing_83721d0b:

    # "A gentle, barely-noticeable pulse of energy waved through my entire body, followed by a harsh, painful jitter:"
    "Un suave pulso de energía, apenas perceptible, recorrió todo mi cuerpo, seguido de una sacudida áspera y dolorosa:"

# game/data/characters/kylisa/dialogue.rpy:88
translate es kylisa_cleansing_28a75444:

    # BLACK "{b}THAT'S CLOSE ENOUGH.{/b}"
    BLACK "{b}ES LO SUFICIENTEMENTE CERCA.{/b}"

# game/data/characters/kylisa/dialogue.rpy:89
translate es kylisa_cleansing_9dfd0bef:

    # "Kylisa took half-a step back and murmured to herself:"
    "Kylisa dio medio paso atrás y murmuró para sí misma:"

# game/data/characters/kylisa/dialogue.rpy:90
translate es kylisa_cleansing_3b48ba2d:

    # KYLISA @ talk "That energy... It is not Demorai, yet so strong..."
    KYLISA @ talk "Esa energía... No es Demorai, pero es tan fuerte..."

# game/data/characters/kylisa/dialogue.rpy:91
translate es kylisa_cleansing_f9a3b82b:

    # "She recomposed herself and concluded:"
    "Se recompuso y concluyó:"

# game/data/characters/kylisa/dialogue.rpy:90
translate es kylisa_cleansing_f6b8311c:

    # KYLISA @ talk "I don't know what exactly you came in contact with, [player_name!t], but I might be able to help."
    KYLISA @ talk "No sé con qué entraste en contacto exactamente, [player_name!t], pero podría ayudar."

# game/data/characters/kylisa/dialogue.rpy:93
translate es kylisa_cleansing_e98a2fd8:

    # KYLISA @ talk "I believe I can douse this... black flame that is devouring your soul."
    KYLISA @ talk "Creo que puedo sofocar esta... llama negra que está devorando tu alma."

# game/data/characters/kylisa/dialogue.rpy:94
translate es kylisa_cleansing_cdf02e73:

    # "I gulped at the 'devouring' part."
    "Tragué saliva al oír la parte de 'devorar'."

# game/data/characters/kylisa/dialogue.rpy:95
translate es kylisa_cleansing_df3a112b:

    # KYLISA @ talk "I can only do so much as to set back it's {i}progress{/i}."
    KYLISA @ talk "No puedo hacer más que retrasar su {i}progreso{/i}."

# game/data/characters/kylisa/dialogue.rpy:96
translate es kylisa_cleansing_d7f274bb:

    # KYLISA @ talk "Five hundred coin."
    KYLISA @ talk "Quinientas monedas."

# game/data/characters/kylisa/dialogue.rpy:97
translate es kylisa_cleansing_1d60de78:

    # KYLISA @ talk "I can help you douse the black flame, [player_name!t]."
    KYLISA @ talk "Puedo ayudarte a sofocar la llama negra, [player_name!t]."

# game/data/characters/kylisa/dialogue.rpy:100
translate es kylisa_cleansing_38174cec:

    # KYLISA @ talk "You should seek a more... permanent solution though, for I can see the flame leaving it's scorching marks on your soul as we speak."
    KYLISA @ talk "Sin embargo, deberías buscar una solución más... permanente, porque puedo ver cómo la llama deja sus marcas abrasadoras en tu alma mientras hablamos."

# game/data/characters/kylisa/dialogue.rpy:101
translate es kylisa_cleansing_d7f274bb_1:

    # KYLISA @ talk "Five hundred coin."
    KYLISA @ talk "Quinientas monedas."

# game/data/characters/kylisa/dialogue.rpy:101
translate es kylisa_cleansing_4f3629c4:

    # KYLISA @ talk "I cannot do this again, [player_name!t]."
    KYLISA @ talk "No puedo hacerlo de nuevo, [player_name!t]."

# game/data/characters/kylisa/dialogue.rpy:104
translate es kylisa_cleansing_9e0beb61:

    # KYLISA @ talk "I need to regain my strength."
    KYLISA @ talk "Necesito recuperar mis fuerzas."

# game/data/characters/kylisa/dialogue.rpy:105
translate es kylisa_cleansing_70884999:

    # KYLISA @ talk "Come find me tomorrow, I will help you with your... condition."
    KYLISA @ talk "Ven a buscarme mañana, te ayudaré con tu... condición."

# game/data/characters/kylisa/dialogue.rpy:106
translate es kylisa_cleansing_6188caea:

    # MC @ talk "I see."
    MC @ talk "Ya veo."

# game/data/characters/kylisa/dialogue.rpy:112
translate es kylisa_cleansing_27517054:

    # "Pain began to quickly consume my body just as Kylisa raised her staff and pointed it at me:"
    "El dolor empezó a consumir rápidamente mi cuerpo justo cuando Kylisa levantó su bastón y me apuntó con él:"

# game/data/characters/kylisa/dialogue.rpy:120
translate es kylisa_cleansing_2a9f7495:

    # KYLISA @ talk "It is done."
    KYLISA @ talk "Está hecho."

# game/data/characters/kylisa/dialogue.rpy:121
translate es kylisa_cleansing_700ec46a:

    # "Feeling refreshed and... in control again, I exhaled."
    "Sintiéndome renovado y... en control de nuevo, exhalé."

# game/data/characters/kylisa/dialogue.rpy:122
translate es kylisa_cleansing_ec3d2f8f:

    # MC @ talk "Thanks, Kylisa."
    MC @ talk "Gracias, Kylisa."

# game/data/characters/kylisa/dialogue.rpy:121
translate es kylisa_cleansing_3b24004c:

    # KYLISA @ talk "It is my pleasure, [player_name!t]."
    KYLISA @ talk "El placer es mío, [player_name!t]."

# game/data/characters/kylisa/dialogue.rpy:126
translate es kylisa_cleansing_51095b9f:

    # KYLISA @ talk "Very well."
    KYLISA @ talk "Muy bien."

# game/data/characters/kylisa/dialogue.rpy:86
translate es kylisa_teachmeaboutgods_585e28d8:

    # KYLISA @ talk "One would hope your education would have taught you this already."
    KYLISA @ talk "Uno esperaría que su educación ya le hubiera enseñado esto."

# game/data/characters/kylisa/dialogue.rpy:87
translate es kylisa_teachmeaboutgods_47f46502:

    # MC @ talk "It has been some time since I last read the holy text... I could do with a refresher."
    MC @ talk "Ha pasado algún tiempo desde la última vez que leí el texto sagrado... Me vendría bien un repaso."

# game/data/characters/kylisa/dialogue.rpy:88
translate es kylisa_teachmeaboutgods_4913f092:

    # KYLISA @ talk "Very well, what do you wish to know about?"
    KYLISA @ talk "Muy bien, ¿qué quieres saber?"

# game/data/characters/kylisa/dialogue.rpy:135
translate es kylisa_teachmeaboutgods_menu_fd8d020e:

    # KYLISA @ talk "In the beginning, Al'Vazah, the great creator, formed the old gods and gave them dominion across the stars."
    KYLISA @ talk "En el principio, Al'Vazah, el gran creador, formó a los antiguos dioses y les otorgó el dominio de las estrellas."

# game/data/characters/kylisa/dialogue.rpy:136
translate es kylisa_teachmeaboutgods_menu_82262e83:

    # KYLISA @ talk "As life flourished, the old gods grew accustomed to their worship, and saw themselves as higher beings who became obsessed with their own power games against each other."
    KYLISA @ talk "A medida que la vida florecía, los antiguos dioses se acostumbraron a su culto y se vieron a sí mismos como seres superiores que se obsesionaron con sus propios juegos de poder contra los demás."

# game/data/characters/kylisa/dialogue.rpy:135
translate es kylisa_teachmeaboutgods_menu_3f1a19fe:

    # KYLISA @ talk "The old gods would often toy with those they viewed as lesser beings, and could only be roused to help with the offer of bargains and sacrifices."
    KYLISA @ talk "Los antiguos dioses jugaban a menudo con los que consideraban seres inferiores, y solo se les podía convencer para que ayudaran ofreciéndoles tratos y sacrificios."

# game/data/characters/kylisa/dialogue.rpy:138
translate es kylisa_teachmeaboutgods_menu_d2783f91:

    # KYLISA @ talk "Al'Vazah, displeased with what had become of the old gods, formed the new gods and also gave them powerful dominions to rule across the stars."
    KYLISA @ talk "Al'Vazah, disgustado con lo que había sido de los antiguos dioses, formó los nuevos dioses y también les dio poderosos dominios para gobernar a través de las estrellas."

# game/data/characters/kylisa/dialogue.rpy:139
translate es kylisa_teachmeaboutgods_menu_581b3849:

    # KYLISA @ talk "The new gods in contrast, believed it was their duty to guide the mortal races to a higher state of being."
    KYLISA @ talk "Los nuevos dioses, por el contrario, creían que su deber era guiar a las razas mortales hacia un estado superior del ser."

# game/data/characters/kylisa/dialogue.rpy:140
translate es kylisa_teachmeaboutgods_menu_7964fec4:

    # KYLISA @ talk "They openly chose to walk amongst us, and pull back the veil of secrecy that the old gods always maintained."
    KYLISA @ talk "Eligieron abiertamente caminar entre nosotros y apartar el velo de secretismo que siempre mantuvieron los antiguos dioses."

# game/data/characters/kylisa/dialogue.rpy:141
translate es kylisa_teachmeaboutgods_menu_b4f9b1d2:

    # KYLISA @ talk "Threatened, the old gods battled the new gods for supremacy in a great war we now know as the first war of the gods."
    KYLISA @ talk "Amenazados, los antiguos dioses lucharon contra los nuevos por la supremacía en una gran guerra que hoy conocemos como la primera guerra de los dioses."

# game/data/characters/kylisa/dialogue.rpy:142
translate es kylisa_teachmeaboutgods_menu_69aae19d:

    # KYLISA @ talk "The new gods emerged victorious, led Al'Vazah's champion and the most powerful of all the gods, Tzenvachican."
    KYLISA @ talk "Los nuevos dioses salieron victoriosos, liderados por el campeón de Al'Vazah y el más poderoso de todos los dioses, Tzenvachican."

# game/data/characters/kylisa/dialogue.rpy:143
translate es kylisa_teachmeaboutgods_menu_2257425a:

    # KYLISA @ talk "The old gods agreed to an uneasy truce talk, their dominion greatly reduced as the new gods triumphed over them."
    KYLISA @ talk "Los antiguos dioses acordaron una incómoda tregua, ya que su dominio se redujo considerablemente a medida que los nuevos dioses triunfaban sobre ellos."

# game/data/characters/kylisa/dialogue.rpy:144
translate es kylisa_teachmeaboutgods_menu_7cf2ca4a:

    # KYLISA @ talk "And thus began the longest long golden age of history till Malakai's war."
    KYLISA @ talk "Y así comenzó la más larga edad de oro de la historia hasta la guerra de Malakai."

# game/data/characters/kylisa/dialogue.rpy:147
translate es kylisa_teachmeaboutgods_menu_9b93dd68:

    # KYLISA @ talk "Over at least ten thousand years had passed since the end of the first War of the gods."
    KYLISA @ talk "Habían pasado al menos diez mil años desde el final de la primera guerra de los dioses."

# game/data/characters/kylisa/dialogue.rpy:148
translate es kylisa_teachmeaboutgods_menu_83ff4786:

    # KYLISA @ talk "It is said, the uneasy peace between the old gods and the new had become more strenuous than ever, as the old gods had begun to rally around their own Champion, Shal'krin who they saw might restore them to former glory."
    KYLISA @ talk "Se dice que la incómoda paz entre los antiguos dioses y los nuevos se había vuelto más tensa que nunca, ya que los antiguos dioses habían empezado a unirse en torno a su propio Campeón, Shal'krin, a quien veían capaz de devolverles su antigua gloria."

# game/data/characters/kylisa/dialogue.rpy:149
translate es kylisa_teachmeaboutgods_menu_ca20eac1:

    # KYLISA @ talk "But it was not Shal'Krin who bought about the second war of the gods."
    KYLISA @ talk "Pero no fue Shal'Krin quien causó la segunda guerra de los dioses."

# game/data/characters/kylisa/dialogue.rpy:150
translate es kylisa_teachmeaboutgods_menu_87e758b6:

    # KYLISA @ talk "Malakai the curious and kind, was decieved by the goddess of chaos, Gimera, that the only way to prevent the coming war was to open the Necronimis, a ancient box formed and sealed away by Al'Vazah at the start of his great creation."
    KYLISA @ talk "Malakai el curioso y bondadoso, fue engañado por la diosa del caos, Gimera, de que la única manera de prevenir la guerra que se avecinaba era abrir el Necronimis, una antigua caja formada y sellada por Al'Vazah al comienzo de su gran creación."

# game/data/characters/kylisa/dialogue.rpy:151
translate es kylisa_teachmeaboutgods_menu_0330a784:

    # KYLISA @ talk "Malakai opened the box hoping to learn the knowledge inside and use it for good, but instead, he absorbed all the darkness and evils of life itself."
    KYLISA @ talk "Malakai abrió la caja con la esperanza de aprender los conocimientos de su interior y utilizarlos para el bien, pero en su lugar, absorbió toda la oscuridad y los males de la vida."

# game/data/characters/kylisa/dialogue.rpy:152
translate es kylisa_teachmeaboutgods_menu_05c3b3b7:

    # KYLISA @ talk "Reborn as Malakai the deciever, the dark shifter, the prince of blood and the lord of darkness."
    KYLISA @ talk "Renace como Malakai el embaucador, el cambiaforma oscuro, el príncipe de la sangre y el señor de las tinieblas."

# game/data/characters/kylisa/dialogue.rpy:153
translate es kylisa_teachmeaboutgods_menu_edff8c10:

    # KYLISA @ talk "Malakai overthrew Shal'Krin and declared himself god of gods, declaring war against Al'Vazah and Tzenvachian."
    KYLISA @ talk "Malakai derrocó a Shal'Krin y se declaró dios de dioses, declarando la guerra a Al'Vazah y Tzenvachian."

# game/data/characters/kylisa/dialogue.rpy:154
translate es kylisa_teachmeaboutgods_menu_707d5d08:

    # KYLISA @ talk "Both old and new gods become factioned within themselves, taking sides either with Tzenvachian's forces or with Malakai's."
    KYLISA @ talk "Tanto los dioses antiguos como los nuevos se dividieron en facciones, tomando partido por las fuerzas de Tzenvachian o por las de Malakai."

# game/data/characters/kylisa/dialogue.rpy:155
translate es kylisa_teachmeaboutgods_menu_469a5e24:

    # KYLISA @ talk "Brother slew brother, and old enemies now found themselves fighting shoulder to shoulder."
    KYLISA @ talk "Hermano mataba a hermano, y viejos enemigos se encontraban ahora luchando hombro con hombro."

# game/data/characters/kylisa/dialogue.rpy:156
translate es kylisa_teachmeaboutgods_menu_b06b04db:

    # KYLISA @ talk "Some followed Malakai out of fear, while others, genuinely believed in the warped vision of the mad god that he alone could bring about the {i}perfect{/i} world."
    KYLISA @ talk "Algunos seguían a Malakai por miedo, mientras que otros creían sinceramente en la retorcida visión del dios loco de que solo él podía hacer realidad el mundo {i}perfecto{/i}."

# game/data/characters/kylisa/dialogue.rpy:157
translate es kylisa_teachmeaboutgods_menu_a4c8291c:

    # KYLISA @ talk "While little is fully understood of what happened next, we know that thousands of mortal races joined the great war, and world upon world was engulfed in flames."
    KYLISA @ talk "Aunque poco se sabe de lo que ocurrió después, sabemos que miles de razas mortales se unieron a la gran guerra y que un mundo tras otro quedó envuelto en llamas."

# game/data/characters/kylisa/dialogue.rpy:158
translate es kylisa_teachmeaboutgods_menu_e1af33ed:

    # KYLISA @ talk "The gods that had once flourished, were decimated, until finally, Malakai himself faced off with Tzenvachian."
    KYLISA @ talk "Los dioses que una vez habían florecido, fueron diezmados, hasta que finalmente, el propio Malakai se enfrentó a Tzenvachian."

# game/data/characters/kylisa/dialogue.rpy:159
translate es kylisa_teachmeaboutgods_menu_f08591e2:

    # KYLISA @ talk "There battle, as it was written, is beyond our comprehension, but the result seems to be that Malakai's physical form was destroyed at the cost of both Tzenvachian sacrificing himself by trapping their souls in some eternal battle."
    KYLISA @ talk "La batalla, tal y como fue escrita, está más allá de nuestra comprensión, pero el resultado parece ser que la forma física de Malakai fue destruida a costa de que ambos Tzenvachian se sacrificaran atrapando sus almas en una batalla eterna."

# game/data/characters/kylisa/dialogue.rpy:160
translate es kylisa_teachmeaboutgods_menu_4abad51c:

    # KYLISA @ talk "Thus ending the second war of the gods."
    KYLISA @ talk "Terminando así la segunda guerra de los dioses."

# game/data/characters/kylisa/dialogue.rpy:163
translate es kylisa_teachmeaboutgods_menu_37a59d9c:

    # KYLISA @ talk "Hmm, not much is written on this part."
    KYLISA @ talk "Hmm, no hay mucho escrito sobre esta parte."

# game/data/characters/kylisa/dialogue.rpy:164
translate es kylisa_teachmeaboutgods_menu_a03c6b89:

    # KYLISA @ talk "Only the passing words of troubled surviving gods who have, throughout the ages, passed through our world and alluded to what happened."
    KYLISA @ talk "Solo las palabras pasajeras de atribulados dioses supervivientes que, a lo largo de los tiempos, han pasado por nuestro mundo y aludido a lo sucedido."

# game/data/characters/kylisa/dialogue.rpy:165
translate es kylisa_teachmeaboutgods_menu_372845a7:

    # KYLISA @ talk "But it's... difficult to always decipher their meaning."
    KYLISA @ talk "Pero es... difícil descifrar siempre su significado."

# game/data/characters/kylisa/dialogue.rpy:166
translate es kylisa_teachmeaboutgods_menu_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "¿A qué te refieres?"

# game/data/characters/kylisa/dialogue.rpy:167
translate es kylisa_teachmeaboutgods_menu_af75ed5d:

    # KYLISA @ talk "Do keep in mind, much of this is heavily debated by scholars and such, I cannot speak from official doctrine when I discuss it."
    KYLISA @ talk "Ten en cuenta que mucho de esto es muy debatido por eruditos y demás, no puedo hablar desde la doctrina oficial cuando lo comento."

# game/data/characters/kylisa/dialogue.rpy:168
translate es kylisa_teachmeaboutgods_menu_5bae4f2d:

    # KYLISA @ talk "From the various legends and smaller texts I have gathered, some of the scarred surviving gods explained that the old wars were fought with 'mechanical dragons that surfed the stars' and other such strange things."
    KYLISA @ talk "De las diversas leyendas y textos menores que he recopilado, algunos de los dioses supervivientes explicaban que las antiguas guerras se libraban con 'dragones mecánicos que surcaban las estrellas' y otras cosas extrañas."

# game/data/characters/kylisa/dialogue.rpy:169
translate es kylisa_teachmeaboutgods_menu_9c944004:

    # KYLISA @ talk "These dragons they struggled to feed in the aftermath of the war, and as food and other resources dwindled, they fought amongst each other for what very little remained."
    KYLISA @ talk "Estos dragones lucharon por alimentarse tras la guerra y, a medida que disminuían los alimentos y otros recursos, lucharon entre sí por lo poco que quedaba."

# game/data/characters/kylisa/dialogue.rpy:170
translate es kylisa_teachmeaboutgods_menu_0132bbc2:

    # KYLISA @ talk "Apparently it was the darkest of times..."
    KYLISA @ talk "Aparentemente era la época más oscura..."

# game/data/characters/kylisa/dialogue.rpy:171
translate es kylisa_teachmeaboutgods_menu_48a85e92:

    # "Kylisa smiled."
    "Kylisa sonrió."

# game/data/characters/kylisa/dialogue.rpy:172
translate es kylisa_teachmeaboutgods_menu_1f4113f5:

    # KYLISA @ smile "We don't know for sure about that part."
    KYLISA @ smile "No estamos seguros de esa parte."

# game/data/characters/kylisa/dialogue.rpy:173
translate es kylisa_teachmeaboutgods_menu_828e0014:

    # KYLISA @ smile "Mechanical dragons flying through the stars... What a strange idea."
    KYLISA @ smile "Dragones mecánicos volando por las estrellas... Qué idea tan extraña."

# game/data/characters/kylisa/dialogue.rpy:174
translate es kylisa_teachmeaboutgods_menu_9b93778a:

    # KYLISA @ smile "I do wonder sometimes what the gods could have meant by that."
    KYLISA @ smile "A veces me pregunto qué habrán querido decir los dioses con eso."

# game/data/characters/kylisa/dialogue.rpy:177
translate es kylisa_teachmeaboutgods_menu_ea6b7d7e:

    # KYLISA @ talk "As you wish."
    KYLISA @ talk "Como quieras."

# game/data/characters/kylisa/dialogue.rpy:178
translate es kylisa_teachmeaboutgods_menu_ff8a948b:

    # KYLISA @ talk "Anything else?"
    KYLISA @ talk "¿Algo más?"

# game/data/characters/kylisa/dialogue.rpy:142
translate es nov_kylisa_firstmeet_2c51f77f:

    # KYLISA @ talk "Ah, it is good to see you walking."
    KYLISA @ talk "Ah, es bueno verte caminar."

# game/data/characters/kylisa/dialogue.rpy:143
translate es nov_kylisa_firstmeet_68041ff4:

    # MC @ talk "Huh? Have we met before?"
    MC @ talk "¿Eh? ¿Nos conocemos?"

# game/data/characters/kylisa/dialogue.rpy:144
translate es nov_kylisa_firstmeet_c69e673f:

    # KYLISA @ smile "Have you forgotten so quickly when I helped tend to your wounds?"
    KYLISA @ smile "¿Has olvidado tan rápido cuando te ayudé a curar tus heridas?"

# game/data/characters/kylisa/dialogue.rpy:145
translate es nov_kylisa_firstmeet_483c32a8:

    # "I remembered her now, the mage who arrived with Alcott."
    "Ahora lo recuerdo, la maga que llegó con Alcott."

# game/data/characters/kylisa/dialogue.rpy:146
translate es nov_kylisa_firstmeet_cb39066d:

    # MC @ surprised "You're the Emperor's Mage!"
    MC @ surprised "¡Eres la maga del emperador!"

# game/data/characters/kylisa/dialogue.rpy:147
translate es nov_kylisa_firstmeet_33f2b025:

    # KYLISA @ talk "Kylisa."
    KYLISA @ talk "Kylisa."

# game/data/characters/kylisa/dialogue.rpy:148
translate es nov_kylisa_firstmeet_375219c2:

    # KYLISA @ talk "Tell me, what brings you here?"
    KYLISA @ talk "Dime, ¿qué te trae por aquí?"

# game/data/characters/kylisa/dialogue.rpy:149
translate es nov_kylisa_firstmeet_021d7d2c:

    # KYLISA @ talk "Have you come to pray to the gods?"
    KYLISA @ talk "¿Has venido a rezar a los dioses?"

