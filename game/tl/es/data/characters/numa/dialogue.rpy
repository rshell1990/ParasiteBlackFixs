    # UNKNOWN "Are you well?"
    UNKNOWN "¿Te encuentras bien?"

# game/data/characters/numa/dialogue.rpy:129
translate es numa_firstmeet_4d3ad600:

    # UNKNOWN "Your mind seems adrift."
    UNKNOWN "Tu mente parece navegar a la deriva. ¿Estás bien?"

