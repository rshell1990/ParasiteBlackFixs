    MC "(¿Qué estás-?)"

# game/data/characters/numa/dialogue.rpy:119
translate es numa_firstmeet_21e16c80:

    # UNKNOWN @ angry "... You must be new here, surface-breather."
    UNKNOWN @ angry "... Debes ser nuevo aquí, respirador de superfície."

# game/data/characters/numa/dialogue.rpy:120
translate es numa_firstmeet_ddf856bd:

    # MC @ surprised "I can understand you!"
    MC @ surprised "¡Puedo entenderte!"

# game/data/characters/numa/dialogue.rpy:121
translate es numa_firstmeet_35fb6662:

    # "My reply to her, almost instinctively, was one I understood... {i}but it was not Alderian words which flowed from my lips.{/i}"
    "Mi respuesta a ella, casi instintivamente, fue una que entendí... {i}pero no fueron palabras alderianas las que fluyeron de mis labios.{/i}"

# game/data/characters/numa/dialogue.rpy:122
translate es numa_firstmeet_14312edc:

    # "The fish like woman seemed taken aback."
    "La mujer pez parecía sorprendida"

# game/data/characters/numa/dialogue.rpy:123
translate es numa_firstmeet_02d8a1e7:

    # UNKNOWN @ surprised "... Your Thalvënn is excellent!"
    UNKNOWN @ surprised "... ¡Tu thalvënn es excelente!"

# game/data/characters/numa/dialogue.rpy:124
translate es numa_firstmeet_a4eeee01:

    # UNKNOWN @ smile "I don't think I've ever heard a surface breather speak the wave so clearly!"
    UNKNOWN @ smile "¡Creo que nunca he oído a un respirador de superficie hablar la ola tan claramente!"

# game/data/characters/numa/dialogue.rpy:125
translate es numa_firstmeet_af35acdf:

    # MC "(How did you-)"
    MC "(¿Cómo-?)"

