

# game/data/characters/numa/dialogue.rpy:43
translate es numa_moreaboutpeople_4dff1363:

    # NUMA @ talk "Speak the wave, and I shall answer."
    NUMA @ talk "Habla la ola, y te responderé."

# game/data/characters/numa/dialogue.rpy:46
translate es numa_moreaboutpeople_menu_f26655da:

    # NUMA @ talk "Once a month, our people wash up on the docks bringing supplies and gifts."
    NUMA @ talk "Una vez al mes, los nuestros llegan a los muelles trayendo provisiones y regalos."

# game/data/characters/numa/dialogue.rpy:47
translate es numa_moreaboutpeople_menu_0f7b9bbf:

    # NUMA @ talk "Treasure from sunken ships, pearls, some fish..."
    NUMA @ talk "Tesoros de barcos hundidos, perlas, algunos peces..."

# game/data/characters/numa/dialogue.rpy:48
translate es numa_moreaboutpeople_menu_f222a1c7:

    # NUMA @ talk "In return, we are given weapons and armours forged."
    NUMA @ talk "A cambio, nos dan armas y armaduras bien forjadas."

# game/data/characters/numa/dialogue.rpy:49
translate es numa_moreaboutpeople_menu_b1ea096b:

    # MC @ think "Why would you need such things?"
    MC @ think "¿Para qué necesitáis esas cosas?"

# game/data/characters/numa/dialogue.rpy:50
translate es numa_moreaboutpeople_menu_93d5f8b3:

    # NUMA @ serious "... The waves are a turbulent thing."
    NUMA @ serious "... Las olas son algo turbulento."

# game/data/characters/numa/dialogue.rpy:51
translate es numa_moreaboutpeople_menu_088c241e:

    # NUMA @ talk "They turn towards war."
    NUMA @ talk "Se dirigen hacia la guerra."

# game/data/characters/numa/dialogue.rpy:52
translate es numa_moreaboutpeople_menu_416963ed:

    # MC @ think "War? What war?"
    MC @ think "¿Guerra? ¿Qué guerra?"

# game/data/characters/numa/dialogue.rpy:53
translate es numa_moreaboutpeople_menu_7ed5d058:

    # NUMA @ talk "It matters not for you surface breathers."
    NUMA @ talk "A los que respiráis en la superficie, no os concierne."

# game/data/characters/numa/dialogue.rpy:54
translate es numa_moreaboutpeople_menu_ad0fd71f:

    # NUMA @ talk "There are many fiefdoms vying for power below the currents."
    NUMA @ talk "Hay muchos feudos que se disputan el poder por debajo de las corrientes."

# game/data/characters/numa/dialogue.rpy:55
translate es numa_moreaboutpeople_menu_35287cb9:

    # NUMA @ talk "The senate-"
    NUMA @ talk "El senado-"

# game/data/characters/numa/dialogue.rpy:56
translate es numa_moreaboutpeople_menu_e906b857:

    # "She stopped herself, her lips curling into a forced smile."
    "Se detuvo y sus labios se curvaron en una sonrisa forzada."

# game/data/characters/numa/dialogue.rpy:57
translate es numa_moreaboutpeople_menu_24708383:

    # NUMA @ smile "Forgive me, your Thalvën is so good, I forgot myself for a moment."
    NUMA @ smile "Perdóname, tu thalvën es tan bueno, que me olvidé por un momento."

# game/data/characters/numa/dialogue.rpy:61
translate es numa_moreaboutpeople_menu_f6a7145e:

    # NUMA @ talk "In order to maintain good relations with the merchants, a few of our Thalay kin were asked to work within the city."
    NUMA @ talk "Para mantener buenas relaciones con los mercaderes, se pidió a algunos de los thalay que trabajaran en la ciudad."

# game/data/characters/numa/dialogue.rpy:62
translate es numa_moreaboutpeople_menu_38f5e1d4:

    # NUMA @ talk "It is purely for diplomatic reasons, they even asked what role we would like."
    NUMA @ talk "Es puramente por razones diplomáticas, incluso nos preguntaron qué funciones queríamos."

# game/data/characters/numa/dialogue.rpy:63
translate es numa_moreaboutpeople_menu_dc0e7cd8:

    # NUMA @ smile "I asked to help run a library, so they had built this place to accomodate my needs."
    NUMA @ smile "Pedí ayuda para dirigir una biblioteca, así que construyeron este lugar para adaptarlo a mis necesidades."

# game/data/characters/numa/dialogue.rpy:64
translate es numa_moreaboutpeople_menu_b4acba9f:

    # MC @ think "They built a whole library for you?"
    MC @ think "¿Construyeron toda una biblioteca para ti?"

# game/data/characters/numa/dialogue.rpy:65
translate es numa_moreaboutpeople_menu_3fbd73b2:

    # NUMA @ talk "No, they built a whole library to keep my kin happy... I just happen to work within it."
    NUMA @ talk "No, construyeron toda una biblioteca para mantener a mi gente feliz... Yo solo trabajo en ella."

# game/data/characters/numa/dialogue.rpy:69
translate es numa_moreaboutpeople_menu_32267830:

    # NUMA @ talk "Of course... It pleases me to be able to talk to one as clearly as you."
    NUMA @ talk "Por supuesto... Me complace poder hablar con alguien tan claramente."

# game/data/characters/numa/dialogue.rpy:74
translate es numa_whatareyou_711b6f6a:

    # "Numa's eyelids blinked twice as she tilted her head once more."
    "Los párpados de Numa parpadearon dos veces mientras inclinaba la cabeza una vez más"

# game/data/characters/numa/dialogue.rpy:75
translate es numa_whatareyou_38893e4f:

    # NUMA @ talk "How can one speak the wave so well and not know what we are?"
    NUMA @ talk "¿Cómo se puede hablar tan bien la ola y no saber lo que somos?"

# game/data/characters/numa/dialogue.rpy:76
translate es numa_whatareyou_c79bb790:

    # MC @ think "It's... complicated."
    MC @ think "Es... complicado."

# game/data/characters/numa/dialogue.rpy:77
translate es numa_whatareyou_7c8b810c:

    # NUMA @ talk "... I see."
    NUMA @ talk "... Ya veo."

# game/data/characters/numa/dialogue.rpy:78
translate es numa_whatareyou_53b96c9d:

    # NUMA @ talk "Then to answer your question, I am Thalay."
    NUMA @ talk "Entonces, para responder a tu pregunta, soy thalay"

# game/data/characters/numa/dialogue.rpy:79
translate es numa_whatareyou_09fc90be:

    # NUMA @ smile "I presume I may be one of the first, or perhaps THE first, of my kind you've seen since arriving in Hamun."
    NUMA @ smile "Supongo que soy una de las primeras, o quizá LA primera, de mi especie que has visto desde que llegaste a Hamun."

# game/data/characters/numa/dialogue.rpy:80
translate es numa_whatareyou_ec863f7f:

    # MC @ talk "Yes."
    MC @ talk "Sí."

# game/data/characters/numa/dialogue.rpy:81
translate es numa_whatareyou_12452374:

    # NUMA @ talk "Mmm... It is not surprising."
    NUMA @ talk "Mmm... No es sorprendente."

# game/data/characters/numa/dialogue.rpy:82
translate es numa_whatareyou_3fe64a20:

    # NUMA @ talk "Our people conduct only limited business with land breathers."
    NUMA @ talk "Nuestra gente solo hace negocios de forma limitada con los que respiran tierra."

# game/data/characters/numa/dialogue.rpy:88
translate es numa_talk_d20b5586:

    # NUMA @ smile "Greetings again, how may I help?"
    NUMA @ smile "Saludos de nuevo, ¿en qué puedo ayudarle?"

# game/data/characters/numa/dialogue.rpy:94
translate es numa_bye_aaff2ad9:

    # NUMA @ smile "Come back anytime... It pleases me to have someone I can actually speak the wave with."
    NUMA @ smile "Vuelve cuando quieras... Me complace tener a alguien con quien puedo hablar la ola."

# game/data/characters/numa/dialogue.rpy:100
translate es numa_firstmeet_2a75a3f6:

    # "Entering into the Hamun library was... an unusual sight."
    "Entrar en la biblioteca Hamun fue... una vista inusual."

# game/data/characters/numa/dialogue.rpy:101
translate es numa_firstmeet_8bc35701:

    # "While the usual rows of books were neatly stacked up high as one would expect, a deep, decorated pool lay in the center of the library,"
    "Mientras que las habituales hileras de libros estaban pulcramente apiladas, como era de esperar, en el centro de la biblioteca había una profunda piscina decorada."

# game/data/characters/numa/dialogue.rpy:102
translate es numa_firstmeet_7c9fd79f:

    # "Complete with a strange water fountain statue of what appeared to be a mage striking up a bargain with a strange fish like humanoid."
    "Completada con una extraña estatua de una fuente de agua de lo que parecía ser un mago haciendo un trato con un extraño humanoide parecido a un pez."

# game/data/characters/numa/dialogue.rpy:103
translate es numa_firstmeet_6d119730:

    # "Looking around, I could see no one in the library."
    "Mirando a mi alrededor, no ví a nadie en la biblioteca"

# game/data/characters/numa/dialogue.rpy:104
translate es numa_firstmeet_27bb84f3:

    # MC @ think "Hello? Is anyone here?"
    MC @ think "¿Hola? ¿Hay alguien aquí?"

# game/data/characters/numa/dialogue.rpy:105
translate es numa_firstmeet_730a3730:

    # "A shadow appeared along waters of the pool, and in a moment, the blue skinned humanoid like woman emerged."
    "Una sombra apareció a lo largo de las aguas de la piscina y, en un momento, surgió una mujer humanoide de piel azul."

# game/data/characters/numa/dialogue.rpy:108
translate es numa_firstmeet_db1efe9f:

    # "Naked, and covered in scales as the water dripped from her body, the gilged creature turned it's gaze towards me."
    "Desnuda y cubierta de escamas mientras el agua goteaba de su cuerpo, la criatura brillante dirigió su mirada hacia mí."

# game/data/characters/numa/dialogue.rpy:109
translate es numa_firstmeet_fe773dc3:

    # UNKNOWN "Lora'shen... Vaalra korril'neth, sollan?"
    UNKNOWN "Lora'shen... ¿Vaalra korril'neth, sollan?"

# game/data/characters/numa/dialogue.rpy:110
translate es numa_firstmeet_bde6c2b6:

    # MC @ think "What?"
    MC @ think "¿Qué?"

# game/data/characters/numa/dialogue.rpy:111
translate es numa_firstmeet_574271cf:

    # "The strange creature tilted it's head, before motioning towards the many books with it's hand."
    "La extraña criatura inclinó la cabeza antes de señalar los libros con la mano."

# game/data/characters/numa/dialogue.rpy:112
translate es numa_firstmeet_ca45be32:

    # UNKNOWN "Ssharaa… Vellunaa shor'kai, raal ithen vashan…"
    UNKNOWN "Ssharaa… Vellunaa shor'kai, raal ithen vashan…"

# game/data/characters/numa/dialogue.rpy:113
translate es numa_firstmeet_cb8a202f:

    # MC @ talk "Sorry, I can't-"
    MC @ talk "Lo siento, no puedo-"

