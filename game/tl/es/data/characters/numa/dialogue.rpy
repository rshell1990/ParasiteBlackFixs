    NUMA @ talk "¿Hay algo más?"

translate es strings:

    # game/data/characters/numa/dialogue.rpy:30
    old "I have books to trade."
    new "Tengo libros para intercambiar."

    # game/data/characters/numa/dialogue.rpy:13
    old "I hate to ask but... What are you?"
    new "Odio preguntar pero... ¿Qué eres?"

    # game/data/characters/numa/dialogue.rpy:16
    old "I'd like to look at some books."
    new "Me gustaría mirar algunos libros."

    # game/data/characters/numa/dialogue.rpy:18
    old "Can you tell me more about your people?"
    new "¿Podrías hablarme más de tu gente?"

    # game/data/characters/numa/dialogue.rpy:31
    old "Talk to Numa"
    new "Hablar con Numa"

    # game/data/characters/numa/dialogue.rpy:44
    old "Your people... What do you do here in Hamun?"
    new "Tu gente... ¿Qué hacéis aquí en Hamun?"

    # game/data/characters/numa/dialogue.rpy:44
    old "Why are you working in a library?"
    new "¿Por qué trabajas en una biblioteca?"

    # game/data/characters/numa/dialogue.rpy:44
    old "That's all the questions I have for now."
    new "Esas son todas las preguntas que tengo por ahora."
