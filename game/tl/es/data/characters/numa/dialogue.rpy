    # BLACK "(The same way I learned your tongue.)"
    BLACK "(De la misma manera que aprendí tu lengua)."

# game/data/characters/numa/dialogue.rpy:127
translate es numa_firstmeet_b10ec70e:

    # BLACK "(By adapting.)"
    BLACK "(Adaptándome)."

# game/data/characters/numa/dialogue.rpy:128
