# game/data/characters/thea/dialogue.rpy:68
translate es nov_thea_adv_questions_notAdventurer_dff28a07:

    # THEA @ talk "Sorry, but I don't remember you being an adventurer."
    THEA @ talk "Lo siento, pero no recuerdo que fueras un aventurero."

# game/data/characters/thea/dialogue.rpy:69
translate es nov_thea_adv_questions_notAdventurer_4a075af6:

    # MC "What do you mean?"
    MC "¿Qué quieres decir?"

# game/data/characters/thea/dialogue.rpy:70
translate es nov_thea_adv_questions_notAdventurer_bd5ff809:

    # THEA @ talk "Well, you can get yourself a drink or something, but I can't waste my time explaining the inner workings of the guild to you."
    THEA @ talk "Bueno, puedes tomarte una bebida o algo, pero no puedo perder el tiempo explicándote el funcionamiento interno del gremio."

# game/data/characters/thea/dialogue.rpy:71
translate es nov_thea_adv_questions_notAdventurer_e1770810:

    # MC "Can I become an adventurer?"
    MC "¿Puedo convertirme en un aventurero?"

# game/data/characters/thea/dialogue.rpy:72
translate es nov_thea_adv_questions_notAdventurer_416abe62:

    # "Thea let out a quiet sigh..."
    "Thea dejó escapar un suspiro silencioso..."

# game/data/characters/thea/dialogue.rpy:73
translate es nov_thea_adv_questions_notAdventurer_e5da05a6:

    # THEA @ talk "That's a three-hundred fifty-something time I've been asked this."
    THEA @ talk "Son trescientos cincuenta y pico de veces que me han preguntado esto."

# game/data/characters/thea/dialogue.rpy:74
translate es nov_thea_adv_questions_notAdventurer_811a066b:

    # THEA @ talk "Have you reached your Terminus yet?"
    THEA @ talk "¿Ya has llegado a tu Terminus?"

# game/data/characters/thea/dialogue.rpy:75
translate es nov_thea_adv_questions_notAdventurer_5d73558e:

    # "I swallowed hard."
    "Tragué saliva con fuerza."

# game/data/characters/thea/dialogue.rpy:76
translate es nov_thea_adv_questions_notAdventurer_7b56f981:

    # MC "Y-yeah."
    MC "S-sí."

# game/data/characters/thea/dialogue.rpy:77
translate es nov_thea_adv_questions_notAdventurer_2da5a787:

    # THEA @ talk "You did? Well, that is how you become an adventurer, you're {i}assigned{/i} this role at your Terminus."
    THEA @ talk "¿Lo hiciste? Bueno, así es como te conviertes en aventurero. Te {i}asignan{/i} este rol en el Terminus."

# game/data/characters/thea/dialogue.rpy:78
translate es nov_thea_adv_questions_notAdventurer_fe9f792d:

    # THEA @ talk "What role did the kingdom bestow upon you?"
    THEA @ talk "¿Qué papel te asignó el reino?"

# game/data/characters/thea/dialogue.rpy:79
translate es nov_thea_adv_questions_notAdventurer_522de8a4:

    # MC "(Cannon fodder.)"
    MC "(Carne de cañón)."

# game/data/characters/thea/dialogue.rpy:80
translate es nov_thea_adv_questions_notAdventurer_e8f39a65:

    # MC "I... I should go."
    MC "Yo... yo debería irme."

# game/data/characters/thea/dialogue.rpy:81
translate es nov_thea_adv_questions_notAdventurer_4349caf7:

    # "Thea raised an eyebrow."
    "Thea levantó una ceja."

# game/data/characters/thea/dialogue.rpy:82
translate es nov_thea_adv_questions_notAdventurer_d34359c3:

    # THEA @ talk "Okay, safe travels then!"
    THEA @ talk "¡Bueno entonces, buen viaje!"

# game/data/characters/thea/dialogue.rpy:84
translate es nov_thea_adv_questions_notAdventurer_bfd46478:

    # MC "I should get to the fort now."
    MC "Debería ir al fuerte ahora."
