

# game/data/characters/thea/dialogue.rpy:27
translate es nov_thea_talk_5f6496d4:

    # THEA @ smile "Oh hey! Can I help you with something?"
    THEA @ smile "¡Hola! ¿Puedo ayudarte en algo?"

# game/data/characters/thea/dialogue.rpy:34
translate es nov_thea_bye_9e54ad83:

    # THEA @ talk "Alright, see ya around!"
    THEA @ talk "De acuerdo, ¡nos vemos!"

# game/data/characters/thea/dialogue.rpy:35
translate es nov_thea_bye_d20135b7:

    # THEA @ smile "Good luck on your adventures!"
    THEA @ smile "¡Buena suerte en tus aventuras!"

# game/data/characters/thea/dialogue.rpy:41
translate es nov_thea_adv_questions_1a2ee70f:

    # THEA @ talk "Ask away."
    THEA @ talk "Pregunta."

# game/data/characters/thea/dialogue.rpy:44
translate es nov_thea_adv_questions_menu_bbc22857:

    # THEA @ talk "Over on the board over there is our list of current jobs needing to be done."
    THEA @ talk "En el tablón de allí está nuestra lista de trabajos pendientes."

# game/data/characters/thea/dialogue.rpy:45
translate es nov_thea_adv_questions_menu_0ab4d2cb:

    # THEA @ talk "Just select the one you want, and we'll handle the paperwork while you get to work."
    THEA @ talk "Solo tienes que seleccionar el que quieras y nosotros nos encargamos del papeleo mientras tú te pones manos a la obra."

# game/data/characters/thea/dialogue.rpy:46
translate es nov_thea_adv_questions_menu_e0200cc9:

    # THEA @ talk "Remember though, you can only choose a quest within your rank as an adventurer."
    THEA @ talk "Recuerda, sin embargo, que solo puedes elegir una misión dentro de tu rango como aventurero."

# game/data/characters/thea/dialogue.rpy:49
translate es nov_thea_adv_questions_menu_d0988ac6:

    # THEA @ talk "It's important to understand how the ranking works."
    THEA @ talk "Es importante entender cómo funciona la clasificación."

# game/data/characters/thea/dialogue.rpy:50
translate es nov_thea_adv_questions_menu_a160af5e:

    # THEA @ talk "All beginner adventurers are ranked as D-listers."
    THEA @ talk "Todos los aventureros principiantes tienen la categoría D."

# game/data/characters/thea/dialogue.rpy:51
translate es nov_thea_adv_questions_menu_691c77f1:

    # THEA @ talk "These are the most straightforward and simple quests available to any adventurer."
    THEA @ talk "Estas son las misiones más sencillas y simples que están a disposición de cualquier aventurero."

# game/data/characters/thea/dialogue.rpy:52
translate es nov_thea_adv_questions_menu_359a935e:

    # THEA @ talk "Ranking progresses from D-tier all the way to S-Tier, the rank of legendary adventurers."
    THEA @ talk "La clasificación avanza desde el nivel D hasta el nivel S, el rango de los aventureros legendarios."

# game/data/characters/thea/dialogue.rpy:53
translate es nov_thea_adv_questions_menu_71f3b316:

    # THEA @ talk "Of course, as the danger and difficulty of the quests increase each rank, so does the rewards to compensate."
    THEA @ talk "Por supuesto, a medida que el peligro y la dificultad de las misiones aumentan en cada rango, también lo hacen las recompensas para compensar."

# game/data/characters/thea/dialogue.rpy:56
translate es nov_thea_adv_questions_menu_9ae80558:

    # THEA @ talk "There's a set number of quests per rank that will need to be completed a minimum of at least once."
    THEA @ talk "Hay un número determinado de misiones por rango que deberán completarse al menos una vez."

# game/data/characters/thea/dialogue.rpy:57
translate es nov_thea_adv_questions_menu_42fcd1da:

    # THEA @ talk "After you've beaten your ranks guild quests, a special one-time quest will open up that once you've completed, your rank will increase."
    THEA @ talk "Una vez que hayas superado las misiones de gremio de tu rango, se abrirá una misión especial de una sola vez que, una vez completada, aumentará tu rango."

# game/data/characters/thea/dialogue.rpy:58
translate es nov_thea_adv_questions_menu_0b3f27c1:

    # THEA @ talk "Oh ... And don't worry about running out of quests."
    THEA @ talk "Ah... Y no te preocupes por quedarte sin misiones."

# game/data/characters/thea/dialogue.rpy:59
translate es nov_thea_adv_questions_menu_003922e8:

    # THEA @ talk "Outside of the special guild quests, most guild quests are usually full time occupations in themselves, you'll be able to re-do those quests as many times as you like."
    THEA @ talk "Aparte de las misiones especiales de gremio, la mayoría de las misiones de gremio suelen ser ocupaciones a tiempo completo en sí mismas, podrás volver a hacer esas misiones tantas veces como quieras."

# game/data/characters/thea/dialogue.rpy:62
translate es nov_thea_adv_questions_menu_fa5b1639:

    # THEA @ talk "Sure, was there anything else?"
    THEA @ talk "Claro, ¿algo más?"

# game/data/characters/thea/dialogue.rpy:67
translate es nov_thea_drink_4968c955:

    # THEA @ talk "Improve your standing at the guild and maybe we'll talk."
    THEA @ talk "Mejora tu reputación en el gremio y quizá hablemos."

# game/data/characters/thea/dialogue.rpy:71
translate es nov_thea_drink_8bb85580:

    # THEA @ smile "I hope you don't think you're the first one to try that."
    THEA @ smile "Espero que no creas que eres el primero que lo intenta."

# game/data/characters/thea/dialogue.rpy:72
translate es nov_thea_drink_cef616c3:

    # MC @ smile "I was hoping I'd be the first one you'd say yes to."
    MC @ smile "Esperaba ser el primero al que dijeras que sí."

# game/data/characters/thea/dialogue.rpy:73
translate es nov_thea_drink_af5adb3e:

    # THEA @ talk "Hmm, well, I'll think about it ..."
    THEA @ talk "Hmm, bueno, me lo pensaré ..."

# game/data/characters/thea/dialogue.rpy:74
translate es nov_thea_drink_4d231e9b:

    # THEA @ talk "I'm sure you're used to girls just falling into your lap, but it takes a little more than that to get me interested."
    THEA @ talk "Estoy segura de que estás acostumbrado a que las chicas caigan en tu regazo, pero hace falta algo más que eso para que me interese."

# game/data/characters/thea/dialogue.rpy:75
translate es nov_thea_drink_e9545907:

    # MC @ smile "Oh?"
    MC @ smile "¿Ah, sí?"

# game/data/characters/thea/dialogue.rpy:76
translate es nov_thea_drink_08d238b8:

    # THEA @ smile "{i}I wanna see what you can do.{/i}"
    THEA @ smile "{i}Quiero ver lo que puedes hacer.{/i}"

# game/data/characters/thea/dialogue.rpy:77
translate es nov_thea_drink_fb6bc2c6:

    # MC @ think "What I can do?"
    MC @ think "¿Qué puedo hacer?"

# game/data/characters/thea/dialogue.rpy:78
translate es nov_thea_drink_95135937:

    # THEA @ smile "Here, {i}at this guild.{/i}"
    THEA @ smile "Aquí, {i}en este gremio.{/i}"

# game/data/characters/thea/dialogue.rpy:79
translate es nov_thea_drink_306fe303:

    # THEA @ smile2 "There's something about this place that just-"
    THEA @ smile2 "Hay algo en este lugar que simplemente-"

# game/data/characters/thea/dialogue.rpy:80
translate es nov_thea_drink_c7bdae38:

    # THEA @ smile "Mmm ... Better not think too hard on it, need to stay focused for work."
    THEA @ smile "Mmm ... Mejor no pensar mucho en ello, hay que estar concentrado para el trabajo."

# game/data/characters/thea/dialogue.rpy:81
translate es nov_thea_drink_ef2975b7:

    # MC @ talk "So, you've got a thing for Adventurers then?"
    MC @ talk "Entonces, ¿te gustan los aventureros?"

# game/data/characters/thea/dialogue.rpy:82
translate es nov_thea_drink_79a5953f:

    # THEA @ smile2 "A-Ah...Maybe a little?"
    THEA @ smile2 "A-Ah...¿Tal vez un poco?"

# game/data/characters/thea/dialogue.rpy:83
translate es nov_thea_drink_c0c81c71:

    # THEA @ smile "But not just any adventurer walking in off the street, one whose metal has been seriously proven."
    THEA @ smile "Pero no cualquier aventurero de la calle, sino uno cuyo metal ha sido seriamente probado."

# game/data/characters/thea/dialogue.rpy:84
translate es nov_thea_drink_211b3ff7:

    # THEA @ blush "Think you've got what it takes?"
    THEA @ blush "¿Crees que tienes lo que hay que tener?"

# game/data/characters/thea/dialogue.rpy:85
translate es nov_thea_drink_8ba32743:

    # MC @ talk "I guess we'll see, won't we?"
    MC @ talk "Supongo que ya lo veremos, ¿no?"

