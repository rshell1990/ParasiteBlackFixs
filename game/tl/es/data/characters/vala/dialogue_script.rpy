

# game/data/characters/vala/dialogue_script.rpy:4
translate es nov_vala_scr_firstmeet_1c716be8:

    # "As I stepped into the Library, I was greeted by the sudden warmth as I stepped through the door, the fire going as musky books laid scattered around on various tables."
    "Cuando entré en la biblioteca, me recibió un inesperado calor al cruzar la puerta, el fuego encendido y los libros desparramados esparcidos por las mesas."

# game/data/characters/vala/dialogue_script.rpy:5
translate es nov_vala_scr_firstmeet_9b7620e7:

    # MC @ talk "Hello? Is anyone here?"
    MC @ talk "¿Hola? ¿Hay alguien aquí?"

# game/data/characters/vala/dialogue_script.rpy:6
translate es nov_vala_scr_firstmeet_1e9e0401:

    # VALA "Just a minute!"
    VALA "¡Un momento!"

# game/data/characters/vala/dialogue_script.rpy:7
translate es nov_vala_scr_firstmeet_b7a4fdc6:

    # "Peering around, I noticed a blonde girl high up on some ladder, putting away a few old books they she slides back into place."
    "Mirando a mi alrededor, veo a una chica rubia subida a una escalera, guardando unos cuantos libros viejos que vuelve a colocar en su sitio."

# game/data/characters/vala/dialogue_script.rpy:9
translate es nov_vala_scr_firstmeet_3ed51ef9:

    # "Reaching onto her tip toes, the girl out-stretched her arms as she tried to reach the bookshelf, and her skirt begin to hike up, revealing the soft panties she wore beneath."
    "Poniéndose de puntillas, la chica estiró los brazos para intentar alcanzar la estantería, y su falda empezó a levantarse, dejando al descubierto las bragas que llevaba debajo."

# game/data/characters/vala/dialogue_script.rpy:11
translate es nov_vala_scr_firstmeet_7a78c0c0:

    # VALA "Just... a little more!"
    VALA "¡Solo... un poco más!"

# game/data/characters/vala/dialogue_script.rpy:13
translate es nov_vala_scr_firstmeet_2ab10cd7:

    # MC @ talk "Are you okay up there? That ladder looks a little... {i}old.{/i}"
    MC @ talk "¿Estás bien ahí arriba? Esa escalera parece un poco... {i}antigua.{/i}"

# game/data/characters/vala/dialogue_script.rpy:14
translate es nov_vala_scr_firstmeet_4cc79bf2:

    # VALA "I’ll be fine! We’re getting a new-"
    VALA "¡Estaré bien! Tendremos una nueva-"

# game/data/characters/vala/dialogue_script.rpy:15
translate es nov_vala_scr_firstmeet_d2a7a758:

    # "Suddenly, the weak ladder snapped beneath her foot as the girl began falling down!"
    "¡De repente, la débil escalera se rompió bajo sus pies y la chica empezó a caer!"

# game/data/characters/vala/dialogue_script.rpy:20
translate es nov_vala_scr_firstmeet_e7b98bff:

    # VALA "AHHHHH!"
    VALA "¡AHHHHH!"

# game/data/characters/vala/dialogue_script.rpy:21
translate es nov_vala_scr_firstmeet_061f8483:

    # "Running forward, I managed to catch the girl just in time with my agile reflexes, gently letting her down safely."
    "Corriendo hacia delante, conseguí atrapar a la chica justo a tiempo con mis ágiles reflejos, dejándola caer suavemente y a salvo."

# game/data/characters/vala/dialogue_script.rpy:24
translate es nov_vala_scr_firstmeet_93bbef6a:

    # VALA "Phew...! Thank you for that!"
    VALA "¡Uf...! ¡Gracias!"

# game/data/characters/vala/dialogue_script.rpy:25
translate es nov_vala_scr_firstmeet_9eb70956:

    # "Stood before me, I now finally had a good chance to look at the girl properly, she was short, with long blonde hair and spectacle glasses."
    "De pie ante mí, ahora por fin tenía la oportunidad de ver bien a la chica, era bajita, con el pelo largo y rubio y con gafas."

# game/data/characters/vala/dialogue_script.rpy:26
translate es nov_vala_scr_firstmeet_214f3a9e:

    # "Smiling cutely at me, I looked down to see the curves of her body and felt the tinge of the Parasite getting excited once again."
    "Sonriéndome tiernamente, miré hacia abajo para ver las curvas de su cuerpo y sentí el cosquilleo del Parásito excitándose una vez más."

# game/data/characters/vala/dialogue_script.rpy:27
translate es nov_vala_scr_firstmeet_0a1deb0a:

    # MC @ talk "No problem."
    MC @ talk "No pasa nada."

# game/data/characters/vala/dialogue_script.rpy:28
translate es nov_vala_scr_firstmeet_9dcd4662:

    # "The girl outstretched her hand for it to be shaken."
    "La chica extendió la mano para que se la estrecharan."

# game/data/characters/vala/dialogue_script.rpy:29
translate es nov_vala_scr_firstmeet_16215314:

    # VALA "Vala Bluestone at your service!"
    VALA "¡Vala Bluestone a tu servicio!"

# game/data/characters/vala/dialogue_script.rpy:30
translate es nov_vala_scr_firstmeet_90781931:

    # "I reached out my hand to shake hers."
    "Extendí la mano para estrechársela."

# game/data/characters/vala/dialogue_script.rpy:33
translate es nov_vala_scr_firstmeet_6fa3a6ae:

    # MC @ talk "A pleasure to meet you Vala Bluestone, I am [player_name!t]."
    MC @ talk "Un placer conocerte Vala Bluestone, soy [player_name!t]."

# game/data/characters/vala/dialogue_script.rpy:33
translate es nov_vala_scr_firstmeet_ce593ffd:

    # VALA "So, what brings you here?"
    VALA "¿Qué te trae por aquí?"

# game/data/characters/vala/dialogue_script.rpy:33
translate es nov_vala_scr_firstmeet_0ad6f9ca:

    # MC @ talk "I was perhaps hoping to read a book or two..."
    MC @ talk "Quizás esperaba leer un libro o dos..."

# game/data/characters/vala/dialogue_script.rpy:35
translate es nov_vala_scr_firstmeet_c606f5f8:

    # VALA "Ah, well the library is free for all, and always open."
    VALA "Ah, bueno, la biblioteca es gratuita para todos y siempre está abierta."

# game/data/characters/vala/dialogue_script.rpy:36
translate es nov_vala_scr_firstmeet_f0e406e2:

    # VALA "Just remember, while we can put books in the hold for you to keep reading once you come back, we can’t allow you to take any of the books with you."
    VALA "Recuerda que, aunque podemos poner libros en la reserva para que los sigas leyendo cuando vuelvas, no podemos permitir que te lleves ninguno."

# game/data/characters/vala/dialogue_script.rpy:37
translate es nov_vala_scr_firstmeet_7c81cc89:

    # "After so many students complained and asked for the library to be opened due to the ever-growing stress around studies, the education board agreed to give it extra funding to do so."
    "Después de que muchos estudiantes se quejaran y pidieran que la biblioteca abriera debido al creciente estrés en torno a los estudios, el consejo educativo accedió a concederle fondos adicionales para hacerlo."

# game/data/characters/vala/dialogue_script.rpy:38
translate es nov_vala_scr_firstmeet_c486209e:

    # "Me and Markus, albeit reluctantly, were forced to spend a fair few of our evenings here."
    "Markus y yo, aunque a regañadientes, nos vimos obligados a pasar aquí bastantes de nuestras anocheceres."

# game/data/characters/vala/dialogue_script.rpy:39
translate es nov_vala_scr_firstmeet_ef9ee76e:

    # "How long ago that all seems now..."
    "Qué lejano parece todo eso ahora..."

# game/data/characters/vala/dialogue_script.rpy:40
translate es nov_vala_scr_firstmeet_0d47b440:

    # VALA "Is something the matter?"
    VALA "¿Pasa algo?"

# game/data/characters/vala/dialogue_script.rpy:41
translate es nov_vala_scr_firstmeet_bf61c54a:

    # MC @ talk "Hmm?"
    MC @ talk "¿Hmm?"

# game/data/characters/vala/dialogue_script.rpy:42
translate es nov_vala_scr_firstmeet_c9952985:

    # VALA "You seemed... {i}lost in thought{/i} for a second there."
    VALA "Parecías... {i}perdido en tus pensamientos{/i} por un segundo."

# game/data/characters/vala/dialogue_script.rpy:43
translate es nov_vala_scr_firstmeet_d5717343:

    # MC @ talk "Oh, never mind."
    MC @ talk "Oh, no importa."

# game/data/characters/vala/dialogue_script.rpy:44
translate es nov_vala_scr_firstmeet_67a9c63c:

    # MC @ talk "Just remembering some things, nothing important."
    MC @ talk "Solo recordaba algunas cosas, nada importante."

# game/data/characters/vala/dialogue_script.rpy:45
translate es nov_vala_scr_firstmeet_bf0e67a2:

    # VALA "Well, if you need anything, I’ll be around! Okay?"
    VALA "Bueno, si necesitas algo, ¡estaré por aquí! ¿Vale?"

# game/data/characters/vala/dialogue_script.rpy:46
translate es nov_vala_scr_firstmeet_830159c6:

    # MC @ talk "Sounds good."
    MC @ talk "Me parece bien."

# game/data/characters/vala/dialogue_script.rpy:47
translate es nov_vala_scr_firstmeet_618cb924:

    # "As Vala smiled and waved shyly, I watched her cute butt as she sauntered off to go grab more books."
    "Mientras Vala sonreía y saludaba tímidamente con la mano, observé su lindo trasero mientras se alejaba para ir a buscar más libros."

# game/data/characters/vala/dialogue_script.rpy:49
translate es nov_vala_scr_firstmeet_db0c26de:

    # BLACK "Her heartbeat raised when she saw you, and her hands began to sweat."
    BLACK "Sus latidos aumentaron al verte y sus manos empezaron a sudar."

# game/data/characters/vala/dialogue_script.rpy:50
translate es nov_vala_scr_firstmeet_a97dcc2e:

    # BLACK "With some commitment, she would be a willing and good mate."
    BLACK "Con algo de esfuerzo, sería una buena y dispuesta compañera."

# game/data/characters/vala/dialogue_script.rpy:51
translate es nov_vala_scr_firstmeet_7be498ca:

    # MC "Stop... I... "
    MC "Para... yo... "

# game/data/characters/vala/dialogue_script.rpy:52
translate es nov_vala_scr_firstmeet_81498102:

    # "I shook my head to try push aside the dark thoughts."
    "Sacudí la cabeza para intentar apartar esos oscuros pensamientos."

# game/data/characters/vala/dialogue_script.rpy:53
translate es nov_vala_scr_firstmeet_bd8e6530:

    # MC @ angry "We’re here to try and gather some information, not hunting for another ‘mate’"
    MC @ angry "Estamos aquí para tratar de reunir información, no a la caza de otra ‘compañera’"

# game/data/characters/vala/dialogue_script.rpy:54
translate es nov_vala_scr_firstmeet_296d9d43:

    # BLACK "As you wish."
    BLACK "Como quieras."

# game/data/characters/vala/dialogue_script.rpy:55
translate es nov_vala_scr_firstmeet_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Suspiro*{/i}"

# game/data/characters/vala/dialogue_script.rpy:56
translate es nov_vala_scr_firstmeet_7c3d9a85:

    # "Now, where to start? This place is huge..."
    "¿Por dónde empiezo? Este lugar es enorme..."
