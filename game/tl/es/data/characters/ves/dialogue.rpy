

# game/data/characters/ves/dialogue.rpy:39
translate es ves_isOutHunting_ff8744ec:

    # MC "(Ves must be out hunting.)"
    MC "(Ves debe estar cazando)."

# game/data/characters/ves/dialogue.rpy:40
translate es ves_isOutHunting_e465bbc4:

    # MC "(I might be able to catch her tomorrow.)"
    MC "(Quizá pueda encontrarla mañana)."

# game/data/characters/ves/dialogue.rpy:50
translate es ves_firstmeet_61479d0c:

    # "Opening the flap of her tent, I stepped inside to find Ves sitting cross legged on the floor, inspecting her axes before sharpening them with a vicious-looking rock."
    "Al abrir la lona de su tienda, me encontré a Ves sentada en el suelo con las piernas cruzadas, inspeccionando sus hachas antes de afilarlas con una piedra de aspecto intimidante."

# game/data/characters/ves/dialogue.rpy:51
translate es ves_firstmeet_80992f0b:

    # "Looking around the tent which flapped with each gust of wind, I observed that she had done a remarkable job to have survived as long as she had out here in these harsh lands."
    "Mirando alrededor de la tienda, que se agitaba con cada ráfaga de viento, observé que había hecho un trabajo extraordinario para haber sobrevivido tanto tiempo en estas duras tierras."

# game/data/characters/ves/dialogue.rpy:52
translate es ves_firstmeet_2c9aacee:

    # "Sprawled across the floor were a mixture of fur rugs made from the hides of animals from her many hunts and cloth she had found and hung decoratively."
    "En el suelo había una mezcla de alfombras de pieles de animales de sus muchas cacerías y telas que había encontrado y colgado como adorno."

# game/data/characters/ves/dialogue.rpy:53
translate es ves_firstmeet_80cc8164:

    # "Here and there were various pieces of equipment and intricate looking items she had fashioned out here in this small corner of the desert."
    "Aquí y allá había varias piezas de equipo y objetos de aspecto intrincado que había fabricado en este pequeño rincón del desierto."

# game/data/characters/ves/dialogue.rpy:54
translate es ves_firstmeet_63e642cd:

    # "There was a small wooden tub, presumably for washing in but I couldn’t even begin to guess where she managed to find enough water to get close to filling it in these barren lands."
    "Había una pequeña bañera de madera, presumiblemente para lavarse, pero no podía ni empezar a adivinar dónde se las arreglaba para encontrar agua suficiente para acercarse a llenarla en estas tierras estériles."

# game/data/characters/ves/dialogue.rpy:55
translate es ves_firstmeet_03f711ff:

    # "Her bed was comprised of a cluster of blue quilts and pillows that seemed almost out of place in the desert, had she stolen them?"
    "Su cama estaba compuesta por un conjunto de edredones y almohadas azules que parecían casi fuera de lugar en el desierto, ¿los había robado?"

# game/data/characters/ves/dialogue.rpy:56
translate es ves_firstmeet_f29e70bc:

    # "The bedframe itself was notably made with some craftsmanship, further raising my suspicions on the matter, but I decided not to pry too much into her affairs."
    "El propio somier estaba notablemente hecho con cierta artesanía, lo que aumentó aún más mis sospechas al respecto, pero decidí no husmear demasiado en sus asuntos."

# game/data/characters/ves/dialogue.rpy:57
translate es ves_firstmeet_6e5075fc:

    # "Here and there were jars filled with either water or small dead animals in some preservative substance, scorpions, beetles and such..."
    "Aquí y allá había frascos llenos de agua o de pequeños animales muertos en alguna sustancia conservante, escorpiones, escarabajos y cosas así..."

# game/data/characters/ves/dialogue.rpy:58
translate es ves_firstmeet_df6a8060:

    # "Presumably kept as small rations of food for when the dried-out meat on the lines outside was running low."
    "Presumiblemente guardados como pequeñas raciones de comida para cuando la carne seca de las líneas exteriores se agotara."

# game/data/characters/ves/dialogue.rpy:59
translate es ves_firstmeet_f16dfa89:

    # "As she tested the sharpness of her axe with her thumb, she looked up coolly at me."
    "Mientras probaba el filo de su hacha con el pulgar, me miró fríamente."

# game/data/characters/ves/dialogue.rpy:60
translate es ves_firstmeet_2252db6b:

    # VES @ talk "What do you want, human?"
    VES @ talk "¿Qué quieres, humano?"

# game/data/characters/ves/dialogue.rpy:70
translate es ves_dial_talk_5d6f3c6e:

    # VES @ talk "What is it, human?"
    VES @ talk "¿Qué pasa, humano?"

# game/data/characters/ves/dialogue.rpy:76
translate es ves_dial_beenout_c1cc84bf:

    # VES @ talk "Not yet, but I will be soon."
    VES @ talk "Aún no, pero lo haré pronto."

# game/data/characters/ves/dialogue.rpy:77
translate es ves_dial_beenout_f48a09c0:

    # VES @ talk "Can’t risk supplies getting too low."
    VES @ talk "No puedo arriesgarme a que los suministros se agoten."

# game/data/characters/ves/dialogue.rpy:81
translate es ves_dial_seenanything_b917f69f:

    # VES @ talk "Just your usual small parties of Demorai moving through the sands."
    VES @ talk "Solo las habituales pequeñas partidas de Demorai moviéndose por las arenas."

# game/data/characters/ves/dialogue.rpy:82
translate es ves_dial_seenanything_565c2af8:

    # VES @ talk "Oh, and some Skorn... Not much else."
    VES @ talk "Oh, y algunos Skorn... No mucho más.."

# game/data/characters/ves/dialogue.rpy:83
translate es ves_dial_seenanything_396272dc:

    # VES @ talk "Though I did find a strange temple out here once..."
    VES @ talk "Aunque una vez me encontré un extraño templo aquí..."

# game/data/characters/ves/dialogue.rpy:84
translate es ves_dial_seenanything_1bd97503:

    # "I raised an eyebrow"
    "Alcé una ceja"

# game/data/characters/ves/dialogue.rpy:85
translate es ves_dial_seenanything_84664fbb:

    # MC @ talk "A temple?"
    MC @ talk "¿Un templo?"

# game/data/characters/ves/dialogue.rpy:86
translate es ves_dial_seenanything_bf3b9ac7:

    # VES @ talk "Just some ruinous thing... Southeast of here."
    VES @ talk "Solo alguna cosa ruinosa... Al sudeste de aquí.."

# game/data/characters/ves/dialogue.rpy:87
translate es ves_dial_seenanything_43697f58:

    # MC @ talk "Hm, I see..."
    MC @ talk "Hm, entiendo..."

# game/data/characters/ves/dialogue.rpy:91
translate es ves_dial_bye_be8114ea:

    # VES @ talk "Very well."
    VES @ talk "Muy bien."

# game/data/characters/ves/dialogue.rpy:92
translate es ves_dial_bye_f300e1c6:

    # VES @ talk "As you are, human."
    VES @ talk "Como tú, humano."

# game/data/characters/ves/dialogue.rpy:45
translate es ves_party_talk_329d2049:

    # VES "Yes, [player_name!t]?"
    VES "¿Sí, [player_name!t]?"

# game/data/characters/ves/dialogue.rpy:49
translate es ves_party_bye_5fcb3ac8:

    # VES "Sure, human."
    VES "Claro, humano."

