translate es nov_mrs_winward_brought_hides_f9d300d9:

    # MRS_WINWARD "{i}*Cough*{/i} Now, h-how can I help?"
    MRS_WINWARD "{i}*Toser*{/i} ¿En qué puedo ayudarte?"

translate es strings:

    # game/data/characters/winward_mrs/dialogue.rpy:2
    old "Leather to pick up"
    new "Cuero para recoger"

    # game/data/characters/winward_mrs/dialogue.rpy:2
    old "I've commissioned Mrs. Winward of Novaras tannery to process some animal hides into leather. I should pick it up in about a week."
    new "He encargado a la Sra. Winward, de la curtiduría Novaras, que transforme algunas pieles de animales en cuero. Debería recogerlo en una semana."

    # game/data/characters/winward_mrs/dialogue.rpy:43
    old "Talk to Mrs. Winward"
    new "Hablar con la Sra. Winward"

    # game/data/characters/winward_mrs/dialogue.rpy:48
    old "Could you make me some leather from these hides?"
    new "¿Podrías hacerme cuero con estas pieles?"

    # game/data/characters/winward_mrs/dialogue.rpy:50
    old "Tell me a little more about yourself, Mrs Winward."
    new "Háblame un poco más de ti, Sra. Winward."

    # game/data/characters/winward_mrs/dialogue.rpy:51
    old "That's all, Mrs. Winward."
    new "Eso es todo, Sra. Winward."

    # game/data/characters/winward_mrs/dialogue.rpy:64
    old "One."
    new "Uno."

    # game/data/characters/winward_mrs/dialogue.rpy:64
    old "Two."
    new "Dos."

    # game/data/characters/winward_mrs/dialogue.rpy:64
    old "Three."
    new "Tres."

    # game/data/characters/winward_mrs/dialogue.rpy:64
    old "Ah, on second thought..."
    new "Ah, pensándolo bien..."

    # game/data/characters/winward_mrs/dialogue.rpy:87
    old "How long have you lived in Novaras?"
    new "¿Cuanto tiempo llevas viviendo en Novaras?"

    # game/data/characters/winward_mrs/dialogue.rpy:87
    old "How long have you been married?"
    new "¿Cuanto tiempo llevas casada?"
    
    # game/data/characters/winward_mrs/dialogue.rpy:87
    old "That's all."
    new "Eso es todo."
    
    # game/data/characters/winward_mrs/dialogue.rpy:134
    old "Tanner lady"
    new "Señora curtidora"

    # game/data/characters/winward_mrs/dialogue.rpy:217
    old "THAT'S ENOUGH!"
    new "¡YA BASTA!"

    # game/data/characters/winward_mrs/dialogue.rpy:217
    old "I don't know; something of mine is certainly 'getting up' for her."
    new "No sé; algo mío ciertamente se 'levanta' para ella."

    # game/data/characters/winward_mrs/dialogue.rpy:264
    old "{image=[ICON.HEART]} I was rather enjoying the attention..."
    new "{image=[ICON.HEART]} Estaba disfrutando de la atención..."

    # game/data/characters/winward_mrs/dialogue.rpy:264
    old "{image=[ICON.HEART_CROSS]} I understand, but I would appreciate not being dragged into your marital issues."
    new "{image=[ICON.HEART_CROSS]} Lo entiendo, pero agradecería que no me arrastraras a tus problemas maritales."

    # game/data/characters/winward_mrs/dialogue.rpy:7
    old "Tanner's shop needs animal hides"
    new "La curtiduría necesita pieles de animales."

    # game/data/characters/winward_mrs/dialogue.rpy:7
    old "If I gather animal hides during my travels, I can bring them to Mrs Winward, a leatherworker lady at the tanner's shop in Novaras. She can process these hides into usable leather."
    new "Si recojo pieles de animales durante mis viajes, puedo llevárselas a la señora Winward, una curtidura que trabaja en la curtiduría de Novaras. Ella puede transformar estas pieles en cuero utilizable."

    # game/data/characters/winward_mrs/dialogue.rpy:58
    old "Can you please explain what it is that you do again?"
    new "¿Podrías explicarme de nuevo a qué te dedicas?"
