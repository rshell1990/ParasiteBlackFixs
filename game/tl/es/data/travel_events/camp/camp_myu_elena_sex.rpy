translate es travel_event_camp_myu_elena_2c16c89f:

    # "Patting some of the quilts beside me, Myu hurried over, nestling herself up against me."
    "Acariciando algunos de las edredones que había a mi lado, Myu se apresuró a acercarse y se acurrucó contra mí."

# ame/data/travel_events/camp/camp_myu_elena_sex.rpy:58
translate es travel_event_camp_myu_elena_049a1853:

