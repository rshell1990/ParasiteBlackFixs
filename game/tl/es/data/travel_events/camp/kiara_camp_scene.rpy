translate es travel_event_kiara_camp_scene_firsttime_01276b13:

    # KIARA @ sad "Believe me... I've been fucking hating myself for months over it."
    KIARA @ sad "Créeme... Llevo meses odiándome por ello."

# game/data/travel_events/camp/kiara_camp_scene.rpy:97
translate es travel_event_kiara_camp_scene_firsttime_12bb06cf:

    # KIARA @ sad "... {i}But I'm here now.{/i}"
    KIARA @ sad "... {i}Pero ahora estoy aquí.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:98
translate es travel_event_kiara_camp_scene_firsttime_31776f58:

    # KIARA @ sad "{i}If you can forgive me.{/i}"
    KIARA @ sad "{i}Si puedes perdonarme.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:101
translate es travel_event_kiara_camp_scene_firsttime_5590950f:

    # KIARA @ shock "You... What?"
    KIARA @ shock "¿Tú... qué?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:102
translate es travel_event_kiara_camp_scene_firsttime_1e861f16:

    # KIARA @ sad "I... I thought you might need more time, or-"
    KIARA @ sad "Yo... pensé que tal vez necesitarías más tiempo, o-"

# game/data/travel_events/camp/kiara_camp_scene.rpy:103
translate es travel_event_kiara_camp_scene_firsttime_5b9c7529:

    # MC @ sad "We both know either of us would have done anything to get out of the scouts."
    MC @ sad "Ambos sabemos que cualquiera de los dos habría hecho cualquier cosa por salir de los exploradores."

# game/data/travel_events/camp/kiara_camp_scene.rpy:104
translate es travel_event_kiara_camp_scene_firsttime_c431b350:

    # MC @ sad "It was just..."
    MC @ sad "Era simplemente..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:105
translate es travel_event_kiara_camp_scene_firsttime_7ecb044e:

    # "I ponder the next painful words carefully."
    "Considero cuidadosamente las siguientes palabras dolorosas."

# game/data/travel_events/camp/kiara_camp_scene.rpy:106
translate es travel_event_kiara_camp_scene_firsttime_0cbc4d83:

    # MC @ sad "{i}Impossible choices for everyone.{/i}"
    MC @ sad "{i}Decisiones imposibles para todos.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:107
translate es travel_event_kiara_camp_scene_firsttime_3c6dc7c0:

    # "Impossible choices."
    "Decisiones imposibles."

# game/data/travel_events/camp/kiara_camp_scene.rpy:108
translate es travel_event_kiara_camp_scene_firsttime_3ee06bd1:

    # "If only I was stronger back then."
    "Ojalá hubiera sido más fuerte en aquel entonces."

# game/data/travel_events/camp/kiara_camp_scene.rpy:109
translate es travel_event_kiara_camp_scene_firsttime_1b49f8c7:

    # "{i}If only.{/i}"
    "{i}Ojalá.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:110
translate es travel_event_kiara_camp_scene_firsttime_6d1790f3:

    # "{b}I could have-{/b}"
    "{b}Podría haber-{/b}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:111
translate es travel_event_kiara_camp_scene_firsttime_99fd29a1:

    # "I closed my eyes and sighed, banishing the thought."
    "Cerré los ojos y suspiré, alejando ese pensamiento."

# game/data/travel_events/camp/kiara_camp_scene.rpy:112
translate es travel_event_kiara_camp_scene_firsttime_5dc7a41e:

    # "No one can change the past, I can't look back."
    "NNadie puede cambiar el pasado, no puedo mirar atrás."

# game/data/travel_events/camp/kiara_camp_scene.rpy:113
translate es travel_event_kiara_camp_scene_firsttime_1b1b7357:

    # "{i}Otherwise I may never be able to look away...{/i}"
    "{i}De lo contrario, quizá nunca pueda apartar la mirada...{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:114
translate es travel_event_kiara_camp_scene_firsttime_5efcab3c:

    # "Kiara's eyes dropped to the floor, as her hand carefully reached out to take mine."
    "Kiara bajó la mirada al suelo, mientras su mano se extendía con cuidado para coger la mía."

# game/data/travel_events/camp/kiara_camp_scene.rpy:116
translate es travel_event_kiara_camp_scene_firsttime_8274ab4f:

    # KIARA @ sad "{i}I can stay with you tonight if you want.{/i}"
    KIARA @ sad "{i}Puedo quedarme contigo esta noche si quieres.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:117
translate es travel_event_kiara_camp_scene_firsttime_06f07860:

    # KIARA @ sad "{i}I can make it go away.{/i}"
    KIARA @ sad "{i}Puedo hacer que desaparezca.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:122
translate es travel_event_kiara_camp_scene_firsttime_2f191525:

    # "Kiara gasped as I pulled her to the floor with me."
    "Kiara jadeó cuando la tiré al suelo conmigo."

# game/data/travel_events/camp/kiara_camp_scene.rpy:123
translate es travel_event_kiara_camp_scene_firsttime_f1cd9f29:

    # "With nervous breathes, she looked up towards me as we stripped off our clothes."
    "Con la respiración entrecortada, me miró mientras nos quitábamos la ropa."

# game/data/travel_events/camp/kiara_camp_scene.rpy:128
translate es travel_event_kiara_camp_scene_firsttime_0aa4abf5:

    # KIARA "Are you... Are you sure about this?"
    KIARA "¿Estás... estás seguro de esto?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:129
translate es travel_event_kiara_camp_scene_firsttime_c957f184:

    # KIARA "I don't want you to feel you need to rush this."
    KIARA "No quiero que sientas que tienes que precipitarte."

# game/data/travel_events/camp/kiara_camp_scene.rpy:130
translate es travel_event_kiara_camp_scene_firsttime_4fb2e869:

    # "I gently caressed Kiara's face with my hand as she tilted it towards me."
    "Acaricié suavemente el rostro de Kiara con la mano mientras ella se inclinaba hacia mí."

# game/data/travel_events/camp/kiara_camp_scene.rpy:131
translate es travel_event_kiara_camp_scene_firsttime_d4388f70:

    # MC "... We can't go back and fix the past."
    MC "... No podemos volver atrás y arreglar el pasado."

# game/data/travel_events/camp/kiara_camp_scene.rpy:132
