translate es travel_event_kiara_camp_scene_firsttime_736d4e23:

    # KIARA @ cry "I'm so sorry."
    KIARA @ cry "Lo siento mucho.."

# game/data/travel_events/camp/kiara_camp_scene.rpy:91
translate es travel_event_kiara_camp_scene_firsttime_64f208cb:

    # MC @ sad "Kiara..."
    MC @ sad "Kiara..."

