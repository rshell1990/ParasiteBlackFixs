translate es travel_event_kiara_camp_scene_firsttime_f9a1248b:

    # KIARA @ sad "You know, no matter what you say when I tell you, I still think you and I are destined to be together, the gods-"
    KIARA @ sad "Sabes, no importa lo que digas cuando te lo digo, sigo pensando que tú y yo estamos destinados a estar juntos, los dioses-"

# game/data/travel_events/camp/kiara_camp_scene.rpy:60
