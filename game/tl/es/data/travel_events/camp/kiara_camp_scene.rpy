    KIARA @ sad "La verdad."

# game/data/travel_events/camp/kiara_camp_scene.rpy:55
translate es travel_event_kiara_camp_scene_firsttime_8bd20bd0:

    # KIARA @ sad "The truth about our time together before... back in the scouts."
    KIARA @ sad "La verdad sobre el tiempo que pasamos juntos antes... en los exploradores."

# game/data/travel_events/camp/kiara_camp_scene.rpy:56
translate es travel_event_kiara_camp_scene_firsttime_3060f99f:

    # MC @ talk "What are you talking about?"
    MC @ talk "¿De qué estás hablando?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:57
translate es travel_event_kiara_camp_scene_firsttime_4dd93a67:

    # KIARA @ sad "I wasn't... entirely honest with you."
    KIARA @ sad "No fui... del todo sincera contigo."

# game/data/travel_events/camp/kiara_camp_scene.rpy:58
translate es travel_event_kiara_camp_scene_firsttime_1e040a8b:

    # MC @ surprised "I have no idea still what you're going on about."
    MC @ surprised "Sigo sin tener ni idea de qué estás hablando."

