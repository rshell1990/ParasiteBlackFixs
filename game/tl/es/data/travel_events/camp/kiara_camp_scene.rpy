    # KIARA @ sad "{i}*Sigh*{/i}"
    KIARA @ sad "{i}*Suspiro*{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:65
translate es travel_event_kiara_camp_scene_firsttime_888187da:

    # KIARA @ sad "Why'd you think they let men and women intermingle in the scouts?"
    KIARA @ sad "¿Por qué crees que permiten que hombres y mujeres se entremezclen en los exploradores?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:66
translate es travel_event_kiara_camp_scene_firsttime_46633f98:

    # MC @ think "Because... There are not enough men alone to fill every division?"
    MC @ think "¿Porque... no hay suficientes hombres para cubrir todas las divisiones?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:67
translate es travel_event_kiara_camp_scene_firsttime_cf352f0d:

    # KIARA @ sad "Partly... But not exactly."
    KIARA @ sad "En parte... Pero no exactamente."

# game/data/travel_events/camp/kiara_camp_scene.rpy:68
translate es travel_event_kiara_camp_scene_firsttime_c8f4555b:

    # KIARA @ sad "If a girl happens to get herself knocked up, they send you back home and let you leave the scouts."
    KIARA @ sad "Si una chica se queda embarazada, te mandan de vuelta a casa y te dejan dejar los exploradores."

# game/data/travel_events/camp/kiara_camp_scene.rpy:69
translate es travel_event_kiara_camp_scene_firsttime_1836dfa5:

    # KIARA @ sad "... If you're willing to give up the little one, let em' be raised to be whatever they need, another soldier probably."
    KIARA @ sad "... Si estás dispuesto a renunciar al pequeño, dejar que lo críen para que sea lo que necesiten, probablemente otro soldado."

# game/data/travel_events/camp/kiara_camp_scene.rpy:70
translate es travel_event_kiara_camp_scene_firsttime_632c0396:

    # "The realization slowly dawned upon me as I felt my heart drop to the floor."
    "La comprensión se apoderó lentamente de mí mientras sentía que mi corazón se desmoronaba."

# game/data/travel_events/camp/kiara_camp_scene.rpy:71
translate es travel_event_kiara_camp_scene_firsttime_34d215e9:

    # MC @ sad "You..."
    MC @ sad "Tú..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:72
translate es travel_event_kiara_camp_scene_firsttime_180aa05d:

    # "Sadness and confusion quickly turn to hot anger."
    "La tristeza y la confusión enseguida se convirtieron en ira ardiente."

# game/data/travel_events/camp/kiara_camp_scene.rpy:73
translate es travel_event_kiara_camp_scene_firsttime_8b6e37bb:

    # MC @ angry "You were going to what? Have my child and then just sell them off for your own life!?"
    MC @ angry "¿¡Ibas a qué!? ¿¡Tener a mi hijo y luego venderlo para salvar tu propia vida!?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:74
translate es travel_event_kiara_camp_scene_firsttime_38977ef9:

    # KIARA @ sad "What choice did I have?"
    KIARA @ sad "¿Qué otra opción tenía?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:75
translate es travel_event_kiara_camp_scene_firsttime_8755bf58:

    # MC @ angry "And then what? Ride off into the sunset, forget I existed, and just pretend it was all some bad dream?"
    MC @ angry "¿Y luego qué? ¿Cabalgar hacia el horizonte, olvidar que existí y fingir que todo fue solo una pesadilla?"

# game/data/travel_events/camp/kiara_camp_scene.rpy:76
translate es travel_event_kiara_camp_scene_firsttime_44c375b1:

    # KIARA @ shock "No! I promise you, I..."
    KIARA @ shock "¡No! Te lo prometo, yo..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:77
translate es travel_event_kiara_camp_scene_firsttime_c39b4765:

    # KIARA @ sad "{i}I don't know if I was going to look for you after I got out.{/i}"
    KIARA @ sad "{i}No sé si iba a buscarte después de que saliera.{/i}"

# game/data/travel_events/camp/kiara_camp_scene.rpy:78
translate es travel_event_kiara_camp_scene_firsttime_62301bb6:

    # KIARA @ shock "But I promise you, I was going to use my funds to try and have her sent to serve in Angharad where it was safe!"
    KIARA @ shock "¡Pero te prometo que iba a utilizar mis fondos para intentar que la enviaran a servir a Angharad, donde estaría a salvo!"

# game/data/travel_events/camp/kiara_camp_scene.rpy:79
translate es travel_event_kiara_camp_scene_firsttime_336217af:

    # KIARA @ shock "On my life, it's the truth!"
    KIARA @ shock "¡Lo juro por mi vida, es la verdad!"

