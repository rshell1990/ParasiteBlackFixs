translate es travel_event_kiara_camp_scene_firsttime_622ab2db:

    # KIARA @ cry "You and I both know it was a miracle's miracle that we both walked out of the scouts alive."
    KIARA @ cry "Tú y yo sabemos que fue un milagro que ambos saliéramos vivos de los exploradores."

# game/data/travel_events/camp/kiara_camp_scene.rpy:93
translate es travel_event_kiara_camp_scene_firsttime_923ed3c3:

    # KIARA @ cry "I couldn't..."
    KIARA @ cry "No pude..."

# game/data/travel_events/camp/kiara_camp_scene.rpy:94
translate es travel_event_kiara_camp_scene_firsttime_be1e549f:

    # "Kiara stopped herself, biting down on her lip as she turned her head away, closing her eyes as she pushed away the memories."
    "Kiara se detuvo, mordiéndose el labio mientras apartaba la cabeza y cerraba los ojos para alejar los recuerdos."

# game/data/travel_events/camp/kiara_camp_scene.rpy:95
translate es travel_event_kiara_camp_scene_firsttime_1adec665:

    # KIARA @ sad "I understand if you hate me right now."
    KIARA @ sad "Entiendo si ahora mismo me odias."

