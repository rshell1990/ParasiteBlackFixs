

# game/data/travel_events/crashed_ship.rpy:13
translate es travel_event_crashed_ship_c7f49737:

    # BLACK "{i}...Going wrong way.{/i}"
    BLACK "{i}...Vamos por el camino equivocado.{/i}"

# game/data/travel_events/crashed_ship.rpy:15
translate es travel_event_crashed_ship_73790772:

    # MC @ angry "We are not going the wrong way!"
    MC @ angry "¡No vamos por el camino equivocado!"

# game/data/travel_events/crashed_ship.rpy:16
translate es travel_event_crashed_ship_1cd0e33a:

    # BLACK "{i}We are lost.{/i}"
    BLACK "{i}Estamos perdidos.{/i}"

# game/data/travel_events/crashed_ship.rpy:17
translate es travel_event_crashed_ship_71d2cf05:

    # MC @ angry "We are not lost!"
    MC @ angry "¡No estamos perdidos!"

# game/data/travel_events/crashed_ship.rpy:19
translate es travel_event_crashed_ship_66dfd255:

    # MC @ talk "We just—"
    MC @ talk "Solo—"

# game/data/travel_events/crashed_ship.rpy:21
translate es travel_event_crashed_ship_90844184:

    # MC @ talk "We just need to find our—"
    MC @ talk "Solo tenemos que encontrar—"

# game/data/travel_events/crashed_ship.rpy:23
translate es travel_event_crashed_ship_88b2ee55:

    # "Suddenly, I felt the earth crumble beneath me."
    "De repente, sentí que la tierra se desmoronaba bajo mis pies."

# game/data/travel_events/crashed_ship.rpy:26
translate es travel_event_crashed_ship_934fef82:

    # "I gasped as I plummeted into a great chasm below."
    "Jadeé mientras caía en picado a un gran abismo."

# game/data/travel_events/crashed_ship.rpy:28
translate es travel_event_crashed_ship_a4b26b88:

    # "The fall lasted only moments, wind whipping past as panic surged through me."
    "La caída duró solo unos instantes, el viento me azotaba mientras el pánico me invadía."

# game/data/travel_events/crashed_ship.rpy:29
translate es travel_event_crashed_ship_b71673c2:

    # "One of my blackened tentacles shot out, anchoring into the wall and halting my descent."
    "Uno de mis tentáculos ennegrecidos salió disparado, anclándose en la pared y deteniendo mi descenso."

# game/data/travel_events/crashed_ship.rpy:30
translate es travel_event_crashed_ship_e352090c:

    # MARKUS @ shock "[player_name!t]!"
    MARKUS @ shock "¡[player_name!t]!"

# game/data/travel_events/crashed_ship.rpy:32
translate es travel_event_crashed_ship_81a47010:

    # "Lowering myself carefully, I landed on a patch of dirt below, lit faintly by the chasm's natural opening."
    "Descendí con cuidado y aterricé en un pedazo de tierra, débilmente iluminado por la abertura natural del abismo."

# game/data/travel_events/crashed_ship.rpy:33
translate es travel_event_crashed_ship_dda0aa4b:

    # MARKUS "Can you hear me?!"
    MARKUS "¡¿Puedes oírme?!"

# game/data/travel_events/crashed_ship.rpy:34
translate es travel_event_crashed_ship_354115c9:

    # MC @ talk "I'm alright."
    MC @ talk "Estoy bien."

# game/data/travel_events/crashed_ship.rpy:35
translate es travel_event_crashed_ship_6baba279:

    # "As my eyes adjusted, the full scale of the pit became clear."
    "A medida que mis ojos se ajustaban, se hizo evidente la magnitud del socavón."

# game/data/travel_events/crashed_ship.rpy:41
translate es travel_event_crashed_ship_141d7189:

    # MC @ think "Is this... some kind of cave?"
    MC @ think "¿Esto es... una especie de cueva?"

# game/data/travel_events/crashed_ship.rpy:43
translate es travel_event_crashed_ship_f02ac22b:

    # "There, partially submerged in shallow water, was something metallic—a ship?"
    "Allí, parcialmente sumergido en aguas poco profundas, había algo metálico, ¿un barco?"

# game/data/travel_events/crashed_ship.rpy:44
translate es travel_event_crashed_ship_e26d324c:

    # "Ruined and entangled in vines, the strange relic beckoned."
    "Arruinada y enredada en enredaderas, la extraña reliquia me llamó a la atención."

# game/data/travel_events/crashed_ship.rpy:45
translate es travel_event_crashed_ship_b3c9f1a5:

    # MARKUS "What do you see down there?!"
    MARKUS "¡¿Qué ves ahí abajo?!"

# game/data/travel_events/crashed_ship.rpy:46
translate es travel_event_crashed_ship_8ec5fa0b:

    # MC @ serious "You might want to come down here."
    MC @ serious "Tal vez quieras venir aquí."

# game/data/travel_events/crashed_ship.rpy:48
translate es travel_event_crashed_ship_4001a4a4:

    # "The others climbed down with caution."
    "Los demás bajaron con precaución."

# game/data/travel_events/crashed_ship.rpy:50
translate es travel_event_crashed_ship_f5a0c50b:

    # MARKUS @ shock "What in seven hells is that thing?"
    MARKUS @ shock "¿Qué demonios es esa cosa?"

# game/data/travel_events/crashed_ship.rpy:51
translate es travel_event_crashed_ship_11bcc543:

    # MC @ think "Some kind of ship?"
    MC @ think "¿Algún tipo de barco?"

# game/data/travel_events/crashed_ship.rpy:52
translate es travel_event_crashed_ship_539ee9fb:

    # MARKUS @ talk "Where are its sails?"
    MARKUS @ talk "¿Dónde están sus velas?"

# game/data/travel_events/crashed_ship.rpy:53
translate es travel_event_crashed_ship_3dad54df:

    # MC @ think "Never seen a vessel like this... and this far from any sea?"
    MC @ think "Nunca había visto un barco así... ¿y tan lejos de cualquier mar?"

# game/data/travel_events/crashed_ship.rpy:57
translate es travel_event_crashed_ship_0208f36a:

    # MYU @ scared "M-Myu? Metal thing scary..."
    MYU @ scared "¿M-Myu? La cosa metálica da miedo..."

# game/data/travel_events/crashed_ship.rpy:62
translate es travel_event_crashed_ship_8138fa88:

    # VES @ think "I've heard rumors of the Greater Trading Company reinforcing ships with armor, but this..."
    VES @ think "He oído rumores de que la Gran Compañía Comercial refuerza los barcos con blindaje, pero esto..."

# game/data/travel_events/crashed_ship.rpy:63
translate es travel_event_crashed_ship_e9cd7d09:

    # VES @ talk "This is nothing like anything I've ever seen."
    VES @ talk "Esto no se parece a nada que haya visto."

# game/data/travel_events/crashed_ship.rpy:68
translate es travel_event_crashed_ship_ba8e8344:

    # ELENA @ grumpy "Perhaps... a relic of the old gods?"
    ELENA @ grumpy "Tal vez... ¿una reliquia de los antiguos dioses?"

# game/data/travel_events/crashed_ship.rpy:69
translate es travel_event_crashed_ship_c90ffbe7:

    # ELENA @ grumpy "Judging by how deep this cavern is, it must've been buried here for thousands of years."
    ELENA @ grumpy "A juzgar por la profundidad de esta cueva, debe haber estado enterrado aquí durante miles de años."

# game/data/travel_events/crashed_ship.rpy:75
translate es travel_event_crashed_ship_985866dd:

    # SYPHA @ talk "{i}And so, in ages past, they rode mechanical beasts across the stars.{/i}"
    SYPHA @ talk "{i}Y así, en épocas pasadas, surcaban las estrellas a lomos de bestias mecánicas.{/i}"

# game/data/travel_events/crashed_ship.rpy:76
translate es travel_event_crashed_ship_bde6c2b6:

    # MC @ think "What?"
    MC @ think "¿Qué?"

# game/data/travel_events/crashed_ship.rpy:77
translate es travel_event_crashed_ship_c24c1193:

    # SYPHA @ think "Nothing. Just old legends from childhood."
    SYPHA @ think "Nada. Solo viejas leyendas de la infancia."

# game/data/travel_events/crashed_ship.rpy:84
translate es travel_event_crashed_ship_16bf6a3c:

    # MC @ serious "Whatever it is, I don't like it."
    MC @ serious "Sea lo que sea, no me gusta."

# game/data/travel_events/crashed_ship.rpy:85
translate es travel_event_crashed_ship_cfd774db:

    # MC @ talk "Let's leave sleeping ghosts to rest."
    MC @ talk "Dejemos descansar a los fantasmas."

# game/data/travel_events/crashed_ship.rpy:86
translate es travel_event_crashed_ship_516553f1:

    # MARKUS @ talk "Agreed. Nothing good comes from disturbing the dead."
    MARKUS @ talk "Estoy de acuerdo. Nada bueno sale de molestar a los muertos."

# game/data/travel_events/crashed_ship.rpy:88
translate es travel_event_crashed_ship_013b3791:

    # "We climbed back out of the rift and resumed our journey."
    "Volvimos a salir de la grieta y reanudamos nuestro viaje."

# game/data/travel_events/crashed_ship.rpy:95
translate es travel_event_crashed_ship_inside_4a677239:

    # "Carefully, I approached the wreck."
    "Con cuidado, me acerqué a los restos."

# game/data/travel_events/crashed_ship.rpy:96
translate es travel_event_crashed_ship_inside_c1071274:

    # "I stepped into the freezing water and laid my hand on the cold metal hull."
    "Me metí en el agua helada y apoyé la mano en el frío casco metálico."

# game/data/travel_events/crashed_ship.rpy:99
translate es travel_event_crashed_ship_inside_08beff35:

    # MARKUS @ shock "[player_name!t]! What are you doing?"
    MARKUS @ shock "¡[player_name!t]! ¿Qué estás haciendo?"

# game/data/travel_events/crashed_ship.rpy:101
translate es travel_event_crashed_ship_inside_9ec1a37a:

    # "A hiss of steam sounded as the metal twisted open like a door."
    "Un siseo de vapor sonó cuando el metal se retorció abriéndose como una puerta."

# game/data/travel_events/crashed_ship.rpy:102
translate es travel_event_crashed_ship_inside_79a0bb39:

    # MARKUS @ shock "You're not actually going inside that thing, are you?"
    MARKUS @ shock "No vas a entrar en esa cosa, ¿verdad?"

# game/data/travel_events/crashed_ship.rpy:103
translate es travel_event_crashed_ship_inside_026bc247:

    # "I stepped in."
    "Entré."

# game/data/travel_events/crashed_ship.rpy:104
translate es travel_event_crashed_ship_inside_970d0f74:

    # MARKUS @ angry "Gods be damned, man."
    MARKUS @ angry "Malditos sean los dioses."

# game/data/travel_events/crashed_ship.rpy:109
translate es travel_event_crashed_ship_inside_bc2341db:

    # "Inside, it was cold."
    "Dentro hacía frío."

# game/data/travel_events/crashed_ship.rpy:112
translate es travel_event_crashed_ship_inside_4f0eba80:

    # "Our footsteps echoed across the metal floor."
    "Nuestros pasos resonaron en el suelo metálico."

# game/data/travel_events/crashed_ship.rpy:113
translate es travel_event_crashed_ship_inside_b2b6c7a4:

    # "Pipes snaked along the walls, choked in vines and pierced by jagged rock."
    "Las tuberías serpenteaban por las paredes, asfixiadas por enredaderas y perforadas por rocas dentadas."

# game/data/travel_events/crashed_ship.rpy:118
translate es travel_event_crashed_ship_inside_bd8053a5:

    # "A ghostly figure flickered into view inside a glowing circle."
    "Una figura fantasmal apareció dentro de un círculo brillante."

# game/data/travel_events/crashed_ship.rpy:119
translate es travel_event_crashed_ship_inside_472ec9d8:

    # MC @ angry "Who are you, specter?"
    MC @ angry "¿Quién eres, espectro?"

# game/data/travel_events/crashed_ship.rpy:120
translate es travel_event_crashed_ship_inside_bf2aaff8:

    # ANDRAS "This is Captain Andras of the Maylark."
    ANDRAS "Este es el capitán Andras del Maylark."

# game/data/travel_events/crashed_ship.rpy:121
translate es travel_event_crashed_ship_inside_365bbf88:

    # ANDRAS "Day four-hundred and ninety-six since the end of... well, everything."
    ANDRAS "Día cuatrocientos noventa y seis desde el final de... bueno, de todo."

# game/data/travel_events/crashed_ship.rpy:122
translate es travel_event_crashed_ship_inside_bf38bc6e:

    # MARKUS @ think "Uhhh... hello?"
    MARKUS @ think "Uhhh... ¿hola?"

# game/data/travel_events/crashed_ship.rpy:123
translate es travel_event_crashed_ship_inside_18baf767:

    # MC @ think "I don't think he can hear us."
    MC @ think "No creo que pueda oírnos."

# game/data/travel_events/crashed_ship.rpy:124
translate es travel_event_crashed_ship_inside_b20d5e02:

    # ANDRAS "...{i}*Sigh*{/i} I don't even know why I bother with these things anymore."
    ANDRAS "...{i}*Suspiro*{/i} Ya no sé ni por qué me molesto con estas cosas."

# game/data/travel_events/crashed_ship.rpy:125
translate es travel_event_crashed_ship_inside_96afb379:

    # ANDRAS "It's not like there's actually anyone left to log it."
    ANDRAS "No es que quede nadie para registrarlo."

# game/data/travel_events/crashed_ship.rpy:126
translate es travel_event_crashed_ship_inside_62cfcc16:

    # ANDRAS "For over a year and a half we've jumped from one dead star to the next."
    ANDRAS "Durante más de un año y medio hemos saltado de una estrella muerta a otra."

# game/data/travel_events/crashed_ship.rpy:127
translate es travel_event_crashed_ship_inside_881f07eb:

    # ANDRAS "One nightmarish, monster infested world to another, searching for someplace safe."
    ANDRAS "De un mundo de pesadilla infestado de monstruos a otro, en busca de un lugar seguro."

# game/data/travel_events/crashed_ship.rpy:128
translate es travel_event_crashed_ship_inside_e84fa312:

    # ANDRAS "I still tell the crew that's what we're looking for... Someplace safe."
    ANDRAS "Todavía le digo a la tripulación que eso es lo que estamos buscando... Algún lugar seguro."

# game/data/travel_events/crashed_ship.rpy:129
translate es travel_event_crashed_ship_inside_ec95d44a:

    # ANDRAS "I'd just settle for finding some food, fuel... anything now."
    ANDRAS "Me conformaría con encontrar algo de comida, combustible... cualquier cosa."

# game/data/travel_events/crashed_ship.rpy:130
translate es travel_event_crashed_ship_inside_b3b6925c:

    # ANDRAS "It's been months since we found any survivors."
    ANDRAS "Hace meses que no encontramos supervivientes."

# game/data/travel_events/crashed_ship.rpy:131
translate es travel_event_crashed_ship_inside_9fb46d95:

    # ANDRAS "Well, unless you count the cannibals and freaks."
    ANDRAS "Bueno, a menos que cuentes los caníbales y los monstruos."

# game/data/travel_events/crashed_ship.rpy:132
translate es travel_event_crashed_ship_inside_89d8f69d:

    # ANDRAS "... We have enough fuel for one last try, some unknown world ready on the edge of the Zelma ring."
    ANDRAS "... Tenemos suficiente combustible para un último intento, algún mundo desconocido listo en el borde del anillo Zelma."

# game/data/travel_events/crashed_ship.rpy:133
translate es travel_event_crashed_ship_inside_5b2a8029:

    # ANDRAS "Atmospheric readings look good from orbit, and there seems to be no visual signs of corruption."
    ANDRAS "Las lecturas atmosféricas parecen buenas desde la órbita, y no parece haber signos visuales de corrupción."

# game/data/travel_events/crashed_ship.rpy:134
translate es travel_event_crashed_ship_inside_8cd54f27:

    # ANDRAS "We'll probably stall out on the landing, but hopefully with power routed to the shields, we can at least survive the crash."
    ANDRAS "Probablemente nos quedemos parados en el aterrizaje, pero esperemos que con la energía enrutada a los escudos, al menos podamos sobrevivir al choque."

# game/data/travel_events/crashed_ship.rpy:135
translate es travel_event_crashed_ship_inside_bfea744e:

    # ANDRAS "May the new gods... Ahhh, fuck it."
    ANDRAS "Que los nuevos dioses... Ahhh, a la mierda."

# game/data/travel_events/crashed_ship.rpy:136
translate es travel_event_crashed_ship_inside_737f7819:

    # ANDRAS "{i}It's not like they're listening anymore anyway.{/i}"
    ANDRAS "{i}De todos modos, ya no escuchan.{/i}"

# game/data/travel_events/crashed_ship.rpy:137
translate es travel_event_crashed_ship_inside_9e72f391:

    # "There was momentary flickering of the strange figure summoned."
    "Hubo un parpadeo momentáneo de la extraña figura."

# game/data/travel_events/crashed_ship.rpy:138
translate es travel_event_crashed_ship_inside_0742b26c:

    # ANDRAS "Day, five hundred and two."
    ANDRAS "Día, quinientos dos."

# game/data/travel_events/crashed_ship.rpy:139
translate es travel_event_crashed_ship_inside_ce1c3d26:

    # ANDRAS "We survived the landing, but the ship's hull is too badly damaged to repair."
    ANDRAS "Sobrevivimos al aterrizaje, pero el casco de la nave está demasiado dañado para repararlo."

# game/data/travel_events/crashed_ship.rpy:140
translate es travel_event_crashed_ship_inside_7ca46618:

    # ANDRAS "{i}*Chuckles*{/i} Not that we have to fuel left to go anywhere anyway."
    ANDRAS "{i}*Risitas*{/i} No es que tengamos combustible para ir a ninguna parte de todos modos."

# game/data/travel_events/crashed_ship.rpy:141
translate es travel_event_crashed_ship_inside_ece942c3:

    # ANDRAS "The crew and I have decided to salvage what we can from the ship and head out."
    ANDRAS "La tripulación y yo hemos decidido salvar lo que podamos de la nave y partir."

# game/data/travel_events/crashed_ship.rpy:142
translate es travel_event_crashed_ship_inside_7d01dea4:

    # ANDRAS "Maybe we can etch out some kind of existence out here."
    ANDRAS "Quizá podamos forjar algún tipo de existencia aquí."

# game/data/travel_events/crashed_ship.rpy:143
translate es travel_event_crashed_ship_inside_9c0c2393:

    # ANDRAS "It might be a simple life... {i}But at least we're alive.{/i}"
    ANDRAS "Puede que sea una vida sencilla... {i}Pero al menos estamos vivos.{/i}"

# game/data/travel_events/crashed_ship.rpy:144
translate es travel_event_crashed_ship_inside_2d52d85d:

    # ANDRAS "... The gods."
    ANDRAS "... Los dioses."

# game/data/travel_events/crashed_ship.rpy:145
translate es travel_event_crashed_ship_inside_6c5751a7:

    # ANDRAS "How the fuck did it come to this?"
    ANDRAS "¿Cómo coño hemos llegado a esto?"

# game/data/travel_events/crashed_ship.rpy:146
translate es travel_event_crashed_ship_inside_94c58f75:

    # ANDRAS "We blame it all on Malakai and his damned war, but in the end, maybe it was just our blind faith that sealed our fates."
    ANDRAS "Culpamos de todo a Malakai y su maldita guerra, pero al final, tal vez fue solo nuestra fe ciega la que selló nuestros destinos."

# game/data/travel_events/crashed_ship.rpy:147
translate es travel_event_crashed_ship_inside_2820ff0b:

    # ANDRAS "We always presumed the gods were better than us, wiser, {i}more{/i} than us."
    ANDRAS "Siempre presumimos que los dioses eran mejores que nosotros, más sabios, {i}más{/i} que nosotros."

# game/data/travel_events/crashed_ship.rpy:148
translate es travel_event_crashed_ship_inside_b9ea5e3e:

    # ANDRAS "{i}But in the end, they fell to all the same trappings we do.{/i}"
    ANDRAS "{i}Pero al final, cayeron en las mismas trampas que nosotros.{/i}"

# game/data/travel_events/crashed_ship.rpy:149
translate es travel_event_crashed_ship_inside_e5b270d3:

    # ANDRAS "{i}And they dragged everyone down with them.{/i}"
    ANDRAS "{i}Y arrastraron a todos con ellos.{/i}"

# game/data/travel_events/crashed_ship.rpy:150
translate es travel_event_crashed_ship_inside_8a41f029:

    # ANDRAS "... Fuck the gods."
    ANDRAS "... Que les den a los dioses."

# game/data/travel_events/crashed_ship.rpy:151
translate es travel_event_crashed_ship_inside_1216340c:

    # ANDRAS "This is Captain Andras of the Maylark, signing off for the last time."
    ANDRAS "Soy el capitán Andras del Maylark, despidiéndome por última vez."

# game/data/travel_events/crashed_ship.rpy:152
translate es travel_event_crashed_ship_inside_10ce0df8:

    # "The image flickered, then began replaying."
    "La imagen parpadeó y empezó a repetirse."

# game/data/travel_events/crashed_ship.rpy:155
translate es travel_event_crashed_ship_inside_9d9f6087:

    # MC @ think "What do you make of that?"
    MC @ think "¿Qué opinas de eso?"

# game/data/travel_events/crashed_ship.rpy:157
translate es travel_event_crashed_ship_inside_df5f47d2:

    # MARKUS @ talk "Jumping stars... Malakai's war... If this is from the Second War of the Gods... it's ancient."
    MARKUS @ talk "Saltar estrellas... La guerra de Malakai... Si esto es de la segunda guerra de los dioses... es antiguo."

# game/data/travel_events/crashed_ship.rpy:161
translate es travel_event_crashed_ship_inside_ad56e14d:

    # SYPHA @ talk "We shouldn't linger."
    SYPHA @ talk "No debemos demorarnos."

# game/data/travel_events/crashed_ship.rpy:162
translate es travel_event_crashed_ship_inside_613528ce:

    # SYPHA @ think "Let ghosts rest."
    SYPHA @ think "Deja descansar a los fantasmas."

# game/data/travel_events/crashed_ship.rpy:171
translate es travel_event_crashed_ship_inside_17813b31:

    # "Most of it had decayed."
    "La mayor parte se había deteriorado."

# game/data/travel_events/crashed_ship.rpy:172
translate es travel_event_crashed_ship_inside_1bcd7585:

    # "Anything that once had purpose crumbled in my hands."
    "Todo lo que alguna vez tuvo un propósito se desmoronó en mis manos."

# game/data/travel_events/crashed_ship.rpy:173
translate es travel_event_crashed_ship_inside_e4d9e770:

    # "Except... one thing."
    "Excepto... una cosa."

# game/data/travel_events/crashed_ship.rpy:174
translate es travel_event_crashed_ship_inside_d79ab9c3:

    # "A small metal box."
    "Una pequeña caja metálica."

# game/data/travel_events/crashed_ship.rpy:175
translate es travel_event_crashed_ship_inside_4b38b6fa:

    # "Inside, a glowing blue crystal pulsed rhythmically."
    "En su interior, un cristal azul brillante palpitaba rítmicamente."

# game/data/travel_events/crashed_ship.rpy:179
translate es travel_event_crashed_ship_inside_50da1bb3:

    # "I reached in and took the orb."
    "Metí la mano y cogí el orbe."

# game/data/travel_events/crashed_ship.rpy:180
translate es travel_event_crashed_ship_inside_1343b6dc:

    # "It detached easily from its cables."
    "Se soltó fácilmente de sus cables."

# game/data/travel_events/crashed_ship.rpy:181
translate es travel_event_crashed_ship_inside_1797a4db:

    # "As I did, the specter's loop stopped."
    "Al hacerlo, el bucle del espectro se detuvo."

# game/data/travel_events/crashed_ship.rpy:184
translate es travel_event_crashed_ship_inside_eb9a0d09:

    # MARKUS @ angry "What did you do?"
    MARKUS @ angry "¿Qué has hecho?"

# game/data/travel_events/crashed_ship.rpy:185
translate es travel_event_crashed_ship_inside_c2f71451:

