

# game/data/travel_events/raider..rpy:3
translate es travel_event_raider_40da6313:

    # "While making my way along the roads, I suddenly had the strangest sense something was wrong..."
    "Mientras caminaba por el camino, de repente tuve la extraña sensación de que algo iba mal..."

# game/data/travel_events/raider..rpy:4
translate es travel_event_raider_f79e4a26:

    # BLACK "({i}Enemies ... all around us{/i})."
    BLACK "({i}Enemigos... a nuestro alrededor{/i})."

# game/data/travel_events/raider..rpy:6
translate es travel_event_raider_00d7c7b1:

    # "A flying arrow suddenly landed itself at my foot, barely missing me as I drew my blade."
    "De repente, una flecha cayó a mi pie y apenas me alcanzó cuando desenvainé mi espada."

# game/data/travel_events/raider..rpy:7
translate es travel_event_raider_c17db1ef:

    # "From out of their hiding spots, charged the group of bandits!"
    "¡El grupo de bandidos salió de sus escondites y cargó!"

# game/data/travel_events/raider..rpy:13
translate es travel_event_raider_e51b4a2a:

    # MC "(Shit!)"
    MC "(¡Mierda!)"

# game/data/travel_events/raider.rpy:14
translate es travel_event_raider_a511df2a:

    # BANDIT "Give us everything you've got or we'll pry it from your dead fucking hands!"
    BANDIT "¡Danos todo lo que tengas o te lo arrancaremos de tus malditas manos muertas!"

# game/data/travel_events/raider.rpy:18
translate es travel_event_raider_d06ec560:

    # BANDIT "Let's make this easy now, give us your-"
    BANDIT "Hagámoslo fácil, danos tu-"

# game/data/travel_events/raider..rpy:20
translate es travel_event_raider_8742b282:

    # "Suddenly, the bandit was toppled over in a flash, screaming as a wild wolf tore at his throat."
    "De repente, el bandido cayó al suelo en un instante, gritando mientras un lobo salvaje le desgarraba la garganta."

# game/data/travel_events/raider.rpy:20
translate es travel_event_raider_00d4941a:

    # BANDIT "AHHHHHHRGHHHH! GET IT OFF ME! GET IT FUCKING-"
    BANDIT "¡AHHHHHRGHHHH! ¡QUÍDAMELO DE AHÍ! ¡QUÍDAMELO DE-"

# game/data/travel_events/raider..rpy:22
translate es travel_event_raider_6565ed17:

    # "Silence, choking on his blood as he clutched at his torn-out throat, the other bandits panicked as they desperately tried to either run away or rush over."
    "Silencio, ahogándose en su sangre mientras se agarraba la garganta arrancada, los otros bandidos entraron en pánico mientras intentaban desesperadamente huir o acercarse."

# game/data/travel_events/raider..rpy:23
translate es travel_event_raider_cd79a6fc:

    # "One by one, in quick succession, they were pulled and dragged down by the wolves who sprung out from the tall grass, howling with delight as they pressed their fangs into the warm blood and flesh."
    "Uno por uno, en rápida sucesión, fueron tirados y arrastrados por los lobos que saltaron de la hierba alta, aullando de alegría mientras presionaban sus colmillos en la sangre y la carne cálidas."

# game/data/travel_events/raider..rpy:25
translate es travel_event_raider_dfaa6aa7:

    # "My heart racing, I held my hand on the hilt of my blade, ready to draw it, when I felt Elena's hand on my shoulder."
    "Con el corazón acelerado, sostuve mi mano en la empuñadura de mi espada, listo para desenvainarla, cuando sentí la mano de Elena en mi hombro."

# game/data/travel_events/raider..rpy:26
translate es travel_event_raider_4aebc8b2:

    # ELENA "Keep your blade sheathed."
    ELENA "Mantén tu espada envainada."

# game/data/travel_events/raider..rpy:27
translate es travel_event_raider_10f7686b:

    # ELENA "They're letting us pass..."
    ELENA "Nos están dejando pasar..."

# game/data/travel_events/raider..rpy:28
translate es travel_event_raider_7cb86101:

    # "The leader of the pack looked up towards us, mouth covered in blood and panting."
    "El líder de la manada miró hacia nosotros, con la boca cubierta de sangre y jadeando."

# game/data/travel_events/raider..rpy:29
translate es travel_event_raider_f4b78898:

    # "He barked happily, before tucking back into his {i}'meal.'{/i}"
    "Ladró alegremente, antes de volver a su {i}'comida.'{/i}"

# game/data/travel_events/raider..rpy:30
translate es travel_event_raider_c83c3a46:

    # ELENA @ smile "Told you that you'd made new friends..."
    ELENA @ smile "Te dije que habías hecho nuevos amigos..."

# game/data/travel_events/raider.rpy:34
translate es travel_event_raider_71495f59:

    # BANDIT "HAVE IT YOUR WAY!"
    BANDIT "¡HAZLO A TU MANERA!"

# game/data/travel_events/raider..rpy:49
translate es travel_event_raider_f334646b:

    # "With the last of the bandits slain and dead at my feet, I carried on, leaving their corpses for the crows."
    "Con el último de los bandidos asesinado y muerto a mis pies, continué, dejando sus cadáveres para los cuervos."

# game/data/travel_events/raider.rpy:52
translate es travel_event_raider_f68e9917:

    # BANDIT "F-Fuck this! Boys! We're out of here!"
    BANDIT "¡A-ah la mierda con esto! ¡Chicos! ¡Nos vamos de aquí!"

# game/data/travel_events/raider..rpy:55
translate es travel_event_raider_f7631e05:

    # "The trembling bandits fled from where they came."
    "Los bandidos, temblorosos, huyeron de donde vinieron."

# game/data/travel_events/raider..rpy:60
translate es travel_event_raider_618e1372:

    # "{i}After spending some time trying to convince them about about a caravan ambushed by Demorai down the road back the way I came...{/i}"
    "{i}Después de pasar algún tiempo intentando convencerlos sobre una caravana emboscada por demorai en el camino por el que vine...{/i}"

# game/data/travel_events/raider.rpy:61
translate es travel_event_raider_d01d2ade:

    # BANDIT "Hmm, alright, you can go."
    BANDIT "Hmm, está bien, puedes irte."

# game/data/travel_events/raider.rpy:62
translate es travel_event_raider_e446dbb3:

    # BANDIT "But if we find you're lying, you're fucking dead!"
    BANDIT "¡Pero si descubrimos que estás mintiendo, estás jodidamente muerto!"

# game/data/travel_events/raider..rpy:65
translate es travel_event_raider_3d302e34:

    # "The bandits left in the direction I pointed."
    "Los bandidos se marcharon en la dirección que señalé."

# game/data/travel_events/raider..rpy:67
translate es travel_event_raider_73f1c8c7:

    # MC "(Idiots.)"
    MC "(Idiotas)."

# game/data/travel_events/raider.rpy:72
translate es travel_event_raider_add49207:

    # BANDIT "Hand it over! Heh!"
    BANDIT "¡Dámelo! ¡Jeje!"

translate es strings:

    # game/data/travel_events/raider..rpy:34
    old "{image=[ICON.SWORDS]} I don't think so..."
    new "{image=[ICON.SWORDS]} No lo creo..."

    # game/data/travel_events/raider..rpy:34
    old "There's no need to fight, I know where a much better haul is..."
    new "No hay necesidad de pelear, sé dónde hay un botín mucho mejor..."

    # game/data/travel_events/raider..rpy:34
    old "I'll slaughter each and every one of you, and when I'm done, I'll wear your flayed skin as a trophy to show to your loved ones."
    new "Os mataré a todos y cada uno de vosotros, y cuando termine, usaré vuestra piel desollada como trofeo para mostrarla a vuestros seres queridos."

    # game/data/travel_events/raider..rpy:34
    old "I'll give you what you want..."
    new "Te daré lo que quieres..."
