

# game/data/travel_events/travel_banter.rpy:38
translate es travelmodebanter_map_elena_mc_1_1d4d5faf:

    # ELENA @ talk "Have you ever thought about leaving Alderay?"
    ELENA @ talk "¿Has pensado alguna vez en dejar Alderay?"

# game/data/travel_events/travel_banter.rpy:39
translate es travelmodebanter_map_elena_mc_1_4a2613e4:

    # MC @ think "Where'd that come from?"
    MC @ think "¿A qué viene eso?"

# game/data/travel_events/travel_banter.rpy:40
translate es travelmodebanter_map_elena_mc_1_9828a89f:

    # ELENA @ talk "Just... curiosity."
    ELENA @ talk "Solo... curiosidad."

# game/data/travel_events/travel_banter.rpy:41
translate es travelmodebanter_map_elena_mc_1_e722756d:

    # ELENA @ talk "Growing up at Thornfalls, I dreamt of faraway places and adventures."
    ELENA @ talk "Creciendo con los Thornfalls, soñaba con lugares lejanos y aventuras."

# game/data/travel_events/travel_banter.rpy:42
translate es travelmodebanter_map_elena_mc_1_6308ffa5:

    # ELENA @ smile "It seems silly now, but... I still think about the places I want to see."
    ELENA @ smile "Ahora parece una tontería, pero... sigo pensando en los lugares que quiero ver."

# game/data/travel_events/travel_banter.rpy:45
translate es travelmodebanter_map_elena_mc_1_96b1d0a3:

    # ELENA @ shock "Just like that?"
    ELENA @ shock "¿Así de fácil?"

# game/data/travel_events/travel_banter.rpy:46
translate es travelmodebanter_map_elena_mc_1_bb7eda56:

    # MC @ smile "There's a whole world out there."
    MC @ smile "Hay todo un mundo ahí fuera."

# game/data/travel_events/travel_banter.rpy:47
translate es travelmodebanter_map_elena_mc_1_c579fce3:

    # ELENA @ smile "And would there be room for one more?"
    ELENA @ smile "¿Y habría sitio para una más?"

# game/data/travel_events/travel_banter.rpy:48
translate es travelmodebanter_map_elena_mc_1_6bc977b7:

    # MC @ smile2 "I'm sure I could fit you in."
    MC @ smile2 "Seguro que podría hacerte un hueco."

# game/data/travel_events/travel_banter.rpy:49
translate es travelmodebanter_map_elena_mc_1_5b4dee46:

    # ELENA @ smile "I must admit, I'm surprised."
    ELENA @ smile "Debo admitir que estoy sorprendida."

# game/data/travel_events/travel_banter.rpy:50
translate es travelmodebanter_map_elena_mc_1_082ad89d:

    # ELENA @ smile "Markus told me all you two wanted was a quiet life behind palace walls."
    ELENA @ smile "Markus me dijo que lo único que queríais era una vida tranquila tras los muros del palacio."

# game/data/travel_events/travel_banter.rpy:51
translate es travelmodebanter_map_elena_mc_1_0d739712:

    # MC @ talk "Funny, isn't it?"
    MC @ talk "Curioso, ¿verdad?"

# game/data/travel_events/travel_banter.rpy:52
translate es travelmodebanter_map_elena_mc_1_995149d2:

    # MC @ talk "That dream started feeling more like a cage after... everything."
    MC @ talk "Ese sueño comenzó a sentirse más como una jaula después de... todo."

# game/data/travel_events/travel_banter.rpy:53
translate es travelmodebanter_map_elena_mc_1_e5753e06:

    # ELENA @ smile "No. Not strange at all. Not to me."
    ELENA @ smile "No. No es extraño en absoluto. No para mí."

# game/data/travel_events/travel_banter.rpy:55
translate es travelmodebanter_map_elena_mc_1_19758ec6:

    # ELENA @ talk "Ahh, you seem more like a homebody."
    ELENA @ talk "Ahh, pareces más hogareño."

# game/data/travel_events/travel_banter.rpy:56
translate es travelmodebanter_map_elena_mc_1_b3517fc1:

    # MC @ think "Oh?"
    MC @ think "¿Oh?"

# game/data/travel_events/travel_banter.rpy:57
translate es travelmodebanter_map_elena_mc_1_01b971be:

    # ELENA @ grumpy "You and Markus dreamed of royal service, didn't you?"
    ELENA @ grumpy "Markus y tú soñabais con el servicio real, ¿verdad?"

# game/data/travel_events/travel_banter.rpy:58
translate es travelmodebanter_map_elena_mc_1_6204f33e:

    # ELENA @ smile "Not exactly an adventurous life."
    ELENA @ smile "No es exactamente una vida de aventuras."

# game/data/travel_events/travel_banter.rpy:59
translate es travelmodebanter_map_elena_mc_1_ab966d56:

    # MC @ talk "Is wanting a quiet life so wrong?"
    MC @ talk "¿Tan malo es querer una vida tranquila?"

# game/data/travel_events/travel_banter.rpy:60
translate es travelmodebanter_map_elena_mc_1_4ca3d53f:

    # ELENA @ smile "Not at all."
    ELENA @ smile "En absoluto."

# game/data/travel_events/travel_banter.rpy:61
translate es travelmodebanter_map_elena_mc_1_b2753dd2:

    # ELENA @ smile "It's your life to live."
    ELENA @ smile "Debes vivir tu vida."

# game/data/travel_events/travel_banter.rpy:62
translate es travelmodebanter_map_elena_mc_1_cdd397f7:

    # MC @ think "{i}... And when this war is one day over.{/i}"
    MC @ think "{i}... Y cuando esta guerra termine algún día..{/i}"

# game/data/travel_events/travel_banter.rpy:63
translate es travelmodebanter_map_elena_mc_1_1cfe520f:

    # MC @ think "{i}Is it a life you'd want to be a part of?{/i}"
    MC @ think "{i}¿Es una vida de la que te gustaría formar parte?{/i}"

# game/data/travel_events/travel_banter.rpy:64
translate es travelmodebanter_map_elena_mc_1_4c9bb63b:

    # ELENA @ lewd "L-Let's leave that question for another day."
    ELENA @ lewd "D-dejemos esa pregunta para otro día."

# game/data/travel_events/travel_banter.rpy:74
translate es travelmodebanter_map_elena_mc_2_dfcc99a2:

    # ELENA @ grumpy "...Does it hurt?"
    ELENA @ grumpy "...¿Duele?"

# game/data/travel_events/travel_banter.rpy:76
translate es travelmodebanter_map_elena_mc_2_bde6c2b6:

    # MC @ think "What?"
    MC @ think "¿Qué?"

# game/data/travel_events/travel_banter.rpy:77
translate es travelmodebanter_map_elena_mc_2_4b60e47a:

    # ELENA @ grumpy "When you change into that thing... does it hurt?"
    ELENA @ grumpy "Cuando te transformas en esa cosa... ¿te duele?"

# game/data/travel_events/travel_banter.rpy:78
translate es travelmodebanter_map_elena_mc_2_3496abfa:

    # MC @ talk "It... did. At first."
    MC @ talk "Lo... hizo. Al principio."

# game/data/travel_events/travel_banter.rpy:80
translate es travelmodebanter_map_elena_mc_2_0a297aba:

    # MC @ talk "It was agony."
    MC @ talk "Fue una agonía."

# game/data/travel_events/travel_banter.rpy:81
translate es travelmodebanter_map_elena_mc_2_54e3ddd7:

    # MC @ talk "But it gets easier every time."
    MC @ talk "Pero cada vez es más fácil."

# game/data/travel_events/travel_banter.rpy:83
translate es travelmodebanter_map_elena_mc_2_c2fc29a5:

    # MC @ talk "Why do you ask?"
    MC @ talk "¿Por qué lo preguntas?"

# game/data/travel_events/travel_banter.rpy:84
translate es travelmodebanter_map_elena_mc_2_ede2ccf2:

    # ELENA @ sad "Just worried about you."
    ELENA @ sad "Solo estoy preocupada por ti."

# game/data/travel_events/travel_banter.rpy:85
translate es travelmodebanter_map_elena_mc_2_7cedfe97:

    # ELENA @ talk "How are you holding up? After everything that's happened so fast..."
    ELENA @ talk "¿Cómo lo llevas? Después de todo lo que ha pasado tan rápido..."

# game/data/travel_events/travel_banter.rpy:88
translate es travelmodebanter_map_elena_mc_2_cf94bad7:

    # ELENA @ shock "Really? I'm surprised... most people would struggle."
    ELENA @ shock "¿De verdad? Me sorprende... a la mayoría le costaría."

# game/data/travel_events/travel_banter.rpy:89
translate es travelmodebanter_map_elena_mc_2_094bce6b:

    # MC @ talk "There are doubts, sure. But we can actually change things now."
    MC @ talk "Hay dudas, claro. Pero ahora sí que podemos cambiar las cosas."

# game/data/travel_events/travel_banter.rpy:90
translate es travelmodebanter_map_elena_mc_2_e1f4d040:

    # MC @ smile "Before the gift, I felt powerless. Like my life wasn't mine."
    MC @ smile "Antes del don, me sentía impotente. Como si mi vida no fuera mía."

# game/data/travel_events/travel_banter.rpy:91
translate es travelmodebanter_map_elena_mc_2_92dfa1e6:

    # MC @ smile "Now? It's like we finally have... {i}hope.{/i}"
    MC @ smile "¿Ahora? Es como si finalmente tuviéramos... {i}esperanza.{/i}"

# game/data/travel_events/travel_banter.rpy:92
translate es travelmodebanter_map_elena_mc_2_73c0b9f3:

    # ELENA @ smile "You're starting to sound like a hero from the old tales."
    ELENA @ smile "Empiezas a sonar como un héroe de los cuentos antiguos."

# game/data/travel_events/travel_banter.rpy:93
translate es travelmodebanter_map_elena_mc_2_f18990c6:

    # MC @ smile "Let's not go that far."
    MC @ smile "No vayamos tan lejos."

# game/data/travel_events/travel_banter.rpy:94
translate es travelmodebanter_map_elena_mc_2_91c8e0b3:

    # ELENA @ smile "Come. Let's keep moving."
    ELENA @ smile "Vamos. Sigamos adelante."

# game/data/travel_events/travel_banter.rpy:96
translate es travelmodebanter_map_elena_mc_2_a4311795:

    # ELENA @ sad "That's... a relief. You can talk to me, you know."
    ELENA @ sad "Eso es... un alivio. Puedes hablar conmigo, ¿sabes?"

# game/data/travel_events/travel_banter.rpy:97
translate es travelmodebanter_map_elena_mc_2_b067621a:

    # MC @ smile "That means more than you think."
    MC @ smile "Eso significa más de lo que crees."

# game/data/travel_events/travel_banter.rpy:98
translate es travelmodebanter_map_elena_mc_2_42ddcd91:

    # ELENA @ smile "Come on. Let's keep moving."
    ELENA @ smile "Venga, vamos. Sigamos adelante."

# game/data/travel_events/travel_banter.rpy:100
translate es travelmodebanter_map_elena_mc_2_2f15a7d9:

    # ELENA @ sad "I'm here if you want to talk."
    ELENA @ sad "Estoy aquí si quieres hablar."

# game/data/travel_events/travel_banter.rpy:101
translate es travelmodebanter_map_elena_mc_2_30d77ce8:

    # ELENA @ sad "It weighs heavy, doesn't it? Memories that won't let go..."
    ELENA @ sad "Pesa mucho, ¿verdad? Recuerdos que no se van..."

# game/data/travel_events/travel_banter.rpy:102
translate es travelmodebanter_map_elena_mc_2_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/travel_events/travel_banter.rpy:103
translate es travelmodebanter_map_elena_mc_2_6c08d76e:

    # ELENA @ sad "A-Anyway! I just wanted you to know you're not alone."
    ELENA @ sad "¡D-de todos modos! Solo quería que supieras que no estás solo."

# game/data/travel_events/travel_banter.rpy:104
translate es travelmodebanter_map_elena_mc_2_1a43d7a9:

    # ELENA @ talk "I'm here if you need me."
    ELENA @ talk "Estoy aquí si me necesitas."

# game/data/travel_events/travel_banter.rpy:105
translate es travelmodebanter_map_elena_mc_2_ddf70b53:

    # MC @ smile "Thank you, Elena."
    MC @ smile "Gracias, Elena."

# game/data/travel_events/travel_banter.rpy:106
translate es travelmodebanter_map_elena_mc_2_0403d166:

    # ELENA @ smile "Come. Let's keep going."
    ELENA @ smile "Vamos. Sigamos."

# game/data/travel_events/travel_banter.rpy:116
translate es travelmodebanter_map_elena_mc_3_romance_ed8a1411:

    # "While walking, something soft brushed against my side."
    "Mientras caminaba, algo suave rozó mi costado."

# game/data/travel_events/travel_banter.rpy:118
translate es travelmodebanter_map_elena_mc_3_romance_899cf127:

    # "Elena passed me with a coy smile and a soft hum."
    "Elena pasó junto a mí con una sonrisa tímida y un suave tarareo."

# game/data/travel_events/travel_banter.rpy:119
translate es travelmodebanter_map_elena_mc_3_romance_fe9303c4:

    # ELENA @ smile "{i}*Happy humming*{/i}"
    ELENA @ smile "{i}*Tarareo feliz*{/i}"

# game/data/travel_events/travel_banter.rpy:120
translate es travelmodebanter_map_elena_mc_3_romance_3321ea6a:

    # MC @ smile "Someone's in a good mood."
    MC @ smile "Alguien está de buen humor."

# game/data/travel_events/travel_banter.rpy:122
translate es travelmodebanter_map_elena_mc_3_romance_07f53f05:

    # ELENA @ smile "Of course. The weather's pleasant, the air is clean..."
    ELENA @ smile "Por supuesto. El tiempo es agradable, el aire es limpio..."

# game/data/travel_events/travel_banter.rpy:123
translate es travelmodebanter_map_elena_mc_3_romance_bc9974f6:

    # "She glanced back, her sultry eyes dancing."
    "Miró hacia atrás, con sus sensuales ojos."

# game/data/travel_events/travel_banter.rpy:124
translate es travelmodebanter_map_elena_mc_3_romance_3f6ec57a:

    # ELENA @ smile "And {i}the view{/i} is quite nice, too."
    ELENA @ smile "Y {i}la vista{/i} también es bastante bonita."

# game/data/travel_events/travel_banter.rpy:125
translate es travelmodebanter_map_elena_mc_3_romance_eaad9ebd:

    # MC @ smile "The view, huh?"
    MC @ smile "La vista, ¿eh?"

# game/data/travel_events/travel_banter.rpy:126
translate es travelmodebanter_map_elena_mc_3_romance_80da6f9e:

    # "Her tail brushed me again playfully as she walked ahead."
    "Su cola volvió a rozarme juguetonamente mientras avanzaba."

# game/data/travel_events/travel_banter.rpy:127
translate es travelmodebanter_map_elena_mc_3_romance_f4fe840d:

    # ELENA @ smile "Yes. It's been on my mind a lot lately."
    ELENA @ smile "Sí. Últimamente me ronda mucho por la cabeza."

# game/data/travel_events/travel_banter.rpy:130
translate es travelmodebanter_map_elena_mc_3_romance_c670f114:

    # MC @ smile "(Cute.)"
    MC @ smile "(Qué mona)."

# game/data/travel_events/travel_banter.rpy:137
translate es travelmodebanter_map_elena_markus_1_ddfff1fd:

    # MARKUS @ think "So, you're a lady, then?"
    MARKUS @ think "Entonces, ¿eres una señorita?"

# game/data/travel_events/travel_banter.rpy:139
translate es travelmodebanter_map_elena_markus_1_abecf88a:

    # ELENA @ talk "Yes, I do indeed belong to the female gender."
    ELENA @ talk "Sí, pertenezco al género femenino."

# game/data/travel_events/travel_banter.rpy:140
translate es travelmodebanter_map_elena_markus_1_d0033b5e:

    # MARKUS @ angry "You know that wasn't what I was talking about!"
    MARKUS @ angry "¡Sabes que no me refería a eso!"

# game/data/travel_events/travel_banter.rpy:141
translate es travelmodebanter_map_elena_markus_1_3213a1a5:

    # MARKUS @ talk "I mean, you're a *lady* lady. Like, you grew up in some huge estate house."
    MARKUS @ talk "Quiero decir, eres una *señorita*. Como si hubieras crecido en una casa enorme."

# game/data/travel_events/travel_banter.rpy:142
translate es travelmodebanter_map_elena_markus_1_9316f5fc:

    # ELENA @ smile "Yes. The ones with the very long tables and lots of food on them."
    ELENA @ smile "Sí. Las que tienen mesas muy largas y mucha comida encima."

# game/data/travel_events/travel_banter.rpy:143
translate es travelmodebanter_map_elena_markus_1_f6ced7d6:

    # ELENA @ smile "Are you going somewhere with this?"
    ELENA @ smile "¿Vas a alguna parte con esto?"

# game/data/travel_events/travel_banter.rpy:144
translate es travelmodebanter_map_elena_markus_1_a54c70bc:

    # MARKUS @ talk "Sensitive much?"
    MARKUS @ talk "¿Muy sensible?"

# game/data/travel_events/travel_banter.rpy:146
translate es travelmodebanter_map_elena_markus_1_2de858ba:

    # ELENA @ talk "I can assure you, manor house or not, my time at the Thornfalls was... difficult."
    ELENA @ talk "Puedo asegurarte, casa señorial o no, que mi estancia en los Thornfalls fue... difícil."

# game/data/travel_events/travel_banter.rpy:147
translate es travelmodebanter_map_elena_markus_1_6211068f:

    # MARKUS @ think "I find that hard to believe."
    MARKUS @ think "Me cuesta creerlo."

# game/data/travel_events/travel_banter.rpy:148
translate es travelmodebanter_map_elena_markus_1_298cf6f7:

    # MARKUS @ think "Did you ever have to worry about where your next meal would come from?"
    MARKUS @ think "¿Alguna vez tuviste que preocuparte por la procedencia de tu próxima comida?"

# game/data/travel_events/travel_banter.rpy:149
translate es travelmodebanter_map_elena_markus_1_24473bcf:

    # MARKUS @ think "Or constantly wonder when, not if, the next loved one would be taken by this infernal war?"
    MARKUS @ think "¿O preguntarse constantemente cuándo, y no si, se llevaría esta guerra infernal al siguiente ser querido?"

# game/data/travel_events/travel_banter.rpy:150
translate es travelmodebanter_map_elena_markus_1_3cdbde5f:

    # ELENA @ angry "No..."
    ELENA @ angry "No..."

# game/data/travel_events/travel_banter.rpy:152
translate es travelmodebanter_map_elena_markus_1_77cdaa2f:

    # ELENA @ angry "I just spent every night living in fear."
    ELENA @ angry "Me pasaba todas las noches viviendo con miedo."

# game/data/travel_events/travel_banter.rpy:153
translate es travelmodebanter_map_elena_markus_1_d313e372:

    # ELENA @ angry "Let me tell you something, Markus."
    ELENA @ angry "Déjame decirte algo, Markus."

# game/data/travel_events/travel_banter.rpy:154
translate es travelmodebanter_map_elena_markus_1_f52bc4d7:

    # ELENA @ angry "It's one kind of hell to starve... it's another entirely to wonder if every meal you're served will be your last."
    ELENA @ angry "Una cosa es morirse de hambre... y otra muy distinta es preguntarse si cada comida que te sirvan será la última."

# game/data/travel_events/travel_banter.rpy:164
translate es travelmodebanter_map_elena_markus_2_6b1dd249:

    # MARKUS @ talk "Tell me, Elena."
    MARKUS @ talk "Dime, Elena."

# game/data/travel_events/travel_banter.rpy:166
translate es travelmodebanter_map_elena_markus_2_10d78c40:

    # MARKUS @ talk "You must have spent some time traveling around before meeting us."
    MARKUS @ talk "Debes haber pasado algún tiempo viajando antes de conocernos."

# game/data/travel_events/travel_banter.rpy:167
translate es travelmodebanter_map_elena_markus_2_2f0ee648:

    # MARKUS @ smile "Got any interesting stories to tell?"
    MARKUS @ smile "¿Tienes alguna anécdota interesante que contar?"

# game/data/travel_events/travel_banter.rpy:168
translate es travelmodebanter_map_elena_markus_2_c983087c:

    # ELENA @ grumpy "...A while back, while I was in Newyark, I heard about a 'wolf woman' and naturally, my interest was piqued."
    ELENA @ grumpy "...Hace tiempo, mientras estaba en Newyark, oí hablar de una 'mujer loba' y, naturalmente, despertó mi interés."

# game/data/travel_events/travel_banter.rpy:169
translate es travelmodebanter_map_elena_markus_2_71871438:

    # ELENA @ talk "It didn't sound like any kind of Katai, so I thought perhaps I might finally find another of my kind."
    ELENA @ talk "No me sonaba a ningún tipo de katai, así que pensé que quizá por fin encontraría a otro de mi especie."

# game/data/travel_events/travel_banter.rpy:170
translate es travelmodebanter_map_elena_markus_2_e936c5f8:

    # MARKUS @ think "What did you find?"
    MARKUS @ think "¿Qué encontraste?"

# game/data/travel_events/travel_banter.rpy:171
translate es travelmodebanter_map_elena_markus_2_2dd61dd9:

    # ELENA @ shock "It was a woman who had made some kind of... fur suit from different pelts of wolves."
    ELENA @ shock "Era una mujer que había confeccionado una especie de... traje de piel con diferentes pieles de lobo."

# game/data/travel_events/travel_banter.rpy:173
translate es travelmodebanter_map_elena_markus_2_03538783:

    # ELENA @ shock "She was running around on stage pretending to be a wolf!"
    ELENA @ shock "¡Estaba corriendo por el escenario fingiendo ser un lobo!"

# game/data/travel_events/travel_banter.rpy:174
translate es travelmodebanter_map_elena_markus_2_cc301a3c:

    # ELENA @ shock "Can you imagine people doing such a strange thing?"
    ELENA @ shock "¿Te imaginas a la gente haciendo algo tan extraño?"

# game/data/travel_events/travel_banter.rpy:175
translate es travelmodebanter_map_elena_markus_2_0f3ab35d:

    # MARKUS @ think "...Too much salt in the air from the sea."
    MARKUS @ think "...Demasiada sal del mar en el aire."

# game/data/travel_events/travel_banter.rpy:176
translate es travelmodebanter_map_elena_markus_2_f1fa7ebb:

    # MARKUS @ think "That's why all those Newyark folk are so strange."
    MARKUS @ think "Por eso toda esa gente de Newyark es tan extraña."

# game/data/travel_events/travel_banter.rpy:186
translate es travelmodebanter_map_elena_markus_3_8008183f:

    # ELENA @ smile "Markus, I'm curious about something..."
    ELENA @ smile "Markus, tengo curiosidad por algo..."

# game/data/travel_events/travel_banter.rpy:188
translate es travelmodebanter_map_elena_markus_3_a04187b6:

    # MARKUS @ talk "Ask away."
    MARKUS @ talk "Pregunta."

# game/data/travel_events/travel_banter.rpy:189
translate es travelmodebanter_map_elena_markus_3_aaf4f0d0:

    # ELENA @ talk "I'm aware of [player_name!t]'s... umm, {i}paramours and dalliances.{/i}"
    ELENA @ talk "Estoy al tanto de las... um, {i}amantes y aventuras{/i} de [player_name!t]."

# game/data/travel_events/travel_banter.rpy:190
translate es travelmodebanter_map_elena_markus_3_10dd5267:

    # ELENA @ grumpy "But I never see you with anyone."
    ELENA @ grumpy "Pero nunca te veo con nadie."

# game/data/travel_events/travel_banter.rpy:191
translate es travelmodebanter_map_elena_markus_3_33702753:

    # ELENA @ grumpy "Isn't your affliction the same?"
    ELENA @ grumpy "¿No tienes la misma aflicción?"

# game/data/travel_events/travel_banter.rpy:192
translate es travelmodebanter_map_elena_markus_3_a03d34bd:

    # MARKUS @ smile "Ahh..."
    MARKUS @ smile "Ahh..."

# game/data/travel_events/travel_banter.rpy:193
translate es travelmodebanter_map_elena_markus_3_b4eaef0f:

    # MARKUS @ smile "Let's just say there isn't a brothel house in Novaras that probably doesn't know who my favorites are now."
    MARKUS @ smile "Digamos que no hay burdel en Novaras que no sepa quiénes son ahora mis favoritas."

