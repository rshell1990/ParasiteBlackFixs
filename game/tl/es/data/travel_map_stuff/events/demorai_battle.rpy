

# game/data/travel_map_stuff/events/demorai_battle.rpy:3
translate es travel_event_battle_demorai_45842b22:

    # "While making my way along the roads, I suddenly heard what sounded like a roar, followed by rumbling drawing quickly closer."
    "Mientras avanzaba por los caminos, oí de repente lo que parecía un rugido, seguido de un estruendo que se acercaba rápidamente."

# game/data/travel_map_stuff/events/demorai_battle.rpy:4
translate es travel_event_battle_demorai_966a7836:

    # "Suddenly, teeth and claws were gnashing all around me as the hideous demorai launched their attack!"
    "¡De repente, dientes y garras crujieron a mi alrededor cuando los horribles demorai se lanzaron al ataque!"

# game/data/travel_map_stuff/events/demorai_battle.rpy:11
translate es travel_event_battle_demorai_2e0bf73c:

    # MC "(SHIT!)"
    MC "(¡MIERDA!)"

# game/data/travel_map_stuff/events/demorai_battle.rpy:12
translate es travel_event_battle_demorai_45d3e65f:

    # MC "DEMORAI!"
    MC "¡DEMORAI!"

# game/data/travel_map_stuff/events/demorai_battle.rpy:23
translate es travel_event_battle_demorai_751a111e:

    # "Slaying the last of the demorai, I sighed and wiped the blood from myself before moving forward."
    "Al matar al último de los demorai, suspiré y me limpié la sangre antes de seguir adelante."

# game/data/travel_map_stuff/events/demorai_battle.rpy:25
translate es travel_event_battle_demorai_7fd6ff35:

    # MC "(Need to be careful travelling these roads ... I should make sure I'm prepared for whatever may come my way.)"
    MC "(Debo tener cuidado al viajar por estos caminos... Debo asegurarme de estar preparado para lo que se me presente)."
