

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:2
translate es travel_event_lizard_camp_visit_pregnant_bc8337af:

    # "While moving around the camp, I picked up a distinct scent that made me stop in my tracks."
    "Mientras me movía por el campamento, percibí un olor distintivo que me hizo detenerme."

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:3
translate es travel_event_lizard_camp_visit_pregnant_627fb527:

    # "As I looked around, I listened carefully, and for a moment, I thought perhaps I was wrong; perhaps there was nothing there."
    "Mientras miraba a mi alrededor, escuché con atención y por un momento pensé que quizá estaba equivocado; tal vez no había nada allí."

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:4
translate es travel_event_lizard_camp_visit_pregnant_99f44af8:

    # "Then I heard it, that distinct {i}hissing{/i} sound, calling to me."
    "Entonces lo oí, ese sonido {i}silbante{/i} tan distintivo que me llamaba."

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:12
translate es travel_event_lizard_camp_visit_pregnant_167176ed:

    # "Following the voice towards the outskirts of the camp, I found the Skalith waiting for me."
    "Siguiendo la voz hacia las afueras del campamento, encontré a la skalith esperándome."

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:13
translate es travel_event_lizard_camp_visit_pregnant_006492e1:

    # "She let out a low rumble when she saw me, but my eyes were naturally drawn to the round, pregnant belly she tenderly rubbed at."
    "Ella dejó escapar un gruñido bajo cuando me vio, pero mis ojos se sintieron naturalmente atraídos por el vientre redondo y embarazado que ella frotaba con ternura."

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:14
translate es travel_event_lizard_camp_visit_pregnant_009ace1c:

    # MC @ surprised "You're-"
    MC @ surprised "¿Estás-"

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:15
translate es travel_event_lizard_camp_visit_pregnant_d346991d:

    # "I stopped myself. The girl didn't seem to register my words, but she understood my surprise."
    "Me detuve. La chica no pareció entenderr mis palabras, pero entendió mi sorpresa."

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:17
translate es travel_event_lizard_camp_visit_pregnant_c1fa40b4:

    # "Stepping forward, she tenderly placed my hands onto her belly for a moment, letting me feel the child moving around inside."
    "Dando un paso adelante, colocó tiernamente mis manos sobre su vientre por un momento, dejándome sentir al niño moviéndose dentro."

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:18
translate es travel_event_lizard_camp_visit_pregnant_22694b3a:

    # "As I looked up to her to meet her eyes, she stepped back, turning tail to flee into the distance!"
    "¡Cuando la miré a los ojos, ella dio un paso atrás y giró para huir en la distancia!"

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:20
translate es travel_event_lizard_camp_visit_pregnant_4f4f1287:

    # MC "Wait! Stop!"
    MC "¡Espera! ¡Detente!"

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:21
translate es travel_event_lizard_camp_visit_pregnant_7a0856e3:

    # MC @ serious "(That Skalith... It came to see me to let me know she carried my child?)"
    MC @ serious "(Esa Skalith ... ¿Vino a verme para hacerme saber que llevaba a mi hijo?)"

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:22
translate es travel_event_lizard_camp_visit_pregnant_a1a776b2:

    # MC @ think "(I thought those things were just mindless killers?)"
    MC @ think "(¿Creí que esas cosas eran simplemente asesinos sin mente?)"

# game/data/travel_map_stuff/events/lizards_camp_visit.rpy:26
