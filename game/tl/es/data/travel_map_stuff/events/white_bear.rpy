

# game/data/travel_map_stuff/events/white_bear.rpy:4
translate es travel_event_white_bear_40821a37:

    # "While making my way along the path, a loud bestial grunt was followed by a defiant roar."
    "Mientras avanzaba por el sendero, un fuerte gruñido bestial fue seguido de un rugido desafiante."

# game/data/travel_map_stuff/events/white_bear.rpy:7
translate es travel_event_white_bear_35ff010e:

    # "Every hair on my body stood up as I turned, hand ready on my blade to see a huge bear charging towards us!"
    "Se me erizaron todos los pelos del cuerpo cuando me giré, con la mano preparada en mi espada, ¡para ver a un enorme oso que cargaba hacia nosotros!"

# game/data/travel_map_stuff/events/white_bear.rpy:8
translate es travel_event_white_bear_18239e37:

    # MC @ angry "BEARRRRRRRRRR!"
    MC @ angry "¡OSOOOOOOOOOO¡"

# game/data/travel_map_stuff/events/white_bear.rpy:11
translate es travel_event_white_bear_61576259:

    # "Every hair on my body stood up as I turned, hand ready on my blade to see a huge bear charging towards me!"
    "Se me erizaron todos los pelos del cuerpo cuando me giré, con la mano preparada en mi espada, ¡para ver a un enorme oso que cargaba hacia mí!"

# game/data/travel_map_stuff/events/white_bear.rpy:12
translate es travel_event_white_bear_f977539f:

    # MC "(A bear!)"
    MC "(¡Un oso!)"

# game/data/travel_map_stuff/events/white_bear.rpy:17
translate es travel_event_white_bear_6c36125b:

    # "With a loud thud, the bear finally collapsed to the floor, its chest rising and falling slowly with every wheezing breath."
    "Con un fuerte golpe, el oso se desplomó finalmente en el suelo, con el pecho subiendo y bajando lentamente con cada respiración jadeante."

# game/data/travel_map_stuff/events/white_bear.rpy:18
translate es travel_event_white_bear_03aa7802:

    # "Eventually, after one final exhale, the thing lay silent and motionless on the floor."
    "Finalmente, tras una última exhalación, se quedó en silencio e inmóvil en el suelo."
