

# game/data/travel_map_stuff/events/wolves.rpy:3
translate es travel_event_wolves_d9365df9:

    # "While trekking my way through the forests, I heard the distinct sound of...{i}howling?{/i}"
    "Mientras caminaba por los bosques, oí el sonido inconfundible de... {i}¿aullidos?{/i}"

# game/data/travel_map_stuff/events/wolves.rpy:4
translate es travel_event_wolves_9123a2e4:

    # "From the tree lines, a pack of hungry wolves descended upon me, snarling and circling."
    "Desde las líneas de árboles, una manada de lobos hambrientos descendió sobre mí, gruñendo y dando vueltas."

# game/data/travel_map_stuff/events/wolves.rpy:7
translate es travel_event_wolves_b05c7a7b:

    # "The wolves whined and howled as they scattered the winds."
    "Los lobos gemían y aullaban mientras se dispersaban."

# game/data/travel_map_stuff/events/wolves.rpy:8
translate es travel_event_wolves_cda900f2:

    # MC "(Damn beasts!)"
    MC "(¡Malditas bestias!)"

# game/data/travel_map_stuff/events/wolves.rpy:16
translate es travel_event_wolves_f567ab41:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Con el último de los lobos aullando de dolor, acabé rápidamente con su sufrimiento."
# game/data/travel_map_stuff/events/wolves.rpy:17
translate es travel_event_wolves_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Suspiro*{/i}"

# game/data/travel_map_stuff/events/wolves.rpy:18
translate es travel_event_wolves_ed59b7aa:

    # MC "(These poor things are half-starved, no wonder they're attacking on sight...)"
    MC "(Estas pobres cosas están medio muertas de hambre, no me extraña que ataquen nada más verte...)"

# game/data/travel_map_stuff/events/wolves.rpy:23
translate es travel_event_wolves_04301006:

    # MC @ think "I don't suppose {i}you{/i} could handle this?"
    MC @ think "¿Crees que {i}podrías{/i} encargarte de esto?"

# game/data/travel_map_stuff/events/wolves.rpy:24
translate es travel_event_wolves_c3f644c4:

    # ELENA "I mean, {i}I could try.{/i}"
    ELENA "Quiero decir, {i}podría intentar.{/i}"

# game/data/travel_map_stuff/events/wolves.rpy:26
translate es travel_event_wolves_b6bd6149:

    # "Elena stepped forward and snarled towards the wolves, who tilted their heads curiously in understanding."
    "Elena se adelantó y gruñó a los lobos, que ladeaban la cabeza con curiosidad y comprensión."

# game/data/travel_map_stuff/events/wolves.rpy:27
translate es travel_event_wolves_632809bd:

    # "After some brief barking, Elena turns towards you."
    "Tras unos breves ladridos, Elena se gira hacia ti."

# game/data/travel_map_stuff/events/wolves.rpy:28
translate es travel_event_wolves_6b567ed4:

    # ELENA @ sad "They're starving... They only want some food, and they'll leave us alone."
    ELENA @ sad "Están hambrientos... Solo quieren algo de comida y nos dejarán en paz."

# game/data/travel_map_stuff/events/wolves.rpy:36
translate es travel_event_wolves_5484d21a:

    # "Tossing the meat towards them, the wolves happily whined and barked as they chowed down."
    "Tras arrojarles la carne, los lobos gimieron y ladraron alegremente mientras la devoraban."

# game/data/travel_map_stuff/events/wolves.rpy:37
translate es travel_event_wolves_a23af468:

    # "Satisfied with their meal, they sped off into the forests, their leader looking back to give one last bark of appreciation."
    "Satisfechos con su comida, se adentraron en los bosques, y su líder miró hacia atrás para dar un último ladrido de agradecimiento."

# game/data/travel_map_stuff/events/wolves.rpy:39
translate es travel_event_wolves_058c8ebb:

    # ELENA @ smile "Looks like you've made a few new friends..."
    ELENA @ smile "Parece que has hecho nuevos amigos..."

# game/data/travel_map_stuff/events/wolves.rpy:42
translate es travel_event_wolves_937daf18:

    # "The wolves sadly whined... but then, once more, they began to snarl and bear their fangs."
    "Los lobos gimieron tristemente... pero luego, una vez más, empezaron a gruñir y a enseñar los colmillos."

# game/data/travel_map_stuff/events/wolves.rpy:43
translate es travel_event_wolves_3b747ef8:

    # ELENA "I don't think they're taking no for an answer!"
    ELENA "¡No creo que acepten un no por respuesta!"

# game/data/travel_map_stuff/events/wolves.rpy:49
translate es travel_event_wolves_f567ab41_1:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Con el último de los lobos aullando de dolor, acabé rápidamente con su sufrimiento."

# game/data/travel_map_stuff/events/wolves.rpy:50
translate es travel_event_wolves_a4f1e169_1:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Suspiro*{/i}"

# game/data/travel_map_stuff/events/wolves.rpy:52
translate es travel_event_wolves_579541dd:

    # MC "(Well, that could have gone better.)"
    MC "(Bueno, eso podría haber ido mejor)."

translate es strings:

    # game/data/travel_map_stuff/events/wolves.rpy:5
    old "Snarl back"
    new "Gruñir"

    # game/data/travel_map_stuff/events/wolves.rpy:5
    old "{image=[ICON.SWORDS]} Fight!"
    new "{image=[ICON.SWORDS]} ¡Luchar!"

    # game/data/travel_map_stuff/events/wolves.rpy:5
    old "Let Elena handle them."
    new "Dejar que Elena se encargue de ellos."

    # game/data/travel_map_stuff/events/wolves.rpy:29
    old "Throw them some meat."
    new "Lánzales algo de carne."

    # game/data/travel_map_stuff/events/wolves.rpy:29
    old "I have nothing to give."
    new "No tengo nada que dar."
