

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:4
translate es vizura_caravan_battle_e61036f4:

    # GOBLIN "...Oh fuck!"
    GOBLIN "...¡Oh, mierda!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:6
translate es vizura_caravan_battle_1c3230d6:

    # GOBLIN "BOYS! GET OUT HERE! WE GOT TROUBLE!"
    GOBLIN "¡CHICOS! ¡SALID DE AQUÍ! ¡TENEMOS PROBLEMAS!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:7
translate es vizura_caravan_battle_09f94aa0:

    # "A scurry of goblins with spears hurried out of the caravan, weapons ready!"
    "¡Un grupo de goblins con lanzas se apresuró a salir de la caravana, con las armas preparadas!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:22
translate es vizura_caravan_battle_0053b9db:

    # "With the goblins dead at my feet, I approached the caravan doors and pried them open to loot whatever was inside."
    "Con los goblins muertos a mis pies, me acerqué a las puertas de la caravana y las abrí para saquear lo que hubiera dentro."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:23
translate es vizura_caravan_battle_da239c8d:

    # "Inside, the caravan was filed with armour and weapons and trinkets ... But that wasn't what drew my eyes' attention."
    "Dentro, la caravana estaba repleta de armaduras, armas y baratijas... Pero eso no fue lo que llamó la atención de mis ojos."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:24
translate es vizura_caravan_battle_5d183913:

    # "A singular goblin, still alive and sat in the center of the caravan holding a barrel of what seemed to be some powder,"
    "Un goblin singular, aún vivo y sentado en el centro de la caravana sosteniendo un barril de lo que parecía ser algo de pólvora,"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:25
translate es vizura_caravan_battle_f8361fa0:

    # "...raised his middle finger to me and snarled before slashing at the powder to trigger a spark."
    "...levantó el dedo corazón hacia mí y gruñó antes de lanzar un chispazo a la pólvora."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:36
translate es vizura_caravan_battle_d03313ac:

    # "Before I could stop him, the huge explosion sent me hurdling backwards as the caravan was engulfed in flames."
    "Antes de que pudiera detenerlo, la enorme explosión me hizo retroceder a toda velocidad mientras la caravana era pasto de las llamas."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:38
translate es vizura_caravan_battle_2379f606:

    # "The intense heat made me wince in pain as I painfully coughed up and exhaled the black smoke I had breathed in."
    "El intenso calor me hizo estremecer de dolor mientras tosía y exhalaba dolorosamente el humo negro que había respirado."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:44
translate es vizura_caravan_battle_327911fb:

    # MARKUS @ shock "FUCK! Are you okay?"
    MARKUS @ shock "¡JODER! ¿Estás bien?"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:45
translate es vizura_caravan_battle_bade04f4:

    # MC @ angry "{i}*Cough!* *Cough!*{/i} I'm fine, just... Urghh!"
    MC @ angry "{i}*¡Toser!* *¡Toser!*{/i} Estoy bien, solo... ¡Urghh!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:46
translate es vizura_caravan_battle_cffd8a42:

    # MARKUS @ angry "Green skins ... Can't trust any of them."
    MARKUS @ angry "Pieles verdes... No se puede confiar en ninguno de ellos."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:47
translate es vizura_caravan_battle_da8f9573:

    # MARKUS "You did the right thing, she'd have sunk a dagger in your back the moment she had a chance!"
    MARKUS "Hiciste lo correcto, ¡te habría clavado un puñal en la espalda en cuanto hubiera tenido ocasión!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:52
translate es vizura_caravan_battle_012f5b7d:

    # MYU @ talk "MYUUUUU!"
    MYU @ talk "¡MYUUUUU!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:53
translate es vizura_caravan_battle_eb6168b3:

    # MYU @ sad "Myu was really scared!"
    MYU @ sad "¡Myu estaba realmente asustada!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:54
translate es vizura_caravan_battle_8667ee16:

    # MC @ sad "Sorry - {i}*Cough!*{/i} Myu ... I'll try be more careful next time."
    MC @ sad "Lo siento - {i}*¡Toser!*{/i} Myu... Intentaré tener más cuidado la próxima vez."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:55
translate es vizura_caravan_battle_d0f9ef7f:

    # MYU @ scared "N-No fight unless have to!"
    MYU @ scared "¡N-no luches a menos que tengas que hacerlo!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:60
translate es vizura_caravan_battle_c3f414e5:

    # ELENA @ shock "What in all of the hells did you do that for?!"
    ELENA @ shock "¡¿Por qué demonios hiciste eso?!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:61
translate es vizura_caravan_battle_e44adaae:

    # MC @ angry "{i}*Cough!* *Cough!*{/i} It was a trap!"
    MC @ angry "{i}*¡Toser!* *¡Toser!*{/i} ¡Era una trampa!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:62
translate es vizura_caravan_battle_f06da0da:

    # ELENA @ angry "You don't know that!"
    ELENA @ angry "¡Eso no lo sabes!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:63
translate es vizura_caravan_battle_68f257ee:

    # ELENA @ angry "That was MADNESS!"
    ELENA @ angry "¡Eso fue una LOCURA!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:66
translate es vizura_caravan_battle_95e73392:

    # MARKUS @ angry "Lay off she-wolf, you can't just assume everything is out to shake your hand and cuddle you!"
    MARKUS @ angry "¡Déjalo, loba, no puedes dar por sentado que todo está ahí para darte la mano y abrazarte!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:67
translate es vizura_caravan_battle_7ab574e5:

    # ELENA @ angry "WE DIDN'T EVEN GIVE THEM A CHANCE!"
    ELENA @ angry "¡NI SIQUIERA LES DIMOS UNA OPORTUNIDAD!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:68
translate es vizura_caravan_battle_a4f13187:

    # MARKUS @ angry "They were armed! What more do you need?"
    MARKUS @ angry "Estaban armados. ¿Qué más necesitas?"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:69
translate es vizura_caravan_battle_dfe09cab:

    # ELENA @ angry "EVERYONE IS ARMED ON THESE ROADS!"
    ELENA @ angry "¡TODO EL MUNDO VA ARMADO POR ESTOS CAMINOS!"

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:70
translate es vizura_caravan_battle_28b29c79:

    # "Angrily, Elena stormed off, furious at what had happened."
    "Enfadada, Elena se marchó furiosa por lo sucedido."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:75
translate es vizura_caravan_battle_645d6701:

    # MARKUS "...She'll calm down eventually."
    MARKUS "...Se calmará eventualmente."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:79
translate es vizura_caravan_battle_28b29c79_1:

    # "Angrily, Elena stormed off, furious at what had happened."
    "Enfadada, Elena se marchó furiosa por lo sucedido."

# game/data/world_events/VizuraCaravan/Scr_Battle.rpy:83
translate es vizura_caravan_battle_f54a6802:

    # "Looking over at the now ruins of the caravan turned black from the intense flames, I couldn't help but wonder if I'd made the right decision?"
    "Al contemplar las ruinas de la caravana, ennegrecidas por las intensas llamas, no pude evitar preguntarme si había tomado la decisión correcta."
