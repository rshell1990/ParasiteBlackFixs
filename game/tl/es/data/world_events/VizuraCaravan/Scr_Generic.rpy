translate es vizura_caravan_revisit_talk_950e49d7:

    # VIZURA @ talk "How's the roads treatin' ya? What can Vizura do for you?"
    VIZURA @ talk "¿Cómo te tratan los caminos? ¿Qué puede hacer Vizura por ti?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:64
translate es vizura_caravan_talk_menu_917cd195:

    # VIZURA @ happy "Ho ho! Take a looksie!"
    VIZURA @ happy "¡Ho ho! ¡Echa un vistazo!"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:73
translate es vizura_caravan_talk_menu_3194ac1b:

    # VIZURA @ happy "Anything else you need?"
    VIZURA @ happy "¿Necesitas algo más?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:78
translate es vizura_caravan_talk_menu_5afb3c15:

    # VIZURA @ talk "Hmm, tempting."
    VIZURA @ talk "Hmm, tentador."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:79
translate es vizura_caravan_talk_menu_e6fc278d:

    # VIZURA @ talk "But sadly, I ain't got time to roll around in the hay with you, we gotta be on the move soon."
    VIZURA @ talk "Pero por desgracia, no tengo tiempo para revolcarme en el heno contigo, tenemos que ponernos en marcha pronto."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:80
translate es vizura_caravan_talk_menu_b9b03a72:

    # VIZURA @ talk "Let me know if you want anything else though."
    VIZURA @ talk "Pero avísame si quieres algo más."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:83
translate es vizura_caravan_talk_menu_da7af367:

    # VIZURA @ lewd "Fufu, couldn't stop thinking about this green arse, hm?"
    VIZURA @ lewd "Fufu, no podías dejar de pensar en este culo verde, ¿eh?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:86
translate es vizura_caravan_talk_menu_9179da90:

    # "Vizura stripped her clothes off in front of me, uncaring at anyone who might see as she smirked."
    "Vizura se desnudó delante de mí, sin importarle que alguien la viera mientras sonreía."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:87
translate es vizura_caravan_talk_menu_806a9b32:

    # VIZURA @ lewd "Step into my office, {i}love.{/i}"
    VIZURA @ lewd "Entra en mi oficina, {i}amor.{/i}"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:95
translate es vizura_caravan_talk_menu_8fb87d97:

    # VIZURA @ think "You got some kinda funny seed?"
    VIZURA @ think "¿Tienes una semilla rara?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:96
translate es vizura_caravan_talk_menu_93cb9ef4:

    # VIZURA @ surp "He's bigger and stronger than any other littlun I've ever seen!"
    VIZURA @ surp "Es más grande y fuerte que cualquier otro pequeñín que haya visto."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:97
translate es vizura_caravan_talk_menu_b09dd3ff:

    # VIZURA @ lewd "Let's go make another! Just thinking about how strong our children are is doing it for me!"
    VIZURA @ lewd "¡Vamos a hacer otro! ¡Solo de pensar en lo fuertes que son nuestros hijos ya me vale!"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:99
translate es vizura_caravan_talk_menu_36553582:

    # VIZURA @ talk "Fufu, aren't you a sweetheart, worryin' about our spawn?"
    VIZURA @ talk "Fufu, ¿no eres un encanto, preocupándote por nuestro retoño?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:100
translate es vizura_caravan_talk_menu_edf7ca9e:

    # VIZURA @ happy "Don't you worry, he's doing just fine."
    VIZURA @ happy "No te preocupes, está bien."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:101
translate es vizura_caravan_talk_menu_46ac6ffc:

    # VIZURA @ talk "Lookin' at the size of his {i}'sword'{/i} already, he's gonna make some goblin girls very happy when we head home!"
    VIZURA @ talk "Viendo el tamaño de su {i}'espada'{/i} va a hacer muy felices a algunas chicas goblin cuando volvamos a casa!"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:103
translate es vizura_caravan_talk_menu_40ce4b7f:

    # VIZURA @ surp "Ehh?! You really wanna know?"
    VIZURA @ surp "¡¿Ehh?! ¿De verdad quieres saberlo?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:104
translate es vizura_caravan_talk_menu_76f84bda:

    # VIZURA @ lewd "Fufu, I'm gonna come back and expect you to put another in me soon if you keep being sweet like that you know..."
    VIZURA @ lewd "Fufu, voy a volver y esperar que me metas otro pronto si sigues siendo así de dulce ya sabes..."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:105
translate es vizura_caravan_talk_menu_caefbebb:

    # VIZURA @ talk "And the littlun's fine, gonna prove one strong bastard when he's grown up fully!"
    VIZURA @ talk "Y el pequeño está bien, ¡será un bastardo fuerte cuando crezca del todo!"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:106
translate es vizura_caravan_talk_menu_b178677a:

    # VIZURA @ think "He might even become a chieftain if he keeps growin' at this rate..."
    VIZURA @ think "Podría incluso convertirse en jefe si sigue creciendo' a este ritmo..."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:110
translate es vizura_caravan_talk_menu_cd87ab5b:

    # VIZURA @ talk "Fine, but make them quick, time is money and all that."
    VIZURA @ talk "Bien, pero que sean rápidas, el tiempo es oro y todo eso."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:113
translate es vizura_caravan_talk_menu_questions_b47f48a1:

    # VIZURA @ angry "Tsch! You tryna' say somethin' human?"
    VIZURA @ angry "¡Tsch! ¿Intentas' decir algo' humano?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:114
translate es vizura_caravan_talk_menu_questions_da37266b:

    # VIZURA @ angry "Ain't nothin' illegal about a goblin travellin!'"
    VIZURA @ angry "¡No hay na' ilegal en que un goblin viaje!"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:115
translate es vizura_caravan_talk_menu_questions_969aa5fb:

    # VIZURA @ talk "Well, if you must know, I'm what they call a {i}freehelm{/i} goblin."
    VIZURA @ talk "Bueno, si debes saberlo, soy lo que llaman un goblin {i}freehelm{/i}."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:116
translate es vizura_caravan_talk_menu_questions_60a0fb7e:

    # VIZURA @ talk "We get permission and what-not with the various kingdoms to travel across borders and do some business as we go."
    VIZURA @ talk "Obtenemos permisos y demás con los distintos reinos para viajar a través de las fronteras y hacer negocios sobre la marcha."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:117
translate es vizura_caravan_talk_menu_questions_be6c2f06:

    # MC @ talk "And the rulers don't mind that?"
    MC @ talk "¿Y a los gobernantes no les importa?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:118
translate es vizura_caravan_talk_menu_questions_e798e29c:

    # VIZURA @ talk "Don't matter if they {i}don't{/i} like it, if you're gonna be allied to Irydian, one of the terms are to allow us freehelm folk passage to do business."
    VIZURA @ talk "No importa si {i}no{/i} les gusta, si van a ser aliados de Irydian, uno de los términos es permitirnos a los freehelm el paso para hacer negocios."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:119
translate es vizura_caravan_talk_menu_questions_98785572:

    # VIZURA @ talk "We don't intervere with human politics and what-not, so most just begrudingly accept us for the sake of wider trade."
    VIZURA @ talk "No nos inmiscuimos en la política humana, así que la mayoría nos acepta a regañadientes por el bien de un comercio más amplio."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:123
translate es vizura_caravan_talk_menu_questions_8c818204:

    # VIZURA @ surp "AND PAY TAXES? ARE YOU FUCKING CRAZY HUMAN?"
    VIZURA @ surp "¿Y PAGAR IMPUESTOS? ¿ESTÁS LOCO HUMANO?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:124
translate es vizura_caravan_talk_menu_questions_81579575:

    # VIZURA @ angry "Bloody thiefing bastards!"
    VIZURA @ angry "¡Malditos ladrones bastardos!"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:125
translate es vizura_caravan_talk_menu_questions_b34488ef:

    # VIZURA @ talk "{i}Oooh! We use your taxes to improve the roads and things though!{/i}"
    VIZURA @ talk "{i}¡Oooh! ¡Pero usamos tus impuestos para mejorar los caminos y esas cosas!{/i}"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:126
translate es vizura_caravan_talk_menu_questions_4d98591a:

    # VIZURA @ angry "You seen the roads recently? My ass is fucking sore from bouncing on all the uneven bumps!"
    VIZURA @ angry "¿Has visto los caminos últimamente? ¡Me duele el culo de tanto rebotar en los baches!"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:130
translate es vizura_caravan_talk_menu_questions_36bd8a82:

    # VIZURA @ talk "I dunno, like, a dozen of us maybe?"
    VIZURA @ talk "No sé, ¿una docena de nosotros tal vez?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:131
translate es vizura_caravan_talk_menu_questions_9cb7ffb4:

    # MC @ talk "Why so many?"
    MC @ talk "¿Por qué tantos?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:132
translate es vizura_caravan_talk_menu_questions_c7e022a9:

    # VIZURA @ talk "Goblins are strong in numbers, gotta keep the caravan safe in case of thieves and what-not."
    VIZURA @ talk "Los goblins son fuertes en número, hay que mantener la caravana a salvo en caso de ladrones y demás."

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:136
translate es vizura_caravan_talk_menu_questions_69c8d000:

    # VIZURA @ talk "Great, any other business?"
    VIZURA @ talk "Genial, ¿algún otro asunto?"

# game/data/world_events/VizuraCaravan/Scr_Generic.rpy:140
translate es vizura_caravan_talk_menu_questions_889d49a4:

    # VIZURA @ happy "Very well, until next time, handsome."
    VIZURA @ happy "Muy bien, hasta la próxima, guapo."


translate es strings:

    # game/data/world_events/VizuraCaravan/Scr_Generic.rpy:62
    old "Show me your wares."
    new "Muéstrame tu mercancía."

    # game/data/world_events/VizuraCaravan/Scr_Generic.rpy:62
    old "You free for an hour or so for some ... {i}fun?{/i}"
    new "Estás libre una hora o así para ... {i}divertirte?{/i}"

    # game/data/world_events/VizuraCaravan/Scr_Generic.rpy:62
    old "How's our, uh... child?"
    new "¿Cómo está nuestro... hijo?"

    # game/data/world_events/VizuraCaravan/Scr_Generic.rpy:62
    old "I have some questions..."
    new "Tengo algunas preguntas..."

    # game/data/world_events/VizuraCaravan/Scr_Generic.rpy:111
    old "What's a goblin doing in Alderay?"
    new "¿Qué hace un goblin en Alderay?"

    # game/data/world_events/VizuraCaravan/Scr_Generic.rpy:111
    old "Why not set up in one of the cities?"
    new "¿Por qué no instalarse en una de las ciudades?"

    # game/data/world_events/VizuraCaravan/Scr_Generic.rpy:111
    old "I heard a few voices coming from that caravan... How many goblins are in there?"
    new "Escuché algunas voces que venían de esa caravana... ¿Cuántos goblins hay ahí?"

    # game/data/world_events/VizuraCaravan/Scr_Generic.rpy:111
    old "That's all I wanted to ask."
    new "Eso es todo lo que quería preguntar."
