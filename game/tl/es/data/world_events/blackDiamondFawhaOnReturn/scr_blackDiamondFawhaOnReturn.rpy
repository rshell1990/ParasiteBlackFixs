

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:8
translate es ev_blackDiamondFawhaOnReturn_9e6fc692:

    # FAWHA "{i}*Gasp!*{/i}"
    FAWHA "{i}*¡Jadear!*{/i}"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:9
translate es ev_blackDiamondFawhaOnReturn_58827ada:

    # FAWHA @ smile "It's you!"
    FAWHA @ smile "¡Eres tú!"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:10
translate es ev_blackDiamondFawhaOnReturn_b355d1c4:

    # MC @ talk "Fawha?"
    MC @ talk "¿Fawha?"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:11
translate es ev_blackDiamondFawhaOnReturn_0b81376e:

    # MC @ talk "What's happened here?"
    MC @ talk "¿Qué ha pasado aquí?"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:15
translate es ev_blackDiamondFawhaOnReturn_567f7c0b:

    # FAWHA @ talk "Why hello sir, you may call me Fawha."
    FAWHA @ talk "Hola señor, puede llamarme Fawha."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:18
translate es ev_blackDiamondFawhaOnReturn_aee11678:

    # FAWHA @ talk "What pleasure do you seek tonight, sir?"
    FAWHA @ talk "¿Qué placer busca esta noche, señor?"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:19
translate es ev_blackDiamondFawhaOnReturn_f0104eae:

    # MC @ talk "This place has changed since I was last here..."
    MC @ talk "Este lugar ha cambiado desde la última vez que estuve aquí..."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:20
translate es ev_blackDiamondFawhaOnReturn_20c5e206:

    # FAWHA @ talk "A-Ah... Yes, a lot has no doubt changed these past few days."
    FAWHA @ talk "A-Ah... Sí, sin duda han cambiado muchas cosas estos últimos días."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:21
translate es ev_blackDiamondFawhaOnReturn_8eb2c968:

    # MC @ talk "Can you talk about it?"
    MC @ talk "¿Puede hablar sobre ello?"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:22
translate es ev_blackDiamondFawhaOnReturn_e9dd749a:

    # FAWHA @ talk "It's not exactly much of a secret anymore what's been going on sir..."
    FAWHA @ talk "Ya no es exactamente un secreto lo que ha estado pasando, señor..."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:25
translate es ev_blackDiamondFawhaOnReturn_da9e306b:

    # FAWHA @ talk "After Tarek was killed, the rival factions have been tearing each other apart to grab what they can of Tarek's old territory."
    FAWHA @ talk "Tras la muerte de Tarek, las facciones rivales se han desgarrado mutuamente para apoderarse del antiguo territorio de Tarek."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:26
translate es ev_blackDiamondFawhaOnReturn_7a940b86:

    # FAWHA @ talk "The Khazhah have managed to push out the rival factions and take over management here."
    FAWHA @ talk "Los Khazhah han conseguido expulsar a las facciones rivales y hacerse con el control de la zona."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:27
translate es ev_blackDiamondFawhaOnReturn_ca4ecab6:

    # MC @ talk "Are you treated well?"
    MC @ talk "¿Te tratan bien?"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:28
translate es ev_blackDiamondFawhaOnReturn_a26c51b6:

    # FAWHA @ talk "Khazah's treat us well enough I suppose, but they're flooding the place with more raza than the Vulshan's ever did."
    FAWHA @ talk "Los Khazah nos tratan bastante bien, supongo, pero están inundando el lugar con más raza de la que nunca tuvieron los Vulshan."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:29
translate es ev_blackDiamondFawhaOnReturn_d37638f8:

    # FAWHA @ sad "Things are becoming more violent than ever now... I fear things will only get worse before they get better."
    FAWHA @ sad "Ahora las cosas son más violentas que nunca... Temo que las cosas empeoren antes de mejorar."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:32
translate es ev_blackDiamondFawhaOnReturn_f237078f:

    # FAWHA @ talk "Since Tarek's death, the Vulshan have re-organised themselves and begun aggressively pushing back against Khazahs."
    FAWHA @ talk "Desde la muerte de Tarek, los Vulshan se han reorganizado y han comenzado a contraatacar agresivamente a los Khazahs."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:33
translate es ev_blackDiamondFawhaOnReturn_d1725403:

    # FAWHA @ talk "Without Tarek holding everyone together, the usual in-fighting has returned."
    FAWHA @ talk "Sin Tarek manteniendo a todos unidos, las habituales peleas internas han vuelto."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:34
translate es ev_blackDiamondFawhaOnReturn_dc35f411:

    # FAWHA @ talk "More and more factions are choosing sides, and I don't think it will be long before things become all out war."
    FAWHA @ talk "Cada vez son más las facciones que eligen bando, y no creo que pase mucho tiempo antes de que las cosas se conviertan en una guerra total."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:35
translate es ev_blackDiamondFawhaOnReturn_228713d7:

    # MC "(Hmm, I should maybe keep one eye on this situation.)"
    MC "(Hmm, tal vez debería mantener un ojo abierto en esta situación)."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:36
translate es ev_blackDiamondFawhaOnReturn_a4cfcd1e:

    # MC @ talk "How are the Vulshan treating you without Tarek?"
    MC @ talk "¿Cómo te tratan los Vulshan sin Tarek?"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:37
translate es ev_blackDiamondFawhaOnReturn_d0a7eb58:

    # FAWHA @ smile "Better than ever actually."
    FAWHA @ smile "De hecho, mejor que nunca."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:38
translate es ev_blackDiamondFawhaOnReturn_4f5bf1f7:

    # FAWHA @ talk "Thanks to you and your friend, they've told us we are 'marked' girls."
    FAWHA @ talk "Gracias a ti y a tu amigo, nos han dicho que somos chicas 'marcadas'."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:39
translate es ev_blackDiamondFawhaOnReturn_68ba2e87:

    # FAWHA @ talk "We've been told to offer our services to you both for free."
    FAWHA @ talk "Nos han dicho que les ofrezcamos nuestros servicios gratis."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:40
translate es ev_blackDiamondFawhaOnReturn_729736f0:

    # MC @ smile "Really?"
    MC @ smile "¿De verdad?"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:41
translate es ev_blackDiamondFawhaOnReturn_ba19b5e9:

    # FAWHA @ talk "You have found a friend in the Vulshan, they also wanted me to let you know they have prepared a private room for you to stay in... Should you wish."
    FAWHA @ talk "Has encontrado un amigo en los Vulshan, también querían que te dijera que han preparado una habitación privada para que te quedes... Si lo deseas."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:42
translate es ev_blackDiamondFawhaOnReturn_c9cc4525:

    # MC "(A private room? This could prove useful if I ever need to stay low.)"
    MC "(¿Una habitación privada? Esto podría ser útil si alguna vez necesito mantener un perfil bajo)."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:43
translate es ev_blackDiamondFawhaOnReturn_93c20070:

    # MC "(But, do I really trust my safety in the hands of people like the Vulshan?)"
    MC "(Pero, ¿realmente confío mi seguridad en manos de gente como los Vulshan?)"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:48
translate es ev_blackDiamondFawhaOnReturn_bef2be97:

    # FAWHA @ talk "Things have been tense, but we're not at the point of all-out-war yet."
    FAWHA @ talk "Las cosas han estado tensas, pero aún no hemos llegado al punto de una guerra total."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:49
translate es ev_blackDiamondFawhaOnReturn_649b6b5d:

    # FAWHA @ talk "Before he left, Tarek summoned a meeting of the leading gangs and announced he would be leaving."
    FAWHA @ talk "Antes de irse, Tarek convocó una reunión de las principales bandas y anunció que se marchaba.."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:50
translate es ev_blackDiamondFawhaOnReturn_43b98ff8:

    # FAWHA @ talk "He outlined how the territory under him was to be managed or divided, leaving this place to the Vulshan."
    FAWHA @ talk "Señaló cómo debía gestionarse o dividirse el territorio bajo su mando, dejando este lugar a los Vulshan."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:51
translate es ev_blackDiamondFawhaOnReturn_2f08c5df:

    # FAWHA @ talk "It's the best outcome perhaps, but... The tension is still boiling beneath the surface, and I feel like it has only bought time before the inevitable."
    FAWHA @ talk "Quizá sea el mejor resultado, pero... La tensión sigue hirviendo bajo la superficie, y siento que solo ha ganado tiempo antes de lo inevitable."

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:53
translate es ev_blackDiamondFawhaOnReturn_297d3ff3:

    # FAWHA @ talk "I'll be around here for a while if you need anything, just ask."
    FAWHA @ talk "Estaré por aquí un tiempo si necesitas algo, solo tienes que pedirlo."

