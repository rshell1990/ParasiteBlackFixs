

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:6
translate es scr_event_Elena_morningAfterBook_8dbcb600:

    # "As my eyes peeled open, I found Elena sat legs crossed on the floor, tail swishing as she read some book."
    "Cuando abrí los ojos, encontré a Elena sentada con las piernas cruzadas en el suelo, agitando la cola mientras leía algún libro."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:7
translate es scr_event_Elena_morningAfterBook_ffbba8cf:

    # MC @ talk "...Hello there."
    MC @ talk "...Hola."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:13
translate es scr_event_Elena_morningAfterBook_b6b565ea:

    # ELENA @ talk "Hm? Oh! You're awake!"
    ELENA @ talk "¿Hm? ¡Oh! ¡Estás despierto!"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:14
translate es scr_event_Elena_morningAfterBook_42c92510:

    # ELENA @ talk "I hope I didn't wake you up."
    ELENA @ talk "Espero no haberte despertado."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:15
translate es scr_event_Elena_morningAfterBook_bcb13d87:

    # MC @ talk "No, it's fine."
    MC @ talk "No, está bien."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:16
translate es scr_event_Elena_morningAfterBook_26fc3f85:

    # MC @ talk "Enjoying the read?"
    MC @ talk "¿Disfrutando de la lectura?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:17
translate es scr_event_Elena_morningAfterBook_380fbcfe:

    # ELENA @ talk "Yes actually, it reminds me of what father used to read to me when I was little."
    ELENA @ talk "Sí, la verdad es que me recuerda a lo que me leía mi padre cuando era pequeña."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:18
translate es scr_event_Elena_morningAfterBook_4210173c:

    # MC @ talk "{i}Father?{/i}"
    MC @ talk "{i}¿Padre?{/i}"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:19
translate es scr_event_Elena_morningAfterBook_4f4138f7:

    # ELENA @ talk "I... Lord Vront insisted I call him father."
    ELENA @ talk "Yo... lord Vront insistió en que lo llamara padre."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:20
translate es scr_event_Elena_morningAfterBook_ea1dfdf1:

    # ELENA @ talk "He wanted me to know despite being adopted, he still saw me as one of his own flesh and blood."
    ELENA @ talk "Quería que supiera que, a pesar de ser adoptada, seguía viéndome como alguien de su propia sangre."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:21
translate es scr_event_Elena_morningAfterBook_5b247ea3:

    # MC @ talk "Really?"
    MC @ talk "¿De verdad?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:22
translate es scr_event_Elena_morningAfterBook_a204b682:

    # ELENA @ talk "Yes, he oversaw that I received an education alongside Grace and taught me everything he could."
    ELENA @ talk "Sí, se encargó de que recibiera una educación junto a Grace y me enseñó todo lo que pudo."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:23
translate es scr_event_Elena_morningAfterBook_4dacb865:

    # ELENA @ talk "How to cook, how to manage finances... How to fight."
    ELENA @ talk "Cómo cocinar, cómo manejar las finanzas... Cómo luchar."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:24
translate es scr_event_Elena_morningAfterBook_2d2d4576:

    # MC @ talk "He taught you to fight?"
    MC @ talk "¿Te enseñó a luchar?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:25
translate es scr_event_Elena_morningAfterBook_fa268b6f:

    # ELENA @ talk "Not him personally but, he paid for me to learn from private tutors."
    ELENA @ talk "No él personalmente, pero pagó para que yo aprendiera de profesores particulares."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:26
translate es scr_event_Elena_morningAfterBook_70deb4ed:

    # MC @ talk "Sounds like he really cared for you."
    MC @ talk "Parece que realmente se preocupaba por ti."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:27
translate es scr_event_Elena_morningAfterBook_02e153ae:

    # ELENA @ talk "I think so... But he rarely opened up, and there was always the burden of expectation that my role was to serve as protector and companion to Grace."
    ELENA @ talk "Creo que sí... Pero rara vez se sinceraba, y siempre existía la carga de la expectativa de que mi papel era el de protectora y compañera de Grace."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:28
translate es scr_event_Elena_morningAfterBook_305878ed:

    # MC @ talk "But what of what you wanted?"
    MC @ talk "¿Pero qué hay de lo que querías?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:29
translate es scr_event_Elena_morningAfterBook_14c94d73:

    # ELENA @ talk "I think my own dreams and desires were seen as the things of fancy."
    ELENA @ talk "Creo que mis propios sueños y deseos eran vistos como cosas de capricho."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:30
translate es scr_event_Elena_morningAfterBook_d6c02f1d:

    # ELENA @ talk "While I think he wished I was happy, my happiness was not a goal nor a concern of his."
    ELENA @ talk "Aunque creo que deseaba que yo fuera feliz, mi felicidad no era un objetivo ni una preocupación suya."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:31
translate es scr_event_Elena_morningAfterBook_2d3ecf87:

    # MC @ talk "That sounds like a complicated relationship."
    MC @ talk "Parece una relación complicada."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:32
translate es scr_event_Elena_morningAfterBook_5d6d80f1:

    # ELENA @ talk "It was..."
    ELENA @ talk "Lo era..."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:33
translate es scr_event_Elena_morningAfterBook_0d661ab0:

    # MC @ talk "And what of the now Lady Thornfall? How was things with her?"
    MC @ talk "¿Y qué hay de la señorita Thornfall? ¿Cómo iban las cosas con ella?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:34
translate es scr_event_Elena_morningAfterBook_29852055:

    # ELENA @ talk "I believe sisterly... To an extent."
    ELENA @ talk "Creo que fraternalmente... Hasta cierto punto."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:35
translate es scr_event_Elena_morningAfterBook_481f2687:

    # MC @ talk "{i}To an extent?{/i}"
    MC @ talk "{i}¿Hasta cierto punto?{/i}"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:36
translate es scr_event_Elena_morningAfterBook_a7c7e34f:

    # ELENA @ talk "I mean, she would constantly have me tag along with her."
    ELENA @ talk "Quiero decir, constantemente me hacía acompañarla."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:37
translate es scr_event_Elena_morningAfterBook_a9895b98:

    # ELENA @ talk "But somehow, she always seemed to find and encourage trouble."
    ELENA @ talk "Pero, de algún modo, siempre parecía encontrar y fomentar los problemas."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:38
translate es scr_event_Elena_morningAfterBook_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "¿Qué quieres decir?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:39
translate es scr_event_Elena_morningAfterBook_2190c424:

    # ELENA @ talk "I was always there to protect her and get her out of whatever mess she landed herself into."
    ELENA @ talk "Siempre estaba ahí para protegerla y sacarla de cualquier lío en el que se metiera."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:40
translate es scr_event_Elena_morningAfterBook_5eb1441e:

    # ELENA @ talk "But she would do... Strange things."
    ELENA @ talk "Pero ella haría... Cosas extrañas."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:41
translate es scr_event_Elena_morningAfterBook_0c073176:

    # ELENA @ talk "Flirt with bachelors and then make the men fight over her when really she had no interest in either."
    ELENA @ talk "Coquetear con solteros y luego hacer que los hombres se peleen por ella cuando en realidad no tenía interés en ninguno."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:42
translate es scr_event_Elena_morningAfterBook_c2ba5cdb:

    # ELENA @ talk "Lie all the time and expect me to take the blame for whatever petty crime she did."
    ELENA @ talk "Mentir todo el tiempo y esperar que yo cargue con la culpa de cualquier delito insignificante que haya cometido."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:43
translate es scr_event_Elena_morningAfterBook_c05ba311:

    # ELENA @ talk "And just generally seemed to enjoy causing chaos."
    ELENA @ talk "Y, en general, parecía disfrutar provocando el caos."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:44
translate es scr_event_Elena_morningAfterBook_36398f57:

    # MC @ talk "Sounds like a spoilt brat."
    MC @ talk "Parece una niña mimada."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:45
translate es scr_event_Elena_morningAfterBook_eced757e:

    # ELENA @ talk "She could be... But then when I needed her, she was there."
    ELENA @ talk "Podría ser... Pero cuando la necesitaba, ella estaba allí."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:46
translate es scr_event_Elena_morningAfterBook_c8e3f7c1:

    # ELENA @ talk "She was far more concerned than father with my actual happiness, and always wanted me to pursue whatever made me happy."
    ELENA @ talk "Se preocupaba mucho más que mi padre por mi felicidad, y siempre quiso que me dedicara a lo que me hiciera feliz."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:47
translate es scr_event_Elena_morningAfterBook_16e68e72:

    # MC @ talk "Hm, did the good parts to her outweigh the bad?"
    MC @ talk "Hm, ¿las partes buenas superaban a las malas?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:48
translate es scr_event_Elena_morningAfterBook_4bd076ae:

    # ELENA @ talk "I've been asking myself that question my whole life..."
    ELENA @ talk "Llevo haciéndome esa pregunta toda mi vida..."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:49
translate es scr_event_Elena_morningAfterBook_28bdcec6:

    # "Elena seemed to daze off for a moment before closing her book shut."
    "Elena pareció quedarse un instante dormida antes de cerrar el libro."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:50
translate es scr_event_Elena_morningAfterBook_924e3dc7:

    # ELENA @ talk "Anyway, If you want to stay in bed, don't let me stop you."
    ELENA @ talk "ADe todos modos, si quieres quedarte en la cama, no dejes que te lo impida."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:51
translate es scr_event_Elena_morningAfterBook_e54f69fe:

    # MC @ talk "{i}*Groans*{/i}"
    MC @ talk "{i}*Gruñidos*{/i}"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:52
translate es scr_event_Elena_morningAfterBook_96845d23:

    # MC @ talk "I'm up now, may as well see what's about."
    MC @ talk "Ya me he levantado, a ver qué pasa."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:58
translate es scr_event_Elena_morningAfterBook_e133a80b:

    # "As I rose from my feet and yawned, I quickly forgot I was still naked and Elena blushed as her wide eyes stared at the dangling appendage between my legs."
    "Al levantarme y bostezar, me olvidé rápidamente de que seguía desnudo y Elena se ruborizó al mirar con ojos muy abiertos el apéndice que colgaba entre mis piernas."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:59
translate es scr_event_Elena_morningAfterBook_1d98e220:

    # ELENA @ talk "Y-You're...!"
    ELENA @ talk "¡E-estás...!"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:60
translate es scr_event_Elena_morningAfterBook_bf1a78a6:

    # MC @ talk "Hm?"
    MC @ talk "¿Hm?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:61
translate es scr_event_Elena_morningAfterBook_8ff7de53:

    # MC @ surprised "Oh! Sorry, sometimes I forget."
    MC @ surprised "¡Oh! Lo siento, a veces me olvido."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:62
translate es scr_event_Elena_morningAfterBook_c2ea560f:

    # ELENA @ talk "Um, i-it's fine!"
    ELENA @ talk "Um, ¡no pasa nada!"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:63
translate es scr_event_Elena_morningAfterBook_2cc0db42:

    # "As Elena's cheeks burned red, I smirked remembering some words she previously teased me about."
    "Mientras las mejillas de Elena se ponían rojas, sonreí recordando algunas palabras con las que se había burlado de mí."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:64
translate es scr_event_Elena_morningAfterBook_ba738462:

    # MC @ talk "I thought you didn't care about how us humans dress ourselves?"
    MC @ talk "Creía que no te importaba cómo nos vestimos los humanos."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:65
translate es scr_event_Elena_morningAfterBook_2f981c88:

    # ELENA @ talk "Y-Yes, but your thing is... Um..."
    ELENA @ talk "S-aí, pero tu cosa es... Um..."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:66
translate es scr_event_Elena_morningAfterBook_031af7b3:

    # ELENA @ talk "{i}Distracting.{/i}"
    ELENA @ talk "{i}Distrayente.{/i}"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:72
translate es scr_event_Elena_morningAfterBook_66a163ff:

    # MC @ smile "Distracting huh?"
    MC @ smile "¿Distrayente, eh?"

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:75
translate es scr_event_Elena_morningAfterBook_1894910e:

    # "I reached down to grab some of my clothes, dressing myself as Elena turned to look away still red-faced, her eyes occasionally glancing over in my direction subtly."
    "Me incliné para coger algo de ropa y me vestí mientras Elena se daba la vuelta para mirar hacia otro lado, aún con la cara roja, y sus ojos me miraban sutilmente de vez en cuando."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:80
translate es scr_event_Elena_morningAfterBook_19615cbe:

    # MC @ talk "Alright, all done."
    MC @ talk "Muy bien, ya está."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:81
translate es scr_event_Elena_morningAfterBook_66749978:

    # MC @ talk "You can look now."
    MC @ talk "Ya puedes mirar."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:87
translate es scr_event_Elena_morningAfterBook_01ea2c31:

    # "Elena slowly turned her head to look towards me once again, still flustered by the experience."
    "Elena giró lentamente la cabeza para volver a mirarme, aún nerviosa por la experiencia."

# game/data/world_events/elena/elena_morning/scr_ElenaMorning.rpy:88
translate es scr_event_Elena_morningAfterBook_5230a294:

    # ELENA @ talk "C-Come on now, adventures await."
    ELENA @ talk "V-Vamos, nos esperan aventuras."

