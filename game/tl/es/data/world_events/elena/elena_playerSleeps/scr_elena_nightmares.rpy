

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:7
translate es event_Elena_nightmares_c8fa082c:

    # ELENA "...{i}No... No...!{/i}"
    ELENA "...{i}¡No... No...!{/i}"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:8
translate es event_Elena_nightmares_9b248385:

    # "During the dead of night, I awoke to sounds of whines and other strange sounds."
    "En plena noche, me desperté con sonidos de quejidos y otros sonidos extraños."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:9
translate es event_Elena_nightmares_576834c9:

    # "Looking up from my bed still half-asleep, I saw Elena, writhing around on the floor, feverish with a sweat."
    "Levantando la vista de mi cama aún medio dormido, vi a Elena, retorciéndose en el suelo, febril y sudorosa."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:14
translate es event_Elena_nightmares_25b88e12:

    # ELENA "Stop... Please my lord!"
    ELENA "Para... ¡Por favor, mi señor!"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:15
translate es event_Elena_nightmares_c3ae80f2:

    # "Elena dripped with sweat, her sleeptalk giving the unmistakable impression of some horrible nightmare plaguing her this evening."
    "Elena chorreaba sudor, su somnolencia daba la inequívoca impresión de que alguna horrible pesadilla la atormentaba este anochecer."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:16
translate es event_Elena_nightmares_fab8cade:

    # MC @ talk "Elena! Wake up!"
    MC @ talk "¡Elena! ¡Despierta!"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:17
translate es event_Elena_nightmares_1159c1f1:

    # "I reached down and lightly shook Elena."
    "Me agaché y sacudí ligeramente a Elena."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:18
translate es event_Elena_nightmares_940877ae:

    # ELENA "No! Not again! Please!"
    ELENA "¡No! ¡Otra vez no! ¡Por favor!"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:19
translate es event_Elena_nightmares_25f13b42:

    # ELENA "I'll be good!"
    ELENA "¡Me portaré bien!"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:20
translate es event_Elena_nightmares_a1215f79:

    # MC @ talk "Elena!"
    MC @ talk "¡Elena!"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:21
translate es event_Elena_nightmares_a9178f70:

    # "Elena's eyes began to half open as she looked dazed and confused at me."
    "Los ojos de Elena empezaron a entreabrirse mientras me miraba aturdida y confusa."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:26
translate es event_Elena_nightmares_b6d61644:

    # ELENA @ shock "H-Huh?"
    ELENA @ shock "¿E-eh?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:27
translate es event_Elena_nightmares_95337e49:

    # ELENA @ sad "Where am I?"
    ELENA @ sad "¿Dónde estoy?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:28
translate es event_Elena_nightmares_5aa60ad9:

    # MC @ sad "It's alright Elena... You were having a nightmare."
    MC @ sad "Está bien Elena... Tuviste una pesadilla."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:29
translate es event_Elena_nightmares_70bf9362:

    # MC @ talk "You're safe now."
    MC @ talk "Ahora estás a salvo."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:30
translate es event_Elena_nightmares_3ff63ec7:

    # ELENA @ shock "I..."
    ELENA @ shock "Yo..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:31
translate es event_Elena_nightmares_b67df899:

    # ELENA @ sad "I'm sorry for waking you."
    ELENA @ sad "Siento haberte despertado."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:32
translate es event_Elena_nightmares_b226d146:

    # MC @ talk "What was your nightmare about?"
    MC @ talk "¿De qué iba tu pesadilla?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:33
translate es event_Elena_nightmares_d5a6231d:

    # ELENA @ sad "It... It was nothing."
    ELENA @ sad "No... No fue nada."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:34
translate es event_Elena_nightmares_9d46b364:

    # MC @ talk "You were pleading with Lord Vront not to do something."
    MC @ talk "Le suplicabas al lord Vront que no hiciera algo."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:35
translate es event_Elena_nightmares_a45689b3:

    # "Elena's eyes widened."
    "Los ojos de Elena se abrieron de par en par."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:36
translate es event_Elena_nightmares_7f61c46d:

    # ELENA @ shock "You heard that?"
    ELENA @ shock "¿Escuchaste eso?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:37
translate es event_Elena_nightmares_16f5c04e:

    # ELENA @ cry "You weren't supposed to hear that!"
    ELENA @ cry "¡Se suponía que no debías oír eso!"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:38
translate es event_Elena_nightmares_58db6ac2:

    # MC @ sad "Elena... What happened?"
    MC @ sad "Elena... ¿Qué pasó?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:39
translate es event_Elena_nightmares_a23fd01e:

    # MC @ talk "Did Vront do something to you?"
    MC @ talk "¿Vront te hizo algo?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:40
translate es event_Elena_nightmares_3dd7af0a:

    # ELENA @ sad "...Only when I misbehaved."
    ELENA @ sad "...Solo cuando me portaba mal."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:41
translate es event_Elena_nightmares_fece7692:

    # MC @ talk "Elena, what did he do?"
    MC @ talk "Elena, ¿qué hizo?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:42
translate es event_Elena_nightmares_4c67c501:

    # ELENA @ sad "He didn't hurt me... He knew he didn't need to."
    ELENA @ sad "No me hizo daño... Sabía que no era necesario."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:43
translate es event_Elena_nightmares_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "¿A qué te refieres?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:44
translate es event_Elena_nightmares_219a7915:

    # ELENA @ sad "When I misbehaved too much, he would have the staff take me down to the old Thornfall mines."
    ELENA @ sad "Cuando me portaba demasiado mal, hacía que el personal me llevara a las antiguas minas de Thornfall."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:45
translate es event_Elena_nightmares_ad25dd50:

    # ELENA @ sad "He would have me put into a steel cage and lowered into the mines, long abandoned by this point but..."
    ELENA @ sad "Me haría meter en una jaula de acero y me bajaría a las minas, abandonadas desde hace tiempo, pero..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:46
translate es event_Elena_nightmares_a3d31628:

    # ELENA @ sad "{i}Things... Moved down there.{/i}"
    ELENA @ sad "{i}Cosas... se movian ahí abajo.{/i}"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:47
translate es event_Elena_nightmares_7950d08f:

    # ELENA @ cry "I would spend the whole night in terror, frozen."
    ELENA @ cry "Pasaría toda la noche aterrorizada, congelada."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:48
translate es event_Elena_nightmares_eb32411e:

    # ELENA @ cry "When I told I saw {i}things{/i} down there, horrible things..."
    ELENA @ cry "Cuando dije que vi {i}cosas{/i} allí abajo, cosas horribles..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:49
translate es event_Elena_nightmares_c2ced3cf:

    # ELENA @ sad "He always warned me one day, if I kept misbehaving, he would send me down there {i}without{/i} the cage."
    ELENA @ sad "Siempre me advertía que un día, si seguía portándome mal, me mandaría allí abajo {i}sin{/i} la jaula."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:52
translate es event_Elena_nightmares_86c99dd5:

    # ELENA @ sad "Maybe..."
    ELENA @ sad "Tal vez..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:53
translate es event_Elena_nightmares_e7853050:

    # ELENA @ cry "But he was still the closest thing I had to a father."
    ELENA @ cry "Pero seguía siendo lo más parecido a un padre que tenía."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:54
translate es event_Elena_nightmares_39d76480:

    # ELENA @ sad "So, what is to be done?"
    ELENA @ sad "Entonces, ¿qué hay que hacer?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:56
translate es event_Elena_nightmares_84b440c8:

    # ELENA @ sad "Maybe... But I think in some dark, twisted way."
    ELENA @ sad "Tal vez... Pero creo que de alguna manera oscura y retorcida."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:57
translate es event_Elena_nightmares_8aba1e91:

    # ELENA @ sad "He {i}wanted{/i} me to misbehave."
    ELENA @ sad "Él {i}quería{/i} que me portara mal."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:58
translate es event_Elena_nightmares_a84141f4:

    # MC @ talk "Why do you say that?"
    MC @ talk "¿Por qué dices eso?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:59
translate es event_Elena_nightmares_b908d857:

    # ELENA @ sad "I don't know... I think beneath the veneer of his wealth and his kindness and all of him..."
    ELENA @ sad "No lo sé... Creo que bajo la fachada de su riqueza y su bondad y todo él..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:60
translate es event_Elena_nightmares_1760313a:

    # ELENA @ shock "Something dark lurked."
    ELENA @ shock "Algo oscuro acechaba."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:61
translate es event_Elena_nightmares_14f9b5ea:

    # ELENA @ sad "And only sometimes, I was unfortunate enough to catch a glimpse of it."
    ELENA @ sad "Y solo a veces, tuve la mala suerte de vislumbrarlo."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:63
translate es event_Elena_nightmares_0aae521e:

    # MC @ sad "Elena, if he did that to you, why are you determined to find the Lady Grace?"
    MC @ sad "Elena, si él te hizo eso, ¿por qué estás decidida a encontrar a lady Grace?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:64
translate es event_Elena_nightmares_657099bb:

    # MC @ talk "It's sounds more like they used you, that they abused you than anything else..."
    MC @ talk "Parece más que te usaron, que abusaron de ti que otra cosa..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:65
translate es event_Elena_nightmares_f28a909b:

    # ELENA @ sad "Maybe so..."
    ELENA @ sad "Puede que sí..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:66
translate es event_Elena_nightmares_c9329dcf:

    # ELENA @ sad "But they are the only family I've ever known."
    ELENA @ sad "Pero son la única familia que he conocido."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:67
translate es event_Elena_nightmares_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:68
translate es event_Elena_nightmares_2396cfa8:

    # MC @ sad "...Elena... How often do you have nightmares about the mines?"
    MC @ sad "...Elena... ¿Con qué frecuencia tienes pesadillas sobre las minas?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:69
translate es event_Elena_nightmares_73e8d429:

    # "Elena looked away to avoid the question, before, she gulped and turned to look me in the eyes, changing the subject quickly."
    "Elena apartó la mirada para evitar la pregunta, antes, tragó saliva y se volvió para mirarme a los ojos, cambiando rápidamente de tema."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:70
translate es event_Elena_nightmares_32c1494d:

    # ELENA @ sad "...Can I stay in the bed with you tonight?"
    ELENA @ sad "...¿Puedo quedarme en la cama contigo esta noche?"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:71
translate es event_Elena_nightmares_4e2078b1:

    # MC @ talk "Yes, if that's what you wish."
    MC @ talk "Sí, si eso es lo que quieres."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:72
translate es event_Elena_nightmares_91b2fd52:

    # ELENA @ sad "Thank you."
    ELENA @ sad "Gracias."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:73
translate es event_Elena_nightmares_4ce1bdf7:

    # ELENA @ sad "The nightmares will pass... {i}They always pass.{/i}"
    ELENA @ sad "Las pesadillas pasarán... {i}Siempre pasan.{/i}"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:74
translate es event_Elena_nightmares_f8dfe42c:

    # MC @ sad "...{i}Elena.{/i}"
    MC @ sad "...{i}Elena.{/i}"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:75
translate es event_Elena_nightmares_e22dd8f7:

    # ELENA @ sad "Just hold me while I sleep..."
    ELENA @ sad "Solo abrázame mientras duermo..."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:76
translate es event_Elena_nightmares_40cfa765:

    # "Elena climbed up onto the bed, resting her warm body against mine as I tenderly brushed against her fur."
    "Elena se subió a la cama, apoyando su cálido cuerpo contra el mío mientras yo rozaba tiernamente su pelaje."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:79
translate es event_Elena_nightmares_9acbdc33:

    # ELENA @ sad "{i}One day...{/i}"
    ELENA @ sad "{i}Un día...{/i}"

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:80
translate es event_Elena_nightmares_b64131e2:

    # "She murmured."
    "Ella murmuró."

# game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:81
translate es event_Elena_nightmares_c55a9f2e:

    # ELENA @ cry "{i}I think the nightmares will be gone for good.{/i}"
    ELENA @ cry "{i}Creo que las pesadillas se irán para siempre.{/i}"

translate es strings:

    # game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:50
    old "He sounds like a monster!"
    new "¡Parece un monstruo!"

    # game/data/world_events/elena/elena_playerSleeps/scr_elena_nightmares.rpy:50
    old "He was just trying to toughen you up, I doubt he would have let anything happen to you."
    new "Solo intentaba endurecerte, dudo que hubiera dejado que te pasara nada."

