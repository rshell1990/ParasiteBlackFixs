translate es ev_first_impreg_44ebc6d0:

    # MC "(My child... Will it have the same affliction as I do?)"
    MC "(Mi hijo... ¿Tendrá la misma aflicción que yo?)"

# game/data/world_events/first_impreg/first_impreg.rpy:19
translate es ev_first_impreg_3be7ae15:

    # MC "(Will it have it's own {i}dark passenger?{/i})"
    MC "(¿Tendrá su propio {i}pasajero oscuro?{/i})"

# game/data/world_events/first_impreg/first_impreg.rpy:20
translate es ev_first_impreg_55c22c73:

    # BLACK "{i}(No).{/i}"
    BLACK "{i}(No).{/i}"

# game/data/world_events/first_impreg/first_impreg.rpy:21
translate es ev_first_impreg_9f83c5b8:

    # BLACK "{i}(Our sired seed will have enhanced strength, speed, and other enhanced traits due to the genetic mutations).{/i}"
    BLACK "{i}(Nuestra descendencia tendrá mayor fuerza, velocidad y otros rasgos mejorados debido a las mutaciones genética).{/i}"

# game/data/world_events/first_impreg/first_impreg.rpy:22
translate es ev_first_impreg_20057462:

    # BLACK "{i}(But they will not be parasites).{/i}"
    BLACK "{i}(Pero no serán parásitos).{/i}"

# game/data/world_events/first_impreg/first_impreg.rpy:23
translate es ev_first_impreg_e80b32bf:

    # MC "(I don't understand, why not?)"
    MC "(No lo entiendo, ¿por qué no?)"

# game/data/world_events/first_impreg/first_impreg.rpy:24
translate es ev_first_impreg_57fb72bd:

    # BLACK "{i}(The genetic change is too drastic, trying to convert a species into one of us without any prior genetic code mutation can result in massive organ failure).{/i}"
    BLACK "{i}(El cambio genético es demasiado drástico, intentar convertir una especie en uno de nosotros sin una mutación previa del código genético puede provocar un fallo orgánico masivo).{/i}"

# game/data/world_events/first_impreg/first_impreg.rpy:25
translate es ev_first_impreg_102544c9:

    # BLACK "{i}(Therefore, our species prefers to breed during the first wave, then, the sired offspring will be mated with to produce Parasites).{/i}"
    BLACK "{i}(Por lo tanto, nuestra especie prefiere reproducirse durante la primera oleada, entonces, la descendencia engendrada se apareará para producir parásitos).{/i}"

# game/data/world_events/first_impreg/first_impreg.rpy:26
translate es ev_first_impreg_0b35c596:

    # BLACK "{i}(It is far safer to produce our kind with the sired offsprings genetic code as a foundation).{/i}"
    BLACK "{i}(Es mucho más seguro producir nuestra especie con el código genético de los descendientes como base).{/i}"

# game/data/world_events/first_impreg/first_impreg.rpy:27
translate es ev_first_impreg_ed861807:

    # MC "(So... They will be okay?)"
    MC "(Entonces... ¿Estarán bien?)"

# game/data/world_events/first_impreg/first_impreg.rpy:28
translate es ev_first_impreg_fb23857a:

    # BLACK "{i}(Yes){/i}"
    BLACK "{i}(Sí){/i}"

# game/data/world_events/first_impreg/first_impreg.rpy:29
translate es ev_first_impreg_fb2ccbba:

    # BLACK "{i}(Our species are designed to breed, I expect you will be driven to sire more young){/i}."
    BLACK "{i}(Nuestras especies están diseñadas para reproducirse, espero que te sientas impulsado a engendrar más){/i}."

# game/data/world_events/first_impreg/first_impreg.rpy:30
translate es ev_first_impreg_fefa14c9:

    # MC "(I'm not so sure about that, but... At least I know the children won't be cursed as I am.)"
    MC "(No estoy tan seguro de eso, pero... Al menos sé que los niños no estarán malditos como yo)."

# game/data/world_events/first_impreg/first_impreg.rpy:31
translate es ev_first_impreg_b13e11c4:

    # BLACK "{i}(Curses... Blessings... These concepts hold little meaning to me, we are as our nature intended, nothing more).{/i}"
    BLACK "{i}(Maldiciones... Bendiciones... Estos conceptos tienen poco significado para mí, somos como nuestra naturaleza lo quiso, nada más).{/i}"

# game/data/world_events/first_impreg/first_impreg.rpy:32
translate es ev_first_impreg_9e741bff:

    # MC "(Yeah... I thought you might say something like that.)"
    MC "(Sí... Pensé que dirías algo así)."

