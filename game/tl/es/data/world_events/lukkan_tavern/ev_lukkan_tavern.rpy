

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:25
translate es ev_lukkan_tavern_talk_d33c877c:

    # LUKKAN @ talk "Oh no... Not when I'm off work kid."
    LUKKAN @ talk "Oh no... No cuando estoy fuera del trabajo chico."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:26
translate es ev_lukkan_tavern_talk_aaecfe7c:

    # LUKKAN @ talk "Leave me to drink in peace, would you?"
    LUKKAN @ talk "Déjame beber en paz, ¿quieres?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:32
translate es ev_lukkan_tavern_bye_d1d7e9f8:

    # "Lukkan turned away and continued to sip at his drink ignoring me."
    "Lukkan se dio la vuelta y siguió dando sorbos a su bebida ignorándome."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:37
translate es ev_lukkan_tavern_talk_2_601ac674:

    # LUKKAN @ talk "Well I don't care to answer it."
    LUKKAN @ talk "Bueno, no me importa contestar."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:38
translate es ev_lukkan_tavern_talk_2_8ef6a3d8:

    # LUKKAN @ talk "Harrass me in work all you like, not during my downtime."
    LUKKAN @ talk "Hostigarme en el trabajo todo lo que quieras, no durante mi tiempo libre."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:41
translate es ev_lukkan_tavern_talk_2_0dcda6d1:

    # LUKKAN @ talk "Finally."
    LUKKAN @ talk "Por fin."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:46
translate es ev_lukkan_tavern_talk_2_82872103:

    # LUKKAN @ talk "Urghh... Fine."
    LUKKAN @ talk "Urghh... Está bien."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:47
translate es ev_lukkan_tavern_talk_2_8ff38180:

    # LUKKAN @ talk "What do you want?"
    LUKKAN @ talk "¿Qué quieres?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:50
translate es ev_lukkan_tavern_talk_2_menu_c1c93262:

    # LUKKAN @ talk "...Who, {i}me?{/i}"
    LUKKAN @ talk "...¿Quién, {i}yo?{/i}"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:51
translate es ev_lukkan_tavern_talk_2_menu_2041d5ec:

    # LUKKAN @ talk "I signed up when I was just a lad, barely fifteen."
    LUKKAN @ talk "Me alisté cuando era un chaval, apenas tenía quince años."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:52
translate es ev_lukkan_tavern_talk_2_menu_f047a6f1:

    # LUKKAN @ talk "Must have been... At least thirty years ago?"
    LUKKAN @ talk "Debe haber sido... ¿Hace al menos treinta años?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:53
translate es ev_lukkan_tavern_talk_2_menu_d0d4ea41:

    # LUKKAN @ talk "Things were different back then... {i}Better.{/i}"
    LUKKAN @ talk "Las cosas eran diferentes entonces... {i}Mejor.{/i}"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:54
translate es ev_lukkan_tavern_talk_2_menu_43e9ad4e:

    # LUKKAN @ talk "I mean you still have the usual shite to deal with, always some cunt knocking about somewhere causing trouble."
    LUKKAN @ talk "Quiero decir que sigues teniendo que lidiar con la mierda de siempre, siempre hay algún gilipollas por ahí causando problemas."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:55
translate es ev_lukkan_tavern_talk_2_menu_694204d0:

    # LUKKAN @ talk "But even the bad days never came close to this."
    LUKKAN @ talk "Pero ni siquiera los días malos se acercaban a esto."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:56
translate es ev_lukkan_tavern_talk_2_menu_075d0251:

    # MC @ talk "If you served that long, did you ever meet Newheart?"
    MC @ talk "Si serviste tanto tiempo, ¿alguna vez conociste a Newheart?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:57
translate es ev_lukkan_tavern_talk_2_menu_95b660d8:

    # LUKKAN @ talk "I saw him a few times in passing, even followed under his command briefly."
    LUKKAN @ talk "Lo vi algunas veces de pasada, incluso estuve bajo su mando brevemente.."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:58
translate es ev_lukkan_tavern_talk_2_menu_a73c4b88:

    # LUKKAN @ talk "But I never knew him as a man."
    LUKKAN @ talk "Pero nunca lo conocí como un hombre."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:59
translate es ev_lukkan_tavern_talk_2_menu_9807b8f5:

    # LUKKAN @ talk "Only a living legend... Gods, how his armour glimmered in the light."
    LUKKAN @ talk "Solo una leyenda viviente... Dioses, cómo brillaba su armadura en la luz."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:60
translate es ev_lukkan_tavern_talk_2_menu_f6f84d27:

    # MC @ talk "Were you there at Meadow Plains when he fell?"
    MC @ talk "¿Estabas allí en Meadow Plains cuando cayó?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:61
translate es ev_lukkan_tavern_talk_2_menu_62a0cb10:

    # LUKKAN @ talk "Nah, I was pulled away to fight in the Eastern Front while all that was going down, chasing off some straggler forces that were looping around Hamun trying to wreak havoc behind our lines."
    LUKKAN @ talk "No, me retiraron para luchar en el frente oriental mientras todo eso ocurría, persiguiendo a algunas fuerzas rezagadas que daban vueltas alrededor de Hamun intentando causar estragos tras nuestras líneas."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:62
translate es ev_lukkan_tavern_talk_2_menu_7708ff43:

    # LUKKAN @ talk "Heard about the shitshow that went down though and read the battle reports after... Wasn't pretty."
    LUKKAN @ talk "Pero me enteré de la mierda que pasó y leí los informes de batalla... No fue bonito.."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:63
translate es ev_lukkan_tavern_talk_2_menu_ca4c8415:

    # "Lukkan took another sip of Ale from his mug."
    "Lukkan bebió otro sorbo de cerveza de su jarra."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:64
translate es ev_lukkan_tavern_talk_2_menu_d4c6a22d:

    # LUKKAN @ talk "But I can't say I'm surprised, the leadership back then had no real fucking common sense."
    LUKKAN @ talk "Pero no puedo decir que me sorprenda, los líderes de entonces no tenían ningún puto sentido común."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:65
translate es ev_lukkan_tavern_talk_2_menu_0a84b181:

    # LUKKAN @ talk "I mean, really? What the fuck kind of plan was that?"
    LUKKAN @ talk "¿En serio? ¿Qué mierda de plan era ese?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:66
translate es ev_lukkan_tavern_talk_2_menu_0fdb7a58:

    # LUKKAN @ talk "{i}Trying to seige the largest fort we ever built while Newheart and a couple men tried some merry-band-of-heroes bullshit sneaking through a secret passage inside the fort to force down the drawbridge?{/i}"
    LUKKAN @ talk "{i}¿Intentar asediar el fuerte más grande que jamás hayamos construido mientras Newheart y un par de hombres intentaban alguna gilipollez de banda de héroes colándose por un pasadizo secreto dentro del fuerte para bajar a la fuerza el puente levadizo?{/i}"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:67
translate es ev_lukkan_tavern_talk_2_menu_f9c07b15:

    # LUKKAN @ talk "No one had been down in those shafts in years, they had no idea whether the passageway was still even accessible but off they went anyway."
    LUKKAN @ talk "Nadie había bajado a esos pozos en años, no tenían ni idea de si el pasadizo seguía siendo accesible, pero salieron de todos modos."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:68
translate es ev_lukkan_tavern_talk_2_menu_5c9899b8:

    # LUKKAN @ talk "Not to mention the sheer volume of Demorai inside the fort and the fortifications they had been building up around it."
    LUKKAN @ talk "Por no hablar del enorme volumen de Demorai que había en el interior del fuerte y de las fortificaciones que habían ido construyendo a su alrededor."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:69
translate es ev_lukkan_tavern_talk_2_menu_eb24454b:

    # LUKKAN @ talk "Granted the fort had been damaged a little when the Demorai first took it, but still!"
    LUKKAN @ talk "Es cierto que el fuerte había sufrido algunos daños cuando los Demorai lo tomaron por primera vez, ¡pero aun así!"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:70
translate es ev_lukkan_tavern_talk_2_menu_0be8cc89:

    # LUKKAN @ talk "It was a damn meat-grinder for those charging in!"
    LUKKAN @ talk "¡Era una trituradora de carne para los que entraban!"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:71
translate es ev_lukkan_tavern_talk_2_menu_a7fcd7ba:

    # MC @ talk "Sounds like you blame Newheart."
    MC @ talk "Parece que culpas a Newheart."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:72
translate es ev_lukkan_tavern_talk_2_menu_9019604b:

    # LUKKAN @ talk "Well... I do blame him a little, sacrilege though it may be seen."
    LUKKAN @ talk "Bueno... Lo culpo un poco, aunque sea un sacrilegio."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:73
translate es ev_lukkan_tavern_talk_2_menu_de542c95:

    # LUKKAN @ talk "Adventurers are cocky glory-hound bastards all of them, and even Newheart still couldn't shake that 'Adventurer' mindset fully I think."
    LUKKAN @ talk "Los aventureros son unos bastardos engreídos y buscadores de gloria, y creo que ni siquiera Newheart ha podido deshacerse por completo de esa mentalidad de 'aventurero'."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:74
translate es ev_lukkan_tavern_talk_2_menu_ac6a7933:

    # LUKKAN @ talk "Why did he {i}personally{/i} have to lead the men down there?"
    LUKKAN @ talk "¿Por qué tuvo que guiar {i}personalmente{/i} a los hombres allí abajo?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:75
translate es ev_lukkan_tavern_talk_2_menu_7fc24c42:

    # LUKKAN @ talk "He could never sit back and just be a fucking {i}general,{/i} he had to always plant himself in the thick of battle somewhere."
    LUKKAN @ talk "No podía quedarse sentado y ser un maldito {i}general,{/i} tenía que plantarse siempre en el fragor de la batalla en algún lugar."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:76
translate es ev_lukkan_tavern_talk_2_menu_79930734:

    # LUKKAN @ talk "And sure, he was a damn demon on the battlefield, and it usually inspired the men like nothing else!"
    LUKKAN @ talk "Y claro, era un maldito demonio en el campo de batalla, ¡y normalmente inspiraba a los hombres como ninguna otra cosa!"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:77
translate es ev_lukkan_tavern_talk_2_menu_47890319:

    # LUKKAN @ talk "But that's the catch isn't it? Because when he was then slain right there fucking in front of everyone, that morale boost he always gave came right back around and nearly finished us there and then."
    LUKKAN @ talk "Pero ahí está el truco, ¿no? Porque cuando lo mataron allí mismo, delante de todos, esa inyección de moral que siempre nos daba terminó y casi acaba con nosotros allí mismo."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:78
translate es ev_lukkan_tavern_talk_2_menu_cbe580ab:

    # LUKKAN @ talk "Morale plummeted into total despair, the line fell apart because men started fleeing for their lives because of course they did? The 'great hero' just got butchered in front of them, what chance did they have?"
    LUKKAN @ talk "La moral cayó en picado hasta la desesperación total, la línea se desmoronó porque los hombres empezaron a huir para salvar sus vidas porque, claro, ¿lo hicieron? El 'gran héroe' acaba de ser masacrado delante de ellos, ¿qué posibilidades tenían?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:79
translate es ev_lukkan_tavern_talk_2_menu_bc406b3a:

    # LUKKAN @ talk "But... It wasn't all on him, his orders came down to take the Fort before the Demorai reinforcements arrived from the South and hold the line there."
    LUKKAN @ talk "Pero... No era todo sobre él, sus órdenes eran tomar el fuerte antes de que los refuerzos Demorai llegaran desde el sur y mantener la línea allí."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:80
translate es ev_lukkan_tavern_talk_2_menu_65ea403e:

    # LUKKAN @ talk "He pleaded with them to dig in for a long war, to forget about Fort Rook for now and to lift the sieges at Gerano and Inma first to free up the trapped forces."
    LUKKAN @ talk "Les suplicó que se prepararan para una guerra larga, que se olvidaran de fuerte Rook por ahora y que levantaran primero los asedios de Gerano e Inma para liberar a las fuerzas atrapadas."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:81
translate es ev_lukkan_tavern_talk_2_menu_fec0b494:

    # LUKKAN @ talk "But Mesamor and the high lords had their way and constantly meddled in military matters they had no business dealing with."
    LUKKAN @ talk "Pero Mesamor y los grandes señores se salían con la suya y se inmiscuían constantemente en asuntos militares que no les correspondían"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:82
translate es ev_lukkan_tavern_talk_2_menu_c1262440:

    # LUKKAN @ talk "Well, the rest is history."
    LUKKAN @ talk "Bueno, el resto es historia."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:83
translate es ev_lukkan_tavern_talk_2_menu_eb459e92:

    # "Lukkan bitterly sipped at his drink."
    "Lukkan dio un sorbo amargo a su bebida."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:86
translate es ev_lukkan_tavern_talk_2_menu_b111f700:

    # LUKKAN @ talk "...What's it to you, kid?"
    LUKKAN @ talk "...¿Qué te importa, chaval?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:87
translate es ev_lukkan_tavern_talk_2_menu_f57a8267:

    # MC @ talk "I guess I just want to know more about it."
    MC @ talk "Supongo que solo quiero saber más al respecto."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:88
translate es ev_lukkan_tavern_talk_2_menu_79750a5b:

    # MC @ talk "I hear a couple royalists grumble about Alcott's {i}'crimes'{/i} and I guess I wanted to hear the other side."
    MC @ talk "He oído a un par de monárquicos refunfuñar sobre los {i}'crímenes'{/i} de Alcott y supongo que quería oír el otro lado."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:89
translate es ev_lukkan_tavern_talk_2_menu_3a3a2118:

    # LUKKAN @ talk "Fuck the Royalists, we'd all be worm food by now if we were still listening to them."
    LUKKAN @ talk "Que se jodan los monárquicos, ya seríamos todos comida para gusanos si siguiéramos haciéndoles caso."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:90
translate es ev_lukkan_tavern_talk_2_menu_e10908ed:

    # MC @ talk "So you did side with Alcott?"
    MC @ talk "¿Así que te pusiste del lado de Alcott?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:91
translate es ev_lukkan_tavern_talk_2_menu_77eda8c8:

    # LUKKAN @ talk "...I did... Hardest decision I ever made."
    LUKKAN @ talk "...lo hice... La decisión más difícil que he tomado."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:92
translate es ev_lukkan_tavern_talk_2_menu_65a07d48:

    # LUKKAN @ talk "Had to be done though."
    LUKKAN @ talk "Pero había que hacerlo."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:93
translate es ev_lukkan_tavern_talk_2_menu_ff2493dc:

    # LUKKAN @ talk "I was appointed one of Alcott's personal guards and followed him wherever he went."
    LUKKAN @ talk "Fui nombrado uno de los guardias personales de Alcott y le seguía a todas partes."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:94
translate es ev_lukkan_tavern_talk_2_menu_d2483d79:

    # LUKKAN @ talk "I became privy as a silent observer to some of the madness in Mesamor's court."
    LUKKAN @ talk "Me convertí en observador silencioso de algunas de las locuras de la corte de Mesamor."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:95
translate es ev_lukkan_tavern_talk_2_menu_04594668:

    # MC @ talk "What {i}really{/i} happened?"
    MC @ talk "¿Qué pasó {i}realmente{/i}?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:96
translate es ev_lukkan_tavern_talk_2_menu_1f230a8f:

    # LUKKAN @ talk "It's hard to explain truthfully, it wasn't just one thing but something built up over time."
    LUKKAN @ talk "Es difícil de explicar la verdad, no fue una sola cosa sino algo que se fue acumulando con el tiempo."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:97
translate es ev_lukkan_tavern_talk_2_menu_febbcc48:

    # LUKKAN @ talk "After Alcott rose up and managed to repel the Demorai during the Great Seige, he was appointed head of the War council and supreme commander of all forces."
    LUKKAN @ talk "Después de que Alcott se sublevara y lograra rechazar a los Demorai durante el Gran Asedio, fue nombrado jefe del consejo de guerra y comandante supremo de todas las fuerzas."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:98
translate es ev_lukkan_tavern_talk_2_menu_8a26670d:

    # LUKKAN @ talk "Only Mesamor himself had any authority higher than him, and very quickly the relationship between them fell apart."
    LUKKAN @ talk "Solo el propio Mesamor tenía alguna autoridad superior a él, y muy pronto la relación entre ellos se vino abajo."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:99
translate es ev_lukkan_tavern_talk_2_menu_9abd2c86:

    # MC @ talk "How so?"
    MC @ talk "¿Cómo?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:100
translate es ev_lukkan_tavern_talk_2_menu_f278db0b:

    # LUKKAN @ talk "When we managed to catch a second wind after repelling the Demorai, Mesamor took it as a sign we now had the enemy on the backfoot, and we needed to press the advance immediately."
    LUKKAN @ talk "Cuando logramos recuperar el aliento tras repeler a los Demorai, Mesamor lo interpretó como una señal de que ahora teníamos al enemigo a contrapié y debíamos presionar el avance de inmediato."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:101
translate es ev_lukkan_tavern_talk_2_menu_b9bc826d:

    # LUKKAN @ talk "Alcott's position was always that Newheart's initial assessment was correct, we needed time and to make drastic changes to our forces before any kind of real counter offensive would pay off."
    LUKKAN @ talk "La posición de Alcott siempre fue que la evaluación inicial de Newheart era correcta, necesitábamos tiempo y hacer cambios drásticos en nuestras fuerzas antes de que cualquier tipo de contraofensiva real diera sus frutos."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:102
translate es ev_lukkan_tavern_talk_2_menu_650c5975:

    # LUKKAN @ talk "And every single time, Mesamor was reluctant to embrace any kind of practical change."
    LUKKAN @ talk "Y en todas las ocasiones, Mesamor se mostró reacio a aceptar cualquier tipo de cambio práctico."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:105
translate es ev_lukkan_tavern_talk_2_menu2_327daf84:

    # LUKKAN @ talk "Tell me, did you ever see the {i}old{/i} Alderian armour?"
    LUKKAN @ talk "Dime, ¿alguna vez viste la {i}antigua{/i} armadura Alderiana?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:106
translate es ev_lukkan_tavern_talk_2_menu2_c5ffce20:

    # LUKKAN @ talk "Beautiful stuff, purple and black cloaked, made by Syaxian ore."
    LUKKAN @ talk "Hermoso material, con capa púrpura y negra, fabricado con mineral syaxiano."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:107
translate es ev_lukkan_tavern_talk_2_menu2_e85184cf:

    # LUKKAN @ talk "It was some of the most durable and flexible armour around, light as a bloody feather too."
    LUKKAN @ talk "Era una de las armaduras más duraderas y flexibles que existían, además de ligera como una maldita pluma."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:108
translate es ev_lukkan_tavern_talk_2_menu2_3f8031db:

    # LUKKAN @ talk "...And it was fucking useless."
    LUKKAN @ talk "...Y era jodidamente inútil."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:109
translate es ev_lukkan_tavern_talk_2_menu2_023cc10d:

    # MC @ talk "Huh? How come?"
    MC @ talk "¿Huh? ¿Por qué razón?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:110
translate es ev_lukkan_tavern_talk_2_menu2_c236f049:

    # LUKKAN @ talk "Because the ore was {i}always{/i} in short supply, limited to many of the mines found in the south which we were no longer in control of."
    LUKKAN @ talk "Porque el mineral {i}siempre{/i} escaseaba, limitado a muchas de las minas del sur que ya no controlábamos."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:111
translate es ev_lukkan_tavern_talk_2_menu2_4d42870d:

    # LUKKAN @ talk "And frankly, the armour took {i}far{/i} too long to produce."
    LUKKAN @ talk "Y francamente, la armadura tardaba {i}demasiado{/i} en producirse."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:112
translate es ev_lukkan_tavern_talk_2_menu2_996e4e50:

    # LUKKAN @ talk "Sure, in peace time when you have the luxury of time, it's fine."
    LUKKAN @ talk "Claro, en tiempos de paz, cuando tienes el lujo del tiempo, está bien."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:113
translate es ev_lukkan_tavern_talk_2_menu2_64776b2c:

    # LUKKAN @ talk "You can slowly plod on while you collect all your ore."
    LUKKAN @ talk "Puedes avanzar lentamente mientras recoges todo el mineral."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:114
translate es ev_lukkan_tavern_talk_2_menu2_3515bc69:

    # LUKKAN @ talk "But what happens when ten thousand men are slain on the battlefield in one day, leaving behind all that armour?"
    LUKKAN @ talk "Pero, ¿qué ocurre cuando diez mil hombres mueren en el campo de batalla en un solo día, dejando atrás toda esa armadura?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:115
translate es ev_lukkan_tavern_talk_2_menu2_fa8eec20:

    # LUKKAN @ talk "That armour doesn't just 'magically' return to re-stock itself."
    LUKKAN @ talk "Esa armadura no vuelve 'mágicamente' a reabastecerse."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:116
translate es ev_lukkan_tavern_talk_2_menu2_b2a5d91c:

    # LUKKAN @ talk "And just like that, it dawns on them, pretty soon, they won't be able to produce anywhere near the amount of armour they need for fresh troops."
    LUKKAN @ talk "Y de repente se dan cuenta de que muy pronto no podrán producir ni de lejos la cantidad de armaduras que necesitan para las nuevas tropas."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:117
translate es ev_lukkan_tavern_talk_2_menu2_ec33bd11:

    # LUKKAN @ talk "So what did Alcott do? Well, he wanted to use a cheaper iron-based ore far more readily available that we could use to quickly churn out armour and weapons to every able hand and body."
    LUKKAN @ talk "¿Y qué hizo Alcott? Pues bien, quería utilizar un mineral de hierro más barato y mucho más fácil de conseguir, con el que pudiéramos fabricar rápidamente armaduras y armas para todas las manos y cuerpos hábiles."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:118
translate es ev_lukkan_tavern_talk_2_menu2_1f95f6f4:

    # LUKKAN @ talk "Don't get me wrong, this stuff is shite compared to what we {i}used{/i} to have."
    LUKKAN @ talk "No me malinterpretes, esto es una mierda comparado con lo que {i}teníamos{/i} antes."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:119
translate es ev_lukkan_tavern_talk_2_menu2_cfb4a88c:

    # LUKKAN @ talk "But which is better? To have ten men who have average armour and passable swords? Or to have three men with great armour and weapons, but the other seven have nothing?"
    LUKKAN @ talk "Pero, ¿qué es mejor? ¿Tener diez hombres con armaduras normales y espadas pasables? ¿O tener tres hombres con buenas armaduras y armas, pero los otros siete sin nada?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:120
translate es ev_lukkan_tavern_talk_2_menu2_3facbe0b:

    # LUKKAN @ talk "The armoury’s ore master though, a man called Charlan Croshire, refused to compromise on quality and fought with Alcott."
    LUKKAN @ talk "Sin embargo, el jefe del mineral de la armería, un hombre llamado Charlan Croshire, se negó a comprometer la calidad y se peleó con Alcott."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:121
translate es ev_lukkan_tavern_talk_2_menu2_8ff0d3cc:

    # LUKKAN @ talk "So Alcott goes back to Mesamor to replace the Ore master, but Mesamor refused."
    LUKKAN @ talk "Así que Alcott vuelve a Mesamor para sustituir al jefe del mineral, pero Mesamor se negó."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:122
translate es ev_lukkan_tavern_talk_2_menu2_c8b7a5e6:

    # LUKKAN @ talk "It was a matter of national pride to him, his ego-overrode practicality."
    LUKKAN @ talk "Para él era una cuestión de orgullo nacional, su ego primaba sobre el sentido práctico."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:123
translate es ev_lukkan_tavern_talk_2_menu2_cc3a0ab0:

    # LUKKAN @ talk "And that's just ONE example, there are dozens of other decisions Mesamor interfered with that constantly caused issues and resentment."
    LUKKAN @ talk "Y eso es solo UN ejemplo, hay docenas de otras decisiones en las que Mesamor interfirió y que constantemente causaron problemas y resentimiento."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:126
translate es ev_lukkan_tavern_talk_2_menu2_f85d8de2:

    # LUKKAN @ talk "{i}Daggerfall...{/i}"
    LUKKAN @ talk "{i}Daggerfall...{/i}"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:127
translate es ev_lukkan_tavern_talk_2_menu2_46a67cc0:

    # LUKKAN @ talk "It wasn't the worst plan to be honest, at least, not at first."
    LUKKAN @ talk "No era el peor plan para ser honesto, al menos, no al principio."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:128
translate es ev_lukkan_tavern_talk_2_menu2_2eb28da9:

    # LUKKAN @ talk "The idea was to split the army into two and strike while the metal was still hot."
    LUKKAN @ talk "La idea era dividir el ejército en dos y atacar cuando exista la oportuniad."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:129
translate es ev_lukkan_tavern_talk_2_menu2_d53505ef:

    # LUKKAN @ talk "Gerano had fallen, but the city of Hamun was surprisingly holding it's own pretty well, as did Inma to the East."
    LUKKAN @ talk "Gerano había caído, pero la ciudad de Hamun sorprendentemente se mantenía bastante bien, al igual que Inma al este."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:130
translate es ev_lukkan_tavern_talk_2_menu2_d32cebd3:

    # LUKKAN @ talk "The idea was for us to lift the sieges at both Inma and Hamun and then re-group to begin a long seige to re-take Fort Rook once those two were secured."
    LUKKAN @ talk "La idea era levantar los asedios de Inma y Hamun y reagruparnos para iniciar un largo asedio y retomar el fuerte Rook una vez que ambos estuvieran asegurados."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:131
translate es ev_lukkan_tavern_talk_2_menu2_ec7dfac2:

    # LUKKAN @ talk "Once we re-took Fort Rook, we could establish a new front line and safely leap-frog to any number of regions to support."
    LUKKAN @ talk "Una vez retomado el fuerte Rook, podríamos establecer una nueva línea de frente y saltar con seguridad a cualquier número de regiones para apoyar."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:132
translate es ev_lukkan_tavern_talk_2_menu2_82200767:

    # LUKKAN @ talk "I was sent to the Eastern Front to relive Hamun, and for a while, it seemed to be working."
    LUKKAN @ talk "Me enviaron al frente oriental para aliberar Hamun y, durante un tiempo, pareció que funcionaba."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:133
translate es ev_lukkan_tavern_talk_2_menu2_0c13669b:

    # LUKKAN @ talk "On our side, we managed to reach Hamun safely and began to help push back the Demorai forces there."
    LUKKAN @ talk "Por nuestra parte, logramos llegar a salvo a Hamun y empezamos a ayudar a hacer retroceder a las fuerzas Demorai allí."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:134
translate es ev_lukkan_tavern_talk_2_menu2_43288abb:

    # LUKKAN @ talk "The Western Front though? That was a whole different game... Poor bastards."
    LUKKAN @ talk "¿Pero el frente occidental? Eso fue otra cosa... Pobres bastardos."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:135
translate es ev_lukkan_tavern_talk_2_menu2_d350cedb:

    # MC @ talk "Where do you think it went wrong?"
    MC @ talk "¿Dónde crese que falló?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:136
translate es ev_lukkan_tavern_talk_2_menu2_1156be38:

    # LUKKAN @ talk "Take your pick?"
    LUKKAN @ talk "¿Qué prefieres?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:137
translate es ev_lukkan_tavern_talk_2_menu2_fba77149:

    # LUKKAN @ talk "Mesamor refused to listen to Alcott and insisted we didn't wait for the Summer, but struck now just before Winter begun."
    LUKKAN @ talk "Mesamor se negó a escuchar a Alcott e insistió en que no esperáramos al verano, sino que atacáramos ahora, justo antes de que empezara el invierno."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:138
translate es ev_lukkan_tavern_talk_2_menu2_03b26c87:

    # LUKKAN @ talk "Him and the High lords figured that with the Demorai now on the backfoot following the great siege, they wouldn't expect such a quick counter-offensive."
    LUKKAN @ talk "Él y los grandes señores supusieron que con los Demorai ahora en la retaguardia tras el gran asedio, no esperarían una contraofensiva tan rápida."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:139
translate es ev_lukkan_tavern_talk_2_menu2_e7fa2894:

    # LUKKAN @ talk "Mesamor reasoned if we waited till the Summer, we would lose the window of opportunity to strike, and the Demorai forces would have recovered too much by then to nullify whatever offensive we mustered."
    LUKKAN @ talk "Mesamor pensó que si esperábamos hasta el verano, perderíamos la oportunidad de atacar, y las fuerzas Demorai se habrían recuperado demasiado para entonces como para anular cualquier ofensiva que reuniéramos."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:140
translate es ev_lukkan_tavern_talk_2_menu2_00cfa798:

    # LUKKAN @ talk "...Which leads into the second major problem."
    LUKKAN @ talk "...Lo que nos lleva al segundo gran problema."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:141
translate es ev_lukkan_tavern_talk_2_menu2_aa0ddc83:

    # LUKKAN @ talk "We were already struggling to supply our troops with proper armour and equipment, now, we were moving two massive forces simultaneously and our supply lines simply buckled."
    LUKKAN @ talk "Ya teníamos problemas para abastecer a nuestras tropas con armamento y equipo adecuados, pero ahora, al desplazar dos fuerzas masivas simultáneamente, nuestras líneas de suministro se colapsaron."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:142
translate es ev_lukkan_tavern_talk_2_menu2_91a2c702:

    # LUKKAN @ talk "See that's the thing about Mesamor and all those High Lords, they only focused on the immediate statistics they thought were relevant."
    LUKKAN @ talk "Ves, eso es lo que pasa con Mesamor y todos esos grandes señores, solo se centraban en las estadísticas inmediatas que creían relevantes."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:143
translate es ev_lukkan_tavern_talk_2_menu2_1b819086:

    # LUKKAN @ talk "Things like troop numbers and which weapons were proving most effective in killing Demorai..."
    LUKKAN @ talk "Cosas como el número de tropas y qué armas eran más efectivas para matar a Demorai..."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:144
translate es ev_lukkan_tavern_talk_2_menu2_e95114bc:

    # LUKKAN @ talk "What they were never concerned with though, was considering the amount of {i}food{/i} they'd need to send to these massive forces day to day."
    LUKKAN @ talk "Lo que nunca les preocupó, sin embargo, fue considerar la cantidad de {i}alimentos{/i} que necesitarían enviar a esas enormes fuerzas día a día."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:145
translate es ev_lukkan_tavern_talk_2_menu2_4e50f015:

    # LUKKAN @ talk "They never considered the possibility that this 'counter offensive' could drag on into the long winter, and that the men would need Winter uniforms."
    LUKKAN @ talk "Nunca consideraron la posibilidad de que esta 'contraofensiva' se prolongara durante el largo invierno y que los hombres necesitaran uniformes de invierno."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:146
translate es ev_lukkan_tavern_talk_2_menu2_6ea0c11a:

    # LUKKAN @ talk "And that's exactly what happened... Just some half-starved, poorly-equipped nearly frozen to death men in the West."
    LUKKAN @ talk "Y eso es exactamente lo que pasó... Solo unos hombres medio muertos de hambre, mal equipados y casi congelados en el oeste."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:147
translate es ev_lukkan_tavern_talk_2_menu2_00be4855:

    # LUKKAN @ talk "We had to abandon our plans to meet at Fort Rook and move quickly to reform a new defence line deeper in-land to stop the Demorai and help the straggling forces there."
    LUKKAN @ talk "Tuvimos que abandonar nuestros planes de reunirnos en el fuerte Rook y movernos rápidamente para reformar una nueva línea defensiva más adentro para detener a los Demorai y ayudar a las fuerzas rezagadas de allí."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:148
translate es ev_lukkan_tavern_talk_2_menu2_df783d89:

    # MC @ talk "And that's when Alcott had enough?"
    MC @ talk "¿Y fue entonces cuando Alcott tuvo suficiente?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:149
translate es ev_lukkan_tavern_talk_2_menu2_ca594e67:

    # LUKKAN @ talk "No... The final straw was when Mesamor ordered Alcott to try the same thing {i}again.{/i}"
    LUKKAN @ talk "No... La gota que colmó el vaso fue cuando Mesamor le ordenó a Alcott que intentara lo mismo {i}otra vez.{/i}"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:150
translate es ev_lukkan_tavern_talk_2_menu2_e1ebe8d2:

    # LUKKAN @ talk "He was delusional, telling everyone in Court that we {i}actually{/i} were on the verge of pushing through in the West and should have never retreated, that we should have ordered those men to wait till reinforcements arrived."
    LUKKAN @ talk "Estaba delirante, diciéndoles a todos en la corte que {i}en realidad{/i} estábamos a punto de avanzar por el oeste y que nunca deberíamos habernos retirado, que deberíamos haber ordenado a esos hombres que esperaran hasta que llegaran refuerzos."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:151
translate es ev_lukkan_tavern_talk_2_menu2_44cbec2b:

    # LUKKAN @ talk "Gods, I can remember them arguing now..."
    LUKKAN @ talk "Dioses, puedo recordarlos discutiendo ahora..."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:152
translate es ev_lukkan_tavern_talk_2_menu2_38507a13:

    # "Lukkan took a sip of his drink as he began to paraphrase his memory."
    "Lukkan tomó un sorbo de su bebida mientras comenzaba a parafrasear su memoria."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:153
translate es ev_lukkan_tavern_talk_2_menu2_7ccf1608:

    # LUKKAN @ talk "{i}Gather some fresh troops and begin a new offensive at once Alcott! You cannot be such a fool to let this chance slip from your grasp!{/i}"
    LUKKAN @ talk "{i}¡Reúne tropas nuevas y comienza una nueva ofensiva de inmediato, Alcott! ¡No puedes ser tan tonto como para dejar escapar esta oportunidad!{/i}"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:154
translate es ev_lukkan_tavern_talk_2_menu2_35172724:

    # LUKKAN @ talk "{i}Find more men!{/i}"
    LUKKAN @ talk "{i}¡Encuentra más hombres!{/i}"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:155
translate es ev_lukkan_tavern_talk_2_menu2_0a36646f:

    # "Lukkan boomed, doing his best impression of Alcott's voice."
    "Lukkan gritó, haciendo su mejor imitación de la voz de Alcott."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:156
translate es ev_lukkan_tavern_talk_2_menu2_6bf5dbd8:

    # LUKKAN @ talk "{i}THERE IS NO MORE MEN TO SPARE FOR YOUR FOOLISH PLANS!{/i}"
    LUKKAN @ talk "{i}¡YA NO HAY HOMBRES DISPONIBLES PARA TUS PLANES INSENSATOS!{/i}"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:157
translate es ev_lukkan_tavern_talk_2_menu2_b81b7ff5:

    # "Lukkan chuckled."
    "Lukkan se rió entre dientes."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:158
translate es ev_lukkan_tavern_talk_2_menu2_abdf74a4:

    # LUKKAN @ talk "After that, Alcott was imprisoned by Mesamor briefly."
    LUKKAN @ talk "Después de eso, Alcott fue encarcelado por Mesamor brevemente."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:159
translate es ev_lukkan_tavern_talk_2_menu2_c60934cf:

    # LUKKAN @ talk "By then, most of the war council had enough of Mesamor, and the co-conspirators broke Alcott out and well..."
    LUKKAN @ talk "Para entonces, la mayoría del consejo de guerra estaba harto de Mesamor, y los co-conspiradores liberaron a Alcott y bueno..."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:160
translate es ev_lukkan_tavern_talk_2_menu2_3989bc68:

    # LUKKAN @ talk "The rest is history."
    LUKKAN @ talk "El resto es historia."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:161
translate es ev_lukkan_tavern_talk_2_menu2_103ade9a:

    # LUKKAN @ talk "Mesamor was usurped and finally this war was run properly."
    LUKKAN @ talk "Mesamor fue usurpado y finalmente esta guerra se llevó a cabo correctamente."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:162
translate es ev_lukkan_tavern_talk_2_menu2_015e59bb:

    # MC @ talk "Why did Mesamor constantly interfere the way he did?"
    MC @ talk "¿Por qué Mesamor interfería constantemente de la manera en que lo hacía?"

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:163
translate es ev_lukkan_tavern_talk_2_menu2_b0dcf253:

    # "Lukkan shrugged."
    "Lukkan se encogió de hombros."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:164
translate es ev_lukkan_tavern_talk_2_menu2_dd053458:

    # LUKKAN @ talk "Who knows? Court politics is a funny thing, and I imagine he had his reasons."
    LUKKAN @ talk "¿Quién sabe? La política de la corte es algo curioso y me imagino que tenía sus razones."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:165
translate es ev_lukkan_tavern_talk_2_menu2_67fd60a5:

    # LUKKAN @ talk "...Or maybe, he really was just mad in the end."
    LUKKAN @ talk "...O tal vez, al final simplemente estaba loco."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:166
translate es ev_lukkan_tavern_talk_2_menu2_48689f8c:

    # LUKKAN @ talk "Doesn't matter now though, what's done is done."
    LUKKAN @ talk "Pero ahora ya no importa, lo hecho, hecho está."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:167
translate es ev_lukkan_tavern_talk_2_menu2_1ce7afe1:

    # LUKKAN @ talk "Anyway, that's enough history, don't you think."
    LUKKAN @ talk "De cualquier modo, ya es suficiente historia, ¿no crees?."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:168
translate es ev_lukkan_tavern_talk_2_menu2_346f20f9:

    # LUKKAN @ talk "Now if you don't mind, I'd like finish this drink in peace..."
    LUKKAN @ talk "Ahora, si no te importa, me gustaría terminar esta bebida en paz..."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:169
translate es ev_lukkan_tavern_talk_2_menu2_2fdbb7eb:

    # "As Lukkan took a sip of his drink, he seemed pre-occupied with stirred up memories, shaking his head before taking another sip."
    "Mientras Lukkan tomaba un sorbo de su bebida, parecía preocupado por los recuerdos del pasado, sacudiendo la cabeza antes de tomar otro sorbo."

# game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:170
translate es ev_lukkan_tavern_talk_2_menu2_27c8b67d:

    # MC @ talk "Thank you for talking to me, Lukkan... I will leave you be."
    MC @ talk "Gracias por hablar conmigo, Lukkan... Te dejaré en paz."

translate es strings:

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:16
    old "Talk to Lukkan"
    new "Hablar con Lukkan"

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:20
    old "I wanted to ask you about something"
    new "Quería preguntarte algo"

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:21
    old "Very well, enjoy your Evening."
    new "Muy bien, disfruta tu anochecer."

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:39
    old "Alright you miserable bastard, I'll leave you alone."
    new "Está bien, miserable bastardo, te dejaré solo."

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:39
    old "How about I buy you the next round?"
    new "¿Qué tal si te invito a la siguiente ronda?"

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:48
    old "How long have you been serving?"
    new "¿Cuánto tiempo llevas sirviendo?"

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:48
    old "Did you side with Alcott to betray the king?"
    new "¿Te pusiste del lado de Alcott para traicionar al rey?"

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:103
    old "Got an example?"
    new "¿Tienes un ejemplo?"

    # game/data/world_events/lukkan_tavern/ev_lukkan_tavern.rpy:103
    old "So, what happened next?"
    new "Entonces, ¿qué pasó después?"
