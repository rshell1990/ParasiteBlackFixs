

# game/data/world_events/mad_prophet/scr_prophet.rpy:2
translate es ev_madprophet_var1_15aab633:

    # MAD_PROPHET "HAVE ANY OF YOU ASKED WHY THE SAVIOUR ABANDONED US? WHY NEWHEART LEFT HIS MORTAL FLESH BEHIND IN OUR DARKEST HOURS?"
    MAD_PROPHET "¿ALGUNO DE VOSOTROS SE HA PREGUNTADO POR QUÉ NOS ABANDONÓ EL SALVADOR? ¿POR QUÉ NEWHEART DEJÓ ATRÁS SU CARNE MORTAL EN NUESTRAS HORAS MÁS OSCURAS?"

# game/data/world_events/mad_prophet/scr_prophet.rpy:3
translate es ev_madprophet_var1_a3116029:

    # MAD_PROPHET "SINS! SINS AND BLACKNESS THAT HAS TAKEN SWAY THE SPIRIT OF MAN!"
    MAD_PROPHET "¡PECADOS! ¡PECADOS Y OSCURIDAD QUE HAN DOMINADO EL ESPÍRITU DEL HOMBRE!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:4
translate es ev_madprophet_var1_495ef4f7:

    # MAD_PROPHET "THE GODS GIFTED US WITH THE SAVIOUR AND NOW IN PUNISHMENT HAVE TAKEN HIM FROM US AGAIN!"
    MAD_PROPHET "¡LOS DIOSES NOS DIERON AL SALVADOR Y AHORA COMO CASTIGO NOS LO HAN QUITADO OTRA VEZ!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:5
translate es ev_madprophet_var1_a83b9be4:

    # MAD_PROPHET "REPENT! REPENT NOW YOU FOOLS AND WORSHIP THE NEW GODS ONCE AGAIN! RESTORE THE TEMPLES TO THEIR GLORY AND BURN THE HEATHENS WHO STILL CALL UPON THE OLD GODS FOR SALVATION!"
    MAD_PROPHET "¡ARREPENTÍOS! ¡ARREPENTÍOS AHORA, TONTOS, Y ADORAD A LOS NUEVOS DIOSES UNA VEZ MÁS! ¡RESTAURAD LOS TEMPLOS A SU GLORIA Y QUEMAD A LOS PAGANOS QUE TODAVÍA INVOCAN A LOS VIEJOS DIOSES PARA SER SALVADOS!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:7
translate es ev_madprophet_var1_df5b3353:

    # "Some of the crowd began to clap and applaud the mad old man, whereas others, slipped away with a look of disgust on their face."
    "Algunos de los presentes comenzaron a aplaudir al viejo loco, mientras que otros se marcharon con una expresión de disgusto en el rostro."

# game/data/world_events/mad_prophet/scr_prophet.rpy:10
translate es ev_madprophet_var2_15ce3e42:

    # MAD_PROPHET "THE DEMORAI ARE A PLAGUE UPON THIS LAND!"
    MAD_PROPHET "¡LOS DEMORAI SON UNA PLAGA SOBRE ESTA TIERRA!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:11
translate es ev_madprophet_var2_f121e7ac:

    # MAD_PROPHET "BOUGHT ONTO US FOR THE SIN OF LOSING OUR FAITH IN THE NEW GODS!"
    MAD_PROPHET "¡LLEVADOS A NOSOTROS POR EL PECADO DE PERDER NUESTRA FE EN LOS NUEVOS DIOSES!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:12
translate es ev_madprophet_var2_db6d9af5:

    # MAD_PROPHET "WHICH FOOLS AMONGST YOU HAVE TURNED BACK TO THE OLD GODS FOR SALVATION?"
    MAD_PROPHET "¿QUÉ TONTOS ENTRE VOSOTROS HAN REGRESADO A LOS VIEJOS DIOSES PARA OBTENER SALVACIÓN?"

# game/data/world_events/mad_prophet/scr_prophet.rpy:13
translate es ev_madprophet_var2_f9b71979:

    # MAD_PROPHET "ONLY ONCE WE HAVE PURGED THE SINNERS BY FIRE AND RESTORED THE TEMPLES AND OUR FAITH TO THE NEW GODS ONCE AGAIN, WILL NEWHEART RETURN TO SAVE US ALL!"
    MAD_PROPHET "¡SOLO UNA VEZ QUE HAYAMOS PURGADO A LOS PECADORES CON FUEGO Y RESTAURADO LOS TEMPLOS Y NUESTRA FE EN LOS NUEVOS DIOSES UNA VEZ MÁS, NEWHEART REGRESARÁ PARA SALVARNOS A TODOS!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:16
translate es ev_madprophet_var2_5b184151:

    # "Some in the crowd whistled and loudly applauded to this, the idea that Newheart would return to {i}save us all{/i} remained a popular notion amongst fanatics who deified him."
    "Algunos en la multitud silbaron y aplaudieron ruidosamente ante esto, la idea de que Newheart regresaría para {i}salvarnos a todos{/i} siguió siendo una noción popular entre los fanáticos que lo deificaron."

# game/data/world_events/mad_prophet/scr_prophet.rpy:17
translate es ev_madprophet_var2_6bc6f540:

    # "...Not that there was any sign yet of his return, of course."
    "...No es que hubiera todavía alguna señal de su regreso, por supuesto."

# game/data/world_events/mad_prophet/scr_prophet.rpy:19
translate es ev_madprophet_var3_7f722a0b:

    # MAD_PROPHET "THE FALSE EMPEROR PREACHES TO US ABOUT {i}MILITARY PLANS AND STRATEGY,{/i} YET WHERE IS HIS PLAN FOR OUR CRUMBLING FAITH?"
    MAD_PROPHET "EL FALSO EMPERADOR NOS PREDICA SOBRE {i}PLANES Y ESTRATEGIA MILITAR{/i}, PERO ¿DÓNDE ESTÁ SU PLAN PARA NUESTRA FE QUE SE DERRUMBA?"

# game/data/world_events/mad_prophet/scr_prophet.rpy:20
translate es ev_madprophet_var3_d341bd4c:

    # MAD_PROPHET "WHERE IS HIS PLAN TO STOP THE DARK TIDE OF BLACK MAGES INFESTING OUR KINGDOM? WHOSE FILTH POISONS THE VERY LAND!"
    MAD_PROPHET "¿DÓNDE ESTÁ SU PLAN PARA DETENER LA OSCURA MAREA DE MAGOS NEGROS QUE INFESTAN NUESTRO REINO? ¡CUYA SUCIEDAD ENVENENA LA MISMA TIERRA!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:21
translate es ev_madprophet_var3_71581485:

    # MAD_PROPHET "MAKE NO MISTAKE CITIZENS, THIS WAR AND THESE SO CALLED {i}DEMORAI...{/i}"
    MAD_PROPHET "NO SE EQUIVOQUEN CIUDADANOS, ESTA GUERRA Y ESOS LLAMADOS {i}DEMORAI...{/i}"

# game/data/world_events/mad_prophet/scr_prophet.rpy:22
translate es ev_madprophet_var3_f90725db:

    # MAD_PROPHET "THEY ARE NOTHING MORE THAN A CURSE BOUGHT DOWN UPON US!"
    MAD_PROPHET "¡NO SON MÁS QUE UNA MALDICIÓN CAÍDA SOBRE NOSOTROS!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:23
translate es ev_madprophet_var3_254427f2:

    # MAD_PROPHET "ONLY THROUGH THE WORSHIP OF THE NEW GODS AND REJECTION OF THE OLD CAN WE HOPE TO END THIS BLIGHT UPON OUR LAND!"
    MAD_PROPHET "¡SOLO A TRAVÉS DE LA ADORACIÓN DE LOS NUEVOS DIOSES Y EL RECHAZO DE LOS VIEJOS PODEMOS ESPERAR PONER FIN A ESTA PLAGA EN NUESTRA TIERRA!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:27
translate es ev_madprophet_var3_a06dc741:

    # "Some in the crowd whistled and applauded the Mad man while others listened with stoic faces."
    "Algunos en la multitud silbaron y aplaudieron al Loco mientras otros escuchaban con caras estoicas."

# game/data/world_events/mad_prophet/scr_prophet.rpy:28
translate es ev_madprophet_var3_03ce97d1:

    # "The gods were silent, and all our prayers thus far remained unanswered... The idea that they would somehow come down and save us after all this time seemed like fanciful delusions at best, harmful poisonous ideas at worst."
    "Los dioses guardaron silencio, y todas nuestras oraciones hasta el momento permanecieron sin respuesta... La idea de que de alguna manera bajarían y nos salvarían después de todo este tiempo parecía, en el mejor de los casos, una ilusión fantasiosa y, en el peor, una idea dañina y venenosa."

# game/data/world_events/mad_prophet/scr_prophet.rpy:29
translate es ev_madprophet_var4_b11451d9:

    # MAD_PROPHET "REPENT... REPENT! REPENT! REPENT!"
    MAD_PROPHET "ARREPENTÍOS... ¡ARREPENTÍOS!, ¡ARREPENTÍOS!, ¡ARREPENTÍOS!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:30
translate es ev_madprophet_var4_8ea7e21d:

    # MAD_PROPHET "SALVATION FOR ALDERIANS CAN ONLY BE FOUND BY RESTORING OUR FAITH IN THE NEW GODS!"
    MAD_PROPHET "¡LA SALVACIÓN PARA LOS ALDERIANOS SOLO PUEDE ENCONTRARSE RESTAURANDO NUESTRA FE EN LOS NUEVOS DIOSES!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:31
translate es ev_madprophet_var4_1f93e411:

    # MAD_PROPHET "THOSE AMONGST YOU STILL CLINGING TO THE FAITH OF THE OLD GODS HAVE LED US ASTRAY!"
    MAD_PROPHET "¡AQUELLOS ENTRE VOSOTROS QUE AÚN OS AFERRÁIS A LA FE DE LOS VIEJOS DIOSES NOS HAN LLEVADO EN LA DIRECCIÓN ERRÓNEA!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:32
translate es ev_madprophet_var4_42c9f513:

    # MAD_PROPHET "WE MUST FIND THOSE WHO STILL WORSHIP THE OLD GODS AND PURGE THEM FROM OUR LANDS!"
    MAD_PROPHET "¡DEBEMOS ENCONTRAR A AQUELLOS QUE TODAVÍA ADORAN A LOS VIEJOS DIOSES Y PURGARLOS DE NUESTRAS TIERRAS!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:33
translate es ev_madprophet_var4_90cf8069:

    # MAD_PROPHET "ONLY THEN WILL THE NEW GODS REWARD US WITH OUR SALVATION!"
    MAD_PROPHET "¡SOLO ENTONCES LOS NUEVOS DIOSES NOS RECOMPENSARÁN CON NUESTRA SALVACIÓN!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:38
translate es ev_madprophet_var4_5d3b5e1e:

    # "Some in the crowd clapped and cheered, whilst others, clinging to the edges stared at the Mad Prophet expressionless."
    "Algunos en la multitud aplaudieron y vitorearon, mientras otros, aferrados a los bordes, miraban al profeta loco sin expresión alguna."

# game/data/world_events/mad_prophet/scr_prophet.rpy:38
translate es ev_madprophet_var5_3423f21c:

    # MAD_PROPHET "WHEN WAS THE LAST TIME OUR PEOPLE SAW GREAT VICTORIES?"
    MAD_PROPHET "¿CUÁNDO FUE LA ÚLTIMA VEZ QUE NUESTRO PUEBLO VIO GRANDES VICTORIAS?"

# game/data/world_events/mad_prophet/scr_prophet.rpy:39
translate es ev_madprophet_var5_a79b0c45:

    # MAD_PROPHET "THE LAND BLEEDS AS WE HIDE BEHIND OUR WALLS AND PIECE BY PIECE, THE DEMORAI CONSUME OUR LANDS!"
    MAD_PROPHET "LA TIERRA SANGRA MIENTRAS NOS ESCONDEMOS DETRÁS DE NUESTROS MURALLAS Y PIEZA POR PIEZA, ¡LOS DEMORAI CONSUMEN NUESTRAS TIERRAS!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:40
translate es ev_madprophet_var5_1edea92e:

    # MAD_PROPHET "THE GODS ARE ANGERED WE STRAYED THE PATH AND ALLOWED THE FALSE EMPEROR TO OVERTHROW THE GODS CHOSEN KING!"
    MAD_PROPHET "¡LOS DIOSES ESTÁN ENFADADOS PORQUE NOS DESVIAMOS DEL CAMINO Y PERMITIMOS QUE EL FALSO EMPERADOR DERROCARA AL REY ELEGIDO POR LOS DIOSES!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:41
translate es ev_madprophet_var5_2553b944:

    # MAD_PROPHET "WE MUST RESTORE OUR FAITH ONCE AGAIN IF WE ARE TO HAVE ANY HOPE OF TURNING THE DARK TIDE OF THESE WRETCHED TIMES!"
    MAD_PROPHET "¡DEBEMOS RESTAURAR NUESTRA FE UNA VEZ MÁS SI QUEREMOS TENER ALGUNA ESPERANZA DE CAMBIAR LA MAREA OSCURA DE ESTOS TIEMPOS MISERABLES!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:47
translate es ev_madprophet_var5_37329a7f:

    # "There was noticebly not many applause with this speech, as the attention and glares of some passing guards and a inquisitor quickly drained the energy of the crowd."
    "No hubo muchos aplausos con este discurso, ya que la atención y las miradas de algunos guardias que pasaban y de un inquisidor drenaron rápidamente la energía de la multitud."

# game/data/world_events/mad_prophet/scr_prophet.rpy:46
translate es ev_madprophet_var6_79d3fbaa:

    # MAD_PROPHET "I SEE RIVERS OF BLOOD AND FIRES BURNING THROUGHOUT THE LAND!"
    MAD_PROPHET "¡VEO RÍOS DE SANGRE Y FUEGOS ARDIENDO POR TODA LA TIERRA!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:47
translate es ev_madprophet_var6_f2864eec:

    # MAD_PROPHET "I SEE THE SMOKE RISING FROM THE SHATTERED ARMIES ON THE FINAL BATTLEFIELDS!"
    MAD_PROPHET "¡VEO EL HUMO QUE SE ELEVA DE LOS EJÉRCITOS DESTRUIDOS EN LOS CAMPOS DE BATALLA FINALES!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:48
translate es ev_madprophet_var6_6ead09cc:

    # MAD_PROPHET "I SEE OUR FALSE EMPEROR, DOWN ON HIS KNEES AS HE WEEPS WATCHING HIS KINGDOM BURN!"
    MAD_PROPHET "¡VEO A NUESTRO FALSO EMPERADOR, DE RODILLAS, LLORANDO, MIRANDO ARDER SU REINO!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:49
translate es ev_madprophet_var6_3b9635ab:

    # MAD_PROPHET "ONLY THROUGH RESTORING OUR FAITH IN THE NEW GODS CAN WE SAVE OURSELVES FROM THIS TERRIBLE FATE!"
    MAD_PROPHET "¡SOLO RESTAURANDO NUESTRA FE EN LOS NUEVOS DIOSES PODEMOS SALVARNOS DE ESTE TERRIBLE DESTINO!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:56
translate es ev_madprophet_var6_a5cd1e67:

    # "Some in the crowd clapped more enthusiastically than others, others murmured fearful about the Mad prophet's word."
    "Algunos en la multitud aplaudieron con más entusiasmo que otros, otros murmuraron temerosos ante la palabra del profeta loco."

# game/data/world_events/mad_prophet/scr_prophet.rpy:54
translate es ev_madprophet_var7_6bb279ac:

    # MAD_PROPHET "BLACK MAGES WALK AMONGST US! PRACTITIONERS OF THE OLD GODS!"
    MAD_PROPHET "¡LOS MAGOS NEGROS CAMINAN ENTRE NOSOTROS! ¡PRACTICANTES DE LOS DIOSES ANTIGUOS!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:55
translate es ev_madprophet_var7_fd97c62b:

    # MAD_PROPHET "THE FOOLS WOULD CONDEMN US ALL IN THEIR UNSATIBLE APPETITE FOR MORE POWER!"
    MAD_PROPHET "¡LOS TONTOS NOS CONDENARÍAN A TODOS EN SU INSACIABLE APETITO DE MÁS PODER!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:56
translate es ev_madprophet_var7_8a479377:

    # MAD_PROPHET "THEIR WICKED ART THAT HAS FLOURISHED THROUGHOUT THE LAND AND THE FAILURE OF OUR SO-CALLED {i}INQUISITOR{/i} HAS LEFT THE NEW GODS FURIOUS!"
    MAD_PROPHET "¡SU MALVADO ARTE QUE HA FLORECIDO POR TODA LA TIERRA Y EL FRACASO DE NUESTRO LLAMADO {i}INQUISIDOR{/i} HA DEJADO A LOS NUEVOS DIOSES FURIOSOS!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:57
translate es ev_madprophet_var7_c4565f96:

    # MAD_PROPHET "ONLY ONCE WE HAVE PURGED AND EXTERMINATED ALL OF THESE FOUL BEINGS AND RESTORED OUR FAITH IN THE NEW GODS WILL THE DEMORAI PLAGUE CEASE!"
    MAD_PROPHET "¡SOLO UNA VEZ QUE HAYAMOS PURGADO Y EXTERMINADO A TODOS ESTOS SERES INMUNDOS Y RESTAURADO NUESTRA FE EN LOS NUEVOS DIOSES CESARÁ LA PLAGA DEMORAI!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:65
translate es ev_madprophet_var7_b0c15ff0:

    # "There was some heavy applause and chatter amongst the more religious zealots."
    "Se escucharon fuertes aplausos y charlas entre los fanáticos más religiosos."

# game/data/world_events/mad_prophet/scr_prophet.rpy:66
translate es ev_madprophet_var7_8504cce5:

    # "The topic of Dark Mages always seemed to invoke this kind of blood-thirsty rhetoric, anything short was not met with pleasure by the Inquisitors."
    "El tema de los magos oscuros siempre parecía invocar este tipo de retórica sedienta de sangre, cualquier cosa que fuera inferior a eso no era recibida con agrado por los inquisidores."

# game/data/world_events/mad_prophet/scr_prophet.rpy:63
translate es ev_madprophet_var8_c12400d4:

    # MAD_PROPHET "WHEN THE NEW GODS DETHRONED AND CAST OUT THE WRETCHED OLD GODS, THEY DID SO FOR OUR BENEFIT!"
    MAD_PROPHET "CUANDO LOS NUEVOS DIOSES DESTRONARON Y EXPULSARON A LOS MISERABLES DIOSES VIEJOS, ¡LO HICIERON PARA NUESTRO BENEFICIO!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:64
translate es ev_madprophet_var8_fd16ecf2:

    # MAD_PROPHET "WE FLOURISHED UNDER THE NEW GODS... AND HOW DID WE THANK THEM?"
    MAD_PROPHET "FLORECIMOS BAJO LOS NUEVOS DIOSES... ¿Y CÓMO LES AGRADECIMOS?"

# game/data/world_events/mad_prophet/scr_prophet.rpy:65
translate es ev_madprophet_var8_54981ab8:

    # MAD_PROPHET "TREACHERY... DISBELIEF... THE TEMPLES SHADOWS OF THEIR FORMER SELVES!"
    MAD_PROPHET "TRAICIÓN... INCREDULIDAD... ¡LOS TEMPLOS, SOMBRAS DE LO QUE FUERON ANTES!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:66
translate es ev_madprophet_var8_127b8569:

    # MAD_PROPHET "THE DEMORAI ARE A SICKNESS BOUGHT UPON US FOR OUR FAILURE TO KEEP OUR FAITH!"
    MAD_PROPHET "¡LOS DEMORAI SON UNA ENFERMEDAD QUE NOS HAN IMPUESTO POR NO MANTENER NUESTRA FE!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:67
translate es ev_madprophet_var8_07c6f4a7:

    # MAD_PROPHET "REPENT NOW! RESTORE THE TEMPLES AND BURN THE HERETIC DARK MAGES!"
    MAD_PROPHET "¡ARREPENTÍOS AHORA! ¡RESTAURAD LOS TEMPLOS Y QUEMAD A LOS MAGOS OSCUROS HEREJES!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:68
translate es ev_madprophet_var8_fc968a07:

    # MAD_PROPHET "ONLY THEN WILL THE NEW GODS RETURN AND SHOW US THE WAY!"
    MAD_PROPHET "¡SOLO ENTONCES LOS NUEVOS DIOSES REGRESARAN Y NOS MOSTRARÁN EL CAMINO!"

# game/data/world_events/mad_prophet/scr_prophet.rpy:77
translate es ev_madprophet_var8_299f69ac:

    # "A couple in the crowd applauded, the rest murmured and debated the mad prophet's words in hushed tones amongst themselves."
    "Unos pocos entre la multitud aplaudió, el resto murmuró y debatió en voz baja entre ellos las palabras del profeta loco."
