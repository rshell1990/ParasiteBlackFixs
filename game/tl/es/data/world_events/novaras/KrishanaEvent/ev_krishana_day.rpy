    "Adara se detuvo tímidamente, con las manos apretando con fuerza su vestido."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:149
translate es ev_KrishanaDay_regina_dialogue_menu_7a497736:

    # ADARA @ shame "I was wondering if perhaps maybe we c-could..."
    ADARA @ shame "Me preguntaba si tal vez p-podríamos..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:150
translate es ev_KrishanaDay_regina_dialogue_menu_54779c02:

    # ADARA @ joy "G-Go for a walk?"
    ADARA @ joy "¿D-Dar un paseo?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:152
translate es ev_KrishanaDay_regina_dialogue_menu_7c3775eb:

    # MC @ lewd "Where shall we head to?"
    MC @ lewd "¿Adónde vamos?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:153
translate es ev_KrishanaDay_regina_dialogue_menu_0abbaba0:

    # ADARA @ smile "There's quite a lot going on at the Market I'm told, perhaps we should head there?"
    ADARA @ smile "Me han dicho que hay muchas cosas en el mercado, ¿quizás deberíamos ir allí?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:154
translate es ev_KrishanaDay_regina_dialogue_menu_ce53fb2e:

    # MC @ smile2 "Alright, that sounds good to me."
    MC @ smile2 "De acuerdo, me parece bien."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:156
translate es ev_KrishanaDay_regina_dialogue_menu_a3ef7502:

    # "The two of us made our way through the winding Novaras streets, the gentle snow falling onto the ground as children hurried through excitedly to meet their friends."
    "Los dos nos abrimos paso por las sinuosas calles de Novaras, con la delicada nieve cayendo al suelo mientras los niños se apresuraban entusiasmados a reunirse con sus amigos."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:162
translate es ev_KrishanaDay_regina_dialogue_menu_042dbacd:

    # "At the Market, it was like a kind of festive carnival."
    "El mercado, parecía una especie de carnaval festivo."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:163
translate es ev_KrishanaDay_regina_dialogue_menu_e76869d8:

    # "Merchants, roasted meat over open fires that filled the air with a sweet aroma, with small crowds gathering around eager for a taste."
    "Los mercaderes asaban la carne en hogueras que impregnaban el aire de un dulce aroma, y pequeñas multitudes se agolpaban ansiosas por probarla."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:164
translate es ev_KrishanaDay_regina_dialogue_menu_c36b411f:

    # "Children hurried around, throwing snowballs at their friends, parents watched and chatted amongst themselves from afar."
    "Los niños corrían de un lado a otro lanzando bolas de nieve a sus amigos, los padres miraban y charlaban entre ellos desde lejos."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:165
translate es ev_KrishanaDay_regina_dialogue_menu_be8b2752:

    # "One merchant with huge mead barrels opened, poured patrons small cups who huddled together and laughed to themselves merrily."
    "Un comerciante abrió sus enormes barriles de hidromiel y sirvió pequeñas tazas a los clientes, que se amontonaron y rieron alegremente."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:166
translate es ev_KrishanaDay_regina_dialogue_menu_3d1b9cdc:

    # "For a brief moment in time, it was as though everyone forgot about the wars existence outside these city walls..."
    "Por un breve instante, fue como si todo el mundo se olvidara de la existencia de las guerras fuera de estas murallas..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:168
translate es ev_KrishanaDay_regina_dialogue_menu_da28cac1:

    # ADARA @ smile "Isn't it nice to see everyone out and so cheery?"
    ADARA @ smile "¿No es agradable ver a todo el mundo fuera y tan alegre?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:169
translate es ev_KrishanaDay_regina_dialogue_menu_684e7350:

    # MC @ think "The last time it was like this was when-"
    MC @ think "La última vez que fue así fue cuando-"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:169
translate es ev_KrishanaDay_regina_dialogue_menu_db480df9:

    # "I pushed the thought of the Terminus ceremony to the back of my mind."
    "Alejé de mi mente la ceremonia de Terminus."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:170
translate es ev_KrishanaDay_regina_dialogue_menu_1833ec0b:

    # "This was a happy time."
    "Fue una época feliz."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:171
translate es ev_KrishanaDay_regina_dialogue_menu_681613ed:

    # ADARA @ smile "Look at this place! Isn't it wonderful?"
    ADARA @ smile "¡Mira este lugar! ¿No es maravilloso?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:172
translate es ev_KrishanaDay_regina_dialogue_menu_8c941941:

    # "I smiled as the children chasing each other with snowballs hurried out in front of us."
    "Sonreí mientras los niños que se perseguían con bolas de nieve corrían delante de nosotros."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:174
translate es ev_KrishanaDay_regina_dialogue_menu_99be07bb:

    # MC @ smile2 "Yes, it's nice."
    MC @ smile2 "Sí, es agradable."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:175
translate es ev_KrishanaDay_regina_dialogue_menu_149e2884:

    # ADARA @ joy "What should we do now?"
    ADARA @ joy "¿Qué deberíamos hacer ahora?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:177
translate es ev_KrishanaDay_regina_dialogue_menu_664cc199:

    # "The time went by quickly as we had fun, it was always easy letting time drift by with Adara."
    "El tiempo pasó rápido mientras nos divertíamos, siempre era fácil dejar pasar el tiempo con Adara."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:181
translate es ev_KrishanaDay_regina_dialogue_menu_c8fe2941:

    # MAD_PROPHET "GATHER! GATHER ALL!"
    MAD_PROPHET "¡REUNÍOS! ¡REUNÍOS TODOS!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:185
translate es ev_KrishanaDay_regina_dialogue_menu_397e2913:

    # ADARA @ shock "Isn't he cold wearing so little in this weather?"
    ADARA @ shock "¿No tiene frío llevando tan poca ropa con este tiempo?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:188
translate es ev_KrishanaDay_regina_dialogue_menu_58374c5f:

    # MAD_PROPHET "Come and hear the tale of Krishana the ice dragon!"
    MAD_PROPHET "¡Venid a escuchar el cuento de Krishana, el dragón de hielo!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:189
translate es ev_KrishanaDay_regina_dialogue_menu_5506bc64:

    # ADARA @ smile "What do you think? Wanna listen?"
    ADARA @ smile "¿Qué te parece? ¿Quieres escuchar?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:194
translate es ev_KrishanaDay_regina_dialogue_menu_53aaa9a4:

    # "The two of us stepped closer and joined the growing crowd, mainly comprised of children but a few adults lingered."
    "Los dos nos acercamos y nos unimos a la creciente multitud, compuesta principalmente por niños, pero algunos adultos se quedaron."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:197
translate es ev_KrishanaDay_regina_dialogue_menu_8b9e7ec0:

    # MAD_PROPHET "And so we begin, centuries long past, Krishana, the great ice dragon, sat on her ice throne in the mountains of Angmurus!"
    MAD_PROPHET "¡Y así comenzamos, siglos atrás, Krishana, la gran dragona de hielo, se sentaba en su trono de hielo en las montañas de Angmurus!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:198
translate es ev_KrishanaDay_regina_dialogue_menu_7a95d963:

    # MAD_PROPHET "{i}Bored!{/i}"
    MAD_PROPHET "{i}¡Me aburro!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:197
translate es ev_KrishanaDay_regina_dialogue_menu_e98b016a:

    # "The crowd laughed a little."
    "El público se rió un poco."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:200
translate es ev_KrishanaDay_regina_dialogue_menu_b6989b01:

    # MAD_PROPHET "{i}'I know!'{/i} Thought the mighty dragon, {i}'I shall see what the humans down south are up to!'{/i}"
    MAD_PROPHET "{i}'¡Ya lo sé!'{/i} Pensó la poderosa dragona, {i}'¡Voy a ver lo que los humanos del sur están haciendo!'{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:201
translate es ev_KrishanaDay_regina_dialogue_menu_e6c8eed8:

    # MAD_PROPHET "As her mighty wings soared, she headed down south, perching herself up on a small mountain, watching the villagers down below!"
    MAD_PROPHET "Mientras alzaba sus poderosas alas, se dirigió hacia el sur y se posó en una pequeña montaña para observar a los aldeanos."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:202
translate es ev_KrishanaDay_regina_dialogue_menu_5452de45:

    # MAD_PROPHET "The people revered but feared the mighty dragons! And each parent warned the children not to approach the great Krishana!"
    MAD_PROPHET "¡El pueblo veneraba pero temía a los poderosos dragones! ¡Y todos los padres advertían a sus hijos de que no se acercaran a la gran Krishana!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:203
translate es ev_KrishanaDay_regina_dialogue_menu_bf4a2f15:

    # MAD_PROPHET "Some young children, brave and adventurous, ignoring their parents advice, scaled the small mountain and approached the dragoness!"
    MAD_PROPHET "¡Algunos niños pequeños, valientes y aventureros, haciendo caso omiso de los consejos de sus padres, escalaron la pequeña montaña y se acercaron a la dragona!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:204
translate es ev_KrishanaDay_regina_dialogue_menu_7e9a0589:

    # MAD_PROPHET "{i}'But what brings you small humans here?'{/i} The dragoness asked!"
    MAD_PROPHET "{i}'¿Qué os trae por aquí, pequeños humanos?'{/i} ¡Preguntó la dragona!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:205
translate es ev_KrishanaDay_regina_dialogue_menu_aa79a142:

    # MAD_PROPHET "{i}'Oh great Krishana! It has not snowed in these lands for so long! Can you not make it so?{/i}"
    MAD_PROPHET "{i}'¡Oh, gran Krishana! ¡Hace tanto que no nieva en estas tierras! ¿No puedes hacer que sea así?{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:206
translate es ev_KrishanaDay_regina_dialogue_menu_5fa83f8d:

    # MAD_PROPHET "The dragon laughed, and laughed and laughed!"
    MAD_PROPHET "¡La dragona reía, reía y reía!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:207
translate es ev_KrishanaDay_regina_dialogue_menu_7ecbd013:

    # MAD_PROPHET "{i}But what in return shall thy give thee?{/i} The dragoness asked."
    MAD_PROPHET "{i}¿Pero qué me darás a cambio?{/i} Ppreguntó la dragona."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:208
translate es ev_KrishanaDay_regina_dialogue_menu_1a3da702:

    # MAD_PROPHET "{i}For my hordes of gold are vast, and I never suffer hunger long!{/i}"
    MAD_PROPHET "{i}Porque mis montones de oro son inmensos, ¡y nunca sufro hambre mucho tiempo!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:209
translate es ev_KrishanaDay_regina_dialogue_menu_ef09375e:

    # MAD_PROPHET "{i}What could you possibly have to offer me?{/i}"
    MAD_PROPHET "{i}¿Qué podrías ofrecerme?{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:210
translate es ev_KrishanaDay_regina_dialogue_menu_8f1a64cc:

    # MAD_PROPHET "The children looked amongst themselves for a moment, till one stepped forward and offered the great Krishana a small stone."
    MAD_PROPHET "Los niños se miraron entre sí durante un momento, hasta que uno dio un paso adelante y ofreció a la gran Krishana una pequeña piedra."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:211
translate es ev_KrishanaDay_regina_dialogue_menu_70d2ab96:

    # MAD_PROPHET "{i}But what is this?{/i} The dragoness asked."
    MAD_PROPHET "{i}¿Pero qué es esto?{/i} Preguntó la dragona."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:212
translate es ev_KrishanaDay_regina_dialogue_menu_d33e7b2d:

    # MAD_PROPHET "{i}It is a waystone!{/i} the child answered!"
    MAD_PROPHET "{i}¡Es una piedra guia!{/i} Respondió el niño."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:213
translate es ev_KrishanaDay_regina_dialogue_menu_60db9f86:

    # MAD_PROPHET "{i}So no matter where you fly, you will always be able to find your way home here!{/i}"
    MAD_PROPHET "{i}Así que, sin importar adónde vuele, aquí siempre podrá encontrar el camino de vuelta tu hogar.{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:214
translate es ev_KrishanaDay_regina_dialogue_menu_9e7dd2b0:

    # MAD_PROPHET "Krishana took the small gift, and boomed, {i}'HOME? HERE? FOR ME?'{/i}"
    MAD_PROPHET "Krishana cogió el pequeño obsequio y retumbó, {i}'¿HOGAR? ¿AQUÍ? ¿PARA MÍ?'{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:215
translate es ev_KrishanaDay_regina_dialogue_menu_0229275b:

    # MAD_PROPHET "The dragoness, so touched by the gift, said with a cool blow of air, {i}I've never had a home before.{/i}"
    MAD_PROPHET "La dragona, tan conmovida por el regalo, dijo con un soplo de aire fresco, {i}Nunca había tenido un hogar.{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:216
translate es ev_KrishanaDay_regina_dialogue_menu_2bb02a72:

    # MAD_PROPHET "Before the children could answer, the mighty Kirshana unleashed her icy breath into the sky, and the children celebrated as the snow fell down!"
    MAD_PROPHET "¡Antes de que los niños pudieran responder, la poderosa Kirshana desató su aliento helado en el cielo, y los niños celebraron mientras la nieve caía!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:217
translate es ev_KrishanaDay_regina_dialogue_menu_dda3abaf:

    # MAD_PROPHET "And so it was, Krishana returned every year to bring forth the snow in exchange for the children's gifts!"
    MAD_PROPHET "¡Y así fue, Krishana volvió cada año para traer la nieve a cambio de los regalos de los niños!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:218
translate es ev_KrishanaDay_regina_dialogue_menu_9885251b:

    # MAD_PROPHET "And thus, that is why yearly we share gifts amongst loved ones and friends! To celebrate this most joyous of times!"
    MAD_PROPHET "¡Por eso todos los años repartimos regalos entre nuestros seres queridos y amigos! ¡Para celebrar este momento tan feliz!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:217
translate es ev_KrishanaDay_regina_dialogue_menu_c64f40ac:

    # "The crowd clapped and handed over some coins towards the man, who collected them in a small jar."
    "La multitud aplaudió y entregó algunas monedas al hombre, que las recogió en un pequeño tarro."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:222
translate es ev_KrishanaDay_regina_dialogue_menu_29f9f809:

    # ADARA @ smile "Krishana was always one of my favorite stories growing up."
    ADARA @ smile "Krishana siempre fue una de mis historias favoritas mientras crecía."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:223
translate es ev_KrishanaDay_regina_dialogue_menu_51eae6f2:

    # ADARA @ smile "Isn't it nice to just hear a story not always about death and violence once in a while?"
    ADARA @ smile "¿No es agradable escuchar de vez en cuando una historia que no trate siempre de muerte y violencia?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:225
translate es ev_KrishanaDay_regina_dialogue_menu_ed83f52f:

    # ADARA @ talk "Ah, okay then..."
    ADARA @ talk "Ah, de acuerdo entonces..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:226
translate es ev_KrishanaDay_regina_dialogue_menu_5ccedec9:

    # ADARA @ talk "It's getting quite late."
    ADARA @ talk "Se está haciendo tarde."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:229
translate es ev_KrishanaDay_regina_dialogue_menu_46b5b0ad:

    # ADARA @ shame "Do you mind walking me home?"
    ADARA @ shame "¿Te importaría acompañarme a casa?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:230
translate es ev_KrishanaDay_regina_dialogue_menu_0ca268ac:

    # MC @ lewd "Do you even need to ask that?"
    MC @ lewd "¿Necesitas siquiera preguntar eso?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:229
translate es ev_KrishanaDay_regina_dialogue_menu_1454db55:

    # "Adara smiled."
    "Adara sonrió."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:231
translate es ev_KrishanaDay_regina_dialogue_menu_e2b4bf66:

    # ADARA @ talk "C-Come on then, it's cold just standing here talking!"
    ADARA @ talk "¡V-Vamos, hace frío aquí de pie hablando!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:241
translate es ev_KrishanaDay_regina_dialogue_menu_6f95fffc:

    # "{i}After a short walk back to Adara's home...{/i}"
    "{i}Después de un corto paseo de regreso a la casa de Adara...{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:248
translate es ev_KrishanaDay_regina_dialogue_menu_2af513bf:

    # ADARA @ talk "Thank you for walking me home, [player_name!t]."
    ADARA @ talk "Gracias por acompañarme a casa, [player_name!t]."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:245
translate es ev_KrishanaDay_regina_dialogue_menu_cf81e8c8:

    # MC @ smile "Anytime, Adara."
    MC @ smile "Cuando quieras, Adara."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:248
translate es ev_KrishanaDay_regina_dialogue_menu_12bba5cb:

    # MC @ lewd "And uhh, I hope you had a nice time today."
    MC @ lewd "Y uhh, espero que lo hayas pasado bien hoy."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:249
translate es ev_KrishanaDay_regina_dialogue_menu_9feb8b98:

    # ADARA @ joy "M-Mmm, I did..."
    ADARA @ joy "M-Mmm, lo hice..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:248
translate es ev_KrishanaDay_regina_dialogue_menu_c660c009:

    # "The two of us paused awkwardly for a moment, not knowing what to say to each other other."
    "Los dos nos detuvimos incómodos un momento, sin saber qué decirnos."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:251
translate es ev_KrishanaDay_regina_dialogue_menu_2a09e3c5:

    # MC @ think "Is... Your father not home?"
    MC @ think "¿Está... tu padre no está en casa?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:250
translate es ev_KrishanaDay_regina_dialogue_menu_b951f8e6:

    # ADARA @ talk "He's probably resting right now ... He gets tired quite easily these days."
    ADARA @ talk "Probablemente esté descansando ahora mismo... Se cansa con bastante facilidad en estos días."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:251
translate es ev_KrishanaDay_regina_dialogue_menu_755359e9:

    # MC @ talk "Ah, of course."
    MC @ talk "Ah, claro."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:254
translate es ev_KrishanaDay_regina_dialogue_menu_956ad2ae:

    # ADARA @ shame "..."
    ADARA @ shame "..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:256
translate es ev_KrishanaDay_regina_dialogue_menu_5a3c4ad1:

    # MC @ surprised "...I should, um, probably get going."
    MC @ surprised "...yo probablemente um, debería irme."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:257
translate es ev_KrishanaDay_regina_dialogue_menu_11f2acbe:

    # MC @ smile2 "Markus is going to wonder where I am."
    MC @ smile2 "Markus se preguntará dónde estoy."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:258
translate es ev_KrishanaDay_regina_dialogue_menu_6440fcc8:

    # ADARA @ shame "R-Right, of course."
    ADARA @ shame "C-Claro, por supuesto."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:258
translate es ev_KrishanaDay_regina_dialogue_menu_3685d847:

    # "As I turned to leave, suddenly-"
    "Mientras me daba la vuelta para irme, de repente-"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:263
translate es ev_KrishanaDay_regina_dialogue_menu_86744dd1:

    # ADARA @ shock "[player_name!t]! Wait!"
    ADARA @ shock "¡[player_name!t]! ¡Espera!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:264
translate es ev_KrishanaDay_regina_dialogue_menu_e38e6b0c:

    # "Adara forward into my arms to hug me."
    "Adara se echó a mis brazos para abrazarme."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:265
translate es ev_KrishanaDay_regina_dialogue_menu_09a39d6b:

    # ADARA "...Can you come back here tonight when you're finished with Markus?"
    ADARA "...¿Puedes volver aquí esta noche cuando termines con Markus?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:268
translate es ev_KrishanaDay_regina_dialogue_menu_058d82e7:

