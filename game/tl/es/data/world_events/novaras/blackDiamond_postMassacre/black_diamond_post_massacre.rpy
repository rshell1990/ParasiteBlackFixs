

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:18
translate es black_diamond_post_massacre_lock_line_08dfb548:

    # MC "(I better stay away from there for now... Not with all those guards and inquisitors walking about.)"
    MC "(Será mejor que me mantenga alejado de aquí por ahora... No con todos esos guardias e inquisidores caminando por ahí)."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:27
translate es black_diamond_post_massacre_52eb92a1:

    # ERIKA @ talk "Bring in more Guards to patrol the grounds and keep the crowds at bay while we deal with the investigation inside."
    ERIKA @ talk "Trae más guardias para patrullar el recinto y mantener a raya a la multitud mientras nos ocupamos de la investigación en el interior."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:28
translate es black_diamond_post_massacre_23e32270:

    # ERIKA @ talk "Last thing we need is the public seeing the bloodbath in there."
    ERIKA @ talk "Lo último que necesitamos es que el público vea el baño de sangre que hay ahí dentro."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:29
translate es black_diamond_post_massacre_5be6026b:

    # GUARD "Yes ma'am."
    GUARD "Sí, señora."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:31
translate es black_diamond_post_massacre_0d866bc3:

    # MC @ smile "...Erika?"
    MC @ smile "...¿Erika?"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:37
translate es black_diamond_post_massacre_b4b4fd2c:

    # ERIKA @ surp "[player_name!t]?"
    ERIKA @ surp "¿[player_name!t]?"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:38
translate es black_diamond_post_massacre_9cbc99a2:

    # ERIKA @ surp "Is that you?"
    ERIKA @ surp "¿Eres tú?"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:39
translate es black_diamond_post_massacre_96ad254b:

    # ERIKA @ sad "I... I had heard what had happened, I thought-"
    ERIKA @ sad "Yo... Yo había oído lo que había pasado, pensé-"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:40
translate es black_diamond_post_massacre_290894a8:

    # "For a moment Erika seemed like she might leap into my arms and hug me, but as she looked around at the many glaring eyes of inquisitors watching her, she stopped herself."
    "Por un momento, Erika pareció que iba a saltar a mis brazos y abrazarme, pero al mirar a su alrededor y ver los ojos de los inquisidores que la observaban, se detuvo."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:41
translate es black_diamond_post_massacre_63a7fdb2:

    # ERIKA @ surp "You look so... {i}different.{/i}"
    ERIKA @ surp "Te ves tan... {i}diferente.{/i}"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:42
translate es black_diamond_post_massacre_b0160248:

    # MC @ talk "A lot has changed..."
    MC @ talk "Han cambiado muchas cosas..."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:43
translate es black_diamond_post_massacre_ba0a9af0:

    # MC @ talk "What happened here?"
    MC @ talk "¿Qué ha pasado aquí?"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:44
translate es black_diamond_post_massacre_f77bc7b3:

    # MC "(Hopefully she nor the other inquisitors suspect anything about what me and Markus did.)"
    MC "(Espero que ni ella ni los otros inquisidores sospechen nada de lo que hicimos Markus y yo)."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:45
translate es black_diamond_post_massacre_33b32f2d:

    # ERIKA @ talk "I can't really talk about it, but in a few days I will try come home."
    ERIKA @ talk "No puedo hablar de ello, pero dentro de unos días intentaré pasarme por casa."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:46
translate es black_diamond_post_massacre_c6370dca:

    # ERIKA @ smile "Then you and I no doubt have much to discuss."
    ERIKA @ smile "Entonces tú y yo sin duda tenemos mucho que hablar."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:47
translate es black_diamond_post_massacre_9992e569:

    # MC @ smile "That sounds good, Erika."
    MC @ smile "Me parece bien, Erika."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:48
translate es black_diamond_post_massacre_683aab95:

    # MC @ talk "...I've missed you a lot."
    MC @ talk "...Te he echado mucho de menos."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:49
translate es black_diamond_post_massacre_1821d3a0:

    # ERIKA @ sad "I-"
    ERIKA @ sad "Yo-"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:50
translate es black_diamond_post_massacre_9506ca46:

    # "Erika's name was called by what seemed to be an older, senior inquisitor."
    "El nombre de Erika fue pronunciado por lo que parecía ser un inquisidor veterano."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:51
translate es black_diamond_post_massacre_635cc6db:

    # ERIKA @ talk "I have to go."
    ERIKA @ talk "Tengo que irme."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:52
translate es black_diamond_post_massacre_c40b150b:

    # ERIKA @ talk "We shall speak once I am done with my work."
    ERIKA @ talk "Hablaremos cuando termine mi trabajo."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:53
translate es black_diamond_post_massacre_d007e9ec:

    # "I nodded as Erika left to join the others."
    "Asentí con la cabeza mientras Erika se marchaba para reunirse con los demás."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:55
translate es black_diamond_post_massacre_034bff31:

    # BLACK "{i}(Danger).{/i}"
    BLACK "{i}(Peligro).{/i}"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:56
translate es black_diamond_post_massacre_319c628c:

    # MC "(Erika isn't a threat, she wouldn't betray us if she found out.)"
    MC "(Erika no es una amenaza, no nos traicionaría si se enterara)."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:57
translate es black_diamond_post_massacre_42a5e8e1:

    # BLACK "{i}(You cannot be sure where her allegiance lies more).{/i}"
    BLACK "{i}(No puedes estar seguro su lealtad).{/i}"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:58
translate es black_diamond_post_massacre_f488b6bf:

    # MC "(...She will not find out anyway, it will be better this way for everyone.)"
    MC "(...Ella no se enterará de todos modos, será mejor así para todos)."

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:59
translate es black_diamond_post_massacre_2d412fd3:

    # BLACK "{i}(Then you more doubts about her than you admit).{/i}"
    BLACK "{i}(Entonces tienes más dudas sobre ella de las que admites).{/i}"

# game/data/world_events/novaras/blackDiamond_postMassacre/black_diamond_post_massacre.rpy:60
translate es black_diamond_post_massacre_5cc5173a:

    # MC "(...)"
    MC "(...)"
