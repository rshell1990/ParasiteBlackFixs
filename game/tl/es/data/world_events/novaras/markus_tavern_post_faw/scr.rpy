    MC "¡Pero aún no he terminado mi bebida!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:222
translate es act1scene8_menu2_7bc04d08:

    # MARKUS @ smile "Come on, there's only so much time you can spend drinking."
    MARKUS @ smile "Vamos, no puedes pasar mucho tiempo bebiendo."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:223
translate es act1scene8_menu2_73129eef:

    # MARKUS @ smile "We've got the whole world to take on!"
    MARKUS @ smile "¡Tenemos que enfrentarnos al mundo entero!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:224
translate es act1scene8_menu2_2719a439:

    # MC "You're drunk!"
    MC "¡Estás borracho!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:225
translate es act1scene8_menu2_90df7a50:

    # MARKUS "So what? Doesn't change the fact!"
    MARKUS "¿Y qué? No cambia el hecho."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:226
translate es act1scene8_menu2_1578ccda:

    # "I looked at the half-finished drink drink and nodded:"
    "Miré la copa a medio terminar y asentí:"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:227
translate es act1scene8_menu2_bb3528f6:

    # MC "You know what, you're right. Let's go."
    MC "Sabes qué, tienes razón. Vámonos."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:229
translate es act1scene8_menu2_7e63298a:

    # "As we walked out of the tavern, I thought that perhaps Markus was right."
    "Mientras salíamos de la taberna, pensé que quizá Markus tenía razón."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:230
translate es act1scene8_menu2_8382c345:

    # "Perhaps the worst truly was behind us."
    "Quizá lo peor ya había pasado."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:232
translate es act1scene8_menu2_44557c51:

    # "But some part of me could not shake the feeling that this was only the beginning."
    "Pero una parte de mí no podía deshacerse de la sensación de que esto era solo el comienzo."

translate es strings:

    # game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:53
    old "What about the war?"
    new "¿Qué pasa con la guerra?"

    # game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:53
    old "We should try do some research into these... {i}things.{/i}"
    new "Deberíamos intentar investigar un poco sobre estas... {i}cosas.{/i}"

    # game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:53
    old "If you say so."
    new "Si tú lo dices."

    # game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:106
    old "...What if we lose though?"
    new "...¿Sin embargo y si perdemos?"

    # game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:106
    old "These {i}things{/i} inside of us... They may be the key to winning this war."
    new "Estas {i}cosas{/i} dentro de nosotros... pueden ser la clave para ganar esta guerra."

    # game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:106
    old "You're right, I'm done thinking about the war."
    new "Tienes razón, me cansé de pensar en la guerra."

    # game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:106
    old "Alright, if you say so..."
    new "Está bien, si tú lo dices..."
