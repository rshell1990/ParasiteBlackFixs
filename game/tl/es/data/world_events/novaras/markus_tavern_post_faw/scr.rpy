

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:4
translate es ev_markus_tavern_14742abf:

    # "Approaching the tavern, I suddenly caught the scent of a strange aroma, like wildflowers that made me stop and turn to look around."
    "Al acercarme a la taberna, de repente percibí un aroma extraño, como de flores silvestres, que me hizo detenerme y girarme para mirar a mi alrededor."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:5
translate es ev_markus_tavern_5d368305:

    # BLACK "{i}Mate... A good potential mate is near...{/i}"
    BLACK "{i}Compañera... Una buena compañera potencial está cerca...{/i}"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:7
translate es ev_markus_tavern_86a5ea2e:

    # "Looking around, I once again took a deep breath, and my eyes naturally drew the beauty heading in the opposite direction of me."
    "Miré a mi alrededor, respiré profundamente una vez más y mis ojos naturalmente atrajeron la belleza que se dirigía en dirección opuesta a mí."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:8
translate es ev_markus_tavern_f19d39bc:

    # "Aristocratic, she wore a beautiful blue dress and bonnet hat that elegantly conveyed a sense of class and sensuality."
    "De carácter aristocrático, llevaba un precioso vestido azul y un sombrero con cofia que transmitía con elegancia una sensación de clase y sensualidad."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:9
translate es ev_markus_tavern_544fac9c:

    # "Her face was soft, with long auburn brown hair that flowed with some of the bluest eyes I'd ever seen."
    "Su rostro era suave, con un largo cabello castaño rojizo que caía sobre unos de los ojos más azules que jamás había visto."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:11
translate es ev_markus_tavern_3c0eb2fc:

    # BLACK "(We should follow her...)"
    BLACK "(Deberíamos seguirla...)"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:12
translate es ev_markus_tavern_7f781590:

    # MC "(I... No, I have to meet Markus.)"
    MC "(Yo... No, tengo que encontrarme con Markus)."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:14
translate es ev_markus_tavern_f5c76856:

    # MC "(I need to stay focused on things... talk to him first before anything else.)"
    MC "(Necesito concentrarme en las cosas... hablar con él primero antes de cualquier otra cosa)."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:15
translate es ev_markus_tavern_56f195ef:

    # BLACK "(I will keep her scent for as long as I can to track her...)"
    BLACK "(Mantendré su olor tanto tiempo como pueda para rastrearla...)"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:16
translate es ev_markus_tavern_ddc022fb:

    # MC "(You can do that?)"
    MC "(¿Puedes hacer eso?)"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:17
translate es ev_markus_tavern_d33bd2a7:

    # BLACK "(Of course, there are many things you will have to learn.)"
    BLACK "(Por supuesto, hay muchas cosas que tendrás que aprender)."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:18
translate es ev_markus_tavern_5cc5173a:

    # MC "(...)"
    MC "(...)"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:24
translate es ev_markus_tavern_e483daf6:

    # MARKUS @ smile "Ah! [player_name!t]! There you are..." 
    MARKUS @ smile "¡Ah! ¡[player_name!t]! Ahí estás..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:25
translate es ev_markus_tavern_59fae255:

    # MARKUS "Over here, I have a table for us."
    MARKUS "Por aquí, tengo una mesa para nosotros."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:28
translate es ev_markus_tavern_391745f2:

    # "Sitting at the table with Markus, we ordered a round of Ale over and sat back talking about the things that had happened."
    "Sentandome a la mesa con Markus, pedimos una ronda de cerveza y nos sentamos a hablar sobre las cosas que habían sucedido."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:29
translate es ev_markus_tavern_3a3ca78b:

    # "Markus seemed jovial, elated even with everything going on, grinning merrily as he talked about his plans for the future, whereas I remained much more... {i}reserved.{/i}"
    "Markus parecía jovial, eufórico incluso con todo lo que estaba pasando, sonriendo alegremente mientras hablaba de sus planes para el futuro, mientras que yo permanecí mucho más... {i}reservado.{/i}"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:33
translate es ev_markus_tavern_3698ef44:

    # MARKUS @ sad "[player_name!t], why the long face?"
    MARKUS @ sad "[player_name!t], ¿por qué la cara larga?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:37
translate es ev_markus_tavern_bd1d77d0:

    # MARKUS @ smile "This is perfect for us!"
    MARKUS @ smile "¡Esto es perfecto para nosotros!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:35
translate es ev_markus_tavern_1ba1cd79:

    # MARKUS "All we need to do is write a few speeches, smile and wave at some drunks in a tavern or two and make sure to visit a brothel once or twice in the meanwhile!"
    MARKUS "¡Todo lo que tenemos que hacer es escribir algunos discursos, sonreír y saludar a algunos borrachos en una o dos tabernas y asegurarnos de visitar un burdel una o dos veces mientras tanto!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:39
translate es ev_markus_tavern_ae75d1f4:

    # MC @ talk "Somehow, I don't think everything is going to be quite as easy as you think."
    MC @ talk "De alguna manera, no creo que todo vaya a ser tan fácil como piensas."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:40
translate es ev_markus_tavern_54702566:

    # MARKUS @ angry "You over worry."
    MARKUS @ angry "Te preocupas demasiado."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:41
translate es ev_markus_tavern_e9f73ef7:

    # MC @ talk "And you don't worry enough."
    MC @ talk "Y tú no te preocupas lo suficiente."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:42
translate es ev_markus_tavern_e49e0a40:

    # MARKUS @ angry "Bah!"
    MARKUS @ angry "¡Bah!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:43
translate es ev_markus_tavern_053903ef:

    # MC @ talk "Markus, we hardly know anything about what's happened to us aside from what we've been told."
    MC @ talk "Markus, no sabemos casi nada de lo que nos ha pasado aparte de lo que nos han contado."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:41
translate es ev_markus_tavern_fceb992d:

    # MARKUS "What more do you need to know?"
    MARKUS "¿Qué más necesitas saber?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:42
translate es ev_markus_tavern_f355bdbb:

    # MARKUS "They made the rules fairly clear friend, and quite frankly, I'm looking forward to {i}finally{/i} having things easy for a while."
    MARKUS "Dejaron las reglas bastante claras amigo, y francamente, espero poder {i}finalmente{/i} tener las cosas fáciles por un tiempo."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:46
translate es ev_markus_tavern_c3f06f55:

    # MC @ talk "Will it be easy though Markus, {i}will it really?{/i}"
    MC @ talk "¿Será fácil, Markus?, {i}¿realmente lo será?{/i}"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:47
translate es ev_markus_tavern_b25bf2ac:

    # MARKUS "{i}*Sigh*{/i}"
    MARKUS "{i}*Suspiro*{/i}"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:48
translate es ev_markus_tavern_3b37031c:

    # "Markus pulled a sympathetic face, leaning closer towards me."
    "Markus puso una cara comprensiva y se inclinó más cerca de mí."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:49
translate es ev_markus_tavern_29dedb3b:

    # MARKUS @ sad "{i}Haven't we been through enough already?{/i}"
    MARKUS @ sad "{i}¿No hemos pasado ya por suficiente?{/i}"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:47
translate es ev_markus_tavern_a350546d:

    # MARKUS "Okay, things didn't exactly work out like we planned but..."
    MARKUS "Bueno, las cosas no salieron exactamente como lo habíamos planeado, pero..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:48
translate es ev_markus_tavern_301a5089:

    # MARKUS @ smile "This is our chance [player_name!t], we can make something good with this."
    MARKUS @ smile "Esta es nuestra oportunidad [player_name!t], podemos hacer algo bueno con esto."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:52
translate es act1scene8_menu_3e3a04a9:

    # MARKUS "What about it?"
    MARKUS "¿Qué pasa con eso?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:56
translate es act1scene8_menu_18283bb2:

    # MARKUS @ angry "We did our part, we nearly {i}fucking died{/i} doing our part."
    MARKUS @ angry "Hicimos nuestra parte, {i}casi morimos{/i} haciendo nuestra parte."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:54
translate es act1scene8_menu_cc4c4b12:

    # MARKUS "What more can they ask?"
    MARKUS "¿Qué más pueden pedir?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:59
translate es act1scene8_menu_6b3c3a5f:

    # MARKUS "I don't think we're going to have much luck there, these... {i}'things'{/i} aren't in any book I've read."
    MARKUS "No creo que tengamos mucha suerte, estas... {i}'cosas'{/i} no están en ningún libro que haya leído"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:60
translate es act1scene8_menu_ef6be862:

    # MARKUS "And it's too much of a risk to talk to someone about all this."
    MARKUS "Y es demasiado arriesgado hablar con alguien sobre todo esto."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:61
translate es act1scene8_menu_bfa7261f:

    # MARKUS "It only takes one wrong person blabbering and we'll find the inquisitors knocking on our doors."
    MARKUS "Solo hace falta que una persona equivocada parlotee y encontraremos a los inquisidores llamando a nuestras puertas."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:65
translate es act1scene8_menu_7e68f3ed:

    # "Taking a sip of my drink, I pondered in thought."
    "Tomando un sorbo de mi bebida, reflexioné un momento."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:66
translate es act1scene8_menu_a633c971:

    # MC @ talk "...That skeleton down in the caverns."
    MC @ talk "...Ese esqueleto allá abajo en las cavernas."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:64
translate es act1scene8_menu_e4805c34:

    # MARKUS "The mage?"
    MARKUS "¿El mago?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:68
translate es act1scene8_menu_ca48a8a6:

    # "Markus leaned forward to whisper the next words."
    "Markus se inclinó hacia delante para susurrar las siguientes palabras."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:66
translate es act1scene8_menu_fd965436:

    # MARKUS "{i}The dark mage?{/i}"
    MARKUS "{i}¿El mago oscuro?{/i}"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:70
translate es act1scene8_menu_2c8cee45:

    # MC @ talk "The letter said they were excavating those pillars."
    MC @ talk "La carta decía que estaban excavando esos pilares."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:68
translate es act1scene8_menu_97db8ee0:

    # MARKUS "...So?"
    MARKUS "...¿Entonces?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:72
translate es act1scene8_menu_6f48e853:

    # MC @ talk "Don't you remember the big hurry to get us out there?"
    MC @ talk "¿No recuerdas la gran prisa que había para sacarnos de allí?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:73
translate es act1scene8_menu_4f3400b3:

    # MARKUS "..."
    MARKUS "..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:74
translate es act1scene8_menu_ed9d5533:

    # MC @ talk "Markus, we were sent there to {i}recover{/i} these things."
    MC @ talk "Markus, nos enviaron allí para {i}recuperar{/i} estas cosas."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:72
translate es act1scene8_menu_d74b6226:

    # MARKUS "Well... Mission bloody accomplished I guess."
    MARKUS "Bueno... misión jodidamente cumplida, supongo."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:76
translate es act1scene8_menu_97da4cce:

    # MC @ angry "No, idiot! Don't you see?"
    MC @ angry "¡No, idiota! ¿No lo ves?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:77
translate es act1scene8_menu_064713d7:

    # MC @ talk "That means {i}someone{/i} somewhere still knows about these things."
    MC @ talk "Eso significa que {i}alguien{/i} en algún lugar todavía sabe sobre estas cosas."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:78
translate es act1scene8_menu_4f3400b3_1:

    # MARKUS "..."
    MARKUS "..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:79
translate es act1scene8_menu_2cf2700a:

    # MC @ talk "And if they don't assume they were lost during the battle, they'll be looking for them."
    MC @ talk "Y si no asumen que se perdieron durante la batalla, los buscarán."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:77
translate es act1scene8_menu_2519b1d2:

    # MARKUS @ shock "{i}...You think someone's after us?{/i}"
    MARKUS @ shock "{i}...¿Crees que alguien está detrás de nosotros?{/i}"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:81
translate es act1scene8_menu_231d56ef:

    # MC @ talk "I don't know, maybe?"
    MC @ talk "No lo sé, ¿quizás?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:82
translate es act1scene8_menu_d794d778:

    # MC @ talk "{i}We were{/i} the only survivors..."
    MC @ talk "{i}Nosotros fuimos{/i}  los únicos sobrevivientes..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:83
translate es act1scene8_menu_34432b32:

    # MC @ talk "If I was {i}them,{/i} I'd look for us."
    MC @ talk "Si yo fuera {i}ellos,{/i} nos buscaría."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:84
translate es act1scene8_menu_d578b222:

    # "Markus seemed to ponder the thought for a moment, and we both were awkwardly silent till Markus finally asked:"
    "Markus pareció reflexionar por un momento, y ambos nos quedamos en un silencio incómodo hasta que finalmente Markus preguntó:"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:82
translate es act1scene8_menu_8a0ce398:

    # MARKUS "Alright... Then tell me this, why haven't they already?"
    MARKUS "Muy bien... entonces dime esto, ¿por qué no lo han hecho ya?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:86
translate es act1scene8_menu_bf1a78a6:

    # MC @ talk "Hm?"
    MC @ talk "¿Hm?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:87
translate es act1scene8_menu_7b79cb54:

    # MARKUS @ sad "If they know about our 'gifts' and know about us, why haven't we been arrested by inquisitors already?"
    MARKUS @ sad "Si saben de nuestros 'dones' y saben de nosotros, ¿por qué no nos han arrestado ya los inquisidores?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:88
translate es act1scene8_menu_1ab560af:

    # MC @ talk "Good question."
    MC @ talk "Buena pregunta."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:89
translate es act1scene8_menu_094dccc2:

    # MC @ sad "I don't know."
    MC @ sad "No lo sé."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:90
translate es act1scene8_menu_0b75be23:

    # "Markus smirked and sipped his drink."
    "Markus sonrió y bebió un sorbo de su bebida.."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:91
translate es act1scene8_menu_397f68f7:

    # MARKUS @ joy "See? You're always over-thinking."
    MARKUS @ joy "¿Ves? Siempre estás pensando demasiado."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:89
translate es act1scene8_menu_89f856d2:

    # MARKUS "That place was all bones and ruin... Whoever set it up is probably just like that mage you found, dead and gone."
    MARKUS "Ese lugar era todo huesos y ruinas... Quien lo puso ahí probablemente sea igual que ese mago que encontraste, muerto y desaparecido."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:93
translate es act1scene8_menu_cfcd1b36:

    # MC @ talk "Then why the sudden push for us to go there?"
    MC @ talk "¿Por qué entonces ese impulso repentino para que vayamos allí?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:91
translate es act1scene8_menu_60fe80b3:

    # MARKUS "Who knows! Maybe someone who knew someone heard there was weapons there or important information."
    MARKUS "¡Quién sabe! Quizá alguien que conocía a alguien se enteró de que allí había armas o información importante."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:92
translate es act1scene8_menu_81b4cae8:

    # MARKUS "Maybe they wanted the place retaken for strategic reasons, maybe a hundred other possible reasons!"
    MARKUS "Quizás querían recuperar el lugar por razones estratégicas, ¡quizás por cientos de otras posibles razones!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:96
translate es act1scene8_menu_8418a966:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:94
translate es act1scene8_menu_82dac1d1:

    # MARKUS @ sad "[player_name!t], don't go chasing shadows."
    MARKUS @ sad "[player_name!t], no vayas persiguiendo fantasmas."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:98
translate es act1scene8_menu_2768b216:

    # MARKUS @ smile "Unless we're given a reason to be worried, I'm not going to be."
    MARKUS @ smile "A menos que nos den una razón para estar preocupados, no lo estaré."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:103
translate es act1scene8_menu_cd202ec0:

    # MARKUS @ smile "See? Everything will work out."
    MARKUS @ smile "¿Ves? Todo saldrá bien."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:101
translate es act1scene8_menu_5bac0092:

    # MARKUS "You just need to relax, {i}our{/i} war is over."
    MARKUS "Solo necesitas relajarte, {i}nuestra{/i} guerra ha terminado."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:108
translate es act1scene8_menu2_b56d841c:

    # MARKUS @ sad "What?"
    MARKUS @ sad "¿Qué?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:109
translate es act1scene8_menu2_0d809304:

    # MC @ talk "What if things take a turn for the worst Markus?"
    MC @ talk "¿Qué pasa si las cosas empeoran, Markus?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:110
translate es act1scene8_menu2_fbcbd5dc:

    # MC @ talk "What {i}if{/i} the Demorai push us back and it looks-"
    MC @ talk "¿Y {i}si{/i} los Demorai nos hacen retroceder y parece-"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:111
translate es act1scene8_menu2_cbaea7ad:

    # MARKUS @ sad "That won't happen for years even if it does."
    MARKUS @ sad "Eso no sucederá durante años, incluso si sucede."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:112
translate es act1scene8_menu2_21198188:

    # MC @ talk "But what happens if it does? What if we settle down, have families and those things are clawing at our doors and it's all too late because we did nothing now?"
    MC @ talk "Pero ¿qué pasa si así es? ¿Qué pasa si nos establecemos, formamos una familia y esas cosas nos están acosando y ya es demasiado tarde porque no hemos hecho nada ahora?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:113
translate es act1scene8_menu2_38a5e93a:

    # MARKUS @ angry "Then we'll fight, or we'll flee when the time comes..."
    MARKUS @ angry "Entonces lucharemos, o huiremos cuando llegue el momento..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:111
translate es act1scene8_menu2_3cefcf26:

    # MARKUS "[player_name!t] please, this is all hypotheticals and I'd rather just change the topic..."
    MARKUS "[player_name!t] por favor, todo esto son hipótesis y prefiero cambiar de tema..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:115
translate es act1scene8_menu2_20910c7f:

    # MARKUS "Ha!"
    MARKUS "¡Ja!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:119
translate es act1scene8_menu2_ae7c2b09:

    # MARKUS @ angry "Thanks but, I just left one battlefield littered with bodies and don't really need to see another."
    MARKUS @ angry "Gracias, pero acabo de dejar un campo de batalla lleno de cadáveres y realmente no necesito ver otro."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:120
translate es act1scene8_menu2_a332a083:

