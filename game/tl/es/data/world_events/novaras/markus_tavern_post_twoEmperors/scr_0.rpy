translate es ev_Markus_tavern_postTwoEmps_18e24e75:

    # MARKUS @ smile "That's the spirit! I'll be right back!"
    MARKUS @ smile "¡Esa es la actitud! ¡Vuelvo enseguida!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:99
translate es ev_Markus_tavern_postTwoEmps_138083ce:

    # "As Markus did his best to fight his way over to order some drinks, Adara moved closer to me."
    "Mientras Markus hacía lo posible por abrirse paso para pedir unas bebidas, Adara se acercó a mí."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:102
translate es ev_Markus_tavern_postTwoEmps_95db9b8e:

    # ADARA @ sad "Are you okay?"
    ADARA @ sad "¿Estás bien?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:103
translate es ev_Markus_tavern_postTwoEmps_0a7f8a9b:

    # MC @ talk "I'm fine, Adara."
    MC @ talk "Estoy bien, Adara."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:104
translate es ev_Markus_tavern_postTwoEmps_3796113b:

    # MC @ smile "It's good to see you."
    MC @ smile "Me alegro de verte."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:105
translate es ev_Markus_tavern_postTwoEmps_885013fd:

    # ADARA @ sad "If... If something happened and you want to talk about it."
    ADARA @ sad "Si... Si ha pasado algo y quieres hablar de ello."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:106
translate es ev_Markus_tavern_postTwoEmps_a42160e3:

    # ADARA @ sad "We can go somewhere private if you want..."
    ADARA @ sad "Podemos ir a algún sitio privado si quieres..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:107
translate es ev_Markus_tavern_postTwoEmps_68c4b9a6:

    # MC @ sad "No, Adara... I-"
    MC @ sad "No, Adara... yo-"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:112
translate es ev_Markus_tavern_postTwoEmps_32221592:

    # "Suddenly, between the heaving crowds, something caught my eye."
    "De repente, entre la multitud, algo me llamó la atención."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:113
translate es ev_Markus_tavern_postTwoEmps_8d8d34bc:

    # "A robed figure amongst them, staring right at me."
    "Una figura cubierta por una túnica entre ellos, mirándome fijamente."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:114
translate es ev_Markus_tavern_postTwoEmps_9b476c08:

    # "Sypha's words rung through me ear of her sending an 'agent' to make contact with us, and I rose quickly to my feet, much to Adara's surprise."
