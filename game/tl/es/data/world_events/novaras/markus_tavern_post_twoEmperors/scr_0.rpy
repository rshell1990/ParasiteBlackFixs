    # MARKUS "Anyway, how did it go after with Officer Lukkan?"
    MARKUS "De todos modos, ¿cómo fue con el oficial Lukkan?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:19
translate es ev_Markus_tavern_postTwoEmps_5d226a8a:

    # MC @ talk "Well... About that..."
    MC @ talk "Bueno... sobre eso..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:23
translate es ev_Markus_tavern_postTwoEmps_313f6245:

    # MARKUS @ shock "...Y-You're joking, right?"
    MARKUS @ shock "...E-estás bromeando, ¿verdad?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:28
translate es ev_Markus_tavern_postTwoEmps_1f2d9a15:

    # "Markus' confusion and shock soon turned to frustration, and then finally anger."
    "La confusión y la conmoción de Markus pronto se transformaron en frustración y, finalmente, en ira."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:29
translate es ev_Markus_tavern_postTwoEmps_6e3b82dd:

    # MARKUS @ angry "Those fucking bastards!"
    MARKUS @ angry "¡Esos malditos bastardos!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:30
translate es ev_Markus_tavern_postTwoEmps_4a7d71c0:

    # MARKUS @ sad "All these years..."
    MARKUS @ sad "Todos esos años..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:31
translate es ev_Markus_tavern_postTwoEmps_4784b9d3:

    # MARKUS @ angry "Nothing but lies!"
    MARKUS @ angry "¡Nada más que mentiras!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:32
translate es ev_Markus_tavern_postTwoEmps_17b31c2a:

    # MC @ talk "We've always known we were being lied to about certain things."
    MC @ talk "Siempre supimos que nos estaban mintiendo sobre ciertas cosas."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:33
translate es ev_Markus_tavern_postTwoEmps_b12d1541:

    # MARKUS @ angry "Not this! Not fucking this!"
    MARKUS @ angry "¡Esto no! ¡Esto no, joder!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:30
translate es ev_Markus_tavern_postTwoEmps_95a99166:

    # MARKUS "Surely you can't agree with what they've done?"
    MARKUS "¿Seguramente no puedes estar de acuerdo con lo que han hecho?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:37
translate es ev_Markus_tavern_postTwoEmps_c399b696:

    # MARKUS @ angry "What? How can you say that!"
    MARKUS @ angry "¿Qué? ¡¿Cómo puedes decir eso?!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:38
translate es ev_Markus_tavern_postTwoEmps_a2cc5969:

    # MC @ talk "What does it really change?"
    MC @ talk "¿Qué cambia realmente?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:39
translate es ev_Markus_tavern_postTwoEmps_329e2755:

    # MC @ talk "If the Demorai really aren't willing to stop, should people really know?"
    MC @ talk "Si los Demorai realmente no están dispuestos a parar, ¿debería la gente saberlo?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:40
translate es ev_Markus_tavern_postTwoEmps_6fc25b58:

    # MC @ talk "I mean, doesn't it make it {i}easier{/i} to fight them thinking they really are just savage beasts?"
    MC @ talk "Quiero decir, ¿no es {i}más fácil{/i} luchar contra ellos pensando que realmente son solo bestias salvajes?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:41
translate es ev_Markus_tavern_postTwoEmps_034b71f7:

    # MC @ talk "Do {i}you{/i} really want to be thinking every time we have fight one of those things about who they are?"
    MC @ talk "¿De verdad {i}tú{/i} quieres estar pensando cada vez que peleamos por una de esas cosas sobre quiénes son?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:42
translate es ev_Markus_tavern_postTwoEmps_0fa3928a:

    # MC @ talk "{i}Do they have families? Children and loved ones waiting at home like us? Do they mourn when their brothers and sisters fall?{/i}"
    MC @ talk "{i}¿Tienen familias? ¿Tienen hijos y seres queridos que esperan en casa como nosotros? ¿Lloran cuando sus hermanos y hermanas caen?{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:43
translate es ev_Markus_tavern_postTwoEmps_b1427ed4:

    # MC @ talk "Are those the kind of questions you really want to be putting in people's heads during a war?"
    MC @ talk "¿Esas son las clases de preguntas que realmente quieres poner en la cabeza de la gente durante una guerra?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:40
translate es ev_Markus_tavern_postTwoEmps_e33600fa:

    # MARKUS @ angry "We've been lied to since we were children, [player_name!t]."
    MARKUS @ angry "Nos han mentido desde que éramos niños, [player_name!t]."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:45
translate es ev_Markus_tavern_postTwoEmps_df78f4bd:

    # MARKUS @ angry "Who knows what else they've been keeping from us."
    MARKUS @ angry "Quién sabe qué más nos han estado ocultando."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:47
translate es ev_Markus_tavern_postTwoEmps_f0f60350:

    # MC @ talk "That Demorai... That girl back in those ruins, Sypha."
    MC @ talk "Esa Demorai... Esa chica en esas ruinas, Sypha.."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:49
translate es ev_Markus_tavern_postTwoEmps_40666aed:

    # MC @ talk "She led us out safely like she said she would."
    MC @ talk "Ella nos sacó con seguridad tal como dijo que lo haría."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:50
translate es ev_Markus_tavern_postTwoEmps_0750dbb7:

    # MC @ talk "AND she showed a willingness to work together... That means there has to be hope for other Demorai to do the same."
    MC @ talk "Y ella mostró voluntad de trabajar juntos... Eso significa que debe haber esperanza para que otros Demorai hagan lo mismo."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:52
translate es ev_Markus_tavern_postTwoEmps_4f5c25bc:

    # MC @ talk "She tried to help us and... We didn't listen."
    MC @ talk "Ella trató de ayudarnos y... no la escuchamos."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:53
translate es ev_Markus_tavern_postTwoEmps_e7a5d09d:

    # MC @ talk "{i}She was telling the truth.{/i}"
    MC @ talk "{i}Ella estaba diciendo la verdad.{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:54
translate es ev_Markus_tavern_postTwoEmps_b4a91270:

    # MC @ talk "If we can't keep our minds open at all to even the {i}possibility{/i} of negotiations or peace, we rule them out entirely before they have a chance."
    MC @ talk "Si no podemos mantener nuestras mentes abiertas siquiera a la {i}posibilidad{/i} de negociaciones o de paz, las descartamos por completo antes de que tengan una oportunidad."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:51
translate es ev_Markus_tavern_postTwoEmps_02222f86:

    # MARKUS "So, you {i}do{/i} think there's a chance for peace talks?"
    MARKUS "Entonces, ¿crees que {i}hay{/i} una posibilidad de conversaciones de paz?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:56
translate es ev_Markus_tavern_postTwoEmps_4b8ffdf3:

    # MC @ talk "Not with any of the current leadership on both sides it seems..."
    MC @ talk "Al parecer, no con ninguno de los líderes actuales de ambos lados..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:57
translate es ev_Markus_tavern_postTwoEmps_2b1192e5:

    # MC @ talk "But there are parties {i}within both camps{/i} who probably would be willing to talk."
    MC @ talk "Pero hay grupos {i}dentro de ambos bandos{/i} que probablemente estarían dispuestos a dialogar."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:54
translate es ev_Markus_tavern_postTwoEmps_2e542c81:

    # MARKUS "Hmm... I'm mad about being lied to, but-"
    MARKUS "Hmm... me molesta que me hayan mentido, pero-"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:55
translate es ev_Markus_tavern_postTwoEmps_bf69bc6c:

    # MARKUS "I'm not so sure if I like the idea of negotiations with those {i}'things'{/i} after everything they've done."
    MARKUS "No estoy tan seguro de si me gusta la idea de negociar con esas {i}'cosas'{/i} después de todo lo que han hecho."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:60
translate es ev_Markus_tavern_postTwoEmps_b25bf2ac:

    # MARKUS "{i}*Sigh*{/i}"
    MARKUS "{i}*Suspiro*{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:57
translate es ev_Markus_tavern_postTwoEmps_3ce1f6b0:

    # MARKUS "I guess none of this really matters though, right?"
    MARKUS "Supongo que nada de esto importa realmente, ¿verdad?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:58
translate es ev_Markus_tavern_postTwoEmps_d149b11e:

    # MARKUS "I mean, we're just two nobodies from the Adventurers Guild, so..."
    MARKUS "Quiero decir, solo somos dos don nadies del gremio de aventureros, así que..."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:59
translate es ev_Markus_tavern_postTwoEmps_08467006:

    # MARKUS "Its not like either of us are going to be making a real difference anytime soon."
    MARKUS "No es como si alguno de nosotros fuera a hacer una diferencia real en un futuro cercano."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:64
translate es ev_Markus_tavern_postTwoEmps_3488caf3:

    # "I couldn't help but feel slightly depressed at Markus' comment, he was of course, correct."
    "No pude evitar sentirme un poco deprimido ante el comentario de Markus, que por supuesto tenía razón."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:65
translate es ev_Markus_tavern_postTwoEmps_208e182d:

    # "Even with all this knowledge and revelations, what difference could we really make?"
    "Incluso con todo este conocimiento y revelaciones, ¿qué diferencia podríamos realmente hacer?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:66
translate es ev_Markus_tavern_postTwoEmps_cdea2e4d:

    # "Even with our dark gifts, there was a sense of real powerlessness that even after learning all we had, it changed nothing."
    "Incluso con nuestros dones oscuros, había una sensación de impotencia real porque, incluso después de aprender todo lo que teníamos, no cambiaba nada."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:67
translate es ev_Markus_tavern_postTwoEmps_e6bb031a:

    # MC @ sad "Yeah... I guess you're right."
    MC @ sad "Sí... supongo que tienes razón."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:68
translate es ev_Markus_tavern_postTwoEmps_d6316cc9:

    # MARKUS @ smile "...Hey, wanna get drunk and forget all this?"
    MARKUS @ smile "...Oye, ¿quieres emborracharte y olvidar todo esto?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:69
translate es ev_Markus_tavern_postTwoEmps_1bda44aa:

    # MC @ talk "{i}Absolutely.{/i}"
    MC @ talk "{i}Absolutamente.{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:71
translate es ev_Markus_tavern_postTwoEmps_ee8b9654:

    # "After a couple drinks, me and Markus managed to push what had learned aside as we enjoyed having a merry conversation while reminiscing once again."
    "Después de un par de bebidas, Markus y yo logramos dejar de lado lo que habíamos aprendido mientras disfrutábamos de una alegre conversación mientras recordabamos el pasado una vez más."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:72
translate es ev_Markus_tavern_postTwoEmps_31857223:

    # "The Tavern by now had begun to pick up, and soon the place was heaving with other patrons like us."
    "Para entonces la taberna había empezado a cobrar impulso y pronto el lugar estaba abarrotado de otros clientes como nosotros."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:79
translate es ev_Markus_tavern_postTwoEmps_90b6d8d2:

    # MARKUS @ smile "Haha! I almost forgot about that one!"
    MARKUS @ smile "¡Jaja! ¡Casi me olvido de eso"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:80
translate es ev_Markus_tavern_postTwoEmps_039915af:

    # MARKUS @ smile "Gods, whatever happened to Joana Tepeha?"
    MARKUS @ smile "Dioses, ¿qué pasó con Joana Tepeha?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:81
translate es ev_Markus_tavern_postTwoEmps_9115411d:

    # MARKUS @ smile "Did those two actually marry in the end?"
    MARKUS @ smile "¿Al final esos dos realmente se casaron?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:82
translate es ev_Markus_tavern_postTwoEmps_8aabdc78:

    # MC @ smile "I'm pretty sure the engagement was called off after {i}THAT{/i} and she headed off with her family to Borusmark in Skarshire."
    MC @ smile "Estoy bastante seguro de que el compromiso se canceló después de {i}ESO{/i} y ella se dirigió con su familia a Borusmark en Skarshire."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:85
translate es ev_Markus_tavern_postTwoEmps_7a4484c0:

    # ADARA @ smile "I see you two are enjoying yourselves."
    ADARA @ smile "Veo que os lo estáis pasando bien los dos."

