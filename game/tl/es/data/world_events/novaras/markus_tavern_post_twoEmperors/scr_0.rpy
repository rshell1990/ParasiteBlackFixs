    # MC @ talk "Huh? Have you not-"
    MC @ talk "¿Eh? ¿No has-"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:14
translate es ev_Markus_tavern_postTwoEmps_636345a2:

    # MARKUS "Yes, don't worry so much."
    MARKUS "Sí, no te preocupes tanto."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:15
