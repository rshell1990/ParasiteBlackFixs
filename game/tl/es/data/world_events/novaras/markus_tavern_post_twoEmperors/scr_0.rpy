    MARKUS @ smile "¿Dónde has estado?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:88
translate es ev_Markus_tavern_postTwoEmps_4fd49c32:

    # ADARA @ talk "Been busy between working and looking after father."
    ADARA @ talk "He estado ocupada entre trabajar y cuidar a mi padre."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:89
translate es ev_Markus_tavern_postTwoEmps_45400e55:

    # ADARA @ talk "Are you two celebrating something?"
    ADARA @ talk "¿Estáis celebrando algo"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:90
translate es ev_Markus_tavern_postTwoEmps_1813f22d:

    # MC @ talk "Uhh, not quite."
    MC @ talk "Uhh, no exactamente."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:91
translate es ev_Markus_tavern_postTwoEmps_c5655818:

    # MC @ talk "Just getting drunk after a... {i}difficult{/i} quest."
    MC @ talk "Simplemente nos estamos emborrachando después de una misión... {i}difícil{/i}."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:92
translate es ev_Markus_tavern_postTwoEmps_11ba5d0e:

    # ADARA @ sad "O-Oh... I'll leave you both be."
    ADARA @ sad "O-Oh... Os dejaré en paz."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:93
translate es ev_Markus_tavern_postTwoEmps_aea6a095:

    # ADARA @ talk "You probably don't want me ruining your night."
    ADARA @ talk "Probablemente no queréis que arruine vuestra noche."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:94
translate es ev_Markus_tavern_postTwoEmps_1817d2f9:

    # MARKUS @ smile "Nonsense, Adara!"
    MARKUS @ smile "¡Tonterías, Adara!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:88
translate es ev_Markus_tavern_postTwoEmps_60bf2b19:

    # MARKUS "I'm heading up to get another round, would you like one?"
    MARKUS "Voy a ir a buscar otra ronda, ¿quieres una?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:96
translate es ev_Markus_tavern_postTwoEmps_5b9ffa10:

    # ADARA @ talk "Umm, perhaps just {i}one{/i} drink won't hurt."
    ADARA @ talk "Umm, tal vez solo {i}una{/i} bebida no haga daño."

