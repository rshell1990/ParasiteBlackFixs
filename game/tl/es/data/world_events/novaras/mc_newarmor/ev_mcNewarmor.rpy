

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:24
translate es event_mc_newarmor_c445ccb1:

    # REGINA @ sad "[player_name!t]!"
    REGINA @ sad "¡[player_name!t]!" 

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:25
translate es event_mc_newarmor_ab431f6f:

    # "[regina_ref_cap!t] leapt onto me hugging me tightly when she saw me."
    "[regina_ref_cap!t] saltó sobre mí abrazándome con fuerza cuando me vio."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:24
translate es event_mc_newarmor_27802282:

    # "I struggled to pull away from her tight grip as I tried to calm her."
    "Luché por zafarme de su apretado agarre mientras intentaba calmarla."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:25
translate es event_mc_newarmor_cf02347d:

    # MC @ talk "Ahh! Careful!"
    MC @ talk "¡Ahh! ¡Cuidado!"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:26
translate es event_mc_newarmor_fdd3b5c9:

    # REGINA @ sad "What happened?"
    REGINA @ sad "¿Qué ha pasado?"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:27
translate es event_mc_newarmor_101035ab:

    # REGINA @ sad "I heard you were seen being carried off towards the doctors, then the next thing I knew, I was told you were fighting for your life!"
    REGINA @ sad "¡Oí que te llevaban hacia los médicos y, de repente, me dijeron que estabas luchando por tu vida!"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:30
translate es event_mc_newarmor_b1d7f9ea:

    # REGINA @ sad "I told you to be careful."
    REGINA @ sad "Te dije que tuvieras cuidado."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:31
translate es event_mc_newarmor_cc49f520:

    # REGINA @ angry "You need to listen to me more!"
    REGINA @ angry "¡Tienes que escucharme más!"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:34
translate es event_mc_newarmor_7d248de6:

    # REGINA @ sad "Being an Adventurer is dangerous [player_name!t]."
    REGINA @ sad "Ser un aventurero es peligroso [player_name!t]."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:34
translate es event_mc_newarmor_84cdfdb7:

    # REGINA @ sad "{i}*Sigh*{/i} Please be more careful."
    REGINA @ sad "{i}*Suspiro*{/i} Por favor, ten más cuidado."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:35
translate es event_mc_newarmor_651acbbd:

    # REGINA @ sad "I don't know what I would do with myself if something happened to you."
    REGINA @ sad "No sé qué haría si te pasara algo."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:36
translate es event_mc_newarmor_417f0ac4:

    # "The thought lingered for a moment on how close to death once again I truly had come."
    "Por un momento pensé en lo cerca que había estado de la muerte una vez más."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:37
translate es event_mc_newarmor_16180672:

    # "I had become perhaps too arrogant with my newfound powers."
    "Quizá me había vuelto demasiado arrogante con mis nuevos poderes."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:38
translate es event_mc_newarmor_98f0f479:

    # "Death as a prospect seemed to have slipped further and further away since I merged with the dark passenger."
    "La muerte como una posibilidad parecía haberse alejado cada vez más desde que me fundí con el oscuro pasajero."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:39
translate es event_mc_newarmor_2dc6ae13:

    # "But now... Now I remembered I {i}was{/i} still vulnerable, and should I meet my end, those most precious to me would be left to fend for themselves without me."
    "Pero ahora... ahora recordaba que aún {i}era{/i} vulnerable, y que si llegaba mi fin, mis seres más preciados quedarían abandonados a su suerte sin mí."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:40
translate es event_mc_newarmor_9f04f515:

    # MC @ sad "...I promise I will be more careful."
    MC @ sad "...prometo que tendré más cuidado."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:43
translate es event_mc_newarmor_f4eb3f16:

    # "I gently caressed [regina_ref!t]'s face and brought her into an embrace."
    "Acaricié suavemente el rostro de [regina_ref!t] y la abracé."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:42
translate es event_mc_newarmor_3baf8be0:

    # "She smelt good, like freshly cut wildflowers."
    "Olía bien, como a flores silvestres recién cortadas."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:43
translate es event_mc_newarmor_3c9c0ec0:

    # "She reluctantly pulled away and said,"
    "Se apartó a regañadientes y dijo."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:44
translate es event_mc_newarmor_c511e082:

    # REGINA @ talk "There is some good news."
    REGINA @ talk "Hay buenas noticias."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:45
translate es event_mc_newarmor_6ab64f68:

    # REGINA @ talk "Your father has sent word and had delivered a gift for you."
    REGINA @ talk "Tu padre ha enviado un mensaje y ha entregado un regalo para ti."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:46
translate es event_mc_newarmor_9ae375a2:

    # MC @ surprised "Father?"
    MC @ surprised "¿Padre?"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:47
translate es event_mc_newarmor_feb968f0:

    # REGINA @ talk "Yes... Some new armour and a letter for us each."
    REGINA @ talk "Sí... Una armadura nueva y una carta para cada uno."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:48
translate es event_mc_newarmor_3373e8dd:

    # REGINA @ talk "I brought it into your room for when you want to read it."
    REGINA @ talk "La he dejado en tu habitación para cuando quieras leerla."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:49
translate es event_mc_newarmor_cf18f36a:

    # MC @ talk "Thank you."
    MC @ talk "Gracias."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:50
translate es event_mc_newarmor_342e3913:

    # REGINA @ sad "How are your wounds? Are they-"
    REGINA @ sad "¿Cómo están tus heridas? ¿Están-?"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:51
translate es event_mc_newarmor_cea14b40:

    # MC @ talk "I am still sore but, I am fine."
    MC @ talk "Todavía estoy dolorido, pero estoy bien."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:52
translate es event_mc_newarmor_9651a39e:

    # MC @ talk "I promise you."
    MC @ talk "Te lo prometo."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:55
translate es event_mc_newarmor_b6c79774:

    # "Reluctantly, [regina_ref!t] relented, pulling back as she remarked she would put some food on for later, no doubt distracting herself with regards to her worries for me."
    "A regañadientes, [regina_ref!t] cedió, echándose hacia atrás mientras comentaba que prepararía algo de comida para más tarde, sin duda distrayéndose con respecto a sus preocupaciones por mí."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:55
translate es event_mc_newarmor_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Suspiro*{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:57
translate es event_mc_newarmor_39b10682:

    # MC "(I should see what father has brought me.)"
    MC "(Debería ver lo que padre me ha traído)."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:63
translate es event_mc_newarmor_bce5ed0b:

    # "The armour was laid out for me on the bed with the note held down beneath one of the gauntlet."
    "La armadura estaba dispuesta para mí sobre la cama, con la nota sujeta bajo uno de los guanteletes."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:64
translate es event_mc_newarmor_05ccf7f6:

    # "I held up the note and began to read it."
    "Cogí la nota y empecé a leerla."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:65
translate es event_mc_newarmor_a857a5b5:

    # "{i}My son,{/i}"
    "{i}Mi hijo,{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:66
translate es event_mc_newarmor_155a8472:

    # "{i}I am both troubled and proud to hear of your services to the Scouts corps.{/i}"
    "{i}Estoy a la vez preocupado y orgulloso de saber de tus servicios al cuerpo de exploradores.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:67
translate es event_mc_newarmor_1bd0e806:

    # "{i}I am angered as to why you were sent there to begin with, despite the assurances of those of higher stations than mine, that you and your friends places were secured with administrative roles only.{/i}"
    "{i}Me enfurece saber por qué te enviaron allí para empezar, a pesar de las seguridades de los que están en puestos más altos que el mío, de que tú y tus amigos teníais puestos asegurados solo con funciones administrativas.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:68
translate es event_mc_newarmor_879aa470:

    # "{i}Despite what I can only assume to be the result of clerical errors, I have heard of you and Markus' bravery, and how you both were the sole survivors of a mission gone awry.{/i}"
    "{i}A pesar de lo que solo puedo suponer que es el resultado de errores administrativos, he oído hablar de tu valentía y la de Markus, y de cómo ambos fuisteis los únicos supervivientes de una misión que salió mal.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:69
translate es event_mc_newarmor_36456eef:

    # "{i}There is no greater fear for a father, than to lose his only son, and it pleases me greatly to know you are still hopefully well by the time this letter reaches you.{/i}"
    "{i}No hay mayor temor para un padre, que perder a su único hijo, y me complace enormemente saber que todavía estés bien para cuando esta carta te llegue.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:70
translate es event_mc_newarmor_980ce1e6:

    # "{i}My work here is important, but it is so far mostly safe, despite the days dragging long tediously.{/i}"
    "{i}Mi trabajo aquí es importante, pero hasta ahora es sobre todo seguro, a pesar de que los días se alargan tediosamente.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:71
translate es event_mc_newarmor_bdff8cf2:

    # "{i}I look forward to seeing you, Erika, and everyone soon in the next few months.{/i}"
    "{i}Espero verte a ti, Erika, y a todos pronto en los próximos meses.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:72
translate es event_mc_newarmor_58cdd376:

    # "{i}In the last letter I received, it mentioned you and that Adara girl were still close.{/i}"
    "{i}En la última carta que recibí, mencionaba que tú y esa chica Adara seguíais muy unidos.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:73
translate es event_mc_newarmor_a593e099:

    # "{i}Perhaps when I am back, I could speak to her father to arrange your betrothal if you wish?{/i}"
    "{i}Tal vez, cuando vuelva, podría hablar con su padre para concertar tu compromiso, ¿si lo deseas?{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:74
translate es event_mc_newarmor_a25b1eff:

    # "{i}It would be good for some good to come from all this darkness recently...{/i}"
    "{i}Sería bueno que algo bueno saliera de toda esta oscuridad de los últimos tiempos...{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:75
translate es event_mc_newarmor_92e51415:

    # "{i}Now, I have sent to you a gift as I am sure you have received with this letter.{/i}"
    "{i}Ahora, te he enviado un regalo como estoy seguro que has recibido con esta carta.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:76
translate es event_mc_newarmor_89cc93c0:

    # "{i}I have been told that you have been entered involuntarily into the Adventurers Guild as per the Emperor's will.{/i}"
    "{i}Me han dicho que has ingresado involuntariamente en el gremio de aventureros por voluntad del emperador.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:77
translate es event_mc_newarmor_79c549a8:

    # "{i}Despite my complete displeasure at the events that have unfolded, we must do the best we can with the cards dealt.{/i}"
    "{i}A pesar de mi total disgusto por los acontecimientos que se han desarrollado, debemos hacer lo mejor que podamos con las cartas que tenemos disponibles.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:78
translate es event_mc_newarmor_c350386b:

    # "{i}Therefore, I cannot bear the thought of you running around in whatever scrap metal they have given you and called 'armour' for your line of work.{/i}"
    "{i}Por lo tanto, no puedo soportar la idea de que andes por ahí con cualquier chatarra que te hayan dado y que llamen 'armadura' por tu línea de trabajo.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:79
translate es event_mc_newarmor_716596ef:

    # "{i}I have spent of my own coin to have fashioned for your armour that may actually protect you.{/i}"
    "{i}He gastado de mi propio dinero para mandar confeccionar una armadura que te proteja.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:80
translate es event_mc_newarmor_6191ad84:

    # "{i}I have heard you are far larger now since I last saw you, and I hope given the reports I received that I have gotten the right size.{/i}"
    "{i}He oído que ahora eres mucho más grande desde la última vez que te vi, y espero, dados los informes que he recibido, haber acertado con la talla.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:81
translate es event_mc_newarmor_6f096071:

    # "{i}I hope it serves and protects you well my son, I will pray for your safety along with my own.{/i}"
    "{i}Espero que te sirva y te proteja bien hijo mío, rezaré por tu seguridad junto con la mía.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:82
translate es event_mc_newarmor_7be7e97d:

    # "{i}Love, your father.{/i}"
    "{i}Con cariño, tu padre.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:84
translate es event_mc_newarmor_b721a6c6:

    # MC "(...Father.)"
    MC "(...Padre)."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:86
translate es event_mc_newarmor_f879d3c7:

    # "Placing down the letter, I looked over towards the armour and after stripping down, placed it on piece by piece."
    "Dejé la carta, miré hacia la armadura y, tras desvestirme, me la coloqué pieza a pieza."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:87
translate es event_mc_newarmor_b0a71ca1:

    # "It was certainly heavier than the old armour, yet not by much, and it fit my frame surprisingly well."
    "Sin duda era más pesada que la armadura anterior, pero no mucho, y se ajustaba sorprendentemente bien a mi cuerpo."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:94
translate es event_mc_newarmor_edd2f054:

    # "As I looked down towards my hand, I crunched it tightly into a ball."
    "Al bajar la vista hacia mi mano, la apreté con fuerza haciéndola una bola."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:95
translate es event_mc_newarmor_ef4bd956:

    # MC "(Next time.)"
    MC "(La próxima vez)."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:96
translate es event_mc_newarmor_67adc9b3:

    # MC "(Next time I'll be ready for whatever comes.)"
    MC "(La próxima vez estaré preparado para lo que venga)."

translate es strings:

    # game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:28
    old "I was attacked by... {i}something.{/i}"
    new "Fui atacado por... {i}algo.{/i}"

    # game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:28
    old "I'm fine... They're over-exaggerating."
    new "Estoy bien... Están exagerando."
