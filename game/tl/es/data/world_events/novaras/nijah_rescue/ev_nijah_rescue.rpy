

# game/data/world_events/novaras/nijah_rescue/ev_nijah_rescue.rpy:68
translate es ev_nijah_rescue_0_f3d96e92:

    # "Making my way through the streets of Novaras, In the distance, I heard the shrieking sounds of a cry and panicked pleading."
    "Mientras recorría las calles de Novaras, oí a lo lejos el chillido de un grito y una súplica desesperada."

# game/data/world_events/novaras/nijah_rescue/ev_nijah_rescue.rpy:69
translate es ev_nijah_rescue_0_51009b86:

    # "Looking around, People went about their business obliviously, unable to hear the cries that to me were almost deafening."
    "Mirando a mi alrededor, la gente seguía a lo suyo sin oír los gritos que para mí eran casi ensordecedores."

# game/data/world_events/novaras/nijah_rescue/ev_nijah_rescue.rpy:70
translate es ev_nijah_rescue_0_a041d644:

    # MC "(What is that sound?)"
    MC "(¿Qué es ese sonido?)"

# game/data/world_events/novaras/nijah_rescue/ev_nijah_rescue.rpy:71
translate es ev_nijah_rescue_0_f2f55c46:

    # MC "(It sounds like it's nearby...)"
    MC "(Parece que está cerca...)"

