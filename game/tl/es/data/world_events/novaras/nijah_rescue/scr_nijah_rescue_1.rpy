

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:3
translate es evscr_nijah_rescue_1_53260509:

    # MC "Sounds like sure trouble... Should I?" nointeract
    MC "Suena a problemas... ¿Debería?" nointeract

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:6
translate es evscr_nijah_rescue_1_f8d6d024:

    # "I turned sharply as I made my way through a series of dark and fetid alleyways, chasing the sounds."
    "Giré bruscamente mientras me abría paso por una serie de callejones oscuros y fétidos, persiguiendo los sonidos."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:7
translate es evscr_nijah_rescue_1_843b0aa0:

    # "Stumbling over dislodged cobblestones and piles of rubbish, I finally came across a woman, terrified and cowering."
    "Tropezando con adoquines desprendidos y montones de basura, finalmente me encontré con una mujer, aterrorizada y encogida."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:8
translate es evscr_nijah_rescue_1_bba0ea96:

    # "Her face was shrouded by rags as the men surrounded her brandishing their blades."
    "Su rostro estaba cubierto de harapos mientras los hombres la rodeaban blandiendo sus espadas."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:9
translate es evscr_nijah_rescue_1_db49222d:

    # "The largest amongst them, a fat, repulsive bearded thug, towered over her."
    "El mayor de ellos, un gordo y repulsivo matón barbudo, se alzaba sobre ella."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:10
translate es evscr_nijah_rescue_1_275c7a43:

    # THUG @ talk "Stupid fucking whore."
    THUG @ talk "Estúpida puta de mierda."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:11
translate es evscr_nijah_rescue_1_9caf38da:

    # THUG @ talk "You still owe us gold, girl!"
    THUG @ talk "¡Todavía nos debes oro, chica!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:13
translate es evscr_nijah_rescue_1_9e522f02:

    # "The frightened, muffled voice pleaded back."
    "La voz asustada y apagada suplicó."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:14
translate es evscr_nijah_rescue_1_87ee3a0e:

    # UNKNOWN @ talk "Please! Need time!"
    UNKNOWN @ talk "¡Por favor! ¡Necesito tiempo!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:14
translate es evscr_nijah_rescue_1_39c7b05d:

    # THUG @ talk "No more time, you pay NOW!"
    THUG @ talk "Se acabó el tiempo, ¡paga AHORA!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:22
translate es evscr_nijah_rescue_1_afadeed1:

    # "From the shadows I emerged, and the men turned to face me."
    "Salí de entre las sombras y los hombres se giraron para mirarme."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:22
translate es evscr_nijah_rescue_1_568bf043:

    # THUG @ talk "Who are you?"
    THUG @ talk "¿Quién eres tú?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:23
translate es evscr_nijah_rescue_1_5a8de8fb:

    # THUG @ talk "Stay out of this, this does nor a concern you."
    THUG @ talk "No te metas, esto no te concierne."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:25
translate es evscr_nijah_rescue_1_73cc7d0a:

    # "Looking around, I could see dozens of eyes watching from every open crevice and window."
    "Mirando a mi alrededor, pude ver docenas de ojos observando desde todas las rendijas y ventanas abiertas."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:26
translate es evscr_nijah_rescue_1_cef271a4:

    # MC "(Damn... I better be careful here, it’s too risky to transform)"
    MC "(Maldita sea... Será mejor que tenga cuidado aquí, es demasiado arriesgado transformarme)."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:27
translate es evscr_nijah_rescue_1_d5d88d8b:

    # MC "(If I fight them, I’ll have to do it in my normal form)"
    MC "(Si lucho contra ellos, tendré que hacerlo en mi forma normal)."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:39
translate es evscr_nijah_rescue_1_thugsmenu_0ba34b00:

    # THUG @ talk "Bah! There are three of us and only one of you!"
    THUG @ talk "¡Bah! ¡Nosotros somos tres y tú solo uno!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:40
translate es evscr_nijah_rescue_1_thugsmenu_e049bb73:

    # THUG @ talk "You’ll have to do better than that!"
    THUG @ talk "¡Tendrás que hacerlo mejor!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:45
translate es evscr_nijah_rescue_1_thugsmenu_b57efaae:

    # THUG @ talk "Kill him, you fools!"
    THUG @ talk "¡Matadlo, idiotas!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:53
translate es evscr_nijah_rescue_1_thugsmenu_6e045b1a:

    # "As their lifeless bodies littered the alleyway, the blood flowed freely into the cracks of the cobblestone."
    "Mientras sus cuerpos sin vida se esparcían por el callejón, la sangre fluía libremente por las grietas del adoquinado."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:54
translate es evscr_nijah_rescue_1_thugsmenu_350520a2:

    # "I sighed with relief, wiping the sweat from my brow but quickly realised I couldn’t stay here long or else I risked drawing the ire of the guards."
    "Suspiré aliviado, secándome el sudor de la frente, pero enseguida me di cuenta de que no podía quedarme aquí mucho tiempo o me arriesgaba a atraer la ira de los guardias."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:55
translate es evscr_nijah_rescue_1_thugsmenu_83ae0dcb:

    # THUG @ talk "This is not your business, stranger!"
    THUG @ talk "¡Esto no es asunto tuyo, desconocido!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:56
translate es evscr_nijah_rescue_1_thugsmenu_f5ad7f49:

    # THUG @ talk "This woman owes us money and she will pay it!"
    THUG @ talk "¡Esta mujer nos debe dinero y lo pagará!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:60
translate es evscr_nijah_rescue_1_thugsmenu_03518bd4:

    # MC @ talk "How much is her debt?"
    MC @ talk "¿A cuánto asciende su deuda?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:58
translate es evscr_nijah_rescue_1_thugsmenu_b02d4725:

    # THUG @ talk "Two hundred coins now... the rest later."
    THUG @ talk "Doscientas monedas ahora... el resto después."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:62
translate es evscr_nijah_rescue_1_thugsmenu_3a22e377:

    # THUG @ talk "Hmm..."
    THUG @ talk "Hmm..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:63
translate es evscr_nijah_rescue_1_thugsmenu_9a589a68:

    # THUG @ talk "You have bought yourself some time, {i}for now,{/i} girl..."
    THUG @ talk "Has ganado algo de tiempo, {i}por ahora,{/i} chica..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:64
translate es evscr_nijah_rescue_1_thugsmenu_276b253c:

    # THUG @ talk "Pleasure doing business with you, stranger, heh..."
    THUG @ talk "Un placer hacer negocios contigo, desconocido, jeh..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:68
translate es evscr_nijah_rescue_1_thugsmenu_6dfebd14:

    # THUG @ talk "Men! Draw your blades!"
    THUG @ talk "¡Hombres! ¡Saquen sus espadas!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:76
translate es evscr_nijah_rescue_1_thugsmenu_b711464f:

    # THUG @ talk "A wise decision..."
    THUG @ talk "Una sabia decisión..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:83
translate es evscr_nijah_rescue_1_thugsmenu_f5d8de19:

    # MC "(As I left the alley, I could hear the strangely familiar voice pleading behind me for mercy.)"
    MC "(Al salir del callejón, pude oír la voz extrañamente familiar que suplicaba clemencia detrás de mí)."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:85
translate es evscr_nijah_rescue_1_thugsmenu_cd817b72:

    # MC "(As I left the alley, I could hear a female voice pleading behind me for mercy.)"
    MC "(Al salir del callejón, oí una voz femenina que suplicaba clemencia detrás de mí)."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:86
translate es evscr_nijah_rescue_1_thugsmenu_316d5d01:

    # MC "(I wondered if I could, or should, have done something different there.)"
    MC "(Me pregunté si podría, o debería, haber hecho algo diferente allí)."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:87
translate es evscr_nijah_rescue_1_thugsmenu_8dd41211:

    # MC "(But, it's best to leave Ramonians to handle their own affairs.)"
    MC "(Pero es mejor dejar que los ramonianos se ocupen de sus propios asuntos)."

