

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:2
translate es evscr_nijah_rescue_fleecity_1bd3e812:

    # MC @ talk "I think you should flee the city."
    MC @ talk "Creo que deberías huir de la ciudad."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:3
translate es evscr_nijah_rescue_fleecity_c68400fe:

    # NIJAH "You mean... Leave?"
    NIJAH "Quieres decir... ¿Irme?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:4
translate es evscr_nijah_rescue_fleecity_05dbc256:

    # MC @ talk "Yes, get out of here before these thugs get to you one way or another."
    MC @ talk "Sí, sal de aquí antes de que estos matones te atrapen de una forma u otra."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:5
translate es evscr_nijah_rescue_fleecity_bfa35e45:

    # NIJAH "But I will need gold..."
    NIJAH "Pero necesitaré oro..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:6
translate es evscr_nijah_rescue_fleecity_555f5491:

    # MC @ talk "I'll help you with that."
    MC @ talk "Te ayudaré con eso."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:7
translate es evscr_nijah_rescue_fleecity_204559f8:

    # MC "(500 gold should suffice for her to leave safely)"
    MC "(500 de oro debería ser suficiente para que se vaya con seguridad)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:10
translate es evscr_nijah_rescue_fleecity_b178399b:

    # NIJAH "I-I shall wait here."
    NIJAH "E-Esperaré aquí."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:16
translate es evscr_nijah_rescue_fleecity_7ecaf1b7:

    # "As Nijah took the coin, she seemed even more lost and confused than before:"
    "Cuando Nijah cogió las monedas, parecía aún más perdida y confusa que antes:"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:17
translate es evscr_nijah_rescue_fleecity_f1d5be5f:

    # NIJAH "But where... Where will I go?"
    NIJAH "Pero dónde... ¿Adónde iré?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:18
translate es evscr_nijah_rescue_fleecity_8e8c2e72:

    # MC @ talk "I don’t know Nijah, head towards one of the villages but stay in the North."
    MC @ talk "No sé Nijah, dirígete hacia uno de los pueblos pero quédate en el norte."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:19
translate es evscr_nijah_rescue_fleecity_ee8cb889:

    # MC @ talk "Do {i}not{/i} try crossing the Valley of Death to get to the the Free city."
    MC @ talk "{i}No{/i} intentes cruzar el Valle de la Muerte para llegar a la Ciudad libre."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:20
translate es evscr_nijah_rescue_fleecity_51554d47:

    # "Dejected and defeated, Nijah leaned forward to hug me."
    "Abatida y derrotada, Nijah se inclinó hacia delante para abrazarme."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:21
translate es evscr_nijah_rescue_fleecity_1711c02d:

    # NIJAH "Thank zu for saving me... {i}friend.{/i}"
    NIJAH "Grazias por salvarme... {i}amigo.{/i}"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:22
translate es evscr_nijah_rescue_fleecity_bf703b93:

    # NIJAH "I will pay zu back one day... If I can."
    NIJAH "Te lo devolveré algún día... Zi puedo"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:23
translate es evscr_nijah_rescue_fleecity_35fc147e:

    # MC @ talk "... Take some food and gold with you at least."
    MC @ talk "... Llévate algo de comida y oro al menos."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:24
translate es evscr_nijah_rescue_fleecity_1fd87699:

    # "As tears began to swell in her eyes, Nijah added pitifully:"
    "Mientras los ojos se le llenaban de lágrimas, Nijah añadió con lástima:"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:26
translate es evscr_nijah_rescue_fleecity_30593b01:

    # NIJAH "You are the only Alderian to treat with kindness..."
    NIJAH "Eres el único alderiano que me trata con amabilidad..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:31
translate es evscr_nijah_rescue_fleecity_48f5640a:

    # "Placing the handful of gold I gave her in a small pouch with some food, Nijah tearfully waved as she headed off towards the city gate..."
    "Nijah depositó el puñado de oro que le di en una bolsita con algo de comida y, con lágrimas en los ojos, se despidió con la mano mientras se dirigía a la puerta de la ciudad..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:32
translate es evscr_nijah_rescue_fleecity_a1698216:

    # "No one would stop a refugee from wanting to leave."
    "Nadie impediría a un refugiado que quisiera irse."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:33
translate es evscr_nijah_rescue_fleecity_a1b4912b:

    # "No one would enquire or care."
    "Nadie preguntaría ni se preocuparía por ello."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:34
translate es evscr_nijah_rescue_fleecity_e8d5fbd0:

    # "I wondered if I’d made the right choice, but in the end... it was perhaps the most sensible."
    "Me preguntaba si había tomado la decisión correcta, pero al final... quizá fuera la más sensata."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:35
translate es evscr_nijah_rescue_fleecity_79d87d53:

    # "Maybe one day she’ll find a better life."
    "Quizá algún día encuentre una vida mejor."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:36
translate es evscr_nijah_rescue_fleecity_e141c216:

    # "Maybe one day we’ll cross paths again..."
    "Quizá algún día volvamos a cruzarnos..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:43
translate es evscr_nijah_rescue_fleecity_c79bcb5f:

    # NIJAH "H-Huh?"
    NIJAH "¿E-eh?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_fleecity.rpy:44
translate es evscr_nijah_rescue_fleecity_e8d0a824:

    # NIJAH "Then what are you going to do?"
    NIJAH "Entonces, ¿qué vaz a hacer?"

