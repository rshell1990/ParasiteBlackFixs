

# game/data/world_events/slime_jar/logic.rpy:22
translate es ev_slime_jar_98dac472:

    # "I could feel the slimelark shifting and moving around in the container as it bashed against the walls."
    "Podía sentir al joven slimelark moviéndose dentro del contenedor mientras golpeaba contra las paredes."

# game/data/world_events/slime_jar/logic.rpy:23
translate es ev_slime_jar_1871a92c:

    # MC "(Hm... Maybe this wasn't such a good idea.)"
    MC "(Hm... Quizás no fue una buena idea)."

# game/data/world_events/slime_jar/logic.rpy:24
translate es ev_slime_jar_fe1ed16e:

    # MC "(I should inspect it somewhere private.)"
    MC "(Debería inspeccionarlo en algún lugar privado)."

# game/data/world_events/slime_jar/logic.rpy:25
translate es ev_slime_jar_0f3cd446:

    # MC "(My bedroom?)"
    MC "(¿Mi habitación?)"

# game/data/world_events/slime_jar/logic.rpy:34
translate es ev_slime_jar_2_6864d366:

    # "As I gently opened up the container to peer inside, the young slime slithered and moved around slowly in there, but it was clearly curious about my presence."
    "Cuando abrí suavemente el contenedor para mirar dentro, el joven slime se deslizó y se movió lentamente allí, pero claramente sentía curiosidad por mi presencia."

# game/data/world_events/slime_jar/logic.rpy:35
translate es ev_slime_jar_2_54fc81c1:

    # MC "(Hmm... Maybe it's hungry?)"
    MC "(Hmm... ¿Quizás tenga hambre?)"

# game/data/world_events/slime_jar/logic.rpy:36
translate es ev_slime_jar_2_c3fd151d:

    # "I considered for a moment that maybe taking this creature in was a bad idea, but I had already gone this far now, and felt some responsibility for it."
    "Consideré por un momento que quizás acoger a esa criatura era una mala idea, pero ya había llegado hasta ese punto y sentía cierta responsabilidad por ello."

# game/data/world_events/slime_jar/logic.rpy:37
translate es ev_slime_jar_2_9f972684:

    # MC "(Knowing what these things eat...)"
    MC "(Saber qué comen estas cosas...)"

# game/data/world_events/slime_jar/logic.rpy:38
translate es ev_slime_jar_2_a4c81daa:

    # MC "(Perhaps some meat?)"
    MC "(¿Quizás un poco de carne?)"

# game/data/world_events/slime_jar/logic.rpy:39
translate es ev_slime_jar_2_57f879d3:

    # "I have stashed the container under my bed and set out to get some meat."
    "Guardé el recipiente debajo de mi cama y me dispuse a buscar algo de carne."

translate es strings:

