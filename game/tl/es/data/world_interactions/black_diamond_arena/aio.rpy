

# game/data/world_interactions/black_diamond_arena/aio.rpy:47
translate es black_diamond_arena_firstEnter_2471c171:

    # "As I stumbled down the flight of stairs, I heard the bellowing roar of cheers and something snarling down below."
    "Mientras bajaba a trompicones las escaleras, oí el estruendo de los vítores y algo que gruñía abajo."

# game/data/world_interactions/black_diamond_arena/aio.rpy:48
translate es black_diamond_arena_firstEnter_1352313f:

    # "Coming upon a great darkened underground Arena, men gathered around and cheered as two reptilian beasts slashed and tore at each other in the fight pit below."
    "Al llegar a una gran arena subterránea oscurecida, los hombres se reunieron y vitorearon mientras dos bestias reptiles se acuchillaban y desgarraban mutuamente en el foso de lucha que había debajo."

# game/data/world_interactions/black_diamond_arena/aio.rpy:49
translate es black_diamond_arena_firstEnter_8b799890:

    # "The one leapt and gripped the others throat with its teeth, ripping it out in a violent bloody display that the crowd roared with pleasure too."
    "Uno saltó y agarró la garganta del otro con sus dientes, arrancándosela en una violenta exhibición sangrienta que la multitud también rugió de placer."

# game/data/world_interactions/black_diamond_arena/aio.rpy:50
translate es black_diamond_arena_firstEnter_b2c9c7fd:

    # MC "(What is this place?)"
    MC "(¿Qué es este sitio?)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:53
translate es black_diamond_arena_firstEnter_51fba3e4:

    # BOOKKEEPER "Oi!"
    BOOKKEEPER "¡Oye!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:56
translate es black_diamond_arena_firstEnter_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "¿Eh?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:55
translate es black_diamond_arena_firstEnter_557daccb:

    # BOOKKEEPER "Zer are no freeloaders! Either place a bet, or fuck off!"
    BOOKKEEPER "¡Zer no aprovechados! ¡O haces una apuesta o te vas a la mierda!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:58
translate es black_diamond_arena_firstEnter_fc48861a:

    # MC @ talk "A bet?"
    MC @ talk "¿Una apuesta?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:57
translate es black_diamond_arena_firstEnter_6faeae54:

    # BOOKKEEPER "Iz stupid or something?"
    BOOKKEEPER "¿Zer estúpido o algo así?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:65
translate es black_diamond_bookkeeper_talk_2fb4960b:

    # BOOKKEEPER "No. You off limit. Come back in a few dayz."
    BOOKKEEPER "No. Estás fuera del límite. Vuelve en unos díaz."

# game/data/world_interactions/black_diamond_arena/aio.rpy:69
translate es black_diamond_bookkeeper_talk_615eedc7:

    # MC "Okay."
    MC "De acuerdo."

# game/data/world_interactions/black_diamond_arena/aio.rpy:69
translate es black_diamond_bookkeeper_talk_73727c63:

    # BOOKKEEPER "Beasts fight below, you bet."
    BOOKKEEPER "Las bestias luchan abajo, tú apuestasr."

# game/data/world_interactions/black_diamond_arena/aio.rpy:70
translate es black_diamond_bookkeeper_talk_376ff848:

    # BOOKKEEPER "Your beast wins, you get coin."
    BOOKKEEPER "Tu bestia gana, obtienes monedas."

# game/data/world_interactions/black_diamond_arena/aio.rpy:71
translate es black_diamond_bookkeeper_talk_cba48cb5:

    # BOOKKEEPER "Zat's it, you want bet?"
    BOOKKEEPER "Ezo es todo, ¿quieres apostar?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:74
translate es black_diamond_bookkeeper_talk_menu_26b1e50b:

    # BOOKKEEPER "How much?"
    BOOKKEEPER "¿Cuánto?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:86
translate es black_diamond_bookkeeper_talk_menu_8a0c5ec4:

    # BOOKKEEPER "Very good!"
    BOOKKEEPER "¡Muy bien!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:87
translate es black_diamond_bookkeeper_talk_menu_83429a1e:

    # BOOKKEEPER "Enjoy fight! Collect coin after if win!"
    BOOKKEEPER "¡Disfruta de la lucha! ¡Recoge monedas si ganas!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:90
translate es black_diamond_bookkeeper_talk_menu_577c9037:

    # BOOKKEEPER "Rules iz simple!"
    BOOKKEEPER "Las reglas zon sencillas."

# game/data/world_interactions/black_diamond_arena/aio.rpy:91
translate es black_diamond_bookkeeper_talk_menu_824d265f:

    # BOOKKEEPER "You bet on either creature to win, first to kill zer other wins."
    BOOKKEEPER "Apuestas a que gane cualquiera de las criaturas, el primero que mate al otro gana."

# game/data/world_interactions/black_diamond_arena/aio.rpy:92
translate es black_diamond_bookkeeper_talk_menu_ba9aaef0:

    # BOOKKEEPER "Az newbie, you iz only able to bet one thousand coins a week."
    BOOKKEEPER "Como novato, solo ez capaz de apostar mil monedas a la semana."

# game/data/world_interactions/black_diamond_arena/aio.rpy:93
translate es black_diamond_bookkeeper_talk_menu_ec70c2c2:

    # BOOKKEEPER "Coin pay upfront before bet go on."
    BOOKKEEPER "Pagar por adelantado antes de apostar."

# game/data/world_interactions/black_diamond_arena/aio.rpy:97
translate es black_diamond_bookkeeper_talk_menu_b6289d56:

    # MC @ talk "That seems odd, why the limit?"
    MC @ talk "Parece extraño, ¿por qué ese límite?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:95
translate es black_diamond_bookkeeper_talk_menu_40d9f557:

    # BOOKKEEPER "Too many try cheat."
    BOOKKEEPER "Demasiados intentan hacer trampas."

# game/data/world_interactions/black_diamond_arena/aio.rpy:96
translate es black_diamond_bookkeeper_talk_menu_2ade3781:

    # BOOKKEEPER "One try poisoning a beasty and placing huge bet on other."
    BOOKKEEPER "Uno intento de envenenar a una bestia y colocar gran apuesta en otra."

# game/data/world_interactions/black_diamond_arena/aio.rpy:97
translate es black_diamond_bookkeeper_talk_menu_f8b9be59:

    # BOOKKEEPER "Now, only trusted members can make big bets."
    BOOKKEEPER "Ahora, solo los miembros de confianza pueden hacer grandes apuestas."

# game/data/world_interactions/black_diamond_arena/aio.rpy:100
translate es black_diamond_bookkeeper_talk_menu_b72566e1:

    # BOOKKEEPER "Than leave already!"
    BOOKKEEPER "¡Entonces vete ya!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:148
translate es black_diamond_arena_fight_3b26aa88:

    # MC "(Well... That's wasn't the easiest thing to watch.)"
    MC "(Bueno... Eso no fue lo más fácil de ver)."

# game/data/world_interactions/black_diamond_arena/aio.rpy:149
translate es black_diamond_arena_fight_e66f7113:

    # MC "(Looks like I won though!)"
    MC "(¡Parece que he ganado!)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:152
translate es black_diamond_arena_fight_349520bc:

    # MC "(Damn... I lost.)"
    MC "(Maldición... He perdido)."

