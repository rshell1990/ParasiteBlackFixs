

# game/data/world_interactions/demorai_temple_kraken.rpy:15
translate es world_clickable_temple_kraken_5c07169a:

    # "Peering into the depths of the stagnant water over the edges of the erected stone pathways gave me an uneasy feeling."
    "Al asomarme a las profundidades del agua estancada por encima de los bordes de los senderos de piedra erigidos, tuve una sensación de inquietud."

# game/data/world_interactions/demorai_temple_kraken.rpy:16
translate es world_clickable_temple_kraken_75e29588:

    # "I could not see what was down there, but I could sense movement beneath that blackened water all the same."
    "No podía ver lo que había allí abajo, pero de todos modos percibía movimiento bajo aquella agua ennegrecida."

# game/data/world_interactions/demorai_temple_kraken.rpy:17
translate es world_clickable_temple_kraken_16c00e6b:

    # "Just how deep did these waters run?"
    "¿Hasta qué profundidad llegaban esas aguas?"

# game/data/world_interactions/demorai_temple_kraken.rpy:20
translate es world_clickable_temple_kraken_af42c0e5:

    # "Placing my hand into the water, the ripples once again waved across the still waters."
    "Al meter la mano en el agua, las ondas volvieron a agitarse sobre las tranquilas aguas."

# game/data/world_interactions/demorai_temple_kraken.rpy:24
translate es world_clickable_temple_kraken_fc27693d:

    # "This time though, bursting out of the waters came a fury of tentacles thrashing wildly!"
    "¡Sin embargo, esta vez surgió de las aguas una furia de tentáculos que se agitaban salvajemente!"

# game/data/world_interactions/demorai_temple_kraken.rpy:25
translate es world_clickable_temple_kraken_a70c5cab:

    # MC "(FUCK!)"
    MC "(¡JODER!)"

# game/data/world_interactions/demorai_temple_kraken.rpy:27
translate es world_clickable_temple_kraken_25516f50:

    # "I transformed, preparing myself for battle."
    "Me transformé, preparándome para la batalla."

# game/data/world_interactions/demorai_temple_kraken.rpy:34
translate es world_clickable_temple_kraken_4f11fb8d:

    # "After slashing and tearing off one of the beasts' tentacles that dropped down into the waters, the beast howled in rage as it quickly retreated and submerged itself back into the black depths from where it came."
    "Tras acuchillar y arrancar uno de los tentáculos de la bestia que caía a las aguas, ésta aulló de rabia mientras retrocedía rápidamente y se sumergía de nuevo en las negras profundidades de donde había salido."

# game/data/world_interactions/demorai_temple_kraken.rpy:38
translate es world_clickable_temple_kraken_ee79b738:

    # MC "{i}...How the hell does that thing even live down here?{/i}"
    MC "{i}...¿Cómo demonios vive esa cosa aquí abajo?{/i}"

# game/data/world_interactions/demorai_temple_kraken.rpy:39
translate es world_clickable_temple_kraken_4e2751cc:

    # "I noticed on the floor, some strange shimmering gem that wasn't there before."
    "Noté en el suelo una extraña gema brillante que antes no estaba allí."

# game/data/world_interactions/demorai_temple_kraken.rpy:42
translate es world_clickable_temple_kraken_80e8c4f0:

    # MC "(Huh? What is this thing?)"
    MC "(¿Qué? ¿Qué es esto?)"

# game/data/world_interactions/demorai_temple_kraken.rpy:45
translate es world_clickable_temple_kraken_7770dba9:

    # "Deciding it was probably not a good idea to continue messing with the water, I stepped back."
    "Decidí que no era buena idea seguir jugando con el agua y di un paso atrás."

# game/data/world_interactions/demorai_temple_kraken.rpy:46
translate es world_clickable_temple_kraken_24488d99:

    # MC "(Whatever's in there isn't going to appreciate me splashing around.)"
    MC "(Lo que sea que haya ahí no va a apreciar que chapotee)."

