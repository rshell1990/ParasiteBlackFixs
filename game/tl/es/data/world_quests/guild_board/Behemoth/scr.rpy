

# game/data/world_quests/guild_board/Behemoth/scr.rpy:6
translate es qst_guild_behemoth_63f7e535:

    # "Below the city of Novaras, an infinite labyrinth of sewers sprawled, a black abyss dreaded by many."
    "Bajo la ciudad de Novaras se extendía un laberinto infinito de cloacas, un abismo negro temido por muchos."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:8
translate es qst_guild_behemoth_663f49f3:

    # "As we embarked into the maw of the dark maze, we couldn't help but become mesmerized by the abysmal magnificience of the sewer system."
    "Al adentrarnos en las fauces del oscuro laberinto, no pudimos evitar quedarnos hipnotizados por la abismal magnificencia del sistema de alcantarillado."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:9
translate es qst_guild_behemoth_d1f8ae1b:

    # "Every now and then, we saw festering corpses captured in haunting stillness."
    "De vez en cuando, veíamos cadáveres putrefactos capturados en una inquietante quietud."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:11
translate es qst_guild_behemoth_930e2aea:

    # "As I embarked into the maw of the dark maze, I couldn't help but become mesmerized by the abysmal magnificience of the sewer system."
    "Al adentrarme en las fauces del oscuro laberinto, no pude evitar quedarme hipnotizado por la abismal magnificencia del sistema de alcantarillado."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:12
translate es qst_guild_behemoth_ddc94613:

    # "Every now and then, I saw festering corpses captured in haunting stillness."
    "De vez en cuando, veía cadáveres putrefactos capturados en una inquietante quietud."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:13
translate es qst_guild_behemoth_20c504c3:

    # "Adventurers who had made their perilous descent in search of fame or ancient treasure,"
    "Aventureros que habían realizado su peligroso descenso en busca de fama o de un antiguo tesoro."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:14
translate es qst_guild_behemoth_471a689f:

    # "...miscreants who had accumulated enough resentment up in the city, lowlifes and refugees seeking shelter from whatever accursed path their lives had ended up on."
    "...malhechores que habían acumulado suficiente resentimiento en la ciudad, malvivientes y refugiados que buscaban refugio de cualquier camino maldito en el que hubieran acabado sus vida."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:15
translate es qst_guild_behemoth_0b916a49:

    # "This far down, little to no light reached to illuminate their motionless agony of untimely demise."
    "Tan abajo, poca o ninguna luz llegaba para iluminar su inmóvil agonía de muerte prematura."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:18
translate es qst_guild_behemoth_bc8b636e:

    # "Navigating these putrid halls of decay for what felt like an eternity, we were eventually welcomed by a deafening screech..."
    "Navegando por estos pútridos pasillos de la decadencia durante lo que nos pareció una eternidad, finalmente fuimos recibidos por un chirrido ensordecedor..."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:20
translate es qst_guild_behemoth_7fa71d2e:

    # "Navigating these putrid halls of decay for what felt like an eternity, I was eventually welcomed by a deafening screech..."
    "Navegando por estos pútridos pasillos de la decadencia durante lo que me pareció una eternidad, finalmente fui recibido por un chirrido ensordecedor..."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:25
translate es qst_guild_behemoth_a02dd2f3:

    # MC "That must be our contract."
    MC "Ese debe ser nuestro contrato."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:26
translate es qst_guild_behemoth_b1131f30:

    # "For a moment, my torch had carved out a silhouette in the dark tunnels ahead."
    "Por un momento, mi antorcha había esculpido una silueta en los oscuros túneles."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:27
translate es qst_guild_behemoth_e5ca9b79:

    # "A hideous creature the size of a bull scurried across the tunnel with otherworldly swiftness and disappeared amidst rusty, moss-covered drain pipes."
    "Una horrenda criatura del tamaño de un toro se escabulló por el túnel con una rapidez de otro mundo y desapareció entre tuberías de desagüe oxidadas y cubiertas de musgo."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:28
translate es qst_guild_behemoth_f6b9f55f:

    # "There, focusing my gaze, I saw it in all its repulsive glory: an enormous white rat, its numerous red eyes twitching chaotically before fixing on me..."
    "Allí, enfocando mi mirada, la vi en todo su repulsivo esplendor: una enorme rata blanca, con sus numerosos ojos rojos moviéndose caóticamente antes de fijarse en mí..."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:29
translate es qst_guild_behemoth_ffa99d96:

    # MC "What in the name of..."
    MC "¿Pero qué.."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:31
translate es qst_guild_behemoth_0b8f425d:

    # "In a screeching wave, group of smaller rats flooded our path."
    "En una ola chirriante, un grupo de ratas más pequeñas inundó nuestro camino."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:33
translate es qst_guild_behemoth_8430afa7:

    # "In a screeching wave, group of smaller rats flooded my path."
    "En una ola chirriante, un grupo de ratas más pequeñas inundó mi camino."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:36
translate es qst_guild_behemoth_24148341:

    # MC "Shit!"
    MC "¡Mierda!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:37
translate es qst_guild_behemoth_680ca7a8:

    # MC "They're trying to protect their mother!"
    MC "¡Intentan proteger a su madre!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:39
translate es qst_guild_behemoth_949e2808:

    # MC "To arms!"
    MC "¡A las armas!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:52
translate es qst_guild_behemoth_bc725cf7:

    # MC "After it! Its getting away!"
    MC "¡Tras ella! ¡Se escapa!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:54
translate es qst_guild_behemoth_9d7b1233:

    # "Carving my way through hideous rodents, I saw their 'mother' scurrying away."
    "Abriéndome paso entre horribles roedores, vi a su 'madre' alejarse a toda prisa."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:55
translate es qst_guild_behemoth_e8750f9a:

    # MC "{i}You're not getting away from me.{/i}"
    MC "{i}No te escaparás de mí.{/i}"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:59
translate es qst_guild_behemoth_2ae9249d:

    # "Tearing our way through the ocean of rats, we gave chase to the great behemoth."
    "Abriéndonos paso a través del océano de ratas, dimos caza al gran monstruo gigante."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:60
translate es qst_guild_behemoth_eae13f48:

    # "Eventually, we found our way to its lair."
    "Finalmente, encontramos el camino a su guarida."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:62
translate es qst_guild_behemoth_c25e1ebd:

    # "Piles upon piles of bones and rotten corpses littered around, the scent so strong they could make a normal man pass out."
    "Montones y montones de huesos y cadáveres podridos se esparcían por los alrededores, con un olor tan fuerte que podría desmayar a un hombre normal."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:63
translate es qst_guild_behemoth_1fe92bb1:

    # "The great rat snarled and hissed at us from its throne of bones, bellowing out as its children came rushing out of every crevice to protect her."
    "La gran rata nos gruñó y siseó desde su trono de huesos, bramando mientras sus hijos salían corriendo de todas las grietas para protegerla."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:65
translate es qst_guild_behemoth_5535eb0a:

    # "I chased the great behemoth to what seemed to be its lair."
    "Perseguí al monstruo gigante hasta lo que parecía ser su guarida."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:67
translate es qst_guild_behemoth_c25e1ebd_1:

    # "Piles upon piles of bones and rotten corpses littered around, the scent so strong they could make a normal man pass out."
    "Montones y montones de huesos y cadáveres podridos se esparcían por los alrededores, con un olor tan fuerte que podría desmayar a un hombre normal."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:68
translate es qst_guild_behemoth_62f0a913:

    # "The great rat snarled and hissed at me from its throne of bones, bellowing out as its children came rushing out of every crevice to protect her."
    "La gran rata me gruñó y siseó desde su trono de huesos, bramando mientras sus hijos salían corriendo de todas las grietas para protegerla."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:74
translate es qst_guild_behemoth_f628aec9:

    # MC "The rest of you hold off the rats!"
    MC "¡El resto de vosotros detened a las ratas!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:75
translate es qst_guild_behemoth_95be7c54:

    # MC "{i}I'll take the queen!{/i}"
    MC "{i}¡Me encargaré de la reina!{/i}"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:77
translate es qst_guild_behemoth_00d76255:

    # MC "Let's end this now!"
    MC "¡Terminemos con esto ahora!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:78
translate es qst_guild_behemoth_6c7dc4b4:

    # "As I charged at the great rat, it hissed and leapt down to face me!"
    "¡Cuando cargué contra la gran rata, ésta siseó y saltó hacia mí!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:84
translate es qst_guild_behemoth_57749aa9:

    # "The great behemoth committed itself to one last desperate charge towards me."
    "El monstruo gigante se comprometió a una última carga desesperada hacia mí."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:85
translate es qst_guild_behemoth_dcaaf360:

    # "With one great swipe of my tail, I dropped the thing sliding lifelessly across the floor."
    "Con un gran golpe de mi cola, dejé caer la cosa deslizándose sin vida por el suelo."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:86
translate es qst_guild_behemoth_1388896b:

    # "Its head rolled off to the side somewhere with a thud."
    "Su cabeza rodó hacia un lado con un ruido sordo."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:87
translate es qst_guild_behemoth_ecb2ac0d:

    # "Seeing what had happened to their 'mother,' the rats screamed and scurried off through the dark holes they came from."
    "Al ver lo que le había ocurrido a su 'madre', las ratas gritaron y se escabulleron por los oscuros agujeros de los que habían salido."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:91
translate es qst_guild_behemoth_91fb63ec:

    # MC "{i}*Huff* *Huff...*{/i}"
    MC "{i}*Uff* *Uff...*{/i}"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:92
translate es qst_guild_behemoth_dee42ebc:

    # MC "Fucking rats ...!"
    MC "¡Malditas ratas ...!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:95
translate es qst_guild_behemoth_f7fc9bbe:

    # ELENA @ shock "Eww! I think I stepped on ones eye!"
    ELENA @ shock "¡Puaj! ¡Creo que me pisé un ojo!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:97
translate es qst_guild_behemoth_13cc05a8:

    # MARKUS "Why can't you pick a quest where we investigate a brothel or something? Why does every quest need to involve horrifying monsters?"
    MARKUS "¿Por qué no puedes elegir una misión en la que investiguemos un burdel o algo así? ¿Por qué todas las misiones tienen que incluir monstruos horripilantes?"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:99
translate es qst_guild_behemoth_f89610dd:

    # MYU @ scared "Myu want go now ... Dark place scary."
    MYU @ scared "Myu quiere irse ahora ... Oscuro lugar de miedo."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:101
translate es qst_guild_behemoth_5cf04ca1:

    # MC "Lets just take some proof and bring it back to the guild!"
    MC "¡Cojamos alguna prueba y llevémosla al gremio!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:102
translate es qst_guild_behemoth_9349ddc7:

    # MC "I don't want to spend a minute down here longer than I have to ..."
    MC "No quiero pasar aquí abajo ni un minuto más de lo necesario ..."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:104
translate es qst_guild_behemoth_fdff679e:

    # "I've found the mother rat's head and grabbed it, still warm, as a proof."
    "He encontrado la cabeza de la rata madre y la he cogido, aún caliente, como prueba."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:105
translate es qst_guild_behemoth_e8ef750b:

    # MC "Time to leave this place, hopefully for good."
    MC "Es hora de dejar este lugar, espero que para siempre."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:115
translate es qst_guild_behemoth_5d5b8c72:

    # "...We returned to the guild and were met by a thunderous applause."
    "...Volvimos al gremio y fuimos recibidos por un estruendoso aplauso."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:116
translate es qst_guild_behemoth_b2735de9:

    # "Guild members raised glasses in our name."
    "Los miembros del gremio levantaron copas en nuestro nombre."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:118
translate es qst_guild_behemoth_1d931fd8:

    # "...I returned to the guild and was met by a thunderous applause."
    "...Volví al gremio y fui recibido por un estruendoso aplauso."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:119
translate es qst_guild_behemoth_2862c54c:

    # "Guild members raised glasses in my name."
    "Los miembros del gremio levantaron copas en mi nombre."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:123
translate es qst_guild_behemoth_cc49e589:

    # "A cheerful Thea approached with a cup in her hand."
    "Una alegre Thea se acercó con una taza en la mano."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:125
translate es qst_guild_behemoth_d49e003b:

    # THEA @ smile "Congratulations!"
    THEA @ smile "¡Felicidades!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:126
translate es qst_guild_behemoth_6cf9f376:

    # THEA @ smile "You made it to C-tier!"
    THEA @ smile "¡Has llegado al nivel C!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:128
translate es qst_guild_behemoth_d977c24f:

    # THEA @ smile "Welcome to the real deal, Seasoned Adventurers!"
    THEA @ smile "¡Bienvenidos al verdadero negocio, aventureros experimentados!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:130
translate es qst_guild_behemoth_6c4ed864:

    # THEA @ smile "Welcome to the real deal, Seasoned Adventurer!"
    THEA @ smile "¡Bienvenido al verdadero negocio, aventurero experimentado!"

# game/data/world_quests/guild_board/Behemoth/scr.rpy:132
translate es qst_guild_behemoth_5ca9b6bf:

    # THEA @ smile2 "Maybe when you get a chance ... We could talk a little more in {i}private{/i} when you're done celebrating."
    THEA @ smile2 "Quizá cuando puedas... podríamos hablar un poco más en {i}privado{/i} cuando termines de celebrarlo."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:133
translate es qst_guild_behemoth_20de511a:

    # MC @ smile "I'll keep that in mind."
    MC @ smile "Lo tendré en cuenta."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:137
translate es qst_guild_behemoth_f16a4f02:

    # "As Thea hurried off to fetch more drinks for a rowdy table, we were swamped by various adventurers asking us to recount every vivid detail of what went down."
    "Mientras Thea se apresuraba a buscar más bebidas para una mesa alborotada, nos inundaban varios aventureros que nos pedían que contáramos todos los detalles de lo sucedido."

# game/data/world_quests/guild_board/Behemoth/scr.rpy:139
translate es qst_guild_behemoth_98cb3dc3:

    # "As Thea hurried off to fetch more drinks for a rowdy table, I was swamped by various adventurers asking me to recount every vivid detail of what went down."
    "Mientras Thea se apresuraba a buscar más bebidas para una mesa alborotada, me inundaban varios aventureros pidiéndome que les contara todos los detalles de lo sucedido."

