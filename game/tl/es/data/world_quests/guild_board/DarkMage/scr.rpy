    MC @ angry " ...¡Mierda!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:148
translate es qst_guild_darkmage_wall_enter_menu_1adb88ed:

    # "The human spider let out another dry, blood curling cry as it scurried towards us."
    "La araña humana lanzó otro grito seco y sanguinolento mientras corría hacia nosotros."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:150
translate es qst_guild_darkmage_wall_enter_menu_455f3730:

    # "The human spider let out another dry, blood curling cry as it scurried towards me."
    "La araña humana lanzó otro grito seco y sanguinolento mientras corría hacia mí."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:155
translate es qst_guild_darkmage_wall_enter_menu_2c8b6d85:

    # "As the others leapt out in front to try and battle the creature, I transformed and prepared for battle once again!"
    "Mientras los demás saltaban al frente para intentar luchar contra la criatura, yo me transformaba y me preparaba para la batalla una vez más!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:157
translate es qst_guild_darkmage_wall_enter_menu_e2c451d9:

    # "I transformed, preparing for battle!"
    "¡Me transformé, preparándome para la batalla!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:167
translate es qst_guild_darkmage_wall_enter_menu_8ce392b9:

    # "With tentacles thrust through the creature's eyes, it howled in pain as I dug in through the eye-sockets, blood poured out as it flailed to still desperately claw at me before tearing it's head apart vertically."
    "Con los tentáculos clavados en los ojos de la criatura, aulló de dolor cuando le clavé los oculares, la sangre brotó mientras se agitaba para seguir arañándome desesperadamente antes de desgarrarle la cabeza verticalmente."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:168
translate es qst_guild_darkmage_wall_enter_menu_40012949:

    # "The thing slumped down in front of me, pitiful sounds escaping its dying breathes as a pool of blood enveloped around the creature, and it finally stopped breathing."
    "La cosa se desplomó frente a mí, sonidos lastimeros escapando de su respiración agonizante mientras un charco de sangre envolvía a la criatura, y finalmente dejó de respirar."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:179
translate es qst_guild_darkmage_wall_enter_menu_37eafd5a:

    # DARK_MAGE "Noooo! NO! NO! What have you done?"
    DARK_MAGE "¡Noooo! ¡NO! ¡NO! ¿Qué has hecho?"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:180
