translate es qst_guild_darkmage_riddle_wrong_answer_8c9dfcdc:

    # "A bolt of lightning from the faces' eyes painfully zapped at me before dispersing."
    "Un rayo procedente dee los ojos de la cara me alcanzó dolorosamente antes de dispersarse."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:70
