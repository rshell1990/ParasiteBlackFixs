translate es qst_guild_darkmage_wall_enter_menu_e23ef614:

    # DARK_MAGE "The only insanity is letting these fools continue this futile war!"
    DARK_MAGE "¡La única locura es dejar que estos tontos continúen esta guerra inútil!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:122
translate es qst_guild_darkmage_wall_enter_menu_f5549fa6:

    # DARK_MAGE "If someone must be the monster to save you all then I welcome the role with open arms!"
    DARK_MAGE "Si alguien tiene que ser el monstruo que os salve a todos, ¡acepto el papel con los brazos abiertos!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:124
translate es qst_guild_darkmage_wall_enter_menu_b2bd613e:

    # "The horrifying creature crawled it's way towards the Dark Mage as he began to affectionately pet it."
    "La horripilante criatura se arrastró hacia el mago oscuro, que empezó a acariciarla cariñosamente."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:124
translate es qst_guild_darkmage_wall_enter_menu_cd654438:

    # DARK_MAGE "See? It's perfectly obedient and-"
    DARK_MAGE "¿Lo ves? Es perfectamente obediente y-"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:130
translate es qst_guild_darkmage_wall_enter_menu_c9254fe0:

    # "The beast suddenly lunged, tearing off the Dark Mage's hand whole."
    "La bestia se abalanzó de repente, arrancando entera la mano del mago oscuro."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:131
translate es qst_guild_darkmage_wall_enter_menu_d5419dd0:

    # DARK_MAGE "AHHHHHHHH!"
    DARK_MAGE "¡AHHHHHHHH!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:134
translate es qst_guild_darkmage_wall_enter_menu_9c79bd43:

    # "The Dark mage waved around the stump where his hand used to be, pumping out blood as the creature violently whacked him with one of its spider-like legs, sending him hurdling across the room."
    "El mago oscuro agitó el muñón donde antes tenía la mano, que bombeaba sangre, mientras la criatura lo golpeaba violentamente con una de sus patas de araña, lanzándolo a toda velocidad por la habitación."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:135
translate es qst_guild_darkmage_wall_enter_menu_e57ec074:

    # "Slamming against the wall, he weakly reached his other hand out towards the creature as a pool of blood began to envelop him."
    "Golpeándose contra la pared, extendió débilmente la otra mano hacia la criatura mientras un charco de sangre empezaba a envolverle."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:136
translate es qst_guild_darkmage_wall_enter_menu_1c76b3af:

