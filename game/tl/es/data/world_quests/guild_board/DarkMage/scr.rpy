    DARK_MAGE "¡O-OBEDÉCEME! ¡ARGHH! ¡YO SOY TU AMO!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:139
translate es qst_guild_darkmage_wall_enter_menu_24c68024:

    # MC @ surprised "I don't think he's listening anymore!"
    MC @ surprised "¡No creo que siga escuchando!"

