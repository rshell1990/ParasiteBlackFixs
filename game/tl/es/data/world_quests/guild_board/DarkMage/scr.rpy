# game/data/world_quests/guild_board/DarkMage/scr.rpy:113
translate es qst_guild_darkmage_wall_enter_menu_1d559bb3:

    # "Dragging itself forward from the darkness, a wretched mass of flesh unleashing an horrifying growl like that of a distorted human, as though the cords had been dragged and pulled."
    "Arrastrándose hacia delante desde la oscuridad, una miserable masa de carne que emitía un horrible gruñido como el de un humano distorsionado, como si se hubiera arrastrado y tirado de las cuerdas."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:114
translate es qst_guild_darkmage_wall_enter_menu_0e3968a8:

    # "The sickening sight of what seemed to be at least a dozen people merged together into some warped abomination, limbs merged together with a horrifying skull like face protruding out the center of this human spider."
    "La visión repugnante de lo que parecía ser al menos una docena de personas fusionadas en una abominación deformada, miembros fusionados con una horrible cara de cráneo que sobresalía del centro de esta araña humana."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:115
translate es qst_guild_darkmage_wall_enter_menu_67967471:

    # MC @ scared "...What in all of the gods is that thing?"
    MC @ scared "...¿Qué demonios es esa cosa?"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:115
translate es qst_guild_darkmage_wall_enter_menu_9eb0fbd7:

    # DARK_MAGE "Why, this is what we {i}need{/i} to win this war!"
    DARK_MAGE "¡Esto es lo que {i}necesitamos{/i} para ganar esta guerra!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:116
translate es qst_guild_darkmage_wall_enter_menu_c4c80ade:

    # DARK_MAGE "If we but sacrificed a few hundred of our own, think of how many of these I could make!"
    DARK_MAGE "Si sacrificáramos unos cientos de los nuestros, ¡piensa en cuántos de estos podría hacer!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:118
translate es qst_guild_darkmage_wall_enter_menu_9a869e50:

    # MC @ angry "You're insane!"
    MC @ angry "¡Estás loco!"

