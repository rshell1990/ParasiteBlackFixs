# game/data/world_quests/guild_board/DarkMage/scr.rpy:93
translate es qst_guild_darkmage_wall_enter_menu_40d6564f:

    # DARK_MAGE "Why, my experiments of course!"
    DARK_MAGE "Por supuesto, ¡mis experimentos!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:94
translate es qst_guild_darkmage_wall_enter_menu_56641084:

    # DARK_MAGE "A lung here ... A heart there, it's all come together so wonderfully!"
    DARK_MAGE "Un pulmón aquí... Un corazón allí, ¡todo se ha unido maravillosamente!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:95
translate es qst_guild_darkmage_wall_enter_menu_e52b8533:

    # DARK_MAGE "No one will miss these unfortunate souls anyway, in truth ... {i}I feel like I'm doing them a favor.{/i}"
    DARK_MAGE "Nadie extrañará a estas almas desafortunadas de todos modos, en verdad... {i}Siento que les estoy haciendo un favor.{/i}"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:96
translate es qst_guild_darkmage_wall_enter_menu_1ba660db:

    # DARK_MAGE "Here, let me show you my latest... project."
    DARK_MAGE "Déjame mostrarte mi último... proyecto."

