    # DARK_MAGE "Only with my - {i}*Cough!*{/i} work could we turn the tide of this war!"
    DARK_MAGE "¡Solo con mi - {i}*¡Cof!*{/i} trabajo podremos cambiar el rumbo de esta guerra!"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:178
translate es qst_guild_darkmage_wall_enter_menu_f6d3f83d:

    # MC "Delude yourself you're a hero all you want, Mage."
    MC "Hazte ilusiones de que eres un héroe todo lo que quieras, mago."

# game/data/world_quests/guild_board/DarkMage/scr.rpy:179
translate es qst_guild_darkmage_wall_enter_menu_8520e609:

    # MC "Do you truly think anyone would accept these creatures into the army?"
    MC "¿De verdad crees que alguien aceptaría a estas criaturas en el ejército?"

# game/data/world_quests/guild_board/DarkMage/scr.rpy:180
translate es qst_guild_darkmage_wall_enter_menu_6feae322:

