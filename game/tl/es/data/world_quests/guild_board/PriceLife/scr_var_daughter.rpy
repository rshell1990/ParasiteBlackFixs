translate es qst_guild_price_life_daughter_kidnappers_leave_30444804:

    # "Morality aside, the last thing I needed was some merchant lord investigating his daughter's death and raising hell on the matter."
    "Dejando a un lado la moral, lo último que necesitaba era que algún poderoso lord mercader investigara la muerte de su hija y armara un escándalo por el asunto."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:144
translate es qst_guild_price_life_daughter_kidnappers_leave_a28ecfd1:

