translate es qst_guild_price_life_daughter_threaten_426baa97:

    # MARAUDER_LEADER "You think we're just going to walk away from here with nothing after risking our necks?!"
    MARAUDER_LEADER "¡¿Crees que nos vamos a ir de aquí sin nada después de arriesgar el pellejo?!"

