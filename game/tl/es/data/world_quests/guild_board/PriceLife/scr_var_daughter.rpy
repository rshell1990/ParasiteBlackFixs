translate es qst_guild_price_life_daughter_start_c24aa716:

    # MC @ angry "(I can't just drop my blade, but if I don't, they'll just kill the girl!)"
    MC @ angry "(No puedo soltar la espada sin más, ¡pero si no lo hago, matarán a la chica!)"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:40
translate es qst_guild_price_life_daughter_start_6ee558b5:

    # MARAUDER_LEADER "What are you waiting for, boy?"
    MARAUDER_LEADER "¿A qué esperas, chico?"

