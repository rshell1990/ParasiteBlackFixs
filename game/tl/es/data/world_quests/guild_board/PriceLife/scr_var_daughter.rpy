

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:4
translate es qst_guild_price_life_daughter_start_345114d3:

    # "Following the instructions left by both the Merchant and the marauders ransom note, I headed East towards the forests."
    "Siguiendo las instrucciones dejadas tanto por el mercader como por la nota de rescate de los merodeadores, me dirigí hacia el este, hacia los bosques."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:8
translate es qst_guild_price_life_daughter_start_b904e1a2:

    # "Deep into the woods after several hours of travel, I stumbled into the marauders camp, where the Merchants daughter, a feline looking humanoid, was held captive in a cage."
    "En lo profundo del bosque, tras varias horas de viaje, tropecé con el campamento de los merodeadores, donde la hija del mercader, una humanoide de aspecto felino, estaba cautiva en una jaula."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:14
translate es qst_guild_price_life_daughter_start_d5a2cd76:

    # MARAUDER_LEADER "About time one of you showed up."
    MARAUDER_LEADER "Ya era hora de que apareciera uno de vosotros."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:15
translate es qst_guild_price_life_daughter_start_79ae2277:

    # MARAUDER_LEADER "You here for the girl then?"
    MARAUDER_LEADER "¿Entonces estás aquí por la chica?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:17
translate es qst_guild_price_life_daughter_start_cefa4cbb:

    # MC @ talk "I am. Is she unharmed?"
    MC @ talk "Lo estoy. ¿Está ilesa?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:17
translate es qst_guild_price_life_daughter_start_72957a32:

    # MARAUDER_LEADER "Ask her yourself."
    MARAUDER_LEADER "Pregúntaselo tú mismo."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:19
translate es qst_guild_price_life_daughter_start_be6599fc:

    # "The marauder turned back towards the girl trapped in her cage."
    "El merodeador se volvió hacia la chica atrapada en su jaula."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:20
translate es qst_guild_price_life_daughter_start_efea22f5:

    # MARAUDER_LEADER "OI! YOU'RE FINE AREN'T YOU GIRL?"
    MARAUDER_LEADER "¡OYE! ESTÁS BIEN ¿VERDAD CHICA?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:22
translate es qst_guild_price_life_daughter_start_b822ae60:

    # "The katai growled from her cage."
    "La katai gruñó desde su jaula."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:23
translate es qst_guild_price_life_daughter_start_b4dbb2c8:

    # CALLIE "Release me now! Or else my father will-"
    CALLIE "¡Suéltame ahora! O mi padre-"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:23
translate es qst_guild_price_life_daughter_start_48f4a742:

    # MARAUDER_LEADER "SHUT IT CUNT!"
    MARAUDER_LEADER "¡CÁLLATE COÑO!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:25
translate es qst_guild_price_life_daughter_start_bc5fa8ed:

    # MARAUDER_LEADER "... See? She's fine, mouthy as ever ... Now, onto business then."
    MARAUDER_LEADER "... ¿Ves? Ella está bien, bocazas como siempre ... Ahora, a los negocios entonces."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:26
translate es qst_guild_price_life_daughter_start_9f35492d:

    # MARAUDER_LEADER "Did you bring the coin?"
    MARAUDER_LEADER "¿Trajiste el dinero?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:28
translate es qst_guild_price_life_daughter_start_b628b1a8:

    # MC @ talk "I did."
    MC @ talk "Lo hice."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:29
translate es qst_guild_price_life_daughter_start_1d8e510d:

    # "The Marauder leader smiled."
    "El líder de los merodeadores sonrió."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:29
translate es qst_guild_price_life_daughter_start_b9fb7973:

    # MARAUDER_LEADER "Well then, this is just perfect."
    MARAUDER_LEADER "Bueno, entonces, esto es perfecto."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:30
translate es qst_guild_price_life_daughter_start_d2f11601:

    # MARAUDER_LEADER "What's to stop me just killing you, keeping the ransom coin for ourselves and selling this little slut off as a slave?"
    MARAUDER_LEADER "¿Qué me impide matarte, quedarnos con el dinero del rescate y vender a esta zorrita como esclava?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:31
translate es qst_guild_price_life_daughter_start_c8195006:

    # MARAUDER_LEADER "We outnumber you three to one."
    MARAUDER_LEADER "Te superamos en número tres a uno."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:34
translate es qst_guild_price_life_daughter_start_721fefca:

    # MARAUDER_LEADER "HA! I'll take my chances!"
    MARAUDER_LEADER "¡Ja! ¡Me arriesgaré!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:35
translate es qst_guild_price_life_daughter_start_007cc25b:

    # MARAUDER_LEADER "Now drop the sword."
    MARAUDER_LEADER "Ahora suelta la espada."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:36
translate es qst_guild_price_life_daughter_start_7d5e397b:

    # "The leader whistled and pointed at one of the men, who moved to place a blade towards the girl in the cage."
    "El jefe silbó y señaló a uno de los hombres, quien se acercó y apuntó con una espada a la chica que estaba en la jaula."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:37
translate es qst_guild_price_life_daughter_start_f7c121b5:

    # CALLIE "P-PLEASE DON'T KILL ME!"
    CALLIE "¡P-POR FAVOR, NO ME MATÉIS!"

