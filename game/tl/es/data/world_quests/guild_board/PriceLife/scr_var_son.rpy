    MC "{b}¿Quieres reanudar las negociaciones?{/b}"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:44
translate es qst_guild_price_life_son_start_bac28c56:

    # "The fumbling leader of the marauders mumbled yes as he stared up and down horrified at the creature before him."
