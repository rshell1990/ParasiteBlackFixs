    MARAUDER_LEADER "¡SUÉLTALA!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:40
translate es qst_guild_price_life_son_start_d8a8d0cf:

    # MC @ angry "(Fuck, I can't believe I'm going to do this!)"
    MC @ angry "(¡Joder, no me puedo creer que vaya a hacer esto!)"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:36
translate es qst_guild_price_life_son_start_efd0e7b1:

    # "Stepping a few feet away from the Marauders, their eyes widened in horror as I tore at my own flesh, revealing the monstrous form beneath."
    "Alejándome unos metros de los merodeadores, sus ojos se abrieron de par en par, horrorizados, cuando desgarré mi propia carne, revelando la monstruosa forma que había debajo."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:41
translate es qst_guild_price_life_son_start_1407cf85:

    # MARAUDER_LEADER "WHAT THE FUCK?!"
