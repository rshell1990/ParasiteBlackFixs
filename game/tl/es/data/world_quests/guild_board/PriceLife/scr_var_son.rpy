

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:4
translate es qst_guild_price_life_son_start_345114d3:

    # "Following the instructions left by both the Merchant and the marauders ransom note, I headed East towards the forests."
    "Siguiendo las instrucciones dejadas tanto por el mercader como por la nota de rescate de los merodeadores, me dirigí hacia el este, hacia los bosques."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:8
translate es qst_guild_price_life_son_start_1240d067:

    # "Deep into the woods after several hours of travel, I stumbled into the marauders camp, where the Merchants son, a feline looking humanoid, was held captive in a cage."
    "En lo profundo del bosque, tras varias horas de viaje, tropecé con el campamento de los merodeadores, donde el hijo del mercader, un humanoide de aspecto felino, estaba cautivo en una jaula."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:14
translate es qst_guild_price_life_son_start_d5a2cd76:

    # MARAUDER_LEADER "About time one of you showed up."
    MARAUDER_LEADER "Ya era hora de que apareciera uno de vosotros."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:15
translate es qst_guild_price_life_son_start_bf7565b1:

    # MARAUDER_LEADER "You here for the boy then?"
    MARAUDER_LEADER "¿Entonces estás aquí por el chico?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:17
translate es qst_guild_price_life_son_start_797eb940:

    # MC @ talk "I am. Is he unharmed?"
    MC @ talk "Lo estoy. ¿Está ileso?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:17
translate es qst_guild_price_life_son_start_8cddc005:

    # MARAUDER_LEADER "Ask him yourself."
    MARAUDER_LEADER "Pregúntaselo tú mismo."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:19
translate es qst_guild_price_life_son_start_ad676679:

    # "The marauder turned back towards the boy trapped in his cage."
    "El merodeador se volvió hacia el chico atrapado en su jaula."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:20
translate es qst_guild_price_life_son_start_bb83fc3c:

    # MARAUDER_LEADER "OI! YOU'RE FINE AREN'T YOU BOY?"
    MARAUDER_LEADER "¡OYE! ESTÁS BIEN, ¿VERDAD CHICO?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:22
translate es qst_guild_price_life_son_start_130b5b72:

    # "The katai meekly nodded, but I noticed a few darkened bruises around his body."
    "El katai asintió dócilmente, pero noté unos cuantos moratones oscurecidos alrededor de su cuerpo."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:23
translate es qst_guild_price_life_son_start_7f9b2145:

    # MARAUDER_LEADER "See? He's fine... Now, onto business then."
    MARAUDER_LEADER "¿Ves? Está bien... Ahora, a los negocios entonces."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:24
translate es qst_guild_price_life_son_start_9f35492d:

    # MARAUDER_LEADER "Did you bring the coin?"
    MARAUDER_LEADER "¿Trajiste el dinero?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:26
translate es qst_guild_price_life_son_start_b628b1a8:

    # MC @ talk "I did."
    MC @ talk "Lo hice."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:27
translate es qst_guild_price_life_son_start_1d8e510d:

    # "The Marauder leader smiled."
    "El líder de los merodeadores sonrió."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:27
translate es qst_guild_price_life_son_start_b9fb7973:

    # MARAUDER_LEADER "Well then, this is just perfect."
    MARAUDER_LEADER "Bueno, entonces, esto es perfecto."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:28
translate es qst_guild_price_life_son_start_d067d3c1:

    # MARAUDER_LEADER "What's to stop me just killing you, keeping the ransom coin for ourselves and selling this little cunt off as a slave?"
    MARAUDER_LEADER "¿Qué me impide matarte, quedarnos con el dinero del rescate y vender a este zorrito como esclavo?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:29
translate es qst_guild_price_life_son_start_c8195006:

    # MARAUDER_LEADER "We outnumber you three to one."
    MARAUDER_LEADER "Te superamos en número tres a uno."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:32
translate es qst_guild_price_life_son_start_721fefca:

    # MARAUDER_LEADER "HA! I'll take my chances!"
    MARAUDER_LEADER "¡Ja! ¡Me arriesgaré!"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:33
translate es qst_guild_price_life_son_start_007cc25b:

    # MARAUDER_LEADER "Now drop the sword."
