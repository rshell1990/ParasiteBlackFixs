# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:34
translate es qst_guild_price_life_son_start_b87ea3bf:

    # "The leader whistled and pointed at one of the men, who moved to place a blade towards the boy in the cage."
    "El jefe silbó y señaló a uno de los hombres, quien se acercó y apuntó con una espada al chico que estaba en la jaula."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:35
translate es qst_guild_price_life_son_start_f0c18936:

    # "He could only whimper and cry from his confinement, pleading for his life."
    "Desde su jaula, solo podía gemir y llorar, suplicando por su vida."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:36
translate es qst_guild_price_life_son_start_bc4faf8e:

    # MC @ angry "(Fuck.)"
    MC @ angry "(Joder)."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:37
translate es qst_guild_price_life_son_start_b1e01235:

    # MC @ angry "(I can't just drop my blade, but if I don't, they'll just kill the boy!)"
    MC @ angry "(No puedo soltar la espada sin más, ¡pero si no lo hago, matarán al chico!)"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:38
translate es qst_guild_price_life_son_start_6ee558b5:

    # MARAUDER_LEADER "What are you waiting for, boy?"
    MARAUDER_LEADER "¿A qué esperas, chico?"

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:39
