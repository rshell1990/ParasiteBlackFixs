

translate es strings:

    # game/data/world_quests/guild_board/Rodents/logic.rpy:5
    old "Investigate the sewers"
    new "Investiga las alcantarillas"

    # game/data/world_quests/guild_board/Rodents/logic.rpy:5
    old "It's time to delve into the sewers, see how the local fauna is doing."
    new "Es hora de adentrarse en las alcantarillas, ver cómo está la fauna local."

    # game/data/world_quests/guild_board/Rodents/logic.rpy:5
    old "Defeat the swarm"
    new "Derrota al enjambre"

    # game/data/world_quests/guild_board/Rodents/logic.rpy:5
    old "The 'alarming reports' were indeed true — the place is crawling with oversized rats. Weapons free!"
    new "Los 'informes alarmantes' eran ciertos: el lugar está plagado de ratas de gran tamaño. ¡Atacad a discreción!"

    # game/data/world_quests/guild_board/Rodents/logic.rpy:5
    old "Deratification complete. Time to collect our reward."
    new "Deseratización completada. Es hora de recoger nuestra recompensa."

    # game/data/world_quests/guild_board/Rodents/logic.rpy:10
    old "Rodents of unusual size"
    new "Ratas de tamaño inusual"

    # game/data/world_quests/guild_board/Rodents/logic.rpy:11
    old "There have been alarming reports about aggressive rats the size of dogs emerging out of the sewers at night and stealing whole barrels of food."
    new "Ha habido informes alarmantes sobre ratas agresivas del tamaño de perros que salen de las alcantarillas por la noche y roban barriles enteros de comida."

    # game/data/world_quests/guild_board/Rodents/logic.rpy:12
    old "Huge rats, huh?"
    new "Ratas enormes, ¿eh?"

    # game/data/world_quests/guild_board/Rodents/logic.rpy:12
    old "Sounds like I'll have to fight them out of the city's sewers."
    new "Parece que tendré que luchar contra ellas fuera de las alcantarillas de la ciudad."

