# game/data/world_quests/guild_board/Rodents/scr.rpy:31
translate es qst_guild_rodents_96622ec7:

    # ELENA @ shock "Oh gods ..."
    ELENA @ shock "Oh dioses..."

# game/data/world_quests/guild_board/Rodents/scr.rpy:32
translate es qst_guild_rodents_c66c3ea0:

    # ELENA @ shock "There's so many of them!"
    ELENA @ shock "¡Hay tantas!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:36
translate es qst_guild_rodents_e5cd033b:

    # MYU @ scared "M-Myu!"
    MYU @ scared "¡M-Myu!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:40
translate es qst_guild_rodents_16665f31:

    # MARKUS "[player_name!t]!"
    MARKUS "¡[player_name!t]!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:43
translate es qst_guild_rodents_e470a966:

    # MC "(Fuck!)"
    MC "(¡Joder!)"

# game/data/world_quests/guild_board/Rodents/scr.rpy:45
translate es qst_guild_rodents_b5e51ab2:

    # MC "STAND READY TO FIGHT!"
    MC "¡PREPARAOS PARA LUCHAR!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:55
translate es qst_guild_rodents_460723ef:

    # "Atop their slain kins corpses, more clambered their way towards us, frothing at the mouth."
    "Encima de los cadáveres de sus parientes muertos, otros trepaban hacia nosotros, echando espuma por la boca."

# game/data/world_quests/guild_board/Rodents/scr.rpy:59
translate es qst_guild_rodents_c49d8ac9:

    # MC "(They just keep coming!)"
    MC "(¡No paran de venir!)"

# game/data/world_quests/guild_board/Rodents/scr.rpy:64
translate es qst_guild_rodents_1c42b967:

    # "The sewer became a haze of red and blood as I tore my way through dozens more of the creatures."
    "La alcantarilla se convirtió en una neblina de rojo y sangre mientras me abría paso a través de docenas más de criaturas."

# game/data/world_quests/guild_board/Rodents/scr.rpy:68
translate es qst_guild_rodents_287c0477:

    # "The red mist enveloped me as the rage swept over, digging my hands into the guts of one of the creatures before tearing it in two."
    "La niebla roja me envolvió mientras la rabia me invadía, clavando mis manos en las tripas de una de las criaturas antes de partirla en dos."

# game/data/world_quests/guild_board/Rodents/scr.rpy:71
translate es qst_guild_rodents_b0e488d1:

    # ELENA @ shock "How many more of them are there?!"
    ELENA @ shock "¡¿Cuántas más hay?!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:75
translate es qst_guild_rodents_47abd27b:

    # MARKUS @ angry "Grghh! Burn! FUCKING BURN YOU RODENT FUCKS!"
    MARKUS @ angry "¡Grghh! ¡Arded! ¡ARDED, MALDITOS ROEDORES DE MIERDA!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:78
translate es qst_guild_rodents_f7a51131:

    # "The next wave came hurtling over, leaping onto me where they gnashed and mauled trying to force their way through my armor."
    "La siguiente oleada llegó a toda velocidad, saltando sobre mí, donde me mordisquearon e intentaron abrirse paso a través de mi armadura."

# game/data/world_quests/guild_board/Rodents/scr.rpy:83
translate es qst_guild_rodents_eefe4a77:

    # "Throwing them off me, I stomped down on one beneath my feet, crushing its skull before I saw once again, another wave charging towards us..."
    "Arrojándolos lejos de mí, pisoteé a uno bajo mis pies, aplastándole el cráneo antes de ver de nuevo, otra ola cargando hacia nosotros..."

# game/data/world_quests/guild_board/Rodents/scr.rpy:85
translate es qst_guild_rodents_79a800ff:

    # MC "They're thinning out! Just a little more!"
    MC "¡Están disminuyendo! ¡Un poco más!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:90
translate es qst_guild_rodents_55f1e704:

    # "Slaying the last of this wave, the remaining rats turned and fled deeper into the darkness of the sewers."
    "Al matar a las últimas de esta oleada, las ratas restantes se dieron la vuelta y huyeron a lo más profundo de la oscuridad de las alcantarillas."

# game/data/world_quests/guild_board/Rodents/scr.rpy:95
translate es qst_guild_rodents_2d761257:

    # MC "{i}*Huff* *Huff*{/i}"
    MC "{i}*Uff* *Uff*{/i}"

# game/data/world_quests/guild_board/Rodents/scr.rpy:96
translate es qst_guild_rodents_ba69243c:

    # MC "(I thought they'd never stop coming...)"
    MC "(Pensé que nunca pararían de venir...)"

# game/data/world_quests/guild_board/Rodents/scr.rpy:99
translate es qst_guild_rodents_0a80a6d6:

    # MARKUS "Well, job well done I guess."
    MARKUS "Bueno, trabajo bien hecho, supongo."

# game/data/world_quests/guild_board/Rodents/scr.rpy:95
translate es qst_guild_rodents_e5af19f1:

    # MARKUS @ shock "Now can we get out of here now before they decide they'd like to give eating us another go?"
    MARKUS @ shock "¿Podemos salir de aquí antes de que decidan volver a comernos?"

# game/data/world_quests/guild_board/Rodents/scr.rpy:104
translate es qst_guild_rodents_d6ab0143:

    # MYU @ scared "Myu isn't very tasty!"
    MYU @ scared "¡Myu no es muy sabrosa!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:107
translate es qst_guild_rodents_3473bfb5:

    # MC "Let's take a head or two for proof and be done with this quest already!"
    MC "¡Cojamos una cabeza o dos como prueba y acabemos ya con esta misión!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:115
translate es qst_guild_rodents_8bdfd3b5:

    # "Shortly after, exhausted from the gruelling experience, we made our way back to the surface and after presenting a few heads of the rats, took our reward."
    "Poco después, agotados por la extenuante experiencia, volvimos a la superficie y, tras presentar unas cuantas cabezas de las ratas, nos llevamos nuestra recompensa."

# game/data/world_quests/guild_board/Rodents/scr.rpy:117
translate es qst_guild_rodents_5fd8b026:

    # "Shortly after, exhausted from the gruelling experience, I made my way back to the surface and after presenting a few heads of the rats, took my reward."
    "Poco después, agotado por la extenuante experiencia, volví a la superficie y, tras presentar unas cuantas cabezas de las ratas, me llevé mi recompensa."
