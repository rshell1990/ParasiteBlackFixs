translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_22a3dca5:

    # REGINA @ angry_talk "Tell. No. One."
    REGINA @ angry_talk "No. Lo. Digas."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:86
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_9cdbbeed:

    # REGINA @ talk "People will think you were possessed by some dark spirit or something."
    REGINA @ talk "La gente pensará que estás poseído por un espíritu oscuro o algo así."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:87
