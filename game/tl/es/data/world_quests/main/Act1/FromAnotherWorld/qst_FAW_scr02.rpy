    REGINA @ smile_talk "Alabados sean los dioses."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:24
translate es qst_FromAnotherWorld_ReturnHome_de6a39b0:

    # REGINA @ smile_talk "It’s a miracle you’re both alive."
    REGINA @ smile_talk "Es un milagro que ambos estéis vivos."

