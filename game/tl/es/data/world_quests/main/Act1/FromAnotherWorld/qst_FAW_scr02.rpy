translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_7ca38eb6:

    # MC @ talk "I don’t really know."
    MC @ talk "La verdad es que no lo sé."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:62
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_cd733010:

    # REGINA @ talk "Well, I’ve heard everything from you both stole horses and fought your way back like a pair of men possessed, riding day and night till you got home..."
    REGINA @ talk "Bueno, lo he oído todo, desde que ambos robásteis caballos y luchásteis de vuelta como un par de hombres poseídos, cabalgando día y noche hasta llegar a casa..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:63
