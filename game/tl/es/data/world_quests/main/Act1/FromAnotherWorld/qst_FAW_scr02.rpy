translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_6fae0609:

    # REGINA @ talk "Busy dealing with her usual Inquisitor business... You know how she is, always busy."
    REGINA @ talk "Ocupada con sus asuntos habituales de inquisidora... Ya sabes cómo es, siempre ocupada."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:46
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_5e5d29c1:

    # MC @ talk "Did she visit me on the ward?"
    MC @ talk "¿Me visitó en la enfermería?"

