translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_60784276:

    # REGINA @ talk "I don’t know, but she came to see me to make sure I was coping alright."
    REGINA @ talk "No lo sé, pero vino a verme para asegurarse de que lo estaba llevando bien."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:48
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_d825194b:

    # MC @ talk "... I’m sorry for putting you both through so much."
    MC @ talk "... Siento haberos hecho pasar por tanto."

