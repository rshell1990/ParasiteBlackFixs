# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:30
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_498911e8:

    # REGINA @ talk "They searched your room but found nothing."
    REGINA @ talk "Registraron tu habitación pero no encontraron nada."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:31
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_9c998003:

    # MC @ talk "What did you tell them?"
    MC @ talk "¿Qué les has dicho?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:32
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_e169a1c3:

    # REGINA @ talk "Just that you weren’t blessed with any kind of magecraft, let alone black."
    REGINA @ talk "Solo que no fuiste bendecido con ningún tipo de magia, y mucho menos negra."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:33
