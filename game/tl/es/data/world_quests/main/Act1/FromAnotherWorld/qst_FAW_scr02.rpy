translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_b49f6fdc:

    # REGINA @ talk "I see."
    REGINA @ talk "Ya veo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:102
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_c28408c1:

    # MC @ talk "Do you think I should be worried? How serious is this?"
    MC @ talk "¿Crees que debería preocuparme? ¿Es grave?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:103
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_e09176d9:

    # REGINA @ talk "I think you should {i}keep quiet{/i} till we know more about what exactly it is we’re dealing with."
    REGINA @ talk "Creo que deberías {i}guardar silencio{/i} hasta que sepamos con qué nos enfrentamos exactamente."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:104
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_014d1605:

    # REGINA @ talk "... But thank you for trusting me."
    REGINA @ talk "... Pero gracias por confiar en mí."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:107
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_e9b7963c:

    # MC @ talk "I can’t remember anything after that..."
    MC @ talk "No recuerdo nada después de eso..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:108
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_c243cf46:

    # REGINA @ talk "Hmm... I see."
    REGINA @ talk "Hmm... Ya veo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:109
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_f76b73df:

    # REGINA @ talk "Well, we best keep an eye on you for the next few days."
    REGINA @ talk "Bueno, será mejor que te vigilemos los próximos días."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:110
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_77bb2010:

    # REGINA @ talk "But I’m glad you’re home safe, I’ve really missed you."
    REGINA @ talk "Pero me alegro de que estés a salvo en casa, te he echado mucho de menos."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:111
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_1a999818:

    # "Regina looked back to the brewing pot then snapped her fingers with realisation."
    "Regina miró hacia la olla y chasqueó los dedos al darse cuenta."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:112
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_0439d3e0:

    # REGINA @ shock_talk "I didn’t buy enough food for two!"
    REGINA @ shock_talk "¡No compré suficiente comida para dos!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:113
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_092fcd93:

    # MC @ talk "[regina_ref_cap!t], it’s no problem."
    MC @ talk "[regina_ref_cap!t], no hay problema."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:114
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_1818426b:

    # REGINA @ talk "No, wait here!"
    REGINA @ talk "¡No, espera aquí!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:115
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_b1043635:

    # REGINA @ talk "I’ll come back with some more vegetables to make you a decent stew, it’s the least I can do."
    REGINA @ talk "Volveré con más verduras para hacerte un guiso decente, es lo menos que puedo hacer."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:116
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_9e88cc83:

    # MC @ talk "I’m meant to be meeting Mark—"
    MC @ talk "Se supone que debo reunirme con Mark—"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:117
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_ac49d286:

    # REGINA @ smile_talk "I’ll be back in just a moment!"
    REGINA @ smile_talk "¡Volveré en un momento!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:120
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_70efe6d8:

    # "Before I could stop her, [regina_ref!t] was out of the door hurrying to buy some food."
    "Antes de que pudiera detenerla, [regina_ref!t]salió por la puerta corriendo a comprar comida."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:121
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_9d8f7bf6:

    # MC @ talk "{i}*Sigh*{/i}"
    MC @ talk "{i}*Suspiro*{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:126
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_7fd05c85:

    # "Peering at the crack in the doorway to my bedroom, I ventured inside."
    "Asomándome a la rendija de la puerta de mi dormitorio, me aventuré a entrar."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:127
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_2f9b1637:

    # "The room was warm, but untouched since I had last been in it."
    "La habitación era cálida, pero estaba intacta desde la última vez que había estado en ella."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:128
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_611d7f4f:

    # "[regina_ref_cap!t] had made sure to dust and make the bed, maintaining it for my improbable return."
    "[regina_ref_cap!t] se había asegurado de quitar el polvo y hacer la cama, dejándola lista para mi improbable regreso."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:129
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_ea71628f:

    # "It was odd standing in it again."
    "Era extraño estar de pie en ella de nuevo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:130
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_e99550db:

    # "It felt like it belonged to some different time from a world now far away that I was no longer a part of."
    "Parecía pertenecer a una época diferente de un mundo ya lejano del que yo ya no formaba parte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:132
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_69e7ddcf:

    # "All of mine and Markus’ nights of scheming unfolded here, often spent dreamily looking out towards the palace."
    "Todas las noches de maquinaciones mías y de Markus se desarrollaban aquí, a menudo las pasaba soñando mirando hacia el palacio."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:133
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_caf32118:

    # "It all seemed so simple back then... even in a world as chaotic as this one."
    "Todo parecía tan sencillo entonces... incluso en un mundo tan caótico como éste."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:134
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_c41f0caa:

    # "Now, everything seems so uncertain, like we are charting a course into some terrible storm, unable to stop ourselves as we are pulled into the watery ravages of the dreaded Black Ocean."
    "Ahora, todo parece tan incierto, como si estuviéramos trazando un rumbo hacia una terrible tormenta, incapaces de detenernos mientras somos arrastrados hacia los estragos acuosos del temido océano Negro."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:136
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_2898c036:

    # "Both of us should have died that night at the fort, and a part of me {i}still feels like we did{/i}."
    "Ambos deberíamos haber muerto esa noche en el fuerte, y una parte de mí {i}todavía siente que lo hicimos{/i}."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:137
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_9fd34d7c:

    # "Turning to look at the old, cracked mirror, I stared into it, hoping to invoke that strange voice from last night."
    "Volviéndome hacia el viejo espejo agrietado, me miré fijamente en él, esperando invocar aquella extraña voz de la noche anterior."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:138
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_b371400e:

    # MC @ talk "...Hello?"
    MC @ talk "...¿Hola?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:139
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_7760b7a8:

    # MC @ talk "Are you there? "
    MC @ talk "¿Estás ahí?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:140
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_f9ca0dad:

    # MC @ talk "{i}Spirit?{/i}"
    MC @ talk "{i}¿Espíritu?{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:141
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_b28233a2:

    # "Unsurprisingly, no answer came."
    "Como era de esperar, no hubo respuesta."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:142
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_2bcf7e2a:

    # MC "Hm..."
    MC "Hm..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:143
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_e4b866cd:

    # "Heading over to my old bed, I flopped down onto it."
    "Dirigiéndome a mi antigua cama, me dejé caer en ella."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:144
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_db3474b8:

    # "The frame creaked, struggling more than ever to support me, but as I sunk into the softness of it, I sighed with relief."
    "El somier crujió, esforzándose más que nunca por sostenerme, pero al hundirme en su suavidad, suspiré aliviado."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:145
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_9ee2712d:

    # "I hadn’t felt something so comfortable in months, the luxuriousness of it was almost like some distant memory."
    "Hacía meses que no sentía algo tan cómodo, su lujo era casi como un recuerdo lejano."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:147
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_af59c89a:

    # "Closing my eyes for a moment, I felt..."
    "Cerrando los ojos un momento, sentí..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:156
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_b19e38ff:

    # "My eyes shot open as I sat upright, desperately gasping for air."
    "Abrí los ojos de golpe y me incorporé, jadeando desesperadamente."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:159
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_4a651378:

    # MC @ surprised "{i}... Fuck.{/i}"
    MC @ surprised "{i}... Joder.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:161
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_9477c75e:

    # "I heard the front door swing open once again to announce [regina_ref!t]'s return."
    "Oí que la puerta principal se abría una vez más para anunciar la llegada de [regina_ref!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:162
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_274476ae:

    # REGINA @ talk "Are you still here?"
    REGINA @ talk "¿Sigues aquí?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:163
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_bb6054c4:

    # MC @ talk "I’m just in my room."
    MC @ talk "Solo estoy en mi habitación."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:164
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_6aaa7d1e:

    # "After listening out, a few moments later I heard some soft footsteps as the door crept open and [regina_ref!t] peeked inside."
    "Después de escuchar, unos instantes más tarde oí unos pasos suaves cuando la puerta se abrió sigilosamente y [regina_ref!t] se asomaba al interior."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:166
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_8798cba0:

    # REGINA @ talk "Is everything okay, dear?"
    REGINA @ talk "¿Va todo bien, cariño?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:167
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_90bda528:

    # MC @ talk "I’m fine..."
    MC @ talk "Estoy bien..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:168
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_b7b3534a:

    # MC @ talk "It’s just..."
    MC @ talk "Es solo que..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:169
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_a2d8a856:

    # MC @ talk "Strange being back here, is all."
    MC @ talk "Es extraño estar de vuelta aquí, eso es todo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:170
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_71d4718f:

    # "Regina gave me a sympathetic look as she nodded in some small understanding."
    "Regina me miró con simpatía y asintió con un gesto de comprensión."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:171
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_d03d1560:

    # REGINA @ sad_talk "Come, I’m about to put the stew on for you."
    REGINA @ sad_talk "Ven, estoy a punto de poner el estofado para ti."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:172
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_c0c1b183:

    # MC @ talk "Alright..."
    MC @ talk "Está bien..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:173
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_e381c644:

    # MC @ talk "... [regina_ref_cap!t]?"
    MC @ talk "... ¿[regina_ref_cap!t]?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:174
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_2b9cda49:

    # REGINA @ talk "Yes?"
    REGINA @ talk "¿Sí?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:175
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_f2baaa22:

    # MC @ talk "Thank you, for everything."
    MC @ talk "Gracias, por todo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:176
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_be966e8f:

    # "Regina smiled warmly, her eyes welling up ever so slightly before sliding out of the doorway back towards her cooking pot."
    "Regina sonrió cálidamente y sus ojos se humedecieron ligeramente antes de salir por la puerta y volver a su olla."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:180
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_7e88966e:

    # "A short while later, the homely food was served and I devoured every last scrap of it."
    "Poco después, me sirvió la comida casera y devoré hasta el último trozo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:181
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_9913f732:

    # "We talked about many things, the good and the bad of my experiences with the Scouts, but I did my best to avoid discussing the fort and Duprey and Borras’ deaths."
    "Hablamos de muchas cosas, de lo bueno y lo malo de mis experiencias con los exploradores, pero hice todo lo posible por evitar hablar del fuerte y de las muertes de Duprey y Borras."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:182
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_34f338ce:

    # "Regina informed me that Adara had visited nearly every day to find out if I’d written any letters home that she could read."
    "Regina me informó de que Adara me había visitado casi todos los días para saber si había escrito alguna carta a casa que ella pudiera leer."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:183
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_addc3724:

    # "I explained to [regina_ref!t] that I was a part of the Adventurers' guild now. It made her uncomfortable given that I had barely survived my trek with the Scouts..."
    "Le expliqué a [regina_ref!t] que ahora formaba parte del gremio de los aventureros. Se sintió incómoda, ya que apenas había sobrevivido a mi viaje con los exploradores..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:184
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_42e29a17:

    # "...But she didn’t let her displeasure be known through anything other than pursing her lips and going a little quiet."
    "...Pero no dejó traslucir su disgusto más que frunciendo los labios y callándose un poco."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:185
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_2ece8a6b:

    # "Finally, placing my bowl down onto the table, I rose from my seat."
    "Finalmente, dejé el cuenco sobre la mesa y me levanté."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:190
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_c229410b:

    # MC @ talk "I have to go meet Markus now, we’ve got to show up at the Adventurers' Guild."
    MC @ talk "Tengo que reunirme con Markus ahora, tenemos que presentarnos en el gremio de aventureros."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:192
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_8f36c5e5:

    # REGINA @ talk "Will you be back later?"
    REGINA @ talk "¿Volverás más tarde?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:193
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_5bbe96f5:

    # MC @ talk "Of course, though it might not be till quite a bit later..."
    MC @ talk "Por supuesto, aunque puede que no sea hasta bastante más tarde..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:194
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_a5e8ce64:

    # MC @ talk "Do you need anything?"
    MC @ talk "¿Necesitas algo?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:195
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_21b02044:

    # REGINA @ talk "Hmm... Well, if you’re offering..."
    REGINA @ talk "Hmm... Bueno, si te estás ofreciendo..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:196
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_66035ecd:

    # REGINA @ talk "Could you pick up something for me from the Blacksmiths?"
    REGINA @ talk "¿Podrías recoger algo para mí de la herrería?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:197
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_2f447204:

    # MC @ talk "What is it?"
    MC @ talk "¿De qué se trata?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:198
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_dbff95b5:

    # MC @ talk "[regina_ref_cap!t] blushed as she spoke but waved off the question before I could ask any more."
    MC @ talk "[regina_ref_cap!t] se sonrojó al hablar, pero hizo un gesto con la mano para que dejara el tema antes de que pudiera preguntarle nada más."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:200
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_0a2b8690:

    # REGINA @ talk "Nothing, just a little something for myself..."
    REGINA @ talk "Nada, solo algo para mí..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:201
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_2ded8107:

    # REGINA @ talk "It should be wrapped in a box, just tell them it’s for me."
    REGINA @ talk "IDebería estar envuelto en una caja, solo diles que es para mí."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:202
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_f1f0b2cc:

    # MC @ talk "Sure."
    MC @ talk "Claro."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:204
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_5d0f376e:

    # MC @ talk "Well, I best get a move on."
    MC @ talk "Bueno, será mejor que me ponga en marcha."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:206
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_266a8d3f:

    # REGINA @ talk "Okay, dear."
    REGINA @ talk "Muy bien, cariño."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:207
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_a6585a75:

    # REGINA @ talk "Just... {i}be safe.{/i}"
    REGINA @ talk "Solo... {i}ten cuidado.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:209
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_8b411f76:

    # "As I was about to leave, I once again felt her press up against me."
    "Cuando estaba a punto de irme, volví a sentir que se apretaba contra mí."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:208
translate es qst_FromAnotherWorld_ReturnHome_ReginaTalk_00478683:

    # "Slowly, [regina_ref!t]'s embrace lessened as she let me head off and finally make my way towards Markus' house."
    "Poco a poco, el abrazo de [regina_ref!t] fue disminuyendo mientras me dejaba marchar para dirigirme finalmente hacia la casa de Markus."

