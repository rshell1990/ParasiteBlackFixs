    MARKUS "¿Puedes sentirlo? ¡Es como fuego en mis venas!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:142
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_1dfde4e8:

    # MC "I feel... {i}strong,{/i}"
    MC "Me siento... {i}fuerte.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:143
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_4b04075e:

    # MARKUS "I wonder..."
    MARKUS "Me pregunto..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:145
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_3d171ada:

    # "Markus sprinted forward, launching himself into the air as his wings lifted him off the ground."
    "Markus esprintó hacia delante, lanzándose al aire mientras sus alas le levantaban del suelo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:146
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_a1321702:

    # "With an elated cry of joy, he called to me to keep up with him."
    "Con un grito de júbilo, me pidió que le siguiera."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:149
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_0c33d2bc:

    # "Chasing him like some great bird in the sky, I found instinctively that sprinting after him on all fours meant that I could achieve speeds faster than any human could ever hope to."
    "Persiguiéndolo como a un gran pájaro en el cielo, descubrí instintivamente que esprintar tras él a cuatro patas significaba que podía alcanzar velocidades superiores a las que cualquier humano podría aspirar jamás."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:151
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_71005e1e:

    # "Suddenly, my tentacles slammed into the ground, throwing me along in steady motions as we crossed huge swathes of land in no time."
    "De repente, mis tentáculos se clavaron en el suelo, lanzándome con movimientos firmes mientras cruzábamos enormes extensiones de tierra en un abrir y cerrar de ojos."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:152
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_42c07e27:

    # "Finally, I caught up to Markus and the two of us settled down to catch our breath."
    "Finalmente, alcancé a Markus y los dos nos sentamos para recuperar el aliento."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:157
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_662e09b6:

