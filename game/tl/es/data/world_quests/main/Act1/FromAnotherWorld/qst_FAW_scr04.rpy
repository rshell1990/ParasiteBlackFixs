# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:139
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_28b878b7:

    # MARKUS "Incredible!"
    MARKUS "¡Increíble!"

