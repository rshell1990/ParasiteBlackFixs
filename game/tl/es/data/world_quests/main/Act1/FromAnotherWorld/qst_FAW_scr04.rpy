

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:8
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_da215666:

    # "Markus stood just outside the house, tense, eager to take off."
    "Markus se quedó a las puertas de la casa, tenso, ansioso por salir."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:9
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_1a7284ee:

    # MC "So Markus... What now?"
    MC "Entonces Markus... ¿Y ahora qué?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:10
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_14c45b53:

    # MC "We are so fucked."
    MC "Estamos muy jodidos."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:11
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_9db36875:

    # MC "Those things... If what they’re saying is true..."
    MC "Esas cosas... Si lo que dicen es verdad..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:12
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_f45c2726:

    # MARKUS "Let's go now."
    MARKUS "Vámonos ya."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:13
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_57421384:

    # MC "Yeah, I doubt the Guild will be as scary as the Scouts..."
    MC "Sí, dudo que el gremio dé tanto miedo como los exploradores..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:14
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_57f6ae64:

    # MARKUS "We're not going to the guild. Not yet."
    MARKUS "No iremos al gremio. Todavía no."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:15
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_e1a9bffd:

    # MC @ talk "Huh?"
    MC @ talk "¿Eh?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:16
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_95b51cb1:

    # MARKUS "Come now, we’re heading into {i}the Valley of Death{/i}."
    MARKUS "Vamos, iremos al {i}Valle de la Muerte{/i}."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:17
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_1c1920d2:

    # MC @ talk "What?!"
    MC @ talk "¡¿Qué?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:18
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_5728f581:

    # MARKUS "It's going to be alright."
    MARKUS "Todo va a salir bien."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:19
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_b1f50d7d:

    # MARKUS "We just need to get out of sight to practice changing into..."
    MARKUS "Selo tenemos que salir de la vista para practicar el cambio en..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:20
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_e3011a99:

    # MARKUS "{i}Whatever{/i} it is we’re going to change into."
    MARKUS "{i}Lo que sea{/i} que nos vayamos a transformar."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:21
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_e9e72c1d:

    # MC @ talk "Markus?!"
    MC @ talk "¡¿Markus?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:29
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_c5ba082c:

    # MC @ talk "Markus? Hold up!"
    MC @ talk "¿Markus? ¡Espera!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:30
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_db826fed:

    # MARKUS "I’ve thought about what they said..."
    MARKUS "He pensado en lo que han dicho..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:32
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_19c7f03a:

    # "Markus looked around, making sure no one listens in:"
    "Markus miró a su alrededor, asegurándose de que nadie escuchara:"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:33
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_0014df9f:

    # MARKUS "If what they say is true, perhaps this could be the key to having the life we’ve always wanted."
    MARKUS "Si lo que dicen es cierto, tal vez ésta podría ser la clave para tener la vida que siempre hemos deseado."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:34
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_6dfc9096:

    # MC @ talk "By being cursed?"
    MC @ talk "¿Estando maldito?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:35
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_f52b36e0:

    # MARKUS "It’s not a curse if we can manage it."
    MARKUS "No es una maldición si sabemos gestionarla."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:36
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_87e3f786:

    # MARKUS "Anyway, you heard them... they have already given us a lot of benefits."
    MARKUS "De todas formas, ya les has oído... ya nos han dado muchos beneficios."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:37
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_2374f272:

    # MARKUS "AND we owe those things our lives."
    MARKUS "Y les debemos la vida a esas cosas."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:38
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_c24ddfec:

    # MC @ talk "Markus, we have no actual idea of what’s going on with us!"
    MC @ talk "Markus, ¡no tenemos ni idea de lo que nos pasa!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:39
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_a83dacb2:

    # MARKUS "And we’re not ever going to know if we don’t at least try to understand them!"
    MARKUS "¡Y nunca lo sabremos si al menos no intentamos comprenderlos!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:40
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_1a988a98:

    # MARKUS "We have to give them a chance."
    MARKUS "Tenemos que darles una oportunidad."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:41
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_32d97cab:

    # MARKUS "If what those {i}things{/i} told us is true, this is the only way."
    MARKUS "Si lo que esas {i}cosas{/i} nos dijeron es cierto, este es el único camino."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:49
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_f86ed6dc:

    # "As we passed through the city gate, I felt all kinds of distressing thoughts popping in and out of existence."
    "Mientras atravesábamos la puerta de la ciudad, sentí que entraban y salían de mi mente todo tipo de pensamientos angustiosos."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:51
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_83b48436:

    # MC "(What are we doing? Will whatever Markus has in mind work? What exactly is going to happen to us now? Is there a 'cure' or something?)"
    MC "(¿Qué estamos haciendo? ¿Funcionará lo que Markus tiene en mente? ¿Qué nos va a pasar exactamente ahora? ¿Hay una 'cura' o algo así?)"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:53
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_f7d13ea9:

    # "Confident, Markus simply began making his way towards the expanse of the desert."
    "Confiado, Markus se dirigió hacia la inmensidad del desierto."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:54
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_7424c0b1:

    # MARKUS "Keep up, [player_name!t]!"
    MARKUS "¡Adelante, [player_name!t]!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:55
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_6cc0ac7f:

    # MC "Snapping out of it, I followed Markus."
    MC "Volviendo en mí, seguí a Markus."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:64
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_4a46d39e:

    # MC @ talk "... I still don’t like this."
    MC @ talk "... Todavía no me gusta esto."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:65
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_51fb4329:

    # MC @ talk "How will we explain to anyone what we were doing beyond the walls?"
    MC @ talk "¿Cómo explicaremos a alguien lo que hacíamos más allá de las murallas?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:66
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_832fb5ad:

    # MARKUS "Easy, we’re part of the Adventurer’s Guild now, remember? Just say we were patrolling for enemies or whatever..."
    MARKUS "Fácil, ahora somos parte del gremio de aventureros, ¿recuerdas? Solo di que estábamos patrullando en busca de enemigos o lo que sea..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:67
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_be0c9c6e:

    # MARKUS "Come on, as long as we’re out of view of the wall it should be safe enough for us."
    MARKUS "Vamos, mientras estemos fuera de la vista de la muralla debería ser lo suficientemente seguro para nosotros."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:68
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_78360619:

    # MC @ talk "As long as we don’t get clawed or bitten or disembowelled by some passing Demorai..."
    MC @ talk "Mientras no nos arañe, muerda o destripe algún demorai..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:69
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_c0c49e59:

    # "Trekking towards the great dunes of the valley, we finally arrived at a spot safely away from the gaze of any watchers on the walls."
    "Caminando hacia las grandes dunas del valle, llegamos por fin a un lugar a salvo de las miradas de los observadores de las murallas."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:70
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_fa07fe14:

    # MARKUS "Okay... This should do."
    MARKUS "Bien... Esto debería bastar."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:71
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_2b9f8100:

    # MC @ talk "...Well, what now?"
    MC @ talk "...Bueno, ¿y ahora qué?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:72
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_3e4c2a46:

    # MARKUS "I guess, we just change..."
    MARKUS "Supongo que simplemente nos transformamos..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:73
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_ebf63fbe:

    # MC @ talk "...How do we do it exactly?"
    MC @ talk "...¿Cómo lo hacemos exactamente?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:74
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_b55c30a7:

    # MARKUS "They said we needed to focus, like it was some extra limb that we just needed to think about using."
    MARKUS "Dijeron que teníamos que concentrarnos, como si fuera una extremidad extra que solo teníamos que pensar en utilizar."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:75
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_ebdf1655:

    # MC @ talk "Easier said than done! "
    MC @ talk "¡Es más fácil decirlo que hacerlo!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:76
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_91821a33:

    # "Without warning, Markus began to strip off his clothes."
    "Sin previo aviso, Markus empezó a quitarse la ropa."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:77
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_4239b98e:

    # MC @ talk "...What are you doing?"
    MC @ talk "...¿Qué estás haciendo?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:78
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_b16baa77:

    # MARKUS "Whatever we change into is likely to tear through our clothes, right?"
    MARKUS "Sea lo que sea lo que nos transformemos, es probable que nos rompa la ropa, ¿no?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:79
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_5118a23d:

    # MARKUS "I don’t particularly want to have to walk through Novaras naked when we return."
    MARKUS "No me apetece especialmente tener que atravesar Novaras desnudo cuando volvamos."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:80
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_0033c658:

    # MC @ talk "...You sure you’re into girls?"
    MC @ talk "...¿Seguro que te gustan las chicas?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:81
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_f1f40c61:

    # MC @ talk "Because this might be the clumsiest come on ever."
    MC @ talk "Porque este podría ser el vamos más torpe de la historia."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:82
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_b76c5147:

    # "Markus shot me a look of ‘shut up and just do it’, clearly taking this too seriously to acknowledge the ridiculousness of the situation."
    "Markus me lanzó una mirada de ‘cállate y hazlo’, claramente tomándose esto demasiado en serio como para reconocer lo ridículo de la situación."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:83
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_16cfcfe4:

    # "I sighed and begrudgingly began to strip."
    "Suspiré y empecé a desnudarme a regañadientes."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:84
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_0845cb17:

    # MARKUS "We’ll keep the clothes by this rock for when we return."
    MARKUS "Guardaremos la ropa junto a esta roca para cuando volvamos."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:85
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_864ca015:

    # MARKUS "Should be easy to find with that dead hooked tree over there nearby."
    MARKUS "Debería ser fácil de encontrar con ese árbol muerto cerca."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:88
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_3ae1d182:

    # MC @ talk "If you say so."
    MC @ talk "Si tú lo dices."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:91
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_f817b1cf:

    # "Now stark naked, I looked to Markus awaiting his next suggestion."
    "Ahora completamente desnudo, miré a Markus esperando su siguiente sugerencia."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:92
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_53b5a59f:

    # MARKUS "Okay... Let’s just try and think."
    MARKUS "Bueno... Intentemos pensar."

