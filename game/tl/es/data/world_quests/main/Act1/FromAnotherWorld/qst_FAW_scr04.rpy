    MC @ talk "¿Qué coño es eso?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:99
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_ad2ec80d:

    # MARKUS "I’m trying to channel my thoughts to focus!"
    MARKUS "¡Intento canalizar mis pensamientos para centrarme!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:100
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_45dd95ce:

    # MC @ talk "By going ‘Hmmmmm’ loudly?"
    MC @ talk "¿Haciendo ‘Hmmmmm’ en voz alta?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:101
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_ae17cf69:

    # MARKUS "Well, if you’ve got a better idea let’s hear it! "
    MARKUS "Bueno, si tienes una idea mejor, ¡dilo!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:102
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_8349b364:

    # MC @ talk "It wasn’t my idea to stand bollock naked in the middle of the desert! "
    MC @ talk "¡No fue idea mía quedarme desnudo en medio del desierto!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:103
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_9edeebac:

    # MARKUS "Gah! We just need to focus! And this is the safest place to test it! "
    MARKUS "¡Gah! ¡Necesitamos concentrarnos! ¡Y este es el lugar más seguro para probarlo!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:104
translate es qst_FromAnotherWorld_GoToValleyWithMarkus_039cad1a:

    # MC @ talk "Fine. Whatever."
    MC @ talk "Bien. Como quieras."

