translate es strings:

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:4
    old "Judgement Day"
    new "Día del juicio"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:5
    old "At last, the Demorai army is at our gates. I must defend the city, no matter the cost..."
    new "Por fin, el ejército demorai está a nuestras puertas. Debo defender la ciudad, cueste lo que cueste..."

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Defend Novaras"
    new "Defiende Novaras"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "I must help people of Novaras repel the Demorai assault."
    new "Debo ayudar a la gente de Novaras a repeler el asalto demorai."

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Disperse the crowd"
    new "Dispersa a la multitud"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "A crowd is forming in the Market District. Captain Nyx needs me to deal with it, before the Demorai artillery does."
    new "Se está formando una multitud en el distrito del mercado. La capitana Nyx necesita que me ocupe de ella, antes de que la artillería demorai lo haga."

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Find Markus"
    new "Encuentra a Markus"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "If I am to do any good here, I need to find Markus. Together, we might have a chance...."
    new "Si voy a hacer algo bueno aquí, necesito encontrar a Markus. Juntos, podríamos tener una oportunidad...."

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Rescue the mages"
    new "Rescata a las magas"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Sister Divine wants me to rescue a group of mages. I should be able to find them in the south-eastern district."
    new "La hermana Divine quiere que rescate a un grupo de magas. Debería poder encontrarlas en el distrito sureste."

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Find Prince Naran"
    new "Encuentra al príncipe Naran"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Princess Cecilia has tasked me with finding her younger brother, Prince Naran."
    new "La Princesa Cecilia me ha encargado encontrar a su hermano menor, el príncipe Naran."

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Get to the south-eastern wall"
    new "Llegar a la muralla sureste"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "I must get to the south-eastern wall: something is disrupting the supplies there."
    new "Debo llegar a la muralla sureste: algo está interrumpiendo los suministros allí."

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Defeat Zanarak"
    new "Derrota a Zanarak"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "I have met Zanarak again. This time, we will beat him. Or die trying."
    new "He vuelto a ver a Zanarak. Esta vez, lo venceremos. O moriremos en el intento."

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "Win the trial"
    new "Gana el juicio"

    # game/data/world_quests/main/Act1/JudgementDay/qst_JudgementDay.rpy:6
    old "For doing my best to protect the city during the siege I now stand trial, facing absurd charges. I will do my best to make it through this mess..."
    new "Por hacer todo lo posible para proteger la ciudad durante el asedio, ahora estoy siendo juzgado, enfrentándome a cargos absurdos. Haré todo lo posible para salir de este lío..."
