    # MAD_PROPHET "N-Noo, God! Why have you..."
    MAD_PROPHET "¡N-noo, Dios! ¿Por qué nos has..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:177
