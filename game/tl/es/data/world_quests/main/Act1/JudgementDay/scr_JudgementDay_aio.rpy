translate es qst_JudgementDay_RescueMages_Prep_ee6d7f8e:

    # "Upon seeing me and Markus, she gasped and attempted to slam the door shut, but Erika wedged her foot in before she could."
    "Al vernos a Markus y a mí, jadeó e intentó cerrar la puerta de un portazo, pero Erika metió el pie antes de que pudiera."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1503
translate es qst_JudgementDay_RescueMages_Prep_8e798dd8:

    # SOPHIRA "G-Get back!"
    SOPHIRA "¡A-atrás!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1504
translate es qst_JudgementDay_RescueMages_Prep_e1310062:

    # ERIKA "Hold!"
    ERIKA "¡Espera!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1505
translate es qst_JudgementDay_RescueMages_Prep_10c0580a:

    # ERIKA "They are with me."
    ERIKA "Están conmigo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1506
translate es qst_JudgementDay_RescueMages_Prep_cf899e87:

    # "The woman's wide, fearful eyes darted back and forth between me and Markus before she hesitantly turned back to Erika."
    "Los ojos grandes y temerosos de la mujer nos miraron a Markus y a mí antes de volverse vacilante hacia Erika."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1507
translate es qst_JudgementDay_RescueMages_Prep_c1aa6fc5:

    # ERIKA "Who are you?"
    ERIKA "¿Quién eres?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1508
translate es qst_JudgementDay_RescueMages_Prep_ca9584e7:

    # SOPHIRA "...I..."
    SOPHIRA "...yo..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1509
translate es qst_JudgementDay_RescueMages_Prep_f34e4dec:

    # SOPHIRA "I am Lady Maringott, but call me Sophira."
    SOPHIRA "Soy la señorita Maringott, pero llámame Sophira."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1511
translate es qst_JudgementDay_RescueMages_Prep_dcfb449e:

    # ERIKA "The Mages of Palam—are they here?"
    ERIKA "Las magas de Palam, ¿están aquí?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1512
translate es qst_JudgementDay_RescueMages_Prep_0988535a:

    # SOPHIRA "Y-Yes... Come quickly."
    SOPHIRA "S-sí... venid rápido."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1516
translate es qst_JudgementDay_RescueMages_Prep_89f25f4f:

    # "Sophira led us into the main hall of the manor, now a makeshift infirmary littered with wounded men and women."
    "Sophira nos condujo a la estancia principal de la mansión, ahora convertida en una improvisada enfermería llena de hombres y mujeres heridos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1517
translate es qst_JudgementDay_RescueMages_Prep_18de3914:

    # "The air was filled with pained groans as bloodied civilians and soldiers writhed on hastily arranged beds."
    "El aire se llenó de gemidos de dolor mientras civiles y soldados ensangrentados se retorcían en camas instaladas apresuradamente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1518
translate es qst_JudgementDay_RescueMages_Prep_ef679b7f:

    # "Exhausted Mages of Palam moved frantically, tending to the wounded."
    "Las agotadas magas de Palam se movían frenéticamente, atendiendo a los heridos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1521
translate es qst_JudgementDay_RescueMages_Prep_be997334:

    # "The chaos of the scene meant few even looked up at us."
    "El caos de la situación hizo que pocos nos miraran."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1525
translate es qst_JudgementDay_RescueMages_Prep_4cb32837:

    # ERIKA "What is going on here?"
    ERIKA "¿Qué está pasando aquí?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1526
translate es qst_JudgementDay_RescueMages_Prep_32a7d9bc:

    # SOPHIRA "The attack came so suddenly..."
    SOPHIRA "El ataque fue tan repentino..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1527
translate es qst_JudgementDay_RescueMages_Prep_ab1b8518:

    # SOPHIRA "We opened our doors to shelter as many as we could, but the wounded kept piling in."
    SOPHIRA "Abrimos nuestras puertas para acoger a todos los que pudimos, pero los heridos seguían amontonándose."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1528
translate es qst_JudgementDay_RescueMages_Prep_08869913:

    # "Her face darkened."
    "Su rostro se ensombreció."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1529
translate es qst_JudgementDay_RescueMages_Prep_46f9b89b:

    # SOPHIRA "...Some of the mages didn't make it."
    SOPHIRA "...Algunas de las magas no lo lograron."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1530
translate es qst_JudgementDay_RescueMages_Prep_c277dfeb:

    # SOPHIRA "But those who remain have been a blessing from the gods."
    SOPHIRA "Pero las que quedan han sido una bendición de los dioses."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1531
translate es qst_JudgementDay_RescueMages_Prep_ba99da2c:

    # SOPHIRA "I fear many more would have perished without them."
    SOPHIRA "Me temo que muchos más habrían perecido sin ellas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1532
translate es qst_JudgementDay_RescueMages_Prep_288b2912:

    # ERIKA "Where is your husband?"
    ERIKA "¿Dónde está tu marido?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1533
translate es qst_JudgementDay_RescueMages_Prep_2b343ada:

    # SOPHIRA "My husband lost his legs many years ago."
    SOPHIRA "Mi marido perdió las piernas hace muchos años."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1534
translate es qst_JudgementDay_RescueMages_Prep_d5a91e24:

    # SOPHIRA "I've confined him to his room for safety until this nightmare ends."
    SOPHIRA "Le he confinado en su habitación por seguridad hasta que acabe esta pesadilla."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1535
translate es qst_JudgementDay_RescueMages_Prep_9804f65a:

    # MC "What can we do to help?"
    MC "¿Qué podemos hacer para ayudar?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1536
translate es qst_JudgementDay_RescueMages_Prep_3cc7ceca:

    # SOPHIRA "Please... We need more medicine. The mages are exhausted."
    SOPHIRA "Por favor... Necesitamos más medicinas. Las magas están agotadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1537
translate es qst_JudgementDay_RescueMages_Prep_6260956e:

    # ERIKA "Take these people to the main fort. There will be—"
    ERIKA "Lleva a esta gente al fuerte principal. Habrá—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1538
translate es qst_JudgementDay_RescueMages_Prep_08946951:

    # SOPHIRA "No!"
    SOPHIRA "¡No!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1539
translate es qst_JudgementDay_RescueMages_Prep_16119eaf:

    # SOPHIRA "None of the wounded can fight, and the mages are too drained."
    SOPHIRA "Ninguno de los heridos puede luchar, y las magas están demasiado agotadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1540
translate es qst_JudgementDay_RescueMages_Prep_8bff53d6:

    # SOPHIRA "We'd be slaughtered if we tried to move now."
    SOPHIRA "Nos masacrarían si intentáramos movernos ahora."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1541
translate es qst_JudgementDay_RescueMages_Prep_b0728f26:

    # MC "Then what do you suggest?"
    MC "Entonces, ¿qué sugieres?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1542
translate es qst_JudgementDay_RescueMages_Prep_cbc9f014:

    # SOPHIRA "The basement."
    SOPHIRA "El sótano."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1543
translate es qst_JudgementDay_RescueMages_Prep_94f195d8:

    # SOPHIRA "There are more medical supplies, food, and water down there."
    SOPHIRA "Hay más suministros médicos, comida y agua ahí abajo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1544
translate es qst_JudgementDay_RescueMages_Prep_1fc6089c:

    # ERIKA "Then why haven't you retrieved them already?"
    ERIKA "¿Entonces por qué no los has recuperado ya?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1545
translate es qst_JudgementDay_RescueMages_Prep_8e33a28a:

    # SOPHIRA "{i}...Something is down there.{/i}"
    SOPHIRA "{i}...Hay algo ahí abajo.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1546
translate es qst_JudgementDay_RescueMages_Prep_069e8943:

    # SOPHIRA "When everything started, we heard strange noises coming from the basement."
    SOPHIRA "Cuando todo empezó, oímos ruidos extraños procedentes del sótano."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1547
translate es qst_JudgementDay_RescueMages_Prep_519c41a4:

    # SOPHIRA "We sent two guards down to check, and then... we heard the most awful sounds."
    SOPHIRA "Enviamos a dos guardias a comprobarlo, y entonces... oímos unos ruidos espantosos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1548
translate es qst_JudgementDay_RescueMages_Prep_856a2c1b:

    # ERIKA "Is the basement secure now?"
    ERIKA "¿Es seguro el sótano ahora?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1549
translate es qst_JudgementDay_RescueMages_Prep_6cd2601f:

    # SOPHIRA "Yes... We bolted and barricaded it shut."
    SOPHIRA "Sí... Lo cerramos con cerrojo y barricadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1550
translate es qst_JudgementDay_RescueMages_Prep_4df24ebb:

    # SOPHIRA "{i}But we can still hear something moving down there...{/i}"
    SOPHIRA "{i}But we can still hear something moving down there...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1551
translate es qst_JudgementDay_RescueMages_Prep_3ca32141:

    # MC "Where is this basement?"
    MC "¿Dónde está el sótano?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1552
translate es qst_JudgementDay_RescueMages_Prep_1307e2ea:

    # SOPHIRA "Wait...! Before you go."
    SOPHIRA "¡Espera...! Antes de que te vayas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1553
translate es qst_JudgementDay_RescueMages_Prep_f0cc9421:

    # SOPHIRA "Take these."
    SOPHIRA "Coge esto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1558
translate es qst_JudgementDay_RescueMages_Prep_fb70bf95:

    # SOPHIRA "I can't spare much, but... hopefully, you'll be able to clear out whatever's down there."
    SOPHIRA "No puedo prescindir de mucho, pero... con suerte, podrás deshacerte de lo que haya ahí abajo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1559
translate es qst_JudgementDay_RescueMages_Prep_bf0933ee:

    # ERIKA "Take us to the basement."
    ERIKA "Llévanos al sótano."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1560
translate es qst_JudgementDay_RescueMages_Prep_ed135172:

    # ERIKA "We don't have much time."
    ERIKA "No tenemos mucho tiempo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1569
translate es qst_JudgementDay_RescueMages_Prep_de8d52ca:

    # "...The basement door was heavily barricaded, tables and chairs stacked against it in a desperate attempt to keep something locked inside."
    "...La puerta del sótano estaba fuertemente atrincherada, con mesas y sillas apiladas contra ella en un intento desesperado de mantener algo encerrado dentro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1570
translate es qst_JudgementDay_RescueMages_Prep_5510eb32:

    # "It took several minutes to clear away the debris before we reached the door itself."
    "Tardamos varios minutos en retirar los escombros antes de llegar a la puerta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1571
translate es qst_JudgementDay_RescueMages_Prep_2d08aad9:

    # "Sophira hesitated, stepping back as I reached for the handle."
    "Sophira vaciló, dando un paso atrás mientras yo me acercaba a la manilla."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1575
translate es qst_JudgementDay_RescueMages_Prep_f2fd1f30:

    # "As the door creaked open, an eerie darkness stretched down into the unknown."
    "Al abrirse la puerta, una inquietante oscuridad se extendió hacia lo desconocido."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1577
translate es qst_JudgementDay_RescueMages_Prep_9f7bb532:

    # MARKUS "...You first."
    MARKUS "...Tú primero."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1578
translate es qst_JudgementDay_RescueMages_Prep_2464d270:

    # "Step by step, we descended into the oppressive darkness, the cold stone beneath our feet making every movement feel heavier."
    "Paso a paso, descendimos a la agobiante oscuridad, la fría piedra bajo nuestros pies hacía que cada movimiento pareciera más pesado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1580
translate es qst_JudgementDay_RescueMages_Prep_a5faaf6e:

    # "Elena whined nervously behind me."
    "Elena gimoteó nerviosa detrás de mí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1582
translate es qst_JudgementDay_RescueMages_Prep_20c6c022:

    # MC "Calm, Elena."
    MC "Tranquila, Elena."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1586
translate es qst_JudgementDay_RescueMages_Prep_05531ad1:

    # MYU "T-This seems like a bad idea to Myu..."
    MYU "A Myu e-esto le parece una mala idea..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1591
translate es qst_JudgementDay_RescueMages_Prep_784f60a8:

    # "Finally, we reached the bottom."
    "Por fin, llegamos al fondo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1592
translate es qst_JudgementDay_RescueMages_Prep_a1b18879:

    # "Even in the dim light, I could see the place was a mess—broken crates, toppled shelves, and shattered bottles lay scattered across the floor."
    "Incluso en la penumbra, pude ver que el lugar era un desastre, cajas rotas, estanterías derribadas y botellas rotas esparcidas por el suelo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1593
translate es qst_JudgementDay_RescueMages_Prep_d10a2b67:

    # "Food, medicine, and supplies lay in ruined heaps as though some wild beast had rampaged through here."
    "La comida, las medicinas y las provisiones yacían amontonadas y en estado de destrucción, como si alguna bestia salvaje hubiera hecho estragos por aquí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1594
translate es qst_JudgementDay_RescueMages_Prep_b06dde3e:

    # "Most disturbing of all was the heavy trail of blood that led deeper into the room... only to suddenly disappear in the middle of the floor."
    "Lo más inquietante de todo era el espeso rastro de sangre que se adentraba en la habitación... solo para desaparecer de repente en medio del suelo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1595
translate es qst_JudgementDay_RescueMages_Prep_84dbeb44:

    # "Erika tightened her grip on her sword as a strange dragging sound echoed through the chamber."
    "Erika apretó con fuerza su espada cuando un extraño sonido de arrastramiento resonó en la estancia."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1596
translate es qst_JudgementDay_RescueMages_Prep_f34d9a6e:

    # ERIKA "{i}It's still here...{/i}"
    ERIKA "{i}Aún está aquí...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1597
translate es qst_JudgementDay_RescueMages_Prep_fc93b91b:

    # "A sinister, wet slithering noise grew louder, circling us from the shadows."
    "Un siniestro y húmedo ruido deslizante se hizo más fuerte, rodeándonos desde las sombras."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1598
translate es qst_JudgementDay_RescueMages_Prep_07a3131b:

    # "And then, as if the very darkness itself was shifting, everything went still..."
    "Y entonces, como si la propia oscuridad se moviera, todo se quedó quieto..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1608
translate es qst_JudgementDay_RescueMages_Prep_7b8076d7:

    # "Writhing in agony, the creature let out a sickening bellow as blood sprayed across the walls."
    "Retorciéndose en agonía, la criatura lanzó un aullido repugnante mientras la sangre salpicaba las paredes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1610
translate es qst_JudgementDay_RescueMages_Prep_b620a0e1:

    # "In a final desperate lunge, it attempted to strike—but with a swift swipe of my tail, its head tumbled to the floor, lifeless."
    "En una última embestida desesperada, intentó golpear, pero con un rápido golpe de mi cola, su cabeza cayó al suelo, sin vida."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1612
translate es qst_JudgementDay_RescueMages_Prep_503eb673:

    # MARKUS "{i}*Huff*{/i} What in all the gods was that thing?"
    MARKUS "{i}*Uff*{/i} ¿Qué demonios era esa cosa?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1614
translate es qst_JudgementDay_RescueMages_Prep_836a7533:

    # ERIKA "{i}I've seen creatures like this before...{/i}"
    ERIKA "{i}He visto criaturas como esta antes...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1615
translate es qst_JudgementDay_RescueMages_Prep_e7942df9:

    # MARKUS "You have?"
    MARKUS "¿En serio?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1616
translate es qst_JudgementDay_RescueMages_Prep_8b418497:

    # ERIKA "Dark mages can create many horrors..."
    ERIKA "Los magos oscuros pueden crear muchos horrores..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1617
translate es qst_JudgementDay_RescueMages_Prep_4c777b59:

    # MARKUS "Wait, are you saying dark mages are working with the Demorai?"
    MARKUS "Espera, ¿estás diciendo que los magos oscuros trabajan con los demorai?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1618
translate es qst_JudgementDay_RescueMages_Prep_a7d1cbb7:

    # ERIKA "Who knows? We don't have time to speculate."
    ERIKA "¿Quién sabe? No tenemos tiempo para especulaciones."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1619
translate es qst_JudgementDay_RescueMages_Prep_00904404:

    # ERIKA "Let's go back and tell Sophira it's safe."
    ERIKA "Volvamos y digámosle a Sophira que es seguro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1628
translate es qst_JudgementDay_RescueMages_Prep_cc1017a7:

    # SOPHIRA "You're back!"
    SOPHIRA "¡Habéis vuelto!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1629
translate es qst_JudgementDay_RescueMages_Prep_d8f05fb2:

    # SOPHIRA "We heard terrible noises—I feared the worst!"
    SOPHIRA "Oímos ruidos terribles, ¡me temía lo peor!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1630
translate es qst_JudgementDay_RescueMages_Prep_249d38dc:

    # ERIKA "It's safe now."
    ERIKA "Ahora es seguro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1631
translate es qst_JudgementDay_RescueMages_Prep_66fbe380:

    # ERIKA "Though I'm afraid much of the medicine may be lost..."
    ERIKA "Aunque me temo que gran parte de la medicina puede estar dañada..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1632
translate es qst_JudgementDay_RescueMages_Prep_bea94ee9:

    # SOPHIRA "We'll make do. Thank you."
    SOPHIRA "Nos las apañaremos. Gracias."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1633
translate es qst_JudgementDay_RescueMages_Prep_3a185799:

    # "Sophira turned toward me and Markus, her expression softening."
    "Sophira se giró hacia mí y Markus, su expresión se suavizó."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1634
translate es qst_JudgementDay_RescueMages_Prep_a3550950:

    # SOPHIRA "...Thank you."
    SOPHIRA "...Gracias."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1635
translate es qst_JudgementDay_RescueMages_Prep_8e36738f:

    # SOPHIRA "You may have saved a lot of lives today."
    SOPHIRA "Puede que hoy hayáis salvado muchas vidas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1641
translate es qst_JudgementDay_RescueMages_Prep_46afb077:

    # MYU "Hooray! Myu did a good!"
    MYU "¡Hurra! ¡Myu hizo un bien!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1642
translate es qst_JudgementDay_RescueMages_Prep_42980294:

    # SOPHIRA "A-Ahh... Yes, you did."
    SOPHIRA "A-ahh... Sí, lo hiciste."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1645
translate es qst_JudgementDay_RescueMages_Prep_90da61ed:

    # ERIKA "We need to go."
    ERIKA "Tenemos que irnos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1646
translate es qst_JudgementDay_RescueMages_Prep_98331877:

    # ERIKA "We've wasted enough time."
    ERIKA "Ya hemos perdido bastante tiempo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1647
translate es qst_JudgementDay_RescueMages_Prep_8f616c48:

    # SOPHIRA "Wait! Before you leave..."
    SOPHIRA "¡Esperad! Antes de que os vayáis..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1648
translate es qst_JudgementDay_RescueMages_Prep_5139d402:

    # SOPHIRA "Let one of the mages tend to your wounds. It's the least we can do."
    SOPHIRA "Dejad que uno de las magas atienda vuestras heridas. Es lo menos que podemos hacer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1653
translate es qst_JudgementDay_RescueMages_Prep_b9f6f48a:

    # "...After being healed by one of the mages, we made our way out."
    "...Después de ser curados por uno de las magas, salimos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1657
translate es qst_JudgementDay_RescueMages_Unprep_9e4944f2:

    # ERIKA "Fine, but we must hurry!"
    ERIKA "¡Está bien, pero debemos darnos prisa!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1665
translate es qst_JudgementDay_RescueMages_Unprep_46309dca:

    # "We scoured the district, but neither I nor Markus could pick up their scent through the thick smoke."
    "Recorrimos el distrito, pero ni yo ni Markus pudimos captar su olor a través del espeso humo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1666
translate es qst_JudgementDay_RescueMages_Unprep_838c0731:

    # "Suddenly, a sharp cry echoed through the air."
    "De repente, un grito agudo resonó en el aire."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1668
translate es qst_JudgementDay_RescueMages_Unprep_65fb0b3b:

    # MC "This way!"
    MC "¡Por aquí!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1669
translate es qst_JudgementDay_RescueMages_Unprep_d983de2b:

    # "We followed the sound, hurrying through the burning streets to find the entrance of a noble's manor."
    "Seguimos el sonido, apresurándonos por las calles en llamas hasta encontrar la entrada de la mansión de un noble."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1670
translate es qst_JudgementDay_RescueMages_Unprep_e92cf3e1:

    # "From inside, I could hear muffled cries of pain."
    "Desde dentro, podía oír gritos ahogados de dolor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1672
translate es qst_JudgementDay_RescueMages_Unprep_f2d64bb0:

    # "Slamming my fist against it I called out to only be met with silence as my answer."
    "Golpeé con el puño contra ella y grité, pero mi respuesta fue el silencio."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1674
translate es qst_JudgementDay_RescueMages_Unprep_f5320ddb:

    # "Gripping at the door with my tentacles, I tore the thing open with ease and stepped inside."
    "Sujeté la puerta con mis tentáculos, la abrí con facilidad y entré."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1678
translate es qst_JudgementDay_RescueMages_Unprep_b6d10b53:

    # "The walls were laced in blood, bodies torn to shreds littered the place."
    "Las paredes estaban ensangrentadas y los cadáveres destrozados."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1679
translate es qst_JudgementDay_RescueMages_Unprep_8caf742f:

    # "Here and there, a bit of bloodied blue flesh and skin as the sickly smell of blood and death filled the air."
    "Aquí y allá, un pedazo de carne y piel azul ensangrentada mientras el enfermizo olor a sangre y muerte llenaba el aire."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1680
translate es qst_JudgementDay_RescueMages_Unprep_46abadc0:

    # "It appears the mansion had been used as some kind of makeshift hospital."
    "Parece que la mansión había sido utilizada como una especie de hospital improvisado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1681
translate es qst_JudgementDay_RescueMages_Unprep_d5c2bc59:

    # "Or at least, it {i}was{/i} before something got in."
    "O al menos, lo {i}era{/i} antes de que algo entrara."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1684
translate es qst_JudgementDay_RescueMages_Unprep_812649d0:

    # "Erika turned a shade of white as she struggled not to throw up."
    "Erika se puso blanca mientras luchaba por no vomitar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1685
translate es qst_JudgementDay_RescueMages_Unprep_d43eae69:

    # ERIKA "Gods... What happened in here?"
    ERIKA "Dioses... ¿Qué ha pasado aquí?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1687
translate es qst_JudgementDay_RescueMages_Unprep_17e1d435:

    # MARKUS "It doesn't look like they managed to put up much of a fight..."
    MARKUS "No parece que hayan conseguido oponer mucha resistencia..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1688
translate es qst_JudgementDay_RescueMages_Unprep_9cbf423d:

    # "A snapping sound echoed through the halls, followed by another ghastly scream."
    "Un chasquido resonó por los pasillos, seguido de otro grito espantoso."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1691
translate es qst_JudgementDay_RescueMages_Unprep_18f10e05:

    # UNKNOWN "AHHHHHHHH!"
    UNKNOWN "¡AHHHHHHHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1692
translate es qst_JudgementDay_RescueMages_Unprep_65fb0b3b_1:

    # MC "This way!"
    MC "¡Por aquí!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1695
translate es qst_JudgementDay_RescueMages_Unprep_9893b43a:

    # "Chasing the screams led us down a hallway towards a strange entranceway leading underground."
    "Persiguiendo los gritos nos llevó por un pasillo hacia una extraña entrada que conducía al subsuelo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1696
translate es qst_JudgementDay_RescueMages_Unprep_3e65ada3:

    # "With shattered chains around the entranceway, {i}something{/i} must have broken out."
    "Con las cadenas destrozadas alrededor de la entrada, {i}algo{/i} debe haber escapado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1697
translate es qst_JudgementDay_RescueMages_Unprep_3cc2ee74:

    # "A bone-chilling crunching sound was heard as we descended the stairs into that deep and terrible darkness."
    "Se oyó un crujido escalofriante al bajar las escaleras hacia aquella oscuridad profunda y terrible."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1700
translate es qst_JudgementDay_RescueMages_Unprep_fd50f717:

    # "There... waving a torch around the flooded basement, the water up to our ankles, we looked around for the source of the sound."
    "Allí... agitando una antorcha por el sótano inundado, con el agua hasta los tobillos, buscamos el origen del sonido."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1701
translate es qst_JudgementDay_RescueMages_Unprep_b164bb17:

    # "Slowly moving the light from left to right across the debris, there...{i}we saw it.{/i}"
    "Lentamente moviendo la luz de izquierda a derecha a través de los escombros, allí...{i}lo vimos.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1703
translate es qst_JudgementDay_RescueMages_Unprep_cdd450ae:

    # "A snake like creature with a humanoid like body, sinking it's teeth once more into the woman in a blue dress."
    "Una criatura parecida a una serpiente con cuerpo humanoide, hundiendo sus dientes una vez más en la mujer del vestido azul."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1704
translate es qst_JudgementDay_RescueMages_Unprep_2d53ad4b:

    # "She let out one last raspy cry of pain as the thing chewed on her, the deep red sinking through and overpowering the blue."
    "Soltó un último grito áspero de dolor mientras la cosa la mordisqueaba, el rojo intenso se hundía y dominaba al azul."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1705
translate es qst_JudgementDay_RescueMages_Unprep_ae6c5a83:

    # "Pale white, she seemed completely drained of all life as the eyes of her ghastly, skeleton white face rolled up."
    "Blanca pálida, parecía completamente drenada de toda vida mientras los ojos de su espantoso rostro blanco esquelético se ponían en blanco."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1706
translate es qst_JudgementDay_RescueMages_Unprep_18470e76:

    # "The creature snarled, tosing her now lifeless body aside, letting it slam against one of the walls as we heard the bones break."
    "La criatura gruñó, arrojando su cuerpo ya sin vida a un lado, dejando que se golpeara contra una de las paredes mientras oíamos cómo se rompían los huesos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1709
translate es qst_JudgementDay_RescueMages_Unprep_1a712d20:

    # "It licked at it's bloody fangs before lunging towards us!"
    "¡Se lamió los colmillos ensangrentados antes de abalanzarse sobre nosotros!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1719
translate es qst_JudgementDay_RescueMages_Unprep_96fa915c:

    # "Slicing my claws across the creature's throat, the snakeman waved back and force, reaching at it's gaping wound where it's throat once was."
    "Al clavar mis garras en la garganta de la criatura, el hombre serpiente se agitó hacia atrás y hacia la fuerza, alcanzando su herida abierta donde una vez estuvo su garganta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1720
translate es qst_JudgementDay_RescueMages_Unprep_1027db08:

    # "After letting out a desperate, raspy cry, it collapsed face first into the water, twitching for a few moments before falling completely still."
    "Tras soltar un grito desesperado y áspero, se desplomó de bruces en el agua, retorciéndose unos instantes antes de quedarse completamente inmóvil."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1721
translate es qst_JudgementDay_RescueMages_Unprep_0374e7bc:

    # MC "What in the hells is this thing?"
    MC "¿Qué demonios es esta cosa?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1722
translate es qst_JudgementDay_RescueMages_Unprep_4b2c1c99:

    # MC "Some kind of... dark magecraft abomination?"
    MC "¿Algún tipo de... abominación de mágia oscura?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1724
translate es qst_JudgementDay_RescueMages_Unprep_79c627e2:

    # ERIKA "I... I've never seen anything like it before."
    ERIKA "Yo... nunca había visto nada igual."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1725
translate es qst_JudgementDay_RescueMages_Unprep_591afddc:

    # ERIKA "It appears to be... {i}part human?{/i}"
    ERIKA "Parece ser... {i}¿parte humana?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1727
translate es qst_JudgementDay_RescueMages_Unprep_ec77576a:

    # MARKUS "We should leave this place, whatever this {i}thing{/i} is, the inquisitors and whoever can look at the damn thing when we're done."
    MARKUS "WDeberíamos dejar este lugar, sea lo que sea esta {i}cosa{/i}, los inquisidores y quien sea pueden mirar la maldita cosa cuando terminemos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1729
translate es qst_JudgementDay_RescueMages_Unprep_38177186:

    # "I nodded in agreement as we made our way back up through the mansion estate."
    "Asentí con la cabeza mientras volvíamos a subir por la mansión."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1731
translate es qst_JudgementDay_RescueMages_Unprep_8bfc939c:

    # "I took one last look at the dead bodies littered around... Perhaps..."
    "Eché un último vistazo a los cadáveres esparcidos... quizás..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1733
translate es qst_JudgementDay_RescueMages_Unprep_6725b4fe:

    # "{i}Perhaps if things were different, I could have saved them.{/i}"
    "{i}Quizás si las cosas hubieran sido diferentes, podría haberlos salvado.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1729
translate es qst_JudgementDay_RescueMages_Unprep_bb0c8ed4:

    # ERIKA "[player_name!t], let's go."
    ERIKA "[player_name!t], vámonos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1744
translate es qst_JudgementDay_RescueMages_MoveOn_e1032b47:

    # "Navigating through the chaotic streets, Erika guided us through a series of alleyways and back routes."
    "Sorteando las caóticas calles, Erika nos guió por una serie de callejones y rutas secundarias."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1745
translate es qst_JudgementDay_RescueMages_MoveOn_ff091e7a:

    # "Finally, pushing through to the main street, we hurried toward our destination."
    "Finalmente, abriéndonos paso hasta la calle principal, nos apresuramos hacia nuestro destino."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1746
translate es qst_JudgementDay_RescueMages_MoveOn_f2ac90ca:

    # ERIKA "We must move quickly before—"
    ERIKA "Debemos movernos rápido antes de que—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1748
translate es qst_JudgementDay_RescueMages_MoveOn_58420e88:

    # "There, amidst a heap of mangled corpses, sat the gleaming, towering figure of the Silver Knight."
    "Allí, en medio de un montón de cadáveres destrozados, estaba sentada la figura resplandeciente e imponente del caballero de plata."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1749
translate es qst_JudgementDay_RescueMages_MoveOn_1df97ea7:

    # "His cape fluttered in the wind as the city burned around him, his presence eerily still in the midst of carnage."
    "Su capa ondeaba al viento mientras la ciudad ardía a su alrededor, su presencia inquietantemente quieta en medio de la carnicería."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1750
translate es qst_JudgementDay_RescueMages_MoveOn_042dbc76:

    # "Despite the splattering of blood across his armor, his silver plating still shined brilliantly through the filth."
    "A pesar de las salpicaduras de sangre en su armadura, su chapa plateada seguía brillando a través de la suciedad."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1755
translate es qst_JudgementDay_RescueMages_MoveOn_78e5318e:

    # SILVER_KNIGHT "..."
    SILVER_KNIGHT "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1757
translate es qst_JudgementDay_RescueMages_MoveOn_e51a3c47:

    # "Slowly, he tilted his head up, locking his piercing gaze onto us."
    "Lentamente, inclinó la cabeza hacia arriba, clavando su penetrante mirada en nosotros."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1759
translate es qst_JudgementDay_RescueMages_MoveOn_31385b2d:

    # "His grip on his massive sword tightened as he rose to his feet, advancing in our direction."
    "Agarró con fuerza su enorme espada y se puso en pie, avanzando en nuestra dirección."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1760
translate es qst_JudgementDay_RescueMages_MoveOn_a455176a:

    # MARKUS "F-Fuck! It's him! It's the Silver Knight himself!"
    MARKUS "¡J-joder! ¡Es él! ¡Es el caballero de plata en persona!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1761
translate es qst_JudgementDay_RescueMages_MoveOn_0aea49c7:

    # "The Silver Knight... A warrior of legend, chosen to serve and die for the royal family of Alderay."
    "El caballero de plata... Un guerrero de leyenda, elegido para servir y morir por la familia real de Alderay."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1762
translate es qst_JudgementDay_RescueMages_MoveOn_3702506d:

    # "Possessing unmatched skill in both blade and magecraft, it was said that he was perhaps the only man who could have challenged Newheart and won."
    "Poseedor de una habilidad inigualable tanto con la espada como con la magia, se decía que tal vez era el único hombre que podría haber desafiado a Newheart y haber ganado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1763
translate es qst_JudgementDay_RescueMages_MoveOn_485f73a4:

    # "...And now, he was coming straight for us."
    "...Y ahora, venía directo hacia nosotros."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1764
translate es qst_JudgementDay_RescueMages_MoveOn_ad3944f0:

    # ERIKA "Hold, Sir Knight! HOLD!"
    ERIKA "¡Alto, señor caballero! ¡ALTO!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1766
translate es qst_JudgementDay_RescueMages_MoveOn_7b45065b:

    # "The Silver Knight stopped in his tracks, eyes narrowing as he examined me and Markus."
    "El caballero de plata se paró en seco, con los ojos entrecerrados mientras nos examinaba a Markus y a mí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1767
translate es qst_JudgementDay_RescueMages_MoveOn_5fe8b642:

    # "His posture remained unreadable, but his grip on his weapon remained firm."
    "Su postura seguía siendo ilegible, pero el agarre de su arma permanecía firme."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1769
translate es qst_JudgementDay_RescueMages_MoveOn_6ddf1665:

    # SILVER_KNIGHT "…What are they?"
    SILVER_KNIGHT "…¿Qué son?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1770
translate es qst_JudgementDay_RescueMages_MoveOn_8709d483:

    # ERIKA "As of now, these... creatures are under the order of the Inquisition."
    ERIKA "A partir de ahora, estas... criaturas están bajo la orden de la Inquisición."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1771
translate es qst_JudgementDay_RescueMages_MoveOn_e74bc1de:

    # SILVER_KNIGHT "I do not concern myself with the affairs of the Inquisition."
    SILVER_KNIGHT "No me preocupan los asuntos de la Inquisición."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1772
translate es qst_JudgementDay_RescueMages_MoveOn_ff96d9a5:

    # SILVER_KNIGHT "Only that the royal family remains safe."
    SILVER_KNIGHT "Solo que la familia real permanezca a salvo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1773
translate es qst_JudgementDay_RescueMages_MoveOn_cd3ce366:

    # "Erika gulped, the color draining from her face as she likely questioned whether even all of us combined could stop the Silver Knight."
    "Erika tragó saliva, el color se le fue de la cara mientras se preguntaba si incluso todos nosotros juntos podríamos detener al caballero de plata."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1774
translate es qst_JudgementDay_RescueMages_MoveOn_e5d01a38:

    # MC "Princess Cecilia has tasked us with finding her brother, Prince Naran, and returning him to the castle."
    MC "Princess Cecilia has tasked us with finding her brother, Prince Naran, and returning him to the castle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1775
translate es qst_JudgementDay_RescueMages_MoveOn_15b97946:

    # "The Silver Knight studied me carefully before turning his gaze to Erika."
    "El caballero de plata me estudió cuidadosamente antes de girar su mirada hacia Erika."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1776
translate es qst_JudgementDay_RescueMages_MoveOn_f04727a6:

    # SILVER_KNIGHT "Princess Cecilia should be in the castle."
    SILVER_KNIGHT "La Princesa Cecilia debería estar en el castillo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1777
translate es qst_JudgementDay_RescueMages_MoveOn_2be6c7a0:

    # SILVER_KNIGHT "How did this creature approach her?"
    SILVER_KNIGHT "¿Cómo se acercó esta criatura a ella?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1778
