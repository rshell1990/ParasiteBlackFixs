    # BLACK "{i}Go. Now!{/i}"
    BLACK "{i}¡Ve. Ahora!{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:200
translate es qst_JudgementDay_SiegeStart_769fcdbc:

    # "The little girl, staring in awe, was pulled by her terrified mother as they fled, while the ghouls now turned their attention toward me."
    "La niña, mirando con asombro, fue arrastrada por su aterrorizada madre mientras huían, mientras los ghouls ahora centraban su atención hacia mí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:203
translate es qst_JudgementDay_SiegeStart_a19998ff:

    # "With my blades at the ready, I snarled and roared at the ghoulish monstrosities."
