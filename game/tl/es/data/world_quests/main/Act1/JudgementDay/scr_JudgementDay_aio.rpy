translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_eec23752:

    # PHOAH @ talk "That is how {i}we{/i} knew him long ago..."
    PHOAH @ talk "Así es como {i}le{/i} conocimos hace tiempo..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3813
