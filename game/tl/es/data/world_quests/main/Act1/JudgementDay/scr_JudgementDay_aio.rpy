    # "Guards. Watching. Spears pointed."
    "Guardias. Observando. Lanzas apuntando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2525
translate es qst_JudgementDay_TrialStart_9e7c1a0d:

    # GUARD "Get up."
    GUARD "Levántate."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2526
translate es qst_JudgementDay_TrialStart_16394309:

    # GUARD "Your trial will begin shortly."
    GUARD "Tu juicio comenzará en breve."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2528
translate es qst_JudgementDay_TrialStart_8626a9cf:

    # "Before I even had the chance to rise, rough hands seized me."
    "Antes de que siquiera tuviera la oportunidad de levantarme, unas manos ásperas me cogieron."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2529
translate es qst_JudgementDay_TrialStart_6ad143bd:

    # "Cold metal clamped around my wrists and ankles as I was bound in chains."
    "Un frío metal se cerró alrededor de mis muñecas y tobillos mientras me encadenaban."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2535
translate es qst_JudgementDay_TrialStart_1ebf7804:

    # "They dragged me from my cell, my feet barely able to find the ground as I was pulled through the winding halls."
    "Me sacaron de mi celda, mis pies apenas podían encontrar el suelo mientras me arrastraban por los pasillos serpenteantes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2536
translate es qst_JudgementDay_TrialStart_c3a4dd44:

    # "At last, we stopped before great, heavy, ornate doors."
    "Por fin, nos detuvimos ante unas puertas grandes, pesadas y ornamentadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2537
translate es qst_JudgementDay_TrialStart_0f1cc5fe:

    # "They groaned open, revealing my fate."
    "Se abrieron con un gruñido, revelando mi destino."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2541
translate es qst_JudgementDay_TrialStart_e1220ead:

    # "The courtroom."
    "La sala del tribunal."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2542
translate es qst_JudgementDay_TrialStart_fbb742c0:

    # "To my left, seated in perfect rows, were men in deep blue and purple robes, their faces obscured behind silver masks."
    "A mi izquierda, sentados en filas perfectas, había hombres con túnicas de color azul oscuro y morado, con los rostros ocultos tras máscaras plateadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2543
translate es qst_JudgementDay_TrialStart_6c66f9f3:

    # "Above them, seated upon high stone podiums flanking two burning firepits, sat three more figures."
    "Sobre ellos, sentadas en podios altos de piedra flanqueando dos braseros encendidos, se encontraban tres figuras más."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2544
translate es qst_JudgementDay_TrialStart_ca7194e9:

    # "Their robes were red, their masks gleaming."
    "Sus túnicas eran rojas, sus máscaras brillaban."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2546
translate es qst_JudgementDay_TrialStart_fa6810be:

    # "Shoved forward into the center of the chamber, I scanned the crowd for familiar faces."
    "Empujado hacia adelante, al centro de la cámara, busqué caras conocidas entre la multitud."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2547
translate es qst_JudgementDay_TrialStart_258a0cfd:

    # "None."
    "Ninguna."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2548
translate es qst_JudgementDay_TrialStart_92747b53:

    # "Only more masked figures. Watching. Waiting."
    "Solo más figuras enmascaradas. Observando. Esperando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2549
translate es qst_JudgementDay_TrialStart_2160188b:

    # GUARD "Judge Falwind. I present to you the prisoner."
    GUARD "Juez Falwind. Le presento al prisionero."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2550
translate es qst_JudgementDay_TrialStart_3002041b:

    # "The murmurs around the chamber quieted as all eyes turned to me."
    "Los murmullos en la cámara se silenciaron mientras todas las miradas se volvían hacia mí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2551
translate es qst_JudgementDay_TrialStart_72502109:

    # JUDGE_FALWIND "Good morning, prisoner nine-six-one."
    JUDGE_FALWIND "Buenos días, prisionero nueve-seis-uno."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2552
translate es qst_JudgementDay_TrialStart_c2cba07d:

    # JUDGE_FALWIND "Are you aware of the charges laid against you by Head Inquisitor Marion?"
    JUDGE_FALWIND "¿Eres consciente de los cargos presentados en tu contra por la Gran inquisidora Marion?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2555
translate es qst_JudgementDay_TrialStart_3c0000a5:

    # JUDGE_FALWIND "Good. Then you understand the seriousness of the matter."
    JUDGE_FALWIND "Bien. Entonces entiendes la seriedad del asunto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2557
translate es qst_JudgementDay_TrialStart_5b07853c:

    # JUDGE_FALWIND "That is for the court to decide, nine-six-one."
    JUDGE_FALWIND "Eso es algo que decidirá el tribunal, nueve-seis-uno."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2561
translate es qst_JudgementDay_TrialStart_7c8f63d4:

    # "Angry murmurs erupted across the courtroom until Judge Falwind slammed his gavel down."
    "Murmullos de enfado estallaron por toda la sala del tribunal hasta que el juez Falwind golpeó su mazo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2564
translate es qst_JudgementDay_TrialStart_53dd2759:

    # JUDGE_FALWIND "I will not tolerate such behavior in my courtroom. I suggest you rethink your actions immediately."
    JUDGE_FALWIND "No toleraré tal comportamiento en mi sala. Te sugiero que reconsideres tus acciones de inmediato."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2567
translate es qst_JudgementDay_TrialStart_5241f00d:

    # "The judge skimmed over a stack of papers, stroking his beard as he located the page he sought."
    "El juez hojeó una pila de papeles, acariciándose la barba mientras encontraba la página que buscaba."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2568
translate es qst_JudgementDay_TrialStart_7924de91:

    # JUDGE_FALWIND "Hmm..."
    JUDGE_FALWIND "Hmm..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2569
translate es qst_JudgementDay_TrialStart_e3555e30:

    # JUDGE_FALWIND "Where is the other one?"
    JUDGE_FALWIND "¿Dónde está el otro?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2570
translate es qst_JudgementDay_TrialStart_ce8407d2:

    # JUDGE_FALWIND "There was to be one more on trial, was there not?"
    JUDGE_FALWIND "¿No iba a haber uno más en el juicio?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2572
translate es qst_JudgementDay_TrialStart_cd1bd15b:

    # "The doors swung open again."
    "Las puertas se abrieron de nuevo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2573
translate es qst_JudgementDay_TrialStart_16f92352:

    # "A beaten, disheveled Markus was dragged into the chamber."
    "Un Markus golpeado y desaliñado fue arrastrado a la cámara."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2574
translate es qst_JudgementDay_TrialStart_03e586ea:

    # "He was barely conscious."
    "Apenas estaba consciente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2576
translate es qst_JudgementDay_TrialStart_0c3a177d:

    # MC @ surprised "MARKUS!"
    MC @ surprised "¡MARKUS!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2577
translate es qst_JudgementDay_TrialStart_126e9dbc:

    # "I moved to reach him, but the guards immediately blocked my path."
    "Me moví para alcanzarlo, pero los guardias inmediatamente bloquearon mi camino."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2578
translate es qst_JudgementDay_TrialStart_bf497fdc:

    # JUDGE_FALWIND "Remain still, prisoner nine-six-one."
    JUDGE_FALWIND "Permanece quieto, prisionero nueve-seis-uno."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2581
translate es qst_JudgementDay_TrialStart_f5383f45:

    # "With a cruel *thud,* they dropped Markus beside me."
    "Con un cruel *thud*, dejaron caer a Markus a mi lado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2582
translate es qst_JudgementDay_TrialStart_eb59abcc:

    # "He coughed up blood, his voice weak."
    "Tosió sangre y su voz era débil."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2577
translate es qst_JudgementDay_TrialStart_91cc76d8:

    # MARKUS "{i}*Weakly*{/i} [player_name!t]..."
    MARKUS "{i}*Débilmente*{/i} [player_name!t]..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2586
translate es qst_JudgementDay_TrialStart_02699468:

    # MC @ angry "How is he supposed to defend himself?!"
    MC @ angry "¡¿Cómo se supone que va a defenderse?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2587
translate es qst_JudgementDay_TrialStart_ca60b975:

    # MC @ angry "He can barely stand, let alone speak!"
    MC @ angry "¡Apenas puede ponerse de pie, y mucho menos hablar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2588
translate es qst_JudgementDay_TrialStart_d3515b39:

    # "Judge Falwind's gaze turned toward the guards."
    "La mirada del juez Falwind se volvió hacia los guardias."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2589
translate es qst_JudgementDay_TrialStart_9dc22665:

    # JUDGE_FALWIND "Explain prisoner eight-four-one's condition."
    JUDGE_FALWIND "Expliquen el estado del prisionero ocho-cuatro-uno."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2591
translate es qst_JudgementDay_TrialStart_13ea9dda:

    # GUARD "Apologies, Judge Falwind. The prisoner was… uncooperative."
    GUARD "Disculpas, juez Falwind. El prisionero… no cooperó."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2592
translate es qst_JudgementDay_TrialStart_f0053ee9:

    # GUARD "We had to use severe restraint."
    GUARD "Tuvimos que usar restricción severa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2594
translate es qst_JudgementDay_TrialStart_7fad3231:

    # MC @ angry "YOU BEAT HIM HALF TO DEATH!"
    MC @ angry "¡LO GOLPEARON HASTA DEJARLO MEDIO MUERTO!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2597
translate es qst_JudgementDay_TrialStart_be7b5f6d:

    # "*BANG!*"
    "*¡BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2598
translate es qst_JudgementDay_TrialStart_f6fda186:

    # "Falwind's gavel slammed down."
    "El mazo de Falwind cayó con fuerza."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2600
translate es qst_JudgementDay_TrialStart_f154a8d0:

    # JUDGE_FALWIND "Control your emotions, nine-six-one, or I shall have you reprimanded further."
    JUDGE_FALWIND "Controla tus emociones, nueve-seis-uno, o haré que te reprendan aún más."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2601
translate es qst_JudgementDay_TrialStart_6f0d1973:

    # "With a heavy sigh, he glanced back at Markus, who lay crumpled on the floor."
    "Con un pesado suspiro, volvió a mirar a Markus, que yacía desplomado en el suelo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2602
translate es qst_JudgementDay_TrialStart_643281fa:

    # JUDGE_FALWIND "Given the unfortunate state of your accomplice, we will proceed with your testimony speaking on his behalf."
    JUDGE_FALWIND "Dada la desafortunada condición de tu cómplice, procederemos con tu testimonio hablando en su nombre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2607
translate es qst_JudgementDay_TrialStart_5b071465:

    # JUDGE_FALWIND "Hold your tongue, nine-six-one! I will not tolerate contempt in my court!"
    JUDGE_FALWIND "¡Silencio, nueve-seis-uno! ¡No toleraré desacato en mi tribunal!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2610
translate es qst_JudgementDay_TrialStart_38318e26:

    # "The judge hesitated, then waved a hand dismissively."
    "El juez titubeó, luego agitó una mano con desdén."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2611
translate es qst_JudgementDay_TrialStart_42e2d16d:

    # JUDGE_FALWIND "Very well. Summon a Mage of Palam to tend to him."
    JUDGE_FALWIND "Muy bien. Que llamen a una maga de Palam para que lo atienda."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2613
translate es qst_JudgementDay_TrialStart_4f2b5c04:

    # "The judge nodded, satisfied with my compliance."
    "El juez asintió, satisfecho con mi obediencia."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2615
translate es qst_JudgementDay_TrialStart_14adb04d:

    # JUDGE_FALWIND "Has the prosecution arrived?"
    JUDGE_FALWIND "¿Ha llegado la acusación?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2616
translate es qst_JudgementDay_TrialStart_fdc8f651:

    # GUARD "She has, Judge Falwind."
    GUARD "Sí, ha llegado, juez Falwind."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2617
translate es qst_JudgementDay_TrialStart_cd89cb8b:

    # JUDGE_FALWIND "Send her in."
    JUDGE_FALWIND "Déjenla pasar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2618
translate es qst_JudgementDay_TrialStart_47151da1:

    # "The massive doors opened once more."
    "Las enormes puertas se abrieron una vez más."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2619
translate es qst_JudgementDay_TrialStart_36d06b98:

    # "A figure stepped forward."
    "Una figura dio un paso adelante."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2620
translate es qst_JudgementDay_TrialStart_4fc678a8:

    # "Not Inquisitor Henvak, as expected."
    "No el inquisidor Henvak, como esperaba."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2621
translate es qst_JudgementDay_TrialStart_af94376b:

    # "But an older woman. Head Inquisitor Marion."
    "Pero una mujer mayor. Gran inquisidora Marion."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2623
translate es qst_JudgementDay_TrialStart_e682a58d:

    # "Uneasy murmurs rose across the court."
    "Inquietos murmullos se alzaron por toda la corte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2624
translate es qst_JudgementDay_TrialStart_32fb436b:

    # "Even Judge Falwind stiffened at the sight of her."
    "Incluso el juez Falwind se puso tenso al verla."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2625
translate es qst_JudgementDay_TrialStart_6ebe2672:

    # JUDGE_FALWIND "H-Head Inquisitor!"
    JUDGE_FALWIND "¡G-gran inquisidora!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2626
translate es qst_JudgementDay_TrialStart_8d9108b7:

    # MARION "I trust I am not late."
    MARION "Confío en no llegar tarde."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2628
translate es qst_JudgementDay_TrialStart_f9ebf287:

    # JUDGE_FALWIND "E-Er, no, Inquisitor. But… on the paperwork, it states that Inquisitor Henvak was to handle the prosecution."
    JUDGE_FALWIND "E-er, no, inquisidora. Pero… en los documentos, se indica que el inquisidor Henvak debía llevar la acusación."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2629
translate es qst_JudgementDay_TrialStart_90e8994d:

    # MARION "Henvak is indisposed."
    MARION "Henvak está indispuesto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2630
translate es qst_JudgementDay_TrialStart_b657aaee:

    # MARION "Given the attention this trial has drawn, I have decided to intercede."
    MARION "Dada la atención que ha generado este juicio, he decidido interceder."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2631
translate es qst_JudgementDay_TrialStart_a4e6991c:

    # JUDGE_FALWIND "I… see. But Head Inquisitor, this is most unorthodox. Have you had adequate time to prepare?"
    JUDGE_FALWIND "Ya… veo. Pero Gran inquisidora, esto es de lo más heterodoxo. ¿Ha tenido tiempo suficiente para prepararse?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2632
translate es qst_JudgementDay_TrialStart_30dfe46f:

    # MARION "I have, your honor."
    MARION "Sí, su señoría."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2633
translate es qst_JudgementDay_TrialStart_273760c0:

    # "The judge clearly did not like this."
    "El juez claramente no estaba contento con esto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2634
translate es qst_JudgementDay_TrialStart_3c7efe4d:

    # "But denying Marion's authority was… unwise."
    "Pero negar la autoridad de Marion era… imprudente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2635
translate es qst_JudgementDay_TrialStart_ce31a9d3:

    # JUDGE_FALWIND "Very well."
    JUDGE_FALWIND "Muy bien."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2636
translate es qst_JudgementDay_TrialStart_982fa314:

    # JUDGE_FALWIND "With all parties present, would the prosecution like to make its opening statement?"
    JUDGE_FALWIND "Con todas las partes presentes, ¿querría la acusación hacer su declaración de apertura?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2637
translate es qst_JudgementDay_TrialStart_2eb85663:

    # MARION "I would, your honor."
    MARION "Así es, su señoría."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2638
translate es qst_JudgementDay_TrialStart_f15830e3:

    # "The Head Inquisitor stepped forward."
    "La Gran inquisidora dio un paso al frente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2639
translate es qst_JudgementDay_TrialStart_14740c7f:

    # "Her voice cut through the chamber, sharp and commanding."
    "Su voz cortó el aire de la cámara, aguda y dominante."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2640
translate es qst_JudgementDay_TrialStart_a1d051f8:

    # MARION "Today, the prosecution will prove—beyond doubt—that this creature is the result of dark magecraft!"
    MARION "¡Hoy, la acusación probará, más allá de toda duda, que esta criatura es el resultado de magia oscura!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2641
translate es qst_JudgementDay_TrialStart_7b0f4d51:

    # MARION "That it has been consorting with the Demorai."
    MARION "Que ha estado consorciando con los demorai."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2642
translate es qst_JudgementDay_TrialStart_90e0a29b:

    # MARION "That it is at the very heart of a conspiracy to corrupt this city's highest officials!"
    MARION "¡Que está en el mismísimo centro de una conspiración para corromper a los más altos funcionarios de esta ciudad!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2644
translate es qst_JudgementDay_TrialStart_8f14909a:

    # "The courtroom exploded in voices."
    "El tribunal estalló en voces."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2645
translate es qst_JudgementDay_TrialStart_1c998cdd:

    # "Gasps. Whispers. Outright accusations."
    "Jadeos. Susurros. Acusaciones descaradas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2647
translate es qst_JudgementDay_TrialStart_be7b5f6d_1:

    # "*BANG!*"
    "*¡BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2648
translate es qst_JudgementDay_TrialStart_be7b5f6d_2:

    # "*BANG!*"
    "*¡BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2649
translate es qst_JudgementDay_TrialStart_b7f53723:

    # JUDGE_FALWIND "ORDER! ORDER!"
    JUDGE_FALWIND "¡ORDEN! ¡ORDEN!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2651
translate es qst_JudgementDay_TrialStart_b42540ba:

    # "As silence returned, he exhaled deeply."
