    MC @ think "Pareces muy comunicativo con todo esto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3574
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_659b07b0:

    # GUARD "Some people come here and think because we've no laws they can just do {i}whatever{/i} they like."
    GUARD "Algunos vienen aquí y creen que porque no tenemos leyes pueden hacer {i}lo que les dé la gana.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3575
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_2750a12b:

    # GUARD "It's best to let them know that would be a poor choice."
    GUARD "Es mejor hacerles saber que sería una mala elección."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3578
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_d13669b0:

    # GUARD "Do I look like a tour guide?"
    GUARD "¿Parezco un guía turístico?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3579
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_d3bb6433:

    # GUARD "Fuck off, buy yourself a couple sellswords and have them show you around!"
    GUARD "¡Vete a la mierda, cómprate un par de mercenarios y que te enseñen el lugar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3583
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_276c314a:

    # GUARD "Go on then, in ya get."
    GUARD "Vamos, entra."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3591
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_15e2997a:

    # KIARA @ happy "Ahh... Finally! We've made it."
    KIARA @ happy "Ahh... ¡Por fin! Lo hemos conseguido."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3592
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_310c3340:

    # MC @ talk "What now?"
    MC @ talk "¿Ahora qué?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3593
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_3a698037:

    # KIARA @ talk "{i}The Pale Dragon.{/i}"
    KIARA @ talk "{i}El dragón pálido.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3594
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6351a36b:

    # KIARA @ talk "It's an inn nearby, we have a room already prepared for us."
    KIARA @ talk "Es una taberna cercana, tenemos una habitación ya preparada para nosotros."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3597
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_3dc1a544:

    # MARKUS @ shock "Gods... Look at this place!"
    MARKUS @ shock "Dioses... ¡Mira este lugar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3598
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_b702726f:

    # MARKUS @ shock "I had heard rumors about how much the city had changed since it broke away, but-"
    MARKUS @ shock "Había oído rumores sobre lo mucho que había cambiado la ciudad desde que se separó, pero-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3599
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_095355cd:

    # MARKUS @ joy "It's certainly an impressive sight."
    MARKUS @ joy "Desde luego, es una vista impresionante."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3605
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_4999deb8:

    # VES @ talk "..."
    VES @ talk "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3607
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_93e74526:

    # MC @ talk "Ves? Are you alright?"
    MC @ talk "¿Ves? ¿Estás bien?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3608
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_2fda7f15:

    # VES @ talk "Yes... Just-"
    VES @ talk "Sí... Solo-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3609
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_a866539e:

    # VES @ blush "It's been a long time since I've been around so many people."
    VES @ blush "Hacía mucho tiempo que no estaba rodeada de tanta gente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3610
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6eec3fc9:

    # MC @ talk "So, what's your plan now you're here?"
    MC @ talk "¿Cuál es tu plan ahora que estás aquí?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3614
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_64bb87e3:

    # VES @ talk "I'm looking for someone."
    VES @ talk "Estoy buscando a alguien."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3615
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_17dd6ac1:

    # VES @ blush "... But, perhaps if you don't mind, I could stay with you and the others for a while."
    VES @ blush "... Pero, tal vez si no te importa, podría quedarme contigo y los demás por un tiempo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3616
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6a80da6d:

    # MC @ think "Who are you looking for?"
    MC @ think "¿A quién estás buscando?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3617
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_1b256352:

    # "Ves opened her mouth to say something, but she paused and smiled awkwardly, changing the subject quickly."
    "Ves abrió la boca para decir algo, pero hizo una pausa y sonrió torpemente, cambiando rápidamente de tema."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3618
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_2c8bbd11:

    # VES @ smile "I'll... tell you about it another time."
    VES @ smile "Te... lo contaré en otro momento."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3619
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_f97d9bbc:

    # VES @ talk "Come, I'm tired... Let's find this {i}Pale Dragon.{/i}"
    VES @ talk "Vamos, estoy cansada... Encontremos a este {i}dragón pálido.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3633
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_bad11f44:

    # "Smoke rose from every corner of the inn, a mixture of strange, hot aromas like that of sweet, crushed flowers all mixed in."
    "El humo salía de todos los rincones de la posada, una mezcla de aromas extraños y calientes como el de las flores dulces y machacadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3634
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_8ac356c7:

    # "With every breath, you could feel a small surge of energy as the whole place seemed embraced by a hazy fog."
    "Con cada respiración, se podía sentir una pequeña oleada de energía mientras todo el lugar parecía abrazado por una brumosa niebla."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3635
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_a9959744:

    # "Sat hudled around tables, men, women, {i}other things,{/i} sat smoking from their pipes as the raza choked the air."
    "Sentados apretujados alrededor de las mesas, hombres, mujeres, {i}otras cosas,{/i} sentados fumando de sus pipas mientras la raza ahogaba el aire."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3636
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_007901a8:

    # "In and around the place were guards, always watching, already ready for trouble, as the loosely dressed women served drinks."
    "Dentro y sus alrededores había guardias, siempre vigilantes, listos para cualquier problema, mientras las mujeres, ligeras de ropas, servían bebidas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3640
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_4e4e3c61:

    # RANIA @ talk "Welcome... Welcome to {i}The Pale dragon,{/i} I am your host, Rania."
    RANIA @ talk "Bienvenidos... Bienvenidos al {i}dragón pálido,{/i} soy su anfitriona, Rania."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3642
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_456841ec:

    # RANIA @ talk "What pleasures do you and your companions seek?"
    RANIA @ talk "¿Qué placeres buscáis tú y tus compañeros?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3643
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_72b4870f:

    # RANIA @ smile "Perhaps some Raza or... {i}companionship?{/i}"
    RANIA @ smile "Quizás algo de raza o... {i}¿compañía?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3644
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_e06794ab:

    # "The woman looked towards me and Markus, pulling down her dress slightly to expose a breast as she winked."
    "La mujer miró hacia mí y hacia Markus, bajándose ligeramente el vestido para dejar al descubierto un pecho mientras nos guiñaba un ojo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3645
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_b4652a2d:

    # MC @ lewd "Well-"
    MC @ lewd "Bueno-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3646
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_b70528c0:

    # KIARA @ angry "We should be meeting a friend here in one of the rooms upstairs."
    KIARA @ angry "Hemos quedado con una amiga en una de las habitaciones de arriba."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3647
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_0d2e6967:

    # KIARA @ talk "{i}The one with a view so you might see the dragon to the east.{/i}"
    KIARA @ talk "{i}La que tiene vistas para que puedas ver el dragón al este.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3648
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6b161c8d:

    # "Rania's eyes widened as she smiled."
    "Los ojos de Rania se abrieron de par en par mientras sonreía."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3649
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_26dbca39:

    # RANIA @ smile "Ahh... Yes."
    RANIA @ smile "Ahh... Sí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3650
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_18a797f5:

    # RANIA @ smile "Everything is already ready for you, first room on the left upstairs."
    RANIA @ smile "Todo está ya listo, primera habitación a la izquierda arriba."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3651
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_9856acc2:

    # "Rania's eyes glanced over towards those with me."
    "Los ojos de Rania miraron a quienes estaban conmigo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3652
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_8f3729b3:

    # RANIA @ talk "For your companions, we have some rooms further down the hall."
    RANIA @ talk "Para tus acompañantes, tenemos algunas habitaciones al final del pasillo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3653
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_367b6b8c:

    # RANIA @ smile "We hope you enjoy your stay with us."
    RANIA @ smile "Esperamos que disfrute de su estancia con nosotros."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3663
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_8baba82b:

    # MC @ talk "... Now what?"
    MC @ talk "... ¿Y ahora qué?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3664
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_95d5d7eb:

    # KIARA @ talk "Rest. Stay here the night where it's safe, in the morning then, my mistress should join us."
    KIARA @ talk "Descansa. Quédate aquí la noche donde es seguro, por la mañana entonces, mi señora debe unirse a nosotros."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3665
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_9483b162:

    # MC @ think "You still haven't explained everything like you said you would."
    MC @ think "Todavía no has explicado todo como dijiste que harías."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3666
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_384a3513:

    # KIARA @ talk "In time, for now, just rest."
    KIARA @ talk "Con el tiempo, por ahora, solo descansa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3667
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_5303acdd:

    # KIARA @ talk "It's been quite the journey just to get here."
    KIARA @ talk "Ha sido todo un periplo llegar hasta aquí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3668
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_4e981b88:

    # MC @ serious "... Fine."
    MC @ serious "... Está bien."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3669
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_5e60fe78:

    # KIARA @ talk "Just call if you need me."
    KIARA @ talk "Llámame si me necesitas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3676
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6b3d694c:

    # MC "(...Just what am I walking into now?)"
    MC "(...¿En qué me estoy metiendo ahora?)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3677
translate es qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_78e5b98a:

    # MC "(I should get some rest.)"
    MC "(Debería descansar un poco)."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3707
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_b2f9b151:

    # "... Swirling around me, an endless black sea cut through by a rift of stars and strange colors."
    "... Girando a mi alrededor, un interminable mar negro cortado por una grieta de estrellas y colores extraños."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3708
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_f69770e0:

    # "Three bright suns surrounded a great dark circle, radiating a strange power."
    "Tres soles brillantes rodeaban un gran círculo oscuro, irradiando un extraño poder."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3709
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_df7c51ac:

    # "Stood on some strange rock platform, the two figures, unlike anything I'd ever seen before, turned their gaze towards me."
    "De pie sobre una extraña plataforma rocosa, las dos figuras, distintas a todo lo que había visto antes, dirigieron su mirada hacia mí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3710
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_dc2b54fd:

    # MC "Where... Where am I?"
    MC "¿Dónde...? ¿Dónde estoy?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3711
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_ff987929:

    # "I looked down, gazing for where my hands, my body, {i}something{/i} should be."
    "Miré hacia abajo, buscando dónde deberían estar mis manos, mi cuerpo, {i}algo{/i}."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3712
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_a4b95f12:

    # "But there was nothing... It was as though I was just two floating, unblinking eyes, unable to move."
    "Pero no había nada... Era como si solo tuviese dos ojos flotantes, sin pestañear, incapaces de moverse."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3720
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_545bd3fb:

    # "I spoke... And yet my mouth did not move."
    "Hablé... Y sin embargo mi boca no se movió."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3703
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_46bc43b7:

    # HIRRAH "Greetings... [player_name!t]."
    HIRRAH "Saludos... [player_name!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3722
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_088be4d0:

    # HIRRAH "Or is it, {i}Shyahtan?{/i}"
    HIRRAH "¿O es, {i}Shyahtan?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3723
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_d745a6ac:

    # "The strange being seemed to chuckle, her soft voice so strangely hypnotic and soothing."
    "El extraño ser pareció reírse entre dientes, con su suave voz extrañamente hipnótica y tranquilizadora."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3724
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_4989ee90:

    # HIRRAH "Always so hard to keep up these days."
    HIRRAH "Siempre es tan difícil mantenerse al día hoy en día."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3725
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_82579f71:

    # PHOAH @ angry "We're wasting time, Hirrah."
    PHOAH @ angry "Estamos perdiendo el tiempo, Hirrah."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3726
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_e85088b4:

    # HIRRAH "The last thing we need is to frighten him."
    HIRRAH "Lo último que necesitamos es asustarlo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3727
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_5800b448:

    # MC "Who... Who are you both?"
    MC "¿Quiénes...? ¿Quiénes sois?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3729
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_fad590e3:

    # MC "What am I doing here?!"
    MC "¡¿Qué estoy haciendo aquí?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3729
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_270e83dd:

    # PHOAH @ angry "See? Now the human is panicking anyway!"
    PHOAH @ angry "¿Lo ves? ¡Ahora el humano tiene pánico de todos modos!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3730
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_c5966931:

    # HIRRAH "Human might be quite the stretch given the circumstances."
    HIRRAH "Humano podría ser un poco exagerado dadas las circunstancias."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3731
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_914501fa:

    # MC "W-Where am I?"
    MC "¿D-dónde estoy?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3732
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_8899306e:

    # MC "What is this place??"
    MC "¿Qué es este lugar?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3733
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_3249a9fb:

    # MC "WHO ARE YOU?"
    MC "¿QUIÉNES SOIS?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3734
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_b8c817a1:

    # PHOAH @ talk "{i}*Sigh*{/i}"
    PHOAH @ talk "{i}*Suspiro*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3735
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_03dbc9d5:

    # PHOAH @ angry "I am Phoah, goddess of justice."
    PHOAH @ angry "Soy Phoah, diosa de la justicia."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3736
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_2025b956:

    # PHOAH @ talk "This is Hirrah, goddess of fertility."
    PHOAH @ talk "Esta es Hirrah, diosa de la fertilidad."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3737
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_9ef7dad6:

    # "I stared at the strange beings before me in disbelief."
    "Miré incrédulo a los extraños seres que tenía ante mí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3738
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_741be655:

    # "Were they..."
    "Eran..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3739
translate es qst_JudgementDay_PostQuestArrivedToHamun_Dream_3e1c9fce:

    # "No, gods and goddesses... Such a ridiculous thing!"
    "No, dioses y diosas... ¡Qué cosa tan ridícula!"

