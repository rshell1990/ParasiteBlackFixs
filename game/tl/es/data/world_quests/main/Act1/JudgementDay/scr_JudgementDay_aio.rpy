translate es qst_JudgementDay_GotToTheWall_c8f6334b:

    # "A silhouette stood before me, dressed in flowing black robes."
    "Una silueta se alzaba ante mí, vestida con túnicas negras ondeantes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2017
translate es qst_JudgementDay_GotToTheWall_8f8d6fbd:

    # "Her piercing gaze…"
    "Su mirada penetrante…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2018
translate es qst_JudgementDay_GotToTheWall_8cd09fc7:

    # "Her eyes were burning, glowing with an eerie purple light."
    "Sus ojos ardían, brillando con una extraña luz púrpura."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2019
translate es qst_JudgementDay_GotToTheWall_f48a3502:

    # "{i}Regina?{/i}"
    "{i}¿Regina?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2020
translate es qst_JudgementDay_GotToTheWall_67c3a78d:

    # "Zanarak paused, his attention snapping toward her."
    "Zanarak se detuvo, su atención dirigiéndose hacia ella."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2021
translate es qst_JudgementDay_GotToTheWall_29f53885:

    # "For the first time, he hesitated."
    "Por primera vez, dudó."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2022
translate es qst_JudgementDay_GotToTheWall_810d77d2:

    # REGINA "I'm afraid that one belongs to me."
    REGINA "Me temo que ese me pertenece."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2023
translate es qst_JudgementDay_GotToTheWall_2d783a8c:

    # REGINA "{i}You{/i} cannot have them, Lord of Death."
    REGINA "{i}Tú{/i} no puedes tenerlos, señor de la muerte."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2024
translate es qst_JudgementDay_GotToTheWall_30ba9b7b:

    # "A low growl rumbled from Zanarak's throat."
    "Un gruñido grave brotó de la garganta de Zanarak."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2025
translate es qst_JudgementDay_GotToTheWall_65b1c4dc:

    # "But then, his body tensed as Regina lifted her hand."
    "Pero entonces, su cuerpo se tensó cuando Regina levantó la mano."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2031
translate es qst_JudgementDay_GotToTheWall_8784d294:

    # "A blinding burst of pure energy surged from her palm, slamming into him with the force of a divine hammer."
    "Un estallido cegador de energía pura surgió de su palma, golpeándolo con la fuerza de un martillo divino."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2035
translate es qst_JudgementDay_GotToTheWall_5f0f8fc6:

    # "Then another."
    "Luego, otro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2040
translate es qst_JudgementDay_GotToTheWall_ced8bc7e:

    # "And another."
    "Y otro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2041
translate es qst_JudgementDay_GotToTheWall_2f33beef:

    # REGINA "Go back to your master!"
    REGINA "¡Vuelve con tu amo!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2042
translate es qst_JudgementDay_GotToTheWall_3e00d2ef:

    # REGINA "Crawl back to that realm of shadows and LET US BE!"
    REGINA "¡Vuelve a ese reino de sombras y DÉJANOS EN PAZ!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2043
translate es qst_JudgementDay_GotToTheWall_1b87c9c9:

    # "The final explosion of energy was unlike anything I had ever seen."
    "La explosión final de energía fue diferente a todo lo que había visto antes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2047
translate es qst_JudgementDay_GotToTheWall_b3ab840a:

    # "A radiant light so brilliant that, for a brief moment, it eclipsed the night itself."
    "Una luz radiante tan brillante que, por un breve momento, eclipsó la noche misma."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2048
translate es qst_JudgementDay_GotToTheWall_ebd6e601:

    # "It could be seen across the entire battlefield."
    "Se podía ver a lo largo de todo el campo de batalla."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2049
translate es qst_JudgementDay_GotToTheWall_2ad66e87:

    # "Zanarak reeled back—his body, for the first time, truly *pushed.*"
    "Zanarak retrocedió, su cuerpo, por primera vez, verdaderamente *empujado.*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2051
translate es qst_JudgementDay_GotToTheWall_c5f3ac16:

    # "And then, like some dark, fallen god, he plummeted from the edge of the city wall."
    "Y entonces, como un dios oscuro y caído, se desplomó desde el borde de la muralla de la ciudad."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2052
translate es qst_JudgementDay_GotToTheWall_94704099:

    # "The monstrous figure fell."
    "La figura monstruosa cayó."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2053
translate es qst_JudgementDay_GotToTheWall_98bfc091:

    # "His enormous wings stretched wide as he tumbled downward—down into the abyss below."
    "Sus enormes alas se extendieron mientras caía, hacia el abismo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2059
translate es qst_JudgementDay_GotToTheWall_bdc11f58:

    # "My vision blurred again."
    "Mi visión se volvió a nublar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2060
translate es qst_JudgementDay_GotToTheWall_2812f4c6:

    # "I barely registered Regina kneeling beside me."
    "Apenas me di cuenta de que Regina estaba arrodillada a mi lado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2061
translate es qst_JudgementDay_GotToTheWall_5d30c702:

    # "Her soft fingers caressed my face, her touch almost… soothing."
    "Sus suaves dedos acariciaron mi rostro, su toque casi… reconfortante."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2062
translate es qst_JudgementDay_GotToTheWall_874f76db:

    # REGINA "Don't worry, dear."
    REGINA "No te preocupes, cariño."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2063
translate es qst_JudgementDay_GotToTheWall_3e3d9a73:

    # REGINA "{i}I'll always keep you safe.{/i}"
    REGINA "{i}Siempre te mantendré a salvo.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2066
translate es qst_JudgementDay_GotToTheWall_f67029cc:

    # "Then, in an instant, she was gone."
    "Entonces, en un instante, desapareció."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2067
translate es qst_JudgementDay_GotToTheWall_7387828c:

    # "Her form melted into a swirling mass of black crows that scattered into the night."
    "Su forma se disolvió en una masa arremolinada de cuervos negros que se dispersaron en la noche."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2062
translate es qst_JudgementDay_GotToTheWall_00bde783:

    # MC "...[regina_ref!t]."
    MC "...[regina_ref!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2075
translate es qst_JudgementDay_GotToTheWall_9b612355:

    # "As my consciousness faded, I saw armored figures rushing toward me."
    "Mientras mi conciencia se desvanecía, vi figuras blindadas corriendo hacia mí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2076
translate es qst_JudgementDay_GotToTheWall_1c3a213e:

    # "Guards."
    "Guardias."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2077
translate es qst_JudgementDay_GotToTheWall_4db81c85:

    # "Inquisitors."
    "Inquisidores."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2078
translate es qst_JudgementDay_GotToTheWall_199dcb7a:

    # "Soon, the sharp glint of spearheads surrounded me."
    "Pronto, el brillante destello de las puntas de las lanzas me rodeó."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2082
translate es qst_JudgementDay_GotToTheWall_b8778a4d:

    # "And then… nothing."
    "Y entonces… nada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2083
translate es qst_JudgementDay_GotToTheWall_c58b41a1:

    # "Darkness."
    "Oscuridad."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2084
translate es qst_JudgementDay_GotToTheWall_913e0985:

    # "A deep, endless sleep."
    "Un sueño profundo e interminable."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2120
translate es qst_JudgementDay_SiegeOverPrison_87c14c86:

    # "...Once again, I found myself confined to a cell. I waited. Wondered. Hoped for the best."
    "...Una vez más, me encontré confinado en una celda. Esperé. Me pregunté. Esperé lo mejor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2121
translate es qst_JudgementDay_SiegeOverPrison_4d77ac33:

    # "My secret was out, and now, I lay at the mercy of an empire that saw me as just another monster."
    "Mi secreto estaba al descubierto, y ahora, yacía a merced de un imperio que me veía como un monstruo más."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2129
translate es qst_JudgementDay_SiegeOverPrison_96c6f6da:

    # "Days drifted by in agonizing slowness."
    "Los días pasaban con una lentitud agonizante."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2130
translate es qst_JudgementDay_SiegeOverPrison_a441eaa1:

    # "A thousand times, I considered escaping, but I knew my fate would be sealed to a lifetime in exile if I tried... or worse."
    "Mil veces, consideré escapar, pero sabía que mi destino quedaría sellado a una vida de exilio si lo intentaba... o algo peor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2131
translate es qst_JudgementDay_SiegeOverPrison_a5ff08fc:

    # "My thoughts wandered to Markus, Adara, the others..."
    "Mis pensamientos vagaron hacia Markus, Adara, los demás..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2132
translate es qst_JudgementDay_SiegeOverPrison_c2501ff3:

    # "Were they safe? What was happening beyond these walls?"
    "¿Estaban a salvo? ¿Qué estaba pasando más allá de estos muros?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2133
translate es qst_JudgementDay_SiegeOverPrison_b3f25241:

    # "The guards told me nothing."
    "Los guardias no me dijeron nada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2134
translate es qst_JudgementDay_SiegeOverPrison_9715e826:

    # "They simply came, delivered bowls of food, and left in silence, leaving me to wait."
    "Ellos simplemente vinieron, entregaron cuencos de comida y se marcharon en silencio, dejándome esperando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2136
translate es qst_JudgementDay_SiegeOverPrison_f7c2f1a3:

    # "And wait."
    "Y esperando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2138
translate es qst_JudgementDay_SiegeOverPrison_f7c2f1a3_1:

    # "And wait."
    "Y esperando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2140
translate es qst_JudgementDay_SiegeOverPrison_5344897f:

    # "Each passing moment, my body betrayed me further."
    "Con cada momento que pasaba, mi cuerpo me traicionaba aún más."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2142
translate es qst_JudgementDay_SiegeOverPrison_6e40bbe3:

    # BLACK "(We must find a mate soon...)"
    BLACK "(Debemos encontrar una pareja pronto...)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2145
translate es qst_JudgementDay_SiegeOverPrison_29a0ab50:

    # MC "(If we leave now, we're finished. We'll never be able to return.)"
    MC "(Si nos vamos ahora, estamos perdidos. Nunca podremos volver)."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2148
translate es qst_JudgementDay_SiegeOverPrison_101103bd:

    # "I grimaced, feeling the burning sensation coursing through my veins—hot, relentless, growing stronger with each day."
    "Fruncí el ceño, sintiendo la ardiente sensación recorrer mis venas, caliente, implacable, creciendo con más fuerza cada día."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2151
translate es qst_JudgementDay_SiegeOverPrison_4922c733:

    # BLACK "(It matters not... We must find a mate soon.)"
    BLACK "(No importa... Debemos encontrar una pareja pronto)."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2152
translate es qst_JudgementDay_SiegeOverPrison_5d4653ce:

    # BLACK "(Or we will die.)"
    BLACK "(O moriremos)."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2155
translate es qst_JudgementDay_SiegeOverPrison_71253890:

    # "Sweat dripped from my skin as my body rebelled against me, wracked with an agonizing need that would not subside."
    "Sweat dripped from my skin as my body rebelled against me, wracked with an agonizing need that would not subside."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2157
translate es qst_JudgementDay_SiegeOverPrison_53a8addf:

    # "And then, at last…"
    "Y entonces, por fin…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2158
translate es qst_JudgementDay_SiegeOverPrison_a66ed92c:

    # "Something changed."
    "Algo cambió."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2159
translate es qst_JudgementDay_SiegeOverPrison_58147323:

    # "A distant echo of boots striking stone."
    "Un eco distante de botas golpeando la piedra."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2160
translate es qst_JudgementDay_SiegeOverPrison_6752c6f5:

    # "A key turning in the heavy lock."
    "Una llave girando en la pesada cerradura."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2166
translate es qst_JudgementDay_SiegeOverPrison_7644cf54:

    # "Standing before me, flanked by four guards, was Emperor Alcott himself."
    "De pie ante mí, flanqueado por cuatro guardias, estaba el propio emperador Alcott."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2167
translate es qst_JudgementDay_SiegeOverPrison_088a2959:

    # ALCOTT "...Leave us."
    ALCOTT "...Dejadnos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2170
translate es qst_JudgementDay_SiegeOverPrison_9332edfd:

    # "The guards hesitated for only a moment before silently obeying, stepping out of the cell and sealing the door behind them."
    "Los guardias vacilaron solo un momento antes de obedecer en silencio, saliendo de la celda y cerrando  la puerta tras ellos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2171
translate es qst_JudgementDay_SiegeOverPrison_dbb8e0fc:

    # "And so, to my surreal disbelief, I found myself alone in a cell... with the Emperor himself."
    "AY así, para mi surrealista incredulidad, me encontré a solas en una celda... con el mismísimo emperador."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2172
translate es qst_JudgementDay_SiegeOverPrison_7b1d605a:

    # ALCOTT @ talk "...So, we meet again."
    ALCOTT @ talk "...Así que nos volvemos a encontrar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2167
translate es qst_JudgementDay_SiegeOverPrison_e39eb2b6:

    # ALCOTT @ talk "[player_name!t], isn't it?"
    ALCOTT @ talk "¿[player_name!t], verdad?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2174
translate es qst_JudgementDay_SiegeOverPrison_f8d1acbc:

    # MC "...Yes."
    MC "...Sí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2175
translate es qst_JudgementDay_SiegeOverPrison_5a0b7088:

    # ALCOTT "Ahh... Yes, I've read the reports."
    ALCOTT "Ahh... Sí, he leído los informes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2177
translate es qst_JudgementDay_SiegeOverPrison_f9593db4:

    # ALCOTT @ talk "The reports of your performance during the battle are most impressive."
    ALCOTT @ talk "Los informes sobre tu actuación durante la batalla son muy impresionantes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2178
translate es qst_JudgementDay_SiegeOverPrison_1b7ddb02:

    # ALCOTT @ talk "Not only did you save the princess, but many accounts credit you with actively repelling the enemy inside the walls."
    ALCOTT @ talk "No solo salvaste a la princesa, sino que muchos informes te acreditan haber repelido activamente al enemigo dentro de las murallas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2179
translate es qst_JudgementDay_SiegeOverPrison_b775b62f:

    # ALCOTT @ smile "Even the Silver Knight himself has offered written testimony on your behalf."
    ALCOTT @ smile "Incluso el propio caballero de plata ha ofrecido un testimonio escrito a tu favor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2180
translate es qst_JudgementDay_SiegeOverPrison_4c68ef56:

    # ALCOTT @ talk "Quite the feat... for a monster."
    ALCOTT @ talk "Todo un logro... para un monstruo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2181
translate es qst_JudgementDay_SiegeOverPrison_eb5cb3da:

    # MC @ talk "I am no monster."
    MC @ talk "No soy un monstruo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2182
translate es qst_JudgementDay_SiegeOverPrison_9a24afbf:

    # "There was a breathless exhaustion in my voice."
    "Había un agotamiento sin aliento en mi voz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2183
translate es qst_JudgementDay_SiegeOverPrison_c46207f1:

    # MC @ talk "I was born a man."
    MC @ talk "Nací siendo un hombre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2184
translate es qst_JudgementDay_SiegeOverPrison_b9847f1b:

    # ALCOTT @ talk "What you were is irrelevant to what you {i}are{/i} now."
    ALCOTT @ talk "Lo que eras es irrelevante comparado con lo que {i}eres{/i} ahora."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2187
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_c9a63b4d:

    # ALCOTT @ talk "They have all been detained for the time being."
    ALCOTT @ talk "Todos han sido detenidos por el momento."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2188
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_05ecc8fa:

    # ALCOTT @ talk "But your companions are alive."
    ALCOTT @ talk "Pero tus compañeros están vivos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2192
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_cb82d705:

    # ALCOTT @ talk "The battle raged on, of course. The city suffered heavy losses..."
    ALCOTT @ talk "La batalla continuó, por supuesto. La ciudad sufrió grandes pérdidas..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2193
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_be06700b:

    # ALCOTT @ talk "But with the internal threat dealt with, we were able to refocus on repelling the Demorai."
    ALCOTT @ talk "Pero al haberse eliminado la amenaza interna, pudimos volver a centrarnos en repeler a los demorai."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2194
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_e6e9eae5:

    # ALCOTT @ talk "It seems that without you and your companions... this city would have fallen."
    ALCOTT @ talk "Parece que, sin ti y tus compañeros... esta ciudad habría caído."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2195
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_17cf0b94:

    # MC @ talk "And my thanks is to be bound in chains..."
    MC @ talk "¿Y mi agradecimiento es estar encadenado...?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2196
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_c7418592:

    # ALCOTT @ talk "For now, yes."
    ALCOTT @ talk "Por ahora, sí."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2202
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_bd3be56d:

    # ALCOTT @ talk "I want answers."
    ALCOTT @ talk "Quiero respuestas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2203
translate es qst_JudgementDay_SiegeOverPrison_alcott_menu_185f7f09:

    # ALCOTT @ talk "And if you speak the truth, I {i}might{/i} spare your life."
