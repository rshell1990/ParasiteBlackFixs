

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:4
translate es qst_bloodhound_1_guild_onEnter_315b9c36:

    # MC "(Someone here must know something about the 'Guardians of the realm,' maybe I should ask Thea?)"
    MC "(Alguien de aquí debe saber algo sobre los 'Guardianes del reino', ¿quizá debería preguntarle a Thea?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:10
translate es qst_bloodhound_1_TheaOnGuardians_189d4acd:

    # THEA @ talk "Hm? Well, not too much."
    THEA @ talk "¿Hm? Bueno, no demasiado."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:11
translate es qst_bloodhound_1_TheaOnGuardians_9f40d81a:

    # THEA @ talk "They're newcomers but they seem quite popular."
    THEA @ talk "Son recién llegados, pero parecen bastante populares."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:12
translate es qst_bloodhound_1_TheaOnGuardians_dd63aafe:

    # THEA @ scared "Maybe a little too cocky though."
    THEA @ scared "Aunque quizá demasiado engreídos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:13
translate es qst_bloodhound_1_TheaOnGuardians_b6feebab:

    # MC @ talk "Not a fan?"
    MC @ talk "¿No te gustan?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:14
translate es qst_bloodhound_1_TheaOnGuardians_68490604:

    # THEA @ talk "Mm, every rookie team thinks they're the chosen ones or something."
    THEA @ talk "Mm, todos los equipos novatos se creen los elegidos o algo así."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:15
translate es qst_bloodhound_1_TheaOnGuardians_07b3b10c:

    # THEA @ smile2 "I prefer the ones who actually manage to stick around."
    THEA @ smile2 "Prefiero a los que consiguen quedarse."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:16
translate es qst_bloodhound_1_TheaOnGuardians_7805f446:

    # MC @ talk "Where are they now?"
    MC @ talk "¿Dónde están ahora?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:17
translate es qst_bloodhound_1_TheaOnGuardians_47145c71:

    # THEA @ talk "They took on a quest to take on a giant slimelark."
    THEA @ talk "Emprendieron una misión para enfrentarse a un slimelark gigante."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:18
translate es qst_bloodhound_1_TheaOnGuardians_4e1580f2:

    # MC @ surprised "A what?"
    MC @ surprised "¿Un qué?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:19
translate es qst_bloodhound_1_TheaOnGuardians_f7d02ddf:

    # THEA @ talk "Uhh, think a very angry sentient pool of gunk that will force its way into you and consume you inside out."
    THEA @ talk "Uhh, piensa en un charco de mugre sensible muy enfadado que se abrirá camino hacia ti y te consumirá por dentro y por fuera."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:20
translate es qst_bloodhound_1_TheaOnGuardians_1cdd0735:

    # MC @ talk "Can they handle it?"
    MC @ talk "¿Pueden encargarse de ello?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:21
translate es qst_bloodhound_1_TheaOnGuardians_a2519c48:

    # THEA @ sad "I don't know... A slimelark isn't something to shrug off if you're a rookie."
    THEA @ sad "No sé... Un slimelark no es algo que se deba ignorar si eres un novato."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:22
translate es qst_bloodhound_1_TheaOnGuardians_2455d26f:

    # THEA @ sad "Especially the one that's been causing so much trouble."
    THEA @ sad "Especialmente el que ha estado causando tantos problemas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:23
translate es qst_bloodhound_1_TheaOnGuardians_022994e2:

    # THEA @ sad "I told them not to take it but, when you've got something to prove..."
    THEA @ sad "Les dije que no lo aceptaran pero, cuando tienes algo que probar..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:24
translate es qst_bloodhound_1_TheaOnGuardians_c1b60765:

    # THEA @ talk "Anyway, the thing has been sighted near lake Balun, you know, a short hike to the West?"
    THEA @ talk "De todos modos, la cosa ha sido avistada cerca del lago Balun, ya sabes, ¿una corta caminata hacia el oeste?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:25
translate es qst_bloodhound_1_TheaOnGuardians_261d13c3:

    # THEA @ scared "Apparently its been pulling people in when they get too close to the water."
    THEA @ scared "Al parecer, ha estado arrastrando a la gente cuando se acercan demasiado al agua."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:26
translate es qst_bloodhound_1_TheaOnGuardians_23817d50:

    # MC @ talk "Thanks for the information."
    MC @ talk "Gracias por la información."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:27
translate es qst_bloodhound_1_TheaOnGuardians_d05df937:

    # THEA @ sad "If you're thinking of going after them, I'd suggest being prepared..."
    THEA @ sad "Si estás pensando en ir a por ellos, te sugiero que estés preparado..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:28
translate es qst_bloodhound_1_TheaOnGuardians_8f6a6938:

    # THEA @ talk "Slimelarks are difficult beasts."
    THEA @ talk "Los slimelarks son bestias difíciles."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:29
translate es qst_bloodhound_1_TheaOnGuardians_a9bcd73d:

    # MC @ talk "I'll take your word for it."
    MC @ talk "Me fiaré de tu palabra."
