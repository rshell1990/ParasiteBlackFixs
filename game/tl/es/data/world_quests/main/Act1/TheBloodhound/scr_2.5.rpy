

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:3
translate es qst_bloodhound_2_lake_27c44724:

    # "Stepping closer towards the water bank, I glanced down at my reflection flickering in the water for a moment."
    "Me acerqué a la orilla y por un momento miré mi reflejo moviéndose en el agua."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:4
translate es qst_bloodhound_2_lake_6c633067:

    # "I noticed {i}something red and glimmering{/i} approaching almost hypnotically slow."
    "Noté que {i}algo rojo y brillante{/i} se acercaba con una lentitud casi hipnótica."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:5
translate es qst_bloodhound_2_lake_0b4100ee:

    # "I felt every hair stand on my neck as I felt the sudden urge to leap back."
    "Sentí que se me erizaban todos los pelos de la nuca mientras sentía el repentino impulso de retroceder de un salto."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:6
translate es qst_bloodhound_2_lake_8258d701:

    # "As I did so, the thing emerged violently from the water, it's single red eye glaring towards me."
    "Al hacerlo, la cosa emergió violentamente del agua, con su único ojo rojo mirándome."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:11
translate es qst_bloodhound_2_lake_6ce7cf8c:

    # "Bound inside its horrifying seal, the Guardians were half dissolved, most already dead, lifelessly floating in the acidic mass."
    "Atados dentro de su horrible sello, los Guardianes estaban medio disueltos, la mayoría ya muertos, flotando sin vida en la masa ácida."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:13
translate es qst_bloodhound_2_lake_b34c3a87:

    # "One though, a girl, all bones with her eyes peeled back as she cried did her best to stretch out a dissolved hand to me."
    "Sin embargo, una chica, toda huesos con los ojos pelados mientras lloraba, hizo todo lo posible por tenderme una mano disuelta."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:14
translate es qst_bloodhound_2_lake_2beac591:

    # "Screaming inside her silent prison, the slime forced its way down her throat and she trembled as her eyes rolled white."
    "Gritando dentro de su silenciosa prisión, el slime se abrió paso hasta su garganta y ella tembló mientras sus ojos se ponían blancos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:15
translate es qst_bloodhound_2_lake_a94588ca:

    # "Then, she was as lifeless as all the others."
    "Luego, se quedó sin vida como todos los demás."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:17
translate es qst_bloodhound_2_lake_37f5d75c:

    # "With little time to waste, I tore away at my flesh and stared down the horrific monstrosity before me."
    "Sin tiempo que perder, me arranqué la carne y me quedé mirando la horrenda monstruosidad que tenía ante mí."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:27
translate es qst_bloodhound_2_lake_3a2cf159:

    # "Dissolving into the ground and sizziling, the growling monstrosity's cries began to die down into a distorted murmur till it lay silent."
    "Disolviéndose en el suelo y chisporroteando, los gritos de la monstruosidad gruñona empezaron a apagarse en un murmullo distorsionado hasta quedar en silencio."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:35
translate es qst_bloodhound_2_lake_postbattle_04ed3727:

    # MC @ talk "{i}*Huff... Huff*{/i}"
    MC @ talk "{i}*Uff... Uff*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:37
translate es qst_bloodhound_2_lake_postbattle_e0522a7a:

    # MC "(That was too close.)"
    MC "(Eso estuvo demasiado cerca)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:38
translate es qst_bloodhound_2_lake_postbattle_6e156aba:

    # "From behind, I could hear the sounds of painful grunts and scuffling."
    "Por detrás, oía gruñidos dolorosos y forcejeos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:39
translate es qst_bloodhound_2_lake_postbattle_1a0739a8:

    # "I turned quickly expecting some other horror from the lake ready to strike."
    "Me giré rápidamente esperando algún otro horror del lago listo para atacar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:40
translate es qst_bloodhound_2_lake_postbattle_a1ea6482:

    # "Instead, I saw a young knight clad in armour dragging his way across the grass away from me."
    "En su lugar, vi a un joven caballero vestido con armadura que se arrastraba por la hierba alejándose de mí."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:41
translate es qst_bloodhound_2_lake_postbattle_362573b6:

    # "His left leg missing as he dragged a trail of blood behind him, I approached him cautiously, reaching out towards him with my hand outstretched."
    "Le faltaba la pierna izquierda y arrastraba un reguero de sangre tras de sí. Me acerqué con cautela y le tendí la mano."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:42
translate es qst_bloodhound_2_lake_postbattle_9b24d71e:

    # "The man turned weakly to swing his sword at me, but I managed to pull back in time and dodge it."
    "El hombre se giró débilmente para blandir su espada contra mí, pero conseguí retroceder a tiempo y esquivarla."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:48
translate es qst_bloodhound_2_lake_postbattle_bad462e1:

    # "His face was ghosty white, his eyes wide in fear as he cried at me between his heavy, desperate breaths."
    "Tenía la cara de un blanco fantasmal, los ojos muy abiertos por el miedo mientras me gritaba entre sus respiraciones pesadas y desesperadas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:54
translate es qst_bloodhound_2_lake_postbattle_c147c09c:

    # UNKNOWN "Back! BACK!"
    UNKNOWN "¡Atrás! ¡ATRÁS!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:51
translate es qst_bloodhound_2_lake_postbattle_811721cd:

    # MC "Hold! I am not here to hurt you!"
    MC "¡Espera! ¡No estoy aquí para hacerte daño!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:56
translate es qst_bloodhound_2_lake_postbattle_1d8f5d96:

    # UNKNOWN "You... You speak, {i}beast?{/i}"
    UNKNOWN "Tú... ¿Hablas, {i}bestia?{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:53
translate es qst_bloodhound_2_lake_postbattle_507e8001:

    # MC "I'm here for the guardians."
    MC "Estoy aquí por los guardianes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:54
translate es qst_bloodhound_2_lake_postbattle_b72ffe15:

    # "The man began to laugh, and then cry as tears streamed down his eyes."
    "El hombre empezó a reír, y luego a llorar mientras las lágrimas caían por sus ojos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:59
translate es qst_bloodhound_2_lake_postbattle_538d0203:

    # UNKNOWN "Hahahaha!"
    UNKNOWN "¡Jajajaja!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:60
translate es qst_bloodhound_2_lake_postbattle_c4d9c865:

    # UNKNOWN "You've found them!"
    UNKNOWN "¡Los has encontrado!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:61
translate es qst_bloodhound_2_lake_postbattle_68d2559e:

    # UNKNOWN "At least {i}*cough*{/i} the bits and pieces left of us."
    UNKNOWN "Al menos {i}*toser*{/i} los trozos que quedan de nosotros."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:58
translate es qst_bloodhound_2_lake_postbattle_a54a637c:

    # MC "You're bleeding out, if we don't get the wound treated and sealed soon you'll die."
    MC "Te estás desangrando, si no tratamos y sellamos la herida pronto morirás."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:63
translate es qst_bloodhound_2_lake_postbattle_3e8bf0ee:

    # UNKNOWN "{i}*Cough!*{/i} It's hopeless... I'm finished."
    UNKNOWN "{i}*¡Toser!*{/i} Es inútil... Estoy acabado."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:60
translate es qst_bloodhound_2_lake_postbattle_86322c55:

    # MC "Who are you?"
    MC "¿Quién eres tú?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:65
translate es qst_bloodhound_2_lake_postbattle_0f09202a:

    # UNKNOWN "Dravenham... At your service... What's left of it."
    UNKNOWN "Dravenham... A tu servicio... Lo que queda de él."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:67
translate es qst_bloodhound_2_lake_postbattle_7f2bdaab:

    # DRAVENHAM "They sent {i}you{/i} to rescue us?"
    DRAVENHAM "¿{i}Te{/i} enviaron a rescatarnos?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:68
translate es qst_bloodhound_2_lake_postbattle_bacefd2e:

    # DRAVENHAM "I've never seen a beast like you before."
    DRAVENHAM "Nunca había visto una bestia como tú."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:65
translate es qst_bloodhound_2_lake_postbattle_291e3248:

    # MC "I'm afraid there's no rescue party."
    MC "Me temo que no hay grupo de rescate."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:66
translate es qst_bloodhound_2_lake_postbattle_7c3c7716:

    # MC "I came looking for information on a missing person."
    MC "Vine buscando información sobre una persona desaparecida."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:71
translate es qst_bloodhound_2_lake_postbattle_073fa195:

    # DRAVENHAM "What?! Are you fucki- *cough*"
    DRAVENHAM "¡¿Qué?! ¿Estás jodi- *toser*"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:68
translate es qst_bloodhound_2_lake_postbattle_e8e7195c:

    # MC "No one knows how dire your adventure ended up."
    MC "Nadie sabe lo terrible que acabó siendo vuestra aventura."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:69
translate es qst_bloodhound_2_lake_postbattle_8595b89d:

    # "The man began to sob once again, barely managing to hold himself together."
    "El hombre comenzó a sollozar de nuevo, apenas consiguiendo mantenerse firme."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:74
translate es qst_bloodhound_2_lake_postbattle_15ba15f6:

    # DRAVENHAM "Elsa... Roca... Twhain... I failed them..."
    DRAVENHAM "Elsa... Roca... Twhain... Les he fallado..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:71
translate es qst_bloodhound_2_lake_postbattle_a8eea1de:

    # MC "Dravenham, I know you are in pain but I fear our time together is short, I can hear your heartbeat slow down."
    MC "Dravenham, sé que estás sufriendo pero me temo que nuestro tiempo juntos es corto, puedo oír cómo se ralentizan los latidos de tu corazón."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:76
translate es qst_bloodhound_2_lake_postbattle_c448d59c:

    # DRAVENHAM "Then ask, {i}beast{/i}... Ask whatever it is you have to."
    DRAVENHAM "Entonces pregunta, {i}bestia{/i}... Pregunta lo que tengas que preguntar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:81
translate es qst_bloodhound_2_lake_postbattle_dravenham_5305a2f1:

    # DRAVENHAM "None... The thing only kept me alive to let its young feed on me."
    DRAVENHAM "Ninguno... La cosa solo me mantuvo con vida para que sus crías se alimentaran de mí."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:82
translate es qst_bloodhound_2_lake_postbattle_dravenham_a48cb7f1:

    # DRAVENHAM "{i}*Huff*{/i} It wouldn't let me leave... It wouldn't let me fucking leave!"
    DRAVENHAM "{i}*Uff*{/i} No me dejaba irme... ¡No me dejaba irme, joder!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:79
translate es qst_bloodhound_2_lake_postbattle_dravenham_6fb79e61:

    # MC "Stay with me Dravenham."
    MC "Quédate conmigo Dravenham."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:84
translate es qst_bloodhound_2_lake_postbattle_dravenham_9b9da1a5:

    # DRAVENHAM "Please... Everything is so numb now."
    DRAVENHAM "Por favor... Todo está tan entumecido ahora."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:88
translate es qst_bloodhound_2_lake_postbattle_dravenham_1c097716:

    # DRAVENHAM "We weren't just here for the quest..."
    DRAVENHAM "No estábamos aquí solo por la misión..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:89
translate es qst_bloodhound_2_lake_postbattle_dravenham_1c698585:

    # DRAVENHAM "A servant of some minor nobles offered to pay us triple if we could capture a baby slimelark and bring it back."
    DRAVENHAM "Un sirviente de unos nobles menores nos ofreció pagarnos el triple si podíamos capturar una cría de slimelark y traerla de vuelta."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:86
translate es qst_bloodhound_2_lake_postbattle_dravenham_d69f71d0:

    # MC "But why?"
    MC "Pero, ¿por qué?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:91
translate es qst_bloodhound_2_lake_postbattle_dravenham_ee00bc87:

    # DRAVENHAM "The young... Slimelarks can take many forms, including beautiful women, if trained."
    DRAVENHAM "Los jóvenes... Los slimelarks pueden adoptar muchas formas, incluso mujeres hermosas, si se les entrena."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:92
translate es qst_bloodhound_2_lake_postbattle_dravenham_17540028:

    # DRAVENHAM "The fucking perverts wanted to keep a few as their own private slaves."
    DRAVENHAM "Los malditos pervertidos querían mantener a unos cuantos como sus esclavos privados."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:89
translate es qst_bloodhound_2_lake_postbattle_dravenham_b6fbbabd:

    # MC "Who?"
    MC "¿Quién?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:94
translate es qst_bloodhound_2_lake_postbattle_dravenham_cb60938e:

    # DRAVENHAM "Don't know... The servant only told us he was acting as a intermediary."
    DRAVENHAM "No lo sé... El criado solo nos dijo que actuaba como intermediario."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:95
translate es qst_bloodhound_2_lake_postbattle_dravenham_28c2a94f:

    # DRAVENHAM "None of them care about us, we're all just expendable to them."
    DRAVENHAM "Ninguno de ellos se preocupa por nosotros, todos somos prescindibles para ellos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:96
translate es qst_bloodhound_2_lake_postbattle_dravenham_272db056:

    # DRAVENHAM "Urghh... I feel so dizzy..."
    DRAVENHAM "Urghh... Me siento tan mareado..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:93
translate es qst_bloodhound_2_lake_postbattle_dravenham_e9b9815c:

    # MC "Focus! Just a little more!"
    MC "¡Concéntrate! ¡Solo un poco más!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:103
translate es qst_bloodhound_2_lake_postbattle_dravenham_dbbff41e:

    # DRAVENHAM "Azul? Yes... I know of him."
    DRAVENHAM "¿Azul? Sí... Sé de él."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:104
translate es qst_bloodhound_2_lake_postbattle_dravenham_def48cf3:

    # DRAVENHAM "He would offer us advice on our quests..."
    DRAVENHAM "Nos aconsejaba en nuestras misiones..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:105
translate es qst_bloodhound_2_lake_postbattle_dravenham_046e0255:

    # DRAVENHAM "For coin."
    DRAVENHAM "Por dinero."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:106
translate es qst_bloodhound_2_lake_postbattle_dravenham_eb43210d:

    # DRAVENHAM "Something hap-*cough* happened?"
    DRAVENHAM "¿Ha pas-*toser* pasado algo?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:103
translate es qst_bloodhound_2_lake_postbattle_dravenham_90a466a3:

    # MC "He's gone missing."
    MC "Ha desaparecido."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:104
translate es qst_bloodhound_2_lake_postbattle_dravenham_c1daa0a7:

    # MC "What did he talk to you about the last time you saw him?"
    MC "¿De qué hablasteis la última vez que os visteis?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:109
translate es qst_bloodhound_2_lake_postbattle_dravenham_f051d7a2:

    # DRAVENHAM "Missing? Crap..."
    DRAVENHAM "¿Ha desaparecido? Mierda..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:110
translate es qst_bloodhound_2_lake_postbattle_dravenham_c0de04b1:

    # DRAVENHAM "He was afraid of something."
    DRAVENHAM "Tenía miedo de algo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:111
translate es qst_bloodhound_2_lake_postbattle_dravenham_652cae32:

    # DRAVENHAM "He said he had information that could end up in..."
    DRAVENHAM "Dijo que tenía información que podría acabar en..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:108
translate es qst_bloodhound_2_lake_postbattle_dravenham_85baa545:

    # "Dravenham mustered himself, grasping for life slipping away."
    "Dravenham se armó de valor, aferrándose a la vida que se le escapaba."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:113
translate es qst_bloodhound_2_lake_postbattle_dravenham_0d88fc3a:

    # DRAVENHAM "...In the wrong hands."
    DRAVENHAM "...En las manos equivocadas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:114
translate es qst_bloodhound_2_lake_postbattle_dravenham_91226212:

    # DRAVENHAM "\"Send the whole guild into chaos\" he said..."
    DRAVENHAM "\"Enviar a todo el gremio hacia el caos\" dijo..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:115
translate es qst_bloodhound_2_lake_postbattle_dravenham_10740462:

    # DRAVENHAM "He then asked if he could hire us for protection, but by then, we'd already taken on... this."
    DRAVENHAM "Entonces nos preguntó si podía contratarnos como protección, pero para entonces ya habíamos asumido... esto."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:116
translate es qst_bloodhound_2_lake_postbattle_dravenham_0e6917de:

    # DRAVENHAM "We were going to help him afterwards..."
    DRAVENHAM "Íbamos a ayudarle después..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:117
translate es qst_bloodhound_2_lake_postbattle_dravenham_89117cef:

    # DRAVENHAM "Ha... I guess as you can see, that didn't work out."
    DRAVENHAM "Ja... Supongo que como puedes ver, eso no funcionó."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:114
translate es qst_bloodhound_2_lake_postbattle_dravenham_eb69671d:

    # MC "Where is he now?"
    MC "¿Dónde está ahora?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:119
translate es qst_bloodhound_2_lake_postbattle_dravenham_1d788dbb:

    # DRAVENHAM "He gave... {i}Urghh...{/i} an address to a safehouse of his."
    DRAVENHAM "Nos dio... {i}Urghh...{/i} una dirección a un refugio suyo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:120
translate es qst_bloodhound_2_lake_postbattle_dravenham_a77bf48e:

    # DRAVENHAM "Told us it was too dangerous for him to be out in public anymore."
    DRAVENHAM "Nos dijo que era demasiado peligroso para él salir en público."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:121
translate es qst_bloodhound_2_lake_postbattle_dravenham_9bae290d:

    # DRAVENHAM "That {i}some people were after him{/i}."
    DRAVENHAM "Que {i}algunas personas iban tras él{/i}."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:118
translate es qst_bloodhound_2_lake_postbattle_dravenham_f941d70a:

    # "Hand slid into his breastplate, Dravenham pulled out a bloodied note with something scrawled on it and handed it to me."
    "Metiendo la mano en su pechera, Dravenham sacó una nota ensangrentada con algo garabateado y me la entregó."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:123
translate es qst_bloodhound_2_lake_postbattle_dravenham_1e5ea53c:

    # DRAVENHAM "He... He gave me this..."
    DRAVENHAM "Me... Me dio esto..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:126
translate es qst_bloodhound_2_lake_postbattle_dravenham_148d235b:

