

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:9
translate es qst_bloodhound_2_camp_050d01c5:

    # MC "(Seems like this is the Guardians' camp.)"
    MC "(Parece que este es el campamento de los Guardianes)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:10
translate es qst_bloodhound_2_camp_0495c238:

    # MC "(Let's take a closer look.)"
    MC "(Echemos un vistazo más de cerca)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:13
translate es qst_bloodhound_2_camp_menu_c13e11b1:

    # MC "(A blade covered in blood... But whose?)"
    MC "(Una espada cubierta de sangre... ¿Pero de quién?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:16
translate es qst_bloodhound_2_camp_menu_c66edf03:

    # MC "(Some torn up clothes... Not a good omen.)"
    MC "(Algunas ropas rasgadas... No es un buen augurio)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:19
translate es qst_bloodhound_2_camp_menu_b8f7998f:

    # MC "(It's been snapped right in two.)"
    MC "(Se ha partido en dos)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:22
translate es qst_bloodhound_2_camp_menu_8f187d87:

    # MC "(Hm? Why's this box been chained up?)"
    MC "(¿Hm? ¿Por qué está encadenada esta caja?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:23
translate es qst_bloodhound_2_camp_menu_e0a8dfaa:

    # MC "(I could try tear it open... But I might damage whatever is inside.)"
    MC "(Podría intentar abrirla... Pero podría dañar lo que hay dentro)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:24
translate es qst_bloodhound_2_camp_menu_27834b37:

    # MC "(Maybe I should try and find a key first?)"
    MC "(¿Quizá debería intentar encontrar una llave primero?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:28
translate es qst_bloodhound_2_camp_menu_c356aa46:

    # MC "(Let's try open this...)"
    MC "(Vamos a intentar abrir esto...)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:31
translate es qst_bloodhound_2_camp_menu_5ce602f5:

    # MC "(This looks like a guild party sigil... It must be them!)"
    MC "(Esto parece el emblema de un grupo del gremio... ¡Deben ser ellos!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:32
translate es qst_bloodhound_2_camp_menu_8de7d72a:

    # MC "(But... Where are they? There's nobody in sight.)"
    MC "(Pero... ¿Dónde están? No hay nadie a la vista)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:36
translate es qst_bloodhound_2_camp_menu_cd3844b9:

    # MC "(An extinguished fire pit... Been dead for a while now.)"
    MC "(Una hoguera apagada... Lleva apagada un tiempo)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:37
translate es qst_bloodhound_2_camp_menu_07b572b5:

    # MC "(...Wait, there's something there in the pit!)"
    MC "(...¡Espera, hay algo ahí en la hoguera!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:38
translate es qst_bloodhound_2_camp_menu_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:39
translate es qst_bloodhound_2_camp_menu_43190bbe:

    # MC "(A letter?)"
    MC "(¿Una carta?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:40
translate es qst_bloodhound_2_camp_menu_1031de16:

    # "{i}We've captured a baby slimelark as per the clients request, but the big one is getting more and more agitated.{/i}"
    "{i}Hemos capturado una cría de slimelark a petición del cliente, pero la grande está cada vez más agitada..{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:41
translate es qst_bloodhound_2_camp_menu_4d7ce016:

    # "{i}...Managed to hold it at bay for now, but-{/i}"
    "{i}...conseguimos mantenerla a raya por ahora, pero-{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:42
translate es qst_bloodhound_2_camp_menu_dac4dbf1:

    # MC "(The rest of it is burned beyond readability.)"
    MC "(El resto está quemado más allá de la legibilidad)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:43
translate es qst_bloodhound_2_camp_menu_6bf2865f:

    # MC "(I best stay away from the bank... For now at least.)"
    MC "(Será mejor que me mantenga alejado de a orilla... Al menos por ahora)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:47
translate es qst_bloodhound_2_camp_menu_c9614dee:

    # MC "(Let's move on.)"
    MC "(Sigamos adelante)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:56
translate es qst_bloodhound_2_lake_openbox_9d3fcc85:

    # "As the lock dropped off the from the box, I opened it up to peer inside."
    "Cuando el candado cayó de la caja, la abrí para mirar dentro."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:57
translate es qst_bloodhound_2_lake_openbox_9ff2a2e4:

    # "Inside, a jar with an enchantment on it was filled with the slimelark-like substance."
    "Dentro, un frasco con un encantamiento estaba lleno de una sustancia parecida un slimelark."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:58
translate es qst_bloodhound_2_lake_openbox_2302ca8f:

    # MC "(This is what they came for.)"
    MC "(Esto es lo que vinieron a buscar)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:59
translate es qst_bloodhound_2_lake_openbox_138ba29f:

    # MC "(A baby slimelark.)"
    MC "(Un bebé slimelark)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:60
translate es qst_bloodhound_2_lake_openbox_a497c3f3:

    # MC "(Well, what should I do with it?)"
    MC "(Bueno, ¿qué debo hacer con él?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:63
translate es qst_bloodhound_2_lake_openbox_b4080175:

    # "While what happened here was no doubt horrific, something about punishing the youngling felt wrong."
    "Aunque lo que ocurrió aquí fue sin duda horrible, había algo en castigar al pequeño que no estaba bien."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:64
translate es qst_bloodhound_2_lake_openbox_f3f2fecd:

    # "Even if it {i}was{/i} the offspring of a slimelark."
    "Aunque {i}fuera{/i} la cría de un slimelark."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:65
translate es qst_bloodhound_2_lake_openbox_3fafabb6:

    # "With the jar in hand, I threw it straight into the lake, watching as it plumetted down with a splash."
    "Con el frasco en la mano, lo lancé directamente al lago, observando cómo caía en picado con un chapoteo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:68
translate es qst_bloodhound_2_lake_openbox_407d78e6:

    # "Looking around at the horror inflicted by one of these beasts, I decided it was simply too much risk to keep it alive."
    "Al contemplar el horror infligido por una de estas bestias, decidí que era demasiado riesgo mantenerla con vida."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:69
translate es qst_bloodhound_2_lake_openbox_f8ceeff3:

    # "It was young now... But it would grow up."
    "Ahora era joven... Pero crecería."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:70
translate es qst_bloodhound_2_lake_openbox_7f274017:

    # "Shattering the glass, the slimelark squealed in a death cry as I hacked away at the thing till it dissolved like its parent."
    "Rompiendo el cristal, el slimelark chilló con un grito de agonía mientras yo  le asestaba golpes hasta que se disolvió como su padre."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:74
translate es qst_bloodhound_2_lake_openbox_927f5c91:

    # "For some strange reason, I felt compelled to take the jar with me."
    "Por alguna extraña razón, me sentí obligado a llevarme el frasco."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:75
translate es qst_bloodhound_2_lake_openbox_1a2610a5:

    # "Oddly, as I held up the jar to inspect it more, the colour of the slime briefly turned pink."
    "Curiosamente, cuando levanté el frasco para inspeccionarlo más a fondo, el color del slime se volvió rosa brevemente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:76
translate es qst_bloodhound_2_lake_openbox_94e3d87f:

    # "I thought for a moment I could hear a soft cooing sound from inside the jar, but after a few seconds more of inspection, the thing was silent again."
    "Por un momento pensé que podía oír un suave arrullo proveniente del interior del frasco, pero después de unos segundos más de inspección, la cosa volvió a quedar en silencio."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:78
translate es qst_bloodhound_2_lake_openbox_156904e7:

    # MC "(I hope I don't end up regretting this.)"
    MC "(Espero no terminar arrepintiéndome de esto)."

