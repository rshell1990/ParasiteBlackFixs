    "Tiré con fuerza de la manivela y me tambaleé hacia atrás mientras la escotilla se abría con facilidad."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:81
translate es qst_bloodhound_3_azul_hatch_unlock_702ba8f8:

