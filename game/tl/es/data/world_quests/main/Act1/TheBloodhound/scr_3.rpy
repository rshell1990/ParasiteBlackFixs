    MC "(Guau, vale ahora...)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:89
translate es qst_bloodhound_3_azul_basement_hatch_c3758bc4:

    # MC "(Something is down there... I can feel it.)"
    MC "(Hay algo ahí abajo... Puedo sentirlo)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:90
translate es qst_bloodhound_3_azul_basement_hatch_ceb83781:

    # MC "(I should be prepared before heading down.)"
    MC "(Debería estar preparado antes de bajar)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:100
translate es qst_bloodhound_3_toBasement_eaa30016:

    # "Heading down into the darkness with a lit torch, each step echoing as I descended down."
    "Me adentré en la oscuridad con una antorcha encendida, cada paso resonaba mientras descendía."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:103
translate es qst_bloodhound_3_toBasement_510bae7c:

    # "Down the stairs, I could hear the sound of dripping grow louder."
    "Bajando las escaleras, oía cada vez más fuerte el sonido del goteo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:104
translate es qst_bloodhound_3_toBasement_04b96fb8:

    # "Through a small underground passage, I could see a light at the end of the tunnel."
    "A través de un pequeño pasadizo subterráneo, pude ver una luz al final del túnel."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:105
translate es qst_bloodhound_3_toBasement_c439e1b9:

    # "Moving towards and peering around the corner..."
    "Avanzando y asomándose por la esquina..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:106
translate es qst_bloodhound_3_toBasement_69649a42:

    # "A nightmare awaited me."
    "Me esperaba una pesadilla."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:113
translate es qst_bloodhound_3_toBasement_6706efee:

    # "The man I presumed to be Azul hung upside down, his lower jaw broken and hang by the thinnest thread of flesh."
    "El hombre que supuse que era Azul colgaba boca abajo, con la mandíbula inferior rota y colgando del más delgado hilo de carne."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:114
translate es qst_bloodhound_3_toBasement_8f6c41e0:

    # "His eyes were torn out leaving red trails of blood decorating his horrified, pale face."
    "Le arrancaron los ojos dejando regueros rojos de sangre que decoraban su rostro horrorizado y pálido."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:115
translate es qst_bloodhound_3_toBasement_0d45b3d7:

    # "His body desecrated, long hooks dug into the flesh pulling back sheets of flesh as a pool of blood circled his body beneath."
    "Su cuerpo profanado, largos garfios clavados en la carne arrancando láminas de carne mientras un charco de sangre rodeaba su cuerpo por debajo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:116
translate es qst_bloodhound_3_toBasement_661276f1:

    # "In his exposed ribcage, a crude cage was formed with sharp metal shards, inside a black crow cried as it pecked at his insides angrily."
    "En su caja torácica expuesta se formó una tosca jaula con afilados fragmentos de metal, en cuyo interior un cuervo negro gritaba mientras picoteaba sus entrañas con rabia."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:117
translate es qst_bloodhound_3_toBasement_810f6de6:

    # MC @ talk "{i}...Gods.{/i}"
    MC @ talk "{i}...Dioses.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:118
translate es qst_bloodhound_3_toBasement_3f254257:

    # "The repugnant smell of rotting flesh began to make me nearly hurl as a dozen flies circled around the pale flesh."
    "El repugnante olor a carne podrida empezó a hacerme casi vomitar mientras una docena de moscas daban vueltas alrededor de la pálida carne."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:119
translate es qst_bloodhound_3_toBasement_c3c642d0:

    # "Behind me, I heard the sounds of some mechanism ticking..."
    "Detrás de mí, oí el sonido de algún mecanismo..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:122
translate es qst_bloodhound_3_toBasement_19ed433f:

    # "Sensing danger, I turned."
    "Presintiendo el peligro, me giré."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:126
translate es qst_bloodhound_3_toBasement_c0466f52:

    # "A man in black stood before me, his face not visible behind the mask and strange goggles, unnerving ticking sound coming from inside his chest."
    "Un hombre de negro estaba ante mí, su rostro no era visible tras la máscara y las extrañas gafas, un enervante tic tac provenía del interior de su pecho."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:127
translate es qst_bloodhound_3_toBasement_988c5159:

    # "The thing moved jankily, making strange sounds as it curiously turned its head to look at me before drawing out the long blades from its arms."
    "La cosa se movía jadeante, emitiendo extraños sonidos mientras giraba curiosamente la cabeza para mirarme antes de sacar las largas cuchillas de sus brazos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:128
translate es qst_bloodhound_3_toBasement_4277bc35:

    # MC @ angry "I take it talking is out of the question?"
    MC @ angry "¿Supongo que hablar está descartado?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:129
translate es qst_bloodhound_3_toBasement_c8cb10b4:

    # "The thing stepped forward, its hand shaking slightly."
    "La cosa dio un paso adelante, con la mano ligeramente temblorosa."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:134
translate es qst_bloodhound_3_toBasement_9a8e3593:

    # MC @ angry "Fuck!"
    MC @ angry "¡Joder!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:143
translate es qst_bloodhound_3_toBasement_3ff24643:

    # "Once again, I quickly tore from my flesh just as the thing was about to strike, barely blocking it in time with my own claws and managing to push it back."
    "Una vez más, me desgarré rápidamente de mi carne justo cuando la cosa estaba a punto de golpear, apenas bloqueándolo a tiempo con mis propias garras y logrando empujarlo hacia atrás."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:145
translate es qst_bloodhound_3_toBasement_ee112fff:

    # MC "No choice now!"
    MC "¡Ya no me queda más remedio!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:160
translate es qst_bloodhound_3_toBasement_c0b25ad9:

    # "Dodging left and right, the man in black moved quicker than I anticipated, dodging most of my strikes and managing to land hit after hit against me."
    "Esquivando a diestro y siniestro, el hombre de negro se movió más rápido de lo que esperaba, esquivando la mayoría de mis golpes y consiguiendo asestarme un golpe tras otro."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:161
translate es qst_bloodhound_3_toBasement_ec059881:

    # "Its blades were unlike any other blade I'd seen before."
    "Sus hojas no se parecían a ninguna otra hoja que hubiera visto antes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:162
translate es qst_bloodhound_3_toBasement_4532cba5:

    # "Perhaps they were enchanted, but they seemed sharper and able to cut at my flesh unlike any other."
    "Tal vez estuvieran encantadas, pero parecían más afiladas y capaces de cortar mi carne como ninguna otra."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:163
translate es qst_bloodhound_3_toBasement_b7befe8a:

    # "I managed to strike it with my tail, piercing a gaping hole through its chest."
    "Conseguí golpearlo con mi cola, abriéndole un enorme agujero en el pecho."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:164
translate es qst_bloodhound_3_toBasement_1c0b9dcc:

    # "But instead of turning limp, it slashed down, causing a painful wound in my tail as it continued on despite its horrific injury."
    "Pero, en lugar de volverse inerte, me lanzó un tajo, causándome una dolorosa herida en la cola, mientras seguía adelante a pesar de su horrible herida."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:165
translate es qst_bloodhound_3_toBasement_40f4935f:

    # MC "(What the fuck is this thing?!)"
    MC "(¡¿Qué coño es esta cosa?!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:166
translate es qst_bloodhound_3_toBasement_b29379dc:

    # MC "(Is it even killable?)"
    MC "(¿Se puede matar?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:167
translate es qst_bloodhound_3_toBasement_323868cf:

    # "Once again, the thing leapt forward, and after a few clashes of our blades, it suddenly pierced through me with one of it's claw hands."
    "Una vez más, la cosa saltó hacia delante y, tras unos cuantos choques de nuestras espadas, me atravesó de repente con una de sus garras."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:168
translate es qst_bloodhound_3_toBasement_d327c627:

    # "Screaming in pain, I charged forward, managing to knock the man in black against the opposing wall but it dodged my subsequent lethal swipe to take its head off."
    "Gritando de dolor, cargué hacia delante, consiguiendo derribar al hombre de negro contra la pared contraria, pero éste esquivó mi posterior zarpazo letal para arrancarle la cabeza."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:169
translate es qst_bloodhound_3_toBasement_39009672:

    # "It felt like a horrific dance as the thing moved around me, taking piece after piece."
    "Parecía una danza espantosa mientras la cosa se movía a mi alrededor, llevándose un trozo tras otro."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:170
translate es qst_bloodhound_3_toBasement_b5c60d7e:

    # "I began to feel dizzy and increasingly weak..."
    "Empecé a sentirme mareado y cada vez más débil..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:171
translate es qst_bloodhound_3_toBasement_3f7ba3ac:

    # "Just how much longer could I keep this up?"
    "¿Cuánto tiempo más podría seguir así?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:172
translate es qst_bloodhound_3_toBasement_733ec587:

    # MC "(F-Fuck! Can you help me out here?)"
    MC "(¡J-joder! ¿Puedes ayudarme?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:173
translate es qst_bloodhound_3_toBasement_d0ca6432:

    # BLACK "Flee."
    BLACK "Huye."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:174
translate es qst_bloodhound_3_toBasement_e28f5ee5:

    # MC "(Flee?! You can't be serious!)"
    MC "(¡¿Huir?! ¡No puedes hablar en serio!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:175
translate es qst_bloodhound_3_toBasement_6e2d0cec:

    # BLACK "Cannot stabilize damage much longer."
    BLACK "No puedo estabilizar el daño mucho más tiempo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:176
translate es qst_bloodhound_3_toBasement_60f0bc89:

    # BLACK "His blades are coated with something slowing the rapid healing response."
    BLACK "Sus cuchillas están recubiertas con algo que ralentiza la rápida respuesta curativa."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:177
translate es qst_bloodhound_3_toBasement_872010a3:

    # MC "(Fuck! FUCK!)"
    MC "(¡Joder! ¡JODER!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:178
translate es qst_bloodhound_3_toBasement_35522119:

    # "I looked towards the stairs once again."
    "Volví a mirar hacia las escaleras."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:179
translate es qst_bloodhound_3_toBasement_2dbdb956:

    # "The man in black blocked my path, blades ready."
    "El hombre de negro bloqueó mi camino, con las espadas preparadas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:180
translate es qst_bloodhound_3_toBasement_92f5db33:

    # MC "(I have to try, I just need to get past!)"
    MC "(Tengo que intentarlo, ¡solo necesito pasar!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:181
translate es qst_bloodhound_3_toBasement_05ee5938:

    # "I darted onto the side wall, springing off from my foot to bounce off as I twisted my whole body and swung my tail to try and knock the man back."
    "Me abalancé sobre la pared lateral, saltando del pie para rebotar mientras torcía todo el cuerpo y balanceaba la cola para intentar derribar al hombre."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:182
translate es qst_bloodhound_3_toBasement_6a1754bb:

    # "It grabbed onto my tail as I slammed it against the wall, sending shards of stone flying."
    "Se aferró a mi cola mientras lo golpeaba contra la pared, haciendo volar fragmentos de piedra."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:183
translate es qst_bloodhound_3_toBasement_d7df702e:

    # "The man in black refused to give up, forcing blades through my tail."
    "El hombre de negro se negó a rendirse, forzando cuchillas a través de mi cola."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:184
translate es qst_bloodhound_3_toBasement_20d8f036:

    # "I screeched out in pain but the man in black kept coming no matter what I did."
    "Grité de dolor, pero el hombre de negro seguía acercándose hiciera lo que hiciera."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:185
translate es qst_bloodhound_3_toBasement_cb953dbd:

    # "Only now did I realize how close death was..."
    "Solo ahora me di cuenta de lo cerca que estaba la muerte..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:186
translate es qst_bloodhound_3_toBasement_0e939507:

    # UNKNOWN "{i}*Whistles*{/i}"
    UNKNOWN "{i}*Silbidos*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:189
translate es qst_bloodhound_3_toBasement_9afc807c:

    # "As the man in black turned sharply towards the sound, he was suddenly blasted back by a bolt of lightning."
    "Cuando el hombre de negro se giró bruscamente hacia el sonido, un rayo le hizo retroceder."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:190
translate es qst_bloodhound_3_toBasement_13c9ce29:

    # "Beside Captain Nyx, four mages stood at the ready, their staffs pointed towards the convulsing automaton."
    "Junto a la capitana Nyx, cuatro magas estaban preparadas, con sus bastones apuntando hacia el autómata que convulsionaba."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:219
translate es qst_bloodhound_3_toBasement_98ef091a:

    # "It struggled and rose to its feet again, charging towards the Captain and the mages."
    "Forcejeó y se puso en pie de nuevo, cargando hacia la capitana y las magas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:226
translate es qst_bloodhound_3_toBasement_9304bfda:

    # "...But another blast sent him wheeling backwards."
    "...Pero otra explosión le hizo retroceder."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:228
translate es qst_bloodhound_3_toBasement_18e5bb6b:

    # "Clambering back to its feet before they could finish it off, the man in black charged forward, dodging the third blast right through the Captain and her mages, scurrying its way up the stairs."
    "El hombre de negro se puso en pie antes de que pudieran acabar con él y se lanzó al ataque, esquivando la tercera ráfaga y atravesando a la capitana y a sus magas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:229
translate es qst_bloodhound_3_toBasement_53131c31:

    # NYX @ angry "AFTER HIM!"
    NYX @ angry "¡TRAS ÉL!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:229
translate es qst_bloodhound_3_toBasement_03084257:

    # MAGE "But... What about the other one?"
    MAGE "Pero... ¿Qué pasa con el otro?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:232
translate es qst_bloodhound_3_toBasement_f1f00a2f:

    # NYX @ angry "Leave him!"
    NYX @ angry "¡Dejadlo!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:233
translate es qst_bloodhound_3_toBasement_235c9198:

    # NYX @ angry "{i}He's with us.{/i}"
    NYX @ angry "{i}Está con nosotros.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:242
translate es qst_bloodhound_3_toBasement_26742987:

    # "The mages followed after him as I weakly stumbled behind them deliriously, blood pouring out of me."
    "Las magas le siguieron mientras yo tropezaba débilmente detrás de ellos delirando, con la sangre brotando de mí."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:244
translate es qst_bloodhound_3_toBasement_e2baa4ae:

    # "Dizzy, I saw mages and Nyx fight the thing relentlessly."
    "Mareado, vi a las magas y a Nyx luchar sin tregua contra esa cosa."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:245
translate es qst_bloodhound_3_toBasement_45fc3d08:

    # "After a few blows, the Man in black knocked back Captain Nyx before leaping through one of the glass windows, shattering it."
    "Tras unos cuantos golpes, el hombre de negro hizo retroceder a lla capitana Nyx antes de saltar a través de una de las ventanas de cristal, haciéndola añicos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:251
translate es qst_bloodhound_3_toBasement_b7f2c043:

    # "From outside, we watched as he contorted his body with unnatural speed, dragging himself up unto a building and moving away too fast for us to even see."
    "Desde fuera, vimos cómo contorsionaba su cuerpo con una velocidad antinatural, se arrastraba hasta un edificio y se alejaba demasiado rápido para que pudiéramos verlo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:250
translate es qst_bloodhound_3_toBasement_58688400:

    # MAGE "Captain! Do we pursue?"
    MAGE "¡Capitana! ¿Perseguimos?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:251
translate es qst_bloodhound_3_toBasement_b9c6a5a9:

    # SECOND_MAGE "We need more time to prepare another charge!"
    SECOND_MAGE "¡Necesitamos más tiempo para preparar otra carga!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:269
translate es qst_bloodhound_3_toBasement_fdeb4bdc:

    # NYX @ angry "No... Whatever that thing is, its gone."
    NYX @ angry "No... Sea lo que sea esa cosa, se ha ido."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:270
translate es qst_bloodhound_3_toBasement_d1beeab3:

    # "Unable to handle a single step more my buckling legs gave and I dropped to my knees."
    "Incapaz de dar un solo paso más, mis piernas cedieron y caí de rodillas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:272
translate es qst_bloodhound_3_toBasement_2fb16082:

    # "Blood poured from all over my mangled body as I crashed forward with a thud."
    "La sangre manaba de todo mi cuerpo destrozado mientras caía hacia delante con un ruido sordo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:275
translate es qst_bloodhound_3_toBasement_6859ac9e:

    # NYX "SHIT!"
    NYX "¡MIERDA!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:276
translate es qst_bloodhound_3_toBasement_c58b41a1:

    # "Darkness."
    "Oscuridad."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:292
translate es qst_bloodhound_3_toBasement_3e507460:

    # NYX @ shock "...Hey, HEY! He's opening his eyes!"
    NYX @ shock "...¡Ey, EY! ¡Está abriendo los ojos!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:293
translate es qst_bloodhound_3_toBasement_96bf910a:

    # MC "Urghh..."
    MC "Urghh..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:291
translate es qst_bloodhound_3_toBasement_ad80ee54:

    # MAGE_TALL "We did our best to heal the creatures wounds but-"
    MAGE_TALL "Hicimos lo que pudimos para curar las heridas de las criatura pero-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:292
translate es qst_bloodhound_3_toBasement_1d30ae43:

    # MAGE_TALL "Captain... What is this thing?"
    MAGE_TALL "Capitana... ¿Qué es esta cosa?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:293
translate es qst_bloodhound_3_toBasement_113a6d97:

    # MAGE_SLIM "It... It looks like a man, but earlier-"
    MAGE_SLIM "Parece... Parece un hombre, pero antes-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:299
translate es qst_bloodhound_3_toBasement_52521e89:

    # NYX @ angry "Never you mind."
    NYX @ angry "No te preocupes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:300
translate es qst_bloodhound_3_toBasement_a42b3df1:

    # NYX @ talk "Now help him back to his feet!"
    NYX @ talk "¡Ahora ayúdenlo a ponerse de pie!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:303
translate es qst_bloodhound_3_toBasement_c6e0476f:

    # "The mages weakly helped me back to my feet which trembled and shook, barely able to hold me upright."
    "Las magas me ayudaron débilmente a volver a ponerme en pie, que temblaba y agitaba, apenas capaz de sostenerme en pie."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:320
translate es qst_bloodhound_3_toBasement_07dd01bf:

    # MC @ talk "{i}*Cough*{/i} How did you-"
    MC @ talk "{i}*Toser*{/i} ¿Cómo-?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:321
translate es qst_bloodhound_3_toBasement_06fdd052:

    # NYX @ talk "We will talk later, I will explain everything soon."
    NYX @ talk "Hablaremos más tarde, te lo explicaré todo pronto."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:322
translate es qst_bloodhound_3_toBasement_9ae00cf0:

    # "Captain Nyx turned towards the other mages."
    "La capitana Nyx se giró hacia las otras magas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:326
translate es qst_bloodhound_3_toBasement_33bce3a6:

    # NYX @ angry "None of you will speak of what you have seen today, understand?"
    NYX @ angry "Ninguna de vosotras hablará de lo que habéis visto hoy, ¿entendido?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:327
translate es qst_bloodhound_3_toBasement_f9a9e350:

    # "The mages look at each other sheepishly."
    "Las magas se miran tímidamente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:328
translate es qst_bloodhound_3_toBasement_675dbf11:

    # NYX @ angry "I assure you, {i}the fates will not favor you for a lack of discretion, ladies.{/i}"
    NYX @ angry "Les aseguro, {i}que el destino no las favorecerá por falta de discreción, señoritas.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:329
translate es qst_bloodhound_3_toBasement_4abde0dd:

    # "The mages all nervously nodded."
    "Todas las magas asintieron nerviosas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:339
translate es qst_bloodhound_3_toBasement_d626dae3:

    # NYX @ talk "Now help me dress him."
    NYX @ talk "Ahora ayudadme a vestirlo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:343
translate es qst_bloodhound_3_toBasement_4896de1a:

    # "The Mages eyes looked downwards as their cheeks flushed red."
    "Los ojos de las magas miraron hacia abajo mientras sus mejillas enrojecían."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:344
translate es qst_bloodhound_3_toBasement_7a8a690f:

    # NYX @ angry "...Oh for the love of-"
    NYX @ angry "...Oh por el amor de-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:345
translate es qst_bloodhound_3_toBasement_28ca6b76:

    # NYX @ blush "Sisters... {i}Eyes up{/i} and focus."
    NYX @ blush "Hermanas... {i}Ojos arriba{/i} y concentraros."

translate es strings:

    # game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:30
    old "Pull the rug to the side"
    new "Tira de la alfombra hacia un lado"

    # game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:91
    old "Go"
    new "Ir"

    # game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:91
    old "Not yet"
    new "Aún no"
