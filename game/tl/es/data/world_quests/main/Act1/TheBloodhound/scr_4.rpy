

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:2
translate es qst_bloodhound_4_atFort_aed6965c:

    # "The next hour was a kind of blur as the mages dressed me and helped me stumble by way back towards Fort Sebastian."
    "La hora siguiente fue una especie de mancha borrosa mientras las magas me vestían y me ayudaban a volver dando tumbos hacia el fuerte Sebastian."
# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:6
translate es qst_bloodhound_4_atFort_dbd56900:

    # "Brought into the Medical Ward, the nuns hurried over to treat me alongside the influx of other poor bastards."
    "Me llevaron al pabellón médico y las monjas se apresuraron a tratarme junto a otros pobres desgraciados."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:8
translate es qst_bloodhound_4_atFort_6af63c0b:

    # "Here and there I noticed were a few Scouts."
    "Aquí y allá me di cuenta de que había algunos exploradores."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:9
translate es qst_bloodhound_4_atFort_5d3a3559:

    # "Battered, broken, some had limbs missing."
    "Maltrechos, rotos, a algunos les faltaban miembros."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:10
translate es qst_bloodhound_4_atFort_7327635b:

    # "Laying beside them, I remembered how I hoped never to end up here again."
    "Tumbado junto a ellos, recordé cómo esperaba no volver a acabar aquí."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:11
translate es qst_bloodhound_4_atFort_b0c99eb3:

    # "Yet, here I was."
    "Y sin embargo, aquí estaba."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:15
translate es qst_bloodhound_4_atFort_08507bf0:

    # "Captain Nyx spoke to some of the Nuns."
    "La capitana Nyx habló con algunas de las monjas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:19
translate es qst_bloodhound_4_atFort_3357746f:

    # "As I struggled to stay awake, I couldn't focus on what was being said..."
    "Mientras luchaba por mantenerme despierto, no podía concentrarme en lo que se decía..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:23
translate es qst_bloodhound_4_atFort_1c58eea8:

    # "At some point, one of the nuns came to see me and fed me some holly sap for the pain."
    "En algún momento, una de las monjas vino a verme y me dio un poco de savia de acebo para el dolor."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:27
translate es qst_bloodhound_4_atFort_217b2342:

    # "Since my {i}change{/i}, I hadn't experienced pain like this."
    "Desde mi {i}cambio{/i}, no había experimentado un dolor como este."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:31
translate es qst_bloodhound_4_atFort_32efdd9d:

    # "Every muscle ached as I felt numerous broken bones inside me struggling to mend."
    "Me dolían todos los músculos y sentía cómo numerosos huesos rotos luchaban por repararse."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:35
translate es qst_bloodhound_4_atFort_fc7016e4:

    # MC "(What happened back there?)"
    MC "(¿Qué pasó antes?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:36
translate es qst_bloodhound_4_atFort_e7f55388:

    # MC "(Shit shit! How in all the damn hells did she know about me?)"
    MC "(¡Mierda, mierda! ¿Cómo demonios sabía ella de mí?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:37
translate es qst_bloodhound_4_atFort_0422337d:

    # MC "(Urghh... Why is the healing taking so long?)"
    MC "(Urghh... ¿Por qué tarda tanto en curarse?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:38
translate es qst_bloodhound_4_atFort_78cfcf79:

    # BLACK "The effects of the poison are still active within our bloodstream."
    BLACK "Los efectos del veneno siguen activos en nuestro torrente sanguíneo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:39
translate es qst_bloodhound_4_atFort_6f610828:

    # MC "(That thing it... {i}It nearly killed us{/i}.)"
    MC "(Esa cosa... {i}Casi nos mata{/i})."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:40
translate es qst_bloodhound_4_atFort_4ba8b71c:

    # BLACK "Yes."
    BLACK "Sí."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:41
translate es qst_bloodhound_4_atFort_10d9725d:

    # MC "(But how? I thought we were like, nearly impossible to kill or something!)"
    MC "(¿Pero cómo? Creía que éramos casi imposibles de matar o algo así)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:42
translate es qst_bloodhound_4_atFort_0be017dd:

    # BLACK "This assessment is incorrect."
    BLACK "Esta valoración es incorrecta."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:43
translate es qst_bloodhound_4_atFort_14f01e94:

    # MC "(What? Well... We've handled everything until now!)"
    MC "(¿Qué? Bueno... ¡Nos hemos encargado de todo hasta ahora!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:44
translate es qst_bloodhound_4_atFort_f1fae085:

    # BLACK "Our battle form is durable but {i}not invincible{/i}, there are no doubt plenty of beings capable of killing us."
    BLACK "Nuestra forma de batalla es duradera pero {i}no invencible{/i}, sin duda hay muchos seres capaces de matarnos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:45
translate es qst_bloodhound_4_atFort_cc99b660:

    # MC "(Well, there goes my power fantasy I guess.)"
    MC "(Bueno, ahí va mi fantasía de poder, supongo)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:46
translate es qst_bloodhound_4_atFort_5e79a34e:

    # BLACK "The battle form, like all abilities, must be nurtured to develop."
    BLACK "La forma de batalla, como todas las habilidades, debe cultivarse para desarrollarse."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:47
translate es qst_bloodhound_4_atFort_c7d003c0:

    # MC "(You mean like, I have to train more?)"
    MC "(¿Quieres decir que tengo que entrenar más?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:48
translate es qst_bloodhound_4_atFort_e6b63194:

    # BLACK "Yes, your body will adapt and evolve to handle greater threats."
    BLACK "Sí, tu cuerpo se adaptará y evolucionará para hacer frente a amenazas mayores."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:49
translate es qst_bloodhound_4_atFort_f7a97492:

    # MC "(Great... That's something at least.)"
    MC "(Genial... Eso es algo al menos)."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:51
translate es qst_bloodhound_4_atFort_17a87d51:

    # "The thought of facing that {i}thing{/i} again filled me with dread."
    "La idea de volver a enfrentarme a esa {i}cosa{/i} me llenaba de pavor."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:52
translate es qst_bloodhound_4_atFort_339483ae:

    # "As the holly sap took effect, I drifted off to sleep, haunted by the images of it's horrible face charging towards me."
    "Cuando la savia de acebo hizo efecto, me dormí, atormentado por las imágenes de su horrible rostro atacándome."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:59
translate es qst_bloodhound_4_atFort_b88fb49b:

    # "Towards {i}us{/i}."
    "Hacia {i}nosotros{/i}."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:64
translate es qst_bloodhound_4_atFort_0cf7c79e:

    # "A few hours later..."
    "Unas horas después..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:76
translate es qst_bloodhound_4_atFort_9efa6cee:

    # NYX @ shock "Feeing alright?"
    NYX @ shock "¿Te encuentras bien?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:78
translate es qst_bloodhound_4_atFort_b8905269:

    # MC @ talk "Yeah... Never better."
    MC @ talk "Sí... Mejor que nunca."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:79
translate es qst_bloodhound_4_atFort_359034a0:

    # NYX @ talk "You look like shit."
    NYX @ talk "Estás hecho una mierda."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:80
translate es qst_bloodhound_4_atFort_dfbe28ad:

    # MC @ talk "Well, I feel like shit so..."
    MC @ talk "Bueno, me siento como una mierda así que..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:82
translate es qst_bloodhound_4_atFort_b9fc5142:

    # "Captain Nyx forced a faint smile before nodding softly."
    "La capitana Nyx forzó una leve sonrisa antes de asentir suavemente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:83
translate es qst_bloodhound_4_atFort_b01b2cf5:

    # NYX @ talk "I suppose you've got questions."
    NYX @ talk "Supongo que tendrás preguntas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:84
translate es qst_bloodhound_4_atFort_291c5b81:

    # MC @ talk "Damn right."
    MC @ talk "Ya lo creo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:89
translate es qst_bloodhound_4_hospital_nyxChoices_e4ee6136:

    # NYX @ talk "I've had you both followed since your return."
    NYX @ talk "He hecho que os sigan desde vuestro regreso."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:90
translate es qst_bloodhound_4_hospital_nyxChoices_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "¿Qué?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:91
translate es qst_bloodhound_4_hospital_nyxChoices_27426e03:

    # NYX @ angry "When you and your friend returned, under the circumstances you did, I didn't buy that you just strolled your way back to Novaras in record time."
    NYX @ angry "Cuando tú y tu amigo volvisteis, en las circunstancias en que lo hicisteis, no me tragué que simplemente hubierais vuelto a Novaras en un tiempo récord."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:92
translate es qst_bloodhound_4_hospital_nyxChoices_b21889a2:

    # NYX @ angry "At first, I considered you being Demorai spies."
    NYX @ angry "Al principio, consideré que erais espías de los demorai."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:93
translate es qst_bloodhound_4_hospital_nyxChoices_6004d9d1:

    # NYX @ talk "So, I called in some favors and had you followed."
    NYX @ talk "Así que pedí algunos favores e hice que te siguieran."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:94
translate es qst_bloodhound_4_hospital_nyxChoices_9e1a4c12:

    # MC @ angry "Why not just tell me!"
    MC @ angry "¡¿Por qué no me lo dijiste?!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:95
translate es qst_bloodhound_4_hospital_nyxChoices_b1ccbf77:

    # NYX @ talk "I needed to test where your loyalties laid."
    NYX @ talk "Necesitaba probar dónde estaban tus lealtades."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:96
translate es qst_bloodhound_4_hospital_nyxChoices_c5e54f3e:

    # NYX @ laugh "Oh, and the whole strolling into the desert to change thing? Not very smart."
    NYX @ laugh "Ah, ¿y lo de pasear por el desierto para transformarse? No fue muy inteligente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:97
translate es qst_bloodhound_4_hospital_nyxChoices_bae1966c:

    # NYX @ angry "Did you really think heading out there wasn't going to draw some attention?"
    NYX @ angry "¿De verdad creías que salir ahí fuera no iba a llamar la atención?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:98
translate es qst_bloodhound_4_hospital_nyxChoices_2221d04f:

    # NYX @ talk "You're going to need to learn to be smarter than that."
    NYX @ talk "Vas a tener que aprender a ser más inteligente que eso."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:99
translate es qst_bloodhound_4_hospital_nyxChoices_98840fbf:

    # MC @ angry "You used me."
    MC @ angry "Me usaste."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:100
translate es qst_bloodhound_4_hospital_nyxChoices_c9fb01dc:

    # NYX @ angry "This is war, you'll get used to being used."
    NYX @ angry "Esto es la guerra, te acostumbrarás a que te usen."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:104
translate es qst_bloodhound_4_hospital_nyxChoices_9310a365:

    # NYX @ talk "I have no idea."
    NYX @ talk "No tengo ni idea."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:105
translate es qst_bloodhound_4_hospital_nyxChoices_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "¿Qué?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:106
translate es qst_bloodhound_4_hospital_nyxChoices_1b3b6fcb:

    # NYX @ shock "I knew Azul was onto something big but... I didn't anticipate that."
    NYX @ shock "Sabía que Azul estaba en algo grande, pero... No me lo esperaba."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:107
translate es qst_bloodhound_4_hospital_nyxChoices_d155dda6:

    # NYX @ angry "All of Azul's private documents and scrolls have been taken, no doubt destroyed."
    NYX @ angry "Se han llevado todos los documentos y pergaminos privados de Azul, sin duda destruidos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:111
translate es qst_bloodhound_4_hospital_nyxChoices_564cd451:

    # NYX @ shock "...I'm sorry, I predicted there might be a trap waiting for whoever I sent."
    NYX @ shock "...Lo siento, predije que podría haber una trampa esperando a quien enviara."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:112
translate es qst_bloodhound_4_hospital_nyxChoices_1a9930c7:

    # NYX @ talk "I knew that, with your abilities, you had a better chance handling whatever was thrown at you."
    NYX @ talk "Sabía que, con tus habilidades, tenías más posibilidades de enfrentarte a lo que te echaran."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:113
translate es qst_bloodhound_4_hospital_nyxChoices_c34a59ad:

    # NYX @ talk "But I still made sure to tail you, I couldn't be sure for whatever was waiting and expected the worst."
    NYX @ talk "Pero aún así me aseguré de seguirte, no podía estar segura de lo que me esperaba y esperaba lo peor."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:114
translate es qst_bloodhound_4_hospital_nyxChoices_1efaa6b8:

    # MC @ talk "Could have done better with you about five minutes earlier into the fight."
    MC @ talk "Podría haberlo hecho mejor contigo unos cinco minutos antes en la pelea."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:115
translate es qst_bloodhound_4_hospital_nyxChoices_6442fbae:

    # NYX @ angry "We moved as quickly as we could without drawing attention."
    NYX @ angry "Nos movimos tan rápido como pudimos sin llamar la atención."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:119
translate es qst_bloodhound_4_hospital_nyxChoices_230bd269:

    # NYX @ talk "No."
    NYX @ talk "No."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:120
translate es qst_bloodhound_4_hospital_nyxChoices_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:121
translate es qst_bloodhound_4_hospital_nyxChoices_69710195:

    # NYX @ talk "You're a valuable asset, and I'm fairly confident now whose side you're on."
    NYX @ talk "Eres un activo valioso, y ahora estoy bastante segura de qué lado estás."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:122
translate es qst_bloodhound_4_hospital_nyxChoices_e9e95609:

    # NYX @ angry "That said, others may not feel the same."
    NYX @ angry "Dicho esto, puede que otros no piensen lo mismo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:123
translate es qst_bloodhound_4_hospital_nyxChoices_bb396a64:

    # MC @ talk "So... No one else knows?"
    MC @ talk "Entonces... ¿Nadie más lo sabe?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:124
translate es qst_bloodhound_4_hospital_nyxChoices_8e345629:

    # NYX @ talk "Your secret is still safe."
    NYX @ talk "Tu secreto sigue a salvo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:125
translate es qst_bloodhound_4_hospital_nyxChoices_27b1a111:

    # MC @ talk "But, the inquisitors-"
    MC @ talk "Pero, los inquisidores-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:126
translate es qst_bloodhound_4_hospital_nyxChoices_543f491c:

    # NYX @ angry "Fuck the inquisitors."
    NYX @ angry "Que les den a los inquisidores."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:127
translate es qst_bloodhound_4_hospital_nyxChoices_078ca3b0:

    # NYX @ angry "And fuck Lukkan and the others."
    NYX @ angry "Y a la mierda Lukkan y los demás."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:128
translate es qst_bloodhound_4_hospital_nyxChoices_e295341a:

    # NYX @ angry "The city Watch needs all the help it can get, and none of those fuckers are willing to lift a damn finger to help if it involves pulling from their precious sectors."
    NYX @ angry "La guardia de la ciudad necesita toda la ayuda posible, y ninguno de esos cabrones está dispuesto a mover un maldito dedo para ayudar si eso implica tirar de sus preciados sectores."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:129
translate es qst_bloodhound_4_hospital_nyxChoices_3ff61c69:

    # NYX @ talk "I may call upon you again, for help."
    NYX @ talk "Puede que vuelva a pedirte ayuda."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:130
translate es qst_bloodhound_4_hospital_nyxChoices_0466bb7a:

    # NYX @ angry "You may be one of the only few in this wretched city I actually know I can trust."
    NYX @ angry "Puede que seas uno de los pocos en esta miserable ciudad en los que realmente sé que puedo confiar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:133
translate es qst_bloodhound_4_hospital_nyxChoices_0f796eb3:

    # MC @ talk "I'm done with questions..."
    MC @ talk "He terminado con las preguntas..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:134
translate es qst_bloodhound_4_hospital_nyxChoices_310c3340:

    # MC @ talk "What now?"
    MC @ talk "¿Ahora qué?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:135
translate es qst_bloodhound_4_hospital_nyxChoices_c93cf8f4:

    # NYX @ talk "Not much, you go back to doing whatever it is you were doing before."
    NYX @ talk "No mucho, vuelves a hacer lo que hacías antes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:136
translate es qst_bloodhound_4_hospital_nyxChoices_8d9965eb:

    # MC @ talk "But... The investigation?"
    MC @ talk "Pero... ¿La investigación?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:137
translate es qst_bloodhound_4_hospital_nyxChoices_d08d005d:

    # NYX @ talk "Not your responsibility anymore."
    NYX @ talk "Ya no es tu responsabilidad."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:138
translate es qst_bloodhound_4_hospital_nyxChoices_e5b291a8:

    # NYX @ talk "At least, until I can do some more digging into what Azul found."
    NYX @ talk "Al menos, hasta que pueda indagar más en lo que Azul encontró."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:140
translate es qst_bloodhound_4_hospital_nyxChoices_83b8fbc8:

    # MC @ talk "...That {i}thing.{/i}"
    MC @ talk "...Esa {i}cosa.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:141
translate es qst_bloodhound_4_hospital_nyxChoices_df7f4b5b:

    # NYX @ talk "Returned to its master, no doubt."
    NYX @ talk "De vuelta a su amo, sin duda."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:142
translate es qst_bloodhound_4_hospital_nyxChoices_4bcd9b36:

    # MC @ talk "{i}Master?{/i} You mean-"
    MC @ talk "{i}¿Amo?{/i} ¿Quieres decir que-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:143
translate es qst_bloodhound_4_hospital_nyxChoices_c9c2e169:

    # NYX @ angry "Yes, that thing serves to cover the tracks of it's master."
    NYX @ angry "Sí, esa cosa sirve para cubrir las huellas de su amo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:144
translate es qst_bloodhound_4_hospital_nyxChoices_2207c685:

    # MC @ talk "How do you know?"
    MC @ talk "¿Cómo lo sabes?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:145
translate es qst_bloodhound_4_hospital_nyxChoices_c5aabc37:

    # NYX @ talk "Whatever Azul uncovered brought him into the sights of some {i}powerful{/i} people."
    NYX @ talk "Lo que sea que Azul descubrió lo puso en la mira de algunas personas {i}poderosas{/i}."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:146
translate es qst_bloodhound_4_hospital_nyxChoices_a0d4bfdb:

    # NYX @ talk "That thing didn't just kill him, it destroyed all of the sensitive information Azul had been gathering."
    NYX @ talk "Esa cosa no solo le mató, sino que destruyó toda la información sensible que Azul había estado recopilando."

