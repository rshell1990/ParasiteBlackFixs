

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:245
translate es qst_TheComingStorm_NovarasGatesCantExit_28b524f3:

    # "At the city gates, dozens of wagons sat motionless, traders, merchants, and families arguing for their right to leave."
    "A las puertas de la ciudad, decenas de carromatos permanecían inmóviles, comerciantes, mercaderes y familias discutiendo por su derecho a partir."

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:246
translate es qst_TheComingStorm_NovarasGatesCantExit_1bacfdc5:

    # "Each was denied by the stationed guards."
    "Todos fueron rechazados por los guardias."

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:248
translate es qst_TheComingStorm_NovarasGatesCantExit_7b096b57:

    # GUARD "HALT!"
    GUARD "¡ALTO!"

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:250
translate es qst_TheComingStorm_NovarasGatesCantExit_ec7a938e:

    # GUARD "By order of the Emperor, no one may leave Novaras until the siege threat has passed!"
    GUARD "¡Por orden del emperador, nadie puede abandonar Novaras hasta que la amenaza de asedio haya pasado!"

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:257
translate es qst_TheComingStorm_NovarasGatesCantExit_4e2858dd:

    # GUARD "Official permits are only granted to high lords or ranking military officials."
    GUARD "Los permisos oficiales solo se conceden a los grandes señores o a los militares de alto rango."

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:258
translate es qst_TheComingStorm_NovarasGatesCantExit_606ce54b:

    # GUARD "Neither of which you are... Move along."
    GUARD "No eres ni lo uno ni lo otro... Muévete."

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:259
translate es qst_TheComingStorm_NovarasGatesCantExit_6deabfda:

    # MC "(Fuck... Looks like I'm not getting out through the main gate.)"
    MC "(Joder... Parece que no voy a salir por la puerta principal)."

# game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:263
translate es qst_TheComingStorm_NovarasGatesCantExit_a121e07c:

    # GUARD "Be ready for further announcements from the city guard!"
    GUARD "¡Estén preparados para nuevos anuncios de lo guardias de la ciudad!"

translate es strings:

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:2
    old "Attend the meeting"
    new "Asiste a la reunión"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:2
    old "I was prompted to come to the guild after dark. Something important's going down."
    new "Me pidieron que viniera al gremio al por la noche. Algo importante está pasando."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:28
    old "The Coming Storm"
    new "La tormenta que se avecina"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:29
    old "Soon, Novaras will fall under a terrible siege by the Demorai... I must do what I can to help the city prepare."
    new "Pronto, Novaras caerá bajo un terrible asedio de los demorai... Debo hacer lo que pueda para ayudar a la ciudad a prepararse."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Warn Captain Nyx"
    new "Advierte a la capitana Nyx"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Kiara, back from the dead, has warned me of an impending siege upon Novaras... I must talk to Captain Nyx."
    new "Kiara, de vuelta de entre los muertos, me ha advertido de un inminente asedio a Novaras... Debo hablar con la capitana Nyx."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Talk to the guards"
    new "Habla con los guardias"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "I must talk to the guards at the gates about Poltrik, Captain Nyx's agent gone missing."
    new "Debo hablar con los guardias de las puertas sobre Poltrik, el agente de la capitana Nyx desaparecido."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Check the Iron Unicorn"
    new "Comprueba el Unicornio de hierro"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Sergeant Poltrik was seen at the Iron Unicorn tavern, investigating some traders. Perhaps I should check there..."
    new "El sargento Poltrik fue visto en la taberna Unicornio de hierro, investigando a unos comerciantes. Tal vez debería comprobar allí..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Keep looking for Poltrik"
    new "Sigue buscando a Poltrik"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Shay suggests I seek information on missing guards or strange traders in {i}less reputable places{/i}. I should talk to the working girls at the Pleasure District.\nOr, perhaps Regina could help? She is close with Erika, and Erika is Inquisition. 'Inquisition sees all', as they say..."
    new "Shay sugiere que busque información sobre guardias desaparecidos o los comerciantes extraños en {i}lugares menos reputados{/i}. Debería hablar con las chicas que trabajan en el distrito del placer.\n¿O tal vez Regina podría ayudar? Es cercaca a Erika, y Erika es de la Inquisición. 'La Inquisición lo ve todo', como dicen..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Go to the library"
    new "Ve a la biblioteca"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "The Inquisition seems to also be looking for the missing guards. I can try get in contact with Inquisitor Saren by following the instructions from the letter Erika left for me.\nI'll need a password to contact Saren: a name of some book I am to ask about at the library. The letter said I should start with {i}'Dreams of Astatar'{/i}, whatever that is."
    new "Parece que la Inquisición también está buscando a los guardias desaparecidos. Puedo intentar ponerme en contacto con la inquisidora Saren siguiendo las instrucciones de la carta que me dejó Erika.\nNecesitaré una contraseña para contactar con Saren: el nombre de algún libro por el que deba preguntar en la biblioteca. La carta decía que debía empezar por {i}'Sueños de Astatar'{/i}, sea lo que sea."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Pick up a parcel for Vala"
    new "Recoge un paquete para Vala"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "I need to get to the market district, after dark, to pick up a parcel for Vala in exchange for her help."
    new "Necesito llegar al distrito del mercado, porl a noche, para recoger un paquete para Vala a cambio de su ayuda."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Follow the assassin's instructions"
    new "Sigue las instrucciones del asesino"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "The parcel retrieval did not go as planned, at all. Whoever I had to contact demanded 'her head' but quite soon lost his own to a third party, who also snatched the package. I have no choice but to buy out the parcel now.\nI need to put a thousand coins in a special hidden spot near the Weeping Heart. I should do this next night."
    new "La recogida del paquete no salió como estaba previsto, en absoluto. La persona con la que tuve que contactar exigió 'su cabeza' pero muy pronto perdió la suya a manos de un tercero, que también le arrebató el paquete. No tengo más remedio que comprar el paquete.\nNecesito poner mil monedas en un lugar especial escondido cerca del Corazón llorón. Debo hacerlo la próxima noche."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Deal with the assassin"
    new "Lidia con el asesino"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Time to retrieve the package, for real now."
    new "Es hora de recuperar el paquete, ahora sí."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Bring the parcel to Vala"
    new "Lleva el paquete a Vala"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Having dealt with the assassin I have retrieved the parcel. Time to head back to the library, hopefully I'll get some answers from Vala."
    new "Habiéndome ocupado del asesino he recuperado el paquete. Es hora de volver a la biblioteca, espero obtener algunas respuestas de Vala."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Vala or... whatever her real name is, shared some dark information on the missing guards. Apparently they might be hiding in the southern Housing District, at one of Poltrik's family properties. I need to report to Captain Nyx, she should know the exact place."
    new "Vala o... cualquiera que sea su verdadero nombre, compartió alguna información oscura sobre los guardias desaparecidos. Aparentemente podrían estar escondidos en el distrito de viviendas sur, en una de las propiedades de la familia de Poltrik. Tengo que informar a la capitana Nyx, ella debe saber el lugar exacto."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "It seems we have found Poltrik. Whatever abomination he is now... It is still roaming free in the city. I need to talk to Nyx."
    new "Parece que hemos encontrado a Poltrik. Sea cual sea la abominación que es ahora... Todavía vaga libre por la ciudad. Necesito hablar con Nyx."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Get to the library"
    new "Ve a la biblioteca"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Erika had helped me escape, but now I need a place to hide. Perhaps Vala could help? I should be careful getting there."
    new "Erika me había ayudado a escapar, pero ahora necesito un lugar donde esconderme. ¿Quizás Vala podría ayudar? Debería tener cuidado al llegar allí."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Put on a show"
    new "Monta un espectáculo"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "I have agreed to put on a show for Carina in exchange for her help looking for the missing guards. I should return to her the next day. Anything for the City of Novaras..."
    new "He accedido a montar un espectáculo para Carina a cambio de su ayuda para buscar a los guardias desaparecidos. Debería volver con ella al día siguiente. Cualquier cosa por la ciudad de Novaras..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Look for Valchek"
    new "Busca a Valchek"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "I must deal with an associate of Carina gone rogue, Valchek. She wants him gone, one way or another. I should be able to find him in the market district."
    new "Debo lidiar con un socio de Carina que se ha vuelto rebelde, Valchek. Ella lo quiere fuera, de una manera u otra. Debería ser capaz de encontrarlo en el distrito del mercado."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Pay for the meeting"
    new "Paga por la reunión"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Lucius Mal can set up a meeting with Valchek for me, but not for free."
    new "Lucius Mal puede organizarme una reunión con Valchek, pero no gratis."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Come to the store after dark"
    new "Ve a la tienda por la noche"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "I have paid Lucius Mal to set up a meeting with Valchek. I need to come to his store at night."
    new "Le he pagado a Lucius Mal para que organice una reunión con Valchek. Tengo que ir a su tienda por la noche."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Kill Valchek"
    new "Mata a Valchek"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "I have met Valchek. Now, it's time for some problem-solving, the ancient way..."
    new "He conocido a Valchek. Ahora, es hora de resolver algunos problemas, a la antigua usanza..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Report to Carina"
    new "Informa a Carina"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Valchek is dealt with... for good. I should turn in. Carina will like the good news."
    new "Valchek está acabado... para siempre. Debería volver. A Carina le gustarán las buenas noticias."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Speak to Carina on behalf of Caskell"
    new "Habla con Carina de parte de Caskell"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "I have agreed to smuggle Valchek out of Novaras.\nLucius Mal will help arrange that, but not for free. He asked me to convince Carina to meet with someone who goes by the name Caskell."
    new "He accedido a sacar de contrabando a Valchek de Novaras.\nLucius Mal ayudará a organizarlo, pero no gratis. Me pidió que convenciera a Carina de reunirse con alguien llamado Caskell."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Return to Lucius Mal"
    new "Vuelve con Lucius Mal"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "I have talked to Carina, she agreed to meet up with Caskell. I should meet with Lucius Mal so that we can move on with smuggling Valchek out of the city. I think Lucius will want this done at night..."
    new "He hablado con Carina, aceptó reunirse con Caskell. Debería reunirme con Lucius Mal para que podamos seguir adelante con el contrabando de Valchek fuera de la ciudad. Creo que Lucius querrá que esto se haga de noche..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Carina will never hear from Valchek again. Hopefully, she will not find out that Valchek is still alive though..."
    new "Carina no volverá a saber nada de Valchek. Con suerte, no se enterará de que Valchek sigue viva..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Return to Carina in three days"
    new "Vuelve a ver a Carina en tres días"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Carina is using her resources to help me find Poltrik. She said she would need three days to gather the intelligence."
    new "Carina está usando sus recursos para ayudarme a encontrar a Poltrik. Dijo que necesitaría tres días para reunir información."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Carina's sources report that the guards might be hiding in the southern Housing District. I need to report to Captain Nyx."
    new "Las fuentes de Carina informan que los guardias podrían estar escondidos en el distrito de viviendas sur. Tengo que informar a la capitana Nyx."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Go to Poltrik's family estate"
    new "Ve a la finca familiar de Poltrik"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Nyx says Poltrik's uncle has a manor in the south-eastern district. Perhaps this is where Poltrik hides. I need to get there at once."
    new "Nyx dice que el tío de Poltrik tiene una mansión en el distrito sureste. Tal vez es aquí donde Poltrik se esconde. Necesito llegar allí de inmediato."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Defeat Poltrik"
    new "Derrota a Poltrik"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Having surrendered himself to the darkness, Poltrik has... {i}changed.{/i} A monster himself, he also turned his uncle's estate into a breeding ground for some kind of Demorai abominations."
    new "Habiéndose entregado a la oscuridad, Poltrik ha... {i}cambiado.{/i} Convertido en un monstruo, también transformó la finca de su tío en un criadero de algún tipo de abominaciones demorai."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:30
    old "Erika had helped me escape, but now I need a place to hide. Perhaps Carina could help? I should be careful getting there."
    new "Erika me había ayudado a escapar, pero ahora necesito un lugar donde esconderme. ¿Quizás Carina podría ayudar? Debería tener cuidado al llegar allí."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:230
    old "Bookshelves upstairs"
    new "Estanterías de arriba"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:290
    old "Stash gold"
    new "Alijo de oro"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:322
    old "I must speak with you about an urgent matter at once!"
    new "¡Debo hablar contigo sobre un asunto urgente de inmediato!"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:326
    old "I need information on some guards gone missing."
    new "Necesito información sobre unos guardias desaparecidos."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:330
    old "Where's Erika? I must speak with her at once!"
    new "¿Dónde está Erika? ¡Debo hablar con ella de inmediato!"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:333
    old "Have you found anything useful?"
    new "¿Has encontrado algo útil?"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:337
    old "I wanted to ask about a particular book..."
    new "Quería preguntar sobre un libro en particular..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:339
    old "Do you know of a book called Dreams of Astatar?"
    new "¿Conoces un libro titulado Sueños de Astatar?"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:342
    old "I'm looking for someone called Valchek."
    new "Estoy buscando a alguien llamado Valchek."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:344
    old "About Valchek..."
    new "Sobre Valchek..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:348
    old "I have dealt with Caskell."
    new "Me he ocupado de Caskell."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:351
    old "Valchek is dead."
    new "Valchek está muerto."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:353
    old "Valchek is gone...."
    new "Valchek se ha ido...."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:356
    old "A merchant who goes by the name Caskell wants to meet with you."
    new "Un mercader que se hace llamar Caskell quiere reunirse contigo."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:370
    old "Captain Nyx sent me to investigate Sergeant Poltrik's disappearance..."
    new "La capitana Nyx me envió a investigar la desaparición del sargento Poltrik..."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:370
    old "Where do I get an official permit?"
    new "Dónde puedo obtener un permiso oficial?"
