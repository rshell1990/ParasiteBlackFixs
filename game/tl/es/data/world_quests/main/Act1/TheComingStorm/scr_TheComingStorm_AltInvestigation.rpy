    new "Entonces... ¿Tu verdadero nombre es Saren?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:359
    old "Why are you helping me now? Aren't you helping Erika investigate me?"
    new "¿Por qué me ayudas ahora? ¿No estás ayudando a Erika a investigarme?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:359
    old "What do you know about Poltrik and his men then?"
    new "¿Qué sabes entonces de Poltrik y sus hombres?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:452
    old "No... I can't."
    new "No... no puedo."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:452
