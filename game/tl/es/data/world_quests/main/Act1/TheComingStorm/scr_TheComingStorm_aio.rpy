    new "¿Quién es la chica con la que estaré?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:735
    old "I'll put on a show with the mystery girl"
    new "Haré un espectáculo con la chica misteriosa"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:737
