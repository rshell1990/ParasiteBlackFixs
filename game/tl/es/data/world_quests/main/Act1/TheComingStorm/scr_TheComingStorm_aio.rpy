translate es strings:

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:30
    old "{image=[ICON.CLOCK]} Attend the meeting"
    new "{image=[ICON.CLOCK]} Asiste a la reunión."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:182
    old "Adara, wake your father and head straight to Newyark tonight"
    new "Adara, despierta a tu padre y ve directo a Newyark esta noche."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:182
    old "Listen to me, board up your house, gather what food you can... and get a blade."
    new "Escúchame, tapia tu casa, reúne la comida que puedas... y consigue una espada."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:186
    old "Take my coin and go, Adara... Please. Don't wait for the announcement in the morning."
    new "Acepta mi moneda y vete, Adara... por favor. No esperes al anuncio por la mañana."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:186
    old "Damn it all! Board up your house, gather what food you can... and get a blade."
    new "¡Maldita sea! Tapia tu casa, reúne la comida que puedas... y consigue una espada."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:391
    old "You've known for over two months and said nothing?"
    new "¿Lo sabes desde hace más de dos meses y no has dicho nada?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:391
    old "Not evacuating the city is a mistake..."
    new "No evacuar la ciudad es un error..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:391
    old "I only know there is some wicked plan in motion..."
    new "Solo sé que hay algún malvado plan en marcha..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:434
    old "What were they investigating?"
    new "¿Qué estaban investigando?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:434
    old "Is this really the time for this? The city is about to be sieged!"
    new "¿Es realmente el momento para esto? ¡La ciudad está a punto de ser asediada!"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:434
    old "I'll look into it… and hope I find you the proof you need."
    new "Lo investigaré... y espero encontrarte las pruebas que necesitas."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:467
    old "What can you tell me about the traders?"
    new "¿Qué puedes decirme sobre los comerciantes?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:467
    old "Can you tell me more about their cargo?"
    new "¿Puede decirme algo más sobre su carga?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:467
    old "Where did Poltrik and his men go?"
    new "¿Adónde fueron Poltrik y sus hombres?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:475
    old "Did you not realize the documents were forged?"
    new "¿No te diste cuenta de que los documentos eran falsos?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:475
    old "What do you mean by pale and reeking of foul odor?"
    new "¿Qué quieres decir con pálido y apestoso?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:475
    old "I have more questions."
    new "Tengo más preguntas."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:497
    old "Were they carrying any weapons?"
    new "¿Llevaban armas?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:497
    old "Any sign of explosives?"
    new "¿Algún rastro de explosivos?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:497
    old "Why wasn't the rotten food destroyed?"
    new "¿Por qué no se destruyó la comida podrida?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:535
    old "Did Sergeant Poltrik and some city guards come by here recently?"
    new "¿Pasaron por aquí hace poco el sargento Poltrik y algunos guardias de la ciudad?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:535
    old "Where's your husband, Shay?"
    new "¿Dónde está tu marido, Shay?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:547
    old "Do you know where the traders went?"
    new "¿Sabes adónde fueron los comerciantes?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:547
    old "Did Poltrik or the others mention where they might go next?"
    new "¿Mencionaron Poltrik o los otros adónde irían después?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:641
    old "I'll help you put on your show."
    new "Te ayudaré a montar tu espectáculo."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:643
