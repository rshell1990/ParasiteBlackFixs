    new "Me ocuparé de tu {i}'problema.'{/i}"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:645
    old "My outfit?"
    new "¿Mi traje?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:645
    old "Who will I be performing with?"
    new "¿Con quién voy a actuar?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:645
    old "I'll return tomorrow."
    new "Volveré mañana."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:706
    old "Want to try ride this 'bull' Carina?"
    new "¿Quieres probar a montar este 'toro' Carina?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:706
    old "Do people seriously like this sort of thing?"
    new "¿De verdad a la gente le gusta este tipo de cosas?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:706
