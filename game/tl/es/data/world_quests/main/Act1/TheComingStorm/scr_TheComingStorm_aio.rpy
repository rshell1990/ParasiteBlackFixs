    old "Poltrik's family estate"
    new "La finca familiar de Poltrik"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1408
    old "Try to open the door"
    new "Intenta abrir la puerta"

