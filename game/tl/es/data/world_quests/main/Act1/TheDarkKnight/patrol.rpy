# game/data/world_quests/main/Act1/TheDarkKnight/patrol.rpy:21
translate es DarkKnightNovarasPatrolTry_bec6cae7:

    # "However, no matter which dark corner I poked my nose in, I could not find a single troublemaker."
    "Sin embargo, no importaba en qué rincón oscuro asomara la nariz, no encontraba ni un solo alborotador."

# game/data/world_quests/main/Act1/TheDarkKnight/patrol.rpy:28
translate es DarkKnightNovarasPatrolTry_6eefcd77:

