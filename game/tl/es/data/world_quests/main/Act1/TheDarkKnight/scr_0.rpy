

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:6
translate es qst_DarkKnight_0_startEvent_5edd6a24:

    # REGINA @ talk "Ah, [player_name!t], there you are."
    REGINA @ talk "Ah, [player_name!t], ahí estás."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:7
translate es qst_DarkKnight_0_startEvent_cef4d643:

    # MC @ talk "[regina_ref_cap!t]? What is it?"
    MC @ talk "¿[regina_ref_cap!t]? ¿Qué es lo que pasa?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:11
translate es qst_DarkKnight_0_startEvent_bdd287cb:

    # REGINA @ talk "An Officer came by with some men today, Lukkan I think it was?"
    REGINA @ talk "Un oficial vino hoy con algunos hombres, Lukkan creo que era..."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:12
translate es qst_DarkKnight_0_startEvent_a927b653:

    # REGINA @ talk "He brought a letter which I've left on your bed, says he has some urgent work for you to do."
    REGINA @ talk "Ha traído una carta que he dejado sobre tu cama, dice que tiene un trabajo urgente para ti."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:13
translate es qst_DarkKnight_0_startEvent_84357043:

    # REGINA @ talk "Any idea what all this is about?"
    REGINA @ talk "¿Alguna idea de qué va todo esto?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:14
translate es qst_DarkKnight_0_startEvent_e50dbf2b:

    # MC @ talk "No clue."
    MC @ talk "Ni idea."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:15
translate es qst_DarkKnight_0_startEvent_7e740501:

    # REGINA @ talk "Hmm, well, hopefully it's nothing too dangerous dear..."
    REGINA @ talk "Hmm, bueno, esperemos que no sea nada demasiado peligroso cariño..."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:18
translate es qst_DarkKnight_0_startEvent_e0397941:

    # REGINA @ talk "I know you will dear."
    REGINA @ talk "Sé que lo harás, cariño."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:19
translate es qst_DarkKnight_0_startEvent_063e1639:

    # REGINA @ talk "I know you can handle yourself, but that doesn't mean you're invincible."
    REGINA @ talk "Sé que puedes arreglártelas solo, pero eso no significa que seas invencible."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:20
translate es qst_DarkKnight_0_startEvent_66b69b31:

    # REGINA @ talk "Take your time and prepare for something if you don't feel ready."
    REGINA @ talk "Tómate tu tiempo y prepárate para algo si no te sientes preparado."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:23
translate es qst_DarkKnight_0_startEvent_15705e04:

    # REGINA @ talk "No, he just 'congratulated' me for raising one of the Scouts' finest and told me to give you that letter."
    REGINA @ talk "No, solo me 'felicitó' por criar a uno de los mejores exploradores y me dijo que te diera esa carta."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:24
translate es qst_DarkKnight_0_startEvent_dd26150b:

    # MC @ talk "I take it you didn't like him?"
    MC @ talk "¿Supongo que no te cayó bien?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:25
translate es qst_DarkKnight_0_startEvent_5588edc5:

    # REGINA @ talk "Hmph, not him but say... More I'd never trust anyone in the Alderian government."
    REGINA @ talk "Hmph, no él pero digamos... Más bien nunca confiaría en nadie del gobierno alderiano."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:25
translate es qst_DarkKnight_0_startEvent_d6ab8297:

    # "[regina_ref_cap!t] feigned a smile at the remark."
    "[regina_ref_cap!t] fingió una sonrisa ante el comentario."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:29
translate es qst_DarkKnight_0_startEvent_eb02d764:

    # REGINA @ talk "Dear... You need to learn to use more than your fists to win every fight."
    REGINA @ talk "Cariño... Necesitas aprender a usar más que tus puños para ganar cada pelea."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:30
translate es qst_DarkKnight_0_startEvent_c4f2687f:

    # MC @ talk "That's why I have my blade."
    MC @ talk "Por eso tengo mi espada."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:31
translate es qst_DarkKnight_0_startEvent_ab8e2076:

    # REGINA @ talk "That's not..."
    REGINA @ talk "Eso no es..."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:29
translate es qst_DarkKnight_0_startEvent_da54c8ca:

    # MC @ talk "Don't worry [regina_ref!t], I know what you meant."
    MC @ talk "No te preocupes [regina_ref!t], sé lo que querías decir."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:34
translate es qst_DarkKnight_0_startEvent_c065d263:

    # REGINA @ talk "Anyway, I shall leave you to it."
    REGINA @ talk "En fin, te dejo con ello."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:32
translate es qst_DarkKnight_0_startEvent_90397aa1:

    # MC @ talk "Thanks [regina_ref!t]."
    MC @ talk "Gracias [regina_ref!t]."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:42
translate es qst_DarkKnight_0_startEvent_7efd249c:

    # MC "(Hmm...)"
    MC "(Hmm...)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:43
translate es qst_DarkKnight_0_startEvent_05049959:

    # MC "(The letter has the official seal on it, so it looks like it means business.)"
    MC "(La carta lleva el sello oficial, así que parece que va en serio)."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:44
translate es qst_DarkKnight_0_startEvent_04a0c64d:

    # MC "(Let's see...)"
    MC "(Veamos...)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:42
translate es qst_DarkKnight_0_startEvent_d27c8688:

    # LUKKAN "[player_name!t], it has come to my attention that Captain Nyx of the City Watch is in dire need of some support tackling security issues inside and outside the Capital."
    LUKKAN "[player_name!t], me he enterado de que la capitana Nyx de la guardia de la ciudad necesita urgentemente ayuda para hacer frente a los problemas de seguridad dentro y fuera de la capital."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:46
translate es qst_DarkKnight_0_startEvent_988d3553:

    # LUKKAN "I have put forward your name for this endeavor, and request you speak to her as soon as possible - Head down to her office at the city fort."
    LUKKAN "He propuesto tu nombre para esta tarea y te pido que hables con ella lo antes posible - Dirígete a su despacho en la fortaleza de la ciudad."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:47
translate es qst_DarkKnight_0_startEvent_d00256d8:

    # LUKKAN "Any work you do for her will be graciously rewarded."
    LUKKAN "Cualquier trabajo que hagas para ella será graciosamente recompensado."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:48
translate es qst_DarkKnight_0_startEvent_94652cee:

    # MC "(Great... So much for all our worries being behind us.)"
    MC "(Genial... Demasiado para que todas nuestras preocupaciones queden atrás)."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:49
translate es qst_DarkKnight_0_startEvent_68f73bdc:

    # MC "(I should look into this as soon as I can... It's not wise to keep officials waiting.)"
    MC "(Debería investigar esto en cuanto pueda... No es prudente hacer esperar a los oficiales)."

translate es strings:

    # game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:16
    old "Don't worry, I'll be careful."
    new "No te preocupes, tendré cuidado."

    # game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:16
    old "Did he say anything else?"
    new "¿Dijo algo más?"

    # game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:16
    old "I am the danger."
    new "Yo soy el peligro."
