# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:67
translate es qst_DarkKnight_1_GoToCaptainNyxOffice_b860df6b:

    # NYX @ talk "Find them, and take them out."
    NYX @ talk "Encuéntralos y elimínalos."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:68
translate es qst_DarkKnight_1_GoToCaptainNyxOffice_c2211533:

    # NYX @ angry "I'll string up a few of the bodies when you're done, then they'll know not to fuck around."
    NYX @ angry "Colgaré algunos de los cuerpos cuando termines, así sabrán que no deben molestar."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:72
translate es qst_DarkKnight_1_atCaptainNyxOffice_menu_f1792b2d:

    # NYX @ angry "Because we're stretched thin enough as it is, Alcott keeps pulling my men into whatever division he thinks is most important for the day and he's leaving me severely short-handed."
    NYX @ angry "Como ya estamos bastante sobrecargados, Alcott no para de tirar de mis hombres hacia la división que cree que es más importante para el día y me está dejando muy corta de personal."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:73
translate es qst_DarkKnight_1_atCaptainNyxOffice_menu_a52b06f6:

    # NYX @ angry "The fucker's so busy worrying about the enemy beyond the wall, he forgets about the threats from within."
    NYX @ angry "El cabrón está tan ocupado preocupándose por el enemigo más allá de las murallas, que se olvida de las amenazas del interior."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:74
translate es qst_DarkKnight_1_atCaptainNyxOffice_menu_7d5932ee:

