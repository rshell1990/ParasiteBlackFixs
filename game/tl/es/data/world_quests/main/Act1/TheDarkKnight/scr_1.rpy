# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:59
translate es qst_DarkKnight_1_GoToCaptainNyxOffice_02682086:

    # NYX @ talk "Your services are called upon to serve the Kingdom once again."
    NYX @ talk "Tus servicios son requeridos para servir al reino una vez más."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:60
translate es qst_DarkKnight_1_GoToCaptainNyxOffice_d9e10f0a:

    # NYX @ talk "I don't know how aware you are with how 'fragile' things can be in this city, but suffice to say, I'm in need of a sellsword like yourself."
    NYX @ talk "No sé hasta qué punto eres consciente de lo 'frágiles' que pueden ser las cosas en esta ciudad, pero basta con decir que necesito un mercenario como tú."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:61
translate es qst_DarkKnight_1_GoToCaptainNyxOffice_6f18111b:

    # NYX @ talk "You'll be well compensated for your services."
    NYX @ talk "Recibirás una buena compensación por tus servicios."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:62
translate es qst_DarkKnight_1_GoToCaptainNyxOffice_4b2d3807:

