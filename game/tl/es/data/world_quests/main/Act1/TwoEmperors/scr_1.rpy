# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:161
translate es qst_TwoEmperors_temple_clickableWater_5c07169a:

    # "Peering into the depths of the stagnant water over the edges of the erected stone pathways gave me an uneasy feeling."
    "Al asomarme a las profundidades del agua estancada por encima de los bordes de los caminos de piedra erigidos, tuve una sensación de inquietud."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:162
translate es qst_TwoEmperors_temple_clickableWater_75e29588:

    # "I could not see what was down there, but I could sense movement beneath that blackened water all the same."
    "No podía ver lo que había allí abajo, pero de todos modos percibía movimiento bajo aquella agua ennegrecida."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:163
translate es qst_TwoEmperors_temple_clickableWater_16c00e6b:

    # "Just how deep did these waters run?"
    "¿Hasta dónde llegaban esas aguas?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:166
translate es qst_TwoEmperors_temple_clickableWater_d126116d:

    # "I leant down and gently submerged my hand in the cold waters watching the water ripple."
    "Me incliné y sumergí suavemente la mano en las frías aguas observando cómo ondulaba el agua."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:167
translate es qst_TwoEmperors_temple_clickableWater_5171c464:

    # "{i}Something{/i} splashed up-ahead in the water once the wave of my ripple passed it."
    "{i}Algo{/i} chapoteó en el agua una vez que la ola de mi ondulación lo pasó."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:168
translate es qst_TwoEmperors_temple_clickableWater_0e4edc86:

    # "I quickly pulled my hand out."
    "Rápidamente saqué la mano."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:169
translate es qst_TwoEmperors_temple_clickableWater_907c3645:

    # MC "(Probably not a good idea to do that again...)"
    MC "(Probablemente no sea buena idea volver a hacerlo...)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:175
translate es qst_TwoEmperors_temple_clickableWater_af42c0e5:

    # "Placing my hand into the water, the ripples once again waved across the still waters."
    "Al meter la mano en el agua, las ondas volvieron a ondear sobre las tranquilas aguas."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:179
translate es qst_TwoEmperors_temple_clickableWater_fc27693d:

    # "This time though, bursting out of the waters came a fury of tentacles thrashing wildly!"
    "¡Sin embargo, esta vez surgió de las aguas una furia de tentáculos que se agitaban salvajemente!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:180
translate es qst_TwoEmperors_temple_clickableWater_a70c5cab:

    # MC "(FUCK!)"
    MC "(¡JODER!)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:191
translate es qst_TwoEmperors_temple_clickableWater_d9bfe972:

    # "Whipping us away with it's powerful tentacles before retreating into the black depths of the water once more."
    "Azotándonos con sus poderosos tentáculos antes de retirarse a las negras profundidades del agua una vez más."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:194
translate es qst_TwoEmperors_temple_clickableWater_4f11fb8d:

    # "After slashing and tearing off one of the beasts' tentacles that dropped down into the waters, the beast howled in rage as it quickly retreated and submerged itself back into the black depths from where it came."
    "Tras acuchillar y arrancar uno de los tentáculos de la bestia que caía a las aguas, ésta aulló de rabia mientras retrocedía rápidamente y se sumergía de nuevo en las negras profundidades de donde había salido."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:196
translate es qst_TwoEmperors_temple_clickableWater_ecac9484:

    # "Dazed, me and Markus turned to each other."
    "Aturdidos, Markus y yo nos giramos el uno hacia el otro."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:197
translate es qst_TwoEmperors_temple_clickableWater_4cb4fb7b:

