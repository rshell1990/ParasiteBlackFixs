# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:78
translate es qst_TwoEmperors_1_22d1cae7:

    # "For seemingly miles, we followed the scent as we tracked the tracks deeper and deeper into the Valley of Death."
    "Durante aparentemente kilómetros, seguimos el rastro de las huellas cada vez más adentro en el Valle de la Muerte."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:80
translate es qst_TwoEmperors_1_08706bc2:

    # "The hot sun beat against our backs as I flung myself forward with my tentacles while Markus glided overhead."
    "El ardiente sol golpeaba nuestras espaldas mientras yo me lanzaba hacia delante con mis tentáculos y Markus planeaba por encima."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:82
translate es qst_TwoEmperors_1_bccd70c8:

    # "The scent grew stronger and stronger with each passing moment, till it became an overpowering stench of death that all Demorai seemed to cake themselves in."
    "El olor se hacía más y más fuerte a cada momento que pasaba, hasta que se convirtió en un abrumador hedor a muerte en el que todos los demorai parecían empaparse."

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:84
translate es qst_TwoEmperors_1_ab793d27:

