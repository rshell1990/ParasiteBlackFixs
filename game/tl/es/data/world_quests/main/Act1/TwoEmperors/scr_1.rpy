# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:204
translate es qst_TwoEmperors_temple_clickableWater_ee79b738:

    # MC "{i}...How the hell does that thing even live down here?{/i}"
    MC "{i}...¿Cómo demonios vive esa cosa aquí abajo?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:205
translate es qst_TwoEmperors_temple_clickableWater_6b4e85b0:

    # MARKUS "I don't fucking care to find out!"
    MARKUS "¡No me importa una mierda averiguarlo!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_1.rpy:206
