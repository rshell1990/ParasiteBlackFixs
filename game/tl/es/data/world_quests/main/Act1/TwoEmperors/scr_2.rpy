

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:3
translate es qst_TwoEmperors_2_63ee727d:

    # "From the depths of the cavern, the sound of drums... Drums beating in the depths of the darkness."
    "Desde las profundidades de la caverna, el sonido de los tambores... Tambores sonando en las profundidades de la oscuridad."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:9
translate es qst_TwoEmperors_2_dcd0cb47:

    # MARKUS "What is that?"
    MARKUS "¿Qué es eso?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:10
translate es qst_TwoEmperors_2_96b7d8a2:

    # MC "...Come on, let's get closer."
    MC "...Vamos, acerquémonos."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:14
translate es qst_TwoEmperors_2_bc88f2af:

    # MARKUS "...F-Fuck?! Are you not hearing the same thing as me?"
    MARKUS "...¡¿J-joder?! ¿No oyes lo mismo que yo?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:15
translate es qst_TwoEmperors_2_567a8d97:

    # MC "Shh! Just follow me damn it!"
    MC "¡Shh! ¡Solo sígueme maldita sea!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:16
translate es qst_TwoEmperors_2_160d87e9:

    # MARKUS "{i}*Sigh*{/i} ...Fuck!"
    MARKUS "{i}*Suspiro*{/i} ...¡Joder!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:19
translate es qst_TwoEmperors_2_d30fcc76:

    # "Following the sounds, we decided it was best to avoid the main pathway where the others would have walked, and instead clambered our way through one of the other connecting winding passages."
    "Siguiendo los sonidos, decidimos que era mejor evitar el camino principal por el que habrían caminado los demás y, en su lugar, trepar por uno de los otros pasadizos serpenteantes."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:20
translate es qst_TwoEmperors_2_3c7a1c5e:

    # "The less traversed pathway rose up as we continued to walk along it, till finally, we stumbled upon an opening which we cautiously approached."
    "El camino menos transitado se elevaba a medida que avanzábamos por él, hasta que finalmente tropezamos con una abertura a la que nos acercamos con cautela."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:24
translate es qst_TwoEmperors_2_f103c1d0:

    # "Peering through the opening cautiously, we could see we were high above the many thousands of Demorai down below in the great Cavern like hall."
    "Al asomarnos cautelosamente por la abertura, pudimos ver que estábamos muy por encima de los miles de demorai que había abajo, en la gran sala similar a una caverna."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:25
translate es qst_TwoEmperors_2_907217ef:

    # "Organized into neat rows, the Demorai forces gathered and waited patiently, staring down at some great oval stone stage with strange markings on it and lit burning iron fire pits all around."
    "Organizados en filas ordenadas, los demorai se reunieron y esperaron pacientemente, observando un gran escenario oval de piedra con extrañas marcas y hogueras de hierro encendidas a su alrededor."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:26
translate es qst_TwoEmperors_2_907b832d:

    # "The front row beat their drums in a synchronized steady rhythm, each boom echoing deeply through the ruins."
    "La primera fila golpea sus tambores con un ritmo sincronizado y constante, y cada estampido resuena profundamente en las ruinas."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:27
translate es qst_TwoEmperors_2_4174dccb:

    # "Markus and I shared a brief look of bewilderment as we continued to watch the scene unfold below us."
    "Markus y yo compartimos una breve mirada de desconcierto mientras seguíamos observando la escena que se desarrollaba bajo nosotros."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:28
translate es qst_TwoEmperors_2_64e08ffa:

    # "Down below, one group of the Demorai stood away from the rest, many of them robed and distinctly on the fringes."
    "Abajo, un grupo de los demorai se apartaba del resto, muchos de ellos con túnicas y claramente al margen."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:29
translate es qst_TwoEmperors_2_30771f5e:

    # "Amongst them though, an old, hunched woman with ashen skin, and beside her, perhaps the most strangely ethereally beautiful, and yet, oddly baleful woman I had ever laid my eyes on, who watched the whole affair with arms crossed looking sternly ahead towards the stage."
    "Entre ellos, sin embargo, una anciana encorvada de piel grisácea y, junto a ella, quizá la mujer más extrañamente bella y, sin embargo, extrañamente siniestra en la que jamás había posado mis ojos, que observaba todo el asunto con los brazos cruzados mirando con severidad hacia el escenario."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:30
translate es qst_TwoEmperors_2_84b9de98:

    # "Finally, the drum beats abruptly stopped as a robed figure emerged onto the stage."
    "Finalmente, los tambores se detuvieron bruscamente y una figura con túnica apareció en el escenario."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:36
translate es qst_TwoEmperors_2_0e766aec:

    # DARK_EMPEROR "{i}...How long since we last stood in these hallowed halls?{/i}"
    DARK_EMPEROR "{i}...¿Cuánto tiempo ha pasado desde la última vez que estuvimos en estos salones sagrados?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:38
translate es qst_TwoEmperors_2_29ff24ea:

    # "Me and Markus shared another look towards each other."
    "Markus y yo compartimos otra mirada."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:39
translate es qst_TwoEmperors_2_96d7be6e:

    # MC "({i}It speaks... A fucking Demorai speaks!{/i})"
    MC "({i}IHabla... ¡Un maldito demorai habla!{/i})"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:39
translate es qst_TwoEmperors_2_44d8ced1:

    # DARK_EMPEROR "How long since our great dream began and led us to this most sacred war?"
    DARK_EMPEROR "¿Cuánto hace que comenzó nuestro gran sueño y nos condujo a esta guerra tan sagrada?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:40
translate es qst_TwoEmperors_2_bad90604:

    # DARK_EMPEROR "The sacrifices our people have shouldered to bring us this far have been immeasurable."
    DARK_EMPEROR "Los sacrificios que nuestro pueblo ha soportado para llevarnos hasta aquí han sido inconmensurables."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:41
translate es qst_TwoEmperors_2_aaa2fb79:

    # DARK_EMPEROR "From the bloody battle rivers of Ashara to the black mines of Helenos, we have fought, and we have prevailed."
    DARK_EMPEROR "Desde los sangrientos ríos de batalla de Ashara hasta las negras minas de Helenos, hemos luchado y hemos vencido."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:42
translate es qst_TwoEmperors_2_80466b4e:

    # DARK_EMPEROR "Now your Emperor calls upon you once again..."
    DARK_EMPEROR "Ahora vuestro emperador os llama una vez más..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:43
translate es qst_TwoEmperors_2_b285ac6b:

    # DARK_EMPEROR "It is no secret this war has taken longer than any of us first expected."
    DARK_EMPEROR "No es ningún secreto que esta guerra ha durado más de lo que cualquiera de nosotros esperaba en un principio."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:44
translate es qst_TwoEmperors_2_e3fbe0ab:

    # DARK_EMPEROR "Our mistakes early on cost us dearly... But now, the time has come to end this endless stalemate!"
    DARK_EMPEROR "Nuestros errores al principio nos costaron muy caros... ¡Pero ha llegado el momento de poner fin a este interminable estancamiento!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:46
translate es qst_TwoEmperors_2_dcd1cbc5:

    # "The mass of Demorai roared in excitement."
    "La masa de demorai rugió de excitación."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:46
translate es qst_TwoEmperors_2_eafb5cde:

    # DARK_EMPEROR "Malakai blesses us with Lord Zanarak's return from his great crusade, and with his aid, I pledge to you."
    DARK_EMPEROR "Malakai nos bendice con el regreso del señord Zanarak de su gran cruzada, y con su ayuda, me comprometo contigo."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:47
translate es qst_TwoEmperors_2_c715dea1:

    # DARK_EMPEROR "WE SHALL CAST OUT THOSE WHO STAND IN OUR WAY AND SWEEP AWAY THEIR ARMIES LIKE DUST!"
    DARK_EMPEROR "¡EXPULSAREMOS A LOS QUE SE INTERPONGAN EN NUESTRO CAMINO Y BARREREMOS SUS EJÉRCITOS COMO SI FUERAN POLVO!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:48
translate es qst_TwoEmperors_2_cdfa84e5:

    # DARK_EMPEROR "THE LAND SHALL FLOW RED WITH THEIR BLOOD TILL THEY ARE BUT A FORGOTTEN DREAM WE ONE DAY TELL OUR YOUNG!"
    DARK_EMPEROR "¡LA TIERRA SE TEÑIRÁ DE ROJO CON SU SANGRE HASTA QUE NO SEAN MÁS QUE UN SUEÑO OLVIDADO QUE UN DÍA CONTAREMOS A NUESTROS JÓVENES!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:50
translate es qst_TwoEmperors_2_376b76ab:

    # "The Demorai horde had now been worked up into a roaring frenzy."
    "La horda demorai se había convertido en un rugiente frenesí."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:50
translate es qst_TwoEmperors_2_1c6020c2:

    # DARK_EMPEROR "Do you hear it my children?"
    DARK_EMPEROR "¿Lo oís, hijos míos?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:51
translate es qst_TwoEmperors_2_9f278520:

    # DARK_EMPEROR "The drums of war beat once again... Our great plan is finally set in motion!"
    DARK_EMPEROR "Los tambores de guerra suenan una vez más... ¡Nuestro gran plan por fin se ha puesto en marcha!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:52
translate es qst_TwoEmperors_2_572abbfa:

    # DARK_EMPEROR "Our Empire stands on the edge of victory! Will you shed your blood with me one final time till the sweet night sings our people songs once again?"
    DARK_EMPEROR "¡Nuestro imperio está al borde de la victoria! ¿Derramaréis vuestra sangre conmigo una última vez hasta que la dulce noche vuelva a cantar las canciones de nuestro pueblo?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:53
translate es qst_TwoEmperors_2_6abc444e:

    # DARK_EMPEROR "WILL YOU?!"
    DARK_EMPEROR "¿¡LO HARÉIS?!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:56
translate es qst_TwoEmperors_2_48164ee7:

    # "The Demorai beat at the drums wildly as the Demorai crowds now roared so loud it was almost painful to the ears."
    "Los demorai golpeaban los tambores salvajemente mientras la multitud Demorai rugía ahora tan fuerte que era casi doloroso para los oídos."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:57
translate es qst_TwoEmperors_2_3d00b271:

    # "The dark emperor rose up his arms into the air as he cried out."
    "El emperador oscuro levantó los brazos al aire mientras gritaba."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:57
translate es qst_TwoEmperors_2_09cd027b:

    # DARK_EMPEROR "LET THE CELEBRATIONS BEGIN!"
    DARK_EMPEROR "¡QUE EMPIECEN LAS CELEBRACIONES!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:61
translate es qst_TwoEmperors_2_44a1e136:

    # "The Demorai roared out in thunderous cries of jubilation, huge trays of beautifully cooked food were brought and shared amongst them."
    "Los Demorai rugieron en estruendosos gritos de júbilo, se sirvieron enormes bandejas de comida bellamente cocinada que se repartieron entre ellos."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:62
translate es qst_TwoEmperors_2_24bc9b33:

    # "The drum beat now became faster and other instruments tuned in."
    "El ritmo de los tambores se hizo más rápido y otros instrumentos entraron en sintonía."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:63
translate es qst_TwoEmperors_2_72e6dbb6:

    # "It was perhaps the most bizarre thing I ever witnessed, the Demorai, the unspeakable terrors thought as nothing more than savage beasts... jovial and dancing with glee."
    "Fue quizá lo más extraño que he presenciado nunca, los demorai, los indecibles terrores pensados como nada más que bestias salvajes... joviales y bailando con regocijo."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:64
translate es qst_TwoEmperors_2_08557dd6:

    # "In the corner as they danced still, that same stern ethereal woman stood unfazed, arms folded as she watched the scene unfold before her."
    "En un rincón, mientras bailaban inmóviles, la misma mujer etérea y severa permanecía imperturbable, cruzada de brazos mientras observaba la escena que se desarrollaba ante ella."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:65
translate es qst_TwoEmperors_2_62acc847:

    # "I could barely pull my eyes away from her beauty till I found Markus' claw on my shoulder as he leaned over to whisper to me."
    "Apenas pude apartar los ojos de su belleza hasta que encontré la garra de Markus en mi hombro mientras se inclinaba para susurrarme."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:66
translate es qst_TwoEmperors_2_758541a6:

    # MARKUS "We should leave."
    MARKUS "Deberíamos irnos."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:67
translate es qst_TwoEmperors_2_7398bf84:

    # "I nodded, and the two of us crawled our way backwards away from the strange party and made our way back the way we came."
    "Asentí, y los dos nos arrastramos hacia atrás, alejándonos de la extraña fiesta y volviendo por donde habíamos venido."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:73
translate es qst_TwoEmperors_2_7d97d050:

    # UNKNOWN "...I see we continue to dance on the edge of oblivion."
    UNKNOWN "...Veo que seguimos bailando al borde del olvido."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:76
translate es qst_TwoEmperors_2_d3f17625:

    # UNKNOWN "{i}...I trust you saw them?{/i}"
    UNKNOWN "{i}...Confío en que los hayas visto.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:78
translate es qst_TwoEmperors_2_b548957e:

    # UNKNOWN "Of course."
    UNKNOWN "Por supuesto."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:79
translate es qst_TwoEmperors_2_556a9aef:

    # UNKNOWN "{i}Then you know what to do, girl.{/i}"
    UNKNOWN "{i}Entonces ya sabes qué hacer, chica.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:81
translate es qst_TwoEmperors_2_c790737a:

    # UNKNOWN "Of course, High Mother."
    UNKNOWN "Por supuesto, madre superiora."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:84
translate es qst_TwoEmperors_2_85f74344:

    # "As we made our way hastily back, the jovial sounds of the party became more and more distant behind us."
    "A medida que nos apresurábamos a volver, los joviales sonidos de la fiesta se hacían cada vez más lejanos a nuestras espaldas."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:85
translate es qst_TwoEmperors_2_cbc2033f:

    # MARKUS "Fucking hells... Now there's {i}two{/i} Emperors?"
    MARKUS "Joder... ¿Ahora hay {i}dos{/i} emperadores?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:86
translate es qst_TwoEmperors_2_f6a04ec0:

    # MARKUS "One was enough!"
    MARKUS "¡Uno era suficiente!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:87
translate es qst_TwoEmperors_2_a39f2156:

    # MARKUS "We need to tell the others what we've seen."
    MARKUS "Tenemos que contar a los demás lo que hemos visto."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:89
translate es qst_TwoEmperors_2_8a11ccd4:

    # MARKUS "The Demorai... They-"
    MARKUS "Los demorai... Ellos-"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:90
translate es qst_TwoEmperors_2_e15d6484:

    # UNKNOWN "{i}Talk?{/i}"
    UNKNOWN "{i}¿Hablan?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:104
translate es qst_TwoEmperors_2_f5b08b87:

    # "The two of us spun around, claws ready as we stared down at the same ethereal beauty I had seen earlier."
    "Los dos nos dimos la vuelta, con las garras preparadas, y nos quedamos mirando a la misma belleza etérea que había visto antes."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:105
translate es qst_TwoEmperors_2_06ae9a6c:

    # MC "How did you-"
    MC "¿Cómo-"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:106
translate es qst_TwoEmperors_2_8a42a2c0:

    # UNKNOWN "Please... You make pitiful spies."
    UNKNOWN "Por favor... Sois unos espías lamentables."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:107
translate es qst_TwoEmperors_2_25cde490:

    # MC "What do you want, Demorai?"
    MC "¿Qué quieres, demorai?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:108
translate es qst_TwoEmperors_2_537bfc02:

    # "The girl laughed."
    "La chica se rió."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:109
translate es qst_TwoEmperors_2_eb3d71ec:

    # UNKNOWN "My name is Sypha... Sypha of House Lamont."
    UNKNOWN "MMi nombre es Sypha... Sypha de la casa Lamont."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:110
translate es qst_TwoEmperors_2_28fc5efd:

    # MC "House... {i}Lamont?{/i}"
    MC "Casa... {i}¿Lamont?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:111
translate es qst_TwoEmperors_2_4ab09aa4:

    # "The Demorai known as Sypha pointed first towards me."
    "La demorai conocida como Sypha señaló primero hacia mí."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:108
translate es qst_TwoEmperors_2_6402b508:

    # SYPHA @ laugh "And you are [player_name!t]."
    SYPHA @ laugh "Y tú eres [player_name!t]."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:113
translate es qst_TwoEmperors_2_8a002215:

    # "Then, she pointed towards Markus."
    "Luego, señaló hacia Markus."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:116
translate es qst_TwoEmperors_2_ea5290d0:

    # SYPHA @ laugh "And you are Markus."
    SYPHA @ laugh "Y tú eres Markus."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:117
translate es qst_TwoEmperors_2_5b597001:

    # MC "You... Know who we are?"
    MC "Tú... ¿Sabes quiénes somos?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:118
translate es qst_TwoEmperors_2_f10011c4:

    # SYPHA @ smug "{i}I know many things.{/i}"
    SYPHA @ smug "{i}Yo sé muchas cosas.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:119
translate es qst_TwoEmperors_2_49fb5000:

    # "The two of us nervously glanced towards each other, how was our secrecy so easily exposed?"
    "Los dos nos miramos nerviosos, ¿cómo se había descubierto tan fácilmente nuestro secreto?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:120
translate es qst_TwoEmperors_2_39d14c74:

    # SYPHA @ talk "Now, you should come with me if you want to make it out of this place alive."
    SYPHA @ talk "Ahora, deberías venir conmigo si quieres salir vivo de este lugar."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:123
translate es qst_TwoEmperors_2_89f19a5d:

    # MARKUS "No chance, Demorai."
    MARKUS "Ni hablar, demorai."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:124
translate es qst_TwoEmperors_2_ff6edd96:

    # "Markus readied himself for battle."
    "Markus se preparó para la batalla."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:125
translate es qst_TwoEmperors_2_8a368e42:

    # SYPHA @ angry "There are hordes of guards now stationed outside the entrance which you came in through."
    SYPHA @ angry "Ahora hay hordas de guardias apostados frente a la entrada por la que entraste."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:126
translate es qst_TwoEmperors_2_c4a8b650:

    # "Sypha shrugged."
    "Sypha se encogió de hombros."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:127
translate es qst_TwoEmperors_2_be59f236:

    # SYPHA @ think "Perhaps you will be able to fight your way through them all, perhaps not."
    SYPHA @ think "Tal vez puedas abrirte paso a través de todos ellos, tal vez no."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:128
translate es qst_TwoEmperors_2_be3ae20d:

    # SYPHA @ talk "But if you follow me, I can lead you out safely."
    SYPHA @ talk "Pero si me sigues, puedo guiarte a la salida con seguridad."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:129
translate es qst_TwoEmperors_2_9c56adeb:

    # MC "Why in all of the hells would we trust you?"
    MC "¿Por qué demonios íbamos a confiar en ti?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:130
translate es qst_TwoEmperors_2_fe829bce:

    # "Sypha smiled."
    "Sypha sonrió."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:131
translate es qst_TwoEmperors_2_084492fa:

    # SYPHA @ smug "...You really don't have any idea about what's {i}really{/i} going on, do you?"
    SYPHA @ smug "...No tenéis  ni idea de lo que {i}realmente{/i} está pasando, ¿verdad?"

