    MC @ surprised "Pero... Los demorai... No se supone que sean-"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:103
translate es qst_TwoEmperors_3_guardDebrief_2851dedb:

    # ALCOTT @ angry "As far as most people are concerned, the Demorai are just savage beasts ready to rip and tear."
    ALCOTT @ angry "Para la mayoría de la gente, los demorai no son más que bestias salvajes dispuestas a desgarrar."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:104
translate es qst_TwoEmperors_3_guardDebrief_e7ea30f8:

    # ALCOTT @ talk "It is best for everyone's sake we keep it that way."
    ALCOTT @ talk "Es mejor por el bien de todos que sigamos así."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:105
translate es qst_TwoEmperors_3_guardDebrief_e22de872:

    # ALCOTT @ talk "Muddying the waters only invites unnecessary divisive discussions."
    ALCOTT @ talk "Enturbiar las aguas solo invita a discusiones divisivas innecesarias."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:110
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_8b289247:

    # ALCOTT @ talk "It is a soft lie that the Demorai are unintelligible savages."
    ALCOTT @ talk "Es una mentira blanda que los demorai sean salvajes ininteligibles."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:111
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_dc64c7cf:

    # ALCOTT @ angry "Make no mistake, intelligent or not, their only goal is to see our destruction."
    ALCOTT @ angry "No te equivoques, inteligentes o no, su único objetivo es ver nuestra destrucción."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:112
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_1eaa1316:

    # ALCOTT @ talk "We must keep that {i}ethical debate{/i} door shut, for questioning our means will only lead us astray."
    ALCOTT @ talk "Debemos mantener cerrado ese {i}debate ético{/i}, pues cuestionar nuestros medios solo nos llevará por mal camino."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:113
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_509e5fae:

    # ALCOTT @ talk "We must focus on military victory only; we cannot afford to be distracted and risk dividing ourselves further."
    ALCOTT @ talk "Debemos centrarnos únicamente en la victoria militar; no podemos permitirnos distraernos y arriesgarnos a dividirnos aún más."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:116
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_136c0ac1:

    # ALCOTT @ joy "Ha!"
    ALCOTT @ joy "¡Ja!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:117
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_3b36fad1:

    # ALCOTT @ angry "Listen to me now, and listen good, boy."
    ALCOTT @ angry "Escúchame ahora, y escúchame bien, chico."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:118
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_832d1377:

    # ALCOTT @ talk "The Demorai have zero interest in any sort of {i}negotiations{/i} while their 'Emperor' rules over them."
    ALCOTT @ talk "Los Demorai no tienen ningún interés en ningún tipo de {i}negociaciones{/i} mientras su 'Emperador' gobierne sobre ellos."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:119
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_0a615b3b:

    # MC @ talk "But why? Why are they doing all this?"
    MC @ talk "Pero, ¿por qué? ¿Por qué hacen todo esto?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:120
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_5ada5ffe:

    # ALCOTT @ talk "Even I do not know that..."
    ALCOTT @ talk "Ni siquiera yo lo sé..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:121
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_a5ca9e15:

    # ALCOTT @ talk "But I know for us there is no seat for us at any negotiations table."
    ALCOTT @ talk "Pero sé que no tenemos sitio en ninguna mesa de negociaciones."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:122
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_b9e9e364:

    # ALCOTT @ talk "We are no more to them than vermin that need to be wiped out."
    ALCOTT @ talk "Para ellos no somos más que alimañas que hay que eliminar."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:124
translate es qst_TwoEmperors_3_guardDebrief_rootMenu_f3683e6e:

    # ALCOTT @ talk "I don't have all day, so speak quickly."
    ALCOTT @ talk "No tengo todo el día, así que habla rápido."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:128
