    # SHYAHTAN "{i}Organs failing...{/i}"
    SHYAHTAN "{i}Fallos orgánicos...{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:810
translate es qst_TheBeastOfNovaras_FlashbackBattleDeathLines_41bb01a5:

    # SHYAHTAN "No... This was no..."
    SHYAHTAN "No... Esto no era..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:811
translate es qst_TheBeastOfNovaras_FlashbackBattleDeathLines_15d5a5cb:

    # SHYAHTAN "Not what happened."
    SHYAHTAN "No es lo que pasó."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:812
translate es qst_TheBeastOfNovaras_FlashbackBattleDeathLines_5d7e6c5c:

    # SHYAHTAN "Why? Why can't I remember?"
    SHYAHTAN "¿Por qué? ¿Por qué no puedo recordar?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:813
translate es qst_TheBeastOfNovaras_FlashbackBattleDeathLines_55ff7cac:

    # SHYAHTAN "Darkness... Darkness all around."
    SHYAHTAN "Oscuridad... Oscuridad por todas partes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:828
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_751e6058:

    # ZERO_ONE_FOUR_NINE "... Lord Shyahtan."
    ZERO_ONE_FOUR_NINE "... Lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:829
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_46631c27:

    # ZERO_ONE_FOUR_NINE "Your Zarpod is ready."
    ZERO_ONE_FOUR_NINE "Tu zarpod está listo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:830
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_1a2603d2:

    # SHYAHTAN "What is the status of the siege?"
    SHYAHTAN "¿Cuál es la situación del asedio?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:831
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_209eca19:

    # ZERO_ONE_FOUR_NINE "Their capital still holds."
    ZERO_ONE_FOUR_NINE "Su capital sigue resistiendo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:832
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_eba210aa:

    # ZERO_ONE_FOUR_NINE "Our Terran brothers have yet to breach the walls."
    ZERO_ONE_FOUR_NINE "Nuestros hermanos terranos aún no han logrado atravesar las murallas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:833
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_27786fe0:

    # ZERO_ONE_FOUR_NINE "It falls upon our clan to bring honor once more."
    ZERO_ONE_FOUR_NINE "Nos corresponde a nuestro clan devolver el honor una vez más."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:834
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_e3618b8d:

    # SHYAHTAN "As is always the way."
    SHYAHTAN "Como siempre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:835
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_06e54ca1:

    # "I rose from my seat, the neural link tendrils withdrawing from my arms back into the hull of the ship."
    "Me levanté de mi asiento, y los tentáculos del enlace neural se retiraron de mis brazos y volvieron al casco de la nave."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:836
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_a6e1d6db:

    # SHYAHTAN "How many of our kin stand ready to orbital drop?"
    SHYAHTAN "¿Cuántos de los nuestros están listos para el lanzamiento orbital?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:837
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_bb8ee9da:

    # ZERO_ONE_FOUR_NINE "Three thousand strong. Another ten thousand of the other clans already claw at the walls."
    ZERO_ONE_FOUR_NINE "Tres mil efectivos. Otros diez mil de los demás clanes ya arañan las murallas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:838
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_df2f8f41:

    # SHYAHTAN "{i}And the enemy?{/i}"
    SHYAHTAN "{i}¿Y el enemigo?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:839
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_5e022e8b:

    # ZERO_ONE_FOUR_NINE "Thirty thousand Merlanians man the defenses. Five thousand royal guard."
    ZERO_ONE_FOUR_NINE "Treinta mil merlanianos defienden las murallas. Cinco mil guardias reales."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:840
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_319a5e66:

    # "There was a pause."
    "Hubo una pausa."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:841
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_aee1f639:

    # ZERO_ONE_FOUR_NINE "{i}Shame… they would have sired fine warriors for us to convert.{/i}"
    ZERO_ONE_FOUR_NINE "{i}Qué pena… habrían engendrado excelentes guerreros para que los convirtiéramos.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:842
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_213c13a4:

    # SHYAHTAN "Their bodies will feed the young. Death does not excuse them from service."
    SHYAHTAN "Sus cuerpos alimentarán a las crías. La muerte no los exime de su servicio."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:843
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_cb5cb230:

    # ZERO_ONE_FOUR_NINE "Of course, my lord. Their artillery still holds the clans at bay."
    ZERO_ONE_FOUR_NINE "Por supuesto, mi señor. Su artillería sigue manteniendo a raya a los clanes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:844
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_bd6f0a03:

    # ZERO_ONE_FOUR_NINE "The Tarakan requests we prioritize their rail guns."
    ZERO_ONE_FOUR_NINE "Los tarakan solicita que demos prioridad a sus cañones de riel."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:845
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_a3a15569:

    # SHYAHTAN "The reinforcements will not be necessary."
    SHYAHTAN "Los refuerzos no serán necesarios."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:846
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_95eb463e:

    # SHYAHTAN "{b}The honor shall be ours alone.{/b}"
    SHYAHTAN "{b}El honor será solo nuestro.{/b}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:847
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_22b50137:

    # ZERO_ONE_FOUR_NINE "... What are your orders, my lord?"
    ZERO_ONE_FOUR_NINE "... ¿Cuáles son sus órdenes, mi señor?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:848
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_d8fc21fe:

    # SHYAHTAN "Alert the others. They follow me down."
    SHYAHTAN "Avisa a los demás. Que me sigan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:849
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_a5fd93d9:

    # ZERO_ONE_FOUR_NINE "Yes, Lord Shyahtan."
    ZERO_ONE_FOUR_NINE "Sí, lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:850
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_63e033c4:

    # "The officer pressed his palm to the hull."
    "El oficial presionó la palma de la mano contra el casco."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:852
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_3fd364ff:

    # "Tendrils erupted from the walls to pierce his flesh, carrying my orders to the others."
    "Los tentáculos brotaron de las paredes para perforar su carne, llevando mis órdenes a los demás."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:854
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_7d2c090c:

    # "I strode to the launch bay, where the fleshy maws of the Zarpods yawned open, their insides pulsing wetly with nervous anticipation."
    "Me dirigí a la bahía de lanzamiento, donde las fauces carnosas de los zarpods se abrían, con su interior palpitando húmedamente con nerviosa expectación."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:855
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_a34ed116:

    # "I climbed inside. Its walls throbbed around me, veins glowing faintly as my tendrils sank into its flesh."
    "Me metí dentro. Sus paredes palpitaban a mi alrededor, con venas que brillaban débilmente mientras mis tentáculos se hundían en su carne."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:856
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_2de5a45d:

    # "The bond was instant: its fear, its hunger, its obedience all became mine."
    "El vínculo fue instantáneo: su miedo, su hambre, su obediencia se convirtieron en míos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:857
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_3140e262:

    # SHYAHTAN "{i}Calm…{/i}"
    SHYAHTAN "{i}Calma…{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:858
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_37c2d7fc:

    # "{i}Zarpod rumbled in response...{/i}"
    "{i}Zarpod respondió con un gruñido....{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:859
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_dc0b2d02:

    # SHYAHTAN "Once more into battle."
    SHYAHTAN "Una vez más a la batalla."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:864
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_f7cdf5b6:

    # "The beast roared and hurled itself into the void."
    "La bestia rugió y se lanzó al vacío."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:865
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_e160f24e:

    # "Dozens, then hundreds followed, a swarm of living meteors plummeting toward the Merlanian world."
    "Primero fueron docenas, luego cientos, un enjambre de meteoros vivientes que se precipitaban hacia el mundo merlaniano."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:866
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_119954dc:

    # "The atmosphere screamed as we tore through it. Heat scorched the Zarpod's hide; fire licked its body until it glowed like a star."
    "La atmósfera gritó cuando la atravesamos. El calor abrasó la piel del zarpod; el fuego lamió su cuerpo hasta que brilló como una estrella."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:867
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_1550b613:

    # "Around me, others burned, their carcasses bursting into flaming shrapnel. But still we fell."
    "A mi alrededor, otros ardían, sus cadáveres estallaban en metralla llameante. Pero seguíamos cayendo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:868
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_af83a862:

    # "A railgun beam seared past, a line of blue death. One struck a kin to my left, annihilating him and his beast in a burst of ash."
    "Un rayo de cañón de riel pasó zumbando, una línea de muerte azul. Uno alcanzó a un compañero a mi izquierda, aniquilándolo a él y a su bestia en una explosión de cenizas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:869
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_4c6c0e65:

    # "Their screams joined the roar of re-entry. It did not matter."
    "Sus gritos se unieron al rugido del reingreso. No importaba."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:870
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_d1d140f9:

    # "{i}We had breached.{/i}"
    "{i}Habíamos atravesado.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:875
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_3631c7d6:

    # "The cities inner defences were little match for the speed of the Zarpod."
    "Las defensas internas de la ciudad no podían competir con la velocidad del zarpod."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:876
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_620e1748:

    # "If their orbital defences couldn't stop them, the desperate cannons built to defend against ground forces were far too slow."
    "Si sus defensas orbitales no pudieron detenerlos, los desesperados cañones construidos para defenderse de las fuerzas terrestres eran demasiado lentos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:877
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_249acc3e:

    # "The city, already hanging on by a thread from the assault outside, descended into full blown chaos."
    "La ciudad, que ya pendía de un hilo por el asalto exterior, se sumió en un caos total."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:878
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_b1f26c6f:

    # "My Zarpod slammed into a tower, stone shattering, fire blossoming."
    "Mi zarpod se estrelló contra una torre, la piedra se hizo añicos y el fuego estalló."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:879
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_c3886354:

    # "Rubble engulfed me as others crashed nearby, entire streets erased in a rain of monsters."
    "Los escombros me sepultaron mientras otros se estrellaban cerca, calles enteras desaparecían bajo una lluvia de monstruos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:881
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_26079cbf:

    # "Through smoke and dust, yellow-skinned Merlanian soldiers scrambled, their weapons trembling as they circled, hoping we had perished in the fall."
    "A través del humo y el polvo, los soldados merlanianos de piel amarilla se apresuraban, con sus armas temblando mientras nos rodeaban, esperando que hubiéramos perecido en la caída."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:882
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_1b228b8f:

    # "They shared anxious looks behind their visors, terrified at the strange, motionless creature before them."
    "Intercambiaron miradas de inquietud tras sus viseras, aterrorizados ante la extraña criatura inmóvil que tenían ante ellos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:883
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_ed58493e:

    # "Nervously, they took a brave step closer, and..."
    "Nerviosos, dieron un valiente paso hacia adelante y..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:885
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_de41726f:

    # "My Zarpod's tendrils exploded outward, skewering two, snapping their bodies like twigs."
    "Los tentáculos de mi zarpod se desplegaron hacia fuera, atravesando a dos de ellos y rompiéndoles el cuerpo como si fueran ramitas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:886
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_76eb6352:

    # "Their blood ran hot across the rubble as the beast roared triumphant."
    "Su sangre corría caliente por los escombros mientras la bestia rugía triunfante."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:887
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_ae51adcb:

    # "Those around screamed, fleeing the scene as they watched their finest warrior's blood and guts decorate the floor."
    "Los que estaban alrededor gritaron y huyeron del lugar al ver cómo la sangre y las vísceras de sus mejores guerreros decoraban el suelo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:888
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_59dc5101:

    # "Their bodies in their final moments still twitched, a foot here, a trembling hand there."
    "Sus cuerpos, en sus últimos momentos, aún se retorcían, un pie aquí, una mano temblorosa allá."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:889
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_2bb9fbd3:

    # "It mattered not, next time though, I would ensure my Zarpod focused more on the heads or piercing the hearts."
    "No importaba, la próxima vez me aseguraría de que mi zarpod se centrara más en las cabezas o en atravesar los corazones."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:890
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_6f4baf4e:

    # "{i}Quicker that way...{/i}"
    "{i}Así es más rápido....{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:897
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_f3b1b5bb:

    # "The alarms screamed as the building burned around me."
    "Las alarmas sonaban mientras el edificio ardía a mi alrededor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:898
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_8bce8ab4:

    # "My Zarpod turned its heads toward me, expectant, grumbling."
    "Mi zarpod giró la cabeza hacia mí, expectante, refunfuñando."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:899
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_950ff7d8:

    # SHYAHTAN "I sense a trap outside, be ready to provide air support."
    SHYAHTAN "Siento que hay una trampa ahí fuera, estad preparados para proporcionar apoyo aéreo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:906
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_72b4cc5b:

    # "It bowed and soared skyward as I marched into the city streets, my weapon humming with hunger."
    "Se inclinó y se elevó hacia el cielo mientras yo marchaba por las calles de la ciudad, con mi arma zumbando de ansia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:912
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_56c74ac9:

    # "There on the city streets, a Merlanian patrol swarmed me."
    "Allí, en las calles de la ciudad, una patrulla merlaniana me rodeó."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:913
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_f5aa81e4:

    # MERLANIAN "DEATH TO THE FALSE GODS!"
    MERLANIAN "¡MUERTE A LOS DIOSES FALSOS!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:914
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_27ac8b96:

    # "They raised their weapons ready to fire as the battle raged all around us."
    "Levantaron sus armas listas para disparar mientras la batalla se libraba a nuestro alrededor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:917
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_095b78da:

    # "Before their rounds could hit, my Zarpod slammed in front to take the brunt of the damage for me."
    "Antes de que sus disparos pudieran impactar, mi zarpod se interpuso delante para recibir el impacto por mí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:918
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_0e60cb8f:

    # "I plugged into the Zarpod's flesh, raising my flesheater as a few Merlanian warriors did their best to rush me."
    "Me conecté a la carne del zarpod, levantando mi devorador de carne mientras unos cuantos guerreros merlanianos hacían todo lo posible por abalanzarse sobre mí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:920
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_dd43f9da:

    # "The swarm shrieked as it erupted, devouring them to bone in the blink of an eye."
    "El enjambre chilló al estallar, devorándolos hasta los huesos en un abrir y cerrar de ojos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:921
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_32f83ba6:

    # "The hungry bugs quickly buzzed off when they were done, off to find someone else to eat."
    "Los insectos hambrientos se alejaron rápidamente zumbando cuando terminaron, en busca de otra presa."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:925
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_9f218650:

    # SHYAHTAN "I can take it alone from here."
    SHYAHTAN "Puedo encargarme yo solo a partir de aquí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:926
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_1e2065c8:

    # SHYAHTAN "Destroy their rail guns. I will open the gate."
    SHYAHTAN "Destruye sus cañones de riel. Yo abriré la puerta."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:933
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_29606faf:

    # "My Zarpod launched itself upwards into the sky once more, joining the others in the attack on the city's rail guns."
    "Mi zarpod se lanzó una vez más hacia el cielo, uniéndose a los demás en el ataque contra los cañones de riel de la ciudad."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:935
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_b1e50cfc:

    # "Rushing towards me, more Merlanian guards desperately charged in."
    "Corriendo hacia mí, más guardias merlanianos cargaron desesperadamente."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:938
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_211058d5:

    # MERLANIAN "Stop him! Open fire at will!"
    MERLANIAN "¡Detenedlo! ¡Abrid fuego a discreción!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:939
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_0e68d335:

    # SHYAHTAN "{i}Cute.{/i}"
    SHYAHTAN "{i}Adorable.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:943
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_7516928c:

    # "Overhead, I watched as some Zarpods slammed into one of the railguns, tearing the thing apart in their immense jaws as they let the wreck crash down onto the city below."
    "Desde arriba, vi cómo algunos zarpods se estrellaban contra uno de los cañones de riel, destrozándolo con sus enormes mandíbulas y dejando que los restos cayeran sobre la ciudad."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:944
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_86cd6962:

    # "A few of the Merlanians were still desperately trying to hold out, rallying to defend the gate to their precious capital from both the siege outside {i}and{/i} within."
    "Algunos merlanianos seguían resistiendo desesperadamente, reuniéndose para defender la puerta de su preciada capital tanto del asedio exterior {i}como{/i} del interior."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:945
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_664afd37:

    # "The leader among them, armored and bearing the marks of rank, screamed orders of air support: futile prayers to gods long deaf."
    "El líder entre ellos, blindado y con las marcas de su rango, gritaba órdenes de apoyo aéreo: inútiles plegarias a dioses sordos desde hacía mucho tiempo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:946
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_d71ba03d:

    # "He turned to me, weapon raised, and charged with a final cry."
    "Se giró hacia mí, con el arma en alto, y cargó contra mí con un último grito."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:947
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_5a060713:

    # MERLANIAN "FOR THE REPUBLIC!"
    MERLANIAN "¡POR LA REPÚBLICA!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:950
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_004cec4e:

    # "Before I could deliver the killing blow, a Zarpod slammed into the ground and devoured him whole."
    "Antes de que pudiera asestarle el golpe mortal, un zarpod se estrelló contra el suelo y lo devoró por completo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:952
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_bfc88bd5:

    # SHYAHTAN "How... {i}disappointing.{/i}"
    SHYAHTAN "Qué... {i}decepcionante.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:953
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_f602a0ea:

    # "What strange words he spoke. 'Republic'... I will have one of the captured explain its meaning later."
    "Qué palabras tan extrañas pronunció. 'República'... Más tarde haré que uno de los capturados me explique su significado."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:955
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_730ec02a:

    # "Another foolish name for another doomed system of rule."
    "Otro nombre absurdo para otro sistema de gobierno condenado al fracaso."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:959
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_436f6d45:

    # "With each conquest I learned."
    "Con cada conquista aprendí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:960
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_1b9c4780:

    # "Kings, queens, gods, emperors... so many words, so much foolishness."
    "Reyes, reinas, dioses, emperadores... tantas palabras, tanta tontería."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:961
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_7f15f82c:

    # "Why did they choose to refuse joining us Terrans?"
    "¿Por qué decidieron negarse a unirse a nosotros, los terranos?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:962
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_b1f1919a:

    # "Could they not see the fight was impossible?"
    "¿No veían que la lucha era imposible?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:963
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_db10681a:

    # "Could they not see the unity we offered?"
    "¿No pudieron ver la unidad que ofrecíamos?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:964
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_f088dcd2:

    # "Once their children were made Terran like us, they understood, {i}they became one.{/i}"
    "Una vez que sus hijos se convirtieron en terranos como nosotros, lo entendieron, {i}se hicieron uno.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:965
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_742a1873:

    # "It was always the same. We welcomed their lust, it was in our very nature to do so."
    "Siempre era lo mismo. Dábamos la bienvenida a su lujuria, estaba en nuestra propia naturaleza hacerlo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:966
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_0d82393d:

    # "...And they, no matter the race, could not resist."
    "...Y ellos, sin importar la raza, no pudieron resistirse."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:967
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_9f2bd1fe:

    # "A wise race accepted the end."
    "Una raza sabia aceptó el final."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:968
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_e82a6bb5:

    # "They accepted we would breed with them, that their children were perfect candidates to become Terrans, to merge with the sanja."
    "Aceptaron que nos reprodujéramos con ellos, que sus hijos eran candidatos perfectos para convertirse en terranos, para fusionarse con los sanja."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:969
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_e6a21265:

    # "Their worlds ended peacefully, joyously, as they served the Hive in mating and in rest."
    "Sus mundos terminaron pacíficamente, con alegría, mientras servían a la colmena en el apareamiento y el descanso."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:970
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_03795d2e:

    # "But some uncovered our truth too early. Some chose violence."
    "Pero algunos descubrieron nuestra verdad demasiado pronto. Algunos optaron por la violencia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:971
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_cee3c525:

    # "And when persuasion failed, violence always prevailed."
    "Y cuando la persuasión fallaba, siempre prevalecía la violencia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:972
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_fcc7d99d:

    # "As I watched my clansmen tear apart the last guards at the gate, the walls themselves fell."
    "Mientras veía a mis compañeros de clan destrozar a los últimos guardias de la puerta, las murallas se derrumbaron."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:973
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_ebe88814:

    # "Terrans clambered over, flooding the city in a tide of black flesh and steel."
    "Los terranos treparon por encima, inundando la ciudad con una marea de carne negra y acero."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:974
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_110c4481:

    # "There was nothing left now, except claim the final piece of glory."
    "Ahora no quedaba nada más que reclamar la última pieza de gloria."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:975
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_592cf2bc:

    # "Their leader. King, queen, it mattered not."
    "Su líder. Rey, reina, daba igual."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:976
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_4690d4b9:

    # "{i}I would return with their head.{/i}"
    "{i}Volvería con sus cabezas.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:979
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_a1792337:

    # "The last of them stood on the steps, decorative armor glinting."
    "El último de ellos se encontraba en los escalones, con su armadura decorativa reluciente."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:980
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_2df0c028:

    # "Royal guard. High guard. Whatever their name, they died the same."
    "Guardia real. Alta guardia. Sea cual sea su nombre, murieron de la misma manera."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:981
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_66cf6782:

    # "I had expected more. But only a handful remained, the rest fled like cowards."
    "Esperaba más. Pero solo quedaron unos pocos, el resto huyó como cobardes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:982
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_fa83589b:

    # "I would at least grant those who fought the mercy of a swift death."
    "Al menos concedería a los que lucharon la misericordia de una muerte rápida."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:983
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_d56f962b:

    # "The deserters I would leave to the flesheaters."
    "A los desertores los dejaría a merced de los devoradores de carne."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:984
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_50dfb77e:

    # "Ascending the steps, I pushed open the doors to their highest temple."
    "Subiendo los escalones, empujé las puertas para abrir el templo más alto."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:989
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_55c8284f:

    # "...This temple was not as expected."
    "...Este templo no era como esperaba."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:990
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_ec691a98:

    # "No cowering women. No warrior awaiting a last duel."
    "No había mujeres acobardadas. No había guerreros esperando un último duelo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:991
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_f6897fe4:

    # "Only a vast chamber, darkness broken by the blue glow of a circular pool."
    "Solo una amplia sala, la oscuridad rota por el resplandor azul de una piscina circular."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:993
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_3cb36d55:

    # "I stepped closer. The doors sealed behind me."
    "Me acerqué. Las puertas se cerraron detrás de mí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:995
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_8e538da2:

    # MYSTERIOUS_WOMAN "All hail... Shyahtan."
    MYSTERIOUS_WOMAN "Salve a... Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:997
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_699dd9a7:

    # "A frail figure emerged from the shadows, cloaked, circling the pool like a carrion bird."
    "Una frágil figura emergió de las sombras, envuelta en una capa, rodeando la piscina como un ave carroñera."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:998
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_68fbf483:

    # MYSTERIOUS_WOMAN "The lord of a thousand stars, master of the Black Terran clan."
    MYSTERIOUS_WOMAN "El señor de las mil estrellas, maestro del clan Terran negro."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:999
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_493edf5c:

    # SHYAHTAN "...Who are you, witch?"
    SHYAHTAN "...¿Quién eres tú, bruja?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1000
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_9141e277:

    # SHYAHTAN "How do you know my name?"
    SHYAHTAN "¿Cómo sabes mi nombre?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1001
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_c7965320:

    # MYSTERIOUS_WOMAN "Hahaha!"
    MYSTERIOUS_WOMAN "¡Jajaja!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1002
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_a67c7680:

    # MYSTERIOUS_WOMAN "I know many things, Shyahtan."
    MYSTERIOUS_WOMAN "Sé muchas cosas, Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1003
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_234d4038:

    # SHYAHTAN "Have you come to challenge me to battle?"
    SHYAHTAN "¿Has venido a desafiarme a un duelo?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1004
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_a5c0a3cf:

    # MYSTERIOUS_WOMAN "Oh dear..."
    MYSTERIOUS_WOMAN "Ay, cielos..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1005
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_edadd79f:

    # MYSTERIOUS_WOMAN "Always so preoccupied with the fight before you. You cannot see the war beyond."
    MYSTERIOUS_WOMAN "Siempre tan preocupado por la batalla que tienes delante. No puedes ver la guerra más allá."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1006
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_14af19a0:

    # SHYAHTAN "You speak in riddles."
    SHYAHTAN "Hablas con acertijos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1007
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_024a4834:

    # SHYAHTAN "Make sense, or I will peel your cackling head from your shoulders."
    SHYAHTAN "Habla con sentido, o te arrancaré la cabeza de tus hombros."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1008
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_3fbc8d8b:

    # MYSTERIOUS_WOMAN "I give you truth."
    MYSTERIOUS_WOMAN "Te digo la verdad."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1009
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_b7214c04:

    # MYSTERIOUS_WOMAN "The great Shyahtan will be destroyed by the one reflected in that pool."
    MYSTERIOUS_WOMAN "El gran Shyahtan será destruido por aquel que se refleja en ese estanque."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1010
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_ce742105:

    # "I looked at the water, then back to her."
    "Miré el agua y luego volví a mirarla."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1011
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_19630258:

    # SHYAHTAN "{i}Mockery?{/i}"
    SHYAHTAN "{i}¿Burla?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1012
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_128ebffb:

    # SHYAHTAN "Do you know what I will do to you, and the scraps of your people?"
    SHYAHTAN "¿Sabes lo que te haré a ti y a los restos de tu gente?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1013
translate es qst_TheBeastOfNovaras_ParasiteShipFlashback_904c64ce:

