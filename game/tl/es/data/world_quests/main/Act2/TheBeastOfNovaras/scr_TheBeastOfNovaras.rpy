    GUARD "Tú no."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1868
translate es qst_TheBeastOfNovaras_ZanzibatHouse_e4e67f64:

    # GUARD "{i}Him.{/i}"
    GUARD "{i}Él.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1869
translate es qst_TheBeastOfNovaras_ZanzibatHouse_539c85ab:

    # "A disgruntled Yarrick took a step back, flashing me an awkward smile."
    "Yarrick, descontento, dio un paso atrás y me dedicó una sonrisa incómoda."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1871
translate es qst_TheBeastOfNovaras_ZanzibatHouse_cb394247:

    # YARRICK @ smile "I shall see you around I hope?"
    YARRICK @ smile "¿Nos vemos por ahí, espero?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1872
translate es qst_TheBeastOfNovaras_ZanzibatHouse_9553e143:

    # YARRICK @ smile "Consider us even now."
    YARRICK @ smile "Considera que estamos igual ahora."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1878
translate es qst_TheBeastOfNovaras_ZanzibatHouse_3c99283f:

    # "I nodded lightly, before following the guard."
    "Asentí ligeramente con la cabeza antes de seguir al guardia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1886
translate es qst_TheBeastOfNovaras_ZanzibatHouse_9dd51684:

    # "Lord Zanzibat's home was unexpected. Ornate, and yet, plants, trees... A flowing stream of water through the centre."
    "La casa de lord Zanzibat era inesperada. Ornamentada y, sin embargo, con plantas, árboles... Un arroyo que fluía por el centro."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1887
translate es qst_TheBeastOfNovaras_ZanzibatHouse_4502d254:

    # "It was more like standing inside a garden in the middle of the desert than it was a home."
    "Era más como estar dentro de un jardín en medio del desierto que en una casa."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1888
translate es qst_TheBeastOfNovaras_ZanzibatHouse_0de86d18:

    # "As I heard the clap of hands, I turned towards Lord Zanzibat."
    "Al oír el aplauso, me giré hacia lord Zanzibat."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1891
translate es qst_TheBeastOfNovaras_ZanzibatHouse_813bc6bc:

    # "Lord Zanzibat was not a towering figure, rather he was skinny, almost effeminate."
    "Lord Zanzibat no era una figura imponente, sino más bien delgado, casi afeminado."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1892
translate es qst_TheBeastOfNovaras_ZanzibatHouse_f215eac7:

    # ZANZIBAT @ smile "I had many of them imported from Sylvania."
    ZANZIBAT @ smile "Hice importar muchos de ellos desde Sylvania."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1893
translate es qst_TheBeastOfNovaras_ZanzibatHouse_1dce7595:

    # ZANZIBAT @ smile "It cost me a fortune of course, but..."
    ZANZIBAT @ smile "Me costó una fortuna, por supuesto, pero..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1894
translate es qst_TheBeastOfNovaras_ZanzibatHouse_e2b29dc5:

    # ZANZIBAT @ smile "I find they bring me great comfort."
    ZANZIBAT @ smile "Me reconfortan mucho."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1895
translate es qst_TheBeastOfNovaras_ZanzibatHouse_95ffb076:

    # MC @ talk "Lord Zanzibat."
    MC @ talk "Lord Zanzibat."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1897
translate es qst_TheBeastOfNovaras_ZanzibatHouse_5033cf1d:

    # "I gave a curtly bow."
    "Hice una breve reverencia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1898
translate es qst_TheBeastOfNovaras_ZanzibatHouse_938a175d:

    # MC @ talk "You honour me with this meeting."
    MC @ talk "Me honra con esta reunión."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1899
translate es qst_TheBeastOfNovaras_ZanzibatHouse_7d53c472:

    # ZANZIBAT @ talk "Well, how could I resist a chance to meet the saviour of Novaras?"
    ZANZIBAT @ talk "Bueno, ¿cómo podría resistirme a la oportunidad de conocer al salvador de Novaras?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1900
translate es qst_TheBeastOfNovaras_ZanzibatHouse_9421f81a:

    # ZANZIBAT @ talk "And especially after that arena performance..."
    ZANZIBAT @ talk "Y especialmente después de esa actuación en la arena..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1901
translate es qst_TheBeastOfNovaras_ZanzibatHouse_06bfc572:

    # MC @ smile "It was a little closer than I would have liked."
    MC @ smile "Estuvo un poco más reñido de lo que me hubiera gustado."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1902
translate es qst_TheBeastOfNovaras_ZanzibatHouse_192088ef:

    # ZANZIBAT @ smile "Mmm... I did think for a moment your blood might spill on the sands."
    ZANZIBAT @ smile "Mmm... Por un momento pensé que tu sangre se derramaría sobre la arena."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1903
translate es qst_TheBeastOfNovaras_ZanzibatHouse_f00b249b:

    # ZANZIBAT @ smile "But that rage at the end... It was..."
    ZANZIBAT @ smile "Pero esa rabia al final... fue..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1904
translate es qst_TheBeastOfNovaras_ZanzibatHouse_88c629bd:

    # ZANZIBAT @ smile "Spectacular."
    ZANZIBAT @ smile "Espectacular."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1905
translate es qst_TheBeastOfNovaras_ZanzibatHouse_d96919ec:

    # "That rage... That blinding hot rage where my body moved without me, where the dark passenger – Shyahtan or whatever his name was, took full control."
    "Esa ira... Esa ira cegadora y ardiente en la que mi cuerpo se movía sin mí, en la que el oscuro pasajero, Shyahtan o como se llamara, tomó el control total."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1906
translate es qst_TheBeastOfNovaras_ZanzibatHouse_530f4eb0:

    # "I couldn't help but feel... Uncomfortable by the thought."
    "No pude evitar sentirme... incómodo ante esa idea."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1907
translate es qst_TheBeastOfNovaras_ZanzibatHouse_6549fa11:

    # MC @ talk "... I've come here to ask something of you."
    MC @ talk "... He venido aquí para pedirte algo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1908
translate es qst_TheBeastOfNovaras_ZanzibatHouse_e858e11e:

    # ZANZIBAT @ smile "Oh, this is a first."
    ZANZIBAT @ smile "Oh, esto es una novedad."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1909
translate es qst_TheBeastOfNovaras_ZanzibatHouse_6b05abff:

    # ZANZIBAT @ talk "Normally, I make the offer and let you think on it."
    ZANZIBAT @ talk "Normalmente, yo hago la oferta y te dejo que lo pienses."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1910
translate es qst_TheBeastOfNovaras_ZanzibatHouse_8997b2f2:

    # ZANZIBAT @ talk "Now you have my attention, what is it you want?"
    ZANZIBAT @ talk "Ahora que tienes mi atención, ¿qué es lo que quieres?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1911
translate es qst_TheBeastOfNovaras_ZanzibatHouse_d934f6d3:

    # MC @ talk "You're one of the last barriers blocking the deal between Novaras and the Greater Trading Company... I want you to let it pass."
    MC @ talk "Eres uno de los últimos obstáculos que impiden el acuerdo entre Novaras y la Gran Compañía Comercial... Quiero que lo dejes pasar."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1912
translate es qst_TheBeastOfNovaras_ZanzibatHouse_443ecd71:

    # "Lord Zanzibat considered my words carefully as he slowly paced around the room, gently brushing his hand along one of the plants."
    "Lord Zanzibat consideró cuidadosamente mis palabras mientras caminaba lentamente por la habitación, acariciando suavemente con la mano una de las plantas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1913
translate es qst_TheBeastOfNovaras_ZanzibatHouse_61aa857f:

    # ZANZIBAT @ talk "Tell me... do you know why Hamun is still free?"
    ZANZIBAT @ talk "Dime... ¿sabes por qué Hamun sigue libre?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1914
translate es qst_TheBeastOfNovaras_ZanzibatHouse_37dad121:

    # MC @ talk "Because no side dares try to conquer it yet?"
    MC @ talk "¿Porque aún ningún bando se atreve aún a intentar conquistarlo?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1915
translate es qst_TheBeastOfNovaras_ZanzibatHouse_f7524e3f:

    # ZANZIBAT @ smile "In part. But the truth is simpler: Hamun sells its table to *all* sides, and takes none."
    ZANZIBAT @ smile "En parte. Pero la verdad es más simple: Hamun vende su mesa a *todas* las partes y no se queda con ninguna."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1916
translate es qst_TheBeastOfNovaras_ZanzibatHouse_c0766e48:

    # ZANZIBAT @ smile "Kings, rebels, merchants, priests, each can bargain here."
    ZANZIBAT @ smile "Reyes, rebeldes, comerciantes, sacerdotes, todos pueden negociar aquí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1917
translate es qst_TheBeastOfNovaras_ZanzibatHouse_0ae0fa98:

    # ZANZIBAT @ smile "That is our shield."
    ZANZIBAT @ smile "Ese es nuestro escudo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1918
translate es qst_TheBeastOfNovaras_ZanzibatHouse_bfc3b19b:

    # ZANZIBAT @ serious "The Greater Trading Company would break that balance."
    ZANZIBAT @ serious "La Gran Compañía Comercial rompería ese equilibrio."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1919
translate es qst_TheBeastOfNovaras_ZanzibatHouse_c263fb66:

    # ZANZIBAT @ serious "They are not merchants, they are parasites."
    ZANZIBAT @ serious "No son comerciantes, son parásitos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1920
translate es qst_TheBeastOfNovaras_ZanzibatHouse_686f45a6:

    # ZANZIBAT @ serious "Once they take root, they twist every throne they touch."
    ZANZIBAT @ serious "Una vez que echan raíces, retuercen todos los tronos que tocan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1921
translate es qst_TheBeastOfNovaras_ZanzibatHouse_86307e7e:

    # ZANZIBAT @ talk "Do you know the fate of the People of Wei?"
    ZANZIBAT @ talk "¿Conoces el destino del pueblo de Wei?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1922
translate es qst_TheBeastOfNovaras_ZanzibatHouse_11d4edaf:

    # ZANZIBAT @ talk "In less than fifty years, the GTC bought their land, scattered their bloodline, and sold the survivors on the backs of Paruh beasts."
    ZANZIBAT @ talk "En menos de cincuenta años, el GCC compró sus tierras, dispersó su linaje y vendió a los supervivientes a lomos de bestias Paruh."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1923
translate es qst_TheBeastOfNovaras_ZanzibatHouse_e72be1c9:

    # ZANZIBAT @ smile "So tell me... why should I welcome that fate here?"
    ZANZIBAT @ smile "Entonces dime... ¿por qué debería aceptar ese destino aquí?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1930
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_350fd090:

    # ZANZIBAT @ talk "It shall, but it's the difference between the deal passing in the next three months and the next three years."
    ZANZIBAT @ talk "Sí, pero es la diferencia entre que el acuerdo se apruebe en los próximos tres meses o en los próximos tres años."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1934
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_d3c8843a:

    # ZANZIBAT @ talk "I have had dealings with them in the past."
    ZANZIBAT @ talk "He tratado con ellos en el pasado."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1935
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_d466e272:

    # ZANZIBAT @ talk "None of which have ended well... For anyone involved."
    ZANZIBAT @ talk "Ninguno de ellos ha terminado bien... Para nadie de los involucrados."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1936
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_8de44649:

    # ZANZIBAT @ talk "You would do well to be parted from their 'business' as soon as you can."
    ZANZIBAT @ talk "Sería conveniente que te separaras de sus 'negocios' tan pronto como puedas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1941
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_3f011ce2:

    # MC "Then what would it take to persuade you?"
    MC "Entonces, ¿qué haría falta para convencerte?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1942
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_c21c67dc:

    # ZANZIBAT @ talk "... Hmm."
    ZANZIBAT @ talk "... Hmm."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1943
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_9fdbb0e5:

    # ZANZIBAT @ talk "The shipping rights."
    ZANZIBAT @ talk "Los derechos de transporte."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1944
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_bde6c2b6:

    # MC @ think "What?"
    MC @ think "¿Qué?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1945
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_9e7a2320:

    # ZANZIBAT @ talk "I want them to agree to only use my ships to transport the goods from Alderay to Skarshire and vice versa."
    ZANZIBAT @ talk "Quiero que acepten utilizar mis barcos únicamente para transportar mercancías de Alderay a Skarshire y viceversa."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1946
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_3f36b076:

    # MC @ serious "For someone so against them, you seem more than ready to jump into business with them again."
    MC @ serious "Para alguien tan en contra de ellos, pareces más que dispuesto a volver a hacer negocios con ellos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1947
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_483cf438:

    # ZANZIBAT @ smile "It's as the old proverb says."
    ZANZIBAT @ smile "Es como dice el viejo proverbio."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1948
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_f5dd4b8d:

    # ZANZIBAT @ talk "{i}Keep your friends close, and keep your enemies even closer.{/i}"
    ZANZIBAT @ talk "{i}Mantén cerca a tus amigos y aún más cerca a tus enemigos.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1958
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_a872cabc:

    # ZANZIBAT @ talk "Tell the GTC my answer."
    ZANZIBAT @ talk "Comuníquele mi respuesta al GCC."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1951
translate es qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_a72b3584:

    # ZANZIBAT @ talk "{i}I will expect the agreement in writing... and on their god.{/i}"
    ZANZIBAT @ talk "{i}Esperaré el acuerdo por escrito... y por su Dios.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1960
translate es qst_TheBeastOfNovaras_TalkToGarenBar_0a1e03ae:

    # GAREN "Can I help you with something?"
    GAREN "¿Puedo ayudarte en algo?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1963
translate es qst_TheBeastOfNovaras_TalkToGarenBar_66b0402a:

    # GAREN @ think "Go on?"
    GAREN @ think "¿Sigue?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1964
translate es qst_TheBeastOfNovaras_TalkToGarenBar_fb0e6d2b:

    # MC @ talk "He will step aside and allow the deal to pass {i}if{/i} his ships are used to transport the cargo to and from Skarshire."
    MC @ talk "Se apartará y permitirá que se apruebe el acuerdo {i}si{/i} sus barcos se utilizan para transportar la carga hacia y desde Skarshire."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1965
translate es qst_TheBeastOfNovaras_TalkToGarenBar_995dd8b9:

    # GAREN @ smile "... Very well, I shall arrange the papers for him."
    GAREN @ smile "... Muy bien, le prepararé los papeles."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1966
translate es qst_TheBeastOfNovaras_TalkToGarenBar_4ee67eb4:

    # MC @ think "Just like that?"
    MC @ think "¿Así sin más?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1967
translate es qst_TheBeastOfNovaras_TalkToGarenBar_4fb6e909:

    # MC @ think "No bartering, no negotiation?"
    MC @ think "¿Sin regateos, sin negociaciones?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1968
translate es qst_TheBeastOfNovaras_TalkToGarenBar_d8251d85:

    # GAREN @ smile "The desert fox has made his offer."
    GAREN @ smile "El zorro del desierto ha hecho su oferta."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1969
translate es qst_TheBeastOfNovaras_TalkToGarenBar_58c3d475:

    # GAREN @ smile "I am sure he will obsess over every word of the papers I send, but within a few days at the most we will conclude our business."
    GAREN @ smile "Estoy seguro de que se obsesionará con cada palabra de los documentos que le envíe, pero en unos días como máximo concluiremos nuestro acuerdo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1970
translate es qst_TheBeastOfNovaras_TalkToGarenBar_edbe0460:

    # MC @ talk "How can you be so sure?"
    MC @ talk "¿Cómo puedes estar tan seguro?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1971
translate es qst_TheBeastOfNovaras_TalkToGarenBar_00346b84:

    # GAREN @ talk "Because despite his hatred of us, he's always more than willing to do business with us."
    GAREN @ talk "Porque, a pesar de su odio hacia nosotros, siempre está más que dispuesto a hacer negocios con nosotros."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1972
translate es qst_TheBeastOfNovaras_TalkToGarenBar_11568e73:

    # GAREN @ talk "It is a game to him, I believe, to see if he can outsmart us."
    GAREN @ talk "Creo que para él es un juego ver si puede burlarnos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1973
translate es qst_TheBeastOfNovaras_TalkToGarenBar_69989a6a:

    # MC @ think "If you're just giving him everything he wants, doesn't that mean he's already won?"
    MC @ think "Si solo le estás dando todo lo que quiere, ¿no significa eso que ya ha ganado?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1974
translate es qst_TheBeastOfNovaras_TalkToGarenBar_903ddcb0:

    # GAREN @ smile "{i}Only if he can keep to his end of the bargain.{/i}"
    GAREN @ smile "{i}Solo si él puede cumplir con su parte del trato.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1975
translate es qst_TheBeastOfNovaras_TalkToGarenBar_2192f037:

    # MC @ think "What do you mean by that?"
    MC @ think "¿Qué quieres decir con eso?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1976
translate es qst_TheBeastOfNovaras_TalkToGarenBar_252641ae:

    # GAREN @ talk "{i}We are bound only by the wording of our contract... Nothing more.{/i}"
    GAREN @ talk "{i}Solo estamos obligados por lo que dice nuestro contrato... Nada más.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1977
translate es qst_TheBeastOfNovaras_TalkToGarenBar_6a444706:

    # GAREN @ smile "If you have a moment, I could humour you with a tale."
    GAREN @ smile "Si tienes un momento, podría entretenerte con una historia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1980
translate es qst_TheBeastOfNovaras_TalkToGarenBar_2cff701a:

    # GAREN @ talk "There was once a lord who swore, if we armed him and filled his ranks with our mercenaries, he would crush his rival within the year."
    GAREN @ talk "Había una vez un señor que juró que, si lo armábamos y llenábamos sus filas con nuestros mercenarios, aplastaría a su rival en menos de un año."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1981
translate es qst_TheBeastOfNovaras_TalkToGarenBar_6884319c:

    # GAREN @ talk "Payment was guaranteed. And if not, his castle would be ours."
    GAREN @ talk "El pago estaba garantizado. Y si no, su castillo sería nuestro."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1982
translate es qst_TheBeastOfNovaras_TalkToGarenBar_4dd2ec1a:

    # GAREN @ talk "A bold deal. Too bold. Because his rival came to us with the very same request."
    GAREN @ talk "Un trato audaz. Demasiado audaz. Porque su rival acudió a nosotros con la misma petición."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1983
translate es qst_TheBeastOfNovaras_TalkToGarenBar_e47a45b8:

    # MC @ surprised "Surely that's a conflict of interest?"
    MC @ surprised "¿No es eso un conflicto de intereses?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1984
translate es qst_TheBeastOfNovaras_TalkToGarenBar_869b5883:

    # GAREN @ smile "Not if the contract doesn't forbid it."
    GAREN @ smile "No, si el contrato no lo prohíbe."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1985
translate es qst_TheBeastOfNovaras_TalkToGarenBar_ff958f57:

    # GAREN @ talk "So we sold both sides weapons. We took both their coin. And when their coffers ran dry... we took collateral."
    GAREN @ talk "Así que vendimos armas a ambos bandos. Aceptamos el dinero de ambos. Y cuando sus arcas se vaciaron... tomamos garantías."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1986
translate es qst_TheBeastOfNovaras_TalkToGarenBar_f88c955e:

    # GAREN @ talk "First land. Then blood. Piece by piece, both lords fed us their realms rather than admit defeat."
    GAREN @ talk "Primero la tierra. Luego la sangre. Poco a poco, ambos señores nos alimentaron con sus reinos antes que admitir la derrota."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1987
translate es qst_TheBeastOfNovaras_TalkToGarenBar_5078ca82:

    # GAREN @ smile "By the second year, neither could pay another coin. One was hanged in the square. The other drowned in his own bath."
    GAREN @ smile "Al segundo año, ninguno de los dos podía pagar otra moneda. Uno fue ahorcado en la plaza. El otro se ahogó en su propia bañera."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1988
translate es qst_TheBeastOfNovaras_TalkToGarenBar_0f8d033b:

    # MC @ scared "... That's monstrous."
    MC @ scared "... Eso es monstruoso."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1989
translate es qst_TheBeastOfNovaras_TalkToGarenBar_564c8dd2:

    # GAREN @ think "Is it? They could have stopped. Pride kept them blind."
    GAREN @ think "¿De verdad? Podrían haberlo evitado. El orgullo los cegó."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1990
translate es qst_TheBeastOfNovaras_TalkToGarenBar_14d8e3ee:

    # GAREN @ smile "That is the true lesson: greed makes men puppets, and we hold the strings."
    GAREN @ smile "Esa es la verdadera lección: la codicia convierte a los hombres en marionetas, y nosotros movemos los hilos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1994
translate es qst_TheBeastOfNovaras_TalkToGarenBar_106b3d3e:

    # GAREN @ smile "Of course, another time perhaps."
    GAREN @ smile "Por supuesto, quizá en otra ocasión."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1998
translate es qst_TheBeastOfNovaras_TalkToGarenBar_cd7f5b31:

    # GAREN @ talk "Until the ink meets the page then."
    GAREN @ talk "Hasta que la tinta toque el papel, entonces."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2002
translate es qst_TheBeastOfNovaras_TalkToGarenBar_e8b55b4e:

    # GAREN @ smile "You have done well here."
    GAREN @ smile "Lo has hecho muy bien aquí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2003
translate es qst_TheBeastOfNovaras_TalkToGarenBar_d452e86b:

    # MC @ think "All this trouble... Why not just ask Lord Zanzibat yourselves?"
    MC @ think "Todo este lío... ¿Por qué no simplemelte preguntar a lord Zanzibat?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2004
translate es qst_TheBeastOfNovaras_TalkToGarenBar_7ee32d5e:

    # MC @ think "Why use me?"
    MC @ think "¿Por qué recurrir a mí?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2005
translate es qst_TheBeastOfNovaras_TalkToGarenBar_b540657a:

    # GAREN @ talk "Because Lord Zanzibat only plays the {i}great game{/i} on his terms."
    GAREN @ talk "Porque l lord Zanzibat solo juega al {i}gran juego{/i} según sus propias reglas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2006
translate es qst_TheBeastOfNovaras_TalkToGarenBar_d1abcf29:

    # GAREN @ talk "He would {i}expect{/i} some kind of enticing offer to even bring him to the table."
    GAREN @ talk "{i}Esperaría{/i} algún tipo de oferta atractiva para siquiera sentarse a la mesa."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2007
translate es qst_TheBeastOfNovaras_TalkToGarenBar_d6e1ac52:

    # GAREN @ talk "...And."
    GAREN @ talk "... y."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2008
translate es qst_TheBeastOfNovaras_TalkToGarenBar_4e56044d:

    # "Garen's face slowly shifts into a smile without any warmth."
    "El rostro de Garen se transforma lentamente en una sonrisa sin calidez alguna."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2009
translate es qst_TheBeastOfNovaras_TalkToGarenBar_83130464:

    # GAREN @ smile "The Greater Trading Company is always looking for new assets."
    GAREN @ smile "La Gran Compañía Comercial siempre está buscando nuevos activos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2010
translate es qst_TheBeastOfNovaras_TalkToGarenBar_8455a15f:

    # GAREN @ smile "{i}You are so far proving yourself a valuable asset.{/i}"
    GAREN @ smile "{i}Hasta ahora estás demostrando ser un activo muy valioso.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2011
translate es qst_TheBeastOfNovaras_TalkToGarenBar_9429e63d:

    # GAREN @ talk "I shall return soon after I handle Lord Zanzibat."
    GAREN @ talk "Volveré pronto, en cuanto me ocupe de lord Zanzibat."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2012
translate es qst_TheBeastOfNovaras_TalkToGarenBar_736ebcd9:

    # MC @ think "What am I to do until then?"
    MC @ think "¿Qué voy a hacer hasta entonces?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2013
translate es qst_TheBeastOfNovaras_TalkToGarenBar_a513ccf1:

    # GAREN @ talk "Whatever you so desire."
    GAREN @ talk "Lo que desees."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2023
translate es qst_TheBeastOfNovaras_TalkToGarenBar_f1c8b685:

    # GAREN @ talk "{i}... The GTC is pleased with your progress.{/i}"
    GAREN @ talk "{i}... La GCC está satisfecha con su progreso.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2015
translate es qst_TheBeastOfNovaras_TalkToGarenBar_2cc04117:

    # GAREN @ talk "{i}Good work.{/i}"
    GAREN @ talk "{i}Buen trabajo.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2018
translate es qst_TheBeastOfNovaras_TalkToGarenBar_1a65813e:

    # "With a small, curtly tilt of his head towards me, Garen Quiltshire left {i}The Pale Dragon.{/i}"
    "Con un pequeño y seco movimiento de cabeza hacia mí, Garen Quiltshire abandonó {i}el dragón pálido.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2018
translate es qst_TheBeastOfNovaras_TalkToGarenBar_d47561b9:

    # "Once more, leaving me without direction."
    "Una vez más, dejándome sin rumbo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2019
translate es qst_TheBeastOfNovaras_TalkToGarenBar_695d4c57:

    # "As I stood there directionless I felt the brush of a soft hand on the back of my arm."
    "Mientras permanecía allí sin saber qué hacer, sentí el roce de una mano suave en la parte posterior de mi brazo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2021
translate es qst_TheBeastOfNovaras_TalkToGarenBar_7506c8bd:

    # "Sypha appeared alongside me, smiling softly."
    "Sypha apareció a mi lado, sonriendo suavemente."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2022
translate es qst_TheBeastOfNovaras_TalkToGarenBar_ed3729c1:

    # SYPHA @ happy "You and I."
    SYPHA @ happy "Tú y yo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2023
translate es qst_TheBeastOfNovaras_TalkToGarenBar_f33904df:

    # SYPHA @ happy "Tonight... we slip away."
    SYPHA @ happy "Esta noche... nos escapamos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2024
translate es qst_TheBeastOfNovaras_TalkToGarenBar_8ec2dc43:

    # SYPHA @ happy "{i}Just the two of us.{/i}"
    SYPHA @ happy "{i}Solo nosotros dos.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2025
translate es qst_TheBeastOfNovaras_TalkToGarenBar_64b99b7e:

    # MC @ think "I thought you would still be angry with me?"
    MC @ think "Pensé que todavía estarías enfadada conmigo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2026
translate es qst_TheBeastOfNovaras_TalkToGarenBar_b58f3630:

    # SYPHA @ happy "Oh, I am."
    SYPHA @ happy "Oh, sí, lo estoy."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2027
translate es qst_TheBeastOfNovaras_TalkToGarenBar_f9cd6c18:

    # SYPHA @ happy "But anger burns bright... and bright flames can be put to better use, don't you think?"
    SYPHA @ happy "Pero la ira arde con fuerza... y las llamas intensas se pueden aprovechar mejor, ¿no crees?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2028
translate es qst_TheBeastOfNovaras_TalkToGarenBar_5994274b:

    # MC @ think "You change your mind quickly."
    MC @ think "Cambias de opinión rápidamente."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2029
translate es qst_TheBeastOfNovaras_TalkToGarenBar_544cdd6c:

    # "A soft, coy smile curved on her lips, eyes gleaming with something equal parts danger and desire."
    "Una sonrisa suave y tímida se dibujó en sus labios, con los ojos brillantes por una mezcla de peligro y deseo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2030
translate es qst_TheBeastOfNovaras_TalkToGarenBar_342f3455:

    # SYPHA @ happy "There's a night market. Music, smoke, secrets for sale."
    SYPHA @ happy "Hay un mercado nocturno. Música, humo, secretos a la venta."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2031
translate es qst_TheBeastOfNovaras_TalkToGarenBar_4690fb80:

    # SYPHA @ happy "Meet me there after dark, and I'll give you what you're craving."
    SYPHA @ happy "Reúnete conmigo allí cuando oscurezca y te daré lo que tanto deseas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2032
translate es qst_TheBeastOfNovaras_TalkToGarenBar_93d92d0b:

    # MC @ serious "Answers?"
    MC @ serious "¿Respuestas?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2033
translate es qst_TheBeastOfNovaras_TalkToGarenBar_cf587495:

    # SYPHA @ happy "Some answers... some temptations."
    SYPHA @ happy "Algunas respuestas... algunas tentaciones."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2034
translate es qst_TheBeastOfNovaras_TalkToGarenBar_29779741:

    # SYPHA @ happy "Enough to keep you coming back for more."
    SYPHA @ happy "Suficiente para que vuelvas a por más."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2035
translate es qst_TheBeastOfNovaras_TalkToGarenBar_1b15e7ec:

    # "She brushed herself along my arm deliberately, her breath hot against my ear."
    "Se rozó deliberadamente contra mi brazo, con su aliento caliente en mi oído."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2036
translate es qst_TheBeastOfNovaras_TalkToGarenBar_a691ecc2:

    # SYPHA @ perv "Don't be late... {i}dear.{/i}"
    SYPHA @ perv "No llegues tarde... {i}cariño.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2038
translate es qst_TheBeastOfNovaras_TalkToGarenBar_cacf25ce:

    # MC @ serious "(Well... I have some time before Garen returns.)"
    MC @ serious "(Bueno... tengo algo de tiempo antes de que vuelva Garen)."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2039
translate es qst_TheBeastOfNovaras_TalkToGarenBar_00dfcaa0:

    # MC @ serious "(I should tread careful with this Sypha, she's no doubt toying with me.)"
    MC @ serious "(Debo tener cuidado con Sypha, sin duda está jugando conmigo)."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2040
translate es qst_TheBeastOfNovaras_TalkToGarenBar_c1b28386:

    # MC "(If she has answers, I need them. No matter the cost.)"
    MC "(Si ella tiene respuestas, las necesito. No importa el costo)."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2051
translate es qst_TheBeastOfNovaras_SyphaDate_ed8e5e7f:

    # SYPHA @ happy "Ahh, you've arrived!"
    SYPHA @ happy "¡Ah, ya has llegado!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2052
translate es qst_TheBeastOfNovaras_SyphaDate_77de5cb1:

    # SYPHA @ angry "{i}And you made me wait.{/i}"
    SYPHA @ angry "{i}Y me hiciste esperar.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2053
translate es qst_TheBeastOfNovaras_SyphaDate_50a0b7a7:

    # SYPHA @ angry "I {b}hate{/b} to be made to wait."
    SYPHA @ angry "{b}Odio{/b} que me hagan esperar."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2054
translate es qst_TheBeastOfNovaras_SyphaDate_1486f1ec:

    # MC @ serious "I'm here now, aren't I?"
    MC @ serious "Ahora estoy aquí, ¿no?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2055
translate es qst_TheBeastOfNovaras_SyphaDate_a74f8854:

    # "Sypha pouted, before wrapping her arm around mine and smiling once more."
    "Sypha hizo un puchero, antes de rodearme con el brazo y sonreír una vez más."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2056
translate es qst_TheBeastOfNovaras_SyphaDate_8a1cf5f6:

    # SYPHA @ happy "Come then, show me what you humans have to offer."
    SYPHA @ happy "Vamos, muéstrame lo que los humanos tienen para ofrecer."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2057
translate es qst_TheBeastOfNovaras_SyphaDate_9a155406:

    # "Sypha dragged me eagerly from stall to stall, tugging at my arm whenever something shiny caught her eye."
    "Sypha me arrastraba con entusiasmo de puesto en puesto, tirándome del brazo cada vez que algo brillante le llamaba la atención."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2058
translate es qst_TheBeastOfNovaras_SyphaDate_2a3d09e8:

    # "She was strangely inquisitive, asking about various trinkets as though every bauble might hide some secret."
    "Era extrañamente curiosa, preguntaba por diversas baratijas como si cada una de ellas pudiera esconder algún secreto."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2059
translate es qst_TheBeastOfNovaras_SyphaDate_d3219b93:

    # "A particular jeweled locket caught her attention."
    "Un medallón con joyas en particular llamó su atención."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2060
translate es qst_TheBeastOfNovaras_SyphaDate_16d10883:

    # SYPHA @ think "What purpose does this serve?"
    SYPHA @ think "¿Para qué sirve esto?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2061
translate es qst_TheBeastOfNovaras_SyphaDate_1bd24308:

    # MERCHANT "Ahhh! A fine choice, my lady."
    MERCHANT "¡Ahhh! Una excelente elección, mi señorita."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2062
translate es qst_TheBeastOfNovaras_SyphaDate_b2281b8b:

    # MERCHANT "That is a lovers locket."
    MERCHANT "Es un medallón para enamorados."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2063
translate es qst_TheBeastOfNovaras_SyphaDate_3b6a1ede:

    # MERCHANT "It separates into two pieces, for each lover to wear."
    MERCHANT "Se separa en dos piezas, para que cada amante pueda llevarla."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2064
translate es qst_TheBeastOfNovaras_SyphaDate_74448ac5:

    # MERCHANT "Some Ramonians give expensive ones such as these to their wives alongside a dowry."
    MERCHANT "Algunos ramonianos regalan a sus esposas artículos caros como estos junto con la dote."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2065
translate es qst_TheBeastOfNovaras_SyphaDate_f999aa8b:

    # SYPHA @ think "How much?"
    SYPHA @ think "¿Cuánto cuesta?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2066
translate es qst_TheBeastOfNovaras_SyphaDate_3b503c7b:

    # MERCHANT "Normally, this would go for a few thousand at least!"
    MERCHANT "Normalmente, ¡esto costaría al menos unos cuantos miles!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2067
translate es qst_TheBeastOfNovaras_SyphaDate_116d25da:

    # MERCHANT "For you though, only a thousand coins!"
    MERCHANT "¡Pero para ti, solo mil monedas!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2068
translate es qst_TheBeastOfNovaras_SyphaDate_e4120522:

    # "In a heartbeat, Sypha turned towards me, eyes glittering."
    "En un abrir y cerrar de ojos, Sypha se giró hacia mí con los ojos brillantes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2069
translate es qst_TheBeastOfNovaras_SyphaDate_b9c143e4:

    # SYPHA @ happy "Buy it."
    SYPHA @ happy "Cómpralo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2070
translate es qst_TheBeastOfNovaras_SyphaDate_631898f9:

    # SYPHA @ happy "I want it."
    SYPHA @ happy "Lo quiero."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2075
translate es qst_TheBeastOfNovaras_SyphaDate_marketmenu_34223095:

