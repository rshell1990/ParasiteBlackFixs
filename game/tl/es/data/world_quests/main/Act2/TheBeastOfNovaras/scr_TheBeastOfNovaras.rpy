# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:86
translate es qst_TheBeastOfNovaras_BarSceneShared_9a084ce5:

    # "The Demorai woman stood as though she owned the air itself, her confidence a blade sharper than anything on my hip."
    "La mujer demorai se erguía como si fuera la dueña del aire, con una confianza más afilada que cualquier espada que pudiera llevar en la cintura."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:87
translate es qst_TheBeastOfNovaras_BarSceneShared_754fcd3e:

    # "My chest tightened: instinct screamed to cut her down, but her grip on my shoulder pressed just enough to still me."
    "Sentí un nudo en el pecho: mi instinto me gritaba que la soltara, pero su mano sobre mi hombro me presionaba lo suficiente como para inmovilizarme."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:88
translate es qst_TheBeastOfNovaras_BarSceneShared_9dc02952:

    # "A warning, and a promise."
    "Una advertencia y una promesa."

