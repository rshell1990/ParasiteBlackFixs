    SAVAGE_KAIN "¡JA! Grandes palabras de una bestia enjaulada. Ya veremos quién sale vivo hoy de estas paredes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:587
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_1cfe2443:

    # SAVAGE_KAIN "Cat got your tongue? Hah! Don't matter."
    SAVAGE_KAIN "¿Se te ha comido la lengua el gato? ¡Ja! No importa."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:588
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_fcd3d226:

    # SAVAGE_KAIN "I'll rip it out myself soon enough."
    SAVAGE_KAIN "Yo mismo la arrancaré pronto."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:589
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_a64d3659:

    # MC @ angry "You talk an awful lot for a soon to be dead man."
    MC @ angry "Hablas demasiado para ser un hombre que pronto estará muerto."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:591
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_796f3d00:

    # GUARD "That's enough you two!"
    GUARD "¡Ya basta, vosotros dos!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:592
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_fc93432d:

    # GUARD "Save it for the sands."
    GUARD "Guardadlo para las arenas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:594
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_43fe1bcf:

    # "Snarling, Kain pointed his blade towards me, then motioned a slice across the neck, his laughter manic the whole time."
    "Gruñendo, Kain apuntó su espada hacia mí y luego hizo un gesto como si me cortara el cuello, sin dejar de reírse como un loco."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:595
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_71f014a9:

    # "The arena master returned, unimpressed."
    "El jefe de la arena volvió, poco impressionado."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:597
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_4c740089:

    # YARRICK @ talk "Kain. You're up."
    YARRICK @ talk "Kain. Te toca."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:598
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_afa040d2:

    # SAVAGE_KAIN "Finally! Ha! Watch close, freak!"
    SAVAGE_KAIN "¡Por fin! ¡Ja! ¡Mira bien, friki!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:599
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_a94355fb:

    # SAVAGE_KAIN "This is what a real killer looks like!"
    SAVAGE_KAIN "¡Así es como se ve un verdadero asesino!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:600
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_cd9b2c3a:

    # SAVAGE_KAIN "I'M A FUCKING LEGEND BOYS!"
    SAVAGE_KAIN "¡SOY UNA PUTA LEYENDA, CHICOS!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:602
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_84ec40fb:

    # "Clanging his blades together, he charged for the door, roaring loud enough to rattle the walls."
    "Haciendo chocar sus espadas, se abalanzó hacia la puerta, rugiendo tan fuerte que las paredes temblaron."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:606
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_55ff3d01:

    # YARRICK "{i}*Sigh*{/i}"
    YARRICK "{i}*Suspiro*{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:607
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_4cdd4d2f:

    # "Yarrick's gaze slid toward me, his tone bone-dry."
    "La mirada de Yarrick se dirigió hacia mí, con un tono completamente seco."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:608
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_dcb46229:

    # YARRICK @ talk "Get ready, you're up soon."
    YARRICK @ talk "Prepárate, pronto te tocará."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:609
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_667df058:

    # MC @ think "Aren't you going to wait to see how 'Savage Kain' does?"
    MC @ think "¿No vas a esperar a ver cómo le va a 'Kain el Salvaje'?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:611
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_76cde510:

    # "The crowd roared again, and the doors swung open."
    "La multitud volvió a rugir y las puertas se abrieron de par en par."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:616
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_f42992e4:

    # "Moments later, a wagon cart wheeled past."
    "Unos instantes después, pasó una carretilla."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:617
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_2ea8c898:

    # "Kain's corpse split clean in half, blood pouring from him in steaming rivers."
    "El cadáver de Kain estaba partido por la mitad, y la sangre brotaba de él como ríos humeantes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:619
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_450438ef:

    # YARRICK @ talk "Not fucking savage enough, it seems."
    YARRICK @ talk "No lo suficientemente salvaje, por lo que parece."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:620
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_1ba7167c:

    # MC @ talk "... Still not going to tell me what I'll be facing up there?"
    MC @ talk "... ¿Todavía no me vas a decir a qué me voy a enfrentar allí arriba?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:621
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_6e116622:

    # YARRICK @ talk "Tradition still stands on these sands."
    YARRICK @ talk "La tradición sigue viva en estas arenas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:622
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_53331afe:

    # YARRICK @ talk "I suggest you change into... {i}whatever it is you change into.{/i}"
    YARRICK @ talk "Te sugiero que te transformes en... {i}lo que sea en lo que te transformes.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:623
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_941a9e32:

    # YARRICK @ smile "The people hunger to see {i}the Beast,{/i} not {i}the Saviour.{/i}"
    YARRICK @ smile "La gente está ansiosa por ver {i}la Bestia,{/i} no {i}el Salvador.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:624
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_ee314ec1:

    # "The thought twisted my stomach."
    "Esa idea me revolvió el estómago."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:625
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_640459c4:

    # "Was I still myself? Or only Shyahtan's shadow?"
    "¿Seguía siendo yo mismo? ¿O solo la sombra de Shyahtan?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:626
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_057c4e08:

    # "Would I always be the beast? Or was there still a man buried in here somewhere?"
    "¿Siempre sería la bestia? ¿O todavía había un hombre enterrado en algún lugar aquí dentro?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:627
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_b4927758:

    # "Yarrick slid a key into the lock and pushed the gate open."
    "Yarrick introdujo una llave en la cerradura y empujó la puerta para abrirla."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:628
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_501706f4:

    # YARRICK @ talk "When you hear the trumpet and the roar of the crowd, it's time."
    YARRICK @ talk "Cuando oigas la trompeta y el rugido de la multitud, será el momento."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:629
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_35bf5a71:

    # "I nodded."
    "Asentí con la cabeza."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:630
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_10676e51:

    # "He offered a small bow and vanished into the din."
    "Hizo una pequeña reverencia y desapareció entre el bullicio."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:633
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_6b283849:

    # "...A short while later, I stood ready."
    "...Poco después, estaba listo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:634
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_55027320:

    # "Every muscle - mine, or Shyahtan's - pulsed with dread and anticipation."
    "Todos los músculos, míos o los de Shyahtan, palpitaban con temor y expectación."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:636
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_73c22280:

    # "The trumpet bellowed. The doors swung open."
    "La trompeta resonó. Las puertas se abrieron de par en par."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:642
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_9db3a4f7:

    # "Blinding light seared through the dark tunnel as the announcer's voice thundered."
    "Una luz cegadora atravesó el oscuro túnel mientras la voz del anunciador retumbaba."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:643
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_7333c41c:

    # HAMUN_ARENA_ANNOUNCER "And now! The moment you've all been waiting for!"
    HAMUN_ARENA_ANNOUNCER "¡Y ahora! ¡El momento que todos estaban esperando!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:644
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_5112b03c:

    # HAMUN_ARENA_ANNOUNCER "You have heard whispers… tales already becoming legend!"
    HAMUN_ARENA_ANNOUNCER "Habéis oído rumores… ¡historias que ya se están convirtiendo en leyenda!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:645
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_e7b51825:

    # "The air was thick, alive with the crowd's hunger."
    "El aire era denso, lleno de la ansiedad de la multitud."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:646
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_c49c35e1:

    # HAMUN_ARENA_ANNOUNCER "They say, in Novaras' darkest hour, {i}it{/i} answered the call!"
    HAMUN_ARENA_ANNOUNCER "Dicen que, en los momentos más oscuros de Novaras, {i}él{/i} ¡respondió a la llamada!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:647
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_f17f839c:

    # HAMUN_ARENA_ANNOUNCER "A beast… a saviour… A MONSTER!"
    HAMUN_ARENA_ANNOUNCER "Una bestia… un salvador… ¡UN MONSTRUO!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:649
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_ee140a77:

    # "The crowd roared."
    "La multitud rugió."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:650
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_0d983d51:

    # "Half in awe, the other in hatred."
    "Mitad con admiración, mitad con odio."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:651
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_700ba091:

    # "Their cheers and boos fused into one earth-shaking chorus."
    "Sus vítores y abucheos se fusionaron en un coro estremecedor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:652
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_957f1376:

    # HAMUN_ARENA_ANNOUNCER "Some claim it is dark magecraft, born from the twilight of war."
    HAMUN_ARENA_ANNOUNCER "Algunos afirman que se trata de magia oscura, nacida del crepúsculo de la guerra."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:653
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_c0861710:

    # HAMUN_ARENA_ANNOUNCER "Others swear it is the hand of the new gods themselves!"
    HAMUN_ARENA_ANNOUNCER "¡Otros juran que es la mano de los nuevos dioses mismos!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:654
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_b8be14f7:

    # "The ground shook beneath my claws."
    "El suelo tembló bajo mis garras."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:656
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_2c7e9a02:

    # "The noise was unlike anything I had ever felt, like standing at the heart of a storm."
    "El ruido era diferente a todo lo que había sentido antes, como estar en medio de una tormenta."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:657
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_8858e26a:

    # HAMUN_ARENA_ANNOUNCER "BUT MOST OF ALL…"
    HAMUN_ARENA_ANNOUNCER "PERO, SOBRE TODO…"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:658
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_ddbf8956:

    # HAMUN_ARENA_ANNOUNCER "They say the Beast of Novaras would bless our sands!"
    HAMUN_ARENA_ANNOUNCER "¡Dicen que la bestia de Novaras bendeciría nuestras arenas!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:659
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_dbbbcc7e:

    # HAMUN_ARENA_ANNOUNCER "And today... You will tell your children you were here when history was forged!"
    HAMUN_ARENA_ANNOUNCER "Y hoy... ¡Les contarás a tus hijos que estuviste aquí cuando se forjó la historia!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:660
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_dff32b96:

    # HAMUN_ARENA_ANNOUNCER "WHEN THE BEAST BECAME A GOD OF THE ARENA!"
    HAMUN_ARENA_ANNOUNCER "¡CUANDO LA BESTIA SE CONVIRTIÓ EN EL DIOS DE LA ARENA!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:661
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_91f5f1ea:

    # HAMUN_ARENA_ANNOUNCER "…OR DIED TRYING!"
    HAMUN_ARENA_ANNOUNCER "…¡O MURIÓ EN EL INTENTO!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:662
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_e725f414:

    # "I stepped into the sun."
    "Salí hacia el sol."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:663
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_52147403:

    # "The desert heat burned against my skin as thousands of eyes devoured me."
    "El calor del desierto me quemaba la piel mientras miles de ojos me devoraban."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:664
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_497ae8d7:

    # "A freak, a monster, a saviour. All things at once, and none of them."
    "Un bicho raro, un monstruo, un salvador. Todas las cosas a la vez, y ninguna de ellas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:665
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_08cc94f5:

    # "The arena was vast, grander than any pit I'd ever known."
    "La arena era enorme, más grande que cualquier foso que hubiera visto jamás."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:666
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_1e6d9b15:

    # "More gates screeched open."
    "Más puertas se abrieron con un chirrido."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:668
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_1bf941cc:

    # "Markus shuffled uneasily, eyes wide at the crowd."
    "Markus se movió inquieto, con los ojos muy abiertos ante la multitud."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:669
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_eee48055:

    # "His eyes nervously meeting mine briefly as the crowd roared once more."
    "Sus ojos se cruzaron nerviosamente con los míos brevemente mientras la multitud rugía una vez más."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:671
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_adf3885e:

    # "Sypha basked in their cheers, smiling, blowing kisses."
    "Sypha disfrutó de sus vítores, sonriendo y lanzando besos.."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:673
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_5b9941d8:

    # "Ves snarled as boos rained down, her glare cold enough to cut stone."
    "Ves gruñó mientras llovían abucheos, con una mirada tan fría que habría podido cortar piedra."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:675
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_641e34dc:

    # "Then the announcer's voice rose higher still."
    "Entonces, la voz del anunciador se elevó aún más."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:676
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_be2b8f65:

    # HAMUN_ARENA_ANNOUNCER "And if that wasn't enough... we have a most honoured guest tonight!"
    HAMUN_ARENA_ANNOUNCER "Y por si fuera poco... ¡esta noche contamos con una invitada muy especial!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:677
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_cb0dc03f:

    # HAMUN_ARENA_ANNOUNCER "You know her, you love her, empires have risen and fallen at her beauty!"
    HAMUN_ARENA_ANNOUNCER "¡La conocéis, la amáis, imperios han surgido y caído ante su belleza!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:678
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_eb5ce05f:

    # HAMUN_ARENA_ANNOUNCER "THE HERO CELESTE!"
    HAMUN_ARENA_ANNOUNCER "¡LA HEROÍNA CELESTE!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:680
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_1e898c1f:

    # "The roar was deafening, a tsunami of sound that rattled my bones."
    "El rugido era ensordecedor, un tsunami de sonido que me sacudía los huesos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:681
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_0e20e77c:

    # "Up on the raised, ornate seats, Celeste stood."
    "En los asientos elevados y ornamentados, Celeste se puso de pie."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:677
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_c4cd9cdb:

    # "Radiant, her silver hair shimmering, her smile effortless, her presence commanding even the merchant lords beside her."
    "Radiante, con su cabello plateado brillando, su sonrisa natural y una presencia que imponía respeto incluso a los lords mercaderes que la rodeaban."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:683
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_fc4ed75f:

    # "For a moment her eyes met mine. My breath caught. My chest tightened as though some unseen hand gripped it."
    "Por un momento, sus ojos se encontraron con los míos. Se me cortó la respiración. Sentí un nudo en el pecho, como si una mano invisible me lo estuviera apretando."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:684
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_469e86e2:

    # "Celeste, {i}the{/i} Celeste, the jewel of Alderay, saviour of her own legendary party, was watching {i}me.{/i}"
    "Celeste, {i}la{/i} Celeste, la joya de Alderay, salvadora de su propio grupo legendario, me estaba observando, {i}a mí.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:685
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_8c761b15:

    # "Awe, terror, and something nameless flooded through me."
    "El asombro, el terror y algo indescriptible me invadieron."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:686
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_8816e17b:

    # "I felt small. I felt unworthy. And yet, for the first time, I wanted to be seen."
    "Me sentía pequeño. Me sentía indigno. Y, sin embargo, por primera vez, quería que me vieran."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:687
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_a2c5884d:

    # HAMUN_ARENA_ANNOUNCER "But what is a legend without his rival?"
    HAMUN_ARENA_ANNOUNCER "Pero, ¿qué es una leyenda sin su rival?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:688
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_33219d5a:

    # HAMUN_ARENA_ANNOUNCER "Tonight, we bring you the perfect rival to make this match TRULY LEGENDARY!"
    HAMUN_ARENA_ANNOUNCER "¡Esta noche os traemos al rival perfecto para que este combate sea REALMENTE LEGENDARIO!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:689
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_c98e1382:

    # "The portcullis across the sands began to lift with the cogs grinding like the growl of a beast. Darkness loomed beyond."
    "La reja que cruzaba las arenas comenzó a levantarse con un chirrido de engranajes que sonaba como el rugido de una bestia. La oscuridad se cernía más allá."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:691
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_21131c50:

    # "I braced. Claws curled. My heartbeat pounded with each mechanical grind."
    "Me preparé. Las garras se curvaron. Mi corazón latía con fuerza con cada chirrido mecánico."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:692
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_727323b4:

    # "With a loud THUD, the cogs stopped as the portcullis was fully raised."
    "Con un fuerte GOLPE, los engranajes se detuvieron cuando la reja se levantó por completo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:694
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_3b40e804:

    # HAMUN_ARENA_ANNOUNCER "Dragged from the deserts of Ramon… a nightmare born of the old gods' wars!"
    HAMUN_ARENA_ANNOUNCER "Arrastrado desde los desiertos de Ramon… ¡una pesadilla nacida de las guerras de los antiguos dioses!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:696
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_bae4938d:

    # "A roar shrieked from the black."
    "Un rugido resonó en la oscuridad."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:697
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_545482fe:

    # "High, piercing, primal."
    "Agudo, penetrante, primitivo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:699
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_548d924e:

    # "Dust shook from the walls as titanic footsteps echoed closer."
    "El polvo se desprendió de las paredes mientras unos pasos titánicos resonaban cada vez más cerca."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:700
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_0f75b6ac:

    # HAMUN_ARENA_ANNOUNCER "A beast so cursed, adventurers whisper its name with dread!"
    HAMUN_ARENA_ANNOUNCER "¡Una bestia tan maldita que los aventureros susurran su nombre con temor!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:701
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_2db45dc3:

    # "A massive leg stepped forward, reptilian, clawed, each talon the size of a man's arm."
    "Una enorme pata avanzó, reptiliana, con garras, cada una del tamaño del brazo de un hombre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:706
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_4e5ddb29:

    # "Another step, and its colossal body rolled into the light."
    "Otro paso, y su colosal cuerpo salió a la luz."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:708
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_5ff641e0:

    # "Bronze scales glinted. Its great lashing tail gouged the sand."
    "Las escamas de bronce brillaban. Su gran cola azotaba la arena."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:709
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_91ad1313:

    # "Three serpent heads swayed on their long necks, tongues flicking, red eyes glimmering with hunger."
    "Tres cabezas de serpiente se balanceaban sobre sus largos cuellos, sacando la lengua y con los ojos rojos brillando de hambre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:710
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_23746d75:

    # HAMUN_ARENA_ANNOUNCER "THE CALTRACK!"
    HAMUN_ARENA_ANNOUNCER "¡EL CALTRACK!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:714
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_f891ea51:

    # "The crowd howled in frenzy as the monster reared, all three heads snapping, hissing with enough force to whip the air."
    "La multitud gritó frenéticamente cuando el monstruo se irguió, las tres cabezas chasqueando y siseando con tanta fuerza que azotaban el aire."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:715
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_c2f40ffc:

    # "The heat of its breath washed over me..."
    "El calor de su aliento me envolvió..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:716
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_2cd21fb7:

    # "Sulphur and blood, rancid and suffocating."
    "Azufre y sangre, rancio y sofocante."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:717
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_bc78bb04:

    # "Dust swirled at my feet, whipped up by its sheer presence."
    "El polvo se arremolinaba a mis pies, levantado por su mera presencia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:718
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_c85a5624:

    # "The sun beat down. Weapons raised."
    "El sol pegaba fuerte. Armas levantadas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:720
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_5b00440c:

    # "The sands would drink blood this day."
    "Las arenas beberían sangre ese día."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:721
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_43390d5d:

    # "...Ours, or its."
    "...La nuestra o la suya."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:722
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_0fe995f4:

    # "And then… it struck!"
    "¡Y entonces… impactó!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:730
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_8400cac0:

    # "The beast roared, its heads swaying as it fell, crashing down onto the hot sands."
    "La bestia rugió, balanceando sus cabezas mientras caía, estrellándose contra la arena caliente.."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:732
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_b5dfffd6:

    # "The crowd cheered in frenzied excitement as, exhausted, I turned towards the others, nodding at Markus."
    "La multitud vitoreó con frenético entusiasmo cuando, agotado, me giré hacia los demás y asentí con la cabeza a Markus."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:733
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_a984c2e0:

    # "I turned my gaze towards the lady Celeste, hoping, if a little vainly, that she would be cheering and applauding me for our efforts."
    "Dirigí mi mirada hacia Celeste, esperando, aunque fuera en vano, que ella me estuviera animando y aplaudiendo por nuestros esfuerzos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:736
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_970d6fb0:

    # "...And yet, with her face buried in her hand, she seemed..."
    "...Y, sin embargo, con el rostro oculto entre las manos, parecía..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:737
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_63bba3f7:

    # "{i}Bored.{/i}"
    "{i}Aburrida.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:738
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_655695d6:

    # "Not bored. Not exactly."
    "No aburrida. No exactamente."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:739
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_850283b2:

    # "Her shoulders trembled, not with sorrow but with a stifled laugh."
    "Sus hombros temblaban, no por la tristeza, sino por una risa ahogada."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:740
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_eac5591e:

    # "When her hand slipped, I caught the faintest glint in her eyes."
    "Cuando su mano se deslizó, capté un leve destello en sus ojos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:741
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_754c03c9:

    # "Hungry, feverish."
    "Hambriento, febril."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:742
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_c8c04867:

    # "The crowd sought a hero's blessing, but Celeste's lips curved in something else entirely."
    "La multitud buscaba la bendición de un héroe, pero los labios de Celeste esbozaron algo completamente diferente."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:743
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_8c7b8d0b:

    # "Not joy. Not pride. A strange, dark delight she tried to hide."
    "No era alegría. No era orgullo. Era un extraño y oscuro placer que intentaba ocultar."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:744
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_210bd6c4:

    # "I was taken aback."
    "Me quedé desconcertado."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:745
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_265bb6dd:

    # "After felling such a great beast, did it really not even elicit a-"
    "Después de derribar a una bestia tan grande, ¿realmente ni siquiera provocó un-?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:746
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_3bd13251:

    # "The tail suddenly whipped out, slamming Markus against one of the stone walls."
    "La cola se agitó repentinamente, golpeando a Markus contra una de las paredes de piedra."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:750
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_2f9553d4:

    # "He screeched in pain as the Caltrack sprung back into furious life."
    "Gritó de dolor cuando el Caltrack volvió a cobrar vida con furia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:751
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_7d10190f:

    # "For the first time, Sypha's cool expression cracked as in a sudden panic she dodged one of the heads slamming into the sand next to her."
    "Por primera vez, la fría expresión de Sypha se resquebrajó cuando, presa del pánico, esquivó una de las cabezas que se estrelló contra la arena junto a ella."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:753
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_73769de7:

    # "Ves cried out enraged as she began to hack at the thing with her axes."
    "Ves gritó enfurecida mientras comenzaba a golpear a la cosa con sus hachas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:754
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_ef51e80e:

    # "Piercing through the thick hide of the beast, it let out a deafening screech, snapping its jaws at her, barely missing before slamming its head back to knock her to the ground."
    "Tras atravesar la gruesa piel de la bestia, esta soltó un chillido ensordecedor y le hincó las mandíbulas, fallando por poco antes de golpearla con la cabeza y tirarla al suelo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:756
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_e3c26667:

    # "The audience's voice once again rose in a choir of excitement, then cracked into shrieks."
    "La voz del público volvió a elevarse en un coro de emoción, y luego se convirtió en gritos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:758
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_9dd06716:

    # "The Caltrack's heads writhed into the stands, one maw snapping a man in half."
    "Las cabezas de los Caltrack se retorcían en las gradas, y una de ellas partió a un hombre por la mitad de un mordisco."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:760
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_6b1b7818:

    # "Blood sprayed across the seats."
    "La sangre salpicó los asientos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:762
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_3f328742:

    # "Children wailed."
    "Los niños lloraban."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:763
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_ff2fcb4a:

    # "People shoved and clawed at each other in blind terror, trampling the fallen as they rushed for the exits."
    "La gente se empujaba y se arañaba en un terror ciego, pisoteando a los caídos mientras corrían hacia las salidas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:764
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_691d232b:

    # "Even the presenters seemed shaken at the beast's blind fury."
    "Incluso los presentadores parecían conmocionados por la furia ciega de la bestia."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:765
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_ac003e39:

    # "Suddenly, the neck of one of the heads stretched forward, grabbing a spectator from the stands and thrashing him until the body broke apart like a doll."
    "De repente, el cuello de una de las cabezas se estiró hacia adelante, cogiendo a un espectador de las gradas y golpeándolo hasta que el cuerpo se rompió como si fuera una muñeca."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:766
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_29473d6d:

    # "There was a split second of disbelief."
    "Hubo una fracción de segundo de incredulidad."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:767
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_ef1c6027:

    # "Then the crowd realized it could be {i}their{/i} blood next."
    "Entonces la multitud se dio cuenta de que la siguiente podría ser {i}su{/i} sangre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:768
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_7c4628f3:

    # "Cheers turned to chaos as the masses surged toward the exit gates, clogging the narrow tunnels. Dozens were crushed, pinned, screaming."
    "Los vítores se convirtieron en caos cuando la multitud se abalanzó hacia las puertas de salida, atascando los estrechos túneles. Decenas de personas quedaron aplastadas, atrapadas y gritando."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:769
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_f886f0e1:

    # "Total fear took over as the announcer bellowed out."
    "El miedo se apoderó de todos cuando el anunciador gritó."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:770
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_3da310a1:

    # HAMUN_ARENA_ANNOUNCER "REMAIN CALM! THE ARENA GUARD WILL ARRIVE MOMENTARILY AND-"
    HAMUN_ARENA_ANNOUNCER "¡MANTENGAN LA CALMA! LA GUARDIA DE LA ARENA LLEGARÁ EN UN MOMENTO Y-"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:771
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_bbc6d68f:

    # "A loud whip of the Caltrack's tail left a huge gash in the stone wall; at this rate, the thing would bring the whole arena down!"
    "Un fuerte latigazo de la cola del Caltrack dejó una enorme hendidura en la pared de piedra; a este ritmo, ¡esa cosa acabaría derribando toda la arena!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:772
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_cb11b859:

    # "The organizers and high lords turned to each other in a panic, snapping orders to guards who rushed uselessly about."
    "Los organizadores y los grandes señores se miraron entre sí con pánico, dando órdenes a los guardias que corrían inútilmente de un lado a otro."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:773
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_a6b474b0:

    # "Celeste leaned forward now, elbows on her knees."
    "Celeste se inclinó hacia delante, con los codos apoyados en las rodillas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:774
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_be872dc2:

    # "At first glance, her face was the mask of irritation, as though waiting for wine."
    "A primera vista, su rostro era una máscara de irritación, como si estuviera esperando el vino."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:775
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_0cff6a4a:

    # "But her lips were parted, just slightly, as her breath quickened."
    "Pero sus labios se entreabrieron, solo ligeramente, mientras su respiración se aceleraba."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:776
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_45cda8cd:

    # "Her eyes gleaming with... {i}excitement?{/i}"
    "¿Sus ojos brillaban de... {i}emoción?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:777
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_3540a22f:

    # "Or was it something else?"
    "¿O era otra cosa?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:778
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_48abe61c:

    # "Either way, she did not act... What in the hells was she waiting for?"
    "De todos modos, ella no actuó... ¿Qué demonios estaba esperando?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:779
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_af97aa62:

    # "As the enraged heads of the Caltrack now focused on the mass of people attempting to escape, I hurled myself forward, driving my claws deep into one of the creature's feet."
    "Mientras las enfurecidas cabezas del Caltrack se centraban ahora en la multitud que intentaba escapar, me lancé hacia delante y clavé mis garras profundamente en una de las patas de la criatura."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:780
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_696dac13:

    # "As the blades pierced flesh, it bellowed in pain, turning its attention away from the helpless towards me."
    "Cuando las cuchillas atravesaron su carne, rugió de dolor, desviando su atención de los indefensos hacia mí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:781
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_b90a2e25:

    # "I held out, but the frenzied beast moved faster, {i}hit harder.{/i}"
    "Aguanté, pero la bestia enloquecida se movía más rápido, {i}golpeaba más fuerte.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:784
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_8b56e889:

    # "Slammed against the wall as it used its powerful neck to smash me aside, I dropped to the floor, agony giving way to exhaustion."
    "Empujado contra la pared mientras usaba su poderoso cuello para aplastarme, caí al suelo, y la agonía dio paso al agotamiento."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:785
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_f34c4613:

    # "My ribs screamed. My vision blurred red."
    "Mis costillas gritaban. Mi visión se volvió borrosa y roja."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:786
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_8024e747:

    # "I clawed at the stone, nails scraping, but my arms trembled uselessly."
    "Arañé la piedra, raspando con las uñas, pero mis brazos temblaban inútilmente."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:787
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_32811b57:

    # "Blood filled my mouth as I spat onto the sand, every breath fire through broken lungs."
    "La sangre llenó mi boca mientras escupía sobre la arena, cada respiración era fuego a través de mis pulmones destrozados."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:788
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_dd569637:

    # "Every limb, every muscle refused to move as I struggled against them."
    "Cada miembro, cada músculo se negaba a moverse mientras luchaba contra ellos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:789
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_622d2eeb:

    # "The long, elongated necks loomed over me, fangs bared and dripping, breath hot and rancid on my skin."
    "Los cuellos largos y alargados se cernían sobre mí, con los colmillos afilados y chorreantes, y el aliento caliente y rancio sobre mi piel."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:790
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_3bdd27b2:

    # "A terrible sense of dread washed over me, not fear, but what comes after it."
    "Una terrible sensación de pavor se apoderó de mí, no miedo, sino lo que viene después."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:791
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_a3fa2ec4:

    # "{i}Acceptance.{/i}"
    "{i}Aceptación.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:792
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_29575268:

    # "This… this really was it."
    "Esto… esto realmente fue todo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:793
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_f72c936e:

    # "I had only narrowly escaped the jaws of death with Zanarak to find myself here."
    "Había escapado por los pelos de las fauces de la muerte con Zanarak para encontrarme aquí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:794
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_6292dec3:

    # "Once more in death's grasp, once more unable to fight."
    "Una vez más en las garras de la muerte, una vez más incapaz de luchar."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:795
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_09449849:

    # "Weak."
    "Débil."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:796
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_e12ce3cf:

    # "Powerless."
    "Impotente."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:799
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_959f33b2:

    # "WEAK."
    "DÉBIL."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:802
translate es qst_TheBeastOfNovaras_SpecialFightBloodworks_f8ca43b7:

    # "{i}POWERLESS.{/i}"
    "{i}IMPOTENTE.{/i}"

