    YARRICK @ think "{i}Creo que le divierte ver hasta dónde llegan las personas para hablar con él.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1865
translate es qst_TheBeastOfNovaras_ZanzibatHouse_700ae275:

    # GUARD "Lord Zanzibat is ready to receive you."
    GUARD "Lord Zanzibat está listo para recibirte."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1866
translate es qst_TheBeastOfNovaras_ZanzibatHouse_2f76c7a9:

