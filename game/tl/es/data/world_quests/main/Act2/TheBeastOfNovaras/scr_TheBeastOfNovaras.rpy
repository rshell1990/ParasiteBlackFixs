    SHYAHTAN "{i}¿{b}Recuerdas,{/b} Señor de la Colmena, cómo luchamos codo con codo para exterminar a la colmena renegada?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1219
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_375ba8bb:

    # "The Hive Lord didn't answer."
    "El Señor de la Colmena no respondió."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1220
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_f2942cf3:

    # "With a heavy sigh, he turned fully to face me."
    "Con un profundo suspiro, se giró completamente hacia mí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1221
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_ba3f361a:

    # HIVE_LORD "I have someone I wish for you to meet."
    HIVE_LORD "Hay alguien a quien me gustaría que conocieras."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1222
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_eba7a4c2:

    # HIVE_LORD "A new strain I have helped develop."
    HIVE_LORD "Una nueva variante que he ayudado a desarrollar."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1223
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_c887cb4f:

    # HIVE_LORD "I hope you will adopt him under your clan's banners for now."
    HIVE_LORD "Espero que lo adoptéis bajo los estandartes de vuestro clan por ahora."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1224
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_52a67e0e:

    # "The Hive Lord turned to his personal guard."
    "El Señor de la Colmena se giró hacia su guardia personal."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1225
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_cbd3a895:

    # HIVE_LORD "Bring in Eight-Six-One."
    HIVE_LORD "Traed a Ocho Seis Uno."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1226
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_d350cc90:

    # SHYAHTAN "One of your pet projects?"
    SHYAHTAN "¿Uno de tus proyectos favoritos?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1227
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_8c343811:

    # HIVE_LORD "{i}Something like that.{/i}"
    HIVE_LORD "{i}Algo así.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1231
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_6c73278f:

    # "As the fleshy spiral doors opened, a skinny, pale-white Terran approached."
    "Cuando se abrieron las puertas carnosas en espiral, se acercó un terrano delgado y pálido."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1234
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_e5272129:

    # EIGHT_SIX_ONE "...G-Greetings, Lord Shyahtan."
    EIGHT_SIX_ONE "...S-saludos, lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1235
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_5f84324c:

    # MARKUS "WAKE UP!"
    MARKUS "¡DESPIERTA!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1236
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_47333513:

    # SHYAHTAN "A white strain?"
    SHYAHTAN "¿Una variedad blanca?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1237
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_2daa1143:

    # SHYAHTAN "What is he-"
    SHYAHTAN "¿Qué está-?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1238
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_6b39ce73:

    # "I felt the claws of the Hive Lord rest on my shoulder."
    "Sentí las garras del Señor de la Colmena posarse sobre mi hombro."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1239
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_6995b2a0:

    # HIVE_LORD "I will watch his performance with great interest, Lord Shyahtan."
    HIVE_LORD "Veré su desempeño con gran interés, lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1240
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_5f59a957:

    # "The skinny Terran offered a nervous, curt bow."
    "El delgado terrano hizo una reverencia nerviosa y seca."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1243
translate es qst_TheBeastOfNovaras_ReturnFromMerlanians_072968fa:

    # EIGHT_SIX_ONE "I am... at your s-service, my lord."
    EIGHT_SIX_ONE "Estoy... a su servicio, mi señor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1259
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_16665f31:

    # MARKUS "[player_name!t]!"
    MARKUS "¡[player_name!t]!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1261
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_28f83f71:

    # MARKUS "You have to... Ahh! WAKE UP!"
    MARKUS "Tienes que... ¡Ahh! ¡DESPERTAR!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1263
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_72bdb921:

    # "My eyes peeled open as I stared out at the carnage before me."
    "Abrí bien los ojos mientras contemplaba la carnicería que tenía ante mí."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1264
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_dec204cd:

    # "The arena was drenched in blood as the Caltrack flailed; bodies and torn limbs littered the ground as people screamed."
    "La arena estaba empapada de sangre mientras el Caltrack se sacudía violentamente; los cuerpos y las extremidades desgarradas cubrían el suelo mientras la gente gritaba."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1265
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8a00a866:

    # "Even Sypha, usually smug and composed, was barking orders."
    "Incluso Sypha, que normalmente era presumida y serena, estaba dando órdenes a gritos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1266
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_6fc3a72a:

    # "Staggering, bleeding, forcing the others to keep moving and fight."
    "Tambaleándose, sangrando, obligando a los demás a seguir avanzando y luchando."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1267
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_9d245642:

    # "Now, with the Caltrack's eyes fixed on her, Sypha's pupils widened; for the first time, I saw fear in her face."
    "Ahora, con los ojos de Caltrack clavados en ella, las pupilas de Sypha se dilataron; por primera vez, vi miedo en su rostro."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1268
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8a29f88d:

    # "Any moment, it would come crashing down on her and her exhausted body wouldn't move in time..."
    "En cualquier momento, se le echaría encima y su cuerpo agotado no se movería a tiempo..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1269
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_3226ef70:

    # "{i}...But something moved inside me now.{/i}"
    "{i}...Pero ahora algo se movía dentro de mí.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1270
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_b89032c8:

    # "I felt my whole body act on its own, rising as a hot surge of energy flooded through me."
    "Sentí que todo mi cuerpo actuaba por sí solo, elevándose mientras una oleada de energía caliente me inundaba."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1271
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_42819c2d:

    # "{i}What was going on?{/i}"
    "{i}¿Qué estaba pasando?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1273
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_aeaf7911:

    # "Moments ago, I was dying, and now..."
    "Hace unos instantes, estaba muriéndome, y ahora..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1274
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_c8bf02ac:

    # "I sprang forward. Faster than before."
    "Me lancé hacia delante. Más rápido que antes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1275
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_ad41bb57:

    # "Faster than I'd ever moved."
    "Más rápido de lo que jamás me había movido."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1277
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f01b3c92:

    # "With a single motion, I swept Sypha from the sand and yanked her clear of the snapping jaws."
    "Con un solo movimiento, aparté a Sypha de la arena y la alejé de las mandíbulas que la rodeaban."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1278
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8fa10aa1:

    # "She stared up at me, shock and disbelief warring in her eyes."
    "Ella me miró fijamente, con una mezcla de sorpresa e incredulidad en los ojos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1279
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_e3fb0534:

    # "I set her down gently and turned back to the Caltrack."
    "La dejé en el suelo con cuidado y me giré hacia el Caltrack."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1280
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_4cfa3603:

    # "It snapped one of its many jaws toward me."
    "Me chasqueó una de sus muchas mandíbulas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1281
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_bb5a2503:

    # "A quick pivot carried me past it."
    "Un giro rápido me alejó aún más."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1283
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f96435af:

    # "A tentacle latched on and punched through the creature's cheek as I flung myself into the air, crashing down onto one of its heads and driving my claws through its eye."
    "Un tentáculo se aferró y atravesó la mejilla de la criatura mientras yo me lanzaba al aire, estrellándome contra una de sus cabezas y clavándole las garras en el ojo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1285
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8afbe17f:

    # "The beast bellowed, thrashing, a shriek so sharp the crowd clamped hands over ears."
    "La bestia bramó, agitándose violentamente, con un chillido tan agudo que la multitud se tapó los oídos con las manos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1286
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_30842b18:

    # "{i}I wasn't controlling my limbs.{/i}"
    "{i}No controlaba mis extremidades.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1287
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_86951371:

    # "{i}I didn't even know I *could* move like this.{/i}"
    "{i}Ni siquiera sabía que *podía* moverme así.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1288
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_3c70e601:

    # "{i}What was happening?{/i}"
    "{i}¿Qué estaba pasando?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1289
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8920d71f:

    # "I slid and rolled down, claws grinding through jelly and bone, carving the socket wide."
    "Me deslice y rodé hacia abajo, las garras triturando gelatina y hueso, abriendo la cavidad."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1290
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8279394b:

    # "{i}Were my claws sharper?{/i}"
    "{i}¿Mis garras eran más afiladas?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1291
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_87a7a085:

    # "{i}My muscles stronger?{/i}"
    "{i}¿Mis músculos más fuertes?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1292
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_cc821a2e:

    # "Landing, I dragged my talons in a clean arc, severing the throat of one Caltrack head."
    "Al aterrizar, arrastré mis garras en un arco perfecto, cortando la garganta de una de las cabezas de Caltrack."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1293
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_aec21242:

    # "It staggered back, one head limp, the others panicking."
    "Se tambaleó hacia atrás, con una cabeza flácida y las otras presas del pánico."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1296
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_fcfb1fa6:

    # "In a last, desperate lunge, it charged."
    "En una última y desesperada embestida, cargó."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1297
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f8420303:

    # "I moved like lightning, {i}no{/i}, like something beyond it, hurling myself with my tentacles, a straight shot that punched clean through the Caltrack's chest and burst out its spine, leaving a gaping hole in my wake."
    "Me moví como un rayo, {i}no{/i}, como algo más rápido aún, lanzándome con mis tentáculos, un golpe directo que atravesó el pecho del Caltrack y le destrozó la columna vertebral, dejando un agujero enorme a mi paso."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1298
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_7c29366c:

    # "It's heads swayed in the air for a few moments, as though the creature itself was trying to understand what had just happened to it."
    "Sus cabezas se balancearon en el aire durante unos instantes, como si la propia criatura estuviera tratando de comprender lo que acababa de sucederle."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1301
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_0de8f749:

    # "The creature tumbled lifelessly forward, smashing its heads against the wall, twitching in final spasms."
    "La criatura cayó hacia delante sin vida, golpeándose la cabeza contra la pared y retorciéndose en espasmos."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1302
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_6af42d98:

    # "The crowds stared in stunned silence."
    "La multitud observaba en silencio, atónita."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1303
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_b1af4655:

    # "What had they just witnessed?"
    "¿Qué acababan de presenciar?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1304
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_5e9bc9b3:

    # "A monster that could fell armies not merely defeated but {i}eviscerated{/i}."
    "Un monstruo capaz de derrotar ejércitos, no solo derrotado, sino {i}destripado{/i}."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1305
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_075d7561:

    # "Destroyed by a perfect predator."
    "Destruido por un depredador perfecto."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1306
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_987bf0f8:

    # "{i}A god of the arena.{/i}"
    "{i}Un dios de la arena.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1307
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_15e6e6c7:

    # "My arms lifted on their own, and a voice thundered that wasn't mine."
    "Mis brazos se levantaron solos y una voz que no era la mía resonó como un trueno."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1309
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_ec319721:

    # SHYAHTAN "I AM SHYAHTAN! LORD OF A THOUSAND STARS, UNBOWED AND UNBROKED! BRING ME YOUR KINGS OF MEN AND PETTY GODS SO THEY MAY TREMBLE BEFORE ME!"
    SHYAHTAN "¡SOY SHYAHTAN! ¡SEÑOR DE MIL ESTRELLAS, INQUEBRANTABLE E INMUTABLE! ¡TRAEDME A VUESTROS REYES DE HOMBRES Y DIOSES INSIGNIFICANTES PARA QUE TIEMBLEN ANTE MÍ!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1310
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_846ff733:

    # "The crowd was silent at first. Stunned."
    "Al principio, la multitud permaneció en silencio. Atónita."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1311
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_a362b8b6:

    # "Then, a single fist rose, a single voice cheered..."
    "Entonces, se levantó un solo puño, una sola voz vitoreó..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1312
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_a593dfce:

    # "And the stadium erupted."
    "Y el estadio estalló."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1316
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_74cb7483:

    # "SHYAHTAN! SHYAHTAN! SHYAHTAN!"
    "¡SHYAHTAN! ¡SHYAHTAN! ¡SHYAHTAN!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1319
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_66a6a854:

    # "As I looked to the stands, I caught Celeste."
    "Al mirar hacia las gradas, vi a Celeste."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1320
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_a959538b:

    # "Enthralled, leaning forward, her eyes wide as her hands clenched the fabric of her chair."
    "Fascinada, inclinada hacia delante, con los ojos muy abiertos y las manos apretando la tela de su silla."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1321
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_7c770864:

    # "Flushed, lips parted, an excited breath escaped her."
    "Sonrojada, con los labios entreabiertos, dejó escapar un suspiro de emoción."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1322
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_b4e1f66d:

    # "Sypha and the others hurried toward me; most wore pain and worry."
    "Sypha y los demás se apresuraron hacia mí; la mayoría mostraba dolor y preocupación."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1323
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_4f701a79:

    # "Only Sypha smirked."
    "Solo Sypha sonrió."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1325
translate es qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_ee83f689:

