translate es qst_TheBeastOfNovaras_BarSceneShared_6a8ca7ac:

    # SYPHA @ happy "But be careful, jokes can get men killed. Try me, and I'll see your head displayed on a pike before dusk."
    SYPHA @ happy "Pero ten cuidado, las bromas pueden costarle la vida a los hombres. Pruébalas conmigo y verás tu cabeza clavada en una pica antes del anochecer."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:104
translate es qst_TheBeastOfNovaras_BarSceneShared_f7981739:

    # MARKUS @ angry "That a threat?"
    MARKUS @ angry "¿Es eso una amenaza?"

