

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:104
translate es qst_ForgedInFire_CantLeaveSebastian_ffd88855:

    # "As I approached the gates, two guards crossed their halberds in front of me."
    "Al acercarme a las puertas, dos guardias cruzaron sus alabardas delante de mí."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:107
translate es qst_ForgedInFire_CantLeaveSebastian_62408989:

    # "One of the guards addressed me with a heavy, hallowing voice:"
    "Uno de los guardias se dirigió a mí con voz fuerte y penetrante:"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:113
translate es qst_ForgedInFire_CantLeaveSebastian_87c5b731:

    # GUARD "Your leave permit, scout."
    GUARD "Tu permiso de salida, explorador."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:111
translate es qst_ForgedInFire_CantLeaveSebastian_e79ed82a:

    # MC "Huh?"
    MC "¿Eh?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:115
translate es qst_ForgedInFire_CantLeaveSebastian_f00a0734:

    # GUARD "Present your leave permit, as dispatched by your direct commanding officer."
    GUARD "Presenta tu permiso de salida, expedido por tu oficial al mando directo."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:113
translate es qst_ForgedInFire_CantLeaveSebastian_db7eaca7:

    # "The guard sized me up."
    "El guardia me examinó."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:117
translate es qst_ForgedInFire_CantLeaveSebastian_29634847:

    # GUARD "That would be Captain Duprey."
    GUARD "Ese sería el capitán Duprey."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:118
translate es qst_ForgedInFire_CantLeaveSebastian_684e944c:

    # GUARD "And I suspect you have no such permit."
    GUARD "Y sospecho que no tienes ese permiso."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:120
translate es qst_ForgedInFire_CantLeaveSebastian_11238190:

    # GUARD "About-turn!"
    GUARD "¡Da la vuelta!"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:118
translate es qst_ForgedInFire_CantLeaveSebastian_45c36ccf:

    # "I watched them stand still for a moment and then turned around, disappointed."
    "Los observé inmóviles durante un momento y luego me di la vuelta, decepcionado."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:120
translate es qst_ForgedInFire_CantLeaveSebastian_391d3752:

    # MC "(It seems like I'm not getting out anytime soon.)"
    MC "(Parece que no voy a salir pronto)."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:124
translate es qst_ForgedInFire_CantLeaveSebastian_73ac8739:

    # GUARD "Double-march!"
    GUARD "¡Marcha doble!"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:122
translate es qst_ForgedInFire_CantLeaveSebastian_18c47396:

    # MC "*Sigh* Sir yes sir..."
    MC "*Suspiro* Señor sí señor..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:129
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_61356499:

    # "That was the building they dragged that poor recruit towards."
    "Ese fue el edificio hacia el que arrastraron a ese pobre recluta."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:130
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_a65eabce:

    # "Rows of actual comfy beds, shelves full of various potions and tools, civilian-looking people hurrying about past me..."
    "Filas de camas realmente cómodas, estanterías llenas de pociones y herramientas diversas, gente de aspecto civil que pasa a toda prisa a mi lado..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:131
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_172c8f4d:

    # "It was clearly a section of the fort fully devoted to supporting our physical well-being."
    "Era claramente una sección del fuerte dedicada por completo a apoyar nuestro bienestar físico."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:136
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_e5bd48af:

    # RECRUIT "Ow! What are you~"
    RECRUIT "¡Ay! ¿Qué estás~"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:134
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_3fa31f5f:

    # "Over at the corner of the room, a nurse and a physician were likely putting that recruit's face back together."
    "En un rincón de la sala, una enfermera y un médico probablemente estaban recomponiendo la cara del recluta."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:135
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_098a2684:

    # "As I remembered the scene in vivid details, a snapping sound echoed across the room."
    "Mientras recordaba la escena con vívidos detalles, un chasquido resonó por toda la habitación."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:140
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_49cf0693:

    # RECRUIT "{b}Aaaagh!!!{/b}"
    RECRUIT "{b}¡¡¡Aaaagh!!!{/b}"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:138
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_c20f5bef:

    # MC "(On the upside, he won't have no face time with Captain Duprey anytime soon.)"
    MC "(Por otro lado, no tendrá que verse con el capitán Duprey pronto)."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:139
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_48a8e4c1:

    # MC "(I should go to the training area now.)"
    MC "(Debería ir a la zona de entrenamiento ahora)."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:140
translate es qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_73f8592e:

    # MC "(I don't want to end up in here, one way or another.)"
    MC "(No quiero terminar aquí, de una forma u otra)."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:145
translate es qst_ForgedInFire_CantEnterCaptainsOffice_d0e0fdb1:

    # "I approached the door and a guard standing beside it turned to face me:"
    "Me acerqué a la puerta y un guardia que estaba junto a ella se giró hacia mí:"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:151
translate es qst_ForgedInFire_CantEnterCaptainsOffice_3d0d779c:

    # GUARD "You have no business at the Captains office, recruit."
    GUARD "No tienes nada que hacer en la oficina de la capitana, recluta."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:149
translate es qst_ForgedInFire_CantEnterCaptainsOffice_a6793028:

    # "His tone was even but surprisingly chill."
    "Su tono era uniforme pero sorprendentemente tranquilo."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:150
translate es qst_ForgedInFire_CantEnterCaptainsOffice_ba40941c:

    # MC "Yeah, I'm just looking around."
    MC "Sí, solo estoy echando un vistazo."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:154
translate es qst_ForgedInFire_CantEnterCaptainsOffice_ec88e290:

    # GUARD "Sure, just don't bother me as you play inquisitor around here."
    GUARD "Claro, pero no me molestes mientras haces de inquisidor por aquí."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:152
translate es qst_ForgedInFire_CantEnterCaptainsOffice_6c2dfd73:

    # "I nodded and stepped back."
    "Asentí y di un paso atrás."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:154
translate es qst_ForgedInFire_CantEnterCaptainsOffice_2f9aca4a:

    # MC "(A guard who doesn't sound like he's eating babies for breakfast, who would've thought.)"
    MC "(Un guardia que no suena como si estuviera comiendo bebés para el desayuno, ¿quién lo hubiera pensado?)"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:159
translate es qst_ForgedInFire_CantGoToMedwardOrTrainArea_c1db863b:

    # "I should go to the barracks as instructed."
    "Debería ir al cuartel como me ordenaron."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:160
translate es qst_ForgedInFire_CantGoToMedwardOrTrainArea_0d4c21ad:

    # "Last thing I want is for these guards to skewer me for displaying any disobedience..."
    "Lo último que quiero es que estos guardias me ensarten por mostrar alguna desobediencia..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:165
translate es qst_ForgedInFire_CaughtOutsideOfAllowedTime_21ccfdff:

    # "I was approached by a rather hostile-looking guard."
    "Se me acercó un guardia de aspecto bastante hostil."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:171
translate es qst_ForgedInFire_CaughtOutsideOfAllowedTime_2bb61eb1:

    # GUARD "Recruit! What are you doing loitering about after dark?!"
    GUARD "¡Recluta! ¡¿Qué haces merodeando por ahí al por la noche?!"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:169
translate es qst_ForgedInFire_CaughtOutsideOfAllowedTime_e55c35a9:

    # MC "I was just~"
    MC "Solo estaba~"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:174
translate es qst_ForgedInFire_CaughtOutsideOfAllowedTime_d07274a3:

    # GUARD "I will escort you to your bunk now!"
    GUARD "¡Te acompañaré a tu litera ahora!"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:172
translate es qst_ForgedInFire_CaughtOutsideOfAllowedTime_0db79806:

    # MC "*Sigh* Alright, alright..."
    MC "*Suspiro* Está bien, está bien..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:175
translate es qst_ForgedInFire_CaughtOutsideOfAllowedTime_a94b4f28:

    # "The guard did as he declared, following me around and even standing beside me as I was undressing to go to bed."
    "El guardia hizo lo que dijo, me siguió a todas partes e incluso se puso a mi lado mientras me desvestía para ir a la cama."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:179
translate es qst_ForgedInFire_CaughtOutsideOfAllowedTime_d738ea4e:

    # GUARD "Sweet dreams, soldier!"
    GUARD "¡Dulces sueños, soldado!"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:187
translate es qst_ForgedInFire_YourBunk_1a080f4b:

    # "My bunk."
    "Mi litera."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:200
translate es qst_ForgedInFire_YourBunk_0fa8e0c6:

    # MC "(I won't be allowed any pillow-time with the sun still up.)"
    MC "(No se me permitirá ningún tiempo de descanso con el sol todavía arriba)."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:226
translate es qst_ForgedInFire_TalkKiaraSuicidePill_c398b803:

    # "I noticed Kiara standing somberly near the barracks' entrance, inspecting some trinket around her neck."
    "Vi a Kiara de pie, sombría, cerca de la entrada del barracón, inspeccionando alguna baratija que llevaba colgada del cuello."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:227
translate es qst_ForgedInFire_TalkKiaraSuicidePill_9bae01fe:

    # "It was a small type of vial with some liquid sloshing about inside that I'd seen only on the women scouts."
    "Era un pequeño frasco con un líquido en su interior que solo había visto en las exploradoras."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:228
translate es qst_ForgedInFire_TalkKiaraSuicidePill_d4ba20bf:

    # MC @ talk "Hey."
    MC @ talk "Ey."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:230
translate es qst_ForgedInFire_TalkKiaraSuicidePill_c0fb4407:

    # "I noticed that recruit girl I've seen a few times now standing somberly near the barracks, inspecting some trinket around her neck."
    "Me fijé en esa chica recluta que he visto ya varias veces, de pie, sombría, cerca de los barracones, inspeccionando alguna baratija que llevaba colgada del cuello."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:231
translate es qst_ForgedInFire_TalkKiaraSuicidePill_9bae01fe_1:

    # "It was a small type of vial with some liquid sloshing about inside that I'd seen only on the women scouts."
    "Era un pequeño frasco con un líquido en su interior que solo había visto en las exploradoras."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:232
translate es qst_ForgedInFire_TalkKiaraSuicidePill_8db5977d:

    # MC @ talk "Hey..."
    MC @ talk "Ey..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:233
translate es qst_ForgedInFire_TalkKiaraSuicidePill_b69d3c76:

    # "The girl looked at me."
    "La chica me miró."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:234
translate es qst_ForgedInFire_TalkKiaraSuicidePill_54cef13c:

    # KIARA "Yeah?"
    KIARA "¿Sí?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:229
translate es qst_ForgedInFire_TalkKiaraSuicidePill_9efe6f5a:

    # MC "(Now is as good time as any, [player_name!t]...)"
    MC "(Ahora es tan buen momento como cualquier otro, [player_name!t]...)"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:230
translate es qst_ForgedInFire_TalkKiaraSuicidePill_45a437bc:

    # MC @ talk "I'm [player_name!t]. You?"
    MC @ talk "Soy [player_name!t]. ¿Y tú?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:237
translate es qst_ForgedInFire_TalkKiaraSuicidePill_9a55b3f3:

    # "She paused quizzically, as if I asked her to recite the entire pantheon of the old Alderian gods..."
    "Hizo una pausa incrédula, como si le hubiera pedido que recitara todo el panteón de los antiguos dioses alderianos..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:238
translate es qst_ForgedInFire_TalkKiaraSuicidePill_2af745ee:

    # KIARA "Oh, I'm Kiara, sorry, it's just, this..."
    KIARA "Oh, soy Kiara, lo siento, es que, esto..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:242
translate es qst_ForgedInFire_TalkKiaraSuicidePill_abf0dbd1:

    # "Kiara glanced at the trinket in her hand."
    "Kiara miró la baratija que tenía en la mano."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:243
translate es qst_ForgedInFire_TalkKiaraSuicidePill_693376bc:

    # MC @ talk "What's that?"
    MC @ talk "¿Qué es eso?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:244
translate es qst_ForgedInFire_TalkKiaraSuicidePill_86acd573:

    # KIARA @ scared "Hm? A-Ah..."
    KIARA @ scared "¿Hm? A-ah..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:245
translate es qst_ForgedInFire_TalkKiaraSuicidePill_96a5b6d5:

    # KIARA @ scared "You mean, {i}you don't have them?{/i}"
    KIARA @ scared "¿Quieres decir ,{i}que no los tienes?{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:246
translate es qst_ForgedInFire_TalkKiaraSuicidePill_a06c0c45:

    # MC @ think "Have what?"
    MC @ think "¿Tener qué?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:247
translate es qst_ForgedInFire_TalkKiaraSuicidePill_d88a130f:

    # KIARA @ sad "...I suppose it makes sense they'd only give these to the women."
    KIARA @ sad "...Supongo que tiene sentido que solo se los den a las mujeres."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:248
translate es qst_ForgedInFire_TalkKiaraSuicidePill_7807f448:

    # "My thoughts naturally gravitated towards it being some type of contraceptive, but from Kiara's deathly face, I got the impression this was something else entirely..."
    "Mis pensamientos se inclinaron naturalmente hacia algún tipo de anticonceptivo, pero por la cara de muerte de Kiara, tuve la impresión de que se trataba de algo totalmente distinto..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:249
translate es qst_ForgedInFire_TalkKiaraSuicidePill_2f447204:

    # MC @ talk "What is it?"
    MC @ talk "¿Qué es?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:250
translate es qst_ForgedInFire_TalkKiaraSuicidePill_bf3a5617:

    # KIARA @ sad "{i}Poison.{/i}"
    KIARA @ sad "{i}Veneno.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:251
translate es qst_ForgedInFire_TalkKiaraSuicidePill_1024ba5b:

    # MC @ scared "Poison?"
    MC @ scared "¿Veneno?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:252
translate es qst_ForgedInFire_TalkKiaraSuicidePill_11458c35:

    # KIARA @ sad "Yes... Poison."
    KIARA @ sad "Sí... Veneno."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:253
translate es qst_ForgedInFire_TalkKiaraSuicidePill_b621a53b:

    # KIARA @ sad "You see, the Demorai will likely just kill men on sight."
    KIARA @ sad "Verás, es probable que los Demorai maten a los hombres nada más verlos."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:254
translate es qst_ForgedInFire_TalkKiaraSuicidePill_2ae75f60:

    # "There was a long pause before she spoke again."
    "Hubo una larga pausa antes de que volviera a hablar."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:255
translate es qst_ForgedInFire_TalkKiaraSuicidePill_1a69e9d1:

    # KIARA @ sad "...But, if they know it's a woman, then-"
    KIARA @ sad "...Pero, si saben que es una mujer, entonces-"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:256
translate es qst_ForgedInFire_TalkKiaraSuicidePill_0eb7df76:

    # "Kiara let the sentence trail off into nothing as her eyes looked up to meet mine."
    "Kiara dejó que la frase se quedara en nada mientras alzaba los ojos para encontrarse con los míos."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:257
translate es qst_ForgedInFire_TalkKiaraSuicidePill_de58e436:

    # MC @ talk "...I see."
    MC @ talk "...Ya veo."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:258
translate es qst_ForgedInFire_TalkKiaraSuicidePill_dfe507b5:

    # "Clearly uncomfortable with the thought, Kiara put the poisoned vial around her neck away."
    "Claramente incómoda con la idea, Kiara se guardó el frasco envenenado que llevaba al cuello."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:259
translate es qst_ForgedInFire_TalkKiaraSuicidePill_a7d48f38:

    # KIARA "Well, I best get back to it."
    KIARA "Bueno, mejor vuelvo a ello."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:260
translate es qst_ForgedInFire_TalkKiaraSuicidePill_dcdb40a3:

    # MC @ talk "...Kiara."
    MC @ talk "...Kiara."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:261
translate es qst_ForgedInFire_TalkKiaraSuicidePill_17362382:

    # KIARA "Hm?"
    KIARA "¿Hm?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:262
translate es qst_ForgedInFire_TalkKiaraSuicidePill_d772a6ab:

    # MC @ talk "I don't know how, but..."
    MC @ talk "No sé cómo, pero..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:263
translate es qst_ForgedInFire_TalkKiaraSuicidePill_c54f2fa9:

    # MC @ talk "We're gonna survive this somehow, I promise."
    MC @ talk "Vamos a sobrevivir a esto de alguna manera, lo prometo."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:264
translate es qst_ForgedInFire_TalkKiaraSuicidePill_8ac203f7:

    # "Kiara smiled."
    "Kiara sonrió."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:266
translate es qst_ForgedInFire_TalkKiaraSuicidePill_8f992da3:

    # KIARA @ happy "Bloody optimist, aren't ya?"
    KIARA @ happy "Eres un maldito optimista, ¿no?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:268
translate es qst_ForgedInFire_TalkKiaraSuicidePill_ac511b10:

    # "Kiara left with a smile on her face."
    "Kiara se marchó con una sonrisa en la cara."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:269
translate es qst_ForgedInFire_TalkKiaraSuicidePill_53327d35:

    # MC "(Gonna survive this, huh?)"
    MC "(Sobreviviremos a esto, ¿eh?)"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:270
translate es qst_ForgedInFire_TalkKiaraSuicidePill_39d2fef7:

    # MC "(I almost convinced myself there!)"
    MC "(¡Casi me convenzo a mí mismo!)"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:276
