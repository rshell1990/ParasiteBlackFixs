translate es qst_ForgedInFire_CaughtSkippingTraining_1b30d622:

    # SECOND_GUARD "And what does that mean?"
    SECOND_GUARD "¿Y eso qué significa?"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:291
translate es qst_ForgedInFire_CaughtSkippingTraining_d7f5a4ca:

    # MC "Means we are all but mere insects under its eternal glory."
    MC "Significa que no somos más que meros insectos bajo su gloria eterna."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:292
translate es qst_ForgedInFire_CaughtSkippingTraining_e22613dc:

    # "A muffled laugh escaped from underneath the friendlier guard's helmet."
    "Una risa ahogada se escapó de debajo del casco del guardia más amable."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:297
translate es qst_ForgedInFire_CaughtSkippingTraining_d9bc0099:

    # GUARD "It means you maggot supposed to be training!"
    GUARD "¡Significa que deberías estar entrenando!"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:299
translate es qst_ForgedInFire_CaughtSkippingTraining_48fb43f5:

    # GUARD "At the training yard!"
    GUARD "¡En el patio de entrenamiento!"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:297
translate es qst_ForgedInFire_CaughtSkippingTraining_35f21f5d:

    # "With a wave of his halberd, the bulky guard set me on my way."
    "Con un gesto de su alabarda, el corpulento guardia me puso en camino."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:299
translate es qst_ForgedInFire_CaughtSkippingTraining_985298db:

    # MC "(Join the army they said...)"
    MC "(Alístate en el ejército dijeron...)"


translate es strings:

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Get your gear from the barracks"
    new "Recoge tu equipo de los barracones"

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "I must go to the barracks and get my set of Scouts Gear. Looks like this place is what I'll be calling home for... gods only know how long, so I better get used to it."
    new "Debo ir a los barracones a por mi equipo de exploradores. Parece que llamaré hogar a este lugar durante... solo los dioses saben cuánto tiempo, así que será mejor que me acostumbre."

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Return to the yard"
    new "Vuelve al patio"

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Locked and loaded, it's time to go to the fort yard. Quartermaster Joakim mentioned some captain taking over, so I guess we'll get to swing these swords quite soon..."
    new "Preparado, es hora de ir al patio del fuerte. El intendente Joakim mencionó que algún capitán se hará cargo, así que supongo que podremos blandir estas espadas muy pronto..."
    
    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Show up at the training area"
    new "Preséntate en la zona de entrenamiento"

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "We have fallen under command of Captain Duprey, a brutal veteran warrior of the Alderay. My priorities have changed now: I am to survive {i}the training itself{/i}, not whatever they use the Scouts for."
    new "Hemos sido puestos bajo el mando del capitán Duprey, un brutal guerrero veterano de los Alderay. Mis prioridades han cambiado ahora: Debo sobrevivir {i}al entrenamiento en sí{/i}, no a lo que sea para lo que usen a los exploradores."

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Exhausted and battered, I am almost through my first day at Fort Sebastian. I should now muster all of my strength to get to my bunk at the barracks..."
    new "Agotado y maltrecho, casi he terminado mi primer día en fuerte Sebastian. Ahora debo reunir todas mis fuerzas para llegar a mi litera en el cuartel..."
    
    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Keep attending the training sessions"
    new "Sigue asistiendo a las sesiones de entrenamiento"

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Under the command of Captain Duprey we are to train very hard, on our way to become real warriors.\nI must now attend daily training sessions to improve my fighting skills."
    new "Bajo el mando del capitán Duprey vamos a entrenar muy duro, en nuestro camino para convertirnos en verdaderos guerreros.\nAhora debo asistir a sesiones diarias de entrenamiento para mejorar mis habilidades de combate."

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Attend the test"
    new "Asiste a la prueba"

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "We have gone through a rather extensive training program. Captain Duprey mentioned a test of some sorts, to see if we are prepared for some more in-depth training maneuvers. We are to show up at the yard at dawn, as usual."
    new "Hemos pasado por un programa de entrenamiento bastante extenso. El capitán Duprey mencionó una prueba de algún tipo, para ver si estamos preparados para algunas maniobras de entrenamiento más profundas. Debemos presentarnos en el patio al amanecer, como de costumbre."

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:12
    old "Forged in Fire"
    new "Forjado a fuego"

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:13
    old "Me and Markus are now members of the Scouts Corp, a reconnaissance branch of the Alderian army. I am to follow whatever the Empire demands of me and to hopefully live through it."
    new "Markus y yo somos ahora miembros del cuerpo de exploradores, una rama de reconocimiento del ejército alderiano. Debo seguir todo lo que el Imperio exija de mí y espero vivir a través de él."

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:87
    old "Hang around until the training session starts"
    new "Espera hasta que empiece la sesión de entrenamiento"

    # game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:4
    old "Go to sleep"
    new "Ve a dormir"
