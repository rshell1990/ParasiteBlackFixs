translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_40b12a4d:

    # MARKUS "It was kinda cool though, wasn't it?"
    MARKUS "Pero fue genial, ¿no?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:601
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_eb54f1a5:

    # MC "Yeah, beats swinging it against these training dummies!"
    MC "¡Sí, es mejor que golpear a estos muñecos de entrenamiento!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:609
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_ba3a1381:

    # "For the remainder of the day, Duprey educated us on the nuances of using various special skills, tools and items in battle."
    "Durante el resto del día, Duprey nos enseñó los distintos aspectos del uso de habilidades especiales, herramientas y objetos en la batalla."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:610
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_d61d0b14:

    # "Exhausted, I didn't really get much of it: magic refraction scrolls, ensnarement crystals, Vulshan smoke bombs..."
    "Agotado, no conseguí gran cosa: pergaminos de refracción mágica, cristales de atrapamiento, bombas de humo Vulshan..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:611
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_3a645881:

    # "Come dusk, Duprey concluded with showing us some advanced combat moves, I guess to somehow inspire us to master the art of combat."
    "Al media tarde, Duprey terminó mostrándonos algunos movimientos de combate avanzados, supongo que para inspirarnos de algún modo a dominar el arte del combate."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:617
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_ca79f8f3:

    # DUPREY "...So this is how you do the Waltzing Bazark strike."
    DUPREY "... Así es como se hace el golpe Waltzing Bazark."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:618
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_7f316660:

    # "Duprey caught his breath after executing a rather spectacular combat move."
    "Duprey recuperó el aliento tras ejecutar un movimiento de combate bastante espectacular."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:619
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_55a1cf16:

    # "He scanned the crowd of recruits, totally exhausted from another training session, and I can promise I saw a hint of fatherly smile on his face."
    "Observó a la multitud de reclutas, totalmente agotados por otra sesión de entrenamiento, y puedo prometer que vi un atisbo de sonrisa paternal en su rostro."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:620
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_56df01de:

    # DUPREY "Okay, you lot."
    DUPREY "Bien, todos vosotros."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:621
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_60e9fa7e:

    # DUPREY "Go and take some rest now."
    DUPREY "Id a descansar un poco."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:627
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_c70200c9:

    # "Me and Markus looked at each other in confusion:"
    "Markus y yo nos miramos confundidos:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:628
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_b1a7928d:

    # MC "A Waltzing Bazark? I'm not even trying something like that."
    MC "¿Un Waltzing Bazark? Ni siquiera voy a intentar algo así."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:629
translate es qst_ForgedInFire_Training1SkillsAndEnergyAndItems_repBattle_99873a35:

    # MARKUS "You'd be collecting me from all over the yard if I did..."
    MARKUS "Me estarías recogiendo de todo el patio si lo hiciera..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:647
translate es qst_ForgedInFire_Training1NightEvent_2a3accbf:

    # REGINA "...[player_name!t]."
    REGINA "...[player_name!t]."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:648
translate es qst_ForgedInFire_Training1NightEvent_7199e905:

    # REGINA "Wake up, [player_name!t]."
    REGINA "Despierta, [player_name!t]."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:677
translate es qst_ForgedInFire_Training1NightEvent_2a66cc92:

    # "As my eyes slowly peeled open, a dark, raven haired blob was stood, lurched over the side of my bed."
    "Mientras abría lentamente los ojos, una mancha oscura de pelo negro estaba de pie, apoyada a un lado de mi cama."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:653
translate es qst_ForgedInFire_Training1NightEvent_c40f7ba2:

    # "My vision became clearer: there I saw, clear as day, [regina_ref!t] crouched over and smiling towards me."
    "Mi visión se aclaró: allí vi, clara como el día, a [regina_ref!t] agachada y sonriéndome."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:654
translate es qst_ForgedInFire_Training1NightEvent_0bbec91f:

    # MC @ surprised "[regina_ref_cap!t]?"
    MC @ surprised "¿[regina_ref_cap!t]?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:655
translate es qst_ForgedInFire_Training1NightEvent_3fe750ff:

    # "[regina_ref_cap!t] placed her finger over her lip and motioned for me to be silent."
    "[regina_ref_cap!t] se puso el dedo sobre el labio y me hizo un gesto para que guardara silencio."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:681
translate es qst_ForgedInFire_Training1NightEvent_87f8b481:

    # "{i}Was this some kind of a dream?{/i}"
    "{i}¿Era una especie de sueño?{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:682
translate es qst_ForgedInFire_Training1NightEvent_9ce974a4:

    # "She leaned in close to whisper."
    "Se acercó para susurrar."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:683
translate es qst_ForgedInFire_Training1NightEvent_32cf642b:

    # REGINA @ smile "I've bought you some things, dear."
    REGINA @ smile "Te he traído algunas cosas, cariño."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:684
translate es qst_ForgedInFire_Training1NightEvent_6f52509f:

    # REGINA @ talk "{i}Just a little something between the two of us...{/i}"
    REGINA @ talk "{i}Solo algo entre los dos...{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:685
translate es qst_ForgedInFire_Training1NightEvent_caa43851:

    # MC @ surprised "How ... How did you even get in here?"
    MC @ surprised "Cómo... ¿Cómo entraste aquí?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:686
translate es qst_ForgedInFire_Training1NightEvent_257c75a7:

    # REGINA @ talk "Don't worry about that now, dear."
    REGINA @ talk "No te preocupes por eso ahora, cariño."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:687
translate es qst_ForgedInFire_Training1NightEvent_eb2e578c:

    # REGINA @ talk "I just wanted to see you."
    REGINA @ talk "Solo quería verte."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:688
translate es qst_ForgedInFire_Training1NightEvent_fb531ee6:

    # MC @ talk "But-"
    MC @ talk "Pero-"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:689
translate es qst_ForgedInFire_Training1NightEvent_24a60a73:

    # "As her hand gently caressed my cheek, I began to feel myself drifting back to the darkness once again."
    "Mientras su mano acariciaba suavemente mi mejilla, empecé a sentir que volvía a la oscuridad una vez más."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:691
translate es qst_ForgedInFire_Training1NightEvent_4ff52e4f:

    # "{i}Perhaps, this really was a dream?{/i}"
    "{i}¿Quizás, esto era realmente un sueño?{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:692
translate es qst_ForgedInFire_Training1NightEvent_ccaef93c:

    # REGINA @ talk "Shhh... {i}Sleep, dear.{/i}"
    REGINA @ talk "Shhh... {i}Duerme, cariño.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:693
translate es qst_ForgedInFire_Training1NightEvent_898758b8:

    # REGINA "{i}I'll always be here for you...{/i}"
    REGINA "{i}Siempre estaré aquí para ti...{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:694
translate es qst_ForgedInFire_Training1NightEvent_3b1abd21:

    # REGINA "{i}...no matter what.{/i}"
    REGINA "{i}...pase lo que pase.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:717
translate es qst_ForgedInFire_Training1NightEvent_caba15b5:

    # "Springing upright in my bed, soaked in sweat, I looked around as people prepared themselves for another day of training."
    "Incorporándome en la cama, empapado en sudor, miro a mi alrededor mientras la gente se prepara para otro día de entrenamiento."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:696
translate es qst_ForgedInFire_Training1NightEvent_4f0b95e9:

    # MARKUS "[player_name!t]? Are you alright?"
    MARKUS "¿[player_name!t]? ¿Estás bien?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:721
translate es qst_ForgedInFire_Training1NightEvent_24f0136a:

    # MC @ scared "I ... I think so."
    MC @ scared "Creo... Creo que sí."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:722
translate es qst_ForgedInFire_Training1NightEvent_328b83d2:

    # MARKUS "Bad dreams?"
    MARKUS "¿Tuviste pesadillas?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:724
translate es qst_ForgedInFire_Training1NightEvent_b260c7ad:

    # MC @ scared "...I'm not sure what it was."
    MC @ scared "...No estoy seguro de qué era."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:725
translate es qst_ForgedInFire_Training1NightEvent_d5d45ce3:

    # MARKUS @ shock "Well, you look like you've seen a ghost!"
    MARKUS @ shock "¡Parece como si hubieras visto un fantasma!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:726
translate es qst_ForgedInFire_Training1NightEvent_d5193f8a:

    # "Somehow, a ghost felt more explainable than what I saw last night..."
    "De alguna manera, un fantasma parecía más explicable que lo que vi anoche..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:727
translate es qst_ForgedInFire_Training1NightEvent_247c26f4:

    # MARKUS "Come, I'm sure a few whacks from a training sword will take your mind off whatever it was!"
    MARKUS "¡Ven, estoy seguro de que unos golpes con una espada de entrenamiento te harán olvidar lo que sea que te haya pasado!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:729
translate es qst_ForgedInFire_Training1NightEvent_a8954217:

    # "As Markus headed out of the barracks towards the training yard, I shook my head, pushing the strange dream aside."
    "Mientras Markus salía de los barracones en dirección al patio de entrenamiento, sacudí la cabeza, dejando a un lado el extraño sueño."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:731
translate es qst_ForgedInFire_Training1NightEvent_83da7088:

    # "Opening my chest to grab my uniform, I noticed immediately the strangely placed bottle of red wine that wasn't there before..."
    "Al abrir el baúl para coger mi uniforme, noté inmediatamente la botella de vino tinto extrañamente colocada que antes no estaba allí..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:733
translate es qst_ForgedInFire_Training1NightEvent_01b21009:

    # MC @ scared "(It... It was a dream!)"
    MC @ scared "(Fue... ¡Fue un sueño!)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:736
translate es qst_ForgedInFire_Training1NightEvent_d62002c2:

    # MC @ think "(...Right?)"
    MC @ think "(...¿Verdad?)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:751
translate es qst_ForgedInFire_Training2Teamwork_f1834407:

    # DUPREY "...So, having being around a little, what do you lot think matters the most in battle?"
    DUPREY "...Después de haber estado un poco por aquí, ¿qué creen que es lo más importante en una batalla?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:752
translate es qst_ForgedInFire_Training2Teamwork_84edc41c:

    # "We looked at each other puzzled."
    "Nos miramos perplejos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:758
translate es qst_ForgedInFire_Training2Teamwork_cef8185e:

    # RECRUITS "{i}Strength?{/i}"
    RECRUITS "{i}¿Fuerza?{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:759
translate es qst_ForgedInFire_Training2Teamwork_6cf01769:

    # RECRUITS "{i}Our gear!{/i}"
    RECRUITS "{i}¡Nuestro equipamiento!{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:756
translate es qst_ForgedInFire_Training2Teamwork_5b70b478:

    # "Some of us were throwing more words out there, until..."
    "Algunos de nosotros estábamos soltando más palabras, hasta que..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:761
translate es qst_ForgedInFire_Training2Teamwork_59efef91:

    # RECRUITS "{i}Being like... a single force?{/i}"
    RECRUITS "{i}¿Ser como... una sola fuerza?{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:758
translate es qst_ForgedInFire_Training2Teamwork_60c375e0:

    # "I swear I saw a hint of suprise on Duprey's face:"
    "Juro que vi un atisbo de sorpresa en la cara de Duprey:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:759
translate es qst_ForgedInFire_Training2Teamwork_a52d9426:

    # DUPREY @ laugh "Right on, lad!"
    DUPREY @ laugh "¡Muy bien, muchacho!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:760
translate es qst_ForgedInFire_Training2Teamwork_ae81de48:

    # "Silence covered our ranks, as we have began to realize what today's lesson was about."
    "El silencio cubrió nuestras filas, mientras empezábamos a darnos cuenta de qué trataba la lección de hoy."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:761
translate es qst_ForgedInFire_Training2Teamwork_c6bbed4f:

    # "Duprey smiled for a moment as he continued:"
    "Duprey sonrió un momento mientras continuaba:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:762
translate es qst_ForgedInFire_Training2Teamwork_f6068bdd:

    # DUPREY "Teamwork, lads."
    DUPREY "Trabajo en equipo, muchachos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:763
translate es qst_ForgedInFire_Training2Teamwork_2c171579:

    # DUPREY "Confidence in a soldier to your left and a soldier to your right, {i}this{/i} is the driving force behind any worthy army."
    DUPREY "Confianza en un soldado a tu izquierda y otro a tu derecha, {i}esto{/i} es el motor de todo ejército que se precie."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:764
translate es qst_ForgedInFire_Training2Teamwork_479fffc2:

    # "Duprey began pointing at recruits from the crowd:"
    "Duprey comenzó a señalar a los reclutas de la multitud:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:765
translate es qst_ForgedInFire_Training2Teamwork_54599814:

    # DUPREY "You can have the best gear in all Alderay!"
    DUPREY "¡Puedes tener el mejor equipamiento de todo Alderay!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:766
translate es qst_ForgedInFire_Training2Teamwork_fae39187:

    # DUPREY "And you can be an expert at handling your weapon of choice,"
    DUPREY "Y puedes ser un experto en el manejo del arma que elijas,"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:767
translate es qst_ForgedInFire_Training2Teamwork_812a5810:

    # DUPREY "While your bag of dirty tricks can grow as large as to become a caravan,"
    DUPREY "mientras que tus trucos sucios pueden crecer tanto como para convertirse en una caravana,"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:768
translate es qst_ForgedInFire_Training2Teamwork_671d40a2:

    # "Some recruits laughed as Duprey continued, ever more serious:"
    "Algunos reclutas se rieron mientras Duprey continuaba, cada vez más serio:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:769
translate es qst_ForgedInFire_Training2Teamwork_2ff1717a:

    # DUPREY "But if you don't have a warrior, a true battle brother you are dead sure in at your side,"
    DUPREY "pero si no tienes un guerrero, un verdadero hermano de batalla, seguro que estás muerto a tu lado,"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:770
translate es qst_ForgedInFire_Training2Teamwork_ff502967:

    # DUPREY "One who would stand with you no matter what is coming at you..."
    DUPREY "alguien que te apoye sin importar lo que te pase..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:771
translate es qst_ForgedInFire_Training2Teamwork_95d64e38:

    # "Duprey's expression turned pale for a moment, as if his mind's eye erupted with memories."
    "La expresión de Duprey palideció por un momento, como si el ojo de su mente estallara en recuerdos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:772
translate es qst_ForgedInFire_Training2Teamwork_fa17f4b8:

    # DUPREY "You {i}will be{/i} obliterated."
    DUPREY "{i}Serás{/i} aniquilado."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:773
translate es qst_ForgedInFire_Training2Teamwork_828b281f:

    # "Me and Markus looked at each other and nodded stoically, but Duprey's usual commanding tone snapped us out of it quick:"
    "Markus y yo nos miramos y asentimos estoicamente, pero el habitual tono autoritario de Duprey nos sacó de dudas rápidamente:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:774
translate es qst_ForgedInFire_Training2Teamwork_b5b6ec4e:

    # DUPREY "None of us would want that to happen, right you maggots?!"
    DUPREY "Ninguno de nosotros querría que eso pasara, ¡¿verdad, gusanos?!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:776
translate es qst_ForgedInFire_Training2Teamwork_41a3cf71:

    # DUPREY "Today, you will spar in teams of two!"
    DUPREY "¡Hoy entrenaréis en equipos de dos!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:777
translate es qst_ForgedInFire_Training2Teamwork_dfb15ac9:

    # DUPREY "Partner up, and get to it!"
    DUPREY "Formen parejas y pónganse manos a la obra."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:778
translate es qst_ForgedInFire_Training2Teamwork_6e24ff53:

    # DUPREY "...BEGIN!"
    DUPREY "...¡COMENZAD!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:802
translate es qst_ForgedInFire_Training2Teamwork_repBattle_22336bc1:

    # MARKUS "Phew... You guys kicked our ass!"
    MARKUS "Uf... ¡Nos habéis dado una paliza!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:803
translate es qst_ForgedInFire_Training2Teamwork_repBattle_d5403c39:

    # MARKUS "Let's go again now!"
    MARKUS "¡Vamos otra vez!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:804
translate es qst_ForgedInFire_Training2Teamwork_repBattle_d4066694:

    # MARKUS "I swear you won't get us this time!"
    MARKUS "¡Juro que esta vez no nos venceréis!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:806
translate es qst_ForgedInFire_Training2Teamwork_repBattle_4303ca27:

    # "Markus and his teammate both looked at us two."
    "Markus y su compañero nos miraron."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:807
translate es qst_ForgedInFire_Training2Teamwork_repBattle_4c68b6fe:

    # MARKUS "Come on guys, remember what Duprey said!"
    MARKUS "¡Vamos chicos, recordad lo que dijo Duprey!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:808
translate es qst_ForgedInFire_Training2Teamwork_repBattle_072ed379:

    # MARKUS "Be a single force!"
    MARKUS "¡Ser una sola fuerza!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:809
translate es qst_ForgedInFire_Training2Teamwork_repBattle_7e6c58ca:

    # "His teammate interrupted:"
    "Su compañero de equipo interrumpió:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:816
translate es qst_ForgedInFire_Training2Teamwork_repBattle_c87c6273:

    # RECRUIT "Actually... it was me who said it..."
    RECRUIT "En realidad... fui yo quien lo dijo..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:812
translate es qst_ForgedInFire_Training2Teamwork_repBattle_76d4b651:

    # "I let out a laugh which echoed painfully all over my body."
    "Solté una carcajada que resonó dolorosamente por todo mi cuerpo."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:813
translate es qst_ForgedInFire_Training2Teamwork_repBattle_33a51547:

    # MARKUS "... Whatever! Come on, let's go for another round!"
    MARKUS "... ¡Como quieras! ¡Vamos, otra ronda!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:816
translate es qst_ForgedInFire_Training2Teamwork_repBattle_2af51c90:

    # MARKUS "That's what I like to hear!"
    MARKUS "¡Eso es lo que me gusta oír!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:817
translate es qst_ForgedInFire_Training2Teamwork_repBattle_102beb74:

    # MARKUS @ smile "Let's see if our 'army' defeats yours this time!"
    MARKUS @ smile "Veamos si nuestro 'ejército' derrota al tuyo esta vez."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:820
translate es qst_ForgedInFire_Training2Teamwork_repBattle_82ab4d75:

    # MARKUS "Okay then."
    MARKUS "De acuerdo."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:821
translate es qst_ForgedInFire_Training2Teamwork_repBattle_1506ca74:

    # MARKUS "I've sprained my ankle anyways..."
    MARKUS "De todas formas me he torcido el tobillo..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:824
translate es qst_ForgedInFire_Training2Teamwork_repBattle_3c091867:

    # "The rest of the day we have spent learning more nuances about working together as a combat unit."
    "El resto del día lo hemos pasado aprendiendo más detalles sobre el trabajo conjunto como unidad de combate."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:825
translate es qst_ForgedInFire_Training2Teamwork_repBattle_1da7d2b2:

    # "As we have come to realize the importance of teamwork in practice, Duprey's initial statement of it being the crucial aspect of warfare became clear as day."
    "A medida que nos hemos ido dando cuenta de la importancia del trabajo en equipo en la práctica, la afirmación inicial de Duprey de que es el aspecto crucial de la guerra se ha hecho más clara que el agua."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:826
translate es qst_ForgedInFire_Training2Teamwork_repBattle_73c0dac8:

    # "We had to {i}become{/i} the Second Scouts Division."
    "Teníamos que {i}convertirnos{/i} en la segunda división de exploradores."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:832
translate es qst_ForgedInFire_Training2Teamwork_repBattle_5d262372:

    # DUPREY "...So, that will be it for today, Scouts."
    DUPREY "...Entonces, eso será todo por hoy, exploradores."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:833
translate es qst_ForgedInFire_Training2Teamwork_repBattle_b8c44b07:

    # DUPREY "And one more thing..."
    DUPREY "Y una cosa más..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:834
translate es qst_ForgedInFire_Training2Teamwork_repBattle_f2c412ef:

    # DUPREY "We can't be training in this cage forever,"
    DUPREY "No podemos estar entrenando en esta jaula para siempre,"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:835
translate es qst_ForgedInFire_Training2Teamwork_repBattle_fc3f4089:

    # "Duprey waved at the walls,"
    "Duprey hizo un gesto hacia las paredes."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:836
translate es qst_ForgedInFire_Training2Teamwork_repBattle_5bc59c1b:

    # DUPREY "But before we begin any real training maneuvers, I need to see just how much you lot had learned since you've got here."
    DUPREY "pero antes de empezar cualquier maniobra de entrenamiento real, necesito ver cuánto habéis aprendido desde que estáis aquí."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:837
translate es qst_ForgedInFire_Training2Teamwork_repBattle_37c4720a:

    # DUPREY "Hit that bunk hard for there will be a test tomorrow!"
    DUPREY "¡Descansad en esa litera con fuerza porque mañana habrá examen!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:838
translate es qst_ForgedInFire_Training2Teamwork_repBattle_ee4f7f5b:

    # DUPREY "Dismissed!"
    DUPREY "¡Rompan filas!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:843
translate es qst_ForgedInFire_Training2Teamwork_repBattle_70c270b5:

    # "Me and Markus exchanged looks."
    "Markus y yo intercambiamos miradas."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:844
translate es qst_ForgedInFire_Training2Teamwork_repBattle_5dbd6a38:

    # MARKUS "A test, huh?"
    MARKUS "Una prueba, ¿eh?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:845
translate es qst_ForgedInFire_Training2Teamwork_repBattle_0da95cfe:

    # MC "Whatever it is, let's go get some sleep."
    MC "Sea lo que sea, vamos a dormir un poco."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:863
translate es qst_ForgedInFire_Training2NightEvent_6d3b7e65:

    # "In the dead of night, I was restless."
    "A altas horas de la noche, estaba inquieto."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:868
translate es qst_ForgedInFire_Training2NightEvent_8c266e01:

    # "Opening my eyes, I sat-upright in my bunk and looked around."
    "Al abrir los ojos, me senté en la litera y miré a mi alrededor."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:870
translate es qst_ForgedInFire_Training2NightEvent_ccd5a8ea:

    # "Everyone around me was deep in sleep still, including Markus."
    "Todos a mi alrededor seguían profundamente dormidos, incluido Markus."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:871
translate es qst_ForgedInFire_Training2NightEvent_03bec688:

    # "I sighed, rubbing my forehead as I climbed out of bed."
    "Suspiré, frotándome la frente mientras salía de la cama."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:872
translate es qst_ForgedInFire_Training2NightEvent_b9564fe7:

    # "{i}Just a short walk around the fort grounds{/i} I told myself..."
    "{i}Solo un corto paseo por el recinto del fuerte{/i}, me dije..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:873
translate es qst_ForgedInFire_Training2NightEvent_af74cbd2:

    # "I'll be back before anyone even realizes I'm gone."
    "Volveré antes de que nadie se dé cuenta de que me he ido."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:880
translate es qst_ForgedInFire_Training2NightEvent_59eaf8b8:

    # "As the cold night air hit my lungs, I thought about heading back inside before I heard Captain Duprey's voice."
    "Mientras el aire frío de la noche golpeaba mis pulmones, pensé en volver a entrar antes de oír la voz del capitán Duprey."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:881
translate es qst_ForgedInFire_Training2NightEvent_4acebe14:

    # DUPREY "Thank you all for coming..."
    DUPREY "Gracias a todos por venir..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:882
translate es qst_ForgedInFire_Training2NightEvent_14ad4098:

    # MC "(Hm? What's going on?)"
    MC "(¿Qué? ¿Qué está pasando?)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:883
translate es qst_ForgedInFire_Training2NightEvent_b6dd5166:

    # MC "(It sounds like it's coming from the training yard.)"
    MC "(Parece que viene del patio de entrenamiento)."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:895
translate es qst_ForgedInFire_Training2NightEvent_f159a15b:

    # "Peering around the corner, Captain Duprey stood alongside Borras as two figures joined them."
    "Al girar la esquina, el capitán Duprey se situó junto a Borras cuando dos figuras se unieron a ellos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:898
translate es qst_ForgedInFire_Training2NightEvent_683fa502:

    # "The first, a beautiful, yet stern and cold looking blonde in a hooded robe."
    "La primera, una rubia hermosa pero de aspecto severo y frío, vestida con una túnica con capucha."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:899
translate es qst_ForgedInFire_Training2NightEvent_39c09853:

    # "The other, a man of larger stature who I had not seen either."
    "El otro, un hombre de mayor estatura al que tampoco había visto."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:906
translate es qst_ForgedInFire_Training2NightEvent_c3816f8a:

    # NYX_BLONDE @ angry "Well, out with it."
    NYX_BLONDE @ angry "Bueno, acabemos con esto."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:907
translate es qst_ForgedInFire_Training2NightEvent_829708c2:

    # NYX_BLONDE @ angry "Why did you ask us to meet here and not in my office?"
    NYX_BLONDE @ angry "¿Por qué nos has pedido que nos reunamos aquí y no en mi despacho?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:908
translate es qst_ForgedInFire_Training2NightEvent_0e5dab11:

    # NYX_BLONDE @ angry "I'm freezing my tits off out here you know."
    NYX_BLONDE @ angry "Me estoy congelando las tetas aquí fuera, ¿sabes?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:909
translate es qst_ForgedInFire_Training2NightEvent_f5d90ff9:

    # LUKKAN_THE_BIG_GUY @ happy "I could keep them warm for you if you wish."
    LUKKAN_THE_BIG_GUY @ happy "Podría mantenerlas calientes para ti si lo deseas."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:911
translate es qst_ForgedInFire_Training2NightEvent_8cce2042:

    # NYX_BLONDE @ angry "Lay a hand on me and you will never {i}touch{/i} anything again."
    NYX_BLONDE @ angry "Ponme una mano encima y nunca volverás a {i}tocar{/i} nada."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:912
translate es qst_ForgedInFire_Training2NightEvent_ccb33939:

    # LUKKAN_THE_BIG_GUY @ happy "Feisty as always."
    LUKKAN_THE_BIG_GUY @ happy "Enérgica como siempre."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:909
translate es qst_ForgedInFire_Training2NightEvent_7d3baf97:

    # DUPREY "I'm sorry for summoning you both at such a late hour."
    DUPREY "Siento haberos convocado a las dos a una hora tan tardía."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:910
translate es qst_ForgedInFire_Training2NightEvent_438696b5:

    # DUPREY "I couldn't risk the potential of spies listening in on what I had to say now."
    DUPREY "No podía arriesgarme a que espías escucharan lo que tenía que decir ahora."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:915
translate es qst_ForgedInFire_Training2NightEvent_15a278d5:

    # NYX_BLONDE @ angry "And out here is safer than my office how?"
    NYX_BLONDE @ angry "¿Y cómo es que aquí fuera es más seguro que en mi oficina?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:912
translate es qst_ForgedInFire_Training2NightEvent_8ea753ae:

    # DUPREY "{i}*Sigh*{/i} I recently conducted a private search across the whole fortress with only my most trusted men."
    DUPREY "{i}*Suspiro*{/i} Hace poco realicé una inspección privada en toda la fortaleza solo con mis hombres de mayor confianza."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:913
translate es qst_ForgedInFire_Training2NightEvent_627d96fc:

    # DUPREY "I found echo crystals everywhere... including your office."
    DUPREY "Encontré cristales de eco por todas partes... incluida tu oficina."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:918
translate es qst_ForgedInFire_Training2NightEvent_0e306341:

    # NYX_BLONDE @ shock "You..."
    NYX_BLONDE @ shock "Tú..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:919
translate es qst_ForgedInFire_Training2NightEvent_2b146927:

    # NYX_BLONDE @ shock "{i}Echo crystals?{/i}"
    NYX_BLONDE @ shock "{i}¿Cristales de eco?{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:920
translate es qst_ForgedInFire_Training2NightEvent_c7cc2c81:

    # NYX_BLONDE @ angry "That can't be right, I have my office checked, I-"
    NYX_BLONDE @ angry "Eso no puede estar bien, tengo mi oficina revisada, yo-"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:917
translate es qst_ForgedInFire_Training2NightEvent_7233b5ac:

    # "Duprey nodded, holding up a small, glowing yellow crystal that he tossed to the robed blonde."
    "Duprey asintió y levantó un pequeño cristal amarillo brillante que arrojó a la rubia cubierta por una túnica."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:920
translate es qst_ForgedInFire_Training2NightEvent_b21cd245:

    # DUPREY "I'm afraid it's so."
    DUPREY "Me temo que es así."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:921
translate es qst_ForgedInFire_Training2NightEvent_3e335085:

    # "The woman inspected the crystal and gritted her teeth in anger at it."
    "La mujer inspeccionó el cristal y apretó los dientes de rabia al verlo."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:922
translate es qst_ForgedInFire_Training2NightEvent_1faccc03:

    # DUPREY "It seems our great {i}'emperor'{/i} does not hold our loyalty in high regard."
    DUPREY "Parece que nuestro gran {i}'emperador'{/i} no tiene en alta estima nuestra lealtad."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:923
translate es qst_ForgedInFire_Training2NightEvent_d6956b86:

    # "The larger man chuckled."
    "El hombre más corpulento soltó una risita."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:928
translate es qst_ForgedInFire_Training2NightEvent_cac71787:

    # LUKKAN_THE_BIG_GUY @ happy "After everything that's happened, can you truly blame him?"
    LUKKAN_THE_BIG_GUY @ happy "Después de todo lo que ha pasado, ¿puedes realmente culparle?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:925
translate es qst_ForgedInFire_Training2NightEvent_e7113e66:

    # "The blonde woman seemed more frustrated than the others, coiling her one hand into a tight fist."
    "La mujer rubia parecía más frustrada que los demás y cerró una mano en un puño."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:930
translate es qst_ForgedInFire_Training2NightEvent_897edc9c:

    # LUKKAN_THE_BIG_GUY @ happy "Come now, this is all part of the game."
    LUKKAN_THE_BIG_GUY @ happy "Vamos, todo esto es parte del juego."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:931
translate es qst_ForgedInFire_Training2NightEvent_da595d25:

    # NYX_BLONDE @ angry "Yes, I... I am aware."
    NYX_BLONDE @ angry "Sí, yo... yo soy consciente."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:928
translate es qst_ForgedInFire_Training2NightEvent_aed55156:

    # DUPREY "The guards only patrol this area periodically, and it's the one place no echo crystals turned up during the search."
    DUPREY "Los guardias solo patrullan esta zona periódicamente, y es el único lugar donde no aparecieron cristales de eco durante la inspección."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:929
translate es qst_ForgedInFire_Training2NightEvent_cf9fe043:

    # DUPREY "I suppose they figured the chatter of grunts wasn't worth hearing."
    DUPREY "Supongo que pensaron que no valía la pena oír el parloteo de los soldados."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:930
translate es qst_ForgedInFire_Training2NightEvent_4b3ecc3c:

    # DUPREY "Which is exactly why we're meeting here now."
    DUPREY "Que es exactamente por lo que nos reunimos aquí ahora."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:931
translate es qst_ForgedInFire_Training2NightEvent_97cd58fc:

    # "The larger man raised his brow."
    "El hombre más corpulento levantó su frente."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:936
translate es qst_ForgedInFire_Training2NightEvent_c4efb787:

    # LUKKAN_THE_BIG_GUY @ think "That's all well and good... But why exactly is {i}he{/i} here?"
    LUKKAN_THE_BIG_GUY @ think "Eso está muy bien... Pero, ¿por qué está {i}él{/i} aquí exactamente?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:933
translate es qst_ForgedInFire_Training2NightEvent_0ecda2cd:

    # "The man pointed towards Borras, whose brow furrowed at the comment."
    "El hombre señaló a Borras, cuyo ceño se frunció ante el comentario."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:938
translate es qst_ForgedInFire_Training2NightEvent_a377fbed:

    # LUKKAN_THE_BIG_GUY @ angry "He's hardly fit to stand here with the rest of us."
    LUKKAN_THE_BIG_GUY @ angry "Apenas es apto para estar aquí con el resto de nosotros."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:935
translate es qst_ForgedInFire_Training2NightEvent_000b3a6c:

    # DUPREY "Officer Borras will be replacing me for command of the Second Scouts Division, within a year or so."
    DUPREY "El oficial Borras me sustituirá en el mando de la segunda división de exploradores, dentro de un año más o menos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:940
translate es qst_ForgedInFire_Training2NightEvent_ade1214e:

    # NYX_BLONDE @ shock "You're leaving?"
    NYX_BLONDE @ shock "¿Te marcharás?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:937
translate es qst_ForgedInFire_Training2NightEvent_2897e861:

    # DUPREY "My time is nearly up... I'm slowing down too much."
    DUPREY "Mi tiempo casi se acaba... Me estoy ralentizando demasiado."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:938
translate es qst_ForgedInFire_Training2NightEvent_1d99c218:

    # "While the blonde seemed saddened to hear this, the larger man opened his palm upwards towards the sky."
    "Mientras la rubia parecía entristecerse al oírlo, el hombre más corpulento abrió la palma de la mano hacia el cielo."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:943
translate es qst_ForgedInFire_Training2NightEvent_c246e162:

    # LUKKAN_THE_BIG_GUY @ talk "I hope you didn't drag us out here to discuss your future retirement plans you old fuck."
    LUKKAN_THE_BIG_GUY @ talk "Espero que no nos hayas arrastrado hasta aquí para discutir tus futuros planes de jubilación, viejo cabrón."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:940
translate es qst_ForgedInFire_Training2NightEvent_dd633049:

    # DUPREY "Hmph..."
    DUPREY "Hmph..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:941
translate es qst_ForgedInFire_Training2NightEvent_07d9c1a1:

    # DUPREY "Officer Borras, hand them the reports."
    DUPREY "Oficial Borras, entrégales los informes."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:942
translate es qst_ForgedInFire_Training2NightEvent_85fc15c1:

    # BORRAS @ talk "Yes Captain."
    BORRAS @ talk "Sí, capitán."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:944
translate es qst_ForgedInFire_Training2NightEvent_a550ea4e:

    # "Borras handed over a few sheets of paper towards the robed pair."
    "Borras entregó unas hojas de papel a la pareja con túnica."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:949
translate es qst_ForgedInFire_Training2NightEvent_e077ed9f:

    # LUKKAN_THE_BIG_GUY @ talk "What's this?"
    LUKKAN_THE_BIG_GUY @ talk "¿Qué es esto?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:946
translate es qst_ForgedInFire_Training2NightEvent_cbb0024b:

    # DUPREY "A report that Alcott attempted to suppress."
    DUPREY "Un informe que Alcott intentó ocultar."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:951
translate es qst_ForgedInFire_Training2NightEvent_0873ff5f:

    # LUKKAN_THE_BIG_GUY @ think "About?"
    LUKKAN_THE_BIG_GUY @ think "¿Sobre?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:948
translate es qst_ForgedInFire_Training2NightEvent_dfb5dc62:

    # DUPREY "...{i}Zanarak has returned.{/i}"
    DUPREY "...{i}Zanarak ha regresado.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:949
translate es qst_ForgedInFire_Training2NightEvent_dbf78d30:

    # "A great unease filled the air and I felt a shiver tingle it's way up my spine."
    "Un gran malestar invadió el ambiente y sentí un escalofrío que me recorrió la espalda."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:950
translate es qst_ForgedInFire_Training2NightEvent_506be64d:

    # "The name crawled and dragged its way horribly across my thoughts."
    "El nombre se arrastró y se abrió paso horriblemente por mis pensamientos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:955
translate es qst_ForgedInFire_Training2NightEvent_04766be0:

    # LUKKAN_THE_BIG_GUY @ happy "There hasn't been a sighting in years."
    LUKKAN_THE_BIG_GUY @ happy "No ha habido ningún avistamiento en años."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:956
translate es qst_ForgedInFire_Training2NightEvent_ad6d35ce:

    # NYX_BLONDE @ talk "Wasn't it reported that the beast was hunted down by the Inquisition?"
    NYX_BLONDE @ talk "¿No se dijo que la bestia fue abatida por la Inquisición?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:953
translate es qst_ForgedInFire_Training2NightEvent_cbbee22b:

    # DUPREY "A lie told to ease panicking nobles."
    DUPREY "Una mentira contada para calmar el pánico de los nobles."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:954
translate es qst_ForgedInFire_Training2NightEvent_38a43a2d:

    # DUPREY "While it is true the beast has vanished for the last few years, this cannot be ignored."
    DUPREY "Si bien es cierto que la bestia ha desaparecido en los últimos años, esto no puede ignorarse."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:955
translate es qst_ForgedInFire_Training2NightEvent_78892759:

    # DUPREY "The beast's return... changes things."
    DUPREY "El retorno de la bestia... cambia las cosas."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:960
translate es qst_ForgedInFire_Training2NightEvent_7a86413b:

    # LUKKAN_THE_BIG_GUY @ talk "A specter, a boogeyman..."
    LUKKAN_THE_BIG_GUY @ talk "Un espectro, un hombre del saco..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:961
translate es qst_ForgedInFire_Training2NightEvent_a777b442:

    # LUKKAN_THE_BIG_GUY @ talk "There are dozens of Demorai over the years that people have wrongly mistaken for being Zanarak."
    LUKKAN_THE_BIG_GUY @ talk "Hay docenas de demorai a lo largo de los años que la gente ha confundido erróneamente con Zanarak."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:958
translate es qst_ForgedInFire_Training2NightEvent_086782c0:

    # "The man belligerently crossed his arms."
    "El hombre se cruzó de brazos con agresividad."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:963
translate es qst_ForgedInFire_Training2NightEvent_ee8e9a7d:

    # LUKKAN_THE_BIG_GUY @ talk "...I'm not even convinced this Zanarak was real to begin with."
    LUKKAN_THE_BIG_GUY @ talk "...Ni siquiera estoy convencido de que este Zanarak fuera real para empezar."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:960
translate es qst_ForgedInFire_Training2NightEvent_8ebb0762:

    # DUPREY "Oh... He's as real as you and I alright."
    DUPREY "Oh... Él es tan real como tú y yo."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:961
translate es qst_ForgedInFire_Training2NightEvent_ba99ad23:

    # DUPREY "Make no mistake about that."
    DUPREY "No te equivoques."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:962
translate es qst_ForgedInFire_Training2NightEvent_6b72d9c8:

    # DUPREY "...And when he comes, all of us need to be prepared."
    DUPREY "...Y cuando venga, todos debemos estar preparados."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:963
translate es qst_ForgedInFire_Training2NightEvent_2bce0fc0:

    # DUPREY "With, {i}or without{/i} the Emperors knowledge."
    DUPREY "Con o {i}sin{/i} el conocimiento del Emperador."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:968
translate es qst_ForgedInFire_Training2NightEvent_3cdbebf1:

    # NYX_BLONDE @ angry "What are you saying, Duprey?"
    NYX_BLONDE @ angry "¿Qué estás diciendo, Duprey?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:965
translate es qst_ForgedInFire_Training2NightEvent_59e5864b:

    # DUPREY "I'm saying, Alcott can bury his head in the fucking sand and play politics all he wants to try and appease wet-fart nobles."
    DUPREY "Lo que digo es que Alcott puede esconder la cabeza en la puta arena y jugar a la política todo lo que quiera para intentar apaciguar a los nobles cagados de miedo."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:966
translate es qst_ForgedInFire_Training2NightEvent_fcc3f2c9:

    # DUPREY "{i}But we need to be prepared for what's to come whether this knowledge is made public or not.{/i}"
    DUPREY "{i}Pero tenemos que estar preparados para lo que está por venir, tanto si este conocimiento se hace público como si no.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:971
translate es qst_ForgedInFire_Training2NightEvent_18e7a24a:

    # NYX_BLONDE @ talk "Duprey... You need to tread carefully with this."
    NYX_BLONDE @ talk "Duprey... Tienes que tener cuidado con esto."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:972
translate es qst_ForgedInFire_Training2NightEvent_5b839082:

    # NYX_BLONDE @ talk "How exactly did {i}you{/i} manage to get your hands on this report anyway?"
    NYX_BLONDE @ talk "¿Exactamente cómo {i}has{/i} conseguido hacerte con este informe?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:969
translate es qst_ForgedInFire_Training2NightEvent_a2aca459:

    # BORRAS @ talk "By pure chance."
    BORRAS @ talk "Por pura casualidad."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:970
translate es qst_ForgedInFire_Training2NightEvent_a174e1ce:

    # "Borras stepped forward."
    "Borras dio un paso adelante."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:971
translate es qst_ForgedInFire_Training2NightEvent_913c0dc3:

    # BORRAS @ talk "I was on a normal patrol through the Valley of Death when I stumbled upon a small, slaughtered convoy."
    BORRAS @ talk "Estaba en una patrulla normal por el Valle de la Muerte cuando me topé con un pequeño convoy masacrado."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:972
translate es qst_ForgedInFire_Training2NightEvent_787647a3:

    # BORRAS @ talk "Amongst their dead was an Inquisitor, who with his dying breath handed me this report."
    BORRAS @ talk "Entre sus muertos había un inquisidor, que con su último aliento me entregó este informe."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:977
translate es qst_ForgedInFire_Training2NightEvent_a7d9dd7a:

    # LUKKAN_THE_BIG_GUY @ talk "The dying words of a delusional Inquisitor on death's door mean very little."
    LUKKAN_THE_BIG_GUY @ talk "Las últimas palabras de un inquisidor delirante a las puertas de la muerte significan muy poco."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:974
translate es qst_ForgedInFire_Training2NightEvent_46254da9:

    # BORRAS @ talk "There was other reports..."
    BORRAS @ talk "Hubo otros informes..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:979
translate es qst_ForgedInFire_Training2NightEvent_f3335e6e:

    # LUKKAN_THE_BIG_GUY @ think "What?"
    LUKKAN_THE_BIG_GUY @ think "¿Qué?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:976
translate es qst_ForgedInFire_Training2NightEvent_825a1215:

    # BORRAS @ talk "Suppressed as soon as they arrive, but more and more scant reports from our men on the fringes have reported seeing it."
    BORRAS @ talk "Suprimidos en cuanto llegan, pero cada vez son más los escasos informes de nuestros hombres en la periferia que dicen haberlos visto."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:977
translate es qst_ForgedInFire_Training2NightEvent_0d7eadc0:

    # "Both the woman and man were troubled the more they heard."
    "Tanto la mujer como el hombre se preocuparon más cuanto más oían."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:978
translate es qst_ForgedInFire_Training2NightEvent_f2428e23:

    # DUPREY "From now on, the three of us need to work closer together."
    DUPREY "A partir de ahora, los tres tenemos que trabajar más unidos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:983
translate es qst_ForgedInFire_Training2NightEvent_a899d6c2:

    # NYX_BLONDE @ angry "The city guard is barely holding on as it is, what exactly do you expect me to do?"
    NYX_BLONDE @ angry "La guardia de la ciudad apenas aguanta, ¿qué esperas que haga exactamente?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:980
translate es qst_ForgedInFire_Training2NightEvent_b10a0545:

    # DUPREY "Whatever you have to do when the time comes."
    DUPREY "Lo que sea que tengas que hacer cuando llegue el momento."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:981
translate es qst_ForgedInFire_Training2NightEvent_6afc1660:

    # "Duprey seemed to be working himself up into a feverish plea."
    "Duprey parecía estar trabajando en una súplica febril."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:982
translate es qst_ForgedInFire_Training2NightEvent_104f25e1:

    # DUPREY "These little camps everyone's set up is leaving us more divided than ever, it'll be the ruin of us all!"
    DUPREY "Estos pequeños campamentos que todo el mundo ha montado nos están dejando más divididos que nunca, ¡será la ruina de todos nosotros!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:983
translate es qst_ForgedInFire_Training2NightEvent_2e21a987:

    # DUPREY "We need to unite and pledge to each other that when the time comes-"
    DUPREY "Tenemos que unirnos y comprometernos a que cuando llegue el momento-"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:988
translate es qst_ForgedInFire_Training2NightEvent_59c8c819:

    # LUKKAN_THE_BIG_GUY @ talk "I promise you nothing, Duprey."
    LUKKAN_THE_BIG_GUY @ talk "No te prometo nada, Duprey."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:985
translate es qst_ForgedInFire_Training2NightEvent_e629b28d:

    # "The broad man's words cut through Duprey's like ice."
    "Las palabras del hombre corpulento atravesaron las de Duprey como el hielo."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:990
translate es qst_ForgedInFire_Training2NightEvent_b4c2c3b7:

    # LUKKAN_THE_BIG_GUY @ talk "...But I shall look into these reports myself."
    LUKKAN_THE_BIG_GUY @ talk "...Pero yo mismo investigaré esos informes."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:991
translate es qst_ForgedInFire_Training2NightEvent_ebf4078c:

    # LUKKAN_THE_BIG_GUY @ talk "And depending on what I find, {i}perhaps{/i} there will be more to discuss."
    LUKKAN_THE_BIG_GUY @ talk "Y dependiendo de lo que encuentre, {i}quizá{/i} haya más que discutir."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:988
translate es qst_ForgedInFire_Training2NightEvent_e102cb4c:

    # "The broad man turned to leave, and as he did so, Captain Duprey looked towards the woman."
    "El hombre corpulento se giró para marcharse y, mientras lo hacía, el capitán Duprey miró hacia la mujer."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:993
translate es qst_ForgedInFire_Training2NightEvent_6ff2487b:

    # NYX_BLONDE @ sad "... I don't know, Duprey, this just maybe isn't the right time."
    NYX_BLONDE @ sad "...No lo sé, Duprey, tal vez no sea el momento adecuado."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:994
translate es qst_ForgedInFire_Training2NightEvent_ece5bef6:

    # NYX_BLONDE @ sad "The more we unite our forces, the more we paint ourselves a target for the other factions."
    NYX_BLONDE @ sad "Cuanto más unamos nuestras fuerzas, más nos convertiremos en un objetivo para las otras facciones."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:991
translate es qst_ForgedInFire_Training2NightEvent_f5cdc275:

    # DUPREY "... I don't care about the factions."
    DUPREY "...No me importan las facciones."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:992
translate es qst_ForgedInFire_Training2NightEvent_361df80b:

    # DUPREY "I don't care about the politics of the damn thing."
    DUPREY "No me importa la política del maldito asunto."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:993
translate es qst_ForgedInFire_Training2NightEvent_538b8cf8:

    # DUPREY "What does any of that matter if there's no one left in the end?"
    DUPREY "¿Qué importa todo eso si al final no queda nadie?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:994
translate es qst_ForgedInFire_Training2NightEvent_c7e9daac:

    # DUPREY "Newheart is gone... There's no one left to save us but ourselves now."
    DUPREY "Newheart se ha ido... Ya no queda nadie más que nosotros para salvarnos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:999
translate es qst_ForgedInFire_Training2NightEvent_0e94a49a:

    # NYX_BLONDE @ sad "...Goodnight, Duprey."
    NYX_BLONDE @ sad "...Buenas noches, Duprey."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1000
translate es qst_ForgedInFire_Training2NightEvent_2d5676a4:

    # NYX_BLONDE @ sad "I hope you're wrong about all this... I really do."
    NYX_BLONDE @ sad "Espero que te equivoques en todo esto... Realmente lo espero."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:997
translate es qst_ForgedInFire_Training2NightEvent_3bff260d:

    # "The woman turned to leave and join the broad man, leaving Captain Duprey to stand beside Officer Borras alone."
    "La mujer se dio la vuelta para marcharse y reunirse con el hombre corpulento, dejando al capitán Duprey solo junto al oficial Borras."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1001
translate es qst_ForgedInFire_Training2NightEvent_9b060e61:

    # "As the two figures passed me by, I hid myself behind a barrel and waited for them to be out of sight."
    "Mientras las dos figuras pasaban a mi lado, me escondí detrás de un barril y esperé a que se perdieran de vista."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1005
translate es qst_ForgedInFire_Training2NightEvent_d553e83d:

    # BORRAS @ talk "Captain..."
    BORRAS @ talk "Capitán..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1006
translate es qst_ForgedInFire_Training2NightEvent_eba06326:

    # DUPREY "Return to your quarters, Borras."
    DUPREY "Vuelve a tus aposentos, Borras."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1007
translate es qst_ForgedInFire_Training2NightEvent_6fa2cda7:

    # DUPREY "Speak nothing of what has been said tonight."
    DUPREY "No hables de lo que se ha dicho esta noche."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1008
translate es qst_ForgedInFire_Training2NightEvent_f9c712a9:

    # BORRAS @ sad "But-"
    BORRAS @ sad "Pero-"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1009
translate es qst_ForgedInFire_Training2NightEvent_87e8ae86:

    # DUPREY "I'm tired Borras... So very tired."
    DUPREY "Estoy cansado Borras... Muy cansado."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1010
translate es qst_ForgedInFire_Training2NightEvent_0ae2d5a5:

    # DUPREY "The next battle can wait for another day."
    DUPREY "La próxima batalla puede esperar otro día."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1013
translate es qst_ForgedInFire_Training2NightEvent_a5187100:

    # "Slowly, I watched as Captain Duprey slumped towards the barracks, likely back to his quarters."
    "Lentamente, vi cómo el capitán Duprey se marchaba hacia los barracones, probablemente de vuelta a sus aposentos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1015
translate es qst_ForgedInFire_Training2NightEvent_e034c8e5:

    # MC "(Zanarak... Can it really be?)"
    MC "(Zanarak... ¿Realmente puede ser?)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1017
translate es qst_ForgedInFire_Training2NightEvent_97d93231:

    # "I shook my head, pushing the terrible thoughts away."
    "Sacudí la cabeza, alejando los terribles pensamientos...."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1018
translate es qst_ForgedInFire_Training2NightEvent_d2897e6b:

    # MC "(I need to return to my bed, before someone sees me.)"
    MC "(Necesito volver a mi cama, antes de que alguien me vea)."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1024
translate es qst_ForgedInFire_Training2NightEvent_97284131:

    # "As I laid down onto the bed, dark, terrible thoughts and dreams returned."
    "Cuando me tumbé en la cama, volvieron pensamientos y sueños oscuros y terribles."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1025
translate es qst_ForgedInFire_Training2NightEvent_af180033:

    # "Returned to torment me for the rest of the night."
    "Volvieron para atormentarme el resto de la noche."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1043
translate es qst_ForgedInFire_Training3Final_eb24fb27:

    # DUPREY "Alright maggots, today I will see whether you lot have made any progress or had you just wasted my time!"
    DUPREY "¡Muy bien, gusanos, hoy veré si habéis hecho algún progreso o si solo me habéis hecho perder el tiempo!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1044
translate es qst_ForgedInFire_Training3Final_884243ea:

    # DUPREY "We will start with duels first!"
    DUPREY "¡Empezaremos primero con los duelos!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1045
translate es qst_ForgedInFire_Training3Final_62189e19:

    # DUPREY "Partner up, grab yourself a healing vial, and fight as if your life depended on it!"
    DUPREY "¡Formad parejas, coged un vial de curación y luchad como si vuestra vida dependiera de ello!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1050
translate es qst_ForgedInFire_Training3Final_761342c6:

    # MC "Shit got real, huh?"
    MC "Las cosas se pusieron feas, ¿eh?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1051
translate es qst_ForgedInFire_Training3Final_67044540:

    # "Markus was certainly not going to fool around this time."
    "Desde luego, Markus no iba a andarse con tonterías esta vez."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1018
translate es qst_ForgedInFire_Training3Final_d92306b7:

    # MARKUS @ angry "Come on, [player_name!t], let's do this!"
    MARKUS @ angry "¡Vamos, [player_name!t], hagámoslo!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1053
translate es qst_ForgedInFire_Training3Final_bc95234e:

    # MC @ angry "Alright, bring it on then!"
    MC @ angry "Muy bien, ¡adelante entonces!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1076
translate es qst_ForgedInFire_Training3Final_Lose_1263e952:

    # "Ouch."
    "Ay."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1077
translate es qst_ForgedInFire_Training3Final_Lose_c58b41a1:

    # "Darkness."
    "Oscuridad."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1078
translate es qst_ForgedInFire_Training3Final_Lose_8f6cd72d:

    # "Then, dim light telling shapes apart."
    "Luego, una luz tenue que separa las formas."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1079
translate es qst_ForgedInFire_Training3Final_Lose_ce93bfa4:

    # "A vision."
    "Una visión."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1080
translate es qst_ForgedInFire_Training3Final_Lose_a05d37f2:

    # "A vision of Alderay under demonic onslaught."
    "Una visión de Alderay bajo el ataque demoníaco."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1081
translate es qst_ForgedInFire_Training3Final_Lose_f32b1941:

    # "Of me, defending it's people."
    "De mí, defendiendo a su gente."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1082
translate es qst_ForgedInFire_Training3Final_Lose_27cd56c1:

    # "Uniting them under my banners."
    "Uniéndolos bajo mis estandartes."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1083
translate es qst_ForgedInFire_Training3Final_Lose_63b84b20:

    # "Power."
    "Poder."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1084
translate es qst_ForgedInFire_Training3Final_Lose_008f17f9:

    # "Wealth."
    "Riqueza."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1085
translate es qst_ForgedInFire_Training3Final_Lose_d7eea514:

    # "Women..."
    "Mujeres..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1086
translate es qst_ForgedInFire_Training3Final_Lose_b6ce6190:

    # "However, there is something else."
    "Sin embargo, hay algo más."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1087
translate es qst_ForgedInFire_Training3Final_Lose_8bf4ebd2:

    # "Something that drives me onwards, something from outside..."
    "Algo que me impulsa hacia adelante, algo de fuera..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1088
translate es qst_ForgedInFire_Training3Final_Lose_90b93b6a:

    # "It's..."
    "Es..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1091
translate es qst_ForgedInFire_Training3Final_Lose_d1df3db6:

    # "Ice-cold water!"
    "¡Agua helada!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1098
translate es qst_ForgedInFire_Training3Final_Lose_bc5c4518:

    # DUPREY "{b}ON YOUR FEET, MAGGOT!{/b}"
    DUPREY "{b}¡DE PIE, GUSANO!{/b}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1099
translate es qst_ForgedInFire_Training3Final_Lose_5ad11caa:

    # "Captain Duprey's heavy kick quickly stood me up straight, recent knockout echoing in my head with an irritating, pulsing pain."
    "La fuerte patada del capitán Duprey me puso rápidamente en pie, el reciente golpe resonó en mi cabeza con un dolor irritante y palpitante."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1100
translate es qst_ForgedInFire_Training3Final_Lose_e7a57264:

    # DUPREY "Go again, Demorai won't wait for you to come back to your senses!"
    DUPREY "¡Otra vez, los demorai no esperarán a que vuelvas en ti!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1101
translate es qst_ForgedInFire_Training3Final_Lose_032e9f26:

    # MC "(Gotta get a grip...)"
    MC "(Tengo que controlarme...)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1102
translate es qst_ForgedInFire_Training3Final_Lose_523ecf6e:

    # DUPREY @ angry "I'm trying to be nice to you maggot, now go again!"
    DUPREY @ angry "Estoy tratando de ser amable contigo gusano, ¡ahora ve otra vez!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1114
translate es qst_ForgedInFire_FinalSparring_Complete_6a4925e0:

    # MARKUS "Gah! You sure know how to make it hurt!"
    MARKUS "¡Gah! ¡Realmente sabes cómo hacer que duela!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1115
translate es qst_ForgedInFire_FinalSparring_Complete_0fb6a986:

    # MC "{i}*Huff*{/i} Someone’s had to knock some sense into you!"
    MC "{i}*Uff*{/i} ¡Alguien tenía que hacerte entrar en razón!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1116
translate es qst_ForgedInFire_FinalSparring_Complete_66516ca5:

    # "As me and Markus caught our breath, I noticed an unusual figure dressed in fine fabrics speaking to the Captain."
    "Mientras Markus y yo recuperábamos el aliento, me fijé en una figura inusual vestida con telas finas que hablaba con el capitán."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1117
translate es qst_ForgedInFire_FinalSparring_Complete_163ee6d6:

    # "The Captain seemed unimpressed with whatever the man was saying and seemed to be refusing him something before being handed what seemed like a very official looking letter."
    "El capitán no pareció impresionarse con lo que decía el hombre y pareció negarle algo antes de que le entregaran lo que parecía una carta de aspecto muy oficial."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1118
translate es qst_ForgedInFire_FinalSparring_Complete_783e0863:

    # "I thought I could make out the royal seal."
    "Me pareció distinguir el sello real."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1119
translate es qst_ForgedInFire_FinalSparring_Complete_edb3c6df:

    # "I couldn’t hear what was being said, but I managed to figure out the words escaping his lips, {i}‘They’re not ready yet!’{/i}"
    "No podía oír lo que se decía, pero logré descifrar las palabras que escapaban de sus labios:  {i}¡Aún no están listos!’{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1120
translate es qst_ForgedInFire_FinalSparring_Complete_7e66af39:

    # MARKUS "What’s going on?"
    MARKUS "¿Qué ocurre?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1121
translate es qst_ForgedInFire_FinalSparring_Complete_28993885:

    # "I nudged him to look over towards Duprey."
    "Le di un codazo para que mirara hacia Duprey."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1122
translate es qst_ForgedInFire_FinalSparring_Complete_78c93499:

    # MARKUS "... Is that someone from the palace?"
    MARKUS "... ¿Es alguien del palacio?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1123
translate es qst_ForgedInFire_FinalSparring_Complete_6da37e5e:

    # MC "I think so."
    MC "Creo que sí."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1124
translate es qst_ForgedInFire_FinalSparring_Complete_c390d19a:

    # MARKUS "Since when did the palace send its fancy officials down to us mud and grunts?"
    MARKUS "¿Desde cuándo el palacio nos envía a sus elegantes funcionarios a nosotros, los soldados?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1125
translate es qst_ForgedInFire_FinalSparring_Complete_d52535a2:

    # MARKUS "What do you think they want? It must be serious."
    MARKUS "¿Qué crees que quieren? Debe ser algo serio."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1126
translate es qst_ForgedInFire_FinalSparring_Complete_67965d23:

    # MC "I don’t know... but I don’t think it’s going to be anything good."
    MC "No sé... pero no creo que vaya a ser nada bueno."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1132
translate es qst_ForgedInFire_FinalSparring_Complete_452c6b58:

    # "All of a sudden, the Captain heaved himself reluctantly onto the wooden platform and cried out for our attention."
    "De repente, el capitán se subió a regañadientes a la plataforma de madera y reclamó nuestra atención."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1133
translate es qst_ForgedInFire_FinalSparring_Complete_4074b31d:

    # DUPREY "FORM RANKS!"
    DUPREY "¡FORMEN FILAS!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1135
translate es qst_ForgedInFire_FinalSparring_Complete_7bdc104e:

    # "The tired and weary Scouts hastily moved to form neat rows and face the Captain, hanging on his every word."
    "Los cansados y agotados exploradores se apresuraron a formar filas ordenadas y mirar al Capitán, pendientes de cada una de sus palabras."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1136
translate es qst_ForgedInFire_FinalSparring_Complete_d0187a8e:

    # DUPREY "We have been ordered on early leave for a mission."
    DUPREY "Nos han ordenado salir temprano para una misión."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1137
translate es qst_ForgedInFire_FinalSparring_Complete_af5fac36:

    # "Confused mutterings swept through the ranks, as most of us expected the training to last for months."
    "Murmullos confusos recorrieron las filas, ya que la mayoría esperábamos que el entrenamiento durara meses."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1138
translate es qst_ForgedInFire_FinalSparring_Complete_41c2d6b4:

    # DUPREY "SILENCE!!!"
    DUPREY "¡¡¡SILENCIO!!!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1139
translate es qst_ForgedInFire_FinalSparring_Complete_219c5f53:

    # DUPREY "This order has come down from Emperor Alcott himself and has been approved by King Mesamor."
    DUPREY "Esta orden viene del mismísimo emperador Alcott y ha sido aprobada por el rey Mesamor."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1140
translate es qst_ForgedInFire_FinalSparring_Complete_8b792546:

    # DUPREY "We leave come first light tomorrow."
    DUPREY "Saldremos mañana al amanecer."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1141
translate es qst_ForgedInFire_FinalSparring_Complete_0fa47cd9:

    # DUPREY "Get to bed early, make sure you’re well fed and be absolutely certain that your equipment is clean and ready."
    DUPREY "Es necesario acostarse pronto, alimentarse bien y estar absolutamente seguro de que el equipo está limpio y a punto."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1142
translate es qst_ForgedInFire_FinalSparring_Complete_cae6e8d4:

    # "A timid hand was raised from the crowd."
    "Una tímida mano se levantó entre la multitud."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1143
translate es qst_ForgedInFire_FinalSparring_Complete_c2e2d792:

    # DUPREY "What is it?"
    DUPREY "¿De qué se trata?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1149
translate es qst_ForgedInFire_FinalSparring_Complete_13b24539:

    # RECRUIT "Where are we to be sent, sir?"
    RECRUIT "¿Adónde nos enviarán, señor?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1146
translate es qst_ForgedInFire_FinalSparring_Complete_544b0d7d:

    # DUPREY "The mission is top secret, all I can tell you is that you will be recovering relics from a lost fortress south of here."
    DUPREY "La misión es alto secreto, todo lo que puedo deciros es que recuperaréis reliquias de una fortaleza perdida al sur de aquí."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1147
translate es qst_ForgedInFire_FinalSparring_Complete_0ac7589b:

    # DUPREY "Expect at least six weeks march, take this into consideration with your prep."
    DUPREY "Como mínimo seis semanas de marcha, es importante tenerlo en cuenta a la hora de prepararse."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1148
translate es qst_ForgedInFire_FinalSparring_Complete_ee4f7f5b:

    # DUPREY "Dismissed!"
    DUPREY "¡Rompan filas!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1151
translate es qst_ForgedInFire_FinalSparring_Complete_8cfa9b03:

    # "With that, the Captain stormed his way off stage, angrily shoving the sealed letter back into the fumbling hands of the palace official before stalking back to his quarters."
    "Dicho esto, el capitán abandonó el escenario, empujando con rabia la carta sellada hacia las manos torpes del funcionario de palacio antes de volver a sus aposentos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1152
translate es qst_ForgedInFire_FinalSparring_Complete_fa69c2ee:

    # "The men soon dissolved the ranks and the process of packing up for our departure began."
    "Los hombres pronto rompieron filas y comenzó el proceso de hacer las maletas para nuestra partida."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1157
translate es qst_ForgedInFire_FinalSparring_Complete_73d9be9c:

    # "There was much confused chatter about what this {i}‘secret mission’{/i} entailed, and more so the worry of now being confronted by the Demorai so clearly unprepared."
    "Hubo mucha confusión acerca de lo que implicaba esta {i}‘misión secreta’{/i}, y más aún la preocupación de enfrentarse ahora a los emorai tan claramente desprevenidos."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1158
translate es qst_ForgedInFire_FinalSparring_Complete_d33077f7:

    # MARKUS "What the fuck was all that about?"
    MARKUS "¿De qué coño iba todo eso?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1159
translate es qst_ForgedInFire_FinalSparring_Complete_07f11245:

    # MC "I don’t know, looks like some higher up bullshit to me."
    MC "No sé, a mí me parece una gilipollez de los de arriba."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1160
translate es qst_ForgedInFire_FinalSparring_Complete_3e0ef9c5:

    # MC "Guess we'll be skipping the test then..."
    MC "Supongo que entonces nos saltaremos la prueba..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1161
translate es qst_ForgedInFire_FinalSparring_Complete_52b2a82f:

    # MARKUS "Hm... I’ll make sure to pack some extra bread for you, okay?"
    MARKUS "Hm... Me aseguraré de preparar algo de pan extra para ti, ¿vale?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1162
translate es qst_ForgedInFire_FinalSparring_Complete_f6d7e7b6:

    # MC "Where’d you get the extra rations from, you fancy fuck?"
    MC "¿De dónde sacaste las raciones extra, maldito?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1163
translate es qst_ForgedInFire_FinalSparring_Complete_a1c732d3:

    # MARKUS "My brother sent it to me the other day, figured we could split it..."
    MARKUS "Mi hermano me lo envió el otro día, pensé que podríamos dividirlo..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1164
translate es qst_ForgedInFire_FinalSparring_Complete_ce4a9c8a:

    # MC "Oh, thank you."
    MC "Oh, gracias."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1165
translate es qst_ForgedInFire_FinalSparring_Complete_7ff3445a:

    # MARKUS "In return I want some of that sweet wine you got!"
    MARKUS "¡A cambio quiero un poco de ese vino dulce que tienes!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1166
translate es qst_ForgedInFire_FinalSparring_Complete_95e59f81:

    # MC "What?!"
    MC "¡¿Qué?!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1143
translate es qst_ForgedInFire_FinalSparring_Complete_282b2d00:

    # MARKUS "Hey! Don’t hold out on me! I know your dear sweet [regina_ref!t] brought you some!"
    MARKUS "Oye! ¡No me ocultes nada! ¡Sé que tu querida y dulce [regina_ref!t] te dio un poco!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1168
translate es qst_ForgedInFire_FinalSparring_Complete_8b5596df:

    # MC "Alright, alright, {i}we’ll share.{/i}"
    MC "Está bien, está bien {i}lo compartiremos.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1169
translate es qst_ForgedInFire_FinalSparring_Complete_31c038e0:

    # MARKUS "That’s more like it!"
    MARKUS "¡Así me gusta!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1170
translate es qst_ForgedInFire_FinalSparring_Complete_fbd1034e:

    # MARKUS "Didn’t want to have to bust your balls the whole trip if I die of dehydration because you wouldn’t spare {i}‘a single drop’{/i} for your dearest and oldest friend!"
    MARKUS "¡No quería tener que fastidiarte todo el viaje si me moría de deshidratación porque no ibas a escatimar {i}‘ni una sola gota’{/i} para tu más querido y viejo amigo!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1171
translate es qst_ForgedInFire_FinalSparring_Complete_9f87cee2:

    # MC "But then how would I achieve my dream of becoming a drunk?"
    MC "Pero entonces, ¿cómo conseguiría mi sueño de convertirme en un borracho?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1172
translate es qst_ForgedInFire_FinalSparring_Complete_957e6607:

    # MARKUS "I have every confidence that you’ll find a way, no matter what."
    MARKUS "Confío plenamente en que encontrarás la manera, pase lo que pase."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1174
translate es qst_ForgedInFire_FinalSparring_Complete_a370dbb4:

    # "Suddenly, the ginger haired girl strutted over to us, a coy little smile on her face."
    "De repente, la chica pelirroja se nos acercó con una sonrisa tímida."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1175
translate es qst_ForgedInFire_FinalSparring_Complete_d469bfc4:

    # KIARA "Looks like I’ve been partnered up with you two for the march."
    KIARA "Parece que me ha tocado ir con vosotros dos en la marcha."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1176
translate es qst_ForgedInFire_FinalSparring_Complete_8cea643d:

    # MARKUS "Oh?"
    MARKUS "¿Ah, sí?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1177
translate es qst_ForgedInFire_FinalSparring_Complete_5926d935:

    # KIARA @ happy "Aye, that won’t be a problem, will it?"
    KIARA @ happy "Sí, eso no será un problema, ¿verdad?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1178
translate es qst_ForgedInFire_FinalSparring_Complete_f3de8e53:

    # MARKUS "After that little show you put on with the Captain when we first got here? It’ll be our pleasure."
    MARKUS "¿Después del numerito que montaste con el capitán cuando llegamos? Será un placer."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1179
translate es qst_ForgedInFire_FinalSparring_Complete_4e8676e6:

    # MARKUS "I’ll be sure to let you soften the Demorai up before I get there!"
    MARKUS "¡Me aseguraré de que ablandes a los demorai antes de que llegue!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1180
translate es qst_ForgedInFire_FinalSparring_Complete_0739d47d:

    # KIARA "How {i}valiant{/i} of you."
    KIARA "Qué {i}valiente{/i} por tu parte."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1182
translate es qst_ForgedInFire_FinalSparring_Complete_2cba1877:

    # "I caught her gaze and nodded:"
    "Capté su mirada y asentí:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1183
translate es qst_ForgedInFire_FinalSparring_Complete_ae8a726e:

    # MC "Kiara."
    MC "Kiara."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1184
translate es qst_ForgedInFire_FinalSparring_Complete_107ca765:

    # "Kiara nodded and smiled mischievously."
    "Kiara asintió y sonrió con picardía."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1185
translate es qst_ForgedInFire_FinalSparring_Complete_1b1ca23b:

    # KIARA "What do they call your cute friend here?"
    KIARA "¿Cómo llaman aquí a tu amigo el guaperas?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1186
translate es qst_ForgedInFire_FinalSparring_Complete_435e4d75:

    # MARKUS "Hey! I can hear you!"
    MARKUS "¡Oye! Puedo oírte!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1187
translate es qst_ForgedInFire_FinalSparring_Complete_217ebd58:

    # KIARA "I know, honey. So?"
    KIARA "Lo sé, cariño. ¿Entonces?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1188
translate es qst_ForgedInFire_FinalSparring_Complete_65cbbe79:

    # MARKUS "...It's Markus."
    MARKUS "...Es Markus."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1189
translate es qst_ForgedInFire_FinalSparring_Complete_246faf04:

    # KIARA @ happy "Well then, pleasure to meet you, Markus."
    KIARA @ happy "Bueno, un placer conocerte, Markus."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1190
translate es qst_ForgedInFire_FinalSparring_Complete_0757128a:

    # KIARA "I'll take the rear, is that alright with you guys?"
    KIARA "Yo me encargaré de la retaguardia, ¿os parece bien?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1193
translate es qst_ForgedInFire_FinalSparring_Complete_deaeaf6f:

    # MC "What’s your name?"
    MC "¿Cómo te llamas?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1194
translate es qst_ForgedInFire_FinalSparring_Complete_5e61be4f:

    # KIARA "Kiara, love."
    KIARA "Kiara, amor."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1197
translate es qst_ForgedInFire_FinalSparring_Complete_8ae7bf84:

    # "Kiara smiled and winked mischievously."
    "Kiara sonrió y guiñó un ojo con picardía."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1198
translate es qst_ForgedInFire_FinalSparring_Complete_a0467524:

