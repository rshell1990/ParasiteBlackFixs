    DUPREY "Ahora trae tu culo gordo aquí, chica. ¡No tengo todo el día!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:253
translate es qst_ForgedInFire_AtTrainingYard_877a9d86:

    # "There were some laughs again from a couple of the recruits."
    "Algunos reclutas volvieron a reírse."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:254
translate es qst_ForgedInFire_AtTrainingYard_62461244:

    # DUPREY @ angry "DID I SAY YOU COULD FUCKING LAUGH?"
    DUPREY @ angry "¿DIJE QUE PODÍAN REÍRSE?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:255
translate es qst_ForgedInFire_AtTrainingYard_a07d1a6f:

    # DUPREY "... Are you ready?"
    DUPREY "... ¿Estás preparada?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:256
translate es qst_ForgedInFire_AtTrainingYard_2f65ab47:

    # "The girl raised her blades hesitantly."
    "La chica levantó las espadas vacilante."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:257
translate es qst_ForgedInFire_AtTrainingYard_96b19e41:

