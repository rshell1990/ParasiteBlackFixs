# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1157
translate es qst_TheDarkPass_SkipTimeAndGateIsOpen_a327a5ca:

    # "Nervous, I wondered about the fort."
    "Nervioso, me preguntaba por el fuerte."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1158
translate es qst_TheDarkPass_SkipTimeAndGateIsOpen_fb727847:

    # "Scouts exchanged looks of unease and anticipation."
    "Los exploradores intercambian miradas de inquietud y expectación."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1159
translate es qst_TheDarkPass_SkipTimeAndGateIsOpen_f476d17e:

    # "We knew in our gut that something is off..."
    "Sabíamos en nuestras entrañas que algo no iba bien..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1160
translate es qst_TheDarkPass_SkipTimeAndGateIsOpen_d7142bb4:

    # MC "(Whatever is behind that door, it should be worth all we have gone through...)"
    MC "(Lo que sea que haya detrás de esa puerta, debe valer todo lo que hemos pasado...)"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1161
translate es qst_TheDarkPass_SkipTimeAndGateIsOpen_fd07b1b2:

    # MC "(And fucking more.)"
    MC "(Y mucho más)."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1167
translate es qst_TheDarkPass_GateIsOpen_0ceb596c:

    # "Come nightfall, the mages finally dragged themselves out from the tunnel and headed over towards Captain Duprey."
    "Al caer la noche, las magas salieron del túnel y se dirigieron hacia el capitán Duprey."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1177
translate es qst_TheDarkPass_GateIsOpen_64201302:

    # MAGE "The seal is open, Captain."
    MAGE "El sello está abierto, capitán."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1173
translate es qst_TheDarkPass_GateIsOpen_fba096f1:

    # DUPREY "Good work, let’s—"
    DUPREY "Buen trabajo, vamos—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1175
translate es qst_TheDarkPass_GateIsOpen_39219a92:

    # "Suddenly, there was a loud scream from one of the men peering over the wooden wall."
    "De repente, se oyó un fuerte grito de uno de los hombres asomados a la pared de madera."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1177
translate es qst_TheDarkPass_GateIsOpen_27abcf5a:

    # "A razor like tentacle swiped through, severing him in half."
    "Un tentáculo como una cuchilla lo atravesó, partiéndolo por la mitad."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1183
translate es qst_TheDarkPass_GateIsOpen_890dd7ab:

    # "The fort erupted into {i}chaos.{/i}"
    "El fuerte estalló en {i}caos.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1185
translate es qst_TheDarkPass_GateIsOpen_b08f1b16:

    # "People were screaming, panicking, unable to see where or what was coming for us."
    "La gente gritaba, presa del pánico, incapaz de ver dónde o qué venía a por nosotros."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1186
translate es qst_TheDarkPass_GateIsOpen_2993b5b0:

    # "Above the terrified din, one man could be heard above the others, \"DEMORAI! DEMORAI ON THE WALLS!\"."
    "Por encima del estruendo aterrorizado, se oía a un hombre por encima de los demás, \"¡DEMORAI! ¡DEMORAI EN LAS MURALLAS!\"."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1190
translate es qst_TheDarkPass_GateIsOpen_b39b5964:

    # "The first we saw of them was their claws on the upper fence line as they heaved the rest of their bodies over the walls."
    "Lo primero que vimos de ellos fueron sus garras en la línea superior de la valla mientras levantaban el resto de sus cuerpos por encima de las murallas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1191
translate es qst_TheDarkPass_GateIsOpen_dd1c2aa3:

    # "Hundreds of Demorai, all of them maniacally drooling as they swarmed us, euphoric at the prospect of devouring everyone below."
    "Cientos de demorai, todos ellos babeando maníacamente mientras nos rodeaban, eufóricos ante la perspectiva de devorar a todos los que había debajo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1192
translate es qst_TheDarkPass_GateIsOpen_3ef0acdc:

    # "We drew our blades and a feverish battle ensued."
    "Desenvainamos nuestras espadas y se entabló una febril batalla."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1196
translate es qst_TheDarkPass_GateIsOpen_5f1a2dc5:

    # DUPREY "HOLD THE WALLS! STOP THEM FLOODING IN!"
    DUPREY "¡MANTENED LAS MURALLAS! ¡IMPEDID QUE ENTREN A MANSALVA!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1197
translate es qst_TheDarkPass_GateIsOpen_b9441264:

    # DUPREY "FORM A SHIELD WALL BY THE GATE! QUICKLY!"
    DUPREY "¡FORMAD UN MURO DE ESCUDOS JUNTO A LA PUERTA! ¡RÁPIDO!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1200
translate es qst_TheDarkPass_GateIsOpen_85235f90:

    # "As the men clambered around the gate, shields ready as they tried their best to fend off the ensuing horde, the Captain wildly swung his axe at the endless strays that managed to overpower the wall guards and clamber over."
    "Mientras los hombres se arremolinaban en torno a la puerta, con los escudos preparados para defenderse de la horda, el capitán golpeaba con su hacha a los interminables extraviados que lograban superar a los guardias de la muralla y trepar por ella."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1201
translate es qst_TheDarkPass_GateIsOpen_9b292c68:

    # "Turning on my heel I saw Markus and Kiara rush over to me, blades drawn as a small horde approached us, tongues lashing out of their mouths, ready to feast."
    "Al girar sobre mis talones, vi a Markus y Kiara correr hacia mí, con las espadas desenvainadas, mientras una pequeña horda se acercaba a nosotros, con las lenguas saliendo de sus bocas, listas para darse un festín."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1183
translate es qst_TheDarkPass_GateIsOpen_a85789ee:

    # KIARA "[player_name!t]! LOOK OUT!"
    KIARA "¡[player_name!t]! ¡CUIDADO!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1210
translate es qst_TheDarkPass_GateIsOpen_db2481cf:

    # MC "{i}*Huff* *Huff*{/i} Come on! We need to help the Captain!"
    MC "{i}*Uff* *Uff*{/i} ¡Vamos! ¡Tenemos que ayudar al capitán!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1213
translate es qst_TheDarkPass_GateIsOpen_d44596a1:

    # MARKUS "They’re everywhere!"
    MARKUS "¡Están por todas partes!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1214
translate es qst_TheDarkPass_GateIsOpen_531db3fe:

    # KIARA "Look! They’re tearing down the bloody walls!"
    KIARA "¡Mirad! ¡Están derribando las malditas murallas!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1215
translate es qst_TheDarkPass_GateIsOpen_38e33387:

    # "Looking over to the wall, blood and mud now soaking my face, I watched as the wood began to tremble and buckle under the weight of the swathes of Demorai clambering over it."
    "Mirando hacia la muralla, con la cara empapada de sangre y barro, vi cómo la madera empezaba a temblar y a combarse bajo el peso de los demorai que trepaban por encima."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1216
translate es qst_TheDarkPass_GateIsOpen_42997bec:

    # "In a tidal wave of teeth and claws, one side of the wall splintered and collapsed, dragging down with it all the Scouts fighting on it."
    "En un maremoto de dientes y garras, un lado de la muralla se astilló y se derrumbó, arrastrando consigo a todos los exploradores que luchaban en él."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1217
translate es qst_TheDarkPass_GateIsOpen_8d131e57:

    # "Those that survived the collapse were immediately annihilated by the Demorai they found themselves encompassed by down below."
    "Los que sobrevivieron al derrumbe fueron aniquilados de inmediato por los demorai que les rodeaban."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1218
translate es qst_TheDarkPass_GateIsOpen_a4320b34:

    # MC "Fuck FUCK! Get back! GET BACK!"
    MC "¡Joder, JODER! ¡Atrás! ¡ATRÁS!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1219
translate es qst_TheDarkPass_GateIsOpen_8120254a:

    # "As we withdrew towards the entrance of the cave, unable to flee in any direction, some of the archers fumblingly fired off their lit arrows at the Demorai, engulfing them in flames."
    "Mientras nos retirábamos hacia la entrada de la cueva, incapaces de huir en ninguna dirección, algunos de los arqueros dispararon a tientas sus flechas encendidas contra los demorai, envolviéndolos en llamas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1223
translate es qst_TheDarkPass_GateIsOpen_1ecd081c:

    # DUPREY "COME AT ME BEASTIES! I’LL HAVE THE LOT OF YA!"
    DUPREY "¡VENID A POR MÍ BESTIAS! ¡VOY A POR TODOS!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1224
translate es qst_TheDarkPass_GateIsOpen_0a8abb3e:

    # "With a hard push, we desperately tried to force our way forward to help the Captain who had been encircled, but more of the Demorai vaulted towards us."
    "Con un fuerte impulso, tratamos desesperadamente de abrirnos paso para ayudar al capitán que había sido rodeado, pero más demorai saltaron hacia nosotros."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1207
translate es qst_TheDarkPass_GateIsOpen_383e449e:

    # KIARA "[player_name!t]! Look out! These enemies are different than the last!"
    KIARA "¡[player_name!t]! ¡Cuidado! ¡Estos enemigos son diferentes a los anteriores!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1236
translate es qst_TheDarkPass_GateIsOpen_81e4429f:

    # MARKUS "{i}*Huff* *Huff*{/i} They just... {i}*Huff*{/i} Keep coming!"
    MARKUS "{i}*Uff* *Uff*{/i} Simplemente... {i}*Uff*{/i} ¡Siguen viniendo!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1237
translate es qst_TheDarkPass_GateIsOpen_f77ba669:

    # MC "Come on! We’re almost there! The Captain is—"
    MC "¡Venga! ¡Ya casi llegamos! El capitán es—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1241
translate es qst_TheDarkPass_GateIsOpen_c36b3b40:

    # "There was a deafening roar that caused the ground itself to shudder, piercing through our very souls."
    "Se oyó un rugido ensordecedor que hizo temblar el suelo mismo, atravesando nuestras propias almas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1242
translate es qst_TheDarkPass_GateIsOpen_da95269f:

    # "As we all watched on ahead in horror, the men who had clustered around the gate with their shields and swords were flung aside in one mighty thrust."
    "Mientras todos mirábamos horrorizados hacia delante, los hombres que se habían agrupado alrededor de la puerta con sus escudos y espadas fueron arrojados a un lado con una poderosa estocada."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1243
translate es qst_TheDarkPass_GateIsOpen_60a1befa:

    # "Dragging itself forward appeared a terrifying monstrosity unlike anything we had ever seen before."
    "Arrastrándose hacia delante apareció una monstruosidad aterradora distinta a todo lo que habíamos visto antes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1244
translate es qst_TheDarkPass_GateIsOpen_546fcc0b:

    # "Almost humanoid in its shape, it stood up on its two thick hind legs."
    "De forma casi humanoide, se erguía sobre sus dos gruesas patas traseras."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1245
translate es qst_TheDarkPass_GateIsOpen_49485a0a:

    # "It’s feet and hands seemed more talon than anything else and its teeth were too large for a mouth which struggled to contain them."
    "Sus pies y manos parecían más garras que otra cosa y sus dientes eran demasiado grandes para una boca que luchaba por contenerlos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1246
translate es qst_TheDarkPass_GateIsOpen_911f3faa:

    # "Its wings blocked out what little light there was, forcing us to battle in the darkness it created."
    "Sus alas bloqueaban la poca luz que había, obligándonos a luchar en la oscuridad que creaba."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1247
translate es qst_TheDarkPass_GateIsOpen_ae877858:

    # "With horns on its head, and a tail thrashing behind it, the thing was so much more than a nightmare."
    "Con cuernos en la cabeza y una cola que se agitaba detrás de él, la cosa era mucho más que una pesadilla."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1248
translate es qst_TheDarkPass_GateIsOpen_99643b26:

    # "Its flesh seemed coated in a thick bone-like armour."
    "Su carne parecía recubierta de una gruesa coraza ósea."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1249
translate es qst_TheDarkPass_GateIsOpen_cf3de208:

    # "One Scout who tried to swing his sword in an effort to pierce the creature, quickly found his blade bouncing off before the monster crushed him with his hand into nothing more than a pile of blood and bones and sinew."
    "Un explorador que intentó blandir su espada para atravesar a la criatura, se encontró rápidamente con que su hoja rebotaba antes de que el monstruo lo aplastara con su mano convirtiéndolo en nada más que un montón de sangre, huesos y tendones."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1252
translate es qst_TheDarkPass_GateIsOpen_eac06cb0:

    # DUPREY "You... {i}It’s you.{/i}"
    DUPREY "Tú... {i}Eres tú{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1254
translate es qst_TheDarkPass_GateIsOpen_f09f5f97:

    # "In its hands, the monstrous being held a huge double ended spear of thick metal that pulsated dark energy."
    "En sus manos, el monstruoso ser sostenía una enorme lanza de doble punta de grueso metal que emanaba energía oscura."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1255
translate es qst_TheDarkPass_GateIsOpen_25ac5a3d:

    # "It seemed as large as the trunk of a tree, towering five times over any man."
    "Parecía tan grande como el tronco de un árbol, cinco veces por encima de cualquier hombre.."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1256
translate es qst_TheDarkPass_GateIsOpen_c9542159:

    # "{i}... And it was heading right for us...{/i}"
    "{i}... Y se dirigía directamente hacia nosotros...{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1257
translate es qst_TheDarkPass_GateIsOpen_5189fafd:

    # "The Captain, bloodied and weary, looked towards us as he saw the thing heading our way."
    "El capitán, ensangrentado y cansado, miró hacia donde estábamos al ver la cosa que se dirigía hacia nosotros."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1258
translate es qst_TheDarkPass_GateIsOpen_0cc043e0:

    # "Duprey loudly cried out to grab its attention."
    "Duprey gritó para llamar su atención."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1260
translate es qst_TheDarkPass_GateIsOpen_1faa759c:

    # DUPREY "ZANARAK!"
    DUPREY "¡ZANARAK!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1261
translate es qst_TheDarkPass_GateIsOpen_7805a38d:

    # "Hearing that name sent a shiver down my spine, I felt myself becoming increasingly delirious from all the fighting and bloodshed around me."
    "Oír ese nombre me produjo un escalofrío, sentía que deliraba cada vez más por toda la lucha y el derramamiento de sangre a mi alrededor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1262
translate es qst_TheDarkPass_GateIsOpen_a006cbcf:

    # "It became hard to focus on the enormity of what was happening as that name sunk deep into the core of me, filling me with an icy terror."
    "Me resultaba difícil concentrarme en la enormidad de lo que estaba ocurriendo mientras aquel nombre se hundía en lo más profundo de mí, llenándome de un terror glacial."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1263
translate es qst_TheDarkPass_GateIsOpen_625b466c:

    # "I felt that I might collapse at any moment as blackness crept into my vision."
    "Sentía que podía desmayarme en cualquier momento, mientras la oscuridad se adentraba en mi visión."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1264
translate es qst_TheDarkPass_GateIsOpen_422d9dcd:

    # "I started to pray for it, thinking it would be a small mercy to give myself over to the darkness and escape the decimation around me."
    "Empecé a rezar por ello, pensando que sería una pequeña misericordia entregarme a la oscuridad y escapar de la devastación que me rodeaba."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1265
translate es qst_TheDarkPass_GateIsOpen_aef12e9d:

    # "But the adrenaline snapped me awake and forced me to watch as the two squared off."
    "Pero la adrenalina me despertó y me obligó a ver cómo se enfrentaban."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1266
translate es qst_TheDarkPass_GateIsOpen_30c39a8f:

    # "The thing glared at him, hatred spewing from its eyes as it became clear the monstrous bogeyman of our childhood {i}recognised him.{/i}"
    "La cosa le miró fijamente, con odio brotando de sus ojos cuando quedó claro que el monstruoso hombre del saco de nuestra infancia {i}le reconocía.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1267
translate es qst_TheDarkPass_GateIsOpen_5b38abb9:

    # DUPREY "{i}After all these years...{/i} Again we face each other!"
    DUPREY "{i}Después de todos estos años...{/i} ¡Otra vez nos enfrentamos!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1269
translate es qst_TheDarkPass_GateIsOpen_9f3b7d0e:

    # DUPREY "Aye, beasty! So, you DO recognise me!"
    DUPREY "¡Sí, bestia! ¡Así que me reconoces!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1270
translate es qst_TheDarkPass_GateIsOpen_e5950610:

    # DUPREY " I knew there was a brain behind that thick fucking skull of yours!"
    DUPREY "¡Sabía que había un cerebro detrás de ese puto cráneo grueso que tienes!!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1271
translate es qst_TheDarkPass_GateIsOpen_7d377b6d:

    # "Zanarak turned menacingly towards Captain Duprey, giving him its full attention."
    "Zanarak se volvió amenazadoramente hacia el capitán Duprey, prestándole toda su atención."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1272
translate es qst_TheDarkPass_GateIsOpen_ddeb9dfe:

    # DUPREY "Come on then, you fuck! LET’S SEE YOU TRY TO FUCKING KILL ME!"
    DUPREY "¡Vamos entonces, cabrón! ¡VAMOS A VER CÓMO INTENTAS MATARME, JODER!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1273
translate es qst_TheDarkPass_GateIsOpen_1c9a8a91:

    # DUPREY "For Newheart! FOR ALDERAYYYYY!"
    DUPREY "¡Por Newheart! ¡POR ALDERAYYYYY!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1274
translate es qst_TheDarkPass_GateIsOpen_309bf98b:

    # "Lunging forward, the Captain flung himself screaming at the beast, dodging one of Zanarak’s swipes as he brought his mighty axe down on him, slashing at the beast’s ribs with all his strength."
    "Lanzándose hacia delante, el capitán se lanzó gritando contra la bestia, esquivando uno de los zarpazos de Zanarak mientras éste hacía caer sobre él su poderosa hacha, acuchillando las costillas de la bestia con todas sus fuerzas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1275
translate es qst_TheDarkPass_GateIsOpen_c5ac5daf:

    # "Zanarak staggered, the blade had bounced off his flesh and failed to cut him, but it must have hurt."
    "Zanarak se tambaleó, la hoja había rebotado en su carne y no había conseguido cortarle, pero debía de dolerle."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1276
translate es qst_TheDarkPass_GateIsOpen_2f8ae10d:

    # "The Captain once again moved to dodge Zanarak’s swishing tail as it smashed into one of the walls, flinging everything still climbing them to the mud and blood beneath."
    "El capitán se movió una vez más para esquivar la cola de Zanarak, que se estrelló contra una de las paredes, arrojando al barro y la sangre todo lo que aún trepaba por ellas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1277
translate es qst_TheDarkPass_GateIsOpen_ef64d10d:

    # "Once again lunging forward, Captain Duprey rolled forward to evade the sweeping swing of Zanarak’s spear and leapt up to attack, smashing Zanarak’s face with his axe, causing him to drop the spear."
    "Una vez más se lanzó hacia adelante, el capitán Duprey rodó hacia adelante para evadir el golpe de la lanza de Zanarak y saltó para atacar, golpeando la cara de Zanarak con su hacha, haciendo que soltara la lanza."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1278
translate es qst_TheDarkPass_GateIsOpen_be32a2be:

    # KIARA "Why doesn’t his axe pierce its flesh?!"
    KIARA "¡¿Por qué su hacha no atraviesa su carne?!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1279
translate es qst_TheDarkPass_GateIsOpen_b1e2cdd8:

    # MC "I don’t know! It’s hide must be too thick!"
    MC "¡No lo sé! ¡Su piel debe ser demasiado gruesa!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1280
translate es qst_TheDarkPass_GateIsOpen_8d41be99:

    # "While it staggered, the Captain once again continued a fury of heavy hits, causing Zanarak to fumble backwards, blood dripping down his face from where the axe had managed to pierce through his hard skin."
    "Mientras se tambaleaba, el capitán continuó una vez más con una furia de fuertes golpes, haciendo que Zanarak retrocediera a tientas, con la sangre goteándole por la cara desde donde el hacha había logrado atravesar su dura piel."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1281
translate es qst_TheDarkPass_GateIsOpen_906e6a5f:

    # "For a moment, it felt like victory was at hand, that the Captain would overcome Zanarak and save the day."
    "Por un momento, pareció que la victoria estaba al alcance de la mano, que el capitán vencería a Zanarak y salvaría el día."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1282
translate es qst_TheDarkPass_GateIsOpen_16ea6760:

    # DUPREY "Come on! Is that all you’ve—"
    DUPREY "¡Venga ya! ¿Eso es todo lo que tienes—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1283
translate es qst_TheDarkPass_GateIsOpen_d0d64118:

    # "Suddenly, Zanarak charged forward with such speed, he caught the Captain off guard. With one backhand of his claw, he sent the Captain tumbling into the mud."
    "De repente, Zanarak cargó hacia delante a tal velocidad que pilló desprevenido al capitán. Con un revés de su garra, hizo que el capitán cayera al barro."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1284
translate es qst_TheDarkPass_GateIsOpen_721e4ea2:

    # "Coughing and retching up blood, he moved to grab his axe once again but before he could, Zanarak was on him, knocking the axe away with his foot as he grabbed Captain Duprey with both hands."
    "Tosiendo y vomitando sangre, se movió para agarrar su hacha una vez más, pero antes de que pudiera, Zanarak estaba sobre él, tirando el hacha con el pie mientras agarraba al capitán Duprey con ambas manos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1285
translate es qst_TheDarkPass_GateIsOpen_e7a8fc89:

    # "Frantically, we continued to fight our way forward through the hordes of Demorai, but were powerless to save him, we could only watch... {i}and despair.{/i}"
    "Frenéticamente, continuamos abriéndonos paso a través de las hordas de Demorai, pero éramos impotentes para salvarlo, solo podíamos mirar... {i}y desesperarnos.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1286
translate es qst_TheDarkPass_GateIsOpen_70a61346:

    # "As Zanarak squeezed the Captain’s body in its claws, there was a terrible snapping and screeching sound as the Captain retched blood out his mouth."
    "Mientras Zanarak apretaba el cuerpo del Capitán con sus garras, se oyó un terrible chasquido y chirrido mientras el capitán vomitaba sangre por la boca."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1287
translate es qst_TheDarkPass_GateIsOpen_aab6a330:

    # "Zanarak’s tongue licked its lips in anticipation as a cruel smile crawled across its face. It brought the Captain closer, quivering with excitement."
    "La lengua de Zanarak se lamió los labios con anticipación mientras una sonrisa cruel se dibujaba en su rostro. Se acercó al capitán, temblando de excitación."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1288
translate es qst_TheDarkPass_GateIsOpen_b28e6f0b:

    # DUPREY "{i}Fucking... choke on me...{/i}"
    DUPREY "{i}Joder... ahógate...{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1289
translate es qst_TheDarkPass_GateIsOpen_b41bcfd6:

    # DUPREY "{i}YOU CUNT!{/i}"
    DUPREY "{i}¡TÚ, IMBÉCIL!{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1290
translate es qst_TheDarkPass_GateIsOpen_7d68f31c:

    # "In one last effort of defiance, the Captain swung his head forward to smash his forehead against Zanarak, causing his own head to bleed in the process as he spat his blood onto Zanarak’s darkly bemused face."
    "En un último esfuerzo de desafío, el capitán giró la cabeza hacia delante para golpearse la frente contra Zanarak, haciendo que su propia cabeza sangrara en el proceso mientras escupía su sangre sobre el rostro de Zanarak, visiblemente perplejo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1293
translate es qst_TheDarkPass_GateIsOpen_47940fd0:

    # "Zanarak, in return, snarled angrily as he crushed the Captain in his powerful taloned hands."
    "Zanarak, a su vez, gruñó furioso mientras aplastaba al Capitán con sus poderosas manos con garras."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1295
translate es qst_TheDarkPass_GateIsOpen_69683e08:

    # "Duprey’s agonising scream almost seemed to satiate him before he plunged his jaw forward and greedily tore him apart in a bloody, violent mess."
    "El grito agónico de Duprey casi pareció saciarle antes de que hundiera la mandíbula hacia delante y lo desgarrara con avidez en un amasijo sangriento y violento."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1300
translate es qst_TheDarkPass_GateIsOpen_64f442b9:

    # "Distantly, I felt Markus’ hand on my shoulder pull me back as the world around me became quiet as a graveyard."
    "A lo lejos, sentí que la mano de Markus en mi hombro me tiraba hacia atrás mientras el mundo a mi alrededor se volvía silencioso como un cementerio."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1301
translate es qst_TheDarkPass_GateIsOpen_9a29d94f:

    # "When he spoke, I couldn’t quite hear what he was saying until he shook me violently and sound all seemed to rush back at once."
    "Cuando hablaba, no oía bien lo que decía hasta que me sacudió violentamente y todo el sonido pareció volver de golpe."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1290
translate es qst_TheDarkPass_GateIsOpen_c370ce71:

    # MARKUS "[player_name!t]! We need to get out of here now!"
    MARKUS "¡[player_name!t]! ¡Tenemos que salir de aquí ahora!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1312
translate es qst_TheDarkPass_GateIsOpen_4bbe56ad:

    # "Shaking my head fearfully, I turned towards Kiara."
    "Sacudiendo la cabeza con miedo, me giré hacia Kiara."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1314
translate es qst_TheDarkPass_GateIsOpen_e7d23a00:

    # MC "We have to go!"
    MC "¡Tenemos que irnos!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1315
translate es qst_TheDarkPass_GateIsOpen_2ead6772:

    # "As Kiara battled off some of the Demorai and turned to face me, she suddenly stopped in her tracks with a shudder."
    "Mientras Kiara luchaba contra algunos de los demorai y se giraba hacia mí, de repente se detuvo en seco con un escalofrío."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1323
translate es qst_TheDarkPass_GateIsOpen_5c962eab:

    # "Peering down in an almost comical confusion she noticed what we all saw happen; a tentacle had thrust its way through Kiara’s chest."
    "Mirando hacia abajo con una confusión casi cómica, se dio cuenta de lo que todos vimos suceder: un tentáculo se había abierto paso a través del pecho de Kiara."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1324
translate es qst_TheDarkPass_GateIsOpen_8942250d:

    # "I looked at her, and she me, paralysed with terror."
    "La miré, y ella a mí, paralizada de terror."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1325
translate es qst_TheDarkPass_GateIsOpen_6e5b7aa8:

    # "With a trail of blood seeping from the side of her mouth, she simply said..."
    "Con un reguero de sangre escurriéndole por un lado de la boca, se limitó a decir..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1326
translate es qst_TheDarkPass_GateIsOpen_af03a4be:

    # KIARA "{i}Run...{/i}"
    KIARA "{i}Corred...{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1327
translate es qst_TheDarkPass_GateIsOpen_4de9edf4:

    # "And with that Kiara was flung backwards into the throes of battle."
    "Y con eso Kiara fue lanzada hacia atrás en la agonía de la batalla."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1329
translate es qst_TheDarkPass_GateIsOpen_b1bef907:

    # "Feeling a surge of manic grief, I screamed as I tried to fling myself forward to save her, but Markus used all his strength and held me back."
    "Sintiendo una oleada de dolor maníaco, grité mientras intentaba lanzarme hacia delante para salvarla, pero Markus empleó toda su fuerza y me frenó."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1330
translate es qst_TheDarkPass_GateIsOpen_61978aa7:

    # MARKUS "IT’S TOO LATE, SHE’S GONE!"
    MARKUS "¡ES DEMASIADO TARDE, SE HA IDO!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1331
translate es qst_TheDarkPass_GateIsOpen_f4e00510:

    # "Determinedly pulling me back, Markus cried..."
    "Con determinación, tirando de mí hacia atrás, Markus gritó..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1332
translate es qst_TheDarkPass_GateIsOpen_0da52be2:

    # MARKUS "The battle is lost! We have to retreat!"
    MARKUS "¡La batalla está perdida! ¡Tenemos que retirarnos!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1333
translate es qst_TheDarkPass_GateIsOpen_cf98d2a8:

    # MC "We’re surrounded!"
    MC "¡Estamos rodeados!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1334
translate es qst_TheDarkPass_GateIsOpen_8baa2c55:

    # "Markus looked around wildly, staring back at the entrance to the cavern and pulled me along."
    "Markus miró a su alrededor con desesperación, fijando la vista en la entrada de la cueva y tiró de mí."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1335
translate es qst_TheDarkPass_GateIsOpen_363568e5:

    # MARKUS "Come on! It’s the only way!"
    MARKUS "¡Vamos! ¡Es la única manera!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1341
translate es qst_TheDarkPass_GateIsOpen_4170c645:

    # MC "HURRY!"
    MC "¡RÁPIDO!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1342
translate es qst_TheDarkPass_GateIsOpen_7ad62c8c:

    # MARKUS "It won’t close!"
    MARKUS "¡No se cierra!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1343
translate es qst_TheDarkPass_GateIsOpen_d7589ccf:

    # MC "CLOSE IT! CLOSE THE FUCKING DOOR!"
    MC "¡CIÉRRALA! ¡CIERRA LA PUTA PUERTA!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1344
translate es qst_TheDarkPass_GateIsOpen_ef27cd89:

    # MARKUS "I’m trying!"
    MARKUS "¡Lo estoy intentando!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1345
translate es qst_TheDarkPass_GateIsOpen_2cd10d35:

    # MC "MARKUS! HURRY! IT’S NEARLY—"
    MC "¡MARKUS! ¡DATE PRISA! ESTÁ CASI—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1355
translate es qst_TheDarkPass_GateIsOpen_f00dab72:

    # "Exhausted, caked in dirt and grime, me and Markus looked at each other wearily."
    "Agotados, llenos de suciedad y mugre, Markus y yo nos miramos con cansancio."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1356
translate es qst_TheDarkPass_GateIsOpen_60add535:

    # "The sounds of fighting outside had slowly died down, only an eerie silence was left."
    "Los sonidos de la lucha en el exterior se habían ido apagando poco a poco, solo quedaba un inquietante silencio."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1357
translate es qst_TheDarkPass_GateIsOpen_fe368176:

    # "We found ourselves speaking in whispers."
    "Nos quedamos hablando en susurros."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1358
translate es qst_TheDarkPass_GateIsOpen_c55369df:

    # MARKUS "Are we...?"
    MARKUS "¿Estamos...?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1359
translate es qst_TheDarkPass_GateIsOpen_aa0d9848:

    # MC "{i}We’re the only ones left.{/i}"
    MC "{i}Solo quedamos nosotros.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1360
translate es qst_TheDarkPass_GateIsOpen_69308a51:

    # "The dawning realisation caused the blood to run cold in our veins, slowly we turned to look around at what may be our tomb."
    "Al darnos cuenta, la sangre se nos heló en las venas y nos giramos lentamente para mirar a nuestro alrededor, lo que podría ser nuestra tumba."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1361
translate es qst_TheDarkPass_GateIsOpen_adf58131:

    # "The chamber was unusual."
    "La recámara era inusual."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1362
translate es qst_TheDarkPass_GateIsOpen_a845dd1f:

    # "Two strange obelisks stood menacingly in the center of the room."
    "Dos extraños obeliscos se erguían amenazadores en el centro de la sala."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1367
translate es qst_TheDarkPass_GateIsOpen_7f07395e:

    # "One of the perfect pair black, the other white, they looked timeless, ancient."
    "Uno de ellos era negro, el otro blanco, parecían intemporales, antiguos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1368
translate es qst_TheDarkPass_GateIsOpen_3e4b9aee:

    # MC "What are those?..."
    MC "¿Qué son?..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1370
translate es qst_TheDarkPass_GateIsOpen_d6fd9fd7:

    # "Reluctantly shifting my gaze to examine the room, I saw tables full of vials and half empty potions."
    "A regañadientes, desvié la mirada para examinar la estancia y vi mesas llenas de frascos y pociones medio vacías."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1371
translate es qst_TheDarkPass_GateIsOpen_380c3d56:

    # "Various pieces of paper were scattered around the floor — someone had left in a hurry."
    "Había varios trozos de papel esparcidos por el suelo — alguien se había marchado con prisas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1372
translate es qst_TheDarkPass_GateIsOpen_180b3c82:

    # MARKUS "What is this place?"
    MARKUS "¿Qué es este lugar?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1373
translate es qst_TheDarkPass_GateIsOpen_0b01172f:

    # MC "I can’t even guess..."
    MC "Ni siquiera puedo adivinarlo..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1374
translate es qst_TheDarkPass_GateIsOpen_7f34c1ab:

    # MC "There has to be a way out of here though so, let’s see if we can find some kind of secret exit or something..."
    MC "Tiene que haber una manera de salir de aquí, así que, vamos a ver si podemos encontrar algún tipo de salida secreta o algo así..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1376
translate es qst_TheDarkPass_GateIsOpen_5e963aa5:

    # MARKUS "{i}*Sigh*{/i} Well, it sure beats waiting around to die..."
    MARKUS "{i}*Suspiro*{/i} Bueno, es mejor que esperar a morir..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1386
translate es qst_TheDarkPass_ObelisksRoomPapers_1490ecb4:

    # "Picking up some of the papers, I tried to piece them together and decipher some of what was going on."
    "Recogí algunos papeles e intenté recomponerlos y descifrar algo de lo que estaba pasando."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1387
translate es qst_TheDarkPass_ObelisksRoomPapers_a36fbb89:

    # "{i}‘Subjects remain in petrified state until we can discover a means to try quelling their ‘parasitic’ natures.{/i}"
    "{i}‘Los sujetos permanecen en estado petrificado hasta que podamos descubrir un medio para intentar sofocar su naturaleza ‘parasitaria’.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1388
translate es qst_TheDarkPass_ObelisksRoomPapers_3778fff4:

    # "{i}Neither Kern, Luxma, Burning Wings or Scun seem to have any chemical impact on ‘controlling’ them.’{/i}"
    "{i}Ni Kern, Luxma, Burning Wings o Scun parecen tener ningún efecto químico para ‘controlarlos’.’{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1389
translate es qst_TheDarkPass_ObelisksRoomPapers_b2aa7c93:

    # "Hastily scribbled on the bottom was..."
    "Apresuradamente garabateado en la parte inferior había..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1390
translate es qst_TheDarkPass_ObelisksRoomPapers_68192352:

    # "{i}‘All other current botanic ingredients local to Alderay have proven ineffective, requesting more ‘exotic’ ingredients to test with from neighbouring kingdoms.’{/i}"
    "{i}‘Todos los demás ingredientes botánicos locales de Alderay han demostrado ser ineficaces, solicitando a los reinos vecinos más ingredientes ‘exóticos’ con los que hacer pruebas.’{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1391
translate es qst_TheDarkPass_ObelisksRoomPapers_3ead958e:

    # "{i}‘Just what will it take to get these things under control?’{/i}"
    "{i}‘¿Qué hace falta para controlar estas cosas?’{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1392
translate es qst_TheDarkPass_ObelisksRoomPapers_ea56ab57:

    # MC "(What are they talking about?)"
    MC "(¿De qué están hablando?)"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1400
translate es qst_TheDarkPass_ObelisksRoomSkeleton_fe8092c0:

    # "Slumped down dead against the wall, still in his dark dusty robes, was the body of a Dark Mage clutching at some letter in his hands."
    "Desplomado y muerto contra la pared, aún con su oscura y polvorienta túnica, estaba el cuerpo de un mago oscuro aferrado a una carta entre sus manos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1401
translate es qst_TheDarkPass_ObelisksRoomSkeleton_737d8344:

    # MARKUS "What’s a Dark Mage doing here?"
    MARKUS "¿Qué hace aquí un mago oscuro?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1402
translate es qst_TheDarkPass_ObelisksRoomSkeleton_ecae0ae1:

    # MC "I don’t know..."
    MC "No lo sé..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1403
translate es qst_TheDarkPass_ObelisksRoomSkeleton_8143ea13:

    # "Reaching down, I pulled the crumpled letter from the skeleton hands of the Dark Mage."
    "Me agaché y cogí la carta arrugada de las manos esqueléticas del mago oscuro."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1404
translate es qst_TheDarkPass_ObelisksRoomSkeleton_1c0d9374:

    # "As I did so, some the skeleton's bones disintegrated into ash right before my eyes."
    "Al hacerlo, algunos huesos del esqueleto se desintegraron en cenizas ante mis ojos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1405
translate es qst_TheDarkPass_ObelisksRoomSkeleton_aeb74839:

    # "‘Consider this my final gift unto you, {i}my lord{/i}, I die safe in the knowledge that once you retrieve these things, you will finally turn the tide of this war...’"
    "‘Considera este mi último regalo para usted, {i}mi señor{/i}, muero con la certeza de que una vez que recupere estas cosas, finalmente cambiará el rumbo de esta guerra...’"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1406
translate es qst_TheDarkPass_ObelisksRoomSkeleton_56e8ecef:

    # "‘But be wary, their power is still highly unstable... Choose only the finest to wield them, for to choose any less would spell {i}disaster{/i} for the realm.’"
    "‘Pero tenga cuidado, su poder es todavía muy inestable... Elija solo a los mejores para manejarlos, ya que elegir a cualquier otro supondría un {i}desastre{/i} para el reino.’"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1407
translate es qst_TheDarkPass_ObelisksRoomSkeleton_b633e548:

    # "‘Yours faithfully, forever, Kharlof.’"
    "‘Atentamente, para siempre, Kharlof.’"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1408
translate es qst_TheDarkPass_ObelisksRoomSkeleton_a28c417d:

    # MC "(My lord? Turning the tide of the war? What is he talking about?)"
    MC "(¿Mi señor? ¿Cambiar el rumbo de la guerra? ¿De qué está hablando?)"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1416
translate es qst_TheDarkPass_ObelisksRoomPotions_82c068b8:

    # "Inspecting the dust covered tables of potions, I tried reading the dozens of labels on each of the various jars and vials but recognized almost none of the ingredients."
    "Inspeccionando las mesas de pociones cubiertas de polvo, intenté leer las docenas de etiquetas de cada uno de los diversos frascos y viales, pero no reconocí casi ninguno de los ingredientes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1417
translate es qst_TheDarkPass_ObelisksRoomPotions_03c042eb:

    # MC "What is all this for?"
    MC "¿Para qué sirve todo esto?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1419
