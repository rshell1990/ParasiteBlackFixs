translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_fd2f53f3:

    # ALCOTT "HOWEVER, the two of you shall instead sign up to the Adventurer’s Guild."
    ALCOTT "SIN EMBARGO, vosotros dos os inscribiréis en el gremio de aventureros."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1600
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_3b1d3c63:

    # MC "The... The {i}Adventurer’s Guild?{/i}"
    MC "El... El {i}¿Gremio de aventureros?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1601
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_85f508b4:

    # ALCOTT "You are free to live and stay in the Capital unless the city itself falls under siege, upon which you, like all other able bodied, are still bound to heed the call to arms."
    ALCOTT "Son libres de vivir y permanecer en la capital a menos que la propia ciudad caiga bajo asedio, en cuyo caso vosotros, al igual que el resto de personas capacitadas, están obligados a acudir a la llamada a las armas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1602
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_99546b5d:

    # ALCOTT "Elsewise you shall serve the Empire as Guild members instead."
    ALCOTT "De lo contrario, servirán al imperio como miembros del gremio."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1603
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_f0433fc8:

    # ALCOTT "This is offered to you solely on the highly unusual circumstances surrounding your... survival."
    ALCOTT "Esto se os ofrece únicamente por las circunstancias altamente inusuales que rodean vuestra... supervivencia."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1604
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_2e2bde2d:

    # ALCOTT "You are now far more useful to me alive than dead."
    ALCOTT "Ahora son mucho más útiles para mí vivos que muertos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1605
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_4b45d7d3:

    # ALCOTT "Both of you are forbidden to speak about your mission and its failure to anyone, understand?"
    ALCOTT "Ambos tenéis prohibido hablar de vuestra misión y de su fracaso con nadie, ¿entendido?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1606
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_623d4f96:

    # "Me and Markus both nodded, giving our best ‘yes, sirs’."
    "Markus y yo asentimos con nuestro mejor ‘si, señor’."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1608
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_e69568ef:

    # ALCOTT "In return for this you will both {i}also{/i} be required to help me with... {i}raising morale.{/i}"
    ALCOTT "A cambio de esto, ambos {i}también{/i} tendréis que ayudarme... {i}levantar la moral.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1609
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_e35cd6bf:

    # "Both me and Markus just looked at each other, clueless."
    "Markus y yo nos miramos, sin entender nada."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1610
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_4ef65ac0:

    # MC "... Sir?"
    MC "... ¿Señor?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1611
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_1255a968:

    # ALCOTT "As far as anyone is concerned, you two single-handedly and {i}bravely{/i} fought together, slaying dozens of Demorai and returned not as lone survivors, but as {i}heroes{/i}. Understand?"
    ALCOTT "En lo que concierne a cualquiera, ustedes dos lucharon juntos, sin ayuda y con {i}valentía{/i} matando a docenas de Demorai y regresaron no como sobrevivientes solitarios, sino como {i}héroes{/i}. ¿Entendido?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1612
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_5fbe41cb:

    # MC "But—"
    MC "Pero—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1613
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_c5ee3b38:

    # ALCOTT "As of now, most of the city is talking about the two surviving heroes."
    ALCOTT "A partir de ahora, la mayor parte de la ciudad habla de los dos héroes supervivientes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1614
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_bc98f3ed:

    # ALCOTT "I intend to salvage something out of this affair to help people keep the faith."
    ALCOTT "Intento sacar algo de este asunto para ayudar a la gente a mantener la fe."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1615
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_48409954:

    # ALCOTT "They {b}will not{/b} hear of the massacre that you walked into, that story will die in this room and you two will only speak of the bravery and courage of your comrades."
    ALCOTT "No {b}oirán{/b} hablar de la masacre en la que os metisteis, esa historia morirá en esta sala y vosotros dos solo hablaréis de la valentía y el coraje de vuestros camaradas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1616
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_a5be7a25:

    # "The Emperor wants us..."
    "El Emperador quiere que..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1617
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_363258d4:

    # "{i}To lie?{/i}"
    "{i}¿Mintamos?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1618
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_e0c9d687:

    # ALCOTT "Given the fate you have managed to escape, visiting public places to wave and smile around is not such a bad alternative."
    ALCOTT "Dado el destino del que ha conseguido escapar, visitar lugares públicos para saludar y sonreír no es tan mala alternativa."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1619
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_0650d1f5:

    # ALCOTT "Don’t you agree?"
    ALCOTT "¿No están de acuerdo?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1620
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_58572838:

    # MC "... Yes, sir."
    MC "... Sí, señor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1621
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_49b19704:

    # MARKUS "Yes, my lord."
