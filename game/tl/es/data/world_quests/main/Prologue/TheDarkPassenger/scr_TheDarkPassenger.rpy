# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:181
translate es qst_TheDarkPass_MarchOut_4ccf8569:

    # "For now, with a cup of mead in hand, I was free to do as I wished..."
