    # DUPREY "Aye, feel free."
    DUPREY "Sí, puedes hacerlo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:386
translate es qst_TheDarkPass_CampTalkDuprey_menu_7bb579f6:

    # DUPREY "Lost count a long time ago."
    DUPREY "Perdí la cuenta hace mucho tiempo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:387
translate es qst_TheDarkPass_CampTalkDuprey_menu_6c8a02b9:

    # DUPREY "I’ve been here since the beginning..."
    DUPREY "He estado aquí desde el principio..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:388
translate es qst_TheDarkPass_CampTalkDuprey_menu_dcc31424:

    # MC "You mean—"
    MC "¿Quiere decir—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:389
translate es qst_TheDarkPass_CampTalkDuprey_menu_c9e369aa:

    # DUPREY "When it all first started, we never took it seriously, far more concerned with the threat of Kalliban O’Nok and his army of orcs crossing the seas to invade..."
    DUPREY "Cuando todo empezó, nunca nos lo tomamos en serio, mucho más preocupados por la amenaza de Kalliban O'Nok y su ejército de orcos que cruzaban los mares para invadir..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:390
translate es qst_TheDarkPass_CampTalkDuprey_menu_d579e16c:

    # MC "{i}The winter of 1149.{/i}"
    MC "{i}El invierno de 1149.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:391
translate es qst_TheDarkPass_CampTalkDuprey_menu_9b165412:

    # DUPREY "Alright, clever clogs. That’s what they called it, aye."
    DUPREY "Muy bien, sabelotodo.  Así es como lo llamaban, sí.."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:392
translate es qst_TheDarkPass_CampTalkDuprey_menu_2d277bc7:

    # DUPREY "Villagers talked about {i}‘ghosts in the night’{/i} snatching people up... We figured it was just bandits."
    DUPREY "Los aldeanos hablaban de {i}‘fantasmas en la noche’{/i} que se llevaban a la gente... Pensamos que eran solo bandidos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:393
translate es qst_TheDarkPass_CampTalkDuprey_menu_4792dca5:

    # DUPREY "More ‘n’ more had been spotted what with all the famine; we were preoccupied with the kind of threats we could understand."
    DUPREY "Con toda la hambruna, se había detectado más y más; estábamos preocupados por el tipo de amenazas que podíamos entender."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:394
translate es qst_TheDarkPass_CampTalkDuprey_menu_8ba9597e:

    # MC "I know this part! After they found more and more bloody scenes, The High Lords and King Mesamor finally relented and got the High Mages and Inquisitors to investigate."
    MC "¡Conozco esta parte! Después de encontrar más y más escenas sangrientas, los grandes señores y el rey Mesamor finalmente cedieron y consiguieron que los gran magos y los inquisidores investigaran."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:395
translate es qst_TheDarkPass_CampTalkDuprey_menu_f269264d:

    # "Captain Duprey raised a curious eyebrow."
    "El capitán Duprey levantó una ceja curioso."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:396
translate es qst_TheDarkPass_CampTalkDuprey_menu_ecde942b:

    # DUPREY @ think "Hmm... How’d you know all that? Most don’t know the full story."
    DUPREY @ think "Hmm... ¿Cómo sabes todo eso? La mayoría no conoce la historia completa."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:397
translate es qst_TheDarkPass_CampTalkDuprey_menu_1cc6d473:

    # MC "I studied it."
    MC "Lo estudié."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:398
translate es qst_TheDarkPass_CampTalkDuprey_menu_b77999dc:

    # DUPREY @ laugh "Ha! How very wise of you..."
    DUPREY @ laugh "¡Ja! Muy sabio por tu parte..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:399
translate es qst_TheDarkPass_CampTalkDuprey_menu_c8488904:

    # DUPREY "Always good to know how you got to where you’re at but I’m afraid there aren’t many more lessons to learn from it that’d be useful."
    DUPREY "Siempre es bueno saber cómo has llegado a donde estás, pero me temo que no hay muchas más lecciones que aprender de ello que sean útiles."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:400
translate es qst_TheDarkPass_CampTalkDuprey_menu_424524d9:

    # DUPREY "We underestimated the enemy, and we still thought at the time it was all some grand scheme from Kalliban. We overestimated him."
    DUPREY "Subestimamos al enemigo, y en ese momento aún pensábamos que todo era un gran plan de Kalliban. Lo sobreestimamos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:393
translate es qst_TheDarkPass_CampTalkDuprey_menu_04cc0520:

    # DUPREY "We were ordered to defend the neighbouring villages and towns when we should have had the army brought in and amassed an all-out assault, they’d caught us on the backfoot. We were still naive then."
    DUPREY "Nos ordenaron defender los pueblos y ciudades vecinos cuando deberíamos haber hecho venir al ejército y organizar un asalto total, nos habían pillado a contrapié. Entonces aún éramos ingenuos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:402
translate es qst_TheDarkPass_CampTalkDuprey_menu_52865a48:

    # "Captain Duprey took another sip of his drink, he seemed lost in his memories."
    "El capitán Duprey dio otro sorbo a su bebida, parecía perdido en sus recuerdos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:403
translate es qst_TheDarkPass_CampTalkDuprey_menu_9841065b:

    # DUPREY "We paid the price for those mistakes at Meadow Plains."
    DUPREY "Pagamos el precio de esos errores en Meadow Plains."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:404
translate es qst_TheDarkPass_CampTalkDuprey_menu_1d6c3970:

    # MC "{i}You{/i} were at The Battle of Meadow Plains?"
    MC "¿{i}Estuviste{/i} en la batalla de Meadow Plains?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:405
translate es qst_TheDarkPass_CampTalkDuprey_menu_a7267a8b:

    # DUPREY "That I was."
    DUPREY "Así es."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:406
translate es qst_TheDarkPass_CampTalkDuprey_menu_3e8e0a2d:

    # DUPREY "I remember the bloodshed in the streets from the towns that had been annihilated."
    DUPREY "Recuerdo el derramamiento de sangre en las calles de los pueblos aniquilados."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:407
translate es qst_TheDarkPass_CampTalkDuprey_menu_22d390e2:

    # DUPREY "Every corner you turned around had death waiting for you on the other side."
    DUPREY "En cada esquina que doblabas te esperaba la muerte al otro lado."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:408
translate es qst_TheDarkPass_CampTalkDuprey_menu_36fdb802:

    # DUPREY "And there was the mad rush of thousands fleeing to Novaras to hide behind its walls."
    DUPREY "Y se produjo la loca carrera de miles de personas que huían a Novaras para esconderse tras sus murallas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:409
translate es qst_TheDarkPass_CampTalkDuprey_menu_06bc1e0b:

    # DUPREY "The butchered bodies of the mages and Inquisitors before we arrived to offer relief."
    DUPREY "Los cuerpos masacrados de los magos e inquisidores antes de que llegáramos para ofrecer ayuda."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:410
translate es qst_TheDarkPass_CampTalkDuprey_menu_2020af46:

    # DUPREY "But most of all, I remember THAT battle."
    DUPREY "Pero sobre todo, recuerdo ESA batalla."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:411
translate es qst_TheDarkPass_CampTalkDuprey_menu_92a7cec2:

    # "We had all heard tales about the first great battle for Alderay and of how the ‘legendary General Newheart’ fell trying to relieve Fort Rook, the supposedly impenetrable Fortress of the South."
    "Todos habíamos oído historias sobre la primera gran batalla por Alderay y de cómo el ‘legendario general Newheart’ cayó intentando liberar fuerte Rook, la supuestamente impenetrable fortaleza del sur."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:412
translate es qst_TheDarkPass_CampTalkDuprey_menu_6539d583:

    # MC "... Were you there when General Newheart—"
    MC "... ¿Estabas allí cuando el General Newheart—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:413
translate es qst_TheDarkPass_CampTalkDuprey_menu_db751ab3:

    # DUPREY "Old Iron Heart? Aye, we were friends."
    DUPREY "El viejo Iron Heart? sí, éramos amigos."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:415
translate es qst_TheDarkPass_CampTalkDuprey_menu_975a2b8e:

    # MC "... No way!"
    MC "... ¡No puede ser!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:416
translate es qst_TheDarkPass_CampTalkDuprey_menu_9b54e0a7:

    # MC "You knew General Newheart?"
    MC "¿Conociste al General Newheart?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:417
translate es qst_TheDarkPass_CampTalkDuprey_menu_de87c018:

    # MC "As in, THE Newheart? "
    MC "¿Como EL Newheart? "

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:418
translate es qst_TheDarkPass_CampTalkDuprey_menu_e1d8f53c:

    # DUPREY "He always hated how they changed his name, Lucan Erunheart was his real name before he was ‘blessed’ with ‘Newheart, Defender of The Realm’."
    DUPREY "Siempre odió cómo le cambiaron el nombre, Lucan Erunheart era su verdadero nombre antes de ser ‘bendecido’ con ‘Newheart, defensor del reino’."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:419
translate es qst_TheDarkPass_CampTalkDuprey_menu_409e8321:

    # DUPREY "But yes, I knew him alright."
    DUPREY "Pero sí, le conocía bien."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:420
translate es qst_TheDarkPass_CampTalkDuprey_menu_191438df:

    # DUPREY "I was there at the war table with him; we strategized many a battle together."
    DUPREY "Estuve con él en la mesa de guerra; juntos trazamos la estrategia de muchas batallas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:421
translate es qst_TheDarkPass_CampTalkDuprey_menu_8d6c11d2:

    # DUPREY "It was the two of us that pushed back Kalliban’s first invasion AND the Dark Elf King’s encroach. "
    DUPREY "Fuimos nosotros dos los que hicimos retroceder la primera invasión de Kalliban Y la invasión del rey de los elfos oscuros."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:422
translate es qst_TheDarkPass_CampTalkDuprey_menu_89a0558d:

    # MC "That’s... That’s incredible!"
    MC "Eso es... ¡Es increíble!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:423
translate es qst_TheDarkPass_CampTalkDuprey_menu_8523b42e:

    # DUPREY "Bah... I was a younger man back then, I ain’t as fast as I used to be."
    DUPREY "Bah... Yo era más joven entonces, ya no soy tan rápido como antes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:424
translate es qst_TheDarkPass_CampTalkDuprey_menu_77f64d26:

    # DUPREY "Newheart though? The best warrior I’d ever met and a brilliant commander in the field."
    DUPREY "¿Pero Newheart? El mejor guerrero que había conocido y un brillante comandante en el campo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:425
translate es qst_TheDarkPass_CampTalkDuprey_menu_bc2aaa32:

    # DUPREY "Handsome bastard as well, got all the girls swooning after him."
    DUPREY "Un cabrón muy guapo, todas las chicas se derretían por él."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:426
translate es qst_TheDarkPass_CampTalkDuprey_menu_0f58b1c0:

    # DUPREY "They still singing about him?"
    DUPREY "¿Siguen cantando sobre él?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:427
translate es qst_TheDarkPass_CampTalkDuprey_menu_0453fc0f:

    # MC "All the time! The man’s a legend!"
    MC "¡Todo el tiempo! ¡El hombre es una leyenda!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:428
translate es qst_TheDarkPass_CampTalkDuprey_menu_d3379069:

    # MC "I can’t believe you actually met him! You’re bound to hear at least one song about him in any of the taverns once people have had a drink or two!"
    MC "¡No puedo creer que lo conocieras! ¡Seguro que oyes al menos una canción sobre él en cualquiera de las tabernas una vez que la gente se ha tomado una copa o dos!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:429
translate es qst_TheDarkPass_CampTalkDuprey_menu_3829efd5:

    # DUPREY @ think "Hmph..."
    DUPREY @ think "Hmph..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:430
translate es qst_TheDarkPass_CampTalkDuprey_menu_cc702e61:

    # MC "... Where did it all go wrong?"
    MC "... ¿Dónde empezó a ir todo mal?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:431
translate es qst_TheDarkPass_CampTalkDuprey_menu_56d22cd3:

    # "The Captain had become morose as he reminisced, but his anger was now evident as his eyes glared into the embers of the fire."
    "El capitán se había vuelto malhumorado mientras recordaba, pero su ira era ahora evidente mientras sus ojos se clavaban en las brasas del fuego."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:432
translate es qst_TheDarkPass_CampTalkDuprey_menu_c44cfa87:

    # DUPREY "{i}Mesamor happened.{/i}"
    DUPREY "{i}Mesamor ocurrió.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:433
translate es qst_TheDarkPass_CampTalkDuprey_menu_4a075af6:

    # MC "What do you mean?"
    MC "¿A qué se refiere?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:434
translate es qst_TheDarkPass_CampTalkDuprey_menu_95893d7d:

    # DUPREY "I mean that old prick decided the siege tactics we had laid out would have taken too long."
    DUPREY "Quiero decir que ese viejo imbécil decidió que las tácticas de asedio que habíamos preparado habrían llevado demasiado tiempo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:435
translate es qst_TheDarkPass_CampTalkDuprey_menu_182fc79b:

    # DUPREY "So, he decided in his infinite fucking wisdom to push through some other general’s much more aggressive strategy."
    DUPREY "Así que, en su puta sabiduría infinita, decidió imponer la estrategia mucho más agresiva de otro general."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:436
translate es qst_TheDarkPass_CampTalkDuprey_menu_546d1fd8:

    # DUPREY "Mesamor couldn’t stand the idea of a prolonged war, he wanted to take back Fort Rook as quickly as possible and march south to take back everything else he’d lost."
    DUPREY "Mesamor no soportaba la idea de una guerra prolongada, quería recuperar fuerte Rook lo antes posible y marchar hacia el sur para recuperar todo lo demás que había perdido."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:437
translate es qst_TheDarkPass_CampTalkDuprey_menu_90a9bd26:

    # MC "I take it you didn’t approve."
    MC "Supongo que no lo aprobaste."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:438
translate es qst_TheDarkPass_CampTalkDuprey_menu_07a85dee:

    # DUPREY "Years of actual battle experience and advice were cast out the window for the sake of bureaucracy, what do you think?"
    DUPREY "Años de experiencia y consejos reales de batalla fueron arrojados por la ventana en aras de la burocracia, ¿qué te parece?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:439
translate es qst_TheDarkPass_CampTalkDuprey_menu_fdd64753:

    # MC "... So, what do you remember of the battle itself?"
    MC "... Entonces, ¿qué recuerdas de la batalla en sí?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:440
translate es qst_TheDarkPass_CampTalkDuprey_menu_42fc440a:

    # DUPREY "Lots of fighting... Dead everywhere... I saw more bodies that day than most men see in a lifetime."
    DUPREY "Mucha lucha... Muertos por todas partes... Vi más cadáveres ese día que la mayoría de los hombres en toda su vida."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:441
translate es qst_TheDarkPass_CampTalkDuprey_menu_719f6fe6:

    # DUPREY "From all the smoke and what felt like an avalanche of blood, it was hard just to breathe, never mind making sense of the field..."
    DUPREY "Con todo el humo y lo que parecía una avalancha de sangre, era difícil respirar, por no hablar de comprender lo que pasaba en el terreno..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:442
translate es qst_TheDarkPass_CampTalkDuprey_menu_5b6ff3e4:

    # DUPREY "Across the way on a small hill, I saw Newheart in that shimmering armour you lot like singing about so much. "
    DUPREY "Al otro lado del camino, en una pequeña colina, vi a Newheart con esa reluciente armadura de la que tanto os gusta cantar."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:443
translate es qst_TheDarkPass_CampTalkDuprey_menu_021f89e6:

    # DUPREY "He stood alone against the Demorai General, a monstrous thing I can’t seem to forget even when I try..."
    DUPREY "Se enfrentó solo al general demorai, una cosa monstruosa que no puedo olvidar aunque lo intente..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:444
translate es qst_TheDarkPass_CampTalkDuprey_menu_5d817988:

    # DUPREY "{i}Zanarak.{/i}"
    DUPREY "{i}Zanarak.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:445
translate es qst_TheDarkPass_CampTalkDuprey_menu_cff33da7:

    # "{i}Zanarak{/i}, the bogeyman of every child in Alderay."
    "{i}Zanarak{/i}, el hombre del saco de todos los niños de Alderay."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:446
translate es qst_TheDarkPass_CampTalkDuprey_menu_0d9c3b4c:

    # "Stories spread far and wide of a supposed leader of the Demorai’s armies, unstoppable and ruthless, wings so large they could block out the sun and plunge an entire battlefield into a darkness as awful as himself..."
    "Por todas partes corrían historias de un supuesto líder de los ejércitos de los demorai, imparable y despiadado, con unas alas tan grandes que podían tapar el sol y sumir todo un campo de batalla en una oscuridad tan espantosa como él mismo..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:447
translate es qst_TheDarkPass_CampTalkDuprey_menu_6cc1af85:

    # "Some doubt if he ever existed, so few survivors remain whenever he’s claimed to have been sighted and the tales they told were wilder than the legends of Newheart."
    "Algunos dudan de que alguna vez existiera, ya que quedan tan pocos supervivientes cuando se afirma que fue avistado y las historias que contaban eran más salvajes que las leyendas de Newheart."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:448
translate es qst_TheDarkPass_CampTalkDuprey_menu_ba79f724:

    # MC "He’s... {i}real?{/i}"
    MC "¿Es... {i}real?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:449
translate es qst_TheDarkPass_CampTalkDuprey_menu_42eb289b:

    # DUPREY "As real as you and me, boy... Make no mistake about that."
    DUPREY "Tan real como tú y yo, chico... No te equivoques al respecto."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:450
translate es qst_TheDarkPass_CampTalkDuprey_menu_aaabade5:

    # DUPREY "{i}*Sigh*{/i} He fought bravely..."
    DUPREY "{i}*Suspiro*{/i} Luchó valientemente..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:451
translate es qst_TheDarkPass_CampTalkDuprey_menu_445ed618:

    # MC "How did—"
    MC "¿De qué forma—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:452
translate es qst_TheDarkPass_CampTalkDuprey_menu_ab292432:

    # DUPREY "It took his head."
    DUPREY "Se llevó su cabeza."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:453
translate es qst_TheDarkPass_CampTalkDuprey_menu_7c0a6889:

    # DUPREY "I still remember that thing clutching him by the hair and holding it up for us all to see..."
    DUPREY "Aún recuerdo a esa cosa sujetándole por el pelo y levantándolo para que todos lo viéramos..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:454
translate es qst_TheDarkPass_CampTalkDuprey_menu_42c2bad6:

    # DUPREY "Boasting of his kill, gloating at how easy it had been to take down the very best of us."
    DUPREY "Alardeando de su muerte, regodeándose de lo fácil que había sido acabar con el mejor de nosotros."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:455
translate es qst_TheDarkPass_CampTalkDuprey_menu_5ee5ad2c:

    # "A chilling sense of dread slithered into every bone in my body... {i}What if we encountered some monster Zanarak while we were scouting out here now?{/i}"
    "Una escalofriante sensación de terror se deslizó por cada hueso de mi cuerpo... {i}¿Y si nos encontramos con algún monstruo como Zanarak mientras estamos explorando aquí?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:456
translate es qst_TheDarkPass_CampTalkDuprey_menu_aa8fdbe9:

    # DUPREY "After that, you know the rest."
    DUPREY "Después de eso, ya sabes el resto."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:457
translate es qst_TheDarkPass_CampTalkDuprey_menu_e8c1063f:

    # DUPREY "Lots of fighting, {i}Daggerfall.{/i}"
    DUPREY "Mucha lucha, {i}Daggerfall.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:458
translate es qst_TheDarkPass_CampTalkDuprey_menu_f2837818:

    # DUPREY "Mesamor deposed and Alcott declaring himself Emperor..."
    DUPREY "Mesamor depuesto y Alcott declarándose emperador..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:459
translate es qst_TheDarkPass_CampTalkDuprey_menu_eaa48d0c:

    # MC "Can I hear some more about Daggerfall?"
    MC "¿Puedo oír algo más sobre Daggerfall?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:460
translate es qst_TheDarkPass_CampTalkDuprey_menu_75f1addb:

    # DUPREY "I’m not a history teacher, lad."
    DUPREY "No soy profesor de historia, muchacho."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:461
translate es qst_TheDarkPass_CampTalkDuprey_menu_d246bf3c:

    # MC "I know sir, sorry I... guess I just to wish to hear from someone who was actually there."
    MC "Lo sé señor, lo siento yo... supongo que solo deseo escuchar a alguien que realmente estuvo allí."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:462
translate es qst_TheDarkPass_CampTalkDuprey_menu_e1044f79:

    # MC "I’m not sure how reliable those books we were given are."
    MC "No estoy seguro de la fiabilidad de los libros que nos dieron."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:463
translate es qst_TheDarkPass_CampTalkDuprey_menu_0014520a:

    # DUPREY "Hmph... Wise boy, you are... They probably try to paint a rosier picture than it really was."
    DUPREY "Hmph... Eres un chico listo... Probablemente tratan de pintar un cuadro más rosado de lo que realmente era."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:464
translate es qst_TheDarkPass_CampTalkDuprey_menu_e9a51bd0:

    # DUPREY "Don’t wanna give you kids too many nightmares, we’d never get you fighting for us otherwise!"
    DUPREY "No quiero daros demasiadas pesadillas, ¡si no, nunca conseguiríamos que lucharais por nosotros!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:465
translate es qst_TheDarkPass_CampTalkDuprey_menu_69ce2041:

    # DUPREY "Operation Daggerfall was our last real gamble."
    DUPREY "La operación Daggerfall fue nuestra última apuesta real."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:466
translate es qst_TheDarkPass_CampTalkDuprey_menu_a90a9028:

    # DUPREY "We had managed some years before, when the war with the Demorai first really started, to suspend previous conflicts and form a loose alliance with the other kingdoms and races;"
    DUPREY "Algunos años antes, cuando comenzó la guerra con los Demorai, habíamos conseguido suspender los conflictos anteriores y formar una alianza informal con los demás reinos y razas;"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:467
translate es qst_TheDarkPass_CampTalkDuprey_menu_077b901a:

    # DUPREY "Elves, Dwarves, Orcs, even the bloody Greater Trading Company..."
    DUPREY "Elfos, enanos, orcos, incluso la maldita Gran Compañía Comercial..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:468
translate es qst_TheDarkPass_CampTalkDuprey_menu_005134d0:

    # DUPREY "Didn’t do much good though when the bastards kept showing up everywhere."
    DUPREY "Aunque no sirvió de mucho cuando los bastardos siguieron apareciendo por todas partes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:469
translate es qst_TheDarkPass_CampTalkDuprey_menu_c64175ec:

    # DUPREY "Following the failure of The Great Demorai Siege, we were in high spirits after our first major win."
    DUPREY "Tras el fracaso del gran asedio demorai, estábamos muy animados por nuestra primera gran victoria."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:470
translate es qst_TheDarkPass_CampTalkDuprey_menu_55e137af:

    # DUPREY "We tried pushing back harder and faster to reclaim the South, but we were losing far too many men."
    DUPREY "Intentamos recuperar el sur con más fuerza y rapidez, pero perdíamos demasiados hombres."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:471
translate es qst_TheDarkPass_CampTalkDuprey_menu_3792fe3b:

    # DUPREY "We had left people starving on the home front and many were starting to think the whole thing was a mistake, that a new strategy was needed."
    DUPREY "Habíamos dejado a la gente hambrienta en el frente interno y muchos empezaban a pensar que todo era un error, que se necesitaba una nueva estrategia."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:472
translate es qst_TheDarkPass_CampTalkDuprey_menu_5e0c932f:

    # DUPREY "I still remember stealing boots from some dead lieutenant because mine were literally rotting away..."
    DUPREY "Todavía recuerdo haber robado las botas de algún teniente muerto porque las mías estaban literalmente pudriéndose..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:473
translate es qst_TheDarkPass_CampTalkDuprey_menu_c8369a76:

    # DUPREY "{i}*Sigh*{/i} Then came {i}Daggerfall{/i}."
    DUPREY "{i}*Suspiro*{/i} Entonces ocurrió {i}Daggerfall{/i}."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:474
translate es qst_TheDarkPass_CampTalkDuprey_menu_928e3931:

    # "The Captain took another uneasy swig of his drink, as if pushing down some vile memory."
    "El capitán dio otro trago inquieto a su bebida, como si apartara de sí algún vil recuerdo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:475
translate es qst_TheDarkPass_CampTalkDuprey_menu_dbc2b92f:

    # DUPREY "{i}Fucking Daggerfall.{/i}"
    DUPREY "{i}Maldito Daggerfall.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:476
translate es qst_TheDarkPass_CampTalkDuprey_menu_6883b9ab:

    # MC "They tried to tell us in class that {i}Daggerfall{/i} wasn’t a total failure, that—"
    MC "Intentaron decirnos en clase que {i}Daggerfall{/i} no fue un fracaso total, que—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:477
translate es qst_TheDarkPass_CampTalkDuprey_menu_99061ed9:

    # DUPREY "Oh, did they now?"
    DUPREY "Oh, ¿ah, sí?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:478
translate es qst_TheDarkPass_CampTalkDuprey_menu_78fa766f:

    # DUPREY "Bullshit, it was a disaster, and don’t you ever let any fancy prick in shiny armour who wasn’t even there tell you otherwise."
    DUPREY "Una mierda, fue un desastre, y no dejes que ningún capullo con armadura brillante que ni siquiera estuvo allí te diga lo contrario."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:479
translate es qst_TheDarkPass_CampTalkDuprey_menu_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:480
translate es qst_TheDarkPass_CampTalkDuprey_menu_fcc5db74:

    # DUPREY "It was Mesamor’s last real throw of the dice."
    DUPREY "Era la última apuesta real de Mesamor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:481
translate es qst_TheDarkPass_CampTalkDuprey_menu_bd72acb9:

    # DUPREY "He thought to divide the army in two and have them sweep down like scythes, hoping to crush the enemy between them on two fronts."
    DUPREY "Pensó en dividir el ejército en dos y hacer que descendieran como guadañas, con la esperanza de aplastar al enemigo entre los dos frentes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:482
translate es qst_TheDarkPass_CampTalkDuprey_menu_b1240136:

    # DUPREY "By that point, what was it? 1155? 1156 maybe?"
    DUPREY "Para entonces, ¿qué era? 1155? ¿Quizás 1156?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:483
translate es qst_TheDarkPass_CampTalkDuprey_menu_d1ee329d:

    # DUPREY "Either way, we had neither the manpower nor the resources to pull it off, they quickly broke through our lines and we had to retreat, weaker than ever."
    DUPREY "En cualquier caso, no teníamos ni la mano de obra ni los recursos para lograrlo, rompieron rápidamente nuestras líneas y tuvimos que retirarnos, más débiles que nunca."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:484
translate es qst_TheDarkPass_CampTalkDuprey_menu_2e122687:

    # DUPREY "... After that, Alcott led his coup, Mesamor became just a puppet, a monarch in name and nothing more, and the kingdom got split into factions."
    DUPREY "... Después de eso, Alcott dio su golpe de estado, Mesamor se convirtió en una simple marioneta, un monarca de nombre y nada más, y el reino se dividió en facciones."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:485
translate es qst_TheDarkPass_CampTalkDuprey_menu_c49fd91e:

    # MC "... I see."
    MC "... Ya veo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:489
translate es qst_TheDarkPass_CampTalkDuprey_menu_e3b0a5e0:

    # DUPREY "Don’t know, orders are to secure the site and bring back the relics, that’s it."
    DUPREY "No lo sé, las órdenes son asegurar el sitio y traer de vuelta las reliquias, eso es todo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:490
translate es qst_TheDarkPass_CampTalkDuprey_menu_35505111:

    # DUPREY "Frankly, I couldn’t give a shit about what we’re picking up."
    DUPREY "Francamente, me importa una mierda lo que estamos recogiendo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:491
translate es qst_TheDarkPass_CampTalkDuprey_menu_4a7e500e:

    # DUPREY "In and out is my only concern."
    DUPREY "Entrar y salir es mi única preocupación."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:494
translate es qst_TheDarkPass_CampTalkDuprey_menu_439e127d:

    # DUPREY "My wife passed to fever."
    DUPREY "Mi mujer murió de fiebre."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:495
translate es qst_TheDarkPass_CampTalkDuprey_menu_328b738e:

    # MC "Oh... I’m sorry, sir."
    MC "Oh... Lo siento, señor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:496
translate es qst_TheDarkPass_CampTalkDuprey_menu_1b214ce0:

    # DUPREY "It’s alright, it was during the mass fleeing to Novaras, wasn’t just people hiding behind those walls but plague and famine as well..."
    DUPREY "Está bien, fue durante la huida masiva a Novaras, no era solo gente escondiéndose tras esas murallas sino también plaga y hambruna..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:497
translate es qst_TheDarkPass_CampTalkDuprey_menu_0b409594:

    # DUPREY "My wife was a beauty... She was ravaged by the plague and her body just gave up eventually."
    DUPREY "Mi esposa era una belleza... Fue devastada por la plaga y su cuerpo se rindió."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:498
translate es qst_TheDarkPass_CampTalkDuprey_menu_2a4eac44:

    # DUPREY "My daughter is alive though, somewhere up north in Angmurus, helping with the negotiations."
    DUPREY "Pero mi hija está viva, en algún lugar del norte, en Angmurus, ayudando en las negociaciones."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:499
translate es qst_TheDarkPass_CampTalkDuprey_menu_2d204a49_1:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:500
translate es qst_TheDarkPass_CampTalkDuprey_menu_28466b5a:

    # DUPREY @ happy "Feisty little thing let me know straight up she’d learn how to swing an axe like me! Ha!"
    DUPREY @ happy "¡La pequeña filuchadora me hizo saber que aprendería a blandir un hacha como yo! ¡Ja!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:501
translate es qst_TheDarkPass_CampTalkDuprey_menu_912dda56:

    # DUPREY "Lord... I haven’t seen her in... {i}eight years{/i} now."
    DUPREY "Señor... No la he visto e... {i}ocho años{/i}."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:502
translate es qst_TheDarkPass_CampTalkDuprey_menu_ad9d3945:

    # MC "Do you know if she’s okay?"
    MC "¿Sabes si está bien?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:503
translate es qst_TheDarkPass_CampTalkDuprey_menu_c343a50d:

    # DUPREY "We exchange letters monthly, and I still receive reports on her from time to time, mostly trouble that she’s been causing..."
    DUPREY "Intercambiamos cartas mensualmente, y sigo recibiendo informes sobre ella de vez en cuando, sobre todo problemas que ha causado..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:504
translate es qst_TheDarkPass_CampTalkDuprey_menu_d3e2f307:

    # DUPREY "When this is over, it’ll be good to see her again... I’d like to see that axe swing of her myself one day!"
    DUPREY "Cuando esto termine, será bueno volver a verla... ¡Me gustaría ver ese hachazo de ella algún día!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:505
translate es qst_TheDarkPass_CampTalkDuprey_menu_3be6f501:

    # DUPREY "... How about you? Anyone back home?"
    DUPREY "... ¿Y tú? ¿Hay alguien en casa?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:506
translate es qst_TheDarkPass_CampTalkDuprey_menu_eeb626c5:

    # MC "Yeah... There’s a few people waiting for me."
    MC "Sí... Hay algunas personas esperándome."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:507
translate es qst_TheDarkPass_CampTalkDuprey_menu_ad8c989c:

    # DUPREY "Hm... That’s good... You think of them... They’ll give you a reason to survive when you need it."
    DUPREY "Hm... Eso es bueno... Piensa en ellos... Te darán una razón para sobrevivir cuando lo necesites."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:512
translate es qst_TheDarkPass_CampTalkDuprey_menu_e7e53552:

    # MC "That's all, sir."
    MC "Eso es todo, señor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:513
translate es qst_TheDarkPass_CampTalkDuprey_menu_a5617ab8:

    # DUPREY "Enjoy your evening, boy."
    DUPREY "Disfruta del anochecer, muchacho."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:514
translate es qst_TheDarkPass_CampTalkDuprey_menu_cec2f66c:

    # MC "Captain."
    MC "Capitán."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:521
translate es qst_TheDarkPass_CampTalkDuprey_rep_cec2f66c:

    # MC "Captain."
    MC "Capitán."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:522
translate es qst_TheDarkPass_CampTalkDuprey_rep_df42c9dc:

    # DUPREY "Enjoy the rest of your evening now, boy."
    DUPREY "Disfruta del resto del anochecer, muchacho."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:523
translate es qst_TheDarkPass_CampTalkDuprey_rep_d3f4e1d4:

    # MC "Aye Captain."
    MC "Sí, Capitán."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:532
translate es qst_TheDarkPass_CampTalkBorras_8c638585:

    # MC "Sir."
    MC "Señor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:533
translate es qst_TheDarkPass_CampTalkBorras_aee6c745:

    # BORRAS "Hm? Oh, it’s you."
    BORRAS "¿Hm? Oh, eres tú.."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:534
translate es qst_TheDarkPass_CampTalkBorras_0a1b45ef:

    # BORRAS "Nicely done out there on the ridge earlier."
    BORRAS "Bien hecho en la ladera antes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:535
translate es qst_TheDarkPass_CampTalkBorras_b4e53b47:

    # MC "Thank you, sir."
    MC "Gracias, señor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:536
translate es qst_TheDarkPass_CampTalkBorras_5d38c9d0:

    # BORRAS "I’d stay and chat, but I need to consult with some of the other lieutenants, farewell."
    BORRAS "Me quedaría a charlar, pero tengo que consultar con otros tenientes, adiós."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:537
translate es qst_TheDarkPass_CampTalkBorras_3e3c1fc1:

    # MC "Farewell, sir."
    MC "Adiós, señor."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:538
translate es qst_TheDarkPass_CampTalkBorras_c0a6ed25:

    # "He seems tense... Maybe there’s something he’s not telling us."
    "Parece tenso... Tal vez hay algo que no nos está diciendo."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:545
translate es qst_TheDarkPass_CampPlayCards_0fb92a86:

    # "As I headed over towards the men gathered around playing cards, one of them pulled up a seat for me."
    "Al acercarme a los hombres reunidos jugando a las cartas, uno de ellos me ofrece un asiento."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:542
translate es qst_TheDarkPass_CampPlayCards_87fc99d0:

    # RANDOM_SOLDIER "Oi oi! Fancy a game of cards?"
    RANDOM_SOLDIER "¡Eh, eh! ¿Te apetece una partida de cartas?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:548
translate es qst_TheDarkPass_CampPlayCards_690b7417:

    # MC "Sure."
    MC "Claro."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:550
translate es qst_TheDarkPass_CampPlayCards_f405fbcf:

    # "We ran some rounds of Steel Maidens."
    "Hicimos algunas rondas de Doncellas de acero."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:551
translate es qst_TheDarkPass_CampPlayCards_8df3c4da:

    # "It was a popular game among warrior society due to it's lewd artwork paired with tactical, competitive gameplay."
    "Era un juego muy popular entre la comunidad de guerreros por su diseño lascivo combinado con una jugabilidad táctica y competitiva."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:552
translate es qst_TheDarkPass_CampPlayCards_bf852033:

    # "Unfortunately, I never brought my own deck so I was hammered."
    "Por desgracia, nunca traía mi propia baraja, así que me machacaron."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:558
translate es qst_TheDarkPass_TooLateGoToSleep_d6e6dd73:

    # "It was getting late, so I have decided to go to my tent to catch some sleep before marching out again tomorrow."
    "Se estaba haciendo tarde, así que decidí ir a mi tienda a dormir un poco antes de volver a marchar mañana."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:566
translate es qst_TheDarkPass_GoToSleepInTent_2a39facb:

    # "Peering out of my tent I noticed Kiara still overlooking the vast deadlands, watching carefully for signs of movement."
    "Me asomé a la tienda y vi que Kiara seguía observando las vastas tierras muertas, atenta a cualquier señal de movimiento."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:567
translate es qst_TheDarkPass_GoToSleepInTent_52ca1d16:

    # "When she saw me, she smiled faintly before awkwardly turning away."
    "Cuando me vio, sonrió débilmente antes de darse la vuelta torpemente."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:568
translate es qst_TheDarkPass_GoToSleepInTent_81b7c730:

    # "Markus, over on the other side of camp was relaxed, chatting animatedly with some of the other Scouts."
    "Markus, al otro lado del campamento, estaba relajado, charlando animadamente con algunos de los otros exploradores."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:569
translate es qst_TheDarkPass_GoToSleepInTent_b05e3ffe:

    # "It was nice seeing him happy, he hadn’t seemed quite so relaxed for a while, and neither had I."
    "Era agradable verle feliz, hacía tiempo que no parecía tan relajado, y yo tampoco."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:571
translate es qst_TheDarkPass_GoToSleepInTent_2888bd89:

    # "Rolling over, I soon began to drift off to sleep."
    "Me di la vuelta y pronto empecé a dormirme."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:572
translate es qst_TheDarkPass_GoToSleepInTent_6ad80498:

