    MC "Todo está confuso, lo siento, mi señor, todo parece una pesadilla..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1592
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_58b51746:

    # ALCOTT "Hmm. I see."
    ALCOTT "Hmm. Ya veo."

