    "Markus me miró y también retiró la mano."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1435
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_864bdbb5:

    # MARKUS "You okay?"
    MARKUS "¿Estás bien?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1436
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_81175200:

    # MC "This is weird, I thought—"
    MC "Esto es raro, pensé—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1440
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_8505186f:

