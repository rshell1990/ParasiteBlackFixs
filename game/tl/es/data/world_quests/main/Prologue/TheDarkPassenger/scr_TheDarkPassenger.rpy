translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_9e91bd01:

    # "I was convinced that Alcott did not entirely believe my story, but it must have satisfied him enough for now at least."
    "Estaba convencido de que Alcott no creía del todo mi historia, pero debía de satisfacerle lo suficiente al menos por ahora."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1597
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_976a04cd:

    # ALCOTT "... In light of the unusual circumstances surrounding the Second Scouts Division and the danger you single-handedly faced along with the losses your unit suffered, you are both hereby relinquished of your duties as Scouts."
    ALCOTT "... A la luz de las circunstancias inusuales que rodean a la segunda división de exploradores y el peligro que enfrentaron sin ayuda de nadie, junto con las pérdidas que sufrió su unidad, ambos quedan relevados de sus deberes como exploradores."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1598
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_1bf8606f:

    # MC "Sir? You mean—"
    MC "¿Señor? ¿Quiere decir que—"

