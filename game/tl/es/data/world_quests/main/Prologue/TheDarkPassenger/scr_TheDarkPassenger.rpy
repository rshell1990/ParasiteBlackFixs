# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:180
translate es qst_TheDarkPass_MarchOut_232f1f1f:

    # "Men patrolled around the borders of the camp on lookout for any signs of Demorai."
