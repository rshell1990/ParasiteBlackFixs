translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_a0073a56:

    # ALCOTT "You best hope your memories return swiftly, there are still many questions about what has happened to the Second Scouts."
    ALCOTT "Será mejor que recuperéis pronto la memoria, aún hay muchas preguntas sobre lo que les ha ocurrido a los segundos exploradores."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1594
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_41fa21ba:

    # ALCOTT "Questions {i}I{/i} want answers to."
    ALCOTT "Preguntas para las que {i}yo{/i} quiero respuestas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1595
translate es qst_TheDarkPass_ObelisksRoomCheckObelisks_b23d52c3:

    # MC "... I will do my best to remember, my lord."
    MC "... Haré lo posible por recordarlo, mi señor."

