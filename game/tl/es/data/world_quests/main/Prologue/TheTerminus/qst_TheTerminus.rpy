    MC "Manos a la obra y al fuerte Sebastian."

translate es strings:

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Get gold from the chest"
    new "Obtén oro del cofre"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "I will certainly need some currency to handle whatever today brings. There must be some in my chest."
    new "Sin duda necesitaré algo de dinero para hacer frente a lo que me depare el día de hoy. Debe haber algo en mi cofre."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Head out of your room"
    new "Sal de tu habitación"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "It's time to head out."
    new "Es hora de salir."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Attend the Terminus Ceremony"
    new "Asiste a la ceremonia de Terminus"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "The Terminus Ceremony is held in the Royal Palace, at the very heart of the City of Novaras. I should make haste."
    new "La ceremonia de Terminus se celebra en el Palacio Real, en pleno corazón de la ciudad de Novaras. Debería darme prisa."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Meet Adara at the tavern\nor visit the bordello"
    new "Reúnete con Adara en la taberna\no visita el burdel"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Struck by the prospect of joining the Scouts Corp, I am unsure how to spend the remainder of today. Markus went for the pleasure district to get laid. I remember Adara talking about catching up at the Iron Unicorn tavern, after the ceremony."
    new "Ante la perspectiva de unirme al cuerpo de exploradores, no sé cómo pasar el resto del día. Markus fue al distrito del placer a echar un polvo. Recuerdo que Adara habló de ponerse al día en la taberna Unicornio de Hierro, después de la ceremonia."
    
    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "There goes my last night in the city as a free citizen. I should head home and try to get some sleep."
    new "Ahí va mi última noche en la ciudad como ciudadano libre. Debería irme a casa e intentar dormir un poco."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Report to Fort Sebastian"
    new "Preséntate en el fuerte Sebastian"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "During the Terminus Ceremony held yesterday I have found out that I am to be a part of the Scouts Corp, the reconnaissance branch of Emperor Alcott's army. I am to report to Fort Sebastian to begin my training. Some graduation..."
    new "Durante la Ceremonia de Terminus celebrada ayer me he enterado de que voy a formar parte del cuerpo de exploradores, la rama de reconocimiento del ejército del emperador Alcott. Debo presentarme en el fuerte Sebastian para comenzar mi entrenamiento. Vaya graduación..."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:12
    old "The Terminus"
    new "El Terminus"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:13
    old "As I have come of age, the Terminus Ceremony is about to decide my future for life. I will find out what fate has our kingdom blessed me with. Hopefully, I am prepared for it."
    new "Al haber alcanzado la mayoría de edad, la ceremonia Terminus está a punto de decidir mi futuro de por vida. Averiguaré con qué destino me ha bendecido nuestro reino. Espero estar preparado para ello."
    
    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:47
    old "I should grab my gold first."
    new "Debería coger mi oro antes."

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:318
    old "Loyal Citizen!"
    new "¡Ciudadano leal!"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:314
    old "You have been bestowed the honor and privilege of joining\nthe Scouts Corp!"
    new "¡Se te ha concedido el honor y el privilegio de unirte \nal cuerpo de exploradores!"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:319
    old "Please report to Fort Sebastian to begin your training at once!"
    new "¡Por favor, preséntese en el fuerte Sebastian para comenzar su entrenamiento!"

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:323
