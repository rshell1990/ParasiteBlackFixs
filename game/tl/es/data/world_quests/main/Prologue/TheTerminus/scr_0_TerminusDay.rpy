translate es qst_Terminus_EnterPalace_64a9ae3b:

    # MARKUS "Don’t worry, Adara! All you need to do is wait a couple years and he’ll—"
    MARKUS "¡No te preocupes, Adara! Todo lo que tienes que hacer es esperar un par de años y él—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:414
translate es qst_Terminus_EnterPalace_158431c5:

    # ADARA @ angry "Finish that sentence if you want to die."
