    REGINA @ smile_talk "¡Pero date prisa! ¡Hoy es un gran día!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:158
translate es qst_Terminus_KitchenEnterMorning_6ecfd72e:

    # ERIKA @ smile_talk "Yes! [player_name!t]!"
    ERIKA @ smile_talk "¡Sí! [player_name!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:162
translate es qst_Terminus_KitchenEnterMorning_f60e5636:

