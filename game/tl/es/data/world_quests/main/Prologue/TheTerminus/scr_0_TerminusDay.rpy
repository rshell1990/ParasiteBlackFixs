# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:161
translate es qst_Terminus_KitchenEnterMorning_de748599:

    # ERIKA @ smile_talk "Oh, lighten up, it’s an important day, right, [regina_ref!t]?"
    ERIKA @ smile_talk "Oh, relájate, es un día importante, ¿verdad, [regina_ref!t]?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:165
translate es qst_Terminus_KitchenEnterMorning_5bc91582:

    # REGINA @ smile_talk "Both he and Markus have been working tirelessly on their studies for months."
    REGINA @ smile_talk "Tanto él como Markus llevan meses trabajando sin descanso en sus estudios."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:166
translate es qst_Terminus_KitchenEnterMorning_15991414:

    # ERIKA @ smile_talk "Glad to hear it, and here I was worried you’d both spend too much time chasing girls."
    ERIKA @ smile_talk "Me alegra oírlo, y yo que estaba preocupada de que pasarais demasiado tiempo persiguiendo chicas."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:167
translate es qst_Terminus_KitchenEnterMorning_27ffcbae:

    # MC @ smile "And risk our great chance at the palace?"
    MC @ smile "¿Y arriesgar nuestra gran oportunidad en el palacio?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:168
translate es qst_Terminus_KitchenEnterMorning_8d17beaa:

    # ERIKA @ lewd_talk "Ah yes, I forgot, you want to chase beautiful AND rich girls."
    ERIKA @ lewd_talk "Ah sí, se me olvidaba, quieres perseguir chicas guapas Y ricas."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:169
translate es qst_Terminus_KitchenEnterMorning_28eda718:

    # MC "I’m a man with reputable tastes, Erika."
    MC "Soy un hombre con buenos gustos, Erika."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:170
translate es qst_Terminus_KitchenEnterMorning_41eb3cb0:

    # ERIKA @ smile_talk "Tastes well above your station, I might add."
    ERIKA @ smile_talk "Gustos muy por encima de su estación, debo añadir."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:171
translate es qst_Terminus_KitchenEnterMorning_3f3dc3f8:

    # REGINA "So, I take it you’re both still planning on being administrators in the Royal Court, isn’t that right?"
    REGINA "Así que, supongo que los dos seguís pensando en ser administradores en la corte real, ¿no es así?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:175
translate es qst_Terminus_KitchenEnterMorning_b61df758:

    # ERIKA @ smile_talk "Hoping for a nice easy life, huh?"
    ERIKA @ smile_talk "Esperando una vida fácil, ¿eh?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:176
translate es qst_Terminus_KitchenEnterMorning_7434d5e2:

    # REGINA @ talk "Oh stop, Erika! Him and every other student is hoping to be designated a nicer role like that."
    REGINA @ talk "¡Oh, para, Erika! Él y cualquier otro estudiante espera ser designado un papel más agradable como ese."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:177
translate es qst_Terminus_KitchenEnterMorning_2a39ea4a:

    # ERIKA @ talk "Most of them are also daydreaming about sleeping with the Princess."
    ERIKA @ talk "La mayoría de ellos también sueñan despiertos con acostarse con la princesa."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:178
translate es qst_Terminus_KitchenEnterMorning_f192bed0:

    # REGINA @ shock_talk "Erika! Your mouth, young lady!"
    REGINA @ shock_talk "¡Erika! ¡Tu boca, jovencita!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:182
translate es qst_Terminus_KitchenEnterMorning_e7b4bc47:

    # REGINA @ talk "Y-You’re joking, right?"
    REGINA @ talk "E-estás bromeando, ¿verdad?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:183
translate es qst_Terminus_KitchenEnterMorning_cba23fe7:

    # ERIKA @ smile_talk "Finally! A job I think you two pervs would actually be good at!"
    ERIKA @ smile_talk "¡Por fin! ¡Un trabajo en el que creo que vosotros dos, pervertidos, seríais buenos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:185
translate es qst_Terminus_KitchenEnterMorning_662ec96d:

    # REGINA @ lewd_talk "AHEM! I hope that wasn’t a {i}serious{/i} suggestion, I don’t know I’d be able to live with the embarrassment of having to explain your new role to people."
    REGINA @ lewd_talk "¡EJEM! Espero que no fuera una sugerencia en {i}serio{/i}, no sé si sería capaz de vivir con la vergüenza de tener que explicar tu nuevo papel a la gente."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:186
translate es qst_Terminus_KitchenEnterMorning_ac18dfc3:

    # MC "Yes, I’m only playing."
    MC "Sí, solo estoy bromeando."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:188
translate es qst_Terminus_KitchenEnterMorning_6c06afb5:

    # REGINA @ talk "I should hope so too!"
    REGINA @ talk "¡Yo también lo espero!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:189
translate es qst_Terminus_KitchenEnterMorning_07d7d654:

    # REGINA @ talk "You’ve both worked far too hard and are far too bright for that kind of work."
    REGINA @ talk "Los dos habéis trabajado demasiado y sois demasiado brillantes para ese tipo de trabajo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:191
translate es qst_Terminus_KitchenEnterMorning_71b3d9fe:

    # REGINA "... Well, that’s odd, it’s all the two of you have talked about for the last few years!"
    REGINA "...Qué raro, ¡es de lo único que habéis hablado los dos en los últimos años!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:192
translate es qst_Terminus_KitchenEnterMorning_b6d9af33:

    # ERIKA "Yeah, why the sudden change of heart? Realised there’s no way in hell you’d be able to woo the Princess, huh?"
    ERIKA "Sí, ¿por qué el repentino cambio de opinión? Te diste cuenta de que no hay manera de que puedas cortejar a la princesa, ¿eh?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:193
translate es qst_Terminus_KitchenEnterMorning_a8b0989d:

    # MC "Cute."
    MC "Qué mona."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:194
translate es qst_Terminus_KitchenEnterMorning_8e4eb0b8:

    # MC "And I dunno, I guess..."
    MC "Y no sé, supongo..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:195
translate es qst_Terminus_KitchenEnterMorning_f56653ee:

    # MC "{i}I’m just not quite sure what I want.{/i}"
    MC "{i}No estoy muy seguro de lo que quiero.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:196
translate es qst_Terminus_KitchenEnterMorning_3fec9308:

    # REGINA "... Well... I’m sure you’ll be good at whatever you end up doing, sweetie."
    REGINA "...Bueno... Estoy segura de que serás bueno en lo que sea que termines haciendo, cariño."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:197
translate es qst_Terminus_KitchenEnterMorning_70857d8b:

    # ERIKA @ talk "Well, this has been fun, but I really must get going."
    ERIKA @ talk "Bueno, esto ha sido divertido, pero tengo que irme."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:199
translate es qst_Terminus_KitchenEnterMorning_f078974e:

    # REGINA @ sad_talk "So soon? We haven’t seen you in weeks!"
    REGINA @ sad_talk "¿Tan pronto? ¡Hace semanas que no te vemos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:200
translate es qst_Terminus_KitchenEnterMorning_319e2dc2:

    # ERIKA @ sad_talk "I know, I know... But there’s some particularly troubling business that needs my full attention."
    ERIKA @ sad_talk "Lo sé, lo sé... Pero hay algunos asuntos particularmente preocupantes que necesitan toda mi atención."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:201
translate es qst_Terminus_KitchenEnterMorning_36627c23:

    # REGINA @ sad_talk "... Hunting more Dark Mages, I suppose?"
    REGINA @ sad_talk "...Cazando más Magos Oscuros, supongo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:202
translate es qst_Terminus_KitchenEnterMorning_01793ebd:

    # ERIKA @ talk "You know I can’t discuss Inquisitor work."
    ERIKA @ talk "Sabes que no puedo discutir el trabajo de inquisidor."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:203
translate es qst_Terminus_KitchenEnterMorning_4fc03764:

    # REGINA @ sad_talk "If we only talked to them more—"
    REGINA @ sad_talk "Si habláramos más con ellos—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:204
translate es qst_Terminus_KitchenEnterMorning_96760879:

    # ERIKA @ sad_talk "We will {i}not{/i} allow tainted magic into Novaras."
    ERIKA @ sad_talk "{i}No{/i} permitiremos magia contaminada en Novaras."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:205
translate es qst_Terminus_KitchenEnterMorning_ab53317b:

    # REGINA @ talk "But times have changed! Our survival depends on cooperation now, not more division."
    REGINA @ talk "Pero los tiempos han cambiado. Nuestra supervivencia depende ahora de la cooperación, no de más división."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:206
translate es qst_Terminus_KitchenEnterMorning_80d8ffc8:

    # ERIKA @ talk "We have enough problems as it is without letting loose dangerous Black Mages across the city."
    ERIKA @ talk "Ya tenemos suficientes problemas como para soltar a peligrosos magos oscuros por la ciudad."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:208
translate es qst_Terminus_KitchenEnterMorning_3b050990:

    # REGINA @ angry_talk "But we need all the mages we can get!"
    REGINA @ angry_talk "¡Pero necesitamos todos los magos que podamos conseguir!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:210
translate es qst_Terminus_KitchenEnterMorning_effab067:

    # ERIKA @ angry_talk "It’s the law, and one I am sworn to uphold."
    ERIKA @ angry_talk "Es la ley, y he jurado cumplirla."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:211
translate es qst_Terminus_KitchenEnterMorning_23843033:

    # REGINA @ angry_talk "Urgh... You’re definitely spending too much time with those Inquisitors; you’re starting to sound just like them."
    REGINA @ angry_talk "Urgh... Definitivamente estás pasando demasiado tiempo con esos inquisidores; estás empezando a sonar igual que ellos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:212
translate es qst_Terminus_KitchenEnterMorning_b86f4408:

    # ERIKA @ angry_talk "You barely know what you’re talking about!"
    ERIKA @ angry_talk "¡Apenas sabes de lo que estás hablando!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:214
translate es qst_Terminus_KitchenEnterMorning_b7fa50d6:

    # ERIKA @ talk "I’ve seen with my own eyes some of the horrors from their twisted magic."
    ERIKA @ talk "He visto con mis propios ojos algunos de los horrores de su magia retorcida."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:216
translate es qst_Terminus_KitchenEnterMorning_c0c3f0c3:

    # REGINA @ talk "Not all magic is pretty, Erika."
    REGINA @ talk "No toda la magia es bonita, Erika."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:212
translate es qst_Terminus_KitchenEnterMorning_9fe99013:

    # ERIKA @ talk "[regina_ref_cap!t], please, you must learn to keep those kinds of beliefs quiet."
    ERIKA @ talk "[regina_ref_cap!t], por favor, debes aprender a callar ese tipo de creencias."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:218
translate es qst_Terminus_KitchenEnterMorning_13a6fd6f:

    # REGINA @ talk "They are born with their magic, you know this."
    REGINA @ talk "Nacen con su magia, lo sabes."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:219
translate es qst_Terminus_KitchenEnterMorning_a140ae77:

    # REGINA @ angry_talk "It’s not a crime to have sympathy for them. "
    REGINA @ angry_talk "No es un delito sentir simpatía por ellos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:220
translate es qst_Terminus_KitchenEnterMorning_02857159:

    # ERIKA @ talk "No, it’s not, but you know full well that being a sympathiser will lead to Inquisitors like myself investigating you and that will make things very {i}very{/i} difficult."
    ERIKA @ talk "No, no lo es, pero sabes muy bien que ser simpatizante hará que inquisidores como yo te investiguen y eso hará las cosas muy {i}muy{/i} difíciles."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:221
translate es qst_Terminus_KitchenEnterMorning_56987547:

    # ERIKA @ talk "... For {i}both{/i} of us."
    ERIKA @ talk "...Para las {i}dos{/i}."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:222
translate es qst_Terminus_KitchenEnterMorning_662000c9:

    # REGINA @ angry_talk "Well, I’m sorry Erika but my opinions on the matter—"
    REGINA @ angry_talk "Bueno, lo siento Erika pero mis opiniones al respecto—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:223
translate es qst_Terminus_KitchenEnterMorning_1b91f8e7:

    # MC angry "That’s enough! Both of you."
    MC angry "¡Es suficiente! Ambas."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:224
translate es qst_Terminus_KitchenEnterMorning_cbfd6a46:

    # REGINA @ sad_talk "... Sorry dear, we shouldn’t be squabbling like this on your big day."
    REGINA @ sad_talk "...Lo siento cariño, no deberíamos discutir así en tu gran día."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:225
translate es qst_Terminus_KitchenEnterMorning_502af9bf:

    # ERIKA @ talk "You’re right, now is not the time for debating politics."
    ERIKA @ talk "Tienes razón, ahora no es el momento de debatir sobre política."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:226
translate es qst_Terminus_KitchenEnterMorning_5b77c2d3:

    # ERIKA @ talk "Especially matters as important as this."
    ERIKA @ talk "Especialmente en asuntos tan importantes como éste."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:228
translate es qst_Terminus_KitchenEnterMorning_513aa734:

    # MC "Will you be back when I get home, Erika?"
    MC "¿Volverás cuando llegue a casa, Erika?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:229
translate es qst_Terminus_KitchenEnterMorning_d9bcd695:

    # ERIKA @ talk "No, unfortunately, I’m afraid not..."
    ERIKA @ talk "No, por desgracia, me temo que no..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:230
translate es qst_Terminus_KitchenEnterMorning_5cc55978:

    # MC @ sad "... Oh... Well, I understand, I guess."
    MC @ sad "... Oh... Bueno, lo entiendo, supongo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:231
translate es qst_Terminus_KitchenEnterMorning_205e64ec:

    # ERIKA @ smile_talk "But I promise I will be back soon! And you and I can both go and celebrate properly together then, I swear it."
    ERIKA @ smile_talk "¡Pero te prometo que volveré pronto! Y tú y yo podremos ir a celebrarlo como es debido, te lo juro."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:232
translate es qst_Terminus_KitchenEnterMorning_e12ad870:

    # MC smile "That would be good..."
    MC smile "Eso estaría bien..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:233
translate es qst_Terminus_KitchenEnterMorning_1b68ba29:

    # MC sad "... I’ve missed you greatly."
    MC sad "...Te he echado mucho de menos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:234
translate es qst_Terminus_KitchenEnterMorning_9f47caa8:

    # ERIKA @ smile_talk "And I you."
    ERIKA @ smile_talk "Y yo a ti."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:235
translate es qst_Terminus_KitchenEnterMorning_54bd5cc3:

    # ERIKA @ talk "... Anyhow, I must get going now."
    ERIKA @ talk "...En fin, tengo que irme ya."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:236
translate es qst_Terminus_KitchenEnterMorning_cd64f564:

    # REGINA @ talk "... Be safe, dear."
    REGINA @ talk "...Cuídate, cariño."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:232
translate es qst_Terminus_KitchenEnterMorning_f0bc2f6f:

    # ERIKA @ talk "Will do, and you too, [player_name!t]."
    ERIKA @ talk "Lo haré, y tú también, [player_name!t]."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:233
translate es qst_Terminus_KitchenEnterMorning_ca2df092:

    # ERIKA @ talk "Look after [regina_ref!t] while I’m gone."
    ERIKA @ talk "Cuida de [regina_ref!t] mientras estoy fuera."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:239
translate es qst_Terminus_KitchenEnterMorning_4e1e6187:

    # ERIKA @ talk "And good luck for your results!"
    ERIKA @ talk "¡Y buena suerte para sus resultados!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:240
translate es qst_Terminus_KitchenEnterMorning_59de7aac:

    # ERIKA @ smile_talk "Who knows! Perhaps you will have the honour of serving under me!"
    ERIKA @ smile_talk "¡Quién sabe! ¡Quizá tengas el honor de servir a mis órdenes!"

