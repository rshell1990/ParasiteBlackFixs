# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:420
translate es qst_Terminus_EnterPalace_f8d171b5:

    # MARKUS "Ow! Fuck! That hurt!"
    MARKUS "¡Ay! ¡Joder! ¡Eso duele!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:421
translate es qst_Terminus_EnterPalace_10b26e90:

    # ADARA @ angry "Hmph! Teach you to be so crude..."
    ADARA @ angry "¡Hmph! Eso te enseñará a no ser tan grosero..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:424
translate es qst_Terminus_EnterPalace_e3aa6700:

    # ADARA @ shock "S-Shut up!"
    ADARA @ shock "¡C-cállate!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:425
translate es qst_Terminus_EnterPalace_762dcae9:

    # ADARA @ angry "Someone has to stop you idiots getting your heads put on sticks!"
    ADARA @ angry "¡Alguien tiene que impedir que os pongan la cabeza en un palo, idiotas!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:432
translate es qst_Terminus_EnterPalace_ea8481dd:

    # "The murmurs of the crowd died down suddenly; the sense of festivities soon became eerie silence."
    "Los murmullos de la multitud se apagaron de repente; la sensación de fiesta pronto se convirtió en un silencio inquietante."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:433
translate es qst_Terminus_EnterPalace_33948c6a:

    # "All heads turned to see our ‘Emperor’, Kendrick Alcott, as he slowly made his way towards the podium, donned in his thick golden armour that clanged with every step, his elite guard marching behind."
    "Todas las cabezas se giraron para ver a nuestro ‘Emperador’, Kendrick Alcott, mientras se dirigía lentamente hacia el podio, ataviado con su gruesa armadura dorada que repiqueteaba a cada paso, con su guardia de élite marchando detrás."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:434
translate es qst_Terminus_EnterPalace_842aed12:

    # "There were murmurs and whispers amongst the crowd, Alcott was not popular by any metric, but he was respected, and above all... {i}feared.{/i}"
    "Había murmullos y cuchicheos entre la multitud, Alcott no era popular ni mucho menos, pero era respetado y, sobre todo... {i}temido.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:437
translate es qst_Terminus_EnterPalace_8ff1bc91:

    # ALCOTT "... Today is a special day for this kingdom."
    ALCOTT "...Hoy es un día especial para este reino."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:438
translate es qst_Terminus_EnterPalace_1e39f10a:

    # ALCOTT @ smile "It has been fourteen years since our war with the Demorai began. Fourteen years of sacrifices..."
    ALCOTT @ smile "Han pasado catorce años desde que comenzó nuestra guerra con los demorai. Catorce años de sacrificios..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:439
translate es qst_Terminus_EnterPalace_4872ab72:

    # ALCOTT " Fourteen years of losses too great to put into words."
    ALCOTT "Catorce años de pérdidas demasiado grandes para expresarlas con palabras."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:440
translate es qst_Terminus_EnterPalace_8be50508:

    # ALCOTT "Each of us has lost someone in this conflict, but the battle continues even now, with many of our kin away from home helping to secure and restore our once great kingdom!"
    ALCOTT "Cada uno de nosotros ha perdido a alguien en este conflicto, ¡pero la batalla continúa incluso ahora, con muchos de nuestros parientes lejos de casa ayudando a asegurar y restaurar nuestro antiguo gran reino!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:441
translate es qst_Terminus_EnterPalace_5dd048a4:

    # ALCOTT "The road ahead is hard, it is brutal... {i}and it is bloody.{/i} "
    ALCOTT "El camino por delante es duro, es brutal... {i}y sangriento.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:442
translate es qst_Terminus_EnterPalace_a11fa683:

    # ALCOTT "But today is a day of new hope!"
    ALCOTT "¡Pero hoy es un día de nueva esperanza!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:443
translate es qst_Terminus_EnterPalace_a9388680:

    # ALCOTT "A day for a new generation to lead the fight!"
    ALCOTT "¡Un día para que una nueva generación lidere la lucha!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:444
translate es qst_Terminus_EnterPalace_a1dfe190:

    # ALCOTT "And we WILL be victorious in this conflict!"
    ALCOTT "¡Y SALDREMOS victoriosos de este conflicto!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:445
translate es qst_Terminus_EnterPalace_7395f2c2:

    # ALCOTT "We will survive and we WILL thrive once again!"
    ALCOTT "Sobreviviremos y ¡VOLVEREMOS a prosperar!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:446
translate es qst_Terminus_EnterPalace_b5393478:

    # ALCOTT "And most importantly, we will do it for them!"
    ALCOTT "Y lo más importante, ¡lo haremos por ellos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:447
translate es qst_Terminus_EnterPalace_fdf784a9:

    # ALCOTT "We will build the world they fought for, the world they wanted you to have!"
    ALCOTT "Construiremos el mundo por el que lucharon, ¡el mundo que querían que tuvieras!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:448
translate es qst_Terminus_EnterPalace_5b213438:

    # ALCOTT "To those of you now bearing the responsibility of helping us restore this kingdom to its former glory, whether soldier or baker, blacksmith or humble street sweeper..."
    ALCOTT "A los que ahora tenéis la responsabilidad de ayudarnos a devolver a este reino su antigua gloria, ya seáis soldados o panaderos, herreros o humildes barrenderos..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:449
translate es qst_Terminus_EnterPalace_9a4b160d:

    # ALCOTT "I salute you!"
    ALCOTT "¡Yo os saludo!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:450
translate es qst_Terminus_EnterPalace_d9a239d2:

    # ALCOTT "HEIL!"
    ALCOTT "¡AVE!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:446
translate es qst_Terminus_EnterPalace_4834d82f:

    # CROWD "HEIL EMPEROR ALCOTT! HEIL THE NEW ALDERIAN EMPIRE!"
    CROWD "¡AVE EMPERADOR ALCOTT! ¡AVE EL NUEVO IMPERIO ALDERIANO!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:454
translate es qst_Terminus_EnterPalace_debab30d:

    # ALCOTT "Go now and do your Emperor proud! Do your country proud and do yourselves proud!"
    ALCOTT "¡Vayan ahora y hagan que su emperador se sienta orgulloso! Enorgulleced a vuestro país y a vosotros mismos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:459
translate es qst_Terminus_EnterPalace_bbe6fc24:

    # "And with that, Emperor Alcott descended from the podium, escorted back towards the fort from which he ruled and administered his government duties from."
    "Y con eso, el emperador Alcott descendió del podio, escoltado de vuelta hacia la fortaleza desde la que gobernaba y administraba sus deberes de gobierno."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:460
translate es qst_Terminus_EnterPalace_47d3e974:

    # "As he passed by me, he looked at me for a moment, with the coldest eyes I had ever seen, as though his gaze could cut through and freeze my very soul."
    "Cuando pasó a mi lado, me miró un momento con los ojos más fríos que jamás había visto, como si su mirada pudiera atravesar y congelar mi alma."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:465
translate es qst_Terminus_EnterPalace_a8edd937:

    # ADARA @ talk "He’s so scary..."
    ADARA @ talk "Da tanto miedo..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:466
translate es qst_Terminus_EnterPalace_afc8cc1f:

    # MC "Yeah..."
    MC "Sí..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:467
translate es qst_Terminus_EnterPalace_49080373:

    # MARKUS "He might be scary, but without him this city would have fallen long ago."
    MARKUS "Puede que dé miedo, pero sin él esta ciudad habría caído hace tiempo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:468
translate es qst_Terminus_EnterPalace_525dee60:

    # MARKUS "We need more leaders like him. Leaders who will do what has to be done."
    MARKUS "Necesitamos más líderes como él. Líderes que hagan lo que hay que hacer."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:469
translate es qst_Terminus_EnterPalace_6fa51ea6:

    # ADARA @ talk "Mmm, I’m not so sure... Not after deposing the King like that..."
    ADARA @ talk "Mmm, no estoy tan seguro... No después de deponer al rey así..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:470
translate es qst_Terminus_EnterPalace_db5a5efc:

    # MARKUS "Alcott led troops and repelled The Great Invasion from taking Novaras while the King continued to squander more troops lives pointlessly."
    MARKUS "Alcott dirigió las tropas y repelió a la gran invasión de tomar Novaras mientras el rey seguía derrochando vidas de más tropas inútilmente."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:471
translate es qst_Terminus_EnterPalace_ae457738:

    # MARKUS "If it wasn’t for him, this place would have fallen in 1152."
    MARKUS "Si no fuera por él, este lugar habría caído en 1152."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:472
translate es qst_Terminus_EnterPalace_48dd72c2:

    # ADARA @ talk "He also split the alliance in half with his little coup!"
    ADARA @ talk "¡También partió la alianza por la mitad con su pequeño golpe!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:473
translate es qst_Terminus_EnterPalace_39239c03:

    # MC "Urgh, do you two need to keep arguing politics?"
    MC "Urgh, ¿queréis dejar de discutir de política?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:474
translate es qst_Terminus_EnterPalace_fc35ca54:

    # ADARA @ angry "Hmph..."
    ADARA @ angry "Hmph..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:475
translate es qst_Terminus_EnterPalace_fc582d37:

    # MARKUS "Alright, let’s just drop it."
    MARKUS "Está bien, dejémoslo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:476
translate es qst_Terminus_EnterPalace_315cc143:

    # MARKUS "Anyway, come on, it’s time we finally got our results, [player_name!t]!"
    MARKUS "De todos modos, ¡vamos, ya es hora de que por fin obtengamos nuestros resultados, [player_name!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:477
translate es qst_Terminus_EnterPalace_8bbd0124:

    # MC "Ah, right."
    MC "Ah, cierto."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:478
translate es qst_Terminus_EnterPalace_6fd5686c:

    # ADARA @ talk "Goodluck, guys, I best get in my queue as well!"
    ADARA @ talk "Suerte, chicos, ¡mejor me pongo yo también a la cola!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:480
translate es qst_Terminus_EnterPalace_bf5aeb7d:

    # MC "Good luck, Adara!"
    MC "¡Buena suerte, Adara!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:482
translate es qst_Terminus_EnterPalace_8da82e65:

    # MARKUS "Same, good luck to you."
    MARKUS "Lo mismo digo, buena suerte."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:485
translate es qst_Terminus_EnterPalace_052cae9b:

    # "Each of us headed over to our respective queues, where hundreds of students would now wait for hours to receive the letter that would decide their life."
    "Cada uno de nosotros nos dirigimos a nuestras respectivas colas, donde cientos de estudiantes esperarían ahora durante horas para recibir la carta que decidiría su vida."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:486
translate es qst_Terminus_EnterPalace_488e3fc8:

    # "Sometimes, the wait would leave some to not find out until the early hours of the next morning..."
    "A veces, la espera dejaba a algunos sin enterarse hasta la madrugada del día siguiente..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:487
translate es qst_Terminus_EnterPalace_19e073a7:

    # "After five hours, I finally arrived at the stall."
    "Después de cinco horas, por fin llegué al puesto."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:489
translate es qst_Terminus_EnterPalace_e7442a13:

    # "Markus had already come and gone half an hour before, after he’d managed to slip into the queue slightly ahead of me."
    "Markus ya había entrado y salido media hora antes, después de haberse colado un poco antes que yo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:490
translate es qst_Terminus_EnterPalace_386634eb:

    # "He’d promised to meet me afterwards outside his home, then we’d head out to celebrate together."
    "Me había prometido reunirse conmigo después en la puerta de su casa y luego iríamos juntos a celebrarlo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:493
translate es qst_Terminus_EnterPalace_dedd2831:

    # "The woman looked up at me, smiling warmly."
    "La mujer me miró y me sonrió afectuosamente."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:488
translate es qst_Terminus_EnterPalace_3f349202:

    # WOMAN "Name?"
    WOMAN "¿Nombre?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:495
translate es qst_Terminus_EnterPalace_af2df090:

    # MC "[player_name!t]."
    MC "[player_name!t]."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:490
translate es qst_Terminus_EnterPalace_210a4852:

    # WOMAN "Class number?"
    WOMAN "¿Número de clase?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:498
translate es qst_Terminus_EnterPalace_a75d1844:

    # MC "4D."
    MC "4D."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:492
translate es qst_Terminus_EnterPalace_a088cd90:

    # WOMAN "Student number?"
    WOMAN "¿Número de estudiante?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:500
translate es qst_Terminus_EnterPalace_675612db:

    # MC "Three-Two-Six-Nine-One."
    MC "Tres-Dos-Seis-Nueve-Uno."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:501
translate es qst_Terminus_EnterPalace_757e00c2:

    # "The woman shuffled through the envelopes stamped down with the red wax seal of the Royal Court, and after finding mine, handed it over to me which I snatched greedily from her hands."
    "La mujer revolvió los sobres con el sello de lacre rojo de la Corte Real y, tras encontrar el mío, me lo entregó, que le arrebaté ávidamente de las manos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:495
translate es qst_Terminus_EnterPalace_70c7cba8:

    # WOMAN "Good luck!"
    WOMAN "¡Buena suerte!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:503
translate es qst_Terminus_EnterPalace_19f340fd:

    # MC "Thank you!"
    MC "¡Gracias!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:504
translate es qst_Terminus_EnterPalace_12fca38c:

    # "This is it! This is my destiny in my hands!"
    "¡Esto es! ¡Este es mi destino en mis manos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:505
translate es qst_Terminus_EnterPalace_403df7de:

    # "All these years of work are finally going to pay off!"
    "¡Todos estos años de trabajo por fin van a dar sus frutos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:506
translate es qst_Terminus_EnterPalace_40d11fb3:

    # "Feverishly, I ripped into the letter with sweaty hands, my heart beating frantically."
    "Febrilmente, desgarré la carta con las manos sudorosas, con el corazón latiéndome frenéticamente."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:519
translate es qst_Terminus_EnterPalace_85bbe6f7:

    # "I read that tiny bit of text a couple times over before it actually started to make sense..."
    "Leí ese trocito de texto un par de veces antes de que empezara a tener sentido..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:520
translate es qst_Terminus_EnterPalace_27570ac7:

    # MC "My... Training?"
    MC "Mi... ¿Entrenamiento?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:521
translate es qst_Terminus_EnterPalace_a20cefa7:

    # "..."
    "..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:522
translate es qst_Terminus_EnterPalace_5c3e3f1d:

    # MC "Capital... What?!"
    MC "Capital... ¡¿Qué?!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:523
translate es qst_Terminus_EnterPalace_1d5e8c4b:

    # MC "I... {i}I’m going to the Scouts?{/i}"
    MC "Yo... {i}¿Voy a los exploradores?{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:524
translate es qst_Terminus_EnterPalace_b8535060:

    # MC "... No... No! This is... This is wrong!"
    MC "... No... ¡No! Esto está... ¡Esto está mal!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:525
translate es qst_Terminus_EnterPalace_20b35e97:

    # MC "I can’t be in the Scouts! This is..."
    MC "¡No puedo estar en los exploradores! Esto es..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:527
translate es qst_Terminus_EnterPalace_b1631114:

    # "Looking up, I hurried back over the stall, frantically trying to speak to the lady but was immediately restrained by the guards."
    "Levanté la vista y me apresuré a volver al puesto, intentando frenéticamente hablar con la señora, pero los guardias me lo impidieron de inmediato."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:528
translate es qst_Terminus_EnterPalace_5f57996f:

    # "Other students berated me for cutting the line."
    "Otros estudiantes me recriminaron por cortar la fila."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:526
translate es qst_Terminus_EnterPalace_170b6a29:

    # WOMAN "Sir! Please wait in line for—"
    WOMAN "¡Señor! Por favor, espere en la cola para—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:530
translate es qst_Terminus_EnterPalace_5818611d:

    # MC "This! This has to be a mistake! I can’t be in the Scouts! I’m not—"
    MC "¡Esto! ¡Tiene que ser un error! ¡No puedo estar en los exploradores! Yo no soy—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:528
translate es qst_Terminus_EnterPalace_4f67789a:

    # WOMAN "If it’s got your name on the front and that’s what’s written, then I’m afraid you are, sir."
    WOMAN "Si tiene su nombre en la parte delantera y eso es lo que está escrito, entonces me temo que sí, señor."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:532
translate es qst_Terminus_EnterPalace_4475949c:

    # MC "But I... I—"
    MC "Pero yo... yo—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:530
translate es qst_Terminus_EnterPalace_95125b1b:

    # GUARD "Oi! Go on, son! Get out of here now!"
    GUARD "¡Oye! ¡Vamos, hijo! ¡Sal de aquí ahora mismo!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:535
translate es qst_Terminus_EnterPalace_25dc304d:

    # "The guard shoved me back sharply, making me stumble as I fell on my ass, tears springing behind my eyes as I muttered to myself."
    "El guardia me empujó bruscamente hacia atrás, haciéndome tropezar y caer de culo, con los ojos llenos de lágrimas mientras murmuraba para mis adentros."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:536
translate es qst_Terminus_EnterPalace_52378a4f:

    # MC "No... {i}No this can’t be!{/i}"
    MC "No... {i}¡No puede ser!{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:537
translate es qst_Terminus_EnterPalace_f20c8d0d:

    # MC "I can’t... {i}This...{/i}... This is a nightmare!"
    MC "No puedo... {i}Esto...{/i}...¡Esto es una pesadilla!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:538
translate es qst_Terminus_EnterPalace_fd8e9f7a:

    # MC "{i}It can’t be real!{/i}"
    MC "{i}¡No puede ser real!{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:545
translate es qst_Terminus_EnterPalace_903a92c1:

    # "Dazed, I walked the streets aimlessly for what seemed like an eternity, until I found myself in the housing district."
    "Aturdido, caminé por las calles sin rumbo fijo durante lo que me pareció una eternidad, hasta que me encontré en el distrito de viviendas."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:546
translate es qst_Terminus_EnterPalace_62f22980:

    # "I dragged myself over to Markus’ home, dejected, destroyed... {i}broken.{/i}"
    "Me arrastré hasta la casa de Markus, abatido, destruido... {i}roto.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:553
translate es qst_Terminus_EnterPalace_0c816036:

    # "I found him slouched against the wall by his front door, a solemn look on his face as he turned to me, still holding his own sheet in his hands."
    "Lo encontré recostado contra la pared junto a la puerta de su casa, con una expresión solemne en el rostro cuando se volvió hacia mí, sosteniendo aún el papel las manos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:554
translate es qst_Terminus_EnterPalace_25c532ca:

    # MARKUS "... I’ve been placed in the Scouts."
    MARKUS "...Me han colocado en los exploradores."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:555
translate es qst_Terminus_EnterPalace_d92e9348:

    # "He said with a lifeless look in his eyes, my eyes widened in shock."
    "Me lo dijo con una mirada sin vida, mis ojos se abrieron de golpe."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:556
translate es qst_Terminus_EnterPalace_dd0c95fc:

    # MC "... Y-You’re..."
    MC "...E-Eres..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:557
translate es qst_Terminus_EnterPalace_06928b06:

    # MARKUS "Yes."
    MARKUS "Sí."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:558
translate es qst_Terminus_EnterPalace_569f4dc6:

    # "I gulped hard, nodding."
    "Tragué saliva con fuerza, asintiendo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:559
translate es qst_Terminus_EnterPalace_55c52802:

    # MC "... {i}Me too.{/i}"
    MC "...{i}A mí también.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:560
translate es qst_Terminus_EnterPalace_e70ab855:

    # "Markus’ mouth hung open in shock, all our dreams and hopes... just like that, {i}gone.{/i}"
    "Markus se quedó boquiabierto, todos nuestros sueños y esperanzas se habían, {i}esfumado.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:561
translate es qst_Terminus_EnterPalace_01020745:

    # MARKUS "... No, you mean—"
    MARKUS "...No, quieres decir—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:562
translate es qst_Terminus_EnterPalace_605f37ff:

    # MC "... Heh... Well, looks like we’re still stuck together... Just..."
    MC "...Je... Bueno, parece que todavía estamos unidos... Solo..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:563
translate es qst_Terminus_EnterPalace_0f584615:

    # MC "Not in the way we hoped."
    MC "No como esperábamos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:564
translate es qst_Terminus_EnterPalace_66cfca50:

    # MARKUS "... Yeah..."
    MARKUS "...Sí..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:565
translate es qst_Terminus_EnterPalace_57bce272:

    # MARKUS "Instead of eating well and wooing court ladies together."
    MARKUS "En lugar de comer bien y cortejar a las damas de la corte juntos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:566
translate es qst_Terminus_EnterPalace_063f8be5:

    # MARKUS "{i}We’re gonna fucking die...{/i}"
    MARKUS "{i}Vamos a morir...{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:567
translate es qst_Terminus_EnterPalace_d58e0d46:

    # MC "We don’t know that! Come on, we’ll—"
    MC "¡No lo sabemos! Vamos.—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:569
translate es qst_Terminus_EnterPalace_026a4575:

    # MARKUS "Look, [player_name!t], you and I both know full well that the Scouts has the shortest life expectancy, short of just jumping off the fucking wall."
    MARKUS "Mira, [player_name!t], tú y yo sabemos muy bien que los exploradores tienen la esperanza de vida más corta, a falta de saltar de la puta pared."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:569
translate es qst_Terminus_EnterPalace_555ad1e1:

    # MARKUS "Frankly, I’m half tempted just to get a rope and save myself the agony of dying by {i}their{/i} hands."
    MARKUS "Francamente, estoy medio tentado de coger una cuerda y ahorrarme la agonía de morir en {i}sus{/i} manos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:570
translate es qst_Terminus_EnterPalace_1ebe35b7:

    # MC "Don’t joke about that!"
    MC "¡No bromees sobre eso!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:571
translate es qst_Terminus_EnterPalace_80e3fd99:

    # MARKUS "Why not? We’re fucked anyway."
    MARKUS "¿Por qué no? Estamos jodidos de todos modos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:572
translate es qst_Terminus_EnterPalace_ed1242e8:

    # MC "Well, you’ll definitely be fucked if you do that!"
    MC "¡Bueno, definitivamente estarás jodido si haces eso!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:573
translate es qst_Terminus_EnterPalace_e160c276:

    # MC "And you’ll be fucking me over! I need someone to have my back out {i}there!{/i}"
    MC "¡Y me estarás jodiendo! ¡Necesito a alguien que me cubra las espaldas {i}ahí fuera!{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:575
translate es qst_Terminus_EnterPalace_be4d18bb:

    # MARKUS "[player_name!t]..."
    MARKUS "[player_name!t]..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:575
translate es qst_Terminus_EnterPalace_f699c54d:

    # MC "Don’t give me that shit! We’ve stuck together since we were kids, we’re gonna stick together and get through this now! Understand?"
    MC "¡No me vengas con esa mierda! Hemos estado juntos desde que éramos niños, ¡vamos a estar juntos y superar esto ahora! ¿Entendido?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:576
translate es qst_Terminus_EnterPalace_d42ade9c:

    # "Markus sighed deeply, not really believing me but playing along anyway."
    "Markus suspiró profundamente, sin creerme realmente pero siguiéndome la corriente de todos modos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:577
translate es qst_Terminus_EnterPalace_571fda6d:

    # MARKUS "... Yeah... We’ll make it out."
    MARKUS "...Sí... Lo conseguiremos."

