    # ERIKA @ smile_talk "Enjoy yourselves."
    ERIKA @ smile_talk "Pasadlo bien."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:248
translate es qst_Terminus_KitchenEnterMorning_752c3f2b:

    # "Making her way towards the door, she smiled and waved us farewell."
    "En dirección a la puerta, sonríe y se despide de nosotros."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:249
translate es qst_Terminus_KitchenEnterMorning_8d770731:

    # ERIKA "Love to you both! I shall return soon!"
    ERIKA "¡Un abrazo a los dos! Volveré pronto."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:251
translate es qst_Terminus_KitchenEnterMorning_f74ba569:

    # MC "Bye, Erika."
    MC "Adiós, Erika."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:252
translate es qst_Terminus_KitchenEnterMorning_1ac578c6:

    # REGINA @ talk "Come back soon!"
    REGINA @ talk "¡Vuelve pronto!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:253
translate es qst_Terminus_KitchenEnterMorning_1f2326f6:

    # ERIKA "I’ll make sure to buy you a drink!"
    ERIKA "¡Me aseguraré de invitarte a una copa!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:254
translate es qst_Terminus_KitchenEnterMorning_96e3aaae:

    # "And with that, she closed the door behind her, vanishing from our lives once again."
    "Y con eso, cerró la puerta tras de sí, desapareciendo de nuestras vidas una vez más."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:256
translate es qst_Terminus_KitchenEnterMorning_b85ff9fb:

    # REGINA @ talk "... Right, you should probably get going as well, you don’t want to be late."
    REGINA @ talk "...Deberías irte también, no querrás llegar tarde."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:257
translate es qst_Terminus_KitchenEnterMorning_c63cccfb:

    # REGINA @ talk "Oh, and here by the way, I’ve got a special treat."
    REGINA @ talk "Ah, y por cierto, tengo un regalo especial."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:259
translate es qst_Terminus_KitchenEnterMorning_84c5d26e:

    # REGINA @ talk "Some grapes for you."
    REGINA @ talk "Unas uvas para ti."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:261
translate es qst_Terminus_KitchenEnterMorning_c75261f5:

    # MC "... Are these {i}fresh?{/i} How did you afford them?"
    MC "... ¿Son {i}frescas{/i}? ¿Cómo las compraste?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:262
translate es qst_Terminus_KitchenEnterMorning_60a64ecb:

    # REGINA @ lewd_talk "Oh, umm... I perhaps dipped into the savings a little for a special occasion such as this..."
    REGINA @ lewd_talk "Oh, umm... Tal vez saqué un poco de los ahorros para una ocasión especial como ésta..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:258
translate es qst_Terminus_KitchenEnterMorning_d7e14922:

    # MC "[regina_ref_cap!t]!"
    MC "¡[regina_ref_cap!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:264
translate es qst_Terminus_KitchenEnterMorning_9e610ce5:

    # REGINA @ talk "Oh hush! I did the same for Erika when it was her time."
    REGINA @ talk "¡Oh, silencio! Hice lo mismo con Erika cuando llegó su hora."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:265
translate es qst_Terminus_KitchenEnterMorning_02dde3ac:

    # MC "You shouldn’t have, it’s too expensive."
    MC "No deberías, es demasiado caro."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:266
translate es qst_Terminus_KitchenEnterMorning_4dc4a3ba:

    # REGINA @ talk "I won’t hear none of it! It’s your big day!"
    REGINA @ talk "¡No quiero oír nada de eso! ¡Es tu gran día!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:267
translate es qst_Terminus_KitchenEnterMorning_52311849:

    # REGINA @ talk "Now, go on, shoo!"
    REGINA @ talk "¡Ahora, vete, fuera!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:268
translate es qst_Terminus_KitchenEnterMorning_18639b33:

    # REGINA @ talk "And you and Markus be safe!"
    REGINA @ talk "¡Y tú y Markus estad a salvo!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:264
translate es qst_Terminus_KitchenEnterMorning_e465953b:

    # MC "Will do, [regina_ref!t]!"
    MC "¡Lo haré, [regina_ref!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:270
translate es qst_Terminus_KitchenEnterMorning_edc951fa:

    # MC "Be back soon!"
    MC "¡Vuelvo pronto!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:282
translate es qst_Terminus_EnterPalace_a6bdbc8f:

    # "There were not many occasions that our walled off capital was able to put aside the bloodshed and horrors of the outside. But every year {i}the Terminus ceremony{/i} was one that found its citizens energised enough to celebrate with real cheer."
    "No eran muchas las ocasiones en que nuestra capital amurallada era capaz de dejar a un lado el derramamiento de sangre y los horrores del exterior. Pero cada año, {i}la ceremonia Terminus{/i} animaba a los ciudadanos a celebrarla con alegría."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:283
translate es qst_Terminus_EnterPalace_47f5188c:

    # "Novaras did its best to welcome those who had completed their basic education course and were waiting to be assigned their jobs... {i} for life.{/i}"
    "Novaras hizo todo lo posible por acoger a quienes habían terminado su curso de educación básica y esperaban que se les asignara su puesto de trabajo... {i}para toda la vida.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:284
translate es qst_Terminus_EnterPalace_8277ff1c:

    # "Both me and Markus had worked tirelessly to push our performance up to the top of our class, often toiling away with studies deep into the night, trying to gain our position in the palace."
    "Markus y yo habíamos trabajado incansablemente para llegar a ser los mejores de la clase, a menudo estudiando hasta altas horas de la noche, tratando de ganar nuestra posición en el palacio."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:285
translate es qst_Terminus_EnterPalace_fd19327d:

    # "We often found ourselves fantasising in the early hours of the morning about how our lives would become a whirlwind of splendour far away from the hunger and drudgery of the {i}normal{/i} population."
    "A menudo fantaseábamos de madrugada sobre cómo nuestras vidas se convertirían en un torbellino de esplendor lejos del hambre y la monotonía de la población {i}normal{/i}."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:286
translate es qst_Terminus_EnterPalace_05d56647:

    # "A favourite topic of ours was, of course, the court ladies we would try to woo, successfully charming our way into their beds each night."
    "Uno de nuestros temas favoritos eran, por supuesto, las damas de la corte a las que intentábamos cortejar, consiguiendo colarnos en sus camas cada noche."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:287
translate es qst_Terminus_EnterPalace_31c7bda4:

    # "And the food, OH THE FOOD! We could eat for days till our bellies were fat! No more scrapping over what we’d managed to cobble together. We would eat until our bellies were ready to burst! We often pondered on what it must feel like to be that wealthy."
    "Y la comida, ¡LA COMIDA! Podríamos comer durante días hasta engordar. Se acabarían las peleas por lo que habíamos conseguido reunir. Comeríamos hasta reventar. A menudo nos preguntábamos qué se sentiría siendo tan ricos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:288
translate es qst_Terminus_EnterPalace_14f1250e:

    # "Ah... But first we had to reach our Terminus. As I made my way to the ceremony being held at the entrance to the palace, many people greeted me happily along the way."
    "Ah... Pero primero teníamos que llegar a nuestra Terminus. Mientras me dirigía a la ceremonia que se celebraba en la entrada del palacio, muchas personas me saludaban alegremente por el camino."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:289
translate es qst_Terminus_EnterPalace_88534ba0:

    # "Patting me on the back with many ‘Good luck lads!’ and other courteous expressions of well-wishing for me, I basked in admiration, anxious..."
    "Me daban palmaditas en la espalda, me decían ‘¡buena suerte, chicos!’ y otras expresiones corteses de buenos deseos para mí..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:290
translate es qst_Terminus_EnterPalace_2d015ebf:

    # "When I finally made it to the ceremony itself, hundreds of other students like me gathered around and chattered away, their excitement electric."
    "Cuando por fin llegué a la ceremonia, cientos de estudiantes como yo se reunieron alrededor y charlaban con entusiasmo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:291
translate es qst_Terminus_EnterPalace_68c978d5:

    # "Thousands of commoners gathered to watch the affair from the sides with exuberant smiles on their faces. Confetti was gleefully thrown into the air as we all watched the podium, waiting for the speeches to begin before we’d formally be given our life duties."
    "Miles de plebeyos se reunieron para contemplar el acontecimiento desde los laterales con exuberantes sonrisas en sus rostros. Se lanzaba confeti alegremente al aire mientras todos observábamos el podio, esperando a que comenzaran los discursos antes de que se nos asignaran formalmente nuestros deberes vitales."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:297
translate es qst_Terminus_EnterPalace_2098ea1a:

    # MARKUS "There you are!"
    MARKUS "¡Ahí estás!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:298
translate es qst_Terminus_EnterPalace_3c4cc504:

    # MC smile "Markus!"
    MC smile "¡Markus!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:301
translate es qst_Terminus_EnterPalace_93aee4f6:

    # "Markus hurried over towards me, his voice palpable with excitement."
    "Markus se dirigió a toda prisa hacia mí, con voz emocionada."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:302
translate es qst_Terminus_EnterPalace_3b27e832:

    # MARKUS "I figured you were still passed out after all the drinking last night!"
    MARKUS "¡Pensé que aún estabas desmayado después de todo lo que bebiste anoche!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:303
translate es qst_Terminus_EnterPalace_3fedadc7:

    # MC "Nah, not me! Already looking forward to tonight!"
    MC "¡No, yo no! ¡Ya estoy deseando que llegue esta noche!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:304
translate es qst_Terminus_EnterPalace_c0bb39a1:

    # MARKUS "That’s what we like to hear!"
    MARKUS "¡Eso es lo que nos gusta oír!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:305
translate es qst_Terminus_EnterPalace_6e9b7663:

    # MC "I looked around to see where the rest of our class were, trying to pick out the individual faces of the crowd."
    MC "Miré a mi alrededor para ver dónde estaba el resto de nuestra clase, tratando de distinguir los rostros individuales de la multitud."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:306
translate es qst_Terminus_EnterPalace_8af6c041:

    # MC "Did your brother make it?"
    MC "¿Lo consiguió tu hermano?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:307
translate es qst_Terminus_EnterPalace_8651af28:

    # MARKUS "Hm? Oh no, Skallion’s busy down the mines today."
    MARKUS "¿Hm? Oh no, Skallion está ocupado en las minas hoy."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:308
translate es qst_Terminus_EnterPalace_eb8b09a6:

    # MC "He couldn’t get the day off, not even for this?"
    MC "¿No podía tomarse el día libre, ni siquiera para esto?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:309
translate es qst_Terminus_EnterPalace_7c15d6ed:

    # MARKUS "No, unfortunately Demorai attacks have driven up the demand for ore trade, he couldn’t refuse the gold."
    MARKUS "No, desgraciadamente los ataques de emorai han hecho subir la demanda de comercio de mineral, no podía rechazar el oro."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:310
translate es qst_Terminus_EnterPalace_c6423a4b:

    # MC @ sad "Hmm... Still a shame..."
    MC @ sad "Hmm... Sigue siendo una pena..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:311
translate es qst_Terminus_EnterPalace_eb52465c:

    # MARKUS "Ha! Don’t worry too much, he’s promised us both a barrel of ale to celebrate once he gets back!"
    MARKUS "¡Ja! ¡No te preocupes demasiado, nos ha prometido a los dos un barril de cerveza para celebrarlo cuando vuelva!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:312
translate es qst_Terminus_EnterPalace_3d75881d:

    # MC "No way! Almost glad he’s not here now!"
    MC "¡No puede ser! ¡Casi me alegro de que no esté aquí ahora!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:313
translate es qst_Terminus_EnterPalace_fe4f417e:

    # MARKUS "Uh-huh! Think of the girls we can entice over with that!"
    MARKUS "¡Ajá! ¡Piensa en las chicas que podemos atraer con eso!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:314
translate es qst_Terminus_EnterPalace_97891779:

    # MC "Heh, especially once we have our fancy palace uniforms! We’ll be rolling in—"
    MC "Heh, sobre todo cuando tengamos nuestros elegantes uniformes de palacio. Estaremos rodando en—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:315
translate es qst_Terminus_EnterPalace_73863d95:

    # "Suddenly, a cute high-pitched voice called out from between the chattering waves of happy crowd. A hand waved desperately, trying to grab my attention."
    "De repente, una voz aguda y bonita gritó entre las olas parlanchinas de la multitud feliz. Una mano se agitó desesperadamente, tratando de captar mi atención."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:309
translate es qst_Terminus_EnterPalace_79b53c3f:

    # ADARA talk "[player_name!t]! [player_name!t]!"
    ADARA talk "¡[player_name!t]! ¡[player_name!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:318
translate es qst_Terminus_EnterPalace_26ce5014:

    # MARKUS "Oooh! Your future wife is here!"
    MARKUS "¡Oooh! ¡Tu futura esposa está aquí!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:320
translate es qst_Terminus_EnterPalace_6928aee0:

    # MC smile "At least I won’t be dying alone like you!"
    MC smile "¡Al menos no moriré solo como tú!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:321
translate es qst_Terminus_EnterPalace_8aac5536:

    # MARKUS "Alright heartthrob, she’s been chasing you down since she first laid eyes on you!"
    MARKUS "¡Muy bien, rompecorazones, te ha estado persiguiendo desde que te vio por primera vez!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:322
translate es qst_Terminus_EnterPalace_d205f56c:

    # "I rolled my eyes at Markus’ comment as he chuckled to himself, but he was right, Adara would do anything in her power to spend time with me in and out of class."
    "Puse los ojos en blanco ante el comentario de Markus mientras él se reía para sí, pero tenía razón, Adara haría cualquier cosa por pasar tiempo conmigo dentro y fuera de clase."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:323
translate es qst_Terminus_EnterPalace_109c5624:

    # "Not that I didn’t like her, she was very cute... {i}but{/i} our studies took up so much time that socialising was a difficult thing to do, and near enough impossible if you aimed as high as me and Markus."
    "No es que no me gustara, era muy mona... {i}pero{/i} nuestros estudios nos ocupaban tanto tiempo que socializar era algo difícil de hacer, y casi imposible si apuntabas tan alto como Markus y yo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:324
translate es qst_Terminus_EnterPalace_34dee6d3:

    # "Adara finally managed to break through the throngs of people to reach us."
    "Adara consiguió por fin abrirse paso entre la multitud para llegar hasta nosotros."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:325
translate es qst_Terminus_EnterPalace_8c7b8a5b:

    # ADARA @ talk "{i}*Huff*{/i} Hey, both!"
    ADARA @ talk "{i}*Uff*{/i} ¡Hey, los dos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:326
translate es qst_Terminus_EnterPalace_57f95235:

    # MARKUS "Did you {i}run{/i} all the way here?"
    MARKUS "¿Has venido {i}corriendo{/i} hasta aquí?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:327
translate es qst_Terminus_EnterPalace_5fa584c7:

    # ADARA @ talk "Huh?! Uh... N-No..."
    ADARA @ talk "¡¿Eh?! Uh... N-no..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:328
translate es qst_Terminus_EnterPalace_20cb3f80:

    # MC smile "You overslept again, didn’t you?"
    MC smile "Te quedaste dormida otra vez, ¿no?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:329
translate es qst_Terminus_EnterPalace_eb3843b8:

    # "Adara became flustered as I caught onto her, but I knew her like the back of my hand."
    "Adara se puso nerviosa cuando la descubrí, pero yo la conocía como la palma de mi mano."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:330
translate es qst_Terminus_EnterPalace_52f870a7:

    # ADARA @ angry "N-No!"
    ADARA @ angry "¡N-no!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:331
translate es qst_Terminus_EnterPalace_de32d813:

    # "Markus and I shared a glance and chuckled."
    "Markus y yo compartimos una mirada y nos reímos entre dientes."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:332
translate es qst_Terminus_EnterPalace_decd3ea5:

    # ADARA @ talk "H-Hey! I DID NOT oversleep, guys!"
    ADARA @ talk "¡E-ey! ¡NO ME quedé dormida, chicos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:325
translate es qst_Terminus_EnterPalace_fb7301a1:

    # MARKUS "Long night dreaming about [player_name!t] was it? ... But I think I see Des over there, I’ll leave you two love birds alone for a bit!"
    MARKUS "Una larga noche soñando con [player_name!t] ¿no? ... Pero creo que veo a Des por allí, ¡os dejaré solos a los dos tortolitos un rato!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:334
translate es qst_Terminus_EnterPalace_a0712279:

    # MC "We aren’t—"
    MC "No estamos—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:336
translate es qst_Terminus_EnterPalace_b3b10d33:

    # ADARA @ shock "W-What?! We are so not—"
    ADARA @ shock "¡¿Q-qué?! No somos—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:337
translate es qst_Terminus_EnterPalace_73abf0ec:

    # MARKUS "Yeah, yeah!"
    MARKUS "¡Sí, sí!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:339
translate es qst_Terminus_EnterPalace_55c6dd2b:

    # "Markus left, fighting his way through the crowds as he called out to some classmates."
    "Markus se marchó abriéndose paso entre la multitud mientras llamaba a algunos compañeros."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:341
translate es qst_Terminus_EnterPalace_799ba0b6:

    # ADARA @ talk "He’s so infuriating when he talks about us like that!"
    ADARA @ talk "¡Es tan exasperante cuando habla así de nosotros!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:342
translate es qst_Terminus_EnterPalace_bcfa5447:

    # ADARA @ talk "... Right?"
    ADARA @ talk "...¿Verdad?"

