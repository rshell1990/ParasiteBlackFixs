# game/data/world_quests/main/Prologue/TheTerminus/scr_2_ReturnHomeAndArriveToFort.rpy:80
translate es qst_Terminus_ArriveToFort_2014ba67:

    # "Fort Sebastian was an old but well-maintained fort towering over Novaras Army District."
    "El Fuerte Sebastian era una fortaleza antigua pero bien mantenida que se alzaba sobre el distrito militar de Novaras."

# game/data/world_quests/main/Prologue/TheTerminus/scr_2_ReturnHomeAndArriveToFort.rpy:81
translate es qst_Terminus_ArriveToFort_17460293:

