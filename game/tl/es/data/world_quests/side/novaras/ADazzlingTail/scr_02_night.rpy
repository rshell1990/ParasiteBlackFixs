

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:5
translate es qst_ADazzlingTail_02_night_fda2704b:

    # "Wandering into the smithy, I heard a weird noise from upstairs."
    "Entrando en la herrería, oí un ruido extraño en el piso de arriba."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:6
translate es qst_ADazzlingTail_02_night_0210cb79:

    # MC "Huh? Sounds like..."
    MC "¿Eh? Suena como..."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:7
translate es qst_ADazzlingTail_02_night_b672b64d:

    # "Hypnotized by moans barely heard, I felt I {i}have{/i} to check it out."
    "Hipnotizado por gemidos que apenas se oían, sentí que {i}tenía{/i} que comprobarlo."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:8
translate es qst_ADazzlingTail_02_night_2d979d88:

    # "Only as I quietly climbed the stairs did I realise the sound is coming from Arlena's room..."
    "Solo cuando subí las escaleras en silencio me di cuenta de que el sonido venía de la habitación de Arlena..."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:14
translate es qst_ADazzlingTail_02_night_69abf82d:

    # "As I gently pushed the door, I found myself standing in front of Arlena, inspecting her naked body in the mirror, a shiny toy wedged into her ass."
    "Mientras empujaba suavemente la puerta, me encontré de pie frente a Arlena, inspeccionando su cuerpo desnudo en el espejo, con un juguete brillante encajado en el culo."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:15
translate es qst_ADazzlingTail_02_night_b8ddaa33:

    # "She seemed to be lost in pleasure, letting out deep, heavy moans."
    "Parecía perdida en el placer, soltando gemidos profundos y pesados"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:16
translate es qst_ADazzlingTail_02_night_4edea73f:

    # "Taking a moment to let the scene in, I bit my lip."
    "Me mordí el labio y me tomé un momento para asimilar la escena."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:17
translate es qst_ADazzlingTail_02_night_89a18b2c:

    # "It seemed as if it just produced a sound of a thousand hammers hitting an anvil!"
    "¡Parecía como si acabara de producir el sonido de mil martillos golpeando un yunque!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:18
translate es qst_ADazzlingTail_02_night_80f81e96:

    # "...For right the next moment Arlena was {b}glaring at me.{/b}"
    "...porque justo al momento siguiente Arlena {b}me estaba mirando.{/b}"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:19
translate es qst_ADazzlingTail_02_night_c7ef84a2:

    # "Her cheeks red with either arousal or anger."
    "Sus mejillas enrojecidas por la excitación o la ira."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:27
translate es qst_ADazzlingTail_02_night_eee7b839:

    # ARLENA @ angry "PERVERT!!!"
    ARLENA @ angry "¡¡¡PERVERTIDO!!!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:29
translate es qst_ADazzlingTail_02_night_31ca3adc:

    # ARLENA @ angry "Haven’t you heard of knocking first?"
    ARLENA @ angry "¿No has oído hablar de llamar primero a la puerta?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:30
translate es qst_ADazzlingTail_02_night_008a1273:

    # MC @ talk "I just heard a suspicious noise! The door to the smithy was open! I-I didn’t think!"
    MC @ talk "¡Acabo de oír un ruido sospechoso! ¡La puerta de la herrería estaba abierta! ¡N-no pensé!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:32
translate es qst_ADazzlingTail_02_night_074f38cc:

    # "Arlena folded her arms across her chest and pouted as she stared at the floor, furious."
    "Arlena cruzó los brazos sobre el pecho y puso morritos mientras miraba al suelo, furiosa."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:33
translate es qst_ADazzlingTail_02_night_c6bd8a87:

    # MC @ talk "... Were you trying them out for—"
    MC @ talk "... ¿Los estabas probando para—?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:34
translate es qst_ADazzlingTail_02_night_0db533a3:

    # ARLENA "I wanted to see if they looked good enough obviously, idiot!"
    ARLENA "Quería ver si se veían lo suficientemente bien obviamente, ¡idiota!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:35
translate es qst_ADazzlingTail_02_night_9d774f89:

    # MC @ talk "Right, right... Of course."
    MC @ talk "Claro, claro... Por supuesto."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:36
translate es qst_ADazzlingTail_02_night_3fbe8a9c:

    # ARLENA "... W-Well?"
    ARLENA "... ¿E-entonces?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:37
translate es qst_ADazzlingTail_02_night_6b29b915:

    # MC @ talk "... Well, what?"
    MC @ talk "... ¿Entonces, qué?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:38
translate es qst_ADazzlingTail_02_night_dbc10847:

    # ARLENA "Well, how did it look, idiot?"
    ARLENA "Entonces, ¿cómo se veía, idiota?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:39
translate es qst_ADazzlingTail_02_night_a2ef6158:

    # MC @ talk "OH!"
    MC @ talk "¡OH!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:40
translate es qst_ADazzlingTail_02_night_b72d78e7:

    # MC @ talk "It looked..."
    MC @ talk "Se veía..."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:43
translate es qst_ADazzlingTail_02_night_785107e8:

    # ARLENA "U-Uhh..."
    ARLENA "U-Uhh..."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:44
translate es qst_ADazzlingTail_02_night_c7601cba:

    # "Arlena seemed to contemplate the idea for a moment before shaking it off."
    "Arlena pareció contemplar la idea por un momento antes de rechazarla."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:45
translate es qst_ADazzlingTail_02_night_afb5619c:

    # ARLENA "In your dreams!"
    ARLENA "¡En tus sueños!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:47
translate es qst_ADazzlingTail_02_night_3e671db7:

    # ARLENA "Well... that’s good..."
    ARLENA "Bueno... eso está bien..."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:48
translate es qst_ADazzlingTail_02_night_1b5f35b1:

    # ARLENA "Glad you enjoyed the view, pervert!"
    ARLENA "¡Me alegra que disfrutaras de la vista, pervertido!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:50
translate es qst_ADazzlingTail_02_night_a44207c9:

    # "Arlena thought about the idea for moment, saying nothing as her cheeks turned a soft shade of pink."
    "Arlena se lo pensó un momento, sin decir nada, mientras sus mejillas adquirían un suave tono rosado."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:52
translate es qst_ADazzlingTail_02_night_37355111:

    # "Dropping the quilt down, she turned around to give me a full view as she shyly looked over her shoulder to gauge my reaction."
    "Dejó caer el edredón y se dio la vuelta para ofrecerme una vista completa mientras miraba tímidamente por encima del hombro para ver mi reacción."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:53
translate es qst_ADazzlingTail_02_night_3fbe8a9c_1:

    # ARLENA "... W-Well?"
    ARLENA "... ¿E-Entonces?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:54
translate es qst_ADazzlingTail_02_night_96c3da59:

    # ARLENA "What do you think? Does it look good?"
    ARLENA "¿Qué te parece? ¿Se ve bien?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:56
translate es qst_ADazzlingTail_02_night_61562a8f:

    # "As I stared at her magnificent behind, utterly entranced, Arlena didn’t wait for my answer before she covered herself once again with the blanket."
    "Mientras contemplaba su magnífico trasero, completamente embelesado, Arlena no esperó mi respuesta antes de cubrirse de nuevo con la manta."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:57
translate es qst_ADazzlingTail_02_night_9f929f49:

    # ARLENA "I’ll take that as a yes."
    ARLENA "Lo tomaré como un sí."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:60
translate es qst_ADazzlingTail_02_night_3fd773ff:

    # MC @ talk "What do you need from me now?"
    MC @ talk "¿Qué necesitas de mí ahora?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:61
translate es qst_ADazzlingTail_02_night_4919dd19:

    # ARLENA "Nothing, I’ll be dropping the stuff over to the Pleasure District later."
    ARLENA "Nada, dejaré las cosas en el distrito del placer más tarde."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_02_night.rpy:62
translate es qst_ADazzlingTail_02_night_5d937386:

    # ARLENA "Come back in a day and I’ll give you your cut."
    ARLENA "Vuelve en un día y te daré tu parte."
