

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:9
translate es qst_ADazzlingTail_03_30920a42:

    # ARLENA "There you are!"
    ARLENA "¡Aquí estás!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:10
translate es qst_ADazzlingTail_03_f8ff9d9d:

    # ARLENA "Come here!"
    ARLENA "¡Ven aquí!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:13
translate es qst_ADazzlingTail_03_e881419e:

    # "Leaping onto me, Arlena suddenly planted a kiss of jubilation onto my lips."
    "Saltando sobre mí, Arlena me plantó de repente un beso de júbilo en los labios."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:14
translate es qst_ADazzlingTail_03_65d07a1c:

    # MC @ talk "Whoa! What was that for?"
    MC @ talk "¡Vaya! ¿Qué fue eso?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:17
translate es qst_ADazzlingTail_03_e5e9a2d6:

    # ARLENA "We’re going to be {b}rich!{/b}"
    ARLENA "¡Vamos a ser {b}ricos!{/b}"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:18
translate es qst_ADazzlingTail_03_0df97ea7:

    # MC @ talk "So, I take it that they went down well?"
    MC @ talk "Entonces, ¿supongo que les ha gustado?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:19
translate es qst_ADazzlingTail_03_432a88b0:

    # ARLENA "So much better than expected! They’ve already placed an order for more of them!"
    ARLENA "¡Mucho mejor de lo esperado! ¡Ya han hecho un pedido para conseguir más!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:20
translate es qst_ADazzlingTail_03_5b247ea3:

    # MC @ talk "Really?"
    MC @ talk "¿De verdad?"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:21
translate es qst_ADazzlingTail_03_9accae4c:

    # ARLENA "Oh yes, here’s your cut by the way."
    ARLENA "Ah sí, por cierto, aquí está tu parte."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:23
translate es qst_ADazzlingTail_03_94728388:

    # MC @ talk "Hey, that’s quite a heavy bag of gold!"
    MC @ talk "¡Eh, es una bolsa de oro bastante pesada!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:24
translate es qst_ADazzlingTail_03_5acb07da:

    # ARLENA "Told ya!"
    ARLENA "¡Te lo dije!"

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:25
translate es qst_ADazzlingTail_03_3b1d5b73:

    # ARLENA "When you’re free, bring me as many gems as you can so I can make some more..."
    ARLENA "Cuando estés libre, tráeme todas las gemas que puedas para que pueda hacer más..."

# game/data/world_quests/side/novaras/ADazzlingTail/scr_03.rpy:26
translate es qst_ADazzlingTail_03_ec2355a8:

    # MC @ talk "I'll be right happy to!"
    MC @ talk "¡Estaré encantado de hacerlo!"
