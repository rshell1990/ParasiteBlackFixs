

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:3
translate es jurgen_1_tavern_assassinate_0a23a6bb:

    # MC @ talk "Not here, there's too many people."
    MC @ talk "Aquí no, hay demasiada gente."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:4
translate es jurgen_1_tavern_assassinate_13652144:

    # MC @ talk "We need to talk somewhere private."
    MC @ talk "Tenemos que hablar en un lugar privado."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:5
translate es jurgen_1_tavern_assassinate_31a3f7a9:

    # "Jurgen seemed suspicious, he waved over two of his friends."
    "Jurgen parecía desconfiado, saludó a dos de sus amigos."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:5
translate es jurgen_1_tavern_assassinate_49e09581:

    # JURGEN "You lads stay back but come with me."
    JURGEN "Vosotros quedaos atrás, pero venid conmigo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:6
translate es jurgen_1_tavern_assassinate_d986e350:

    # JURGEN "This one here says he might have something to help us."
    JURGEN "Este de aquí dice que podría tener algo para ayudarnos."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:8
translate es jurgen_1_tavern_assassinate_6ea473f3:

    # MC "(Shit... Not what I was hoping for.)"
    MC "(Mierda... No es lo que esperaba)."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:8
translate es jurgen_1_tavern_assassinate_c43e8623:

    # JURGEN "Well? Where shall we speak?"
    JURGEN "¿Y bien? ¿Dónde hablaremos?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:10
translate es jurgen_1_tavern_assassinate_993a335f:

    # MC "This way..."
    MC "Por aquí..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:13
translate es jurgen_1_tavern_assassinate_297d5bdc:

    # "I lead Jurgen down into one of the quiet back Alleyways, the two guards kept enough of a distance not to listen in but follow us."
    "Llevé a Jurgen a uno de los tranquilos callejones traseros, los dos guardias se mantuvieron a suficiente distancia para no escuchar, pero nos siguieron."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:22
translate es jurgen_1_tavern_assassinate_366bbcf6:

    # JURGEN "Now, what have you got for me?"
    JURGEN "¿Qué tienes para mí?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:25
translate es jurgen_1_tavern_assassinate_a5d72335:

    # JURGEN "I should have known!"
    JURGEN "¡Debería haberlo sabido!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:26
translate es jurgen_1_tavern_assassinate_d747a650:

    # JURGEN "Men! To arms!"
    JURGEN "¡Hombres! ¡A las armas!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:36
translate es jurgen_1_tavern_assassinate_9d8dcd90:

    # "After slaying Jurgen and his men, I fled into the many back alleys, doing my best to not be seen."
    "Tras matar a Jurgen y a sus hombres, huí por los callejones, haciendo todo lo posible para que no me vieran."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:37
translate es jurgen_1_tavern_assassinate_6a2f278a:

    # "My heart raced at what had just happened, no doubt about it... {i}I was a murderer.{/i}"
    "Mi corazón se aceleró ante lo que acababa de suceder, sin duda... {i}Yo era un asesino.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:38
translate es jurgen_1_tavern_assassinate_d47a78c3:

    # "But still I told myself I did what needed to be done, or at least, {i}that's what I kept telling myself anyway.{/i}"
    "Pero aún así me dije a mí mismo que había hecho lo que había que hacer, o al menos, {i}eso es lo que me decía a mí mismo.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:47
translate es jurgen_1_tavern_assassinate_c4efc9e9:

    # "From out the shadows, the Vulshan came, blades drawn."
    "De entre las sombras, aparecieron los Vulshan, con las espadas desenvainadas."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:44
translate es jurgen_1_tavern_assassinate_33b8f300:

    # JURGEN "W-What is-"
    JURGEN "¿Q-qué es-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:50
translate es jurgen_1_tavern_assassinate_85a1d0e0:

    # "The guards behind Jurgen fell, their throats slit by the Vulshan assassins."
    "Los guardias detrás de Jurgen cayeron, degollados por los asesinos Vulshan."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:51
translate es jurgen_1_tavern_assassinate_e40632bd:

    # "A second later, Jurgen himself joined his entourage on the rocky alley floor."
    "Un segundo después, el propio Jurgen se unió a su séquito en el rocoso suelo del callejón."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:52
translate es jurgen_1_tavern_assassinate_872de970:

    # "Blood poured from beneath his armour plates as he struggled to breathe."
    "La sangre manaba de debajo de las placas de su armadura mientras luchaba por respirar."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:49
translate es jurgen_1_tavern_assassinate_6475c2fc:

    # JURGEN "Who- Argh..."
    JURGEN "¿Quién- Argh..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:54
translate es jurgen_1_tavern_assassinate_f0d9ee59:

    # "A final, gargled choking gasp escaped his lips before he finally fell silent."
    "Un último jadeo ahogado escapó de sus labios antes de que finalmente se callara."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:56
translate es jurgen_1_tavern_assassinate_b141a920:

    # VULSHAN @ talk "Leave now... We will take care of the rest."
    VULSHAN @ talk "Vete... Nosotros nos encargaremos del resto."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:63
translate es jurgen_1_tavern_assassinate_95ce5fb4:

    # "I nodded, taking off into the shadows once again, the dark deed done."
    "Asentí, adentrándome de nuevo en las sombras, con la oscura labor cumplida."

