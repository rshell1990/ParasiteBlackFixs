

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:8
translate es jurgen_0_tavern_c4ac02dd:

    # UNKNOWN "Hm? What do you want?"
    UNKNOWN "¿Qué? ¿Qué es lo que quieres?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:11
translate es jurgen_0_tavern_3e2e5224:

    # MC @ talk "You wouldn't happen to know a guard by the name of Jurgen, would you?"
    MC @ talk "Por casualidad no conocerás a un guardia llamado Jurgen, ¿verdad?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:12
translate es jurgen_0_tavern_e861c212:

    # JURGEN "You're speaking to him, now what do you want?"
    JURGEN "Estás hablando con él, ¿ahora qué quieres?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:15
translate es jurgen_0_tavern_4f4483bd:

    # JURGEN "Quit wasting my time!"
    JURGEN "¡Deja de hacerme perder el tiempo!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:19
translate es jurgen_0_tavern_06b0cd39:

    # MC "(Okay, that's our mark.)"
    MC "(Vale, esa es nuestra señal)."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:22
translate es jurgen_0_tavern_11eac3fe:

    # JURGEN "I'm sure they would."
    JURGEN "Estoy seguro de que sí."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:23
translate es jurgen_0_tavern_655866dd:

    # JURGEN "So, are you the lap dog they've sent then?"
    JURGEN "Entonces, ¿eres el perro faldero que han enviado?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:26
translate es jurgen_0_tavern_ff6effaf:

    # MC @ talk "What will it take to get you to back off?"
    MC @ talk "¿Qué hace falta para que te eches atrás?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:25
translate es jurgen_0_tavern_d9ae11fe:

    # JURGEN "Nothing."
    JURGEN "Nada."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:28
translate es jurgen_0_tavern_5b247ea3:

    # MC @ talk "Really?"
    MC @ talk "¿De verdad?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:27
translate es jurgen_0_tavern_9a1bc016:

    # JURGEN "If the Merchants wish to come clean, they may do so at their leisure for a less harsh sentence when the time comes."
    JURGEN "Si los comerciantes desean confesar, pueden hacerlo a su antojo para recibir una sentencia menos dura cuando llegue el momento."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:28
translate es jurgen_0_tavern_196e233b:

    # JURGEN "But {i}I know{/i} that the Merchant's guild no doubt has tied itself to the Black Market, however much they deny it."
    JURGEN "Pero {i}sé{/i} que el gremio de mercaderes sin duda se ha vinculado al mercado negro, por mucho que lo nieguen."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:29
translate es jurgen_0_tavern_4787ce7c:

    # JURGEN "And nothing you offer me is going to be worth the promotion when I'm done."
    JURGEN "Y nada de lo que me ofrezcas valdrá la promoción cuando acabe."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:32
translate es jurgen_0_tavern_07ea95c8:

    # MC @ talk "It's far more likely you'll be killed than rewarded."
    MC @ talk "Es mucho más probable que te maten a que te recompensen."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:31
translate es jurgen_0_tavern_d3b7bce7:

    # JURGEN "Ha! You think you can fool me?"
    JURGEN "¡Ja! ¿Crees que puedes engañarme?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:34
translate es jurgen_0_tavern_a1de09c2:

    # MC @ talk "Do you really think anyone is going to thank you for causing them a bureaucratic nightmare?"
    MC @ talk "¿De verdad crees que alguien te va a dar las gracias por causarle una pesadilla burocrática?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:35
translate es jurgen_0_tavern_8f90f6f9:

    # MC @ talk "You're a single guard crossing some powerful people on both sides... All you're going to do is get yourself cared."
    MC @ talk "Eres un simple guardia que se cruza con gente poderosa de ambos lados... Todo lo que vas a hacer es que se ocupen de ti."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:34
translate es jurgen_0_tavern_c189d170:

    # JURGEN "C-Cease your lies!"
    JURGEN "¡B-basta de mentiras!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:35
translate es jurgen_0_tavern_5c2dd762:

    # JURGEN "Now leave me be at once before I have you arrested for attempting to bribe an officer!"
    JURGEN "¡Déjame en paz antes de que te arreste por intentar sobornar a un oficial!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:38
translate es jurgen_0_tavern_5f21cd05:

    # MC "(This is fruitless... I will need to find a different solution.)"
    MC "(Esto es infructuoso... Tendré que encontrar otra solución)."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:39
translate es jurgen_0_tavern_e25f9129:

    # MC "(Perhaps I could slip something into his drink?)"
    MC "(¿Quizás podría echarle algo en la bebida?)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:44
translate es jurgen_0_tavern_revisit_ebdf3e15:

    # JURGEN "What do you want?"
    JURGEN "¿Qué es lo que quieres?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:52
translate es jurgen_0_tavern_revisit_8ac30186:

    # "Jurgen chuckled and turned away, as if he saw Alcott stand in my place, naked."
    "Jurgen soltó una risita y se dio la vuelta, como si viera a Alcott en mi lugar, desnudo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:53
translate es jurgen_0_tavern_revisit_f5e18757:

    # MC @ talk "(Yeah, this clearly doesn't work.)"
    MC @ talk "(Sí, esto claramente no funciona)."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:54
translate es jurgen_0_tavern_revisit_6e3668f3:

    # JURGEN "What is this about?"
    JURGEN "¿De qué se trata?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:58
translate es jurgen_0_tavern_revisit_b228b028:

    # JURGEN "Show me."
    JURGEN "Muéstrame."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:70
translate es jurgen_0_tavern_revisit_c1cad31b:

    # MC "(Okay, let's do this...)"
    MC "(Bien, hagamos esto...)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:70
translate es jurgen_0_tavern_revisit_4b8b9504:

    # JURGEN "Yeah you better!"
    JURGEN "¡Sí, más te vale!"

translate es strings:

    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:15
    old "Never mind... I have to go."
    new "No importa... Tengo que irme."

    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:15
    old "The Merchants would like you to stop harrassing them."
    new "A los comerciantes les gustaría que dejaras de acosarlos."

    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:49
    old "{image=[ICON.SWORDS]} The merchants wish to meet with you Jurgen, they have an offer."
    new "{image=[ICON.SWORDS]} Los comerciantes desean reunirse contigo Jurgen, tienen una oferta."

    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:49
    old "{image=[ICON.SWORDS]} I hear you are the man going against the guild... I may have information that could help you."
    new "{image=[ICON.SWORDS]} He oído que eres el hombre que va contra el gremio... Puede que tenga información que pueda ayudarte."

    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:49
    old "{i}*Distract him and slip poison into his drink*{/i}"
    new "{i}*Distraerlo y poner veneno en su bebida.*{/i}"

    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:49
    old "Never mind... I'm just enjoying my ale here."
    new "No importa... Solo estoy disfrutando de mi cerveza aquí."
