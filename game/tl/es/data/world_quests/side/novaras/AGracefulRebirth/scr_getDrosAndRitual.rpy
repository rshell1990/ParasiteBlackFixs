    # MC @ talk "So, what will you do?"
    MC @ talk "Entonces, ¿qué vas a hacer?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:151
translate es dros_4_getDros_2a4df126:

    # DROS @ smile "It's simple, {i}I'm going to pay for the room myself.{/i}"
    DROS @ smile "Es simple, {i}voy a pagar la habitación yo misma.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:152
translate es dros_4_getDros_8d5d3adc:

    # MC @ talk "Will that not be costly?"
    MC @ talk "¿No será eso costoso?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:153
translate es dros_4_getDros_9ae59753:

    # DROS @ smile "I can afford it... Being a tailor does have its perks."
    DROS @ smile "Me lo puedo permitir... Ser sastre tiene sus ventajas."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:148
translate es dros_4_getDros_788db69a:

    # DROS @ lewd "Besides, {i}I cannot wait to see you there, [dros_player_ref!t].{/i}"
    DROS @ lewd "Además, {i}no puedo esperar a verte allí, [dros_player_ref!t].{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:155
translate es dros_4_getDros_1baa56b0:

    # MC @ smile "I will see you there then, Draya."
    MC @ smile "Te veré allí entonces, Draya."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:156
translate es dros_4_getDros_5bc8ea6d:

    # "Draya smiled once again as she leaned forward to kiss me on the cheek before hurrying off."
    "Draya volvió a sonreír mientras se inclinaba hacia delante para besarme en la mejilla antes de marcharse a toda prisa."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:158
translate es dros_4_getDros_d346d243:

    # "All of that usual anger seemed to have washed away."
    "Toda la ira habitual parecía haberse desvanecido."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:160
translate es dros_4_getDros_9f25939c:

    # MC "(Something tells me I'm in for a good time the next time I see them.)"
    MC "(Algo me dice que voy a pasar un buen rato la próxima vez que la vea)."

