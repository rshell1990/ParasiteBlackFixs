    # DROS @ shock "A-Already?"
    DROS @ shock "¿Y-Ya?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:5
translate es dros_4_getDros_b46ef0f5:

    # DROS @ talk "Very well, lead the way."
    DROS @ talk "Muy bien, adelante."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:14
translate es dros_4_getDros_a45925f9:

    # DIVINE "Ah, Dros... You've arrived."
    DIVINE "Ah, Dros... Has llegado."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:17
translate es dros_4_getDros_e9db4a2e:

    # DROS @ smile "It is good to see you, Sister Divine."
    DROS @ smile "Me alegro de verte, hermana Divine."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:18
translate es dros_4_getDros_8d01fe15:

    # DIVINE @ angry "Given the trouble you've caused us in the past, I normally could not say the same..."
    DIVINE @ angry "Dado los problemas que nos has causado en el pasado, normalmente no podría decir lo mismo..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:17
translate es dros_4_getDros_0f98b4f3:

    # DIVINE "But I suppose these are special circumstances."
    DIVINE "Pero supongo que son circunstancias especiales."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:20
translate es dros_4_getDros_33d35a12:

    # DROS @ sad "A-Ah... My behaviour has perhaps not always been the best, I admit, b-but-"
    DROS @ sad "A-Ah ... Mi comportamiento tal vez no siempre ha sido el mejor, lo admito, p-pero-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:19
translate es dros_4_getDros_38babc78:

    # DIVINE "Come, Dros, I have prepared the ritual."
    DIVINE "Vamos, Dros, he preparado el ritual."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:22
translate es dros_4_getDros_251fb961:

    # DROS @ sad "Will... Will it hurt?"
    DROS @ sad "¿Me...? ¿Me dolerá?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:21
translate es dros_4_getDros_5e8d612e:

    # DIVINE "...Hopefully not, Dros."
    DIVINE "...Esperemos que no, Dros."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:22
translate es dros_4_getDros_e213b104:

    # DIVINE "Are you truly sure you wish to-"
    DIVINE "¿Estás realmente seguro de que quieres-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:25
translate es dros_4_getDros_70e62fbb:

    # DROS @ talk "Yes... I'm sure."
    DROS @ talk "Sí... Estoy seguro."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:24
translate es dros_4_getDros_62e755a5:

    # DIVINE "Very well, follow me then."
    DIVINE "Muy bien, sígueme entonces."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:27
translate es dros_4_getDros_11db2ad8:

    # "As Dros and Sister Divine headed down one of the Hallways, Sister Divine stopped me."
    "Mientras Dros y la hermana Divine se dirigían a uno de los pasillos, la hermana Divine me detuvo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:26
translate es dros_4_getDros_22b78691:

    # DIVINE "I'm afraid this is as far as you go."
    DIVINE "Me temo que hasta aquí has llegado."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:27
translate es dros_4_getDros_6a7a9ddd:

    # DIVINE "There are certain rules and traditions us Mages must follow."
    DIVINE "Hay ciertas reglas y tradiciones que las magas debemos seguir."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:28
translate es dros_4_getDros_1d3ecee1:

    # DIVINE "You need to wait here."
    DIVINE "Tienes que esperar aquí."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:29
translate es dros_4_getDros_0f5e1ab6:

    # DIVINE "We will return when ready."
    DIVINE "Volveremos cuando hayamos terminado."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:32
translate es dros_4_getDros_85fc1f08:

    # MC @ talk "Very well."
    MC @ talk "Muy bien."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:33
translate es dros_4_getDros_1f14740f:

    # "Dros sheepishly glanced over his shoulder and looked at me as Sister Divine led him on."
    "Dros miró tímidamente por encima de su hombro y me miró mientras la hermana Divine lo guiaba."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:34
translate es dros_4_getDros_52993c9d:

    # "After turning a corner, the two of them were finally out of sight, and I was left completely alone to ponder my thoughts."
    "Tras girar una esquina, los dos se perdieron de vista y me quedé completamente solo para meditar sobre mis pensamientos."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:36
translate es dros_4_getDros_eb2e433a:

    # MC "(Hm, I hope this was the right decision.)"
    MC "(Hm, espero que haya sido la decisión correcta)."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:38
translate es dros_4_getDros_7812e635:

    # "It felt like I was waiting for hours, when I heard the sudden strange sounds and bright lights flash from around the corner Dros and Sister Divine headed down."
    "Me pareció que llevaba horas esperando, cuando de repente oí unos sonidos extraños y unas luces brillantes que provenían de la esquina por la que bajaban Dros y la hermana Divine."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:40
translate es dros_4_getDros_e9cbe315:

    # "With my hand at my blade, I took a few steps forward, when suddenly, Sister Divine emerged once again, smiling triumphantly."
    "Con la mano en mi espada, di unos pasos hacia delante, cuando de repente, la hermana Divine surgió de nuevo, sonriendo triunfante."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:43
translate es dros_4_getDros_f06c2614:

    # DIVINE "It pleases me to say, it was a success."
    DIVINE "Me complace decir que fue un éxito."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:47
translate es dros_4_getDros_19b296f9:

    # MC @ talk "Where is Dros?"
    MC @ talk "¿Dónde está Dros?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:45
translate es dros_4_getDros_846690e3:

    # DIVINE "Dros is gone..."
    DIVINE "Dros se ha ido..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:46
translate es dros_4_getDros_43179f5d:

    # DIVINE "Draya! Come here!"
    DIVINE "¡Draya! ¡Ven aquí!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:54
translate es dros_4_getDros_924ba1fb:

    # "From around the corner, the beautiful elven girl shyly approached."
    "Desde la esquina, la bella elfa se acercó tímidamente."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:58
translate es dros_4_getDros_c325415b:

    # "For a moment, I did not recognize him, from the softening of the face to the widening of the hips, he looked so different than before."
    "Por un momento, no le reconocí, desde el suavizado de la cara hasta el ensanchamiento de las caderas, tenía un aspecto tan diferente al de antes."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:59
translate es dros_4_getDros_5a77c6d2:

    # "As he spoke, the voice was a higher pitch, and unmistakenly feminine."
    "Al hablar, la voz era más aguda e inconfundiblemente femenina."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:60
translate es dros_4_getDros_fdb5396b:

    # DROS @ talk "H-Hello."
    DROS @ talk "H-Hola."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:61
translate es dros_4_getDros_3d7deb1d:

    # MC @ talk "Dros? Is that really-"
    MC @ talk "¿Dros? ¿Realmente eres-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:62
translate es dros_4_getDros_e9f0f02d:

    # DROS @ smile "{i}*Cough*{/i} I prefer to go by Draya now."
    DROS @ smile "{i}*Toser*{/i} Ahora prefiero que me llamen Draya.."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:63
translate es dros_4_getDros_df31ef06:

    # MC @ talk "Oh... I see."
    MC @ talk "Oh... Ya veo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:62
translate es dros_4_getDros_3e63ffe0:

    # DIVINE "My work here is done."
    DIVINE "Mi trabajo aquí ha terminado."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:65
translate es dros_4_getDros_4a3811a7:

    # MC @ talk "What do I owe you for your services, Sister?"
    MC @ talk "¿Cuánto te debo por tus servicios, hermana?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:64
translate es dros_4_getDros_61070ae7:

    # DIVINE "Nothing."
    DIVINE "Nada."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:65
translate es dros_4_getDros_662a3f30:

    # DIVINE "This spell was... enlightening."
    DIVINE "Este hechizo fue... iluminador."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:66
translate es dros_4_getDros_2034d8f3:

    # DIVINE "Consider it a gift."
    DIVINE "Considéralo un regalo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:69
translate es dros_4_getDros_cf18f36a:

    # MC @ talk "Thank you."
    MC @ talk "Gracias."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:68
translate es dros_4_getDros_796540ce:

    # DIVINE "You're most welcome... Now, if you don't mind."
    DIVINE "De nada... Ahora, si no te importa."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:69
translate es dros_4_getDros_f475c049:

    # DIVINE "I have other business to attend."
    DIVINE "Tengo otros asuntos que atender."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:72
translate es dros_4_getDros_638c51ac:

    # MC @ talk "Of course."
    MC @ talk "Por supuesto."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:74
translate es dros_4_getDros_0ea1a5c9:

    # "Sister Divine led us outside, and an ecstatic Draya leapt into my arms to hug me before I pulled her off."
    "La hermana Divine nos acompañó al exterior, y una extasiada Draya saltó a mis brazos para abrazarme antes de que la apartara de mí."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:83
translate es dros_4_getDros_1da34f0d:

    # DROS @ smile "I... I can't believe it."
    DROS @ smile "No... No puedo creerlo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:84
translate es dros_4_getDros_9866b910:

    # DROS @ smile "After all this time, I'm-"
    DROS @ smile "Después de todo este tiempo, soy-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:85
translate es dros_4_getDros_bf8269dc:

    # DROS @ smile "I feel so alive!"
    DROS @ smile "¡Me siento tan viva!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:86
translate es dros_4_getDros_985848dc:

    # MC @ talk "I am glad to help you, {i}Draya.{/i}"
    MC @ talk "Me alegra ayudarte, {i}Draya.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:88
translate es dros_4_getDros_c222fa2d:

    # DROS @ talk "And don't think I forgot what we mentioned."
    DROS @ talk "Y no creas que he olvidado lo que hemos mencionado."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:89
translate es dros_4_getDros_d9034de3:

    # DROS @ smile "I'll give you a permanent fifteen percent discount on my store from now on."
    DROS @ smile "Te haré un descuento permanente del quince por ciento en mi tienda a partir de ahora."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:96
translate es dros_4_getDros_87568343:

    # DROS @ talk "{i}*Cough*{/i} I see you still drive a hard bargain... Very well, twenty percent."
    DROS @ talk "{i}*Toser*{/i} Veo que sigues regateando duro... Muy bien, veinte por ciento."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:101
translate es dros_4_getDros_660a0896:

    # "Draya began to blush."
    "Draya empezó a sonrojarse."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:105
translate es dros_4_getDros_c92f763d:

    # DROS @ lewd "There um, is {i}one{/i} more thing I wanted to talk with you about."
    DROS @ lewd "Um, hay {i}una{/i} cosa más de la que quería hablar contigo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:106
translate es dros_4_getDros_e46ff672:

    # MC @ talk "Oh?"
    MC @ talk "¿Oh?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:107
translate es dros_4_getDros_fe2fa700:

    # DROS @ lewd "I suppose I should just come out and say it, shouldn't I?"
    DROS @ lewd "Supongo que debería decirlo sin rodeos, ¿no?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:108
translate es dros_4_getDros_2994bbc9:

    # DROS @ lewd "You're... {i}Very attractive.{/i}"
    DROS @ lewd "Eres... {i}muy atractivo.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:109
translate es dros_4_getDros_11b3ff7b:

    # "The comment was a surprising one, if they had given any hints prior to this, they certainly went over my head."
    "El comentario fue sorprendente, si había dado alguna pista antes de esto, desde luego se me pasó por alto."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:110
translate es dros_4_getDros_027e0d9e:

    # DROS @ smile "I mean, you've done so much for me."
    DROS @ smile "Quiero decir, has hecho tanto por mí."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:111
translate es dros_4_getDros_89e312b0:

    # DROS @ smile "And now I look like this, I finally feel I have the confidence to ask these things."
    DROS @ smile "Y ahora que me veo así, por fin siento que tengo la confianza para preguntar estas cosas."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:112
translate es dros_4_getDros_06fcfb5f:

    # MC @ talk "Draya, I..."
    MC @ talk "Draya, yo..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:113
translate es dros_4_getDros_b5f20c3b:

    # DROS @ shock "D-Don't feel you have to say yes!"
    DROS @ shock "¡N-No sientas que tienes que decir que sí!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:114
translate es dros_4_getDros_0fff7896:

    # DROS @ sad "I mean, I would understand if not... Just..."
    DROS @ sad "Quiero decir, lo entendería si no... solo..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:115
translate es dros_4_getDros_9897dbce:

    # "Draya smiled shyly."
    "Draya sonrió tímidamente."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:116
translate es dros_4_getDros_2eef98ba:

    # DROS @ talk "Well?"
    DROS @ talk "¿Y bien?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:124
translate es dros_4_getDros_c0933bab:

    # "Despite her claims I did not have to say yes, my answer clearly left her a little deflated."
    "A pesar de sus afirmaciones de que no tenía por qué decir que sí, mi respuesta la dejó claramente un poco desinflada."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:125
translate es dros_4_getDros_f09331be:

    # DROS @ sad "I... I see."
    DROS @ sad "Ya... Ya veo."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:126
translate es dros_4_getDros_23ad4bbb:

    # DROS @ sad "Well, thank for being honest at least."
    DROS @ sad "Bueno, gracias por ser sincero al menos."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:127
translate es dros_4_getDros_ccac0064:

    # DROS @ talk "It's no matter though! I shall see you around, {i}friend.{/i}"
    DROS @ talk "¡Pero no importa! Nos vemos, {i}amigo.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:128
translate es dros_4_getDros_a330cb86:

    # "With that, Draya headed off, presumably back to their Tailor shop."
    "Con eso, Draya se marchó, presumiblemente de vuelta a su sastrería."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:133
translate es dros_4_getDros_b23df8f0:

    # DROS @ shock "You... You do?"
    DROS @ shock "Tú... ¿En serio?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:134
translate es dros_4_getDros_5dca7b91:

    # DROS @ lewd "I... Well, that's good!"
    DROS @ lewd "Yo... ¡Bueno, eso es bueno!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:135
translate es dros_4_getDros_88578b00:

    # "Draya seemed to ponder the thought before giggling."
    "Draya pareció reflexionar antes de soltar una risita."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:136
translate es dros_4_getDros_9465b4d8:

    # DROS @ lewd "So, what are we?"
    DROS @ lewd "Entonces, ¿qué somos?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:137
translate es dros_4_getDros_0ca03866:

    # DROS @ lewd "I'm sorry, I'm still getting used to all this."
    DROS @ lewd "Lo siento, todavía me estoy acostumbrando a todo esto."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:132
translate es dros_4_getDros_93c8966a:

    # DROS @ lewd "What should I call you, [player_name!t]?"
    DROS @ lewd "¿Cómo debería llamarte, [player_name!t]?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:137
translate es dros_4_getDros_03d15310:

    # DROS @ smile "[dros_player_ref!t]? Well... If that's what you wish."
    DROS @ smile "¿[dros_player_ref!t]? Bueno... Si eso es lo que deseas."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:144
translate es dros_4_getDros_038709e6:

    # DROS @ talk "I have to speak to the Madam and change some details about my arrangement with her."
    DROS @ talk "Tengo que hablar con la Madam y cambiar algunos detalles sobre mi acuerdo con ella."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:145
translate es dros_4_getDros_03ea6e8e:

    # MC @ surprised "You still intend to work at the Brothel?"
    MC @ surprised "¿Todavía piensas trabajar en el burdel?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:146
translate es dros_4_getDros_c1d7def0:

    # DROS @ smile "No, not at all."
    DROS @ smile "No, para nada."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:147
translate es dros_4_getDros_00278a48:

    # DROS @ lewd "But we will need a safer place than my shop for more... {i}intimate{/i} moments."
    DROS @ lewd "Pero necesitaremos un lugar más seguro que mi tienda para... momentos {i}íntimos{/i}."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:148
translate es dros_4_getDros_7ed39a12:

    # DROS @ angry "Having you come and go from the shop too much may draw some unwanted attention... Even with me like this."
    DROS @ angry "Tenerte yendo y viniendo de la tienda demasiado puede atraer alguna atención no deseada... Incluso conmigo así."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:149
translate es dros_4_getDros_be78d9d6:

    # DROS @ angry "Last thing I need is inquisitors or someone poking into my business."
    DROS @ angry "Lo último que necesito son inquisidores o alguien metiéndose en mis asuntos."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:150
