    # REGINA @ talk "...Well, you best be heading home dear."
    REGINA @ talk "...Bueno, será mejor que te vayas a casa, cariño."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:276
translate es ev_AdaraDream_0375f240:

    # REGINA @ talk "I’ll handle things from here."
    REGINA @ talk "Yo me encargaré a partir de aquí."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:277
translate es ev_AdaraDream_6160a550:

    # "Adara turned to me and smiled politely."
    "Adara se volvió hacia mí y me sonrió amablemente."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:263
