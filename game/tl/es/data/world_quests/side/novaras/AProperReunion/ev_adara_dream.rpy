# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:52
translate es ev_AdaraDream_ca085f71:

    # "...Laid before me, a great sea of darkness and splendour."
    "...Tendido ante mí, un gran mar de oscuridad y esplendor."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:53
translate es ev_AdaraDream_e19d263a:

    # "A thousand or so stars seemed pin-pricked from the blanket of darkness, and some strange hypnotic swirling mass laid out in the distance, so far away, and yet, it all yet felt so close, as though it was all around me."
    "Un millar de estrellas parecían clavadas con alfileres en el manto de oscuridad, y una extraña e hipnótica masa arremolinada se extendía en la distancia, tan lejos y, sin embargo, todo me parecía tan cercano, como si estuviera a mi alrededor."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:54
translate es ev_AdaraDream_c76f59fa:

    # "I felt calmness wash over me, serene calmness. "
    "Sentí que me invadía la calma, una calma serena."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:55
translate es ev_AdaraDream_32310a79:

    # "I couldn’t feel my feet touch the ground as I floated adrift in this sea of lights and blackness, reaching out towards those beautiful lights, almost as if I tried hard enough, I might just be able to reach one."
    "No podía sentir que mis pies tocaran el suelo mientras flotaba a la deriva en este mar de luces y oscuridad, extendiendo la mano hacia esas hermosas luces, casi como si me esforzara lo suficiente, podría ser capaz de alcanzar una."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:56
translate es ev_AdaraDream_72fb50a0:

    # MC @ talk "What is this place?"
    MC @ talk "¿Qué es este lugar?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:59
translate es ev_AdaraDream_a6413649:

    # BLACK "Memories..."
    BLACK "Recuerdos..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:60
translate es ev_AdaraDream_7e869c4b:

    # MC @ talk "Memories?"
    MC @ talk "¿Recuerdos?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:61
translate es ev_AdaraDream_a5eb4489:

    # BLACK "As our minds have melded, you now have access to my memories and dreams."
    BLACK "Como nuestras mentes se han fusionado, ahora tienes acceso a mis recuerdos y sueños."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:63
translate es ev_AdaraDream_dd705834:

    # MC @ talk "I thought you couldn’t remember much about the time before?"
    MC @ talk "Creía que no recordabas mucho de la época anterior."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:64
translate es ev_AdaraDream_25f93f64:

    # BLACK "Like glass shattered... My memories are fractured but still there."
    BLACK "Como cristales rotos... Mis recuerdos están fracturados pero siguen ahí."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:65
translate es ev_AdaraDream_9383871b:

    # BLACK "Buried deep."
    BLACK "Enterrados profundamente."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:66
translate es ev_AdaraDream_ae9783af:

    # MC @ talk "...What is this place? Why do you remember this?"
    MC @ talk "...¿Qué es este lugar? ¿Por qué lo recuerdas?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:67
translate es ev_AdaraDream_9a134f9f:

    # BLACK "Across the stars we came..."
    BLACK "Cruzamos las estrellas..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:68
translate es ev_AdaraDream_9c89dcd3:

    # BLACK "Crashing down on worlds like some terrible wave."
    BLACK "Aplastando mundos como una terrible ola."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:69
translate es ev_AdaraDream_25ca0bc0:

    # MC @ talk "...Are these memories? {i}Or dreams?{/i}"
    MC @ talk "...¿Son recuerdos? {i}¿O sueños?{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:70
translate es ev_AdaraDream_c92e89b3:

    # BLACK "I do not know anymore..."
    BLACK "Ya no lo sé..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:72
translate es ev_AdaraDream_f54ced0b:

    # BLACK "But I dream of fire."
    BLACK "Pero sueño con fuego."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:73
translate es ev_AdaraDream_8f88444a:

    # BLACK "Fire scorching world to world as we move through the darkness of the cosmos."
    BLACK "Fuego que abrasa mundo a mundo mientras avanzamos por la oscuridad del cosmos."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:74
translate es ev_AdaraDream_582666ea:

    # BLACK "With only one message prevailing... Chasing us as we move."
    BLACK "Con un solo mensaje prevaleciendo... Persiguiéndonos mientras nos movemos."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:75
translate es ev_AdaraDream_f3ab4321:

    # BLACK "{i}The hive must grow... The Hive must survive.{/i}"
    BLACK "{i}La colmena debe crecer... La colmena debe sobrevivir.{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:76
translate es ev_AdaraDream_0a4d1ac6:

    # MC @ talk "What? "
    MC @ talk "¿Qué?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:77
translate es ev_AdaraDream_b44b37fc:

    # BLACK "With every blink, I see a world, a lifetime, memories of wars and strange things."
    BLACK "Con cada parpadeo, veo un mundo, toda una vida, recuerdos de guerras y cosas extrañas."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:78
translate es ev_AdaraDream_472feaec:

    # MC @ talk "Your people... There was a war?"
    MC @ talk "Tu gente... ¿Hubo una guerra?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:79
translate es ev_AdaraDream_e58b1434:

    # MC @ talk "You’re not making any sense! "
    MC @ talk "¡No tiene ningún sentido!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:80
translate es ev_AdaraDream_2b9d1912:

    # BLACK "I cannot remember..."
    BLACK "No puedo recordar..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:82
translate es ev_AdaraDream_2137d59c:

    # BLACK "These memories are hazy, like trying to see clear through a storm."
    BLACK "Estos recuerdos son nebulosos, como intentar ver claro a través de una tormenta."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:83
translate es ev_AdaraDream_92e6a230:

    # BLACK "...But there’s a girl... A girl deep behind that storm."
    BLACK "...Pero hay una chica... Una chica en lo profundo detrás de esa tormenta."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:84
translate es ev_AdaraDream_20553359:

    # BLACK "I can’t remember her face, or her name..."
    BLACK "No puedo recordar su cara, ni su nombre..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:85
translate es ev_AdaraDream_bcd2de67:

    # BLACK "But she’s there..."
    BLACK "Pero ella está ahí..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:86
translate es ev_AdaraDream_3a4c335f:

    # MC @ talk "Who? What are you talking about?"
    MC @ talk "¿A quién? ¿De qué estás hablando?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:87
translate es ev_AdaraDream_743d9c9e:

    # BLACK "{i}Sleep...{/i} "
    BLACK "{i}Dormir...{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:88
translate es ev_AdaraDream_08fc79b0:

    # BLACK "{i}Rest...{/i}"
    BLACK "{i}Descansar...{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:89
translate es ev_AdaraDream_08f62a8d:

    # MC @ talk "Wait! No! Don’t go!"
    MC @ talk "¡Espera! ¡No! ¡No te vayas!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:100
translate es ev_AdaraDream_eecf2163:

    # "Springing up from my bed, sweat dripping off from me with wide eyed panic, I startled poor Adara who stumbled and nearly fell backwards from my abruptness. "
    "Me levanté de la cama de un salto, con los ojos muy abiertos y el sudor goteando, y asusté a la pobre Adara, que tropezó y casi se cae de espaldas por mi brusquedad."
 
# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:103
translate es ev_AdaraDream_df72778a:

    # MC @ talk "...!"
    MC @ talk "¡...!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:103
translate es ev_AdaraDream_658d94b2:

    # ADARA @ shock "[player_name!t]! Calm yourself! "
    ADARA @ shock "¡[player_name!t]!¡Cálmate!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:106
translate es ev_AdaraDream_52d96bc9:

    # MC @ talk "Where am I? "
    MC @ talk "¿Dónde estoy?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:107
translate es ev_AdaraDream_5b30c851:

    # ADARA @ shock "In your room!"
    ADARA @ shock "¡En tu habitación!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:108
translate es ev_AdaraDream_bcf69661:

    # MC @ talk "I... I am?"
    MC @ talk "Yo... ¿Yo lo estoy?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:110
translate es ev_AdaraDream_3185e4bb:

    # ADARA @ talk "You’ve been running a fever."
    ADARA @ talk "Has tenido fiebre."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:111
translate es ev_AdaraDream_e92f63c5:

    # ADARA @ talk "Neither I nor Regina have been able to wake you."
    ADARA @ talk "Ni yo ni Regina hemos podido despertarte."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:111
translate es ev_AdaraDream_40cfc1d6:

    # MC "[regina_ref_cap!t]... Where is she?"
    MC "[regina_ref_cap!t]... ¿Dónde está?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:114
translate es ev_AdaraDream_8befebf9:

    # ADARA @ talk "Gone to fetch some herbs to help ease the fever."
    ADARA @ talk "Fue a buscar algunas hierbas para ayudar a aliviar la fiebre."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:115
translate es ev_AdaraDream_01e74d2b:

    # "With a heavy sigh, I pressed my hands into my face."
    "Con un fuerte suspiro, me llevé las manos a la cara."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:116
translate es ev_AdaraDream_33d80bfe:

    # "That was unlike any dream... {i}Memory...{/i} Whatever it was."
    "Eso no se parecía a ningún sueño... {i}Recuerdo...{/i} Fuera lo que fuera."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:120
translate es ev_AdaraDream_58e2f1c1:

    # "Gently, I felt Adara’s hand rest onto me."
    "Suavemente, sentí que la mano de Adara se posaba sobre mí."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:121
translate es ev_AdaraDream_7121cd5d:

    # ADARA @ talk "You had me really worried there."
    ADARA @ talk "Me tenías realmente preocupada."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:122
translate es ev_AdaraDream_4ba51f06:

    # MC @ talk "What are you doing here anyway?"
    MC @ talk "¿Qué estás haciendo aquí?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:123
translate es ev_AdaraDream_ae1c0dd5:

    # ADARA @ talk "I came here to see how you are."
    ADARA @ talk "He venido a verte cómo estás."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:124
translate es ev_AdaraDream_80ce1635:

    # ADARA @ talk "Regina said you've been like this for a while..."
    ADARA @ talk "Regina dijo que has estado así por un tiempo..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:125
translate es ev_AdaraDream_25e7de18:

    # ADARA @ talk "Thrashing around unconscious, muttering something about 'stars' and 'fire' or something."
    ADARA @ talk "Dando vueltas inconsciente, murmurando algo sobre 'estrellas' y 'fuego' o algo así."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:126
translate es ev_AdaraDream_8418a966:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:127
translate es ev_AdaraDream_af8dd5b3:

    # ADARA @ talk "...Must have been one strange dream."
    ADARA @ talk "...Debe haber sido un sueño extraño."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:128
translate es ev_AdaraDream_4468e2c9:

    # MC @ talk "That’s one way to describe it..."
    MC @ talk "Es una forma de describirlo..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:129
translate es ev_AdaraDream_84914f07:

    # "Anxiously, Adara sat beside me."
    "Ansiosa, Adara se sentó a mi lado."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:130
translate es ev_AdaraDream_5153ad0c:

    # ADARA @ talk "Is it... Is it because of what happened?"
    ADARA @ talk "Es... ¿Es por lo que pasó?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:131
translate es ev_AdaraDream_8418a966_1:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:132
translate es ev_AdaraDream_a1526b94:

    # ADARA @ talk "All that fighting... Seeing your friends get hurt?"
    ADARA @ talk "Toda esa lucha... ¿Ver a tus amigos heridos?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:133
translate es ev_AdaraDream_0885a2df:

    # MC @ talk "...Yeah, it’s because of that."
    MC @ talk "...Sí, es por eso."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:134
translate es ev_AdaraDream_05d8f51d:

    # "Adara reached around to hug me, she smelt good, and that familiar hazelnut scent was... {i}arousing.{/i}"
    "Adara se acercó para abrazarme, olía bien, y ese familiar aroma a avellana era... {i}excitante.{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:135
translate es ev_AdaraDream_703439d0:

    # ADARA @ talk "If there’s anything I can do to help."
    ADARA @ talk "Si hay algo que pueda hacer para ayudar."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:136
translate es ev_AdaraDream_19158805:

    # ADARA @ talk "J-Just ask..."
    ADARA @ talk "Solo pregunta..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:137
translate es ev_AdaraDream_8d070248:

    # "Adara flushed red, and from where her hands clasped together they pushed out her large breasts which my eyes were naturally drawn to."
    "Adara enrojeció, y desde donde sus manos se entrelazaban asomaron sus grandes pechos a los que mis ojos se sintieron naturalmente atraídos."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:140
translate es ev_AdaraDream_b4cc0d7f:

    # ADARA @ talk "...I should go."
    ADARA @ talk "...debería irme."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:141
translate es ev_AdaraDream_58e9d019:

    # ADARA @ talk "I will speak to you again soon."
    ADARA @ talk "Volveremos a hablar pronto."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:142
translate es ev_AdaraDream_0567e3e9:

    # MC @ talk "I’ll walk you to the door."
    MC @ talk "Te acompañaré a la puerta."

