    ADARA @ talk "..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:300
translate es ev_AdaraDream_811faca9:

    # MC @ talk "You need to leave."
    MC @ talk "Tienes que irte."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:301
translate es ev_AdaraDream_ccab532a:

