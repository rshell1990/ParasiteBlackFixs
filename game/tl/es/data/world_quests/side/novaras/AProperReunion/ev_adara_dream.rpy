translate es ev_AdaraDream_7d7bf93d:

    # MC @ talk "See you soon, Adara..."
    MC @ talk "Hasta pronto, Adara..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:268
translate es ev_AdaraDream_67fd570b:

    # "With that, Adara left, and [regina_ref!t] looked at me with a curious raised eyebrow and smirk."
    "Adara se marchó y [regina_ref!t] me miró con curiosidad y una sonrisa burlona."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:285
translate es ev_AdaraDream_1d49621e:

    # MC @ talk "...What?"
    MC @ talk "...¿Qué?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:286
translate es ev_AdaraDream_087796b4:

    # REGINA @ smile_talk "I didn’t say anything."
    REGINA @ smile_talk "No dije nada."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:287
translate es ev_AdaraDream_1d068ba3:

    # MC @ talk "You didn’t have to."
    MC @ talk "No tenías que hacerlo."

