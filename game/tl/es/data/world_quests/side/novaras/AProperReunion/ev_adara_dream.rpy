# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:302
translate es ev_AdaraDream_6b3174e9:

    # "I watched as Adara nervously re-dressed herself, her face a mixture of frustration and confusion."
    "Observé cómo Adara se volvía a vestir nerviosa, con un rostro mezcla de frustración y confusión."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:304
translate es ev_AdaraDream_323fb724:

    # ADARA @ talk "Then... I shall leave you to it."
    ADARA @ talk "Entonces... Te dejaré con ello."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:305
translate es ev_AdaraDream_22224a5d:

    # "As Adara made her way to the door, she stopped, turning to look back at me irritably."
    "Cuando Adara se dirigía a la puerta, se detuvo y me miró irritada."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:306
