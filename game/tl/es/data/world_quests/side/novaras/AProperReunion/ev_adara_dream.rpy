    MC @ talk "Conozco esa mirada."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:289
translate es ev_AdaraDream_d0ef4f79:

    # REGINA @ smile_talk "No comment."
    REGINA @ smile_talk "Sin comentarios."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:290
translate es ev_AdaraDream_ef15c9ea:

    # "Regina smiled, throwing down some fresh clothes for me as she turned to close the door behind her again."
    "Regina sonrió, tirándome algo de ropa limpia mientras se giraba para volver a cerrar la puerta tras de sí."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:291
translate es ev_AdaraDream_ce4c7003:

    # REGINA @ smile_talk "Don’t stay in bed all day..."
    REGINA @ smile_talk "No te quedes en la cama todo el día..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:294
translate es ev_AdaraDream_48fab41a:

    # MC "{i}*Sigh...*{/i}"
    MC "{i}*Suspiro...*{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:296
translate es ev_AdaraDream_a638e858:

    # "My whole body burned, enflamed with the desire to take her, thoughts protruding of violent rough sex while I claimed and ‘mated’ with her."
    "Todo mi cuerpo ardía, enardecido por el deseo de tomarla, surgiendo pensamientos de sexo violento y duro mientras la reclamaba y me ‘apareaba’ con ella."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:297
translate es ev_AdaraDream_23335a00:

    # "But I understood these thoughts to come from the thing inside me, and as my sweaty hands coiled into a fist, I resisted."
    "Pero comprendí que esos pensamientos procedían de lo que llevaba dentro, y mientras mis manos sudorosas se enroscaban en un puño, me resistí."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:298
translate es ev_AdaraDream_a6d90245:

    # MC @ talk "A-Adara... Not that I don’t want this but-"
    MC @ talk "A-Adara... No es que no quiera esto pero-"

