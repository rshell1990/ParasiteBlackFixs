    # ADARA @ talk "[player_name!t]! There you are!"
    ADARA @ talk "¡[player_name!t]! ¡Ahí estás!"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:14
translate es qst_reunion_tavern_7fc824f0:

    # MC @ talk "Come, let’s grab ourselves a table somewhere quiet..."
    MC @ talk "Ven, vamos a buscar una mesa en algún lugar tranquilo..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:15
translate es qst_reunion_tavern_58b0c698:

    # MC @ talk "I imagine we both have a lot to talk about."
    MC @ talk "Imagino que ambos tenemos mucho de qué hablar."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:18
translate es qst_reunion_tavern_6b73f9d6:

    # ADARA @ talk "...I must admit, you look so... {i}different.{/i}"
    ADARA @ talk "...Debo admitirlo, te ves tan... {i}diferente.{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:19
translate es qst_reunion_tavern_1c41f56e:

    # ADARA @ talk "Is the same for Markus?"
    ADARA @ talk "¿Es lo mismo para Markus?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:20
translate es qst_reunion_tavern_acde7642:

    # MC @ talk "Uhh, yes... We both look a little different now."
    MC @ talk "Uhh, sí... Ambos nos vemos un poco diferentes ahora."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:21
translate es qst_reunion_tavern_813ff63a:

    # ADARA @ talk "I don’t understand... It’s only been a few months and-"
    ADARA @ talk "No lo entiendo... Solo han pasado unos meses y-"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:22
translate es qst_reunion_tavern_b789ba22:

    # ADARA @ talk "{i}It’s like you’re a different person!{/i}"
    ADARA @ talk "{i}¡Es como si fueras una persona diferente!{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:23
translate es qst_reunion_tavern_f752d247:

    # MC @ talk "There’s... a lot that happened while out there, Adara."
    MC @ talk "Pasaron muchas cosas mientras estuvie allí fuera, Adara."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:27
translate es qst_reunion_tavern_e1e17d6f:

    # "Adara’s hand reached out to touch mine, it was warm and soft to the touch."
    "La mano de Adara se extendió para tocar la mía, era cálida y suave al tacto."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:28
translate es qst_reunion_tavern_4fe18085:

    # "Her eyes widened and seemed to almost sparkle against the slightly flickering flames of the candles."
    "Sus ojos se abrieron y casi parecieron brillar contra las llamas ligeramente parpadeantes de las velas."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:29
translate es qst_reunion_tavern_d5b8bcd8:

    # ADARA @ talk "What happened?"
    ADARA @ talk "¿Qué ocurrió?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:30
translate es qst_reunion_tavern_2844dd59:

    # ADARA @ talk "It must have been terrible... whatever you saw."
    ADARA @ talk "Debió haber sido terrible... lo que sea que hayas visto."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:45
translate es qst_reunion_tavern_244b3124:

    # MC @ talk "...It wasn’t good."
    MC @ talk "...No fue bueno."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:46
translate es qst_reunion_tavern_5f313f68:

    # MC @ talk "I try not to think about it or it all comes back at once."
    MC @ talk "Intento no pensar en ello o todo vuelve de golpe."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:47
translate es qst_reunion_tavern_5a8ca22f:

    # "Adara’s hand squeezed mine."
    "La mano de Adara apretó la mía."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:48
translate es qst_reunion_tavern_b09400bd:

    # ADARA @ talk "How did you both get home so fast?"
    ADARA @ talk "¿Cómo llegasteis los dos a casa tan rápido?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:49
translate es qst_reunion_tavern_2e830799:

    # MC @ talk "Honestly Adara, I can hardly remember."
    MC @ talk "Honestamente Adara, casi no lo recuerdo."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:50
translate es qst_reunion_tavern_f8170d9f:

    # MC @ talk "The battle was something ferocious and everything was a haze."
    MC @ talk "La batalla era algo feroz y todo era una neblina."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:51
translate es qst_reunion_tavern_534575e3:

    # MC @ talk "We just woke up in the Hospital beds."
    MC @ talk "Acabamos de despertarnos en las camas del hospital."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:52
translate es qst_reunion_tavern_8c75144e:

    # ADARA @ talk "Why were you all even sent out in such a hurry?"
    ADARA @ talk "¿Por qué os enviaron a todos con tanta prisa?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:53
translate es qst_reunion_tavern_40bb5d85:

    # MC @ talk "I can’t really talk too much about it..."
    MC @ talk "Realmente no puedo hablar mucho sobre ello..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:54
translate es qst_reunion_tavern_2d522b4d:

    # ADARA @ talk "What do you mean?"
    ADARA @ talk "¿Qué quieres decir?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:57
translate es qst_reunion_tavern_94d2d6c7:

    # ADARA @ talk "We were only told you were heading towards Inma to help with the increased attacks around the border there."
    ADARA @ talk "Solo nos dijeron que os dirigíais hacia Inma para ayudar con los crecientes ataques en la frontera."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:56
translate es qst_reunion_tavern_5486eff0:

    # MC @ talk "That was a lie."
    MC @ talk "Eso era mentira."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:57
translate es qst_reunion_tavern_9d023411:

    # MC @ talk "The real mission was kept a secret, we scouted deeper into Demorai territory beyond the Valley of Death."
    MC @ talk "La verdadera misión se mantuvo en secreto, exploramos más profundamente el territorio demorai más allá del Valle de la Muerte."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:58
translate es qst_reunion_tavern_a9843996:

    # ADARA @ talk "Huh..."
    ADARA @ talk "Eh..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:59
translate es qst_reunion_tavern_d4453d34:

    # MC @ talk "We were sent to check up on some old fort when we were attacked there."
    MC @ talk "Nos enviaron a comprobar un antiguo fuerte cuando nos atacaron allí."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:60
translate es qst_reunion_tavern_e7393b81:

    # ADARA @ talk "How many?"
    ADARA @ talk "¿Cuántos?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:61
translate es qst_reunion_tavern_e3c5c024:

    # MC @ talk "Hundreds... Maybe thousands, I can hardly remember with the chaos of it all."
    MC @ talk "Cientos... quizá miles, apenas puedo recordarlo con el caos que hubo allí."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:56
translate es qst_reunion_tavern_0f65e518:

    # ADARA @ talk "[player_name!t]..."
    ADARA @ talk "[player_name!t]..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:63
translate es qst_reunion_tavern_bcd3015d:

    # MC @ talk "Me and Markus were the last ones left, we headed down into the underground of the fort and sealed ourselves in this small cavern."
    MC @ talk "Markus y yo éramos los últimos que quedábamos, nos dirigimos hacia el subsuelo del fuerte y nos encerramos en una pequeña caverna."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:64
translate es qst_reunion_tavern_ff512f24:

    # ADARA @ talk "Then what happened?"
    ADARA @ talk "¿Entonces que pasó?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:65
translate es qst_reunion_tavern_390e3879:

    # MC @ talk "Well..."
    MC @ talk "Bueno..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:60
translate es qst_reunion_tavern_7c56712f:

    # ADARA @ talk "...[player_name!t]?"
    ADARA @ talk "...¿[player_name!t]?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:67
translate es qst_reunion_tavern_24263e73:

    # ADARA @ talk "You can tell me anything, you know that."
    ADARA @ talk "Puedes contarme cualquier cosa, lo sabes."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:71
translate es qst_reunion_tavern_6c707b23:

    # "...I can’t tell her everything, but at least I can tell her some part of the truth about what happened back then."
    "...No puedo contarle todo, pero al menos puedo contarle una parte de la verdad sobre lo que ocurrió entonces."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:72
translate es qst_reunion_tavern_a05811dc:

    # MC @ talk "...Look, you can’t tell anyone about this, okay?"
    MC @ talk "...Mira, no puedes contarle esto a nadie, ¿de acuerdo?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:73
translate es qst_reunion_tavern_66d97588:

    # MC @ talk "It’s not safe for me to even be talking about this."
    MC @ talk "No es seguro para mí siquiera hablar de esto."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:74
translate es qst_reunion_tavern_b46267dc:

    # ADARA @ talk "I won’t say a word."
    ADARA @ talk "No diré ni una palabra."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:75
translate es qst_reunion_tavern_5f9e4020:

    # MC @ talk "There were these... {i}things{/i} down there."
    MC @ talk "Habían esas... {i}cosas{/i} allí abajo."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:76
translate es qst_reunion_tavern_e41768a2:

    # ADARA @ talk "{i}’Things?’{/i}"
    ADARA @ talk "{i}’¿Cosas?’{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:77
translate es qst_reunion_tavern_f8ab7057:

    # MC @ talk "Like pillars but, containing {i}something{/i} inside them."
    MC @ talk "Como pilares pero conteniendo {i}algo{/i} en su interior."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:78
translate es qst_reunion_tavern_5d142415:

    # MC @ talk "When we touched them, we blacked out and woke up in the Hospital back here."
    MC @ talk "Cuando los tocamos, nos desmayamos y nos despertamos en el hospital aquí."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:79
translate es qst_reunion_tavern_4d770eb5:

    # ADARA @ talk "You don’t remember a thing?"
    ADARA @ talk "¿No recuerdas nada?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:80
translate es qst_reunion_tavern_fd21584e:

    # MC @ talk "I... No."
    MC @ talk "Yo... No."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:81
translate es qst_reunion_tavern_e24026a9:

    # MC @ talk "But something happened in there and it {i}changed{/i} us."
    MC @ talk "Pero algo pasó allí y nos {i}cambió{/i}."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:82
translate es qst_reunion_tavern_834d1f41:

    # ADARA @ talk "You mean... {i}Something is inside of you both now?{/i}"
    ADARA @ talk "¿Quieres decir... {i}que hay algo dentro de vosotros dos ahora?{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:83
translate es qst_reunion_tavern_024e1267:

    # MC @ talk "Don’t say it out loud!"
    MC @ talk "¡No lo digas en voz alta!"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:84
translate es qst_reunion_tavern_977f2828:

    # MC @ talk "Gods only know what the inquisitors would do if they found out..."
    MC @ talk "Solo los dioses saben qué harían los inquisidores si se enteraran..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:79
translate es qst_reunion_tavern_58485fca:

    # ADARA @ talk "But... [player_name!t], what if it’s dangerous?"
    ADARA @ talk "Pero... [player_name!t], ¿qué pasa si es peligroso?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:80
translate es qst_reunion_tavern_c7d8ed95:

    # ADARA @ talk "[player_name!t], you need to see a mage or someone about it!"
    ADARA @ talk "¡[player_name!t],necesitas ver a un mago o a alguien al respecto!"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:87
translate es qst_reunion_tavern_e840b16a:

    # MC @ talk "Adara, you have to keep quiet about this."
    MC @ talk "Adara, tienes que guardar silencio sobre esto."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:88
translate es qst_reunion_tavern_972a7844:

    # ADARA @ talk "And I will but..."
    ADARA @ talk "Y lo haré pero..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:89
translate es qst_reunion_tavern_5921e895:

    # MC @ talk "Adara, I’m fine, okay?"
    MC @ talk "Adara, estoy bien, ¿de acuerdo?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:90
translate es qst_reunion_tavern_cb51eacf:

    # MC @ talk "Just don’t worry."
    MC @ talk "Simplemente no te preocupes."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:91
translate es qst_reunion_tavern_3ab605e9:

    # ADARA @ talk "How can you ask me to not worry about you?"
    ADARA @ talk "¿Cómo puedes pedirme que no me preocupe por ti?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:92
translate es qst_reunion_tavern_df83141d:

    # MC @ talk "Adara, {i}I’m fine.{/i}"
    MC @ talk "Adara, {i}estoy bien.{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:93
translate es qst_reunion_tavern_af768121:

    # MC @ talk "I {i}feel{/i} fine."
    MC @ talk "Me {i}siento{/i} bien."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:94
translate es qst_reunion_tavern_45e38243:

    # ADARA @ talk "...Alright, if you say so."
    ADARA @ talk "...Está bien, si tú lo dices."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:95
translate es qst_reunion_tavern_80c2c498:

    # ADARA @ talk "But if something happens you have to promise me you’ll get it looked at."
    ADARA @ talk "Pero si pasa algo tienes que prometerme que lo harás revisar."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:96
translate es qst_reunion_tavern_0c84ba6a:

    # MC @ talk "I promise."
    MC @ talk "Lo prometo."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:97
translate es qst_reunion_tavern_0a8b4028:

    # "Adara smiled faintly, still anxious and perhaps not entirely believing towards my comment."
    "Adara sonrió levemente, todavía ansiosa y quizás no del todo creyendo en mi comentario."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:100
translate es qst_reunion_tavern_ab73a38f:

    # MC @ talk "I can hardly remember much of it."
    MC @ talk "Apenas puedo recordar mucho de ello."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:101
translate es qst_reunion_tavern_7453a280:

    # MC @ talk "There was just too much adrenaline coursing through both of us."
    MC @ talk "Había demasiada adrenalina corriendo a través de nosotros dos."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:102
translate es qst_reunion_tavern_b6dfe4f8:

    # MC @ talk "We managed to find a back passage out and just kept riding back to Novaras as fast as we could."
    MC @ talk "Logramos encontrar un pasaje de salida y continuamos viajando de regreso a Novaras tan rápido como pudimos."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:103
translate es qst_reunion_tavern_6e95d48d:

    # ADARA @ talk "Where did the horses come from?"
    ADARA @ talk "¿De dónde vinieron los caballos?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:104
translate es qst_reunion_tavern_67eacfe5:

    # MC @ talk "They uh, they were just roaming."
    MC @ talk "Ellos uh, solo estaban vagando."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:105
translate es qst_reunion_tavern_42cc88be:

    # MC @ talk "I think they had bolted from the battle and a few had stumbled their way around where we were."
    MC @ talk "Creo que habían huido de la batalla y algunos se habían abierto paso a trompicones por donde estábamos."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:106
translate es qst_reunion_tavern_77748251:

    # ADARA @ talk "...R-Right."
    ADARA @ talk "...C-cierto."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:107
translate es qst_reunion_tavern_0ecc4fca:

    # MC @ talk "Adara didn’t seem entirely convinced with my story, not that it was exactly a very good one."
    MC @ talk "Adara no parecía del todo convencida con mi historia, no es que fuera exactamente muy buena."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:108
translate es qst_reunion_tavern_c473d9e4:

    # ADARA @ talk "...But how did you get back so fast?"
    ADARA @ talk "...Pero ¿cómo volviste tan rápido?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:109
translate es qst_reunion_tavern_dad6bcef:

    # ADARA @ talk "I mean, I heard you came back {i}in a week.{/i}"
    ADARA @ talk "Quiero decir, escuché que volviste {i}en una semana.{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:110
translate es qst_reunion_tavern_48a07b7c:

    # MC @ talk "Oh, uh..."
    MC @ talk "Oh, eh..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:111
translate es qst_reunion_tavern_cc2d6668:

    # MC @ talk "Well you see, we {i}actually{/i} arrived back about a month ago."
    MC @ talk "Bueno, verás, en {i}realidad{/i} volvimos hace aproximadamente un mes."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:112
translate es qst_reunion_tavern_3526ce6c:

    # ADARA @ talk "A month?"
    ADARA @ talk "¿Un mes?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:113
translate es qst_reunion_tavern_45e3abcc:

    # MC @ talk "Yeah, apparently we just collapsed and we’ve been bed-ridden and in and out of consciousness for days."
    MC @ talk "Sí, aparentemente simplemente colapsamos y estuvimos postrados en cama, entrando y saliendo de la conciencia durante días."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:114
translate es qst_reunion_tavern_0f5a8f6f:

    # ADARA @ talk "Really?"
    ADARA @ talk "¿Ah sí?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:115
translate es qst_reunion_tavern_ba0e1c6b:

    # MC @ talk "Yeah... really."
    MC @ talk "Sí... en serio."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:116
translate es qst_reunion_tavern_d5d1bb96:

    # "I hate lying to her like this, but it’s for the best."
    "Odio mentirle así, pero es lo mejor."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:117
translate es qst_reunion_tavern_8dd6d326:

    # MC @ talk "Sorry to be the bearer of bad news."
    MC @ talk "Lamento ser el portador de malas noticias."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:118
translate es qst_reunion_tavern_b42f44d2:

    # MC @ talk "Our ‘legendary’ ride home is quite the exaggeration."
    MC @ talk "Nuestro ‘legendario’ viaje a casa es toda una exageración."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:119
translate es qst_reunion_tavern_dd17a88e:

    # MC @ talk "No dragons I’m afraid."
    MC @ talk "No hay dragones, me temo."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:120
translate es qst_reunion_tavern_e63ba1c1:

