

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:5
translate es scr_WomansTouch_1_bb4f4d83:

    # HELENA @ talk "And what matter could I help you with?"
    HELENA @ talk "¿Y en qué asunto podría ayudarte?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:6
translate es scr_WomansTouch_1_4c7f46eb:

    # MC @ talk "It is... a young maiden."
    MC @ talk "Es... una joven doncella."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:7
translate es scr_WomansTouch_1_a1a8ff03:

    # MC @ talk "Who wishes to speak with someone and understand her desires better."
    MC @ talk "Que desea hablar con alguien y comprender mejor sus deseos."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:8
translate es scr_WomansTouch_1_6efa0568:

    # "Helena raised an eyebrow at the comment."
    "Helena levantó una ceja ante el comentario."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:9
translate es scr_WomansTouch_1_3ee116f0:

    # HELENA @ shock "And her mother has not taught her these things?"
    HELENA @ shock "¿Y su madre no le ha enseñado estas cosas?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:10
translate es scr_WomansTouch_1_9088fb63:

    # MC @ talk "She has no mother, nor father."
    MC @ talk "No tiene ni madre ni padre."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:11
translate es scr_WomansTouch_1_9e1ee060:

    # MC @ talk "I don't feel the words of a man are what she wants to hear."
    MC @ talk "No creo que las palabras de un hombre sean lo que ella quiere oír."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:12
translate es scr_WomansTouch_1_99f0308c:

    # HELENA @ sad "I see... How tragic, but why me?"
    HELENA @ sad "Ya veo... Qué trágico, pero ¿por qué yo?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:13
translate es scr_WomansTouch_1_85f27e4f:

    # HELENA @ talk "Surely some other girl closer to you could speak to her."
    HELENA @ talk "Seguro que alguna otra chica más cercana a ti podría hablar con ella."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:14
translate es scr_WomansTouch_1_531a34c9:

    # MC @ talk "I believe in this case a stranger might be better..."
    MC @ talk "Creo que en este caso un extraño podría ser mejor..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:15
translate es scr_WomansTouch_1_4249bd08:

    # MC @ talk "The situation is... {i}delicate{/i} and silent discretion is needed."
    MC @ talk "La situación es... {i}delicada{/i} y se necesita discreción silenciosa."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:16
translate es scr_WomansTouch_1_5baea012:

    # HELENA @ smile "...A courtesan's silence is bound by coin."
    HELENA @ smile "...El silencio de una cortesana está ligado a la moneda."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:17
translate es scr_WomansTouch_1_ff7bd2ea:

    # HELENA @ talk "If the matter is as 'delicate' as you say it is, then my help is for a hundred coins at least."
    HELENA @ talk "Si el asunto es tan 'delicado' como dices, entonces mi ayuda vale almenos cien monedas como mínimo."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:18
translate es scr_WomansTouch_1_cd4af192:

    # HELENA @ talk "And that is ONLY to consult with the girl, do not try pushing for anything else."
    HELENA @ talk "Y eso SOLO para consultar con la chica, no intentes presionar para otra cosa."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:19
translate es scr_WomansTouch_1_5e6cb9ea:

    # MC @ talk "I agree to your terms."
    MC @ talk "Acepto tus condiciones."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:23
translate es scr_WomansTouch_helenaMenu_be87999a:

    # HELENA @ talk "A hundred coins for my services it is."
    HELENA @ talk "Cien monedas por mis servicios, entonces."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:26
translate es scr_WomansTouch_helenaMenu_a7f9ce18:

    # HELENA @ talk "Return when you have the coin."
    HELENA @ talk "Vuelve cuando tengas el dinero."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:32
translate es scr_WomansTouch_helenaMenu_ed125ef9:

    # HELENA @ talk "...Very well, bring the girl to me."
    HELENA @ talk "...Muy bien, tráeme a la chica."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:33
translate es scr_WomansTouch_helenaMenu_6c536458:

    # MC @ talk "Is there a room or somewhere private we may go?"
    MC @ talk "¿Hay alguna habitación o algún lugar privado al que podamos ir?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:34
translate es scr_WomansTouch_helenaMenu_f2296ef1:

    # HELENA @ talk "This way..."
    HELENA @ talk "Por aquí..."

translate es strings:

    # game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:24
    old "Seems I am a little short..."
    new "Parece que estoy un poco corto..."

    # game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:24
    old "Pay her"
    new "Pagarle"
