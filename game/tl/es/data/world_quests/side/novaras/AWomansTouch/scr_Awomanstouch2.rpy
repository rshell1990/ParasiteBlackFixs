

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:8
translate es scr_WomansTouch_2_65235176:

    # HELENA @ talk "Well, where is this girl you speak of?"
    HELENA @ talk "Bueno, ¿dónde está esa chica de la que hablas?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:9
translate es scr_WomansTouch_2_de836bbf:

    # MC @ talk "Elena! It's alright to come in."
    MC @ talk "¡Elena! Puedes pasar."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:10
translate es scr_WomansTouch_2_b672f048:

    # "Elena trotted into the room, and Helena stared at the blue wolf before her before scoffing."
    "Elena entró trotando en la habitación y Helena se quedó mirando a la loba azul que tenía delante antes de reirse."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:14
translate es scr_WomansTouch_2_d26e873d:

    # HELENA @ angry "{i}...Surely this is some kind of jest?{/i}"
    HELENA @ angry "{i}...¿Es una epecie de broma?{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:15
translate es scr_WomansTouch_2_acaacc3b:

    # "I turned to look towards Elena."
    "Me giré para mirar hacia Elena."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:16
translate es scr_WomansTouch_2_745b8841:

    # MC @ talk "It's alright Elena, show her your true form."
    MC @ talk "Está bien Elena, enséñale tu verdadera forma."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:18
translate es scr_WomansTouch_2_fb86696f:

    # "In that moment, as Elena rose up on hind legs and transformed into the wolf girl before her, Helena stepped back, at first anxious and afraid of what she was seeing."
    "En ese momento, cuando Elena se levantó sobre sus patas traseras y se transformó en la chica loba que tenía delante, Helena dio un paso atrás, al principio ansiosa y asustada por lo que estaba viendo."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:20
translate es scr_WomansTouch_2_0b0690ba:

    # HELENA @ shock "You..."
    HELENA @ shock "Tú..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:31
translate es scr_WomansTouch_2_44999742:

    # "Elena gave a curtly bow and Helena's frightened pale expression began to ease up slightly as she heard the wolf girl speak softly."
    "Elena hizo una breve reverencia y la expresión pálida y asustada de Helena comenzó a aliviarse ligeramente al oír a la chica loba hablar en voz baja."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:32
translate es scr_WomansTouch_2_9572e69a:

    # ELENA @ talk "I am sorry to alarm you so..."
    ELENA @ talk "Siento alarmarte tanto..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:33
translate es scr_WomansTouch_2_3bd77a44:

    # ELENA @ talk "As you can see, this is why secrecy was so important."
    ELENA @ talk "Como puedes ver, esta es la razón por la que el secretismo era tan importante."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:34
translate es scr_WomansTouch_2_9e27b4fa:

    # "It was almost surprising how quickly Helena managed to recompose herself as she looked the wolf girl up and down."
    "Fue casi sorprendente lo rápido que Helena consiguió recomponerse mientras miraba a la chica loba de arriba abajo."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:35
translate es scr_WomansTouch_2_913e463b:

    # HELENA @ talk "...Yes, I see."
    HELENA @ talk "...Sí, ya veo."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:36
translate es scr_WomansTouch_2_d1f01937:

    # HELENA @ talk "[player_name!t], might you give us a minute?"
    HELENA @ talk "[player_name!t], ¿podrías darnos un minuto?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:37
translate es scr_WomansTouch_2_bf1a78a6:

    # MC @ talk "Hm?"
    MC @ talk "¿Hm?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:38
translate es scr_WomansTouch_2_c471718c:

    # HELENA @ smile "Such talk would be easier had without you shadowing over us."
    HELENA @ smile "Sería más fácil hablar de eso sin tu sombra."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:39
translate es scr_WomansTouch_2_99178872:

    # MC @ talk "Ah, very well... I shall leave you both to it."
    MC @ talk "Ah, muy bien... Os dejo a las dos con ello."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:40
translate es scr_WomansTouch_2_2783b167:

    # "Reluctantly, I stepped outside of the room and waited."
    "De mala gana, salí de la habitación y esperé."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:43
translate es scr_WomansTouch_2_9ac5f6a2:

    # "As a few minutes passed, I began to grow impatient."
    "Al cabo de unos minutos, empecé a impacientarme."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:44
translate es scr_WomansTouch_2_3d387964:

    # MC "(...Perhaps I should peer in and try listen to what they are saying?)"
    MC "(...¿Quizás debería asomarme e intentar escuchar lo que dicen?)"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:47
translate es scr_WomansTouch_2_bc9c942f:

    # "Gently, I pushed open the door ever so slightly to peer in on the two girls as they spoke."
    "Con cuidado, abrí ligeramente la puerta para espiar a las dos chicas mientras hablaban."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:59
translate es scr_WomansTouch_2_d29da379:

    # HELENA @ sad "It must have been difficult for you, having no mother in your life."
    HELENA @ sad "Debe haber sido difícil para ti, no tener una madre en tu vida."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:60
translate es scr_WomansTouch_2_e275d228:

    # "Helena pulled a soft expression, one that seemed to understand Elena's pain in ways perhaps I could not."
    "Helena puso una expresión suave, una que parecía entender el dolor de Elena de un modo que tal vez yo no podía."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:61
translate es scr_WomansTouch_2_b282dc18:

    # HELENA @ sad "And I can't imagine it was too easy fitting in and making friends looking so different."
    HELENA @ sad "Y no me imagino que fuera muy fácil encajar y hacer amigos pareciendo tan diferente."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:62
translate es scr_WomansTouch_2_8077b59e:

    # ELENA @ grumpy "It was difficult, but I struggled through."
    ELENA @ grumpy "Fue difícil, pero me esforcé."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:63
translate es scr_WomansTouch_2_30703dea:

    # HELENA @ sad "As all woman must do."
    HELENA @ sad "Como deben hacer todas las mujeres."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:64
translate es scr_WomansTouch_2_ef36b635:

    # ELENA @ angry "...I was raised to be strong, to fight, to protect the lady Grace."
    ELENA @ angry "...Me criaron para ser fuerte, para luchar, para proteger a lady Grace."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:65
translate es scr_WomansTouch_2_ff055ab8:

    # ELENA @ angry "For years, I never even thought of myself as much of a person really, only an extension of her and the family's will."
    ELENA @ angry "Durante años, ni siquiera me consideré realmente una persona, solo una extensión de su voluntad y la de la familia."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:66
translate es scr_WomansTouch_2_82d2c5dd:

    # HELENA @ sad "You saw yourself as nothing but a tool."
    HELENA @ sad "No te veías más que como una herramienta."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:67
translate es scr_WomansTouch_2_4b3713a6:

    # ELENA @ grumpy "I am a tool, that is my purpose."
    ELENA @ grumpy "Soy una herramienta, ese es mi propósito."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:68
translate es scr_WomansTouch_2_94082e66:

    # HELENA @ sad "{i}You are a woman Elena.{/i}"
    HELENA @ sad "{i}Eres una mujer Elena.{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:69
translate es scr_WomansTouch_2_75079887:

    # HELENA @ talk "You are not a tool, you are a woman with her own mind and emotions."
    HELENA @ talk "No eres una herramienta, eres una mujer con mente y emociones propias."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:70
translate es scr_WomansTouch_2_55cc5b69:

    # ELENA @ sad "...I feel dirty for wanting more."
    ELENA @ sad "...Me siento sucia por querer más."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:71
translate es scr_WomansTouch_2_d4101819:

    # ELENA @ sad "For wanting to be held and to...to..."
    ELENA @ sad "Por querer ser abrazada y... por..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:72
translate es scr_WomansTouch_2_92d3f339:

    # HELENA @ lewd "{i}To taste a man?{/i}"
    HELENA @ lewd "{i}¿Probar a un hombre?{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:73
translate es scr_WomansTouch_2_2f755e31:

    # "Elena's cheeks burned brightly as her eyes dropped to the floor, unable to even lift them as she whispered her answer."
    "Las mejillas de Elena ardieron intensamente mientras sus ojos caían al suelo, incapaz siquiera de levantarlos mientras susurraba su respuesta."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:74
translate es scr_WomansTouch_2_5dbced31:

    # ELENA @ sad "{i}Yes...{/i}"
    ELENA @ sad "{i}Sí...{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:75
translate es scr_WomansTouch_2_5d499189:

    # HELENA @ lewd "You are not sullied or dirty for wanting these things Elena, to supress them for so long the way you have is unnatural."
    HELENA @ lewd "No estás manchada ni sucia por querer estas cosas Elena, reprimirlas durante tanto tiempo de la forma en que lo has hecho es antinatural."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:76
translate es scr_WomansTouch_2_4d1ab442:

    # ELENA @ shock "But... Humans... I'm not-"
    ELENA @ shock "Pero... los humanos... No soy-"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:77
translate es scr_WomansTouch_2_f3da07c6:

    # HELENA @ talk "My first love was a dark elf."
    HELENA @ talk "Mi primer amor fue un elfo oscuro."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:78
translate es scr_WomansTouch_2_ea230919:

    # HELENA @ talk "Gold eyes, almost like a cats."
    HELENA @ talk "Ojos dorados, casi como los de un gato."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:79
translate es scr_WomansTouch_2_50332cf8:

    # ELENA @ shock "You loved a dark elf?"
    ELENA @ shock "¿Amaste a un elfo oscuro?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:80
translate es scr_WomansTouch_2_29bab5be:

    # HELENA @ talk "Yes... We cannot help who we fall in love with or desire, Elena."
    HELENA @ talk "Sí... No podemos evitar de quién nos enamoramos o a quién deseamos, Elena."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:81
translate es scr_WomansTouch_2_0b8d28cd:

    # ELENA @ talk "What happened to him?"
    ELENA @ talk "¿Qué le pasó?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:82
translate es scr_WomansTouch_2_626c0400:

    # HELENA @ sad "Oh, that's a story for another time."
    HELENA @ sad "Oh, esa es una historia para otra ocasión."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:83
translate es scr_WomansTouch_2_1da0f391:

    # ELENA @ talk "Mmm, alright then."
    ELENA @ talk "Mmm, de acuerdo entonces."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:84
translate es scr_WomansTouch_2_886bc4c0:

    # "Helena motioned her head towards where I was, at the other side of the door."
    "Helena hizo un gesto con la cabeza hacia donde yo estaba, al otro lado de la puerta."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:85
translate es scr_WomansTouch_2_fb46e81f:

    # HELENA @ talk "{i}And him?{/i}"
    HELENA @ talk "{i}¿Y él?{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:86
translate es scr_WomansTouch_2_f866151b:

    # ELENA @ shock "W-What?"
    ELENA @ shock "¿Q-Qué?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:87
translate es scr_WomansTouch_2_15127021:

    # HELENA @ talk "Do you want him?"
    HELENA @ talk "¿Lo quieres?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:88
translate es scr_WomansTouch_2_adc88c4c:

    # ELENA @ lewd "I..."
    ELENA @ lewd "Yo..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:89
translate es scr_WomansTouch_2_15adc5f9:

    # ELENA @ sad "I doubt he wants me that way."
    ELENA @ sad "Dudo que me quiera de esa manera."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:90
translate es scr_WomansTouch_2_d216ca59:

    # HELENA @ smile "How do you know? Have you asked him?"
    HELENA @ smile "¿Cómo lo sabes? ¿Se lo has preguntado?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:91
translate es scr_WomansTouch_2_8c67b2eb:

    # "Elena paused blushing, and Helena laughed in response."
    "Elena hizo una pausa sonrojándose, y Helena rió en respuesta."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:92
translate es scr_WomansTouch_2_5aac07be:

    # HELENA @ talk "Do what you feel is right Elena, but nothing ventured is nothing gained."
    HELENA @ talk "Haz lo que creas conveniente Elena, pero quien nada arriesga nada gana."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:93
translate es scr_WomansTouch_2_526dd74b:

    # HELENA @ talk "Do you understand now Elena?"
    HELENA @ talk "¿Lo entiendes ahora Elena?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:94
translate es scr_WomansTouch_2_94a553a5:

    # ELENA @ talk "Yes, I think I understand."
    ELENA @ talk "Sí, creo que lo entiendo."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:95
translate es scr_WomansTouch_2_2f44c8c8:

    # HELENA @ talk "Now, do you think we should call him back in?"
    HELENA @ talk "¿Ahora, crees que deberíamos volver a llamarlo?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:96
translate es scr_WomansTouch_2_bcd09712:

    # ELENA @ talk "Yes... Yes I think so."
    ELENA @ talk "Sí... Sí, creo que sí."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:99
translate es scr_WomansTouch_2_8bb1a95c:

    # "I pulled away from the door just in time as Elena opened the door to let me inside."
    "Me aparté de la puerta justo a tiempo de que Elena abriera la puerta para dejarme entrar."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:101
translate es scr_WomansTouch_2_c5c93aa0:

    # "Deciding to respect their privacy, I waited patiently till the door opened and Elena appeared."
    "Decidí respetar su intimidad, esperé pacientemente a que se abriera la puerta y apareciera Elena."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:105
translate es scr_WomansTouch_2_64d95793:

    # ELENA @ talk "We are finished now."
    ELENA @ talk "Ya hemos terminado."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:107
translate es scr_WomansTouch_2_2d7cbd04:

    # "I headed back into the room as both Elena and Helena smiled at me."
    "Me dirigí de nuevo a la habitación mientras tanto Elena como Helena me sonreían."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:119
translate es scr_WomansTouch_2_8297b084:

    # HELENA @ talk "You have quite the special lady [player_name!t], I trust you wil look after her well."
    HELENA @ talk "Tienes una señorita muy especial [player_name!t], confío en que la cuides bien."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:119
translate es scr_WomansTouch_2_1ee269f5:

    # "Elena blushed at the comment, her tail swooshing from side to side slightly."
    "Elena se sonrojó ante el comentario y su cola se movió ligeramente de un lado a otro."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:120
translate es scr_WomansTouch_2_38e67625:

    # MC @ talk "Thank you for your help."
    MC @ talk "Gracias por la ayuda."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:121
translate es scr_WomansTouch_2_1e309eda:

    # MC @ smile "You've been... professional."
    MC @ smile "Has sido... profesional."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:122
translate es scr_WomansTouch_2_a38fcf13:

    # HELENA @ talk "I always am."
    HELENA @ talk "Siempre lo soy."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:123
translate es scr_WomansTouch_2_fafe16cf:

    # HELENA @ smile "But if I may, I have something I wish to ask back."
    HELENA @ smile "Pero si me permites, tengo algo que quiero preguntarte."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:124
translate es scr_WomansTouch_2_11ceb18e:

    # ELENA @ talk "Hm?"
    ELENA @ talk "¿Hm?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:125
translate es scr_WomansTouch_2_a944a15f:

    # HELENA @ lewd2 "I have never been with one such as you Elena... I should like to kiss you if I can."
    HELENA @ lewd2 "Nunca he estado con una como tú Elena... Me gustaría besarte si pudiera."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:126
translate es scr_WomansTouch_2_f935d267:

    # ELENA @ shock "K-Kiss me?!"
    ELENA @ shock "¡¿B-Bésame?!"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:127
translate es scr_WomansTouch_2_e67336e2:

    # "Elena turned to look towards me, cheeks burning red, unsure of what to do."
    "Elena se volvió hacia mí, con las mejillas enrojecidas, sin saber qué hacer."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:130
translate es scr_WomansTouch_2_e5179181:

    # "Elena turned towards Helena and nervously stepped closer."
    "Elena se volvió hacia Helena y se acercó nerviosamente."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:131
translate es scr_WomansTouch_2_1e55a07c:

    # "As she did so, Elena leaned forward for a kiss before Helena gently placed a finger over her lips to stop her."
    "Al hacerlo, Elena se inclinó hacia delante para darle un beso antes de que Helena le pusiera suavemente un dedo sobre los labios para detenerla."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:132
translate es scr_WomansTouch_2_440e32be:

    # HELENA @ smile "Is this your first kiss with a girl?"
    HELENA @ smile "¿Es tu primer beso con una chica?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:133
translate es scr_WomansTouch_2_e07abc89:

    # "Elena nodded."
    "Elena asintió."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:134
translate es scr_WomansTouch_2_6b873686:

    # HELENA @ lewd "Then let me make it more special."
    HELENA @ lewd "Entonces déjame hacerlo más especial."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:138
translate es scr_WomansTouch_2_7e83ecc6:

    # "Helena undid the laces on her dress and let it drop to the floor, revealing the white lingerie she wore beneath."
    "Helena se desabrochó los cordones del vestido y lo dejó caer al suelo, dejando al descubierto la lencería blanca que llevaba debajo."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:149
translate es scr_WomansTouch_2_ed1b9384:

    # "Elena's eyes widened as she bit down on her lower lip, cheeks burning red."
    "Elena abrió mucho los ojos y se mordió el labio inferior, con las mejillas enrojecidas."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:150
translate es scr_WomansTouch_2_55d9c661:

    # HELENA @ talk "Now, come closer..."
    HELENA @ talk "Ahora, acércate..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:155
translate es scr_WomansTouch_2_8a9d3853:

