translate es qst_BiteBark_4_BuyMeat_06e26754:

    # MC @ angry "Where did she go?"
    MC @ angry "¿Adónde ha ido?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:29
translate es qst_BiteBark_4_BuyMeat_beed6d81:

    # ADARA @ shock "...Umm."
    ADARA @ shock "...Umm."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:30
translate es qst_BiteBark_4_BuyMeat_4bf928df:

    # ADARA @ shock "Did you lose something?"
    ADARA @ shock "¿Perdiste algo?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:31
translate es qst_BiteBark_4_BuyMeat_95918c18:

    # MC @ angry "I... Yes, I need to go find her before she vanishes for good!"
    MC @ angry "Yo... ¡Sí, tengo que encontrarla antes de que desaparezca para siempre!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:32
translate es qst_BiteBark_4_BuyMeat_2be6fc1e:

    # "I turned to heel, waving to Adara as I hurried off to find the wolf."
    "Me di la vuelta y agité la mano hacia Adara mientras me apresuraba a buscar a la loba."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:33
translate es qst_BiteBark_4_BuyMeat_1df832fd:

    # MC @ talk "Talk to you again!"
    MC @ talk "¡Hablamos de nuevo!"

