translate es qst_BiteBark_4_BuyMeat_64953bd9:

    # MC @ surprised "Adara?"
    MC @ surprised "¿Adara?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:22
translate es qst_BiteBark_4_BuyMeat_20b0cd57:

    # ADARA @ smile "It's good to see you!"
    ADARA @ smile "¡Me alegro de verte!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:23
translate es qst_BiteBark_4_BuyMeat_4e2493c1:

    # ADARA @ talk "How goes all that adventuring?"
    ADARA @ talk "¿Cómo va todo eso de las aventuras?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:24
translate es qst_BiteBark_4_BuyMeat_697340bf:

    # MC @ talk "As well as it can I suppose."
    MC @ talk "Todo lo bien que se puede, supongo."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:25
translate es qst_BiteBark_4_BuyMeat_9f1b3663:

    # MC @ smile "I just came here to get some food for this one."
    MC @ smile "Solo vine a buscar comida para ésta."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:26
translate es qst_BiteBark_4_BuyMeat_f0304e5f:

    # "As I motioned my hand down towards the wolf, I realized she had wandered off."
    "Mientras hacía un gesto con la mano hacia la loba, me di cuenta de que se había alejado."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:27
translate es qst_BiteBark_4_BuyMeat_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "¿Qué?"

