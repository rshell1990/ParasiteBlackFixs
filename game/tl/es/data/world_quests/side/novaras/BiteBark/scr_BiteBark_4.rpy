

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:5
translate es qst_BiteBark_4_BuyMeat_d127e7d1:

    # BUTCHER "Ahh... You look like a man who appreciates only the finest meat!"
    BUTCHER "Ahh... ¡Pareces un hombre que aprecia solo la mejor carne!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:6
translate es qst_BiteBark_4_BuyMeat_8de0de80:

    # BUTCHER "Interested in what you see?"
    BUTCHER "¿Te interesa lo que ves?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:7
translate es qst_BiteBark_4_BuyMeat_08feec89:

    # BUTCHER "Or perhaps some meat for your friend here?"
    BUTCHER "¿O quizás algo de carne para tu amiga?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:8
translate es qst_BiteBark_4_BuyMeat_7719ae9d:

    # MC @ talk "Yes, I'd like something for my... companion."
    MC @ talk "Sí, me gustaría algo para mi... compañera."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:9
translate es qst_BiteBark_4_BuyMeat_1db0b664:

    # BUTCHER "Of course sir."
    BUTCHER "Por supuesto, señor."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:11
translate es qst_BiteBark_4_BuyMeat_647a237a:

    # "Turning to face my furry companion, I knelt down and held out a piece of fresh meat which she gently took from my hand."
    "Girándome hacia mi peluda compañera, me arrodillé y le ofrecí un trozo de carne freca, que ella tomó suavemente de mi mano."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:11
translate es qst_BiteBark_4_BuyMeat_fd1bfb54:

    # "After a few moments, she had quickly made short work of the meal."
    "Al cabo de unos instantes, la comida había desaparecido."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:13
translate es qst_BiteBark_4_BuyMeat_805be4fb:

    # MC @ smile "Well, someone was hungry!"
    MC @ smile "¡Vaya, alguien tenía hambre!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:14
translate es qst_BiteBark_4_BuyMeat_9f25c94b:

    # "Gently, I reached out to pet the wolf, but instinctively she moved back away from my hand."
    "Con cuidado, alargué la mano para acariciar a la loba, pero instintivamente se apartó de mi mano."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:16
translate es qst_BiteBark_4_BuyMeat_e0098381:

    # MC @ sad "(Hm, this could be tougher than I first thought.)"
    MC @ sad "(Hm, esto podría ser más difícil de lo que pensé en un principio)."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_4.rpy:18
translate es qst_BiteBark_4_BuyMeat_639b4267:

