# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:31
translate es qst_BiteBark_6_McRoomResolution_menu_5d84d511:

    # MC @ talk "{i}*Sigh*{/i} This is hopeless... I don't know what you are, but if you don't talk I can't help you."
    MC @ talk "{i}*Suspiro*{/i} Esto no tiene remedio... No sé lo que eres, pero si no hablas no puedo ayudarte."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:32
translate es qst_BiteBark_6_McRoomResolution_menu_586951b7:

    # "Rubbing my forehead in frustration, I was just about to turn and leave the wolf here alone when suddenly-"
    "Frotándome la frente con frustración, estaba a punto de darme la vuelta y dejar a la loba aquí sola cuando de repente-"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:37
translate es qst_BiteBark_6_McRoomResolution_menu_cb3b6f3e:

    # "As Elena stood up onto her hind legs, her form began to shift and shape rapidly, till the slender naked form of what seemed like a half human, half wolf stood before me."
    "Mientras Elena se incorporaba sobre sus patas traseras, su forma empezó a cambiar y a moldearse rápidamente, hasta que la esbelta forma desnuda de lo que parecía una mujer mitad humana, mitad loba, se plantó ante mí."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:47
translate es qst_BiteBark_6_McRoomResolution_menu_dbe6b97b:

    # MC @ surprised "...You-!"
    MC @ surprised "...¡Tú-!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:48
translate es qst_BiteBark_6_McRoomResolution_menu_d499acc4:

    # ELENA @ talk "Hello..."
    ELENA @ talk "Hola..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:50
translate es qst_BiteBark_6_McRoomResolution_menu_4152d412:

    # MC @ angry "Who are you really? Why did you not show your form to me before!"
    MC @ angry "¿Quién eres realmente? ¡¿Por qué no me mostraste tu forma antes?!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:51
translate es qst_BiteBark_6_McRoomResolution_menu_fc96eee0:

    # ELENA @ angry "Why would I show this form to a human? Your kind have long made sport of wiping my kind out when found."
    ELENA @ angry "¿Por qué mostraría esta forma a un humano? Hace tiempo que los tuyos se dedican a aniquilar a los míos cuando los encuentran."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:52
translate es qst_BiteBark_6_McRoomResolution_menu_640b8f49:

    # MC @ talk "Then why come with me? Why were you in the care of that beast master?"
    MC @ talk "¿Entonces por qué viniste conmigo? ¿Por qué estabas al cuidado de ese entrenador de bestias?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:53
translate es qst_BiteBark_6_McRoomResolution_menu_66fd53a2:

    # ELENA @ angry "Because you were the first one I could smell in a long time who was... {i}different.{/i}"
    ELENA @ angry "Porque fuiste el primero que pude oler en mucho tiempo que era... {i}diferente.{/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:54
translate es qst_BiteBark_6_McRoomResolution_menu_7d06a693:

    # ELENA @ grumpy "Let's not pretend I'm the only one hiding amongst humans."
    ELENA @ grumpy "No finjamos que soy la única que se esconde entre los humanos."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:55
translate es qst_BiteBark_6_McRoomResolution_menu_deb9c486:

    # MC @ talk "I am human."
    MC @ talk "Soy humano."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:56
translate es qst_BiteBark_6_McRoomResolution_menu_424bf9d8:

    # "Elena smiled."
    "Elena sonrió."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:57
translate es qst_BiteBark_6_McRoomResolution_menu_b2dfb6ce:

    # MC @ sad "...A being has... attached itself to me."
    MC @ sad "...Un ser se ha... unido a mí."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:58
translate es qst_BiteBark_6_McRoomResolution_menu_488c5d01:

    # MC @ talk "But I am {i}still{/i} human."
    MC @ talk "Pero {i}sigo{/i} siendo humano."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:59
translate es qst_BiteBark_6_McRoomResolution_menu_7867b6cf:

    # ELENA @ grumpy "You sure about that?"
    ELENA @ grumpy "¿Estás seguro de eso?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:60
translate es qst_BiteBark_6_McRoomResolution_menu_8580db2b:

    # ELENA @ grumpy "And do you really think other humans will care about the difference?"
    ELENA @ grumpy "¿Y de verdad crees que a otros humanos les importará la diferencia?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:61
translate es qst_BiteBark_6_McRoomResolution_menu_ac8278ff:

    # MC @ talk "What do you want... Elena, is it?"
    MC @ talk "¿Qué quieres?... Elena, ¿verdad?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:62
translate es qst_BiteBark_6_McRoomResolution_menu_e551c813:

    # "The wolf girls face softened as she spoke, her words soft like feathers."
    "La cara de la chica loba se suavizó al hablar, sus palabras suaves como plumas."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:63
translate es qst_BiteBark_6_McRoomResolution_menu_760f8a5c:

    # ELENA @ grumpy "...{i}Help...{/i} I want help."
    ELENA @ grumpy "...{i}Ayuda...{/i} Quiero ayuda."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:64
translate es qst_BiteBark_6_McRoomResolution_menu_3060f99f:

    # MC @ talk "What are you talking about?"
    MC @ talk "¿De qué estás hablando?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:65
translate es qst_BiteBark_6_McRoomResolution_menu_38d27225:

    # ELENA @ grumpy "The girl I was meant to protect... The one that wretched Beastmaster told you had vanished."
    ELENA @ grumpy "La chica que debía proteger... La que ese miserable entrenador de bestias te dijo que había desaparecido."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:66
translate es qst_BiteBark_6_McRoomResolution_menu_f3845347:

    # ELENA @ grumpy "I must find her, I made a vow to her father."
    ELENA @ grumpy "Debo encontrarla, hice una promesa a su padre."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:67
translate es qst_BiteBark_6_McRoomResolution_menu_4b8eb2a0:

    # MC @ talk "And you thought I would help you?"
    MC @ talk "¿Y pensaste que yo te ayudaría?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:68
translate es qst_BiteBark_6_McRoomResolution_menu_c68da4c9:

    # ELENA @ grumpy "Who else is there to trust? Humans are... Not kind to those different from them."
    ELENA @ grumpy "¿En quién más se puede confiar? Los humanos son... No son amables con los que son diferentes a ellos."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:69
translate es qst_BiteBark_6_McRoomResolution_menu_af99c76a:

    # ELENA @ grumpy "They've become cruel and hardened by war."
    ELENA @ grumpy "Se han vuelto crueles y duros por la guerra."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:74
translate es qst_BiteBark_6_McRoomResolution_menu2_91e61981:

    # ELENA @ grumpy "Lady Grace Thornfall, the last of the Thornfall line."
    ELENA @ grumpy "Lady Grace Thornfall, la última del linaje Thornfall."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:75
translate es qst_BiteBark_6_McRoomResolution_menu2_e6107bb9:

    # ELENA @ grumpy "Her father Lord Vront made me swear a vow before his passing that I would protect her."
    ELENA @ grumpy "Su padre, el lord Vront, me hizo jurar antes de morir que la protegería."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:76
translate es qst_BiteBark_6_McRoomResolution_menu2_80659d8e:

    # ELENA @ grumpy "She was meant to return home from her business abroad but... She has simply vanished."
    ELENA @ grumpy "Debía volver a casa de sus negocios en el extranjero, pero... simplemente desapareció."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:77
translate es qst_BiteBark_6_McRoomResolution_menu2_bfadb57a:

    # ELENA @ grumpy "I have been looking for her since... Trying to find what I can."
    ELENA @ grumpy "La he estado buscando desde entonces... Intentando encontrar lo que puedo."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:78
translate es qst_BiteBark_6_McRoomResolution_menu2_d5331bde:

    # MC @ talk "How do you know she isn't just dead?"
    MC @ talk "¿Cómo sabes que no está muerta?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:79
translate es qst_BiteBark_6_McRoomResolution_menu2_41638300:

    # ELENA @ sad "I do not know... Yet whatever the answer, I must know."
    ELENA @ sad "No lo sé... Sin embargo, cualquiera que sea la respuesta, debo saber."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:80
translate es qst_BiteBark_6_McRoomResolution_menu2_95b720bb:

    # ELENA @ sad "So, will you help me?"
    ELENA @ sad "Entonces, ¿me ayudarás?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:84
translate es qst_BiteBark_6_McRoomResolution_menu2_00475e23:

    # ELENA @ sad "{i}*sigh*{/i} very well... I am sorry for deceiving you so."
    ELENA @ sad "{i}*suspiro*{/i} Muy bien... Siento haberte engañado."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:85
translate es qst_BiteBark_6_McRoomResolution_menu2_7a52806a:

    # ELENA @ grumpy "But I must go now."
    ELENA @ grumpy "Pero debo irme ahora."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:86
translate es qst_BiteBark_6_McRoomResolution_menu2_265e00c6:

    # MC @ surprised "Are you sure you don't wish to stay? There is no need to leave so soon."
    MC @ surprised "¿Seguro que no quieres quedarte? No hay necesidad de irse tan pronto."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:87
translate es qst_BiteBark_6_McRoomResolution_menu2_21ba51a9:

    # ELENA @ grumpy "Your offer is kind, but no... She's still out there, I can feel it."
    ELENA @ grumpy "Tu oferta es amable, pero no... Ella sigue ahí fuera, puedo sentirlo."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:88
translate es qst_BiteBark_6_McRoomResolution_menu2_3c39cda2:

    # ELENA @ sad "I cannot rest till the lady is safe."
    ELENA @ sad "No puedo descansar hasta que la señorita esté a salvo."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:89
translate es qst_BiteBark_6_McRoomResolution_menu2_eca75fbc:

    # ELENA @ grumpy "Farewell... Strange traveller."
    ELENA @ grumpy "Adiós... Viajero extraño."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:93
translate es qst_BiteBark_6_McRoomResolution_menu2_367cbda8:

    # "In that moment, Elena once again morphed herself down into her blue wolf form, and before I knew it, she had sprinted past me out of the door."
    "En ese momento, Elena volvió a transformarse en su forma de loba azul y, antes de que me diera cuenta, había salido corriendo por la puerta."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:135
translate es qst_BiteBark_6_McRoomResolution_menu2_fb1bb61a:

    # "I heard [regina_ref!t] cry out as Elena no doubt bolted out of the front door, and she quickly rushed inside to speak to me."
    "Oí gritar a [regina_ref!t] mientras Elena, salía corriendo por la puerta principal, y rápidamente se apresuró a entrar para hablar conmigo."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:101
translate es qst_BiteBark_6_McRoomResolution_menu2_41405de6:

    # REGINA @ shock_talk "What happened? The wolf-"
    REGINA @ shock_talk "¿Qué ha pasado? La loba-"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:102
translate es qst_BiteBark_6_McRoomResolution_menu2_fea45294:

    # MC @ sad "It's alright, just let her go."
    MC @ sad "Está bien, déjala ir."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:143
translate es qst_BiteBark_6_McRoomResolution_menu2_1a04c9a7:

    # "[regina_ref_cap!t] opened her mouth to say something, but instead she angrily slammed the side of the fist lightly into the wall muttering under her breathe."
    "[regina_ref_cap!t] abrió la boca para decir algo, pero en lugar de eso golpeó ligeramente la pared con el puño, murmurando en voz baja."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:104
translate es qst_BiteBark_6_McRoomResolution_menu2_a83859d8:

    # REGINA @ angry "{i}Damn it...{/i}"
    REGINA @ angry "{i}Maldición...{/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:106
translate es qst_BiteBark_6_McRoomResolution_menu2_fadfc224:

    # MC @ sad "(I feel bad I couldn't help her but... I'd only be taking on more unnecessary risk for myself.)"
    MC @ sad "(Me siento mal por no poder ayudarla, pero... solo estaría asumiendo más riesgos innecesarios para mí)."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:107
translate es qst_BiteBark_6_McRoomResolution_menu2_3aa6a878:

    # MC "(I hope she finds what she is looking for, perhaps one day our paths will cross again?)"
    MC "(Espero que encuentre lo que busca, ¿quizás algún día nuestros caminos vuelvan a cruzarse?)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:115
translate es qst_BiteBark_6_McRoomResolution_menu2_1979dd4a:

    # "The wolf girls ears perked up, her face one of surprise that I had even agreed."
    "La chica loba levantó las orejas y puso cara de sorpresa porque yo hubiera aceptado."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:116
translate es qst_BiteBark_6_McRoomResolution_menu2_96b1d0a3:

    # ELENA @ shock "Just like that?"
    ELENA @ shock "¿Así sin más?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:117
translate es qst_BiteBark_6_McRoomResolution_menu2_04ba865a:

    # ELENA @ shock "You don't want anything in return?"
    ELENA @ shock "¿No quieres nada a cambio?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:120
translate es qst_BiteBark_6_McRoomResolution_menu2_05caa1ef:

    # "Elena pondered the idea for a moment before she bowed curtly."
    "Elena meditó la idea un momento antes de inclinarse bruscamente."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:121
translate es qst_BiteBark_6_McRoomResolution_menu2_3d5db95e:

    # ELENA @ talk "Very well..."
    ELENA @ talk "Muy bien..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:122
translate es qst_BiteBark_6_McRoomResolution_menu2_de398dd2:

    # ELENA @ talk "I agree to your terms."
    ELENA @ talk "Acepto tus condiciones."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:125
translate es qst_BiteBark_6_McRoomResolution_menu2_8ab6377c:

    # ELENA @ grumpy "Do I look like I carry coin on me?"
    ELENA @ grumpy "¿Te parece que llevo monedas encima?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:126
translate es qst_BiteBark_6_McRoomResolution_menu2_d6e66d73:

    # MC @ talk "Hmm... Then perhaps you can consider my services on loan?"
    MC @ talk "Hmm... Entonces, ¿quizás puedas considerar mis servicios en préstamo?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:127
translate es qst_BiteBark_6_McRoomResolution_menu2_f3bfa37e:

    # ELENA @ talk "Y-Yes... Lady Thornfall is very affluent, I am sure she will reward you generously for your services."
    ELENA @ talk "S-sí... La señorita Thornfall es muy acaudalada, estoy seguro de que te recompensará generosamente por tus servicios."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:128
translate es qst_BiteBark_6_McRoomResolution_menu2_0729cf9c:

    # MC @ talk "...Very well."
    MC @ talk "...Muy bien."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:129
translate es qst_BiteBark_6_McRoomResolution_menu2_536277f7:

    # ELENA @ smile "Good, then we have a deal!"
    ELENA @ smile "¡Bien, entonces tenemos un trato!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:132
translate es qst_BiteBark_6_McRoomResolution_menu2_8d819e1a:

    # ELENA @ shock "...W-What?"
    ELENA @ shock "...¿Q-Qué?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:133
translate es qst_BiteBark_6_McRoomResolution_menu2_e1f3deaa:

    # MC @ smile "Turn around."
    MC @ smile "Date la vuelta."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:134
translate es qst_BiteBark_6_McRoomResolution_menu2_aab88c5f:

    # MC @ bitelip "I want to get a better look at you."
    MC @ bitelip "Quiero verte mejor."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:135
translate es qst_BiteBark_6_McRoomResolution_menu2_c53b50ab:

    # "From the grin on my face, Elena realized quickly what I wanted, and with flushed cheeks she nervously turned around."
    "Por la sonrisa de mi cara, Elena se dio cuenta rápidamente de lo que quería, y con las mejillas sonrojadas se dio la vuelta nerviosamente."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:142
translate es qst_BiteBark_6_McRoomResolution_menu2_c817d36f:

    # "As my eyes looked over her cute ass, Elena let me gaze for a few moments before chiming in,"
    "Mientras mis ojos miraban su bonito culo, Elena me dejó contemplar unos instantes antes de intervenir."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:143
translate es qst_BiteBark_6_McRoomResolution_menu2_25b5dd03:

    # ELENA "{i}Are you done yet?{/i}"
    ELENA "{i}¿Ya has terminado?{/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:144
translate es qst_BiteBark_6_McRoomResolution_menu2_ec863f7f:

    # MC @ talk "Yes."
    MC @ talk "Sí."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:149
translate es qst_BiteBark_6_McRoomResolution_menu2_cd35eedf:

    # "Elena turned back to face me, still red in the face."
    "Elena se giró hacia mí, todavía con la cara roja."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:150
translate es qst_BiteBark_6_McRoomResolution_menu2_02dff900:

    # ELENA @ grumpy "So... Will you help me?"
    ELENA @ grumpy "Entonces... ¿Me ayudarás?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:151
translate es qst_BiteBark_6_McRoomResolution_menu2_65150043:

    # MC @ smile "Always happy to help a beautiful lady in need!"
    MC @ smile "¡Siempre feliz de ayudar a una bella señorita necesitada!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:152
translate es qst_BiteBark_6_McRoomResolution_menu2_027be4c2:

    # ELENA @ shock "{i}Beautiful?{/i}"
    ELENA @ shock "{i}¿Bella?{/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:153
translate es qst_BiteBark_6_McRoomResolution_menu2_90173a2a:

    # ELENA @ lewd "I... see."
    ELENA @ lewd "Ya... ya veo."

