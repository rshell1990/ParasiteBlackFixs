translate es strings:

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:8
    old "Visit Nijah"
    new "Visita Nijah"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:8
    old "I should visit Nijah down at housing district to discuss her future."
    new "Debería visitar a Nijah en el distrito de viviendas para hablar de su futuro."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:24
    old "I'm gonna deal with Tarek."
    new "Voy a ocuparme de Tarek."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:30
    old "Damzel In Diztrezz"
    new "Damizela en apuroz"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:31
    old "I agreed to help Nijah deal with Tarek."
    new "Acepté ayudar a Nijah a ocuparme de Tarek."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Get Markus' help"
    new "Consigue la ayuda de Markus"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "First step, get Markus. I'll need some backup on this one, that's for sure..."
    new "Primer paso, traer a Markus. Voy a necesitar un poco de apoyo en este caso, eso es seguro..."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Scout the black diamond"
    new "Explora el Diamante negro"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "We have to scout the black diamond at night. It should be a shady building in pleasure district."
    new "Tenemos que explorar el Diamante negro por la noche. Debe ser un edificio sombreado en el distrito de placer."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Storm the Black Diamond"
    new "Asalta el Diamante negro"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "We have decided on a frontal assault of the Black Diamond, Tarek's... operation. While it did sound pretty straightforward, I wonder if it was a good idea after all."
    new "Hemos decidido un asalto frontal al Diamante negro, la... operación de Tarek. Aunque sonaba bastante sencillo, me pregunto si fue una buena idea después de todo."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Infiltrate the Black Diamond"
    new "Infíltrate en el Diamante negro"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "We have decided to get closer to Tarek by infiltrating the Black Diamond. Once inside, we should be able to get rid of him for good."
    new "Hemos decidido acercarnos a Tarek infiltrándonos en el Diamante negro. Una vez dentro, deberíamos ser capaces de deshacernos de él para siempre."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Find Tarek"
    new "Encuentra a Tarek"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "We have successfully infiltrated the Black Diamond. Now, to find Tarek..."
    new "Nos hemos infiltrado con éxito en el Diamante negro. Ahora, a encontrar a Tarek..."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Learn more about Vulshan"
    new "Aprende más sobre Vulshan"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "It seems there is some sort of trouble stirring within Tarek's gang. I should try to learn more."
    new "Parece que hay algún tipo de problema dentro de la banda de Tarek. Debo tratar de aprender más."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Signal the guard"
    new "Avisa al guardia"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "I have struck a deal with one of Tarek's guards. They will aid me taking him down. All I need to do is give them a sign."
    new "He hecho un trato con uno de los guardias de Tarek. Ellos me ayudarán a derrotarlo. Todo lo que tengo que hacer es darles una señal."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Find evidence for Tarek"
    new "Encuentra pruebas para Tarek"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "I have decided to force Tarek out of Novaras by providing proof that he'll inevitably die if he stays. I should ask around the city for any evidence on Tarek's situation."
    new "He decidido obligar a Tarek a salir de Novaras aportando pruebas de que morirá inevitablemente si se queda. Debería preguntar en la ciudad por cualquier prueba sobre la situación de Tarek."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Investigate Market at night"
    new "Investiga el mercado por la noche"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Lucius Mal has told me that Vulshan and Khazahs leadership is having secret meetings in the market district, at night. I should investigate."
    new "Lucius Mal me ha dicho que los líderes de Vulshan y Khazahs están teniendo reuniones secretas en el distrito del mercado, por la noche. Debería investigar."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "Bring Tarek the letter"
    new "Trae la carta a Tarek"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:33
    old "I have found a rather compromising letter stolen from Tarek by the Khazahs. That should suffice as a proof to show him how shifting his underworld 'empire' is."
    new "He encontrado una carta bastante comprometedora robada a Tarek por los Khazahs. Eso debería bastar como prueba para demostrarle lo cambiante que es su 'imperio' de los bajos fondos."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:71
    old "Go to Tarek's office"
    new "Ve a la oficina de Tarek"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:76
    old "Talk to the guard"
    new "Hablar con el guardia"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:81
    old "Talk to the Raza addict"
    new "Hablar con el adicto a la raza"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:85
    old "Talk to the servant girl"
    new "Hablar con la sirvienta"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:88
    old "Scout Black Diamond"
    new "Explora el Diamante negro"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:93
    old "Do you know anything about Tarek or Black Diamond?"
    new "¿Sabes algo de Tarek o del Diamante negro?"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:129
    old "Let’s just reign death upon them."
    new "Hagamos reinar la muerte sobre ellos."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:129
    old "We should try getting close to Tarek to get rid of him."
    new "Deberíamos intentar acercarnos a Tarek para deshacernos de él."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/qst_DamzelDizt.rpy:140
    old "Knock-knock"
    new "Toc-toc"
