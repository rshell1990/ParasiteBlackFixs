translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_068aa4d2:

    # KHAZAH_LEADER "Good, then in the next three days, we shall-"
    KHAZAH_LEADER "Bien, entonces en los próximos tres días, vamos a-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:40
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_da309b27:

    # "Stepping onto a piece of glass accidentally beneath my feet, the loud crunching sound alerting the men to my presence."
    "Al pisar accidentalmente un trozo de cristal, el fuerte crujido alertó a los hombres de mi presencia."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:42
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_e470a966:

    # MC "(Fuck!)"
    MC "(¡Mierda!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:44
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_4b5c6465:

    # KHAZAH_LEADER "A SPY! QUICKLY!"
    KHAZAH_LEADER "¡UN ESPÍA! ¡RÁPIDO!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:52
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_b0917694:

    # "With the last of the men bloodied and dead on the ground, I reached down to pluck the bloodied scroll from one of their hands."
    "Con el último de los hombres ensangrentado y muerto en el suelo, me agaché para arrancar el pergamino ensangrentado de una de sus manos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:56
