

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:2
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_16e30b1d:

    # "You notice a suspiciously-looking man, no doubt a Vulshan, head off down one of the many winding back alleyways through the marketplace."
    "Te fijas en el hombre de aspecto sospechoso, sin duda un vulshan, que se aleja por uno de los muchos callejones sinuosos del mercado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:3
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_296a71e1:

    # "Do you follow him? You have a strong sense it will be dangerous..."
    "¿Lo sigues? Tienes la fuerte sensación de que será peligroso..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:14
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_b7f7fd31:

    # "Stalking the man through the many winding alleyways, I nearly lost him multiple times through the labyrinth like turns as we descended deeper into the bowels of the city."
    "Siguiendo al hombre por los numerosos callejones serpenteantes, estuve a punto de perderle varias veces en los giros laberínticos a medida que nos adentrábamos en las entrañas de la ciudad."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:15
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_15d6403f:

    # "Finally, I hide behind a wall as the man arrived upon some upon some small opening where the buildings converged."
    "Finalmente, me escondo detrás de una pared mientras el hombre llega a una pequeña abertura donde convergen los edificios."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:16
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_78a590ce:

    # "From the shadows, the Khazahs and Vulshan appeared."
    "De las sombras, los khazahs y vulshan aparecieron."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:16
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_204ab2ae:

    # KHAZAH_LEADER "So... Have you thought more on our terms?"
    KHAZAH_LEADER "Entonces... ¿Habéis pensado más en nuestras condiciones?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:17
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_8508067e:

    # VULSHAN_LEADER "We have, yet there is still much to be discussed."
    VULSHAN_LEADER "Lo hemos hecho, pero aún queda mucho por debatir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:18
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_9945ea8c:

    # KHAZAH_LEADER "What is the problem now?"
    KHAZAH_LEADER "¿Cuál es el problema ahora?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:19
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_e019d8a9:

    # KHAZAH_LEADER "This is the problem with you Vulshans, so... hesitant."
    KHAZAH_LEADER "Este es el problema con vosotros los vulshans, tan... indecisos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:20
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_700594ac:

    # VULSHAN_LEADER "Our will is as strong as yours, do not doubt that."
    VULSHAN_LEADER "Nuestra voluntad es tan fuerte como la vuestra, no lo dudéis."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:21
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_b710cda8:

    # VULSHAN_LEADER "But we are not so reckless as to throw ourselves to any cause for short term coin... Like a Khazhah."
    VULSHAN_LEADER "Pero no somos tan imprudentes como para lanzarnos a cualquier causa por monedas a corto plazo... Como un khazhah."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:22
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_a3a5f302:

    # KHAZAH_LEADER "Tsch, fool."
    KHAZAH_LEADER "Tsch, idiota."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:23
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_16c0fa2a:

    # KHAZAH_LEADER "Tarek's days are numbered, the Boshu, the Tumak, even the Zatsu are turning."
    KHAZAH_LEADER "Los días de Tarek están contados, los boshu, los tumak, incluso los zatsu se están revelando."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:24
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_2b9f1fce:

    # KHAZAH_LEADER "They stand with us as long as we are willing to absorb them into our ranks."
    KHAZAH_LEADER "Están con nosotros mientras estemos dispuestos a absorberlos en nuestras filas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:25
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_c7070d88:

    # VULSHAN_LEADER "He has done much for us, without him, you and I would still be spilling each others blood right now..."
    VULSHAN_LEADER "Ha hecho mucho por nosotros, sin él, tú y yo seguiríamos derramando la sangre de los demás ahora mismo..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:26
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_4657c99a:

    # KHAZAH_LEADER "He will be the death of us."
    KHAZAH_LEADER "Él será nuestra muerte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:27
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_8374922b:

    # KHAZAH_LEADER "He knows we are the biggest threat to his power and he seeks to weaken us."
    KHAZAH_LEADER "Sabe que somos la mayor amenaza para su poder y busca debilitarnos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:28
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_25156e44:

    # VULSHAN_LEADER "Your proof? The Vulshan made a vow, we are honor bound to-"
    VULSHAN_LEADER "¿Vuestras pruebas? Los vulshan hicimos un voto, estamos obligados por el honor a-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:29
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_9154a9d7:

    # KHAZAH_LEADER "There is no time for honor Vulshan."
    KHAZAH_LEADER "No es momento para el honor vulshan."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:30
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_5c7fe2a2:

    # KHAZAH_LEADER "He plans to split our territories further with the lesser factions, with us further fractured, he believes he will be able to control us easier."
    KHAZAH_LEADER "Planea dividir aún más nuestros territorios con las facciones menores, con nosotros más fracturados, cree que podrá controlarnos más fácilmente."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:31
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_b607196c:

    # VULSHAN_LEADER "And your proof of this?"
    VULSHAN_LEADER "¿Y vuestras pruebas de ello?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:34
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_18e354dd:

    # "The Khazah pulled from his robes a scroll which he tossed over towards the Vulshan leader who picked it up and began reading it."
    "El khazah sacó de su túnica un pergamino que lanzó hacia el líder vulshan, quien lo recogió y comenzó a leerlo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:33
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_4a4b656c:

    # KHAZAH_LEADER "One of our spies stole this from his office, a letter he sent secretly to the Yahvom."
    KHAZAH_LEADER "Uno de nuestros espías robó esto de su oficina, una carta que envió en secreto a los yahvom."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:34
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_eb970728:

    # KHAZAH_LEADER "Satisfied?"
    KHAZAH_LEADER "¿Satisfecho?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:35
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_daa84826:

    # VULSHAN_LEADER "...Yes, this will suffice."
    VULSHAN_LEADER "...Sí, esto será suficiente."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:38
translate es scr_nijah_damzelDizztrezz_evidenceFollowTheMan_cont_05115bc6:

    # MC "(That's the proof I need.)"
    MC "(Esta es la prueba que necesito)."

