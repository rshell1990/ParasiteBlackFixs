

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:2
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_2a800512:

    # "Knocking on the iron door, a slider opened as two piercing eyes looked the other side."
    "Al llamar a la puerta de hierro, se abrió una corredera mientras dos ojos penetrantes miraban al otro lado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:4
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6037568e:

    # THUG @ talk "Password?"
    THUG @ talk "¿Contraseña?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:5
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_12b02307:

    # MC @ talk "Silver tits on top of a golden ass."
    MC @ talk "Tetas plateadas sobre un culo dorado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:6
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3b865931:

    # THUG @ talk "Wha~"
    THUG @ talk "¿Qué~"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:7
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d6761cbb:

    # MC @ talk "Go tell Tarek we've brought proof!"
    MC @ talk "¡Ve a decirle a Tarek que hemos traído pruebas!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:9
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c2d8c402:

    # "After some muffled cursing, I heard the thug on the other side shuffle away."
    "Después de maldecir en voz baja, oí que el matón del otro lado se alejaba arrastrando los pies."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:10
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_bd24aa47:

    # "In a moment, a door opened and we were let in."
    "En un momento, se abrió una puerta y nos dejaron entrar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:11
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_45402abc:

    # "Tarek awaited in his office."
    "Tarek esperaba en su oficina."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:22
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_24c2dbf9:

    # MC @ talk "I have the proof you require Tarek."
    MC @ talk "Tengo la prueba que necesitas Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:23
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_9b7fdd62:

    # TAREK @ shock "What?! Show me!"
    TAREK @ shock "¡¿Qué?! ¡Enséñamelo!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:26
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_61e1b66d:

    # "I handed over the bloodied scroll to Tarek."
    "Le entregué el pergamino ensangrentado a Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:27
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_a8317f86:

    # MC @ talk "The other factions are about to turn on you, the Vulshan and Khazah's know you are trying to weaken them by handing over their territory to the lesser factions."
    MC @ talk "Las otras facciones están a punto de volverse contra ti, los vulshan y los khazah saben que intentas debilitarlos entregando su territorio a las facciones menores."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:28
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_60cee6bc:

    # TAREK "I-"
    TAREK "Yo-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:29
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5380f6ab:

    # "Tarek's face became sullen as the reality dawned on him."
    "El rostro de Tarek se volvió sombrío al darse cuenta de la realidad."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:30
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_b804709f:

    # TAREK @ sad "Yes... I can see now, it's all falling apart."
    TAREK @ sad "Sí... Ahora lo veo, todo se está desmoronando."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:31
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_579d4c44:

    # MC @ talk "Surely you must have known trying to weaken their factions would result on them to turn on you?"
    MC @ talk "Seguro que sabías que si intentabas debilitar a sus facciones, se volverían contra ti."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:32
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_1d4e9018:

    # TAREK "The Vulshan and Khazahs have been fighting for decades, I knew both were undermining my authority so what else was I supposed to do?"
    TAREK "Los vulshan y los khazahs han estado luchando durante décadas, sabía que ambos estaban socavando mi autoridad, así que ¿qué otra cosa podía hacer?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:33
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6ca2cf51:

    # TAREK @ sad "Not that it matters now... You were right it seems, this was inevitable."
    TAREK @ sad "No es que importe ahora... Parece que tenías razón, esto era inevitable."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:34
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_74bf3445:

    # MC @ talk "What will you do now?"
    MC @ talk "¿Qué vas a hacer ahora?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:35
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3e90c048:

    # TAREK "Worry not, I will keep my word and leave..."
    TAREK "No te preocupes, mantendré mi palabra y me iré..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:36
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_36997e06:

    # TAREK "...But not before I let loose and hand over all the information I have to the inquisitors!"
    TAREK "...¡Pero no antes de soltarme y entregar toda la información que tengo a los inquisidores!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:37
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4ff0ec6b:

    # MC @ talk "You'll try strike a deal with them?"
    MC @ talk "¿Intentarás llegar a un acuerdo con ellos?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:38
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e1c147f8:

    # TAREK "Why not? As it stands, I am a dead man... At least if I can offer them something in return, perhaps I may just walk away from all this with something to show still..."
    TAREK "¿Por qué no? Tal y como están las cosas, soy hombre muerto... Al menos si puedo ofrecerles algo a cambio, tal vez pueda salir de todo esto con algo que mostrar..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:39
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_33c1f58a:

    # MC @ talk "...And Nijah?"
    MC @ talk "...¿Y Nijah?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:40
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d4b7407a:

    # TAREK "Consider her debt settled."
    TAREK "Considera su deuda saldada."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:41
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_06188b6a:

    # TAREK "Before I go, you should know in my absence things may become more... {i}violent{/i} for a while."
    TAREK "Antes de irme, debes saber que en mi ausencia las cosas pueden volverse más... {i}violentas{/i} por un tiempo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:42
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_257af9a7:

    # TAREK @ angry "The violence I've tried to hold back will spill out in the power struggle to follow."
    TAREK @ angry "La violencia que he intentado contener se desbordará en la lucha por el poder."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:43
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_64af8631:

    # MC @ talk "Where will you go?"
    MC @ talk "¿Adónde irás?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:44
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffa0994f:

    # TAREK "Who knows!"
    TAREK "¡Quién sabe!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:45
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4bef9a69:

    # TAREK "Perhaps we may even run into each other again..."
    TAREK "Quizá volvamos a encontrarnos..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:46
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6074ce3c:

    # TAREK "Don't worry, I won't forget what you did for me here today."
    TAREK "No te preocupes, no olvidaré lo que hiciste por mí hoy aquí."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:47
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c9b5c36a:

    # TAREK "You could have just tried to kill me."
    TAREK "Podrías haber intentado matarme."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:48
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5d2a16c6:

    # MC @ talk "That's not my way."
    MC @ talk "Esa no es mi manera."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:49
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffbfa8ae:

    # TAREK "Hm... Perhaps there are still honest men in this land then."
    TAREK "Hm... Tal vez todavía hay hombres honestos en esta tierra entonces."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:50
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e81bba9c:

    # TAREK "Farewell friend, I will be gone by nightfall."
    TAREK "Adiós amigo, me habré ido al caer la noche."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:52
translate es scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_52dc527f:

    # MC @ talk "Farewell, Tarek."
    MC @ talk "Adiós, Tarek."
