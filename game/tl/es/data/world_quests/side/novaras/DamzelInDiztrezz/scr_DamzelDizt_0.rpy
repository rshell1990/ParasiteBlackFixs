# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_0.rpy:38
translate es qst_DamzelDizzt_0_427579df:

    # MC @ talk "Because {i}I{/i} intend to rule this city, and I don’t like competition."
