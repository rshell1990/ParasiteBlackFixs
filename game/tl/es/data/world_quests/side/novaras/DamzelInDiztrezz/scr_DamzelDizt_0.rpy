# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_0.rpy:39
translate es qst_DamzelDizzt_0_c26837af:

    # "Nijah seemed slightly taken aback at the answer, and a little unsure how to respond."
    "Nijah pareció un poco desconcertada por la respuesta, y un poco insegura de cómo responder."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_0.rpy:40
translate es qst_DamzelDizzt_0_67e5501c:

