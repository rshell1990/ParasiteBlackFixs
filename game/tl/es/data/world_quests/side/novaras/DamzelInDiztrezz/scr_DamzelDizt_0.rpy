translate es qst_DamzelDizzt_0_4cee88b6:

    # "Nijah dropped my hand, not quite sure what to make of me."
    "Nijah me soltó la mano, sin saber qué pensar de mí."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_0.rpy:45
