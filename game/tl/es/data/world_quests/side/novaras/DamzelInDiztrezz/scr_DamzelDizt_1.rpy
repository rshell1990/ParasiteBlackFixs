

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:4
translate es qst_DamzelDizzt_1_35069f7f:

    # "I have found Markus at his home."
    "He encontrado a Markus en su casa."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:5
translate es qst_DamzelDizzt_1_debc0b3c:

    # "With the two of us, we should be able to deal with Nijah's situation easily enough."
    "Con nosotros dos, deberíamos ser capaces de hacer frente a la situación de Nijah con bastante facilidad."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:10
translate es qst_DamzelDizzt_1_a513ce4a:

    # MARKUS "What brings you here [player_name!t]?"
    MARKUS "¿Qué te trae por aquí, [player_name!t]?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:13
translate es qst_DamzelDizzt_1_403c03f6:

    # MC @ talk "Markus, I need your help with something..."
    MC @ talk "Markus, necesito tu ayuda con algo..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:12
translate es qst_DamzelDizzt_1_74ded93e:

    # MARKUS "Oh no..."
    MARKUS "Oh no..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:13
translate es qst_DamzelDizzt_1_3034a906:

    # MARKUS "Not that face, I can tell when you have THAT face it isn’t going to be anything I want to be involved in."
    MARKUS "No esa cara, puedo decir que cuando tienes ESA cara no va a ser nada en lo que quiera estar involucrado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:16
translate es qst_DamzelDizzt_1_6fabec6f:

    # MC @ talk "I want your help clearing out a gang who are preying on the Ramonian people."
    MC @ talk "Quiero que me ayudes a eliminar a una banda que se aprovecha del pueblo ramoniano."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:15
translate es qst_DamzelDizzt_1_3ed75d07:

    # MARKUS "Anddddd there it is!"
    MARKUS "Yyyyy... ¡ahí está!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:16
translate es qst_DamzelDizzt_1_ac7ff2dc:

    # MARKUS "Impressive, one sentence in and I'm already shaking my head!"
    MARKUS "Impresionante, ¡una frase y ya estoy sacudiendo la cabeza!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:19
translate es qst_DamzelDizzt_1_fdca2051:

    # MC @ talk "Come on Markus!"
    MC @ talk "¡Venga Markus!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:18
translate es qst_DamzelDizzt_1_57fc6b2b:

    # MARKUS "Why in all of Alderay are you dragging me into this mess?"
    MARKUS "¿Por qué en todo Alderay me estás arrastrando a este lío?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:21
translate es qst_DamzelDizzt_1_6959558f:

    # MC @ talk "Because with our {i}‘gifts’{/i} we can have them gone by tonight!"
    MC @ talk "¡Porque con nuestros {i}‘regalos’{/i} podemos deshacernos de ellos esta noche!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:20
translate es qst_DamzelDizzt_1_e98840aa:

    # MARKUS "Urghh! Always trying to be the bloody hero!"
    MARKUS "¡Urghh! ¡Siempre intentando ser el maldito héroe!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:21
translate es qst_DamzelDizzt_1_a9be0c42:

    # MARKUS "... This is about a girl, isn’t it?"
    MARKUS "... Se trata de una chica, ¿no?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:24
translate es qst_DamzelDizzt_1_63a416dc:

    # MC @ talk "That... That doesn’t matter!"
    MC @ talk "Eso... ¡Eso no importa!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:23
translate es qst_DamzelDizzt_1_61d9172e:

    # MARKUS "Uhuh, yeah, it’s about a girl."
    MARKUS "Uhuh, sí, se trata de una chica."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:26
translate es qst_DamzelDizzt_1_8362d5b0:

    # MC @ talk "Markus!"
    MC @ talk "¡Markus!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:25
translate es qst_DamzelDizzt_1_ce2626dc:

    # MARKUS "I don’t see why this is our business."
    MARKUS "No veo por qué es asunto nuestro."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:26
translate es qst_DamzelDizzt_1_b3da4bfc:

    # MARKUS "Let the Ramonians sort out their own!"
    MARKUS "¡Dejemos que los ramonianos se las arreglen solos!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:27
translate es qst_DamzelDizzt_1_d2020b8b:

    # MARKUS "They keep to their end; I keep to mine."
    MARKUS "Ellos siguen a lo suyo; yo sigo a lo mío."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:30
translate es qst_DamzelDizzt_1_a042b2ed:

    # MC @ talk "I need you for this one."
    MC @ talk "Te necesito para esto."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:31
translate es qst_DamzelDizzt_1_d5cb57af:

    # MC @ talk "I'm going to do it with, or without you."
    MC @ talk "Voy a hacerlo contigo o sin ti."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:30
translate es qst_DamzelDizzt_1_4f3400b3:

    # MARKUS "..."
    MARKUS "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:33
translate es qst_DamzelDizzt_1_1897d03c:

    # MC @ talk "Now either you'll help me, or you won't."
    MC @ talk "Ahora o me ayudas, o no."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:34
translate es qst_DamzelDizzt_1_b85d7e3a:

    # "Markus thought about it for a moment before sighing,"
    "Markus se lo pensó un momento antes de suspirar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:33
translate es qst_DamzelDizzt_1_75bfbc25:

    # MARKUS "... Fine."
    MARKUS "... Está bien."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:34
translate es qst_DamzelDizzt_1_fbbbbf0e:

    # MARKUS "You know if I didn’t love you like a brother this would never happen, right?"
    MARKUS "Sabes que si no te quisiera como a un hermano esto nunca pasaría, ¿verdad?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:37
translate es qst_DamzelDizzt_1_d9069cd6:

    # MC @ talk "I owe you for this, Markus."
    MC @ talk "Te debo una por esto, Markus."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:36
translate es qst_DamzelDizzt_1_b6bca739:

    # MARKUS "You owe me nothing you bloody fool."
    MARKUS "No me debes nada, maldito tonto."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:39
translate es qst_DamzelDizzt_1_dd6bcf04:

    # MC @ talk "Then come, we have to head back to mine to plan for tonight..."
    MC @ talk "Entonces ven, tenemos que volver a la mía para planear lo de esta noche..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:40
translate es qst_DamzelDizzt_1_b66b98c0:

    # "Markus nodded as he traipsed behind me back to mine."
    "Markus asintió mientras avanzaba detrás de mí hasta la mía."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:50
translate es qst_DamzelDizzt_1_c2812d37:

    # MARKUS "Well, are you ready to discuss whatever you've just dragged me into?"
    MARKUS "Bueno, ¿estás listo para discutir lo que sea que me acabas de arrastrar?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:56
translate es qst_DamzelDizzt_1_c672a5c1:

    # "Nijah explained to us everything she could about Tarek and his men."
    "Nijah nos explicó todo lo que pudo sobre Tarek y sus hombres."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:58
translate es qst_DamzelDizzt_1_1854e7fe:

    # "She told us what she could remember of visiting the {i}Black Diamond{/i} herself when she came seeking a loan,"
    "Nos contó lo que recordaba de su visita al {i}Diamante negro{/i} cuando vino a pedir un préstamo"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:59
translate es qst_DamzelDizzt_1_8cedb000:

    # "And she told us that we should expect nearly two dozen of them inside, including Tarek himself."
    "Y nos dijo que debíamos esperar a casi dos docenas de ellos dentro, incluido el propio Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:60
translate es qst_DamzelDizzt_1_9f57a2c5:

    # "Through a complex series of heavy bribes, Tarek and his men have been allowed to continue uninterrupted by the City Guard,"
    "Mediante una compleja serie de cuantiosos sobornos, la los guardias de la ciudad han permitido a Tarek y sus hombres continuar sin interrupciones"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:61
translate es qst_DamzelDizzt_1_37072507:

    # "So it seems taking the matter to the law was now out of the question entirely."
    "Así que parece que llevar el asunto ante la justicia quedaba totalmente descartado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:65
translate es qst_DamzelDizzt_1_9696dba6:

    # MARKUS "That’s... a lot of men, you know."
    MARKUS "Eso es... un montón de hombres, sabes."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:66
translate es qst_DamzelDizzt_1_fde497bf:

    # MARKUS "If we kick the door in, claws out, no doubt the City Guard will come to see what the ruckus is about."
    MARKUS "Si echamos la puerta abajo, con las garras fuera, sin duda vendrán los guardias de la ciudad a ver de qué va el jaleo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:73
translate es qst_DamzelDizzt_1_13ff6a8a:

    # NIJAH "Tarek's Office below..."
    NIJAH "Oficina de Tarek abajo..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:68
translate es qst_DamzelDizzt_1_a579157d:

    # MARKUS "Below?"
    MARKUS "¿Abajo?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:75
translate es qst_DamzelDizzt_1_a67dc49b:

    # NIJAH "Yis, zer is a iron door zat leads to his office below..."
    NIJAH "Zí, hay una puerta de hierro que lleva a su oficina..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:70
translate es qst_DamzelDizzt_1_7430f31b:

    # MARKUS "They’re no doubt armed and ready... This might be like trying to storm a small fortress."
    MARKUS "TSin duda están armados y preparaos... Esto podría ser como tratar de asaltar una pequeña fortaleza."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:71
translate es qst_DamzelDizzt_1_b44c150a:

    # MARKUS "Not to mention the people already there who might get caught up in the fight."
    MARKUS "Por no hablar de la gente que ya está allí y que podría verse envuelta en la pelea."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:78
translate es qst_DamzelDizzt_1_95ab635e:

    # MC @ talk "You’re not bailing out on me, right?"
    MC @ talk "No me estarás abandonando, ¿verdad?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:73
translate es qst_DamzelDizzt_1_602c4eda:

    # MARKUS "Of course not, I've been itchin' to test our powers some more."
    MARKUS "Por supuesto que no, he estado ansioso por probar nuestros poderes un poco más."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:74
translate es qst_DamzelDizzt_1_4dc282fe:

    # MARKUS "But this isn't exactly what I had in mind."
    MARKUS "Pero esto no es exactamente lo que tenía en mente."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:81
translate es qst_DamzelDizzt_1_2f7c0e92:

    # "Nijah raised a curious eyebrow at the phrase."
    "Nijah arqueó una ceja curiosa ante la frase."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:82
translate es qst_DamzelDizzt_1_47f4e66c:

    # NIJAH "Powers?"
    NIJAH "¿Poderes?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:77
translate es qst_DamzelDizzt_1_b2c12961:

    # MARKUS "Uhh, never mind."
    MARKUS "Uhh, no importa."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:84
translate es qst_DamzelDizzt_1_9ca4de31:

    # MC @ talk "So, any ideas then?"
    MC @ talk "Entonces, ¿alguna idea?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:79
translate es qst_DamzelDizzt_1_16cd313d:

    # MARKUS "Well, our first option is that we just kick the door in and slaughter everyone inside."
    MARKUS "Bueno, nuestra primera opción es patear la puerta y masacrar a todos los que estén dentro."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:80
translate es qst_DamzelDizzt_1_4841c7eb:

    # MARKUS "The second, if what Nijah is telling us is right, is that Tarek seems to be the only one holding together a loose connection of gangs."
    MARKUS "La segunda, si lo que nos cuenta Nijah es cierto, es que Tarek parece ser el único que mantiene unida las bandas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:87
translate es qst_DamzelDizzt_1_5ae2fd2f:

    # "As long as we can get rid of him one way or another, we shouldn’t need to deal with the others."
    "Mientras podamos deshacernos de él de un modo u otro, no tendremos que ocuparnos de los demás."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:82
translate es qst_DamzelDizzt_1_1db74374:

    # MARKUS "They’ll fall apart without him."
    MARKUS "Se desmoronarán sin él."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:89
translate es qst_DamzelDizzt_1_81686189:

    # MC @ talk "Any other ideas?"
    MC @ talk "¿Alguna otra idea?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:84
translate es qst_DamzelDizzt_1_87531cb4:

    # MARKUS "Hmm... I guess we could try persuading him very nicely to leave but..."
    MARKUS "Hmm... Supongo que podríamos intentar persuadirlo muy amablemente para que se vaya, pero..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:85
translate es qst_DamzelDizzt_1_42fe984c:

    # MARKUS "Something tells me that isn’t going to work."
    MARKUS "Algo me dice que eso no va a funcionar."
