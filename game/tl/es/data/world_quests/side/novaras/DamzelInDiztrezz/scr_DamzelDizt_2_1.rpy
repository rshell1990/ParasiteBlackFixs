

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:2
translate es qst_DamzelDizzt_2_frontal_548b4fd9:

    # MARKUS "Feeling a little bloodthirsty today, aren't we?"
    MARKUS "Hoy estamos un poco sedientos de sangre, ¿no?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:3
translate es qst_DamzelDizzt_2_frontal_add1e9c7:

    # MARKUS "Fine, but we’ll have to be quick..."
    MARKUS "Está bien, pero tendremos que ser rápidos..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:4
translate es qst_DamzelDizzt_2_frontal_2972c58e:

    # MARKUS "The commotion will likely draw the attention of the guards and if they see us we’re in trouble..."
    MARKUS "La conmoción probablemente llamará la atención de los guardias y si nos ven estaremos en problemas..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:5
translate es qst_DamzelDizzt_2_frontal_7c9fd421:

    # NIJAH "Y-You intend to fight zem all?!"
    NIJAH "¡¿P-piensaz luchar contra todoz ellos?!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:6
translate es qst_DamzelDizzt_2_frontal_83589d81:

    # MC @ talk "I do."
    MC @ talk "Sí."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:7
translate es qst_DamzelDizzt_2_frontal_2c197c20:

    # NIJAH "But... You will die!"
    NIJAH "Pero... ¡Morirás!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:8
translate es qst_DamzelDizzt_2_frontal_8e039c33:

    # MC @ talk "Trust me Nijah, we will not be the ones dying tonight..."
    MC @ talk "Confía en mí Nijah, no seremos nosotros los que muramos esta noche..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:9
translate es qst_DamzelDizzt_2_frontal_881ada47:

    # MC @ talk "But the guards are a problem Markus, you're right."
    MC @ talk "Pero los guardias son un problema Markus, tienes razón."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:10
translate es qst_DamzelDizzt_2_frontal_c645d33e:

    # MARKUS "We should scout the place out first at night, before anything."
    MARKUS "Deberíamos explorar el lugar por la noche, antes de nada."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:11
translate es qst_DamzelDizzt_2_frontal_c54d1155:

    # MARKUS "At least try get some kind of understanding of what we're up against..."
    MARKUS "Al menos intentar entender a qué nos enfrentamos..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:12
translate es qst_DamzelDizzt_2_frontal_34a71376:

    # MC @ talk "That's a good idea."
    MC @ talk "Es una buena idea."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:13
translate es qst_DamzelDizzt_2_frontal_b47005bb:

    # MARKUS "Meet me in the Pleasure District tonight, we'll do some scouting from there."
    MARKUS "Reúnete conmigo en el distrito del placer esta noche, haremos algo de exploración desde allí."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:14
translate es qst_DamzelDizzt_2_frontal_d4f4b8d8:

    # NIJAH "I come."
    NIJAH "Yo voy."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:15
translate es qst_DamzelDizzt_2_frontal_e87bac32:

    # MC @ talk "It's too dangerous Nijah, if they see you with us they could try something."
    MC @ talk "Es demasiado peligroso Nijah, si te ven con nosotros podrían intentar algo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:16
translate es qst_DamzelDizzt_2_frontal_6d31a3ce:

    # NIJAH @ sad "But-"
    NIJAH @ sad "Pero-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:17
translate es qst_DamzelDizzt_2_frontal_cb4922bc:

    # MC @ talk "Can you handle a sword?"
    MC @ talk "¿Sabes manejar una espada?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:18
translate es qst_DamzelDizzt_2_frontal_a6530312:

    # NIJAH "I... No."
    NIJAH "Yo... No."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:19
translate es qst_DamzelDizzt_2_frontal_b11ddb34:

    # MC @ talk "If they catch us Nijah, we might not be able to protect you."
    MC @ talk "Si nos atrapan Nijah, puede que no seamos capaces de protegerte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:20
translate es qst_DamzelDizzt_2_frontal_f0d24a92:

    # MC @ talk "It's too dangerous..."
    MC @ talk "Es demasiado peligroso..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:21
translate es qst_DamzelDizzt_2_frontal_849a9251:

    # "Nijah looked like she might say something at first, but instead she bite her lip and nodded reluctantly."
    "Nijah parecía que iba a decir algo al principio, pero en lugar de eso se mordió el labio y asintió de mala gana."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:22
translate es qst_DamzelDizzt_2_frontal_83dc5d60:

    # NIJAH "Y-Yes, I stay."
    NIJAH "S-sí, me quedo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:23
translate es qst_DamzelDizzt_2_frontal_9d5a99fb:

    # MC @ talk "We'll be back shortly, promise."
    MC @ talk "Volveremos pronto, lo prometo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:24
translate es qst_DamzelDizzt_2_frontal_2c1af5ac:

    # NIJAH "A-Alright..."
    NIJAH "D-se acuerdo..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:37
translate es qst_DamzelDizzt_2_ScoutDiamond_e64bc50d:

    # MARKUS "There you are."
    MARKUS "Aquí estás."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:38
translate es qst_DamzelDizzt_2_ScoutDiamond_5df5f812:

    # MARKUS "Are you ready for this?"
    MARKUS "¿Estás preparado para esto?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:115
translate es qst_DamzelDizzt_2_ScoutDiamond_cbd1dccc:

    # MARKUS "Don't be too long."
    MARKUS "No tardes demasiado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:41
translate es qst_DamzelDizzt_2_ScoutDiamond_b3e0fd21:

    # MARKUS "Alright, let's head up onto some of these rooftops and scout out the perimeter."
    MARKUS "Muy bien, vamos a subirmos a algunos de estos tejados y explorar el perímetro."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:50
translate es qst_DamzelDizzt_2_ScoutDiamond_9e409d08:

    # MC @ talk "Sounds like a plan."
    MC @ talk "Parece un buen plan."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:54
translate es qst_DamzelDizzt_2_ScoutDiamond_0ccccc57:

    # "Clambering onto the rooftops, we moved our way as silently as we could and watched from afar."
    "Trepando por los tejados, nos abrimos paso tan silenciosamente como pudimos y observamos desde lejos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:55
translate es qst_DamzelDizzt_2_ScoutDiamond_98aa6d51:

    # "Here and there the odd guards, always in twos, would patrol around the boundaries of the Black Diamond, while another two always stayed at the Entrance."
    "Aquí y allá los guardias ocasionales, siempre de dos en dos, patrullaban alrededor de los límites del Diamante negro, mientras que otros dos permanecían siempre en la entrada."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:56
translate es qst_DamzelDizzt_2_ScoutDiamond_b8cf3b79:

    # "From inside, I focused and could hear a few dozen heart beats, but it was impossible to tell the difference between the clients, girls and guards."
    "Desde dentro, me concentré y pude oír unas cuantas docenas de latidos, pero era imposible distinguir entre los clientes, las chicas y los guardias."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:57
translate es qst_DamzelDizzt_2_ScoutDiamond_b484682b:

    # "After some time we decided to take a closer look."
    "Al cabo de un rato, decidimos echar un vistazo más de cerca."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:50
translate es qst_DamzelDizzt_2_ScoutDiamond_6f33ab64:

    # "Climbing in through one of the windows, we watched and looked down from the rafters concealed in darkness... Seeing the Black Diamond below."
    "Trepando por una de las ventanas, observamos y miramos desde las vigas ocultos en la oscuridad... Viendo el Diamante negro abajo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:66
translate es qst_DamzelDizzt_2_ScoutDiamond_18b3f7b5:

    # MC "(Can you hear me?)"
    MC "(¿Puedes oírme?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:67
translate es qst_DamzelDizzt_2_ScoutDiamond_ff3583df:

    # MARKUS "(Yes, now quit shouting!)"
    MARKUS "(¡Sí, ahora deja de gritar!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:68
translate es qst_DamzelDizzt_2_ScoutDiamond_3681b84f:

    # MC "(I'm not shouting! I'm just not used to talking with my mouth shut!)"
    MC "(¡No estoy gritando! ¡No estoy acostumbrado a hablar con la boca cerrada!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:69
translate es qst_DamzelDizzt_2_ScoutDiamond_8c1d2014:

    # MARKUS "(Bah! Focus! How many guards can you see?)"
    MARKUS "(¡Bah! ¡Concéntrate! ¿Cuántos guardias puedes ver?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:70
translate es qst_DamzelDizzt_2_ScoutDiamond_e9934e8c:

    # "Through the darkness I peered around, my vision once I focused in, was able to make out through these strange red like outlines where people stood even in pitch black corners."
    "A través de la oscuridad miré a mi alrededor, mi visión, una vez enfocada, era capaz de distinguir a través de esos extraños contornos rojos dónde se encontraba la gente, incluso en los rincones más oscuros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:71
translate es qst_DamzelDizzt_2_ScoutDiamond_d6466b18:

    # MC "(...I count fourteen here.)"
    MC "(...Cuento catorce aquí)."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:72
translate es qst_DamzelDizzt_2_ScoutDiamond_60823c7e:

    # MARKUS "(There is probably more upstairs.)"
    MARKUS "(Probablemente haya más arriba)."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:73
translate es qst_DamzelDizzt_2_ScoutDiamond_d8176576:

    # MC "(Don't suppose you two have anything to say.)"
    MC "(Supongo que no tenéis nada que decir)."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:74
translate es qst_DamzelDizzt_2_ScoutDiamond_3abf4d2e:

    # BLACK "{i}(Something beneath feet...){/i}"
    BLACK "{i}(Algo bajo los pies...){/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:75
translate es qst_DamzelDizzt_2_ScoutDiamond_d916bdad:

    # BLACK "{i}(Can hear it... rumbling.){/i}"
    BLACK "{i}(Puedo oírlo... retumbar).{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:76
translate es qst_DamzelDizzt_2_ScoutDiamond_411aa358:

    # WHITE "{i}(Cautious... More danger than appears.){/i}"
    WHITE "{i}(Precaución... Más peligro del que parece).{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:77
translate es qst_DamzelDizzt_2_ScoutDiamond_4cb5d00d:

    # MARKUS "(Well, what is it?)"
    MARKUS "(Bueno, ¿qué es?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:78
translate es qst_DamzelDizzt_2_ScoutDiamond_cae525a0:

    # MARKUS "(...Hello? HELLO!)"
    MARKUS "(...¿Hola? ¡HOLA!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:79
translate es qst_DamzelDizzt_2_ScoutDiamond_9fd7c1db:

    # MARKUS "(Fucking hells! Why do they just stop talking like that?)"
    MARKUS "(¡Joder! ¿Por qué simplemente dejan de hablar así?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:80
translate es qst_DamzelDizzt_2_ScoutDiamond_259dbccd:

    # MC "(We should go Markus, before someone notices us here.)"
    MC "(Deberíamos irnos Markus, antes de que alguien nos vea aquí)."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:81
translate es qst_DamzelDizzt_2_ScoutDiamond_69dbec03:

    # MARKUS "(Yes, we should-)"
    MARKUS "(Sí, deberíamos-)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:82
translate es qst_DamzelDizzt_2_ScoutDiamond_d3d687e0:

    # MARKUS "(Hold on, that one... Is that our man?)"
    MARKUS "(Espera, ese... ¿Ese es nuestro hombre?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:83
translate es qst_DamzelDizzt_2_ScoutDiamond_57d0ba51:

    # "We watched as the one bandit strolled his way into the Black Diamond, he looked different than the others, and four bandit guards walked protectively alongside him."
    "Observamos cómo un bandido se adentraba en el Diamante negro, con un aspecto diferente al de los demás, y cuatro guardias bandidos caminaban a su lado de forma protectora."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:84
translate es qst_DamzelDizzt_2_ScoutDiamond_f21f5bbd:

    # "As he entered, all eyes seemed to turn towards him, and one of the bandits moved out to greet him."
    "Al entrar, todas las miradas parecieron dirigirse hacia él, y uno de los bandidos salió a recibirle."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:86
translate es qst_DamzelDizzt_2_ScoutDiamond_2c87a044:

    # BANDIT "Great Khan, I am here to deliver your tribute from your vassals."
    BANDIT "Gran Khan, estoy aquí para entregarle el tributo de sus vasallos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:96
translate es qst_DamzelDizzt_2_ScoutDiamond_01329b9a:

    # TAREK "And who pays me greatest tribute today?"
    TAREK "¿Y quién me rinde hoy el mayor tributo?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:88
translate es qst_DamzelDizzt_2_ScoutDiamond_9fe53e57:

    # BANDIT "...The khazahs my khan."
    BANDIT "...Los khazahs mi khan."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:98
translate es qst_DamzelDizzt_2_ScoutDiamond_086a66c9:

    # TAREK "The Khazahs... {i}again?{/i}"
    TAREK "¿Los khazahs... {i}otra vez?{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:99
translate es qst_DamzelDizzt_2_ScoutDiamond_420bfaae:

    # TAREK @ angry "Should I always expect the Vulshans to fall behind everytime now?"
    TAREK @ angry "¿Debo esperar siempre que los vulshans se queden atrás?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:91
translate es qst_DamzelDizzt_2_ScoutDiamond_2ca400bc:

    # BANDIT "We are pushing our men as hard as we can!"
    BANDIT "¡Estamos presionando a nuestros hombres todo lo que podemos!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:92
translate es qst_DamzelDizzt_2_ScoutDiamond_f02ad6a1:

    # BANDIT "But with your restrictions, things are... {i}difficult.{/i}"
    BANDIT "Pero con tus restricciones, las cosas son... {i}difíciles.{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:102
translate es qst_DamzelDizzt_2_ScoutDiamond_f27624bd:

    # TAREK "My rules are in place to protect all of us."
    TAREK "Mis reglas están para protegernos a todos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:103
translate es qst_DamzelDizzt_2_ScoutDiamond_209850d6:

    # TAREK @ angry "But I don't see the Khazahs complaining about them."
    TAREK @ angry "Pero no veo que los khazahs se quejen de ellas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:95
translate es qst_DamzelDizzt_2_ScoutDiamond_91981a6f:

    # BANDIT "...Of course Great Khan, we will do better next time."
    BANDIT "...Por supuesto gran Khan, lo haremos mejor la próxima vez."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:105
translate es qst_DamzelDizzt_2_ScoutDiamond_234ae860:

    # TAREK "See it done."
    TAREK "Que así sea."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:112
translate es qst_DamzelDizzt_2_ScoutDiamond_76b5605d:

    # "As Tarek marched off, I could sense the furious rage brewing inside the man he just spoke to."
    "Mientras Tarek se marchaba, pude sentir la furia que se estaba gestando en el interior del hombre con el que acababa de hablar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:113
translate es qst_DamzelDizzt_2_ScoutDiamond_7ec425d1:

    # "If I didn't know any better, one would think he wanted to {i}kill{/i} Tarek."
    "Si no supiera lo contrario, uno pensaría que quería matar {i}matar{/i} a Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:118
translate es qst_DamzelDizzt_2_ScoutDiamond_25a5b2ae:

    # MC "(I've seen enough, come on, before we are seen...)"
    MC "(Ya he visto suficiente, vamos, antes de que nos vean...)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:134
translate es qst_DamzelDizzt_2_frontal_return_b20d2376:

    # NIJAH "You're back!"
    NIJAH "¡Has vuelto!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:135
translate es qst_DamzelDizzt_2_frontal_return_42308e1f:

    # MC @ talk "We scouted the place out, it's heavily guarded but we think we can take it."
    MC @ talk "Exploramos el lugar, está fuertemente protegido, pero creemos que podemos hacerlo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:118
translate es qst_DamzelDizzt_2_frontal_return_285a3d90:

    # MARKUS "I'm not sure about this [player_name!t]... You heard what... uh... 'our friends' told us, there's something more dangerous lurking there."
    MARKUS "No estoy seguro sobre esto [player_name!t]... Ya oíste lo que... eh... 'nuestros amigos' nos dijeron, hay algo más peligroso acechando allí."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:132
translate es qst_DamzelDizzt_2_frontal_return_0e20432e:

    # MARKUS "And that amount of guards is nothing to laugh at!"
    MARKUS "¡Y esa cantidad de guardias no es para reírse!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:138
translate es qst_DamzelDizzt_2_frontal_return_459c414c:

    # MC @ talk "We'll need to be prepared for it..."
    MC @ talk "Tendremos que estar preparados para ello..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:139
translate es qst_DamzelDizzt_2_frontal_return_5505452a:

    # "Nijah seemed to ponder our words for a moment, before her eyes seemed to light up."
    "Nijah pareció meditar nuestras palabras un instante, antes de que sus ojos parecieran iluminarse."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:140
translate es qst_DamzelDizzt_2_frontal_return_77bed641:

    # NIJAH "... I haz idea."
    NIJAH "... Tengo una idea."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:141
translate es qst_DamzelDizzt_2_frontal_return_f4c64746:

