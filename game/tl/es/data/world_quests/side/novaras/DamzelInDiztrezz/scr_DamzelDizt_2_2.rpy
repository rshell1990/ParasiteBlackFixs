

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:16
translate es qst_DamzelDizzt_2_frontal_postScout_bd44b73f:

    # "We clambered onto a rooftop of a building near the Black Diamond as soon as night fell across Novaras."
    "Subimos a la azotea de un edificio cercano al Diamante negro en cuanto cayó la noche sobre Novaras."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:17
translate es qst_DamzelDizzt_2_frontal_postScout_165aa9d8:

    # "Both me and Markus waited in position in our {i}‘other’{/i} forms as we listened out for the loud whizzing sounds of the fire sticks."
    "Markus y yo esperábamos en posición en nuestras {i}‘otras’{/i} formas mientras escuchábamos los fuertes zumbidos de los palos de fuego."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:18
translate es qst_DamzelDizzt_2_frontal_postScout_cc2f6184:

    # "Explosions loudly began to boom as they began blossoming into pretty color patterns, lighting up the night sky."
    "Las explosiones empezaron a sonar con fuerza mientras comenzaban a florecer en bonitos patrones de colores, iluminando el cielo nocturno."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:20
translate es qst_DamzelDizzt_2_frontal_postScout_475abc9b:

    # MC "Looks like Nijah came through..."
    MC "Parece que Nijah cumplió..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:21
translate es qst_DamzelDizzt_2_frontal_postScout_c5bd6c6c:

    # "Markus turned to me and nodded."
    "Markus se giró hacia mí y asintió."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:26
translate es qst_DamzelDizzt_2_frontal_postScout_8e0c6225:

    # "Clambering down, we moved swiftly over towards the doors of the Black Diamond, and together,"
    "Al bajar, nos dirigimos rápidamente hacia las puertas del Diamante negro, y juntos,"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:27
translate es qst_DamzelDizzt_2_frontal_postScout_c515447b:

    # "We wasted no time bashing our way through inside."
    "no perdimos tiempo abriéndonos paso por el interior."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:31
translate es qst_DamzelDizzt_2_frontal_postScout_0e6f8a15:

    # "Screams and shouts erupted as half naked dancers fled for the nearest exits."
    "Gritos y chillidos estallaron mientras las bailarinas semidesnudas huían hacia la salida más cercana."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:32
translate es qst_DamzelDizzt_2_frontal_postScout_21020f3b:

    # "Tables filled with coin and cards were flipped as the guards drew their sabres onto us in a frenzied panic, shouting to each other about monsters."
    "Mesas llenas de monedas y cartas fueron lanzadas al aire mientras los guardias desenvainaban sus sables sobre nosotros en un frenético pánico, gritándose unos a otros sobre monstruos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:33
translate es qst_DamzelDizzt_2_frontal_postScout_7500ee8a:

    # "Those in the drug induced haze of the opium turn to look at us from their beds with confusion in their eyes,"
    "Los que están en la neblina inducida por el opio se vuelven para mirarnos desde sus camas con confusión en los ojos,"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:34
translate es qst_DamzelDizzt_2_frontal_postScout_a96ead46:

    # "Unsure if what they saw were seeing was some illusion from chasing the dragon."
    "sin saber si lo que veían era alguna ilusión por perseguir al dragón."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:38
translate es qst_DamzelDizzt_2_frontal_postScout_a09cd1e4:

    # BANDIT @ talk "Monsters! MONSTERS! Kill them! Kill them now!"
    BANDIT @ talk "¡Monstruos! ¡MONSTRUOS! ¡Matadlos! ¡Matadlos ya!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:38
translate es qst_DamzelDizzt_2_frontal_postScout_2310b5cd:

    # MC "(We don't have long! We have to finish this before the guards arrive!)"
    MC "(¡No tenemos mucho tiempo! ¡Tenemos que terminar esto antes de que lleguen los guardias!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:47
translate es qst_DamzelDizzt_2_frontal_postScout_2d761257:

    # MC "{i}*Huff* *Huff*{/i}"
    MC "{i}*Uff* *Uff*{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:48
translate es qst_DamzelDizzt_2_frontal_postScout_71883944:

    # MC "(Hell, there's more!)"
    MC "(Demonios, ¡hay más!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:55
translate es qst_DamzelDizzt_2_frontal_postScout_1ff369e4:

    # "The Black Diamond became a fury of red mist and screams as the two of us cut down man after man as they came for us."
    "El Diamante negro se convirtió en una furia de niebla roja y gritos mientras los dos abatíamos hombre tras hombre a medida que venían a por nosotros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:56
translate es qst_DamzelDizzt_2_frontal_postScout_b7c99f9e:

    # "Limb from limb we tore and slashed, the walls painted in long streaks of red blood as the adrenaline coursed through me."
    "Desgarramos y acuchillamos miembro a miembro, y las paredes se pintaron con largos regueros de sangre roja mientras la adrenalina corría por mi interior."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:57
translate es qst_DamzelDizzt_2_frontal_postScout_4cd980b2:

    # "I could hardly control myself anymore, the dark impulses inside of me seemed to steer my every move as my claws stained with blood dripped onto the cold floor."
    "Ya casi no podía controlarme, los oscuros impulsos de mi interior parecían dirigir cada uno de mis movimientos mientras mis garras manchadas de sangre goteaban sobre el frío suelo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:58
translate es qst_DamzelDizzt_2_frontal_postScout_91a51787:

    # "Fear, panic, {i}fury{/i} the emotions run a gauntlet as we turned the place into a kind of nightmare scarely read about only in the darkest of tales."
    "Miedo, pánico, {i}furia{/i} las emociones corrían a raudales mientras convertimos el lugar en una especie de pesadilla de las que solo se leen en los cuentos más oscuros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:59
translate es qst_DamzelDizzt_2_frontal_postScout_e2568e7e:

    # "Finally, I heard a whistle and twisted my body to look towards the sound."
    "Finalmente, oí un silbido y giré el cuerpo para mirar hacia el sonido."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:68
translate es qst_DamzelDizzt_2_frontal_postScout_27b9fc48:

    # TAREK @ angry "So... The inquisitors have finally made their move I see."
    TAREK @ angry "Así que... los inquisidores finalmente han hecho su movimiento, por lo que veo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:69
translate es qst_DamzelDizzt_2_frontal_postScout_fe3619a2:

    # TAREK @ angry "And they send monsters to slay me!"
    TAREK @ angry "¡Y envían monstruos para matarme!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:70
translate es qst_DamzelDizzt_2_frontal_postScout_a98c6e63:

    # "I growled and began to step towards Tarek as he drew his blade."
    "Gruñí y empecé a acercarme a Tarek mientras desenvainaba su espada."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:71
translate es qst_DamzelDizzt_2_frontal_postScout_726f617c:

    # "Markus followed behind as we snarled towards him, ready to leap forward and slash and tear him to pieces!"
    "Markus me siguió mientras gruñíamos hacia él, ¡listos para saltar hacia delante y acuchillarlo y despedazarlo!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:72
translate es qst_DamzelDizzt_2_frontal_postScout_59da8ec9:

    # TAREK @ angry "NOW!"
    TAREK @ angry "¡AHORA!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:74
translate es qst_DamzelDizzt_2_frontal_postScout_00407283:

    # "Suddenly, from the upper floors poured out more men to surround us, and beneath us we felt the floor open up and swallow us whole."
    "De repente, de los pisos superiores salieron más hombres para rodearnos, y debajo de nosotros sentimos que el suelo se abría y nos tragaba enteros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:75
translate es qst_DamzelDizzt_2_frontal_postScout_362c82ca:

    # "I tried to use my tentacles to grip into the walls, but they coated in a thick black like slime that I couldn't get any grip into."
    "Intenté usar mis tentáculos para agarrarme a las paredes, pero estaban cubiertas de una baba espesa y negra a la que no podía agarrarme."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:76
translate es qst_DamzelDizzt_2_frontal_postScout_55413c12:

    # "Markus tried to fly upwards but I collided against him, sending us tumbling down in freefall."
    "Markus intentó volar hacia arriba, pero yo choqué contra él, haciéndonos caer en caída libre."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:77
translate es qst_DamzelDizzt_2_frontal_postScout_c680916b:

    # "Faling deep into the darkness, we finally slammed into the concrete ground below."
    "Nos adentramos en la oscuridad y finalmente nos estrellamos contra el suelo de hormigón."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:78
translate es qst_DamzelDizzt_2_frontal_postScout_e3195a34:

    # "Slightly dazed, I rose from my feet to see we had fallen into some section of the sewers below."
    "Ligeramente aturdido, me levanté para ver que habíamos caído en alguna sección de las alcantarillas de abajo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:87
translate es qst_DamzelDizzt_2_frontal_postScout_f1a3637e:

    # "Looking up towards the opening of the trap door above us, I could hear Tarek's men laugh as he crouched down over the hole to torment us."
    "Mirando hacia la abertura de la trampilla sobre nosotros, pude oír las risas de los hombres de Tarek mientras se agachaba sobre el agujero para atormentarnos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:88
translate es qst_DamzelDizzt_2_frontal_postScout_d1826011:

    # TAREK @ smile "I know not what beasts you are, but did you truly think you could just walk in here and kill me?"
    TAREK @ smile "No sé qué bestias sois, pero ¿de verdad creíais que podíais entrar aquí y matarme sin más?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:89
translate es qst_DamzelDizzt_2_frontal_postScout_f0582794:

    # "From the darkness I could hear feet loudly scuttering towards us."
    "Desde la oscuridad pude oír unos pies que se dirigían hacia nosotros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:90
translate es qst_DamzelDizzt_2_frontal_postScout_4a46adb2:

    # TAREK @ smile "Took us weeks to capture her, they've been turning up all over the Valley of Death recently."
    TAREK @ smile "Tardamos semanas en capturarla, últimamente han aparecido por todo el Valle de la Muerte."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:91
translate es qst_DamzelDizzt_2_frontal_postScout_ab641191:

    # TAREK "Took out a few of our best to take her in, but I think it was worth it in the end!"
    TAREK "Nos costó unos cuantos de los mejores para llevarla, ¡pero creo que al final mereció la pena!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:90
translate es qst_DamzelDizzt_2_frontal_postScout_e0635590:

    # MARKUS "(Fuck! [player_name!t]! What do we do?)"
    MARKUS "(¡Joder! [player_name!t]! ¿Qué hacemos?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:93
translate es qst_DamzelDizzt_2_frontal_postScout_19d411bc:

    # MC "(Shit! He can't mean-)"
    MC "(¡Mierda! No puede querer decir-)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:94
translate es qst_DamzelDizzt_2_frontal_postScout_ee2a11b8:

    # TAREK "Ever heard of Choza? Its like the opposite to Raza... They used to give it to Ramonian warriors before battle, make sure they would fucking slaughter anything in their path."
    TAREK "¿Has oído hablar de choza? Es como lo opuesto a raza... Solían dársela a los guerreros ramonianos antes de la batalla, para asegurarse de que masacrarían todo lo que se interpusiera en su camino."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:95
translate es qst_DamzelDizzt_2_frontal_postScout_cc6d58e8:

    # TAREK "They stopped using it when the men went insane."
    TAREK "Dejaron de usarlo cuando los hombres se volvieron locos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:96
translate es qst_DamzelDizzt_2_frontal_postScout_dba6500a:

    # TAREK @ smile "So we figured, {i}'why not feed it some of that with every meal?'{/i}"
    TAREK @ smile "Así que pensamos, {i}'¿por qué no darle algo de eso en cada comida?'{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:96
translate es qst_DamzelDizzt_2_frontal_postScout_9e57c03d:

    # UNKNOWN "{i}*Clatter! Clatter! Clatter!*{/i}"
    UNKNOWN "{i}*¡Traqueteo! Traqueteo! Traqueteo!*{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:99
translate es qst_DamzelDizzt_2_frontal_postScout_146ba5db:

    # "In that moment, from the darkness it appears, snapping it's claws as it scurried out from the darkness."
    "En ese momento, de la oscuridad aparece, chasqueando sus garras mientras se escabulle de la oscuridad."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:101
translate es qst_DamzelDizzt_2_frontal_postScout_02c3f02a:

    # TAREK @ angry "Dinner time Betsy!"
    TAREK @ angry "¡Hora de cenar, Betsy!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_2.rpy:103
translate es qst_DamzelDizzt_2_frontal_postScout_a70c5cab:

    # MC "(FUCK!)"
    MC "(¡JODER!)"
