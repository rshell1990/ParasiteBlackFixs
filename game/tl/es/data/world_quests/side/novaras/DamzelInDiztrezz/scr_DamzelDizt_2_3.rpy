

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:12
translate es qst_DamzelDizzt_2_frontal_pit_ce1082b8:

    # "The thing managed to grab me into one of its claws and began to tighten its clasp around me, with all my strength, I struggled to hold back as the things blade like claws tightened to sever me."
    "La cosa se las arregló para agarrarme con una de sus garras y comenzó a apretar su garra a mi alrededor, con todas mis fuerzas, luché por contenerme mientras las garras como cuchillas de la cosa se apretaban para cortarme."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:13
translate es qst_DamzelDizzt_2_frontal_pit_050b008a:

    # "From above, I could hear the men cheering and shouting, the sounds of coins dropping on the floor as they bet on which of us 'Betsy' would kill first."
    "Desde arriba, podía oír a los hombres animando y gritando, el sonido de las monedas cayendo al suelo mientras apostaban a quién de nosotros mataría primero 'Betsy'."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:14
translate es qst_DamzelDizzt_2_frontal_pit_529f2ec7:

    # TAREK @ angry "Finish them! FINISH THEM NOW!"
    TAREK @ angry "¡Terminalos! ¡TERMINALOS AHORA!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:15
translate es qst_DamzelDizzt_2_frontal_pit_b4bfaf67:

    # MC "(Shit! I can't hold on much longer! This thing is too-)"
    MC "¡Mierda! ¡No puedo aguantar mucho más! Esta cosa es demasiado-)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:16
translate es qst_DamzelDizzt_2_frontal_pit_929aec3b:

    # "Suddenly, Markus charged into the beast, knocking it off balance enough to let me go."
    "De repente, Markus cargó contra la bestia, desequilibrándola lo suficiente como para dejarme ir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:17
translate es qst_DamzelDizzt_2_frontal_pit_cfec4e7a:

    # MARKUS "(NOW [player_name!t]! WHILE I HAVE IT DISTRACTED!)"
    MARKUS "(¡AHORA [player_name!t]! ¡MIENTRAS LO TENGO DISTRAÍDO!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:18
translate es qst_DamzelDizzt_2_frontal_pit_377aa7f5:

    # "Leaping onto the thing, I raised my claws which seemed to glimmer from the only rays of light from the opening above."
    "Saltando sobre la cosa, levanté mis garras, que parecían brillar con los únicos rayos de luz que provenían de la abertura de arriba."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:19
translate es qst_DamzelDizzt_2_frontal_pit_d83296f8:

    # "Dealing the death blow, I shoved my claws through the things soft eyes and pierced through into its brain, causing the beast to sway before crashing down onto the ground dead."
    "Al asestarle el golpe mortal, clavé mis garras en los ojos blandos de la criatura y penetré en su cerebro, haciendo que la bestia se tambaleara antes de caer al suelo muerta."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:20
translate es qst_DamzelDizzt_2_frontal_pit_a1aeea54:

    # "The laughter and cheers stopped, realization dawning on them as murmurs quickly turned to growing panic and confusion."
    "Las risas y los vítores cesaron y  los murmullos se convertían rápidamente en pánico y confusión."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:21
translate es qst_DamzelDizzt_2_frontal_pit_59348397:

    # MC "(Fuck... That was too close.)"
    MC "(Joder... Eso estuvo demasiado cerca)."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:25
translate es qst_DamzelDizzt_2_frontal_pit_695064c9:

    # TAREK angry "..."
    TAREK angry "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:26
translate es qst_DamzelDizzt_2_frontal_pit_b2ae9b90:

    # NIJAH sad "..!"
    NIJAH sad "¡..!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:27
translate es qst_DamzelDizzt_2_frontal_pit_89230d09:

    # NIJAH @ sad "L-Let me go!"
    NIJAH @ sad "¡D-déjame ir!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:28
translate es qst_DamzelDizzt_2_frontal_pit_a15f1c16:

    # TAREK @ angry "Quiet you!"
    TAREK @ angry "¡Silencio!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:29
translate es qst_DamzelDizzt_2_frontal_pit_6c46be44:

    # TAREK @ angry "What are you waiting for fools?! Close the fucking door!"
    TAREK @ angry "¡¿Qué están esperando idiotas?! ¡Cerrad la puta puerta!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:30
translate es qst_DamzelDizzt_2_frontal_pit_49236bcb:

    # "We heard the cogs twisting as the trap door began to close above us, the rays of light slowly dissipating."
    "Oímos cómo se retorcían los engranajes mientras la trampilla empezaba a cerrarse sobre nosotros y los rayos de luz se disipaban lentamente."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:38
translate es qst_DamzelDizzt_2_frontal_pit_21d909a5:

    # MARKUS "([player_name!t]! Hold on!)"
    MARKUS "(¡[player_name!t]!¡Sujétate!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:32
translate es qst_DamzelDizzt_2_frontal_pit_c7d945a5:

    # "Grabbing onto Markus, he sprung into the air, and riding on his wings we crashed through the door back onto the main floor!"
    "Agarrándome a Markus, saltó por los aires y, montados en sus alas, ¡atravesamos la puerta y volvimos a la planta principal!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:33
translate es qst_DamzelDizzt_2_frontal_pit_211eb4f0:

    # TAREK @ shock "K-Kill them you fools! KILL THEM!"
    TAREK @ shock "¡Mátenlos, tontos! ¡MATADLOS!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:34
translate es qst_DamzelDizzt_2_frontal_pit_91143c65:

    # "Many of the men simply dropped their blades and fled for the door."
    "Muchos de los hombres simplemente soltaron sus espadas y huyeron hacia la puerta."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:35
translate es qst_DamzelDizzt_2_frontal_pit_dbbae3b2:

    # TAREK @ angry "Where are you all going?! COWARDS!"
    TAREK @ angry "¡¿A dónde vais todos?! ¡COBARDES!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:36
translate es qst_DamzelDizzt_2_frontal_pit_99aba722:

    # "With most of his men fled, only his most loyal guard remained."
    "Con la mayoría de sus hombres huidos, solo quedaba su guardia más leal."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:37
translate es qst_DamzelDizzt_2_frontal_pit_bcd09d10:

    # "Suddenly, the doors burst open as Nijah hurried inside."
    "De repente, las puertas se abrieron de golpe y Nijah se apresuró a entrar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:25
translate es qst_DamzelDizzt_2_frontal_pit_61024576:

    # NIJAH "[player_name!t]! Markus! You must go! There is talk of mons-"
    NIJAH "¡[player_name!t]! ¡Markus! ¡Tenéis que iros! Se habla de mons-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:39
translate es qst_DamzelDizzt_2_frontal_pit_e674f026:

    # "Nijah's face turned pale white in horror when she saw us."
    "La cara de Nijah se puso pálida de horror cuando nos vio."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:40
translate es qst_DamzelDizzt_2_frontal_pit_58b749c4:

    # "She froze, unable to move as her mouth trembled."
    "Se quedó paralizada, incapaz de moverse mientras le temblaba la boca."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:41
translate es qst_DamzelDizzt_2_frontal_pit_81a78d1b:

    # "Suddenly, while we were distracted, Tarek grabbed Nijah and pulled her towards him, blade at her throat."
    "De repente, mientras estábamos distraídos, Tarek agarró a Nijah y tiró de ella hacia él, con la espada en la garganta."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:43
translate es qst_DamzelDizzt_2_frontal_pit_5e6e8f74:

    # NIJAH "Let me go!"
    NIJAH "¡Suéltame!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:44
translate es qst_DamzelDizzt_2_frontal_pit_3364af6f:

    # MC "Nijah!"
    MC "¡Nijah!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:45
translate es qst_DamzelDizzt_2_frontal_pit_1e833b87:

    # TAREK @ angry "Ho ho! The beast speaks!"
    TAREK @ angry "¡Ho ho! ¡La bestia habla!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:47
translate es qst_DamzelDizzt_2_frontal_pit_81b9ed9e:

    # NIJAH "...[player_name!t]? You... You are..."
    NIJAH "...¿[player_name!t]? Tú... Tú eres..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:47
translate es qst_DamzelDizzt_2_frontal_pit_bbff233c:

    # TAREK @ angry "Enough!"
    TAREK @ angry "¡Suficiente!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:48
translate es qst_DamzelDizzt_2_frontal_pit_299b59b6:

    # TAREK "She matters to you, yes? I can see it in your hesitation!"
    TAREK "Ella te importa, ¿verdad? ¡Puedo verlo en tu vacilación!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:49
translate es qst_DamzelDizzt_2_frontal_pit_a2396845:

    # TAREK @ angry "Let me pass and leave this place and the girl is yours!"
    TAREK @ angry "¡Déjame pasar y abandonar este lugar y la chica será tuya!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:50
translate es qst_DamzelDizzt_2_frontal_pit_5edb8325:

    # TAREK @ smile "Otherwise... {i}I'll sever her throat here and now!{/i}"
    TAREK @ smile "De lo contrario... {i}¡Le cortaré la garganta aquí y ahora!{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:51
translate es qst_DamzelDizzt_2_frontal_pit_e8077f4c:

    # MC "Leave the girl Tarek, it's over."
    MC "Deja a la chica Tarek, se acabó."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:52
translate es qst_DamzelDizzt_2_frontal_pit_c13f4768:

    # MC "The guards will soon be storming the place after all this chaos, you won't make it out anyway."
    MC "Los guardias pronto asaltarán el lugar después de todo este caos, de todas formas no conseguirás salir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:53
translate es qst_DamzelDizzt_2_frontal_pit_6cfdc417:

    # TAREK @ angry "I will take my chances!"
    TAREK @ angry "¡Me arriesgaré!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:54
translate es qst_DamzelDizzt_2_frontal_pit_8bfd8b54:

    # TAREK @ angry "Now what will it be? Let me pass or not!"
    TAREK @ angry "¿Ahora qué será? ¡Dejarme pasar o no!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:55
translate es qst_DamzelDizzt_2_frontal_pit_dede2a4b:

    # MC "(Shit! Why do I say? If I'm not careful now, he could kill Nijah!)"
    MC "(¡Mierda! ¿Qué le digo? ¡Si no tengo cuidado ahora, podría matar a Nijah!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:56
translate es qst_DamzelDizzt_2_frontal_pit_936a1263:

    # MC "(But... What if Tarek somehow manages to escape? We've come this far, we need to finish this!)"
    MC "(Pero... ¿Qué pasa si Tarek de alguna manera se las arregla para escapar? ¡Hemos llegado hasta aquí, tenemos que terminar esto!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:59
translate es qst_DamzelDizzt_2_frontal_pit_8caaba94:

    # TAREK @ angry "Wrong answer!"
    TAREK @ angry "¡Respuesta equivocada!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:60
translate es qst_DamzelDizzt_2_frontal_pit_6b565f4c:

    # "I leapt forward to try and stop him, springing out one of my tentacles to whack the blade away but it was too late."
    "Salté hacia delante para intentar detenerlo, sacando uno de mis tentáculos para golpear la hoja, pero ya era demasiado tarde."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:64
translate es qst_DamzelDizzt_2_frontal_pit_db091ce8:

    # "Nijah screamed as the blade slide across her throat, a red line appearing that soon flowed red as she choked on her blood."
    "Nijah gritó cuando la hoja se deslizó por su garganta, apareciendo una línea roja que pronto fluyó roja mientras se ahogaba con su sangre."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:65
translate es qst_DamzelDizzt_2_frontal_pit_8596059b:

    # MC "NIJAH! NO!"
    MC "¡NIJAH! ¡NO!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:66
translate es qst_DamzelDizzt_2_frontal_pit_6211aede:

    # TAREK @ angry "You should have listened when you had the chance!"
    TAREK @ angry "¡Deberías haber escuchado cuando tuviste la oportunidad!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:70
translate es qst_DamzelDizzt_2_frontal_pit_0d9c1067:

    # TAREK "Come then, beasts!"
    TAREK "¡Vamos, bestias!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:71
translate es qst_DamzelDizzt_2_frontal_pit_c2c51790:

    # TAREK "Kill me if you can!"
    TAREK "¡Matadme si podéis!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:80
translate es qst_DamzelDizzt_2_frontal_pit_d295606c:

    # "Tarek's lifeless body fell to the floor, torn to shreds by tooth and claw as both me and Markus greedily began to rip apart and devour pieces of his flesh."
    "El cuerpo sin vida de Tarek cayó al suelo, destrozado por los dientes y las garras mientras Markus y yo empezábamos a desgarrar y devorar con avidez trozos de su carne."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:81
translate es qst_DamzelDizzt_2_frontal_pit_d5cfc95c:

    # "The parasites inside grumbled in appreciation as we lapped up the delicious red meat."
    "Los parásitos de nuestro interior gruñeron de agradecimiento mientras engullíamos la deliciosa carne roja."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:82
translate es qst_DamzelDizzt_2_frontal_pit_20808736:

    # "Slowly, I pried myself away from the bloodlust towards Nijah's body, holding her in both of my arms as she gasped for air..."
    "Lentamente, me alejé de la sed de sangre hacia el cuerpo de Nijah, sosteniéndola entre mis dos brazos mientras jadeaba en busca de aire..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:83
translate es qst_DamzelDizzt_2_frontal_pit_1321618a:

    # "As the adrenaline passed and the beast subsided, I felt this sickening feeling inside me, my stomach twisting in knots as I looked down at her ever paler face."
    "Cuando la adrenalina pasó y la bestia se calmó, sentí un náuseas dentro de mí, con el estómago hecho un nudo mientras miraba su rostro cada vez más pálido."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:84
translate es qst_DamzelDizzt_2_frontal_pit_9326cc1e:

    # "I felt myself begin to shake as something moved within me, tears beginning to form around my glassy eyes."
    "Sentí que empezaba a temblar cuando algo se movió dentro de mí, y se me llenaron los ojos de lágrimas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:85
translate es qst_DamzelDizzt_2_frontal_pit_238768ab:

    # "Gently, she raised a hand towards my face, carressing it before her hand went limp."
    "Suavemente, levantó una mano hacia mi cara, acariciándola antes de que su mano quedara flácida."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:90
translate es qst_DamzelDizzt_2_frontal_pit_c57fb469:

    # MC "I'm sorry... I'm so sorry... I didn't mean for this! This wasn't supposed to happen!"
    MC "Lo siento... Lo siento tanto... ¡No quise hacer esto! ¡Esto no tenía que pasar!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:91
translate es qst_DamzelDizzt_2_frontal_pit_44a0beba:

    # "I roared loudly into the air, shaking the very foundations of the building as Markus reached out to grab my shoulder."
    "Rugí con fuerza en el aire, haciendo temblar los cimientos del edificio, mientras Markus alargaba la mano para agarrarme del hombro."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:101
translate es qst_DamzelDizzt_2_frontal_pit_f049087c:

    # MARKUS "[player_name!t]! We must go!"
    MARKUS "¡[player_name!t]! ¡Tenemos que irnos!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:99
translate es qst_DamzelDizzt_2_frontal_pit_ba6c43de:

    # MARKUS "The guards are here!"
    MARKUS "¡Los guardias están aquí!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:100
translate es qst_DamzelDizzt_2_frontal_pit_715fab03:

    # "From outside, I could hear the footsteps of the guards rushing towards us, and only at Markus' further insistance did I pull away from her."
    "Desde fuera oía los pasos de los guardias que se acercaban a nosotros, y solo ante la insistencia de Markus me separé de ella."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:101
translate es qst_DamzelDizzt_2_frontal_pit_34e822c7:

    # MARKUS "(We must go! We must go now!)"
    MARKUS "(¡Tenemos que irnos! ¡Tenemos que irnos ahora!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:102
translate es qst_DamzelDizzt_2_frontal_pit_a99c644d:

    # "Climbing the rafters of the building and out one of the windows, we made our narrow escape into the darkness once again..."
    "Trepando por las vigas del edificio y saliendo por una de las ventanas, volvimos a escapar por los pelos hacia la oscuridad..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:114
translate es qst_DamzelDizzt_2_frontal_pit_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:116
translate es qst_DamzelDizzt_2_frontal_pit_5d0e274d:

    # MARKUS @ sad "[player_name!t]... It wasn't your fault, you tried-"
    MARKUS @ sad "[player_name!t]... INo fue tu culpa, intentaste-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:116
translate es qst_DamzelDizzt_2_frontal_pit_0046d964:

    # MC "Just go Markus... Please."
    MC "Solo vete Markus... Por favor."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:117
translate es qst_DamzelDizzt_2_frontal_pit_b3941898:

    # MARKUS @ sad "...I will make sure you are alright in the morning."
    MARKUS @ sad "...Me aseguraré de que estés bien por la mañana."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:121
translate es qst_DamzelDizzt_2_frontal_pit_d2ffaee4:

    # "I started to cry, slumping down onto my bed and curling up into a ball."
    "Empecé a llorar, me desplomé sobre la cama y me hice un ovillo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:122
translate es qst_DamzelDizzt_2_frontal_pit_50253c78:

    # "Reminded again of what it meant to lose another friend..."
    "Recordado de nuevo lo que significa perder a otra amiga..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:123
translate es qst_DamzelDizzt_2_frontal_pit_4ce3e43e:

    # MC @ sad "...Nijah... {i}Nijah...{/i}"
    MC @ sad "...Nijah... {i}Nijah...{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:144
translate es qst_DamzelDizzt_2_frontal_pit_930b773e:

    # TAREK "A wise decision..."
    TAREK "Una sabia decisión..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:145
translate es qst_DamzelDizzt_2_frontal_pit_8990d594:

    # "With his blade still at Nijah's throat, he shuffled towards the door."
    "Con su espada aún en la garganta de Nijah, se dirigió hacia la puerta."


# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:148
translate es qst_DamzelDizzt_2_frontal_pit_88e271ca:

    # MARKUS "This wont end well for you... The guards are already coming."
    MARKUS "Esto no terminará bien para ti... Los guardias ya están llegando."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:149
translate es qst_DamzelDizzt_2_frontal_pit_00629ac4:

    # MARKUS "Hurting her will achieve nothing!"
    MARKUS "¡Hacerle daño no conseguirá nada!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:150
translate es qst_DamzelDizzt_2_frontal_pit_b4cedb2d:

    # TAREK @ angry "The minute I hand over the bitch you two will tear me to shreds like the others!"
    TAREK @ angry "¡En cuanto os entregue a la perra me haréis pedazos como a los otros!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:152
translate es qst_DamzelDizzt_2_frontal_pit_7e571c48:

    # MC "Give us the girl and we wont!"
    MC "¡Danos a la chica y no lo haremos!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:153
translate es qst_DamzelDizzt_2_frontal_pit_55ba3b5c:

    # TAREK "You want her?"
    TAREK "¿La queréis?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:154
translate es qst_DamzelDizzt_2_frontal_pit_a4b79982:

    # "Suddenly, Tarek shoved Nijah forward before sharply booting her down the vast opening of the trap door."
    "De repente, Tarek empujó a Nijah hacia delante antes de lanzarla bruscamente por la inmensa abertura de la trampilla."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:155
translate es qst_DamzelDizzt_2_frontal_pit_f6da6320:

    # TAREK @ angry "HAVE HER!"
    TAREK @ angry "¡CÓGELA!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:157
translate es qst_DamzelDizzt_2_frontal_pit_f0603c3c:

    # "Nijah screamed as she began falling down the hole into darkness!"
    "¡Nijah gritó mientras empezaba a caer por el agujero hacia la oscuridad!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:158
translate es qst_DamzelDizzt_2_frontal_pit_51a437aa:

    # MC "{b}NIJAH!{/b}"
    MC "{b}¡NIJAH!{/b}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:159
translate es qst_DamzelDizzt_2_frontal_pit_fa1a36fa:

    # "I leapt down after her, falling into the darkness, the wind rushing past me as I reached out to grab her."
    "Salté tras ella y caí en la oscuridad, con el viento pasando a mi lado mientras intentaba atraparla."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:160
translate es qst_DamzelDizzt_2_frontal_pit_461467b4:

    # "With both hands I grabbed her, twisting onto my back as I launched the tentacles into the walls, making them drag for the final duration of the drop."
    "Con ambas manos la sujeté, girando sobre mi espalda mientras lanzaba los tentáculos contra las paredes, haciéndolos arrastrar durante la duración final de la caída."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:162
translate es qst_DamzelDizzt_2_frontal_pit_a1e4a0f9:

    # "Nijah continued to scream, but with enough force, I managed to slow us down enough to stop us slamming into the ground."
    "Nijah siguió gritando, pero con la fuerza suficiente, conseguí frenarnos lo suficiente como para evitar que nos estrelláramos contra el suelo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:163
translate es qst_DamzelDizzt_2_frontal_pit_67acbdb4:

    # "Gently, as I let Nijah go, she looked up to me."
    "Suavemente, cuando solté a Nijah, ella me miró."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:168
translate es qst_DamzelDizzt_2_frontal_pit_3f12d6b3:

    # NIJAH "[player_name!t]... You... Its..."
    NIJAH "[player_name!t]... Tú... Eres..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:169
translate es qst_DamzelDizzt_2_frontal_pit_ba65ce64:

    # MARKUS "[player_name!t]! Need some help here!"
    MARKUS "¡[player_name!t]! ¡Necesito un poco de ayuda!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:173
translate es qst_DamzelDizzt_2_frontal_pit_16010ede:

    # "I gently grabbed Nijah's shoulders, raspily telling her to wait here as I clambered my way frantically to the top once again."
    "Sujeté suavemente a Nijah por los hombros, diciéndole con voz ronca que esperara aquí mientras yo trepaba frenéticamente hacia la cima una vez más."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:174
translate es qst_DamzelDizzt_2_frontal_pit_24a9d5bc:

    # NIJAH "(...He saved me.)"
    NIJAH "(...Me ha salvado)."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:175
translate es qst_DamzelDizzt_2_frontal_pit_e8a28047:

    # NIJAH "{i}(...What is he?){/i}"
    NIJAH "{i}(...¿Qué es él?){/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:177
translate es qst_DamzelDizzt_2_frontal_pit_8582d8f7:

    # "Back on top, Tarek was frantically battling against Markus, rolling to dodge the blast of fire before swinging his blade wildy at Markus, cutting his arm."
    "De vuelta a la cima, Tarek luchaba frenéticamente contra Markus, rodando para esquivar la ráfaga de fuego antes de blandir su espada salvajemente contra Markus, cortándole el brazo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:178
translate es qst_DamzelDizzt_2_frontal_pit_7c1b7c7b:

    # MARKUS "*Growls!*"
    MARKUS "*¡Gruñidos!*"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:179
translate es qst_DamzelDizzt_2_frontal_pit_063e1e80:

    # TAREK @ angry "So, you beasts want to take me?"
    TAREK @ angry "Entonces, ¿bestias queréis acabar conmigo?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:180
translate es qst_DamzelDizzt_2_frontal_pit_588153f2:

    # TAREK @ angry "Come then, beasts!"
    TAREK @ angry "¡Venid, bestias!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:181
translate es qst_DamzelDizzt_2_frontal_pit_15e72c2b:

    # TAREK @ angry "Kill me if you can!"
    TAREK @ angry "¡Matadme si podéis!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:190
translate es qst_DamzelDizzt_2_frontal_pit_d295606c_1:

    # "Tarek's lifeless body fell to the floor, torn to shreds by tooth and claw as both me and Markus greedily began to rip apart and devour pieces of his flesh."
    "El cuerpo sin vida de Tarek cayó al suelo, despedazado por los dientes y las garras, mientras Markus y yo empezábamos a desgarrar y devorar con avidez trozos de su carne."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:191
translate es qst_DamzelDizzt_2_frontal_pit_d5cfc95c_1:

    # "The parasites inside grumbled in appreciation as we lapped up the delicious red meat."
    "Los parásitos de nuestro interior gruñeron de agradecimiento mientras engullíamos la deliciosa carne roja."


# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:194
translate es qst_DamzelDizzt_2_frontal_pit_db091db9:

    # "Finally, prying myself away from the delicious meat I shook Markus."
    "Finalmente, apartándome de la deliciosa carne, sacudí a Markus."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:202
translate es qst_DamzelDizzt_2_frontal_pit_ad85a452:

    # MC "Footsteps! The guards are coming!"
    MC "¡Pisadas! ¡Vienen los guardias!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:203
translate es qst_DamzelDizzt_2_frontal_pit_e7e801d2:

    # MARKUS "We must go! Now!"
    MARKUS "¡Debemos irnos! ¡Ahora mismo!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:204
translate es qst_DamzelDizzt_2_frontal_pit_4d4b4bfa:

    # MARKUS "...Just after one more bite."
    MARKUS "...Solo después de un bocado más."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:205
translate es qst_DamzelDizzt_2_frontal_pit_b516b0d3:

    # "I stopped Markus from indulging further."
    "Impedí que Markus siguiera dándose el gusto."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:206
translate es qst_DamzelDizzt_2_frontal_pit_2acd2fdb:

    # MC "Nijah! Bring her up quickly!"
    MC "¡Nijah! ¡Súbela rápido!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:207
translate es qst_DamzelDizzt_2_frontal_pit_0d48996a:

    # "Markus hissed in acknowledgement, leaping down into the darkness before returning with Nijah in his arms."
    "Markus siseó en señal de confirmación y saltó a la oscuridad antes de regresar con Nijah en brazos.."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:208
translate es qst_DamzelDizzt_2_frontal_pit_ab428283:

    # "Gently, he let her down as she stepped shakily towards me."
    "Con suavidad, la bajó mientras ella se acercaba temblorosamente a mí."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:209
translate es qst_DamzelDizzt_2_frontal_pit_7924aad4:

    # "Her terrified eyes frantically looking me up and down."
    "Sus ojos aterrorizados me miraban frenéticamente de arriba abajo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:210
translate es qst_DamzelDizzt_2_frontal_pit_902ac175:

    # "I heard her heart drumming as she rested her hands nervously onto my chest."
    "Oí el ritmo de su corazón mientras apoyaba nerviosamente las manos en mi pecho."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:213
translate es qst_DamzelDizzt_2_frontal_pit_97fa787e:

    # NIJAH "Zis is..."
    NIJAH "Erez..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:214
translate es qst_DamzelDizzt_2_frontal_pit_12820b82:

    # NIJAH "... {i}You?{/i}"
    NIJAH "...{i}¿Tú?{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:215
translate es qst_DamzelDizzt_2_frontal_pit_2e002345:

    # "I gently took her hands into mine."
    "Cogí suavemente sus manos entre las mías."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:216
translate es qst_DamzelDizzt_2_frontal_pit_2131a5b9:

    # MC @ talk "We don’t have time to explain, we have to leave now!"
    MC @ talk "No tenemos tiempo de explicarlo, ¡tenemos que irnos ya!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:217
translate es qst_DamzelDizzt_2_frontal_pit_d26bc007:

    # NIJAH "Y-Yes! Go now!"
    NIJAH "¡S-sí! ¡Vámonos ya!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:219
translate es qst_DamzelDizzt_2_frontal_pit_959a2cf7:

    # "In the distance, we could hear the shouts of the guards heading our way, and quickly clambered onto the rafters and then out the window with Nijah over my shoulder."
    "A lo lejos, oímos los gritos de los guardias que se dirigían hacia nosotros, y rápidamente trepamos a las vigas y luego salimos por la ventana con Nijah sobre mi hombro."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:220
translate es qst_DamzelDizzt_2_frontal_pit_6fd1bcef:

    # "The guards burst through moments later, horrified at the bloody scene before them but we were already gone."
    "Los guardias irrumpieron instantes después, horrorizados ante la sangrienta escena que tenían delante, pero ya nos habíamos ido."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:221
translate es qst_DamzelDizzt_2_frontal_pit_785e3aff:

    # "I heard a few trembling voices behind us muttering {i}by the gods... What could have done this?{/i}"
    "Oí unas voces temblorosas detrás de nosotros murmurando {i}por los dioses... ¿Qué pudo haber hecho esto?{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:222
translate es qst_DamzelDizzt_2_frontal_pit_7186b65b:

    # "But quickly, we were already traversing the rooftops of buildings where under the veil of darkness we crept out of the Pleasure District."
    "Pero rápidamente, ya estábamos atravesando los tejados de los edificios donde, bajo el velo de la oscuridad, nos escurrimos fuera del distrito del placer."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:223
translate es qst_DamzelDizzt_2_frontal_pit_13ddfc22:

    # "Somehow, we had pulled it off, and behind me down below, I could see more guards rushing towards the chaos below."
    "De alguna manera, lo habíamos conseguido, y detrás de mí, abajo, podía ver más guardias corriendo hacia el caos de abajo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:224
translate es qst_DamzelDizzt_2_frontal_pit_1dc7ee4b:

    # "And just like that, it was over, and we slipped away and vanished."
    "Y así, sin más, se acabó, nos escabullimos y desaparecimos."

