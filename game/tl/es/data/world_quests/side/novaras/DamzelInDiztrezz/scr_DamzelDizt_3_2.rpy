

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:2
translate es qst_DamzelDizzt_3_headToOffice_2a800512:

    # "Knocking on the iron door, a slider opened as two piercing eyes looked the other side."
    "Al llamar a la puerta de hierro, se abrió una corredera mientras dos ojos penetrantes miraban al otro lado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:4
translate es qst_DamzelDizzt_3_headToOffice_6037568e:

    # THUG @ talk "Password?"
    THUG @ talk "¿Contraseña?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:7
translate es qst_DamzelDizzt_3_headToOffice_4ba7c3dc:

    # "The slider closed, and I could hear the door unlock the other side before it swung open before us with the guard welcoming us in."
    "La corredera se cerró y pude oír cómo la puerta se desbloqueaba al otro lado antes de que se abriera ante nosotros con el guardia dándonos la bienvenida."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:12
translate es qst_DamzelDizzt_3_headToOffice_8ae48740:

    # THUG @ talk "What? No that isn't-"
    THUG @ talk "¿Cómo? No, esa no es-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:13
translate es qst_DamzelDizzt_3_headToOffice_9a11f6ca:

    # THUG @ talk "Gods! How does every moron keep forgetting the password?! It's one word!"
    THUG @ talk "¡Dioses! ¡¿Cómo es que todos los idiotas siguen olvidando la contraseña?! ¡Es una palabra!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:14
translate es qst_DamzelDizzt_3_headToOffice_ebbe29d7:

    # THUG @ talk "You know what? Just... Just go away, and when you come back, try again, okay?"
    THUG @ talk "¿Sabes qué? Solo... Solo vete, y cuando vuelvas, inténtalo de nuevo, ¿de acuerdo?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:15
translate es qst_DamzelDizzt_3_headToOffice_f84bcf96:

    # THUG @ talk "{i}*Mutters*{/i} Fucking idiots."
    THUG @ talk "{i}*Murmura*{/i} Malditos idiotas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:19
translate es qst_DamzelDizzt_3_headToOffice_62c4f711:

    # THUG @ talk "...That wasn't even close!"
    THUG @ talk "...¡Eso ni siquiera estuvo cerca!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:20
translate es qst_DamzelDizzt_3_headToOffice_cf303b3a:

    # THUG @ talk "Go away! Come back with the password before I run you through with my blade!"
    THUG @ talk "¡Vete de aquí! ¡Vuelve con la contraseña antes de que te atraviese con mi espada!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:25
translate es qst_DamzelDizzt_3_enterOffice_bcd34196:

    # "Descending the stairs, we finally arrived into the small, unwelcoming office of Tarek, where he sat behind a small desk filed with gold and an ornate skull on it."
    "Bajando las escaleras, llegamos finalmente al pequeño y nada acogedor despacho de Tarek, donde se sentaba tras un pequeño escritorio cubierto de oro con una calavera ornamentada."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:40
translate es qst_DamzelDizzt_3_enterOffice_59bd21c1:

    # "His eyes lit up and he grinned when he saw Nijah tailing behind us."
    "Se le iluminaron los ojos y sonrió cuando vio a Nijah detrás de nosotros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:41
translate es qst_DamzelDizzt_3_enterOffice_591a8bac:

    # TAREK "Nijah!"
    TAREK "¡Nijah!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:42
translate es qst_DamzelDizzt_3_enterOffice_7ffb5d3a:

    # TAREK "Iz so good to see you again!"
    TAREK "¡Ez tan bueno verte de nuevo!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:43
translate es qst_DamzelDizzt_3_enterOffice_3ba5cb1e:

    # NIJAH "... I cannot say zer same."
    NIJAH "... No puedo decir lo mismo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:44
translate es qst_DamzelDizzt_3_enterOffice_d77e8429:

    # TAREK "As fiery as always."
    TAREK "Tan enérgica como siempre."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:45
translate es qst_DamzelDizzt_3_enterOffice_4836c9d3:

    # "Taking a moment to avert his gaze from her, his grin dropped as he sized up me and Markus."
    "Se permitió un momento para apartar la mirada de ella y dejó de sonreír mientras nos evaluaba a Markus y a mí."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:46
translate es qst_DamzelDizzt_3_enterOffice_c9c2ccc4:

    # TAREK "Who are you two?"
    TAREK "¿Quiénes sois vosotros dos?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:47
translate es qst_DamzelDizzt_3_enterOffice_1258fb49:

