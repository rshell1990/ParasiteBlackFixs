    MC @ talk "¡Soy yo!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:129
translate es qst_DamzelDizzt_3_ruckus_TarekDead_a4d074ae:

    # "After a few moments of seeing that I wasn’t going to hurt her, she slowly began to calm down."
    "Tras unos instantes de ver que no iba a hacerle daño, empezó a calmarse lentamente."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:130
translate es qst_DamzelDizzt_3_ruckus_TarekDead_7924aad4:

    # "Her terrified eyes frantically looking me up and down."
    "Sus ojos aterrorizados me miraban frenéticamente de arriba abajo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:131
translate es qst_DamzelDizzt_3_ruckus_TarekDead_97fa787e:

    # NIJAH "Zis is..."
    NIJAH "Ezto es..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:132
