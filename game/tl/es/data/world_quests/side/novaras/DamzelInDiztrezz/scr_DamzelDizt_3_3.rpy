# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:109
translate es qst_DamzelDizzt_3_ruckus_TarekDead_e45f5339:

    # "Lifeless bodies fell to the floor, one upon another, torn to shreds by tooth and claw as both me and Markus greedily began to rip apart and devour pieces of their flesh."
    "Los cuerpos sin vida cayeron al suelo, uno tras otro, despedazados por los dientes y las garras mientras Markus y yo empezábamos a desgarrar y devorar con avidez trozos de su carne."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:110
translate es qst_DamzelDizzt_3_ruckus_TarekDead_d5cfc95c:

    # "The parasites inside grumbled in appreciation as we lapped up the delicious red meat."
    "Los parásitos de nuestro interior gruñeron de agradecimiento mientras engullíamos la deliciosa carne roja."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:111
translate es qst_DamzelDizzt_3_ruckus_TarekDead_95c84739:

    # "Suddenly, we turned ready as we heard the clatter of feet, claws ready."
    "De repente, nos giramos preparados al oír el repiqueteo de los pies, con las garras preparadas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:112
translate es qst_DamzelDizzt_3_ruckus_TarekDead_a2843312:

    # "Running around the corner was Nijah, whose face turned pale white in horror when she saw us."
    "Al girar la esquina, Nijah se puso pálida de horror al vernos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:122
translate es qst_DamzelDizzt_3_ruckus_TarekDead_c6cecd8b:

    # "Frozen in terror at what she was seeing, Nijah raised her hands up protectively, her mouth open ready to scream."
    "Helada de terror ante lo que estaba viendo, Nijah levantó las manos en señal de protección, con la boca abierta lista para gritar."

