    # NIJAH "... {i}You?{/i}"
    NIJAH "... {i}¿Tú?{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:133
translate es qst_DamzelDizzt_3_ruckus_TarekDead_2131a5b9:

    # MC @ talk "We don’t have time to explain, we have to leave now!"
    MC @ talk "No tenemos tiempo de explicarlo, ¡tenemos que irnos ya!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:134
translate es qst_DamzelDizzt_3_ruckus_TarekDead_0dfc2cee:

    # "Nijah, still pale white from seeing us feasting on Tarek, led us back up the stairs in a hurry."
    "Nijah, aún pálida por vernos dándonos un festín con Tarek, nos llevó de vuelta a las escaleras a toda prisa."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:135
translate es qst_DamzelDizzt_3_ruckus_TarekDead_57aa45b0:

    # NIJAH "We go now! Guards coming!"
    NIJAH "¡Vamos ahora! ¡Vienen los guardias!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:139
translate es qst_DamzelDizzt_3_ruckus_TarekDead_f24beaea:

    # "In the distance, we could hear the shouts of the guards heading our way, and quickly clambered onto the rooftops of buildings where under the veil of darkness we crept out of the Pleasure District."
    "A lo lejos se oían los gritos de los guardias que se dirigían hacia nosotros, y rápidamente trepamos a los tejados de los edificios donde, bajo el velo de la oscuridad, nos escabullimos del distrito del placer."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:140
translate es qst_DamzelDizzt_3_ruckus_TarekDead_8bb9ae24:

    # "Somehow, we had pulled it off, and behind me down below, I could see the guards rushing towards the chaos below."
    "De alguna manera, lo habíamos conseguido, y detrás de mí, abajo, podía ver a los guardias corriendo hacia el caos de abajo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:141
translate es qst_DamzelDizzt_3_ruckus_TarekDead_031f2483:

    # "But by then, we had long vanished."
    "Pero para entonces, hacía tiempo que habíamos desaparecido."

translate es strings:

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:3
    old "*Lie* We are working for the Inquisitors; we have been watching you for a while now."
    new "*Mentir* Trabajamos para los inquisidores; te hemos estado vigilando desde hace tiempo."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:3
    old "I want you to leave Novaras."
    new "Quiero que te vayas de Novaras."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:3
    old "{image=[ICON.HEART_BROKE]} We want gold in exchange for Nijah, we know you want her."
    new "{image=[ICON.HEART_BROKE]} Queremos oro a cambio de Nijah, sabemos que la quieres."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:3
    old "{image=[ICON.SWORDS]} Are you ready for the sweet embrace of death?"
    new "{image=[ICON.SWORDS]} ¿Estás preparado para el dulce abrazo de la muerte?"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:21
    old "The uniform tends to draw too attention for more... {i}delicate{/i} matters such as this."
    new "El uniforme tiende a llamar demasiado la atención para... asuntos {i}delicados{/i} como este."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:21
    old "Fuck it, all this talking is starting to bore me. I'd much rather just fucking eviscerate you."
    new "Joder, toda esta charla está empezando a aburrirme. Preferiría destriparte."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:21
    old "How about I shove my boot down your throat? If we choose not to wear our uniforms we do so for good reason worm!"
    new "¿Qué tal si te meto mi bota por la garganta? ¡Si decidimos no llevar uniforme lo hacemos por una buena razón gusano!"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:49
    old "I am telling you the truth!"
    new "¡Te estoy diciendo la verdad!"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:49
    old "Put your blade away fool, we're your only way out of this mess!"
    new "¡Guarda tu espada, tonto, somos tu única salida de este lío!"

