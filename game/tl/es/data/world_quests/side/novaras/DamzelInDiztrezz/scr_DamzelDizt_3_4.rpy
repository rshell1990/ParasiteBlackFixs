translate es qst_DamzelDizzt_3_talkTarek_successCharm_f681d47e:

    # MC @ talk "To take with you on your travels. A companion for... {i}all of your needs.{/i}"
    MC @ talk "Para llevar de viaje. Una compañera para... {i}todas tus necesidades.{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:108
translate es qst_DamzelDizzt_3_talkTarek_successCharm_4e34dc0e:

    # "Nijah looked away in disgust as Tarek smiled."
    "Nijah apartó la mirada, disgustada, mientras Tarek sonreía."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:109
translate es qst_DamzelDizzt_3_talkTarek_successCharm_26a45b77:

    # TAREK "I suppose something good has come from this."
    TAREK "Supongo que algo bueno ha salido de esto."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:110
translate es qst_DamzelDizzt_3_talkTarek_successCharm_dde0c440:

    # "Pouring out the cup of wine, I handed it to him."
    "Serví la copa de vino y se la entregué."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:111
translate es qst_DamzelDizzt_3_talkTarek_successCharm_92e1c239:

    # MC @ talk "For the riches yet to come."
    MC @ talk "Por las riquezas que están por venir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:112
translate es qst_DamzelDizzt_3_talkTarek_successCharm_e877fb5b:

    # TAREK "Well... That sounds like something I might be willing to drink to."
    TAREK "Bueno... Eso suena como algo por lo que podría estar dispuesto a brindar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:113
translate es qst_DamzelDizzt_3_talkTarek_successCharm_e573f174:

    # "As Tarek held up the cup, he tormentingly remarked to Nijah."
    "Mientras Tarek levantaba la copa, le comentaba atormentado a Nijah."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:114
translate es qst_DamzelDizzt_3_talkTarek_successCharm_540e8055:

    # TAREK "I always told you in the end you would be mine Nijah, one way or another."
    TAREK "Siempre te dije que al final serías mía Nijah, de una forma u otra."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:115
