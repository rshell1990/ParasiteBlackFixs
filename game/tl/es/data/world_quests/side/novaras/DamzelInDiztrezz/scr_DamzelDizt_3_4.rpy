translate es qst_DamzelDizzt_3_talkTarek_successCharm_730215d9:

    # WHITE "Us."
    WHITE "Nosotros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:126
translate es qst_DamzelDizzt_3_talkTarek_successCharm_48d0f839:

    # MC "(Should I?)"
    MC "(¿Debería?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:127
translate es qst_DamzelDizzt_3_talkTarek_successCharm_2ddadf32:

    # MC "(So far these things inside of us have not lied before.)"
    MC "(Hasta ahora estas cosas dentro de nosotros no han mentido antes)."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:128
translate es qst_DamzelDizzt_3_talkTarek_successCharm_09613066:

    # MC "(But now they are asking us to trust them and drink literal poison...)"
    MC "(Pero ahora nos piden que confiemos en ellos y bebamos literalmente veneno...)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:131
translate es qst_DamzelDizzt_3_talkTarek_successCharm_275b6aad:

    # MC @ talk "Neither of us drink, sorry."
    MC @ talk "Ninguno de nosotros bebe, lo siento."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:132
translate es qst_DamzelDizzt_3_talkTarek_successCharm_d10f1028:

    # "Tarek looked down at the cup, the swirling red liquid in his drink before his eyes raised and looked deathly towards us."
    "Tarek bajó la mirada hacia la copa, el líquido rojo que se arremolinaba en su bebida, antes de que sus ojos se alzaran y nos miraran con expresión asesina."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:133
translate es qst_DamzelDizzt_3_talkTarek_successCharm_080e9ca4:

    # TAREK "{i}...Deceivers.{/i}"
    TAREK "{i}...Embaucadores.{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:134
translate es qst_DamzelDizzt_3_talkTarek_successCharm_b0227428:

    # MC @ talk "(Shit!)"
    MC @ talk "(¡Mierda!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:135
translate es qst_DamzelDizzt_3_talkTarek_successCharm_52a45021:

    # TAREK "ASSASSINS! MEN! DRAW YOUR BLADES!"
    TAREK "¡ASESINOS! ¡HOMBRES! ¡SAQUEN SUS ESPADAS!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:137
translate es qst_DamzelDizzt_3_talkTarek_successCharm_97c5ba11:

    # MARKUS "Well, time for plan B!"
    MARKUS "Bueno, ¡es hora del plan B!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:140
translate es qst_DamzelDizzt_3_talkTarek_successCharm_82b10757:

    # "I sighed, looking to Markus to give a nod of approval as we both gulped down the wine together."
    "Suspiré, mirando a Markus para que asintiera con la cabeza mientras ambos engullíamos juntos el vino."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:141
translate es qst_DamzelDizzt_3_talkTarek_successCharm_99172c4a:

    # "Tarek waited a few seconds, his eyes looking over to see if we were about to drop dead at any moment."
    "Tarek esperó unos segundos, con los ojos mirando por encima para ver si íbamos a caer muertos en cualquier momento."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:142
translate es qst_DamzelDizzt_3_talkTarek_successCharm_d532ff0a:

    # "Satisfied when we did not, he smiled."
    "Satisfecho cuando no lo hicimos, sonrió."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:143
translate es qst_DamzelDizzt_3_talkTarek_successCharm_1e681fd0:

    # "Tarek gulped the wine down, confident that despite the setback, he would restart his ‘empire’ elsewhere."
    "Tarek se tragó el vino, confiado en que, a pesar del revés, reiniciaría su ‘imperio’ en otro lugar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:144
translate es qst_DamzelDizzt_3_talkTarek_successCharm_85e88380:

    # "But this time, with Nijah, subservient at his side and warming his bed every night."
    "Pero esta vez, con Nijah, servil a su lado y calentándole la cama cada noche."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:145
translate es qst_DamzelDizzt_3_talkTarek_successCharm_bc75c2c8:

    # "Perhaps even, with access to the dock, he would make riches beyond his wildest dreams."
    "Tal vez incluso, con acceso al muelle, se haría rico más allá de sus sueños más descabellados."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:146
translate es qst_DamzelDizzt_3_talkTarek_successCharm_7fbddc5e:

    # "...But that dream was short-lived."
    "...Pero ese sueño duró poco."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:147
translate es qst_DamzelDizzt_3_talkTarek_successCharm_4ce2d32b:

    # "After a few seconds passed by, Tarek stopped smiling."
    "Al cabo de unos segundos, Tarek dejó de sonreír."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:148
translate es qst_DamzelDizzt_3_talkTarek_successCharm_a5370807:

    # "With a shaking hand, he dropped the cup to the floor and the wine poured out all over it."
    "Con una mano temblorosa, dejó caer la copa al suelo y el vino se derramó por todas partes."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:149
translate es qst_DamzelDizzt_3_talkTarek_successCharm_783b00ad:

    # "The two guards who waited behind us drew their blades in a panic but I turned too quickly for them to even unsheathe their blades in time."
    "Los dos guardias que esperaban detrás de nosotros desenvainaron sus espadas presas del pánico, pero me giré demasiado rápido para que pudieran desenvainarlas a tiempo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:153
translate es qst_DamzelDizzt_3_talkTarek_successCharm_7dd553e9:

    # "From my back, two protruding tentacles quickly emerged and slammed their heads against the wall."
    "De mi espalda surgieron rápidamente dos tentáculos que sobresalían y golpearon sus cabezas contra la pared."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:154
translate es qst_DamzelDizzt_3_talkTarek_successCharm_5ad22fb5:

    # "As I severed their heads off, the two corpses slumped down lifelessly against the wall, leaving behind dragging blood trails."
    "Cuando les corté la cabeza, los dos cadáveres se desplomaron sin vida contra la pared, dejando tras de sí rastros de sangre."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:163
translate es qst_DamzelDizzt_3_talkTarek_successCharm_914bd7e2:

    # "Nijah, now terrified, kicked away her chair as she jumped away from us, ready to scream in terror."
    "Nijah, ahora aterrorizada, apartó de una patada su silla mientras saltaba lejos de nosotros, dispuesta a gritar de terror."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:164
translate es qst_DamzelDizzt_3_talkTarek_successCharm_9b3f7f14:

    # "I motioned desperately for her to be silent, but there was a wide-eyed terror in her eyes and I knew she might scream any moment."
    "Le hice un gesto desesperado para que guardara silencio, pero en sus ojos se reflejaba el terror y supe que gritaría en cualquier momento."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:165
translate es qst_DamzelDizzt_3_talkTarek_successCharm_16e76f01:

    # "Markus quickly rose to his feet, and grabbed her."
    "Markus se levantó rápidamente y la cogió."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:166
translate es qst_DamzelDizzt_3_talkTarek_successCharm_d815c03a:

    # "Covering her mouth as he motioned again for her to be quiet."
    "Le tapó la boca mientras le hacía otro gesto para que se callara."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:169
translate es qst_DamzelDizzt_3_talkTarek_successCharm_1b45bda4:

    # MARKUS "If you scream this place will become a bloodbath!"
    MARKUS "¡Si gritas este lugar se convertirá en una escabechina!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:168
translate es qst_DamzelDizzt_3_talkTarek_successCharm_aa600d0f:

    # "After a few minues of restless breathing, Nijah slowly began to calm."
    "Tras unos minutos de respiración agitada, Nijah empezó a calmarse lentamente."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:171
translate es qst_DamzelDizzt_3_talkTarek_successCharm_a7730668:

    # MARKUS "You weren't supposed to see that... But we need you to stay calm, can you do that?"
    MARKUS "No se suponía que vieras eso... Pero necesitamos que mantengas la calma, ¿puedes hacerlo?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:170
translate es qst_DamzelDizzt_3_talkTarek_successCharm_bd842606:

    # "Nijah nodded anxiously as Markus slowly loosened his grip over her mouth."
    "Nijah asintió ansiosa mientras Markus aflojaba lentamente el agarre sobre su boca."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:171
translate es qst_DamzelDizzt_3_talkTarek_successCharm_71a25315:

    # "Tarek, now writhing in agony on the floor, desperately wheezed as he struggled to breathe."
    "Tarek, que ahora se retorcía de dolor en el suelo, resollaba desesperadamente mientras luchaba por respirar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:172
translate es qst_DamzelDizzt_3_talkTarek_successCharm_d7439580:

    # "His eyes rolled white as his jaw locked and he began to foam at the mouth. He clawed furiously at his throat..."
    "Se le pusieron los ojos en blanco, se le trabó la mandíbula y empezó a echar espuma por la boca. Se arañó furiosamente la garganta..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:173
translate es qst_DamzelDizzt_3_talkTarek_successCharm_92d6cbf9:

    # "Tearing through his own neck, the violent convulsions stopped as two bloody trails emerged from both of his eyes and dripped down onto the floor."
    "Al desgarrarse el cuello, las violentas convulsiones cesaron mientras dos regueros sanguinolentos salían de sus ojos y caían al suelo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:174
translate es qst_DamzelDizzt_3_talkTarek_successCharm_428a3c12:

    # "After a few more convulsions, Tarek stopped, blood gurgling out of his mouth."
    "Tras unas cuantas convulsiones más, Tarek se detuvo, la sangre le salía a borbotones por la boca."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:175
translate es qst_DamzelDizzt_3_talkTarek_successCharm_dfe2dc08:

    # MC @ talk "... Is he dead?"
    MC @ talk "... ¿Está muerto?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:176
translate es qst_DamzelDizzt_3_talkTarek_successCharm_9511ec9b:

    # "...I finally asked after a few moments of silence passed."
    "...Pregunté finalmente tras unos instantes de silencio."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:179
translate es qst_DamzelDizzt_3_talkTarek_successCharm_4bf231fb:

    # MARKUS "He’s seen better days."
    MARKUS "Ha visto mejores días."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:178
translate es qst_DamzelDizzt_3_talkTarek_successCharm_843da995:

    # NIJAH "We go, {i}now!{/i}"
    NIJAH "¡Vamos, {i}ahora!{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:180
translate es qst_DamzelDizzt_3_talkTarek_successCharm_bd7f1c1d:

    # "Both me and Markus nodded and transformed back into our human forms."
    "Markus y yo asentimos y volvimos a nuestras formas humanas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:181
translate es qst_DamzelDizzt_3_talkTarek_successCharm_a0d78fb7:

    # "About to leave, I snatched a hefty pouch of gold from Tarek's table."
    "A punto de irme, cogí una bolsa de oro de la mesa de Tarek."

