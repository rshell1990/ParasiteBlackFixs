

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:12
translate es qst_DamzelDizzt_2_afterAction_8d021993:

    # "Back in my room, Nijah took a few steps back away from us the second she could."
    "De vuelta en mi habitación, Nijah se alejó de nosotros en cuanto pudo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:13
translate es qst_DamzelDizzt_2_afterAction_685b8701:

    # NIJAH "You... Zat was..."
    NIJAH "Tú... Eze era..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:14
translate es qst_DamzelDizzt_2_afterAction_0bbf9745:

    # MC @ talk "Nijah, you have to trust us."
    MC @ talk "Nijah, tienes que confiar en nosotros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:15
translate es qst_DamzelDizzt_2_afterAction_4e940762:

    # NIJAH "Are you... humans?"
    NIJAH "¿Sois... humanos?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:16
translate es qst_DamzelDizzt_2_afterAction_bcd4deec:

    # "Me and Markus shared a uncomfortable look, slightly unsure now even amongst ourselves."
    "Markus y yo compartimos una mirada incómoda, algo inseguros ahora incluso entre nosotros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:13
translate es qst_DamzelDizzt_2_afterAction_2242b5a5:

    # MARKUS "Yes... Well... {i}Sort of.{/i}"
    MARKUS "Sí... Bueno... {i}Más o menos.{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:18
translate es qst_DamzelDizzt_2_afterAction_fbd49721:

    # NIJAH "..."
    NIJAH "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:20
translate es qst_DamzelDizzt_2_afterAction_fbd49721_1:

    # NIJAH "..."
    NIJAH "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:22
translate es qst_DamzelDizzt_2_afterAction_99f875e5:

    # NIJAH @ sad "Zis is quite a lot to take in."
    NIJAH @ sad "Ezto es mucho para asimilar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:23
translate es qst_DamzelDizzt_2_afterAction_7ea7174e:

    # "Nijah rubbed nervously at her brow, feeling a little lightheaded with everything she just saw."
    "Nijah se frotó nerviosamente la frente, sintiéndose un poco mareada por todo lo que acababa de ver."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:24
translate es qst_DamzelDizzt_2_afterAction_d491d130:

    # "Nijah stepped forward, prodding at my chest with her finger."
    "Nijah dio un paso adelante, empujandome el pecho con el dedo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:25
translate es qst_DamzelDizzt_2_afterAction_04a98be0:

    # MC @ talk "Uh, do you mind?"
    MC @ talk "Uh, ¿te importa?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:27
translate es qst_DamzelDizzt_2_afterAction_f6d437f8:

    # NIJAH "It was like metal... But stronger.."
    NIJAH "Era como metal... Pero más fuerte..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:28
translate es qst_DamzelDizzt_2_afterAction_653ed8d3:

    # "I reached out to gently grab her hand, snapping her out of what ever trance she had put herself in."
    "Extendí la mano para cogerla suavemente y sacarla del trance en el que se había metido."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:29
translate es qst_DamzelDizzt_2_afterAction_13b62009:

    # MC @ talk "Nijah..."
    MC @ talk "Nijah..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:30
translate es qst_DamzelDizzt_2_afterAction_b88ab1e0:

    # NIJAH "You... You can change into..."
    NIJAH "Tú... Tú puedes convertirte en..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:31
translate es qst_DamzelDizzt_2_afterAction_68ce8f4c:

    # NIJAH "{i}That?{/i}"
    NIJAH "{i}¿Ezo?{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:32
translate es qst_DamzelDizzt_2_afterAction_4ed94cd8:

    # MC @ talk "... Yes... We can change into those things."
    MC @ talk "... Sí... Podemos convertirnos en esas cosas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:33
translate es qst_DamzelDizzt_2_afterAction_4d1bce36:

    # "Nijah stared blankly ahead for a few moments before taking a deep sigh, and just like that, she reverted back to her old self again."
    "Nijah se quedó con la mirada perdida durante unos instantes antes de suspirar hondo y, sin más, volvió a ser la de antes."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:34
translate es qst_DamzelDizzt_2_afterAction_ffc0320c:

    # NIJAH "... I zee."
    NIJAH "... Ya veo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:35
translate es qst_DamzelDizzt_2_afterAction_be9147a2:

    # "Me and Markus curiously looked at each other before looking back at her."
    "Markus y yo nos miramos con curiosidad antes de volver a mirarla a ella."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:36
translate es qst_DamzelDizzt_2_afterAction_efb244a7:

    # MC @ talk "... You do?"
    MC @ talk "... ¿En serio?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:37
translate es qst_DamzelDizzt_2_afterAction_c06e04b6:

    # "Nijah smiled sheepishly, still trembling slightly as she spoke, but I could hear her heart beginning to settle."
    "Nijah sonrió tímidamente, aún temblaba ligeramente al hablar, pero pude oír cómo su corazón empezaba a calmarse."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:38
translate es qst_DamzelDizzt_2_afterAction_4417cfdb:

    # NIJAH "Your secret is safe with me."
    NIJAH "Tu secreto está a salvo conmigo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:39
translate es qst_DamzelDizzt_2_afterAction_9ffb4d28:

    # NIJAH "I owe you much..."
    NIJAH "Te debo mucho..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:40
translate es qst_DamzelDizzt_2_afterAction_3f16aeb9:

    # "I turned to Markus who gave me a look of ‘Is she going to actually keep this quiet or not?’"
    "Me giré hacia Markus, que me miró como diciendo ‘¿Va a mantener esto en secreto o no?’"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:41
translate es qst_DamzelDizzt_2_afterAction_098d9497:

    # MC @ talk "Markus, thank you for helping me."
    MC @ talk "Markus, gracias por ayudarme."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:38
translate es qst_DamzelDizzt_2_afterAction_9a602a37:

    # MARKUS "Well, I was hardly going to just let you get yourself killed, was I?"
    MARKUS "Bueno, no iba a dejar que te mataran, ¿verdad?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:43
translate es qst_DamzelDizzt_2_afterAction_f01d242d:

    # MC @ talk "Still..."
    MC @ talk "Aún así..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:44
translate es qst_DamzelDizzt_2_afterAction_26d00492:

    # "Nijah piped up."
    "Nijah intervino."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:45
translate es qst_DamzelDizzt_2_afterAction_beab34ed:

    # NIJAH "Thank you... both."
    NIJAH "Gracias... a los dos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:46
translate es qst_DamzelDizzt_2_afterAction_6fec193a:

    # "Markus rolled his eyes and smiled."
    "Markus giró los ojos y sonrió."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:43
translate es qst_DamzelDizzt_2_afterAction_3792fe9d:

    # MARKUS "Well, just let me know if there’s any more trouble..."
    MARKUS "Bueno, avísame si hay más problemas..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:44
translate es qst_DamzelDizzt_2_afterAction_985bd55c:

    # MARKUS "Goodnight, both."
    MARKUS "Buenas noches, a los dos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:49
translate es qst_DamzelDizzt_2_afterAction_12fc8712:

    # "With that, Markus nodded towards me as he left."
    "Con eso, Markus asintió hacia mí y se marchó."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:51
translate es qst_DamzelDizzt_2_afterAction_02a7a90f:

    # "When the door closed behind him, I turned to Nijah who nervously took a small step forward."
    "Cuando la puerta se cerró tras él, me giré hacia Nijah, que, nerviosa, dio un pequeño paso adelante."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:52
translate es qst_DamzelDizzt_2_afterAction_426f9298:

    # NIJAH "You were afraid to tell me... Why?"
    NIJAH "Tenías miedo de decírmelo... ¿Por qué?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:53
translate es qst_DamzelDizzt_2_afterAction_81003dde:

    # MC @ talk "I was afraid you might run away if you saw me like that, that you might—"
    MC @ talk "Temía que huyeras si me veías así, que pudieras—"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:54
translate es qst_DamzelDizzt_2_afterAction_d05a2196:

    # "Nijah suddenly cupped my face and pulled me in for a kiss much to my bewilderment."
    "De repente, Nijah me acarició la cara y me dio un beso, para mi desconcierto."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:55
translate es qst_DamzelDizzt_2_afterAction_c59a7cc4:

    # NIJAH "You... You did much to help."
    NIJAH "Tú... Tú hiciste mucho para ayudar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:56
translate es qst_DamzelDizzt_2_afterAction_3015442c:

    # NIJAH "Keep no secrets from me... I care not for what you are."
    NIJAH "No me ocultes nada... No me importa lo que eres."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:57
translate es qst_DamzelDizzt_2_afterAction_2988b59d:

    # NIJAH "{i}Because of who you are...{/i}"
    NIJAH "{i}Por ser quien eres...{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:61
translate es qst_DamzelDizzt_2_afterAction_2d89b62a:

    # "We have spent some time together, and I finally felt calming down after the night's events."
    "Hemos pasado un rato juntos y por fin me he tranquilizado tras los acontecimientos de la noche."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:62
translate es qst_DamzelDizzt_2_afterAction_e55fad8b:

    # "I walked Nijah to her home, which turned out to be not that far from mine."
    "Acompañé a Nijah a su casa, que resultó no estar muy lejos de la mía."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:65
translate es qst_DamzelDizzt_2_afterAction_77636738:

    # "Saying our goodbyes, Nijah gave me a warm embrace as she disappeared inside her house."
    "Al despedirnos, Nijah me dio un cálido abrazo mientras desaparecía dentro de su casa."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:66
translate es qst_DamzelDizzt_2_afterAction_4f5f7955:

    # BLACK "IT WAS A GOOD HUNT, HOST."
    BLACK "FUE UNA BUENA CACERÍA, ANFITRIÓN."
