

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:3
translate es qst_DamzelDizzt_3_VulshanRevolt_d1a49c6c:

    # "The man nodded, and as he stepped towards one of the other guards, he suddenly unsheathed his blade and slashed him down!"
    "El hombre asintió con la cabeza y, mientras se acercaba a otro de los guardias, ¡desenvainó de repente su espada y le asestó un tajo!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:3
translate es qst_DamzelDizzt_3_VulshanRevolt_8140841f:

    # THUG @ talk "LONG LIVE THE VULSHAN!"
    THUG @ talk "¡VIVA LOS VULSAN!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:5
translate es qst_DamzelDizzt_3_VulshanRevolt_4a266463:

    # MARKUS "Well this isn't how I expected things to go!"
    MARKUS "¡Bueno, esto no es como esperaba que fueran las cosas!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:8
translate es qst_DamzelDizzt_3_VulshanRevolt_600b097f:

    # "Suddenly, the whole Hall erupted into violence."
    "De repente, toda la sala estalló en violencia.."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:10
translate es qst_DamzelDizzt_3_VulshanRevolt_0e51501d:

    # "Me and Markus transformed and threw ourselves into the fight."
    "Markus y yo nos transformamos y nos lanzamos a la lucha."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:25
translate es qst_DamzelDizzt_3_VulshanRevolt_20c289b2:

    # TAREK "What is this madness? Traitors! Show yourselves!"
    TAREK "¿Qué es esta locura? ¡Traidores! ¡Muéstrense!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:26
translate es qst_DamzelDizzt_3_VulshanRevolt_d975eceb:

    # "Tarek's eyes glanced over towards us."
    "Los ojos de Tarek miraron hacia nosotros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:27
translate es qst_DamzelDizzt_3_VulshanRevolt_b8c3e99f:

    # TAREK "M-Monsters! What have you brought into this place you fools?!"
    TAREK "¡M-monstruos! ¡¿Qué habéis traído a este lugar, estúpidos?!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:30
translate es qst_DamzelDizzt_3_VulshanRevolt_6d204d91:

    # THUG @ talk "You are the traitor Tarek! No longer will we be subservient to your lies!"
    THUG @ talk "¡Tú eres el traidor Tarek! ¡Ya no seremos sumisos a tus mentiras!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:31
translate es qst_DamzelDizzt_3_VulshanRevolt_d22b5624:

    # THUG @ talk "VULSHAN! LET US END THIS!"
    THUG @ talk "¡VULSHAN! ¡ACABEMOS CON ESTO!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:39
translate es qst_DamzelDizzt_3_VulshanRevolt_24e3e8fa:

    # "Tarek finally dropped to the floor, gashes and wounds deep into his flesh as he wretched up blood, the surviving Vulshan hacking at him with his blades."
    "Finalmente, Tarek cayó al suelo, con cortes y heridas profundas en la carne mientras vomitaba sangre, mientras los vulshan supervivientes le asestaban con sus espadas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:40
translate es qst_DamzelDizzt_3_VulshanRevolt_ceb971cc:

    # "Finally, they turned towards me and Markus."
    "Finalmente, se giraron hacia mí y Markus."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:53
translate es qst_DamzelDizzt_3_VulshanRevolt_627a4832:

    # THUG @ talk "The deed is done."
    THUG @ talk "El asunto está resuelto."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:54
translate es qst_DamzelDizzt_3_VulshanRevolt_45ed71ba:

    # THUG @ talk "Go now, before the guards arrive, we will clean up the mess."
    THUG @ talk "Iros ahora, antes de que lleguen los guardias, limpiaremos el desastre."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:52
translate es qst_DamzelDizzt_3_VulshanRevolt_e3c5742c:

    # "Turning towards a terrified Nijah, I called her forward and she nervously stepped closer, her face sickly pale white as her eyes remained fixed on me and Markus in our other forms."
    "Me giré hacia una aterrorizada Nijah, la llamé y ella se acercó nerviosa, con el rostro de un blanco pálido enfermizo mientras sus ojos permanecían fijos en mí y en Markus en nuestras otras formas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:55
translate es qst_DamzelDizzt_3_VulshanRevolt_c454721e:

    # NIJAH "You... You are both..."
    NIJAH "Vosotros... Vosotros sois..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:56
translate es qst_DamzelDizzt_3_VulshanRevolt_d600ab27:

    # MC @ talk "This one, Nijah... Her debt is to be wiped."
    MC @ talk "Esta, Nijah... Su deuda debe ser borrada."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:60
translate es qst_DamzelDizzt_3_VulshanRevolt_e2c3ff73:

    # THUG @ talk "Consider it done! Now go!"
    THUG @ talk "¡Consideradlo hecho! ¡Ahora marcháos!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_vushanRoute.rpy:59
translate es qst_DamzelDizzt_3_VulshanRevolt_aebc85e5:

    # "Taking Nijah by hand, I led her away with Markus as we hurried away into the night."
    "Cogí a Nijah de la mano y me la llevé con Markus mientras nos adentrábamos en la noche."
