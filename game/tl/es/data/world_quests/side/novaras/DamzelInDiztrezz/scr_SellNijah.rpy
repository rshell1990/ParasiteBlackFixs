    "Markus me soltó."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:45
translate es qst_DamzelDizzt_3_sellNijah_b955763a:

    # MARKUS @ angry "Next time you plan on doing something like that, you do it without me, understand?"
    MARKUS @ angry "La próxima vez que planees hacer algo así, hazlo sin mí, ¿entendido?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:46
translate es qst_DamzelDizzt_3_sellNijah_54d4af59:

