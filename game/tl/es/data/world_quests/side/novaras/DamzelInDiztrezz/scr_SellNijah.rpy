    MC @ talk "Siempre puedo irme con ella si no la quieres."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:5
translate es qst_DamzelDizzt_3_sellNijah_a579028a:

    # TAREK @ angry "And I can just kill you and take her for free."
    TAREK @ angry "Y yo puedo matarte y llevármela gratis."

