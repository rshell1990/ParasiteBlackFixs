    MC @ talk "Inténtalo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:7
translate es qst_DamzelDizzt_3_sellNijah_66619439:

    # TAREK @ smile "...Hahaha!"
    TAREK @ smile "...¡Jajaja!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:8
translate es qst_DamzelDizzt_3_sellNijah_de389705:

    # TAREK @ smile "Well, I am a fair man."
    TAREK @ smile "Bueno, soy un hombre justo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:9
translate es qst_DamzelDizzt_3_sellNijah_be1aadcc:

    # TAREK "I shall give you a thousand coins for her."
    TAREK "Te daré mil monedas por ella."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:10
translate es qst_DamzelDizzt_3_sellNijah_a65e01b3:

    # MC @ talk "Deal."
    MC @ talk "Trato hecho."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:11
translate es qst_DamzelDizzt_3_sellNijah_c3e2f8a3:

    # MC "Markus turned to look dumbfounded at me, somewhere between disbelief and uncertainty as to what was happening but he stayed quiet."
    MC "Markus se giró para mirarme estupefacto, entre la incredulidad y la incertidumbre por lo que estaba pasando, pero se quedó callado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:13
translate es qst_DamzelDizzt_3_sellNijah_d1a700f2:

    # MC "After Tarek handed me over the gold, he reached and pulled Nijah towards him, who suddenly became aghast in horror once she realized she had been betrayed."
    MC "Después de que Tarek me entregara el oro, estiró la mano y atrajo hacia sí a Nijah, que de pronto se horrorizó al darse cuenta de que la habían traicionado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:14
translate es qst_DamzelDizzt_3_sellNijah_e9945d4f:

    # NIJAH @ sad "You... You lie to me!"
    NIJAH @ sad "Tú... ¡Me mientes!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:15
translate es qst_DamzelDizzt_3_sellNijah_44770c67:

    # MC @ talk "Sorry Nijah, it's just business."
    MC @ talk "Lo siento Nijah, son solo negocios."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:16
translate es qst_DamzelDizzt_3_sellNijah_b5d03680:

    # NIJAH @ angry "YOU BASTARDS!"
    NIJAH @ angry "¡BASTARDOS!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:17
translate es qst_DamzelDizzt_3_sellNijah_1665d9cd:

    # TAREK @ angry "Quiet girl!"
    TAREK @ angry "¡Silencio chica!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:18
translate es qst_DamzelDizzt_3_sellNijah_9c377a43:

    # TAREK "You two leave us now, our business is concluded."
    TAREK "Vosotros dos dejadnos ahora, nuestro negocio ha concluido."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:19
translate es qst_DamzelDizzt_3_sellNijah_f8ca03e7:

    # NIJAH @ sad "No... Please... Don't do this!"
    NIJAH @ sad "No... Por favor... ¡No lo hagas!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:21
translate es qst_DamzelDizzt_3_sellNijah_48a26997:

    # NIJAH "Please! PLEASE DON'T GO!"
    NIJAH "¡Por favor! ¡POR FAVOR, NO TE VAYAS!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:22
translate es qst_DamzelDizzt_3_sellNijah_9d1fb6ca:

    # NIJAH "PLEASEEEEEEEEE!"
    NIJAH "¡POR FAVORRRRRRRRR!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:39
translate es qst_DamzelDizzt_3_sellNijah_c8478afe:

    # MC "As we left the Black Diamond, I felt Markus' hands grip around me as he pushed me against a wall."
    MC "Cuando salimos del Black Diamond, sentí que las manos de Markus me rodeaban mientras me empujaba contra una pared."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:40
translate es qst_DamzelDizzt_3_sellNijah_93d911cb:

    # MARKUS @ angry "What the fuck was that back there?"
    MARKUS @ angry "¿Qué coño era eso de ahí atrás?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:41
translate es qst_DamzelDizzt_3_sellNijah_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "¿Qué?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:42
translate es qst_DamzelDizzt_3_sellNijah_d68bab2f:

    # MARKUS @ angry "All that bullshit about saving her and you just sell her out?!"
    MARKUS @ angry "¡¿Toda esa mierda de salvarla y simplemente la vendes?!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:43
translate es qst_DamzelDizzt_3_sellNijah_02fde90f:

    # MC @ talk "I did what I had to do, we need the coin."
    MC @ talk "Hice lo que tenía que hacer, necesitamos dinero."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:44
translate es qst_DamzelDizzt_3_sellNijah_99e4696f:

