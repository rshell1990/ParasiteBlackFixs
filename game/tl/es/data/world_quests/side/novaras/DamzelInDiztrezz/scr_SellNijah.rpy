translate es qst_DamzelDizzt_3_sellNijah_aab4247d:

    # MC @ angry "We'll need to do terrible things sometimes if we're going to survive."
    MC @ angry "A veces tendremos que hacer cosas terribles si queremos sobrevivir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_SellNijah.rpy:48
translate es qst_DamzelDizzt_3_sellNijah_2a9dcf7d:

    # MARKUS @ angry "Tsch, some 'heroes' we are..."
    MARKUS @ angry "Tsch, menudos 'héroes' estamos hechos..."

