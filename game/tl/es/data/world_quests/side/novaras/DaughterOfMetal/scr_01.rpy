

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:7
translate es qst_DaughterOfMetal_01_492bc4af:

    # ARLENA "You’ve been busy lately..."
    ARLENA "Has estado ocupado últimamente..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:10
translate es qst_DaughterOfMetal_01_b941f80f:

    # ARLENA "See this is what I’m talking about!"
    ARLENA "¡Ves de esto es de lo que estoy hablando!"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:11
translate es qst_DaughterOfMetal_01_5eb137ef:

    # ARLENA "You’re such a fucking ass at times."
    ARLENA "A veces eres un maldito imbécil."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:12
translate es qst_DaughterOfMetal_01_1dda88c0:

    # MC @ talk "Oh, yeah, because you’ve been so friendly?"
    MC @ talk "Oh, sí, ¿porque has sido tan amable?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:14
translate es qst_DaughterOfMetal_01_7eeeb87d:

    # ARLENA "Nice to see you too, asshole."
    ARLENA "Yo también me alegro de verte, imbécil."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:15
translate es qst_DaughterOfMetal_01_480cd147:

    # ARLENA "Well... I actually wanted to know if you were free after dark."
    ARLENA "Bueno... En realidad quería saber si estabas disponible por la noche."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:16
translate es qst_DaughterOfMetal_01_2eb2c8c0:

    # MC @ talk "Free? For what?"
    MC @ talk "¿Disponible? ¿Para qué?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:17
translate es qst_DaughterOfMetal_01_5e88f657:

    # ARLENA "A few of us are meeting at the {i}Iron Unicorn{/i}."
    ARLENA "Algunos de nosotros nos reuniremos en el {i}Unicornio de hierro{/i}."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:18
translate es qst_DaughterOfMetal_01_e619a84d:

    # ARLENA "I figured you might want to join us."
    ARLENA "Pensé que querrías unirte a nosotros."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:19
translate es qst_DaughterOfMetal_01_f47a248f:

    # ARLENA "You know, when you’re all done swallowing the swords of noblemen."
    ARLENA "Ya sabes, cuando termines de tragarte las espadas de los nobles."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:20
translate es qst_DaughterOfMetal_01_1c297c34:

    # MC @ talk "... You’re inviting me out?"
    MC @ talk "... ¿Me estás invitando a salir?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:21
translate es qst_DaughterOfMetal_01_7fb745e1:

    # ARLENA "Yes."
    ARLENA "Sí."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:22
translate es qst_DaughterOfMetal_01_75b10289:

    # MC @ talk "... To have some drinks?"
    MC @ talk "... ¿Para tomar unas copas?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:23
translate es qst_DaughterOfMetal_01_7fb745e1_1:

    # ARLENA "Yes."
    ARLENA "Sí."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:24
translate es qst_DaughterOfMetal_01_57027d0d:

    # MC @ talk "... So, you want me and you to—"
    MC @ talk "... Entonces, ¿quieres que tú y yo—"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:25
translate es qst_DaughterOfMetal_01_a789db95:

    # ARLENA "Gods be fucking damned! YES! I am inviting you out, idiot!"
    ARLENA "¡Malditos sean los dioses! ¡SÍ! ¡Te estoy invitando a salir, idiota!"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:26
translate es qst_DaughterOfMetal_01_5d3ad7f2:

    # ARLENA "Get that into your thick skull."
    ARLENA "Métete eso en tu cabezota."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:27
translate es qst_DaughterOfMetal_01_bd0af062:

    # "I reached out to touch Arlena’s forehead before she slapped my hand away, a look of disgust on her face."
    "Alargué la mano para tocar la frente de Arlena, pero ella me la apartó de un manotazo con cara de asco."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:28
translate es qst_DaughterOfMetal_01_09e2cf91:

    # ARLENA "What are you doing?"
    ARLENA "¿Qué estás haciendo?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:29
translate es qst_DaughterOfMetal_01_4856fc73:

    # MC @ talk "Just making sure you aren’t suffering a fever right now."
    MC @ talk "Solo me aseguro de que no tengas fiebre en este momento."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:30
translate es qst_DaughterOfMetal_01_dd465c0b:

    # ARLENA "Urgh... Turn up, don’t turn up."
    ARLENA "Urgh... Aparece o no."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:31
translate es qst_DaughterOfMetal_01_f21fbb7c:

    # ARLENA "I don’t give a shit."
    ARLENA "Me importa una mierda."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:33
translate es qst_DaughterOfMetal_01_b017b264:

    # "With that, Arlena strode back inside, presumably to work out her annoyance at me by hammering the shit out of something on an anvil."
    "Con eso, Arlena volvió a entrar, presumiblemente para resolver su enfado conmigo martilleando algo en un yunque."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:34
translate es qst_DaughterOfMetal_01_324d1571:

    # MC "... Well... that was unexpected."
    MC "... Bueno... eso fue inesperado."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:35
translate es qst_DaughterOfMetal_01_da5a206a:

    # MC "It might be worth joining Arlena and the others later if this is her way of holding out an olive branch."
    MC "Podría valer la pena unirse a Arlena y los demás más tarde si esta es su forma de tender una rama de olivo."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:36
translate es qst_DaughterOfMetal_01_1a258d0c:

    # MC "... That is, if I even want to accept it."
    MC "... Es decir, si quiero aceptarla."

translate es strings:

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:8
    old "Here to give me more shit?"
    new "¿Aquí para darme el coñazo?"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:8
    old "What do you want now, Arlena?"
    new "¿Qué quieres ahora, Arlena?"
