    "Las manos de Mika se cerraron en puños."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:913
translate es qst_a_best_friends_path_10_6484a695:

    # MIKA @ sad "I wanted them to know what happened, I wanted-"
    MIKA @ sad "Quería que supieran lo que pasó, quería-"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:914
translate es qst_a_best_friends_path_10_13cb12b2:

    # MIKA @ cry "I wanted to tell them I was sorry for failing my friends back then."
    MIKA @ cry "Quería decirles que sentía haber fallado a mis amigos entonces."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:915
translate es qst_a_best_friends_path_10_632248c1:

    # MC @ sad "...Mika."
    MC @ sad "...Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:916
translate es qst_a_best_friends_path_10_ffbed2c5:

    # DIVINE "You never failed your friends, Mika."
    DIVINE "Nunca les fallaste a tus amigos, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:919
translate es qst_a_best_friends_path_10_ce7fc004:

    # "Mika gasped in shock as Sister Divine stepped into the light from the stairway behind us."
    "Mika soltó un grito de asombro cuando la hermana Divine salió a la luz desde la escalera que teníamos detrás."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:920
translate es qst_a_best_friends_path_10_5fed5006:

    # MIKA @ shock "S-Siter Divine!"
    MIKA @ shock "¡H-hermana Divine!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:923
translate es qst_a_best_friends_path_10_7d803879:

    # DIVINE @ sad "It saddens my heart greatly that you never felt you could share the weight of such a burden with me."
    DIVINE @ sad "Me entristece enormemente que nunca sintieras que podías compartir conmigo el peso de semejante carga."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:924
translate es qst_a_best_friends_path_10_04adfbfb:

    # MIKA @ shock "H-How do you know?"
    MIKA @ shock "¿C-cómo lo supiste?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:925
translate es qst_a_best_friends_path_10_8977624b:

    # DIVINE @ sad "Zara, after your argument with her, came to my office."
    DIVINE @ sad "Zara, después de discutir con ella, vino a mi oficna."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:926
translate es qst_a_best_friends_path_10_3e267ff5:

    # DIVINE @ sad "She told me everything about the promise you girls had made to keep things a secret."
    DIVINE @ sad "Me contó todo sobre la promesa que habíais hecho de mantener las cosas en secreto."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:927
translate es qst_a_best_friends_path_10_b4a79b10:

    # "Tears began to sting Mika's face as she was overwhelmed with emotion."
    "A Mika se le llenó la cara de lágrimas de la emoción."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:928
translate es qst_a_best_friends_path_10_1928f7ea:

    # MIKA @ sad "I ... I ..."
    MIKA @ sad "Yo... yo..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:929
translate es qst_a_best_friends_path_10_1b3a2e03:

    # "Dropping to her knees, Mika began to sob openly as Sister Divine gently rubbed at her back."
    "Cayendo de rodillas, Mika empezó a sollozar abiertamente mientras la hermana Divine le frotaba suavemente la espalda."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:931
translate es qst_a_best_friends_path_10_c4d7691b:

    # MIKA @ cry "I hate myself! I HATE MYSELF SO MUCH!"
    MIKA @ cry "¡Me odio! ¡ME ODIO TANTO!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:932
translate es qst_a_best_friends_path_10_c892c3fb:

    # MIKA @ cry "They were my friends!"
    MIKA @ cry "¡Eran mis amigos!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:933
translate es qst_a_best_friends_path_10_f2c3d8a4:

    # "Her scratched voice broke and began a high-pitched, desperate cry."
    "Su voz rasgada se quebró y comenzó un grito agudo y desesperado."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:934
translate es qst_a_best_friends_path_10_24c102b0:

    # MIKA @ cry "... I failed them! I failed them all!"
    MIKA @ cry "... ¡Les fallé! ¡Les fallé a todos!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:935
translate es qst_a_best_friends_path_10_225af866:

    # DIVINE @ sad "Mika! It's alright, Mika!"
    DIVINE @ sad "¡Mika! ¡Está bien, Mika!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:936
translate es qst_a_best_friends_path_10_90aa22af:

    # "Sister Divine began to cradle Mika's head, pulling her into an embrace."
    "La hermana Divine empezó a acariciar la cabeza de Mika, tirando de ella para abrazarla."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:937
translate es qst_a_best_friends_path_10_197900a1:

    # DIVINE @ sad "No one blames you, you silly girl."
    DIVINE @ sad "Nadie te culpa, tontita."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:938
translate es qst_a_best_friends_path_10_e4d9561e:

    # DIVINE @ sad "For god's sake, Mika."
    DIVINE @ sad "Por el amor de Dios, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:939
translate es qst_a_best_friends_path_10_fcc5cb7d:

    # DIVINE @ sad "Why did you never say? Were you so afraid I would yell at you?"
    DIVINE @ sad "¿Por qué nunca lo dijiste? ¿Tenías tanto miedo de que te gritara?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:940
translate es qst_a_best_friends_path_10_191c2dcb:

    # MIKA @ cry "I was afraid I'd only disappoint you again."
    MIKA @ cry "Tenía miedo de decepcionarte otra vez."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:958
translate es qst_a_best_friends_path_10_9e2d50df:

    # "Her words seem to have struck a chord with Sister Divine, whose mouth opened to say something, but instead. she chose to simply embrace the girl once again."
    "Sus palabras parecen haber tocado la fibra sensible de la hermana Divine, cuya boca se abrió para decir algo, pero en su lugar, optó por simplemente abrazar a la chica una vez más."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:942
translate es qst_a_best_friends_path_10_5a76c718:

    # DIVINE @ sad "You foolish, foolish girl..."
    DIVINE @ sad "Serás necia..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:943
translate es qst_a_best_friends_path_10_a11957d4:

    # "Sister Divine wiped away Mika's tears with her sleeve."
    "La hermana Divine secó las lágrimas de Mika con la manga."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:944
translate es qst_a_best_friends_path_10_29e9743d:

    # DIVINE @ sad "You have never been a disappointment to me, Mika."
    DIVINE @ sad "Nunca me has decepcionado, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:945
translate es qst_a_best_friends_path_10_6fee3cf3:

    # DIVINE @ sad "You, nor any of the other girls."
    DIVINE @ sad "Tú, ni ninguna de las otras chicas."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:946
translate es qst_a_best_friends_path_10_c2471857:

    # "Mika didn't answer; she bowed her head ashamedly to the floor, still sniffling."
    "Mika no contestó; inclinó avergonzada la cabeza hacia el suelo, todavía sorbiéndose los mocos."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:947
translate es qst_a_best_friends_path_10_4d3cd16e:

    # DIVINE @ sad "We'll speak of this again, just the two of us, do you understand?"
    DIVINE @ sad "Hablaremos de esto otra vez, solo nosotras dos, ¿entiendes?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:948
translate es qst_a_best_friends_path_10_f4592411:

    # "Mika nodded lightly."
    "Mika asintió ligeramente."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:949
translate es qst_a_best_friends_path_10_5008c17b:

    # DIVINE @ sad "Return to the girl's dorm, Mika."
    DIVINE @ sad "Vuelve al dormitorio de las chicas, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:950
translate es qst_a_best_friends_path_10_f80bce0e:

    # "Mika looked up sheepishly towards me."
    "Mika miró hacia mí con timidez."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:951
translate es qst_a_best_friends_path_10_7eb78366:

    # MIKA @ sad "T-Tomorrow..."
    MIKA @ sad "M-mañana..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:952
translate es qst_a_best_friends_path_10_aca475ab:

    # MIKA @ shock "I won't let you down! I promise!"
    MIKA @ shock "¡No te defraudaré! ¡Te lo prometo!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:956
translate es qst_a_best_friends_path_10_39bb73e7:

    # MC @ talk "...Will the families ever receive those letters she wrote?"
    MC @ talk "...¿Recibirán alguna vez las familias las cartas que escribió?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:959
translate es qst_a_best_friends_path_10_fb9ddaad:

    # DIVINE @ think "No."
    DIVINE @ think "No."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:961
translate es qst_a_best_friends_path_10_86429564:

    # DIVINE @ think "To let them out would risk another scandal we can't afford."
    DIVINE @ think "Dejarlas salir supondría arriesgarnos a otro escándalo que no podemos permitirnos."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:960
translate es qst_a_best_friends_path_10_314a3574:

    # "Sister Divine tilted her head towards me, her eyes meeting mine."
    "La hermana Divine inclinó la cabeza hacia mí y sus ojos se encontraron con los míos."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:963
translate es qst_a_best_friends_path_10_4ae73fa7:

    # DIVINE @ think "{i}And Mika must never know that the letters never arrived.{/i}"
    DIVINE @ think "{i}Y Mika nunca debe saber que las cartas nunca llegaron.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:962
translate es qst_a_best_friends_path_10_cd44bde4:

    # "Understanding that was an order, not a suggestion, I nodded in agreement."
    "Comprendí que era una orden, no una sugerencia, y asentí con la cabeza."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:963
translate es qst_a_best_friends_path_10_a95a5c84:

    # DIVINE @ think "I can sense a great change within Mika... Tomorrow, her training will be complete."
    DIVINE @ think "Puedo sentir un gran cambio dentro de Mika... Mañana, su entrenamiento estará completo."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:965
translate es qst_a_best_friends_path_10_d789b742:

    # MC @ think "How can you be sure?"
    MC @ think "¿Cómo puede estar tan segura?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:966
translate es qst_a_best_friends_path_10_9dc108f5:

    # DIVINE @ happy "She's still afraid... But she's no longer letting it hold her back."
    DIVINE @ happy "Sigue teniendo miedo... Pero ya no deja que la retenga."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:968
translate es qst_a_best_friends_path_10_fe801dfc:

    # "Sister Divine, without another word, almost glided across the floor as she left."
    "La hermana Divine, sin decir una palabra más, casi se desvaneció al marcharse."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:969
translate es qst_a_best_friends_path_10_e9eb2636:

    # "Her expression was stern, but the pain beneath the mask was visible beneath the cracks."
    "Su expresión era severa, pero el dolor bajo la máscara era visible bajo las grietas."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:981
translate es qst_a_best_friends_path_12_796311fa:

    # MIKA @ talk "I - I'm ready for my final test!"
    MIKA @ talk "¡E-estoy preparada para mi prueba final!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:984
translate es qst_a_best_friends_path_12_dbf800f2:

    # MIKA @ smile "This time, I'll definitely win!"
    MIKA @ smile "Esta vez, ¡seguro que ganaré!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:994
translate es qst_a_best_friends_path_12_7b2ca3a2:

    # MIKA @ sad "D-Damn it!"
    MIKA @ sad "¡M-maldita sea!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:995
translate es qst_a_best_friends_path_12_a17c8474:

    # MC @ talk "{i}*Huff*{/i} Don't put yourself down..."
    MC @ talk "{i}*Uff*{/i} No te menosprecies..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:996
translate es qst_a_best_friends_path_12_5aa7d33e:

    # MC @ smile "You're ready, Mika."
    MC @ smile "Estás lista, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:997
translate es qst_a_best_friends_path_12_ea52f159:

    # MIKA @ shock "But... {i}I lost!{/i}"
    MIKA @ shock "Pero... {i}¡Perdí!{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:998
translate es qst_a_best_friends_path_12_251b742b:

    # MC @ smile "Trust me, you can handle a few Demorai."
    MC @ smile "Confía en mí, puedes encargarte de unos cuantos demorai."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:999
translate es qst_a_best_friends_path_12_4a01728e:

    # MC @ smile "{i}You're ready.{/i}"
    MC @ smile "{i}Estás lista.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1001
translate es qst_a_best_friends_path_12_56a568cd:

    # MIKA @ shock "I... {i}I did it!{/i}"
    MIKA @ shock "Yo... {i}¡Lo conseguí!{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1002
translate es qst_a_best_friends_path_12_d3e6b05e:

    # MC @ smile "Well done, Mika."
    MC @ smile "Bien hecho, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1003
translate es qst_a_best_friends_path_12_949782d6:

    # MC @ smile "You're definitely ready."
    MC @ smile "Definitivamente estás lista."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1005
translate es qst_a_best_friends_path_12_805ce692:

    # "Mika leapt into my arms for a tight hug, squealing happily before pulling herself away."
    "Mika saltó a mis brazos para darme un fuerte abrazo, chillando de felicidad antes de separarse."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1006
translate es qst_a_best_friends_path_12_a5cfade8:

    # MIKA @ smile "I did it! I can't believe I actually did it!"
    MIKA @ smile "¡Lo conseguí! ¡No puedo creer que lo haya hecho!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1007
translate es qst_a_best_friends_path_12_48530dcf:

    # MC @ smile "I'll let Sister Divine know you're ready."
    MC @ smile "Le haré saber a la hermana Divine que estás lista."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1009
translate es qst_a_best_friends_path_12_e1e68368:

    # MIKA @ smile "T-Thank you... [player_name!t]."
    MIKA @ smile "G-gracias... [player_name!t]."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1009
translate es qst_a_best_friends_path_12_458cfc4d:

    # MIKA @ smile "For believing in me."
    MIKA @ smile "Por creer en mí."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1010
translate es qst_a_best_friends_path_12_102b4a4c:

    # "As I smiled at her, I could feel the absolute adoration emitting from her eyes."
    "Mientras le sonrío, puedo sentir la adoración absoluta que emana de sus ojos."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1011
translate es qst_a_best_friends_path_12_5789ab10:

    # MC @ smile "You'll do great things, Mika, of that I'm sure."
    MC @ smile "Harás grandes cosas, Mika, de eso estoy seguro."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1017
translate es qst_a_best_friends_path_12_249667d4:

    # MIKA @ talk "M-Mmm, alright!"
    MIKA @ talk "¡M-mmm, está bien!"

