    DIVINE @ sad "E-entiendo que esto probablemente no sea algo que apruebes, pero..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:100
translate es qst_girl_troubles_main_label_menu_4_d23b7c9a:

    # DIVINE @ sad "Kindly keep this knowledge to yourself."
    DIVINE @ sad "Por favor, guárdate este conocimiento para ti."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:101
translate es qst_girl_troubles_main_label_menu_4_7bdaee64:

    # DIVINE @ sad "The girls ... Us Mages of Palam, it's a terribly lonely life."
    DIVINE @ sad "Las chicas... Nosotras las magas de Palam, es una vida terriblemente solitaria."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:102
translate es qst_girl_troubles_main_label_menu_4_e13d3ea2:

    # DIVINE @ sad "The expectations to be these saint-like figures is crushing, especially for those who don't want it."
    DIVINE @ sad "Las expectativas de ser esas figuras santificadas son aplastantes, sobre todo para quienes no lo desean."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:103
translate es qst_girl_troubles_main_label_menu_4_d6fdf35c:

    # DIVINE @ sad "A life without love is terrible, and love to a Mage of Palam is a delicate, often impossible thing to keep."
    DIVINE @ sad "Una vida sin amor es terrible, y el amor para una maga de Palam es algo delicado, a menudo imposible de conservar."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:104
translate es qst_girl_troubles_main_label_menu_4_3a76119c:

    # DIVINE @ sad "But grown women still have needs ... So we find what we can of it amongst ourselves."
    DIVINE @ sad "Pero las mujeres adultas todavía tienen necesidades ... Así que hacemos lo que podemos entre nosotras."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:105
translate es qst_girl_troubles_main_label_menu_4_10285b36:

    # MC @ talk "You don't need to explain yourself to me, sister."
    MC @ talk "No necesitas darme explicaciones, hermana."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:106
translate es qst_girl_troubles_main_label_menu_4_4014a5dc:

    # MC @ talk "I only mentioned it because Mika has asked me to persuade you to give her the same affection as you give the others."
    MC @ talk "Solo lo he mencionado porque Mika me ha pedido que te convenza para que le des el mismo cariño que a las demás."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:107
translate es qst_girl_troubles_main_label_menu_4_c7f64210:

    # DIVINE @ sad "I-"
    DIVINE @ sad "Yo-"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:108
translate es qst_girl_troubles_main_label_menu_4_cc9e4cc1:

    # DIVINE @ talk "I didn't quite realize she felt that way, I never intended to make her feel unwanted."
    DIVINE @ talk "No me di cuenta de que se sentía así, nunca quise hacerla sentir indeseada."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:109
translate es qst_girl_troubles_main_label_menu_4_91c8563f:

    # DIVINE @ embar "... Very well, tell Mika to meet me in the tower bathhouse tonight."
    DIVINE @ embar "... Muy bien, dile a Mika que se reúna conmigo en los baños de la torre esta noche."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:110
translate es qst_girl_troubles_main_label_menu_4_6ab76246:

    # DIVINE @ embar "I shall make it up to her in full."
    DIVINE @ embar "Se lo compensaré con creces."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:94
translate es qst_girl_troubles_main_label_menu_4_ea37f955:

    # DIVINE @ happy "Yes, I've {i}seen.{/i}"
    DIVINE @ happy "Sí, lo he {i}visto.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:95
translate es qst_girl_troubles_main_label_menu_4_ad7cb217:

    # DIVINE @ happy "She's come so much out of her shell since you've started helping her."
    DIVINE @ happy "Ha salido mucho de su caparazón desde que empezaste a ayudarla."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:96
translate es qst_girl_troubles_main_label_menu_4_6648b615:

    # MC @ talk "She's ready to face whatever's out there."
    MC @ talk "Está lista para enfrentarse a lo que sea que haya ahí fuera."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:97
translate es qst_girl_troubles_main_label_menu_4_d48d0774:

    # DIVINE @ talk "Well... No one's truly ever {i}ready.{/i}"
    DIVINE @ talk "Bueno... Nadie está realmente {i}preparado.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:98
translate es qst_girl_troubles_main_label_menu_4_fdf7a669:

    # DIVINE @ talk "But I think now her fate is in the hands of the gods to keep her safe."
    DIVINE @ talk "Pero creo que ahora su destino está en manos de los dioses para mantenerla a salvo."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:96
