translate es strings:

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:125
    old "I think that's it."
    new "Creo que eso es todo."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:76
    old "Have you tried appealing to the higher-ups?"
    new "¿Has intentado apelar a los superiores?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:76
    old "Forgive me, but people die in war... As horrible as it may be Sister, it's almost inevitable some won't come home."
    new "Perdóname, pero la gente muere en la guerra... Por horrible que sea hermana, es casi inevitable que algunos no vuelvan a casa."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:76
    old "I'm still waiting to hear what I have to do with this..."
    new "Todavía estoy esperando que me digas qué tengo que hacer con esto..."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:103
    old "But why ask me?"
    new "Pero, ¿por qué a mí?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:103
    old "What do you mean by {i}you don't care what I do?{/i}"
    new "¿Qué quieres decir con que {i}no te importa lo que haga?{/i}"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:103
    old "Who are the girls?"
    new "¿Quiénes son las chicas?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:117
    old "Is it truly that shameful for them?"
    new "¿Es realmente tan vergonzoso para ellos?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:117
    old "And one of these girls comes from these families, I take it?"
    new "¿Y una de estas chicas viene de estas familias, supongo?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:117
    old "I'll need some time to think on this."
    new "Necesitaré algo de tiempo para pensarlo."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:117
    old "I will help you."
    new "Te ayudaré."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:147
    old "Tell me about Mika."
    new "Háblame de Mika."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:150
    old "Tell me about Jana."
    new "Háblame de Jana."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:150
    old "Tell me about Zara."
    new "Háblame de Zara."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:219
    old "Tell me about the girls again."
    new "Háblame de las chicas otra vez."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:219
    old "I'll get back to you on it shortly."
    new "Te responderé en breve."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:219
    old "Let's meet the girls."
    new "Vamos a conocer a las chicas."
