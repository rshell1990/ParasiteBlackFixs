

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:2
translate es primer_girl_troubles_1_fc4cddb5:

    # MESSENGER "Wait! Hold up!"
    MESSENGER "¡Espera! ¡Un momento!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:3
translate es primer_girl_troubles_1_0ed1380f:

    # "Stopping in my tracks, I turned to face the young boy hurrying towards me."
    "Me paré en seco y me giré para mirar al chico que venía hacia mí."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:5
translate es primer_girl_troubles_1_cc1bdfcf:

    # MC @ think "Can I help you?"
    MC @ think "¿Puedo ayudarte?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:6
translate es primer_girl_troubles_1_b9d4697a:

    # MESSENGER "Sister Divine requests your presence at the tower of Palam at once."
    MESSENGER "La hermana Divine solicita su presencia en la torre de Palam de inmediato."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:7
translate es primer_girl_troubles_1_ff0934a5:

    # MC @ talk "Sister Divine?"
    MC @ talk "¿La hermana Divine?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:8
translate es primer_girl_troubles_1_bef6b9ee:

    # MC @ talk "Did you say why?"
    MC @ talk "¿Dijo por qué?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:9
translate es primer_girl_troubles_1_4755a9a3:

    # MESSENGER "No sir, but she said it was a matter most urgent."
    MESSENGER "No señor, pero dijo que era un asunto muy urgente."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:10
translate es primer_girl_troubles_1_2e49f35d:

    # MESSENGER "Now, if you'll excuse me, I've got to deliver my next message!"
    MESSENGER "Ahora, si me disculpa, ¡tengo que entregar mi próximo mensaje!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:12
translate es primer_girl_troubles_1_bd996885:

    # MC "(Hmm... I should stop by the tower of Palam when I get a chance.)"
    MC "(Hmm... Debería pasarme por la torre de Palam cuando tenga ocasión)."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:22
translate es primer_girl_troubles_2_4fb8f212:

    # DIVINE @ talk "Ah, there you are."
    DIVINE @ talk "Ah, ahí estás."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:23
translate es primer_girl_troubles_2_bd6dbff0:

    # "Divine steps out from behind her desk, a playful glint in her eye as she moves closer."
    "Divine sale de detrás de su escritorio, con un brillo juguetón en los ojos mientras se acerca.."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:24
translate es primer_girl_troubles_2_4630b090:

    # "Without a word, she wraps her arms around me, her lips finding mine in a slow, deliberate kiss."
    "Sin mediar palabra, me rodea con sus brazos y sus labios se encuentran con los míos en un beso lento y pausado."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:25
translate es primer_girl_troubles_2_dd678d35:

    # MC "(Her touch is familiar, warm...)"
    MC "(Su tacto es familiar, cálido...)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:26
translate es primer_girl_troubles_2_01941bc7:

    # "My hand drifts down instinctively, fingers grazing her waist before resting on her backside."
    "Mi mano baja instintivamente, rozando su cintura antes de posarse en su trasero."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:27
translate es primer_girl_troubles_2_e70ed2d3:

    # DIVINE @ happy "Mmm... You never change, do you?"
    DIVINE @ happy "Mmm... Nunca cambias, ¿verdad?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:28
translate es primer_girl_troubles_2_964d7d25:

    # "She lets out a soft, breathy laugh, before gently pushing away, cheeks flushed."
    "Suelta una suave carcajada, antes de apartarse suavemente, con las mejillas sonrojadas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:29
translate es primer_girl_troubles_2_db756b90:

    # MC @ smile "That's quite a desk you’ve got there, you know. I'd love to see you—"
    MC @ smile "Vaya escritorio que tienes ahí. Me encantaría verte—"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:30
translate es primer_girl_troubles_2_ef0995eb:

    # DIVINE @ laugh "Easy, easy! I didn’t call you here for {i}that.{/i}"
    DIVINE @ laugh "¡Tranquilo, tranquilo! No te he llamado para {i}eso.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:31
translate es primer_girl_troubles_2_a93764bb:

    # DIVINE @ happy "Though, maybe later... if there's time."
    DIVINE @ happy "Aunque, tal vez más tarde... si hay tiempo."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:33
translate es primer_girl_troubles_2_dde96000:

    # "Sister Divine stands behind her desk, her expression unreadable as she watches me enter."
    "La hermana Divine está de pie detrás de su escritorio, su expresión es ilegible mientras me observa entrar."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:34
translate es primer_girl_troubles_2_b9dbb770:

    # DIVINE @ talk "It’s good to see you again. I’ve been meaning to speak with you."
    DIVINE @ talk "Me alegro de volver a verte. Quería hablar contigo."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:36
translate es primer_girl_troubles_2_559540db:

    # MC @ talk "So, what's this about?"
    MC @ talk "Entonces, ¿de qué va esto?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:37
translate es primer_girl_troubles_2_1eea1aea:

    # DIVINE @ talk "Tell me, what do you know about the tower?"
    DIVINE @ talk "Dime, ¿qué sabes de la torre?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:38
translate es primer_girl_troubles_2_399a0353:

    # MC @ think "Hm? Not much..."
    MC @ think "¿Hm? No mucho..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:39
translate es primer_girl_troubles_2_63c38e46:

    # MC @ talk "I know mages of Palam are taken from their parents from a young age to join the order."
    MC @ talk "Sé que las magas de Palam son arrebatadas a sus padres desde muy jóvenes para unirse a la orden."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:40
translate es primer_girl_troubles_2_51c5a5cf:

    # DIVINE @ talk "Being a mage is a lifelong commitment, and many start young at one of the smaller holds before coming here."
    DIVINE @ talk "Ser maga es un compromiso para toda la vida, y muchas empiezan jóvenes en una de las sedes más pequeñas antes de venir aquí."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:41
translate es primer_girl_troubles_2_a09d053a:

    # DIVINE @ talk "It's best to think of this tower as a kind of university, but to mages, any hold under their magecraft is considered a second home they're expected to return to throughout their life periodically."
    DIVINE @ talk "Lo mejor es pensar en esta torre como una especie de universidad, pero para las magas, cualquier lugar en el que utilicen magia se considera un segundo hogar al que se espera que vuelvan periódicamente a lo largo de su vida."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:42
translate es primer_girl_troubles_2_eec6e3a7:

    # DIVINE @ talk "Suffice it to say I care for each and every girl who comes here, many of whom I've known to some degree since they were small."
    DIVINE @ talk "Basta decir que me preocupo por todas y cada una de las chicas que vienen aquí, a muchas de las cuales conozco en cierta medida desde que eran pequeñas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:43
translate es primer_girl_troubles_2_df064ee4:

    # MC @ talk "I see... But why the urgent summoning? Where do I fit into all this?"
    MC @ talk "Ya veo... Pero, ¿por qué la convocatoria urgente? ¿Dónde encajo yo en todo esto?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:44
translate es primer_girl_troubles_2_a9467911:

    # DIVINE @ talk "Since this war began, Mages have been, with the end of every terminus ceremony, sent towards the front."
    DIVINE @ talk "Desde que comenzó esta guerra, las magas han sido, con el final de cada ceremonia de terminus, enviadas al frente."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:45
translate es primer_girl_troubles_2_af61e39a:

    # DIVINE @ talk "Thankfully, many of my girls are usually kept back to help deal with the wounded, so losses are limited."
    DIVINE @ talk "Por suerte, muchas de mis chicas suelen quedarse atrás para ayudar a atender a los heridos, por lo que las pérdidas son limitadas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:46
translate es primer_girl_troubles_2_a8a38eea:

    # DIVINE @ talk "With that said, Alcott's government continues to put more and more pressure on getting out the door, regardless of capabilities."
    DIVINE @ talk "Dicho esto, el gobierno de Alcott sigue presionando cada vez más para que salgan, independientemente de sus capacidades."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:47
translate es primer_girl_troubles_2_8241cd14:

    # "Sister Divine paused uncomfortably."
    "La hermana Divine hizo una pausa incómoda."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:48
translate es primer_girl_troubles_2_836dcfe9:

    # DIVINE @ talk "... Last month, four of my girls stationed at a camp were killed by a surprise ambush."
    DIVINE @ talk "...El mes pasado, cuatro de mis chicas estacionadas en un campamento fueron asesinadas por una emboscada sorpresa."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:49
translate es primer_girl_troubles_2_eae6fb6b:

    # DIVINE @ talk "From what reports I have, the girls panicked and fumbled their spells."
    DIVINE @ talk "Por los informes que tengo, las chicas entraron en pánico y lanzaron sus hechizos."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:50
translate es primer_girl_troubles_2_1cd0a9e5:

    # DIVINE @ sad "... They weren't ready."
    DIVINE @ sad "...No estaban preparadas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:51
translate es primer_girl_troubles_2_c3780307:

    # MC @ sad "That's horrible."
    MC @ sad "Eso es horrible."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:52
translate es primer_girl_troubles_2_ead16311:

    # DIVINE @ angry "Standards are slipping..."
    DIVINE @ angry "Los estándares están decayendo..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:53
translate es primer_girl_troubles_2_3eeccae0:

    # DIVINE @ sad "And my girls are dying for it."
    DIVINE @ sad "Y mis chicas se mueren por ello."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:56
translate es primer_girl_troubles_2_menu_685b6d3d:

    # DIVINE @ talk "I've tried."
    DIVINE @ talk "Lo he intentado."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:57
translate es primer_girl_troubles_2_menu_3a9ef15e:

    # DIVINE @ talk "The officials don't care for the quality of Mages, only that there {i}are{/i} Mages."
    DIVINE @ talk "A los oficiales no les importa la calidad de las magas, solo que {i}haya{/i} magas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:58
translate es primer_girl_troubles_2_menu_9c138b9c:

    # DIVINE @ talk "My concerns fall on deaf ears."
    DIVINE @ talk "Mis preocupaciones caen en saco roto."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:61
translate es primer_girl_troubles_2_menu_75a8f7bf:

    # DIVINE @ angry "I am aware people 'die' in war; I'm not a fool."
    DIVINE @ angry "Soy consciente de que la gente 'muere' en la guerra; no soy tonta."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:62
translate es primer_girl_troubles_2_menu_16b704db:

    # DIVINE @ talk "But there are only ever so many mages per year, and magecraft is a lifelong commitment to master."
    DIVINE @ talk "Pero solo hay un número limitado de magas al año, y dominar la magia es un compromiso de por vida."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:63
translate es primer_girl_troubles_2_menu_6917f041:

    # DIVINE @ talk "It's not as simple as replacing a simple grunt... No offense."
    DIVINE @ talk "No es tan simple como reemplazar un simple soldado... Sin ofender."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:64
translate es primer_girl_troubles_2_menu_c8f104a8:

    # MC @ talk "None taken."
    MC @ talk "No me ofendí."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:67
translate es primer_girl_troubles_2_menu_b528cbb1:

    # DIVINE @ talk "Three girls of mine, troublesome issues with each."
    DIVINE @ talk "Tres chicas mías, problemáticas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:68
translate es primer_girl_troubles_2_menu_5be2fe8f:

    # DIVINE @ talk "I've put my foot down and held them back from being assigned to the front."
    DIVINE @ talk "Me he puesto firme y les he impedido ser asignadas al frente."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:69
translate es primer_girl_troubles_2_menu_ac431a22:

    # MC @ talk "Why?"
    MC @ talk "¿Por qué?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:70
translate es primer_girl_troubles_2_menu_e02e14c6:

    # DIVINE @ talk "They're not ready... And I'm not prepared to knowingly send some of my girls to their deaths."
    DIVINE @ talk "No están preparadas... Y no estoy preparada para enviar a sabiendas a algunas de mis chicas a la muerte."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:71
translate es primer_girl_troubles_2_menu_cd04b852:

    # DIVINE @ talk "Now, I don't have time to resolve these issues myself; I have to prepare the next batch of mages, who are already showing similar issues, for next year's terminus ceremony."
    DIVINE @ talk "Ahora, no tengo tiempo para resolver estos problemas por mí misma; tengo que preparar a la próxima promoción de magas, que ya están mostrando problemas similares, para la ceremonia de terminus del año que viene."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:72
translate es primer_girl_troubles_2_menu_97eba329:

    # DIVINE @ talk "I want you to become their... Mentor."
    DIVINE @ talk "Quiero que te conviertas en su... Mentor."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:73
translate es primer_girl_troubles_2_menu_592cb8fe:

    # MC @ surprised "Mentor? Me? I don't even possess any magecraft!"
    MC @ surprised "¿Mentor? ¿Yo? ¡Ni siquiera poseo magia!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:74
translate es primer_girl_troubles_2_menu_f412c6a1:

    # DIVINE @ talk "Ah, but that's where you and your 'gift' come in nicely."
    DIVINE @ talk "Ah, pero ahí es donde tú y tu 'don' vienen muy bien."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:75
translate es primer_girl_troubles_2_menu_70c53a8b:

    # DIVINE @ talk "The Alderian government have refused to send me a mage capable of helping me, so I need the next best thing."
    DIVINE @ talk "El gobierno alderiano se ha negado a enviarme una maga capaz de ayudarme, así que necesito la siguiente mejor opción."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:76
translate es primer_girl_troubles_2_menu_560ed043:

    # DIVINE @ talk "Someone capable of really motivating these girls."
    DIVINE @ talk "Alguien capaz de motivar de verdad a estas chicas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:77
translate es primer_girl_troubles_2_menu_0d85e87a:

    # MC "(Meaning someone she can threaten to blackmail if I ever speak about what I see in here.)"
    MC "(Es decir, alguien a quien pueda amenazar con chantajear si hablo de lo que veo aquí)."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:78
translate es primer_girl_troubles_2_menu_59433de1:

    # MC @ talk "How am I supposed to do that?"
    MC @ talk "¿Cómo se supone que voy a hacerlo?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:79
translate es primer_girl_troubles_2_menu_de2af97e:

    # DIVINE @ talk "The method doesn't concern me; as long as the girls aren't harmed, I don't care what you do. "
    DIVINE @ talk "El método no me preocupa; mientras no hagas daño a las chicas, me da igual lo que hagas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:80
translate es primer_girl_troubles_2_menu_7d5dfde8:

    # DIVINE @ talk "For each girl dealt with, I'll give you seven hundred coins. Does that sound fair?"
    DIVINE @ talk "Por cada chica con la que lidies, te daré setecientas monedas. ¿Te parece justo?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:83
translate es primer_girl_troubles_2_menu_2_270e239c:

    # DIVINE @ talk "Because I need someone I can trust with this,"
    DIVINE @ talk "Porque necesito a alguien en quien pueda confiar esto."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:84
translate es primer_girl_troubles_2_menu_2_bf1e2acc:

    # DIVINE @ talk "And after hearing from Captain Nyx about your recent help with her, it only made sense to ask you."
    DIVINE @ talk "Y después de escuchar de la capitana Nyx sobre tu reciente ayuda con ella, era lógico preguntarte."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:85
translate es primer_girl_troubles_2_menu_2_beee84fb:

    # MC @ talk "Wait ... Captain Nyx?"
    MC @ talk "Espera... ¿La capitana Nyx?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:86
translate es primer_girl_troubles_2_menu_2_2010828e:

    # DIVINE @ talk "The Captain and I are ... {i}often aligned{/i} when necessary."
    DIVINE @ talk "La capitana y yo... {i}solemos alinearnos cuandoo{/i} cuando es necesario."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:87
translate es primer_girl_troubles_2_menu_2_308a2582:

    # DIVINE @ talk "I'd hardly call us friends, but we've come to depend on each other's resources sometimes."
    DIVINE @ talk "Difícilmente diría que somos amigas, pero a veces dependemos de los recursos de la otra."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:90
translate es primer_girl_troubles_2_menu_2_c7d4f56a:

    # DIVINE @ talk "I mean, {i}I don't care what you do.{/i}"
    DIVINE @ talk "Quiero decir, {i}no me importa lo que hagas.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:91
translate es primer_girl_troubles_2_menu_2_8cc9e6dd:

    # DIVINE @ talk "As long as they are not hurt, and you don't make a public spectacle of whatever you do with them, I only care about the end results."
    DIVINE @ talk "Mientras no les hagas daño y no hagas un espectáculo público de lo que hagas con ellas, solo me importan los resultados finales."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:94
translate es primer_girl_troubles_2_menu_2_960647d4:

    # DIVINE @ talk "I cannot tell you until you agree to my request, but I will do my best to answer anymore questions you have."
    DIVINE @ talk "No puedo decírtelo hasta que aceptes mi petición, pero haré todo lo posible por responder a cualquier pregunta que tengas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:97
translate es primer_girl_troubles_2_menu_3_7d9b1b5b:

    # MC @ talk "Mages of Palam are holy ordained, after all."
    MC @ talk "Las magas de Palam son de orden sagrada, después de todo."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:98
translate es primer_girl_troubles_2_menu_3_dfe1bc33:

    # DIVINE @ angry "It is shameful when you're praying for a strong male heir or a daughter that you can marry off to another rich noble."
    DIVINE @ angry "Es vergonzoso cuando rezas por tener un heredero varón fuerte o una hija que puedas casar con otro noble rico."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:99
translate es primer_girl_troubles_2_menu_3_a6aa2eef:

    # DIVINE @ talk "Us Mages of Palam are seen as a dead end."
    DIVINE @ talk "Las magas de Palam somos vistas como un callejón sin salida."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:100
translate es primer_girl_troubles_2_menu_3_5492d872:

    # MC @ talk "But can't Mages of Palam continue a bloodline?"
    MC @ talk "¿Pero no pueden las magas de Palam continuar una línea de sangre?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:101
translate es primer_girl_troubles_2_menu_3_778e69e4:

    # MC @ talk "You can sire young with women and can get pregnant yourselves, can you not?"
    MC @ talk "Podéis engendrar jóvenes con mujeres y quedaros embarazadas vosotras mismas, ¿no?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:102
translate es primer_girl_troubles_2_menu_3_df70b7f3:

    # MC @ think "How then are you a dead end?"
    MC @ think "¿Cómo, entonces, sois un callejón sin salida?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:103
translate es primer_girl_troubles_2_menu_3_d60e62c4:

    # "Sister Divine smiled."
    "La hermana Divine sonrió."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:104
translate es primer_girl_troubles_2_menu_3_b412a3ab:

    # DIVINE @ happy "It's best not to dwell on such things; we're an uncomfortable blot they've had to learn to accept and tolerate {i}on their terms.{/i}"
    DIVINE @ happy "Es mejor no pensar en esas cosas; somos una incómoda mancha que han tenido que aprender a aceptar y tolerar {i}a su manera.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:105
translate es primer_girl_troubles_2_menu_3_7a2d28cb:

    # DIVINE @ talk "They prefer the fantasy of us as saint like beings, not real people with real wants and desires."
    DIVINE @ talk "Prefieren la fantasía de vernos como seres semejantes a santos, no como personas reales con deseos y anhelos reales."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:108
translate es primer_girl_troubles_2_menu_3_6d652bd9:

    # DIVINE @ talk "Yes, to which I expect you to speak to no one."
    DIVINE @ talk "Sí, a lo que espero que no hables con nadie."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:109
translate es primer_girl_troubles_2_menu_3_198ed38b:

    # DIVINE @ talk "I cannot stress how important these families expect privacy."
    DIVINE @ talk "No puedo insistir en lo importante que es para estas familias la privacidad."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:110
translate es primer_girl_troubles_2_menu_3_1cf3949f:

    # DIVINE @ talk "If they believe we're making a spectacle, those {i}generous donations{/i} will very quickly dry up."
    DIVINE @ talk "Si creen que estamos dando un espectáculo, esas {i}generosas donaciones{/i} se agotarán rápidamente."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:218
translate es primer_girl_troubles_2_menu_5_1c582cf8:

    # DIVINE @ talk "Of course, but please, give me your answer soon ... Time is a luxury we don't have."
    DIVINE @ talk "Por supuesto, pero por favor, respóndeme pronto... El tiempo es un lujo que no nos podemos permitir."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:119
translate es primer_girl_troubles_2_menu_3_186c3225:

    # DIVINE @ happy "Good, it pleases me to hear that."
    DIVINE @ happy "Bien, me complace oír eso."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:120
translate es primer_girl_troubles_2_menu_3_c4dc71ec:

    # MC @ talk "So what now?"
    MC @ talk "¿Y ahora qué?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:121
translate es primer_girl_troubles_2_menu_3_1f4f778f:

    # DIVINE @ talk "Now you've agreed, I can talk more about the girls in question."
    DIVINE @ talk "Ahora que estás de acuerdo, puedo hablar más sobre las chicas en cuestión."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:122
translate es primer_girl_troubles_2_menu_3_edbe2a65:

    # DIVINE @ talk "There's Jana, Zara and Mika."
    DIVINE @ talk "Están Jana, Zara y Mika."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:123
translate es primer_girl_troubles_2_menu_3_a7336069:

    # DIVINE @ talk "Which one do you want to know about?"
    DIVINE @ talk "¿Sobre cuál quieres saber?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:127
translate es primer_girl_troubles_2_menu_4_c8c3f0f1:

    # DIVINE @ talk "Ah, Jana Rosenval..."
    DIVINE @ talk "Ah, Jana Rosenval..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:128
translate es primer_girl_troubles_2_menu_4_c2684d19:

    # DIVINE @ talk "Her abilities are extremely promising, and she is one of the highest potential candidates I've seen in years."
    DIVINE @ talk "Sus habilidades son extremadamente prometedoras, y es una de las candidatas con mayor potencial que he visto en años."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:129
translate es primer_girl_troubles_2_menu_4_53984bd0:

    # MC @ talk "Then what's the issue?"
    MC @ talk "Entonces, ¿cuál es el problema?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:130
translate es primer_girl_troubles_2_menu_4_6461bc7c:

    # DIVINE @ angry "Her attitude."
    DIVINE @ angry "Su actitud."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:131
translate es primer_girl_troubles_2_menu_4_0751d562:

    # DIVINE @ angry "She's been consistently troublesome for as long as I've known her, but the situation this last year has spiraled completely out of hand."
    DIVINE @ angry "Ha sido siempre problemática desde que la conozco, pero la situación este último año se ha descontrolado."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:132
translate es primer_girl_troubles_2_menu_4_587a4d08:

    # MC @ talk "How {i}'out of hand?'{/i}"
    MC @ talk "¿Cómo de {i}'fuera de control?'{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:133
translate es primer_girl_troubles_2_menu_4_d7b30e0f:

    # DIVINE @ talk "Setting a lecture hall on fire, sneaking out and being caught dancing topless at a tavern, constantly getting it brawls with the other girls... The list goes on."
    DIVINE @ talk "Prender fuego a una sala de conferencias, escaparse y ser pillada bailando en topless en una taberna, meterse constantemente en peleas con las otras chicas... La lista continúa."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:134
translate es primer_girl_troubles_2_menu_4_4890c460:

    # MC @ talk "Any idea what's causing the trouble?"
    MC @ talk "¿Alguna idea de cuál es la causa del problema?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:135
translate es primer_girl_troubles_2_menu_4_3d603c8c:

    # DIVINE @ talk "She does come from a particularly {i}'troubled'{/i} home, and it's always been a difficult subject for her to talk about."
    DIVINE @ talk "Procede de un hogar especialmente {i}'conflictivo'{/i} y siempre le ha resultado difícil hablar de ello."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:136
translate es primer_girl_troubles_2_menu_4_fe36ef6d:

    # MC @ talk "How troubled?"
    MC @ talk "¿Cómo de conflictivo?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:137
translate es primer_girl_troubles_2_menu_4_08cdecc7:

    # DIVINE @ talk "There were signs of physical abuse, but she's never been willing to talk about it."
    DIVINE @ talk "Había indicios de maltrato físico, pero nunca ha querido hablar de ello."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:138
translate es primer_girl_troubles_2_menu_4_d0271e56:

    # DIVINE @ talk "I need you to help curb her personality issues and deal with whatever's going on in her head."
    DIVINE @ talk "Necesito que la ayudes a frenar sus problemas de personalidad y a lidiar con lo que sea que esté pasando por su cabeza."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:143
translate es primer_girl_troubles_2_menu_4_5087813e:

    # DIVINE @ talk "Hm, yes, Zara Dawnmoore."
    DIVINE @ talk "Hm, sí, Zara Dawnmoore."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:144
translate es primer_girl_troubles_2_menu_4_15776ea7:

    # DIVINE @ talk "She comes from a wealthy aristocratic family from the south before the war forced them to flee North."
    DIVINE @ talk "Procede de una familia aristocrática acomodada del sur antes de que la guerra les obligara a huir al norte."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:145
translate es primer_girl_troubles_2_menu_4_f90c3862:

    # DIVINE @ talk "She was a perfect student during her time here, consistently scoring highest on her arcane knowledge and abilities."
    DIVINE @ talk "Fue una alumna perfecta durante su estancia aquí, obteniendo siempre las mejores notas en sus conocimientos y habilidades arcanas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:146
translate es primer_girl_troubles_2_menu_4_8e5d193b:

    # DIVINE @ talk "Then, during the terminus ceremony, the {i}'incident'{/i} occurred."
    DIVINE @ talk "Entonces, durante la ceremonia de terminus, se produjo el {i}'incidente'{/i}."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:147
translate es primer_girl_troubles_2_menu_4_caee25ea:

    # MC @ think "The 'incident?'"
    MC @ think "¿El 'incidente'?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:148
translate es primer_girl_troubles_2_menu_4_7a8a5198:

    # DIVINE @ talk "Before the ceremony, Zara was reported to be in high spirits, if a little tense and on edge."
    DIVINE @ talk "Antes de la ceremonia, se dice que Zara estaba de buen humor, aunque un poco tensa y nerviosa."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:149
translate es primer_girl_troubles_2_menu_4_601dc7e4:

    # DIVINE @ talk "But the same could be said of any of the mages at the time, so it was dismissed as the usual pre-ceremony anxiety."
    DIVINE @ talk "Pero lo mismo podría decirse de cualquiera de las magas en ese momento, por lo que se descartó como la ansiedad habitual previa a la ceremonia."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:150
translate es primer_girl_troubles_2_menu_4_7d354705:

    # DIVINE @ talk "A short while after the ceremony, however, Zara received a letter from her parents, who couldn't attend."
    DIVINE @ talk "Sin embargo, poco después de la ceremonia, Zara recibió una carta de sus padres, que no pudieron asistir."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:151
translate es primer_girl_troubles_2_menu_4_305b4b7a:

    # DIVINE @ talk "She burned the letter before anyone could read it, but whatever was in that letter triggered something within her."
    DIVINE @ talk "Quemó la carta antes de que nadie pudiera leerla, pero lo que contenía desencadenó algo en su interior."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:152
translate es primer_girl_troubles_2_menu_4_11d29735:

    # DIVINE @ talk "In the night, she went on a rampage, attacking everyone in sight."
    DIVINE @ talk "Por la noche, se puso frenética y atacó a todo el que encontraba a su paso."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:153
translate es primer_girl_troubles_2_menu_4_91d2d69a:

    # DIVINE @ talk "It took myself and two other high mages to restrain her abilities, and in the meanwhile, over a dozen students were hurt."
    DIVINE @ talk "Fuimos necesarios otros dos magas superiores y yo para contener sus habilidades y, mientras tanto, más de una docena de estudiantes resultaron heridas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:154
translate es primer_girl_troubles_2_menu_4_a4d6ed27:

    # DIVINE @ talk "We thought it might have been {i}'Mages madness,'{/i} but there was no sign of it."
    DIVINE @ talk "Pensamos que podría haber sido {i}'La locura de los magos,'{/i} pero no había señales de ello."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:155
translate es primer_girl_troubles_2_menu_4_cffae37d:

    # MC @ talk "What was in the letter?"
    MC @ talk "¿Qué contenía la carta?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:156
translate es primer_girl_troubles_2_menu_4_af9b8334:

    # DIVINE @ talk "We don't know, and Zara won't say."
    DIVINE @ talk "No lo sabemos, y Zara no lo dirá."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:157
translate es primer_girl_troubles_2_menu_4_b98ef904:

    # DIVINE @ talk "Now Zara is pretending she had some momentary lapse of judgment and is acting her usual self again."
    DIVINE @ talk "Ahora Zara finge que ha tenido un lapsus momentáneo y vuelve a ser la de siempre."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:158
translate es primer_girl_troubles_2_menu_4_42755e18:

    # DIVINE @ talk "I'm not going to risk sending her out knowing she could explode at any moment."
    DIVINE @ talk "No voy a arriesgarme a mandarla fuera sabiendo que puede explotar en cualquier momento."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:159
translate es primer_girl_troubles_2_menu_4_3b071047:

    # MC @ talk "I don't remember hearing about this incident anywhere?"
    MC @ talk "¿No recuerdo haber oído hablar de este incidente en ningún sitio?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:160
translate es primer_girl_troubles_2_menu_4_9d1d538f:

    # DIVINE @ talk "That's because we've buried it and managed the incident in-house ... For now, at least."
    DIVINE @ talk "Eso es porque lo hemos ocultado y hemos gestionado el incidente internamente... Al menos por ahora."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:161
translate es primer_girl_troubles_2_menu_4_c4225b75:

    # DIVINE @ talk "I need you to get to the bottom of this issue and deal with it ... fast."
    DIVINE @ talk "Necesito que llegues al fondo de este asunto y lo resuelvas... rápido."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:188
translate es primer_girl_troubles_2_menu_4_1469252a:

    # DIVINE @ talk "Yes, Mika Ursan, a lovely girl."
    DIVINE @ talk "Ah, Mika Ursan, una chica encantadora."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:167
translate es primer_girl_troubles_2_menu_4_a993509d:

    # DIVINE @ talk "Afraid of her own shadow, but lovely."
    DIVINE @ talk "Temerosa de su propia sombra, pero encantadora."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:168
translate es primer_girl_troubles_2_menu_4_6e2f9ef2:

    # MC @ talk "{i}Afraid of her own shadow?{/i}"
    MC @ talk "{i}¿Temerosa de su propia sombra?{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:169
translate es primer_girl_troubles_2_menu_4_dd45cd20:

    # DIVINE @ laugh "I know, I know, but believe me—she panics at the sight of a sparring partner."
    DIVINE @ laugh "Lo sé, lo sé, pero créeme, se asusta al ver a un compañero de entrenamiento."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:170
translate es primer_girl_troubles_2_menu_4_c2e8c608:

    # DIVINE @ talk "Mika's an odd case; her family adore her and refused to hand her over till much, {i}much{/i} later than we usually take on mages."
    DIVINE @ talk "Mika es un caso extraño; su familia la adora y se negó a entregarla hasta mucho, {i}mucho{/i} más tarde de lo que solemos aceptar a las magas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:171
translate es primer_girl_troubles_2_menu_4_cf3cdd5f:

    # DIVINE @ talk "As such, she has a strong natural sense of her abilities despite displaying very average arcane knowledge."
    DIVINE @ talk "Como tal, tiene un fuerte sentido natural de sus habilidades a pesar de mostrar un conocimiento arcano muy mediocre."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:172
translate es primer_girl_troubles_2_menu_4_11d4c714:

    # MC @ talk "So, what's the issue?"
    MC @ talk "Entonces, ¿cuál es el problema?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:173
translate es primer_girl_troubles_2_menu_4_138e55c7:

    # DIVINE @ talk "{i}The girl is terrified of fighting...{/i}"
    DIVINE @ talk "{i}A la chica le aterroriza luchar...{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:174
translate es primer_girl_troubles_2_menu_4_154fbaad:

    # DIVINE @ talk "She completely failed in any and all practical combat training classes previously."
    DIVINE @ talk "Fracasó completamente en todas y cada una de las clases prácticas de entrenamiento de combate anteriores."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:175
translate es primer_girl_troubles_2_menu_4_bd85b2d5:

    # DIVINE @ talk "She just ... cowered."
    DIVINE @ talk "Ella simplemente... se acobardó."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:176
translate es primer_girl_troubles_2_menu_4_9c43d061:

    # MC @ talk "Then how has she got this far?"
    MC @ talk "Entonces, ¿cómo ha llegado tan lejos?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:177
translate es primer_girl_troubles_2_menu_4_5bcd82c2:

    # DIVINE @ talk "Because practical combat for mages of the Palam is the one thing you {i}can{/i} still fail at and still be allowed to serve in the rear as a healer."
    DIVINE @ talk "Porque el combate práctico para las magas de Palam es la única cosa en la que {i}puedes{/i} fallar y aún así se te permite servir en la retaguardia como sanadora."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:178
translate es primer_girl_troubles_2_menu_4_6272c3d1:

    # DIVINE @ angry "Suffice it to say this push to get mages to the front in quantity rather than quality has been a great source of tension between the council of Mages and the Alderian government."
    DIVINE @ angry "Cabe decir que esta presión para que las magas vayan al frente en cantidad y no en calidad ha sido una gran fuente de tensiones entre el consejo de magos y el gobierno alderiano."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:179
translate es primer_girl_troubles_2_menu_4_86ac58e5:

    # DIVINE @ talk "Now, whilst combat isn't the priority for a mage of Palam, {i}I firmly believe every mage must be able to defend herself in times of crisis.{/i}"
    DIVINE @ talk "Ahora bien, aunque el combate no es la prioridad para una maga de Palam, {i}creo firmemente que toda maga debe ser capaz de defenderse en tiempos de crisis.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:180
translate es primer_girl_troubles_2_menu_4_99e3957b:

    # "Sister Divine's face fell darkly."
    "El rostro de la hermana Divine se ensombreció."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:181
translate es primer_girl_troubles_2_menu_4_a90549ec:

    # DIVINE @ sad "If the recent deaths are anything to go by ... I've only been proven right."
    DIVINE @ sad "Si las recientes muertes son algo a tener en cuenta ... Solo me han dado la razón."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:182
translate es primer_girl_troubles_2_menu_4_8ab36be3:

    # MC @ think "So, you want me to train the girl to fight?"
    MC @ think "Entonces, ¿quieres que entrene a la chica para luchar?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:183
translate es primer_girl_troubles_2_menu_4_bd65f2f7:

    # DIVINE @ talk "I need you to teach her to conquer her fears."
    DIVINE @ talk "Necesito que le enseñes a vencer sus miedos."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:184
translate es primer_girl_troubles_2_menu_4_d6ca7303:

    # DIVINE @ talk "She {i}has{/i} to be able to fight if the time comes."
    DIVINE @ talk "{i}Tiene{/i} que ser capaz de luchar si llega el momento."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:185
translate es primer_girl_troubles_2_menu_4_3a9c4c09:

    # MC @ talk "And if she refuses to listen? She's an adult now; she doesn't have to listen to either of us."
    MC @ talk "¿Y si se niega a escuchar? Ya es adulta; no tiene por qué escucharnos a ninguno de los dos."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:186
translate es primer_girl_troubles_2_menu_4_88df11d8:

    # DIVINE @ talk "I don't care {i}how{/i} you get her to agree, but I need to know she can handle herself out there."
    DIVINE @ talk "No me importa {i}cómo{/i} consigas que acepte, pero necesito saber que puede arreglárselas sola ahí fuera."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:193
translate es primer_girl_troubles_2_menu_4_89c9874e:

    # DIVINE @ talk "Now then, should I introduce you to the girls?"
    DIVINE @ talk "Entonces, ¿te presento a las chicas?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:196
translate es primer_girl_troubles_2_menu_5_ecf2e41a:

    # DIVINE @ talk "Alright, which one?"
    DIVINE @ talk "Muy bien, ¿cuál?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:200
translate es primer_girl_troubles_2_menu_5_29b7d599:

    # DIVINE @ talk "Return as soon as you can ... I want this trouble behind me sooner rather than later."
    DIVINE @ talk "Vuelve tan pronto como puedas... Quiero que este problema quede resuelto cuanto antes."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:206
translate es primer_girl_troubles_2_menu_5_190030f6:

    # DIVINE @ talk "Alright, come with me, I shall introduce you."
    DIVINE @ talk "De acuerdo, ven conmigo, te presentaré.."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:218
translate es primer_girl_troubles_2_menu_5_aa4cc931:

    # "A short journey later to the girl's dorm..."
    "Un corto viaje después al dormitorio de las chicas..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:219
translate es primer_girl_troubles_2_menu_5_edf5f908:

    # "Upon entering the girls' dorm, the immediate warmth of the room hit me from the warm blazing fire."
    "Al entrar en el dormitorio de las chicas, el cálido fuego de la habitación me golpeó de inmediato."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:220
translate es primer_girl_troubles_2_menu_5_81e60903:

    # "We all knew mages had it easy compared to the rest of us, even young apprentices, but this was leaps and bounds ahead of my experiences."
    "Todos sabíamos que las magas lo tenían fácil en comparación con el resto de nosotros, incluso las jóvenes aprendices, pero esto estaba muy por encima de mis expectativas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:221
translate es primer_girl_troubles_2_menu_5_7883e851:

    # DIVINE @ happy "Girls! Come!"
    DIVINE @ happy "¡Chicas! ¡Venid!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:225
translate es primer_girl_troubles_2_menu_5_40b40c14:

    # "Sister Divine clapped her hands, and two girls approached, one, the blonde, still yawning after she rolled herself off the side of her bed before dragging herself towards us."
    "La hermana Divine dio una palmada y dos chicas se acercaron, una de ellas, la rubia, aún bostezaba después de rodar por un lado de la cama antes de arrastrarse hacia nosotros."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:226
translate es primer_girl_troubles_2_menu_5_7a248ec2:

    # "When the two girls saw me, the dark-haired one remained stoically unmoved, but the blonde blushed and smiled."
    "Cuando las dos chicas me vieron, la de pelo oscuro permaneció estoicamente impasible, pero la rubia se sonrojó y sonrió."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:227
translate es primer_girl_troubles_2_menu_5_ce372275:

