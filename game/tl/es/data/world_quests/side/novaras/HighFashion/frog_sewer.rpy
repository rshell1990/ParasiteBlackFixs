

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:9
translate es palam_sewer_2a5939df:

    # "Following Sister Divine, we headed down into the bowels of the tower."
    "Siguiendo a la hermana Divine, bajamos a las entrañas de la torre."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:10
translate es palam_sewer_cad52b41:

    # "Every so often, as we descended the long, winding and increasingly dark staircases lit only by flickering torchlight, we’d hear a loud thump followed by the vibrating of the tower."
    "De vez en cuando, mientras descendíamos por las largas, tortuosas y cada vez más oscuras escaleras iluminadas únicamente por la luz parpadeante de las antorchas, oíamos un fuerte golpe seguido del vibrar de la torre."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:17
translate es palam_sewer_f7814228:

    # MC @ talk "What was that?"
    MC @ talk "¿Qué ha sido eso?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:11
translate es palam_sewer_9d82aa79:

    # DIVINE "I know not... It only began after we closed off the Sub-Basement following the incident."
    DIVINE "No lo sé... Solo comenzó después de que cerramos el subsótano tras el incidente."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:19
translate es palam_sewer_8ef5b3e2:

    # MC @ talk "... Hmm."
    MC @ talk "... Hmm."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:20
translate es palam_sewer_d0d77fa0:

    # "At the bottom level of the dark and dreary tower, I was led towards a vault like oval door, sealed by a glowing blue aura that pulsated and acted as a barrier to keep whatever was on the other side trapped."
    "En el nivel inferior de la oscura y lúgubre torre, me guió hacia una puerta ovalada parecida a una bóveda, sellada por un aura azul brillante que palpitaba y actuaba como barrera para mantener atrapado a lo que hubiera al otro lado."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:21
translate es palam_sewer_c433ed2a:

    # "Lightly touching its surface with my finger, I felt a zap of pain course through me."
    "Al tocar ligeramente su superficie con el dedo, sentí que me recorría un zumbido de dolor."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:22
translate es palam_sewer_dac17ae4:

    # MC @ surprised "Ah!"
    MC @ surprised "¡Ah!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:16
translate es palam_sewer_6066cd54:

    # DIVINE "This is the best we could do in the meanwhile."
    DIVINE "Esto es lo mejor que hemos podido hacer mientras tanto."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:17
translate es palam_sewer_477e7002:

    # DIVINE "We heard a few screams from those still trapped inside but... we haven’t heard any for a while now."
    DIVINE "Oímos algunos gritos de los que seguían atrapados dentro, pero... hace tiempo que no oímos ninguno."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:25
translate es palam_sewer_44f83648:

    # "With a swipe of her hand, the glowing blue began to dissipate, and the opening into the darkness was now clear."
    "Con un movimiento de la mano, el resplandor azul comenzó a disiparse y la abertura hacia la oscuridad quedó despejada."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:19
translate es palam_sewer_8c222c78:

    # DIVINE "Be careful in there..."
    DIVINE "Ten cuidado ahí dentro..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:27
translate es palam_sewer_2678af05:

    # MC @ talk "Is there no one to assist me?"
    MC @ talk "¿No hay nadie que me ayude?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:21
translate es palam_sewer_6a99a3f3:

    # DIVINE "I cannot risk any more of our own."
    DIVINE "No puedo arriesgar a más de las nuestras."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:22
translate es palam_sewer_439ea3b0:

    # DIVINE "Good luck to you."
    DIVINE "Que tengas suerte."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:31
translate es palam_sewer_86213208:

    # MC @ talk "{i}*Sigh*{/i} Here goes nothing..."
    MC @ talk "{i}*Suspiro*{/i} Que sea lo que los dioses quieran..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:35
translate es palam_sewer_de061c7f:

    # "Stepping into the vault, the blue shield once again rose from behind, trapping me inside the dark forsaken caverns of the Palam Tower."
    "Al entrar en la bóveda, el escudo azul volvió a alzarse por detrás, atrapándome en las oscuras cavernas abandonadas de la torre Palam."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:36
translate es palam_sewer_d3a550c9:

    # MC "Why did I agree to this? This was a terrible idea."
    MC "¿Por qué acepté esto? Fue una idea terrible."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:37
translate es palam_sewer_6f415419:

    # MC "Alright... I guess I better head further inside and then change when I’m out of sight of Divine."
    MC "Bueno... Supongo que será mejor que vaya más adentro y me cambie cuando esté fuera de la vista de Divine."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:38
translate es palam_sewer_fc2d2f23:

    # MC "Hopefully I won’t get eaten before then..."
    MC "Espero que no me coman antes..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:41
translate es palam_sewer_4876225d:

    # "Down in the depths of the Sub-Basement, I transformed into my ‘other’ form."
    "En las profundidades del subsuelo, me transformé en mi ‘otra’ forma."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:45
translate es palam_sewer_a87a791a:

    # "It was damp and cold down here, a place the mages rarely trod unless performing the most dangerous of spells."
    "Era húmedo y frío, un lugar que los magos rara vez pisaban a menos que realizaran los hechizos más peligrosos."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:46
translate es palam_sewer_748a18cd:

    # "I could see better once transformed, through a red tint I could make out shapes, the tiled ground and more as I patrolled through the eerily quiet halls."
    "Podía ver mejor una vez transformado, a través de un tinte rojo podía distinguir formas, el suelo de baldosas y más mientras patrullaba por los pasillos inquietantemente silenciosos."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:47
translate es palam_sewer_bc98682c:

    # "Every so often I’d find a body or two, poor unlucky souls who had failed to make it out in time."
    "De vez en cuando encontraba uno o dos cadáveres, pobres almas desafortunadas que no habían logrado salir a tiempo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:48
translate es palam_sewer_927ac599:

    # "They were mangled with flies crawling around the old, now festering wounds."
    "Estaban destrozadas y las moscas se arrastraban por las viejas heridas, ahora supurantes."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:49
translate es palam_sewer_9f79d839:

    # "Dried blood stained the walls, and as I inspected the wounds, I wondered what sort of creature could have done this?"
    "Sangre seca manchaba las paredes y, mientras inspeccionaba las heridas, me preguntaba qué clase de criatura podría haber hecho esto."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:50
translate es palam_sewer_98510b84:

    # "As I smelt the air, something wretched and rotten drew me deeper into the labyrinthine tunnels of the Sub-Basement."
    "Mientras olía el aire, algo miserable y podrido me arrastró más profundamente hacia los laberínticos túneles del subsótano."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:51
translate es palam_sewer_366e166c:

    # "Finally, I arrived upon what seemed to be the site of the summoning, the white chalk now stained with dried blood splatters as corpses littered around the room had been moved and piled up into a decaying mound of death."
    "Finalmente, llegué a lo que parecía ser el lugar de la invocación, la tiza blanca ahora manchada con salpicaduras de sangre seca mientras los cadáveres esparcidos por la habitación habían sido movidos y amontonados en un decadente montículo de muerte."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:52
translate es palam_sewer_005bb15e:

    # "From the small signs of struggle, it had been a massacre in here."
    "Por las escasas señales de lucha, esto había sido una masacre."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:53
translate es palam_sewer_cbd77677:

    # "Inexperienced mages conjuring up something beyond what they could possibly hope to control..."
    "Magas inexpertos conjurando algo más allá de lo que podrían esperar controlar..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:54
translate es palam_sewer_4fef6a9e:

    # "We had heard of such stories before but... seeing the result up close and personal was one of the more horrifying things I’d had to bear witness to."
    "Habíamos oído hablar de esas historias antes, pero... ver el resultado de cerca y en persona era una de las cosas más horripilantes de las que había tenido que ser testigo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:55
translate es palam_sewer_a449b1e2:

    # "Suddenly, a loud rumbling sound could be heard as a rhythmic stomping seemed to shake the walls around me."
    "De repente, se oyó un fuerte estruendo mientras un pisotón rítmico parecía sacudir las paredes que me rodeaban."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:56
translate es palam_sewer_98ad3b39:

    # "Looking towards one of the dark halls leading out, I could hear the thing coming closer towards me."
    "Mirando hacia uno de los pasillos oscuros que daban al exterior, pude oír cómo la cosa se acercaba a mí."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:57
translate es palam_sewer_8bb109c5:

    # "Hiding behind a pillar, I waited and watched for whatever was approaching from the shadows."
    "Escondido detrás de una columna, esperé y observé lo que se acercaba desde las sombras."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:61
translate es palam_sewer_279cdf3c:

    # "Appearing through the darkness, a giant green frog-like creature sprung its way forward."
    "Apareciendo a través de la oscuridad, una gigantesca criatura verde parecida a una rana se abrió paso hacia delante."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:62
translate es palam_sewer_72148ff0:

    # "It’s eyes blinking independently of one another as it looked around at the many corpses on the floor."
    "Sus ojos parpadeaban independientemente unos de otros mientras observaba los numerosos cadáveres del suelo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:63
translate es palam_sewer_478bfa2b:

    # "Its tongue snapped out, grabbing one of the decaying bodies before lurching it into its mouth."
    "Sacó la lengua, cogió uno de los cuerpos putrefactos y se lo metió en la boca."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:64
translate es palam_sewer_0d31b390:

    # "Its razor teeth chomped down, gnawing at the bones which snapped with the movement of its jaws."
    "Sus afilados dientes mordisqueaban los huesos, que se rompían con el movimiento de sus mandíbulas."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:65
translate es palam_sewer_b6e494ab:

    # "Hideous to behold, the creature smelled of some deep rot and mould as its mouth dripped old blood from the corpse it chewed."
    "Horrible a la vista, la criatura olía a podredumbre profunda y moho mientras su boca goteaba sangre vieja del cadáver que masticaba."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:66
translate es palam_sewer_ebdaed43:

    # "Its back was covered in thick black and sickly yellow spikes that seemed to tingle with the cold air, as if sensing for the slightest vibrations."
    "Su espalda estaba cubierta de gruesas púas negras y amarillas que parecían hormiguear con el aire frío, como si percibieran las más leves vibraciones."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:67
translate es palam_sewer_e0db2096:

    # "Suddenly, the thing stopped chewing... Letting the mangled body roll out of its mouth and slip almost comically to the floor, it raised its snout and sniffed into the air, taking deep guttural breaths."
    "De repente, la cosa dejó de masticar... Dejó que el cuerpo destrozado saliera rodando de su boca y resbalara casi cómicamente hasta el suelo, levantó el hocico y olfateó el aire, respirando profundamente de forma gutural."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:68
translate es palam_sewer_b8f57e6b:

    # MC "... Does it know I’m here?"
    MC "...¿Sabe que estoy aquí?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:69
translate es palam_sewer_e365d7bb:

    # "Suddenly, its tongue lashed out, tearing away the pillar I was hiding behind!"
    "¡De repente, sacó la lengua, arrancando el pilar tras el que me escondía!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:70
translate es palam_sewer_5dc3baef:

    # MC "...!"
    MC "¡...!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:71
translate es palam_sewer_119abfd8:

    # MC "Well, I guess that answers that!"
    MC "Bueno, ¡supongo que eso lo responde!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:72
translate es palam_sewer_2cc0083f:

    # MC "There’s no choice now!"
    MC "¡Ya no hay elección!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:86
translate es palam_sewer_e70f4666:

    # "As the thing weaved drowsily back and forth, blood seeping from its wounds and mouth, it heaved and shuddered before collapsing onto its side."
    "Mientras la cosa se movía somnolienta de un lado a otro, con la sangre manando de sus heridas y su boca, se agitó y se estremeció antes de desplomarse."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:87
translate es palam_sewer_983f46aa:

    # "Its tongue flopped in defeat as it took one last long ragged breath, inflating its stomach before it simply fizzled out in a slow, pitiful death."
    "Se le cayó la lengua y respiró por última vez, inflando el estómago antes de desvanecerse en una muerte lenta y lastimosa."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:88
translate es palam_sewer_66fc34db:

    # MC "{i}*Huff*{/i} Where did that thing come from?"
    MC "{i}*Uff*{/i} ¿De dónde salió esa cosa?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:89
translate es palam_sewer_e39751b3:

    # BLACK "This creature has proven formidable... We should consider training to enhance our combat abilities further should other predators arrive."
    BLACK "Esta criatura ha demostrado ser formidable... Deberíamos considerar entrenarnos para mejorar nuestras habilidades de combate en caso de que lleguen otros depredadores."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:90
translate es palam_sewer_7ae248df:

    # MC "Ha, thanks for the tip, captain obv—"
    MC "Ja, gracias por el consejo, capitán obv—"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:92
translate es palam_sewer_e4b6b435:

    # "The tongue suddenly lashed out, wrapping around my ankle as it tripped me up onto the cold, wet floor."
    "De repente, la lengua me rodeó el tobillo y me hizo tropezar con el suelo frío y húmedo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:93
translate es palam_sewer_d28c61d4:

    # MC "SHIT!"
    MC "¡MIERDA!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:94
translate es palam_sewer_e8a960a5:

    # "Dragging me towards its gaping maw of a mouth, I glared at the dozen or so razor teeth waiting to gnash and grind my bones, one desperate last meal for a dying beast."
    "Arrastrándome hacia las fauces abiertas de su boca, miré la docena de dientes afilados que esperaban roer y triturar mis huesos, una última comida desesperada para una bestia moribunda."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:89
translate es palam_sewer_65c814be:

    # "Just before it's jaws landed on me, a sparkling blast of magic energy hit the beast."
    "Justo antes de que sus mandíbulas cayeran sobre mí, una explosión brillante de energía mágica golpeó a la bestia."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:91
translate es palam_sewer_182917d6:

    # "The monster wailed and cried out desperately."
    "El monstruo gemía y gritaba desesperadamente."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:99
translate es palam_sewer_b4926bc7:

    # "Finally, it dropped to the floor motionless, and the thing’s eyes rolled deathly white as it lay still again."
    "Finalmente, cayó al suelo inmóvil, y los ojos de la cosa se pusieron blancos como la muerte mientras volvía a quedarse inmóvil."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:105
translate es palam_sewer_f0470a4e:

    # "Stood above me was Divine who flung her blade aside and smiled."
    "Encima de mí estaba Divine, que apartó su espada y sonrió."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:99
translate es palam_sewer_02934deb:

    # DIVINE "{i}I knew it...{/i}"
    DIVINE "{i}Lo sabía...{/i}"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:100
translate es palam_sewer_36aff0e0:

    # DIVINE "I knew you weren’t entirely human."
    DIVINE "Sabía que no eras del todo humano."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:108
translate es palam_sewer_9e2faf03:

    # MC "Wait! I can explain!"
    MC "¡Espera! ¡Puedo explicarlo!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:102
translate es palam_sewer_95553f22:

    # DIVINE "No need, I do not care."
    DIVINE "No hace falta, no me importa."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:110
translate es palam_sewer_95f0303e:

    # MC "What? But I—"
    MC "¿Qué? Pero yo—"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:104
translate es palam_sewer_ff5736a0:

    # DIVINE "Was the right man for the job, clearly!"
    DIVINE "Era el hombre adecuado para el trabajo, ¡claramente!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:105
translate es palam_sewer_910d63ea:

    # DIVINE "Next time though, {i}make sure it’s actually dead{/i} before you call it a job well done."
    DIVINE "La próxima vez, sin embargo, {i}asegúrate de que está realmente muerto{/i} antes de considerarlo un trabajo bien hecho."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:113
translate es palam_sewer_852f9fc8:

    # MC "Yeah... Thanks for that."
    MC "Sí... Gracias por eso."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:115
translate es palam_sewer_8efe8db7:

    # "As I rose to my feet, Sister Divine smirked and looked me up and down."
    "Mientras me ponía en pie, la hermana Divine sonrió con satisfacción y me miró de arriba abajo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:109
translate es palam_sewer_60fd0c17:

    # DIVINE "I’ve never seen a being such as you."
    DIVINE "Nunca he visto un ser como tú."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:117
translate es palam_sewer_3cbf647c:

    # MC "H-How did you know?"
    MC "¿C-cómo lo supiste?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:112
translate es palam_sewer_5ae72044:

    # DIVINE "The goddess Palam allowed me to sense it so..."
    DIVINE "La diosa Palam me permitió sentirlo..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:120
translate es palam_sewer_a53800ab:

    # MC "{i}... What?{/i}"
    MC "{i}...¿Qué?{/i}"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:114
translate es palam_sewer_95d6ca64:

    # DIVINE "Magic, no matter the type, carries with it its own distinct scent."
    DIVINE "La magia, sea del tipo que sea, lleva consigo su propio aroma."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:115
translate es palam_sewer_def70cda:

    # DIVINE "{i}You{/i} smell unlike anything I have ever encountered before."
    DIVINE "{i}Tu{/i} olor no se parece a nada que haya encontrado antes."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:116
translate es palam_sewer_063f888a:

    # DIVINE "I knew there was something different about you the moment I laid eyes on you."
    DIVINE "Sabía que había algo diferente en ti desde el momento en que te vi."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:124
translate es palam_sewer_eaecdf7a:

    # MC "... Well, what are you going to do?"
    MC "...Bueno, ¿qué vas a hacer?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:118
translate es palam_sewer_6a47d41d:

    # DIVINE "{i}... Nothing.{/i}"
    DIVINE "{i}...Nada.{/i}"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:126
translate es palam_sewer_fd5dec13:

    # MC "Nothing?"
    MC "¿Nada?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:120
translate es palam_sewer_95efb4e4:

    # DIVINE "Your secret is safe with me."
    DIVINE "Tu secreto está a salvo conmigo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:121
translate es palam_sewer_e1b0c1cb:

    # DIVINE "I can think of {i}so{/i} many other things I’d rather do with you..."
    DIVINE "Se me ocurren {i}muchas{/i} otras cosas que preferiría hacer contigo..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:130
translate es palam_sewer_692b0afe:

    # "Sister Divine stepped forward alluringly, her hands resting over the hard exoskeleton of my chest."
    "La hermana Divine se adelantó seductoramente, sus manos se posaron sobre el duro exoesqueleto de mi pecho."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:131
translate es palam_sewer_4b59b47b:

    # MC "Uhh... Are you—"
    MC "Uhh... ¿Estás—?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:125
translate es palam_sewer_99ed047d:

    # DIVINE "You know what I’m asking for."
    DIVINE "Ya sabes lo que te pido."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:133
translate es palam_sewer_8694cdf2:

    # MC "... Wouldn’t you prefer I take my human form?"
    MC "...¿No preferirías que tomara mi forma humana?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:127
translate es palam_sewer_f70525f9:

    # DIVINE "Not at all, I could have a human any day of the week..."
    DIVINE "En absoluto, podría tener un humano cualquier día de la semana..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:128
translate es palam_sewer_f5bfa92e:

    # DIVINE "{i}But this...{/i} This form is something special."
    DIVINE "{i}Pero esto...{/i} Esta forma es algo especial."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:136
translate es palam_sewer_a5d9231c:

    # MC "I... What about the crystal?"
    MC "Yo... ¿Qué pasa con el cristal?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:137
translate es palam_sewer_aee746da:

    # "Sister Divine held up the glowing purple crystal bound in some ancient metal for me to see."
    "La hermana Divine me mostró el brillante cristal púrpura atado a un metal antiguo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:131
translate es palam_sewer_099d76d4:

    # DIVINE "{i}All ready for when you leave.{/i}"
    DIVINE "{i}Todo listo para cuando te vayas.{/i}"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:132
translate es palam_sewer_58a26a7f:

    # DIVINE "So... how about it?"
    DIVINE "Entonces... ¿qué te parece?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:133
translate es palam_sewer_058d9062:

    # DIVINE "We could learn so much from each other..."
    DIVINE "Podríamos aprender tanto el uno del otro..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:138
translate es palam_sewer_287684b0:

    # DIVINE "I’m glad to hear that."
    DIVINE "Me alegra oírlo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:139
translate es palam_sewer_6e39d425:

    # DIVINE "Here, take this..."
    DIVINE "Toma, coge esto..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:147
translate es palam_sewer_7e711a64:

    # "In my hands, Sister Divine palmed a small blue stone with a white insignia on it."
    "La hermana Divine me entregó una pequeña piedra azul con una insignia blanca."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:148
translate es palam_sewer_f781f9da:

    # MC "What is this?"
    MC "¿Qué es esto?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:142
translate es palam_sewer_35eb4e4b:

    # DIVINE "It is my blessing to allow you to wander this tower at night."
    DIVINE "Es mi aprobación para permitirte deambular por esta torre por la noche."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:152
translate es palam_sewer_dcc31424:

    # MC "You mean—"
    MC "¿Quieres decir—"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:146
translate es palam_sewer_9fec17fd:

    # DIVINE "We prefer our mages handle their dalliances with... discretion."
    DIVINE "Preferimos que nuestras magas manejen sus encuentros con... discreción."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:147
translate es palam_sewer_9eecb9f4:

    # DIVINE "This way suits both our needs."
    DIVINE "De este modo se satisfacen las necesidades de ambos."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:156
translate es palam_sewer_d11b242a:

    # "With that, Sister Divine turned to leave the basement while I followed in her wake."
    "Con eso, la hermana Divine se dio la vuelta para salir del sótano mientras yo la seguía."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:150
translate es palam_sewer_e2dda61b:

    # DIVINE "Come, this way..."
    DIVINE "Ven, por aquí..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:158
translate es palam_sewer_2df05c72:

    # "In her hands, a glowing blue ball began to form, illuminating the passageways back for us."
    "En sus manos comenzó a formarse una bola azul brillante que nos iluminó los pasadizos de vuelta."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:159
translate es palam_sewer_14631ca4:

    # "Along the way, I noticed Sister Divine kept looking back at me, perhaps contemplating what was to come between us."
    "Por el camino, me di cuenta de que la hermana Divine no dejaba de mirarme, tal vez contemplando lo que se avecinaba entre nosotros."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:161
translate es palam_sewer_3905a23f:

    # "As I changed back into my human form, Divine remarked I should get dressed before making my way out of the basement, scrambling to locate the clothes I had left on my way in, we finally returned to the main halls of the tower."
    "Cuando volví a mi forma humana, Divine me dijo que debía vestirme antes de salir del sótano y buscar la ropa que me había dejado al entrar, volvimos por fin a los pasillos principales de la torre."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:157
translate es palam_sewer_a205ebc7:

    # DIVINE "Hmm... A shame."
    DIVINE "Hmm... Una pena."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:158
translate es palam_sewer_d3c2fa0e:

    # DIVINE "Then I guess our business has concluded."
    DIVINE "Entonces supongo que nuestro asunto ha concluido."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:159
translate es palam_sewer_d6c70b13:

    # DIVINE "Come, I will escort you out."
    DIVINE "Ven, te acompañaré fuera."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:167
translate es palam_sewer_f19eb997:

    # "In her hands, a glowing blue ball began to form, lighting the way back for us as I followed behind."
    "En sus manos empezó a formarse una bola azul brillante que nos iluminó el camino de vuelta mientras yo la seguía."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:168
translate es palam_sewer_e7a9b781:

    # "I sensed the disappointment in Divine’s voice, but decided it was probably best to keep my mouth shut."
    "Percibí la decepción en la voz de Divine, pero decidí que probablemente era mejor mantener la boca cerrada."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:170
translate es palam_sewer_48b7803c:

    # "As I changed back into my human form, Divine remarked I should get dressed before making my way out of the basement."
    "Cuando volví a mi forma humana, Divine comentó que debía vestirme antes de salir del sótano."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:171
translate es palam_sewer_ced1a217:

    # "I scrambled to gather up the clothes I has abandoned on my way in and we finally returned to the main halls of the tower."
    "Me apresuré a recoger la ropa que había abandonado al entrar y finalmente regresamos a las salas principales de la torre."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:169
translate es palam_sewer_fac7386c:

    # DIVINE "I thank you for your services to the Goddess Palam."
    DIVINE "Te agradezco tus servicios a la diosa Palam."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:177
translate es palam_sewer_4bc02166:

    # MC @ talk "Anytime... Although I hope that next time it won’t be so quite so dangerous."
    MC @ talk "Cuando quieras... Aunque espero que la próxima vez no sea tan peligroso."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:179
translate es palam_sewer_39656a81:

    # "Sister Divine smiled, holding out the crystal for me to take."
    "La hermana Divine sonrió y me ofreció el cristal."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:175
translate es palam_sewer_8194abb6:

    # DIVINE "It’s all yours."
    DIVINE "Es todo tuyo."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:183
translate es palam_sewer_29d31280:

    # MC @ talk "Glad to be of service."
    MC @ talk "Encantado de ser de ayuda."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:178
translate es palam_sewer_3797aa16:

    # DIVINE "I look forward to our next meeting..."
    DIVINE "Espero con impaciencia nuestra próxima reunión..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:180
translate es palam_sewer_2837592b:

    # DIVINE "Of course."
    DIVINE "Por supuesto."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:181
translate es palam_sewer_8474a392:

    # DIVINE "Now, if you will excuse me..."
    DIVINE "Ahora, si me disculpas..."

translate es strings:

    # game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:135
    old "{image=[ICON.HEART]} Well, when you put it like that... ({b}Warning FUTA ahead!{/b})"
    new "{image=[ICON.HEART]} Bueno, cuando lo dices así... ({b}¡Advertencia, FUTA!{/b})"

    # game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:141
    old "{image=[ICON.HEART_CROSS]} You’re not really my type... No offence."
    new "{image=[ICON.HEART_CROSS]} No eres realmente mi tipo... Sin ánimo de ofender."

    # game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:151
    old "You can now enter the Palam Tower at night."
    new "Ahora puedes entrar en la torre Palam por la noche."
