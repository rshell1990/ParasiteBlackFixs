    # DIVINE "Oh... {i}That elf.{/i}"
    DIVINE "Oh... {i}Ese elfo.{/i}"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:30
translate es divine_dros_crystal_c1d19001:

    # MC @ talk "Could you help me out at all?"
    MC @ talk "¿Podrías ayudarme?"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:31
translate es divine_dros_crystal_4cb9c127:

    # DIVINE "Hmm... As I explained to him, even if we COULD sell him one, power crystals such as these are not the easiest things to come by..."
    DIVINE "Hmm... Como le expliqué, aunque PODRÍAMOS venderle uno, los cristales de energía de este tipo no son fáciles de conseguir..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:32
translate es divine_dros_crystal_7cefc073:

    # DIVINE "{i}Or the cheapest.{/i}"
    DIVINE "{i}O el más barato.{/i}"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:33
translate es divine_dros_crystal_bffffd5e:

    # MC @ talk "There must be something I can do..."
    MC @ talk "Debe haber algo que pueda hacer..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:34
translate es divine_dros_crystal_fedb36ea:

    # DIVINE "... Well, we are having a small crisis at the moment in the Sub-Basement."
    DIVINE "...Bueno, en este momento tenemos una pequeña crisis en el subsótano."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:35
translate es divine_dros_crystal_e291577e:

    # MC @ talk "... Crisis?"
    MC @ talk "...¿Crisis?"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:36
translate es divine_dros_crystal_f55710b2:

    # DIVINE "Sister Gracen took it upon herself to fool around with a couple of conjurors in the Sub-Basement."
    DIVINE "La hermana Gracen se encargó de hacer el tonto con un par de conjuradores en el Subsótano."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:37
translate es divine_dros_crystal_7f18fdc8:

    # DIVINE "Apparently, they were merely trying to see if they could conjure up some form of light spirit."
    DIVINE "Aparentemente, solo intentaban ver si podían conjurar alguna forma de espíritu de luz."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:38
translate es divine_dros_crystal_ca98255b:

    # MC @ talk "... They didn’t conjure up a ‘light spirit’, I take it?"
    MC @ talk "...No conjuraron un ‘espíritu de luz’, supongo."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:39
translate es divine_dros_crystal_db29dc8e:

    # DIVINE "{i}No... No, they did not.{/i}"
    DIVINE "{i}No... No, lo hicieron.{/i}"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:40
translate es divine_dros_crystal_92e008b1:

    # DIVINE "We’ve sealed off the Sub-Basement until the Inquisitors can arrive to deal with the matter but..."
    DIVINE "Hemos sellado el subsótano hasta que lleguen los inquisidores para ocuparse del asunto, pero..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:41
translate es divine_dros_crystal_7442450d:

    # DIVINE "If {i}you{/i} can sort it out somehow and we were able to avoid an investigation, I would be eternally grateful."
    DIVINE "Si {i}tu{/i} puedes solucionarlo de algún modo y pudiéramos evitar una investigación, te estaría eternamente agradecida."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:42
translate es divine_dros_crystal_63606700:

    # MC @ talk "Uhh... I’m just a human though."
    MC @ talk "Uhh... Aunque solo soy un humano."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:44
translate es divine_dros_crystal_67412659:

    # "Sister Divine curiously smiled at the comment."
    "La hermana Divine sonrió con curiosidad ante el comentario."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:45
translate es divine_dros_crystal_a26b14a4:

    # DIVINE "... Of course you are."
    DIVINE "...Por supuesto que lo eres."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:46
translate es divine_dros_crystal_a5ac5435:

    # MC "(... Does she suspect something about me?)"
    MC "(...¿Sospecha algo de mí?)"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:48
translate es divine_dros_crystal_49f56af4:

    # BLACK "(Her heart rate has remained at a steady rate this whole time... She is totally calm.)"
    BLACK "(Su ritmo cardíaco se ha mantenido estable todo este tiempo... Está totalmente tranquila)."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:49
translate es divine_dros_crystal_112212b1:

    # DIVINE "Or... We could skip the pleasantries."
    DIVINE "O... Podríamos saltarnos las cortesías."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:50
translate es divine_dros_crystal_489ffcef:

    # DIVINE "You can have the crystal for 1500 gold."
    DIVINE "Puedes tener el cristal por 1500 de oro."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:54
translate es divine_dros_crystal_menu_01e4fbde:

    # DIVINE "Your call, warrior."
    DIVINE "Tú decides, guerrero."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:58
translate es divine_dros_crystal_menu_009b0b7e:

    # DIVINE "... Hm... Disappointing but..."
    DIVINE "... Hm... Decepcionante pero..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:59
translate es divine_dros_crystal_menu_1eb99ef3:

    # DIVINE "Very well, here is the crystal you seek..."
    DIVINE "Muy bien, aquí está el cristal que buscas..."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:61
translate es divine_dros_crystal_menu_6a32abb5:

    # DIVINE "{i}*Sigh*{/i} Now to wait for the Inquisitors to arrive, I suppose."
    DIVINE "{i}*Suspiro*{/i} Ahora a esperar que lleguen los inquisidores, supongo."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:62
translate es divine_dros_crystal_menu_229aea30:

    # DIVINE "What a bloody mess."
    DIVINE "Qué maldito desastre."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:66
translate es divine_dros_crystal_menu_d0b37451:

    # DIVINE "Wonderful!"
    DIVINE "¡Maravilloso!"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:67
translate es divine_dros_crystal_menu_cfda152c:

    # DIVINE "I’ll lead you to the entrance to the Sub-Basement."
    DIVINE "Te guiaré a la entrada del subsótano."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:71
translate es divine_dros_crystal_menu_e1f6066f:

    # DIVINE "Don’t take too long... Every moment you wait, the more likely it becomes that the Inquisitors will arrive and start asking impertinent questions."
    DIVINE "No tardes demasiado... Cada momento que esperes, más probabilidades hay de que lleguen los inquisidores y empiecen a hacer preguntas impertinentes."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:74
