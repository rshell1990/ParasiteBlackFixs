# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:89
translate es dros_givecrystal_6da9f557:

    # "Taking the crystal, Dros Ulvrak slotted it into some strange contraption."
    "Dros Ulvrak ciguó el cristal y lo colocó en un extraño artilugio."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:94
translate es dros_givecrystal_a4265441:

    # "I watched dumfounded as the whole shop abruptly came to life."
    "Observé estupefacto cómo de repente toda la tienda cobraba vida."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:95
translate es dros_givecrystal_8efa0a34:

    # "The strange machines were no longer motionless, coming alive, they began to work in synchronized automated unison as they stitched away at fancy fabrics on the workshop bench."
    "Las extrañas máquinas ya no estaban inmóviles, cobraron vida y comenzaron a trabajar al unísono sincronizado y automatizado mientras cosían elegantes telas en el banco del taller."

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:102
translate es dros_givecrystal_feda201a:

    # DROS @ smile "Perfect!"
    DROS @ smile "¡Perfecto!"

# game/data/world_quests/side/novaras/HighFashion/qst_HighFashion.rpy:103
translate es dros_givecrystal_794b11b3:

    # DROS @ talk "Time to work some beauty into this city!"
    DROS @ talk "¡Es hora de darle un poco de belleza a esta ciudad!"

