

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:3
translate es blacksmithscene1_6f5f7509:

    # "As the door of the Blacksmiths creaked open, the heat blast forced me back."
    "Al abrirse la puerta de la herrería, el golpe de calor me obligó a retroceder."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:4
translate es blacksmithscene1_44a173f5:

    # "Arlena and her father, Drax, hammered relentlessly at some iron blades."
    "Arlena y su padre, Drax, martilleaban sin descanso unas espadas de hierro."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:7
translate es blacksmithscene1_d991ec93:

    # "When they looked up and spotted me, Drax placed the hot blade into some water where it sizzled, and the hulking man sauntered over to me."
    "Cuando levantaron la vista y me vieron, Drax colocó la espada caliente en el agua, donde chisporroteó, y el hombre corpulento se acercó a mí."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:10
translate es blacksmithscene1_b7ce948d:

    # DRAX "That you, boy?"
    DRAX "¿Eres tú, muchacho?"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:11
translate es blacksmithscene1_b3f203f0:

    # MC @ talk "Good to see you again, Drax."
    MC @ talk "Me alegro de volver a verte, Drax."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:12
translate es blacksmithscene1_67df72b3:

    # DRAX "Ahhh! Glad to see you doing so well..."
    DRAX "¡Ahhh! Me alegro de verte tan bien..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:13
translate es blacksmithscene1_4beb943e:

    # "Drax was short, muscular man, sturdy in shape, he reminded me of a bull."
    "Drax era un hombre bajo y musculoso, de complexión robusta, me recordaba a un toro."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:14
translate es blacksmithscene1_f693ca17:

    # "His head was shaved bald and his wiry eyebrows stood out like slugs on his face."
    "Llevaba la cabeza rapada y las cejas delgadas destacaban como babosas en su rostro."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:15
translate es blacksmithscene1_396f9cdd:

    # "He had a thick handlebar moustache that sat atop his neck hair and grew down to his chest before merging with the dark curly hair that protruded from his shirt."
    "Tenía un espeso bigote en forma de mango que le caía por el cuello y le llegaba hasta el pecho antes de fundirse con el pelo oscuro y rizado que le sobresalía de la camisa."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:16
translate es blacksmithscene1_d38658b7:

    # "With his leathery brown gloves, he wiped off any dirt onto his apron as he approached me and reached out to shake my hand with an easy grin."
    "Con sus guantes de cuero marrón, se limpió la suciedad del delantal mientras se acercaba a mí y me tendía la mano con una sonrisa."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:18
translate es blacksmithscene1_5c4142fc:

    # DRAX "You and that Markus boy been the talk of the town you know!"
    DRAX "¡Tú y ese Markus habéis sido la comidilla de la ciudad!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:18
translate es blacksmithscene1_ca6439fe:

    # MC @ talk "We have?"
    MC @ talk "¿Ah, sí?"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:19
translate es blacksmithscene1_1f2991f0:

    # DRAX "Ha! Just ask Arlena here..."
    DRAX "¡Ja! Pregúntale a Arlena..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:20
translate es blacksmithscene1_c6d21c84:

    # DRAX "ARLENA! GET OVER HERE! "
    DRAX "¡ARLENA! ¡VEN AQUÍ!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:23
translate es blacksmithscene1_08d3609b:

    # "Arlena was already throwing off the protective mask and strode over to me, sweat dripping down her face."
    "Arlena ya se estaba quitando la máscara protectora y se acercó a mí, con el sudor chorreándole por la cara."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:24
translate es blacksmithscene1_2920486e:

    # "Despite sharing classes in school, we never really got on."
    "A pesar de compartir clase en el colegio, nunca nos llevamos bien."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:25
translate es blacksmithscene1_dd9d73f5:

    # "Arlena was always more of a rough and ready type person."
    "Arlena siempre fue más del tipo de persona brusca y directa."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:26
translate es blacksmithscene1_4c41db27:

    # "To her, me and Markus thought we were better than everyone else with our plans."
    "Para ella, Markus y yo nos creíamos mejores que los demás con nuestros planes."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:27
translate es blacksmithscene1_1acb1480:

    # "To us, we just wanted a chance to never go hungry again."
    "Para nosotros, solo queríamos la oportunidad de no volver a pasar hambre."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:28
translate es blacksmithscene1_33f0e536:

    # "With her arms folded, she stoically remarked as she approached me..."
    "Con los brazos cruzados, comentó estoicamente mientras se acercaba a mí..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:31
translate es blacksmithscene1_dd47a8bb:

    # ARLENA "I’ve heard..."
    ARLENA "He oído..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:32
translate es blacksmithscene1_93026027:

    # ARLENA "So, how’d you both really survive? Hiding under a rock I take it?"
    ARLENA "Entonces, ¿cómo sobrevivisteis realmente? ¿Escondidos bajo una roca, supongo?"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:35
translate es blacksmithscene1_91967820:

    # ARLENA "Of course you did."
    ARLENA "Por supuesto que sí."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:34
translate es blacksmithscene1_00ea252e:

    # "Arlena rolled her eyes in exaggerated disbelief."
    "Arlena giró los ojos con exagerada incredulidad."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:35
translate es blacksmithscene1_f9b2db76:

    # DRAX "Arlena!"
    DRAX "¡Arlena!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:39
translate es blacksmithscene1_ba82ffcd:

    # ARLENA "I don’t, I’m just sick of hearing about it."
    ARLENA "No lo sé, estoy harta de oír hablar de eso."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:40
translate es blacksmithscene1_9512b72a:

    # ARLENA "Not when we both know you probably—"
    ARLENA "No cuando ambos sabemos que probablemente—"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:39
translate es blacksmithscene1_75cb9fd0:

    # DRAX "Arlena... Watch it, girl."
    DRAX "Arlena... Ten cuidado, chica."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:42
translate es blacksmithscene1_07279bf0:

    # ARLENA "Tsch!"
    ARLENA "¡Tsch!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:44
translate es blacksmithscene1_9e512762:

    # ARLENA "... Hmph."
    ARLENA "...Hmph."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:43
translate es blacksmithscene1_0a759042:

    # "Arlena looked me up and down unabashed."
    "Arlena me miró de arriba abajo sin pudor."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:46
translate es blacksmithscene1_419e99dc:

    # ARLENA "I’ve never seen a Scout come back looking so..."
    ARLENA "Nunca he visto a un explorador volver tan..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:47
translate es blacksmithscene1_460abbb4:

    # ARLENA "{i}Big.{/i}"
    ARLENA "{i}Grande.{/i}"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:46
translate es blacksmithscene1_ffba02d8:

    # MC @ talk "Uhh, lots of eating and fighting tends to do that."
    MC @ talk "Uhh, mucha comida y peleas tienden a hacer eso."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:47
translate es blacksmithscene1_1e193cae:

    # "Arlena offered nothing more than a blank, inexpressive response of ‘Hm’ till her father piped up."
    "Arlena se limitó a un inexpresivo ‘Hm’, hasta que su padre tomó la palabra."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:48
translate es blacksmithscene1_99ced9b4:

    # DRAX "So, what can I do for you?"
    DRAX "Entonces, ¿qué puedo hacer por ti?"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:47
translate es blacksmithscene1_1608ee91:

    # MC @ talk "[regina_ref_cap!t] ordered something here not long ago, I’m here to pick it up."
    MC @ talk "[regina_ref_cap!t] pidió algo aquí no hace mucho, estoy aquí para recogerlo."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:50
translate es blacksmithscene1_74586f95:

    # DRAX "Hmm... Slight bit of a problem there."
    DRAX "Hmm... Hay un pequeño problema."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:51
translate es blacksmithscene1_38a6c09b:

    # MC @ talk "... Which is?"
    MC @ talk "... ¿Cuál es?"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:52
translate es blacksmithscene1_20a14e8b:

    # DRAX "We’re running low on bronze, still waiting on the ore to arrive."
    DRAX "Nos estamos quedando sin bronce, seguimos esperando a que llegue el mineral."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:53
translate es blacksmithscene1_a68b765f:

    # MC @ talk "... Great."
    MC @ talk "... Genial."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:56
translate es blacksmithscene1_9d4b495a:

    # ARLENA "If you’re feeling brave though, Hero, most of the weaker Demorai tend to have some small bronze armour pieces stitched together to wear."
    ARLENA "Sin embargo, si te sientes valiente, héroe, la mayoría de los Demorai más débiles suelen tener algunas pequeñas piezas de armadura de bronce."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:57
translate es blacksmithscene1_719b6f13:

    # ARLENA "Give you a chance to practice all that fighting..."
    ARLENA "Te dará la oportunidad de practicar toda esa lucha..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:58
translate es blacksmithscene1_cf12bec5:

    # ARLENA "If you bring us some, we can fashion what you need."
    ARLENA "Si nos traes un poco, podemos hacer lo que necesites."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:57
translate es blacksmithscene1_7aeee29d:

    # DRAX "Aye, we have the mould for it, it’s just the raw material we need."
    DRAX "Sí, tenemos el molde, solo necesitamos la materia prima."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:58
translate es blacksmithscene1_b1b56e16:

    # MC @ talk "Not a problem, I’ll see what I can do."
    MC @ talk "No hay problema, veré lo que puedo hacer."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:61
translate es blacksmithscene1_c9f8a180:

    # ARLENA "And the best part is! If you get eaten out there..."
    ARLENA "¡Y lo mejor! Si te comen por ahí..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:62
translate es blacksmithscene1_97c46108:

    # ARLENA "I never have to see you again!"
    ARLENA "¡No tendré que volerte a ver!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:61
translate es blacksmithscene1_354ddc56:

    # DRAX "ARLENA!"
    DRAX "¡ARLENA!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:63
translate es blacksmithscene1_34e3c3de:

    # "Arlena turned to head back towards one of the anvils, humming happily to herself."
    "Arlena se giró hacia uno de los yunques, canturreando alegremente."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:64
translate es blacksmithscene1_ac109157:

    # DRAX "Girl, you are driving my patience with your attitude! "
    DRAX "¡Chica, estás acabando con mi paciencia con tu actitud!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:65
translate es blacksmithscene1_fd738c0e:

    # DRAX "Bah! Ignore her."
    DRAX "¡Bah! Ignórala."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:66
translate es blacksmithscene1_d699da17:

    # DRAX "She’ll make a fine blacksmith one day..."
    DRAX "Será una buena herrera algún día..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:67
translate es blacksmithscene1_bc98bdb2:

    # DRAX "But may the gods help whoever ends up marrying her."
    DRAX "Pero que los dioses ayuden a quien acabe casándose con ella."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:68
translate es blacksmithscene1_3b8a9c00:

    # MC @ talk "She’s a fiery one, for sure."
    MC @ talk "Es una fiera, sin duda."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:71
translate es blacksmithscene1_d34f352e:

    # MC @ talk "I’ll be back shortly with the bronze scraps."
    MC @ talk "Volveré en breve con las chatarras de bronce."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:70
translate es blacksmithscene1_41f34b34:

    # DRAX "Good! And send Regina our regards, we hope she is well."
    DRAX "¡Bien! Y envíale recuerdos a Regina, esperamos que esté bien."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:71
translate es blacksmithscene1_81658a7e:

    # MC @ talk "Will do."
    MC @ talk "Lo haré."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:78
translate es qstReginaPackage_DraxCollectedBronze_a3e7c2d8:

    # DRAX "Ah! Good! "
    DRAX "¡Ah! ¡Bien!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:79
translate es qstReginaPackage_DraxCollectedBronze_5650b7ba:

    # DRAX "ARLENAAAAA!"
    DRAX "¡ARLENAAAAA!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:80
translate es qstReginaPackage_DraxCollectedBronze_a540fa4e:

    # ARLENA "WHATTT!"
    ARLENA "¡QUÉÉÉ!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:81
translate es qstReginaPackage_DraxCollectedBronze_51207db6:

    # DRAX "WE HAVE BRONZE! "
    DRAX "¡TENEMOS BRONCE!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:84
translate es qstReginaPackage_DraxCollectedBronze_ba0ec503:

    # "Arlena emerged once again with her arms folded."
    "Arlena emergió de nuevo con los brazos cruzados."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:85
translate es qstReginaPackage_DraxCollectedBronze_f4845c7e:

    # ARLENA "Well, I see you didn’t get yourself killed... "
    ARLENA "Bueno, veo que no te mataron..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:86
translate es qstReginaPackage_DraxCollectedBronze_8d431870:

    # ARLENA "{i}Unfortunately.{/i}"
    ARLENA "{i}Por desgracia.{/i}"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:89
translate es qstReginaPackage_DraxCollectedBronze_e0d73040:

    # ARLENA "Tough words for someone who was only ever interested on sucking on noble tit."
    ARLENA "Palabras duras para alguien a quien solo le interesaba chupar una teta noble."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:90
translate es qstReginaPackage_DraxCollectedBronze_44504fe6:

    # DRAX "Arlena! That’s enough from you, girl! "
    DRAX "¡Arlena! ¡Ya basta, chica!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:91
translate es qstReginaPackage_DraxCollectedBronze_72d25973:

    # DRAX "I don’t see you going out axe in hand to fight Demorai!"
    DRAX "¡No te veo saliendo hacha en mano a luchar contra demorai!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:92
translate es qstReginaPackage_DraxCollectedBronze_084c630e:

    # ARLENA "Fine! Then give me a blade and I’ll—"
    ARLENA "¡Bien! Entonces dame una espada y yo—"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:93
translate es qstReginaPackage_DraxCollectedBronze_f6583ce9:

    # DRAX "Pipe down, girl! "
    DRAX "¡Cállate, chica!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:94
translate es qstReginaPackage_DraxCollectedBronze_0e6512a6:

    # "Arlena growled."
    "Arlena refunfuñó."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:96
translate es qstReginaPackage_DraxCollectedBronze_8888d3f5:

    # ARLENA "I don’t know, prying the armour from corpses of already slain enemies sounds pretty easy to me."
    ARLENA "No sé, arrancar la armadura de cadáveres de enemigos ya abatidos me parece bastante fácil."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:97
translate es qstReginaPackage_DraxCollectedBronze_f9b2db76:

    # DRAX "Arlena!"
    DRAX "¡Arlena!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:98
translate es qstReginaPackage_DraxCollectedBronze_69ce0368:

    # MC @ talk "I am not some grave robber."
    MC @ talk "No soy un ladrón de tumbas."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:99
translate es qstReginaPackage_DraxCollectedBronze_8a29fcfb:

    # MC @ talk "I can assure you, the only corpses I pried from were the ones I killed myself."
    MC @ talk "Te puedo asegurar que los únicos cadáveres que robé fueron los que yo mismo maté."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:100
translate es qstReginaPackage_DraxCollectedBronze_d27b678d:

    # ARLENA "If you say so..."
    ARLENA "Si tú lo dices..."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:103
translate es qstReginaPackage_DraxCollectedBronze_8055a17a:

    # DRAX "I will have Regina’s item ready for her by tomorrow."
    DRAX "Mañana tendré listo el pedido de Regina."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:104
translate es qstReginaPackage_DraxCollectedBronze_c12800e6:

    # DRAX "Feel free to pick it up then."
    DRAX "Siéntete libre de recogerlo entonces."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:108
translate es qstReginaPackage_DraxCollectedBronze_5b35d8e4:

    # MC @ talk "Thank you, Drax."
    MC @ talk "Gracias, Drax."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:109
translate es qstReginaPackage_DraxCollectedBronze_52ec0a73:

    # DRAX "Remember, if you need some coin, you can always bring me more bronze scraps you find out there and I’ll pay you a fair price."
    DRAX "Recuerda, si necesitas dinero, siempre puedes traerme más chatarra de bronce que encuentres por ahí y te pagaré un precio justo."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:111
translate es qstReginaPackage_DraxCollectedBronze_af240b4e:

    # ARLENA "Father! "
    ARLENA "¡Padre!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:112
translate es qstReginaPackage_DraxCollectedBronze_6a752ae5:

    # DRAX "No arguing, Arlena!"
    DRAX "¡No discutas, Arlena!"

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:113
translate es qstReginaPackage_DraxCollectedBronze_4d22fee9:

    # DRAX "The more metal we can get, the better, you know this, girl."
    DRAX "Cuanto más metal podamos conseguir, mejor, ya lo sabes, chica."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:114
translate es qstReginaPackage_DraxCollectedBronze_6ca02023:

    # ARLENA "Hmph, fine."
    ARLENA "Hmph, bien."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:115
translate es qstReginaPackage_DraxCollectedBronze_1be1696d:

    # ARLENA "I guess you might be useful for something at last."
    ARLENA "Supongo que por fin serás útil para algo."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:117
translate es qstReginaPackage_DraxCollectedBronze_abe76cd4:

    # "As Arlena stormed off once again, Drax rolled his eyes, muttering to himself something along the lines of ‘that girl’."
    "Cuando Arlena se marchó enfadada de nuevo, Drax puso los ojos en blanco y murmuró algo parecido a ‘esa chica’."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:118
translate es qstReginaPackage_DraxCollectedBronze_9de3c6a5:

    # DRAX "I’ll see you soon, lad."
    DRAX "Te veré pronto, muchacho."

# game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:119
translate es qstReginaPackage_DraxCollectedBronze_2bc5d65c:

    # MC @ talk "See you soon, Drax."
    MC @ talk "Nos vemos, Drax."

translate es strings:

    # game/data/world_quests/side/novaras/ReginasPackage/scr_reginaPackage.rpy:31
    old "We fought our way back."
