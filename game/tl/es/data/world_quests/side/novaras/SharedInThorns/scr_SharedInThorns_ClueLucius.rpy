translate es scr_SharedInThorns_luciusTellMe_menu_0a0350b1_1:

    # "Elena looked up towards me, her eyes troubled by what she heard."
    "Elena levantó la vista hacia mí, con los ojos preocupados por lo que oía."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:84
translate es scr_SharedInThorns_luciusTellMe_menu_8c84f86b_1:

    # MC @ talk "Don't worry."
    MC @ talk "No te preocupes."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueLucius.rpy:85
translate es scr_SharedInThorns_luciusTellMe_menu_a67b5f70_1:

    # MC @ talk "We'll talk about it when we get home."
    MC @ talk "Hablaremos de ello cuando volvamos a casa."

