# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:8
translate es scr_SharedInThorns_turnInClues_menu_5d812c06:

    # MC @ talk "Very suspicious."
    MC @ talk "Muy sospechoso."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:9
translate es scr_SharedInThorns_turnInClues_menu_f4c4dfd1:

    # ELENA @ shock "You don't think he made some kind of... 'deal' do you?"
    ELENA @ shock "No creerás que hizo algún tipo de... 'trato' ¿verdad?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:10
translate es scr_SharedInThorns_turnInClues_menu_bbfd0c63:

