    ELENA @ grumpy "Es posible..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:34
translate es scr_SharedInThorns_turnInClues_menu_012585ee:

    # MC @ talk "Surely the lady Grace must have told you something?"
    MC @ talk "Seguramente lady Grace te habrá dicho algo."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:35
translate es scr_SharedInThorns_turnInClues_menu_17f6ff97:

    # ELENA @ sad "We spoke of many things, but... She told me her work overseas was 'family business' and would elaborate no further."
    ELENA @ sad "Hablamos de muchas cosas, pero... Me dijo que su trabajo en el extranjero era 'asunto de familia' y no quiso dar más detalles."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:36
translate es scr_SharedInThorns_turnInClues_menu_53eee9e8:

    # MC @ talk "Knowing her father visited Ramon some years before, there must be some correlation."
    MC @ talk "Sabiendo que su padre visitó Ramon unos años antes, debe haber alguna correlación."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:37
translate es scr_SharedInThorns_turnInClues_menu_02296f17:

    # ELENA @ talk "I do not know, the late Lord Vronts years in Ramon were before my time, and he rarely spoke of them."
    ELENA @ talk "No lo sé, los últimos años de lord Vront en Ramon fueron antes de mi época, y rara vez hablaba de ellos."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:38
