    ELENA @ talk "{i}Ni siquiera sabía que había visitado Ramon hasta ahora...{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:32
translate es scr_SharedInThorns_turnInClues_menu_854e3f0c:

    # MC @ talk "Could she still be there now?"
    MC @ talk "¿Podría seguir allí ahora?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:33
translate es scr_SharedInThorns_turnInClues_menu_62735895:

