    ELENA @ grumpy "No lo sé."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:15
translate es scr_SharedInThorns_turnInClues_menu_82ff7447:

    # "Elena's face seemed to darken for a moment."
    "El rostro de Elena pareció ensombrecerse por un momento."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:16
translate es scr_SharedInThorns_turnInClues_menu_d7c70547:

    # ELENA @ grumpy "{i}Trading the souls of your children for fortune... it... no....{/i}"
    ELENA @ grumpy "{i}Cambiar el alma de tus hijos por fortuna... eso... no....{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:17
translate es scr_SharedInThorns_turnInClues_menu_fc7faa7e:

    # ELENA @ shock "But what of the Lady Grace? Does she not disprove this?"
    ELENA @ shock "¿Pero qué hay de lady Grace? ¿No lo refuta ella?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:18
translate es scr_SharedInThorns_turnInClues_menu_d14c5ac5:

    # MC @ talk "The lady Grace remains an enigma in this puzzle."
    MC @ talk "Lady Grace sigue siendo un enigma en este rompecabezas."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:19
translate es scr_SharedInThorns_turnInClues_menu_b96823d2:

    # MC @ talk "But the fact her mother was so unknown itself raises more questions than answers."
    MC @ talk "Pero el hecho de que su madre fuera desconocida plantea más preguntas que respuestas."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:20
translate es scr_SharedInThorns_turnInClues_menu_a024cd7e:

