translate es qst_HumanExp_1_feedMyu_After_e69924b9:

    # MC "(Well, I guess the question is, what now?)"
    MC "(Bueno, supongo que la pregunta es, ¿y ahora qué?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:48
translate es qst_HumanExp_1_feedMyu_After_c724f033:

    # MYU @ think "...W-Words."
    MYU @ think "...P-palabras."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:49
translate es qst_HumanExp_1_feedMyu_After_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "¿Eh?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:50
translate es qst_HumanExp_1_feedMyu_After_b8198840:

    # MYU @ talk "Myu... Words."
    MYU @ talk "Myu... Palabras."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:51
translate es qst_HumanExp_1_feedMyu_After_904991bb:

    # "I pointed towards my mouth."
    "Señalé hacia mi boca."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:52
translate es qst_HumanExp_1_feedMyu_After_811cbe91:

    # MC @ talk "You want to learn more words?"
    MC @ talk "¿Quieres aprender más palabras?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:53
translate es qst_HumanExp_1_feedMyu_After_e3c7807b:

    # MYU @ smile "Myu!"
    MYU @ smile "¡Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:54
translate es qst_HumanExp_1_feedMyu_After_03c65c11:

    # MC @ smile "Uhh, well, alright!"
    MC @ smile "Uhh, bueno, ¡está bien!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:55
translate es qst_HumanExp_1_feedMyu_After_98973b50:

    # MC "(I guess I should try devoting some time to teaching Myu some Alderian.)"
    MC "(Supongo que debería dedicar algo de tiempo a enseñar a Myu algo de alderiano)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:56
translate es qst_HumanExp_1_feedMyu_After_acc4f47d:

    # MC "(Being able to talk to her more will at least make life easier.)"
    MC "(Poder hablar más con ella al menos me hará la vida más fácil)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:57
translate es qst_HumanExp_1_feedMyu_After_76fd22d3:

    # MC "(Maybe then I'll be able to figure out what to do with her at least.)"
    MC "(Tal vez entonces sea capaz de averiguar qué hacer con ella al menos)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:64
translate es qst_HumanExp_2_lesson_9713ef32:

    # MYU @ smile "O-Okay!"
    MYU @ smile "¡E-está bien!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:66
translate es qst_HumanExp_2_lesson_bc5ee01a:

    # "After spending some time teaching Myu the basics, starting with just pointing to various objects and having her say the word associated with them, Myu began to pick things up very quickly."
    "Después de dedicar algún tiempo a enseñar a Myu los conceptos básicos, empezando por señalar varios objetos y hacerle decir la palabra asociada a ellos, Myu empezó a entender las cosas muy rápidamente."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:68
translate es qst_HumanExp_2_lesson_1957c04c:

    # "Afterwards, we moved onto slowly walking her through some simple phrases and things, and Myu enthusiastically got to grips with these too."
    "Después avanzamos poco a poco con algunas frases y cosas sencillas, que Myu también aprendió con entusiasmo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:73
translate es qst_HumanExp_2_lesson_48bcb9f8:

    # MC @ smile "Very good, Myu, you're learning fast."
    MC @ smile "Muy bien, Myu, estás aprendiendo rápido."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:74
translate es qst_HumanExp_2_lesson_47e9e2a2:

    # MC "({i}Very fast{/i}.)"
    MC "({i}Muy rápido{/i})."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:75
translate es qst_HumanExp_2_lesson_56ad8f9c:

    # MC "(If she keeps this up she'll be speaking fluent Alderian in no time.)"
    MC "(Si sigue así, no tardará en hablar alderiano con fluidez)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:76
translate es qst_HumanExp_2_lesson_913b976a:

    # MYU @ joy "Myu... Happy... Learn."
    MYU @ joy "Myu... Feliz... Aprende."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:77
translate es qst_HumanExp_2_lesson_8a326381:

    # MC "(Maybe I could buy her some kind of reading material to help teach her?)"
    MC "(¿Quizás podría comprarle algún tipo de material de lectura para ayudarla a aprender?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:84
translate es qst_HumanExp_3_grabBook_atLibrary_3e696818:

    # VALA "Hm?"
    VALA "¿Hm?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:85
translate es qst_HumanExp_3_grabBook_atLibrary_55eed43e:

    # VALA "What do you need that for?"
    VALA "What do you need that for?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:88
translate es qst_HumanExp_3_grabBook_atLibrary_5e1118c2:

    # VALA "Oh my..."
    VALA "Oh vaya..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:90
translate es qst_HumanExp_3_grabBook_atLibrary_b2e2530f:

    # VALA "That's quite the noble commitment!"
    VALA "¡Es un gesto muy noble!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:91
translate es qst_HumanExp_3_grabBook_atLibrary_80e741f6:

    # VALA "Always nice to see someone showing more appreciation for the nuances of our language!"
    VALA "¡Siempre es agradable ver que alguien muestra más aprecio por los matices de nuestra lengua!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:93
translate es qst_HumanExp_3_grabBook_atLibrary_06a0a691:

    # VALA "Hm, well, okay then."
    VALA "Hm, bueno, está bien."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:95
translate es qst_HumanExp_3_grabBook_atLibrary_9b101baa:

    # VALA "I never took you for a teacher!"
    VALA "¡Nunca te tomé por un profesor!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:96
translate es qst_HumanExp_3_grabBook_atLibrary_df7a811d:

    # VALA "How old are the students? Are they perhaps younger relatives of yours?"
    VALA "¿Qué edad tienen los estudiantes? ¿Son quizá parientes suyos más jóvenes?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:97
translate es qst_HumanExp_3_grabBook_atLibrary_d96a0689:

    # MC @ talk "Uhh, not exactly..."
    MC @ talk "Uhh, no exactamente..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:98
translate es qst_HumanExp_3_grabBook_atLibrary_b42e9824:

    # VALA "Well, I'm always happy to help when it comes to education!"
    VALA "Bueno, ¡siempre estoy dispuesta a ayudar cuando se trata de educación!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:99
translate es qst_HumanExp_3_grabBook_atLibrary_fe95b892:

    # MC @ talk "Do you perhaps have have a selection of books?"
    MC @ talk "¿Quizá dispones de una selección de libros?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:100
translate es qst_HumanExp_3_grabBook_atLibrary_2f4b0394:

    # MC @ think "Something to teach a beginner to something more advanced?"
    MC @ think "¿Algo para enseñar a un principiante hasta algo más avanzado?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:101
translate es qst_HumanExp_3_grabBook_atLibrary_9fb423eb:

    # VALA "Well, you are in luck."
    VALA "Bueno, pues estás de suerte."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:102
translate es qst_HumanExp_3_grabBook_atLibrary_06ff84dd:

    # VALA "I know we have plenty of copies of {i}'Agathons learning Alderian.'{/i}"
    VALA "Sé que tenemos muchas copias de {i}'Agathons aprendiendo alderiano.'{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:103
translate es qst_HumanExp_3_grabBook_atLibrary_19812dbd:

    # MC @ think "I don't remember studying from that collection."
    MC @ think "No recuerdo haber estudiado en esa colección."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:104
translate es qst_HumanExp_3_grabBook_atLibrary_0ca76cef:

    # VALA "You very likely wouldn't have, it's not mandatory for students."
    VALA "Es muy probable que no, no es obligatorio para los estudiantes."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:105
translate es qst_HumanExp_3_grabBook_atLibrary_720db266:

    # VALA "It's very popular amongst Aristocrats teaching their children, however."
    VALA "Sin embargo, es muy popular entre los aristócratas que enseñan a sus hijos."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:106
translate es qst_HumanExp_3_grabBook_atLibrary_95cb92d2:

    # MC @ talk "Hmm... I see."
    MC @ talk "Hmm... Ya veo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:107
translate es qst_HumanExp_3_grabBook_atLibrary_82bb45ee:

    # MC @ talk "How much for a copy of the collection?"
    MC @ talk "¿Cuánto cuesta un ejemplar de la colección?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:108
translate es qst_HumanExp_3_grabBook_atLibrary_3745d995:

    # VALA @ sad "Hmm, well, this is the difficult part."
    VALA @ sad "Hmm, bueno, esta es la parte difícil."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:109
translate es qst_HumanExp_3_grabBook_atLibrary_e86ecd57:

    # VALA @ sad "At least five hundred coins for the collection."
    VALA @ sad "Al menos quinientas monedas para la colección."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:110
translate es qst_HumanExp_3_grabBook_atLibrary_7d84e5f7:

    # MC @ surprised "Five hundred?!"
    MC @ surprised "¡¿Quinientas?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:111
translate es qst_HumanExp_3_grabBook_atLibrary_78f75768:

    # VALA @ sad "... How do you think they keep the books circulating strictly amongst aristocracy?"
    VALA @ sad "... ¿Cómo crees que mantienen los libros circulando estrictamente entre la aristocracia?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:112
translate es qst_HumanExp_3_grabBook_atLibrary_44d5519c:

    # VALA @ sad "Make it too expensive a commodity for the common people of course."
    VALA @ sad "Que sea un producto demasiado caro para la gente común, por supuesto."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:113
translate es qst_HumanExp_3_grabBook_atLibrary_a6681280:

    # "I pushed my disgust aside, no good came from dwelling on it now."
    "Aparté mi disgusto, nada bueno venía de insistir en ello ahora."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:118
translate es qst_HumanExp_3_grabBook_atLibrary_menu_e8c0c2aa:

    # VALA "I... There is a slightly damaged copy of the collection that I could sell it to you at a slight discount?"
    VALA "... Hay una copia ligeramente dañada de la colección que podría vendértela con un ligero descuento?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:119
translate es qst_HumanExp_3_grabBook_atLibrary_menu_a8baf491:

    # VALA "It's still perfectly fine, but no aristocratic family would want it."
    VALA "Sigue estando perfectamente bien, pero ninguna familia aristocrática lo querría."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:123
translate es qst_HumanExp_3_grabBook_atLibrary_menu_c7145360:

    # MC @ smile "That would be great if you could."
    MC @ smile "Sería estupendo si pudieras."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:121
translate es qst_HumanExp_3_grabBook_atLibrary_menu_e25e3cca:

    # VALA "Alright, I can get away with selling it for four hundred coins."
    VALA "Muy bien, puedo venderla por cuatrocientas monedas."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:122
translate es qst_HumanExp_3_grabBook_atLibrary_menu_1e29d615:

    # VALA "Any less, and its my job on the line."
    VALA "Menos que eso, y mi trabajo estará en peligro."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:123
translate es qst_HumanExp_3_grabBook_atLibrary_menu_5c6a435e:

    # VALA "So, four hundred it is."
    VALA "Entonces, cuatrocientas."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:127
translate es qst_HumanExp_3_grabBook_atLibrary_menu_b8c5118e:

    # VALA "Ah! Okay!"
    VALA "¡Ah! ¡De acuerdo!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:129
translate es qst_HumanExp_3_grabBook_atLibrary_menu_90316531:

    # VALA "Let me just bind the collection for you and it's all yours!"
    VALA "¡Deja que te ate la colección y será toda tuya!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:135
translate es qst_HumanExp_3_grabBook_atLibrary_menu_188f15c4:

    # VALA "Here you go!"
    VALA "¡Aquí tienes!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:144
translate es qst_HumanExp_3_grabBook_atLibrary_menu_400bf3f5:

    # MC @ smile "Thank you, Vala."
    MC @ smile "Gracias, Vala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:145
translate es qst_HumanExp_3_grabBook_atLibrary_menu_389afce0:

    # MC "(I better get this back to Myu.)"
    MC "(Será mejor que le lleve esto a Myu)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:147
translate es qst_HumanExp_3_grabBook_atLibrary_menu_684a3850:

    # VALA "I'll keep the books ready for you."
    VALA "Tendré los libros listos para ti."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:154
translate es qst_HumanExp_3_grabBook_atLibrary_revisit_0b639321:

    # VALA "Yeah, it's five hundred coins for the collection of books on Alderian language."
    VALA "Sí, son quinientas monedas por la colección de libros sobre la lengua alderiana."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:156
translate es qst_HumanExp_3_grabBook_atLibrary_revisit_4f5efc7e:

    # VALA "Yeah, four hundred coins and the collection is yours."
    VALA "Sí, cuatrocientas monedas y la colección es tuya."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:161
translate es qst_HumanExp_3_grabBook_atLibrary_revisit_menu_e8c0c2aa:

    # VALA "I... There is a slightly damaged copy of the collection that I could sell it to you at a slight discount?"
    VALA "... Hay una copia ligeramente dañada de la colección que podría vendértela con un ligero descuento?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:162
