translate es qst_HumanExp_11_returnFlowers_93620a4e:

    # REGINA @ talk "Not like there's a shortage of criminals these days either."
    REGINA @ talk "Tampoco es que haya escasez de delincuentes hoy en día."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:820
translate es qst_HumanExp_11_returnFlowers_dc4c5a11:

    # MC @ talk "Just, find some... bandits?"
    MC @ talk "Solo, encontrar algunos... ¿bandidos?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:821
translate es qst_HumanExp_11_returnFlowers_d8c8a264:

    # MC @ talk "And let her {b}eat them?{/b}"
    MC @ talk "¿Y dejar que se {b}los coma?{/b}"

