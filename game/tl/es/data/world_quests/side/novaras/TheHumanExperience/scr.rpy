    # SHAY @ talk "Here, take a seat."
    SHAY @ talk "Aquí, toma asiento."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:609
translate es qst_HumanExp_8_shayGetBetterFood_356e3a8b:

    # SHAY @ talk "What drink shall I bring you?"
    SHAY @ talk "¿Qué te traigo de beber?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:610
translate es qst_HumanExp_8_shayGetBetterFood_2432045f:

    # MC @ smile "An Ale will suffice."
    MC @ smile "Una cerveza será suficiente."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:611
translate es qst_HumanExp_8_shayGetBetterFood_25fcf3e3:

    # SHAY @ smile "Very well, I will be back shortly."
    SHAY @ smile "Muy bien, volveré enseguida."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:613
translate es qst_HumanExp_8_shayGetBetterFood_cedf9ed1:

    # "As I sat down at one of the tables, Shay returned after a short while with my food and drink."
    "Al rato de sentarme en una de las mesas, Shay volvió con mi comida y mi bebida."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:614
translate es qst_HumanExp_8_shayGetBetterFood_b9c578ac:

    # "The piping hot deer smelt amazing; it had been a long time since I had enjoyed a meal quite so expensive."
    "El ciervo bien caliente olía de maravilla; hacía mucho tiempo que no disfrutaba de una comida tan cara."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:615
translate es qst_HumanExp_8_shayGetBetterFood_49313434:

    # "A meal such as this now, was a reserved treat father would have bought us to celebrate Harvest Day once a year."
    "Una comida como ésta, ahora, era un capricho reservado que papá nos compraba para celebrar el día de la cosecha una vez al año."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:616
translate es qst_HumanExp_8_shayGetBetterFood_8551840f:

    # "Many would not even think of wasting the coin on such a thing, and it was simply unattainable for most."
    "A muchos ni se les ocurriría malgastar monedas en algo así, y era sencillamente inalcanzable para la mayoría."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:617
translate es qst_HumanExp_8_shayGetBetterFood_260eee86:

    # "Here I was though, not only able to afford it, but enjoying it almost as though it was like any other meal."
    "Sin embargo, aquí estaba yo, no solo capaz de permitírmelo, sino disfrutándolo casi como si fuera cualquier otra comida."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:618
translate es qst_HumanExp_8_shayGetBetterFood_c7ae9e21:

    # "Despite the inherent danger... The mercenary life paid well alright."
    "A pesar del peligro inherente... La vida de mercenario pagaba bien."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:619
translate es qst_HumanExp_8_shayGetBetterFood_4017ecb0:

    # "Beneath the table, I rested the container holding Myu, and would every so often palm a piece of the meat under the table which she would take from my hand gently with a tentacle to consume."
    "Debajo de la mesa, apoyé el recipiente que contenía a Myu, y de vez en cuando pasaba un trozo de carne por debajo de la mesa que ella cogía suavemente de mi mano con un tentáculo para consumirlo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:620
translate es qst_HumanExp_8_shayGetBetterFood_aa209940:

    # "Finally, once the meal was finished, I gathered Myu back into my possession once again and rose to my feet."
    "Finalmente, una vez terminada la comida, volví a coger a Myu y me puse en pie."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:624
translate es qst_HumanExp_8_shayGetBetterFood_69ba816e:

    # SHAY @ talk "How was it?"
    SHAY @ talk "¿Cómo estuvo?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:625
translate es qst_HumanExp_8_shayGetBetterFood_858c1d3b:

    # MC @ smile2 "It was perfect."
    MC @ smile2 "Estuvo perfecto."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:626
translate es qst_HumanExp_8_shayGetBetterFood_0980d96f:

    # SHAY @ smile "Ah! I'm so glad to hear that!"
    SHAY @ smile "¡Ah! ¡Me alegra mucho oír eso!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:627
translate es qst_HumanExp_8_shayGetBetterFood_b5f23e75:

    # SHAY @ talk "Nice to see my cooking is still up to standard then!"
    SHAY @ talk "¡Me alegra ver que mi cocina sigue estando a la altura!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:628
translate es qst_HumanExp_8_shayGetBetterFood_a4ec6299:

    # MC @ talk "You cooked it?"
    MC @ talk "¿Lo has cocinado tú?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:629
translate es qst_HumanExp_8_shayGetBetterFood_267641f9:

    # SHAY @ talk "Ha... Did you think we hired a cook or something?"
    SHAY @ talk "Ja... ¿Creías que habíamos contratado a un cocinero o algo así?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:630
translate es qst_HumanExp_8_shayGetBetterFood_772372eb:

    # SHAY @ talk "No, just me and my husband."
    SHAY @ talk "No, solo mi marido y yo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:631
translate es qst_HumanExp_8_shayGetBetterFood_6188caea:

    # MC @ talk "I see."
    MC @ talk "Ya veo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:632
translate es qst_HumanExp_8_shayGetBetterFood_f8b95ddd:

    # "The box Myu was in rumbled."
    "La caja en la que estaba Myu retumbó."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:633
translate es qst_HumanExp_8_shayGetBetterFood_26ac48a8:

    # MC "(Damn it!)"
    MC "(¡Maldita sea!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:634
translate es qst_HumanExp_8_shayGetBetterFood_2e450c2d:

    # MC "(Keep still!)"
    MC "(¡Quédate quieta!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:635
translate es qst_HumanExp_8_shayGetBetterFood_b4884869:

    # SHAY @ shock "Hm? Is everything okay?"
    SHAY @ shock "¿Hm? ¿Va todo bien?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:636
translate es qst_HumanExp_8_shayGetBetterFood_22539f1d:

    # SHAY @ think "You seem a little... pre-occupied with something."
    SHAY @ think "Pareces un poco... preocupado por algo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:637
translate es qst_HumanExp_8_shayGetBetterFood_0d25517b:

    # MC @ surprised "Oh, uh...!"
    MC @ surprised "¡Oh, uh...!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:638
translate es qst_HumanExp_8_shayGetBetterFood_d87999d3:

    # MC @ talk "I just remembered I had something to do is all!"
    MC @ talk "Acabo de recordar que tenía algo que hacer, ¡eso es todo!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:639
translate es qst_HumanExp_8_shayGetBetterFood_548feb58:

    # SHAY @ shock "Oh, um, okay."
    SHAY @ shock "Oh, um, vale."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:640
translate es qst_HumanExp_8_shayGetBetterFood_f5269d9a:

    # SHAY @ talk "Well, don't let me-"
    SHAY @ talk "Bueno, pues no dejes que-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:641
translate es qst_HumanExp_8_shayGetBetterFood_1fb61035:

    # "Feeling the box continue to rumble more erratically, I hurried off outside before even finishing my conversation with Shay."
    "Al sentir que la caja seguía retumbando de forma más errática, me apresuré a salir antes incluso de terminar mi conversación con Shay."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:642
translate es qst_HumanExp_8_shayGetBetterFood_71a9b09a:

    # MC "Thanks for the food! Talk soon!"
    MC "Gracias por la comida. ¡Hablamos pronto!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:643
translate es qst_HumanExp_8_shayGetBetterFood_47794d20:

    # SHAY @ talk "...Keep you here."
    SHAY @ talk "...distraiga aquí."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:644
translate es qst_HumanExp_8_shayGetBetterFood_52236020:

    # SHAY "(What was up with him back there?)"
    SHAY "(¿Qué le pasó ahí antes?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:645
translate es qst_HumanExp_8_shayGetBetterFood_1771326a:

    # SHAY "(He's an odd one, isn't he?)"
    SHAY "(Es un tipo raro, ¿verdad?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:651
translate es qst_HumanExp_8_shayGetBetterFood_9bd8eed0:

    # "In a hushed tone, I pulled Myu's container towards me."
    "En voz baja, acerqué el recipiente de Myu hacia mí."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:652
translate es qst_HumanExp_8_shayGetBetterFood_2bce9f55:

    # MC @ angry "Myu! Be quiet damn it!"
    MC @ angry "¡Myu! ¡Estate quieta, maldita sea!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:654
translate es qst_HumanExp_8_shayGetBetterFood_3eb6e334:

    # "The container continued to rumble."
    "El contenedor siguió retumbando."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:655
translate es qst_HumanExp_8_shayGetBetterFood_6162c6ef:

    # MC "(Damn it, I need to get her home and see what's wrong.)"
    MC "(Maldita sea, tengo que llevarla a casa y ver qué le pasa)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:661
translate es qst_HumanExp_8_shayGetBetterFood_4a832edb:

    # "Myu erupted out of the container on her hands and knees, violently shaking as she began to throw up the half-dissolved food."
    "Myu salió del recipiente de rodillas, sacudiéndose violentamente mientras empezaba a vomitar la comida a medio disolver."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:664
translate es qst_HumanExp_8_shayGetBetterFood_501e6795:

    # MC @ surprised "Myu!"
    MC @ surprised "¡Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:665
translate es qst_HumanExp_8_shayGetBetterFood_28c0b8c4:

    # "Myu weakly rose back to her feet trembling."
    "Myu se puso en pie temblando."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:666
translate es qst_HumanExp_8_shayGetBetterFood_08983c0c:

    # MYU @ sad "M-Myu... Not good."
    MYU @ sad "M-Myu... No bien."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:667
translate es qst_HumanExp_8_shayGetBetterFood_4e49aec7:

    # "Myu, too weak to hold her form, collapsed into a puddle on the floor and dragged herself into a corner miserably."
    "Myu, demasiado débil para mantener la forma, se desplomó en un charco en el suelo y se arrastró a un rincón miserablemente."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:669
translate es qst_HumanExp_8_shayGetBetterFood_872010a3:

    # MC "(Fuck! FUCK!)"
    MC "(¡Joder! ¡JODER!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:670
translate es qst_HumanExp_8_shayGetBetterFood_b95aa3b6:

    # MC "(What did I do wrong?)"
    MC "(¿Qué he hecho mal?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:671
translate es qst_HumanExp_8_shayGetBetterFood_a9e4dcc3:

    # MC "(S-Shit!)"
    MC "(¡M-mierda!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:672
translate es qst_HumanExp_8_shayGetBetterFood_c33b3aeb:

    # MC "(There has to be something I can do... Maybe I can find a book to read up on them or something?)"
    MC "(Tiene que haber algo que pueda hacer... ¿Tal vez pueda encontrar un libro para leer sobre ellos o algo así?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:673
translate es qst_HumanExp_8_shayGetBetterFood_e768b575:

    # MC "(What am I missing?)"
    MC "(¿Qué se me está escapando?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:674
translate es qst_HumanExp_8_shayGetBetterFood_bebd2464:

    # MC "(She ate the meat fine before, why not now?)"
    MC "(Antes comía bien la carne, ¿por qué ahora no?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:672
translate es qst_HumanExp_9_valaLearnSlimelarks_3b987541:

    # VALA "Slimelarks?"
    VALA "¿Slimelarks?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:673
translate es qst_HumanExp_9_valaLearnSlimelarks_cfc74e71:

    # VALA "Umm, I think they're mentioned in a couple bestiaries, but there's nothing devoted just to them."
    VALA "Umm, creo que se mencionan en un par de bestiarios, pero no hay nada dedicado solo a ellos."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:683
translate es qst_HumanExp_9_valaLearnSlimelarks_fbc08ab9:

    # MC @ talk "Do you have one of these bestiaries?"
    MC @ talk "¿Tienes alguno de estos bestiarios?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:675
translate es qst_HumanExp_9_valaLearnSlimelarks_e33b273c:

    # VALA "I can try gather you up some if that's what you want..."
    VALA "Puedo intentar conseguirte alguno si es lo que quieres..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:676
translate es qst_HumanExp_9_valaLearnSlimelarks_29beeb65:

    # VALA "What's this about?"
    VALA "¿De qué se trata?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:677
translate es qst_HumanExp_9_valaLearnSlimelarks_7943dd4f:

    # VALA "It might help if I knew what you were looking to find out about them."
    VALA "Podría ayudar si supiera lo que quieres averiguar sobre ellos."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:687
translate es qst_HumanExp_9_valaLearnSlimelarks_0ce2104b:

    # MC @ think "Uhh, their diet I guess."
    MC @ think "Uhh, su dieta supongo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:679
translate es qst_HumanExp_9_valaLearnSlimelarks_db9498b4:

    # VALA "Their diet?"
    VALA "¿Su dieta?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:680
translate es qst_HumanExp_9_valaLearnSlimelarks_5f9b271e:

    # VALA "OOOH! Are you writing a new research journal on them?!"
    VALA "¡OOOH! ¡¿Estás escribiendo un nuevo diario de investigación sobre ellos?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:690
translate es qst_HumanExp_9_valaLearnSlimelarks_f4e0442a:

    # MC @ think "Uhh, not exactly..."
    MC @ think "Uhh, no exactamente..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:682
translate es qst_HumanExp_9_valaLearnSlimelarks_3eab76be:

    # VALA "Hmmmm, interesting."
    VALA "Hmmmm, interesante."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:683
translate es qst_HumanExp_9_valaLearnSlimelarks_d5f50d4e:

    # VALA "Well, okay then."
    VALA "Bien, de acuerdo entonces."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:684
translate es qst_HumanExp_9_valaLearnSlimelarks_1522084b:

    # VALA "I'll try narrow down the books to the most useful for you then."
    VALA "Intentaré reducir los libros a los más útiles para ti entonces."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:694
translate es qst_HumanExp_9_valaLearnSlimelarks_400bf3f5:

    # MC @ smile "Thank you, Vala."
    MC @ smile "Gracias, Vala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:686
translate es qst_HumanExp_9_valaLearnSlimelarks_b76cebc3:

    # VALA "Don't mention it! Always happy to help a fellow keen mind!"
    VALA "¡Ni lo menciones! ¡Siempre es un placer ayudar a una mente entusiasta!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:697
translate es qst_HumanExp_9_valaLearnSlimelarks_1e512692:

    # "A while later..."
    "Un rato después..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:701
translate es qst_HumanExp_9_valaLearnSlimelarks_0ba33670:

    # MC "(Damn it, what's taking so long? It's nearly been an hour!)"
    MC "(Maldita sea, ¿por qué tarda tanto? ¡Casi ha pasado una hora!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:702
translate es qst_HumanExp_9_valaLearnSlimelarks_3a1b2e7e:

    # MC "(I need to get back and-)"
    MC "(Tengo que volver y-)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:695
translate es qst_HumanExp_9_valaLearnSlimelarks_3b14a3b0:

    # VALA "Phew!"
    VALA "¡Uf!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:696
translate es qst_HumanExp_9_valaLearnSlimelarks_b19bd620:

    # VALA "Well, there was a lot on Slimelarks but not much talking about what they eat."
    VALA "Bueno, había mucho sobre slimelarks pero no se hablaba mucho de lo que comen."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:706
translate es qst_HumanExp_9_valaLearnSlimelarks_cbdd3e29:

    # MC @ talk "What did you find?"
    MC @ talk "¿Qué has encontrado?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:698
translate es qst_HumanExp_9_valaLearnSlimelarks_e36d030e:

    # VALA "This seems to be the best source of reference."
    VALA "Éste parece ser la mejor fuente de referencia."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:699
translate es qst_HumanExp_9_valaLearnSlimelarks_f7233d18:

    # VALA "It was one of the earlier studies on Slimelarks, but it's one of the few that goes into their natural lives rather than just discussing the quickest way to kill them."
    VALA "Fue uno de los primeros estudios sobre los slimelarks, pero es uno de los pocos que se adentra en su vida natural en lugar de limitarse a decir la forma más rápida de matarlos."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:709
translate es qst_HumanExp_9_valaLearnSlimelarks_1003da7c:

    # MC @ talk "Ah, thank you, Vala."
    MC @ talk "Ah, Gracias, Vala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:701
translate es qst_HumanExp_9_valaLearnSlimelarks_60f52a26:

    # VALA "Just leave the book here when you're done."
    VALA "Simplemente deja el libro aquí cuando termines."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:712
translate es qst_HumanExp_9_valaLearnSlimelarks_8de5398c:

    # "{i}Slimelarks, by their very nature, are omnivorous predators.{/i}"
    "{i}Los slimelarks, por su propia naturaleza, son depredadores omnívoros.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:713
translate es qst_HumanExp_9_valaLearnSlimelarks_0069e7e7:

    # "{i}In their infancy, they rely far more on raw meat, often provided to them by their mothers, in order to build up their strength.{/i}"
    "{i}En su infancia, dependen mucho más de la carne cruda, que a menudo les proporcionan sus madres, para fortalecerse.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:714
translate es qst_HumanExp_9_valaLearnSlimelarks_8bfd7566:

    # "{i}However, this is only one component of the slimelarks diet, it is essential for their growth they then move on to consume other substances, such as wildflower.{/i}"
    "{i}Sin embargo, éste es solo uno de los componentes de la dieta de los slimelarks, ya que es esencial para su crecimiento y luego pasan a consumir otras sustancias, como flores silvestres.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:715
translate es qst_HumanExp_9_valaLearnSlimelarks_d31c9191:

    # "{i}Slimelarks do not possess any sort of organs similar to mammals, and thus, they rely on consuming various substances in order to compensate for their internal processes.{/i}"
    "{i}Los slimelarks no poseen ningún tipo de órganos similares a los de los mamíferos, por lo que dependen del consumo de diversas sustancias para compensar sus procesos internos.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:716
translate es qst_HumanExp_9_valaLearnSlimelarks_26377531:

    # "{i}For example, the wild flowers helps the slimelarks with internal acidic production, allowing them to break down the meat and other foods they consume, without it, a slimelark can very quickly become sick.{/i}"
    "{i}Por ejemplo, las flores silvestres ayudan a los slimelarks con la producción interna de ácido, lo que les permite descomponer la carne y otros alimentos que consumen, sin ellas, un slimelark puede enfermar muy rápidamente.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:717
translate es qst_HumanExp_9_valaLearnSlimelarks_a7a71b6b:

    # MC "(Wildflower... Perhaps I could gather some by the Lake?)"
    MC "(Flores silvestres... ¿Quizás podría recoger algunas junto al lago?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:724
translate es qst_HumanExp_11_returnFlowers_c53c2393:

    # "With the wildflower ready in my pouch, I practically burst through the door hurrying inside."
    "Con la flor silvestre lista en mi bolsa, prácticamente atravesé la puerta apresurándome a entrar."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:726
translate es qst_HumanExp_11_returnFlowers_ce8edcdf:

    # MC @ talk "Myu! Where are you?"
    MC @ talk "¡Myu! ¿Dónde estás?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:727
translate es qst_HumanExp_11_returnFlowers_197c8e3a:

    # MC @ scared "MYU!"
    MC @ scared "¡MYU!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:729
translate es qst_HumanExp_11_returnFlowers_f2d51170:

    # MC "(Oh fuck... Fuck! Where did she go?)"
    MC "(Oh joder... ¡Joder! ¿Dónde se ha metido?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:730
translate es qst_HumanExp_11_returnFlowers_0f3104bf:

