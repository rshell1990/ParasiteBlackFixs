    # REGINA @ talk "Slimelarks can tell when one of their own has been... {i}tainted,{/i} so to speak."
    REGINA @ talk "Los Slimelarks pueden decir cuando uno de los suyos ha sido... {i}manchado,{/i} por así decirlo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:834
translate es qst_HumanExp_11_returnFlowers_menu_9f7c7726:

    # REGINA @ talk "If you {i}did{/i} manage to get rid of her, she'd be all alone."
    REGINA @ talk "Si {i}consiguieras{/i} deshacerte de ella, se quedaría sola...."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:838
translate es qst_HumanExp_11_returnFlowers_menu_06a01ce2:

    # REGINA @ talk "Hm?"
    REGINA @ talk "¿Hm?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:839
translate es qst_HumanExp_11_returnFlowers_menu_33baed23:

    # MC @ think "Well, I figured you would be more afraid."
    MC @ think "Bueno, supuse que tendrías más miedo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:840
translate es qst_HumanExp_11_returnFlowers_menu_a8a1870f:

    # MC @ think "Instead, you seem more... {i}Annoyed.{/i}"
    MC @ think "En cambio, pareces más... {i}molesta.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:841
translate es qst_HumanExp_11_returnFlowers_menu_d364f8b2:

    # REGINA @ talk "It's like I said, I grew nearby to some, now can we change the subject please?"
    REGINA @ talk "Es como ya he dicho, crecí cerca de algunos, ahora ¿podemos cambiar de tema por favor?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:842
translate es qst_HumanExp_11_returnFlowers_menu_21ce3cf3:

    # MC "(I have the distinct feeling she's hiding something from me.)"
    MC "(Tengo la clara sensación de que me oculta algo)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:811
translate es qst_HumanExp_11_returnFlowers_menu_d9a46452:

    # "[regina_ref_cap!t] frowned."
    "[regina_ref_cap!t] frunció el ceño."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:847
translate es qst_HumanExp_11_returnFlowers_menu_635b928b:

    # REGINA @ angry "Just keep her out of sight, understand?"
    REGINA @ angry "Solo mantenla fuera de la vista, ¿entendido?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:848
translate es qst_HumanExp_11_returnFlowers_menu_d245c096:

    # REGINA @ talk "Inquisitors and their lot won't take kindly to a slimelark living within Novaras."
    REGINA @ talk "Los inquisidores y sus seguidores no verán con buenos ojos que un slimelark viva en Novaras."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:849
translate es qst_HumanExp_11_returnFlowers_menu_333a0828:

    # MYU @ joy "All done!"
    MYU @ joy "¡Ya está!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:850
translate es qst_HumanExp_11_returnFlowers_menu_65bb192a:

    # "Myu proudly presented her empty plate to show she was finished, and Regina took it from her with a smile."
    "Myu presentó orgullosa su plato vacío para demostrar que había terminado, y Regina se lo cogió con una sonrisa."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:851
translate es qst_HumanExp_11_returnFlowers_menu_57258f18:

    # REGINA @ smile "Very good, Myu!"
    REGINA @ smile "¡Muy bien, Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:852
translate es qst_HumanExp_11_returnFlowers_menu_e8c47127:

    # REGINA @ talk "Now we will continue teaching you Alderian the next time you visit, yes?"
    REGINA @ talk "Ahora seguiremos enseñándote alderiano la próxima vez que nos visites, ¿sí?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:853
translate es qst_HumanExp_11_returnFlowers_menu_c8c179ed:

    # MYU @ joy "Yes!"
    MYU @ joy "¡Sí!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:854
translate es qst_HumanExp_11_returnFlowers_menu_f2a3ff78:

    # REGINA @ talk "Good."
    REGINA @ talk "Bien."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:855
translate es qst_HumanExp_11_returnFlowers_menu_261bc297:

    # "Regina flashed one more look at me making it clear I needed to get a grip on this, {i}quickly.{/i}"
    "Regina me dirigió una mirada más, dejándome claro que tenía que hacerme cargo de esto, {i}rápidamente.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:822
translate es qst_HumanExp_11_returnFlowers_menu_7078d917:

    # MC "(Shit... I guess I should do what [regina_ref!t] says and take her out {i}hunting{/i} one night.)"
    MC "(Mierda... Supongo que debería hacer lo que dice [regina_ref!t] y llevarla de {i}caza{/i} una noche)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:858
translate es qst_HumanExp_11_returnFlowers_menu_e6faef72:

    # MC "(Hunting {i}people...{/i})"
    MC "(Cazar {i}gente...{/i})"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:824
translate es qst_HumanExp_11_returnFlowers_menu_87c233dd:

    # "Something about the wording of it made me slightly queasy, but [regina_ref!t] was right."
    "Algo en la elección de palabras me dio un poco de asco, pero [regina_ref!t] tenía razón."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:860
translate es qst_HumanExp_11_returnFlowers_menu_310dae3a:

    # "Myu was a predator... And Myu would need to hunt."
    "Myu era una depredadora... Y Myu necesitaría cazar."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:864
translate es qst_HumanExp_11_returnFlowers_menu_8dd667da:

    # "After that, I headed back to the abandoned safe house with a much healthier Myu."
    "Después de eso, me dirigí de nuevo al refugio abandonado con un Myu mucho más saludable."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:830
translate es qst_HumanExp_11_returnFlowers_menu_5421c183:

    # "[regina_ref_cap!t] followed us too at her insistence, in case she ever needed to visit the safe house and check on Myu herself."
    "[regina_ref_cap!t] también nos siguió, por insistencia suya, por si alguna vez necesitaba visitar el refugio y ver cómo estaba Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:872
translate es qst_HumanExp_11_returnFlowers_menu_c47cff1a:

    # REGINA @ talk "Ah, so this is the place."
    REGINA @ talk "Ah, así que este es el lugar."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:873
translate es qst_HumanExp_11_returnFlowers_menu_6750e14d:

    # REGINA @ smile "...Not very homely, is it?"
    REGINA @ smile "...No es muy hogareño, ¿verdad?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:874
translate es qst_HumanExp_11_returnFlowers_menu_e1e58f16:

    # MC @ talk "It's the best I could do on short notice."
    MC @ talk "Es lo mejor que he podido hacer con tan poco tiempo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:875
translate es qst_HumanExp_11_returnFlowers_menu_0c652db2:

    # REGINA @ talk "It'll serve it's purpose."
    REGINA @ talk "Servirá a su propósito."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:841
translate es qst_HumanExp_11_returnFlowers_menu_911b8b2a:

    # "[regina_ref_cap!t] smiled as she turned to face Myu."
    "[regina_ref_cap!t] sonrió mientras se giraba para mirar a Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:877
translate es qst_HumanExp_11_returnFlowers_menu_f137887c:

    # REGINA @ smile "Anyway, it was nice to meet you Myu!"
    REGINA @ smile "De todos modos, ¡fue un placer conocerte Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:878
translate es qst_HumanExp_11_returnFlowers_menu_26d2afaf:

    # MYU @ joy "Thank you for food!"
    MYU @ joy "¡Gracias por la comida!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:879
translate es qst_HumanExp_11_returnFlowers_menu_7284c4cb:

    # REGINA @ smile "You're very welcome."
    REGINA @ smile "De nada."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:880
translate es qst_HumanExp_11_returnFlowers_menu_8b420002:

    # REGINA @ talk "Now, I must make my leave so..."
    REGINA @ talk "Ahora, debo irme así que..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:881
translate es qst_HumanExp_11_returnFlowers_menu_fb7f6298:

    # REGINA @ talk "Goodbye both!"
    REGINA @ talk "¡Adiós a los dos!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:848
translate es qst_HumanExp_11_returnFlowers_menu_badd5920:

    # MC @ talk "Bye [regina_ref!t]."
    MC @ talk "Adiós, [regina_ref!t]."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:883
translate es qst_HumanExp_11_returnFlowers_menu_2b826f25:

    # MYU @ joy "Bye bye nice lady!"
    MYU @ joy "¡Adiós señorita simpática!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:850
translate es qst_HumanExp_11_returnFlowers_menu_8f359bd6:

    # "[regina_ref_cap!t] chuckled as she closed the door behind her."
    "[regina_ref_cap!t] rió mientras cerraba la puerta tras de sí."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:891
translate es qst_HumanExp_11_returnFlowers_menu_716247c1:

    # REGINA @ talk "Make sure to notify me the next time the two of them leave together, understand?"
    REGINA @ talk "Asegúrate de avisarme la próxima vez que los dos se vayan juntos, ¿entendido?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:885
translate es qst_HumanExp_11_returnFlowers_menu_e09b5916:

    # RAVEN "{i}*Squarks!*{/i}"
    RAVEN "{i}*¡Graznido!*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:905
translate es qst_HumanExp_12_goHunting_4996d099:

    # "Myu tilted her head as she puzzled out my words."
    "Myu inclinó la cabeza mientras descifraba mis palabras."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:906
translate es qst_HumanExp_12_goHunting_b2346d4e:

    # MYU @ think "...Hunt?"
    MYU @ think "...¿Cazar?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:907
translate es qst_HumanExp_12_goHunting_50364f9b:

    # MC @ talk "Yeah, can you get back into-"
    MC @ talk "Sí, ¿puedes volver a entrar en-?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:908
translate es qst_HumanExp_12_goHunting_c2604d4b:

    # "Looking down at the container, I could see after last time, it now had a large crack running down it."
    "Mirando el contenedor, pude ver que después de la última vez, ahora tenía una gran grieta que lo recorría."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:909
translate es qst_HumanExp_12_goHunting_94ca2038:

    # MC "(Fuck, this is no good.)"
    MC "(Joder, esto no es bueno)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:910
translate es qst_HumanExp_12_goHunting_f60cdd99:

    # MC @ talk "Myu, wait here while I look for something for you to hide in."
    MC @ talk "Myu, espera aquí mientras busco algo para que te escondas."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:911
translate es qst_HumanExp_12_goHunting_13e96976:

    # MYU @ talk "No... Myu... help."
    MYU @ talk "No... Myu... ayudar."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:913
translate es qst_HumanExp_12_goHunting_969ccaed:

    # MC @ think "Help? What are you-"
    MC @ think "¿Ayudar? ¿Qué es lo que-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:914
translate es qst_HumanExp_12_goHunting_c89dc97f:

    # "Myu dropped down into her puddle like form once again, crawling toward me quickly as she clambered up through the crevices of my armour."
    "Myu volvió a caer en su forma de charco y se arrastró rápidamente hacia mí mientras trepaba por las grietas de mi armadura."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:916
translate es qst_HumanExp_12_goHunting_c21dc864:

    # MC @ surprised "WHAT ARE YOU-"
    MC @ surprised "¿QUÉ ESTÁS-?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:917
translate es qst_HumanExp_12_goHunting_ff3394d5:

    # "I could feel Myu warmly resting beneath my armour, she was calm, and only lightly shifting beneath me."
    "Podía sentir a Myu cálidamente apoyada bajo mi armadura, estaba tranquila y solo se movía ligeramente bajo mí."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:918
translate es qst_HumanExp_12_goHunting_aaa82b0f:

    # "To the untrained eye, no one would know the difference."
    "Para un ojo inexperto, nadie notaría la diferencia."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:919
translate es qst_HumanExp_12_goHunting_1c145803:

    # MYU "Myu! Myu!"
    MYU "¡Myu! ¡Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:920
translate es qst_HumanExp_12_goHunting_794ce1cb:

    # MC @ lewd "H-Hey! Easy down there!"
    MC @ lewd "¡O-oye! ¡Tranquila ahí abajo!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:921
translate es qst_HumanExp_12_goHunting_93cc5246:

    # MYU "Myu... Hide... People... No see."
    MYU "Myu... Esconder... Gente... No ver."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:922
translate es qst_HumanExp_12_goHunting_01091c43:

    # MC "(It's almost alarming how fast she's learning to speak Alderian.)"
    MC "(Es casi alarmante lo rápido que está aprendiendo a hablar alderiano)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:923
translate es qst_HumanExp_12_goHunting_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Suspiro*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:925
translate es qst_HumanExp_12_goHunting_22924bcd:

    # MC @ serious "Okay, Myu, but no coming out till I say, okay?"
    MC @ serious "Vale, Myu, pero no salgas hasta que yo lo diga, ¿de acuerdo?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:926
translate es qst_HumanExp_12_goHunting_61b6bc4f:

    # MYU "Okay!"
    MYU "¡De acuerdo!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:927
translate es qst_HumanExp_12_goHunting_da78808d:

    # "Beneath all the shifting under my armour, I felt what seemed like a lone tentacle sneakily moving further down than the others."
    "Debajo de mi armadura, sentí lo que parecía un tentáculo solitario moviéndose sigilosamente más abajo que los demás."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:929
translate es qst_HumanExp_12_goHunting_2e20f6ad:

    # MC @ talk "Myu... What are you doing?"
    MC @ talk "Myu... ¿Qué estás haciendo?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:930
translate es qst_HumanExp_12_goHunting_3643d5ca:

    # "The tentacle quickly retreated."
    "El tentáculo se retiró rápidamente."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:931
translate es qst_HumanExp_12_goHunting_663dc8eb:

    # MYU "{i}...Nothing!{/i}"
    MYU "{i}...¡Nada!{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:932
translate es qst_HumanExp_12_goHunting_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:934
translate es qst_HumanExp_12_goHunting_5cfca60c:

    # "With Myu shuffling beneath my armour, the two of us headed out into the Evening."
    "Con Myu escondiéndose bajo mi armadura, los dos salimos al anochecer."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:935
translate es qst_HumanExp_12_goHunting_f6a007ce:

    # "The first thing I did was head into the darkened back streets, away from too many prying eyes where I knew bandits and other unsavoury figures tended to linger."
    "Lo primero que hice fue adentrarme en los oscuros callejones, lejos de demasiadas miradas indiscretas, donde sabía que solían merodear bandidos y otras figuras desagradables."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:936
translate es qst_HumanExp_12_goHunting_7275f098:

    # "It didn't take long before I was surrounded by a group of thugs, blades drawn ready."
    "No tardé en verme rodeado por un grupo de matones con las espadas desenvainadas."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:936
translate es qst_HumanExp_12_goHunting_60b56d76:

    # THUG "Enjoying a little evening stroll, are we?"
    THUG "Disfrutando de un pequeño paseo al anochecer, ¿verdad?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:937
translate es qst_HumanExp_12_goHunting_60f36fe8:

    # THUG "Hand over your coin and we'll let you walk."
    THUG "Entrega tus monedas y te dejaremos marchar."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:949
translate es qst_HumanExp_12_goHunting_96541c35:

    # MC @ talk "...Myu, are you ready?"
    MC @ talk "...Myu, ¿estás lista?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:950
translate es qst_HumanExp_12_goHunting_bb741f1e:

    # MYU "..."
    MYU "..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:951
translate es qst_HumanExp_12_goHunting_db4a1e82:

    # "Myu said nothing, but I can feel something {i}changing{/i} beneath my armour."
    "Myu no dijo nada, pero puedo sentir que algo está {i}cambiando{/i} bajo mi armadura."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:952
translate es qst_HumanExp_12_goHunting_bf69987f:

    # "She might not have been able to understand all the words said just now, but she could {i}sense{/i} the men before her were hostile, and just like that, her animal instincts kicked in."
    "Puede que no fuera capaz de entender todas las palabras que acababan de decir, pero podía {i}sentir{/i} que los hombres que tenía delante eran hostiles, y sin más, sus instintos animales entraron en acción."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:953
translate es qst_HumanExp_12_goHunting_37060419:

    # "Pouring out of my armour, she re-formed herself in a frightening visage of sharp blades and teeth, snarling at the terrified bandits who immediately began to panic."
    "Saliendo de mi armadura, se transformó en un espantoso rostro de afiladas cuchillas y dientes, gruñendo a los aterrorizados bandidos, que inmediatamente empezaron a asustarse."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:956
translate es qst_HumanExp_12_goHunting_81f87009:

    # MYU "{i}*Snarls!*{/i}"
    MYU "{i}*¡Gruñidos!*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:950
translate es qst_HumanExp_12_goHunting_d39f0328:

    # THUG "WHAT THE FUCK IS THAT?!"
    THUG "¡¿QUÉ COÑO ES ESO?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:951
translate es qst_HumanExp_12_goHunting_74096ffd:

    # THUG "Kill it! KILL IT NOW!"
    THUG "¡Matadlo! ¡MATADLO AHORA!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:966
translate es qst_HumanExp_12_goHunting_49fa8301:

    # "As I drew my blade down across the last thug, I turned to see Myu."
    "Mientras desenvainaba mi espada contra el último matón, me giré para ver a Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:970
translate es qst_HumanExp_12_goHunting_2cd07a6f:

    # "Having eviscerated one of the bandits into a bloody pulp of flesh and blood, she was dissolving and devouring his flesh."
    "Tras eviscerar a uno de los bandidos hasta convertirlo en una pulpa sanguinolenta de carne y sangre, estaba disolviendo y devorando su carne."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:971
translate es qst_HumanExp_12_goHunting_022d254d:

    # "The Blood splatter on her body was absorbed through her skin, and the cute innocence she had conveyed until now was all but gone."
    "La salpicadura de sangre en su cuerpo fue absorbida por su piel, y la inocencia adorable que había transmitido hasta ahora prácticamente desapareció."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:972
translate es qst_HumanExp_12_goHunting_fa64eac2:

    # "Only this ghastly nightmare stood before me, lapping up the warm blood like milk."
    "Solo esta horrible pesadilla estaba ante mí, sorbiendo la sangre caliente como si fuera leche."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:973
translate es qst_HumanExp_12_goHunting_c728332a:

    # "One of the bandits still squirmed as she pressed her bladed hand into his body."
    "Uno de los bandidos aún se retorcía mientras ella presionaba su afilada mano contra su cuerpo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:975
translate es qst_HumanExp_12_goHunting_796deab9:

    # "Small tendrils pushed through his ripped open eye sockets and mouth."
    "Pequeños tentáculos se abrieron paso a través de las cuencas de sus ojos y de su boca."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:976
translate es qst_HumanExp_12_goHunting_011a31cb:

    # "Tentacles tore their way through his body and could be seen shifting about beneath the skin."
    "Los tentáculos se abrieron paso a través de su cuerpo y podían verse moviéndose bajo la piel."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:978
translate es qst_HumanExp_12_goHunting_cc0c4ed1:

    # "He gargled and choked as the tentacles seemed to puppeteer him briefly till he finally fell still, dead and drained pale white."
    "Hizo gárgaras y se atragantó mientras los tentáculos parecían manipularlo brevemente hasta que finalmente cayó inmóvil, muerto y desangrado de un blanco pálido."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:979
translate es qst_HumanExp_12_goHunting_d06fcedc:

    # "For a moment, I considered abandoning this... {i}thing{/i} right here."
    "Por un momento, consideré abandonar esta... {i}cosa{/i} aquí mismo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:980
translate es qst_HumanExp_12_goHunting_fbf28920:

    # "I could escape, let the City Guard handle this {i}monster{/i} standing before me."
    "Podría escapar, dejar que la guardia  e la ciudad se encargara de este {i}monstruo{/i}que tengo delante."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:982
translate es qst_HumanExp_12_goHunting_5512e3fe:

    # "Myu, noticing my expression, stopped eating and dragged her way towards me, the voice once again sweet as that innocent face of hers returned."
    "Myu, al notar mi expresión, dejó de comer y se arrastró hacia mí, la voz de nuevo dulce mientras volvía ese rostro inocente suyo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:986
translate es qst_HumanExp_12_goHunting_2534e2b7:

    # MYU @ sad "We... Go?"
    MYU @ sad "¿Nos... vamos?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:987
translate es qst_HumanExp_12_goHunting_f41c9653:

    # MC @ sad "...Y-Yes, we go."
    MC @ sad "...S-sí, vamos."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:991
translate es qst_HumanExp_12_goHunting_49eba397:

    # "The two of us hurried as we slipped away into the darkness back home before the guards stumbled upon the grizzly scene left in our wake."
    "Los dos nos apresuramos a escabullirnos en la oscuridad de vuelta a casa antes de que los guardias se tropezaran con la escena terrorífica que dejamos a nuestro paso."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:961
translate es qst_HumanExp_12_goHunting_b449b2ec:

    # MYU @ sad "...[player_name!t]?"
    MYU @ sad "...¿[player_name!t]?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:998
translate es qst_HumanExp_12_goHunting_4ac8c646:

    # MC @ talk "Myu? What is it?"
    MC @ talk "¿Myu? ¿Qué pasa?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:999
translate es qst_HumanExp_12_goHunting_6010b8f6:

    # MYU @ sad "{i}Why... Look at Myu like that...{/i}"
    MYU @ sad "{i}Por qué... Mira a Myu así...{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1000
translate es qst_HumanExp_12_goHunting_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "¿Eh?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1001
translate es qst_HumanExp_12_goHunting_72fee8b8:

    # MYU @ sad "Back in alley..."
    MYU @ sad "En el callejón..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1002
translate es qst_HumanExp_12_goHunting_0299ab02:

    # MYU @ sad "Not seen look at me like that before."
    MYU @ sad "No había visto mirarme así antes."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1003
translate es qst_HumanExp_12_goHunting_02c4c377:

    # MYU @ sad "Was Myu bad?"
    MYU @ sad "¿Myu era mala?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1004
translate es qst_HumanExp_12_goHunting_69c9834e:

    # MC @ sad "I-"
    MC @ sad "Yo-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1005
translate es qst_HumanExp_12_goHunting_89017916:

    # MC @ sad "No, Myu, you weren't bad."
    MC @ sad "No, Myu, no fuiste mala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1006
translate es qst_HumanExp_12_goHunting_14f50b3f:

    # MC @ talk "I've just never seen you like that before."
    MC @ talk "Es que nunca te había visto así."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1007
translate es qst_HumanExp_12_goHunting_b51439e1:

    # MYU @ sad "Like what?"
    MYU @ sad "¿Cómo qué?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1008
translate es qst_HumanExp_12_goHunting_f47d7bb8:

    # MC @ think "Just..."
    MC @ think "Solo..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1009
translate es qst_HumanExp_12_goHunting_ed3f878c:

    # "I didn't know how to answer her, what {i}could{/i} I say after what I just saw?"
    "No sabía cómo responderle, ¿qué {i}podía{/i} decir después de lo que acababa de ver?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1010
translate es qst_HumanExp_12_goHunting_7d580b52:

    # MC @ smile "Myu, why don't you get some rest?"
    MC @ smile "Myu, ¿por qué no descansas un poco?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1011
translate es qst_HumanExp_12_goHunting_11db02de:

    # MC @ smile "Its been a long night."
    MC @ smile "Ha sido una noche larga."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1012
translate es qst_HumanExp_12_goHunting_89de05dc:

    # "Myu nodded softly, making her way towards the bedroom."
    "Myu asintió suavemente, dirigiéndose hacia el dormitorio."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1016
translate es qst_HumanExp_12_goHunting_73488014:

    # REGINA @ talk "How did it go?"
    REGINA @ talk "¿Cómo te fue?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:982
translate es qst_HumanExp_12_goHunting_ab4c4d36:

    # MC @ surprised "[regina_ref_cap!t]! How long have you-"
    MC @ surprised "¡[regina_ref_cap!t]! ¿Cuánto tiempo-?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1019
translate es qst_HumanExp_12_goHunting_46eac9a6:

    # REGINA @ smile "Oh, I just slipped in earlier to see how Myu was doing!"
    REGINA @ smile "¡Oh, me he colado antes para ver cómo estaba Myu!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1020
translate es qst_HumanExp_12_goHunting_ee978acf:

    # REGINA @ talk "When I noticed she was gone, I figured the two of you must have been {i}out,{/i} so I decided to wait for you."
    REGINA @ talk "Cuando me di cuenta de que se había ido, pensé que vosotros dos estaríais {i}fuera,{/i} así que decidí esperaros."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1021
translate es qst_HumanExp_12_goHunting_b1b3ce81:

    # MC @ think "O-Oh, right, of course."
    MC @ think "O-oh, claro, por supuesto."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1025
translate es qst_HumanExp_12_goHunting_b78cb548:

    # REGINA @ sad "...So, how was it?"
    REGINA @ sad "...Entonces, ¿cómo fue?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1026
translate es qst_HumanExp_12_goHunting_b060895f:

    # MC @ serious "It was... Difficult seeing her do that."
    MC @ serious "Fue... Difícil verla hacer eso."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1027
translate es qst_HumanExp_12_goHunting_b0c66fe1:

    # MC @ sad "Like, it felt like I was dealing with another {i}monster.{/i}"
    MC @ sad "Como si estuviera tratando con otro {i}monstruo.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1028
translate es qst_HumanExp_12_goHunting_07f65605:

    # REGINA @ sad "{i}*Sigh*{/i}"
    REGINA @ sad "{i}*Suspiro*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:993
translate es qst_HumanExp_12_goHunting_5c6cb119:

    # REGINA @ sad "It's her nature, [player_name!t], no matter how much she learns to be around humans, that killer instinct will always be there."
    REGINA @ sad "Es su naturaleza, [player_name!t], por mucho que aprenda a estar rodeada de humanos, ese instinto asesino siempre estará ahí."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1030
translate es qst_HumanExp_12_goHunting_1ccd9609:

    # MC @ talk "...Is she safe to keep around?"
    MC @ talk "...¿Es seguro mantenerla cerca?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:995
translate es qst_HumanExp_12_goHunting_d3a8eb26:

    # "[regina_ref_cap!t] shrugged."
    "[regina_ref_cap!t] se encogió de hombros."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1032
translate es qst_HumanExp_12_goHunting_e3a90034:

    # REGINA @ talk "People have kept and trained slimes before."
    REGINA @ talk "La gente ha mantenido y entrenado slimes antes."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1033
translate es qst_HumanExp_12_goHunting_f3037070:

    # REGINA @ talk "But its not like keeping a dog."
    REGINA @ talk "Pero no es como tener un perro."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1034
translate es qst_HumanExp_12_goHunting_fa93a8fa:

    # REGINA @ talk "Even if they {i}*can*{/i} speak, they can still switch at a moment's notice."
    REGINA @ talk "Aunque {i}*puedan*{/i} hablar, pueden cambiar de un momento a otro."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1035
translate es qst_HumanExp_12_goHunting_84335a2a:

    # MC @ surprised "But, you said she's imprinted on me, right?"
    MC @ surprised "Pero, dijiste que ella se ha improntado en mí, ¿verdad?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1036
translate es qst_HumanExp_12_goHunting_a399f7bc:

    # REGINA @ talk "Doesn't mean she wont attack others if she gets overwhelmed or any number of things could happen..."
    REGINA @ talk "Eso no significa que no vaya a atacar a otros si se ve abrumada o que puedan ocurrir muchas cosas..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1037
translate es qst_HumanExp_12_goHunting_7821a17c:

    # MC @ talk "Then what should I do with her?"
    MC @ talk "Entonces, ¿qué debería hacer con ella?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1038
translate es qst_HumanExp_12_goHunting_9898c219:

    # REGINA @ talk "Just keep an eye on her, that's all."
    REGINA @ talk "Solo no la pierdas de vista, eso es todo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1039
translate es qst_HumanExp_12_goHunting_4d3c2876:

    # REGINA @ talk "Only time will tell."
    REGINA @ talk "Solo el tiempo lo dirá."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1040
translate es qst_HumanExp_12_goHunting_9d8f7bf6:

    # MC @ talk "{i}*Sigh*{/i}"
    MC @ talk "{i}*Suspiro*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1041
translate es qst_HumanExp_12_goHunting_4f113424:

    # MC @ talk "I need some room."
    MC @ talk "Necesito algo de espacio."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1048
translate es qst_HumanExp_12_goHunting_a1873268:

    # MYU @ sad "..."
    MYU @ sad "..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1049
translate es qst_HumanExp_12_goHunting_7159a1e6:

    # MYU @ sad "Myu is..."
    MYU @ sad "Myu es..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1050
translate es qst_HumanExp_12_goHunting_3a796eb3:

    # MYU @ sad "{i}Monster.{/i}"
    MYU @ sad "{i}Monstruo.{/i}"

translate es strings:

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:86
    old "I'm hoping to improve my own mastery of the language."
    new "Espero mejorar mi propio dominio del idioma."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:86
    old "My reasons are my own."
    new "Mis razones son mías."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:86
    old "I'm trying to teach someone."
    new "Estoy tratando de enseñar a alguien."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:114
    old "Is there no way you could sell it to me cheaper?"
    new "¿No hay forma de que me lo vendas más barato?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:115
    old "Here is the coin."
    new "Aquí tienes las monedas."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:115
    old "I will be back soon."
    new "Volveré pronto."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:162
    old "Deal."
    new "De acuerdo."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:249
    old "How about we get to know each other a little more first?"
    new "¿Qué tal si primero nos conocemos un poco más?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:249
    old "Oh yeah, your ass belongs to me."
    new "Oh sí, tu culo me pertenece."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:249
    old "Myu, I'm sorry, I don't see you that way."
    new "Myu, lo siento, no te veo de esa manera."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:387
    old "There's a difference between expecting people with more money and power to be more responsible, and {i}punishing{/i} them for their wealth."
    new "Hay una diferencia entre esperar que las personas con más dinero y poder sean más responsables y {i}castigarlas{/i} por su riqueza."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:387
    old "Personally, I think we could do without any of the Aristocracy... We could manage better on our own."
    new "Personalmente, creo que podríamos prescindir de la aristocracia... Podríamos arreglárnoslas mejor solos."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:387
    old "Someone needs to be in charge, they have tough decisions to make themselves."
    new "Alguien debe estar a cargo, ellos mismos tienen que tomar decisiones difíciles."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:599
    old "Hm, I will come back another time then."
    new "Hmm, volveré en otro momento entonces."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:827
    old "So, you {i}don't{/i} want me to get rid of her?"
    new "Entonces, ¿{i}no{/i} quieres que me deshaga de ella?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:827
    old "I figured you'd be more afraid when you saw her..."
    new "Me imaginé que tendrías más miedo cuando la vieras..."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:827
    old "So... What now?"
    new "Entonces... ¿ahora qué?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:892
    old "Raven"
    new "Cuervo"
