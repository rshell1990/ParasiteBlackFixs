    # REGINA @ talk "What part of {i}imprinting{/i} do you not understand?"
    REGINA @ talk "¿Qué parte de la {i}impronta{/i}no entiendes?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:831
