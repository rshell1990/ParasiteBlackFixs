translate es qst_HumanExp_11_returnFlowers_0d654dec:

    # "Shivers ran down my spine as I realized that she was not kidding."
    "Me recorrió un escalofrío al darme cuenta de que no bromeaba."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:814
translate es qst_HumanExp_11_returnFlowers_6fd4d1c5:

    # MC @ surprised "{i}... Human?{/i}"
    MC @ surprised "{i}...¿Humano?{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:815
translate es qst_HumanExp_11_returnFlowers_60808fed:

    # REGINA @ talk "For conveniences sake at the very least, yes."
    REGINA @ talk "Por conveniencia, como mínimo, sí."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:816
translate es qst_HumanExp_11_returnFlowers_d27c7c2d:

    # REGINA @ talk "Unless you plan to spend all your coin on buying her meat, or forever hunting in woodlands to feed her daily ... Which by the way, could draw unnecessary attention."
    REGINA @ talk "A menos que planees gastar todas tus monedas en comprarle carne, o cazar eternamente en los bosques para alimentarla a diario... Lo que, por cierto, podría llamar la atención innecesariamente."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:817
translate es qst_HumanExp_11_returnFlowers_f3358772:

    # REGINA @ talk "Then she's going to need to hone her natural skills, isn't she?"
    REGINA @ talk "Entonces tendrá que perfeccionar sus habilidades naturales, ¿no?"

