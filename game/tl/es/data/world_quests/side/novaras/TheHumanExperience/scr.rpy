    # MYU "Do they touch each other's butts like you did to mine earlier?"
    MYU "¿Se tocan el culo como hiciste antes con el mío?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:450
translate es qst_HumanExp_6_cityTour_d0029b8a:

    # MYU "{i}Myu liked that a lot.{/i}"
    MYU "{i}A Myu le gustó mucho.{/i}"

