translate es qst_HumanExp_11_returnFlowers_83dd4c14:

    # REGINA @ talk "Is there any real difference in nobility between you killing people and her eating them?"
    REGINA @ talk "¿Hay alguna diferencia real de nobilidad entre que tú mates a la gente y que ella se los coma?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:823
