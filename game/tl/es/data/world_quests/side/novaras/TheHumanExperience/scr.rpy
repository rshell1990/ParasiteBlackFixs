translate es qst_HumanExp_6_cityTour_dbf0e0be:

    # MYU "So, do rich students get jobs they don't like?"
    MYU "Entonces, ¿los estudiantes ricos consiguen trabajos que no les gustan?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:429
translate es qst_HumanExp_6_cityTour_69419140:

    # MC @ think "Uhh, that doesn't really happen."
    MC @ think "Uhh, eso en realidad no pasa."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:430
translate es qst_HumanExp_6_cityTour_092e4223_3:

    # MYU "...Why?"
    MYU "...¿Por qué?"

