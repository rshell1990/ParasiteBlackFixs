

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:3
translate es qst_HumanExp_0_checkup_f17504ab:

    # "Once Myu heard the door open, she ran out to greet me."
    "En cuanto Myu oyó abrirse la puerta, salió corriendo a saludarme."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:5
translate es qst_HumanExp_0_checkup_7ed69a61:

    # MYU @ joy "MYUUUU!"
    MYU @ joy "¡MYUUUU!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:6
translate es qst_HumanExp_0_checkup_6fbafaf2:

    # MC @ smile "Ah! Easy!"
    MC @ smile "¡Ah! ¡Tranquila!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:7
translate es qst_HumanExp_0_checkup_22ac86cc:

    # MC @ smile "You really are quite the excitable thing, aren't you?"
    MC @ smile "Realmente eres muy excitable, ¿no?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:9
translate es qst_HumanExp_0_checkup_7dd1b531:

    # "Her eyes looked pleadingly towards me, and as she looked down to her stomach, she began to rub at it."
    "Sus ojos me miraron suplicantes y, cuando bajó la vista hacia su estómago, empezó a frotárselo."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:10
translate es qst_HumanExp_0_checkup_bc1daff5:

    # MC @ think "...Are you hungry?"
    MC @ think "...¿Tienes hambre?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:11
translate es qst_HumanExp_0_checkup_1655687c:

    # MYU @ sad "Myuuuu."
    MYU @ sad "Myuuuu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:12
translate es qst_HumanExp_0_checkup_15f7a927:

    # MC @ talk "Hmm... Guess that makes sense."
    MC @ talk "Hmm... Supongo que tiene sentido."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:13
translate es qst_HumanExp_0_checkup_52c71ec9:

    # MC @ talk "With all the growing you're doing, you're probably going to need some bigger portions too."
    MC @ talk "Con todo lo que estás creciendo, es probable que también necesites porciones más grandes."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:14
translate es qst_HumanExp_0_checkup_d7b1d9d4:

    # MC "(Fuck... How much more growing is she going to do?)"
    MC "(Joder... ¿Cuánto más va a crecer?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:15
translate es qst_HumanExp_0_checkup_24789a5d:

    # MC "(There's no way I can hide her if she becomes the size of that thing in the lake.)"
    MC "(No hay manera de que pueda esconderla si se vuelve del tamaño de esa cosa en el lago)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:18
translate es qst_HumanExp_0_checkup_38c2a99a:

    # MC "(Good thing I still have some meat on me.)"
    MC "(Menos mal que aún me queda algo de carne)."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:20
translate es qst_HumanExp_0_checkup_0d786271:

    # "As I held out the strips of meat in front of Myu, she snatched them and began to devour them quickly."
    "Mientras ponía los trozos de carne delante de Myu, ella los cogió y empezó a devorarlos rápidamente."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:21
translate es qst_HumanExp_0_checkup_7ed7ce5c:

    # MC @ surprised "Easy! Not so fast!"
    MC @ surprised "¡Tranquila! ¡No tan rápido!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:22
translate es qst_HumanExp_0_checkup_e9d242d0:

    # "I watched as the meat was broken down and dissolved inside of Myu till there was nothing."
    "Vi cómo la carne se deshacía y se disolvía dentro de Myu hasta que no quedó nada."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:25
translate es qst_HumanExp_0_checkup_833a1ba9:

    # MC @ talk "Myu, I need to go get some food, understand?"
    MC @ talk "Myu, necesito ir a buscar comida, ¿entiendes?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:26
translate es qst_HumanExp_0_checkup_79668bcf:

    # "Myu tilted her head curiously."
    "Myu inclinó la cabeza con curiosidad."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:27
translate es qst_HumanExp_0_checkup_1f30d55b:

    # MC @ serious "FOOD."
    MC @ serious "COMIDA."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:28
translate es qst_HumanExp_0_checkup_58f67288:

    # "I began to rub my stomach and then point towards Myu."
    "Empecé a frotarme el estómago y luego señalé hacia Myu."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:29
translate es qst_HumanExp_0_checkup_b1f8a94e:

    # MC @ serious "YOU. STAY. HERE."
    MC @ serious "TÚ. QUEDARTE. AQUÍ."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:30
translate es qst_HumanExp_0_checkup_e3c7807b:

