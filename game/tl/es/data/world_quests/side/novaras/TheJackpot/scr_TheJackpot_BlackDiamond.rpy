    # MR_WINWARD @ angry "Perhaps my wife is happy to settle, live and accept it's all gone."
    MR_WINWARD @ angry "Tal vez mi esposa está feliz de conformarse, vivir y aceptar que todo se ha ido."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:310
translate es qst_jackpot_black_diamond_winward_2_aa59fa72:

    # MR_WINWARD @ angry "But not me! I've worked too hard for it to end like this!"
    MR_WINWARD @ angry "¡Pero yo no! ¡He trabajado demasiado para que termine así!"

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:311
translate es qst_jackpot_black_diamond_winward_2_76468f9d:

    # MR_WINWARD @ angry "{i}I must{/i} keep going till the end!"
    MR_WINWARD @ angry "{i}Debo{/i} seguir hasta el final!"

