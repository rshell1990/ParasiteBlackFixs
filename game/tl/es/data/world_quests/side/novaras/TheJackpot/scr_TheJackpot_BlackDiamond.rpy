    VULSHAN_GUARD "Buena suerte, que los dioses os sonrían..."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:297
translate es qst_jackpot_black_diamond_winward_2_bff7ac97:

    # "As the guard stepped back, we each announced our buy-in and the cards were dealt onto the table in front of each of us."
    "Mientras el guardia retrocedía, cada uno de nosotros anunciaba su aportación y las cartas se repartían en la mesa frente a cada uno de nosotros."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:301
