translate es qst_jackpot_black_diamond_winward_2_78b9c4f4:

    # "Mr Winward handed me over his buy-in, a large bag of coins."
    "El Sr. Winward me entregó su dinero de la entrada, una gran bolsa de monedas."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:274
translate es qst_jackpot_black_diamond_winward_2_818510b3:

    # "Shaking my head, I headed into the private game room."
    "Sacudiendo la cabeza, me dirigí a la sala de juegos privada."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:277
translate es qst_jackpot_black_diamond_winward_2_014c3ab3:

    # "Inside, a few figures sat around a large, ornate table, one or two of which briefly looked up to meet my eyes before looking away once more."
    "Dentro, unas cuantas figuras sentadas alrededor de una mesa grande y adornada, una o dos de las cuales levantaron brevemente la vista para verme antes de volver a apartarla."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:278
translate es qst_jackpot_black_diamond_winward_2_0ea38733:

    # "I didn't recognise anyone in the room, but from the silk fabric of many of their gowns and ornate jewelry they wore, they were either rich merchants or possibly some may have even been low lords."
    "No reconocí a nadie en la sala, pero por la tela de seda de muchos de sus vestidos y las joyas ornamentadas que llevaban, o bien eran ricos mercaderes o, posiblemente, algunos incluso podían haber sido señores de bajo rango."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:279
translate es qst_jackpot_black_diamond_winward_2_efeeb221:

    # "The same, scantily clad women served and poured their drinks, and around the room, silent, but ever present, the guards waited and watched."
    "Las mismas mujeres, escasamente vestidas, servían sus bebidas, y alrededor de la sala, silenciosos, pero siempre presentes, los guardias esperaban y observaban."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:280
translate es qst_jackpot_black_diamond_winward_2_90546219:

    # "One of the guards approached, his dialect unusually crisp clear Alderian for a Ramonian."
    "Uno de los guardias se acercó, con un dialecto alderiano inusualmente claro para un ramoniano."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:280
translate es qst_jackpot_black_diamond_winward_2_86baaf28:

    # VULSHAN_GUARD "Gentlemen ... The game for today is..."
    VULSHAN_GUARD "Caballeros... El juego de hoy es..."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:281
translate es qst_jackpot_black_diamond_winward_2_599ed3ef:

