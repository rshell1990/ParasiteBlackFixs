    MC "(Supongo que es mejor que nada)."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:290
translate es qst_jackpot_black_diamond_winward_2_785dca81:

    # "Taking a seat at the table, each of the members placed their buy-ins onto silver trays that were taken away."
    "Tomando asiento en la mesa, cada uno de los miembros depositó sus aportaciones en bandejas de plata que fueron retiradas."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:291
translate es qst_jackpot_black_diamond_winward_2_48579845:

    # "After a brief, quick period of the coin being counted, there was a nod from one guard to the next."
    "Tras un breve y rápido recuento de las monedas, un guardia asintió con la cabeza."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:291
translate es qst_jackpot_black_diamond_winward_2_2284d9b0:

    # VULSHAN_GUARD "Now that everyone's initial bet is in, The first hand shall be dealt."
    VULSHAN_GUARD "Ahora que todos han hecho su apuesta inicial, se repartirá la primera mano."

# game/data/world_quests/side/novaras/TheJackpot/scr_TheJackpot_BlackDiamond.rpy:292
translate es qst_jackpot_black_diamond_winward_2_85b9f42d:

