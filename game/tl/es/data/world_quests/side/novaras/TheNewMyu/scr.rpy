    # KYLISA @ sad "Ah..."
    KYLISA @ sad "Ah..."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:224
translate es qst_NewMyu_4_findMyuChurch_5c9466f6:

    # KYLISA @ talk "Your {i}friend{/i} said you would look for her."
    KYLISA @ talk "Tu {i}amiga{/i} dijo que la buscarías.."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:225
translate es qst_NewMyu_4_findMyuChurch_d47da673:

    # MC @ sad "What is Myu doing in there?"
    MC @ sad "¿Qué está haciendo Myu ahí?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:226
translate es qst_NewMyu_4_findMyuChurch_cbf62435:

    # KYLISA @ sad "I found the poor thing sobbing in the pews telling me she was a monster over and over again."
    KYLISA @ sad "Encontré a la pobre sollozando en los bancos diciéndome una y otra vez que era un monstruo."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:227
translate es qst_NewMyu_4_findMyuChurch_e71bf7fc:

    # KYLISA @ sad "So, I canceled the services for today."
    KYLISA @ sad "Así que, cancelé los servicios para hoy."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:232
translate es qst_NewMyu_4_findMyuChurch_menu_d512b3b1:

    # KYLISA @ angry "Because some of us can still remember when times were better and we fought back against the over-reach of the inquisitors."
    KYLISA @ angry "Porque algunos de nosotros aún podemos recordar cuando los tiempos eran mejores y luchábamos contra la extralimitación de los inquisidores."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:233
translate es qst_NewMyu_4_findMyuChurch_menu_de7ef835:

    # KYLISA @ talk "The inquisitors destroy whatever they fear, but there was a time we strived to understand different races."
    KYLISA @ talk "Los inquisidores destruyen lo que temen, pero hubo un tiempo en que nos esforzábamos por comprender a las distintas razas."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:234
translate es qst_NewMyu_4_findMyuChurch_menu_e90b93c7:

    # KYLISA @ talk "I must admit, I was a little taken aback at first by a slimelark, but our faith is not one to turn away the weary, whoever or whatever they may be."
    KYLISA @ talk "Debo admitir que al principio me sorprendió un poco que se tratara de una slimelark, pero nuestra fe no es de las que rechazan a los cansados, sean quienes sean o sean lo que sean."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:237
translate es qst_NewMyu_4_findMyuChurch_menu_d72d0c11:

    # KYLISA @ talk "Of course, but be gentle with her."
    KYLISA @ talk "Por supuesto, pero sé amable con ella."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:238
translate es qst_NewMyu_4_findMyuChurch_menu_17fcf1b7:

    # KYLISA @ talk "She's quite... fragile."
    KYLISA @ talk "Es bastante... frágil."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:249
translate es qst_NewMyu_4_findMyuChurch_menu_0fae614a:

    # "When I entered the Church, Myu continued to cry softly, and when she saw me she stood up and slowly approached anxiously."
    "Cuando entré en la iglesia, Myu seguía llorando suavemente y, al verme, se levantó y se acercó lentamente, ansiosa."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:251
translate es qst_NewMyu_4_findMyuChurch_menu_fad080da:

    # MYU @ sad "...Myu feels like such a fool."
    MYU @ sad "...Myu se siente como una tonta."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:252
translate es qst_NewMyu_4_findMyuChurch_menu_56282f41:

    # MC @ sad "Myu, what happened back there?"
    MC @ sad "Myu, ¿qué pasó allí?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:228
translate es qst_NewMyu_4_findMyuChurch_menu_bd7c742b:

    # MC @ talk "Why were you feeding on someone in your room?"
    MC @ talk "¿Por qué te estabas alimentando de alguien en tu habitación?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:254
translate es qst_NewMyu_4_findMyuChurch_menu_ff5f2a2b:

    # MC @ talk "Why didn't you just tell me you wanted to hunt?"
    MC @ talk "¿Por qué no me dijiste que querías cazar?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:255
translate es qst_NewMyu_4_findMyuChurch_menu_047dff7d:

    # "Myu fumbled on her words, struggling to get out what she wanted to say."
    "Myu balbuceó sus palabras, luchando por sacar lo que quería decir."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:256
translate es qst_NewMyu_4_findMyuChurch_menu_9e1d8414:

    # MYU @ sad "{i}...Myu wanted to show you she could be normal.{/i}"
    MYU @ sad "{i}...Myu quería demostrarte que podía ser normal.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:257
translate es qst_NewMyu_4_findMyuChurch_menu_dcfad6aa:

    # MYU @ sad "{i}Myu wanted to prove she wasn't a monster...{/i}"
    MYU @ sad "{i}Myu quería demostrar que no era un monstruo...{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:258
translate es qst_NewMyu_4_findMyuChurch_menu_a6bd4ad4:

    # MYU @ sad "So Myu tried eating like everyone else."
    MYU @ sad "Así que Myu intentó comer como todo el mundo."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:259
translate es qst_NewMyu_4_findMyuChurch_menu_7564ec5b:

    # MYU @ sad "But it just kept making Myu more and more sick."
    MYU @ sad "Pero Myu estaba cada vez más enferma."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:260
translate es qst_NewMyu_4_findMyuChurch_menu_87e50561:

    # MYU sad "Till Myu was soooo hungry."
    MYU sad "Hasta que Myu estaba taaaan hambrienta."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:261
translate es qst_NewMyu_4_findMyuChurch_menu_0a99c764:

    # MYU @ sad "Myu couldn't stop herself anymore... All Myu could think about was food."
    MYU @ sad "Myu ya no podía contenerse... Myu solo podía pensar en comida."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:262
translate es qst_NewMyu_4_findMyuChurch_menu_542b671d:

    # MYU @ sad "Myu saw the way you looked at her last time, Myu so... {i}dirty.{/i}"
    MYU @ sad "Myu vio la forma en que la miraste la última vez, Myu tan... {i}sucio.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:263
translate es qst_NewMyu_4_findMyuChurch_menu_4077d558:

    # MYU @ sad "Myu didn't want you to feel dirty again, no matter how hungry she got."
    MYU @ sad "Myu no quería que volvieras a sentirte sucio, por mucha hambre que tuviera."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:264
translate es qst_NewMyu_4_findMyuChurch_menu_275e2d28:

    # MYU @ sad "So, Myu hunted alone, wanted to hide it from you so you wouldn't see Myu like that again."
    MYU @ sad "Entonces, Myu cazó sola, quería ocultártelo para que no volvieras a ver a Myu así."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:265
translate es qst_NewMyu_4_findMyuChurch_menu_3040230e:

    # "Myu began to sob."
    "Myu empezó a sollozar."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:266
translate es qst_NewMyu_4_findMyuChurch_menu_b40b56f3:

    # MC @ sad "...Oh, Myu."
    MC @ sad "...Oh, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:267
translate es qst_NewMyu_4_findMyuChurch_menu_d9dfd88f:

    # "I gently wiped away one of her tears."
    "Le sequé suavemente una de sus lágrimas."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:268
translate es qst_NewMyu_4_findMyuChurch_menu_9d7e2515:

    # MC @ sad "Listen to me, Myu."
    MC @ sad "Escúchame, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:269
translate es qst_NewMyu_4_findMyuChurch_menu_ef65510d:

    # MC @ think "Everyone has... {i}darkness{/i} inside of them."
    MC @ think "Todo el mundo tiene... {i}oscuridad{/i} en su interior."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:270
translate es qst_NewMyu_4_findMyuChurch_menu_9e6aecb3:

    # MC @ talk "And sometimes, that darkness can be a little scary."
    MC @ talk "Y a veces, esa oscuridad puede dar un poco de miedo."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:271
translate es qst_NewMyu_4_findMyuChurch_menu_2634160e:

    # MC @ serious "But you're not defined by what you are, but {i}who{/i} you are."
    MC @ serious "Pero no te define lo que eres, sino {i}quién{/i} eres."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:247
translate es qst_NewMyu_4_findMyuChurch_menu_43cccb6a:

    # MYU @ sad "...Is [player_name!t] scared of Myu?"
    MYU @ sad "...¿[player_name!t] le tiene miedo a Myu?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:273
translate es qst_NewMyu_4_findMyuChurch_menu_667c4a7d:

    # MC @ talk "...No, Myu."
    MC @ talk "...No, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:274
translate es qst_NewMyu_4_findMyuChurch_menu_5feaf410:

    # MYU @ sad "W-Why?"
    MYU @ sad "¿P-por qué?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:275
translate es qst_NewMyu_4_findMyuChurch_menu_44cf84ff:

    # MYU @ sad "{i}You said Myu was a monster.{/i}"
    MYU @ sad "{i}Dijiste que Myu era un monstruo.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:276
translate es qst_NewMyu_4_findMyuChurch_menu_b62129ee:

    # MYU @ sad "Monsters are bad, monsters are the worst..."
    MYU @ sad "Los monstruos son malos, los monstruos son lo peor..."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:277
translate es qst_NewMyu_4_findMyuChurch_menu_916c466a:

    # MC @ talk "You're not a monster Myu... You're just a scared girl trying to understand a scary world."
    MC @ talk "No eres un monstruo Myu... Solo eres una chica asustada tratando de entender un mundo aterrador."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:278
translate es qst_NewMyu_4_findMyuChurch_menu_0ea19dfc:

    # MC @ talk "I'm sorry I made you feel the way you did, and truth is, you {i}did{/i} scare me a little."
    MC @ talk "Siento haberte hecho sentir como lo hiciste, y la verdad es que {i}me{/i} asustaste un poco."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:279
translate es qst_NewMyu_4_findMyuChurch_menu_d5d364dc:

    # "Myu's eyes dropped to the floor dejectedly."
    "Los ojos de Myu cayeron al suelo abatidos."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:280
translate es qst_NewMyu_4_findMyuChurch_menu_8b40679b:

    # MC @ talk "But... That's okay."
    MC @ talk "Pero... No pasa nada."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:281
translate es qst_NewMyu_4_findMyuChurch_menu_01cd8043:

    # MC @ smile "{i}Because I guess I'm kinda scary too sometimes.{/i}"
    MC @ smile "{i}Porque supongo que a veces yo también doy un poco de miedo.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:282
translate es qst_NewMyu_4_findMyuChurch_menu_3443b8a7:

    # MC @ smile "And just because you're a little different, it doesn't make you a monster."
    MC @ smile "Y solo porque seas un poco diferente, no te convierte en un monstruo."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:283
translate es qst_NewMyu_4_findMyuChurch_menu_bb741f1e:

    # MYU "..."
    MYU "..."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:288
translate es qst_NewMyu_4_findMyuChurch_menu_51e28bb2:

    # "Myu leapt forward to hug me."
    "Myu saltó para abrazarme."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:289
translate es qst_NewMyu_4_findMyuChurch_menu_6dca0e04:

    # MC "Whoa, easy now!"
    MC "¡Whoa, tranquila!"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:290
translate es qst_NewMyu_4_findMyuChurch_menu_587718cb:

    # MYU "{i}*Sniff*{/i} Myu is ready to go home now."
    MYU "{i}*Snif*{/i} Myu ya está lista para irse a casa."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:291
translate es qst_NewMyu_4_findMyuChurch_menu_75df1b81:

    # MC "Come then, Myu, let's get you home."
    MC "Ven, Myu, vamos a casa."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:293
translate es qst_NewMyu_4_findMyuChurch_menu_397c7208:

    # KYLISA @ talk "I take it all is resolved?"
    KYLISA @ talk "¿Supongo que todo está resuelto?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:298
translate es qst_NewMyu_4_findMyuChurch_menu_d07dee5f:

    # MC @ smile "I think so."
    MC @ smile "Eso creo."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:299
translate es qst_NewMyu_4_findMyuChurch_menu_1918d395:

    # KYLISA @ smile "Good."
    KYLISA @ smile "Bien."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:300
translate es qst_NewMyu_4_findMyuChurch_menu_1ae85692:

    # MC @ talk "Thank you for helping her."
    MC @ talk "Gracias por ayudarla."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:301
translate es qst_NewMyu_4_findMyuChurch_menu_5c7b44a3:

    # MC @ talk "I know many wouldn't."
    MC @ talk "Sé que muchos no lo harían."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:302
translate es qst_NewMyu_4_findMyuChurch_menu_15eff0cd:

    # KYLISA @ talk "I am sure one day in the future, you may return this act of kindness."
    KYLISA @ talk "Estoy convencida de que algún día, en el futuro, podrás devolverme este acto de bondad."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:303
translate es qst_NewMyu_4_findMyuChurch_menu_1fd3c380:

    # KYLISA @ talk "...Tell me something though."
    KYLISA @ talk "...Pero dime una cosa."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:304
translate es qst_NewMyu_4_findMyuChurch_menu_d669e126:

    # KYLISA @ talk "Why are {i}you{/i} helping this slimelark?"
    KYLISA @ talk "¿Por qué {i}tú{/i} estás ayudando a este slimelark?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:307
translate es qst_NewMyu_4_findMyuChurch_menu_6824b63e:

    # KYLISA @ talk "...Very well, as good an answer as any I suppose."
    KYLISA @ talk "...Muy bien, supongo que una respuesta tan buena como cualquier otra."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:309
translate es qst_NewMyu_4_findMyuChurch_menu_54991cbc:

    # KYLISA @ talk "...I see."
    KYLISA @ talk "...Ya veo."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:310
translate es qst_NewMyu_4_findMyuChurch_menu_f9a7a2d5:

    # KYLISA @ talk "Well I hope you and your companion chose wisely in this war and the wars to come."
    KYLISA @ talk "Espero que tú y tu compañera hayáis elegido sabiamente en esta guerra y en las guerras venideras."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:312
translate es qst_NewMyu_4_findMyuChurch_menu_f0530664:

    # "...The phrase jumped out of me in a tone so... {i}alien{/i}."
    "...La frase me saltó en un tono tan... {i}extraño{/i}."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:313
translate es qst_NewMyu_4_findMyuChurch_menu_277775a1:

    # KYLISA @ blush "I... Right, well, as long as {i}she's{/i} happy with that as well I suppose."
    KYLISA @ blush "Yo... Bien, bueno, siempre y cuando {i}ella{/i} esté feliz con eso también, supongo."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:314
translate es qst_NewMyu_4_findMyuChurch_menu_d87ee605:

    # KYLISA @ talk "Perhaps you might want to consider leaving Novaras if that's your long term-plan with her."
    KYLISA @ talk "Quizás quieras considerar dejar Novaras si ese es tu plan a largo plazo con ella."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:315
translate es qst_NewMyu_4_findMyuChurch_menu_3f3c80c2:

    # KYLISA @ talk "The inquisition have punished many... With child or not."
    KYLISA @ talk "La Inquisición ha castigado a muchos... con hijos o no."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:316
translate es qst_NewMyu_4_findMyuChurch_menu_843d3cc8:

    # KYLISA @ talk "Anyway, you two should leave now, before someone else comes inquiring."
    KYLISA @ talk "De todos modos, deberíais iros ya, antes de que venga alguien más a preguntar."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:317
translate es qst_NewMyu_4_findMyuChurch_menu_6fd3619a:

    # MC @ talk "Thank you, Kylisa."
    MC @ talk "Gracias, Kylisa."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:319
translate es qst_NewMyu_4_findMyuChurch_menu_e2cf7747:

    # "After that, the two of us slipped away back home safely."
    "Después de eso, los dos nos escabullimos de vuelta a casa sanos y salvos."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:328
translate es qst_NewMyu_4_findMyuChurch_menu_a00b8bf6:

    # MYU @ talk "Myu tired, can... can we talk more soon?"
    MYU @ talk "Myu cansada, ¿podemos... podemos hablar más pronto?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:329
translate es qst_NewMyu_4_findMyuChurch_menu_b7078ada:

    # MC @ talk "Of course, Myu."
    MC @ talk "Por supuesto, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:332
translate es qst_NewMyu_4_findMyuChurch_menu_7d6bdbfd:

    # "Before she dissolved, Myu turned to face me once more."
    "Antes de disolverse, Myu se giró de nuevo hacia mí."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:309
translate es qst_NewMyu_4_findMyuChurch_menu_e0576a98:

    # MYU @ talk "Do... [player_name!t] not want to be Myu husband?"
    MYU @ talk "¿... [player_name!t] no quiere ser el esposo de Myu?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:334
translate es qst_NewMyu_4_findMyuChurch_menu_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "¿Qué?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:335
translate es qst_NewMyu_4_findMyuChurch_menu_6d33c1a7:

    # MYU @ sad "Myu... Understand now, things not as she thought."
    MYU @ sad "Myu... Entiende ahora, las cosas no son como ella pensaba."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:312
translate es qst_NewMyu_4_findMyuChurch_menu_fa435c59:

    # MYU @ sad "Even though Myu wants [player_name!t], not fair to force someone to love who doesn't love back."
    MYU @ sad "Aunque Myu quiera a [player_name!t], no es justo obligar a alguien a querer a quien no le corresponde."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:313
translate es qst_NewMyu_4_findMyuChurch_menu_8bcea43e:

    # MYU @ sad "So, what does [player_name!t] want?"
    MYU @ sad "Entonces, ¿qué quiere [player_name!t]?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:343
translate es qst_NewMyu_4_findMyuChurch_menu_9fdc3e39:

    # MYU @ sad "Myu... Myu understand."
    MYU @ sad "Myu... Myu entender."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:344
translate es qst_NewMyu_4_findMyuChurch_menu_31ceb390:

    # MYU @ sad "Myu is sorry for trying to force what cannot be."
    MYU @ sad "Myu lamenta haber intentado forzar lo que no puede ser."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:345
translate es qst_NewMyu_4_findMyuChurch_menu_c2a891a5:

    # MC @ talk "I will still keep you safe and look after you Myu, I promise."
    MC @ talk "Aún así te mantendré a salvo y cuidaré de ti Myu, lo promete."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:346
translate es qst_NewMyu_4_findMyuChurch_menu_a1015a7d:

    # MC @ talk "I just can't be what you {i}want{/i} me to be."
    MC @ talk "No puedo ser lo que tú {i}quieres{/i} que sea."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:347
translate es qst_NewMyu_4_findMyuChurch_menu_2a791db4:

    # MYU @ sad "...Very well, Myu will help when she can."
    MYU @ sad "...Muy bien, Myu ayudará cuando pueda."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:348
translate es qst_NewMyu_4_findMyuChurch_menu_59807ae7:

    # MYU @ smile "And maybe, along the way, Myu will find someone who {i}does{/i} want her that way."
    MYU @ smile "Y quizá, por el camino, Myu encuentre a alguien que {i}sí{/i} la quiera así."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:349
translate es qst_NewMyu_4_findMyuChurch_menu_e2d535af:

    # MC @ talk "Maybe Myu, maybe."
    MC @ talk "Tal vez Myu, tal vez."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:350
translate es qst_NewMyu_4_findMyuChurch_menu_4c680e03:

    # MC "(I hope I have made the right choice with this.)"
    MC "(Espero haber tomado la decisión correcta con esto)."

translate es strings:

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:13
    old "I'd be eternally grateful if you could sell me that wine a little cheaper."
    new "Te estaría eternamente agradecido si pudieras venderme ese vino un poco más barato."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:14
    old "Here you go."
    new "Aquí tienes."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:14
    old "I'll be back."
    new "Volveré."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:195
    old "Knock on the door"
    new "Llamar a la puerta"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:195
    old "Step away from the Church"
    new "Alejarse de la iglesia"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:229
    old "Why did you help Myu?"
    new "¿Por qué ayudaste a Myu?"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:229
    old "May I enter to see her?"
    new "¿Puedo entrar a verla?"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:305
    old "I guess because it's the right thing to do?"
    new "¿Supongo que porque es lo correcto?"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:305
    old "She is my companion."
    new "Es mi compañera."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:305
    old "{i}I intend to breed her well, she shall sire me great warriors.{/i}"
    new "{i}Tengo la intención de hacerla criar, ella me engendrará grandes guerreros.{/i}"

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:338
    old "{image=[ICON.HEART]} You're mine, Myu."
    new "{image=[ICON.HEART]} Eres mía, Myu."

    # game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:338
    old "{image=[ICON.HEART_CROSS]} Myu, I think it's best we just stay friends."
    new "{image=[ICON.HEART_CROSS]} Myu, creo que es mejor que sigamos siendo amigos."
