# game/data/world_quests/side/novaras/TheRavenousJelly/scr.rpy:29
translate es qst_ravenJelly_inspectSlime_96c1279a:

    # "It looked towards me once again, waiting for food."
    "Miró hacia mí una vez más, esperando comida."

# game/data/world_quests/side/novaras/TheRavenousJelly/scr.rpy:33
translate es qst_ravenJelly_inspectSlime_menu_2eb8612c:

