# game/data/world_quests/side/novaras/TheRavenousJelly/scr.rpy:26
translate es qst_ravenJelly_inspectSlime_4a4dcba4:

    # "The slime was noticeably larger than before, and once it noticed me, it waited expectantly for another feeding."
