

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:4
translate es qsttheslavemaster_intro_ed55590b:

    # "As I made my way out through the city gates, I heard a voice calling behind me."
    "Mientras salía por las puertas de la ciudad, oí una voz que me llamaba."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:5
translate es qsttheslavemaster_intro_def3145f:

    # UNKNOWN "Wait! STOPPPP!"
    UNKNOWN "¡Espera! ¡PARAAAA!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:9
translate es qsttheslavemaster_intro_5d48b0bd:

    # "Behind me, a young boy, huffing and panting, sprinted up and handed me a sealed letter."
    "Detrás de mí, un chico joven, resoplando y jadeando, se acercó corriendo y me entregó una carta sellada."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:11
translate es qsttheslavemaster_intro_6394fbb0:

    # UNKNOWN "{i}*Huff!*{/i} An urgent letter for you mi'lord from Captain Nyx!"
    UNKNOWN "{i}*¡Uff!*{/i} ¡Una carta urgente para usted mi señor de la capitana Nyx!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:12
translate es qsttheslavemaster_intro_09b56699:

    # MC @ talk "Captain Nyx? Did she say what this was about?"
    MC @ talk "¿Capitana Nyx? ¿Dijo de qué se trataba?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:13
translate es qsttheslavemaster_intro_a2c653f8:

    # UNKNOWN "No mi'lord! But she said you must read it at once!"
    UNKNOWN "¡No mi señor! ¡Pero ella dijo que debe leerlo de inmediato!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:14
translate es qsttheslavemaster_intro_f2d783ef:

    # MC @ talk "How did you know where to-"
    MC @ talk "¿Cómo sabías dónde-"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:19
translate es qsttheslavemaster_intro_67ca6e19:

    # "The boy was already hurrying off once again before I could even finish my sentence, sprinting back towards the gate, and soon, he was gone entirely from my line of sight."
    "Antes de que pudiera terminar la frase, el chico ya se había marchado corriendo hacia la puerta, y pronto desapareció por completo de mi campo de visión."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:20
translate es qsttheslavemaster_intro_a26e1014:

    # "I tore open the letter and read its contents inside."
    "Abrí la carta y leí su contenido."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:19
translate es qsttheslavemaster_intro_201ed5f8:

    # "{i} [player_name!t], please come at once to see me ...{/i}"
    "{i} [player_name!t], por favor, ven de inmediato a verme...{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:23
translate es qsttheslavemaster_intro_cbb5587c:

    # "{i}I need to call upon your services once again.{/i}"
    "{i}Necesito recurrir a tus servicios una vez más.{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:24
translate es qsttheslavemaster_intro_d2dd0882:

    # "{i}Captain Nyx{/i}"
    "{i}Capitana Nyx{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:29
translate es qsttheslavemaster_intro_a54258cb:

    # MC "(I should head over there once I have some time, see what she wants.)"
    MC "(Debería ir allí cuando tenga algo de tiempo, a ver qué quiere.)"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:44
translate es qsttheslavemaster_pitch_2224139c:

    # NYX @ talk "Ah, there you are."
    NYX @ talk "Ah, ahí estás."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:45
translate es qsttheslavemaster_pitch_0a23a13b:

    # NYX @ talk "Just the person I've been looking for."
    NYX @ talk "Justo la persona que estaba buscando."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:46
translate es qsttheslavemaster_pitch_756e61c9:

    # MC @ think "What's this about?"
    MC @ think "¿De qué va esto?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:47
translate es qsttheslavemaster_pitch_29d937a5:

    # NYX @ talk "Not long ago, we received word of a notorious slave master who we {i}think{/i} has arrived in Novaras."
    NYX @ talk "No hace mucho, recibimos noticias de un notorio esclavista que {i}creemos{/i} ha llegado a Novaras."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:48
translate es qsttheslavemaster_pitch_8efb590f:

    # NYX @ angry "They call him 'Angharad of a thousand chains.'"
    NYX @ angry "Le llaman 'Angharad de las mil cadenas.'"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:49
translate es qsttheslavemaster_pitch_a7e01fe2:

    # NYX @ talk "From what we've gathered, Angharad's been investing a lot of time and resources in the power struggle going on between the gangs in the city right now, and has struck some type of deal with the Khazahs."
    NYX @ talk "Por lo que hemos averiguado, Angharad ha estado invirtiendo mucho tiempo y recursos en la lucha de poder que se está librando entre las bandas de la ciudad en estos momentos, y ha llegado a algún tipo de acuerdo con los khazahs."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:50
translate es qsttheslavemaster_pitch_96b86ea7:

    # NYX @ talk "We believe he's been supplying them with additional weapons, drugs, and armour in return for being the only slave master they consult with."
    NYX @ talk "Creemos que les ha estado suministrando armas, drogas y armaduras adicionales a cambio de ser el único esclavista con el que consultan."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:51
translate es qsttheslavemaster_pitch_b8ea4e4b:

    # MC @ think "I see... And where do I fit into all this?"
    MC @ think "Ya veo... ¿Y dónde encajo yo en todo esto?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:52
translate es qsttheslavemaster_pitch_2fed62ec:

    # NYX @ angry "We've managed to convince Angharad to attend what he believes is a business meeting with another high-profile slaver interested in working with him."
    NYX @ angry "Hemos conseguido convencer a Angharad para que asista a lo que él cree que es una reunión de negocios con otro esclavista de alto nivel interesado en trabajar con él."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:53
translate es qsttheslavemaster_pitch_55bd058f:

    # NYX @ talk "The plan is simple ... One of our men pretends to be the other slave master, goes in, finds proof it's definately Angharad at the meeting and not one of his men sent on his behalf,"
    NYX @ talk "El plan es simple... Uno de nuestros hombres se hace pasar por el otro esclavista, entra, encuentra pruebas de que es definitivamente Angharad en la reunión y no uno de sus hombres enviados en su nombre."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:54
translate es qsttheslavemaster_pitch_0a8956f7:

    # NYX @ talk "And once Angharad is confirmed to be present and agrees to the deal, the other city guards on standby will swarm the place and seize him."
    NYX @ talk "Y una vez que se confirme que Angharad está presente y acepte el trato, los otros guardias de la ciudad que están a la espera rodearán el lugar y lo capturarán."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:55
translate es qsttheslavemaster_pitch_8eb76fb4:

    # MC @ talk "I take it this is where I come in?"
    MC @ talk "¿Supongo que aquí es donde entro yo?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:56
translate es qsttheslavemaster_pitch_ab17c8ac:

    # NYX @ talk "Well, aren't you clever?"
    NYX @ talk "Vaya, qué listo eres."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:57
translate es qsttheslavemaster_pitch_1dd21de2:

    # NYX @ talk "As you know, I'm stretched thin on manpower as it is, but to make matters worse, Angharad's done his research and knows who many of my men are."
    NYX @ talk "Como sabes, no tengo suficiente personal, pero para empeorar las cosas, Angharad ha investigado y sabe quiénes son muchos de mis hombres."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:58
translate es qsttheslavemaster_pitch_0e67101c:

    # NYX @ talk "I need a fresh face to go in and pretend to be the other slave master to negotiate with him."
    NYX @ talk "Necesito una cara nueva que vaya y se haga pasar por el otro esclavista para negociar con él."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:59
translate es qsttheslavemaster_pitch_3635700b:

    # NYX @ talk "Are we clear?"
    NYX @ talk "¿Está claro?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:63
translate es qsttheslavemaster_pitch_menu_426d1e67:

    # NYX @ talk "I'll walk you through everything as best as I can, just push the thought of 'people' to the back of your mind and remember it's {i}product{/i} you're discussing."
    NYX @ talk "Te lo explicaré todo lo mejor que pueda, pero olvídate de pensar en 'personas' y recuerda que estás hablando de {i}productos{/i}."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:64
translate es qsttheslavemaster_pitch_menu_ab611a5e:

    # NYX @ talk "Assisting you will be one of my very best pretending to be a slave concubine of yours."
    NYX @ talk "Asistiéndote estará una de mis mejores fingiendo ser una esclava concubina tuya."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:70
translate es qsttheslavemaster_pitch_menu_94a5723b:

    # NYX @ angry "We need to confirm it's really him."
    NYX @ angry "Tenemos que confirmar que es realmente él."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:71
translate es qsttheslavemaster_pitch_menu_811f98c6:

    # NYX @ talk "In the past, he's sent others impersonating him to handle negotiations."
    NYX @ talk "En el pasado, ha enviado a otros haciéndose pasar por él para gestionar las negociaciones."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:72
translate es qsttheslavemaster_pitch_menu_0a4a920a:

    # NYX @ angry "We can't let him slip away, no matter what."
    NYX @ angry "No podemos dejar que se nos escape, pase lo que pase."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:73
translate es qsttheslavemaster_pitch_menu_6817b429:

    # MC @ talk "And how will I be able to {i}'prove'{/i} it's really him?"
    MC @ talk "¿Y cómo podré {i}'demostrar'{/i} que es realmente él?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:74
translate es qsttheslavemaster_pitch_menu_6363e661:

    # NYX @ sad "That's the tricky part ... But we'll have to find it."
    NYX @ sad "Esa es la parte difícil... Pero tendremos que encontrarlo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:75
translate es qsttheslavemaster_pitch_menu_61767dca:

    # NYX @ talk "If we arrest one his men acting on his behalf, Angharad will only hide himself further underground."
    NYX @ talk "Si arrestamos a uno de sus hombres actuando en su nombre, Angharad solo se esconderá más bajo tierra."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:78
translate es qsttheslavemaster_pitch_menu_3d8f1a37:

    # NYX @ talk "Any other questions?"
    NYX @ talk "¿Alguna otra pregunta?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:81
translate es qsttheslavemaster_pitch_menu_f2a55cd8:

    # NYX @ angry "Angharad is no ordinary slave master, he's destabilised whole regions before."
    NYX @ angry "Angharad no es un esclavista cualquiera, ya ha desestabilizado regiones enteras."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:82
translate es qsttheslavemaster_pitch_menu_6970770f:

    # NYX @ talk "If we capture him alive, we can use his connections to weed out dozens if not hundreds of criminals in the city."
    NYX @ talk "Si lo capturamos vivo, podremos utilizar sus conexiones para eliminar a docenas, si no cientos, de delincuentes de la ciudad."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:83
translate es qsttheslavemaster_pitch_menu_935cb587:

    # NYX @ angry "But, if he entrenches himself here before we can do that, we'll never be able to uproot him."
    NYX @ angry "Pero, si se atrinchera aquí antes de que podamos hacerlo, nunca podremos erradicarlo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:89
translate es qsttheslavemaster_pitch_menu_5617f1f3:

    # NYX @ talk "So then, can I count on you with this?"
    NYX @ talk "Entonces, ¿puedo contar contigo para esto?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:93
translate es qsttheslavemaster_pitch_menu_219c9373:

    # NYX @ laugh "My undying gratitude?"
    NYX @ laugh "¿Mi gratitud eterna?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:94
translate es qsttheslavemaster_pitch_menu_b212ba9d:

    # MC @ talk "Nice try."
    MC @ talk "Buen intento."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:95
translate es qsttheslavemaster_pitch_menu_a53116a5:

    # NYX @ angry "Fine, what do you want?"
    NYX @ angry "Bien, ¿qué quieres?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:98
translate es qsttheslavemaster_pitch_menu_3270b237:

    # NYX @ talk "Fine, how does six hundred sound?"
    NYX @ talk "Bien, ¿qué te parecen seiscientas?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:103
translate es qsttheslavemaster_pitch_menu_95795d08:

    # NYX @ talk "Fine ... Seven-fifty and not a coin more."
    NYX @ talk "Bien... Setecientas cincuenta y ni una moneda más."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:111
translate es qsttheslavemaster_pitch_menu_675f81f3:

    # NYX @ shock "Equipment?"
    NYX @ shock "¿Equipamiento?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:112
translate es qsttheslavemaster_pitch_menu_43854ff0:

    # NYX @ talk "Well ... I could give you some health potions, and, while I can't give you any armour and weapons,"
    NYX @ talk "Bueno... Podría darte algunas pociones de salud, y, aunque no puedo darte armaduras y armas."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:113
translate es qsttheslavemaster_pitch_menu_99899405:

    # NYX @ talk "I can give you this amulet that offers some protection."
    NYX @ talk "Puedo darte este amuleto que ofrece cierta protección."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:116
translate es qsttheslavemaster_pitch_menu_fd5c4a81:

    # NYX @ laugh "Excellent."
    NYX @ laugh "Excelente."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:134
translate es qsttheslavemaster_pitch_menu_b5146dc2:

    # NYX @ disg "You ... you what?!"
    NYX @ disg "¿Tú... tú qué?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:135
translate es qsttheslavemaster_pitch_menu_c3ccfe27:

    # NYX @ angry "Be serious!"
    NYX @ angry "¡Habla en serio!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:138
translate es qsttheslavemaster_pitch_menu_9d4d3b62:

    # NYX @ angry "Ask me that again and I'll cut your balls off!"
    NYX @ angry "¡Pregúntame eso otra vez y te cortaré las pelotas!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:142
translate es qsttheslavemaster_pitch_menu_a1946fb6:

    # NYX @ arrogant "It ... It doesn't even make any sense asking for my panties!"
    NYX @ arrogant "No... ¡Ni siquiera tiene sentido pedirme las bragas!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:143
translate es qsttheslavemaster_pitch_menu_c8668323:

    # NYX @ arrogant "What benefit are they to you?"
    NYX @ arrogant "¿En qué te benefician?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:145
translate es qsttheslavemaster_pitch_menu_fef62dd5:

    # MC @ lewd "Doesn't it make even less sense to deny me?"
    MC @ lewd "¿No tiene aún menos sentido negármelo?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:147
translate es qsttheslavemaster_pitch_menu_1fc525bf:

    # NYX @ disg "W-What are you talking about?"
    NYX @ disg "¿D-de qué estás hablando?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:148
translate es qsttheslavemaster_pitch_menu_3b140a9a:

    # MC @ lewd "Rather than waste precious resources, all I ask for are the panties you're wearing."
    MC @ lewd "En lugar de malgastar recursos preciosos, lo único que pido son las bragas que llevas puestas."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:149
translate es qsttheslavemaster_pitch_menu_55b415c4:

    # MC @ lewd "What better deal could you get than that?"
    MC @ lewd "¿Qué mejor trato que ese?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:151
translate es qsttheslavemaster_pitch_menu_68f36c38:

    # NYX @ arrogant "... F-Fine."
    NYX @ arrogant "... B-bien."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:152
translate es qsttheslavemaster_pitch_menu_3cc6f07a:

    # NYX @ arrogant "But this degradation will not be forgotten!"
    NYX @ arrogant "¡Pero esta degradación no será olvidada!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:153
translate es qsttheslavemaster_pitch_menu_f944af57:

    # MC @ lewd "Oh, I'm sure it won't."
    MC @ lewd "Oh, seguro que no."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:155
translate es qsttheslavemaster_pitch_menu_cf4f3f87:

    # NYX @ angry "And no payment till AFTER the job is done!"
    NYX @ angry "¡Y no hay pago hasta DESPUÉS de terminar el trabajo!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:156
translate es qsttheslavemaster_pitch_menu_317840ab:

    # MC @ smile "Of course, I always live up to my end of the deal."
    MC @ smile "Por supuesto, siempre cumplo mi parte del trato."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:158
translate es qsttheslavemaster_pitch_menu_e37719bc:

    # "Captain Nyx pouted at the comment as her cheeks burned red."
    "La capitana Nyx hizo morritos ante el comentario mientras sus mejillas enrojecían."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:166
translate es qsttheslavemaster_pitch_menu_4e5d8af1:

    # NYX @ angry "Now that's out of the way, can we focus on the task at hand please?"
    NYX @ angry "Ahora que eso está aclarado, ¿podemos centrarnos en la tarea que tenemos entre manos, por favor?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:168
translate es qsttheslavemaster_pitch_menu_5344b784:

    # MC @ talk "What needs to be done first?"
    MC @ talk "¿Qué hay que hacer primero?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:169
translate es qsttheslavemaster_pitch_menu_15acb208:

    # "From her table, Captain Nyx handed me a selection of sheets."
    "Desde su mesa, la capitana Nyx me entregó una selección de hojas."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:170
translate es qsttheslavemaster_pitch_menu_787b7698:

    # NYX @ talk "Wrote here are some details about various trade routes and things, as well as the common price of raza and slaves these days."
    NYX @ talk "Escribí aquí algunos detalles sobre diversas rutas comerciales y cosas, así como el precio común de la raza y los esclavos en estos días."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:171
translate es qsttheslavemaster_pitch_menu_6577aed4:

    # NYX @ talk "These things are common knowledge for any trader, and even more so for a criminal like Angharad."
    NYX @ talk "Estas cosas son de conocimiento común para cualquier comerciante, y más aún para un criminal como Angharad."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:172
translate es qsttheslavemaster_pitch_menu_827983a1:

    # NYX @ talk "Learn these things well, and report back to me when you're ready to begin the next part of our plan."
    NYX @ talk "Aprende bien estas cosas e infórmame cuando estés listo para empezar la siguiente parte de nuestro plan."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:192
translate es qsttheslavemaster_pitch_menu_0ce9d935:

    # NYX @ talk "Have you read the book thoroughly?"
    NYX @ talk "¿Has leído el libro a fondo?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:193
translate es qsttheslavemaster_pitch_menu_4bb5bdec:

    # NYX @ talk "You'll need to memorise as much of it as you can to pass as the real deal."
    NYX @ talk "Tendrás que memorizar todo lo que puedas para pasar por el auténtico."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:194
translate es qsttheslavemaster_pitch_menu_89740cfd:

    # NYX @ talk "Are you sure you're ready for the next stage?"
    NYX @ talk "¿Seguro que estás preparado para la siguiente fase?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:197
translate es qsttheslavemaster_pitch_menu_0ca760e9:

    # NYX @ angry "Come back when you're ready, not before."
    NYX @ angry "Vuelve cuando estés listo, no antes."

