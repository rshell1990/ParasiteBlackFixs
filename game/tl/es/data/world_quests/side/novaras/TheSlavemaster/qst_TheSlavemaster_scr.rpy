translate es qsttheslavemaster_meeting_last_question_7c9b9408:

    # MC @ surprised "{i}You were a slave?{/i}"
    MC @ surprised "{i}¿Eras un esclavo?{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:880
translate es qsttheslavemaster_meeting_last_question_ecf760fb:

    # ANGHARAD @ smile "Of course."
    ANGHARAD @ smile "Por supuesto."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:881
translate es qsttheslavemaster_meeting_last_question_ff164ff8:

    # ANGHARAD @ smile "After proving my value to my master long enough, he came to trust me more and more."
    ANGHARAD @ smile "Después de demostrar mi valor a mi amo el tiempo suficiente, llegó a confiar en mí cada vez más."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:882
translate es qsttheslavemaster_meeting_last_question_b8b9cf6b:

    # ANGHARAD @ talk "And when his guard was down ... I slit his throat, and took everything he had."
    ANGHARAD @ talk "Y cuando bajó la guardia... Le corté la garganta, y cogí todo lo que tenía."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:885
translate es qsttheslavemaster_meeting_last_question_90530c4e:

    # ANGHARAD @ talk "Why should I have?"
    ANGHARAD @ talk "¿Por qué habría de hacerlo?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:886
translate es qsttheslavemaster_meeting_last_question_9c4849c6:

    # MC @ sad "It's just, you must have felt {i}something{/i} for them?"
    MC @ sad "Es que, ¿habrás sentido {i}algo{/i} por ellos?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:887
translate es qsttheslavemaster_meeting_last_question_64212fe1:

    # ANGHARAD @ talk "... You're an odd slaver, aren't you?"
    ANGHARAD @ talk "... Eres un esclavista extraño, ¿no?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:888
translate es qsttheslavemaster_meeting_last_question_9484688e:

    # ANGHARAD @ talk "No, I did not."
    ANGHARAD @ talk "No, no lo hice."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:889
translate es qsttheslavemaster_meeting_last_question_6f879915:

    # ANGHARAD @ talk "Had it not been me, someone else would have done the same given the opportunity."
    ANGHARAD @ talk "Si no hubiera sido yo, otra persona habría hecho lo mismo si hubiera tenido la oportunidad."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:890
translate es qsttheslavemaster_meeting_last_question_01412b0b:

    # ANGHARAD @ talk "Only people who have always had coin speak of luxuries like {i}righteousness.{/i}"
    ANGHARAD @ talk "Solo las personas que siempre han tenido monedas hablan de lujos como {i}la rectitud.{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:891
translate es qsttheslavemaster_meeting_last_question_6e83d0c4:

    # ANGHARAD @ talk "The starving man? The slave? The man with nothing to lose?"
    ANGHARAD @ talk "¿El hombre hambriento? ¿El esclavo? ¿El hombre sin nada que perder?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:892
translate es qsttheslavemaster_meeting_last_question_a1203cd6:

    # ANGHARAD @ talk "He won't question whether something is good or evil when he drags the blade across your throat for just a few coins."
    ANGHARAD @ talk "No se cuestionará si algo es bueno o malo cuando te pase la cuchilla por la garganta por unas pocas monedas."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:893
translate es qsttheslavemaster_meeting_last_question_b800a674:

    # "As I opened my mouth to say something, Captain Nyx suddenly tugged at my arm to intercede."
    "Cuando abrí la boca para decir algo, la capitana Nyx me tiró del brazo para interceder."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:896
translate es qsttheslavemaster_meeting_last_question_4c229a61:

    # ANGHARAD @ smile "Of course you can."
    ANGHARAD @ smile "Claro que puedes."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:897
translate es qsttheslavemaster_meeting_last_question_0d17cd35:

    # ANGHARAD @ talk "You and I understand this world was not for us, our kind were never meant to climb the great ladder."
    ANGHARAD @ talk "Tú y yo entendemos que este mundo no era para nosotros, nuestra especie nunca estuvo destinada a subir la gran escalera."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:898
translate es qsttheslavemaster_meeting_last_question_19fd675a:

    # ANGHARAD @ talk "If we want to find happiness, it will come at the expense of everyone else."
    ANGHARAD @ talk "Si queremos encontrar la felicidad, será a costa de los demás."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:899
translate es qsttheslavemaster_meeting_last_question_4b0c08c9:

    # "Captain Nyx stepping towards me from behind tugged at my arm."
    "La Capitana Nyx se me acercó por detrás y me tiró del brazo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:903
translate es qsttheslavemaster_meeting_last_question_6bdee803:

    # NYX @ talk "Master? Should I fetch us all some wine?"
    NYX @ talk "¿Amo? ¿Debería traer vino para todos?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:904
translate es qsttheslavemaster_meeting_last_question_becb58c9:

    # "Nyx gripped my arm tightly and I could see from her eyes she was giving me the signal that we had the proof she needed."
    "Nyx me cogió del brazo con fuerza y pude ver en sus ojos que me estaba dando la señal de que teníamos la prueba que necesitaba."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:905
translate es qsttheslavemaster_meeting_last_question_65299ba2:

    # MC @ talk "Yes, fetch us some wine."
    MC @ talk "Sí, tráenos vino."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:910
translate es qsttheslavemaster_meeting_last_question_d9cece43:

    # "Captain Nyx hurried off to go pour some wine for us."
    "La capitana Nyx se apresuró a servirnos vino."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:912
translate es qsttheslavemaster_meeting_last_question_a0cc1001:

    # ANGHARAD @ smile "... So, do you love your slave?"
    ANGHARAD @ smile "... Entonces, ¿amas a tu esclava?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:913
translate es qsttheslavemaster_meeting_last_question_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "¿Qué?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:914
translate es qsttheslavemaster_meeting_last_question_326a780f:

    # ANGHARAD @ smile "You'd hardly be the first."
    ANGHARAD @ smile "No serías el primero."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:915
translate es qsttheslavemaster_meeting_last_question_b4487286:

    # ANGHARAD @ smile "And the way you two look at each other, well, even the blind could see that."
    ANGHARAD @ smile "Y la forma en que os miráis, bueno, hasta los ciegos podrían verlo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:919
translate es qsttheslavemaster_meeting_last_question_4ad75aab:

    # "Captain Nyx, after making her way around the room handing each of the guards a cup, she gave Angharad one which he gulped down quickly and threw aside, before finally approaching me with the final cup."
    "La capitana Nyx, tras pasearse por la sala entregando una copa a cada uno de los guardias, le dio una a Angharad, que engulló rápidamente y tiró a un lado, antes de acercarse finalmente a mí con la última copa."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:920
translate es qsttheslavemaster_meeting_last_question_6c2d69f9:

    # NYX @ talk "Master~"
    NYX @ talk "Amo~"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:921
translate es qsttheslavemaster_meeting_last_question_d2594cc3:

    # "Nyx lightly nodded to signal to me as I took the cup, and with one sniff, I could tell from the potency of the drug she had placed inside of it, that it wouldn't take long to kick in."
    "Nyx me hizo una leve señal con la cabeza cuando cogí la taza y, al olerla, me di cuenta, por la potencia de la droga que había colocado en su interior, de que no tardaría en hacer efecto."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:922
translate es qsttheslavemaster_meeting_last_question_fc146197:

    # "I pretended to sip at my drink to not arouse suspicion before placing it down back onto the tray."
    "Fingí dar un sorbo a mi bebida para no levantar sospechas antes de depositarla de nuevo en la bandeja."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:923
translate es qsttheslavemaster_meeting_last_question_2a14326b:

    # MC @ talk "Thank you, Lyesha."
    MC @ talk "Gracias, Lyesha."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:924
translate es qsttheslavemaster_meeting_last_question_ba564e34:

    # "After a few minutes of small talk and laughing amongst the men now they had relaxed in my pressence, Angharad finally interjected,"
    "Tras unos minutos de charla y risas entre los hombres, ahora que se habían relajado bajo mi presión, Angharad intervino por fin."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:925
translate es qsttheslavemaster_meeting_last_question_f75fda92:

    # ANGHARAD @ smile "Now then, what's say we-"
    ANGHARAD @ smile "Ahora bien, ¿qué tal si-"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:926
translate es qsttheslavemaster_meeting_last_question_ec8caf4d:

    # "One of the Khazah guards suddenly collapsed onto the floor, the others turned to look in panic, reaching for their blades as one by one they fell to the floor."
    "Uno de los guardias khazah se desplomó de repente en el suelo, los demás se volvieron para mirar aterrados, echando mano a sus espadas mientras uno a uno caían al suelo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:928
translate es qsttheslavemaster_meeting_last_question_e29223b1:

    # ANGHARAD @ furious "WHAT THE FUCK IS THIS?!"
    ANGHARAD @ furious "¡¿QUÉ COJONES ES ESTO?!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:929
translate es qsttheslavemaster_meeting_last_question_fa9046a3:

    # "Captain Nyx pulled out the small stone that she crushed in her hand, and as she did so, it cracked and glowed red."
    "La capitana Nyx sacó la pequeña piedra que aplastó en su mano y, al hacerlo, se resquebrajó y brilló en rojo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:930
translate es qsttheslavemaster_meeting_last_question_284926aa:

    # "Moments later, the place was rushed by dozens of the city's guards, spears pointed and ready."
    "Momentos después, el lugar fue asaltado por decenas de guardias de la ciudad, con las lanzas apuntando y listas."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:931
translate es qsttheslavemaster_meeting_last_question_f35119b7:

    # ANGHARAD @ furious "YOU SON OF A-"
    ANGHARAD @ furious "HIJO DE-"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:932
translate es qsttheslavemaster_meeting_last_question_107db710:

    # "Angharad himself tried to reach to grab his blade, gripping the handle as he fumbled and crashed his way into the pieces of furniture deliriously."
    "El propio Angharad trató de alcanzar para coger su espada, agarrando el mango mientras tanteaba y chocaba delirantemente contra los muebles."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:933
translate es qsttheslavemaster_meeting_last_question_312c1f1c:

    # ANGHARAD @ furious "I'll ... kill ..."
    ANGHARAD @ furious "Te... mataré..."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:934
translate es qsttheslavemaster_meeting_last_question_63273423:

    # "Just as Angharad managed to unsheathe his blade, he too collapsed onto the floor with the others, fast asleep."
    "Justo cuando Angharad consiguió desenvainar su espada, él también se desplomó en el suelo con los demás, profundamente dormido."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:937
translate es qsttheslavemaster_meeting_last_question_3fb94171:

    # NYX @ angry "Seize them all at once!"
    NYX @ angry "¡Captúrenlos todos de una vez!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:940
translate es qsttheslavemaster_meeting_last_question_5c168990:

    # "The guards quickly swept across the room, gathering up and arresting Angharad and the other khazah bandits while they were unconscious."
    "Los guardias recorrieron rápidamente la sala, recogiendo y arrestando a Angharad y a los demás bandidos khazah mientras estaban inconscientes."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:943
translate es qsttheslavemaster_meeting_last_question_5e955462:

    # "A shaking Alysha approached the two of us, dazed and confused as to what was going on."
    "Una temblorosa Alysha se acercó a nosotros dos, aturdida y confusa por lo que estaba pasando."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:944
translate es qsttheslavemaster_meeting_last_question_f75c3c20:

    # ALYSHA @ talk "W-Who are you both?"
    ALYSHA @ talk "¿Q-quiénes sois los dos?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:945
translate es qsttheslavemaster_meeting_last_question_7a2f3bc7:

    # NYX @ talk "I am Captain Nyx of the Novaras city guard."
    NYX @ talk "Soy la Capitana Nyx de la guardia de la ciudad de Novaras."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:947
translate es qsttheslavemaster_meeting_last_question_7f402aae:

    # ALYSHA @ shock "C-Captain?"
    ALYSHA @ shock "¿C-capitana?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:948
translate es qsttheslavemaster_meeting_last_question_22d2b2ab:

    # NYX @ laugh "You're free now, Alysha."
    NYX @ laugh "Ahora eres libre, Alysha."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:949
translate es qsttheslavemaster_meeting_last_question_ed7553a8:

    # ALYSHA @ shock "F-Free?"
    ALYSHA @ shock "¿L-libre"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:950
translate es qsttheslavemaster_meeting_last_question_57bff934:

    # NYX @ talk "We'll take you in for questioning, and then I'll personally see to it that you're looked after we're done, don't worry."
    NYX @ talk "Te llevaremos para interrogarte y luego me encargaré personalmente de que te cuiden cuando acabemos, no te preocupes."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:951
translate es qsttheslavemaster_meeting_last_question_d633fe0e:

    # NYX @ talk "You, and hopefully the other girls too."
    NYX @ talk "Tú, y espero que las otras chicas también."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:952
translate es qsttheslavemaster_meeting_last_question_495ac1b0:

    # "Alysha's expression was a strange kind of wistfulness, then the tears began to stream down her cheeks."
    "La expresión de Alysha era de una extraña melancolía, luego las lágrimas empezaron a correr por sus mejillas."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:954
translate es qsttheslavemaster_meeting_last_question_0a3241f2:

    # ALYSHA @ crying "It's ... It's really over? I'm free?"
    ALYSHA @ crying "Sw... ¿Se acabó de verdad? ¿Soy libre?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:955
translate es qsttheslavemaster_meeting_last_question_32cd786e:

    # ALYSHA @ crying "{i}I'm ... I'm free.{/i}"
    ALYSHA @ crying "{i}Soy... Soy libre.{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:956
translate es qsttheslavemaster_meeting_last_question_18954df7:

    # "Alysha suddenly collapsed to the floor, and a panicked Captain Nyx grabbed her."
    "De repente, Alysha se desplomó en el suelo y una aterrorizada Capitana Nyx la cogió."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:960
translate es qsttheslavemaster_meeting_last_question_b328a03f:

    # NYX @ shock "Someone get this girl seen to!"
    NYX @ shock "¡Que alguien atienda a esta chica!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:973
translate es qsttheslavemaster_meeting_last_question_10affad2:

    # "A couple guards rushed over to grab and carrying her outside."
    "Un par de guardias se apresuraron a cogerla y llevarla fuera."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:974
translate es qsttheslavemaster_meeting_last_question_b6310ff8:

    # MC @ talk "Will she be okay?"
    MC @ talk "¿Estará bien?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:976
translate es qsttheslavemaster_meeting_last_question_f6a575b0:

    # NYX @ talk "She's probably in shock."
    NYX @ talk "Probablemente esté en shock."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:977
translate es qsttheslavemaster_meeting_last_question_38bcba33:

    # NYX @ sad "Gods only know what that girl's been through."
    NYX @ sad "Solo Dios sabe por lo que ha pasado esa chica."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:978
translate es qsttheslavemaster_meeting_last_question_98d7a4f0:

    # "Captain Nyx shuddered at the thought."
    "La capitana Nyx se estremeció al pensarlo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:979
translate es qsttheslavemaster_meeting_last_question_97f601ec:

    # NYX @ talk "Anyway, you best clear off before some of the others get here."
    NYX @ talk "En fin, será mejor que te vayas antes de que lleguen los demás."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:982
translate es qsttheslavemaster_meeting_last_question_fbf5b82d:

    # "Neither of us moved for a moment, staring awkwardly at each other as we finally had a moment to process everything that had just happened."
    "Ninguno de los dos nos movimos por un momento, mirándonos torpemente mientras por fin teníamos un momento para procesar todo lo que acababa de ocurrir."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:983
translate es qsttheslavemaster_meeting_last_question_05a95dae:

    # NYX @ blush "W-What are you are you looking at me like that for?"
    NYX @ blush "¿P-por qué me miras así?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:984
translate es qsttheslavemaster_meeting_last_question_3c65a21b:

    # "I gently reached out to grab Nyx's arm."
    "Estiré suavemente la mano para coger el brazo de Nyx."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:986
translate es qsttheslavemaster_meeting_last_question_7a392d43:

    # MC @ talk "Don't you think we should maybe talk about what just happened in there?"
    MC @ talk "¿No crees que deberíamos hablar de lo que acaba de pasar?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:990
translate es qsttheslavemaster_meeting_last_question_53c5f9c0:

    # "Nyx slapped my hand away."
    "Nyx me apartó la mano de un manotazo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:991
translate es qsttheslavemaster_meeting_last_question_76a7df00:

    # NYX @ angry "There's nothing to talk about!"
    NYX @ angry "¡No hay nada de qué hablar!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:992
translate es qsttheslavemaster_meeting_last_question_6fb2e182:

    # NYX @ angry "Everything that happened, happened for the mission! That's all!"
    NYX @ angry "¡Todo lo que pasó, pasó por la misión! ¡Eso es todo!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:993
translate es qsttheslavemaster_meeting_last_question_76abe274:

    # NYX @ angry "Are we clear?"
    NYX @ angry "¿Está claro?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:994
translate es qsttheslavemaster_meeting_last_question_2bc85fc5:

    # MC @ surprised "I just thought you might want to at least-"
    MC @ surprised "Solo pensé que querrías al menos-"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:995
translate es qsttheslavemaster_meeting_last_question_f68d8753:

    # NYX @ angry "J-Just get out of here!"
    NYX @ angry "¡S-solo vete de aquí!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:996
translate es qsttheslavemaster_meeting_last_question_a331dc86:

    # NYX @ angry "You'll just get in the way now, so leave!"
    NYX @ angry "Ahora solo estorbas, ¡así que vete!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:998
translate es qsttheslavemaster_meeting_last_question_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:999
translate es qsttheslavemaster_meeting_last_question_4784fa8a:

