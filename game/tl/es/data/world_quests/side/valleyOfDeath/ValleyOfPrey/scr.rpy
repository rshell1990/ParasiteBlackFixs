

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:4
translate es qst_ValleyOfPrey_93f8fa7b:

    # VES @ smile_talk "Good!"
    VES @ smile_talk "¡Bien!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:5
translate es qst_ValleyOfPrey_40e98cec:

    # VES @ talk "Give me a moment to get my stuff..."
    VES @ talk "Dame un momento para coger mis cosas..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:7
translate es qst_ValleyOfPrey_f3afe333:

    # "Ves pushed open the flap of her tent as she headed inside of it once again. My thoughts turned to the Skorn."
    "Ves empujó la solapa de su tienda y volvió a entrar en ella. Mis pensamientos se volvieron hacia los skorn."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:8
translate es qst_ValleyOfPrey_00ba4f91:

    # "I had heard about them in class, the great desert bison that roamed the harsh Valley of Death but had never seen one before with my own eyes."
    "Había oído hablar de ellos en clase, de los grandes bisontes del desierto que vagaban por el duro Valle de la Muerte, pero nunca había visto uno con mis propios ojos."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:13
translate es qst_ValleyOfPrey_8917f7b8:

    # "Ves quickly returned holding her sharpened axes, a spear, and other such equipment."
    "Ves volvió rápidamente sosteniendo sus hachas afiladas, una lanza, y otros equipos similares."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:14
translate es qst_ValleyOfPrey_ea1b9968:

    # VES @ talk "Are you ready?"
    VES @ talk "¿Estás preparado?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:15
translate es qst_ValleyOfPrey_69b977f8:

    # MC @ talk "As I’ll ever be."
    MC @ talk "Como nunca lo estaré."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:16
translate es qst_ValleyOfPrey_ddd012a7:

    # VES @ talk "It’s at least an hour or so trek on foot... I’ve got water but be prepared, the desert is harsher than you know."
    VES @ talk "Es al menos una hora de camino a pie... Tengo agua, pero prepárate, el desierto es más duro de lo que crees."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:17
translate es qst_ValleyOfPrey_b9615875:

    # MC @ talk "... I think I can speed things up."
    MC @ talk "...Creo que puedo acelerar las cosas."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:21
translate es qst_ValleyOfPrey_41855953:

    # "Ves’ eyes widened and she flushed red watching me strip off my clothes in front of her."
    "Los ojos de Ves se abrieron de par en par y se puso colorada al verme desnudarme delante de ella."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:22
translate es qst_ValleyOfPrey_7830f23f:

    # VES @ surp_talk "W-What are you doing?!"
    VES @ surp_talk "¡¿Q-Qué estás haciendo?!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:23
translate es qst_ValleyOfPrey_a90fa2cc:

    # "Ves' eyes stared down at the cock dangling in front of her."
    "Los ojos de Ves se clavaron en la polla que colgaba frente a ella."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:24
translate es qst_ValleyOfPrey_6893e75d:

    # MC @ talk "I’m going to transform."
    MC @ talk "Voy a transformarme."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:25
translate es qst_ValleyOfPrey_c9cfd6f3:

    # MC @ talk "I can get us across the desert and back much faster in my other form."
    MC @ talk "Puedo atravesar el desierto y volver mucho más rápido en mi otra forma."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:26
translate es qst_ValleyOfPrey_5a9db378:

    # "Turning paler white than I had ever seen her before, Ves looked away anxiously."
    "Más pálida de lo que jamás la había visto, Ves apartó la mirada con ansiedad."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:27
translate es qst_ValleyOfPrey_f37a4c98:

    # VES @ surp_talk "I... Yes, that makes sense."
    VES @ surp_talk "Yo... Sí, eso tiene sentido."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:29
translate es qst_ValleyOfPrey_49a9f33d:

    # "As I took off the last of my clothes, now accustomed to the once agonizing, brutal transformation after some painful ‘adjustments’..."
    "Mientras me quitaba el resto de la ropa, acostumbrado ya a la transformación, antes agónica y brutal, tras unos dolorosos ‘ajustes’..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:31
translate es qst_ValleyOfPrey_cb457db2:

    # "I changed myself into my second form in record time."
    "Me cambié a mi segunda forma en un tiempo récord."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:36
translate es qst_ValleyOfPrey_72b75bad:

    # MC "Are you ready?"
    MC "¿Estás lista?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:37
translate es qst_ValleyOfPrey_630a7504:

    # VES @ surp_talk "How will you—"
    VES @ surp_talk "¿Cómo vas a—?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:38
translate es qst_ValleyOfPrey_6678a294:

    # VES @ surp_talk "H-HEY!"
    VES @ surp_talk "¡O-OYE!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:39
translate es qst_ValleyOfPrey_9eb609df:

    # "I scoped Ves up under my arm."
    "Levanté a Ves bajo mi brazo."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:40
translate es qst_ValleyOfPrey_29bb6266:

    # MC "Which way?"
    MC "¿Hacia dónde?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:41
translate es qst_ValleyOfPrey_6000cfb1:

    # VES @ surp_talk "... T-That way."
    VES @ surp_talk "...P-por ahí."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:48
translate es qst_ValleyOfPrey_45ffaade:

    # "Ves pointed in the direction, and I followed."
    "Ves señaló la dirección y yo la seguí."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:49
translate es qst_ValleyOfPrey_a057a701:

    # "With Ves in my arms, I quickly began to propel us across the hot desert sands with the thick tentacles swinging us across like vines, covering miles in mere moments."
    "Con Ves en mis brazos, rápidamente empecé a impulsarnos a través de las calientes arenas del desierto con los gruesos tentáculos balanceándonos como lianas, cubriendo kilómetros en cuestión de instantes."
# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:50
translate es qst_ValleyOfPrey_59b56fc8:

    # "Ves seemed slightly unsure of what to do as she was cradled in my arms."
    "Ves parecía un poco insegura de qué hacer mientras la tenía entre mis brazos."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:51
translate es qst_ValleyOfPrey_d63ba394:

    # "I towered over her in this form, and no doubt this shape still had some strange, terrifying quality to those unaccustomed to seeing it."
    "Me alzaba sobre ella en esta forma, y sin duda esta forma todavía tenía alguna cualidad extraña y aterradora para aquellos que no estaban acostumbrados a verla."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:52
translate es qst_ValleyOfPrey_f9c04db8:

    # "Still, as the sun beat on my back and the cool breeze passed us by, she seemed to relax, curiously tracing her fingers along the hard exterior of my flesh inquisitively."
    "Aun así, mientras el sol golpeaba mi espalda y la fresca brisa nos acariciaba, ella pareció relajarse, recorriendo curiosa e inquisitivamente con sus dedos el duro exterior de mi carne."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:54
translate es qst_ValleyOfPrey_44e2d2f3:

    # "Finally, we arrived upon some great flat valley where just across the ridge below revealed a great herd of Skorn."
    "Finalmente, llegamos a un gran valle llano donde, justo al otro lado de la ladera, se revelaba una gran manada de skorn."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:55
translate es qst_ValleyOfPrey_d83ff686:

    # "Huge towering three-eyed beasts with legs the size of small buildings, their long trunks pushed deep down into the desert, finding water in minutes that would take men hours to dig far enough down to find."
    "Enormes bestias de tres ojos con patas del tamaño de pequeños edificios, sus largas trompas se adentraban en el desierto, encontrando en cuestión de minutos el agua que a los hombres les llevaría horas excavar hasta encontrarla."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:56
translate es qst_ValleyOfPrey_7104dc8c:

    # MC "...They are... bigger than I imagined."
    MC "...Son... más grandes de lo que imaginaba."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:57
translate es qst_ValleyOfPrey_5fb0397f:

    # VES "Come... We must take the strongest one."
    VES "Vamos... Debemos quedarnos con el más fuerte."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:58
translate es qst_ValleyOfPrey_e1f6d48f:

    # MC "Huh? Why do you—"
    MC "¿Eh? ¿Por qué—?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:59
translate es qst_ValleyOfPrey_1eb152e3:

    # VES "To go for the weak or young is shameful..."
    VES "Ir a por los débiles o los jóvenes es vergonzoso..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:60
translate es qst_ValleyOfPrey_f55dd0c3:

    # VES "When we hunt, {i}what{/i} we hunt is of great importance."
    VES "Cuando cazamos, {i}lo{/i} que cazamos es de gran importancia."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:61
translate es qst_ValleyOfPrey_50e59b58:

    # "Readying her axes, Ves scanned across the many Skorn before pointing out one of the largest amongst them with a slightly darker complexion."
    "Preparando sus hachas, Ves observó a los numerosos Skorn antes de señalar a uno de los más grandes, de tez ligeramente más oscura."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:62
translate es qst_ValleyOfPrey_f992c33d:

    # "Its ram-like horns formidable in size, made it appear like some ancient god of the desert."
    "Sus cuernos de carnero, de tamaño formidable, le hacían parecer un antiguo dios del desierto."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:63
translate es qst_ValleyOfPrey_75419991:

    # MC "What’s the plan to—"
    MC "¿Cuál es el plan para—?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:64
translate es qst_ValleyOfPrey_42a2e82a:

    # "Before I could finish my sentence, Ves charged like a woman possessed with both her axes towards the colossal Skorn."
    "Antes de que pudiera terminar mi frase, Ves cargó como una posesa con sus dos hachas hacia el colosal Skorn."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:65
translate es qst_ValleyOfPrey_0c5d5516:

    # VES "GRGHHHHH!"
    VES "¡GRGHHHHH!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:66
translate es qst_ValleyOfPrey_93c13848:

    # MC "(... Well, fuck.)"
    MC "(...Bueno, joder)."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:67
translate es qst_ValleyOfPrey_94f9d7ee:

    # "Following after her, the other now spooked Skorn noticing her presence instinctively began to flee."
    "Siguiéndola, los otros skorn, ahora asustados, al notar su presencia comenzaron a huir instintivamente."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:68
translate es qst_ValleyOfPrey_8bff3b26:

    # "Soon there was a massive stampede of the beasts fleeing across the desert plains."
    "Pronto se produjo una estampida masiva de las bestias huyendo a través de las llanuras desérticas."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:69
translate es qst_ValleyOfPrey_cc06e623:

    # "Following behind Ves, I quickly grabbed her once again as the stampede hurried shoulder to shoulder, often smashing and barging violently into each other as they fled."
    "Siguiendo a Ves, me apresuré a atraparla de nuevo mientras la estampida corría hombro con hombro, a menudo chocando y golpeándose violentamente unos contra otros en su huida."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:70
translate es qst_ValleyOfPrey_a7f5d255:

    # VES "Don’t lose him!"
    VES "¡No lo pierdas!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:71
translate es qst_ValleyOfPrey_b494e7db:

    # "Ves shouted, pointing towards the great Skorn whose trunk smashed into the bulk of a smaller Skorn sending it toppling over onto its side as it fled from us."
    "Ves gritó, señalando hacia el gran skorn cuya trompa se estrelló contra otro skorn más pequeño haciéndolo caer de lado mientras huía de nosotros."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:72
translate es qst_ValleyOfPrey_c0795b88:

    # VES "Quick! Throw me!"
    VES "¡Rápido! ¡Lánzame!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:73
translate es qst_ValleyOfPrey_95e59f81:

    # MC "What?!"
    MC "¡¿Qué?!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:74
translate es qst_ValleyOfPrey_8e960187:

    # VES "Just do it!"
    VES "¡Hazlo!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:75
translate es qst_ValleyOfPrey_985e4c6e:

    # "Throwing Ves hurtling through the air, she climbed onto the back of one of the Skorn and scaled her way up its hide."
    "Lanzando a Ves por los aires, se subió al lomo de uno de los Skorn y trepó por su piel."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:76
translate es qst_ValleyOfPrey_0d1d99ed:

    # "I watched with surprise as she leapt from Skorn to Skorn, gaining on the great beast with greater speed than even I was!"
    "Observé con sorpresa cómo saltaba de Skorn en Skorn, ¡ganándole terreno a la gran bestia con mayor velocidad que incluso yo!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:77
translate es qst_ValleyOfPrey_526e6bcb:

    # "Narrowly dodging the crazed Skorn, the two of us were finally catching up and close behind the when suddenly..."
    "Esquivando por los pelos al skorn enloquecido, los dos estábamos por fin alcanzando y acercándonos al cuando de repente..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:78
translate es qst_ValleyOfPrey_16c73f3f:

    # "The ground began to vibrate greater than even the herds stamping could cause."
    "El suelo empezó a vibrar más de lo que podían hacerlo los pisotones de los rebaños."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:79
translate es qst_ValleyOfPrey_79d5ca08:

    # "The sand ahead of us began to move as a small whirlpool formed and seemed to sink the ground, dragging nearby Skorn into its pull."
    "La arena delante de nosotros comenzó a moverse mientras se formaba un pequeño remolino que parecía hundir el suelo, arrastrando a los skorn cercanos en su atracción."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:84
translate es qst_ValleyOfPrey_47e05a7e:

    # "Suddenly, a great beast flung itself out of the sands and collided with our Skorn, its huge jaws clasping down onto the beast as it slammed it into the desert sands."
    "De repente, una gran bestia salió de las arenas y chocó con nuestro Skorn, sus enormes mandíbulas se cerraron sobre la bestia mientras la estrellaba contra las arenas del desierto."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:85
translate es qst_ValleyOfPrey_ee1cc2b0:

    # VES "It’s a {i}bazark!{/i}"
    VES "¡Es un {i}bazark!{/i}"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:87
translate es qst_ValleyOfPrey_98cf9cee:

    # "Ves cried out in disbelief, watching as the Skorn screamed out and tried to escape before the bazark slammed its teeth around the throat of the Skorn, violently squeezing and shaking many times till it snapped its neck."
    "Ves gritó de incredulidad, viendo cómo el Skorn gritaba e intentaba escapar antes de que el bazark le clavara los dientes en la garganta, apretando y sacudiendo violentamente muchas veces hasta romperle el cuello."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:88
translate es qst_ValleyOfPrey_42cd1029:

    # "Digging its colossal jaws into the soft hide of the Skorn, it gnashed and tore as it swallowed down pieces of its flesh."
    "Clavando sus colosales mandíbulas en la suave piel del skorn, rechinó y desgarró mientras engullía trozos de su carne."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:89
translate es qst_ValleyOfPrey_1e436363:

    # "Then with a glint in its eye it noticed us still stood there rooted to the ground watching, and turned its attention towards us, snarling malevolently."
    "Entonces, con un destello en los ojos, se dio cuenta de que seguíamos mirando clavados en el suelo y dirigió su atención hacia nosotros, gruñendo malévolamente."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:91
translate es qst_ValleyOfPrey_345b9452:

    # MC "VES!"
    MC "¡VES!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:106
translate es qst_ValleyOfPrey_0eaf0c74:

    # "As the bloodied and battered bazark shook its head in a daze, blood dripping down its face onto the hot desert sand, Ves turned to me and shouted breathlessly."
    "Mientras el ensangrentado y maltrecho bazark sacudía la cabeza aturdido, con la sangre goteándole por la cara sobre la arena caliente del desierto, Ves se giró hacia mí y gritó sin aliento."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:107
translate es qst_ValleyOfPrey_0733abdf:

    # VES @ talk "{i}*Huff*{/i} It just won’t stop coming!"
    VES @ talk "{i}*Uff*{/i} ¡No para de venir!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:108
translate es qst_ValleyOfPrey_a09b5db4:

    # "As the bazark continued to shake violently, it pulled up enough of its hide to reveal the soft underbelly of the great beast, revealing some beating organ covered below the thin flesh."
    "Mientras el bazark seguía sacudiéndose violentamente, arrancó lo suficiente de su piel para dejar al descubierto el suave vientre de la gran bestia, revelando algún órgano palpitante cubierto bajo la fina carne."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:109
translate es qst_ValleyOfPrey_75c5b05a:

    # MC "...Ves I have an idea!"
    MC "¡...Ves tengo una idea!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:110
translate es qst_ValleyOfPrey_1ca27af3:

    # VES @ talk "What are you—"
    VES @ talk "¿Qué es lo que—?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:111
translate es qst_ValleyOfPrey_bef099ca:

    # VES @ talk "Whoa!"
    VES @ talk "¡Guau!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:113
translate es qst_ValleyOfPrey_8643fe33:

    # "Grabbing Ves once again, with frantic motions I began to claw my way up the bazark, my tentacles slamming into the sides of its flesh, tearing out chunks of it as I swung towards the top of the thing."
    "Volví a coger a Ves y, con movimientos frenéticos, empecé a trepar por el bazark. Mis tentáculos golpeaban su carne, arrancándole trozos mientras me balanceaba hacia la cima."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:114
translate es qst_ValleyOfPrey_0daf41b6:

    # "Its claws flailed and slashed around frantically as though we were some itch it needed to scratch, only narrowly missing us as the thing took a swipe at itself, leaving bloody claw marks on its own scaled flesh."
    "Sus garras se agitaron y cortaron frenéticamente como si fuéramos un picor que tuviera que rascarse, y por poco no nos alcanzaron cuando la cosa se golpeó a sí misma, dejando sangrientas marcas de garras en su propia carne escamosa."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:115
translate es qst_ValleyOfPrey_6110d4ad:

    # "Finally reaching the top of the bazark, Ves slammed her axes into the flesh to hold herself in place as the thing tried once more to shake us off. Ves looked to me uncertain of what to do next."
    "Al llegar por fin a la cima del bazark, Ves golpeó con sus hachas la carne para mantenerse en su sitio mientras la cosa intentaba una vez más sacudirnos. Ves me miró sin saber qué hacer a continuación."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:116
translate es qst_ValleyOfPrey_608e1009:

    # VES "Now what?"
    VES "¿Ahora qué?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:117
translate es qst_ValleyOfPrey_aabd5273:

    # MC "I need you to go for its eyes!"
    MC "¡Necesito que vayas por sus ojos!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:118
translate es qst_ValleyOfPrey_abaae829:

    # VES "What!"
    VES "¡Que!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:119
translate es qst_ValleyOfPrey_0e70d411:

    # MC "Its eyes! Just go for its eyes!"
    MC "¡Sus ojos! ¡Solo ve por sus ojos!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:120
translate es qst_ValleyOfPrey_498ce095:

    # "Quickly, I swung in a circular descent towards the ground once again, feeling the rush of cool air and kicked up desert sand as I felt one of its swinging claws narrowly miss me, forcing me to drop and roll harshly onto the hot desert sand."
    "Rápidamente, me balanceé en un descenso circular hacia el suelo una vez más, sintiendo la ráfaga de aire frío y la arena del desierto levantada a patadas cuando sentí que una de sus garras oscilantes me fallaba por poco, obligándome a caer y rodar con dureza sobre la arena caliente del desierto."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:121
translate es qst_ValleyOfPrey_b8af20a2:

    # "Under normal circumstances, a few bones would have been broken, but thanks to the parasite’s hard exterior I was left a little bruised but mostly unscathed."
    "En circunstancias normales, me habría roto algunos huesos, pero gracias a la dureza exterior del parásito me quedé un poco magullado, pero casi ileso."
# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:122
translate es qst_ValleyOfPrey_b9703b57:

    # "Struggling to stay still on the bazark’s back as it tried desperately to rip her from itself, Ves dragged herself forward with swings of her axes."
    "Luchando por permanecer inmóvil sobre el lomo del bazark mientras éste trataba desesperadamente de arrancarla de sí, Ves se arrastró hacia delante con golpes de sus hachas."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:123
translate es qst_ValleyOfPrey_c4a82167:

    # "Piercing through the flesh to anchor herself in place till she made it to the front of the beast’s reptilian head."
    "Atravesando la carne para anclarse en su sitio hasta llegar a la parte delantera de la cabeza reptiliana de la bestia."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:124
translate es qst_ValleyOfPrey_8516d036:

    # "Its eyes twitched and focused on her when it noticed her lurking there above it, axes raised."
    "Sus ojos se estremecieron y se centraron en ella cuando se dio cuenta de que acechaba por encima de ella, con las hachas en alto."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:125
translate es qst_ValleyOfPrey_0b90ec4e:

    # "Ves cried out as she slammed her axe into soft eye of the bazark but there was little it could do."
    "Ves gritó mientras golpeaba con su hacha el ojo blando del bazark, pero poco pudo hacer."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:126
translate es qst_ValleyOfPrey_39aa3e79:

    # "Throwing itself backwards, the great beast flailed helplessly, unsure of what to do with its arms, unable to reach the orc on its head."
    "Lanzándose hacia atrás, la gran bestia se agitó indefensa, sin saber qué hacer con los brazos, incapaz de alcanzar al orco que tenía en la cabeza."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:127
translate es qst_ValleyOfPrey_1063faa4:

    # "For a moment, the thing seemed ready to slam itself onto its back and submerge back into the depths of the desert sands, if only to get rid of the orc still hacking away at its eyes."
    "Por un momento, la cosa pareció dispuesta a caer de espaldas y sumergirse de nuevo en las profundidades de las arenas del desierto, aunque solo fuera para librarse del orco que aún le cortaba los ojos."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:128
translate es qst_ValleyOfPrey_3a444327:

    # "But now, with its underbelly exposed once again I lunged forward, claws ready as I slashed through the flesh and forced myself inside the beast."
    "Pero ahora, con su vientre expuesto una vez más, me lancé hacia delante, con las garras listas para atravesar la carne y forzarme dentro de la bestia."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:129
translate es qst_ValleyOfPrey_8092cf6c:

    # "It now changed course in blind agonising panic and bellowed forward, obviously aware of my presence but it was again too late."
    "Ahora cambió de rumbo, presa de un agonizante pánico, y avanzó bramando, obviamente consciente de mi presencia, pero de nuevo era demasiado tarde."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:130
translate es qst_ValleyOfPrey_0ca8dfbe:

    # "Slashing and clawing my way through the bazark’s soft flesh with ease, it began desperately to claw at the gaping wound in its soft underbelly to try and pull me out, but it was impossible."
    "Atravesé con facilidad la carne blanda del bazark, que empezó a arañar desesperadamente la herida abierta en su suave vientre para intentar sacarme, pero era imposible."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:131
translate es qst_ValleyOfPrey_f8711ba7:

    # "Forcing my way through the back of the beast I tore my way out in a spray of violence and blood, thick chunks of red meat dropped down onto the coarse sand floor from the gaping hole in which I had emerged from."
    "Me abrí paso a la fuerza por la espalda de la bestia y salí despedido en una salpicadura de violencia y sangre, gruesos trozos de carne roja cayeron al suelo de arena desde el enorme agujero por el que había salido."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:133
translate es qst_ValleyOfPrey_059bc863:

    # "With one final whimpering howl, the thing slammed dead into the hot sand, its mouth hanging open and quivering for a final few sickening motions in defeat."
    "Con un último aullido quejumbroso, la cosa se estrelló contra la arena caliente, con la boca abierta y temblando durante unos últimos y repugnantes movimientos de derrota."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:139
translate es qst_ValleyOfPrey_03637734:

    # MC "{i}*Huff*{/i} Ves! Are you okay?"
    MC "{i}*Uff*{/i} ¡Ves! ¿Estás bien?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:140
translate es qst_ValleyOfPrey_8d8378a9:

    # "I looked around frantically for her."
    "Miré frenéticamente a mi alrededor buscándola."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:141
translate es qst_ValleyOfPrey_e63f8036:

    # MC "Ves!"
    MC "¡Ves!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:146
translate es qst_ValleyOfPrey_e746bb12:

    # VES @ talk "I’m alright..."
    VES @ talk "Estoy bien..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:147
translate es qst_ValleyOfPrey_31805282:

    # MC "I can’t believe we actually managed to bring that thing down!"
    MC "¡No puedo creer que hayamos conseguido derribar esa cosa!"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:148
translate es qst_ValleyOfPrey_216df0f5:

    # "Stepping forward towards the mouth of the dead beast, Ves reached down to carve out and take one of its scales."
    "Avanzando hacia la boca de la bestia muerta, Ves se agachó para tallar y coger una de sus escamas."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:149
translate es qst_ValleyOfPrey_989a4394:

    # VES @ talk "For such a prized kill as this, we’d normally take the skull to honour a War Hall."
    VES @ talk "Por una muerte tan preciada como esta, normalmente llevaríamos el cráneo a honrar una sala de guerra."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:150
translate es qst_ValleyOfPrey_0d3e54d4:

    # VES @ talk "{i}*Sigh*{/i} But I suppose this will have to do..."
    VES @ talk "{i}*Suspiro*{/i} Pero supongo que esto tendrá que servir..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:151
translate es qst_ValleyOfPrey_42d4318b:

    # "Looking over at the dead Skorn we were hunting earlier, I glanced at Ves uncertainly."
    "Mirando al skorn muerto que estábamos cazando antes, miré a Ves con incertidumbre."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:152
translate es qst_ValleyOfPrey_7c7f45a7:

    # MC "Hey, how are we going to carry this damn thing back now?"
    MC "Oye, ¿cómo vamos a llevar esta maldita cosa de vuelta ahora?"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:153
translate es qst_ValleyOfPrey_91a4bf23:

    # "Ves looked at me and smiled."
    "Ves me miró y sonrió."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:154
translate es qst_ValleyOfPrey_5a09e725:

    # MC "... Oh no."
    MC "...Oh no."
