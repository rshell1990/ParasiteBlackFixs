

# game/data/world_romance/arlena/intro_doggy.rpy:2
translate es rom_ArlenaIntroDoggy_f6e99e92:

    # "The door opened inch by inch as Arlena’s face peeped surreptitiously through the gap."
    "La puerta se abrió centímetro a centímetro mientras el rostro de Arlena asomaba subrepticiamente por el hueco."

# game/data/world_romance/arlena/intro_doggy.rpy:3
translate es rom_ArlenaIntroDoggy_47123286:

    # "She averted her gaze as the air touched her rosy cheeks."
    "Desvió la mirada cuando el aire tocó sus mejillas sonrosadas."

# game/data/world_romance/arlena/intro_doggy.rpy:4
translate es rom_ArlenaIntroDoggy_c41453c7:

    # MC @ talk "Arlena? Is everything alright?"
    MC @ talk "¿Arlena? ¿Va todo bien?"

# game/data/world_romance/arlena/intro_doggy.rpy:5
translate es rom_ArlenaIntroDoggy_250c2268:

    # ARLENA "Yes, just give me a moment..."
    ARLENA "Sí, solo dame un momento..."

# game/data/world_romance/arlena/intro_doggy.rpy:12
translate es rom_ArlenaIntroDoggy_2b255700:

    # "She sealed the door shut for a moment before opening it fully to allow me to inspect what was on the other side."
    "Cerró la puerta un momento antes de abrirla del todo para permitirme inspeccionar lo que había al otro lado."

# game/data/world_romance/arlena/intro_doggy.rpy:13
translate es rom_ArlenaIntroDoggy_f160d8e1:

    # "Arlena smiled, wrapped in a warm furry blanket that hung off her bare shoulders."
    "Arlena sonrió, envuelta en una cálida manta peluda que le colgaba de los hombros desnudos."

# game/data/world_romance/arlena/intro_doggy.rpy:14
translate es rom_ArlenaIntroDoggy_17cf5076:

    # "I had to tear my eyes away from the cute little mole on her collar bone, wanting nothing more than to reach out and touch her."
    "Tuve que apartar los ojos del bonito lunar que tenía en la clavícula, sin querer otra cosa que estirar la mano y tocarla."

# game/data/world_romance/arlena/intro_doggy.rpy:15
translate es rom_ArlenaIntroDoggy_dfb9c9c2:

    # "She had placed various candles around the room, illuminating it with a warm, soft kind of light."
    "Había colocado varias velas por la habitación, iluminándola con una luz cálida y suave."

# game/data/world_romance/arlena/intro_doggy.rpy:16
translate es rom_ArlenaIntroDoggy_8a2997f2:

    # "Placed on the floor was a small white blanket, keenly laid out with a few pieces of food she had managed to pull together in a wooden bowl."
    "Colocada en el suelo había una pequeña manta blanca, muy bien tendida, con algunos trozos de comida que había conseguido reunir en un cuenco de madera."

# game/data/world_romance/arlena/intro_doggy.rpy:17
translate es rom_ArlenaIntroDoggy_0f98a9a9:

    # "Sat beside it was a half empty bottle of wine with two glasses already poured out waiting for us."
    "A su lado había una botella de vino medio vacía con dos copas ya servidas esperándonos."

# game/data/world_romance/arlena/intro_doggy.rpy:18
translate es rom_ArlenaIntroDoggy_360d119a:

