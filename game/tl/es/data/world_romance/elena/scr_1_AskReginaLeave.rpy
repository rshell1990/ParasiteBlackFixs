translate es rom_Elena_AskReginaLeave_58644b50:

    # ELENA @ talk "[player_name!t]... I hear everything in this house no matter where I am."
    ELENA @ talk "[player_name!t]...  En esta casa lo oigo todo, esté donde esté."

# game/data/world_romance/elena/scr_1_AskReginaLeave.rpy:27
translate es rom_Elena_AskReginaLeave_b0571f9e:

    # "Elena stood awkwardly for a moment, her cheeks flushed red as she tapped her foot on the floor."
    "Elena se quedó de pie un momento, con las mejillas sonrojadas mientras golpeaba el suelo con el pie."

# game/data/world_romance/elena/scr_1_AskReginaLeave.rpy:28
translate es rom_Elena_AskReginaLeave_ea062dee:

    # ELENA @ lewd "Would... Would you like to join me?"
    ELENA @ lewd "Te... ¿Te gustaría acompañarme?"

# game/data/world_romance/elena/scr_1_AskReginaLeave.rpy:29
translate es rom_Elena_AskReginaLeave_a176de60:

    # ELENA @ shock "I mean, you {i}don't{/i} have to of course!"
    ELENA @ shock "Quiero decir, ¡{i}no{/i} tienes que hacerlo, por supuesto!"

# game/data/world_romance/elena/scr_1_AskReginaLeave.rpy:30
translate es rom_Elena_AskReginaLeave_a1498c20:

    # ELENA @ lewd "I'm just thinking perhaps it would be a waste for me to go to such efforts pouring all the water and n-not let you take advantage of it is as well."
    ELENA @ lewd "Solo estoy pensando que tal vez sería un desperdicio para mí ir a tales esfuerzos verter toda el agua y n-no dejar que aproveches también."

# game/data/world_romance/elena/scr_1_AskReginaLeave.rpy:31
translate es rom_Elena_AskReginaLeave_f0b2435c:

    # "Her flushed expression gives away her real intentions, and her cute comments trying to mask her feelings warms my heart a little."
    "Su expresión sonrojada delata sus verdaderas intenciones, y sus simpáticos comentarios tratando de enmascarar sus sentimientos me calientan un poco el corazón."

