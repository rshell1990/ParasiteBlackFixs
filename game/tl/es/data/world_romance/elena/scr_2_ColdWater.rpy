

# game/data/world_romance/elena/scr_2_ColdWater.rpy:2
translate es rom_Elena_WaterCold_910e6556:

    # "Elena's eyes seemed to dim slightly, her whole body slumping slightly as she awkwardly looked away in rejection."
    "Los ojos de Elena parecieron apagarse ligeramente, todo su cuerpo se desplomó un poco mientras miraba torpemente hacia otro lado en señal de rechazo."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:3
translate es rom_Elena_WaterCold_c080e665:

    # ELENA @ sad "Oh..."
    ELENA @ sad "Oh..."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:4
translate es rom_Elena_WaterCold_3f64276b:

    # ELENA @ sad "I understand."
    ELENA @ sad "Entiendo."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:5
translate es rom_Elena_WaterCold_677657a2:

    # ELENA @ grumpy "Umm, I shall be out shortly."
    ELENA @ grumpy "Umm, saldré en breve."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:6
translate es rom_Elena_WaterCold_4a80105f:

    # "With that Elena headed into [regina_ref!t]'s room, where I heard the continuous pouring of water."
    "Con eso Elena se dirigió a la habitación de [regina_ref!t], donde oí el continuo sonido del agua al caer."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:8
translate es rom_Elena_WaterCold_655f0d8d:

    # MC "(Hm... Perhaps I need to set some boundaries with Elena.)"
    MC "(Hm... Tal vez tenga que establecer algunos límites con Elena)."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:9
translate es rom_Elena_WaterCold_ad9ecaac:

    # MC "(That is... {i}If I want boundaries{/i}.)"
    MC "(Es decir... {i}Si quiero límites{/i})."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:10
translate es rom_Elena_WaterCold_1b9393e6:

    # "A short while later, a mostly dried off Elena re-emerged."
    "Poco después, una Elena casi seca volvió a aparecer."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:12
translate es rom_Elena_WaterCold_0517ef7d:

    # ELENA @ talk "Thank you for that [player_name!t]."
    ELENA @ talk "Gracias por eso [player_name!t]."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:15
translate es rom_Elena_WaterCold_7969e85b:

    # ELENA @ talk "I'll go back to reading my book now..."
    ELENA @ talk "Volveré a leer mi libro ahora..."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:18
translate es rom_Elena_WaterCold_f3d00ea3:

    # "Elena turned to look at me."
    "Elena se giró para mirarme."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:19
translate es rom_Elena_WaterCold_7ff7020e:

    # ELENA @ sad "Huh?"
    ELENA @ sad "¿Eh?"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:20
translate es rom_Elena_WaterCold_2eb3c81d:

    # "Suddenly moving forward, I placed my lips onto Elena's."
    "Avanzando de repente, posé mis labios sobre los de Elena."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:25
translate es rom_Elena_WaterCold_76d2e5b5:

    # "Elena's eyes widened in shock as her cheeks blushed."
    "Los ojos de Elena se abrieron de golpe mientras sus mejillas se sonrojaban."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:26
translate es rom_Elena_WaterCold_c8c3718c:

    # ELENA "Mhmm?!"
    ELENA "¡¿Mhmm?!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:27
translate es rom_Elena_WaterCold_18a0bdb6:

    # "Pulling back from her, Elena broke free from my grasp."
    "Apartándome de ella, Elena se soltó de mi agarre."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:36
translate es rom_Elena_WaterCold_c796d455:

    # ELENA @ shock "You... Why did you do that?!"
    ELENA @ shock "Tú... ¡¿Por qué hiciste eso?!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:37
translate es rom_Elena_WaterCold_094a4ea1:

    # MC @ talk "Because I wanted to."
    MC @ talk "Porque quería."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:38
translate es rom_Elena_WaterCold_9c527a87:

    # ELENA @ lewd "You... I don't understand."
    ELENA @ lewd "Tú... no lo entiendo."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:39
translate es rom_Elena_WaterCold_f9d3a2cc:

    # ELENA @ shock "You... You didn't join me earlier!"
    ELENA @ shock "Tú... ¡No te uniste a mí antes!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:40
translate es rom_Elena_WaterCold_9265b8e8:

    # ELENA @ grumpy "I... I thought..."
    ELENA @ grumpy "Yo... Pensé..."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:41
translate es rom_Elena_WaterCold_b5da0c33:

    # "Elena shook her head and hurried off into my room, slamming the door behind her."
    "Elena sacudió la cabeza y se apresuró a entrar en mi habitación, cerrando la puerta tras de sí."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:44
translate es rom_Elena_WaterCold_afac7bab:

    # MC "Elena!"
    MC "¡Elena!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:45
translate es rom_Elena_WaterCold_30b61dcd:

    # ELENA "Leave me alone!"
    ELENA "¡Déjame en paz!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:46
translate es rom_Elena_WaterCold_3835623a:

    # MC @ sad "(What was I thinking?)"
    MC @ sad "(¿En qué estaba pensando?)"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:47
translate es rom_Elena_WaterCold_ac01335d:

    # MC @ sad "(Now I've just given her mixed messages... Damn it, I really need to make my mind up on what {i}we{/i} are.)"
    MC @ sad "(Ahora acabo de darle mensajes contradictorios... Maldición, necesito decidirme sobre lo que {i}somos{/i})."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:56
translate es rom_Elena_WaterCold_e23bd047:

    # ELENA @ talk "Mmm, will do."
    ELENA @ talk "Mmm, lo haré."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:57
translate es rom_Elena_WaterCold_758614c4:

    # "Elena gently closed the door to my room behind her."
    "Elena cerró suavemente la puerta de mi habitación tras de sí."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:58
translate es rom_Elena_WaterCold_078472d4:

    # MC "(Yes, it's best not to over-complicate things.)"
    MC "(Sí, es mejor no complicar demasiado las cosas)."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:59
translate es rom_Elena_WaterCold_2c027692:

    # MC "(Remaining just friends and allies is the best course... for the both of us.)"
    MC "(Seguir siendo solo amigos y aliados es lo mejor... para los dos)."

translate es strings:

    # game/data/world_romance/elena/scr_2_ColdWater.rpy:16
    old "Elena, wait!"
    new "¡Elena, espera!"

    # game/data/world_romance/elena/scr_2_ColdWater.rpy:16
    old "{image=[ICON.HEART_CROSS]} Enjoy your book, Elena."
    new "{image=[ICON.HEART_CROSS]} Disfruta de tu libro, Elena."
