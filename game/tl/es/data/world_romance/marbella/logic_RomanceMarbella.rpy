    new "¿Podrías forjarme un anillo sencillo?"

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:433
    old "Do you have any bottles of wine?"
    new "¿Tienes alguna botella de vino?"

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:439
    old "I've come to spend some time with my beloved, of course."
    new "He venido a pasar un rato con mi amada, por supuesto."
