    old "About that creature..."
    new "En cuanto a esa criatura..."

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:403
    old "Do you have a supply package for me?"
    new "¿Tienes un paquete con provisiones para mí?"

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:408
    old "A new guard should be here soon..."
    new "Pronto debería llegar un nuevo guardia..."

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:410
    old "About that plan of yours..."
    new "En cuanto a ese plan tuyo..."

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:413
    old "I found a good tailor..."
    new "He encontrado una buena sastre..."

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:415
    old "About that wedding dress..."
    new "En cuanto al vestido de novia..."

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:420
    old "Do you sell any flowers perhaps?"
    new "¿Por casualidad vendes flores?"

    # game/data/world_romance/marbella/logic_RomanceMarbella.rpy:424
    old "About that ring..."
    new "En cuanto a ese anillo..."

