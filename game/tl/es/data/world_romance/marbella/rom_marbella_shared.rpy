

# game/data/world_romance/marbella/rom_marbella_shared.rpy:7
translate es rom_marbella_shared_the_face_7af6f9a4:

    # SHYAHTAN "(I have its scent.)"
    SHYAHTAN "(Tengo su olor)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:8
translate es rom_marbella_shared_the_face_049df98c:

    # MC @ think "(You mean whatever's killing the Khazah?)"
    MC @ think "(¿Te refieres a lo que sea que esté matando a los khazah?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:9
translate es rom_marbella_shared_the_face_6b394e0f:

    # SHYAHTAN "(We can pursue it... should you wish.)"
    SHYAHTAN "(Podemos seguirla... si quieres)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:11
translate es rom_marbella_shared_the_face_7af6f9a4_1:

    # SHYAHTAN "(I have its scent.)"
    SHYAHTAN "(Tengo su olor)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:12
translate es rom_marbella_shared_the_face_d1649a6b:

    # SHYAHTAN "(We should pursue.)"
    SHYAHTAN "(Deberíamos perseguirla)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:18
translate es rom_marbella_shared_the_face_4c5cd0e2:

    # SHYAHTAN "(The creature will return to hunt another night, no doubt...)"
    SHYAHTAN "(La criatura regresará a cazar otra noche, sin duda...)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:25
translate es rom_marbella_shared_the_face_68b0d87d:

    # "The scent was thick with heavy blood. Had the creature found a victim?"
    "El olor era denso, impregnado de sangre. ¿Había encontrado la criatura una víctima?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:26
translate es rom_marbella_shared_the_face_adb713b3:

    # "What even was it?"
    "¿Qué era eso?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:30
translate es rom_marbella_shared_the_face_e49976b9:

    # "Down the dark alleyways, kicking up cold sand, I turned a corner to see... {i}it.{/i}"
    "Por los callejones oscuros, levantando arena fría, doblé una esquina para ver... {i}eso.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:31
translate es rom_marbella_shared_the_face_c9566933:

    # "A woman — a prostitute — pressing a man up against a wall."
    "Una mujer, una prostituta, presionando a un hombre contra una pared."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:32
translate es rom_marbella_shared_the_face_2c12ecca:

    # "Her red lips were pressed to his throat, his eyes rolled back, his face deathly white."
    "Sus labios rojos estaban presionados contra su garganta, sus ojos se pusieron en blanco, su rostro estaba pálido como la muerte."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:33
translate es rom_marbella_shared_the_face_1bcca6ca:

    # "The creature snapped her neck toward me, revealing the huge, gaping wound in the man's neck and the blood splattered around her mouth."
    "La criatura giró bruscamente el cuello hacia mí, dejando al descubierto la enorme y abierta herida en el cuello del hombre y la sangre salpicada alrededor de su boca."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:34
translate es rom_marbella_shared_the_face_a2c1a49b:

    # "Her eyes glowed yellow as she inched closer, taking in a deep inhale."
    "Sus ojos brillaron de color amarillo mientras se acercaba lentamente, inhalando profundamente."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:35
translate es rom_marbella_shared_the_face_a9c43efc:

    # "Before I knew it, the fleshy skin of the woman dropped to the floor as though it was a suit... her severed head rolling along the floor."
    "Antes de darme cuenta, la piel carnosa de la mujer cayó al suelo como si fuera un traje... su cabeza cercenada rodando por el suelo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:36
translate es rom_marbella_shared_the_face_29b36423:

    # "The creature... The real creature, perhaps sensing something was {i}different{/i} about me too,"
    "La criatura... La criatura real, tal vez sintiendo que algo era {i}diferente{/i} en mí también,"
# game/data/world_romance/marbella/rom_marbella_shared.rpy:37
translate es rom_marbella_shared_the_face_05e13833:

    # "appeared before me in all it's hideous, terror."
    "apareció ante mí en todo su horrendo terror."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:42
translate es rom_marbella_shared_the_face_a857fd35:

    # THE_FACE "You're not human."
    THE_FACE "No eres humano."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:43
translate es rom_marbella_shared_the_face_1c4ec264:

    # THE_FACE "At least not fully... Who are you?"
    THE_FACE "Al menos no del todo... ¿Quién eres?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:44
translate es rom_marbella_shared_the_face_a7e9b266:

    # THE_FACE "{i}... What are you?{/i}"
    THE_FACE "{i}... ¿Qué eres?{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:49
translate es rom_marbella_shared_the_face_menu_c6af2dbb:

    # "The creature grinned."
    "La criatura sonrió."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:50
translate es rom_marbella_shared_the_face_menu_19136f53:

    # THE_FACE "I'm you."
    THE_FACE "Yo soy tú."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:51
translate es rom_marbella_shared_the_face_menu_107c286b:

    # THE_FACE "I'm them."
    THE_FACE "Yo soy ellos."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:52
translate es rom_marbella_shared_the_face_menu_f9227432:

    # THE_FACE "I'm whatever face I wear."
    THE_FACE "Soy la cara que me pongo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:56
translate es rom_marbella_shared_the_face_menu_6dc791f0:

    # THE_FACE "Cheap imitations."
    THE_FACE "Imitaciones baratas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:57
translate es rom_marbella_shared_the_face_menu_1359da5a:

    # THE_FACE "Toys of the one called Zanarak."
    THE_FACE "Juguetes del llamado Zanarak."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:58
translate es rom_marbella_shared_the_face_menu_8268f71e:

    # "The face grinned."
    "La cara sonrió."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:59
translate es rom_marbella_shared_the_face_menu_00cbccde:

    # THE_FACE "We are older."
    THE_FACE "Nosotros somos más antiguos."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:60
translate es rom_marbella_shared_the_face_menu_0e779db2:

    # MC @ think "Is there many of you left?"
    MC @ think "¿Quedan muchos de vosotros?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:61
translate es rom_marbella_shared_the_face_menu_c2715630:

    # THE_FACE "I have not sensed another of my kind in over four-hundred years."
    THE_FACE "No he sentido a otro de mi especie en más de cuatrocientos años."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:62
translate es rom_marbella_shared_the_face_menu_7eff8b9b:

    # MC @ think "... Then maybe you're the last?"
    MC @ think "... Entonces, ¿tal vez eres el último?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:63
translate es rom_marbella_shared_the_face_menu_c6af2dbb_1:

    # "The creature grinned."
    "La criatura sonrió."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:64
translate es rom_marbella_shared_the_face_menu_ffd72ac8:

    # THE_FACE "{i}No.{/i}"
    THE_FACE "{i}No.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:70
translate es rom_marbella_shared_the_face_menu_87f6b424:

    # THE_FACE "And what do you want... [player_name!t]?"
    THE_FACE "¿Y qué quieres... [player_name!t]?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:72
translate es rom_marbella_shared_the_face_menu_9c9ec1b9:

    # SHYAHTAN "{i}To eat you.{/i}"
    SHYAHTAN "{i}Comerte.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:73
translate es rom_marbella_shared_the_face_menu_aa8b5630:

    # MC "(Gods be damned, man! Why would you blurt that out?!)"
    MC "(¡Malditos sean los dioses, hombre! ¿Por qué dijiste eso?!)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:74
translate es rom_marbella_shared_the_face_menu_f6e6be2e:

    # THE_FACE "... Interesting."
    THE_FACE "... Interesante."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:75
translate es rom_marbella_shared_the_face_menu_6c6fde8c:

    # THE_FACE "Then let me make you an offer."
    THE_FACE "Entonces déjame hacerte una oferta."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:76
translate es rom_marbella_shared_the_face_menu_e3946eb2:

    # THE_FACE "I will give you a piece to eat if you leave me alone."
    THE_FACE "Te daré un trozo para comer si me dejas en paz."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:77
translate es rom_marbella_shared_the_face_menu_1dacda77:

    # MC "... What?"
    MC "... ¿Qué?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:78
translate es rom_marbella_shared_the_face_menu_692a2e7d:

    # MC "(This thing is unnerving as all seven hells.)"
    MC "(Esta cosa es inquietante como los siete infiernos)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:79
translate es rom_marbella_shared_the_face_menu_2c2b6b44:

    # MC "(Should we take its offer?)"
    MC "(¿Deberíamos aceptar su oferta?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:80
translate es rom_marbella_shared_the_face_menu_2643f325:

    # MC "(Will a piece of it be enough?)"
    MC "(¿Será suficiente con una parte?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:81
translate es rom_marbella_shared_the_face_menu_ead25a14:

    # SHYAHTAN "(Yes.)"
    SHYAHTAN "(Sí)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:82
translate es rom_marbella_shared_the_face_menu_7bd068a0:

    # "My eyes drifted toward the poor bastard the creature was devouring."
    "Mis ojos se desviaron hacia el pobre desgraciado al que la criatura estaba devorando."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:83
translate es rom_marbella_shared_the_face_menu_6db09147:

    # SHYAHTAN "(That is, if you are fine with letting this creature continue what it's doing...)"
    SHYAHTAN "(Eso es, si no te importa dejar que esta criatura continúe con lo que está haciendo...)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:86
translate es rom_marbella_shared_the_face_menu_b2b6d0b3:

    # MC @ talk "You to leave this city."
    MC @ talk "Debes abandonar esta ciudad."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:87
translate es rom_marbella_shared_the_face_menu_cb4efca3:

    # THE_FACE "And why would I do that?"
    THE_FACE "¿Y por qué haría yo eso?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:88
translate es rom_marbella_shared_the_face_menu_3c3b1657:

    # MC @ talk "You've preyed on the wrong people. They sent me to deal with you, one way or another."
    MC @ talk "Te has metido con la gente equivocada. Me enviaron para que me ocupara de ti, de una forma u otra."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:89
translate es rom_marbella_shared_the_face_menu_2e8c2376:

    # THE_FACE "And why should I not just kill you... and then kill them?"
    THE_FACE "¿Y por qué no debería matarte ... y luego matarlos a ellos?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:90
translate es rom_marbella_shared_the_face_menu_1bf20a23:

    # THE_FACE "I rather like this hunting ground."
    THE_FACE "Me gusta bastante este terreno de caza."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:96
translate es rom_marbella_shared_the_face_menu_ddd9a544:

    # THE_FACE "I can always find a new face to wear."
    THE_FACE "Siempre puedo encontrar una cara nueva que ponerme."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:97
translate es rom_marbella_shared_the_face_menu_bc03026e:

    # MC @ serious "But whatever the hells you are, you need to feed."
    MC @ serious "Pero seas lo que seas, necesitas alimentarte."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:98
translate es rom_marbella_shared_the_face_menu_ed137a9a:

    # MC @ think "The bodies are stacking up. It won't be long before the merchant lords hire inquisitors or someone worse."
    MC @ think "Los cuerpos se están acumulando.  No pasará mucho tiempo antes de que los lords mercaderes contraten inquisidores o algo peor."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:99
translate es rom_marbella_shared_the_face_menu_6755aa3d:

    # MC @ talk "Then it's only a matter of time."
    MC @ talk "Entonces es solo cuestión de tiempo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:100
translate es rom_marbella_shared_the_face_menu_4867ba98:

    # "The creature seemed to contemplate my words."
    "La criatura pareció contemplar mis palabras."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:101
translate es rom_marbella_shared_the_face_menu_b2c0a385:

    # THE_FACE "... Hm."
    THE_FACE "... Hm."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:102
translate es rom_marbella_shared_the_face_menu_63f5e52d:

    # THE_FACE "Perhaps it is time I found a new hunting ground."
    THE_FACE "Quizás sea hora de que encuentre un nuevo coto de caza."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:107
translate es rom_marbella_shared_the_face_menu_03235ba9:

    # "The creature grinned as it ripped off its arm and threw it toward me."
    "La criatura sonrió mientras se arrancaba el brazo y lo arrojaba hacia mí."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:108
translate es rom_marbella_shared_the_face_menu_5c574a52:

    # "Strange tendrils still writhed from the open flesh wound."
    "Extraños tentáculos aún se retorcían de la herida abierta en la carne."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:109
translate es rom_marbella_shared_the_face_menu_4e2c4d3e:

    # MC @ scared "... What. The. Fuck."
    MC @ scared "... Qué. Diablos."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:110
translate es rom_marbella_shared_the_face_menu_42ddfa67:

    # THE_FACE "A wise choice."
    THE_FACE "Una elección acertada."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:114
translate es rom_marbella_shared_the_face_menu_8761e6c2:

    # THE_FACE "... Wearing your skin is going to be fun."
    THE_FACE "... Usar tu piel va a ser divertido."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:118
translate es rom_marbella_shared_the_face_menu_7e6a4ecc:

    # "With a death rattle, the creature writhed on the ground in agony."
    "Con un estertor de muerte, la criatura se retorcía en el suelo, agonizando."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:119
translate es rom_marbella_shared_the_face_menu_cf5660e2:

    # "A pool of blood spread from its wounds until at last it lay still."
    "Un charco de sangre se extendió desde sus heridas hasta que finalmente quedó inmóvil."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:123
translate es rom_marbella_shared_the_face_menu_465c70d7:

    # MC @ scared "(... What in the hells was that?)"
    MC @ scared "(... ¿Qué demonios fue eso?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:126
translate es rom_marbella_shared_the_face_menu_7c9c4372:

    # SHYAHTAN "(Just another predator trying to survive.)"
    SHYAHTAN "(Otro depredador más intentando sobrevivir)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:127
translate es rom_marbella_shared_the_face_menu_1ba06388:

    # MC @ think "(Well... I should head back to the Khazah at least.)"
    MC @ think "(Bueno... al menos debería volver con los khazah)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:129
translate es rom_marbella_shared_the_face_menu_aeebd902:

    # SHYAHTAN "(Food.)"
    SHYAHTAN "(Alimento)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:130
translate es rom_marbella_shared_the_face_menu_79ad5e9a:

    # MC @ angry "(Is that really all you can think about?!)"
    MC @ angry "(¡¿En serio solo puedes pensar en eso?!)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:131
translate es rom_marbella_shared_the_face_menu_261fccd8:

    # "I felt my own hand fight against me, rising toward the creature's body."
    "Sentí mi propia mano luchar contra mí, elevándose hacia el cuerpo de la criatura."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:132
translate es rom_marbella_shared_the_face_menu_647fb08d:

    # "Black tendrils pushed out, wrapping around and inspecting the corpse."
    "Tentáculos negros se extendieron, envolviendo e inspeccionando el cadáver."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:133
translate es rom_marbella_shared_the_face_menu_b4187bec:

    # "Suddenly, one of the tendrils pierced the flesh, draining it until, within moments, it became a withered husk."
    "De repente, uno de los tentáculos perforó la carne, drenándola hasta que, en cuestión de momentos, se convirtió en una cáscara marchita."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:134
translate es rom_marbella_shared_the_face_menu_4aea6492:

    # MC @ talk "Uhh, you got what you needed?"
    MC @ talk "Uhh, ¿conseguiste lo que necesitabas?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:135
translate es rom_marbella_shared_the_face_menu_a240a5ea:

    # SHYAHTAN "Yes."
    SHYAHTAN "Sí."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:136
translate es rom_marbella_shared_the_face_menu_9f7a6c71:

    # SHYAHTAN "Now we can return to our mate tomorrow."
    SHYAHTAN "Ahora podemos volver con nuestra compañera mañana."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:137
translate es rom_marbella_shared_the_face_menu_56c9cbc1:

    # MC "Right..."
    MC "Cierto..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:142
translate es rom_marbella_shared_the_face_negotiate_0909f5b7:

    # "To my horror, I watched as the creature made short work of the man, stuffing it's face with his inards before turning it's gaze back towards the lifeless body of the woman."
    "Para mi horror, vi cómo la criatura acababa rápidamente con el hombre, atiborrándose de sus entrañas antes de volver la mirada hacia el cuerpo sin vida de la mujer."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:143
translate es rom_marbella_shared_the_face_negotiate_03091605:

    # "Clambering back inside of her, the skin stretching over the flesh unnaturally, and then, it began to settle over the the strange creature's body as it contorted itself into shape."
    "Al volver a introducirse en su interior, la piel se estiró sobre la carne de forma antinatural y, entonces, comenzó a asentarse sobre el cuerpo de la extraña criatura mientras se retorcía para tomar forma."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:144
translate es rom_marbella_shared_the_face_negotiate_c2f1fa26:

    # "Bones breaking and snapping into place as the creature shrink, fitting itself inside of her."
    "Los huesos se rompían y encajaban en su sitio a medida que la criatura se encogía, acomodándose dentro de ella."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:145
translate es rom_marbella_shared_the_face_negotiate_98122aeb:

    # "It grabbed the severed head, with tendrils protruding from the open wound of the neck and connected the head there, almost as if it was screwing the head back on."
    "Cogió la cabeza cercenada, con tentáculos que sobresalían de la herida abierta del cuello, y la conectó allí, casi como si la estuviera atornillando de nuevo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:146
translate es rom_marbella_shared_the_face_negotiate_76fbf04d:

    # "From the open wound where his head had been, the lifeless face moved once more."
    "Desde la herida abierta donde había estado su cabeza, el rostro sin vida se movió una vez más."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:147
translate es rom_marbella_shared_the_face_negotiate_1eda4053:

    # "In a few gory moments, sinew, flesh, and skin covered all wounds."
    "En unos instantes espantosos, tendones, carne y piel cubrieron todas las heridas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:148
translate es rom_marbella_shared_the_face_negotiate_80623e6a:

    # "The eyes opened."
    "Los ojos se abrieron."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:149
translate es rom_marbella_shared_the_face_negotiate_e7dbd68e:

    # "{i}It looked like a normal woman.{/i}"
    "{i}Parecía una mujer normal.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:154
translate es rom_marbella_shared_the_face_negotiate_da31ff86:

    # "It smiled at me."
    "Me sonrió."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:155
translate es rom_marbella_shared_the_face_negotiate_ce2bbed9:

    # THE_FACE @ smile "Now I take my leave."
    THE_FACE @ smile "Ahora me despido."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:156
translate es rom_marbella_shared_the_face_negotiate_de8d54d9:

    # THE_FACE @ smile "Perhaps we will meet again one day?"
    THE_FACE @ smile "¿Quizás nos volvamos a encontrar algún día?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:157
translate es rom_marbella_shared_the_face_negotiate_8129db98:

    # THE_FACE "You are..."
    THE_FACE "Eres..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:158
translate es rom_marbella_shared_the_face_negotiate_9aa8c348:

    # THE_FACE @ smile "{i}Interesting.{/i}"
    THE_FACE @ smile "{i}Interesante.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:159
translate es rom_marbella_shared_the_face_negotiate_6cc75be9:

    # MC @ talk "You never told me your name."
    MC @ talk "Nunca me dijiste tu nombre."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:160
translate es rom_marbella_shared_the_face_negotiate_259b0362:

    # "The creature grinned again, its eyes black as it bared razor-thin teeth."
    "La criatura volvió a sonreír, con los ojos negros mientras mostraba unos dientes afilados como navajas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:161
translate es rom_marbella_shared_the_face_negotiate_3070413d:

    # THE_FACE @ smile "I don't have a name... I just take them."
    THE_FACE @ smile "No tengo nombre ... Simplemente los tomo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:162
translate es rom_marbella_shared_the_face_negotiate_9266cbab:

    # THE_FACE "... People like to think when they're alone, they're safe."
    THE_FACE "... A la gente le gusta pensar que cuando está sola, está a salvo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:163
translate es rom_marbella_shared_the_face_negotiate_307da707:

    # "It stepped back, disappearing into the darkness."
    "Retrocedió, desapareciendo en la oscuridad."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:165
translate es rom_marbella_shared_the_face_negotiate_47aac664:

    # "The last thing I saw were its razor teeth and glowing yellow eyes."
    "Lo último que vi fueron sus dientes afilados como navajas y sus ojos amarillos brillantes."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:166
translate es rom_marbella_shared_the_face_negotiate_ba425c3c:

    # THE_FACE "{i}But we are waiting for them every night.{/i}"
    THE_FACE "{i}Pero los esperamos todas las noches.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:167
translate es rom_marbella_shared_the_face_negotiate_197a0fbf:

    # "And with that, it was gone."
    "Y con eso, desapareció."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:169
translate es rom_marbella_shared_the_face_negotiate_d9d519af:

    # MC @ scared "That... thing..."
    MC @ scared "Esa... cosa..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:170
translate es rom_marbella_shared_the_face_negotiate_307cc04c:

    # MC @ scared "How many of those things walk among us?"
    MC @ scared "¿Cuántas de esas cosas caminan entre nosotros?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:171
translate es rom_marbella_shared_the_face_negotiate_8dd99207:

    # SHYAHTAN "(In our travels, I have occasionally sensed their presence.)"
    SHYAHTAN "(En nuestros viajes, ocasionalmente he sentido su presencia)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:172
translate es rom_marbella_shared_the_face_negotiate_e51f39a9:

    # SHYAHTAN "(They are very few in number.)"
    SHYAHTAN "(Son muy pocos en número)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:173
translate es rom_marbella_shared_the_face_negotiate_de542541:

    # SHYAHTAN "({i}But they are out there...{/i})"
    SHYAHTAN "({i}Pero están ahí fuera...{/i})"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:174
translate es rom_marbella_shared_the_face_negotiate_e3faf380:

    # "Pushing the thought aside, I looked down at the severed arm and reached to pick it up."
    "Apartando ese pensamiento, miré el brazo amputado y extendí la mano para recogerlo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:176
translate es rom_marbella_shared_the_face_negotiate_f7b4d877:

    # MC @ think "(With that sorted, I should head back to the Khazah and let them know this won't be a problem anymore.)"
    MC @ think "(Con eso resuelto, debería volver con los khazah y avisarles que esto ya no será un problema)."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:178
translate es rom_marbella_shared_the_face_negotiate_71bd67e9:

    # "From my other hand, Shyahtan's black tendrils pushed out, wrapping around and inspecting the arm."
    "De mi otra mano, los tentáculos negros de Shyahtan se extendieron, envolviendo e inspeccionando el brazo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:179
translate es rom_marbella_shared_the_face_negotiate_b4187bec:

    # "Suddenly, one of the tendrils pierced the flesh, draining it until, within moments, it became a withered husk."
    "De repente, uno de los tentáculos perforó la carne, drenándola hasta que, en cuestión de momentos, se convirtió en una cáscara marchita."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:180
translate es rom_marbella_shared_the_face_negotiate_4aea6492:

    # MC @ talk "Uhh, you got what you needed?"
    MC @ talk "Uhh, ¿conseguiste lo que necesitabas?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:181
translate es rom_marbella_shared_the_face_negotiate_a240a5ea:

    # SHYAHTAN "Yes."
    SHYAHTAN "Sí."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:182
translate es rom_marbella_shared_the_face_negotiate_9f7a6c71:

    # SHYAHTAN "Now we can return to our mate tomorrow."
    SHYAHTAN "Ahora podemos volver con nuestra compañera mañana."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:183
translate es rom_marbella_shared_the_face_negotiate_7a5082fa:

    # MC "If you say so..."
    MC "Si tú lo dices..."

translate es strings:

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:47
    old "I could ask you the same thing."
    new "Podría preguntarte lo mismo."

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:54
    old "You... You remind me of the things I saw in Novaras during the siege."
    new "Tú...  Me recuerdas las cosas que vi en Novaras durante el asedio."

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:67
    old "I am [player_name!t]"
    new "Soy [player_name!t]"

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:95
    old "More will come... People are beginning to notice."
    new "Vendrán más... La gente está empezando a darse cuenta."

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:106
    old "Let the creature go."
    new "Deja que la criatura se vaya."

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:113
    old "Sorry, I can't let you hurt anyone else."
    new "Lo siento, no puedo dejar que hagas daño a nadie más."
