    "En cuanto entré en los vestíbulos, Mika, al percatarse de mi presencia, se acercó corriendo, con los ojos ansiosos y muy abiertos."

# game/data/world_romance/mika/preg_mika.rpy:54
translate es rom_mika_first_post_impreg_scene_8493a9be:

    # MIKA @ scared "W-We need to talk!"
    MIKA @ scared "¡T-tenemos que hablar!"

# game/data/world_romance/mika/preg_mika.rpy:55
translate es rom_mika_first_post_impreg_scene_404a3002:

    # MC @ think "Mika?"
    MC @ think "¿Mika?"

# game/data/world_romance/mika/preg_mika.rpy:56
translate es rom_mika_first_post_impreg_scene_5030e47d:

    # MC @ think "What is it?"
    MC @ think "¿Qué ocurre?"

# game/data/world_romance/mika/preg_mika.rpy:57
translate es rom_mika_first_post_impreg_scene_866157a7:

    # MIKA @ scared "I'm-"
    MIKA @ scared "Estoy-"

# game/data/world_romance/mika/preg_mika.rpy:59
translate es rom_mika_first_post_impreg_scene_a12eb898:

    # DIVINE @ happy "Why, blessed with a holy ordained child, of course!"
    DIVINE @ happy "¡Bendecida con un santo niño bendecido, por supuesto!"

# game/data/world_romance/mika/preg_mika.rpy:60
translate es rom_mika_first_post_impreg_scene_04dcc844:

    # MC @ surprised "W-What?!"
    MC @ surprised "¡¿Q-qué?!"

# game/data/world_romance/mika/preg_mika.rpy:61
translate es rom_mika_first_post_impreg_scene_dff2134b:

    # "I felt my heart slightly fall into my stomach with the words."
    "Sentí que el corazón se me encogía ligeramente en el estómago con esas palabras."

# game/data/world_romance/mika/preg_mika.rpy:62
translate es rom_mika_first_post_impreg_scene_63348ae9:

    # MC @ think "Mika, you're..."
    MC @ think "¿Mika, estás...?"

# game/data/world_romance/mika/preg_mika.rpy:63
translate es rom_mika_first_post_impreg_scene_10014e4a:

    # MC @ surprised "{i}Pregnant?{/i}"
    MC @ surprised "{i}¿Embarazada?{/i}"

# game/data/world_romance/mika/preg_mika.rpy:64
translate es rom_mika_first_post_impreg_scene_f4b84574:

    # MIKA @ blush "I..."
    MIKA @ blush "Yo..."

# game/data/world_romance/mika/preg_mika.rpy:65
translate es rom_mika_first_post_impreg_scene_e9ac678c:

    # MIKA @ blush "{i}Y-Yes.{/i}"
    MIKA @ blush "{i}S-sí.{/i}"

# game/data/world_romance/mika/preg_mika.rpy:66
translate es rom_mika_first_post_impreg_scene_3ebbebc0:

    # DIVINE @ happy "Of course, this {i}holy{/i} child is a blessing from Palam."
    DIVINE @ happy "Por supuesto, este {i}sagrado{/i} niño es una bendición de Palam."

# game/data/world_romance/mika/preg_mika.rpy:67
translate es rom_mika_first_post_impreg_scene_8ecad321:

    # DIVINE @ happy "Why, a {i}virgin birth,{/i} how wonderful!"
    DIVINE @ happy "¡Qué maravilla, un {i}nacimiento virginal{/i}!"

# game/data/world_romance/mika/preg_mika.rpy:68
translate es rom_mika_first_post_impreg_scene_a0182c6c:

    # "Mika opened her mouth to say something, but as Sister Divine snapped her a knowing look, she quickly averted her gaze."
    "Mika abrió la boca para decir algo, pero cuando la hermana Divine le lanzó una mirada cómplice, apartó rápidamente la mirada."

# game/data/world_romance/mika/preg_mika.rpy:71
translate es rom_mika_first_post_impreg_scene_ddd7ccc1:

    # DIVINE @ happy "You must forgive her, [player_name!t]."
    DIVINE @ happy "Debes perdonarla, [player_name!t]."

# game/data/world_romance/mika/preg_mika.rpy:70
translate es rom_mika_first_post_impreg_scene_9b12449d:

    # DIVINE @ angry "No doubt all reason has left her thanks to the goddess' blessing filling her womb."
    DIVINE @ angry "Sin duda, toda la razón la ha abandonado gracias a la bendición de la diosa que llena su vientre."

# game/data/world_romance/mika/preg_mika.rpy:71
translate es rom_mika_first_post_impreg_scene_52203584:

    # "Mika shyly continued to look away."
    "Mika siguió mirando tímidamente hacia otro lado."

# game/data/world_romance/mika/preg_mika.rpy:72
translate es rom_mika_first_post_impreg_scene_2524957b:

    # DIVINE @ happy "But I trust you can keep quiet about this... {i}miraclulous conception.{/i}"
    DIVINE @ happy "Pero confío en que puedas guardar silencio sobre esta... {i}concepción milagrosa.{/i}"

# game/data/world_romance/mika/preg_mika.rpy:73
translate es rom_mika_first_post_impreg_scene_41db3958:

    # DIVINE @ happy "We wouldn't want anyone to question the purity of our holy ordained mages, would we?"
    DIVINE @ happy "No querríamos que nadie cuestionara la pureza de nuestras santas magas ordenadas, ¿verdad?"

# game/data/world_romance/mika/preg_mika.rpy:74
translate es rom_mika_first_post_impreg_scene_268408e4:

    # MC @ talk "Of course... Sister, my lips are sealed."
    MC @ talk "Por supuesto... hermana, soy una tumba."

# game/data/world_romance/mika/preg_mika.rpy:75
translate es rom_mika_first_post_impreg_scene_8979052c:

    # "Seemingly satisfied with my answer, Sister Divine bowed gracefully before leaving."
    "Aparentemente satisfecha con mi respuesta, la hermana Divine hizo una elegante reverencia antes de marcharse."

# game/data/world_romance/mika/preg_mika.rpy:78
translate es rom_mika_first_post_impreg_scene_25b22225:

    # MIKA @ sad "I'm sorry about that..."
    MIKA @ sad "Lo siento mucho..."

# game/data/world_romance/mika/preg_mika.rpy:79
translate es rom_mika_first_post_impreg_scene_af0c5fd3:

    # MIKA @ sad "This isn't the first time something like this has happened with other girls."
    MIKA @ sad "No es la primera vez que ocurre algo así con otras chicas."

# game/data/world_romance/mika/preg_mika.rpy:80
translate es rom_mika_first_post_impreg_scene_076c04c6:

    # MC @ sad "Will I still be allowed to see the child?"
    MC @ sad "¿Podré seguir viendo al niño?"

# game/data/world_romance/mika/preg_mika.rpy:81
translate es rom_mika_first_post_impreg_scene_eadfcb05:

    # MIKA @ shock "I-If you want to!"
    MIKA @ shock "¡S-si quieres!"

# game/data/world_romance/mika/preg_mika.rpy:82
translate es rom_mika_first_post_impreg_scene_d312bea7:

    # "Mika seemed more surprised than anything that I'd want to still be involved with the child."
    "Mika parecía más sorprendida que otra cosa por el hecho de que yo quisiera seguir involucrado con el niño."

# game/data/world_romance/mika/preg_mika.rpy:83
translate es rom_mika_first_post_impreg_scene_81c5870a:

    # MIKA @ sad "But, there's no expectations for you... Between myself and the other mages of Palam, the child would be raised in one of the towers if they're born with the goddess' blessing."
    MIKA @ sad "Pero, no hay expectativas para ti... Entre las otras magas de Palam y yo, el niño será criado en una de las torres si nace con la bendición de la diosa."

# game/data/world_romance/mika/preg_mika.rpy:84
translate es rom_mika_first_post_impreg_scene_67db46b8:

    # MIKA @ talk "Y-You'd still be allowed to be involved in the child's life if you wish."
    MIKA @ talk "A-aún se te permitiría involucrarte en la vida del niño si lo deseas."

# game/data/world_romance/mika/preg_mika.rpy:85
translate es rom_mika_first_post_impreg_scene_3c837fa7:

    # MIKA @ talk "As l-long as you could keep the fact you're their father a secret."
    MIKA @ talk "Siempre y c-cuando puedas mantener en secreto que eres su padre."

# game/data/world_romance/mika/preg_mika.rpy:86
translate es rom_mika_first_post_impreg_scene_efbc1159:

    # MC @ surprised "I-"
    MC @ surprised "Yo-"

# game/data/world_romance/mika/preg_mika.rpy:87
translate es rom_mika_first_post_impreg_scene_8f291bb8:

    # MIKA @ shock "Y-You don't need to answer now..."
    MIKA @ shock "N-no hace falta que respondas ahora..."

# game/data/world_romance/mika/preg_mika.rpy:88
translate es rom_mika_first_post_impreg_scene_9523aff0:

    # MIKA @ smile "It's... alright, honestly."
    MIKA @ smile "Está... bien, de verdad."

# game/data/world_romance/mika/preg_mika.rpy:89
translate es rom_mika_first_post_impreg_scene_2e10b7d6:

    # MIKA @ talk "I c-can't ask you to stay here just for me."
    MIKA @ talk "No p-puedo pedirte que te quedes aquí solo por mí."

# game/data/world_romance/mika/preg_mika.rpy:90
translate es rom_mika_first_post_impreg_scene_70145710:

    # MIKA @ smile "B-But if {i}you want to...{/i}"
    MIKA @ smile "P-pero si {i}quieres...{/i}"

# game/data/world_romance/mika/preg_mika.rpy:91
translate es rom_mika_first_post_impreg_scene_7c054f36:

    # MIKA @ blush "{i}W-We{/i} can be a part of your life."
    MIKA @ blush "{i}P-podemos{/i} formar parte de tu vida."

# game/data/world_romance/mika/preg_mika.rpy:92
translate es rom_mika_first_post_impreg_scene_af5af2a1:

    # "As I reached out to touch Mika, whose heart was no doubt racing at her declaration, she quickly turned heel and hurried off."
    "Al alargar la mano para tocar a Mika, cuyo corazón se aceleró sin duda ante su declaración, se dio la vuelta rápidamente y se marchó a toda prisa."

# game/data/world_romance/mika/preg_mika.rpy:95
translate es rom_mika_first_post_impreg_scene_3c747424:

    # MC @ surprised "Mika!"
    MC @ surprised "¡Mika!"

# game/data/world_romance/mika/preg_mika.rpy:97
translate es rom_mika_first_post_impreg_scene_f672be65:

    # MC "(That girl...)"
    MC "(Esa chica...)"

# game/data/world_romance/mika/preg_mika.rpy:98
translate es rom_mika_first_post_impreg_scene_3991244b:

    # MC "(I might not be able to see her as much as I'd like, but I won't abandon her and our child!)"
    MC "(Puede que no pueda verla tanto como quisiera, ¡pero no la abandonaré ni a ella ni a nuestro hijo!)"

# game/data/world_romance/mika/preg_mika.rpy:99
translate es rom_mika_first_post_impreg_scene_6595b2ca:

    # MC "(It's so strange... I thought I might be more afraid; instead, all I feel is a surge of pride and...)"
    MC "(Es tan extraño... Pensé que tendría más miedo; en cambio, todo lo que siento es una oleada de orgullo y...)"

# game/data/world_romance/mika/preg_mika.rpy:100
translate es rom_mika_first_post_impreg_scene_74c38427:

    # MC "(Protectiveness.)"
    MC "(Protección)."

# game/data/world_romance/mika/preg_mika.rpy:101
translate es rom_mika_first_post_impreg_scene_69152bd2:

    # BLACK "({i}Our offspring must be protected.{/i})"
    BLACK "({i}Hay que proteger a nuestra descendencia{/i})."

# game/data/world_romance/mika/preg_mika.rpy:102
translate es rom_mika_first_post_impreg_scene_0f76f6b0:

    # BLACK "({i}I have made sure such doubts are removed from your mind... Our sired young are precious.{/i})"
    BLACK "({i}Me he asegurado de que esas dudas desaparezcan de tu mente... Nuestras crías son preciosas{/i})."

# game/data/world_romance/mika/preg_mika.rpy:103
translate es rom_mika_first_post_impreg_scene_0e7b0e47:

    # MC @ think "(You're the reason for that?)"
    MC @ think "(¿Tú eres la razón de eso?)"

# game/data/world_romance/mika/preg_mika.rpy:104
translate es rom_mika_first_post_impreg_scene_8b36f1a8:

    # BLACK "({i}It would not serve us well for you to fear creating our spawns... I ensure with every new one created, your mind is filled with serotonin and dopamine.{/i})"
    BLACK "{i}No nos serviría de nada que temieras crear nuestros engendros... Me aseguro de que con cada nueva creación, tu mente se llene de serotonina y dopamina{/i})."

# game/data/world_romance/mika/preg_mika.rpy:105
translate es rom_mika_first_post_impreg_scene_64e6bda4:

    # MC @ think "(Sero- what?)"
    MC @ think "(¿Sero- qué?)"

# game/data/world_romance/mika/preg_mika.rpy:106
translate es rom_mika_first_post_impreg_scene_b8468052:

    # MC @ serious "(Is this some kind of sorcery you speak of?)"
    MC @ serious "(¿Es algún tipo de brujería de la que hablas?)"

# game/data/world_romance/mika/preg_mika.rpy:108
translate es rom_mika_first_post_impreg_scene_90f3ed05:

    # BLACK "({i}No sorcery, only biology.{/i})"
    BLACK "({i}Nada de brujería, solo biología.{/i})."

# game/data/world_romance/mika/preg_mika.rpy:108
translate es rom_mika_first_post_impreg_scene_f35300e1:

    # BLACK "({i}Relax... You and I are one in the same.{/i})"
    BLACK "({i}Relájate... Tú y yo estamos en la misma{/i}).  "

# game/data/world_romance/mika/preg_mika.rpy:109
translate es rom_mika_first_post_impreg_scene_52059e1f:

    # BLACK "({i}Whatever I do, is for our benefit.{/i})"
    BLACK "({i}Todo lo que hago es por nuestro beneficio{/i})."

# game/data/world_romance/mika/preg_mika.rpy:110
translate es rom_mika_first_post_impreg_scene_001dee26:

    # "I can't say I particularly always trusted the intent of the strange, dark passenger inside my mind."
    "No puedo decir que siempre me haya fiado especialmente de la intención del extraño y oscuro pasajero dentro de mi mente."

# game/data/world_romance/mika/preg_mika.rpy:111
translate es rom_mika_first_post_impreg_scene_017bd3b4:

    # "But if there was one thing I could trust, it was the obsessive nature over 'breeding' the voice inside me had."
    "Pero si había algo en lo que podía confiar, era en el carácter obsesivo por la 'reproducción' que tenía la voz en mi interior."

# game/data/world_romance/mika/preg_mika.rpy:112
translate es rom_mika_first_post_impreg_scene_fea06f6f:

    # MC "(How many young exactly do you expect me to sire?)"
    MC "(¿Cuántas criaturas esperas exactamente que engendre?)"

# game/data/world_romance/mika/preg_mika.rpy:113
translate es rom_mika_first_post_impreg_scene_e473a079:

    # MC "(...Hello?)"
    MC "(...¿Hola?)"

# game/data/world_romance/mika/preg_mika.rpy:114
translate es rom_mika_first_post_impreg_scene_345f8548:

    # MC "(Hmph... I suppose that answers that then.)"
    MC "(Hmph... Supongo que eso responde a mi pregunta)."

# game/data/world_romance/mika/preg_mika.rpy:122
translate es rom_mika_first_post_birth_scene_bad16d95:

    # "Entering into the great halls of the tower of Palam, alerted to my presence, Sister Divine came hurrying over."
    "Al entrar en los grandes vestíbulos de la torre de Palam, alertada de mi presencia, la hermana Divine se acercó apresuradamente."

# game/data/world_romance/mika/preg_mika.rpy:123
translate es rom_mika_first_post_birth_scene_0692a380:

    # DIVINE @ talk "Come with me."
    DIVINE @ talk "Ven conmigo."

# game/data/world_romance/mika/preg_mika.rpy:124
translate es rom_mika_first_post_birth_scene_c047edf6:

    # MC @ think "Sister?"
    MC @ think "¿Hermana?"

# game/data/world_romance/mika/preg_mika.rpy:125
translate es rom_mika_first_post_birth_scene_da42dc57:

    # DIVINE @ talk "Follow..."
    DIVINE @ talk "Sígueme..."

# game/data/world_romance/mika/preg_mika.rpy:126
translate es rom_mika_first_post_birth_scene_f5a1c246:

    # "Leading me down the winding paths and hallways, Divine led me straight towards the girls' quarters, where Mika stood proudly, nursing a small, gurgling, blue baby in her arms."
    "Guiándome por los sinuosos caminos y pasillos, Divine me condujo directamente hacia los aposentos de las chicas, donde Mika estaba de pie, orgullosa, amamantando a un pequeño bebé azul que balbuceaba en sus brazos."

# game/data/world_romance/mika/preg_mika.rpy:134
translate es rom_mika_first_post_birth_scene_001d5deb:

    # MIKA @ smile "Hush now, little one..."
    MIKA @ smile "Calla, pequeña..."

# game/data/world_romance/mika/preg_mika.rpy:135
translate es rom_mika_first_post_birth_scene_9375a217:

    # MIKA @ smile "D-Daddy is here."
    MIKA @ smile "P-papi está aquí."

# game/data/world_romance/mika/preg_mika.rpy:136
translate es rom_mika_first_post_birth_scene_a59cc2d3:

    # "I felt the shortness of my breath as I nervously approached the two of them."
    "Sentí que me faltaba el aire mientras me acercaba nerviosamente a las dos."

# game/data/world_romance/mika/preg_mika.rpy:137
translate es rom_mika_first_post_birth_scene_6f877ae5:

    # "Seeing my... {i}our{/i} child in her arms."
    "Ver a mi... {i}nuestra{/i} hija en sus brazos."

# game/data/world_romance/mika/preg_mika.rpy:138
translate es rom_mika_first_post_birth_scene_d7dc6da3:

    # "The feeling was overwhelming."
    "La sensación era abrumadora."

# game/data/world_romance/mika/preg_mika.rpy:139
translate es rom_mika_first_post_birth_scene_cde0bbce:

    # MIKA @ blush "S-She has the blessing."
    MIKA @ blush "T-tiene la bendición."

# game/data/world_romance/mika/preg_mika.rpy:140
translate es rom_mika_first_post_birth_scene_f05bb023:

    # MIKA @ blush "She's a mage of Palam."
    MIKA @ blush "Es una maga de Palam."

# game/data/world_romance/mika/preg_mika.rpy:141
translate es rom_mika_first_post_birth_scene_1516e22a:

    # "As I reached out, one of the small hands of {i}our{/i} baby reached out, ever so gently wrapping around my finger."
    "Cuando extendí la mano, una de las pequeñas manos de {i}nuestro{/i} bebé me rodeó el dedo con tanta suavidad."

# game/data/world_romance/mika/preg_mika.rpy:142
translate es rom_mika_first_post_birth_scene_ba119603:

    # MIKA @ blush "{i}S-She likes you.{/i}"
    MIKA @ blush "{i}A e-ella le gustas.{/i}"

# game/data/world_romance/mika/preg_mika.rpy:143
translate es rom_mika_first_post_birth_scene_4ec9e531:

    # "Sister Divine stood vanguard over the scene, and while she tried to remain somewhat stoic and pragmatic about the whole thing, her lips curled ever so slightly into a soft smile."
    "La hermana Divine se puso al frente de la escena y, aunque trató de mantenerse estoica y pragmática, sus labios se curvaron ligeramente en una suave sonrisa."

# game/data/world_romance/mika/preg_mika.rpy:144
translate es rom_mika_first_post_birth_scene_6bed4c10:

    # DIVINE @ happy "You should pick a name for her."
    DIVINE @ happy "Deberías escoger un nombre para ella."

# game/data/world_romance/mika/preg_mika.rpy:145
translate es rom_mika_first_post_birth_scene_3404d621:

    # MIKA @ shock "I - I haven't even thought about names!"
    MIKA @ shock "Ni - ¡Ni siquiera he pensado en nombres!"

# game/data/world_romance/mika/preg_mika.rpy:146
translate es rom_mika_first_post_birth_scene_0d32f532:

    # MIKA @ blush "D-Do you have any ideas?"
    MIKA @ blush "¿T-tienes alguna idea?"

# game/data/world_romance/mika/preg_mika.rpy:148
translate es rom_mika_first_post_birth_scene_4c19876c:

    # MIKA @ smile "Hmm... I like it."
    MIKA @ smile "Hmm... Me gusta."

# game/data/world_romance/mika/preg_mika.rpy:149
translate es rom_mika_first_post_birth_scene_d2a754f2:

    # DIVINE @ talk "You should rest now, Mika."
    DIVINE @ talk "Deberías descansar, Mika."

# game/data/world_romance/mika/preg_mika.rpy:150
translate es rom_mika_first_post_birth_scene_02c18156:

    # MIKA @ smile "Mm, yes... Rest sounds good."
    MIKA @ smile "Mm, sí... Descansar suena bien."

# game/data/world_romance/mika/preg_mika.rpy:151
translate es rom_mika_first_post_birth_scene_53ba2be1:

    # MIKA @ smile "C-Come see us soon."
    MIKA @ smile "V-ven a vernos pronto."

# game/data/world_romance/mika/preg_mika.rpy:152
translate es rom_mika_first_post_birth_scene_35dec9f8:

    # MIKA @ smile "{i}... My love.{/i}"
    MIKA @ smile "{i}... Mi amor.{/i}"

# game/data/world_romance/mika/preg_mika.rpy:153
translate es rom_mika_first_post_birth_scene_1718897b:

    # "Just saying those words made Mika's cheeks burn red from embarrassment, but after a gentle kiss on her soft lips and the child's forehead, I stepped back, escorted out by Sister Divine."
    "Solo decir esas palabras hizo que las mejillas de Mika enrojecieran de vergüenza, pero tras un suave beso en sus suaves labios y en la frente de la niña, retrocedí, escoltado a la salida por la hermana Divine."

# game/data/world_romance/mika/preg_mika.rpy:154
translate es rom_mika_first_post_birth_scene_4379ebd8:

    # DIVINE @ talk "Give her a day or so to recover, then come see her."
    DIVINE @ talk "Dale un día o así para recuperarse, y luego ven a verla."

# game/data/world_romance/mika/preg_mika.rpy:162
translate es rom_mika_first_post_birth_scene_d976317a:

    # MC @ talk "Sister Divine..."
    MC @ talk "Hermana Divine..."

# game/data/world_romance/mika/preg_mika.rpy:163
translate es rom_mika_first_post_birth_scene_46386729:

    # MC @ talk "I suspected you might be more upset about all of this."
    MC @ talk "Pensé que te molestaría más todo esto."

# game/data/world_romance/mika/preg_mika.rpy:166
translate es rom_mika_first_post_birth_scene_93dd3d7b:

    # DIVINE @ happy "It's like I told you, [player_name!t]."
    DIVINE @ happy "Es tal y como te dije, [player_name!t]."

# game/data/world_romance/mika/preg_mika.rpy:165
