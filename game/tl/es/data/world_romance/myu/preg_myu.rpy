translate es rom_myu_how_is_baby_40fdd172:

    # MYU @ joy "Everything is good! Today, Myu was showing them how to make basic stuff like hammers!"
    MYU @ joy "¡Todo está bien! ¡Hoy, Myu les estaba enseñando a hacer cosas básicas como martillos!"

# game/data/world_romance/myu/preg_myu.rpy:101
translate es rom_myu_how_is_baby_6d9e468e:

    # MYU @ think " ...They managed to make a point blade too..."
