    # MYU @ smile "Baby will be strong."
    MYU @ smile "Bebé será fuerte."

# game/data/world_romance/myu/preg_myu.rpy:58
translate es rom_myu_post_impreg_scene_0186a154:

    # MYU @ talk "Can feel your 'gift' inside of it already."
    MYU @ talk "Ya puedo sentir tu 'don' en su interior."

