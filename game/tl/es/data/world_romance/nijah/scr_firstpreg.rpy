

# game/data/world_romance/nijah/scr_firstpreg.rpy:9
translate es preg_Nijah_goodNews_intro_88e7e95f:

    # "As I entered her home, Nijah came to me with hands clasped, nervous."
    "Al entrar en su casa, Nijah se me acercó con las manos juntas, nerviosa."

# game/data/world_romance/nijah/scr_firstpreg.rpy:10
translate es preg_Nijah_goodNews_intro_1fa9f7ad:

    # NIJAH "Must speak with you."
    NIJAH "Debo hablar contigo."

# game/data/world_romance/nijah/scr_firstpreg.rpy:11
translate es preg_Nijah_goodNews_intro_b7dc45a3:

    # "Sensing her distress, I placed my hands on her shoulders."
    "Al sentir su angustia, le puse las manos sobre los hombros."

# game/data/world_romance/nijah/scr_firstpreg.rpy:12
translate es preg_Nijah_goodNews_intro_89f5ce92:

    # MC @ talk "Nijah, what’s wrong?"
    MC @ talk "Nijah, ¿qué ocurre?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:13
translate es preg_Nijah_goodNews_intro_82be8c65:

    # NIJAH "I... I carry your child."
    NIJAH "Yo... Yo llevo a tu hijo."

# game/data/world_romance/nijah/scr_firstpreg.rpy:14
translate es preg_Nijah_goodNews_intro_f3a940fc:

    # "I pulled back, surprised at the comment."
    "Me eché hacia atrás, sorprendido por el comentario."

# game/data/world_romance/nijah/scr_firstpreg.rpy:15
translate es preg_Nijah_goodNews_intro_4f601cd6:

    # MC @ talk "...{i}You’re pregnant?{/i}"
    MC @ talk "...{i}¿Estás embarazada?{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:16
translate es preg_Nijah_goodNews_intro_a5178513:

    # "Nijah sheepishly nodded."
    "Nijah asintió tímidamente."

# game/data/world_romance/nijah/scr_firstpreg.rpy:17
translate es preg_Nijah_goodNews_intro_9a450cee:

    # NIJAH "...Zis not problem?"
    NIJAH "...¿No ez un problema?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:18
translate es preg_Nijah_goodNews_intro_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "¿A qué te refieres?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:19
translate es preg_Nijah_goodNews_intro_12df316d:

    # NIJAH "M-any Alderian men... They get Ramonian girls with child and go."
    NIJAH "M-uchos hombres alderianos... Consiguen chicas ramonianas con hijos y se van."

# game/data/world_romance/nijah/scr_firstpreg.rpy:20
translate es preg_Nijah_goodNews_intro_75857ca2:

    # NIJAH "...many forced to get rid of child while still in womb."
    NIJAH "...muchas se ven obligadas a deshacerse del niño cuando aún está en el vientre."

# game/data/world_romance/nijah/scr_firstpreg.rpy:21
translate es preg_Nijah_goodNews_intro_5df92709:

    # NIJAH "But... I want to keep your child."
    NIJAH "Pero... Quiero quedarme con tu hijo."

# game/data/world_romance/nijah/scr_firstpreg.rpy:22
translate es preg_Nijah_goodNews_intro_ff1bdef9:

    # BLACK "She is fit to carry many of our young."
    BLACK "Es apta para llevar a muchos de nuestros retoños."

# game/data/world_romance/nijah/scr_firstpreg.rpy:23
translate es preg_Nijah_goodNews_intro_d75d061d:

    # BLACK "We should keep this one close as a mate."
    BLACK "Deberíamos tenerla cerca como pareja."

# game/data/world_romance/nijah/scr_firstpreg.rpy:24
translate es preg_Nijah_goodNews_intro_2cebcdc8:

    # MC @ talk "...Nijah, I-"
    MC @ talk "...Nijah, yo-"

# game/data/world_romance/nijah/scr_firstpreg.rpy:25
translate es preg_Nijah_goodNews_intro_2cb4cedf:

    # NIJAH "I do not care if child can change into monster like you."
    NIJAH "No me importa si el niño puede convertirse en un monstruo como tú."

# game/data/world_romance/nijah/scr_firstpreg.rpy:26
translate es preg_Nijah_goodNews_intro_ac59f889:

    # NIJAH "It is {i}our{/i} baby, and that is good enough for me."
    NIJAH "Es {i}nuestro{/i} bebé, y eso es suficiente para mí."

# game/data/world_romance/nijah/scr_firstpreg.rpy:27
translate es preg_Nijah_goodNews_intro_a51e43f2:

    # "Nijah seemed to wait anxiously for a few moments. Almost stand-offish, perhaps expecting me to tell her to get rid of the child or that I didn’t want to see her anymore."
    "Nijah pareció esperar ansiosa unos instantes. Casi distante, quizá esperando que le dijera que se deshiciera de la criatura o que no quería volver a verla."

# game/data/world_romance/nijah/scr_firstpreg.rpy:28
translate es preg_Nijah_goodNews_intro_abd548b8:

    # MC @ talk "Nijah... {i}You are mine.{/i}"
    MC @ talk "Nijah... {i}Eres mía.{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:29
translate es preg_Nijah_goodNews_intro_e7158e0a:

    # MC @ talk "I am pleased you carry my child."
    MC @ talk "Me alegra que lleves a mi hijo."

# game/data/world_romance/nijah/scr_firstpreg.rpy:30
translate es preg_Nijah_goodNews_intro_d62be6ae:

    # "Nijah’s eyes seemed to light up."
    "Los ojos de Nijah parecieron iluminarse."

# game/data/world_romance/nijah/scr_firstpreg.rpy:31
translate es preg_Nijah_goodNews_intro_84ee69e2:

    # NIJAH "R-Really?"
    NIJAH "¿D-De verdad?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:32
translate es preg_Nijah_goodNews_intro_78ec95d9:

    # "With a bright smile, Nijah flung herself onto me, planting kiss onto my lips."
    "Con una sonrisa brillante, Nijah se lanzó sobre mí, plantándome un beso en los labios."

# game/data/world_romance/nijah/scr_firstpreg.rpy:33
translate es preg_Nijah_goodNews_intro_6bcb1c75:

    # NIJAH "M-Master... I love you so much!"
    NIJAH "A-Amo... ¡Te quiero tanto!"

# game/data/world_romance/nijah/scr_firstpreg.rpy:34
translate es preg_Nijah_goodNews_intro_cb9042a3:

    # MC @ talk "Nijah, you know you don’t need to-"
    MC @ talk "Nijah, sabes que no necesitas-"

# game/data/world_romance/nijah/scr_firstpreg.rpy:35
translate es preg_Nijah_goodNews_intro_436f3b45:

    # "Nijah interrupted me again mid-sentence to plant another kiss on my lips."
    "Nijah volvió a interrumpirme a media frase para plantarme otro beso en los labios."

# game/data/world_romance/nijah/scr_firstpreg.rpy:36
translate es preg_Nijah_goodNews_intro_0a0c7479:

    # NIJAH "I shall get some dinner on, stay a while."
    NIJAH "Voy a preparar la cena, quédate un rato."

# game/data/world_romance/nijah/scr_firstpreg.rpy:37
translate es preg_Nijah_goodNews_intro_2eb2dd4a:

    # "With that, Nijah turned, humming happily to herself as she made her way to the kitchen to prepare some food."
    "Nijah se dio la vuelta y, canturreando alegremente, se dirigió a la cocina para preparar la comida."

# game/data/world_romance/nijah/scr_firstpreg.rpy:41
translate es preg_Nijah_goodNews_intro_6c38b146:

    # "After eating with Nijah, I departed once again, thinking about my soon to be new-born child I was now having with Nijah."
    "Después de comer con Nijah, me marché de nuevo, pensando en el recién nacido que iba a tener con Nijah."
