

# game/data/world_romance/nijah/scr_future.rpy:2
translate es rom_Nijah_stage1_future_lines_98050e9d:

    # MC @ talk "Say... Now that Tarek is dealt with, what are you going to do?"
    MC @ talk "Dime... Ahora que nos encargamos de Tarek, ¿qué vas a hacer?"

# game/data/world_romance/nijah/scr_future.rpy:3
translate es rom_Nijah_stage1_future_lines_aaa26ffd:

    # "Nijah pondered the thought for a moment, unsure of an opportunity she had never expected to have."
    "Nijah meditó la idea un momento, insegura ante una oportunidad que nunca había esperado tener."

# game/data/world_romance/nijah/scr_future.rpy:4
translate es rom_Nijah_stage1_future_lines_7138364c:

    # NIJAH "I don’t know..."
    NIJAH "No lo sé..."

# game/data/world_romance/nijah/scr_future.rpy:5
translate es rom_Nijah_stage1_future_lines_57b30ffe:

    # NIJAH "I suppose I could go back to working at za Pleasure District..."
    NIJAH "Supongo que podría volver a trabajar en el distrito del placer..."

# game/data/world_romance/nijah/scr_future.rpy:6
translate es rom_Nijah_stage1_future_lines_c606d148:

    # NIJAH "... The money is good, but iz not the safest job..."
    NIJAH "... El dinero es bueno, pero no ez el trabajo más seguro..."

# game/data/world_romance/nijah/scr_future.rpy:7
translate es rom_Nijah_stage1_future_lines_43fc26ca:

    # MC @ talk "... Is that your only option?"
    MC @ talk "... ¿Es tu única opción?"

# game/data/world_romance/nijah/scr_future.rpy:8
translate es rom_Nijah_stage1_future_lines_a57cee14:

    # NIJAH "There is other way, but I’d need investors."
    NIJAH "Hay otra manera, pero necesitaría inversores."

# game/data/world_romance/nijah/scr_future.rpy:9
translate es rom_Nijah_stage1_future_lines_6e7816fb:

    # MC @ talk "Investors? What are you planning?"
    MC @ talk "¿Inversores? ¿Qué tienes planeado?"

# game/data/world_romance/nijah/scr_future.rpy:10
translate es rom_Nijah_stage1_future_lines_dd91a10a:

    # NIJAH "I can cook food..."
    NIJAH "Sé cocinar..."

# game/data/world_romance/nijah/scr_future.rpy:11
translate es rom_Nijah_stage1_future_lines_0a687ef1:

    # MC @ talk "What? Like bakery food?"
    MC @ talk "¿Como? ¿Como cosas de repostería?"

# game/data/world_romance/nijah/scr_future.rpy:12
translate es rom_Nijah_stage1_future_lines_8199ae0d:

    # NIJAH "No, no... Ramonian street food!"
    NIJAH "No, no... ¡Comida callejera ramoniana!"

# game/data/world_romance/nijah/scr_future.rpy:13
translate es rom_Nijah_stage1_future_lines_a41c5243:

    # NIJAH "Food quick, tasty for people to eat while on go..."
    NIJAH "Comida rápida y sabrosa para comer sobre la marcha..."

# game/data/world_romance/nijah/scr_future.rpy:14
translate es rom_Nijah_stage1_future_lines_9e9890a6:

    # MC @ smile "Ha-ha! You're full of surprises..."
    MC @ smile "¡Ja, ja! Estás llena de sorpresas..."

# game/data/world_romance/nijah/scr_future.rpy:15
translate es rom_Nijah_stage1_future_lines_09e880c3:

    # MC @ talk "Well how much do you need?"
    MC @ talk "¿Cuánto necesitas?"

# game/data/world_romance/nijah/scr_future.rpy:16
translate es rom_Nijah_stage1_future_lines_e049698d:

    # NIJAH "Enough for stall... Plus ingredients and cooking equipment..."
    NIJAH "Suficiente para el puesto... Más ingredientes y equipo de cocina..."

# game/data/world_romance/nijah/scr_future.rpy:17
translate es rom_Nijah_stage1_future_lines_6ca852ee:

    # NIJAH "At least thousand gold..."
    NIJAH "Al menos mil de oro..."

# game/data/world_romance/nijah/scr_future.rpy:18
translate es rom_Nijah_stage1_future_lines_806b841b:

    # "(That’s quite a lot.)"
    "(Eso es bastante)."

# game/data/world_romance/nijah/scr_future.rpy:19
translate es rom_Nijah_stage1_future_lines_8c4ad5bf:

    # "(What should I encourage her to do?)"
    "(¿Qué debería animarla a hacer?)"

# game/data/world_romance/nijah/scr_future.rpy:22
translate es rom_Nijah_stage1_future_lines_menu_02182bf6:

    # NIJAH @ happy "...!"
    NIJAH @ happy "¡...!"

# game/data/world_romance/nijah/scr_future.rpy:23
translate es rom_Nijah_stage1_future_lines_menu_d82da894:

    # NIJAH @ smile "You will?"
    NIJAH @ smile "¿Lo harás?"

# game/data/world_romance/nijah/scr_future.rpy:24
translate es rom_Nijah_stage1_future_lines_menu_9f0aa4e9:

    # NIJAH @ smile "A thousand gold?"
    NIJAH @ smile "¿Mil monedas de oro?"

# game/data/world_romance/nijah/scr_future.rpy:25
translate es rom_Nijah_stage1_future_lines_menu_d58cad19:

    # NIJAH "I... I cannot ask you to do zis!"
    NIJAH "No... ¡No puedo pedirte que hagas ezto!"

# game/data/world_romance/nijah/scr_future.rpy:29
translate es rom_Nijah_stage1_future_lines_menu_97fa787e:

    # NIJAH "Zis is..."
    NIJAH "Ezto es..."

# game/data/world_romance/nijah/scr_future.rpy:30
translate es rom_Nijah_stage1_future_lines_menu_cdf45d1e:

    # "Nijah started to cry"
    "Nijah empezó a llorar"

# game/data/world_romance/nijah/scr_future.rpy:31
translate es rom_Nijah_stage1_future_lines_menu_04f17e1e:

    # NIJAH @ sad "... You haz done too much for me."
    NIJAH @ sad "... Haz hecho demasiado por mí."

# game/data/world_romance/nijah/scr_future.rpy:33
translate es rom_Nijah_stage1_future_lines_menu_a6b98d5f:

    # "Nijah hurried forward, wrapping her arms around me in a tight hug, when she pulled back, she smiled warmly, tears streaming down her cheeks in joy."
    "Nijah se abalanzó sobre mí y me abrazó con fuerza. Cuando se apartó, sonrió cálidamente, con lágrimas de alegría cayendo por sus mejillas."

# game/data/world_romance/nijah/scr_future.rpy:37
translate es rom_Nijah_stage1_future_lines_menu_a997409b:

    # NIJAH "Alright... I trust you... I shall wait for you."
    NIJAH "Muy bien... Confío en ti... Te esperaré."

# game/data/world_romance/nijah/scr_future.rpy:42
translate es rom_Nijah_stage1_future_lines_menu_b41866ee:

    # NIJAH "You... Vat?"
    NIJAH "¿Tú... qué?"

# game/data/world_romance/nijah/scr_future.rpy:43
translate es rom_Nijah_stage1_future_lines_menu_88ce21a9:

    # MC @ talk "I’ll pay for you to have your own room."
    MC @ talk "Pagaré para que tengas tu propia habitación."

# game/data/world_romance/nijah/scr_future.rpy:44
translate es rom_Nijah_stage1_future_lines_menu_ba9be3de:

    # MC @ talk "As a Novaras citizen, I can quickly and legally get the paperwork you need."
    MC @ talk "Como ciudadano de Novaras, puedo conseguir rápida y legalmente la documentación que necesitas."

# game/data/world_romance/nijah/scr_future.rpy:45
translate es rom_Nijah_stage1_future_lines_menu_1ef1adfd:

    # MC @ talk "I can also guarantee you have some protection that before you was not privy to."
    MC @ talk "También puedo garantizarte que tienes una protección de la que antes no disponías."

# game/data/world_romance/nijah/scr_future.rpy:46
translate es rom_Nijah_stage1_future_lines_menu_a4b7cc57:

    # MC "Nijah pondered the thought a moment, hesistant about the idea of returning to her old line of work."
    MC "Nijah se lo pensó un momento, indecisa ante la idea de volver a su antiguo trabajo."

# game/data/world_romance/nijah/scr_future.rpy:47
translate es rom_Nijah_stage1_future_lines_menu_9cc15501:

    # NIJAH "This... would be better."
    NIJAH "Esto... sería mejor."

# game/data/world_romance/nijah/scr_future.rpy:48
translate es rom_Nijah_stage1_future_lines_menu_1364cda5:

    # NIJAH "{i}But...{/i}"
    NIJAH "{i}Pero...{/i}"

# game/data/world_romance/nijah/scr_future.rpy:49
translate es rom_Nijah_stage1_future_lines_menu_e66bab01:

    # MC "Nijah opened her mouth to protest, but instead, her eyes simply dropped to the floor as she reached and grabbed at her other arm anxiously."
    MC "Nijah abrió la boca para protestar, pero en lugar de eso, sus ojos simplemente bajaron al suelo mientras se cogía el otro brazo con ansiedad."

# game/data/world_romance/nijah/scr_future.rpy:50
translate es rom_Nijah_stage1_future_lines_menu_6f13d691:

    # NIJAH "In return, you want share of gold I earn?"
    NIJAH "A cambio, ¿quieres parte del oro que gane?"

# game/data/world_romance/nijah/scr_future.rpy:51
translate es rom_Nijah_stage1_future_lines_menu_83589d81:

    # MC @ talk "I do."
    MC @ talk "Sí."

# game/data/world_romance/nijah/scr_future.rpy:52
translate es rom_Nijah_stage1_future_lines_menu_79b06185:

    # NIJAH "... Thirty percent?"
    NIJAH "... ¿Treinta por ciento?"

# game/data/world_romance/nijah/scr_future.rpy:55
translate es rom_Nijah_stage1_future_lines_menu_568c2bf8:

    # MC @ talk "Yeah, that's a deal."
    MC @ talk "Sí, es un trato."

# game/data/world_romance/nijah/scr_future.rpy:64
translate es rom_Nijah_stage1_future_lines_menu_991a9c2d:

    # NIJAH "Alright... I suppose after all you have done zis iz fair..."
    NIJAH "De acuerdo... Supongo que después de todo lo que has hecho ezto ez justo..."

# game/data/world_romance/nijah/scr_future.rpy:65
translate es rom_Nijah_stage1_future_lines_menu_25a09a38:

    # NIJAH "I come with you to speak to men in charge of district..."
    NIJAH "Vengo contigo para hablar con los hombres a cargo del distrito..."

# game/data/world_romance/nijah/scr_future.rpy:68
translate es rom_Nijah_stage1_future_lines_menu_ded37cfe:

    # "Following Nijah down to the District, she introduced me to one of the officials there, a tall and uninspiring rake of a man who sat down in one of the few ‘offices’ littered around the District that the girls use when they want to lodge complaints."
    "Siguiendo a Nijah hasta el distrito, me presentó a uno de los funcionarios, un hombre alto y desaliñado que se sentó en una de las pocas ‘oficinas’ repartidas por el distrito a las que acuden las chicas cuando quieren presentar quejas."

# game/data/world_romance/nijah/scr_future.rpy:69
translate es rom_Nijah_stage1_future_lines_menu_620526a0:

    # "When I showed him my gold, it didn’t exactly take long to have the right paperwork and such in place. In just a few hours, we were set to go..."
    "Cuando le enseñé mi oro, no tardó mucho en hacer los trámites necesarios. En pocas horas, estábamos listos..."

# game/data/world_romance/nijah/scr_future.rpy:70
translate es rom_Nijah_stage1_future_lines_menu_59f434a3:

    # "Nijah had her own room, and it was known to all that she was a protected girl now."
    "Nijah tenía su propia habitación y todos sabían que ahora era una chica protegida."

# game/data/world_romance/nijah/scr_future.rpy:76
translate es rom_Nijah_stage1_future_lines_menu_8f0508e3:

    # NIJAH "Zat was... very quick."
    NIJAH "Ezo fue... muy rápido."

# game/data/world_romance/nijah/scr_future.rpy:77
translate es rom_Nijah_stage1_future_lines_menu_a8cbf7ee:

    # NIJAH "It would take a Ramonian like me weeks to get anywhere with them."
    NIJAH "Una ramoniana como yo tardaría semanas en llegar a alguna parte con ellos."

# game/data/world_romance/nijah/scr_future.rpy:78
translate es rom_Nijah_stage1_future_lines_menu_5f7e87c5:

    # MC @ talk "Being a citizen has its benefits."
    MC @ talk "Ser un ciudadano tiene sus ventajas."

# game/data/world_romance/nijah/scr_future.rpy:79
translate es rom_Nijah_stage1_future_lines_menu_7e9393ab:

    # NIJAH "I suppose I better get back to za work... Stop by to collect your money once a fortnight."
    NIJAH "Supongo que zerá mejor que vuelva al trabajo... Pasa a recoger tu dinero una vez cada quince días."

# game/data/world_romance/nijah/scr_future.rpy:80
translate es rom_Nijah_stage1_future_lines_menu_e35850f4:

    # MC @ talk "Let me know if there are any problems, remember, you are protected by me now."
    MC @ talk "Avísame si hay algún problema, recuerda que ahora estás protegida por mí."

# game/data/world_romance/nijah/scr_future.rpy:81
translate es rom_Nijah_stage1_future_lines_menu_518f3315:

    # MC @ talk "I will see to it that no harm comes to you."
    MC @ talk "Me encargaré de que no te pase nada."

# game/data/world_romance/nijah/scr_future.rpy:82
translate es rom_Nijah_stage1_future_lines_menu_4e16aac8:

    # "Nijah smiled unconvincingly, but nodded anyway."
    "Nijah sonrió sin convicción, pero asintió de todos modos."

# game/data/world_romance/nijah/scr_future.rpy:83
translate es rom_Nijah_stage1_future_lines_menu_7b19a276:

    # NIJAH "T-Thank you... Now if you excuse me, I should get ready."
    NIJAH "G-gracias... Ahora si me disculpas, debo prepararme."

# game/data/world_romance/nijah/scr_future.rpy:84
translate es rom_Nijah_stage1_future_lines_menu_10f6a25a:

    # MC "I watched as Nijah headed off, no doubt to prepare for her {i}'clients'{/i}"
    MC "Vi cómo Nijah se marchaba, sin duda para prepararse para sus {i}'clientes'{/i}"

# game/data/world_romance/nijah/scr_future.rpy:86
translate es rom_Nijah_stage1_future_lines_menu_49528545:

    # "And just like that, Nijah returned to her old work... A part of me wondered if I’d made the right choice, if perhaps, Nijah wanted and deserved better than this life?"
    "Y así como así, Nijah volvió a su antiguo trabajo... Una parte de mí se preguntaba si había tomado la decisión correcta, si tal vez, Nijah quería y merecía algo mejor que esta vida..."

# game/data/world_romance/nijah/scr_future.rpy:87
translate es rom_Nijah_stage1_future_lines_menu_da7e2faa:

    # "But, as I reminded myself, she was now safer than before... And my pockets were going to get a lot heavier. Morality aside, maybe this was for the best."
    "Pero, como me recordaba a mí mismo, ahora estaba más segura que antes... Y mis bolsillos iban a ser mucho más pesados. Moralidad aparte, tal vez esto era lo mejor."

translate es strings:

    # game/data/world_romance/nijah/scr_future.rpy:20
    old "Tell Nijah you’ll invest in her business"
    new "Dile a Nijah que invertirás en su negocio."

    # game/data/world_romance/nijah/scr_future.rpy:20
    old "Tell Nijah you’ll become her pimp"
    new "Dile a Nijah que te convertirás en su proxeneta."

    # game/data/world_romance/nijah/scr_future.rpy:26
    old "Give Nijah the gold"
    new "Dale el oro a Nijah"

    # game/data/world_romance/nijah/scr_future.rpy:26
    old "I’ll be back soon."
    new "Volveré pronto."

    # game/data/world_romance/nijah/scr_future.rpy:53
    old "Sure."
    new "Por supuesto."

    # game/data/world_romance/nijah/scr_future.rpy:53
    old "Forty."
    new "Cuarenta."
