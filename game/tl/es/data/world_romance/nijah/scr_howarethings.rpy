

# game/data/world_romance/nijah/scr_howarethings.rpy:4
translate es rom_nijah_howarethings_3e497667:

    # NIJAH "Things are fine my love, though I do miss you vhen you iz gone so long..."
    NIJAH "Todo va bien, mi amor, aunque te echo de menos cuando te vaz tanto tiempo..."

# game/data/world_romance/nijah/scr_howarethings.rpy:5
translate es rom_nijah_howarethings_373573e5:

    # MC @ talk "It cannot be helped I am afraid."
    MC @ talk "Me temo que no se puede evitar."

# game/data/world_romance/nijah/scr_howarethings.rpy:6
translate es rom_nijah_howarethings_d4aedf10:

    # NIJAH "That iz okay, you are good man."
    NIJAH "Eztá bien, eres un buen hombre."

# game/data/world_romance/nijah/scr_howarethings.rpy:8
translate es rom_nijah_howarethings_60b2628a:

    # NIJAH "Hmph, I was refused dress!"
    NIJAH "Hmph, ¡me denegaron un vestido!"

# game/data/world_romance/nijah/scr_howarethings.rpy:9
translate es rom_nijah_howarethings_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "¿Qué?"

# game/data/world_romance/nijah/scr_howarethings.rpy:10
translate es rom_nijah_howarethings_395b2ec1:

    # NIJAH "I tried to buy a new dress today, but the store would not sell to me."
    NIJAH "Intenté comprarme un vestido nuevo hoy, pero en la tienda no me lo quisieron vender."

# game/data/world_romance/nijah/scr_howarethings.rpy:11
translate es rom_nijah_howarethings_6d585daa:

    # NIJAH "{i}*Sigh*{/i} This kingdom hates us... I wish you could take me home."
    NIJAH "{i}*Suspiro*{/i} Este reino nos odia... Ojalá pudieras llevarme a casa."

# game/data/world_romance/nijah/scr_howarethings.rpy:12
translate es rom_nijah_howarethings_8aa34b28:

    # MC @ talk "Maybe one day Nijah, it’s not safe at the moment with the war going on."
    MC @ talk "Tal vez un día Nijah, no es seguro en este momento con la guerra en curso."

# game/data/world_romance/nijah/scr_howarethings.rpy:13
translate es rom_nijah_howarethings_caf5e348:

    # NIJAH "I know... But I dream anyway."
    NIJAH "Lo sé... Pero sueño de todos modos."

# game/data/world_romance/nijah/scr_howarethings.rpy:15
translate es rom_nijah_howarethings_f3e4dd8d:

    # NIJAH "I received letter from my mother again today!"
    NIJAH "¡Hoy he vuelto a recibir carta de mi madre!"

# game/data/world_romance/nijah/scr_howarethings.rpy:16
translate es rom_nijah_howarethings_56d87cbd:

    # NIJAH "She and father are doing well!"
    NIJAH "¡A ella y padre les va bien!"

# game/data/world_romance/nijah/scr_howarethings.rpy:17
translate es rom_nijah_howarethings_53e42be3:

    # NIJAH "{i}*Sigh*{/i} I wish I could see them again one day."
    NIJAH "{i}*Suspiro*{/i} Ojalá pudiera volver a verlos algún día."

# game/data/world_romance/nijah/scr_howarethings.rpy:19
translate es rom_nijah_howarethings_5b74c56a:

    # NIJAH "Y-Yes my love..."
    NIJAH "S-sí mi amor..."

# game/data/world_romance/nijah/scr_howarethings.rpy:20
translate es rom_nijah_howarethings_4dca983f:

    # MC @ talk "Nijah? What is it?"
    MC @ talk "¿Nijah? ¿Qué ocurre?"

# game/data/world_romance/nijah/scr_howarethings.rpy:21
translate es rom_nijah_howarethings_0908d81a:

    # NIJAH "...C-Come take me to bed please, {i}I need you{/i} my love."
    NIJAH "...V-ven a acostarte conmigo, por favor, {i}te necesito{/i}, mi amor."

# game/data/world_romance/nijah/scr_howarethings.rpy:22
translate es rom_nijah_howarethings_f4877a6a:

    # NIJAH "You are zo... {i}addictive.{/i}"
    NIJAH "Erez tan... {i}adictivo.{/i}"

# game/data/world_romance/nijah/scr_howarethings.rpy:23
translate es rom_nijah_howarethings_e4cbe717:

    # MC @ talk "(That would be the creature's work.)"
    MC @ talk "(Ese sería el trabajo de la criatura)."
