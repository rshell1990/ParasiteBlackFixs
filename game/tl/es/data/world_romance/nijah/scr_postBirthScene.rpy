

# game/data/world_romance/nijah/scr_postBirthScene.rpy:5
translate es nijah_post_birth_scene_02c073d1:

    # "Entering into Nijah's home, Nijah smiled as she held in her hands a small child of light dark complexion."
    "Al entrar en la casa de Nijah, ésta sonrió mientras sostenía en sus manos a un niño pequeño de tez morena clara."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:6
translate es nijah_post_birth_scene_b4831c31:

    # NIJAH @ smile "Ah! There you are!"
    NIJAH @ smile "¡Ah! ¡Ahí estás!"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:7
translate es nijah_post_birth_scene_233de43e:

    # MC @ surprised "Is that-"
    MC @ surprised "¿Ese es-"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:8
translate es nijah_post_birth_scene_b6c5054e:

    # NIJAH "Look, our child..."
    NIJAH "Mira, nuestro hijo..."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:9
translate es nijah_post_birth_scene_fa57f756:

    # "Nijah held out and showed the small baby to me, whose eyes seemed identical to mine."
    "Nijah me tendió y mostró al pequeño bebé, cuyos ojos parecían idénticos a los míos."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:10
translate es nijah_post_birth_scene_4ef09e4c:

    # BLACK "{i}(The seed is strong... Ours shall be a strong warrior).{/i}"
    BLACK "{i}(La semilla es fuerte... El nuestro será un guerrero fuerte).{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:11
translate es nijah_post_birth_scene_84b2c1e6:

    # NIJAH "Hmm, [PregNijah().LastBornBabyName] iz a good name!"
    NIJAH "¡mm, [PregNijah().LastBornBabyName] ez un buen nombre!"


# game/data/world_romance/nijah/scr_postBirthScene.rpy:14
translate es nijah_post_birth_scene_f419fd3c:

    # MC @ talk "How are you feeling?"
    MC @ talk "¿Cómo te encuentras?"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:15
translate es nijah_post_birth_scene_d6a41399:

    # NIJAH "Tired, but went well."
    NIJAH "Cansada, pero ha ido bien."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:16
translate es nijah_post_birth_scene_ff1e5fa2:

    # NIJAH "Midwives were surprised, they said our child's birth was the easiest they had ever seen."
    NIJAH "Las comadronas estaban sorprendidas, decían que el parto de nuestro hijo había sido el más fácil que habían visto nunca."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:17
translate es nijah_post_birth_scene_72e3a616:

    # NIJAH "...Zis because of your {i}gift?{/i}"
    NIJAH "...¿Ezto se debe a tu {i}don?{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:18
translate es nijah_post_birth_scene_1a193db3:

    # BLACK "{i}(Yes, it is good to not allow hosts to die when they can sire many young for us).{/i}"
    BLACK "{i}(Sí, es bueno no dejar que los anfitriones mueran cuando pueden engendrar muchas crías para nosotros).{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:19
translate es nijah_post_birth_scene_70eb3d22:

    # MC @ talk "Uhh, yes."
    MC @ talk "Uhh, sí."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:20
translate es nijah_post_birth_scene_2baa7256:

    # NIJAH "Zis is good to know because..."
    NIJAH "Ez bueno saberlo porque..."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:21
translate es nijah_post_birth_scene_f1f3684e:

    # "Nijah alluringly stepped towards me, pressing her breasts against my chest as her hands run down my chest."
    "Nijah se acercó seductoramente a mí, apretando sus pechos contra los míos mientras sus manos recorrían mi pecho."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:22
translate es nijah_post_birth_scene_71299bb6:

    # NIJAH @ lewd "{i}We must have a very big family!{/i}"
    NIJAH @ lewd "{i}¡Debemos de tener una familia muy grande!{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:23
translate es nijah_post_birth_scene_a6155343:

    # MC @ surprised "{i}*Gulp!*{/i}"
    MC @ surprised "{i}*¡Tragar!*{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:25
translate es nijah_post_birth_scene_b55b6da8:

    # "For the next hour or so, I spent some time with Nijah and our new-born child, playing and watching them with a new-found pride."
    "Durante la hora siguiente, más o menos, pasé un rato con Nijah y nuestro recién nacido, jugando y observándoles con un orgullo recién descubierto."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:26
translate es nijah_post_birth_scene_506f49d3:

    # "Whether it was by the {i}Dark passengers{/i} design within me, or my own natural paternal instincts stiring, I felt rejuvenated and stronger as I watched my child playfully reach out to grab my hand."
    "Ya fuera por el designio de los {i}pasajeros oscuros{/i} que llevo dentro o por mis propios instintos paternales naturales, me sentí rejuvenecido y más fuerte al ver cómo mi hijo se acercaba juguetón para cogerme la mano."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:27
translate es nijah_post_birth_scene_e00fed67:

    # "A short while later, I left Nijah alone once again, onwards towards whatever was next."
    "Poco después, volví a dejar a Nijah sola, en dirección a lo que fuera."

