

# game/data/world_romance/nijah/scr_secondpreg.rpy:10
translate es preg_Nijah_secondPreg_b75b342e:

    # NIJAH "Uhh, my love?"
    NIJAH "Uhh, ¿mi amor?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:11
translate es preg_Nijah_secondPreg_ccbd6626:

    # MC @ talk "What is it, Nijah?"
    MC @ talk "¿Qué ocurre, Nijah?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:12
translate es preg_Nijah_secondPreg_c62c397f:

    # NIJAH @ smile "You did it again."
    NIJAH @ smile "Lo hiciste de nuevo."

# game/data/world_romance/nijah/scr_secondpreg.rpy:13
translate es preg_Nijah_secondPreg_2b7a6d10:

    # "Nijah happily rubbed her belly."
    "Nijah se frotó alegremente la barriga."

# game/data/world_romance/nijah/scr_secondpreg.rpy:14
translate es preg_Nijah_secondPreg_2c6a0c4d:

    # NIJAH @ smile "I am with child once more."
    NIJAH @ smile "Estoy embarazada de nuevo."

# game/data/world_romance/nijah/scr_secondpreg.rpy:15
translate es preg_Nijah_secondPreg_530a0797:

    # "Nijah took my hand and placed it over her belly, where once again I could feel the swelling life and power coursing inside of her."
    "Nijah cogió mi mano y la colocó sobre su vientre, donde una vez más pude sentir la vida y la fuerza que corrían por su interior."

# game/data/world_romance/nijah/scr_secondpreg.rpy:16
translate es preg_Nijah_secondPreg_c9ecd207:

    # NIJAH "Are you pleased, master?"
    NIJAH "¿Está contento, amo?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:17
translate es preg_Nijah_secondPreg_43ba64e3:

    # MC @ smile "Very much so, Nijah."
    MC @ smile "Mucho, Nijah."

# game/data/world_romance/nijah/scr_secondpreg.rpy:18
translate es preg_Nijah_secondPreg_f2c2b4bc:

    # NIJAH @ smile "I have missed you much, come... Let me serve you food."
    NIJAH @ smile "Te he echado mucho de menos, ven... Déjame servirte comida."

# game/data/world_romance/nijah/scr_secondpreg.rpy:19
translate es preg_Nijah_secondPreg_0ff7edaf:

    # NIJAH @ smile "Iz good our children will have lots of brothers and sisters!"
    NIJAH @ smile "¡Ez bueno que nuestros hijos tengan muchos hermanos y hermanas!"

# game/data/world_romance/nijah/scr_secondpreg.rpy:21
translate es preg_Nijah_secondPreg_9053ae27:

    # "Nijah did her best to chat away with me as she cooked and served me some food."
    "Nijah hizo todo lo posible por charlar conmigo mientras cocinaba y me servía la comida."

# game/data/world_romance/nijah/scr_secondpreg.rpy:22
translate es preg_Nijah_secondPreg_3ad40bab:

    # "Her Alderian was still broken, but she did her best to learn and was constantly moving between rooms, attending to our already born children and devoting lavishly on me."
    "Su alderiano seguía siendo deficiente, pero hacía todo lo posible por aprender y se movía constantemente de una habitación a otra, atendiendo a nuestros hijos ya nacidos y ocupándose profusamente de mí."

# game/data/world_romance/nijah/scr_secondpreg.rpy:23
translate es preg_Nijah_secondPreg_2500c393:

    # "Finally, with a kiss goodbye and a squeeze of her round ass, I was off once again, assuring Nijah I would return."
    "Finalmente, con un beso de despedida y un apretón en su redondo culo, me fui de nuevo, asegurando a Nijah que volvería."
