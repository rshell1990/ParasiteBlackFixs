

# game/data/world_romance/nyx/rom_nyx_love.rpy:4
translate es rom_nyx_love_1_8a057542:

    # MC "Nyx isn't here. I'll try tomorrow."
    MC "Nyx no está aquí. Lo intentaré mañana."

# game/data/world_romance/nyx/rom_nyx_love.rpy:13
translate es rom_nyx_love_1_79969df8:

    # "Upon entering into her Office, Nyx stormed over angrily towards me, hands balled up into fists."
    "Al entrar a su oficina, Nyx corrió furiosa hacia mí, con las manos apretadas en puños."

# game/data/world_romance/nyx/rom_nyx_love.rpy:14
translate es rom_nyx_love_1_d545ac2c:

    # NYX @ angry "Was I not clear before?"
    NYX @ angry "¿No lo expresé con claridad antes?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:15
translate es rom_nyx_love_1_1583fce0:

    # NYX @ angry "What in the seven hells are you doing here?"
    NYX @ angry "¿Qué diablos estás haciendo aquí?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:16
translate es rom_nyx_love_1_e7723627:

    # MC @ talk "I came here to speak to you."
    MC @ talk "Vine aquí para hablar contigo."

# game/data/world_romance/nyx/rom_nyx_love.rpy:17
translate es rom_nyx_love_1_bcb3903c:

    # NYX @ think "About what? There is nothing to discuss."
    NYX @ think "¿De qué? No hay nada que hablar."

# game/data/world_romance/nyx/rom_nyx_love.rpy:21
translate es rom_nyx_love_1_9e2a7ee2:

    # NYX @ shock "E-Excuse me?"
    NYX @ shock "¿D-disculpa?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:22
translate es rom_nyx_love_1_5029d028:

    # MC @ talk "You can't work all the time; you need a break every once in a while."
    MC @ talk "No puedes trabajar todo el tiempo; necesitas un descanso de vez en cuando.."

# game/data/world_romance/nyx/rom_nyx_love.rpy:23
translate es rom_nyx_love_1_f23ff399:

    # NYX @ angry "Are you even hearing yourself?!"
    NYX @ angry "¿¡Te estás escuchando a ti mismo!?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:25
translate es rom_nyx_love_1_f8707b9c:

    # NYX @ arrogant "I'm the captain of the city guard ... Not some peasant girl you're courting!"
    NYX @ arrogant "Soy la capitana de la guardia de la ciudad... ¡No una campesina a la que estás cortejando!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:26
translate es rom_nyx_love_1_b22b2824:

    # MC @ smile "And does the captain of the city guard never take a day-off?"
    MC @ smile "¿Y la capitana de la guardia de la ciudad nunca se toma un día libre?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:27
translate es rom_nyx_love_1_e7085def:

    # NYX @ arrogant "My duties and responsibilities come first."
    NYX @ arrogant "Mis deberes y responsabilidades vienen primero."

# game/data/world_romance/nyx/rom_nyx_love.rpy:28
translate es rom_nyx_love_1_d66b89f3:

    # MC @ talk "Surely you can't fulfil those duties as well without taking a break every now and then?"
    MC @ talk "¿Seguramente no podrás cumplir con esas obligaciones sin tomarte un descanso de vez en cuando?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:30
translate es rom_nyx_love_1_4263f98d:

    # NYX @ angry "Must you persist in this matter?"
    NYX @ angry "¿Debes persistir en este asunto?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:31
translate es rom_nyx_love_1_bd72f8b4:

    # MC @ smile "Because I care about you."
    MC @ smile "Porque me preocupo por ti."

# game/data/world_romance/nyx/rom_nyx_love.rpy:33
translate es rom_nyx_love_1_1c9a7cfb:

    # "Nyx blushed at the comment, grumbling beneath her breath how 'stupid' I was being while averting her gaze."
    "Nyx se sonrojó ante el comentario, refunfuñando en voz baja lo 'estúpido' que estaba siendo mientras desviaba la mirada."

# game/data/world_romance/nyx/rom_nyx_love.rpy:34
translate es rom_nyx_love_1_4df40c75:

    # NYX @ think "{i}*Sigh*{/i}"
    NYX @ think "{i}*Suspiro*{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:36
translate es rom_nyx_love_1_db4c46e8:

    # NYX @ angry "What if someone sees me, hm? How do you propose I explain that one?"
    NYX @ angry "¿Y si alguien me ve? ¿Cómo propones que le explique eso?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:37
translate es rom_nyx_love_1_22ed2d9d:

    # MC @ talk "Am I supposed to believe you're incapable of disguising yourself?"
    MC @ talk "¿Se supone que debo creer que eres incapaz de disfrazarte?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:38
translate es rom_nyx_love_1_d2159437:

    # MC @ talk "Outside of that armor, how many are honestly going to recognize you?"
    MC @ talk "Fuera de esa armadura, ¿cuántos te reconocerán honestamente?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:40
translate es rom_nyx_love_1_482d7b74:

    # NYX @ think "...Fine, FINE!"
    NYX @ think "...Está bien, ¡ESTÁ BIEN!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:41
translate es rom_nyx_love_1_78b039bd:

    # NYX @ angry "But push aside silly notions of this being anything more than a chance for me to take a break from work."
    NYX @ angry "Pero dejemos de lado las ideas tontas de que esto es algo más que una oportunidad para tomarme un descanso del trabajo."

# game/data/world_romance/nyx/rom_nyx_love.rpy:42
translate es rom_nyx_love_1_aef727ce:

    # NYX @ think "What happened last time {i}won't{/i} happen again."
    NYX @ think "Lo que pasó la última vez {i}no{/i} volverá a pasar."

# game/data/world_romance/nyx/rom_nyx_love.rpy:43
translate es rom_nyx_love_1_0746b417:

    # MC @ smile "If you say so."
    MC @ smile "Si tú lo dices."

# game/data/world_romance/nyx/rom_nyx_love.rpy:44
translate es rom_nyx_love_1_1da137f4:

    # NYX @ angry "Don't be so-"
    NYX @ angry "No seas tan-"

# game/data/world_romance/nyx/rom_nyx_love.rpy:45
translate es rom_nyx_love_1_577a1c71:

    # NYX @ think "You know what? Forget it, I will see you at the {i}Iron Unicorn{/i} this Evening."
    NYX @ think "¿Sabes qué? Olvídalo, te veré en el {i}Unicornio de hierro{/i} este anochecer."

# game/data/world_romance/nyx/rom_nyx_love.rpy:46
translate es rom_nyx_love_1_5dfd0491:

    # MC @ smile "I shall see you then."
    MC @ smile "Nos vemos entonces."

# game/data/world_romance/nyx/rom_nyx_love.rpy:61
translate es rom_nyx_love_1_1df973fb:

    # "Nyx seemed surprised at the comment, but quickly returned to her usual self."
    "Nyx pareció sorprendida por el comentario, pero rápidamente volvió a ser la misma de siempre."

# game/data/world_romance/nyx/rom_nyx_love.rpy:62
translate es rom_nyx_love_1_60c586d4:

    # NYX @ think "Y-You agree?"
    NYX @ think "¿E-estás de acuerdo?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:64
translate es rom_nyx_love_1_0e455826:

    # NYX @ sad "Right, well, yes ... It's for the best."
    NYX @ sad "Bueno, claro que sí... Es lo mejor."

# game/data/world_romance/nyx/rom_nyx_love.rpy:65
translate es rom_nyx_love_1_c42c7fdf:

    # MC @ talk "Are you alright?"
    MC @ talk "¿Estás bien?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:66
translate es rom_nyx_love_1_540f65c6:

    # NYX @ sad "I'm fine, now, if that's all you came to say you can go."
    NYX @ sad "Estoy bien ahora, si eso es todo lo que viniste a decir, puedes irte."

# game/data/world_romance/nyx/rom_nyx_love.rpy:67
translate es rom_nyx_love_1_23893bea:

    # NYX @ think "And the two of us can forget this little 'incident' ever happened..."
    NYX @ think "Y los dos podemos olvidarnos de que este pequeño 'incidente' haya ocurrido..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:89
translate es rom_nyx_love_unicorn_date_4423f9a9:

    # "I looked around for any sign of Captain Nyx, to no-avail."
    "Miré a mi alrededor buscando alguna señal de la capitana Nyx, pero fue en vano."

# game/data/world_romance/nyx/rom_nyx_love.rpy:90
translate es rom_nyx_love_unicorn_date_7e2105d4:

    # MC "(Hm ...Maybe she really isn't coming.)"
    MC "(Hm...Tal vez ella realmente no venga)."

# game/data/world_romance/nyx/rom_nyx_love.rpy:95
translate es rom_nyx_love_unicorn_date_4652382c:

    # "In that moment I felt someone nudge up against me, and as I turned, I looked to see a robbed figure stood before me."
    "En ese momento sentí que alguien me empujaba y, cuando me giré, miré y vi una figura con una figura encapuchada parada frente a mí."

# game/data/world_romance/nyx/rom_nyx_love.rpy:97
translate es rom_nyx_love_unicorn_date_ecb0d696:

    # "As she tilted her head up, I could see clearly through the hood it was Captain Nyx."
    "Cuando inclinó la cabeza hacia arriba, pude ver claramente a través de la capucha que era la capitana Nyx."

# game/data/world_romance/nyx/rom_nyx_love.rpy:98
translate es rom_nyx_love_unicorn_date_11b28b5c:

    # MC @ smile "Ah! Captain-"
    MC @ smile "¡Ah! Capitana-"

# game/data/world_romance/nyx/rom_nyx_love.rpy:99
translate es rom_nyx_love_unicorn_date_ca71b39d:

    # NYX @ angry "Shh! Not so loud!"
    NYX @ angry "¡Shhh! ¡No tan fuerte!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:100
translate es rom_nyx_love_unicorn_date_304aa174:

    # MC @ smile "Ahh ... That explains the disguise then."
    MC @ smile "Ahhh... Eso explica el disfraz entonces."

# game/data/world_romance/nyx/rom_nyx_love.rpy:101
translate es rom_nyx_love_unicorn_date_ff069f4c:

    # "Nyx sighed uneasily, looking around the tavern for signs of anyone she recognized."
    "Nyx suspiró inquieta, mirando alrededor de la taberna en busca de señales de alguien que reconociera."

# game/data/world_romance/nyx/rom_nyx_love.rpy:102
translate es rom_nyx_love_unicorn_date_195c857b:

    # NYX @ think "Why did you choose to bring me here?"
    NYX @ think "¿Por qué decidiste traerme aquí?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:103
translate es rom_nyx_love_unicorn_date_a37cf216:

    # NYX @ think "There are too many people."
    NYX @ think "Hay demasiada gente."

# game/data/world_romance/nyx/rom_nyx_love.rpy:104
translate es rom_nyx_love_unicorn_date_5ef67c6d:

    # MC @ talk "Relax, Nyx."
    MC @ talk "Relájate, Nyx."

# game/data/world_romance/nyx/rom_nyx_love.rpy:105
translate es rom_nyx_love_unicorn_date_226f3248:

    # MC @ talk "We're here to have some fun, remember?"
    MC @ talk "Estamos aquí para divertirnos, ¿recuerdas?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:106
translate es rom_nyx_love_unicorn_date_627bcae2:

    # NYX @ talk "Right, yes ...'fun.'"
    NYX @ talk "Cierto, sí ... 'diversión'."

# game/data/world_romance/nyx/rom_nyx_love.rpy:107
translate es rom_nyx_love_unicorn_date_0bf6acba:

    # MC @ talk "What are you drinking?"
    MC @ talk "¿Qué estás bebiendo?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:108
translate es rom_nyx_love_unicorn_date_80b0281b:

    # NYX @ talk "Ale."
    NYX @ talk "Cerveza."

# game/data/world_romance/nyx/rom_nyx_love.rpy:109
translate es rom_nyx_love_unicorn_date_9b9e3f77:

    # MC @ talk "Two ales, coming up..."
    MC @ talk "Dos cervezas, a punto de llegar..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:119
translate es rom_nyx_love_unicorn_date_2f6662c7:

    # "Nyx took a sip of the ale in her cup and smiled."
    "Nyx tomó un sorbo de cerveza en su taza y sonrió."

# game/data/world_romance/nyx/rom_nyx_love.rpy:120
translate es rom_nyx_love_unicorn_date_a5cc2a4c:

    # NYX @ laugh "Have to admit, I can't remember the last time I drank this much..."
    NYX @ laugh "Tengo que admitir que no recuerdo la última vez que bebí tanto..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:121
translate es rom_nyx_love_unicorn_date_6edc882f:

    # MC @ smile "Are you trying to tell me the great Captain Nyx can't handle her drink?"
    MC @ smile "¿Estás tratando de decirme que la gran capitana Nyx no puede soportar la bebida?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:123
translate es rom_nyx_love_unicorn_date_d0135504:

    # "Nyx seemed flustered at my comment."
    "Nyx parecía nerviosa ante mi comentario."

# game/data/world_romance/nyx/rom_nyx_love.rpy:124
translate es rom_nyx_love_unicorn_date_a44e6481:

    # NYX @ blush "I enjoy a glass of wine sometimes alone in my chambers..."
    NYX @ blush "Disfruto una copa de vino a veces sola en mis aposentos..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:126
translate es rom_nyx_love_unicorn_date_ef5d2b6b:

    # NYX @ talk "If any of the men actually saw me drunk and in disarray, they'd-"
    NYX @ talk "Si alguno de los hombres me viera borracha y desarreglada, me -"

# game/data/world_romance/nyx/rom_nyx_love.rpy:127
translate es rom_nyx_love_unicorn_date_50f65b83:

    # MC @ talk "Nyx, don't you think that perhaps you're holding yourself to an unreasonable standard?"
    MC @ talk "Nyx, ¿no crees que tal vez te estás exigiendo a ti misma un estándar poco razonable?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:128
translate es rom_nyx_love_unicorn_date_1acdd7a2:

    # MC @ talk "The men would have seen their own commanders drunk at least a thousand times."
    MC @ talk "Los hombres habrían visto a sus propios comandantes borrachos al menos mil veces."

# game/data/world_romance/nyx/rom_nyx_love.rpy:129
translate es rom_nyx_love_unicorn_date_b586922b:

    # NYX @ angry "Their {i}male{/i} commanders."
    NYX @ angry "Sus comandantes {i}masculinos{/i}."

# game/data/world_romance/nyx/rom_nyx_love.rpy:130
translate es rom_nyx_love_unicorn_date_1203310c:

    # NYX @ angry "For them, such a thing is fine, but for me? One of the first female Captains? My enemies would just use it against me..."
    NYX @ angry "Para ellos, algo así está bien, pero ¿para mí? ¿Una de las primeras capitanas? Mis enemigos lo usarían en mi contra..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:131
translate es rom_nyx_love_unicorn_date_6cb749a7:

    # "Nyx paused for a moment, looking around uneasily for anyone she might recognise."
    "Nyx se detuvo por un momento, mirando a su alrededor con inquietud, buscando a alguien que pudiera reconocer."

# game/data/world_romance/nyx/rom_nyx_love.rpy:132
translate es rom_nyx_love_unicorn_date_a89586ab:

    # MC @ sad "...It must get tiresome, being paranoid all the time."
    MC @ sad "... Debe volverse aburrido, ser paranoica todo el tiempo."

# game/data/world_romance/nyx/rom_nyx_love.rpy:133
translate es rom_nyx_love_unicorn_date_1fefa8a1:

    # MC @ think "Always having to keep your guard up like that."
    MC @ think "Siempre manteniendo la guardia en alto."

# game/data/world_romance/nyx/rom_nyx_love.rpy:134
translate es rom_nyx_love_unicorn_date_295efc33:

    # NYX @ talk "Mmm, it's difficult."
    NYX @ talk "Mmm, es difícil."

# game/data/world_romance/nyx/rom_nyx_love.rpy:135
translate es rom_nyx_love_unicorn_date_f819b706:

    # MC @ talk "...And lonely."
    MC @ talk "... Y solitaria."

# game/data/world_romance/nyx/rom_nyx_love.rpy:136
translate es rom_nyx_love_unicorn_date_fbb838ed:

    # NYX @ sad "..."
    NYX @ sad "..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:137
translate es rom_nyx_love_unicorn_date_a481c864:

    # NYX @ talk "Enough dwelling on me, tell me about you."
    NYX @ talk "Ya basta de insistir en mí, cuéntame sobre ti."

# game/data/world_romance/nyx/rom_nyx_love.rpy:138
translate es rom_nyx_love_unicorn_date_80623b65:

    # MC @ talk "Me?"
    MC @ talk "¿A mí?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:139
translate es rom_nyx_love_unicorn_date_16fe6311:

    # NYX @ talk "Yes, {i}you.{/i}"
    NYX @ talk "Sí, {i}tú.{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:140
translate es rom_nyx_love_unicorn_date_bef30c74:

    # NYX @ talk "Not only are you a curiosity given your 'gift,' you've successfully dragged me out here on a night out."
    NYX @ talk "No solo eres una curiosidad dado tu 'don', sino que has conseguido arrastrarme hasta aquí en una noche de fiesta."

# game/data/world_romance/nyx/rom_nyx_love.rpy:141
translate es rom_nyx_love_unicorn_date_7447bcbc:

    # NYX @ talk "Can't a girl at least be a little curious?"
    NYX @ talk "¿No puede una chica al menos ser un poco curiosa?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:142
translate es rom_nyx_love_unicorn_date_dd6427db:

    # MC @ smile "You weren't curious before."
    MC @ smile "Antes no tenías curiosidad."

# game/data/world_romance/nyx/rom_nyx_love.rpy:143
translate es rom_nyx_love_unicorn_date_d525b156:

    # NYX @ talk "That was business, this is supposed to be leisure ... Now, I'm curious."
    NYX @ talk "Eso eran negocios, esto se supone que es ocio... Ahora, tengo curiosidad."

# game/data/world_romance/nyx/rom_nyx_love.rpy:144
translate es rom_nyx_love_unicorn_date_57bc53a9:

    # MC @ talk "What do you want to know?"
    MC @ talk "¿Qué quiere saber?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:145
translate es rom_nyx_love_unicorn_date_0393ffd2:

    # NYX @ talk "First, tell me a little about yourself."
    NYX @ talk "Primero, háblame un poco de ti."

# game/data/world_romance/nyx/rom_nyx_love.rpy:146
translate es rom_nyx_love_unicorn_date_62a82ca4:

    # NYX @ talk "I take it you didn't plan to go into the Scouts, hardly anyone ever does ... So, what did you want to be?"
    NYX @ talk "Supongo que no pensabas entrar en los exploradores, casi nadie lo hace... Entonces, ¿qué querías ser?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:149
translate es rom_nyx_love_unicorn_date_ed6973b7:

    # NYX @ shock "Really?"
    NYX @ shock "¿De verdad?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:150
translate es rom_nyx_love_unicorn_date_e58b3b37:

    # NYX @ talk "That's... surprising."
    NYX @ talk "Eso es... sorprendente."

# game/data/world_romance/nyx/rom_nyx_love.rpy:151
translate es rom_nyx_love_unicorn_date_9abd2c86:

    # MC @ talk "How so?"
    MC @ talk "¿Por qué?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:152
translate es rom_nyx_love_unicorn_date_61bfee97:

    # NYX @ talk "You carry yourself as an Adventurer so well, I just thought you'd have wanted a more ..."
    NYX @ talk "Te desenvuelves tan bien como aventurero, que pensé que habrías querido un..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:153
translate es rom_nyx_love_unicorn_date_8e8a0efd:

    # NYX @ talk "Never mind, it's not like I can hardly blame you for wanting a job like that."
    NYX @ talk "No importa, no es que pueda culparte por querer un trabajo así."

# game/data/world_romance/nyx/rom_nyx_love.rpy:154
translate es rom_nyx_love_unicorn_date_6da35f09:

    # MC @ talk "I figured you'd be disappointed by that answer."
    MC @ talk "Me imaginé que te decepcionaría esa respuesta."

# game/data/world_romance/nyx/rom_nyx_love.rpy:155
translate es rom_nyx_love_unicorn_date_51752f04:

    # NYX @ laugh "Not at all, if anything, we could do with more {i}effective{/i} people running administration."
    NYX @ laugh "En absoluto, en todo caso, nos vendría bien contar con personas más {i}eficaces {/i} al frente de la administración."

# game/data/world_romance/nyx/rom_nyx_love.rpy:156
translate es rom_nyx_love_unicorn_date_708d6718:

    # "Nyx's face became solemn."
    "La cara de Nyx se volvió solemne."

# game/data/world_romance/nyx/rom_nyx_love.rpy:157
translate es rom_nyx_love_unicorn_date_7b0f0bdd:

    # NYX @ talk "Besides ... You and I both know what it's really like out there."
    NYX @ talk "Además... Tú y yo sabemos cómo es realmente ahí fuera."

# game/data/world_romance/nyx/rom_nyx_love.rpy:158
translate es rom_nyx_love_unicorn_date_0cca6b85:

    # NYX @ talk "I could hardly blame anyone for wanting to stay as far away as possible from that."
    NYX @ talk "Difícilmente podría culpar a alguien por querer mantenerse lo más lejos posible de eso."

# game/data/world_romance/nyx/rom_nyx_love.rpy:159
translate es rom_nyx_love_unicorn_date_85d819a4:

    # NYX @ talk "Well, onto my next question!"
    NYX @ talk "Bueno, ¡pasemos a la siguiente pregunta!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:162
translate es rom_nyx_love_unicorn_date_29f5966b:

    # NYX @ talk "Ahhh ... That fits."
    NYX @ talk "Ahhh... Eso encaja."

# game/data/world_romance/nyx/rom_nyx_love.rpy:163
translate es rom_nyx_love_unicorn_date_8b78d05e:

    # NYX @ talk "Well, you've certainly taken well to the role it seems."
    NYX @ talk "Bueno, parece que te has adaptado bien al papel."

# game/data/world_romance/nyx/rom_nyx_love.rpy:164
translate es rom_nyx_love_unicorn_date_3850b462:

    # MC @ talk "Growing up, we'd all heard about the greats, {i}Sir Gregor Iron hands, Marcella the wise,{/i}I guess I couldn't help but be a little inspired."
