

# game/data/world_romance/thea/rom_thea_scr.rpy:3
translate es rom_thea_invite_335cb5c3:

    # THEA @ smile "... Would you be interested perhaps in buying me a drink this evening?"
    THEA @ smile "... ¿Te interesaría invitarme a una copa este anochecer?"

# game/data/world_romance/thea/rom_thea_scr.rpy:4
translate es rom_thea_invite_0cfc087b:

    # MC @ smile "What's brought this on?"
    MC @ smile "¿A qué se debe esto?"

# game/data/world_romance/thea/rom_thea_scr.rpy:5
translate es rom_thea_invite_caddc8f2:

    # THEA @ blush "I've been watching you ... You're already C-tier so fast, normally, it would take adventurers weeks or even months to get where you are."
    THEA @ blush "Te he estado observando... Ya eres de rango C tan rápido, normalmente, a los aventureros les llevaría semanas o incluso meses llegar a donde estás."

# game/data/world_romance/thea/rom_thea_scr.rpy:6
translate es rom_thea_invite_5b9971e5:

    # THEA @ blush "I suppose I want to see what's so special."
    THEA @ blush "Supongo que quiero ver qué tienes de especial."

# game/data/world_romance/thea/rom_thea_scr.rpy:9
translate es rom_thea_invite_8737dc3f:

    # THEA @ blush "I would like that."
    THEA @ blush "Eso me gustaría."

# game/data/world_romance/thea/rom_thea_scr.rpy:10
translate es rom_thea_invite_488d699c:

    # THEA @ smile "I'll be waiting for you there ..."
    THEA @ smile "Te estaré esperando allí..."

# game/data/world_romance/thea/rom_thea_scr.rpy:16
translate es rom_thea_invite_aeabb3e0:

    # THEA @ talk "I-"
    THEA @ talk "Yo-"

# game/data/world_romance/thea/rom_thea_scr.rpy:17
translate es rom_thea_invite_51503df8:

    # THEA @ talk "Very well, let me know when you're more free, perhaps."
    THEA @ talk "Muy bien, avísame cuando estés disponible, tal vez."

# game/data/world_romance/thea/rom_thea_scr.rpy:24
translate es rom_thea_unicorn_12d98976:

    # MC "(I shouldn't bother her anymore tonight.)"
    MC "(No debería molestarla más esta noche)."

# game/data/world_romance/thea/rom_thea_scr.rpy:31
translate es rom_thea_unicorn_3345d6b7:

    # "When Thea saw me from across the room, she smiled and waved, coaxing me over."
    "Cuando Thea me vio desde el otro lado de la habitación, sonrió y me saludó con la mano para que me acercara."

# game/data/world_romance/thea/rom_thea_scr.rpy:32
translate es rom_thea_unicorn_8a756982:

    # THEA @ talk "So glad you could make it."
    THEA @ talk "Me alegro de que pudieras venir."

# game/data/world_romance/thea/rom_thea_scr.rpy:33
translate es rom_thea_unicorn_fc4b9d6f:

    # THEA @ smile "Come, join me for a while ..."
    THEA @ smile "Ven, acompáñame un rato..."

# game/data/world_romance/thea/rom_thea_scr.rpy:37
translate es rom_thea_unicorn_menu1_7429efc5:

    # THEA @ smile2 "Mmm, eager to spend all that coin you've earned adventuring, are you?"
    THEA @ smile2 "Mmm, ansioso por gastar todas esas monedas que has ganado en tus aventuras, ¿verdad?"

# game/data/world_romance/thea/rom_thea_scr.rpy:38
translate es rom_thea_unicorn_menu1_432f2bae:

    # THEA @ smile "There's a nice wine bottle I've been eyeing up, {i}'Huville Cépage'{/i}"
    THEA @ smile "Hay una bonita botella de vino a la que le he estado echando el ojo, {i}'Huville Cépage'{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:39
translate es rom_thea_unicorn_menu1_2eadc668:

    # THEA @ talk "What do you say we share it?"
    THEA @ talk "¿Qué te parece si la compartimos?"

# game/data/world_romance/thea/rom_thea_scr.rpy:63
translate es rom_thea_unicorn_menu2_c07e4cd5:

    # THEA @ smile2 "Oooh!"
    THEA @ smile2 "¡Oooh!"

# game/data/world_romance/thea/rom_thea_scr.rpy:64
translate es rom_thea_unicorn_menu2_c94f142b:

    # "I ordered for the bottle to be fetched, placing the small pouch of coins in Shay's hand as she grabbed it for us."
    "Pedí que trajeran la botella y puse la bolsita de monedas en la mano de Shay, que la cogió para nosotros."

# game/data/world_romance/thea/rom_thea_scr.rpy:65
translate es rom_thea_unicorn_menu2_7eaabd57:

    # THEA @ smile "Cheers!"
    THEA @ smile "¡Salud!"

# game/data/world_romance/thea/rom_thea_scr.rpy:66
translate es rom_thea_unicorn_menu2_ce8ed3e8:

    # MC @ talk "So then, how does a girl like you end up running the Adventures Guild in Novaras?"
    MC @ talk "Entonces, ¿cómo acaba una chica como tú dirigiendo el gremio de aventureros de Novaras?"

# game/data/world_romance/thea/rom_thea_scr.rpy:67
translate es rom_thea_unicorn_menu2_8f95d09a:

    # THEA @ smile "Ahh ... good question!"
    THEA @ smile "Ahh... ¡buena pregunta!"

# game/data/world_romance/thea/rom_thea_scr.rpy:68
translate es rom_thea_unicorn_menu2_9f46be7b:

    # THEA @ talk "My parents travelled to Alderay to settle when I was very young."
    THEA @ talk "Mis padres viajaron a Alderay para instalarse cuando yo era muy pequeña."

# game/data/world_romance/thea/rom_thea_scr.rpy:69
translate es rom_thea_unicorn_menu2_e416d7df:

    # THEA @ talk "Back then, Alderay was welcoming skilled businesses and migrants, and the old owner of the guild house here was ready to retire."
    THEA @ talk "Por aquel entonces, Alderay acogía a empresarios cualificados y emigrantes, y el antiguo propietario de la casa gremial de este lugar estaba a punto de jubilarse."

# game/data/world_romance/thea/rom_thea_scr.rpy:70
translate es rom_thea_unicorn_menu2_b6c617a0:

    # THEA @ talk "So, we bought it off them, and the rest is history."
    THEA @ talk "Así que se lo compramos y el resto es historia."

# game/data/world_romance/thea/rom_thea_scr.rpy:71
translate es rom_thea_unicorn_menu2_ac230468:

    # MC @ talk "Where did you come from originally?"
    MC @ talk "¿De dónde vienes?"

# game/data/world_romance/thea/rom_thea_scr.rpy:72
translate es rom_thea_unicorn_menu2_eb131af5:

    # THEA @ talk "Ah, my family comes from Ramon."
    THEA @ talk "Ah, mi familia viene de Ramon."

# game/data/world_romance/thea/rom_thea_scr.rpy:73
translate es rom_thea_unicorn_menu2_12edaa55:

    # MC @ surprised "Ramon? But, you're-"
    MC @ surprised "¿Ramon? Pero, eres-"

# game/data/world_romance/thea/rom_thea_scr.rpy:74
translate es rom_thea_unicorn_menu2_7b41d1ba:

    # "I stopped myself from prodding too deeply, but Thea just smiled."
    "Me contuve de indagar demasiado, pero Thea se limitó a sonreír."

# game/data/world_romance/thea/rom_thea_scr.rpy:75
translate es rom_thea_unicorn_menu2_44532423:

    # THEA @ smile "It's fine, people always ask about my complexion."
    THEA @ smile "Está bien, la gente siempre me pregunta por mi aspecto."

# game/data/world_romance/thea/rom_thea_scr.rpy:76
translate es rom_thea_unicorn_menu2_4808f1cb:

    # THEA @ talk "You see, we all come from Ramon, but my people, the Khashan, come from the eastern side of the Darjan desert."
    THEA @ talk "Verás, todos venimos de Ramon, pero mi gente, los Khashan, vienen del lado oriental del desierto de Darjan."

# game/data/world_romance/thea/rom_thea_scr.rpy:77
translate es rom_thea_unicorn_menu2_8cc07133:

    # THEA @ talk "The first of us travelled to Alderay to avoid the many hardships of the land."
    THEA @ talk "Los primeros viajamos a Alderay para evitar las muchas penurias de la tierra."

# game/data/world_romance/thea/rom_thea_scr.rpy:78
translate es rom_thea_unicorn_menu2_f57c063a:

    # THEA @ talk "Unlike the West and South-Lands, the East of Ramon is a hard place to live ... Nothing truly grows beneath the scorched sun."
    THEA @ talk "A diferencia de las tierras del este y del sur, el este de Ramon es un lugar duro para vivir... Nada crece verdaderamente bajo el sol abrasador."

# game/data/world_romance/thea/rom_thea_scr.rpy:83
translate es rom_thea_unicorn_menu3_4b1f9620:

    # THEA @ talk "Hmm ... I miss the Darjan mountains, they stretched as far as the eye could see."
    THEA @ talk "Hmm ... Echo de menos las montañas Darjan, se extendían hasta donde alcanzaba la vista."

# game/data/world_romance/thea/rom_thea_scr.rpy:84
translate es rom_thea_unicorn_menu3_8fe065a0:

    # THEA @ talk "As barren and brutal a place as it was to live, it was quite beautiful."
    THEA @ talk "A pesar de lo yermo y brutal que era el lugar para vivir, era bastante hermoso."

# game/data/world_romance/thea/rom_thea_scr.rpy:90
translate es rom_thea_unicorn_menu3_3dfa0b6a:

    # THEA @ angry "What's there to say? They're a greedy, ungrateful bunch."
    THEA @ angry "¿Qué hay que decir? Son unos avariciosos desagradecidos."

# game/data/world_romance/thea/rom_thea_scr.rpy:91
translate es rom_thea_unicorn_menu3_8742f5fd:

    # MC @ talk "That's ... surprising to hear."
    MC @ talk "Eso es... sorprendente de oír."

# game/data/world_romance/thea/rom_thea_scr.rpy:92
translate es rom_thea_unicorn_menu3_93fcdb03:

    # THEA @ sad "Sorry, Ramonian politics is a difficult thing."
    THEA @ sad "Lo siento, la política ramoniana es algo difícil."

# game/data/world_romance/thea/rom_thea_scr.rpy:93
translate es rom_thea_unicorn_menu3_06c01088:

    # THEA @ angry "Let's just say there are reasons we headed to Alderay and didn't just join our cousins in the West."
    THEA @ angry "Digamos que hay razones por las que nos dirigimos a Alderay y no nos limitamos a unirnos a nuestros primos del oeste."

# game/data/world_romance/thea/rom_thea_scr.rpy:94
translate es rom_thea_unicorn_menu3_b488a395:

    # THEA @ angry "They spent years being the oppressors, and now expect sympathy when they wouldn't shed a tear for the rest of us."
    THEA @ angry "Pasaron años siendo los opresores, y ahora esperan simpatía cuando no derramarían ni una lágrima por el resto de nosotros."

# game/data/world_romance/thea/rom_thea_scr.rpy:100
translate es rom_thea_unicorn_menu3_dc53db05:

    # THEA @ smile "Ahh, it was ... different!"
    THEA @ smile "Ahh, era... ¡diferente!"

# game/data/world_romance/thea/rom_thea_scr.rpy:101
translate es rom_thea_unicorn_menu3_ce050630:

    # THEA @ talk "I grew up watching adventurers come and go."
    THEA @ talk "Crecí viendo a aventureros ir y venir."

# game/data/world_romance/thea/rom_thea_scr.rpy:102
translate es rom_thea_unicorn_menu3_c48d55de:

    # THEA @ smile "I quickly learned to pick up which ones I thought had a chance of climbing the ranks, and I usually got pretty good predicting where their limit would be."
    THEA @ smile "Rápidamente aprendí a elegir a los que creía que tenían posibilidades de ascender, y solía ser bastante buena prediciendo cuál sería su límite."

# game/data/world_romance/thea/rom_thea_scr.rpy:109
translate es rom_thea_unicorn_menu3_3328c8e0:

    # THEA @ smile "Where's the fun in telling you that?"
    THEA @ smile "¿Qué gracia tiene decírtelo?"

# game/data/world_romance/thea/rom_thea_scr.rpy:110
translate es rom_thea_unicorn_menu3_d535c815:

    # THEA @ smile2 "{i}... Surprise me.{/i}"
    THEA @ smile2 "{i}... Sorpréndeme.{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:113
translate es rom_thea_unicorn_menu3_14af6c46:

    # THEA @ talk "Quite a few."
    THEA @ talk "Bastantes."

# game/data/world_romance/thea/rom_thea_scr.rpy:114
translate es rom_thea_unicorn_menu3_96fa62ee:

    # THEA @ talk "Lohan the Great, Marhaka {i}'the silver arrow.'{/i}"
    THEA @ talk "Lohan el hrande, Marhaka {i}'la flecha de plata.'{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:115
translate es rom_thea_unicorn_menu3_9561e086:

    # THEA @ sad "But that was all when I was still little."
    THEA @ sad "Pero todo eso fue cuando aún era pequeña."

# game/data/world_romance/thea/rom_thea_scr.rpy:116
translate es rom_thea_unicorn_menu3_0679a78b:

    # THEA @ talk "There aren't really many names left who'd I'd think qualify as legendary these days."
    THEA @ talk "Hoy en día no quedan muchos nombres que yo considere legendarios."

# game/data/world_romance/thea/rom_thea_scr.rpy:117
translate es rom_thea_unicorn_menu3_13f5176a:

    # MC @ talk "What about Celeste?"
    MC @ talk "¿Qué hay de Celeste?"

# game/data/world_romance/thea/rom_thea_scr.rpy:118
translate es rom_thea_unicorn_menu3_82af972f:

    # THEA @ sad "I-"
    THEA @ sad "Yo-"

# game/data/world_romance/thea/rom_thea_scr.rpy:119
translate es rom_thea_unicorn_menu3_f59122f5:

    # THEA @ sad "There's something about her I don't like ... But I can't put my finger on why."
    THEA @ sad "Hay algo en ella que no me gusta... Pero no puedo decir por qué."

# game/data/world_romance/thea/rom_thea_scr.rpy:122
translate es rom_thea_unicorn_menu3_bccad9a6:

    # MC @ smile "So, why did you only agree to meet with me now?"
    MC @ smile "Entonces, ¿por qué solo accediste a reunirte conmigo ahora?"

# game/data/world_romance/thea/rom_thea_scr.rpy:123
translate es rom_thea_unicorn_menu3_612151ad:

    # "Thea smiled, twirling her hair."
    "Thea sonrió, revolviéndose el pelo."

# game/data/world_romance/thea/rom_thea_scr.rpy:124
translate es rom_thea_unicorn_menu3_cef13fe0:

    # THEA @ smile "Well ... You see, the thing is."
    THEA @ smile "Bueno... Verás, la cosa es."

# game/data/world_romance/thea/rom_thea_scr.rpy:125
translate es rom_thea_unicorn_menu3_fcd2fdda:

    # THEA @ smile "I usually spent my time growing up watching adventurers flirt with my mother, and I guess it kinda rubbed off on me."
    THEA @ smile "Normalmente me pasaba el tiempo viendo a los aventureros flirtear con mi madre, y supongo que se me pegó un poco."

# game/data/world_romance/thea/rom_thea_scr.rpy:126
translate es rom_thea_unicorn_menu3_40e310f1:

    # MC @ talk "What about your father, though? He couldn't have liked that."
    MC @ talk "¿Y tu padre? Eso no debió gustarle."

# game/data/world_romance/thea/rom_thea_scr.rpy:127
translate es rom_thea_unicorn_menu3_8ff3ce86:

    # THEA @ talk "There wasn't a lot he could do, besides, Mother was just flirting to buy a few more rounds between quests."
    THEA @ talk "No había mucho que él pudiera hacer, además, madre solo estaba flirteando para comprar unas cuantas rondas más entre misiones."

# game/data/world_romance/thea/rom_thea_scr.rpy:128
translate es rom_thea_unicorn_menu3_d0c386b6:

    # THEA @ blush "T-Though sometimes the adventurers did get a little 'handsy' with her, I suppose."
    THEA @ blush "A-aunque a veces los aventureros se ponían un poco  'tocones' con ella, supongo."

# game/data/world_romance/thea/rom_thea_scr.rpy:129
translate es rom_thea_unicorn_menu3_40b97817:

    # THEA @ smile "But I'm sure she never let it go too far!"
    THEA @ smile "¡Pero estoy segura de que nunca dejó que fuera demasiado lejos!"

# game/data/world_romance/thea/rom_thea_scr.rpy:130
translate es rom_thea_unicorn_menu3_55848778:

    # MC "(I think I'm beginning to see where this fetish of hers has come from)."
    MC "(Creo que empiezo a ver de dónde viene su fetiche)."

# game/data/world_romance/thea/rom_thea_scr.rpy:131
translate es rom_thea_unicorn_menu3_79def2ed:

    # THEA @ smile2 "So, how would you like to come back to mine this evening?"
    THEA @ smile2 "Entonces, ¿te gustaría volver conmigo este anochecer?"

# game/data/world_romance/thea/rom_thea_scr.rpy:132
translate es rom_thea_unicorn_menu3_78109663:

    # THEA @ blush "I think I might have something to help {i}'motivate'{/i} you on your quests."
    THEA @ blush "Creo que podría tener algo que te ayude a {i}'motivarte'{/i} en tus misiones."

# game/data/world_romance/thea/rom_thea_scr.rpy:127
translate es rom_thea_unicorn_menu3_3b8245a4:

    # THEA @ smile "It is."
    THEA @ smile "Lo es."

# game/data/world_romance/thea/rom_thea_scr.rpy:128
translate es rom_thea_unicorn_menu3_31d970ec:

    # THEA @ smile2 "But do you think I'm worth it?"
    THEA @ smile2 "¿Pero crees que valgo la pena?"

# game/data/world_romance/thea/rom_thea_scr.rpy:134
translate es rom_thea_unicorn_menu3_10603dd0:

    # THEA @ sad "{i}*Sigh*{/i}... Never mind then."
    THEA @ sad "{i}*Suspiro*{/i}... No importa entonces."

# game/data/world_romance/thea/rom_thea_scr.rpy:135
translate es rom_thea_unicorn_menu3_cc5378c3:

    # THEA @ talk "Mmm, don't you think you should at least buy a girl a drink first?"
    THEA @ talk "Mmm, ¿no crees que al menos deberías invitar a una chica a una copa primero?"

# game/data/world_romance/thea/rom_thea_scr.rpy:135
translate es rom_thea_unicorn_menu3_ffc63a93:

    # THEA @ sad "Oh? Well ... Alright then."
    THEA @ sad "¿Oh? Bueno... De acuerdo entonces."

# game/data/world_romance/thea/rom_thea_scr.rpy:136
translate es rom_thea_unicorn_menu3_db87ce59:

    # THEA @ talk "You should definitely buy me one when you have some more coin... I'd love to hear more of your adventuring tales."
    THEA @ talk "Deberías comprarme una cuando tengas más dinero... Me encantaría escuchar más de tus historias de aventuras."

# game/data/world_romance/thea/rom_thea_scr.rpy:142
translate es rom_thea_unicorn_menu3_7e4761fb:

    # THEA @ smile2 "Follow me."
    THEA @ smile2 "Sígueme."

# game/data/world_romance/thea/rom_thea_scr.rpy:146
translate es rom_thea_unicorn_menu3_9a148b52:

    # THEA @ talk "Booo ..."
    THEA @ talk "Buuu..."

# game/data/world_romance/thea/rom_thea_scr.rpy:147
translate es rom_thea_unicorn_menu3_06d4a6e1:

    # THEA @ smile "Well maybe next time then."
    THEA @ smile "Bueno, tal vez la próxima vez entonces."

# game/data/world_romance/thea/rom_thea_scr.rpy:162
translate es rom_thea_after_date_e86c7592:

    # "Thea led me back towards the Adventurers Guild, but this time, she led me behind the counter up the stairs towards her bedroom."
    "Thea me llevó de nuevo hacia el gremio de aventureros, pero esta vez me llevó detrás del mostrador, escaleras arriba, hacia su dormitorio."

# game/data/world_romance/thea/rom_thea_scr.rpy:168
translate es rom_thea_after_date_6b744a36:

    # "Into her bedroom, Thea led me, quickly getting the fire going before she twirled around and smiled alluringly."
    "Thea me llevó a su dormitorio y encendió rápidamente el fuego antes de girar sobre sí misma y sonreír seductoramente."

# game/data/world_romance/thea/rom_thea_scr.rpy:169
translate es rom_thea_after_date_cd42ee40:

    # MC @ smile "So then, what was it you wanted to give me?"
    MC @ smile "Entonces, ¿qué era lo que querías darme?"

# game/data/world_romance/thea/rom_thea_scr.rpy:174
translate es rom_thea_after_date_e56d5240:

    # THEA @ smile "Ah, hello again... I trust you've been busy with all your adventures?"
    THEA @ smile "Ah, hola de nuevo... ¿Supongo que has estado ocupado con todas tus aventuras?"

# game/data/world_romance/thea/rom_thea_scr.rpy:176
translate es rom_thea_after_date_6917aa30:

    # THEA @ talk "Do you mind waiting here for a moment, this will only take a few minutes."
    THEA @ talk "¿Te importaría esperar aquí un momento? Solo serán unos minutos."

# game/data/world_romance/thea/rom_thea_scr.rpy:177
translate es rom_thea_after_date_a3b52944:

    # MC @ smile "Of course."
    MC @ smile "Por supuesto."

# game/data/world_romance/thea/rom_thea_scr.rpy:179
translate es rom_thea_after_date_2ecf6da7:

    # "Thea hurried off for a few moments, and after briefly looking around her room, the door swung open, and Thea re-emerged."
    "Thea se alejó unos instantes y, tras echar un breve vistazo a su habitación, la puerta se abrió y Thea volvió a salir."

# game/data/world_romance/thea/rom_thea_scr.rpy:183
translate es rom_thea_after_date_42fc426f:

    # THEA @ blush "{i}... Do you think 'this' will help motivate you?{/i}"
    THEA @ blush "{i}... ¿Crees que 'esto' te ayudará a motivarte?{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:184
translate es rom_thea_after_date_4c4699f9:

    # MC @ lewd "I'm feeling motivated already."
    MC @ lewd "Ya me siento motivado."

# game/data/world_romance/thea/rom_thea_scr.rpy:187
translate es rom_thea_after_date_9c1a9a0d:

    # "Giggling to herself, Thea stepped forward and pushed me down onto her bed, moving swiftly to strip the clothes off of me."
    "Riéndose para sus adentros, Thea dio un paso adelante y me empujó hacia su cama, moviéndose rápidamente para quitarme la ropa."

# game/data/world_romance/thea/rom_thea_scr.rpy:188
translate es rom_thea_after_date_9fc4282e:

    # THEA "I've been working on a little ... {i}dance{/i} that I want to show you."
    THEA "He estado trabajando en un pequeño... {i}baile{/i} que quiero enseñarte."

# game/data/world_romance/thea/rom_thea_scr.rpy:189
translate es rom_thea_after_date_a092ffec:

    # THEA "Tell me ... What do you think of what I'm wearing?"
    THEA "Dime... ¿Qué piensas de lo que llevo puesto?"

# game/data/world_romance/thea/rom_thea_scr.rpy:199
translate es rom_thea_after_date_d015e2eb:

    # THEA "Just keep still ... {i}You're going to enjoy this.{/i}"
    THEA "Solo quédate quieto... {i}Vas a disfrutar con esto.{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:206
translate es rom_thea_after_date_7f8e466b:

    # "As Thea danced sensuously in front of me, the light from the fireplace flickered."
