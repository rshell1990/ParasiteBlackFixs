

# game/data/world_romance/ves/scr_1_GetMeds.rpy:10
translate es rom_Ves_1_GetMeds_3a6566bb:

    # "Entering her tent, I saw Ves."
    "Al entrar en su tienda, vi a Ves."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:11
translate es rom_Ves_1_GetMeds_defed448:

    # "She seemed concerned over something, but dropped it the moment I appeared."
    "Parecía preocupada por algo, pero lo dejó en cuanto aparecí."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:12
translate es rom_Ves_1_GetMeds_e96c270d:

    # MC @ talk "Still surviving, I see."
    MC @ talk "Aún sobreviviendo, por lo que veo."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:13
translate es rom_Ves_1_GetMeds_73dde02e:

    # VES @ talk "Is there a reason you keep coming back here, human?"
    VES @ talk "¿Hay alguna razón por la que sigas viniendo aquí, humano?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:14
translate es rom_Ves_1_GetMeds_8ca20c45:

    # MC @ talk "No, just making sure you don’t need anything."
    MC @ talk "No, solo me aseguro de que no necesites nada."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:15
translate es rom_Ves_1_GetMeds_6a351dcb:

    # VES @ talk "{i}*Sigh*{/i} I am fine."
    VES @ talk "{i}*Suspiro*{/i} Estoy bien."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:16
translate es rom_Ves_1_GetMeds_d993b3a8:

    # VES @ talk "Why do you persist in checking up on me?"
    VES @ talk "¿Por qué insistes en visitarme?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:17
translate es rom_Ves_1_GetMeds_57beabd5:

    # VES @ talk "Is this some kind of trick?"
    VES @ talk "¿Es algún tipo de truco?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:20
translate es rom_Ves_1_GetMeds_d8e76303:

    # VES @ talk "You... Is this human humour?"
    VES @ talk "Tú... ¿Es esto humor humano?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:21
translate es rom_Ves_1_GetMeds_467b5b92:

    # MC @ talk "More like sarcasm."
    MC @ talk "Más bien sarcasmo."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:22
translate es rom_Ves_1_GetMeds_8de1629b:

    # VES @ talk "... Is that some kind of fish?"
    VES @ talk "... ¿Es algún tipo de pez?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:23
translate es rom_Ves_1_GetMeds_0e82ffe0:

    # MC @ talk "It’s... Never mind."
    MC @ talk "Es... Olvídalo."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:24
translate es rom_Ves_1_GetMeds_8aaf2369:

    # "Ves contemplated my words for a moment, unsure if I was insulting her or not before shaking her head in annoyance."
    "Ves contempló mis palabras un momento, insegura de si la estaba insultando o no, antes de sacudir la cabeza, molesta."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:26
translate es rom_Ves_1_GetMeds_db261632:

    # VES @ talk "Why? Why are you concerned about me?"
    VES @ talk "¿Por qué? ¿Por qué te preocupas por mí?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:29
translate es rom_Ves_1_GetMeds_de79ebb8:

    # VES @ talk "I have been {i}alone{/i} most of my life..."
    VES @ talk "He estado {i}sola{/i} la mayor parte de mi vida..."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:30
translate es rom_Ves_1_GetMeds_c3085500:

    # VES @ talk "Most of my friends and family are dead."
    VES @ talk "La mayoría de mis amigos y familiares están muertos."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:31
translate es rom_Ves_1_GetMeds_ab64a171:

    # MC @ talk "... Ves."
    MC @ talk "... Ves."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:32
translate es rom_Ves_1_GetMeds_aa032b2d:

    # VES @ talk "... {i}War{/i} is not kind to those with many friends."
    VES @ talk "... {i}La guerra{/i} no es amable con los que tienen muchos amigos."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:33
translate es rom_Ves_1_GetMeds_fa60b413:

    # VES @ talk "You are better off alone."
    VES @ talk "Estás mejor solo."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:35
translate es rom_Ves_1_GetMeds_5bf4ee31:

    # VES @ talk "seemed taken aback by the comment."
    VES @ talk "Parece sorprendida por el comentario."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:36
translate es rom_Ves_1_GetMeds_9113ab37:

    # VES @ talk "You... You are a very strange man!"
    VES @ talk "Tú... ¡Eres un hombre muy extraño!"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:37
translate es rom_Ves_1_GetMeds_317a1bc5:

    # MC @ talk "Well... I guess I can’t argue with that."
    MC @ talk "Bueno... Supongo que no puedo discutir eso."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:39
translate es rom_Ves_1_GetMeds_72c189d4:

    # VES @ talk "blushed at the comment, her eyes widened in surprise."
    VES @ talk "Se sonrojó ante el comentario, sus ojos se abrieron de par en par por la sorpresa."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:40
translate es rom_Ves_1_GetMeds_00de3c72:

    # VES @ talk "You... {i}What?{/i}"
    VES @ talk "Tú... {i}¿Qué?{/i}"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:41
translate es rom_Ves_1_GetMeds_dbdc554e:

    # MC @ talk " I, uhh, that was supposed to make you laugh..."
    MC @ talk "Yo, uhh, eso se suponía que te haría reír..."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:42
translate es rom_Ves_1_GetMeds_9eddd4ce:

    # VES @ talk "Why would you say such a thing?"
    VES @ talk "¿Por qué dirías algo así?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:43
translate es rom_Ves_1_GetMeds_088271bc:

    # "Ves raised her axes towards me once again."
    "Ves levantó sus hachas hacia mí una vez más."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:44
translate es rom_Ves_1_GetMeds_68db8006:

    # VES @ talk "Is this some kind of mind game sorcery?"
    VES @ talk "¿Es algún tipo de brujería de juego mental?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:45
translate es rom_Ves_1_GetMeds_7b8bca72:

    # MC @ talk "Hey hey! It’s just a little flirting!"
    MC @ talk "¡Oye, oye! ¡Es solo un poco de coqueteo!"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:46
translate es rom_Ves_1_GetMeds_37bfa6ce:

    # VES @ talk "Flirting?"
    VES @ talk "¿Coqueteando?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:47
translate es rom_Ves_1_GetMeds_f5f26d0d:

    # MC @ talk "You know! Like, I was just joking around a little to try and make you laugh!"
    MC @ talk "¡Ya sabes! ¡Solo bromeaba un poco para intentar hacerte reír!"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:48
translate es rom_Ves_1_GetMeds_097039bc:

    # "Strangely Ves’ eyes seemed to darken as her usual cold expression quickly returned to her features."
    "Extrañamente, los ojos de Ves parecieron oscurecerse mientras su habitual expresión fría volvía rápidamente a sus facciones."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:49
translate es rom_Ves_1_GetMeds_4c107f68:

    # VES @ talk " ... Oh... A joke... Yes."
    VES @ talk "... Oh... Una broma... Sí."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:50
translate es rom_Ves_1_GetMeds_e41c0c2c:

    # VES @ talk "I know what those are."
    VES @ talk "Sé lo que son."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:51
translate es rom_Ves_1_GetMeds_29b75621:

    # MC @ talk "Uhh, it wasn’t— "
    MC @ talk "Uhh, no era— "

# game/data/world_romance/ves/scr_1_GetMeds.rpy:52
translate es rom_Ves_1_GetMeds_4999deb8:

    # VES @ talk "..."
    VES @ talk "..."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:53
translate es rom_Ves_1_GetMeds_b4e9daec:

    # MC @ talk "... Never mind."
    MC @ talk "... No importa."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:57
translate es rom_Ves_1_GetMeds_c58f0235:

    # MC @ talk "Look, do you need anything out here?"
    MC @ talk "Mira, ¿necesitas algo aquí fuera?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:58
translate es rom_Ves_1_GetMeds_a717f106:

    # MC @ talk "Supplies? Food? Water?"
    MC @ talk "¿Suministros? ¿Alimentos? ¿Agua?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:59
translate es rom_Ves_1_GetMeds_41fbb86b:

    # MC @ talk "I can bring whatever you need from Novaras if you want."
    MC @ talk "Puedo traer lo que necesites de Novaras si quieres."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:60
translate es rom_Ves_1_GetMeds_b36e9136:

    # MC @ talk "If you’re going to stubbornly continue to stay out here, the least you could do is let me get you some stuff to help."
    MC @ talk "Si vas a seguir obstinada en quedarte aquí fuera, lo menos que podrías hacer es dejarme que te traiga algo para ayudarte."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:61
translate es rom_Ves_1_GetMeds_85e6d59d:

    # VES @ talk "... I suppose..."
    VES @ talk "... Supongo que..."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:62
translate es rom_Ves_1_GetMeds_91b26516:

    # VES @ talk "I could do with some medicine if there is any."
    VES @ talk "Me vendría bien un poco de medicinas, si hay."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:63
translate es rom_Ves_1_GetMeds_1d63c4c1:

    # MC @ talk "Medicine? Are you sick?"
    MC @ talk "¿Medicinas? ¿Estás enferma?"

# game/data/world_romance/ves/scr_1_GetMeds.rpy:64
translate es rom_Ves_1_GetMeds_58db977f:

    # VES @ talk "No, but... I was stung by some beast a few nights ago and found myself in a terrible fever the nights that followed."
    VES @ talk "No, pero... Me picó una bestia hace unas noches y me encontré con una fiebre terrible las noches siguientes."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:65
translate es rom_Ves_1_GetMeds_1eba9804:

    # VES @ talk "It was lucky I had stocked up on enough food and water to survive but..."
    VES @ talk "Tuve suerte de tener suficiente comida y agua para sobrevivir, pero..."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:66
translate es rom_Ves_1_GetMeds_09cecb7d:

    # VES @ talk "Next time I may not be so lucky."
    VES @ talk "La próxima vez puede que no tenga tanta suerte."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:67
translate es rom_Ves_1_GetMeds_fda4aa0f:

    # MC @ talk "... Alright."
    MC @ talk "... Está bien."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:68
translate es rom_Ves_1_GetMeds_36c78b08:

    # MC @ talk " I’ll see what I can do."
    MC @ talk "Veré lo que puedo hacer."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:69
translate es rom_Ves_1_GetMeds_d9b0f4ef:

    # "As I turned to leave, Ves’ hand raised to stop me and her mouth hung open to say something, but instead, she paused and withdrew once again."
    "Cuando me di la vuelta para marcharme, la mano de Ves se levantó para detenerme y su boca quedó abierta para decir algo, pero en lugar de eso, hizo una pausa y se retiró de nuevo."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:71
translate es rom_Ves_1_GetMeds_7b62683d:

    # MC "(If it’s anti-venom and potions for healing I’m looking for, the Mages of Palam would be my best bet.)"
    MC "(Si lo que busco son antivenenos y pociones curativas, las magas de Palam serían mi mejor opción)."

# game/data/world_romance/ves/scr_1_GetMeds.rpy:72
translate es rom_Ves_1_GetMeds_c3b90adf:

    # MC "(They have an entire tower at the Mage’s Academy devoted to the goddess Palam... I should head there.)"
    MC "(Tienen una torre entera en la Academia de Magos dedicada a la diosa Palam... Debería dirigirme allí)"

translate es strings:

    # game/data/world_romance/ves/scr_1_GetMeds.rpy:18
    old "Oh yeah, me skipping out into the middle of the desert to check up on you is all just part of some elaborate joke."
    new "Ah, sí, que me vaya al medio del desierto a ver cómo estás es parte de una elaborada broma."

    # game/data/world_romance/ves/scr_1_GetMeds.rpy:18
    old "It’s not a trick, Ves... I’m concerned about you."
    new "No es una broma, Ves... Estoy preocupado por ti."

    # game/data/world_romance/ves/scr_1_GetMeds.rpy:27
    old "Because you’re all alone out here."
    new "Porque estás sola aquí fuera."

    # game/data/world_romance/ves/scr_1_GetMeds.rpy:27
    old "I don’t know... Just because, I suppose..."
    new "No sé... Solo porque, supongo..."

    # game/data/world_romance/ves/scr_1_GetMeds.rpy:27
    old "Oh, I’m just trying to woo you into taking your clothes off if we’re being honest."
    new "Oh, solo estoy tratando de cortejarte para que te quites la ropa siendo honesto."
