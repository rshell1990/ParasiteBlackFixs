

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:2
translate es rom_Ves_2_FortAndCook_Rev_e399c0fc:

    # VES @ talk "Yes, sure!"
    VES @ talk "¡Sí, claro!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:3
translate es rom_Ves_2_FortAndCook_Rev_33e02ec9:

    # VES @ talk "I plan to set up some perimeter defences, just some bells and such on a wire that will jingle in case anyone tries to sneak in here."
    VES @ talk "Planeo establecer algunas defensas perimetrales, solo algunos cascabeles y cosas así en un alambre que tintinee en caso de que alguien intente colarse aquí."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:9
translate es rom_Ves_2_FortAndCook_Rev_f515fabb:

    # VES @ talk "... Oh, well, let me know when you’re able to, I suppose..."
    VES @ talk "...Bueno, avísame cuando puedas, supongo..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:15
translate es rom_Ves_2_FortAndCook_94bfba8b:

    # VES @ talk "Great, let me get the stuff ready..."
    VES @ talk "Genial, déjame preparar las cosas..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:20
translate es rom_Ves_2_FortAndCook_1bb29bdd:

    # "Over the next hour or so, Ves and I began to set up some primitive defences around her camp."
    "Durante la hora siguiente, Ves y yo empezamos a levantar algunas defensas rudimentarias alrededor de su campamento."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:22
translate es rom_Ves_2_FortAndCook_c0c4d85f:

    # "A few spikes in the ground here and there alongside a wire running the camp’s perimeter..."
    "Unos cuantos pinchos en el suelo aquí y allá junto a un cable que recorre el perímetro del campamento..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:24
translate es rom_Ves_2_FortAndCook_96d5e6db:

    # "If someone knocked it with their foot, it would jingle the attached glass bottles and miscellaneous goods loudly enough to alert Ves of their presence."
    "Si alguien la golpeara con el pie, haría tintinear las botellas de cristal y otros objetos lo bastante fuerte como para alertar a Ves de su presencia."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:26
translate es rom_Ves_2_FortAndCook_840a3072:

    # "And God help them when it did."
    "Y que dios les ayude cuando así sea."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:27
translate es rom_Ves_2_FortAndCook_d5275d4b:

    # "Wiping the sweat from my brow as I hammered in one of the posts and secured it in place, I noticed Ves sneakily watched me the whole time, still cautiously half alert to my presence as a human, and half with a great deal of curiosity."
    "Secándome el sudor de la frente mientras clavaba uno de los postes y lo aseguraba en su sitio, me di cuenta de que Ves me observaba furtivamente todo el tiempo, todavía cautelosa, medio alerta a mi presencia como humana y medio con mucha curiosidad."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:35
translate es rom_Ves_2_FortAndCook_4d690972:

    # VES @ talk "You are strong."
    VES @ talk "Eres fuerte."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:36
translate es rom_Ves_2_FortAndCook_6fb5dd4e:

    # "She watched me force one of the wooden posts into the ground."
    "Me vio clavar uno de los postes de madera en el suelo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:37
translate es rom_Ves_2_FortAndCook_3fcdb530:

    # MC @ talk "Yeah, when this {i}thing{/i} inside of me attached itself, it changed my body as well."
    MC @ talk "Sí, cuando esta {i}cosa{/i} dentro de mí se adhirió, cambió mi cuerpo también."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:38
translate es rom_Ves_2_FortAndCook_aef1c638:

    # VES @ talk "... I see."
    VES @ talk "... Ya veo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:41
translate es rom_Ves_2_FortAndCook_ffbe6e66:

    # "Ves continued to observe as I worked until the sun began to set. If I caught her staring, she quickly made sure to look away and carry on working elsewhere, usually coiling the wires around the posts."
    "Ves siguió observando mientras yo trabajaba hasta que el sol empezó a ponerse. Si la sorprendía mirando, se aseguraba rápidamente de apartar la mirada y seguir trabajando en otra parte, normalmente enrollando los cables alrededor de los postes."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:49
translate es rom_Ves_2_FortAndCook_5278c1eb:

    # MC @ talk "Alright... That’s about everything, I think."
    MC @ talk "Muy bien... Eso es todo, creo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:50
translate es rom_Ves_2_FortAndCook_ad5a8665:

    # VES @ talk "Yes, this is good."
    VES @ talk "Sí, está bien."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:51
translate es rom_Ves_2_FortAndCook_101cd48e:

    # VES "..."
    VES "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:53
translate es rom_Ves_2_FortAndCook_0e5b05f2:

    # VES @ talk "Are you free for a few more hours?"
    VES @ talk "¿Estás libre unas horas más?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:54
translate es rom_Ves_2_FortAndCook_3ff3a479:

    # MC @ talk "What for?"
    MC @ talk "¿Para qué?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:55
translate es rom_Ves_2_FortAndCook_24f33162:

    # VES @ talk "Would you care to join me for food?"
    VES @ talk "¿Te gustaría acompañarme a comer?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:56
translate es rom_Ves_2_FortAndCook_25a6adf5:

    # MC @ talk "Food?"
    MC @ talk "¿Comer?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:57
translate es rom_Ves_2_FortAndCook_b3cb40ff:

    # VES @ talk "Yes... You must be hungry by now."
    VES @ talk "Sí... Ya debes tener hambre."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:58
translate es rom_Ves_2_FortAndCook_83ddd484:

    # VES @ talk "{i}And...{/i}"
    VES @ talk "{i}Y...{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:59
translate es rom_Ves_2_FortAndCook_d67a7314:

    # VES @ talk "It would be nice to have some company for a change."
    VES @ talk "Estaría bien tener compañía para variar."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:60
translate es rom_Ves_2_FortAndCook_ee88f5f9:

    # MC @ talk "... Sure, Ves, I’ll stay for some food."
    MC @ talk "... Claro, Ves, me quedaré a comer algo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:61
translate es rom_Ves_2_FortAndCook_6a2a3f7b:

    # MC @ talk "I’m pretty hungry myself anyway."
    MC @ talk "De todos modos, tengo bastante hambre."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:62
translate es rom_Ves_2_FortAndCook_cd9ef004:

    # "Ves perked up with an actual smile."
    "Ves se animó con una sonrisa."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:63
translate es rom_Ves_2_FortAndCook_cf7b5d91:

    # VES @ talk "Good!"
    VES @ talk "¡Bien!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:64
translate es rom_Ves_2_FortAndCook_79c1b828:

    # VES @ talk "I’ll get started on preparing the meat!"
    VES @ talk "¡Empezaré a preparar la carne!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:66
translate es rom_Ves_2_FortAndCook_d55bc3a1:

    # "With that Ves hurried off to begin cooking. As she bent forward to grab some pots and pans, I stared at her cute ass as it shifted through the gossamer material gathered around it."
    "Ves se puso a cocinar. Cuando se inclinó para coger algunos cacharros y sartenes, me quedé mirando su bonito culo, que se movía a través de la tela de rejilla que lo envolvía."
# game/data/world_romance/ves/scr_2_FortAndCook.rpy:67
translate es rom_Ves_2_FortAndCook_30cd150e:

    # BLACK "... This one I like."
    BLACK "... Esta me gusta."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:68
translate es rom_Ves_2_FortAndCook_e9c1fe99:

    # BLACK "She smells... {i}very appealing{/i}."
    BLACK "Huele... {i}muy atractiva{/i}."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:69
translate es rom_Ves_2_FortAndCook_ffba0f79:

    # "From the corner of her eye, Ves looked back frequently over her shoulder at me, and from her expression, she must have realised that I kept glancing towards her as well because she'd shyly pull away."
    "Por el rabillo del ojo, Ves me miraba con frecuencia por encima del hombro y, por su expresión, debió de darse cuenta de que yo también la miraba porque se apartaba tímidamente."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:70
translate es rom_Ves_2_FortAndCook_efe19f2e:

    # "I did my best to look away, coughing awkwardly to break the strange tension."
    "Hice todo lo posible por apartar la mirada, tosiendo torpemente para romper la extraña tensión."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:71
translate es rom_Ves_2_FortAndCook_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:72
translate es rom_Ves_2_FortAndCook_efb9de0e:

    # BLACK "... Her heart rate has just increased exponentially, is she in heat and ready to procreate?"
    BLACK "...Su ritmo cardíaco acaba de aumentar exponencialmente, ¿está en celo y lista para procrear?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:73
translate es rom_Ves_2_FortAndCook_912591a3:

    # MC @ angry "Would you shut up?!"
    MC @ angry "¡¿Quieres callarte?!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:78
translate es rom_Ves_2_FortAndCook_e4278626:

    # "Ves spun to look back at me, visible confusion on her face."
    "Ves giró para mirarme, con una visible confusión en el rostro."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:79
translate es rom_Ves_2_FortAndCook_6eb77fc4:

    # MC @ surprised "It’s... It’s the thing."
    MC @ surprised "Es... Es la cosa."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:80
translate es rom_Ves_2_FortAndCook_1c238644:

    # MC @ talk "It can speak to me in my head."
    MC @ talk "Puede hablarme en mi cabeza."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:81
translate es rom_Ves_2_FortAndCook_57f92f4e:

    # "Ves, now a little concerned, simply mouthed an ‘Oh’ as she quickly decided not to ponder too much on it and instead carried on grabbing what she needed."
    "Ves, un poco preocupada, se limitó a pronunciar un ‘Oh’ y rápidamente decidió no darle demasiadas vueltas y seguir cogiendo lo que necesitaba."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:84
translate es rom_Ves_2_FortAndCook_748fee9b:

    # "We sat around the warm blazing fire outside of her tent, chewing on the tender meat from our hunt skewered onto sticks which we cooked over the flames."
    "Nos sentamos alrededor del cálido fuego que ardía fuera de su tienda, masticando la tierna carne de nuestra cacería ensartada en palos que cocinábamos sobre las llamas."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:85
translate es rom_Ves_2_FortAndCook_bd8ba4fd:

    # "It was quiet tonight, and the fire provided the only light around for what must have been miles."
    "La noche era tranquila, y el fuego era la única luz en lo que debían de ser kilómetros a la redonda."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:95
translate es rom_Ves_2_FortAndCook_7effd6c2:

    # "Ves waited and watched eagerly as I sat there with the meat on a stick, looking queasily at it as she observed me, waiting with bated breath as I took a tentative bite from it."
    "Ves esperó y observó con impaciencia mientras yo me sentaba con la carne en un palo, mirándola con inquietud mientras ella me observaba, esperando con la respiración contenida mientras yo le daba un mordisco tentativo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:96
translate es rom_Ves_2_FortAndCook_0aa278e1:

    # MC @ talk "... It’s good."
    MC @ talk "... Está bueno."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:97
translate es rom_Ves_2_FortAndCook_a4c6456f:

    # "Ves' eyes seemed to glitter in the embers of the fire as she smiled triumphantly, her fists raised into the night air."
    "Los ojos de Ves parecían brillar en las brasas del fuego mientras sonreía triunfante, con los puños alzados en el aire nocturno."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:98
translate es rom_Ves_2_FortAndCook_f1f8a99a:

    # VES @ talk "YES!"
    VES @ talk "¡SÍ!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:99
translate es rom_Ves_2_FortAndCook_d99bc996:

    # VES @ talk "My tribe said I’d never be a good cook!"
    VES @ talk "¡Mi tribu decía que nunca sería una buena cocinera!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:100
translate es rom_Ves_2_FortAndCook_dd141836:

    # VES @ talk "Ha! They would eat dirt if they were here!"
    VES @ talk "¡Ja! ¡Comerían tierra si estuvieran aquí!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:101
translate es rom_Ves_2_FortAndCook_a58b53ef:

    # MC @ talk "How big is your tribe?"
    MC @ talk "¿Qué tamaño tiene tu tribu?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:102
translate es rom_Ves_2_FortAndCook_486ed9ca:

    # VES @ talk "Hm? Oh well, I think there’s about a hundred altogether..."
    VES @ talk "¿Hm? Bueno, creo que hay unos cien en total..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:103
translate es rom_Ves_2_FortAndCook_95cc3756:

    # MC @ talk "A hundred?!"
    MC @ talk "¡¿Cien?!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:105
translate es rom_Ves_2_FortAndCook_128cb1f3:

    # "Ves laughed."
    "Ves se rió."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:106
translate es rom_Ves_2_FortAndCook_66700141:

    # VES @ talk "It’s a small tribe. The tribes all fall under the rule of the Great Chieftain should he command us, but all tribes are led by their Elders."
    VES @ talk "Es una tribu pequeña. Todas las tribus están bajo el mando del gran jefe en caso de que nos mande, pero todas las tribus están dirigidas por sus ancianos."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:107
translate es rom_Ves_2_FortAndCook_d3eed914:

    # "Ves took a bite of her food and smiled."
    "Ves dio un bocado a su comida y sonrió."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:108
translate es rom_Ves_2_FortAndCook_632b2da1:

    # VES @ talk "Mmm, just needs some more salt..."
    VES @ talk "Mmm, solo necesita un poco más de sal..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:109
translate es rom_Ves_2_FortAndCook_9a799022:

    # VES @ talk "In Skarshire, there are so many different spices and flavours for food."
    VES @ talk "En Skarshire, hay muchas especias y sabores diferentes para la comida."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:110
translate es rom_Ves_2_FortAndCook_e7a60ff6:

    # MC @ talk "I’ve never been."
    MC @ talk "Nunca he estado allí."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:111
translate es rom_Ves_2_FortAndCook_e3c60fc3:

    # VES @ talk "Skarshire is beautiful, many small islands are interconnected. Our own little archipelago."
    VES @ talk "Skarshire es hermoso, muchas islas pequeñas están interconectadas. Nuestro propio pequeño archipiélago."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:112
translate es rom_Ves_2_FortAndCook_00c0a271:

    # VES @ talk "The water is so blue..."
    VES @ talk "El agua es tan azul..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:113
translate es rom_Ves_2_FortAndCook_dd9c2863:

    # VES @ talk "Perhaps one day I will show—"
    VES @ talk "Tal vez un día te enseñe—"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:115
translate es rom_Ves_2_FortAndCook_b236ea86:

    # "Ves paused, the smile dropping from her face. "
    "Ves hizo una pausa y se le borró la sonrisa de la cara."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:116
translate es rom_Ves_2_FortAndCook_d3463ab9:

    # VES @ talk "Never mind."
    VES @ talk "No importa."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:117
translate es rom_Ves_2_FortAndCook_293b9424:

    # MC @ talk "... What? What is it?"
    MC @ talk "...¿Qué? ¿Qué es?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:118
translate es rom_Ves_2_FortAndCook_a72d3f88:

    # VES @ talk "It’s not going to happen — humans and orcs do not mix."
    VES @ talk "No va a suceder — los humanos y los orcos no se mezclan."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:119
translate es rom_Ves_2_FortAndCook_2098e538:

    # MC @ talk "... We seem to get on pretty well."
    MC @ talk "...Parece que nos llevamos bastante bien."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:120
translate es rom_Ves_2_FortAndCook_4f90784e:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:121
translate es rom_Ves_2_FortAndCook_6798a12e:

    # MC @ talk "Aren’t we proof it doesn’t have to just be fighting?"
    MC @ talk "¿No somos la prueba de que no solo hay que pelear?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:122
translate es rom_Ves_2_FortAndCook_20caadc0:

    # VES @ talk "It’s not merely about just getting on! There is... too much pain... too much hate for that to happen."
    VES @ talk "¡No se trata simplemente de seguir adelante! Hay... demasiado dolor... demasiado odio para que eso ocurra."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:123
translate es rom_Ves_2_FortAndCook_18a9b1cb:

    # MC @ talk "Not all humans are the same, Ves."
    MC @ talk "No todos los humanos son iguales, Ves."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:124
translate es rom_Ves_2_FortAndCook_6e4a5cbd:

    # VES @ talk "I know that!"
    VES @ talk "¡Lo sé!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:125
translate es rom_Ves_2_FortAndCook_bdcf49f1:

    # VES @ talk "But a human wouldn’t understand."
    VES @ talk "Pero un humano no lo entendería."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:126
translate es rom_Ves_2_FortAndCook_56cc6176:

    # MC @ talk "Then try, try to make me understand!"
    MC @ talk "¡Entonces inténtalo, intenta hacerme entender!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:128
translate es rom_Ves_2_FortAndCook_4d056001:

    # VES @ sad_talk "... Our people have been slaves for generations."
    VES @ sad_talk "...Nuestro pueblo ha sido esclavo durante generaciones."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:129
translate es rom_Ves_2_FortAndCook_27f3f3d6:

    # VES @ sad_talk "Rape... Violence... Torture..."
    VES @ sad_talk "Violación... Violencia... Tortura..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:130
translate es rom_Ves_2_FortAndCook_32d10626:

    # VES @ sad_talk "These things are everyday occurrences for the orcs still bound by their master’s whips. "
    VES @ sad_talk "Estas cosas son cotidianas para los orcos aún atados por los látigos de su amo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:131
translate es rom_Ves_2_FortAndCook_b97e9576:

    # VES @ sad_talk "Made to feel an ugly people... Made to feel {i}dirty.{/i}"
    VES @ sad_talk "Hecho para sentirse gente fea... Hecho para sentirse {i}sucio.{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:132
translate es rom_Ves_2_FortAndCook_d1296db1:

    # VES @ sad_talk "Nothing but shame has been brought and inflicted upon us."
    VES @ sad_talk "No nos han traído más que vergüenza."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:133
translate es rom_Ves_2_FortAndCook_3fa7e5b2:

    # MC @ talk "But that was the Greater Trading Company! What does that have to do with the rest of us?"
    MC @ talk "¡Pero eso era la Gran Compañía Comercial! ¿Qué tiene eso que ver con el resto de nosotros?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:135
translate es rom_Ves_2_FortAndCook_b5661854:

    # VES @ angry_talk "No!"
    VES @ angry_talk "¡No!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:137
translate es rom_Ves_2_FortAndCook_35d5211c:

    # "Ves rose to her feet furiously, anger simmering beneath her voice."
    "Ves se levantó furiosa, con la rabia hirviendo a fuego lento bajo su voz."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:138
translate es rom_Ves_2_FortAndCook_139e9c93:

    # VES @ angry_talk "You are all the same!"
    VES @ angry_talk "¡Sois todos iguales!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:139
translate es rom_Ves_2_FortAndCook_16b1882c:

    # VES @ angry_talk "Alderay, YOUR PEOPLE, have been sending our enemies weapons, have been sending them supplies!"
    VES @ angry_talk "Alderay, TU GENTE, ha estado enviando armas a nuestros enemigos, ¡ha estado enviándoles suministros!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:140
translate es rom_Ves_2_FortAndCook_9832729d:

    # VES @ angry_talk "Why? For gold!"
    VES @ angry_talk "¿Por qué? ¡Por el oro!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:141
translate es rom_Ves_2_FortAndCook_14ddb23b:

    # VES @ angry_talk "{i}For greed...{/i}"
    VES @ angry_talk "{i}Por avaricia...{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:142
translate es rom_Ves_2_FortAndCook_08e95c86:

    # MC @ sad "That’s not true! Yes, Alderay sold to the Greater Trading Company at first..."
    MC @ sad "¡Eso no es verdad! Sí, Alderay vendió a la Gran Compañía Comercial al principio..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:143
translate es rom_Ves_2_FortAndCook_cedef812:

    # MC @ sad "But Alderay officially cut ties with them after the {i}‘Battle of the Bay of Valar’{/i}, everyone knows that!"
    MC @ sad "Pero Alderay cortó oficialmente los lazos con ellos tras la {i}‘Batalla de la Bahía de Vala’{/i}, ¡todo el mundo lo sabe!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:144
translate es rom_Ves_2_FortAndCook_753e15da:

    # MC @ sad "It was part of the peace deal Newheart secured! The one your people continue to violate by attacking innocent civilians!"
    MC @ sad "¡Era parte del acuerdo de paz que Newheart aseguró! ¡El que tu gente sigue violando atacando a civiles inocentes!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:145
translate es rom_Ves_2_FortAndCook_15b6ae1d:

    # "Ves gritted her teeth, swelling with rage. "
    "Ves apretó los dientes, hinchándose de rabia."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:146
translate es rom_Ves_2_FortAndCook_40c348cc:

    # VES @ angry_talk "You idiot!"
    VES @ angry_talk "¡Imbécil!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:147
translate es rom_Ves_2_FortAndCook_8991341f:

    # VES @ angry_talk "Then why do we see unmarked ships docking into Borusmark with supplies, hmm?"
    VES @ angry_talk "Entonces, ¿por qué vemos naves sin marcas atracando en Borusmark con suministros, hmm?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:148
translate es rom_Ves_2_FortAndCook_3663fd1e:

    # VES @ angry_talk "And why do you think the Greater Trading Company continue to send gold to your lands if they have no business with you? "
    VES @ angry_talk "¿Y por qué crees que la Gran Compañía Comercial sigue enviando oro a tus tierras si no tienen negocios contigo?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:149
translate es rom_Ves_2_FortAndCook_f7c79499:

    # MC @ surprised "You can’t just assume that was us! Unmarked could be anyone!"
    MC @ surprised "¡No puedes asumir que fuimos nosotros! ¡Podría ser cualquiera!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:150
translate es rom_Ves_2_FortAndCook_f52e9141:

    # MC @ surprised "By the gods it could be pirates smuggling for all you know!"
    MC @ surprised "Por todos los dioses, ¡podrían ser piratas contrabandistas!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:151
translate es rom_Ves_2_FortAndCook_710790b0:

    # MC @ surprised "Slavery has been abolished for years!"
    MC @ surprised "¡La esclavitud está abolida desde hace años!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:152
translate es rom_Ves_2_FortAndCook_8f00f766:

    # VES @ angry_talk "Do you even hear yourself speak?"
    VES @ angry_talk "¿Acaso te oyes hablar?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:153
translate es rom_Ves_2_FortAndCook_0d04ca08:

    # VES @ angry_talk "The treaty was a lie!"
    VES @ angry_talk "¡El tratado era mentira!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:154
translate es rom_Ves_2_FortAndCook_089d6c28:

    # VES @ angry_talk "What did you expect us to do when you continue to aid our enemies?"
    VES @ angry_talk "¿Qué esperabas que hiciéramos si seguías ayudando a nuestros enemigos?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:155
translate es rom_Ves_2_FortAndCook_2023b64a:

    # VES @ angry_talk "Sit back and let us be treated like animals? "
    VES @ angry_talk "¿Sentarse y dejar que nos traten como animales?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:156
translate es rom_Ves_2_FortAndCook_f34b5220:

    # MC @ angry "So, killing civilians is the answer? "
    MC @ angry "¿Así que matar civiles es la respuesta?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:157
translate es rom_Ves_2_FortAndCook_d670272e:

    # MC @ angry "Innocent men and women who’ve played NO part in any of this! "
    MC @ angry "¡Hombres y mujeres inocentes que NO han participado en nada de esto!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:158
translate es rom_Ves_2_FortAndCook_db797b4c:

    # VES @ angry_talk "Grgh! There we go!"
    VES @ angry_talk "¡Grgh! ¡Allá vamos!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:159
translate es rom_Ves_2_FortAndCook_c1f547c9:

    # VES angry_talk "Always thinking like a human! Always finding a way to justify the horrors you inflict on others!"
    VES angry_talk "¡Siempre pensando como un humano! ¡Siempre encontrando la manera de justificar los horrores que infligís a los demás!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:160
translate es rom_Ves_2_FortAndCook_825cb83d:

    # MC @ angry "I’m not trying to justify it, Ves!"
    MC @ angry "¡No estoy tratando de justificarlo, Ves!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:161
translate es rom_Ves_2_FortAndCook_2cb544a7:

    # MC @ angry "But you can’t justify committing one crime as a response to another!"
    MC @ angry "¡Pero no se puede justificar la cometer un delito como respuesta a otro!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:162
translate es rom_Ves_2_FortAndCook_567d0cf3:

    # VES @ angry_talk "You have no idea what we’ve endured... You know nothing!"
    VES @ angry_talk "No tienes ni idea de lo que hemos soportado... ¡No sabes nada!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:163
translate es rom_Ves_2_FortAndCook_467ade81:

    # MC @ sad "I’m trying to help!"
    MC @ sad "¡Estoy intentando ayudar!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:164
translate es rom_Ves_2_FortAndCook_859e0e65:

    # VES @ angry_talk "I didn’t want your help!"
    VES @ angry_talk "¡No quería tu ayuda!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:166
translate es rom_Ves_2_FortAndCook_bbe4124a:

    # "Ves kicked up some sand into the fire as she stormed off back into the sanctuary of her tent, shouting loudly behind at me. "
    "Ves echó un poco de arena al fuego y se marchó furiosa al santuario de su tienda, gritándome en voz alta."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:167
translate es rom_Ves_2_FortAndCook_a8b54219:

    # VES @ talk "Now leave me alone, human!"
    VES @ talk "¡Ahora déjame en paz, humano!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:168
translate es rom_Ves_2_FortAndCook_4625fdc3:

    # MC "(... Well that could have gone better.)"
    MC "(... Bueno, eso podría haber ido mejor)."

translate es strings:

    # game/data/world_romance/ves/scr_2_FortAndCook.rpy:4
    old "{image=[ICON.CLOCK]} Let's do this."
    new "{image=[ICON.CLOCK]} Vamos a hacerlo."

    # game/data/world_romance/ves/scr_2_FortAndCook.rpy:4
    old "Perhaps another time."
    new "Mejor en otra ocasión."
