

# game/data/world_romance/ves/scr_3_AferHeat.rpy:6
translate es rom_Ves_3_AfterHeat_b7d400f5:

    # "I found Ves sat rather sombrely on a rock as she inspected the fang-toothed necklace she usually wore, gently running her fingers along it."
    "Encontré a Ves sentada en una roca, bastante sombría, mientras inspeccionaba el collar de colmillos que solía llevar, pasando suavemente los dedos por él."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:9
translate es rom_Ves_3_AfterHeat_f4884dab:

    # VES @ sad_talk "... I didn’t think you’d come back."
    VES @ sad_talk "...No pensé que volverías."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:10
translate es rom_Ves_3_AfterHeat_92817a56:

    # MC @ talk "I’m a glutton for punishment."
    MC @ talk "Soy un glotón para los castigos."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:11
translate es rom_Ves_3_AfterHeat_f30a46bb:

    # VES @ sad_talk "... Do you know what this is?"
    VES @ sad_talk "...¿Sabes lo que es esto?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:12
translate es rom_Ves_3_AfterHeat_edcc99e9:

    # "Ves dangled the necklace in front of me."
    "Ves balanceó el collar delante de mí."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:13
translate es rom_Ves_3_AfterHeat_64e756eb:

    # MC @ talk "I take it it’s something important to you?"
    MC @ talk "¿Supongo que es algo importante para ti?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:14
translate es rom_Ves_3_AfterHeat_20b900d5:

    # VES @ sad_talk "I was smuggled away when I was just a baby by the other tribes."
    VES @ sad_talk "Las otras tribus me sacaron de contrabando cuando era solo un bebé."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:15
translate es rom_Ves_3_AfterHeat_1c02388f:

    # VES @ sad_talk "This is the only thing of my mother’s I have left."
    VES @ sad_talk "Esto es lo único de mi madre que me queda."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:16
translate es rom_Ves_3_AfterHeat_aa290b42:

    # MC sad "..."
    MC sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:17
translate es rom_Ves_3_AfterHeat_fde1246b:

    # "Ves turned to look at me with sullen eyes."
    "Ves se giró para mirarme con ojos sombríos."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:18
translate es rom_Ves_3_AfterHeat_559624de:

    # VES @ sad_talk "Both of my parents were slaves."
    VES @ sad_talk "Mis padres fueron esclavos."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:19
translate es rom_Ves_3_AfterHeat_fca7a546:

    # VES @ sad_talk "After giving birth to me, my mother was beaten and raped by the master’s right-hand man, a man named Lavak... She died shortly afterwards."
    VES @ sad_talk "Después de darme a luz, mi madre fue golpeada y violada por la mano derecha del amo, un hombre llamado Lavak... Murió poco después."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:20
translate es rom_Ves_3_AfterHeat_9f648ae6:

    # VES @ sad_talk "My father was killed when he tried to protect her."
    VES @ sad_talk "Mi padre fue asesinado cuando intentó protegerla."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:21
translate es rom_Ves_3_AfterHeat_ebc8397b:

    # MC @ sad "... Ves."
    MC @ sad "... Ves."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:22
translate es rom_Ves_3_AfterHeat_7272ceaa:

    # VES @ sad_talk "My tribe is all I have left, but the thought of {i}vengeance{/i} has kept me alive so far."
    VES @ sad_talk "Mi tribu es todo lo que me queda, pero el pensamiento de {i}venganza{/i} me ha mantenido viva hasta ahora."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:26
translate es rom_Ves_3_AfterHeat_7ddac0a5:

    # MC @ talk "... There is no redeeming monsters like that."
    MC @ talk "... No existe redención para monstruos así."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:27
translate es rom_Ves_3_AfterHeat_b1ff3d7a:

    # MC @ talk "What they did was... {i}unforgivable.{/i}"
    MC @ talk "Lo que hicieron fue... {i}imperdonable.{/i}"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:28
translate es rom_Ves_3_AfterHeat_4f90784e:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:29
translate es rom_Ves_3_AfterHeat_1114e285:

    # MC @ talk "Ves, you will have your vengeance."
    MC @ talk "Ves, tendrás tu venganza."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:30
translate es rom_Ves_3_AfterHeat_b3c4eb96:

    # VES @ talk "... How do you know?"
    VES @ talk "...¿Cómo lo sabes?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:31
translate es rom_Ves_3_AfterHeat_c25c53b8:

    # MC @ talk "{i}Because I’ll help you.{/i}"
    MC @ talk "{i}Porque te ayudaré.{/i}"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:34
translate es rom_Ves_3_AfterHeat_da215aef:

    # MC @ talk "... Vengeance won’t bring them back and it won’t heal the wounds left, Ves."
    MC @ talk "...La venganza no los traerá de vuelta y no curará las heridas dejadas, Ves."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:35
translate es rom_Ves_3_AfterHeat_4f90784e_1:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:36
translate es rom_Ves_3_AfterHeat_fcfcfbc0:

    # MC @ talk "You have to be better than them... You’re not a cold-blooded killer."
    MC @ talk "Tienes que ser mejor que ellos... No eres una asesina a sangre fría."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:37
translate es rom_Ves_3_AfterHeat_9740dc5f:

    # VES @ talk "What makes you so sure of that?"
    VES @ talk "¿Qué te hace estar tan seguro de eso?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:38
translate es rom_Ves_3_AfterHeat_8bd8ab3f:

    # VES @ talk "What makes you think I don’t intend to cut down THEIR women and children like they did to ours?"
    VES @ talk "¿Qué te hace pensar que no pretendo acabar con SUS mujeres y niños como hicieron con los nuestros?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:39
translate es rom_Ves_3_AfterHeat_afceff91:

    # VES @ talk "Like they did to MY family?"
    VES @ talk "¿Como hicieron con mi familia?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:40
translate es rom_Ves_3_AfterHeat_db6839b5:

    # MC @ talk "Because, Ves, I’ll help you bring them to justice... But I won’t help you become a monster yourself."
    MC @ talk "Porque, Ves, te ayudaré a llevarlos ante la justicia... Pero no te ayudaré a convertirte tú misma en un monstruo."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:41
translate es rom_Ves_3_AfterHeat_ca8f6395:

    # MC @ talk "You need to be better than them."
    MC @ talk "Tienes que ser mejor que ellos."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:42
translate es rom_Ves_3_AfterHeat_550c9aed:

    # VES @ angry_talk "Why?"
    VES @ angry_talk "¿Por qué?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:43
translate es rom_Ves_3_AfterHeat_cf3fda9d:

    # VES @ angry_talk "There has been no justice for my people! Why must I be better than them? What have they done to deserve that?"
    VES @ angry_talk "¡No ha habido justicia para mi pueblo! ¿Por qué tengo que ser mejor que ellos? ¿Qué han hecho para merecer eso?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:44
translate es rom_Ves_3_AfterHeat_e80284ea:

    # VES @ angry_talk "Why should I not just inflict on them the suffering they have inflicted on others? "
    VES @ angry_talk "¿Por qué no debería infligirles el sufrimiento que han infligido a otros?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:45
translate es rom_Ves_3_AfterHeat_26543181:

    # MC @ talk "Because, Ves, vengeance is a fleeting thing... As soon as you have it, it’s over."
    MC @ talk "Porque, Ves, la venganza es algo fugaz... Tan pronto como la tienes, se acaba."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:46
translate es rom_Ves_3_AfterHeat_575e87ea:

    # MC @ talk "Justice is meant to be more than that though."
    MC @ talk "Sin embargo, la justicia es algo más que eso."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:47
translate es rom_Ves_3_AfterHeat_47c29c9a:

    # MC @ talk "It’s about making them answer for their crimes and letting the world know the truth of what they did so that history cannot repeat itself."
    MC @ talk "Se trata de que respondan por sus crímenes y de que el mundo conozca la verdad de lo que hicieron para que la historia no pueda repetirse."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:48
translate es rom_Ves_3_AfterHeat_2a634cce:

    # VES @ talk "... Hmph. I will think on your words."
    VES @ talk "...Hmph. Pensaré en tus palabras."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:49
translate es rom_Ves_3_AfterHeat_0d71c69a:

    # MC @ talk "I’m glad to hear that."
    MC @ talk "Me alegra oír eso."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:50
translate es rom_Ves_3_AfterHeat_612727b6:

    # VES @ talk "... You are a strange human."
    VES @ talk "...Eres un humano extraño."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:51
translate es rom_Ves_3_AfterHeat_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:52
translate es rom_Ves_3_AfterHeat_28bf2f6f:

    # VES @ talk "But I don’t think you’re a bad one."
    VES @ talk "Pero no creo que seas malo."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:54
translate es rom_Ves_3_AfterHeat_4a4febb6:

    # VES @ talk "... You know you don’t have to help me with this, right?"
    VES @ talk "... Sabes que no tienes que ayudarme con esto, ¿verdad?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:55
translate es rom_Ves_3_AfterHeat_d595c4f8:

    # VES @ talk "I don’t even know when... {i}if{/i} I’ll ever get a chance to return to Skarshire again..."
    VES @ talk "Ni siquiera sé cuándo... {i}si{/i} alguna vez tendré la oportunidad de volver a Skarshire de nuevo..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:56
translate es rom_Ves_3_AfterHeat_ab2f88eb:

    # MC @ talk "{i}When{/i} we do, Ves, I promise you you’ll get your chance..."
    MC @ talk "{i}Cuando{/i} lo hagamos, Ves, te prometo que tendrás tu oportunidad..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:57
translate es rom_Ves_3_AfterHeat_58ad8d11:

    # "Ves stared awkwardly down at the sand before her wide, glassy eyes looked up to stare into mine."
    "Ves miró incómodamente hacia la arena antes de que sus ojos grandes y vidriosos alzaran la vista para clavarla en los míos."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:62
translate es rom_Ves_3_AfterHeat_b0e01b52:

    # "Suddenly, without saying a word she lunged forward from her spot to hug me tightly."
    "De repente, sin decir una palabra, se lanzó hacia delante desde su sitio para abrazarme con fuerza."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:63
translate es rom_Ves_3_AfterHeat_b908e1e2:

    # "Gently, I wrapped my arms slowly around her, at the sudden affection before she shyly pulled back and looked at me again."
    "Con suavidad, la rodeé lentamente con mis brazos, ante el repentino afecto, antes de que ella se apartara tímidamente y volviera a mirarme."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:68
translate es rom_Ves_3_AfterHeat_b9152cde:

    # VES @ talk "You... Most humans would have run away at the very sight of me."
    VES @ talk "Tú... La mayoría de los humanos habrían huido al verme."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:69
translate es rom_Ves_3_AfterHeat_cf8239fd:

    # VES @ talk "Why did you not?"
    VES @ talk "¿Por qué no lo hiciste?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:70
translate es rom_Ves_3_AfterHeat_f74f06a2:

    # VES @ talk "To be an orc is to be an ugly thing..."
    VES @ talk "Ser un orco es ser una cosa fea..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:77
translate es rom_Ves_3_AfterHeat_3b48b116:

    # "Ves cheeks flushed red as my finger and thumb gently cupped under her chin. Nervously, she stepped back, her eyes darting towards the sand. "
    "Las mejillas de Ves se sonrojaron cuando le acaricié la barbilla con los dedos índice y pulgar. Nerviosa, dio un paso atrás y sus ojos se desviaron hacia la arena."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:78
translate es rom_Ves_3_AfterHeat_5d5c96a8:

    # VES @ talk "I... I have things I need to prepare for the next hunt! "
    VES @ talk "Yo... ¡Yo Tengo cosas que necesito preparar para la próxima cacería!"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:79
translate es rom_Ves_3_AfterHeat_afacf1f3:

    # VES @ talk "Leave me! Come back another time!"
    VES @ talk "¡Déjame! ¡Vuelve en otro momento!"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:81
translate es rom_Ves_3_AfterHeat_0fe2cec9:

    # "I reached out to stop her, but Ves had already scarpered off into the tent, and seemingly wasn’t coming out again. "
    "Alargué la mano para detenerla, pero Ves ya se había escabullido a la tienda y parecía que no iba a volver a salir."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:83
translate es rom_Ves_3_AfterHeat_34a3c8ba:

    # VES @ talk "I... I thank you."
    VES @ talk "Yo... Te doy las gracias."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:84
translate es rom_Ves_3_AfterHeat_1e125e35:

    # VES @ talk "gradually slipped out from my arms."
    VES @ talk "Poco a poco se me escapó de los brazos."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:85
translate es rom_Ves_3_AfterHeat_a267d18a:

    # VES @ talk "Perhaps... Just perhaps..."
    VES @ talk "Quizás... Slo quizás..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:86
translate es rom_Ves_3_AfterHeat_c53302ea:

    # VES @ talk "{i}Not all{/i} of you are bad."
    VES @ talk "{i}No todos{/i} sois malos.."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:88
translate es rom_Ves_3_AfterHeat_38f3f17f:

    # "Ves smiled, her eyes seeming to well up slightly as she solemnly dragged herself back into her tent."
    "Ves sonrió, sus ojos parecieron humedecerse ligeramente mientras se arrastraba solemnemente de vuelta a su tienda."

translate es strings:

    # game/data/world_romance/ves/scr_3_AferHeat.rpy:24
    old "Promise Ves her vengeance."
    new "Prometer a Ves su venganza."

    # game/data/world_romance/ves/scr_3_AferHeat.rpy:24
    old "Tell Ves she should seek justice, not vengeance."
    new "Decirle a Ves que debería buscar justicia, no venganza."

    # game/data/world_romance/ves/scr_3_AferHeat.rpy:71
    old "Ves... You are a {i}beautiful{/i} thing..."
    new "Ves... Eres una cosa {i}hermosa{/i}..."

    # game/data/world_romance/ves/scr_3_AferHeat.rpy:71
    old "It’s not my place to judge you."
    new "No me corresponde juzgarte."
