translate es rom_Ves_6_Drunk_9c9de6c1:

    # MC @ talk "Like brothers... We’ve known each other since we were little."
    MC @ talk "Como hermanos... Nos conocemos desde que éramos pequeños."

# game/data/world_romance/ves/scr_6_Drunk.rpy:128
translate es rom_Ves_6_Drunk_824d1dca:

    # VES @ talk "He is... different to you."
    VES @ talk "Él es... diferente a ti."

# game/data/world_romance/ves/scr_6_Drunk.rpy:129
translate es rom_Ves_6_Drunk_ade481c7:

    # MC @ talk "He’s a good man."
    MC @ talk "Es un buen hombre."

# game/data/world_romance/ves/scr_6_Drunk.rpy:130
translate es rom_Ves_6_Drunk_2be47c87:

    # MC @ talk "But he’s got his issues, even before the fighting, I think."
    MC @ talk "Pero tiene sus problemas, incluso antes de las peleas, creo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:131
translate es rom_Ves_6_Drunk_72fcfee0:

    # VES @ talk "... So, how did you become warriors?"
    VES @ talk "... Entonces, ¿cómo os convertisteis en guerreros?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:132
translate es rom_Ves_6_Drunk_e268bbee:

    # MC @ talk "We didn’t get much say in the matter..."
    MC @ talk "No tuvimos mucho que decir al respecto..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:133
translate es rom_Ves_6_Drunk_7a4b33f3:

    # MC @ talk "Called up to be part of the noble Scouts."
    MC @ talk "Llamado a formar parte de los nobles exploradores."

# game/data/world_romance/ves/scr_6_Drunk.rpy:134
translate es rom_Ves_6_Drunk_6347eb66:

    # VES @ talk "You didn’t choose to become a warrior?"
    VES @ talk "¿No elegiste convertirte en guerrero?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:135
translate es rom_Ves_6_Drunk_d4498740:

    # VES @ talk "Surely this is a great honour!"
    VES @ talk "Sin duda, ¡es un gran honor!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:136
translate es rom_Ves_6_Drunk_829f86a7:

    # MC @ talk "Not to us..."
    MC @ talk "No para nosotros..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:137
translate es rom_Ves_6_Drunk_ced6b3ea:

    # VES @ talk "... I don’t understand."
    VES @ talk "... No lo entiendo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:138
translate es rom_Ves_6_Drunk_3cb19faa:

    # MC @ talk "There’s no glory dying in some wretched field for a pointless skirmish watching as your friends are being slaughtered around you."
    MC @ talk "No hay gloria en morir en un campo miserable en una escaramuza sin sentido viendo cómo tus amigos son masacrados a tu alrededor."

# game/data/world_romance/ves/scr_6_Drunk.rpy:139
translate es rom_Ves_6_Drunk_2384c6dc:

    # MC @ talk "Dying for SOMETHING, for ANYTHING would make it better..."
    MC @ talk "Morir por ALGO, por CUALQUIER COSA lo haría mejor..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:140
translate es rom_Ves_6_Drunk_4d97dec6:

    # MC @ talk "More bearable."
    MC @ talk "Más soportable."

# game/data/world_romance/ves/scr_6_Drunk.rpy:141
translate es rom_Ves_6_Drunk_2ac5b574:

    # MC @ talk "But most of us would just die unceremoniously, in cruel, painful deaths with no one to remember... or even care that we’re gone or what our mission even was in the first place."
    MC @ talk "Pero la mayoría de nosotros moriríamos sin ceremonias, de forma cruel y dolorosa, sin que nadie nos recordara... ni se preocupara de que nos hubiéramos ido o de cuál era nuestra misión."

# game/data/world_romance/ves/scr_6_Drunk.rpy:142
translate es rom_Ves_6_Drunk_4999deb8:

    # VES @ talk "..."
    VES @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:143
translate es rom_Ves_6_Drunk_d0ba7df3:

    # MC @ talk "Praying... always praying you’d somehow get home... Praying you’d never have to venture beyond those walls again."
    MC @ talk "Rezando... siempre rezando para que de alguna manera volvieras a casa... Rezando para no tener que volver a aventurarte más allá de esas murallas."

# game/data/world_romance/ves/scr_6_Drunk.rpy:144
translate es rom_Ves_6_Drunk_74b54e64:

    # VES @ talk "... And yet, here you are!"
    VES @ talk "... Y sin embargo, ¡aquí estás!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:145
translate es rom_Ves_6_Drunk_8b056b19:

    # VES @ smile_talk "Made stronger by surviving beyond the walls!"
    VES @ smile_talk "¡Hecho más fuerte por sobrevivir más allá de las murallas!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:146
translate es rom_Ves_6_Drunk_dc6c7127:

    # MC @ talk "... Yeah, I suppose so."
    MC @ talk "... Sí, supongo que sí."

# game/data/world_romance/ves/scr_6_Drunk.rpy:147
translate es rom_Ves_6_Drunk_690c0c4e:

    # VES @ talk "And you and I would never have met if you were still too afraid to leave the safety of your walls."
    VES @ talk "Y tú y yo nunca nos habríamos conocido si aún tuvieras demasiado miedo para salir de la seguridad de tus murallas."

# game/data/world_romance/ves/scr_6_Drunk.rpy:148
translate es rom_Ves_6_Drunk_6c282d37:

    # MC @ talk "... Me and Marcus only survived because of {i}what happened...{/i}"
    MC @ talk ".... Marcus y yo solo sobrevivimos gracias {i}a lo que pasó...{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:149
translate es rom_Ves_6_Drunk_e6596336:

    # MC @ talk "For anyone else, they’d be..."
    MC @ talk "Para cualquier otra persona, serían..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:150
translate es rom_Ves_6_Drunk_5e6d1b2b:

    # "Ves’ hand moved to shush my lips."
    "La mano de Ves se movió para callar mis labios."

# game/data/world_romance/ves/scr_6_Drunk.rpy:151
translate es rom_Ves_6_Drunk_bd2d8643:

    # VES @ talk "And yet, {i}you live to fight another day...{/i}"
    VES @ talk "Y sin embargo, {i}vives para luchar otro día...{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:152
translate es rom_Ves_6_Drunk_b5181c29:

    # VES @ talk "This is what matters."
    VES @ talk "Esto es lo que importa."

# game/data/world_romance/ves/scr_6_Drunk.rpy:153
translate es rom_Ves_6_Drunk_30ecfac2:

    # VES @ talk "O’rlarak commands you to live and fight on. For those who were not so fortunate. For those who have been denied what you have."
    VES @ talk "O’rlarak te ordena vivir y seguir luchando. Por aquellos que no fueron tan afortunados. Por aquellos a los que se les ha negado lo que tú tienes."

# game/data/world_romance/ves/scr_6_Drunk.rpy:154
translate es rom_Ves_6_Drunk_6bede656:

    # MC @ talk "O’rlarak?"
    MC @ talk "¿O’rlarak?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:155
translate es rom_Ves_6_Drunk_30eba78e:

    # VES @ talk "{i}The greatest of all chiefs who now reigns in the sky.{/i}"
    VES @ talk "{i}El más grande de todos los jefes que ahora reina en el cielo.{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:156
translate es rom_Ves_6_Drunk_a7615141:

    # MC @ talk "... Ves..."
    MC @ talk "... Ves..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:157
translate es rom_Ves_6_Drunk_c03a963b:

    # VES @ talk "To my people, to die in battle protecting those we love... those we care for..."
    VES @ talk "Para mi pueblo, morir en batalla protegiendo a los que amamos... a los que queremos..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:158
translate es rom_Ves_6_Drunk_e9ffc2f1:

    # VES @ talk "There is no better way to die."
    VES @ talk "No hay mejor manera de morir."

# game/data/world_romance/ves/scr_6_Drunk.rpy:161
translate es rom_Ves_6_Drunk_b9fc2750:

    # VES @ talk "... Strange."
    VES @ talk "... Extraño."

# game/data/world_romance/ves/scr_6_Drunk.rpy:162
translate es rom_Ves_6_Drunk_e6ddc3fe:

    # MC @ talk "What, why is that strange?"
    MC @ talk "¿Qué, por qué es extraño?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:163
translate es rom_Ves_6_Drunk_c667afcd:

    # VES @ talk "Most orcs see life as a short arrangement... A brief deal with the Great Chiefs paid for in blood."
    VES @ talk "La mayoría de los orcos ven la vida como un breve acuerdo... Un breve trato con los grandes jefes pagado con sangre."

# game/data/world_romance/ves/scr_6_Drunk.rpy:164
translate es rom_Ves_6_Drunk_02e3c328:

    # VES @ talk "We are prepared to die from the day we are born."
    VES @ talk "Estamos preparados para morir desde el día en que nacemos."

# game/data/world_romance/ves/scr_6_Drunk.rpy:165
translate es rom_Ves_6_Drunk_f9f2d041:

    # VES @ talk "But you see it as lasting... {i}longer.{/i}"
    VES @ talk "Pero tú ves que dura... {i}más.{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:166
translate es rom_Ves_6_Drunk_366f724b:

    # MC @ talk "There’s more to life than death, Ves."
    MC @ talk "Hay más en la vida que la muerte, Ves."

# game/data/world_romance/ves/scr_6_Drunk.rpy:167
translate es rom_Ves_6_Drunk_3292e2bf:

    # VES @ talk "... I’d like you to show me this one day."
    VES @ talk "... Me gustaría que me mostraras esto un día."

# game/data/world_romance/ves/scr_6_Drunk.rpy:169
translate es rom_Ves_6_Drunk_6d5279b0:

    # VES @ talk "A brothel?"
    VES @ talk "¿Un burdel?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:170
translate es rom_Ves_6_Drunk_fd6d73ae:

    # MC @ smile "It’s... Never mind."
    MC @ smile "Es... Olvídalo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:171
translate es rom_Ves_6_Drunk_a5781452:

    # VES @ talk "What kind of place is that?"
    VES @ talk "¿Qué clase de lugar es ese?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:172
translate es rom_Ves_6_Drunk_331874a8:

    # MC @ talk "It’s a place where humans pay to have sex."
    MC @ talk "Es un lugar donde los humanos pagan por tener sexo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:173
translate es rom_Ves_6_Drunk_7926c541:

    # VES @ talk "... Humans... {i}pay{/i} to have sex?"
    VES @ talk "... Los humanos... ¿{i}pagáis{/i} por tener sexo?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:174
translate es rom_Ves_6_Drunk_b9f291e3:

    # VES @ talk "Do you not have matriarchs?"
    VES @ talk "¿No tenéis matriarcas?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:175
translate es rom_Ves_6_Drunk_3eb7e210:

    # MC @ talk "Uhh, what?"
    MC @ talk "Uhh, ¿qué?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:176
translate es rom_Ves_6_Drunk_26d490a6:

    # VES @ talk "Every tribe has a few matriarchs... Women devoted just to breeding."
    VES @ talk "Cada tribu tiene algunas matriarcas... Mujeres dedicadas solo a la crianza."

# game/data/world_romance/ves/scr_6_Drunk.rpy:177
translate es rom_Ves_6_Drunk_14252312:

    # MC @ talk "Wait, what?!"
    MC @ talk "Espera, ¡¿qué?!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:178
translate es rom_Ves_6_Drunk_660ccc51:

    # VES @ talk "A great number of orcs die young or in battle... Numbers need to be replenished quickly or we risk extinction."
    VES @ talk "Un gran número de orcos mueren jóvenes o en batalla... Los números deben ser repuestos rápidamente o corremos el riesgo de extinción."

# game/data/world_romance/ves/scr_6_Drunk.rpy:179
translate es rom_Ves_6_Drunk_64d864e1:

    # VES @ talk "Matriarchs can even request to break in newly bonded husbands."
    VES @ talk "Las matriarcas pueden incluso solicitar la ayuda de maridos recién casados."

# game/data/world_romance/ves/scr_6_Drunk.rpy:180
translate es rom_Ves_6_Drunk_8c056903:

    # MC @ talk "How do the wives feel about that?"
    MC @ talk "¿Qué opinan las esposas?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:181
translate es rom_Ves_6_Drunk_8cb295ba:

    # VES @ talk "It is an old tradition... Some don’t like it but..."
    VES @ talk "Es una vieja tradición... A algunos no les gusta, pero..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:182
translate es rom_Ves_6_Drunk_988d95b0:

    # MC @ smile "I can imagine!"
    MC @ smile "¡Me lo imagino!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:183
translate es rom_Ves_6_Drunk_a3045e18:

    # "Ves shrugged apathetically."
    "Ves se encogió de hombros con apatía."

# game/data/world_romance/ves/scr_6_Drunk.rpy:184
translate es rom_Ves_6_Drunk_aa67bb4f:

    # VES @ talk "Matriarchs often have the children of several males, and it is forbidden for them to devote themselves to just one mate."
    VES @ talk "Las matriarcas suelen tener hijos de varios machos, y les está prohibido dedicarse a un solo compañero."

# game/data/world_romance/ves/scr_6_Drunk.rpy:185
translate es rom_Ves_6_Drunk_4f7c58c4:

    # VES @ talk "So, it is seen as different to betraying your mate to be with them. It is for the good of the clan."
    VES @ talk "Por lo tanto, se ve como algo diferente a traicionar a tu pareja para estar con ellos. Es por el bien del clan."

# game/data/world_romance/ves/scr_6_Drunk.rpy:186
translate es rom_Ves_6_Drunk_4d2eaece:

    # MC @ talk "That’s... a very openminded culture."
    MC @ talk "Es... una cultura muy abierta."

# game/data/world_romance/ves/scr_6_Drunk.rpy:187
translate es rom_Ves_6_Drunk_b6085730:

    # MC @ talk "I’m not sure humans would feel the same."
    MC @ talk "No sé si los humanos sentirían lo mismo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:189
translate es rom_Ves_6_Drunk_9ef627e9:

    # VES @ smile_talk "Of course I am right!"
    VES @ smile_talk "¡Claro que tengo razón!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:190
translate es rom_Ves_6_Drunk_58ed8680:

    # VES @ talk "I may not have studied like you, but I have learned many things..."
    VES @ talk "Puede que no haya estudiado como tú, pero he aprendido muchas cosas..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:193
translate es rom_Ves_6_Drunk_2a911be7:

    # VES @ talk "So... you still haven’t told me how you became..."
    VES @ talk "Entonces... aún no me has dicho cómo te convertiste..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:194
translate es rom_Ves_6_Drunk_8ce9bf6a:

    # MC @ talk "Ah... Well..."
    MC @ talk "Ah... Bueno..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:195
translate es rom_Ves_6_Drunk_abf098b8:

    # "I spent the next while recounting my tale to Ves, the perilous journey lead by Captain Duprey, the abandoned fort and the strange underground lab..."
    "Pasé el rato siguiente contándole mi historia a Ves, el peligroso viaje guiado por el capitán Duprey, el fuerte abandonado y el extraño laboratorio subterráneo..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:196
translate es rom_Ves_6_Drunk_66477c9e:

    # "Finally, I went into detail about the strange creatures that had attached themselves to me and Marcus, and the terms and conditions of our survival for their ‘gift’."
    "Por último, entré en detalles sobre las extrañas criaturas que se habían adherido a mí y a Marcus, y los términos y condiciones de nuestra supervivencia por su ‘regalo’."

# game/data/world_romance/ves/scr_6_Drunk.rpy:197
translate es rom_Ves_6_Drunk_aef1c638:

    # VES @ talk "... I see."
    VES @ talk "... Ya veo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:198
translate es rom_Ves_6_Drunk_fec7b863:

    # "Ves sighed morosely."
    "Ves suspiró malhumorada."

# game/data/world_romance/ves/scr_6_Drunk.rpy:199
translate es rom_Ves_6_Drunk_6d6a4d50:

    # MC @ talk "... What is it?"
    MC @ talk "... ¿Qué es?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:200
translate es rom_Ves_6_Drunk_1c27f260:

    # VES @ talk "... Nothing."
    VES @ talk "... Nada."

# game/data/world_romance/ves/scr_6_Drunk.rpy:201
translate es rom_Ves_6_Drunk_8d168b3c:

    # MC @ talk "No, something’s bothering you."
    MC @ talk "No, algo te molesta."

# game/data/world_romance/ves/scr_6_Drunk.rpy:202
translate es rom_Ves_6_Drunk_733c4389:

    # VES @ talk "I..."
    VES @ talk "Yo..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:203
translate es rom_Ves_6_Drunk_3d13c0ad:

    # VES @ talk "Would like to have you for myself..."
    VES @ talk "Me gustaría tenerte para mí..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:204
translate es rom_Ves_6_Drunk_8418a966:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:205
translate es rom_Ves_6_Drunk_025adeea:

    # VES @ talk "{i}Just{/i} for myself."
    VES @ talk "{i}Solo{/i} para mí."

# game/data/world_romance/ves/scr_6_Drunk.rpy:206
translate es rom_Ves_6_Drunk_9bbca015:

    # VES @ talk "But... I know this is probably not possible, is it?"
    VES @ talk "Pero... Sé que esto probablemente no es posible, ¿verdad?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:207
translate es rom_Ves_6_Drunk_83848d0a:

    # MC @ talk "It is... difficult."
    MC @ talk "Es... difícil."

# game/data/world_romance/ves/scr_6_Drunk.rpy:208
translate es rom_Ves_6_Drunk_f7250a82:

    # MC @ talk "When I was fully human, I could have—"
    MC @ talk "Cuando era completamente humano, podría haber—"

# game/data/world_romance/ves/scr_6_Drunk.rpy:209
translate es rom_Ves_6_Drunk_b13cb8e5:

    # VES @ talk "No... It’s okay."
    VES @ talk "No... Está bien."

# game/data/world_romance/ves/scr_6_Drunk.rpy:210
translate es rom_Ves_6_Drunk_2b3bb5cd:

    # VES @ smile_talk "I am just happy to be with you."
    VES @ smile_talk "Estoy feliz de estar contigo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:211
translate es rom_Ves_6_Drunk_8cfba628:

    # VES @ talk "... And grateful for the patience you have shown me."
    VES @ talk "... Y agradecida por la paciencia que me has demostrado."

# game/data/world_romance/ves/scr_6_Drunk.rpy:212
translate es rom_Ves_6_Drunk_fe794908:

    # "Gently, I caressed Ves’ face with my hand, she leaned forward to press another kiss onto me."
    "Suavemente, acaricié la cara de Ves con la mano, ella se inclinó hacia delante para darme otro beso."

# game/data/world_romance/ves/scr_6_Drunk.rpy:213
translate es rom_Ves_6_Drunk_257b57b9:

    # VES @ smile_talk "... Goodnight, [player_name!t]."
    VES @ smile_talk "... Buenas noches, [player_name!t]."

# game/data/world_romance/ves/scr_6_Drunk.rpy:214
translate es rom_Ves_6_Drunk_a0f70b38:

    # MC @ smile "Hey! You said my name!"
    MC @ smile "¡Ey! ¡Has dicho mi nombre!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:215
translate es rom_Ves_6_Drunk_e23ae25b:

    # VES @ talk "{i}*Grumbles*{/i}"
    VES @ talk "{i}*Refunfuña*{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:216
translate es rom_Ves_6_Drunk_8418a966_1:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:218
translate es rom_Ves_6_Drunk_5702411e:

    # MC @ talk "Goodnight, Ves..."
    MC @ talk "Buenas noches, Ves..."

translate es strings:

    # game/data/world_romance/ves/scr_6_Drunk.rpy:108
    old "It all began when I was born, everyone realised I was the most handsome man in all of Alderay."
    new "Todo empezó cuando nací, todo el mundo se dio cuenta de que era el hombre más guapo de todo Alderay."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:108
    old "Not much to say really... Most of your time growing up in Novaras is spent studying if you’re smart."
    new "No hay mucho que decir en realidad... La mayor parte del tiempo que pasas creciendo en Novaras lo dedicas a estudiar si eres listo."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:159
    old "I’d prefer dying old and grey with my family around me."
    new "Preferiría morir viejo y gris con mi familia a mi alrededor."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:159
    old "I dunno, dying in a brothel sounds like a lot more fun."
    new "No sé, morir en un burdel suena mucho más divertido."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:159
    old "I suppose you’re right..."
    new "Supongo que tienes razón..."
