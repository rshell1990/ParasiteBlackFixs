

# game/engine/gallery/babazhul_label.rpy:5
translate es nov_soothsayer_gallery_f7cac0c8:

    # BABAZHUL @ talk "So be it..."
    BABAZHUL @ talk "Que así sea..."

# game/engine/gallery/babazhul_label.rpy:7
translate es nov_soothsayer_gallery_e2fab751:

    # BABAZHUL @ talk "But remember child, the past has already come and gone, only the present is a gift."
    BABAZHUL @ talk "Pero recuerda hijo, el pasado ya vino y se fue, solo el presente es un regalo."

# game/engine/gallery/babazhul_label.rpy:8
translate es nov_soothsayer_gallery_7ad6ec43:

    # BABAZHUL @ talk "Do not linger too long on the shadows that have already vanished."
    BABAZHUL @ talk "No te detengas demasiado en las sombras que ya se han desvanecido."

# game/engine/gallery/babazhul_label.rpy:9
translate es nov_soothsayer_gallery_57fdbdbd:

    # BABAZHUL @ talk "How easy it is to become lost to their sweetness..."
    BABAZHUL @ talk "Qué fácil es perderse en su dulzura..."

# game/engine/gallery/babazhul_label.rpy:45
translate es nov_soothsayer_gallery_4424f154:

    # BABAZHUL @ talk "You do not possess enough coin, child, return when you do."
    BABAZHUL @ talk "No posees suficientes monedas, hijo, regresa cuando las tengas."
