translate es hamun_arena_debug_rank_sunforged_bc2727e5:

    # "DEBUG: rank is now set to 1 (sun forged)"
    "DEBUG: el rango ahora está establecido (forjado en el sol)"

# game/engine/hamun_arena/arena_aio.rpy:147
translate es hamun_arena_first_night_enter_ac78e6e5:

    # MC "(The place is deserted.)"
    MC "(El lugar está desierto)."

# game/engine/hamun_arena/arena_aio.rpy:149
translate es hamun_arena_first_night_enter_76cba10b:

    # MC "(Looks like nothing interesting is going on here at night.)"
    MC "(Parece que por aquí no pasa nada interesante por la noche)."

# game/engine/hamun_arena/arena_aio.rpy:156
translate es hamun_arena_master_talk_first_time_b424163d:

    # HAMUN_ARENA_MASTER "Greetings... Are you here to watch a battle in the arena, or to rank?"
    HAMUN_ARENA_MASTER "Saludos... ¿Estás aquí para ver una batalla en la arena o para clasificarte?"

# game/engine/hamun_arena/arena_aio.rpy:157
translate es hamun_arena_master_talk_first_time_5c68a77d:

    # MC @ talk "To rank."
    MC @ talk "Para clasificarme."

# game/engine/hamun_arena/arena_aio.rpy:158
translate es hamun_arena_master_talk_first_time_8e665699:

    # HAMUN_ARENA_MASTER "Excellent."
    HAMUN_ARENA_MASTER "Excelente."

# game/engine/hamun_arena/arena_aio.rpy:159
translate es hamun_arena_master_talk_first_time_b3a82bdf:

    # "The figure slid over some paperwork with an inked quill."
    "La figura deslizó unos papeles con una pluma entintada."

# game/engine/hamun_arena/arena_aio.rpy:160
translate es hamun_arena_master_talk_first_time_c1906bc5:

    # HAMUN_ARENA_MASTER "Any questions?"
    HAMUN_ARENA_MASTER "¿Alguna pregunta?"

# game/engine/hamun_arena/arena_aio.rpy:163
translate es hamun_arena_master_questions_menu_first_time_94a74e82:

    # HAMUN_ARENA_MASTER "You pay in blood here."
    HAMUN_ARENA_MASTER "Aquí se paga con sangre."

# game/engine/hamun_arena/arena_aio.rpy:166
translate es hamun_arena_master_questions_menu_first_time_beb6daa1:

    # HAMUN_ARENA_MASTER "There are five ranks within the arena."
    HAMUN_ARENA_MASTER "Hay cinco rangos dentro de la arena."

# game/engine/hamun_arena/arena_aio.rpy:167
translate es hamun_arena_master_questions_menu_first_time_5d206716:

    # HAMUN_ARENA_MASTER "To move between ranks, you must defeat ten opponents in each rank."
    HAMUN_ARENA_MASTER "Para avanzar entre rangos, debes derrotar a diez oponentes en cada rango."

# game/engine/hamun_arena/arena_aio.rpy:168
translate es hamun_arena_master_questions_menu_first_time_f1d4b60a:

    # HAMUN_ARENA_MASTER "Followed by a special match of our choosing."
    HAMUN_ARENA_MASTER "Seguido de un combate especial de nuestra elección."

# game/engine/hamun_arena/arena_aio.rpy:169
translate es hamun_arena_master_questions_menu_first_time_1b9223ca:

    # HAMUN_ARENA_MASTER "...As a word of warning, we may restrict your access to some of the higher ranks if we don't feel you're ready."
    HAMUN_ARENA_MASTER "...Como advertencia, podemos restringir tu acceso a algunos de los rangos más altos si consideramos que no estás preparado."

# game/engine/hamun_arena/arena_aio.rpy:170
translate es hamun_arena_master_questions_menu_first_time_5b2e12c5:

    # HAMUN_ARENA_MASTER "We want a glorious battle on the sand... not a bloody massacre before the audience even sits down."
    HAMUN_ARENA_MASTER "Queremos una batalla gloriosa en la arena... no una masacre sangrienta antes de que el público se siente."

# game/engine/hamun_arena/arena_aio.rpy:173
translate es hamun_arena_master_questions_menu_first_time_ab7228a3:

    # HAMUN_ARENA_MASTER "Monsters, warriors... strange creatures from faraway lands."
    HAMUN_ARENA_MASTER "Monstruos, guerreros... extrañas criaturas de tierras lejanas."

# game/engine/hamun_arena/arena_aio.rpy:174
translate es hamun_arena_master_questions_menu_first_time_0fec0d5e:

    # HAMUN_ARENA_MASTER "Whatever we think will draw in the most crowds."
    HAMUN_ARENA_MASTER "Lo que consideremos que atraerá a más público."

# game/engine/hamun_arena/arena_aio.rpy:177
translate es hamun_arena_master_questions_menu_first_time_88523b26:

    # HAMUN_ARENA_MASTER "The higher the ranked matches, the higher the coin."
    HAMUN_ARENA_MASTER "Cuanto más alta sea la clasificación de los combates, mayor será la recompensa."

# game/engine/hamun_arena/arena_aio.rpy:178
translate es hamun_arena_master_questions_menu_first_time_5c0ba242:

    # HAMUN_ARENA_MASTER "Though sometimes, rewards may be offered in place of coin."
    HAMUN_ARENA_MASTER "Aunque a veces, en lugar de monedas, se pueden ofrecer recompensas."

# game/engine/hamun_arena/arena_aio.rpy:181
translate es hamun_arena_master_questions_menu_first_time_0197c051:

    # HAMUN_ARENA_MASTER "Good... Now shall we discuss arranging a match?"
    HAMUN_ARENA_MASTER "Bien... ¿Hablamos ahora de organizar un combate?"

# game/engine/hamun_arena/arena_aio.rpy:187
translate es hamun_arena_master_talk_aaca8c6f:

    # HAMUN_ARENA_MASTER "Yes?"
    HAMUN_ARENA_MASTER "¿Sí?"

# game/engine/hamun_arena/arena_aio.rpy:189
translate es hamun_arena_master_talk_8a0e5bbb:

    # HAMUN_ARENA_MASTER "Yes, Sun Forged?"
    HAMUN_ARENA_MASTER "¿Sí, forjado en el sol?"

# game/engine/hamun_arena/arena_aio.rpy:197
translate es hamun_arena_master_signup_449b8311:

    # HAMUN_ARENA_MASTER "The sun is set, it's too late now."
    HAMUN_ARENA_MASTER "El sol se ha puesto, ya es demasiado tarde."

# game/engine/hamun_arena/arena_aio.rpy:198
translate es hamun_arena_master_signup_989e2dce:

    # HAMUN_ARENA_MASTER "Come back tomorrow."
    HAMUN_ARENA_MASTER "Vuelve mañana."

# game/engine/hamun_arena/arena_aio.rpy:202
translate es hamun_arena_master_signup_bfaf9441:

    # HAMUN_ARENA_MASTER "The crowd have seen enough of you for today, warrior."
    HAMUN_ARENA_MASTER "La multitud ya ha visto suficiente de ti por hoy, guerrero."

# game/engine/hamun_arena/arena_aio.rpy:203
translate es hamun_arena_master_signup_2d4f6bd9:

    # HAMUN_ARENA_MASTER "Come back tomorrow for another fight."
    HAMUN_ARENA_MASTER "Vuelve mañana para otra pelea."

# game/engine/hamun_arena/arena_aio.rpy:205
translate es hamun_arena_master_signup_54e5c8f4:

    # HAMUN_ARENA_MASTER "Heh... Whose blood shall stain the sacred sands, then?"
    HAMUN_ARENA_MASTER "Je... ¿De quién será entonces la sangre que manchará las arenas sagradas?"

# game/engine/hamun_arena/arena_aio.rpy:233
translate es hamun_arena_master_signup_aa724bd9:

    # HAMUN_ARENA_MASTER "Stop wasting my time."
    HAMUN_ARENA_MASTER "Deja de hacerme perder el tiempo."

# game/engine/hamun_arena/arena_aio.rpy:240
translate es hamun_arena_master_rank_advanced_4c202287:

    # HAMUN_ARENA_MASTER "Quite a fight, warrior!"
    HAMUN_ARENA_MASTER "¡Menuda pelea, guerrero!"

# game/engine/hamun_arena/arena_aio.rpy:242
translate es hamun_arena_master_rank_advanced_ee81b14e:

    # HAMUN_ARENA_MASTER "You are now ranked {i}Sun Forged{/i}."
    HAMUN_ARENA_MASTER "Ahora tienes el rango de {i}forjado en el sol{/i}."

# game/engine/hamun_arena/arena_aio.rpy:243
translate es hamun_arena_master_rank_advanced_09d632d7:

    # HAMUN_ARENA_MASTER "Enjoy your fame!"
    HAMUN_ARENA_MASTER "¡Disfruta de tu fama!"

# game/engine/hamun_arena/arena_aio.rpy:244
translate es hamun_arena_master_rank_advanced_fd8f1892:

    # HAMUN_ARENA_MASTER "...while it lasts."
    HAMUN_ARENA_MASTER "...mientras dure."

