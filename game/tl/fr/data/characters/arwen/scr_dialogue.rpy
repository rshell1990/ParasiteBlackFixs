translate fr dialogue_arwen_othergirls_menu_bcc3804b:

    # ARWEN @ talk "What do you want to know?"
    ARWEN @ talk "Que veux-tu savoir ?"

# game/data/characters/arwen/scr_dialogue.rpy:11
translate fr dialogue_arwen_othergirls_menu_f72c231a:

    # ARWEN @ talk "Well... Now you're speaking a girls favourite language!"
    ARWEN @ talk "Eh bien... Maintenant, tu parles le langage préféré des filles !"

# game/data/characters/arwen/scr_dialogue.rpy:13
translate fr dialogue_arwen_othergirls_menu_ab602309:

    # ARWEN @ talk "Was there someone specific you wanted to ask about?"
    ARWEN @ talk "Y avait-il quelqu'un en particulier à propos de qui tu voulais demander ?"

# game/data/characters/arwen/scr_dialogue.rpy:16
translate fr dialogue_arwen_othergirls_menu_paid_5c4b33c4:

    # ARWEN @ angry "Hm? Oh, {i}her{/i} I'd avoid her if I was you."
    ARWEN @ angry "Hein ? Oh, {i}elle{/i}, je l'éviterais si j'étais toi."

# game/data/characters/arwen/scr_dialogue.rpy:17
translate fr dialogue_arwen_othergirls_menu_paid_d42b7565:

    # ARWEN @ angry "Overpriced to put it mildly, you'd think she was a virgin princess with how highly she views herself."
    ARWEN @ angry "Hors de prix pour dire le moins, on croirait qu'elle est une princesse vierge à voir comment elle se surestime."

# game/data/characters/arwen/scr_dialogue.rpy:18
translate fr dialogue_arwen_othergirls_menu_paid_1950d15a:

    # ARWEN @ blush "Don't worry though, I'll show you what a {i}real{/i} woman can do."
    ARWEN @ blush "Ne t'inquiète pas, je vais te montrer ce qu'une {i}vraie{/i} femme sait faire."

# game/data/characters/arwen/scr_dialogue.rpy:21
translate fr dialogue_arwen_othergirls_menu_paid_77c1d01c:

    # ARWEN @ think "Hmm, nice enough girl."
    ARWEN @ think "Hmm, une fille plutôt sympa."

# game/data/characters/arwen/scr_dialogue.rpy:22
translate fr dialogue_arwen_othergirls_menu_paid_879dd5c5:

    # ARWEN @ talk "But I think she's a little {i}too{/i} desperate to work in here."
    ARWEN @ talk "Mais je pense qu'elle est un peu {i}trop{/i} désespérée pour vouloir travailler ici."

# game/data/characters/arwen/scr_dialogue.rpy:23
translate fr dialogue_arwen_othergirls_menu_paid_35cb4a19:

    # ARWEN @ talk "As far as I know, they let her stay and serve clients outside for a reduced rate, but I doubt she'll get through the door."
    ARWEN @ talk "Pour autant que je sache, ils l'ont laissée rester et servir les clients à l'extérieur pour un tarif réduit, mais je doute qu'elle franchisse la porte."

# game/data/characters/arwen/scr_dialogue.rpy:24
translate fr dialogue_arwen_othergirls_menu_paid_da22f4ce:

    # MC @ talk "Why's that?"
    MC @ talk "Pourquoi donc ?"

# game/data/characters/arwen/scr_dialogue.rpy:25
translate fr dialogue_arwen_othergirls_menu_paid_8e2a16c2:

    # ARWEN @ talk "Look around you, we're not the {i}Black Diamond,{/i} we general serve adventurers and merchants with coin to burn."
    ARWEN @ talk "Regarde autour de toi, on n'est pas le {i}Diamant Noir,{/i} on sert généralement des aventuriers et des marchands qui ont de l'argent à dépenser."

# game/data/characters/arwen/scr_dialogue.rpy:26
translate fr dialogue_arwen_othergirls_menu_paid_e4fcf857:

    # ARWEN @ talk "And she's out there letting the city guard take put it in her ass behind a wall... Hardly a good fit."
    ARWEN @ talk "Et elle, dehors, elle laisse la garde de la ville se la mettre dans le cul derrière un mur... Pas vraiment un bon profil."

# game/data/characters/arwen/scr_dialogue.rpy:27
translate fr dialogue_arwen_othergirls_menu_paid_33eafac5:

    # MC @ talk "That seems rather harsh..."
    MC @ talk "Ça me paraît plutôt dur..."

# game/data/characters/arwen/scr_dialogue.rpy:28
translate fr dialogue_arwen_othergirls_menu_paid_8c61c9e1:

    # ARWEN @ talk "It's just business darling... it's always cut-throat, no matter the trade."
    ARWEN @ talk "Ce sont les affaires, chérie... c'est toujours impitoyable, quel que soit le métier."

# game/data/characters/arwen/scr_dialogue.rpy:31
translate fr dialogue_arwen_othergirls_menu_paid_480f5c90:

    # ARWEN @ talk "Alright then, was there something else?"
    ARWEN @ talk "Bon, alors, il y avait autre chose ?"

# game/data/characters/arwen/scr_dialogue.rpy:34
translate fr dialogue_arwen_othergirls_menu_paid_7417b5c7:

    # ARWEN @ talk "Alright then, let's hear it."
    ARWEN @ talk "Très bien, allons-y, écoute ça."

