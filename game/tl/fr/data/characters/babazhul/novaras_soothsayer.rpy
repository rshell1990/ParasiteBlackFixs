# game/data/characters/babazhul/novaras_soothsayer.rpy:49
translate fr nov_soothsayer_firstmeet_90717a1f:

    # "Entering into the darkened room of the soothsayer I looked around."
    "En entrant dans la pièce sombre du devin, je regardai autour de moi."

# game/data/characters/babazhul/novaras_soothsayer.rpy:50
translate fr nov_soothsayer_firstmeet_7bd2c3f6:

    # "The room was dimly lit only by pale candle light, with strange trinkets from faraway lands adorning every corner of the room, strange skulls and books in ancient tongues long since dead."
    "La pièce n'était que faiblement éclairée par la pâle lueur des bougies, d'étranges bibelots venus de contrées lointaines ornant chaque recoin, d'étranges crânes et des livres en des langues anciennes disparues depuis longtemps."

# game/data/characters/babazhul/novaras_soothsayer.rpy:51
translate fr nov_soothsayer_firstmeet_406bc049:

    # "Here and there was a stuffed bird or some scroll with strange markings on it littered around on the floor amongst the pile of many books."
    "Çà et là gisaient un oiseau empaillé ou quelque parchemin couvert d'étranges marques, éparpillés sur le sol parmi un amas de nombreux livres."

# game/data/characters/babazhul/novaras_soothsayer.rpy:52
translate fr nov_soothsayer_firstmeet_5d595e11:

    # "The old hag was sat down at her seat, hunched over her desk looming over a crystal ball as she looked towards me expectantly."
    "La vieille sorcière était assise à sa place, voûtée sur son bureau, penchée au-dessus d'une boule de cristal tout en me regardant avec expectative."

# game/data/characters/babazhul/novaras_soothsayer.rpy:54
translate fr nov_soothsayer_firstmeet_f1746c4b:

    # BABAZHUL "Greetings, child of tooth and claw."
    BABAZHUL "Salutations, enfant de la dent et de la griffe."

# game/data/characters/babazhul/novaras_soothsayer.rpy:55
translate fr nov_soothsayer_firstmeet_783baad9:

    # BABAZHUL "How may Babazhul help you?"
    BABAZHUL "Comment Babazhul peut-il vous aider ?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:56
translate fr nov_soothsayer_firstmeet_44f8b91f:

    # MC "Hm? Child of what?"
    MC "Hmm ? Enfant de quoi ?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:57
translate fr nov_soothsayer_firstmeet_5ce13e03:

    # MC "What are you talking about?"
    MC "De quoi parlez-vous ?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:62
translate fr nov_soothsayer_firstmeet_70e666cf:

    # BABAZHUL "{i}The old gods stir with the new, the great games' next chapter shall soon begin.{/i}"
    BABAZHUL "{i}Les vieux dieux s'agitent avec les nouveaux, le prochain chapitre des grands jeux va bientôt commencer.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:63
translate fr nov_soothsayer_firstmeet_909f2c0d:

    # BABAZHUL "{i}A great warrior shall join you, the great tooth and claw, a forgotten lord from a time lost beyond the stars.{/i}"
    BABAZHUL "{i}Un grand guerrier vous rejoindra, le grand dent et griffe, un seigneur oublié d'une époque perdue au-delà des étoiles.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:64
translate fr nov_soothsayer_firstmeet_92a43a18:

    # BABAZHUL "{i}To battle the dreaming king, whose restless fury shall scorch these lands.{/i}"
    BABAZHUL "{i}Combattre le roi rêveur, dont la fureur agitée embrasera ces terres.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:65
translate fr nov_soothsayer_firstmeet_127488ac:

    # MC "What the~"
    MC "Qu'est-ce que~"

# game/data/characters/babazhul/novaras_soothsayer.rpy:66
translate fr nov_soothsayer_firstmeet_086e21f9:

    # MC "Gods? A Dreaming king? Great warriors?"
    MC "Des dieux ? Un roi rêveur ? De grands guerriers ?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:69
translate fr nov_soothsayer_firstmeet_8e3236f6:

    # "The soothsayer went silent for a moment, before continuing in her raspy voice:"
    "La devineresse resta silencieuse un moment, avant de continuer de sa voix rauque :"

# game/data/characters/babazhul/novaras_soothsayer.rpy:70
translate fr nov_soothsayer_firstmeet_ccab7ebe:

    # BABAZHUL "In time ... All will be clear, [player_name!t]."
    BABAZHUL "Avec le temps ... Tout deviendra clair, [player_name!t]."

# game/data/characters/babazhul/novaras_soothsayer.rpy:71
translate fr nov_soothsayer_firstmeet_9cbf7f9a:

    # MC "...How did you know my-"
    MC "...Comment as-tu su mon-"

# game/data/characters/babazhul/novaras_soothsayer.rpy:72
translate fr nov_soothsayer_firstmeet_f1768875:

    # BABAZHUL "Hahahaha!"
    BABAZHUL "Hahahaha!"

# game/data/characters/babazhul/novaras_soothsayer.rpy:75
translate fr nov_soothsayer_firstmeet_725e3592:

    # BABAZHUL @ talk "{i}I knew you would come,{/i} [player_name!t]."
    BABAZHUL @ talk "{i}Je savais que tu viendrais,{/i} [player_name!t]."

# game/data/characters/babazhul/novaras_soothsayer.rpy:76
translate fr nov_soothsayer_firstmeet_3d82d3ee:

    # MC "How did you know my name?"
    MC "Comment as-tu su mon nom ?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:77
translate fr nov_soothsayer_firstmeet_f14bc448:

    # BABAZHUL @ talk "Babazhul knows many names, many things that have passed and are yet to pass."
    BABAZHUL @ talk "Babazhul connaît de nombreux noms, de nombreuses choses qui sont passées et qui sont encore à venir."

# game/data/characters/babazhul/novaras_soothsayer.rpy:80
translate fr nov_soothsayer_firstmeet_ea08ba0d:

    # BABAZHUL @ talk "Now tell me child of tooth and claw, do you seek your past... {i}or your future?{/i}"
    BABAZHUL @ talk "Maintenant, dis-moi, enfant de la dent et de la griffe, cherches-tu ton passé... {i}ou ton avenir ?{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:81
translate fr nov_soothsayer_firstmeet_c58e7a45:

    # BABAZHUL @ talk "For but five gold, it can be yours..."
    BABAZHUL @ talk "Pour seulement cinq pièces d'or, cela peut être à toi..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:91
translate fr nov_soothsayer_talk_c96029cf:

    # BABAZHUL @ talk "Welcome back, child of tooth and claw."
    BABAZHUL @ talk "Bon retour, enfant de la dent et de la griffe."

# game/data/characters/babazhul/novaras_soothsayer.rpy:92
translate fr nov_soothsayer_talk_ea89362c:

    # BABAZHUL @ talk "Make your choice."
    BABAZHUL @ talk "Fais ton choix."

# game/data/characters/babazhul/novaras_soothsayer.rpy:102
translate fr nov_soothsayer_future_b2637f25:

    # BABAZHUL @ talk "So be it."
    BABAZHUL @ talk "Qu'il en soit ainsi."

# game/data/characters/babazhul/novaras_soothsayer.rpy:105
translate fr nov_soothsayer_future_c6eccf04:

    # "Babazhul hands lightly touched over her crystal ball, which brightly began to glow and illuminate as she stared deeply into it with her half blind eyes."
    "Les mains de Babazhul effleurèrent doucement sa boule de cristal, qui se mit à briller et à s'illuminer vivement alors qu'elle la fixait profondément de ses yeux à moitié aveugles."

# game/data/characters/babazhul/novaras_soothsayer.rpy:117
translate fr nov_soothsayer_future_3add1f07:

    # BABAZHUL @ talk "In time, perhaps, there might be clarity..."
    BABAZHUL @ talk "Avec le temps, peut-être, la clarté viendra..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:118
translate fr nov_soothsayer_future_fbf25a5c:

    # BABAZHUL @ talk "For now, I can see no more."
    BABAZHUL @ talk "Pour l'instant, je ne peux plus rien voir."

# game/data/characters/babazhul/novaras_soothsayer.rpy:122
translate fr nov_soothsayer_future_4424f154:

    # BABAZHUL @ talk "You do not possess enough coin, child, return when you do."
    BABAZHUL @ talk "Tu ne possèdes pas assez de pièces, enfant, reviens quand tu en auras."

# game/data/characters/babazhul/novaras_soothsayer.rpy:128
translate fr nov_soothsayer_goodbye_91ee6e03:

    # BABAZHUL @ talk "{i}*Laughs*{/i} Of course you will return... I've already foreseen it."
    BABAZHUL @ talk "{i}*Rires*{/i} Bien sûr que tu reviendras... Je l'ai déjà prévu."

# game/data/characters/babazhul/novaras_soothsayer.rpy:136
translate fr nov_soothsayer_future0_bd41ac2b:

    # BABAZHUL @ talk "I see a great shadow following you, a warrior of a thousand worlds."
    BABAZHUL @ talk "Je vois une grande ombre qui te suit, un guerrier aux mille mondes."

# game/data/characters/babazhul/novaras_soothsayer.rpy:137
translate fr nov_soothsayer_future0_62ae2cf6:

    # BABAZHUL @ talk "Sitting on a throne of bones, so alone and so cold."
    BABAZHUL @ talk "Assis sur un trône d'os, si seul et si froid."

# game/data/characters/babazhul/novaras_soothsayer.rpy:138
translate fr nov_soothsayer_future0_1c0474f3:

    # BABAZHUL @ talk "He would sit forever... Enjoy the silence, if not for his master's call."
    BABAZHUL @ talk "Il resterait assis pour toujours... Profiter du silence, si ce n'était l'appel de son maître."

# game/data/characters/babazhul/novaras_soothsayer.rpy:146
translate fr nov_soothsayer_future1_c59e6106:

    # BABAZHUL @ talk "Hahaha! I see her fire, Princess raised by shadows and knives, born into a lie."
    BABAZHUL @ talk "Hahaha ! Je vois son feu, Princesse élevée par les ombres et les couteaux, née dans un mensonge."

# game/data/characters/babazhul/novaras_soothsayer.rpy:147
translate fr nov_soothsayer_future1_34e35823:

    # BABAZHUL @ talk "The great stars lay before her, and perhaps you at her side."
    BABAZHUL @ talk "Les grandes étoiles s'étendent devant elle, et peut-être toi à ses côtés."

# game/data/characters/babazhul/novaras_soothsayer.rpy:148
translate fr nov_soothsayer_future1_36bd14f0:

    # BABAZHUL @ talk "Oh child of tooth and claw, we shall see if love can truly conquer all!"
    BABAZHUL @ talk "Ô enfant des crocs et des griffes, nous verrons si l'amour peut vraiment tout vaincre !"

# game/data/characters/babazhul/novaras_soothsayer.rpy:156
translate fr nov_soothsayer_future2_d966afcc:

    # BABAZHUL @ talk "The imitation stalks these lands, a beautiful souless beast."
    BABAZHUL @ talk "L'imitation arpente ces terres, une belle bête sans âme."

# game/data/characters/babazhul/novaras_soothsayer.rpy:157
translate fr nov_soothsayer_future2_beae5065:

    # BABAZHUL @ talk "Nothing but death awaits, yet how sweet will she be when she poisons your soul with honey."
    BABAZHUL @ talk "Seule la mort attend, mais qu'elle sera douce quand elle empoisonnera ton âme de miel."

# game/data/characters/babazhul/novaras_soothsayer.rpy:158
translate fr nov_soothsayer_future2_9bd746f0:

    # BABAZHUL @ talk "See past the lies and beware, beware child of tooth and claw:"
    BABAZHUL @ talk "Vois au-delà des mensonges et prends garde, prends garde enfant des crocs et des griffes :"

# game/data/characters/babazhul/novaras_soothsayer.rpy:159
translate fr nov_soothsayer_future2_02815b56:

    # BABAZHUL @ talk "The beautiful souless beast may be your demise."
    BABAZHUL @ talk "La belle bête sans âme pourrait causer ta perte."

# game/data/characters/babazhul/novaras_soothsayer.rpy:166
translate fr nov_soothsayer_future3_f914e12e:

    # BABAZHUL @ talk "My my, child! Such sweet fruits await! One in green, one in blue, one with scales, one so small, you could carry four! Hahaha!"
    BABAZHUL @ talk "Mon Dieu, mon enfant ! De si doux fruits t'attendent ! Un en vert, un en bleu, un avec des écailles, un si petit que tu pourrais en porter quatre ! Hahaha !"

# game/data/characters/babazhul/novaras_soothsayer.rpy:167
translate fr nov_soothsayer_future3_5a07672c:

    # BABAZHUL @ talk "Their love will guide you through the darkness to come, cling to it, embrace it, hold them dear and close."
    BABAZHUL @ talk "Leur amour te guidera à travers les ténèbres à venir, accroche-toi à lui, embrasse-le, tiens-les chers et proches."

# game/data/characters/babazhul/novaras_soothsayer.rpy:168
translate fr nov_soothsayer_future3_f7410e2c:

    # BABAZHUL @ talk "For when the time comes, you must face the darkness alone..."
    BABAZHUL @ talk "Car quand le moment viendra, tu devras affronter les ténèbres seul..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:176
translate fr nov_soothsayer_future4_37ac8a1d:

    # BABAZHUL @ talk "He sits at the helm of ultimate destruction, more ghost than man but he will return home."
    BABAZHUL @ talk "Il siège à la barre de la destruction ultime, plus fantôme qu'homme mais il rentrera chez lui."

# game/data/characters/babazhul/novaras_soothsayer.rpy:177
translate fr nov_soothsayer_future4_68e013f7:

    # BABAZHUL @ talk "Oh child of tooth and claw, to forever be reaching for the past is a terrible thing."
    BABAZHUL @ talk "Oh enfant de croc et de griffe, tendre éternellement vers le passé est une chose terrible."

# game/data/characters/babazhul/novaras_soothsayer.rpy:178
translate fr nov_soothsayer_future4_41a33087:

    # BABAZHUL @ talk "It may make monsters of us all..."
    BABAZHUL @ talk "Cela pourrait faire de nous tous des monstres..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:185
translate fr nov_soothsayer_future5_521823e0:

    # BABAZHUL @ talk "I see two brothers, stood on opposite cliffs."
    BABAZHUL @ talk "Je vois deux frères, se tenant sur des falaises opposées."

# game/data/characters/babazhul/novaras_soothsayer.rpy:186
translate fr nov_soothsayer_future5_9eb10f6e:

    # BABAZHUL @ talk "A terrible storm rages, the black waves thrashing beneath their feet."
    BABAZHUL @ talk "Une terrible tempête fait rage, les vagues noires se déchaînant sous leurs pieds."

# game/data/characters/babazhul/novaras_soothsayer.rpy:187
translate fr nov_soothsayer_future5_60b3ce80:

    # BABAZHUL @ talk "Both weep... But the fire inside makes them scream."
    BABAZHUL @ talk "Tous deux pleurent... Mais le feu intérieur les fait crier."

# game/data/characters/babazhul/novaras_soothsayer.rpy:188
translate fr nov_soothsayer_future5_2126ec51:

    # BABAZHUL @ talk "How the ones we love cut so deep."
    BABAZHUL @ talk "Comme ceux que nous aimons blessent si profondément."

# game/data/characters/babazhul/novaras_soothsayer.rpy:195
translate fr nov_soothsayer_future6_7454759e:

    # BABAZHUL @ talk "Grief... I feel his grief."
    BABAZHUL @ talk "Chagrin... Je ressens son chagrin."

# game/data/characters/babazhul/novaras_soothsayer.rpy:196
translate fr nov_soothsayer_future6_d647c32f:

    # BABAZHUL @ talk "It has made a monster of him, and it drives him to do terrible things."
    BABAZHUL @ talk "Cela a fait de lui un monstre, et cela le pousse à faire des choses terribles."

# game/data/characters/babazhul/novaras_soothsayer.rpy:197
translate fr nov_soothsayer_future6_7a7c1972:

    # BABAZHUL @ talk "But his fate is not yet sealed."
    BABAZHUL @ talk "Mais son destin n'est pas encore scellé."

# game/data/characters/babazhul/novaras_soothsayer.rpy:198
translate fr nov_soothsayer_future6_c96105ba:

    # BABAZHUL @ talk "What will become of him?"
    BABAZHUL @ talk "Qu'adviendra-t-il de lui ?"

translate fr strings:

    # game/data/characters/babazhul/novaras_soothsayer.rpy:29
    old "Talk to Babazhul"
    new "Parler à Babazhul"

    # game/data/characters/babazhul/novaras_soothsayer.rpy:40
    old "Speak to me of the future, soothsayer."
    new "Parle-moi de l'avenir, devin."

    # game/data/characters/babazhul/novaras_soothsayer.rpy:41
    old "I long to walk through my past once again."
    new "J'aspire à parcourir mon passé une fois de plus."

    # game/data/characters/babazhul/novaras_soothsayer.rpy:42
    old "I will return in time."
    new "Je reviendrai avec le temps."

