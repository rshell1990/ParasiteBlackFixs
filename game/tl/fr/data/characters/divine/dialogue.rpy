# game/data/characters/divine/dialogue.rpy:28
translate fr divine_talk_90c8d59c:

    # DIVINE "How can I help you, child?"
    DIVINE "Comment puis-je t'aider, mon enfant ?"

# game/data/characters/divine/dialogue.rpy:33
translate fr divine_bye_65c4d26d:

    # DIVINE "Be well, child."
    DIVINE "Porte-toi bien, mon enfant."

# game/data/characters/divine/dialogue.rpy:38
translate fr divine_questions1_528d4f7e:

    # DIVINE "You’ve come here for a lesson?"
    DIVINE "Tu es venu ici pour une leçon ?"

# game/data/characters/divine/dialogue.rpy:39
translate fr divine_questions1_b6ffd923:

    # MC "I know the basics..."
    MC "Je connais les bases..."

# game/data/characters/divine/dialogue.rpy:40
translate fr divine_questions1_81705d71:

    # DIVINE "... It is said the great goddess Palam was born Palon, God of Love."
    DIVINE "... On dit que la grande déesse Palam est née Palon, Dieu de l'Amour."

# game/data/characters/divine/dialogue.rpy:41
translate fr divine_questions1_2fb56672:

    # DIVINE "Palon watched and meddled in the romantic affairs of both our realm and the realm of the gods. "
    DIVINE "Palon observait et s'immisçait dans les affaires amoureuses à la fois de notre royaume et du royaume des dieux."

# game/data/characters/divine/dialogue.rpy:42
translate fr divine_questions1_1687c0e9:

    # DIVINE "Uniting couples rarely thought a good match by many, but he always knew better."
    DIVINE "Il unissait des couples rarement considérés comme bien assortis par beaucoup, mais il savait toujours ce qui était le mieux."

# game/data/characters/divine/dialogue.rpy:43
translate fr divine_questions1_197036a6:

    # DIVINE "... But Palon was displeased with his form... He wanted his outer beauty to reflect the inner love he lavished upon us Alderians."
    DIVINE "... Mais Palon était mécontent de sa forme... Il voulait que sa beauté extérieure reflète l'amour intérieur qu'il prodiguait à nous, Aldériens."

# game/data/characters/divine/dialogue.rpy:44
translate fr divine_questions1_d31444e6:

    # DIVINE "Envious of the female forms around him and feeling trapped in despair at the male form he occupied, he cast himself into the Great Blue Lagoon, emerging as the beautiful goddess Palam."
    DIVINE "Envieux des formes féminines qui l'entouraient et se sentant piégé dans le désespoir face à la forme masculine qu'il occupait, il se jeta dans la Grande Lagune Bleue, émergeant comme la belle déesse Palam."

# game/data/characters/divine/dialogue.rpy:45
translate fr divine_questions1_88ca4f57:

    # DIVINE "The great goddess Palam bestows upon those born with her favour the greatest powers of healing in the realm."
    DIVINE "La grande déesse Palam confère à ceux qui naissent avec sa faveur les plus grands pouvoirs de guérison du royaume."

# game/data/characters/divine/dialogue.rpy:46
translate fr divine_questions1_91554ae3:

    # DIVINE "Through her wisdom and guidance, our bodies are also changed to her desired form."
    DIVINE "Grâce à sa sagesse et à ses conseils, nos corps sont également transformés selon la forme qu'elle désire."

# game/data/characters/divine/dialogue.rpy:47
translate fr divine_questions1_7a9989a8:

    # MC "Is that why all the mages under her blessing were born as... born as..."
    MC "Est-ce pour cela que tous les mages sous sa bénédiction sont nés en tant que... en tant que..."

# game/data/characters/divine/dialogue.rpy:48
translate fr divine_questions1_d23314df:

    # DIVINE "... Men?"
    DIVINE "... des hommes ?"

# game/data/characters/divine/dialogue.rpy:49
translate fr divine_questions1_07266d13:

    # MC "Yes."
    MC "Oui."

# game/data/characters/divine/dialogue.rpy:50
translate fr divine_questions1_8241ba3e:

    # DIVINE "We all were once... But once the change has begun there is little difference."
    DIVINE "Nous étions tous ainsi autrefois... Mais une fois le changement enclenché, il y a peu de différence."

# game/data/characters/divine/dialogue.rpy:51
translate fr divine_questions1_85be0231:

    # MC "But you have... {i}*Cough*{/i}"
    MC "Mais vous avez... {i}*Tousse*{/i}"

# game/data/characters/divine/dialogue.rpy:52
translate fr divine_questions1_7aa6d0fb:

    # "Sister Divine raised an eyebrow and smirked as I tripped over the words. "
    "Sœur Divine haussa un sourcil et sourit d'un air narquois alors que je trébuchais sur les mots."

# game/data/characters/divine/dialogue.rpy:53
translate fr divine_questions1_84878a10:

    # DIVINE "{i}Both sets?{/i}"
    DIVINE "{i}Les deux ?{/i}"

# game/data/characters/divine/dialogue.rpy:54
translate fr divine_questions1_054508a6:

    # MC "U-Uhh... Well..."
    MC "E-Euh... Eh bien..."

# game/data/characters/divine/dialogue.rpy:55
translate fr divine_questions1_cf86a073:

    # MC "That... must be difficult."
    MC "Cela... doit être difficile."

# game/data/characters/divine/dialogue.rpy:56
translate fr divine_questions1_365ffb04:

    # "Sister Divine smiled mischievously as she leaned forward."
    "Sœur Divine sourit malicieusement en se penchant en avant."

# game/data/characters/divine/dialogue.rpy:57
translate fr divine_questions1_b1140467:

    # DIVINE "If you’re that curious, why don’t you ask one of our mages?"
    DIVINE "Si tu es si curieux, pourquoi ne demandes-tu pas à l'un de nos mages ?"

# game/data/characters/divine/dialogue.rpy:58
translate fr divine_questions1_1c2f036e:

    # DIVINE "Our goddess, unlike most, demands we take no vows of chastity, you know..."
    DIVINE "Notre déesse, contrairement à la plupart, n'exige pas que nous fassions vœu de chasteté, tu sais..."

# game/data/characters/divine/dialogue.rpy:59
translate fr divine_questions1_61f8f826:

    # "Sister Divine playfully winked before her back straightened once again."
    "Sœur Divine fit un clin d'œil malicieux avant de se redresser de nouveau."

# game/data/characters/divine/dialogue.rpy:62
translate fr divine_questions1_f399730a:

    # "She laughed at the comment."
    "Elle rit du commentaire."

# game/data/characters/divine/dialogue.rpy:63
translate fr divine_questions1_eea35513:

    # DIVINE "{i}Interesting...{/i}"
    DIVINE "{i}Intéressant...{/i}"

# game/data/characters/divine/dialogue.rpy:64
translate fr divine_questions1_04e3a2bf:

    # "Her eyes scanned over me, almost dismissively."
    "Son regard me parcourut, presque avec dédain."

# game/data/characters/divine/dialogue.rpy:70
translate fr divine_questions2_3054d177:

    # DIVINE "There is only ever a few hundred of us at one time... As the goddess wills..."
    DIVINE "Nous ne sommes jamais plus de quelques centaines à la fois... Comme la déesse le veut..."

# game/data/characters/divine/dialogue.rpy:71
translate fr divine_questions2_5a08631f:

    # MC "Why?"
    MC "Pourquoi ?"

# game/data/characters/divine/dialogue.rpy:72
translate fr divine_questions2_ef2c2d25:

    # DIVINE "We do not know... Only some are chosen, it’s not our place to question her decisions."
    DIVINE "Nous ne savons pas... Seuls certains sont choisis, il ne nous appartient pas de remettre en question ses décisions."

# game/data/characters/divine/dialogue.rpy:77
translate fr divine_firstmeet_28ad9124:

    # "The beautiful Mages of Palam, for all accounts were still human, though no cursory glance would make this obvious."
    "Les belles Mages de Palam, selon toute vraisemblance, étaient encore humaines, bien qu'aucun regard superficiel ne le laisse paraître."

# game/data/characters/divine/dialogue.rpy:78
translate fr divine_firstmeet_18aa2714:

    # "Born with the blessings of the goddess Palam, their bodies were morphed and now bore a blue complexion the goddess’ divine will moulds those chosen into her most desired form and then blesses them with her gift of divine healing."
    "Nées avec les bénédictions de la déesse Palam, leurs corps furent métamorphosés et arboraient désormais un teint bleu, la volonté divine de la déesse modelant les élues selon sa forme la plus désirée avant de les bénir de son don de guérison divine."

# game/data/characters/divine/dialogue.rpy:79
translate fr divine_firstmeet_587bb450:

    # "It is a place of ancient tradition, libraries of books piled high and strange hieroglyphs and runes on the floor in chalk that glowed different shades. "
    "C'est un lieu de tradition ancienne, avec des bibliothèques aux livres empilés jusqu'au plafond et d'étranges hiéroglyphes et runes tracées à la craie sur le sol, qui brillaient de différentes teintes."

# game/data/characters/divine/dialogue.rpy:80
translate fr divine_firstmeet_67703533:

    # "Taking centre stage was a great statue of the goddess Palam, her arms and wings outstretched. Here and there I glimpsed robed figures, their soft, blue faces barely visible before they quickly shuffled away with their spell books. "
    "Au centre se dressait une grande statue de la déesse Palam, les bras et les ailes déployés. Ici et là, j'apercevais des silhouettes en robe, leurs doux visages bleus à peine visibles avant qu'elles ne s'éclipsent rapidement avec leurs grimoires."

# game/data/characters/divine/dialogue.rpy:81
translate fr divine_firstmeet_95f6331a:

    # "A voice called out, sultry, but mature with age. "
    "Une voix retentit, sensuelle, mais mûrie par l'âge."

# game/data/characters/divine/dialogue.rpy:82
translate fr divine_firstmeet_216aba99:

    # UNKNOWN "... Quite the sight, is it not?"
    UNKNOWN "... C'est toute une vision, n'est-ce pas ?"

# game/data/characters/divine/dialogue.rpy:84
translate fr divine_firstmeet_44548582:

    # "I turned to look at the beautiful figure before me."
    "Je me tournai pour regarder la magnifique silhouette qui se tenait devant moi."

# game/data/characters/divine/dialogue.rpy:85
translate fr divine_firstmeet_696b9602:

    # MC "Oh, I’m sorry I didn’t see you there, sister."
    MC "Oh, je suis désolée, je ne vous avais pas vue, ma sœur."

# game/data/characters/divine/dialogue.rpy:86
translate fr divine_firstmeet_d9b3b42c:

    # DIVINE "You may call me Sister Divine... Now..."
    DIVINE "Vous pouvez m'appeler Sœur Divine... Maintenant..."

