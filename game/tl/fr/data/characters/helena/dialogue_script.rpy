# game/data/characters/helena/dialogue_script.rpy:4
translate fr nov_helena_firstmeet_a4c50776:

    # HELENA @ talk "Ahh, good evening sir."
    HELENA @ talk "Ahh, bonsoir monsieur."

# game/data/characters/helena/dialogue_script.rpy:5
translate fr nov_helena_firstmeet_fcddae28:

    # HELENA @ talk "How do you find yourself this Evening?"
    HELENA @ talk "Comment vous sentez-vous ce soir ?"

# game/data/characters/helena/dialogue_script.rpy:6
translate fr nov_helena_firstmeet_e63ccf3e:

    # HELENA @ smile "I am Helena, and yourself?"
    HELENA @ smile "Je suis Helena, et vous ?"

# game/data/characters/helena/dialogue_script.rpy:7
translate fr nov_helena_firstmeet_638d46d2:

    # MC @ talk "A pleasure to meet you Helena, I am called [player_name!t]."
    MC @ talk "Ravi de vous rencontrer, Helena. On m'appelle [player_name!t]."

# game/data/characters/helena/dialogue_script.rpy:8
translate fr nov_helena_firstmeet_48a9321b:

    # HELENA @ talk "Hmm, your name sounds familiar..."
    HELENA @ talk "Hmm, votre nom me semble familier..."

# game/data/characters/helena/dialogue_script.rpy:9
translate fr nov_helena_firstmeet_4659a883:

    # HELENA @ shock "Wait, I know of you."
    HELENA @ shock "Attendez, je vous connais."

# game/data/characters/helena/dialogue_script.rpy:10
translate fr nov_helena_firstmeet_e1f13c50:

    # HELENA @ talk "You and your friend are the scouts who survived the recent expedition."
    HELENA @ talk "Vous et votre ami êtes les éclaireurs qui ont survécu à la récente expédition."

# game/data/characters/helena/dialogue_script.rpy:11
translate fr nov_helena_firstmeet_d2fa7c7f:

    # HELENA @ lewd "I see they did not exagerrate when they spoke of how handsome you are."
    HELENA @ lewd "Je vois qu'ils n'exagéraient pas en disant à quel point vous êtes beau."

# game/data/characters/helena/dialogue_script.rpy:17
translate fr nov_helena_services_c3c21da7:

    # HELENA @ talk "I am afraid my services aren't for you."
    HELENA @ talk "Je crains que mes services ne soient pas pour vous."

# game/data/characters/helena/dialogue_script.rpy:18
translate fr nov_helena_services_c513028d:

    # MC @ talk "Wait, what?"
    MC @ talk "Attendez, quoi ?"

# game/data/characters/helena/dialogue_script.rpy:19
translate fr nov_helena_services_46c3977b:

    # HELENA @ smile "My clients are a small reserved of a certain social class."
    HELENA @ smile "Mes clients forment un petit cercle réservé d'une certaine classe sociale."

# game/data/characters/helena/dialogue_script.rpy:20
translate fr nov_helena_services_1a47015e:

    # HELENA @ talk "Only a certain social class I'm afraid."
    HELENA @ talk "Seulement une certaine classe sociale, j'en ai peur."

# game/data/characters/helena/dialogue_script.rpy:21
translate fr nov_helena_services_2a12bf32:

    # MC @ talk "You mean aristocrats and nobles then?"
    MC @ talk "Vous voulez dire les aristocrates et les nobles alors ?"

# game/data/characters/helena/dialogue_script.rpy:22
translate fr nov_helena_services_052927c7:

    # HELENA @ lewd2 "Not necessarily... I make special priced exceptions for men who have truly carved out a name for themselves."
    HELENA @ lewd2 "Pas nécessairement... Je fais des exceptions de prix pour les hommes qui ont vraiment su se faire un nom."

# game/data/characters/helena/dialogue_script.rpy:23
translate fr nov_helena_services_074a27e5:

    # HELENA @ smile "Men who get tongues wagging when they see me speaking with them."
    HELENA @ smile "Les hommes qui font jaser quand on me voit leur parler."

# game/data/characters/helena/dialogue_script.rpy:24
translate fr nov_helena_services_aa047f0d:

    # MC @ talk "Such as?"
    MC @ talk "Par exemple ?"

# game/data/characters/helena/dialogue_script.rpy:25
translate fr nov_helena_services_a5c33d70:

    # HELENA @ smile "I never kiss and tell."
    HELENA @ smile "Je ne révèle jamais mes secrets."

# game/data/characters/helena/dialogue_script.rpy:26
translate fr nov_helena_services_ca2c4f8b:

    # HELENA @ joy "But let's just say some adventurers who'd rather have their names kept a secret have come to me before."
    HELENA @ joy "Mais disons simplement que certains aventuriers qui préféreraient garder leur nom secret sont déjà venus me voir."

# game/data/characters/helena/dialogue_script.rpy:27
translate fr nov_helena_services_60e8bb1f:

    # MC @ talk "Humor me, what are your normal prices."
    MC @ talk "Fais-moi plaisir, quels sont tes tarifs normaux ?"

# game/data/characters/helena/dialogue_script.rpy:28
translate fr nov_helena_services_e1271a49:

    # HELENA @ smile "A night with me would cost you more than ten thousand coins."
    HELENA @ smile "Une nuit avec moi te coûterait plus de dix mille pièces."

# game/data/characters/helena/dialogue_script.rpy:29
translate fr nov_helena_services_74ca5542:

    # "I felt the blood drain from my face."
    "Je sentis le sang se retirer de mon visage."

# game/data/characters/helena/dialogue_script.rpy:30
translate fr nov_helena_services_0449bb90:

    # MC @ talk "T-Ten... thousand?"
    MC @ talk "D-Dix... mille ?"

# game/data/characters/helena/dialogue_script.rpy:31
translate fr nov_helena_services_99b30993:

    # MC @ talk "What about charging per act?"
    MC @ talk "Et si on facture par acte ?"

# game/data/characters/helena/dialogue_script.rpy:32
translate fr nov_helena_services_307909da:

    # HELENA @ talk "I'm afraid such a thing is far more becoming of a common whore than a courtesan."
    HELENA @ talk "Je crains qu'une telle chose ne soit bien plus digne d'une vulgaire putain que d'une courtisane."

# game/data/characters/helena/dialogue_script.rpy:33
translate fr nov_helena_services_9bb1df98:

    # HELENA @ talk "The clients a courtesan takes on expect us to be more reserved and discreit, our bodies not used by every passing traveler."
    HELENA @ talk "Les clients qu'une courtisane fréquente attendent de nous que nous soyons plus réservées et discrètes, nos corps n'étant pas utilisés par le premier voyageur de passage."

# game/data/characters/helena/dialogue_script.rpy:34
translate fr nov_helena_services_f2a6779b:

    # HELENA @ sad "Such a thing could ruin a courtesan's reputation should she behave like an ordinary lady of the night."
    HELENA @ sad "Une telle chose pourrait ruiner la réputation d'une courtisane si elle se comportait comme une simple fille de joie."

# game/data/characters/helena/dialogue_script.rpy:35
translate fr nov_helena_services_326690ca:

    # HELENA @ talk "Thus, our companionship is sold for the whole evening... Partly to avoid too much scrutiny."
    HELENA @ talk "Ainsi, notre compagnie se vend pour toute la soirée... En partie pour éviter trop de regards indiscrets."

# game/data/characters/helena/dialogue_script.rpy:36
translate fr nov_helena_services_dc064c48:

    # HELENA @ smile "And sometimes our clients simply want us to be a delight on their arms and make other lords and such jealous."
    HELENA @ smile "Et parfois, nos clients veulent simplement que nous soyons un ravissement à leur bras et rendions les autres seigneurs et autres jaloux."

# game/data/characters/helena/dialogue_script.rpy:37
translate fr nov_helena_services_dd4dfd06:

    # MC @ talk "Hmm, I see."
    MC @ talk "Hmm, je vois."

# game/data/characters/helena/dialogue_script.rpy:38
translate fr nov_helena_services_771bb20d:

    # MC "(Unless I want to spend a small fortune on her, I'll need to build my reputation through adventuring and such before she offers me better rates for her 'sevices'.)"
    MC "(À moins que je ne veuille dépenser une petite fortune pour elle, il me faudra bâtir ma réputation par l'aventure et autres avant qu'elle ne m'offre de meilleurs tarifs pour ses 'services'.)"

# game/data/characters/helena/dialogue_script.rpy:42
translate fr nov_helena_about_a754025e:

    # HELENA @ talk "Hm? I prefer to keep my past to myself... I find men are more drawn to what they see as some alluring mystery."
    HELENA @ talk "Hm? Je préfère garder mon passé pour moi... Je trouve que les hommes sont plus attirés par ce qu'ils perçoivent comme un mystère attirant."

# game/data/characters/helena/dialogue_script.rpy:43
translate fr nov_helena_about_8999f46f:

    # HELENA @ lewd2 "Perhaps one day I will tell you."
    HELENA @ lewd2 "Peut-être qu'un jour je te le dirai."

# game/data/characters/helena/dialogue_script.rpy:47
translate fr nov_helena_bye_a0f4734c:

    # HELENA @ talk "Speak soon."
    HELENA @ talk "On se parle bientôt."

