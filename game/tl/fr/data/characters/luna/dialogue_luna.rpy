    # LUNA @ smile "Hello! May I help you with something?"
    LUNA @ smile "Bonjour ! Puis-je vous aider en quelque chose ?"

# game/data/characters/luna/dialogue_luna.rpy:25
translate fr luna_bye_e42febf0:

    # LUNA "See you around!"
    LUNA "À bientôt !"

# game/data/characters/luna/dialogue_luna.rpy:30
translate fr luna_talk_cantgothere_58ea8463:

    # LUNA "Hey! You can't just walk in there."
    LUNA "Hé ! Vous ne pouvez pas entrer comme ça."

# game/data/characters/luna/dialogue_luna.rpy:35
translate fr luna_use_baths_03aa7676:

    # LUNA @ smile "Certainly!"
    LUNA @ smile "Certainement !"

# game/data/characters/luna/dialogue_luna.rpy:36
translate fr luna_use_baths_2f547f8a:

    # LUNA @ smile "For you and your companions that'll be two hundred and fifty coins."
    LUNA @ smile "Pour vous et vos compagnons, ce sera deux cent cinquante pièces."

# game/data/characters/luna/dialogue_luna.rpy:42
translate fr luna_use_baths_c0c26f2f:

    # LUNA @ talk "Okay then, should you make the decision, the {i}Princess' Dream{/i} is always ready to recieve guests."
    LUNA @ talk "D'accord, si vous prenez la décision, le {i}Princess' Dream{/i} est toujours prêt à recevoir des invités."

# game/data/characters/luna/dialogue_luna.rpy:48
translate fr luna_questions_9469500d:

    # LUNA @ talk "Hm? Questions?"
    LUNA @ talk "Hm ? Des questions ?"

# game/data/characters/luna/dialogue_luna.rpy:49
translate fr luna_questions_46ef7612:

    # LUNA @ talk "What do you want to know?"
    LUNA @ talk "Que voulez-vous savoir ?"

# game/data/characters/luna/dialogue_luna.rpy:52
translate fr luna_questions_menu_71d4ef92:

    # LUNA @ talk "Ahh..."
    LUNA @ talk "Ahh..."

# game/data/characters/luna/dialogue_luna.rpy:53
translate fr luna_questions_menu_64ef36ae:

    # LUNA @ talk "My husband was sea captain of a small merchant vessel."
    LUNA @ talk "Mon mari était capitaine d'un petit navire marchand."

# game/data/characters/luna/dialogue_luna.rpy:54
translate fr luna_questions_menu_2b407674:

    # LUNA @ talk "The coin was good, but the months at sea were long."
    LUNA @ talk "La pièce était bonne, mais les mois en mer étaient longs."

# game/data/characters/luna/dialogue_luna.rpy:55
translate fr luna_questions_menu_c067ca27:

    # LUNA @ think "That's why we saved up what money we could,"
    LUNA @ think "C'est pourquoi nous avons économisé tout l'argent que nous pouvions,"

# game/data/characters/luna/dialogue_luna.rpy:56
translate fr luna_questions_menu_7c370a02:

    # MC @ talk "He planned to retire and have us open up a store."
    MC @ talk "Il prévoyait de prendre sa retraite et de nous faire ouvrir un magasin."

# game/data/characters/luna/dialogue_luna.rpy:57
translate fr luna_questions_menu_51681a50:

    # LUNA @ sad "That is... until his ship was taken by a storm."
    LUNA @ sad "C'est... jusqu'à ce que son navire soit pris dans une tempête."

# game/data/characters/luna/dialogue_luna.rpy:58
translate fr luna_questions_menu_234263d1:

    # MC @ sad "I am sorry to hear that."
    MC @ sad "Je suis désolée d'apprendre cela."

# game/data/characters/luna/dialogue_luna.rpy:59
translate fr luna_questions_menu_02f03353:

    # LUNA @ sad "It's alright, it was a long time ago now."
    LUNA @ sad "Ça va, c'était il y a longtemps maintenant."

# game/data/characters/luna/dialogue_luna.rpy:60
translate fr luna_questions_menu_e8411806:

    # LUNA @ sad "It's... easier to talk about now."
    LUNA @ sad "C'est... plus facile d'en parler maintenant."

# game/data/characters/luna/dialogue_luna.rpy:61
translate fr luna_questions_menu_b6df5634:

    # LUNA @ think "Anyway, after my husband died, I was left with the coin we had managed to save up."
    LUNA @ think "Bref, après la mort de mon mari, je me suis retrouvée avec la pièce que nous avions réussi à économiser."

# game/data/characters/luna/dialogue_luna.rpy:62
translate fr luna_questions_menu_465a393c:

    # LUNA @ smile "I thought, well, no point running off with my tail between my leg."
    LUNA @ smile "Je me suis dit, eh bien, pas la peine de s'enfuir la queue entre les jambes."

# game/data/characters/luna/dialogue_luna.rpy:63
translate fr luna_questions_menu_34b15857:

    # LUNA @ smile "So, I looked around, and decided instead of a store,"
    LUNA @ smile "Alors, j'ai regardé autour de moi, et j'ai décidé qu'au lieu d'un magasin,"

# game/data/characters/luna/dialogue_luna.rpy:64
translate fr luna_questions_menu_e4722a60:

    # LUNA @ smile "A bathhouse sounded more fun to run."
    LUNA @ smile "Un bain public semblait plus amusant à gérer."

# game/data/characters/luna/dialogue_luna.rpy:65
translate fr luna_questions_menu_661169f5:

    # LUNA @ smile "Heh... Plus I get a warm bath whenever I want now."
    LUNA @ smile "Hé... En plus, je peux prendre un bain chaud quand je veux maintenant."

# game/data/characters/luna/dialogue_luna.rpy:66
translate fr luna_questions_menu_8a3ca43c:

    # LUNA @ talk "Hope that answers your question."
    LUNA @ talk "J'espère que cela répond à votre question."

# game/data/characters/luna/dialogue_luna.rpy:69
translate fr luna_questions_menu_94fb1e89:

    # LUNA @ talk "There's not many other places for a katai to start a business."
    LUNA @ talk "Il n'y a pas beaucoup d'autres endroits où un katai peut démarrer une entreprise."

# game/data/characters/luna/dialogue_luna.rpy:70
translate fr luna_questions_menu_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Quoi ?"

# game/data/characters/luna/dialogue_luna.rpy:71
translate fr luna_questions_menu_86a14c5e:

    # MC @ think "It's illegal for a katai to own a businss in Novaras or something?"
    MC @ think "C'est illégal pour un katai de posséder une entreprise à Novaras ou quelque chose comme ça ?"

# game/data/characters/luna/dialogue_luna.rpy:72
translate fr luna_questions_menu_23fd0367:

    # LUNA @ think "Not exactly."
    LUNA @ think "Pas exactement."

# game/data/characters/luna/dialogue_luna.rpy:73
translate fr luna_questions_menu_4b66451e:

    # LUNA @ sad "They just don't refuse to hand out any business licences."
    LUNA @ sad "Ils ne refusent tout simplement pas de délivrer des licences commerciales."

# game/data/characters/luna/dialogue_luna.rpy:74
translate fr luna_questions_menu_d4ac178e:

    # MC @ think "... None?"
    MC @ think "... Aucune ?"

# game/data/characters/luna/dialogue_luna.rpy:75
translate fr luna_questions_menu_9432b0bb:

    # LUNA @ talk "Well, they either outright refuse to grant permits and licences,"
    LUNA @ talk "Eh bien, soit ils refusent carrément d'accorder des permis et des licences,"

# game/data/characters/luna/dialogue_luna.rpy:76
translate fr luna_questions_menu_9b87abaa:

    # LUNA @ talk "Or, they charge ludicrous rates that no one in their right mind would pay."
    LUNA @ talk "Ou alors, ils imposent des prix exorbitants que personne de sensé n'accepterait de payer."

# game/data/characters/luna/dialogue_luna.rpy:77
translate fr luna_questions_menu_f068c751:

    # LUNA @ talk "Sometimes as high as five times as much the asking price of a normal human."
    LUNA @ talk "Parfois jusqu'à cinq fois le prix demandé pour un humain normal."

# game/data/characters/luna/dialogue_luna.rpy:78
translate fr luna_questions_menu_5fae091a:

    # LUNA @ sad "They tolerate some of the more powerful merchants when it comes to trade."
    LUNA @ sad "Ils tolèrent certains des marchands les plus puissants en matière de commerce."

# game/data/characters/luna/dialogue_luna.rpy:79
translate fr luna_questions_menu_8866674a:

    # LUNA @ sad "For the rest of us though?"
    LUNA @ sad "Mais pour le reste d'entre nous ?"

# game/data/characters/luna/dialogue_luna.rpy:80
translate fr luna_questions_menu_9b6f6a12:

    # LUNA @ sad "They're only interested in hiring us katai as either servants or whores."
    LUNA @ sad "Ils ne s'intéressent qu'à nous embaucher, nous les katai, comme domestiques ou prostituées."

# game/data/characters/luna/dialogue_luna.rpy:81
translate fr luna_questions_menu_209bb546:

    # MC @ talk "So that's why katai come here instead?"
    MC @ talk "C'est donc pour ça que les katai viennent ici à la place ?"

# game/data/characters/luna/dialogue_luna.rpy:82
translate fr luna_questions_menu_6a433e62:

    # LUNA @ talk "As dangerous as the free city is, it's {i}free.{/i}"
    LUNA @ talk "Aussi dangereuse que soit la ville libre, elle est {i}libre.{/i}"

# game/data/characters/luna/dialogue_luna.rpy:83
translate fr luna_questions_menu_804b4e81:

    # LUNA @ talk "At least here, we can etch out a life for ourselves."
    LUNA @ talk "Au moins ici, on peut se tailler une vie."

# game/data/characters/luna/dialogue_luna.rpy:86
translate fr luna_questions_menu_393b14e5:

    # LUNA @ talk "Alright then."
    LUNA @ talk "Très bien."

