translate fr numa_firstmeet_21e16c80:

    # UNKNOWN @ angry "... You must be new here, surface-breather."
    UNKNOWN @ angry "... Tu dois être nouveau ici, respirateur de surface."

# game/data/characters/numa/dialogue.rpy:147
translate fr numa_firstmeet_ddf856bd:

    # MC @ surprised "I can understand you!"
    MC @ surprised "Je peux vous comprendre !"

# game/data/characters/numa/dialogue.rpy:148
translate fr numa_firstmeet_35fb6662:

    # "My reply to her, almost instinctively, was one I understood... {i}but it was not Alderian words which flowed from my lips.{/i}"
    "Ma réponse, presque instinctive, en était une que je comprenais... {i}mais ce ne furent pas des mots aldériens qui s'écoulèrent de mes lèvres.{/i}"

# game/data/characters/numa/dialogue.rpy:149
translate fr numa_firstmeet_14312edc:

    # "The fish like woman seemed taken aback."
    "La femme à l'apparence de poisson sembla surprise."

# game/data/characters/numa/dialogue.rpy:150
translate fr numa_firstmeet_02d8a1e7:

    # UNKNOWN @ surprised "... Your Thalvënn is excellent!"
    UNKNOWN @ surprised "... Votre Thalvënn est excellent !"

# game/data/characters/numa/dialogue.rpy:151
translate fr numa_firstmeet_a4eeee01:

    # UNKNOWN @ smile "I don't think I've ever heard a surface breather speak the wave so clearly!"
    UNKNOWN @ smile "Je ne pense pas avoir jamais entendu un respirant de surface parler la vague aussi clairement !"

