# game/data/characters/numa/dialogue.rpy:65
translate fr numa_moreaboutpeople_4dff1363:

    # NUMA @ talk "Speak the wave, and I shall answer."
    NUMA @ talk "Parle à la vague, et je répondrai."

# game/data/characters/numa/dialogue.rpy:68
translate fr numa_moreaboutpeople_menu_f26655da:

    # NUMA @ talk "Once a month, our people wash up on the docks bringing supplies and gifts."
    NUMA @ talk "Une fois par mois, notre peuple s'échoue sur les docks apportant fournitures et cadeaux."

# game/data/characters/numa/dialogue.rpy:69
translate fr numa_moreaboutpeople_menu_0f7b9bbf:

    # NUMA @ talk "Treasure from sunken ships, pearls, some fish..."
    NUMA @ talk "Trésors provenant de navires coulés, perles, du poisson..."

# game/data/characters/numa/dialogue.rpy:70
translate fr numa_moreaboutpeople_menu_f222a1c7:

    # NUMA @ talk "In return, we are given weapons and armours forged."
    NUMA @ talk "En retour, on nous donne des armes et armures forgées."

# game/data/characters/numa/dialogue.rpy:71
translate fr numa_moreaboutpeople_menu_b1ea096b:

    # MC @ think "Why would you need such things?"
    MC @ think "Pourquoi auriez-vous besoin de telles choses ?"

# game/data/characters/numa/dialogue.rpy:72
translate fr numa_moreaboutpeople_menu_93d5f8b3:

    # NUMA @ serious "... The waves are a turbulent thing."
    NUMA @ serious "... Les vagues sont une chose turbulente."

# game/data/characters/numa/dialogue.rpy:73
translate fr numa_moreaboutpeople_menu_088c241e:

    # NUMA @ talk "They turn towards war."
    NUMA @ talk "Elles se tournent vers la guerre."

# game/data/characters/numa/dialogue.rpy:74
translate fr numa_moreaboutpeople_menu_416963ed:

    # MC @ think "War? What war?"
    MC @ think "La guerre ? Quelle guerre ?"

# game/data/characters/numa/dialogue.rpy:75
translate fr numa_moreaboutpeople_menu_7ed5d058:

    # NUMA @ talk "It matters not for you surface breathers."
    NUMA @ talk "Cela n'a pas d'importance pour vous, les respirants de la surface."

# game/data/characters/numa/dialogue.rpy:76
translate fr numa_moreaboutpeople_menu_ad0fd71f:

    # NUMA @ talk "There are many fiefdoms vying for power below the currents."
    NUMA @ talk "Il y a de nombreux fiefs qui se disputent le pouvoir sous les courants."

# game/data/characters/numa/dialogue.rpy:77
translate fr numa_moreaboutpeople_menu_35287cb9:

    # NUMA @ talk "The senate-"
    NUMA @ talk "Le sénat-"

# game/data/characters/numa/dialogue.rpy:78
translate fr numa_moreaboutpeople_menu_e906b857:

    # "She stopped herself, her lips curling into a forced smile."
    "Elle s'arrêta, ses lèvres se retroussant en un sourire forcé."

# game/data/characters/numa/dialogue.rpy:79
translate fr numa_moreaboutpeople_menu_24708383:

    # NUMA @ smile "Forgive me, your Thalvën is so good, I forgot myself for a moment."
    NUMA @ smile "Pardonnez-moi, votre Thalvën est si bon que je me suis oubliée un instant."

# game/data/characters/numa/dialogue.rpy:83
translate fr numa_moreaboutpeople_menu_f6a7145e:

    # NUMA @ talk "In order to maintain good relations with the merchants, a few of our Thalay kin were asked to work within the city."
    NUMA @ talk "Afin de maintenir de bonnes relations avec les marchands, on a demandé à quelques-uns de nos parents Thalay de travailler dans la ville."

# game/data/characters/numa/dialogue.rpy:84
translate fr numa_moreaboutpeople_menu_38f5e1d4:

    # NUMA @ talk "It is purely for diplomatic reasons, they even asked what role we would like."
    NUMA @ talk "C'est purement pour des raisons diplomatiques, ils ont même demandé quel rôle nous souhaiterions."

# game/data/characters/numa/dialogue.rpy:85
translate fr numa_moreaboutpeople_menu_dc0e7cd8:

    # NUMA @ smile "I asked to help run a library, so they had built this place to accomodate my needs."
    NUMA @ smile "J'ai demandé à aider à gérer une bibliothèque, alors ils ont fait construire cet endroit pour répondre à mes besoins."

# game/data/characters/numa/dialogue.rpy:86
translate fr numa_moreaboutpeople_menu_b4acba9f:

    # MC @ think "They built a whole library for you?"
    MC @ think "Ils ont construit toute une bibliothèque pour vous ?"

# game/data/characters/numa/dialogue.rpy:87
translate fr numa_moreaboutpeople_menu_3fbd73b2:

    # NUMA @ talk "No, they built a whole library to keep my kin happy... I just happen to work within it."
    NUMA @ talk "Non, ils ont construit toute une bibliothèque pour garder mes semblables heureux... Il se trouve que j'y travaille simplement."

# game/data/characters/numa/dialogue.rpy:91
translate fr numa_moreaboutpeople_menu_32267830:

    # NUMA @ talk "Of course... It pleases me to be able to talk to one as clearly as you."
    NUMA @ talk "Bien sûr... Cela me fait plaisir de pouvoir parler à quelqu'un d'aussi clair que vous."

# game/data/characters/numa/dialogue.rpy:96
translate fr numa_whatareyou_711b6f6a:

    # "Numa's eyelids blinked twice as she tilted her head once more."
    "Les paupières de Numa clignèrent deux fois tandis qu'elle inclinait la tête une fois de plus."

# game/data/characters/numa/dialogue.rpy:97
translate fr numa_whatareyou_38893e4f:

    # NUMA @ talk "How can one speak the wave so well and not know what we are?"
    NUMA @ talk "Comment peut-on si bien parler la vague et ne pas savoir ce que nous sommes ?"

# game/data/characters/numa/dialogue.rpy:98
translate fr numa_whatareyou_c79bb790:

    # MC @ think "It's... complicated."
    MC @ think "C'est... compliqué."

# game/data/characters/numa/dialogue.rpy:99
translate fr numa_whatareyou_7c8b810c:

    # NUMA @ talk "... I see."
    NUMA @ talk "... Je vois."

# game/data/characters/numa/dialogue.rpy:100
translate fr numa_whatareyou_53b96c9d:

    # NUMA @ talk "Then to answer your question, I am Thalay."
    NUMA @ talk "Alors, pour répondre à ta question, je suis Thalay."

# game/data/characters/numa/dialogue.rpy:101
translate fr numa_whatareyou_09fc90be:

    # NUMA @ smile "I presume I may be one of the first, or perhaps THE first, of my kind you've seen since arriving in Hamun."
    NUMA @ smile "Je présume que je suis peut-être l'un des premiers, ou peut-être LE premier, de mon espèce que tu aies vu depuis ton arrivée à Hamun."

# game/data/characters/numa/dialogue.rpy:102
translate fr numa_whatareyou_ec863f7f:

    # MC @ talk "Yes."
    MC @ talk "Oui."

# game/data/characters/numa/dialogue.rpy:103
translate fr numa_whatareyou_12452374:

    # NUMA @ talk "Mmm... It is not surprising."
    NUMA @ talk "Mmm... Ce n'est pas surprenant."

# game/data/characters/numa/dialogue.rpy:104
translate fr numa_whatareyou_3fe64a20:

    # NUMA @ talk "Our people conduct only limited business with land breathers."
    NUMA @ talk "Notre peuple ne fait que des affaires limitées avec les respirants terrestres."

# game/data/characters/numa/dialogue.rpy:110
translate fr numa_talk_d20b5586:

    # NUMA @ smile "Greetings again, how may I help?"
    NUMA @ smile "Salutations à nouveau, comment puis-je vous aider ?"

# game/data/characters/numa/dialogue.rpy:115
translate fr numa_bye_aaff2ad9:

    # NUMA @ smile "Come back anytime... It pleases me to have someone I can actually speak the wave with."
    NUMA @ smile "Revenez quand vous voulez... Cela me fait plaisir d'avoir quelqu'un avec qui je peux vraiment parler la vague."

# game/data/characters/numa/dialogue.rpy:119
translate fr numa_books_trade_e8d2f9b6:

    # NUMA @ talk "Okay."
    NUMA @ talk "D'accord."

# game/data/characters/numa/dialogue.rpy:120
translate fr numa_books_trade_b1ba029d:

    # NUMA @ talk "Let's take a look then..."
    NUMA @ talk "Jetons un coup d'œil alors..."

# game/data/characters/numa/dialogue.rpy:122
translate fr numa_books_trade_c787f2b4:

    # NUMA @ talk "Is there anything else?"
    NUMA @ talk "Y a-t-il autre chose ?"

# game/data/characters/numa/dialogue.rpy:127
translate fr numa_firstmeet_2a75a3f6:

    # "Entering into the Hamun library was... an unusual sight."
    "Entrer dans la bibliothèque Hamun était... un spectacle inhabituel."

# game/data/characters/numa/dialogue.rpy:128
translate fr numa_firstmeet_8bc35701:

    # "While the usual rows of books were neatly stacked up high as one would expect, a deep, decorated pool lay in the center of the library,"
    "Alors que les rangées habituelles de livres étaient soigneusement empilées en hauteur comme on pouvait s'y attendre, un bassin profond et décoré se trouvait au centre de la bibliothèque,"

# game/data/characters/numa/dialogue.rpy:129
translate fr numa_firstmeet_7c9fd79f:

    # "Complete with a strange water fountain statue of what appeared to be a mage striking up a bargain with a strange fish like humanoid."
    "Complété par une étrange statue de fontaine représentant ce qui semblait être un mage concluant un marché avec un étrange humanoïde ressemblant à un poisson."

# game/data/characters/numa/dialogue.rpy:130
translate fr numa_firstmeet_6d119730:

    # "Looking around, I could see no one in the library."
    "En regardant autour de moi, je ne voyais personne dans la bibliothèque."

# game/data/characters/numa/dialogue.rpy:131
translate fr numa_firstmeet_27bb84f3:

    # MC @ think "Hello? Is anyone here?"
    MC @ think "Bonjour ? Y a-t-il quelqu'un ici ?"

# game/data/characters/numa/dialogue.rpy:132
translate fr numa_firstmeet_730a3730:

    # "A shadow appeared along waters of the pool, and in a moment, the blue skinned humanoid like woman emerged."
    "Une ombre apparut le long des eaux du bassin, et en un instant, la femme humanoïde à la peau bleue émergea."

# game/data/characters/numa/dialogue.rpy:135
translate fr numa_firstmeet_db1efe9f:

    # "Naked, and covered in scales as the water dripped from her body, the gilged creature turned it's gaze towards me."
    "Nue, et couverte d'écailles alors que l'eau dégoulinait de son corps, la créature aux branchies tourna son regard vers moi."

# game/data/characters/numa/dialogue.rpy:136
translate fr numa_firstmeet_fe773dc3:

    # UNKNOWN "Lora'shen... Vaalra korril'neth, sollan?"
    UNKNOWN "Lora'shen... Vaalra korril'neth, sollan?"

# game/data/characters/numa/dialogue.rpy:137
translate fr numa_firstmeet_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Quoi ?"

# game/data/characters/numa/dialogue.rpy:138
translate fr numa_firstmeet_574271cf:

    # "The strange creature tilted it's head, before motioning towards the many books with it's hand."
    "L'étrange créature inclina la tête, puis fit un geste de la main vers les nombreux livres."

# game/data/characters/numa/dialogue.rpy:139
translate fr numa_firstmeet_ca45be32:

    # UNKNOWN "Ssharaa… Vellunaa shor'kai, raal ithen vashan…"
    UNKNOWN "Ssharaa… Vellunaa shor'kai, raal ithen vashan…"

