# game/data/characters/thea/dialogue.rpy:28
translate fr nov_thea_talk_5f6496d4:

    # THEA @ smile "Oh hey! Can I help you with something?"
    THEA @ smile "Oh salut ! Je peux vous aider pour quelque chose ?"

# game/data/characters/thea/dialogue.rpy:33
translate fr nov_thea_bye_9e54ad83:

    # THEA @ talk "Alright, see ya around!"
    THEA @ talk "D'accord, à plus tard !"

# game/data/characters/thea/dialogue.rpy:34
translate fr nov_thea_bye_d20135b7:

    # THEA @ smile "Good luck on your adventures!"
    THEA @ smile "Bonne chance pour vos aventures !"

# game/data/characters/thea/dialogue.rpy:38
translate fr nov_thea_adv_questions_1a2ee70f:

    # THEA @ talk "Ask away."
    THEA @ talk "N'hésitez pas à demander."

# game/data/characters/thea/dialogue.rpy:41
translate fr nov_thea_adv_questions_menu_bbc22857:

    # THEA @ talk "Over on the board over there is our list of current jobs needing to be done."
    THEA @ talk "Sur le panneau là-bas se trouve notre liste des missions en cours à accomplir."

# game/data/characters/thea/dialogue.rpy:42
translate fr nov_thea_adv_questions_menu_0ab4d2cb:

    # THEA @ talk "Just select the one you want, and we'll handle the paperwork while you get to work."
    THEA @ talk "Choisissez simplement celle que vous voulez, et nous nous occuperons des formalités pendant que vous vous mettrez au travail."

# game/data/characters/thea/dialogue.rpy:43
translate fr nov_thea_adv_questions_menu_e0200cc9:

    # THEA @ talk "Remember though, you can only choose a quest within your rank as an adventurer."
    THEA @ talk "Rappelez-vous cependant, vous ne pouvez choisir qu'une quête correspondant à votre rang d'aventurier."

# game/data/characters/thea/dialogue.rpy:46
translate fr nov_thea_adv_questions_menu_d0988ac6:

    # THEA @ talk "It's important to understand how the ranking works."
    THEA @ talk "Il est important de comprendre comment fonctionne le classement."

# game/data/characters/thea/dialogue.rpy:47
translate fr nov_thea_adv_questions_menu_a160af5e:

    # THEA @ talk "All beginner adventurers are ranked as D-listers."
    THEA @ talk "Tous les aventuriers débutants sont de rang D."

# game/data/characters/thea/dialogue.rpy:48
translate fr nov_thea_adv_questions_menu_691c77f1:

    # THEA @ talk "These are the most straightforward and simple quests available to any adventurer."
    THEA @ talk "Ce sont les quêtes les plus simples et directes disponibles pour tout aventurier."

# game/data/characters/thea/dialogue.rpy:49
translate fr nov_thea_adv_questions_menu_359a935e:

    # THEA @ talk "Ranking progresses from D-tier all the way to S-Tier, the rank of legendary adventurers."
    THEA @ talk "La progression des rangs va du niveau D jusqu'au rang S, le rang des aventuriers légendaires."

# game/data/characters/thea/dialogue.rpy:50
translate fr nov_thea_adv_questions_menu_71f3b316:

    # THEA @ talk "Of course, as the danger and difficulty of the quests increase each rank, so does the rewards to compensate."
    THEA @ talk "Bien sûr, à mesure que la dangerosité et la difficulté des quêtes augmentent avec chaque rang, les récompenses augmentent également pour compenser."

# game/data/characters/thea/dialogue.rpy:53
translate fr nov_thea_adv_questions_menu_9ae80558:

    # THEA @ talk "There's a set number of quests per rank that will need to be completed a minimum of at least once."
    THEA @ talk "Il y a un nombre défini de quêtes par rang qui devront être accomplies au moins une fois."

# game/data/characters/thea/dialogue.rpy:54
translate fr nov_thea_adv_questions_menu_42fcd1da:

    # THEA @ talk "After you've beaten your ranks guild quests, a special one-time quest will open up that once you've completed, your rank will increase."
    THEA @ talk "Après avoir terminé les quêtes de guilde de ton rang, une quête spéciale et unique s'ouvrira, et une fois celle-ci accomplie, ton rang augmentera."

# game/data/characters/thea/dialogue.rpy:55
translate fr nov_thea_adv_questions_menu_0b3f27c1:

    # THEA @ talk "Oh ... And don't worry about running out of quests."
    THEA @ talk "Oh ... Et ne t'inquiète pas de manquer de quêtes."

# game/data/characters/thea/dialogue.rpy:56
translate fr nov_thea_adv_questions_menu_003922e8:

    # THEA @ talk "Outside of the special guild quests, most guild quests are usually full time occupations in themselves, you'll be able to re-do those quests as many times as you like."
    THEA @ talk "En dehors des quêtes de guilde spéciales, la plupart des quêtes de guilde sont généralement des occupations à plein temps en elles-mêmes. Tu pourras refaire ces quêtes autant de fois que tu le souhaites."

# game/data/characters/thea/dialogue.rpy:59
translate fr nov_thea_adv_questions_menu_fa5b1639:

    # THEA @ talk "Sure, was there anything else?"
    THEA @ talk "Bien sûr, y avait-il autre chose ?"

# game/data/characters/thea/dialogue.rpy:63
translate fr nov_thea_adv_questions_notAdventurer_dff28a07:

    # THEA @ talk "Sorry, but I don't remember you being an adventurer."
    THEA @ talk "Désolé, mais je ne me souviens pas que tu sois un aventurier."

# game/data/characters/thea/dialogue.rpy:64
translate fr nov_thea_adv_questions_notAdventurer_4a075af6:

    # MC "What do you mean?"
    MC "Que veux-tu dire ?"

# game/data/characters/thea/dialogue.rpy:65
translate fr nov_thea_adv_questions_notAdventurer_bd5ff809:

    # THEA @ talk "Well, you can get yourself a drink or something, but I can't waste my time explaining the inner workings of the guild to you."
    THEA @ talk "Eh bien, tu peux aller te chercher un verre ou quelque chose, mais je ne peux pas perdre mon temps à t'expliquer le fonctionnement interne de la guilde."

# game/data/characters/thea/dialogue.rpy:66
translate fr nov_thea_adv_questions_notAdventurer_e1770810:

    # MC "Can I become an adventurer?"
    MC "Puis-je devenir un aventurier ?"

# game/data/characters/thea/dialogue.rpy:67
translate fr nov_thea_adv_questions_notAdventurer_416abe62:

    # "Thea let out a quiet sigh..."
    "Thea laissa échapper un léger soupir..."

# game/data/characters/thea/dialogue.rpy:68
translate fr nov_thea_adv_questions_notAdventurer_e5da05a6:

    # THEA @ talk "That's a three-hundred fifty-something time I've been asked this."
    THEA @ talk "C'est la trois cent cinquantième fois, ou à peu près, qu'on me pose cette question."

# game/data/characters/thea/dialogue.rpy:69
translate fr nov_thea_adv_questions_notAdventurer_811a066b:

    # THEA @ talk "Have you reached your Terminus yet?"
    THEA @ talk "As-tu déjà atteint ton Terminus ?"

# game/data/characters/thea/dialogue.rpy:70
translate fr nov_thea_adv_questions_notAdventurer_5d73558e:

    # "I swallowed hard."
    "Je déglutis avec difficulté."

# game/data/characters/thea/dialogue.rpy:71
translate fr nov_thea_adv_questions_notAdventurer_7b56f981:

    # MC "Y-yeah."
    MC "O-oui."

# game/data/characters/thea/dialogue.rpy:72
translate fr nov_thea_adv_questions_notAdventurer_2da5a787:

    # THEA @ talk "You did? Well, that is how you become an adventurer, you're {i}assigned{/i} this role at your Terminus."
    THEA @ talk "Ah oui ? Eh bien, c'est comme ça qu'on devient aventurier, ce rôle t'est {i}assigné{/i} à ton Terminus."

# game/data/characters/thea/dialogue.rpy:73
translate fr nov_thea_adv_questions_notAdventurer_fe9f792d:

    # THEA @ talk "What role did the kingdom bestow upon you?"
    THEA @ talk "Quel rôle le royaume t'a-t-il conféré ?"

# game/data/characters/thea/dialogue.rpy:74
translate fr nov_thea_adv_questions_notAdventurer_522de8a4:

    # MC "(Cannon fodder.)"
    MC "(Chair à canon.)"

# game/data/characters/thea/dialogue.rpy:75
translate fr nov_thea_adv_questions_notAdventurer_e8f39a65:

    # MC "I... I should go."
    MC "Je... je devrais y aller."

# game/data/characters/thea/dialogue.rpy:76
translate fr nov_thea_adv_questions_notAdventurer_4349caf7:

    # "Thea raised an eyebrow."
    "Thea leva un sourcil."

# game/data/characters/thea/dialogue.rpy:77
translate fr nov_thea_adv_questions_notAdventurer_d34359c3:

    # THEA @ talk "Okay, safe travels then!"
    THEA @ talk "D'accord, bon voyage alors !"

# game/data/characters/thea/dialogue.rpy:79
translate fr nov_thea_adv_questions_notAdventurer_bfd46478:

    # MC "I should get to the fort now."
    MC "Je devrais me rendre au fort maintenant."

# game/data/characters/thea/dialogue.rpy:84
translate fr nov_thea_drink_4968c955:

    # THEA @ talk "Improve your standing at the guild and maybe we'll talk."
    THEA @ talk "Améliore ta réputation à la guilde et peut-être qu'on en parlera."

# game/data/characters/thea/dialogue.rpy:88
translate fr nov_thea_drink_8bb85580:

    # THEA @ smile "I hope you don't think you're the first one to try that."
    THEA @ smile "J'espère que tu ne penses pas être le premier à essayer ça."

# game/data/characters/thea/dialogue.rpy:89
translate fr nov_thea_drink_cef616c3:

    # MC @ smile "I was hoping I'd be the first one you'd say yes to."
    MC @ smile "J'espérais être le premier à qui tu dirais oui."

# game/data/characters/thea/dialogue.rpy:90
translate fr nov_thea_drink_af5adb3e:

    # THEA @ talk "Hmm, well, I'll think about it ..."
    THEA @ talk "Hmm, eh bien, j'y réfléchirai..."

# game/data/characters/thea/dialogue.rpy:91
translate fr nov_thea_drink_4d231e9b:

    # THEA @ talk "I'm sure you're used to girls just falling into your lap, but it takes a little more than that to get me interested."
    THEA @ talk "Je suis sûre que tu as l'habitude que les filles te tombent dans les bras, mais il en faut un peu plus que ça pour m'intéresser."

# game/data/characters/thea/dialogue.rpy:92
translate fr nov_thea_drink_e9545907:

    # MC @ smile "Oh?"
    MC @ smile "Oh ?"

# game/data/characters/thea/dialogue.rpy:93
translate fr nov_thea_drink_08d238b8:

    # THEA @ smile "{i}I wanna see what you can do.{/i}"
    THEA @ smile "{i}Je veux voir ce que tu sais faire.{/i}"

# game/data/characters/thea/dialogue.rpy:94
translate fr nov_thea_drink_fb6bc2c6:

    # MC @ think "What I can do?"
    MC @ think "Qu'est-ce que je peux faire ?"

# game/data/characters/thea/dialogue.rpy:95
translate fr nov_thea_drink_95135937:

    # THEA @ smile "Here, {i}at this guild.{/i}"
    THEA @ smile "Ici, {i}dans cette guilde.{/i}"

# game/data/characters/thea/dialogue.rpy:96
translate fr nov_thea_drink_306fe303:

    # THEA @ smile2 "There's something about this place that just-"
    THEA @ smile2 "Il y a quelque chose dans cet endroit qui est juste-"

# game/data/characters/thea/dialogue.rpy:97
translate fr nov_thea_drink_c7bdae38:

    # THEA @ smile "Mmm ... Better not think too hard on it, need to stay focused for work."
    THEA @ smile "Mmm ... Mieux vaut ne pas trop y penser, je dois rester concentré sur le travail."

# game/data/characters/thea/dialogue.rpy:98
translate fr nov_thea_drink_ef2975b7:

    # MC @ talk "So, you've got a thing for Adventurers then?"
    MC @ talk "Alors, tu as un faible pour les Aventuriers ?"

# game/data/characters/thea/dialogue.rpy:99
translate fr nov_thea_drink_79a5953f:

    # THEA @ smile2 "A-Ah...Maybe a little?"
    THEA @ smile2 "A-Ah... Peut-être un peu ?"

# game/data/characters/thea/dialogue.rpy:100
translate fr nov_thea_drink_c0c81c71:

    # THEA @ smile "But not just any adventurer walking in off the street, one whose metal has been seriously proven."
    THEA @ smile "Mais pas n'importe quel aventurier qui débarque de la rue, un dont la trempe a été sérieusement éprouvée."

# game/data/characters/thea/dialogue.rpy:101
translate fr nov_thea_drink_211b3ff7:

    # THEA @ blush "Think you've got what it takes?"
    THEA @ blush "Tu penses que tu as ce qu'il faut ?"

# game/data/characters/thea/dialogue.rpy:102
translate fr nov_thea_drink_8ba32743:

    # MC @ talk "I guess we'll see, won't we?"
    MC @ talk "Je suppose qu'on verra, non ?"

