# game/data/characters/vala/dialogue_script.rpy:4
translate fr nov_vala_scr_firstmeet_1c716be8:

    # "As I stepped into the Library, I was greeted by the sudden warmth as I stepped through the door, the fire going as musky books laid scattered around on various tables."
    "En entrant dans la bibliothèque, j'ai été accueilli par la chaleur soudaine en franchissant la porte, le feu allumé tandis que des livres à l'odeur de renfermé étaient éparpillés sur diverses tables."

# game/data/characters/vala/dialogue_script.rpy:5
translate fr nov_vala_scr_firstmeet_9b7620e7:

    # MC @ talk "Hello? Is anyone here?"
    MC @ talk "Bonjour ? Il y a quelqu'un ?"

# game/data/characters/vala/dialogue_script.rpy:6
translate fr nov_vala_scr_firstmeet_1e9e0401:

    # VALA "Just a minute!"
    VALA "Une minute !"

# game/data/characters/vala/dialogue_script.rpy:7
translate fr nov_vala_scr_firstmeet_b7a4fdc6:

    # "Peering around, I noticed a blonde girl high up on some ladder, putting away a few old books they she slides back into place."
    "En regardant autour, j'ai remarqué une fille blonde tout en haut d'une échelle, qui rangeait quelques vieux livres en les glissant à leur place."

# game/data/characters/vala/dialogue_script.rpy:9
translate fr nov_vala_scr_firstmeet_3ed51ef9:

    # "Reaching onto her tip toes, the girl out-stretched her arms as she tried to reach the bookshelf, and her skirt begin to hike up, revealing the soft panties she wore beneath."
    "Se haussant sur la pointe des pieds, la fille tendit les bras en essayant d'atteindre l'étagère, et sa jupe commença à remonter, dévoilant la culotte douce qu'elle portait en dessous."

# game/data/characters/vala/dialogue_script.rpy:11
translate fr nov_vala_scr_firstmeet_7a78c0c0:

    # VALA "Just... a little more!"
    VALA "Juste... un peu plus !"

# game/data/characters/vala/dialogue_script.rpy:13
translate fr nov_vala_scr_firstmeet_2ab10cd7:

    # MC @ talk "Are you okay up there? That ladder looks a little... {i}old.{/i}"
    MC @ talk "Tout va bien là-haut ? Cette échelle semble un peu... {i}vieille.{/i}"

# game/data/characters/vala/dialogue_script.rpy:14
translate fr nov_vala_scr_firstmeet_4cc79bf2:

    # VALA "I’ll be fine! We’re getting a new-"
    VALA "Je vais bien ! On reçoit une nouvelle-"

# game/data/characters/vala/dialogue_script.rpy:15
translate fr nov_vala_scr_firstmeet_d2a7a758:

    # "Suddenly, the weak ladder snapped beneath her foot as the girl began falling down!"
    "Soudain, l'échelle fragile céda sous son pied et la fille commença à tomber !"

# game/data/characters/vala/dialogue_script.rpy:20
translate fr nov_vala_scr_firstmeet_e7b98bff:

    # VALA "AHHHHH!"
    VALA "AHHHHH !"

# game/data/characters/vala/dialogue_script.rpy:21
translate fr nov_vala_scr_firstmeet_061f8483:

    # "Running forward, I managed to catch the girl just in time with my agile reflexes, gently letting her down safely."
    "Courant en avant, j'ai réussi à attraper la fille juste à temps avec mes réflexes agiles, la déposant doucement en sécurité."

# game/data/characters/vala/dialogue_script.rpy:24
translate fr nov_vala_scr_firstmeet_93bbef6a:

    # VALA "Phew...! Thank you for that!"
    VALA "Ouf...! Merci pour ça !"

# game/data/characters/vala/dialogue_script.rpy:25
translate fr nov_vala_scr_firstmeet_9eb70956:

    # "Stood before me, I now finally had a good chance to look at the girl properly, she was short, with long blonde hair and spectacle glasses."
    "Debout devant moi, j'avais enfin une bonne occasion de la regarder correctement, elle était petite, avec de longs cheveux blonds et des lunettes."

# game/data/characters/vala/dialogue_script.rpy:27
translate fr nov_vala_scr_firstmeet_214f3a9e:

    # "Smiling cutely at me, I looked down to see the curves of her body and felt the tinge of the Parasite getting excited once again."
    "Alors qu'elle me souriait adorablement, j'ai baissé les yeux pour voir les courbes de son corps et j'ai senti le Parasite s'exciter à nouveau."

# game/data/characters/vala/dialogue_script.rpy:28
translate fr nov_vala_scr_firstmeet_0a1deb0a:

    # MC @ talk "No problem."
    MC @ talk "Pas de problème."

# game/data/characters/vala/dialogue_script.rpy:29
translate fr nov_vala_scr_firstmeet_9dcd4662:

    # "The girl outstretched her hand for it to be shaken."
    "La fille tendit la main pour que je la serre."

# game/data/characters/vala/dialogue_script.rpy:30
translate fr nov_vala_scr_firstmeet_16215314:

    # VALA "Vala Bluestone at your service!"
    VALA "Vala Bluestone pour vous servir !"

# game/data/characters/vala/dialogue_script.rpy:32
translate fr nov_vala_scr_firstmeet_90781931:

    # "I reached out my hand to shake hers."
    "J'ai tendu la main pour serrer la sienne."

# game/data/characters/vala/dialogue_script.rpy:33
translate fr nov_vala_scr_firstmeet_6fa3a6ae:

    # MC @ talk "A pleasure to meet you Vala Bluestone, I am [player_name!t]."
    MC @ talk "Ravi de vous rencontrer Vala Bluestone, je suis [player_name!t]."

# game/data/characters/vala/dialogue_script.rpy:34
translate fr nov_vala_scr_firstmeet_ce593ffd:

    # VALA "So, what brings you here?"
    VALA "Alors, qu'est-ce qui vous amène ici ?"

# game/data/characters/vala/dialogue_script.rpy:35
translate fr nov_vala_scr_firstmeet_0ad6f9ca:

    # MC @ talk "I was perhaps hoping to read a book or two..."
    MC @ talk "J'espérais peut-être lire un livre ou deux..."

# game/data/characters/vala/dialogue_script.rpy:36
translate fr nov_vala_scr_firstmeet_c606f5f8:

    # VALA "Ah, well the library is free for all, and always open."
    VALA "Ah, eh bien la bibliothèque est gratuite pour tous, et toujours ouverte."

# game/data/characters/vala/dialogue_script.rpy:37
translate fr nov_vala_scr_firstmeet_f0e406e2:

    # VALA "Just remember, while we can put books in the hold for you to keep reading once you come back, we can’t allow you to take any of the books with you."
    VALA "N'oubliez pas, même si nous pouvons mettre des livres en réserve pour que vous continuiez à les lire à votre retour, nous ne pouvons pas vous permettre d'emporter des livres avec vous."

# game/data/characters/vala/dialogue_script.rpy:38
translate fr nov_vala_scr_firstmeet_7c81cc89:

    # "After so many students complained and asked for the library to be opened due to the ever-growing stress around studies, the education board agreed to give it extra funding to do so."
    "Après que de nombreux étudiants se sont plaints et ont demandé l'ouverture de la bibliothèque en raison du stress toujours croissant lié aux études, le conseil d'éducation a accepté d'accorder des fonds supplémentaires pour cela."

# game/data/characters/vala/dialogue_script.rpy:39
translate fr nov_vala_scr_firstmeet_c486209e:

    # "Me and Markus, albeit reluctantly, were forced to spend a fair few of our evenings here."
    "Markus et moi, bien qu'à contrecœur, avons été obligés de passer un bon nombre de nos soirées ici."

# game/data/characters/vala/dialogue_script.rpy:40
translate fr nov_vala_scr_firstmeet_ef9ee76e:

    # "How long ago that all seems now..."
    "Combien tout cela semble lointain maintenant..."

# game/data/characters/vala/dialogue_script.rpy:41
translate fr nov_vala_scr_firstmeet_0d47b440:

    # VALA "Is something the matter?"
    VALA "Quelque chose ne va pas ?"

# game/data/characters/vala/dialogue_script.rpy:42
translate fr nov_vala_scr_firstmeet_bf61c54a:

    # MC @ talk "Hmm?"
    MC @ talk "Hmm ?"

# game/data/characters/vala/dialogue_script.rpy:43
translate fr nov_vala_scr_firstmeet_c9952985:

    # VALA "You seemed... {i}lost in thought{/i} for a second there."
    VALA "Tu semblais... {i}perdu dans tes pensées{/i} pendant un instant."

# game/data/characters/vala/dialogue_script.rpy:44
translate fr nov_vala_scr_firstmeet_d5717343:

    # MC @ talk "Oh, never mind."
    MC @ talk "Oh, laisse tomber."

# game/data/characters/vala/dialogue_script.rpy:45
translate fr nov_vala_scr_firstmeet_67a9c63c:

    # MC @ talk "Just remembering some things, nothing important."
    MC @ talk "Je me souviens juste de quelques choses, rien d'important."

# game/data/characters/vala/dialogue_script.rpy:46
translate fr nov_vala_scr_firstmeet_bf0e67a2:

    # VALA "Well, if you need anything, I’ll be around! Okay?"
    VALA "Eh bien, si tu as besoin de quoi que ce soit, je serai dans les parages ! D'accord ?"

# game/data/characters/vala/dialogue_script.rpy:47
translate fr nov_vala_scr_firstmeet_830159c6:

    # MC @ talk "Sounds good."
    MC @ talk "Ça me va."

# game/data/characters/vala/dialogue_script.rpy:48
translate fr nov_vala_scr_firstmeet_618cb924:

    # "As Vala smiled and waved shyly, I watched her cute butt as she sauntered off to go grab more books."
    "Alors que Vala souriait et faisait timidement un signe de la main, j'ai regardé son joli derrière alors qu'elle s'éloignait en se dandinant pour aller chercher d'autres livres."

# game/data/characters/vala/dialogue_script.rpy:51
translate fr nov_vala_scr_firstmeet_db0c26de:

    # BLACK "Her heartbeat raised when she saw you, and her hands began to sweat."
    BLACK "Son rythme cardiaque a augmenté quand elle t'a vu, et ses mains ont commencé à transpirer."

# game/data/characters/vala/dialogue_script.rpy:52
translate fr nov_vala_scr_firstmeet_a97dcc2e:

    # BLACK "With some commitment, she would be a willing and good mate."
    BLACK "Avec un peu d'engagement, elle serait une compagne consentante et bonne."

# game/data/characters/vala/dialogue_script.rpy:53
translate fr nov_vala_scr_firstmeet_7be498ca:

    # MC "Stop... I... "
    MC "Arrête... Je..."

# game/data/characters/vala/dialogue_script.rpy:54
translate fr nov_vala_scr_firstmeet_81498102:

    # "I shook my head to try push aside the dark thoughts."
    "J'ai secoué la tête pour essayer d'écarter les pensées sombres."

# game/data/characters/vala/dialogue_script.rpy:55
translate fr nov_vala_scr_firstmeet_bd8e6530:

    # MC @ angry "We’re here to try and gather some information, not hunting for another ‘mate’"
    MC @ angry "Nous sommes ici pour essayer de recueillir des informations, pas pour chasser une autre 'compagne'."

# game/data/characters/vala/dialogue_script.rpy:56
translate fr nov_vala_scr_firstmeet_296d9d43:

    # BLACK "As you wish."
    BLACK "Comme tu voudras."

# game/data/characters/vala/dialogue_script.rpy:57
translate fr nov_vala_scr_firstmeet_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Soupir*{/i}"

# game/data/characters/vala/dialogue_script.rpy:58
translate fr nov_vala_scr_firstmeet_7c3d9a85:

    # "Now, where to start? This place is huge..."
    "Maintenant, par où commencer ? Cet endroit est immense..."

