# game/data/characters/ves/dialogue.rpy:90
translate fr ves_dial_beenout_c1cc84bf:

    # VES @ talk "Not yet, but I will be soon."
    VES @ talk "Pas encore, mais je le serai bientôt."

# game/data/characters/ves/dialogue.rpy:91
translate fr ves_dial_beenout_f48a09c0:

    # VES @ talk "Can’t risk supplies getting too low."
    VES @ talk "Je ne peux pas risquer que les provisions s'épuisent."

# game/data/characters/ves/dialogue.rpy:95
translate fr ves_dial_seenanything_b917f69f:

    # VES @ talk "Just your usual small parties of Demorai moving through the sands."
    VES @ talk "Juste les petits groupes habituels de Demorai qui se déplacent dans les sables."

# game/data/characters/ves/dialogue.rpy:96
translate fr ves_dial_seenanything_565c2af8:

    # VES @ talk "Oh, and some Skorn... Not much else."
    VES @ talk "Oh, et quelques Skorn... Pas grand-chose d'autre."

# game/data/characters/ves/dialogue.rpy:97
