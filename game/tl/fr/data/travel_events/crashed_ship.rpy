translate fr travel_event_crashed_ship_c7f49737:

    # BLACK "{i}...Going wrong way.{/i}"
    BLACK "{i}...Mauvaise direction.{/i}"

# game/data/travel_events/crashed_ship.rpy:15
translate fr travel_event_crashed_ship_73790772:

    # MC @ angry "We are not going the wrong way!"
    MC @ angry "Nous n'allons pas dans la mauvaise direction !"

# game/data/travel_events/crashed_ship.rpy:16
translate fr travel_event_crashed_ship_1cd0e33a:

    # BLACK "{i}We are lost.{/i}"
    BLACK "{i}Nous sommes perdus.{/i}"

# game/data/travel_events/crashed_ship.rpy:17
translate fr travel_event_crashed_ship_71d2cf05:

    # MC @ angry "We are not lost!"
    MC @ angry "Nous ne sommes pas perdus !"

# game/data/travel_events/crashed_ship.rpy:19
translate fr travel_event_crashed_ship_66dfd255:

    # MC @ talk "We just—"
    MC @ talk "Nous sommes juste—"

# game/data/travel_events/crashed_ship.rpy:21
translate fr travel_event_crashed_ship_90844184:

    # MC @ talk "We just need to find our—"
    MC @ talk "Nous devons juste trouver notre—"

# game/data/travel_events/crashed_ship.rpy:23
translate fr travel_event_crashed_ship_88b2ee55:

    # "Suddenly, I felt the earth crumble beneath me."
    "Soudain, j'ai senti la terre s'effriter sous moi."

# game/data/travel_events/crashed_ship.rpy:26
translate fr travel_event_crashed_ship_934fef82:

    # "I gasped as I plummeted into a great chasm below."
    "J'ai haleté en chutant dans un grand gouffre en contrebas."

# game/data/travel_events/crashed_ship.rpy:28
translate fr travel_event_crashed_ship_a4b26b88:

    # "The fall lasted only moments, wind whipping past as panic surged through me."
    "La chute n'a duré que quelques instants, le vent fouettant l'air tandis que la panique me submergeait."

# game/data/travel_events/crashed_ship.rpy:29
translate fr travel_event_crashed_ship_b71673c2:

    # "One of my blackened tentacles shot out, anchoring into the wall and halting my descent."
    "Un de mes tentacules noircis s'est projeté, s'ancrant dans le mur et arrêtant ma chute."

# game/data/travel_events/crashed_ship.rpy:30
translate fr travel_event_crashed_ship_e352090c:

    # MARKUS @ shock "[player_name!t]!"
    MARKUS @ shock "[player_name!t]!"

# game/data/travel_events/crashed_ship.rpy:32
translate fr travel_event_crashed_ship_81a47010:

    # "Lowering myself carefully, I landed on a patch of dirt below, lit faintly by the chasm's natural opening."
    "En me baissant prudemment, j'atterris sur une parcelle de terre en contrebas, faiblement éclairée par l'ouverture naturelle du gouffre."

# game/data/travel_events/crashed_ship.rpy:33
translate fr travel_event_crashed_ship_dda0aa4b:

    # MARKUS "Can you hear me?!"
    MARKUS "Est-ce que tu m'entends ?!"

# game/data/travel_events/crashed_ship.rpy:34
translate fr travel_event_crashed_ship_354115c9:

    # MC @ talk "I'm alright."
    MC @ talk "Je vais bien."

# game/data/travel_events/crashed_ship.rpy:35
translate fr travel_event_crashed_ship_6baba279:

    # "As my eyes adjusted, the full scale of the pit became clear."
    "Alors que mes yeux s'habituaient, l'échelle réelle de la fosse devint claire."

# game/data/travel_events/crashed_ship.rpy:41
translate fr travel_event_crashed_ship_141d7189:

    # MC @ think "Is this... some kind of cave?"
    MC @ think "Est-ce que c'est... une sorte de grotte ?"

# game/data/travel_events/crashed_ship.rpy:43
translate fr travel_event_crashed_ship_f02ac22b:

    # "There, partially submerged in shallow water, was something metallic—a ship?"
    "Là, partiellement submergé dans de l'eau peu profonde, se trouvait quelque chose de métallique — un navire ?"

# game/data/travel_events/crashed_ship.rpy:44
translate fr travel_event_crashed_ship_e26d324c:

    # "Ruined and entangled in vines, the strange relic beckoned."
    "Dévasté et enchevêtré dans des vignes, l'étrange relique faisait signe."

# game/data/travel_events/crashed_ship.rpy:45
translate fr travel_event_crashed_ship_b3c9f1a5:

    # MARKUS "What do you see down there?!"
    MARKUS "Qu'est-ce que tu vois là-bas ?!"

# game/data/travel_events/crashed_ship.rpy:46
translate fr travel_event_crashed_ship_8ec5fa0b:

    # MC @ serious "You might want to come down here."
    MC @ serious "Tu devrais peut-être descendre ici."

# game/data/travel_events/crashed_ship.rpy:48
translate fr travel_event_crashed_ship_4001a4a4:

    # "The others climbed down with caution."
    "Les autres descendirent avec prudence."

# game/data/travel_events/crashed_ship.rpy:50
translate fr travel_event_crashed_ship_f5a0c50b:

    # MARKUS @ shock "What in seven hells is that thing?"
    MARKUS @ shock "Qu'est-ce que c'est que cette chose, par les sept enfers ?"

# game/data/travel_events/crashed_ship.rpy:51
translate fr travel_event_crashed_ship_11bcc543:

    # MC @ think "Some kind of ship?"
    MC @ think "Une sorte de navire ?"

# game/data/travel_events/crashed_ship.rpy:52
translate fr travel_event_crashed_ship_539ee9fb:

    # MARKUS @ talk "Where are its sails?"
    MARKUS @ talk "Où sont ses voiles ?"

# game/data/travel_events/crashed_ship.rpy:53
translate fr travel_event_crashed_ship_3dad54df:

    # MC @ think "Never seen a vessel like this... and this far from any sea?"
    MC @ think "Jamais vu un vaisseau comme ça... et si loin de toute mer ?"

# game/data/travel_events/crashed_ship.rpy:57
translate fr travel_event_crashed_ship_0208f36a:

    # MYU @ scared "M-Myu? Metal thing scary..."
    MYU @ scared "M-Myu ? Chose en métal effrayante..."

# game/data/travel_events/crashed_ship.rpy:62
translate fr travel_event_crashed_ship_8138fa88:

    # VES @ think "I've heard rumors of the Greater Trading Company reinforcing ships with armor, but this..."
    VES @ think "J'ai entendu des rumeurs selon lesquelles la Grande Compagnie de Commerce renforcerait les navires avec une armure, mais ça..."

# game/data/travel_events/crashed_ship.rpy:63
translate fr travel_event_crashed_ship_e9cd7d09:

    # VES @ talk "This is nothing like anything I've ever seen."
    VES @ talk "Ça ne ressemble à rien de ce que j'ai jamais vu."

# game/data/travel_events/crashed_ship.rpy:68
translate fr travel_event_crashed_ship_ba8e8344:

    # ELENA @ grumpy "Perhaps... a relic of the old gods?"
    ELENA @ grumpy "Peut-être... une relique des anciens dieux ?"

# game/data/travel_events/crashed_ship.rpy:69
translate fr travel_event_crashed_ship_c90ffbe7:

    # ELENA @ grumpy "Judging by how deep this cavern is, it must've been buried here for thousands of years."
    ELENA @ grumpy "À en juger par la profondeur de cette caverne, il doit y être enterré depuis des milliers d'années."

# game/data/travel_events/crashed_ship.rpy:75
translate fr travel_event_crashed_ship_985866dd:

    # SYPHA @ talk "{i}And so, in ages past, they rode mechanical beasts across the stars.{/i}"
    SYPHA @ talk "{i}Ainsi, dans les temps anciens, ils chevauchaient des bêtes mécaniques à travers les étoiles.{/i}"

# game/data/travel_events/crashed_ship.rpy:76
translate fr travel_event_crashed_ship_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Quoi ?"

# game/data/travel_events/crashed_ship.rpy:77
translate fr travel_event_crashed_ship_c24c1193:

    # SYPHA @ think "Nothing. Just old legends from childhood."
    SYPHA @ think "Rien. Juste de vieilles légendes d'enfance."

# game/data/travel_events/crashed_ship.rpy:84
translate fr travel_event_crashed_ship_16bf6a3c:

    # MC @ serious "Whatever it is, I don't like it."
    MC @ serious "Quoi que ce soit, je n'aime pas ça."

# game/data/travel_events/crashed_ship.rpy:85
translate fr travel_event_crashed_ship_cfd774db:

    # MC @ talk "Let's leave sleeping ghosts to rest."
    MC @ talk "Laissons les fantômes endormis reposer."

# game/data/travel_events/crashed_ship.rpy:86
translate fr travel_event_crashed_ship_516553f1:

    # MARKUS @ talk "Agreed. Nothing good comes from disturbing the dead."
    MARKUS @ talk "D'accord. Rien de bon ne vient de déranger les morts."

# game/data/travel_events/crashed_ship.rpy:88
translate fr travel_event_crashed_ship_013b3791:

    # "We climbed back out of the rift and resumed our journey."
    "Nous sommes ressortis de la faille et avons repris notre voyage."

# game/data/travel_events/crashed_ship.rpy:95
translate fr travel_event_crashed_ship_inside_4a677239:

    # "Carefully, I approached the wreck."
    "Avec précaution, je me suis approché de l'épave."

# game/data/travel_events/crashed_ship.rpy:96
translate fr travel_event_crashed_ship_inside_c1071274:

    # "I stepped into the freezing water and laid my hand on the cold metal hull."
    "Je suis entré dans l'eau glacée et ai posé ma main sur la coque métallique froide."

# game/data/travel_events/crashed_ship.rpy:99
translate fr travel_event_crashed_ship_inside_08beff35:

    # MARKUS @ shock "[player_name!t]! What are you doing?"
    MARKUS @ shock "[player_name!t]! Qu'est-ce que tu fais ?"

# game/data/travel_events/crashed_ship.rpy:101
translate fr travel_event_crashed_ship_inside_9ec1a37a:

    # "A hiss of steam sounded as the metal twisted open like a door."
    "Un sifflement de vapeur retentit tandis que le métal se tordait pour s'ouvrir comme une porte."

# game/data/travel_events/crashed_ship.rpy:102
translate fr travel_event_crashed_ship_inside_79a0bb39:

    # MARKUS @ shock "You're not actually going inside that thing, are you?"
    MARKUS @ shock "Tu ne vas pas vraiment entrer dans ce truc, n'est-ce pas ?"

# game/data/travel_events/crashed_ship.rpy:103
translate fr travel_event_crashed_ship_inside_026bc247:

    # "I stepped in."
    "Je suis entré."

# game/data/travel_events/crashed_ship.rpy:104
translate fr travel_event_crashed_ship_inside_970d0f74:

    # MARKUS @ angry "Gods be damned, man."
    MARKUS @ angry "Par les dieux, mec !"

# game/data/travel_events/crashed_ship.rpy:109
translate fr travel_event_crashed_ship_inside_bc2341db:

    # "Inside, it was cold."
    "À l'intérieur, il faisait froid."

# game/data/travel_events/crashed_ship.rpy:112
translate fr travel_event_crashed_ship_inside_4f0eba80:

    # "Our footsteps echoed across the metal floor."
    "Nos pas résonnaient sur le sol métallique."

# game/data/travel_events/crashed_ship.rpy:113
translate fr travel_event_crashed_ship_inside_b2b6c7a4:

    # "Pipes snaked along the walls, choked in vines and pierced by jagged rock."
    "Des tuyaux serpentaient le long des murs, étouffés de lianes et percés par des rochers déchiquetés."

# game/data/travel_events/crashed_ship.rpy:118
translate fr travel_event_crashed_ship_inside_bd8053a5:

    # "A ghostly figure flickered into view inside a glowing circle."
    "Une silhouette fantomatique apparut en scintillant à l'intérieur d'un cercle lumineux."

# game/data/travel_events/crashed_ship.rpy:119
translate fr travel_event_crashed_ship_inside_472ec9d8:

    # MC @ angry "Who are you, specter?"
    MC @ angry "Qui es-tu, spectre ?"

# game/data/travel_events/crashed_ship.rpy:120
translate fr travel_event_crashed_ship_inside_bf2aaff8:

    # ANDRAS "This is Captain Andras of the Maylark."
    ANDRAS "Je suis le capitaine Andras, du Maylark."

# game/data/travel_events/crashed_ship.rpy:121
translate fr travel_event_crashed_ship_inside_365bbf88:

    # ANDRAS "Day four-hundred and ninety-six since the end of... well, everything."
    ANDRAS "Jour quatre cent quatre-vingt-seize depuis la fin de... enfin, de tout."

# game/data/travel_events/crashed_ship.rpy:122
translate fr travel_event_crashed_ship_inside_bf38bc6e:

    # MARKUS @ think "Uhhh... hello?"
    MARKUS @ think "Euh... allô ?"

# game/data/travel_events/crashed_ship.rpy:123
translate fr travel_event_crashed_ship_inside_18baf767:

    # MC @ think "I don't think he can hear us."
    MC @ think "Je ne pense pas qu'il puisse nous entendre."

# game/data/travel_events/crashed_ship.rpy:124
translate fr travel_event_crashed_ship_inside_b20d5e02:

    # ANDRAS "...{i}*Sigh*{/i} I don't even know why I bother with these things anymore."
    ANDRAS "...{i}*Soupir*{/i} Je ne sais même pas pourquoi je m'embête encore avec ces trucs."

# game/data/travel_events/crashed_ship.rpy:125
translate fr travel_event_crashed_ship_inside_96afb379:

    # ANDRAS "It's not like there's actually anyone left to log it."
    ANDRAS "Ce n'est pas comme s'il restait vraiment quelqu'un pour le consigner."

# game/data/travel_events/crashed_ship.rpy:126
translate fr travel_event_crashed_ship_inside_62cfcc16:

    # ANDRAS "For over a year and a half we've jumped from one dead star to the next."
    ANDRAS "Depuis plus d'un an et demi, nous sautons d'une étoile morte à l'autre."

# game/data/travel_events/crashed_ship.rpy:127
translate fr travel_event_crashed_ship_inside_881f07eb:

    # ANDRAS "One nightmarish, monster infested world to another, searching for someplace safe."
    ANDRAS "D'un monde cauchemardesque infesté de monstres à un autre, à la recherche d'un endroit sûr."

# game/data/travel_events/crashed_ship.rpy:128
translate fr travel_event_crashed_ship_inside_e84fa312:

    # ANDRAS "I still tell the crew that's what we're looking for... Someplace safe."
    ANDRAS "Je dis encore à l'équipage que c'est ce que nous cherchons... Un endroit sûr."

# game/data/travel_events/crashed_ship.rpy:129
translate fr travel_event_crashed_ship_inside_ec95d44a:

    # ANDRAS "I'd just settle for finding some food, fuel... anything now."
    ANDRAS "Je me contenterais juste de trouver de la nourriture, du carburant... n'importe quoi maintenant."

# game/data/travel_events/crashed_ship.rpy:130
translate fr travel_event_crashed_ship_inside_b3b6925c:

    # ANDRAS "It's been months since we found any survivors."
    ANDRAS "Ça fait des mois que nous n'avons trouvé aucun survivant."

# game/data/travel_events/crashed_ship.rpy:131
translate fr travel_event_crashed_ship_inside_9fb46d95:

    # ANDRAS "Well, unless you count the cannibals and freaks."
    ANDRAS "Eh bien, à moins que tu ne comptes les cannibales et les monstres."

# game/data/travel_events/crashed_ship.rpy:132
translate fr travel_event_crashed_ship_inside_89d8f69d:

    # ANDRAS "... We have enough fuel for one last try, some unknown world ready on the edge of the Zelma ring."
    ANDRAS "... Nous avons assez de carburant pour une dernière tentative, un monde inconnu qui nous attend à la limite de l'anneau Zelma."

# game/data/travel_events/crashed_ship.rpy:133
translate fr travel_event_crashed_ship_inside_5b2a8029:

    # ANDRAS "Atmospheric readings look good from orbit, and there seems to be no visual signs of corruption."
    ANDRAS "Les relevés atmosphériques semblent bons depuis l'orbite, et il n'y a apparemment aucun signe visible de corruption."

# game/data/travel_events/crashed_ship.rpy:134
translate fr travel_event_crashed_ship_inside_8cd54f27:

    # ANDRAS "We'll probably stall out on the landing, but hopefully with power routed to the shields, we can at least survive the crash."
    ANDRAS "Nous calerons probablement à l'atterrissage, mais avec un peu de chance, en redirigeant l'énergie vers les boucliers, nous pourrons au moins survivre au crash."

# game/data/travel_events/crashed_ship.rpy:135
translate fr travel_event_crashed_ship_inside_bfea744e:

    # ANDRAS "May the new gods... Ahhh, fuck it."
    ANDRAS "Que les nouveaux dieux... Ahhh, et puis merde."

# game/data/travel_events/crashed_ship.rpy:136
translate fr travel_event_crashed_ship_inside_737f7819:

    # ANDRAS "{i}It's not like they're listening anymore anyway.{/i}"
    ANDRAS "{i}De toute façon, ce n'est pas comme s'ils écoutaient encore.{/i}"

# game/data/travel_events/crashed_ship.rpy:137
translate fr travel_event_crashed_ship_inside_9e72f391:

    # "There was momentary flickering of the strange figure summoned."
    "Il y eut un scintillement momentané de l'étrange silhouette invoquée."

# game/data/travel_events/crashed_ship.rpy:138
translate fr travel_event_crashed_ship_inside_0742b26c:

    # ANDRAS "Day, five hundred and two."
    ANDRAS "Jour, cinq cent deux."

# game/data/travel_events/crashed_ship.rpy:139
translate fr travel_event_crashed_ship_inside_ce1c3d26:

    # ANDRAS "We survived the landing, but the ship's hull is too badly damaged to repair."
    ANDRAS "Nous avons survécu à l'atterrissage, mais la coque du vaisseau est trop endommagée pour être réparée."

# game/data/travel_events/crashed_ship.rpy:140
translate fr travel_event_crashed_ship_inside_7ca46618:

    # ANDRAS "{i}*Chuckles*{/i} Not that we have to fuel left to go anywhere anyway."
    ANDRAS "{i}*Ricanement*{/i} De toute façon, il ne nous reste plus de carburant pour aller où que ce soit."

# game/data/travel_events/crashed_ship.rpy:141
translate fr travel_event_crashed_ship_inside_ece942c3:

    # ANDRAS "The crew and I have decided to salvage what we can from the ship and head out."
    ANDRAS "L'équipage et moi avons décidé de récupérer ce que nous pouvons du navire et de partir."

# game/data/travel_events/crashed_ship.rpy:142
translate fr travel_event_crashed_ship_inside_7d01dea4:

    # ANDRAS "Maybe we can etch out some kind of existence out here."
    ANDRAS "Peut-être pouvons-nous nous tailler une existence ici."

# game/data/travel_events/crashed_ship.rpy:143
translate fr travel_event_crashed_ship_inside_9c0c2393:

    # ANDRAS "It might be a simple life... {i}But at least we're alive.{/i}"
    ANDRAS "Ce sera peut-être une vie simple... {i}Mais au moins nous sommes en vie.{/i}"

# game/data/travel_events/crashed_ship.rpy:144
translate fr travel_event_crashed_ship_inside_2d52d85d:

    # ANDRAS "... The gods."
    ANDRAS "... Les dieux."

# game/data/travel_events/crashed_ship.rpy:145
translate fr travel_event_crashed_ship_inside_6c5751a7:

    # ANDRAS "How the fuck did it come to this?"
    ANDRAS "Comment en sommes-nous arrivés là, bordel ?"

# game/data/travel_events/crashed_ship.rpy:146
translate fr travel_event_crashed_ship_inside_94c58f75:

    # ANDRAS "We blame it all on Malakai and his damned war, but in the end, maybe it was just our blind faith that sealed our fates."
    ANDRAS "Nous mettons tout sur le dos de Malakai et de sa maudite guerre, mais au final, c'était peut-être juste notre foi aveugle qui a scellé notre sort."

# game/data/travel_events/crashed_ship.rpy:147
translate fr travel_event_crashed_ship_inside_2820ff0b:

    # ANDRAS "We always presumed the gods were better than us, wiser, {i}more{/i} than us."
    ANDRAS "Nous avons toujours présumé que les dieux étaient meilleurs que nous, plus sages, {i}plus{/i} que nous."

# game/data/travel_events/crashed_ship.rpy:148
translate fr travel_event_crashed_ship_inside_b9ea5e3e:

    # ANDRAS "{i}But in the end, they fell to all the same trappings we do.{/i}"
    ANDRAS "{i}Mais au final, ils sont tombés dans les mêmes pièges que nous.{/i}"

# game/data/travel_events/crashed_ship.rpy:149
translate fr travel_event_crashed_ship_inside_e5b270d3:

    # ANDRAS "{i}And they dragged everyone down with them.{/i}"
    ANDRAS "{i}Et ils ont entraîné tout le monde dans leur chute.{/i}"

# game/data/travel_events/crashed_ship.rpy:150
translate fr travel_event_crashed_ship_inside_8a41f029:

    # ANDRAS "... Fuck the gods."
    ANDRAS "... Foutus dieux."

# game/data/travel_events/crashed_ship.rpy:151
translate fr travel_event_crashed_ship_inside_1216340c:

    # ANDRAS "This is Captain Andras of the Maylark, signing off for the last time."
    ANDRAS "Ici le capitaine Andras du Maylark, je termine ma dernière transmission."

# game/data/travel_events/crashed_ship.rpy:152
translate fr travel_event_crashed_ship_inside_10ce0df8:

    # "The image flickered, then began replaying."
    "L'image vacilla, puis commença à se rejouer."

# game/data/travel_events/crashed_ship.rpy:155
translate fr travel_event_crashed_ship_inside_9d9f6087:

    # MC @ think "What do you make of that?"
    MC @ think "Qu'en penses-tu ?"

# game/data/travel_events/crashed_ship.rpy:157
translate fr travel_event_crashed_ship_inside_df5f47d2:

    # MARKUS @ talk "Jumping stars... Malakai's war... If this is from the Second War of the Gods... it's ancient."
    MARKUS @ talk "Par toutes les étoiles... la guerre de Malakai... Si cela date de la Deuxième Guerre des Dieux... c'est ancien."

# game/data/travel_events/crashed_ship.rpy:161
translate fr travel_event_crashed_ship_inside_ad56e14d:

    # SYPHA @ talk "We shouldn't linger."
    SYPHA @ talk "Nous ne devrions pas nous attarder."

# game/data/travel_events/crashed_ship.rpy:162
translate fr travel_event_crashed_ship_inside_613528ce:

    # SYPHA @ think "Let ghosts rest."
    SYPHA @ think "Laissons les fantômes reposer."

# game/data/travel_events/crashed_ship.rpy:171
translate fr travel_event_crashed_ship_inside_17813b31:

    # "Most of it had decayed."
    "La plupart s'était décomposée."

# game/data/travel_events/crashed_ship.rpy:172
translate fr travel_event_crashed_ship_inside_1bcd7585:

    # "Anything that once had purpose crumbled in my hands."
    "Tout ce qui avait autrefois un but s'effritait entre mes mains."

# game/data/travel_events/crashed_ship.rpy:173
translate fr travel_event_crashed_ship_inside_e4d9e770:

    # "Except... one thing."
    "Sauf... une chose."

# game/data/travel_events/crashed_ship.rpy:174
translate fr travel_event_crashed_ship_inside_d79ab9c3:

    # "A small metal box."
    "Une petite boîte en métal."

# game/data/travel_events/crashed_ship.rpy:175
translate fr travel_event_crashed_ship_inside_4b38b6fa:

    # "Inside, a glowing blue crystal pulsed rhythmically."
    "À l'intérieur, un cristal bleu lumineux pulsait rythmiquement."

# game/data/travel_events/crashed_ship.rpy:179
translate fr travel_event_crashed_ship_inside_50da1bb3:

    # "I reached in and took the orb."
    "J'ai tendu la main et pris l'orbe."

# game/data/travel_events/crashed_ship.rpy:180
translate fr travel_event_crashed_ship_inside_1343b6dc:

    # "It detached easily from its cables."
