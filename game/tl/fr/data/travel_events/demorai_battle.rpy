translate fr travel_event_battle_demorai_45842b22:

    # "While making my way along the roads, I suddenly heard what sounded like a roar, followed by rumbling drawing quickly closer."
    "Alors que je cheminais sur les routes, j'entendis soudain ce qui ressemblait à un rugissement, suivi d'un grondement qui se rapprochait rapidement."

# game/data/travel_events/demorai_battle.rpy:4
translate fr travel_event_battle_demorai_966a7836:

    # "Suddenly, teeth and claws were gnashing all around me as the hideous demorai launched their attack!"
    "Soudain, dents et griffes grinçaient tout autour de moi alors que les hideux demorai lançaient leur attaque !"

# game/data/travel_events/demorai_battle.rpy:12
translate fr travel_event_battle_demorai_2e0bf73c:

    # MC "(SHIT!)"
    MC "(MERDE !)"

# game/data/travel_events/demorai_battle.rpy:13
translate fr travel_event_battle_demorai_45d3e65f:

    # MC "DEMORAI!"
    MC "DEMORAI !"

# game/data/travel_events/demorai_battle.rpy:25
translate fr travel_event_battle_demorai_751a111e:

    # "Slaying the last of the demorai, I sighed and wiped the blood from myself before moving forward."
    "Ayant abattu le dernier des demorai, je soupirai et essuyai le sang sur moi avant d'avancer."

# game/data/travel_events/demorai_battle.rpy:27
translate fr travel_event_battle_demorai_7fd6ff35:

    # MC "(Need to be careful travelling these roads ... I should make sure I'm prepared for whatever may come my way.)"
    MC "(Je dois être prudent en voyageant sur ces routes... Je devrais m'assurer de me préparer pour tout ce qui pourrait arriver.)"

