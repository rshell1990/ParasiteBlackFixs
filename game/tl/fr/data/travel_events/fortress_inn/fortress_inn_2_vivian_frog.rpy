    MC @ talk "... As-tu besoin d'argent ou de quoi que ce soit de ma part ?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:420
translate fr fortress_inn_vivian_impreg_b78b683f:

    # VIVIAN @ talk "No."
    VIVIAN @ talk "Non."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:421
translate fr fortress_inn_vivian_impreg_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "Quoi ?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:422
translate fr fortress_inn_vivian_impreg_3d9d7297:

    # VIVIAN @ sad "Just... I'd prefer if you weren't in and out of her life."
    VIVIAN @ sad "Juste... Je préférerais que tu n'ailles pas et ne viennes pas dans sa vie."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:423
translate fr fortress_inn_vivian_impreg_6ae44f1c:

    # VIVIAN @ sad "You're with the Adventurers' Guild. You're hardly the settling-down type."
    VIVIAN @ sad "Tu es à la Guilde des Aventuriers. Tu n'es pas vraiment du genre à te poser."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:424
translate fr fortress_inn_vivian_impreg_357a23bb:

    # VIVIAN @ sad "I don't mind you passing by to see how the littlun is doing, but please..."
    VIVIAN @ sad "Je ne t'interdis pas de passer voir comment va le petit, mais s'il te plaît..."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:425
translate fr fortress_inn_vivian_impreg_4a0e8b31:

    # VIVIAN @ talk "I'll tell her that her father is a brave adventurer, but I'm not making promises about when you'll be back."
    VIVIAN @ talk "Je lui dirai que son père est un brave aventurier, mais je ne promets pas quand tu reviendras."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:426
translate fr fortress_inn_vivian_impreg_2c355828:

    # VIVIAN @ talk "If you want to get to know your daughter."
    VIVIAN @ talk "Si tu veux apprendre à connaître ta fille."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:429
translate fr fortress_inn_vivian_impreg_09ad922e:

    # VIVIAN @ talk "Yes... {i}Again.{/i}"
    VIVIAN @ talk "Oui... {i}Encore.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:430
translate fr fortress_inn_vivian_impreg_8d4c87e8:

    # VIVIAN @ angry "Have you considered {i}not{/i} finishing inside me so often?"
    VIVIAN @ angry "As-tu envisagé de {i}ne pas{/i} finir en moi si souvent ?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:431
translate fr fortress_inn_vivian_impreg_4daa591b:

    # MC @ talk "Have you considered not begging me to?"
    MC @ talk "As-tu envisagé de ne pas me supplier de le faire ?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:432
translate fr fortress_inn_vivian_impreg_496aa71a:

    # VIVIAN @ talk "Hmph... Point taken."
    VIVIAN @ talk "Hmph... Bien vu."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:433
translate fr fortress_inn_vivian_impreg_0076e300:

    # VIVIAN @ talk "Nothing has changed. The same rules apply."
    VIVIAN @ talk "Rien n'a changé. Les mêmes règles s'appliquent."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:434
translate fr fortress_inn_vivian_impreg_181a7131:

    # VIVIAN @ talk "If you want to know this little one as well."
    VIVIAN @ talk "Si tu veux connaître ce petit aussi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:436
translate fr fortress_inn_vivian_impreg_dcdf2687:

    # VIVIAN @ talk "{i}If you're still alive by then.{/i}"
    VIVIAN @ talk "{i}Si tu es encore en vie d'ici là.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:437
translate fr fortress_inn_vivian_impreg_4268be46:

    # VIVIAN @ talk "Come back when she's old enough."
    VIVIAN @ talk "Reviens quand elle sera assez grande."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:439
translate fr fortress_inn_vivian_impreg_645057ef:

    # "With that, Vivian turned to tend to the other tables."
    "Sur ce, Vivian se tourna pour s'occuper des autres tables."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:441
translate fr fortress_inn_vivian_impreg_193677a4:

    # MC @ sad "(As depressing as her words were... Perhaps there was some truth in them.)"
    MC @ sad "(Aussi déprimantes que fussent ses paroles... Il y avait peut-être une part de vérité.)"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:442
translate fr fortress_inn_vivian_impreg_415a8152:

    # MC "(Still, hopefully there was a future for me in her life.)"
    MC "(Pourtant, j'espérais qu'il y avait un avenir pour moi dans sa vie.)"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:443
translate fr fortress_inn_vivian_impreg_6e9e356e:

    # MC "(... Presuming this infernal war didn't kill me first.)"
    MC "(... En supposant que cette guerre infernale ne me tue pas d'abord.)"

