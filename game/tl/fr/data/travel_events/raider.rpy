# TODO: Translation updated at 2026-07-01 11:50

# game/data/travel_events/raider.rpy:3
translate fr travel_event_raider_40da6313:

    # "While making my way along the roads, I suddenly had the strangest sense something was wrong..."
    "Alors que je cheminais le long des routes, j'ai soudainement eu le sentiment étrange que quelque chose n'allait pas..."

# game/data/travel_events/raider.rpy:4
translate fr travel_event_raider_f79e4a26:

    # BLACK "({i}Enemies ... all around us{/i})."
    BLACK "({i}Ennemis ... tout autour de nous{/i})."

# game/data/travel_events/raider.rpy:6
translate fr travel_event_raider_00d7c7b1:

    # "A flying arrow suddenly landed itself at my foot, barely missing me as I drew my blade."
    "Une flèche volante s'est soudainement plantée à mon pied, me manquant de peu alors que je dégainais ma lame."

# game/data/travel_events/raider.rpy:7
translate fr travel_event_raider_c17db1ef:

    # "From out of their hiding spots, charged the group of bandits!"
    "Sortant de leurs cachettes, le groupe de bandits chargea !"

# game/data/travel_events/raider.rpy:10
translate fr travel_event_raider_e51b4a2a:

    # MC "(Shit!)"
    MC "(Merde !)"

# game/data/travel_events/raider.rpy:11
translate fr travel_event_raider_a511df2a:

    # BANDIT "Give us everything you've got or we'll pry it from your dead fucking hands!"
    BANDIT "Donne-nous tout ce que t'as ou on te l'arrachera de tes putains de mains mortes !"

# game/data/travel_events/raider.rpy:15
translate fr travel_event_raider_d06ec560:

    # BANDIT "Let's make this easy now, give us your-"
    BANDIT "Rendons les choses faciles maintenant, donne-nous ton-"

# game/data/travel_events/raider.rpy:16
translate fr travel_event_raider_8742b282:

    # "Suddenly, the bandit was toppled over in a flash, screaming as a wild wolf tore at his throat."
    "Soudainement, le bandit fut renversé en un éclair, hurlant alors qu'un loup sauvage lui déchirait la gorge."

# game/data/travel_events/raider.rpy:17
translate fr travel_event_raider_00d4941a:

    # BANDIT "AHHHHHHRGHHHH! GET IT OFF ME! GET IT FUCKING-"
    BANDIT "AHHHHHHRGHHHH! ENLÈVE-LE DE MOI ! ENLÈVE-LE, PUTAIN-"

# game/data/travel_events/raider.rpy:18
translate fr travel_event_raider_6565ed17:

    # "Silence, choking on his blood as he clutched at his torn-out throat, the other bandits panicked as they desperately tried to either run away or rush over."
    "Silence, s'étouffant avec son sang alors qu'il agrippait sa gorge déchirée, les autres bandits paniquèrent alors qu'ils essayaient désespérément de fuir ou de se précipiter."

# game/data/travel_events/raider.rpy:19
translate fr travel_event_raider_cd79a6fc:

    # "One by one, in quick succession, they were pulled and dragged down by the wolves who sprung out from the tall grass, howling with delight as they pressed their fangs into the warm blood and flesh."
    "Un par un, en succession rapide, ils furent tirés et traînés au sol par les loups qui surgissaient des hautes herbes, hurlant de plaisir en enfonçant leurs crocs dans le sang et la chair chauds."

# game/data/travel_events/raider.rpy:21
translate fr travel_event_raider_dfaa6aa7:

    # "My heart racing, I held my hand on the hilt of my blade, ready to draw it, when I felt Elena's hand on my shoulder."
    "Le cœur battant, je posai la main sur la garde de ma lame, prêt à la dégainer, quand je sentis la main d'Elena sur mon épaule."

# game/data/travel_events/raider.rpy:22
translate fr travel_event_raider_4aebc8b2:

    # ELENA "Keep your blade sheathed."
    ELENA "Garde ta lame au fourreau."

# game/data/travel_events/raider.rpy:23
translate fr travel_event_raider_10f7686b:

    # ELENA "They're letting us pass..."
    ELENA "Ils nous laissent passer..."

# game/data/travel_events/raider.rpy:24
translate fr travel_event_raider_7cb86101:

    # "The leader of the pack looked up towards us, mouth covered in blood and panting."
    "Le chef de la meute leva les yeux vers nous, la gueule couverte de sang et haletant."

# game/data/travel_events/raider.rpy:25
translate fr travel_event_raider_f4b78898:

    # "He barked happily, before tucking back into his {i}'meal.'{/i}"
    "Il aboya joyeusement, avant de replonger dans son {i}'repas.'{/i}"

# game/data/travel_events/raider.rpy:26
translate fr travel_event_raider_c83c3a46:

    # ELENA @ smile "Told you that you'd made new friends..."
    ELENA @ smile "Je t'avais dit que tu t'étais fait de nouveaux amis..."

# game/data/travel_events/raider.rpy:31
translate fr travel_event_raider_71495f59:

    # BANDIT "HAVE IT YOUR WAY!"
    BANDIT "À TA GUISE !"

# game/data/travel_events/raider.rpy:46
translate fr travel_event_raider_f334646b:

    # "With the last of the bandits slain and dead at my feet, I carried on, leaving their corpses for the crows."
    "Avec le dernier des bandits abattu et mort à mes pieds, je poursuivis ma route, laissant leurs cadavres aux corbeaux."

# game/data/travel_events/raider.rpy:49
translate fr travel_event_raider_f68e9917:

    # BANDIT "F-Fuck this! Boys! We're out of here!"
    BANDIT "B-Bordel ! Les gars ! On se tire d'ici !"

# game/data/travel_events/raider.rpy:52
translate fr travel_event_raider_f7631e05:

    # "The trembling bandits fled from where they came."
    "Les bandits tremblants s'enfuirent d'où ils étaient venus."

# game/data/travel_events/raider.rpy:57
translate fr travel_event_raider_618e1372:

    # "{i}After spending some time trying to convince them about about a caravan ambushed by Demorai down the road back the way I came...{/i}"
    "{i}Après avoir passé du temps à essayer de les convaincre à propos d'une caravane attaquée par des Démorai sur la route que j'avais empruntée en revenant...{/i}"

# game/data/travel_events/raider.rpy:58
translate fr travel_event_raider_d01d2ade:

    # BANDIT "Hmm, alright, you can go."
    BANDIT "Hmm, d'accord, tu peux y aller."

# game/data/travel_events/raider.rpy:59
translate fr travel_event_raider_e446dbb3:

    # BANDIT "But if we find you're lying, you're fucking dead!"
    BANDIT "Mais si on découvre que tu mens, t'es mort, putain !"

# game/data/travel_events/raider.rpy:62
translate fr travel_event_raider_3d302e34:

    # "The bandits left in the direction I pointed."
    "Les bandits partirent dans la direction que j'avais indiquée."

# game/data/travel_events/raider.rpy:64
translate fr travel_event_raider_73f1c8c7:

    # MC "(Idiots.)"
    MC "(Idiots.)"

# game/data/travel_events/raider.rpy:69
translate fr travel_event_raider_add49207:

    # BANDIT "Hand it over! Heh!"
    BANDIT "Donne-le ! Hé !"

translate fr strings:

    # game/data/travel_events/raider.rpy:30
    old "{image=[ICON.SWORDS]} I don't think so..."
    new "{image=[ICON.SWORDS]} Je ne pense pas..."

    # game/data/travel_events/raider.rpy:48
    old "I'll slaughter each and every one of you, and when I'm done, I'll wear your flayed skin as a trophy to show to your loved ones."
    new "Je vais tous vous massacrer, et quand j'en aurai fini, je porterai votre peau écorchée comme trophée pour le montrer à vos proches."

    # game/data/travel_events/raider.rpy:56
    old "There's no need to fight, I know where a much better haul is..."
    new "Pas besoin de se battre, je sais où il y a un bien meilleur butin..."

    # game/data/travel_events/raider.rpy:68
    old "I'll give you what you want..."
    new "Je te donnerai ce que tu veux..."

