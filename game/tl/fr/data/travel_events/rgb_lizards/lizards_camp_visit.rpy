# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:22
translate fr travel_event_lizard_camp_visit_pregnant_bc8337af:

    # "While moving around the camp, I picked up a distinct scent that made me stop in my tracks."
    "Alors que je me déplaçais dans le camp, j'ai capté une odeur distincte qui m'a fait m'arrêter net."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:23
translate fr travel_event_lizard_camp_visit_pregnant_627fb527:

    # "As I looked around, I listened carefully, and for a moment, I thought perhaps I was wrong; perhaps there was nothing there."
    "En regardant autour de moi, j'ai écouté attentivement, et pendant un instant, j'ai pensé que je me trompais peut-être ; qu'il n'y avait peut-être rien."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:24
translate fr travel_event_lizard_camp_visit_pregnant_99f44af8:

    # "Then I heard it, that distinct {i}hissing{/i} sound, calling to me."
    "Puis je l'ai entendu, ce son distinct {i}de sifflement{/i}, m'appelant."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:32
translate fr travel_event_lizard_camp_visit_pregnant_167176ed:

    # "Following the voice towards the outskirts of the camp, I found the Skalith waiting for me."
    "En suivant la voix vers la périphérie du camp, j'ai trouvé la Skalith qui m'attendait."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:33
translate fr travel_event_lizard_camp_visit_pregnant_006492e1:

    # "She let out a low rumble when she saw me, but my eyes were naturally drawn to the round, pregnant belly she tenderly rubbed at."
    "Elle a émis un grondement sourd quand elle m'a vu, mais mes yeux furent naturellement attirés par le ventre rond et enceint qu'elle caressait tendrement."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:34
translate fr travel_event_lizard_camp_visit_pregnant_009ace1c:

    # MC @ surprised "You're-"
    MC @ surprised "Tu es-"

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:35
translate fr travel_event_lizard_camp_visit_pregnant_d346991d:

    # "I stopped myself. The girl didn't seem to register my words, but she understood my surprise."
    "Je me suis arrêté. La fille ne sembla pas comprendre mes mots, mais elle comprit ma surprise."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:37
translate fr travel_event_lizard_camp_visit_pregnant_c1fa40b4:

    # "Stepping forward, she tenderly placed my hands onto her belly for a moment, letting me feel the child moving around inside."
    "S'avançant, elle plaça tendrement mes mains sur son ventre un instant, me laissant sentir l'enfant bouger à l'intérieur."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:38
translate fr travel_event_lizard_camp_visit_pregnant_22694b3a:

    # "As I looked up to her to meet her eyes, she stepped back, turning tail to flee into the distance!"
    "Alors que je levai les yeux vers elle pour rencontrer son regard, elle recula, faisant demi-tour pour fuir au loin !"

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:40
translate fr travel_event_lizard_camp_visit_pregnant_4f4f1287:

    # MC "Wait! Stop!"
    MC "Attends ! Arrête !"

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:41
translate fr travel_event_lizard_camp_visit_pregnant_7a0856e3:

    # MC @ serious "(That Skalith... It came to see me to let me know she carried my child?)"
    MC @ serious "(Ce Skalith... Elle est venue me voir pour m'annoncer qu'elle portait mon enfant ?)"

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:42
translate fr travel_event_lizard_camp_visit_pregnant_a1a776b2:

    # MC @ think "(I thought those things were just mindless killers?)"
    MC @ think "(Je pensais que ces choses étaient juste des tueurs sans cervelle ?)"

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:46
translate fr travel_event_lizard_camp_visit_gavebirth_bc8337af:

    # "While moving around the camp, I picked up a distinct scent that made me stop in my tracks."
    "En me déplaçant dans le camp, j'ai capté une odeur distincte qui m'a fait m'arrêter net."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:47
translate fr travel_event_lizard_camp_visit_gavebirth_627fb527:

    # "As I looked around, I listened carefully, and for a moment, I thought perhaps I was wrong; perhaps there was nothing there."
    "Alors que je regardais autour, j'écoutais attentivement, et un instant, j'ai pensé que peut-être je m'étais trompé ; peut-être qu'il n'y avait rien."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:48
translate fr travel_event_lizard_camp_visit_gavebirth_99f44af8:

    # "Then I heard it, that distinct {i}hissing{/i} sound, calling to me."
    "Puis j'ai entendu ce son distinct de {i}sifflement{/i} qui m'appelait."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:56
translate fr travel_event_lizard_camp_visit_gavebirth_167176ed:

    # "Following the voice towards the outskirts of the camp, I found the Skalith waiting for me."
    "En suivant la voix vers la périphérie du camp, j'ai trouvé la Skalith qui m'attendait."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:57
translate fr travel_event_lizard_camp_visit_gavebirth_e8c0c1b0:

    # "She let out a low rumble when she saw me, but my eyes were naturally drawn to the small, gurgling, lizard-like child in her arms."
    "Elle a émis un grondement sourd en me voyant, mais mes yeux étaient naturellement attirés par le petit enfant reptilien gargouillant dans ses bras."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:58
translate fr travel_event_lizard_camp_visit_gavebirth_c9d45596:

    # MC @ surprised "Is that our-"
    MC @ surprised "C'est notre-"

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:59
translate fr travel_event_lizard_camp_visit_gavebirth_8ffded9c:

    # "The Skalith rumbled soothingly in approval, her eyes filled towards me with... {i}adoration?{/i}"
    "La Skalith a grondé doucement en signe d'approbation, ses yeux remplis envers moi de... {i}adoration ?{/i}"

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:61
translate fr travel_event_lizard_camp_visit_gavebirth_4811bb6d:

    # "Stepping forward, she let me look closer at our child, who sleepily reached out to grab at one of my fingers and squeeze it tightly."
    "En s'avançant, elle m'a laissé regarder de plus près notre enfant, qui a tendu une main ensommeillée pour attraper un de mes doigts et le serrer fort."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:62
translate fr travel_event_lizard_camp_visit_gavebirth_84ef6b8d:

    # "Gently, I found my Skalith's mate's clawed hands gently cupping over my crotch as she lightly rubbed against it."
    "Doucement, je sentis les mains griffues de la compagne de mon Skalith se poser doucement sur mon entrejambe tandis qu'elle le frottait légèrement."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:63
translate fr travel_event_lizard_camp_visit_gavebirth_1addb147:

    # "Her body secreted that same powerful scent to tell me her intentions without even saying a word."
    "Son corps sécrétait ce même parfum puissant pour me faire comprendre ses intentions sans même prononcer un mot."

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:64
translate fr travel_event_lizard_camp_visit_gavebirth_5d7be6df:

    # "{i}She wants more offspring, she wants to keep mating...{/i}"
    "{i}Elle veut plus de descendants, elle veut continuer à s'accoupler...{/i}"

# game/data/travel_events/rgb_lizards/lizards_camp_visit.rpy:65
translate fr travel_event_lizard_camp_visit_gavebirth_da91d3d4:

    # "We looked into each other's eyes for a moment before she finally stepped back, turning tail to flee into the distance. She hurried off with our child, leaving me to contemplate her...{i}proposal.{/i}"
    "Nous nous sommes regardés dans les yeux un instant avant qu'elle ne recule finalement, tournant les talons pour fuir au loin. Elle s'est enfuie avec notre enfant, me laissant réfléchir à sa... {i}proposition.{/i}"

