# game/data/travel_events/travel_banter.rpy:40
translate fr travelmodebanter_map_elena_mc_1_9828a89f:

    # ELENA @ talk "Just... curiosity."
    ELENA @ talk "Juste... par curiosité."

# game/data/travel_events/travel_banter.rpy:41
translate fr travelmodebanter_map_elena_mc_1_e722756d:

    # ELENA @ talk "Growing up at Thornfalls, I dreamt of faraway places and adventures."
    ELENA @ talk "En grandissant à Thornfalls, je rêvais de lieux lointains et d'aventures."

# game/data/travel_events/travel_banter.rpy:42
translate fr travelmodebanter_map_elena_mc_1_6308ffa5:

    # ELENA @ smile "It seems silly now, but... I still think about the places I want to see."
    ELENA @ smile "Ça semble idiot maintenant, mais... je pense encore aux endroits que je veux voir."

# game/data/travel_events/travel_banter.rpy:45
translate fr travelmodebanter_map_elena_mc_1_96b1d0a3:

    # ELENA @ shock "Just like that?"
    ELENA @ shock "Comme ça ?"

# game/data/travel_events/travel_banter.rpy:46
translate fr travelmodebanter_map_elena_mc_1_bb7eda56:

    # MC @ smile "There's a whole world out there."
    MC @ smile "Il y a tout un monde là-dehors."

# game/data/travel_events/travel_banter.rpy:47
translate fr travelmodebanter_map_elena_mc_1_c579fce3:

    # ELENA @ smile "And would there be room for one more?"
    ELENA @ smile "Et y aurait-il de la place pour un de plus ?"

# game/data/travel_events/travel_banter.rpy:48
translate fr travelmodebanter_map_elena_mc_1_6bc977b7:

    # MC @ smile2 "I'm sure I could fit you in."
    MC @ smile2 "Je suis sûr de pouvoir te faire une place."

# game/data/travel_events/travel_banter.rpy:49
translate fr travelmodebanter_map_elena_mc_1_5b4dee46:

    # ELENA @ smile "I must admit, I'm surprised."
    ELENA @ smile "Je dois avouer que je suis surpris."

# game/data/travel_events/travel_banter.rpy:50
translate fr travelmodebanter_map_elena_mc_1_082ad89d:

    # ELENA @ smile "Markus told me all you two wanted was a quiet life behind palace walls."
    ELENA @ smile "Markus m'a dit que tout ce que vous vouliez tous les deux, c'était une vie tranquille derrière les murs du palais."

# game/data/travel_events/travel_banter.rpy:51
translate fr travelmodebanter_map_elena_mc_1_0d739712:

    # MC @ talk "Funny, isn't it?"
    MC @ talk "Drôle, n'est-ce pas ?"

# game/data/travel_events/travel_banter.rpy:52
translate fr travelmodebanter_map_elena_mc_1_995149d2:

    # MC @ talk "That dream started feeling more like a cage after... everything."
    MC @ talk "Ce rêve a commencé à ressembler davantage à une cage après... tout."

# game/data/travel_events/travel_banter.rpy:53
translate fr travelmodebanter_map_elena_mc_1_e5753e06:

    # ELENA @ smile "No. Not strange at all. Not to me."
    ELENA @ smile "Non. Pas du tout étrange. Pas pour moi."

# game/data/travel_events/travel_banter.rpy:55
translate fr travelmodebanter_map_elena_mc_1_19758ec6:

    # ELENA @ talk "Ahh, you seem more like a homebody."
    ELENA @ talk "Ahh, tu sembles plutôt casanier."

# game/data/travel_events/travel_banter.rpy:56
translate fr travelmodebanter_map_elena_mc_1_b3517fc1:

    # MC @ think "Oh?"
    MC @ think "Oh ?"

# game/data/travel_events/travel_banter.rpy:57
translate fr travelmodebanter_map_elena_mc_1_01b971be:

    # ELENA @ grumpy "You and Markus dreamed of royal service, didn't you?"
    ELENA @ grumpy "Toi et Markus rêviez de service royal, n'est-ce pas ?"

# game/data/travel_events/travel_banter.rpy:58
translate fr travelmodebanter_map_elena_mc_1_6204f33e:

    # ELENA @ smile "Not exactly an adventurous life."
    ELENA @ smile "Pas exactement une vie aventureuse."

# game/data/travel_events/travel_banter.rpy:59
translate fr travelmodebanter_map_elena_mc_1_ab966d56:

    # MC @ talk "Is wanting a quiet life so wrong?"
    MC @ talk "Est-ce si mal de vouloir une vie tranquille ?"

# game/data/travel_events/travel_banter.rpy:60
translate fr travelmodebanter_map_elena_mc_1_4ca3d53f:

    # ELENA @ smile "Not at all."
    ELENA @ smile "Pas du tout."

# game/data/travel_events/travel_banter.rpy:61
translate fr travelmodebanter_map_elena_mc_1_b2753dd2:

    # ELENA @ smile "It's your life to live."
    ELENA @ smile "C'est ta vie à vivre."

# game/data/travel_events/travel_banter.rpy:62
translate fr travelmodebanter_map_elena_mc_1_cdd397f7:

    # MC @ think "{i}... And when this war is one day over.{/i}"
    MC @ think "{i}... Et quand cette guerre sera un jour terminée.{/i}"

# game/data/travel_events/travel_banter.rpy:63
translate fr travelmodebanter_map_elena_mc_1_1cfe520f:

    # MC @ think "{i}Is it a life you'd want to be a part of?{/i}"
    MC @ think "{i}Est-ce une vie dont tu voudrais faire partie ?{/i}"

# game/data/travel_events/travel_banter.rpy:64
translate fr travelmodebanter_map_elena_mc_1_4c9bb63b:

    # ELENA @ lewd "L-Let's leave that question for another day."
    ELENA @ lewd "L-Laissons cette question pour un autre jour."

# game/data/travel_events/travel_banter.rpy:74
translate fr travelmodebanter_map_elena_mc_2_dfcc99a2:

    # ELENA @ grumpy "...Does it hurt?"
    ELENA @ grumpy "...Est-ce que ça fait mal ?"

# game/data/travel_events/travel_banter.rpy:76
translate fr travelmodebanter_map_elena_mc_2_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Quoi ?"

# game/data/travel_events/travel_banter.rpy:77
translate fr travelmodebanter_map_elena_mc_2_4b60e47a:

    # ELENA @ grumpy "When you change into that thing... does it hurt?"
    ELENA @ grumpy "Quand tu te transformes en cette chose... est-ce que ça fait mal ?"

# game/data/travel_events/travel_banter.rpy:78
translate fr travelmodebanter_map_elena_mc_2_3496abfa:

    # MC @ talk "It... did. At first."
    MC @ talk "Ça... faisait mal. Au début."

# game/data/travel_events/travel_banter.rpy:80
translate fr travelmodebanter_map_elena_mc_2_0a297aba:

    # MC @ talk "It was agony."
    MC @ talk "C'était une agonie."

# game/data/travel_events/travel_banter.rpy:81
translate fr travelmodebanter_map_elena_mc_2_54e3ddd7:

    # MC @ talk "But it gets easier every time."
    MC @ talk "Mais ça devient plus facile à chaque fois."

# game/data/travel_events/travel_banter.rpy:83
translate fr travelmodebanter_map_elena_mc_2_c2fc29a5:

    # MC @ talk "Why do you ask?"
    MC @ talk "Pourquoi cette question ?"

# game/data/travel_events/travel_banter.rpy:84
translate fr travelmodebanter_map_elena_mc_2_ede2ccf2:

    # ELENA @ sad "Just worried about you."
    ELENA @ sad "Je m'inquiète juste pour toi."

# game/data/travel_events/travel_banter.rpy:85
translate fr travelmodebanter_map_elena_mc_2_7cedfe97:

    # ELENA @ talk "How are you holding up? After everything that's happened so fast..."
    ELENA @ talk "Comment tiens-tu le coup ? Après tout ce qui est arrivé si vite..."

# game/data/travel_events/travel_banter.rpy:88
translate fr travelmodebanter_map_elena_mc_2_cf94bad7:

    # ELENA @ shock "Really? I'm surprised... most people would struggle."
    ELENA @ shock "Vraiment ? Je suis surpris... la plupart des gens auraient du mal."

# game/data/travel_events/travel_banter.rpy:89
translate fr travelmodebanter_map_elena_mc_2_094bce6b:

    # MC @ talk "There are doubts, sure. But we can actually change things now."
    MC @ talk "Il y a des doutes, c'est sûr. Mais nous pouvons vraiment changer les choses maintenant."

# game/data/travel_events/travel_banter.rpy:90
translate fr travelmodebanter_map_elena_mc_2_e1f4d040:

    # MC @ smile "Before the gift, I felt powerless. Like my life wasn't mine."
    MC @ smile "Avant le don, je me sentais impuissant. Comme si ma vie ne m'appartenait pas."

# game/data/travel_events/travel_banter.rpy:91
translate fr travelmodebanter_map_elena_mc_2_92dfa1e6:

    # MC @ smile "Now? It's like we finally have... {i}hope.{/i}"
    MC @ smile "Maintenant ? C'est comme si nous avions enfin... {i}de l'espoir.{/i}"

# game/data/travel_events/travel_banter.rpy:92
translate fr travelmodebanter_map_elena_mc_2_73c0b9f3:

    # ELENA @ smile "You're starting to sound like a hero from the old tales."
    ELENA @ smile "Tu commences à ressembler à un héros des vieux contes."

# game/data/travel_events/travel_banter.rpy:93
translate fr travelmodebanter_map_elena_mc_2_f18990c6:

    # MC @ smile "Let's not go that far."
    MC @ smile "N'allons pas si loin."

# game/data/travel_events/travel_banter.rpy:94
translate fr travelmodebanter_map_elena_mc_2_91c8e0b3:

    # ELENA @ smile "Come. Let's keep moving."
    ELENA @ smile "Viens. Continuons d'avancer."

# game/data/travel_events/travel_banter.rpy:96
translate fr travelmodebanter_map_elena_mc_2_a4311795:

    # ELENA @ sad "That's... a relief. You can talk to me, you know."
    ELENA @ sad "C'est... un soulagement. Tu peux me parler, tu sais."

# game/data/travel_events/travel_banter.rpy:97
translate fr travelmodebanter_map_elena_mc_2_b067621a:

    # MC @ smile "That means more than you think."
    MC @ smile "Ça signifie plus que tu ne le penses."

# game/data/travel_events/travel_banter.rpy:98
translate fr travelmodebanter_map_elena_mc_2_42ddcd91:

    # ELENA @ smile "Come on. Let's keep moving."
    ELENA @ smile "Allez. Continuons d'avancer."

# game/data/travel_events/travel_banter.rpy:100
translate fr travelmodebanter_map_elena_mc_2_2f15a7d9:

    # ELENA @ sad "I'm here if you want to talk."
    ELENA @ sad "Je suis là si tu veux parler."

# game/data/travel_events/travel_banter.rpy:101
translate fr travelmodebanter_map_elena_mc_2_30d77ce8:

    # ELENA @ sad "It weighs heavy, doesn't it? Memories that won't let go..."
    ELENA @ sad "C'est lourd à porter, n'est-ce pas ? Des souvenirs qui ne veulent pas s'en aller..."

# game/data/travel_events/travel_banter.rpy:102
translate fr travelmodebanter_map_elena_mc_2_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/travel_events/travel_banter.rpy:103
translate fr travelmodebanter_map_elena_mc_2_6c08d76e:

    # ELENA @ sad "A-Anyway! I just wanted you to know you're not alone."
    ELENA @ sad "B-Bref ! Je voulais juste que tu saches que tu n'es pas seul."

# game/data/travel_events/travel_banter.rpy:104
translate fr travelmodebanter_map_elena_mc_2_1a43d7a9:

    # ELENA @ talk "I'm here if you need me."
    ELENA @ talk "Je suis là si tu as besoin de moi."

# game/data/travel_events/travel_banter.rpy:105
translate fr travelmodebanter_map_elena_mc_2_ddf70b53:

    # MC @ smile "Thank you, Elena."
    MC @ smile "Merci, Elena."

# game/data/travel_events/travel_banter.rpy:106
translate fr travelmodebanter_map_elena_mc_2_0403d166:

    # ELENA @ smile "Come. Let's keep going."
    ELENA @ smile "Viens. Continuons."

# game/data/travel_events/travel_banter.rpy:116
translate fr travelmodebanter_map_elena_mc_3_romance_ed8a1411:

    # "While walking, something soft brushed against my side."
    "En marchant, quelque chose de doux a frôlé mon côté."

# game/data/travel_events/travel_banter.rpy:118
translate fr travelmodebanter_map_elena_mc_3_romance_899cf127:

    # "Elena passed me with a coy smile and a soft hum."
    "Elena m'a dépassé avec un sourire coquet et un doux fredonnement."

# game/data/travel_events/travel_banter.rpy:119
translate fr travelmodebanter_map_elena_mc_3_romance_fe9303c4:

    # ELENA @ smile "{i}*Happy humming*{/i}"
    ELENA @ smile "{i}*Fredonnement joyeux*{/i}"

# game/data/travel_events/travel_banter.rpy:120
translate fr travelmodebanter_map_elena_mc_3_romance_3321ea6a:

    # MC @ smile "Someone's in a good mood."
    MC @ smile "Quelqu'un est de bonne humeur."

# game/data/travel_events/travel_banter.rpy:122
translate fr travelmodebanter_map_elena_mc_3_romance_07f53f05:

    # ELENA @ smile "Of course. The weather's pleasant, the air is clean..."
    ELENA @ smile "Bien sûr. Le temps est agréable, l'air est pur..."

# game/data/travel_events/travel_banter.rpy:123
translate fr travelmodebanter_map_elena_mc_3_romance_bc9974f6:

    # "She glanced back, her sultry eyes dancing."
    "Elle a jeté un coup d'œil en arrière, ses yeux sensuels dansant."

# game/data/travel_events/travel_banter.rpy:124
translate fr travelmodebanter_map_elena_mc_3_romance_3f6ec57a:

    # ELENA @ smile "And {i}the view{/i} is quite nice, too."
    ELENA @ smile "Et {i}la vue{/i} est plutôt belle, aussi."

# game/data/travel_events/travel_banter.rpy:125
translate fr travelmodebanter_map_elena_mc_3_romance_eaad9ebd:

    # MC @ smile "The view, huh?"
    MC @ smile "La vue, hein ?"

# game/data/travel_events/travel_banter.rpy:126
translate fr travelmodebanter_map_elena_mc_3_romance_80da6f9e:

    # "Her tail brushed me again playfully as she walked ahead."
    "Sa queue m'a frôlé à nouveau de manière ludique alors qu'elle marchait devant."

# game/data/travel_events/travel_banter.rpy:127
translate fr travelmodebanter_map_elena_mc_3_romance_f4fe840d:

    # ELENA @ smile "Yes. It's been on my mind a lot lately."
    ELENA @ smile "Oui. Cela m'a beaucoup trotté dans la tête ces derniers temps."

# game/data/travel_events/travel_banter.rpy:130
translate fr travelmodebanter_map_elena_mc_3_romance_c670f114:

    # MC @ smile "(Cute.)"
    MC @ smile "(Mignonne.)"

# game/data/travel_events/travel_banter.rpy:137
translate fr travelmodebanter_map_elena_markus_1_ddfff1fd:

    # MARKUS @ think "So, you're a lady, then?"
    MARKUS @ think "Alors, tu es une dame, donc ?"

# game/data/travel_events/travel_banter.rpy:139
translate fr travelmodebanter_map_elena_markus_1_abecf88a:

    # ELENA @ talk "Yes, I do indeed belong to the female gender."
    ELENA @ talk "Oui, j'appartiens en effet au genre féminin."

# game/data/travel_events/travel_banter.rpy:140
translate fr travelmodebanter_map_elena_markus_1_d0033b5e:

    # MARKUS @ angry "You know that wasn't what I was talking about!"
    MARKUS @ angry "Tu sais que ce n'était pas de ça que je parlais !"

# game/data/travel_events/travel_banter.rpy:141
translate fr travelmodebanter_map_elena_markus_1_3213a1a5:

    # MARKUS @ talk "I mean, you're a *lady* lady. Like, you grew up in some huge estate house."
    MARKUS @ talk "Je veux dire, tu es une *dame* de la haute. Genre, tu as grandi dans un immense manoir."

# game/data/travel_events/travel_banter.rpy:142
translate fr travelmodebanter_map_elena_markus_1_9316f5fc:

    # ELENA @ smile "Yes. The ones with the very long tables and lots of food on them."
    ELENA @ smile "Oui. Celles avec les très longues tables et beaucoup de nourriture dessus."

# game/data/travel_events/travel_banter.rpy:143
translate fr travelmodebanter_map_elena_markus_1_f6ced7d6:

    # ELENA @ smile "Are you going somewhere with this?"
    ELENA @ smile "Tu veux en venir où ?"

# game/data/travel_events/travel_banter.rpy:144
translate fr travelmodebanter_map_elena_markus_1_a54c70bc:

    # MARKUS @ talk "Sensitive much?"
    MARKUS @ talk "On est susceptible, là ?"

# game/data/travel_events/travel_banter.rpy:146
translate fr travelmodebanter_map_elena_markus_1_2de858ba:

    # ELENA @ talk "I can assure you, manor house or not, my time at the Thornfalls was... difficult."
    ELENA @ talk "Je peux t'assurer, manoir ou pas, mon temps chez les Thornfall a été... difficile."

# game/data/travel_events/travel_banter.rpy:147
translate fr travelmodebanter_map_elena_markus_1_6211068f:

    # MARKUS @ think "I find that hard to believe."
    MARKUS @ think "J'ai du mal à y croire."

# game/data/travel_events/travel_banter.rpy:148
translate fr travelmodebanter_map_elena_markus_1_298cf6f7:

    # MARKUS @ think "Did you ever have to worry about where your next meal would come from?"
    MARKUS @ think "As-tu déjà dû t'inquiéter d'où viendrait ton prochain repas ?"

# game/data/travel_events/travel_banter.rpy:149
translate fr travelmodebanter_map_elena_markus_1_24473bcf:

    # MARKUS @ think "Or constantly wonder when, not if, the next loved one would be taken by this infernal war?"
    MARKUS @ think "Ou te demander constamment quand, pas si, le prochain être cher serait emporté par cette guerre infernale ?"

# game/data/travel_events/travel_banter.rpy:150
translate fr travelmodebanter_map_elena_markus_1_3cdbde5f:

    # ELENA @ angry "No..."
    ELENA @ angry "Non..."

# game/data/travel_events/travel_banter.rpy:152
translate fr travelmodebanter_map_elena_markus_1_77cdaa2f:

    # ELENA @ angry "I just spent every night living in fear."
    ELENA @ angry "Je passais simplement chaque nuit à vivre dans la peur."

# game/data/travel_events/travel_banter.rpy:153
translate fr travelmodebanter_map_elena_markus_1_d313e372:

    # ELENA @ angry "Let me tell you something, Markus."
    ELENA @ angry "Laisse-moi te dire quelque chose, Markus."

# game/data/travel_events/travel_banter.rpy:154
translate fr travelmodebanter_map_elena_markus_1_f52bc4d7:

    # ELENA @ angry "It's one kind of hell to starve... it's another entirely to wonder if every meal you're served will be your last."
    ELENA @ angry "C'est une sorte d'enfer de mourir de faim... c'en est une autre entièrement de se demander si chaque repas qu'on te sert sera le dernier."

# game/data/travel_events/travel_banter.rpy:164
translate fr travelmodebanter_map_elena_markus_2_6b1dd249:

    # MARKUS @ talk "Tell me, Elena."
    MARKUS @ talk "Dis-moi, Elena."

# game/data/travel_events/travel_banter.rpy:166
translate fr travelmodebanter_map_elena_markus_2_10d78c40:

    # MARKUS @ talk "You must have spent some time traveling around before meeting us."
    MARKUS @ talk "Tu as dû passer du temps à voyager avant de nous rencontrer."

# game/data/travel_events/travel_banter.rpy:167
translate fr travelmodebanter_map_elena_markus_2_2f0ee648:

    # MARKUS @ smile "Got any interesting stories to tell?"
    MARKUS @ smile "As-tu des histoires intéressantes à raconter ?"

# game/data/travel_events/travel_banter.rpy:168
translate fr travelmodebanter_map_elena_markus_2_c983087c:

    # ELENA @ grumpy "...A while back, while I was in Newyark, I heard about a 'wolf woman' and naturally, my interest was piqued."
    ELENA @ grumpy "...Il y a quelque temps, alors que j'étais à Newyark, j'ai entendu parler d'une 'femme-loup' et naturellement, ma curiosité a été piquée."

# game/data/travel_events/travel_banter.rpy:169
translate fr travelmodebanter_map_elena_markus_2_71871438:

    # ELENA @ talk "It didn't sound like any kind of Katai, so I thought perhaps I might finally find another of my kind."
    ELENA @ talk "Ça ne ressemblait à aucun type de Katai, alors j'ai pensé que je pourrais enfin trouver un autre de mon espèce."

# game/data/travel_events/travel_banter.rpy:170
translate fr travelmodebanter_map_elena_markus_2_e936c5f8:

    # MARKUS @ think "What did you find?"
    MARKUS @ think "Qu'as-tu trouvé ?"

# game/data/travel_events/travel_banter.rpy:171
translate fr travelmodebanter_map_elena_markus_2_2dd61dd9:

    # ELENA @ shock "It was a woman who had made some kind of... fur suit from different pelts of wolves."
    ELENA @ shock "C'était une femme qui avait fabriqué une sorte de... costume de fourrure avec différentes peaux de loups."

# game/data/travel_events/travel_banter.rpy:173
translate fr travelmodebanter_map_elena_markus_2_03538783:

    # ELENA @ shock "She was running around on stage pretending to be a wolf!"
    ELENA @ shock "Elle courait sur scène en faisant semblant d'être un loup !"

# game/data/travel_events/travel_banter.rpy:174
translate fr travelmodebanter_map_elena_markus_2_cc301a3c:

    # ELENA @ shock "Can you imagine people doing such a strange thing?"
    ELENA @ shock "Peux-tu imaginer des gens faire une chose aussi étrange ?"

# game/data/travel_events/travel_banter.rpy:175
translate fr travelmodebanter_map_elena_markus_2_0f3ab35d:

    # MARKUS @ think "...Too much salt in the air from the sea."
    MARKUS @ think "...Trop de sel dans l'air à cause de la mer."

# game/data/travel_events/travel_banter.rpy:176
translate fr travelmodebanter_map_elena_markus_2_f1fa7ebb:

    # MARKUS @ think "That's why all those Newyark folk are so strange."
    MARKUS @ think "C'est pour ça que tous ces gens de Newyark sont si bizarres."

# game/data/travel_events/travel_banter.rpy:186
translate fr travelmodebanter_map_elena_markus_3_8008183f:

    # ELENA @ smile "Markus, I'm curious about something..."
    ELENA @ smile "Markus, je suis curieux à propos de quelque chose..."

# game/data/travel_events/travel_banter.rpy:188
translate fr travelmodebanter_map_elena_markus_3_a04187b6:

    # MARKUS @ talk "Ask away."
    MARKUS @ talk "Demande."

# game/data/travel_events/travel_banter.rpy:189
translate fr travelmodebanter_map_elena_markus_3_aaf4f0d0:

    # ELENA @ talk "I'm aware of [player_name!t]'s... umm, {i}paramours and dalliances.{/i}"
    ELENA @ talk "Je suis au courant des... euh, {i}amants et liaisons{/i} de [player_name!t]."

# game/data/travel_events/travel_banter.rpy:190
translate fr travelmodebanter_map_elena_markus_3_10dd5267:

    # ELENA @ grumpy "But I never see you with anyone."
    ELENA @ grumpy "Mais je ne te vois jamais avec personne."

# game/data/travel_events/travel_banter.rpy:191
translate fr travelmodebanter_map_elena_markus_3_33702753:

