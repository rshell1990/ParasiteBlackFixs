# game/data/travel_events/wolves.rpy:3
translate fr travel_event_wolves_d9365df9:

    # "While trekking my way through the forests, I heard the distinct sound of...{i}howling?{/i}"
    "Alors que je traversais les forêts, j'ai entendu un son distinct de...{i}hurlement ?{/i}"

# game/data/travel_events/wolves.rpy:4
translate fr travel_event_wolves_9123a2e4:

    # "From the tree lines, a pack of hungry wolves descended upon me, snarling and circling."
    "Des lisières des arbres, une meute de loups affamés est descendue sur moi, grognant et tournant autour."

# game/data/travel_events/wolves.rpy:7
translate fr travel_event_wolves_b05c7a7b:

    # "The wolves whined and howled as they scattered the winds."
    "Les loups gémissaient et hurlaient alors qu'ils se dispersaient dans le vent."

# game/data/travel_events/wolves.rpy:8
translate fr travel_event_wolves_cda900f2:

    # MC "(Damn beasts!)"
    MC "(Maudites bêtes !)"

# game/data/travel_events/wolves.rpy:16
translate fr travel_event_wolves_f567ab41:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Alors que le dernier loup poussait des jappements de douleur angoissée, j'ai rapidement mis fin à ses souffrances."

# game/data/travel_events/wolves.rpy:17
translate fr travel_event_wolves_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Soupir*{/i}"

# game/data/travel_events/wolves.rpy:18
translate fr travel_event_wolves_ed59b7aa:

    # MC "(These poor things are half-starved, no wonder they're attacking on sight...)"
    MC "(Ces pauvres créatures sont à moitié affamées, pas étonnant qu'elles attaquent à vue...)"

# game/data/travel_events/wolves.rpy:22
translate fr travel_event_wolves_04301006:

    # MC @ think "I don't suppose {i}you{/i} could handle this?"
    MC @ think "Je suppose que {i}toi{/i} ne pourrais pas gérer ça ?"

# game/data/travel_events/wolves.rpy:23
translate fr travel_event_wolves_c3f644c4:

    # ELENA "I mean, {i}I could try.{/i}"
    ELENA "Je veux dire, {i}je pourrais essayer.{/i}"

# game/data/travel_events/wolves.rpy:25
translate fr travel_event_wolves_b6bd6149:

    # "Elena stepped forward and snarled towards the wolves, who tilted their heads curiously in understanding."
    "Elena s'avança et grogna vers les loups, qui penchèrent la tête avec curiosité, comprenant."

# game/data/travel_events/wolves.rpy:26
translate fr travel_event_wolves_632809bd:

    # "After some brief barking, Elena turns towards you."
    "Après quelques aboiements brefs, Elena se tourne vers vous."

# game/data/travel_events/wolves.rpy:27
translate fr travel_event_wolves_6b567ed4:

    # ELENA @ sad "They're starving... They only want some food, and they'll leave us alone."
    ELENA @ sad "Ils sont affamés... Ils veulent seulement un peu de nourriture, et ils nous laisseront tranquilles."

# game/data/travel_events/wolves.rpy:35
translate fr travel_event_wolves_5484d21a:

    # "Tossing the meat towards them, the wolves happily whined and barked as they chowed down."
    "En lançant la viande vers eux, les loups ont gémi et aboyé joyeusement tout en dévorant."

# game/data/travel_events/wolves.rpy:36
translate fr travel_event_wolves_a23af468:

    # "Satisfied with their meal, they sped off into the forests, their leader looking back to give one last bark of appreciation."
    "Satisfaits de leur repas, ils se sont enfoncés rapidement dans les forêts, leur chef se retournant pour donner un dernier aboiement de gratitude."

# game/data/travel_events/wolves.rpy:38
translate fr travel_event_wolves_058c8ebb:

    # ELENA @ smile "Looks like you've made a few new friends..."
    ELENA @ smile "On dirait que vous vous êtes fait quelques nouveaux amis..."

# game/data/travel_events/wolves.rpy:41
translate fr travel_event_wolves_937daf18:

    # "The wolves sadly whined... but then, once more, they began to snarl and bear their fangs."
    "Les loups ont gémi tristement... mais ensuite, une fois de plus, ils ont commencé à grogner et à montrer leurs crocs."

# game/data/travel_events/wolves.rpy:42
translate fr travel_event_wolves_3b747ef8:

    # ELENA "I don't think they're taking no for an answer!"
    ELENA "Je ne pense pas qu'ils acceptent un refus !"

# game/data/travel_events/wolves.rpy:48
translate fr travel_event_wolves_f567ab41_1:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Alors que le dernier des loups poussait un cri de douleur angoissée, j'ai rapidement mis fin à ses souffrances."

# game/data/travel_events/wolves.rpy:49
translate fr travel_event_wolves_a4f1e169_1:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Soupir*{/i}"

# game/data/travel_events/wolves.rpy:50
translate fr travel_event_wolves_579541dd:

    # MC "(Well, that could have gone better.)"
    MC "(Eh bien, ça aurait pu mieux se passer.)"

