    # "Adara paused sheepishly, her hands clasping at her dress tightly."
    "Adara fit une pause timidement, serrant fortement sa robe."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:151
translate fr ev_KrishanaDay_regina_dialogue_menu_7a497736:

    # ADARA @ shame "I was wondering if perhaps maybe we c-could..."
    ADARA @ shame "Je me demandais si peut-être nous p-pourrions..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:152
translate fr ev_KrishanaDay_regina_dialogue_menu_54779c02:

    # ADARA @ joy "G-Go for a walk?"
    ADARA @ joy "A-Aller faire une promenade ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:154
translate fr ev_KrishanaDay_regina_dialogue_menu_7c3775eb:

    # MC @ lewd "Where shall we head to?"
    MC @ lewd "Vers où devrions-nous nous diriger ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:155
translate fr ev_KrishanaDay_regina_dialogue_menu_0abbaba0:

    # ADARA @ smile "There's quite a lot going on at the Market I'm told, perhaps we should head there?"
    ADARA @ smile "Il y a beaucoup d'animation au marché, à ce qu'on m'a dit, peut-être devrions-nous y aller ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:156
translate fr ev_KrishanaDay_regina_dialogue_menu_ce53fb2e:

    # MC @ smile2 "Alright, that sounds good to me."
    MC @ smile2 "D'accord, cela me convient."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:159
translate fr ev_KrishanaDay_regina_dialogue_menu_a3ef7502:

    # "The two of us made our way through the winding Novaras streets, the gentle snow falling onto the ground as children hurried through excitedly to meet their friends."
    "Nous nous sommes frayé un chemin à travers les rues sinueuses de Novaras, la neige douce tombant au sol tandis que les enfants se dépêchaient avec excitation pour retrouver leurs amis."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:165
translate fr ev_KrishanaDay_regina_dialogue_menu_042dbacd:

    # "At the Market, it was like a kind of festive carnival."
    "Au marché, c'était comme une sorte de carnaval festif."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:166
translate fr ev_KrishanaDay_regina_dialogue_menu_e76869d8:

    # "Merchants, roasted meat over open fires that filled the air with a sweet aroma, with small crowds gathering around eager for a taste."
    "Des marchands, de la viande rôtie sur des feux ouverts qui emplissait l'air d'un doux arôme, avec de petites foules se rassemblant autour, avides de goûter."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:167
translate fr ev_KrishanaDay_regina_dialogue_menu_c36b411f:

    # "Children hurried around, throwing snowballs at their friends, parents watched and chatted amongst themselves from afar."
    "Les enfants se dépêchaient tout autour, lançant des boules de neige à leurs amis, les parents regardaient et bavardaient entre eux de loin."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:168
translate fr ev_KrishanaDay_regina_dialogue_menu_be8b2752:

    # "One merchant with huge mead barrels opened, poured patrons small cups who huddled together and laughed to themselves merrily."
    "Un marchand avec d'énormes tonneaux d'hydromel ouverts en versa de petites tasses aux clients qui se blottissaient ensemble et riaient joyeusement entre eux."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:169
translate fr ev_KrishanaDay_regina_dialogue_menu_3d1b9cdc:

    # "For a brief moment in time, it was as though everyone forgot about the wars existence outside these city walls..."
    "Pendant un bref instant, c'était comme si tout le monde avait oublié l'existence de la guerre à l'extérieur de ces murs de la ville..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:170
translate fr ev_KrishanaDay_regina_dialogue_menu_da28cac1:

    # ADARA @ smile "Isn't it nice to see everyone out and so cheery?"
    ADARA @ smile "N'est-ce pas agréable de voir tout le monde dehors et si joyeux ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:171
translate fr ev_KrishanaDay_regina_dialogue_menu_684e7350:

    # MC @ think "The last time it was like this was when-"
    MC @ think "La dernière fois que c'était comme ça, c'était quand-"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:172
translate fr ev_KrishanaDay_regina_dialogue_menu_db480df9:

    # "I pushed the thought of the Terminus ceremony to the back of my mind."
    "Je repoussai la pensée de la cérémonie du Terminus au fond de mon esprit."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:173
translate fr ev_KrishanaDay_regina_dialogue_menu_1833ec0b:

    # "This was a happy time."
    "C'était un moment heureux."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:174
translate fr ev_KrishanaDay_regina_dialogue_menu_681613ed:

    # ADARA @ smile "Look at this place! Isn't it wonderful?"
    ADARA @ smile "Regarde cet endroit ! N'est-ce pas merveilleux ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:175
translate fr ev_KrishanaDay_regina_dialogue_menu_8c941941:

    # "I smiled as the children chasing each other with snowballs hurried out in front of us."
    "Je souris en voyant les enfants se poursuivre avec des boules de neige se précipiter devant nous."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:176
translate fr ev_KrishanaDay_regina_dialogue_menu_99be07bb:

    # MC @ smile2 "Yes, it's nice."
    MC @ smile2 "Oui, c'est agréable."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:177
translate fr ev_KrishanaDay_regina_dialogue_menu_149e2884:

    # ADARA @ joy "What should we do now?"
    ADARA @ joy "Que devrions-nous faire maintenant ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:181
translate fr ev_KrishanaDay_regina_dialogue_menu_664cc199:

    # "The time went by quickly as we had fun, it was always easy letting time drift by with Adara."
    "Le temps passa vite pendant que nous nous amusions, c'était toujours facile de laisser le temps filer avec Adara."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:183
translate fr ev_KrishanaDay_regina_dialogue_menu_c8fe2941:

    # MAD_PROPHET "GATHER! GATHER ALL!"
    MAD_PROPHET "RASSEMBLEZ-VOUS ! RASSEMBLEZ-VOUS TOUS !"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:189
translate fr ev_KrishanaDay_regina_dialogue_menu_397e2913:

    # ADARA @ shock "Isn't he cold wearing so little in this weather?"
    ADARA @ shock "N'a-t-il pas froid à porter si peu par ce temps ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:190
translate fr ev_KrishanaDay_regina_dialogue_menu_58374c5f:

    # MAD_PROPHET "Come and hear the tale of Krishana the ice dragon!"
    MAD_PROPHET "Venez entendre l'histoire de Krishana le dragon de glace !"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:191
translate fr ev_KrishanaDay_regina_dialogue_menu_5506bc64:

    # ADARA @ smile "What do you think? Wanna listen?"
    ADARA @ smile "Qu'en penses-tu ? Tu veux écouter ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:198
translate fr ev_KrishanaDay_regina_dialogue_menu_53aaa9a4:

    # "The two of us stepped closer and joined the growing crowd, mainly comprised of children but a few adults lingered."
    "Nous nous sommes approchés tous les deux et avons rejoint la foule grandissante, principalement composée d'enfants mais quelques adultes traînaient."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:199
translate fr ev_KrishanaDay_regina_dialogue_menu_8b9e7ec0:

    # MAD_PROPHET "And so we begin, centuries long past, Krishana, the great ice dragon, sat on her ice throne in the mountains of Angmurus!"
    MAD_PROPHET "Et ainsi nous commençons, il y a des siècles, Krishana, le grand dragon de glace, trônait sur son trône de glace dans les montagnes d'Angmurus !"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:200
translate fr ev_KrishanaDay_regina_dialogue_menu_7a95d963:

    # MAD_PROPHET "{i}Bored!{/i}"
    MAD_PROPHET "{i}Je m'ennuie !{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:201
translate fr ev_KrishanaDay_regina_dialogue_menu_e98b016a:

    # "The crowd laughed a little."
    "La foule rit un peu."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:202
translate fr ev_KrishanaDay_regina_dialogue_menu_b6989b01:

    # MAD_PROPHET "{i}'I know!'{/i} Thought the mighty dragon, {i}'I shall see what the humans down south are up to!'{/i}"
    MAD_PROPHET "{i}'Je sais !'{/i} pensa le puissant dragon, {i}'Je vais voir ce que les humains du sud fabriquent !'{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:203
translate fr ev_KrishanaDay_regina_dialogue_menu_e6c8eed8:

    # MAD_PROPHET "As her mighty wings soared, she headed down south, perching herself up on a small mountain, watching the villagers down below!"
    MAD_PROPHET "As her mighty wings soared, she headed down south, perching herself up on a small mountain, watching the villagers down below!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:204
translate fr ev_KrishanaDay_regina_dialogue_menu_5452de45:

    # MAD_PROPHET "The people revered but feared the mighty dragons! And each parent warned the children not to approach the great Krishana!"
    MAD_PROPHET "The people revered but feared the mighty dragons! And each parent warned the children not to approach the great Krishana!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:205
translate fr ev_KrishanaDay_regina_dialogue_menu_bf4a2f15:

    # MAD_PROPHET "Some young children, brave and adventurous, ignoring their parents advice, scaled the small mountain and approached the dragoness!"
    MAD_PROPHET "Some young children, brave and adventurous, ignoring their parents advice, scaled the small mountain and approached the dragoness!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:206
translate fr ev_KrishanaDay_regina_dialogue_menu_7e9a0589:

    # MAD_PROPHET "{i}'But what brings you small humans here?'{/i} The dragoness asked!"
    MAD_PROPHET "{i}'But what brings you small humans here?'{/i} The dragoness asked!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:207
translate fr ev_KrishanaDay_regina_dialogue_menu_aa79a142:

    # MAD_PROPHET "{i}'Oh great Krishana! It has not snowed in these lands for so long! Can you not make it so?{/i}"
    MAD_PROPHET "{i}'Oh great Krishana! It has not snowed in these lands for so long! Can you not make it so?{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:208
translate fr ev_KrishanaDay_regina_dialogue_menu_5fa83f8d:

    # MAD_PROPHET "The dragon laughed, and laughed and laughed!"
    MAD_PROPHET "The dragon laughed, and laughed and laughed!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:209
translate fr ev_KrishanaDay_regina_dialogue_menu_7ecbd013:

    # MAD_PROPHET "{i}But what in return shall thy give thee?{/i} The dragoness asked."
    MAD_PROPHET "{i}But what in return shall thy give thee?{/i} The dragoness asked."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:210
translate fr ev_KrishanaDay_regina_dialogue_menu_1a3da702:

    # MAD_PROPHET "{i}For my hordes of gold are vast, and I never suffer hunger long!{/i}"
    MAD_PROPHET "{i}For my hordes of gold are vast, and I never suffer hunger long!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:211
translate fr ev_KrishanaDay_regina_dialogue_menu_ef09375e:

    # MAD_PROPHET "{i}What could you possibly have to offer me?{/i}"
    MAD_PROPHET "{i}What could you possibly have to offer me?{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:212
translate fr ev_KrishanaDay_regina_dialogue_menu_8f1a64cc:

    # MAD_PROPHET "The children looked amongst themselves for a moment, till one stepped forward and offered the great Krishana a small stone."
    MAD_PROPHET "The children looked amongst themselves for a moment, till one stepped forward and offered the great Krishana a small stone."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:213
translate fr ev_KrishanaDay_regina_dialogue_menu_70d2ab96:

    # MAD_PROPHET "{i}But what is this?{/i} The dragoness asked."
    MAD_PROPHET "{i}Mais qu'est-ce que c'est ?{/i} demanda la dragonne."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:214
translate fr ev_KrishanaDay_regina_dialogue_menu_d33e7b2d:

    # MAD_PROPHET "{i}It is a waystone!{/i} the child answered!"
    MAD_PROPHET "{i}C'est une pierre de chemin !{/i} répondit l'enfant !"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:215
translate fr ev_KrishanaDay_regina_dialogue_menu_60db9f86:

    # MAD_PROPHET "{i}So no matter where you fly, you will always be able to find your way home here!{/i}"
    MAD_PROPHET "{i}Ainsi, où que tu voles, tu pourras toujours retrouver le chemin de ta maison ici !{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:216
translate fr ev_KrishanaDay_regina_dialogue_menu_9e7dd2b0:

    # MAD_PROPHET "Krishana took the small gift, and boomed, {i}'HOME? HERE? FOR ME?'{/i}"
    MAD_PROPHET "Krishana prit le petit cadeau, et rugit : {i}'MAISON ? ICI ? POUR MOI ?'{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:217
translate fr ev_KrishanaDay_regina_dialogue_menu_0229275b:

    # MAD_PROPHET "The dragoness, so touched by the gift, said with a cool blow of air, {i}I've never had a home before.{/i}"
    MAD_PROPHET "La dragonne, si touchée par le cadeau, dit dans un souffle d'air frais : {i}Je n'ai jamais eu de maison auparavant.{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:218
translate fr ev_KrishanaDay_regina_dialogue_menu_2bb02a72:

    # MAD_PROPHET "Before the children could answer, the mighty Kirshana unleashed her icy breath into the sky, and the children celebrated as the snow fell down!"
    MAD_PROPHET "Avant que les enfants ne puissent répondre, la puissante Kirshana libéra son souffle glacé dans le ciel, et les enfants célébrèrent alors que la neige tombait !"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:219
translate fr ev_KrishanaDay_regina_dialogue_menu_dda3abaf:

    # MAD_PROPHET "And so it was, Krishana returned every year to bring forth the snow in exchange for the children's gifts!"
    MAD_PROPHET "Et c'est ainsi que Krishana revenait chaque année pour apporter la neige en échange des cadeaux des enfants !"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:220
translate fr ev_KrishanaDay_regina_dialogue_menu_9885251b:

    # MAD_PROPHET "And thus, that is why yearly we share gifts amongst loved ones and friends! To celebrate this most joyous of times!"
    MAD_PROPHET "Et ainsi, c'est pourquoi chaque année nous échangeons des cadeaux entre proches et amis ! Pour célébrer cette période des plus joyeuses !"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:221
translate fr ev_KrishanaDay_regina_dialogue_menu_c64f40ac:

    # "The crowd clapped and handed over some coins towards the man, who collected them in a small jar."
    "La foule applaudit et tendit quelques pièces à l'homme, qui les recueillit dans un petit bocal."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:226
translate fr ev_KrishanaDay_regina_dialogue_menu_29f9f809:

    # ADARA @ smile "Krishana was always one of my favorite stories growing up."
    ADARA @ smile "Krishana a toujours été l'une de mes histoires préférées dans mon enfance."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:227
translate fr ev_KrishanaDay_regina_dialogue_menu_51eae6f2:

    # ADARA @ smile "Isn't it nice to just hear a story not always about death and violence once in a while?"
    ADARA @ smile "N'est-ce pas agréable d'entendre une histoire qui ne parle pas toujours de mort et de violence de temps en temps ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:229
translate fr ev_KrishanaDay_regina_dialogue_menu_ed83f52f:

    # ADARA @ talk "Ah, okay then..."
    ADARA @ talk "Ah, d'accord alors..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:230
translate fr ev_KrishanaDay_regina_dialogue_menu_5ccedec9:

    # ADARA @ talk "It's getting quite late."
    ADARA @ talk "Il se fait assez tard."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:231
translate fr ev_KrishanaDay_regina_dialogue_menu_46b5b0ad:

    # ADARA @ shame "Do you mind walking me home?"
    ADARA @ shame "Ça te dérange de me raccompagner chez moi ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:232
translate fr ev_KrishanaDay_regina_dialogue_menu_0ca268ac:

    # MC @ lewd "Do you even need to ask that?"
    MC @ lewd "As-tu vraiment besoin de le demander ?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:233
