# game/data/world_interactions/black_diamond_arena/aio.rpy:38
translate fr black_diamond_arena_firstEnter_2471c171:

    # "As I stumbled down the flight of stairs, I heard the bellowing roar of cheers and something snarling down below."
    "Alors que je trébuchais dans l'escalier, j'entendis le rugissement tonitruant des acclamations et quelque chose qui grondait en bas."

# game/data/world_interactions/black_diamond_arena/aio.rpy:39
translate fr black_diamond_arena_firstEnter_1352313f:

    # "Coming upon a great darkened underground Arena, men gathered around and cheered as two reptilian beasts slashed and tore at each other in the fight pit below."
    "Arrivant dans une grande arène souterraine obscure, des hommes rassemblés autour acclamaient tandis que deux bêtes reptiliennes se lacéraient et se déchiraient dans la fosse de combat en contrebas."

# game/data/world_interactions/black_diamond_arena/aio.rpy:40
translate fr black_diamond_arena_firstEnter_8b799890:

    # "The one leapt and gripped the others throat with its teeth, ripping it out in a violent bloody display that the crowd roared with pleasure too."
    "L'une bondit et saisit la gorge de l'autre avec ses dents, l'arrachant dans un spectacle sanglant et violent qui fit rugir la foule de plaisir aussi."

# game/data/world_interactions/black_diamond_arena/aio.rpy:41
translate fr black_diamond_arena_firstEnter_b2c9c7fd:

    # MC "(What is this place?)"
    MC "(Qu'est-ce que c'est que cet endroit ?)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:45
translate fr black_diamond_arena_firstEnter_51fba3e4:

    # BOOKKEEPER "Oi!"
    BOOKKEEPER "Hé !"

# game/data/world_interactions/black_diamond_arena/aio.rpy:46
translate fr black_diamond_arena_firstEnter_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "Hein ?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:47
translate fr black_diamond_arena_firstEnter_557daccb:

    # BOOKKEEPER "Zer are no freeloaders! Either place a bet, or fuck off!"
    BOOKKEEPER "Il n'y a pas de profiteurs ! Soit tu places un pari, soit tu dégages !"

# game/data/world_interactions/black_diamond_arena/aio.rpy:48
translate fr black_diamond_arena_firstEnter_fc48861a:

    # MC @ talk "A bet?"
    MC @ talk "Un pari ?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:49
translate fr black_diamond_arena_firstEnter_6faeae54:

    # BOOKKEEPER "Iz stupid or something?"
    BOOKKEEPER "T'es stupide ou quoi ?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:56
translate fr black_diamond_bookkeeper_talk_2fb4960b:

    # BOOKKEEPER "No. You off limit. Come back in a few dayz."
    BOOKKEEPER "Non. C'est interdit pour toi. Reviens dans quelques jours."

# game/data/world_interactions/black_diamond_arena/aio.rpy:57
translate fr black_diamond_bookkeeper_talk_615eedc7:

    # MC "Okay."
    MC "D'accord."

# game/data/world_interactions/black_diamond_arena/aio.rpy:59
translate fr black_diamond_bookkeeper_talk_73727c63:

    # BOOKKEEPER "Beasts fight below, you bet."
    BOOKKEEPER "Les bêtes combattent en bas, vous pariez."

# game/data/world_interactions/black_diamond_arena/aio.rpy:60
translate fr black_diamond_bookkeeper_talk_376ff848:

    # BOOKKEEPER "Your beast wins, you get coin."
    BOOKKEEPER "Votre bête gagne, vous recevez des pièces."

# game/data/world_interactions/black_diamond_arena/aio.rpy:61
translate fr black_diamond_bookkeeper_talk_cba48cb5:

    # BOOKKEEPER "Zat's it, you want bet?"
    BOOKKEEPER "C'est ça, vous voulez parier ?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:64
translate fr black_diamond_bookkeeper_talk_menu_26b1e50b:

    # BOOKKEEPER "How much?"
    BOOKKEEPER "Combien ?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:76
translate fr black_diamond_bookkeeper_talk_menu_8a0c5ec4:

    # BOOKKEEPER "Very good!"
    BOOKKEEPER "Très bien !"

# game/data/world_interactions/black_diamond_arena/aio.rpy:77
translate fr black_diamond_bookkeeper_talk_menu_83429a1e:

    # BOOKKEEPER "Enjoy fight! Collect coin after if win!"
    BOOKKEEPER "Profitez du combat ! Récupérez vos pièces après si vous gagnez !"

# game/data/world_interactions/black_diamond_arena/aio.rpy:80
translate fr black_diamond_bookkeeper_talk_menu_577c9037:

    # BOOKKEEPER "Rules iz simple!"
    BOOKKEEPER "Les règles sont simples !"

# game/data/world_interactions/black_diamond_arena/aio.rpy:81
translate fr black_diamond_bookkeeper_talk_menu_824d265f:

    # BOOKKEEPER "You bet on either creature to win, first to kill zer other wins."
    BOOKKEEPER "Vous pariez sur l'une ou l'autre créature pour gagner, la première à tuer l'autre l'emporte."

# game/data/world_interactions/black_diamond_arena/aio.rpy:82
translate fr black_diamond_bookkeeper_talk_menu_ba9aaef0:

    # BOOKKEEPER "Az newbie, you iz only able to bet one thousand coins a week."
    BOOKKEEPER "En tant que débutant, vous ne pouvez parier que mille pièces par semaine."

# game/data/world_interactions/black_diamond_arena/aio.rpy:83
translate fr black_diamond_bookkeeper_talk_menu_ec70c2c2:

    # BOOKKEEPER "Coin pay upfront before bet go on."
    BOOKKEEPER "Pièce payée d'avance avant le pari."

# game/data/world_interactions/black_diamond_arena/aio.rpy:84
translate fr black_diamond_bookkeeper_talk_menu_b6289d56:

    # MC @ talk "That seems odd, why the limit?"
    MC @ talk "Cela semble étrange, pourquoi cette limite ?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:85
translate fr black_diamond_bookkeeper_talk_menu_40d9f557:

    # BOOKKEEPER "Too many try cheat."
    BOOKKEEPER "Trop de gens essaient de tricher."

# game/data/world_interactions/black_diamond_arena/aio.rpy:86
translate fr black_diamond_bookkeeper_talk_menu_2ade3781:

    # BOOKKEEPER "One try poisoning a beasty and placing huge bet on other."
    BOOKKEEPER "L'un a essayé d'empoisonner une bestiole et de miser gros sur l'autre."

# game/data/world_interactions/black_diamond_arena/aio.rpy:87
translate fr black_diamond_bookkeeper_talk_menu_f8b9be59:

    # BOOKKEEPER "Now, only trusted members can make big bets."
    BOOKKEEPER "Maintenant, seuls les membres de confiance peuvent faire de gros paris."

# game/data/world_interactions/black_diamond_arena/aio.rpy:90
translate fr black_diamond_bookkeeper_talk_menu_b72566e1:

    # BOOKKEEPER "Than leave already!"
    BOOKKEEPER "Alors, pars donc !"

# game/data/world_interactions/black_diamond_arena/aio.rpy:108
translate fr black_diamond_arena_fight_349520bc:

    # MC "(Damn... I lost.)"
    MC "(Merde... J'ai perdu.)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:110
translate fr black_diamond_arena_fight_3b26aa88:

    # MC "(Well... That's wasn't the easiest thing to watch.)"
    MC "(Eh bien... Ce n'était pas la chose la plus facile à regarder.)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:111
translate fr black_diamond_arena_fight_e66f7113:

    # MC "(Looks like I won though!)"
    MC "(On dirait que j'ai gagné, quand même !)"

