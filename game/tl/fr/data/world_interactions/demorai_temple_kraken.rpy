# game/data/world_interactions/demorai_temple_kraken.rpy:11
translate fr world_clickable_temple_kraken_5c07169a:

    # "Peering into the depths of the stagnant water over the edges of the erected stone pathways gave me an uneasy feeling."
    "En scrutant les profondeurs de l'eau stagnante par-dessus les rebords des chemins de pierre érigés, je ressentis un malaise."

# game/data/world_interactions/demorai_temple_kraken.rpy:12
translate fr world_clickable_temple_kraken_75e29588:

    # "I could not see what was down there, but I could sense movement beneath that blackened water all the same."
    "Je ne pouvais pas voir ce qui se trouvait en bas, mais je sentais quand même un mouvement sous cette eau noircie."

# game/data/world_interactions/demorai_temple_kraken.rpy:13
translate fr world_clickable_temple_kraken_16c00e6b:

    # "Just how deep did these waters run?"
    "Quelle était la profondeur de ces eaux ?"

# game/data/world_interactions/demorai_temple_kraken.rpy:16
translate fr world_clickable_temple_kraken_af42c0e5:

    # "Placing my hand into the water, the ripples once again waved across the still waters."
    "En plongeant ma main dans l'eau, les ondulations se propagèrent à nouveau à travers l'eau calme."

# game/data/world_interactions/demorai_temple_kraken.rpy:20
translate fr world_clickable_temple_kraken_fc27693d:

    # "This time though, bursting out of the waters came a fury of tentacles thrashing wildly!"
    "Cette fois, pourtant, une furie de tentacules jaillit des eaux en se débattant sauvagement !"

# game/data/world_interactions/demorai_temple_kraken.rpy:21
translate fr world_clickable_temple_kraken_a70c5cab:

    # MC "(FUCK!)"
    MC "(PUTAIN !)"

# game/data/world_interactions/demorai_temple_kraken.rpy:23
translate fr world_clickable_temple_kraken_25516f50:

    # "I transformed, preparing myself for battle."
    "Je me transformai, me préparant au combat."

# game/data/world_interactions/demorai_temple_kraken.rpy:30
translate fr world_clickable_temple_kraken_4f11fb8d:

    # "After slashing and tearing off one of the beasts' tentacles that dropped down into the waters, the beast howled in rage as it quickly retreated and submerged itself back into the black depths from where it came."
    "Après avoir tranché et arraché un tentacule de la bête qui tomba dans les eaux, la bête hurla de rage avant de reculer rapidement et de se replonger dans les profondeurs noires d'où elle venait."

# game/data/world_interactions/demorai_temple_kraken.rpy:33
translate fr world_clickable_temple_kraken_ee79b738:

    # MC "{i}...How the hell does that thing even live down here?{/i}"
    MC "{i}...Comment diable cette chose peut-elle vivre ici en bas ?{/i}"

# game/data/world_interactions/demorai_temple_kraken.rpy:34
translate fr world_clickable_temple_kraken_4e2751cc:

    # "I noticed on the floor, some strange shimmering gem that wasn't there before."
    "Je remarquai sur le sol une étrange gemme chatoyante qui n'était pas là avant."

# game/data/world_interactions/demorai_temple_kraken.rpy:37
translate fr world_clickable_temple_kraken_80e8c4f0:

    # MC "(Huh? What is this thing?)"
    MC "(Hein ? Qu'est-ce que c'est que cette chose ?)"

# game/data/world_interactions/demorai_temple_kraken.rpy:41
translate fr world_clickable_temple_kraken_7770dba9:

    # "Deciding it was probably not a good idea to continue messing with the water, I stepped back."
    "Décidant que ce n'était probablement pas une bonne idée de continuer à tripoter l'eau, j'ai reculé."

# game/data/world_interactions/demorai_temple_kraken.rpy:42
translate fr world_clickable_temple_kraken_24488d99:

    # MC "(Whatever's in there isn't going to appreciate me splashing around.)"
    MC "(Quoi que ce soit qui se cache là-dedans, ça ne va pas apprécier que je barbote.)"

