translate fr qst_JudgementDay_SiegeOverPrison_53a8addf:

    # "And then, at last…"
    "Et puis, enfin…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2152
translate fr qst_JudgementDay_SiegeOverPrison_a66ed92c:

    # "Something changed."
    "Quelque chose a changé."

