    ALYSHA "Je... Je ne suis pas aussi douée avec celle-ci !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:392
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_ed11addb:

    # ALYSHA "Oh gods... My hand!"
    ALYSHA "Oh dieux... Ma main !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:394
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_a726a26c:

