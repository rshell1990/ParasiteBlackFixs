translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_3409f6e4:

    # ALYSHA "Why do I feel like we've met before?"
    ALYSHA "Pourquoi ai-je l'impression que nous nous sommes déjà rencontrés ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:408
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_8d3168fc:

    # MC "...Go. Now!"
    MC "...Allez-y. Maintenant !"

