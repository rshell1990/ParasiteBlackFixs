    HIRRAH "Pendant que nous trouvons et arrêtons Gimera, nous devons travailler ensemble !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3747
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_e91157ba:

    # HIRRAH "No matter the cost..."
    HIRRAH "Quel qu'en soit le prix..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3748
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_644eb481:

    # HIRRAH "{i}Malakai can never be allowed to walk the physical planes once more.{/i}"
    HIRRAH "{i}Il ne faut jamais permettre à Malakai de marcher à nouveau sur les plans physiques.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3751
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_8e7bf52d:

    # PHOAH @ talk "Malakai destroyed everything we had built."
    PHOAH @ talk "Malakai a détruit tout ce que nous avions construit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3752
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2b4ac252:

    # PHOAH @ talk "All our hopes and dreams, everything Arda spent countless millenia working to achieve."
    PHOAH @ talk "Tous nos espoirs et nos rêves, tout ce qu'Arda a passé d'innombrables millénaires à accomplir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3753
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2c206515:

    # PHOAH @ talk "{i}The gateways to unite the realms, the unity of the old gods and new...{/i}"
    PHOAH @ talk "{i}Les portails pour unir les royaumes, l'unité des anciens dieux et des nouveaux...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3754
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_0eb52d5f:

    # PHOAH @ talk "All of it was undone by Malakai in his quest to re-forge reality in his image."
    PHOAH @ talk "Tout cela a été défait par Malakai dans sa quête pour refaçonner la réalité à son image."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3755
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_782b7b35:

    # "Phoah paused for a moment, the rage slightly softening as she seemed to be thinking back to those dark days."
    "Phoah s'arrêta un instant, la rage s'adoucissant légèrement comme si elle repensait à ces jours sombres."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3756
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2e97c5dc:

    # PHOAH @ sad "{i}... It wasn't always so though.{/i}"
    PHOAH @ sad "{i}... Mais ça n'a pas toujours été ainsi.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3757
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2dc1e7da:

    # PHOAH @ sad "Before that monster, Gimera decieved him into opening the {i}Macarum,{/i} Malakai went by a different name."
    PHOAH @ sad "Avant que ce monstre, Gimera, ne le trompe pour qu'il ouvre le {i}Macarum,{/i} Malakai portait un autre nom."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3758
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_b127e26a:

    # PHOAH @ sad "Malayan the curious."
    PHOAH @ sad "Malayan le curieux."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3759
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2a09741c:

    # MC "The Macarum?"
    MC "Le Macarum ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3760
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_cbdac6af:

    # PHOAH @ talk "{i}When Arda was born, he was a made a being of pure good, pure love.{/i}"
    PHOAH @ talk "{i}Quand Arda est née, elle a été créée comme un être de pure bonté, de pur amour.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3761
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_f3b5dcfb:

    # PHOAH @ talk "... But in order to become that, he cast off his darkness... sealed it away into a forbidden box beyond the knowledge and reach of even the gods."
    PHOAH @ talk "... Mais pour y parvenir, il s'est débarrassé de ses ténèbres... les a scellées dans une boîte interdite, hors de la connaissance et de la portée même des dieux."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3762
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_062aedaa:

    # PHOAH @ angry "Guided by terrible visions of an impending war between the old gods and the new, Gimera decieved Malayan that only the power of the box could prevent the war."
    PHOAH @ angry "Guidée par de terribles visions d'une guerre imminente entre les anciens dieux et les nouveaux, Gimera a trompé Malayan en lui faisant croire que seul le pouvoir de la boîte pourrait empêcher la guerre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3763
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_c432b0f4:

    # PHOAH @ sad "Little did Malayan know by opening it, the visions he fought to stop would come true."
    PHOAH @ sad "Malayan ne savait pas qu'en l'ouvrant, les visions qu'il cherchait à empêcher se réaliseraient."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3767
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_36b03c3f:

    # "Hirrah let out a sharp chuckle."
    "Hirrah laissa échapper un rire sec."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3768
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_cd066754:

    # HIRRAH "And who is supposed to answer?"
    HIRRAH "Et qui est censé répondre ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3769
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_5abe17b2:

    # PHOAH @ angry "Hirrah!"
    PHOAH @ angry "Hirrah!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3770
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_418142c0:

    # HIRRAH "Do not coddle the human... Letting him put his faith in what can never answer will lead him down a path of destruction."
    HIRRAH "Ne dorlote pas l'humain... Le laisser mettre sa foi dans ce qui ne pourra jamais répondre le mènera sur un chemin de destruction."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3771
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7208330b:

    # MC "{i}The... The gods no longer heard us?{/i}"
    MC "{i}Les... Les dieux ne nous entendaient plus ?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3772
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_88785898:

    # PHOAH @ talk "After the war, so few of us remain, even now."
    PHOAH @ talk "Après la guerre, si peu d'entre nous restent, même maintenant."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3773
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_ac5cf9c8:

    # PHOAH @ sad "So many died... Yhoshan... Taruna... Palam."
    PHOAH @ sad "Tant sont morts... Yhoshan... Taruna... Palam."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3774
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_59eb52b3:

    # HIRRAH "Once, during Arda's reign, thousands of us roamed the stars."
    HIRRAH "Autrefois, sous le règne d'Arda, des milliers d'entre nous parcouraient les étoiles."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3775
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_91cef8f1:

    # HIRRAH "Now, perhaps only a few hundred remain... {i}if that.{/i}"
    HIRRAH "Maintenant, il n'en reste peut-être que quelques centaines... {i}si ce n'est moins.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3776
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7cc2b286:

