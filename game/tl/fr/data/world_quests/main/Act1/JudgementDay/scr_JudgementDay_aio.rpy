    GUARD "Quelle est votre affaire dans la ville libre ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3536
translate fr qst_JudgementDay_PostQuestArrivedToHamun_04843039:

