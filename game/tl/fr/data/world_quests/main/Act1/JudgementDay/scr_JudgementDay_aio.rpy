    # MAD_PROPHET "SEVERAL MOONS AGO, A PALE GOD CAME TO VISIT ME IN THE FLESH WITH HIS DISCIPLES!"
    MAD_PROPHET "IL Y A PLUSIEURS LUNES, UN DIEU PÂLE EST VENU ME RENDRE VISITE EN CHAIR ET EN OS AVEC SES DISCIPLES !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:132
translate fr qst_JudgementDay_SiegeStart_8ab261c3:

    # MAD_PROPHET "HE PROMISED THAT THE GREAT NEWHEART REBORN WOULD REVEAL HIMSELF TO US ONCE WE HAD GATHERED HERE!"
    MAD_PROPHET "IL A PROMIS QUE LE GRAND NEWHEART RENAÎTRAIT ET SE RÉVÉLERAIT À NOUS UNE FOIS QUE NOUS SERIONS RASSEMBLÉS ICI !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:133
