    DIVINE @ shock "MAIS—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3022
translate fr qst_JudgementDay_TrialStart_SummonMenu_f5658d09:

    # "The gavel came crashing down."
    "Le marteau s'abattit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3023
translate fr qst_JudgementDay_TrialStart_SummonMenu_56925272:

    # JUDGE_FALWIND "I am sorry, Sister Divine, but I must strip your testimony from the trial."
    JUDGE_FALWIND "Je suis désolé, Sœur Divine, mais je dois retirer votre témoignage du procès."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3024
translate fr qst_JudgementDay_TrialStart_SummonMenu_55ff70ff:

    # JUDGE_FALWIND "And further condemn the wickedness of the defendant for his most cruel seduction!"
    JUDGE_FALWIND "Et condamner davantage la méchanceté de l'accusé pour sa séduction la plus cruelle !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3026
