    # "Alysha hesitated but grabbed her blade from the ground and hurried to safety."
    "Alysha hésita mais attrapa sa lame du sol et se hâta vers la sécurité."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:415
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_fd5ddad7:

    # MC "(That girl... When did she join the city guard?)"
    MC "(Cette fille... Quand a-t-elle rejoint la garde de la ville ?)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:416
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_318900c3:

    # MC "(No time to think on it now, I must keep moving!)"
    MC "(Pas le temps d'y penser maintenant, je dois continuer d'avancer !)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:425
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_3482f3d7:

    # "As the creature's claws slashed across Shani's throat, a spray of crimson painted the ground."
    "Alors que les griffes de la créature lacéraient la gorge de Shani, une gerbe de pourpre teinta le sol."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:427
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_365e8b00:

    # "As the creature's claws slashed across the woman's throat, a spray of crimson painted the ground."
    "Alors que les griffes de la créature lacéraient la gorge de la femme, une gerbe de pourpre teinta le sol."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:430
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_abe6913c:

    # "Her eyes went wide, hands trembling as they clutched at the open wound, desperate to keep the life from pouring out."
    "Ses yeux s'écarquillèrent, ses mains tremblantes agrippèrent la plaie ouverte, désespérée d'empêcher la vie de s'écouler."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:431
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_9bd17461:

    # "She choked, spasmed, convulsed in agony."
    "Elle suffoqua, fut prise de spasmes et de convulsions de douleur."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:434
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_0af86e7b:

    # MC "SHANI!"
    MC "SHANI !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:435
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_6a7b4d1b:

    # "Before I could reach her, the circling skinwalkers pounced on me!"
    "Avant que je ne puisse l'atteindre, les skinwalkers qui tournoyaient me bondirent dessus !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:455
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_510dc8bf:

    # "As the last of them collapsed into a heap of blood and gore, I turned my gaze back toward Shani."
    "Alors que le dernier d'entre eux s'effondra en un tas de sang et de viscères, je reportai mon regard sur Shani."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:457
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_0e103a3e:

    # "As the last of them collapsed into a heap of blood and gore, I turned my gaze back towards the woman."
    "Alors que le dernier d'entre eux s'effondrait en un tas de sang et de chair, je tournai mon regard vers la femme."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:460
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_acc298a9:

    # "There, hunched over her lifeless body, that thing gnawed at her flesh."
    "Là, penché sur son corps sans vie, cette chose rongeait sa chair."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:467
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_33bf49c2:

    # "Enraged, I lunged forward with a guttural snarl, my blade flashing as I took the thing's head clean off."
    "Furieux, je me jetai en avant avec un grognement guttural, ma lame scintillant alors que je décapitais la chose d'un coup net."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:472
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_706d8b85:

    # "The lifeless body slumped to the floor, and I stared at the silent, bloody mess that had once been Shani."
    "Le corps sans vie s'affaissa au sol, et je fixai le désordre silencieux et sanglant qui avait été Shani."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:474
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_d5041a8b:

    # MC "(These bastards are going to pay for what they've done!)"
    MC "(Ces salauds vont payer pour ce qu'ils ont fait !)"

