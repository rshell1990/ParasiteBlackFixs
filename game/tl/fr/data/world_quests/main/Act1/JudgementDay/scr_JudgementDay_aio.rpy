    MC "Concentre-toi !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:395
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_07fbe675:

    # MC "The other guards! Where are they?"
    MC "Les autres gardes ! Où sont-ils ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:396
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_721b6601:

    # ALYSHA "They... We were ambushed near the academies!"
    ALYSHA "Ils... Nous avons été pris en embuscade près des académies !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:397
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_9e2d19b8:

    # ALYSHA "I barely made it out alive!"
    ALYSHA "Je m'en suis à peine sorti vivant !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:398
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_2079670d:

    # MC "The rest of your men?"
    MC "Et le reste de vos hommes ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:399
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_417ab288:

    # ALYSHA "Scattered... Some retreated and fled to join the others at the farmlands district!"
    ALYSHA "Dispersés... Certains se sont repliés et ont fui pour rejoindre les autres dans le district des terres agricoles !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:400
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_82980fa5:

    # ALYSHA "The students living in the halls... they were running for their lives!"
    ALYSHA "Les étudiants qui vivaient dans les résidences... ils couraient pour sauver leur vie !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:401
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_f1b613bb:

    # MC "Head toward the castle."
    MC "Dirigez-vous vers le château."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:402
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_05011636:

    # MC "The guards have managed to hold the line on the bridge!"
    MC "Les gardes ont réussi à tenir la ligne sur le pont !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:404
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_ae888f4a:

    # ALYSHA "W-Wait!"
    ALYSHA "A-Attendez !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:405
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_54ba7684:

    # ALYSHA "...W-What are you?"
    ALYSHA "...Q-Qu'est-ce que vous êtes ?"

