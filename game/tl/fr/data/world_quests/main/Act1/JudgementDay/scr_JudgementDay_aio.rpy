translate fr qst_JudgementDay_GoToEduDistrict_7b90c7be:

    # MC "GET BACK!"
    MC "RECULEZ !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:571
translate fr qst_JudgementDay_GoToEduDistrict_a4346c4e:

    # "Vala, frozen between awe and terror, stumbled back as I lunged forward, my claws at the ready."
    "Vala, figée entre admiration et terreur, recula en titubant alors que je me précipitais en avant, mes griffes prêtes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:589
