translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_a7e0d8f5:

    # HIRRAH "Serve as our champion."
    HIRRAH "Sois notre champion."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3746
translate fr qst_JudgementDay_PostQuestArrivedToHamun_Dream_4f4136b8:

