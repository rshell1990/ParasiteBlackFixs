# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3534
translate fr qst_JudgementDay_PostQuestArrivedToHamun_7b096b57:

    # GUARD "HALT!"
    GUARD "HALTE !"

