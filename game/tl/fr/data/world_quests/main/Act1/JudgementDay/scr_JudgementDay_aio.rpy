    # "They simply came, delivered bowls of food, and left in silence, leaving me to wait."
    "Ils venaient simplement, déposaient des bols de nourriture, et repartaient en silence, me laissant attendre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2130
translate fr qst_JudgementDay_SiegeOverPrison_f7c2f1a3:

    # "And wait."
    "Et attendre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2132
translate fr qst_JudgementDay_SiegeOverPrison_f7c2f1a3_1:

    # "And wait."
    "Et attendre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2134
translate fr qst_JudgementDay_SiegeOverPrison_5344897f:

    # "Each passing moment, my body betrayed me further."
    "À chaque instant qui passait, mon corps me trahissait davantage."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2136
translate fr qst_JudgementDay_SiegeOverPrison_6e40bbe3:

    # BLACK "(We must find a mate soon...)"
    BLACK "(Nous devons trouver un compagnon rapidement...)"

