translate fr qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_659b07b0:

    # GUARD "Some people come here and think because we've no laws they can just do {i}whatever{/i} they like."
    GUARD "Certaines personnes viennent ici et pensent que parce qu'il n'y a pas de lois, elles peuvent faire {i}tout ce qui leur plaît{/i}."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3552
translate fr qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_2750a12b:

    # GUARD "It's best to let them know that would be a poor choice."
    GUARD "Il vaut mieux leur faire savoir que ce serait un mauvais choix."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3555
