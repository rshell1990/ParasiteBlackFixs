# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:533
translate fr qst_JudgementDay_GoToEduDistrict_157cdcb6:

    # "The city continued to burn around me as panicked citizens fled for their lives."
    "La ville continuait de brûler autour de moi tandis que les citoyens paniqués fuyaient pour sauver leur vie."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:534
translate fr qst_JudgementDay_GoToEduDistrict_321771d9:

    # "Screams echoed from the streets as people were torn apart—limbs ripped from their sockets, throats gnashed by unrelenting teeth."
    "Des cris résonnaient dans les rues tandis que les gens se faisaient déchiqueter—des membres arrachés de leurs articulations, des gorges broyées par des dents impitoyables."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:535
translate fr qst_JudgementDay_GoToEduDistrict_cd379b6f:

    # "A voice called out amidst the chaos, and my eyes darted toward the library."
    "Une voix s'éleva dans le chaos, et mes yeux se précipitèrent vers la bibliothèque."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:537
translate fr qst_JudgementDay_GoToEduDistrict_954af888:

    # "Vala, the librarian, stood at the entrance, motioning desperately for people to hurry inside."
    "Vala, la bibliothécaire, se tenait à l'entrée, faisant désespérément signe aux gens de se dépêcher d'entrer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:539
translate fr qst_JudgementDay_GoToEduDistrict_1cd70164:

    # VALA @ scared "IN HERE! QUICKLY!"
    VALA @ scared "PAR ICI ! VITE !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:544
translate fr qst_JudgementDay_GoToEduDistrict_e700f071:

    # "A few scattered survivors rushed past her into the supposed safety of the library's thick walls."
    "Quelques survivants épars se ruèrent à côté d'elle vers la sécurité supposée des murs épais de la bibliothèque."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:549
translate fr qst_JudgementDay_GoToEduDistrict_55b2c21b:

    # "But in doing so, they caught the attention of a pack of ghoulish creatures that lurched toward Vala, their eyes gleaming with hunger."
    "Mais ce faisant, ils attirèrent l'attention d'une meute de créatures macabres qui titubaient vers Vala, leurs yeux brillant de faim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:554
translate fr qst_JudgementDay_GoToEduDistrict_a0709472:

    # VALA @ scared "A-Ahhh!"
    VALA @ scared "A-Ahhh !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:555
translate fr qst_JudgementDay_GoToEduDistrict_cb6cd8b4:

    # "Frantically, she tried to pull the heavy doors shut, but they refused to budge."
    "Frénétiquement, elle tenta de tirer les lourdes portes pour les fermer, mais elles refusaient de bouger."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:557
translate fr qst_JudgementDay_GoToEduDistrict_ba9e7083:

