    MARION @ smile "Votre Honneur, je demande formellement que le témoignage de Sœur Divine soit retiré du dossier."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3012
translate fr qst_JudgementDay_TrialStart_SummonMenu_b7017868:

    # DIVINE @ angry "WILL I BE ALLOWED TO SPEAK FOR MYSELF?"
    DIVINE @ angry "ME SERA-T-IL PERMIS DE PARLER POUR MOI-MÊME ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3013
