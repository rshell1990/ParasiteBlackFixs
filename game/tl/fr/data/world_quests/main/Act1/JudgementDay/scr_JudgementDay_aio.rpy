translate fr qst_JudgementDay_GoToEduDistrict_1c09a025:

    # "As she struggled, the creatures inched closer, snarling, their claws poised to strike."
    "Alors qu'elle luttait, les créatures se rapprochaient lentement, grognant, leurs griffes prêtes à frapper."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:559
translate fr qst_JudgementDay_GoToEduDistrict_b1c5f6a7:

    # "Her eyes went wide with terror as she braced herself for death."
    "Ses yeux s'écarquillèrent de terreur alors qu'elle se préparait à la mort."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:561
translate fr qst_JudgementDay_GoToEduDistrict_85e4c954:

    # "And then—I was there."
    "Et puis—j'étais là."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:568
translate fr qst_JudgementDay_GoToEduDistrict_1284cfdd:

    # VALA @ shock "W-Wha...?"
    VALA @ shock "Q-Quoi... ?"

