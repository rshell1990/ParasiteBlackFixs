# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:390
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_dedcf196:

    # "Alysha nodded weakly."
    "Alysha hocha faiblement la tête."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:391
