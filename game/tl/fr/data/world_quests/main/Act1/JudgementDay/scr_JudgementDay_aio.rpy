translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_c4a7603d:

    # "The cell blurred before my eyes. My strength left me."
    "La cellule est devenue floue devant mes yeux. Mes forces m'ont abandonné."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2491
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_fc8bfd5a:

    # "The last thing I saw before the world faded to black... were [regina_ref!t]'s glowing, violet eyes watching me with something deeper than desire—"
    "La dernière chose que j'ai vue avant que le monde ne s'efface dans le noir... étaient les yeux violets et lumineux de [regina_ref!t] qui me regardaient avec quelque chose de plus profond que le désir—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2494
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_7af1c229:

    # "Something ancient."
    "Quelque chose d'ancien."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2497
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_8261940e:

    # "And then... darkness."
    "Et puis... l'obscurité."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2498
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_625d90bd:

    # REGINA "Wake up, Shyahtan."
    REGINA "Réveille-toi, Shyahtan."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2500
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_0208f99c:

    # REGINA "WAKE UP!"
    REGINA "RÉVEILLE-TOI !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2510
translate fr qst_JudgementDay_TrialStart_729f26f0:

    # "A sudden splash of cold water shocked my system, forcing a desperate gasp from my lips."
    "Une soudaine éclaboussure d'eau froide choqua mon corps, forçant un halètement désespéré à s'échapper de mes lèvres."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2514
translate fr qst_JudgementDay_TrialStart_00595328:

    # "I coughed, struggling for breath, my vision swimming as I slowly came to."
    "Je toussai, luttant pour respirer, ma vision floue alors que je reprenais lentement conscience."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2516
translate fr qst_JudgementDay_TrialStart_e7095267:

    # "As my surroundings became clearer, I saw them."
    "Alors que mon environnement devenait plus clair, je les vis."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2518
translate fr qst_JudgementDay_TrialStart_425895dc:

    # "Guards. Watching. Spears pointed."
    "Des gardes. Observant. Lances pointées."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2519
translate fr qst_JudgementDay_TrialStart_9e7c1a0d:

    # GUARD "Get up."
    GUARD "Lève-toi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2520
translate fr qst_JudgementDay_TrialStart_16394309:

    # GUARD "Your trial will begin shortly."
    GUARD "Ton procès va bientôt commencer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2522
translate fr qst_JudgementDay_TrialStart_8626a9cf:

    # "Before I even had the chance to rise, rough hands seized me."
    "Avant même que j'aie eu la chance de me lever, des mains rudes me saisirent."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2523
translate fr qst_JudgementDay_TrialStart_6ad143bd:

    # "Cold metal clamped around my wrists and ankles as I was bound in chains."
    "Un métal froid se referma autour de mes poignets et de mes chevilles tandis que j'étais attaché avec des chaînes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2529
translate fr qst_JudgementDay_TrialStart_1ebf7804:

    # "They dragged me from my cell, my feet barely able to find the ground as I was pulled through the winding halls."
    "Ils m'ont traîné hors de ma cellule, mes pieds peinant à trouver le sol tandis que j'étais tiré à travers les couloirs sinueux."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2530
translate fr qst_JudgementDay_TrialStart_c3a4dd44:

    # "At last, we stopped before great, heavy, ornate doors."
    "Enfin, nous nous sommes arrêtés devant de grandes portes lourdes et ornées."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2531
translate fr qst_JudgementDay_TrialStart_0f1cc5fe:

    # "They groaned open, revealing my fate."
    "Elles s'ouvrirent en grinçant, révélant mon destin."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2535
translate fr qst_JudgementDay_TrialStart_e1220ead:

    # "The courtroom."
    "La salle d'audience."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2536
translate fr qst_JudgementDay_TrialStart_fbb742c0:

    # "To my left, seated in perfect rows, were men in deep blue and purple robes, their faces obscured behind silver masks."
    "À ma gauche, assis en rangées parfaites, se trouvaient des hommes en robes bleu profond et violet, le visage dissimulé derrière des masques argentés."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2537
translate fr qst_JudgementDay_TrialStart_6c66f9f3:

    # "Above them, seated upon high stone podiums flanking two burning firepits, sat three more figures."
    "Au-dessus d'eux, assis sur de hauts podiums de pierre flanquant deux braseros ardents, se tenaient trois autres personnages."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2538
translate fr qst_JudgementDay_TrialStart_ca7194e9:

    # "Their robes were red, their masks gleaming."
    "Leurs robes étaient rouges, leurs masques étincelants."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2540
translate fr qst_JudgementDay_TrialStart_fa6810be:

    # "Shoved forward into the center of the chamber, I scanned the crowd for familiar faces."
    "Poussé en avant au centre de la chambre, j'ai scruté la foule à la recherche de visages familiers."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2541
translate fr qst_JudgementDay_TrialStart_258a0cfd:

    # "None."
    "Aucun."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2542
translate fr qst_JudgementDay_TrialStart_92747b53:

    # "Only more masked figures. Watching. Waiting."
    "Seulement d'autres personnages masqués. Observant. Attendant."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2543
translate fr qst_JudgementDay_TrialStart_2160188b:

    # GUARD "Judge Falwind. I present to you the prisoner."
    GUARD "Juge Falwind. Je vous présente le prisonnier."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2544
translate fr qst_JudgementDay_TrialStart_3002041b:

    # "The murmurs around the chamber quieted as all eyes turned to me."
    "Les murmures dans la salle se turent alors que tous les regards se tournaient vers moi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2545
translate fr qst_JudgementDay_TrialStart_72502109:

    # JUDGE_FALWIND "Good morning, prisoner nine-six-one."
    JUDGE_FALWIND "Bonjour, prisonnier neuf-six-un."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2546
translate fr qst_JudgementDay_TrialStart_c2cba07d:

    # JUDGE_FALWIND "Are you aware of the charges laid against you by Head Inquisitor Marion?"
    JUDGE_FALWIND "Êtes-vous au courant des accusations retenues contre vous par l’Inquisiteur en chef Marion ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2549
translate fr qst_JudgementDay_TrialStart_3c0000a5:

    # JUDGE_FALWIND "Good. Then you understand the seriousness of the matter."
    JUDGE_FALWIND "Bien. Alors vous comprenez la gravité de l’affaire."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2551
translate fr qst_JudgementDay_TrialStart_5b07853c:

    # JUDGE_FALWIND "That is for the court to decide, nine-six-one."
    JUDGE_FALWIND "C’est à la cour d’en décider, neuf-six-un."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2555
translate fr qst_JudgementDay_TrialStart_7c8f63d4:

    # "Angry murmurs erupted across the courtroom until Judge Falwind slammed his gavel down."
    "Des murmures de colère éclatèrent dans la salle d’audience jusqu’à ce que le juge Falwind abatte son marteau."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2558
translate fr qst_JudgementDay_TrialStart_53dd2759:

    # JUDGE_FALWIND "I will not tolerate such behavior in my courtroom. I suggest you rethink your actions immediately."
    JUDGE_FALWIND "Je ne tolérerai pas un tel comportement dans mon tribunal. Je vous suggère de reconsidérer immédiatement vos actes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2561
translate fr qst_JudgementDay_TrialStart_5241f00d:

    # "The judge skimmed over a stack of papers, stroking his beard as he located the page he sought."
    "Le juge parcourut une pile de papiers, caressant sa barbe tout en trouvant la page qu’il cherchait."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2562
translate fr qst_JudgementDay_TrialStart_7924de91:

    # JUDGE_FALWIND "Hmm..."
    JUDGE_FALWIND "Hmm..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2563
translate fr qst_JudgementDay_TrialStart_e3555e30:

    # JUDGE_FALWIND "Where is the other one?"
    JUDGE_FALWIND "Où est l'autre ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2564
translate fr qst_JudgementDay_TrialStart_ce8407d2:

    # JUDGE_FALWIND "There was to be one more on trial, was there not?"
    JUDGE_FALWIND "Il devait y avoir un autre en procès, n'est-ce pas ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2566
translate fr qst_JudgementDay_TrialStart_cd1bd15b:

    # "The doors swung open again."
    "Les portes s'ouvrirent à nouveau."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2567
translate fr qst_JudgementDay_TrialStart_16f92352:

    # "A beaten, disheveled Markus was dragged into the chamber."
    "Un Markus battu et échevelé fut traîné dans la chambre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2568
translate fr qst_JudgementDay_TrialStart_03e586ea:

    # "He was barely conscious."
    "Il était à peine conscient."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2570
translate fr qst_JudgementDay_TrialStart_0c3a177d:

    # MC @ surprised "MARKUS!"
    MC @ surprised "MARKUS!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2571
translate fr qst_JudgementDay_TrialStart_126e9dbc:

    # "I moved to reach him, but the guards immediately blocked my path."
    "Je m'élançai pour le rejoindre, mais les gardes me bloquèrent aussitôt le passage."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2572
translate fr qst_JudgementDay_TrialStart_bf497fdc:

    # JUDGE_FALWIND "Remain still, prisoner nine-six-one."
    JUDGE_FALWIND "Restez immobile, prisonnier neuf-six-un."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2575
translate fr qst_JudgementDay_TrialStart_f5383f45:

    # "With a cruel *thud,* they dropped Markus beside me."
    "Avec un cruel *bruit sourd*, ils laissèrent tomber Markus à côté de moi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2576
translate fr qst_JudgementDay_TrialStart_eb59abcc:

    # "He coughed up blood, his voice weak."
    "Il cracha du sang, la voix faible."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2577
translate fr qst_JudgementDay_TrialStart_91cc76d8:

    # MARKUS "{i}*Weakly*{/i} [player_name!t]..."
    MARKUS "{i}*Faiblement*{/i} [player_name!t]..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2580
translate fr qst_JudgementDay_TrialStart_02699468:

    # MC @ angry "How is he supposed to defend himself?!"
    MC @ angry "Comment est-il censé se défendre ?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2581
translate fr qst_JudgementDay_TrialStart_ca60b975:

    # MC @ angry "He can barely stand, let alone speak!"
    MC @ angry "Il peut à peine se tenir debout, encore moins parler !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2582
translate fr qst_JudgementDay_TrialStart_d3515b39:

    # "Judge Falwind's gaze turned toward the guards."
    "Le regard du juge Falwind se tourna vers les gardes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2583
translate fr qst_JudgementDay_TrialStart_9dc22665:

    # JUDGE_FALWIND "Explain prisoner eight-four-one's condition."
    JUDGE_FALWIND "Expliquez l'état du prisonnier huit-quatre-un."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2585
translate fr qst_JudgementDay_TrialStart_13ea9dda:

    # GUARD "Apologies, Judge Falwind. The prisoner was… uncooperative."
    GUARD "Toutes nos excuses, juge Falwind. Le prisonnier était… peu coopératif."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2586
translate fr qst_JudgementDay_TrialStart_f0053ee9:

    # GUARD "We had to use severe restraint."
    GUARD "Nous avons dû utiliser une contrainte sévère."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2588
translate fr qst_JudgementDay_TrialStart_7fad3231:

    # MC @ angry "YOU BEAT HIM HALF TO DEATH!"
    MC @ angry "VOUS L'AVEZ À MOITIÉ TUÉ !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2591
translate fr qst_JudgementDay_TrialStart_be7b5f6d:

    # "*BANG!*"
    "*BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2592
translate fr qst_JudgementDay_TrialStart_f6fda186:

    # "Falwind's gavel slammed down."
    "Le marteau de Falwind s'abattit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2594
translate fr qst_JudgementDay_TrialStart_f154a8d0:

    # JUDGE_FALWIND "Control your emotions, nine-six-one, or I shall have you reprimanded further."
    JUDGE_FALWIND "Contrôlez vos émotions, neuf-six-un, ou je vous ferai réprimander davantage."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2595
translate fr qst_JudgementDay_TrialStart_6f0d1973:

    # "With a heavy sigh, he glanced back at Markus, who lay crumpled on the floor."
    "Avec un lourd soupir, il jeta un regard en arrière vers Markus, qui gisait affalé sur le sol."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2596
translate fr qst_JudgementDay_TrialStart_643281fa:

    # JUDGE_FALWIND "Given the unfortunate state of your accomplice, we will proceed with your testimony speaking on his behalf."
    JUDGE_FALWIND "Étant donné l'état malheureux de votre complice, nous procéderons à votre témoignage en son nom."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2601
translate fr qst_JudgementDay_TrialStart_5b071465:

    # JUDGE_FALWIND "Hold your tongue, nine-six-one! I will not tolerate contempt in my court!"
    JUDGE_FALWIND "Retenez votre langue, neuf-six-un ! Je ne tolérerai pas le mépris dans ma cour !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2604
translate fr qst_JudgementDay_TrialStart_38318e26:

    # "The judge hesitated, then waved a hand dismissively."
    "Le juge hésita, puis agita la main d'un geste dédaigneux."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2605
translate fr qst_JudgementDay_TrialStart_42e2d16d:

    # JUDGE_FALWIND "Very well. Summon a Mage of Palam to tend to him."
    JUDGE_FALWIND "Très bien. Faites venir un mage de Palam pour s'occuper de lui."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2607
translate fr qst_JudgementDay_TrialStart_4f2b5c04:

    # "The judge nodded, satisfied with my compliance."
    "Le juge hocha la tête, satisfait de ma soumission."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2609
translate fr qst_JudgementDay_TrialStart_14adb04d:

    # JUDGE_FALWIND "Has the prosecution arrived?"
    JUDGE_FALWIND "L'accusation est-elle arrivée ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2610
translate fr qst_JudgementDay_TrialStart_fdc8f651:

    # GUARD "She has, Judge Falwind."
    GUARD "Elle est arrivée, Juge Falwind."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2611
translate fr qst_JudgementDay_TrialStart_cd89cb8b:

    # JUDGE_FALWIND "Send her in."
    JUDGE_FALWIND "Faites-la entrer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2612
translate fr qst_JudgementDay_TrialStart_47151da1:

    # "The massive doors opened once more."
    "Les lourdes portes s'ouvrirent à nouveau."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2613
translate fr qst_JudgementDay_TrialStart_36d06b98:

    # "A figure stepped forward."
    "Une silhouette s'avança."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2614
translate fr qst_JudgementDay_TrialStart_4fc678a8:

    # "Not Inquisitor Henvak, as expected."
    "Pas l'Inquisiteur Henvak, comme prévu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2615
translate fr qst_JudgementDay_TrialStart_af94376b:

    # "But an older woman. Head Inquisitor Marion."
    "Mais une femme plus âgée. L'Inquisitrice en chef Marion."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2617
translate fr qst_JudgementDay_TrialStart_e682a58d:

    # "Uneasy murmurs rose across the court."
    "Des murmures inquiets parcoururent la salle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2618
translate fr qst_JudgementDay_TrialStart_32fb436b:

    # "Even Judge Falwind stiffened at the sight of her."
    "Même le juge Falwind se raidit à sa vue."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2619
translate fr qst_JudgementDay_TrialStart_6ebe2672:

    # JUDGE_FALWIND "H-Head Inquisitor!"
    JUDGE_FALWIND "I-Inquisitrice en chef !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2620
translate fr qst_JudgementDay_TrialStart_8d9108b7:

    # MARION "I trust I am not late."
    MARION "J'espère ne pas être en retard."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2622
translate fr qst_JudgementDay_TrialStart_f9ebf287:

    # JUDGE_FALWIND "E-Er, no, Inquisitor. But… on the paperwork, it states that Inquisitor Henvak was to handle the prosecution."
    JUDGE_FALWIND "E-Euh, non, Inquisiteur. Mais… sur les documents, il est indiqué que l'Inquisiteur Henvak devait se charger de l'accusation."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2623
translate fr qst_JudgementDay_TrialStart_90e8994d:

    # MARION "Henvak is indisposed."
    MARION "Henvak est indisposé."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2624
translate fr qst_JudgementDay_TrialStart_b657aaee:

    # MARION "Given the attention this trial has drawn, I have decided to intercede."
    MARION "Étant donné l'attention que ce procès a suscitée, j'ai décidé d'intercéder."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2625
translate fr qst_JudgementDay_TrialStart_a4e6991c:

    # JUDGE_FALWIND "I… see. But Head Inquisitor, this is most unorthodox. Have you had adequate time to prepare?"
    JUDGE_FALWIND "Je… vois. Mais Grand Inquisiteur, c'est tout à fait inhabituel. Avez-vous eu suffisamment de temps pour vous préparer ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2626
translate fr qst_JudgementDay_TrialStart_30dfe46f:

    # MARION "I have, your honor."
    MARION "Oui, Votre Honneur."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2627
translate fr qst_JudgementDay_TrialStart_273760c0:

    # "The judge clearly did not like this."
    "Le juge n'a clairement pas apprécié cela."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2628
translate fr qst_JudgementDay_TrialStart_3c7efe4d:

    # "But denying Marion's authority was… unwise."
    "Mais contester l'autorité de Marion était… imprudent."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2629
translate fr qst_JudgementDay_TrialStart_ce31a9d3:

    # JUDGE_FALWIND "Very well."
    JUDGE_FALWIND "Très bien."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2630
translate fr qst_JudgementDay_TrialStart_982fa314:

    # JUDGE_FALWIND "With all parties present, would the prosecution like to make its opening statement?"
    JUDGE_FALWIND "Toutes les parties étant présentes, l'accusation souhaite-t-elle faire sa déclaration liminaire ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2631
