    "Les larmes aux yeux, elle s'effondra au sol, agrippant la blessure tandis qu'une des créatures s'avançait pour l'achever."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:367
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_8c7d39f8:

    # "With a swipe of my tail, the creature halted mid-strike."
    "D'un coup de queue, la créature s'immobilisa en plein assaut."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:368
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_f920e40a:

    # "Alysha braced herself, expecting the killing blow—but it never came."
    "Alysha se prépara, s'attendant au coup fatal — mais il ne vint jamais."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:370
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_f90b745f:

    # "Instead, the thing's head rolled across the floor, its lifeless body slumping down next to her."
    "Au lieu de cela, la tête de la créature roula sur le sol, son corps sans vie s'affaissant à côté d'elle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:372
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_64db357e:

    # "In a panic, Alysha tried to crawl away, her breath ragged, her body trembling."
    "Paniquée, Alysha tenta de ramper pour s'éloigner, la respiration haletante, le corps tremblant."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:373
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_95d34b57:

    # MC "Wait!"
    MC "Attends !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:375
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_e83bcd11:

    # ALYSHA "Get back! GET BACK, YOU FUCKING MONSTER!"
    ALYSHA "Recule ! RECULE, ESPÈCE DE MONSTRE !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:377
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_caab7f37:

    # "I instinctively reached for her bleeding stump, my grip firm as she struggled to break free."
    "Instinctivement, j'attrapai son moignon sanglant, ma prise ferme alors qu'elle luttait pour se libérer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:379
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_d511b1fd:

    # ALYSHA "LET GO OF ME!"
    ALYSHA "LÂCHE-MOI !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:380
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_64cf4aa3:

    # "From my palm, the smallest of worm-like creatures slithered onto her wound, sealing it shut within moments."
    "De ma paume, la plus petite des créatures vermiformes se glissa sur sa blessure, la refermant en quelques instants."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:386
translate fr qst_JudgementDay_Siege_ShaniScene_Prepared_e209af52:

    # "She gasped, eyes locked onto the now-healed wound in confusion and fear."
