    MC @ angry "Nous avons sauvé cette ville !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2290
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_1afd1403:

    # ALCOTT @ talk "Head Inquisitor Marion has charged you with treason and consorting with dark mages."
    ALCOTT @ talk "L'inquisiteur en chef Marion vous accuse de trahison et de collusion avec des mages noirs."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2291
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_de3508db:

    # MC @ think "What?!"
    MC @ think "Quoi ?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2292
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_1ab3ff90:

    # ALCOTT @ talk "You have been accused of spying for the Demorai."
    ALCOTT @ talk "Vous avez été accusé d'espionnage pour les Demorai."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2293
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_5ee94fb5:

    # MC @ angry "That's absurd! I fought against them! I saved {i}hundreds!{/i}"
    MC @ angry "C'est absurde ! J'ai combattu contre eux ! J'ai sauvé des {i}centaines{/i} !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2294
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_346ecd1f:

    # ALCOTT @ talk "It does not matter."
    ALCOTT @ talk "Cela n'a pas d'importance."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2295
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_dc9687c2:

    # ALCOTT @ talk "Marion doesn't need to be {i}right{/i}—she only needs to convince the lords that you are too great a threat to keep alive."
    ALCOTT @ talk "Marion n'a pas besoin d'avoir {i}raison{/i}—elle doit seulement convaincre les seigneurs que vous êtes une trop grande menace pour rester en vie."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2296
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_403fc54c:

    # MC @ talk "...So, will you speak on my behalf?"
    MC @ talk "... Alors, parlerez-vous en ma faveur ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2297
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_5ba55a50:

    # ALCOTT @ talk "I cannot."
    ALCOTT @ talk "Je ne peux pas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2298
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_3b4ca7fc:

    # ALCOTT @ talk "I must remain impartial."
    ALCOTT @ talk "Je dois rester impartial."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2299
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_24886635:

    # MC @ angry "Then why are you here?"
    MC @ angry "Alors pourquoi êtes-vous ici ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2300
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_0fe20ea3:

    # ALCOTT @ talk "...Because you can still win this trial."
    ALCOTT @ talk "... Parce que vous pouvez encore gagner ce procès."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2301
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_8bcd69fe:

    # ALCOTT @ talk "Marion will prey on their fear."
    ALCOTT @ talk "Marion va exploiter leur peur."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2302
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_81b3050a:

    # ALCOTT @ talk "So {i}you{/i} must prey on their {i}greed.{/i}"
    ALCOTT @ talk "Alors, {i}tu{/i} dois t'attaquer à leur {i}avidité.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2306
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_78268096:

    # "The Emperor turned away, calling for the guards."
    "L'Empereur se détourna, appelant les gardes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2308
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_ad603be8:

    # MC "...Prey on their hope."
    MC "...Attaque-toi à leur espoir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2309
translate fr qst_JudgementDay_SiegeOverPrison_alcott_menu_8d25bef7:

    # MC "(Prey on their greed...)"
    MC "(Attaque-toi à leur avidité...)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2316
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_a9cf84ff:

    # "As darkness fell in my cell that night, I waited restlessly for my trial to come."
    "Alors que l'obscurité tombait dans ma cellule cette nuit-là, j'attendais avec agitation que mon procès vienne."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2319
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_2d1c7d48:

    # "The aching agony continued to burn, to scorch my hot blood."
    "L'agonie douloureuse continuait de brûler, de brûler mon sang chaud."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2320
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_0264d4d3:

    # "I became pale, sweat dripping profusely from me as I dazed in and out of consciousness."
    "Je devins pâle, la sueur dégoulinant abondamment de moi alors que je passais de la conscience à l'inconscience."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2321
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_fd3655df:

    # "Would I even make it to the trial by morning's light?"
    "Parviendrais-je même à mon procès à la lumière du matin ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2322
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_e6f0d6bf:

    # REGINA "... Oh, dear."
    REGINA "... Oh, là là."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2325
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_fac0e51d:

    # "I looked up to the black shadow stood beyond the bars of my cell."
    "Je levai les yeux vers l'ombre noire qui se tenait derrière les barreaux de ma cellule."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2326
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_8d9e3641:

    # "Shifting and moving, they took form as [regina_ref!t] emerged from the shadows."
    "Se déplaçant et se mouvant, elles prirent forme alors que [regina_ref!t] émergeait des ombres."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2327
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_dc72f708:

    # REGINA @ sad "You poor thing... You look like you're in so much pain."
    REGINA @ sad "Pauvre petit... Tu as l'air de tellement souffrir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2328
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_c7036a05:

    # "Her attire was different now, from head to toe she wore black, with a strange pointed hat, and the way she carried herself felt different, it felt... {i}dangerous.{/i}"
    "Sa tenue était différente maintenant, de la tête aux pieds elle était en noir, avec un étrange chapeau pointu, et sa manière de se tenir était différente, elle semblait... {i}dangereuse.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2329
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_f56dd946:

    # "Her hands reached through the bars."
    "Ses mains passèrent à travers les barreaux."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2330
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_5ffe3e24:

    # REGINA "Poor baby, come... Come to [regina_ref!t]."
    REGINA "Pauvre petit, viens... Viens vers [regina_ref!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2331
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_da06ef9c:

    # "I slapped her hand away as I pulled back."
    "Je repoussai sa main d'une claque en reculant."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2332
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_615f5fd0:

    # MC @ angry "... Who are you?"
    MC @ angry "... Qui es-tu ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2333
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_6eb8fe7a:

    # "[regina_ref_cap!t] delicately pulled back her hand, her face slightly crestfellen."
    "[regina_ref_cap!t] retira délicatement sa main, le visage légèrement déçu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2334
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_407ed983:

    # REGINA @ sad "You know who I am... I'm still the same person I've always been."
    REGINA @ sad "Tu sais qui je suis... Je suis toujours la même personne que j'ai toujours été."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2335
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_38cab1e6:

    # MC @ angry "Don't lie to me! Not anymore!"
    MC @ angry "Ne me mens pas ! Plus jamais !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2336
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_39ba6b8c:

    # REGINA @ angry "I've been trying to protect you!"
    REGINA @ angry "J'ai essayé de te protéger !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2337
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_4acb35e3:

    # MC @ angry "All these years... All these years I've pretended not to see what's staring me in the face."
    MC @ angry "Toutes ces années... Toutes ces années, j'ai fait semblant de ne pas voir ce qui me crève les yeux."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2338
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_f834a9d3:

    # MC @ angry "Our whole lives you've been LYING to me and Erika about who and what you really are!"
    MC @ angry "Toute notre vie, tu nous as MENTI, à moi et à Erika, sur qui et ce que tu es vraiment !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2339
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_7be10a23:

    # MC @ angry "No more! Who are you really?"
    MC @ angry "Plus jamais ! Qui es-tu vraiment ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2340
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_c0bf3f94:

    # MC @ angry "...{i}What are you?{/i}"
    MC @ angry "...{i}Qu'es-tu ?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2341
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_e57e169f:

    # "The concerning softness on [regina_ref!t]'s expression faded, as in a moment, she became completely calm and collected, with a cold quality to her tone."
    "La douceur inquiétante sur le visage de [regina_ref!t] s'estompa, et en un instant, elle devint complètement calme et posée, avec une froideur dans le ton."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2342
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_4f5e4d50:

    # REGINA @ talk "... I was born four centuries ago in the village of Lockshire."
    REGINA @ talk "... Je suis née il y a quatre siècles dans le village de Lockshire."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2343
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_2467e2ae:

    # "I listened intently, feeling the room close in around us."
    "J'écoutais attentivement, sentant la pièce se refermer autour de nous."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2344
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_e116d747:

    # REGINA @ talk "Times were different then, my people were just another school of magecraft, one often misunderstood... And yet, respected as the others were."
    REGINA @ talk "Les temps étaient différents à l'époque, mon peuple n'était qu'une autre école de magie, souvent mal comprise... Et pourtant, respectée comme les autres l'étaient."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2345
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_4fc3f3e9:

    # "I felt the sickly blood turn ice cold as I listened."
    "Je sentis le sang malade devenir glacial alors que j'écoutais."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2346
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_6beb8743:

    # MC @ surprised "So it is true then..."
    MC @ surprised "Alors c'est donc vrai..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2347
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_fac91196:

    # MC @ surprised "{i}You're a dark mage.{/i}"
    MC @ surprised "{i}Tu es un mage noir.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2348
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_689c49b0:

    # REGINA "..."
    REGINA "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2349
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_d58b1863:

    # MC @ angry "... Say it!"
    MC @ angry "... Dis-le !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2355
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_fee25212:

    # REGINA @ talk "... I am."
    REGINA @ talk "... Je le suis."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2356
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_11b77947:

    # "Her confession stung like a hot knife pressed into my very soul."
    "Sa confession me transperça comme un couteau brûlant enfoncé dans mon âme même."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2357
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_a5a156cc:

    # MC @ surprised "Oh gods..."
    MC @ surprised "Oh dieux..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2358
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_289a6298:

    # MC @ surprised "No... I..."
    MC @ surprised "Non... Je..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2359
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_bbefb2bd:

    # MC @ sad "How could I not see it?"
    MC @ sad "Comment n'ai-je pas pu le voir ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2360
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_499c67ea:

    # REGINA @ talk "I was going to tell you... One day."
    REGINA @ talk "J'allais te le dire... Un jour."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2361
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_f9e5c130:

    # MC @ angry "Grghh! And you let Erika become an inquisitor anyway?!"
    MC @ angry "Grghh ! Et tu as quand même laissé Erika devenir inquisitrice ?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2362
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_2491c2c1:

    # MC @ angry "Knowing full well what you are!"
    MC @ angry "En sachant parfaitement ce que tu es !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2363
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_fd3fbd07:

    # MC @ angry "ARE YOU MAD?!"
    MC @ angry "ES-TU FOU ?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2364
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_1d2de62a:

    # REGINA @ talk "You and her happiness, is the only thing I care about."
    REGINA @ talk "Ton bonheur et le sien, c'est la seule chose qui m'importe."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2365
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_1cf2a9ea:

    # REGINA @ talk "If Erika chooses to hate me, then so be it."
    REGINA @ talk "Si Erika choisit de me haïr, alors soit."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2366
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_278ef5ad:

    # REGINA @ talk "But I knew one way or another, if Erika never learned to channel her magecraft, she would only resent herself."
    REGINA @ talk "Mais je savais que d'une manière ou d'une autre, si Erika n'apprenait jamais à canaliser sa magie, elle ne ferait que s'en vouloir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2367
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_2d6ae603:

    # MC @ angry "Don't try and pretend this is just about OUR happiness!"
    MC @ angry "N'essaie pas de faire croire que c'est uniquement pour NOTRE bonheur !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2368
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_89d68b37:

    # MC @ angry "You could have done more! We would have understood!"
    MC @ angry "Tu aurais pu faire plus ! Nous aurions compris !"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2369
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_dce9bff1:

    # REGINA @ angry "And confined you to a life of keeping secrets?"
    REGINA @ angry "Et te condamner à une vie de secrets ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2370
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_bd5c3416:

    # REGINA @ talk "No... I wanted you both to live a normal life, I wanted you both to be happy and make choices for yourselves, not because of me."
    REGINA @ talk "Non... Je voulais que vous viviez toutes les deux une vie normale, je voulais que vous soyez heureuses et fassiez vos propres choix, pas à cause de moi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2371
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_52300684:

    # MC @ sad "... Is Regina even your real name?"
    MC @ sad "... Est-ce que Regina est vraiment ton vrai nom ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2372
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_f397476d:

    # REGINA @ talk "I've gone by many names over the years."
    REGINA @ talk "J'ai porté de nombreux noms au fil des ans."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2373
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_2ae14994:

    # REGINA @ talk "But Regina was the name I was born with."
    REGINA @ talk "Mais Regina est le nom que j'ai reçu à la naissance."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2374
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_f587dd25:

    # REGINA @ talk "I brought it back because I wanted to hear you two call me it."
    REGINA @ talk "Je l'ai repris parce que je voulais vous entendre m'appeler ainsi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2375
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2376
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_2b5d97c5:

    # MC @ sad "You're no ordinary dark mage, are you?"
    MC @ sad "Tu n'es pas un mage noir ordinaire, n'est-ce pas ?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2377
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_51cbcbf1:

    # MC @ sad "I've never heard of a dark mage living that long."
    MC @ sad "Je n'ai jamais entendu parler d'un mage noir vivant aussi longtemps."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2378
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_9fabe2e5:

    # "There was a long pause, before Regina finally answered me."
    "Il y eut une longue pause, avant que Regina ne me réponde enfin."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2379
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_3acc27e1:

    # REGINA @ talk "{i}... I am the witch of Barakan.{/i}"
    REGINA @ talk "{i}... Je suis la sorcière de Barakan.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2380
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_d79fb17e:

    # "I felt my skin begin to crawl."
    "Je sentis ma peau se hérisser."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2381
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_e0b21ae9:

    # "The witch of Barakan..."
    "La sorcière de Barakan..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2382
translate fr qst_JudgementDay_SiegeOverPrison_ReginaVisit_3d491b16:

    # "A story used to scare children, a fable, more myth then legend."
