translate fr qst_bloodhound_1_TheaOnGuardians_9f40d81a:

    # THEA @ talk "They're newcomers but they seem quite popular."
    THEA @ talk "Ce sont des nouveaux venus, mais ils semblent assez populaires."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:11
translate fr qst_bloodhound_1_TheaOnGuardians_dd63aafe:

    # THEA @ scared "Maybe a little too cocky though."
    THEA @ scared "Peut-être un peu trop arrogants, cependant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:12
translate fr qst_bloodhound_1_TheaOnGuardians_b6feebab:

    # MC @ talk "Not a fan?"
    MC @ talk "Pas fan ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:13
translate fr qst_bloodhound_1_TheaOnGuardians_68490604:

    # THEA @ talk "Mm, every rookie team thinks they're the chosen ones or something."
    THEA @ talk "Mm, chaque équipe de débutants pense être les élus ou quelque chose comme ça."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:14
translate fr qst_bloodhound_1_TheaOnGuardians_07b3b10c:

    # THEA @ smile2 "I prefer the ones who actually manage to stick around."
    THEA @ smile2 "Je préfère ceux qui parviennent réellement à rester."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:15
translate fr qst_bloodhound_1_TheaOnGuardians_7805f446:

    # MC @ talk "Where are they now?"
    MC @ talk "Où sont-ils maintenant ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:16
translate fr qst_bloodhound_1_TheaOnGuardians_47145c71:

    # THEA @ talk "They took on a quest to take on a giant slimelark."
    THEA @ talk "Ils ont accepté une quête pour affronter un slimelark géant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:17
translate fr qst_bloodhound_1_TheaOnGuardians_4e1580f2:

    # MC @ surprised "A what?"
    MC @ surprised "Un quoi ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:18
translate fr qst_bloodhound_1_TheaOnGuardians_f7d02ddf:

    # THEA @ talk "Uhh, think a very angry sentient pool of gunk that will force its way into you and consume you inside out."
    THEA @ talk "Euh, pense à une flaque gluante très en colère, sensible, qui va s'introduire de force en toi et te dévorer de l'intérieur."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:19
translate fr qst_bloodhound_1_TheaOnGuardians_1cdd0735:

    # MC @ talk "Can they handle it?"
    MC @ talk "Peuvent-ils s'en sortir ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:20
translate fr qst_bloodhound_1_TheaOnGuardians_a2519c48:

    # THEA @ sad "I don't know... A slimelark isn't something to shrug off if you're a rookie."
    THEA @ sad "Je ne sais pas... Un slimelark n'est pas à prendre à la légère quand on est débutant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:21
translate fr qst_bloodhound_1_TheaOnGuardians_2455d26f:

    # THEA @ sad "Especially the one that's been causing so much trouble."
    THEA @ sad "Surtout celui qui cause tant de problèmes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:22
translate fr qst_bloodhound_1_TheaOnGuardians_022994e2:

    # THEA @ sad "I told them not to take it but, when you've got something to prove..."
    THEA @ sad "Je leur ai dit de ne pas s'en occuper, mais quand on a quelque chose à prouver..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:23
translate fr qst_bloodhound_1_TheaOnGuardians_c1b60765:

    # THEA @ talk "Anyway, the thing has been sighted near lake Balun, you know, a short hike to the West?"
    THEA @ talk "Bref, la créature a été aperçue près du lac Balun, tu sais, une courte randonnée à l'ouest ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:24
translate fr qst_bloodhound_1_TheaOnGuardians_261d13c3:

    # THEA @ scared "Apparently its been pulling people in when they get too close to the water."
    THEA @ scared "Apparemment, elle attire les gens dans l'eau quand ils s'en approchent trop près."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:25
translate fr qst_bloodhound_1_TheaOnGuardians_23817d50:

    # MC @ talk "Thanks for the information."
    MC @ talk "Merci pour l'information."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:26
translate fr qst_bloodhound_1_TheaOnGuardians_d05df937:

    # THEA @ sad "If you're thinking of going after them, I'd suggest being prepared..."
    THEA @ sad "Si tu penses aller les chercher, je te suggère d'être prêt..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:27
translate fr qst_bloodhound_1_TheaOnGuardians_8f6a6938:

    # THEA @ talk "Slimelarks are difficult beasts."
    THEA @ talk "Les slimelarks sont des bêtes difficiles."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:28
translate fr qst_bloodhound_1_TheaOnGuardians_a9bcd73d:

    # MC @ talk "I'll take your word for it."
    MC @ talk "Je te crois sur parole."

