# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:3
translate fr qst_bloodhound_2_lake_27c44724:

    # "Stepping closer towards the water bank, I glanced down at my reflection flickering in the water for a moment."
    "En m'approchant du bord de l'eau, j'ai jeté un coup d'œil à mon reflet qui vacillait dans l'eau pendant un instant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:4
translate fr qst_bloodhound_2_lake_6c633067:

    # "I noticed {i}something red and glimmering{/i} approaching almost hypnotically slow."
    "J'ai remarqué {i}quelque chose de rouge et scintillant{/i} s'approchant avec une lenteur presque hypnotique."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:5
translate fr qst_bloodhound_2_lake_0b4100ee:

    # "I felt every hair stand on my neck as I felt the sudden urge to leap back."
    "J'ai senti tous mes poils se hérisser sur ma nuque alors que j'éprouvais une soudaine envie de bondir en arrière."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:6
translate fr qst_bloodhound_2_lake_8258d701:

    # "As I did so, the thing emerged violently from the water, it's single red eye glaring towards me."
    "Ce faisant, la chose émergea violemment de l'eau, son unique œil rouge me fixant avec fureur."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:11
translate fr qst_bloodhound_2_lake_6ce7cf8c:

    # "Bound inside its horrifying seal, the Guardians were half dissolved, most already dead, lifelessly floating in the acidic mass."
    "Prisonniers de son sceau terrifiant, les Gardiens étaient à moitié dissous, la plupart déjà morts, flottant sans vie dans la masse acide."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:13
translate fr qst_bloodhound_2_lake_b34c3a87:

    # "One though, a girl, all bones with her eyes peeled back as she cried did her best to stretch out a dissolved hand to me."
    "Une cependant, une fille, toute en os avec les yeux révulsés alors qu'elle pleurait, faisait de son mieux pour tendre vers moi une main dissoute."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:14
translate fr qst_bloodhound_2_lake_2beac591:

    # "Screaming inside her silent prison, the slime forced its way down her throat and she trembled as her eyes rolled white."
    "Hurlant dans sa prison silencieuse, la vase s'engouffrait dans sa gorge et elle tremblait tandis que ses yeux roulaient au blanc."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:15
translate fr qst_bloodhound_2_lake_a94588ca:

    # "Then, she was as lifeless as all the others."
    "Puis, elle fut aussi sans vie que tous les autres."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:17
translate fr qst_bloodhound_2_lake_37f5d75c:

    # "With little time to waste, I tore away at my flesh and stared down the horrific monstrosity before me."
    "Sans temps à perdre, j'arrachai ma chair et fixai l'horrible monstruosité devant moi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:31
translate fr qst_bloodhound_2_lake_3a2cf159:

    # "Dissolving into the ground and sizziling, the growling monstrosity's cries began to die down into a distorted murmur till it lay silent."
    "Se dissolvant dans le sol en grésillant, les cris de la monstruosité grondante commencèrent à s'éteindre en un murmure déformé jusqu'à ce qu'elle reste silencieuse."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:39
translate fr qst_bloodhound_2_lake_postbattle_04ed3727:

    # MC @ talk "{i}*Huff... Huff*{/i}"
    MC @ talk "{i}*Huff... Huff*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:41
translate fr qst_bloodhound_2_lake_postbattle_e0522a7a:

    # MC "(That was too close.)"
    MC "(C'était moins une.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:42
translate fr qst_bloodhound_2_lake_postbattle_6e156aba:

    # "From behind, I could hear the sounds of painful grunts and scuffling."
    "Derrière moi, j'entendais des grognements douloureux et des bruits de lutte."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:43
translate fr qst_bloodhound_2_lake_postbattle_1a0739a8:

    # "I turned quickly expecting some other horror from the lake ready to strike."
    "Je me retournai rapidement, m'attendant à ce qu'une autre horreur du lac soit prête à frapper."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:44
translate fr qst_bloodhound_2_lake_postbattle_a1ea6482:

    # "Instead, I saw a young knight clad in armour dragging his way across the grass away from me."
    "Au lieu de cela, je vis un jeune chevalier en armure se traînant sur l'herbe en s'éloignant de moi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:45
translate fr qst_bloodhound_2_lake_postbattle_362573b6:

    # "His left leg missing as he dragged a trail of blood behind him, I approached him cautiously, reaching out towards him with my hand outstretched."
    "Sa jambe gauche manquait tandis qu'il laissait une traînée de sang derrière lui. Je m'approchai de lui avec prudence, tendant la main dans sa direction."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:46
translate fr qst_bloodhound_2_lake_postbattle_9b24d71e:

    # "The man turned weakly to swing his sword at me, but I managed to pull back in time and dodge it."
    "L'homme se retourna faiblement pour me donner un coup d'épée, mais je parvins à reculer à temps pour l'éviter."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:52
translate fr qst_bloodhound_2_lake_postbattle_bad462e1:

    # "His face was ghosty white, his eyes wide in fear as he cried at me between his heavy, desperate breaths."
    "Son visage était d'une pâleur fantomatique, les yeux écarquillés de peur tandis qu'il me criait dessus entre ses respirations lourdes et désespérées."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:54
translate fr qst_bloodhound_2_lake_postbattle_c147c09c:

    # UNKNOWN "Back! BACK!"
    UNKNOWN "Recule ! RECULE !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:55
translate fr qst_bloodhound_2_lake_postbattle_811721cd:

    # MC "Hold! I am not here to hurt you!"
    MC "Halte ! Je ne suis pas ici pour te faire du mal !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:56
translate fr qst_bloodhound_2_lake_postbattle_1d8f5d96:

    # UNKNOWN "You... You speak, {i}beast?{/i}"
    UNKNOWN "Tu... Tu parles, {i}bête ?{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:57
translate fr qst_bloodhound_2_lake_postbattle_507e8001:

    # MC "I'm here for the guardians."
    MC "Je suis là pour les gardiens."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:58
translate fr qst_bloodhound_2_lake_postbattle_b72ffe15:

    # "The man began to laugh, and then cry as tears streamed down his eyes."
    "L'homme se mit à rire, puis à pleurer, des larmes coulant de ses yeux."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:59
translate fr qst_bloodhound_2_lake_postbattle_538d0203:

    # UNKNOWN "Hahahaha!"
    UNKNOWN "Hahahaha!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:60
translate fr qst_bloodhound_2_lake_postbattle_c4d9c865:

    # UNKNOWN "You've found them!"
    UNKNOWN "Tu les as trouvés !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:61
translate fr qst_bloodhound_2_lake_postbattle_68d2559e:

    # UNKNOWN "At least {i}*cough*{/i} the bits and pieces left of us."
    UNKNOWN "Du moins {i}*tousse*{/i} les morceaux restants de nous."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:62
translate fr qst_bloodhound_2_lake_postbattle_a54a637c:

    # MC "You're bleeding out, if we don't get the wound treated and sealed soon you'll die."
    MC "Tu te vides de ton sang, si on ne soigne pas et ne referme pas la blessure rapidement, tu vas mourir."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:63
translate fr qst_bloodhound_2_lake_postbattle_3e8bf0ee:

    # UNKNOWN "{i}*Cough!*{/i} It's hopeless... I'm finished."
    UNKNOWN "{i}*Tousse !*{/i} C'est sans espoir... Je suis fini."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:64
translate fr qst_bloodhound_2_lake_postbattle_86322c55:

    # MC "Who are you?"
    MC "Qui es-tu ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:65
translate fr qst_bloodhound_2_lake_postbattle_0f09202a:

    # UNKNOWN "Dravenham... At your service... What's left of it."
    UNKNOWN "Dravenham... À ton service... Ce qu'il en reste."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:67
translate fr qst_bloodhound_2_lake_postbattle_7f2bdaab:

    # DRAVENHAM "They sent {i}you{/i} to rescue us?"
    DRAVENHAM "Ils t'ont envoyé, {i}toi{/i}, pour nous sauver ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:68
translate fr qst_bloodhound_2_lake_postbattle_bacefd2e:

    # DRAVENHAM "I've never seen a beast like you before."
    DRAVENHAM "Je n'ai jamais vu une bête comme toi auparavant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:69
translate fr qst_bloodhound_2_lake_postbattle_291e3248:

    # MC "I'm afraid there's no rescue party."
    MC "J'ai bien peur qu'il n'y ait pas d'équipe de secours."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:70
translate fr qst_bloodhound_2_lake_postbattle_7c3c7716:

    # MC "I came looking for information on a missing person."
    MC "Je suis venu chercher des informations sur une personne disparue."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:71
translate fr qst_bloodhound_2_lake_postbattle_073fa195:

    # DRAVENHAM "What?! Are you fucki- *cough*"
    DRAVENHAM "Quoi ?! Tu te fous d- *tousse*"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:72
translate fr qst_bloodhound_2_lake_postbattle_e8e7195c:

    # MC "No one knows how dire your adventure ended up."
    MC "Personne ne sait à quel point ton aventure a mal tourné."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:73
translate fr qst_bloodhound_2_lake_postbattle_8595b89d:

    # "The man began to sob once again, barely managing to hold himself together."
    "L'homme recommença à sangloter, parvenant à peine à se maîtriser."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:74
translate fr qst_bloodhound_2_lake_postbattle_15ba15f6:

    # DRAVENHAM "Elsa... Roca... Twhain... I failed them..."
    DRAVENHAM "Elsa... Roca... Twhain... Je les ai laissés tomber..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:75
translate fr qst_bloodhound_2_lake_postbattle_a8eea1de:

    # MC "Dravenham, I know you are in pain but I fear our time together is short, I can hear your heartbeat slow down."
    MC "Dravenham, je sais que tu souffres, mais je crains que le temps qu'il nous reste ne soit court, j'entends ton cœur ralentir."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:76
translate fr qst_bloodhound_2_lake_postbattle_c448d59c:

    # DRAVENHAM "Then ask, {i}beast{/i}... Ask whatever it is you have to."
    DRAVENHAM "Alors demande, {i}bête{/i}... Demande ce que tu as à dire."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:81
translate fr qst_bloodhound_2_lake_postbattle_dravenham_5305a2f1:

    # DRAVENHAM "None... The thing only kept me alive to let its young feed on me."
    DRAVENHAM "Aucun... La chose ne m'a gardé en vie que pour que ses petits puissent se nourrir de moi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:82
translate fr qst_bloodhound_2_lake_postbattle_dravenham_a48cb7f1:

    # DRAVENHAM "{i}*Huff*{/i} It wouldn't let me leave... It wouldn't let me fucking leave!"
    DRAVENHAM "{i}*Pff*{/i} Il ne me laissait pas partir... Il ne me laissait pas foutrement partir !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:83
translate fr qst_bloodhound_2_lake_postbattle_dravenham_6fb79e61:

    # MC "Stay with me Dravenham."
    MC "Reste avec moi, Dravenham."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:84
translate fr qst_bloodhound_2_lake_postbattle_dravenham_9b9da1a5:

    # DRAVENHAM "Please... Everything is so numb now."
    DRAVENHAM "S'il te plaît... Tout est si engourdi maintenant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:88
translate fr qst_bloodhound_2_lake_postbattle_dravenham_1c097716:

    # DRAVENHAM "We weren't just here for the quest..."
    DRAVENHAM "Nous n'étions pas seulement ici pour la quête..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:89
translate fr qst_bloodhound_2_lake_postbattle_dravenham_1c698585:

    # DRAVENHAM "A servant of some minor nobles offered to pay us triple if we could capture a baby slimelark and bring it back."
    DRAVENHAM "Un serviteur de quelques nobles mineurs a proposé de nous payer le triple si nous pouvions capturer un bébé slimelark et le ramener."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:90
translate fr qst_bloodhound_2_lake_postbattle_dravenham_d69f71d0:

    # MC "But why?"
    MC "Mais pourquoi ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:91
translate fr qst_bloodhound_2_lake_postbattle_dravenham_ee00bc87:

    # DRAVENHAM "The young... Slimelarks can take many forms, including beautiful women, if trained."
    DRAVENHAM "Les jeunes... Les Slimelarks peuvent prendre de nombreuses formes, y compris de belles femmes, s'ils sont entraînés."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:92
translate fr qst_bloodhound_2_lake_postbattle_dravenham_17540028:

    # DRAVENHAM "The fucking perverts wanted to keep a few as their own private slaves."
    DRAVENHAM "Ces foutus pervers voulaient en garder quelques-uns comme leurs propres esclaves privés."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:93
translate fr qst_bloodhound_2_lake_postbattle_dravenham_b6fbbabd:

    # MC "Who?"
    MC "Qui ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:94
translate fr qst_bloodhound_2_lake_postbattle_dravenham_cb60938e:

    # DRAVENHAM "Don't know... The servant only told us he was acting as a intermediary."
    DRAVENHAM "Je ne sais pas... Le serviteur nous a seulement dit qu'il agissait comme intermédiaire."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:95
translate fr qst_bloodhound_2_lake_postbattle_dravenham_28c2a94f:

    # DRAVENHAM "None of them care about us, we're all just expendable to them."
    DRAVENHAM "Aucun d'eux ne se soucie de nous, nous sommes tous juste sacrifiables pour eux."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:96
translate fr qst_bloodhound_2_lake_postbattle_dravenham_272db056:

    # DRAVENHAM "Urghh... I feel so dizzy..."
    DRAVENHAM "Urghh... Je me sens tellement étourdi..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:97
translate fr qst_bloodhound_2_lake_postbattle_dravenham_e9b9815c:

    # MC "Focus! Just a little more!"
    MC "Concentre-toi ! Juste un peu plus !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:103
translate fr qst_bloodhound_2_lake_postbattle_dravenham_dbbff41e:

    # DRAVENHAM "Azul? Yes... I know of him."
    DRAVENHAM "Azul ? Oui... J'en ai entendu parler."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:104
translate fr qst_bloodhound_2_lake_postbattle_dravenham_def48cf3:

    # DRAVENHAM "He would offer us advice on our quests..."
    DRAVENHAM "Il nous donnait des conseils pour nos quêtes..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:105
translate fr qst_bloodhound_2_lake_postbattle_dravenham_046e0255:

    # DRAVENHAM "For coin."
    DRAVENHAM "Contre de l'argent."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:106
translate fr qst_bloodhound_2_lake_postbattle_dravenham_eb43210d:

    # DRAVENHAM "Something hap-*cough* happened?"
    DRAVENHAM "Quelque chose s'est-*tousse* passé ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:107
translate fr qst_bloodhound_2_lake_postbattle_dravenham_90a466a3:

    # MC "He's gone missing."
    MC "Il a disparu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:108
translate fr qst_bloodhound_2_lake_postbattle_dravenham_c1daa0a7:

    # MC "What did he talk to you about the last time you saw him?"
    MC "De quoi vous a-t-il parlé la dernière fois que vous l'avez vu ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:109
translate fr qst_bloodhound_2_lake_postbattle_dravenham_f051d7a2:

    # DRAVENHAM "Missing? Crap..."
    DRAVENHAM "Disparu ? Merde..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:110
translate fr qst_bloodhound_2_lake_postbattle_dravenham_c0de04b1:

    # DRAVENHAM "He was afraid of something."
    DRAVENHAM "Il avait peur de quelque chose."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:111
translate fr qst_bloodhound_2_lake_postbattle_dravenham_652cae32:

    # DRAVENHAM "He said he had information that could end up in..."
    DRAVENHAM "Il a dit qu'il avait des informations qui pourraient finir entre..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:112
translate fr qst_bloodhound_2_lake_postbattle_dravenham_85baa545:

    # "Dravenham mustered himself, grasping for life slipping away."
    "Dravenham se ressaisit, s'agrippant à la vie qui s'échappait."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:113
translate fr qst_bloodhound_2_lake_postbattle_dravenham_0d88fc3a:

    # DRAVENHAM "...In the wrong hands."
    DRAVENHAM "...Entre de mauvaises mains."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:114
translate fr qst_bloodhound_2_lake_postbattle_dravenham_91226212:

    # DRAVENHAM "\"Send the whole guild into chaos\" he said..."
    DRAVENHAM "\"Plonger toute la guilde dans le chaos\" a-t-il dit..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:115
translate fr qst_bloodhound_2_lake_postbattle_dravenham_10740462:

    # DRAVENHAM "He then asked if he could hire us for protection, but by then, we'd already taken on... this."
    DRAVENHAM "Il a ensuite demandé s'il pouvait nous engager pour le protéger, mais à ce moment-là, nous avions déjà accepté... ça."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:116
translate fr qst_bloodhound_2_lake_postbattle_dravenham_0e6917de:

    # DRAVENHAM "We were going to help him afterwards..."
    DRAVENHAM "Nous allions l'aider après..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:117
translate fr qst_bloodhound_2_lake_postbattle_dravenham_89117cef:

    # DRAVENHAM "Ha... I guess as you can see, that didn't work out."
    DRAVENHAM "Ha... Je suppose que comme tu peux le voir, ça n'a pas marché."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:118
translate fr qst_bloodhound_2_lake_postbattle_dravenham_eb69671d:

    # MC "Where is he now?"
    MC "Où est-il maintenant ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:119
translate fr qst_bloodhound_2_lake_postbattle_dravenham_1d788dbb:

    # DRAVENHAM "He gave... {i}Urghh...{/i} an address to a safehouse of his."
    DRAVENHAM "Il a donné... {i}Urghh...{/i} l'adresse de l'une de ses planques."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:120
translate fr qst_bloodhound_2_lake_postbattle_dravenham_a77bf48e:

    # DRAVENHAM "Told us it was too dangerous for him to be out in public anymore."
    DRAVENHAM "Il nous a dit qu'il était trop dangereux pour lui de se montrer en public désormais."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:121
translate fr qst_bloodhound_2_lake_postbattle_dravenham_9bae290d:

    # DRAVENHAM "That {i}some people were after him{/i}."
    DRAVENHAM "Que {i}certaines personnes étaient à ses trousses{/i}."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:122
translate fr qst_bloodhound_2_lake_postbattle_dravenham_f941d70a:

    # "Hand slid into his breastplate, Dravenham pulled out a bloodied note with something scrawled on it and handed it to me."
    "Glissant la main dans son plastron, Dravenham en sortit un billet taché de sang, sur lequel quelque chose était griffonné, et me le tendit."

