# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:49
translate fr qst_bloodhound_2_lake_openbox_9d3fcc85:

    # "As the lock dropped off the from the box, I opened it up to peer inside."
    "Alors que le cadenas se détachait de la boîte, je l'ouvris pour regarder à l'intérieur."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:50
translate fr qst_bloodhound_2_lake_openbox_9ff2a2e4:

    # "Inside, a jar with an enchantment on it was filled with the slimelark-like substance."
    "À l'intérieur, un bocal enchanté était rempli d'une substance semblable à celle d'un slimelark."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:51
translate fr qst_bloodhound_2_lake_openbox_2302ca8f:

    # MC "(This is what they came for.)"
    MC "(C'est ce qu'ils étaient venus chercher.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:52
translate fr qst_bloodhound_2_lake_openbox_138ba29f:

    # MC "(A baby slimelark.)"
    MC "(Un bébé slimelark.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:53
translate fr qst_bloodhound_2_lake_openbox_a497c3f3:

    # MC "(Well, what should I do with it?)"
    MC "(Eh bien, que devrais-je en faire ?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:56
translate fr qst_bloodhound_2_lake_openbox_b4080175:

    # "While what happened here was no doubt horrific, something about punishing the youngling felt wrong."
    "Bien que ce qui s'était passé ici ait été sans nul doute atroce, quelque chose dans l'idée de punir le jeune me paraissait mal."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:57
translate fr qst_bloodhound_2_lake_openbox_f3f2fecd:

    # "Even if it {i}was{/i} the offspring of a slimelark."
    "Même si c'{i}était{/i} la progéniture d'un slimelark."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:58
translate fr qst_bloodhound_2_lake_openbox_3fafabb6:

    # "With the jar in hand, I threw it straight into the lake, watching as it plumetted down with a splash."
    "Le bocal en main, je le jetai directement dans le lac, le regardant sombrer avec un éclaboussement."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:61
translate fr qst_bloodhound_2_lake_openbox_407d78e6:

    # "Looking around at the horror inflicted by one of these beasts, I decided it was simply too much risk to keep it alive."
    "En regardant autour de moi l'horreur infligée par l'une de ces bêtes, je décidai que le garder en vie représentait tout simplement trop de risques."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:62
translate fr qst_bloodhound_2_lake_openbox_f8ceeff3:

    # "It was young now... But it would grow up."
    "Il était jeune pour l'instant... Mais il grandirait."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:63
translate fr qst_bloodhound_2_lake_openbox_7f274017:

    # "Shattering the glass, the slimelark squealed in a death cry as I hacked away at the thing till it dissolved like its parent."
    "Brisant le verre, le slimelark poussa un cri de mort alors que je tailladais la chose jusqu'à ce qu'elle se dissolve comme son parent."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:67
translate fr qst_bloodhound_2_lake_openbox_927f5c91:

    # "For some strange reason, I felt compelled to take the jar with me."
    "Pour une raison étrange, je me sentis obligé de prendre le bocal avec moi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:68
translate fr qst_bloodhound_2_lake_openbox_1a2610a5:

    # "Oddly, as I held up the jar to inspect it more, the colour of the slime briefly turned pink."
    "Curieusement, alors que je tenais le bocal pour l'inspecter davantage, la couleur de la vase vira brièvement au rose."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:69
translate fr qst_bloodhound_2_lake_openbox_94e3d87f:

    # "I thought for a moment I could hear a soft cooing sound from inside the jar, but after a few seconds more of inspection, the thing was silent again."
    "Je crus un instant entendre un doux roucoulement venant de l'intérieur du bocal, mais après quelques secondes d'inspection supplémentaires, la chose redevint silencieuse."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:71
translate fr qst_bloodhound_2_lake_openbox_156904e7:

    # MC "(I hope I don't end up regretting this.)"
    MC "(J'espère ne pas finir par regretter cela.)"

