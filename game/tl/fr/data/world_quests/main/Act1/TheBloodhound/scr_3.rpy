translate fr qst_bloodhound_3_toBasement_0e939507:

    # UNKNOWN "{i}*Whistles*{/i}"
    UNKNOWN "{i}*Sifflements*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:182
translate fr qst_bloodhound_3_toBasement_9afc807c:

    # "As the man in black turned sharply towards the sound, he was suddenly blasted back by a bolt of lightning."
    "Alors que l'homme en noir se tourna brusquement vers le bruit, il fut soudainement projeté en arrière par un éclair."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:183
translate fr qst_bloodhound_3_toBasement_13c9ce29:

    # "Beside Captain Nyx, four mages stood at the ready, their staffs pointed towards the convulsing automaton."
    "Aux côtés du Capitaine Nyx, quatre mages se tenaient prêts, leurs bâtons pointés vers l'automate convulsant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:211
translate fr qst_bloodhound_3_toBasement_98ef091a:

    # "It struggled and rose to its feet again, charging towards the Captain and the mages."
    "Il lutta et se remit sur ses pieds, chargeant vers le Capitaine et les mages."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:218
translate fr qst_bloodhound_3_toBasement_9304bfda:

    # "...But another blast sent him wheeling backwards."
    "...Mais une autre déflagration le fit tourbillonner en arrière."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:220
translate fr qst_bloodhound_3_toBasement_18e5bb6b:

    # "Clambering back to its feet before they could finish it off, the man in black charged forward, dodging the third blast right through the Captain and her mages, scurrying its way up the stairs."
    "Se remettant péniblement sur ses pieds avant qu'ils ne puissent l'achever, l'homme en noir chargea en avant, esquivant la troisième déflagration en traversant le Capitaine et ses mages, se précipitant dans l'escalier."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:221
translate fr qst_bloodhound_3_toBasement_53131c31:

    # NYX @ angry "AFTER HIM!"
    NYX @ angry "APRÈS LUI!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:222
translate fr qst_bloodhound_3_toBasement_03084257:

    # MAGE "But... What about the other one?"
    MAGE "Mais... Qu'en est-il de l'autre ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:223
translate fr qst_bloodhound_3_toBasement_f1f00a2f:

    # NYX @ angry "Leave him!"
    NYX @ angry "Laissez-le !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:224
translate fr qst_bloodhound_3_toBasement_235c9198:

    # NYX @ angry "{i}He's with us.{/i}"
    NYX @ angry "{i}Il est avec nous.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:233
translate fr qst_bloodhound_3_toBasement_26742987:

    # "The mages followed after him as I weakly stumbled behind them deliriously, blood pouring out of me."
    "Les mages le suivirent alors que je titubais faiblement derrière eux, en délire, du sang s'écoulant de moi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:235
translate fr qst_bloodhound_3_toBasement_e2baa4ae:

    # "Dizzy, I saw mages and Nyx fight the thing relentlessly."
    "Étourdi, je vis les mages et Nyx combattre la chose sans relâche."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:236
translate fr qst_bloodhound_3_toBasement_45fc3d08:

    # "After a few blows, the Man in black knocked back Captain Nyx before leaping through one of the glass windows, shattering it."
    "Après quelques coups, l'Homme en noir repoussa le Capitaine Nyx avant de bondir à travers l'une des fenêtres en verre, la brisant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:242
translate fr qst_bloodhound_3_toBasement_b7f2c043:

    # "From outside, we watched as he contorted his body with unnatural speed, dragging himself up unto a building and moving away too fast for us to even see."
    "De l'extérieur, nous le regardâmes se contorsionner le corps avec une vitesse surnaturelle, se hissant sur un bâtiment et s'éloignant trop vite pour que nous puissions même le voir."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:243
translate fr qst_bloodhound_3_toBasement_58688400:

    # MAGE "Captain! Do we pursue?"
    MAGE "Capitaine ! Poursuivons-nous ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:244
translate fr qst_bloodhound_3_toBasement_b9c6a5a9:

    # SECOND_MAGE "We need more time to prepare another charge!"
    SECOND_MAGE "Nous avons besoin de plus de temps pour préparer une nouvelle charge !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:258
translate fr qst_bloodhound_3_toBasement_fdeb4bdc:

    # NYX @ angry "No... Whatever that thing is, its gone."
    NYX @ angry "Non... Quelle que soit cette chose, elle est partie."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:259
translate fr qst_bloodhound_3_toBasement_d1beeab3:

    # "Unable to handle a single step more my buckling legs gave and I dropped to my knees."
    "Incapable de faire un pas de plus, mes jambes fléchirent et je tombai à genoux."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:261
translate fr qst_bloodhound_3_toBasement_2fb16082:

    # "Blood poured from all over my mangled body as I crashed forward with a thud."
    "Du sang s'écoulait de tout mon corps mutilé alors que je m'effondrais en avant avec un bruit sourd."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:264
translate fr qst_bloodhound_3_toBasement_6859ac9e:

    # NYX "SHIT!"
    NYX "MERDE!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:265
translate fr qst_bloodhound_3_toBasement_c58b41a1:

    # "Darkness."
    "Ténèbres."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:280
translate fr qst_bloodhound_3_toBasement_3e507460:

    # NYX @ shock "...Hey, HEY! He's opening his eyes!"
    NYX @ shock "...Hé, HÉ! Il ouvre les yeux !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:281
translate fr qst_bloodhound_3_toBasement_96bf910a:

    # MC "Urghh..."
    MC "Urghh..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:282
translate fr qst_bloodhound_3_toBasement_ad80ee54:

    # MAGE_TALL "We did our best to heal the creatures wounds but-"
    MAGE_TALL "Nous avons fait de notre mieux pour guérir les blessures de la créature, mais-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:283
translate fr qst_bloodhound_3_toBasement_1d30ae43:

    # MAGE_TALL "Captain... What is this thing?"
    MAGE_TALL "Capitaine... Qu'est-ce que c'est que cette chose ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:284
translate fr qst_bloodhound_3_toBasement_113a6d97:

    # MAGE_SLIM "It... It looks like a man, but earlier-"
    MAGE_SLIM "Il... Il ressemble à un homme, mais tout à l'heure-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:285
translate fr qst_bloodhound_3_toBasement_52521e89:

    # NYX @ angry "Never you mind."
    NYX @ angry "Peu importe."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:286
translate fr qst_bloodhound_3_toBasement_a42b3df1:

    # NYX @ talk "Now help him back to his feet!"
    NYX @ talk "Maintenant, aidez-le à se relever !"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:289
translate fr qst_bloodhound_3_toBasement_c6e0476f:

    # "The mages weakly helped me back to my feet which trembled and shook, barely able to hold me upright."
    "Les mages m'aidèrent faiblement à me remettre sur mes pieds qui tremblaient et vacillaient, pouvant à peine me maintenir debout."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:308
translate fr qst_bloodhound_3_toBasement_07dd01bf:

    # MC @ talk "{i}*Cough*{/i} How did you-"
    MC @ talk "{i}*Toux*{/i} Comment as-tu-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:309
translate fr qst_bloodhound_3_toBasement_06fdd052:

    # NYX @ talk "We will talk later, I will explain everything soon."
    NYX @ talk "Nous parlerons plus tard, je t'expliquerai tout bientôt."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:310
translate fr qst_bloodhound_3_toBasement_9ae00cf0:

    # "Captain Nyx turned towards the other mages."
    "La capitaine Nyx se tourna vers les autres mages."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:313
translate fr qst_bloodhound_3_toBasement_33bce3a6:

    # NYX @ angry "None of you will speak of what you have seen today, understand?"
    NYX @ angry "Aucune d'entre vous ne parlera de ce que vous avez vu aujourd'hui, compris ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:314
translate fr qst_bloodhound_3_toBasement_f9a9e350:

    # "The mages look at each other sheepishly."
    "Les mages se regardèrent timidement."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:315
translate fr qst_bloodhound_3_toBasement_675dbf11:

    # NYX @ angry "I assure you, {i}the fates will not favor you for a lack of discretion, ladies.{/i}"
    NYX @ angry "Je vous assure, {i}le destin ne vous sera pas favorable si vous manquez de discrétion, mesdemoiselles.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:316
translate fr qst_bloodhound_3_toBasement_4abde0dd:

    # "The mages all nervously nodded."
    "Les mages hochèrent toutes la tête nerveusement."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:326
translate fr qst_bloodhound_3_toBasement_d626dae3:

    # NYX @ talk "Now help me dress him."
    NYX @ talk "Maintenant, aidez-moi à l’habiller."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:330
translate fr qst_bloodhound_3_toBasement_4896de1a:

    # "The Mages eyes looked downwards as their cheeks flushed red."
    "Les mages baissèrent les yeux tandis que leurs joues s’empourpraient."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:331
translate fr qst_bloodhound_3_toBasement_7a8a690f:

    # NYX @ angry "...Oh for the love of-"
    NYX @ angry "...Oh par pitié-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:332
translate fr qst_bloodhound_3_toBasement_28ca6b76:

    # NYX @ blush "Sisters... {i}Eyes up{/i} and focus."
    NYX @ blush "Sœurs... {i}Levez les yeux{/i} et concentrez-vous."

