# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:15
translate fr qst_bloodhound_4_atFort_08507bf0:

    # "Captain Nyx spoke to some of the Nuns."
    "Le capitaine Nyx parla à quelques-unes des religieuses."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:19
translate fr qst_bloodhound_4_atFort_3357746f:

    # "As I struggled to stay awake, I couldn't focus on what was being said..."
    "Alors que je luttais pour rester éveillé, je ne pouvais pas me concentrer sur ce qui se disait..."

