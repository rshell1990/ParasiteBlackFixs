translate fr qst_bloodhound_4_atFort_7327635b:

    # "Laying beside them, I remembered how I hoped never to end up here again."
    "Étendu à côté d'eux, je me souvins combien j'avais espéré ne plus jamais me retrouver ici."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:11
translate fr qst_bloodhound_4_atFort_b0c99eb3:

