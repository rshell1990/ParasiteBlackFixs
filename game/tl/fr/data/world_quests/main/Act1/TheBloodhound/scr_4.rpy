translate fr qst_bloodhound_4_hospital_nyxChoices_c5aabc37:

    # NYX @ talk "Whatever Azul uncovered brought him into the sights of some {i}powerful{/i} people."
    NYX @ talk "Quoi qu'Azul ait découvert, cela l'a mis dans la ligne de mire de personnes {i}puissantes{/i}."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:143
translate fr qst_bloodhound_4_hospital_nyxChoices_a0d4bfdb:

    # NYX @ talk "That thing didn't just kill him, it destroyed all of the sensitive information Azul had been gathering."
    NYX @ talk "Cette chose ne l'a pas seulement tué, elle a détruit toutes les informations sensibles qu'Azul avait rassemblées."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:144
translate fr qst_bloodhound_4_hospital_nyxChoices_c1fe3b09:

    # NYX @ angry "Whatever he found, Azul got too close."
    NYX @ angry "Quoi qu'il ait trouvé, Azul s'est trop approché."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:145
translate fr qst_bloodhound_4_hospital_nyxChoices_a70e4233:

    # MC @ talk "...If that {i}thing{/i} had already killed Azul, why leave the body like that?"
    MC @ talk "...Si cette {i}chose{/i} avait déjà tué Azul, pourquoi laisser le corps comme ça ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:146
translate fr qst_bloodhound_4_hospital_nyxChoices_7eb21b6a:

    # MC @ talk "Why was the thing still down there... {i}waiting?{/i}"
    MC @ talk "Pourquoi la chose était-elle encore en bas... {i}à attendre ?{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:147
translate fr qst_bloodhound_4_hospital_nyxChoices_19b37a1a:

    # NYX @ angry "I believe it was waiting {i}for me.{/i}"
    NYX @ angry "Je crois qu'elle attendait {i}pour moi.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:148
translate fr qst_bloodhound_4_hospital_nyxChoices_0a6e91e3:

    # NYX @ angry "No doubt whoever is at play here knows of my involvement and would rather have me silenced."
    NYX @ angry "Nul doute que celui qui tire les ficelles ici est au courant de mon implication et préférerait me faire taire."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:149
translate fr qst_bloodhound_4_hospital_nyxChoices_a8914fff:

    # NYX @ angry "As for why the body was left there?"
    NYX @ angry "Quant à savoir pourquoi le corps a été laissé là ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:150
translate fr qst_bloodhound_4_hospital_nyxChoices_4b0c0176:

    # NYX @ angry "Perhaps as a warning... A message, in case that monster failed."
    NYX @ angry "Peut-être comme un avertissement... Un message, au cas où ce monstre aurait échoué."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:151
translate fr qst_bloodhound_4_hospital_nyxChoices_4331e288:

    # "I felt ill with the thought."
    "Je me sentais mal à cette pensée."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:152
translate fr qst_bloodhound_4_hospital_nyxChoices_47394e6f:

    # "What kind of a person leaves a warning like {i}that?{/i}"
    "Quel genre de personne laisse un avertissement comme {i}ça{/i} ?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:153
translate fr qst_bloodhound_4_hospital_nyxChoices_91172795:

    # NYX @ talk "...Oh, that reminds me, here."
    NYX @ talk "...Ah, ça me rappelle, tiens."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:154
translate fr qst_bloodhound_4_hospital_nyxChoices_c565abe5:

    # NYX @ talk "Your reward."
    NYX @ talk "Ta récompense."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:157
translate fr qst_bloodhound_4_hospital_nyxChoices_718bb0b3:

    # NYX @ talk "Well, I best leave you be for now."
    NYX @ talk "Bon, je ferais mieux de te laisser tranquille pour l'instant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:158
translate fr qst_bloodhound_4_hospital_nyxChoices_480d38ed:

    # NYX @ talk "Watch yourself [player_name!t]..."
    NYX @ talk "Fais attention à toi, [player_name!t]..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:159
translate fr qst_bloodhound_4_hospital_nyxChoices_dadbefbb:

    # NYX @ angry "{i}You might be in their sights too now.{/i}"
    NYX @ angry "{i}Tu pourrais aussi être dans leur viseur maintenant.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:161
translate fr qst_bloodhound_4_hospital_nyxChoices_9ee63cbf:

    # "As Nyx left, I dropped my head back onto the pillow."
    "Alors que Nyx partait, j'ai laissé retomber ma tête sur l'oreiller."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:165
translate fr qst_bloodhound_4_hospital_nyxChoices_081ba91b:

    # MC "(...Fucking great.)"
    MC "(...Putain, génial.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:170
translate fr qst_bloodhound_4_hospital_nyxChoices_9650db8e:

    # "A couple hours later, a nun came by and said I could leave now."
    "Quelques heures plus tard, une nonne est passée et m'a dit que je pouvais partir maintenant."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:171
translate fr qst_bloodhound_4_hospital_nyxChoices_15ffe5e3:

    # "Leaving the hospital ward, I let out a grim chuckle at myself hoping to not end up here again."
    "En quittant la salle d'hôpital, je ricane sinistrement de moi-même, espérant ne pas revenir ici."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:172
translate fr qst_bloodhound_4_hospital_nyxChoices_aca943c2:

    # MC "(Back into the world of the living...)"
    MC "(De retour dans le monde des vivants...)"

