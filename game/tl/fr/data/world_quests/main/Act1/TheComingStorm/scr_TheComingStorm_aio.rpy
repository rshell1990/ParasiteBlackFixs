# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1455
translate fr qst_thecomingstorm_poltrik_family_estate_3c1f7fb0:

    # "...Upon arriving at the house, the air felt wrong."
    "...En arrivant à la maison, l'air semblait étrange."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1456
translate fr qst_thecomingstorm_poltrik_family_estate_15f1df38:

    # "Not a single light flickered within the darkened windows."
    "Pas une seule lumière ne scintillait à travers les fenêtres obscures."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1457
translate fr qst_thecomingstorm_poltrik_family_estate_83a9be09:

    # "The curtains were drawn, and the home sat eerily still."
    "Les rideaux étaient tirés, et la maison était étrangement silencieuse."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1458
translate fr qst_thecomingstorm_poltrik_family_estate_825c7592:

    # "The front yard, once well-kept, had been left to ruin—the grass growing wild, untamed."
    "La cour avant, autrefois bien entretenue, était laissée à l'abandon—l'herbe poussait à l'état sauvage, indomptée."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1460
translate fr qst_thecomingstorm_poltrik_family_estate_3467155c:

    # "A cold wind swept through the empty streets, and with it came a sensation that clawed at the back of my mind."
    "Un vent froid balayait les rues vides, et avec lui venait une sensation qui me griffait l'arrière de l'esprit."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1461
translate fr qst_thecomingstorm_poltrik_family_estate_f5e3d737:

    # "{i}Something was wrong here.{/i}"
    "{i}Quelque chose n'allait pas ici.{/i}"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1463
translate fr qst_thecomingstorm_poltrik_family_estate_12329a47:

    # "Then, the scent hit me."
    "Puis, l'odeur m'a frappé."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1464
translate fr qst_thecomingstorm_poltrik_family_estate_fa9c65f9:

    # "That putrid, rotting stench. The same one I had smelled before."
    "Cette puanteur putride et pourrissante. La même que j'avais sentie auparavant."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1465
translate fr qst_thecomingstorm_poltrik_family_estate_e0c2dff4:

    # "It seeped from the very walls of the house. Sickly sweet. Overpowering."
    "Elle suintait des murs mêmes de la maison. Écoeurante et douce. Irrésistible."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1466
translate fr qst_thecomingstorm_poltrik_family_estate_8b582965:

    # MARKUS @ think "You smell it... right?"
    MARKUS @ think "Tu la sens... n'est-ce pas ?"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1467
translate fr qst_thecomingstorm_poltrik_family_estate_73c488a9:

    # MC @ serious "Yeah."
    MC @ serious "Ouais."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1468
translate fr qst_thecomingstorm_poltrik_family_estate_9c7b13ad:

    # MC @ serious "We move carefully."
    MC @ serious "On avance prudemment."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1469
translate fr qst_thecomingstorm_poltrik_family_estate_ebc93d9c:

    # "As we approached the wooden door, we considered our options."
    "Alors que nous approchions de la porte en bois, nous avons envisagé nos options."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1472
translate fr qst_thecomingstorm_poltrik_family_estate_menu_c514dfa9:

    # "I rapped my knuckles against the wood a couple times."
    "J'ai tapé mes phalanges contre le bois à plusieurs reprises."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1474
translate fr qst_thecomingstorm_poltrik_family_estate_menu_97d7e1ff:

    # "...Nothing."
    "...Rien."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1475
translate fr qst_thecomingstorm_poltrik_family_estate_menu_3761ed9c:

    # MARKUS @ think "{i}...Were you really expecting that to work?{/i}"
    MARKUS @ think "{i}...Tu t'attendais vraiment à ce que ça marche ?{/i}"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1479
translate fr qst_thecomingstorm_poltrik_family_estate_menu_b660f325:

    # "I grabbed the handle and twisted."
    "J'ai saisi la poignée et je l'ai tournée."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1481
translate fr qst_thecomingstorm_poltrik_family_estate_menu_04752cdf:

    # "Unsurprisingly, it was locked."
    "Sans surprise, c'était verrouillé."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1488
translate fr qst_thecomingstorm_poltrik_family_estate_menu_05534a52:

    # "With a sharp, hard boot, the door slammed open, the hinges groaning in protest."
    "D'un coup de botte sec et puissant, la porte s'ouvrit violemment, les gonds grinçant en signe de protestation."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1489
translate fr qst_thecomingstorm_poltrik_family_estate_menu_3d637ddb:

    # MARKUS @ talk "Well... That's one way to announce our arrival."
    MARKUS @ talk "Eh bien... C'est une façon d'annoncer notre arrivée."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1490
translate fr qst_thecomingstorm_poltrik_family_estate_menu_4becea67:

    # MC @ think "Did you have a better idea?"
    MC @ think "Tu avais une meilleure idée?"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1491
translate fr qst_thecomingstorm_poltrik_family_estate_menu_b61b131f:

    # MARKUS @ talk "Sure. We torch the place from the outside and then head to the Iron—"
    MARKUS @ talk "Bien sûr. On met le feu à l'endroit depuis l'extérieur et ensuite on se dirige vers le Fer—"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1496
translate fr qst_thecomingstorm_poltrik_family_estate_menu_55ac44c5:

    # "Taking one of the hair pins, I knelt down and fiddled with the lock for a while."
    "Prenant une des épingles à cheveux, je m'agenouillai et tripotai la serrure un moment."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1497
translate fr qst_thecomingstorm_poltrik_family_estate_menu_e57905ec:

    # "Markus raised a brow as he watched me work, no doubt curious as to where I learned such a trick."
    "Markus haussa un sourcil en me regardant travailler, sans doute curieux de savoir où j'avais appris un tel tour."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1498
translate fr qst_thecomingstorm_poltrik_family_estate_menu_1a1cfcb9:

    # "As the door 'clicked' I turned the lock and gently pushed the door open."
    "Lorsque la porte fit un 'clic', je tournai la serrure et poussai doucement la porte pour l'ouvrir."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1502
translate fr qst_thecomingstorm_poltrik_family_estate_menu_f6afc786:

    # MARKUS @ talk "... Good enough for me."
    MARKUS @ talk "... Ça me suffit."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1510
translate fr qst_thecomingstorm_poltrik_family_estate_menu_c4f7511a:

    # "The two of us froze."
    "Nous nous figeâmes tous les deux."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1511
translate fr qst_thecomingstorm_poltrik_family_estate_menu_9e5027ce:

    # "As the door swung open, we were met with a vision from a nightmare."
    "Lorsque la porte s'ouvrit, nous fûmes accueillis par une vision de cauchemar."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1512
translate fr qst_thecomingstorm_poltrik_family_estate_menu_01b83f04:

    # "The once-grand interior had been reduced to a butcher's slaughterhouse."
    "L'intérieur autrefois grandiose avait été réduit à un abattoir de boucher."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1513
translate fr qst_thecomingstorm_poltrik_family_estate_menu_90b7cdac:

    # "Skinless corpses hung upside down from the ceiling, stripped to bare muscle and bone."
    "Des cadavres sans peau pendaient la tête en bas du plafond, dépouillés jusqu'aux muscles et aux os."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1514
translate fr qst_thecomingstorm_poltrik_family_estate_menu_c4be4c76:

    # "Blood pooled across the marble floor, seeping through the cracks, thick and dark."
    "Le sang formait des flaques sur le sol de marbre, s'infiltrant dans les fissures, épais et sombre."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1515
translate fr qst_thecomingstorm_poltrik_family_estate_menu_41064796:

    # "The walls—once adorned with noble decorations—were now drenched in red, clawed apart by something inhuman."
    "Les murs — autrefois ornés de décorations nobles — étaient maintenant trempés de rouge, déchiquetés par quelque chose d'inhumain."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1517
translate fr qst_thecomingstorm_poltrik_family_estate_menu_82745b70:

    # "Markus clamped a hand over his mouth, struggling to contain the bile rising in his throat."
    "Markus plaqua une main sur sa bouche, luttant pour contenir la bile qui lui montait à la gorge."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1518
translate fr qst_thecomingstorm_poltrik_family_estate_menu_69ce6828:

    # MC @ serious "{i}What... the fuck is this?{/i}"
    MC @ serious "{i}Qu'est-ce que... c'est que ce bordel ?{/i}"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1520
translate fr qst_thecomingstorm_poltrik_family_estate_menu_29ff1ca2:

    # "At the center of the room, where a dining table might have once stood, a grotesque mound of flesh sat piled high."
    "Au centre de la pièce, là où une table à manger aurait pu se trouver autrefois, un monticule grotesque de chair entassée s'élevait."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1522
translate fr qst_thecomingstorm_poltrik_family_estate_menu_86287958:

    # "Intestines. Organs. Skin. Dumped in a heap."
    "Intestins. Organes. Peau. Jetés en tas."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1523
translate fr qst_thecomingstorm_poltrik_family_estate_menu_896249e0:

    # "Flies buzzed in an unholy symphony, circling the monstrous offering."
    "Les mouches bourdonnaient dans une symphonie impie, tournant autour de l'offrande monstrueuse."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1524
translate fr qst_thecomingstorm_poltrik_family_estate_menu_0b5a34ed:

    # MARKUS @ scared "What kind of nightmare is this?!"
    MARKUS @ scared "Quel genre de cauchemar est-ce ?!"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1525
translate fr qst_thecomingstorm_poltrik_family_estate_menu_0cb12ff6:

    # "Then, our eyes lifted to the ceiling."
    "Puis, nos yeux se sont levés vers le plafond."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1526
translate fr qst_thecomingstorm_poltrik_family_estate_menu_7e834076:

    # "Dark green, bulbous eggs clung to the rafters, pulsating softly."
    "Des œufs d'un vert sombre et bulbeux s'accrochaient aux chevrons, pulsant doucement."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1527
translate fr qst_thecomingstorm_poltrik_family_estate_menu_74ae2451:

    # "Each was the size of a child, their slimy shells shifting as something inside pressed against the walls."
    "Chacun avait la taille d'un enfant, leurs coquilles visqueuses se déformant tandis que quelque chose à l'intérieur poussait contre les parois."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1530
translate fr qst_thecomingstorm_poltrik_family_estate_menu_1334cad7:

    # MYU @ scared "H-Home! We go home!"
    MYU @ scared "M-Maison ! On rentre à la maison !"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1531
translate fr qst_thecomingstorm_poltrik_family_estate_menu_de377bd4:

    # MYU @ scared "Myu no like!"
    MYU @ scared "Myu pas aimer !"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1532
translate fr qst_thecomingstorm_poltrik_family_estate_menu_d47b469c:

    # MC @ serious "Calm yourself, Myu."
    MC @ serious "Calme-toi, Myu."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1536
translate fr qst_thecomingstorm_poltrik_family_estate_menu_d77bc44c:

    # ELENA @ angry "I don't like this... We should wait for Captain Nyx and the other guards."
    ELENA @ angry "Je n'aime pas ça... Nous devrions attendre le capitaine Nyx et les autres gardes."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1546
translate fr qst_thecomingstorm_poltrik_family_estate_snuckin_149dbee7:

    # MC @ serious "Now... While we have the element of surprise, we can kill them while they sleep."
    MC @ serious "Maintenant... Tant que nous avons l'effet de surprise, nous pouvons les tuer pendant leur sommeil."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1547
translate fr qst_thecomingstorm_poltrik_family_estate_snuckin_32187107:

    # MARKUS @ angry "Now would have been a lovely time for someone here to have some fire magecraft... But I guess our blades will do."
    MARKUS @ angry "Cela aurait été le bon moment pour que quelqu'un ici ait de la magie du feu... Mais je suppose que nos lames feront l'affaire."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1550
translate fr qst_thecomingstorm_poltrik_family_estate_snuckin_0f510ccb:

    # "The others nodded sheepishly, as each of us carefully found one of those wretching pulsing sacks of flesh."
    "Les autres hochèrent la tête d'un air penaud, tandis que chacun d'entre nous trouvait soigneusement l'un de ces répugnants sacs de chair palpitants."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1551
translate fr qst_thecomingstorm_poltrik_family_estate_snuckin_b7834ded:

    # "Timed just right, each of us destroyed the sacks and killed the wretched, sleeping creatures inside one by one."
    "Au bon moment, chacun de nous détruisit les sacs et tua les misérables créatures endormies à l'intérieur une par une."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1552
translate fr qst_thecomingstorm_poltrik_family_estate_snuckin_67f47e67:

    # "One tried to scream, awakening at just the right moment, but as the blade sliced across it's throat only a gargled bloody choke escape it's lips."
    "L'une d'elles tenta de crier, se réveillant juste au bon moment, mais lorsque la lame trancha sa gorge, seul un étranglement gargouillant et sanglant s'échappa de ses lèvres."

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1553
