    NYX @ talk "Je veux que tu sortes et que tu envoies un message."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:67
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_b860df6b:

