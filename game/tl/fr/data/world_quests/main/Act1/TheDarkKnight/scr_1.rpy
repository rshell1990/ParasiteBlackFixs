# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:59
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_02682086:

    # NYX @ talk "Your services are called upon to serve the Kingdom once again."
    NYX @ talk "Vos services sont à nouveau requis pour servir le Royaume."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:60
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_d9e10f0a:

    # NYX @ talk "I don't know how aware you are with how 'fragile' things can be in this city, but suffice to say, I'm in need of a sellsword like yourself."
    NYX @ talk "Je ne sais pas à quel point vous êtes conscient de la 'fragilité' des choses dans cette ville, mais il suffit de dire que j'ai besoin d'un mercenaire comme vous."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:61
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_6f18111b:

    # NYX @ talk "You'll be well compensated for your services."
    NYX @ talk "Tu seras bien rémunéré pour tes services."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:62
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_4b2d3807:

    # MC @ talk "Depends on the job."
    MC @ talk "Ça dépend du boulot."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:63
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_d2a7d24e:

    # NYX @ talk "These last few months, we've seen an explosion in banditry around the city."
    NYX @ talk "Ces derniers mois, on a vu une explosion du banditisme autour de la ville."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:64
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_b450829f:

    # NYX @ talk "It seems some of the smaller crime factions inside the city have splintered, and the ensuing chaos is spilling out onto the street."
    NYX @ talk "Il semble que certaines des petites factions criminelles de la ville se soient fragmentées, et le chaos qui en résulte se répand dans les rues."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:65
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_87b2aadb:

    # NYX @ angry "Soon the fuckers will be trying to rob people in bloody daylight if we don't stomp it out now."
    NYX @ angry "Bientôt ces enfoirés essaieront de détrousser les gens en plein jour si on n'écrase pas ça maintenant."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:66
translate fr qst_DarkKnight_1_GoToCaptainNyxOffice_5090010f:

