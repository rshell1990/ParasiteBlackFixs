    LUKKAN @ talk "Au sud d'ici, nous avons remarqué un mouvement considérable des Demorai ces derniers jours."

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:43
translate fr qst_TwoEmperors_0_7b5785a2:

    # LUKKAN @ talk "They've also been acting... {i}strangely,{/i} recently."
    LUKKAN @ talk "Ils ont aussi agi... {i}étrangement,{/i} récemment."

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:44
