    MC @ think "{i}Étrangement ?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:45
translate fr qst_TwoEmperors_0_a9a5f220:

    # LUKKAN @ talk "Keeping their distance... Watching troops move but not attacking."
    LUKKAN @ talk "Gardant leurs distances... Regardant les troupes bouger sans attaquer."

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:46
translate fr qst_TwoEmperors_0_82a65454:

    # MC @ talk "Maybe they're just scouting?"
    MC @ talk "Peut-être sont-ils simplement en train d'effectuer une reconnaissance ?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:47
translate fr qst_TwoEmperors_0_ada16c97:

    # LUKKAN @ talk "Maybe, but it's not like them to avoid ambushes or a fight, and they to be more focused on getting somewhere."
    LUKKAN @ talk "Peut-être, mais ce n'est pas dans leurs habitudes d'éviter les embuscades ou un combat, et ils semblent plus concentrés sur le fait de se rendre quelque part."

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:48
translate fr qst_TwoEmperors_0_0a4161b9:

    # LUKKAN @ talk "We want you to find out what's going on out there."
    LUKKAN @ talk "Nous voulons que tu découvres ce qui se passe là-bas."

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:53
translate fr qst_TwoEmperors_0_menu1_8982004f:

    # LUKKAN @ talk "What? Did you seriously think we'd just let you fuck around in the Adventurers Guild forever?"
    LUKKAN @ talk "Quoi ? Pensais-tu sérieusement qu'on te laisserait glander à la Guilde des Aventuriers pour toujours ?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:54
translate fr qst_TwoEmperors_0_menu1_3e037774:

    # LUKKAN @ talk "No no no no... That's not how this works."
    LUKKAN @ talk "Non non non non... Ce n'est pas comme ça que ça marche."

