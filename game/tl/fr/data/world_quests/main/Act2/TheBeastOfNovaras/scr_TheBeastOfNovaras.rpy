# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1263
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_72bdb921:

    # "My eyes peeled open as I stared out at the carnage before me."
    "Mes yeux s'ouvrirent d'un coup alors que je contemplais le carnage devant moi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1264
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_dec204cd:

    # "The arena was drenched in blood as the Caltrack flailed; bodies and torn limbs littered the ground as people screamed."
    "L'arène était trempée de sang tandis que le Caltrack se débattait ; des corps et des membres arrachés jonchaient le sol tandis que les gens hurlaient."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1265
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8a00a866:

    # "Even Sypha, usually smug and composed, was barking orders."
    "Même Sypha, d'ordinaire suffisante et posée, aboyait des ordres."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1266
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_6fc3a72a:

    # "Staggering, bleeding, forcing the others to keep moving and fight."
    "Chancelante, saignante, forçant les autres à continuer d'avancer et de se battre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1267
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_9d245642:

    # "Now, with the Caltrack's eyes fixed on her, Sypha's pupils widened; for the first time, I saw fear in her face."
    "Maintenant, les yeux du Caltrack rivés sur elle, les pupilles de Sypha s'écarquillèrent ; pour la première fois, je vis de la peur sur son visage."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1268
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8a29f88d:

    # "Any moment, it would come crashing down on her and her exhausted body wouldn't move in time..."
    "D'un instant à l'autre, il s'abattrait sur elle et son corps épuisé ne bougerait pas à temps..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1269
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_3226ef70:

    # "{i}...But something moved inside me now.{/i}"
    "{i}...Mais quelque chose a bougé en moi maintenant.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1270
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_b89032c8:

    # "I felt my whole body act on its own, rising as a hot surge of energy flooded through me."
    "J'ai senti tout mon corps agir de lui-même, se soulevant tandis qu'une vague d'énergie chaude me traversait."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1271
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_42819c2d:

    # "{i}What was going on?{/i}"
    "{i}Que se passait-il ?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1273
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_aeaf7911:

    # "Moments ago, I was dying, and now..."
    "Il y a quelques instants, j'agonisais, et maintenant..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1274
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_c8bf02ac:

    # "I sprang forward. Faster than before."
    "Je bondis en avant. Plus vite qu'auparavant."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1275
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_ad41bb57:

    # "Faster than I'd ever moved."
    "Plus vite que je n'avais jamais bougé."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1277
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f01b3c92:

    # "With a single motion, I swept Sypha from the sand and yanked her clear of the snapping jaws."
    "D'un seul geste, j'arrachai Sypha du sable et la tirai hors d'atteinte des mâchoires claquantes."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1278
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8fa10aa1:

    # "She stared up at me, shock and disbelief warring in her eyes."
    "Elle me fixa, le choc et l'incrédulité se disputant dans ses yeux."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1279
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_e3fb0534:

    # "I set her down gently and turned back to the Caltrack."
    "Je la déposai doucement et me retournai vers le Caltrack."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1280
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_4cfa3603:

    # "It snapped one of its many jaws toward me."
    "L’une de ses nombreuses mâchoires a claqué vers moi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1281
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_bb5a2503:

    # "A quick pivot carried me past it."
    "Une rapide rotation m’a permis de l’éviter."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1283
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f96435af:

    # "A tentacle latched on and punched through the creature's cheek as I flung myself into the air, crashing down onto one of its heads and driving my claws through its eye."
    "Un tentacule s’est accroché et a transpercé la joue de la créature alors que je me projetais en l’air, m’écrasant sur l’une de ses têtes et enfonçant mes griffes dans son œil."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1285
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8afbe17f:

    # "The beast bellowed, thrashing, a shriek so sharp the crowd clamped hands over ears."
    "La bête a hurlé, se débattant, un cri si perçant que la foule s’est couvert les oreilles."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1286
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_30842b18:

    # "{i}I wasn't controlling my limbs.{/i}"
    "{i}Je ne contrôlais pas mes membres.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1287
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_86951371:

    # "{i}I didn't even know I *could* move like this.{/i}"
    "{i}Je ne savais même pas que je *pouvais* bouger comme ça.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1288
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_3c70e601:

    # "{i}What was happening?{/i}"
    "{i}Qu’est-ce qui m’arrivait ?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1289
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8920d71f:

    # "I slid and rolled down, claws grinding through jelly and bone, carving the socket wide."
    "J’ai glissé et roulé en bas, les griffes broyant gelée et os, creusant l’orbite en large."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1290
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8279394b:

    # "{i}Were my claws sharper?{/i}"
    "{i}Mes griffes étaient-elles plus tranchantes ?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1291
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_87a7a085:

    # "{i}My muscles stronger?{/i}"
    "{i}Mes muscles plus forts ?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1292
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_cc821a2e:

    # "Landing, I dragged my talons in a clean arc, severing the throat of one Caltrack head."
    "Atterrissant, je traçai un arc net avec mes serres, tranchant la gorge d'une tête du Caltrack."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1293
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_aec21242:

    # "It staggered back, one head limp, the others panicking."
    "Il recula en titubant, une tête inerte, les autres prises de panique."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1296
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_fcfb1fa6:

    # "In a last, desperate lunge, it charged."
    "Dans un dernier élan désespéré, il chargea."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1297
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f8420303:

    # "I moved like lightning, {i}no{/i}, like something beyond it, hurling myself with my tentacles, a straight shot that punched clean through the Caltrack's chest and burst out its spine, leaving a gaping hole in my wake."
    "Je bougeai comme l'éclair, {i}non{/i}, comme quelque chose qui le dépasse, me projetant avec mes tentacules, un tir droit qui traversa la poitrine du Caltrack de part en part et lui fit éclater la colonne vertébrale, laissant un trou béant dans mon sillage."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1298
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_7c29366c:

    # "It's heads swayed in the air for a few moments, as though the creature itself was trying to understand what had just happened to it."
    "Ses têtes oscillèrent dans l'air pendant quelques instants, comme si la créature elle-même essayait de comprendre ce qui venait de lui arriver."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1301
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_0de8f749:

    # "The creature tumbled lifelessly forward, smashing its heads against the wall, twitching in final spasms."
    "La créature s'effondra sans vie en avant, écrasant ses têtes contre le mur, tressaillant de spasmes finaux."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1302
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_6af42d98:

    # "The crowds stared in stunned silence."
    "Les foules regardaient dans un silence stupéfait."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1303
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_b1af4655:

    # "What had they just witnessed?"
    "De quoi venaient-ils d'être témoins ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1304
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_5e9bc9b3:

    # "A monster that could fell armies not merely defeated but {i}eviscerated{/i}."
    "Un monstre capable d'abattre des armées, non pas simplement vaincu, mais {i}éviscéré{/i}."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1305
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_075d7561:

    # "Destroyed by a perfect predator."
    "Détruit par un prédateur parfait."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1306
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_987bf0f8:

    # "{i}A god of the arena.{/i}"
    "{i}Un dieu de l'arène.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1307
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_15e6e6c7:

    # "My arms lifted on their own, and a voice thundered that wasn't mine."
    "Mes bras se sont levés d'eux-mêmes, et une voix a tonné qui n'était pas la mienne."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1309
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_ec319721:

    # SHYAHTAN "I AM SHYAHTAN! LORD OF A THOUSAND STARS, UNBOWED AND UNBROKED! BRING ME YOUR KINGS OF MEN AND PETTY GODS SO THEY MAY TREMBLE BEFORE ME!"
    SHYAHTAN "JE SUIS SHYAHTAN ! SEIGNEUR DE MILLE ÉTOILES, INFLÉCHI ET INVAINCU ! APPORTEZ-MOI VOS ROIS DES HOMMES ET VOS PETITS DIEUX AFIN QU'ILS TREMBLENT DEVANT MOI !"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1310
translate fr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_846ff733:

