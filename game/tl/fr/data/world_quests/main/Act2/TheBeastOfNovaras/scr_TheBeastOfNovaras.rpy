    # HIVE_LORD "...Do you remember the Hive Wars, Shyahtan?"
    HIVE_LORD "...Te souviens-tu des Guerres de la Ruche, Shyahtan ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1217
translate fr qst_TheBeastOfNovaras_ReturnFromMerlanians_a3e3e6f7:

