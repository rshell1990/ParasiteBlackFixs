    "Alors que j'arrivais devant la grande entrée de la demeure du seigneur Zanzibat, deux gardes s'approchèrent."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1845
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_45e957f2:

    # GUARD "What business have you here?"
    GUARD "Quelle affaire vous amène ici ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1847
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_77dae88a:

    # YARRICK @ smile "Ahh, I'm just in time."
    YARRICK @ smile "Ahh, j'arrive juste à temps."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1848
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_fdfb10ec:

    # YARRICK @ smile "Your master has business here with my client."
    YARRICK @ smile "Votre maître a affaire ici avec mon client."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1849
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_a97d1501:

    # "The guard looked me up and down."
    "Le garde me toisa de haut en bas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1850
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_bdeffe71:

    # GUARD "And what business is that?"
    GUARD "Et de quelle affaire s'agit-il ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1851
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_a3b0eb4b:

    # YARRICK @ angry "You're speaking to the savior of Hamun, the beast of Novaras himself boy!"
    YARRICK @ angry "Tu t'adresses au sauveur de Hamun, la bête de Novaras en personne, mon garçon !"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1852
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_302828eb:

    # YARRICK @ angry "Do you wish to explain to your master how you turned away such an esteemed guest?"
    YARRICK @ angry "Souhaites-tu expliquer à ton maître comment tu as éconduit un invité aussi prestigieux ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1854
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_9168a9cf:

    # GUARD "... I shall check with Lord Zanzibat."
    GUARD "... Je vais me renseigner auprès de lord Zanzibat."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1855
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_d0100793:

    # GUARD "Wait here a moment."
    GUARD "Attendez ici un instant."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1857
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_637cb91a:

    # YARRICK @ smile "Well, that went better than expected."
    YARRICK @ smile "Eh bien, cela s'est mieux passé que prévu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1859
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_8183380c:

    # MC @ think "Why wouldn't it?"
    MC @ think "Pourquoi en serait-il autrement ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1860
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_3360298a:

    # YARRICK @ think "Lord Zanzibat is... fickle."
    YARRICK @ think "Lord Zanzibat est... lunatique."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1861
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_37ef9f55:

    # YARRICK @ think "Many a merchant has tried to meet him only for him to keep changing the time and date."
    YARRICK @ think "Nombre de marchands ont tenté de le rencontrer, mais il ne fait que changer sans cesse la date et l'heure."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1862
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_e88b8f50:

    # YARRICK @ think "{i}I believe he finds it amusing to see the lengths people will go to speak to him.{/i}"
    YARRICK @ think "{i}Je crois qu'il trouve amusant de voir jusqu'où les gens sont prêts à aller pour lui parler.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1868
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_700ae275:

    # GUARD "Lord Zanzibat is ready to receive you."
    GUARD "Le seigneur Zanzibat est prêt à vous recevoir."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1869
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_2f76c7a9:

    # "As Yarrick stepped forward, the guard blocked his path."
    "Alors que Yarrick s'avançait, le garde lui barra le chemin."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1870
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_ed310237:

    # GUARD "Not you."
    GUARD "Pas toi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1871
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_e4e67f64:

    # GUARD "{i}Him.{/i}"
    GUARD "{i}Lui.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1872
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_539c85ab:

    # "A disgruntled Yarrick took a step back, flashing me an awkward smile."
    "Un Yarrick mécontent recula d'un pas, m'adressant un sourire gêné."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1874
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_cb394247:

    # YARRICK @ smile "I shall see you around I hope?"
    YARRICK @ smile "Je te reverrai bien, j'espère ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1875
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_9553e143:

    # YARRICK @ smile "Consider us even now."
    YARRICK @ smile "Considère que nous sommes quittes maintenant."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1881
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_3c99283f:

    # "I nodded lightly, before following the guard."
    "J'acquiesçai légèrement, avant de suivre le garde."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1889
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_9dd51684:

    # "Lord Zanzibat's home was unexpected. Ornate, and yet, plants, trees... A flowing stream of water through the centre."
    "La demeure du seigneur Zanzibat était inattendue. Ornée, et pourtant, des plantes, des arbres... Un ruisseau d'eau qui coulait au centre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1890
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_4502d254:

    # "It was more like standing inside a garden in the middle of the desert than it was a home."
    "C'était plus comme se trouver dans un jardin au milieu du désert qu'une maison."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1891
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_0de86d18:

    # "As I heard the clap of hands, I turned towards Lord Zanzibat."
    "En entendant le claquement de mains, je me tournai vers Lord Zanzibat."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1894
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_813bc6bc:

    # "Lord Zanzibat was not a towering figure, rather he was skinny, almost effeminate."
    "Lord Zanzibat n'était pas une figure imposante, il était plutôt maigre, presque efféminé."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1895
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_f215eac7:

    # ZANZIBAT @ smile "I had many of them imported from Sylvania."
    ZANZIBAT @ smile "J'en ai fait importer beaucoup de Sylvania."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1896
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_1dce7595:

    # ZANZIBAT @ smile "It cost me a fortune of course, but..."
    ZANZIBAT @ smile "Cela m'a coûté une fortune bien sûr, mais..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1897
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_e2b29dc5:

    # ZANZIBAT @ smile "I find they bring me great comfort."
    ZANZIBAT @ smile "Je trouve qu'ils m'apportent un grand réconfort."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1898
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_95ffb076:

    # MC @ talk "Lord Zanzibat."
    MC @ talk "Lord Zanzibat."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1900
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_5033cf1d:

    # "I gave a curtly bow."
    "Je fis un salut sec."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1901
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_938a175d:

    # MC @ talk "You honour me with this meeting."
    MC @ talk "Vous m'honorez de cette rencontre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1902
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_7d53c472:

    # ZANZIBAT @ talk "Well, how could I resist a chance to meet the saviour of Novaras?"
    ZANZIBAT @ talk "Eh bien, comment pourrais-je résister à l'occasion de rencontrer le sauveur de Novaras ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1903
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_9421f81a:

    # ZANZIBAT @ talk "And especially after that arena performance..."
    ZANZIBAT @ talk "Et surtout après cette performance dans l'arène..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1904
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_06bfc572:

    # MC @ smile "It was a little closer than I would have liked."
    MC @ smile "C'était un peu plus serré que je ne l'aurais souhaité."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1905
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_192088ef:

    # ZANZIBAT @ smile "Mmm... I did think for a moment your blood might spill on the sands."
    ZANZIBAT @ smile "Mmm... J'ai bien cru un instant que ton sang allait se répandre sur le sable."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1906
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_f00b249b:

    # ZANZIBAT @ smile "But that rage at the end... It was..."
    ZANZIBAT @ smile "Mais cette rage à la fin... C'était..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1907
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_88c629bd:

    # ZANZIBAT @ smile "Spectacular."
    ZANZIBAT @ smile "Spectaculaire."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1908
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_d96919ec:

    # "That rage... That blinding hot rage where my body moved without me, where the dark passenger – Shyahtan or whatever his name was, took full control."
    "Cette rage... Cette rage aveuglante et brûlante où mon corps bougeait sans moi, où le passager sombre – Shyahtan ou quel que soit son nom, a pris le contrôle total."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1909
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_530f4eb0:

    # "I couldn't help but feel... Uncomfortable by the thought."
    "Je n'ai pas pu m'empêcher de me sentir... Mal à l'aise à cette pensée."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1910
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_6549fa11:

    # MC @ talk "... I've come here to ask something of you."
    MC @ talk "... Je suis venu ici pour te demander quelque chose."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1911
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_e858e11e:

    # ZANZIBAT @ smile "Oh, this is a first."
    ZANZIBAT @ smile "Oh, c'est une première."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1912
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_6b05abff:

    # ZANZIBAT @ talk "Normally, I make the offer and let you think on it."
    ZANZIBAT @ talk "Normalement, je fais l'offre et je te laisse y réfléchir."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1913
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_8997b2f2:

    # ZANZIBAT @ talk "Now you have my attention, what is it you want?"
    ZANZIBAT @ talk "Maintenant que tu as mon attention, que veux-tu ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1914
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_d934f6d3:

    # MC @ talk "You're one of the last barriers blocking the deal between Novaras and the Greater Trading Company... I want you to let it pass."
    MC @ talk "Vous êtes l’un des derniers remparts qui bloquent l’accord entre Novaras et la Grande Compagnie marchande… Je veux que vous le laissiez passer."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1915
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_443ecd71:

    # "Lord Zanzibat considered my words carefully as he slowly paced around the room, gently brushing his hand along one of the plants."
    "Le seigneur Zanzibat étudia mes paroles avec attention tandis qu’il arpentait lentement la pièce, effleurant une plante de la main."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1916
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_61aa857f:

    # ZANZIBAT @ talk "Tell me... do you know why Hamun is still free?"
    ZANZIBAT @ talk "Dites-moi… savez-vous pourquoi Hamun est toujours libre ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1917
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_37dad121:

    # MC @ talk "Because no side dares try to conquer it yet?"
    MC @ talk "Parce qu’aucun camp n’ose encore la conquérir ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1918
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_f7524e3f:

    # ZANZIBAT @ smile "In part. But the truth is simpler: Hamun sells its table to *all* sides, and takes none."
    ZANZIBAT @ smile "En partie. Mais la vérité est plus simple : Hamun vend sa table à *tous* les camps, et n’en choisit aucun."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1919
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_c0766e48:

    # ZANZIBAT @ smile "Kings, rebels, merchants, priests, each can bargain here."
    ZANZIBAT @ smile "Rois, rebelles, marchands, prêtres, chacun peut y négocier."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1920
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_0ae0fa98:

    # ZANZIBAT @ smile "That is our shield."
    ZANZIBAT @ smile "Voilà notre bouclier."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1921
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_bfc3b19b:

    # ZANZIBAT @ serious "The Greater Trading Company would break that balance."
    ZANZIBAT @ serious "La Grande Compagnie marchande romprait cet équilibre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1922
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_c263fb66:

    # ZANZIBAT @ serious "They are not merchants, they are parasites."
    ZANZIBAT @ serious "Ce ne sont pas des marchands, ce sont des parasites."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1923
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_686f45a6:

    # ZANZIBAT @ serious "Once they take root, they twist every throne they touch."
    ZANZIBAT @ serious "Une fois qu’ils prennent racine, ils tordent chaque trône qu’ils touchent."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1924
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_86307e7e:

    # ZANZIBAT @ talk "Do you know the fate of the People of Wei?"
    ZANZIBAT @ talk "Connais-tu le sort du peuple de Wei ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1925
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_11d4edaf:

    # ZANZIBAT @ talk "In less than fifty years, the GTC bought their land, scattered their bloodline, and sold the survivors on the backs of Paruh beasts."
    ZANZIBAT @ talk "En moins de cinquante ans, la GTC a acheté leurs terres, dispersé leur lignée et vendu les survivants sur le dos des bêtes Paruh."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1926
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_e72be1c9:

    # ZANZIBAT @ smile "So tell me... why should I welcome that fate here?"
    ZANZIBAT @ smile "Alors dis-moi... pourquoi devrais-je accueillir ce sort ici ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1933
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_350fd090:

    # ZANZIBAT @ talk "It shall, but it's the difference between the deal passing in the next three months and the next three years."
    ZANZIBAT @ talk "Il en sera ainsi, mais c'est la différence entre un accord conclu dans les trois prochains mois et un accord conclu dans les trois prochaines années."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1937
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_d3c8843a:

    # ZANZIBAT @ talk "I have had dealings with them in the past."
    ZANZIBAT @ talk "J'ai eu affaire à eux par le passé."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1938
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_d466e272:

    # ZANZIBAT @ talk "None of which have ended well... For anyone involved."
    ZANZIBAT @ talk "Aucune ne s'est bien terminée... Pour personne impliquée."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1939
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_8de44649:

    # ZANZIBAT @ talk "You would do well to be parted from their 'business' as soon as you can."
    ZANZIBAT @ talk "Tu ferais bien de te séparer de leurs 'affaires' dès que possible."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1944
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_3f011ce2:

    # MC "Then what would it take to persuade you?"
    MC "Alors, que faudrait-il pour te convaincre ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1945
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_c21c67dc:

    # ZANZIBAT @ talk "... Hmm."
    ZANZIBAT @ talk "... Hmm."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1946
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_9fdbb0e5:

    # ZANZIBAT @ talk "The shipping rights."
    ZANZIBAT @ talk "Les droits d'expédition."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1947
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Quoi ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1948
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_9e7a2320:

    # ZANZIBAT @ talk "I want them to agree to only use my ships to transport the goods from Alderay to Skarshire and vice versa."
    ZANZIBAT @ talk "Je veux qu'ils acceptent d'utiliser uniquement mes navires pour transporter les marchandises d'Alderay à Skarshire et vice versa."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1949
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_3f36b076:

    # MC @ serious "For someone so against them, you seem more than ready to jump into business with them again."
    MC @ serious "Pour quelqu'un qui est tellement contre eux, vous semblez plus que prêt à faire à nouveau des affaires avec eux."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1950
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_483cf438:

    # ZANZIBAT @ smile "It's as the old proverb says."
    ZANZIBAT @ smile "C'est comme le dit le vieux proverbe."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1951
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_f5dd4b8d:

    # ZANZIBAT @ talk "{i}Keep your friends close, and keep your enemies even closer.{/i}"
    ZANZIBAT @ talk "{i}Gardez vos amis proches, et gardez vos ennemis encore plus proches.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1952
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_a872cabc:

    # ZANZIBAT @ talk "Tell the GTC my answer."
    ZANZIBAT @ talk "Dites au GTC ma réponse."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1954
translate fr qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_a72b3584:

    # ZANZIBAT @ talk "{i}I will expect the agreement in writing... and on their god.{/i}"
    ZANZIBAT @ talk "{i}Je m'attendrai à l'accord par écrit... et sur leur dieu.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1962
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_0a1e03ae:

    # GAREN "Can I help you with something?"
    GAREN "Puis-je vous aider ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1965
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_66b0402a:

    # GAREN @ think "Go on?"
    GAREN @ think "Continuez ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1966
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_fb0e6d2b:

    # MC @ talk "He will step aside and allow the deal to pass {i}if{/i} his ships are used to transport the cargo to and from Skarshire."
    MC @ talk "Il se retirera et permettra que l'accord se réalise {i}si{/i} ses navires sont utilisés pour transporter la cargaison vers et depuis Skarshire."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1967
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_995dd8b9:

    # GAREN @ smile "... Very well, I shall arrange the papers for him."
    GAREN @ smile "… Très bien, je vais préparer les papiers pour lui."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1968
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_4ee67eb4:

    # MC @ think "Just like that?"
    MC @ think "Juste comme ça ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1969
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_4fb6e909:

    # MC @ think "No bartering, no negotiation?"
    MC @ think "Pas de marchandage, pas de négociation ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1970
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_d8251d85:

    # GAREN @ smile "The desert fox has made his offer."
    GAREN @ smile "Le renard du désert a fait son offre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1971
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_58c3d475:

    # GAREN @ smile "I am sure he will obsess over every word of the papers I send, but within a few days at the most we will conclude our business."
    GAREN @ smile "Je suis sûr qu’il va ressasser chaque mot des papiers que j’enverrai, mais d’ici quelques jours au plus nous conclurons nos affaires."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1972
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_edbe0460:

    # MC @ talk "How can you be so sure?"
    MC @ talk "Comment peux-tu en être si sûr ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1973
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_00346b84:

    # GAREN @ talk "Because despite his hatred of us, he's always more than willing to do business with us."
    GAREN @ talk "Parce que malgré sa haine envers nous, il est toujours plus que disposé à faire affaire avec nous."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1974
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_11568e73:

    # GAREN @ talk "It is a game to him, I believe, to see if he can outsmart us."
    GAREN @ talk "C’est un jeu pour lui, je crois, de voir s’il peut nous surpasser."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1975
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_69989a6a:

    # MC @ think "If you're just giving him everything he wants, doesn't that mean he's already won?"
    MC @ think "Si tu lui donnes simplement tout ce qu’il veut, ça ne veut pas dire qu’il a déjà gagné ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1976
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_903ddcb0:

    # GAREN @ smile "{i}Only if he can keep to his end of the bargain.{/i}"
    GAREN @ smile "{i}Seulement s’il peut respecter sa part du marché.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1977
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_2192f037:

    # MC @ think "What do you mean by that?"
    MC @ think "Qu'entends-tu par là ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1978
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_252641ae:

    # GAREN @ talk "{i}We are bound only by the wording of our contract... Nothing more.{/i}"
    GAREN @ talk "{i}Nous ne sommes liés que par les termes de notre contrat... Rien de plus.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1979
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_6a444706:

    # GAREN @ smile "If you have a moment, I could humour you with a tale."
    GAREN @ smile "Si tu as un moment, je pourrais te divertir avec une histoire."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1982
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_2cff701a:

    # GAREN @ talk "There was once a lord who swore, if we armed him and filled his ranks with our mercenaries, he would crush his rival within the year."
    GAREN @ talk "Il était une fois un seigneur qui jura que, si nous l'armions et remplissions ses rangs de nos mercenaires, il écraserait son rival dans l'année."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1983
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_6884319c:

    # GAREN @ talk "Payment was guaranteed. And if not, his castle would be ours."
    GAREN @ talk "Le paiement était garanti. Et sinon, son château serait à nous."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1984
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_4dd2ec1a:

    # GAREN @ talk "A bold deal. Too bold. Because his rival came to us with the very same request."
    GAREN @ talk "Un marché audacieux. Trop audacieux. Car son rival est venu nous trouver avec exactement la même requête."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1985
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_e47a45b8:

    # MC @ surprised "Surely that's a conflict of interest?"
    MC @ surprised "N'est-ce pas là un conflit d'intérêts ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1986
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_869b5883:

    # GAREN @ smile "Not if the contract doesn't forbid it."
    GAREN @ smile "Pas si le contrat ne l'interdit pas."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1987
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_ff958f57:

    # GAREN @ talk "So we sold both sides weapons. We took both their coin. And when their coffers ran dry... we took collateral."
    GAREN @ talk "Nous avons donc vendu des armes aux deux camps. Nous avons pris l'argent des deux. Et quand leurs coffres se sont taris... nous avons pris des garanties."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1988
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_f88c955e:

    # GAREN @ talk "First land. Then blood. Piece by piece, both lords fed us their realms rather than admit defeat."
    GAREN @ talk "D'abord les terres. Puis le sang. Morceau par morceau, les deux seigneurs nous ont cédé leurs royaumes plutôt que d'admettre la défaite."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1989
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_5078ca82:

    # GAREN @ smile "By the second year, neither could pay another coin. One was hanged in the square. The other drowned in his own bath."
    GAREN @ smile "Dès la deuxième année, aucun ne pouvait payer une pièce de plus. L'un fut pendu sur la place. L'autre se noya dans son propre bain."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1990
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_0f8d033b:

    # MC @ scared "... That's monstrous."
    MC @ scared "... C'est monstrueux."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1991
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_564c8dd2:

    # GAREN @ think "Is it? They could have stopped. Pride kept them blind."
    GAREN @ think "Vraiment ? Ils auraient pu s'arrêter. L'orgueil les a aveuglés."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1992
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_14d8e3ee:

    # GAREN @ smile "That is the true lesson: greed makes men puppets, and we hold the strings."
    GAREN @ smile "Voilà la vraie leçon : l'avidité transforme les hommes en marionnettes, et nous tenons les ficelles."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1996
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_106b3d3e:

    # GAREN @ smile "Of course, another time perhaps."
    GAREN @ smile "Bien sûr, une autre fois peut-être."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2000
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_cd7f5b31:

    # GAREN @ talk "Until the ink meets the page then."
    GAREN @ talk "Jusqu'à ce que l'encre rencontre la page alors."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2003
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_e8b55b4e:

    # GAREN @ smile "You have done well here."
    GAREN @ smile "Vous avez fait du bon travail ici."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2004
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_d452e86b:

    # MC @ think "All this trouble... Why not just ask Lord Zanzibat yourselves?"
    MC @ think "Tout ce mal... Pourquoi ne pas simplement demander au seigneur Zanzibat vous-mêmes ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2005
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_7ee32d5e:

    # MC @ think "Why use me?"
    MC @ think "Pourquoi m'utiliser ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2006
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_b540657a:

    # GAREN @ talk "Because Lord Zanzibat only plays the {i}great game{/i} on his terms."
    GAREN @ talk "Parce que le seigneur Zanzibat ne joue le {i}grand jeu{/i} qu'à ses conditions."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2007
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_d1abcf29:

    # GAREN @ talk "He would {i}expect{/i} some kind of enticing offer to even bring him to the table."
    GAREN @ talk "Il s'{i}attendrait{/i} à une offre alléchante ne serait-ce que pour l'amener à la table."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2008
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_d6e1ac52:

    # GAREN @ talk "...And."
    GAREN @ talk "...Et."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2009
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_4e56044d:

    # "Garen's face slowly shifts into a smile without any warmth."
    "Le visage de Garen se transforme lentement en un sourire dénué de toute chaleur."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2010
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_83130464:

    # GAREN @ smile "The Greater Trading Company is always looking for new assets."
    GAREN @ smile "La Grande Compagnie Commerciale est toujours à la recherche de nouveaux atouts."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2011
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_8455a15f:

    # GAREN @ smile "{i}You are so far proving yourself a valuable asset.{/i}"
    GAREN @ smile "{i}Vous vous révélez jusqu'ici être un atout précieux.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2012
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_9429e63d:

    # GAREN @ talk "I shall return soon after I handle Lord Zanzibat."
    GAREN @ talk "Je reviendrai bientôt, après m'être occupé du Seigneur Zanzibat."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2013
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_736ebcd9:

    # MC @ think "What am I to do until then?"
    MC @ think "Que suis-je censé faire d'ici là ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2014
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_a513ccf1:

    # GAREN @ talk "Whatever you so desire."
    GAREN @ talk "Tout ce que vous désirez."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2015
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_f1c8b685:

    # GAREN @ talk "{i}... The GTC is pleased with your progress.{/i}"
    GAREN @ talk "{i}... La GTC est satisfaite de vos progrès.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2016
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_2cc04117:

    # GAREN @ talk "{i}Good work.{/i}"
    GAREN @ talk "{i}Bon travail.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2018
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_1a65813e:

    # "With a small, curtly tilt of his head towards me, Garen Quiltshire left {i}The Pale Dragon.{/i}"
    "Avec un léger hochement de tête sec en ma direction, Garen Quiltshire quitta {i}Le Dragon Pâle.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2019
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_d47561b9:

    # "Once more, leaving me without direction."
    "Une fois de plus, me laissant sans direction."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2020
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_695d4c57:

    # "As I stood there directionless I felt the brush of a soft hand on the back of my arm."
    "Alors que je me tenais là sans direction, je sentis le frôlement d'une main douce à l'arrière de mon bras."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2022
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_7506c8bd:

    # "Sypha appeared alongside me, smiling softly."
    "Sypha apparut à mes côtés, souriant doucement."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2023
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_ed3729c1:

    # SYPHA @ happy "You and I."
    SYPHA @ happy "Toi et moi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2024
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_f33904df:

    # SYPHA @ happy "Tonight... we slip away."
    SYPHA @ happy "Ce soir... nous nous éclipsons."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2025
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_8ec2dc43:

    # SYPHA @ happy "{i}Just the two of us.{/i}"
    SYPHA @ happy "{i}Rien que tous les deux.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2026
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_64b99b7e:

    # MC @ think "I thought you would still be angry with me?"
    MC @ think "Je pensais que tu serais toujours en colère contre moi ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2027
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_b58f3630:

    # SYPHA @ happy "Oh, I am."
    SYPHA @ happy "Oh, je le suis."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2028
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_f9cd6c18:

    # SYPHA @ happy "But anger burns bright... and bright flames can be put to better use, don't you think?"
    SYPHA @ happy "Mais la colère brûle fort... et les flammes vives peuvent être mieux utilisées, tu ne crois pas ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2029
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_5994274b:

    # MC @ think "You change your mind quickly."
    MC @ think "Tu changes d'avis rapidement."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2030
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_544cdd6c:

    # "A soft, coy smile curved on her lips, eyes gleaming with something equal parts danger and desire."
    "Un doux sourire timide se dessina sur ses lèvres, ses yeux brillant d'un mélange à parts égales de danger et de désir."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2031
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_342f3455:

    # SYPHA @ happy "There's a night market. Music, smoke, secrets for sale."
    SYPHA @ happy "Il y a un marché nocturne. Musique, fumée, secrets à vendre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2032
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_4690fb80:

    # SYPHA @ happy "Meet me there after dark, and I'll give you what you're craving."
    SYPHA @ happy "Retrouve-moi là-bas après la tombée de la nuit, et je te donnerai ce dont tu as envie."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2033
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_93d92d0b:

    # MC @ serious "Answers?"
    MC @ serious "Des réponses ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2034
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_cf587495:

    # SYPHA @ happy "Some answers... some temptations."
    SYPHA @ happy "Des réponses... des tentations."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2035
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_29779741:

    # SYPHA @ happy "Enough to keep you coming back for more."
    SYPHA @ happy "Assez pour que tu reviennes en redemander."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2036
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_1b15e7ec:

    # "She brushed herself along my arm deliberately, her breath hot against my ear."
    "Elle se frôla délibérément contre mon bras, son souffle chaud contre mon oreille."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2037
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_a691ecc2:

    # SYPHA @ perv "Don't be late... {i}dear.{/i}"
    SYPHA @ perv "Ne sois pas en retard... {i}chéri{/i}."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2039
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_cacf25ce:

    # MC @ serious "(Well... I have some time before Garen returns.)"
    MC @ serious "(Eh bien... j'ai un peu de temps avant que Garen ne revienne.)"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2040
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_00dfcaa0:

    # MC @ serious "(I should tread careful with this Sypha, she's no doubt toying with me.)"
    MC @ serious "(Je devrais me méfier de cette Sypha, elle n'est doute pas en train de jouer avec moi.)"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2041
translate fr qst_TheBeastOfNovaras_TalkToGarenBar_c1b28386:

    # MC "(If she has answers, I need them. No matter the cost.)"
    MC "(Si elle a des réponses, j'en ai besoin. Peu importe le prix.)"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2050
translate fr qst_TheBeastOfNovaras_SyphaDate_ed8e5e7f:

    # SYPHA @ happy "Ahh, you've arrived!"
    SYPHA @ happy "Ah, te voilà !"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2051
translate fr qst_TheBeastOfNovaras_SyphaDate_77de5cb1:

    # SYPHA @ angry "{i}And you made me wait.{/i}"
    SYPHA @ angry "{i}Et tu m'as fait attendre.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2052
translate fr qst_TheBeastOfNovaras_SyphaDate_50a0b7a7:

    # SYPHA @ angry "I {b}hate{/b} to be made to wait."
    SYPHA @ angry "Je {b}déteste{/b} qu'on me fasse attendre."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2053
translate fr qst_TheBeastOfNovaras_SyphaDate_1486f1ec:

    # MC @ serious "I'm here now, aren't I?"
    MC @ serious "Je suis là maintenant, non ?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2054
translate fr qst_TheBeastOfNovaras_SyphaDate_a74f8854:

    # "Sypha pouted, before wrapping her arm around mine and smiling once more."
    "Sypha fit la moue, puis enlaça mon bras et sourit de nouveau."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2055
