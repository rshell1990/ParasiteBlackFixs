    MC @ scared "...Je ne suis pas sûr de ce que c'était."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:701
translate fr qst_ForgedInFire_Training1NightEvent_d5d45ce3:

    # MARKUS @ shock "Well, you look like you've seen a ghost!"
    MARKUS @ shock "Eh bien, on dirait que tu as vu un fantôme !"

