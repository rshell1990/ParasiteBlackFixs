translate fr qst_ForgedInFire_Training0FirstFight_repBattle_bfd776ce:

    # "The temptation was too much to bear, and, letting my curiosity get the best of me, I peeked around the woman's side to take a look."
    "La tentation était trop forte à supporter, et, ma curiosité prenant le dessus, je jetai un coup d'œil du côté des femmes pour regarder."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:393
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_adf06afd:

    # "Kiara was squatted down naked, washing herself with a wet flannel and bucket."
    "Kiara était accroupie nue, se lavant avec un gant de toilette mouillé et un seau."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:394
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_a4806da6:

    # KIARA "So, are you just going to stand there and watch?"
    KIARA "Alors, tu vas rester planté là à regarder ?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:395
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_3d654567:

    # MC @ scared "K-Kiara!"
    MC @ scared "K-Kiara !"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:396
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_2df5f315:

    # "Realizing I'd been caught, Kiara, grabbing a towel, wrapped it around herself as she marched over towards me, arms folded."
    "Comprenant que je m'étais fait prendre, Kiara attrapa une serviette, s'en enroula et s'avança vers moi d'un pas décidé, les bras croisés."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:397
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_a50ae3ab:

    # MC @ scared "It... It isn't what it looked like?"
    MC @ scared "Ce... Ce n'était pas ce que ça semblait ?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:399
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_1ca6c786:

    # "That scout girl I've seen around was squatted down naked, washing herself with a wet flannel and bucket."
    "Cette fille scoute que j'avais vue traîner était accroupie nue, se lavant avec une flanelle mouillée et un seau."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:400
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_edca490d:

