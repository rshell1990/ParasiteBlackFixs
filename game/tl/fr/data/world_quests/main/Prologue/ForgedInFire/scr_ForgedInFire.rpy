translate fr qst_ForgedInFire_Training0FirstFight_repBattle_278d91ab:

    # MC "(All that's left to do is clean the wash area.)"
    MC "(Tout ce qui reste à faire, c'est nettoyer les sanitaires.)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:383
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_57878b2a:

    # "As I headed in, I heard what sounded like... splashing?"
    "Alors que je m'avançais, j'entendis ce qui ressemblait à... des éclaboussures ?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:384
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_68fec10d:

    # "At this hour?"
    "À cette heure-ci ?"

