translate fr qst_ForgedInFire_Training0FirstFight_repBattle_478fa33b:

    # "Kiara grabbed a towel, wrapped it around herself as she marched over towards me, arms folded."
    "Kiara attrapa une serviette, s'en enveloppa tout en marchant vers moi, les bras croisés."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:414
translate fr qst_ForgedInFire_Training0FirstFight_repBattle_cfb43425:

