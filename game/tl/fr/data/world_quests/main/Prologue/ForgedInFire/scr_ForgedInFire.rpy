translate fr qst_ForgedInFire_Training2Teamwork_84edc41c:

    # "We looked at each other puzzled."
    "Nous nous sommes regardés, perplexes."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:728
translate fr qst_ForgedInFire_Training2Teamwork_cef8185e:

    # RECRUITS "{i}Strength?{/i}"
    RECRUITS "{i}La force ?{/i}"

