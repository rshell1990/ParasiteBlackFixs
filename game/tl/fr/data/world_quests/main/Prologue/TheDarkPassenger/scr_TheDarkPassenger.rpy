translate fr qst_TheDarkPass_ObelisksRoomCheckObelisks_dfd2fec5:

    # MC "How did we... {i}get here?{/i}"
    MC "Comment sommes-nous... {i}arrivés ici ?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1470
translate fr qst_TheDarkPass_ObelisksRoomCheckObelisks_3feec716:

    # MARKUS "I don’t know... The nurses told me..."
    MARKUS "Je ne sais pas... Les infirmières m'ont dit..."

