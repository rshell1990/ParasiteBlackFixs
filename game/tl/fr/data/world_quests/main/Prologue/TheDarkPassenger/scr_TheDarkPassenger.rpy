    # MARKUS "What’s a Dark Mage doing here?"
    MARKUS "Que fait un Mage Noir ici ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1380
translate fr qst_TheDarkPass_ObelisksRoomSkeleton_ecae0ae1:

    # MC "I don’t know..."
    MC "Je ne sais pas..."

