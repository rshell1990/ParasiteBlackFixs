# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:7
translate fr qst_TheDarkPass_MarchOut_43d50239:

    # "With the sounds of iron and steel reverberating into the sky, we marched towards the gate into the city."
    "Avec les bruits du fer et de l'acier résonnant dans le ciel, nous marchions vers la porte de la ville."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:8
translate fr qst_TheDarkPass_MarchOut_da340953:

    # "Our forces had been bolstered with a hundred strong cavalry men from another division, whatever this ‘secret’ mission was, it must be very important."
    "Nos forces avaient été renforcées par une centaine de cavaliers robustes d'une autre division, quelle que soit cette mission « secrète », elle devait être très importante."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:10
translate fr qst_TheDarkPass_MarchOut_31c1d805:

    # "Crowds came out to cheer us along the way, held back by rows of city guards acting as barriers so we could pass through unhindered."
    "Des foules étaient sorties pour nous acclamer le long du chemin, retenues par des rangées de gardes de la ville faisant office de barrières afin que nous puissions passer sans encombre."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:11
translate fr qst_TheDarkPass_MarchOut_f3d4e862:

    # "Even with the adulation from the public, the tone was sombre given the many previous failed missions the Scouts had been made to embark on."
    "Même avec l'adulation du public, le ton était sombre étant donné les nombreuses missions précédentes échouées que les Éclaireurs avaient été contraints d'entreprendre."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:12
translate fr qst_TheDarkPass_MarchOut_4a0e88d2:

    # "Some openly sobbed, others desperately tried to cheer us on with cries of \"Go get em’ boys!\" and \"Come home safe!\"."
    "Certains sanglotaient ouvertement, d'autres essayaient désespérément de nous encourager avec des cris de « Allez les gars, attrapez-les ! » et « Rentrez sains et saufs ! »."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:13
translate fr qst_TheDarkPass_MarchOut_e69e1431:

    # "Suddenly, from the side, I heard a familiar voice cry out to me."
    "Soudain, sur le côté, j'entendis une voix familière m'appeler."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:15
translate fr qst_TheDarkPass_MarchOut_78263ad0:

    # REGINA @ talk "[player_name!t]! [player_name!t]!"
    REGINA @ talk "[player_name!t]! [player_name!t]!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:17
translate fr qst_TheDarkPass_MarchOut_d9748f84:

    # "Upon hearing the sweet voice and realising who it was, I looked over across the immense crowd and saw her among it as she desperately reached out to wave and cheer me on."
    "En entendant cette douce voix et en réalisant qui c'était, je regardai à travers l'immense foule et la vis parmi celle-ci, alors qu'elle tendait désespérément la main pour me saluer et m'encourager."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:18
translate fr qst_TheDarkPass_MarchOut_d7e14922:

    # MC "[regina_ref_cap!t]!"
    MC "[regina_ref_cap!t]!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:19
translate fr qst_TheDarkPass_MarchOut_dd7a3de5:

    # REGINA @ talk "[player_name!t]! [player_name!t]! Come home safe! I love you!"
    REGINA @ talk "[player_name!t]! [player_name!t]! Rentre sain et sauf ! Je t'aime !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:21
translate fr qst_TheDarkPass_MarchOut_75f1da76:

    # "She was swept back by the tidal wave of people as she struggled to keep herself behind the barriers set up, waving frantically towards me."
    "Elle fut emportée par le raz-de-marée humain alors qu'elle luttait pour rester derrière les barrières installées, en agitant frénétiquement la main vers moi."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:22
translate fr qst_TheDarkPass_MarchOut_8038d5d9:

    # "Damn..."
    "Merde..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:23
translate fr qst_TheDarkPass_MarchOut_a735250d:

    # "We marched on through the throngs of people, as we approached the archway to leave my ears picked another familiar voice from the crowd."
    "Nous avons continué à avancer à travers la foule dense ; en approchant de l'arche pour sortir, j'ai entendu une autre voix familière s'élever de la foule."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:25
translate fr qst_TheDarkPass_MarchOut_9f20f220:

    # ADARA @ sad "[player_name!t]!"
    ADARA @ sad "[player_name!t]!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:26
translate fr qst_TheDarkPass_MarchOut_cd3c31fb:

    # "Somehow Adara had managed to burst through the rows of guards keeping the crowds back and sprinted towards me, leaping on me in a frenzied embrace, tears welling in her eyes."
    "D'une manière ou d'une autre, Adara avait réussi à franchir les rangs des gardes qui retenaient la foule, et a sprinté vers moi avant de me sauter dessus dans une étreinte frénétique, les larmes lui montant aux yeux."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:27
translate fr qst_TheDarkPass_MarchOut_2e5d551e:

    # MC "Adara, what are you doing here? You should be—"
    MC "Adara, que fais-tu ici ? Tu devrais être—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:29
translate fr qst_TheDarkPass_MarchOut_f00b98b9:

    # ADARA @ sad "I had to come! I had to say goodbye!"
    ADARA @ sad "Je devais venir ! Je devais te dire au revoir !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:30
translate fr qst_TheDarkPass_MarchOut_b007e3a5:

    # MC "Adara..."
    MC "Adara..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:32
translate fr qst_TheDarkPass_MarchOut_0c094b67:

    # "Without hesitation, Adara sprung forward and planted a kiss onto my lips, her fingers twined through my hair as she clung to me one last time."
    "Sans une once d'hésitation, Adara se précipita en avant et déposa un baiser sur mes lèvres, ses doigts entrelacés dans mes cheveux tandis qu'elle s'accrochait à moi une dernière fois."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:33
translate fr qst_TheDarkPass_MarchOut_a2155810:

    # ADARA @ sad "G-Goodluck, [player_name!t]!"
    ADARA @ sad "B-Bonne chance, [player_name!t]!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:34
translate fr qst_TheDarkPass_MarchOut_19748f64:

    # MC "... Adara... I..."
    MC "... Adara... Je..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:35
translate fr qst_TheDarkPass_MarchOut_205d5740:

    # ADARA @ sad "C-Come home, please, to me!"
    ADARA @ sad "R-Rentre à la maison, s'il te plaît, reviens-moi !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:37
translate fr qst_TheDarkPass_MarchOut_5989b69b:

    # "The guards began to pull Adara away, she cried out to me in anguish, her hands still outstretched."
    "Les gardes commencèrent à entraîner Adara, elle me cria dans l'angoisse, les mains toujours tendues."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:40
translate fr qst_TheDarkPass_MarchOut_8d6c5e6e:

    # GUARD "GET BACK! Get back I say!"
    GUARD "RECULEZ ! Reculez, je dis !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:41
translate fr qst_TheDarkPass_MarchOut_faad54e7:

    # ADARA @ sad "{i}Come home, [player_name!t]!{/i}"
    ADARA @ sad "{i}Rentre à la maison, [player_name!t] !{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:42
translate fr qst_TheDarkPass_MarchOut_284b806f:

    # ADARA @ sad "I’ll be waiting for you!"
    ADARA @ sad "Je t'attendrai !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:46
translate fr qst_TheDarkPass_MarchOut_74f83b13:

    # "I shook my head to try and regain some focus as our procession marched out into the Valley of Death."
    "Je secouai la tête pour essayer de retrouver un peu de concentration tandis que notre procession s'engageait dans la Vallée de la Mort."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:52
translate fr qst_TheDarkPass_MarchOut_46e46050:

    # "We marched for hours along the desolate, barren roads of this dead world."
    "Nous marchâmes pendant des heures le long des routes désolées et arides de ce monde mort."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:53
translate fr qst_TheDarkPass_MarchOut_ee910ba6:

    # "Here and there were scorched out wooden houses long since abandoned and overturned carts still laden with rotten food."
    "Ici et là se trouvaient des maisons en bois calcinées depuis longtemps abandonnées et des charrettes renversées encore chargées de nourriture pourrie."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:54
translate fr qst_TheDarkPass_MarchOut_ddb3e81f:

    # "Much of this land was utterly devastated during The Great Siege of Novaras in 1152, turning much of the surrounding land into a dustbowl."
    "Une grande partie de cette terre fut complètement dévastée lors du Grand Siège de Novaras en 1152, transformant une grande partie des terres environnantes en un désert de poussière."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:55
translate fr qst_TheDarkPass_MarchOut_96e63e82:

    # "However, if you were able to survive long enough to venture to the other side, greenery could once again be found."
    "Cependant, si vous parveniez à survivre assez longtemps pour vous aventurer de l'autre côté, la verdure pouvait à nouveau être trouvée."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:56
translate fr qst_TheDarkPass_MarchOut_308be420:

    # "The roads were littered with the skeletal remains of previous travellers."
    "Les routes étaient jonchées des restes squelettiques des voyageurs précédents."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:57
translate fr qst_TheDarkPass_MarchOut_d32561da:

    # "Perhaps most ominously of all, in one burned out hut we have found what was left of a family sitting at a dinner table, their bones now lost amongst the carcass of their meal."
    "Peut-être le plus sinistre de tout, dans une hutte incendiée, nous avons trouvé ce qui restait d'une famille assise à une table de dîner, leurs os désormais perdus parmi les carcasses de leur repas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:58
translate fr qst_TheDarkPass_MarchOut_cac73c98:

    # "In the mad rush to Novaras during the war, hundreds in their droves fled to the Capital, the last {i}true{/i} safe haven at the time."
    "Dans la course folle vers Novaras pendant la guerre, des centaines de personnes en masse ont fui vers la Capitale, le dernier {i}véritable{/i} refuge sûr de l'époque."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:59
translate fr qst_TheDarkPass_MarchOut_3832acc8:

    # "Many starved along the way and many were lost in the congested crowds to be trampled and left on the wayside."
    "Beaucoup sont morts de faim en chemin et beaucoup ont été perdus dans les foules congestionnées pour être piétinés et laissés sur le bord de la route."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:60
translate fr qst_TheDarkPass_MarchOut_d366a6d1:

    # "It was only thanks to Emperor Alcott, then just the son of a fledgling lord who had died some months prior, who’d rallied together the bannermen and held off the onslaught of Demorai while the others squabbled and bickered amongst themselves."
    "Ce n'est que grâce à l'Empereur Alcott, alors simple fils d'un jeune seigneur décédé quelques mois auparavant, qui avait rallié les bannerets et repoussé l'assaut des Demorai pendant que les autres se chamaillaient et se disputaient entre eux."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:61
translate fr qst_TheDarkPass_MarchOut_ad343ca4:

    # "Mesamor must have been pleased and presumed Alcott may prove to be the next Newheart."
    "Mesamor a dû être ravi et a supposé qu'Alcott pourrait s'avérer être le prochain Newheart."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:62
translate fr qst_TheDarkPass_MarchOut_b85d83e9:

    # "I doubt in a million years that he would have predicted that Alcott would one day rise up and overthrow him."
    "Je doute en un million d'années qu'il aurait prédit qu'Alcott se soulèverait un jour et le renverserait."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:66
translate fr qst_TheDarkPass_MarchOut_9ee03850:

    # DUPREY "ONWARD MARCH!"
    DUPREY "EN AVANT, MARCHE !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:68
translate fr qst_TheDarkPass_MarchOut_3cc36384:

    # "Captain Duprey himself rode by horse, leading us from the front. We constantly peered out across the deadlands for any signs of the Demorai, but rather unnervingly could not locate even a whisper of them."
    "Le Capitaine Duprey lui-même chevauchait, nous menant du front. Nous scrutons constamment les terres mortes à la recherche de tout signe des Demorai, mais de manière plutôt troublante, nous ne pûmes localiser même un murmure d'eux."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:71
translate fr qst_TheDarkPass_MarchOut_d277cc6e:

    # "A couple hours into the slow, tedious march, the young First Officer rode up along beside us on a horse and peered down inquisitively."
    "Quelques heures après le début de la marche lente et fastidieuse, le jeune Second monta à cheval à côté de nous et nous regarda d’un air inquisiteur."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:73
translate fr qst_TheDarkPass_MarchOut_8dda77c4:

    # "Second in command to Captain Duprey, he was notorious for being a dry, unemotional man."
    "Bras droit du capitaine Duprey, il était réputé pour être un homme sec et dépourvu d’émotions."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:75
translate fr qst_TheDarkPass_MarchOut_d63beaa1:

    # BORRAS "You three, come with me."
    BORRAS "Vous trois, venez avec moi."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:76
translate fr qst_TheDarkPass_MarchOut_5a5784d5:

    # "Me, Markus and Kiara shared a look, all of us confused."
    "Markus, Kiara et moi échangeâmes un regard, tous aussi perplexes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:78
translate fr qst_TheDarkPass_MarchOut_def6eabf:

    # BORRAS "Yes, you three idiots, come, now."
    BORRAS "Oui, vous trois, bande d’idiots, venez, maintenant."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:82
translate fr qst_TheDarkPass_MarchOut_29aaa368:

    # "Uneasy, we strayed away from the main bulk of the force and followed Borras down towards the front of the line towards Captain Duprey."
    "Inquiets, nous nous éloignâmes du gros de la troupe et suivîmes Borras vers l’avant de la ligne, jusqu’au capitaine Duprey."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:85
translate fr qst_TheDarkPass_MarchOut_3e19d25d:

    # BORRAS "Captain, I’d like to give these Scouts some horses so they can come with me and loop around onto the ridge of the gorge."
    BORRAS "Capitaine, je voudrais donner des chevaux à ces éclaireurs pour qu’ils m’accompagnent et contournent la crête de la gorge."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:86
translate fr qst_TheDarkPass_MarchOut_352d9cf7:

    # "The Captain gave us a cursory glance."
    "Le capitaine nous jeta un regard rapide."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:87
translate fr qst_TheDarkPass_MarchOut_19e696bc:

    # DUPREY "... With just these three?"
    DUPREY "... Seulement ces trois-là ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:89
translate fr qst_TheDarkPass_MarchOut_1fe10c4e:

    # BORRAS "I think we’ll draw too much attention with any more. It’s unlikely, but the Demorai may have used the gorge to lay a trap."
    BORRAS "Je pense qu’un groupe plus nombreux attirerait trop l’attention. C’est peu probable, mais les Demorai ont peut-être utilisé la gorge pour tendre un piège."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:90
translate fr qst_TheDarkPass_MarchOut_ee7738ae:

    # DUPREY "Hmm, permission granted, but make sure you’re careful with any engagement."
    DUPREY "Hmm, permission accordée, mais assurez-vous d’être prudents avec tout engagement."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:92
translate fr qst_TheDarkPass_MarchOut_ae730759:

    # BORRAS "Yes Captain, I’ll ride back and report if there’s any trouble."
    BORRAS "Oui Capitaine, je reviendrai à cheval et signalerai s’il y a un problème."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:94
translate fr qst_TheDarkPass_MarchOut_7de322a9:

    # "Borras whistled and waved over some of the men who trotted the horses over towards us."
    "Borras siffla et fit signe à quelques hommes qui firent trotter les chevaux vers nous."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:95
translate fr qst_TheDarkPass_MarchOut_5196c965:

    # "Taking the reins of the horses he handed them to each of us."
    "Prenant les rênes des chevaux, il les tendit à chacun de nous."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:96
translate fr qst_TheDarkPass_MarchOut_672f0a56:

    # BORRAS "I take it you can all ride?"
    BORRAS "Je suppose que vous savez tous monter ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:97
translate fr qst_TheDarkPass_MarchOut_06928b06:

    # MARKUS "Yes."
    MARKUS "Oui."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:98
translate fr qst_TheDarkPass_MarchOut_617596c2:

    # KIARA "Aye."
    KIARA "Aye."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:99
translate fr qst_TheDarkPass_MarchOut_34986cf2:

    # MC "Uhh, somewhat."
    MC "Euh, plus ou moins."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:101
translate fr qst_TheDarkPass_MarchOut_d20687d6:

    # BORRAS "‘Somewhat’?"
    BORRAS "‘Plus ou moins’ ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:102
translate fr qst_TheDarkPass_MarchOut_01a2fa01:

    # MC "It’s been a while, sir..."
    MC "Cela fait un moment, monsieur..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:103
translate fr qst_TheDarkPass_MarchOut_f7f37700:

    # MC "Can I ask why you’re taking us and not more experienced cavalry?"
    MC "Puis-je savoir pourquoi vous nous emmenez, nous, et non une cavalerie plus expérimentée ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:105
translate fr qst_TheDarkPass_MarchOut_0938623b:

    # BORRAS "I’m not risking cavalry men, you lot die, I just need to find a couple of new horses."
    BORRAS "Je ne prends pas le risque de perdre des cavaliers ; vous crevez, je n'aurai qu'à trouver quelques nouveaux chevaux."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:107
translate fr qst_TheDarkPass_MarchOut_cf030dfb:

    # BORRAS "They die and I’m looking at months of training to get new recruits up to {i}my{/i} standards."
    BORRAS "Eux, ils meurent et j'en ai pour des mois de formation pour amener de nouvelles recrues à {i}mon{/i} niveau."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:108
translate fr qst_TheDarkPass_MarchOut_9d2b800f:

    # "Well... that’s not very confidence inspiring."
    "Eh bien... ça inspire pas vraiment confiance."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:110
translate fr qst_TheDarkPass_MarchOut_cca1be84:

    # BORRAS "Now, enough questions! Come!"
    BORRAS "Bon, assez de questions ! Venez !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:118
translate fr qst_TheDarkPass_MarchOut_b3d75520:

    # "Riding up behind Borras, we furtively looped around to the high ground of the ridge."
    "Chevauchant derrière Borras, nous contournâmes furtivement pour gagner les hauteurs de la crête."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:119
translate fr qst_TheDarkPass_MarchOut_c4e0e0aa:

    # "If there were any Demorai waiting up there, they could easily clamber down from the sides and surround the men in minutes."
    "Si des Demorai attendaient là-haut, ils pourraient facilement dévaler les pentes et encercler les hommes en quelques minutes."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:120
translate fr qst_TheDarkPass_MarchOut_a72abee1:

    # "Thankfully, as we trotted up to overlook the valley beneath, we couldn’t see any enemies lurking."
    "Heureusement, en trottant pour surplomber la vallée en contrebas, nous ne vîmes aucun ennemi tapi."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:121
translate fr qst_TheDarkPass_MarchOut_671404c3:

    # "{i}But...{/i} I had an eerie feeling we were being watched by something, somewhere..."
    "{i}Mais...{/i} j'avais la sensation étrange d'être observé par quelque chose, quelque part..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:123
translate fr qst_TheDarkPass_MarchOut_0126a5da:

    # BORRAS "Hmph... Looks like the path is clear."
    BORRAS "Hmph... On dirait que la voie est libre."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:125
translate fr qst_TheDarkPass_MarchOut_b17da576:

    # KIARA "Are we done here then?"
    KIARA "On en a fini ici, alors ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:126
translate fr qst_TheDarkPass_MarchOut_246621e2:

