    # MC "... Could I ask you about a couple things, sir?"
    MC "... Puis-je vous poser quelques questions, monsieur ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:364
translate fr qst_TheDarkPass_CampTalkDuprey_0c3978ea:

    # DUPREY "Hm?"
    DUPREY "Hum ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:365
translate fr qst_TheDarkPass_CampTalkDuprey_d0300c61:

    # MC "If you don’t mind..."
    MC "Si cela ne vous dérange pas..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:366
translate fr qst_TheDarkPass_CampTalkDuprey_13a1b492:

    # DUPREY "Aye, feel free."
    DUPREY "Oui, n'hésitez pas."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:374
translate fr qst_TheDarkPass_CampTalkDuprey_menu_7bb579f6:

    # DUPREY "Lost count a long time ago."
    DUPREY "J'ai perdu le compte il y a longtemps."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:375
translate fr qst_TheDarkPass_CampTalkDuprey_menu_6c8a02b9:

    # DUPREY "I’ve been here since the beginning..."
    DUPREY "Je suis ici depuis le début..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:376
translate fr qst_TheDarkPass_CampTalkDuprey_menu_dcc31424:

    # MC "You mean—"
    MC "Vous voulez dire—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:377
translate fr qst_TheDarkPass_CampTalkDuprey_menu_c9e369aa:

    # DUPREY "When it all first started, we never took it seriously, far more concerned with the threat of Kalliban O’Nok and his army of orcs crossing the seas to invade..."
    DUPREY "Lorsque tout a commencé, nous ne l'avons jamais pris au sérieux, bien plus préoccupés par la menace que représentaient Kalliban O'Nok et son armée d'orques traversant les mers pour envahir..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:378
translate fr qst_TheDarkPass_CampTalkDuprey_menu_d579e16c:

    # MC "{i}The winter of 1149.{/i}"
    MC "{i}L'hiver de 1149.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:379
translate fr qst_TheDarkPass_CampTalkDuprey_menu_9b165412:

    # DUPREY "Alright, clever clogs. That’s what they called it, aye."
    DUPREY "D'accord, monsieur je-sais-tout. C'est comme ça qu'ils l'appelaient, hein."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:380
translate fr qst_TheDarkPass_CampTalkDuprey_menu_2d277bc7:

    # DUPREY "Villagers talked about {i}‘ghosts in the night’{/i} snatching people up... We figured it was just bandits."
    DUPREY "Les villageois parlaient de {{i}}'fantômes dans la nuit'{{/i}} qui enlevaient les gens... On pensait que c'étaient juste des bandits."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:381
translate fr qst_TheDarkPass_CampTalkDuprey_menu_4792dca5:

    # DUPREY "More ‘n’ more had been spotted what with all the famine; we were preoccupied with the kind of threats we could understand."
    DUPREY "On en voyait de plus en plus à cause de la famine ; on était préoccupés par les menaces qu'on pouvait comprendre."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:382
translate fr qst_TheDarkPass_CampTalkDuprey_menu_8ba9597e:

    # MC "I know this part! After they found more and more bloody scenes, The High Lords and King Mesamor finally relented and got the High Mages and Inquisitors to investigate."
    MC "Je connais cette partie ! Après avoir découvert de plus en plus de scènes sanglantes, les Hauts Seigneurs et le Roi Mesamor ont fini par céder et ont demandé aux Hauts Mages et aux Inquisiteurs d'enquêter."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:383
translate fr qst_TheDarkPass_CampTalkDuprey_menu_f269264d:

    # "Captain Duprey raised a curious eyebrow."
    "Le capitaine Duprey haussa un sourcil curieux."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:384
translate fr qst_TheDarkPass_CampTalkDuprey_menu_ecde942b:

    # DUPREY @ think "Hmm... How’d you know all that? Most don’t know the full story."
    DUPREY @ think "Hmm... Comment sais-tu tout ça ? La plupart ne connaissent pas toute l'histoire."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:385
translate fr qst_TheDarkPass_CampTalkDuprey_menu_1cc6d473:

    # MC "I studied it."
    MC "Je l'ai étudié."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:386
translate fr qst_TheDarkPass_CampTalkDuprey_menu_b77999dc:

    # DUPREY @ laugh "Ha! How very wise of you..."
    DUPREY @ laugh "Ha ! Comme c'est très sage de ta part..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:387
translate fr qst_TheDarkPass_CampTalkDuprey_menu_c8488904:

    # DUPREY "Always good to know how you got to where you’re at but I’m afraid there aren’t many more lessons to learn from it that’d be useful."
    DUPREY "C'est toujours bien de savoir comment on en est arrivé là, mais je crains qu'il n'y ait pas beaucoup plus de leçons à en tirer qui soient utiles."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:388
translate fr qst_TheDarkPass_CampTalkDuprey_menu_424524d9:

    # DUPREY "We underestimated the enemy, and we still thought at the time it was all some grand scheme from Kalliban. We overestimated him."
    DUPREY "On a sous-estimé l'ennemi, et à l'époque on pensait encore que c'était un grand complot de Kalliban. On l'a surestimé."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:389
translate fr qst_TheDarkPass_CampTalkDuprey_menu_04cc0520:

    # DUPREY "We were ordered to defend the neighbouring villages and towns when we should have had the army brought in and amassed an all-out assault, they’d caught us on the backfoot. We were still naive then."
    DUPREY "On nous avait ordonné de défendre les villages et les villes voisins alors que nous aurions dû faire venir l'armée et lancer un assaut général, ils nous avaient pris au dépourvu. Nous étions encore naïfs à l'époque."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:390
translate fr qst_TheDarkPass_CampTalkDuprey_menu_52865a48:

    # "Captain Duprey took another sip of his drink, he seemed lost in his memories."
    "Le capitaine Duprey but une autre gorgée de sa boisson, il semblait perdu dans ses souvenirs."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:391
translate fr qst_TheDarkPass_CampTalkDuprey_menu_9841065b:

    # DUPREY "We paid the price for those mistakes at Meadow Plains."
    DUPREY "Nous avons payé le prix de ces erreurs à Meadow Plains."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:392
translate fr qst_TheDarkPass_CampTalkDuprey_menu_1d6c3970:

    # MC "{i}You{/i} were at The Battle of Meadow Plains?"
    MC "{i}Vous{/i} étiez à la bataille de Meadow Plains ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:393
translate fr qst_TheDarkPass_CampTalkDuprey_menu_a7267a8b:

    # DUPREY "That I was."
    DUPREY "En effet, j'y étais."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:394
translate fr qst_TheDarkPass_CampTalkDuprey_menu_3e8e0a2d:

    # DUPREY "I remember the bloodshed in the streets from the towns that had been annihilated."
    DUPREY "Je me souviens du carnage dans les rues des villes qui avaient été anéanties."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:395
translate fr qst_TheDarkPass_CampTalkDuprey_menu_22d390e2:

    # DUPREY "Every corner you turned around had death waiting for you on the other side."
    DUPREY "À chaque coin de rue, la mort vous attendait de l'autre côté."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:396
translate fr qst_TheDarkPass_CampTalkDuprey_menu_36fdb802:

    # DUPREY "And there was the mad rush of thousands fleeing to Novaras to hide behind its walls."
    DUPREY "Et il y avait la course folle de milliers de personnes fuyant vers Novaras pour se cacher derrière ses murs."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:397
translate fr qst_TheDarkPass_CampTalkDuprey_menu_06bc1e0b:

    # DUPREY "The butchered bodies of the mages and Inquisitors before we arrived to offer relief."
    DUPREY "Les corps massacrés des mages et des Inquisiteurs avant que nous n'arrivions pour apporter des secours."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:398
translate fr qst_TheDarkPass_CampTalkDuprey_menu_2020af46:

    # DUPREY "But most of all, I remember THAT battle."
    DUPREY "Mais surtout, je me souviens de CETTE bataille."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:399
translate fr qst_TheDarkPass_CampTalkDuprey_menu_92a7cec2:

    # "We had all heard tales about the first great battle for Alderay and of how the ‘legendary General Newheart’ fell trying to relieve Fort Rook, the supposedly impenetrable Fortress of the South."
    "Nous avions tous entendu des récits de la première grande bataille pour Alderay et de la façon dont le « légendaire général Newheart » était tombé en tentant de secourir Fort Rook, la supposée forteresse imprenable du Sud."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:400
translate fr qst_TheDarkPass_CampTalkDuprey_menu_6539d583:

    # MC "... Were you there when General Newheart—"
    MC "... Étiez-vous là quand le général Newheart—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:401
translate fr qst_TheDarkPass_CampTalkDuprey_menu_db751ab3:

    # DUPREY "Old Iron Heart? Aye, we were friends."
    DUPREY "Le vieux Cœur de Fer ? Oui, nous étions amis."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:403
translate fr qst_TheDarkPass_CampTalkDuprey_menu_975a2b8e:

    # MC "... No way!"
    MC "... Pas possible !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:404
translate fr qst_TheDarkPass_CampTalkDuprey_menu_9b54e0a7:

    # MC "You knew General Newheart?"
    MC "Vous connaissiez le général Newheart ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:405
translate fr qst_TheDarkPass_CampTalkDuprey_menu_de87c018:

    # MC "As in, THE Newheart? "
    MC "Comme dans, LE Newheart ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:406
translate fr qst_TheDarkPass_CampTalkDuprey_menu_e1d8f53c:

    # DUPREY "He always hated how they changed his name, Lucan Erunheart was his real name before he was ‘blessed’ with ‘Newheart, Defender of The Realm’."
    DUPREY "Il a toujours détesté la façon dont ils ont changé son nom, Lucan Erunheart était son vrai nom avant qu'il ne soit « béni » avec « Newheart, Défenseur du Royaume »."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:407
translate fr qst_TheDarkPass_CampTalkDuprey_menu_409e8321:

    # DUPREY "But yes, I knew him alright."
    DUPREY "Mais oui, je le connaissais bien."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:408
translate fr qst_TheDarkPass_CampTalkDuprey_menu_191438df:

    # DUPREY "I was there at the war table with him; we strategized many a battle together."
    DUPREY "J'étais là à la table de guerre avec lui ; nous avons élaboré de nombreuses batailles ensemble."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:409
translate fr qst_TheDarkPass_CampTalkDuprey_menu_8d6c11d2:

    # DUPREY "It was the two of us that pushed back Kalliban’s first invasion AND the Dark Elf King’s encroach. "
    DUPREY "C'était nous deux qui avons repoussé la première invasion de Kalliban ET l'empiètement du Roi des Elfes Noirs."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:410
translate fr qst_TheDarkPass_CampTalkDuprey_menu_89a0558d:

    # MC "That’s... That’s incredible!"
    MC "C'est... C'est incroyable !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:411
translate fr qst_TheDarkPass_CampTalkDuprey_menu_8523b42e:

    # DUPREY "Bah... I was a younger man back then, I ain’t as fast as I used to be."
    DUPREY "Bah... J'étais plus jeune à l'époque, je ne suis plus aussi rapide qu'avant."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:412
translate fr qst_TheDarkPass_CampTalkDuprey_menu_77f64d26:

    # DUPREY "Newheart though? The best warrior I’d ever met and a brilliant commander in the field."
    DUPREY "Newheart par contre ? Le meilleur guerrier que j'aie jamais rencontré et un brillant commandant sur le terrain."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:413
translate fr qst_TheDarkPass_CampTalkDuprey_menu_bc2aaa32:

    # DUPREY "Handsome bastard as well, got all the girls swooning after him."
    DUPREY "Un beau salaud en plus, il faisait craquer toutes les filles."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:414
translate fr qst_TheDarkPass_CampTalkDuprey_menu_0f58b1c0:

    # DUPREY "They still singing about him?"
    DUPREY "On chante encore à son sujet ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:415
translate fr qst_TheDarkPass_CampTalkDuprey_menu_0453fc0f:

    # MC "All the time! The man’s a legend!"
    MC "Tout le temps ! Ce type est une légende !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:416
translate fr qst_TheDarkPass_CampTalkDuprey_menu_d3379069:

    # MC "I can’t believe you actually met him! You’re bound to hear at least one song about him in any of the taverns once people have had a drink or two!"
    MC "Je n'arrive pas à croire que tu l'aies vraiment rencontré ! T'es sûr d'entendre au moins une chanson sur lui dans n'importe quelle taverne une fois que les gens ont bu un verre ou deux !"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:417
translate fr qst_TheDarkPass_CampTalkDuprey_menu_3829efd5:

    # DUPREY @ think "Hmph..."
    DUPREY @ think "Hmph..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:418
translate fr qst_TheDarkPass_CampTalkDuprey_menu_cc702e61:

    # MC "... Where did it all go wrong?"
    MC "... Où est-ce que tout a mal tourné ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:419
translate fr qst_TheDarkPass_CampTalkDuprey_menu_56d22cd3:

    # "The Captain had become morose as he reminisced, but his anger was now evident as his eyes glared into the embers of the fire."
    "Le capitaine était devenu morose en se remémorant, mais sa colère était maintenant évidente tandis que ses yeux foudroyaient les braises du feu."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:420
translate fr qst_TheDarkPass_CampTalkDuprey_menu_c44cfa87:

    # DUPREY "{i}Mesamor happened.{/i}"
    DUPREY "{i}Mesamor est arrivé.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:421
translate fr qst_TheDarkPass_CampTalkDuprey_menu_4a075af6:

    # MC "What do you mean?"
    MC "Qu'est-ce que tu veux dire ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:422
translate fr qst_TheDarkPass_CampTalkDuprey_menu_95893d7d:

    # DUPREY "I mean that old prick decided the siege tactics we had laid out would have taken too long."
    DUPREY "Je veux dire que ce vieux con a décidé que les tactiques de siège qu'on avait préparées auraient pris trop de temps."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:423
translate fr qst_TheDarkPass_CampTalkDuprey_menu_182fc79b:

    # DUPREY "So, he decided in his infinite fucking wisdom to push through some other general’s much more aggressive strategy."
    DUPREY "Alors, il a décidé dans son infinie sagesse de faire passer la stratégie bien plus agressive d'un autre général."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:424
translate fr qst_TheDarkPass_CampTalkDuprey_menu_546d1fd8:

    # DUPREY "Mesamor couldn’t stand the idea of a prolonged war, he wanted to take back Fort Rook as quickly as possible and march south to take back everything else he’d lost."
    DUPREY "Mesamor ne supportait pas l'idée d'une guerre prolongée, il voulait reprendre Fort Rook le plus vite possible et marcher vers le sud pour reconquérir tout ce qu'il avait perdu."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:425
translate fr qst_TheDarkPass_CampTalkDuprey_menu_90a9bd26:

    # MC "I take it you didn’t approve."
    MC "Je suppose que tu n'étais pas d'accord."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:426
translate fr qst_TheDarkPass_CampTalkDuprey_menu_07a85dee:

    # DUPREY "Years of actual battle experience and advice were cast out the window for the sake of bureaucracy, what do you think?"
    DUPREY "Des années d'expérience réelle du combat et des conseils ont été jetés par la fenêtre au nom de la bureaucratie, qu'en penses-tu ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:427
translate fr qst_TheDarkPass_CampTalkDuprey_menu_fdd64753:

    # MC "... So, what do you remember of the battle itself?"
    MC "... Alors, de quoi te souviens-tu de la bataille elle-même ?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:428
translate fr qst_TheDarkPass_CampTalkDuprey_menu_42fc440a:

    # DUPREY "Lots of fighting... Dead everywhere... I saw more bodies that day than most men see in a lifetime."
    DUPREY "Beaucoup de combats... Des morts partout... J'ai vu plus de corps ce jour-là que la plupart des hommes n'en voient dans une vie."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:429
translate fr qst_TheDarkPass_CampTalkDuprey_menu_719f6fe6:

    # DUPREY "From all the smoke and what felt like an avalanche of blood, it was hard just to breathe, never mind making sense of the field..."
    DUPREY "Avec toute cette fumée et ce qui ressemblait à une avalanche de sang, c'était à peine si on pouvait respirer, sans parler de comprendre ce qui se passait sur le champ de bataille..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:430
translate fr qst_TheDarkPass_CampTalkDuprey_menu_5b6ff3e4:

    # DUPREY "Across the way on a small hill, I saw Newheart in that shimmering armour you lot like singing about so much. "
    DUPREY "De l'autre côté, sur une petite colline, j'ai vu Newheart dans cette armure chatoyante dont vous autres aimez tant chanter."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:431
translate fr qst_TheDarkPass_CampTalkDuprey_menu_021f89e6:

    # DUPREY "He stood alone against the Demorai General, a monstrous thing I can’t seem to forget even when I try..."
    DUPREY "Il se tenait seul contre le Général Demorai, une chose monstrueuse que je n'arrive pas à oublier, même quand j'essaie..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:432
translate fr qst_TheDarkPass_CampTalkDuprey_menu_5d817988:

    # DUPREY "{i}Zanarak.{/i}"
    DUPREY "{i}Zanarak.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:433
translate fr qst_TheDarkPass_CampTalkDuprey_menu_cff33da7:

    # "{i}Zanarak{/i}, the bogeyman of every child in Alderay."
    "{i}Zanarak{/i}, le croque-mitaine de chaque enfant d'Alderay."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:434
translate fr qst_TheDarkPass_CampTalkDuprey_menu_0d9c3b4c:

    # "Stories spread far and wide of a supposed leader of the Demorai’s armies, unstoppable and ruthless, wings so large they could block out the sun and plunge an entire battlefield into a darkness as awful as himself..."
    "Des histoires se sont répandues partout sur un prétendu chef des armées Demorai, inarrêtable et impitoyable, dont les ailes si grandes qu'elles pouvaient bloquer le soleil et plonger un champ de bataille entier dans une obscurité aussi terrible que lui-même..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:435
translate fr qst_TheDarkPass_CampTalkDuprey_menu_6cc1af85:

    # "Some doubt if he ever existed, so few survivors remain whenever he’s claimed to have been sighted and the tales they told were wilder than the legends of Newheart."
    "Certains doutent qu'il ait jamais existé, tant il reste peu de survivants chaque fois qu'on prétend l'avoir aperçu, et les récits qu'ils faisaient étaient plus extravagants que les légendes de Newheart."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:436
translate fr qst_TheDarkPass_CampTalkDuprey_menu_ba79f724:

    # MC "He’s... {i}real?{/i}"
    MC "Il est... {i}réel ?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:437
translate fr qst_TheDarkPass_CampTalkDuprey_menu_42eb289b:

    # DUPREY "As real as you and me, boy... Make no mistake about that."
    DUPREY "Aussi réel que toi et moi, mon garçon... Ne te méprends pas là-dessus."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:438
translate fr qst_TheDarkPass_CampTalkDuprey_menu_aaabade5:

    # DUPREY "{i}*Sigh*{/i} He fought bravely..."
    DUPREY "{i}*Soupir*{/i} Il s'est battu vaillamment..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:439
translate fr qst_TheDarkPass_CampTalkDuprey_menu_445ed618:

    # MC "How did—"
    MC "Comment—"

