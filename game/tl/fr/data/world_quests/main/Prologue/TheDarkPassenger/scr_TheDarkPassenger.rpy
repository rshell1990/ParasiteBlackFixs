translate fr qst_TheDarkPass_ObelisksRoomCheckObelisks_5f8b107a:

    # "I was sitting on one of many rows of beds made up in a stone-cold room."
    "J'étais assis sur l'un des lits alignés en rangées dans une salle glaciale en pierre."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1463
translate fr qst_TheDarkPass_ObelisksRoomCheckObelisks_af2e3de3:

    # "Looking around I realised I was in... {i}Fort Sebastian?{/i}"
    "En regardant autour de moi, je réalisai que j'étais dans... {i}Fort Sebastian ?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1464
translate fr qst_TheDarkPass_ObelisksRoomCheckObelisks_06f0eaca:

