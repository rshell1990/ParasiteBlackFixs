    REGINA @ talk "... Eh bien..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:141
translate fr qst_Terminus_KitchenEnterMorning_8bbedfc6:

    # REGINA @ sad_talk "No, but..."
