    "Un pont massif s'étendait au-dessus d'un vaste gouffre menant à une obscurité profonde."

# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:288
translate fr qst_BigTroubleLHamun_beshar_golem_journey_go_bb426e9d:

