# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2251
translate fr qst_dreamhouse_l5_cellar_paper_7a9d7dbc:

    # "There... carefully placed in the center of the desk, a purple skull key."
    "Là... soigneusement placée au centre du bureau, une clé en forme de crâne violet."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2260
translate fr qst_dreamhouse_l5_library_fireplace_699ae0c6:

    # "The fire is out and completely soaked."
    "Le feu est éteint et complètement trempé."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2261
translate fr qst_dreamhouse_l5_library_fireplace_70a8c622:

    # "There though, hidden beneath a wet, rotten log, is a key with a lizard-shaped head."
    "Là cependant, cachée sous une bûche humide et pourrie, se trouve une clé avec une tête en forme de lézard."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2267
translate fr qst_dreamhouse_l5_library_bookshelf_1_187f9b50:

    # "The books are all soaking wet and destroyed."
    "Les livres sont tous trempés et détruits."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2272
translate fr qst_dreamhouse_l5_library_bookshelf_2_be2c8e3d:

    # "The pages are completely illegible."
    "Les pages sont complètement illisibles."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2273
translate fr qst_dreamhouse_l5_library_bookshelf_2_bacadf70:

    # "A book literally rots away in my hand as I try to pick it up."
    "Un livre pourrit littéralement dans ma main alors que j'essaie de le ramasser."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2278
translate fr qst_dreamhouse_l5_library_portrait_2280a906:

    # "... Creepy."
    "... Inquiétant."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2305
translate fr qst_dreamhouse_l5_gator_counter_e1669797:

    # "Suddenly, erupting from the water, a terrible, lizard-like creature snapping its jaws blocked our path!"
    "Soudain, surgissant de l'eau, une terrible créature ressemblant à un lézard, claquant des mâchoires, a bloqué notre chemin !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2307
translate fr qst_dreamhouse_l5_gator_counter_1049c4ec:

    # MC @ angry "Shit!"
    MC @ angry "Merde!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2323
translate fr qst_dreamhouse_l5_gator_counter_0d42adda:

    # KIARA @ scared "What in the world is that thing?!"
    KIARA @ scared "Qu'est-ce que c'est que cette chose ?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2324
