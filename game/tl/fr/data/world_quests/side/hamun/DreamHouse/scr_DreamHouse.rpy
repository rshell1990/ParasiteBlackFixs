    CHANYI @ talk "Une servante est venue lui apporter son petit-déjeuner, pour trouver le lit vide et une fenêtre ouverte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:177
translate fr qst_dreamhouse_enter_manor_menu3_589adbe4:

    # CHANYI @ talk "A note was left on the bed."
    CHANYI @ talk "Une note a été laissée sur le lit."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:178
translate fr qst_dreamhouse_enter_manor_menu3_966c9990:

    # "Lady Chanyi handed me the letter."
    "Lady Chanyi m'a tendu la lettre."

