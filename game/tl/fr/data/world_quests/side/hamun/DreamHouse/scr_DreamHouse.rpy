translate fr qst_dreamhouse_l5_bedroom_door_aeb91391:

    # MC "(It's locked.)"
    MC "(C'est verrouillé.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2186
translate fr qst_dreamhouse_l5_bedroom_door_0560ff66:

    # MC "(I need a key...)"
    MC "(J'ai besoin d'une clé...)"

