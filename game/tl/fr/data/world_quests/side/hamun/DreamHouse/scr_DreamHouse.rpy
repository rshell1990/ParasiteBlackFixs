translate fr qst_dreamhouse_l5_gator_counter_e813cad7:

    # KIARA "AHHHHH!"
    KIARA "AHHHHH !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2332
translate fr qst_dreamhouse_l5_gator_counter_090deb00:

    # MC @ surprised "KIARA!"
    MC @ surprised "KIARA !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2333
