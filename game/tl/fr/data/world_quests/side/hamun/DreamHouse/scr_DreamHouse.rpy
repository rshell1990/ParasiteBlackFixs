translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_9979a58c:

    # "Right?"
    "N'est-ce pas ?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2043
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_2938cfcc:

    # "{i}He said no.{/i}"
    "{i}Il a dit non.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2045
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_9f2a8d42:

    # "The book suddenly burst into flames in my hands!"
    "Le livre a soudainement pris feu dans mes mains !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2046
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_dbff601d:

    # MC @ surprised "FUCK!"
    MC @ surprised "PUTAIN !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2049
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_8210fe36:

    # "Mother has just told me her friend, the lady with the cat tail, is now also my mommy."
    "Mère vient de me dire que son amie, la dame avec la queue de chat, est maintenant aussi ma maman."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2050
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_be1e4a83:

    # "She seems nice, but maybe a little strict."
    "Elle semble gentille, mais peut-être un peu stricte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2051
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_103805ec:

    # "... But I don't think I need another mother."
    "... Mais je ne pense pas avoir besoin d'une autre mère."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2052
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_cda5af69:

    # "I just really miss father."
    "Mon père me manque vraiment."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2055
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_f05f2d15:

    # "I see father less and less."
    "Je vois de moins en moins mon père."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2056
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_99c2275b:

    # "It's been months now."
    "Cela fait des mois maintenant."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2057
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_e03bcff2:

    # "... Maybe he's just never coming back?"
    "... Peut-être qu'il ne reviendra jamais ?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2058
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_382f2858:

    # "Mother is talking about us leaving and heading to live in a place far away."
    "Mère parle de partir et d'aller vivre dans un endroit lointain."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2059
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_a0bb76e0:

    # "If that happens, will father still visit?"
    "Si cela arrive, est-ce que père viendra encore nous voir ?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2060
translate fr qst_dreamhouse_l4_library_bookshelf_1_menu_11402407:

    # "{i}... Does he still love me?{/i}"
    "{i}... Est-ce qu'il m'aime toujours ?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2071
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_99cef191:

    # "A man tried to kidnap me tonight. Thankfully, our guards managed to stop him."
    "Un homme a essayé de m'enlever ce soir. Heureusement, nos gardes ont réussi à l'arrêter."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2072
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_5db348b5:

    # "My mothers are terrified, but..."
    "Mes mères sont terrifiées, mais..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2073
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_514db6e3:

    # "I'm more frightened about what I might dream happens tonight."
    "J'ai plus peur de ce qui pourrait se passer dans mes rêves cette nuit."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2074
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_ca0a8285:

    # "... Between the pages, a green skull key fell out."
    "... Entre les pages, une clé crâne vert est tombée."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2078
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_5ac5c20e:

    # "I wish I had more actual friends."
    "J'aimerais avoir plus de vrais amis."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2079
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_a1157de1:

    # "I mean, the people at the academy are fine,"
    "Je veux dire, les gens à l'académie sont corrects,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2080
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_e5f52d0d:

    # "but it's all cliques and coin and..."
    "mais ce ne sont que des clans, l'argent et..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2081
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_fa990cff:

    # "No one is friends with anyone, really. It's all just strategic alignments."
    "Personne n'est vraiment ami avec personne. Ce ne sont que des alliances stratégiques."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2082
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_9b223944:

    # "... Fuck, I just wish someone was real for once."
    "... Putain, j'aimerais juste que quelqu'un soit authentique pour une fois."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2085
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_d47f9121:

    # "Father returned with a strange man."
    "Mon père est revenu avec un homme étrange."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2086
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_c3456a70:

    # "He said the two of them were going to help me get rid of the nightmares once and for all."
    "Il a dit qu'ils allaient m'aider à me débarrasser des cauchemars une bonne fois pour toutes."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2087
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_4ef80800:

    # "Father... You still remembered me!"
    "Père... Tu te souvenais encore de moi !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2090
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_b537a0dd:

    # "I had a strange dream tonight. A man, handsome with black hair."
    "J'ai fait un rêve étrange cette nuit. Un homme, beau, aux cheveux noirs."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2091
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_d64178bc:

    # "But he wasn't fully human. Inside of him... there was another soul."
    "Mais il n'était pas entièrement humain. À l'intérieur de lui... il y avait une autre âme."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2092
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_1b253a90:

    # "He swore he would save me, but it's so strange..."
    "Il a juré qu'il me sauverait, mais c'est tellement étrange..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2093
translate fr qst_dreamhouse_l4_library_bookshelf_2_menu_7b0b2236:

    # "I've never even seen this man before in my life?"
    "Je n'ai jamais vu cet homme de ma vie ?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2101
translate fr qst_dreamhouse_l4_library_portrait_8ffbc82d:

    # "Why would anyone paint this?"
    "Pourquoi quelqu'un peindrait-il cela ?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2121
translate fr qst_dreamhouse_l5_start_352f5d88:

    # "As we pushed on once more through the bright light, we found ourselves again in the entrance hallway of the house,"
    "Alors que nous poursuivions notre chemin une fois de plus à travers la lumière éclatante, nous nous sommes retrouvés à nouveau dans le hall d'entrée de la maison,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2122
translate fr qst_dreamhouse_l5_start_5122da77:

    # "only to face a brand new horror..."
    "pour nous retrouver face à une toute nouvelle horreur..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2123
translate fr qst_dreamhouse_l5_start_b10dd20e:

    # MARKUS @ scared "The house is flooded!"
    MARKUS @ scared "La maison est inondée !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2127
translate fr qst_dreamhouse_l5_start_486c0433:

    # SYPHA @ angry "Urgh... This better not ruin my clothes!"
    SYPHA @ angry "Urgh... Pourvu que ça n'abîme pas mes vêtements !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2130
translate fr qst_dreamhouse_l5_start_062c2bf8:

    # VES @ talk "How much more of this damn house is there?!"
    VES @ talk "Combien reste-t-il de cette fichue maison ?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2132
translate fr qst_dreamhouse_l5_start_17f2980a:

    # KIARA @ sad "Brrr! This water's so cold!"
    KIARA @ sad "Brrr ! L'eau est tellement froide !"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2134
translate fr qst_dreamhouse_l5_start_7f9a289d:

    # KIARA @ sad "I can't see a damn thing beneath it!"
    KIARA @ sad "Je ne vois absolument rien sous l'eau !"

