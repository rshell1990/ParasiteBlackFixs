translate fr qst_dreamhouse_l5_start_65d8894b:

    # "Hearing something splash, I quickly turned my attention toward it."
    "En entendant un bruit d'éclaboussure, j'ai rapidement tourné mon attention dans cette direction."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2140
translate fr qst_dreamhouse_l5_start_90d542c5:

    # MC @ serious "What was that?"
    MC @ serious "Qu'est-ce que c'était ?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2142
translate fr qst_dreamhouse_l5_start_65e22635:

    # SYPHA @ talk "I don't know, but the last thing we should do is wait around and find out..."
    SYPHA @ talk "Je ne sais pas, mais la dernière chose que nous devrions faire, c'est rester ici à attendre de voir..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2149
translate fr qst_dreamhouse_l5_bathtub_f1bb8145:

    # "It's completely rotten away and covered in mold."
