translate fr ev_AdaraDream_25f93f64:

    # BLACK "Like glass shattered... My memories are fractured but still there."
    BLACK "Comme du verre brisé... Mes souvenirs sont fracturés mais toujours là."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:65
translate fr ev_AdaraDream_9383871b:

