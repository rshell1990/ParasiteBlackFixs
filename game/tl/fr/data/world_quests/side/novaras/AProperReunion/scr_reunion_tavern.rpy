translate fr qst_reunion_tavern_bcd3015d:

    # MC @ talk "Me and Markus were the last ones left, we headed down into the underground of the fort and sealed ourselves in this small cavern."
    MC @ talk "Markus et moi étions les derniers restants, nous sommes descendus dans les souterrains du fort et nous nous sommes enfermés dans cette petite caverne."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:58
translate fr qst_reunion_tavern_ff512f24:

    # ADARA @ talk "Then what happened?"
    ADARA @ talk "Et ensuite ?"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:59
translate fr qst_reunion_tavern_390e3879:

