translate fr qst_reunion_tavern_6c707b23:

    # "...I can’t tell her everything, but at least I can tell her some part of the truth about what happened back then."
    "...Je ne peux pas tout lui dire, mais au moins je peux lui dire une partie de la vérité sur ce qui s’est passé à l’époque."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:66
translate fr qst_reunion_tavern_a05811dc:

