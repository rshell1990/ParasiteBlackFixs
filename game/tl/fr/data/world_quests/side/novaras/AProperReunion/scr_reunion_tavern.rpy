translate fr qst_reunion_tavern_fd21584e:

    # MC @ talk "I... No."
    MC @ talk "Je... Non."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:75
translate fr qst_reunion_tavern_e24026a9:

    # MC @ talk "But something happened in there and it {i}changed{/i} us."
    MC @ talk "Mais quelque chose s’est passé là-dedans et cela nous a {i}changés{/i}."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:76
translate fr qst_reunion_tavern_834d1f41:

