    ADARA @ talk "{i}Tu veux dire... Quelque chose est à l’intérieur de vous deux maintenant?{/i}"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:77
translate fr qst_reunion_tavern_024e1267:

