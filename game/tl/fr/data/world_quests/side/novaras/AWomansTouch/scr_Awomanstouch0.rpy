    MC "(Peut-être que pendant qu'elle est sortie, je pourrais regarder de plus près certaines des choses qu'elle a lues.)"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:8
translate fr scr_WomansTouch_primer_489d4313:

    # "Picking up one of Elena's history books, a hidden book concealed amongst the pages felt out and landed on the floor."
    "En ramassant un des livres d'histoire d'Elena, un livre caché dissimulé parmi les pages est tombé et a atterri sur le sol."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:9
translate fr scr_WomansTouch_primer_6280ef98:

    # MC "(What's this?)"
    MC "(Qu'est-ce que c'est ?)"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:10
translate fr scr_WomansTouch_primer_adfd9413:

    # "I picked up the book to examine it."
    "J'ai ramassé le livre pour l'examiner."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:11
translate fr scr_WomansTouch_primer_b9bfd404:

    # "{i}Her Masters call, a lycanite love story - illustrated - By B. Rohmway{/i}"
    "{i}L'Appel de ses Maîtres, une histoire d'amour lycanite - illustrée - Par B. Rohmway{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:12
translate fr scr_WomansTouch_primer_e952911f:

    # "Flipping through some of the pages, they depicted black and white sketch images of a wolf girl in various states of romance, passionate sex and... bondage with a muscular human man."
    "En feuilletant quelques pages, elles représentaient des esquisses en noir et blanc d'une fille-louve dans divers états de romance, de sexe passionné et... de bondage avec un homme humain musclé."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:13
translate fr scr_WomansTouch_primer_341ec86a:

    # MC "(Elena!)"
    MC "(Elena !)"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:14
translate fr scr_WomansTouch_primer_8398a7a1:

    # "The door suddenly creaked open as I turned to see Elena stood in the doorway in her wolf form, suddenly transforming human with a terrified expression on her face."
    "La porte s'est soudainement ouverte en grinçant alors que je me retournais pour voir Elena debout dans l'encadrement de la porte sous sa forme de louve, se transformant soudainement en humaine avec une expression terrifiée sur le visage."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:18
translate fr scr_WomansTouch_primer_5ed61425:

    # ELENA @ shock "T-That isn't what you think!"
    ELENA @ shock "C-Ce n'est pas ce que tu penses !"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:19
translate fr scr_WomansTouch_primer_b5613ef5:

    # MC @ talk "Well, it looks to me to be VERY different kind of {i}fantasy{/i} book that I was expecting you to read."
    MC @ talk "Eh bien, il me semble que c'est un genre de livre de {i}fantasy{/i} TRÈS différent de celui que je m'attendais à te voir lire."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:20
translate fr scr_WomansTouch_primer_a6be2184:

    # ELENA @ shock "It's v-very rare and banned! I was um, um! Amazed the library even had it!"
    ELENA @ shock "C'est tr-très rare et interdit ! J'étais euh, euh ! Étonnée que la bibliothèque l'ait même !"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:21
translate fr scr_WomansTouch_primer_ad65eed7:

    # ELENA @ shock "S-So I-"
    ELENA @ shock "D-Donc je-"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:22
translate fr scr_WomansTouch_primer_6e383750:

    # MC @ smile "Elena, you can enjoy whatever you like."
    MC @ smile "Elena, tu peux aimer ce que tu veux."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:23
translate fr scr_WomansTouch_primer_b809c8ad:

    # ELENA @ sad "...Really though?"
    ELENA @ sad "...Vraiment ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:24
translate fr scr_WomansTouch_primer_11b84398:

    # ELENA @ sad "You don't think it's wrong?"
    ELENA @ sad "Tu ne penses pas que ce soit mal ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:25
translate fr scr_WomansTouch_primer_77f7e3f0:

    # MC @ talk "Why would I?"
    MC @ talk "Pourquoi le penserais-je ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:26
translate fr scr_WomansTouch_primer_7f6b7c34:

    # ELENA @ sad "...Because... I'm not human."
    ELENA @ sad "...Parce que... je ne suis pas humaine."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:27
translate fr scr_WomansTouch_primer_88820f55:

    # MC @ talk "...And?"
    MC @ talk "...Et ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:28
translate fr scr_WomansTouch_primer_b8c864f9:

    # ELENA @ sad "I... I always presumed my attraction to humans was some kind of unnatural perversion."
    ELENA @ sad "Je... J'ai toujours présumé que mon attirance pour les humains était une sorte de perversion contre nature."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:29
translate fr scr_WomansTouch_primer_7cfc3e2a:

    # ELENA @ sad "No doubt the result of having been raised amongst humans with no interaction with my own kind..."
    ELENA @ sad "Sans doute le résultat d'avoir été élevée parmi les humains sans aucune interaction avec les miens..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:30
translate fr scr_WomansTouch_primer_2207c685:

    # MC @ talk "How do you know?"
    MC @ talk "Comment le sais-tu ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:31
translate fr scr_WomansTouch_primer_14e9c3c4:

    # ELENA @ talk "What do you mean?"
    ELENA @ talk "Que veux-tu dire ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:32
translate fr scr_WomansTouch_primer_50564ccf:

    # MC @ talk "I mean, how do you know others of your kind don't find humans attractive?"
    MC @ talk "Je veux dire, comment sais-tu que d'autres de ton espèce ne trouvent pas les humains attirants ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:33
translate fr scr_WomansTouch_primer_b0a174d6:

    # ELENA @ shock "I-"
    ELENA @ shock "Je-"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:34
translate fr scr_WomansTouch_primer_8412bde5:

    # ELENA @ talk "...Father used to discourage me from anything like that, he said I had to keep my mind clear to focus on keeping Grace safe and nothing else."
    ELENA @ talk "...Père me décourageait de toute chose de ce genre, il disait que je devais garder l'esprit clair pour me concentrer uniquement sur la sécurité de Grace."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:35
translate fr scr_WomansTouch_primer_eb328f02:

    # MC @ talk "You're still a woman Elena, you cannot help having desires."
    MC @ talk "Tu es toujours une femme Elena, tu ne peux pas t'empêcher d'avoir des désirs."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:36
translate fr scr_WomansTouch_primer_59d4ff19:

    # ELENA @ sad "I wouldn't really know..."
    ELENA @ sad "Je ne saurais pas vraiment..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:37
translate fr scr_WomansTouch_primer_a2afe298:

    # MC @ surprised "...Wait, are you a-"
    MC @ surprised "...Attends, es-tu une-"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:38
translate fr scr_WomansTouch_primer_578e28c4:

    # ELENA @ sad "Yes, I'm a virgin."
    ELENA @ sad "Oui, je suis vierge."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:39
translate fr scr_WomansTouch_primer_de725d08:

    # "Elena seemed visibly upset by this."
    "Elena semblait visiblement contrariée par cela."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:40
translate fr scr_WomansTouch_primer_84719fad:

    # MC @ talk "Elena, there's nothing to be ashamed of."
    MC @ talk "Elena, il n'y a rien dont tu devrais avoir honte."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:41
translate fr scr_WomansTouch_primer_24e071da:

    # ELENA @ sad "Please... I know it shouldn't bother me but it does, the lady Grace was always chased after by suitors."
    ELENA @ sad "S'il te plaît… Je sais que ça ne devrait pas me déranger, mais c'est le cas. Lady Grace était toujours courtisée par des prétendants."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:42
translate fr scr_WomansTouch_primer_7900ee80:

    # ELENA @ sad "Those few who knew of my secret had little time for one such as I."
    ELENA @ sad "Les rares personnes qui connaissaient mon secret n'avaient guère de temps pour quelqu'un comme moi."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:43
translate fr scr_WomansTouch_primer_b8092dba:

    # MC @ sad "None saw you as a woman?"
    MC @ sad "Personne ne te voyait comme une femme ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:44
translate fr scr_WomansTouch_primer_60994b39:

    # ELENA @ talk "...When I was younger, there were a few 'trusted' children from noble families who owed debts to father who would come and play with me and Grace."
    ELENA @ talk "...Quand j'étais plus jeune, il y avait quelques enfants 'de confiance' de familles nobles qui devaient des dettes à mon père et qui venaient jouer avec moi et Grace."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:45
translate fr scr_WomansTouch_primer_0e119aa0:

    # ELENA @ grumpy "One of them, Trohan, always made his dislike of me quite vocal."
    ELENA @ grumpy "L'un d'eux, Trohan, exprimait toujours très ouvertement son aversion pour moi."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:46
translate fr scr_WomansTouch_primer_ffb71588:

    # ELENA @ angry "{i}'What man would want a woman more hairier than himself?'{/i} He would tell me."
    ELENA @ angry "{i}'Quel homme voudrait d'une femme plus poilue que lui ?'{/i} me disait-il."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:47
translate fr scr_WomansTouch_primer_3f1d3ec6:

    # ELENA @ talk "One day though, as we grew older... I was bathing once beneath some falls in the privacy of the woods."
    ELENA @ talk "Un jour, pourtant, alors que nous grandissions... Je me suis baignée une fois sous des cascades, dans l'intimité des bois."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:48
translate fr scr_WomansTouch_primer_92e827a8:

    # ELENA @ lewd "I saw him watching me in secret while he... {i}occupied himself.{/i}"
    ELENA @ lewd "Je l'ai vu me regarder en secret pendant qu'il... {i}s'occupait.{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:49
translate fr scr_WomansTouch_primer_b977dd8b:

    # MC @ talk "What did you do?"
    MC @ talk "Qu'as-tu fait ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:50
translate fr scr_WomansTouch_primer_5f05e686:

    # ELENA @ lewd "...I let him watch."
    ELENA @ lewd "...Je l'ai laissé regarder."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:51
translate fr scr_WomansTouch_primer_ac431a22:

    # MC @ talk "Why?"
    MC @ talk "Pourquoi ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:52
translate fr scr_WomansTouch_primer_fb3cd3ee:

    # ELENA @ lewd "It was exciting... To see a man wanting me that way."
    ELENA @ lewd "C'était excitant... De voir un homme me désirer de cette façon."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:53
translate fr scr_WomansTouch_primer_6695437a:

    # ELENA @ lewd "So...{i}I would keep letting him watch.{/i}"
    ELENA @ lewd "Alors...{i}j'ai continué à le laisser regarder.{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:54
translate fr scr_WomansTouch_primer_11a5e1e5:

    # MC @ talk "He never approached you?"
    MC @ talk "Il ne t'a jamais approchée ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:55
translate fr scr_WomansTouch_primer_f3b60fd0:

    # ELENA @ lewd "No, but one time our eyes met and he realized this whole time I was letting him continue."
    ELENA @ lewd "Non, mais une fois, nos regards se sont croisés et il a réalisé que tout ce temps, je le laissais continuer."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:56
translate fr scr_WomansTouch_primer_49022e3c:

    # ELENA @ lewd "After that, he was considerably nicer to me..."
    ELENA @ lewd "Après cela, il a été nettement plus gentil avec moi..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:57
translate fr scr_WomansTouch_primer_ec909508:

    # ELENA @ talk "I'd never seen the lady Grace become jealous before."
    ELENA @ talk "Je n'avais jamais vu Lady Grace devenir jalouse auparavant."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:58
translate fr scr_WomansTouch_primer_3267c10e:

    # MC @ talk "She wasn't happy for you?"
    MC @ talk "Elle n'était pas heureuse pour toi ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:59
translate fr scr_WomansTouch_primer_8b1c7cbd:

    # ELENA @ grumpy "She wasn't happy when {i}anyone{/i} took the attention away from her."
    ELENA @ grumpy "Elle n'était pas heureuse quand {i}quelqu'un{/i} lui prenait l'attention."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:60
translate fr scr_WomansTouch_primer_de58e436:

    # MC @ talk "...I see."
    MC @ talk "...Je vois."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:61
translate fr scr_WomansTouch_primer_6eaae46b:

    # ELENA @ sad "But I suppose I never really got over my fascination with that first feeling of {i}being desired.{/i}"
    ELENA @ sad "Mais je suppose que je n'ai jamais vraiment surmonté ma fascination pour cette première sensation d'{i}être désiré.{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:62
translate fr scr_WomansTouch_primer_7311b72e:

    # "Looking down at the book, I reached out to hand it back to Elena who took it from me."
    "Baissant les yeux sur le livre, j'ai tendu la main pour le rendre à Elena qui l'a pris."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:63
translate fr scr_WomansTouch_primer_73894c05:

