# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:5
translate fr scr_WomansTouch_1_bb4f4d83:

    # HELENA @ talk "And what matter could I help you with?"
    HELENA @ talk "Et en quelle affaire pourrais-je vous aider ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:6
translate fr scr_WomansTouch_1_4c7f46eb:

    # MC @ talk "It is... a young maiden."
    MC @ talk "C'est... une jeune demoiselle."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:7
translate fr scr_WomansTouch_1_a1a8ff03:

    # MC @ talk "Who wishes to speak with someone and understand her desires better."
    MC @ talk "Qui souhaite parler à quelqu'un et mieux comprendre ses désirs."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:8
translate fr scr_WomansTouch_1_6efa0568:

    # "Helena raised an eyebrow at the comment."
    "Helena haussa un sourcil à cette remarque."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:9
translate fr scr_WomansTouch_1_3ee116f0:

    # HELENA @ shock "And her mother has not taught her these things?"
    HELENA @ shock "Et sa mère ne lui a pas enseigné ces choses ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:10
translate fr scr_WomansTouch_1_9088fb63:

    # MC @ talk "She has no mother, nor father."
    MC @ talk "Elle n'a ni mère, ni père."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:11
translate fr scr_WomansTouch_1_9e1ee060:

    # MC @ talk "I don't feel the words of a man are what she wants to hear."
    MC @ talk "Je ne pense pas que les paroles d'un homme soient ce qu'elle souhaite entendre."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:12
translate fr scr_WomansTouch_1_99f0308c:

    # HELENA @ sad "I see... How tragic, but why me?"
    HELENA @ sad "Je vois... Quelle tragédie, mais pourquoi moi ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:13
translate fr scr_WomansTouch_1_85f27e4f:

    # HELENA @ talk "Surely some other girl closer to you could speak to her."
    HELENA @ talk "Une autre fille qui vous est proche pourrait sûrement lui parler."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:14
translate fr scr_WomansTouch_1_531a34c9:

    # MC @ talk "I believe in this case a stranger might be better..."
    MC @ talk "Je crois que dans ce cas, une étrangère serait préférable..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:15
translate fr scr_WomansTouch_1_4249bd08:

    # MC @ talk "The situation is... {i}delicate{/i} and silent discretion is needed."
    MC @ talk "La situation est... {i}délicate{/i} et une discrétion silencieuse est nécessaire."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:16
translate fr scr_WomansTouch_1_5baea012:

    # HELENA @ smile "...A courtesan's silence is bound by coin."
    HELENA @ smile "...Le silence d'une courtisane est lié par l'argent."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:17
translate fr scr_WomansTouch_1_ff7bd2ea:

    # HELENA @ talk "If the matter is as 'delicate' as you say it is, then my help is for a hundred coins at least."
    HELENA @ talk "Si l'affaire est aussi 'délicate' que vous le dites, alors mon aide vous coûtera au moins cent pièces."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:18
translate fr scr_WomansTouch_1_cd4af192:

    # HELENA @ talk "And that is ONLY to consult with the girl, do not try pushing for anything else."
    HELENA @ talk "Et cela est UNIQUEMENT pour consulter la fille, n'essayez pas d'en demander davantage."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:19
translate fr scr_WomansTouch_1_5e6cb9ea:

    # MC @ talk "I agree to your terms."
    MC @ talk "J'accepte vos conditions."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:23
translate fr scr_WomansTouch_helenaMenu_be87999a:

    # HELENA @ talk "A hundred coins for my services it is."
    HELENA @ talk "Cent pièces pour mes services, c'est entendu."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:27
translate fr scr_WomansTouch_helenaMenu_ed125ef9:

    # HELENA @ talk "...Very well, bring the girl to me."
    HELENA @ talk "...Très bien, amenez-moi la fille."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:28
translate fr scr_WomansTouch_helenaMenu_6c536458:

    # MC @ talk "Is there a room or somewhere private we may go?"
    MC @ talk "Y a-t-il une chambre ou un endroit privé où nous pourrions aller ?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:29
translate fr scr_WomansTouch_helenaMenu_f2296ef1:

    # HELENA @ talk "This way..."
    HELENA @ talk "Par ici..."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch1.rpy:33
translate fr scr_WomansTouch_helenaMenu_a7f9ce18:

    # HELENA @ talk "Return when you have the coin."
    HELENA @ talk "Revenez quand vous aurez l'argent."

