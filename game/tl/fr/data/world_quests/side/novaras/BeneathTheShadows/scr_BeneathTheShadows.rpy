# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:78
translate fr qst_beneath_shadows_enter_bordello_meet_carina_3227fc26:

    # "A scandal that rocked all of Alderay just a few years ago, Lord Halchek, handsome, young and married to his beautiful wife, seemed like the perfect couple."
    "Un scandale qui a secoué tout Alderay il y a quelques années à peine. Lord Halchek, beau, jeune et marié à sa magnifique épouse, semblait former le couple parfait."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:79
translate fr qst_beneath_shadows_enter_bordello_meet_carina_0b3a9aa0:

    # "Romantic tales were often spun about him and his wife, and the promise of a {i}new,{/i} young aristocracy not embroiled in the corruption of old."
    "Des histoires romantiques circulaient souvent à propos de lui et de sa femme, et la promesse d'une {i}nouvelle{/i} aristocratie jeune non impliquée dans la corruption de l'ancienne."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:80
translate fr qst_beneath_shadows_enter_bordello_meet_carina_9cef3c0c:

