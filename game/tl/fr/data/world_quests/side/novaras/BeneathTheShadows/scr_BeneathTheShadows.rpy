    CARINA @ talk "Mais non, c'est mon 'amusement' maladroit avec le seigneur Halchek dont ils se souviennent."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:85
translate fr qst_beneath_shadows_enter_bordello_meet_carina_564b167b:

