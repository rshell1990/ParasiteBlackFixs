translate fr qst_DamzelDizzt_2_sneaky_e000afd9:

    # MC @ talk "We should try getting close to Tarek to get rid of him."
    MC @ talk "Nous devrions essayer de nous rapprocher de Tarek pour nous en débarrasser."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:3
translate fr qst_DamzelDizzt_2_sneaky_3a07c435:

    # MARKUS "Well, any ideas anyone?"
    MARKUS "Eh bien, quelqu'un a une idée ?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:4
translate fr qst_DamzelDizzt_2_sneaky_b79580ae:

    # "Nijah slowly raised her hand nervously."
    "Nijah leva lentement la main, nerveusement."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:5
translate fr qst_DamzelDizzt_2_sneaky_77bed641:

    # NIJAH "... I haz idea."
    NIJAH "... J'ai une idée."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:6
translate fr qst_DamzelDizzt_2_sneaky_1889db95:

    # "We both turned towards Nijah as she spoke."
    "Nous nous sommes tous les deux tournés vers Nijah alors qu'elle parlait."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:7
translate fr qst_DamzelDizzt_2_sneaky_dc935d62:

    # NIJAH "There iz a plant people from Ramon grow in their homes."
    NIJAH "Il y a une plante que les gens de Ramon font pousser chez eux."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:8
translate fr qst_DamzelDizzt_2_sneaky_8bdf84a2:

    # NIJAH "It iz good for the air, but very bad to consume..."
    NIJAH "C'est bon pour l'air, mais très mauvais à consommer..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:9
translate fr qst_DamzelDizzt_2_sneaky_2d62b928:

    # MC @ talk "... Poison?"
    MC @ talk "... Du poison ?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:10
translate fr qst_DamzelDizzt_2_sneaky_8eab6dec:

    # "Nijah nodded."
    "Nijah hocha la tête."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:11
translate fr qst_DamzelDizzt_2_sneaky_f9edcc11:

    # NIJAH "It iz called {i}‘Amira’s Tears’{/i}."
    NIJAH "On l'appelle {i}‘Les Larmes d’Amira’{/i}."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:12
translate fr qst_DamzelDizzt_2_sneaky_08a7378a:

    # NIJAH "It iz said to have no taste when mixed with wine."
    NIJAH "On dit qu'il n'a pas de goût lorsqu'il est mélangé au vin."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:19
translate fr qst_DamzelDizzt_2_sneaky_Menu_dfdd933d:

    # NIJAH "Princess Helma long ago fell in love with Prince Abdel of Aruna, back then, Ramon was many small kingdoms."
    NIJAH "La princesse Helma tomba amoureuse du prince Abdel d'Aruna il y a longtemps, à l'époque où Ramon était composé de nombreux petits royaumes."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:20
translate fr qst_DamzelDizzt_2_sneaky_Menu_0defd9e6:

    # NIJAH "They were to wed, but Abdel was still in love with his favourite concubine, Amira, who had known him since they were children."
    NIJAH "Ils devaient se marier, mais Abdel était toujours amoureux de sa concubine préférée, Amira, qui le connaissait depuis leur enfance."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:21
translate fr qst_DamzelDizzt_2_sneaky_Menu_a18656fa:

    # NIJAH "Amira was too low standing to marry Abdel herself, but she was pregnant with his child."
    NIJAH "Amira était de trop basse condition pour épouser Abdel elle-même, mais elle était enceinte de son enfant."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:22
translate fr qst_DamzelDizzt_2_sneaky_Menu_4ba4fc73:

    # NIJAH "Amira knew, she could claim legitimacy once zer child was born as long as Abdel was not married."
    NIJAH "Amira savait qu'elle pourrait revendiquer la légitimité une fois son enfant né, tant qu'Abdel n'était pas marié."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:23
translate fr qst_DamzelDizzt_2_sneaky_Menu_3f85563f:

    # NIJAH "That way, Princess Helma thought her child would have to be acknowledged."
    NIJAH "Ainsi, la princesse Helma pensait que son enfant devrait être reconnu."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:24
translate fr qst_DamzelDizzt_2_sneaky_Menu_b8e6f1c6:

    # NIJAH "So, on zer night of zer wedding, Amira poisoned Princess Helma’s cup."
    NIJAH "Alors, la nuit du mariage, Amira empoisonna la coupe de la princesse Helma."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:25
translate fr qst_DamzelDizzt_2_sneaky_Menu_15655561:

    # NIJAH "But to her horror, Prince Abdel grabbed her drink by mistake to raise his cup in his new wife’s honour."
    NIJAH "Mais à sa grande horreur, le prince Abdel attrapa par erreur sa boisson pour lever son verre en l'honneur de sa nouvelle épouse."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:26
translate fr qst_DamzelDizzt_2_sneaky_Menu_233a1b94:

    # NIJAH "He drunk za wine before she could stop him and he died in Helma’s arms."
    NIJAH "Il but le vin avant qu'elle ne puisse l'arrêter et il mourut dans les bras d'Helma."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:27
translate fr qst_DamzelDizzt_2_sneaky_Menu_2c9208f6:

    # NIJAH "She cried seven days and nights in regret, while the guards looked for the poisoner."
    NIJAH "Elle pleura sept jours et sept nuits de regret, tandis que les gardes cherchaient l'empoisonneuse."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:28
translate fr qst_DamzelDizzt_2_sneaky_Menu_c92a7c6d:

    # NIJAH "When zer guards finally discovered her plot, they came to arrest her, but before they could, she flung herself from the tower to her death."
    NIJAH "Lorsque les gardes ont finalement découvert son complot, ils sont venus l'arrêter, mais avant qu'ils ne le puissent, elle s'est jetée de la tour pour trouver la mort."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:29
translate fr qst_DamzelDizzt_2_sneaky_Menu_c6897247:

    # NIJAH "So, we call the flower Amira’s Tears, zo we never forget the pain it can bring."
    NIJAH "Ainsi, nous appelons la fleur « Amira’s Tears », afin de ne jamais oublier la douleur qu'elle peut apporter."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:35
translate fr qst_DamzelDizzt_2_sneaky_Menu_14fa5c56:

    # MARKUS "Whoa, whoa, whoa, how are we going to get close Tarek? We still need that part of the plan."
    MARKUS "Whoa, whoa, whoa, comment allons-nous nous approcher de Tarek ? Nous avons encore besoin de cette partie du plan."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:36
translate fr qst_DamzelDizzt_2_sneaky_Menu_a1cba0eb:

    # MARKUS "Ah yes, I know you've never met us before, but if you don't mind having a few sips of this."
    MARKUS "Ah oui, je sais que vous ne nous avez jamais rencontrés auparavant, mais si cela ne vous dérange pas de prendre quelques gorgées de ceci."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:37
translate fr qst_DamzelDizzt_2_sneaky_Menu_cdacd63f:

    # MARKUS "Ah, yes of course it's fine!"
    MARKUS "Ah, oui, bien sûr, c'est très bien !"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:38
translate fr qst_DamzelDizzt_2_sneaky_Menu_f7e7ddad:

    # NIJAH "I would be bait."
    NIJAH "Je serais l'appât."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:39
translate fr qst_DamzelDizzt_2_sneaky_Menu_4f3400b3:

    # MARKUS "..."
    MARKUS "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:40
translate fr qst_DamzelDizzt_2_sneaky_Menu_8418a966:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:41
translate fr qst_DamzelDizzt_2_sneaky_Menu_bce36b78:

    # NIJAH "What? Iz good idea."
    NIJAH "Quoi ? C'est une bonne idée."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:42
translate fr qst_DamzelDizzt_2_sneaky_Menu_ad155bcf:

    # NIJAH "If you take me there with my hands tied, they will take you to Tarek."
    NIJAH "Si vous m'emmenez là-bas les mains liées, ils vous emmèneront à Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:43
translate fr qst_DamzelDizzt_2_sneaky_Menu_20bbb4f7:

    # NIJAH "Then, give him zer poisoned wine."
    NIJAH "Alors, donne-lui le vin empoisonné."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:44
translate fr qst_DamzelDizzt_2_sneaky_Menu_5955143c:

    # MC @ talk "If things go wrong, you could get hurt."
    MC @ talk "Si les choses tournent mal, tu pourrais te blesser."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:45
translate fr qst_DamzelDizzt_2_sneaky_Menu_e995d091:

    # "Nijah smiled faintly."
    "Nijah sourit faiblement."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:46
translate fr qst_DamzelDizzt_2_sneaky_Menu_d7616302:

    # NIJAH "We try anyway."
    NIJAH "On essaie quand même."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:47
translate fr qst_DamzelDizzt_2_sneaky_Menu_96633acd:

    # MC @ talk "Alright then..."
    MC @ talk "Très bien alors..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:48
translate fr qst_DamzelDizzt_2_sneaky_Menu_6ffc6a88:

    # NIJAH "Let me know when you want me to make za poisoned wine..."
    NIJAH "Fais-moi savoir quand tu voudras que je prépare le vin empoisonné..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:57
translate fr qst_DamzelDizzt_2_sneaky_Menu_651b3407:

    # "Later that night, with the poisoned bottle of wine in hand, we made our way towards the Black Diamond."
    "Plus tard cette nuit-là, avec la bouteille de vin empoisonné à la main, nous nous dirigeâmes vers le Diamant Noir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:58
translate fr qst_DamzelDizzt_2_sneaky_Menu_2a7fe204:

    # "Nijah's hands were only loosely bound for a quick escape if needed."
    "Les mains de Nijah n'étaient que lâchement liées pour une fuite rapide si nécessaire."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:59
translate fr qst_DamzelDizzt_2_sneaky_Menu_8693979e:

    # "Knocking on the door, a slider was pulled open for two piercing eyes to glare at us from."
    "En frappant à la porte, un judas fut ouvert, laissant deux yeux perçants nous dévisager."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:60
translate fr qst_DamzelDizzt_2_sneaky_Menu_231a8663:

    # "Satisfied, the slider closed again, and we heard the door unlock and open just wide enough for us to slip inside."
    "Satisfait, le judas se referma, et nous entendîmes la porte se déverrouiller et s'ouvrir juste assez pour nous glisser à l'intérieur."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:61
translate fr qst_DamzelDizzt_2_sneaky_Menu_160edc22:

    # MC @ talk "We’re here to see Tarek."
    MC @ talk "Nous sommes ici pour voir Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:62
translate fr qst_DamzelDizzt_2_sneaky_Menu_d67b5b09:

    # MC @ talk "We have something he wants."
    MC @ talk "Nous avons quelque chose qu'il veut."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:63
translate fr qst_DamzelDizzt_2_sneaky_Menu_90f2a96c:

    # "The guard looked Nijah up and down and grinned."
    "Le garde a regardé Nijah de haut en bas et a souri."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:64
translate fr qst_DamzelDizzt_2_sneaky_Menu_19ddfa68:

    # "Nijah uncomfortably averted her gaze as the guard allowed us to pass."
    "Nijah a détourné le regard, mal à l'aise, alors que le garde nous laissait passer."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:65
translate fr qst_DamzelDizzt_2_sneaky_Menu_4746e27c:

    # "Giving her ass a quick slap as she stumbled by, Nijah scowled at him, and I felt a tinge of rage to lash out at the man but held back."
    "Alors qu'elle trébuchait en passant, il lui a donné une claque rapide sur les fesses ; Nijah lui a lancé un regard furieux, et j'ai ressenti une pointe de rage, prêt à m'en prendre à cet homme, mais je me suis retenu."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:73
translate fr qst_DamzelDizzt_2_sneaky_Menu_1b5b8995:

    # "Sprawled about the place were figures half-dazed in a drug fuelled haze, looking up to us in a dream-like state before slipping away back to chasing dragons."
    "Éparpillées dans l'endroit, des silhouettes à moitié assommées par la drogue nous regardaient avec un état proche du rêve avant de retourner à leur trip."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:74
translate fr qst_DamzelDizzt_2_sneaky_Menu_034f7d0b:

    # "The air was thick with smoke and difficult to breathe in for one unaccustomed to its harshness,"
    "L'air était épais de fumée et difficile à respirer pour quelqu'un qui n'est pas habitué à son âpreté,"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:75
translate fr qst_DamzelDizzt_2_sneaky_Menu_a1d80576:

    # "But the room smelt of a strange, sweet aroma thanks to the plants they had strategically placed around the place in the hopes they might mask the other less savoury smells."
    "Mais la pièce dégageait une étrange et douce odeur grâce aux plantes qu'ils avaient stratégiquement placées un peu partout dans l'espoir de masquer d'autres odeurs moins agréables."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:76
translate fr qst_DamzelDizzt_2_sneaky_Menu_39d76dac:

    # "A half-naked girl danced on a makeshift bar they had erected."
    "Une fille à moitié nue dansait sur un bar improvisé qu'ils avaient installé."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:77
translate fr qst_DamzelDizzt_2_sneaky_Menu_2adaae47:

    # "She looked a little malnourished, and certainly didn’t want to be here, but if the black eye poorly concealed with makeup gave anything away, I doubt she had much choice in the matter."
    "Elle semblait un peu mal nourrie et ne voulait certainement pas être ici, mais si le cocard mal dissimulé sous du maquillage était un indice, je doute qu'elle ait eu vraiment le choix."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:78
translate fr qst_DamzelDizzt_2_sneaky_Menu_fdc03129:

    # "Some of the men played enthusiastically at a card game, the table at one point erupting into loud groans as one of them slammed his cards onto the table and rose up cheering with glee."
    "Certains hommes jouaient avec enthousiasme à un jeu de cartes, la table à un moment donné éclatant en de bruyants gémissements lorsque l'un d'eux abattit ses cartes sur la table et se leva en criant de joie."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:79
translate fr qst_DamzelDizzt_2_sneaky_Menu_cb358c83:

    # MC @ talk "Where is Tarek?"
    MC @ talk "Où est Tarek ?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:80
translate fr qst_DamzelDizzt_2_sneaky_Menu_3a782869:

    # "The guard who had let us pointed towards an iron door at the end of a corridor."
    "Le garde qui nous avait laissé entrer pointa vers une porte en fer au bout d'un couloir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:82
translate fr qst_DamzelDizzt_2_sneaky_Menu_28a6fd36:

    # THUG @ talk "Head down when you are ready, password is 'Silver'"
    THUG @ talk "Descendez quand vous êtes prêts, le mot de passe est 'Silver'"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:84
translate fr qst_DamzelDizzt_2_sneaky_Menu_71112cdf:

    # MC "(Before heading down, perhaps we could look around?)"
    MC "(Avant de descendre, nous pourrions peut-être jeter un coup d'œil ?)"

translate fr strings:

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:18
    old "Why is it called Amira’s Tears?"
    new "Pourquoi cela s'appelle-t-il Les Larmes d'Amira ?"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:34
    old "If we give Tarek a bottle with Amira's tears in, that should do the trick?"
    new "Si on donne à Tarek une bouteille contenant les larmes d'Amira, cela devrait faire l'affaire ?"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:51
    old "Let’s do it!"
    new "Allons-y !"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_1.rpy:88
    old "On a second thought..."
    new "Après réflexion..."

