translate fr qst_DamzelDizzt_3_headToOffice_2a800512:

    # "Knocking on the iron door, a slider opened as two piercing eyes looked the other side."
    "Je frappe à la porte de fer, un guichet s'ouvrit alors que deux yeux perçants regardaient de l'autre côté."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:4
translate fr qst_DamzelDizzt_3_headToOffice_6037568e:

    # THUG @ talk "Password?"
    THUG @ talk "Mot de passe ?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:7
translate fr qst_DamzelDizzt_3_headToOffice_4ba7c3dc:

    # "The slider closed, and I could hear the door unlock the other side before it swung open before us with the guard welcoming us in."
    "Le guichet se referma, et j'entendis la porte se déverrouiller de l'autre côté avant qu'elle ne s'ouvre devant nous, le garde nous accueillant."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:12
translate fr qst_DamzelDizzt_3_headToOffice_8ae48740:

    # THUG @ talk "What? No that isn't-"
    THUG @ talk "Quoi ? Non, ce n'est pas-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:13
translate fr qst_DamzelDizzt_3_headToOffice_9a11f6ca:

    # THUG @ talk "Gods! How does every moron keep forgetting the password?! It's one word!"
    THUG @ talk "Dieux ! Comment chaque imbécile peut-il continuer à oublier le mot de passe ?! C'est un seul mot !"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:14
translate fr qst_DamzelDizzt_3_headToOffice_ebbe29d7:

    # THUG @ talk "You know what? Just... Just go away, and when you come back, try again, okay?"
    THUG @ talk "Tu sais quoi ? Juste... Va-t'en, et quand tu reviendras, essaie encore, d'accord ?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:15
translate fr qst_DamzelDizzt_3_headToOffice_f84bcf96:

    # THUG @ talk "{i}*Mutters*{/i} Fucking idiots."
    THUG @ talk "{i}*Marmonne*{/i} Idiots de mes couilles."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:19
translate fr qst_DamzelDizzt_3_headToOffice_62c4f711:

    # THUG @ talk "...That wasn't even close!"
    THUG @ talk "...Ce n'était même pas proche !"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:20
translate fr qst_DamzelDizzt_3_headToOffice_cf303b3a:

    # THUG @ talk "Go away! Come back with the password before I run you through with my blade!"
    THUG @ talk "Va-t'en ! Reviens avec le mot de passe avant que je ne t'embroche avec ma lame !"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:25
translate fr qst_DamzelDizzt_3_enterOffice_bcd34196:

    # "Descending the stairs, we finally arrived into the small, unwelcoming office of Tarek, where he sat behind a small desk filed with gold and an ornate skull on it."
    "En descendant les escaliers, nous sommes finalement arrivés dans le petit bureau peu accueillant de Tarek, où il était assis derrière un petit bureau rempli d'or et un crâne orné posé dessus."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:36
translate fr qst_DamzelDizzt_3_enterOffice_59bd21c1:

    # "His eyes lit up and he grinned when he saw Nijah tailing behind us."
    "Ses yeux s'illuminèrent et il afficha un grand sourire en voyant Nijah nous suivre derrière."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:37
translate fr qst_DamzelDizzt_3_enterOffice_591a8bac:

    # TAREK "Nijah!"
    TAREK "Nijah !"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:38
translate fr qst_DamzelDizzt_3_enterOffice_7ffb5d3a:

    # TAREK "Iz so good to see you again!"
    TAREK "C'est si bon de te revoir !"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:39
translate fr qst_DamzelDizzt_3_enterOffice_3ba5cb1e:

    # NIJAH "... I cannot say zer same."
    NIJAH "... Je ne peux pas dire la même chose."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:40
translate fr qst_DamzelDizzt_3_enterOffice_d77e8429:

    # TAREK "As fiery as always."
    TAREK "Toujours aussi fougueuse."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:41
translate fr qst_DamzelDizzt_3_enterOffice_4836c9d3:

    # "Taking a moment to avert his gaze from her, his grin dropped as he sized up me and Markus."
    "Prenant un moment pour détourner son regard d'elle, son sourire s'effaça alors qu'il nous évaluait, Markus et moi."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:42
translate fr qst_DamzelDizzt_3_enterOffice_c9c2ccc4:

    # TAREK "Who are you two?"
    TAREK "Qui êtes-vous tous les deux ?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:43
translate fr qst_DamzelDizzt_3_enterOffice_1258fb49:

