translate fr strings:

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:4
    old "*Lie* We are working for the Inquisitors; we have been watching you for a while now."
    new "*Mensonge* Nous travaillons pour les Inquisiteurs ; nous vous surveillons depuis un certain temps maintenant."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:11
    old "I want you to leave Novaras."
    new "Je veux que vous quittiez Novaras."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:15
    old "{image=[ICON.HEART_BROKE]} We want gold in exchange for Nijah, we know you want her."
    new "{image=[ICON.HEART_BROKE]} Nous voulons de l'or en échange de Nijah, nous savons que vous la voulez."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:19
    old "{image=[ICON.SWORDS]} Are you ready for the sweet embrace of death?"
    new "{image=[ICON.SWORDS]} Êtes-vous prêt pour la douce étreinte de la mort ?"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:26
    old "The uniform tends to draw too attention for more... {i}delicate{/i} matters such as this."
    new "L'uniforme a tendance à attirer trop d'attention pour des affaires plus... {i}délicates{/i} comme celle-ci."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:33
    old "Fuck it, all this talking is starting to bore me. I'd much rather just fucking eviscerate you."
    new "Merde, toutes ces discussions commencent à m'ennuyer. Je préférerais largement t'éviscérer, putain."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:37
    old "How about I shove my boot down your throat? If we choose not to wear our uniforms we do so for good reason worm!"
    new "Et si je te fourrais ma botte dans la gorge ? Si nous choisissons de ne pas porter nos uniformes, c'est pour une bonne raison, vermine !"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:54
    old "I am telling you the truth!"
    new "Je te dis la vérité !"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:59
    old "Put your blade away fool, we're your only way out of this mess!"
