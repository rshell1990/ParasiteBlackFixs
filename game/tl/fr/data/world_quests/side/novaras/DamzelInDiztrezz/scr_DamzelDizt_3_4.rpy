translate fr qst_DamzelDizzt_3_talkTarek_successCharm_8ddf6569:

    # "Tarek stared at us uncertainly, guaging our delay and reaction."
    "Tarek nous fixait avec incertitude, évaluant notre hésitation et notre réaction."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:122
translate fr qst_DamzelDizzt_3_talkTarek_successCharm_51d7ad26:

