    # NIJAH "It was like metal... But stronger.."
    NIJAH "C'était comme du métal... Mais plus résistant..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:21
translate fr qst_DamzelDizzt_2_afterAction_653ed8d3:

    # "I reached out to gently grab her hand, snapping her out of what ever trance she had put herself in."
    "J'ai tendu la main pour lui prendre doucement la main, la sortant de la transe dans laquelle elle s'était plongée."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:22
translate fr qst_DamzelDizzt_2_afterAction_13b62009:

