translate fr qst_DaughterOfMetal_03_349f1271:

    # "As I turned to leave, Arlena called me back."
    "Alors que je me tournais pour partir, Arlena m'a rappelé."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:14
translate fr qst_DaughterOfMetal_03_5664a04c:

