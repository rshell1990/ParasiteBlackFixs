# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:3
translate fr primer_girl_troubles_1_fc4cddb5:

    # MESSENGER "Wait! Hold up!"
    MESSENGER "Attends ! Arrête !"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:5
translate fr primer_girl_troubles_1_0ed1380f:

    # "Stopping in my tracks, I turned to face the young boy hurrying towards me."
    "M'arrêtant net, je me retournai pour faire face au jeune garçon qui se dépêchait vers moi."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:7
translate fr primer_girl_troubles_1_cc1bdfcf:

    # MC @ think "Can I help you?"
    MC @ think "Je peux t'aider ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:8
translate fr primer_girl_troubles_1_b9d4697a:

    # MESSENGER "Sister Divine requests your presence at the tower of Palam at once."
    MESSENGER "Sœur Divine demande votre présence à la tour de Palam immédiatement."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:9
translate fr primer_girl_troubles_1_ff0934a5:

    # MC @ talk "Sister Divine?"
    MC @ talk "Sœur Divine ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:10
translate fr primer_girl_troubles_1_bef6b9ee:

    # MC @ talk "Did you say why?"
    MC @ talk "A-t-elle dit pourquoi ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:11
translate fr primer_girl_troubles_1_4755a9a3:

    # MESSENGER "No sir, but she said it was a matter most urgent."
    MESSENGER "Non monsieur, mais elle a dit que c'était d'une urgence extrême."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:12
translate fr primer_girl_troubles_1_2e49f35d:

    # MESSENGER "Now, if you'll excuse me, I've got to deliver my next message!"
    MESSENGER "Maintenant, si vous voulez bien m'excuser, je dois livrer mon prochain message !"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:16
translate fr primer_girl_troubles_1_bd996885:

    # MC "(Hmm... I should stop by the tower of Palam when I get a chance.)"
    MC "(Hmm... Je devrais passer à la tour de Palam quand j'en aurai l'occasion.)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:26
translate fr primer_girl_troubles_2_4fb8f212:

    # DIVINE @ talk "Ah, there you are."
    DIVINE @ talk "Ah, vous voilà."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:27
translate fr primer_girl_troubles_2_bd6dbff0:

    # "Divine steps out from behind her desk, a playful glint in her eye as she moves closer."
    "Divine sort de derrière son bureau, une lueur espiègle dans les yeux en s'approchant."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:32
translate fr primer_girl_troubles_2_4630b090:

    # "Without a word, she wraps her arms around me, her lips finding mine in a slow, deliberate kiss."
    "Sans un mot, elle m'enlace, ses lèvres trouvant les miennes dans un baiser lent et délibéré."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:33
translate fr primer_girl_troubles_2_dd678d35:

    # MC "(Her touch is familiar, warm...)"
    MC "(Son toucher est familier, chaud...)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:34
translate fr primer_girl_troubles_2_01941bc7:

    # "My hand drifts down instinctively, fingers grazing her waist before resting on her backside."
    "Ma main descend instinctivement, mes doigts effleurant sa taille avant de se poser sur ses fesses."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:35
translate fr primer_girl_troubles_2_e70ed2d3:

    # DIVINE @ happy "Mmm... You never change, do you?"
    DIVINE @ happy "Mmm... Tu ne changes jamais, pas vrai ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:36
translate fr primer_girl_troubles_2_964d7d25:

    # "She lets out a soft, breathy laugh, before gently pushing away, cheeks flushed."
    "Elle laisse échapper un petit rire haletant, avant de s'éloigner doucement, les joues rougissantes."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:41
translate fr primer_girl_troubles_2_db756b90:

    # MC @ smile "That's quite a desk you’ve got there, you know. I'd love to see you—"
    MC @ smile "Tu as un sacré bureau, tu sais. J'aimerais te voir—"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:42
translate fr primer_girl_troubles_2_ef0995eb:

    # DIVINE @ laugh "Easy, easy! I didn’t call you here for {i}that.{/i}"
    DIVINE @ laugh "Doucement, doucement ! Je ne t'ai pas fait venir pour {i}ça{/i}."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:43
translate fr primer_girl_troubles_2_a93764bb:

    # DIVINE @ happy "Though, maybe later... if there's time."
    DIVINE @ happy "Quoique, peut-être plus tard... si on a le temps."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:45
translate fr primer_girl_troubles_2_dde96000:

    # "Sister Divine stands behind her desk, her expression unreadable as she watches me enter."
    "Sœur Divine se tient derrière son bureau, son expression indéchiffrable alors qu'elle me regarde entrer."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:46
translate fr primer_girl_troubles_2_b9dbb770:

    # DIVINE @ talk "It’s good to see you again. I’ve been meaning to speak with you."
    DIVINE @ talk "Content de te revoir. Je voulais justement te parler."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:48
translate fr primer_girl_troubles_2_559540db:

    # MC @ talk "So, what's this about?"
    MC @ talk "Alors, de quoi s'agit-il ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:49
translate fr primer_girl_troubles_2_1eea1aea:

    # DIVINE @ talk "Tell me, what do you know about the tower?"
    DIVINE @ talk "Dis-moi, que sais-tu de la tour ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:50
translate fr primer_girl_troubles_2_399a0353:

    # MC @ think "Hm? Not much..."
    MC @ think "Hm ? Pas grand-chose..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:51
translate fr primer_girl_troubles_2_63c38e46:

    # MC @ talk "I know mages of Palam are taken from their parents from a young age to join the order."
    MC @ talk "Je sais que les mages de Palam sont retirés à leurs parents dès le plus jeune âge pour rejoindre l'ordre."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:52
translate fr primer_girl_troubles_2_51c5a5cf:

    # DIVINE @ talk "Being a mage is a lifelong commitment, and many start young at one of the smaller holds before coming here."
    DIVINE @ talk "Être mage est un engagement à vie, et beaucoup commencent jeunes dans l'une des petites forteresses avant de venir ici."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:53
translate fr primer_girl_troubles_2_a09d053a:

    # DIVINE @ talk "It's best to think of this tower as a kind of university, but to mages, any hold under their magecraft is considered a second home they're expected to return to throughout their life periodically."
    DIVINE @ talk "Il vaut mieux considérer cette tour comme une sorte d'université, mais pour les mages, toute forteresse placée sous leur magie est considérée comme une seconde maison où ils sont censés revenir périodiquement tout au long de leur vie."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:54
translate fr primer_girl_troubles_2_eec6e3a7:

    # DIVINE @ talk "Suffice it to say I care for each and every girl who comes here, many of whom I've known to some degree since they were small."
    DIVINE @ talk "Il suffit de dire que je tiens à chacune des filles qui viennent ici, beaucoup d'entre elles que j'ai connues dans une certaine mesure depuis qu'elles étaient petites."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:55
translate fr primer_girl_troubles_2_df064ee4:

    # MC @ talk "I see... But why the urgent summoning? Where do I fit into all this?"
    MC @ talk "Je vois... Mais pourquoi cette convocation urgente ? Quelle est ma place dans tout ça ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:56
translate fr primer_girl_troubles_2_a9467911:

    # DIVINE @ talk "Since this war began, Mages have been, with the end of every terminus ceremony, sent towards the front."
    DIVINE @ talk "Depuis que cette guerre a commencé, les mages ont été, à la fin de chaque cérémonie terminus, envoyés au front."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:57
translate fr primer_girl_troubles_2_af61e39a:

    # DIVINE @ talk "Thankfully, many of my girls are usually kept back to help deal with the wounded, so losses are limited."
    DIVINE @ talk "Heureusement, beaucoup de mes filles sont généralement gardées en arrière pour aider à soigner les blessés, donc les pertes sont limitées."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:58
translate fr primer_girl_troubles_2_a8a38eea:

    # DIVINE @ talk "With that said, Alcott's government continues to put more and more pressure on getting out the door, regardless of capabilities."
    DIVINE @ talk "Cela dit, le gouvernement d'Alcott continue de mettre de plus en plus de pression pour partir sur le terrain, quelles que soient les capacités."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:59
translate fr primer_girl_troubles_2_8241cd14:

    # "Sister Divine paused uncomfortably."
    "Sœur Divine fit une pause, mal à l'aise."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:60
translate fr primer_girl_troubles_2_836dcfe9:

    # DIVINE @ talk "... Last month, four of my girls stationed at a camp were killed by a surprise ambush."
    DIVINE @ talk "... Le mois dernier, quatre de mes filles stationnées dans un camp ont été tuées lors d'une embuscade surprise."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:61
translate fr primer_girl_troubles_2_eae6fb6b:

    # DIVINE @ talk "From what reports I have, the girls panicked and fumbled their spells."
    DIVINE @ talk "D'après les rapports que j'ai, les filles ont paniqué et ont raté leurs sorts."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:62
translate fr primer_girl_troubles_2_1cd0a9e5:

    # DIVINE @ sad "... They weren't ready."
    DIVINE @ sad "... Elles n'étaient pas prêtes."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:63
translate fr primer_girl_troubles_2_c3780307:

    # MC @ sad "That's horrible."
    MC @ sad "C'est horrible."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:64
translate fr primer_girl_troubles_2_ead16311:

    # DIVINE @ angry "Standards are slipping..."
    DIVINE @ angry "Les normes se dégradent..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:65
translate fr primer_girl_troubles_2_3eeccae0:

    # DIVINE @ sad "And my girls are dying for it."
    DIVINE @ sad "Et mes filles en meurent."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:68
translate fr primer_girl_troubles_2_menu_685b6d3d:

    # DIVINE @ talk "I've tried."
    DIVINE @ talk "J'ai essayé."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:69
translate fr primer_girl_troubles_2_menu_3a9ef15e:

    # DIVINE @ talk "The officials don't care for the quality of Mages, only that there {i}are{/i} Mages."
    DIVINE @ talk "Les officiels ne se soucient pas de la qualité des Mages, seulement qu'il y en {i}ait{/i}."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:70
translate fr primer_girl_troubles_2_menu_9c138b9c:

    # DIVINE @ talk "My concerns fall on deaf ears."
    DIVINE @ talk "Mes inquiétudes tombent dans l'oreille d'un sourd."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:73
translate fr primer_girl_troubles_2_menu_75a8f7bf:

    # DIVINE @ angry "I am aware people 'die' in war; I'm not a fool."
    DIVINE @ angry "Je sais que des gens 'meurent' à la guerre ; je ne suis pas idiot."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:74
translate fr primer_girl_troubles_2_menu_16b704db:

    # DIVINE @ talk "But there are only ever so many mages per year, and magecraft is a lifelong commitment to master."
    DIVINE @ talk "Mais il n'y a jamais qu'un nombre limité de mages par an, et la maîtrise de l'art de la magie demande un engagement à vie."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:75
translate fr primer_girl_troubles_2_menu_6917f041:

    # DIVINE @ talk "It's not as simple as replacing a simple grunt... No offense."
    DIVINE @ talk "Ce n'est pas aussi simple que de remplacer un simple soldat... Sans vouloir vous offenser."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:76
translate fr primer_girl_troubles_2_menu_c8f104a8:

    # MC @ talk "None taken."
    MC @ talk "Il n'y a pas de mal."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:79
translate fr primer_girl_troubles_2_menu_b528cbb1:

    # DIVINE @ talk "Three girls of mine, troublesome issues with each."
    DIVINE @ talk "Trois de mes filles, des problèmes épineux avec chacune."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:80
translate fr primer_girl_troubles_2_menu_5be2fe8f:

    # DIVINE @ talk "I've put my foot down and held them back from being assigned to the front."
    DIVINE @ talk "J'ai mis le holà et les ai empêchées d'être affectées au front."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:81
translate fr primer_girl_troubles_2_menu_ac431a22:

    # MC @ talk "Why?"
    MC @ talk "Pourquoi ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:82
translate fr primer_girl_troubles_2_menu_e02e14c6:

    # DIVINE @ talk "They're not ready... And I'm not prepared to knowingly send some of my girls to their deaths."
    DIVINE @ talk "Elles ne sont pas prêtes... Et je ne suis pas disposé à envoyer sciemment certaines de mes filles à la mort."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:83
translate fr primer_girl_troubles_2_menu_cd04b852:

    # DIVINE @ talk "Now, I don't have time to resolve these issues myself; I have to prepare the next batch of mages, who are already showing similar issues, for next year's terminus ceremony."
    DIVINE @ talk "Maintenant, je n'ai pas le temps de résoudre ces problèmes moi-même ; je dois préparer la prochaine fournée de mages, qui montrent déjà des problèmes similaires, pour la cérémonie de terminus de l'année prochaine."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:84
translate fr primer_girl_troubles_2_menu_97eba329:

    # DIVINE @ talk "I want you to become their... Mentor."
    DIVINE @ talk "Je veux que tu deviennes leur... Mentor."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:85
translate fr primer_girl_troubles_2_menu_592cb8fe:

    # MC @ surprised "Mentor? Me? I don't even possess any magecraft!"
    MC @ surprised "Mentor ? Moi ? Je ne possède même pas la moindre sorcellerie !"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:86
translate fr primer_girl_troubles_2_menu_f412c6a1:

    # DIVINE @ talk "Ah, but that's where you and your 'gift' come in nicely."
    DIVINE @ talk "Ah, mais c'est là que toi et ton 'don' intervenez à merveille."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:87
translate fr primer_girl_troubles_2_menu_70c53a8b:

    # DIVINE @ talk "The Alderian government have refused to send me a mage capable of helping me, so I need the next best thing."
    DIVINE @ talk "Le gouvernement alderien a refusé de m'envoyer un mage capable de m'aider, alors j'ai besoin de la meilleure alternative."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:88
translate fr primer_girl_troubles_2_menu_560ed043:

    # DIVINE @ talk "Someone capable of really motivating these girls."
    DIVINE @ talk "Quelqu'un capable de vraiment motiver ces filles."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:89
translate fr primer_girl_troubles_2_menu_0d85e87a:

    # MC "(Meaning someone she can threaten to blackmail if I ever speak about what I see in here.)"
    MC "(C'est-à-dire quelqu'un qu'elle peut menacer de faire chanter si jamais je parle de ce que je vois ici.)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:90
translate fr primer_girl_troubles_2_menu_59433de1:

    # MC @ talk "How am I supposed to do that?"
    MC @ talk "Comment suis-je censé faire ça ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:91
translate fr primer_girl_troubles_2_menu_de2af97e:

    # DIVINE @ talk "The method doesn't concern me; as long as the girls aren't harmed, I don't care what you do. "
    DIVINE @ talk "La méthode ne me concerne pas ; tant que les filles ne sont pas blessées, je me fiche de ce que tu fais."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:92
translate fr primer_girl_troubles_2_menu_7d5dfde8:

    # DIVINE @ talk "For each girl dealt with, I'll give you seven hundred coins. Does that sound fair?"
    DIVINE @ talk "Pour chaque fille réglée, je te donnerai sept cents pièces. Est-ce que cela te semble équitable ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:95
translate fr primer_girl_troubles_2_menu_2_270e239c:

    # DIVINE @ talk "Because I need someone I can trust with this,"
    DIVINE @ talk "Parce que j'ai besoin de quelqu'un en qui je puisse avoir confiance pour cela,"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:96
translate fr primer_girl_troubles_2_menu_2_bf1e2acc:

    # DIVINE @ talk "And after hearing from Captain Nyx about your recent help with her, it only made sense to ask you."
    DIVINE @ talk "Et après avoir entendu le capitaine Nyx parler de l'aide que vous lui avez récemment apportée, il était logique de vous le demander."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:97
translate fr primer_girl_troubles_2_menu_2_beee84fb:

    # MC @ talk "Wait ... Captain Nyx?"
    MC @ talk "Attendez ... le capitaine Nyx ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:98
translate fr primer_girl_troubles_2_menu_2_2010828e:

    # DIVINE @ talk "The Captain and I are ... {i}often aligned{/i} when necessary."
    DIVINE @ talk "Le capitaine et moi sommes ... {i}souvent en phase{/i} lorsque cela est nécessaire."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:99
translate fr primer_girl_troubles_2_menu_2_308a2582:

    # DIVINE @ talk "I'd hardly call us friends, but we've come to depend on each other's resources sometimes."
    DIVINE @ talk "Je ne dirais pas que nous sommes amis, mais nous en sommes venus à dépendre parfois des ressources de l'autre."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:102
translate fr primer_girl_troubles_2_menu_2_c7d4f56a:

    # DIVINE @ talk "I mean, {i}I don't care what you do.{/i}"
    DIVINE @ talk "Je veux dire, {i}je me fiche de ce que vous faites.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:103
translate fr primer_girl_troubles_2_menu_2_8cc9e6dd:

    # DIVINE @ talk "As long as they are not hurt, and you don't make a public spectacle of whatever you do with them, I only care about the end results."
    DIVINE @ talk "Tant qu'ils ne sont pas blessés, et que vous ne faites pas de spectacle public de quoi que ce soit que vous faites avec eux, seul le résultat final m'importe."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:106
translate fr primer_girl_troubles_2_menu_2_960647d4:

    # DIVINE @ talk "I cannot tell you until you agree to my request, but I will do my best to answer anymore questions you have."
    DIVINE @ talk "Je ne peux pas vous le dire tant que vous n'acceptez pas ma requête, mais je ferai de mon mieux pour répondre à toutes les autres questions que vous avez."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:109
translate fr primer_girl_troubles_2_menu_3_7d9b1b5b:

    # MC @ talk "Mages of Palam are holy ordained, after all."
    MC @ talk "Les mages de Palam sont ordonnés saints, après tout."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:110
translate fr primer_girl_troubles_2_menu_3_dfe1bc33:

    # DIVINE @ angry "It is shameful when you're praying for a strong male heir or a daughter that you can marry off to another rich noble."
    DIVINE @ angry "Il est honteux de prier pour un héritier mâle fort ou une fille que vous pouvez marier à un autre riche noble."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:111
translate fr primer_girl_troubles_2_menu_3_a6aa2eef:

    # DIVINE @ talk "Us Mages of Palam are seen as a dead end."
    DIVINE @ talk "Nous, les Mages de Palam, sommes vus comme une impasse."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:112
translate fr primer_girl_troubles_2_menu_3_5492d872:

    # MC @ talk "But can't Mages of Palam continue a bloodline?"
    MC @ talk "Mais les Mages de Palam ne peuvent-ils pas perpétuer une lignée ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:113
translate fr primer_girl_troubles_2_menu_3_778e69e4:

    # MC @ talk "You can sire young with women and can get pregnant yourselves, can you not?"
    MC @ talk "Vous pouvez engendrer des enfants avec des femmes et tomber enceintes vous-mêmes, n'est-ce pas ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:114
translate fr primer_girl_troubles_2_menu_3_df70b7f3:

    # MC @ think "How then are you a dead end?"
    MC @ think "Comment alors êtes-vous une impasse ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:115
translate fr primer_girl_troubles_2_menu_3_d60e62c4:

    # "Sister Divine smiled."
    "Sœur Divine sourit."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:116
translate fr primer_girl_troubles_2_menu_3_b412a3ab:

    # DIVINE @ happy "It's best not to dwell on such things; we're an uncomfortable blot they've had to learn to accept and tolerate {i}on their terms.{/i}"
    DIVINE @ happy "Il vaut mieux ne pas s'attarder sur de telles choses ; nous sommes une tache inconfortable qu'ils ont dû apprendre à accepter et à tolérer {i}selon leurs conditions.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:117
translate fr primer_girl_troubles_2_menu_3_7a2d28cb:

    # DIVINE @ talk "They prefer the fantasy of us as saint like beings, not real people with real wants and desires."
    DIVINE @ talk "Ils préfèrent le fantasme que nous soyons des êtres saints, pas de vraies personnes avec de vrais désirs et envies."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:120
translate fr primer_girl_troubles_2_menu_3_6d652bd9:

    # DIVINE @ talk "Yes, to which I expect you to speak to no one."
    DIVINE @ talk "Oui, et j'attends de vous que vous n'en parliez à personne."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:121
translate fr primer_girl_troubles_2_menu_3_198ed38b:

    # DIVINE @ talk "I cannot stress how important these families expect privacy."
    DIVINE @ talk "Je ne saurais trop insister sur l'importance que ces familles accordent à la confidentialité."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:122
translate fr primer_girl_troubles_2_menu_3_1cf3949f:

    # DIVINE @ talk "If they believe we're making a spectacle, those {i}generous donations{/i} will very quickly dry up."
    DIVINE @ talk "S'ils croient que nous nous donnons en spectacle, ces {i}généreuses donations{/i} se tariront très rapidement."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:125
translate fr primer_girl_troubles_2_menu_3_186c3225:

    # DIVINE @ happy "Good, it pleases me to hear that."
    DIVINE @ happy "Bien, cela me fait plaisir de l'entendre."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:126
translate fr primer_girl_troubles_2_menu_3_c4dc71ec:

    # MC @ talk "So what now?"
    MC @ talk "Et maintenant ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:127
translate fr primer_girl_troubles_2_menu_3_1f4f778f:

    # DIVINE @ talk "Now you've agreed, I can talk more about the girls in question."
    DIVINE @ talk "Maintenant que tu es d'accord, je peux en dire plus sur les filles en question."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:128
translate fr primer_girl_troubles_2_menu_3_edbe2a65:

    # DIVINE @ talk "There's Jana, Zara and Mika."
    DIVINE @ talk "Il y a Jana, Zara et Mika."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:129
translate fr primer_girl_troubles_2_menu_3_a7336069:

    # DIVINE @ talk "Which one do you want to know about?"
    DIVINE @ talk "De laquelle veux-tu en savoir plus ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:133
translate fr primer_girl_troubles_2_menu_4_c8c3f0f1:

    # DIVINE @ talk "Ah, Jana Rosenval..."
    DIVINE @ talk "Ah, Jana Rosenval..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:134
translate fr primer_girl_troubles_2_menu_4_c2684d19:

    # DIVINE @ talk "Her abilities are extremely promising, and she is one of the highest potential candidates I've seen in years."
    DIVINE @ talk "Ses capacités sont extrêmement prometteuses, et c'est l'une des candidates au plus fort potentiel que j'aie vues depuis des années."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:135
translate fr primer_girl_troubles_2_menu_4_53984bd0:

    # MC @ talk "Then what's the issue?"
    MC @ talk "Alors, quel est le problème ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:136
translate fr primer_girl_troubles_2_menu_4_6461bc7c:

    # DIVINE @ angry "Her attitude."
    DIVINE @ angry "Son attitude."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:137
translate fr primer_girl_troubles_2_menu_4_0751d562:

    # DIVINE @ angry "She's been consistently troublesome for as long as I've known her, but the situation this last year has spiraled completely out of hand."
    DIVINE @ angry "Elle a toujours été source d'ennuis depuis que je la connais, mais la situation a complètement dérapé cette dernière année."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:138
translate fr primer_girl_troubles_2_menu_4_587a4d08:

    # MC @ talk "How {i}'out of hand?'{/i}"
    MC @ talk "Comment {i}‘ça a dérapé ?’{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:139
translate fr primer_girl_troubles_2_menu_4_d7b30e0f:

    # DIVINE @ talk "Setting a lecture hall on fire, sneaking out and being caught dancing topless at a tavern, constantly getting it brawls with the other girls... The list goes on."
    DIVINE @ talk "Mettre le feu à un amphithéâtre, s’éclipser et se faire surprendre en train de danser seins nus dans une taverne, se bagarrer sans cesse avec les autres filles... La liste est longue."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:140
translate fr primer_girl_troubles_2_menu_4_4890c460:

    # MC @ talk "Any idea what's causing the trouble?"
    MC @ talk "Une idée de ce qui cause ces problèmes ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:141
translate fr primer_girl_troubles_2_menu_4_3d603c8c:

    # DIVINE @ talk "She does come from a particularly {i}'troubled'{/i} home, and it's always been a difficult subject for her to talk about."
    DIVINE @ talk "Elle vient effectivement d’un foyer particulièrement {i}‘perturbé’{/i}, et cela a toujours été un sujet difficile à aborder pour elle."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:142
translate fr primer_girl_troubles_2_menu_4_fe36ef6d:

    # MC @ talk "How troubled?"
    MC @ talk "À quel point perturbé ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:143
translate fr primer_girl_troubles_2_menu_4_08cdecc7:

    # DIVINE @ talk "There were signs of physical abuse, but she's never been willing to talk about it."
    DIVINE @ talk "Il y avait des signes de maltraitance physique, mais elle n’a jamais voulu en parler."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:144
translate fr primer_girl_troubles_2_menu_4_d0271e56:

    # DIVINE @ talk "I need you to help curb her personality issues and deal with whatever's going on in her head."
    DIVINE @ talk "J’ai besoin que vous l’aidiez à atténuer ses problèmes de personnalité et à gérer ce qui se passe dans sa tête."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:149
translate fr primer_girl_troubles_2_menu_4_5087813e:

    # DIVINE @ talk "Hm, yes, Zara Dawnmoore."
    DIVINE @ talk "Hmm, oui, Zara Dawnmoore."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:150
translate fr primer_girl_troubles_2_menu_4_15776ea7:

    # DIVINE @ talk "She comes from a wealthy aristocratic family from the south before the war forced them to flee North."
    DIVINE @ talk "Elle vient d’une riche famille aristocratique du sud avant que la guerre ne les force à fuir vers le nord."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:151
translate fr primer_girl_troubles_2_menu_4_f90c3862:

    # DIVINE @ talk "She was a perfect student during her time here, consistently scoring highest on her arcane knowledge and abilities."
    DIVINE @ talk "Elle a été une élève parfaite durant son séjour ici, obtenant constamment les meilleurs résultats en connaissances et capacités arcaniques."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:152
translate fr primer_girl_troubles_2_menu_4_8e5d193b:

    # DIVINE @ talk "Then, during the terminus ceremony, the {i}'incident'{/i} occurred."
    DIVINE @ talk "Puis, pendant la cérémonie du terminus, {i}« l'incident »{/i} s'est produit."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:153
translate fr primer_girl_troubles_2_menu_4_caee25ea:

    # MC @ think "The 'incident?'"
    MC @ think "L'« incident » ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:154
translate fr primer_girl_troubles_2_menu_4_7a8a5198:

    # DIVINE @ talk "Before the ceremony, Zara was reported to be in high spirits, if a little tense and on edge."
    DIVINE @ talk "Avant la cérémonie, on disait que Zara était de bonne humeur, bien qu'un peu tendue et nerveuse."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:155
translate fr primer_girl_troubles_2_menu_4_601dc7e4:

    # DIVINE @ talk "But the same could be said of any of the mages at the time, so it was dismissed as the usual pre-ceremony anxiety."
    DIVINE @ talk "Mais on aurait pu en dire autant de n'importe quel mage à ce moment-là, alors cela a été mis sur le compte de l'anxiété habituelle d'avant cérémonie."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:156
translate fr primer_girl_troubles_2_menu_4_7d354705:

    # DIVINE @ talk "A short while after the ceremony, however, Zara received a letter from her parents, who couldn't attend."
    DIVINE @ talk "Cependant, peu après la cérémonie, Zara reçut une lettre de ses parents, qui n'avaient pas pu assister."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:157
translate fr primer_girl_troubles_2_menu_4_305b4b7a:

    # DIVINE @ talk "She burned the letter before anyone could read it, but whatever was in that letter triggered something within her."
    DIVINE @ talk "Elle brûla la lettre avant que quiconque puisse la lire, mais quoi qu'il y ait eu dans cette lettre, cela déclencha quelque chose en elle."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:158
translate fr primer_girl_troubles_2_menu_4_11d29735:

    # DIVINE @ talk "In the night, she went on a rampage, attacking everyone in sight."
    DIVINE @ talk "Dans la nuit, elle se déchaîna, attaquant tous ceux qu'elle voyait."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:159
translate fr primer_girl_troubles_2_menu_4_91d2d69a:

    # DIVINE @ talk "It took myself and two other high mages to restrain her abilities, and in the meanwhile, over a dozen students were hurt."
    DIVINE @ talk "Il fallut moi-même et deux autres hauts mages pour restreindre ses pouvoirs, et pendant ce temps, plus d'une douzaine d'étudiants furent blessés."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:160
translate fr primer_girl_troubles_2_menu_4_a4d6ed27:

    # DIVINE @ talk "We thought it might have been {i}'Mages madness,'{/i} but there was no sign of it."
    DIVINE @ talk "Nous avons pensé que cela aurait pu être {i}« la folie des mages »{/i}, mais il n'y en avait aucun signe."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:161
translate fr primer_girl_troubles_2_menu_4_cffae37d:

    # MC @ talk "What was in the letter?"
    MC @ talk "Qu'y avait-il dans cette lettre ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:162
translate fr primer_girl_troubles_2_menu_4_af9b8334:

    # DIVINE @ talk "We don't know, and Zara won't say."
    DIVINE @ talk "Nous ne savons pas, et Zara ne veut pas le dire."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:163
translate fr primer_girl_troubles_2_menu_4_b98ef904:

    # DIVINE @ talk "Now Zara is pretending she had some momentary lapse of judgment and is acting her usual self again."
    DIVINE @ talk "Maintenant, Zara fait semblant d'avoir eu un moment d'égarement et agit de nouveau comme d'habitude."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:164
translate fr primer_girl_troubles_2_menu_4_42755e18:

    # DIVINE @ talk "I'm not going to risk sending her out knowing she could explode at any moment."
    DIVINE @ talk "Je ne vais pas risquer de l'envoyer dehors en sachant qu'elle pourrait exploser à tout moment."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:165
translate fr primer_girl_troubles_2_menu_4_3b071047:

    # MC @ talk "I don't remember hearing about this incident anywhere?"
    MC @ talk "Je ne me souviens pas avoir entendu parler de cet incident quelque part ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:166
translate fr primer_girl_troubles_2_menu_4_9d1d538f:

    # DIVINE @ talk "That's because we've buried it and managed the incident in-house ... For now, at least."
    DIVINE @ talk "C'est parce que nous l'avons enterré et géré l'incident en interne... Pour l'instant, du moins."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:167
translate fr primer_girl_troubles_2_menu_4_c4225b75:

    # DIVINE @ talk "I need you to get to the bottom of this issue and deal with it ... fast."
    DIVINE @ talk "J'ai besoin que vous alliez au fond de cette affaire et que vous la régliez... rapidement."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:172
translate fr primer_girl_troubles_2_menu_4_1469252a:

    # DIVINE @ talk "Yes, Mika Ursan, a lovely girl."
    DIVINE @ talk "Oui, Mika Ursan, une fille adorable."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:173
translate fr primer_girl_troubles_2_menu_4_a993509d:

    # DIVINE @ talk "Afraid of her own shadow, but lovely."
    DIVINE @ talk "Peur de son ombre, mais adorable."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:174
translate fr primer_girl_troubles_2_menu_4_6e2f9ef2:

    # MC @ talk "{i}Afraid of her own shadow?{/i}"
    MC @ talk "{i}Peur de son ombre ?{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:175
translate fr primer_girl_troubles_2_menu_4_dd45cd20:

    # DIVINE @ laugh "I know, I know, but believe me—she panics at the sight of a sparring partner."
    DIVINE @ laugh "Je sais, je sais, mais croyez-moi, elle panique à la vue d'un partenaire d'entraînement."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:176
translate fr primer_girl_troubles_2_menu_4_c2e8c608:

    # DIVINE @ talk "Mika's an odd case; her family adore her and refused to hand her over till much, {i}much{/i} later than we usually take on mages."
    DIVINE @ talk "Mika est un cas particulier ; sa famille l'adore et a refusé de la livrer jusqu'à bien, {i}bien{/i} plus tard que nous n'acceptons habituellement les mages."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:177
translate fr primer_girl_troubles_2_menu_4_cf3cdd5f:

    # DIVINE @ talk "As such, she has a strong natural sense of her abilities despite displaying very average arcane knowledge."
    DIVINE @ talk "Par conséquent, elle a un sens naturel aigu de ses capacités, bien qu'elle fasse preuve d'une connaissance des arcanes très moyenne."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:178
translate fr primer_girl_troubles_2_menu_4_11d4c714:

    # MC @ talk "So, what's the issue?"
    MC @ talk "Alors, quel est le problème ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:179
translate fr primer_girl_troubles_2_menu_4_138e55c7:

    # DIVINE @ talk "{i}The girl is terrified of fighting...{/i}"
    DIVINE @ talk "{i}La fille est terrifiée par le combat...{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:180
translate fr primer_girl_troubles_2_menu_4_154fbaad:

    # DIVINE @ talk "She completely failed in any and all practical combat training classes previously."
    DIVINE @ talk "Elle a complètement échoué à tous ses précédents cours pratiques d'entraînement au combat."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:181
translate fr primer_girl_troubles_2_menu_4_bd85b2d5:

    # DIVINE @ talk "She just ... cowered."
    DIVINE @ talk "Elle s'est juste... recroquevillée."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:182
translate fr primer_girl_troubles_2_menu_4_9c43d061:

    # MC @ talk "Then how has she got this far?"
    MC @ talk "Alors comment est-elle arrivée jusqu'ici ?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:183
translate fr primer_girl_troubles_2_menu_4_5bcd82c2:

    # DIVINE @ talk "Because practical combat for mages of the Palam is the one thing you {i}can{/i} still fail at and still be allowed to serve in the rear as a healer."
    DIVINE @ talk "Parce que le combat pratique pour les mages du Palam est la seule chose à laquelle on {i}peut{/i} encore échouer tout en étant autorisé à servir à l'arrière comme guérisseur."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:184
translate fr primer_girl_troubles_2_menu_4_6272c3d1:

    # DIVINE @ angry "Suffice it to say this push to get mages to the front in quantity rather than quality has been a great source of tension between the council of Mages and the Alderian government."
    DIVINE @ angry "Il suffit de dire que cette volonté d'envoyer les mages au front en quantité plutôt qu'en qualité a été une grande source de tension entre le conseil des Mages et le gouvernement aldérien."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:185
translate fr primer_girl_troubles_2_menu_4_86ac58e5:

    # DIVINE @ talk "Now, whilst combat isn't the priority for a mage of Palam, {i}I firmly believe every mage must be able to defend herself in times of crisis.{/i}"
    DIVINE @ talk "Or, bien que le combat ne soit pas la priorité pour un mage du Palam, {i}je crois fermement que chaque mage doit être capable de se défendre en temps de crise.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:186
translate fr primer_girl_troubles_2_menu_4_99e3957b:

    # "Sister Divine's face fell darkly."
    "Sister Divine's face fell darkly."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:187
translate fr primer_girl_troubles_2_menu_4_a90549ec:

    # DIVINE @ sad "If the recent deaths are anything to go by ... I've only been proven right."
    DIVINE @ sad "If the recent deaths are anything to go by ... I've only been proven right."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:188
translate fr primer_girl_troubles_2_menu_4_8ab36be3:

    # MC @ think "So, you want me to train the girl to fight?"
    MC @ think "So, you want me to train the girl to fight?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:189
translate fr primer_girl_troubles_2_menu_4_bd65f2f7:

    # DIVINE @ talk "I need you to teach her to conquer her fears."
    DIVINE @ talk "I need you to teach her to conquer her fears."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:190
translate fr primer_girl_troubles_2_menu_4_d6ca7303:

    # DIVINE @ talk "She {i}has{/i} to be able to fight if the time comes."
    DIVINE @ talk "She {i}has{/i} to be able to fight if the time comes."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:191
translate fr primer_girl_troubles_2_menu_4_3a9c4c09:

    # MC @ talk "And if she refuses to listen? She's an adult now; she doesn't have to listen to either of us."
    MC @ talk "And if she refuses to listen? She's an adult now; she doesn't have to listen to either of us."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:192
translate fr primer_girl_troubles_2_menu_4_88df11d8:

    # DIVINE @ talk "I don't care {i}how{/i} you get her to agree, but I need to know she can handle herself out there."
    DIVINE @ talk "I don't care {i}how{/i} you get her to agree, but I need to know she can handle herself out there."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:199
translate fr primer_girl_troubles_2_menu_4_89c9874e:

    # DIVINE @ talk "Now then, should I introduce you to the girls?"
    DIVINE @ talk "Now then, should I introduce you to the girls?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:202
translate fr primer_girl_troubles_2_menu_5_ecf2e41a:

    # DIVINE @ talk "Alright, which one?"
    DIVINE @ talk "Alright, which one?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:208
translate fr primer_girl_troubles_2_menu_5_190030f6:

    # DIVINE @ talk "Alright, come with me, I shall introduce you."
    DIVINE @ talk "Alright, come with me, I shall introduce you."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:213
translate fr primer_girl_troubles_2_menu_5_29b7d599:

    # DIVINE @ talk "Return as soon as you can ... I want this trouble behind me sooner rather than later."
    DIVINE @ talk "Reviens dès que possible ... Je veux en finir avec ce problème le plus tôt possible."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:218
translate fr primer_girl_troubles_2_menu_5_1c582cf8:

    # DIVINE @ talk "Of course, but please, give me your answer soon ... Time is a luxury we don't have."
    DIVINE @ talk "Bien sûr, mais s'il te plaît, donne-moi ta réponse bientôt ... Le temps est un luxe que nous n'avons pas."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:236
translate fr primer_girl_troubles_2_menu_5_aa4cc931:

    # "A short journey later to the girl's dorm..."
    "Un court trajet plus tard jusqu'au dortoir des filles..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:237
translate fr primer_girl_troubles_2_menu_5_edf5f908:

    # "Upon entering the girls' dorm, the immediate warmth of the room hit me from the warm blazing fire."
    "En entrant dans le dortoir des filles, la chaleur immédiate de la pièce m'a frappé, provenant du feu crépitant."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:238
translate fr primer_girl_troubles_2_menu_5_81e60903:

    # "We all knew mages had it easy compared to the rest of us, even young apprentices, but this was leaps and bounds ahead of my experiences."
    "Nous savions tous que les mages avaient la vie facile comparé à nous, même les jeunes apprentis, mais cela dépassait de loin mes propres expériences."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:239
translate fr primer_girl_troubles_2_menu_5_7883e851:

    # DIVINE @ happy "Girls! Come!"
    DIVINE @ happy "Les filles ! Venez !"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:243
translate fr primer_girl_troubles_2_menu_5_40b40c14:

