# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:4
translate fr palam_sewer_2a5939df:

    # "Following Sister Divine, we headed down into the bowels of the tower."
    "Suivant Sœur Divine, nous sommes descendus dans les entrailles de la tour."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:5
translate fr palam_sewer_cad52b41:

    # "Every so often, as we descended the long, winding and increasingly dark staircases lit only by flickering torchlight, we’d hear a loud thump followed by the vibrating of the tower."
    "De temps en temps, alors que nous descendions les longs escaliers sinueux et de plus en plus sombres, éclairés seulement par la lueur vacillante des torches, nous entendions un bruit sourd suivi des vibrations de la tour."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:10
translate fr palam_sewer_f7814228:

    # MC @ talk "What was that?"
    MC @ talk "Qu’est-ce que c’était ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:11
translate fr palam_sewer_9d82aa79:

    # DIVINE "I know not... It only began after we closed off the Sub-Basement following the incident."
    DIVINE "Je ne sais pas... Cela n’a commencé qu’après avoir fermé le sous-sol suite à l’incident."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:12
translate fr palam_sewer_8ef5b3e2:

    # MC @ talk "... Hmm."
    MC @ talk "... Hum."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:13
translate fr palam_sewer_d0d77fa0:

    # "At the bottom level of the dark and dreary tower, I was led towards a vault like oval door, sealed by a glowing blue aura that pulsated and acted as a barrier to keep whatever was on the other side trapped."
    "Au niveau le plus bas de la tour sombre et lugubre, on me conduisit vers une porte ovale en forme de voûte, scellée par une aura bleue lumineuse qui pulsait et servait de barrière pour emprisonner tout ce qui se trouvait de l’autre côté."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:14
translate fr palam_sewer_c433ed2a:

    # "Lightly touching its surface with my finger, I felt a zap of pain course through me."
    "En touchant légèrement sa surface du bout du doigt, je ressentis une décharge de douleur me traverser."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:15
translate fr palam_sewer_dac17ae4:

    # MC @ surprised "Ah!"
    MC @ surprised "Ah !"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:16
translate fr palam_sewer_6066cd54:

    # DIVINE "This is the best we could do in the meanwhile."
    DIVINE "C’est le mieux que nous puissions faire en attendant."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:17
translate fr palam_sewer_477e7002:

    # DIVINE "We heard a few screams from those still trapped inside but... we haven’t heard any for a while now."
    DIVINE "Nous avons entendu quelques cris de ceux encore piégés à l’intérieur mais... nous n’en avons plus entendu depuis un moment maintenant."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:18
translate fr palam_sewer_44f83648:

    # "With a swipe of her hand, the glowing blue began to dissipate, and the opening into the darkness was now clear."
    "D'un geste de la main, la lueur bleue commença à se dissiper, et l'ouverture vers les ténèbres devint claire."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:19
translate fr palam_sewer_8c222c78:

    # DIVINE "Be careful in there..."
    DIVINE "Sois prudent là-dedans..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:20
translate fr palam_sewer_2678af05:

    # MC @ talk "Is there no one to assist me?"
    MC @ talk "N'y a-t-il personne pour m'assister ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:21
translate fr palam_sewer_6a99a3f3:

    # DIVINE "I cannot risk any more of our own."
    DIVINE "Je ne peux pas risquer d'autres des nôtres."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:22
translate fr palam_sewer_439ea3b0:

    # DIVINE "Good luck to you."
    DIVINE "Bonne chance à toi."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:24
translate fr palam_sewer_86213208:

    # MC @ talk "{i}*Sigh*{/i} Here goes nothing..."
    MC @ talk "{i}*Soupir*{/i} C'est parti..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:27
translate fr palam_sewer_de061c7f:

    # "Stepping into the vault, the blue shield once again rose from behind, trapping me inside the dark forsaken caverns of the Palam Tower."
    "En pénétrant dans le caveau, le bouclier bleu s'éleva de nouveau derrière moi, me piégeant dans les sombres cavernes abandonnées de la Tour Palam."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:28
translate fr palam_sewer_d3a550c9:

    # MC "Why did I agree to this? This was a terrible idea."
    MC "Pourquoi ai-je accepté cela ? C'était une très mauvaise idée."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:29
translate fr palam_sewer_6f415419:

    # MC "Alright... I guess I better head further inside and then change when I’m out of sight of Divine."
    MC "D'accord... Je suppose que je ferais mieux de m'enfoncer plus loin et de me changer quand je ne serai plus en vue de Divine."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:30
translate fr palam_sewer_fc2d2f23:

    # MC "Hopefully I won’t get eaten before then..."
    MC "Espérons que je ne me fasse pas dévorer avant..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:33
translate fr palam_sewer_4876225d:

    # "Down in the depths of the Sub-Basement, I transformed into my ‘other’ form."
    "Dans les profondeurs du Sous-Sol, je me suis transformé en ma forme ‘autre’."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:37
translate fr palam_sewer_a87a791a:

    # "It was damp and cold down here, a place the mages rarely trod unless performing the most dangerous of spells."
    "C'était humide et froid ici, un endroit que les mages foulaient rarement, sauf pour effectuer les sorts les plus dangereux."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:38
translate fr palam_sewer_748a18cd:

    # "I could see better once transformed, through a red tint I could make out shapes, the tiled ground and more as I patrolled through the eerily quiet halls."
    "Je voyais mieux une fois transformé, à travers une teinte rouge je pouvais distinguer des formes, le sol carrelé et plus encore alors que je patrouillais dans les couloirs sinistrement silencieux."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:39
translate fr palam_sewer_bc98682c:

    # "Every so often I’d find a body or two, poor unlucky souls who had failed to make it out in time."
    "De temps en temps, je trouvais un corps ou deux, pauvres âmes malchanceuses qui n'avaient pas réussi à sortir à temps."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:40
translate fr palam_sewer_927ac599:

    # "They were mangled with flies crawling around the old, now festering wounds."
    "Ils étaient mutilés, avec des mouches rampant autour des vieilles plaies désormais purulentes."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:41
translate fr palam_sewer_9f79d839:

    # "Dried blood stained the walls, and as I inspected the wounds, I wondered what sort of creature could have done this?"
    "Du sang séché tachait les murs, et en inspectant les blessures, je me demandais quel genre de créature avait pu faire cela ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:42
translate fr palam_sewer_98510b84:

    # "As I smelt the air, something wretched and rotten drew me deeper into the labyrinthine tunnels of the Sub-Basement."
    "Alors que je humais l'air, quelque chose de fétide et de pourri m'attira plus profondément dans les tunnels labyrinthiques du Sous-Sol."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:43
translate fr palam_sewer_366e166c:

    # "Finally, I arrived upon what seemed to be the site of the summoning, the white chalk now stained with dried blood splatters as corpses littered around the room had been moved and piled up into a decaying mound of death."
    "Finalement, je suis arrivé sur ce qui semblait être le site de l'invocation, la craie blanche désormais tachée d'éclaboussures de sang séché, tandis que les cadavres jonchant la pièce avaient été déplacés et entassés en un monticule de mort en décomposition."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:44
translate fr palam_sewer_005bb15e:

    # "From the small signs of struggle, it had been a massacre in here."
    "D'après les petits signes de lutte, il y avait eu un massacre ici."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:45
translate fr palam_sewer_cbd77677:

    # "Inexperienced mages conjuring up something beyond what they could possibly hope to control..."
    "Des mages inexpérimentés invoquant quelque chose au-delà de ce qu'ils pouvaient espérer contrôler..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:46
translate fr palam_sewer_4fef6a9e:

    # "We had heard of such stories before but... seeing the result up close and personal was one of the more horrifying things I’d had to bear witness to."
    "Nous avions déjà entendu de telles histoires auparavant mais... voir le résultat de près et en personne était l'une des choses les plus horrifiantes dont j'ai dû être témoin."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:47
translate fr palam_sewer_a449b1e2:

    # "Suddenly, a loud rumbling sound could be heard as a rhythmic stomping seemed to shake the walls around me."
    "Soudain, un fort grondement se fit entendre tandis qu'un piétinement rythmique semblait faire trembler les murs autour de moi."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:48
translate fr palam_sewer_98ad3b39:

    # "Looking towards one of the dark halls leading out, I could hear the thing coming closer towards me."
    "En regardant vers l'un des couloirs sombres menant à l'extérieur, je pouvais entendre la chose s'approcher de moi."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:49
translate fr palam_sewer_8bb109c5:

    # "Hiding behind a pillar, I waited and watched for whatever was approaching from the shadows."
    "Caché derrière un pilier, j'attendais et observais ce qui s'approchait depuis les ombres."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:53
translate fr palam_sewer_279cdf3c:

    # "Appearing through the darkness, a giant green frog-like creature sprung its way forward."
    "Surgissant de l'obscurité, une créature géante ressemblant à une grenouille verte bondit en avant."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:54
translate fr palam_sewer_72148ff0:

    # "It’s eyes blinking independently of one another as it looked around at the many corpses on the floor."
    "Ses yeux clignaient indépendamment l'un de l'autre tandis qu'elle regardait les nombreux cadavres sur le sol."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:55
translate fr palam_sewer_478bfa2b:

    # "Its tongue snapped out, grabbing one of the decaying bodies before lurching it into its mouth."
    "Sa langue surgit, attrapant l'un des corps en décomposition avant de le projeter dans sa gueule."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:56
translate fr palam_sewer_0d31b390:

    # "Its razor teeth chomped down, gnawing at the bones which snapped with the movement of its jaws."
    "Ses dents tranchantes comme des rasoirs mordaient, rongeant les os qui craquaient sous le mouvement de ses mâchoires."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:57
translate fr palam_sewer_b6e494ab:

    # "Hideous to behold, the creature smelled of some deep rot and mould as its mouth dripped old blood from the corpse it chewed."
    "Hideuse à voir, la créature sentait une profonde pourriture et une moisissure, tandis que de vieux sang coulait de sa gueule alors qu'elle mâchait le cadavre."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:58
translate fr palam_sewer_ebdaed43:

    # "Its back was covered in thick black and sickly yellow spikes that seemed to tingle with the cold air, as if sensing for the slightest vibrations."
    "Son dos était couvert d'épaisses épines noires et d'un jaune malsain qui semblaient frémir au contact de l'air froid, comme si elles captaient les moindres vibrations."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:59
translate fr palam_sewer_e0db2096:

    # "Suddenly, the thing stopped chewing... Letting the mangled body roll out of its mouth and slip almost comically to the floor, it raised its snout and sniffed into the air, taking deep guttural breaths."
    "Soudain, la chose cessa de mâcher... Laissant le corps mutilé rouler hors de sa bouche et glisser presque comiquement sur le sol, elle leva son museau et renifla l'air, prenant de profondes respirations gutturales."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:60
translate fr palam_sewer_b8f57e6b:

    # MC "... Does it know I’m here?"
    MC "... Sait-il que je suis ici ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:61
translate fr palam_sewer_e365d7bb:

    # "Suddenly, its tongue lashed out, tearing away the pillar I was hiding behind!"
    "Soudain, sa langue jaillit, arrachant le pilier derrière lequel je me cachais !"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:62
translate fr palam_sewer_5dc3baef:

    # MC "...!"
    MC "...!"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:63
translate fr palam_sewer_119abfd8:

    # MC "Well, I guess that answers that!"
    MC "Eh bien, je suppose que ça répond à ça !"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:64
translate fr palam_sewer_2cc0083f:

    # MC "There’s no choice now!"
    MC "Il n'y a plus le choix maintenant !"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:78
translate fr palam_sewer_e70f4666:

    # "As the thing weaved drowsily back and forth, blood seeping from its wounds and mouth, it heaved and shuddered before collapsing onto its side."
    "Alors que la chose oscillait, à moitié endormie, en avant et en arrière, du sang suintant de ses blessures et de sa bouche, elle eut un haut-le-cœur et frissonna avant de s'effondrer sur le côté."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:79
translate fr palam_sewer_983f46aa:

    # "Its tongue flopped in defeat as it took one last long ragged breath, inflating its stomach before it simply fizzled out in a slow, pitiful death."
    "Sa langue s'affaissa de défaite tandis qu'elle prenait une dernière longue respiration haletante, gonflant son ventre avant de s'éteindre simplement dans une mort lente et pitoyable."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:80
translate fr palam_sewer_66fc34db:

    # MC "{i}*Huff*{/i} Where did that thing come from?"
    MC "{i}*Huff*{/i} D'où venait cette chose ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:81
translate fr palam_sewer_e39751b3:

    # BLACK "This creature has proven formidable... We should consider training to enhance our combat abilities further should other predators arrive."
    BLACK "Cette créature s'est avérée redoutable... Nous devrions envisager de nous entraîner pour améliorer davantage nos capacités de combat au cas où d'autres prédateurs arriveraient."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:82
translate fr palam_sewer_7ae248df:

    # MC "Ha, thanks for the tip, captain obv—"
    MC "Ha, merci pour le tuyau, capitaine évid—"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:84
translate fr palam_sewer_e4b6b435:

    # "The tongue suddenly lashed out, wrapping around my ankle as it tripped me up onto the cold, wet floor."
    "La langue jaillit soudain, s'enroulant autour de ma cheville et me fit trébucher sur le sol froid et humide."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:85
translate fr palam_sewer_d28c61d4:

    # MC "SHIT!"
    MC "MERDE !"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:86
translate fr palam_sewer_e8a960a5:

    # "Dragging me towards its gaping maw of a mouth, I glared at the dozen or so razor teeth waiting to gnash and grind my bones, one desperate last meal for a dying beast."
    "Me traînant vers sa gueule béante, je lançai un regard furieux à la douzaine de dents acérées prêtes à grincer et broyer mes os, un dernier repas désespéré pour une bête mourante."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:89
translate fr palam_sewer_65c814be:

    # "Just before it's jaws landed on me, a sparkling blast of magic energy hit the beast."
    "Juste avant que ses mâchoires ne se referment sur moi, un éclat scintillant d'énergie magique frappa la bête."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:91
translate fr palam_sewer_182917d6:

    # "The monster wailed and cried out desperately."
    "Le monstre gémit et cria désespérément."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:92
translate fr palam_sewer_b4926bc7:

    # "Finally, it dropped to the floor motionless, and the thing’s eyes rolled deathly white as it lay still again."
    "Finalement, il s'effondra au sol, immobile, et ses yeux se révulsèrent en un blanc cadavérique tandis qu'il gisait à nouveau sans vie."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:98
translate fr palam_sewer_f0470a4e:

    # "Stood above me was Divine who flung her blade aside and smiled."
    "Au-dessus de moi se tenait Divine, qui jeta sa lame de côté et sourit."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:99
translate fr palam_sewer_02934deb:

    # DIVINE "{i}I knew it...{/i}"
    DIVINE "{i}Je le savais...{/i}"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:100
translate fr palam_sewer_36aff0e0:

    # DIVINE "I knew you weren’t entirely human."
    DIVINE "Je savais que tu n'étais pas entièrement humain."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:101
translate fr palam_sewer_9e2faf03:

    # MC "Wait! I can explain!"
    MC "Attends ! Je peux expliquer !"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:102
translate fr palam_sewer_95553f22:

    # DIVINE "No need, I do not care."
    DIVINE "Pas besoin, je m'en fiche."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:103
translate fr palam_sewer_95f0303e:

    # MC "What? But I—"
    MC "Quoi ? Mais je—"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:104
translate fr palam_sewer_ff5736a0:

    # DIVINE "Was the right man for the job, clearly!"
    DIVINE "C'était l'homme qu'il fallait pour le boulot, clairement !"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:105
translate fr palam_sewer_910d63ea:

    # DIVINE "Next time though, {i}make sure it’s actually dead{/i} before you call it a job well done."
    DIVINE "Mais la prochaine fois, {i}assure-toi qu'il est vraiment mort{/i} avant de dire que le travail est bien fait."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:106
translate fr palam_sewer_852f9fc8:

    # MC "Yeah... Thanks for that."
    MC "Ouais... Merci pour ça."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:108
translate fr palam_sewer_8efe8db7:

    # "As I rose to my feet, Sister Divine smirked and looked me up and down."
    "Alors que je me relevais, Sœur Divine eut un sourire narquois et me toisa de la tête aux pieds."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:109
translate fr palam_sewer_60fd0c17:

    # DIVINE "I’ve never seen a being such as you."
    DIVINE "Je n'ai jamais vu un être tel que vous."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:110
translate fr palam_sewer_3cbf647c:

    # MC "H-How did you know?"
    MC "C-Comment avez-vous su ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:112
translate fr palam_sewer_5ae72044:

    # DIVINE "The goddess Palam allowed me to sense it so..."
    DIVINE "La déesse Palam m'a permis de le sentir, alors..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:113
translate fr palam_sewer_a53800ab:

    # MC "{i}... What?{/i}"
    MC "{i}... Quoi ?{/i}"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:114
translate fr palam_sewer_95d6ca64:

    # DIVINE "Magic, no matter the type, carries with it its own distinct scent."
    DIVINE "La magie, quel que soit son type, transporte avec elle son propre parfum distinct."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:115
translate fr palam_sewer_def70cda:

    # DIVINE "{i}You{/i} smell unlike anything I have ever encountered before."
    DIVINE "{i}Toi{/i}, tu sens comme rien de ce que j'ai rencontré auparavant."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:116
translate fr palam_sewer_063f888a:

    # DIVINE "I knew there was something different about you the moment I laid eyes on you."
    DIVINE "J'ai su qu'il y avait quelque chose de différent chez toi au moment où j'ai posé les yeux sur toi."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:117
translate fr palam_sewer_eaecdf7a:

    # MC "... Well, what are you going to do?"
    MC "... Eh bien, que vas-tu faire ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:118
translate fr palam_sewer_6a47d41d:

    # DIVINE "{i}... Nothing.{/i}"
    DIVINE "{i}... Rien.{/i}"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:119
translate fr palam_sewer_fd5dec13:

    # MC "Nothing?"
    MC "Rien ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:120
translate fr palam_sewer_95efb4e4:

    # DIVINE "Your secret is safe with me."
    DIVINE "Ton secret est en sécurité avec moi."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:121
translate fr palam_sewer_e1b0c1cb:

    # DIVINE "I can think of {i}so{/i} many other things I’d rather do with you..."
    DIVINE "Je peux penser à {i}tellement{/i} d'autres choses que j'aimerais faire avec toi..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:123
translate fr palam_sewer_692b0afe:

    # "Sister Divine stepped forward alluringly, her hands resting over the hard exoskeleton of my chest."
    "Sœur Divine s'avança de manière séduisante, ses mains se posant sur l'exosquelette dur de ma poitrine."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:124
translate fr palam_sewer_4b59b47b:

    # MC "Uhh... Are you—"
    MC "Euh... Es-tu—"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:125
translate fr palam_sewer_99ed047d:

    # DIVINE "You know what I’m asking for."
    DIVINE "Tu sais ce que je demande."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:126
translate fr palam_sewer_8694cdf2:

    # MC "... Wouldn’t you prefer I take my human form?"
    MC "... Ne préférerais-tu pas que je prenne ma forme humaine ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:127
translate fr palam_sewer_f70525f9:

    # DIVINE "Not at all, I could have a human any day of the week..."
    DIVINE "Pas du tout, je pourrais avoir un humain n'importe quel jour de la semaine..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:128
translate fr palam_sewer_f5bfa92e:

    # DIVINE "{i}But this...{/i} This form is something special."
    DIVINE "{i}Mais ça...{/i} Cette forme est quelque chose de spécial."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:129
translate fr palam_sewer_a5d9231c:

    # MC "I... What about the crystal?"
    MC "Je... Et le cristal ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:130
translate fr palam_sewer_aee746da:

    # "Sister Divine held up the glowing purple crystal bound in some ancient metal for me to see."
    "Sœur Divine leva le cristal violet brillant, serti dans un métal ancien, pour me le montrer."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:131
translate fr palam_sewer_099d76d4:

    # DIVINE "{i}All ready for when you leave.{/i}"
    DIVINE "{i}Tout prêt pour ton départ.{/i}"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:132
translate fr palam_sewer_58a26a7f:

    # DIVINE "So... how about it?"
    DIVINE "Alors... qu'en dis-tu ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:133
translate fr palam_sewer_058d9062:

    # DIVINE "We could learn so much from each other..."
    DIVINE "Nous pourrions tant apprendre l'un de l'autre..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:138
translate fr palam_sewer_287684b0:

    # DIVINE "I’m glad to hear that."
    DIVINE "Je suis content de l’entendre."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:139
translate fr palam_sewer_6e39d425:

    # DIVINE "Here, take this..."
    DIVINE "Tiens, prends ça..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:140
translate fr palam_sewer_7e711a64:

    # "In my hands, Sister Divine palmed a small blue stone with a white insignia on it."
    "Dans mes mains, Sœur Divine glissa une petite pierre bleue portant un insigne blanc."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:141
translate fr palam_sewer_f781f9da:

    # MC "What is this?"
    MC "Qu’est-ce que c’est ?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:142
translate fr palam_sewer_35eb4e4b:

    # DIVINE "It is my blessing to allow you to wander this tower at night."
    DIVINE "C’est ma bénédiction pour te permettre d’errer dans cette tour la nuit."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:145
translate fr palam_sewer_dcc31424:

    # MC "You mean—"
    MC "Tu veux dire—"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:146
translate fr palam_sewer_9fec17fd:

    # DIVINE "We prefer our mages handle their dalliances with... discretion."
    DIVINE "Nous préférons que nos mages gèrent leurs liaisons avec... discrétion."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:147
translate fr palam_sewer_9eecb9f4:

    # DIVINE "This way suits both our needs."
    DIVINE "De cette manière, cela convient à nos besoins mutuels."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:149
translate fr palam_sewer_d11b242a:

    # "With that, Sister Divine turned to leave the basement while I followed in her wake."
    "Sur ces mots, Sœur Divine se tourna pour quitter le sous-sol tandis que je la suivais dans son sillage."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:150
translate fr palam_sewer_e2dda61b:

    # DIVINE "Come, this way..."
    DIVINE "Viens, par ici..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:151
translate fr palam_sewer_2df05c72:

    # "In her hands, a glowing blue ball began to form, illuminating the passageways back for us."
    "Dans ses mains, une boule bleue lumineuse commença à se former, illuminant les couloirs sur notre chemin de retour."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:152
translate fr palam_sewer_14631ca4:

    # "Along the way, I noticed Sister Divine kept looking back at me, perhaps contemplating what was to come between us."
    "En chemin, je remarquai que Sœur Divine n'arrêtait pas de se retourner vers moi, songeant peut-être à ce qui allait advenir entre nous."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:154
translate fr palam_sewer_3905a23f:

    # "As I changed back into my human form, Divine remarked I should get dressed before making my way out of the basement, scrambling to locate the clothes I had left on my way in, we finally returned to the main halls of the tower."
    "Alors que je reprenais ma forme humaine, Divine fit remarquer que je devrais m'habiller avant de sortir du sous-sol, cherchant à retrouver les vêtements que j'avais laissés en chemin, nous retournâmes finalement dans les salles principales de la tour."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:157
translate fr palam_sewer_a205ebc7:

    # DIVINE "Hmm... A shame."
    DIVINE "Hmm... Dommage."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:158
translate fr palam_sewer_d3c2fa0e:

    # DIVINE "Then I guess our business has concluded."
    DIVINE "Alors, je suppose que nos affaires sont terminées."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:159
translate fr palam_sewer_d6c70b13:

    # DIVINE "Come, I will escort you out."
    DIVINE "Venez, je vais vous raccompagner."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:160
translate fr palam_sewer_f19eb997:

    # "In her hands, a glowing blue ball began to form, lighting the way back for us as I followed behind."
    "Dans ses mains, une boule bleue lumineuse commença à se former, éclairant le chemin du retour pour nous alors que je la suivais."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:161
translate fr palam_sewer_e7a9b781:

    # "I sensed the disappointment in Divine’s voice, but decided it was probably best to keep my mouth shut."
    "Je sentis la déception dans la voix de Divine, mais décidai qu'il valait probablement mieux me taire."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:163
translate fr palam_sewer_48b7803c:

    # "As I changed back into my human form, Divine remarked I should get dressed before making my way out of the basement."
    "Alors que je reprenais ma forme humaine, Divine fit remarquer que je devrais m'habiller avant de quitter le sous-sol."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:164
translate fr palam_sewer_ced1a217:

    # "I scrambled to gather up the clothes I has abandoned on my way in and we finally returned to the main halls of the tower."
    "Je m'empressai de récupérer les vêtements que j'avais abandonnés en chemin et nous retournâmes finalement dans les salles principales de la tour."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:169
translate fr palam_sewer_fac7386c:

    # DIVINE "I thank you for your services to the Goddess Palam."
    DIVINE "Je vous remercie pour vos services à la déesse Palam."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:170
translate fr palam_sewer_4bc02166:

    # MC @ talk "Anytime... Although I hope that next time it won’t be so quite so dangerous."
    MC @ talk "De rien... Bien que j'espère que la prochaine fois ne sera pas aussi dangereuse."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:172
translate fr palam_sewer_39656a81:

    # "Sister Divine smiled, holding out the crystal for me to take."
    "Sœur Divine sourit, me tendant le cristal pour que je le prenne."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:175
translate fr palam_sewer_8194abb6:

    # DIVINE "It’s all yours."
    DIVINE "C'est tout à vous."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:176
translate fr palam_sewer_29d31280:

    # MC @ talk "Glad to be of service."
    MC @ talk "Ravi d'avoir été utile."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:178
translate fr palam_sewer_3797aa16:

    # DIVINE "I look forward to our next meeting..."
    DIVINE "Je me réjouis de notre prochaine rencontre..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:180
translate fr palam_sewer_2837592b:

    # DIVINE "Of course."
    DIVINE "Bien sûr."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:181
translate fr palam_sewer_8474a392:

    # DIVINE "Now, if you will excuse me..."
    DIVINE "Maintenant, si vous voulez bien m'excuser..."

