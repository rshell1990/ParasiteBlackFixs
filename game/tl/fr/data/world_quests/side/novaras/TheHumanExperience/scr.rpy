    VALA "Laisse simplement le livre ici quand tu auras fini."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:679
translate fr qst_HumanExp_9_valaLearnSlimelarks_8de5398c:

    # "{i}Slimelarks, by their very nature, are omnivorous predators.{/i}"
    "{i}Les Slimelarks, par leur nature même, sont des prédateurs omnivores.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:680
translate fr qst_HumanExp_9_valaLearnSlimelarks_0069e7e7:

    # "{i}In their infancy, they rely far more on raw meat, often provided to them by their mothers, in order to build up their strength.{/i}"
    "{i}Dans leur petite enfance, ils dépendent bien plus de la viande crue, souvent fournie par leur mère, afin de développer leur force.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:681
translate fr qst_HumanExp_9_valaLearnSlimelarks_8bfd7566:

