    # MC "Come then, Myu, let's get you home."
    MC "Viens, Myu, on va te ramener chez toi."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:267
translate fr qst_NewMyu_4_findMyuChurch_menu_397c7208:

    # KYLISA @ talk "I take it all is resolved?"
    KYLISA @ talk "Je suppose que tout est résolu ?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:272
translate fr qst_NewMyu_4_findMyuChurch_menu_d07dee5f:

    # MC @ smile "I think so."
    MC @ smile "Je pense que oui."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:273
translate fr qst_NewMyu_4_findMyuChurch_menu_1918d395:

    # KYLISA @ smile "Good."
    KYLISA @ smile "Bien."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:274
translate fr qst_NewMyu_4_findMyuChurch_menu_1ae85692:

    # MC @ talk "Thank you for helping her."
    MC @ talk "Merci de l'avoir aidée."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:275
translate fr qst_NewMyu_4_findMyuChurch_menu_5c7b44a3:

    # MC @ talk "I know many wouldn't."
    MC @ talk "Je sais que beaucoup ne l'auraient pas fait."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:276
translate fr qst_NewMyu_4_findMyuChurch_menu_15eff0cd:

    # KYLISA @ talk "I am sure one day in the future, you may return this act of kindness."
    KYLISA @ talk "Je suis sûr qu'un jour, dans le futur, vous pourriez rendre la pareille."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:277
translate fr qst_NewMyu_4_findMyuChurch_menu_1fd3c380:

    # KYLISA @ talk "...Tell me something though."
    KYLISA @ talk "...Dites-moi quelque chose, cependant."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:278
translate fr qst_NewMyu_4_findMyuChurch_menu_d669e126:

    # KYLISA @ talk "Why are {i}you{/i} helping this slimelark?"
    KYLISA @ talk "Pourquoi est-ce {i}vous{/i} qui aidez cette slimelark ?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:281
translate fr qst_NewMyu_4_findMyuChurch_menu_6824b63e:

    # KYLISA @ talk "...Very well, as good an answer as any I suppose."
    KYLISA @ talk "...Très bien, une réponse aussi bonne qu'une autre, je suppose."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:283
translate fr qst_NewMyu_4_findMyuChurch_menu_54991cbc:

    # KYLISA @ talk "...I see."
    KYLISA @ talk "...Je vois."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:284
translate fr qst_NewMyu_4_findMyuChurch_menu_f9a7a2d5:

    # KYLISA @ talk "Well I hope you and your companion chose wisely in this war and the wars to come."
    KYLISA @ talk "Eh bien, j'espère que vous et votre compagnon avez choisi sagement dans cette guerre et les guerres à venir."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:286
translate fr qst_NewMyu_4_findMyuChurch_menu_f0530664:

    # "...The phrase jumped out of me in a tone so... {i}alien{/i}."
    "...La phrase m'a échappé d'un ton tellement... {i}étranger{/i}."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:287
translate fr qst_NewMyu_4_findMyuChurch_menu_277775a1:

    # KYLISA @ blush "I... Right, well, as long as {i}she's{/i} happy with that as well I suppose."
    KYLISA @ blush "Je... Bon, eh bien, tant qu'{i}elle{/i} est aussi contente de ça, je suppose."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:288
translate fr qst_NewMyu_4_findMyuChurch_menu_d87ee605:

    # KYLISA @ talk "Perhaps you might want to consider leaving Novaras if that's your long term-plan with her."
    KYLISA @ talk "Peut-être devriez-vous envisager de quitter Novaras si c'est votre plan à long terme avec elle."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:289
translate fr qst_NewMyu_4_findMyuChurch_menu_3f3c80c2:

    # KYLISA @ talk "The inquisition have punished many... With child or not."
    KYLISA @ talk "L'Inquisition a puni beaucoup de gens... Enceinte ou non."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:290
translate fr qst_NewMyu_4_findMyuChurch_menu_843d3cc8:

    # KYLISA @ talk "Anyway, you two should leave now, before someone else comes inquiring."
    KYLISA @ talk "Quoi qu'il en soit, vous devriez partir maintenant, avant que quelqu'un d'autre ne vienne poser des questions."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:291
translate fr qst_NewMyu_4_findMyuChurch_menu_6fd3619a:

    # MC @ talk "Thank you, Kylisa."
    MC @ talk "Merci, Kylisa."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:293
translate fr qst_NewMyu_4_findMyuChurch_menu_e2cf7747:

    # "After that, the two of us slipped away back home safely."
    "Après cela, nous nous sommes échappés tous les deux pour rentrer chez nous sains et saufs."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:301
translate fr qst_NewMyu_4_findMyuChurch_menu_a00b8bf6:

    # MYU @ talk "Myu tired, can... can we talk more soon?"
    MYU @ talk "Myu fatiguée, on... on peut en reparler bientôt ?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:302
translate fr qst_NewMyu_4_findMyuChurch_menu_b7078ada:

    # MC @ talk "Of course, Myu."
    MC @ talk "Bien sûr, Myu."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:306
translate fr qst_NewMyu_4_findMyuChurch_menu_7d6bdbfd:

