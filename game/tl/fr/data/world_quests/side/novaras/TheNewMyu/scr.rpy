translate fr qst_NewMyu_4_findMyuChurch_menu_587718cb:

    # MYU "{i}*Sniff*{/i} Myu is ready to go home now."
    MYU "{i}*Sniff*{/i} Myu est prête à rentrer à la maison maintenant."

