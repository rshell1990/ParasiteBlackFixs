translate fr qst_NewMyu_4_findMyuChurch_menu_3443b8a7:

    # MC @ smile "And just because you're a little different, it doesn't make you a monster."
    MC @ smile "Et ce n'est pas parce que tu es un peu différent que tu es un monstre."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:257
translate fr qst_NewMyu_4_findMyuChurch_menu_bb741f1e:

    # MYU "..."
    MYU "..."

