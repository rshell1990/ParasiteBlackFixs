translate fr qst_NewMyu_4_findMyuChurch_menu_916c466a:

    # MC @ talk "You're not a monster Myu... You're just a scared girl trying to understand a scary world."
    MC @ talk "Tu n'es pas un monstre, Myu... Tu es juste une fille effrayée qui essaie de comprendre un monde effrayant."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:252
translate fr qst_NewMyu_4_findMyuChurch_menu_0ea19dfc:

    # MC @ talk "I'm sorry I made you feel the way you did, and truth is, you {i}did{/i} scare me a little."
    MC @ talk "Je suis désolé de t'avoir fait te sentir comme ça, et à vrai dire, tu m'as {i}vraiment{/i} fait un peu peur."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:253
translate fr qst_NewMyu_4_findMyuChurch_menu_d5d364dc:

    # "Myu's eyes dropped to the floor dejectedly."
    "Les yeux de Myu tombèrent au sol, l'air abattu."

