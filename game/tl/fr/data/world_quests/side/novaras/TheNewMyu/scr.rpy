translate fr qst_NewMyu_4_findMyuChurch_menu_51e28bb2:

    # "Myu leapt forward to hug me."
    "Myu s'est élancée en avant pour me faire un câlin."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:263
translate fr qst_NewMyu_4_findMyuChurch_menu_6dca0e04:

    # MC "Whoa, easy now!"
    MC "Whoa, doucement !"

