    MYU @ sad "...Est-ce que [player_name!t] a peur de Myu ?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:247
translate fr qst_NewMyu_4_findMyuChurch_menu_667c4a7d:

