translate fr qst_NewMyu_4_findMyuChurch_d47da673:

    # MC @ sad "What is Myu doing in there?"
    MC @ sad "Que fait Myu là-dedans ?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:200
translate fr qst_NewMyu_4_findMyuChurch_cbf62435:

    # KYLISA @ sad "I found the poor thing sobbing in the pews telling me she was a monster over and over again."
    KYLISA @ sad "J'ai trouvé la pauvre chose sanglotant dans les bancs, me répétant sans cesse qu'elle était un monstre."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:201
translate fr qst_NewMyu_4_findMyuChurch_e71bf7fc:

    # KYLISA @ sad "So, I canceled the services for today."
    KYLISA @ sad "Alors, j'ai annulé les offices pour aujourd'hui."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:206
translate fr qst_NewMyu_4_findMyuChurch_menu_d512b3b1:

    # KYLISA @ angry "Because some of us can still remember when times were better and we fought back against the over-reach of the inquisitors."
    KYLISA @ angry "Parce que certains d'entre nous se souviennent encore de l'époque où les temps étaient meilleurs et où nous résistions aux excès des inquisiteurs."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:207
translate fr qst_NewMyu_4_findMyuChurch_menu_de7ef835:

    # KYLISA @ talk "The inquisitors destroy whatever they fear, but there was a time we strived to understand different races."
    KYLISA @ talk "Les inquisiteurs détruisent tout ce qu'ils craignent, mais il fut un temps où nous nous efforcions de comprendre les différentes races."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:208
translate fr qst_NewMyu_4_findMyuChurch_menu_e90b93c7:

    # KYLISA @ talk "I must admit, I was a little taken aback at first by a slimelark, but our faith is not one to turn away the weary, whoever or whatever they may be."
    KYLISA @ talk "Je dois avouer que j'ai été un peu déconcerté au début par un slimelark, mais notre foi n'est pas de celles qui repoussent les fatigués, qui qu'ils soient ou quoi qu'ils soient."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:211
translate fr qst_NewMyu_4_findMyuChurch_menu_d72d0c11:

    # KYLISA @ talk "Of course, but be gentle with her."
    KYLISA @ talk "Bien sûr, mais soyez doux avec elle."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:212
translate fr qst_NewMyu_4_findMyuChurch_menu_17fcf1b7:

    # KYLISA @ talk "She's quite... fragile."
    KYLISA @ talk "Elle est assez... fragile."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:223
translate fr qst_NewMyu_4_findMyuChurch_menu_0fae614a:

    # "When I entered the Church, Myu continued to cry softly, and when she saw me she stood up and slowly approached anxiously."
    "Quand je suis entré dans l'église, Myu continuait de pleurer doucement, et quand elle m'a vu, elle s'est levée et s'est approchée lentement avec anxiété."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:225
translate fr qst_NewMyu_4_findMyuChurch_menu_fad080da:

    # MYU @ sad "...Myu feels like such a fool."
    MYU @ sad "...Myu se sent tellement idiote."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:226
translate fr qst_NewMyu_4_findMyuChurch_menu_56282f41:

    # MC @ sad "Myu, what happened back there?"
    MC @ sad "Myu, qu'est-ce qui s'est passé là-bas ?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:227
translate fr qst_NewMyu_4_findMyuChurch_menu_bd7c742b:

    # MC @ talk "Why were you feeding on someone in your room?"
    MC @ talk "Pourquoi te nourrissais-tu de quelqu'un dans ta chambre ?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:228
translate fr qst_NewMyu_4_findMyuChurch_menu_ff5f2a2b:

    # MC @ talk "Why didn't you just tell me you wanted to hunt?"
    MC @ talk "Pourquoi ne m'as-tu pas simplement dit que tu voulais chasser ?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:229
translate fr qst_NewMyu_4_findMyuChurch_menu_047dff7d:

    # "Myu fumbled on her words, struggling to get out what she wanted to say."
    "Myu bafouilla, peinant à sortir ce qu'elle voulait dire."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:230
translate fr qst_NewMyu_4_findMyuChurch_menu_9e1d8414:

    # MYU @ sad "{i}...Myu wanted to show you she could be normal.{/i}"
    MYU @ sad "{i}...Myu voulait te montrer qu'elle pouvait être normale.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:231
translate fr qst_NewMyu_4_findMyuChurch_menu_dcfad6aa:

    # MYU @ sad "{i}Myu wanted to prove she wasn't a monster...{/i}"
    MYU @ sad "{i}Myu voulait prouver qu'elle n'était pas un monstre...{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:232
translate fr qst_NewMyu_4_findMyuChurch_menu_a6bd4ad4:

    # MYU @ sad "So Myu tried eating like everyone else."
    MYU @ sad "Alors Myu a essayé de manger comme tout le monde."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:233
translate fr qst_NewMyu_4_findMyuChurch_menu_7564ec5b:

    # MYU @ sad "But it just kept making Myu more and more sick."
    MYU @ sad "Mais ça ne faisait que rendre Myu de plus en plus malade."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:234
translate fr qst_NewMyu_4_findMyuChurch_menu_87e50561:

    # MYU sad "Till Myu was soooo hungry."
    MYU sad "Jusqu'à ce que Myu ait tellement faim."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:235
translate fr qst_NewMyu_4_findMyuChurch_menu_0a99c764:

    # MYU @ sad "Myu couldn't stop herself anymore... All Myu could think about was food."
    MYU @ sad "Myu n'a pas pu se retenir plus longtemps... Tout ce à quoi Myu pouvait penser, c'était la nourriture."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:236
translate fr qst_NewMyu_4_findMyuChurch_menu_542b671d:

    # MYU @ sad "Myu saw the way you looked at her last time, Myu so... {i}dirty.{/i}"
    MYU @ sad "Myu a vu la façon dont tu l'as regardée la dernière fois, Myu tellement... {i}sale.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:237
translate fr qst_NewMyu_4_findMyuChurch_menu_4077d558:

    # MYU @ sad "Myu didn't want you to feel dirty again, no matter how hungry she got."
    MYU @ sad "Myu ne voulait pas que tu te sentes à nouveau sale, peu importe à quel point elle avait faim."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:238
translate fr qst_NewMyu_4_findMyuChurch_menu_275e2d28:

    # MYU @ sad "So, Myu hunted alone, wanted to hide it from you so you wouldn't see Myu like that again."
    MYU @ sad "Alors, Myu a chassé seule, a voulu te le cacher pour que tu ne voies pas Myu comme ça à nouveau."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:239
translate fr qst_NewMyu_4_findMyuChurch_menu_3040230e:

