translate fr qst_NewMyu_4_findMyuChurch_menu_d9dfd88f:

    # "I gently wiped away one of her tears."
    "J'ai doucement essuyé une de ses larmes."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:242
translate fr qst_NewMyu_4_findMyuChurch_menu_9d7e2515:

