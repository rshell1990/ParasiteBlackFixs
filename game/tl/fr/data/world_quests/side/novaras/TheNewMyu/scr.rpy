translate fr qst_NewMyu_4_findMyuChurch_menu_01cd8043:

    # MC @ smile "{i}Because I guess I'm kinda scary too sometimes.{/i}"
    MC @ smile "{i}Parce que je suppose que je suis aussi un peu effrayant parfois.{/i}"

