    # "The thing was clunky and heavy, with a small green jewel in the middle and Ramonian written around it followed by 'Angharad XXII"
    "La chose était lourde et encombrante, avec un petit bijou vert au milieu et du Ramonian écrit autour suivi de 'Angharad XXII'"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:818
translate fr qsttheslavemaster_meeting_last_question_5569b731:

    # ANGHARAD @ talk "My slave number."
    ANGHARAD @ talk "Mon numéro d'esclave."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:819
translate fr qsttheslavemaster_meeting_last_question_8c54c8da:

    # "I stared down at the amulet, and then back at Angharad in disbelief."
    "Je baissai les yeux vers l'amulette, puis les reportai sur Angharad avec incrédulité."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:821
translate fr qsttheslavemaster_meeting_last_question_7c9b9408:

    # MC @ surprised "{i}You were a slave?{/i}"
    MC @ surprised "{i}Tu étais une esclave ?{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:822
translate fr qsttheslavemaster_meeting_last_question_ecf760fb:

    # ANGHARAD @ smile "Of course."
    ANGHARAD @ smile "Bien sûr."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:823
translate fr qsttheslavemaster_meeting_last_question_ff164ff8:

    # ANGHARAD @ smile "After proving my value to my master long enough, he came to trust me more and more."
    ANGHARAD @ smile "Après avoir prouvé ma valeur à mon maître assez longtemps, il en est venu à me faire de plus en plus confiance."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:824
translate fr qsttheslavemaster_meeting_last_question_b8b9cf6b:

    # ANGHARAD @ talk "And when his guard was down ... I slit his throat, and took everything he had."
    ANGHARAD @ talk "Et quand il a baissé sa garde... je lui ai tranché la gorge et j'ai pris tout ce qu'il avait."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:827
translate fr qsttheslavemaster_meeting_last_question_90530c4e:

    # ANGHARAD @ talk "Why should I have?"
    ANGHARAD @ talk "Pourquoi l'aurais-je fait ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:828
translate fr qsttheslavemaster_meeting_last_question_9c4849c6:

    # MC @ sad "It's just, you must have felt {i}something{/i} for them?"
    MC @ sad "C'est juste que... tu as dû ressentir {i}quelque chose{/i} pour eux ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:829
translate fr qsttheslavemaster_meeting_last_question_64212fe1:

    # ANGHARAD @ talk "... You're an odd slaver, aren't you?"
    ANGHARAD @ talk "... Tu es un drôle d'esclavagiste, n'est-ce pas ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:830
translate fr qsttheslavemaster_meeting_last_question_9484688e:

    # ANGHARAD @ talk "No, I did not."
    ANGHARAD @ talk "Non, je ne l'ai pas fait."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:831
translate fr qsttheslavemaster_meeting_last_question_6f879915:

    # ANGHARAD @ talk "Had it not been me, someone else would have done the same given the opportunity."
    ANGHARAD @ talk "Si ce n'avait pas été moi, quelqu'un d'autre aurait fait la même chose, si l'occasion s'était présentée."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:832
translate fr qsttheslavemaster_meeting_last_question_01412b0b:

    # ANGHARAD @ talk "Only people who have always had coin speak of luxuries like {i}righteousness.{/i}"
    ANGHARAD @ talk "Seuls ceux qui ont toujours eu de l'argent parlent de luxes comme la {i}rectitude.{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:833
translate fr qsttheslavemaster_meeting_last_question_6e83d0c4:

    # ANGHARAD @ talk "The starving man? The slave? The man with nothing to lose?"
    ANGHARAD @ talk "L'affamé ? L'esclave ? L'homme qui n'a rien à perdre ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:834
translate fr qsttheslavemaster_meeting_last_question_a1203cd6:

    # ANGHARAD @ talk "He won't question whether something is good or evil when he drags the blade across your throat for just a few coins."
    ANGHARAD @ talk "Il ne se demandera pas si c'est bien ou mal quand il traîne la lame sur ta gorge pour quelques pièces."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:835
translate fr qsttheslavemaster_meeting_last_question_b800a674:

    # "As I opened my mouth to say something, Captain Nyx suddenly tugged at my arm to intercede."
    "Alors que j'ouvrais la bouche pour dire quelque chose, le capitaine Nyx me tira soudainement par le bras pour intervenir."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:838
translate fr qsttheslavemaster_meeting_last_question_4c229a61:

    # ANGHARAD @ smile "Of course you can."
    ANGHARAD @ smile "Bien sûr que tu peux."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:839
translate fr qsttheslavemaster_meeting_last_question_0d17cd35:

    # ANGHARAD @ talk "You and I understand this world was not for us, our kind were never meant to climb the great ladder."
    ANGHARAD @ talk "Toi et moi comprenons que ce monde n'était pas pour nous, que notre espèce n'a jamais été destinée à gravir la grande échelle."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:840
translate fr qsttheslavemaster_meeting_last_question_19fd675a:

    # ANGHARAD @ talk "If we want to find happiness, it will come at the expense of everyone else."
    ANGHARAD @ talk "Si nous voulons trouver le bonheur, ce sera aux dépens de tous les autres."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:841
translate fr qsttheslavemaster_meeting_last_question_4b0c08c9:

    # "Captain Nyx stepping towards me from behind tugged at my arm."
    "Le capitaine Nyx s'approchant de moi par derrière me tira par le bras."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:845
translate fr qsttheslavemaster_meeting_last_question_6bdee803:

    # NYX @ talk "Master? Should I fetch us all some wine?"
    NYX @ talk "Maître ? Devrais-je nous chercher du vin ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:846
translate fr qsttheslavemaster_meeting_last_question_becb58c9:

    # "Nyx gripped my arm tightly and I could see from her eyes she was giving me the signal that we had the proof she needed."
    "Nyx m'a serré le bras fortement et j'ai vu dans ses yeux qu'elle me faisait signe que nous avions la preuve dont elle avait besoin."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:847
translate fr qsttheslavemaster_meeting_last_question_65299ba2:

    # MC @ talk "Yes, fetch us some wine."
    MC @ talk "Oui, va nous chercher du vin."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:852
translate fr qsttheslavemaster_meeting_last_question_d9cece43:

    # "Captain Nyx hurried off to go pour some wine for us."
    "Le capitaine Nyx s'est dépêchée d'aller nous servir du vin."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:854
translate fr qsttheslavemaster_meeting_last_question_a0cc1001:

    # ANGHARAD @ smile "... So, do you love your slave?"
    ANGHARAD @ smile "... Alors, aimez-vous votre esclave ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:855
translate fr qsttheslavemaster_meeting_last_question_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "Quoi ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:856
translate fr qsttheslavemaster_meeting_last_question_326a780f:

    # ANGHARAD @ smile "You'd hardly be the first."
    ANGHARAD @ smile "Vous ne seriez guère le premier."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:857
translate fr qsttheslavemaster_meeting_last_question_b4487286:

    # ANGHARAD @ smile "And the way you two look at each other, well, even the blind could see that."
    ANGHARAD @ smile "Et la façon dont vous vous regardez tous les deux, eh bien, même un aveugle pourrait le voir."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:861
translate fr qsttheslavemaster_meeting_last_question_4ad75aab:

    # "Captain Nyx, after making her way around the room handing each of the guards a cup, she gave Angharad one which he gulped down quickly and threw aside, before finally approaching me with the final cup."
    "Le capitaine Nyx, après avoir fait le tour de la pièce en donnant une coupe à chaque garde, en donna une à Angharad qu'il engloutit rapidement et jeta de côté, avant de finalement s'approcher de moi avec la dernière coupe."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:862
translate fr qsttheslavemaster_meeting_last_question_6c2d69f9:

    # NYX @ talk "Master~"
    NYX @ talk "Maître~"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:863
translate fr qsttheslavemaster_meeting_last_question_d2594cc3:

    # "Nyx lightly nodded to signal to me as I took the cup, and with one sniff, I could tell from the potency of the drug she had placed inside of it, that it wouldn't take long to kick in."
    "Nyx hocha légèrement la tête pour me signaler alors que je prenais la tasse, et d'une simple inspiration, je pouvais dire à la puissance de la drogue qu'elle y avait placée que cela ne tarderait pas à faire effet."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:864
translate fr qsttheslavemaster_meeting_last_question_fc146197:

    # "I pretended to sip at my drink to not arouse suspicion before placing it down back onto the tray."
    "Je fis semblant de siroter ma boisson pour ne pas éveiller les soupçons avant de la reposer sur le plateau."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:865
translate fr qsttheslavemaster_meeting_last_question_2a14326b:

    # MC @ talk "Thank you, Lyesha."
    MC @ talk "Merci, Lyesha."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:866
translate fr qsttheslavemaster_meeting_last_question_ba564e34:

    # "After a few minutes of small talk and laughing amongst the men now they had relaxed in my pressence, Angharad finally interjected,"
    "Après quelques minutes de bavardages et de rires parmi les hommes maintenant qu'ils s'étaient détendus en ma présence, Angharad intervint enfin,"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:867
translate fr qsttheslavemaster_meeting_last_question_f75fda92:

    # ANGHARAD @ smile "Now then, what's say we-"
    ANGHARAD @ smile "Alors, que diriez-vous que nous-"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:868
translate fr qsttheslavemaster_meeting_last_question_ec8caf4d:

    # "One of the Khazah guards suddenly collapsed onto the floor, the others turned to look in panic, reaching for their blades as one by one they fell to the floor."
    "L'un des gardes Khazah s'effondra soudainement sur le sol, les autres se retournèrent pour regarder en panique, cherchant leurs lames alors que l'un après l'autre ils tombaient au sol."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:870
translate fr qsttheslavemaster_meeting_last_question_e29223b1:

    # ANGHARAD @ furious "WHAT THE FUCK IS THIS?!"
    ANGHARAD @ furious "QU'EST-CE QUE C'EST QUE CE BORDEL ?!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:871
translate fr qsttheslavemaster_meeting_last_question_fa9046a3:

    # "Captain Nyx pulled out the small stone that she crushed in her hand, and as she did so, it cracked and glowed red."
    "Le capitaine Nyx sortit la petite pierre qu'elle écrasa dans sa main, et ce faisant, elle se fissura et brilla rouge."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:872
translate fr qsttheslavemaster_meeting_last_question_284926aa:

    # "Moments later, the place was rushed by dozens of the city's guards, spears pointed and ready."
    "Quelques instants plus tard, l'endroit fut envahi par des dizaines de gardes de la ville, lances pointées et prêtes."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:873
translate fr qsttheslavemaster_meeting_last_question_f35119b7:

    # ANGHARAD @ furious "YOU SON OF A-"
    ANGHARAD @ furious "ESPÈCE DE FILS DE-"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:874
translate fr qsttheslavemaster_meeting_last_question_107db710:

    # "Angharad himself tried to reach to grab his blade, gripping the handle as he fumbled and crashed his way into the pieces of furniture deliriously."
    "Angharad lui-même tenta d'attraper sa lame, agrippant la poignée tout en trébuchant et s'écrasant contre les meubles de façon délirante."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:875
translate fr qsttheslavemaster_meeting_last_question_312c1f1c:

    # ANGHARAD @ furious "I'll ... kill ..."
    ANGHARAD @ furious "Je vais ... tuer ..."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:876
translate fr qsttheslavemaster_meeting_last_question_63273423:

    # "Just as Angharad managed to unsheathe his blade, he too collapsed onto the floor with the others, fast asleep."
    "Juste au moment où Angharad parvint à dégainer sa lame, il s'effondra lui aussi sur le sol avec les autres, profondément endormi."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:879
translate fr qsttheslavemaster_meeting_last_question_3fb94171:

    # NYX @ angry "Seize them all at once!"
    NYX @ angry "Saisissez-les tous en même temps !"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:881
translate fr qsttheslavemaster_meeting_last_question_5c168990:

    # "The guards quickly swept across the room, gathering up and arresting Angharad and the other khazah bandits while they were unconscious."
    "Les gardes balayèrent rapidement la pièce, rassemblant et arrêtant Angharad et les autres bandits khazah pendant qu'ils étaient inconscients."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:884
translate fr qsttheslavemaster_meeting_last_question_5e955462:

    # "A shaking Alysha approached the two of us, dazed and confused as to what was going on."
    "Alysha, tremblante, s'approcha de nous deux, hébétée et confuse quant à ce qui se passait."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:885
translate fr qsttheslavemaster_meeting_last_question_f75c3c20:

    # ALYSHA @ talk "W-Who are you both?"
    ALYSHA @ talk "Qui êtes-vous tous les deux ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:886
translate fr qsttheslavemaster_meeting_last_question_7a2f3bc7:

    # NYX @ talk "I am Captain Nyx of the Novaras city guard."
    NYX @ talk "Je suis le capitaine Nyx de la garde de la ville de Novaras."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:888
translate fr qsttheslavemaster_meeting_last_question_7f402aae:

    # ALYSHA @ shock "C-Captain?"
    ALYSHA @ shock "C-Capitaine ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:889
translate fr qsttheslavemaster_meeting_last_question_22d2b2ab:

    # NYX @ laugh "You're free now, Alysha."
    NYX @ laugh "Vous êtes libre maintenant, Alysha."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:890
translate fr qsttheslavemaster_meeting_last_question_ed7553a8:

    # ALYSHA @ shock "F-Free?"
    ALYSHA @ shock "L-Libre ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:891
translate fr qsttheslavemaster_meeting_last_question_57bff934:

    # NYX @ talk "We'll take you in for questioning, and then I'll personally see to it that you're looked after we're done, don't worry."
    NYX @ talk "Nous allons t'emmener pour un interrogatoire, puis je veillerai personnellement à ce qu'on s'occupe de toi une fois que nous aurons terminé, ne t'inquiète pas."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:892
translate fr qsttheslavemaster_meeting_last_question_d633fe0e:

    # NYX @ talk "You, and hopefully the other girls too."
    NYX @ talk "Toi, et j'espère les autres filles aussi."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:893
translate fr qsttheslavemaster_meeting_last_question_495ac1b0:

    # "Alysha's expression was a strange kind of wistfulness, then the tears began to stream down her cheeks."
    "L'expression d'Alysha était une étrange nostalgie, puis les larmes se sont mises à couler sur ses joues."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:895
translate fr qsttheslavemaster_meeting_last_question_0a3241f2:

    # ALYSHA @ crying "It's ... It's really over? I'm free?"
    ALYSHA @ crying "C'est... C'est vraiment fini ? Je suis libre ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:896
translate fr qsttheslavemaster_meeting_last_question_32cd786e:

    # ALYSHA @ crying "{i}I'm ... I'm free.{/i}"
    ALYSHA @ crying "{i}Je... Je suis libre.{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:897
translate fr qsttheslavemaster_meeting_last_question_18954df7:

    # "Alysha suddenly collapsed to the floor, and a panicked Captain Nyx grabbed her."
    "Alysha s'est soudain effondrée au sol, et le capitaine Nyx, paniqué, l'a rattrapée."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:901
translate fr qsttheslavemaster_meeting_last_question_b328a03f:

    # NYX @ shock "Someone get this girl seen to!"
    NYX @ shock "Qu'on s'occupe de cette fille !"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:910
translate fr qsttheslavemaster_meeting_last_question_10affad2:

    # "A couple guards rushed over to grab and carrying her outside."
    "Quelques gardes se sont précipités pour la saisir et l'emporter dehors."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:911
translate fr qsttheslavemaster_meeting_last_question_b6310ff8:

    # MC @ talk "Will she be okay?"
    MC @ talk "Est-ce qu'elle va aller bien ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:913
translate fr qsttheslavemaster_meeting_last_question_f6a575b0:

    # NYX @ talk "She's probably in shock."
    NYX @ talk "Elle est probablement en état de choc."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:914
translate fr qsttheslavemaster_meeting_last_question_38bcba33:

    # NYX @ sad "Gods only know what that girl's been through."
    NYX @ sad "Seuls les dieux savent ce que cette fille a traversé."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:915
translate fr qsttheslavemaster_meeting_last_question_98d7a4f0:

    # "Captain Nyx shuddered at the thought."
    "Capitaine Nyx frissonna à cette pensée."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:916
translate fr qsttheslavemaster_meeting_last_question_97f601ec:

    # NYX @ talk "Anyway, you best clear off before some of the others get here."
    NYX @ talk "Bref, tu ferais mieux de déguerpir avant que les autres n'arrivent."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:919
translate fr qsttheslavemaster_meeting_last_question_fbf5b82d:

    # "Neither of us moved for a moment, staring awkwardly at each other as we finally had a moment to process everything that had just happened."
    "Nous n'avons ni l'un ni l'autre bougé pendant un moment, nous regardant avec gêne alors que nous avions enfin le temps de digérer tout ce qui venait de se passer."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:920
translate fr qsttheslavemaster_meeting_last_question_05a95dae:

    # NYX @ blush "W-What are you are you looking at me like that for?"
    NYX @ blush "P-Pourquoi... pourquoi tu me regardes comme ça ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:921
translate fr qsttheslavemaster_meeting_last_question_3c65a21b:

    # "I gently reached out to grab Nyx's arm."
    "J'ai doucement tendu la main pour saisir le bras de Nyx."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:923
translate fr qsttheslavemaster_meeting_last_question_7a392d43:

    # MC @ talk "Don't you think we should maybe talk about what just happened in there?"
    MC @ talk "Tu ne crois pas qu'on devrait peut-être parler de ce qui vient de se passer là-dedans ?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:927
translate fr qsttheslavemaster_meeting_last_question_53c5f9c0:

    # "Nyx slapped my hand away."
    "Nyx a repoussé ma main d'une claque."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:928
translate fr qsttheslavemaster_meeting_last_question_76a7df00:

    # NYX @ angry "There's nothing to talk about!"
    NYX @ angry "Il n'y a rien à dire !"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:929
translate fr qsttheslavemaster_meeting_last_question_6fb2e182:

    # NYX @ angry "Everything that happened, happened for the mission! That's all!"
    NYX @ angry "Tout ce qui s'est passé, c'était pour la mission ! C'est tout !"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:930
translate fr qsttheslavemaster_meeting_last_question_76abe274:

