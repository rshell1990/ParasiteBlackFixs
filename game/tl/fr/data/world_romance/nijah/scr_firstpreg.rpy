# game/data/world_romance/nijah/scr_firstpreg.rpy:8
translate fr preg_Nijah_goodNews_intro_88e7e95f:

    # "As I entered her home, Nijah came to me with hands clasped, nervous."
    "Lorsque je suis entré chez elle, Nijah est venue vers moi les mains jointes, nerveuse."

# game/data/world_romance/nijah/scr_firstpreg.rpy:9
translate fr preg_Nijah_goodNews_intro_1fa9f7ad:

    # NIJAH "Must speak with you."
    NIJAH "Je dois te parler."

# game/data/world_romance/nijah/scr_firstpreg.rpy:10
translate fr preg_Nijah_goodNews_intro_b7dc45a3:

    # "Sensing her distress, I placed my hands on her shoulders."
    "Sentant sa détresse, j'ai posé mes mains sur ses épaules."

# game/data/world_romance/nijah/scr_firstpreg.rpy:11
translate fr preg_Nijah_goodNews_intro_89f5ce92:

    # MC @ talk "Nijah, what’s wrong?"
    MC @ talk "Nijah, qu'est-ce qui ne va pas ?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:12
translate fr preg_Nijah_goodNews_intro_82be8c65:

    # NIJAH "I... I carry your child."
    NIJAH "Je... je porte ton enfant."

# game/data/world_romance/nijah/scr_firstpreg.rpy:13
translate fr preg_Nijah_goodNews_intro_f3a940fc:

    # "I pulled back, surprised at the comment."
    "J'ai reculé, surpris par cette déclaration."

# game/data/world_romance/nijah/scr_firstpreg.rpy:14
translate fr preg_Nijah_goodNews_intro_4f601cd6:

    # MC @ talk "...{i}You’re pregnant?{/i}"
    MC @ talk "...{i}Tu es enceinte ?{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:15
translate fr preg_Nijah_goodNews_intro_a5178513:

    # "Nijah sheepishly nodded."
    "Nijah hocha la tête timidement."

# game/data/world_romance/nijah/scr_firstpreg.rpy:16
translate fr preg_Nijah_goodNews_intro_9a450cee:

    # NIJAH "...Zis not problem?"
    NIJAH "...Ce n'est pas un problème ?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:17
translate fr preg_Nijah_goodNews_intro_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "Qu'est-ce que tu veux dire ?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:18
translate fr preg_Nijah_goodNews_intro_12df316d:

    # NIJAH "M-any Alderian men... They get Ramonian girls with child and go."
    NIJAH "B-beaucoup d'hommes aldériens... Ils mettent les filles ramoniennes enceintes et s'en vont."

# game/data/world_romance/nijah/scr_firstpreg.rpy:19
translate fr preg_Nijah_goodNews_intro_75857ca2:

    # NIJAH "...many forced to get rid of child while still in womb."
    NIJAH "...beaucoup forcées à se débarrasser de l'enfant encore dans l'utérus."

# game/data/world_romance/nijah/scr_firstpreg.rpy:20
translate fr preg_Nijah_goodNews_intro_5df92709:

    # NIJAH "But... I want to keep your child."
    NIJAH "Mais... je veux garder ton enfant."

# game/data/world_romance/nijah/scr_firstpreg.rpy:21
translate fr preg_Nijah_goodNews_intro_ff1bdef9:

    # BLACK "She is fit to carry many of our young."
    BLACK "Elle est apte à porter beaucoup de nos petits."

# game/data/world_romance/nijah/scr_firstpreg.rpy:22
translate fr preg_Nijah_goodNews_intro_d75d061d:

    # BLACK "We should keep this one close as a mate."
    BLACK "Nous devrions garder celle-ci près de nous comme compagne."

# game/data/world_romance/nijah/scr_firstpreg.rpy:23
translate fr preg_Nijah_goodNews_intro_2cebcdc8:

    # MC @ talk "...Nijah, I-"
    MC @ talk "...Nijah, je-"

# game/data/world_romance/nijah/scr_firstpreg.rpy:24
translate fr preg_Nijah_goodNews_intro_2cb4cedf:

    # NIJAH "I do not care if child can change into monster like you."
    NIJAH "Je m'en fiche que l'enfant puisse se transformer en monstre comme toi."

# game/data/world_romance/nijah/scr_firstpreg.rpy:25
translate fr preg_Nijah_goodNews_intro_ac59f889:

    # NIJAH "It is {i}our{/i} baby, and that is good enough for me."
    NIJAH "C'est {i}notre{/i} bébé, et cela me suffit."

# game/data/world_romance/nijah/scr_firstpreg.rpy:26
translate fr preg_Nijah_goodNews_intro_a51e43f2:

    # "Nijah seemed to wait anxiously for a few moments. Almost stand-offish, perhaps expecting me to tell her to get rid of the child or that I didn’t want to see her anymore."
    "Nijah semblait attendre avec anxiété pendant quelques instants. Presque distante, s'attendant peut-être à ce que je lui dise de se débarrasser de l'enfant ou que je ne voulais plus la voir."

# game/data/world_romance/nijah/scr_firstpreg.rpy:27
translate fr preg_Nijah_goodNews_intro_abd548b8:

    # MC @ talk "Nijah... {i}You are mine.{/i}"
    MC @ talk "Nijah... {i}Tu es mienne.{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:28
translate fr preg_Nijah_goodNews_intro_e7158e0a:

    # MC @ talk "I am pleased you carry my child."
    MC @ talk "Je suis heureux que tu portes mon enfant."

# game/data/world_romance/nijah/scr_firstpreg.rpy:29
translate fr preg_Nijah_goodNews_intro_d62be6ae:

    # "Nijah’s eyes seemed to light up."
    "Les yeux de Nijah semblaient s'illuminer."

# game/data/world_romance/nijah/scr_firstpreg.rpy:30
translate fr preg_Nijah_goodNews_intro_84ee69e2:

    # NIJAH "R-Really?"
    NIJAH "V-Vraiment ?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:31
translate fr preg_Nijah_goodNews_intro_78ec95d9:

    # "With a bright smile, Nijah flung herself onto me, planting kiss onto my lips."
    "Avec un sourire radieux, Nijah se jeta sur moi, posant un baiser sur mes lèvres."

# game/data/world_romance/nijah/scr_firstpreg.rpy:32
translate fr preg_Nijah_goodNews_intro_6bcb1c75:

    # NIJAH "M-Master... I love you so much!"
    NIJAH "M-Maître... je t'aime tellement !"

# game/data/world_romance/nijah/scr_firstpreg.rpy:33
translate fr preg_Nijah_goodNews_intro_cb9042a3:

    # MC @ talk "Nijah, you know you don’t need to-"
    MC @ talk "Nijah, tu sais que tu n'as pas besoin de-"

# game/data/world_romance/nijah/scr_firstpreg.rpy:34
translate fr preg_Nijah_goodNews_intro_436f3b45:

    # "Nijah interrupted me again mid-sentence to plant another kiss on my lips."
    "Nijah m'interrompit de nouveau en pleine phrase pour déposer un autre baiser sur mes lèvres."

# game/data/world_romance/nijah/scr_firstpreg.rpy:35
translate fr preg_Nijah_goodNews_intro_0a0c7479:

    # NIJAH "I shall get some dinner on, stay a while."
    NIJAH "Je vais préparer le dîner, reste un moment."

# game/data/world_romance/nijah/scr_firstpreg.rpy:36
translate fr preg_Nijah_goodNews_intro_2eb2dd4a:

    # "With that, Nijah turned, humming happily to herself as she made her way to the kitchen to prepare some food."
    "Sur ce, Nijah se retourna, fredonnant joyeusement pour elle-même en se dirigeant vers la cuisine pour préparer à manger."

# game/data/world_romance/nijah/scr_firstpreg.rpy:41
translate fr preg_Nijah_goodNews_intro_6c38b146:

    # "After eating with Nijah, I departed once again, thinking about my soon to be new-born child I was now having with Nijah."
    "Après avoir mangé avec Nijah, je repartis une fois de plus, pensant à l'enfant à naître que j'attendais maintenant avec Nijah."

