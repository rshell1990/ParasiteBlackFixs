    MC @ talk "Eh bien, de combien as-tu besoin ?"

# game/data/world_romance/nijah/scr_future.rpy:16
translate fr rom_Nijah_stage1_future_lines_e049698d:

    # NIJAH "Enough for stall... Plus ingredients and cooking equipment..."
    NIJAH "Assez pour un stand... Plus les ingrédients et l'équipement de cuisine..."

# game/data/world_romance/nijah/scr_future.rpy:17
