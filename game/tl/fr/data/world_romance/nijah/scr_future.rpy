translate fr rom_Nijah_stage1_future_lines_806b841b:

    # "(That’s quite a lot.)"
    "(C'est vraiment beaucoup.)"

# game/data/world_romance/nijah/scr_future.rpy:19
translate fr rom_Nijah_stage1_future_lines_8c4ad5bf:

    # "(What should I encourage her to do?)"
    "(Que devrais-je l'encourager à faire ?)"

# game/data/world_romance/nijah/scr_future.rpy:22
translate fr rom_Nijah_stage1_future_lines_menu_02182bf6:

    # NIJAH @ happy "...!"
    NIJAH @ happy "...!"

# game/data/world_romance/nijah/scr_future.rpy:23
translate fr rom_Nijah_stage1_future_lines_menu_d82da894:

    # NIJAH @ smile "You will?"
    NIJAH @ smile "Tu le feras ?"

# game/data/world_romance/nijah/scr_future.rpy:24
translate fr rom_Nijah_stage1_future_lines_menu_9f0aa4e9:

    # NIJAH @ smile "A thousand gold?"
    NIJAH @ smile "Mille pièces d'or ?"

# game/data/world_romance/nijah/scr_future.rpy:25
translate fr rom_Nijah_stage1_future_lines_menu_d58cad19:

    # NIJAH "I... I cannot ask you to do zis!"
    NIJAH "Je... Je ne peux pas te demander de faire ça !"

# game/data/world_romance/nijah/scr_future.rpy:30
translate fr rom_Nijah_stage1_future_lines_menu_97fa787e:

    # NIJAH "Zis is..."
    NIJAH "C'est..."

# game/data/world_romance/nijah/scr_future.rpy:31
translate fr rom_Nijah_stage1_future_lines_menu_cdf45d1e:

    # "Nijah started to cry"
    "Nijah se mit à pleurer"

# game/data/world_romance/nijah/scr_future.rpy:32
translate fr rom_Nijah_stage1_future_lines_menu_04f17e1e:

    # NIJAH @ sad "... You haz done too much for me."
    NIJAH @ sad "... Tu en as déjà trop fait pour moi."

# game/data/world_romance/nijah/scr_future.rpy:34
translate fr rom_Nijah_stage1_future_lines_menu_a6b98d5f:

    # "Nijah hurried forward, wrapping her arms around me in a tight hug, when she pulled back, she smiled warmly, tears streaming down her cheeks in joy."
    "Nijah s'avança précipitamment, m'enlaçant dans une étreinte serrée. Lorsqu'elle s'écarta, elle sourit chaleureusement, des larmes de joie ruisselant sur ses joues."

# game/data/world_romance/nijah/scr_future.rpy:38
translate fr rom_Nijah_stage1_future_lines_menu_a997409b:

    # NIJAH "Alright... I trust you... I shall wait for you."
    NIJAH "D'accord... Je te fais confiance... Je t'attendrai."

# game/data/world_romance/nijah/scr_future.rpy:42
translate fr rom_Nijah_stage1_future_lines_menu_b41866ee:

    # NIJAH "You... Vat?"
    NIJAH "Toi... Quoi ?"

# game/data/world_romance/nijah/scr_future.rpy:43
translate fr rom_Nijah_stage1_future_lines_menu_88ce21a9:

    # MC @ talk "I’ll pay for you to have your own room."
    MC @ talk "Je paierai pour que tu aies ta propre chambre."

# game/data/world_romance/nijah/scr_future.rpy:44
translate fr rom_Nijah_stage1_future_lines_menu_ba9be3de:

    # MC @ talk "As a Novaras citizen, I can quickly and legally get the paperwork you need."
    MC @ talk "En tant que citoyen de Novaras, je peux obtenir rapidement et légalement les papiers dont tu as besoin."

# game/data/world_romance/nijah/scr_future.rpy:45
translate fr rom_Nijah_stage1_future_lines_menu_1ef1adfd:

    # MC @ talk "I can also guarantee you have some protection that before you was not privy to."
    MC @ talk "Je peux aussi garantir que tu as une protection à laquelle tu n'avais pas accès auparavant."

# game/data/world_romance/nijah/scr_future.rpy:46
translate fr rom_Nijah_stage1_future_lines_menu_a4b7cc57:

    # MC "Nijah pondered the thought a moment, hesistant about the idea of returning to her old line of work."
    MC "Nijah réfléchit un instant, hésitante à l'idée de retourner à son ancien métier."

# game/data/world_romance/nijah/scr_future.rpy:47
translate fr rom_Nijah_stage1_future_lines_menu_9cc15501:

    # NIJAH "This... would be better."
    NIJAH "Cela... serait mieux."

# game/data/world_romance/nijah/scr_future.rpy:48
translate fr rom_Nijah_stage1_future_lines_menu_1364cda5:

    # NIJAH "{i}But...{/i}"
    NIJAH "{i}Mais...{/i}"

# game/data/world_romance/nijah/scr_future.rpy:49
translate fr rom_Nijah_stage1_future_lines_menu_e66bab01:

    # MC "Nijah opened her mouth to protest, but instead, her eyes simply dropped to the floor as she reached and grabbed at her other arm anxiously."
    MC "Nijah ouvrit la bouche pour protester, mais à la place, ses yeux se baissèrent simplement vers le sol tandis qu'elle tendait la main et agrippait son autre bras avec anxiété."

# game/data/world_romance/nijah/scr_future.rpy:50
translate fr rom_Nijah_stage1_future_lines_menu_6f13d691:

    # NIJAH "In return, you want share of gold I earn?"
    NIJAH "En échange, tu veux une part de l'or que je gagne ?"

# game/data/world_romance/nijah/scr_future.rpy:51
translate fr rom_Nijah_stage1_future_lines_menu_83589d81:

    # MC @ talk "I do."
    MC @ talk "Oui."

# game/data/world_romance/nijah/scr_future.rpy:52
translate fr rom_Nijah_stage1_future_lines_menu_79b06185:

    # NIJAH "... Thirty percent?"
    NIJAH "... Trente pour cent ?"

# game/data/world_romance/nijah/scr_future.rpy:55
translate fr rom_Nijah_stage1_future_lines_menu_568c2bf8:

    # MC @ talk "Yeah, that's a deal."
    MC @ talk "Ouais, marché conclu."

# game/data/world_romance/nijah/scr_future.rpy:58
translate fr rom_Nijah_stage1_future_lines_menu_991a9c2d:

    # NIJAH "Alright... I suppose after all you have done zis iz fair..."
    NIJAH "D'accord... Je suppose qu'après tout ce que tu as fait, z'est juste..."

# game/data/world_romance/nijah/scr_future.rpy:59
translate fr rom_Nijah_stage1_future_lines_menu_25a09a38:

    # NIJAH "I come with you to speak to men in charge of district..."
    NIJAH "Je viens avec toi pour parler aux hommes en charge du quartier..."

# game/data/world_romance/nijah/scr_future.rpy:62
translate fr rom_Nijah_stage1_future_lines_menu_ded37cfe:

    # "Following Nijah down to the District, she introduced me to one of the officials there, a tall and uninspiring rake of a man who sat down in one of the few ‘offices’ littered around the District that the girls use when they want to lodge complaints."
    "En suivant Nijah jusqu'au Quartier, elle m'a présenté à l'un des responsables, un grand homme décharné et peu inspirant qui s'est assis dans l'un des rares « bureaux » disséminés dans le Quartier que les filles utilisent lorsqu'elles veulent déposer des plaintes."

# game/data/world_romance/nijah/scr_future.rpy:63
translate fr rom_Nijah_stage1_future_lines_menu_620526a0:

    # "When I showed him my gold, it didn’t exactly take long to have the right paperwork and such in place. In just a few hours, we were set to go..."
    "Quand je lui ai montré mon or, ça n'a pas vraiment pris longtemps pour mettre en place les papiers nécessaires et tout le reste. En quelques heures, nous étions prêts à partir..."

# game/data/world_romance/nijah/scr_future.rpy:64
translate fr rom_Nijah_stage1_future_lines_menu_59f434a3:

    # "Nijah had her own room, and it was known to all that she was a protected girl now."
    "Nijah avait sa propre chambre, et tout le monde savait qu'elle était maintenant une fille protégée."

# game/data/world_romance/nijah/scr_future.rpy:71
translate fr rom_Nijah_stage1_future_lines_menu_8f0508e3:

    # NIJAH "Zat was... very quick."
    NIJAH "C'était... très rapide."

# game/data/world_romance/nijah/scr_future.rpy:72
translate fr rom_Nijah_stage1_future_lines_menu_a8cbf7ee:

    # NIJAH "It would take a Ramonian like me weeks to get anywhere with them."
    NIJAH "Ça prendrait des semaines à un Ramonian comme moi pour obtenir quoi que ce soit d'eux."

# game/data/world_romance/nijah/scr_future.rpy:73
translate fr rom_Nijah_stage1_future_lines_menu_5f7e87c5:

    # MC @ talk "Being a citizen has its benefits."
    MC @ talk "Être citoyen a ses avantages."

# game/data/world_romance/nijah/scr_future.rpy:74
translate fr rom_Nijah_stage1_future_lines_menu_7e9393ab:

    # NIJAH "I suppose I better get back to za work... Stop by to collect your money once a fortnight."
    NIJAH "Je suppose que je ferais mieux de retourner au travail... Passe récupérer ton argent toutes les deux semaines."

# game/data/world_romance/nijah/scr_future.rpy:75
translate fr rom_Nijah_stage1_future_lines_menu_e35850f4:

    # MC @ talk "Let me know if there are any problems, remember, you are protected by me now."
    MC @ talk "Fais-moi savoir s'il y a des problèmes, souviens-toi, tu es protégée par moi maintenant."

# game/data/world_romance/nijah/scr_future.rpy:76
translate fr rom_Nijah_stage1_future_lines_menu_518f3315:

    # MC @ talk "I will see to it that no harm comes to you."
    MC @ talk "Je ferai en sorte qu'aucun mal ne t'arrive."

# game/data/world_romance/nijah/scr_future.rpy:77
translate fr rom_Nijah_stage1_future_lines_menu_4e16aac8:

    # "Nijah smiled unconvincingly, but nodded anyway."
    "Nijah sourit de manière peu convaincante, mais hocha la tête quand même."

# game/data/world_romance/nijah/scr_future.rpy:78
translate fr rom_Nijah_stage1_future_lines_menu_7b19a276:

    # NIJAH "T-Thank you... Now if you excuse me, I should get ready."
    NIJAH "M-Merci... Maintenant, si tu veux bien m'excuser, je dois me préparer."

# game/data/world_romance/nijah/scr_future.rpy:79
translate fr rom_Nijah_stage1_future_lines_menu_10f6a25a:

    # MC "I watched as Nijah headed off, no doubt to prepare for her {i}'clients'{/i}"
    MC "Je regardai Nijah s'éloigner, sans doute pour se préparer pour ses {i}'clients'{/i}"

# game/data/world_romance/nijah/scr_future.rpy:81
translate fr rom_Nijah_stage1_future_lines_menu_49528545:

    # "And just like that, Nijah returned to her old work... A part of me wondered if I’d made the right choice, if perhaps, Nijah wanted and deserved better than this life?"
    "Et comme ça, Nijah retourna à son ancien travail... Une partie de moi se demandait si j'avais fait le bon choix, si peut-être, Nijah voulait et méritait mieux que cette vie ?"

# game/data/world_romance/nijah/scr_future.rpy:82
translate fr rom_Nijah_stage1_future_lines_menu_da7e2faa:

    # "But, as I reminded myself, she was now safer than before... And my pockets were going to get a lot heavier. Morality aside, maybe this was for the best."
    "Mais, comme je me le rappelais, elle était maintenant plus en sécurité qu'avant... Et mes poches allaient devenir beaucoup plus lourdes. Morale mise à part, c'était peut-être pour le mieux."

