translate fr rom_Nijah_stage1_future_lines_a41c5243:

    # NIJAH "Food quick, tasty for people to eat while on go..."
    NIJAH "Une nourriture rapide et savoureuse, à consommer sur le pouce..."

# game/data/world_romance/nijah/scr_future.rpy:14
translate fr rom_Nijah_stage1_future_lines_9e9890a6:

    # MC @ smile "Ha-ha! You're full of surprises..."
    MC @ smile "Ha-ha ! Tu es pleine de surprises..."

