# game/data/world_romance/thea/rom_thea_scr.rpy:3
translate fr rom_thea_invite_335cb5c3:

    # THEA @ smile "... Would you be interested perhaps in buying me a drink this evening?"
    THEA @ smile "... Serais-tu peut-être intéressé à m'offrir un verre ce soir ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:4
translate fr rom_thea_invite_0cfc087b:

    # MC @ smile "What's brought this on?"
    MC @ smile "Qu'est-ce qui t'amène ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:5
translate fr rom_thea_invite_caddc8f2:

    # THEA @ blush "I've been watching you ... You're already C-tier so fast, normally, it would take adventurers weeks or even months to get where you are."
    THEA @ blush "Je t'observe depuis un moment... Tu es déjà de rang C si rapidement ; normalement, il faudrait des semaines, voire des mois aux aventuriers pour arriver là où tu en es."

# game/data/world_romance/thea/rom_thea_scr.rpy:6
translate fr rom_thea_invite_5b9971e5:

    # THEA @ blush "I suppose I want to see what's so special."
    THEA @ blush "Je suppose que je veux voir ce qui est si spécial."

# game/data/world_romance/thea/rom_thea_scr.rpy:9
translate fr rom_thea_invite_8737dc3f:

    # THEA @ blush "I would like that."
    THEA @ blush "J'aimerais bien ça."

# game/data/world_romance/thea/rom_thea_scr.rpy:10
translate fr rom_thea_invite_488d699c:

    # THEA @ smile "I'll be waiting for you there ..."
    THEA @ smile "Je t'attendrai là-bas..."

# game/data/world_romance/thea/rom_thea_scr.rpy:16
translate fr rom_thea_invite_aeabb3e0:

    # THEA @ talk "I-"
    THEA @ talk "Je-"

# game/data/world_romance/thea/rom_thea_scr.rpy:17
translate fr rom_thea_invite_51503df8:

    # THEA @ talk "Very well, let me know when you're more free, perhaps."
    THEA @ talk "Très bien, fais-moi savoir quand tu seras plus libre, peut-être."

# game/data/world_romance/thea/rom_thea_scr.rpy:23
translate fr rom_thea_unicorn_12d98976:

    # MC "(I shouldn't bother her anymore tonight.)"
    MC "(Je ne devrais plus la déranger ce soir.)"

# game/data/world_romance/thea/rom_thea_scr.rpy:30
translate fr rom_thea_unicorn_3345d6b7:

    # "When Thea saw me from across the room, she smiled and waved, coaxing me over."
    "Quand Thea m'aperçut de l'autre côté de la pièce, elle sourit et me fit signe, m'invitant à la rejoindre."

# game/data/world_romance/thea/rom_thea_scr.rpy:31
translate fr rom_thea_unicorn_8a756982:

    # THEA @ talk "So glad you could make it."
    THEA @ talk "Ravi que tu aies pu venir."

# game/data/world_romance/thea/rom_thea_scr.rpy:32
translate fr rom_thea_unicorn_fc4b9d6f:

    # THEA @ smile "Come, join me for a while ..."
    THEA @ smile "Viens, rejoins-moi un instant ..."

# game/data/world_romance/thea/rom_thea_scr.rpy:36
translate fr rom_thea_unicorn_menu1_7429efc5:

    # THEA @ smile2 "Mmm, eager to spend all that coin you've earned adventuring, are you?"
    THEA @ smile2 "Mmm, impatiente de dépenser tout cet argent que tu as gagné en aventurant, n'est-ce pas ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:37
translate fr rom_thea_unicorn_menu1_432f2bae:

    # THEA @ smile "There's a nice wine bottle I've been eyeing up, {i}'Huville Cépage'{/i}"
    THEA @ smile "Il y a une belle bouteille de vin que je lorgne, {i}'Huville Cépage'{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:38
translate fr rom_thea_unicorn_menu1_2eadc668:

    # THEA @ talk "What do you say we share it?"
    THEA @ talk "Qu'en dis-tu, on la partage ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:45
translate fr rom_thea_unicorn_menu2_c07e4cd5:

    # THEA @ smile2 "Oooh!"
    THEA @ smile2 "Oooh !"

# game/data/world_romance/thea/rom_thea_scr.rpy:46
translate fr rom_thea_unicorn_menu2_c94f142b:

    # "I ordered for the bottle to be fetched, placing the small pouch of coins in Shay's hand as she grabbed it for us."
    "J'ai commandé qu'on aille chercher la bouteille, plaçant la petite bourse de pièces dans la main de Shay pendant qu'elle l'attrapait pour nous."

# game/data/world_romance/thea/rom_thea_scr.rpy:47
translate fr rom_thea_unicorn_menu2_7eaabd57:

    # THEA @ smile "Cheers!"
    THEA @ smile "Santé !"

# game/data/world_romance/thea/rom_thea_scr.rpy:48
translate fr rom_thea_unicorn_menu2_ce8ed3e8:

    # MC @ talk "So then, how does a girl like you end up running the Adventures Guild in Novaras?"
    MC @ talk "Alors, comment une fille comme toi se retrouve-t-elle à diriger la Guilde des Aventuriers à Novaras ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:49
translate fr rom_thea_unicorn_menu2_8f95d09a:

    # THEA @ smile "Ahh ... good question!"
    THEA @ smile "Ahh ... bonne question !"

# game/data/world_romance/thea/rom_thea_scr.rpy:50
translate fr rom_thea_unicorn_menu2_9f46be7b:

    # THEA @ talk "My parents travelled to Alderay to settle when I was very young."
    THEA @ talk "Mes parents ont voyagé à Alderay pour s'y installer quand j'étais très jeune."

# game/data/world_romance/thea/rom_thea_scr.rpy:51
translate fr rom_thea_unicorn_menu2_e416d7df:

    # THEA @ talk "Back then, Alderay was welcoming skilled businesses and migrants, and the old owner of the guild house here was ready to retire."
    THEA @ talk "À l'époque, Alderay accueillait les entreprises qualifiées et les migrants, et l'ancien propriétaire de la maison de guilde ici était prêt à prendre sa retraite."

# game/data/world_romance/thea/rom_thea_scr.rpy:52
translate fr rom_thea_unicorn_menu2_b6c617a0:

    # THEA @ talk "So, we bought it off them, and the rest is history."
    THEA @ talk "Donc, nous la leur avons achetée, et le reste fait partie de l'histoire."

# game/data/world_romance/thea/rom_thea_scr.rpy:53
translate fr rom_thea_unicorn_menu2_ac230468:

    # MC @ talk "Where did you come from originally?"
    MC @ talk "D'où viens-tu à l'origine ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:54
translate fr rom_thea_unicorn_menu2_eb131af5:

    # THEA @ talk "Ah, my family comes from Ramon."
    THEA @ talk "Ah, ma famille vient de Ramon."

# game/data/world_romance/thea/rom_thea_scr.rpy:55
translate fr rom_thea_unicorn_menu2_12edaa55:

    # MC @ surprised "Ramon? But, you're-"
    MC @ surprised "Ramon ? Mais, tu es-"

# game/data/world_romance/thea/rom_thea_scr.rpy:56
translate fr rom_thea_unicorn_menu2_7b41d1ba:

    # "I stopped myself from prodding too deeply, but Thea just smiled."
    "Je me suis arrêté de poser trop de questions, mais Thea a simplement souri."

# game/data/world_romance/thea/rom_thea_scr.rpy:57
translate fr rom_thea_unicorn_menu2_44532423:

    # THEA @ smile "It's fine, people always ask about my complexion."
    THEA @ smile "C'est bon, les gens demandent toujours à propos de mon teint."

# game/data/world_romance/thea/rom_thea_scr.rpy:58
translate fr rom_thea_unicorn_menu2_4808f1cb:

    # THEA @ talk "You see, we all come from Ramon, but my people, the Khashan, come from the eastern side of the Darjan desert."
    THEA @ talk "Tu vois, nous venons tous de Ramon, mais mon peuple, les Khashan, vient du côté est du désert de Darjan."

# game/data/world_romance/thea/rom_thea_scr.rpy:59
translate fr rom_thea_unicorn_menu2_8cc07133:

    # THEA @ talk "The first of us travelled to Alderay to avoid the many hardships of the land."
    THEA @ talk "Les premiers d'entre nous ont voyagé à Alderay pour éviter les nombreuses difficultés de la terre."

# game/data/world_romance/thea/rom_thea_scr.rpy:60
translate fr rom_thea_unicorn_menu2_f57c063a:

    # THEA @ talk "Unlike the West and South-Lands, the East of Ramon is a hard place to live ... Nothing truly grows beneath the scorched sun."
    THEA @ talk "Contrairement aux Terres de l'Ouest et du Sud, l'Est de Ramon est un endroit difficile à vivre... Rien ne pousse vraiment sous le soleil brûlant."

# game/data/world_romance/thea/rom_thea_scr.rpy:65
translate fr rom_thea_unicorn_menu3_4b1f9620:

    # THEA @ talk "Hmm ... I miss the Darjan mountains, they stretched as far as the eye could see."
    THEA @ talk "Hmm... Les montagnes Darjan me manquent, elles s'étendaient à perte de vue."

# game/data/world_romance/thea/rom_thea_scr.rpy:66
translate fr rom_thea_unicorn_menu3_8fe065a0:

    # THEA @ talk "As barren and brutal a place as it was to live, it was quite beautiful."
    THEA @ talk "Aussi aride et brutal que cet endroit était pour y vivre, il était plutôt beau."

# game/data/world_romance/thea/rom_thea_scr.rpy:72
translate fr rom_thea_unicorn_menu3_3dfa0b6a:

    # THEA @ angry "What's there to say? They're a greedy, ungrateful bunch."
    THEA @ angry "Qu'y a-t-il à dire ? Ce sont des gens cupides et ingrats."

# game/data/world_romance/thea/rom_thea_scr.rpy:73
translate fr rom_thea_unicorn_menu3_8742f5fd:

    # MC @ talk "That's ... surprising to hear."
    MC @ talk "C'est... surprenant à entendre."

# game/data/world_romance/thea/rom_thea_scr.rpy:74
translate fr rom_thea_unicorn_menu3_93fcdb03:

    # THEA @ sad "Sorry, Ramonian politics is a difficult thing."
    THEA @ sad "Désolé, la politique ramonienne est une chose difficile."

# game/data/world_romance/thea/rom_thea_scr.rpy:75
translate fr rom_thea_unicorn_menu3_06c01088:

    # THEA @ angry "Let's just say there are reasons we headed to Alderay and didn't just join our cousins in the West."
    THEA @ angry "Disons simplement qu'il y a des raisons pour lesquelles nous sommes allés à Alderay et n'avons pas simplement rejoint nos cousins à l'Ouest."

# game/data/world_romance/thea/rom_thea_scr.rpy:76
translate fr rom_thea_unicorn_menu3_b488a395:

    # THEA @ angry "They spent years being the oppressors, and now expect sympathy when they wouldn't shed a tear for the rest of us."
    THEA @ angry "Ils ont passé des années à être les oppresseurs, et maintenant ils attendent de la sympathie alors qu'ils ne verseraient pas une larme pour nous autres."

# game/data/world_romance/thea/rom_thea_scr.rpy:82
translate fr rom_thea_unicorn_menu3_dc53db05:

    # THEA @ smile "Ahh, it was ... different!"
    THEA @ smile "Ahh, c'était... différent !"

# game/data/world_romance/thea/rom_thea_scr.rpy:83
translate fr rom_thea_unicorn_menu3_ce050630:

    # THEA @ talk "I grew up watching adventurers come and go."
    THEA @ talk "J'ai grandi en regardant les aventuriers aller et venir."

# game/data/world_romance/thea/rom_thea_scr.rpy:84
translate fr rom_thea_unicorn_menu3_c48d55de:

    # THEA @ smile "I quickly learned to pick up which ones I thought had a chance of climbing the ranks, and I usually got pretty good predicting where their limit would be."
    THEA @ smile "J'ai vite appris à repérer ceux qui, selon moi, avaient une chance de gravir les échelons, et j'étais généralement assez bon pour prédire où se situerait leur limite."

# game/data/world_romance/thea/rom_thea_scr.rpy:91
translate fr rom_thea_unicorn_menu3_3328c8e0:

    # THEA @ smile "Where's the fun in telling you that?"
    THEA @ smile "Quel plaisir y a-t-il à te le dire ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:92
translate fr rom_thea_unicorn_menu3_d535c815:

    # THEA @ smile2 "{i}... Surprise me.{/i}"
    THEA @ smile2 "{i}... Surprends-moi.{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:95
translate fr rom_thea_unicorn_menu3_14af6c46:

    # THEA @ talk "Quite a few."
    THEA @ talk "Pas mal."

# game/data/world_romance/thea/rom_thea_scr.rpy:96
translate fr rom_thea_unicorn_menu3_96fa62ee:

    # THEA @ talk "Lohan the Great, Marhaka {i}'the silver arrow.'{/i}"
    THEA @ talk "Lohan le Grand, Marhaka {i}'la flèche d'argent.'{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:97
translate fr rom_thea_unicorn_menu3_9561e086:

    # THEA @ sad "But that was all when I was still little."
    THEA @ sad "Mais tout ça, c'était quand j'étais encore petit."

# game/data/world_romance/thea/rom_thea_scr.rpy:98
translate fr rom_thea_unicorn_menu3_0679a78b:

    # THEA @ talk "There aren't really many names left who'd I'd think qualify as legendary these days."
    THEA @ talk "Il n'y a vraiment plus beaucoup de noms qui, selon moi, méritent le qualificatif de légendaire de nos jours."

# game/data/world_romance/thea/rom_thea_scr.rpy:99
translate fr rom_thea_unicorn_menu3_13f5176a:

    # MC @ talk "What about Celeste?"
    MC @ talk "Et Celeste ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:100
translate fr rom_thea_unicorn_menu3_82af972f:

    # THEA @ sad "I-"
    THEA @ sad "Je-"

# game/data/world_romance/thea/rom_thea_scr.rpy:101
translate fr rom_thea_unicorn_menu3_f59122f5:

    # THEA @ sad "There's something about her I don't like ... But I can't put my finger on why."
    THEA @ sad "Il y a quelque chose chez elle que je n'aime pas... Mais je n'arrive pas à mettre le doigt sur quoi."

# game/data/world_romance/thea/rom_thea_scr.rpy:104
translate fr rom_thea_unicorn_menu3_bccad9a6:

    # MC @ smile "So, why did you only agree to meet with me now?"
    MC @ smile "Alors, pourquoi as-tu accepté de me rencontrer seulement maintenant ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:105
translate fr rom_thea_unicorn_menu3_612151ad:

    # "Thea smiled, twirling her hair."
    "Thea sourit, enroulant ses cheveux."

# game/data/world_romance/thea/rom_thea_scr.rpy:106
translate fr rom_thea_unicorn_menu3_cef13fe0:

    # THEA @ smile "Well ... You see, the thing is."
    THEA @ smile "Eh bien... Tu vois, le truc, c'est que..."

# game/data/world_romance/thea/rom_thea_scr.rpy:107
translate fr rom_thea_unicorn_menu3_fcd2fdda:

    # THEA @ smile "I usually spent my time growing up watching adventurers flirt with my mother, and I guess it kinda rubbed off on me."
    THEA @ smile "En grandissant, je passais mon temps à regarder des aventuriers flirter avec ma mère, et je suppose que ça a un peu déteint sur moi."

# game/data/world_romance/thea/rom_thea_scr.rpy:108
translate fr rom_thea_unicorn_menu3_40e310f1:

    # MC @ talk "What about your father, though? He couldn't have liked that."
    MC @ talk "Et ton père, alors ? Il n'a pas dû apprécier ça."

# game/data/world_romance/thea/rom_thea_scr.rpy:109
translate fr rom_thea_unicorn_menu3_8ff3ce86:

    # THEA @ talk "There wasn't a lot he could do, besides, Mother was just flirting to buy a few more rounds between quests."
    THEA @ talk "Il n'y avait pas grand-chose qu'il pouvait faire, et puis, Mère flirtait juste pour s'offrir quelques tournées supplémentaires entre les quêtes."

# game/data/world_romance/thea/rom_thea_scr.rpy:110
translate fr rom_thea_unicorn_menu3_d0c386b6:

    # THEA @ blush "T-Though sometimes the adventurers did get a little 'handsy' with her, I suppose."
    THEA @ blush "B-Bien que parfois les aventuriers avaient les mains un peu baladeuses avec elle, je suppose."

# game/data/world_romance/thea/rom_thea_scr.rpy:111
translate fr rom_thea_unicorn_menu3_40b97817:

    # THEA @ smile "But I'm sure she never let it go too far!"
    THEA @ smile "Mais je suis sûre qu'elle n'a jamais laissé les choses aller trop loin !"

# game/data/world_romance/thea/rom_thea_scr.rpy:112
translate fr rom_thea_unicorn_menu3_55848778:

    # MC "(I think I'm beginning to see where this fetish of hers has come from)."
    MC "(Je crois que je commence à voir d'où vient ce fétichisme chez elle.)"

# game/data/world_romance/thea/rom_thea_scr.rpy:113
translate fr rom_thea_unicorn_menu3_79def2ed:

    # THEA @ smile2 "So, how would you like to come back to mine this evening?"
    THEA @ smile2 "Alors, ça te dirait de venir chez moi ce soir ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:114
translate fr rom_thea_unicorn_menu3_78109663:

    # THEA @ blush "I think I might have something to help {i}'motivate'{/i} you on your quests."
    THEA @ blush "Je pense avoir quelque chose pour {i}'motiver'{/i} tes quêtes."

# game/data/world_romance/thea/rom_thea_scr.rpy:117
translate fr rom_thea_unicorn_menu3_7e4761fb:

    # THEA @ smile2 "Follow me."
    THEA @ smile2 "Suis-moi."

# game/data/world_romance/thea/rom_thea_scr.rpy:120
translate fr rom_thea_unicorn_menu3_ffc63a93:

    # THEA @ sad "Oh? Well ... Alright then."
    THEA @ sad "Oh ? Eh bien... D'accord alors."

# game/data/world_romance/thea/rom_thea_scr.rpy:125
translate fr rom_thea_unicorn_menu3_3b8245a4:

    # THEA @ smile "It is."
    THEA @ smile "Ça l'est."

# game/data/world_romance/thea/rom_thea_scr.rpy:126
translate fr rom_thea_unicorn_menu3_31d970ec:

    # THEA @ smile2 "But do you think I'm worth it?"
    THEA @ smile2 "Mais penses-tu que j'en vaille la peine ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:132
translate fr rom_thea_unicorn_menu3_10603dd0:

    # THEA @ sad "{i}*Sigh*{/i}... Never mind then."
    THEA @ sad "{i}*Soupir*{/i}... Laisse tomber, alors."

# game/data/world_romance/thea/rom_thea_scr.rpy:133
translate fr rom_thea_unicorn_menu3_cc5378c3:

    # THEA @ talk "Mmm, don't you think you should at least buy a girl a drink first?"
    THEA @ talk "Mmm, tu ne crois pas que tu devrais au moins m'offrir un verre d'abord ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:134
translate fr rom_thea_unicorn_menu3_db87ce59:

    # THEA @ talk "You should definitely buy me one when you have some more coin... I'd love to hear more of your adventuring tales."
    THEA @ talk "Tu devrais vraiment m'en offrir un quand tu auras plus de pièces... J'adorerais écouter d'autres récits de tes aventures."

# game/data/world_romance/thea/rom_thea_scr.rpy:139
translate fr rom_thea_unicorn_menu3_9a148b52:

    # THEA @ talk "Booo ..."
    THEA @ talk "Bouh..."

# game/data/world_romance/thea/rom_thea_scr.rpy:140
translate fr rom_thea_unicorn_menu3_06d4a6e1:

    # THEA @ smile "Well maybe next time then."
    THEA @ smile "Bon, peut-être la prochaine fois alors."

# game/data/world_romance/thea/rom_thea_scr.rpy:153
translate fr rom_thea_after_date_e86c7592:

    # "Thea led me back towards the Adventurers Guild, but this time, she led me behind the counter up the stairs towards her bedroom."
    "Thea m'a reconduit vers la Guilde des Aventuriers, mais cette fois, elle m'a guidé derrière le comptoir et en haut des escaliers vers sa chambre."

# game/data/world_romance/thea/rom_thea_scr.rpy:159
translate fr rom_thea_after_date_6b744a36:

    # "Into her bedroom, Thea led me, quickly getting the fire going before she twirled around and smiled alluringly."
    "Dans sa chambre, Thea m'a conduit, après avoir rapidement allumé le feu, elle a tournoyé avant de me sourire d'un air séducteur."

# game/data/world_romance/thea/rom_thea_scr.rpy:160
translate fr rom_thea_after_date_cd42ee40:

    # MC @ smile "So then, what was it you wanted to give me?"
    MC @ smile "Alors, qu'est-ce que tu voulais me donner ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:165
translate fr rom_thea_after_date_e56d5240:

    # THEA @ smile "Ah, hello again... I trust you've been busy with all your adventures?"
    THEA @ smile "Ah, rebonjour... Je suppose que tu as été bien occupé avec toutes tes aventures ?"

# game/data/world_romance/thea/rom_thea_scr.rpy:167
translate fr rom_thea_after_date_6917aa30:

    # THEA @ talk "Do you mind waiting here for a moment, this will only take a few minutes."
    THEA @ talk "Ça ne te dérange pas d'attendre ici un moment ? Ça ne prendra que quelques minutes."

# game/data/world_romance/thea/rom_thea_scr.rpy:168
translate fr rom_thea_after_date_a3b52944:

    # MC @ smile "Of course."
    MC @ smile "Bien sûr."

# game/data/world_romance/thea/rom_thea_scr.rpy:170
translate fr rom_thea_after_date_2ecf6da7:

    # "Thea hurried off for a few moments, and after briefly looking around her room, the door swung open, and Thea re-emerged."
    "Thea s'est éclipsée quelques instants, et après avoir brièvement jeté un coup d'œil autour de sa chambre, la porte s'est ouverte brusquement et Thea est réapparue."

# game/data/world_romance/thea/rom_thea_scr.rpy:174
translate fr rom_thea_after_date_42fc426f:

    # THEA @ blush "{i}... Do you think 'this' will help motivate you?{/i}"
    THEA @ blush "{i}... Penses-tu que 'ça' t'aidera à te motiver ?{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:175
translate fr rom_thea_after_date_4c4699f9:

    # MC @ lewd "I'm feeling motivated already."
    MC @ lewd "Je me sens déjà motivé."

# game/data/world_romance/thea/rom_thea_scr.rpy:178
translate fr rom_thea_after_date_9c1a9a0d:

    # "Giggling to herself, Thea stepped forward and pushed me down onto her bed, moving swiftly to strip the clothes off of me."
    "En gloussant toute seule, Thea s'avança et me poussa sur son lit, se dépêchant de me déshabiller."

# game/data/world_romance/thea/rom_thea_scr.rpy:179
translate fr rom_thea_after_date_9fc4282e:

    # THEA "I've been working on a little ... {i}dance{/i} that I want to show you."
    THEA "J'ai travaillé sur une petite ... {i}danse{/i} que je veux te montrer."

# game/data/world_romance/thea/rom_thea_scr.rpy:180
translate fr rom_thea_after_date_a092ffec:

    # THEA "Tell me ... What do you think of what I'm wearing?"
