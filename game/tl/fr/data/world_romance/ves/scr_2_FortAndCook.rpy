# game/data/world_romance/ves/scr_2_FortAndCook.rpy:2
translate fr rom_Ves_2_FortAndCook_Rev_e399c0fc:

    # VES @ talk "Yes, sure!"
    VES @ talk "Oui, bien sûr !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:3
translate fr rom_Ves_2_FortAndCook_Rev_33e02ec9:

    # VES @ talk "I plan to set up some perimeter defences, just some bells and such on a wire that will jingle in case anyone tries to sneak in here."
    VES @ talk "Je compte installer quelques défenses périmétriques, juste des clochettes et autres sur un fil qui tinteront si quelqu'un essaie de s'infiltrer ici."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:9
translate fr rom_Ves_2_FortAndCook_Rev_f515fabb:

    # VES @ talk "... Oh, well, let me know when you’re able to, I suppose..."
    VES @ talk "... Oh, eh bien, fais-moi savoir quand tu pourras, je suppose..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:14
translate fr rom_Ves_2_FortAndCook_94bfba8b:

    # VES @ talk "Great, let me get the stuff ready..."
    VES @ talk "Super, laisse-moi préparer le matériel..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:19
translate fr rom_Ves_2_FortAndCook_1bb29bdd:

    # "Over the next hour or so, Ves and I began to set up some primitive defences around her camp."
    "Au cours de l'heure suivante environ, Ves et moi avons commencé à installer des défenses primitives autour de son camp."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:21
translate fr rom_Ves_2_FortAndCook_c0c4d85f:

    # "A few spikes in the ground here and there alongside a wire running the camp’s perimeter..."
    "Quelques pieux plantés çà et là dans le sol, le long d'un fil courant sur le périmètre du camp..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:23
translate fr rom_Ves_2_FortAndCook_96d5e6db:

    # "If someone knocked it with their foot, it would jingle the attached glass bottles and miscellaneous goods loudly enough to alert Ves of their presence."
    "Si quelqu'un le heurtait du pied, cela ferait tinter les bouteilles en verre et divers objets attachés assez fort pour alerter Ves de leur présence."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:25
translate fr rom_Ves_2_FortAndCook_840a3072:

    # "And God help them when it did."
    "Et que Dieu leur vienne en aide quand ça arrivera."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:26
translate fr rom_Ves_2_FortAndCook_d5275d4b:

    # "Wiping the sweat from my brow as I hammered in one of the posts and secured it in place, I noticed Ves sneakily watched me the whole time, still cautiously half alert to my presence as a human, and half with a great deal of curiosity."
    "En essuyant la sueur de mon front tandis que j'enfonçais un des poteaux à coups de marteau et le fixais en place, je remarquai que Ves m'observait sournoisement tout le temps, encore à moitié méfiante à ma présence en tant qu'humain, et à moitié remplie d'une grande curiosité."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:31
translate fr rom_Ves_2_FortAndCook_4d690972:

    # VES @ talk "You are strong."
    VES @ talk "Tu es fort."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:32
translate fr rom_Ves_2_FortAndCook_6fb5dd4e:

    # "She watched me force one of the wooden posts into the ground."
    "Elle m'a regardé enfoncer l'un des poteaux en bois dans le sol."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:33
translate fr rom_Ves_2_FortAndCook_3fcdb530:

    # MC @ talk "Yeah, when this {i}thing{/i} inside of me attached itself, it changed my body as well."
    MC @ talk "Oui, quand ce {i}truc{/i} en moi s'est attaché, il a changé mon corps aussi."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:34
translate fr rom_Ves_2_FortAndCook_aef1c638:

    # VES @ talk "... I see."
    VES @ talk "... Je vois."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:37
translate fr rom_Ves_2_FortAndCook_ffbe6e66:

    # "Ves continued to observe as I worked until the sun began to set. If I caught her staring, she quickly made sure to look away and carry on working elsewhere, usually coiling the wires around the posts."
    "Ves continua d'observer pendant que je travaillais jusqu'à ce que le soleil commence à se coucher. Si je surprenais son regard, elle détournait rapidement les yeux et continuait à travailler ailleurs, généralement en enroulant les fils autour des poteaux."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:42
translate fr rom_Ves_2_FortAndCook_5278c1eb:

    # MC @ talk "Alright... That’s about everything, I think."
    MC @ talk "D'accord... C'est à peu près tout, je crois."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:43
translate fr rom_Ves_2_FortAndCook_ad5a8665:

    # VES @ talk "Yes, this is good."
    VES @ talk "Oui, c'est bien."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:44
translate fr rom_Ves_2_FortAndCook_101cd48e:

    # VES "..."
    VES "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:46
translate fr rom_Ves_2_FortAndCook_0e5b05f2:

    # VES @ talk "Are you free for a few more hours?"
    VES @ talk "Es-tu libre pour encore quelques heures ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:47
translate fr rom_Ves_2_FortAndCook_3ff3a479:

    # MC @ talk "What for?"
    MC @ talk "Pour quoi faire ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:48
translate fr rom_Ves_2_FortAndCook_24f33162:

    # VES @ talk "Would you care to join me for food?"
    VES @ talk "Ça te dirait de te joindre à moi pour manger ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:49
translate fr rom_Ves_2_FortAndCook_25a6adf5:

    # MC @ talk "Food?"
    MC @ talk "Nourriture ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:50
translate fr rom_Ves_2_FortAndCook_b3cb40ff:

    # VES @ talk "Yes... You must be hungry by now."
    VES @ talk "Oui... Tu dois avoir faim maintenant."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:51
translate fr rom_Ves_2_FortAndCook_83ddd484:

    # VES @ talk "{i}And...{/i}"
    VES @ talk "{i}Et...{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:52
translate fr rom_Ves_2_FortAndCook_d67a7314:

    # VES @ talk "It would be nice to have some company for a change."
    VES @ talk "Ce serait bien d'avoir un peu de compagnie pour changer."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:53
translate fr rom_Ves_2_FortAndCook_ee88f5f9:

    # MC @ talk "... Sure, Ves, I’ll stay for some food."
    MC @ talk "... D'accord, Ves, je resterai pour manger."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:54
translate fr rom_Ves_2_FortAndCook_6a2a3f7b:

    # MC @ talk "I’m pretty hungry myself anyway."
    MC @ talk "De toute façon, j'ai assez faim moi-même."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:55
translate fr rom_Ves_2_FortAndCook_cd9ef004:

    # "Ves perked up with an actual smile."
    "Ves s'illumina d'un vrai sourire."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:56
translate fr rom_Ves_2_FortAndCook_cf7b5d91:

    # VES @ talk "Good!"
    VES @ talk "Bien !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:57
translate fr rom_Ves_2_FortAndCook_79c1b828:

    # VES @ talk "I’ll get started on preparing the meat!"
    VES @ talk "Je vais commencer à préparer la viande !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:59
translate fr rom_Ves_2_FortAndCook_d55bc3a1:

    # "With that Ves hurried off to begin cooking. As she bent forward to grab some pots and pans, I stared at her cute ass as it shifted through the gossamer material gathered around it."
    "Là-dessus, Ves s'empressa de commencer à cuisiner. Alors qu'elle se penchait en avant pour attraper des casseroles et des poêles, je fixai son joli cul qui bougeait à travers le tissu vaporeux amassé autour."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:60
translate fr rom_Ves_2_FortAndCook_30cd150e:

    # BLACK "... This one I like."
    BLACK "... Celle-ci me plaît."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:61
translate fr rom_Ves_2_FortAndCook_e9c1fe99:

    # BLACK "She smells... {i}very appealing{/i}."
    BLACK "Elle sent... {i}très attirante{/i}."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:62
translate fr rom_Ves_2_FortAndCook_ffba0f79:

    # "From the corner of her eye, Ves looked back frequently over her shoulder at me, and from her expression, she must have realised that I kept glancing towards her as well because she'd shyly pull away."
    "Du coin de l'œil, Ves regardait fréquemment par-dessus son épaule vers moi, et d'après son expression, elle a dû se rendre compte que je n'arrêtais pas de jeter des coups d'œil vers elle aussi parce qu'elle se retirait timidement."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:63
translate fr rom_Ves_2_FortAndCook_efe19f2e:

    # "I did my best to look away, coughing awkwardly to break the strange tension."
    "Je faisais de mon mieux pour détourner le regard, toussant maladroitement pour briser l'étrange tension."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:64
translate fr rom_Ves_2_FortAndCook_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:65
translate fr rom_Ves_2_FortAndCook_efb9de0e:

    # BLACK "... Her heart rate has just increased exponentially, is she in heat and ready to procreate?"
    BLACK "... Son rythme cardiaque vient d'augmenter de manière exponentielle, est-elle en chaleur et prête à procréer ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:66
translate fr rom_Ves_2_FortAndCook_912591a3:

    # MC @ angry "Would you shut up?!"
    MC @ angry "Tu veux bien te taire ?!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:69
translate fr rom_Ves_2_FortAndCook_e4278626:

    # "Ves spun to look back at me, visible confusion on her face."
    "Ves se retourna pour me regarder, une confusion visible sur son visage."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:70
translate fr rom_Ves_2_FortAndCook_6eb77fc4:

    # MC @ surprised "It’s... It’s the thing."
    MC @ surprised "C'est... C'est la chose."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:71
translate fr rom_Ves_2_FortAndCook_1c238644:

    # MC @ talk "It can speak to me in my head."
    MC @ talk "Il peut me parler dans ma tête."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:72
translate fr rom_Ves_2_FortAndCook_57f92f4e:

    # "Ves, now a little concerned, simply mouthed an ‘Oh’ as she quickly decided not to ponder too much on it and instead carried on grabbing what she needed."
    "Ves, maintenant un peu inquiète, articula simplement un « Oh » alors qu'elle décida rapidement de ne pas trop y réfléchir et continua plutôt de prendre ce dont elle avait besoin."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:75
translate fr rom_Ves_2_FortAndCook_748fee9b:

    # "We sat around the warm blazing fire outside of her tent, chewing on the tender meat from our hunt skewered onto sticks which we cooked over the flames."
    "Nous étions assis autour du feu chaud et crépitant devant sa tente, mâchant la viande tendre de notre chasse embrochée sur des bâtons que nous faisions cuire au-dessus des flammes."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:76
translate fr rom_Ves_2_FortAndCook_bd8ba4fd:

    # "It was quiet tonight, and the fire provided the only light around for what must have been miles."
    "C'était calme ce soir, et le feu était la seule source de lumière à des kilomètres à la ronde."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:83
translate fr rom_Ves_2_FortAndCook_7effd6c2:

    # "Ves waited and watched eagerly as I sat there with the meat on a stick, looking queasily at it as she observed me, waiting with bated breath as I took a tentative bite from it."
    "Ves attendait et regardait avec impatience tandis que j'étais assis là avec la viande sur un bâton, la regardant avec un air dégoûté, alors qu'elle m'observait, retenant son souffle alors que j'en prenais une bouchée hésitante."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:84
translate fr rom_Ves_2_FortAndCook_0aa278e1:

    # MC @ talk "... It’s good."
    MC @ talk "... C'est bon."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:85
translate fr rom_Ves_2_FortAndCook_a4c6456f:

    # "Ves' eyes seemed to glitter in the embers of the fire as she smiled triumphantly, her fists raised into the night air."
    "Les yeux de Ves semblèrent briller dans les braises du feu tandis qu'elle souriait triomphalement, les poings levés vers le ciel nocturne."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:86
translate fr rom_Ves_2_FortAndCook_f1f8a99a:

    # VES @ talk "YES!"
    VES @ talk "OUI !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:87
translate fr rom_Ves_2_FortAndCook_d99bc996:

    # VES @ talk "My tribe said I’d never be a good cook!"
    VES @ talk "Ma tribu disait que je ne serais jamais une bonne cuisinière !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:88
translate fr rom_Ves_2_FortAndCook_dd141836:

    # VES @ talk "Ha! They would eat dirt if they were here!"
    VES @ talk "Ha ! Ils mangeraient de la terre s'ils étaient là !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:89
translate fr rom_Ves_2_FortAndCook_a58b53ef:

    # MC @ talk "How big is your tribe?"
    MC @ talk "Quelle est la taille de ta tribu ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:90
translate fr rom_Ves_2_FortAndCook_486ed9ca:

    # VES @ talk "Hm? Oh well, I think there’s about a hundred altogether..."
    VES @ talk "Hm? Eh bien, je pense qu'il y en a environ une centaine en tout..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:91
translate fr rom_Ves_2_FortAndCook_95cc3756:

    # MC @ talk "A hundred?!"
    MC @ talk "Une centaine?!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:93
translate fr rom_Ves_2_FortAndCook_128cb1f3:

    # "Ves laughed."
    "Ves rit."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:94
translate fr rom_Ves_2_FortAndCook_66700141:

    # VES @ talk "It’s a small tribe. The tribes all fall under the rule of the Great Chieftain should he command us, but all tribes are led by their Elders."
    VES @ talk "C'est une petite tribu. Toutes les tribus relèvent de l'autorité du Grand Chef, s'il venait à nous commander, mais chaque tribu est dirigée par ses Anciens."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:95
translate fr rom_Ves_2_FortAndCook_d3eed914:

    # "Ves took a bite of her food and smiled."
    "Ves prit une bouchée de sa nourriture et sourit."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:96
translate fr rom_Ves_2_FortAndCook_632b2da1:

    # VES @ talk "Mmm, just needs some more salt..."
    VES @ talk "Mmm, il manque juste un peu de sel..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:97
translate fr rom_Ves_2_FortAndCook_9a799022:

    # VES @ talk "In Skarshire, there are so many different spices and flavours for food."
    VES @ talk "À Skarshire, il y a tellement d'épices et de saveurs différentes pour la nourriture."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:98
translate fr rom_Ves_2_FortAndCook_e7a60ff6:

    # MC @ talk "I’ve never been."
    MC @ talk "Je n'y suis jamais allé."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:99
translate fr rom_Ves_2_FortAndCook_e3c60fc3:

    # VES @ talk "Skarshire is beautiful, many small islands are interconnected. Our own little archipelago."
    VES @ talk "Skarshire est magnifique, de nombreuses petites îles sont reliées entre elles. Notre propre petit archipel."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:100
translate fr rom_Ves_2_FortAndCook_00c0a271:

    # VES @ talk "The water is so blue..."
    VES @ talk "L'eau est tellement bleue..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:101
translate fr rom_Ves_2_FortAndCook_dd9c2863:

    # VES @ talk "Perhaps one day I will show—"
    VES @ talk "Peut-être qu'un jour je montrerai—"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:103
translate fr rom_Ves_2_FortAndCook_b236ea86:

    # "Ves paused, the smile dropping from her face. "
    "Ves s'arrêta, le sourire disparaissant de son visage."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:104
translate fr rom_Ves_2_FortAndCook_d3463ab9:

    # VES @ talk "Never mind."
    VES @ talk "Laisse tomber."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:105
translate fr rom_Ves_2_FortAndCook_293b9424:

    # MC @ talk "... What? What is it?"
    MC @ talk "... Quoi ? Qu'est-ce que c'est ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:106
translate fr rom_Ves_2_FortAndCook_a72d3f88:

    # VES @ talk "It’s not going to happen — humans and orcs do not mix."
    VES @ talk "Ça n'arrivera pas — les humains et les orques ne se mélangent pas."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:107
translate fr rom_Ves_2_FortAndCook_2098e538:

    # MC @ talk "... We seem to get on pretty well."
    MC @ talk "... On dirait qu'on s'entend plutôt bien."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:108
translate fr rom_Ves_2_FortAndCook_4f90784e:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:109
translate fr rom_Ves_2_FortAndCook_6798a12e:

    # MC @ talk "Aren’t we proof it doesn’t have to just be fighting?"
    MC @ talk "Ne sommes-nous pas la preuve que ça ne doit pas être que des combats ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:110
translate fr rom_Ves_2_FortAndCook_20caadc0:

    # VES @ talk "It’s not merely about just getting on! There is... too much pain... too much hate for that to happen."
    VES @ talk "Ce n'est pas simplement une question de s'entendre ! Il y a... trop de douleur... trop de haine pour que ça arrive."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:111
translate fr rom_Ves_2_FortAndCook_18a9b1cb:

    # MC @ talk "Not all humans are the same, Ves."
    MC @ talk "Tous les humains ne sont pas pareils, Ves."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:112
translate fr rom_Ves_2_FortAndCook_6e4a5cbd:

    # VES @ talk "I know that!"
    VES @ talk "Je le sais !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:113
translate fr rom_Ves_2_FortAndCook_bdcf49f1:

    # VES @ talk "But a human wouldn’t understand."
    VES @ talk "Mais un humain ne comprendrait pas."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:114
translate fr rom_Ves_2_FortAndCook_56cc6176:

    # MC @ talk "Then try, try to make me understand!"
    MC @ talk "Alors essaie, essaie de me faire comprendre !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:116
translate fr rom_Ves_2_FortAndCook_4d056001:

    # VES @ sad_talk "... Our people have been slaves for generations."
    VES @ sad_talk "... Notre peuple est esclave depuis des générations."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:117
translate fr rom_Ves_2_FortAndCook_27f3f3d6:

    # VES @ sad_talk "Rape... Violence... Torture..."
    VES @ sad_talk "Viol... Violence... Torture..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:118
translate fr rom_Ves_2_FortAndCook_32d10626:

    # VES @ sad_talk "These things are everyday occurrences for the orcs still bound by their master’s whips. "
    VES @ sad_talk "Ces choses sont monnaie courante pour les orcs encore liés par les fouets de leur maître."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:119
translate fr rom_Ves_2_FortAndCook_b97e9576:

    # VES @ sad_talk "Made to feel an ugly people... Made to feel {i}dirty.{/i}"
    VES @ sad_talk "Forcés à se sentir un peuple laid... Forcés à se sentir {i}sales.{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:120
translate fr rom_Ves_2_FortAndCook_d1296db1:

    # VES @ sad_talk "Nothing but shame has been brought and inflicted upon us."
    VES @ sad_talk "Seule la honte nous a été apportée et infligée."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:121
translate fr rom_Ves_2_FortAndCook_3fa7e5b2:

    # MC @ talk "But that was the Greater Trading Company! What does that have to do with the rest of us?"
    MC @ talk "Mais c'était la Greater Trading Company ! Qu'est-ce que cela a à voir avec le reste d'entre nous ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:123
translate fr rom_Ves_2_FortAndCook_b5661854:

    # VES @ angry_talk "No!"
    VES @ angry_talk "Non !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:125
translate fr rom_Ves_2_FortAndCook_35d5211c:

    # "Ves rose to her feet furiously, anger simmering beneath her voice."
    "Ves se leva furieusement, la colère couvant sous sa voix."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:126
translate fr rom_Ves_2_FortAndCook_139e9c93:

    # VES @ angry_talk "You are all the same!"
    VES @ angry_talk "Vous êtes tous pareils !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:127
translate fr rom_Ves_2_FortAndCook_16b1882c:

    # VES @ angry_talk "Alderay, YOUR PEOPLE, have been sending our enemies weapons, have been sending them supplies!"
    VES @ angry_talk "Alderay, VOTRE PEUPLE, envoie des armes à nos ennemis, leur envoie des fournitures !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:128
translate fr rom_Ves_2_FortAndCook_9832729d:

    # VES @ angry_talk "Why? For gold!"
    VES @ angry_talk "Pourquoi ? Pour de l'or !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:129
translate fr rom_Ves_2_FortAndCook_14ddb23b:

    # VES @ angry_talk "{i}For greed...{/i}"
    VES @ angry_talk "{i}Par cupidité...{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:130
translate fr rom_Ves_2_FortAndCook_08e95c86:

    # MC @ sad "That’s not true! Yes, Alderay sold to the Greater Trading Company at first..."
    MC @ sad "Ce n'est pas vrai ! Oui, Alderay a d'abord vendu à la Grande Compagnie Commerciale..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:131
translate fr rom_Ves_2_FortAndCook_cedef812:

    # MC @ sad "But Alderay officially cut ties with them after the {i}‘Battle of the Bay of Valar’{/i}, everyone knows that!"
    MC @ sad "Mais Alderay a officiellement rompu ses liens avec eux après la {i}‘Bataille de la Baie de Valar’{/i}, tout le monde le sait !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:132
translate fr rom_Ves_2_FortAndCook_753e15da:

    # MC @ sad "It was part of the peace deal Newheart secured! The one your people continue to violate by attacking innocent civilians!"
    MC @ sad "Cela faisait partie de l'accord de paix que Newheart a conclu ! Celui que votre peuple continue de violer en attaquant des civils innocents !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:133
translate fr rom_Ves_2_FortAndCook_15b6ae1d:

    # "Ves gritted her teeth, swelling with rage. "
    "Ves serra les dents, gonflée de rage."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:134
translate fr rom_Ves_2_FortAndCook_40c348cc:

    # VES @ angry_talk "You idiot!"
    VES @ angry_talk "Espèce d'idiot !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:135
translate fr rom_Ves_2_FortAndCook_8991341f:

    # VES @ angry_talk "Then why do we see unmarked ships docking into Borusmark with supplies, hmm?"
    VES @ angry_talk "Alors pourquoi voyons-nous des navires non marqués accoster à Borusmark avec des provisions, hein ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:136
translate fr rom_Ves_2_FortAndCook_3663fd1e:

    # VES @ angry_talk "And why do you think the Greater Trading Company continue to send gold to your lands if they have no business with you? "
    VES @ angry_talk "Et pourquoi pensez-vous que la Grande Compagnie de Commerce continue d'envoyer de l'or sur vos terres si elle n'a pas d'affaires avec vous ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:137
translate fr rom_Ves_2_FortAndCook_f7c79499:

    # MC @ surprised "You can’t just assume that was us! Unmarked could be anyone!"
    MC @ surprised "Vous ne pouvez pas simplement supposer que c'était nous ! Les non marqués pourraient être n'importe qui !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:138
translate fr rom_Ves_2_FortAndCook_f52e9141:

    # MC @ surprised "By the gods it could be pirates smuggling for all you know!"
    MC @ surprised "Par les dieux, cela pourrait être des pirates en train de faire de la contrebande, pour ce que vous en savez !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:139
translate fr rom_Ves_2_FortAndCook_710790b0:

    # MC @ surprised "Slavery has been abolished for years!"
    MC @ surprised "L'esclavage est aboli depuis des années !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:140
translate fr rom_Ves_2_FortAndCook_8f00f766:

    # VES @ angry_talk "Do you even hear yourself speak?"
    VES @ angry_talk "Vous vous entendez parler ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:141
translate fr rom_Ves_2_FortAndCook_0d04ca08:

    # VES @ angry_talk "The treaty was a lie!"
    VES @ angry_talk "Le traité était un mensonge !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:142
translate fr rom_Ves_2_FortAndCook_089d6c28:

    # VES @ angry_talk "What did you expect us to do when you continue to aid our enemies?"
    VES @ angry_talk "Qu'attendiez-vous que nous fassions quand vous continuez à aider nos ennemis ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:143
translate fr rom_Ves_2_FortAndCook_2023b64a:

    # VES @ angry_talk "Sit back and let us be treated like animals? "
    VES @ angry_talk "Rester assis et nous laisser traiter comme des animaux ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:144
translate fr rom_Ves_2_FortAndCook_f34b5220:

    # MC @ angry "So, killing civilians is the answer? "
    MC @ angry "Alors, tuer des civils est la réponse ?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:145
translate fr rom_Ves_2_FortAndCook_d670272e:

    # MC @ angry "Innocent men and women who’ve played NO part in any of this! "
    MC @ angry "Des hommes et des femmes innocents qui n'ont joué AUCUN rôle dans tout ça !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:146
translate fr rom_Ves_2_FortAndCook_db797b4c:

    # VES @ angry_talk "Grgh! There we go!"
    VES @ angry_talk "Grgh ! Voilà !"

