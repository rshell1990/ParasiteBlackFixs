translate fr rom_Ves_2_FortAndCook_c1f547c9:

    # VES angry_talk "Always thinking like a human! Always finding a way to justify the horrors you inflict on others!"
    VES angry_talk "Toujours penser comme un humain ! Toujours trouver un moyen de justifier les horreurs que tu infliges aux autres !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:148
translate fr rom_Ves_2_FortAndCook_825cb83d:

    # MC @ angry "I’m not trying to justify it, Ves!"
    MC @ angry "Je n'essaie pas de le justifier, Ves !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:149
translate fr rom_Ves_2_FortAndCook_2cb544a7:

    # MC @ angry "But you can’t justify committing one crime as a response to another!"
    MC @ angry "Mais tu ne peux pas justifier de commettre un crime en réponse à un autre !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:150
translate fr rom_Ves_2_FortAndCook_567d0cf3:

    # VES @ angry_talk "You have no idea what we’ve endured... You know nothing!"
    VES @ angry_talk "Tu n'as aucune idée de ce que nous avons enduré... Tu ne sais rien !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:151
translate fr rom_Ves_2_FortAndCook_467ade81:

    # MC @ sad "I’m trying to help!"
    MC @ sad "J'essaie d'aider !"

