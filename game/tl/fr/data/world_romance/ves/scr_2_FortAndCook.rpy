translate fr rom_Ves_2_FortAndCook_859e0e65:

    # VES @ angry_talk "I didn’t want your help!"
    VES @ angry_talk "Je ne voulais pas de ton aide !"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:154
translate fr rom_Ves_2_FortAndCook_bbe4124a:

    # "Ves kicked up some sand into the fire as she stormed off back into the sanctuary of her tent, shouting loudly behind at me. "
    "Ves a soulevé du sable dans le feu en s'en retournant furieusement vers le sanctuaire de sa tente, en criant fort derrière elle à mon intention."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:155
translate fr rom_Ves_2_FortAndCook_a8b54219:

