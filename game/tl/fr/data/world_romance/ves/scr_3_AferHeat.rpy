# game/data/world_romance/ves/scr_3_AferHeat.rpy:4
translate fr rom_Ves_3_AfterHeat_b7d400f5:

    # "I found Ves sat rather sombrely on a rock as she inspected the fang-toothed necklace she usually wore, gently running her fingers along it."
    "J'ai trouvé Ves assise plutôt sombrement sur un rocher alors qu'elle inspectait le collier à dents de croc qu'elle portait habituellement, passant doucement ses doigts dessus."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:7
translate fr rom_Ves_3_AfterHeat_f4884dab:

    # VES @ sad_talk "... I didn’t think you’d come back."
    VES @ sad_talk "... Je ne pensais pas que tu reviendrais."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:8
translate fr rom_Ves_3_AfterHeat_92817a56:

    # MC @ talk "I’m a glutton for punishment."
    MC @ talk "Je suis un masochiste."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:9
translate fr rom_Ves_3_AfterHeat_f30a46bb:

    # VES @ sad_talk "... Do you know what this is?"
    VES @ sad_talk "... Tu sais ce que c'est ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:10
translate fr rom_Ves_3_AfterHeat_edcc99e9:

    # "Ves dangled the necklace in front of me."
    "Ves fit pendre le collier devant moi."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:11
translate fr rom_Ves_3_AfterHeat_64e756eb:

    # MC @ talk "I take it it’s something important to you?"
    MC @ talk "Je suppose que c'est quelque chose d'important pour toi ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:12
translate fr rom_Ves_3_AfterHeat_20b900d5:

    # VES @ sad_talk "I was smuggled away when I was just a baby by the other tribes."
    VES @ sad_talk "J'ai été emmené en cachette quand je n'étais qu'un bébé par les autres tribus."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:13
translate fr rom_Ves_3_AfterHeat_1c02388f:

    # VES @ sad_talk "This is the only thing of my mother’s I have left."
    VES @ sad_talk "C'est la seule chose qu'il me reste de ma mère."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:14
translate fr rom_Ves_3_AfterHeat_aa290b42:

    # MC sad "..."
    MC sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:15
translate fr rom_Ves_3_AfterHeat_fde1246b:

    # "Ves turned to look at me with sullen eyes."
    "Ves se tourna pour me regarder avec des yeux moroses."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:16
translate fr rom_Ves_3_AfterHeat_559624de:

    # VES @ sad_talk "Both of my parents were slaves."
    VES @ sad_talk "Mes deux parents étaient esclaves."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:17
translate fr rom_Ves_3_AfterHeat_fca7a546:

    # VES @ sad_talk "After giving birth to me, my mother was beaten and raped by the master’s right-hand man, a man named Lavak... She died shortly afterwards."
    VES @ sad_talk "Après m'avoir donné naissance, ma mère a été battue et violée par le bras droit du maître, un homme nommé Lavak... Elle est morte peu après."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:18
translate fr rom_Ves_3_AfterHeat_9f648ae6:

    # VES @ sad_talk "My father was killed when he tried to protect her."
    VES @ sad_talk "Mon père a été tué en essayant de la protéger."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:19
translate fr rom_Ves_3_AfterHeat_ebc8397b:

    # MC @ sad "... Ves."
    MC @ sad "... Ves."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:20
translate fr rom_Ves_3_AfterHeat_7272ceaa:

    # VES @ sad_talk "My tribe is all I have left, but the thought of {i}vengeance{/i} has kept me alive so far."
    VES @ sad_talk "Ma tribu est tout ce qu'il me reste, mais la pensée de la {i}vengeance{/i} m'a gardé en vie jusqu'à présent."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:24
translate fr rom_Ves_3_AfterHeat_7ddac0a5:

    # MC @ talk "... There is no redeeming monsters like that."
    MC @ talk "... Il n'y a pas de rédemption pour de tels monstres."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:25
translate fr rom_Ves_3_AfterHeat_b1ff3d7a:

    # MC @ talk "What they did was... {i}unforgivable.{/i}"
    MC @ talk "Ce qu'ils ont fait était... {i}impardonnable.{/i}"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:26
translate fr rom_Ves_3_AfterHeat_4f90784e:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:27
translate fr rom_Ves_3_AfterHeat_1114e285:

    # MC @ talk "Ves, you will have your vengeance."
    MC @ talk "Ves, tu auras ta vengeance."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:28
translate fr rom_Ves_3_AfterHeat_b3c4eb96:

    # VES @ talk "... How do you know?"
    VES @ talk "... Comment le sais-tu ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:29
translate fr rom_Ves_3_AfterHeat_c25c53b8:

    # MC @ talk "{i}Because I’ll help you.{/i}"
    MC @ talk "{i}Parce que je vais t'aider.{/i}"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:32
translate fr rom_Ves_3_AfterHeat_da215aef:

    # MC @ talk "... Vengeance won’t bring them back and it won’t heal the wounds left, Ves."
    MC @ talk "... La vengeance ne les ramènera pas et ne guérira pas les blessures laissées, Ves."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:33
translate fr rom_Ves_3_AfterHeat_4f90784e_1:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:34
translate fr rom_Ves_3_AfterHeat_fcfcfbc0:

    # MC @ talk "You have to be better than them... You’re not a cold-blooded killer."
    MC @ talk "Tu dois être meilleur qu'eux... Tu n'es pas un tueur de sang-froid."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:35
translate fr rom_Ves_3_AfterHeat_9740dc5f:

    # VES @ talk "What makes you so sure of that?"
    VES @ talk "Qu'est-ce qui te rend si sûr de ça ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:36
translate fr rom_Ves_3_AfterHeat_8bd8ab3f:

    # VES @ talk "What makes you think I don’t intend to cut down THEIR women and children like they did to ours?"
    VES @ talk "Qu'est-ce qui te fait penser que je n'ai pas l'intention d'abattre LEURS femmes et enfants comme ils l'ont fait aux nôtres ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:37
translate fr rom_Ves_3_AfterHeat_afceff91:

    # VES @ talk "Like they did to MY family?"
    VES @ talk "Comme ils l'ont fait à MA famille ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:38
translate fr rom_Ves_3_AfterHeat_db6839b5:

    # MC @ talk "Because, Ves, I’ll help you bring them to justice... But I won’t help you become a monster yourself."
    MC @ talk "Parce que, Ves, je vais t'aider à les traduire en justice... Mais je ne t'aiderai pas à devenir un monstre toi-même."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:39
translate fr rom_Ves_3_AfterHeat_ca8f6395:

    # MC @ talk "You need to be better than them."
    MC @ talk "Tu dois être meilleur qu'eux."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:40
translate fr rom_Ves_3_AfterHeat_550c9aed:

    # VES @ angry_talk "Why?"
    VES @ angry_talk "Pourquoi ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:41
translate fr rom_Ves_3_AfterHeat_cf3fda9d:

    # VES @ angry_talk "There has been no justice for my people! Why must I be better than them? What have they done to deserve that?"
    VES @ angry_talk "Il n'y a pas eu de justice pour mon peuple ! Pourquoi devrais-je être meilleur qu'eux ? Qu'ont-ils fait pour mériter cela ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:42
translate fr rom_Ves_3_AfterHeat_e80284ea:

    # VES @ angry_talk "Why should I not just inflict on them the suffering they have inflicted on others? "
    VES @ angry_talk "Pourquoi ne devrais-je pas simplement leur infliger la souffrance qu'ils ont infligée aux autres ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:43
translate fr rom_Ves_3_AfterHeat_26543181:

    # MC @ talk "Because, Ves, vengeance is a fleeting thing... As soon as you have it, it’s over."
    MC @ talk "Parce que, Ves, la vengeance est une chose éphémère... Dès que tu l'as, c'est fini."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:44
translate fr rom_Ves_3_AfterHeat_575e87ea:

    # MC @ talk "Justice is meant to be more than that though."
    MC @ talk "La justice est censée être plus que cela, cependant."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:45
translate fr rom_Ves_3_AfterHeat_47c29c9a:

    # MC @ talk "It’s about making them answer for their crimes and letting the world know the truth of what they did so that history cannot repeat itself."
    MC @ talk "Il s'agit de leur faire répondre de leurs crimes et de faire connaître au monde la vérité de ce qu'ils ont fait afin que l'histoire ne puisse se répéter."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:46
translate fr rom_Ves_3_AfterHeat_2a634cce:

    # VES @ talk "... Hmph. I will think on your words."
    VES @ talk "... Hmph. Je vais réfléchir à tes paroles."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:47
translate fr rom_Ves_3_AfterHeat_0d71c69a:

    # MC @ talk "I’m glad to hear that."
    MC @ talk "Je suis heureux de l'entendre."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:48
translate fr rom_Ves_3_AfterHeat_612727b6:

    # VES @ talk "... You are a strange human."
    VES @ talk "... Tu es un humain étrange."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:49
translate fr rom_Ves_3_AfterHeat_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:50
translate fr rom_Ves_3_AfterHeat_28bf2f6f:

    # VES @ talk "But I don’t think you’re a bad one."
    VES @ talk "Mais je ne pense pas que tu sois mauvais."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:52
translate fr rom_Ves_3_AfterHeat_4a4febb6:

    # VES @ talk "... You know you don’t have to help me with this, right?"
    VES @ talk "... Tu sais que tu n'as pas à m'aider avec ça, hein ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:53
translate fr rom_Ves_3_AfterHeat_d595c4f8:

    # VES @ talk "I don’t even know when... {i}if{/i} I’ll ever get a chance to return to Skarshire again..."
    VES @ talk "Je ne sais même pas quand... {i}si{/i} j'aurai à nouveau une chance de retourner à Skarshire..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:54
translate fr rom_Ves_3_AfterHeat_ab2f88eb:

    # MC @ talk "{i}When{/i} we do, Ves, I promise you you’ll get your chance..."
    MC @ talk "{i}Quand{/i} nous le ferons, Ves, je te promets que tu auras ta chance..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:55
translate fr rom_Ves_3_AfterHeat_58ad8d11:

    # "Ves stared awkwardly down at the sand before her wide, glassy eyes looked up to stare into mine."
    "Ves baissa les yeux maladroitement sur le sable avant que ses grands yeux vitreux ne se lèvent pour plonger dans les miens."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:60
translate fr rom_Ves_3_AfterHeat_b0e01b52:

    # "Suddenly, without saying a word she lunged forward from her spot to hug me tightly."
    "Soudain, sans dire un mot, elle bondit en avant de sa place pour me serrer fort dans ses bras."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:61
translate fr rom_Ves_3_AfterHeat_b908e1e2:

    # "Gently, I wrapped my arms slowly around her, at the sudden affection before she shyly pulled back and looked at me again."
    "Doucement, j'enroulai lentement mes bras autour d'elle, à cette soudaine affection, avant qu'elle ne se retire timidement et me regarde à nouveau."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:66
translate fr rom_Ves_3_AfterHeat_b9152cde:

    # VES @ talk "You... Most humans would have run away at the very sight of me."
    VES @ talk "Toi... La plupart des humains auraient fui à ma simple vue."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:67
translate fr rom_Ves_3_AfterHeat_cf8239fd:

    # VES @ talk "Why did you not?"
    VES @ talk "Pourquoi pas toi ?"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:68
translate fr rom_Ves_3_AfterHeat_f74f06a2:

    # VES @ talk "To be an orc is to be an ugly thing..."
    VES @ talk "Être un orc, c'est être une chose laide..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:75
translate fr rom_Ves_3_AfterHeat_3b48b116:

    # "Ves cheeks flushed red as my finger and thumb gently cupped under her chin. Nervously, she stepped back, her eyes darting towards the sand. "
    "Les joues de Ves rougirent alors que mon pouce et mon index se glissaient doucement sous son menton. Nerveusement, elle recula, ses yeux se dirigeant vers le sable."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:76
translate fr rom_Ves_3_AfterHeat_5d5c96a8:

    # VES @ talk "I... I have things I need to prepare for the next hunt! "
    VES @ talk "Je... J'ai des choses à préparer pour la prochaine chasse !"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:77
translate fr rom_Ves_3_AfterHeat_afacf1f3:

    # VES @ talk "Leave me! Come back another time!"
    VES @ talk "Laisse-moi ! Reviens une autre fois !"

# game/data/world_romance/ves/scr_3_AferHeat.rpy:79
translate fr rom_Ves_3_AfterHeat_0fe2cec9:

    # "I reached out to stop her, but Ves had already scarpered off into the tent, and seemingly wasn’t coming out again. "
    "J'ai tendu la main pour l'arrêter, mais Ves s'était déjà enfuie dans la tente, et apparemment elle n'en ressortirait plus."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:81
translate fr rom_Ves_3_AfterHeat_34a3c8ba:

    # VES @ talk "I... I thank you."
    VES @ talk "Je... Je vous remercie."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:82
translate fr rom_Ves_3_AfterHeat_1e125e35:

    # VES @ talk "gradually slipped out from my arms."
    VES @ talk "glissa progressivement hors de mes bras."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:83
translate fr rom_Ves_3_AfterHeat_a267d18a:

    # VES @ talk "Perhaps... Just perhaps..."
    VES @ talk "Peut-être... Juste peut-être..."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:84
translate fr rom_Ves_3_AfterHeat_c53302ea:

    # VES @ talk "{i}Not all{/i} of you are bad."
    VES @ talk "{i}Pas tous{/i} d'entre vous ne sont mauvais."

# game/data/world_romance/ves/scr_3_AferHeat.rpy:86
translate fr rom_Ves_3_AfterHeat_38f3f17f:

    # "Ves smiled, her eyes seeming to well up slightly as she solemnly dragged herself back into her tent."
    "Ves sourit, ses yeux semblant se remplir légèrement alors qu'elle se traînait solennellement dans sa tente."

