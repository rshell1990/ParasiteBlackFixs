    VES @ talk "Alors... Toi et ton autre ami humain, Marcus... Êtes-vous proches ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:127
translate fr rom_Ves_6_Drunk_9c9de6c1:

    # MC @ talk "Like brothers... We’ve known each other since we were little."
    MC @ talk "Comme des frères... On se connaît depuis qu'on est petits."

# game/data/world_romance/ves/scr_6_Drunk.rpy:128
translate fr rom_Ves_6_Drunk_824d1dca:

    # VES @ talk "He is... different to you."
    VES @ talk "Il est... différent de toi."

# game/data/world_romance/ves/scr_6_Drunk.rpy:129
translate fr rom_Ves_6_Drunk_ade481c7:

    # MC @ talk "He’s a good man."
    MC @ talk "C'est un homme bon."

# game/data/world_romance/ves/scr_6_Drunk.rpy:130
translate fr rom_Ves_6_Drunk_2be47c87:

    # MC @ talk "But he’s got his issues, even before the fighting, I think."
    MC @ talk "Mais il a ses problèmes, même avant les combats, je pense."

# game/data/world_romance/ves/scr_6_Drunk.rpy:131
translate fr rom_Ves_6_Drunk_72fcfee0:

    # VES @ talk "... So, how did you become warriors?"
    VES @ talk "... Alors, comment êtes-vous devenus des guerriers ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:132
translate fr rom_Ves_6_Drunk_e268bbee:

    # MC @ talk "We didn’t get much say in the matter..."
    MC @ talk "On n'a pas eu trop notre mot à dire dans l'histoire..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:133
translate fr rom_Ves_6_Drunk_7a4b33f3:

    # MC @ talk "Called up to be part of the noble Scouts."
    MC @ talk "Appelés pour faire partie des nobles Scouts."

# game/data/world_romance/ves/scr_6_Drunk.rpy:134
translate fr rom_Ves_6_Drunk_6347eb66:

    # VES @ talk "You didn’t choose to become a warrior?"
    VES @ talk "Vous n'avez pas choisi de devenir guerriers ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:135
translate fr rom_Ves_6_Drunk_d4498740:

    # VES @ talk "Surely this is a great honour!"
    VES @ talk "C'est sûrement un grand honneur !"

# game/data/world_romance/ves/scr_6_Drunk.rpy:136
translate fr rom_Ves_6_Drunk_829f86a7:

    # MC @ talk "Not to us..."
    MC @ talk "Pas pour nous..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:137
translate fr rom_Ves_6_Drunk_ced6b3ea:

    # VES @ talk "... I don’t understand."
    VES @ talk "... Je ne comprends pas."

# game/data/world_romance/ves/scr_6_Drunk.rpy:138
translate fr rom_Ves_6_Drunk_3cb19faa:

    # MC @ talk "There’s no glory dying in some wretched field for a pointless skirmish watching as your friends are being slaughtered around you."
    MC @ talk "Il n'y a aucune gloire à mourir dans un misérable champ pour une escarmouche sans intérêt, en regardant vos amis se faire massacrer autour de vous."

# game/data/world_romance/ves/scr_6_Drunk.rpy:139
translate fr rom_Ves_6_Drunk_2384c6dc:

    # MC @ talk "Dying for SOMETHING, for ANYTHING would make it better..."
    MC @ talk "Mourir pour QUELQUE CHOSE, pour N'IMPORTE QUOI rendrait ça mieux..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:140
translate fr rom_Ves_6_Drunk_4d97dec6:

    # MC @ talk "More bearable."
    MC @ talk "Plus supportable."

# game/data/world_romance/ves/scr_6_Drunk.rpy:141
translate fr rom_Ves_6_Drunk_2ac5b574:

    # MC @ talk "But most of us would just die unceremoniously, in cruel, painful deaths with no one to remember... or even care that we’re gone or what our mission even was in the first place."
    MC @ talk "Mais la plupart d'entre nous mourraient tout simplement sans cérémonie, dans des morts cruelles et douloureuses sans que personne ne se souvienne... ni même ne se soucie que nous ne soyons plus là ou de ce qu'était notre mission en premier lieu."

# game/data/world_romance/ves/scr_6_Drunk.rpy:142
translate fr rom_Ves_6_Drunk_4999deb8:

    # VES @ talk "..."
    VES @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:143
translate fr rom_Ves_6_Drunk_d0ba7df3:

    # MC @ talk "Praying... always praying you’d somehow get home... Praying you’d never have to venture beyond those walls again."
    MC @ talk "Priant... toujours en priant pour rentrer chez toi d'une manière ou d'une autre... Priant pour ne plus jamais avoir à t'aventurer au-delà de ces murs."

# game/data/world_romance/ves/scr_6_Drunk.rpy:144
translate fr rom_Ves_6_Drunk_74b54e64:

    # VES @ talk "... And yet, here you are!"
    VES @ talk "... Et pourtant, te voilà !"

# game/data/world_romance/ves/scr_6_Drunk.rpy:145
translate fr rom_Ves_6_Drunk_8b056b19:

    # VES @ smile_talk "Made stronger by surviving beyond the walls!"
    VES @ smile_talk "Rendue plus forte en survivant au-delà des murs !"

# game/data/world_romance/ves/scr_6_Drunk.rpy:146
translate fr rom_Ves_6_Drunk_dc6c7127:

    # MC @ talk "... Yeah, I suppose so."
    MC @ talk "... Ouais, je suppose que oui."

# game/data/world_romance/ves/scr_6_Drunk.rpy:147
translate fr rom_Ves_6_Drunk_690c0c4e:

    # VES @ talk "And you and I would never have met if you were still too afraid to leave the safety of your walls."
    VES @ talk "Et toi et moi ne nous serions jamais rencontrés si tu avais encore trop peur de quitter la sécurité de tes murs."

# game/data/world_romance/ves/scr_6_Drunk.rpy:148
translate fr rom_Ves_6_Drunk_6c282d37:

    # MC @ talk "... Me and Marcus only survived because of {i}what happened...{/i}"
    MC @ talk "... Marcus et moi n'avons survécu qu'à cause de {i}ce qui s'est passé...{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:149
translate fr rom_Ves_6_Drunk_e6596336:

    # MC @ talk "For anyone else, they’d be..."
    MC @ talk "Pour n'importe qui d'autre, ils seraient..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:150
translate fr rom_Ves_6_Drunk_5e6d1b2b:

    # "Ves’ hand moved to shush my lips."
    "La main de Ves s'est déplacée pour faire taire mes lèvres."

# game/data/world_romance/ves/scr_6_Drunk.rpy:151
translate fr rom_Ves_6_Drunk_bd2d8643:

    # VES @ talk "And yet, {i}you live to fight another day...{/i}"
    VES @ talk "Et pourtant, {i}tu vis pour te battre un autre jour...{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:152
translate fr rom_Ves_6_Drunk_b5181c29:

    # VES @ talk "This is what matters."
    VES @ talk "C'est ce qui compte."

# game/data/world_romance/ves/scr_6_Drunk.rpy:153
translate fr rom_Ves_6_Drunk_30ecfac2:

    # VES @ talk "O’rlarak commands you to live and fight on. For those who were not so fortunate. For those who have been denied what you have."
    VES @ talk "O’rlarak t'ordonne de vivre et de continuer à te battre. Pour ceux qui n'ont pas eu cette chance. Pour ceux à qui on a refusé ce que tu as."

# game/data/world_romance/ves/scr_6_Drunk.rpy:154
translate fr rom_Ves_6_Drunk_6bede656:

    # MC @ talk "O’rlarak?"
    MC @ talk "O’rlarak ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:155
translate fr rom_Ves_6_Drunk_30eba78e:

    # VES @ talk "{i}The greatest of all chiefs who now reigns in the sky.{/i}"
    VES @ talk "{i}Le plus grand de tous les chefs qui règne maintenant dans le ciel.{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:156
translate fr rom_Ves_6_Drunk_a7615141:

    # MC @ talk "... Ves..."
    MC @ talk "... Ves..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:157
translate fr rom_Ves_6_Drunk_c03a963b:

    # VES @ talk "To my people, to die in battle protecting those we love... those we care for..."
    VES @ talk "Pour mon peuple, mourir au combat en protégeant ceux que nous aimons... ceux qui nous sont chers..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:158
translate fr rom_Ves_6_Drunk_e9ffc2f1:

    # VES @ talk "There is no better way to die."
    VES @ talk "Il n'y a pas de meilleure façon de mourir."

# game/data/world_romance/ves/scr_6_Drunk.rpy:161
translate fr rom_Ves_6_Drunk_b9fc2750:

    # VES @ talk "... Strange."
    VES @ talk "... Étrange."

# game/data/world_romance/ves/scr_6_Drunk.rpy:162
translate fr rom_Ves_6_Drunk_e6ddc3fe:

    # MC @ talk "What, why is that strange?"
    MC @ talk "Quoi, pourquoi est-ce étrange ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:163
translate fr rom_Ves_6_Drunk_c667afcd:

    # VES @ talk "Most orcs see life as a short arrangement... A brief deal with the Great Chiefs paid for in blood."
    VES @ talk "La plupart des orcs voient la vie comme un arrangement court... Un bref pacte avec les Grands Chefs payé en sang."

# game/data/world_romance/ves/scr_6_Drunk.rpy:164
translate fr rom_Ves_6_Drunk_02e3c328:

    # VES @ talk "We are prepared to die from the day we are born."
    VES @ talk "Nous sommes prêts à mourir dès le jour de notre naissance."

# game/data/world_romance/ves/scr_6_Drunk.rpy:165
translate fr rom_Ves_6_Drunk_f9f2d041:

    # VES @ talk "But you see it as lasting... {i}longer.{/i}"
    VES @ talk "Mais toi, tu la vois comme durable... {i}plus longue.{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:166
translate fr rom_Ves_6_Drunk_366f724b:

    # MC @ talk "There’s more to life than death, Ves."
    MC @ talk "Il y a plus dans la vie que la mort, Ves."

# game/data/world_romance/ves/scr_6_Drunk.rpy:167
translate fr rom_Ves_6_Drunk_3292e2bf:

    # VES @ talk "... I’d like you to show me this one day."
    VES @ talk "... J’aimerais que tu me montres ça un jour."

# game/data/world_romance/ves/scr_6_Drunk.rpy:169
translate fr rom_Ves_6_Drunk_6d5279b0:

    # VES @ talk "A brothel?"
    VES @ talk "Un bordel ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:170
translate fr rom_Ves_6_Drunk_fd6d73ae:

    # MC @ smile "It’s... Never mind."
    MC @ smile "C’est... Laisse tomber."

# game/data/world_romance/ves/scr_6_Drunk.rpy:171
translate fr rom_Ves_6_Drunk_a5781452:

    # VES @ talk "What kind of place is that?"
    VES @ talk "Quel genre d’endroit est-ce ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:172
translate fr rom_Ves_6_Drunk_331874a8:

    # MC @ talk "It’s a place where humans pay to have sex."
    MC @ talk "C’est un endroit où les humains paient pour avoir des relations sexuelles."

# game/data/world_romance/ves/scr_6_Drunk.rpy:173
translate fr rom_Ves_6_Drunk_7926c541:

    # VES @ talk "... Humans... {i}pay{/i} to have sex?"
    VES @ talk "... Les humains... {i}paient{/i} pour avoir des relations sexuelles ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:174
translate fr rom_Ves_6_Drunk_b9f291e3:

    # VES @ talk "Do you not have matriarchs?"
    VES @ talk "N'avez-vous pas de matriarches ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:175
translate fr rom_Ves_6_Drunk_3eb7e210:

    # MC @ talk "Uhh, what?"
    MC @ talk "Euh, quoi ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:176
translate fr rom_Ves_6_Drunk_26d490a6:

    # VES @ talk "Every tribe has a few matriarchs... Women devoted just to breeding."
    VES @ talk "Chaque tribu a quelques matriarches... Des femmes dévouées uniquement à la reproduction."

# game/data/world_romance/ves/scr_6_Drunk.rpy:177
translate fr rom_Ves_6_Drunk_14252312:

    # MC @ talk "Wait, what?!"
    MC @ talk "Attends, quoi ?!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:178
translate fr rom_Ves_6_Drunk_660ccc51:

    # VES @ talk "A great number of orcs die young or in battle... Numbers need to be replenished quickly or we risk extinction."
    VES @ talk "Un grand nombre d'orcs meurent jeunes ou au combat... Les effectifs doivent être renouvelés rapidement, sinon nous risquons l'extinction."

# game/data/world_romance/ves/scr_6_Drunk.rpy:179
translate fr rom_Ves_6_Drunk_64d864e1:

    # VES @ talk "Matriarchs can even request to break in newly bonded husbands."
    VES @ talk "Les matriarches peuvent même demander à déniaiser les nouveaux maris."

# game/data/world_romance/ves/scr_6_Drunk.rpy:180
translate fr rom_Ves_6_Drunk_8c056903:

    # MC @ talk "How do the wives feel about that?"
    MC @ talk "Comment les épouses réagissent-elles à cela ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:181
translate fr rom_Ves_6_Drunk_8cb295ba:

    # VES @ talk "It is an old tradition... Some don’t like it but..."
    VES @ talk "C'est une vieille tradition... Certaines n'aiment pas ça, mais..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:182
translate fr rom_Ves_6_Drunk_988d95b0:

    # MC @ smile "I can imagine!"
    MC @ smile "J'imagine !"

# game/data/world_romance/ves/scr_6_Drunk.rpy:183
translate fr rom_Ves_6_Drunk_a3045e18:

    # "Ves shrugged apathetically."
    "Ves haussa les épaules avec apathie."

# game/data/world_romance/ves/scr_6_Drunk.rpy:184
translate fr rom_Ves_6_Drunk_aa67bb4f:

    # VES @ talk "Matriarchs often have the children of several males, and it is forbidden for them to devote themselves to just one mate."
    VES @ talk "Les matriarches ont souvent les enfants de plusieurs mâles, et il leur est interdit de se consacrer à un seul partenaire."

# game/data/world_romance/ves/scr_6_Drunk.rpy:185
translate fr rom_Ves_6_Drunk_4f7c58c4:

    # VES @ talk "So, it is seen as different to betraying your mate to be with them. It is for the good of the clan."
    VES @ talk "Ainsi, cela est perçu différemment de trahir son partenaire pour être avec eux. C'est pour le bien du clan."

# game/data/world_romance/ves/scr_6_Drunk.rpy:186
translate fr rom_Ves_6_Drunk_4d2eaece:

    # MC @ talk "That’s... a very openminded culture."
    MC @ talk "C'est... une culture très ouverte d'esprit."

# game/data/world_romance/ves/scr_6_Drunk.rpy:187
translate fr rom_Ves_6_Drunk_b6085730:

    # MC @ talk "I’m not sure humans would feel the same."
    MC @ talk "Je ne suis pas sûr que les humains ressentiraient la même chose."

# game/data/world_romance/ves/scr_6_Drunk.rpy:189
translate fr rom_Ves_6_Drunk_9ef627e9:

    # VES @ smile_talk "Of course I am right!"
    VES @ smile_talk "Bien sûr que j’ai raison !"

# game/data/world_romance/ves/scr_6_Drunk.rpy:190
translate fr rom_Ves_6_Drunk_58ed8680:

    # VES @ talk "I may not have studied like you, but I have learned many things..."
    VES @ talk "Je n’ai peut-être pas étudié comme toi, mais j’ai appris beaucoup de choses..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:193
translate fr rom_Ves_6_Drunk_2a911be7:

    # VES @ talk "So... you still haven’t told me how you became..."
    VES @ talk "Alors... tu ne m’as toujours pas raconté comment tu es devenu..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:194
translate fr rom_Ves_6_Drunk_8ce9bf6a:

    # MC @ talk "Ah... Well..."
    MC @ talk "Ah... Eh bien..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:195
translate fr rom_Ves_6_Drunk_abf098b8:

    # "I spent the next while recounting my tale to Ves, the perilous journey lead by Captain Duprey, the abandoned fort and the strange underground lab..."
    "Je passai le temps suivant à raconter mon histoire à Ves, le périlleux voyage mené par le capitaine Duprey, le fort abandonné et l’étrange laboratoire souterrain..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:196
translate fr rom_Ves_6_Drunk_66477c9e:

    # "Finally, I went into detail about the strange creatures that had attached themselves to me and Marcus, and the terms and conditions of our survival for their ‘gift’."
    "Enfin, je détaillai les étranges créatures qui s’étaient attachées à moi et à Marcus, ainsi que les conditions de notre survie pour leur ‘cadeau’."

# game/data/world_romance/ves/scr_6_Drunk.rpy:197
translate fr rom_Ves_6_Drunk_aef1c638:

    # VES @ talk "... I see."
    VES @ talk "... Je vois."

# game/data/world_romance/ves/scr_6_Drunk.rpy:198
translate fr rom_Ves_6_Drunk_fec7b863:

    # "Ves sighed morosely."
    "Ves soupira avec tristesse."

# game/data/world_romance/ves/scr_6_Drunk.rpy:199
translate fr rom_Ves_6_Drunk_6d6a4d50:

    # MC @ talk "... What is it?"
    MC @ talk "... Qu'y a-t-il ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:200
translate fr rom_Ves_6_Drunk_1c27f260:

    # VES @ talk "... Nothing."
    VES @ talk "... Rien."

# game/data/world_romance/ves/scr_6_Drunk.rpy:201
translate fr rom_Ves_6_Drunk_8d168b3c:

    # MC @ talk "No, something’s bothering you."
    MC @ talk "Non, quelque chose te tracasse."

# game/data/world_romance/ves/scr_6_Drunk.rpy:202
translate fr rom_Ves_6_Drunk_733c4389:

    # VES @ talk "I..."
    VES @ talk "Je..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:203
translate fr rom_Ves_6_Drunk_3d13c0ad:

    # VES @ talk "Would like to have you for myself..."
    VES @ talk "Aimerais t'avoir pour moi seul..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:204
translate fr rom_Ves_6_Drunk_8418a966:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:205
translate fr rom_Ves_6_Drunk_025adeea:

    # VES @ talk "{i}Just{/i} for myself."
    VES @ talk "{i}Juste{/i} pour moi."

# game/data/world_romance/ves/scr_6_Drunk.rpy:206
translate fr rom_Ves_6_Drunk_9bbca015:

    # VES @ talk "But... I know this is probably not possible, is it?"
    VES @ talk "Mais... je sais que ce n'est probablement pas possible, n'est-ce pas ?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:207
translate fr rom_Ves_6_Drunk_83848d0a:

    # MC @ talk "It is... difficult."
    MC @ talk "C'est... difficile."

# game/data/world_romance/ves/scr_6_Drunk.rpy:208
translate fr rom_Ves_6_Drunk_f7250a82:

    # MC @ talk "When I was fully human, I could have—"
    MC @ talk "Quand j'étais pleinement humain, j'aurais pu—"

# game/data/world_romance/ves/scr_6_Drunk.rpy:209
translate fr rom_Ves_6_Drunk_b13cb8e5:

    # VES @ talk "No... It’s okay."
    VES @ talk "Non... C'est bon."

# game/data/world_romance/ves/scr_6_Drunk.rpy:210
translate fr rom_Ves_6_Drunk_2b3bb5cd:

    # VES @ smile_talk "I am just happy to be with you."
    VES @ smile_talk "Je suis simplement heureux d'être avec toi."

# game/data/world_romance/ves/scr_6_Drunk.rpy:211
translate fr rom_Ves_6_Drunk_8cfba628:

    # VES @ talk "... And grateful for the patience you have shown me."
    VES @ talk "... Et reconnaissant pour la patience que tu m'as montrée."

# game/data/world_romance/ves/scr_6_Drunk.rpy:212
translate fr rom_Ves_6_Drunk_fe794908:

    # "Gently, I caressed Ves’ face with my hand, she leaned forward to press another kiss onto me."
    "Doucement, je caressai le visage de Ves avec ma main, elle se pencha en avant pour déposer un autre baiser sur moi."

# game/data/world_romance/ves/scr_6_Drunk.rpy:213
translate fr rom_Ves_6_Drunk_257b57b9:

    # VES @ smile_talk "... Goodnight, [player_name!t]."
    VES @ smile_talk "... Bonne nuit, [player_name!t]."

# game/data/world_romance/ves/scr_6_Drunk.rpy:214
translate fr rom_Ves_6_Drunk_a0f70b38:

    # MC @ smile "Hey! You said my name!"
    MC @ smile "Hé ! Tu as dit mon nom !"

# game/data/world_romance/ves/scr_6_Drunk.rpy:215
translate fr rom_Ves_6_Drunk_e23ae25b:

    # VES @ talk "{i}*Grumbles*{/i}"
    VES @ talk "{i}*Grogne*{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:216
translate fr rom_Ves_6_Drunk_8418a966_1:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:218
translate fr rom_Ves_6_Drunk_5702411e:

    # MC @ talk "Goodnight, Ves..."
    MC @ talk "Bonne nuit, Ves..."

translate fr strings:

    # game/data/world_romance/ves/scr_6_Drunk.rpy:109
    old "It all began when I was born, everyone realised I was the most handsome man in all of Alderay."
    new "Tout a commencé quand je suis né, tout le monde s'est rendu compte que j'étais l'homme le plus beau de tout Alderay."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:117
    old "Not much to say really... Most of your time growing up in Novaras is spent studying if you’re smart."
    new "Pas grand-chose à dire vraiment... La plupart de votre temps à grandir à Novaras est passé à étudier si vous êtes intelligent."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:160
    old "I’d prefer dying old and grey with my family around me."
    new "Je préférerais mourir vieux et grisonnant avec ma famille autour de moi."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:168
    old "I dunno, dying in a brothel sounds like a lot more fun."
    new "Je sais pas, mourir dans un bordel, ça a l'air bien plus amusant."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:188
    old "I suppose you’re right..."
    new "Je suppose que tu as raison..."

