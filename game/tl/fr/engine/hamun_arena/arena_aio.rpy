# game/engine/hamun_arena/arena_aio.rpy:161
translate fr hamun_arena_master_questions_menu_first_time_94a74e82:

    # HAMUN_ARENA_MASTER "You pay in blood here."
    HAMUN_ARENA_MASTER "Vous payez en sang ici."

# game/engine/hamun_arena/arena_aio.rpy:164
translate fr hamun_arena_master_questions_menu_first_time_beb6daa1:

    # HAMUN_ARENA_MASTER "There are five ranks within the arena."
    HAMUN_ARENA_MASTER "Il y a cinq rangs dans l'arène."

# game/engine/hamun_arena/arena_aio.rpy:165
translate fr hamun_arena_master_questions_menu_first_time_5d206716:

    # HAMUN_ARENA_MASTER "To move between ranks, you must defeat ten opponents in each rank."
    HAMUN_ARENA_MASTER "Pour passer d'un rang à l'autre, vous devez vaincre dix adversaires à chaque rang."

# game/engine/hamun_arena/arena_aio.rpy:166
translate fr hamun_arena_master_questions_menu_first_time_f1d4b60a:

    # HAMUN_ARENA_MASTER "Followed by a special match of our choosing."
    HAMUN_ARENA_MASTER "Suivi d'un match spécial de notre choix."

# game/engine/hamun_arena/arena_aio.rpy:167
translate fr hamun_arena_master_questions_menu_first_time_1b9223ca:

    # HAMUN_ARENA_MASTER "...As a word of warning, we may restrict your access to some of the higher ranks if we don't feel you're ready."
    HAMUN_ARENA_MASTER "...En guise d'avertissement, nous pouvons restreindre votre accès à certains rangs supérieurs si nous estimons que vous n'êtes pas prêt."

# game/engine/hamun_arena/arena_aio.rpy:168
translate fr hamun_arena_master_questions_menu_first_time_5b2e12c5:

    # HAMUN_ARENA_MASTER "We want a glorious battle on the sand... not a bloody massacre before the audience even sits down."
    HAMUN_ARENA_MASTER "Nous voulons une bataille glorieuse sur le sable... pas un massacre sanglant avant même que le public ne s'assoie."

# game/engine/hamun_arena/arena_aio.rpy:171
translate fr hamun_arena_master_questions_menu_first_time_ab7228a3:

    # HAMUN_ARENA_MASTER "Monsters, warriors... strange creatures from faraway lands."
