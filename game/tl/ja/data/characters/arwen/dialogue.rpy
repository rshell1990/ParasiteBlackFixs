translate ja arwen_bye_6f3f7b21:

    # ARWEN @ talk "Maybe next time though, hmm?"
    ARWEN @ talk "次はどうかな？"

# game/data/characters/arwen/dialogue.rpy:77
translate ja arwen_talk_celeste_6d79cabc:

    # MC @ talk "Hey Arwen."
    MC @ talk "ねぇ、アーウェン。"

# game/data/characters/arwen/dialogue.rpy:78
translate ja arwen_talk_celeste_324c5a69:

    # ARWEN @ talk "Why hello there brave adventurer!"
    ARWEN @ talk "おや、勇敢なる冒険者さん!"

# game/data/characters/arwen/dialogue.rpy:79
translate ja arwen_talk_celeste_30f5cc47:

    # ARWEN @ talk "Tell me, {i}how much coin would you pay to spend a night with the beautiful Celeste?{/i}"
    ARWEN @ talk "教えてくれ、{i}美しいセレスティと一夜を過ごすのに、いくらの金貨を払うか？{/i}"

# game/data/characters/arwen/dialogue.rpy:80
translate ja arwen_talk_celeste_4f6d740f:

    # ARWEN @ talk "Actually, don't even answer that!"
    ARWEN @ talk "いや、いいから答えないでよ!"

# game/data/characters/arwen/dialogue.rpy:81
translate ja arwen_talk_celeste_da29d70f:

    # ARWEN @ talk "We both know that such priceless things would be worth their weight in gold... {i}till now.{/i}"
    ARWEN @ talk "このような貴重なものが金と同じ価値があることは、二人ともわかっている…{i}今までは。{/i}"

# game/data/characters/arwen/dialogue.rpy:86
translate ja arwen_bye_cel_84e04ea5:

    # ARWEN @ talk "Very well."
    ARWEN @ talk "結構です。"

# game/data/characters/arwen/dialogue.rpy:90
translate ja arwen_whyCeleste_259711d9:

    # ARWEN @ laugh "Because... {i}Who doesn't want to fuck the most beautiful, famous heroine around?{/i}"
    ARWEN @ laugh "だって… {i}最も美しく有名なヒロインと、誰がヤリたくないだろう？{/i}"

# game/data/characters/arwen/dialogue.rpy:91
translate ja arwen_whyCeleste_9530a2ec:

    # ARWEN @ talk "People will pay whatever I ask if they think they'll get at least a taste of what it might be like to have her."
    ARWEN @ talk "彼女が手に入るかもしれないと、ほんの少しでも思わせさえすれば、奴らはいくらでも払うのが関の山だ。"

# game/data/characters/arwen/dialogue.rpy:92
translate ja arwen_whyCeleste_e7a80d41:

    # ARWEN @ talk "Fantasy is a powerful thing... The reality of something rarely meets the expectation."
    ARWEN @ talk "幻想は強力なものだ...  
現実は期待に... 滅多に応えない"

# game/data/characters/arwen/dialogue.rpy:93
translate ja arwen_whyCeleste_67cb03f1:

    # MC @ talk "Very insightful of you."
    MC @ talk "ご明察です。"

# game/data/characters/arwen/dialogue.rpy:94
translate ja arwen_whyCeleste_aa10a873:

    # ARWEN @ laugh "I try."
    ARWEN @ laugh "試みている。"

# game/data/characters/arwen/dialogue.rpy:98
translate ja dialogue_arwen_services_cel_ec508417:

    # ARWEN @ talk "Fifteen hundred coins and {i}Celeste{/i} is all yours."
    ARWEN @ talk "千五百枚のコインと、{i}セレステ{/i}が貴方のものだ。"

# game/data/characters/arwen/dialogue.rpy:99
translate ja dialogue_arwen_services_cel_8b30ba46:

    # MC @ talk "That's more than your normal rates..."
    MC @ talk "それって普段の料金より高いんじゃ…"

# game/data/characters/arwen/dialogue.rpy:100
translate ja dialogue_arwen_services_cel_779f3c4e:

    # ARWEN @ angry "Do you know how much this outfit cost to make?"
    ARWEN @ angry "この衣装、作るのにいくらかかったかわかる？"

# game/data/characters/arwen/dialogue.rpy:101
translate ja dialogue_arwen_services_cel_0f93cc2b:

    # ARWEN @ talk "Plus all the rallies and things I had to attend to learn to act like her a bit."
    ARWEN @ talk "それに、彼女っぽく振る舞うコツを覚えるため、集会なんかにも参加させられてたし。"

# game/data/characters/arwen/dialogue.rpy:102
translate ja dialogue_arwen_services_cel_84c11618:

    # ARWEN @ laugh "Besides... I offer a {i}unique{/i} experience unlike what my clients normally get."
    ARWEN @ laugh "それに…私はお客様に{i}特別な{/i}体験を提供します。普段得られるものとは違う。"

# game/data/characters/arwen/dialogue.rpy:103
translate ja dialogue_arwen_services_cel_c7c5bcc5:

    # ARWEN @ talk "So, fifteen hundred. Interested?"
    ARWEN @ talk "で、千五百。興味ある？"

# game/data/characters/arwen/dialogue.rpy:106
translate ja dialogue_arwen_services_cel_67a3c006:

    # ARWEN @ talk "Then if you don't mind, other customers are waiting."
    ARWEN @ talk "では、お手数ですが
他のお客様がお待ちですので。"

