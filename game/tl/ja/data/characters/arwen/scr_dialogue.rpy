translate ja dialogue_arwen_othergirls_menu_paid_8e2a16c2:

    # ARWEN @ talk "Look around you, we're not the {i}Black Diamond,{/i} we general serve adventurers and merchants with coin to burn."
    ARWEN @ talk "周りを見回してごらん、ここは『{i}ブラック・ダイヤモンド{/i}』じゃない。おおむね、冒険者や商人で金に糸目をつけない連中を相手にしてるんだ。"

# game/data/characters/arwen/scr_dialogue.rpy:26
translate ja dialogue_arwen_othergirls_menu_paid_e4fcf857:

    # ARWEN @ talk "And she's out there letting the city guard take put it in her ass behind a wall... Hardly a good fit."
    ARWEN @ talk "彼女は壁の陰で町の衛兵にケツを掘らせてるんだ…似合わねぇよ。"

# game/data/characters/arwen/scr_dialogue.rpy:27
translate ja dialogue_arwen_othergirls_menu_paid_33eafac5:

    # MC @ talk "That seems rather harsh..."
