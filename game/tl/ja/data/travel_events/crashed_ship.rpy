# game/data/travel_events/crashed_ship.rpy:13
translate ja travel_event_crashed_ship_c7f49737:

    # BLACK "{i}...Going wrong way.{/i}"
    BLACK "{i}…違う方向に行っている。{/i}"

# game/data/travel_events/crashed_ship.rpy:15
translate ja travel_event_crashed_ship_73790772:

    # MC @ angry "We are not going the wrong way!"
    MC @ angry "私たちは間違った道を行っているわけじゃない!"

# game/data/travel_events/crashed_ship.rpy:16
translate ja travel_event_crashed_ship_1cd0e33a:

    # BLACK "{i}We are lost.{/i}"
    BLACK "{i}私たちは道に迷った。{/i}"

# game/data/travel_events/crashed_ship.rpy:17
translate ja travel_event_crashed_ship_71d2cf05:

    # MC @ angry "We are not lost!"
    MC @ angry "道に迷ってなんていない!"

# game/data/travel_events/crashed_ship.rpy:19
translate ja travel_event_crashed_ship_66dfd255:

    # MC @ talk "We just—"
    MC @ talk "私たちはただ――"

# game/data/travel_events/crashed_ship.rpy:21
translate ja travel_event_crashed_ship_90844184:

    # MC @ talk "We just need to find our—"
    MC @ talk "私たちはただ、私たちの…を見つける必要があるだけだ―"

# game/data/travel_events/crashed_ship.rpy:23
translate ja travel_event_crashed_ship_88b2ee55:

    # "Suddenly, I felt the earth crumble beneath me."
    "突然、足元の地面が崩れていくのを感じた。"

# game/data/travel_events/crashed_ship.rpy:26
translate ja travel_event_crashed_ship_934fef82:

    # "I gasped as I plummeted into a great chasm below."
    "私は巨大な裂け目へと墜落していき、息を呑んだ。"

# game/data/travel_events/crashed_ship.rpy:28
translate ja travel_event_crashed_ship_a4b26b88:

    # "The fall lasted only moments, wind whipping past as panic surged through me."
    "ほんの一瞬の落下、
風がビュッと通り過ぎる間、恐怖が走った。"

# game/data/travel_events/crashed_ship.rpy:29
translate ja travel_event_crashed_ship_b71673c2:

    # "One of my blackened tentacles shot out, anchoring into the wall and halting my descent."
    "漆黒の触手の一本が飛び出し、壁に食い込ませて、私の落下を食い止めた。"

# game/data/travel_events/crashed_ship.rpy:32
translate ja travel_event_crashed_ship_81a47010:

    # "Lowering myself carefully, I landed on a patch of dirt below, lit faintly by the chasm's natural opening."
    "慎重に身をかがめ、下の土の上に着地した。それは、隙間の自然な開口部から微かに照らされていた。"

# game/data/travel_events/crashed_ship.rpy:33
translate ja travel_event_crashed_ship_dda0aa4b:

    # MARKUS "Can you hear me?!"
    MARKUS "私の声が聞こえますか？!"

# game/data/travel_events/crashed_ship.rpy:34
translate ja travel_event_crashed_ship_354115c9:

    # MC @ talk "I'm alright."
    MC @ talk "大丈夫だよ。"

# game/data/travel_events/crashed_ship.rpy:35
translate ja travel_event_crashed_ship_6baba279:

    # "As my eyes adjusted, the full scale of the pit became clear."
    "目が慣れるにつれて、その巨大な陥没穴の全貌が明らかになった。"

# game/data/travel_events/crashed_ship.rpy:41
translate ja travel_event_crashed_ship_141d7189:

    # MC @ think "Is this... some kind of cave?"
    MC @ think "これって...洞窟かな？"

# game/data/travel_events/crashed_ship.rpy:43
translate ja travel_event_crashed_ship_f02ac22b:

    # "There, partially submerged in shallow water, was something metallic—a ship?"
    "浅瀬に半分沈んで、金属の何か――船なのだろうか？"

# game/data/travel_events/crashed_ship.rpy:44
translate ja travel_event_crashed_ship_e26d324c:

    # "Ruined and entangled in vines, the strange relic beckoned."
    "廃れ、蔦に絡まりし奇妙な遺物は、誘うように佇んでいた。"

# game/data/travel_events/crashed_ship.rpy:45
translate ja travel_event_crashed_ship_b3c9f1a5:

    # MARKUS "What do you see down there?!"
    MARKUS "下の方で何を見ているの？!"

# game/data/travel_events/crashed_ship.rpy:46
translate ja travel_event_crashed_ship_8ec5fa0b:

    # MC @ serious "You might want to come down here."
    MC @ serious "ここに来た方がいいかも。"

# game/data/travel_events/crashed_ship.rpy:48
translate ja travel_event_crashed_ship_4001a4a4:

    # "The others climbed down with caution."
    "他の者たちは慎重に降りていった。"

# game/data/travel_events/crashed_ship.rpy:50
translate ja travel_event_crashed_ship_f5a0c50b:

    # MARKUS @ shock "What in seven hells is that thing?"
    MARKUS @ shock "七つの地獄とは何だ？"

# game/data/travel_events/crashed_ship.rpy:51
translate ja travel_event_crashed_ship_11bcc543:

    # MC @ think "Some kind of ship?"
    MC @ think "何かの船？"

# game/data/travel_events/crashed_ship.rpy:52
translate ja travel_event_crashed_ship_539ee9fb:

    # MARKUS @ talk "Where are its sails?"
    MARKUS @ talk "その帆はどこ？"

# game/data/travel_events/crashed_ship.rpy:53
translate ja travel_event_crashed_ship_3dad54df:

    # MC @ think "Never seen a vessel like this... and this far from any sea?"
    MC @ think "こんな船は見たことがない…海からこれほど遠く離れて、いるのか？"

# game/data/travel_events/crashed_ship.rpy:57
translate ja travel_event_crashed_ship_0208f36a:

    # MYU @ scared "M-Myu? Metal thing scary..."
    MYU @ scared "み、みゅ？金物怖い…"

# game/data/travel_events/crashed_ship.rpy:62
translate ja travel_event_crashed_ship_8138fa88:

    # VES @ think "I've heard rumors of the Greater Trading Company reinforcing ships with armor, but this..."
    VES @ think "大交易会社が船に装甲を施したという噂は聞いていましたが…これは"

# game/data/travel_events/crashed_ship.rpy:63
translate ja travel_event_crashed_ship_e9cd7d09:

    # VES @ talk "This is nothing like anything I've ever seen."
    VES @ talk "これは私が今まで見たことのないものだ。"

# game/data/travel_events/crashed_ship.rpy:68
translate ja travel_event_crashed_ship_ba8e8344:

    # ELENA @ grumpy "Perhaps... a relic of the old gods?"
    ELENA @ grumpy "もしかすると…旧神の遺物か？"

# game/data/travel_events/crashed_ship.rpy:69
translate ja travel_event_crashed_ship_c90ffbe7:

    # ELENA @ grumpy "Judging by how deep this cavern is, it must've been buried here for thousands of years."
    ELENA @ grumpy "この洞窟の深さからすると、何千年も前に埋もれたものだろう。"

# game/data/travel_events/crashed_ship.rpy:75
translate ja travel_event_crashed_ship_985866dd:

    # SYPHA @ talk "{i}And so, in ages past, they rode mechanical beasts across the stars.{/i}"
    SYPHA @ talk "{i}かくして古の時代、彼らは機械の獣にまたがり、星々を駆け巡ったのだ。{/i}"

# game/data/travel_events/crashed_ship.rpy:76
translate ja travel_event_crashed_ship_bde6c2b6:

    # MC @ think "What?"
    MC @ think "なに？"

# game/data/travel_events/crashed_ship.rpy:77
translate ja travel_event_crashed_ship_c24c1193:

    # SYPHA @ think "Nothing. Just old legends from childhood."
    SYPHA @ think "何でもない。ただ子供の頃の古い伝説だ。"

# game/data/travel_events/crashed_ship.rpy:84
translate ja travel_event_crashed_ship_16bf6a3c:

    # MC @ serious "Whatever it is, I don't like it."
    MC @ serious "それが何であれ、好きじゃない。"

# game/data/travel_events/crashed_ship.rpy:85
translate ja travel_event_crashed_ship_cfd774db:

    # MC @ talk "Let's leave sleeping ghosts to rest."
    MC @ talk "眠っている亡霊はそのままにしておきましょう。"

# game/data/travel_events/crashed_ship.rpy:86
translate ja travel_event_crashed_ship_516553f1:

    # MARKUS @ talk "Agreed. Nothing good comes from disturbing the dead."
    MARKUS @ talk "同意だ。死者を冒涜するに良いことなど何もない。"

# game/data/travel_events/crashed_ship.rpy:88
translate ja travel_event_crashed_ship_013b3791:

    # "We climbed back out of the rift and resumed our journey."
    "裂け目から這い出ると、私たちは旅を再開した。"

# game/data/travel_events/crashed_ship.rpy:95
translate ja travel_event_crashed_ship_inside_4a677239:

    # "Carefully, I approached the wreck."
    "慎重に、私はその残骸に近づいた。"

# game/data/travel_events/crashed_ship.rpy:96
translate ja travel_event_crashed_ship_inside_c1071274:

    # "I stepped into the freezing water and laid my hand on the cold metal hull."
    "氷のような冷たい水に足を踏み入れ、冷たいメタルの船体に手を置いた。"

# game/data/travel_events/crashed_ship.rpy:101
translate ja travel_event_crashed_ship_inside_9ec1a37a:

    # "A hiss of steam sounded as the metal twisted open like a door."
    "シューッという蒸気音と共に、金属がドアのように捻じ開けられた。"

# game/data/travel_events/crashed_ship.rpy:102
translate ja travel_event_crashed_ship_inside_79a0bb39:

    # MARKUS @ shock "You're not actually going inside that thing, are you?"
    MARKUS @ shock "まさか、あの中に入るつもりじゃないよね？"

# game/data/travel_events/crashed_ship.rpy:103
translate ja travel_event_crashed_ship_inside_026bc247:

    # "I stepped in."
    "私は中に入った。"

# game/data/travel_events/crashed_ship.rpy:104
translate ja travel_event_crashed_ship_inside_970d0f74:

    # MARKUS @ angry "Gods be damned, man."
    MARKUS @ angry "まったく、神も仏もねぇ、男。"

# game/data/travel_events/crashed_ship.rpy:109
translate ja travel_event_crashed_ship_inside_bc2341db:

    # "Inside, it was cold."
    "内側は寒かった。"

# game/data/travel_events/crashed_ship.rpy:112
translate ja travel_event_crashed_ship_inside_4f0eba80:

    # "Our footsteps echoed across the metal floor."
    "足音が金属の床に響き渡った。"

# game/data/travel_events/crashed_ship.rpy:113
translate ja travel_event_crashed_ship_inside_b2b6c7a4:

    # "Pipes snaked along the walls, choked in vines and pierced by jagged rock."
    "壁に沿って蛇行するパイプは、蔦に覆われ、鋭い岩に貫かれている。"

# game/data/travel_events/crashed_ship.rpy:118
translate ja travel_event_crashed_ship_inside_bd8053a5:

    # "A ghostly figure flickered into view inside a glowing circle."
    "光る円の中で、ぼうっと姿を現した幽霊のような人影。"

# game/data/travel_events/crashed_ship.rpy:119
translate ja travel_event_crashed_ship_inside_472ec9d8:

    # MC @ angry "Who are you, specter?"
    MC @ angry "お前は、隠り子の霊か。"

# game/data/travel_events/crashed_ship.rpy:120
translate ja travel_event_crashed_ship_inside_bf2aaff8:

    # ANDRAS "This is Captain Andras of the Maylark."
    ANDRAS "こちらはメイラーク号のアンドラス船長です。"

# game/data/travel_events/crashed_ship.rpy:121
translate ja travel_event_crashed_ship_inside_365bbf88:

    # ANDRAS "Day four-hundred and ninety-six since the end of... well, everything."
    ANDRAS "あれ以来、四百九十六日目。"

# game/data/travel_events/crashed_ship.rpy:122
translate ja travel_event_crashed_ship_inside_bf38bc6e:

    # MARKUS @ think "Uhhh... hello?"
    MARKUS @ think "あの…こんにちは？"

# game/data/travel_events/crashed_ship.rpy:123
translate ja travel_event_crashed_ship_inside_18baf767:

    # MC @ think "I don't think he can hear us."
    MC @ think "彼は私たちの声が聞こえないと思う。"

# game/data/travel_events/crashed_ship.rpy:124
translate ja travel_event_crashed_ship_inside_b20d5e02:

    # ANDRAS "...{i}*Sigh*{/i} I don't even know why I bother with these things anymore."
    ANDRAS "……{i}*はあ*{/i} なんでこんなこと続けてるんだろ、もう。"

# game/data/travel_events/crashed_ship.rpy:125
translate ja travel_event_crashed_ship_inside_96afb379:

    # ANDRAS "It's not like there's actually anyone left to log it."
    ANDRAS "実際に記録を残す人がもう残っていないわけだ。"

# game/data/travel_events/crashed_ship.rpy:126
translate ja travel_event_crashed_ship_inside_62cfcc16:

    # ANDRAS "For over a year and a half we've jumped from one dead star to the next."
    ANDRAS "一年半以上、私たちは死んだ星から死んだ星へと飛び移ってきた。"

# game/data/travel_events/crashed_ship.rpy:127
translate ja travel_event_crashed_ship_inside_881f07eb:

    # ANDRAS "One nightmarish, monster infested world to another, searching for someplace safe."
    ANDRAS "悪夢のような、怪物に満ちた世界から次へと、安全な場所を求めて。"

# game/data/travel_events/crashed_ship.rpy:128
translate ja travel_event_crashed_ship_inside_e84fa312:

    # ANDRAS "I still tell the crew that's what we're looking for... Someplace safe."
    ANDRAS "今でもクルーにはそう言っている…  
それが私たちの探しているものだって。  
安全な場所。"

# game/data/travel_events/crashed_ship.rpy:129
translate ja travel_event_crashed_ship_inside_ec95d44a:

    # ANDRAS "I'd just settle for finding some food, fuel... anything now."
    ANDRAS "食べ物でも、燃料でも……今は何でもいいから見つけたいんだ。"

# game/data/travel_events/crashed_ship.rpy:130
translate ja travel_event_crashed_ship_inside_b3b6925c:

    # ANDRAS "It's been months since we found any survivors."
    ANDRAS "生存者を見つけてから数ヶ月が経つ。"

# game/data/travel_events/crashed_ship.rpy:131
translate ja travel_event_crashed_ship_inside_9fb46d95:

    # ANDRAS "Well, unless you count the cannibals and freaks."
    ANDRAS "まあ、人食い人種と変人を除けば。"

# game/data/travel_events/crashed_ship.rpy:132
translate ja travel_event_crashed_ship_inside_89d8f69d:

    # ANDRAS "... We have enough fuel for one last try, some unknown world ready on the edge of the Zelma ring."
    ANDRAS "……燃料は最後の一度分だけ。ゼルマリングの縁に、未確認の世界が待機中だ。"

# game/data/travel_events/crashed_ship.rpy:133
translate ja travel_event_crashed_ship_inside_5b2a8029:

    # ANDRAS "Atmospheric readings look good from orbit, and there seems to be no visual signs of corruption."
    ANDRAS "軌道上からの大気圏の計測データは良好で、腐食の視覚的兆候は見られないようです。"

# game/data/travel_events/crashed_ship.rpy:134
translate ja travel_event_crashed_ship_inside_8cd54f27:

    # ANDRAS "We'll probably stall out on the landing, but hopefully with power routed to the shields, we can at least survive the crash."
    ANDRAS "着陸時に失速する可能性は高いが、シールドに電力供給を切り替えておけば、墜落しても最低限の生存は望めるはずだ。"

# game/data/travel_events/crashed_ship.rpy:135
translate ja travel_event_crashed_ship_inside_bfea744e:

    # ANDRAS "May the new gods... Ahhh, fuck it."
    ANDRAS "新しき神々よ…ああ、もういいや。"

# game/data/travel_events/crashed_ship.rpy:136
translate ja travel_event_crashed_ship_inside_737f7819:

    # ANDRAS "{i}It's not like they're listening anymore anyway.{/i}"
    ANDRAS "{i}どうせ、もう誰も聞いてなんかいないんだ。{/i}"

# game/data/travel_events/crashed_ship.rpy:137
translate ja travel_event_crashed_ship_inside_9e72f391:

    # "There was momentary flickering of the strange figure summoned."
    "呼び出された奇妙な人影は、一瞬のちらつきがあった。"

# game/data/travel_events/crashed_ship.rpy:138
translate ja travel_event_crashed_ship_inside_0742b26c:

    # ANDRAS "Day, five hundred and two."
    ANDRAS "五百二日目。"

# game/data/travel_events/crashed_ship.rpy:139
translate ja travel_event_crashed_ship_inside_ce1c3d26:

    # ANDRAS "We survived the landing, but the ship's hull is too badly damaged to repair."
    ANDRAS "着陸は生き延びたが、船体の損傷は修理不可能なほどひどい。"

# game/data/travel_events/crashed_ship.rpy:140
translate ja travel_event_crashed_ship_inside_7ca46618:

    # ANDRAS "{i}*Chuckles*{/i} Not that we have to fuel left to go anywhere anyway."
    ANDRAS "{i}*クスクス*{/i} どっちみち、もうどこへも行けるだけの燃料は残っていないんだしね。"

# game/data/travel_events/crashed_ship.rpy:141
translate ja travel_event_crashed_ship_inside_ece942c3:

    # ANDRAS "The crew and I have decided to salvage what we can from the ship and head out."
    ANDRAS "乗組員と私は、船からできるだけ物資を回収し、出発することにした。"

# game/data/travel_events/crashed_ship.rpy:142
translate ja travel_event_crashed_ship_inside_7d01dea4:

    # ANDRAS "Maybe we can etch out some kind of existence out here."
    ANDRAS "ここで、私たちは何らかの生存を刻み出すことができるかもしれない。"

# game/data/travel_events/crashed_ship.rpy:143
translate ja travel_event_crashed_ship_inside_9c0c2393:

    # ANDRAS "It might be a simple life... {i}But at least we're alive.{/i}"
    ANDRAS "なんて、平凡な人生だろう…{i}少なくとも、私たちは生きている。{/i}"

# game/data/travel_events/crashed_ship.rpy:144
translate ja travel_event_crashed_ship_inside_2d52d85d:

    # ANDRAS "... The gods."
    ANDRAS "…神々。"

# game/data/travel_events/crashed_ship.rpy:145
translate ja travel_event_crashed_ship_inside_6c5751a7:

    # ANDRAS "How the fuck did it come to this?"
    ANDRAS "どうやったらこうなったんだよ、クソが。"

# game/data/travel_events/crashed_ship.rpy:146
translate ja travel_event_crashed_ship_inside_94c58f75:

    # ANDRAS "We blame it all on Malakai and his damned war, but in the end, maybe it was just our blind faith that sealed our fates."
    ANDRAS "我々は全てをマラカイと彼の忌まわしき戦争のせいにするが、結局は、我らの盲信こそが運命を決めたのかもしれない。"

# game/data/travel_events/crashed_ship.rpy:147
translate ja travel_event_crashed_ship_inside_2820ff0b:

    # ANDRAS "We always presumed the gods were better than us, wiser, {i}more{/i} than us."
    ANDRAS "我々は常に信じていた、神々は私たちより優れ、賢く、{i}さらに{/i}上を行く存在だと。"

# game/data/travel_events/crashed_ship.rpy:148
translate ja travel_event_crashed_ship_inside_b9ea5e3e:

    # ANDRAS "{i}But in the end, they fell to all the same trappings we do.{/i}"
    ANDRAS "{i}けれど結局は、彼らも私たちと同じ罠に陥ってしまったのだ。{/i}"

# game/data/travel_events/crashed_ship.rpy:149
translate ja travel_event_crashed_ship_inside_e5b270d3:

    # ANDRAS "{i}And they dragged everyone down with them.{/i}"
    ANDRAS "{i}そして彼らは皆を道連れにした。{/i}"

# game/data/travel_events/crashed_ship.rpy:150
translate ja travel_event_crashed_ship_inside_8a41f029:

    # ANDRAS "... Fuck the gods."
    ANDRAS "……神なんてクソくらえ。"

# game/data/travel_events/crashed_ship.rpy:151
translate ja travel_event_crashed_ship_inside_1216340c:

    # ANDRAS "This is Captain Andras of the Maylark, signing off for the last time."
    ANDRAS "こちらはマイラーク号のアンドラス船長、これが最後の通信となる。"

# game/data/travel_events/crashed_ship.rpy:152
translate ja travel_event_crashed_ship_inside_10ce0df8:

    # "The image flickered, then began replaying."
    "映像が揺らめくと、再生を始めた。"

# game/data/travel_events/crashed_ship.rpy:155
translate ja travel_event_crashed_ship_inside_9d9f6087:

    # MC @ think "What do you make of that?"
    MC @ think "どう思う？"

# game/data/travel_events/crashed_ship.rpy:157
translate ja travel_event_crashed_ship_inside_df5f47d2:

    # MARKUS @ talk "Jumping stars... Malakai's war... If this is from the Second War of the Gods... it's ancient."
    MARKUS @ talk "跳ねる星々…マラカイの戦争…もしこれが第二次神々の戦争のものなら…太古の物だ"

# game/data/travel_events/crashed_ship.rpy:161
translate ja travel_event_crashed_ship_inside_ad56e14d:

    # SYPHA @ talk "We shouldn't linger."
    SYPHA @ talk "ここで長居は良くない。"

# game/data/travel_events/crashed_ship.rpy:162
translate ja travel_event_crashed_ship_inside_613528ce:

    # SYPHA @ think "Let ghosts rest."
    SYPHA @ think "幽霊を安らかに眠らせてあげて。"

# game/data/travel_events/crashed_ship.rpy:171
translate ja travel_event_crashed_ship_inside_17813b31:

    # "Most of it had decayed."
    "そのほとんどが朽ち果てていた。"

# game/data/travel_events/crashed_ship.rpy:172
translate ja travel_event_crashed_ship_inside_1bcd7585:

    # "Anything that once had purpose crumbled in my hands."
    "かつて目的を持っていたものは、すべて私の手の中で崩れ落ちた。"

# game/data/travel_events/crashed_ship.rpy:173
translate ja travel_event_crashed_ship_inside_e4d9e770:

    # "Except... one thing."
    "ただし…一つだけ。"

# game/data/travel_events/crashed_ship.rpy:174
translate ja travel_event_crashed_ship_inside_d79ab9c3:

    # "A small metal box."
