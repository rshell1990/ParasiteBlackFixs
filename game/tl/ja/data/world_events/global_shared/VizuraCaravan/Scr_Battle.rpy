# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:4
translate ja vizura_caravan_battle_e61036f4:

    # GOBLIN "...Oh fuck!"
    GOBLIN "…ちくしょう!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:6
translate ja vizura_caravan_battle_1c3230d6:

    # GOBLIN "BOYS! GET OUT HERE! WE GOT TROUBLE!"
    GOBLIN "おいおい!　出て来いよ!　面倒なことになったぞ!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:7
translate ja vizura_caravan_battle_09f94aa0:

    # "A scurry of goblins with spears hurried out of the caravan, weapons ready!"
    "槍を持ったゴブリンたちがキャラバンから慌ただしく駆け出してくる、武器は構え済みだ!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:22
translate ja vizura_caravan_battle_0053b9db:

    # "With the goblins dead at my feet, I approached the caravan doors and pried them open to loot whatever was inside."
    "ゴブリンを足元に倒し、私は幌馬車の扉へと近寄り、こじ開けて中身を略奪した。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:23
translate ja vizura_caravan_battle_da239c8d:

    # "Inside, the caravan was filed with armour and weapons and trinkets ... But that wasn't what drew my eyes' attention."
    "幌馬車の中は、鎧や武器や小物で埋め尽くされていた…しかし、私の目を奪ったのはそれではなかった。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:24
translate ja vizura_caravan_battle_5d183913:

    # "A singular goblin, still alive and sat in the center of the caravan holding a barrel of what seemed to be some powder,"
    "一匹のゴブリンが、まだ生きていて、隊商馬車の中央に座り、何か粉のようなものの入った樽を抱えていた。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:25
translate ja vizura_caravan_battle_f8361fa0:

    # "...raised his middle finger to me and snarled before slashing at the powder to trigger a spark."
    "…彼は私に中指を立ててうなり声をあげると、粉に一閃を加えて火花を引き起こした。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:36
translate ja vizura_caravan_battle_d03313ac:

    # "Before I could stop him, the huge explosion sent me hurdling backwards as the caravan was engulfed in flames."
    "私が止める間もなく、大爆発が起こり、キャラバンが炎に包まれる中、私は吹き飛ばされた。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:38
translate ja vizura_caravan_battle_2379f606:

    # "The intense heat made me wince in pain as I painfully coughed up and exhaled the black smoke I had breathed in."
    "灼熱の熱気に、痛みで顔を歪めた。吸い込んだ黒煙を、苦しげに咳き込みながら吐き出した。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:43
translate ja vizura_caravan_battle_327911fb:

    # MARKUS @ shock "FUCK! Are you okay?"
    MARKUS @ shock "くそっ!大丈夫？"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:44
translate ja vizura_caravan_battle_bade04f4:

    # MC @ angry "{i}*Cough!* *Cough!*{/i} I'm fine, just... Urghh!"
    MC @ angry "{i}*ゴホン!* *ゴホン!*{/i} 大丈夫、ただ…うぐっ!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:45
translate ja vizura_caravan_battle_cffd8a42:

    # MARKUS @ angry "Green skins ... Can't trust any of them."
    MARKUS @ angry "緑の肌の奴ら…あいつらは誰一人信用ならねえ。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:46
translate ja vizura_caravan_battle_da8f9573:

    # MARKUS "You did the right thing, she'd have sunk a dagger in your back the moment she had a chance!"
    MARKUS "正しいことをしたんだ、あいつは機会さえあれば君の背中に短剣を刺していただろうからな!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:50
translate ja vizura_caravan_battle_012f5b7d:

    # MYU @ talk "MYUUUUU!"
    MYU @ talk "にゃあああ!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:51
translate ja vizura_caravan_battle_eb6168b3:

    # MYU @ sad "Myu was really scared!"
    MYU @ sad "ミュは本当に怖がってた!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:52
translate ja vizura_caravan_battle_8667ee16:

    # MC @ sad "Sorry - {i}*Cough!*{/i} Myu ... I'll try be more careful next time."
    MC @ sad "すみません - {i}*ゴホン!*{/i} ミュウ…今度から気を付けます。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:53
translate ja vizura_caravan_battle_d0f9ef7f:

    # MYU @ scared "N-No fight unless have to!"
    MYU @ scared "N-No…必要な時以外は戦わないで!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:57
translate ja vizura_caravan_battle_c3f414e5:

    # ELENA @ shock "What in all of the hells did you do that for?!"
    ELENA @ shock "何てことをしたんだ？!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:58
translate ja vizura_caravan_battle_e44adaae:

    # MC @ angry "{i}*Cough!* *Cough!*{/i} It was a trap!"
    MC @ angry "{i}*ゴホッ!* *ゴホッ!*{/i} 罠だ!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:59
translate ja vizura_caravan_battle_f06da0da:

    # ELENA @ angry "You don't know that!"
    ELENA @ angry "あなたはそれを知らないでしょう!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:60
translate ja vizura_caravan_battle_68f257ee:

    # ELENA @ angry "That was MADNESS!"
    ELENA @ angry "これは狂気だ!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:63
translate ja vizura_caravan_battle_95e73392:

    # MARKUS @ angry "Lay off she-wolf, you can't just assume everything is out to shake your hand and cuddle you!"
    MARKUS @ angry "雌狼はいい加減にしろよ、全ての相手が握手とか抱擁してくると思うなよ!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:64
translate ja vizura_caravan_battle_7ab574e5:

    # ELENA @ angry "WE DIDN'T EVEN GIVE THEM A CHANCE!"
    ELENA @ angry "奴らにチャンスすら与えなかった!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:65
translate ja vizura_caravan_battle_a4f13187:

    # MARKUS @ angry "They were armed! What more do you need?"
    MARKUS @ angry "奴らは武装してたぞ!他に何が必要だ？"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:66
translate ja vizura_caravan_battle_dfe09cab:

    # ELENA @ angry "EVERYONE IS ARMED ON THESE ROADS!"
    ELENA @ angry "この道路では全員が武装している!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:67
translate ja vizura_caravan_battle_28b29c79:

    # "Angrily, Elena stormed off, furious at what had happened."
    "怒って、エレナは起こったことに腹を立て、突進していった。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:72
translate ja vizura_caravan_battle_645d6701:

    # MARKUS "...She'll calm down eventually."
    MARKUS "…そのうちに落ち着くだろう。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:76
translate ja vizura_caravan_battle_28b29c79_1:

    # "Angrily, Elena stormed off, furious at what had happened."
    "怒りながら、エレナは起こったことに憤慨して立ち去った。"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Battle.rpy:80
translate ja vizura_caravan_battle_f54a6802:

    # "Looking over at the now ruins of the caravan turned black from the intense flames, I couldn't help but wonder if I'd made the right decision?"
    "強烈な炎で黒く焼け焦げた今は廃墟のキャラバンを見つめながら、私は正しい選択をしたのだろうか？"

