translate ja ev_Markus_tavern_postTwoEmps_32221592:

    # "Suddenly, between the heaving crowds, something caught my eye."
    "突然、押し合う人混みの間に、何かが私の目に留まった。"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:105
translate ja ev_Markus_tavern_postTwoEmps_8d8d34bc:

    # "A robed figure amongst them, staring right at me."
    "彼らの中に、ローブ姿の人物がいた。まっすぐに私を見つめている。"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:106
translate ja ev_Markus_tavern_postTwoEmps_9b476c08:

    # "Sypha's words rung through me ear of her sending an 'agent' to make contact with us, and I rose quickly to my feet, much to Adara's surprise."
    "シアファが「代理人」をこちらへ接触させるという言葉が耳に残り、私は慌てて飛び起きた。アダラは驚いた様子で。"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:108
translate ja ev_Markus_tavern_postTwoEmps_3bbaabc7:

    # MC @ talk "Adara, I'll be right back."
    MC @ talk "アドラ、すぐ戻る。"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:112
translate ja ev_Markus_tavern_postTwoEmps_64318277:

    # "As I pushed my way through the crowds to make my way towards them, the robed figure slipped outside into the cool night air."
    "人混みをかき分けながら、二人の方へ歩を進めたが、ローブ姿の影は冷たい夜気の中、外へ消えていた。"

translate ja strings:

    # game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:18
    old "Later..."
    new "その後..."

    # game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:32
    old "Maybe it was for the best they lied?"
    new "彼らが嘘をついたのも、良かったのかもしれない？"

    # game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:42
    old "You're right."
    new "その通りです。"

