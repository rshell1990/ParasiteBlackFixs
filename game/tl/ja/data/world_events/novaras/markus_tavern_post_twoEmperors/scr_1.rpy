# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_1.rpy:255
translate ja ev_Markus_tavern_postTwoEmps_kiaraMessage_627fa755:

    # KIARA @ sad "Trust me, I know it seems crazy and you have no reason to believe them."
    KIARA @ sad "信じてくれ、確かに非常識だし彼らを信じる理由なんてないけどさ。"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_1.rpy:256
translate ja ev_Markus_tavern_postTwoEmps_kiaraMessage_b274f3da:

    # KIARA "But the Mistress is the reason I'm back now and she's told me stuff that's going to have your head spinning when you hear it!"
    KIARA "でも、今私が戻ってきたのはミストレス様のおかげで、彼女が教えてくれたことには、聞いたら頭がクラクラするようなことばかりだよ!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_1.rpy:257
