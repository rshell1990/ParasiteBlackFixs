# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:130
translate ja qst_FromAnotherWorld_ReturnHome_ReginaTalk_e99550db:

    # "It felt like it belonged to some different time from a world now far away that I was no longer a part of."
