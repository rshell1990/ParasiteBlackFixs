    VES @ smile "あたしが……今度話してあげる。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3602
translate ja qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_f97d9bbc:

