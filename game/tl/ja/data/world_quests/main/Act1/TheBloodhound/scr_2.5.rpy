# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:122
translate ja qst_bloodhound_2_lake_postbattle_dravenham_f941d70a:

    # "Hand slid into his breastplate, Dravenham pulled out a bloodied note with something scrawled on it and handed it to me."
    "鎧の胸当てに手を滑り込ませ、ドラヴェンハムは血まみれのメモを引き出した。何かが走り書きで記されていて、それを私に手渡した。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:123
translate ja qst_bloodhound_2_lake_postbattle_dravenham_1e5ea53c:

    # DRAVENHAM "He... He gave me this..."
    DRAVENHAM "彼…彼がこれを…くださいました…"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:126
translate ja qst_bloodhound_2_lake_postbattle_dravenham_148d235b:

    # DRAVENHAM "Hey... I'm... I'm so cold now."
    DRAVENHAM "ねえ…今すごく…寒いよ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:127
translate ja qst_bloodhound_2_lake_postbattle_dravenham_edb522a6:

    # DRAVENHAM "I can't... I can't feel anything anymore."
    DRAVENHAM "もう…何も感じられない。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:128
translate ja qst_bloodhound_2_lake_postbattle_dravenham_1f905526:

    # DRAVENHAM "Please... {i}Please...{/i}"
    DRAVENHAM "お願い... {i}お願い...{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:129
translate ja qst_bloodhound_2_lake_postbattle_dravenham_122bf1a6:

    # DRAVENHAM "I don't want to die... I don't... I don't want to."
    DRAVENHAM "死にたくない…いや…死にたくないよ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:130
translate ja qst_bloodhound_2_lake_postbattle_dravenham_066e8c1f:

    # DRAVENHAM "I need to tell her... I need to tell-"
    DRAVENHAM "彼女に伝えなきゃ…伝えなきゃ——"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:131
translate ja qst_bloodhound_2_lake_postbattle_dravenham_4d440944:

    # "The man began to shake in my arms slightly, his body going into sharp spasms as he briefly wretched up some blood."
    "男は僕の腕の中で微かに震え出し、短く血を吐き戻すと、体は鋭い痙攣に襲われた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:132
translate ja qst_bloodhound_2_lake_postbattle_dravenham_c10509ff:

    # "His wide young eyes soon began to turn cloudy, and the final gasp escaped his lips as his body went limp."
    "若々しい大きな瞳はすぐに曇り始め、最後の息を吐き出した彼の体は力なく崩れ落ちた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:133
