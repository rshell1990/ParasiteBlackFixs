# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:2
translate ja qst_bloodhound_4_atFort_aed6965c:

    # "The next hour was a kind of blur as the mages dressed me and helped me stumble by way back towards Fort Sebastian."
    "次の一時間は、もやもやとした時間だった。魔法使いたちが私に服を着せ、セバスチャン砦へと戻る道のりを、よろよろと歩くのを助けてくれた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:5
translate ja qst_bloodhound_4_atFort_dbd56900:

    # "Brought into the Medical Ward, the nuns hurried over to treat me alongside the influx of other poor bastards."
    "診療棟へ運び込まれた私は、他の哀れな奴らと共に、修道女たちが駆けつけて手当てを施した。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:8
translate ja qst_bloodhound_4_atFort_6af63c0b:

    # "Here and there I noticed were a few Scouts."
    "所々にスカウトが数人いるのに気づいた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:9
translate ja qst_bloodhound_4_atFort_5d3a3559:

    # "Battered, broken, some had limbs missing."
    "傷つき、壊れ、肢を失った者もいた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:10
translate ja qst_bloodhound_4_atFort_7327635b:

    # "Laying beside them, I remembered how I hoped never to end up here again."
    "彼らの傍らに横たわりながら、またこんな場所に戻ることのないように願っていた昔の自分を思い出した。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:11
translate ja qst_bloodhound_4_atFort_b0c99eb3:

    # "Yet, here I was."
    "それでも、私はここにいた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:15
translate ja qst_bloodhound_4_atFort_08507bf0:

    # "Captain Nyx spoke to some of the Nuns."
    "キャプテン・ニクスは何人かの修道女に話しかけた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:19
translate ja qst_bloodhound_4_atFort_3357746f:

    # "As I struggled to stay awake, I couldn't focus on what was being said..."
    "眠気と戦いながら、話の内容が全く頭に入ってこなかった…"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:23
translate ja qst_bloodhound_4_atFort_1c58eea8:

    # "At some point, one of the nuns came to see me and fed me some holly sap for the pain."
    "いつの間にか、一人の修道女が私を見舞いに来て、痛み止めにヒイラギの樹液を飲ませてくれた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:27
translate ja qst_bloodhound_4_atFort_217b2342:

    # "Since my {i}change{/i}, I hadn't experienced pain like this."
    "{i}変化{/i}して以来、こんな痛みを味わったことはなかった。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:31
translate ja qst_bloodhound_4_atFort_32efdd9d:

    # "Every muscle ached as I felt numerous broken bones inside me struggling to mend."
    "全身の筋肉が痛み、体中の折れた骨が癒やそうと必死になっているのを感じた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:35
translate ja qst_bloodhound_4_atFort_fc7016e4:

    # MC "(What happened back there?)"
    MC "(あそこであれは一体何だったんだ？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:36
translate ja qst_bloodhound_4_atFort_e7f55388:

    # MC "(Shit shit! How in all the damn hells did she know about me?)"
    MC "(くそくそ!一体全体どうやって俺のことを知ってやがるんだ!？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:37
translate ja qst_bloodhound_4_atFort_0422337d:

    # MC "(Urghh... Why is the healing taking so long?)"
    MC "(ぐっ… なんで回復にこんなに時間がかかるんだ？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:38
translate ja qst_bloodhound_4_atFort_78cfcf79:

    # BLACK "The effects of the poison are still active within our bloodstream."
    BLACK "毒の効果は、まだ私たちの血流の中に残っている。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:39
translate ja qst_bloodhound_4_atFort_6f610828:

    # MC "(That thing it... {i}It nearly killed us{/i}.)"
    MC "(あの化物…{i}危うく殺されるところだった{/i}。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:40
translate ja qst_bloodhound_4_atFort_4ba8b71c:

    # BLACK "Yes."
    BLACK "はい。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:41
translate ja qst_bloodhound_4_atFort_10d9725d:

    # MC "(But how? I thought we were like, nearly impossible to kill or something!)"
    MC "(だってどうやって？　不死身みたいなもん…って聞いたよ？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:42
translate ja qst_bloodhound_4_atFort_0be017dd:

    # BLACK "This assessment is incorrect."
    BLACK "この評価は間違っている。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:43
translate ja qst_bloodhound_4_atFort_14f01e94:

    # MC "(What? Well... We've handled everything until now!)"
    MC "(え？だって…今まで全部やってきたんですよ!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:44
translate ja qst_bloodhound_4_atFort_f1fae085:

    # BLACK "Our battle form is durable but {i}not invincible{/i}, there are no doubt plenty of beings capable of killing us."
    BLACK "我々の戦闘形態は堅牢だが、{i}無敵ではない{/i}。
我々を殺せる存在は数多く存在するだろう。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:45
translate ja qst_bloodhound_4_atFort_cc99b660:

    # MC "(Well, there goes my power fantasy I guess.)"
    MC "(まあ、これで私のパワーファンタジーもおしまいかな。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:46
translate ja qst_bloodhound_4_atFort_5e79a34e:

    # BLACK "The battle form, like all abilities, must be nurtured to develop."
    BLACK "戦闘形態は、あらゆる能力と同様に、育成されなければならない。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:47
translate ja qst_bloodhound_4_atFort_c7d003c0:

    # MC "(You mean like, I have to train more?)"
    MC "(つまり、もっと練習しなきゃいけないってことかな？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:48
translate ja qst_bloodhound_4_atFort_e6b63194:

    # BLACK "Yes, your body will adapt and evolve to handle greater threats."
    BLACK "確かに、君の体はより大きな脅威に対処できるよう順応し、進化するだろう。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:49
translate ja qst_bloodhound_4_atFort_f7a97492:

    # MC "(Great... That's something at least.)"
    MC "(よかった…少なくともそれだけは。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:51
translate ja qst_bloodhound_4_atFort_17a87d51:

    # "The thought of facing that {i}thing{/i} again filled me with dread."
    "再びあの{i}化け物{/i}に直面することを考えると、恐怖が走った。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:52
translate ja qst_bloodhound_4_atFort_339483ae:

    # "As the holly sap took effect, I drifted off to sleep, haunted by the images of it's horrible face charging towards me."
    "聖なる樹液が効き始めると、私は眠りに落ち、襲いかかるあの恐ろしい顔の幻影に苛まれながら。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:59
translate ja qst_bloodhound_4_atFort_b88fb49b:

    # "Towards {i}us{/i}."
    "私たち{i}へ{/i}。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:64
translate ja qst_bloodhound_4_atFort_0cf7c79e:

    # "A few hours later..."
    "数時間後…"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:73
translate ja qst_bloodhound_4_atFort_9efa6cee:

    # NYX @ shock "Feeing alright?"
    NYX @ shock "調子はどう？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:75
translate ja qst_bloodhound_4_atFort_b8905269:

    # MC @ talk "Yeah... Never better."
    MC @ talk "ああ…
最高だよ"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:76
translate ja qst_bloodhound_4_atFort_359034a0:

    # NYX @ talk "You look like shit."
    NYX @ talk "お前、クソみたいだ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:77
translate ja qst_bloodhound_4_atFort_dfbe28ad:

    # MC @ talk "Well, I feel like shit so..."
    MC @ talk "あー、最悪な気分だから…"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:79
translate ja qst_bloodhound_4_atFort_b9fc5142:

    # "Captain Nyx forced a faint smile before nodding softly."
    "キャプテン・ニクスはかすかな微笑みを浮かべて、そっと頷いた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:80
translate ja qst_bloodhound_4_atFort_b01b2cf5:

    # NYX @ talk "I suppose you've got questions."
    NYX @ talk "きっと質問があるんでしょうね。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:81
translate ja qst_bloodhound_4_atFort_291c5b81:

    # MC @ talk "Damn right."
    MC @ talk "その通りだよ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:86
translate ja qst_bloodhound_4_hospital_nyxChoices_e4ee6136:

    # NYX @ talk "I've had you both followed since your return."
    NYX @ talk "帰ってからずっと、二人を尾行させていた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:87
translate ja qst_bloodhound_4_hospital_nyxChoices_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "えっ？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:88
translate ja qst_bloodhound_4_hospital_nyxChoices_27426e03:

    # NYX @ angry "When you and your friend returned, under the circumstances you did, I didn't buy that you just strolled your way back to Novaras in record time."
    NYX @ angry "お前たちが置かれた状況では、ノヴァラスまで記録的な速さでのんびり戻れたとは信じられなかった。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:89
translate ja qst_bloodhound_4_hospital_nyxChoices_b21889a2:

    # NYX @ angry "At first, I considered you being Demorai spies."
    NYX @ angry "最初、君たちはデモライの諜報員だと思っていた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:90
translate ja qst_bloodhound_4_hospital_nyxChoices_6004d9d1:

    # NYX @ talk "So, I called in some favors and had you followed."
    NYX @ talk "だから、私が顔を利かせて君を追跡させたんだ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:91
translate ja qst_bloodhound_4_hospital_nyxChoices_9e1a4c12:

    # MC @ angry "Why not just tell me!"
    MC @ angry "なぜただ私に言わないの!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:92
translate ja qst_bloodhound_4_hospital_nyxChoices_b1ccbf77:

    # NYX @ talk "I needed to test where your loyalties laid."
    NYX @ talk "君の忠誠心がどこにあるのか試す必要があった。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:93
translate ja qst_bloodhound_4_hospital_nyxChoices_c5e54f3e:

    # NYX @ laugh "Oh, and the whole strolling into the desert to change thing? Not very smart."
    NYX @ laugh "ああ、それに、砂漠をさまようことで何かを変えようとするなんて、あまり賢くないね。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:94
translate ja qst_bloodhound_4_hospital_nyxChoices_bae1966c:

    # NYX @ angry "Did you really think heading out there wasn't going to draw some attention?"
    NYX @ angry "本当に外へ出ていくことが注目を集めないわけないと思ったのか？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:95
translate ja qst_bloodhound_4_hospital_nyxChoices_2221d04f:

    # NYX @ talk "You're going to need to learn to be smarter than that."
    NYX @ talk "もっと利口になることを学ばないとね。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:96
translate ja qst_bloodhound_4_hospital_nyxChoices_98840fbf:

    # MC @ angry "You used me."
    MC @ angry "あなたは私を利用した。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:97
translate ja qst_bloodhound_4_hospital_nyxChoices_c9fb01dc:

    # NYX @ angry "This is war, you'll get used to being used."
    NYX @ angry "これが戦争だ、利用されることにも慣れるさ"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:101
translate ja qst_bloodhound_4_hospital_nyxChoices_9310a365:

    # NYX @ talk "I have no idea."
    NYX @ talk "さっぱり分からない。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:102
translate ja qst_bloodhound_4_hospital_nyxChoices_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "えっ？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:103
translate ja qst_bloodhound_4_hospital_nyxChoices_1b3b6fcb:

    # NYX @ shock "I knew Azul was onto something big but... I didn't anticipate that."
    NYX @ shock "アズールが大きな何かに手を付けているのは知っていたが…まさかそこまでは予想していなかった。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:104
translate ja qst_bloodhound_4_hospital_nyxChoices_d155dda6:

    # NYX @ angry "All of Azul's private documents and scrolls have been taken, no doubt destroyed."
    NYX @ angry "アズールの私文書や巻物はすべて持ち去られ、間違いなく破棄されたことだろう。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:108
translate ja qst_bloodhound_4_hospital_nyxChoices_564cd451:

    # NYX @ shock "...I'm sorry, I predicted there might be a trap waiting for whoever I sent."
    NYX @ shock "…すみません、送り込む相手に罠があるかもと予想していました。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:109
translate ja qst_bloodhound_4_hospital_nyxChoices_1a9930c7:

    # NYX @ talk "I knew that, with your abilities, you had a better chance handling whatever was thrown at you."
    NYX @ talk "君の能力なら、どんな問題が起こっても対処できる可能性が高いとわかっていた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:110
translate ja qst_bloodhound_4_hospital_nyxChoices_c34a59ad:

    # NYX @ talk "But I still made sure to tail you, I couldn't be sure for whatever was waiting and expected the worst."
    NYX @ talk "しかし、私はまだ確信が持てず、最悪の事態を覚悟して、あなたを尾行することにした。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:111
translate ja qst_bloodhound_4_hospital_nyxChoices_1efaa6b8:

    # MC @ talk "Could have done better with you about five minutes earlier into the fight."
    MC @ talk "戦いが始まって5分早く君と出会えていれば、間に合ってたんだが。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:112
translate ja qst_bloodhound_4_hospital_nyxChoices_6442fbae:

    # NYX @ angry "We moved as quickly as we could without drawing attention."
    NYX @ angry "私たちは目立たないよう最速で移動した。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:116
translate ja qst_bloodhound_4_hospital_nyxChoices_230bd269:

    # NYX @ talk "No."
    NYX @ talk "いいえ"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:117
translate ja qst_bloodhound_4_hospital_nyxChoices_2d204a49:

    # MC "..."
    MC "…"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:118
translate ja qst_bloodhound_4_hospital_nyxChoices_69710195:

    # NYX @ talk "You're a valuable asset, and I'm fairly confident now whose side you're on."
    NYX @ talk "貴重な戦力だ、そして君がどちらの味方か、ほぼ確信している。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:119
translate ja qst_bloodhound_4_hospital_nyxChoices_e9e95609:

    # NYX @ angry "That said, others may not feel the same."
    NYX @ angry "とは言え、他の人は同じように感じないかもしれない。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:120
translate ja qst_bloodhound_4_hospital_nyxChoices_bb396a64:

    # MC @ talk "So... No one else knows?"
    MC @ talk "じゃあ…他には誰も知らないの？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:121
translate ja qst_bloodhound_4_hospital_nyxChoices_8e345629:

    # NYX @ talk "Your secret is still safe."
    NYX @ talk "君の秘密はまだ守られている。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:122
translate ja qst_bloodhound_4_hospital_nyxChoices_27b1a111:

    # MC @ talk "But, the inquisitors-"
    MC @ talk "だが、審問官は——"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:123
translate ja qst_bloodhound_4_hospital_nyxChoices_543f491c:

    # NYX @ angry "Fuck the inquisitors."
    NYX @ angry "くたばれ、異端審問官ども。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:124
translate ja qst_bloodhound_4_hospital_nyxChoices_078ca3b0:

    # NYX @ angry "And fuck Lukkan and the others."
    NYX @ angry "そして、ルッカンたちはくたばれ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:125
translate ja qst_bloodhound_4_hospital_nyxChoices_e295341a:

    # NYX @ angry "The city Watch needs all the help it can get, and none of those fuckers are willing to lift a damn finger to help if it involves pulling from their precious sectors."
    NYX @ angry "街の監視団はあらゆる手助けを必要としているが、奴らは自分たちの大切な管区から人手を引き抜くことになると、クソ野郎どもは指一本動かそうとしねえ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:126
translate ja qst_bloodhound_4_hospital_nyxChoices_3ff61c69:

    # NYX @ talk "I may call upon you again, for help."
    NYX @ talk "また、あなたに頼ることもあるかもしれない。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:127
translate ja qst_bloodhound_4_hospital_nyxChoices_0466bb7a:

    # NYX @ angry "You may be one of the only few in this wretched city I actually know I can trust."
    NYX @ angry "この惨めな街で、君は数少ない私が信頼できると言える人間の一人かもしれない。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:130
translate ja qst_bloodhound_4_hospital_nyxChoices_0f796eb3:

    # MC @ talk "I'm done with questions..."
    MC @ talk "もう質問はたくさんだ…"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:131
translate ja qst_bloodhound_4_hospital_nyxChoices_310c3340:

    # MC @ talk "What now?"
    MC @ talk "どうする？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:132
translate ja qst_bloodhound_4_hospital_nyxChoices_c93cf8f4:

    # NYX @ talk "Not much, you go back to doing whatever it is you were doing before."
    NYX @ talk "別に、さっきまでやってたことに戻るだけさ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:133
translate ja qst_bloodhound_4_hospital_nyxChoices_8d9965eb:

    # MC @ talk "But... The investigation?"
    MC @ talk "でも…調査は？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:134
translate ja qst_bloodhound_4_hospital_nyxChoices_d08d005d:

    # NYX @ talk "Not your responsibility anymore."
    NYX @ talk "もう君の責任じゃない。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:135
translate ja qst_bloodhound_4_hospital_nyxChoices_e5b291a8:

    # NYX @ talk "At least, until I can do some more digging into what Azul found."
    NYX @ talk "少なくとも、アズールが見つけたものを、もう少し調べられるまでは。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:137
translate ja qst_bloodhound_4_hospital_nyxChoices_83b8fbc8:

    # MC @ talk "...That {i}thing.{/i}"
    MC @ talk "…あの{i}化物{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:138
translate ja qst_bloodhound_4_hospital_nyxChoices_df7f4b5b:

    # NYX @ talk "Returned to its master, no doubt."
    NYX @ talk "持ち主のもとに戻った、間違いない。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:139
translate ja qst_bloodhound_4_hospital_nyxChoices_4bcd9b36:

    # MC @ talk "{i}Master?{/i} You mean-"
    MC @ talk "{i}ご主人様？{/i}えっと、"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:140
translate ja qst_bloodhound_4_hospital_nyxChoices_c9c2e169:

    # NYX @ angry "Yes, that thing serves to cover the tracks of it's master."
    NYX @ angry "あの物は、その主の痕跡を隠すために存在しているのだ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:141
translate ja qst_bloodhound_4_hospital_nyxChoices_2207c685:

    # MC @ talk "How do you know?"
    MC @ talk "なぜ知っているの？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:142
translate ja qst_bloodhound_4_hospital_nyxChoices_c5aabc37:

    # NYX @ talk "Whatever Azul uncovered brought him into the sights of some {i}powerful{/i} people."
    NYX @ talk "アズールが明るみにしたものは、彼を幾人かの{i}有力者{/i}たちの標的にした。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:143
translate ja qst_bloodhound_4_hospital_nyxChoices_a0d4bfdb:

    # NYX @ talk "That thing didn't just kill him, it destroyed all of the sensitive information Azul had been gathering."
    NYX @ talk "あの化物は彼を殺しただけじゃない、アズールが収集していた機密情報をすべて破壊したんだ!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:144
translate ja qst_bloodhound_4_hospital_nyxChoices_c1fe3b09:

    # NYX @ angry "Whatever he found, Azul got too close."
    NYX @ angry "彼が見つけたものに、アズールは近づきすぎた。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:145
translate ja qst_bloodhound_4_hospital_nyxChoices_a70e4233:

    # MC @ talk "...If that {i}thing{/i} had already killed Azul, why leave the body like that?"
    MC @ talk "…あの『もの』が、すでにアズールを殺していたなら、なぜ死体をあんな風にしたのか。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:146
translate ja qst_bloodhound_4_hospital_nyxChoices_7eb21b6a:

    # MC @ talk "Why was the thing still down there... {i}waiting?{/i}"
    MC @ talk "まだあそこにあったのか…{i}「待っていた」のか？{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:147
translate ja qst_bloodhound_4_hospital_nyxChoices_19b37a1a:

    # NYX @ angry "I believe it was waiting {i}for me.{/i}"
    NYX @ angry "それが{i}私を{/i}待っていたのだと思う。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:148
translate ja qst_bloodhound_4_hospital_nyxChoices_0a6e91e3:

    # NYX @ angry "No doubt whoever is at play here knows of my involvement and would rather have me silenced."
    NYX @ angry "間違いなく、これを仕組んだ者は私の関与を知っており、私を黙らせたいと思っているだろう。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:149
translate ja qst_bloodhound_4_hospital_nyxChoices_a8914fff:

    # NYX @ angry "As for why the body was left there?"
    NYX @ angry "なぜ遺体があそこに放置されていたのか？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:150
translate ja qst_bloodhound_4_hospital_nyxChoices_4b0c0176:

    # NYX @ angry "Perhaps as a warning... A message, in case that monster failed."
    NYX @ angry "警告として…その化物が失敗した場合に備えての、メッセージ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:151
translate ja qst_bloodhound_4_hospital_nyxChoices_4331e288:

    # "I felt ill with the thought."
    "その考えに胸が悪くなった。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:152
translate ja qst_bloodhound_4_hospital_nyxChoices_47394e6f:

    # "What kind of a person leaves a warning like {i}that?{/i}"
    "どんな人が{i}あれ？{/i}って警告を残すんだよ、まったく。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:153
translate ja qst_bloodhound_4_hospital_nyxChoices_91172795:

    # NYX @ talk "...Oh, that reminds me, here."
    NYX @ talk "……そういえば、これ。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:154
translate ja qst_bloodhound_4_hospital_nyxChoices_c565abe5:

    # NYX @ talk "Your reward."
    NYX @ talk "お前への褒美。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:157
translate ja qst_bloodhound_4_hospital_nyxChoices_718bb0b3:

    # NYX @ talk "Well, I best leave you be for now."
    NYX @ talk "そろそろ、私、行くね。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:159
translate ja qst_bloodhound_4_hospital_nyxChoices_dadbefbb:

    # NYX @ angry "{i}You might be in their sights too now.{/i}"
    NYX @ angry "{i}あなたも今、彼らの標的になっているかもしれない。{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:161
translate ja qst_bloodhound_4_hospital_nyxChoices_9ee63cbf:

    # "As Nyx left, I dropped my head back onto the pillow."
    "ニクスが去ると、私は枕に頭を戻した。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:165
translate ja qst_bloodhound_4_hospital_nyxChoices_081ba91b:

    # MC "(...Fucking great.)"
    MC "(…最高だよ。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:170
translate ja qst_bloodhound_4_hospital_nyxChoices_9650db8e:

    # "A couple hours later, a nun came by and said I could leave now."
    "数時間後、修道女がやってきて、もう出て行っていいと言った。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:171
translate ja qst_bloodhound_4_hospital_nyxChoices_15ffe5e3:

    # "Leaving the hospital ward, I let out a grim chuckle at myself hoping to not end up here again."
    "病室を出ながら、二度とここに戻らなくて済みますようにと、自分に向かって不敵な笑みを漏らした。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:172
translate ja qst_bloodhound_4_hospital_nyxChoices_aca943c2:

    # MC "(Back into the world of the living...)"
    MC "(再び現世へ…)"

