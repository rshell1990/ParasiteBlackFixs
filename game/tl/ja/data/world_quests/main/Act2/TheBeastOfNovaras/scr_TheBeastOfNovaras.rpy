# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2039
translate ja qst_TheBeastOfNovaras_TalkToGarenBar_cacf25ce:

    # MC @ serious "(Well... I have some time before Garen returns.)"
    MC @ serious "(さて… ガレンが戻ってくるまで少し時間があるわ。)"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2040
translate ja qst_TheBeastOfNovaras_TalkToGarenBar_00dfcaa0:

    # MC @ serious "(I should tread careful with this Sypha, she's no doubt toying with me.)"
    MC @ serious "(このシファとは慎重に進むべきだ、彼女は間違いなく私をからかっている。)"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2041
translate ja qst_TheBeastOfNovaras_TalkToGarenBar_c1b28386:

