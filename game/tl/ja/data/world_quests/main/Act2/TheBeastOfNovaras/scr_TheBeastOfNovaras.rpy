    SYPHA @ happy "{i}二人きりだ。{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2026
translate ja qst_TheBeastOfNovaras_TalkToGarenBar_64b99b7e:

