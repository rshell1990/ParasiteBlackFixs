    YARRICK @ smile "さて、予想以上にうまくいったな。"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1859
translate ja qst_TheBeastOfNovaras_ZanzibatHouse_8183380c:

