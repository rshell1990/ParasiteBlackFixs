    # LADY_TARBECK @ angry "I have no interest in these games!"
    LADY_TARBECK @ angry "こんな遊びには興味がないの！"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:25
