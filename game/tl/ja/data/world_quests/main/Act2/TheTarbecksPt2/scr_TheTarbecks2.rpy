    LADY_BELAMORE @ smile "話し合うことが山ほどあるわ！"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:238
translate ja qst_TheTarbecks2_enter_manor_265560b9:

