    MC "あなたは…あなたは女の子の{i}あそこ{/i}を触るつもりなの？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:582
translate ja qst_Terminus_EnterPalace_5c828bc0:

    # MARKUS "Come on, we both know you’re not a virgin."
    MARKUS "ねえ、君が処女じゃないってことは二人とも分かってるでしょ。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:583
translate ja qst_Terminus_EnterPalace_cf6a14ef:

    # MC "Y-Yeah, but..."
    MC "あ、あの…でも…"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:584
