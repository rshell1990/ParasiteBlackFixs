    # MARKUS @ think "And here I figured blood sacrifices were something you would appreciate!"
    MARKUS @ think "そしてここで私は、血の生贄はあなたが好むものだろうと思っていたよ！"

# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:300
translate ja qst_BigTroubleLHamun_temple_dials_first_enter_2a847363:

