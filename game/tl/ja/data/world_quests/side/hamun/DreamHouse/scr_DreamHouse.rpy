translate ja qst_dreamhouse_l2_start_00107977:

    # KIARA @ scared "{i}Different?{/i}"
    KIARA @ scared "{i}変わってない？{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:698
translate ja qst_dreamhouse_l2_start_cd543de7:

    # "As I looked around, I realized Kiara was indeed right."
    "周りを見渡すと、確かにキアラの言う通りだと気づいた。"

