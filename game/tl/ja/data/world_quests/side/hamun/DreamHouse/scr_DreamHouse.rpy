    MC @ think "色々なもの？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2370
translate ja qst_dreamhouse_final_housescene_522cf4e9:

    # MC @ surprised "I..."
    MC @ surprised "私は…"

