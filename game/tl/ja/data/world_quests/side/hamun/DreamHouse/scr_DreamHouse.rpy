# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:849
translate ja qst_dreamhouse_l2_nursery_oneoff_aec2ef82:

    # "Entering the room, the twisted corpses inside turned their attention towards us."
    "部屋に入ると、中の歪んだ死体たちが私たちに注意を向けた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:850
translate ja qst_dreamhouse_l2_nursery_oneoff_f98f618e:

    # MC @ scared "Shit!"
    MC @ scared "クソ！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:864
translate ja qst_dreamhouse_l2_toys_caf4fb7b:

    # "Blood-stained and torn up toys."
    "血まみれで引き裂かれたおもちゃ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:868
translate ja qst_dreamhouse_l2_crib_fd87f1dd:

    # "A crib stained in blood."
    "血に染まった揺りかご。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:873
translate ja qst_dreamhouse_l2_bedroom_door_8e18cd77:

    # MC "(We need the key to unlock this!)"
    MC "（これの鍵を開けるには鍵が必要だ！）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:877
translate ja qst_dreamhouse_l2_bedroom_door_918f304d:

    # "Inserting the key into the lock, the door swung open as we scrambled through,"
    "鍵を鍵穴に差し込むと、ドアが勢いよく開き、私たちは慌てて通り抜けた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:879
translate ja qst_dreamhouse_l2_bedroom_door_538a8f11:

    # "a bright white light enveloping us all as we did so."
    "そうする中で、明るい白い光が私たち全員を包み込んだ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:887
translate ja qst_dreamhouse_l2_candle_4040ce45:

    # MC @ think "(A blue flame... Why?)"
    MC @ think "（青い炎…なぜ？）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:893
translate ja qst_dreamhouse_l2_dining_oneoff_82f181a3:

    # "Entering the dining hall, the table had become a ghoulish display of gore, as the creatures crowded around it."
    "食堂に入ると、テーブルはグロテスクな血みどろの展示場と化し、クリーチャーたちがその周りに群がっていた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:894
translate ja qst_dreamhouse_l2_dining_oneoff_d8a8a7a0:

    # "Guts, blood, and indiscernible flesh sprawled across the table as they grabbed at the meat with their bare hands and devoured it."
    "内臓、血、見分けのつかない肉片がテーブルに散らばり、彼らは素手で肉を掴んで貪り食っていた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:895
translate ja qst_dreamhouse_l2_dining_oneoff_d34ae079:

    # "The wretched smell of rot and death was too much for Kiara, who hurled onto the floor."
    "腐敗と死の惨めな臭いにキアラは耐えきれず、床に吐しゃ物をまき散らした。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:896
translate ja qst_dreamhouse_l2_dining_oneoff_fdae0222:

    # KIARA @ scared "Oh gods..."
    KIARA @ scared "ああ神様…"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:897
translate ja qst_dreamhouse_l2_dining_oneoff_6f1abb01:

    # "As she did so, the dead looked up, dropping the meat in their hands as they began shambling towards us!"
    "彼女がそうすると、死者たちが顔を上げ、手に持った肉を落として私たちによろめきながら向かってきた！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:900
translate ja qst_dreamhouse_l2_dining_oneoff_6e8ae10d:

    # MARKUS @ angry "I FUCKING HATE THIS HOUSE!"
    MARKUS @ angry "この家が大っ嫌いだ！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:911
translate ja qst_dreamhouse_l2_dining_oneoff_a623fccf:

    # MARKUS @ shock "{i}*Huff*{/i} I think that's the last of them."
    MARKUS @ shock "{i}*ハァ*{/i} これで最後だと思う。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:914
translate ja qst_dreamhouse_l2_dining_oneoff_fdd90545:

    # VES @ angry "These creatures only fall when their head is cleaved from their neck!"
    VES @ angry "これらのクリーチャーは頭を首から切り離された時にだけ倒れる！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:916
translate ja qst_dreamhouse_l2_dining_oneoff_b8b1ec09:

    # VES @ angry "How tedious!"
    VES @ angry "なんて面倒な！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:919
translate ja qst_dreamhouse_l2_dining_oneoff_4b748bc8:

    # SYPHA @ think "We can't stay here, come on."
    SYPHA @ think "ここにはいられない、来て。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:924
translate ja qst_dreamhouse_l2_table_f89a89b8:

    # "(... Gods, what a nightmare.)"
    "（…なんて悪夢だ。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:929
translate ja qst_dreamhouse_l2_wolfhead_a1f17cb0:

    # "BARK!"
    "ワン！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:930
translate ja qst_dreamhouse_l2_wolfhead_4f314bba:

    # "The mounted head snapped towards me with its jaws."
    "剥製の頭が顎で私に向かって噛みついた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:931
translate ja qst_dreamhouse_l2_wolfhead_41224f04:

    # "(Is it... Is it still alive?)"
    "（これは…まだ生きてるのか？）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:936
translate ja qst_dreamhouse_l2_portrait_d934f7a2:

    # "That's... disturbing."
    "それは…不気味だ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:942
translate ja qst_dreamhouse_l2_kitchen_oneoff_b0b44ff1:

    # "As we entered the kitchen, I heard the slamming of the cleaver as we looked to find one of the dead,"
    "キッチンに入ると、包丁が叩きつけられる音が聞こえ、見ると死者の一匹が——"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:943
translate ja qst_dreamhouse_l2_kitchen_oneoff_f0272186:

    # "a huge, decrepit, bulking figure hacking away at a man."
    "巨大で朽ち果てた、がっしりした姿が男を切り刻んでいた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:944
translate ja qst_dreamhouse_l2_kitchen_oneoff_ec7e5b88:

    # "Still barely alive and choking on blood, the man reached out towards us in one desperate final act, only for the creature to hack off his fingers with the cleaver."
    "まだかろうじて生きていて血に咽びながら、男は最後の絶望的な行動として私たちに手を伸ばしたが、クリーチャーは包丁で彼の指を切り落とした。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:945
translate ja qst_dreamhouse_l2_kitchen_oneoff_e99e910f:

    # "As the fingers dropped to the floor, the ghoulish creature turned towards us, placing down a platter of the man's remains on the table,"
    "指が床に落ちると、グールのようなクリーチャーは私たちに向き直り、男の残骸の大皿をテーブルに置き、"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:946
translate ja qst_dreamhouse_l2_kitchen_oneoff_b108b59f:

    # "it then stared blankly towards us, expectantly."
    "それから無表情で私たちを期待して見つめた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:947
translate ja qst_dreamhouse_l2_kitchen_oneoff_64cf87e1:

    # MARKUS @ scared "Does... Does this fucking thing expect us to eat that?!"
    MARKUS @ scared "こ、このクソ野郎は私たちにそれを食えって言うのか？！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:950
translate ja qst_dreamhouse_l2_kitchen_oneoff_53d44a4b:

    # "Carefully, I reached over to grab a piece of the meat."
    "慎重に、肉の一片を掴もうと手を伸ばした。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:951
translate ja qst_dreamhouse_l2_kitchen_oneoff_2f9ce75e:

    # "With a shaky hand, I pushed the wet meat into my mouth as the creature offered a drooling grin of approval."
    "震える手で、濡れた肉を口に押し込むと、クリーチャーは承認のよだれまみれの笑みを浮かべた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:952
translate ja qst_dreamhouse_l2_kitchen_oneoff_ed932dcd:

    # "Markus pulled back in revulsion as Kiara looked like she was about to hurl."
    "マーカスは嫌悪で後退りし、キアラは吐きそうな顔をしていた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:953
translate ja qst_dreamhouse_l2_kitchen_oneoff_2bce3932:

    # "The wet meat squeelched between my teeth, almost making me wretch as my eyes began to water from the foul taste."
    "濡れた肉が歯の間でぐちゃぐちゃと音を立て、不快な味に目が潤み始め、吐きそうになった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:954
translate ja qst_dreamhouse_l2_kitchen_oneoff_cf947b80:

    # KIARA @ sad "Oh gods... I might... I think I'm gonna be sick."
    KIARA @ sad "ああ神様…私…吐きそう。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:955
translate ja qst_dreamhouse_l2_kitchen_oneoff_d069021e:

    # MARKUS @ scared "What in the hells is wrong with you?"
    MARKUS @ scared "お前、何がおかしいんだ？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:956
translate ja qst_dreamhouse_l2_kitchen_oneoff_d73d8a37:

    # SYPHA @ think "... Is this is some kind of masochistic ritual humans perform?"
    SYPHA @ think "…これは人間が行う何かのマゾヒスティックな儀式か？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:959
translate ja qst_dreamhouse_l2_kitchen_oneoff_18ca7ff7:

    # VES @ think "... Why no salt?"
    VES @ think "…なんで塩がないの？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:961
translate ja qst_dreamhouse_l2_kitchen_oneoff_c5034d4e:

    # "Seemingly satisfied that I had tasted his *food,* the creature went back to cooking, seemingly ignoring us and allowing us to pass."
    "私が彼の*料理*を味見したことに満足したようで、クリーチャーは料理に戻り、私たちを無視して通過させてくれた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:965
translate ja qst_dreamhouse_l2_kitchen_oneoff_806c733b:

    # "The ghoulish dead creature stared for a moment,"
    "グールのような死体のクリーチャーはしばらく見つめ、"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:966
translate ja qst_dreamhouse_l2_kitchen_oneoff_1eb9fc7b:

    # "and realizing none of us will eat its {i}food,{/i}"
    "そして私たちの誰もその{i}料理{/i}を食べないと気づき、"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:967
translate ja qst_dreamhouse_l2_kitchen_oneoff_5633d180:

    # "it grabbed for the cleaver and swung it wildly towards us!"
    "包丁を掴み、私たちに激しく振り回した！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:977
translate ja qst_dreamhouse_l2_kitchen_oneoff_4dc50c36:

    # "Stumbling backwards, blood running from the seeping gash in its head from where I struck,"
    "よろめきながら後退し、私が打った箇所から血が滲む傷口から流れ出る中、"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:978
translate ja qst_dreamhouse_l2_kitchen_oneoff_4e90e46e:

    # "in the creature's final moments, it reached up to grab a chunk of meat, stuffing its mouth full of it before it fell silent."
    "クリーチャーの最期の瞬間、それは肉の塊を掴もうと手を伸ばし、沈黙する前に口いっぱいに詰め込んだ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:985
translate ja qst_dreamhouse_l2_kitchen_cupboards_57333fb4:

    # "The cupboards bled and were filled with nothing but pungent meat in a gory mess."
    "戸棚は血を流し、血みどろの混乱の中で刺激臭のする肉以外何も入っていなかった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:986
translate ja qst_dreamhouse_l2_kitchen_cupboards_529ca2a3:

    # MC "(I think I'll pass on dessert.)"
    MC "（デザートは遠慮しておこう。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:991
translate ja qst_dreamhouse_l2_kitchen_pot_4b656435:

    # MC "A boiled, severed head floated to the top of the blood stew."
    MC "茹でられた切断された首が血のシチューの表面に浮かんでいた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:996
translate ja qst_dreamhouse_l2_kitchen_table_0fe1d924:

    # "{i}Why does no one believe me?{/i}"
    "{i}なぜ誰も私を信じてくれないの？{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:997
translate ja qst_dreamhouse_l2_kitchen_table_00252d94:

    # "{i}We buried the servant boy the other day, mother says his lungs were sick.{/i}"
    "{i}先日、使用人の少年を埋めた。母は彼の肺が病気だったと言う。{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:998
translate ja qst_dreamhouse_l2_kitchen_table_e5462dc5:

    # "{i}I swear I saw him move, but no one believed me.{/i}"
    "{i}誓って彼が動くのを見たのに、誰も信じてくれなかった。{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:999
translate ja qst_dreamhouse_l2_kitchen_table_d7e1df6c:

    # "{i}I dreamed he was still moving in that box, and he came to see me that night.{/i}"
    "{i}彼がまだ箱の中で動いている夢を見て、その夜彼が私に会いに来た。{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1000
translate ja qst_dreamhouse_l2_kitchen_table_d2e54c8d:

    # "{i}He was all mangled and gross, I screamed, but he was gone when mother came...{/i}"
    "{i}彼はめちゃくちゃでグロテスクで、私は叫んだけど、母が来た時にはいなくなっていた…{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1007
translate ja qst_dreamhouse_l2_kitchen_to_cellar_9dd37f09:

    # MC @ think "Damn, it's locked!"
    MC @ think "くそ、鍵がかかってる！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1012
translate ja qst_dreamhouse_l2_kitchen_to_cellar_d24c6466:

    # "The door clicked as it unlocked."
    "ドアがカチッと音を立てて開錠された。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1021
translate ja qst_dreamhouse_l2_cellar_barrel_61b14339:

    # "No wine, only blood it seems... warm to the touch."
    "ワインはなく、血だけのようだ…触ると温かい。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1027
translate ja qst_dreamhouse_l2_dead_mercenary_5b189511:

    # "Inspecting the corpse of the man, I found clutched in his coiled, dead hand, the blue skull key."
    "男の死体を調べると、彼のこわばった死んだ手に握られた青い髑髏の鍵を見つけた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1034
translate ja qst_dreamhouse_l2_library_oneoff_b461b23a:

    # "Upon entering the room, the swarm of dead shuffling around turned their attention towards us!"
    "部屋に入ると、周りをうろつく死者の群れが私たちに注意を向けた！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1047
translate ja qst_dreamhouse_l2_library_fireplace_9aefa7d9:

    # "A still-lit fireplace."
    "まだ火のついた暖炉。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1048
translate ja qst_dreamhouse_l2_library_fireplace_a3ca41df:

    # "The fire crackled as it burned the wood, but it radiated no warmth."
    "火は木を燃やしながらパチパチと音を立てたが、暖かさは全く放っていなかった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1053
translate ja qst_dreamhouse_l2_library_bookshelf_1_29465ee2:

    # "The pages were ruined and covered in blood."
    "ページは台無しで血に覆われていた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1058
translate ja qst_dreamhouse_l2_library_bookshelf_2_2612ac88:

    # "There's a depicion of what seemed to be a dead servant boy in bed... He appeared to have thrown up blood."
    "ベッドの中で死んだ使用人の少年と思われる描写がある…彼は血を吐いたようだ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1063
translate ja qst_dreamhouse_l2_library_portrait_0a77bcf4:

    # "... Just what kind of nightmares did this girl have?"
    "…この娘はいったいどんな悪夢を見ていたんだ？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1064
translate ja qst_dreamhouse_l2_library_portrait_dcac9c61:

    # "There's no keyhole this time."
    "今回は鍵穴がない。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1079
translate ja qst_dreamhouse_l3_start_e6b4e9df:

    # MC @ surprised "Gods, what is this place?"
    MC @ surprised "神よ、ここは何なんだ？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1080
translate ja qst_dreamhouse_l3_start_594000fe:

    # MC @ think "Does anyone-"
    MC @ think "誰か——"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1082
translate ja qst_dreamhouse_l3_start_af6f165f:

    # "As I turned to look back, I realized the others were not with me."
    "振り返ると、他の仲間が一緒にいないことに気づいた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1083
translate ja qst_dreamhouse_l3_start_0ce3e770:

    # MC @ surprised "Markus?"
    MC @ surprised "マーカス？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1084
translate ja qst_dreamhouse_l3_start_3e21602a:

    # MC @ surprised "Kiara?"
    MC @ surprised "キアラ？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1086
translate ja qst_dreamhouse_l3_start_3ef76725:

    # MC @ surprised "{i}Anyone?{/i}"
    MC @ surprised "{i}誰か？{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1088
translate ja qst_dreamhouse_l3_start_cbea66c9:

    # MC @ serious "... Fuck."
    MC @ serious "…クソ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1089
translate ja qst_dreamhouse_l3_start_8bdaee21:

    # MC "(Alright, you know what to do. Find the key, move onto the next floor.)"
    MC "（よし、やるべきことは分かってる。鍵を見つけて、次の階へ進め。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1090
translate ja qst_dreamhouse_l3_start_d7232d72:

    # MC @ sad "(I just hope the others are fine.)"
    MC @ sad "（他のみんなが無事でありますように。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1096
translate ja qst_dreamhouse_l3_bathtub_c67fdbca:

    # "The water is black..."
    "水が黒い…"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1102
translate ja qst_dreamhouse_l3_mirror_0d811e85:

    # "Looking into it, I saw my own reflection, but it was distorted."
    "覗き込むと、自分の姿が映っていたが、歪んでいた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1106
translate ja qst_dreamhouse_l3_mirror_44dde62d:

    # "As I placed my hand onto the mirror, I felt it go {i}through{/i} the glass into the other side."
    "鏡に手を置くと、ガラスを{i}通り抜けて{/i}向こう側に入っていくのを感じた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1107
translate ja qst_dreamhouse_l3_mirror_8f466d6a:

    # "It was cool, and as I pushed my hand deeper, I grabbed at something."
    "それは冷たく、手をさらに深く押し込むと、何かを掴んだ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1108
translate ja qst_dreamhouse_l3_mirror_a6a16a82:

    # "Pulling my hand and whatever it was out, something clawed at me!"
    "手と何かを引き抜こうとすると、何かが私に爪を立てた！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1111
translate ja qst_dreamhouse_l3_mirror_eaf73d4a:

    # MC @ surprised "AHH!"
    MC @ surprised "ああっ！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1112
translate ja qst_dreamhouse_l3_mirror_84c4e35d:

    # "I ripped back my hand, staring at the gash of blood."
    "手を引き戻し、血の傷を見つめた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1113
translate ja qst_dreamhouse_l3_mirror_cc6cfb05:

    # "Clutched in my hand, though, was a small, strange totem."
    "しかし手には、小さく奇妙なトーテムが握られていた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1115
translate ja qst_dreamhouse_l3_mirror_b7b8af7c:

    # MC "(What is this?)"
    MC "（これは何だ？）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1118
translate ja qst_dreamhouse_l3_mirror_6fab40d8:

    # "(Probably not a good idea.)"
    "（多分いい考えじゃない。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1151
translate ja qst_dreamhouse_l3_granny_bathroom_415eeec1:

    # MC "(She's coming!)"
    MC "（来る！）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1154
translate ja qst_dreamhouse_l3_granny_bathroom_a6b7cd71:

    # "I hid behind the bath."
    "浴槽の後ろに隠れた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1155
translate ja qst_dreamhouse_l3_granny_bathroom_7681aefe:

    # "Crouched beside it, the figure entered the bathroom and peered around, looking for me."
    "その横にしゃがみ込んでいると、その人影が浴室に入り、周りを見回して私を探した。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1157
translate ja qst_dreamhouse_l3_granny_bathroom_767c5417:

    # "Crouched down behind the bathtub, the figure glanced from left to right for a moment before, thankfully, shuffling off."
    "浴槽の後ろにしゃがみ込んでいると、人影は左右を一瞬見回してから、ありがたいことに、足を引きずって去っていった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1163
translate ja qst_dreamhouse_l3_granny_bathroom_4cbc2d3b:

    # "Deciding there was no point in hiding, I readied myself to try and slip past her!"
    "隠れても無駄だと判断し、彼女の横をすり抜けようと身構えた！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1165
translate ja qst_dreamhouse_l3_granny_bathroom_5ad74a8f:

    # "Barging through the figure, I barely managed to dodge the snap of her blades as I escaped!"
    "人影を押し通って、逃げる際にかろうじて彼女の刃の一撃をかわした！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1172
translate ja qst_dreamhouse_l3_granny_diningroom_134a3e83:

    # MC @ scared "(I need to hide!)"
    MC @ scared "（隠れないと！）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1178
translate ja qst_dreamhouse_l3_granny_diningroom_38cbb1be:

    # "Dropping to my knees, I crawled beneath the table and waited with bated breath."
    "膝をついて、テーブルの下に這い込み、息を潜めて待った。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1179
translate ja qst_dreamhouse_l3_granny_diningroom_f75a4f61:

    # "As I heard the sound of the shear blade snapping draw closer, the door to the dining room was kicked in as the figure walked on by."
    "鋏の刃がカチカチと鳴る音が近づいてくるのを聞きながら、食堂のドアが蹴り破られ、人影が通り過ぎていった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1180
translate ja qst_dreamhouse_l3_granny_diningroom_2f4f3719:

    # "They stopped for a moment, looking around, before moving on into the next room."
    "彼らは一瞬立ち止まり、周りを見回してから、次の部屋へと進んでいった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1181
translate ja qst_dreamhouse_l3_granny_diningroom_31130542:

    # MC "(That was close...)"
    MC "（危なかった…）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1188
translate ja qst_dreamhouse_l3_granny_diningroom_2300535e:

    # "I grabbed the nearest chair,"
    "一番近くの椅子を掴み、"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1189
translate ja qst_dreamhouse_l3_granny_diningroom_6959b464:

    # "As the door burst open, I flung it towards her before fleeing!"
    "ドアが勢いよく開くと、逃げる前に彼女に向かって投げつけた！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1197
translate ja qst_dreamhouse_l3_granny_kitchen_077c9c3b:

    # MC "(I can hear her coming!)"
    MC "（彼女が来るのが聞こえる！）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1201
translate ja qst_dreamhouse_l3_granny_kitchen_7cc40527:

    # "I crawled beneath the kitchen table and waited, hoping the monstrous figure would simply pass on by."
    "キッチンテーブルの下に這い込み、怪物のような人影がただ通り過ぎてくれることを願って待った。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1203
translate ja qst_dreamhouse_l3_granny_kitchen_c51bbaec:

    # "Granny Oh Dreary passed on by without noticing me... For now."
    "オー・ドリアリーおばあさんは私に気づかずに通り過ぎていった…今のところは。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1209
translate ja qst_dreamhouse_l3_granny_kitchen_906d9207:

    # "Quickly, I moved to push the table against the door, blockading it."
    "素早く、テーブルをドアに押し付けて封鎖した。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1210
translate ja qst_dreamhouse_l3_granny_kitchen_3c3c1697:

    # "From the other side, I could hear loud banging on the door."
    "向こう側から、ドアを激しく叩く音が聞こえた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1211
translate ja qst_dreamhouse_l3_granny_kitchen_c379ad4a:

    # MC @ serious "(It won't hold long.)"
    MC @ serious "（長くは持たない。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1212
translate ja qst_dreamhouse_l3_granny_kitchen_8754c925:

    # MC @ serious "(I need to get out of here!)"
    MC @ serious "（ここから出ないと！）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1219
translate ja qst_dreamhouse_l3_granny_cellar_bc8f7802:

    # MC @ scared "(Shit! She's coming!)"
    MC @ scared "（クソ！来る！）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1223
translate ja qst_dreamhouse_l3_granny_cellar_77fbc12d:

    # "Crouched down, I hide behind some of the many rows of potions and strange bottles."
    "しゃがみ込んで、多くのポーションと奇妙な瓶の列のいくつかの後ろに隠れた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1224
translate ja qst_dreamhouse_l3_granny_cellar_8ba4c879:

    # "As the door opened, the figure stepped inside, shears snapping as she looked from left to right."
    "ドアが開くと、人影が中に入り、左右を見回しながら鋏をカチカチと鳴らした。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1225
translate ja qst_dreamhouse_l3_granny_cellar_c8c5fa4d:

    # "I pulled back at the last second as she looked towards me, and as I did so, I heard the snapping sound grow distant as she moved on."
    "彼女が私の方を見た瞬間、ぎりぎりで身を引き、そうするうちに、彼女が進むにつれてカチカチという音が遠ざかっていくのが聞こえた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1231
translate ja qst_dreamhouse_l3_granny_cellar_a284fed4:

    # "I didn't hesitate, grabbing the nearest bottle and launching it towards her as soon as she entered the room."
    "迷わず、彼女が部屋に入ってくるや否や、一番近くの瓶を掴んで彼女に投げつけた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1232
translate ja qst_dreamhouse_l3_granny_cellar_1aaab80a:

    # "By pure luck, the bottle {i}somehow{/i} seemed to actually hit her."
    "純粋な運で、瓶が{i}なぜか{/i}実際に彼女に当たったようだった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1233
translate ja qst_dreamhouse_l3_granny_cellar_6ad10df8:

    # "She screamed and wailed as it sizzled her, white steam rising from her as she seemed to shimmer."
    "それが彼女をジュージューと焼き、白い蒸気が立ち上り、彼女はきらめくように見え、叫び声をあげて泣き叫んだ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1234
translate ja qst_dreamhouse_l3_granny_cellar_0582b976:

    # GRANNY_OH_DREARY "GAHHH! NAUGHTY! NAUGHTY FUCKING BRAT!"
    GRANNY_OH_DREARY "がああ！いたずらっ子！クソいたずらっ子め！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1235
translate ja qst_dreamhouse_l3_granny_cellar_78e6daf4:

    # "She retreated... For now, at least."
    "彼女は退却した…少なくとも今のところは。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1236
translate ja qst_dreamhouse_l3_granny_cellar_4250636f:

    # MC "(Too bad I didn't douse my sword in whatever that was first.)"
    MC "（最初にあれに剣を浸しておかなかったのが残念だ。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1242
translate ja qst_dreamhouse_l3_granny_library_3f5054a7:

    # "{i}*SNAP!*{/i}"
    "{i}*カチン！*{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1243
translate ja qst_dreamhouse_l3_granny_library_147920de:

    # GRANNY_OH_DREARY "Come out, prettyyyy!"
    GRANNY_OH_DREARY "出ておいで、かわいこちゃーん！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1244
translate ja qst_dreamhouse_l3_granny_library_98f0f9eb:

    # GRANNY_OH_DREARY "Don't hide from grandmaaa!"
    GRANNY_OH_DREARY "おばあちゃんから隠れちゃダメよぉ！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1248
translate ja qst_dreamhouse_l3_granny_library_78c77d80:

    # "Crouched down, I watched and waited patiently as Granny entered the library."
    "しゃがみ込んで、おばあさんが図書館に入ってくるのを辛抱強く見守って待った。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1249
translate ja qst_dreamhouse_l3_granny_library_cb478fab:

    # "She glanced left."
    "彼女は左を見た。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1250
translate ja qst_dreamhouse_l3_granny_library_46553a4a:

    # "Then right."
    "次に右。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1251
translate ja qst_dreamhouse_l3_granny_library_a27d0a99:

    # "Then slowly turned to leave as I breathed a sigh of relief."
    "それからゆっくりと去ろうと振り返り、私は安堵のため息をついた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1258
translate ja qst_dreamhouse_l3_granny_library_f1839d3d:

    # "I timed it perfectly, waiting carefully for her to enter the room. Crouched low, I moved as silently as possible."
    "完璧にタイミングを計り、彼女が部屋に入るのを注意深く待った。低くしゃがみ込み、できるだけ静かに動いた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1259
translate ja qst_dreamhouse_l3_granny_library_1c2cbc14:

    # "Before she knew it, I had managed to slip behind her and hurry out."
    "彼女が気づく前に、私は彼女の背後に滑り込み、急いで出ることができた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1268
translate ja qst_dreamhouse_l3_granny_wrongchoice_5282681b:

    # "As Granny lunged towards me, the strange totem began to glow brightly,"
    "おばあさんが私に飛びかかろうとした時、奇妙なトーテムが明るく輝き始め、"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1269
translate ja qst_dreamhouse_l3_granny_wrongchoice_99fcaa70:

    # "and as it did so, Granny shielded her eyes and fled from the room!"
    "そうすると、おばあさんは目を覆い、部屋から逃げ出した！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1270
translate ja qst_dreamhouse_l3_granny_wrongchoice_0b5a0ed1:

    # "As the totem dimmed, it cracked, crumbling away in my hands."
    "トーテムが暗くなると、それは割れて、私の手の中で崩れ落ちた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1271
translate ja qst_dreamhouse_l3_granny_wrongchoice_eb97fb6f:

    # MC "(... The totems... I need to find more of them if I can!)"
    MC "（…トーテム…できればもっと見つけないと！）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1286
translate ja qst_dreamhouse_l3_toys_4cc3a2b0:

    # "Dolls."
    "人形。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1287
translate ja qst_dreamhouse_l3_toys_8be0926e:

    # "... Oh gods."
    "…ああ神様。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1288
translate ja qst_dreamhouse_l3_toys_c4fb2060:

    # "Are those... {i}faces stitched to the dolls?{/i}"
    "あれは…{i}人形に縫い付けられた顔？{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1293
translate ja qst_dreamhouse_l3_crib_2aac05f3:

    # "Inside the crib was a doll clutching a small, diamond-head-shaped key."
    "揺りかごの中には、小さなダイヤ形の頭の鍵を握った人形があった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1298
translate ja qst_dreamhouse_l3_crib_9014a260:

    # "I grabbed hold of the key."
    "鍵を掴んだ。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1304
translate ja qst_dreamhouse_l3_crib_6e176177:

    # "As I took the key, from the shadowed corner of the room, I heard rocking."
    "鍵を取ると、部屋の影になった隅から、揺れる音が聞こえた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1305
translate ja qst_dreamhouse_l3_crib_10844fab:

    # "Reaching for my blade, I turned to see a hunched, shrouded figure sitting in a rocking chair."
    "剣に手を伸ばし、振り返ると、ロッキングチェアに座った猫背で覆われた人影が見えた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1306
translate ja qst_dreamhouse_l3_crib_cb4235c7:

    # "Had she been here this whole time?"
    "彼女はずっとここにいたのか？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1307
translate ja qst_dreamhouse_l3_crib_66840beb:

    # MC @ think "... Hello?"
    MC @ think "…もしもし？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1308
translate ja qst_dreamhouse_l3_crib_a86fe40a:

    # GRANNY_OH_DREARY "..."
    GRANNY_OH_DREARY "…"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1309
translate ja qst_dreamhouse_l3_crib_b18389e7:

    # "The woman stopped rocking in her chair."
    "女性は椅子の揺れを止めた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1310
translate ja qst_dreamhouse_l3_crib_2548988e:

    # MC @ scared "... I'm looking for-"
    MC @ scared "…探しているのは——"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1311
translate ja qst_dreamhouse_l3_crib_3fd19343:

    # GRANNY_OH_DREARY "Do you know my song?"
    GRANNY_OH_DREARY "私の歌を知ってる？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1312
translate ja qst_dreamhouse_l3_crib_bde6c2b6:

    # MC @ think "What?"
    MC @ think "何だ？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1313
translate ja qst_dreamhouse_l3_crib_f49508d7:

    # "I felt the air suck from the room as I took a step back."
    "一歩後退すると、部屋から空気が吸い取られるのを感じた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1314
translate ja qst_dreamhouse_l3_crib_ebf60601:

    # "The hair stood on end."
    "髪の毛が逆立った。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1315
translate ja qst_dreamhouse_l3_crib_639f7396:

    # GRANNY_OH_DREARY "Granny Oh Dreary, don't let children grow..."
    GRANNY_OH_DREARY "オー・ドリアリーおばあさん、子供を成長させないで…"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1316
translate ja qst_dreamhouse_l3_crib_c25bbe0f:

    # "The woman rose from her rocking chair. She was tall... {i}too tall.{/i}"
    "女性はロッキングチェアから立ち上がった。彼女は背が高かった…{i}高すぎた。{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1317
translate ja qst_dreamhouse_l3_crib_c5a9bee6:

    # GRANNY_OH_DREARY "Snips off their faces so no one will know."
    GRANNY_OH_DREARY "顔を切り取って誰にも分からないように。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1318
translate ja qst_dreamhouse_l3_crib_d462b8b0:

    # GRANNY_OH_DREARY "Stay little, stay sweet, don't ever get tall…"
    GRANNY_OH_DREARY "小さくいて、可愛くいて、決して大きくならないで…"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1319
translate ja qst_dreamhouse_l3_crib_96d74cac:

    # GRANNY_OH_DREARY "Her dolls on the shelf used to speak, after all!"
    GRANNY_OH_DREARY "棚の人形たちはかつて話せたんだもの！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1320
translate ja qst_dreamhouse_l3_crib_881e3d92:

    # "From under her robes came the sharp glint of a huge pair of shears."
    "彼女のローブの下から、巨大な鋏の鋭い輝きが現れた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1321
translate ja qst_dreamhouse_l3_crib_832ccf11:

    # GRANNY_OH_DREARY "Stitch up your smile, pull tight at the seam—"
    GRANNY_OH_DREARY "笑顔を縫い合わせて、縫い目をきつく引っ張って——"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1322
translate ja qst_dreamhouse_l3_crib_2ae64287:

    # MC @ scared "... Oh fuck."
    MC @ scared "…なんてこった。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1323
translate ja qst_dreamhouse_l3_crib_f15e001d:

    # "I stepped back, retreating as she pressed the blades together, grinning a hideous, oversized smile."
    "私は後退し、彼女が刃を合わせ、醜く大きすぎる笑みを浮かべる中で退いた。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1324
translate ja qst_dreamhouse_l3_crib_93b00313:

    # "And as she inched closer, I could see {i}she was wearing someone's face.{/i}"
