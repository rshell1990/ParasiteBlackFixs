    DAVIK "俺は…違う。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:740
translate ja qst_dreamhouse_l2_start_menu_b530f543:

    # DAVIK "This house is... It's messing with me!"
    DAVIK "この家は…俺を惑わせている！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:743
translate ja qst_dreamhouse_l2_start_menu_cd19d76d:

    # DAVIK "Dead."
    DAVIK "死んだ。"

