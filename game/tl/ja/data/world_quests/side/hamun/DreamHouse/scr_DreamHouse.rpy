translate ja qst_dreamhouse_enter_forest_6a170834:

    # KIARA @ scared "{i}... It's like the house is staring back at me.{/i}"
    KIARA @ scared "{i}…家が私を見返しているみたい。{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:425
translate ja qst_dreamhouse_enter_forest_d5056759:

    # MC @ angry "(This place... There's something.)"
    MC @ angry "（この場所…何かがある。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:426
translate ja qst_dreamhouse_enter_forest_f68f3728:

    # MC @ angry "({i}Off{/i} about it.)"
    MC @ angry "（何かが{i}おかしい{/i}。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:427
translate ja qst_dreamhouse_enter_forest_f8df61e6:

    # SHYAHTAN "(Caution.)"
    SHYAHTAN "（警戒しろ。）"

