translate ja jurgen_1_tavern_assassinate_0a23a6bb:

    # MC @ talk "Not here, there's too many people."
    MC @ talk "ここはダメ、人が多すぎる。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:3
translate ja jurgen_1_tavern_assassinate_13652144:

    # MC @ talk "We need to talk somewhere private."
    MC @ talk "どこか二人きりで話がしたい。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:4
translate ja jurgen_1_tavern_assassinate_31a3f7a9:

    # "Jurgen seemed suspicious, he waved over two of his friends."
    "ユルゲンは不審そうに、二人の友人を手招きした。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:5
translate ja jurgen_1_tavern_assassinate_49e09581:

    # JURGEN "You lads stay back but come with me."
    JURGEN "お前らは下がってろ、だが付いて来い。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:6
translate ja jurgen_1_tavern_assassinate_d986e350:

    # JURGEN "This one here says he might have something to help us."
    JURGEN "こいつは何か役に立つものを持っているかもって。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:7
translate ja jurgen_1_tavern_assassinate_6ea473f3:

    # MC "(Shit... Not what I was hoping for.)"
    MC "(くそ…期待してたのと違う。)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:8
translate ja jurgen_1_tavern_assassinate_c43e8623:

    # JURGEN "Well? Where shall we speak?"
    JURGEN "さて？どこで話しましょうか？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:9
translate ja jurgen_1_tavern_assassinate_993a335f:

    # MC "This way..."
    MC "こちらへ…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:12
translate ja jurgen_1_tavern_assassinate_297d5bdc:

    # "I lead Jurgen down into one of the quiet back Alleyways, the two guards kept enough of a distance not to listen in but follow us."
    "ユルゲンを静かな裏路地の一つへと案内すると、二人の護衛は聞き耳を立てぬ距離を保ちながら、我々に付いてきている。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:22
translate ja jurgen_1_tavern_assassinate_366bbcf6:

    # JURGEN "Now, what have you got for me?"
    JURGEN "さて、何か持ってきた？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:25
translate ja jurgen_1_tavern_assassinate_a5d72335:

    # JURGEN "I should have known!"
    JURGEN "知ってるべきだった!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:26
translate ja jurgen_1_tavern_assassinate_d747a650:

    # JURGEN "Men! To arms!"
    JURGEN "諸君!武器を取れ!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:30
translate ja jurgen_1_tavern_assassinate_9d8dcd90:

    # "After slaying Jurgen and his men, I fled into the many back alleys, doing my best to not be seen."
    "ユルゲンとその手下を討ち取った後、私は可能な限り目立たぬように、幾つもの路地裏へと逃げ込んだ。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:31
translate ja jurgen_1_tavern_assassinate_6a2f278a:

    # "My heart raced at what had just happened, no doubt about it... {i}I was a murderer.{/i}"
    "今起きたことで私の鼓動が早まった、疑いようもなく…{i}私は殺人者だ。{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:32
translate ja jurgen_1_tavern_assassinate_d47a78c3:

    # "But still I told myself I did what needed to be done, or at least, {i}that's what I kept telling myself anyway.{/i}"
    "それでも必要だったことだと思い込もうとした、少なくとも、{i}そう自分に言い聞かせていたんだ。{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:40
translate ja jurgen_1_tavern_assassinate_c4efc9e9:

    # "From out the shadows, the Vulshan came, blades drawn."
    "闇から、ヴァルシャンが現れた；刃を構えて。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:41
translate ja jurgen_1_tavern_assassinate_33b8f300:

    # JURGEN "W-What is-"
    JURGEN "な…何が…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:43
translate ja jurgen_1_tavern_assassinate_85a1d0e0:

    # "The guards behind Jurgen fell, their throats slit by the Vulshan assassins."
    "ユルゲンの背後にいた衛兵たちが倒れた。ヴァルシャンの刺客たちに首筋を切られて。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:44
translate ja jurgen_1_tavern_assassinate_e40632bd:

    # "A second later, Jurgen himself joined his entourage on the rocky alley floor."
    "一瞬後、ユルゲン自身も石畳の路地で一行に合流した。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:45
translate ja jurgen_1_tavern_assassinate_872de970:

    # "Blood poured from beneath his armour plates as he struggled to breathe."
    "彼の鎧の下から血がしたたり、息もあえぐようにしていた。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:46
translate ja jurgen_1_tavern_assassinate_6475c2fc:

    # JURGEN "Who- Argh..."
    JURGEN "だれ…ぐあっ…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:47
translate ja jurgen_1_tavern_assassinate_f0d9ee59:

    # "A final, gargled choking gasp escaped his lips before he finally fell silent."
    "最後の、むせび泣くような窒息音が彼の唇から漏れ、ついに彼は沈黙した。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:52
translate ja jurgen_1_tavern_assassinate_b141a920:

    # VULSHAN @ talk "Leave now... We will take care of the rest."
    VULSHAN @ talk "行きなさい…後のことは任せて。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_assassinate.rpy:54
translate ja jurgen_1_tavern_assassinate_95ce5fb4:

    # "I nodded, taking off into the shadows once again, the dark deed done."
    "頷いて、私は再び影の中へと消えて行く。邪悪な仕事を終えて。"

