# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:3
translate ja dros_1_at_palam_b918abda:

    # DIVINE "Hm? Dros?"
    DIVINE "ん？ドロス？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:4
translate ja dros_1_at_palam_9d29554e:

    # DIVINE "You mean, the elven tailor?"
    DIVINE "つまり、そのエルフの仕立て屋のこと？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:5
translate ja dros_1_at_palam_bfe79c34:

    # "Sister Divine seemed to be increasingly uncomfortable with the subject."
    "聖女ディバインは、その話題に対して次第に不快そうになった。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:8
translate ja dros_1_at_palam_a2362967:

    # DIVINE "What is it now he wants?"
    DIVINE "今度は何が欲しいんだ？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:9
translate ja dros_1_at_palam_11804c4f:

    # MC @ talk "He wants to become a woman."
    MC @ talk "彼は女性になりたいと望んでいる。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:10
translate ja dros_1_at_palam_e30bd644:

    # DIVINE "Impossible."
    DIVINE "不可能。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:11
translate ja dros_1_at_palam_fb531ee6:

    # MC @ talk "But-"
    MC @ talk "でも―"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:12
translate ja dros_1_at_palam_42d05305:

    # DIVINE "Such a thing is far beyond my abilities and powers."
    DIVINE "それは私の能力も力も遥かに超えていることです。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:13
translate ja dros_1_at_palam_e3005da5:

    # DIVINE "Perhaps a higher order being, a demon or one of the gods could offer such a thing... But it's not within reach of my powers."
    DIVINE "もしかすると、上位存在である悪魔や神の類ならば、そのようなものを与えられるかもしれない…だが、私の力の及ぶ範囲ではない。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:17
translate ja dros_1_at_palam_menu_535e0770:

    # DIVINE "Only by the goddess Palam's will, we have no say ourselves over such matters."
    DIVINE "女神パラムの御心によってのみ、このような事柄は決まる。我々に裁量はないというものである。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:18
translate ja dros_1_at_palam_menu_6b320b5d:

    # DIVINE "Nor are we entirely any specific gender."
    DIVINE "私たちは完全に特定の性別でもありません。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:25
translate ja dros_1_at_palam_menu_22841cf9:

    # DIVINE "You cannot, the new gods come and go as they please and the rituals to summon the old gods to strike a bargain have been lost to most."
    DIVINE "新しき神々は気まぐれに現れては消え、古き神々と契約を結ぶ儀式は、ほとんど失われてしまったのだから。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:26
translate ja dros_1_at_palam_menu_1a0e5ef2:

    # DIVINE "As for demons, I would {i}highly{/i} recommend avoiding such foolish thoughts."
    DIVINE "魔物に関しては、そのような愚かな考えは{i}強く{/i}避けることをお勧めします。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:27
translate ja dros_1_at_palam_menu_5851c56c:

    # DIVINE "If the inquisition doesn't execute you, no deal with a demon is ever worth the cost."
    DIVINE "異端審問がお前を処刑しなかったとしても、悪魔との取引に代償を払う価値はない。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:28
translate ja dros_1_at_palam_menu_c7cd895f:

    # MC @ talk "So is there nothing that could be done?"
    MC @ talk "では、何もできないんですか？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:29
translate ja dros_1_at_palam_menu_3289cc23:

    # DIVINE "Well..."
    DIVINE "ええと…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:30
translate ja dros_1_at_palam_menu_15c9ef00:

    # DIVINE "I cannot turn Dros into a woman, it's simply beyond my reach."
    DIVINE "ドロスを女性に変えることはできません。それは私の手に余ることです。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:31
translate ja dros_1_at_palam_menu_c88aa971:

    # DIVINE "{i}But, perhaps we could help at least with the appearance of being more like a woman.{/i}"
    DIVINE "{i}しかし、せめて外見だけでも女性らしく見えるよう、お手伝いができるかもしれません。{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:32
translate ja dros_1_at_palam_menu_794237b7:

    # MC @ talk "Is such a thing possible?"
    MC @ talk "そんなことがあり得るだろうか？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:33
translate ja dros_1_at_palam_menu_6b1f9503:

    # DIVINE "It may be so, when Dros first inquired about something similar I did some research into his request."
    DIVINE "そうかもしれない。以前ドロスが似たようなことを尋ねた際、その依頼について調査を行ったことがある。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:34
translate ja dros_1_at_palam_menu_a34426db:

    # DIVINE "But I'm reluctant to try it, I have no idea if it would even work."
    DIVINE "でも、そもそもうまくいくかどうかもわからないので、試すのは乗り気じゃない。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:35
translate ja dros_1_at_palam_menu_f7c32ebd:

    # DIVINE "Not to mention the risk of {i}side effects{/i} with any kind of untested spells like this."
    DIVINE "言うまでもないが、このような未検証の魔法には、あらゆる種類の{i}副作用{/i}のリスクがある。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:36
translate ja dros_1_at_palam_menu_a746faab:

    # MC @ talk "What do you need?"
    MC @ talk "何が必要ですか？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:37
translate ja dros_1_at_palam_menu_d0304c0c:

    # DIVINE "...You're serious?"
    DIVINE "…本気なの？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:38
translate ja dros_1_at_palam_menu_0a69f711:

    # DIVINE "Well, from what I remember of the incantation, I'd need some herbal ingredients..."
    DIVINE "さて、思い出す限りでは、その詠唱には薬草の材料が必要になるだろう…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:40
translate ja dros_1_at_palam_menu_4b897446:

    # DIVINE "Most merchants should be able to obtain them."
    DIVINE "大半の商人は手に入れることができるはずだ。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:41
translate ja dros_1_at_palam_menu_e2121ec7:

    # DIVINE "I'd also need some slimelark remnants, at least five of them."
    DIVINE "スライムラークの残骸も必要です、少なくとも5個は。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:44
translate ja dros_1_at_palam_menu_9d3d34a1:

    # "Sister Divine scribbled down onto a piece of paper the list of all the ingredients as she spoke."
    "聖女ディバインは話しながら、材料のリストを紙に走り書きした。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:45
translate ja dros_1_at_palam_menu_fa4e89b7:

    # DIVINE "And finally... I'd need you to talk to Dros about whether he's sure about going through with this."
    DIVINE "そして最後に…  
彼が本当に覚悟ができているのか、ドロスと話を聞いてきてくれないか。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:47
translate ja dros_1_at_palam_menu_e6680765:

    # DIVINE "He needs to understand the risk he's taking... I can't guarantee his safety."
    DIVINE "彼には理解させなければならない…自分が冒している危険性を。
彼の安全は保証できない。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:48
translate ja dros_1_at_palam_menu_5e9e7edb:

    # MC @ talk "Hm, alright then..."
    MC @ talk "ふむ、よし…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:50
translate ja dros_1_at_palam_menu_0076a65b:

    # MC "(That's a handful.)"
    MC "(それは手に負えない。)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:54
translate ja dros_3_returnToDivine_fe0d2fa5:

    # DIVINE "Yes? Did you do as I asked?"
    DIVINE "はい？頼んだ通りにしてくれましたか？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:58
translate ja dros_3_returnToDivine_menu_a3856326:

    # DIVINE "Good. Anything else?"
    DIVINE "いいでしょう。他に何か？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:64
translate ja dros_3_returnToDivine_menu_8e44db04:

    # DIVINE "You do?"
    DIVINE "そうなの？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:65
translate ja dros_3_returnToDivine_menu_c95166a0:

    # DIVINE "I can only imagine how you acquired these, {i}warrior{/i}."
    DIVINE "一体どのようにして手に入れたのか、{i}戦士{/i}よ、想像することしかできません。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:66
translate ja dros_3_returnToDivine_menu_1266d6c2:

    # "Divine looked me over, biting her lip..."
    "ディバインは唇を噛みしめながら、私をじろじろと見た…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:67
translate ja dros_3_returnToDivine_menu_aa50e32b:

    # MC @ talk "There you go."
    MC @ talk "どうぞ。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:72
translate ja dros_3_returnToDivine_menu_0d19d9df:

    # DIVINE "Oh, perfect, these are..."
    DIVINE "ああ、完璧、これは…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:73
translate ja dros_3_returnToDivine_menu_43bd2cfe:

    # DIVINE "Yes, ideal for our endeavour."
    DIVINE "はい、我々の試みには理想的です。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:74
translate ja dros_3_returnToDivine_menu_9e108511:

    # DIVINE "Anything else?"
    DIVINE "他には？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:77
translate ja dros_3_returnToDivine_menu_41bece04:

    # DIVINE "Yes, everything's ready."
    DIVINE "はい、全て準備できています。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:78
translate ja dros_3_returnToDivine_menu_efaffc81:

    # DIVINE "Go get Dros, I'll begin the preparations."
    DIVINE "ドロスを連れてきて、準備を始める。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:83
translate ja dros_3_returnToDivine_menu_0731281d:

    # DIVINE "Okay, warrior."
    DIVINE "よし、戦士。"

translate ja strings:

    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:16
    old "But the Mages of Palam... Aren't you-"
    new "パラムの魔術師たち…お前たちはー"




    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:22
    old "How could I contact such beings?"
    new "どうやってそのような存在に連絡を取ればいいのだろうか。"




    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:56
    old "I have warned Dros."
    new "私はドロスに警告した。"




    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:60
    old "I have brought slimelark remains."
    new "スライムラークの残骸を持ってきました。"




    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:69
    old "I have brought the herbs."
    new "薬草を持ってきました。"




    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:76
    old "Let's begin the ritual."
    new "儀式を始めよう。"




    # game/data/world_quests/side/novaras/AGracefulRebirth/scr_at_Palam.rpy:82
    old "Let's talk about something else."
    new "別の話をしよう。"




