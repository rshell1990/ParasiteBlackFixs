# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:4
translate ja dros_warn_d1b3bb90:

    # DROS @ shock "There is? By the gods! You mean..."
    DROS @ shock "ありますか？神々よ!つまり…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:5
translate ja dros_warn_3023187f:

    # DROS @ smile "They'll be able to help me?"
    DROS @ smile "彼らが助けてくれるのかな？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:6
translate ja dros_warn_43e247e2:

    # MC @ sad "Yes and no, Dros."
    MC @ sad "そうでもあり、そうでもない、ドロス。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:7
translate ja dros_warn_f145bdc8:

    # MC @ talk "That's what I'm here to talk to you about."
    MC @ talk "それについて話すために来ました。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:8
translate ja dros_warn_83069e95:

    # MC @ talk "There is a ritual that can make you {i}appear{/i} more like a woman."
    MC @ talk "あなたをより{i}女性的に見せる{/i}儀式がある。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:9
translate ja dros_warn_d613a2cd:

    # MC @ sad "But it doesn't come without risk."
    MC @ sad "とは言え、リスクなしではあり得ない。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:10
translate ja dros_warn_1bb6fbcd:

    # MC @ talk "The ritual is one understood in theory only, there's a chance you could get hurt."
    MC @ talk "儀式は理論上のみ理解されるものであり、あなたが傷つく恐れがあります。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:11
translate ja dros_warn_98f46404:

    # DROS @ shock "How hurt?"
    DROS @ shock "どのくらい傷ついている？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:12
translate ja dros_warn_5c46a192:

    # MC @ talk "We don't know."
    MC @ talk "分かりません。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:13
translate ja dros_warn_f16dac85:

    # DROS @ sad "I... see."
    DROS @ sad "そう…ですか。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:14
translate ja dros_warn_d56c7e9f:

    # MC @ talk "Are you sure you want to do it?"
    MC @ talk "本当にやるのですか？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:15
translate ja dros_warn_13147738:

    # "Dros seemed to ponder my words for a moment, his answer was one much softer than his usual hard abrasiveness."
    "ドロスは一瞬、私の言葉を考え込む様子で、その答えはいつもの硬質な辛辣さよりもずっと柔らかな口調だった。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:16
translate ja dros_warn_98a97aec:

    # DROS @ sad "I've had lifetimes to think about it."
    DROS @ sad "いくつもの人生をかけて考えてきた。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:17
translate ja dros_warn_4a65dfd9:

    # DROS @ sad "Elven lifespan is an impressive, terrible thing sometimes."
    DROS @ sad "エルフの寿命とは、時に壮絶で恐ろしいものだ。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:18
translate ja dros_warn_08ff2383:

    # DROS @ sad "It gives us what you would consider lifetimes to ponder our mistakes... Our worries... Our longing for what should have been."
    DROS @ sad "それは私たちに、人生の何倍もの時を与えてくれる…自らの過ちを振り返るために。私たちの心配事…在るべきだったものへの憧れを胸に。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:19
translate ja dros_warn_0c171547:

    # DROS @ sad "Our secrets and fears pile up, they eat away at us Elves till if we're not careful, only regret remains."
    DROS @ sad "私たちの秘密と恐れは積み重なり、気をつけなければ、やがてエルフたちを蝕み、最後には後悔だけが残るのです。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:20
translate ja dros_warn_69dde3f5:

    # DROS @ sad "In truth, I was married twice before, and whether it was my treatment of them, or my 'inclinations,' neither could stand the sight of me in the end."
    DROS @ sad "実を言うと、私は以前二度結婚していたが、私の扱い方も、私の『性向』も、結局はどちらも私の顔も見られなくなった。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:21
translate ja dros_warn_129ea7c0:

    # DROS @ sad "I swore to myself that I didnt need anyone else, that I was stronger on my own..."
    DROS @ sad "誰も必要としない、一人の方が強いと心に誓った…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:22
translate ja dros_warn_173c08d2:

    # DROS @ sad "But being alone for so long is no good for anyone."
    DROS @ sad "でも、長い間一人でいるのは誰でも良くないね。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:23
translate ja dros_warn_cedf6cf9:

    # DROS @ sad "I've become... {i}Hard...{/i} and cold to those around me over the years."
    DROS @ sad "長年の間に、私は周りの人々に対して…{i}硬く…{/i}冷たくなっていた。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:24
translate ja dros_warn_50c3dccb:

    # MC @ talk "But changing your body so?"
    MC @ talk "しかし、そんなに体を変えるのか？"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:25
translate ja dros_warn_b1b68944:

    # MC @ talk "Such a change should not be made just because of loneliness."
    MC @ talk "そのような変更は、寂しさだけの理由で行うべきではない。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:26
translate ja dros_warn_d7df6dab:

    # "Dros smiled."
    "ドロスは笑った。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:28
translate ja dros_warn_dfd4da1d:

    # DROS @ sad "If I could find someone to care for me for as I am now, I think I would be happy enough..."
    DROS @ sad "私を今のままの私として受け入れてくれる人がいれば、それだけで幸せでいられると思う…"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:29
translate ja dros_warn_4c5f4783:

    # DROS @ sad "But I have always found myself drawn to women rarely because I wanted to sleep with them."
    DROS @ sad "しかし、僕は女性に惹かれるとき、それがほとんど寝たいからではないことに、いつも気がつくんだ。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:30
translate ja dros_warn_cc690890:

    # DROS @ sad "More-so, because I always {i}wanted to be them.{/i}"
    DROS @ sad "むしろ、私がいつも{i}彼らになりたかったから{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:31
translate ja dros_warn_b19613d8:

    # DROS @ sad "So, yes... I'm willing to take the risk."
    DROS @ sad "それでは、そうですね…危険を冒すつもりです。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:32
translate ja dros_warn_8add379d:

    # MC @ talk "...I got you."
    MC @ talk "…捕まえた。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:33
translate ja dros_warn_87359f6a:

    # MC @ talk "I will return when there is news."
    MC @ talk "何かニュースがあれば戻ります。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:34
translate ja dros_warn_feda201a:

    # DROS @ smile "Perfect!"
    DROS @ smile "完璧!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:37
translate ja dros_warn_a0829d2c:

    # "Dros' answer actually surprised me."
    "ドロスの答えには結構驚いた。"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_warnDros.rpy:38
translate ja dros_warn_9c7ef6a6:

    # "For someone so hot-headed, with such a inflated ego, he seemed surprisingly humble and even brave when it came to this."
    "短気で自尊心の強い彼が、こういうことになると意外にも謙虚で、むしろ勇敢に見えた。"

