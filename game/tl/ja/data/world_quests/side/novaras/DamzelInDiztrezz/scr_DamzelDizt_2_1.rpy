# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:2
translate ja qst_DamzelDizzt_2_frontal_548b4fd9:

    # MARKUS "Feeling a little bloodthirsty today, aren't we?"
    MARKUS "今日は少し殺伐とした気分じゃない？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:3
translate ja qst_DamzelDizzt_2_frontal_add1e9c7:

    # MARKUS "Fine, but we’ll have to be quick..."
    MARKUS "わかった、でも急がないと…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:4
translate ja qst_DamzelDizzt_2_frontal_2972c58e:

    # MARKUS "The commotion will likely draw the attention of the guards and if they see us we’re in trouble..."
    MARKUS "騒ぎはおそらく守衛の注意を引きつけるだろう。見つかれば厄介なことになる…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:5
translate ja qst_DamzelDizzt_2_frontal_7c9fd421:

    # NIJAH "Y-You intend to fight zem all?!"
    NIJAH "あ、あんた…全てと戦う気か？!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:6
translate ja qst_DamzelDizzt_2_frontal_83589d81:

    # MC @ talk "I do."
    MC @ talk "はい。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:7
translate ja qst_DamzelDizzt_2_frontal_2c197c20:

    # NIJAH "But... You will die!"
    NIJAH "でも…あなたは死んでしまう!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:8
translate ja qst_DamzelDizzt_2_frontal_8e039c33:

    # MC @ talk "Trust me Nijah, we will not be the ones dying tonight..."
    MC @ talk "信じてくれ、ナイジャ、今夜死ぬのは俺たちじゃない…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:9
translate ja qst_DamzelDizzt_2_frontal_881ada47:

    # MC @ talk "But the guards are a problem Markus, you're right."
    MC @ talk "だが守衛が問題だ、Markusよ、その通りだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:10
translate ja qst_DamzelDizzt_2_frontal_c645d33e:

    # MARKUS "We should scout the place out first at night, before anything."
    MARKUS "何より先に、夜に下見を行うべきだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:11
translate ja qst_DamzelDizzt_2_frontal_c54d1155:

    # MARKUS "At least try get some kind of understanding of what we're up against..."
    MARKUS "せめて相手が何者かくらいは理解しようとしろ…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:12
translate ja qst_DamzelDizzt_2_frontal_34a71376:

    # MC @ talk "That's a good idea."
    MC @ talk "それはいい考えだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:13
translate ja qst_DamzelDizzt_2_frontal_b47005bb:

    # MARKUS "Meet me in the Pleasure District tonight, we'll do some scouting from there."
    MARKUS "今夜、歓楽街で会おう、そこから様子を見るんだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:14
translate ja qst_DamzelDizzt_2_frontal_d4f4b8d8:

    # NIJAH "I come."
    NIJAH "我、参る。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:15
translate ja qst_DamzelDizzt_2_frontal_e87bac32:

    # MC @ talk "It's too dangerous Nijah, if they see you with us they could try something."
    MC @ talk "危険すぎるニージャ、奴らに君が俺たちと一緒にいるところを見られたら何かを仕掛けてくるかもしれない。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:16
translate ja qst_DamzelDizzt_2_frontal_6d31a3ce:

    # NIJAH @ sad "But-"
    NIJAH @ sad "でも-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:17
translate ja qst_DamzelDizzt_2_frontal_cb4922bc:

    # MC @ talk "Can you handle a sword?"
    MC @ talk "剣は使えるか？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:18
translate ja qst_DamzelDizzt_2_frontal_a6530312:

    # NIJAH "I... No."
    NIJAH "私…
ダメだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:19
translate ja qst_DamzelDizzt_2_frontal_b11ddb34:

    # MC @ talk "If they catch us Nijah, we might not be able to protect you."
    MC @ talk "もし捕まったら、ニジャ、私たちはあなたを守れなくなるかもしれない。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:20
translate ja qst_DamzelDizzt_2_frontal_f0d24a92:

    # MC @ talk "It's too dangerous..."
    MC @ talk "危険すぎる…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:21
translate ja qst_DamzelDizzt_2_frontal_849a9251:

    # "Nijah looked like she might say something at first, but instead she bite her lip and nodded reluctantly."
    "ニージャは最初は何か言おうとする様子だったが、代わりに唇を噛み、仕方なさそうにうなずいた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:22
translate ja qst_DamzelDizzt_2_frontal_83dc5d60:

    # NIJAH "Y-Yes, I stay."
    NIJAH "は、はい、残ります。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:23
translate ja qst_DamzelDizzt_2_frontal_9d5a99fb:

    # MC @ talk "We'll be back shortly, promise."
    MC @ talk "すぐ戻る。約束だよ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:24
translate ja qst_DamzelDizzt_2_frontal_2c1af5ac:

    # NIJAH "A-Alright..."
    NIJAH "あ…よし…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:33
translate ja qst_DamzelDizzt_2_ScoutDiamond_e64bc50d:

    # MARKUS "There you are."
    MARKUS "そこにいたのか。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:34
translate ja qst_DamzelDizzt_2_ScoutDiamond_5df5f812:

    # MARKUS "Are you ready for this?"
    MARKUS "覚悟はいい？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:37
translate ja qst_DamzelDizzt_2_ScoutDiamond_b3e0fd21:

    # MARKUS "Alright, let's head up onto some of these rooftops and scout out the perimeter."
    MARKUS "よし、そこの屋上に上がって周辺の見回りをしよう。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:38
translate ja qst_DamzelDizzt_2_ScoutDiamond_9e409d08:

    # MC @ talk "Sounds like a plan."
    MC @ talk "いい考えだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:42
translate ja qst_DamzelDizzt_2_ScoutDiamond_0ccccc57:

    # "Clambering onto the rooftops, we moved our way as silently as we could and watched from afar."
    "屋根によじ登りながら、できるだけ静かに移動して、遠くから眺めた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:43
translate ja qst_DamzelDizzt_2_ScoutDiamond_98aa6d51:

    # "Here and there the odd guards, always in twos, would patrol around the boundaries of the Black Diamond, while another two always stayed at the Entrance."
    "ところどころに、時折見かける衛兵たちは常に二人一組で黒ダイヤの境界を巡回し、一方で別の一組が常に入口に詰めていた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:44
translate ja qst_DamzelDizzt_2_ScoutDiamond_b8cf3b79:

    # "From inside, I focused and could hear a few dozen heart beats, but it was impossible to tell the difference between the clients, girls and guards."
    "建物の中から、集中すると数十個の心臓の鼓動が聞き取れたが、それが客と、女の子と、警備員のどれに属するかを判別するのは不可能だった。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:45
translate ja qst_DamzelDizzt_2_ScoutDiamond_b484682b:

    # "After some time we decided to take a closer look."
    "しばらくして、私たちはもっとよく見ることに決めた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:46
translate ja qst_DamzelDizzt_2_ScoutDiamond_6f33ab64:

    # "Climbing in through one of the windows, we watched and looked down from the rafters concealed in darkness... Seeing the Black Diamond below."
    "窓のひとつから這い入り、私達は闇に隠された梁から見下ろし、見つめていた… 下に見えるブラック・ダイヤモンドを。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:51
translate ja qst_DamzelDizzt_2_ScoutDiamond_18b3f7b5:

    # MC "(Can you hear me?)"
    MC "(聞こえますか？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:52
translate ja qst_DamzelDizzt_2_ScoutDiamond_ff3583df:

    # MARKUS "(Yes, now quit shouting!)"
    MARKUS "(ああ、もうやめろ!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:53
translate ja qst_DamzelDizzt_2_ScoutDiamond_3681b84f:

    # MC "(I'm not shouting! I'm just not used to talking with my mouth shut!)"
    MC "(叫んでない!黙ったまま話すのに慣れてないだけ!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:54
translate ja qst_DamzelDizzt_2_ScoutDiamond_8c1d2014:

    # MARKUS "(Bah! Focus! How many guards can you see?)"
    MARKUS "(ちっ! 集中しろ! 見える警備員は何人だ？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:55
translate ja qst_DamzelDizzt_2_ScoutDiamond_e9934e8c:

    # "Through the darkness I peered around, my vision once I focused in, was able to make out through these strange red like outlines where people stood even in pitch black corners."
    "暗闇の中、私は周りを見渡した。一度視点を定めると、この奇妙な赤い輪郭のようなもので、真っ暗な片隅に立つ人々の姿さえも捉えることができた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:56
translate ja qst_DamzelDizzt_2_ScoutDiamond_d6466b18:

    # MC "(...I count fourteen here.)"
    MC "(…ここに14を数える。)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:57
translate ja qst_DamzelDizzt_2_ScoutDiamond_60823c7e:

    # MARKUS "(There is probably more upstairs.)"
    MARKUS "(上層には、もっとありそうだ。)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:58
translate ja qst_DamzelDizzt_2_ScoutDiamond_d8176576:

    # MC "(Don't suppose you two have anything to say.)"
    MC "(…二人とも、何か言うことはないのか。)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:59
translate ja qst_DamzelDizzt_2_ScoutDiamond_3abf4d2e:

    # BLACK "{i}(Something beneath feet...){/i}"
    BLACK "{i}(足元に何かが…){/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:60
translate ja qst_DamzelDizzt_2_ScoutDiamond_d916bdad:

    # BLACK "{i}(Can hear it... rumbling.){/i}"
    BLACK "{i}(聞こえる…ゴロゴロいう音が){/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:61
translate ja qst_DamzelDizzt_2_ScoutDiamond_411aa358:

    # WHITE "{i}(Cautious... More danger than appears.){/i}"
    WHITE "{i}(注意深く…見た目以上の危険が潜んでいる。){/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:62
translate ja qst_DamzelDizzt_2_ScoutDiamond_4cb5d00d:

    # MARKUS "(Well, what is it?)"
    MARKUS "(さて、なんだ？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:63
translate ja qst_DamzelDizzt_2_ScoutDiamond_cae525a0:

    # MARKUS "(...Hello? HELLO!)"
    MARKUS "(…もしもし？ もしもし!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:64
translate ja qst_DamzelDizzt_2_ScoutDiamond_9fd7c1db:

    # MARKUS "(Fucking hells! Why do they just stop talking like that?)"
    MARKUS "(ちくしょう!なんで急に黙るんだよ？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:65
translate ja qst_DamzelDizzt_2_ScoutDiamond_259dbccd:

    # MC "(We should go Markus, before someone notices us here.)"
    MC "(マーカス、誰かに気づかれる前にここを離れるべきだ。)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:66
translate ja qst_DamzelDizzt_2_ScoutDiamond_69dbec03:

    # MARKUS "(Yes, we should-)"
    MARKUS "(ええ、私たちは…すべきですね――)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:67
translate ja qst_DamzelDizzt_2_ScoutDiamond_d3d687e0:

    # MARKUS "(Hold on, that one... Is that our man?)"
    MARKUS "(待てよ、あの…　あいつがターゲットか？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:68
translate ja qst_DamzelDizzt_2_ScoutDiamond_57d0ba51:

    # "We watched as the one bandit strolled his way into the Black Diamond, he looked different than the others, and four bandit guards walked protectively alongside him."
    "我々は一人の盗賊が悠然とブラックダイヤモンドへ足を踏み入れるのを見ていた。彼の外見も一味違っていた。四人の盗賊の護衛が守るように彼に付き従っていた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:69
translate ja qst_DamzelDizzt_2_ScoutDiamond_f21f5bbd:

    # "As he entered, all eyes seemed to turn towards him, and one of the bandits moved out to greet him."
    "彼が入ってくると、一斉に視線が集まり、一人の山賊が迎えに出てきた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:77
translate ja qst_DamzelDizzt_2_ScoutDiamond_2c87a044:

    # BANDIT "Great Khan, I am here to deliver your tribute from your vassals."
    BANDIT "大汗、これにて家臣たちからの貢ぎ物を献上いたします。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:78
translate ja qst_DamzelDizzt_2_ScoutDiamond_01329b9a:

    # TAREK "And who pays me greatest tribute today?"
    TAREK "では、今日、誰が私に最も偉大な貢ぎ物を捧げるのは？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:79
translate ja qst_DamzelDizzt_2_ScoutDiamond_9fe53e57:

    # BANDIT "...The khazahs my khan."
    BANDIT "…カザースの我がカン。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:80
translate ja qst_DamzelDizzt_2_ScoutDiamond_086a66c9:

    # TAREK "The Khazahs... {i}again?{/i}"
    TAREK "カザフ族が…{i}またか？{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:81
translate ja qst_DamzelDizzt_2_ScoutDiamond_420bfaae:

    # TAREK @ angry "Should I always expect the Vulshans to fall behind everytime now?"
    TAREK @ angry "今後は毎回、ヴァルシャン家が遅れるのをいつも覚悟すればいいのか？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:82
translate ja qst_DamzelDizzt_2_ScoutDiamond_2ca400bc:

    # BANDIT "We are pushing our men as hard as we can!"
    BANDIT "我々は兵士を可能な限り奮闘させている!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:83
translate ja qst_DamzelDizzt_2_ScoutDiamond_f02ad6a1:

    # BANDIT "But with your restrictions, things are... {i}difficult.{/i}"
    BANDIT "しかし、君の制限があるから、物事は…{i}困難だ。{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:84
translate ja qst_DamzelDizzt_2_ScoutDiamond_f27624bd:

    # TAREK "My rules are in place to protect all of us."
    TAREK "私の規則は我々全員を守るために存在する。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:85
translate ja qst_DamzelDizzt_2_ScoutDiamond_209850d6:

    # TAREK @ angry "But I don't see the Khazahs complaining about them."
    TAREK @ angry "だが、カザフ族がそれについて文句を言っている様子はないが。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:86
translate ja qst_DamzelDizzt_2_ScoutDiamond_91981a6f:

    # BANDIT "...Of course Great Khan, we will do better next time."
    BANDIT "…もちろんでございます、大ハーン、次は必ず改善いたします。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:87
translate ja qst_DamzelDizzt_2_ScoutDiamond_234ae860:

    # TAREK "See it done."
    TAREK "やってみせろ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:94
translate ja qst_DamzelDizzt_2_ScoutDiamond_76b5605d:

    # "As Tarek marched off, I could sense the furious rage brewing inside the man he just spoke to."
    "タレクが立ち去ると、彼が話していた男の内に沸き立つ激しい怒りを感じ取れた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:95
translate ja qst_DamzelDizzt_2_ScoutDiamond_7ec425d1:

    # "If I didn't know any better, one would think he wanted to {i}kill{/i} Tarek."
    "事情を知らなければ、彼がタレクを{i}殺そうとしている{/i}と思うだろう。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:100
translate ja qst_DamzelDizzt_2_ScoutDiamond_25a5b2ae:

    # MC "(I've seen enough, come on, before we are seen...)"
    MC "(もう見たから、早く、見つかる前に…)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:105
translate ja qst_DamzelDizzt_2_ScoutDiamond_cbd1dccc:

    # MARKUS "Don't be too long."
    MARKUS "あまり長くしないでください。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:116
translate ja qst_DamzelDizzt_2_frontal_return_b20d2376:

    # NIJAH "You're back!"
    NIJAH "おかえり!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:117
translate ja qst_DamzelDizzt_2_frontal_return_42308e1f:

    # MC @ talk "We scouted the place out, it's heavily guarded but we think we can take it."
    MC @ talk "下見しました、厳重に警備されていますが、我々は手にできそうだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:119
translate ja qst_DamzelDizzt_2_frontal_return_0e20432e:

    # MARKUS "And that amount of guards is nothing to laugh at!"
    MARKUS "それだけの護衛は冗談じゃない!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:120
translate ja qst_DamzelDizzt_2_frontal_return_459c414c:

    # MC @ talk "We'll need to be prepared for it..."
    MC @ talk "それに対する用意は必要だ…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:121
