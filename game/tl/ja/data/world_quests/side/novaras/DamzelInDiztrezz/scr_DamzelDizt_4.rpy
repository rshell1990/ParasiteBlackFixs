translate ja qst_DamzelDizzt_2_afterAction_8d021993:

    # "Back in my room, Nijah took a few steps back away from us the second she could."
    "部屋に戻ると、ニジャはできるだけ早く私たちから数歩離れた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:9
translate ja qst_DamzelDizzt_2_afterAction_685b8701:

    # NIJAH "You... Zat was..."
    NIJAH "あなた…　ザットは…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:10
translate ja qst_DamzelDizzt_2_afterAction_0bbf9745:

    # MC @ talk "Nijah, you have to trust us."
    MC @ talk "ニジャ、私たちを信じて。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:11
translate ja qst_DamzelDizzt_2_afterAction_4e940762:

    # NIJAH "Are you... humans?"
    NIJAH "あなたたちは…人間？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:12
translate ja qst_DamzelDizzt_2_afterAction_bcd4deec:

    # "Me and Markus shared a uncomfortable look, slightly unsure now even amongst ourselves."
    "俺とマーカスは気まずそうな目配せを交わした、互いに、ほんの少し自信をなくしていた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:13
translate ja qst_DamzelDizzt_2_afterAction_2242b5a5:

    # MARKUS "Yes... Well... {i}Sort of.{/i}"
    MARKUS "ええ…まあ…{i}そんな感じです。{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:14
translate ja qst_DamzelDizzt_2_afterAction_fbd49721:

    # NIJAH "..."
    NIJAH "……"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:15
translate ja qst_DamzelDizzt_2_afterAction_99f875e5:

    # NIJAH @ sad "Zis is quite a lot to take in."
    NIJAH @ sad "Zisはなかなか消化しきれないな。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:16
translate ja qst_DamzelDizzt_2_afterAction_7ea7174e:

    # "Nijah rubbed nervously at her brow, feeling a little lightheaded with everything she just saw."
    "ニジアはそっと額をこすり、今見た全てのことに少し目眩がしていた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:17
translate ja qst_DamzelDizzt_2_afterAction_d491d130:

    # "Nijah stepped forward, prodding at my chest with her finger."
    "ニアが一歩前に出て、指で私の胸を突つくようにして。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:18
translate ja qst_DamzelDizzt_2_afterAction_04a98be0:

    # MC @ talk "Uh, do you mind?"
    MC @ talk "あの、ちょっといい？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:19
translate ja qst_DamzelDizzt_2_afterAction_fbd49721_1:

    # NIJAH "..."
    NIJAH "……"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:20
translate ja qst_DamzelDizzt_2_afterAction_f6d437f8:

    # NIJAH "It was like metal... But stronger.."
    NIJAH "金属みたい... でも、それ以上だ"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:21
translate ja qst_DamzelDizzt_2_afterAction_653ed8d3:

    # "I reached out to gently grab her hand, snapping her out of what ever trance she had put herself in."
    "そっと手を伸ばし、彼女の手を掴むと、彼女は我に返った。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:22
translate ja qst_DamzelDizzt_2_afterAction_13b62009:

    # MC @ talk "Nijah..."
    MC @ talk "ニージャ…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:23
translate ja qst_DamzelDizzt_2_afterAction_b88ab1e0:

    # NIJAH "You... You can change into..."
    NIJAH "あなたは…姿を変えられる…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:24
translate ja qst_DamzelDizzt_2_afterAction_68ce8f4c:

    # NIJAH "{i}That?{/i}"
    NIJAH "{i}それ？{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:25
translate ja qst_DamzelDizzt_2_afterAction_4ed94cd8:

    # MC @ talk "... Yes... We can change into those things."
    MC @ talk "はい…私たちはあの姿に変わることができます。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:26
translate ja qst_DamzelDizzt_2_afterAction_4d1bce36:

    # "Nijah stared blankly ahead for a few moments before taking a deep sigh, and just like that, she reverted back to her old self again."
    "ニジャは虚ろな目で前方を見つめ、数秒間ぼんやりとした後、深いため息をつくと、あっさりとまたいつもの自分に戻った。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:27
translate ja qst_DamzelDizzt_2_afterAction_ffc0320c:

    # NIJAH "... I zee."
    NIJAH "...ふむ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:28
translate ja qst_DamzelDizzt_2_afterAction_be9147a2:

    # "Me and Markus curiously looked at each other before looking back at her."
    "俺とマーカスは不思議そうに見つめ合ってから、彼女の方を見た。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:29
translate ja qst_DamzelDizzt_2_afterAction_efb244a7:

    # MC @ talk "... You do?"
    MC @ talk "そうなの？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:30
translate ja qst_DamzelDizzt_2_afterAction_c06e04b6:

    # "Nijah smiled sheepishly, still trembling slightly as she spoke, but I could hear her heart beginning to settle."
    "ニージャは照れくさそうに微笑んだ、まだ少し震えながら話すけれど、その心が落ち着き始めているのが聞こえた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:31
translate ja qst_DamzelDizzt_2_afterAction_4417cfdb:

    # NIJAH "Your secret is safe with me."
    NIJAH "あなたの秘密は私が守ります。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:32
translate ja qst_DamzelDizzt_2_afterAction_9ffb4d28:

    # NIJAH "I owe you much..."
    NIJAH "恩に着る…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:33
translate ja qst_DamzelDizzt_2_afterAction_3f16aeb9:

    # "I turned to Markus who gave me a look of ‘Is she going to actually keep this quiet or not?’"
    "マーカスに視線を向けると、彼は「彼女は本当にこのことを黙っているつもりなのか？」という表情を浮かべていた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:34
translate ja qst_DamzelDizzt_2_afterAction_098d9497:

    # MC @ talk "Markus, thank you for helping me."
    MC @ talk "マルクス、手伝ってくれてありがとう。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:35
translate ja qst_DamzelDizzt_2_afterAction_9a602a37:

    # MARKUS "Well, I was hardly going to just let you get yourself killed, was I?"
    MARKUS "ふふっ、よくも平気で死ねると思った？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:36
translate ja qst_DamzelDizzt_2_afterAction_f01d242d:

    # MC @ talk "Still..."
    MC @ talk "それでも…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:37
translate ja qst_DamzelDizzt_2_afterAction_26d00492:

    # "Nijah piped up."
    "ニジャが口を挟んだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:38
translate ja qst_DamzelDizzt_2_afterAction_beab34ed:

    # NIJAH "Thank you... both."
    NIJAH "ありがとう…二人とも。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:39
translate ja qst_DamzelDizzt_2_afterAction_6fec193a:

    # "Markus rolled his eyes and smiled."
    "マルクスは目を丸くして、微笑んだ。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:40
translate ja qst_DamzelDizzt_2_afterAction_3792fe9d:

    # MARKUS "Well, just let me know if there’s any more trouble..."
    MARKUS "まあ、また何かあったら言って…"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:41
translate ja qst_DamzelDizzt_2_afterAction_985bd55c:

    # MARKUS "Goodnight, both."
    MARKUS "おやすみ、二人とも。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:42
translate ja qst_DamzelDizzt_2_afterAction_12fc8712:

    # "With that, Markus nodded towards me as he left."
    "そう言うと、マーカスは私に向かって頷きながら去っていった。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:44
translate ja qst_DamzelDizzt_2_afterAction_02a7a90f:

    # "When the door closed behind him, I turned to Nijah who nervously took a small step forward."
    "彼の後ろで扉が閉まると、私は緊張した面持ちで小刻みに一歩前に出たニアの方を向いた。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:45
translate ja qst_DamzelDizzt_2_afterAction_426f9298:

    # NIJAH "You were afraid to tell me... Why?"
    NIJAH "告げるのが怖かったんだね…どうして？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:46
translate ja qst_DamzelDizzt_2_afterAction_81003dde:

    # MC @ talk "I was afraid you might run away if you saw me like that, that you might—"
    MC @ talk "そんな姿で見られたら、君が逃げ出してしまうかも……それに君が――"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:47
translate ja qst_DamzelDizzt_2_afterAction_d05a2196:

    # "Nijah suddenly cupped my face and pulled me in for a kiss much to my bewilderment."
    "ニアが突然、手で私の顔を包み込むと、戸惑う私にキスをした。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:48
translate ja qst_DamzelDizzt_2_afterAction_c59a7cc4:

    # NIJAH "You... You did much to help."
    NIJAH "あなた... 本当に助かりました。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:49
translate ja qst_DamzelDizzt_2_afterAction_3015442c:

    # NIJAH "Keep no secrets from me... I care not for what you are."
    NIJAH "私から何も隠さないで…あなたが何者であろうと気にしない。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:50
translate ja qst_DamzelDizzt_2_afterAction_2988b59d:

    # NIJAH "{i}Because of who you are...{/i}"
    NIJAH "{i}あなたがあなたであるから…{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:54
translate ja qst_DamzelDizzt_2_afterAction_2d89b62a:

    # "We have spent some time together, and I finally felt calming down after the night's events."
    "ともに時を過ごしてきて、夜の出来事の後、ようやく落ち着けるようになった。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:55
translate ja qst_DamzelDizzt_2_afterAction_e55fad8b:

    # "I walked Nijah to her home, which turned out to be not that far from mine."
    "ニジャを家まで送っていったが、彼女の家は私の家からそれほど遠くないということがわかった。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:58
translate ja qst_DamzelDizzt_2_afterAction_77636738:

    # "Saying our goodbyes, Nijah gave me a warm embrace as she disappeared inside her house."
    "さよならを言いながら、ニアは温かい抱擁をくれ、家の中へ姿を消した。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:59
translate ja qst_DamzelDizzt_2_afterAction_4f5f7955:

    # BLACK "IT WAS A GOOD HUNT, HOST."
    BLACK "猟果でした、主。"

