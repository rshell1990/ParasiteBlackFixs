    "首を振りながら、アルレナは突然、口を押さえようと動いた。"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:205
translate ja qst_DaughterOfMetal_02_2_c41453c7:

    # MC @ talk "Arlena? Is everything alright?"
    MC @ talk "アーレナ？大丈夫？"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:206
translate ja qst_DaughterOfMetal_02_2_092940d3_2:

    # ARLENA "..."
    ARLENA "……"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:208
translate ja qst_DaughterOfMetal_02_2_e3baa581:

    # "She lurched towards one of the rooms where she slammed the door behind her."
    "彼女はよろめくように一つの部屋へ向かい、ドアをバタンと閉めた。"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:209
translate ja qst_DaughterOfMetal_02_2_8800a557_1:

    # "It was quickly followed by the sounds of retching."
    "すぐに、嘔吐の音が続いた。"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:210
translate ja qst_DaughterOfMetal_02_2_a72738d6:

    # MC "... Not exactly the reaction I was hoping for..."
    MC "……期待していた反応とはちょっと違うな……"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:211
translate ja qst_DaughterOfMetal_02_2_75937733:

    # MC "I better leave her be."
    MC "そっとしておこう。"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:212
translate ja qst_DaughterOfMetal_02_2_84b4da34:

    # "I left the Blacksmiths, closing the door behind me as I did so."
    "鍛冶屋を去り、ドアを閉めながら。"

translate ja strings:

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:30
    old "What are you talking about?"
    new "何を言ってるの？"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:36
    old "For what? Wanting jobs where we weren't at risk of starving?"
    new "なぜ？飢え死にする危険のない仕事を求めたことで？"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:42
    old "I know, it’s hard being better than everyone else sometimes, but I try."
    new "分かってる、一番でいるのは時々辛いけど、努力してるんだ。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:72
    old "I’m sorry."
    new "ごめんなさい。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:85
    old "{image=[ICON.HEART_BROKE]} I'm not sorry."
    new "{image=[ICON.HEART_BROKE]}謝らない。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:131
    old "You don’t want to know."
    new "知りたくないだろ。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:167
    old "Novaras Farmlands"
    new "ノヴァラス農園"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:189
    old "Go to bed. You’re drunk."
    new "寝ろ。酔ってる。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:197
    old "Humour her."
    new "彼女の機嫌を取る。"

