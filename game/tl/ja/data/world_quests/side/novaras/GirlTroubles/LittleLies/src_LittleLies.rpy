translate ja strings:

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:12
    old "The garden here is quite beautiful."
    new "ここの庭はなかなか美しい。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:19
    old "Do you get on with the other girls?"
    new "他の女の子たちとは仲良くできてる？"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:28
    old "Sister Divine wants me to teach you to be able to defend yourself."
    new "聖女ディバインが、あなたが自分を守れるように教えてほしいと。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:70
    old "How about I just give you some coin instead?"
    new "代わりに少しコインをあげようか？"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:80
    old "I'll give you five thousand and not a coin more..."
    new "五千までだ、一銭も出せん…"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:87
    old "Here, as agreed."
    new "さあ、約束通り。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:95
    old "I don't have your coin right now."
    new "今のところ、あなたのコインは持っていません。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:102
    old "Surely there must be something else you want..."
    new "きっと、他に望んでいることがあるはず…"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:125
    old "Has she been with Jana or Zara?"
    new "彼女はヤナとザラのどちらと一緒だったのか？"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:130
    old "How many girls has Sister Divine been with?"
    new "聖なるお姉さまは、今までに何人もの女の子と付き合ったことがありますか。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:138
    old "I will give it some thought."
    new "考えておく。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:143
    old "I will see about helping set up a little trust between you and Sister Divine."
    new "あなたと聖女ディバインの間に、小さな信頼関係を築く手配をしてみましょう。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:151
    old "I will get you your farming patch."
    new "農地を用意してあげる。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:170
    old "About the coin..."
    new "そのコインについて…"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:172
    old "About your garden patch for farming..."
    new "農園の区画について…"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:175
    old "Sister Divine's agreed to your request."
    new "聖女ディバインがあなたの願いを聞き入れた。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:197
    old "About sister Divine..."
    new "妹神について…"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:200
    old "I'll get back to you shortly with her answer."
    new "彼女からの返事については、折り返しご連絡します。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:203
    old "She said to meet her in the tower bathhouse this evening."
    new "彼女は言った、今晩、塔の浴場で会ってほしいと。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:220
    old "You don't need me there."
    new "あそこには私が必要ない。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:230
    old "I'll be there to keep an eye on you."
    new "見張っておくからね。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:449
    old "It's time to spar, Mika."
    new "さあ、稽古だ、ミカ。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:504
    old "Not yet; I have some things I need to take care of."
    new "まだです；済ませなければならない用事がいくつかあります。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:543
    old "Let's do it!"
    new "やろう!"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:606
    old "Not just yet."
    new "まだちょっと待って。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:637
    old "I'll walk with you, come."
    new "一緒に歩こう、おいで。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:643
    old "I have some business to attend first, I'll meet you there."
    new "先に用を済ませますので、後で合流します。"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:684
    old "You heard about that?"
    new "聞いた？"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:689
    old "{i}*Tell Mika the full, gory story in horrifying detail- omitting only your dark passenger*{/i}"
    new "{i}*ミカに、恐ろしい詳細まで微に入り細に入り、血生臭い物語を話す――ただし、あなたのダーク・パッセンジャーのことだけは隠しておいて*{/i}"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:703
    old "{i}Tell Mika the abbreviated story, sparing the worst details*{/i}"
    new "{i}酷い詳細は省いて、略式でミカに話す*{/i}"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:745
    old "Were you at least prepared?"
    new "少なくとも準備はできていたか？"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:750
    old "Surely you must have realized how dangerous a dungeon like that could be?"
    new "さすがに、そんなダンジョンがどれほど危険かお分かりでしょう？"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:756
    old "Then what happened?"
    new "それでどうなった？"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:803
    old "You were a child..."
    new "あなたは子供だった…"

    # game/data/world_quests/side/novaras/GirlTroubles/LittleLies/src_LittleLies.rpy:806
    old "You were... But I'll make you strong."
    new "あなたは… でも、強くしてあげる。"

