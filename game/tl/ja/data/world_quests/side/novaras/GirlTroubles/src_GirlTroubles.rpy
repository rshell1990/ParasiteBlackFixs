# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:87
translate ja qst_girl_troubles_main_label_menu_4_ea37f955:

    # DIVINE @ happy "Yes, I've {i}seen.{/i}"
    DIVINE @ happy "ええ、{i}見ました。{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:88
translate ja qst_girl_troubles_main_label_menu_4_ad7cb217:

    # DIVINE @ happy "She's come so much out of her shell since you've started helping her."
    DIVINE @ happy "あなたが手伝い始めてから、彼女は随分と殻を破ったわね。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:89
translate ja qst_girl_troubles_main_label_menu_4_6648b615:

    # MC @ talk "She's ready to face whatever's out there."
    MC @ talk "彼女は、どんなものが出てこようと覚悟はできている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:90
translate ja qst_girl_troubles_main_label_menu_4_d48d0774:

    # DIVINE @ talk "Well... No one's truly ever {i}ready.{/i}"
    DIVINE @ talk "まあ…誰も本当に{i}準備ができているわけじゃない。{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:91
translate ja qst_girl_troubles_main_label_menu_4_fdf7a669:

    # DIVINE @ talk "But I think now her fate is in the hands of the gods to keep her safe."
    DIVINE @ talk "でも今では、彼女の運命は守られるために神々の手に委ねられていると思う。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:99
translate ja qst_girl_troubles_main_label_menu_4_c0800976:

    # DIVINE @ talk "{i}Intimate?{/i}"
    DIVINE @ talk "{i}親しい？{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:100
translate ja qst_girl_troubles_main_label_menu_4_46740ede:

    # "Suddenly realizing what Mika was asking for, Sister Divine panicked as she offered sheepish protest."
    "突然、ミカが何を求めているかに気づいて、ディバインシスターは慌てふためき、申し訳なさそうに抗議を口にした。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:101
translate ja qst_girl_troubles_main_label_menu_4_f18d7bb4:

    # DIVINE @ shock "I- I never cross boundaries with any of the girls! I-I'm their-"
    DIVINE @ shock "い、いや!誰とでも一線は越えないよ!僕は彼女たちの…"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:102
translate ja qst_girl_troubles_main_label_menu_4_289c6df4:

    # MC @ talk "Sister Divine, Mika told me everything."
    MC @ talk "聖女ディバイン、ミカが全てを話してくれた。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:103
translate ja qst_girl_troubles_main_label_menu_4_d9eff049:

    # DIVINE @ sad "... I see."
    DIVINE @ sad "…なるほど。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:104
translate ja qst_girl_troubles_main_label_menu_4_61e8ed36:

    # DIVINE @ sad "I - I understand this probably isn't something you approve of, but..."
    DIVINE @ sad "あの…これはあなたが認めるようなことじゃないのは分かってます、でも…"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:105
translate ja qst_girl_troubles_main_label_menu_4_d23b7c9a:

    # DIVINE @ sad "Kindly keep this knowledge to yourself."
    DIVINE @ sad "このことは内緒にしておいてください。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:106
translate ja qst_girl_troubles_main_label_menu_4_7bdaee64:

    # DIVINE @ sad "The girls ... Us Mages of Palam, it's a terribly lonely life."
    DIVINE @ sad "その少女たちは…我らパラムの魔女たちは、物凄く寂しい人生を送るのです。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:107
translate ja qst_girl_troubles_main_label_menu_4_e13d3ea2:

    # DIVINE @ sad "The expectations to be these saint-like figures is crushing, especially for those who don't want it."
    DIVINE @ sad "聖人のような存在であることを求められる期待は、特にそれを望まない者にとっては押しつぶされそうな重圧だ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:108
translate ja qst_girl_troubles_main_label_menu_4_d6fdf35c:

    # DIVINE @ sad "A life without love is terrible, and love to a Mage of Palam is a delicate, often impossible thing to keep."
    DIVINE @ sad "愛のない人生は悲惨であり、パラムの魔術師にとって愛は、繊細で、往々にして保つことが不可能なものだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:109
translate ja qst_girl_troubles_main_label_menu_4_3a76119c:

    # DIVINE @ sad "But grown women still have needs ... So we find what we can of it amongst ourselves."
    DIVINE @ sad "しかし、大人の女だって欲求はあるから……私たちなりに、求め合うしかないんだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:110
translate ja qst_girl_troubles_main_label_menu_4_10285b36:

    # MC @ talk "You don't need to explain yourself to me, sister."
    MC @ talk "姉さん、私に説明しなくていいよ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:111
translate ja qst_girl_troubles_main_label_menu_4_4014a5dc:

    # MC @ talk "I only mentioned it because Mika has asked me to persuade you to give her the same affection as you give the others."
    MC @ talk "ミカが、あなたがほかの子たちに注いでいる愛情と同じものを彼女にも与えるよう、私に説得するように言われたから、口にしただけです。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:112
translate ja qst_girl_troubles_main_label_menu_4_c7f64210:

    # DIVINE @ sad "I-"
    DIVINE @ sad "私-"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:113
translate ja qst_girl_troubles_main_label_menu_4_cc9e4cc1:

    # DIVINE @ talk "I didn't quite realize she felt that way, I never intended to make her feel unwanted."
    DIVINE @ talk "彼女があんな風に思っているとは気づかなかった。
わざと疎外感を味わわせようとしたわけじゃない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:114
translate ja qst_girl_troubles_main_label_menu_4_91c8563f:

    # DIVINE @ embar "... Very well, tell Mika to meet me in the tower bathhouse tonight."
    DIVINE @ embar "…よかろう、今夜ミカを塔の浴場に来させるがよい。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:115
translate ja qst_girl_troubles_main_label_menu_4_6ab76246:

    # DIVINE @ embar "I shall make it up to her in full."
    DIVINE @ embar "必ずや、彼女に償ってみせる。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:120
translate ja qst_girl_troubles_main_label_menu_4_281e28d6:

    # DIVINE @ talk "Very well then."
    DIVINE @ talk "では、よろしい。"

translate ja strings:

    # game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:6
    old "Mika is refusing to let me train her to fight unless she gets her gardening patch on the rooftops."
    new "ミカは、屋上の家庭菜園を条件にしないと、戦う訓練をさせてくれないんだ。"

    # game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:16
    old "Are all the mages as tightly controlled as the Mages of Palam?"
    new "パラムの魔道士たちと同じように、全ての魔道士は厳しく管理されているのですか？"

    # game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:24
    old "Then how did you let things slip past with the girls?"
    new "それでは、どうしてあの女の子たちとのことを見逃したの？"

    # game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:27
    old "Surely there must be a way?"
    new "何か方法があるはずだ？"

    # game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:32
    old "Oh, we both know what I offer you in return...{i}*run your hand down her back.*{/i}"
    new "ああ、俺が何を差し出すかはお互い様だ…{i}*彼女の背中を手でなぞる。*{/i}"

    # game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:43
    old "Would coin suffice?"
    new "硬貨で十分でしょうか。"

    # game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:53
    old "Make it two thousand at least; that amount of coin is nothing to be laughed at for most."
    new "せめて二千にしろよ、そんくらいの金額、大抵の人間なら笑い飛ばせる額じゃないんだから。"

