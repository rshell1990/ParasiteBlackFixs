# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:10
translate ja qst_girl_troubles_main_label_menu_93d2269a:

    # DIVINE @ angry "Not to mention that if she leaves the tower, who exactly is supposed to tend to this farming patch in her absence?"
    DIVINE @ angry "いうまでもなく、彼女が塔を出て行ったら、留守の間この畑の世話は一体誰がするのでしょうか。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:11
translate ja qst_girl_troubles_main_label_menu_55796b30:

    # MC @ talk "Surely you can spare some small section of the garden for her?"
    MC @ talk "きっと、庭の一部を彼女のために譲ってあげられませんか？"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:12
