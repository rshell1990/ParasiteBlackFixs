# TODO: Translation updated at 2026-01-19 18:56

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:3
translate ja primer_girl_troubles_1_fc4cddb5:

    # MESSENGER "Wait! Hold up!"
    MESSENGER "ちょっと待って!待ってよ!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:5
translate ja primer_girl_troubles_1_0ed1380f:

    # "Stopping in my tracks, I turned to face the young boy hurrying towards me."
    "足を止め、急いで近づいてくる少年のほうへと振り返った。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:7
translate ja primer_girl_troubles_1_cc1bdfcf:

    # MC @ think "Can I help you?"
    MC @ think "何かお手伝いしましょうか？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:8
translate ja primer_girl_troubles_1_b9d4697a:

    # MESSENGER "Sister Divine requests your presence at the tower of Palam at once."
    MESSENGER "聖女ディバインが、直ちにパラムの塔へご出席を求めている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:9
translate ja primer_girl_troubles_1_ff0934a5:

    # MC @ talk "Sister Divine?"
    MC @ talk "シスター・ディヴァイン？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:10
translate ja primer_girl_troubles_1_bef6b9ee:

    # MC @ talk "Did you say why?"
    MC @ talk "なぜ、って言った？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:11
translate ja primer_girl_troubles_1_4755a9a3:

    # MESSENGER "No sir, but she said it was a matter most urgent."
    MESSENGER "いいえ、お客様、しかし彼女はそれが至急の用件だと申しておりました。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:12
translate ja primer_girl_troubles_1_2e49f35d:

    # MESSENGER "Now, if you'll excuse me, I've got to deliver my next message!"
    MESSENGER "それでは、次の伝言を届けに行かなければ!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:16
translate ja primer_girl_troubles_1_bd996885:

    # MC "(Hmm... I should stop by the tower of Palam when I get a chance.)"
    MC "(うーん… 機会があったらパラムの塔に寄ってみよう。)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:26
translate ja primer_girl_troubles_2_4fb8f212:

    # DIVINE @ talk "Ah, there you are."
    DIVINE @ talk "ああ、そこにいたのか。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:27
translate ja primer_girl_troubles_2_bd6dbff0:

    # "Divine steps out from behind her desk, a playful glint in her eye as she moves closer."
    "ダイバインは机の後ろから一歩踏み出し、いたずらっぽい輝きを瞳に宿しながら近づいてくる。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:32
translate ja primer_girl_troubles_2_4630b090:

    # "Without a word, she wraps her arms around me, her lips finding mine in a slow, deliberate kiss."
    "一言も発せず、彼女はそっと私を抱き寄せ、ゆっくりと確かな口付けを重ねる。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:33
translate ja primer_girl_troubles_2_dd678d35:

    # MC "(Her touch is familiar, warm...)"
    MC "(彼女の触れ合いは、懐かしく温かい…)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:34
translate ja primer_girl_troubles_2_01941bc7:

    # "My hand drifts down instinctively, fingers grazing her waist before resting on her backside."
    "手が無意識に滑り落ち、指が彼女の腰を軽く触れてから、やがて臀部に落ち着く。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:35
translate ja primer_girl_troubles_2_e70ed2d3:

    # DIVINE @ happy "Mmm... You never change, do you?"
    DIVINE @ happy "んん…やっぱり、あなたって変わらないわね。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:36
translate ja primer_girl_troubles_2_964d7d25:

    # "She lets out a soft, breathy laugh, before gently pushing away, cheeks flushed."
    "彼女はふわりとした笑い声を漏らし、ほんのり赤らめた頬をしながら、そっと身を引いた。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:41
translate ja primer_girl_troubles_2_db756b90:

    # MC @ smile "That's quite a desk you’ve got there, you know. I'd love to see you—"
    MC @ smile "なかなかのデスクだな、あんたのも。見てみたいものだな、あなたが――"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:42
translate ja primer_girl_troubles_2_ef0995eb:

    # DIVINE @ laugh "Easy, easy! I didn’t call you here for {i}that.{/i}"
    DIVINE @ laugh "落ち着いて、落ち着いて!  
{i}そんなの{/i}で呼んだんじゃないんだから。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:43
translate ja primer_girl_troubles_2_a93764bb:

    # DIVINE @ happy "Though, maybe later... if there's time."
    DIVINE @ happy "でも、後で…時間があれば。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:45
translate ja primer_girl_troubles_2_dde96000:

    # "Sister Divine stands behind her desk, her expression unreadable as she watches me enter."
    "聖女ディバインは机の後ろに立ち、私が入ってくるのを無表情で見つめている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:46
translate ja primer_girl_troubles_2_b9dbb770:

    # DIVINE @ talk "It’s good to see you again. I’ve been meaning to speak with you."
    DIVINE @ talk "またお会いできて光栄です。お話があるのですが。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:48
translate ja primer_girl_troubles_2_559540db:

    # MC @ talk "So, what's this about?"
    MC @ talk "じゃあ、これって何のこと？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:49
translate ja primer_girl_troubles_2_1eea1aea:

    # DIVINE @ talk "Tell me, what do you know about the tower?"
    DIVINE @ talk "教えてくれ、塔について何を知っている？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:50
translate ja primer_girl_troubles_2_399a0353:

    # MC @ think "Hm? Not much..."
    MC @ think "ふむ？ 別に…"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:51
translate ja primer_girl_troubles_2_63c38e46:

    # MC @ talk "I know mages of Palam are taken from their parents from a young age to join the order."
    MC @ talk "パラムの魔導士たちは幼い頃から親元から引き離され、騎士団に入るのだと聞いている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:52
translate ja primer_girl_troubles_2_51c5a5cf:

    # DIVINE @ talk "Being a mage is a lifelong commitment, and many start young at one of the smaller holds before coming here."
    DIVINE @ talk "魔術師であることは一生涯をかけることで、多くの者は小さなホールドで幼い頃から始め、ここへ来る前に修行を積む。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:53
translate ja primer_girl_troubles_2_a09d053a:

    # DIVINE @ talk "It's best to think of this tower as a kind of university, but to mages, any hold under their magecraft is considered a second home they're expected to return to throughout their life periodically."
    DIVINE @ talk "この塔は一種の大学と考えればよいが、魔術師にとっては、自らの魔術の影響下にある拠点は、生涯にわたり定期的に戻ることを期待される第二の故郷とみなされるのだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:54
translate ja primer_girl_troubles_2_eec6e3a7:

    # DIVINE @ talk "Suffice it to say I care for each and every girl who comes here, many of whom I've known to some degree since they were small."
    DIVINE @ talk "言うまでもなく、ここに来る女の子たち一人一人を大切に思っている。多くは幼い頃からある程度知っている子たちだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:55
translate ja primer_girl_troubles_2_df064ee4:

    # MC @ talk "I see... But why the urgent summoning? Where do I fit into all this?"
    MC @ talk "ふむ…だが、なぜ急な召集なんだ？
一体、私がどう関わるつもりで？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:56
translate ja primer_girl_troubles_2_a9467911:

    # DIVINE @ talk "Since this war began, Mages have been, with the end of every terminus ceremony, sent towards the front."
    DIVINE @ talk "開戦以来、魔術師たちは、ターミナス儀式を終えるその度に、前線へと送り込まれてきた。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:57
translate ja primer_girl_troubles_2_af61e39a:

    # DIVINE @ talk "Thankfully, many of my girls are usually kept back to help deal with the wounded, so losses are limited."
    DIVINE @ talk "幸い、我が娘たちの多くは負傷者の手当てに回されることが多いため、被害は最小限に抑えられている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:58
translate ja primer_girl_troubles_2_a8a38eea:

    # DIVINE @ talk "With that said, Alcott's government continues to put more and more pressure on getting out the door, regardless of capabilities."
    DIVINE @ talk "かくして、アルコット政府はその能力に関わらず、現場に出ることにますます圧力をかけ続けている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:59
translate ja primer_girl_troubles_2_8241cd14:

    # "Sister Divine paused uncomfortably."
    "シスターディバインは不快そうに立ち止まった。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:60
translate ja primer_girl_troubles_2_836dcfe9:

    # DIVINE @ talk "... Last month, four of my girls stationed at a camp were killed by a surprise ambush."
    DIVINE @ talk "…先月、うちの娘たち四人が駐屯地に配属されていたところを、不意の襲撃で殺された。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:61
translate ja primer_girl_troubles_2_eae6fb6b:

    # DIVINE @ talk "From what reports I have, the girls panicked and fumbled their spells."
    DIVINE @ talk "報告によれば、少女たちは慌てて魔法を誤魔化したそうだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:62
translate ja primer_girl_troubles_2_1cd0a9e5:

    # DIVINE @ sad "... They weren't ready."
    DIVINE @ sad "…彼らは準備ができていなかった。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:63
translate ja primer_girl_troubles_2_c3780307:

    # MC @ sad "That's horrible."
    MC @ sad "それは酷い。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:64
translate ja primer_girl_troubles_2_ead16311:

    # DIVINE @ angry "Standards are slipping..."
    DIVINE @ angry "基準が緩んでいる…"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:65
translate ja primer_girl_troubles_2_3eeccae0:

    # DIVINE @ sad "And my girls are dying for it."
    DIVINE @ sad "私の娘たちは夢中だ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:68
translate ja primer_girl_troubles_2_menu_685b6d3d:

    # DIVINE @ talk "I've tried."
    DIVINE @ talk "私は試した。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:69
translate ja primer_girl_troubles_2_menu_3a9ef15e:

    # DIVINE @ talk "The officials don't care for the quality of Mages, only that there {i}are{/i} Mages."
    DIVINE @ talk "役人たちは、魔術師の質よりも、魔術師が{i}いる{/i}ことさえ気にしている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:70
translate ja primer_girl_troubles_2_menu_9c138b9c:

    # DIVINE @ talk "My concerns fall on deaf ears."
    DIVINE @ talk "私の心配は聞き入れてもらえない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:73
translate ja primer_girl_troubles_2_menu_75a8f7bf:

    # DIVINE @ angry "I am aware people 'die' in war; I'm not a fool."
    DIVINE @ angry "戦争で人は『死ぬ』と承知している、私はバカじゃない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:74
translate ja primer_girl_troubles_2_menu_16b704db:

    # DIVINE @ talk "But there are only ever so many mages per year, and magecraft is a lifelong commitment to master."
    DIVINE @ talk "しかし、魔術師は毎年ほんの一握りしかおらず、魔術の習得には一生を捧げる覚悟が必要だ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:75
translate ja primer_girl_troubles_2_menu_6917f041:

    # DIVINE @ talk "It's not as simple as replacing a simple grunt... No offense."
    DIVINE @ talk "単純なうなり声を置き換えるほど簡単じゃない…悪気はないんだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:76
translate ja primer_girl_troubles_2_menu_c8f104a8:

    # MC @ talk "None taken."
    MC @ talk "いや、気にしてないよ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:79
translate ja primer_girl_troubles_2_menu_b528cbb1:

    # DIVINE @ talk "Three girls of mine, troublesome issues with each."
    DIVINE @ talk "三人の女の子、それぞれ厄介な問題を抱えている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:80
translate ja primer_girl_troubles_2_menu_5be2fe8f:

    # DIVINE @ talk "I've put my foot down and held them back from being assigned to the front."
    DIVINE @ talk "彼らを前線配属からは踏みとどまらせた。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:81
translate ja primer_girl_troubles_2_menu_ac431a22:

    # MC @ talk "Why?"
    MC @ talk "なぜ？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:82
translate ja primer_girl_troubles_2_menu_e02e14c6:

    # DIVINE @ talk "They're not ready... And I'm not prepared to knowingly send some of my girls to their deaths."
    DIVINE @ talk "奴らはまだ準備ができていない…
あえて娘たちを死地に送るつもりはない"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:83
translate ja primer_girl_troubles_2_menu_cd04b852:

    # DIVINE @ talk "Now, I don't have time to resolve these issues myself; I have to prepare the next batch of mages, who are already showing similar issues, for next year's terminus ceremony."
    DIVINE @ talk "さて、私自身がこれらの問題を解決する時間はない。来年の終端式に備え、同じような問題を抱え始めている次の魔法使いのグループを準備しなければならない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:84
translate ja primer_girl_troubles_2_menu_97eba329:

    # DIVINE @ talk "I want you to become their... Mentor."
    DIVINE @ talk "あなたに彼らの…メンターになってほしい。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:85
translate ja primer_girl_troubles_2_menu_592cb8fe:

    # MC @ surprised "Mentor? Me? I don't even possess any magecraft!"
    MC @ surprised "えっ？師匠？私？魔術すら持ってないんですけど!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:86
translate ja primer_girl_troubles_2_menu_f412c6a1:

    # DIVINE @ talk "Ah, but that's where you and your 'gift' come in nicely."
    DIVINE @ talk "ああ、しかし君とその『才能』がまさに活躍する出番だ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:87
translate ja primer_girl_troubles_2_menu_70c53a8b:

    # DIVINE @ talk "The Alderian government have refused to send me a mage capable of helping me, so I need the next best thing."
    DIVINE @ talk "アルデリア政府が、私を助けられる魔術師を派遣することを拒否した以上、次善の策が必要だ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:88
translate ja primer_girl_troubles_2_menu_560ed043:

    # DIVINE @ talk "Someone capable of really motivating these girls."
    DIVINE @ talk "これらの少女たちを本当に鼓舞できる誰か。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:89
translate ja primer_girl_troubles_2_menu_0d85e87a:

    # MC "(Meaning someone she can threaten to blackmail if I ever speak about what I see in here.)"
    MC "(つまり、ここで見たことを口にしようものなら、脅迫材料にできる人物というわけだ。)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:90
translate ja primer_girl_troubles_2_menu_59433de1:

    # MC @ talk "How am I supposed to do that?"
    MC @ talk "一体どうしろと？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:91
translate ja primer_girl_troubles_2_menu_de2af97e:

    # DIVINE @ talk "The method doesn't concern me; as long as the girls aren't harmed, I don't care what you do. "
    DIVINE @ talk "方法はどうでもいい。女の子たちに危害が及ばない限り、君が何をしようと構わん。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:92
translate ja primer_girl_troubles_2_menu_7d5dfde8:

    # DIVINE @ talk "For each girl dealt with, I'll give you seven hundred coins. Does that sound fair?"
    DIVINE @ talk "女を一人片付けるごとに、七百コインをやる。これで公平だろう？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:95
translate ja primer_girl_troubles_2_menu_2_270e239c:

    # DIVINE @ talk "Because I need someone I can trust with this,"
    DIVINE @ talk "だって、これを信頼できる誰かに頼む必要があるんだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:96
translate ja primer_girl_troubles_2_menu_2_bf1e2acc:

    # DIVINE @ talk "And after hearing from Captain Nyx about your recent help with her, it only made sense to ask you."
    DIVINE @ talk "そして、ニクス隊長からあなたが最近彼女を手助けしたと聞いた後では、ご依頼するのが筋だろうと思いました。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:97
translate ja primer_girl_troubles_2_menu_2_beee84fb:

    # MC @ talk "Wait ... Captain Nyx?"
    MC @ talk "ちょっと...ニクス船長？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:98
translate ja primer_girl_troubles_2_menu_2_2010828e:

    # DIVINE @ talk "The Captain and I are ... {i}often aligned{/i} when necessary."
    DIVINE @ talk "船長と私は…{i}必要な時は同じ方向を向いている{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:99
translate ja primer_girl_troubles_2_menu_2_308a2582:

    # DIVINE @ talk "I'd hardly call us friends, but we've come to depend on each other's resources sometimes."
    DIVINE @ talk "友人とは言い難いが、時に互いの資源に頼ることもある。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:102
translate ja primer_girl_troubles_2_menu_2_c7d4f56a:

    # DIVINE @ talk "I mean, {i}I don't care what you do.{/i}"
    DIVINE @ talk "つまり、{i}別に好きにすればいいけど。{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:103
translate ja primer_girl_troubles_2_menu_2_8cc9e6dd:

    # DIVINE @ talk "As long as they are not hurt, and you don't make a public spectacle of whatever you do with them, I only care about the end results."
    DIVINE @ talk "彼らに危害を加えない限り、また公衆の面前で醜態を晒さない限り、私は結果さえ出れば構わない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:106
translate ja primer_girl_troubles_2_menu_2_960647d4:

    # DIVINE @ talk "I cannot tell you until you agree to my request, but I will do my best to answer anymore questions you have."
    DIVINE @ talk "お願いを聞いてもらえるまでお話しできませんが、他にご質問があればできる限りお答えします。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:109
translate ja primer_girl_troubles_2_menu_3_7d9b1b5b:

    # MC @ talk "Mages of Palam are holy ordained, after all."
    MC @ talk "何しろパラムの魔術師たちは聖なる任命を受けているのですから。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:110
translate ja primer_girl_troubles_2_menu_3_dfe1bc33:

    # DIVINE @ angry "It is shameful when you're praying for a strong male heir or a daughter that you can marry off to another rich noble."
    DIVINE @ angry "強き跡継ぎの男子か、他国の富める貴族に嫁がせられる娘を願うとは、恥ずべきことだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:111
translate ja primer_girl_troubles_2_menu_3_a6aa2eef:

    # DIVINE @ talk "Us Mages of Palam are seen as a dead end."
    DIVINE @ talk "我々パラムの魔術師たちは、行き止まりと見られている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:112
translate ja primer_girl_troubles_2_menu_3_5492d872:

    # MC @ talk "But can't Mages of Palam continue a bloodline?"
    MC @ talk "しかし、パラムの魔術師は血筋を続けることはできないのでしょうか？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:113
translate ja primer_girl_troubles_2_menu_3_778e69e4:

    # MC @ talk "You can sire young with women and can get pregnant yourselves, can you not?"
    MC @ talk "女性との間に子孫を残すことも、ご自身も妊娠されることも可能なのでしょう？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:114
translate ja primer_girl_troubles_2_menu_3_df70b7f3:

    # MC @ think "How then are you a dead end?"
    MC @ think "それであなたはどうして行き止まりなの？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:115
translate ja primer_girl_troubles_2_menu_3_d60e62c4:

    # "Sister Divine smiled."
    "聖女ディバインは微笑んだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:116
translate ja primer_girl_troubles_2_menu_3_b412a3ab:

    # DIVINE @ happy "It's best not to dwell on such things; we're an uncomfortable blot they've had to learn to accept and tolerate {i}on their terms.{/i}"
    DIVINE @ happy "そんなことは考え込まない方がいい。私たちは厄介な存在で、彼らが受け入れ、寛容にならざるを得ない――{i}彼らなりの条件付きで。{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:117
translate ja primer_girl_troubles_2_menu_3_7a2d28cb:

    # DIVINE @ talk "They prefer the fantasy of us as saint like beings, not real people with real wants and desires."
    DIVINE @ talk "彼らは、我々を聖人のような存在という幻想を好むのであって、現実の欲求や欲望を持つ人間としては好まない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:120
translate ja primer_girl_troubles_2_menu_3_6d652bd9:

    # DIVINE @ talk "Yes, to which I expect you to speak to no one."
    DIVINE @ talk "はい、そのことについては誰にも話さないでくれることを期待している。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:121
translate ja primer_girl_troubles_2_menu_3_198ed38b:

    # DIVINE @ talk "I cannot stress how important these families expect privacy."
    DIVINE @ talk "これらの家系がどれほどプライバシーを求めているか、強調してもしきれないほどです。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:122
translate ja primer_girl_troubles_2_menu_3_1cf3949f:

    # DIVINE @ talk "If they believe we're making a spectacle, those {i}generous donations{/i} will very quickly dry up."
    DIVINE @ talk "彼らが私たちを見せ物にしていると思えば、その{i}寛大な寄付{/i}はたちまち枯れてしまうだろう。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:125
translate ja primer_girl_troubles_2_menu_3_186c3225:

    # DIVINE @ happy "Good, it pleases me to hear that."
    DIVINE @ happy "よろしい、それを聞いて満足だ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:126
translate ja primer_girl_troubles_2_menu_3_c4dc71ec:

    # MC @ talk "So what now?"
    MC @ talk "それで？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:127
translate ja primer_girl_troubles_2_menu_3_1f4f778f:

    # DIVINE @ talk "Now you've agreed, I can talk more about the girls in question."
    DIVINE @ talk "さて、了解済みなら、当の女の子たちについて詳しく話せる。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:128
translate ja primer_girl_troubles_2_menu_3_edbe2a65:

    # DIVINE @ talk "There's Jana, Zara and Mika."
    DIVINE @ talk "ヤナとザラとミカがいます。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:129
translate ja primer_girl_troubles_2_menu_3_a7336069:

    # DIVINE @ talk "Which one do you want to know about?"
    DIVINE @ talk "どれについて知りたい？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:133
translate ja primer_girl_troubles_2_menu_4_c8c3f0f1:

    # DIVINE @ talk "Ah, Jana Rosenval..."
    DIVINE @ talk "ああ、ヤナ・ローゼンバル…"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:134
translate ja primer_girl_troubles_2_menu_4_c2684d19:

    # DIVINE @ talk "Her abilities are extremely promising, and she is one of the highest potential candidates I've seen in years."
    DIVINE @ talk "彼女の能力は極めて有望で、ここ数年で見た中でも最高の素質を持つ候補の一人です。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:135
translate ja primer_girl_troubles_2_menu_4_53984bd0:

    # MC @ talk "Then what's the issue?"
    MC @ talk "じゃあ、何が問題なの？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:136
translate ja primer_girl_troubles_2_menu_4_6461bc7c:

    # DIVINE @ angry "Her attitude."
    DIVINE @ angry "彼女の態度。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:137
translate ja primer_girl_troubles_2_menu_4_0751d562:

    # DIVINE @ angry "She's been consistently troublesome for as long as I've known her, but the situation this last year has spiraled completely out of hand."
    DIVINE @ angry "彼女は知り合ってからずっと面倒な存在だったが、ところがここ一年、事態は完全に手に負えなくなっている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:138
translate ja primer_girl_troubles_2_menu_4_587a4d08:

    # MC @ talk "How {i}'out of hand?'{/i}"
    MC @ talk "どういうこと{i}？{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:139
translate ja primer_girl_troubles_2_menu_4_d7b30e0f:

    # DIVINE @ talk "Setting a lecture hall on fire, sneaking out and being caught dancing topless at a tavern, constantly getting it brawls with the other girls... The list goes on."
    DIVINE @ talk "講堂に火を放つ、忍び出ては酒場で上半身裸で踊っているところを捕まる、女子たちと喧嘩ばかり…悪事の限りを尽くした。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:140
translate ja primer_girl_troubles_2_menu_4_4890c460:

    # MC @ talk "Any idea what's causing the trouble?"
    MC @ talk "何か心当たりは？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:141
translate ja primer_girl_troubles_2_menu_4_3d603c8c:

    # DIVINE @ talk "She does come from a particularly {i}'troubled'{/i} home, and it's always been a difficult subject for her to talk about."
    DIVINE @ talk "彼女は確かに特に{i}問題のある{/i}家庭の出身で、そのことについてはいつも話したがらない難しい話題なのです。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:142
translate ja primer_girl_troubles_2_menu_4_fe36ef6d:

    # MC @ talk "How troubled?"
    MC @ talk "どれほど悩んだのか？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:143
translate ja primer_girl_troubles_2_menu_4_08cdecc7:

    # DIVINE @ talk "There were signs of physical abuse, but she's never been willing to talk about it."
    DIVINE @ talk "暴力の痕跡はあったが、彼女はそれについて語ろうとしない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:144
translate ja primer_girl_troubles_2_menu_4_d0271e56:

    # DIVINE @ talk "I need you to help curb her personality issues and deal with whatever's going on in her head."
    DIVINE @ talk "彼女の性格の問題を抑え、頭の中にあるものを処理するのを手伝ってほしい。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:149
translate ja primer_girl_troubles_2_menu_4_5087813e:

    # DIVINE @ talk "Hm, yes, Zara Dawnmoore."
    DIVINE @ talk "ふむ、そうです、ザラ・ドーンムーア。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:150
translate ja primer_girl_troubles_2_menu_4_15776ea7:

    # DIVINE @ talk "She comes from a wealthy aristocratic family from the south before the war forced them to flee North."
    DIVINE @ talk "戦争が彼らを北へと逃避させる前、彼女は南方の裕福な貴族の家系の出身だった。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:151
translate ja primer_girl_troubles_2_menu_4_f90c3862:

    # DIVINE @ talk "She was a perfect student during her time here, consistently scoring highest on her arcane knowledge and abilities."
    DIVINE @ talk "彼女は在学中、模範的な生徒であり、常に魔術の知識と能力で最高得点を収めていた。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:152
translate ja primer_girl_troubles_2_menu_4_8e5d193b:

    # DIVINE @ talk "Then, during the terminus ceremony, the {i}'incident'{/i} occurred."
    DIVINE @ talk "それから、結末の儀式の最中に、{i}'事件'{/i}は起こった。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:153
translate ja primer_girl_troubles_2_menu_4_caee25ea:

    # MC @ think "The 'incident?'"
    MC @ think "その「事件」？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:154
translate ja primer_girl_troubles_2_menu_4_7a8a5198:

    # DIVINE @ talk "Before the ceremony, Zara was reported to be in high spirits, if a little tense and on edge."
    DIVINE @ talk "儀式の前、ザラは少々緊張ぎみでピリピリしていたものの、上機嫌だったと伝えられている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:155
translate ja primer_girl_troubles_2_menu_4_601dc7e4:

    # DIVINE @ talk "But the same could be said of any of the mages at the time, so it was dismissed as the usual pre-ceremony anxiety."
    DIVINE @ talk "しかし当時の魔術師たちは皆そうだったので、これはいつもの儀式前の緊張として片づけられた。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:156
translate ja primer_girl_troubles_2_menu_4_7d354705:

    # DIVINE @ talk "A short while after the ceremony, however, Zara received a letter from her parents, who couldn't attend."
    DIVINE @ talk "しかし、式が終わって間もなく、ザラは出席できなかった両親から手紙を受け取った。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:157
translate ja primer_girl_troubles_2_menu_4_305b4b7a:

    # DIVINE @ talk "She burned the letter before anyone could read it, but whatever was in that letter triggered something within her."
    DIVINE @ talk "彼女は誰にも読まれる前に手紙を焼いたが、その中身は彼女の中で何かを引き起こした。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:158
translate ja primer_girl_troubles_2_menu_4_11d29735:

    # DIVINE @ talk "In the night, she went on a rampage, attacking everyone in sight."
    DIVINE @ talk "夜の闇に、彼女は暴れ狂い、手当たり次第に襲った。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:159
translate ja primer_girl_troubles_2_menu_4_91d2d69a:

    # DIVINE @ talk "It took myself and two other high mages to restrain her abilities, and in the meanwhile, over a dozen students were hurt."
    DIVINE @ talk "私を含む三人の高位魔導師がかりで、彼女の能力を抑制するのに手を貸したが、その間に十数名の生徒が傷ついた。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:160
translate ja primer_girl_troubles_2_menu_4_a4d6ed27:

    # DIVINE @ talk "We thought it might have been {i}'Mages madness,'{/i} but there was no sign of it."
    DIVINE @ talk "それは『メイジズ・マッドネス』かと思いましたが、その痕跡はありませんでした。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:161
translate ja primer_girl_troubles_2_menu_4_cffae37d:

    # MC @ talk "What was in the letter?"
    MC @ talk "手紙には何が書いてあったの？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:162
translate ja primer_girl_troubles_2_menu_4_af9b8334:

    # DIVINE @ talk "We don't know, and Zara won't say."
    DIVINE @ talk "私たちにはわからない、ザラが口を閉ざしている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:163
translate ja primer_girl_troubles_2_menu_4_b98ef904:

    # DIVINE @ talk "Now Zara is pretending she had some momentary lapse of judgment and is acting her usual self again."
    DIVINE @ talk "今やザラは一瞬の判断ミスだったふりをして、いつもの自分に戻っているふりをしている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:164
translate ja primer_girl_troubles_2_menu_4_42755e18:

    # DIVINE @ talk "I'm not going to risk sending her out knowing she could explode at any moment."
    DIVINE @ talk "いつ爆発するかわからない彼女を、危険を冒して送り出すわけにはいかない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:165
translate ja primer_girl_troubles_2_menu_4_3b071047:

    # MC @ talk "I don't remember hearing about this incident anywhere?"
    MC @ talk "この事件については、どこでも聞いた覚えがない？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:166
translate ja primer_girl_troubles_2_menu_4_9d1d538f:

    # DIVINE @ talk "That's because we've buried it and managed the incident in-house ... For now, at least."
    DIVINE @ talk "それは我々がそれを内々に葬り、インシデントを処理したからだ…今のところはな。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:167
translate ja primer_girl_troubles_2_menu_4_c4225b75:

    # DIVINE @ talk "I need you to get to the bottom of this issue and deal with it ... fast."
    DIVINE @ talk "この件の真相を突き止めて、迅速に対処してくれ…急いで。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:172
translate ja primer_girl_troubles_2_menu_4_1469252a:

    # DIVINE @ talk "Yes, Mika Ursan, a lovely girl."
    DIVINE @ talk "はい、ミカ・ウルサン、素敵な少女。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:173
translate ja primer_girl_troubles_2_menu_4_a993509d:

    # DIVINE @ talk "Afraid of her own shadow, but lovely."
    DIVINE @ talk "自分の影におびえるほど臆病で、かわいらしい。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:174
translate ja primer_girl_troubles_2_menu_4_6e2f9ef2:

    # MC @ talk "{i}Afraid of her own shadow?{/i}"
    MC @ talk "{i}自分の影にも怯える？{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:175
translate ja primer_girl_troubles_2_menu_4_dd45cd20:

    # DIVINE @ laugh "I know, I know, but believe me—she panics at the sight of a sparring partner."
    DIVINE @ laugh "分かってる、分かってるよ、でも本当なんだ——彼女は対戦相手を見るだけでパニックになるんだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:176
translate ja primer_girl_troubles_2_menu_4_c2e8c608:

    # DIVINE @ talk "Mika's an odd case; her family adore her and refused to hand her over till much, {i}much{/i} later than we usually take on mages."
    DIVINE @ talk "ミカは特殊なケースで、家族がとても彼女を愛していて、普通なら魔術師を迎え入れる時期よりずっと遅くて、{i}はるかに{/i}遅くなるまで引き渡そうとしなかったのです。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:177
translate ja primer_girl_troubles_2_menu_4_cf3cdd5f:

    # DIVINE @ talk "As such, she has a strong natural sense of her abilities despite displaying very average arcane knowledge."
    DIVINE @ talk "そのため、彼女は非常に平均的な魔術知識しか示さないにもかかわらず、天性の能力感覚に優れている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:178
translate ja primer_girl_troubles_2_menu_4_11d4c714:

    # MC @ talk "So, what's the issue?"
    MC @ talk "で、問題は何？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:179
translate ja primer_girl_troubles_2_menu_4_138e55c7:

    # DIVINE @ talk "{i}The girl is terrified of fighting...{/i}"
    DIVINE @ talk "{i}少女は戦うことに怯えている...{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:180
translate ja primer_girl_troubles_2_menu_4_154fbaad:

    # DIVINE @ talk "She completely failed in any and all practical combat training classes previously."
    DIVINE @ talk "以前は実戦訓練の授業ではまったく駄目だった。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:181
translate ja primer_girl_troubles_2_menu_4_bd85b2d5:

    # DIVINE @ talk "She just ... cowered."
    DIVINE @ talk "彼女はただ…縮こまった。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:182
translate ja primer_girl_troubles_2_menu_4_9c43d061:

    # MC @ talk "Then how has she got this far?"
    MC @ talk "それじゃ、どうやって彼女はここまで来たんだ？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:183
translate ja primer_girl_troubles_2_menu_4_5bcd82c2:

    # DIVINE @ talk "Because practical combat for mages of the Palam is the one thing you {i}can{/i} still fail at and still be allowed to serve in the rear as a healer."
    DIVINE @ talk "パラムの魔術師にとって実戦とは、{i}それこそ{/i}失敗しても、癒し手として後方支援として認められる唯一のものであるからだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:184
translate ja primer_girl_troubles_2_menu_4_6272c3d1:

    # DIVINE @ angry "Suffice it to say this push to get mages to the front in quantity rather than quality has been a great source of tension between the council of Mages and the Alderian government."
    DIVINE @ angry "要するに、質より量を重視して魔道士を前線へと投入しようとするこの動きは、魔道士評議会とアルデリア政府との間の緊張関係の主な要因となっている。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:185
translate ja primer_girl_troubles_2_menu_4_86ac58e5:

    # DIVINE @ talk "Now, whilst combat isn't the priority for a mage of Palam, {i}I firmly believe every mage must be able to defend herself in times of crisis.{/i}"
    DIVINE @ talk "さて、戦闘がパラムの魔術師の最優先事項ではないとはいえ、{i}私はいざという時にはどんな魔術師も自らを守れる術を身につけるべきだと確信している。{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:186
translate ja primer_girl_troubles_2_menu_4_99e3957b:

    # "Sister Divine's face fell darkly."
    "妹・ディバインの表情が、陰った。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:187
translate ja primer_girl_troubles_2_menu_4_a90549ec:

    # DIVINE @ sad "If the recent deaths are anything to go by ... I've only been proven right."
    DIVINE @ sad "最近の死が何かを物語るとすれば…私の正しかったことだけが証明されたのだ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:188
translate ja primer_girl_troubles_2_menu_4_8ab36be3:

    # MC @ think "So, you want me to train the girl to fight?"
    MC @ think "では、その娘を戦えるように躾けろというわけか？"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:189
translate ja primer_girl_troubles_2_menu_4_bd65f2f7:

    # DIVINE @ talk "I need you to teach her to conquer her fears."
    DIVINE @ talk "彼女に恐怖を克服することを教えてほしい。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:190
translate ja primer_girl_troubles_2_menu_4_d6ca7303:

    # DIVINE @ talk "She {i}has{/i} to be able to fight if the time comes."
    DIVINE @ talk "彼女は、時が来れば戦え{i}なければならない{/i}。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:191
translate ja primer_girl_troubles_2_menu_4_3a9c4c09:

    # MC @ talk "And if she refuses to listen? She's an adult now; she doesn't have to listen to either of us."
    MC @ talk "では、もし彼女が聞くのを拒んだら？
彼女はもう大人だ。どちらかの言うことを聞く必要はない。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:192
translate ja primer_girl_troubles_2_menu_4_88df11d8:

    # DIVINE @ talk "I don't care {i}how{/i} you get her to agree, but I need to know she can handle herself out there."
    DIVINE @ talk "どうやって彼女に{i}同意させるにせよ{/i}、あの子が一人でやっていけるか確かめてくれ。"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:199
