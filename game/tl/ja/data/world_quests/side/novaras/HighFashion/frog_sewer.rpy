    new "{image=[ICON.HEART]} そう言われると… ({b}警告：FUTAな内容含む!{/b})"




    # game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:144
    old "You can now enter the Palam Tower at night."
    new "夜にパラムタワーに入ることができるようになりました。"




