# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:788
translate ja qsttheslavemaster_meeting_last_question_74a2936a:

    # ANGHARAD @ smile "Oh, she is a feisty one, isn't she?"
    ANGHARAD @ smile "元気がいい子だね。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:789
translate ja qsttheslavemaster_meeting_last_question_11ca0c5b:

    # ANGHARAD @ smile "No wonder this one is your favourite."
    ANGHARAD @ smile "これがお気に入りなわけだ。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:790
translate ja qsttheslavemaster_meeting_last_question_29531788:

    # NYX @ blush "(This is ... so {i}humiliating.{/i})"
    NYX @ blush "(これって…すごく{i}屈辱的{/i})"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:791
translate ja qsttheslavemaster_meeting_last_question_a458d1ed:

    # NYX @ blush "(I'm the Captain of the Alderian Guard for Novaras! A decorated knight of the Emperor!)"
    NYX @ blush "(わたくしがノヴァラス近衛騎士団団長!皇帝陛下直々に叙勲された騎士でございます!)"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:792
translate ja qsttheslavemaster_meeting_last_question_7569176e:

    # NYX @ blush "(N-Not some ... some common whore!)"
    NYX @ blush "(の、の、の、安売り女なんかじゃ…なんかじゃないわ!)"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:795
translate ja qsttheslavemaster_meeting_last_question_a9c4478a:

    # MC @ talk "Angharad ..."
    MC @ talk "アンハラド……"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:796
translate ja qsttheslavemaster_meeting_last_question_fedc8d23:

    # MC @ serious "Let us talk business, no more games."
    MC @ serious "商談を始めよう、ごまかしはもういい。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:798
translate ja qsttheslavemaster_meeting_last_question_1c9c8be3:

    # ANGHARAD @ talk "{i}*Sigh*{/i} You really do need to learn to relax more, friend."
    ANGHARAD @ talk "{i}はあ…{/i} 君はもっとリラックスすることを学ぶ必要があるよ、友人よ。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:799
translate ja qsttheslavemaster_meeting_last_question_8c39ee61:

    # ANGHARAD @ talk "Very well, let's start with numbers, I have at least fifty of the finest girls to spare."
    ANGHARAD @ talk "宜しい、ではまずは数からだ、最も優れた娘たちなら五十人は余裕でいる。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:800
translate ja qsttheslavemaster_meeting_last_question_15e1ec99:

    # ANGHARAD @ talk "Ten Alderians, Thirty Ramonians and ten elves."
    ANGHARAD @ talk "十人のアルデリア人、三十人のラモニア人と十人のエルフ。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:801
translate ja qsttheslavemaster_meeting_last_question_a26dd8f9:

    # ANGHARAD @ talk "I can have them brought in through Hamun by next month, and transported anywhere in Novaras."
    ANGHARAD @ talk "来月までにハムン経由で手配し、ノヴァラス内のどこへでも輸送できます。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:802
translate ja qsttheslavemaster_meeting_last_question_9f30d4c1:

    # ANGHARAD @ talk "How many do your private {i}clients{/i} need?"
    ANGHARAD @ talk "あなたの個人の{i}クライアント{/i}は何名必要でしょうか。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:803
translate ja qsttheslavemaster_meeting_last_question_63907af0:

    # MC @ serious "How much for all of them?"
    MC @ serious "全部でいくらですか？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:805
translate ja qsttheslavemaster_meeting_last_question_9d3037fe:

    # ANGHARAD @ smile "{i}All of them?{/i}"
    ANGHARAD @ smile "{i}すべて？{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:806
translate ja qsttheslavemaster_meeting_last_question_825a3f31:

    # "Angharad chuckled,"
    "アンハラッドはくすくす笑った。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:807
translate ja qsttheslavemaster_meeting_last_question_9d599eeb:

    # ANGHARAD @ smile "Allow me to check some numbers."
    ANGHARAD @ smile "いくつかの数字を確認させてください。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:808
translate ja qsttheslavemaster_meeting_last_question_e9895655:

    # MC @ talk "Before you do that ..."
    MC @ talk "それをする前に…"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:810
translate ja qsttheslavemaster_meeting_last_question_be00f98b:

    # MC @ serious "How do {i}I{/i} know I'm speaking to the {i}real{/i} Angharad?"
    MC @ serious "どうやって《私》が《本物》のアンガラッドと話しているとわかるの？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:812
translate ja qsttheslavemaster_meeting_last_question_390606ce:

    # ANGHARAD @ furious "Are you calling me a liar?"
    ANGHARAD @ furious "嘘つき呼ばわりですか？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:813
translate ja qsttheslavemaster_meeting_last_question_c2e9792b:

    # MC @ serious "I've done everything to jump through your hoops to prove I am who I say I am, yet if I am to spend this much coin, I too would like some reassurance."
    MC @ serious "これだけあなたの要求する手続きを踏んで、自分が申し上げた通りの人物であることを証明したのに、もしこれほどの金を使うのであれば、私としても何らかの保証が欲しいのです。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:815
translate ja qsttheslavemaster_meeting_last_question_6f3afd9c:

    # ANGHARAD @ talk "{i}*Sigh*{/i} Very well."
    ANGHARAD @ talk "{i}*ため息*{/i} よろしい。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:816
translate ja qsttheslavemaster_meeting_last_question_f8d06e2a:

    # "Angharad for a moment headed over towards a small chest and produced from it what seemed to be an inscribed amulet, which he tossed towards me."
    "アンハラドは一瞬、小さな箱の方へ向かい、そこから刻印の護符と思しきものを取り出すと、彼はそれを私の方へ投げた。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:817
translate ja qsttheslavemaster_meeting_last_question_4e8c2d63:

    # "The thing was clunky and heavy, with a small green jewel in the middle and Ramonian written around it followed by 'Angharad XXII"
    "その物体は、どっしりと重く、中央には小さな緑色の宝石がはめ込まれ、その周りにはラモニア語の刻印、そして『アンガラッドXXII』と記されていた。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:818
translate ja qsttheslavemaster_meeting_last_question_5569b731:

    # ANGHARAD @ talk "My slave number."
    ANGHARAD @ talk "私の奴隷番号。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:819
translate ja qsttheslavemaster_meeting_last_question_8c54c8da:

    # "I stared down at the amulet, and then back at Angharad in disbelief."
    "護符を見下ろし、そしてアンガラドを疑うように見つめ返した。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:821
translate ja qsttheslavemaster_meeting_last_question_7c9b9408:

    # MC @ surprised "{i}You were a slave?{/i}"
    MC @ surprised "{i}あなたは奴隷だったの？{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:822
translate ja qsttheslavemaster_meeting_last_question_ecf760fb:

    # ANGHARAD @ smile "Of course."
    ANGHARAD @ smile "もちろん。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:823
translate ja qsttheslavemaster_meeting_last_question_ff164ff8:

    # ANGHARAD @ smile "After proving my value to my master long enough, he came to trust me more and more."
    ANGHARAD @ smile "十分に長い間、主に自分の価値を示し続けた結果、彼は私をますます信頼するようになった。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:824
translate ja qsttheslavemaster_meeting_last_question_b8b9cf6b:

    # ANGHARAD @ talk "And when his guard was down ... I slit his throat, and took everything he had."
    ANGHARAD @ talk "そして、彼が隙を突かれた時…私は彼の喉を掻き切り、持ち物を全て奪った。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:827
translate ja qsttheslavemaster_meeting_last_question_90530c4e:

    # ANGHARAD @ talk "Why should I have?"
    ANGHARAD @ talk "どうしてそうすべきなの？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:828
translate ja qsttheslavemaster_meeting_last_question_9c4849c6:

    # MC @ sad "It's just, you must have felt {i}something{/i} for them?"
    MC @ sad "ただ、あなたは彼らに{i}何かを感じた{/i}はずでしょう？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:829
translate ja qsttheslavemaster_meeting_last_question_64212fe1:

    # ANGHARAD @ talk "... You're an odd slaver, aren't you?"
    ANGHARAD @ talk "…奇妙な奴隷商人ですね、あなた。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:830
translate ja qsttheslavemaster_meeting_last_question_9484688e:

    # ANGHARAD @ talk "No, I did not."
    ANGHARAD @ talk "いいえ、違います。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:831
translate ja qsttheslavemaster_meeting_last_question_6f879915:

    # ANGHARAD @ talk "Had it not been me, someone else would have done the same given the opportunity."
    ANGHARAD @ talk "私でなくても、機会さえあれば誰かが同じことをしただろう。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:832
translate ja qsttheslavemaster_meeting_last_question_01412b0b:

    # ANGHARAD @ talk "Only people who have always had coin speak of luxuries like {i}righteousness.{/i}"
    ANGHARAD @ talk "金銭に恵まれた者だけが、{i}正義{/i}のような贅沢を語るのだ。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:833
translate ja qsttheslavemaster_meeting_last_question_6e83d0c4:

    # ANGHARAD @ talk "The starving man? The slave? The man with nothing to lose?"
    ANGHARAD @ talk "飢えた男？
奴隷？
失うものなどない男？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:834
translate ja qsttheslavemaster_meeting_last_question_a1203cd6:

    # ANGHARAD @ talk "He won't question whether something is good or evil when he drags the blade across your throat for just a few coins."
    ANGHARAD @ talk "彼はほんのわずかな金のために、刃をあなたの喉に押し当てる時、それが善か悪かなど問うことはしない。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:835
translate ja qsttheslavemaster_meeting_last_question_b800a674:

    # "As I opened my mouth to say something, Captain Nyx suddenly tugged at my arm to intercede."
    "何か言おうと口を開けた瞬間、ニクス艦長が突然私の腕を引っ張って遮った。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:838
translate ja qsttheslavemaster_meeting_last_question_4c229a61:

    # ANGHARAD @ smile "Of course you can."
    ANGHARAD @ smile "もちろん、できます。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:839
translate ja qsttheslavemaster_meeting_last_question_0d17cd35:

    # ANGHARAD @ talk "You and I understand this world was not for us, our kind were never meant to climb the great ladder."
    ANGHARAD @ talk "我らは理解している。この世界が我々の為のものではなかったことを、我々のような者は大いなる階段を登る運命などなかったのだ。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:840
translate ja qsttheslavemaster_meeting_last_question_19fd675a:

    # ANGHARAD @ talk "If we want to find happiness, it will come at the expense of everyone else."
    ANGHARAD @ talk "幸せを求めるなら、それは他のすべての人を犠牲にして得られるものだ。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:841
translate ja qsttheslavemaster_meeting_last_question_4b0c08c9:

    # "Captain Nyx stepping towards me from behind tugged at my arm."
    "キャプテン・ニックスが背後から歩み寄って、私の腕を引っ張った。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:845
translate ja qsttheslavemaster_meeting_last_question_6bdee803:

    # NYX @ talk "Master? Should I fetch us all some wine?"
    NYX @ talk "ご主人様？私たちにワインを持ってきましょうか？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:846
translate ja qsttheslavemaster_meeting_last_question_becb58c9:

    # "Nyx gripped my arm tightly and I could see from her eyes she was giving me the signal that we had the proof she needed."
    "ニックスが私の腕を強く握りしめ、彼女の目から、必要な証拠を手に入れたという合図を送っているのが分かった。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:847
translate ja qsttheslavemaster_meeting_last_question_65299ba2:

    # MC @ talk "Yes, fetch us some wine."
    MC @ talk "はい、私たちにワインを取ってきてください。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:852
translate ja qsttheslavemaster_meeting_last_question_d9cece43:

    # "Captain Nyx hurried off to go pour some wine for us."
    "Nyx船長は、私たちにワインを注ぎに急いで行ってしまった。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:854
translate ja qsttheslavemaster_meeting_last_question_a0cc1001:

    # ANGHARAD @ smile "... So, do you love your slave?"
    ANGHARAD @ smile "……それで、あなたの奴隷を愛してる？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:855
translate ja qsttheslavemaster_meeting_last_question_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "何？"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:856
translate ja qsttheslavemaster_meeting_last_question_326a780f:

    # ANGHARAD @ smile "You'd hardly be the first."
    ANGHARAD @ smile "あなたが初めてってわけじゃないでしょう"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:857
translate ja qsttheslavemaster_meeting_last_question_b4487286:

    # ANGHARAD @ smile "And the way you two look at each other, well, even the blind could see that."
    ANGHARAD @ smile "二人の見つめ合い方、もう、盲でも分かるよ。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:861
translate ja qsttheslavemaster_meeting_last_question_4ad75aab:

    # "Captain Nyx, after making her way around the room handing each of the guards a cup, she gave Angharad one which he gulped down quickly and threw aside, before finally approaching me with the final cup."
    "キャプテン・ニックスは、部屋の中を一巡りして衛兵たちそれぞれに杯を渡した後、アンガラッドにも一杯を渡し、彼はそれを一気に飲み干して投げ捨てた。そして最後の一杯を持って、ついに私に近づいてきた。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:862
translate ja qsttheslavemaster_meeting_last_question_6c2d69f9:

    # NYX @ talk "Master~"
    NYX @ talk "ご主人様～"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:863
translate ja qsttheslavemaster_meeting_last_question_d2594cc3:

    # "Nyx lightly nodded to signal to me as I took the cup, and with one sniff, I could tell from the potency of the drug she had placed inside of it, that it wouldn't take long to kick in."
    "ニクスが軽くうなずいて合図を送り、カップを受け取った俺は、ひと嗅ぎでわかった。彼女が中に入れた薬の強さから、すぐに効き始めるだろう。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:864
translate ja qsttheslavemaster_meeting_last_question_fc146197:

    # "I pretended to sip at my drink to not arouse suspicion before placing it down back onto the tray."
    "疑念を抱かれぬよう、一口だけ飲んだふりをしてから、グラスをトレイの上に置き戻した。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:865
translate ja qsttheslavemaster_meeting_last_question_2a14326b:

    # MC @ talk "Thank you, Lyesha."
    MC @ talk "ありがとう、リェーシャ。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:866
translate ja qsttheslavemaster_meeting_last_question_ba564e34:

    # "After a few minutes of small talk and laughing amongst the men now they had relaxed in my pressence, Angharad finally interjected,"
    "男たちが私の前でくつろぎ、数分間の雑談と笑いを交わした後、ようやくアンガラッドが割って入ってきた。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:867
translate ja qsttheslavemaster_meeting_last_question_f75fda92:

    # ANGHARAD @ smile "Now then, what's say we-"
    ANGHARAD @ smile "さて、どうしましょうか―"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:868
translate ja qsttheslavemaster_meeting_last_question_ec8caf4d:

    # "One of the Khazah guards suddenly collapsed onto the floor, the others turned to look in panic, reaching for their blades as one by one they fell to the floor."
    "カザーの護衛の一人が突然床に倒れ込むと、他の者たちが慌てて振り返り、剣に手をかけたが、次々と床に倒れていった。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:870
translate ja qsttheslavemaster_meeting_last_question_e29223b1:

    # ANGHARAD @ furious "WHAT THE FUCK IS THIS?!"
    ANGHARAD @ furious "なんなんだ、これ？!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:871
translate ja qsttheslavemaster_meeting_last_question_fa9046a3:

    # "Captain Nyx pulled out the small stone that she crushed in her hand, and as she did so, it cracked and glowed red."
    "キャプテン・ニックスは、手の中で握り潰した小さな石を取り出すと、それと共に石は割れ、赤く輝いた。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:872
translate ja qsttheslavemaster_meeting_last_question_284926aa:

    # "Moments later, the place was rushed by dozens of the city's guards, spears pointed and ready."
    "直後、その場には数十名の市の衛兵が駆けつけ、槍を構えて待機していた。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:873
translate ja qsttheslavemaster_meeting_last_question_f35119b7:

    # ANGHARAD @ furious "YOU SON OF A-"
    ANGHARAD @ furious "この野郎っ!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:874
translate ja qsttheslavemaster_meeting_last_question_107db710:

    # "Angharad himself tried to reach to grab his blade, gripping the handle as he fumbled and crashed his way into the pieces of furniture deliriously."
    "アンガラド自身、狂ったように家具の破片の中をもがきながら倒れ込むうちに、何とか柄を握り、刀に手を伸ばそうとした。"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:875
translate ja qsttheslavemaster_meeting_last_question_312c1f1c:

    # ANGHARAD @ furious "I'll ... kill ..."
    ANGHARAD @ furious "私…は…殺す…"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:876
translate ja qsttheslavemaster_meeting_last_question_63273423:

    # "Just as Angharad managed to unsheathe his blade, he too collapsed onto the floor with the others, fast asleep."
    "ちょうどアンガラッドが何とか剣を抜きおおせた瞬間、彼もまた他の者と同様に床に倒れ伏し、あっという間に眠りに落ちた。"

