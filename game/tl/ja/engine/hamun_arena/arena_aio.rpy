# game/engine/hamun_arena/arena_aio.rpy:157
translate ja hamun_arena_master_talk_first_time_b3a82bdf:

    # "The figure slid over some paperwork with an inked quill."
    "その人物は、インク付きの羽根ペンで書類の上を滑らせた。"

# game/engine/hamun_arena/arena_aio.rpy:158
translate ja hamun_arena_master_talk_first_time_c1906bc5:

