translate kr dialogue_arwen_othergirls_d6300ee5:

    # ARWEN @ talk "Tell me darling, who in all of Mirnos would you want to talk about them... when {i}I'm{/i} by your side?"
    ARWEN @ talk "말해봐요 자기, 모든 미르노스에서 누구에 대해 이야기하고 싶겠어요... {i}제가{/i} 곁에 있는데도?"

# game/data/characters/arwen/scr_dialogue.rpy:5
translate kr dialogue_arwen_othergirls_menu_bbb61fd6:

    # ARWEN @ blush "Gods... I bet you have half the women in this city wrapped around your finger, don't you handsome?"
    ARWEN @ blush "세상에... 이 도시 여성 절반은 당신 손바닥 안에 있겠네요, 그렇죠 미남 씨?"

# game/data/characters/arwen/scr_dialogue.rpy:6
translate kr dialogue_arwen_othergirls_menu_e8995dc3:

    # MC @ smile "{i}Would you like to be wrapped around my finger, Arwen?{/i}"
    MC @ smile "{i}너도 내 손바닥 안에 있고 싶어, 아르웬?{/i}"

# game/data/characters/arwen/scr_dialogue.rpy:7
translate kr dialogue_arwen_othergirls_menu_7bca3054:

    # ARWEN @ laugh "Haha! Alright..."
    ARWEN @ laugh "하하! 좋아요..."

# game/data/characters/arwen/scr_dialogue.rpy:8
translate kr dialogue_arwen_othergirls_menu_bcc3804b:

    # ARWEN @ talk "What do you want to know?"
    ARWEN @ talk "뭘 알고 싶으세요?"

# game/data/characters/arwen/scr_dialogue.rpy:11
translate kr dialogue_arwen_othergirls_menu_f72c231a:

    # ARWEN @ talk "Well... Now you're speaking a girls favourite language!"
    ARWEN @ talk "와... 이제야 여자들이 가장 좋아하는 언어로 말하시네요!"

# game/data/characters/arwen/scr_dialogue.rpy:13
translate kr dialogue_arwen_othergirls_menu_ab602309:

    # ARWEN @ talk "Was there someone specific you wanted to ask about?"
    ARWEN @ talk "특별히 물어보고 싶은 사람이라도 있었나요?"

# game/data/characters/arwen/scr_dialogue.rpy:16
translate kr dialogue_arwen_othergirls_menu_paid_5c4b33c4:

    # ARWEN @ angry "Hm? Oh, {i}her{/i} I'd avoid her if I was you."
    ARWEN @ angry "음? 아, {i}그 여자{/i} 나 같으면 피할 거야."

# game/data/characters/arwen/scr_dialogue.rpy:17
translate kr dialogue_arwen_othergirls_menu_paid_d42b7565:

    # ARWEN @ angry "Overpriced to put it mildly, you'd think she was a virgin princess with how highly she views herself."
    ARWEN @ angry "조금 순화해서 말하면 너무 비싸, 자기 자신을 얼마나 높게 보는지 순결한 공주님이라고 생각할 정도야."

# game/data/characters/arwen/scr_dialogue.rpy:18
translate kr dialogue_arwen_othergirls_menu_paid_1950d15a:

    # ARWEN @ blush "Don't worry though, I'll show you what a {i}real{/i} woman can do."
    ARWEN @ blush "하지만 걱정 마, {i}진짜{/i} 여자가 뭘 할 수 있는지 보여줄게."

# game/data/characters/arwen/scr_dialogue.rpy:21
translate kr dialogue_arwen_othergirls_menu_paid_77c1d01c:

    # ARWEN @ think "Hmm, nice enough girl."
    ARWEN @ think "흠, 꽤 괜찮은 애야."

# game/data/characters/arwen/scr_dialogue.rpy:22
translate kr dialogue_arwen_othergirls_menu_paid_879dd5c5:

    # ARWEN @ talk "But I think she's a little {i}too{/i} desperate to work in here."
    ARWEN @ talk "하지만 여기서 일하기엔 좀 {i}너무{/i} 필사적인 것 같아."

# game/data/characters/arwen/scr_dialogue.rpy:23
translate kr dialogue_arwen_othergirls_menu_paid_35cb4a19:

    # ARWEN @ talk "As far as I know, they let her stay and serve clients outside for a reduced rate, but I doubt she'll get through the door."
    ARWEN @ talk "내가 알기론, 할인된 요금으로 밖에서 손님을 받도록 내버려두고 있는데, 문 안으로 들어오긴 힘들 거야."

# game/data/characters/arwen/scr_dialogue.rpy:24
translate kr dialogue_arwen_othergirls_menu_paid_da22f4ce:

    # MC @ talk "Why's that?"
    MC @ talk "왜 그래?"

# game/data/characters/arwen/scr_dialogue.rpy:25
translate kr dialogue_arwen_othergirls_menu_paid_8e2a16c2:

    # ARWEN @ talk "Look around you, we're not the {i}Black Diamond,{/i} we general serve adventurers and merchants with coin to burn."
    ARWEN @ talk "주위를 둘러봐, 우린 {i}블랙 다이아몬드{/i}가 아니야, 주로 돈을 펑펑 쓰는 모험가와 상인들을 상대해."

# game/data/characters/arwen/scr_dialogue.rpy:26
translate kr dialogue_arwen_othergirls_menu_paid_e4fcf857:

    # ARWEN @ talk "And she's out there letting the city guard take put it in her ass behind a wall... Hardly a good fit."
    ARWEN @ talk "그런데 그녀는 밖에서 시 경비대원한테 벽 뒤에서 엉덩이로 들어오게 하고 있잖아... 좀 안 어울리지."

# game/data/characters/arwen/scr_dialogue.rpy:27
translate kr dialogue_arwen_othergirls_menu_paid_33eafac5:

    # MC @ talk "That seems rather harsh..."
    MC @ talk "그건 좀 심한 말 같은데..."

# game/data/characters/arwen/scr_dialogue.rpy:28
translate kr dialogue_arwen_othergirls_menu_paid_8c61c9e1:

    # ARWEN @ talk "It's just business darling... it's always cut-throat, no matter the trade."
    ARWEN @ talk "그냥 장사일 뿐이야 자기야... 무슨 업종이든 항상 치열한 법이니까."

# game/data/characters/arwen/scr_dialogue.rpy:31
translate kr dialogue_arwen_othergirls_menu_paid_480f5c90:

    # ARWEN @ talk "Alright then, was there something else?"
    ARWEN @ talk "좋아요, 또 다른 거 있나요?"

# game/data/characters/arwen/scr_dialogue.rpy:34
translate kr dialogue_arwen_othergirls_menu_paid_7417b5c7:

    # ARWEN @ talk "Alright then, let's hear it."
    ARWEN @ talk "좋아, 그럼 들어보자."

