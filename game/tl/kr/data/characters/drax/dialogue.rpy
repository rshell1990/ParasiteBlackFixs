translate kr drax_bronzeDeliverRepeat_f30b4de7:

    # DRAX "Come back after you've scavenged more bronze."
    DRAX "청동을 더 구해오면 다시 와."

# game/data/characters/drax/dialogue.rpy:96
translate kr drax_bronzeDeliverRepeat_5650b7ba:

    # DRAX "ARLENAAAAA!"
    DRAX "알레나아아아!"

# game/data/characters/drax/dialogue.rpy:97
translate kr drax_bronzeDeliverRepeat_0492f5f9:

    # DRAX "WE HAVE BRONZE!"
    DRAX "청동 왔다!"

# game/data/characters/drax/dialogue.rpy:99
translate kr drax_bronzeDeliverRepeat_ba0ec503:

    # "Arlena emerged once again with her arms folded."
    "알레나가 다시 팔짱을 낀 채 나타났다."

# game/data/characters/drax/dialogue.rpy:104
translate kr drax_bronzeDeliverRepeat_d11ff72d:

    # ARLENA "Not bad... Who knows? Maybe one day you'll be able to improve your personality like you've done your work ethic!"
    ARLENA "나쁘지 않네... 누가 알아? 언젠가 네가 일 태도를 개선한 것처럼 성격도 고칠 수 있을지!"

# game/data/characters/drax/dialogue.rpy:106
translate kr drax_bronzeDeliverRepeat_dfe83138:

    # ARLENA "Hmph... It's better than nothing I suppose. Don't be getting sloppy on us now!"
    ARLENA "흥... 없는 것보단 낫다고 봐야겠네. 이제 와서 대충 하지 말라고!"

# game/data/characters/drax/dialogue.rpy:108
translate kr drax_bronzeDeliverRepeat_b203b2ec:

    # ARLENA "I'm almost impressed!"
    ARLENA "거의 감동했어 거의!"

# game/data/characters/drax/dialogue.rpy:110
translate kr drax_bronzeDeliverRepeat_269c09d7:

    # ARLENA "Urgh... Just take your gold and get out of here, I'm in no mood for you today."
    ARLENA "으으... 그냥 돈이나 받고 나가, 오늘은 네 상대할 기분 아니야."

# game/data/characters/drax/dialogue.rpy:120
translate kr drax_shop_first_e2d8bf63:

    # DRAX "Of course."
    DRAX "물론이지."

# game/data/characters/drax/dialogue.rpy:121
translate kr drax_shop_first_697cf030:

    # DRAX "Take a peak and see if anything catches your eye..."
    DRAX "한번 둘러보고 맘에 드는 게 있나 봐..."

# game/data/characters/drax/dialogue.rpy:126
translate kr drax_shop_7918a933:

    # DRAX "Take a look."
    DRAX "둘러봐."

# game/data/characters/drax/dialogue.rpy:131
translate kr drax_questions_53c1e4f7:

    # DRAX "What do you want to know?"
    DRAX "뭘 알고 싶어?"

# game/data/characters/drax/dialogue.rpy:135
translate kr drax_qChanges_3056e47e:

    # DRAX "Not much to be honest, business carries on as usual here."
    DRAX "솔직히 별로, 여긴 평소처럼 장사가 돌아가고 있어."

# game/data/characters/drax/dialogue.rpy:136
translate kr drax_qChanges_90be5fd6:

    # DRAX "Usual petty neighbour drama shite, more Black Mages getting caught..."
    DRAX "평소의 시시한 이웃 드라마 같은 헛소리, 검은 마법사들이 더 잡히는 거..."

# game/data/characters/drax/dialogue.rpy:137
translate kr drax_qChanges_7d6bd86a:

    # DRAX "Biggest thing that’s happened for a while is you two coming home the way you did!"
    DRAX "한동안 가장 큰 일이라면 너희 둘이 그런 식으로 집에 돌아온 거!"

# game/data/characters/drax/dialogue.rpy:141
translate kr drax_qBooks_629545c6:

    # DRAX "If you figure that one out..."
    DRAX "그걸 알아낸다면..."

# game/data/characters/drax/dialogue.rpy:142
translate kr drax_qBooks_ddd935a1:

    # "Drax placed his hand on my shoulder as he smiled."
    "드랙스가 미소 지으며 내 어깨에 손을 올렸다."

# game/data/characters/drax/dialogue.rpy:143
translate kr drax_qBooks_27cb4f61:

    # DRAX "... Let me know!"
    DRAX "... 나도 알려줘!"

# game/data/characters/drax/dialogue.rpy:147
translate kr drax_qEnd_d0d69c30:

    # DRAX "What else do you need?"
    DRAX "또 뭐 필요해?"

# game/data/characters/drax/dialogue.rpy:151
translate kr drax_bye_987ddf0d:

    # DRAX "Come back anytime."
    DRAX "언제든 다시 와."

# game/data/characters/drax/dialogue.rpy:155
translate kr drax_craft_a1dec31f:

    # DRAX "Ah! You need something forged?"
    DRAX "어! 뭐 대장간에서 만들 거 필요해?"

# game/data/characters/drax/dialogue.rpy:160
translate kr drax_craft_00afb801:

    # DRAX "Anytime."
    DRAX "언제든."

# game/data/characters/drax/dialogue.rpy:164
translate kr drax_craft_b9b6a99a:

    # DRAX "I can smelt you just about any kind of armor and weapons you'd like, trouble is, it ain't just about the coin."
    DRAX "네가 원하는 거의 모든 종류의 갑옷과 무기를 만들어 줄 수 있어, 문제는, 돈만으로 되는 게 아니야."

# game/data/characters/drax/dialogue.rpy:165
translate kr drax_craft_78db8fb0:

    # DRAX "There's a shortage of raw materials coming in, and most of what {i}does{/i} come in goes to the war effort."
    DRAX "들어오는 원자재가 부족해서, 들어오는 것들의 대부분은 전쟁 물자로 가."

# game/data/characters/drax/dialogue.rpy:166
translate kr drax_craft_54c95bbc:

    # DRAX "If you want me to make you something, you may have to source the raw materials yourself..."
    DRAX "내가 뭔가 만들어주길 원하면, 원자재는 네가 직접 구해 와야 할 거야..."

# game/data/characters/drax/dialogue.rpy:170
translate kr drax_craft_8e531321:

    # DRAX "Very well then... Let me know if you need anything!"
    DRAX "좋아 그럼... 뭐 필요하면 말해!"

translate kr strings:

    # game/data/characters/drax/dialogue.rpy:2
    old "Drax needs bronze scraps"
    new "드랙스가 청동 조각을 필요로 한다"

    # game/data/characters/drax/dialogue.rpy:2
    old "A blacksmith of Novaras will take any bronze scraps I might scavenge in exchange for gold. He is only interested in batches of five, for whatever reason."
    new "노바라스의 대장장이는 내가 주워온 청동 조각을 금으로 바꿔준다. 무슨 이유에서인지 한 번에 다섯 개씩만 받는다."

    # game/data/characters/drax/dialogue.rpy:63
    old "Here is some more bronze you wanted."
    new "네가 원하던 청동을 더 가져왔어."

    # game/data/characters/drax/dialogue.rpy:66
    old "Can I see your wares?"
    new "물건을 좀 볼 수 있을까?"

    # game/data/characters/drax/dialogue.rpy:70
    old "I wanted to talk to you about crafting something for me."
    new "뭔가 만들어 달라고 부탁하려고 했는데."

    # game/data/characters/drax/dialogue.rpy:71
    old "I have a few questions..."
    new "질문이 몇 개 있는데..."

    # game/data/characters/drax/dialogue.rpy:75
    old "Has much changed since I left?"
    new "내가 떠난 후로 많이 바뀌었나?"

    # game/data/characters/drax/dialogue.rpy:76
    old "Any ideas on getting into Arlena’s good books?"
    new "알레나의 환심을 살 방법이 있을까?"

    # game/data/characters/drax/dialogue.rpy:77
    old "That’s all for now."
    new "오늘은 이걸로 됐어."

    # game/data/characters/drax/dialogue.rpy:157
    old "Yes, there's something I'd like you to make for me..."
    new "응, 만들어줬으면 하는 게 있어..."

    # game/data/characters/drax/dialogue.rpy:163
    old "Could you explain it to me?"
    new "설명해줄 수 있어?"

    # game/data/characters/drax/dialogue.rpy:169
    old "Nevermind, I've changed my mind."
    new "아냐, 마음이 바뀌었어."

