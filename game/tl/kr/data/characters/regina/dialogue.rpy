translate kr regina_askErika_dbb029de:

    # REGINA @ talk "I’m afraid she doesn’t share much else, not even with me."
    REGINA @ talk "안타깝지만 그 애는 다른 건 별로 안 알려줘, 나한테조차도."

# game/data/characters/regina/dialogue.rpy:55
