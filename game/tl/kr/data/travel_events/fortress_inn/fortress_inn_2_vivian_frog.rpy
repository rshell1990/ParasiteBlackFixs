    VIVIAN @ smile "{i}꼭 조만간 다시 들러주세요.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:393
translate kr replay_vivian_missionary_anal_61bd0ee3:

    # "She winked before closing the door behind her."
    "그녀는 윙크하고 문을 닫았다."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:398
translate kr replay_vivian_missionary_anal_78676278:

    # "Vivian blinked for a moment, caught off guard before quickly recomposing herself."
    "비비안은 잠시 눈을 깜빡이며 당황했지만, 곧 재빨리 평정을 되찾았다."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:399
translate kr replay_vivian_missionary_anal_4cd2cfea:

    # VIVIAN @ talk "Of course, sir."
    VIVIAN @ talk "물론이죠, 손님."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:400
translate kr replay_vivian_missionary_anal_8074a633:

    # VIVIAN @ talk "I will let you rest in peace."
    VIVIAN @ talk "편히 쉬실 수 있도록 하겠습니다."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:414
translate kr fortress_inn_vivian_preg_99ad7ff3:

    # VIVIAN @ talk "... We need to talk, {i}sir.{/i}"
    VIVIAN @ talk "... 이야기 좀 해야겠어요, {i}손님.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:415
translate kr fortress_inn_vivian_preg_e25f5309:

    # "My eyes drifted down towards her belly as I almost instinctively sensed the change."
    "본능적으로 변화를 감지한 듯 내 시선은 그녀의 배로 향했다."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:416
translate kr fortress_inn_vivian_preg_66b2de91:

    # MC @ surprised "Are you-"
    MC @ surprised "혹시-"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:418
translate kr fortress_inn_vivian_preg_9dcc9313:

    # VIVIAN @ talk "Yes, and it's yours."
    VIVIAN @ talk "네, 그리고 당신 아이예요."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:419
translate kr fortress_inn_vivian_preg_acfaa8e7:

    # MC @ talk "... Do you need coin or anything from me?"
    MC @ talk "... 돈이나 내게 필요한 거라도?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:420
translate kr fortress_inn_vivian_preg_b78b683f:

    # VIVIAN @ talk "No."
    VIVIAN @ talk "아뇨."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:421
translate kr fortress_inn_vivian_preg_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "뭐?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:422
translate kr fortress_inn_vivian_preg_3d9d7297:

    # VIVIAN @ sad "Just... I'd prefer if you weren't in and out of her life."
    VIVIAN @ sad "그냥... 그 아이 인생에서 들락날락하지 않아줬으면 해요."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:423
translate kr fortress_inn_vivian_preg_6ae44f1c:

    # VIVIAN @ sad "You're with the Adventurers' Guild. You're hardly the settling-down type."
    VIVIAN @ sad "당신은 모험가 길드 소속이잖아요. 정착할 타입이 아니죠."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:424
translate kr fortress_inn_vivian_preg_357a23bb:

    # VIVIAN @ sad "I don't mind you passing by to see how the littlun is doing, but please..."
    VIVIAN @ sad "아이가 어떻게 지내는지 보러 들르는 건 상관없지만, 제발..."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:425
translate kr fortress_inn_vivian_preg_4a0e8b31:

    # VIVIAN @ talk "I'll tell her that her father is a brave adventurer, but I'm not making promises about when you'll be back."
    VIVIAN @ talk "아이에겐 아빠가 용감한 모험가라고 말할게요, 하지만 언제 돌아올지는 약속하지 않을 거예요."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:426
translate kr fortress_inn_vivian_preg_2c355828:

    # VIVIAN @ talk "If you want to get to know your daughter."
    VIVIAN @ talk "당신 딸을 알고 싶다면 말이죠."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:429
translate kr fortress_inn_vivian_preg_09ad922e:

    # VIVIAN @ talk "Yes... {i}Again.{/i}"
    VIVIAN @ talk "네... {i}또.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:430
translate kr fortress_inn_vivian_preg_8d4c87e8:

    # VIVIAN @ angry "Have you considered {i}not{/i} finishing inside me so often?"
    VIVIAN @ angry "그렇게 자주 내 안에 싸는 걸 {i}안{/i} 하는 건 생각해 본 적 있어요?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:431
translate kr fortress_inn_vivian_preg_4daa591b:

    # MC @ talk "Have you considered not begging me to?"
    MC @ talk "네가 그렇게 해달라고 애원하지 않는 건 생각해 봤어?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:432
translate kr fortress_inn_vivian_preg_496aa71a:

    # VIVIAN @ talk "Hmph... Point taken."
    VIVIAN @ talk "흥... 인정."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:433
translate kr fortress_inn_vivian_preg_0076e300:

    # VIVIAN @ talk "Nothing has changed. The same rules apply."
    VIVIAN @ talk "달라진 건 없어요. 같은 규칙이 적용됩니다."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:434
translate kr fortress_inn_vivian_preg_181a7131:

    # VIVIAN @ talk "If you want to know this little one as well."
    VIVIAN @ talk "이 작은 아이도 알고 싶다면요."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:436
translate kr fortress_inn_vivian_preg_dcdf2687:

    # VIVIAN @ talk "{i}If you're still alive by then.{/i}"
    VIVIAN @ talk "{i}그때까지 아직 살아있다면.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:437
translate kr fortress_inn_vivian_preg_4268be46:

    # VIVIAN @ talk "Come back when she's old enough."
    VIVIAN @ talk "아이가 충분히 자랐을 때 다시 와요."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:439
translate kr fortress_inn_vivian_preg_645057ef:

    # "With that, Vivian turned to tend to the other tables."
    "그 말을 남기고, 비비안은 다른 테이블을 보러 돌아섰다."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:441
translate kr fortress_inn_vivian_preg_193677a4:

    # MC @ sad "(As depressing as her words were... Perhaps there was some truth in them.)"
    MC @ sad "(그녀의 말이 우울했지만... 어쩌면 일리가 있을지도 몰랐다.)"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:442
translate kr fortress_inn_vivian_preg_415a8152:

    # MC "(Still, hopefully there was a future for me in her life.)"
    MC "(그래도, 그녀의 인생에 나를 위한 미래가 있길 바랐다.)"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:443
translate kr fortress_inn_vivian_preg_6e9e356e:

    # MC "(... Presuming this infernal war didn't kill me first.)"
    MC "(... 이 끔찍한 전쟁이 나를 먼저 죽이지 않는다면.)"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:451
translate kr fortress_inn_vivian_postbirth_732a330e:

    # VIVIAN @ smile "Welcome..."
    VIVIAN @ smile "어서 오세요..."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:452
translate kr fortress_inn_vivian_postbirth_dece0234:

    # "In her arms, wrapped in cloth, Vivian cradled a small crying baby."
    "비비안은 천에 싸인 작고 우는 아기를 품에 안고 있었다."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:453
translate kr fortress_inn_vivian_postbirth_57f02561:

    # VIVIAN @ smile "I'll be with you in a moment, sir, once I've fed her."
    VIVIAN @ smile "아이 젖만 먹이면 곧 가겠습니다, 손님."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:454
translate kr fortress_inn_vivian_postbirth_00465953:

    # VIVIAN @ smile "... By the way, what did you think of the name-"
    VIVIAN @ smile "... 그런데, 그 이름 어땠어요-"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:456
translate kr fortress_inn_vivian_postbirth_be1162dc:

    # VIVIAN @ smile "Hm, I'll think on it."
    VIVIAN @ smile "흠, 생각해 볼게."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:457
translate kr fortress_inn_vivian_postbirth_8657b2c2:

    # VIVIAN @ talk "Enjoy the rest of your time here, sir."
    VIVIAN @ talk "남은 시간도 즐겁게 보내세요, 손님."

