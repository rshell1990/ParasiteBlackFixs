    # LUCY @ blush "I-It feels too good with you."
    LUCY @ blush "당-당신이랑 하면 너무 기분 좋아서요."

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:454
translate kr fortress_inn_lucy_impreg_dc0ab1f7:

    # "Lucy buried her face in her hands."
    "루시는 두 손에 얼굴을 파묻었다."

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:455
translate kr fortress_inn_lucy_impreg_61bc27a8:

    # LUCY @ blush "I know I should do better, but I keep letting you cum inside!"
    LUCY @ blush "더 잘해야 하는 걸 알면서도, 계속 안에 싸게 해드려요!"

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:456
translate kr fortress_inn_lucy_impreg_25bd7d98:

    # LUCY @ blush "It's all my fault!"
    LUCY @ blush "전부 내 잘못이에요!"

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:457
translate kr fortress_inn_lucy_impreg_2f1f339c:

    # MC @ sad "{i}*Sigh*{/i}"
    MC @ sad "{i}*한숨*{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:458
translate kr fortress_inn_lucy_impreg_29652208:

    # MC @ think "Do you need anything?"
    MC @ think "뭐 필요한 거 있어?"

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:459
translate kr fortress_inn_lucy_impreg_76c850fc:

    # LUCY @ talk "I... I'll be alright."
    LUCY @ talk "저... 괜찮을 거예요."

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:460
translate kr fortress_inn_lucy_impreg_870bd28f:

    # LUCY @ blush "I know you still have lots of adventures and things to do."
    LUCY @ blush "아직 모험도 많고 할 일도 많으신 거 알아요."

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:461
translate kr fortress_inn_lucy_impreg_e9d36b4d:

    # LUCY @ blush "Y-You Guild types are always so busy, haha!"
    LUCY @ blush "길-길드 분들은 항상 너무 바쁘잖아요, 하하!"

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:462
translate kr fortress_inn_lucy_impreg_c2a8c262:

    # LUCY @ happy "B-But, uhh! It would be really nice to see you at my village of Locksworth sometime!"
    LUCY @ happy "하-하지만, 저어! 언제 한번 제 마을 록스워스에 와주시면 정말 좋겠어요!"

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:463
translate kr fortress_inn_lucy_impreg_d9dafff6:

    # LUCY @ blush "I-If you can find the time, that is."
    LUCY @ blush "시-시간이 되신다면요."

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:464
translate kr fortress_inn_lucy_impreg_0bd100da:

    # LUCY @ talk "A-Anyway, I better get back to cleaning tables."
    LUCY @ talk "아-어쨌든, 테이블 닦으러 돌아가야겠어요."

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:465
translate kr fortress_inn_lucy_impreg_fbd2f901:

    # LUCY @ talk "P-Please call me over if you need anything!"
    LUCY @ talk "뭐-뭐 필요하시면 불러주세요!"

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:466
translate kr fortress_inn_lucy_impreg_c7b473d7:

    # "Her hand tenderly brushed against mine as she slipped past."
    "그녀가 스쳐 지나가며 그녀의 손이 내 손을 부드럽게 스쳤다."

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:469
translate kr fortress_inn_lucy_impreg_a07487b2:

    # "Without another word, Lucy returned to serving drinks at the other tables."
    "더 이상 말없이, 루시는 다른 테이블로 돌아가 음료를 서빙했다."

# game/data/travel_events/fortress_inn/fortress_inn_3_lucy_cat.rpy:471
translate kr fortress_inn_lucy_impreg_51c81371:

    # MC "(Locksworth, huh?)"
    MC "(록스워스라...)"

