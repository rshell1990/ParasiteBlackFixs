# game/data/world_events/global_shared/VizuraCaravan/Scr_FirstMeetNTalk.rpy:24
translate kr vizura_caravan_firstmeet_add48ea6:

    # "The goblin girl stared at the cock in front of her and blushed profusely."
    "고블린 소녀는 자기 앞의 자지를 응시하며 얼굴을 붉혔다."

# game/data/world_events/global_shared/VizuraCaravan/Scr_FirstMeetNTalk.rpy:26
translate kr vizura_caravan_firstmeet_25f74e84:

