translate kr act1scene8_menu2_14b448cb:

    # MARKUS "I'm Markus, and this is my friend."
    MARKUS "나는 마커스고, 이쪽은 내 친구야."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:189
translate kr act1scene8_menu2_84517b7f:

    # MC @ talk "[player_name!t]."
    MC @ talk "[player_name!t]."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:190
translate kr act1scene8_menu2_fbd7f00d:

    # SHAY @ smile "Nice to meet you both."
    SHAY @ smile "두 분 만나서 반가워요."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:191
translate kr act1scene8_menu2_b8d729f8:

    # MARKUS "I thought Old man Gomar run this place?"
    MARKUS "고마르 영감님이 이곳을 운영하는 줄 알았는데?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:192
translate kr act1scene8_menu2_4e081a16:

    # SHAY @ talk "He and his wife left for Inma about two months ago."
    SHAY @ talk "그분과 부인은 약 두 달 전에 인마로 떠났어요."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:193
translate kr act1scene8_menu2_a37c9fd0:

    # SHAY @ talk "Me and my husband Varan bought the place and took over."
    SHAY @ talk "저와 제 남편 바란이 이곳을 사서 인수했어요."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:194
translate kr act1scene8_menu2_fe2695a5:

    # "When I heard the word 'husband' escape her lips, I felt my heart sink slightly, but it was quickly overcome by the burning desires of the thing inside me."
    "그녀의 입술에서 '남편'이라는 단어가 흘러나오는 것을 들었을 때, 내 마음이 약간 가라앉는 것을 느꼈지만, 내 안에 있는 그것의 불타는 욕망에 금세 압도되었다."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:195
translate kr act1scene8_menu2_7b0aeacd:

    # MC @ surprised "Old man Gomar's gone?"
    MC @ surprised "고마르 영감님이 가셨어?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:196
translate kr act1scene8_menu2_f554c586:

    # SHAY @ think "Don't worry love."
    SHAY @ think "걱정 마세요, 자기."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:197
translate kr act1scene8_menu2_c48f2cda:

    # "A sly, sultry smile crawled across her lips."
    "교활하고 관능적인 미소가 그녀의 입술 위로 번졌다."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:198
translate kr act1scene8_menu2_9e7a208d:

    # SHAY @ smile2 "Think you'll miss him much?"
    SHAY @ smile2 "그분이 많이 그리울 것 같아요?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:199
translate kr act1scene8_menu2_d270bc52:

    # MC @ smile "I don't know... I think I quite like the change."
    MC @ smile "글쎄... 변화가 꽤 마음에 드는 것 같아."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:200
translate kr act1scene8_menu2_385bab89:

    # "Shay laughed, taking our empties glasses onto a tray and standing upright."
    "셰이는 웃으며, 우리의 빈 잔들을 쟁반에 올리고 똑바로 섰다."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:201
translate kr act1scene8_menu2_947ebe16:

    # SHAY @ talk "Now if you'll excuse me, I best get back to some work."
    SHAY @ talk "그럼 실례할게요, 일하러 가야 해서요."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:203
translate kr act1scene8_menu2_6a407e47:

    # "As Shay sauntered off towards another table, we watched as she leaned forward to pick up some glasses from the opposing table, and the outline of her round ass became visibly pressed against the fabric."
    "셰이가 다른 테이블로 활기차게 걸어가자, 우리는 그녀가 맞은편 테이블에서 잔들을 집기 위해 앞으로 몸을 기울이는 것을 보았고, 그녀의 둥근 엉덩이 윤곽이 옷감에 눈에 띄게 눌려졌다."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:204
translate kr act1scene8_menu2_26012dce:

    # MARKUS @ smile "By the gods..."
    MARKUS @ smile "세상에..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:205
translate kr act1scene8_menu2_9ead6503:

    # MARKUS @ smile "I wouldn't complain waking up to fuck an ass like that every day."
    MARKUS @ smile "매일 아침 그런 엉덩이를 따먹으며 일어난다면 불평하지 않을 거야."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:206
translate kr act1scene8_menu2_22d4f8fd:

    # MC @ smile "Mmm..."
    MC @ smile "으음..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:207
translate kr act1scene8_menu2_162e5e03:

    # MARKUS "She has her eye on you y'know."
    MARKUS "그녀가 너한테 눈독을 들이고 있어, 알지."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:208
translate kr act1scene8_menu2_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "뭐?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:209
translate kr act1scene8_menu2_12df4ebf:

    # MARKUS @ smile "I mean don't get me wrong, if she looked too long at me she knew her marriage would be doomed."
    MARKUS @ smile "내 말은 오해하지 마, 그녀가 나를 너무 오래 쳐다보면 그녀의 결혼이 파멸할 거라는 걸 그녀도 알 거야."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:210
translate kr act1scene8_menu2_f7ae3acb:

    # MARKUS "But I saw the way she kept looking at you."
    MARKUS "하지만 그녀가 계속 너를 바라보는 방식을 봤어."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:211
translate kr act1scene8_menu2_2c01cdd7:

    # MC @ surprised "She's married!"
    MC @ surprised "그녀는 유부녀야!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:212
translate kr act1scene8_menu2_31b8a208:

    # MARKUS "So?"
    MARKUS "그래서?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:213
translate kr act1scene8_menu2_c3e74eed:

    # MARKUS "You gotta start thinking about getting some girls on the side friend..."
    MARKUS "친구, 이제 옆에 여자들 좀 두는 걸 생각해야 해..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:214
translate kr act1scene8_menu2_7f599cbd:

    # MARKUS "What if you don't have the coin for the brothel?"
    MARKUS "사창가에 갈 돈이 없으면 어쩌려고?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:215
translate kr act1scene8_menu2_c0b3f0c7:

    # MARKUS "Gonna risk your life in a fight every night just to keep your thing happy?"
    MARKUS "매일 밤 네 물건을 행복하게 하려고 목숨 걸고 싸울 거야?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:216
translate kr act1scene8_menu2_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:217
translate kr act1scene8_menu2_7dd6ff63:

    # MARKUS @ smile "So, you gonna go for her?"
    MARKUS @ smile "그래서, 그녀에게 갈 거야?"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:218
translate kr act1scene8_menu2_a429af02:

    # MC @ talk "...I'll think on it."
    MC @ talk "...생각해 볼게."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:219
translate kr act1scene8_menu2_6f455fb9:

    # MARKUS @ smile "Okay [player_name!t], let's roll."
    MARKUS @ smile "좋아 [player_name!t], 가자."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:220
translate kr act1scene8_menu2_4109bbc5:

    # MC "But I haven't finished my drink yet!"
    MC "하지만 아직 술도 다 안 마셨어!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:221
translate kr act1scene8_menu2_7bc04d08:

    # MARKUS @ smile "Come on, there's only so much time you can spend drinking."
    MARKUS @ smile "어서, 술 마시는 데 쓸 수 있는 시간은 한정돼 있어."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:222
translate kr act1scene8_menu2_73129eef:

    # MARKUS @ smile "We've got the whole world to take on!"
    MARKUS @ smile "우리에겐 온 세상이 기다리고 있어!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:223
translate kr act1scene8_menu2_2719a439:

    # MC "You're drunk!"
    MC "너 취했어!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:224
translate kr act1scene8_menu2_90df7a50:

    # MARKUS "So what? Doesn't change the fact!"
    MARKUS "그래서 뭐? 사실은 변하지 않아!"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:225
translate kr act1scene8_menu2_1578ccda:

    # "I looked at the half-finished drink drink and nodded:"
    "나는 반쯤 남은 술잔을 보고 고개를 끄덕였다:"

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:226
translate kr act1scene8_menu2_bb3528f6:

    # MC "You know what, you're right. Let's go."
    MC "있잖아, 네 말이 맞아. 가자."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:228
translate kr act1scene8_menu2_7e63298a:

    # "As we walked out of the tavern, I thought that perhaps Markus was right."
    "선술집을 나서면서, 나는 어쩌면 마커스가 맞을지도 모른다고 생각했다."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:229
translate kr act1scene8_menu2_8382c345:

    # "Perhaps the worst truly was behind us."
    "어쩌면 최악은 진짜로 우리 뒤에 있었다."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:230
translate kr act1scene8_menu2_44557c51:

    # "But some part of me could not shake the feeling that this was only the beginning."
    "하지만 내 안의 어떤 부분은 이것이 시작에 불과하다는 느낌을 떨칠 수 없었다."

