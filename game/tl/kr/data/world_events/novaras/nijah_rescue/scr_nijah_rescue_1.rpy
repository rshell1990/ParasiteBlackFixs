# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:3
translate kr evscr_nijah_rescue_1_53260509:

    # MC "Sounds like sure trouble... Should I?" nointeract
    MC "분명히 문제가 생긴 것 같군... 가볼까?" nointeract

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:6
translate kr evscr_nijah_rescue_1_f8d6d024:

    # "I turned sharply as I made my way through a series of dark and fetid alleyways, chasing the sounds."
    "나는 날카롭게 방향을 틀어 어둡고 악취 나는 골목길들을 지나며 소리를 쫓아갔다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:7
translate kr evscr_nijah_rescue_1_843b0aa0:

    # "Stumbling over dislodged cobblestones and piles of rubbish, I finally came across a woman, terrified and cowering."
    "빠져나온 조약돌과 쓰레기 더미에 발이 걸려 넘어지며, 마침내 공포에 질려 웅크리고 있는 한 여자를 발견했다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:8
translate kr evscr_nijah_rescue_1_bba0ea96:

    # "Her face was shrouded by rags as the men surrounded her brandishing their blades."
    "남자들이 칼날을 휘두르며 그녀를 에워싸고 있을 때, 그녀의 얼굴은 누더기로 가려져 있었다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:9
translate kr evscr_nijah_rescue_1_db49222d:

    # "The largest amongst them, a fat, repulsive bearded thug, towered over her."
    "그들 중 가장 덩치가 큰, 뚱뚱하고 혐오스러운 수염 난 깡패가 그녀 위로 우뚝 서 있었다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:10
translate kr evscr_nijah_rescue_1_275c7a43:

    # THUG @ talk "Stupid fucking whore."
    THUG @ talk "이 멍청한 창년 같으니."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:11
translate kr evscr_nijah_rescue_1_9caf38da:

    # THUG @ talk "You still owe us gold, girl!"
    THUG @ talk "아직 우리한테 돈 빚졌어, 아가씨!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:12
translate kr evscr_nijah_rescue_1_9e522f02:

    # "The frightened, muffled voice pleaded back."
    "겁먹고, 숨죽인 목소리가 애원하며 대답했다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:13
translate kr evscr_nijah_rescue_1_87ee3a0e:

    # UNKNOWN @ talk "Please! Need time!"
    UNKNOWN @ talk "제발! 시간이 필요해요!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:14
translate kr evscr_nijah_rescue_1_39c7b05d:

    # THUG @ talk "No more time, you pay NOW!"
    THUG @ talk "시간 더는 없어, 지금 당장 내!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:19
translate kr evscr_nijah_rescue_1_afadeed1:

    # "From the shadows I emerged, and the men turned to face me."
    "그림자 속에서 내가 나타나자, 남자들이 나를 향해 돌아섰다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:20
translate kr evscr_nijah_rescue_1_568bf043:

    # THUG @ talk "Who are you?"
    THUG @ talk "누구야?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:21
translate kr evscr_nijah_rescue_1_5a8de8fb:

    # THUG @ talk "Stay out of this, this does nor a concern you."
    THUG @ talk "끼어들지 마, 이건 너랑 상관없는 일이야."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:22
translate kr evscr_nijah_rescue_1_73cc7d0a:

    # "Looking around, I could see dozens of eyes watching from every open crevice and window."
    "주위를 둘러보니, 열린 틈새와 창문마다 수십 개의 눈이 지켜보고 있었다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:23
translate kr evscr_nijah_rescue_1_cef271a4:

    # MC "(Damn... I better be careful here, it's too risky to transform)"
    MC "(젠장... 여기선 조심해야 해, 변신하기엔 너무 위험해)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:24
translate kr evscr_nijah_rescue_1_d5d88d8b:

    # MC "(If I fight them, I'll have to do it in my normal form)"
    MC "(싸워야 한다면, 평소 모습으로 해야 해)"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:37
translate kr evscr_nijah_rescue_1_thugsmenu_0ba34b00:

    # THUG @ talk "Bah! There are three of us and only one of you!"
    THUG @ talk "쳇! 우리는 셋이고 너는 하나뿐이야!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:38
translate kr evscr_nijah_rescue_1_thugsmenu_e049bb73:

    # THUG @ talk "You'll have to do better than that!"
    THUG @ talk "그걸로는 부족해!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:43
translate kr evscr_nijah_rescue_1_thugsmenu_b57efaae:

    # THUG @ talk "Kill him, you fools!"
    THUG @ talk "죽여, 이 바보들!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:48
translate kr evscr_nijah_rescue_1_thugsmenu_6e045b1a:

    # "As their lifeless bodies littered the alleyway, the blood flowed freely into the cracks of the cobblestone."
    "그들의 생명 없는 시체가 골목길에 널브러지자, 피가 조약돌 틈새로 자유롭게 흘러들었다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:49
translate kr evscr_nijah_rescue_1_thugsmenu_350520a2:

    # "I sighed with relief, wiping the sweat from my brow but quickly realised I couldn't stay here long or else I risked drawing the ire of the guards."
    "안도의 한숨을 쉬며 이마의 땀을 닦았지만, 여기 오래 머물면 경비병들의 분노를 살 위험이 있다는 걸 곧 깨달았다."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:53
translate kr evscr_nijah_rescue_1_thugsmenu_83ae0dcb:

    # THUG @ talk "This is not your business, stranger!"
    THUG @ talk "이건 네 일이 아니야, 이방인!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:54
translate kr evscr_nijah_rescue_1_thugsmenu_f5ad7f49:

    # THUG @ talk "This woman owes us money and she will pay it!"
    THUG @ talk "이 여자는 우리한테 빚을 졌고 갚아야 해!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:55
translate kr evscr_nijah_rescue_1_thugsmenu_03518bd4:

    # MC @ talk "How much is her debt?"
    MC @ talk "빚이 얼마지?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:56
translate kr evscr_nijah_rescue_1_thugsmenu_b02d4725:

    # THUG @ talk "Two hundred coins now... the rest later."
    THUG @ talk "지금 이백 코인... 나머지는 나중에."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:60
translate kr evscr_nijah_rescue_1_thugsmenu_3a22e377:

    # THUG @ talk "Hmm..."
    THUG @ talk "흠..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:61
translate kr evscr_nijah_rescue_1_thugsmenu_9a589a68:

    # THUG @ talk "You have bought yourself some time, {i}for now,{/i} girl..."
    THUG @ talk "시간을 벌었군, {i}지금으로선,{/i} 아가씨..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:62
translate kr evscr_nijah_rescue_1_thugsmenu_276b253c:

    # THUG @ talk "Pleasure doing business with you, stranger, heh..."
    THUG @ talk "거래가 즐거웠어, 이방인, 헤..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_1.rpy:66
translate kr evscr_nijah_rescue_1_thugsmenu_6dfebd14:

    # THUG @ talk "Men! Draw your blades!"
    THUG @ talk "녀석들! 칼을 뽑아!"

