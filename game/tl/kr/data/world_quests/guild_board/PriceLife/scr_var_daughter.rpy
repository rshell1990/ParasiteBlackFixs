translate kr qst_guild_price_life_daughter_rescued_a9be19fb:

    # CALLIE "Not many, at least, compared to somewhere like Ramon."
    CALLIE "많진 않아, 적어도 라몬 같은 곳에 비하면."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:225
translate kr qst_guild_price_life_daughter_rescued_319f1f70:

    # CALLIE "But Hamun tolerates us enough to get by."
    CALLIE "하지만 하문은 그럭저럭 살 만큼은 우리를 받아줘."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:226
translate kr qst_guild_price_life_daughter_rescued_ac94de8d:

    # MC "I see."
    MC "그렇군."
# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:227
translate kr qst_guild_price_life_daughter_rescued_d9805a81:

    # "The Katai girl continued to watch me throughout the travel, whenever our eyes met, she would flutter her eyes and smile."
    "카타이 소녀는 여행 내내 나를 계속 지켜봤고, 우리 눈이 마주칠 때마다, 그녀는 눈을 깜빡이며 미소 지었다."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:228
translate kr qst_guild_price_life_daughter_rescued_bf535d5f:

    # MC "Is there a reason you keep looking at me?"
    MC "자꾸 나를 쳐다보는 이유가 있나?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:229
translate kr qst_guild_price_life_daughter_rescued_fa6050e4:

    # CALLIE "Why do you think?"
    CALLIE "왜 그런 것 같아?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:230
translate kr qst_guild_price_life_daughter_rescued_b605e749:

    # MC "Your father paid me to-"
    MC "네 아버지가 나한테 돈을 줘서-"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:231
translate kr qst_guild_price_life_daughter_rescued_fc951138:

    # CALLIE "Fuck my father, he's not here."
    CALLIE "아버지는 집어치워, 여기 없잖아."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:232
translate kr qst_guild_price_life_daughter_rescued_f198c63c:

    # MC "You're very forward, aren't you?"
    MC "넌 꽤 대담하구나, 그렇지?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:233
translate kr qst_guild_price_life_daughter_rescued_2bd11da4:

    # CALLIE "Am I not your type?"
    CALLIE "내가 네 타입이 아니야?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:237
translate kr qst_guild_price_life_daughter_rescued_eb54707c:

    # "Callie bit at her lower lip."
    "칼리가 아랫입술을 깨물었다."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:238
translate kr qst_guild_price_life_daughter_rescued_5a271163:

    # CALLIE "Good to know ... my rescuer."
    CALLIE "알아둬서 좋네... 나의 구조자님."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:240
translate kr qst_guild_price_life_daughter_rescued_f06ab00f:

    # CALLIE "Hmph ... Shame."
    CALLIE "흠... 아쉽네."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:241
translate kr qst_guild_price_life_daughter_rescued_c311ec86:

    # "We continued on along the journey mostly in silence."
    "우리는 대부분 침묵 속에서 여행을 계속했다."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:246
translate kr qst_guild_price_life_daughter_rescued_053cc292:

    # "Afterwards, darkness began to descend during our travels back, so we stopped our way into one of the many fortress inns now along the path home."
    "그 후, 돌아오는 여행 중에 어둠이 내리기 시작해서, 우리는 집으로 가는 길에 있는 많은 요새 여관 중 하나에 들렀다."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:247
translate kr qst_guild_price_life_daughter_rescued_dc855075:

    # "This one, according to the guild, was booked accordingly in agreement with the Merchant for rest during the trek back."
    "이곳은 길드에 따르면, 귀환 여행 중 휴식을 위해 상인과의 합의에 따라 예약된 곳이었다."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:253
translate kr qst_guild_price_life_daughter_rescued_a673a949:

    # MC "Your father only booked one room it seems."
    MC "네 아버지가 방 하나만 예약한 모양이야."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:254
translate kr qst_guild_price_life_daughter_rescued_d8b09662:

    # MC "He really didn't want to spend anymore than he had to, did he?"
    MC "정말 필요한 만큼만 쓰려고 했나 보네, 그렇지?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:255
translate kr qst_guild_price_life_daughter_rescued_6599b925:

    # CALLIE @ talk "Father is a tight prick who probably negotiated the guild to give him a discount before sending you."
    CALLIE @ talk "아버지는 팍팍한 구두쇠라 아마 당신을 보내기 전에 길드랑 할인 협상했을 거야."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:256
translate kr qst_guild_price_life_daughter_rescued_c10806cc:

    # CALLIE @ angry "I'm hardly surprised he'd avoid paying for two rooms."
    CALLIE @ angry "방 두 개 값 안 내려고 한 것도 별로 놀랍지 않아."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:257
translate kr qst_guild_price_life_daughter_rescued_2b0e8b3a:

    # MC @ talk "Ah, that sounds like a difficult relationship."
    MC @ talk "아, 힘든 사이인가 보네."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:258
translate kr qst_guild_price_life_daughter_rescued_44474902:

    # CALLIE @ talk "It's no matter."
    CALLIE @ talk "별거 아니야."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:267
