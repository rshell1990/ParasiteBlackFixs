translate kr qst_guild_price_life_daughter_rescued_2b67bec4:

    # CALLIE "Then it's a good thing I'm not from Novaras, isn't it?"
    CALLIE "그럼 내가 노바라스 출신이 아니라서 다행이네, 그렇지?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:220
translate kr qst_guild_price_life_daughter_rescued_5a630605:

    # MC "Oh?"
    MC "오?"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:221
translate kr qst_guild_price_life_daughter_rescued_fb6dc855:

    # CALLIE "My family lives in the free city of Hamun."
    CALLIE "우리 가족은 자유 도시 하문에 살아."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:222
translate kr qst_guild_price_life_daughter_rescued_36ace07f:

    # MC "That so?"
    MC "그래?"

