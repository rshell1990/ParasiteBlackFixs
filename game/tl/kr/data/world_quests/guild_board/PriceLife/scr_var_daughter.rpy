    # MC "That doesn't matter, what matters is we get you home."
    MC "그건 중요하지 않아. 중요한 건 널 집에 데려가는 거야."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:193
translate kr qst_guild_price_life_daughter_done_talking_3af583f1:

