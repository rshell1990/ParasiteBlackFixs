translate kr qst_guild_rodents_ba69243c:

    # MC "(I thought they'd never stop coming...)"
    MC "(끝도 없이 몰려오는 줄 알았어...)"

# game/data/world_quests/guild_board/Rodents/scr.rpy:94
translate kr qst_guild_rodents_0a80a6d6:

    # MARKUS "Well, job well done I guess."
    MARKUS "뭐, 잘 해낸 것 같군."

# game/data/world_quests/guild_board/Rodents/scr.rpy:95
translate kr qst_guild_rodents_e5af19f1:

    # MARKUS @ shock "Now can we get out of here now before they decide they'd like to give eating us another go?"
    MARKUS @ shock "이제 쟤네가 우리를 다시 먹으려 들기 전에 여기서 나가도 될까?"

# game/data/world_quests/guild_board/Rodents/scr.rpy:99
translate kr qst_guild_rodents_d6ab0143:

    # MYU @ scared "Myu isn't very tasty!"
    MYU @ scared "뮤는 별로 맛없어!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:102
translate kr qst_guild_rodents_3473bfb5:

    # MC "Let's take a head or two for proof and be done with this quest already!"
    MC "증거로 머리 한두 개 챙기고 이 의뢰 끝내자!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:110
translate kr qst_guild_rodents_8bdfd3b5:

    # "Shortly after, exhausted from the gruelling experience, we made our way back to the surface and after presenting a few heads of the rats, took our reward."
    "얼마 지나지 않아 지독한 경험에 지쳐 지상으로 돌아왔고 쥐 머리 몇 개를 제시한 후 보상을 받았다."

# game/data/world_quests/guild_board/Rodents/scr.rpy:112
