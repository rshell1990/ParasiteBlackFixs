translate kr qst_FromAnotherWorld_GoToMarkusHouse_56169cb1:

    # SKALLION "What have they been feeding the two of you?!"
    SKALLION "둘에게 도대체 뭘 먹인 거야?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:21
translate kr qst_FromAnotherWorld_GoToMarkusHouse_85613c44:

    # MC @ talk "U-Uhhh, plenty of meat?"
    MC @ talk "어-어어어, 고기가 많아요?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:22
translate kr qst_FromAnotherWorld_GoToMarkusHouse_de517d45:

    # SKALLION "Some bloody good meat..."
    SKALLION "아주 죽여주는 고기였나 보군..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:23
translate kr qst_FromAnotherWorld_GoToMarkusHouse_3e325f63:

    # SKALLION "Anyway, you two should go to the Adventurers Guild now."
    SKALLION "어쨌든, 너희 둘은 이제 모험가 길드로 가야 해."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:24
translate kr qst_FromAnotherWorld_GoToMarkusHouse_274ddbfe:

    # SKALLION "Try not to get into any trouble on your way there."
    SKALLION "가는 길에 문제 일으키지 말도록 해."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:25
translate kr qst_FromAnotherWorld_GoToMarkusHouse_ef6ac64b:

    # "Skallion nodded briefly in my direction."
    "스칼리온은 내 쪽으로 짧게 고개를 끄덕였다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:26
translate kr qst_FromAnotherWorld_GoToMarkusHouse_fb5e296b:

    # SKALLION "It’s good to see you, [player_name!t]."
    SKALLION "만나서 반갑다, [player_name!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:27
translate kr qst_FromAnotherWorld_GoToMarkusHouse_dbd12c1a:

    # SKALLION "Try and stop Markus from getting too drunk, if that’s even possible."
    SKALLION "마커스가 너무 취하지 않게 막아줘, 가능하다면 말이지."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:28
translate kr qst_FromAnotherWorld_GoToMarkusHouse_3e187933:

    # MARKUS "Urgh, I’m not a child anymore you know."
    MARKUS "으으, 이제 더 이상 애가 아니란 거 알잖아."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:29
translate kr qst_FromAnotherWorld_GoToMarkusHouse_aff511e7:

    # SKALLION "I know I know..."
    SKALLION "알아 알아..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:30
translate kr qst_FromAnotherWorld_GoToMarkusHouse_393000c5:

    # SKALLION "You’re an OVERGROWN child with a drinking problem."
    SKALLION "넌 술 문제 있는 너무 자란 꼬마야."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:31
translate kr qst_FromAnotherWorld_GoToMarkusHouse_9c42a8b9:

    # "Markus pulled an unimpressed expression as Skallion snickered to himself."
    "마커스는 스칼리온이 혼자 킥킥 웃자 시큰둥한 표정을 지었다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:32
translate kr qst_FromAnotherWorld_GoToMarkusHouse_6eef8ce4:

    # SKALLION "Oh, and don’t disturb me in my room plase..."
    SKALLION "아, 그리고 내 방에서 날 방해하지 말아줘..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:33
translate kr qst_FromAnotherWorld_GoToMarkusHouse_8a710b07:

    # SKALLION "I’m working on a little project."
    SKALLION "작은 프로젝트를 진행 중이야."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:34
translate kr qst_FromAnotherWorld_GoToMarkusHouse_2e478c4d:

    # MARKUS "Is this another one of your secret projects?"
    MARKUS "이것도 네 비밀 프로젝트 중 하나야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:35
translate kr qst_FromAnotherWorld_GoToMarkusHouse_d6f4eb56:

    # SKALLION "{i}Perhaps.{/i}"
    SKALLION "{i}아마도.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:36
translate kr qst_FromAnotherWorld_GoToMarkusHouse_b2eb23c8:

    # MARKUS "Will we ever see one of these secret projects of yours?"
    MARKUS "네 비밀 프로젝트 중 하나라도 언젠가 볼 수 있을까?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:37
translate kr qst_FromAnotherWorld_GoToMarkusHouse_2af2a567:

    # SKALLION "When it’s done, of course!"
    SKALLION "완성되면 당연히!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:38
translate kr qst_FromAnotherWorld_GoToMarkusHouse_78403189:

    # MARKUS "...Will it {i}ever{/i} be done?"
    MARKUS "...{i}언젠가는{/i} 완성될까?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:39
translate kr qst_FromAnotherWorld_GoToMarkusHouse_b89fc0b4:

    # SKALLION "Such little faith you have, younger brother."
    SKALLION "믿음이 참 적구나, 동생아."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:40
translate kr qst_FromAnotherWorld_GoToMarkusHouse_bfb62c86:

    # SKALLION "I promise you, when this is done, we’ll be swimming in gold."
    SKALLION "약속할게, 이게 완성되면 우린 금에서 헤엄칠 거야."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:41
translate kr qst_FromAnotherWorld_GoToMarkusHouse_4295ca1f:

    # MARKUS "For that I cannot wait!"
    MARKUS "그건 못 기다려!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:43
translate kr qst_FromAnotherWorld_GoToMarkusHouse_77459e11:

    # "Skallion smirked to himself as he headed back into his room, closing the door firmly behind him."
    "스칼리온은 혼자 씩 웃으며 자기 방으로 돌아가, 문을 굳게 닫았다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:44
translate kr qst_FromAnotherWorld_GoToMarkusHouse_136008ab:

    # "Markus nodded and motioned for me to come into his room."
    "마커스는 고개를 끄덕이고 내게 자기 방으로 들어오라고 손짓했다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:51
translate kr qst_FromAnotherWorld_GoToMarkusHouse_ef0e71b9:

    # "The room was smaller than mine, little more than box really with just two shelves and a chest."
    "그 방은 내 방보다 작았고, 겨우 선반 두 개와 상자 하나만 있는 상자 같은 곳이었다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:52
translate kr qst_FromAnotherWorld_GoToMarkusHouse_d96e4bf4:

    # "His room used to be a place Skallion stored things before the young Markus abruptly arrived."
    "방은 원래 스칼리온이 물건을 보관하던 곳이었다. 어린 마커스가 불쑥 도착하기 전까지."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:54
translate kr qst_FromAnotherWorld_GoToMarkusHouse_6994bdf6:

    # "Grabbing the small pouch from the shelf, Markus turned to dangle it in front of me."
    "선반에서 작은 주머니를 집어 들고, 마커스는 내 앞에서 그것을 대롱대롱 흔들었다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:55
translate kr qst_FromAnotherWorld_GoToMarkusHouse_e94e0fb2:

    # "I heard the rustle of coin inside."
    "안에서 동전이 달그락거리는 소리가 들렸다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:56
translate kr qst_FromAnotherWorld_GoToMarkusHouse_98fb41e8:

    # MARKUS "Say hello to tonight's entertainment."
    MARKUS "오늘 밤의 즐길 거리에게 인사해."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:57
translate kr qst_FromAnotherWorld_GoToMarkusHouse_5cf8e7c0:

    # MARKUS "[player_name!t]? You in there?"
    MARKUS "[player_name!t]? 너 거기 있냐?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:58
translate kr qst_FromAnotherWorld_GoToMarkusHouse_c96f0405:

    # MC @ talk "No, nevermind me, I'm just estimating the amount of effort it will take to stop you from drinking this all up."
    MC @ talk "아니, 내 말은 신경 쓰지 마. 그냥 네가 이걸 전부 마셔버리는 걸 막는 데 얼마나 노력이 들지 가늠하는 중이야."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:59
translate kr qst_FromAnotherWorld_GoToMarkusHouse_8dca3bcc:

    # MARKUS "Haha! No, I'm not really in the mood for getting {i}too drunk{/i} now..."
    MARKUS "하하! 아니, 지금은 {i}너무 취하고{/i} 싶은 기분이 아니야..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:60
translate kr qst_FromAnotherWorld_GoToMarkusHouse_1ba5839d:

    # MARKUS "Ever since the... The thing happened."
    MARKUS "그... 그 일이 있고 나서부터 말이야."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:61
translate kr qst_FromAnotherWorld_GoToMarkusHouse_cef1ea26:

    # "An eerie silence enveloped the room as we involuntarily recalled bits and pieces of the events at the fort."
    "우리가 무의식적으로 요새에서의 사건 조각들을 떠올리자 으스스한 침묵이 방을 감쌌다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:62
translate kr qst_FromAnotherWorld_GoToMarkusHouse_ba56ef01:

    # "I broke the silence with a probing question:"
    "탐색하는 질문으로 침묵을 깼다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:63
translate kr qst_FromAnotherWorld_GoToMarkusHouse_f17dba09:

    # MC @ talk "Say Markus, what do you remember about what happened to us?"
    MC @ talk "야 마커스, 우리에게 무슨 일이 있었는지 너는 뭘 기억해?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:64
translate kr qst_FromAnotherWorld_GoToMarkusHouse_8f28c026:

    # MARKUS "*Sigh* Must we do this now?"
    MARKUS "*한숨* 꼭 지금 해야만 해?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:65
translate kr qst_FromAnotherWorld_GoToMarkusHouse_82e23bb3:

    # MARKUS "I’d rather have a pint of ale or two first."
    MARKUS "차라리 맥주 한두 잔 먼저 하고 싶은데."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:66
translate kr qst_FromAnotherWorld_GoToMarkusHouse_c1be730c:

    # MC @ talk "I just need to know."
    MC @ talk "그냥 알아야만 해."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:67
translate kr qst_FromAnotherWorld_GoToMarkusHouse_68b4cda3:

    # MC @ talk "Have you been hearing voices?"
    MC @ talk "환청이 들렸나?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:68
translate kr qst_FromAnotherWorld_GoToMarkusHouse_6229010b:

    # "Markus paused uncomfortably as his face turned sullen and uneasy."
    "마커스는 그의 얼굴이 침울하고 불안해지자 불편하게 멈췄다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:69
translate kr qst_FromAnotherWorld_GoToMarkusHouse_88e4876b:

    # MARKUS "... Yes."
    MARKUS  "... 그래."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:70
translate kr qst_FromAnotherWorld_GoToMarkusHouse_c3f1a405:

    # MC @ talk "What did the voice say?"
    MC @ talk "그 목소리는 뭐라고 말했어?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:71
translate kr qst_FromAnotherWorld_GoToMarkusHouse_4ea298cc:

    # MARKUS "That it was here to help, that it had saved me."
    MARKUS "여기서 도우려는 거라고, 나를 구했다고."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:72
translate kr qst_FromAnotherWorld_GoToMarkusHouse_17a55499:

    # MARKUS "I would really rather not think—"
    MARKUS "정말로 생각하고 싶지 않은데—"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:73
translate kr qst_FromAnotherWorld_GoToMarkusHouse_d675b20e:

    # "Suddenly, Markus’ eyes widened in surprise as he stumbled backwards clumsily, shock etched on his face."
    "갑자기 마커스의 눈이 놀라서 커지더니, 서투르게 뒤로 비틀거렸다. 얼굴에는 충격이 새겨져 있었다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:74
translate kr qst_FromAnotherWorld_GoToMarkusHouse_19524cd6:

    # MC @ talk "... Markus?"
    MC @ talk "... 마커스?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:75
translate kr qst_FromAnotherWorld_GoToMarkusHouse_178c19a8:

    # "Turning pale white, Markus collapsed, but his hand reached out to grab onto one of the shelves, dragging everything off from it in one clean sweep as he fell backwards onto his bed."
    "새하얗게 질리며, 마르쿠스가 쓰러졌다. 하지만 그의 손이 선반 중 하나를 붙잡으며, 뒤로 침대 위에 쓰러지면서 모든 것을 깨끗이 쓸어내렸다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:76
translate kr qst_FromAnotherWorld_GoToMarkusHouse_8362d5b0:

    # MC @ talk "Markus!"
    MC @ talk "마커스!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:78
translate kr qst_FromAnotherWorld_GoToMarkusHouse_d87a50e5:

    # "Stepping forward to help him, I suddenly felt an intense burning heat within my chest, like my lungs were filling with ash."
    "그를 도우려 앞으로 나서자, 갑자기 가슴 안에 강렬한 타는 듯한 열기가 느껴졌다. 폐가 재로 가득 차는 것처럼."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:84
translate kr qst_FromAnotherWorld_GoToMarkusHouse_d7341b8a:

    # "Something began to swirl and froth inside of me, I could feel it moving under my skin, stretching and splitting me."
    "무언가가 내 안에서 소용돌이치고 거품 올랐다. 피부 아래로 움직이는 게 느껴졌다. 나를 늘이고 찢으며."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:85
translate kr qst_FromAnotherWorld_GoToMarkusHouse_45c57fa0:

    # "Frantically, the two of us began to pull off our clothes to see what horror was beneath, we found a hot mass swelling on both of our chests, Markus’ white, mine black."
    "허겁지겁, 우리 둘은 옷을 벗겨내기 시작했다. 아래 무슨 공포가 있는지 보려고. 우리 가슴 위에서 뜨거운 덩어리가 부풀어 오르고 있었다. 마커스의 것은 흰색, 내 것은 검은색."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:89
translate kr qst_FromAnotherWorld_GoToMarkusHouse_bbb10b86:

    # "We looked to each other, frozen in terror."
    "우리는 서로를 바라보았다, 공포에 얼어붙은 채."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:90
translate kr qst_FromAnotherWorld_GoToMarkusHouse_39b6c7fa:

    # "Before we could say anything, they moulded and took form; extending out of our bodies, the two liquids coiled around each other."
    "우리가 무슨 말을 하기도 전에, 그것들은 빚어지고 형태를 갖추었다; 우리 몸에서 뻗어 나와, 두 액체가 서로를 휘감았다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:91
translate kr qst_FromAnotherWorld_GoToMarkusHouse_e87013db:

    # "What appeared to be their heads now became bug-like in appearance with sharp pincers extending out of them as the creatures looked quizzically at each other before gradually retreating."
    "머리로 보이는 것이 이제 벌레 같은 외관을 띠었고, 날카로운 집게발이 튀어나왔다. 생명체들이 서로를 의아하게 바라보다가 점차 후퇴했다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:92
translate kr qst_FromAnotherWorld_GoToMarkusHouse_fa6b4545:

    # "My heart stopped, I thought that at any moment these things that were inhabiting our bodies were going to split through our skin and kill us in some wretched, macabre display of violence."
    "심장이 멈췄다. 우리 몸에 기생하는 이것들이 언제라도 피부를 찢고 나와 끔찍하고 섬뜩한 폭력의 전시 속에서 우리를 죽일 거라고 생각했다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:93
translate kr qst_FromAnotherWorld_GoToMarkusHouse_ea0bfa1f:

    # "We both looked at each other, half in disbelief, half in terror."
    "우리 둘은 서로를 바라보았다. 반은 믿기지 않는다는 듯, 반은 공포에 질려."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:94
translate kr qst_FromAnotherWorld_GoToMarkusHouse_4ed832ba:

    # "Now angled towards us, the things looked us dead in the eye and turned their strange heads inwards in curiosity."
    "이제 우리를 향해 각도를 틀며, 그것들은 우리 눈을 똑바로 응시하고 호기심에 기묘한 머리를 안쪽으로 돌렸다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:95
translate kr qst_FromAnotherWorld_GoToMarkusHouse_e1050380:

    # "Then... {i}they spoke without mouths{/i}."
    "그러자... {i}그들은 입 없이 말했다{/i}."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:96
translate kr qst_FromAnotherWorld_GoToMarkusHouse_66bfe193:

    # BLACK "{i}Hello...{/i}"
    BLACK "{i}안녕...{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:97
translate kr qst_FromAnotherWorld_GoToMarkusHouse_652e3355:

    # "Me and Markus shared a look of panic as we waited for what came next."
    "나와 마커스는 다음에 올 일을 기다리며 공포의 시선을 나눴다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:98
translate kr qst_FromAnotherWorld_GoToMarkusHouse_b70c4b70:

    # WHITE "{i}Do not be alarmed.{/i}"
    WHITE "{i}놀라지 마라.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:99
translate kr qst_FromAnotherWorld_GoToMarkusHouse_e54e64e2:

    # BLACK "{i}You are our hosts, we wish you no harm.{/i}"
    BLACK "{i}너희는 우리의 숙주다. 해를 끼칠 의도는 없다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:100
translate kr qst_FromAnotherWorld_GoToMarkusHouse_7c963290:

    # MC @ talk "How... How can we hear you?"
    MC @ talk "어떻게... 어떻게 네 말이 들리지?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:101
translate kr qst_FromAnotherWorld_GoToMarkusHouse_08ff171f:

    # WHITE "{i}We have formed a link to communicate.{/i}"
    WHITE "{i}우리는 소통을 위해 연결을 형성했다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:102
translate kr qst_FromAnotherWorld_GoToMarkusHouse_56d495c1:

    # BLACK "{i}We have been learning your language from the archives of your memories.{/i}"
    BLACK "{i}우리는 네 기억의 저장소에서 너의 언어를 배워왔다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:103
translate kr qst_FromAnotherWorld_GoToMarkusHouse_2637d9a3:

    # MARKUS "W-What are you?"
    MARKUS "무-무엇이지?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:104
translate kr qst_FromAnotherWorld_GoToMarkusHouse_52f48309:

    # MARKUS "What are you doing inside of us?"
    MARKUS "우리 안에서 뭘 하고 있는 거야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:105
translate kr qst_FromAnotherWorld_GoToMarkusHouse_061b5fe4:

    # WHITE "{i}No choice.{/i}"
    WHITE "{i}선택의 여지가 없었다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:106
translate kr qst_FromAnotherWorld_GoToMarkusHouse_a60c5b71:

    # BLACK "{i}No choice.{/i}"
    BLACK "{i}선택의 여지가 없었다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:107
translate kr qst_FromAnotherWorld_GoToMarkusHouse_b8e49765:

    # BLACK "{i}Must find a host or die... We cannot survive without one.{/i}"
    BLACK "{i}숙주를 찾거나 죽어야 한다... 숙주 없이는 살아남을 수 없다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:108
translate kr qst_FromAnotherWorld_GoToMarkusHouse_f36d192e:

    # MC @ talk "... You were the things that attached to us at the fort."
    MC @ talk "... 너희는 요새에서 우리에게 달라붙었던 그것들이었어."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:109
translate kr qst_FromAnotherWorld_GoToMarkusHouse_11191076:

    # WHITE "{i}Yes.{/i}"
    WHITE "{i}그래.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:110
translate kr qst_FromAnotherWorld_GoToMarkusHouse_1068949a:

    # WHITE "{i}We used our reserves of energy to return you to this city.{/i}"
    WHITE "{i}우리는 우리의 에너지 비축분을 사용해 너희를 이 도시로 돌려보냈다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:111
translate kr qst_FromAnotherWorld_GoToMarkusHouse_7990dc48:

    # BLACK "{i}Now we have recovered to an extent and we wish to communicate with you.{/i}"
    BLACK "{i}이제 우리는 어느 정도 회복했으며, 너희와 소통하고자 한다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:112
translate kr qst_FromAnotherWorld_GoToMarkusHouse_3609049d:

    # MC @ talk "Why is one of you white and the other black?"
    MC @ talk "왜 너희 중 하나는 흰색이고 다른 하나는 검은색이지?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:113
translate kr qst_FromAnotherWorld_GoToMarkusHouse_f74462d3:

    # WHITE "{i}We are different strains of the same species.{/i}"
    WHITE "{i}우리는 같은 종의 다른 계통이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:114
translate kr qst_FromAnotherWorld_GoToMarkusHouse_5416e6b1:

    # BLACK "{i}We are different in many ways, yet the same in many others.{/i}"
    BLACK "{i}우리는 많은 면에서 다르지만, 다른 많은 면에서는 같다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:115
translate kr qst_FromAnotherWorld_GoToMarkusHouse_7e05aa22:

    # MARKUS "... W-What do you want from us?"
    MARKUS "... 우-우리에게서 뭘 원하는 거야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:116
translate kr qst_FromAnotherWorld_GoToMarkusHouse_0dfe344b:

    # BLACK "{i}As we speak... we are travelling up your nervous system to complete the infection of your cerebral cortex.{/i}"
    BLACK "{i}우리가 말을 나누는 동안... 우리는 너희의 신경계를 타고 올라가 대뇌 피질의 감염을 완료하고 있다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:117
translate kr qst_FromAnotherWorld_GoToMarkusHouse_bdfe7a0e:

    # WHITE "{i}Once this is complete, the host shall be in our control.{/i}"
    WHITE "{i}이것이 완료되면, 숙주는 우리의 통제 하에 놓이게 된다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:118
translate kr qst_FromAnotherWorld_GoToMarkusHouse_49579012:

    # MC @ talk "You— You’re killing us?!"
    MC @ talk "너— 너 우릴 죽이는 거야?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:119
translate kr qst_FromAnotherWorld_GoToMarkusHouse_a2d2271f:

    # MARKUS "You said you meant us no harm!"
    MARKUS "너 해를 끼치지 않겠다고 말했잖아!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:120
translate kr qst_FromAnotherWorld_GoToMarkusHouse_420bcbe2:

    # BLACK "{i}We do not... This function is an autonomic response.{/i}"
    BLACK "{i}그렇지 않다... 이 기능은 자율 반응이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:121
translate kr qst_FromAnotherWorld_GoToMarkusHouse_c884cc99:

    # MC @ talk "A what now?"
    MC @ talk "뭐라고?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:122
translate kr qst_FromAnotherWorld_GoToMarkusHouse_5e7aad89:

    # WHITE "{i}We cannot prevent or stop it any more than you could will your heart to stop.{/i}"
    WHITE "{i}네가 네 심장을 의지로 멈출 수 없는 것과 마찬가지로, 우리도 이를 막거나 멈출 수 없다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:123
translate kr qst_FromAnotherWorld_GoToMarkusHouse_728306f3:

    # MC @ talk "Then how are you going to help us?"
    MC @ talk "그럼 우리를 어떻게 도울 건데?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:124
translate kr qst_FromAnotherWorld_GoToMarkusHouse_e4b05d3e:

    # BLACK "{i}Our autonomic response occurs when the primary function is not being met.{/i}"
    BLACK "{i}우리의 자율 반응은 주요 기능이 충족되지 않을 때 발생한다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:125
translate kr qst_FromAnotherWorld_GoToMarkusHouse_31f802db:

    # BLACK "{i}A lack of viable breeding hosts.{/i}"
    BLACK "{i}생존 가능한 번식 숙주의 부족.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:126
translate kr qst_FromAnotherWorld_GoToMarkusHouse_8ad95643:

    # MARKUS "What?! What are you talking about?"
    MARKUS "뭐?! 무슨 소릴 하는 거야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:127
translate kr qst_FromAnotherWorld_GoToMarkusHouse_28072495:

    # WHITE "{i}The autonomic response can be halted or even regress when this function is met.{/i}"
    WHITE "{i}이 기능이 충족되면 자율 반응은 중단되거나 심지어 퇴행할 수 있다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:128
translate kr qst_FromAnotherWorld_GoToMarkusHouse_45c7fd19:

    # BLACK "{i}Breeding triggers a chemical reaction that informs us the needs of the hive are being met.{/i}"
    BLACK "{i}번식은 군집의 필요가 충족되고 있음을 우리에게 알리는 화학 반응을 촉발한다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:129
translate kr qst_FromAnotherWorld_GoToMarkusHouse_a0065923:

    # BLACK "{i}The autonomic response from mating is one that reduces us to a more feral, but incredibly powerful state.{/i}"
    BLACK "{i}교미로 인한 자율 반응은 우리를 더 야생적이지만, 믿을 수 없을 정도로 강력한 상태로 축소시킨다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:130
translate kr qst_FromAnotherWorld_GoToMarkusHouse_5942f1a0:

    # BLACK "{i}It is designed only to aid a dying hive.{/i}"
    BLACK "{i}그것은 오직 죽어가는 군집을 돕기 위해 설계되었다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:131
translate kr qst_FromAnotherWorld_GoToMarkusHouse_0649121c:

    # MC @ talk "Hive? Are you some kind of bug or something?"
    MC @ talk "군집? 너 무슨 벌레 같은 거야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:132
translate kr qst_FromAnotherWorld_GoToMarkusHouse_2db601d1:

    # WHITE "{i}We are both a symbiotic and parasitic race.{/i}"
    WHITE "{i}우리는 공생이자 기생 종족이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:133
translate kr qst_FromAnotherWorld_GoToMarkusHouse_3e58b722:

    # BLACK "{i}We have no name.{/i}"
    BLACK "{i}우리에게는 이름이 없다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:134
translate kr qst_FromAnotherWorld_GoToMarkusHouse_b73cec58:

    # WHITE "{i}We instil upon our hosts enhanced traits, you may have already noticed a drastic increase of muscle tissue in your body.{/i}"
    WHITE "{i}우리는 숙주에게 강화된 특성을 부여한다. 너는 이미 네 몸의 근육 조직이 급격히 증가한 것을 눈치챘을 것이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:135
translate kr qst_FromAnotherWorld_GoToMarkusHouse_84d9a782:

    # MARKUS "So... let me get this straight..."
    MARKUS "그러니까... 정리 좀 해볼게..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:136
translate kr qst_FromAnotherWorld_GoToMarkusHouse_4a5ff0ab:

    # MARKUS "It’s either fuck or die?"
    MARKUS "하거나 아니면 죽거나인 거야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:137
translate kr qst_FromAnotherWorld_GoToMarkusHouse_8b662edd:

    # BLACK "{i}... This analysis is primitive but correct.{/i}"
    BLACK "{i}... 이 분석은 원시적이지만 정확하다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:138
translate kr qst_FromAnotherWorld_GoToMarkusHouse_96ac6875:

    # WHITE "{i}The hive must survive.{/i}"
    WHITE "{i}군집은 살아남아야 한다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:139
translate kr qst_FromAnotherWorld_GoToMarkusHouse_36733e27:

    # BLACK "{i}The hive must {b}always{/b} survive.{/i}"
    BLACK "{i}군집은 {b}반드시{/b} 살아남아야 한다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:140
translate kr qst_FromAnotherWorld_GoToMarkusHouse_4ad788ff:

    # MARKUS "Well, what if we just try cut you both out?"
    MARKUS "그럼, 그냥 너희 둘을 잘라내면 어쩌지?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:141
translate kr qst_FromAnotherWorld_GoToMarkusHouse_6672d803:

    # "I gaped at Markus, incredulous at his stupidity, he just shrugged in my direction."
    "그 어리석음이 믿기지 않아 마커스를 입을 벌리고 바라봤다. 그는 그저 내 쪽으로 어깨를 으쓱였다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:142
translate kr qst_FromAnotherWorld_GoToMarkusHouse_a318fd77:

    # "In that same moment, both me and Markus felt a sharp pain in our hearts, like something was tightening around them, restricting the space in which they had to beat."
    "바로 그 순간, 나와 마커스 둘 다 심장에 날카로운 통증을 느꼈다. 무언가가 심장을 조여, 뛰어야 할 공간을 제약하는 듯했다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:143
translate kr qst_FromAnotherWorld_GoToMarkusHouse_65c71e17:

    # WHITE "{i}Without a host, we will die.{/i}"
    WHITE "{i}숙주가 없으면, 우리는 죽는다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:144
translate kr qst_FromAnotherWorld_GoToMarkusHouse_b3ba7ad2:

    # BLACK "{i}If we die, the hive dies.{/i}"
    BLACK "{i}우리가 죽으면, 군집도 죽는다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:145
translate kr qst_FromAnotherWorld_GoToMarkusHouse_95870c13:

    # WHITE "{i}And the hive must always survive.{/i}"
    WHITE "{i}그리고 군집은 반드시 살아남아야 한다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:146
translate kr qst_FromAnotherWorld_GoToMarkusHouse_25e81cc2:

    # BLACK "{i}Attempting to remove us will be treated as an act of aggression.{/i}"
    BLACK "{i}우리를 제거하려는 시도는 공격 행위로 간주될 것이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:147
translate kr qst_FromAnotherWorld_GoToMarkusHouse_9288eda9:

    # BLACK "{i}We will defend ourselves.{/i}"
    BLACK "{i}우리는 스스로를 방어할 것이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:148
translate kr qst_FromAnotherWorld_GoToMarkusHouse_e05c4e15:

    # MARKUS "But then if you kill us! You’ll die!"
    MARKUS "하지만 그러면 우리를 죽이면! 너도 죽을 거야!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:149
translate kr qst_FromAnotherWorld_GoToMarkusHouse_63fc53f3:

    # WHITE "{i}This analysis is correct... But if you were to attempt to cut us out we would have nothing to lose, so hopefully this shall suffice to dissuade you from attempting to forcibly remove us.{/i}"
    WHITE "{i}이 분석은 정확하다... 하지만 만약 우리를 잘라내려고 시도한다면 우리는 잃을 게 없다. 그러니 이것이 강제로 우리를 제거하려는 시도를 단념시키기에 충분하길 바란다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:150
translate kr qst_FromAnotherWorld_GoToMarkusHouse_462191c8:

    # "The pain in our chests ceased as they loosened their grip."
    "그들이 손을 풀자 우리 가슴의 고통이 멈췄다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:151
translate kr qst_FromAnotherWorld_GoToMarkusHouse_0a626611:

    # MC @ talk "Tell me something... {i}*huff*{/i} ... why even tell us? Why not just let the autonomic response take over?"
    MC @ talk "하나 말해줘... {i}*헉*{/i} ... 왜 우리에게 말하는 거지? 그냥 자율 반응이 지배하게 두지 않고?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:152
translate kr qst_FromAnotherWorld_GoToMarkusHouse_20b89e14:

    # BLACK "{i}Sentience will be lost if we enter our feral stage.{/i}"
    BLACK "{i}야성화 단계에 들어가면 의식이 상실된다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:153
translate kr qst_FromAnotherWorld_GoToMarkusHouse_52a066a9:

    # WHITE "{i}It is death for us.{/i}"
    WHITE "{i}그것은 우리에게 죽음이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:154
translate kr qst_FromAnotherWorld_GoToMarkusHouse_af945d5e:

    # BLACK "{i}To enter the feral stage is a last resort for hive survival, it is a sacrifice of the individual.{/i}"
    BLACK "{i}야성화 단계에 들어가는 것은 군집 생존을 위한 최후의 수단이며, 개체의 희생이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:159
translate kr act1scene4menu_48cefb19:

    # BLACK "{i}We can release pheromones that aid in the act of attracting mates.{/i}"
    BLACK "{i}우리는 배우자를 유혹하는 데 도움이 되는 페로몬을 방출할 수 있다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:160
translate kr act1scene4menu_5384002a:

    # WHITE "{i}You may also transform into our secondary forms for combat or any other purposes you so wish.{/i}"
    WHITE "{i}너는 또한 전투나 네가 원하는 다른 목적을 위해 우리의 두 번째 형태로 변신할 수 있다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:161
translate kr act1scene4menu_b9f07923:

    # MC @ talk "We... We can change into what?"
    MC @ talk "약해."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:162
translate kr act1scene4menu_fd69c436:

    # BLACK "{i}Our secondary forms, they are optimal in the use of the primary functions, should you so require.{/i}"
    BLACK "{i}우리의 두 번째 형태는, 필요하다면 주요 기능을 사용하는 데 최적화되어 있다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:163
translate kr act1scene4menu_78508801:

    # MC @ talk "How do we change into your... secondary form?"
    MC @ talk "어떻게 너의... 두 번째 형태로 변해?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:164
translate kr act1scene4menu_f6b8d387:

    # BLACK "{i}It is like having another limb... Focus on using it and you will transform.{/i}"
    BLACK "{i}그것은 또 다른 팔다리를 가진 것과 같다... 사용하는 데 집중하면 변신할 것이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:165
translate kr act1scene4menu_1acd9b2d:

    # BLACK "{i}The first time will be painful.{/i}"
    BLACK "{i}처음에는 고통스러울 것이다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:169
translate kr act1scene4menu_e57cd7e3:

    # BLACK "{i}A week.{/i}"
    BLACK "{i}일주일.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:170
translate kr act1scene4menu_53822368:

    # MC @ talk "A week?! That’s it?"
    MC @ talk "일주일?! 그게 다야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:171
translate kr act1scene4menu_79e6c264:

    # BLACK "Mating reverses the feral process... Our species was genetically built to breed and multiply, failure to do so causes... Mutations."
    BLACK "교미는 야성화 과정을 되돌려... 우리 종족은 유전적으로 번식하고 증식하도록 만들어졌어, 그렇게 하지 않으면... 돌연변이가 발생해."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:175
translate kr act1scene4menu_1039e80d:

    # BLACK "{i}We do not remember.{/i}"
    BLACK "{i}우리는 기억하지 못한다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:176
translate kr act1scene4menu_e94eda9d:

    # MC @ talk "How do you not know?"
    MC @ talk "어떻게 모르지?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:177
translate kr act1scene4menu_24103354:

    # WHITE "{i}Such functions are not deemed necessary for survival... Only the primary function remains.{/i}"
    WHITE "{i}그러한 기능들은 생존에 필요하다고 여겨지지 않는다... 오직 주요 기능만이 남아 있다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:178
translate kr act1scene4menu_0a347215:

    # BLACK "{i}... And what we have assimilated from you.{/i}"
    BLACK "{i}...그리고 우리가 너에게서 동화한 것들.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:182
translate kr act1scene4menu_ea525212:

    # BLACK "{i}Yes...{/i}"
    BLACK "{i}그래...{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:185
translate kr act1scene4menu_eb3b32fe:

    # WHITE "{i}Work with us. Do not fight us.{/i}"
    WHITE "{i}우리와 함께하라. 우리와 싸우지 마라.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:186
translate kr act1scene4menu_f9cff37b:

    # BLACK "{i}There are many benefits to a relationship such as this one.{/i}"
    BLACK "{i}이런 관계에는 많은 이점이 있다.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:187
translate kr act1scene4menu_531a0dc0:

    # WHITE "{i}Rest is needed now...{/i}"
    WHITE "{i}이제 휴식이 필요하다...{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:188
translate kr act1scene4menu_fbd8fa7c:

    # BLACK "{i}Yes... More rest.{/i}"
    BLACK "{i}그래... 더 많은 휴식.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:189
translate kr act1scene4menu_f7c46184:

    # "The voices fell silent."
    "목소리들이 조용해졌다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:190
translate kr act1scene4menu_1657b476:

    # "Ever so slowly, the things retreated back into our chests and, eventually, our breathing calmed and our hearts stopped threatening to shudder to a stop."
    "아주 천천히, 그것들은 우리 가슴 속으로 다시 물러갔고, 마침내 호흡은 가라앉고 심장이 멎을 듯 위협하던 것도 멈추었다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:195
translate kr act1scene4menu_6d707ebd:

    # MARKUS "... Hello?"
    MARKUS  "... 여보세요?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:196
translate kr act1scene4menu_815cee38:

    # MARKUS "HELLO!"
    MARKUS "안녕하세요!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:197
translate kr act1scene4menu_07bb4f4f:

    # MARKUS "This... This is madness!"
    MARKUS "이건... 이건 미친 짓이야!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:198
translate kr act1scene4menu_6bd8cdd7:

    # MC @ talk "... Markus... You heard them."
    MC @ talk "... 마커스... 너도 들었잖아."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:200
translate kr act1scene4menu_e3cd0bf4:

    # "Before Markus could veer off into some screaming rant, the door swung open and Skallion peered in."
    "마커스가 소리 지르는 rant로 빠지기도 전에, 문이 활짝 열리고 스칼리온이 안을 들여다봤다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:204
translate kr act1scene4menu_5cead7ae:

    # SKALLION "What’s going on in here?"
    SKALLION "여기서 무슨 일이야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:205
translate kr act1scene4menu_da0afb61:

    # SKALLION "What you both wailing about?"
    SKALLION "너희 둘 뭐 때문에 울부짖는 거야?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:206
translate kr act1scene4menu_c7d2ca96:

    # MC @ talk "I— We were just leaving, right, Markus?"
    MC @ talk "나— 우리 막 떠나려던 참이었어, 그렇지 마커스?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:208
translate kr act1scene4menu_91516288:

    # "Markus hesitated, I could see his mind racing as I caught his glance."
    "마커스는 망설였다. 내가 그의 시선을 붙잡았을 때 그의 머릿속이 빠르게 회전하는 걸 볼 수 있었다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:209
translate kr act1scene4menu_b7ac5572:

    # MARKUS "I... Yes, let's go, [player_name!t]."
    MARKUS "나... 그래, 가자, [player_name!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:212
translate kr act1scene4menu_4145fea3:

    # "Skallion took a step into the room and scrutinised us both."
    "스칼리온은 방으로 한 걸음 들어서서 우리 둘을 면밀히 살폈다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:214
translate kr act1scene4menu_6fbdac84:

    # SKALLION "You two look like you’ve seen a bloody ghost!"
    SKALLION "너희 둘 마치 유령이라도 본 것 같잖아!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:215
translate kr act1scene4menu_52fc1cce:

    # MARKUS "Don't worry, it's nothing."
    MARKUS "걱정 마, 아무것도 아니야."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:216
translate kr act1scene4menu_1139a12b:

    # MARKUS "Let's go, [player_name!t]."
    MARKUS "가자, [player_name!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:218
translate kr act1scene4menu_aa200a6b:

    # "Before I could reply, Markus stormed out of the house."
    "대답하기도 전에, 마커스가 집 밖으로 뛰쳐나갔다."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:219
translate kr act1scene4menu_0123a36d:

    # MC @ talk "Umm, nice seeing you again, Skallion..."
    MC @ talk "음, 다시 만나서 반가워, 스칼리온..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:220
translate kr act1scene4menu_f160fbfb:

    # MC @ talk "I should go."
    MC @ talk "가야겠어."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:223
translate kr act1scene4menu_62022b11:

    # SKALLION "Hmph."
    SKALLION  "흥."

