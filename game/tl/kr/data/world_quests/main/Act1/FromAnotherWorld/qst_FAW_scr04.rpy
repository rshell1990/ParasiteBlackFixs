translate kr qst_FromAnotherWorld_GoToValleyWithMarkus_b4e00217:

    # MARKUS "You never told us what you’re doing all the way out here."
    MARKUS "여기까지 와서 뭘 하는지 말 안 했잖아."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:434
translate kr qst_FromAnotherWorld_GoToValleyWithMarkus_8787c2d8:

