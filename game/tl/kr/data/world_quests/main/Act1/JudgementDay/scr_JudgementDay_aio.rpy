# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2334
translate kr qst_JudgementDay_SiegeOverPrison_ReginaVisit_407ed983:

    # REGINA @ sad "You know who I am... I'm still the same person I've always been."
    REGINA @ sad "내가 누군지 알잖아... 난 여전히 예전 그대로의 사람이야."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2335
translate kr qst_JudgementDay_SiegeOverPrison_ReginaVisit_38cab1e6:

    # MC @ angry "Don't lie to me! Not anymore!"
    MC @ angry "속이지 마! 더 이상은 안 돼!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2336
