translate kr qst_JudgementDay_TrialStart_SummonMenu_98992faf:

    # MARION @ smile "Your honor, I formally request that Sister Divine's testimony be stripped from the record."
    MARION @ smile "판사님, 저는 정식으로 디바인 수녀님의 증언을 기록에서 제외할 것을 요청합니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3012
translate kr qst_JudgementDay_TrialStart_SummonMenu_b7017868:

    # DIVINE @ angry "WILL I BE ALLOWED TO SPEAK FOR MYSELF?"
    DIVINE @ angry "나를 위해 말할 기회는 주실 겁니까?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3013
translate kr qst_JudgementDay_TrialStart_SummonMenu_f3faa976:

    # JUDGE_FALWIND "Sister Divine, please answer the question clearly and directly."
    JUDGE_FALWIND "디바인 수녀님, 질문에 명확하고 직접적으로 답변해 주십시오."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3014
translate kr qst_JudgementDay_TrialStart_SummonMenu_f6d6475a:

    # JUDGE_FALWIND "Do you know the defendant carnally?"
    JUDGE_FALWIND "피고와 육체적 관계를 가진 적이 있습니까?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3015
translate kr qst_JudgementDay_TrialStart_SummonMenu_e77266f2:

    # DIVINE @ angry "It's not illegal for a mage of Palam to—"
    DIVINE @ angry "팔람의 마법사가 —하는 건 불법이 아니야."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3016
translate kr qst_JudgementDay_TrialStart_SummonMenu_c03f04ee:

    # JUDGE_FALWIND "Sister Divine."
    JUDGE_FALWIND "디바인 수녀."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3017
translate kr qst_JudgementDay_TrialStart_SummonMenu_c3bd00f9:

    # JUDGE_FALWIND "The question. Please."
    JUDGE_FALWIND "질문을. 부탁드립니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3018
translate kr qst_JudgementDay_TrialStart_SummonMenu_4480da11:

    # DIVINE @ sad "... Y-Yes."
    DIVINE @ sad "... 그-그래."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3019
translate kr qst_JudgementDay_TrialStart_SummonMenu_55e5c120:

    # DIVINE @ shock "BUT—"
    DIVINE @ shock "배심원단이 분노로 폭발했다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3022
translate kr qst_JudgementDay_TrialStart_SummonMenu_f5658d09:

    # "The gavel came crashing down."
    "의사봉이 내려쳐졌다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3023
translate kr qst_JudgementDay_TrialStart_SummonMenu_56925272:

    # JUDGE_FALWIND "I am sorry, Sister Divine, but I must strip your testimony from the trial."
    JUDGE_FALWIND "죄송합니다, 디바인 수녀님, 하지만 당신의 증언을 재판에서 배제해야 합니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3024
translate kr qst_JudgementDay_TrialStart_SummonMenu_55ff70ff:

    # JUDGE_FALWIND "And further condemn the wickedness of the defendant for his most cruel seduction!"
    JUDGE_FALWIND "그리고 피고의 가장 잔혹한 유혹에 대한 사악함을 더욱 규탄합니다!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3026
translate kr qst_JudgementDay_TrialStart_SummonMenu_e97c0e18:

    # DIVINE @ angry "I HAVE A VOICE!"
    DIVINE @ angry "나도 목소리가 있어!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3027
translate kr qst_JudgementDay_TrialStart_SummonMenu_e9d288dd:

    # DIVINE @ angry "It is not a crime for me to lay with a man, and I am not some foolish woman who would let it sway my opinion in ANY court!"
    DIVINE @ angry "내가 남자와 잠자리하는 건 범죄가 아니며, 나는 어떤 법정에서든 그것이 내 의견을 흔들리게 내버려둘 어리석은 여자가 아니야!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3028
translate kr qst_JudgementDay_TrialStart_SummonMenu_066c1dc6:

    # DIVINE @ angry "They fought bravely! They—"
    DIVINE @ angry "그들은 용감하게 싸웠어! 그들은—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3029
translate kr qst_JudgementDay_TrialStart_SummonMenu_f7962c4a:

    # JUDGE_FALWIND "That's enough, Sister Divine."
    JUDGE_FALWIND "그것으로 충분합니다, 디바인 수녀님."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3030
translate kr qst_JudgementDay_TrialStart_SummonMenu_884fdc51:

    # JUDGE_FALWIND "It is clear you are not thinking clearly, and your testimony remains stripped."
    JUDGE_FALWIND "당신이 제정신이 아닌 게 분명하며, 당신의 증언은 계속 배제됩니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3031
translate kr qst_JudgementDay_TrialStart_SummonMenu_66900a42:

    # JUDGE_FALWIND "Now please, Sister, I do not wish to have the guards forcibly remove you from the stand..."
    JUDGE_FALWIND "이제 제발, 수녀님, 경비병들이 강제로 증인석에서 끌어내게 하고 싶지 않습니다…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3033
translate kr qst_JudgementDay_TrialStart_SummonMenu_b24898f9:

    # "Sister Divine opened her mouth to protest, but stopped herself."
    "디바인 수녀는 항의하려 입을 열었지만, 스스로 멈췄다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3034
translate kr qst_JudgementDay_TrialStart_SummonMenu_af52441c:

    # "Burning with shame and rage, her emotions silenced by the court, she turned away and left the stand."
    "수치심과 분노로 불타며, 그녀의 감정은 법정에 의해 침묵당했고, 그녀는 돌아서서 증인석을 떠났다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3035
translate kr qst_JudgementDay_TrialStart_SummonMenu_6fc0de19:

    # "Her eyes met mine—a flicker of anger, then sorrow, before she looked away."
    "눈이 마주쳤다—분노의 스침, 이내 슬픔, 그리고 시선을 돌렸다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3036
translate kr qst_JudgementDay_TrialStart_SummonMenu_0beb578c:

    # JUDGE_FALWIND "Now then, let us proceed..."
    JUDGE_FALWIND "자 그럼, 진행하자…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3038
translate kr qst_JudgementDay_TrialStart_SummonMenu_8bb4924e:

    # MARION @ talk "No, your honor."
    MARION @ talk "아닙니다, 판사님."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3044
translate kr qst_JudgementDay_TrialStart_SummonMenu_46f91a75:

    # "The court doors swung open, and Lady Sophira Marginott entered, her posture regal and her expression unreadable."
    "법정 문이 열리고, 소피라 마지노트 영애가 당당한 자세와 읽을 수 없는 표정으로 들어섰다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3046
translate kr qst_JudgementDay_TrialStart_SummonMenu_f4199cc1:

    # JUDGE_FALWIND "Lady Marginott, the court trusts you are well?"
    JUDGE_FALWIND "마지노트 부인, 법정은 당신이 건강하시길 바랍니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3047
translate kr qst_JudgementDay_TrialStart_SummonMenu_6627355c:

    # SOPHIRA @ talk "I am, my lord."
    SOPHIRA @ talk "그렇습니다, 각하."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3048
translate kr qst_JudgementDay_TrialStart_SummonMenu_8fa4ab23:

    # JUDGE_FALWIND "The defense has summoned you as a witness. Will you recount the events of the siege?"
    JUDGE_FALWIND "변호 측이 당신을 증인으로 소환했습니다. 공성전의 사건을 진술해 주시겠습니까?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3049
translate kr qst_JudgementDay_TrialStart_SummonMenu_f9279766:

    # SOPHIRA @ talk "Of course, if the court so pleases."
    SOPHIRA @ talk "물론, 법정이 원하신다면."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3051
translate kr qst_JudgementDay_TrialStart_SummonMenu_e53b8418:

    # "Lady Marginott recounted the horrific ordeal of the siege, detailing the chaos and bloodshed."
    "마지넛 부인은 공성전의 끔찍한 시련을 자세히 이야기하며, 혼란과 유혈 사태를 상세히 설명했다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3052
translate kr qst_JudgementDay_TrialStart_SummonMenu_c4a0ec18:

    # "Then, she arrived at the moment she met us."
    "그러자, 그녀가 우리를 만난 순간에 도착했다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3057
translate kr qst_JudgementDay_TrialStart_SummonMenu_fb01e9b0:

    # SOPHIRA @ sad "I must admit..."
    SOPHIRA @ sad "인정해야겠군..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3058
translate kr qst_JudgementDay_TrialStart_SummonMenu_1f5d00ec:

    # SOPHIRA @ sad "When I first laid eyes upon them, I thought them monsters."
    SOPHIRA @ sad "그녀를 보려고 뒤를 돌아봤을 때, 그녀는 다른 신병들과 대화하고 있었다. 내 시선은 그녀의 엉덩이를 한참 들여다보며 그녀의 몸매를 따라 내려갔다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3059
translate kr qst_JudgementDay_TrialStart_SummonMenu_ae2b4e4f:

    # SOPHIRA @ sad "I believed they had come to kill us all."
    SOPHIRA @ sad "그들이 우리 모두를 죽이러 왔다고 믿었다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3060
translate kr qst_JudgementDay_TrialStart_SummonMenu_92fdc9f7:

    # SOPHIRA @ sad "... But—"
    SOPHIRA @ sad "... 하지만—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3061
translate kr qst_JudgementDay_TrialStart_SummonMenu_b3423dae:

    # "Sophira hesitated, scanning the room."
    "소피라는 망설이며 방을 훑어보았다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3062
translate kr qst_JudgementDay_TrialStart_SummonMenu_56b7a1e0:

    # "Praising a monster? Even one who saved her?"
    "괴물을 칭찬한다고? 그녀를 구했어도?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3063
translate kr qst_JudgementDay_TrialStart_SummonMenu_3bd900e6:

    # "The scandal alone could ruin her standing."
    "그 스캔들만으로도 그녀의 입지가 무너질 수 있다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3064
translate kr qst_JudgementDay_TrialStart_SummonMenu_c7e4c791:

    # SOPHIRA @ talk "They fought as bravely, and as valiantly, as any knight in the realm."
    SOPHIRA @ talk "그들은 왕국의 어떤 기사들만큼이나 용감하게, 영웅답게 싸웠다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3065
translate kr qst_JudgementDay_TrialStart_SummonMenu_25e4778c:

    # "A ripple of murmurs spread through the court."
    "중얼거림의 물결이 법정으로 퍼져나갔다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3066
translate kr qst_JudgementDay_TrialStart_SummonMenu_a029fa91:

    # "A noblewoman... speaking on behalf of a monster?"
    "귀족 여인이... 괴물을 대변한다고?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3067
translate kr qst_JudgementDay_TrialStart_SummonMenu_6635e292:

    # SOPHIRA @ talk "I can scarcely believe that the men before me today are the same creatures from that night."
    SOPHIRA @ talk "오늘 내 앞에 있는 이들이 그날 밤의 그 생명체들과 같다고 거의 믿기지 않아."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3068
translate kr qst_JudgementDay_TrialStart_SummonMenu_9b76c90d:

    # SOPHIRA @ talk "But I would take stock of their courage before rendering judgment."
    SOPHIRA @ talk "귀족 여인이... 괴물을 대변한다고?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3069
translate kr qst_JudgementDay_TrialStart_SummonMenu_3db56853:

    # JUDGE_FALWIND "Thank you, Lady Marginott."
    JUDGE_FALWIND "감사합니다, 마지노트 영애."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3071
translate kr qst_JudgementDay_TrialStart_SummonMenu_da6a8e90:

    # JUDGE_FALWIND "Does the prosecution have any questions for the witness?"
    JUDGE_FALWIND "검찰 측에 증인에게 할 질문이 있습니까?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3072
translate kr qst_JudgementDay_TrialStart_SummonMenu_b7f6f1a5:

    # MARION @ angry "... No, your honor."
    MARION @ angry "... 아닙니다, 재판장님."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3073
translate kr qst_JudgementDay_TrialStart_SummonMenu_68cdad91:

    # MARION @ talk "None at this time."
    MARION @ talk "지금은 없습니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3074
translate kr qst_JudgementDay_TrialStart_SummonMenu_2002683a:

    # JUDGE_FALWIND "Then the witness is dismissed."
    JUDGE_FALWIND "그럼 증인은 퇴정하십시오."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3076
translate kr qst_JudgementDay_TrialStart_SummonMenu_577ae9c6:

    # "With a final nod, Lady Marginott left the stand, casting me a sympathetic smile before stepping away."
    "마지막 포효와 함께, 나는 폭발했다—샤니의 창자를 내 두꺼운 정액으로 가득 채우며."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3082
translate kr qst_JudgementDay_TrialStart_SummonMenu_0eca602a:

    # MARION @ angry "Hold."
    MARION @ angry "기다려."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3083
translate kr qst_JudgementDay_TrialStart_SummonMenu_8f35c0bf:

    # MARION @ angry "I object to this witness's testimony."
    MARION @ angry "이 증인의 증언에 이의를 제기합니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3084
translate kr qst_JudgementDay_TrialStart_SummonMenu_53e4fd5b:

    # JUDGE_FALWIND "On what grounds?"
    JUDGE_FALWIND "무슨 근거로?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3085
translate kr qst_JudgementDay_TrialStart_SummonMenu_717b7ab4:

    # MARION @ talk "The witness is a childhood friend of the accused and has openly admitted to harboring deep affections for him."
    MARION @ talk "증인은 피고인의 소꿉친구이며 그에게 깊은 애정을 품고 있음을 공개적으로 인정했다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3086
translate kr qst_JudgementDay_TrialStart_SummonMenu_1a2207ce:

    # MARION @ talk "Any testimony she delivers is undoubtedly tainted by personal bias."
    MARION @ talk "마지막 포효와 함께, 나는 폭발했다—샤니의 창자를 내 두꺼운 정액으로 가득 채우며."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3087
translate kr qst_JudgementDay_TrialStart_SummonMenu_19bd6b31:

    # MARION @ talk "Furthermore, she is a commoner. Are we truly to weigh the words of a commoner against the ruling elite of this court?"
    MARION @ talk "게다가 그녀는 평민입니다. 과연 평민의 말을 이 법정의 지배 계층 엘리트와 맞비교해야 하겠습니까?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3088
translate kr qst_JudgementDay_TrialStart_SummonMenu_3b8bd5f1:

    # JUDGE_FALWIND "...Hmm."
    JUDGE_FALWIND "…흠."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3089
translate kr qst_JudgementDay_TrialStart_SummonMenu_9ec36590:

    # JUDGE_FALWIND "I must rule in favor of the prosecution."
    JUDGE_FALWIND "검찰 측에 유리하게 판결해야 합니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3090
translate kr qst_JudgementDay_TrialStart_SummonMenu_f8f7a27e:

    # JUDGE_FALWIND "The court will not hear from Ms. Adara today."
    JUDGE_FALWIND "법정은 오늘 아다라 양의 증언을 듣지 않을 것입니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3092
translate kr qst_JudgementDay_TrialStart_SummonMenu_31befe5e:

    # JUDGE_FALWIND "Does the defense have another witness to call?"
    JUDGE_FALWIND "변호인 측에 다른 증인이 있습니까?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3098
translate kr qst_JudgementDay_TrialStart_SummonMenu_ca5239c7:

    # MARION @ angry "Objection, your honor!"
    MARION @ angry "이의 있습니다, 판사님!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3099
translate kr qst_JudgementDay_TrialStart_SummonMenu_37cf1448:

    # MARION @ talk "Only Alderian citizens may give testimony in a trial of this magnitude."
    MARION @ talk "이 정도 규모의 재판에서는 알더레이 시민만이 증언할 수 있습니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3100
translate kr qst_JudgementDay_TrialStart_SummonMenu_84eb541e:

    # MARION @ talk "And the opinion of a Ramonian whore is hardly worth considering."
    MARION @ talk "그리고 라모니아 창녀의 의견은 고려할 가치조차 없다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3101
translate kr qst_JudgementDay_TrialStart_SummonMenu_a9215bab:

    # JUDGE_FALWIND "Agreed. I cannot allow a foreigner to testify in this court."
    JUDGE_FALWIND "동의합니다. 이 법정에서 외국인의 증언을 허용할 수 없습니다."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3103
translate kr qst_JudgementDay_TrialStart_SummonMenu_78fc9297:

    # JUDGE_FALWIND "Does the defense have a different witness to call forth?"
    JUDGE_FALWIND "변호인 측에 다른 증인을 소환할 분이 있습니까?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3107
translate kr qst_JudgementDay_TrialStart_SummonMenu_ce31a9d3:

