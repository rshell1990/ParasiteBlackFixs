    MC @ surprised "그럼 사실이군…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2347
translate kr qst_JudgementDay_SiegeOverPrison_ReginaVisit_fac91196:

