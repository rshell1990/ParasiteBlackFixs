# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2327
translate kr qst_JudgementDay_SiegeOverPrison_ReginaVisit_dc72f708:

    # REGINA @ sad "You poor thing... You look like you're in so much pain."
