translate kr qst_bloodhound_3_toBasement_b9c6a5a9:

    # SECOND_MAGE "We need more time to prepare another charge!"
    SECOND_MAGE "다음 충전을 준비할 시간이 더 필요해요!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:258
translate kr qst_bloodhound_3_toBasement_fdeb4bdc:

