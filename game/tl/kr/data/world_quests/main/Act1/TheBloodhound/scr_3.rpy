translate kr qst_bloodhound_3_toBasement_03084257:

    # MAGE "But... What about the other one?"
    MAGE "하지만... 다른 건 어떻게 하죠?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:223
translate kr qst_bloodhound_3_toBasement_f1f00a2f:

    # NYX @ angry "Leave him!"
    NYX @ angry "그를 놔둬!"

