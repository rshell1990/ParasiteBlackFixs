# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1204
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_c18fa599:

    # "Once more, the Hive Lord broke his gaze from the black sea and stared toward me."
    "다시 한 번, 하이브 로드는 검은 바다에서 시선을 떼고 나를 향해 응시했다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1205
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_436bd99a:

    # HIVE_LORD "{b}Or could it be because you know your *true* feelings toward me would be laid bare for all to see?{/b}"
    HIVE_LORD "{b}아니면 자신의 나에 대한 *진짜* 감정이 모두에게 드러날 것을 알기 때문인가?{/b}"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1206
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_d9acc812:

    # SHYAHTAN "..."
    SHYAHTAN          "..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1207
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_044ee0d7:

    # SHYAHTAN "...Great Hive Lord, my true feelings for you are nothing but-"
    SHYAHTAN "...위대한 하이브 로드시여, 당신에 대한 제 진심은 오직-"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1208
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_c2888de1:

    # "For the faintest moment I paused, the words coming out awkwardly."
    "아주 미미한 순간 나는 멈칫했고, 말은 어색하게 흘러나왔다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1209
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_4c1502e6:

    # SHYAHTAN "{b}Loyalty and adoration.{/b}"
    SHYAHTAN "{b}충성과 숭배.{/b}"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1210
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_7a86e66e:

    # HIVE_LORD "..."
    HIVE_LORD "..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1211
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_aa95d732:

    # "The Great Hive Lord tilted his head forward once more."
    "위대한 하이브 로드는 다시 한 번 고개를 앞으로 기울였다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1212
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_5a555836:

    # HIVE_LORD "{i}Of course, Shyahtan... my greatest general.{/i}"
    HIVE_LORD "{i}물론이지, 샤이탄... 내 가장 위대한 장군.{/i}"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1213
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_c5a16420:

    # HIVE_LORD "Never have I doubted your loyalty."
    HIVE_LORD "네 충성을 의심한 적은 없었다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1214
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_b9e35433:

    # HIVE_LORD "{i}...Though some believe you are destined to become the new Hive Lord once I return to our great father.{/i}"
    HIVE_LORD "{i}...하지만 일부는 내가 위대한 아버지께 돌아가면 네가 새 하이브 로드가 될 운명이라 믿고 있지.{/i}"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1215
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_9cb9c1a8:

    # SHYAHTAN "Then give me these traitors' names and I will see to it my Zarpod feasts upon them."
    SHYAHTAN "그럼 그 반역자들의 이름을 내게 주시오. 내 자포드가 그들을 잡아먹게 하리다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1216
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_8ba529fe:

    # HIVE_LORD "...Do you remember the Hive Wars, Shyahtan?"
    HIVE_LORD "...하이브 전쟁을 기억하나, 샤이탄?"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1217
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_a3e3e6f7:

    # SHYAHTAN "Those of us who survived could never forget, Hive Lord."
    SHYAHTAN "살아남은 우리들 중 누구도 결코 잊을 수 없습니다, 하이브 로드시여."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1218
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_6810b3ed:

    # SHYAHTAN "{i}Do {b}you{/b} remember, Hive Lord, how we fought side by side to exterminate the rogue hive?{/i}"
    SHYAHTAN "{i}{b}당신{/b}은 기억하십니까, 하이브 로드시여, 우리가 불량 하이브를 박멸하기 위해 나란히 싸웠던 것을?{/i}"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1219
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_375ba8bb:

    # "The Hive Lord didn't answer."
    "하이브 로드는 대답하지 않았다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1220
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_f2942cf3:

    # "With a heavy sigh, he turned fully to face me."
    "가벼운 잔 부딪히는 소리와 함께, 우리 둘은 크게 한 모금 삼켰다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1221
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_ba3f361a:

    # HIVE_LORD "I have someone I wish for you to meet."
    HIVE_LORD "내게 자네가 만나주길 바라는 이가 있다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1222
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_eba7a4c2:

    # HIVE_LORD "A new strain I have helped develop."
    HIVE_LORD "내가 개발을 도운 새로운 변종."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1223
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_c887cb4f:

    # HIVE_LORD "I hope you will adopt him under your clan's banners for now."
    HIVE_LORD "지금은 자네 클랜의 깃발 아래 그를 받아주길 바라네."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1224
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_52a67e0e:

    # "The Hive Lord turned to his personal guard."
    "하이브 로드는 자신의 개인 경호원에게로 돌아섰다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1225
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_cbd3a895:

    # HIVE_LORD "Bring in Eight-Six-One."
    HIVE_LORD "861번을 들여라."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1226
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_d350cc90:

    # SHYAHTAN "One of your pet projects?"
    SHYAHTAN "당신의 애완 프로젝트 중 하나?"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1227
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_8c343811:

    # HIVE_LORD "{i}Something like that.{/i}"
    HIVE_LORD "{i}그런 거야.{/i}"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1231
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_6c73278f:

    # "As the fleshy spiral doors opened, a skinny, pale-white Terran approached."
    "살로 된 나선형 문이 열리자, 마르고 창백한 테란 하나가 다가왔다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1234
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_e5272129:

    # EIGHT_SIX_ONE "...G-Greetings, Lord Shyahtan."
    EIGHT_SIX_ONE "...안-안녕하십니까, 샤이탄 군주님."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1235
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_5f84324c:

    # MARKUS "WAKE UP!"
    MARKUS "일어나!"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1236
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_47333513:

    # SHYAHTAN "A white strain?"
    SHYAHTAN "백색 변종?"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1237
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_2daa1143:

    # SHYAHTAN "What is he-"
    SHYAHTAN "무슨-"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1238
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_6b39ce73:

    # "I felt the claws of the Hive Lord rest on my shoulder."
    "군집 군주의 발톱이 어깨에 내려앉았다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1239
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_6995b2a0:

    # HIVE_LORD "I will watch his performance with great interest, Lord Shyahtan."
    HIVE_LORD "그의 활약을 대단한 흥미로 지켜보겠습니다, 샤이탄 군주님."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1240
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_5f59a957:

    # "The skinny Terran offered a nervous, curt bow."
    "마른 테란인이 긴장한 채 짧게 고개를 숙였다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1243
translate kr qst_TheBeastOfNovaras_ReturnFromMerlanians_072968fa:

    # EIGHT_SIX_ONE "I am... at your s-service, my lord."
    EIGHT_SIX_ONE "저는... 당신의 시-시중을, 군주님."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1258
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_16665f31:

    # MARKUS "[player_name!t]!"
    MARKUS  "[player_name!t]!"

    # MARKUS "You have to... Ahh! WAKE UP!"
    MARKUS "일어나야... 아! 일어나!"
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1263
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_72bdb921:

    # "My eyes peeled open as I stared out at the carnage before me."
    "눈앞의 대학살을 응시하며 눈이 찢어지듯 열렸다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1264
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_dec204cd:

    # "The arena was drenched in blood as the Caltrack flailed; bodies and torn limbs littered the ground as people screamed."
    "투기장은 칼트랙이 날뛰며 피로 흠뻑 젖었다. 사람들이 비명을 지르는 가운데 시체와 찢긴 팔다리가 바닥에 널려 있었다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1265
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8a00a866:

    # "Even Sypha, usually smug and composed, was barking orders."
    "평소 의기양양하고 침착한 사이파조차 큰 소리로 명령을 내리고 있었다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1266
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_6fc3a72a:

    # "Staggering, bleeding, forcing the others to keep moving and fight."
    "비틀거리며, 피를 흘리며, 다른 이들이 계속 움직이고 싸우도록 강요하며."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1267
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_9d245642:

    # "Now, with the Caltrack's eyes fixed on her, Sypha's pupils widened; for the first time, I saw fear in her face."
    "이제, 칼트랙의 눈이 그녀에게 고정되자, 사이파의 동공이 확장됐다. 그녀의 얼굴에서 처음으로 두려움을 봤다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1268
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8a29f88d:

    # "Any moment, it would come crashing down on her and her exhausted body wouldn't move in time..."
    "언제라도, 그것이 그녀 위로 무너져 내릴 것이고, 지친 그녀의 몸은 제때 움직이지 못할 것이다..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1269
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_3226ef70:

    # "{i}...But something moved inside me now.{/i}"
    "{i}...하지만 이제 내 안에서 무언가 움직였다.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1270
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_b89032c8:

    # "I felt my whole body act on its own, rising as a hot surge of energy flooded through me."
    "온몸이 스스로 움직여 뜨거운 에너지가 온몸으로 밀려오며 일어섰다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1271
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_42819c2d:

    # "{i}What was going on?{/i}"
    "{i}무슨 일이 벌어지고 있었던 거야?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1273
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_aeaf7911:

    # "Moments ago, I was dying, and now..."
    "불과 몇 분 전까지만 해도 죽어가고 있었는데, 지금은..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1274
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_c8bf02ac:

    # "I sprang forward. Faster than before."
    "앞으로 튀어 나갔다. 전보다 더 빠르게."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1275
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_ad41bb57:

    # "Faster than I'd ever moved."
    "내가 움직여 본 그 어떤 때보다도 더 빨리."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1277
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f01b3c92:

    # "With a single motion, I swept Sypha from the sand and yanked her clear of the snapping jaws."
    "살짝 비웃으며, 에스메가 땅으로 몸을 낮췄다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1278
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8fa10aa1:

    # "She stared up at me, shock and disbelief warring in her eyes."
    "그녀가 나를 올려다봤다. 충격과 불신이 그녀의 눈 속에서 싸우고 있었다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1279
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_e3fb0534:

    # "I set her down gently and turned back to the Caltrack."
    "그녀를 부드럽게 내려놓고 칼트랙에게로 다시 돌아섰다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1280
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_4cfa3603:

    # "It snapped one of its many jaws toward me."
    "그것은 수많은 턱 중 하나를 나에게 확 물어뜯었다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1281
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_bb5a2503:

    # "A quick pivot carried me past it."
    "재빠른 회전으로 그것을 지나쳤다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1283
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f96435af:

    # "A tentacle latched on and punched through the creature's cheek as I flung myself into the air, crashing down onto one of its heads and driving my claws through its eye."
    "촉수 하나가 달라붙어 그 생물의 뺨을 뚫고 들어갔고, 나는 공중으로 몸을 날려 그 머리 중 하나에 충돌하며 내 발톱을 그 눈에 박아넣었다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1285
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8afbe17f:

    # "The beast bellowed, thrashing, a shriek so sharp the crowd clamped hands over ears."
    "야수가 울부짖으며 몸부림쳤다. 비명은 너무 날카로워 군중이 손으로 귀를 막았다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1286
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_30842b18:

    # "{i}I wasn't controlling my limbs.{/i}"
    "{i}내 팔다리를 내가 통제하고 있지 않았어.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1287
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_86951371:

    # "{i}I didn't even know I *could* move like this.{/i}"
    "{i}내가 이렇게 *움직일 수* 있다는 것조차 몰랐어.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1288
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_3c70e601:

    # "{i}What was happening?{/i}"
    "{i}무슨 일이 일어나고 있었던 거야?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1289
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8920d71f:

    # "I slid and rolled down, claws grinding through jelly and bone, carving the socket wide."
    "미끄러지듯 굴러 내려가며, 발톱이 젤리와 뼈를 갈아내며 소켓을 넓게 도려냈다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1290
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_8279394b:

    # "{i}Were my claws sharper?{/i}"
    "{i}내 발톱이 더 날카로웠나?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1291
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_87a7a085:

    # "{i}My muscles stronger?{/i}"
    "{i}내 근육이 더 강해졌다고?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1292
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_cc821a2e:

    # "Landing, I dragged my talons in a clean arc, severing the throat of one Caltrack head."
    "착지하면서, 발톱을 깔끔한 호를 그리며 끌어, 칼트랙 머리 하나의 목을 잘라냈다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1293
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_aec21242:

    # "It staggered back, one head limp, the others panicking."
    "그것은 비틀거리며 물러났다. 머리 하나는 축 늘어지고, 다른 것들은 공황 상태였다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1296
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_fcfb1fa6:

    # "In a last, desperate lunge, it charged."
    "마지막 필사적인 돌진으로, 달려들었다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1297
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_f8420303:

    # "I moved like lightning, {i}no{/i}, like something beyond it, hurling myself with my tentacles, a straight shot that punched clean through the Caltrack's chest and burst out its spine, leaving a gaping hole in my wake."
    "번개처럼, {i}아니{/i}, 그 너머의 무언가처럼 움직였다. 촉수로 나를 던져, 칼트랙의 가슴을 뚫고 척추를 터뜨리며 직선으로 관통해, 그 뒤로 거대한 구멍을 남겼다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1298
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_7c29366c:

    # "It's heads swayed in the air for a few moments, as though the creature itself was trying to understand what had just happened to it."
    "그 머리들이 허공에서 몇 순간 흔들렸다. 마치 그 생명체 자체가 방금 자신에게 무슨 일이 일어났는지 이해하려는 듯이."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1301
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_0de8f749:

    # "The creature tumbled lifelessly forward, smashing its heads against the wall, twitching in final spasms."
    "생명이 없는 채로 생물이 앞으로 굴러떨어지며, 벽에 머리를 박아 넣고 마지막 경련 속에 떨었다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1302
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_6af42d98:

    # "The crowds stared in stunned silence."
    "군중이 얼어붙어 침묵 속에 응시했다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1303
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_b1af4655:

    # "What had they just witnessed?"
    "그가 쓰러진 후 무슨 일이 있었지? 도망친 건가?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1304
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_5e9bc9b3:

    # "A monster that could fell armies not merely defeated but {i}eviscerated{/i}."
    "군대를 쓰러뜨릴 수 있는 괴물이 단순히 패배한 게 아니라 {i}완전히 절단{/i}당했다."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1305
translate kr qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_075d7561:

