# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:396
translate kr qst_TheBeastOfNovaras_ApproachArena_d4e7dccb:

    # SYPHA @ happy "We would most definitely be interested!"
    SYPHA @ happy "감히 그럴 용기가 없지."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:397
translate kr qst_TheBeastOfNovaras_ApproachArena_35607617:

    # SYPHA @ think "But I'm afraid my husband here would need a worthy patron!"
    SYPHA @ think "사이파가 나에게 살짝 몸을 스쳤다."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:398
translate kr qst_TheBeastOfNovaras_ApproachArena_9cdbb2ed:

