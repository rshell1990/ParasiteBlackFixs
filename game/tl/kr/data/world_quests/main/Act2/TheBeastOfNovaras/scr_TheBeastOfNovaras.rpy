# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:390
translate kr qst_TheBeastOfNovaras_ApproachArena_8858cde8:

    # YARRICK @ smile "For that, you have my voice and my venue."
    YARRICK @ smile "그 대가로, 내 지지와 장소를 약속하지."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:391
translate kr qst_TheBeastOfNovaras_ApproachArena_526d8220:

