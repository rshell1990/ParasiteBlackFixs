    SYPHA @ happy "너와 나."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2024
translate kr qst_TheBeastOfNovaras_TalkToGarenBar_f33904df:

