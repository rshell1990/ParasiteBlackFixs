    MC @ think "아... 뭐... 천만에, 그런 것 같네."
# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:392
translate kr qst_TheBeastOfNovaras_ApproachArena_5ea80cad:

    # YARRICK @ smile "I am Yarrick, matchmaker of mayhem, ringmaster of the red sands."
