# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:389
translate kr qst_TheBeastOfNovaras_ApproachArena_6981ad46:

    # YARRICK @ smile "Many still aren't sure what to make of you, but by saving Novaras, you saved a cousin of mine during the great siege."
