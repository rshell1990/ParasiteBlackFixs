# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:135
translate kr qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_49cf0693:

    # RECRUIT "{b}Aaaagh!!!{/b}"
    RECRUIT "{b}으아아악!!!{/b}"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:136
translate kr qst_ForgedInFire_EnterMedwardAfterHeadbuttLines_c20f5bef:

