    # BORRAS "Come, on me, you three."
    BORRAS "\"따라와, 내게 붙어, 너희 셋.\""

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:792
translate kr qst_TheDarkPass_LeaveCampToBurnedOutVillage_6c29bf7f:

    # "Before he could take off, the Captain stopped him sharply."
    "그가 이륙하기도 전에, 대장이 그를 날카롭게 멈춰 세웠다."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:793
translate kr qst_TheDarkPass_LeaveCampToBurnedOutVillage_8269f983:

    # DUPREY "Borras!"
    DUPREY "\"보라스!\""

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:794
translate kr qst_TheDarkPass_LeaveCampToBurnedOutVillage_7cec836a:

    # BORRAS "..."
    BORRAS  "..."

