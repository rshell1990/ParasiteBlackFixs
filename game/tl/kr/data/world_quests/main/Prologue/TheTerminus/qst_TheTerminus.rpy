translate kr qst_Terminus_PathBlockSebastian_86ce00c5:

    # MC "Oh, I'm on my way there."
    MC "아, 지금 가는 중입니다."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:301
translate kr qst_Terminus_PathBlockSebastian_b2c4cc1d:

    # "The guard observed me suspiciously as I moved on."
    "경비병은 내가 지나가는 것을 의심스럽게 지켜보았다."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:305
translate kr qst_Terminus_WalkIntoMarket_afeb28d0:

    # MC "This place is the heart of the city's commerce."
    MC "이곳은 도시 상업의 중심지다."

