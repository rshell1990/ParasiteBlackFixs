translate kr qst_Terminus_EnterPalace_5c3e3f1d:

    # MC "Capital... What?!"
    MC "\"수도... 뭐라고?!\""

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:524
translate kr qst_Terminus_EnterPalace_1d5e8c4b:

    # MC "I... {i}I’m going to the Scouts?{/i}"
    MC "\"나... {i}내가 정찰대라니?{/i}\""

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:525
translate kr qst_Terminus_EnterPalace_b8535060:

    # MC "... No... No! This is... This is wrong!"
    MC "\"... 아니... 안 돼! 이건... 이건 잘못됐어!\""

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:526
translate kr qst_Terminus_EnterPalace_20b35e97:

    # MC "I can’t be in the Scouts! This is..."
    MC "\"내가 정찰대라니 말도 안 돼! 이건...\""

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:530
translate kr qst_Terminus_EnterPalace_b1631114:

    # "Looking up, I hurried back over the stall, frantically trying to speak to the lady but was immediately restrained by the guards."
    "고개를 들어, 나는 급히 다시 부스로 달려가 그 여성에게 필사적으로 말을 걸려 했지만, 곧바로 경비병들에게 제지당했다."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:531
translate kr qst_Terminus_EnterPalace_5f57996f:

    # "Other students berated me for cutting the line."
    "다른 학생들은 내가 새치기했다며 호되게 비난했다."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:532
translate kr qst_Terminus_EnterPalace_170b6a29:

