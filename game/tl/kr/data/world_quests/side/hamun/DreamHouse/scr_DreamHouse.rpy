# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1971
translate kr qst_dreamhouse_l4_cellar_barrel_menu_16b646de:

    # "As the poison cleared, inside, I saw a key with a demon-shaped end."
    "독이 걷히자, 안쪽에 악마 모양 머리의 열쇠가 보였다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1977
translate kr qst_dreamhouse_l4_cellar_barrel_menu_11fb642b:

    # "Tearing open the barrel, I was confronted by... a giant eye?"
    "통을 찢어 열자, 나를 마주한 것은... 거대한 눈알?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1978
translate kr qst_dreamhouse_l4_cellar_barrel_menu_b02bbe39:

    # "The pupil frantically looked around before pushing itself out of the barrel."
    "동공이 미친 듯이 주변을 둘러보더니, 통 밖으로 밀려 나왔다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1981
translate kr qst_dreamhouse_l4_cellar_barrel_menu_8e30331e:

    # "The floating, tendriled creature suddenly lashed out!"
    "촉수가 달린 떠다니는 생명체가 갑자기 달려들었다!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1986
translate kr qst_dreamhouse_l4_cellar_barrel_menu_fe658d21:

    # "Dropping dead to the floor, its eye torn open by my blade, and inside it was... a demon-shaped key."
    "바닥에 쓰러져 죽고, 내 칼날에 찢긴 눈 안에는... 악마 모양의 열쇠가 있었다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1992
translate kr qst_dreamhouse_l4_cellar_barrel_menu_6aadb649:

    # "Opening up the barrel, a small burst of needles came flying out."
    "통을 열자, 작은 바늘들이 쏟아져 날아왔다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1993
translate kr qst_dreamhouse_l4_cellar_barrel_menu_d66c84a7:

    # "Shielding myself with my arm, a few of the pin-pricked fuckers still hit me."
    "팔로 막았지만, 그 바늘 같은 놈들 몇 개가 여전히 나를 찔렀다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1994
translate kr qst_dreamhouse_l4_cellar_barrel_menu_4e0c1dcd:

    # MC @ angry "GAHH!"
    MC @ angry "으아아!"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1995
translate kr qst_dreamhouse_l4_cellar_barrel_menu_f5fb20fe:

    # SYPHA @ angry "Careful..."
    SYPHA @ angry "조심해..."
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1997
translate kr qst_dreamhouse_l4_cellar_barrel_menu_be7da264:

    # "Inside, was a key with a demon-shaped end."
    "안에는, 악마 모양 머리의 열쇠가 있었다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2003
translate kr qst_dreamhouse_l4_cellar_barrel_menu_0e845315:

    # "Smashing open the barrel, a flock of birds screeched as they flew past me!"
    "통을 박살내자, 새 떼가 비명을 지르며 내 옆을 날아 지나갔다!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2004
translate kr qst_dreamhouse_l4_cellar_barrel_menu_2d96ca42:

    # MC @ surprised "GAHH!"
    MC @ surprised "으아아!"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2005
translate kr qst_dreamhouse_l4_cellar_barrel_menu_366303df:

    # MC @ angry "Fucking birds!"
    MC @ angry "망할 새들!"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2006
translate kr qst_dreamhouse_l4_cellar_barrel_menu_25beef44:

    # "Inside the barrel... a demon key."
    "통 안에는... 악마 열쇠."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2016
translate kr qst_dreamhouse_l4_cellar_paper_00280188:

    # "In the cellar where the dead things keep,"
    "망자들이 머무는 지하실에,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2017
translate kr qst_dreamhouse_l4_cellar_paper_39082436:

    # "Four sealed casks lie in patient sleep."
    "네 개의 봉인된 통이 인내하며 잠들어 있다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2018
translate kr qst_dreamhouse_l4_cellar_paper_5e6cd56b:

    # "One breathes rot, one bleeds, one flies—"
    "하나는 부패를 숨 쉬고, 하나는 피를 흘리며, 하나는 날아오르고—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2019
translate kr qst_dreamhouse_l4_cellar_paper_3d0d03b3:

    # "One alone still softly spies."
    "하나만이 여전히 은밀히 엿본다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2020
translate kr qst_dreamhouse_l4_cellar_paper_9d4a53be:

    # "Break the watcher, claim your prize."
    "감시자를 부수고, 상을 차지하라."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2025
translate kr qst_dreamhouse_l4_diningroom_to_library_2213c645:

    # MC "(Locked.)"
    MC "(잠겼다.)"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2026
translate kr qst_dreamhouse_l4_diningroom_to_library_9850a7b2:

    # MC "(There must be a key somewhere.)"
    MC "(어딘가에 열쇠가 있을 거야.)"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2030
translate kr qst_dreamhouse_l4_diningroom_to_library_ec3a8b35:

    # MC "(There.)"
    MC "(됐다.)"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2041
translate kr qst_dreamhouse_l4_library_fireplace_88d68c7d:

    # "The fire is dim, but still crackling..."
    "불은 희미하지만, 여전히 타닥거린다..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2048
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_d2422c67:

    # "It's something new now."
    "이제는 새로운 무언가다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2049
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_16a11c2d:

    # "Not the same old faces who would visit me every night."
    "매일 밤 나를 찾아오던 그 똑같은 얼굴들이 아니다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2050
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_ee6d7d9a:

    # "This one speaks to me."
    "이건 나에게 말을 건다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2051
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_303a4556:

    # "It says it wants to be free."
    "자유롭고 싶다고 말한다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2052
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_fa9c241b:

    # "That my mind is a prison."
    "내 마음이 감옥이라고."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2053
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_2b614b72:

    # "... It... It's just another nightmare."
    "... 그건... 그냥 또 다른 악몽일 뿐이야."
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2054
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_9979a58c:

    # "Right?"
    "그렇지?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2058
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_2938cfcc:

    # "{i}He said no.{/i}"
    "{i}그가 안 된다고 했어.{/i}"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2060
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_9f2a8d42:

    # "The book suddenly burst into flames in my hands!"
    "책이 갑자기 내 손에서 불타올랐다!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2061
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_dbff601d:

    # MC @ surprised "FUCK!"
    MC @ surprised "젠장!"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2064
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_8210fe36:

    # "Mother has just told me her friend, the lady with the cat tail, is now also my mommy."
    "엄마가 방금 고양이 꼬리를 가진 숙녀인 친구도 이제 내 새 엄마라고 말했다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2065
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_be1e4a83:

    # "She seems nice, but maybe a little strict."
    "좋은 분 같지만, 좀 엄격할지도 모르겠다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2066
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_103805ec:

    # "... But I don't think I need another mother."
    "... 하지만 다른 엄마는 필요 없을 것 같아."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2067
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_cda5af69:

    # "I just really miss father."
    "난 정말 아빠가 그립다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2070
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_f05f2d15:

    # "I see father less and less."
    "아빠를 점점 더 적게 본다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2071
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_99c2275b:

    # "It's been months now."
    "이제 몇 달째다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2072
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_e03bcff2:

    # "... Maybe he's just never coming back?"
    "... 아빠가 그냥 영영 안 돌아오시는 걸까?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2073
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_382f2858:

    # "Mother is talking about us leaving and heading to live in a place far away."
    "엄마가 우리가 떠나 먼 곳으로 가서 살 거라고 말씀하신다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2074
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_a0bb76e0:

    # "If that happens, will father still visit?"
    "그렇게 되면, 아빠가 여전히 찾아오실까?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2075
translate kr qst_dreamhouse_l4_library_bookshelf_1_menu_11402407:

    # "{i}... Does he still love me?{/i}"
    "{i}... 아빠는 아직도 나를 사랑하실까?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2086
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_99cef191:

    # "A man tried to kidnap me tonight. Thankfully, our guards managed to stop him."
    "오늘 밤 한 남자가 나를 납치하려 했다. 다행히 경비들이 그를 막을 수 있었다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2087
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_5db348b5:

    # "My mothers are terrified, but..."
    "우리 엄마들은 겁에 질렸지만..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2088
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_514db6e3:

    # "I'm more frightened about what I might dream happens tonight."
    "나는 오늘 밤 내가 꿈꿀 일이 더 두렵다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2089
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_ca0a8285:

    # "... Between the pages, a green skull key fell out."
    "... 책갈피 사이에서 녹색 해골 열쇠가 떨어졌다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2093
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_5ac5c20e:

    # "I wish I had more actual friends."
    "진짜 친구가 더 있었으면 좋겠다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2094
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_a1157de1:

    # "I mean, the people at the academy are fine,"
    "그러니까, 아카데미 사람들은 괜찮지만,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2095
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_e5f52d0d:

    # "but it's all cliques and coin and..."
    "전부 파벌과 돈과..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2096
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_fa990cff:

    # "No one is friends with anyone, really. It's all just strategic alignments."
    "아무도 진짜로 친구가 아니야. 그냥 전략적인 연합일 뿐이야."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2097
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_9b223944:

    # "... Fuck, I just wish someone was real for once."
    "... 씨발, 딱 한 번만이라도 누군가 진짜였으면 좋겠다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2100
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_d47f9121:

    # "Father returned with a strange man."
    "아빠가 낯선 남자와 함께 돌아왔다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2101
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_c3456a70:

    # "He said the two of them were going to help me get rid of the nightmares once and for all."
    "그분은 둘이서 나의 악몽을 완전히 없애주겠다고 말했다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2102
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_4ef80800:

    # "Father... You still remembered me!"
    "아빠... 아직 나를 기억하고 계셨구나!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2105
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_b537a0dd:

    # "I had a strange dream tonight. A man, handsome with black hair."
    "오늘 밤 이상한 꿈을 꿨어. 검은 머리의 잘생긴 남자."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2106
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_d64178bc:

    # "But he wasn't fully human. Inside of him... there was another soul."
    "하지만 그는 완전한 인간이 아니었어. 그의 안에는... 또 다른 영혼이 있었어."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2107
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_1b253a90:

    # "He swore he would save me, but it's so strange..."
    "그는 나를 구하겠다고 맹세했지만, 너무 이상해..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2108
translate kr qst_dreamhouse_l4_library_bookshelf_2_menu_7b0b2236:

    # "I've never even seen this man before in my life?"
    "내 인생에서 이 남자를 본 적도 없는데?"
translate kr qst_dreamhouse_l5_start_352f5d88:

    # "As we pushed on once more through the bright light, we found ourselves again in the entrance hallway of the house,"
    "밝은 빛을 뚫고 다시 한 번 나아가자, 우리는 다시 그 집의 현관 복도에 있었다,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2134
translate kr qst_dreamhouse_l5_start_5122da77:

    # "only to face a brand new horror..."
    "하지만 완전히 새로운 공포를 마주할 뿐이었다..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2135
translate kr qst_dreamhouse_l5_start_b10dd20e:

    # MARKUS @ scared "The house is flooded!"
    MARKUS @ scared "집이 물에 잠겼어!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2136
translate kr qst_dreamhouse_l5_start_486c0433:

    # SYPHA @ angry "Urgh... This better not ruin my clothes!"
    SYPHA @ angry "으윽... 내 옷 망가뜨리지 않는 게 좋을 거야!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2138
translate kr qst_dreamhouse_l5_start_062c2bf8:

    # VES @ talk "How much more of this damn house is there?!"
    VES @ talk "이 빌어먹을 집이 얼마나 더 남은 거야?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2139
translate kr qst_dreamhouse_l5_start_17f2980a:

    # KIARA @ sad "Brrr! This water's so cold!"
    KIARA @ sad "부르르! 이 물 너무 차가워!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2140
translate kr qst_dreamhouse_l5_start_7f9a289d:

    # KIARA @ sad "I can't see a damn thing beneath it!"
    KIARA @ sad "물 아래가 하나도 안 보여!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2142
translate kr qst_dreamhouse_l5_start_65d8894b:

    # "Hearing something splash, I quickly turned my attention toward it."
    "무언가 철푸덕 소리가 나서, 재빨리 그쪽으로 주의를 돌렸다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2143
translate kr qst_dreamhouse_l5_start_90d542c5:

    # MC @ serious "What was that?"
    MC @ serious "방금 뭐였지?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2144
translate kr qst_dreamhouse_l5_start_65e22635:

    # SYPHA @ talk "I don't know, but the last thing we should do is wait around and find out..."
    SYPHA @ talk "모르겠지만, 여기서 기다리며 알아내는 건 최악의 선택일 거야..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2151
translate kr qst_dreamhouse_l5_bathtub_f1bb8145:

    # "It's completely rotten away and covered in mold."
    "완전히 썩어 없어지고 곰팡이로 뒤덮여 있다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2155
translate kr qst_dreamhouse_l5_mirror_46c2824e:

    # "It's caked in so much dirt, I can't see anything reflected."
    "먼지가 너무 덕지덕지 붙어 있어, 아무것도 비춰 보이지 않는다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2161
translate kr qst_dreamhouse_l5_upstairs_to_hallway2_13142b1a:

    # MC "(Locked...)"
    MC "(잠겼어...)"
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2166
