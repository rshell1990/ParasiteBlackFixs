# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2811
translate kr qst_dreamhouse_conclusion_serafina_virgo_ea9d704a:

    # "She paused for a moment."
    "그녀가 잠시 멈칫했다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2812
translate kr qst_dreamhouse_conclusion_serafina_virgo_8ece934a:

    # CHANYI @ serious "A dark mage, yes?"
    CHANYI @ serious "흑마법사시죠, 맞나요?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2813
translate kr qst_dreamhouse_conclusion_serafina_virgo_4db1a38d:

    # VIRGO "... Yes."
    VIRGO "... 그래."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2814
translate kr qst_dreamhouse_conclusion_serafina_virgo_5a4b0412:

    # "There was a long, awkward pause."
    "길고 어색한 침묵이 흘렀다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2815
translate kr qst_dreamhouse_conclusion_serafina_virgo_b482beec:

    # CHANYI @ serious "You can see why this might make us worried, right?"
    CHANYI @ serious "이게 왜 우리를 걱정하게 만드는지 아시겠죠?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2816
translate kr qst_dreamhouse_conclusion_serafina_virgo_ce0e1768:

    # VIRGO "I do."
    VIRGO "압니다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2817
translate kr qst_dreamhouse_conclusion_serafina_virgo_a6226ffc:

    # SERAFINA @ talk "Mothers, I promise you."
    SERAFINA @ talk "어머니들, 약속해요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2818
translate kr qst_dreamhouse_conclusion_serafina_virgo_1783b98a:

    # SERAFINA @ talk "Virgo is a good man, he's just... {i}different.{/i}"
    SERAFINA @ talk "비르고는 좋은 사람이에요, 그냥... {i}다를 뿐이에요.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2819
translate kr qst_dreamhouse_conclusion_serafina_virgo_feb57514:

    # "The mage didn't shift an inch."
    "마법사는 한 치도 움직이지 않았다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2820
translate kr qst_dreamhouse_conclusion_serafina_virgo_bf5ee927:

    # "Chanyi stared, but didn't answer."
    "차니가 응시했지만, 대답하지 않았다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2821
translate kr qst_dreamhouse_conclusion_serafina_virgo_a9047292:

    # "Anya, though, clapped her hands together and smiled."
    "하지만 애냐는, 손뼉을 치며 미소 지었다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2822
translate kr qst_dreamhouse_conclusion_serafina_virgo_4085dc85:

    # ANYA @ happy "We shall have a guest room made up for you."
    ANYA @ happy "당신을 위해 객실을 준비하도록 하겠습니다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2823
translate kr qst_dreamhouse_conclusion_serafina_virgo_6d5c0c3a:

    # "The mage offered a curt bow."
    "마법사가 짧게 고개 숙여 인사했다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2824
translate kr qst_dreamhouse_conclusion_serafina_virgo_38f3a53f:

    # VIRGO "You honor me."
    VIRGO "영광입니다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2825
translate kr qst_dreamhouse_conclusion_serafina_virgo_d5030ccf:

    # CHANYI @ serious "... We will discuss later what you plan to teach our daughter."
    CHANYI @ serious "... 우리 딸에게 뭘 가르칠 건지는 나중에 이야기하도록 하지."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2826
translate kr qst_dreamhouse_conclusion_serafina_virgo_600a89f8:

    # CHANYI @ serious "{i}And boundaries.{/i}"
    CHANYI @ serious "{i}그리고 선도.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2827
translate kr qst_dreamhouse_conclusion_serafina_virgo_fd17dd74:

    # SERAFINA @ shock "Mother!"
    SERAFINA @ shock "어머니!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2828
translate kr qst_dreamhouse_conclusion_serafina_virgo_d62fdfb9:

    # CHANYI @ serious "This is for the best, Serafina."
    CHANYI @ serious "이게 최선이야, 세라피나."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2829
translate kr qst_dreamhouse_conclusion_serafina_virgo_6a7145ed:

    # ANYA @ sad "Chanyi is right, Sera, we have to keep you safe, and this is still—"
    ANYA @ sad "차니 말이 맞아, 세라, 널 안전하게 지켜야 해, 그리고 이것도 여전히—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2830
translate kr qst_dreamhouse_conclusion_serafina_virgo_e0f5d574:

    # VIRGO "It is only fair you are concerned for your daughter's wellbeing."
    VIRGO "따님의 안녕을 걱정하시는 건 당연한 일입니다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2831
translate kr qst_dreamhouse_conclusion_serafina_virgo_f1a7a6e5:

    # VIRGO "I can assure you, I do not seek to harm her."
    VIRGO "장담하건대, 저는 그녀를 해치려 하지 않습니다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2832
translate kr qst_dreamhouse_conclusion_serafina_virgo_dc8cd6cd:

    # VIRGO "{i}... Only to study and learn more myself of her great power.{/i}"
    VIRGO "{i}... 그저 그녀의 위대한 힘을 내가 직접 연구하고 배우기 위해서일 뿐이오.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2833
translate kr qst_dreamhouse_conclusion_serafina_virgo_081cc627:

    # "For some reason, that answer hadn't quite sat right with me."
    "왠지 모르게, 그 대답이 내게 제대로 와닿지 않았다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2834
translate kr qst_dreamhouse_conclusion_serafina_virgo_97d47faf:

    # "But... all mages pursue knowledge of magecraft."
    "하지만... 모든 마법사는 마법 지식을 추구한다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2835
translate kr qst_dreamhouse_conclusion_serafina_virgo_b462fac7:

    # "Especially dark mages."
    "특히 흑마법사들은."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2836
translate kr qst_dreamhouse_conclusion_serafina_virgo_b0a3443c:

    # SERAFINA @ smile "I'm pretty tired, so I might lay down for a while to rest."
    SERAFINA @ smile "꽤 피곤해서, 잠시 누워서 쉴게요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2837
translate kr qst_dreamhouse_conclusion_serafina_virgo_4dcfd2a9:

    # VIRGO "We will begin training soon, young mistress."
    VIRGO "곧 훈련을 시작하겠습니다, 아가씨."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2838
translate kr qst_dreamhouse_conclusion_serafina_virgo_23b65982:

    # SERAFINA @ think "You know I hate it when you call me that..."
    SERAFINA @ think "그렇게 부르는 거 싫어하는 거 알면서..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2839
translate kr qst_dreamhouse_conclusion_serafina_virgo_674fa142:

    # VIRGO "Yes... Serafina."
    VIRGO "예... 세라피나."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2842
translate kr qst_dreamhouse_conclusion_serafina_virgo_c7b21bdd:

    # "Serafina returned to her quarters as Virgo was escorted away by one of the servants."
    "비르고가 하인 중 한 명에게 안내되어 나가는 동안, 세라피나는 자신의 방으로 돌아갔다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2844
translate kr qst_dreamhouse_conclusion_serafina_virgo_5c48df66:

    # CHANYI @ think "Well... I can't say I don't have mixed feelings on the outcome."
    CHANYI @ think "뭐... 결과에 대해 복잡한 감정이 없다고 말할 순 없군요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2845
translate kr qst_dreamhouse_conclusion_serafina_virgo_7db27c31:

    # ANYA @ happy "Our daughter is back, Chanyi, that's all that matters."
    ANYA @ happy "우리 딸이 돌아왔어요, 차니, 그게 가장 중요한 거예요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2846
translate kr qst_dreamhouse_conclusion_serafina_virgo_13e9b148:

    # CHANYI @ laugh "{i}*Sigh*{/i} I suppose it is."
    CHANYI @ laugh "{i}*하아*{/i} 그런 것 같군요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2847
translate kr qst_dreamhouse_conclusion_serafina_virgo_aa6e1e19:

    # CHANYI @ laugh "Now then..."
    CHANYI @ laugh "자 그럼..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2848
translate kr qst_dreamhouse_conclusion_serafina_virgo_02cfb407:

    # "Chanyi raised a brow."
    "차니가 눈썹을 치켜올렸다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2849
translate kr qst_dreamhouse_conclusion_serafina_virgo_c967f3fd:

    # CHANYI @ laugh "Let us discuss your reward."
    CHANYI @ laugh "당신의 보상에 대해 논의하죠."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2851
translate kr qst_dreamhouse_conclusion_serafina_virgo_76a64a87:

    # ANYA @ happy "Here, please, take it."
    ANYA @ happy "여기, 부디 받아주세요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2854
translate kr qst_dreamhouse_conclusion_serafina_virgo_753aa434:

    # CHANYI @ laugh "And we mentioned something a little more {i}special{/i} than just coin, didn't we?"
    CHANYI @ laugh "그리고 우리가 단순한 돈보다 좀 더 {i}특별한{/i} 무언가를 언급했었죠, 그렇지 않나요?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2855
translate kr qst_dreamhouse_conclusion_serafina_virgo_44e6d2a9:

    # "With a snap of her fingers, servants entered the room with some of the most beautiful armor I had ever seen, radiating a soft magecraft."
    "손가락을 튕기자, 하인들이 내가 본 중 가장 아름다운 갑옷을 들고 방에 들어왔다. 은은한 마법이 뿜어져 나왔다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2856
translate kr qst_dreamhouse_conclusion_serafina_virgo_c622ff1c:

    # MC @ surprised "What is this?"
    MC @ surprised "이게 뭐죠?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2857
translate kr qst_dreamhouse_conclusion_serafina_virgo_5db94aec:

    # ANYA @ happy "Armor worn by my great, great grandfather."
    ANYA @ happy "제 증조할아버지께서 입으셨던 갑옷이에요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2858
translate kr qst_dreamhouse_conclusion_serafina_virgo_9b81e36f:

    # ANYA @ happy "Strigon Faymore."
    ANYA @ happy "스트리곤 페이모어."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2859
translate kr qst_dreamhouse_conclusion_serafina_virgo_2484da8b:

    # ANYA @ happy "One of the greatest knights of his age."
    ANYA @ happy "그 시대 가장 위대한 기사 중 한 분이셨어요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2860
translate kr qst_dreamhouse_conclusion_serafina_virgo_4a13d053:

    # ANYA @ happy "For generations, we have done our best to maintain his armor."
    ANYA @ happy "대대로, 우리는 그의 갑옷을 유지하기 위해 최선을 다해왔어요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2861
translate kr qst_dreamhouse_conclusion_serafina_virgo_6af9c22b:

    # ANYA @ talk "And now... we gift it to you."
    ANYA @ talk "그리고 이제... 당신께 드립니다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2864
translate kr qst_dreamhouse_conclusion_serafina_virgo_75a4cd2b:

    # CHANYI @ talk "And with that, our business is concluded."
    CHANYI @ talk "그리고 이걸로, 우리의 거래는 종료되었습니다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2865
translate kr qst_dreamhouse_conclusion_serafina_virgo_96f28379:

    # CHANYI @ talk "Do come by from time to time, I do believe Serafina would appreciate it."
    CHANYI @ talk "가끔 들러주세요, 세라피나가 분명 좋아할 거예요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2866
translate kr qst_dreamhouse_conclusion_serafina_virgo_b57311bf:

    # CHANYI @ serious "... And it might help keep that dark mage in line."
    CHANYI @ serious "... 그리고 그 암흑 마법사를 통제하는 데 도움이 될지도 모르지."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2868
translate kr qst_dreamhouse_conclusion_serafina_virgo_6174399d:

    # "The two women shared a knowing look at each other, Anya's cheeks flushed red as she bit at her lower lip."
    "두 여인은 서로 의미심장한 눈빛을 주고받았고, 애냐의 뺨은 붉어졌으며 아랫입술을 깨물었다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2869
translate kr qst_dreamhouse_conclusion_serafina_virgo_6e685004:

    # "Chanyi's tail swished back and forth seductively as she grinned."
    "차니의 꼬리가 유혹하듯 앞뒤로 흔들리며 그녀가 씩 웃었다."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2870
translate kr qst_dreamhouse_conclusion_serafina_virgo_2a1755a5:

    # CHANYI @ talk "Come back tomorrow evening."
    CHANYI @ talk "내일 저녁에 다시 오세요."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2871
translate kr qst_dreamhouse_conclusion_serafina_virgo_bb53172d:

    # CHANYI @ laugh "{i}We'll be waiting.{/i}"
    CHANYI @ laugh "{i}기다리고 있겠네.{/i}"

