translate kr qst_dreamhouse_l3_kitchen_pot_81eb5a2f:

    # "Still hot to the touch, but somehow, I sensed this thing might be useful."
    "만지면 아직 뜨거웠지만, 어쩐지 이 물건이 유용할 거란 느낌이 들었다."
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1478
translate kr qst_dreamhouse_l3_cellar_barrel_64f00b56:

    # MC "(That's... different.)"
    MC "(저건... 색다르네.)"
