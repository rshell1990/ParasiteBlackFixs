translate kr qst_dreamhouse_l3_library_portrait_aafed321:

    # "There's a keyhole below."
    "아래에 열쇠 구멍이 있다."
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1556
translate kr qst_dreamhouse_l3_library_portrait_2cb1bdac:

    # "It doesn't fit..."
    "안 맞는다..."
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1559
translate kr qst_dreamhouse_l3_library_portrait_cc6cf591:

    # "This is the wrong key..."
    "이건 잘못된 열쇠야..."
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1563
translate kr qst_dreamhouse_l3_library_portrait_029708fb:

    # "The key fit into the slot perfectly,"
    "열쇠가 구멍에 완벽하게 맞았다,"
