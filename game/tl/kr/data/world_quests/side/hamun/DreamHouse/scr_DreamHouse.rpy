translate kr qst_dreamhouse_l3_kitchen_pot_889f1f08:

    # MC "A stew boiled inside the pot."
    MC "냄비 안에서 스튜가 끓고 있었다."
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1467
translate kr qst_dreamhouse_l3_kitchen_pot_d7b1acbc:

    # "In the burning wood beneath it, I noticed the end of a small item poking out."
    "그 아래 타는 장작 속에서, 작은 물건의 끝이 튀어나온 게 보였다."
# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1468
translate kr qst_dreamhouse_l3_kitchen_pot_ec28e45d:

    # "Carefully removing it, I grabbed hold of a small, black totem."
    "조심히 꺼내서, 작은 검은 토템을 움켜잡았다."
