# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:127
translate kr dros_4_getDros_b23df8f0:

    # DROS @ shock "You... You do?"
    DROS @ shock "너... 정말?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:128
translate kr dros_4_getDros_5dca7b91:

    # DROS @ lewd "I... Well, that's good!"
    DROS @ lewd "나... 음, 그거 좋네!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:129
translate kr dros_4_getDros_88578b00:

    # "Draya seemed to ponder the thought before giggling."
    "드라야는 그 생각을 곱씹는 듯하더니 깔깔 웃었다."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:130
translate kr dros_4_getDros_9465b4d8:

    # DROS @ lewd "So, what are we?"
    DROS @ lewd "그래서, 우린 무슨 사이야?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:131
translate kr dros_4_getDros_0ca03866:

    # DROS @ lewd "I'm sorry, I'm still getting used to all this."
    DROS @ lewd "미안, 아직 이 모든 게 익숙하지 않아서."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:132
translate kr dros_4_getDros_93c8966a:

    # DROS @ lewd "What should I call you, [player_name!t]?"
    DROS @ lewd "널 뭐라고 불러야 할까, [player_name!t]?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:135
translate kr dros_4_getDros_03d15310:

    # DROS @ smile "[dros_player_ref!t]? Well... If that's what you wish."
    DROS @ smile "[dros_player_ref!t]? 음... 그게 네가 원하는 거라면."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:136
translate kr dros_4_getDros_038709e6:

    # DROS @ talk "I have to speak to the Madam and change some details about my arrangement with her."
    DROS @ talk "마담에게 가서 그녀와의 계약에 대한 몇 가지 세부 사항을 변경해야 해."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:137
translate kr dros_4_getDros_03ea6e8e:

    # MC @ surprised "You still intend to work at the Brothel?"
    MC @ surprised "아직도 사창가에서 일할 생각이야?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:138
translate kr dros_4_getDros_c1d7def0:

    # DROS @ smile "No, not at all."
    DROS @ smile "아니, 전혀."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:139
translate kr dros_4_getDros_00278a48:

    # DROS @ lewd "But we will need a safer place than my shop for more... {i}intimate{/i} moments."
    DROS @ lewd "하지만 더... {i}은밀한{/i} 순간을 위해 내 가게보다 더 안전한 장소가 필요할 거야."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:140
translate kr dros_4_getDros_7ed39a12:

    # DROS @ angry "Having you come and go from the shop too much may draw some unwanted attention... Even with me like this."
    DROS @ angry "네가 가게를 너무 자주 들락거리면 원치 않는 관심을 끌 수 있어... 나 같은 모습이라도."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:141
translate kr dros_4_getDros_be78d9d6:

    # DROS @ angry "Last thing I need is inquisitors or someone poking into my business."
    DROS @ angry "종교재판관이나 누군가가 내 일에 코를 들이미는 건 사양이야."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:142
translate kr dros_4_getDros_eedd2591:

    # MC @ talk "So, what will you do?"
    MC @ talk "그럼, 어떻게 할 거야?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:143
translate kr dros_4_getDros_2a4df126:

    # DROS @ smile "It's simple, {i}I'm going to pay for the room myself.{/i}"
    DROS @ smile "간단해, {i}내가 직접 방값을 낼 거야.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:144
translate kr dros_4_getDros_8d5d3adc:

    # MC @ talk "Will that not be costly?"
    MC @ talk "비용이 많이 들지 않을까?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:145
translate kr dros_4_getDros_9ae59753:

    # DROS @ smile "I can afford it... Being a tailor does have its perks."
    DROS @ smile "감당할 수 있어... 재단사도 나름의 특혜가 있거든."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:146
translate kr dros_4_getDros_788db69a:

    # DROS @ lewd "Besides, {i}I cannot wait to see you there, [dros_player_ref!t].{/i}"
    DROS @ lewd "게다가, {i}거기서 널 보는 게 너무 기다려져, [dros_player_ref!t].{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:147
translate kr dros_4_getDros_1baa56b0:

    # MC @ smile "I will see you there then, Draya."
    MC @ smile "그럼 거기서 보자, 드라야."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:148
translate kr dros_4_getDros_5bc8ea6d:

    # "Draya smiled once again as she leaned forward to kiss me on the cheek before hurrying off."
    "드라야가 다시 한번 미소 지으며 몸을 기울여 내 뺨에 키스한 뒤 서둘러 떠났다."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:150
translate kr dros_4_getDros_d346d243:

    # "All of that usual anger seemed to have washed away."
    "그 모든 평소의 분노가 씻겨 나간 것 같았다."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:152
translate kr dros_4_getDros_9f25939c:

    # MC "(Something tells me I'm in for a good time the next time I see them.)"
    MC "(왠지 다음에 그들을 만나면 아주 즐거운 시간이 될 것 같은 예감이 든다.)"

