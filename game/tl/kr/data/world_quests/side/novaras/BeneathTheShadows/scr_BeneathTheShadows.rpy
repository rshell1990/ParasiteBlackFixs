# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:65
translate kr qst_beneath_shadows_enter_bordello_meet_carina_f7edea53:

    # "As Arwen left, I couldn't help but stare somewhat dumbfounded at the beautiful, sensual woman before me."
    "알웬이 떠나자, 나는 어안이 벙벙한 채로 내 앞의 아름답고 관능적인 여인을 바라볼 수밖에 없었다."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:66
translate kr qst_beneath_shadows_enter_bordello_meet_carina_0fc45d30:

    # "As attractive as even the most expensive courtesans could be, this woman was breathlessly beautiful."
    "가장 비싼 고급 창녀들마저 매력적일 수 있지만, 이 여인은 숨이 막힐 정도로 아름다웠다."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:67
translate kr qst_beneath_shadows_enter_bordello_meet_carina_00eafa5c:

