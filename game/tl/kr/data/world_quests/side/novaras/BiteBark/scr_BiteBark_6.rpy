translate kr qst_BiteBark_6_McRoomResolution_menu_fc96eee0:

    # ELENA @ angry "Why would I show this form to a human? Your kind have long made sport of wiping my kind out when found."
    ELENA @ angry "왜 내가 인간에게 이 모습을 보여줘야 하지? 너희 종족은 내 종족을 발견하면 오랫동안 말살하는 걸 오락으로 삼아왔어."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:53
translate kr qst_BiteBark_6_McRoomResolution_menu_640b8f49:

