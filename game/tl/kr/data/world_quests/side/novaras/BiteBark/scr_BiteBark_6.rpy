translate kr qst_BiteBark_6_McRoomResolution_menu2_265e00c6:

    # MC @ surprised "Are you sure you don't wish to stay? There is no need to leave so soon."
    MC @ surprised "정말 머물고 싶지 않아? 그렇게 서둘러 떠날 필요 없어."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:128
translate kr qst_BiteBark_6_McRoomResolution_menu2_21ba51a9:

    # ELENA @ grumpy "Your offer is kind, but no... She's still out there, I can feel it."
    ELENA @ grumpy "네 제안은 친절하지만, 안 돼... 그녀는 아직 저 밖에 있어, 느낄 수 있어."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:129
translate kr qst_BiteBark_6_McRoomResolution_menu2_3c39cda2:

    # ELENA @ sad "I cannot rest till the lady is safe."
    ELENA @ sad "영애가 안전해질 때까지는 쉴 수 없어."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:130
translate kr qst_BiteBark_6_McRoomResolution_menu2_eca75fbc:

    # ELENA @ grumpy "Farewell... Strange traveller."
    ELENA @ grumpy "잘 가... 이상한 여행자여."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:134
translate kr qst_BiteBark_6_McRoomResolution_menu2_367cbda8:

    # "In that moment, Elena once again morphed herself down into her blue wolf form, and before I knew it, she had sprinted past me out of the door."
    "그 순간, 엘레나는 다시 한번 푸른 늑대 형태로 변신하더니, 내가 미처 알아채기도 전에 나를 지나 문 밖으로 달려나갔다."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:135
translate kr qst_BiteBark_6_McRoomResolution_menu2_fb1bb61a:

    # "I heard [regina_ref!t] cry out as Elena no doubt bolted out of the front door, and she quickly rushed inside to speak to me."
    "[regina_ref!t]가 외치는 소리가 들렸고, 엘레나가 틀림없이 현관문을 박차고 나갔을 거다. 그녀는 재빨리 안으로 뛰어 들어와 내게 말을 걸었다."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:141
translate kr qst_BiteBark_6_McRoomResolution_menu2_41405de6:

    # REGINA @ shock_talk "What happened? The wolf-"
    REGINA @ shock_talk "무슨 일이야? 그 늑대가-"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:142
translate kr qst_BiteBark_6_McRoomResolution_menu2_fea45294:

    # MC @ sad "It's alright, just let her go."
    MC @ sad "괜찮아, 그냥 가게 둬."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:143
translate kr qst_BiteBark_6_McRoomResolution_menu2_1a04c9a7:

    # "[regina_ref_cap!t] opened her mouth to say something, but instead she angrily slammed the side of the fist lightly into the wall muttering under her breathe."
    "[regina_ref_cap!t]이(가) 무슨 말을 하려고 입을 열었지만, 대신 화가 난 듯 벽에 주먹 옆면을 살짝 내리치며 숨죽여 중얼거렸다."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:144
translate kr qst_BiteBark_6_McRoomResolution_menu2_a83859d8:

    # REGINA @ angry "{i}Damn it...{/i}"
    REGINA @ angry "{i}젠장...{/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:146
translate kr qst_BiteBark_6_McRoomResolution_menu2_fadfc224:

    # MC @ sad "(I feel bad I couldn't help her but... I'd only be taking on more unnecessary risk for myself.)"
    MC @ sad "(그녀를 도와주지 못해 마음이 안 좋지만... 더 이상 내가 불필요한 위험을 감수할 필요는 없어.)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:147
translate kr qst_BiteBark_6_McRoomResolution_menu2_3aa6a878:

    # MC "(I hope she finds what she is looking for, perhaps one day our paths will cross again?)"
    MC "(그녀가 찾고 있는 것을 찾길 바라, 언젠가 우리의 길이 다시 교차할지도?)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:156
translate kr qst_BiteBark_6_McRoomResolution_menu2_6544531e:

    # ELENA @ grumpy "Oh... One thing... While in this city, I will likely have to remain in my wolf form in a fight."
    ELENA @ grumpy "아... 한 가지 더... 이 도시에 있는 동안, 싸울 때는 늑대 모습을 유지해야 할 거야."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:157
translate kr qst_BiteBark_6_McRoomResolution_menu2_1b0a7479:

    # ELENA @ grumpy "Too dangerous to show my true form."
    ELENA @ grumpy "진짜 모습을 보여주기엔 너무 위험해."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:158
translate kr qst_BiteBark_6_McRoomResolution_menu2_e377fd11:

    # MC @ talk "I understand."
    MC @ talk "이해해."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:159
translate kr qst_BiteBark_6_McRoomResolution_menu2_4dd203d1:

    # "As my eyes scanned the wolf girl up and down, I felt the tinge of excitement staring at her slender, nude body."
    "내 눈이 늑대 소녀를 위아래로 훑자, 그녀의 날씬한 나체를 바라보며 약간의 흥분을 느꼈다."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:160
translate kr qst_BiteBark_6_McRoomResolution_menu2_fc5d377c:

    # "Noticing this, Elena raised an eyebrow inquiring."
    "이것을 알아챈 엘레나가 의아한 듯 눈썹을 치켜올렸다."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:161
translate kr qst_BiteBark_6_McRoomResolution_menu2_e454529d:

    # ELENA @ grumpy "Is something the matter?"
    ELENA @ grumpy "무슨 문제라도?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:162
translate kr qst_BiteBark_6_McRoomResolution_menu2_2aba70ac:

    # MC @ surprised "I... Well you're..."
    MC @ surprised "나... 그게 넌..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:163
translate kr qst_BiteBark_6_McRoomResolution_menu2_5b9077b4:

    # ELENA @ grumpy "...My form bothers you?"
    ELENA @ grumpy "...내 모습이 거슬려?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:164
translate kr qst_BiteBark_6_McRoomResolution_menu2_7cda0677:

    # MC @ surprised "N-No! You look beautiful!"
    MC @ surprised "아-아니! 아름다워 보여!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:165
translate kr qst_BiteBark_6_McRoomResolution_menu2_231e2faf:

    # MC @ talk "But, perhaps some clothes are in order?"
    MC @ talk "하지만, 어쩌면 옷이 좀 필요하지 않을까?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:166
translate kr qst_BiteBark_6_McRoomResolution_menu2_e413c0fa:

    # ELENA @ grumpy "Urgh, why are you humans so determined to coat yourselves in fabrics and such?"
    ELENA @ grumpy "으, 너희 인간들은 왜 그렇게 천 같은 걸로 몸을 감싸는 데 집착하는 거야?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:167
translate kr qst_BiteBark_6_McRoomResolution_menu2_d3216100:

    # ELENA @ talk "You all seem so ashamed almost of your natural forms."
    ELENA @ talk "마치 자기 본연의 모습이 부끄럽기라도 한 것 같아."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:168
translate kr qst_BiteBark_6_McRoomResolution_menu2_b304f3d6:

    # MC @ talk "We're not ashamed, just more reserved."
    MC @ talk "부끄러운 게 아니라, 그냥 더 내성적인 거야."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:169
translate kr qst_BiteBark_6_McRoomResolution_menu2_1d981bd9:

    # MC @ talk "And there may call for an occasion where clothes {i}are{/i} needed."
    MC @ talk "그리고 옷이 {i}필요한{/i} 상황도 있을 수 있고."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:170
translate kr qst_BiteBark_6_McRoomResolution_menu2_ff974651:

    # ELENA @ talk "Hmph... A valid point I suppose."
    ELENA @ talk "흥... 일리 있는 말이네."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:171
translate kr qst_BiteBark_6_McRoomResolution_menu2_6deab029:

    # ELENA @ talk "I have these rags I found scavenging..."
    ELENA @ talk "쓰레기 더미에서 주운 이 누더기가 있긴 해..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:172
translate kr qst_BiteBark_6_McRoomResolution_menu2_ccbe29ff:

    # "Elena presented to me the loose torn rags which she wrapped around herself."
    "엘레나가 몸에 두르고 있던 헐렁하고 찢어진 누더기를 내게 보여줬다."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:173
translate kr qst_BiteBark_6_McRoomResolution_menu2_4e6f3ba0:

    # ELENA @ talk "Better?"
    ELENA @ talk "더 나아?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:174
translate kr qst_BiteBark_6_McRoomResolution_menu2_c9013ca0:

    # MC @ talk "Well... That's better than nothing."
    MC @ talk "뭐... 없는 것보단 낫네."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:175
translate kr qst_BiteBark_6_McRoomResolution_menu2_f1b02700:

    # MC @ talk "But I think something a little more pragmatic is in order than just rags."
    MC @ talk "하지만 누더기보단 좀 더 실용적인 게 필요할 것 같아."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:176
translate kr qst_BiteBark_6_McRoomResolution_menu2_fb3a6f91:

    # ELENA @ grumpy "But who could we trust to make something for me?"
    ELENA @ grumpy "하지만 누구를 믿고 내 옷을 만들 수 있을까?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:179
translate kr qst_BiteBark_6_McRoomResolution_menu2_f259aa9d:

    # MC "(Hmm... Perhaps the elf might be of assistance?)"
    MC "(흠... 어쩌면 그 엘프가 도움이 될지도?)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:182
translate kr qst_BiteBark_6_McRoomResolution_menu2_619ae15f:

    # MC "(I suppose I should look around the city more... There has to be someone who can help.)"
    MC "(도시를 좀 더 둘러봐야겠군... 도와줄 수 있는 누군가가 분명 있을 거야.)"

