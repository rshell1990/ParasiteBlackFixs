# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:7
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d6761cbb:

    # MC @ talk "Go tell Tarek we've brought proof!"
    MC @ talk "가서 타렉에게 우리가 증거를 가져왔다고 전해!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:9
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c2d8c402:

    # "After some muffled cursing, I heard the thug on the other side shuffle away."
    "희미한 욕설이 들린 후, 반대편에서 깡패가 발을 질질 끌며 사라지는 소리가 들렸다."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:10
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_bd24aa47:

    # "In a moment, a door opened and we were let in."
    "잠시 후 문이 열리고 우리는 안으로 들여보내졌다."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:11
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_45402abc:

    # "Tarek awaited in his office."
    "타렉이 그의 사무실에서 기다리고 있었다."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:19
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_24c2dbf9:

    # MC @ talk "I have the proof you require Tarek."
    MC @ talk "네가 요구한 증거를 가져왔어 타렉."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:20
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_9b7fdd62:

    # TAREK @ shock "What?! Show me!"
    TAREK @ shock "뭐?! 보여줘!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:24
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_61e1b66d:

    # "I handed over the bloodied scroll to Tarek."
    "나는 피 묻은 두루마리를 타렉에게 건넸다."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:25
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_a8317f86:

    # MC @ talk "The other factions are about to turn on you, the Vulshan and Khazah's know you are trying to weaken them by handing over their territory to the lesser factions."
    MC @ talk "다른 파벌들이 곧 널 배신할 거야, 불샨족과 카자족은 네가 그들의 영토를 하위 파벌들에게 넘겨 약화시키려 한다는 걸 알고 있어."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:26
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_60cee6bc:

    # TAREK "I-"
    TAREK "저-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:27
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5380f6ab:

    # "Tarek's face became sullen as the reality dawned on him."
    "현실을 깨닫자 타렉의 얼굴이 침울해졌다."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:28
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_b804709f:

    # TAREK @ sad "Yes... I can see now, it's all falling apart."
    TAREK @ sad "그래... 이제 알겠다, 모든 게 무너지고 있어."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:29
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_579d4c44:

    # MC @ talk "Surely you must have known trying to weaken their factions would result on them to turn on you?"
    MC @ talk "그들의 파벌을 약화시키려 하면 그들이 널 배신할 거란 걸 분명 알고 있었을 텐데?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:30
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_1d4e9018:

    # TAREK "The Vulshan and Khazahs have been fighting for decades, I knew both were undermining my authority so what else was I supposed to do?"
    TAREK "불샨족과 카자족은 수십 년간 싸워왔고, 둘 다 내 권위를 훼손하고 있다는 걸 알고 있었는데, 내가 달리 어떻게 해야 했겠어?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:31
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6ca2cf51:

    # TAREK @ sad "Not that it matters now... You were right it seems, this was inevitable."
    TAREK @ sad "이젠 상관없지만... 네 말이 맞았던 것 같군, 이건 불가피했어."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:32
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_74bf3445:

    # MC @ talk "What will you do now?"
    MC @ talk "이제 어떻게 할 거야?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:33
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3e90c048:

    # TAREK "Worry not, I will keep my word and leave..."
    TAREK "걱정 마, 약속을 지키고 떠날 테니..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:34
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_36997e06:

    # TAREK "...But not before I let loose and hand over all the information I have to the inquisitors!"
    TAREK "...하지만 내가 가진 모든 정보를 풀어 심문관들에게 넘기기 전까진!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:35
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4ff0ec6b:

    # MC @ talk "You'll try strike a deal with them?"
    MC @ talk "그들과 거래를 시도할 건가?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:36
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e1c147f8:

    # TAREK "Why not? As it stands, I am a dead man... At least if I can offer them something in return, perhaps I may just walk away from all this with something to show still..."
    TAREK "왜 안 되겠어? 지금으로선, 나는 죽은 목숨이야... 적어도 그들에게 뭔가 대가를 제공할 수 있다면, 아마 이 모든 것에서 뭔가 건진 채로 빠져나갈 수 있을지도 모르지..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:37
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_33c1f58a:

    # MC @ talk "...And Nijah?"
    MC @ talk "...그리고 니자는?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:38
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d4b7407a:

    # TAREK "Consider her debt settled."
    TAREK "그녀의 빚은 탕감된 것으로 하지."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:39
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_06188b6a:

    # TAREK "Before I go, you should know in my absence things may become more... {i}violent{/i} for a while."
    TAREK "떠나기 전에, 내 부재 중에는 상황이 한동안 더... {i}폭력적으로{/i} 변할 거란 걸 알아둬."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:40
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_257af9a7:

    # TAREK @ angry "The violence I've tried to hold back will spill out in the power struggle to follow."
    TAREK @ angry "내가 억누르려 했던 폭력이 뒤따를 권력 투쟁에서 터져 나올 거야."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:41
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_64af8631:

    # MC @ talk "Where will you go?"
    MC @ talk "어디로 갈 건데?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:42
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffa0994f:

    # TAREK "Who knows!"
    TAREK "누가 알겠어!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:43
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4bef9a69:

    # TAREK "Perhaps we may even run into each other again..."
    TAREK "어쩌면 우리 다시 마주칠지도 모르지..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:44
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6074ce3c:

    # TAREK "Don't worry, I won't forget what you did for me here today."
    TAREK "걱정 마, 오늘 여기서 네가 해준 걸 잊지 않을게."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:45
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c9b5c36a:

    # TAREK "You could have just tried to kill me."
    TAREK "넌 그냥 나를 죽이려 할 수도 있었어."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:46
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5d2a16c6:

    # MC @ talk "That's not my way."
    MC @ talk "그건 내 방식이 아니야."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:47
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffbfa8ae:

    # TAREK "Hm... Perhaps there are still honest men in this land then."
    TAREK "흠... 그럼 이 땅에도 아직 정직한 사람들이 있긴 한가 보군."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:48
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e81bba9c:

    # TAREK "Farewell friend, I will be gone by nightfall."
    TAREK "잘 가게 친구, 해질녘엔 떠나 있을 거야."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:51
translate kr scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_52dc527f:

    # MC @ talk "Farewell, Tarek."
    MC @ talk "잘 가, 타렉."

