# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:59
translate kr qst_DamzelDizzt_2_afterAction_4f5f7955:

    # BLACK "IT WAS A GOOD HUNT, HOST."
    BLACK "좋은 사냥이었다, 숙주여."

