translate kr qst_DamzelDizzt_5_evidence_05bcedd1:

    # MARKUS "You just had to fucking show how ballsy you are, didn't you?"
    MARKUS "네가 얼마나 배짱 있는지 꼭 보여줘야만 했냐, 그렇지?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:80
translate kr qst_DamzelDizzt_5_evidence_initial_40c1fb55:

    # MARKUS @ shock "Why the sudden change in plan?"
    MARKUS @ shock "왜 갑자기 계획을 바꾼 거야?"

