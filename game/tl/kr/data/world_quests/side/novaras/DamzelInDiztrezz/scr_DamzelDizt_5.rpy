translate kr qst_DamzelDizzt_5_evidence_5e89564a:

    # TAREK "If you can find me proof of impending betrayal, proof that all of {i}this{/i} will fall apart soon."
    TAREK "임박한 배신의 증거, 이 {i}모든 것{/i}이 곧 무너질 거라는 증거를 찾아올 수 있다면."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:53
translate kr qst_DamzelDizzt_5_evidence_df15c8b7:

    # TAREK "Then I shall take my leave."
    TAREK "그럼 나는 떠나겠다."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:54
translate kr qst_DamzelDizzt_5_evidence_778dd24f:

    # MC @ talk "Then it's settled, I shall find some proof."
    MC @ talk "그럼 결정됐어, 증거를 찾아오지."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:55
translate kr qst_DamzelDizzt_5_evidence_979fe1f7:

    # TAREK @ angry "Hmph... Don't return unless you have something to show me."
    TAREK @ angry "흥... 내게 보여줄 게 없으면 돌아오지 마."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:56
translate kr qst_DamzelDizzt_5_evidence_e6efa2ee:

    # TAREK @ angry "Otherwise, you will not walk out of here alive..."
    TAREK @ angry "그렇지 않으면, 여기서 살아서 나가지 못할 거야..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_5.rpy:61
translate kr qst_DamzelDizzt_5_evidence_632c0c6f:

