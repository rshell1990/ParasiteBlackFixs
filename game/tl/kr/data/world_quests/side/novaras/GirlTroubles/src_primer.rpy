# TODO: Translation updated at 2026-06-30 02:00

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:3
translate kr primer_girl_troubles_1_fc4cddb5:

    # MESSENGER "Wait! Hold up!"
    MESSENGER "잠깐! 기다려요!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:5
translate kr primer_girl_troubles_1_0ed1380f:

    # "Stopping in my tracks, I turned to face the young boy hurrying towards me."
    "걸음을 멈추고, 나를 향해 서둘러 다가오는 어린 소년을 돌아보았다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:7
translate kr primer_girl_troubles_1_cc1bdfcf:

    # MC @ think "Can I help you?"
    MC @ think "무슨 일이죠?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:8
translate kr primer_girl_troubles_1_b9d4697a:

    # MESSENGER "Sister Divine requests your presence at the tower of Palam at once."
    MESSENGER "자매 디바인께서 즉시 팔람의 탑으로 오시라고 하셨습니다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:9
translate kr primer_girl_troubles_1_ff0934a5:

    # MC @ talk "Sister Divine?"
    MC @ talk "자매 디바인?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:10
translate kr primer_girl_troubles_1_bef6b9ee:

    # MC @ talk "Did you say why?"
    MC @ talk "이유는 말했니?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:11
translate kr primer_girl_troubles_1_4755a9a3:

    # MESSENGER "No sir, but she said it was a matter most urgent."
    MESSENGER "아니요, 하지만 가장 긴급한 일이라고 하셨어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:12
translate kr primer_girl_troubles_1_2e49f35d:

    # MESSENGER "Now, if you'll excuse me, I've got to deliver my next message!"
    MESSENGER "이제 실례하겠습니다, 다음 전언을 전달해야 해서요!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:16
translate kr primer_girl_troubles_1_bd996885:

    # MC "(Hmm... I should stop by the tower of Palam when I get a chance.)"
    MC "(흠... 기회가 되면 팔람의 탑에 들러야겠다.)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:26
translate kr primer_girl_troubles_2_4fb8f212:

    # DIVINE @ talk "Ah, there you are."
    DIVINE @ talk "아, 거기 계셨군요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:27
translate kr primer_girl_troubles_2_bd6dbff0:

    # "Divine steps out from behind her desk, a playful glint in her eye as she moves closer."
    "디바인이 책상 뒤에서 나와, 장난기 어린 눈빛으로 다가온다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:32
translate kr primer_girl_troubles_2_4630b090:

    # "Without a word, she wraps her arms around me, her lips finding mine in a slow, deliberate kiss."
    "아무 말 없이, 그녀는 나를 감싸 안으며 천천히, 의도적으로 내 입술에 키스한다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:33
translate kr primer_girl_troubles_2_dd678d35:

    # MC "(Her touch is familiar, warm...)"
    MC "(그녀의 손길은 익숙하고, 따뜻하다...)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:34
translate kr primer_girl_troubles_2_01941bc7:

    # "My hand drifts down instinctively, fingers grazing her waist before resting on her backside."
    "내 손은 본능적으로 아래로 내려가, 손가락이 그녀의 허리를 스치고 엉덩이에 머문다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:35
translate kr primer_girl_troubles_2_e70ed2d3:

    # DIVINE @ happy "Mmm... You never change, do you?"
    DIVINE @ happy "으음... 당신은 변하지 않네요, 그렇죠?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:36
translate kr primer_girl_troubles_2_964d7d25:

    # "She lets out a soft, breathy laugh, before gently pushing away, cheeks flushed."
    "그녀는 부드럽고 숨 섞인 웃음을 내뱉고, 볼을 붉히며 살짝 밀어낸다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:41
translate kr primer_girl_troubles_2_db756b90:

    # MC @ smile "That's quite a desk you’ve got there, you know. I'd love to see you—"
    MC @ smile "꽤 멋진 책상이네요. 당신을 보고 싶은데—"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:42
translate kr primer_girl_troubles_2_ef0995eb:

    # DIVINE @ laugh "Easy, easy! I didn’t call you here for {i}that.{/i}"
    DIVINE @ laugh "진정, 진정! {i}그런{/i} 일로 널 부른 게 아니야."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:43
translate kr primer_girl_troubles_2_a93764bb:

    # DIVINE @ happy "Though, maybe later... if there's time."
    DIVINE @ happy "하지만, 나중에... 시간이 있다면요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:45
translate kr primer_girl_troubles_2_dde96000:

    # "Sister Divine stands behind her desk, her expression unreadable as she watches me enter."
    "자매 디바인이 책상 뒤에 서 있다. 내가 들어서는 모습을 바라보는 그녀의 표정은 읽을 수 없다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:46
translate kr primer_girl_troubles_2_b9dbb770:

    # DIVINE @ talk "It’s good to see you again. I’ve been meaning to speak with you."
    DIVINE @ talk "다시 만나서 반가워요. 당신과 할 이야기가 있었어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:48
translate kr primer_girl_troubles_2_559540db:

    # MC @ talk "So, what's this about?"
    MC @ talk "그래서, 무슨 일이죠?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:49
translate kr primer_girl_troubles_2_1eea1aea:

    # DIVINE @ talk "Tell me, what do you know about the tower?"
    DIVINE @ talk "말해보세요, 이 탑에 대해 뭘 알고 있나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:50
translate kr primer_girl_troubles_2_399a0353:

    # MC @ think "Hm? Not much..."
    MC @ think "흠? 별로..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:51
translate kr primer_girl_troubles_2_63c38e46:

    # MC @ talk "I know mages of Palam are taken from their parents from a young age to join the order."
    MC @ talk "팔람의 마법사들은 어린 나이에 부모에게서 데려와져 기사단에 합류한다는 정도는 압니다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:52
translate kr primer_girl_troubles_2_51c5a5cf:

    # DIVINE @ talk "Being a mage is a lifelong commitment, and many start young at one of the smaller holds before coming here."
    DIVINE @ talk "마법사가 되는 것은 평생의 헌신이며, 많은 이들이 이곳에 오기 전에 더 작은 거점에서 어린 나이에 시작해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:53
translate kr primer_girl_troubles_2_a09d053a:

    # DIVINE @ talk "It's best to think of this tower as a kind of university, but to mages, any hold under their magecraft is considered a second home they're expected to return to throughout their life periodically."
    DIVINE @ talk "이 탑을 일종의 대학이라고 생각하는 게 가장 좋아요. 하지만 마법사들에게는, 그들의 마법 아래 있는 어떤 거점도 평생 주기적으로 돌아가야 할 제2의 고향으로 여겨져요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:54
translate kr primer_girl_troubles_2_eec6e3a7:

    # DIVINE @ talk "Suffice it to say I care for each and every girl who comes here, many of whom I've known to some degree since they were small."
    DIVINE @ talk "간단히 말해, 이곳에 오는 모든 소녀들을 돌본다고 할 수 있어요. 그 중 많은 이들을 어릴 때부터 알고 지냈죠."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:55
translate kr primer_girl_troubles_2_df064ee4:

    # MC @ talk "I see... But why the urgent summoning? Where do I fit into all this?"
    MC @ talk "알겠습니다... 하지만 왜 급히 부르신 거죠? 제가 여기서 무슨 역할을 하나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:56
translate kr primer_girl_troubles_2_a9467911:

    # DIVINE @ talk "Since this war began, Mages have been, with the end of every terminus ceremony, sent towards the front."
    DIVINE @ talk "이 전쟁이 시작된 이후로, 매 종결 의식이 끝날 때마다 마법사들은 전선으로 보내지고 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:57
translate kr primer_girl_troubles_2_af61e39a:

    # DIVINE @ talk "Thankfully, many of my girls are usually kept back to help deal with the wounded, so losses are limited."
    DIVINE @ talk "다행히도, 내 소녀들 대부분은 보통 부상자들을 돌보는 데 배치되어서, 손실이 제한적이에요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:58
translate kr primer_girl_troubles_2_a8a38eea:

    # DIVINE @ talk "With that said, Alcott's government continues to put more and more pressure on getting out the door, regardless of capabilities."
    DIVINE @ talk "그렇긴 해도, 알콧 정부는 능력과 상관없이 계속해서 더 많은 압박을 가하고 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:59
translate kr primer_girl_troubles_2_8241cd14:

    # "Sister Divine paused uncomfortably."
    "자매 디바인이 불편하게 멈칫했다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:60
translate kr primer_girl_troubles_2_836dcfe9:

    # DIVINE @ talk "... Last month, four of my girls stationed at a camp were killed by a surprise ambush."
    DIVINE @ talk "... 지난달, 야영지에 주둔하던 내 소녀들 중 네 명이 기습 공격으로 죽었어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:61
translate kr primer_girl_troubles_2_eae6fb6b:

    # DIVINE @ talk "From what reports I have, the girls panicked and fumbled their spells."
    DIVINE @ talk "내가 받은 보고에 따르면, 소녀들이 당황해서 주문을 더듬거렸다고 해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:62
translate kr primer_girl_troubles_2_1cd0a9e5:

    # DIVINE @ sad "... They weren't ready."
    DIVINE @ sad "... 그들은 준비되지 않았어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:63
translate kr primer_girl_troubles_2_c3780307:

    # MC @ sad "That's horrible."
    MC @ sad "끔찍하군요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:64
translate kr primer_girl_troubles_2_ead16311:

    # DIVINE @ angry "Standards are slipping..."
    DIVINE @ angry "수준이 떨어지고 있어요..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:65
translate kr primer_girl_troubles_2_3eeccae0:

    # DIVINE @ sad "And my girls are dying for it."
    DIVINE @ sad "그리고 내 소녀들이 그 대가로 죽어가고 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:68
translate kr primer_girl_troubles_2_menu_685b6d3d:

    # DIVINE @ talk "I've tried."
    DIVINE @ talk "노력해봤어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:69
translate kr primer_girl_troubles_2_menu_3a9ef15e:

    # DIVINE @ talk "The officials don't care for the quality of Mages, only that there {i}are{/i} Mages."
    DIVINE @ talk "관리들은 마법사의 질은 신경 쓰지 않고, 마법사가 {i}있다는{/i} 것만 신경 써요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:70
translate kr primer_girl_troubles_2_menu_9c138b9c:

    # DIVINE @ talk "My concerns fall on deaf ears."
    DIVINE @ talk "내 우려는 묵살당하고 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:73
translate kr primer_girl_troubles_2_menu_75a8f7bf:

    # DIVINE @ angry "I am aware people 'die' in war; I'm not a fool."
    DIVINE @ angry "전쟁에서 사람이 '죽는다'는 건 알고 있어요. 바보가 아니에요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:74
translate kr primer_girl_troubles_2_menu_16b704db:

    # DIVINE @ talk "But there are only ever so many mages per year, and magecraft is a lifelong commitment to master."
    DIVINE @ talk "하지만 매년 마법사의 수는 한정되어 있고, 마법은 평생을 바쳐 익혀야 하는 것이에요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:75
translate kr primer_girl_troubles_2_menu_6917f041:

    # DIVINE @ talk "It's not as simple as replacing a simple grunt... No offense."
    DIVINE @ talk "단순한 보병을 대체하는 것처럼 간단하지 않아요... 악의는 없어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:76
translate kr primer_girl_troubles_2_menu_c8f104a8:

    # MC @ talk "None taken."
    MC @ talk "기분 나쁘지 않습니다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:79
translate kr primer_girl_troubles_2_menu_b528cbb1:

    # DIVINE @ talk "Three girls of mine, troublesome issues with each."
    DIVINE @ talk "내 소녀들 중 세 명, 각자 문제가 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:80
translate kr primer_girl_troubles_2_menu_5be2fe8f:

    # DIVINE @ talk "I've put my foot down and held them back from being assigned to the front."
    DIVINE @ talk "내가 단호히 막아서서 그들이 전선에 배치되는 것을 보류했어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:81
translate kr primer_girl_troubles_2_menu_ac431a22:

    # MC @ talk "Why?"
    MC @ talk "왜죠?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:82
translate kr primer_girl_troubles_2_menu_e02e14c6:

    # DIVINE @ talk "They're not ready... And I'm not prepared to knowingly send some of my girls to their deaths."
    DIVINE @ talk "그들은 준비되지 않았어요... 그리고 내 소녀들 중 일부를 죽음으로 내몰 준비는 되어 있지 않아요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:83
translate kr primer_girl_troubles_2_menu_cd04b852:

    # DIVINE @ talk "Now, I don't have time to resolve these issues myself; I have to prepare the next batch of mages, who are already showing similar issues, for next year's terminus ceremony."
    DIVINE @ talk "이제, 이 문제들을 직접 해결할 시간이 없어요. 이미 비슷한 문제를 보이고 있는 다음 마법사 배치를 내년 종결 의식을 위해 준비해야 하거든요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:84
translate kr primer_girl_troubles_2_menu_97eba329:

    # DIVINE @ talk "I want you to become their... Mentor."
    DIVINE @ talk "당신이 그들의... 멘토가 되어주길 바라요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:85
translate kr primer_girl_troubles_2_menu_592cb8fe:

    # MC @ surprised "Mentor? Me? I don't even possess any magecraft!"
    MC @ surprised "멘토요? 제가요? 저는 마법조차 쓸 줄 모르는데요!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:86
translate kr primer_girl_troubles_2_menu_f412c6a1:

    # DIVINE @ talk "Ah, but that's where you and your 'gift' come in nicely."
    DIVINE @ talk "아, 하지만 거기서 당신과 당신의 '재능'이 딱 들어맞아요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:87
translate kr primer_girl_troubles_2_menu_70c53a8b:

    # DIVINE @ talk "The Alderian government have refused to send me a mage capable of helping me, so I need the next best thing."
    DIVINE @ talk "알데리아 정부는 저를 도울 수 있는 마법사를 보내주길 거부했어요, 그래서 차선책이 필요해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:88
translate kr primer_girl_troubles_2_menu_560ed043:

    # DIVINE @ talk "Someone capable of really motivating these girls."
    DIVINE @ talk "이 소녀들에게 진정한 동기를 부여할 수 있는 사람이요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:89
translate kr primer_girl_troubles_2_menu_0d85e87a:

    # MC "(Meaning someone she can threaten to blackmail if I ever speak about what I see in here.)"
    MC "(즉, 내가 여기서 본 것에 대해 말하면 협박할 수 있는 사람이라는 뜻이군.)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:90
translate kr primer_girl_troubles_2_menu_59433de1:

    # MC @ talk "How am I supposed to do that?"
    MC @ talk "제가 어떻게 그걸 해내죠?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:91
translate kr primer_girl_troubles_2_menu_de2af97e:

    # DIVINE @ talk "The method doesn't concern me; as long as the girls aren't harmed, I don't care what you do. "
    DIVINE @ talk "방법은 상관없어요. 소녀들이 다치지만 않는다면, 당신이 뭘 하든 신경 쓰지 않아요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:92
translate kr primer_girl_troubles_2_menu_7d5dfde8:

    # DIVINE @ talk "For each girl dealt with, I'll give you seven hundred coins. Does that sound fair?"
    DIVINE @ talk "한 명당 처리할 때마다, 700코인을 드릴게요. 공정하게 들리나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:95
translate kr primer_girl_troubles_2_menu_2_270e239c:

    # DIVINE @ talk "Because I need someone I can trust with this,"
    DIVINE @ talk "왜냐하면 이 일을 맡길 수 있는 믿을 만한 사람이 필요하니까요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:96
translate kr primer_girl_troubles_2_menu_2_bf1e2acc:

    # DIVINE @ talk "And after hearing from Captain Nyx about your recent help with her, it only made sense to ask you."
    DIVINE @ talk "그리고 닉스 대장에게서 최근 그녀를 도운 이야기를 듣고 나니, 당신에게 부탁하는 게 당연했어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:97
translate kr primer_girl_troubles_2_menu_2_beee84fb:

    # MC @ talk "Wait ... Captain Nyx?"
    MC @ talk "잠깐... 닉스 대장이요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:98
translate kr primer_girl_troubles_2_menu_2_2010828e:

    # DIVINE @ talk "The Captain and I are ... {i}often aligned{/i} when necessary."
    DIVINE @ talk "대장과 저는... 필요할 때 {i}종종 뜻을 같이해요.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:99
translate kr primer_girl_troubles_2_menu_2_308a2582:

    # DIVINE @ talk "I'd hardly call us friends, but we've come to depend on each other's resources sometimes."
    DIVINE @ talk "친구라고 부르긴 어렵지만, 때때로 서로의 자원에 의지하게 되었어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:102
translate kr primer_girl_troubles_2_menu_2_c7d4f56a:

    # DIVINE @ talk "I mean, {i}I don't care what you do.{/i}"
    DIVINE @ talk "제 말은, {i}당신이 뭘 하든 상관없어요.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:103
translate kr primer_girl_troubles_2_menu_2_8cc9e6dd:

    # DIVINE @ talk "As long as they are not hurt, and you don't make a public spectacle of whatever you do with them, I only care about the end results."
    DIVINE @ talk "그들이 다치지 않고, 그들과 뭘 하든 공개적으로 떠벌리지만 않는다면, 저는 결과만 신경 써요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:106
translate kr primer_girl_troubles_2_menu_2_960647d4:

    # DIVINE @ talk "I cannot tell you until you agree to my request, but I will do my best to answer anymore questions you have."
    DIVINE @ talk "제 요청에 동의하기 전까지는 말씀드릴 수 없지만, 다른 질문이 있다면 최대한 답변해 드릴게요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:109
translate kr primer_girl_troubles_2_menu_3_7d9b1b5b:

    # MC @ talk "Mages of Palam are holy ordained, after all."
    MC @ talk "팔람의 마법사들은 결국 신성한 서품을 받은 자들이니까요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:110
translate kr primer_girl_troubles_2_menu_3_dfe1bc33:

    # DIVINE @ angry "It is shameful when you're praying for a strong male heir or a daughter that you can marry off to another rich noble."
    DIVINE @ angry "강한 남자 후계자나 다른 부유한 귀족에게 시집보낼 딸을 위해 기도하는 건 부끄러운 일이에요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:111
translate kr primer_girl_troubles_2_menu_3_a6aa2eef:

    # DIVINE @ talk "Us Mages of Palam are seen as a dead end."
    DIVINE @ talk "우리 팔람의 마법사들은 막다른 길로 여겨져요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:112
translate kr primer_girl_troubles_2_menu_3_5492d872:

    # MC @ talk "But can't Mages of Palam continue a bloodline?"
    MC @ talk "하지만 팔람의 마법사들도 혈통을 이을 수 있지 않나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:113
translate kr primer_girl_troubles_2_menu_3_778e69e4:

    # MC @ talk "You can sire young with women and can get pregnant yourselves, can you not?"
    MC @ talk "여자와 아이를 가질 수도 있고, 스스로 임신할 수도 있잖아요, 그렇지 않나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:114
translate kr primer_girl_troubles_2_menu_3_df70b7f3:

    # MC @ think "How then are you a dead end?"
    MC @ think "그렇다면 어떻게 막다른 길인가요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:115
translate kr primer_girl_troubles_2_menu_3_d60e62c4:

    # "Sister Divine smiled."
    "자매 디바인이 미소 지었다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:116
translate kr primer_girl_troubles_2_menu_3_b412a3ab:

    # DIVINE @ happy "It's best not to dwell on such things; we're an uncomfortable blot they've had to learn to accept and tolerate {i}on their terms.{/i}"
    DIVINE @ happy "그런 것에 연연하지 않는 게 좋아요. 우리는 그들이 {i}자기들 방식대로{/i} 받아들이고 용납하는 법을 배워야 했던 불편한 얼룩이니까요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:117
translate kr primer_girl_troubles_2_menu_3_7a2d28cb:

    # DIVINE @ talk "They prefer the fantasy of us as saint like beings, not real people with real wants and desires."
    DIVINE @ talk "그들은 우리가 진짜 원하는 것과 욕망을 가진 실제 사람이 아닌, 성자 같은 존재라는 환상을 선호해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:120
translate kr primer_girl_troubles_2_menu_3_6d652bd9:

    # DIVINE @ talk "Yes, to which I expect you to speak to no one."
    DIVINE @ talk "네, 그리고 이건 아무에게도 말하지 않길 바라요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:121
translate kr primer_girl_troubles_2_menu_3_198ed38b:

    # DIVINE @ talk "I cannot stress how important these families expect privacy."
    DIVINE @ talk "이 가문들이 사생활을 얼마나 중요하게 여기는지 강조할 수가 없어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:122
translate kr primer_girl_troubles_2_menu_3_1cf3949f:

    # DIVINE @ talk "If they believe we're making a spectacle, those {i}generous donations{/i} will very quickly dry up."
    DIVINE @ talk "우리가 추태를 부린다고 생각하면, 그 {i}관대한 기부금{/i}이 금방 말라버릴 거예요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:125
translate kr primer_girl_troubles_2_menu_3_186c3225:

    # DIVINE @ happy "Good, it pleases me to hear that."
    DIVINE @ happy "좋아요, 그 말을 들으니 기쁘네요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:126
translate kr primer_girl_troubles_2_menu_3_c4dc71ec:

    # MC @ talk "So what now?"
    MC @ talk "이제 어떻게 되나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:127
translate kr primer_girl_troubles_2_menu_3_1f4f778f:

    # DIVINE @ talk "Now you've agreed, I can talk more about the girls in question."
    DIVINE @ talk "이제 동의하셨으니, 문제의 소녀들에 대해 더 이야기할 수 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:128
translate kr primer_girl_troubles_2_menu_3_edbe2a65:

    # DIVINE @ talk "There's Jana, Zara and Mika."
    DIVINE @ talk "야나, 자라, 그리고 미카가 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:129
translate kr primer_girl_troubles_2_menu_3_a7336069:

    # DIVINE @ talk "Which one do you want to know about?"
    DIVINE @ talk "누구에 대해 알고 싶으세요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:133
translate kr primer_girl_troubles_2_menu_4_c8c3f0f1:

    # DIVINE @ talk "Ah, Jana Rosenval..."
    DIVINE @ talk "아, 야나 로젠발..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:134
translate kr primer_girl_troubles_2_menu_4_c2684d19:

    # DIVINE @ talk "Her abilities are extremely promising, and she is one of the highest potential candidates I've seen in years."
    DIVINE @ talk "그녀의 능력은 정말 유망하고, 제가 수년간 본 후보 중 가장 잠재력이 높은 사람 중 하나예요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:135
translate kr primer_girl_troubles_2_menu_4_53984bd0:

    # MC @ talk "Then what's the issue?"
    MC @ talk "그럼 뭐가 문제죠?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:136
translate kr primer_girl_troubles_2_menu_4_6461bc7c:

    # DIVINE @ angry "Her attitude."
    DIVINE @ angry "그녀의 태도요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:137
translate kr primer_girl_troubles_2_menu_4_0751d562:

    # DIVINE @ angry "She's been consistently troublesome for as long as I've known her, but the situation this last year has spiraled completely out of hand."
    DIVINE @ angry "제가 그녀를 안 이후로 계속 문제를 일으켜 왔는데, 지난해에는 상황이 완전히 통제 불능으로 치달았어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:138
translate kr primer_girl_troubles_2_menu_4_587a4d08:

    # MC @ talk "How {i}'out of hand?'{/i}"
    MC @ talk "얼마나 {i}'통제 불능'{/i}인가요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:139
translate kr primer_girl_troubles_2_menu_4_d7b30e0f:

    # DIVINE @ talk "Setting a lecture hall on fire, sneaking out and being caught dancing topless at a tavern, constantly getting it brawls with the other girls... The list goes on."
    DIVINE @ talk "강의실에 불을 지르고, 몰래 빠져나가 선술집에서 상의를 벗고 춤추다 들키고, 계속 다른 소녀들과 싸우고... 목록은 계속 이어져요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:140
translate kr primer_girl_troubles_2_menu_4_4890c460:

    # MC @ talk "Any idea what's causing the trouble?"
    MC @ talk "무엇이 문제를 일으키는지 짐작 가는 게 있나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:141
translate kr primer_girl_troubles_2_menu_4_3d603c8c:

    # DIVINE @ talk "She does come from a particularly {i}'troubled'{/i} home, and it's always been a difficult subject for her to talk about."
    DIVINE @ talk "그녀는 특히 {i}'문제 많은'{/i} 가정 출신이고, 그건 항상 그녀가 이야기하기 어려워하는 주제예요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:142
translate kr primer_girl_troubles_2_menu_4_fe36ef6d:

    # MC @ talk "How troubled?"
    MC @ talk "얼마나 문제가 많았나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:143
translate kr primer_girl_troubles_2_menu_4_08cdecc7:

    # DIVINE @ talk "There were signs of physical abuse, but she's never been willing to talk about it."
    DIVINE @ talk "신체적 학대의 징후가 있었지만, 그녀는 그것에 대해 결코 이야기하려 하지 않았어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:144
translate kr primer_girl_troubles_2_menu_4_d0271e56:

    # DIVINE @ talk "I need you to help curb her personality issues and deal with whatever's going on in her head."
    DIVINE @ talk "그녀의 성격 문제를 억제하고 머릿속에서 무슨 일이 일어나고 있는지 처리하는 걸 도와주셔야 해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:149
translate kr primer_girl_troubles_2_menu_4_5087813e:

    # DIVINE @ talk "Hm, yes, Zara Dawnmoore."
    DIVINE @ talk "흠, 네, 자라 돈무어."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:150
translate kr primer_girl_troubles_2_menu_4_15776ea7:

    # DIVINE @ talk "She comes from a wealthy aristocratic family from the south before the war forced them to flee North."
    DIVINE @ talk "그녀는 전쟁으로 인해 북쪽으로 도망쳐야 했던 남부의 부유한 귀족 가문 출신이에요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:151
translate kr primer_girl_troubles_2_menu_4_f90c3862:

    # DIVINE @ talk "She was a perfect student during her time here, consistently scoring highest on her arcane knowledge and abilities."
    DIVINE @ talk "여기 있는 동안 완벽한 학생이었고, 비전 지식과 능력에서 지속적으로 최고 점수를 받았어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:152
translate kr primer_girl_troubles_2_menu_4_8e5d193b:

    # DIVINE @ talk "Then, during the terminus ceremony, the {i}'incident'{/i} occurred."
    DIVINE @ talk "그러다가, 종결 의식 중에, 그 {i}'사건'{/i}이 일어났어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:153
translate kr primer_girl_troubles_2_menu_4_caee25ea:

    # MC @ think "The 'incident?'"
    MC @ think "'사건'이요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:154
translate kr primer_girl_troubles_2_menu_4_7a8a5198:

    # DIVINE @ talk "Before the ceremony, Zara was reported to be in high spirits, if a little tense and on edge."
    DIVINE @ talk "의식 전에, 자라는 약간 긴장하고 예민했지만 기분은 좋은 상태였다고 보고되었어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:155
translate kr primer_girl_troubles_2_menu_4_601dc7e4:

    # DIVINE @ talk "But the same could be said of any of the mages at the time, so it was dismissed as the usual pre-ceremony anxiety."
    DIVINE @ talk "하지만 그 당시 어떤 마법사에게도 같은 말을 할 수 있었기에, 의식 전의 평범한 불안으로 치부되었어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:156
translate kr primer_girl_troubles_2_menu_4_7d354705:

    # DIVINE @ talk "A short while after the ceremony, however, Zara received a letter from her parents, who couldn't attend."
    DIVINE @ talk "하지만 의식 후 얼마 지나지 않아, 자라는 참석하지 못한 부모님에게서 편지를 받았어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:157
translate kr primer_girl_troubles_2_menu_4_305b4b7a:

    # DIVINE @ talk "She burned the letter before anyone could read it, but whatever was in that letter triggered something within her."
    DIVINE @ talk "누구도 읽기 전에 편지를 불태워버렸지만, 그 편지에 있던 무언가가 그녀 안의 무언가를 촉발시켰어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:158
translate kr primer_girl_troubles_2_menu_4_11d29735:

    # DIVINE @ talk "In the night, she went on a rampage, attacking everyone in sight."
    DIVINE @ talk "그날 밤, 그녀는 광란에 빠져 눈에 보이는 모두를 공격했어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:159
translate kr primer_girl_troubles_2_menu_4_91d2d69a:

    # DIVINE @ talk "It took myself and two other high mages to restrain her abilities, and in the meanwhile, over a dozen students were hurt."
    DIVINE @ talk "나와 두 명의 고위 마법사가 그녀의 능력을 억제해야 했고, 그 사이에 12명이 넘는 학생들이 다쳤어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:160
translate kr primer_girl_troubles_2_menu_4_a4d6ed27:

    # DIVINE @ talk "We thought it might have been {i}'Mages madness,'{/i} but there was no sign of it."
    DIVINE @ talk "{i}'마법사의 광기'{/i}일지도 모른다고 생각했지만, 그 징후는 없었어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:161
translate kr primer_girl_troubles_2_menu_4_cffae37d:

    # MC @ talk "What was in the letter?"
    MC @ talk "편지에 뭐가 있었나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:162
translate kr primer_girl_troubles_2_menu_4_af9b8334:

    # DIVINE @ talk "We don't know, and Zara won't say."
    DIVINE @ talk "우리도 몰라요, 그리고 자라도 말하려 하지 않아요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:163
translate kr primer_girl_troubles_2_menu_4_b98ef904:

    # DIVINE @ talk "Now Zara is pretending she had some momentary lapse of judgment and is acting her usual self again."
    DIVINE @ talk "이제 자라는 일시적인 판단 착오였다고 가장하며 다시 평소의 자신처럼 행동하고 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:164
translate kr primer_girl_troubles_2_menu_4_42755e18:

    # DIVINE @ talk "I'm not going to risk sending her out knowing she could explode at any moment."
    DIVINE @ talk "언제든 폭발할 수 있다는 걸 알면서 그녀를 내보내는 위험을 감수하지 않을 거예요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:165
translate kr primer_girl_troubles_2_menu_4_3b071047:

    # MC @ talk "I don't remember hearing about this incident anywhere?"
    MC @ talk "이 사건에 대해 어디서 들은 기억이 없는데요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:166
translate kr primer_girl_troubles_2_menu_4_9d1d538f:

    # DIVINE @ talk "That's because we've buried it and managed the incident in-house ... For now, at least."
    DIVINE @ talk "우리가 그 사건을 묻어버리고 내부에서 처리했기 때문이에요... 적어도 지금은요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:167
translate kr primer_girl_troubles_2_menu_4_c4225b75:

    # DIVINE @ talk "I need you to get to the bottom of this issue and deal with it ... fast."
    DIVINE @ talk "이 문제의 진상을 파헤치고 처리해 주셔야 해요... 빨리요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:172
translate kr primer_girl_troubles_2_menu_4_1469252a:

    # DIVINE @ talk "Yes, Mika Ursan, a lovely girl."
    DIVINE @ talk "네, 미카 우르산, 사랑스러운 소녀예요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:173
translate kr primer_girl_troubles_2_menu_4_a993509d:

    # DIVINE @ talk "Afraid of her own shadow, but lovely."
    DIVINE @ talk "자기 그림자도 무서워하지만, 사랑스러워요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:174
translate kr primer_girl_troubles_2_menu_4_6e2f9ef2:

    # MC @ talk "{i}Afraid of her own shadow?{/i}"
    MC @ talk "{i}자기 그림자도 무서워한다고요?{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:175
translate kr primer_girl_troubles_2_menu_4_dd45cd20:

    # DIVINE @ laugh "I know, I know, but believe me—she panics at the sight of a sparring partner."
    DIVINE @ laugh "알아요, 알아요, 하지만 믿어주세요—대련 상대만 봐도 당황해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:176
translate kr primer_girl_troubles_2_menu_4_c2e8c608:

    # DIVINE @ talk "Mika's an odd case; her family adore her and refused to hand her over till much, {i}much{/i} later than we usually take on mages."
    DIVINE @ talk "미카는 특이한 경우예요. 가족들이 그녀를 너무 사랑해서, 우리가 보통 마법사를 받아들이는 시기보다 훨씬, {i}훨씬{/i} 늦게까지 넘겨주길 거부했어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:177
translate kr primer_girl_troubles_2_menu_4_cf3cdd5f:

    # DIVINE @ talk "As such, she has a strong natural sense of her abilities despite displaying very average arcane knowledge."
    DIVINE @ talk "그래서 그녀는 매우 평범한 비전 지식을 보여줌에도 불구하고, 자신의 능력에 대한 강한 자연스러운 감각을 가지고 있어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:178
translate kr primer_girl_troubles_2_menu_4_11d4c714:

    # MC @ talk "So, what's the issue?"
    MC @ talk "그래서, 뭐가 문제인가요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:179
translate kr primer_girl_troubles_2_menu_4_138e55c7:

    # DIVINE @ talk "{i}The girl is terrified of fighting...{/i}"
    DIVINE @ talk "{i}그 소녀는 싸우는 걸 극도로 무서워해요...{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:180
translate kr primer_girl_troubles_2_menu_4_154fbaad:

    # DIVINE @ talk "She completely failed in any and all practical combat training classes previously."
    DIVINE @ talk "이전의 모든 실전 전투 훈련 수업에서 완전히 낙제했어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:181
translate kr primer_girl_troubles_2_menu_4_bd85b2d5:

    # DIVINE @ talk "She just ... cowered."
    DIVINE @ talk "그냥... 움츠러들었어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:182
translate kr primer_girl_troubles_2_menu_4_9c43d061:

    # MC @ talk "Then how has she got this far?"
    MC @ talk "그런데 어떻게 여기까지 왔나요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:183
translate kr primer_girl_troubles_2_menu_4_5bcd82c2:

    # DIVINE @ talk "Because practical combat for mages of the Palam is the one thing you {i}can{/i} still fail at and still be allowed to serve in the rear as a healer."
    DIVINE @ talk "팔람의 마법사들에게 실전 전투는 {i}낙제해도{/i} 여전히 후방에서 치유사로 복무할 수 있는 유일한 것이기 때문이에요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:184
translate kr primer_girl_troubles_2_menu_4_6272c3d1:

    # DIVINE @ angry "Suffice it to say this push to get mages to the front in quantity rather than quality has been a great source of tension between the council of Mages and the Alderian government."
    DIVINE @ angry "질보다 양으로 마법사들을 전선에 보내려는 이 압박이 마법사 의회와 알데리아 정부 사이의 큰 긴장의 원천이었다고 말하면 충분할 거예요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:185
translate kr primer_girl_troubles_2_menu_4_86ac58e5:

    # DIVINE @ talk "Now, whilst combat isn't the priority for a mage of Palam, {i}I firmly believe every mage must be able to defend herself in times of crisis.{/i}"
    DIVINE @ talk "자, 전투가 팔람 마법사의 최우선은 아니지만, {i}저는 모든 마법사가 위기 상황에서 스스로를 지킬 수 있어야 한다고 굳게 믿어요.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:186
translate kr primer_girl_troubles_2_menu_4_99e3957b:

    # "Sister Divine's face fell darkly."
    "자매 디바인의 얼굴이 어둡게 가라앉았다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:187
translate kr primer_girl_troubles_2_menu_4_a90549ec:

    # DIVINE @ sad "If the recent deaths are anything to go by ... I've only been proven right."
    DIVINE @ sad "최근의 죽음들이 어떤 지표가 된다면... 내가 옳았다는 것만 증명되었을 뿐이에요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:188
translate kr primer_girl_troubles_2_menu_4_8ab36be3:

    # MC @ think "So, you want me to train the girl to fight?"
    MC @ think "그러니까, 제가 그 소녀에게 전투 훈련을 시키길 원하시는 거군요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:189
translate kr primer_girl_troubles_2_menu_4_bd65f2f7:

    # DIVINE @ talk "I need you to teach her to conquer her fears."
    DIVINE @ talk "그녀가 두려움을 극복하도록 가르쳐주셔야 해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:190
translate kr primer_girl_troubles_2_menu_4_d6ca7303:

    # DIVINE @ talk "She {i}has{/i} to be able to fight if the time comes."
    DIVINE @ talk "때가 오면 그녀는 {i}반드시{/i} 싸울 수 있어야 해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:191
translate kr primer_girl_troubles_2_menu_4_3a9c4c09:

    # MC @ talk "And if she refuses to listen? She's an adult now; she doesn't have to listen to either of us."
    MC @ talk "그리고 그녀가 말을 듣지 않으면요? 이제 성인인데, 우리 둘 중 누구의 말도 들을 필요가 없잖아요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:192
translate kr primer_girl_troubles_2_menu_4_88df11d8:

    # DIVINE @ talk "I don't care {i}how{/i} you get her to agree, but I need to know she can handle herself out there."
    DIVINE @ talk "{i}어떻게{/i} 동의를 얻어내든 상관없어요, 하지만 그녀가 밖에서 스스로 감당할 수 있다는 걸 알아야 해요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:199
translate kr primer_girl_troubles_2_menu_4_89c9874e:

    # DIVINE @ talk "Now then, should I introduce you to the girls?"
    DIVINE @ talk "자, 그럼 소녀들에게 소개해드릴까요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:202
translate kr primer_girl_troubles_2_menu_5_ecf2e41a:

    # DIVINE @ talk "Alright, which one?"
    DIVINE @ talk "좋아요, 누구부터?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:208
translate kr primer_girl_troubles_2_menu_5_190030f6:

    # DIVINE @ talk "Alright, come with me, I shall introduce you."
    DIVINE @ talk "좋아요, 따라오세요, 소개해드릴게요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:213
translate kr primer_girl_troubles_2_menu_5_29b7d599:

    # DIVINE @ talk "Return as soon as you can ... I want this trouble behind me sooner rather than later."
    DIVINE @ talk "가능한 한 빨리 돌아와주세요... 이 문제를 늦추지 않고 빨리 해결하고 싶어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:218
translate kr primer_girl_troubles_2_menu_5_1c582cf8:

    # DIVINE @ talk "Of course, but please, give me your answer soon ... Time is a luxury we don't have."
    DIVINE @ talk "물론이죠, 하지만 제발, 빨리 대답을 주세요... 시간은 우리에게 주어진 사치가 아니에요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:236
translate kr primer_girl_troubles_2_menu_5_aa4cc931:

    # "A short journey later to the girl's dorm..."
    "잠시 후, 소녀들의 기숙사로..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:237
translate kr primer_girl_troubles_2_menu_5_edf5f908:

    # "Upon entering the girls' dorm, the immediate warmth of the room hit me from the warm blazing fire."
    "소녀들의 기숙사에 들어서자마자, 따뜻하게 타오르는 불에서 나오는 온기가 나를 감쌌다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:238
translate kr primer_girl_troubles_2_menu_5_81e60903:

    # "We all knew mages had it easy compared to the rest of us, even young apprentices, but this was leaps and bounds ahead of my experiences."
    "우리 모두 마법사들이 우리 같은 일반인들보다 편하게 산다는 걸 알고 있었지만, 심지어 어린 견습생들조차도, 이곳은 내 경험과는 비교도 안 될 정도였다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:239
translate kr primer_girl_troubles_2_menu_5_7883e851:

    # DIVINE @ happy "Girls! Come!"
    DIVINE @ happy "얘들아! 이리 와!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:243
translate kr primer_girl_troubles_2_menu_5_40b40c14:

    # "Sister Divine clapped her hands, and two girls approached, one, the blonde, still yawning after she rolled herself off the side of her bed before dragging herself towards us."
    "자매 디바인이 손뼉을 치자 두 소녀가 다가왔다. 금발의 소녀는 침대 옆에서 굴러떨어진 후 하품을 하며 우리 쪽으로 몸을 질질 끌었다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:244
translate kr primer_girl_troubles_2_menu_5_7a248ec2:

    # "When the two girls saw me, the dark-haired one remained stoically unmoved, but the blonde blushed and smiled."
    "두 소녀가 나를 보았을 때, 검은 머리의 소녀는 냉정하게 무표정했지만, 금발의 소녀는 얼굴을 붉히며 미소 지었다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:245
translate kr primer_girl_troubles_2_menu_5_ce372275:

    # MIKA @ blush "Ooooh! H-Hello!"
    MIKA @ blush "우와! 아-안녕하세요!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:246
translate kr primer_girl_troubles_2_menu_5_ef151daf:

    # DIVINE @ think "Mika."
    DIVINE @ think "미카."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:247
translate kr primer_girl_troubles_2_menu_5_bc47b5bb:

    # MIKA @ shock "W-What I do this time?"
    MIKA @ shock "이-이번엔 제가 뭘 했는데요?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:248
translate kr primer_girl_troubles_2_menu_5_25c61541:

    # "The second, much more serious girl adjusted her glasses before speaking."
    "두 번째, 훨씬 더 진지한 소녀가 말하기 전에 안경을 고쳐 썼다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:249
translate kr primer_girl_troubles_2_menu_5_850b8b33:

    # ZARA @ talk "Try to control yourself, Mika."
    ZARA @ talk "자제하려고 노력해봐, 미카."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:250
translate kr primer_girl_troubles_2_menu_5_22480155:

    # MIKA @ angry "I - I was just saying hello!"
    MIKA @ angry "그-그냥 인사한 것뿐이야!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:251
translate kr primer_girl_troubles_2_menu_5_f57b3817:

    # MIKA @ sad "W-We never get any men visiting us hardly!"
    MIKA @ sad "우-우리한테 남자들이 찾아오는 일은 거의 없단 말이야!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:252
translate kr primer_girl_troubles_2_menu_5_8cd305e9:

    # MIKA @ blush "Especially not m-men so..."
    MIKA @ blush "특히나 그렇게... 남-남자는..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:253
translate kr primer_girl_troubles_2_menu_5_3c5d1011:

    # "A shy, blushing Mika averted her gaze and giggled lightly."
    "수줍고 얼굴이 붉어진 미카가 시선을 돌리며 살짝 웃었다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:254
translate kr primer_girl_troubles_2_menu_5_eb7cf5c5:

    # MIKA @ blush "Y-You look like you could plow a whole field with just one hand..."
    MIKA @ blush "당-당신은 한 손으로 밭 전체를 갈 수 있을 것처럼 보여요..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:258
translate kr primer_girl_troubles_2_menu_5_d68b4ad3:

    # "The other girl, Zara, lightly slapped Mika over the back of the head."
    "다른 소녀, 자라가 미카의 뒤통수를 살짝 때렸다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:259
translate kr primer_girl_troubles_2_menu_5_19af103e:

    # MIKA @ angry "O-Ow!"
    MIKA @ angry "아-아야!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:260
translate kr primer_girl_troubles_2_menu_5_d10b1262:

    # ZARA @ talk "We both know the only {i}field{/i} you want to have plowed isn't on any farm."
    ZARA @ talk "네가 갈고 싶어하는 유일한 {i}밭{/i}이 농장에 있지 않다는 건 우리 둘 다 알아."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:261
translate kr primer_girl_troubles_2_menu_5_42becbac:

    # MIKA @ angry "Grrrr!"
    MIKA @ angry "으르릉!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:262
translate kr primer_girl_troubles_2_menu_5_3191578c:

    # DIVINE @ angry "Oh, for the love of-"
    DIVINE @ angry "오, 제발-"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:263
translate kr primer_girl_troubles_2_menu_5_420b2e66:

    # DIVINE @ talk "Right, as I'm sure you've guessed, this is Mika and Zara."
    DIVINE @ talk "좋아요, 짐작하셨겠지만, 이쪽이 미카와 자라예요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:264
translate kr primer_girl_troubles_2_menu_5_1438940e:

    # MIKA @ smile "N-Nice to meet you!"
    MIKA @ smile "만-만나서 반갑습니다!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:265
translate kr primer_girl_troubles_2_menu_5_a52308f1:

    # ZARA @ talk "A pleasure, I'm sure."
    ZARA @ talk "영광이네요, 분명히."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:266
translate kr primer_girl_troubles_2_menu_5_8ae8cbb1:

    # DIVINE @ talk "This is [player_name!t]; he will be acting as my assistant for a while, so do treat him with the same respect as you would me."
    DIVINE @ talk "이쪽은 [player_name!t]입니다. 당분간 내 조수 역할을 할 테니, 나에게 하듯이 그에게도 똑같이 존중해주길 바라요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:267
translate kr primer_girl_troubles_2_menu_5_417c9081:

    # "The two girls seemed bewildered, though Mika let it show far more."
    "두 소녀는 당황한 듯 보였지만, 미카가 훨씬 더 티를 냈다."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:268
translate kr primer_girl_troubles_2_menu_5_1a6f6c22:

    # MIKA @ shock "H-HUH?!"
    MIKA @ shock "어-어?!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:269
translate kr primer_girl_troubles_2_menu_5_7543fc2a:

    # MIKA @ shock "You m-mean ... A MAN'S ACTUALLY GOING TO BE WORKING HERE?!"
    MIKA @ shock "그-그러니까... 진짜 남자가 여기서 일하게 된다고요?!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:270
translate kr primer_girl_troubles_2_menu_5_f897d4fa:

    # ZARA @ shock "Is this person even qualified? I don't sense any magecraft coming from the person."
    ZARA @ shock "이 사람 자격이라도 있는 건가요? 이 사람에게서는 어떤 마법도 느껴지지 않는데요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:271
translate kr primer_girl_troubles_2_menu_5_c8f907fe:

    # DIVINE @ talk "I assure you, Zara, there are no rules {i}requiring{/i} people to have magecraft to work within the tower, nor are men technically barred."
    DIVINE @ talk "장담하는데, 자라, 탑 안에서 일하기 위해 마법을 {i}갖춰야 한다는{/i} 규칙은 없어요. 남자들도 엄밀히 말하면 금지되어 있지 않아요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:272
translate kr primer_girl_troubles_2_menu_5_9723359e:

    # ZARA @ talk "Hmph ... Very well."
    ZARA @ talk "흥... 좋아요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:273
translate kr primer_girl_troubles_2_menu_5_fbeffd6d:

    # MIKA @ angry "Hey! We want {i}more{/i} men around here! Not less!"
    MIKA @ angry "이봐! 우린 여기에 남자가 {i}더{/i} 많아지길 원해! 더 적어지길 원하는 게 아니라!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:274
translate kr primer_girl_troubles_2_menu_5_06cffc58:

    # ZARA @ talk "All you think about is farming and flirting with boys!"
    ZARA @ talk "네가 생각하는 거라곤 농사랑 남자애들한테 추파 던지는 것뿐이잖아!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:275
translate kr primer_girl_troubles_2_menu_5_be482aca:

    # MIKA @ talk "T-That's not true! I think about - {i}*Yawn*{/i}"
    MIKA @ talk "그-그거 사실 아니야! 나는 - {i}*하품*{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:276
translate kr primer_girl_troubles_2_menu_5_7d9c27ba:

    # DIVINE @ talk "Mika, were you sleeping again?"
    DIVINE @ talk "미카, 또 잤어?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:277
translate kr primer_girl_troubles_2_menu_5_27f81d7f:

    # MIKA @ sad "N-No...?"
    MIKA @ sad "아-아뇨...?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:278
translate kr primer_girl_troubles_2_menu_5_2af4c1d3:

    # DIVINE @ angry "How convincing..."
    DIVINE @ angry "참 설득력 있네..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:279
translate kr primer_girl_troubles_2_menu_5_f626b5af:

    # ZARA @ talk "Mika tried to sneak out again under Jana's guidance."
    ZARA @ talk "미카가 야나의 지도 아래 또 몰래 빠져나가려고 했어요."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:280
translate kr primer_girl_troubles_2_menu_5_aecba179:

    # MIKA @ angry "N-No I didn't!"
