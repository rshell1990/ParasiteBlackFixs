translate kr palam_sewer_058d9062:

    # DIVINE "We could learn so much from each other..."
    DIVINE "우린 서로에게서 정말 많은 걸 배울 수 있어요..."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:138
translate kr palam_sewer_287684b0:

    # DIVINE "I’m glad to hear that."
    DIVINE "그 말을 들으니 기쁘네요."

