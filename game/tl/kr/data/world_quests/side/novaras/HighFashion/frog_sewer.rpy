translate kr palam_sewer_35eb4e4b:

    # DIVINE "It is my blessing to allow you to wander this tower at night."
    DIVINE "밤에 이 탑을 돌아다닐 수 있게 하는 나의 축복이에요."

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:145
translate kr palam_sewer_dcc31424:

