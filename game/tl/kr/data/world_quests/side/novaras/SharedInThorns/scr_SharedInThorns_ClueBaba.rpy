translate kr scr_SharedInThorns_babazhulClue_ed967cee:

    # BABAZHUL @ talk "Heh heh! Yes, the Thornfalls."
    BABAZHUL @ talk "헤헤! 그래, 쏜폴 가문."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:6
translate kr scr_SharedInThorns_babazhulClue_1365938c:

    # MC "How did you know?"
    MC "어떻게 알았지?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:7
translate kr scr_SharedInThorns_babazhulClue_2a995111:

    # BABAZHUL @ talk "Child, have you not learned by now such questions are meaningless?"
    BABAZHUL @ talk "꼬마야, 그런 질문이 무의미하다는 걸 아직 배우지 못했느냐?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:8
translate kr scr_SharedInThorns_babazhulClue_b95ab810:

    # BABAZHUL @ talk "You seek to know what shadow plagues their bloodline."
    BABAZHUL @ talk "너는 어떤 그림자가 그들의 혈통을 괴롭히는지 알고자 하는구나."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:9
translate kr scr_SharedInThorns_babazhulClue_61c059ed:

    # MC "So it is true then? They {i}are{/i} cursed?"
    MC "그럼 사실인 거군? 그들이 {i}정말{/i} 저주받은 거야?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:10
translate kr scr_SharedInThorns_babazhulClue_546d3509:

    # BABAZHUL @ talk "Such a strong word... {i}cursed.{/i}"
    BABAZHUL @ talk "참으로 강한 단어로구나... {i}저주받았다.{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:11
translate kr scr_SharedInThorns_babazhulClue_d9244649:

    # MC "Then what are they?"
    MC "그럼 그들은 뭐지?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:12
translate kr scr_SharedInThorns_babazhulClue_886a0001:

    # BABAZHUL @ talk "Hehehe!"
    BABAZHUL @ talk "헤헤헤!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:13
translate kr scr_SharedInThorns_babazhulClue_529086d3:

    # BABAZHUL @ talk "{i}...Elena.{/i}"
    BABAZHUL @ talk "{i}...엘레나.{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:14
translate kr scr_SharedInThorns_babazhulClue_40bb1387:

    # ELENA "..."
    ELENA "..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:15
translate kr scr_SharedInThorns_babazhulClue_4b083d31:

    # BABAZHUL @ talk "How long you have spent hiding your true self? Come girl."
    BABAZHUL @ talk "얼마나 오랫동안 네 진정한 모습을 숨겨왔느냐? 이리 오너라, 아가씨."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:16
translate kr scr_SharedInThorns_babazhulClue_745de6fa:

    # BABAZHUL @ talk "Show some courage and perhaps I might answer your questions."
    BABAZHUL @ talk "조금 용기를 보여라, 그러면 네 질문에 답해줄지도 모르지."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:17
translate kr scr_SharedInThorns_babazhulClue_5ea566b0:

    # "Standing onto her hind legs, Elena's body shifted and formed back into her humanoid shape."
    "뒷다리로 일어서며, 엘레나의 몸은 변형되어 인간형 모습으로 되돌아갔다."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:18
translate kr scr_SharedInThorns_babazhulClue_8815399f:

    # ELENA "Satisfied Soothsayer?"
    ELENA "만족하셨나, 예언자?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:19
translate kr scr_SharedInThorns_babazhulClue_26c77a63:

    # BABAZHUL @ talk "...Beautiful, such a shame to see one so hidden away from the world."
    BABAZHUL @ talk "...아름답구나, 이토록 세상으로부터 숨겨진 모습을 보니 안타까울 따름이야."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:20
translate kr scr_SharedInThorns_babazhulClue_c2f46f37:

    # ELENA "Enough games! You swore to answer our questions!"
    ELENA "장난은 됐다! 우리 질문에 답하겠다고 맹세했잖아!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:21
translate kr scr_SharedInThorns_babazhulClue_b7c939bc:

    # BABAZHUL @ talk "I swore nothing, only said I 'might' girl."
    BABAZHUL @ talk "아무것도 맹세한 적 없느니라, '그럴지도 모른다'고만 했을 뿐이야, 아가씨."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:23
translate kr scr_SharedInThorns_babazhulClue_9e4a55c9:

    # ELENA "She's just wasting our time, let's-"
    ELENA "그녀는 그냥 우리 시간만 낭비하고 있어, 그만-"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:30
translate kr scr_SharedInThorns_babazhulClue_fd8a7692:

    # BABAZHUL @ talk "Heed my words and listen close."
    BABAZHUL @ talk "내 말에 주의하고 귀 기울여라."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:31
translate kr scr_SharedInThorns_babazhulClue_1a717d08:

    # BABAZHUL_MAD @ talk "All this gold, such a delight!"
    BABAZHUL_MAD @ talk "이 모든 황금, 참으로 기쁘구나!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:32
translate kr scr_SharedInThorns_babazhulClue_e4dc13d4:

    # BABAZHUL_MAD @ talk "But fortune's favor, comes with a price!"
    BABAZHUL_MAD @ talk "그러나 행운의 은총에는, 대가가 따르느니!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:33
translate kr scr_SharedInThorns_babazhulClue_6f448fad:

    # BABAZHUL_MAD @ talk "Come darkness falls, the toll is paid."
    BABAZHUL_MAD @ talk "어둠이 내리면, 대가가 치러지고."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:34
translate kr scr_SharedInThorns_babazhulClue_fb0e204b:

    # BABAZHUL_MAD @ talk "Come morning light, their souls are saved."
    BABAZHUL_MAD @ talk "아침 빛이 오면, 그들의 영혼은 구원받느니라."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:40
translate kr scr_SharedInThorns_babazhulClue_0455f866:

    # MC "But what did any of that mean?"
    MC "하지만 그게 대체 무슨 뜻이지?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:41
translate kr scr_SharedInThorns_babazhulClue_e17785f2:

    # BABAZHUL @ talk "I can say no more..."
    BABAZHUL @ talk "더 이상 말할 수 없느니라..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:43
translate kr scr_SharedInThorns_babazhulClue_3a3bf1f6:

    # MC "(I need to talk to Elena later in private about what we've heard.)"
    MC "(나중에 엘레나와 단둘이 우리가 들은 것에 대해 이야기해야겠다.)"

