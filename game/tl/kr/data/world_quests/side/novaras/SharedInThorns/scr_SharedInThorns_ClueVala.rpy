translate kr scr_SharedInThorns_valaClue_cb1b3a90:

    # MC "(I believe so, but the full nature of it alludes me.)"
    MC "(그런 것 같아, 하지만 그 완전한 본질은 아직 파악이 안 돼.)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:41
translate kr scr_SharedInThorns_valaClue_892547e5:

    # MC @ talk "Elena, do you know anything about this?"
    MC @ talk "엘레나, 이거에 대해 아는 거 있어?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:42
translate kr scr_SharedInThorns_valaClue_c599e4cf:

    # "Elena barked and shook her head."
    "엘레나는 짖으며 고개를 저었다."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:43
translate kr scr_SharedInThorns_valaClue_4be6d7d8:

    # MC @ talk "Hm... Looks like we're going to need to keep digging."
    MC @ talk "흠... 계속 파고들어야 할 것 같군."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueVala.rpy:44
translate kr scr_SharedInThorns_valaClue_a1838ab7:

    # MC @ talk "And we're still no closer to finding the Lady Grace."
    MC @ talk "그리고 아직도 그레이스 아가씨를 찾는 데는 더 가까워지지 않았어."

