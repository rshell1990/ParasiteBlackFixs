translate kr scr_SharedInThorns_turnInClues_b3286ec9:

    # ELENA @ talk "What have we uncovered so far?"
    ELENA @ talk "지금까지 우리가 무엇을 밝혀냈지?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:5
translate kr scr_SharedInThorns_turnInClues_menu_e9309390:

    # ELENA @ grumpy "Yes, I believe you may be correct."
    ELENA @ grumpy "그래, 네 말이 맞을 수도 있겠어."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:6
translate kr scr_SharedInThorns_turnInClues_menu_b9939262:

    # MC @ talk "All four of his wives died under horrific circumstances during their pregnancies."
    MC @ talk "그의 네 아내 모두 임신 중에 끔찍한 상황에서 죽었어."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:7
translate kr scr_SharedInThorns_turnInClues_menu_41070ecc:

    # MC @ talk "Not to mention his sudden rise to fortune just before all the tragedy plagued his life..."
    MC @ talk "게다가 그 모든 비극이 그의 삶을 덮치기 직전에 갑작스럽게 재산을 얻었고..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:8
translate kr scr_SharedInThorns_turnInClues_menu_5d812c06:

    # MC @ talk "Very suspicious."
    MC @ talk "아주 수상해."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:9
translate kr scr_SharedInThorns_turnInClues_menu_f4c4dfd1:

    # ELENA @ shock "You don't think he made some kind of... 'deal' do you?"
    ELENA @ shock "설마 그가 무슨... '거래'를 한 건 아니라고 생각하는 거야?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:10
translate kr scr_SharedInThorns_turnInClues_menu_bbfd0c63:

    # MC @ talk "As in witchery or demonic?"
    MC @ talk "마법이나 악마적인 거래 말이야?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:11
translate kr scr_SharedInThorns_turnInClues_menu_ae1b86f1:

    # MC @ talk "Well, you knew the late Lord Vront personally."
    MC @ talk "뭐, 넌 고인이 된 브론트 경을 개인적으로 알았잖아."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:12
translate kr scr_SharedInThorns_turnInClues_menu_1e5423b5:

    # MC @ talk "Do you believe he would be capable of doing such a thing?"
    MC @ talk "그분이 그런 일을 할 수 있었을 거라고 생각해?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:13
translate kr scr_SharedInThorns_turnInClues_menu_d2e2eda0:

    # "Elena quickly became uncomfortable."
    "엘레나는 금세 불편해졌다."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:14
translate kr scr_SharedInThorns_turnInClues_menu_f5885cbb:

    # ELENA @ grumpy "I do not know."
    ELENA @ grumpy "모르겠어."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:15
translate kr scr_SharedInThorns_turnInClues_menu_82ff7447:

    # "Elena's face seemed to darken for a moment."
    "엘레나의 얼굴이 잠시 어두워지는 듯했다."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:16
translate kr scr_SharedInThorns_turnInClues_menu_d7c70547:

    # ELENA @ grumpy "{i}Trading the souls of your children for fortune... it... no....{/i}"
    ELENA @ grumpy "{i}재산을 위해 자식들의 영혼을 거래하다니... 그건... 아니야...{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:17
translate kr scr_SharedInThorns_turnInClues_menu_fc7faa7e:

    # ELENA @ shock "But what of the Lady Grace? Does she not disprove this?"
    ELENA @ shock "하지만 그레이스 아가씨는? 그녀가 이걸 반증하는 거 아니야?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:18
translate kr scr_SharedInThorns_turnInClues_menu_d14c5ac5:

    # MC @ talk "The lady Grace remains an enigma in this puzzle."
    MC @ talk "그레이스 아가씨는 이 수수께끼 속의 수수께끼로 남아있어."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:19
translate kr scr_SharedInThorns_turnInClues_menu_b96823d2:

    # MC @ talk "But the fact her mother was so unknown itself raises more questions than answers."
    MC @ talk "하지만 그녀의 어머니가 그토록 알려지지 않았다는 사실 자체가 답보다 더 많은 질문을 불러일으켜."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:20
translate kr scr_SharedInThorns_turnInClues_menu_a024cd7e:

    # ELENA @ sad "I... I see."
    ELENA @ sad "나... 그렇군."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:21
translate kr scr_SharedInThorns_turnInClues_menu_9aae5804:

    # ELENA @ talk "We need to keep digging, there has to be more."
    ELENA @ talk "계속 파고들어야 해, 분명 더 있을 거야."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:30
translate kr scr_SharedInThorns_turnInClues_menu_b8e5dbde:

    # ELENA @ talk "I was not privy to such information in my time at the Estate."
    ELENA @ talk "영지에 있을 때 나는 그런 정보를 알 수 있는 입장이 아니었어."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:31
translate kr scr_SharedInThorns_turnInClues_menu_89c1cc78:

    # ELENA @ talk "{i}Nor did I even know she had visited Ramon till now...{/i}"
    ELENA @ talk "{i}그녀가 라몬을 방문했다는 것조차 지금까지 몰랐어...{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:32
translate kr scr_SharedInThorns_turnInClues_menu_854e3f0c:

    # MC @ talk "Could she still be there now?"
    MC @ talk "그녀가 지금도 거기에 있을 수 있을까?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:33
translate kr scr_SharedInThorns_turnInClues_menu_62735895:

    # ELENA @ grumpy "It's possible..."
    ELENA @ grumpy "가능성은 있어..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:34
translate kr scr_SharedInThorns_turnInClues_menu_012585ee:

    # MC @ talk "Surely the lady Grace must have told you something?"
    MC @ talk "분명 그레이스 아가씨가 뭔가 말해주지 않았어?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:35
translate kr scr_SharedInThorns_turnInClues_menu_17f6ff97:

    # ELENA @ sad "We spoke of many things, but... She told me her work overseas was 'family business' and would elaborate no further."
    ELENA @ sad "많은 이야기를 나눴지만... 그녀는 해외 업무가 '가문의 일'이라고만 했고 더 이상 자세히 말해주지 않았어."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:36
translate kr scr_SharedInThorns_turnInClues_menu_53eee9e8:

    # MC @ talk "Knowing her father visited Ramon some years before, there must be some correlation."
    MC @ talk "그녀의 아버지가 몇 년 전에 라몬을 방문했다는 걸 알면, 분명 뭔가 연관성이 있을 거야."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:37
translate kr scr_SharedInThorns_turnInClues_menu_02296f17:

    # ELENA @ talk "I do not know, the late Lord Vronts years in Ramon were before my time, and he rarely spoke of them."
    ELENA @ talk "모르겠어, 고인이 된 브론트 경의 라몬 시절은 내가 있기 전의 일이었고, 그분은 그것에 대해 거의 말씀하지 않으셨어."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:38
translate kr scr_SharedInThorns_turnInClues_menu_e3e99c73:

    # MC @ talk "And what of the murders?"
    MC @ talk "그리고 살인 사건들은?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:39
translate kr scr_SharedInThorns_turnInClues_menu_61d4e752:

    # ELENA @ sad "W-We don't know for sure about that."
    ELENA @ sad "그-그건 확실히 알 수 없어."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:40
translate kr scr_SharedInThorns_turnInClues_menu_e2096d2a:

    # MC @ talk "Do you think Lord Vront would be willing to silence people to protect his secrets?"
    MC @ talk "브론트 경께서 비밀을 지키기 위해 사람들을 입막음할 의사가 있었을 거라고 생각해?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:41
translate kr scr_SharedInThorns_turnInClues_menu_7481503d:

    # ELENA @ sad "Perhaps Lord Vront but... The Lady Grace..."
    ELENA @ sad "브론트 경은 그럴지 몰라도... 그레이스 아가씨는..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:42
translate kr scr_SharedInThorns_turnInClues_menu_dd4dfd06:

    # MC @ talk "Hmm, I see."
    MC @ talk "흠, 그렇군."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:43
translate kr scr_SharedInThorns_turnInClues_menu_52f8ebd4:

    # ELENA @ talk "We need to find more, we must keep searching for answers."
    ELENA @ talk "더 찾아야 해, 계속 답을 찾아야만 해."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:52
translate kr scr_SharedInThorns_turnInClues_menu_f84d9b1d:

    # ELENA @ angry "The hag was simply toying with us."
    ELENA @ angry "그 노파는 우리를 그냥 가지고 논 거야."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:53
translate kr scr_SharedInThorns_turnInClues_menu_d5abdcfa:

    # MC @ talk "I don't believe it so."
    MC @ talk "난 그렇게 생각하지 않아."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:54
translate kr scr_SharedInThorns_turnInClues_menu_2872ab69:

    # ELENA @ angry "She has answers and withholds them! What more can be said?"
    ELENA @ angry "그녀는 답을 가지고 있으면서 숨기고 있어! 뭐 더 할 말이 있어?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:55
translate kr scr_SharedInThorns_turnInClues_menu_3ef40f06:

    # MC @ talk "{i}Come darkness falls, the toll is paid.{/i}"
    MC @ talk "{i}어둠이 내리면, 대가가 치러진다.{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:56
translate kr scr_SharedInThorns_turnInClues_menu_4a907f1d:

    # MC @ talk "{i}Come morning light, their souls are saved.{/i}"
    MC @ talk "{i}아침 빛이 오면, 그들의 영혼은 구원받는다.{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:57
translate kr scr_SharedInThorns_turnInClues_menu_3ed9e18a:

    # MC @ talk "Did you not mention that you were forbidden to leave your room at night?"
    MC @ talk "네가 밤에 방을 나가는 게 금지되었다고 말하지 않았나?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:58
translate kr scr_SharedInThorns_turnInClues_menu_59ded399:

    # ELENA @ shock "Y-Yes but-"
    ELENA @ shock "그-그래 하지만-"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:59
translate kr scr_SharedInThorns_turnInClues_menu_778bd68e:

    # MC @ talk "And the scratching at the door?"
    MC @ talk "그리고 문 긁는 소리는?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:60
translate kr scr_SharedInThorns_turnInClues_menu_ad01d605:

    # ELENA @ sad "You think the late Lord Vront... {i}was turning into a monster?{/i}"
    ELENA @ sad "네 생각에 고인이 된 브론트 경이... {i}괴물로 변해가고 있었던 거야?{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:61
translate kr scr_SharedInThorns_turnInClues_menu_38df1016:

    # MC @ talk "Did he ever mention anything of this nature?"
    MC @ talk "그분께서 이런 성격의 것을 언급한 적이 있나?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:62
translate kr scr_SharedInThorns_turnInClues_menu_59a2d3f0:

    # ELENA @ angry "No, of course not!"
    ELENA @ angry "아니, 당연히 아니지!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:63
translate kr scr_SharedInThorns_turnInClues_menu_63e7f92d:

    # ELENA @ sad "He... He said I needed to stay in my room for protection, that the surrounding lands were too dangerous at night because of bandits."
    ELENA @ sad "그분은... 보호를 위해 방에 있어야 한다고 하셨어, 주변 땅이 도적들 때문에 밤에 너무 위험하다고."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:64
translate kr scr_SharedInThorns_turnInClues_menu_e8b6a44d:

    # MC @ talk "Elena..."
    MC @ talk "엘레나..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:65
translate kr scr_SharedInThorns_turnInClues_menu_4f9398bb:

    # ELENA @ angry "Enough of this speculation!"
    ELENA @ angry "이런 추측은 됐어!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:66
translate kr scr_SharedInThorns_turnInClues_menu_118373c2:

    # ELENA @ grumpy "Let's... Let's just keep searching, shall we?"
    ELENA @ grumpy "그냥... 그냥 계속 찾아보자, 알겠지?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:75
translate kr scr_SharedInThorns_turnInClues_menu_730740a6:

    # ELENA @ talk "Very well, let's keep looking."
    ELENA @ talk "좋아, 계속 찾아보자."

