translate kr qst_HumanExp_6_cityTour_208990a5:

    # MC @ talk "Hundreds if not thousands are taught here every day."
    MC @ talk "수백 명은 아니더라도 수천 명이 매일 여기서 가르침을 받아."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:387
translate kr qst_HumanExp_6_cityTour_4667a551:

