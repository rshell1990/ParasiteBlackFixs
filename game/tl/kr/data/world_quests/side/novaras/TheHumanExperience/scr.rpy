translate kr qst_HumanExp_6_cityTour_2656b8c9:

    # MC @ talk "But those changes aren't the norm, more like, special circumstances."
    MC @ talk "하지만 그런 변화는 일반적이지 않아, 특별한 상황에 가깝지."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:395
translate kr qst_HumanExp_6_cityTour_d31503ba:

