translate kr qst_HumanExp_6_cityTour_dbf0e0be:

    # MYU "So, do rich students get jobs they don't like?"
    MYU "그래서, 부자 학생들은 싫어하는 직업을 가져?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:402
translate kr qst_HumanExp_6_cityTour_69419140:

