translate kr rom_Elena_WaterWarm_48305c90:

    # ELENA "I mean, it's clear there is {i}something{/i} more between us now than just companionship, right?"
    ELENA "그러니까, 지금 우리 사이에 동료 이상의 {i}무언가{/i}가 있다는 건 분명하지, 그렇지?"

# game/data/world_romance/elena/scr_2_WarmWater.rpy:39
translate kr rom_Elena_WaterWarm_602916a5:

    # ELENA "Why else would you join me like this?"
