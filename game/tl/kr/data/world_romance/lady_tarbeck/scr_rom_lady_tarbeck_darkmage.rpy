translate kr rom_tarbeck_darkmage_meet_manor_2107e4cd:


    LADY_TARBECK @ talk "They don't exactly advertise themselves..."


translate kr rom_tarbeck_darkmage_meet_manor_eca1c825:


    "Lady Tarbeck paused."


translate kr rom_tarbeck_darkmage_meet_manor_643d3560:


    MC @ talk "Why not just ask your husband to help you find-"


translate kr rom_tarbeck_darkmage_meet_manor_fab9c804:


