# game/engine/hamun_arena/arena_aio.rpy:296
translate kr hamun_arena_master_rank_advanced_09d632d7:

    # HAMUN_ARENA_MASTER "Enjoy your fame!"
    HAMUN_ARENA_MASTER "명성을 만끽하길!"

# game/engine/hamun_arena/arena_aio.rpy:297
translate kr hamun_arena_master_rank_advanced_fd8f1892:

    # HAMUN_ARENA_MASTER "...while it lasts."
    HAMUN_ARENA_MASTER "...지속되는 동안에나 말이지."

