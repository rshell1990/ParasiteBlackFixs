# game/engine/hamun_arena/arena_aio.rpy:154
translate kr hamun_arena_master_talk_first_time_b424163d:

    # HAMUN_ARENA_MASTER "Greetings... Are you here to watch a battle in the arena, or to rank?"
    HAMUN_ARENA_MASTER "반갑네... 투기장의 전투를 구경하러 왔나, 아니면 랭킹 등록인가?"

# game/engine/hamun_arena/arena_aio.rpy:155
translate kr hamun_arena_master_talk_first_time_5c68a77d:

    # MC @ talk "To rank."
    MC @ talk "랭킹 등록이요."

# game/engine/hamun_arena/arena_aio.rpy:156
translate kr hamun_arena_master_talk_first_time_8e665699:

    # HAMUN_ARENA_MASTER "Excellent."
    HAMUN_ARENA_MASTER "훌륭하군."

# game/engine/hamun_arena/arena_aio.rpy:157
translate kr hamun_arena_master_talk_first_time_b3a82bdf:

    # "The figure slid over some paperwork with an inked quill."
    "그는 먹물 깃펜으로 서류를 밀어 건넸다."

# game/engine/hamun_arena/arena_aio.rpy:158
translate kr hamun_arena_master_talk_first_time_c1906bc5:

    # HAMUN_ARENA_MASTER "Any questions?"
    HAMUN_ARENA_MASTER "질문 있나?"

# game/engine/hamun_arena/arena_aio.rpy:161
translate kr hamun_arena_master_questions_menu_first_time_94a74e82:

    # HAMUN_ARENA_MASTER "You pay in blood here."
    HAMUN_ARENA_MASTER "여기선 피로 값을 치르지."

# game/engine/hamun_arena/arena_aio.rpy:164
translate kr hamun_arena_master_questions_menu_first_time_beb6daa1:

    # HAMUN_ARENA_MASTER "There are five ranks within the arena."
    HAMUN_ARENA_MASTER "투기장에는 다섯 개의 랭크가 있다."

# game/engine/hamun_arena/arena_aio.rpy:165
translate kr hamun_arena_master_questions_menu_first_time_5d206716:

    # HAMUN_ARENA_MASTER "To move between ranks, you must defeat ten opponents in each rank."
    HAMUN_ARENA_MASTER "랭크를 올리려면 각 랭크에서 열 명의 상대를 격파해야 하지."

# game/engine/hamun_arena/arena_aio.rpy:166
translate kr hamun_arena_master_questions_menu_first_time_f1d4b60a:

    # HAMUN_ARENA_MASTER "Followed by a special match of our choosing."
    HAMUN_ARENA_MASTER "그 다음은 우리가 정한 특별 시합이 기다린다."

# game/engine/hamun_arena/arena_aio.rpy:167
translate kr hamun_arena_master_questions_menu_first_time_1b9223ca:

    # HAMUN_ARENA_MASTER "...As a word of warning, we may restrict your access to some of the higher ranks if we don't feel you're ready."
    HAMUN_ARENA_MASTER "...경고하자면, 네가 준비되지 않았다고 판단되면 상위 랭크 접근을 제한할 수도 있다."

# game/engine/hamun_arena/arena_aio.rpy:168
translate kr hamun_arena_master_questions_menu_first_time_5b2e12c5:

    # HAMUN_ARENA_MASTER "We want a glorious battle on the sand... not a bloody massacre before the audience even sits down."
    HAMUN_ARENA_MASTER "우리는 모래 위의 영광스러운 전투를 원하지... 관객들이 자리 잡기도 전에 벌어지는 피비린내 나는 학살은 필요 없으니까."

# game/engine/hamun_arena/arena_aio.rpy:171
translate kr hamun_arena_master_questions_menu_first_time_ab7228a3:

    # HAMUN_ARENA_MASTER "Monsters, warriors... strange creatures from faraway lands."
    HAMUN_ARENA_MASTER "괴물, 전사들... 머나먼 땅에서 온 기이한 생명체들."

# game/engine/hamun_arena/arena_aio.rpy:172
translate kr hamun_arena_master_questions_menu_first_time_0fec0d5e:

    # HAMUN_ARENA_MASTER "Whatever we think will draw in the most crowds."
    HAMUN_ARENA_MASTER "가장 많은 관중을 끌어들일 만한 것들이라면 뭐든."

# game/engine/hamun_arena/arena_aio.rpy:175
translate kr hamun_arena_master_questions_menu_first_time_88523b26:

    # HAMUN_ARENA_MASTER "The higher the ranked matches, the higher the coin."
    HAMUN_ARENA_MASTER "랭크가 높은 시합일수록, 더 많은 코인이 따라온다."

# game/engine/hamun_arena/arena_aio.rpy:176
translate kr hamun_arena_master_questions_menu_first_time_5c0ba242:

    # HAMUN_ARENA_MASTER "Though sometimes, rewards may be offered in place of coin."
    HAMUN_ARENA_MASTER "가끔은 코인 대신 다른 보상이 주어질 수도 있고."

# game/engine/hamun_arena/arena_aio.rpy:179
translate kr hamun_arena_master_questions_menu_first_time_0197c051:

    # HAMUN_ARENA_MASTER "Good... Now shall we discuss arranging a match?"
    HAMUN_ARENA_MASTER "좋아... 그럼 이제 시합 일정을 잡아볼까?"

# game/engine/hamun_arena/arena_aio.rpy:185
translate kr hamun_arena_master_talk_aaca8c6f:

    # HAMUN_ARENA_MASTER "Yes?"
    HAMUN_ARENA_MASTER "뭔가?"

# game/engine/hamun_arena/arena_aio.rpy:187
translate kr hamun_arena_master_talk_8a0e5bbb:

    # HAMUN_ARENA_MASTER "Yes, Sun Forged?"
    HAMUN_ARENA_MASTER "뭔가, 선 포지드?"

# game/engine/hamun_arena/arena_aio.rpy:194
translate kr hamun_arena_master_signup_449b8311:

    # HAMUN_ARENA_MASTER "The sun is set, it's too late now."
    HAMUN_ARENA_MASTER "해가 졌네, 지금은 너무 늦었어."

# game/engine/hamun_arena/arena_aio.rpy:195
translate kr hamun_arena_master_signup_989e2dce:

    # HAMUN_ARENA_MASTER "Come back tomorrow."
    HAMUN_ARENA_MASTER "내일 다시 오게."

# game/engine/hamun_arena/arena_aio.rpy:198
translate kr hamun_arena_master_signup_bfaf9441:

    # HAMUN_ARENA_MASTER "The crowd have seen enough of you for today, warrior."
    HAMUN_ARENA_MASTER "오늘 관중들은 자네를 충분히 봤네, 전사여."

# game/engine/hamun_arena/arena_aio.rpy:199
translate kr hamun_arena_master_signup_2d4f6bd9:

    # HAMUN_ARENA_MASTER "Come back tomorrow for another fight."
    HAMUN_ARENA_MASTER "다음 싸움은 내일 하러 오게."

# game/engine/hamun_arena/arena_aio.rpy:201
translate kr hamun_arena_master_signup_54e5c8f4:

    # HAMUN_ARENA_MASTER "Heh... Whose blood shall stain the sacred sands, then?"
    HAMUN_ARENA_MASTER "흐흐... 그럼 누구의 피가 신성한 모래를 물들일까?"

# game/engine/hamun_arena/arena_aio.rpy:228
translate kr hamun_arena_master_signup_aa724bd9:

    # HAMUN_ARENA_MASTER "Stop wasting my time."
    HAMUN_ARENA_MASTER "내 시간 낭비하지 말게."

# game/engine/hamun_arena/arena_aio.rpy:294
translate kr hamun_arena_master_rank_advanced_4c202287:

    # HAMUN_ARENA_MASTER "Quite a fight, warrior!"
    HAMUN_ARENA_MASTER "꽤 괜찮은 싸움이었어, 전사여!"

# game/engine/hamun_arena/arena_aio.rpy:295
translate kr hamun_arena_master_rank_advanced_ee81b14e:

    # HAMUN_ARENA_MASTER "You are now ranked {i}Sun Forged{/i}."
