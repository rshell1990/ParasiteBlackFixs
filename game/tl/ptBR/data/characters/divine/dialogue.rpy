# game/data/characters/divine/dialogue.rpy:28
translate ptBR divine_talk_90c8d59c:

    # DIVINE "How can I help you, child?"
    DIVINE "Como posso ajudá-lo, criança?"

# game/data/characters/divine/dialogue.rpy:33
translate ptBR divine_bye_65c4d26d:

    # DIVINE "Be well, child."
    DIVINE "Fique bem, criança."

# game/data/characters/divine/dialogue.rpy:38
translate ptBR divine_questions1_528d4f7e:

    # DIVINE "You’ve come here for a lesson?"
    DIVINE "Você veio aqui para uma lição?"

# game/data/characters/divine/dialogue.rpy:39
translate ptBR divine_questions1_b6ffd923:

    # MC "I know the basics..."
    MC "Sei o básico..."

# game/data/characters/divine/dialogue.rpy:40
translate ptBR divine_questions1_81705d71:

    # DIVINE "... It is said the great goddess Palam was born Palon, God of Love."
    DIVINE "... Diz-se que a grande deusa Palam nasceu Palon, Deus do Amor."

# game/data/characters/divine/dialogue.rpy:41
translate ptBR divine_questions1_2fb56672:

    # DIVINE "Palon watched and meddled in the romantic affairs of both our realm and the realm of the gods. "
    DIVINE "Palon observava e se intrometia nos assuntos românticos tanto do nosso reino quanto do reino dos deuses."

# game/data/characters/divine/dialogue.rpy:42
translate ptBR divine_questions1_1687c0e9:

    # DIVINE "Uniting couples rarely thought a good match by many, but he always knew better."
    DIVINE "Unindo casais que raramente eram considerados uma boa combinação por muitos, mas ele sempre soube mais."

# game/data/characters/divine/dialogue.rpy:43
translate ptBR divine_questions1_197036a6:

    # DIVINE "... But Palon was displeased with his form... He wanted his outer beauty to reflect the inner love he lavished upon us Alderians."
    DIVINE "... Mas Palon estava insatisfeito com sua forma... Ele queria que sua beleza exterior refletisse o amor interior que ele derramava sobre nós, os Alderianos."

# game/data/characters/divine/dialogue.rpy:44
translate ptBR divine_questions1_d31444e6:

    # DIVINE "Envious of the female forms around him and feeling trapped in despair at the male form he occupied, he cast himself into the Great Blue Lagoon, emerging as the beautiful goddess Palam."
    DIVINE "Invejoso das formas femininas ao seu redor e sentindo-se preso em desespero na forma masculina que ocupava, ele se lançou na Grande Lagoa Azul, emergindo como a bela deusa Palam."

# game/data/characters/divine/dialogue.rpy:45
translate ptBR divine_questions1_88ca4f57:

    # DIVINE "The great goddess Palam bestows upon those born with her favour the greatest powers of healing in the realm."
    DIVINE "A grande deusa Palam concede àqueles que nascem com seu favor os maiores poderes de cura do reino."

# game/data/characters/divine/dialogue.rpy:46
translate ptBR divine_questions1_91554ae3:

    # DIVINE "Through her wisdom and guidance, our bodies are also changed to her desired form."
    DIVINE "Através de sua sabedoria e orientação, nossos corpos também são transformados na forma desejada por ela."

# game/data/characters/divine/dialogue.rpy:47
translate ptBR divine_questions1_7a9989a8:

    # MC "Is that why all the mages under her blessing were born as... born as..."
    MC "É por isso que todos os magos sob sua bênção nasceram como... nasceram como..."

# game/data/characters/divine/dialogue.rpy:48
translate ptBR divine_questions1_d23314df:

    # DIVINE "... Men?"
    DIVINE "... Homens?"

# game/data/characters/divine/dialogue.rpy:49
translate ptBR divine_questions1_07266d13:

    # MC "Yes."
    MC "Sim."

# game/data/characters/divine/dialogue.rpy:50
translate ptBR divine_questions1_8241ba3e:

    # DIVINE "We all were once... But once the change has begun there is little difference."
    DIVINE "Todos nós já fomos uma vez... Mas uma vez que a mudança começa, há pouca diferença."

# game/data/characters/divine/dialogue.rpy:51
translate ptBR divine_questions1_85be0231:

    # MC "But you have... {i}*Cough*{/i}"
    MC "Mas você tem... {i}*Tosse*{/i}"

# game/data/characters/divine/dialogue.rpy:52
translate ptBR divine_questions1_7aa6d0fb:

    # "Sister Divine raised an eyebrow and smirked as I tripped over the words. "
    "Irmã Divine ergueu uma sobrancelha e sorriu maliciosamente quando tropecei nas palavras."

# game/data/characters/divine/dialogue.rpy:53
translate ptBR divine_questions1_84878a10:

    # DIVINE "{i}Both sets?{/i}"
    DIVINE "{i}Ambos os conjuntos?{/i}"

# game/data/characters/divine/dialogue.rpy:54
translate ptBR divine_questions1_054508a6:

    # MC "U-Uhh... Well..."
    MC "U-Uhh... Bem..."

# game/data/characters/divine/dialogue.rpy:55
translate ptBR divine_questions1_cf86a073:

    # MC "That... must be difficult."
    MC "Isso... deve ser difícil."

# game/data/characters/divine/dialogue.rpy:56
translate ptBR divine_questions1_365ffb04:

    # "Sister Divine smiled mischievously as she leaned forward."
    "Irmã Divine sorriu travessamente enquanto se inclinava para frente."

# game/data/characters/divine/dialogue.rpy:57
translate ptBR divine_questions1_b1140467:

    # DIVINE "If you’re that curious, why don’t you ask one of our mages?"
    DIVINE "Se você está tão curioso, por que não pergunta a um dos nossos magos?"

# game/data/characters/divine/dialogue.rpy:58
translate ptBR divine_questions1_1c2f036e:

    # DIVINE "Our goddess, unlike most, demands we take no vows of chastity, you know..."
    DIVINE "Nossa deusa, ao contrário da maioria, exige que não façamos votos de castidade, sabia..."

# game/data/characters/divine/dialogue.rpy:59
translate ptBR divine_questions1_61f8f826:

    # "Sister Divine playfully winked before her back straightened once again."
    "Irmã Divine piscou de forma brincalhona antes de endireitar as costas novamente."

# game/data/characters/divine/dialogue.rpy:62
translate ptBR divine_questions1_f399730a:

    # "She laughed at the comment."
    "Ela riu do comentário."

# game/data/characters/divine/dialogue.rpy:63
translate ptBR divine_questions1_eea35513:

    # DIVINE "{i}Interesting...{/i}"
    DIVINE "{i}Interessante...{/i}"

# game/data/characters/divine/dialogue.rpy:64
translate ptBR divine_questions1_04e3a2bf:

    # "Her eyes scanned over me, almost dismissively."
    "Seus olhos me examinaram, quase com desdém."

# game/data/characters/divine/dialogue.rpy:70
translate ptBR divine_questions2_3054d177:

    # DIVINE "There is only ever a few hundred of us at one time... As the goddess wills..."
    DIVINE "Nunca há mais do que algumas centenas de nós de cada vez... Como a deusa deseja..."

# game/data/characters/divine/dialogue.rpy:71
translate ptBR divine_questions2_5a08631f:

    # MC "Why?"
    MC "Por quê?"

# game/data/characters/divine/dialogue.rpy:72
translate ptBR divine_questions2_ef2c2d25:

    # DIVINE "We do not know... Only some are chosen, it’s not our place to question her decisions."
    DIVINE "Não sabemos... Apenas alguns são escolhidos, não nos cabe questionar suas decisões."

# game/data/characters/divine/dialogue.rpy:77
translate ptBR divine_firstmeet_28ad9124:

    # "The beautiful Mages of Palam, for all accounts were still human, though no cursory glance would make this obvious."
    "As belas Magas de Palam, para todos os efeitos, ainda eram humanas, embora nenhum olhar superficial tornasse isso óbvio."

# game/data/characters/divine/dialogue.rpy:78
translate ptBR divine_firstmeet_18aa2714:

    # "Born with the blessings of the goddess Palam, their bodies were morphed and now bore a blue complexion the goddess’ divine will moulds those chosen into her most desired form and then blesses them with her gift of divine healing."
    "Nascidas com as bênçãos da deusa Palam, seus corpos foram transformados e agora ostentavam uma tez azulada; a vontade divina da deusa molda as escolhidas em sua forma mais desejada e então as abençoa com seu dom de cura divina."

# game/data/characters/divine/dialogue.rpy:79
translate ptBR divine_firstmeet_587bb450:

    # "It is a place of ancient tradition, libraries of books piled high and strange hieroglyphs and runes on the floor in chalk that glowed different shades. "
    "É um lugar de tradição antiga, bibliotecas de livros empilhados até o alto e estranhos hieróglifos e runas no chão em giz que brilhavam em diferentes tons."

# game/data/characters/divine/dialogue.rpy:80
translate ptBR divine_firstmeet_67703533:

    # "Taking centre stage was a great statue of the goddess Palam, her arms and wings outstretched. Here and there I glimpsed robed figures, their soft, blue faces barely visible before they quickly shuffled away with their spell books. "
    "Ocupando o centro estava uma grande estátua da deusa Palam, com seus braços e asas estendidos. Aqui e ali, vislumbrei figuras encapuzadas, seus rostos suaves e azulados mal visíveis antes de se afastarem rapidamente com seus livros de feitiços."

# game/data/characters/divine/dialogue.rpy:81
translate ptBR divine_firstmeet_95f6331a:

    # "A voice called out, sultry, but mature with age. "
    "Uma voz chamou, sensual, mas madura com a idade."

# game/data/characters/divine/dialogue.rpy:82
translate ptBR divine_firstmeet_216aba99:

    # UNKNOWN "... Quite the sight, is it not?"
    UNKNOWN "... Que visão, não é?"

# game/data/characters/divine/dialogue.rpy:84
translate ptBR divine_firstmeet_44548582:

    # "I turned to look at the beautiful figure before me."
    "Me virei para olhar a bela figura diante de mim."

# game/data/characters/divine/dialogue.rpy:85
translate ptBR divine_firstmeet_696b9602:

    # MC "Oh, I’m sorry I didn’t see you there, sister."
    MC "Oh, desculpe, não a vi ali, irmã."

# game/data/characters/divine/dialogue.rpy:86
translate ptBR divine_firstmeet_d9b3b42c:

    # DIVINE "You may call me Sister Divine... Now..."
    DIVINE "Pode me chamar de Irmã Divine... Agora..."

