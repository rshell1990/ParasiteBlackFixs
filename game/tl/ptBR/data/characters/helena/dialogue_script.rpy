    # HELENA @ talk "Ahh, good evening sir."
    HELENA @ talk "Ahh, boa noite senhor."

# game/data/characters/helena/dialogue_script.rpy:5
translate ptBR nov_helena_firstmeet_fcddae28:

    # HELENA @ talk "How do you find yourself this Evening?"
    HELENA @ talk "Como você se encontra esta noite?"

# game/data/characters/helena/dialogue_script.rpy:6
translate ptBR nov_helena_firstmeet_e63ccf3e:

    # HELENA @ smile "I am Helena, and yourself?"
    HELENA @ smile "Sou Helena, e você?"

# game/data/characters/helena/dialogue_script.rpy:7
translate ptBR nov_helena_firstmeet_638d46d2:

    # MC @ talk "A pleasure to meet you Helena, I am called [player_name!t]."
    MC @ talk "Um prazer conhecê-la Helena, me chamam de [player_name!t]."

# game/data/characters/helena/dialogue_script.rpy:8
translate ptBR nov_helena_firstmeet_48a9321b:

    # HELENA @ talk "Hmm, your name sounds familiar..."
    HELENA @ talk "Hmm, seu nome soa familiar..."

# game/data/characters/helena/dialogue_script.rpy:9
translate ptBR nov_helena_firstmeet_4659a883:

    # HELENA @ shock "Wait, I know of you."
    HELENA @ shock "Espere, eu conheço você."

# game/data/characters/helena/dialogue_script.rpy:10
translate ptBR nov_helena_firstmeet_e1f13c50:

    # HELENA @ talk "You and your friend are the scouts who survived the recent expedition."
    HELENA @ talk "Você e seu amigo são os batedores que sobreviveram à expedição recente."

# game/data/characters/helena/dialogue_script.rpy:11
translate ptBR nov_helena_firstmeet_d2fa7c7f:

    # HELENA @ lewd "I see they did not exagerrate when they spoke of how handsome you are."
    HELENA @ lewd "Vejo que não exageraram quando falaram de como você é bonito."

# game/data/characters/helena/dialogue_script.rpy:17
translate ptBR nov_helena_services_c3c21da7:

    # HELENA @ talk "I am afraid my services aren't for you."
    HELENA @ talk "Temo que meus serviços não são para você."

# game/data/characters/helena/dialogue_script.rpy:18
translate ptBR nov_helena_services_c513028d:

    # MC @ talk "Wait, what?"
    MC @ talk "Espera, o quê?"

# game/data/characters/helena/dialogue_script.rpy:19
translate ptBR nov_helena_services_46c3977b:

    # HELENA @ smile "My clients are a small reserved of a certain social class."
    HELENA @ smile "Meus clientes são um grupo reservado de uma certa classe social."

# game/data/characters/helena/dialogue_script.rpy:20
translate ptBR nov_helena_services_1a47015e:

    # HELENA @ talk "Only a certain social class I'm afraid."
    HELENA @ talk "Apenas uma certa classe social, infelizmente."

# game/data/characters/helena/dialogue_script.rpy:21
translate ptBR nov_helena_services_2a12bf32:

    # MC @ talk "You mean aristocrats and nobles then?"
    MC @ talk "Você quer dizer aristocratas e nobres, então?"

# game/data/characters/helena/dialogue_script.rpy:22
translate ptBR nov_helena_services_052927c7:

    # HELENA @ lewd2 "Not necessarily... I make special priced exceptions for men who have truly carved out a name for themselves."
    HELENA @ lewd2 "Não necessariamente... Faço exceções de preço para homens que realmente construíram um nome."

# game/data/characters/helena/dialogue_script.rpy:23
translate ptBR nov_helena_services_074a27e5:

    # HELENA @ smile "Men who get tongues wagging when they see me speaking with them."
    HELENA @ smile "Homens que fazem as línguas se mexerem quando me veem falando com eles."

# game/data/characters/helena/dialogue_script.rpy:24
translate ptBR nov_helena_services_aa047f0d:

    # MC @ talk "Such as?"
    MC @ talk "Como quais?"

# game/data/characters/helena/dialogue_script.rpy:25
translate ptBR nov_helena_services_a5c33d70:

    # HELENA @ smile "I never kiss and tell."
    HELENA @ smile "Nunca beijo e conto."

# game/data/characters/helena/dialogue_script.rpy:26
translate ptBR nov_helena_services_ca2c4f8b:

    # HELENA @ joy "But let's just say some adventurers who'd rather have their names kept a secret have come to me before."
    HELENA @ joy "Mas digamos que alguns aventureiros que preferem manter seus nomes em segredo já vieram a mim antes."

# game/data/characters/helena/dialogue_script.rpy:27
translate ptBR nov_helena_services_60e8bb1f:

    # MC @ talk "Humor me, what are your normal prices."
    MC @ talk "Me diga, quais são seus preços normais."

# game/data/characters/helena/dialogue_script.rpy:28
translate ptBR nov_helena_services_e1271a49:

    # HELENA @ smile "A night with me would cost you more than ten thousand coins."
    HELENA @ smile "Uma noite comigo custaria mais de dez mil moedas."

# game/data/characters/helena/dialogue_script.rpy:29
translate ptBR nov_helena_services_74ca5542:

    # "I felt the blood drain from my face."
    "Senti o sangue sumir do meu rosto."

# game/data/characters/helena/dialogue_script.rpy:30
translate ptBR nov_helena_services_0449bb90:

    # MC @ talk "T-Ten... thousand?"
    MC @ talk "D-Dez... mil?"

# game/data/characters/helena/dialogue_script.rpy:31
translate ptBR nov_helena_services_99b30993:

    # MC @ talk "What about charging per act?"
    MC @ talk "Que tal cobrar por ato?"

# game/data/characters/helena/dialogue_script.rpy:32
translate ptBR nov_helena_services_307909da:

    # HELENA @ talk "I'm afraid such a thing is far more becoming of a common whore than a courtesan."
    HELENA @ talk "Temo que isso seja muito mais adequado para uma prostituta comum do que para uma cortesã."

# game/data/characters/helena/dialogue_script.rpy:33
translate ptBR nov_helena_services_9bb1df98:

    # HELENA @ talk "The clients a courtesan takes on expect us to be more reserved and discreit, our bodies not used by every passing traveler."
    HELENA @ talk "Os clientes de uma cortesã esperam que sejamos mais reservadas e discretas, nossos corpos não usados por qualquer viajante."

# game/data/characters/helena/dialogue_script.rpy:34
translate ptBR nov_helena_services_f2a6779b:

    # HELENA @ sad "Such a thing could ruin a courtesan's reputation should she behave like an ordinary lady of the night."
    HELENA @ sad "Isso poderia arruinar a reputação de uma cortesã se ela se comportasse como uma dama da noite comum."

# game/data/characters/helena/dialogue_script.rpy:35
translate ptBR nov_helena_services_326690ca:

    # HELENA @ talk "Thus, our companionship is sold for the whole evening... Partly to avoid too much scrutiny."
    HELENA @ talk "Assim, nossa companhia é vendida para a noite inteira... Em parte para evitar muito escrutínio."

# game/data/characters/helena/dialogue_script.rpy:36
translate ptBR nov_helena_services_dc064c48:

    # HELENA @ smile "And sometimes our clients simply want us to be a delight on their arms and make other lords and such jealous."
    HELENA @ smile "E às vezes nossos clientes simplesmente nos querem como um deleite em seus braços para deixar outros lordes com ciúmes."

# game/data/characters/helena/dialogue_script.rpy:37
translate ptBR nov_helena_services_dd4dfd06:

    # MC @ talk "Hmm, I see."
    MC @ talk "Hmm, entendo."

# game/data/characters/helena/dialogue_script.rpy:38
translate ptBR nov_helena_services_771bb20d:

    # MC "(Unless I want to spend a small fortune on her, I'll need to build my reputation through adventuring and such before she offers me better rates for her 'sevices'.)"
    MC "(A menos que eu queira gastar uma pequena fortuna com ela, precisarei construir minha reputação através de aventuras e tal antes que ela me ofereça melhores preços por seus 'serviços'.)"

# game/data/characters/helena/dialogue_script.rpy:42
translate ptBR nov_helena_about_a754025e:

    # HELENA @ talk "Hm? I prefer to keep my past to myself... I find men are more drawn to what they see as some alluring mystery."
    HELENA @ talk "Hm? Prefiro manter meu passado para mim... Acho que homens são mais atraídos pelo que veem como um mistério sedutor."

# game/data/characters/helena/dialogue_script.rpy:43
translate ptBR nov_helena_about_8999f46f:

    # HELENA @ lewd2 "Perhaps one day I will tell you."
    HELENA @ lewd2 "Talvez um dia eu te conte."

# game/data/characters/helena/dialogue_script.rpy:47
translate ptBR nov_helena_bye_a0f4734c:

    # HELENA @ talk "Speak soon."
    HELENA @ talk "Falo em breve."

