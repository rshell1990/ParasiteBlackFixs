    MC @ talk "Huh? Já nos encontramos antes?"

# game/data/characters/kylisa/dialogue.rpy:186
translate ptBR nov_kylisa_firstmeet_c69e673f:

    # KYLISA @ smile "Have you forgotten so quickly when I helped tend to your wounds?"
    KYLISA @ smile "Você já esqueceu tão rápido quando eu ajudei a cuidar de seus ferimentos?"

# game/data/characters/kylisa/dialogue.rpy:187
