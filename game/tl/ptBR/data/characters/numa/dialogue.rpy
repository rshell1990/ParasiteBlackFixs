translate ptBR numa_moreaboutpeople_4dff1363:

    # NUMA @ talk "Speak the wave, and I shall answer."
    NUMA @ talk "Fale a onda, e eu responderei."

# game/data/characters/numa/dialogue.rpy:68
translate ptBR numa_moreaboutpeople_menu_f26655da:

    # NUMA @ talk "Once a month, our people wash up on the docks bringing supplies and gifts."
    NUMA @ talk "Uma vez por mês, nosso povo chega às docas trazendo suprimentos e presentes."

# game/data/characters/numa/dialogue.rpy:69
translate ptBR numa_moreaboutpeople_menu_0f7b9bbf:

    # NUMA @ talk "Treasure from sunken ships, pearls, some fish..."
    NUMA @ talk "Tesouros de navios naufragados, pérolas, alguns peixes..."

# game/data/characters/numa/dialogue.rpy:70
translate ptBR numa_moreaboutpeople_menu_f222a1c7:

    # NUMA @ talk "In return, we are given weapons and armours forged."
    NUMA @ talk "Em troca, recebemos armas e armaduras forjadas."

# game/data/characters/numa/dialogue.rpy:71
translate ptBR numa_moreaboutpeople_menu_b1ea096b:

    # MC @ think "Why would you need such things?"
    MC @ think "Por que vocês precisariam de tais coisas?"

# game/data/characters/numa/dialogue.rpy:72
translate ptBR numa_moreaboutpeople_menu_93d5f8b3:

    # NUMA @ serious "... The waves are a turbulent thing."
    NUMA @ serious "... As ondas são algo turbulento."

# game/data/characters/numa/dialogue.rpy:73
translate ptBR numa_moreaboutpeople_menu_088c241e:

    # NUMA @ talk "They turn towards war."
    NUMA @ talk "Elas se voltam para a guerra."

# game/data/characters/numa/dialogue.rpy:74
translate ptBR numa_moreaboutpeople_menu_416963ed:

    # MC @ think "War? What war?"
    MC @ think "Guerra? Que guerra?"

# game/data/characters/numa/dialogue.rpy:75
translate ptBR numa_moreaboutpeople_menu_7ed5d058:

    # NUMA @ talk "It matters not for you surface breathers."
    NUMA @ talk "Não importa para vocês, respiradores de superfície."

# game/data/characters/numa/dialogue.rpy:76
translate ptBR numa_moreaboutpeople_menu_ad0fd71f:

    # NUMA @ talk "There are many fiefdoms vying for power below the currents."
    NUMA @ talk "Há muitos feudos disputando poder abaixo das correntes."

# game/data/characters/numa/dialogue.rpy:77
translate ptBR numa_moreaboutpeople_menu_35287cb9:

    # NUMA @ talk "The senate-"
    NUMA @ talk "O senado-"

# game/data/characters/numa/dialogue.rpy:78
translate ptBR numa_moreaboutpeople_menu_e906b857:

    # "She stopped herself, her lips curling into a forced smile."
    "Ela se interrompeu, seus lábios se curvando em um sorriso forçado."

# game/data/characters/numa/dialogue.rpy:79
translate ptBR numa_moreaboutpeople_menu_24708383:

    # NUMA @ smile "Forgive me, your Thalvën is so good, I forgot myself for a moment."
    NUMA @ smile "Perdoe-me, seu Thalvën é tão bom que me esqueci por um momento."

# game/data/characters/numa/dialogue.rpy:83
translate ptBR numa_moreaboutpeople_menu_f6a7145e:

    # NUMA @ talk "In order to maintain good relations with the merchants, a few of our Thalay kin were asked to work within the city."
    NUMA @ talk "Para manter boas relações com os mercadores, alguns de nossos parentes Thalay foram convidados a trabalhar na cidade."

# game/data/characters/numa/dialogue.rpy:84
translate ptBR numa_moreaboutpeople_menu_38f5e1d4:

    # NUMA @ talk "It is purely for diplomatic reasons, they even asked what role we would like."
    NUMA @ talk "É puramente por razões diplomáticas, eles até perguntaram qual função gostaríamos."

# game/data/characters/numa/dialogue.rpy:85
translate ptBR numa_moreaboutpeople_menu_dc0e7cd8:

    # NUMA @ smile "I asked to help run a library, so they had built this place to accomodate my needs."
    NUMA @ smile "Pedi para ajudar a administrar uma biblioteca, então construíram este lugar para atender minhas necessidades."

# game/data/characters/numa/dialogue.rpy:86
translate ptBR numa_moreaboutpeople_menu_b4acba9f:

    # MC @ think "They built a whole library for you?"
    MC @ think "Construíram uma biblioteca inteira pra você?"

# game/data/characters/numa/dialogue.rpy:87
translate ptBR numa_moreaboutpeople_menu_3fbd73b2:

    # NUMA @ talk "No, they built a whole library to keep my kin happy... I just happen to work within it."
    NUMA @ talk "Não, construíram uma biblioteca inteira para manter meus parentes felizes... Eu apenas trabalho nela."

# game/data/characters/numa/dialogue.rpy:91
translate ptBR numa_moreaboutpeople_menu_32267830:

    # NUMA @ talk "Of course... It pleases me to be able to talk to one as clearly as you."
    NUMA @ talk "Claro... Me agrada poder falar com alguém tão claramente quanto você."

# game/data/characters/numa/dialogue.rpy:96
translate ptBR numa_whatareyou_711b6f6a:

    # "Numa's eyelids blinked twice as she tilted her head once more."
    "As pálpebras de Numa piscaram duas vezes enquanto ela inclinava a cabeça mais uma vez."

# game/data/characters/numa/dialogue.rpy:97
translate ptBR numa_whatareyou_38893e4f:

    # NUMA @ talk "How can one speak the wave so well and not know what we are?"
    NUMA @ talk "Como alguém pode falar a onda tão bem e não saber o que somos?"

# game/data/characters/numa/dialogue.rpy:98
translate ptBR numa_whatareyou_c79bb790:

    # MC @ think "It's... complicated."
    MC @ think "É... complicado."

# game/data/characters/numa/dialogue.rpy:99
translate ptBR numa_whatareyou_7c8b810c:

    # NUMA @ talk "... I see."
    NUMA @ talk "... Entendo."

# game/data/characters/numa/dialogue.rpy:100
translate ptBR numa_whatareyou_53b96c9d:

    # NUMA @ talk "Then to answer your question, I am Thalay."
    NUMA @ talk "Então, para responder sua pergunta, sou Thalay."

# game/data/characters/numa/dialogue.rpy:101
translate ptBR numa_whatareyou_09fc90be:

    # NUMA @ smile "I presume I may be one of the first, or perhaps THE first, of my kind you've seen since arriving in Hamun."
    NUMA @ smile "Presumo que posso ser um dos primeiros, ou talvez O primeiro, da minha espécie que você viu desde que chegou em Hamun."

# game/data/characters/numa/dialogue.rpy:102
translate ptBR numa_whatareyou_ec863f7f:

    # MC @ talk "Yes."
    MC @ talk "Sim."

# game/data/characters/numa/dialogue.rpy:103
translate ptBR numa_whatareyou_12452374:

    # NUMA @ talk "Mmm... It is not surprising."
    NUMA @ talk "Mmm... Não é surpreendente."

# game/data/characters/numa/dialogue.rpy:104
translate ptBR numa_whatareyou_3fe64a20:

    # NUMA @ talk "Our people conduct only limited business with land breathers."
    NUMA @ talk "Nosso povo faz apenas negócios limitados com respiradores de terra."

# game/data/characters/numa/dialogue.rpy:110
translate ptBR numa_talk_d20b5586:

    # NUMA @ smile "Greetings again, how may I help?"
    NUMA @ smile "Saudações novamente, como posso ajudar?"

# game/data/characters/numa/dialogue.rpy:115
translate ptBR numa_bye_aaff2ad9:

    # NUMA @ smile "Come back anytime... It pleases me to have someone I can actually speak the wave with."
    NUMA @ smile "Volte a qualquer hora... Me agrada ter alguém com quem eu possa realmente falar a onda."

# game/data/characters/numa/dialogue.rpy:119
translate ptBR numa_books_trade_e8d2f9b6:

    # NUMA @ talk "Okay."
    NUMA @ talk "Ok."

# game/data/characters/numa/dialogue.rpy:120
translate ptBR numa_books_trade_b1ba029d:

    # NUMA @ talk "Let's take a look then..."
    NUMA @ talk "Vamos dar uma olhada então..."

# game/data/characters/numa/dialogue.rpy:122
translate ptBR numa_books_trade_c787f2b4:

    # NUMA @ talk "Is there anything else?"
    NUMA @ talk "Há mais alguma coisa?"

# game/data/characters/numa/dialogue.rpy:127
translate ptBR numa_firstmeet_2a75a3f6:

    # "Entering into the Hamun library was... an unusual sight."
    "Entrar na biblioteca de Hamun foi... uma visão incomum."

# game/data/characters/numa/dialogue.rpy:128
translate ptBR numa_firstmeet_8bc35701:

    # "While the usual rows of books were neatly stacked up high as one would expect, a deep, decorated pool lay in the center of the library,"
    "Enquanto as fileiras usuais de livros estavam empilhadas ordenadamente até o alto como seria de se esperar, uma piscina profunda e decorada ficava no centro da biblioteca,"

# game/data/characters/numa/dialogue.rpy:129
translate ptBR numa_firstmeet_7c9fd79f:

    # "Complete with a strange water fountain statue of what appeared to be a mage striking up a bargain with a strange fish like humanoid."
    "Completa com uma estranha estátua de fonte de água do que parecia ser um mago fazendo um acordo com um estranho humanoide semelhante a um peixe."

# game/data/characters/numa/dialogue.rpy:130
translate ptBR numa_firstmeet_6d119730:

    # "Looking around, I could see no one in the library."
    "Olhando ao redor, não vi ninguém na biblioteca."

# game/data/characters/numa/dialogue.rpy:131
translate ptBR numa_firstmeet_27bb84f3:

    # MC @ think "Hello? Is anyone here?"
    MC @ think "Olá? Tem alguém aqui?"

# game/data/characters/numa/dialogue.rpy:132
translate ptBR numa_firstmeet_730a3730:

    # "A shadow appeared along waters of the pool, and in a moment, the blue skinned humanoid like woman emerged."
    "Uma sombra apareceu ao longo das águas da piscina, e em um momento, a mulher humanoide de pele azul emergiu."

# game/data/characters/numa/dialogue.rpy:135
translate ptBR numa_firstmeet_db1efe9f:

    # "Naked, and covered in scales as the water dripped from her body, the gilged creature turned it's gaze towards me."
    "Nua e coberta de escamas enquanto a água pingava de seu corpo, a criatura com guelras voltou seu olhar para mim."

# game/data/characters/numa/dialogue.rpy:136
