translate ptBR talk_serafina_training_6ffa521c:

    # SERAFINA @ talk "Virgo is a strict instructor, but I know he means well."
    SERAFINA @ talk "Virgo é um instrutor rigoroso, mas sei que ele tem boas intenções."

# game/data/characters/serafina/dialogue.rpy:29
