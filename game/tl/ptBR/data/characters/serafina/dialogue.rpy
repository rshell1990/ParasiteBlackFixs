translate ptBR talk_serafina_training_6aaef64c:

    # SERAFINA @ smile "{i}Powerful.{/i}"
    SERAFINA @ smile "{i}Poderosa.{/i}"

# game/data/characters/serafina/dialogue.rpy:31
translate ptBR talk_serafina_training_f3f67cf2:

    # SERAFINA @ talk "But it's also kind of terrifying."
    SERAFINA @ talk "Mas também é meio aterrorizante."

# game/data/characters/serafina/dialogue.rpy:32
translate ptBR talk_serafina_training_b99aeecf:

    # SERAFINA @ talk "I have taken some private lessons before on magecraft."
    SERAFINA @ talk "Já tive algumas aulas particulares de magia antes."

# game/data/characters/serafina/dialogue.rpy:33
translate ptBR talk_serafina_training_ed0b2156:

    # SERAFINA @ surprised "But this is like a whole different world."
    SERAFINA @ surprised "Mas isso é como um mundo completamente diferente."

# game/data/characters/serafina/dialogue.rpy:34
translate ptBR talk_serafina_training_cd8bbe04:

    # MC @ serious "Be careful, Serafina. Many a mage has said the same thing,"
    MC @ serious "Tenha cuidado, Serafina. Muitos magos disseram a mesma coisa,"

# game/data/characters/serafina/dialogue.rpy:35
translate ptBR talk_serafina_training_34d9062b:

    # MC @ serious "only to come undone by the madness of digging too deep."
    MC @ serious "apenas para sucumbir à loucura de cavar fundo demais."

# game/data/characters/serafina/dialogue.rpy:36
translate ptBR talk_serafina_training_bf7b05d4:

    # SERAFINA @ smile "Don't worry, I'll be safe!"
    SERAFINA @ smile "Não se preocupe, vou ficar segura!"

# game/data/characters/serafina/dialogue.rpy:40
translate ptBR talk_serafina_father_063c3e47:

    # SERAFINA @ sad "No..."
    SERAFINA @ sad "Não..."

# game/data/characters/serafina/dialogue.rpy:41
translate ptBR talk_serafina_father_35b4e32d:

    # SERAFINA @ sad "But now I know where he might receive my letters, so I'm still going to try."
    SERAFINA @ sad "Mas agora sei onde ele pode receber minhas cartas, então ainda vou tentar."

# game/data/characters/serafina/dialogue.rpy:42
translate ptBR talk_serafina_father_38d3fa5a:

    # SERAFINA @ sad "I just hope he understands why I made the choice I did."
    SERAFINA @ sad "Só espero que ele entenda por que fiz a escolha que fiz."

# game/data/characters/serafina/dialogue.rpy:46
translate ptBR talk_serafina_wives_8ee34734:

    # SERAFINA @ sad "{i}*Sigh*{/i} I learned a long time ago about their... {i}tastes.{/i}"
    SERAFINA @ sad "{i}*Suspiro*{/i} Aprendi há muito tempo sobre os... {i}gostos{/i} deles."

# game/data/characters/serafina/dialogue.rpy:47
translate ptBR talk_serafina_wives_8299d0af:

    # SERAFINA @ talk "They aren't exactly subtle about it."
    SERAFINA @ talk "Eles não são exatamente sutis quanto a isso."

# game/data/characters/serafina/dialogue.rpy:48
translate ptBR talk_serafina_wives_1a5c91b5:

    # SERAFINA @ talk "But they do care for me a great deal."
    SERAFINA @ talk "Mas eles se importam muito comigo."

# game/data/characters/serafina/dialogue.rpy:49
translate ptBR talk_serafina_wives_d0edb860:

    # SERAFINA @ talk "Just don't make things difficult for them, alright?"
    SERAFINA @ talk "Só não torne as coisas difíceis pra eles, certo?"

# game/data/characters/serafina/dialogue.rpy:50
translate ptBR talk_serafina_wives_8bc6c1f2:

    # SERAFINA @ talk "Chanyi may act strong, but she's more sensitive than she lets on."
    SERAFINA @ talk "Chanyi pode agir como durona, mas é mais sensível do que aparenta."

# game/data/characters/serafina/dialogue.rpy:51
translate ptBR talk_serafina_wives_c8f7cec7:

    # SERAFINA @ think "And mother is just... well... mother."
    SERAFINA @ think "E mamãe é apenas... bem... mamãe."

# game/data/characters/serafina/dialogue.rpy:55
translate ptBR talk_serafina_bye_bdb817ba:

    # SERAFINA @ smile "Alright then."
    SERAFINA @ smile "Tudo bem então."

