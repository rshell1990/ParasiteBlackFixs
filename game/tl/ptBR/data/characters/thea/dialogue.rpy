    # THEA @ smile "Good luck on your adventures!"
    THEA @ smile "Boa sorte nas suas aventuras!"

# game/data/characters/thea/dialogue.rpy:38
translate ptBR nov_thea_adv_questions_1a2ee70f:

    # THEA @ talk "Ask away."
    THEA @ talk "Pergunte."

# game/data/characters/thea/dialogue.rpy:41
translate ptBR nov_thea_adv_questions_menu_bbc22857:

    # THEA @ talk "Over on the board over there is our list of current jobs needing to be done."
    THEA @ talk "Ali naquele quadro está nossa lista de trabalhos atuais que precisam ser feitos."

# game/data/characters/thea/dialogue.rpy:42
translate ptBR nov_thea_adv_questions_menu_0ab4d2cb:

    # THEA @ talk "Just select the one you want, and we'll handle the paperwork while you get to work."
    THEA @ talk "É só selecionar o que você quer, e nós cuidamos da papelada enquanto você começa a trabalhar."

# game/data/characters/thea/dialogue.rpy:43
translate ptBR nov_thea_adv_questions_menu_e0200cc9:

    # THEA @ talk "Remember though, you can only choose a quest within your rank as an adventurer."
    THEA @ talk "Lembre-se, porém, você só pode escolher missões dentro do seu ranking como aventureiro."

# game/data/characters/thea/dialogue.rpy:46
translate ptBR nov_thea_adv_questions_menu_d0988ac6:

    # THEA @ talk "It's important to understand how the ranking works."
    THEA @ talk "É importante entender como o sistema de ranking funciona."

# game/data/characters/thea/dialogue.rpy:47
translate ptBR nov_thea_adv_questions_menu_a160af5e:

    # THEA @ talk "All beginner adventurers are ranked as D-listers."
    THEA @ talk "Todos os aventureiros iniciantes são classificados como rank D."

# game/data/characters/thea/dialogue.rpy:48
translate ptBR nov_thea_adv_questions_menu_691c77f1:

    # THEA @ talk "These are the most straightforward and simple quests available to any adventurer."
    THEA @ talk "Estas são as missões mais diretas e simples disponíveis para qualquer aventureiro."

# game/data/characters/thea/dialogue.rpy:49
translate ptBR nov_thea_adv_questions_menu_359a935e:

    # THEA @ talk "Ranking progresses from D-tier all the way to S-Tier, the rank of legendary adventurers."
    THEA @ talk "O ranking progride do nível D até o nível S, o ranking dos aventureiros lendários."

# game/data/characters/thea/dialogue.rpy:50
translate ptBR nov_thea_adv_questions_menu_71f3b316:

    # THEA @ talk "Of course, as the danger and difficulty of the quests increase each rank, so does the rewards to compensate."
    THEA @ talk "Claro, conforme o perigo e a dificuldade das missões aumentam a cada ranking, as recompensas também aumentam para compensar."

# game/data/characters/thea/dialogue.rpy:53
translate ptBR nov_thea_adv_questions_menu_9ae80558:

    # THEA @ talk "There's a set number of quests per rank that will need to be completed a minimum of at least once."
    THEA @ talk "Há um número definido de missões por ranking que precisarão ser concluídas pelo menos uma vez no mínimo."

# game/data/characters/thea/dialogue.rpy:54
translate ptBR nov_thea_adv_questions_menu_42fcd1da:

    # THEA @ talk "After you've beaten your ranks guild quests, a special one-time quest will open up that once you've completed, your rank will increase."
    THEA @ talk "Depois de concluir as missões da guilda do seu ranking, uma missão especial única será aberta e, uma vez concluída, seu ranking aumentará."

# game/data/characters/thea/dialogue.rpy:55
translate ptBR nov_thea_adv_questions_menu_0b3f27c1:

    # THEA @ talk "Oh ... And don't worry about running out of quests."
    THEA @ talk "Ah... E não se preocupe em ficar sem missões."

# game/data/characters/thea/dialogue.rpy:56
translate ptBR nov_thea_adv_questions_menu_003922e8:

    # THEA @ talk "Outside of the special guild quests, most guild quests are usually full time occupations in themselves, you'll be able to re-do those quests as many times as you like."
    THEA @ talk "Fora as missões especiais da guilda, a maioria das missões da guilda são geralmente ocupações de tempo integral por si só, você poderá refazer essas missões quantas vezes quiser."

# game/data/characters/thea/dialogue.rpy:59
translate ptBR nov_thea_adv_questions_menu_fa5b1639:

    # THEA @ talk "Sure, was there anything else?"
    THEA @ talk "Claro, tinha mais alguma coisa?"

# game/data/characters/thea/dialogue.rpy:63
translate ptBR nov_thea_adv_questions_notAdventurer_dff28a07:

    # THEA @ talk "Sorry, but I don't remember you being an adventurer."
    THEA @ talk "Desculpe, mas não me lembro de você ser um aventureiro."

# game/data/characters/thea/dialogue.rpy:64
translate ptBR nov_thea_adv_questions_notAdventurer_4a075af6:

    # MC "What do you mean?"
    MC "O que você quer dizer?"

# game/data/characters/thea/dialogue.rpy:65
translate ptBR nov_thea_adv_questions_notAdventurer_bd5ff809:

    # THEA @ talk "Well, you can get yourself a drink or something, but I can't waste my time explaining the inner workings of the guild to you."
    THEA @ talk "Bem, você pode tomar uma bebida ou algo assim, mas não posso perder meu tempo explicando o funcionamento interno da guilda para você."

# game/data/characters/thea/dialogue.rpy:66
translate ptBR nov_thea_adv_questions_notAdventurer_e1770810:

    # MC "Can I become an adventurer?"
    MC "Posso me tornar um aventureiro?"

# game/data/characters/thea/dialogue.rpy:67
translate ptBR nov_thea_adv_questions_notAdventurer_416abe62:

    # "Thea let out a quiet sigh..."
    "Thea soltou um suspiro silencioso..."

# game/data/characters/thea/dialogue.rpy:68
translate ptBR nov_thea_adv_questions_notAdventurer_e5da05a6:

    # THEA @ talk "That's a three-hundred fifty-something time I've been asked this."
    THEA @ talk "Essa é a trezentas e cinquenta e tantas vezes que me perguntam isso."

# game/data/characters/thea/dialogue.rpy:69
translate ptBR nov_thea_adv_questions_notAdventurer_811a066b:

    # THEA @ talk "Have you reached your Terminus yet?"
    THEA @ talk "Você já alcançou seu Terminus?"

# game/data/characters/thea/dialogue.rpy:70
translate ptBR nov_thea_adv_questions_notAdventurer_5d73558e:

    # "I swallowed hard."
    "Engoli em seco."

# game/data/characters/thea/dialogue.rpy:71
translate ptBR nov_thea_adv_questions_notAdventurer_7b56f981:

    # MC "Y-yeah."
    MC "S-sim."

# game/data/characters/thea/dialogue.rpy:72
translate ptBR nov_thea_adv_questions_notAdventurer_2da5a787:

    # THEA @ talk "You did? Well, that is how you become an adventurer, you're {i}assigned{/i} this role at your Terminus."
    THEA @ talk "Já? Bem, é assim que você se torna um aventureiro, você é {i}designado{/i} para este papel no seu Terminus."

# game/data/characters/thea/dialogue.rpy:73
translate ptBR nov_thea_adv_questions_notAdventurer_fe9f792d:

    # THEA @ talk "What role did the kingdom bestow upon you?"
    THEA @ talk "Que papel o reino lhe concedeu?"

# game/data/characters/thea/dialogue.rpy:74
translate ptBR nov_thea_adv_questions_notAdventurer_522de8a4:

    # MC "(Cannon fodder.)"
    MC "(Bucha de canhão.)"

# game/data/characters/thea/dialogue.rpy:75
translate ptBR nov_thea_adv_questions_notAdventurer_e8f39a65:

    # MC "I... I should go."
    MC "Eu... eu deveria ir."

# game/data/characters/thea/dialogue.rpy:76
translate ptBR nov_thea_adv_questions_notAdventurer_4349caf7:

    # "Thea raised an eyebrow."
    "Thea ergueu uma sobrancelha."

# game/data/characters/thea/dialogue.rpy:77
translate ptBR nov_thea_adv_questions_notAdventurer_d34359c3:

    # THEA @ talk "Okay, safe travels then!"
    THEA @ talk "Ok, boa viagem então!"

# game/data/characters/thea/dialogue.rpy:79
translate ptBR nov_thea_adv_questions_notAdventurer_bfd46478:

    # MC "I should get to the fort now."
    MC "Eu deveria ir para o forte agora."

# game/data/characters/thea/dialogue.rpy:84
translate ptBR nov_thea_drink_4968c955:

    # THEA @ talk "Improve your standing at the guild and maybe we'll talk."
    THEA @ talk "Melhore sua posição na guilda e talvez conversemos."

# game/data/characters/thea/dialogue.rpy:88
translate ptBR nov_thea_drink_8bb85580:

    # THEA @ smile "I hope you don't think you're the first one to try that."
    THEA @ smile "Espero que você não pense que é o primeiro a tentar isso."

# game/data/characters/thea/dialogue.rpy:89
translate ptBR nov_thea_drink_cef616c3:

    # MC @ smile "I was hoping I'd be the first one you'd say yes to."
    MC @ smile "Eu esperava ser o primeiro para quem você diria sim."

# game/data/characters/thea/dialogue.rpy:90
translate ptBR nov_thea_drink_af5adb3e:

    # THEA @ talk "Hmm, well, I'll think about it ..."
    THEA @ talk "Hmm, bem, vou pensar nisso..."

# game/data/characters/thea/dialogue.rpy:91
translate ptBR nov_thea_drink_4d231e9b:

    # THEA @ talk "I'm sure you're used to girls just falling into your lap, but it takes a little more than that to get me interested."
    THEA @ talk "Tenho certeza que você está acostumado com garotas caindo no seu colo, mas é preciso um pouco mais do que isso para me interessar."

# game/data/characters/thea/dialogue.rpy:92
translate ptBR nov_thea_drink_e9545907:

    # MC @ smile "Oh?"
    MC @ smile "Ah?"

# game/data/characters/thea/dialogue.rpy:93
translate ptBR nov_thea_drink_08d238b8:

    # THEA @ smile "{i}I wanna see what you can do.{/i}"
    THEA @ smile "{i}Quero ver o que você pode fazer.{/i}"

