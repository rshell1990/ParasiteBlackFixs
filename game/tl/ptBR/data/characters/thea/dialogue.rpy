translate ptBR nov_thea_drink_c0c81c71:

    # THEA @ smile "But not just any adventurer walking in off the street, one whose metal has been seriously proven."
    THEA @ smile "Mas não qualquer aventureiro que entra pela porta, um cujo valor foi seriamente comprovado."

# game/data/characters/thea/dialogue.rpy:101
translate ptBR nov_thea_drink_211b3ff7:

    # THEA @ blush "Think you've got what it takes?"
    THEA @ blush "Acha que tem o que é preciso?"

