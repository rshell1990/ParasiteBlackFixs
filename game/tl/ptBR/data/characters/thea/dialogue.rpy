translate ptBR nov_thea_drink_c7bdae38:

    # THEA @ smile "Mmm ... Better not think too hard on it, need to stay focused for work."
    THEA @ smile "Mmm... Melhor não pensar muito nisso, preciso ficar focada no trabalho."

# game/data/characters/thea/dialogue.rpy:98
translate ptBR nov_thea_drink_ef2975b7:

    # MC @ talk "So, you've got a thing for Adventurers then?"
    MC @ talk "Então, você tem uma queda por aventureiros?"

# game/data/characters/thea/dialogue.rpy:99
translate ptBR nov_thea_drink_79a5953f:

    # THEA @ smile2 "A-Ah...Maybe a little?"
    THEA @ smile2 "A-Ah... Talvez um pouco?"

