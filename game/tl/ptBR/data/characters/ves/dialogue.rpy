    # VES @ talk "Not yet, but I will be soon."
    VES @ talk "Ainda não, mas estarei em breve."

# game/data/characters/ves/dialogue.rpy:91
translate ptBR ves_dial_beenout_f48a09c0:

    # VES @ talk "Can’t risk supplies getting too low."
    VES @ talk "Não posso arriscar os suprimentos ficarem muito baixos."

# game/data/characters/ves/dialogue.rpy:95
translate ptBR ves_dial_seenanything_b917f69f:

    # VES @ talk "Just your usual small parties of Demorai moving through the sands."
    VES @ talk "Só os grupos pequenos de costume de Demorai se movendo pelas areias."

# game/data/characters/ves/dialogue.rpy:96
translate ptBR ves_dial_seenanything_565c2af8:

    # VES @ talk "Oh, and some Skorn... Not much else."
    VES @ talk "Ah, e alguns Skorn... Não muito mais."

# game/data/characters/ves/dialogue.rpy:97
translate ptBR ves_dial_seenanything_396272dc:

    # VES @ talk "Though I did find a strange temple out here once..."
    VES @ talk "Embora eu tenha encontrado um templo estranho aqui uma vez..."

# game/data/characters/ves/dialogue.rpy:98
translate ptBR ves_dial_seenanything_1bd97503:

