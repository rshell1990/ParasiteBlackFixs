    # "The crowd fell silent once again as she spoke with fiery passion."
    "The crowd caiu silencioso once again as ela falou with fiery passion."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:107
translate ptBR ev_AdvGuildShowUpPostFaw_scr_612f509c:

    # CELESTE @ talk "I have felt and shared in your pain these last few years and want you to know I stand not just with you..."
    CELESTE @ talk "Eu senti e compartilhei da sua dor nestes últimos anos e quero que saibam que eu estou não apenas com vocês..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:108
translate ptBR ev_AdvGuildShowUpPostFaw_scr_fdaf9eb8:

    # CELESTE @ talk "BUT FOR YOU!"
    CELESTE @ talk "MAS POR VOCÊS!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:109
translate ptBR ev_AdvGuildShowUpPostFaw_scr_dadb9942:

    # CELESTE @ talk "I will not rest until the plight of the Demorai ends and peace is restored upon our lands!"
    CELESTE @ talk "Eu não descansarei até que o sofrimento dos Demorai acabe e a paz seja restaurada em nossas terras!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:110
translate ptBR ev_AdvGuildShowUpPostFaw_scr_12c05095:

    # CELESTE @ talk "This nightmare shall end!"
    CELESTE @ talk "Este pesadelo vai acabar!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:111
translate ptBR ev_AdvGuildShowUpPostFaw_scr_49c93d91:

    # CELESTE @ talk "Be it against demon or beast my blade is your blade!"
    CELESTE @ talk "Seja contra demônio ou besta, minha lâmina é a sua lâmina!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:112
translate ptBR ev_AdvGuildShowUpPostFaw_scr_ccb5f3ef:

    # CELESTE @ talk "My blood is your blood!"
    CELESTE @ talk "Meu sangue é o seu sangue!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:113
translate ptBR ev_AdvGuildShowUpPostFaw_scr_e98a92d4:

    # CELESTE @ talk "And though the night belongs to them..."
    CELESTE @ talk "E embora a noite pertença a eles..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:114
translate ptBR ev_AdvGuildShowUpPostFaw_scr_a9f1dc83:

    # CELESTE @ laugh "I pledge to you; WE SHALL HAVE THE DAY!"
    CELESTE @ laugh "Eu prometo a vocês; NÓS TEREMOS O DIA!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:115
translate ptBR ev_AdvGuildShowUpPostFaw_scr_55a5d2cd:

    # "The crowd burst into utter jubilation."
    "A multidão explodiu em pura jubilação."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:116
translate ptBR ev_AdvGuildShowUpPostFaw_scr_cccb6fb9:

    # "In a sea of mediocre Heroes taking about glory and honour that could, at best, gain a passive smirk or nod of approval, Celeste could rally any crowd into total furore."
    "In a sea of mediocre Heroes pegando about glory and honour aquilo poderia, at melhor, gain a passive smirk or acenar of approval, Celeste poderia rally any crowd into total furore."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:127
translate ptBR ev_AdvGuildShowUpPostFaw_scr_f41e9dbf:

    # "Alive with excitement, we headed back into the Guild."
    "Vivo with excitement, nós headed costas into the Guild."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:128
translate ptBR ev_AdvGuildShowUpPostFaw_scr_b986cee7:

    # "As we did, Celeste passed by me, offering the briefest of glances that made my stomach turn in knots before the crowds shuffled in eagerly behind her."
    "As nós fez, Celeste passed by mim, oferecendo the briefest of glances aquilo fez meu estômago virar in knots before the crowds shuffled in eagerly behind dela."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:129
translate ptBR ev_AdvGuildShowUpPostFaw_scr_7afe3f0a:

    # MARKUS "Whoa... she’s..."
    MARKUS "Uau... ela é..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:130
translate ptBR ev_AdvGuildShowUpPostFaw_scr_27d48f45:

    # MARKUS "{i}Incredible.{/i}"
    MARKUS "{i}Incrível.{/i}"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:131
translate ptBR ev_AdvGuildShowUpPostFaw_scr_dc8bb5a6:

    # "Shaking my head, I tried to regain some composure."
    "Sacudindo meu cabeça, Eu tentou to regain some composure."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:132
translate ptBR ev_AdvGuildShowUpPostFaw_scr_e97c023c:

    # MARKUS "Hey, do you think there’s maybe a girl down at the Pleasure District who looks a little like her?"
    MARKUS "Ei, você acha que talvez tenha uma garota no Distrito do Prazer que se pareça um pouco com ela?"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:150
translate ptBR ev_AdvGuildShowUpPostFaw_scr_11051189:

    # UNKNOWN "Hello there!"
    UNKNOWN "Olá!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:151
translate ptBR ev_AdvGuildShowUpPostFaw_scr_bd7c5c11:

    # THEA "My name’s Thea, how can I help you both today?"
    THEA "Meu nome é Thea, como posso ajudar vocês dois hoje?"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:153
translate ptBR ev_AdvGuildShowUpPostFaw_scr_c59cca9b:

    # MC @ talk "We’re the new Adventurers, I guess."
    MC @ talk "Somos os novos Aventureiros, eu acho."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:154
translate ptBR ev_AdvGuildShowUpPostFaw_scr_d258435c:

    # "Markus chuckled quietly."
    "Markus riu baixinho."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:155
translate ptBR ev_AdvGuildShowUpPostFaw_scr_4aeafa86:

    # THEA "Oh! You must be the two we were informed about!"
    THEA "Oh! Vocês devem ser os dois sobre os quais nos informaram!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:156
translate ptBR ev_AdvGuildShowUpPostFaw_scr_3892c652:

    # THEA "Let me be the first to welcome you to the Adventurers Guild!"
    THEA "Deixem-me ser o primeiro a dar as boas-vindas à Guilda dos Aventureiros!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:157
translate ptBR ev_AdvGuildShowUpPostFaw_scr_e48ead57:

    # THEA "If you have any questions, now’s the time to ask them."
    THEA "Se tiverem alguma pergunta, é agora a hora de fazê-las."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:163
translate ptBR act1scene3menu_b0add572:

    # THEA "Should you wish to embark on a quest, you need only put your name down on the Quest Board for whatever one it is you’re pursuing."
    THEA "Caso desejem embarcar numa missão, basta inscreverem o nome no Quadro de Missões para aquela que estão a tentar."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:164
translate ptBR act1scene3menu_d65a75dc:

    # THEA "Quests are ranked by their difficulty."
    THEA "As missões são classificadas pela sua dificuldade."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:165
translate ptBR act1scene3menu_54d83324:

    # THEA "The greater the difficulty, the greater the risk... and the reward."
    THEA "Quanto maior a dificuldade, maior o risco... e a recompensa."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:169
translate ptBR act1scene3menu_72d04b25:

    # THEA "Nope! Anyone who puts their name down is eligible to participate."
    THEA "Não! Qualquer pessoa que inscreva o seu nome é elegível para participar."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:170
translate ptBR act1scene3menu_fa00c2a1:

    # THEA "Keep in mind that multiple parties may attempt the same quest, we {i}only{/i} reward the successful candidates."
    THEA "Tenham em mente que vários grupos podem tentar a mesma missão; nós {i}apenas{/i} recompensamos os candidatos bem-sucedidos."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:171
translate ptBR act1scene3menu_1db0d6d9:

    # THEA "It’s also up to you to decide how to split any shares between yourselves, we offer a lump sum as reward."
    THEA "Também cabe a vocês decidir como dividir as quotas entre vocês; nós oferecemos um montante fixo como recompensa."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:175
translate ptBR act1scene3menu_22043f0c:

    # THEA "Now? Less than five hundred remain..."
    THEA "Agora? Restam menos de quinhentos..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:176
translate ptBR act1scene3menu_b91edc24:

    # THEA "I have to admit, it’s a far cry from the glory days of Newheart."
    THEA "Tenho que admitir, é uma grande diferença dos dias de glória de Newheart."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:177
translate ptBR act1scene3menu_12885e37:

    # THEA "Back then we nearly had two thousand Guild members running around! Can you believe that?"
    THEA "Naquela época, tínhamos quase dois mil membros da Guilda correndo por aí! Você acredita?"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:178
translate ptBR act1scene3menu_38c0753f:

    # THEA "But... we make do with what we have!"
    THEA "Mas... vamos nos virando com o que temos!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:179
translate ptBR act1scene3menu_c02c736f:

    # THEA "And there are still some exciting new names making their own legends!"
    THEA "E ainda há alguns novos nomes empolgantes criando suas próprias lendas!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:180
translate ptBR act1scene3menu_0dee6fd5:

    # THEA "Who knows... maybe you two will make a legend of yourselves!"
    THEA "Quem sabe... talvez vocês dois criem uma lenda de si mesmos!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:185
translate ptBR act1scene3menu_cf69118c:

    # THEA "Okay, glad to be of assistance!"
    THEA "Ok, feliz em poder ajudar!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:186
translate ptBR act1scene3menu_1027174a:

    # THEA "I've got to return to my work now."
    THEA "Preciso voltar ao meu trabalho agora."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:188
translate ptBR act1scene3menu_9299fc0b:

    # MC @ talk "Well, at least that’s done now."
    MC @ talk "Bem, pelo menos isso está feito agora."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:191
translate ptBR act1scene3menu_863a2563:

    # MARKUS "Yeah, one headache less..."
    MARKUS "Sim, uma dor de cabeça a menos..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:193
translate ptBR act1scene3menu_30b20d66:

    # MARKUS "Yeah. Up for a drink later? Remember, you promised!"
    MARKUS "Sim. Topa uma bebida mais tarde? Lembra, você prometeu!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:194
translate ptBR act1scene3menu_7ca81017:

    # MC "But I didn't!"
    MC "Mas eu não prometi!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:195
translate ptBR act1scene3menu_c15b6300:

    # MARKUS "No, you did!"
    MARKUS "Não, você prometeu!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:199
translate ptBR act1scene3menu_8ef74120:

    # "As we turned to leave, I bumped straight into Celeste who was busy dealing with her many adoring fans, regaling them with titillating details of her adventures."
    "As nós virou to sair, Eu bumped straight into Celeste quem era busy dealing with dela many adoring fans, regaling eles with titillating details of dela adventures."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:202
translate ptBR act1scene3menu_d9f01d4d:

    # "Spinning around sharply, her eyes met mine and for a moment, they were daggers."
    "Spinning around sharply, dela olhos met meu and for a moment, eles eram daggers."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:203
translate ptBR act1scene3menu_ef59baf2:

    # "But just as quickly, she relaxed, an easy smile spread across her face."
    "Mas tão rapidamente quanto, ela relaxou, um sorriso fácil se espalhando pelo seu rosto."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:204
translate ptBR act1scene3menu_66c01fcc:

    # CELESTE @ talk "I know you..."
    CELESTE @ talk "Eu conheço vocês..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:205
translate ptBR act1scene3menu_80c5dfd9:

    # CELESTE @ talk "You two are the lone survivors, right?"
    CELESTE @ talk "Vocês dois são os únicos sobreviventes, certo?"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:206
translate ptBR act1scene3menu_5acbcff2:

    # "The crowd formed a captivated circle around us."
    "The crowd formed a captivated circle around nós."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:207
translate ptBR act1scene3menu_ee1182d9:

    # MARKUS "That’s us, ma’am!"
    MARKUS "Somos nós, senhora!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:208
translate ptBR act1scene3menu_e7c5f4c3:

    # "Celeste laughed delicately."
    "Celeste riu delicadamente."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:209
translate ptBR act1scene3menu_285a0a19:

    # CELESTE @ talk "Very impressive, boys!"
    CELESTE @ talk "Muito impressionante, rapazes!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:210
translate ptBR act1scene3menu_b0d59f86:

    # CELESTE @ talk "You’ll have to tell me all about it the next time we meet."
    CELESTE @ talk "Vocês terão que me contar tudo sobre isso na próxima vez que nos encontrarmos."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:211
translate ptBR act1scene3menu_5fc5c665:

    # CELESTE @ talk "Tell me..."
    CELESTE @ talk "Me diga..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:212
translate ptBR act1scene3menu_48a301dc:

    # CELESTE @ talk "What are your names?"
    CELESTE @ talk "Quais são os seus nomes?"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:213
translate ptBR act1scene3menu_f929b4eb:

    # "Her voice had an alluringly hypnotic quality to it."
    "Dela voice tinha an alluringly hypnotic quality to isso."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:214
translate ptBR act1scene3menu_a453b44e:

    # MC @ talk "I’m [player_name!t], and this is my friend Markus."
    MC @ talk "Eu sou [player_name!t], e este é meu amigo Markus."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:215
translate ptBR act1scene3menu_3ae7807c:

    # "Celeste said my name, letting her tongue twist and twirl around it."
    "Celeste disse meu nome, deixando sua língua se torcer e girar ao redor dele."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:216
translate ptBR act1scene3menu_4084ca52:

    # "Something about the way she said it was... {i}appealing{/i}."
    "Something about the way ela disse isso era... {i}appealing{/i}."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:217
translate ptBR act1scene3menu_21a93bcc:

    # CELESTE @ talk "Well... {i}I{/i} look forward to meeting you again."
    CELESTE @ talk "Bem... {i}Eu{/i} estou ansiosa para te encontrar novamente."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:218
translate ptBR act1scene3menu_3727e20d:

    # CELESTE @ talk "Perhaps we will get to have Adventures with one another soon?"
    CELESTE @ talk "Talvez em breve possamos viver aventuras juntos?"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:219
translate ptBR act1scene3menu_772f97e6:

    # "I blushed crimson at the thought, something in her eyes made me feel a tinge of excitement that I hoped no one would notice as it pressed against my trousers."
    "Eu blushed crimson at the pensou, something in dela olhos fez mim sentir a tinge of excitement aquilo Eu esperava no one iria notar as isso pressionou against meu trousers."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:220
translate ptBR act1scene3menu_ea65fdab:

    # MARKUS "We’d love to, ma’am! Anytime just let us know!"
    MARKUS "Adoraríamos, senhora! A qualquer momento, é só nos avisar!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:221
translate ptBR act1scene3menu_76e68d92:

    # "Celeste laughed once again."
    "Celeste riu mais uma vez."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:222
translate ptBR act1scene3menu_69f07d64:

    # CELESTE @ talk "I look forward to it..."
    CELESTE @ talk "Estou ansioso por isso..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:223
translate ptBR act1scene3menu_6d28f3f1:

    # CELESTE @ talk "Now, if you’ll excuse me."
    CELESTE @ talk "Agora, se me der licença."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:228
translate ptBR act1scene3menu_def2df26:

    # "As Celeste made her way past me, I caught her sweet scent and felt myself turn rock hard almost instinctively."
    "As Celeste fez dela way past mim, Eu caught dela doce scent and sentiu me virar rock duro almost instinctively."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:229
translate ptBR act1scene3menu_13d57d6f:

    # "The crowd followed behind her, calling out her name with questions, begging for her attention."
    "The crowd seguiu behind dela, chamando out dela name with questions, implorando for dela attention."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:230
translate ptBR act1scene3menu_66c2ed1d:

    # "I traced her strut and bit my lower lip staring at her tightly-armored behind."
    "Eu traced dela strut and mordeu meu lower lábio encarando at dela tightly-armored behind."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:232
translate ptBR act1scene3menu_4e2a0008:

    # MARKUS "Holy..."
    MARKUS "Caramba..."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:233
translate ptBR act1scene3menu_48916eb6:

    # MARKUS "I call that one."
    MARKUS "Eu peço essa."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:234
translate ptBR act1scene3menu_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "O quê?"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:235
translate ptBR act1scene3menu_a05d5ae9:

    # MC @ talk "You don’t get to call that one!"
    MC @ talk "Você não pode pedir essa!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:236
translate ptBR act1scene3menu_9398bd39:

    # MARKUS "Yep! Just did."
    MARKUS "Sim! Acabei de pedir."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:237
translate ptBR act1scene3menu_74799834:

    # MC @ talk "Nuh-uh."
    MC @ talk "Nã-não."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:238
translate ptBR act1scene3menu_2783c591:

    # MARKUS "Uh-uh!"
    MARKUS "Ã-ã!"

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:239
translate ptBR act1scene3menu_b88f9cab:

    # MC @ talk "Stop being such a child about it."
    MC @ talk "Pare de ser tão infantil com isso."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:240
translate ptBR act1scene3menu_4c1cd8ea:

    # MC @ talk "She’s probably not even interested in either of us that way anyway."
    MC @ talk "Ela provavelmente nem está interessada em nenhum de nós desse jeito, de qualquer forma."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:241
translate ptBR act1scene3menu_19206c5a:

    # MARKUS "Well, if she is, I’m just saying, I’ve called that one."
    MARKUS "Bem, se ela estiver, só estou dizendo, eu pedi essa."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:242
translate ptBR act1scene3menu_088b46c9:

    # MC @ talk "And I’m just saying, your call is rejected."
    MC @ talk "E eu só estou dizendo, seu pedido está rejeitado."

# game/data/world_events/novaras/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:243
