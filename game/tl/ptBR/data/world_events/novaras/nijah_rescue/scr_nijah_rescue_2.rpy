    MC @ talk "É, uh... é uma longa história."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:34
translate ptBR evscr_nijah_rescue_2_3c1cb32d:

    # MC @ talk "Listen, we can’t stay here, okay?"
    MC @ talk "Escute, não podemos ficar aqui, ok?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:35
translate ptBR evscr_nijah_rescue_2_36980459:

    # MC @ talk "Come with me."
