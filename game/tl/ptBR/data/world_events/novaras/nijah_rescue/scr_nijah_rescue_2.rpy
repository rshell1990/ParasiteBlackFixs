# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:20
translate ptBR evscr_nijah_rescue_2_4d72dedb:

    # "As the woman unwrapped her headscarf to look at me, her eyes now settling from the panic fear."
    "As the woman unwrapped dela headscarf to olhar at mim, dela olhos now settling from the panic fear."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:23
translate ptBR evscr_nijah_rescue_2_90c622eb:

