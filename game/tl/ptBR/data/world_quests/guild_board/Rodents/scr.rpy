# game/data/world_quests/guild_board/Rodents/scr.rpy:31
translate ptBR qst_guild_rodents_96622ec7:

    # ELENA @ shock "Oh gods ..."
    ELENA @ shock "Pelos deuses..."

# game/data/world_quests/guild_board/Rodents/scr.rpy:32
translate ptBR qst_guild_rodents_c66c3ea0:

    # ELENA @ shock "There's so many of them!"
    ELENA @ shock "Tem tantos deles!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:36
translate ptBR qst_guild_rodents_e5cd033b:

    # MYU @ scared "M-Myu!"
    MYU @ scared "M-Myu!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:40
translate ptBR qst_guild_rodents_16665f31:

    # MARKUS "[player_name!t]!"
    MARKUS "[player_name!t]!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:43
translate ptBR qst_guild_rodents_e470a966:

    # MC "(Fuck!)"
    MC "(Merda!)"

# game/data/world_quests/guild_board/Rodents/scr.rpy:45
translate ptBR qst_guild_rodents_b5e51ab2:

    # MC "STAND READY TO FIGHT!"
    MC "PREPAREM-SE PARA LUTAR!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:53
translate ptBR qst_guild_rodents_460723ef:

    # "Atop their slain kins corpses, more clambered their way towards us, frothing at the mouth."
    "Sobre os cadáveres de seus parentes mortos, mais subiam em nossa direção, espumando pela boca."

# game/data/world_quests/guild_board/Rodents/scr.rpy:57
translate ptBR qst_guild_rodents_c49d8ac9:

    # MC "(They just keep coming!)"
    MC "(Eles não param de vir!)"

# game/data/world_quests/guild_board/Rodents/scr.rpy:61
translate ptBR qst_guild_rodents_1c42b967:

    # "The sewer became a haze of red and blood as I tore my way through dozens more of the creatures."
    "O esgoto se tornou uma névoa de vermelho e sangue enquanto eu rasgava meu caminho através de mais dezenas das criaturas."

# game/data/world_quests/guild_board/Rodents/scr.rpy:65
translate ptBR qst_guild_rodents_287c0477:

    # "The red mist enveloped me as the rage swept over, digging my hands into the guts of one of the creatures before tearing it in two."
    "A névoa vermelha me envolveu enquanto a fúria tomava conta, enfiando minhas mãos nas entranhas de uma das criaturas antes de rasgá-la em duas."

# game/data/world_quests/guild_board/Rodents/scr.rpy:68
translate ptBR qst_guild_rodents_b0e488d1:

    # ELENA @ shock "How many more of them are there?!"
    ELENA @ shock "Quantos mais deles existem?!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:72
translate ptBR qst_guild_rodents_47abd27b:

    # MARKUS @ angry "Grghh! Burn! FUCKING BURN YOU RODENT FUCKS!"
    MARKUS @ angry "Grghh! Queime! QUEIMEM, SEUS ROEDORES DO CARALHO!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:75
translate ptBR qst_guild_rodents_f7a51131:

    # "The next wave came hurtling over, leaping onto me where they gnashed and mauled trying to force their way through my armor."
    "A próxima onda veio se lançando, pulando em mim onde mordiam e dilaceravam tentando forçar seu caminho através da minha armadura."

# game/data/world_quests/guild_board/Rodents/scr.rpy:79
translate ptBR qst_guild_rodents_eefe4a77:

    # "Throwing them off me, I stomped down on one beneath my feet, crushing its skull before I saw once again, another wave charging towards us..."
    "Jogando-as para longe de mim, pisei em uma sob meus pés, esmagando seu crânio antes de ver mais uma vez, outra onda avançando contra nós..."

# game/data/world_quests/guild_board/Rodents/scr.rpy:81
translate ptBR qst_guild_rodents_79a800ff:

    # MC "They're thinning out! Just a little more!"
    MC "Estão diminuindo! Só mais um pouco!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:85
translate ptBR qst_guild_rodents_55f1e704:

    # "Slaying the last of this wave, the remaining rats turned and fled deeper into the darkness of the sewers."
    "Matando a última desta onda, os ratos restantes se viraram e fugiram mais fundo na escuridão dos esgotos."

# game/data/world_quests/guild_board/Rodents/scr.rpy:90
translate ptBR qst_guild_rodents_2d761257:

    # MC "{i}*Huff* *Huff*{/i}"
    MC "{i}*Huf* *Huf*{/i}"

# game/data/world_quests/guild_board/Rodents/scr.rpy:91
translate ptBR qst_guild_rodents_ba69243c:

    # MC "(I thought they'd never stop coming...)"
    MC "(Achei que elas nunca parariam de vir...)"

# game/data/world_quests/guild_board/Rodents/scr.rpy:94
translate ptBR qst_guild_rodents_0a80a6d6:

    # MARKUS "Well, job well done I guess."
    MARKUS "Bem, trabalho bem feito, eu acho."

# game/data/world_quests/guild_board/Rodents/scr.rpy:95
translate ptBR qst_guild_rodents_e5af19f1:

    # MARKUS @ shock "Now can we get out of here now before they decide they'd like to give eating us another go?"
    MARKUS @ shock "Agora podemos sair daqui antes que decidam tentar nos comer de novo?"

# game/data/world_quests/guild_board/Rodents/scr.rpy:99
translate ptBR qst_guild_rodents_d6ab0143:

    # MYU @ scared "Myu isn't very tasty!"
    MYU @ scared "Myu não é muito saborosa!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:102
translate ptBR qst_guild_rodents_3473bfb5:

    # MC "Let's take a head or two for proof and be done with this quest already!"
    MC "Vamos pegar uma cabeça ou duas como prova e acabar logo com essa missão!"

# game/data/world_quests/guild_board/Rodents/scr.rpy:110
translate ptBR qst_guild_rodents_8bdfd3b5:

    # "Shortly after, exhausted from the gruelling experience, we made our way back to the surface and after presenting a few heads of the rats, took our reward."
    "Pouco depois, exaustos da experiência extenuante, voltamos para a superfície e depois de apresentar algumas cabeças dos ratos, pegamos nossa recompensa."

# game/data/world_quests/guild_board/Rodents/scr.rpy:112
translate ptBR qst_guild_rodents_5fd8b026:

    # "Shortly after, exhausted from the gruelling experience, I made my way back to the surface and after presenting a few heads of the rats, took my reward."
    "Pouco depois, exausto da experiência extenuante, voltei para a superfície e depois de apresentar algumas cabeças dos ratos, peguei minha recompensa."

