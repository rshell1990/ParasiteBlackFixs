    MC @ talk "Eu acho que o que quer que seja... ou {i}era{/i}... queria me manter em segurança."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:100
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_cbd68443:

    # REGINA @ talk "... Hmm."
    REGINA @ talk "... Hum."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:101
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_b49f6fdc:

    # REGINA @ talk "I see."
    REGINA @ talk "Entendo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:102
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_c28408c1:

    # MC @ talk "Do you think I should be worried? How serious is this?"
    MC @ talk "Você acha que eu deveria estar preocupado? Quão sério é isso?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:103
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_e09176d9:

    # REGINA @ talk "I think you should {i}keep quiet{/i} till we know more about what exactly it is we’re dealing with."
    REGINA @ talk "Acho que você deveria {i}ficar quieto{/i} até sabermos mais sobre exatamente com o que estamos lidando."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:104
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_014d1605:

    # REGINA @ talk "... But thank you for trusting me."
    REGINA @ talk "... Mas obrigado por confiar em mim."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:107
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_e9b7963c:

    # MC @ talk "I can’t remember anything after that..."
    MC @ talk "Não consigo me lembrar de nada depois disso..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:108
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_c243cf46:

    # REGINA @ talk "Hmm... I see."
    REGINA @ talk "Hmm... Entendo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:109
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_f76b73df:

    # REGINA @ talk "Well, we best keep an eye on you for the next few days."
    REGINA @ talk "Bem, é melhor ficarmos de olho em você pelos próximos dias."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:110
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_77bb2010:

    # REGINA @ talk "But I’m glad you’re home safe, I’ve really missed you."
    REGINA @ talk "Mas estou feliz que você está em casa seguro, eu realmente senti sua falta."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:111
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_1a999818:

    # "Regina looked back to the brewing pot then snapped her fingers with realisation."
    "Regina olhou de volta para a panela fervendo e então estalou os dedos com realização."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:112
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_0439d3e0:

    # REGINA @ shock_talk "I didn’t buy enough food for two!"
    REGINA @ shock_talk "Eu não comprei comida suficiente para dois!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:113
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_092fcd93:

    # MC @ talk "[regina_ref_cap!t], it’s no problem."
    MC @ talk "[regina_ref_cap!t], não tem problema."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:114
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_1818426b:

    # REGINA @ talk "No, wait here!"
    REGINA @ talk "Não, espere aqui!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:115
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_b1043635:

    # REGINA @ talk "I’ll come back with some more vegetables to make you a decent stew, it’s the least I can do."
    REGINA @ talk "Vou voltar com mais alguns vegetais para fazer um ensopado decente, é o mínimo que posso fazer."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:116
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_9e88cc83:

    # MC @ talk "I’m meant to be meeting Mark—"
    MC @ talk "Eu devia encontrar-me com o Mark—"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:117
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_ac49d286:

    # REGINA @ smile_talk "I’ll be back in just a moment!"
    REGINA @ smile_talk "Volto já!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:120
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_70efe6d8:

    # "Before I could stop her, [regina_ref!t] was out of the door hurrying to buy some food."
    "Antes que eu pudesse detê-la, [regina_ref!t] estava porta afora correndo para comprar comida."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:121
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_9d8f7bf6:

    # MC @ talk "{i}*Sigh*{/i}"
    MC @ talk "{i}*Suspiro*{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:126
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_7fd05c85:

    # "Peering at the crack in the doorway to my bedroom, I ventured inside."
    "Espiando pela fresta da porta do meu quarto, me aventurei para dentro."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:127
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_2f9b1637:

    # "The room was warm, but untouched since I had last been in it."
    "O quarto estava quente, mas intocado desde a última vez que eu estive nele."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:128
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_611d7f4f:

    # "[regina_ref_cap!t] had made sure to dust and make the bed, maintaining it for my improbable return."
    "[regina_ref_cap!t] tinha se certificado de tirar o pó e arrumar a cama, mantendo-a para meu retorno improvável."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:129
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_ea71628f:

    # "It was odd standing in it again."
    "Era estranho estar nele novamente."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:130
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_e99550db:

    # "It felt like it belonged to some different time from a world now far away that I was no longer a part of."
    "Parecia pertencer a algum tempo diferente de um mundo agora distante do qual eu não fazia mais parte."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:132
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_69e7ddcf:

    # "All of mine and Markus’ nights of scheming unfolded here, often spent dreamily looking out towards the palace."
    "Todas as noites de esquemas minhas e de Markus se desdobraram aqui, muitas vezes passadas sonhadoramente olhando em direção ao palácio."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:133
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_caf32118:

    # "It all seemed so simple back then... even in a world as chaotic as this one."
    "Parecia tudo tão simples naquela época... mesmo num mundo tão caótico como este."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:134
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_c41f0caa:

    # "Now, everything seems so uncertain, like we are charting a course into some terrible storm, unable to stop ourselves as we are pulled into the watery ravages of the dreaded Black Ocean."
    "Agora, tudo parece tão incerto, como se estivéssemos a traçar um rumo para uma terrível tempestade, incapazes de nos deter enquanto somos arrastados para as devastações aquáticas do temido Oceano Negro."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:136
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_2898c036:

    # "Both of us should have died that night at the fort, and a part of me {i}still feels like we did{/i}."
    "Nós dois deveríamos ter morrido naquela noite no forte, e uma parte de mim {i}ainda sente que nós morremos{/i}."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:137
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_9fd34d7c:

    # "Turning to look at the old, cracked mirror, I stared into it, hoping to invoke that strange voice from last night."
    "Virando-me para olhar o velho espelho rachado, eu o encarei, esperando invocar aquela voz estranha da noite passada."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:138
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_b371400e:

    # MC @ talk "...Hello?"
    MC @ talk "...Olá?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:139
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_7760b7a8:

    # MC @ talk "Are you there? "
    MC @ talk "Está aí?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:140
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_f9ca0dad:

    # MC @ talk "{i}Spirit?{/i}"
    MC @ talk "{i}Espírito?{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:141
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_b28233a2:

    # "Unsurprisingly, no answer came."
    "Como era de esperar, não veio resposta."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:142
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_2bcf7e2a:

    # MC "Hm..."
    MC "Hm..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:143
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_e4b866cd:

    # "Heading over to my old bed, I flopped down onto it."
    "Indo para minha velha cama, me joguei nela."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:144
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_db3474b8:

    # "The frame creaked, struggling more than ever to support me, but as I sunk into the softness of it, I sighed with relief."
    "A estrutura rangeu, lutando mais do que nunca para me suportar, mas enquanto eu afundava na maciez dela, suspirei de alívio."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:145
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_9ee2712d:

    # "I hadn’t felt something so comfortable in months, the luxuriousness of it was almost like some distant memory."
    "Eu não sentia algo tão confortável há meses, o luxo disso era quase como uma lembrança distante."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:147
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_af59c89a:

    # "Closing my eyes for a moment, I felt..."
    "Fechando meus olhos por um momento, eu senti..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:156
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_b19e38ff:

    # "My eyes shot open as I sat upright, desperately gasping for air."
    "Meus olhos se abriram de repente enquanto eu me sentava, desesperadamente ofegante por ar."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:159
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_4a651378:

    # MC @ surprised "{i}... Fuck.{/i}"
    MC @ surprised "{i}... Foda-se.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:161
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_9477c75e:

    # "I heard the front door swing open once again to announce [regina_ref!t]'s return."
    "Ouvi a porta da frente balançar mais uma vez para anunciar o retorno de [regina_ref!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:162
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_274476ae:

    # REGINA @ talk "Are you still here?"
    REGINA @ talk "Você ainda está aqui?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:163
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_bb6054c4:

    # MC @ talk "I’m just in my room."
    MC @ talk "Estou apenas no meu quarto."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:164
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_6aaa7d1e:

    # "After listening out, a few moments later I heard some soft footsteps as the door crept open and [regina_ref!t] peeked inside."
    "Depois de prestar atenção, alguns momentos depois ouvi alguns passos suaves enquanto a porta se abria e [regina_ref!t] espiou para dentro."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:166
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_8798cba0:

    # REGINA @ talk "Is everything okay, dear?"
    REGINA @ talk "Está tudo bem, querido?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:167
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_90bda528:

    # MC @ talk "I’m fine..."
    MC @ talk "Estou bem..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:168
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_b7b3534a:

    # MC @ talk "It’s just..."
    MC @ talk "É só que..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:169
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_a2d8a856:

    # MC @ talk "Strange being back here, is all."
    MC @ talk "Estranho estar de volta aqui, só isso."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:170
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_71d4718f:

    # "Regina gave me a sympathetic look as she nodded in some small understanding."
    "Regina me deu um olhar simpático enquanto assentia com alguma pequena compreensão."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:171
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_d03d1560:

    # REGINA @ sad_talk "Come, I’m about to put the stew on for you."
    REGINA @ sad_talk "Vem, vou pôr o ensopado para você."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:172
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_c0c1b183:

    # MC @ talk "Alright..."
    MC @ talk "Está bem..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:173
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_e381c644:

    # MC @ talk "... [regina_ref_cap!t]?"
    MC @ talk "... [regina_ref_cap!t]?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:174
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_2b9cda49:

    # REGINA @ talk "Yes?"
    REGINA @ talk "Sim?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:175
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_f2baaa22:

    # MC @ talk "Thank you, for everything."
    MC @ talk "Obrigado, por tudo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:176
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_be966e8f:

    # "Regina smiled warmly, her eyes welling up ever so slightly before sliding out of the doorway back towards her cooking pot."
    "Regina sorriu calorosamente, seus olhos se enchendo levemente antes de deslizar para fora da porta de volta para a panela."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:180
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_7e88966e:

    # "A short while later, the homely food was served and I devoured every last scrap of it."
    "Pouco tempo depois, a comida caseira foi servida e eu devorei cada último pedaço dela."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:181
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_9913f732:

    # "We talked about many things, the good and the bad of my experiences with the Scouts, but I did my best to avoid discussing the fort and Duprey and Borras’ deaths."
    "Conversamos sobre muitas coisas, o bom e o ruim das minhas experiências com os Batedores, mas fiz o possível para evitar discutir o forte e as mortes de Duprey e Borras."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:182
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_34f338ce:

    # "Regina informed me that Adara had visited nearly every day to find out if I’d written any letters home that she could read."
    "Regina me informou que Adara tinha visitado quase todos os dias para descobrir se eu tinha escrito alguma carta para casa que ela pudesse ler."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:183
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_addc3724:

    # "I explained to [regina_ref!t] that I was a part of the Adventurers' guild now. It made her uncomfortable given that I had barely survived my trek with the Scouts..."
    "Expliquei para [regina_ref!t] que eu fazia parte da guilda de Aventureiros agora. Isso a deixou desconfortável dado que eu mal tinha sobrevivido à minha jornada com os Batedores..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:184
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_42e29a17:

    # "...But she didn’t let her displeasure be known through anything other than pursing her lips and going a little quiet."
    "...Mas ela não deixou seu descontentamento ser conhecido por nada além de franzir os lábios e ficar um pouco quieta."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:185
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_2ece8a6b:

    # "Finally, placing my bowl down onto the table, I rose from my seat."
    "Finalmente, colocando minha tigela na mesa, levantei-me do meu assento."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:190
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_c229410b:

    # MC @ talk "I have to go meet Markus now, we’ve got to show up at the Adventurers' Guild."
    MC @ talk "Tenho que ir encontrar Markus agora, temos que aparecer na Guilda dos Aventureiros."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:192
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_8f36c5e5:

    # REGINA @ talk "Will you be back later?"
    REGINA @ talk "Você vai voltar mais tarde?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:193
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_5bbe96f5:

    # MC @ talk "Of course, though it might not be till quite a bit later..."
    MC @ talk "Claro, embora talvez só bem mais tarde..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:194
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_a5e8ce64:

    # MC @ talk "Do you need anything?"
    MC @ talk "Precisa de alguma coisa?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:195
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_21b02044:

    # REGINA @ talk "Hmm... Well, if you’re offering..."
    REGINA @ talk "Hmm... Bem, se você está oferecendo..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:196
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_66035ecd:

    # REGINA @ talk "Could you pick up something for me from the Blacksmiths?"
    REGINA @ talk "Você poderia pegar algo para mim na Ferraria?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:197
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_2f447204:

    # MC @ talk "What is it?"
    MC @ talk "O que é?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:198
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_dbff95b5:

    # MC @ talk "[regina_ref_cap!t] blushed as she spoke but waved off the question before I could ask any more."
    MC @ talk "[regina_ref_cap!t] corou enquanto falava, mas dispensou a pergunta antes que eu pudesse perguntar mais."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:199
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_0a2b8690:

    # REGINA @ talk "Nothing, just a little something for myself..."
    REGINA @ talk "Nada, só uma coisinha para mim mesma..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:200
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_2ded8107:

    # REGINA @ talk "It should be wrapped in a box, just tell them it’s for me."
    REGINA @ talk "Deve estar embrulhado em uma caixa, diga apenas que é para mim."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:201
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_f1f0b2cc:

    # MC @ talk "Sure."
    MC @ talk "Claro."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:203
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_5d0f376e:

    # MC @ talk "Well, I best get a move on."
    MC @ talk "Bem, é melhor eu ir indo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:204
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_266a8d3f:

    # REGINA @ talk "Okay, dear."
    REGINA @ talk "Ok, querida."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:205
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_a6585a75:

    # REGINA @ talk "Just... {i}be safe.{/i}"
    REGINA @ talk "Apenas... {i}esteja seguro.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr02.rpy:207
translate ptBR qst_FromAnotherWorld_ReturnHome_ReginaTalk_8b411f76:

    # "As I was about to leave, I once again felt her press up against me."
