    # BLACK "{i}The hive must {b}always{/b} survive.{/i}"
    BLACK "{i}A colmeia deve {b}sempre{/b} sobreviver.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:140
