    WHITE "{i}Assim que isso estiver concluído, o hospedeiro estará sob nosso controle.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:118
translate ptBR qst_FromAnotherWorld_GoToMarkusHouse_49579012:

    # MC @ talk "You— You’re killing us?!"
    MC @ talk "Você— Você está nos matando?!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:119
translate ptBR qst_FromAnotherWorld_GoToMarkusHouse_a2d2271f:

