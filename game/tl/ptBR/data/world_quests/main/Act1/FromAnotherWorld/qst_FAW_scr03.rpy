translate ptBR qst_FromAnotherWorld_GoToMarkusHouse_2db601d1:

    # WHITE "{i}We are both a symbiotic and parasitic race.{/i}"
    WHITE "{i}Somos uma raça tanto simbiótica quanto parasita.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:133
translate ptBR qst_FromAnotherWorld_GoToMarkusHouse_3e58b722:

    # BLACK "{i}We have no name.{/i}"
    BLACK "{i}Não temos nome.{/i}"

