    BLACK "{i}Somos diferentes em muitos aspectos, mas iguais em muitos outros.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:115
translate ptBR qst_FromAnotherWorld_GoToMarkusHouse_7e05aa22:

    # MARKUS "... W-What do you want from us?"
    MARKUS "... O-O que vocês querem de nós?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:116
translate ptBR qst_FromAnotherWorld_GoToMarkusHouse_0dfe344b:

    # BLACK "{i}As we speak... we are travelling up your nervous system to complete the infection of your cerebral cortex.{/i}"
    BLACK "{i}Enquanto falamos... estamos subindo pelo seu sistema nervoso para completar a infecção do córtex cerebral de vocês.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:117
translate ptBR qst_FromAnotherWorld_GoToMarkusHouse_bdfe7a0e:

