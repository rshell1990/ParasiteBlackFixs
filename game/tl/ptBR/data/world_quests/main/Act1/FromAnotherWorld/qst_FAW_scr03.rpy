    BLACK "{i}Podemos liberar feromônios que auxiliam no ato de atrair parceiros.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:160
translate ptBR act1scene4menu_5384002a:

    # WHITE "{i}You may also transform into our secondary forms for combat or any other purposes you so wish.{/i}"
    WHITE "{i}Você também pode se transformar em nossas formas secundárias para combate ou quaisquer outros propósitos que desejar.{/i}"

