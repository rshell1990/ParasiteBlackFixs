    # WHITE "{i}Rest is needed now...{/i}"
    WHITE "{i}Descanso é necessário agora...{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:188
translate ptBR act1scene4menu_fbd8fa7c:

    # BLACK "{i}Yes... More rest.{/i}"
    BLACK "{i}Sim... Mais descanso.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:189
translate ptBR act1scene4menu_f7c46184:

    # "The voices fell silent."
    "As vozes ficaram em silêncio."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:190
translate ptBR act1scene4menu_1657b476:

    # "Ever so slowly, the things retreated back into our chests and, eventually, our breathing calmed and our hearts stopped threatening to shudder to a stop."
    "Bem lentamente, as coisas recuaram de volta para nossos peitos e, eventualmente, nossa respiração se acalmou e nossos corações pararam de ameaçar estremecer até parar."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:195
