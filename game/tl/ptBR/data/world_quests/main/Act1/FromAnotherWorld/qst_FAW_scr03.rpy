translate ptBR act1scene4menu_fd69c436:

    # BLACK "{i}Our secondary forms, they are optimal in the use of the primary functions, should you so require.{/i}"
    BLACK "{i}Nossas formas secundárias são ideais para o uso das funções primárias, se assim desejar.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:163
translate ptBR act1scene4menu_78508801:

    # MC @ talk "How do we change into your... secondary form?"
    MC @ talk "Como nos transformamos em sua... forma secundária?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:164
translate ptBR act1scene4menu_f6b8d387:

    # BLACK "{i}It is like having another limb... Focus on using it and you will transform.{/i}"
    BLACK "{i}É como ter outro membro... Concentre-se em usá-lo e você se transformará.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:165
translate ptBR act1scene4menu_1acd9b2d:

    # BLACK "{i}The first time will be painful.{/i}"
    BLACK "{i}A primeira vez será dolorosa.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:169
translate ptBR act1scene4menu_e57cd7e3:

    # BLACK "{i}A week.{/i}"
    BLACK "{i}Uma semana.{/i}"

