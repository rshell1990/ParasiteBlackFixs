translate ptBR act1scene4menu_53822368:

    # MC @ talk "A week?! That’s it?"
    MC @ talk "Uma semana?! Só isso?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:171
translate ptBR act1scene4menu_79e6c264:

    # BLACK "Mating reverses the feral process... Our species was genetically built to breed and multiply, failure to do so causes... Mutations."
    BLACK "O acasalamento reverte o processo feral... Nossa espécie foi geneticamente projetada para procriar e se multiplicar; a falha em fazê-lo causa... mutações."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:175
translate ptBR act1scene4menu_1039e80d:

    # BLACK "{i}We do not remember.{/i}"
    BLACK "{i}Nós não nos lembramos.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:176
translate ptBR act1scene4menu_e94eda9d:

    # MC @ talk "How do you not know?"
    MC @ talk "Como você não sabe?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:177
translate ptBR act1scene4menu_24103354:

    # WHITE "{i}Such functions are not deemed necessary for survival... Only the primary function remains.{/i}"
    WHITE "{i}Tais funções não são consideradas necessárias para a sobrevivência... Apenas a função primária permanece.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:178
translate ptBR act1scene4menu_0a347215:

    # BLACK "{i}... And what we have assimilated from you.{/i}"
    BLACK "{i}... E o que assimilamos de você.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:182
translate ptBR act1scene4menu_ea525212:

    # BLACK "{i}Yes...{/i}"
    BLACK "{i}Sim...{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:185
translate ptBR act1scene4menu_eb3b32fe:

    # WHITE "{i}Work with us. Do not fight us.{/i}"
    WHITE "{i}Trabalhe conosco. Não lute contra nós.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr03.rpy:186
translate ptBR act1scene4menu_f9cff37b:

