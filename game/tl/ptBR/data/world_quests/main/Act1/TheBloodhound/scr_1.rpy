translate ptBR qst_bloodhound_1_TheaOnGuardians_9f40d81a:

    # THEA @ talk "They're newcomers but they seem quite popular."
    THEA @ talk "Eles são novatos, mas parecem bem populares."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:11
translate ptBR qst_bloodhound_1_TheaOnGuardians_dd63aafe:

    # THEA @ scared "Maybe a little too cocky though."
    THEA @ scared "Talvez um pouco convencido demais."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:12
translate ptBR qst_bloodhound_1_TheaOnGuardians_b6feebab:

    # MC @ talk "Not a fan?"
    MC @ talk "Não é fã?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:13
translate ptBR qst_bloodhound_1_TheaOnGuardians_68490604:

    # THEA @ talk "Mm, every rookie team thinks they're the chosen ones or something."
    THEA @ talk "Mm, toda equipe novata acha que são os escolhidos ou algo assim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:14
translate ptBR qst_bloodhound_1_TheaOnGuardians_07b3b10c:

    # THEA @ smile2 "I prefer the ones who actually manage to stick around."
    THEA @ smile2 "Prefiro os que realmente conseguem ficar por perto."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:15
translate ptBR qst_bloodhound_1_TheaOnGuardians_7805f446:

    # MC @ talk "Where are they now?"
    MC @ talk "Onde eles estão agora?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:16
translate ptBR qst_bloodhound_1_TheaOnGuardians_47145c71:

    # THEA @ talk "They took on a quest to take on a giant slimelark."
    THEA @ talk "Eles aceitaram uma missão para enfrentar uma cotovia-limosa gigante."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:17
translate ptBR qst_bloodhound_1_TheaOnGuardians_4e1580f2:

    # MC @ surprised "A what?"
    MC @ surprised "Um quê?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:18
translate ptBR qst_bloodhound_1_TheaOnGuardians_f7d02ddf:

    # THEA @ talk "Uhh, think a very angry sentient pool of gunk that will force its way into you and consume you inside out."
    THEA @ talk "Uh, pense em uma poça senciente muito brava de gosma que vai se enfiar em você e te consumir de dentro para fora."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:19
translate ptBR qst_bloodhound_1_TheaOnGuardians_1cdd0735:

    # MC @ talk "Can they handle it?"
    MC @ talk "Eles conseguem lidar com isso?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:20
translate ptBR qst_bloodhound_1_TheaOnGuardians_a2519c48:

    # THEA @ sad "I don't know... A slimelark isn't something to shrug off if you're a rookie."
    THEA @ sad "Não sei... Uma cotovia-de-limo não é algo para ignorar se você é novato."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:21
translate ptBR qst_bloodhound_1_TheaOnGuardians_2455d26f:

    # THEA @ sad "Especially the one that's been causing so much trouble."
    THEA @ sad "Especialmente o que tem causado tantos problemas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:22
translate ptBR qst_bloodhound_1_TheaOnGuardians_022994e2:

    # THEA @ sad "I told them not to take it but, when you've got something to prove..."
    THEA @ sad "Disse para não pegarem mas, quando você tem algo a provar..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:23
translate ptBR qst_bloodhound_1_TheaOnGuardians_c1b60765:

    # THEA @ talk "Anyway, the thing has been sighted near lake Balun, you know, a short hike to the West?"
    THEA @ talk "Enfim, a coisa foi avistada perto do lago Balun, sabe, uma curta caminhada para o Oeste?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:24
translate ptBR qst_bloodhound_1_TheaOnGuardians_261d13c3:

    # THEA @ scared "Apparently its been pulling people in when they get too close to the water."
    THEA @ scared "Aparentemente está puxando as pessoas quando chegam perto demais da água."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:25
translate ptBR qst_bloodhound_1_TheaOnGuardians_23817d50:

    # MC @ talk "Thanks for the information."
    MC @ talk "Obrigado pela informação."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:26
translate ptBR qst_bloodhound_1_TheaOnGuardians_d05df937:

    # THEA @ sad "If you're thinking of going after them, I'd suggest being prepared..."
    THEA @ sad "Se está pensando em ir atrás deles, sugiro estar preparado..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:27
translate ptBR qst_bloodhound_1_TheaOnGuardians_8f6a6938:

    # THEA @ talk "Slimelarks are difficult beasts."
    THEA @ talk "Cotovias-Limosas são feras difíceis."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:28
translate ptBR qst_bloodhound_1_TheaOnGuardians_a9bcd73d:

    # MC @ talk "I'll take your word for it."
    MC @ talk "Vou acreditar em você."

