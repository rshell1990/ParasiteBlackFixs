translate ptBR qst_bloodhound_2_camp_menu_e0a8dfaa:

    # MC "(I could try tear it open... But I might damage whatever is inside.)"
    MC "(Eu poderia tentar rasgá-la... Mas posso danificar o que estiver dentro.)"

