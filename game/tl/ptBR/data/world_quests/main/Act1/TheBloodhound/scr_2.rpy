translate ptBR qst_bloodhound_2_camp_menu_cd3844b9:

    # MC "(An extinguished fire pit... Been dead for a while now.)"
    MC "(Uma fogueira apagada... Já está morta há um tempo.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:30
translate ptBR qst_bloodhound_2_camp_menu_07b572b5:

    # MC "(...Wait, there's something there in the pit!)"
    MC "(...Espere, há algo ali na fogueira!)"

