# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:95
translate ptBR qst_bloodhound_3_toBasement_eaa30016:

    # "Heading down into the darkness with a lit torch, each step echoing as I descended down."
    "Descendo para a escuridão com uma tocha acesa, cada passo ecoando enquanto eu descia."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:98
translate ptBR qst_bloodhound_3_toBasement_510bae7c:

    # "Down the stairs, I could hear the sound of dripping grow louder."
    "Descendo as escadas, eu podia ouvir o som de gotejamento ficar mais alto."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:99
translate ptBR qst_bloodhound_3_toBasement_04b96fb8:

    # "Through a small underground passage, I could see a light at the end of the tunnel."
    "Através de uma pequena passagem subterrânea, eu podia ver uma luz no fim do túnel."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:100
translate ptBR qst_bloodhound_3_toBasement_c439e1b9:

    # "Moving towards and peering around the corner..."
    "Movendo-me em direção e espiando ao redor da esquina..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:101
translate ptBR qst_bloodhound_3_toBasement_69649a42:

    # "A nightmare awaited me."
    "Um pesadelo me esperava."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:108
translate ptBR qst_bloodhound_3_toBasement_6706efee:

    # "The man I presumed to be Azul hung upside down, his lower jaw broken and hang by the thinnest thread of flesh."
    "O homem que eu presumi ser Azul pendia de cabeça para baixo, sua mandíbula inferior quebrada e pendurada pelo mais fino fio de carne."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:109
translate ptBR qst_bloodhound_3_toBasement_8f6c41e0:

    # "His eyes were torn out leaving red trails of blood decorating his horrified, pale face."
    "Seus olhos foram arrancados deixando trilhas vermelhas de sangue decorando seu rosto horrorizado e pálido."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:110
translate ptBR qst_bloodhound_3_toBasement_0d45b3d7:

    # "His body desecrated, long hooks dug into the flesh pulling back sheets of flesh as a pool of blood circled his body beneath."
    "Seu corpo profanado, longos ganchos cavados na carne puxando camadas de pele enquanto uma poça de sangue circulava seu corpo por baixo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:111
translate ptBR qst_bloodhound_3_toBasement_661276f1:

    # "In his exposed ribcage, a crude cage was formed with sharp metal shards, inside a black crow cried as it pecked at his insides angrily."
    "Em sua caixa torácica exposta, uma gaiola tosca foi formada com farpas de metal afiadas, dentro um corvo negro gritava enquanto bicava suas entranhas raivosamente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:112
translate ptBR qst_bloodhound_3_toBasement_810f6de6:

    # MC @ talk "{i}...Gods.{/i}"
    MC @ talk "{i}...Deuses.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:113
translate ptBR qst_bloodhound_3_toBasement_3f254257:

    # "The repugnant smell of rotting flesh began to make me nearly hurl as a dozen flies circled around the pale flesh."
    "O cheiro repugnante de carne apodrecendo começou a quase me fazer vomitar enquanto uma dúzia de moscas circulavam a carne pálida."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:114
translate ptBR qst_bloodhound_3_toBasement_c3c642d0:

    # "Behind me, I heard the sounds of some mechanism ticking..."
    "Atrás de mim, ouvi os sons de algum mecanismo tiquetaqueando..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:117
translate ptBR qst_bloodhound_3_toBasement_19ed433f:

    # "Sensing danger, I turned."
    "Sentindo perigo, me virei."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:121
translate ptBR qst_bloodhound_3_toBasement_c0466f52:

    # "A man in black stood before me, his face not visible behind the mask and strange goggles, unnerving ticking sound coming from inside his chest."
    "Um homem de preto estava diante de mim, seu rosto não visível atrás da máscara e óculos estranhos, som de tiquetaque inquietante vindo de dentro de seu peito."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:122
translate ptBR qst_bloodhound_3_toBasement_988c5159:

    # "The thing moved jankily, making strange sounds as it curiously turned its head to look at me before drawing out the long blades from its arms."
    "A coisa se movia roboticamente, fazendo sons estranhos enquanto curiosamente virava sua cabeça para me olhar antes de sacar as longas lâminas de seus braços."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:123
translate ptBR qst_bloodhound_3_toBasement_4277bc35:

    # MC @ angry "I take it talking is out of the question?"
    MC @ angry "Presumo que conversar está fora de questão?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:124
translate ptBR qst_bloodhound_3_toBasement_c8cb10b4:

    # "The thing stepped forward, its hand shaking slightly."
    "A coisa deu um passo à frente, sua mão tremendo levemente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:129
translate ptBR qst_bloodhound_3_toBasement_9a8e3593:

    # MC @ angry "Fuck!"
    MC @ angry "Porra!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:137
translate ptBR qst_bloodhound_3_toBasement_3ff24643:

    # "Once again, I quickly tore from my flesh just as the thing was about to strike, barely blocking it in time with my own claws and managing to push it back."
    "Mais uma vez, rapidamente rasguei minha carne bem quando a coisa estava prestes a atacar, mal bloqueando a tempo com minhas próprias garras e conseguindo empurrá-la para trás."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:139
translate ptBR qst_bloodhound_3_toBasement_ee112fff:

    # MC "No choice now!"
    MC "Sem escolha agora!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:154
translate ptBR qst_bloodhound_3_toBasement_c0b25ad9:

    # "Dodging left and right, the man in black moved quicker than I anticipated, dodging most of my strikes and managing to land hit after hit against me."
    "Desviando para a esquerda e direita, o homem de preto se moveu mais rápido do que eu antecipava, desviando da maioria dos meus golpes e conseguindo acertar golpe após golpe contra mim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:155
translate ptBR qst_bloodhound_3_toBasement_ec059881:

    # "Its blades were unlike any other blade I'd seen before."
    "Suas lâminas eram diferentes de qualquer outra lâmina que eu já tinha visto antes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:156
translate ptBR qst_bloodhound_3_toBasement_4532cba5:

    # "Perhaps they were enchanted, but they seemed sharper and able to cut at my flesh unlike any other."
    "Talvez fossem encantadas, mas pareciam mais afiadas e capazes de cortar minha carne como nenhuma outra."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:157
translate ptBR qst_bloodhound_3_toBasement_b7befe8a:

    # "I managed to strike it with my tail, piercing a gaping hole through its chest."
    "Consegui atingi-lo com minha cauda, perfurando um buraco aberto em seu peito."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:158
translate ptBR qst_bloodhound_3_toBasement_1c0b9dcc:

    # "But instead of turning limp, it slashed down, causing a painful wound in my tail as it continued on despite its horrific injury."
    "Mas em vez de ficar mole, ele cortou para baixo, causando um ferimento doloroso na minha cauda enquanto continuava apesar de seu ferimento horripilante."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:159
translate ptBR qst_bloodhound_3_toBasement_40f4935f:

    # MC "(What the fuck is this thing?!)"
    MC "(Que porra é essa coisa?!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:160
translate ptBR qst_bloodhound_3_toBasement_b29379dc:

    # MC "(Is it even killable?)"
    MC "(Será que isso pode ser morto?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:161
translate ptBR qst_bloodhound_3_toBasement_323868cf:

    # "Once again, the thing leapt forward, and after a few clashes of our blades, it suddenly pierced through me with one of it's claw hands."
    "Mais uma vez, a coisa saltou para frente, e após alguns choques de nossas lâminas, de repente me perfurou com uma de suas mãos em garra."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:162
translate ptBR qst_bloodhound_3_toBasement_d327c627:

    # "Screaming in pain, I charged forward, managing to knock the man in black against the opposing wall but it dodged my subsequent lethal swipe to take its head off."
    "Gritando de dor, avancei, conseguindo jogar o homem de preto contra a parede oposta mas ele desviou do meu golpe letal subsequente que tiraria sua cabeça."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:163
translate ptBR qst_bloodhound_3_toBasement_39009672:

    # "It felt like a horrific dance as the thing moved around me, taking piece after piece."
    "Parecia uma dança horripilante enquanto a coisa se movia ao meu redor, tirando pedaço após pedaço."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:164
translate ptBR qst_bloodhound_3_toBasement_b5c60d7e:

    # "I began to feel dizzy and increasingly weak..."
    "Comecei a sentir tontura e cada vez mais fraco..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:165
translate ptBR qst_bloodhound_3_toBasement_3f7ba3ac:

    # "Just how much longer could I keep this up?"
    "Por quanto mais tempo eu poderia continuar assim?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:166
translate ptBR qst_bloodhound_3_toBasement_733ec587:

    # MC "(F-Fuck! Can you help me out here?)"
    MC "(P-Porra! Pode me ajudar aqui?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:167
translate ptBR qst_bloodhound_3_toBasement_d0ca6432:

    # BLACK "Flee."
    BLACK "Fuja."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:168
translate ptBR qst_bloodhound_3_toBasement_e28f5ee5:

    # MC "(Flee?! You can't be serious!)"
    MC "(Fugir?! Você não pode estar falando sério!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:169
translate ptBR qst_bloodhound_3_toBasement_6e2d0cec:

    # BLACK "Cannot stabilize damage much longer."
    BLACK "Não consigo estabilizar o dano por muito mais tempo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:170
translate ptBR qst_bloodhound_3_toBasement_60f0bc89:

    # BLACK "His blades are coated with something slowing the rapid healing response."
    BLACK "As lâminas dele estão revestidas com algo que retarda a rápida resposta de cura."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:171
translate ptBR qst_bloodhound_3_toBasement_872010a3:

    # MC "(Fuck! FUCK!)"
    MC "(Porra! PORRA!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:172
translate ptBR qst_bloodhound_3_toBasement_35522119:

    # "I looked towards the stairs once again."
    "Olhei em direção às escadas mais uma vez."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:173
translate ptBR qst_bloodhound_3_toBasement_2dbdb956:

    # "The man in black blocked my path, blades ready."
    "O homem de preto bloqueou meu caminho, lâminas prontas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:174
translate ptBR qst_bloodhound_3_toBasement_92f5db33:

    # MC "(I have to try, I just need to get past!)"
    MC "(Tenho que tentar, só preciso passar!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:175
translate ptBR qst_bloodhound_3_toBasement_05ee5938:

    # "I darted onto the side wall, springing off from my foot to bounce off as I twisted my whole body and swung my tail to try and knock the man back."
    "Eu disparei para a parede lateral, saltando do meu pé para quicar enquanto torcia meu corpo inteiro e balançava minha cauda para tentar derrubar o homem."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:176
translate ptBR qst_bloodhound_3_toBasement_6a1754bb:

    # "It grabbed onto my tail as I slammed it against the wall, sending shards of stone flying."
    "Ele agarrou minha cauda enquanto eu a batia contra a parede, enviando estilhaços de pedra voando."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:177
translate ptBR qst_bloodhound_3_toBasement_d7df702e:

    # "The man in black refused to give up, forcing blades through my tail."
    "O homem de preto se recusava a desistir, forçando lâminas através da minha cauda."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:178
translate ptBR qst_bloodhound_3_toBasement_20d8f036:

    # "I screeched out in pain but the man in black kept coming no matter what I did."
    "Eu gritei de dor mas o homem de preto continuava vindo não importava o que eu fizesse."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:179
translate ptBR qst_bloodhound_3_toBasement_cb953dbd:

    # "Only now did I realize how close death was..."
    "Só agora eu percebi o quão perto a morte estava..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:180
translate ptBR qst_bloodhound_3_toBasement_0e939507:

    # UNKNOWN "{i}*Whistles*{/i}"
    UNKNOWN "{i}*Assobios*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:182
translate ptBR qst_bloodhound_3_toBasement_9afc807c:

    # "As the man in black turned sharply towards the sound, he was suddenly blasted back by a bolt of lightning."
    "Quando o homem de preto se virou bruscamente em direção ao som, ele foi subitamente arremessado para trás por um raio de relâmpago."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:183
translate ptBR qst_bloodhound_3_toBasement_13c9ce29:

    # "Beside Captain Nyx, four mages stood at the ready, their staffs pointed towards the convulsing automaton."
    "Ao lado da Capitã Nyx, quatro magos estavam prontos, seus cajados apontados para o autômato convulsivo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:211
translate ptBR qst_bloodhound_3_toBasement_98ef091a:

    # "It struggled and rose to its feet again, charging towards the Captain and the mages."
    "Ele lutou e se levantou novamente, avançando contra a Capitã e os magos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:218
translate ptBR qst_bloodhound_3_toBasement_9304bfda:

    # "...But another blast sent him wheeling backwards."
    "...Mas outro disparo o mandou rodopiando para trás."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:220
translate ptBR qst_bloodhound_3_toBasement_18e5bb6b:

    # "Clambering back to its feet before they could finish it off, the man in black charged forward, dodging the third blast right through the Captain and her mages, scurrying its way up the stairs."
    "Subindo de volta antes que pudessem acabar com ele, o homem de preto avançou, desviando do terceiro disparo direto através da Capitã e seus magos, correndo escada acima."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:221
translate ptBR qst_bloodhound_3_toBasement_53131c31:

    # NYX @ angry "AFTER HIM!"
    NYX @ angry "ATRÁS DELE!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:222
translate ptBR qst_bloodhound_3_toBasement_03084257:

    # MAGE "But... What about the other one?"
    MAGE "Mas... E o outro?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:223
translate ptBR qst_bloodhound_3_toBasement_f1f00a2f:

    # NYX @ angry "Leave him!"
    NYX @ angry "Deixem-no!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:224
translate ptBR qst_bloodhound_3_toBasement_235c9198:

    # NYX @ angry "{i}He's with us.{/i}"
    NYX @ angry "{i}Ele está conosco.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:233
translate ptBR qst_bloodhound_3_toBasement_26742987:

    # "The mages followed after him as I weakly stumbled behind them deliriously, blood pouring out of me."
    "Os magos o seguiram enquanto eu fracamente cambaleava atrás deles delirantemente, sangue jorrando de mim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:235
translate ptBR qst_bloodhound_3_toBasement_e2baa4ae:

    # "Dizzy, I saw mages and Nyx fight the thing relentlessly."
    "Tonto, vi magos e Nyx lutarem contra a coisa implacavelmente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:236
translate ptBR qst_bloodhound_3_toBasement_45fc3d08:

    # "After a few blows, the Man in black knocked back Captain Nyx before leaping through one of the glass windows, shattering it."
    "Após alguns golpes, o Homem de preto derrubou a Capitã Nyx antes de pular através de uma das janelas de vidro, estilhaçando-a."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:242
translate ptBR qst_bloodhound_3_toBasement_b7f2c043:

    # "From outside, we watched as he contorted his body with unnatural speed, dragging himself up unto a building and moving away too fast for us to even see."
    "Do lado de fora, observamos enquanto ele contorcia seu corpo com velocidade não natural, arrastando-se para cima de um prédio e se afastando rápido demais para sequer vermos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:243
translate ptBR qst_bloodhound_3_toBasement_58688400:

    # MAGE "Captain! Do we pursue?"
    MAGE "Capitã! Vamos persegui-lo?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:244
translate ptBR qst_bloodhound_3_toBasement_b9c6a5a9:

    # SECOND_MAGE "We need more time to prepare another charge!"
    SECOND_MAGE "Precisamos de mais tempo para preparar outra carga!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:258
translate ptBR qst_bloodhound_3_toBasement_fdeb4bdc:

    # NYX @ angry "No... Whatever that thing is, its gone."
    NYX @ angry "Não... Seja lá o que for aquela coisa, já se foi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:259
translate ptBR qst_bloodhound_3_toBasement_d1beeab3:

    # "Unable to handle a single step more my buckling legs gave and I dropped to my knees."
    "Incapaz de aguentar mais um passo, minhas pernas vacilantes cederam e eu caí de joelhos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:261
translate ptBR qst_bloodhound_3_toBasement_2fb16082:

    # "Blood poured from all over my mangled body as I crashed forward with a thud."
    "Sangue jorrava de todo o meu corpo mutilado enquanto eu desabava para frente com um baque."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:264
translate ptBR qst_bloodhound_3_toBasement_6859ac9e:

    # NYX "SHIT!"
    NYX "MERDA!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:265
translate ptBR qst_bloodhound_3_toBasement_c58b41a1:

    # "Darkness."
    "Escuridão."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:280
translate ptBR qst_bloodhound_3_toBasement_3e507460:

    # NYX @ shock "...Hey, HEY! He's opening his eyes!"
    NYX @ shock "...Ei, EI! Ele está abrindo os olhos!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:281
translate ptBR qst_bloodhound_3_toBasement_96bf910a:

    # MC "Urghh..."
    MC "Urgh..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:282
translate ptBR qst_bloodhound_3_toBasement_ad80ee54:

    # MAGE_TALL "We did our best to heal the creatures wounds but-"
    MAGE_TALL "Fizemos o nosso melhor para curar as feridas da criatura, mas-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:283
translate ptBR qst_bloodhound_3_toBasement_1d30ae43:

    # MAGE_TALL "Captain... What is this thing?"
    MAGE_TALL "Capitão... O que é esta coisa?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:284
translate ptBR qst_bloodhound_3_toBasement_113a6d97:

    # MAGE_SLIM "It... It looks like a man, but earlier-"
    MAGE_SLIM "Ele... Ele parece um homem, mas antes-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:285
translate ptBR qst_bloodhound_3_toBasement_52521e89:

    # NYX @ angry "Never you mind."
    NYX @ angry "Deixa para lá."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:286
translate ptBR qst_bloodhound_3_toBasement_a42b3df1:

    # NYX @ talk "Now help him back to his feet!"
    NYX @ talk "Agora ajudem-no a se levantar!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:289
translate ptBR qst_bloodhound_3_toBasement_c6e0476f:

    # "The mages weakly helped me back to my feet which trembled and shook, barely able to hold me upright."
    "Os magos fracamente me ajudaram a ficar de pé novamente, que tremiam e balançavam, mal conseguindo me manter em pé."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:308
translate ptBR qst_bloodhound_3_toBasement_07dd01bf:

    # MC @ talk "{i}*Cough*{/i} How did you-"
    MC @ talk "{i}*Tosse*{/i} Como você-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:309
translate ptBR qst_bloodhound_3_toBasement_06fdd052:

    # NYX @ talk "We will talk later, I will explain everything soon."
    NYX @ talk "Falaremos depois, explicarei tudo em breve."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:310
translate ptBR qst_bloodhound_3_toBasement_9ae00cf0:

    # "Captain Nyx turned towards the other mages."
    "A Capitã Nyx se virou para os outros magos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:313
translate ptBR qst_bloodhound_3_toBasement_33bce3a6:

    # NYX @ angry "None of you will speak of what you have seen today, understand?"
    NYX @ angry "Nenhuma de vocês falará sobre o que viram hoje, entenderam?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:314
translate ptBR qst_bloodhound_3_toBasement_f9a9e350:

    # "The mages look at each other sheepishly."
    "Os magos se olham timidamente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:315
translate ptBR qst_bloodhound_3_toBasement_675dbf11:

    # NYX @ angry "I assure you, {i}the fates will not favor you for a lack of discretion, ladies.{/i}"
    NYX @ angry "Garanto-vos, {i}os destinos não vos favorecerão por falta de discrição, senhoras.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:316
translate ptBR qst_bloodhound_3_toBasement_4abde0dd:

    # "The mages all nervously nodded."
    "Os magos todos assentiram nervosamente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:326
translate ptBR qst_bloodhound_3_toBasement_d626dae3:

    # NYX @ talk "Now help me dress him."
    NYX @ talk "Agora me ajudem a vesti-lo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:330
translate ptBR qst_bloodhound_3_toBasement_4896de1a:

    # "The Mages eyes looked downwards as their cheeks flushed red."
    "Os olhos dos Magos olharam para baixo enquanto suas bochechas coravam."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:331
translate ptBR qst_bloodhound_3_toBasement_7a8a690f:

    # NYX @ angry "...Oh for the love of-"
    NYX @ angry "...Oh, pelo amor de-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:332
translate ptBR qst_bloodhound_3_toBasement_28ca6b76:

    # NYX @ blush "Sisters... {i}Eyes up{/i} and focus."
    NYX @ blush "Irmãs... {i}Olhos para cima{/i} e concentrem-se."

translate ptBR strings:

    # game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:30
    old "Pull the rug to the side"
    new "Puxar o tapete para o lado"

    # game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:87
    old "Go"
    new "Ir"

    # game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:89
    old "Not yet"
    new "Ainda não"

