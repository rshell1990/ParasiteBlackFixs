# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:2
translate ptBR qst_bloodhound_4_atFort_aed6965c:

    # "The next hour was a kind of blur as the mages dressed me and helped me stumble by way back towards Fort Sebastian."
    "A hora seguinte foi uma espécie de borrão enquanto os magos me vestiam e me ajudavam a tropeçar de volta para o Forte Sebastian."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:5
translate ptBR qst_bloodhound_4_atFort_dbd56900:

    # "Brought into the Medical Ward, the nuns hurried over to treat me alongside the influx of other poor bastards."
    "Levado para a Enfermaria, as freiras correram para me tratar junto com o influxo de outros pobres desgraçados."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:8
translate ptBR qst_bloodhound_4_atFort_6af63c0b:

    # "Here and there I noticed were a few Scouts."
    "Aqui e ali notei que havia alguns Batedores."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:9
translate ptBR qst_bloodhound_4_atFort_5d3a3559:

    # "Battered, broken, some had limbs missing."
    "Machucados, quebrados, alguns tinham membros faltando."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:10
translate ptBR qst_bloodhound_4_atFort_7327635b:

    # "Laying beside them, I remembered how I hoped never to end up here again."
    "Deitado ao lado deles, lembrei como eu esperava nunca acabar aqui novamente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:11
translate ptBR qst_bloodhound_4_atFort_b0c99eb3:

    # "Yet, here I was."
    "No entanto, aqui estava eu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:15
translate ptBR qst_bloodhound_4_atFort_08507bf0:

    # "Captain Nyx spoke to some of the Nuns."
    "A Capitã Nyx falou com algumas das Freiras."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:19
translate ptBR qst_bloodhound_4_atFort_3357746f:

    # "As I struggled to stay awake, I couldn't focus on what was being said..."
    "Enquanto eu lutava para ficar acordado, não conseguia focar no que estava sendo dito..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:23
translate ptBR qst_bloodhound_4_atFort_1c58eea8:

    # "At some point, one of the nuns came to see me and fed me some holly sap for the pain."
    "Em algum momento, uma das freiras veio me ver e me alimentou com um pouco de seiva sagrada para a dor."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:27
translate ptBR qst_bloodhound_4_atFort_217b2342:

    # "Since my {i}change{/i}, I hadn't experienced pain like this."
    "Desde minha {i}mudança{/i}, eu não tinha experimentado dor como essa."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:31
translate ptBR qst_bloodhound_4_atFort_32efdd9d:

    # "Every muscle ached as I felt numerous broken bones inside me struggling to mend."
    "Cada músculo doía enquanto eu sentia numerosos ossos quebrados dentro de mim lutando para se consertar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:35
translate ptBR qst_bloodhound_4_atFort_fc7016e4:

    # MC "(What happened back there?)"
    MC "(O que aconteceu lá atrás?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:36
translate ptBR qst_bloodhound_4_atFort_e7f55388:

    # MC "(Shit shit! How in all the damn hells did she know about me?)"
    MC "(Merda, merda! Como em todos os malditos infernos ela sabia sobre mim?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:37
translate ptBR qst_bloodhound_4_atFort_0422337d:

    # MC "(Urghh... Why is the healing taking so long?)"
    MC "(Urghh... Por que a cura está demorando tanto?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:38
translate ptBR qst_bloodhound_4_atFort_78cfcf79:

    # BLACK "The effects of the poison are still active within our bloodstream."
    BLACK "Os efeitos do veneno ainda estão ativos em nossa corrente sanguínea."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:39
translate ptBR qst_bloodhound_4_atFort_6f610828:

    # MC "(That thing it... {i}It nearly killed us{/i}.)"
    MC "(Aquela coisa... {i}Ela quase nos matou{/i}.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:40
translate ptBR qst_bloodhound_4_atFort_4ba8b71c:

    # BLACK "Yes."
    BLACK "Sim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:41
translate ptBR qst_bloodhound_4_atFort_10d9725d:

    # MC "(But how? I thought we were like, nearly impossible to kill or something!)"
    MC "(Mas como? Eu pensei que éramos tipo, quase impossíveis de matar ou algo assim!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:42
translate ptBR qst_bloodhound_4_atFort_0be017dd:

    # BLACK "This assessment is incorrect."
    BLACK "Esta avaliação está incorreta."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:43
translate ptBR qst_bloodhound_4_atFort_14f01e94:

    # MC "(What? Well... We've handled everything until now!)"
    MC "(O quê? Bem... Nós lidamos com tudo até agora!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:44
translate ptBR qst_bloodhound_4_atFort_f1fae085:

    # BLACK "Our battle form is durable but {i}not invincible{/i}, there are no doubt plenty of beings capable of killing us."
    BLACK "Nossa forma de batalha é durável, mas {i}não invencível{/i}, sem dúvida há muitos seres capazes de nos matar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:45
translate ptBR qst_bloodhound_4_atFort_cc99b660:

    # MC "(Well, there goes my power fantasy I guess.)"
    MC "(Bem, lá se vai minha fantasia de poder, eu acho.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:46
translate ptBR qst_bloodhound_4_atFort_5e79a34e:

    # BLACK "The battle form, like all abilities, must be nurtured to develop."
    BLACK "A forma de batalha, como todas as habilidades, deve ser nutrida para se desenvolver."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:47
translate ptBR qst_bloodhound_4_atFort_c7d003c0:

    # MC "(You mean like, I have to train more?)"
    MC "(Você quer dizer que eu tenho que treinar mais?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:48
translate ptBR qst_bloodhound_4_atFort_e6b63194:

    # BLACK "Yes, your body will adapt and evolve to handle greater threats."
    BLACK "Sim, seu corpo se adaptará e evoluirá para lidar com ameaças maiores."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:49
translate ptBR qst_bloodhound_4_atFort_f7a97492:

    # MC "(Great... That's something at least.)"
    MC "(Ótimo... Isso é alguma coisa pelo menos.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:51
translate ptBR qst_bloodhound_4_atFort_17a87d51:

    # "The thought of facing that {i}thing{/i} again filled me with dread."
    "O pensamento de enfrentar aquela {i}coisa{/i} novamente me encheu de pavor."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:52
translate ptBR qst_bloodhound_4_atFort_339483ae:

    # "As the holly sap took effect, I drifted off to sleep, haunted by the images of it's horrible face charging towards me."
    "Enquanto a seiva sagrada fazia efeito, adormeci, assombrado pelas imagens de seu rosto horrível avançando contra mim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:59
translate ptBR qst_bloodhound_4_atFort_b88fb49b:

    # "Towards {i}us{/i}."
    "Contra {i}nós{/i}."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:64
translate ptBR qst_bloodhound_4_atFort_0cf7c79e:

    # "A few hours later..."
    "Algumas horas depois..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:73
translate ptBR qst_bloodhound_4_atFort_9efa6cee:

    # NYX @ shock "Feeing alright?"
    NYX @ shock "Sentindo-se bem?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:75
translate ptBR qst_bloodhound_4_atFort_b8905269:

    # MC @ talk "Yeah... Never better."
    MC @ talk "Sim... Nunca melhor."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:76
translate ptBR qst_bloodhound_4_atFort_359034a0:

    # NYX @ talk "You look like shit."
    NYX @ talk "Você parece um lixo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:77
translate ptBR qst_bloodhound_4_atFort_dfbe28ad:

    # MC @ talk "Well, I feel like shit so..."
    MC @ talk "Bem, eu me sinto um lixo, então..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:79
translate ptBR qst_bloodhound_4_atFort_b9fc5142:

    # "Captain Nyx forced a faint smile before nodding softly."
    "A Capitã Nyx forçou um sorriso fraco antes de assentir suavemente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:80
translate ptBR qst_bloodhound_4_atFort_b01b2cf5:

    # NYX @ talk "I suppose you've got questions."
    NYX @ talk "Suponho que você tenha perguntas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:81
translate ptBR qst_bloodhound_4_atFort_291c5b81:

    # MC @ talk "Damn right."
    MC @ talk "Com certeza."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:86
translate ptBR qst_bloodhound_4_hospital_nyxChoices_e4ee6136:

    # NYX @ talk "I've had you both followed since your return."
    NYX @ talk "Eu mandei seguir vocês dois desde o seu retorno."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:87
translate ptBR qst_bloodhound_4_hospital_nyxChoices_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "O quê?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:88
translate ptBR qst_bloodhound_4_hospital_nyxChoices_27426e03:

    # NYX @ angry "When you and your friend returned, under the circumstances you did, I didn't buy that you just strolled your way back to Novaras in record time."
    NYX @ angry "Quando você e seu amigo retornaram, nas circunstâncias em que retornaram, eu não engoli que vocês simplesmente caminharam de volta para Novaras em tempo recorde."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:89
translate ptBR qst_bloodhound_4_hospital_nyxChoices_b21889a2:

    # NYX @ angry "At first, I considered you being Demorai spies."
    NYX @ angry "No início, eu considerei que vocês fossem espiões Demorai."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:90
translate ptBR qst_bloodhound_4_hospital_nyxChoices_6004d9d1:

    # NYX @ talk "So, I called in some favors and had you followed."
    NYX @ talk "Então, eu pedi alguns favores e mandei seguir vocês."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:91
translate ptBR qst_bloodhound_4_hospital_nyxChoices_9e1a4c12:

    # MC @ angry "Why not just tell me!"
    MC @ angry "Por que simplesmente não me contou!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:92
translate ptBR qst_bloodhound_4_hospital_nyxChoices_b1ccbf77:

    # NYX @ talk "I needed to test where your loyalties laid."
    NYX @ talk "Eu precisava testar onde suas lealdades estavam."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:93
translate ptBR qst_bloodhound_4_hospital_nyxChoices_c5e54f3e:

    # NYX @ laugh "Oh, and the whole strolling into the desert to change thing? Not very smart."
    NYX @ laugh "Ah, e toda aquela história de passear pelo deserto para mudar as coisas? Não foi muito inteligente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:94
translate ptBR qst_bloodhound_4_hospital_nyxChoices_bae1966c:

    # NYX @ angry "Did you really think heading out there wasn't going to draw some attention?"
    NYX @ angry "Você realmente achou que ir até lá não ia chamar atenção?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:95
translate ptBR qst_bloodhound_4_hospital_nyxChoices_2221d04f:

    # NYX @ talk "You're going to need to learn to be smarter than that."
    NYX @ talk "Você vai precisar aprender a ser mais esperto que isso."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:96
translate ptBR qst_bloodhound_4_hospital_nyxChoices_98840fbf:

    # MC @ angry "You used me."
    MC @ angry "Você me usou."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:97
translate ptBR qst_bloodhound_4_hospital_nyxChoices_c9fb01dc:

    # NYX @ angry "This is war, you'll get used to being used."
    NYX @ angry "Isso é guerra, você vai se acostumar a ser usado."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:101
translate ptBR qst_bloodhound_4_hospital_nyxChoices_9310a365:

    # NYX @ talk "I have no idea."
    NYX @ talk "Não faço ideia."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:102
translate ptBR qst_bloodhound_4_hospital_nyxChoices_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "O quê?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:103
translate ptBR qst_bloodhound_4_hospital_nyxChoices_1b3b6fcb:

    # NYX @ shock "I knew Azul was onto something big but... I didn't anticipate that."
    NYX @ shock "Eu sabia que Azul estava atrás de algo grande, mas... não antecipei isso."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:104
translate ptBR qst_bloodhound_4_hospital_nyxChoices_d155dda6:

    # NYX @ angry "All of Azul's private documents and scrolls have been taken, no doubt destroyed."
    NYX @ angry "Todos os documentos pessoais e pergaminhos de Azul foram levados, sem dúvida destruídos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:108
translate ptBR qst_bloodhound_4_hospital_nyxChoices_564cd451:

    # NYX @ shock "...I'm sorry, I predicted there might be a trap waiting for whoever I sent."
    NYX @ shock "...Sinto muito, eu previ que poderia haver uma armadilha esperando por quem eu enviasse."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:109
translate ptBR qst_bloodhound_4_hospital_nyxChoices_1a9930c7:

    # NYX @ talk "I knew that, with your abilities, you had a better chance handling whatever was thrown at you."
    NYX @ talk "Eu sabia que, com suas habilidades, você teria uma chance melhor de lidar com o que quer que jogassem em você."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:110
translate ptBR qst_bloodhound_4_hospital_nyxChoices_c34a59ad:

    # NYX @ talk "But I still made sure to tail you, I couldn't be sure for whatever was waiting and expected the worst."
    NYX @ talk "Mas ainda me certifiquei de te seguir, não podia ter certeza do que estava à espera e esperava o pior."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:111
translate ptBR qst_bloodhound_4_hospital_nyxChoices_1efaa6b8:

    # MC @ talk "Could have done better with you about five minutes earlier into the fight."
    MC @ talk "Poderia ter sido melhor se você estivesse na luta uns cinco minutos antes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:112
translate ptBR qst_bloodhound_4_hospital_nyxChoices_6442fbae:

    # NYX @ angry "We moved as quickly as we could without drawing attention."
    NYX @ angry "Nós nos movemos o mais rápido que podíamos sem chamar atenção."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:116
translate ptBR qst_bloodhound_4_hospital_nyxChoices_230bd269:

    # NYX @ talk "No."
    NYX @ talk "Não."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:117
translate ptBR qst_bloodhound_4_hospital_nyxChoices_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:118
translate ptBR qst_bloodhound_4_hospital_nyxChoices_69710195:

    # NYX @ talk "You're a valuable asset, and I'm fairly confident now whose side you're on."
    NYX @ talk "Você é um recurso valioso, e já estou bem confiante de que lado você está."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:119
translate ptBR qst_bloodhound_4_hospital_nyxChoices_e9e95609:

    # NYX @ angry "That said, others may not feel the same."
    NYX @ angry "Dito isso, outros podem não pensar o mesmo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:120
translate ptBR qst_bloodhound_4_hospital_nyxChoices_bb396a64:

    # MC @ talk "So... No one else knows?"
    MC @ talk "Então... Ninguém mais sabe?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:121
translate ptBR qst_bloodhound_4_hospital_nyxChoices_8e345629:

    # NYX @ talk "Your secret is still safe."
    NYX @ talk "Seu segredo ainda está seguro."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:122
translate ptBR qst_bloodhound_4_hospital_nyxChoices_27b1a111:

    # MC @ talk "But, the inquisitors-"
    MC @ talk "Mas, os inquisidores-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:123
translate ptBR qst_bloodhound_4_hospital_nyxChoices_543f491c:

    # NYX @ angry "Fuck the inquisitors."
    NYX @ angry "Que se fodam os inquisidores."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:124
translate ptBR qst_bloodhound_4_hospital_nyxChoices_078ca3b0:

    # NYX @ angry "And fuck Lukkan and the others."
    NYX @ angry "E que se fodam Lukkan e os outros."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:125
translate ptBR qst_bloodhound_4_hospital_nyxChoices_e295341a:

    # NYX @ angry "The city Watch needs all the help it can get, and none of those fuckers are willing to lift a damn finger to help if it involves pulling from their precious sectors."
    NYX @ angry "A Guarda da cidade precisa de toda ajuda que puder conseguir, e nenhum desses desgraçados está disposto a levantar um dedo sequer se isso envolver mexer com seus preciosos setores."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:126
translate ptBR qst_bloodhound_4_hospital_nyxChoices_3ff61c69:

    # NYX @ talk "I may call upon you again, for help."
    NYX @ talk "Posso recorrer a você novamente, por ajuda."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:127
translate ptBR qst_bloodhound_4_hospital_nyxChoices_0466bb7a:

    # NYX @ angry "You may be one of the only few in this wretched city I actually know I can trust."
    NYX @ angry "Você talvez seja um dos poucos nesta cidade miserável em quem eu realmente sei que posso confiar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:130
translate ptBR qst_bloodhound_4_hospital_nyxChoices_0f796eb3:

    # MC @ talk "I'm done with questions..."
    MC @ talk "Chega de perguntas..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:131
translate ptBR qst_bloodhound_4_hospital_nyxChoices_310c3340:

    # MC @ talk "What now?"
    MC @ talk "E agora?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:132
translate ptBR qst_bloodhound_4_hospital_nyxChoices_c93cf8f4:

    # NYX @ talk "Not much, you go back to doing whatever it is you were doing before."
    NYX @ talk "Nada de mais, você volta a fazer o que estava fazendo antes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:133
translate ptBR qst_bloodhound_4_hospital_nyxChoices_8d9965eb:

    # MC @ talk "But... The investigation?"
    MC @ talk "Mas... A investigação?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:134
translate ptBR qst_bloodhound_4_hospital_nyxChoices_d08d005d:

    # NYX @ talk "Not your responsibility anymore."
    NYX @ talk "Não é mais responsabilidade sua."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:135
translate ptBR qst_bloodhound_4_hospital_nyxChoices_e5b291a8:

    # NYX @ talk "At least, until I can do some more digging into what Azul found."
    NYX @ talk "Pelo menos, até eu poder investigar mais a fundo o que Azul encontrou."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:137
translate ptBR qst_bloodhound_4_hospital_nyxChoices_83b8fbc8:

    # MC @ talk "...That {i}thing.{/i}"
    MC @ talk "...Aquela {i}coisa.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:138
translate ptBR qst_bloodhound_4_hospital_nyxChoices_df7f4b5b:

    # NYX @ talk "Returned to its master, no doubt."
    NYX @ talk "Retornou ao seu mestre, sem dúvida."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:139
translate ptBR qst_bloodhound_4_hospital_nyxChoices_4bcd9b36:

    # MC @ talk "{i}Master?{/i} You mean-"
    MC @ talk "{i}Mestre?{/i} Você quer dizer-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:140
translate ptBR qst_bloodhound_4_hospital_nyxChoices_c9c2e169:

    # NYX @ angry "Yes, that thing serves to cover the tracks of it's master."
    NYX @ angry "Sim, aquela coisa serve para cobrir os rastros do seu mestre."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:141
translate ptBR qst_bloodhound_4_hospital_nyxChoices_2207c685:

    # MC @ talk "How do you know?"
    MC @ talk "Como você sabe?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:142
translate ptBR qst_bloodhound_4_hospital_nyxChoices_c5aabc37:

    # NYX @ talk "Whatever Azul uncovered brought him into the sights of some {i}powerful{/i} people."
    NYX @ talk "O que quer que Azul tenha descoberto o colocou na mira de algumas pessoas {i}poderosas{/i}."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:143
translate ptBR qst_bloodhound_4_hospital_nyxChoices_a0d4bfdb:

    # NYX @ talk "That thing didn't just kill him, it destroyed all of the sensitive information Azul had been gathering."
    NYX @ talk "Aquela coisa não apenas o matou, destruiu todas as informações confidenciais que Azul estava reunindo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:144
translate ptBR qst_bloodhound_4_hospital_nyxChoices_c1fe3b09:

    # NYX @ angry "Whatever he found, Azul got too close."
    NYX @ angry "O que quer que ele tenha encontrado, Azul chegou perto demais."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:145
translate ptBR qst_bloodhound_4_hospital_nyxChoices_a70e4233:

    # MC @ talk "...If that {i}thing{/i} had already killed Azul, why leave the body like that?"
    MC @ talk "...Se aquela {i}coisa{/i} já tinha matado Azul, por que deixar o corpo daquele jeito?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:146
translate ptBR qst_bloodhound_4_hospital_nyxChoices_7eb21b6a:

    # MC @ talk "Why was the thing still down there... {i}waiting?{/i}"
    MC @ talk "Por que a coisa ainda estava lá embaixo... {i}esperando?{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:147
translate ptBR qst_bloodhound_4_hospital_nyxChoices_19b37a1a:

    # NYX @ angry "I believe it was waiting {i}for me.{/i}"
    NYX @ angry "Acredito que estava esperando {i}por mim.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:148
translate ptBR qst_bloodhound_4_hospital_nyxChoices_0a6e91e3:

    # NYX @ angry "No doubt whoever is at play here knows of my involvement and would rather have me silenced."
    NYX @ angry "Sem dúvida, quem quer que esteja por trás disso sabe do meu envolvimento e preferiria me silenciar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:149
translate ptBR qst_bloodhound_4_hospital_nyxChoices_a8914fff:

    # NYX @ angry "As for why the body was left there?"
    NYX @ angry "Quanto ao motivo de o corpo ter sido deixado lá?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:150
translate ptBR qst_bloodhound_4_hospital_nyxChoices_4b0c0176:

    # NYX @ angry "Perhaps as a warning... A message, in case that monster failed."
    NYX @ angry "Talvez como um aviso... Uma mensagem, caso aquele monstro falhasse."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:151
translate ptBR qst_bloodhound_4_hospital_nyxChoices_4331e288:

    # "I felt ill with the thought."
    "Me senti enjoado com o pensamento."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:152
translate ptBR qst_bloodhound_4_hospital_nyxChoices_47394e6f:

    # "What kind of a person leaves a warning like {i}that?{/i}"
    "Que tipo de pessoa deixa um aviso como {i}esse?{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:153
translate ptBR qst_bloodhound_4_hospital_nyxChoices_91172795:

    # NYX @ talk "...Oh, that reminds me, here."
    NYX @ talk "...Ah, isso me lembra, aqui."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:154
translate ptBR qst_bloodhound_4_hospital_nyxChoices_c565abe5:

    # NYX @ talk "Your reward."
    NYX @ talk "Sua recompensa."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:157
translate ptBR qst_bloodhound_4_hospital_nyxChoices_718bb0b3:

    # NYX @ talk "Well, I best leave you be for now."
    NYX @ talk "Bem, melhor eu se  deixar em paz por enquanto."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:158
translate ptBR qst_bloodhound_4_hospital_nyxChoices_480d38ed:

    # NYX @ talk "Watch yourself [player_name!t]..."
    NYX @ talk "Cuide-se [player_name!t]..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:159
translate ptBR qst_bloodhound_4_hospital_nyxChoices_dadbefbb:

    # NYX @ angry "{i}You might be in their sights too now.{/i}"
    NYX @ angry "{i}Você também pode estar na mira deles agora.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:161
translate ptBR qst_bloodhound_4_hospital_nyxChoices_9ee63cbf:

    # "As Nyx left, I dropped my head back onto the pillow."
    "Enquanto Nyx saía, deixei minha cabeça cair de volta no travesseiro."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:165
translate ptBR qst_bloodhound_4_hospital_nyxChoices_081ba91b:

    # MC "(...Fucking great.)"
    MC "(...Ótimo pra caralho.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:170
translate ptBR qst_bloodhound_4_hospital_nyxChoices_9650db8e:

    # "A couple hours later, a nun came by and said I could leave now."
    "Algumas horas depois, uma freira veio e disse que eu podia sair agora."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:171
translate ptBR qst_bloodhound_4_hospital_nyxChoices_15ffe5e3:

    # "Leaving the hospital ward, I let out a grim chuckle at myself hoping to not end up here again."
    "Saindo da enfermaria do hospital, soltei uma risada sombria para mim mesmo esperando não acabar aqui novamente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:172
translate ptBR qst_bloodhound_4_hospital_nyxChoices_aca943c2:

    # MC "(Back into the world of the living...)"
    MC "(De volta ao mundo dos vivos...)"

