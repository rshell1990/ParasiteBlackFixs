    # game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:4
    old "Hospital"
    new "Hospital"

    # game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:85
    old "How did you know about me?"
    new "Como você soube de mim?"

    # game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:100
    old "What in all of the gods was that {i}thing{/i} down there?"
    new "O que em nome de todos os deuses era aquela {i}coisa{/i} lá embaixo?"

    # game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:107
    old "...Did you know I was going to be ambushed like that?"
    new "...Você sabia que eu seria emboscado assim?"

    # game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:115
    old "Are you going to tell anyone about me?"
