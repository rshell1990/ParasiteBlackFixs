translate ptBR qst_thecomingstorm_poltrik_family_estate_menu_896249e0:

    # "Flies buzzed in an unholy symphony, circling the monstrous offering."
    "Moscas zumbiam em uma sinfonia profana, circulando a oferenda monstruosa."

