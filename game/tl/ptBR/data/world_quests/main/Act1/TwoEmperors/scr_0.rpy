    LUKKAN @ talk "Certo... Setecentas moedas e nem uma a mais."

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:94
translate ptBR qst_TwoEmperors_0_menu2_eba11e72:

    # LUKKAN @ talk "{i}*Sigh*{/i} Fine, there you go."
    LUKKAN @ talk "{i}*Suspiro*{/i} Tá bom, aí está."

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:97
translate ptBR qst_TwoEmperors_0_menu2_d4ef1be7:

    # LUKKAN @ talk "Now, let's move on..."
    LUKKAN @ talk "Agora, vamos seguir em frente..."

