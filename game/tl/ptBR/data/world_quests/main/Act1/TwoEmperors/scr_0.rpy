    LUKKAN @ talk "Depende."

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:104
translate ptBR qst_TwoEmperors_0_menu2_9c5f1602:

    # MC @ angry "On?"
    MC @ angry "Ligado?"

