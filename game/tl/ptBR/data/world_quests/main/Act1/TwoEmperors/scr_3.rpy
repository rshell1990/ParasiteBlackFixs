translate ptBR qst_TwoEmperors_3_guardDebrief_rootMenu_509e5fae:

    # ALCOTT @ talk "We must focus on military victory only; we cannot afford to be distracted and risk dividing ourselves further."
    ALCOTT @ talk "Devemos nos concentrar apenas na vitória militar; não podemos nos dar ao luxo de nos distrair e arriscar nos dividir ainda mais."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:111
translate ptBR qst_TwoEmperors_3_guardDebrief_rootMenu_136c0ac1:

    # ALCOTT @ joy "Ha!"
    ALCOTT @ joy "Ha!"

