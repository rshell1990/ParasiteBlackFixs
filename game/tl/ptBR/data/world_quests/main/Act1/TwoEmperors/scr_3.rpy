translate ptBR qst_TwoEmperors_3_guardDebrief_rootMenu_b9e9e364:

    # ALCOTT @ talk "We are no more to them than vermin that need to be wiped out."
    ALCOTT @ talk "Para eles, não somos mais do que pragas que precisam ser exterminadas."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:119
