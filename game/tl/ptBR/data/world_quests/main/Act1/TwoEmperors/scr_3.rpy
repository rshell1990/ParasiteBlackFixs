translate ptBR qst_TwoEmperors_3_guardDebrief_rootMenu_832d1377:

    # ALCOTT @ talk "The Demorai have zero interest in any sort of {i}negotiations{/i} while their 'Emperor' rules over them."
    ALCOTT @ talk "Os Demorai não têm nenhum interesse em qualquer tipo de {i}negociações{/i} enquanto seu 'Imperador' governar sobre eles."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:114
translate ptBR qst_TwoEmperors_3_guardDebrief_rootMenu_0a615b3b:

    # MC @ talk "But why? Why are they doing all this?"
    MC @ talk "Mas por quê? Por que estão fazendo tudo isso?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:115
