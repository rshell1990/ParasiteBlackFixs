translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_8de44649:

    # ZANZIBAT @ talk "You would do well to be parted from their 'business' as soon as you can."
    ZANZIBAT @ talk "Faria bem em se afastar dos 'negócios' deles o mais rápido que puder."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1944
translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_3f011ce2:

    # MC "Then what would it take to persuade you?"
    MC "Then what would it take to persuade you?"

