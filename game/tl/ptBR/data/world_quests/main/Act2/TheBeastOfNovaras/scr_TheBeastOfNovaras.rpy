translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_f7524e3f:

    # ZANZIBAT @ smile "In part. But the truth is simpler: Hamun sells its table to *all* sides, and takes none."
    ZANZIBAT @ smile "Em parte. Mas a verdade é mais simples: Hamun vende sua mesa para *todos* os lados, e não toma nenhum."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1919
translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_c0766e48:

