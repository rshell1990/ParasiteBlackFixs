    ZANZIBAT @ smile "Reis, rebeldes, mercadores, sacerdotes, cada um pode negociar aqui."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1920
translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_0ae0fa98:

    # ZANZIBAT @ smile "That is our shield."
    ZANZIBAT @ smile "Esse é o nosso escudo."

