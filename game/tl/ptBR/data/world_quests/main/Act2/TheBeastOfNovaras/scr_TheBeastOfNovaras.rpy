translate ptBR qst_TheBeastOfNovaras_TalkToGarenBar_69989a6a:

    # MC @ think "If you're just giving him everything he wants, doesn't that mean he's already won?"
    MC @ think "Se você está simplesmente dando a ele tudo o que quer, isso não significa que ele já venceu?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1976
translate ptBR qst_TheBeastOfNovaras_TalkToGarenBar_903ddcb0:

    # GAREN @ smile "{i}Only if he can keep to his end of the bargain.{/i}"
    GAREN @ smile "{i}Só se ele puder cumprir sua parte do acordo.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1977
translate ptBR qst_TheBeastOfNovaras_TalkToGarenBar_2192f037:

    # MC @ think "What do you mean by that?"
    MC @ think "O que você quer dizer com isso?"

