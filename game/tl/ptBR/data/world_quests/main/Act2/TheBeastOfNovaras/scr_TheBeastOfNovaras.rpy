translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_3f36b076:

    # MC @ serious "For someone so against them, you seem more than ready to jump into business with them again."
    MC @ serious "Para alguém tão contra eles, você parece mais do que pronto para fazer negócios com eles de novo."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1950
translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_483cf438:

    # ZANZIBAT @ smile "It's as the old proverb says."
    ZANZIBAT @ smile "É como diz o velho provérbio."

