    ZANZIBAT @ talk "{i}Mantenha seus amigos por perto, e seus inimigos ainda mais perto.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1952
translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_a872cabc:

    # ZANZIBAT @ talk "Tell the GTC my answer."
    ZANZIBAT @ talk "Diga à GTC minha resposta."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1954
translate ptBR qst_TheBeastOfNovaras_ZanzibatHouse_zanzitalk_a72b3584:

    # ZANZIBAT @ talk "{i}I will expect the agreement in writing... and on their god.{/i}"
    ZANZIBAT @ talk "{i}Esperarei o acordo por escrito... e pelo seu deus.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1962
translate ptBR qst_TheBeastOfNovaras_TalkToGarenBar_0a1e03ae:

    # GAREN "Can I help you with something?"
    GAREN "Can I help you with something?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1965
translate ptBR qst_TheBeastOfNovaras_TalkToGarenBar_66b0402a:

    # GAREN @ think "Go on?"
    GAREN @ think "Continue?"

