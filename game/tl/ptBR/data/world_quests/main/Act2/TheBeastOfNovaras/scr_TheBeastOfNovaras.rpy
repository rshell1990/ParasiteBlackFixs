translate ptBR qst_TheBeastOfNovaras_TalkToGarenBar_252641ae:

    # GAREN @ talk "{i}We are bound only by the wording of our contract... Nothing more.{/i}"
    GAREN @ talk "{i}Estamos vinculados apenas pelos termos do nosso contrato... Nada mais.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1979
translate ptBR qst_TheBeastOfNovaras_TalkToGarenBar_6a444706:

