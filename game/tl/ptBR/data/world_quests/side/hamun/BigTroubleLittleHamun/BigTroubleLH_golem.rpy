# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:331
translate ptBR qst_BigTroubleLHamun_temple_dials_shrines_3_725b70d5:

    # "{i}Lord Yunitan's wife weeps as she watches her husband march to war against the gods... She knows he has already made a widow of her even while he still breathes. - {b}The name alongside it is etched out.{/b}{/i}"
    "{i}A esposa do Lorde Yunitan chora enquanto observa seu marido marchar para a guerra contra os deuses... Ela sabe que já o tornou viúvo mesmo enquanto ele ainda respira. - {b}O nome ao lado está riscado.{/b}{/i}"

# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:334
translate ptBR qst_BigTroubleLHamun_temple_dials_shrines_4_ffeef6be:

    # "{i}Imatan saw the pain that was to come to the world and could take no more. Now he sleeps and dreams of a better world. - Kaina I{/i}"
