translate ptBR qst_dreamhouse_l2_kitchen_table_d2e54c8d:

    # "{i}He was all mangled and gross, I screamed, but he was gone when mother came...{/i}"
    "{i}Ele estava todo mutilado e nojento, gritei, mas ele se foi quando a mãe veio...{/i}"

