translate ptBR qst_dreamhouse_l2_kitchen_table_d7e1df6c:

    # "{i}I dreamed he was still moving in that box, and he came to see me that night.{/i}"
    "{i}Sonhei que ele ainda estava se movendo naquela caixa, e ele veio me ver naquela noite.{/i}"

