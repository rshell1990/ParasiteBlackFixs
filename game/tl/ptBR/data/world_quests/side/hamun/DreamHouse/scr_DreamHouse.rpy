translate ptBR qst_dreamhouse_l3_granny_bathroom_a6b7cd71:

    # "I hid behind the bath."
    "Me escondi atrás da banheira."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1150
translate ptBR qst_dreamhouse_l3_granny_bathroom_7681aefe:

    # "Crouched beside it, the figure entered the bathroom and peered around, looking for me."
    "Agachado ao lado dela, a figura entrou no banheiro e olhou ao redor, me procurando."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1152
