# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:26
translate ptBR qst_dreamhouse_primer_approach_estate_141568b6:

    # "The guard carefully inspected the document, and then, after looking up towards me, stepped aside."
    "O guarda inspecionou cuidadosamente o documento, e então, após olhar para mim, se afastou."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:28
translate ptBR qst_dreamhouse_primer_approach_estate_61bc238b:

    # GUARD "Be on your best behaviour, or you will be removed by force at Lady Anya and Chanyi's pleasure."
    GUARD "Be on your best behaviour, or you will be removed by force at Lady Anya and Chanyi's pleasure."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:50
translate ptBR qst_dreamhouse_enter_manor_66d36d33:

    # "Entering through the doors, I was greeted by the strangest sight."
    "Entrando pelas portas, fui recebido pela visão mais estranha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:51
translate ptBR qst_dreamhouse_enter_manor_21d8a104:

    # "The great hall seemed split in two halves: one made of black marble and stone, with macabre statues of old gods and skulls, like the home of some terrifying vampire lord."
    "O grande salão parecia dividido em duas metades: uma feita de mármore negro e pedra, com estátuas macabras de deuses antigos e caveiras, como o lar de algum aterrorizante lorde vampiro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:53
translate ptBR qst_dreamhouse_enter_manor_06d4ecae:

    # "The other half was made of white marble and pink stone, complete with statues of majestic horses and beauty."
    "A outra metade era feita de mármore branco e pedra rosa, completa com estátuas de cavalos majestosos e beleza."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:55
translate ptBR qst_dreamhouse_enter_manor_90cd288e:

    # ANYA @ happy "OHHH! You made it!"
    ANYA @ happy "OHHH! Você conseguiu!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:57
translate ptBR qst_dreamhouse_enter_manor_be279b5e:

    # "The excited, cheerful woman rushed over once she saw me."
    "A mulher excitada e alegre correu quando me viu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:58
translate ptBR qst_dreamhouse_enter_manor_57e46665:

    # MC @ think "Umm, you know who I am?"
    MC @ think "Hmm, você sabe quem eu sou?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:59
translate ptBR qst_dreamhouse_enter_manor_e9aa6d62:

    # ANYA @ happy "Of course, everyone's heard about you and what happened in that arena!"
    ANYA @ happy "Claro, todo mundo ouviu falar de você e do que aconteceu naquela arena!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:60
translate ptBR qst_dreamhouse_enter_manor_0e09dc00:

    # "The woman motioned towards herself."
    "A mulher gesticulou para si mesma."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:62
translate ptBR qst_dreamhouse_enter_manor_0a99219c:

    # ANYA @ talk "I am Anya Faymore."
    ANYA @ talk "Eu sou Anya Faymore."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:64
translate ptBR qst_dreamhouse_enter_manor_c21b8a2a:

    # ANYA @ happy "Thank you for accepting our invitation."
    ANYA @ happy "Obrigada por aceitar nosso convite."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:65
translate ptBR qst_dreamhouse_enter_manor_94e5fabf:

    # MC @ think "Right... But..."
    MC @ think "Certo... Mas..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:66
translate ptBR qst_dreamhouse_enter_manor_aca35653:

    # MC @ think "What is this about?"
    MC @ think "Do que se trata isso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:67
translate ptBR qst_dreamhouse_enter_manor_e9248fac:

    # CHANYI "Our daughter, sellsword."
    CHANYI "Our daughter, sellsword."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:69
translate ptBR qst_dreamhouse_enter_manor_53d7755c:

    # "Descending the great stairs, another woman, this one a katai, adorned in a beautiful black dress, made her way over towards us."
    "Descendo as grandes escadas, outra mulher, esta uma katai, adornada em um belo vestido preto, veio em nossa direção."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:70
translate ptBR qst_dreamhouse_enter_manor_544cfb14:

    # ANYA @ happy "This is my beautiful wife, Chanyi!"
    ANYA @ happy "Esta é minha linda esposa, Chanyi!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:71
translate ptBR qst_dreamhouse_enter_manor_48aabfb9:

    # ANYA @ talk "Should I get us some tea or—"
    ANYA @ talk "Devo pegar um chá para nós ou—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:72
translate ptBR qst_dreamhouse_enter_manor_f5ce4cbf:

    # CHANYI @ talk "Our daughter is missing. Given you and your party's set of *skills*, I want you to get her back for us."
    CHANYI @ talk "Nossa filha está desaparecida. Dadas as suas *habilidades* e as do seu grupo, quero que você a traga de volta para nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:73
translate ptBR qst_dreamhouse_enter_manor_0e3bd004:

    # ANYA @ sad "Chanyi, we said we'd take our time explaining things, not just—"
    ANYA @ sad "Chanyi, dissemos que explicaríamos as coisas com calma, não apenas—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:75
translate ptBR qst_dreamhouse_enter_manor_069f8250:

    # CHANYI @ talk "Our daughter is missing."
    CHANYI @ talk "Nossa filha está desaparecida."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:76
translate ptBR qst_dreamhouse_enter_manor_87b30b1f:

    # CHANYI @ talk "We can waste time drinking tea when she's back."
    CHANYI @ talk "Podemos perder tempo bebendo chá quando ela estiver de volta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:78
translate ptBR qst_dreamhouse_enter_manor_b4bfe7e1:

    # ANYA @ sad "Y-Yes... Of course."
    ANYA @ sad "S-Sim... Claro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:83
translate ptBR qst_dreamhouse_enter_manor_menu_1d2326ed:

    # ANYA @ emb "W-Well... You see."
    ANYA @ emb "B-Bem... Veja bem."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:84
translate ptBR qst_dreamhouse_enter_manor_menu_ba70a7ea:

    # ANYA @ talk "I used to be very different."
    ANYA @ talk "Eu costumava ser muito diferente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:85
translate ptBR qst_dreamhouse_enter_manor_menu_9d68f0eb:

    # ANYA @ talk "I was in a difficult place until I met Chanyi here!"
    ANYA @ talk "Eu estava num lugar difícil até conhecer Chanyi aqui!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:86
translate ptBR qst_dreamhouse_enter_manor_menu_9892746a:

    # ANYA @ happy "She just swooped me off my feet when I was at my lowest!"
    ANYA @ happy "Ela simplesmente me tirou do chão quando eu estava no meu pior momento!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:87
translate ptBR qst_dreamhouse_enter_manor_menu_31b1e459:

    # CHANYI @ laugh "You and I have very different recollections of swooping you off your feet."
    CHANYI @ laugh "Você e eu temos lembranças bem diferentes de te tirar do chão."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:88
translate ptBR qst_dreamhouse_enter_manor_menu_e8330fa4:

    # CHANYI @ laugh "I seem to remember it involved a lot more biting and pinning you against walls."
    CHANYI @ laugh "Pelo que me lembro, envolvia muito mais mordidas e te prender contra as paredes."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:89
translate ptBR qst_dreamhouse_enter_manor_menu_90f4456f:

    # ANYA @ shock "CHANYI!"
    ANYA @ shock "CHANYI!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:90
translate ptBR qst_dreamhouse_enter_manor_menu_2b6d89e3:

    # ANYA @ emb "Must you always tell people that?"
    ANYA @ emb "Você sempre precisa contar isso pras pessoas?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:93
translate ptBR qst_dreamhouse_enter_manor_menu_2473bc2e:

    # CHANYI "Anya is her birth mother."
    CHANYI "Anya is her birth mother."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:94
translate ptBR qst_dreamhouse_enter_manor_menu_27b3c41a:

    # CHANYI "But I have raised her since she was three."
    CHANYI "But I have raised her since she was three."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:95
translate ptBR qst_dreamhouse_enter_manor_menu_10c177a9:

    # ANYA @ sad "We're both terribly worried!"
    ANYA @ sad "Nós duas estamos terrivelmente preocupadas!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:96
translate ptBR qst_dreamhouse_enter_manor_menu_25d399ca:

    # MC @ think "And the father is...?"
    MC @ think "E o pai é...?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:97
translate ptBR qst_dreamhouse_enter_manor_menu_015c7327:

    # ANYA @ sad "Umm... We are no longer together."
    ANYA @ sad "Hmm... Não estamos mais juntos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:98
translate ptBR qst_dreamhouse_enter_manor_menu_2ca16687:

    # ANYA @ sad "It's... a long story."
    ANYA @ sad "É... uma longa história."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:99
translate ptBR qst_dreamhouse_enter_manor_menu_6188caea:

    # MC @ talk "I see."
    MC @ talk "Entendo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:102
translate ptBR qst_dreamhouse_enter_manor_menu_a8bdbc3d:

    # CHANYI @ talk "Her name is Serafina. She's eighteen."
    CHANYI @ talk "O nome dela é Serafina. Ela tem dezoito anos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:103
translate ptBR qst_dreamhouse_enter_manor_menu_2d50000a:

    # CHANYI @ talk "She disappeared about a month ago."
    CHANYI @ talk "Ela desapareceu há cerca de um mês."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:104
translate ptBR qst_dreamhouse_enter_manor_menu_08652879:

    # CHANYI @ angry "No doubt taken by that righteous cunt of a father of hers."
    CHANYI @ angry "Sem dúvida levada por aquele desgraçado moralista do pai dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:105
translate ptBR qst_dreamhouse_enter_manor_menu_b521d354:

    # ANYA @ sad "Chanyi, we don't know for sure it was him."
    ANYA @ sad "Chanyi, não sabemos com certeza se foi ele."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:106
translate ptBR qst_dreamhouse_enter_manor_menu_498c730e:

    # CHANYI @ angry "Who else could it be?"
    CHANYI @ angry "Quem mais poderia ser?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:107
translate ptBR qst_dreamhouse_enter_manor_menu_73e06ee7:

    # CHANYI @ angry "That prick has never accepted you leaving him for me!"
    CHANYI @ angry "Aquele idiota nunca aceitou você deixá-lo por mim!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:108
translate ptBR qst_dreamhouse_enter_manor_menu_19f38f0d:

    # MC @ think "Who is the father?"
    MC @ think "Quem é o pai?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:109
translate ptBR qst_dreamhouse_enter_manor_menu_06209599:

    # ANYA @ sad "His name is Davik... He's an inquisitor."
    ANYA @ sad "O nome dele é Davik... Ele é um inquisidor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:113
translate ptBR qst_dreamhouse_enter_manor_menu2_12f42a82:

    # CHANYI @ angry "Six months ago, I found a letter he wrote begging to see her."
    CHANYI @ angry "Seis meses atrás, encontrei uma carta que ele escreveu implorando para vê-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:114
translate ptBR qst_dreamhouse_enter_manor_menu2_33af69a7:

    # CHANYI @ talk "She swore she never wrote him back, but I'm not convinced."
    CHANYI @ talk "Ela jurou que nunca respondeu, mas não estou convencida."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:115
translate ptBR qst_dreamhouse_enter_manor_menu2_2393b2af:

    # CHANYI @ angry "He's just trying to get in her head! He hardly had time for her or Anya when he was too busy running around playing inquisitor."
    CHANYI @ angry "Ele só está tentando entrar na cabeça dela! Ele mal tinha tempo para ela ou para Anya quando estava ocupado demais bancando o inquisidor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:119
translate ptBR qst_dreamhouse_enter_manor_menu2_fbfd608b:

    # "The two women shifted uncomfortably at the question."
    "As duas mulheres se mexeram desconfortavelmente com a pergunta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:120
translate ptBR qst_dreamhouse_enter_manor_menu2_ee8bdeea:

    # MC @ think "What? What's the matter?"
    MC @ think "O quê? Qual é o problema?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:121
translate ptBR qst_dreamhouse_enter_manor_menu2_96c2a3da:

    # ANYA @ sad "Serafina had... a gift."
    ANYA @ sad "Serafina tinha... um dom."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:122
translate ptBR qst_dreamhouse_enter_manor_menu2_990f99c8:

    # MC @ talk "A gift?"
    MC @ talk "Um dom?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:123
translate ptBR qst_dreamhouse_enter_manor_menu2_ed1a1ac6:

    # CHANYI @ talk "Her nightmares would come true."
    CHANYI @ talk "Os pesadelos dela se tornavam realidade."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:124
translate ptBR qst_dreamhouse_enter_manor_menu2_bc5fb14a:

    # MC @ surprised "... What?"
    MC @ surprised "... O quê?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:125
translate ptBR qst_dreamhouse_enter_manor_menu2_cbe3bb55:

    # ANYA @ talk "She was a normal girl until her sixteenth birthday, then..."
    ANYA @ talk "Ela era uma garota normal até seu décimo sexto aniversário, então..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:126
translate ptBR qst_dreamhouse_enter_manor_menu2_df61acad:

    # CHANYI @ talk "Then the nightmares came."
    CHANYI @ talk "Então os pesadelos começaram."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:127
translate ptBR qst_dreamhouse_enter_manor_menu2_7a819cb1:

    # MC @ serious "Slow down, what do you mean her nightmares came true?"
    MC @ serious "Calma, como assim os pesadelos dela se tornavam realidade?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:128
translate ptBR qst_dreamhouse_enter_manor_menu2_5293d8d0:

    # CHANYI @ talk "When she turned sixteen, a group of men tried to kidnap her."
    CHANYI @ talk "Quando ela fez dezesseis, um grupo de homens tentou sequestrá-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:129
translate ptBR qst_dreamhouse_enter_manor_menu2_16316f5b:

    # CHANYI @ talk "No doubt to ransom her off, but our guards managed to get her to safety."
    CHANYI @ talk "Sem dúvida para pedir resgate, mas nossos guardas conseguiram deixá-la em segurança."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:130
translate ptBR qst_dreamhouse_enter_manor_menu2_a270fe11:

    # CHANYI @ talk "She was shaken up though, and that night... she woke up screaming."
    CHANYI @ talk "Ela ficou abalada, e naquela noite... ela acordou gritando."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:131
translate ptBR qst_dreamhouse_enter_manor_menu2_460f4982:

    # CHANYI @ talk "She told us that she dreamed she was a monster chasing down the men who tried to kidnap her."
    CHANYI @ talk "Ela nos contou que sonhou que era um monstro perseguindo os homens que tentaram sequestrá-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:132
translate ptBR qst_dreamhouse_enter_manor_menu2_46c39d9f:

    # CHANYI @ talk "She described it in such vivid detail... I thought it was just an overactive imagination at first."
    CHANYI @ talk "Ela descreveu com tantos detalhes vívidos... No começo achei que fosse só imaginação fértil."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:133
translate ptBR qst_dreamhouse_enter_manor_menu2_520a156e:

    # ANYA @ talk "... Then the bodies were found in the morning."
    ANYA @ talk "... Então os corpos foram encontrados pela manhã."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:134
translate ptBR qst_dreamhouse_enter_manor_menu2_3b6cf756:

    # ANYA @ talk "Each man torn apart in exactly the way she told us her nightmare went."
    ANYA @ talk "Cada homem despedaçado exatamente do jeito que ela contou que o pesadelo aconteceu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:135
translate ptBR qst_dreamhouse_enter_manor_menu2_51647ab0:

    # MC @ think "... And there have been more nightmares since?"
    MC @ think "... E houve mais pesadelos desde então?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:136
translate ptBR qst_dreamhouse_enter_manor_menu2_003d4670:

    # ANYA @ sad "Yes... First it was one of our gardeners."
    ANYA @ sad "Sim... Primeiro foi um dos nossos jardineiros."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:137
translate ptBR qst_dreamhouse_enter_manor_menu2_715fe614:

    # ANYA @ sad "Then others died in her nightmares."
    ANYA @ sad "Depois outros morreram nos pesadelos dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:138
translate ptBR qst_dreamhouse_enter_manor_menu2_f57b8969:

    # ANYA @ sad "It got so bad, we started asking the staff to wear masks so she wouldn't see their faces... in case she dreamed about them."
    ANYA @ sad "Ficou tão grave que começamos a pedir aos funcionários para usar máscaras para que ela não visse seus rostos... caso sonhasse com eles."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:141
translate ptBR qst_dreamhouse_enter_manor_menu3_034157f6:

    # CHANYI @ angry "Absolutely not!"
    CHANYI @ angry "Absolutamente não!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:142
translate ptBR qst_dreamhouse_enter_manor_menu3_c1a4a64d:

    # CHANYI @ angry "In a best-case scenario, they would take her away from us."
    CHANYI @ angry "Na melhor das hipóteses, eles a levariam para longe de nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:143
translate ptBR qst_dreamhouse_enter_manor_menu3_1cfa090e:

    # CHANYI @ angry "In a worst case, those infernal inquisitors might see her as a dark mage."
    CHANYI @ angry "Na pior, aqueles inquisidores infernais poderiam vê-la como uma maga das trevas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:146
translate ptBR qst_dreamhouse_enter_manor_menu3_5eeba76c:

    # ANYA @ sad "Gods, no!"
    ANYA @ sad "Deuses, não!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:147
translate ptBR qst_dreamhouse_enter_manor_menu3_c9dbcbe5:

    # CHANYI @ angry "You can't know that for sure, Anya."
    CHANYI @ angry "Você não pode ter certeza disso, Anya."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:148
translate ptBR qst_dreamhouse_enter_manor_menu3_1d04be5e:

    # ANYA @ talk "He loved her, he wanted to be in her life."
    ANYA @ talk "Ele a amava, ele queria estar na vida dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:149
translate ptBR qst_dreamhouse_enter_manor_menu3_f85862f1:

    # ANYA @ talk "No matter what happens, I know he wouldn't want to hurt her!"
    ANYA @ talk "Não importa o que aconteça, eu sei que ele não iria querer machucá-la!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:150
translate ptBR qst_dreamhouse_enter_manor_menu3_1ec4142f:

    # MC @ talk "Can you tell me more about why you separated from your husband?"
    MC @ talk "Pode me contar mais sobre por que você se separou do seu marido?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:151
translate ptBR qst_dreamhouse_enter_manor_menu3_a75f67f7:

    # ANYA @ sad "To be married to an inquisitor isn't an easy thing."
    ANYA @ sad "Ser casada com um inquisidor não é coisa fácil."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:152
translate ptBR qst_dreamhouse_enter_manor_menu3_35bf1749:

    # ANYA @ sad "At first, they're gone for days, just here and there."
    ANYA @ sad "No começo, eles somem por dias, só de vez em quando."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:153
translate ptBR qst_dreamhouse_enter_manor_menu3_3f497119:

    # ANYA @ sad "Days become weeks."
    ANYA @ sad "Dias viram semanas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:154
translate ptBR qst_dreamhouse_enter_manor_menu3_d513c84a:

    # ANYA @ sad "Weeks become months."
    ANYA @ sad "Semanas viram meses."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:155
translate ptBR qst_dreamhouse_enter_manor_menu3_1120c6e6:

    # ANYA @ sad "The loneliness is crushing, and soon, you're not living with someone you love anymore, but just another stranger in your home."
    ANYA @ sad "A solidão é esmagadora, e logo você não está mais vivendo com alguém que ama, mas apenas mais um estranho na sua casa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:156
translate ptBR qst_dreamhouse_enter_manor_menu3_1299b19f:

    # MC @ talk "You chose to marry an inquisitor. You must have known how absent he would have to be?"
    MC @ talk "Você escolheu se casar com um inquisidor. Devia saber o quanto ele estaria ausente?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:157
translate ptBR qst_dreamhouse_enter_manor_menu3_deb3e3e7:

    # CHANYI @ angry "Easy to say when you're not the one coming home to an empty house every night."
    CHANYI @ angry "Fácil dizer quando não é você que volta para uma casa vazia toda noite."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:158
translate ptBR qst_dreamhouse_enter_manor_menu3_7438cf98:

    # ANYA @ angry "Chanyi!"
    ANYA @ angry "Chanyi!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:159
translate ptBR qst_dreamhouse_enter_manor_menu3_c20b8a8b:

    # ANYA @ sad "... Yes, I knew how demanding the job would be."
    ANYA @ sad "... Sim, eu sabia o quanto o trabalho seria exigente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:160
translate ptBR qst_dreamhouse_enter_manor_menu3_0f293903:

    # ANYA @ sad "And the first time I kissed Chanyi, the guilt nearly killed me..."
    ANYA @ sad "E a primeira vez que beijei Chanyi, a culpa quase me matou..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:161
translate ptBR qst_dreamhouse_enter_manor_menu3_7a8f7bab:

    # ANYA @ talk "Till I saw him with *her.*"
    ANYA @ talk "Até que eu o vi com *ela.*"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:162
translate ptBR qst_dreamhouse_enter_manor_menu3_e621970b:

    # MC @ think "Your husband was having an affair?"
    MC @ think "Seu marido estava tendo um caso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:163
translate ptBR qst_dreamhouse_enter_manor_menu3_7c5fc914:

    # ANYA @ talk "I don't know."
    ANYA @ talk "Eu não sei."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:164
translate ptBR qst_dreamhouse_enter_manor_menu3_8227f847:

    # MC @ think "Then I don't understand..."
    MC @ think "Então eu não entendo..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:165
translate ptBR qst_dreamhouse_enter_manor_menu3_a69bd54e:

    # ANYA @ talk "She was an inquisitor like him. The two of them were smiling and laughing."
    ANYA @ talk "Ela era uma inquisidora como ele. Os dois estavam sorrindo e rindo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:166
translate ptBR qst_dreamhouse_enter_manor_menu3_be299f41:

    # ANYA @ talk "They looked at each other the way we used to look, and I understood. He was lonely too."
    ANYA @ talk "Eles se olhavam do jeito que nós costumávamos nos olhar, e eu entendi. Ele também estava sozinho."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:167
translate ptBR qst_dreamhouse_enter_manor_menu3_6d21daf7:

    # ANYA @ talk "No one was happy, so I decided to do the only thing I could... I left."
    ANYA @ talk "Ninguém estava feliz, então decidi fazer a única coisa que podia... Eu fui embora."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:168
translate ptBR qst_dreamhouse_enter_manor_menu3_d35928b2:

    # MC @ talk "I take it your husband didn't take well to the news."
    MC @ talk "Imagino que seu marido não tenha recebido bem a notícia."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:169
translate ptBR qst_dreamhouse_enter_manor_menu3_82b833a6:

    # CHANYI @ talk "Neither did her cunt of a family."
    CHANYI @ talk "Nem a família desgraçada dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:170
translate ptBR qst_dreamhouse_enter_manor_menu3_92ddb07f:

    # CHANYI @ talk "I told them to fuck off too."
    CHANYI @ talk "Eu mandei eles se foderem também."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:171
translate ptBR qst_dreamhouse_enter_manor_menu3_e6b5c25a:

    # ANYA @ sad "But that's the full story, alright?"
    ANYA @ sad "Mas essa é a história completa, certo?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:176
translate ptBR qst_dreamhouse_enter_manor_menu3_7177258e:

    # CHANYI @ talk "A servant came to bring her breakfast, only to find the bed empty and a window open."
    CHANYI @ talk "Um servo veio trazer o café da manhã dela, só para encontrar a cama vazia e uma janela aberta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:177
translate ptBR qst_dreamhouse_enter_manor_menu3_589adbe4:

    # CHANYI @ talk "A note was left on the bed."
    CHANYI @ talk "Um bilhete foi deixado na cama."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:178
translate ptBR qst_dreamhouse_enter_manor_menu3_966c9990:

    # "Lady Chanyi handed me the letter."
    "Lady Chanyi me entregou a carta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:181
translate ptBR qst_dreamhouse_enter_manor_menu3_698d1a8a:

    # CHANYI @ talk "It's her handwriting."
    CHANYI @ talk "É a letra dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:182
translate ptBR qst_dreamhouse_enter_manor_menu3_d0f3753a:

    # MC @ think "And you're certain the father took her?"
    MC @ think "E você tem certeza que foi o pai que a levou?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:183
translate ptBR qst_dreamhouse_enter_manor_menu3_e4764e4c:

    # CHANYI @ talk "Her father visited Hamun two nights before she was taken. He never came to see us, but it's far too much of a coincidence."
    CHANYI @ talk "O pai dela visitou Hamun duas noites antes dela ser levada. Ele nunca veio nos ver, mas é coincidência demais."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:184
translate ptBR qst_dreamhouse_enter_manor_menu3_08bbda20:

    # CHANYI @ talk "Find her father, and you will find our daughter."
    CHANYI @ talk "Encontre o pai dela, e você encontrará nossa filha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:185
translate ptBR qst_dreamhouse_enter_manor_menu3_24c4a8ef:

    # MC @ talk "... And what's in it for me?"
    MC @ talk "... E o que eu ganho com isso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:186
translate ptBR qst_dreamhouse_enter_manor_menu3_9c59ac09:

    # MC @ talk "I *am* a sellsword after all."
    MC @ talk "Eu *sou* um mercenário, afinal."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:187
translate ptBR qst_dreamhouse_enter_manor_menu3_e14a7728:

    # ANYA @ talk "W-We can pay you a lot of coin, or—"
    ANYA @ talk "A gente pode te pagar muitas moedas, ou—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:188
translate ptBR qst_dreamhouse_enter_manor_menu3_8341995f:

    # CHANYI @ talk "Ass."
    CHANYI @ talk "Bunda."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:190
translate ptBR qst_dreamhouse_enter_manor_menu3_91b77494:

    # ANYA @ emb "C-CHANYI!"
    ANYA @ emb "C-CHANYI!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:191
translate ptBR qst_dreamhouse_enter_manor_menu3_4ec4f932:

    # CHANYI @ talk "What? It would not be the first time we took a man to join us in our bed."
    CHANYI @ talk "O quê? Não seria a primeira vez que levamos um homem para se juntar a nós na cama."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:192
translate ptBR qst_dreamhouse_enter_manor_menu3_5d1495e5:

    # "Chanyi's eyes wandered over me lustfully."
    "Os olhos de Chanyi vagaram sobre mim luxuriosamente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:193
translate ptBR qst_dreamhouse_enter_manor_menu3_6f97690d:

    # CHANYI @ laugh "Given the amount of women swooning over you since your little performance at the arena..."
    CHANYI @ laugh "Dada a quantidade de mulheres suspirando por você desde sua pequena performance na arena..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:194
translate ptBR qst_dreamhouse_enter_manor_menu3_716cdc6c:

    # CHANYI @ laugh "Well, I do like us being the envy of this city..."
    CHANYI @ laugh "Bem, eu gosto de sermos a inveja desta cidade..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:195
translate ptBR qst_dreamhouse_enter_manor_menu3_0ab6e7cc:

    # MC @ think "So, a night with you two or coin?"
    MC @ think "Então, uma noite com vocês duas ou moedas?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:196
translate ptBR qst_dreamhouse_enter_manor_menu3_1bd0b4ad:

    # CHANYI @ laugh "Oh, it's more than just a night we want."
    CHANYI @ laugh "Ah, é mais do que só uma noite que queremos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:197
translate ptBR qst_dreamhouse_enter_manor_menu3_8825479f:

    # CHANYI @ laugh "Myself and Anya discussed bringing in a more 'regular' toy for our amusement."
    CHANYI @ laugh "Eu e Anya discutimos trazer um 'brinquedo' mais regular para nossa diversão."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:198
translate ptBR qst_dreamhouse_enter_manor_menu3_68eb11f2:

    # CHANYI @ talk "So, here's the choice."
    CHANYI @ talk "Então, aqui está a escolha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:199
translate ptBR qst_dreamhouse_enter_manor_menu3_86b1224e:

    # CHANYI @ talk "Either we'll pay you five thousand coins and gift you something extra as a *gift.*"
    CHANYI @ talk "Ou te pagamos cinco mil moedas e te damos algo extra como um *presente.*"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:200
translate ptBR qst_dreamhouse_enter_manor_menu3_bfb259f2:

    # "Chanyi's tail swished from side to side as she smirked."
    "A cauda de Chanyi balançava de um lado para o outro enquanto ela sorria maliciosamente."

