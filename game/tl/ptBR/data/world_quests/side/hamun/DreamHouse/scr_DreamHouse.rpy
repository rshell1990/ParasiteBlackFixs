    "(Provavelmente não é uma boa ideia.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1144
translate ptBR qst_dreamhouse_l3_granny_bathroom_415eeec1:

    # MC "(She's coming!)"
    MC "(She's coming!)"

