    "Puxando minha mão e o que quer que fosse para fora, algo me arranhou!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1101
translate ptBR qst_dreamhouse_l3_mirror_eaf73d4a:

    # MC @ surprised "AHH!"
    MC @ surprised "AHH!"

