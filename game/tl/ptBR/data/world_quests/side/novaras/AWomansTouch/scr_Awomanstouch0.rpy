translate ptBR scr_WomansTouch_primer_fb3cd3ee:

    # ELENA @ lewd "It was exciting... To see a man wanting me that way."
    ELENA @ lewd "Era excitante... Ver um homem me querendo daquele jeito."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:53
translate ptBR scr_WomansTouch_primer_6695437a:

    # ELENA @ lewd "So...{i}I would keep letting him watch.{/i}"
    ELENA @ lewd "Então...{i}Eu continuei deixando ele assistir.{/i}"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:54
translate ptBR scr_WomansTouch_primer_11a5e1e5:

