translate ptBR scr_WomansTouch_primer_f3b60fd0:

    # ELENA @ lewd "No, but one time our eyes met and he realized this whole time I was letting him continue."
    ELENA @ lewd "Não, mas uma vez nossos olhos se encontraram e ele percebeu que esse tempo todo eu estava deixando ele continuar."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:56
translate ptBR scr_WomansTouch_primer_49022e3c:

