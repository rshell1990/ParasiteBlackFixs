    HELENA @ lewd "Então deixe-me torná-lo mais especial."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:139
translate ptBR scr_WomansTouch_2_7e83ecc6:

    # "Helena undid the laces on her dress and let it drop to the floor, revealing the white lingerie she wore beneath."
    "Helena desfez os laços de seu vestido e o deixou cair no chão, revelando a lingerie branca que usava por baixo."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:151
translate ptBR scr_WomansTouch_2_ed1b9384:

    # "Elena's eyes widened as she bit down on her lower lip, cheeks burning red."
    "Os olhos de Elena se arregalaram enquanto mordia o lábio inferior, bochechas queimando de vermelho."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:152
