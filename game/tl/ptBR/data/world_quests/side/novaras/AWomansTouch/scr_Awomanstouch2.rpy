    ELENA @ talk "O que aconteceu com ele?"

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:81
translate ptBR scr_WomansTouch_2_626c0400:

    # HELENA @ sad "Oh, that's a story for another time."
    HELENA @ sad "Ah, isso é uma história para outra hora."

