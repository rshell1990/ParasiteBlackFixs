    HELENA @ lewd2 "Nunca estive com alguém como você, Elena... Gostaria de beijar você, se puder."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch2.rpy:127
translate ptBR scr_WomansTouch_2_f935d267:

    # ELENA @ shock "K-Kiss me?!"
