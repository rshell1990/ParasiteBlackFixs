    "A mulher riu."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:110
translate ptBR qst_beneath_shadows_enter_bordello_meet_carina_menu_49384175:

    # CARINA @ laugh "Oh my...!"
    CARINA @ laugh "Nossa...!"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:111
translate ptBR qst_beneath_shadows_enter_bordello_meet_carina_menu_f43ff085:

    # CARINA @ smile "That's adorable!"
    CARINA @ smile "Isso é adorável!"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:112
