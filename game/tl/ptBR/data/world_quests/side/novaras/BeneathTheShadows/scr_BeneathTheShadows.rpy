    CARINA @ talk "De certo modo... Conheço meu lugar na toca, e fico feliz em continuar {i}mantendo{/i} ele como está."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:98
translate ptBR qst_beneath_shadows_enter_bordello_meet_carina_0873a34f:

    # MC @ serious "I still fail to see what this has to do with me."
    MC @ serious "Ainda não vejo o que isso tem a ver comigo."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:99
translate ptBR qst_beneath_shadows_enter_bordello_meet_carina_3343c5fa:

