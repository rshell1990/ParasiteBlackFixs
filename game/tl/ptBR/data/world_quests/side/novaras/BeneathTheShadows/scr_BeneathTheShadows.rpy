    CARINA @ talk "É quase uma pena... Com um corpo como o dela, ela poderia facilmente ter evitado metade do estresse na vida se escolhesse um caminho diferente!"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:116
translate ptBR qst_beneath_shadows_enter_bordello_meet_carina_menu_2aff2c96:

    # MC @ angry "Is this going somewhere?"
    MC @ angry "Isso vai levar a algum lugar?"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:117
translate ptBR qst_beneath_shadows_enter_bordello_meet_carina_menu_8b2bb420:

    # CARINA @ talk "It's quite simple; the dear captain is usually in an impossible situation."
    CARINA @ talk "É bem simples; a querida capitã geralmente está numa situação impossível."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:118
