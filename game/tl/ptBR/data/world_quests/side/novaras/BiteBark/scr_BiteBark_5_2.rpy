translate ptBR qst_BiteBark_5_FoundWolfAtBaba_61ac3032:

    # "As I entered the soothsayers hut, I found my wolf companion sat patiently in waiting as Babazhul laughed."
    "Quando entrei na cabana da vidente, encontrei minha companheira loba sentada pacientemente esperando enquanto Babazhul ria."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:8
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_84075613:

    # BABAZHUL @ talk "Ha! How charmed your companion is..."
    BABAZHUL @ talk "Ha! Como sua companheira está encantada..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:9
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_370c0582:

    # MC @ talk "There she is! My apologies if my pet has disturbed you."
    MC @ talk "Aí está ela! Minhas desculpas se meu animal de estimação te perturbou."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:10
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_15dd01bf:

    # BABAZHUL @ talk "Not at all! I always appreciate the company of such an interesting lady."
    BABAZHUL @ talk "De forma alguma! Sempre aprecio a companhia de uma dama tão interessante."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:11
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_8701c607:

    # MC @ talk "...{i}Interesting lady?{/i}"
    MC @ talk "...{i}Dama interessante?{/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:12
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_18e19d6e:

    # MC @ talk "I'm afraid you'll find little conversation from this one, she hardly even makes a sound!"
    MC @ talk "Receio que você encontrará pouca conversa com esta aqui, ela mal faz um som!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:13
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_f7498309:

    # BABAZHUL @ talk "Oh, she has said plenty already."
    BABAZHUL @ talk "Ah, ela já disse bastante."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:14
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_4e76def8:

    # ELENA_W "..."
    ELENA_W "..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:15
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_a85c6bf2:

    # "I looked back and forth from Babazhul to the wolf which sat silently, confused as to whether the old crow was simply playing some kind of trick on me."
    "Olhei para lá e para cá de Babazhul para a loba que estava sentada em silêncio, confuso se a velha corvo estava simplesmente pregando algum tipo de peça em mim."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:16
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_1ea7af8b:

    # "Suddenly, the crystal ball between her hands illuminated before she looked not at me, {i}but the wolf.{/i}"
    "De repente, a bola de cristal entre suas mãos se iluminou antes que ela olhasse não para mim, {i}mas para a loba.{/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:17
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_dfd4a47b:

    # BABAZHUL @ talk "Hear my words Elena, what is lost to you shall return."
    BABAZHUL @ talk "Ouça minhas palavras Elena, o que está perdido para você retornará."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:18
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_74fad9b7:

    # BABAZHUL @ talk "With this one here, shall the path become clear..."
    BABAZHUL @ talk "Com esta aqui, o caminho se tornará claro..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:19
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_3936a129:

    # "Babazhul's boney hands pointed towards me, and the wolf looked towards me and then back towards Babazhul, barking frantically."
    "As mãos ossudas de Babazhul apontaram para mim, e a loba olhou para mim e depois de volta para Babazhul, latindo freneticamente."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:20
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_911cd098:

    # MC @ talk "{i}(Elena?){/i}"
    MC @ talk "{i}(Elena?){/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:21
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_48bdadc9:

    # BABAZHUL @ talk "I can say no more girl."
    BABAZHUL @ talk "Não posso dizer mais nada garota."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:22
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_63dc0f66:

    # "The ball dimmed and 'Elena' began to growl."
    "A bola escureceu e 'Elena' começou a rosnar."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:23
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_608a62a5:

    # MC @ angry "That's enough now!"
    MC @ angry "Já chega!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:24
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_eaa08c9a:

    # "Grabbing Elena by the scruff of the neck, I began to pull her away, she struggled at first but eventually relented, allowing me to drag her outside."
    "Agarrando Elena pela nuca, comecei a puxá-la, ela lutou a princípio mas eventualmente cedeu, permitindo-me arrastá-la para fora."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_5_2.rpy:25
translate ptBR qst_BiteBark_5_FoundWolfAtBaba_fcc5874f:

    # MC @ talk "Come on, I'm taking you home."
    MC @ talk "Venha, vou te levar para casa."

