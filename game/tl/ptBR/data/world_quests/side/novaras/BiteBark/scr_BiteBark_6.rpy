    MC @ surprised "Tem certeza de que não deseja ficar? Não há necessidade de partir tão cedo."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:128
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_21ba51a9:

