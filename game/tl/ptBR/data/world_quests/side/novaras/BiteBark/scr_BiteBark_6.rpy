translate ptBR qst_BiteBark_6_McRoomResolution_menu2_fadfc224:

    # MC @ sad "(I feel bad I couldn't help her but... I'd only be taking on more unnecessary risk for myself.)"
    MC @ sad "(Sinto-me mal por não poder ajudá-la, mas... eu só estaria assumindo mais riscos desnecessários para mim.)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:147
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_3aa6a878:

    # MC "(I hope she finds what she is looking for, perhaps one day our paths will cross again?)"
    MC "(Espero que ela encontre o que procura, talvez um dia nossos caminhos se cruzem novamente?)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:156
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_6544531e:

    # ELENA @ grumpy "Oh... One thing... While in this city, I will likely have to remain in my wolf form in a fight."
    ELENA @ grumpy "Ah... Uma coisa... Enquanto estiver nesta cidade, provavelmente terei que permanecer na minha forma de lobo durante uma luta."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:157
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_1b0a7479:

    # ELENA @ grumpy "Too dangerous to show my true form."
    ELENA @ grumpy "Muito perigoso mostrar minha verdadeira forma."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:158
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_e377fd11:

    # MC @ talk "I understand."
    MC @ talk "Eu entendo."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:159
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_4dd203d1:

    # "As my eyes scanned the wolf girl up and down, I felt the tinge of excitement staring at her slender, nude body."
    "Enquanto meus olhos examinavam a garota loba de cima a baixo, senti o lampejo de excitação olhando para seu corpo esguio e nu."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:160
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_fc5d377c:

    # "Noticing this, Elena raised an eyebrow inquiring."
    "Percebendo isso, Elena ergueu uma sobrancelha indagando."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:161
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_e454529d:

    # ELENA @ grumpy "Is something the matter?"
    ELENA @ grumpy "Aconteceu algo?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:162
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_2aba70ac:

    # MC @ surprised "I... Well you're..."
    MC @ surprised "Eu... Bem, você é..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:163
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_5b9077b4:

    # ELENA @ grumpy "...My form bothers you?"
    ELENA @ grumpy "...Minha forma te incomoda?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:164
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_7cda0677:

    # MC @ surprised "N-No! You look beautiful!"
    MC @ surprised "N-Não! Você está linda!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:165
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_231e2faf:

    # MC @ talk "But, perhaps some clothes are in order?"
    MC @ talk "Mas, talvez umas roupas sejam necessárias?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:166
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_e413c0fa:

    # ELENA @ grumpy "Urgh, why are you humans so determined to coat yourselves in fabrics and such?"
    ELENA @ grumpy "Urgh, por que vocês humanos são tão determinados a se cobrir com tecidos e tal?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:167
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_d3216100:

    # ELENA @ talk "You all seem so ashamed almost of your natural forms."
    ELENA @ talk "Vocês todos parecem tão envergonhados, quase de suas formas naturais."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:168
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_b304f3d6:

    # MC @ talk "We're not ashamed, just more reserved."
    MC @ talk "Nós não estamos envergonhados, apenas somos mais reservados."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:169
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_1d981bd9:

    # MC @ talk "And there may call for an occasion where clothes {i}are{/i} needed."
    MC @ talk "E pode haver uma ocasião em que roupas {i}são{/i} necessárias."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:170
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_ff974651:

    # ELENA @ talk "Hmph... A valid point I suppose."
    ELENA @ talk "Hmph... Um ponto válido, suponho."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:171
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_6deab029:

    # ELENA @ talk "I have these rags I found scavenging..."
    ELENA @ talk "Tenho estes trapos que encontrei vasculhando..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:172
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_ccbe29ff:

    # "Elena presented to me the loose torn rags which she wrapped around herself."
    "Elena me apresentou os trapos rasgados e soltos que ela enrolava em si mesma."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:173
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_4e6f3ba0:

    # ELENA @ talk "Better?"
    ELENA @ talk "Melhor?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:174
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_c9013ca0:

    # MC @ talk "Well... That's better than nothing."
    MC @ talk "Bem... Isso é melhor que nada."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:175
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_f1b02700:

    # MC @ talk "But I think something a little more pragmatic is in order than just rags."
    MC @ talk "Mas acho que algo um pouco mais pragmático é necessário do que apenas trapos."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:176
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_fb3a6f91:

    # ELENA @ grumpy "But who could we trust to make something for me?"
    ELENA @ grumpy "Mas em quem poderíamos confiar para fazer algo para mim?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:179
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_f259aa9d:

    # MC "(Hmm... Perhaps the elf might be of assistance?)"
    MC "(Hmm... Talvez o elfo possa ser de ajuda?)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:182
translate ptBR qst_BiteBark_6_McRoomResolution_menu2_619ae15f:

    # MC "(I suppose I should look around the city more... There has to be someone who can help.)"
    MC "(Suponho que eu deva olhar mais pela cidade... Deve haver alguém que possa ajudar.)"

