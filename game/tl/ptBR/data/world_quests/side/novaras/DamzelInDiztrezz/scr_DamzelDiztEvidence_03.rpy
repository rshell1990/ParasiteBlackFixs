translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_2a800512:

    # "Knocking on the iron door, a slider opened as two piercing eyes looked the other side."
    "Batendo na porta de ferro, uma portinhola se abriu enquanto dois olhos penetrantes olhavam do outro lado."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:4
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6037568e:

    # THUG @ talk "Password?"
    THUG @ talk "Senha?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:5
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_12b02307:

    # MC @ talk "Silver tits on top of a golden ass."
    MC @ talk "Tetas prateadas em cima de uma bunda dourada."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:6
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3b865931:

    # THUG @ talk "Wha~"
    THUG @ talk "Quê~"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:7
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d6761cbb:

    # MC @ talk "Go tell Tarek we've brought proof!"
    MC @ talk "Vá dizer ao Tarek que trouxemos provas!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:9
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c2d8c402:

    # "After some muffled cursing, I heard the thug on the other side shuffle away."
    "Depois de alguns palavrões abafados, ouvi o capanga do outro lado se afastar arrastando os pés."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:10
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_bd24aa47:

    # "In a moment, a door opened and we were let in."
    "Em um momento, uma porta se abriu e fomos deixados entrar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:11
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_45402abc:

    # "Tarek awaited in his office."
    "Tarek aguardava em seu escritório."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:19
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_24c2dbf9:

    # MC @ talk "I have the proof you require Tarek."
    MC @ talk "Tenho a prova que você precisa Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:20
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_9b7fdd62:

    # TAREK @ shock "What?! Show me!"
    TAREK @ shock "O quê?! Me mostre!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:24
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_61e1b66d:

    # "I handed over the bloodied scroll to Tarek."
    "Entreguei o pergaminho ensanguentado a Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:25
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_a8317f86:

    # MC @ talk "The other factions are about to turn on you, the Vulshan and Khazah's know you are trying to weaken them by handing over their territory to the lesser factions."
    MC @ talk "As outras facções estão prestes a se virar contra você, os Vulshan e Khazah sabem que você está tentando enfraquecê-los entregando o território deles para as facções menores."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:26
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_60cee6bc:

    # TAREK "I-"
    TAREK "Eu-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:27
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5380f6ab:

    # "Tarek's face became sullen as the reality dawned on him."
    "O rosto de Tarek ficou melancólico quando a realidade começou a surgir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:28
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_b804709f:

    # TAREK @ sad "Yes... I can see now, it's all falling apart."
    TAREK @ sad "Sim... Posso ver agora, está tudo desmoronando."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:29
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_579d4c44:

    # MC @ talk "Surely you must have known trying to weaken their factions would result on them to turn on you?"
    MC @ talk "Certamente você devia saber que tentar enfraquecer as facções deles resultaria neles se virarem contra você?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:30
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_1d4e9018:

    # TAREK "The Vulshan and Khazahs have been fighting for decades, I knew both were undermining my authority so what else was I supposed to do?"
    TAREK "Os Vulshan e Khazahs estão lutando há décadas, eu sabia que ambos estavam minando minha autoridade, então o que mais eu deveria fazer?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:31
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6ca2cf51:

    # TAREK @ sad "Not that it matters now... You were right it seems, this was inevitable."
    TAREK @ sad "Não que isso importe agora... Você estava certo, parece que isso era inevitável."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:32
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_74bf3445:

    # MC @ talk "What will you do now?"
    MC @ talk "O que você vai fazer agora?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:33
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3e90c048:

    # TAREK "Worry not, I will keep my word and leave..."
    TAREK "Não se preocupe, vou manter minha palavra e partir..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:34
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_36997e06:

    # TAREK "...But not before I let loose and hand over all the information I have to the inquisitors!"
    TAREK "...Mas não antes de eu me soltar e entregar todas as informações que tenho aos inquisidores!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:35
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4ff0ec6b:

    # MC @ talk "You'll try strike a deal with them?"
    MC @ talk "Vai tentar fazer um acordo com eles?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:36
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e1c147f8:

    # TAREK "Why not? As it stands, I am a dead man... At least if I can offer them something in return, perhaps I may just walk away from all this with something to show still..."
    TAREK "Por que não? Do jeito que as coisas estão, sou um homem morto... Pelo menos se eu puder oferecer algo em troca, talvez eu possa sair disso tudo com algo a mostrar ainda..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:37
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_33c1f58a:

    # MC @ talk "...And Nijah?"
    MC @ talk "...E Nijah?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:38
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d4b7407a:

    # TAREK "Consider her debt settled."
    TAREK "Considere a dívida dela quitada."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:39
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_06188b6a:

    # TAREK "Before I go, you should know in my absence things may become more... {i}violent{/i} for a while."
    TAREK "Antes de eu ir, você deveria saber que na minha ausência as coisas podem ficar mais... {i}violentas{/i} por um tempo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:40
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_257af9a7:

    # TAREK @ angry "The violence I've tried to hold back will spill out in the power struggle to follow."
    TAREK @ angry "A violência que tentei conter vai transbordar na luta pelo poder que virá."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:41
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_64af8631:

    # MC @ talk "Where will you go?"
    MC @ talk "Para onde você vai?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:42
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffa0994f:

    # TAREK "Who knows!"
    TAREK "Quem sabe!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:43
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4bef9a69:

    # TAREK "Perhaps we may even run into each other again..."
    TAREK "Talvez até nos encontremos de novo..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:44
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6074ce3c:

    # TAREK "Don't worry, I won't forget what you did for me here today."
    TAREK "Não se preocupe, não esquecerei o que fez por mim aqui hoje."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:45
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c9b5c36a:

    # TAREK "You could have just tried to kill me."
    TAREK "Você poderia simplesmente ter tentado me matar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:46
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5d2a16c6:

    # MC @ talk "That's not my way."
    MC @ talk "Esse não é meu jeito."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:47
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffbfa8ae:

    # TAREK "Hm... Perhaps there are still honest men in this land then."
    TAREK "Hm... Talvez ainda haja homens honestos nesta terra, então."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:48
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e81bba9c:

    # TAREK "Farewell friend, I will be gone by nightfall."
    TAREK "Adeus, amigo, ao cair da noite já terei partido."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:51
translate ptBR scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_52dc527f:

    # MC @ talk "Farewell, Tarek."
    MC @ talk "Adeus, Tarek."

