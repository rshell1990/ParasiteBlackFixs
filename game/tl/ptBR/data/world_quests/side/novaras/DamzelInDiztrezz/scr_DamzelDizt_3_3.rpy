# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:143
translate ptBR qst_DamzelDizzt_3_ruckus_TarekDead_f24beaea:

    # "In the distance, we could hear the shouts of the guards heading our way, and quickly clambered onto the rooftops of buildings where under the veil of darkness we crept out of the Pleasure District."
    "À distância, podíamos ouvir os gritos dos guardas vindo em nossa direção, e rapidamente subimos nos telhados dos prédios onde sob o véu da escuridão nos esgueiramos para fora do Distrito do Prazer."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:144
translate ptBR qst_DamzelDizzt_3_ruckus_TarekDead_8bb9ae24:

    # "Somehow, we had pulled it off, and behind me down below, I could see the guards rushing towards the chaos below."
    "De alguma forma, conseguimos, e atrás de mim lá embaixo, eu podia ver os guardas correndo em direção ao caos abaixo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:145
translate ptBR qst_DamzelDizzt_3_ruckus_TarekDead_031f2483:

    # "But by then, we had long vanished."
    "Mas a essa altura, já tínhamos desaparecido há muito."

translate ptBR strings:

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:4
    old "*Lie* We are working for the Inquisitors; we have been watching you for a while now."
    new "*Mentir* Estamos trabalhando para os Inquisidores; estamos te observando há um tempo."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:11
    old "I want you to leave Novaras."
    new "Quero que você saia de Novaras."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:15
    old "{image=[ICON.HEART_BROKE]} We want gold in exchange for Nijah, we know you want her."
    new "{image=[ICON.HEART_BROKE]} Queremos ouro em troca de Nijah, sabemos que você a quer."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:19
    old "{image=[ICON.SWORDS]} Are you ready for the sweet embrace of death?"
    new "{image=[ICON.SWORDS]} Você está pronto para o doce abraço da morte?"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:26
    old "The uniform tends to draw too attention for more... {i}delicate{/i} matters such as this."
    new "O uniforme tende a chamar muita atenção para assuntos mais... {i}delicados{/i} como este."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:33
    old "Fuck it, all this talking is starting to bore me. I'd much rather just fucking eviscerate you."
    new "Foda-se, toda essa conversa está começando a me entediar. Prefiro muito mais simplesmente te eviscerar, porra."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:37
    old "How about I shove my boot down your throat? If we choose not to wear our uniforms we do so for good reason worm!"
    new "Que tal eu enfiar minha bota na sua garganta? Se escolhemos não usar nossos uniformes, fazemos por boa razão, verme!"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:54
    old "I am telling you the truth!"
    new "Estou te falando a verdade!"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:59
    old "Put your blade away fool, we're your only way out of this mess!"
