    # ARLENA "Urgh..."
    ARLENA "Urgh..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:6
translate ptBR qst_DaughterOfMetal_03_556151b8:

    # MC @ talk "Morning."
    MC @ talk "Não, vim ver como você está."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:7
translate ptBR qst_DaughterOfMetal_03_8fcc028b:

    # ARLENA "Please, not so loud... Did you come here to drop off some materials?"
    ARLENA "Por favor, não tão alto... Você veio aqui para deixar alguns materiais?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:8
translate ptBR qst_DaughterOfMetal_03_6a40696d:

    # MC @ talk "No, I came to check in on you."
    MC @ talk "Tem algo que eu possa fazer para ajudar?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:9
translate ptBR qst_DaughterOfMetal_03_8c79161e:

    # ARLENA "Hm? Oh, uh..."
    ARLENA "Hm? Oh, hm..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:10
translate ptBR qst_DaughterOfMetal_03_05633e19:

    # ARLENA "I’m okay... other than this splitting headache."
    ARLENA "Estou bem... tirando essa dor de cabeça horrível."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:11
translate ptBR qst_DaughterOfMetal_03_99100f07:

    # MC @ talk "Anything I can do to help?"
    MC @ talk "O que é?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:12
translate ptBR qst_DaughterOfMetal_03_e537525c:

    # ARLENA "Urgh... No, but thanks anyway."
    ARLENA "Urgh... Não, mas obrigado mesmo assim."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:13
translate ptBR qst_DaughterOfMetal_03_349f1271:

    # "As I turned to leave, Arlena called me back."
    "Enquanto eu me virava para sair, Arlena me chamou de volta."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:14
translate ptBR qst_DaughterOfMetal_03_5664a04c:

    # ARLENA "Hey..."
    ARLENA "Ei..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:15
translate ptBR qst_DaughterOfMetal_03_efdddc36:

    # ARLENA "Check in a couple days from now... if you want..."
    ARLENA "Dê uma passada aqui em alguns dias... se quiser..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:16
translate ptBR qst_DaughterOfMetal_03_9e7d1e4e:

    # ARLENA "Think I might have a little job for you if you’re interested."
    ARLENA "Acho que posso ter um pequeno trabalho para você, se estiver interessado."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:17
translate ptBR qst_DaughterOfMetal_03_2f447204:

    # MC @ talk "What is it?"
    MC @ talk "[player_name!t]!"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:18
translate ptBR qst_DaughterOfMetal_03_c72dbe14:

    # ARLENA "You'll see."
    ARLENA "Você verá."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:19
translate ptBR qst_DaughterOfMetal_03_5de3e30f:

    # ARLENA "Now if you’ll excuse me, I'd like to go feel sorry for myself some more and lie down in the darkness for a bit..."
    ARLENA "Agora, se me dá licença, gostaria de ir me lamentar mais um pouco e deitar no escuro por um tempo..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:20
translate ptBR qst_DaughterOfMetal_03_a8c8799b:

    # "And with that, still clutching at her head painfully, she limped off to the sanctuary of her bedroom."
    "E com isso, ainda agarrando sua cabeça dolorosamente, ela mancou para o santuário de seu quarto."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:23
translate ptBR qst_DaughterOfMetal_03_79212085:

    # DRAX "Bloody girl needs to stop drinking so much!"
    DRAX "Maldita garota precisa parar de beber tanto!"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:26
translate ptBR qst_DaughterOfMetal_03_5921ea83:

    # "Drax piped in with, shaking his head as he continued to work at one of the anvils."
    "Drax interveio, balançando a cabeça enquanto continuava a trabalhar em uma das bigornas."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_03.rpy:27
translate ptBR qst_DaughterOfMetal_03_490e54a5:

    # MC "{i}I wonder what the job is?{/i}"
    MC "{i}Eu me pergunto qual é o trabalho?{/i}"

