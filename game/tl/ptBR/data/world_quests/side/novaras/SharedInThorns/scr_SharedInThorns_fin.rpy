# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:2
translate ptBR scr_SharedInThorns_fin_de524618:

    # ELENA @ grumpy "...Curses... Dark deals... Strange temples and possible sacrifices."
    ELENA @ grumpy "...Maldições... Acordos sombrios... Templos estranhos e possíveis sacrifícios."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:3
translate ptBR scr_SharedInThorns_fin_c22be519:

    # "Elena became visibly upset."
    "Elena ficou visivelmente chateada."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:4
translate ptBR scr_SharedInThorns_fin_652d7ce6:

    # ELENA @ sad "I could have... never imagined."
    ELENA @ sad "Eu poderia... nunca ter imaginado."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:5
translate ptBR scr_SharedInThorns_fin_bc8800ff:

    # MC @ talk "We don't have all the answers yet Elena, I'm sorry."
    MC @ talk "Ainda não temos todas as respostas Elena, sinto muito."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:6
translate ptBR scr_SharedInThorns_fin_328bbd35:

    # ELENA @ grumpy "Yes... I do not believe I shall have my answers till I head to Ramon."
    ELENA @ grumpy "Sim... Não acredito que terei minhas respostas até eu ir para Ramon."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:7
translate ptBR scr_SharedInThorns_fin_8e4d2d97:

    # ELENA @ talk "Now I know where I must go... She {i}has{/i} to be there."
    ELENA @ talk "Agora eu sei para onde devo ir... Ela {i}tem{/i} que estar lá."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:8
translate ptBR scr_SharedInThorns_fin_536e4919:

    # MC @ talk "Travelling to Ramon is not possible at the moment."
    MC @ talk "Viajar para Ramon não é possível no momento."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:9
translate ptBR scr_SharedInThorns_fin_17e6715a:

    # MC @ talk "The ports for the Free city are closed for now while they try clear the waters of Demorai ships."
    MC @ talk "Os portos da Cidade Livre estão fechados por enquanto enquanto tentam limpar as águas dos navios Demorai."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:10
translate ptBR scr_SharedInThorns_fin_0d264b12:

    # MC @ talk "Only essential cargo ships are permitted through with military escorts."
    MC @ talk "Apenas navios de carga essenciais são permitidos com escoltas militares."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:11
translate ptBR scr_SharedInThorns_fin_e1d512f4:

    # ELENA @ angry "Then I will sneak on in my other form!"
    ELENA @ angry "Então vou me infiltrar na minha outra forma!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:12
translate ptBR scr_SharedInThorns_fin_8fa3fe6d:

    # MC @ talk "Elena, they won't just let a wolf onto the Cargo ships."
    MC @ talk "Elena, eles não vão simplesmente deixar um lobo entrar nos navios de carga."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:13
translate ptBR scr_SharedInThorns_fin_2d94d6d4:

    # MC @ talk "If they catch you they'd probably just kill you."
    MC @ talk "Se te pegarem provavelmente vão simplesmente te matar."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:14
translate ptBR scr_SharedInThorns_fin_76d1eb7d:

    # ELENA @ grumpy "No matter, I can hide well."
    ELENA @ grumpy "Não importa, posso me esconder bem."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:15
translate ptBR scr_SharedInThorns_fin_24fb2e57:

    # MC @ talk "And what when you arrive in Ramon even if you survive the journey? Alone and with no support or friends?"
    MC @ talk "E quando você chegar em Ramon mesmo se sobreviver à viagem? Sozinha e sem apoio ou amigos?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:16
translate ptBR scr_SharedInThorns_fin_ffa31cb7:

    # "Elena quickly grew frustrated, stomping around my room as she grinded her teeth."
    "Elena rapidamente ficou frustrada, batendo os pés pelo meu quarto enquanto rangia os dentes."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:17
translate ptBR scr_SharedInThorns_fin_01928b64:

    # ELENA @ angry "I made a vow to protect her!"
    ELENA @ angry "Fiz um voto de protegê-la!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:18
translate ptBR scr_SharedInThorns_fin_33e152f2:

    # ELENA @ angry "I will find a way!"
    ELENA @ angry "Vou encontrar um jeito!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:19
translate ptBR scr_SharedInThorns_fin_2b5b86ac:

    # MC @ angry "You are no good to the Lady Thornfall dead!"
    MC @ angry "Você não serve de nada para a Lady Thornfall morta!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:20
translate ptBR scr_SharedInThorns_fin_7842193d:

    # "Elena paused for a moment, taken aback as her rage gave way to fear."
    "Elena fez uma pausa por um momento, surpresa quando sua raiva deu lugar ao medo."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:21
translate ptBR scr_SharedInThorns_fin_fd69af21:

    # ELENA @ sad "Then... what am I to do?"
    ELENA @ sad "Então... o que devo fazer?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:22
translate ptBR scr_SharedInThorns_fin_321fe8a1:

    # ELENA @ sad "The lady... She could be in danger as we speak."
    ELENA @ sad "A lady... Ela pode estar em perigo enquanto falamos."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:23
translate ptBR scr_SharedInThorns_fin_56e6682f:

    # MC @ talk "Stay with me for now, travel as my companion."
    MC @ talk "Fique comigo por agora, viaje como minha companheira."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:24
translate ptBR scr_SharedInThorns_fin_7e1ff64d:

    # MC @ talk "When the time comes, I will help you find the lady in Ramon."
    MC @ talk "Quando chegar a hora, vou te ajudar a encontrar a lady em Ramon."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:25
translate ptBR scr_SharedInThorns_fin_e2e571bb:

    # ELENA @ shock "You would travel with me?"
    ELENA @ shock "Você viajaria comigo?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:26
translate ptBR scr_SharedInThorns_fin_0966d27e:

    # MC @ talk "I will do what I can to help, I can promise no more than that."
    MC @ talk "Farei o que puder para ajudar, não posso prometer mais que isso."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:27
translate ptBR scr_SharedInThorns_fin_001f524a:

    # ELENA @ lewd "...Thank you."
    ELENA @ lewd "...Obrigada."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:28
translate ptBR scr_SharedInThorns_fin_32893012:

    # ELENA @ grumpy "But why are you determined to help one such as I?"
    ELENA @ grumpy "Mas por que você está determinado a ajudar alguém como eu?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:31
translate ptBR scr_SharedInThorns_fin_b7653607:

    # ELENA @ talk "Hm, yes, that does make sense."
    ELENA @ talk "Hm, sim, isso faz sentido."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:33
translate ptBR scr_SharedInThorns_fin_6d01d980:

    # "Elena blushed at the remark."
    "Elena corou com o comentário."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:34
translate ptBR scr_SharedInThorns_fin_6b6a5e8d:

    # ELENA @ lewd "O-Oh... Right."
    ELENA @ lewd "A-Ah... Certo."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:36
translate ptBR scr_SharedInThorns_fin_e8c32701:

    # ELENA @ grumpy "Hmph... Fine."
    ELENA @ grumpy "Hmph... Tá bom."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:37
translate ptBR scr_SharedInThorns_fin_3cef2b02:

    # ELENA @ grumpy "But I'm not your assassin, remember that."
    ELENA @ grumpy "Mas não sou sua assassina, lembre-se disso."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:38
translate ptBR scr_SharedInThorns_fin_45c56903:

    # ELENA @ talk "Very well [player_name!t], I agree to travel with you."
    ELENA @ talk "Muito bem [player_name!t], concordo em viajar com você."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:39
translate ptBR scr_SharedInThorns_fin_e18af332:

    # ELENA @ talk "For now at least... Till I have a chance to head to Ramon."
    ELENA @ talk "Por enquanto pelo menos... Até eu ter uma chance de ir para Ramon."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:40
translate ptBR scr_SharedInThorns_fin_28750ac7:

    # ELENA @ talk "I suppose I better get settled here then."
    ELENA @ talk "Imagino que é melhor eu me instalar aqui então."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_fin.rpy:41
translate ptBR scr_SharedInThorns_fin_34705eb1:

    # ELENA @ talk "Looks like I might be here for a while..."
    ELENA @ talk "Parece que posso ficar aqui por um tempo..."

translate ptBR strings:

