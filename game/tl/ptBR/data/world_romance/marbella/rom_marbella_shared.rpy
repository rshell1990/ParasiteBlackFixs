translate ptBR rom_marbella_shared_the_face_menu_2643f325:

    # MC "(Will a piece of it be enough?)"
    MC "(Será que um pedaço dela será suficiente?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:81
translate ptBR rom_marbella_shared_the_face_menu_ead25a14:

    # SHYAHTAN "(Yes.)"
    SHYAHTAN "(Sim.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:82
translate ptBR rom_marbella_shared_the_face_menu_7bd068a0:

    # "My eyes drifted toward the poor bastard the creature was devouring."
    "Meus olhos se desviaram para o pobre coitado que a criatura estava devorando."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:83
translate ptBR rom_marbella_shared_the_face_menu_6db09147:

    # SHYAHTAN "(That is, if you are fine with letting this creature continue what it's doing...)"
    SHYAHTAN "(Isto é, se não te importares de deixar esta criatura continuar o que está fazendo...)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:86
translate ptBR rom_marbella_shared_the_face_menu_b2b6d0b3:

    # MC @ talk "You to leave this city."
    MC @ talk "Que saias desta cidade."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:87
translate ptBR rom_marbella_shared_the_face_menu_cb4efca3:

    # THE_FACE "And why would I do that?"
    THE_FACE "E por que eu faria isso?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:88
translate ptBR rom_marbella_shared_the_face_menu_3c3b1657:

    # MC @ talk "You've preyed on the wrong people. They sent me to deal with you, one way or another."
    MC @ talk "Atacaste as pessoas erradas. Enviaram-me para lidar com você, de uma forma ou de outra."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:89
translate ptBR rom_marbella_shared_the_face_menu_2e8c2376:

    # THE_FACE "And why should I not just kill you... and then kill them?"
    THE_FACE "E porque não haveria de simplesmente matar-te... e depois matá-los?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:90
translate ptBR rom_marbella_shared_the_face_menu_1bf20a23:

    # THE_FACE "I rather like this hunting ground."
    THE_FACE "Gosto bastante deste campo de caça."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:96
translate ptBR rom_marbella_shared_the_face_menu_ddd9a544:

    # THE_FACE "I can always find a new face to wear."
    THE_FACE "Posso sempre arranjar uma cara nova para vestir."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:97
translate ptBR rom_marbella_shared_the_face_menu_bc03026e:

    # MC @ serious "But whatever the hells you are, you need to feed."
    MC @ serious "Mas seja o que for que você é, precisa de te alimentar."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:98
translate ptBR rom_marbella_shared_the_face_menu_ed137a9a:

    # MC @ think "The bodies are stacking up. It won't be long before the merchant lords hire inquisitors or someone worse."
    MC @ think "Os corpos estão a acumular-se. Não vai demorar muito até os lordes mercadores contratarem inquisidores ou alguém pior."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:99
translate ptBR rom_marbella_shared_the_face_menu_6755aa3d:

    # MC @ talk "Then it's only a matter of time."
    MC @ talk "Então é só uma questão de tempo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:100
translate ptBR rom_marbella_shared_the_face_menu_4867ba98:

    # "The creature seemed to contemplate my words."
    "A criatura pareceu contemplar minhas palavras."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:101
translate ptBR rom_marbella_shared_the_face_menu_b2c0a385:

    # THE_FACE "... Hm."
    THE_FACE "...Hm."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:102
translate ptBR rom_marbella_shared_the_face_menu_63f5e52d:

    # THE_FACE "Perhaps it is time I found a new hunting ground."
    THE_FACE "Talvez seja hora de encontrar um novo terreno de caça."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:108
translate ptBR rom_marbella_shared_the_face_menu_03235ba9:

    # "The creature grinned as it ripped off its arm and threw it toward me."
    "A criatura sorriu enquanto arrancava seu braço e o jogava em minha direção."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:109
translate ptBR rom_marbella_shared_the_face_menu_5c574a52:

    # "Strange tendrils still writhed from the open flesh wound."
    "Tentáculos estranhos ainda se contorciam da ferida aberta na carne."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:110
translate ptBR rom_marbella_shared_the_face_menu_4e2c4d3e:

    # MC @ scared "... What. The. Fuck."
    MC @ scared "...Mas. Que. Merda."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:111
translate ptBR rom_marbella_shared_the_face_menu_42ddfa67:

    # THE_FACE "A wise choice."
    THE_FACE "Uma escolha sábia."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:116
translate ptBR rom_marbella_shared_the_face_menu_8761e6c2:

    # THE_FACE "... Wearing your skin is going to be fun."
    THE_FACE "...Usar a sua pele vai ser divertido."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:120
translate ptBR rom_marbella_shared_the_face_menu_7e6a4ecc:

    # "With a death rattle, the creature writhed on the ground in agony."
    "Com um estertor de morte, a criatura se contorceu no chão em agonia."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:121
translate ptBR rom_marbella_shared_the_face_menu_cf5660e2:

    # "A pool of blood spread from its wounds until at last it lay still."
    "Uma poça de sangue se espalhou de seus ferimentos até que finalmente ficou imóvel."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:125
translate ptBR rom_marbella_shared_the_face_menu_465c70d7:

    # MC @ scared "(... What in the hells was that?)"
    MC @ scared "(...Que raio foi aquilo?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:128
translate ptBR rom_marbella_shared_the_face_menu_7c9c4372:

    # SHYAHTAN "(Just another predator trying to survive.)"
    SHYAHTAN "(Apenas mais um predador a tentar sobreviver.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:129
translate ptBR rom_marbella_shared_the_face_menu_1ba06388:

    # MC @ think "(Well... I should head back to the Khazah at least.)"
    MC @ think "(Bem... Pelo menos devo voltar para os Khazah.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:131
translate ptBR rom_marbella_shared_the_face_menu_aeebd902:

    # SHYAHTAN "(Food.)"
    SHYAHTAN "(Comida.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:132
translate ptBR rom_marbella_shared_the_face_menu_79ad5e9a:

    # MC @ angry "(Is that really all you can think about?!)"
    MC @ angry "(É só nisso que consegue pensar?!)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:133
translate ptBR rom_marbella_shared_the_face_menu_261fccd8:

    # "I felt my own hand fight against me, rising toward the creature's body."
    "Senti minha própria mão lutar contra mim, erguendo-se em direção ao corpo da criatura."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:134
translate ptBR rom_marbella_shared_the_face_menu_647fb08d:

    # "Black tendrils pushed out, wrapping around and inspecting the corpse."
    "Tentáculos negros empurraram para fora, envolvendo e inspecionando o cadáver."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:135
translate ptBR rom_marbella_shared_the_face_menu_b4187bec:

    # "Suddenly, one of the tendrils pierced the flesh, draining it until, within moments, it became a withered husk."
    "De repente, um dos tentáculos perfurou a carne, drenando-a até que, em momentos, tornou-se uma casca murcha."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:136
translate ptBR rom_marbella_shared_the_face_menu_4aea6492:

    # MC @ talk "Uhh, you got what you needed?"
    MC @ talk "Hã, conseguiste o que precisavas?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:137
translate ptBR rom_marbella_shared_the_face_menu_a240a5ea:

    # SHYAHTAN "Yes."
    SHYAHTAN "Sim."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:138
translate ptBR rom_marbella_shared_the_face_menu_9f7a6c71:

    # SHYAHTAN "Now we can return to our mate tomorrow."
    SHYAHTAN "Agora podemos voltar para a nossa companheira amanhã."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:139
translate ptBR rom_marbella_shared_the_face_menu_56c9cbc1:

    # MC "Right..."
    MC "Certo..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:144
translate ptBR rom_marbella_shared_the_face_negotiate_0909f5b7:

    # "To my horror, I watched as the creature made short work of the man, stuffing it's face with his inards before turning it's gaze back towards the lifeless body of the woman."
    "Para meu horror, observei enquanto a criatura dava cabo do homem rapidamente, enchendo a cara com suas entranhas antes de voltar seu olhar para o corpo sem vida da mulher."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:145
translate ptBR rom_marbella_shared_the_face_negotiate_03091605:

    # "Clambering back inside of her, the skin stretching over the flesh unnaturally, and then, it began to settle over the the strange creature's body as it contorted itself into shape."
    "Subindo de volta para dentro dela, a pele se esticando sobre a carne de forma não natural, e então, começou a se assentar sobre o corpo da estranha criatura enquanto ela se contorcia para tomar forma."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:146
translate ptBR rom_marbella_shared_the_face_negotiate_c2f1fa26:

    # "Bones breaking and snapping into place as the creature shrink, fitting itself inside of her."
    "Ossos quebrando e se encaixando enquanto a criatura encolhia, encaixando-se dentro dela."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:147
translate ptBR rom_marbella_shared_the_face_negotiate_98122aeb:

    # "It grabbed the severed head, with tendrils protruding from the open wound of the neck and connected the head there, almost as if it was screwing the head back on."
    "Ele agarrou a cabeça decepada, com tentáculos saindo da ferida aberta do pescoço e conectou a cabeça ali, quase como se estivesse parafusando a cabeça de volta."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:148
translate ptBR rom_marbella_shared_the_face_negotiate_76fbf04d:

    # "From the open wound where his head had been, the lifeless face moved once more."
    "Da ferida aberta onde sua cabeça estivera, o rosto sem vida se moveu mais uma vez."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:149
translate ptBR rom_marbella_shared_the_face_negotiate_1eda4053:

    # "In a few gory moments, sinew, flesh, and skin covered all wounds."
    "Em alguns momentos sangrentos, tendões, carne e pele cobriram todas as feridas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:150
translate ptBR rom_marbella_shared_the_face_negotiate_80623e6a:

    # "The eyes opened."
    "Os olhos se abriram."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:151
translate ptBR rom_marbella_shared_the_face_negotiate_e7dbd68e:

    # "{i}It looked like a normal woman.{/i}"
    "{i}Parecia uma mulher normal.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:156
translate ptBR rom_marbella_shared_the_face_negotiate_da31ff86:

    # "It smiled at me."
    "Sorriu-me."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:157
translate ptBR rom_marbella_shared_the_face_negotiate_ce2bbed9:

    # THE_FACE @ smile "Now I take my leave."
    THE_FACE @ smile "Agora retiro-me."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:158
translate ptBR rom_marbella_shared_the_face_negotiate_de8d54d9:

    # THE_FACE @ smile "Perhaps we will meet again one day?"
    THE_FACE @ smile "Talvez nos voltemos a encontrar um dia?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:159
translate ptBR rom_marbella_shared_the_face_negotiate_8129db98:

    # THE_FACE "You are..."
    THE_FACE "Você é..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:160
translate ptBR rom_marbella_shared_the_face_negotiate_9aa8c348:

    # THE_FACE @ smile "{i}Interesting.{/i}"
    THE_FACE @ smile "{i}Interessante.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:161
translate ptBR rom_marbella_shared_the_face_negotiate_6cc75be9:

    # MC @ talk "You never told me your name."
    MC @ talk "Nunca me disseste o seu nome."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:162
translate ptBR rom_marbella_shared_the_face_negotiate_259b0362:

    # "The creature grinned again, its eyes black as it bared razor-thin teeth."
    "A criatura sorriu novamente, seus olhos negros enquanto mostrava dentes finos como navalhas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:163
translate ptBR rom_marbella_shared_the_face_negotiate_3070413d:

    # THE_FACE @ smile "I don't have a name... I just take them."
    THE_FACE @ smile "Não tenho nome... Apenas os tomo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:164
translate ptBR rom_marbella_shared_the_face_negotiate_9266cbab:

    # THE_FACE "... People like to think when they're alone, they're safe."
    THE_FACE "...As pessoas gostam de pensar que quando estão sozinhas, estão seguras."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:165
translate ptBR rom_marbella_shared_the_face_negotiate_307da707:

    # "It stepped back, disappearing into the darkness."
    "Ele recuou, desaparecendo na escuridão."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:167
translate ptBR rom_marbella_shared_the_face_negotiate_47aac664:

    # "The last thing I saw were its razor teeth and glowing yellow eyes."
    "A última coisa que vi foram seus dentes afiados e olhos amarelos brilhantes."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:168
translate ptBR rom_marbella_shared_the_face_negotiate_ba425c3c:

    # THE_FACE "{i}But we are waiting for them every night.{/i}"
    THE_FACE "{i}Mas nós esperamos por elas todas as noites.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:169
translate ptBR rom_marbella_shared_the_face_negotiate_197a0fbf:

    # "And with that, it was gone."
    "E com isso, ela se foi."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:171
translate ptBR rom_marbella_shared_the_face_negotiate_d9d519af:

    # MC @ scared "That... thing..."
    MC @ scared "Aquela... coisa..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:172
translate ptBR rom_marbella_shared_the_face_negotiate_307cc04c:

    # MC @ scared "How many of those things walk among us?"
    MC @ scared "Quantas dessas coisas andam entre nós?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:173
translate ptBR rom_marbella_shared_the_face_negotiate_8dd99207:

    # SHYAHTAN "(In our travels, I have occasionally sensed their presence.)"
    SHYAHTAN "(Nas nossas viagens, senti ocasionalmente a sua presença.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:174
translate ptBR rom_marbella_shared_the_face_negotiate_e51f39a9:

    # SHYAHTAN "(They are very few in number.)"
    SHYAHTAN "(São muito poucos em número.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:175
translate ptBR rom_marbella_shared_the_face_negotiate_de542541:

    # SHYAHTAN "({i}But they are out there...{/i})"
    SHYAHTAN "({i}Mas eles andam por aí...{/i})"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:176
translate ptBR rom_marbella_shared_the_face_negotiate_e3faf380:

    # "Pushing the thought aside, I looked down at the severed arm and reached to pick it up."
    "Afastando o pensamento, olhei para o braço decepado e me inclinei para pegá-lo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:178
translate ptBR rom_marbella_shared_the_face_negotiate_f7b4d877:

    # MC @ think "(With that sorted, I should head back to the Khazah and let them know this won't be a problem anymore.)"
    MC @ think "(Com isso resolvido, devo voltar aos Khazah e avisá-los de que isto já não será um problema.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:180
translate ptBR rom_marbella_shared_the_face_negotiate_71bd67e9:

    # "From my other hand, Shyahtan's black tendrils pushed out, wrapping around and inspecting the arm."
    "Da minha outra mão, os tentáculos negros de Shyahtan saíram, envolvendo e inspecionando o braço."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:181
translate ptBR rom_marbella_shared_the_face_negotiate_b4187bec:

    # "Suddenly, one of the tendrils pierced the flesh, draining it until, within moments, it became a withered husk."
    "De repente, um dos tentáculos perfurou a carne, drenando-a até que, em momentos, tornou-se uma casca murcha."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:182
translate ptBR rom_marbella_shared_the_face_negotiate_4aea6492:

    # MC @ talk "Uhh, you got what you needed?"
    MC @ talk "Hã, conseguiste o que precisavas?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:183
translate ptBR rom_marbella_shared_the_face_negotiate_a240a5ea:

    # SHYAHTAN "Yes."
    SHYAHTAN "Sim."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:184
translate ptBR rom_marbella_shared_the_face_negotiate_9f7a6c71:

    # SHYAHTAN "Now we can return to our mate tomorrow."
    SHYAHTAN "Agora podemos voltar para a nossa companheira amanhã."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:185
translate ptBR rom_marbella_shared_the_face_negotiate_7a5082fa:

    # MC "If you say so..."
    MC "Se você o diz..."

translate ptBR strings:

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:47
    old "I could ask you the same thing."
    new "Eu poderia te perguntar a mesma coisa."

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:54
    old "You... You remind me of the things I saw in Novaras during the siege."
    new "Você... Você me lembra as coisas que vi em Novaras durante o cerco."

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:67
    old "I am [player_name!t]"
    new "Eu sou [player_name!t]"

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:95
    old "More will come... People are beginning to notice."
    new "Mais virão... As pessoas estão começando a notar."

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:106
    old "Let the creature go."
    new "Deixe a criatura ir."

    # game/data/world_romance/marbella/rom_marbella_shared.rpy:114
    old "Sorry, I can't let you hurt anyone else."
    new "Desculpe, não posso deixar você machucar mais ninguém."

