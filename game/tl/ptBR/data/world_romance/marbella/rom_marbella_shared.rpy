    THE_FACE "{i}Não.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:70
translate ptBR rom_marbella_shared_the_face_menu_87f6b424:

    # THE_FACE "And what do you want... [player_name!t]?"
    THE_FACE "E o que é que quer... [player_name!t]?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:72
translate ptBR rom_marbella_shared_the_face_menu_9c9ec1b9:

    # SHYAHTAN "{i}To eat you.{/i}"
    SHYAHTAN "{i}Para se  comer.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:73
translate ptBR rom_marbella_shared_the_face_menu_aa8b5630:

    # MC "(Gods be damned, man! Why would you blurt that out?!)"
    MC "(Raios te partam, homem! Porque é que foste dizer isso?!)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:74
translate ptBR rom_marbella_shared_the_face_menu_f6e6be2e:

    # THE_FACE "... Interesting."
    THE_FACE "... Interessante."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:75
translate ptBR rom_marbella_shared_the_face_menu_6c6fde8c:

    # THE_FACE "Then let me make you an offer."
    THE_FACE "Então deixa-me fazer-te uma oferta."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:76
translate ptBR rom_marbella_shared_the_face_menu_e3946eb2:

    # THE_FACE "I will give you a piece to eat if you leave me alone."
    THE_FACE "Dou-te um pedaço para comer se me deixares em paz."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:77
translate ptBR rom_marbella_shared_the_face_menu_1dacda77:

    # MC "... What?"
    MC "... O quê?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:78
translate ptBR rom_marbella_shared_the_face_menu_692a2e7d:

    # MC "(This thing is unnerving as all seven hells.)"
    MC "(Esta coisa é tão inquietante como todos os sete infernos.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:79
translate ptBR rom_marbella_shared_the_face_menu_2c2b6b44:

