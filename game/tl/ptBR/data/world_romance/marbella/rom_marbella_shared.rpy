translate ptBR rom_marbella_shared_the_face_a7e9b266:

    # THE_FACE "{i}... What are you?{/i}"
    THE_FACE "{i}... O que você é?{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:49
translate ptBR rom_marbella_shared_the_face_menu_c6af2dbb:

