# game/data/world_romance/marbella/rom_marbella_shared.rpy:25
translate ptBR rom_marbella_shared_the_face_68b0d87d:

    # "The scent was thick with heavy blood. Had the creature found a victim?"
    "O cheiro era forte com sangue pesado. A criatura teria encontrado uma vítima?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:26
translate ptBR rom_marbella_shared_the_face_adb713b3:

    # "What even was it?"
    "O que diabos era aquilo?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:30
translate ptBR rom_marbella_shared_the_face_e49976b9:

    # "Down the dark alleyways, kicking up cold sand, I turned a corner to see... {i}it.{/i}"
    "Pelos becos escuros, chutando areia fria, virei uma esquina para ver... {i}aquilo.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:31
translate ptBR rom_marbella_shared_the_face_c9566933:

    # "A woman — a prostitute — pressing a man up against a wall."
    "Uma mulher — uma prostituta — a pressionar um homem contra uma parede."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:32
translate ptBR rom_marbella_shared_the_face_2c12ecca:

    # "Her red lips were pressed to his throat, his eyes rolled back, his face deathly white."
    "Seus lábios vermelhos estavam pressionados na garganta dele, seus olhos revirados, seu rosto mortalmente pálido."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:33
translate ptBR rom_marbella_shared_the_face_1bcca6ca:

    # "The creature snapped her neck toward me, revealing the huge, gaping wound in the man's neck and the blood splattered around her mouth."
    "A criatura virou o pescoço em minha direção, revelando a enorme ferida aberta no pescoço do homem e o sangue espalhado ao redor de sua boca."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:34
translate ptBR rom_marbella_shared_the_face_a2c1a49b:

    # "Her eyes glowed yellow as she inched closer, taking in a deep inhale."
    "Seus olhos brilharam amarelos enquanto ela se aproximava, inspirando profundamente."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:35
translate ptBR rom_marbella_shared_the_face_a9c43efc:

    # "Before I knew it, the fleshy skin of the woman dropped to the floor as though it was a suit... her severed head rolling along the floor."
    "Antes que eu percebesse, a pele carnuda da mulher caiu no chão como se fosse um traje... sua cabeça decepada rolando pelo chão."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:36
translate ptBR rom_marbella_shared_the_face_29b36423:

    # "The creature... The real creature, perhaps sensing something was {i}different{/i} about me too,"
    "A criatura... A verdadeira criatura, talvez sentindo que algo era {i}diferente{/i} em mim também,"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:37
translate ptBR rom_marbella_shared_the_face_05e13833:

    # "appeared before me in all it's hideous, terror."
    "apareceu diante de mim em todo o seu horror hediondo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:42
translate ptBR rom_marbella_shared_the_face_a857fd35:

    # THE_FACE "You're not human."
    THE_FACE "Não é humano."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:43
translate ptBR rom_marbella_shared_the_face_1c4ec264:

    # THE_FACE "At least not fully... Who are you?"
    THE_FACE "Pelo menos não totalmente... Quem é você?"

