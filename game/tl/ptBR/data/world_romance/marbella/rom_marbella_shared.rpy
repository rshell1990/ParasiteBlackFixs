translate ptBR rom_marbella_shared_the_face_menu_f9227432:

    # THE_FACE "I'm whatever face I wear."
    THE_FACE "Sou qualquer cara que eu usar."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:56
translate ptBR rom_marbella_shared_the_face_menu_6dc791f0:

    # THE_FACE "Cheap imitations."
    THE_FACE "Imitações baratas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:57
translate ptBR rom_marbella_shared_the_face_menu_1359da5a:

    # THE_FACE "Toys of the one called Zanarak."
    THE_FACE "Brinquedos daquele que se chama Zanarak."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:58
translate ptBR rom_marbella_shared_the_face_menu_8268f71e:

    # "The face grinned."
    "O rosto sorriu."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:59
translate ptBR rom_marbella_shared_the_face_menu_00cbccde:

    # THE_FACE "We are older."
    THE_FACE "Somos mais antigos."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:60
translate ptBR rom_marbella_shared_the_face_menu_0e779db2:

    # MC @ think "Is there many of you left?"
    MC @ think "Ainda há muitos de vocês?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:61
translate ptBR rom_marbella_shared_the_face_menu_c2715630:

    # THE_FACE "I have not sensed another of my kind in over four-hundred years."
    THE_FACE "Não sinto outro da minha espécie há mais de quatrocentos anos."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:62
translate ptBR rom_marbella_shared_the_face_menu_7eff8b9b:

    # MC @ think "... Then maybe you're the last?"
    MC @ think "...Então talvez sejas o último?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:63
translate ptBR rom_marbella_shared_the_face_menu_c6af2dbb_1:

    # "The creature grinned."
