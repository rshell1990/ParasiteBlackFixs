translate ptBR rom_Nijah_stage1_future_lines_menu_88ce21a9:

    # MC @ talk "I’ll pay for you to have your own room."
    MC @ talk "Vou pagar para você ter seu próprio quarto."

# game/data/world_romance/nijah/scr_future.rpy:44
translate ptBR rom_Nijah_stage1_future_lines_menu_ba9be3de:

    # MC @ talk "As a Novaras citizen, I can quickly and legally get the paperwork you need."
    MC @ talk "Como cidadão de Novaras, posso conseguir rapidamente e legalmente a papelada que você precisa."

# game/data/world_romance/nijah/scr_future.rpy:45
translate ptBR rom_Nijah_stage1_future_lines_menu_1ef1adfd:

    # MC @ talk "I can also guarantee you have some protection that before you was not privy to."
    MC @ talk "Também posso garantir que você tem uma proteção que antes não tinha acesso."

# game/data/world_romance/nijah/scr_future.rpy:46
translate ptBR rom_Nijah_stage1_future_lines_menu_a4b7cc57:

    # MC "Nijah pondered the thought a moment, hesistant about the idea of returning to her old line of work."
    MC "Como cidadão de Novaras, posso obter rapidamente e legalmente a papelada de que precisa."

# game/data/world_romance/nijah/scr_future.rpy:47
translate ptBR rom_Nijah_stage1_future_lines_menu_9cc15501:

