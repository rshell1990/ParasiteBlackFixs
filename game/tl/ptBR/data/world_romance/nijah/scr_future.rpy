translate ptBR rom_Nijah_stage1_future_lines_menu_a6b98d5f:

    # "Nijah hurried forward, wrapping her arms around me in a tight hug, when she pulled back, she smiled warmly, tears streaming down her cheeks in joy."
    "Nijah correu para frente, envolvendo seus braços ao meu redor em um abraço apertado, quando ela recuou, sorriu calorosamente, lágrimas escorrendo por suas bochechas de alegria."

# game/data/world_romance/nijah/scr_future.rpy:38
translate ptBR rom_Nijah_stage1_future_lines_menu_a997409b:

    # NIJAH "Alright... I trust you... I shall wait for you."
    NIJAH "Tudo bem... eu confio em você... vou esperar por você."

# game/data/world_romance/nijah/scr_future.rpy:42
translate ptBR rom_Nijah_stage1_future_lines_menu_b41866ee:

