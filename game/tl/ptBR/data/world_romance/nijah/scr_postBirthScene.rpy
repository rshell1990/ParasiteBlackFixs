# game/data/world_romance/nijah/scr_postBirthScene.rpy:12
translate ptBR nijah_post_birth_scene_f419fd3c:

    # MC @ talk "How are you feeling?"
    MC @ talk "Como você está se sentindo?"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:13
translate ptBR nijah_post_birth_scene_d6a41399:

    # NIJAH "Tired, but went well."
    NIJAH "Cansada, mas correu bem."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:14
translate ptBR nijah_post_birth_scene_ff1e5fa2:

    # NIJAH "Midwives were surprised, they said our child's birth was the easiest they had ever seen."
    NIJAH "As parteiras ficaram surpreendidas, disseram que o parto do nosso filho foi o mais fácil que já tinham visto."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:15
translate ptBR nijah_post_birth_scene_72e3a616:

    # NIJAH "...Zis because of your {i}gift?{/i}"
    NIJAH "...É por causa do seu {i}dom?{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:16
translate ptBR nijah_post_birth_scene_1a193db3:

    # BLACK "{i}(Yes, it is good to not allow hosts to die when they can sire many young for us).{/i}"
    BLACK "{i}(Sim, é bom não deixar os hospedeiros morrer quando podem gerar tantas crias para nós).{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:17
translate ptBR nijah_post_birth_scene_70eb3d22:

    # MC @ talk "Uhh, yes."
    MC @ talk "Hã, sim."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:18
translate ptBR nijah_post_birth_scene_2baa7256:

    # NIJAH "Zis is good to know because..."
    NIJAH "É bom saber isto porque..."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:19
translate ptBR nijah_post_birth_scene_f1f3684e:

    # "Nijah alluringly stepped towards me, pressing her breasts against my chest as her hands run down my chest."
    "Nijah se aproximou sedutoramente de mim, pressionando seus seios contra meu peito enquanto suas mãos percorriam meu corpo."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:20
translate ptBR nijah_post_birth_scene_71299bb6:

    # NIJAH @ lewd "{i}We must have a very big family!{/i}"
    NIJAH @ lewd "{i}Precisamos ter uma família bem grande!{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:21
translate ptBR nijah_post_birth_scene_a6155343:

    # MC @ surprised "{i}*Gulp!*{/i}"
    MC @ surprised "{i}*Engole!*{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:23
translate ptBR nijah_post_birth_scene_b55b6da8:

    # "For the next hour or so, I spent some time with Nijah and our new-born child, playing and watching them with a new-found pride."
    "Durante a hora seguinte, passei algum tempo com Nijah e o nosso filho recém-nascido, a brincar e a observá-los com um orgulho recém-descoberto."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:24
translate ptBR nijah_post_birth_scene_506f49d3:

    # "Whether it was by the {i}Dark passengers{/i} design within me, or my own natural paternal instincts stiring, I felt rejuvenated and stronger as I watched my child playfully reach out to grab my hand."
    "Seja pelo design do {i}Passageiro Sombrio{/i} dentro de mim, ou pelos meus próprios instintos paternos naturais se agitando, me senti rejuvenescido e mais forte enquanto observava meu filho estender a mão brincalhona para agarrar a minha."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:25
translate ptBR nijah_post_birth_scene_e00fed67:

    # "A short while later, I left Nijah alone once again, onwards towards whatever was next."
    "Pouco tempo depois, deixei Nijah sozinha mais uma vez, seguindo em direção ao que quer que viesse a seguir."

