# game/data/world_romance/ves/scr_2_FortAndCook.rpy:2
translate ptBR rom_Ves_2_FortAndCook_Rev_e399c0fc:

    # VES @ talk "Yes, sure!"
    VES @ talk "Sim, claro!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:3
translate ptBR rom_Ves_2_FortAndCook_Rev_33e02ec9:

    # VES @ talk "I plan to set up some perimeter defences, just some bells and such on a wire that will jingle in case anyone tries to sneak in here."
    VES @ talk "Planeio montar algumas defesas no perímetro, apenas uns sinos e tal num arame que tilintam caso alguém tente esgueirar-se para aqui."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:9
translate ptBR rom_Ves_2_FortAndCook_Rev_f515fabb:

    # VES @ talk "... Oh, well, let me know when you’re able to, I suppose..."
    VES @ talk "... Oh, bem, avisa-me quando puderes, suponho..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:14
translate ptBR rom_Ves_2_FortAndCook_94bfba8b:

    # VES @ talk "Great, let me get the stuff ready..."
    VES @ talk "Ótimo, deixa-me preparar as coisas..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:19
translate ptBR rom_Ves_2_FortAndCook_1bb29bdd:

    # "Over the next hour or so, Ves and I began to set up some primitive defences around her camp."
    "Durante a hora seguinte, Ves e eu começámos a montar algumas defesas primitivas à volta do acampamento dela."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:21
translate ptBR rom_Ves_2_FortAndCook_c0c4d85f:

    # "A few spikes in the ground here and there alongside a wire running the camp’s perimeter..."
    "Algumas estacas no chão aqui e ali junto com um arame percorrendo o perímetro do acampamento..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:23
translate ptBR rom_Ves_2_FortAndCook_96d5e6db:

    # "If someone knocked it with their foot, it would jingle the attached glass bottles and miscellaneous goods loudly enough to alert Ves of their presence."
    "Se alguém batesse com o pé, faria tilintar as garrafas de vidro presas e diversos produtos alto o suficiente para alertar Ves de sua presença."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:25
translate ptBR rom_Ves_2_FortAndCook_840a3072:

    # "And God help them when it did."
    "E que Deus os ajudasse quando acontecesse."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:26
translate ptBR rom_Ves_2_FortAndCook_d5275d4b:

    # "Wiping the sweat from my brow as I hammered in one of the posts and secured it in place, I noticed Ves sneakily watched me the whole time, still cautiously half alert to my presence as a human, and half with a great deal of curiosity."
    "Enxugando o suor da minha testa enquanto martelava uma das estacas e a fixava no lugar, notei que Ves me observava furtivamente o tempo todo, ainda cautelosamente meio alerta à minha presença como humano, e meio com uma grande dose de curiosidade."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:31
translate ptBR rom_Ves_2_FortAndCook_4d690972:

    # VES @ talk "You are strong."
    VES @ talk "És forte."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:32
translate ptBR rom_Ves_2_FortAndCook_6fb5dd4e:

    # "She watched me force one of the wooden posts into the ground."
    "Ela me observou forçar um dos postes de madeira no chão."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:33
translate ptBR rom_Ves_2_FortAndCook_3fcdb530:

    # MC @ talk "Yeah, when this {i}thing{/i} inside of me attached itself, it changed my body as well."
    MC @ talk "Sim, quando esta {i}coisa{/i} dentro de mim se prendeu, também mudou o meu corpo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:34
translate ptBR rom_Ves_2_FortAndCook_aef1c638:

    # VES @ talk "... I see."
    VES @ talk "... Entendo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:37
translate ptBR rom_Ves_2_FortAndCook_ffbe6e66:

    # "Ves continued to observe as I worked until the sun began to set. If I caught her staring, she quickly made sure to look away and carry on working elsewhere, usually coiling the wires around the posts."
    "Ves continuou observando enquanto eu trabalhava até o sol começar a se pôr. Se eu a pegasse encarando, ela rapidamente desviava o olhar e continuava trabalhando em outro lugar, geralmente enrolando os fios nos postes."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:42
translate ptBR rom_Ves_2_FortAndCook_5278c1eb:

    # MC @ talk "Alright... That’s about everything, I think."
    MC @ talk "Muito bem... Acho que é tudo."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:43
translate ptBR rom_Ves_2_FortAndCook_ad5a8665:

    # VES @ talk "Yes, this is good."
    VES @ talk "Sim, isto está bom."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:44
translate ptBR rom_Ves_2_FortAndCook_101cd48e:

    # VES "..."
    VES "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:46
translate ptBR rom_Ves_2_FortAndCook_0e5b05f2:

    # VES @ talk "Are you free for a few more hours?"
    VES @ talk "Está livre por mais umas horas?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:47
translate ptBR rom_Ves_2_FortAndCook_3ff3a479:

    # MC @ talk "What for?"
    MC @ talk "Para quê?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:48
translate ptBR rom_Ves_2_FortAndCook_24f33162:

    # VES @ talk "Would you care to join me for food?"
    VES @ talk "Gostavas de te juntar a mim para comer?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:49
translate ptBR rom_Ves_2_FortAndCook_25a6adf5:

    # MC @ talk "Food?"
    MC @ talk "Comida?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:50
translate ptBR rom_Ves_2_FortAndCook_b3cb40ff:

    # VES @ talk "Yes... You must be hungry by now."
    VES @ talk "Sim... Deves estar com fome a esta hora."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:51
translate ptBR rom_Ves_2_FortAndCook_83ddd484:

    # VES @ talk "{i}And...{/i}"
    VES @ talk "{i}E...{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:52
translate ptBR rom_Ves_2_FortAndCook_d67a7314:

    # VES @ talk "It would be nice to have some company for a change."
    VES @ talk "Seria bom ter alguma companhia para variar."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:53
translate ptBR rom_Ves_2_FortAndCook_ee88f5f9:

    # MC @ talk "... Sure, Ves, I’ll stay for some food."
    MC @ talk "... Claro, Ves, fico para comer qualquer coisa."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:54
translate ptBR rom_Ves_2_FortAndCook_6a2a3f7b:

    # MC @ talk "I’m pretty hungry myself anyway."
    MC @ talk "Também estou com bastante fome."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:55
translate ptBR rom_Ves_2_FortAndCook_cd9ef004:

    # "Ves perked up with an actual smile."
    "Ves se animou com um sorriso genuíno."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:56
translate ptBR rom_Ves_2_FortAndCook_cf7b5d91:

    # VES @ talk "Good!"
    VES @ talk "Ótimo!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:57
translate ptBR rom_Ves_2_FortAndCook_79c1b828:

    # VES @ talk "I’ll get started on preparing the meat!"
    VES @ talk "Vou começar a preparar a carne!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:59
translate ptBR rom_Ves_2_FortAndCook_d55bc3a1:

    # "With that Ves hurried off to begin cooking. As she bent forward to grab some pots and pans, I stared at her cute ass as it shifted through the gossamer material gathered around it."
    "Com isso Ves saiu apressada para começar a cozinhar. Enquanto ela se curvava para pegar algumas panelas, eu encarei sua bunda adorável enquanto ela se movia através do material diáfano reunido ao redor dela."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:60
translate ptBR rom_Ves_2_FortAndCook_30cd150e:

    # BLACK "... This one I like."
    BLACK "... Desta eu gosto."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:61
translate ptBR rom_Ves_2_FortAndCook_e9c1fe99:

    # BLACK "She smells... {i}very appealing{/i}."
    BLACK "Ela cheira... {i}muito apetecível{/i}."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:62
translate ptBR rom_Ves_2_FortAndCook_ffba0f79:

    # "From the corner of her eye, Ves looked back frequently over her shoulder at me, and from her expression, she must have realised that I kept glancing towards her as well because she'd shyly pull away."
    "Pelo canto do olho, Ves olhava frequentemente por cima do ombro para mim, e pela expressão dela, ela deve ter percebido que eu também continuava olhando para ela porque ela se afastava timidamente."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:63
translate ptBR rom_Ves_2_FortAndCook_efe19f2e:

    # "I did my best to look away, coughing awkwardly to break the strange tension."
    "Fiz o meu melhor para desviar o olhar, tossindo desajeitadamente para quebrar a tensão estranha."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:64
translate ptBR rom_Ves_2_FortAndCook_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:65
translate ptBR rom_Ves_2_FortAndCook_efb9de0e:

    # BLACK "... Her heart rate has just increased exponentially, is she in heat and ready to procreate?"
    BLACK "... O ritmo cardíaco dela acabou de aumentar exponencialmente, ela está no cio e pronta para procriar?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:66
translate ptBR rom_Ves_2_FortAndCook_912591a3:

    # MC @ angry "Would you shut up?!"
    MC @ angry "Quer calar-te?!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:69
translate ptBR rom_Ves_2_FortAndCook_e4278626:

    # "Ves spun to look back at me, visible confusion on her face."
    "Ves girou para olhar para mim, confusão visível em seu rosto."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:70
translate ptBR rom_Ves_2_FortAndCook_6eb77fc4:

    # MC @ surprised "It’s... It’s the thing."
    MC @ surprised "É... É a coisa."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:71
translate ptBR rom_Ves_2_FortAndCook_1c238644:

    # MC @ talk "It can speak to me in my head."
    MC @ talk "Consegue falar comigo na minha cabeça."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:72
translate ptBR rom_Ves_2_FortAndCook_57f92f4e:

    # "Ves, now a little concerned, simply mouthed an ‘Oh’ as she quickly decided not to ponder too much on it and instead carried on grabbing what she needed."
    "Ves, agora um pouco preocupada, simplesmente murmurou um 'Oh' enquanto rapidamente decidia não pensar muito no assunto e em vez disso continuava pegando o que precisava."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:75
translate ptBR rom_Ves_2_FortAndCook_748fee9b:

    # "We sat around the warm blazing fire outside of her tent, chewing on the tender meat from our hunt skewered onto sticks which we cooked over the flames."
    "Sentamos ao redor da fogueira quente e crepitante do lado de fora de sua tenda, mastigando a carne tenra da nossa caça espetada em varas que cozinhamos sobre as chamas."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:76
translate ptBR rom_Ves_2_FortAndCook_bd8ba4fd:

    # "It was quiet tonight, and the fire provided the only light around for what must have been miles."
    "Estava quieto esta noite, e o fogo fornecia a única luz ao redor pelo que deviam ser milhas."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:83
translate ptBR rom_Ves_2_FortAndCook_7effd6c2:

    # "Ves waited and watched eagerly as I sat there with the meat on a stick, looking queasily at it as she observed me, waiting with bated breath as I took a tentative bite from it."
    "Ves esperou e observou ansiosamente enquanto eu sentava lá com a carne no espeto, olhando enjoado para ela enquanto ela me observava, esperando com a respiração suspensa enquanto eu dava uma mordida hesitante."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:84
translate ptBR rom_Ves_2_FortAndCook_0aa278e1:

    # MC @ talk "... It’s good."
    MC @ talk "... Está bom."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:85
translate ptBR rom_Ves_2_FortAndCook_a4c6456f:

    # "Ves' eyes seemed to glitter in the embers of the fire as she smiled triumphantly, her fists raised into the night air."
    "Os olhos de Ves pareciam brilhar nas brasas da fogueira enquanto ela sorria triunfante, seus punhos erguidos no ar noturno."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:86
translate ptBR rom_Ves_2_FortAndCook_f1f8a99a:

    # VES @ talk "YES!"
    VES @ talk "SIM!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:87
translate ptBR rom_Ves_2_FortAndCook_d99bc996:

    # VES @ talk "My tribe said I’d never be a good cook!"
    VES @ talk "A minha tribo disse que eu nunca seria boa cozinheira!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:88
translate ptBR rom_Ves_2_FortAndCook_dd141836:

    # VES @ talk "Ha! They would eat dirt if they were here!"
    VES @ talk "Ha! Eles comiam terra se aqui estivessem!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:89
translate ptBR rom_Ves_2_FortAndCook_a58b53ef:

    # MC @ talk "How big is your tribe?"
    MC @ talk "Quão grande é a sua tribo?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:90
translate ptBR rom_Ves_2_FortAndCook_486ed9ca:

    # VES @ talk "Hm? Oh well, I think there’s about a hundred altogether..."
    VES @ talk "Hm? Ah, bem, acho que há cerca de cem ao todo..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:91
translate ptBR rom_Ves_2_FortAndCook_95cc3756:

    # MC @ talk "A hundred?!"
    MC @ talk "Cem?!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:93
translate ptBR rom_Ves_2_FortAndCook_128cb1f3:

    # "Ves laughed."
    "Ves riu."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:94
translate ptBR rom_Ves_2_FortAndCook_66700141:

    # VES @ talk "It’s a small tribe. The tribes all fall under the rule of the Great Chieftain should he command us, but all tribes are led by their Elders."
    VES @ talk "É uma tribo pequena. As tribos estão todas sob o domínio do Grande Chefe, se ele nos comandar, mas todas as tribos são lideradas pelos seus Anciãos."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:95
translate ptBR rom_Ves_2_FortAndCook_d3eed914:

    # "Ves took a bite of her food and smiled."
    "Ves deu uma mordida em sua comida e sorriu."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:96
translate ptBR rom_Ves_2_FortAndCook_632b2da1:

    # VES @ talk "Mmm, just needs some more salt..."
    VES @ talk "Mmm, só precisa de mais um pouco de sal..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:97
translate ptBR rom_Ves_2_FortAndCook_9a799022:

    # VES @ talk "In Skarshire, there are so many different spices and flavours for food."
    VES @ talk "Em Skarshire, há tantas especiarias e sabores diferentes para a comida."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:98
translate ptBR rom_Ves_2_FortAndCook_e7a60ff6:

    # MC @ talk "I’ve never been."
    MC @ talk "Nunca lá fui."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:99
translate ptBR rom_Ves_2_FortAndCook_e3c60fc3:

    # VES @ talk "Skarshire is beautiful, many small islands are interconnected. Our own little archipelago."
    VES @ talk "Skarshire é linda, muitas pequenas ilhas estão interligadas. O nosso pequeno arquipélago."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:100
translate ptBR rom_Ves_2_FortAndCook_00c0a271:

    # VES @ talk "The water is so blue..."
    VES @ talk "A água é tão azul..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:101
translate ptBR rom_Ves_2_FortAndCook_dd9c2863:

    # VES @ talk "Perhaps one day I will show—"
    VES @ talk "Talvez um dia eu mostre—"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:103
translate ptBR rom_Ves_2_FortAndCook_b236ea86:

    # "Ves paused, the smile dropping from her face. "
    "Ves fez uma pausa, o sorriso desaparecendo de seu rosto."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:104
translate ptBR rom_Ves_2_FortAndCook_d3463ab9:

    # VES @ talk "Never mind."
    VES @ talk "Deixa pra lá."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:105
translate ptBR rom_Ves_2_FortAndCook_293b9424:

    # MC @ talk "... What? What is it?"
    MC @ talk "... O quê? O que foi?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:106
translate ptBR rom_Ves_2_FortAndCook_a72d3f88:

    # VES @ talk "It’s not going to happen — humans and orcs do not mix."
    VES @ talk "Não vai acontecer — humanos e orcs não se misturam."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:107
translate ptBR rom_Ves_2_FortAndCook_2098e538:

    # MC @ talk "... We seem to get on pretty well."
    MC @ talk "... Parece que nos damos muito bem."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:108
translate ptBR rom_Ves_2_FortAndCook_4f90784e:

    # VES @ sad "..."
    VES @ sad "..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:109
translate ptBR rom_Ves_2_FortAndCook_6798a12e:

    # MC @ talk "Aren’t we proof it doesn’t have to just be fighting?"
    MC @ talk "Não somos a prova de que não tem de ser só luta?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:110
translate ptBR rom_Ves_2_FortAndCook_20caadc0:

    # VES @ talk "It’s not merely about just getting on! There is... too much pain... too much hate for that to happen."
    VES @ talk "Não se trata apenas de se dar bem! Há... demasiada dor... demasiado ódio para que isso aconteça."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:111
translate ptBR rom_Ves_2_FortAndCook_18a9b1cb:

    # MC @ talk "Not all humans are the same, Ves."
    MC @ talk "Nem todos os humanos são iguais, Ves."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:112
translate ptBR rom_Ves_2_FortAndCook_6e4a5cbd:

    # VES @ talk "I know that!"
    VES @ talk "Eu sei disso!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:113
translate ptBR rom_Ves_2_FortAndCook_bdcf49f1:

    # VES @ talk "But a human wouldn’t understand."
    VES @ talk "Mas um humano não entenderia."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:114
translate ptBR rom_Ves_2_FortAndCook_56cc6176:

    # MC @ talk "Then try, try to make me understand!"
    MC @ talk "Então tenta, tenta fazer-me entender!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:116
translate ptBR rom_Ves_2_FortAndCook_4d056001:

    # VES @ sad_talk "... Our people have been slaves for generations."
    VES @ sad_talk "... O nosso povo tem sido escravo durante gerações."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:117
translate ptBR rom_Ves_2_FortAndCook_27f3f3d6:

    # VES @ sad_talk "Rape... Violence... Torture..."
    VES @ sad_talk "Violação... Violência... Tortura..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:118
translate ptBR rom_Ves_2_FortAndCook_32d10626:

    # VES @ sad_talk "These things are everyday occurrences for the orcs still bound by their master’s whips. "
    VES @ sad_talk "Estas coisas são ocorrências diárias para os orcs ainda presos pelos chicotes dos seus mestres."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:119
translate ptBR rom_Ves_2_FortAndCook_b97e9576:

    # VES @ sad_talk "Made to feel an ugly people... Made to feel {i}dirty.{/i}"
    VES @ sad_talk "Feitos para se sentirem um povo feio... Feitos para se sentirem {i}sujos.{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:120
translate ptBR rom_Ves_2_FortAndCook_d1296db1:

    # VES @ sad_talk "Nothing but shame has been brought and inflicted upon us."
    VES @ sad_talk "Nada além de vergonha nos foi trazido e infligido."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:121
translate ptBR rom_Ves_2_FortAndCook_3fa7e5b2:

    # MC @ talk "But that was the Greater Trading Company! What does that have to do with the rest of us?"
    MC @ talk "Mas essa foi a Grande Companhia de Comércio! O que é que isso tem a ver com o resto de nós?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:123
translate ptBR rom_Ves_2_FortAndCook_b5661854:

    # VES @ angry_talk "No!"
    VES @ angry_talk "Não!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:125
translate ptBR rom_Ves_2_FortAndCook_35d5211c:

    # "Ves rose to her feet furiously, anger simmering beneath her voice."
    "Ves se levantou furiosamente, a raiva fervendo sob sua voz."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:126
translate ptBR rom_Ves_2_FortAndCook_139e9c93:

    # VES @ angry_talk "You are all the same!"
    VES @ angry_talk "Vocês são todos iguais!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:127
translate ptBR rom_Ves_2_FortAndCook_16b1882c:

    # VES @ angry_talk "Alderay, YOUR PEOPLE, have been sending our enemies weapons, have been sending them supplies!"
    VES @ angry_talk "Alderay, O TEU POVO, tem enviado armas aos nossos inimigos, tem-lhes enviado mantimentos!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:128
translate ptBR rom_Ves_2_FortAndCook_9832729d:

    # VES @ angry_talk "Why? For gold!"
    VES @ angry_talk "Porquê? Por ouro!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:129
translate ptBR rom_Ves_2_FortAndCook_14ddb23b:

    # VES @ angry_talk "{i}For greed...{/i}"
    VES @ angry_talk "{i}Por ganância...{/i}"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:130
translate ptBR rom_Ves_2_FortAndCook_08e95c86:

    # MC @ sad "That’s not true! Yes, Alderay sold to the Greater Trading Company at first..."
    MC @ sad "Isso não é verdade! Sim, Alderay vendeu à Grande Companhia de Comércio no início..."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:131
translate ptBR rom_Ves_2_FortAndCook_cedef812:

    # MC @ sad "But Alderay officially cut ties with them after the {i}‘Battle of the Bay of Valar’{/i}, everyone knows that!"
    MC @ sad "Mas Alderay cortou oficialmente laços com eles depois da {i}'Batalha da Baía de Valar'{/i}, toda a gente sabe disso!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:132
translate ptBR rom_Ves_2_FortAndCook_753e15da:

    # MC @ sad "It was part of the peace deal Newheart secured! The one your people continue to violate by attacking innocent civilians!"
    MC @ sad "Fez parte do acordo de paz que Newheart garantiu! Aquele que o seu povo continua a violar ao atacar civis inocentes!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:133
translate ptBR rom_Ves_2_FortAndCook_15b6ae1d:

    # "Ves gritted her teeth, swelling with rage. "
    "Ves rangeu os dentes, fervendo de raiva."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:134
translate ptBR rom_Ves_2_FortAndCook_40c348cc:

    # VES @ angry_talk "You idiot!"
    VES @ angry_talk "Seu idiota!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:135
translate ptBR rom_Ves_2_FortAndCook_8991341f:

    # VES @ angry_talk "Then why do we see unmarked ships docking into Borusmark with supplies, hmm?"
    VES @ angry_talk "Então porque é que vemos navios não marcados a atracar em Borusmark com mantimentos, hmm?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:136
translate ptBR rom_Ves_2_FortAndCook_3663fd1e:

    # VES @ angry_talk "And why do you think the Greater Trading Company continue to send gold to your lands if they have no business with you? "
    VES @ angry_talk "E porque acha que a Grande Companhia de Comércio continua a enviar ouro para as vossas terras se não têm negócios convosco?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:137
translate ptBR rom_Ves_2_FortAndCook_f7c79499:

    # MC @ surprised "You can’t just assume that was us! Unmarked could be anyone!"
    MC @ surprised "Não pode simplesmente assumir que fomos nós! Não identificados pode ser qualquer um!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:138
translate ptBR rom_Ves_2_FortAndCook_f52e9141:

    # MC @ surprised "By the gods it could be pirates smuggling for all you know!"
    MC @ surprised "Pelos deuses, podem ser piratas a contrabandear, pelo que sabe!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:139
translate ptBR rom_Ves_2_FortAndCook_710790b0:

    # MC @ surprised "Slavery has been abolished for years!"
    MC @ surprised "A escravatura foi abolida há anos!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:140
translate ptBR rom_Ves_2_FortAndCook_8f00f766:

    # VES @ angry_talk "Do you even hear yourself speak?"
    VES @ angry_talk "Você ouves-te a ti própria a falar?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:141
translate ptBR rom_Ves_2_FortAndCook_0d04ca08:

    # VES @ angry_talk "The treaty was a lie!"
    VES @ angry_talk "O tratado era uma mentira!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:142
translate ptBR rom_Ves_2_FortAndCook_089d6c28:

    # VES @ angry_talk "What did you expect us to do when you continue to aid our enemies?"
    VES @ angry_talk "O que esperavas que fizéssemos quando continuam a ajudar os nossos inimigos?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:143
translate ptBR rom_Ves_2_FortAndCook_2023b64a:

    # VES @ angry_talk "Sit back and let us be treated like animals? "
    VES @ angry_talk "Ficar de braços cruzados e deixar que nos tratem como animais?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:144
translate ptBR rom_Ves_2_FortAndCook_f34b5220:

    # MC @ angry "So, killing civilians is the answer? "
    MC @ angry "Então, matar civis é a resposta?"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:145
translate ptBR rom_Ves_2_FortAndCook_d670272e:

    # MC @ angry "Innocent men and women who’ve played NO part in any of this! "
    MC @ angry "Homens e mulheres inocentes que NÃO tiveram parte NENHUMA nisto!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:146
translate ptBR rom_Ves_2_FortAndCook_db797b4c:

    # VES @ angry_talk "Grgh! There we go!"
    VES @ angry_talk "Grgh! Aí está!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:147
translate ptBR rom_Ves_2_FortAndCook_c1f547c9:

    # VES angry_talk "Always thinking like a human! Always finding a way to justify the horrors you inflict on others!"
    VES angry_talk "Sempre a pensar como um humano! Sempre a arranjar maneira de justificar os horrores que infliges aos outros!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:148
translate ptBR rom_Ves_2_FortAndCook_825cb83d:

    # MC @ angry "I’m not trying to justify it, Ves!"
    MC @ angry "Não estou tentando justificar, Ves!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:149
translate ptBR rom_Ves_2_FortAndCook_2cb544a7:

    # MC @ angry "But you can’t justify committing one crime as a response to another!"
    MC @ angry "Mas não pode justificar cometer um crime como resposta a outro!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:150
translate ptBR rom_Ves_2_FortAndCook_567d0cf3:

    # VES @ angry_talk "You have no idea what we’ve endured... You know nothing!"
    VES @ angry_talk "Não faz ideia do que suportámos... Não sabe nada!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:151
translate ptBR rom_Ves_2_FortAndCook_467ade81:

    # MC @ sad "I’m trying to help!"
    MC @ sad "Estou tentando ajudar!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:152
translate ptBR rom_Ves_2_FortAndCook_859e0e65:

    # VES @ angry_talk "I didn’t want your help!"
    VES @ angry_talk "Eu não quis a sua ajuda!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:154
translate ptBR rom_Ves_2_FortAndCook_bbe4124a:

    # "Ves kicked up some sand into the fire as she stormed off back into the sanctuary of her tent, shouting loudly behind at me. "
    "Ves chutou areia na fogueira enquanto saía furiosa de volta para o santuário de sua tenda, gritando alto para mim."

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:155
translate ptBR rom_Ves_2_FortAndCook_a8b54219:

    # VES @ talk "Now leave me alone, human!"
    VES @ talk "Agora deixa-me em paz, humano!"

# game/data/world_romance/ves/scr_2_FortAndCook.rpy:156
translate ptBR rom_Ves_2_FortAndCook_4625fdc3:

    # MC "(... Well that could have gone better.)"
    MC "(... Bem, aquilo podia ter corrido melhor.)"

translate ptBR strings:

    # game/data/world_romance/ves/scr_2_FortAndCook.rpy:5
    old "{image=[ICON.CLOCK]} Let's do this."
    new "{image=[ICON.CLOCK]} Vamos fazer isso."

