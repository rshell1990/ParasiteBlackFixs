# game/data/world_romance/ves/scr_6_Drunk.rpy:126
translate ptBR rom_Ves_6_Drunk_cf401c13:

    # VES @ talk "So... You and this other human friend of yours, Marcus... Are you close?"
    VES @ talk "Então... Você e esse seu outro amigo humano, o Marcus... São próximos?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:127
translate ptBR rom_Ves_6_Drunk_9c9de6c1:

    # MC @ talk "Like brothers... We’ve known each other since we were little."
    MC @ talk "Como irmãos... Conhecemo-nos desde pequenos."

# game/data/world_romance/ves/scr_6_Drunk.rpy:128
translate ptBR rom_Ves_6_Drunk_824d1dca:

    # VES @ talk "He is... different to you."
    VES @ talk "Ele é... diferente de ti."

# game/data/world_romance/ves/scr_6_Drunk.rpy:129
translate ptBR rom_Ves_6_Drunk_ade481c7:

    # MC @ talk "He’s a good man."
    MC @ talk "Ele é um bom homem."

# game/data/world_romance/ves/scr_6_Drunk.rpy:130
translate ptBR rom_Ves_6_Drunk_2be47c87:

    # MC @ talk "But he’s got his issues, even before the fighting, I think."
    MC @ talk "Mas ele tem os seus problemas, mesmo antes dos combates, acho eu."

# game/data/world_romance/ves/scr_6_Drunk.rpy:131
translate ptBR rom_Ves_6_Drunk_72fcfee0:

    # VES @ talk "... So, how did you become warriors?"
    VES @ talk "... Então, como é que se tornaram guerreiros?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:132
translate ptBR rom_Ves_6_Drunk_e268bbee:

    # MC @ talk "We didn’t get much say in the matter..."
    MC @ talk "Não tivemos muita escolha na questão..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:133
translate ptBR rom_Ves_6_Drunk_7a4b33f3:

    # MC @ talk "Called up to be part of the noble Scouts."
    MC @ talk "Convocados para fazer parte dos nobres Batedores."

# game/data/world_romance/ves/scr_6_Drunk.rpy:134
translate ptBR rom_Ves_6_Drunk_6347eb66:

    # VES @ talk "You didn’t choose to become a warrior?"
    VES @ talk "Não escolheste tornar-te guerreiro?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:135
translate ptBR rom_Ves_6_Drunk_d4498740:

    # VES @ talk "Surely this is a great honour!"
    VES @ talk "Certamente isto é uma grande honra!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:136
translate ptBR rom_Ves_6_Drunk_829f86a7:

    # MC @ talk "Not to us..."
    MC @ talk "Não para nós..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:137
translate ptBR rom_Ves_6_Drunk_ced6b3ea:

    # VES @ talk "... I don’t understand."
    VES @ talk "... Não compreendo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:138
translate ptBR rom_Ves_6_Drunk_3cb19faa:

    # MC @ talk "There’s no glory dying in some wretched field for a pointless skirmish watching as your friends are being slaughtered around you."
    MC @ talk "Não há glória nenhuma em morrer num campo miserável qualquer por uma escaramuça sem sentido a ver os seus amigos a serem massacrados à sua volta."

# game/data/world_romance/ves/scr_6_Drunk.rpy:139
translate ptBR rom_Ves_6_Drunk_2384c6dc:

    # MC @ talk "Dying for SOMETHING, for ANYTHING would make it better..."
    MC @ talk "Morrer por ALGUMA COISA, por QUALQUER COISA torná-lo-ia melhor..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:140
translate ptBR rom_Ves_6_Drunk_4d97dec6:

    # MC @ talk "More bearable."
    MC @ talk "Mais suportável."

# game/data/world_romance/ves/scr_6_Drunk.rpy:141
translate ptBR rom_Ves_6_Drunk_2ac5b574:

    # MC @ talk "But most of us would just die unceremoniously, in cruel, painful deaths with no one to remember... or even care that we’re gone or what our mission even was in the first place."
    MC @ talk "Mas a maioria de nós simplesmente morreria sem cerimónia, em mortes cruéis e dolorosas sem ninguém para se lembrar... ou sequer importar-se de que partimos ou qual era a nossa missão em primeiro lugar."

# game/data/world_romance/ves/scr_6_Drunk.rpy:142
translate ptBR rom_Ves_6_Drunk_4999deb8:

    # VES @ talk "..."
    VES @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:143
translate ptBR rom_Ves_6_Drunk_d0ba7df3:

    # MC @ talk "Praying... always praying you’d somehow get home... Praying you’d never have to venture beyond those walls again."
    MC @ talk "A rezar... sempre a rezar para de alguma forma chegares a casa... A rezar para nunca mais teres de te aventurar para lá daquelas muralhas."

# game/data/world_romance/ves/scr_6_Drunk.rpy:144
translate ptBR rom_Ves_6_Drunk_74b54e64:

    # VES @ talk "... And yet, here you are!"
    VES @ talk "... E no entanto, aqui está!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:145
translate ptBR rom_Ves_6_Drunk_8b056b19:

    # VES @ smile_talk "Made stronger by surviving beyond the walls!"
    VES @ smile_talk "Ficaste mais forte por sobreviveres para lá das muralhas!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:146
translate ptBR rom_Ves_6_Drunk_dc6c7127:

    # MC @ talk "... Yeah, I suppose so."
    MC @ talk "... Sim, suponho que sim."

# game/data/world_romance/ves/scr_6_Drunk.rpy:147
translate ptBR rom_Ves_6_Drunk_690c0c4e:

    # VES @ talk "And you and I would never have met if you were still too afraid to leave the safety of your walls."
    VES @ talk "E você e eu nunca nos teríamos conhecido se ainda tivesses demasiado medo de deixar a segurança das suas muralhas."

# game/data/world_romance/ves/scr_6_Drunk.rpy:148
translate ptBR rom_Ves_6_Drunk_6c282d37:

    # MC @ talk "... Me and Marcus only survived because of {i}what happened...{/i}"
    MC @ talk "... Eu e o Marcus só sobrevivemos por causa {i}do que aconteceu...{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:149
translate ptBR rom_Ves_6_Drunk_e6596336:

    # MC @ talk "For anyone else, they’d be..."
    MC @ talk "Para qualquer outra pessoa, estariam..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:150
translate ptBR rom_Ves_6_Drunk_5e6d1b2b:

    # "Ves’ hand moved to shush my lips."
    "A mão de Ves moveu-se para me calar os lábios."

# game/data/world_romance/ves/scr_6_Drunk.rpy:151
translate ptBR rom_Ves_6_Drunk_bd2d8643:

    # VES @ talk "And yet, {i}you live to fight another day...{/i}"
    VES @ talk "E no entanto, {i}você vives para lutar outro dia...{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:152
translate ptBR rom_Ves_6_Drunk_b5181c29:

    # VES @ talk "This is what matters."
    VES @ talk "Isto é o que importa."

# game/data/world_romance/ves/scr_6_Drunk.rpy:153
translate ptBR rom_Ves_6_Drunk_30ecfac2:

    # VES @ talk "O’rlarak commands you to live and fight on. For those who were not so fortunate. For those who have been denied what you have."
    VES @ talk "O'rlarak ordena-te que vivas e continues a lutar. Por aqueles que não tiveram tanta sorte. Por aqueles a quem foi negado o que você tem."

# game/data/world_romance/ves/scr_6_Drunk.rpy:154
translate ptBR rom_Ves_6_Drunk_6bede656:

    # MC @ talk "O’rlarak?"
    MC @ talk "O'rlarak?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:155
translate ptBR rom_Ves_6_Drunk_30eba78e:

    # VES @ talk "{i}The greatest of all chiefs who now reigns in the sky.{/i}"
    VES @ talk "{i}O maior de todos os chefes que agora reina no céu.{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:156
translate ptBR rom_Ves_6_Drunk_a7615141:

    # MC @ talk "... Ves..."
    MC @ talk "... Ves..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:157
translate ptBR rom_Ves_6_Drunk_c03a963b:

    # VES @ talk "To my people, to die in battle protecting those we love... those we care for..."
    VES @ talk "Para o meu povo, morrer em batalha a proteger aqueles que amamos... aqueles de quem gostamos..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:158
translate ptBR rom_Ves_6_Drunk_e9ffc2f1:

    # VES @ talk "There is no better way to die."
    VES @ talk "Não há melhor maneira de morrer."

# game/data/world_romance/ves/scr_6_Drunk.rpy:161
translate ptBR rom_Ves_6_Drunk_b9fc2750:

    # VES @ talk "... Strange."
    VES @ talk "... Estranho."

# game/data/world_romance/ves/scr_6_Drunk.rpy:162
translate ptBR rom_Ves_6_Drunk_e6ddc3fe:

    # MC @ talk "What, why is that strange?"
    MC @ talk "O quê, porque é que isso é estranho?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:163
translate ptBR rom_Ves_6_Drunk_c667afcd:

    # VES @ talk "Most orcs see life as a short arrangement... A brief deal with the Great Chiefs paid for in blood."
    VES @ talk "A maioria dos orcs vê a vida como um acordo curto... Um breve pacto com os Grandes Chefes pago em sangue."

# game/data/world_romance/ves/scr_6_Drunk.rpy:164
translate ptBR rom_Ves_6_Drunk_02e3c328:

    # VES @ talk "We are prepared to die from the day we are born."
    VES @ talk "Estamos preparados para morrer desde o dia em que nascemos."

# game/data/world_romance/ves/scr_6_Drunk.rpy:165
translate ptBR rom_Ves_6_Drunk_f9f2d041:

    # VES @ talk "But you see it as lasting... {i}longer.{/i}"
    VES @ talk "Mas você vê a vida como algo que dura... {i}mais.{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:166
translate ptBR rom_Ves_6_Drunk_366f724b:

    # MC @ talk "There’s more to life than death, Ves."
    MC @ talk "Há mais na vida do que a morte, Ves."

# game/data/world_romance/ves/scr_6_Drunk.rpy:167
translate ptBR rom_Ves_6_Drunk_3292e2bf:

    # VES @ talk "... I’d like you to show me this one day."
    VES @ talk "... Gostava que me mostrasses isso um dia."

# game/data/world_romance/ves/scr_6_Drunk.rpy:169
translate ptBR rom_Ves_6_Drunk_6d5279b0:

    # VES @ talk "A brothel?"
    VES @ talk "Um bordel?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:170
translate ptBR rom_Ves_6_Drunk_fd6d73ae:

    # MC @ smile "It’s... Never mind."
    MC @ smile "É... Não importa."

# game/data/world_romance/ves/scr_6_Drunk.rpy:171
translate ptBR rom_Ves_6_Drunk_a5781452:

    # VES @ talk "What kind of place is that?"
    VES @ talk "Que tipo de lugar é esse?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:172
translate ptBR rom_Ves_6_Drunk_331874a8:

    # MC @ talk "It’s a place where humans pay to have sex."
    MC @ talk "É um lugar onde os humanos pagam para ter sexo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:173
translate ptBR rom_Ves_6_Drunk_7926c541:

    # VES @ talk "... Humans... {i}pay{/i} to have sex?"
    VES @ talk "... Humanos... {i}pagam{/i} para ter sexo?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:174
translate ptBR rom_Ves_6_Drunk_b9f291e3:

    # VES @ talk "Do you not have matriarchs?"
    VES @ talk "Vocês não têm matriarcas?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:175
translate ptBR rom_Ves_6_Drunk_3eb7e210:

    # MC @ talk "Uhh, what?"
    MC @ talk "Uhh, o quê?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:176
translate ptBR rom_Ves_6_Drunk_26d490a6:

    # VES @ talk "Every tribe has a few matriarchs... Women devoted just to breeding."
    VES @ talk "Cada tribo tem algumas matriarcas... Mulheres dedicadas apenas à reprodução."

# game/data/world_romance/ves/scr_6_Drunk.rpy:177
translate ptBR rom_Ves_6_Drunk_14252312:

    # MC @ talk "Wait, what?!"
    MC @ talk "Espera, o quê?!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:178
translate ptBR rom_Ves_6_Drunk_660ccc51:

    # VES @ talk "A great number of orcs die young or in battle... Numbers need to be replenished quickly or we risk extinction."
    VES @ talk "Um grande número de orcs morre jovem ou em batalha... Os números precisam de ser repostos rapidamente ou arriscamos a extinção."

# game/data/world_romance/ves/scr_6_Drunk.rpy:179
translate ptBR rom_Ves_6_Drunk_64d864e1:

    # VES @ talk "Matriarchs can even request to break in newly bonded husbands."
    VES @ talk "As matriarcas podem até pedir para domesticar maridos recém-unidos."

# game/data/world_romance/ves/scr_6_Drunk.rpy:180
translate ptBR rom_Ves_6_Drunk_8c056903:

    # MC @ talk "How do the wives feel about that?"
    MC @ talk "Como é que as esposas se sentem em relação a isso?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:181
translate ptBR rom_Ves_6_Drunk_8cb295ba:

    # VES @ talk "It is an old tradition... Some don’t like it but..."
    VES @ talk "É uma tradição antiga... Alguns não gostam mas..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:182
translate ptBR rom_Ves_6_Drunk_988d95b0:

    # MC @ smile "I can imagine!"
    MC @ smile "Posso imaginar!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:183
translate ptBR rom_Ves_6_Drunk_a3045e18:

    # "Ves shrugged apathetically."
    "Ves deu de ombros apaticamente."

# game/data/world_romance/ves/scr_6_Drunk.rpy:184
translate ptBR rom_Ves_6_Drunk_aa67bb4f:

    # VES @ talk "Matriarchs often have the children of several males, and it is forbidden for them to devote themselves to just one mate."
    VES @ talk "As matriarcas costumam ter filhos de vários machos, e é-lhes proibido dedicarem-se a apenas um companheiro."

# game/data/world_romance/ves/scr_6_Drunk.rpy:185
translate ptBR rom_Ves_6_Drunk_4f7c58c4:

    # VES @ talk "So, it is seen as different to betraying your mate to be with them. It is for the good of the clan."
    VES @ talk "Portanto, é visto como diferente de trair o seu parceiro estar com elas. É para o bem do clã."

# game/data/world_romance/ves/scr_6_Drunk.rpy:186
translate ptBR rom_Ves_6_Drunk_4d2eaece:

    # MC @ talk "That’s... a very openminded culture."
    MC @ talk "Isso é... uma cultura muito mente aberta."

# game/data/world_romance/ves/scr_6_Drunk.rpy:187
translate ptBR rom_Ves_6_Drunk_b6085730:

    # MC @ talk "I’m not sure humans would feel the same."
    MC @ talk "Não tenho a certeza de que os humanos sentissem o mesmo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:189
translate ptBR rom_Ves_6_Drunk_9ef627e9:

    # VES @ smile_talk "Of course I am right!"
    VES @ smile_talk "Claro que tenho razão!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:190
translate ptBR rom_Ves_6_Drunk_58ed8680:

    # VES @ talk "I may not have studied like you, but I have learned many things..."
    VES @ talk "Posso não ter estudado como você, mas aprendi muitas coisas..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:193
translate ptBR rom_Ves_6_Drunk_2a911be7:

    # VES @ talk "So... you still haven’t told me how you became..."
    VES @ talk "Então... ainda não me contaste como te tornaste..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:194
translate ptBR rom_Ves_6_Drunk_8ce9bf6a:

    # MC @ talk "Ah... Well..."
    MC @ talk "Ah... Bem..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:195
translate ptBR rom_Ves_6_Drunk_abf098b8:

    # "I spent the next while recounting my tale to Ves, the perilous journey lead by Captain Duprey, the abandoned fort and the strange underground lab..."
    "Passei o tempo seguinte contando minha história para Ves, a jornada perigosa liderada pelo Capitão Duprey, o forte abandonado e o estranho laboratório subterrâneo..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:196
translate ptBR rom_Ves_6_Drunk_66477c9e:

    # "Finally, I went into detail about the strange creatures that had attached themselves to me and Marcus, and the terms and conditions of our survival for their ‘gift’."
    "Finalmente, eu entrei em detalhes sobre as estranhas criaturas que haviam se ligado a mim e Marcus, e os termos e condições de nossa sobrevivência pelo 'presente' delas."

# game/data/world_romance/ves/scr_6_Drunk.rpy:197
translate ptBR rom_Ves_6_Drunk_aef1c638:

    # VES @ talk "... I see."
    VES @ talk "... Entendo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:198
translate ptBR rom_Ves_6_Drunk_fec7b863:

    # "Ves sighed morosely."
    "Ves suspirou melancolicamente."

# game/data/world_romance/ves/scr_6_Drunk.rpy:199
translate ptBR rom_Ves_6_Drunk_6d6a4d50:

    # MC @ talk "... What is it?"
    MC @ talk "... O que foi?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:200
translate ptBR rom_Ves_6_Drunk_1c27f260:

    # VES @ talk "... Nothing."
    VES @ talk "... Nada."

# game/data/world_romance/ves/scr_6_Drunk.rpy:201
translate ptBR rom_Ves_6_Drunk_8d168b3c:

    # MC @ talk "No, something’s bothering you."
    MC @ talk "Não, há algo que se  está a incomodar."

# game/data/world_romance/ves/scr_6_Drunk.rpy:202
translate ptBR rom_Ves_6_Drunk_733c4389:

    # VES @ talk "I..."
    VES @ talk "Eu..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:203
translate ptBR rom_Ves_6_Drunk_3d13c0ad:

    # VES @ talk "Would like to have you for myself..."
    VES @ talk "Gostava de te ter só para mim..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:204
translate ptBR rom_Ves_6_Drunk_8418a966:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:205
translate ptBR rom_Ves_6_Drunk_025adeea:

    # VES @ talk "{i}Just{/i} for myself."
    VES @ talk "{i}Só{/i} para mim."

# game/data/world_romance/ves/scr_6_Drunk.rpy:206
translate ptBR rom_Ves_6_Drunk_9bbca015:

    # VES @ talk "But... I know this is probably not possible, is it?"
    VES @ talk "Mas... Sei que provavelmente não é possível, pois não?"

# game/data/world_romance/ves/scr_6_Drunk.rpy:207
translate ptBR rom_Ves_6_Drunk_83848d0a:

    # MC @ talk "It is... difficult."
    MC @ talk "É... difícil."

# game/data/world_romance/ves/scr_6_Drunk.rpy:208
translate ptBR rom_Ves_6_Drunk_f7250a82:

    # MC @ talk "When I was fully human, I could have—"
    MC @ talk "Quando era totalmente humano, podia ter—"

# game/data/world_romance/ves/scr_6_Drunk.rpy:209
translate ptBR rom_Ves_6_Drunk_b13cb8e5:

    # VES @ talk "No... It’s okay."
    VES @ talk "Não... Está tudo bem."

# game/data/world_romance/ves/scr_6_Drunk.rpy:210
translate ptBR rom_Ves_6_Drunk_2b3bb5cd:

    # VES @ smile_talk "I am just happy to be with you."
    VES @ smile_talk "Estou só feliz por estar com você."

# game/data/world_romance/ves/scr_6_Drunk.rpy:211
translate ptBR rom_Ves_6_Drunk_8cfba628:

    # VES @ talk "... And grateful for the patience you have shown me."
    VES @ talk "... E grata pela paciência que tem mostrado comigo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:212
translate ptBR rom_Ves_6_Drunk_fe794908:

    # "Gently, I caressed Ves’ face with my hand, she leaned forward to press another kiss onto me."
    "Gentilmente, acariciei o rosto de Ves com minha mão, ela se inclinou para frente para me dar outro beijo."

# game/data/world_romance/ves/scr_6_Drunk.rpy:213
translate ptBR rom_Ves_6_Drunk_257b57b9:

    # VES @ smile_talk "... Goodnight, [player_name!t]."
    VES @ smile_talk "... Boa noite, [player_name!t]."

# game/data/world_romance/ves/scr_6_Drunk.rpy:214
translate ptBR rom_Ves_6_Drunk_a0f70b38:

    # MC @ smile "Hey! You said my name!"
    MC @ smile "Ei! Disseste o meu nome!"

# game/data/world_romance/ves/scr_6_Drunk.rpy:215
translate ptBR rom_Ves_6_Drunk_e23ae25b:

    # VES @ talk "{i}*Grumbles*{/i}"
    VES @ talk "{i}*Resmungos*{/i}"

# game/data/world_romance/ves/scr_6_Drunk.rpy:216
translate ptBR rom_Ves_6_Drunk_8418a966_1:

    # MC @ talk "..."
    MC @ talk "..."

# game/data/world_romance/ves/scr_6_Drunk.rpy:218
translate ptBR rom_Ves_6_Drunk_5702411e:

    # MC @ talk "Goodnight, Ves..."
    MC @ talk "Boa noite, Ves..."

translate ptBR strings:

    # game/data/world_romance/ves/scr_6_Drunk.rpy:109
    old "It all began when I was born, everyone realised I was the most handsome man in all of Alderay."
    new "Tudo começou quando eu nasci, todos perceberam que eu era o homem mais bonito de toda Alderay."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:117
    old "Not much to say really... Most of your time growing up in Novaras is spent studying if you’re smart."
    new "Não há muito a dizer na verdade... A maior parte do seu tempo crescendo em Novaras é gasto estudando se você for inteligente."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:160
    old "I’d prefer dying old and grey with my family around me."
    new "Prefiro morrer velho e grisalho com minha família ao meu redor."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:168
    old "I dunno, dying in a brothel sounds like a lot more fun."
    new "Sei lá, morrer em um bordel soa muito mais divertido."

    # game/data/world_romance/ves/scr_6_Drunk.rpy:188
    old "I suppose you’re right..."
    new "Suponho que você está certa..."

