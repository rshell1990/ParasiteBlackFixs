translate ptPT dialogue_arwen_othergirls_menu_bcc3804b:

    # ARWEN @ talk "What do you want to know?"
    ARWEN @ talk "O que você quer saber?"

# game/data/characters/arwen/scr_dialogue.rpy:11
translate ptPT dialogue_arwen_othergirls_menu_f72c231a:

    # ARWEN @ talk "Well... Now you're speaking a girls favourite language!"
    ARWEN @ talk "Bem... Agora você está falando a língua favorita de uma garota!"

# game/data/characters/arwen/scr_dialogue.rpy:13
translate ptPT dialogue_arwen_othergirls_menu_ab602309:

    # ARWEN @ talk "Was there someone specific you wanted to ask about?"
    ARWEN @ talk "Tinha alguém específico sobre quem você queria perguntar?"

# game/data/characters/arwen/scr_dialogue.rpy:16
translate ptPT dialogue_arwen_othergirls_menu_paid_5c4b33c4:

    # ARWEN @ angry "Hm? Oh, {i}her{/i} I'd avoid her if I was you."
    ARWEN @ angry "Hm? Ah, {i}ela{/i} eu evitaria se fosse você."

# game/data/characters/arwen/scr_dialogue.rpy:17
translate ptPT dialogue_arwen_othergirls_menu_paid_d42b7565:

    # ARWEN @ angry "Overpriced to put it mildly, you'd think she was a virgin princess with how highly she views herself."
    ARWEN @ angry "Caríssima, para dizer o mínimo, você pensaria que ela é uma princesa virgem, do jeito que ela se acha."

# game/data/characters/arwen/scr_dialogue.rpy:18
translate ptPT dialogue_arwen_othergirls_menu_paid_1950d15a:

    # ARWEN @ blush "Don't worry though, I'll show you what a {i}real{/i} woman can do."
    ARWEN @ blush "Mas não se preocupe, eu vou te mostrar o que uma mulher {i}de verdade{/i} pode fazer."

# game/data/characters/arwen/scr_dialogue.rpy:21
translate ptPT dialogue_arwen_othergirls_menu_paid_77c1d01c:

    # ARWEN @ think "Hmm, nice enough girl."
    ARWEN @ think "Hmm, garota bastante simpática."

# game/data/characters/arwen/scr_dialogue.rpy:22
translate ptPT dialogue_arwen_othergirls_menu_paid_879dd5c5:

    # ARWEN @ talk "But I think she's a little {i}too{/i} desperate to work in here."
    ARWEN @ talk "Mas acho que ela está um pouco {i}demais{/i} desesperada para trabalhar aqui."

# game/data/characters/arwen/scr_dialogue.rpy:23
translate ptPT dialogue_arwen_othergirls_menu_paid_35cb4a19:

    # ARWEN @ talk "As far as I know, they let her stay and serve clients outside for a reduced rate, but I doubt she'll get through the door."
    ARWEN @ talk "Pelo que sei, deixaram ela ficar e atender clientes do lado de fora por um preço reduzido, mas duvido que ela consiga entrar."

# game/data/characters/arwen/scr_dialogue.rpy:24
translate ptPT dialogue_arwen_othergirls_menu_paid_da22f4ce:

    # MC @ talk "Why's that?"
    MC @ talk "Por quê?"

# game/data/characters/arwen/scr_dialogue.rpy:25
translate ptPT dialogue_arwen_othergirls_menu_paid_8e2a16c2:

    # ARWEN @ talk "Look around you, we're not the {i}Black Diamond,{/i} we general serve adventurers and merchants with coin to burn."
    ARWEN @ talk "Olhe ao seu redor, não somos o {i}Black Diamond,{/i} geralmente atendemos aventureiros e mercadores com dinheiro sobrando."

# game/data/characters/arwen/scr_dialogue.rpy:26
translate ptPT dialogue_arwen_othergirls_menu_paid_e4fcf857:

    # ARWEN @ talk "And she's out there letting the city guard take put it in her ass behind a wall... Hardly a good fit."
    ARWEN @ talk "E ela está lá fora deixando a guarda da cidade meter no rabo dela atrás de um muro... Dificilmente se encaixa."

# game/data/characters/arwen/scr_dialogue.rpy:27
translate ptPT dialogue_arwen_othergirls_menu_paid_33eafac5:

    # MC @ talk "That seems rather harsh..."
    MC @ talk "Isso parece bastante severo..."

# game/data/characters/arwen/scr_dialogue.rpy:28
translate ptPT dialogue_arwen_othergirls_menu_paid_8c61c9e1:

    # ARWEN @ talk "It's just business darling... it's always cut-throat, no matter the trade."
    ARWEN @ talk "É apenas negócios, querida... é sempre impiedoso, não importa o ramo."

# game/data/characters/arwen/scr_dialogue.rpy:31
translate ptPT dialogue_arwen_othergirls_menu_paid_480f5c90:

    # ARWEN @ talk "Alright then, was there something else?"
    ARWEN @ talk "Muito bem, tem mais alguma coisa?"

# game/data/characters/arwen/scr_dialogue.rpy:34
translate ptPT dialogue_arwen_othergirls_menu_paid_7417b5c7:

    # ARWEN @ talk "Alright then, let's hear it."
    ARWEN @ talk "Muito bem, então pode falar."

