# game/data/characters/luna/dialogue_luna.rpy:20
translate ptPT luna_talk_fe2ebf70:

    # LUNA @ smile "Hello! May I help you with something?"
    LUNA @ smile "Olá! Posso ajudá-lo com algo?"

# game/data/characters/luna/dialogue_luna.rpy:25
translate ptPT luna_bye_e42febf0:

    # LUNA "See you around!"
    LUNA "Até mais!"

# game/data/characters/luna/dialogue_luna.rpy:30
translate ptPT luna_talk_cantgothere_58ea8463:

    # LUNA "Hey! You can't just walk in there."
    LUNA "Ei! Você não pode simplesmente entrar aí."

# game/data/characters/luna/dialogue_luna.rpy:35
translate ptPT luna_use_baths_03aa7676:

    # LUNA @ smile "Certainly!"
    LUNA @ smile "Certamente!"

# game/data/characters/luna/dialogue_luna.rpy:36
translate ptPT luna_use_baths_2f547f8a:

    # LUNA @ smile "For you and your companions that'll be two hundred and fifty coins."
    LUNA @ smile "Para você e seus companheiros, serão duzentas e cinquenta moedas."

# game/data/characters/luna/dialogue_luna.rpy:42
translate ptPT luna_use_baths_c0c26f2f:

    # LUNA @ talk "Okay then, should you make the decision, the {i}Princess' Dream{/i} is always ready to recieve guests."
    LUNA @ talk "Ok então, caso você tome a decisão, o {i}Sonho da Princesa{/i} está sempre pronto para receber hóspedes."

# game/data/characters/luna/dialogue_luna.rpy:48
translate ptPT luna_questions_9469500d:

    # LUNA @ talk "Hm? Questions?"
    LUNA @ talk "Hm? Perguntas?"

# game/data/characters/luna/dialogue_luna.rpy:49
translate ptPT luna_questions_46ef7612:

    # LUNA @ talk "What do you want to know?"
    LUNA @ talk "O que você quer saber?"

# game/data/characters/luna/dialogue_luna.rpy:52
translate ptPT luna_questions_menu_71d4ef92:

    # LUNA @ talk "Ahh..."
    LUNA @ talk "Ahh..."

# game/data/characters/luna/dialogue_luna.rpy:53
translate ptPT luna_questions_menu_64ef36ae:

    # LUNA @ talk "My husband was sea captain of a small merchant vessel."
    LUNA @ talk "Meu marido era o capitão de um pequeno navio mercante."

# game/data/characters/luna/dialogue_luna.rpy:54
translate ptPT luna_questions_menu_2b407674:

    # LUNA @ talk "The coin was good, but the months at sea were long."
    LUNA @ talk "A moeda era boa, mas os meses no mar eram longos."

# game/data/characters/luna/dialogue_luna.rpy:55
translate ptPT luna_questions_menu_c067ca27:

    # LUNA @ think "That's why we saved up what money we could,"
    LUNA @ think "Por isso juntamos o dinheiro que pudemos,"

# game/data/characters/luna/dialogue_luna.rpy:56
translate ptPT luna_questions_menu_7c370a02:

    # MC @ talk "He planned to retire and have us open up a store."
    MC @ talk "Ele planejava se aposentar e nos fazer abrir uma loja."

# game/data/characters/luna/dialogue_luna.rpy:57
translate ptPT luna_questions_menu_51681a50:

    # LUNA @ sad "That is... until his ship was taken by a storm."
    LUNA @ sad "Isso foi... até que seu navio foi tomado por uma tempestade."

# game/data/characters/luna/dialogue_luna.rpy:58
translate ptPT luna_questions_menu_234263d1:

    # MC @ sad "I am sorry to hear that."
    MC @ sad "Lamento ouvir isso."

# game/data/characters/luna/dialogue_luna.rpy:59
translate ptPT luna_questions_menu_02f03353:

    # LUNA @ sad "It's alright, it was a long time ago now."
    LUNA @ sad "Está tudo bem, já foi há muito tempo."

# game/data/characters/luna/dialogue_luna.rpy:60
translate ptPT luna_questions_menu_e8411806:

    # LUNA @ sad "It's... easier to talk about now."
    LUNA @ sad "É... mais fácil falar sobre isso agora."

# game/data/characters/luna/dialogue_luna.rpy:61
translate ptPT luna_questions_menu_b6df5634:

    # LUNA @ think "Anyway, after my husband died, I was left with the coin we had managed to save up."
    LUNA @ think "De qualquer forma, depois que meu marido morreu, fiquei com a moeda que conseguimos juntar."

# game/data/characters/luna/dialogue_luna.rpy:62
translate ptPT luna_questions_menu_465a393c:

    # LUNA @ smile "I thought, well, no point running off with my tail between my leg."
    LUNA @ smile "Pensei, bem, não adianta fugir com o rabo entre as pernas."

# game/data/characters/luna/dialogue_luna.rpy:63
translate ptPT luna_questions_menu_34b15857:

    # LUNA @ smile "So, I looked around, and decided instead of a store,"
    LUNA @ smile "Então, dei uma olhada ao redor e decidi que, em vez de uma loja,"

# game/data/characters/luna/dialogue_luna.rpy:64
translate ptPT luna_questions_menu_e4722a60:

    # LUNA @ smile "A bathhouse sounded more fun to run."
    LUNA @ smile "Administrar uma casa de banho soava mais divertido."

# game/data/characters/luna/dialogue_luna.rpy:65
translate ptPT luna_questions_menu_661169f5:

    # LUNA @ smile "Heh... Plus I get a warm bath whenever I want now."
    LUNA @ smile "Heh... Além disso, agora posso tomar um banho quente quando quiser."

# game/data/characters/luna/dialogue_luna.rpy:66
translate ptPT luna_questions_menu_8a3ca43c:

    # LUNA @ talk "Hope that answers your question."
    LUNA @ talk "Espero que isso responda à sua pergunta."

# game/data/characters/luna/dialogue_luna.rpy:69
translate ptPT luna_questions_menu_94fb1e89:

    # LUNA @ talk "There's not many other places for a katai to start a business."
    LUNA @ talk "Não há muitos outros lugares para um katai começar um negócio."

# game/data/characters/luna/dialogue_luna.rpy:70
translate ptPT luna_questions_menu_bde6c2b6:

    # MC @ think "What?"
    MC @ think "O quê?"

# game/data/characters/luna/dialogue_luna.rpy:71
translate ptPT luna_questions_menu_86a14c5e:

    # MC @ think "It's illegal for a katai to own a businss in Novaras or something?"
    MC @ think "É ilegal para um katai ter um negócio em Novaras ou algo assim?"

# game/data/characters/luna/dialogue_luna.rpy:72
translate ptPT luna_questions_menu_23fd0367:

    # LUNA @ think "Not exactly."
    LUNA @ think "Não exatamente."

# game/data/characters/luna/dialogue_luna.rpy:73
translate ptPT luna_questions_menu_4b66451e:

    # LUNA @ sad "They just don't refuse to hand out any business licences."
    LUNA @ sad "Eles simplesmente não se recusam a conceder nenhuma licença comercial."

# game/data/characters/luna/dialogue_luna.rpy:74
translate ptPT luna_questions_menu_d4ac178e:

    # MC @ think "... None?"
    MC @ think "... Nenhuma?"

# game/data/characters/luna/dialogue_luna.rpy:75
translate ptPT luna_questions_menu_9432b0bb:

    # LUNA @ talk "Well, they either outright refuse to grant permits and licences,"
    LUNA @ talk "Bem, ou se recusam totalmente a conceder licenças e autorizações,"

# game/data/characters/luna/dialogue_luna.rpy:76
translate ptPT luna_questions_menu_9b87abaa:

    # LUNA @ talk "Or, they charge ludicrous rates that no one in their right mind would pay."
    LUNA @ talk "Ou cobram taxas ridículas que ninguém em sã consciência pagaria."

# game/data/characters/luna/dialogue_luna.rpy:77
translate ptPT luna_questions_menu_f068c751:

    # LUNA @ talk "Sometimes as high as five times as much the asking price of a normal human."
    LUNA @ talk "Às vezes, até cinco vezes o preço pedido por um humano normal."

# game/data/characters/luna/dialogue_luna.rpy:78
translate ptPT luna_questions_menu_5fae091a:

    # LUNA @ sad "They tolerate some of the more powerful merchants when it comes to trade."
    LUNA @ sad "Eles toleram alguns dos mercadores mais poderosos quando se trata de comércio."

# game/data/characters/luna/dialogue_luna.rpy:79
translate ptPT luna_questions_menu_8866674a:

    # LUNA @ sad "For the rest of us though?"
    LUNA @ sad "Mas para o resto de nós?"

# game/data/characters/luna/dialogue_luna.rpy:80
translate ptPT luna_questions_menu_9b6f6a12:

    # LUNA @ sad "They're only interested in hiring us katai as either servants or whores."
    LUNA @ sad "Eles só estão interessados em nos contratar, katai, como servos ou prostitutas."

# game/data/characters/luna/dialogue_luna.rpy:81
translate ptPT luna_questions_menu_209bb546:

    # MC @ talk "So that's why katai come here instead?"
    MC @ talk "Então é por isso que os katai vêm aqui em vez disso?"

# game/data/characters/luna/dialogue_luna.rpy:82
translate ptPT luna_questions_menu_6a433e62:

    # LUNA @ talk "As dangerous as the free city is, it's {i}free.{/i}"
    LUNA @ talk "Por mais perigosa que seja a cidade livre, ela é {i}livre{/i}."

# game/data/characters/luna/dialogue_luna.rpy:83
translate ptPT luna_questions_menu_804b4e81:

    # LUNA @ talk "At least here, we can etch out a life for ourselves."
    LUNA @ talk "Pelo menos aqui, podemos esculpir uma vida para nós mesmos."

# game/data/characters/luna/dialogue_luna.rpy:86
translate ptPT luna_questions_menu_393b14e5:

    # LUNA @ talk "Alright then."
    LUNA @ talk "Muito bem, então."

translate ptPT strings:

    # game/data/characters/luna/dialogue_luna.rpy:8
    old "Talk to Luna"
    new "Falar com Luna"

    # game/data/characters/luna/dialogue_luna.rpy:14
    old "I have a few questions."
    new "Eu tenho algumas perguntas."

    # game/data/characters/luna/dialogue_luna.rpy:15
    old "I'd like to use your baths."
    new "Eu gostaria de usar seus banhos."

    # game/data/characters/luna/dialogue_luna.rpy:16
    old "Bye."
    new "Tchau."

    # game/data/characters/luna/dialogue_luna.rpy:38
    old "Here you go"
    new "Aqui está."

    # game/data/characters/luna/dialogue_luna.rpy:51
    old "How does a katai end up running a bathhouse in Hamun?"
    new "Como um katai acaba administrando uma casa de banhos em Hamun?"

    # game/data/characters/luna/dialogue_luna.rpy:68
    old "I see a lot of katai around Hamun... How come?"
    new "Vejo muitos katai por Hamun... Por quê?"

    # game/data/characters/luna/dialogue_luna.rpy:85
    old "That's all I wanted to ask."
    new "Isso é tudo que eu queria perguntar."

