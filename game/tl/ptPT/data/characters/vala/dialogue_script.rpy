# game/data/characters/vala/dialogue_script.rpy:4
translate ptPT nov_vala_scr_firstmeet_1c716be8:

    # "As I stepped into the Library, I was greeted by the sudden warmth as I stepped through the door, the fire going as musky books laid scattered around on various tables."
    "Ao entrar na Biblioteca, fui recebido por um calor repentino ao cruzar a porta, o fogo aceso e livros com cheiro de mofo espalhados sobre várias mesas."

# game/data/characters/vala/dialogue_script.rpy:5
translate ptPT nov_vala_scr_firstmeet_9b7620e7:

    # MC @ talk "Hello? Is anyone here?"
    MC @ talk "Olá? Tem alguém aqui?"

# game/data/characters/vala/dialogue_script.rpy:6
translate ptPT nov_vala_scr_firstmeet_1e9e0401:

    # VALA "Just a minute!"
    VALA "Só um minuto!"

# game/data/characters/vala/dialogue_script.rpy:7
translate ptPT nov_vala_scr_firstmeet_b7a4fdc6:

    # "Peering around, I noticed a blonde girl high up on some ladder, putting away a few old books they she slides back into place."
    "Olhando ao redor, notei uma garota loira no alto de uma escada, guardando alguns livros antigos que ela desliza de volta ao lugar."

# game/data/characters/vala/dialogue_script.rpy:9
translate ptPT nov_vala_scr_firstmeet_3ed51ef9:

    # "Reaching onto her tip toes, the girl out-stretched her arms as she tried to reach the bookshelf, and her skirt begin to hike up, revealing the soft panties she wore beneath."
    "Ficando na ponta dos pés, a garota esticou os braços enquanto tentava alcançar a prateleira, e sua saia começou a subir, revelando a calcinha macia que usava por baixo."

# game/data/characters/vala/dialogue_script.rpy:11
translate ptPT nov_vala_scr_firstmeet_7a78c0c0:

    # VALA "Just... a little more!"
    VALA "Só... mais um pouco!"

# game/data/characters/vala/dialogue_script.rpy:13
translate ptPT nov_vala_scr_firstmeet_2ab10cd7:

    # MC @ talk "Are you okay up there? That ladder looks a little... {i}old.{/i}"
    MC @ talk "Você está bem aí em cima? Essa escada parece um pouco... {i}velha.{/i}"

# game/data/characters/vala/dialogue_script.rpy:14
translate ptPT nov_vala_scr_firstmeet_4cc79bf2:

    # VALA "I’ll be fine! We’re getting a new-"
    VALA "Vou ficar bem! Vamos comprar uma nova-"

# game/data/characters/vala/dialogue_script.rpy:15
translate ptPT nov_vala_scr_firstmeet_d2a7a758:

    # "Suddenly, the weak ladder snapped beneath her foot as the girl began falling down!"
    "De repente, a escada frágil quebrou sob o seu pé e a garota começou a cair!"

# game/data/characters/vala/dialogue_script.rpy:20
translate ptPT nov_vala_scr_firstmeet_e7b98bff:

    # VALA "AHHHHH!"
    VALA "AHHHHH!"

# game/data/characters/vala/dialogue_script.rpy:21
translate ptPT nov_vala_scr_firstmeet_061f8483:

    # "Running forward, I managed to catch the girl just in time with my agile reflexes, gently letting her down safely."
    "Correndo para a frente, consegui apanhar a rapariga mesmo a tempo com os meus reflexos ágeis, pousando-a suavemente em segurança."

# game/data/characters/vala/dialogue_script.rpy:24
translate ptPT nov_vala_scr_firstmeet_93bbef6a:

    # VALA "Phew...! Thank you for that!"
    VALA "Ufa...! Obrigada por isso!"

# game/data/characters/vala/dialogue_script.rpy:25
translate ptPT nov_vala_scr_firstmeet_9eb70956:

    # "Stood before me, I now finally had a good chance to look at the girl properly, she was short, with long blonde hair and spectacle glasses."
    "Parada diante de mim, finalmente tive uma boa oportunidade de olhar para a rapariga com atenção; ela era baixa, com cabelo longo e loiro e óculos."

# game/data/characters/vala/dialogue_script.rpy:27
translate ptPT nov_vala_scr_firstmeet_214f3a9e:

    # "Smiling cutely at me, I looked down to see the curves of her body and felt the tinge of the Parasite getting excited once again."
    "Sorriindo-me de forma fofa, olhei para baixo para ver as curvas do seu corpo e senti o toque do Parasita a ficar excitado mais uma vez."

# game/data/characters/vala/dialogue_script.rpy:28
translate ptPT nov_vala_scr_firstmeet_0a1deb0a:

    # MC @ talk "No problem."
    MC @ talk "Sem problema."

# game/data/characters/vala/dialogue_script.rpy:29
translate ptPT nov_vala_scr_firstmeet_9dcd4662:

    # "The girl outstretched her hand for it to be shaken."
    "A rapariga estendeu a mão para que a apertasse."

# game/data/characters/vala/dialogue_script.rpy:30
translate ptPT nov_vala_scr_firstmeet_16215314:

    # VALA "Vala Bluestone at your service!"
    VALA "Vala Bluestone ao seu dispor!"

# game/data/characters/vala/dialogue_script.rpy:32
translate ptPT nov_vala_scr_firstmeet_90781931:

    # "I reached out my hand to shake hers."
    "Estendi a mão para apertar a dela."

# game/data/characters/vala/dialogue_script.rpy:33
translate ptPT nov_vala_scr_firstmeet_6fa3a6ae:

    # MC @ talk "A pleasure to meet you Vala Bluestone, I am [player_name!t]."
    MC @ talk "Prazer em conhecê-la, Vala Bluestone. Sou [player_name!t]."

# game/data/characters/vala/dialogue_script.rpy:34
translate ptPT nov_vala_scr_firstmeet_ce593ffd:

    # VALA "So, what brings you here?"
    VALA "Então, o que a traz por aqui?"

# game/data/characters/vala/dialogue_script.rpy:35
translate ptPT nov_vala_scr_firstmeet_0ad6f9ca:

    # MC @ talk "I was perhaps hoping to read a book or two..."
    MC @ talk "Talvez eu estivesse esperando ler um livro ou dois..."

# game/data/characters/vala/dialogue_script.rpy:36
translate ptPT nov_vala_scr_firstmeet_c606f5f8:

    # VALA "Ah, well the library is free for all, and always open."
    VALA "Ah, bem, a biblioteca é gratuita para todos e está sempre aberta."

# game/data/characters/vala/dialogue_script.rpy:37
translate ptPT nov_vala_scr_firstmeet_f0e406e2:

    # VALA "Just remember, while we can put books in the hold for you to keep reading once you come back, we can’t allow you to take any of the books with you."
    VALA "Lembre-se, embora possamos colocar livros em espera para você continuar lendo quando voltar, não podemos permitir que você leve nenhum livro com você."

# game/data/characters/vala/dialogue_script.rpy:38
translate ptPT nov_vala_scr_firstmeet_7c81cc89:

    # "After so many students complained and asked for the library to be opened due to the ever-growing stress around studies, the education board agreed to give it extra funding to do so."
    "Depois que tantos alunos reclamaram e pediram para a biblioteca ser aberta devido ao estresse cada vez maior com os estudos, o conselho educacional concordou em fornecer financiamento extra para fazê-lo."

# game/data/characters/vala/dialogue_script.rpy:39
translate ptPT nov_vala_scr_firstmeet_c486209e:

    # "Me and Markus, albeit reluctantly, were forced to spend a fair few of our evenings here."
    "Eu e Markus, embora relutantemente, fomos forçados a passar uma boa parte de nossas noites aqui."

# game/data/characters/vala/dialogue_script.rpy:40
translate ptPT nov_vala_scr_firstmeet_ef9ee76e:

    # "How long ago that all seems now..."
    "Como tudo isso parece distante agora..."

# game/data/characters/vala/dialogue_script.rpy:41
translate ptPT nov_vala_scr_firstmeet_0d47b440:

    # VALA "Is something the matter?"
    VALA "Aconteceu algo?"

# game/data/characters/vala/dialogue_script.rpy:42
translate ptPT nov_vala_scr_firstmeet_bf61c54a:

    # MC @ talk "Hmm?"
    MC @ talk "Hmm?"

# game/data/characters/vala/dialogue_script.rpy:43
translate ptPT nov_vala_scr_firstmeet_c9952985:

    # VALA "You seemed... {i}lost in thought{/i} for a second there."
    VALA "Você parecia... {i}perdido em pensamentos{/i} por um segundo ali."

# game/data/characters/vala/dialogue_script.rpy:44
translate ptPT nov_vala_scr_firstmeet_d5717343:

    # MC @ talk "Oh, never mind."
    MC @ talk "Ah, deixa pra lá."

# game/data/characters/vala/dialogue_script.rpy:45
translate ptPT nov_vala_scr_firstmeet_67a9c63c:

    # MC @ talk "Just remembering some things, nothing important."
    MC @ talk "Só estava me lembrando de algumas coisas, nada importante."

# game/data/characters/vala/dialogue_script.rpy:46
translate ptPT nov_vala_scr_firstmeet_bf0e67a2:

    # VALA "Well, if you need anything, I’ll be around! Okay?"
    VALA "Bem, se precisar de alguma coisa, estarei por perto! Tudo bem?"

# game/data/characters/vala/dialogue_script.rpy:47
translate ptPT nov_vala_scr_firstmeet_830159c6:

    # MC @ talk "Sounds good."
    MC @ talk "Parece bom."

# game/data/characters/vala/dialogue_script.rpy:48
translate ptPT nov_vala_scr_firstmeet_618cb924:

    # "As Vala smiled and waved shyly, I watched her cute butt as she sauntered off to go grab more books."
    "Enquanto Vala sorria e acenava timidamente, observei sua bunda fofa enquanto ela se afastava tranquilamente para pegar mais livros."

# game/data/characters/vala/dialogue_script.rpy:51
translate ptPT nov_vala_scr_firstmeet_db0c26de:

    # BLACK "Her heartbeat raised when she saw you, and her hands began to sweat."
    BLACK "A batida do coração dela aumentou quando ela te viu, e suas mãos começaram a suar."

# game/data/characters/vala/dialogue_script.rpy:52
translate ptPT nov_vala_scr_firstmeet_a97dcc2e:

    # BLACK "With some commitment, she would be a willing and good mate."
    BLACK "Com um pouco de dedicação, ela seria uma parceira disposta e boa."

# game/data/characters/vala/dialogue_script.rpy:53
translate ptPT nov_vala_scr_firstmeet_7be498ca:

    # MC "Stop... I... "
    MC "Pare... Eu..."

# game/data/characters/vala/dialogue_script.rpy:54
translate ptPT nov_vala_scr_firstmeet_81498102:

    # "I shook my head to try push aside the dark thoughts."
    "Balancei a cabeça para tentar afastar os pensamentos sombrios."

# game/data/characters/vala/dialogue_script.rpy:55
translate ptPT nov_vala_scr_firstmeet_bd8e6530:

    # MC @ angry "We’re here to try and gather some information, not hunting for another ‘mate’"
    MC @ angry "Estamos aqui para tentar reunir informações, não para caçar outra 'parceira'."

# game/data/characters/vala/dialogue_script.rpy:56
translate ptPT nov_vala_scr_firstmeet_296d9d43:

    # BLACK "As you wish."
    BLACK "Como quiser."

# game/data/characters/vala/dialogue_script.rpy:57
translate ptPT nov_vala_scr_firstmeet_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Suspiro*{/i}"

# game/data/characters/vala/dialogue_script.rpy:58
translate ptPT nov_vala_scr_firstmeet_7c3d9a85:

    # "Now, where to start? This place is huge..."
    "Agora, por onde começar? Este lugar é enorme..."

