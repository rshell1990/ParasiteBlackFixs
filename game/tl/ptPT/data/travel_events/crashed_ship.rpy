# TODO: Translation updated at 2026-07-07 02:02

# game/data/travel_events/crashed_ship.rpy:13
translate ptPT travel_event_crashed_ship_c7f49737:

    # BLACK "{i}...Going wrong way.{/i}"
    BLACK "{i}...Indo pelo caminho errado.{/i}"

# game/data/travel_events/crashed_ship.rpy:15
translate ptPT travel_event_crashed_ship_73790772:

    # MC @ angry "We are not going the wrong way!"
    MC @ angry "Não estamos indo pelo caminho errado!"

# game/data/travel_events/crashed_ship.rpy:16
translate ptPT travel_event_crashed_ship_1cd0e33a:

    # BLACK "{i}We are lost.{/i}"
    BLACK "{i}Estamos perdidos.{/i}"

# game/data/travel_events/crashed_ship.rpy:17
translate ptPT travel_event_crashed_ship_71d2cf05:

    # MC @ angry "We are not lost!"
    MC @ angry "Não estamos perdidos!"

# game/data/travel_events/crashed_ship.rpy:19
translate ptPT travel_event_crashed_ship_66dfd255:

    # MC @ talk "We just—"
    MC @ talk "Nós só—"

# game/data/travel_events/crashed_ship.rpy:21
translate ptPT travel_event_crashed_ship_90844184:

    # MC @ talk "We just need to find our—"
    MC @ talk "Nós só precisamos encontrar nosso—"

# game/data/travel_events/crashed_ship.rpy:23
translate ptPT travel_event_crashed_ship_88b2ee55:

    # "Suddenly, I felt the earth crumble beneath me."
    "De repente, senti a terra desmoronar sob meus pés."

# game/data/travel_events/crashed_ship.rpy:26
translate ptPT travel_event_crashed_ship_934fef82:

    # "I gasped as I plummeted into a great chasm below."
    "Soltei um grito enquanto despencava em um grande abismo abaixo."

# game/data/travel_events/crashed_ship.rpy:28
translate ptPT travel_event_crashed_ship_a4b26b88:

    # "The fall lasted only moments, wind whipping past as panic surged through me."
    "A queda durou apenas alguns instantes, o vento chicoteando enquanto o pânico me invadia."

# game/data/travel_events/crashed_ship.rpy:29
translate ptPT travel_event_crashed_ship_b71673c2:

    # "One of my blackened tentacles shot out, anchoring into the wall and halting my descent."
    "Um dos meus tentáculos enegrecidos disparou, ancorando na parede e interrompendo minha queda."

# game/data/travel_events/crashed_ship.rpy:30
translate ptPT travel_event_crashed_ship_e352090c:

    # MARKUS @ shock "[player_name!t]!"
    MARKUS @ shock "[player_name!t]!"

# game/data/travel_events/crashed_ship.rpy:32
translate ptPT travel_event_crashed_ship_81a47010:

    # "Lowering myself carefully, I landed on a patch of dirt below, lit faintly by the chasm's natural opening."
    "Abaixando-me com cuidado, aterrei em um pedaço de terra abaixo, iluminado fracamente pela abertura natural do abismo."

# game/data/travel_events/crashed_ship.rpy:33
translate ptPT travel_event_crashed_ship_dda0aa4b:

    # MARKUS "Can you hear me?!"
    MARKUS "Você consegue me ouvir?!"

# game/data/travel_events/crashed_ship.rpy:34
translate ptPT travel_event_crashed_ship_354115c9:

    # MC @ talk "I'm alright."
    MC @ talk "Estou bem."

# game/data/travel_events/crashed_ship.rpy:35
translate ptPT travel_event_crashed_ship_6baba279:

    # "As my eyes adjusted, the full scale of the pit became clear."
    "Conforme meus olhos se ajustavam, a escala total do poço ficou clara."

# game/data/travel_events/crashed_ship.rpy:41
translate ptPT travel_event_crashed_ship_141d7189:

    # MC @ think "Is this... some kind of cave?"
    MC @ think "Isso é... algum tipo de caverna?"

# game/data/travel_events/crashed_ship.rpy:43
translate ptPT travel_event_crashed_ship_f02ac22b:

    # "There, partially submerged in shallow water, was something metallic—a ship?"
    "Ali, parcialmente submerso em águas rasas, havia algo metálico—uma nave?"

# game/data/travel_events/crashed_ship.rpy:44
translate ptPT travel_event_crashed_ship_e26d324c:

    # "Ruined and entangled in vines, the strange relic beckoned."
    "Arruinado e emaranhado em vinhas, a estranha relíquia acenava."

# game/data/travel_events/crashed_ship.rpy:45
translate ptPT travel_event_crashed_ship_b3c9f1a5:

    # MARKUS "What do you see down there?!"
    MARKUS "O que você vê lá embaixo?!"

# game/data/travel_events/crashed_ship.rpy:46
translate ptPT travel_event_crashed_ship_8ec5fa0b:

    # MC @ serious "You might want to come down here."
    MC @ serious "Você pode querer descer aqui."

# game/data/travel_events/crashed_ship.rpy:48
translate ptPT travel_event_crashed_ship_4001a4a4:

    # "The others climbed down with caution."
    "Os outros desceram com cautela."

# game/data/travel_events/crashed_ship.rpy:50
translate ptPT travel_event_crashed_ship_f5a0c50b:

    # MARKUS @ shock "What in seven hells is that thing?"
    MARKUS @ shock "Que diabos é essa coisa?"

# game/data/travel_events/crashed_ship.rpy:51
translate ptPT travel_event_crashed_ship_11bcc543:

    # MC @ think "Some kind of ship?"
    MC @ think "Algum tipo de navio?"

# game/data/travel_events/crashed_ship.rpy:52
translate ptPT travel_event_crashed_ship_539ee9fb:

    # MARKUS @ talk "Where are its sails?"
    MARKUS @ talk "Onde estão suas velas?"

# game/data/travel_events/crashed_ship.rpy:53
translate ptPT travel_event_crashed_ship_3dad54df:

    # MC @ think "Never seen a vessel like this... and this far from any sea?"
    MC @ think "Nunca vi um navio como este... e tão longe de qualquer mar?"

# game/data/travel_events/crashed_ship.rpy:57
translate ptPT travel_event_crashed_ship_0208f36a:

    # MYU @ scared "M-Myu? Metal thing scary..."
    MYU @ scared "M-Myu? Coisa de metal assustadora..."

# game/data/travel_events/crashed_ship.rpy:62
translate ptPT travel_event_crashed_ship_8138fa88:

    # VES @ think "I've heard rumors of the Greater Trading Company reinforcing ships with armor, but this..."
    VES @ think "Ouvi rumores de que a Grande Companhia de Comércio reforça navios com armaduras, mas isto..."

# game/data/travel_events/crashed_ship.rpy:63
translate ptPT travel_event_crashed_ship_e9cd7d09:

    # VES @ talk "This is nothing like anything I've ever seen."
    VES @ talk "Isto não se parece com nada que eu já tenha visto."

# game/data/travel_events/crashed_ship.rpy:68
translate ptPT travel_event_crashed_ship_ba8e8344:

    # ELENA @ grumpy "Perhaps... a relic of the old gods?"
    ELENA @ grumpy "Talvez... uma relíquia dos deuses antigos?"

# game/data/travel_events/crashed_ship.rpy:69
translate ptPT travel_event_crashed_ship_c90ffbe7:

    # ELENA @ grumpy "Judging by how deep this cavern is, it must've been buried here for thousands of years."
    ELENA @ grumpy "Pelo quão profunda esta caverna é, ela deve ter sido enterrada aqui por milhares de anos."

# game/data/travel_events/crashed_ship.rpy:75
translate ptPT travel_event_crashed_ship_985866dd:

    # SYPHA @ talk "{i}And so, in ages past, they rode mechanical beasts across the stars.{/i}"
    SYPHA @ talk "{i}E assim, em eras passadas, eles cavalgavam bestas mecânicas pelas estrelas.{/i}"

# game/data/travel_events/crashed_ship.rpy:76
translate ptPT travel_event_crashed_ship_bde6c2b6:

    # MC @ think "What?"
    MC @ think "O quê?"

# game/data/travel_events/crashed_ship.rpy:77
translate ptPT travel_event_crashed_ship_c24c1193:

    # SYPHA @ think "Nothing. Just old legends from childhood."
    SYPHA @ think "Nada. Apenas velhas lendas da infância."

# game/data/travel_events/crashed_ship.rpy:84
translate ptPT travel_event_crashed_ship_16bf6a3c:

    # MC @ serious "Whatever it is, I don't like it."
    MC @ serious "Seja o que for, não gosto disso."

# game/data/travel_events/crashed_ship.rpy:85
translate ptPT travel_event_crashed_ship_cfd774db:

    # MC @ talk "Let's leave sleeping ghosts to rest."
    MC @ talk "Vamos deixar os fantasmas adormecidos descansarem."

# game/data/travel_events/crashed_ship.rpy:86
translate ptPT travel_event_crashed_ship_516553f1:

    # MARKUS @ talk "Agreed. Nothing good comes from disturbing the dead."
    MARKUS @ talk "Concordo. Nada de bom vem de perturbar os mortos."

# game/data/travel_events/crashed_ship.rpy:88
translate ptPT travel_event_crashed_ship_013b3791:

    # "We climbed back out of the rift and resumed our journey."
    "Saímos da fenda e retomamos nossa jornada."

# game/data/travel_events/crashed_ship.rpy:95
translate ptPT travel_event_crashed_ship_inside_4a677239:

    # "Carefully, I approached the wreck."
    "Cuidadosamente, me aproximei dos destroços."

# game/data/travel_events/crashed_ship.rpy:96
translate ptPT travel_event_crashed_ship_inside_c1071274:

    # "I stepped into the freezing water and laid my hand on the cold metal hull."
    "Entrei na água gelada e coloquei a mão no casco de metal frio."

# game/data/travel_events/crashed_ship.rpy:99
translate ptPT travel_event_crashed_ship_inside_08beff35:

    # MARKUS @ shock "[player_name!t]! What are you doing?"
    MARKUS @ shock "[player_name!t]! O que você está fazendo?"

# game/data/travel_events/crashed_ship.rpy:101
translate ptPT travel_event_crashed_ship_inside_9ec1a37a:

    # "A hiss of steam sounded as the metal twisted open like a door."
    "Um chiado de vapor soou enquanto o metal se retorcia abrindo como uma porta."

# game/data/travel_events/crashed_ship.rpy:102
translate ptPT travel_event_crashed_ship_inside_79a0bb39:

    # MARKUS @ shock "You're not actually going inside that thing, are you?"
    MARKUS @ shock "Você não vai realmente entrar nessa coisa, vai?"

# game/data/travel_events/crashed_ship.rpy:103
translate ptPT travel_event_crashed_ship_inside_026bc247:

    # "I stepped in."
    "Eu entrei."

# game/data/travel_events/crashed_ship.rpy:104
translate ptPT travel_event_crashed_ship_inside_970d0f74:

    # MARKUS @ angry "Gods be damned, man."
    MARKUS @ angry "Malditos deuses, cara."

# game/data/travel_events/crashed_ship.rpy:109
translate ptPT travel_event_crashed_ship_inside_bc2341db:

    # "Inside, it was cold."
    "Lá dentro, estava frio."

# game/data/travel_events/crashed_ship.rpy:112
translate ptPT travel_event_crashed_ship_inside_4f0eba80:

    # "Our footsteps echoed across the metal floor."
    "Nossos passos ecoavam pelo chão de metal."

# game/data/travel_events/crashed_ship.rpy:113
translate ptPT travel_event_crashed_ship_inside_b2b6c7a4:

    # "Pipes snaked along the walls, choked in vines and pierced by jagged rock."
    "Canos serpenteavam pelas paredes, sufocados por vinhas e perfurados por rochas irregulares."

# game/data/travel_events/crashed_ship.rpy:118
translate ptPT travel_event_crashed_ship_inside_bd8053a5:

    # "A ghostly figure flickered into view inside a glowing circle."
    "Uma figura fantasmagórica piscou aparecendo dentro de um círculo brilhante."

# game/data/travel_events/crashed_ship.rpy:119
translate ptPT travel_event_crashed_ship_inside_472ec9d8:

    # MC @ angry "Who are you, specter?"
    MC @ angry "Quem é você, espectro?"

# game/data/travel_events/crashed_ship.rpy:120
translate ptPT travel_event_crashed_ship_inside_bf2aaff8:

    # ANDRAS "This is Captain Andras of the Maylark."
    ANDRAS "Este é o Capitão Andras do Maylark."

# game/data/travel_events/crashed_ship.rpy:121
translate ptPT travel_event_crashed_ship_inside_365bbf88:

    # ANDRAS "Day four-hundred and ninety-six since the end of... well, everything."
    ANDRAS "Dia quatrocentos e noventa e seis desde o fim de... bem, tudo."

# game/data/travel_events/crashed_ship.rpy:122
translate ptPT travel_event_crashed_ship_inside_bf38bc6e:

    # MARKUS @ think "Uhhh... hello?"
    MARKUS @ think "Uhhh... alô?"

# game/data/travel_events/crashed_ship.rpy:123
translate ptPT travel_event_crashed_ship_inside_18baf767:

    # MC @ think "I don't think he can hear us."
    MC @ think "Acho que ele não consegue nos ouvir."

# game/data/travel_events/crashed_ship.rpy:124
translate ptPT travel_event_crashed_ship_inside_b20d5e02:

    # ANDRAS "...{i}*Sigh*{/i} I don't even know why I bother with these things anymore."
    ANDRAS "...{i}*Suspiro*{/i} Eu nem sei por que ainda me dou ao trabalho com essas coisas."

# game/data/travel_events/crashed_ship.rpy:125
translate ptPT travel_event_crashed_ship_inside_96afb379:

    # ANDRAS "It's not like there's actually anyone left to log it."
    ANDRAS "Não é como se houvesse alguém para registrar isso."

# game/data/travel_events/crashed_ship.rpy:126
translate ptPT travel_event_crashed_ship_inside_62cfcc16:

    # ANDRAS "For over a year and a half we've jumped from one dead star to the next."
    ANDRAS "Por mais de um ano e meio, temos saltado de uma estrela morta para a seguinte."

# game/data/travel_events/crashed_ship.rpy:127
translate ptPT travel_event_crashed_ship_inside_881f07eb:

    # ANDRAS "One nightmarish, monster infested world to another, searching for someplace safe."
    ANDRAS "De um mundo infernal, infestado de monstros, para outro, procurando algum lugar seguro."

# game/data/travel_events/crashed_ship.rpy:128
translate ptPT travel_event_crashed_ship_inside_e84fa312:

    # ANDRAS "I still tell the crew that's what we're looking for... Someplace safe."
    ANDRAS "Eu ainda digo à tripulação que é isso que estamos procurando... Um lugar seguro."

# game/data/travel_events/crashed_ship.rpy:129
translate ptPT travel_event_crashed_ship_inside_ec95d44a:

    # ANDRAS "I'd just settle for finding some food, fuel... anything now."
    ANDRAS "Eu me contentaria em encontrar comida, combustível... qualquer coisa agora."

# game/data/travel_events/crashed_ship.rpy:130
translate ptPT travel_event_crashed_ship_inside_b3b6925c:

    # ANDRAS "It's been months since we found any survivors."
    ANDRAS "Faz meses que não encontramos nenhum sobrevivente."

# game/data/travel_events/crashed_ship.rpy:131
translate ptPT travel_event_crashed_ship_inside_9fb46d95:

    # ANDRAS "Well, unless you count the cannibals and freaks."
    ANDRAS "Bem, a menos que você conte os canibais e as aberrações."

# game/data/travel_events/crashed_ship.rpy:132
translate ptPT travel_event_crashed_ship_inside_89d8f69d:

    # ANDRAS "... We have enough fuel for one last try, some unknown world ready on the edge of the Zelma ring."
    ANDRAS "... Temos combustível suficiente para uma última tentativa, algum mundo desconhecido à beira do anel de Zelma."

# game/data/travel_events/crashed_ship.rpy:133
translate ptPT travel_event_crashed_ship_inside_5b2a8029:

    # ANDRAS "Atmospheric readings look good from orbit, and there seems to be no visual signs of corruption."
    ANDRAS "As leituras atmosféricas parecem boas da órbita, e parece não haver sinais visuais de corrupção."

# game/data/travel_events/crashed_ship.rpy:134
translate ptPT travel_event_crashed_ship_inside_8cd54f27:

    # ANDRAS "We'll probably stall out on the landing, but hopefully with power routed to the shields, we can at least survive the crash."
    ANDRAS "Provavelmente vamos parar na aterragem, mas com sorte, com energia direcionada para os escudos, podemos pelo menos sobreviver à queda."

# game/data/travel_events/crashed_ship.rpy:135
translate ptPT travel_event_crashed_ship_inside_bfea744e:

    # ANDRAS "May the new gods... Ahhh, fuck it."
    ANDRAS "Que os novos deuses... Ahhh, que se dane."

# game/data/travel_events/crashed_ship.rpy:136
translate ptPT travel_event_crashed_ship_inside_737f7819:

    # ANDRAS "{i}It's not like they're listening anymore anyway.{/i}"
    ANDRAS "{i}Não é como se eles estivessem ouvindo mais, de qualquer forma.{/i}"

# game/data/travel_events/crashed_ship.rpy:137
translate ptPT travel_event_crashed_ship_inside_9e72f391:

    # "There was momentary flickering of the strange figure summoned."
    "Houve um tremeluzir momentâneo da figura estranha invocada."

# game/data/travel_events/crashed_ship.rpy:138
translate ptPT travel_event_crashed_ship_inside_0742b26c:

    # ANDRAS "Day, five hundred and two."
    ANDRAS "Dia, quinhentos e dois."

# game/data/travel_events/crashed_ship.rpy:139
translate ptPT travel_event_crashed_ship_inside_ce1c3d26:

    # ANDRAS "We survived the landing, but the ship's hull is too badly damaged to repair."
    ANDRAS "Sobrevivemos à aterragem, mas o casco da nave está muito danificado para ser reparado."

# game/data/travel_events/crashed_ship.rpy:140
translate ptPT travel_event_crashed_ship_inside_7ca46618:

    # ANDRAS "{i}*Chuckles*{/i} Not that we have to fuel left to go anywhere anyway."
    ANDRAS "{i}*Risos*{/i} Não que tenhamos combustível sobrando para ir a qualquer lugar, de qualquer forma."

# game/data/travel_events/crashed_ship.rpy:141
translate ptPT travel_event_crashed_ship_inside_ece942c3:

    # ANDRAS "The crew and I have decided to salvage what we can from the ship and head out."
    ANDRAS "A tripulação e eu decidimos resgatar o que pudermos do navio e partir."

# game/data/travel_events/crashed_ship.rpy:142
translate ptPT travel_event_crashed_ship_inside_7d01dea4:

    # ANDRAS "Maybe we can etch out some kind of existence out here."
    ANDRAS "Talvez possamos esculpir algum tipo de existência aqui fora."

# game/data/travel_events/crashed_ship.rpy:143
translate ptPT travel_event_crashed_ship_inside_9c0c2393:

    # ANDRAS "It might be a simple life... {i}But at least we're alive.{/i}"
    ANDRAS "Pode ser uma vida simples... {i}Mas pelo menos estamos vivos.{/i}"

# game/data/travel_events/crashed_ship.rpy:144
translate ptPT travel_event_crashed_ship_inside_2d52d85d:

    # ANDRAS "... The gods."
    ANDRAS "... Os deuses."

# game/data/travel_events/crashed_ship.rpy:145
translate ptPT travel_event_crashed_ship_inside_6c5751a7:

    # ANDRAS "How the fuck did it come to this?"
    ANDRAS "Como diabos chegamos a isso?"

# game/data/travel_events/crashed_ship.rpy:146
translate ptPT travel_event_crashed_ship_inside_94c58f75:

    # ANDRAS "We blame it all on Malakai and his damned war, but in the end, maybe it was just our blind faith that sealed our fates."
    ANDRAS "Culpamos tudo em Malakai e sua maldita guerra, mas no final, talvez tenha sido apenas nossa fé cega que selou nossos destinos."

# game/data/travel_events/crashed_ship.rpy:147
translate ptPT travel_event_crashed_ship_inside_2820ff0b:

    # ANDRAS "We always presumed the gods were better than us, wiser, {i}more{/i} than us."
    ANDRAS "Sempre presumimos que os deuses eram melhores que nós, mais sábios, {i}mais{/i} que nós."

# game/data/travel_events/crashed_ship.rpy:148
translate ptPT travel_event_crashed_ship_inside_b9ea5e3e:

    # ANDRAS "{i}But in the end, they fell to all the same trappings we do.{/i}"
    ANDRAS "{i}Mas no final, eles caíram nas mesmas armadilhas que nós.{/i}"

# game/data/travel_events/crashed_ship.rpy:149
translate ptPT travel_event_crashed_ship_inside_e5b270d3:

    # ANDRAS "{i}And they dragged everyone down with them.{/i}"
    ANDRAS "{i}E eles arrastaram todos para baixo com eles.{/i}"

# game/data/travel_events/crashed_ship.rpy:150
translate ptPT travel_event_crashed_ship_inside_8a41f029:

    # ANDRAS "... Fuck the gods."
    ANDRAS "... Foda-se os deuses."

# game/data/travel_events/crashed_ship.rpy:151
translate ptPT travel_event_crashed_ship_inside_1216340c:

    # ANDRAS "This is Captain Andras of the Maylark, signing off for the last time."
    ANDRAS "Aqui é o Capitão Andras da Maylark, encerrando pela última vez."

# game/data/travel_events/crashed_ship.rpy:152
translate ptPT travel_event_crashed_ship_inside_10ce0df8:

    # "The image flickered, then began replaying."
    "A imagem tremeu e começou a repetir."

# game/data/travel_events/crashed_ship.rpy:155
translate ptPT travel_event_crashed_ship_inside_9d9f6087:

    # MC @ think "What do you make of that?"
    MC @ think "O que você acha disso?"

# game/data/travel_events/crashed_ship.rpy:157
translate ptPT travel_event_crashed_ship_inside_df5f47d2:

    # MARKUS @ talk "Jumping stars... Malakai's war... If this is from the Second War of the Gods... it's ancient."
    MARKUS @ talk "Estrelas saltitantes... a guerra de Malakai... Se isso é da Segunda Guerra dos Deuses... é antigo."

# game/data/travel_events/crashed_ship.rpy:161
translate ptPT travel_event_crashed_ship_inside_ad56e14d:

    # SYPHA @ talk "We shouldn't linger."
    SYPHA @ talk "Não devemos demorar."

# game/data/travel_events/crashed_ship.rpy:162
translate ptPT travel_event_crashed_ship_inside_613528ce:

    # SYPHA @ think "Let ghosts rest."
    SYPHA @ think "Deixe os fantasmas descansarem."

# game/data/travel_events/crashed_ship.rpy:171
translate ptPT travel_event_crashed_ship_inside_17813b31:

    # "Most of it had decayed."
    "A maior parte havia se deteriorado."

# game/data/travel_events/crashed_ship.rpy:172
translate ptPT travel_event_crashed_ship_inside_1bcd7585:

    # "Anything that once had purpose crumbled in my hands."
    "Qualquer coisa que antes tinha propósito se desfez em minhas mãos."

# game/data/travel_events/crashed_ship.rpy:173
translate ptPT travel_event_crashed_ship_inside_e4d9e770:

    # "Except... one thing."
    "Exceto... uma coisa."

# game/data/travel_events/crashed_ship.rpy:174
translate ptPT travel_event_crashed_ship_inside_d79ab9c3:

    # "A small metal box."
    "Uma pequena caixa de metal."

# game/data/travel_events/crashed_ship.rpy:175
translate ptPT travel_event_crashed_ship_inside_4b38b6fa:

    # "Inside, a glowing blue crystal pulsed rhythmically."
    "Lá dentro, um cristal azul brilhante pulsava ritmicamente."

# game/data/travel_events/crashed_ship.rpy:179
translate ptPT travel_event_crashed_ship_inside_50da1bb3:

    # "I reached in and took the orb."
    "Estendi a mão e peguei o orbe."

# game/data/travel_events/crashed_ship.rpy:180
translate ptPT travel_event_crashed_ship_inside_1343b6dc:

    # "It detached easily from its cables."
    "Ele se soltou facilmente dos cabos."

# game/data/travel_events/crashed_ship.rpy:181
translate ptPT travel_event_crashed_ship_inside_1797a4db:

    # "As I did, the specter's loop stopped."
