# TODO: Translation updated at 2026-07-07 02:02

# game/data/travel_events/raider.rpy:3
translate ptPT travel_event_raider_40da6313:

    # "While making my way along the roads, I suddenly had the strangest sense something was wrong..."
    "Enquanto seguia pelas estradas, de repente tive a sensação mais estranha de que algo estava errado..."

# game/data/travel_events/raider.rpy:4
translate ptPT travel_event_raider_f79e4a26:

    # BLACK "({i}Enemies ... all around us{/i})."
    BLACK "({i}Inimigos ... ao nosso redor{/i})."

# game/data/travel_events/raider.rpy:6
translate ptPT travel_event_raider_00d7c7b1:

    # "A flying arrow suddenly landed itself at my foot, barely missing me as I drew my blade."
    "Uma flecha voadora de repente caiu bem aos meus pés, mal me errando enquanto eu sacava minha lâmina."

# game/data/travel_events/raider.rpy:7
translate ptPT travel_event_raider_c17db1ef:

    # "From out of their hiding spots, charged the group of bandits!"
    "De seus esconderijos, investiu o grupo de bandidos!"

# game/data/travel_events/raider.rpy:10
translate ptPT travel_event_raider_e51b4a2a:

    # MC "(Shit!)"
    MC "(Merda!)"

# game/data/travel_events/raider.rpy:11
translate ptPT travel_event_raider_a511df2a:

    # BANDIT "Give us everything you've got or we'll pry it from your dead fucking hands!"
    BANDIT "Nos dê tudo que você tem ou vamos arrancá-lo das suas mãos mortas, caralho!"

# game/data/travel_events/raider.rpy:15
translate ptPT travel_event_raider_d06ec560:

    # BANDIT "Let's make this easy now, give us your-"
    BANDIT "Vamos facilitar isso agora, nos dê o seu-"

# game/data/travel_events/raider.rpy:16
translate ptPT travel_event_raider_8742b282:

    # "Suddenly, the bandit was toppled over in a flash, screaming as a wild wolf tore at his throat."
    "De repente, o bandido foi derrubado num instante, gritando enquanto um lobo selvagem dilacerava sua garganta."

# game/data/travel_events/raider.rpy:17
translate ptPT travel_event_raider_00d4941a:

    # BANDIT "AHHHHHHRGHHHH! GET IT OFF ME! GET IT FUCKING-"
    BANDIT "AHHHHHHRGHHHH! TIRE ISSO DE MIM! TIRE ISSO, PORRA-"

# game/data/travel_events/raider.rpy:18
translate ptPT travel_event_raider_6565ed17:

    # "Silence, choking on his blood as he clutched at his torn-out throat, the other bandits panicked as they desperately tried to either run away or rush over."
    "Silêncio, engasgando com o próprio sangue ao agarrar a garganta dilacerada, os outros bandidos entraram em pânico e tentaram desesperadamente ou fugir ou correr para ajudar."

# game/data/travel_events/raider.rpy:19
translate ptPT travel_event_raider_cd79a6fc:

    # "One by one, in quick succession, they were pulled and dragged down by the wolves who sprung out from the tall grass, howling with delight as they pressed their fangs into the warm blood and flesh."
    "Um por um, em rápida sucessão, foram puxados e arrastados para baixo pelos lobos que saltaram da grama alta, uivando de prazer enquanto pressionavam suas presas no sangue quente e na carne."

# game/data/travel_events/raider.rpy:21
translate ptPT travel_event_raider_dfaa6aa7:

    # "My heart racing, I held my hand on the hilt of my blade, ready to draw it, when I felt Elena's hand on my shoulder."
    "Com o coração acelerado, eu segurava a mão no punhal da minha lâmina, pronto para sacá-la, quando senti a mão de Elena no meu ombro."

# game/data/travel_events/raider.rpy:22
translate ptPT travel_event_raider_4aebc8b2:

    # ELENA "Keep your blade sheathed."
    ELENA "Mantenha sua lâmina embainhada."

# game/data/travel_events/raider.rpy:23
translate ptPT travel_event_raider_10f7686b:

    # ELENA "They're letting us pass..."
    ELENA "Eles estão nos deixando passar..."

# game/data/travel_events/raider.rpy:24
translate ptPT travel_event_raider_7cb86101:

    # "The leader of the pack looked up towards us, mouth covered in blood and panting."
    "O líder da matilha olhou para nós, a boca coberta de sangue e ofegante."

# game/data/travel_events/raider.rpy:25
translate ptPT travel_event_raider_f4b78898:

    # "He barked happily, before tucking back into his {i}'meal.'{/i}"
    "Ele latiu feliz, antes de voltar a se deliciar com sua {i}'refeição.'{/i}"

# game/data/travel_events/raider.rpy:26
translate ptPT travel_event_raider_c83c3a46:

    # ELENA @ smile "Told you that you'd made new friends..."
    ELENA @ smile "Eu te disse que você fez novos amigos..."

# game/data/travel_events/raider.rpy:31
translate ptPT travel_event_raider_71495f59:

    # BANDIT "HAVE IT YOUR WAY!"
    BANDIT "DO SEU JEITO!"

# game/data/travel_events/raider.rpy:46
translate ptPT travel_event_raider_f334646b:

    # "With the last of the bandits slain and dead at my feet, I carried on, leaving their corpses for the crows."
    "Com o último dos bandidos morto e jacente aos meus pés, segui em frente, deixando seus cadáveres para os corvos."

# game/data/travel_events/raider.rpy:49
translate ptPT travel_event_raider_f68e9917:

    # BANDIT "F-Fuck this! Boys! We're out of here!"
    BANDIT "M-Merda! Rapazes! Vamos dar o fora daqui!"

# game/data/travel_events/raider.rpy:52
translate ptPT travel_event_raider_f7631e05:

    # "The trembling bandits fled from where they came."
    "Os bandidos trêmulos fugiram de onde vieram."

# game/data/travel_events/raider.rpy:57
translate ptPT travel_event_raider_618e1372:

    # "{i}After spending some time trying to convince them about about a caravan ambushed by Demorai down the road back the way I came...{/i}"
    "{i}Depois de passar algum tempo tentando convencê-los sobre sobre uma caravana emboscada por Demorai na estrada de volta pelo caminho por onde vim...{/i}"

# game/data/travel_events/raider.rpy:58
translate ptPT travel_event_raider_d01d2ade:

    # BANDIT "Hmm, alright, you can go."
    BANDIT "Hmm, tudo bem, você pode ir."

# game/data/travel_events/raider.rpy:59
translate ptPT travel_event_raider_e446dbb3:

    # BANDIT "But if we find you're lying, you're fucking dead!"
    BANDIT "Mas se a gente descobrir que você está mentindo, você tá morto, porra!"

# game/data/travel_events/raider.rpy:62
translate ptPT travel_event_raider_3d302e34:

    # "The bandits left in the direction I pointed."
    "Os bandidos foram na direção que eu apontei."

# game/data/travel_events/raider.rpy:64
translate ptPT travel_event_raider_73f1c8c7:

    # MC "(Idiots.)"
    MC "(Idiotas.)"

# game/data/travel_events/raider.rpy:69
translate ptPT travel_event_raider_add49207:

    # BANDIT "Hand it over! Heh!"
    BANDIT "Entrega isso! Heh!"

translate ptPT strings:

    # game/data/travel_events/raider.rpy:30
    old "{image=[ICON.SWORDS]} I don't think so..."
    new "{image=[ICON.SWORDS]} Acho que não..."

    # game/data/travel_events/raider.rpy:48
    old "I'll slaughter each and every one of you, and when I'm done, I'll wear your flayed skin as a trophy to show to your loved ones."
    new "Eu vou massacrar cada um de vocês, e quando terminar, vou usar suas peles esfoladas como troféu para mostrar aos seus entes queridos."

    # game/data/travel_events/raider.rpy:56
    old "There's no need to fight, I know where a much better haul is..."
    new "Não há necessidade de lutar, eu sei onde tem um saque muito melhor..."

    # game/data/travel_events/raider.rpy:68
    old "I'll give you what you want..."
    new "Vou te dar o que você quer..."

