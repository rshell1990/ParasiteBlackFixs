# game/data/travel_events/travel_banter.rpy:38
translate ptPT travelmodebanter_map_elena_mc_1_1d4d5faf:

    # ELENA @ talk "Have you ever thought about leaving Alderay?"
    ELENA @ talk "Já pensaste em sair de Alderay?"

# game/data/travel_events/travel_banter.rpy:39
translate ptPT travelmodebanter_map_elena_mc_1_4a2613e4:

    # MC @ think "Where'd that come from?"
    MC @ think "De onde é que isso veio?"

# game/data/travel_events/travel_banter.rpy:40
translate ptPT travelmodebanter_map_elena_mc_1_9828a89f:

    # ELENA @ talk "Just... curiosity."
    ELENA @ talk "Apenas... curiosidade."

# game/data/travel_events/travel_banter.rpy:41
translate ptPT travelmodebanter_map_elena_mc_1_e722756d:

    # ELENA @ talk "Growing up at Thornfalls, I dreamt of faraway places and adventures."
    ELENA @ talk "Ao crescer em Thornfalls, sonhava com lugares distantes e aventuras."

# game/data/travel_events/travel_banter.rpy:42
translate ptPT travelmodebanter_map_elena_mc_1_6308ffa5:

    # ELENA @ smile "It seems silly now, but... I still think about the places I want to see."
    ELENA @ smile "Parece tolice agora, mas... ainda penso nos lugares que quero ver."

# game/data/travel_events/travel_banter.rpy:45
translate ptPT travelmodebanter_map_elena_mc_1_96b1d0a3:

    # ELENA @ shock "Just like that?"
    ELENA @ shock "Assim, sem mais?"

# game/data/travel_events/travel_banter.rpy:46
translate ptPT travelmodebanter_map_elena_mc_1_bb7eda56:

    # MC @ smile "There's a whole world out there."
    MC @ smile "Há um mundo inteiro lá fora."

# game/data/travel_events/travel_banter.rpy:47
translate ptPT travelmodebanter_map_elena_mc_1_c579fce3:

    # ELENA @ smile "And would there be room for one more?"
    ELENA @ smile "E haveria espaço para mais um?"

# game/data/travel_events/travel_banter.rpy:48
translate ptPT travelmodebanter_map_elena_mc_1_6bc977b7:

    # MC @ smile2 "I'm sure I could fit you in."
    MC @ smile2 "Tenho a certeza de que te consigo encaixar."

# game/data/travel_events/travel_banter.rpy:49
translate ptPT travelmodebanter_map_elena_mc_1_5b4dee46:

    # ELENA @ smile "I must admit, I'm surprised."
    ELENA @ smile "Devo admitir, estou surpreso."

# game/data/travel_events/travel_banter.rpy:50
translate ptPT travelmodebanter_map_elena_mc_1_082ad89d:

    # ELENA @ smile "Markus told me all you two wanted was a quiet life behind palace walls."
    ELENA @ smile "Markus me disse que tudo que vocês dois queriam era uma vida tranquila atrás das muralhas do palácio."

# game/data/travel_events/travel_banter.rpy:51
translate ptPT travelmodebanter_map_elena_mc_1_0d739712:

    # MC @ talk "Funny, isn't it?"
    MC @ talk "Engraçado, não é?"

# game/data/travel_events/travel_banter.rpy:52
translate ptPT travelmodebanter_map_elena_mc_1_995149d2:

    # MC @ talk "That dream started feeling more like a cage after... everything."
    MC @ talk "Esse sonho começou a parecer mais uma gaiola depois... de tudo."

# game/data/travel_events/travel_banter.rpy:53
translate ptPT travelmodebanter_map_elena_mc_1_e5753e06:

    # ELENA @ smile "No. Not strange at all. Not to me."
    ELENA @ smile "Não. Nem um pouco estranho. Para mim, não."

# game/data/travel_events/travel_banter.rpy:55
translate ptPT travelmodebanter_map_elena_mc_1_19758ec6:

    # ELENA @ talk "Ahh, you seem more like a homebody."
    ELENA @ talk "Ahh, você parece mais uma pessoa caseira."

# game/data/travel_events/travel_banter.rpy:56
translate ptPT travelmodebanter_map_elena_mc_1_b3517fc1:

    # MC @ think "Oh?"
    MC @ think "Oh?"

# game/data/travel_events/travel_banter.rpy:57
translate ptPT travelmodebanter_map_elena_mc_1_01b971be:

    # ELENA @ grumpy "You and Markus dreamed of royal service, didn't you?"
    ELENA @ grumpy "Você e Markus sonhavam com o serviço real, não é?"

# game/data/travel_events/travel_banter.rpy:58
translate ptPT travelmodebanter_map_elena_mc_1_6204f33e:

    # ELENA @ smile "Not exactly an adventurous life."
    ELENA @ smile "Não exatamente uma vida aventureira."

# game/data/travel_events/travel_banter.rpy:59
translate ptPT travelmodebanter_map_elena_mc_1_ab966d56:

    # MC @ talk "Is wanting a quiet life so wrong?"
    MC @ talk "Querer uma vida tranquila é tão errado?"

# game/data/travel_events/travel_banter.rpy:60
translate ptPT travelmodebanter_map_elena_mc_1_4ca3d53f:

    # ELENA @ smile "Not at all."
    ELENA @ smile "De jeito nenhum."

# game/data/travel_events/travel_banter.rpy:61
translate ptPT travelmodebanter_map_elena_mc_1_b2753dd2:

    # ELENA @ smile "It's your life to live."
    ELENA @ smile "A vida é sua para viver."

# game/data/travel_events/travel_banter.rpy:62
translate ptPT travelmodebanter_map_elena_mc_1_cdd397f7:

    # MC @ think "{i}... And when this war is one day over.{/i}"
    MC @ think "{i}... E quando esta guerra um dia terminar.{/i}"

# game/data/travel_events/travel_banter.rpy:63
translate ptPT travelmodebanter_map_elena_mc_1_1cfe520f:

    # MC @ think "{i}Is it a life you'd want to be a part of?{/i}"
    MC @ think "{i}É uma vida da qual você gostaria de fazer parte?{/i}"

# game/data/travel_events/travel_banter.rpy:64
translate ptPT travelmodebanter_map_elena_mc_1_4c9bb63b:

    # ELENA @ lewd "L-Let's leave that question for another day."
    ELENA @ lewd "V-Vamos deixar essa pergunta para outro dia."

# game/data/travel_events/travel_banter.rpy:74
translate ptPT travelmodebanter_map_elena_mc_2_dfcc99a2:

    # ELENA @ grumpy "...Does it hurt?"
    ELENA @ grumpy "...Dói?"

# game/data/travel_events/travel_banter.rpy:76
translate ptPT travelmodebanter_map_elena_mc_2_bde6c2b6:

    # MC @ think "What?"
    MC @ think "O quê?"

# game/data/travel_events/travel_banter.rpy:77
translate ptPT travelmodebanter_map_elena_mc_2_4b60e47a:

    # ELENA @ grumpy "When you change into that thing... does it hurt?"
    ELENA @ grumpy "Quando você se transforma naquela coisa... dói?"

# game/data/travel_events/travel_banter.rpy:78
translate ptPT travelmodebanter_map_elena_mc_2_3496abfa:

    # MC @ talk "It... did. At first."
    MC @ talk "Doeu... no começo."

# game/data/travel_events/travel_banter.rpy:80
translate ptPT travelmodebanter_map_elena_mc_2_0a297aba:

    # MC @ talk "It was agony."
    MC @ talk "Foi uma agonia."

# game/data/travel_events/travel_banter.rpy:81
translate ptPT travelmodebanter_map_elena_mc_2_54e3ddd7:

    # MC @ talk "But it gets easier every time."
    MC @ talk "Mas fica mais fácil a cada vez."

# game/data/travel_events/travel_banter.rpy:83
translate ptPT travelmodebanter_map_elena_mc_2_c2fc29a5:

    # MC @ talk "Why do you ask?"
    MC @ talk "Por que você pergunta?"

# game/data/travel_events/travel_banter.rpy:84
translate ptPT travelmodebanter_map_elena_mc_2_ede2ccf2:

    # ELENA @ sad "Just worried about you."
    ELENA @ sad "Só estou preocupado com você."

# game/data/travel_events/travel_banter.rpy:85
translate ptPT travelmodebanter_map_elena_mc_2_7cedfe97:

    # ELENA @ talk "How are you holding up? After everything that's happened so fast..."
    ELENA @ talk "Como você está aguentando? Depois de tudo que aconteceu tão rápido..."

# game/data/travel_events/travel_banter.rpy:88
translate ptPT travelmodebanter_map_elena_mc_2_cf94bad7:

    # ELENA @ shock "Really? I'm surprised... most people would struggle."
    ELENA @ shock "Sério? Estou surpreso... a maioria das pessoas teria dificuldade."

# game/data/travel_events/travel_banter.rpy:89
translate ptPT travelmodebanter_map_elena_mc_2_094bce6b:

    # MC @ talk "There are doubts, sure. But we can actually change things now."
    MC @ talk "Há dúvidas, claro. Mas agora podemos realmente mudar as coisas."

# game/data/travel_events/travel_banter.rpy:90
translate ptPT travelmodebanter_map_elena_mc_2_e1f4d040:

    # MC @ smile "Before the gift, I felt powerless. Like my life wasn't mine."
    MC @ smile "Antes do presente, eu me sentia impotente. Como se minha vida não fosse minha."

# game/data/travel_events/travel_banter.rpy:91
translate ptPT travelmodebanter_map_elena_mc_2_92dfa1e6:

    # MC @ smile "Now? It's like we finally have... {i}hope.{/i}"
    MC @ smile "Agora? É como se finalmente tivéssemos... {i}esperança.{/i}"

# game/data/travel_events/travel_banter.rpy:92
translate ptPT travelmodebanter_map_elena_mc_2_73c0b9f3:

    # ELENA @ smile "You're starting to sound like a hero from the old tales."
    ELENA @ smile "Você está começando a soar como um herói das histórias antigas."

# game/data/travel_events/travel_banter.rpy:93
translate ptPT travelmodebanter_map_elena_mc_2_f18990c6:

    # MC @ smile "Let's not go that far."
    MC @ smile "Não vamos tão longe."

# game/data/travel_events/travel_banter.rpy:94
translate ptPT travelmodebanter_map_elena_mc_2_91c8e0b3:

    # ELENA @ smile "Come. Let's keep moving."
    ELENA @ smile "Venha. Vamos continuar."

# game/data/travel_events/travel_banter.rpy:96
translate ptPT travelmodebanter_map_elena_mc_2_a4311795:

    # ELENA @ sad "That's... a relief. You can talk to me, you know."
    ELENA @ sad "Isso é... um alívio. Você pode falar comigo, sabe."

# game/data/travel_events/travel_banter.rpy:97
translate ptPT travelmodebanter_map_elena_mc_2_b067621a:

    # MC @ smile "That means more than you think."
    MC @ smile "Isso significa mais do que você pensa."

# game/data/travel_events/travel_banter.rpy:98
translate ptPT travelmodebanter_map_elena_mc_2_42ddcd91:

    # ELENA @ smile "Come on. Let's keep moving."
    ELENA @ smile "Vamos. Vamos continuar."

# game/data/travel_events/travel_banter.rpy:100
translate ptPT travelmodebanter_map_elena_mc_2_2f15a7d9:

    # ELENA @ sad "I'm here if you want to talk."
    ELENA @ sad "Estou aqui se você quiser conversar."

# game/data/travel_events/travel_banter.rpy:101
translate ptPT travelmodebanter_map_elena_mc_2_30d77ce8:

    # ELENA @ sad "It weighs heavy, doesn't it? Memories that won't let go..."
    ELENA @ sad "Pesa muito, não é? Memórias que não soltam..."

# game/data/travel_events/travel_banter.rpy:102
translate ptPT travelmodebanter_map_elena_mc_2_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/travel_events/travel_banter.rpy:103
translate ptPT travelmodebanter_map_elena_mc_2_6c08d76e:

    # ELENA @ sad "A-Anyway! I just wanted you to know you're not alone."
    ELENA @ sad "De qualquer forma! Só queria que você soubesse que não está sozinho."

# game/data/travel_events/travel_banter.rpy:104
translate ptPT travelmodebanter_map_elena_mc_2_1a43d7a9:

    # ELENA @ talk "I'm here if you need me."
    ELENA @ talk "Estou aqui se você precisar de mim."

# game/data/travel_events/travel_banter.rpy:105
translate ptPT travelmodebanter_map_elena_mc_2_ddf70b53:

    # MC @ smile "Thank you, Elena."
    MC @ smile "Obrigado, Elena."

# game/data/travel_events/travel_banter.rpy:106
translate ptPT travelmodebanter_map_elena_mc_2_0403d166:

    # ELENA @ smile "Come. Let's keep going."
    ELENA @ smile "Venha. Vamos continuar."

# game/data/travel_events/travel_banter.rpy:116
translate ptPT travelmodebanter_map_elena_mc_3_romance_ed8a1411:

    # "While walking, something soft brushed against my side."
    "Enquanto caminhava, algo macio roçou meu lado."

# game/data/travel_events/travel_banter.rpy:118
translate ptPT travelmodebanter_map_elena_mc_3_romance_899cf127:

    # "Elena passed me with a coy smile and a soft hum."
    "Elena passou por mim com um sorriso tímido e um zumbido suave."

# game/data/travel_events/travel_banter.rpy:119
translate ptPT travelmodebanter_map_elena_mc_3_romance_fe9303c4:

    # ELENA @ smile "{i}*Happy humming*{/i}"
    ELENA @ smile "{i}*Zumbido feliz*{/i}"

# game/data/travel_events/travel_banter.rpy:120
translate ptPT travelmodebanter_map_elena_mc_3_romance_3321ea6a:

    # MC @ smile "Someone's in a good mood."
    MC @ smile "Alguém está de bom humor."

# game/data/travel_events/travel_banter.rpy:122
translate ptPT travelmodebanter_map_elena_mc_3_romance_07f53f05:

    # ELENA @ smile "Of course. The weather's pleasant, the air is clean..."
    ELENA @ smile "Claro. O clima está agradável, o ar está limpo..."

# game/data/travel_events/travel_banter.rpy:123
translate ptPT travelmodebanter_map_elena_mc_3_romance_bc9974f6:

    # "She glanced back, her sultry eyes dancing."
    "Ela olhou para trás, seus olhos sensuais dançando."

# game/data/travel_events/travel_banter.rpy:124
translate ptPT travelmodebanter_map_elena_mc_3_romance_3f6ec57a:

    # ELENA @ smile "And {i}the view{/i} is quite nice, too."
    ELENA @ smile "E a {i}vista{/i} também é muito agradável."

# game/data/travel_events/travel_banter.rpy:125
translate ptPT travelmodebanter_map_elena_mc_3_romance_eaad9ebd:

    # MC @ smile "The view, huh?"
    MC @ smile "A vista, hein?"

# game/data/travel_events/travel_banter.rpy:126
translate ptPT travelmodebanter_map_elena_mc_3_romance_80da6f9e:

    # "Her tail brushed me again playfully as she walked ahead."
    "A cauda dela me roçou novamente de forma brincalhona enquanto ela caminhava à frente."

# game/data/travel_events/travel_banter.rpy:127
translate ptPT travelmodebanter_map_elena_mc_3_romance_f4fe840d:

    # ELENA @ smile "Yes. It's been on my mind a lot lately."
    ELENA @ smile "Sim. Tenho pensado muito nisso ultimamente."

# game/data/travel_events/travel_banter.rpy:130
translate ptPT travelmodebanter_map_elena_mc_3_romance_c670f114:

    # MC @ smile "(Cute.)"
    MC @ smile "(Fofa.)"

# game/data/travel_events/travel_banter.rpy:137
translate ptPT travelmodebanter_map_elena_markus_1_ddfff1fd:

    # MARKUS @ think "So, you're a lady, then?"
    MARKUS @ think "Então, você é uma dama?"

# game/data/travel_events/travel_banter.rpy:139
translate ptPT travelmodebanter_map_elena_markus_1_abecf88a:

    # ELENA @ talk "Yes, I do indeed belong to the female gender."
    ELENA @ talk "Sim, eu realmente pertenço ao gênero feminino."

# game/data/travel_events/travel_banter.rpy:140
translate ptPT travelmodebanter_map_elena_markus_1_d0033b5e:

    # MARKUS @ angry "You know that wasn't what I was talking about!"
    MARKUS @ angry "Você sabe que não era disso que eu estava falando!"

# game/data/travel_events/travel_banter.rpy:141
translate ptPT travelmodebanter_map_elena_markus_1_3213a1a5:

    # MARKUS @ talk "I mean, you're a *lady* lady. Like, you grew up in some huge estate house."
    MARKUS @ talk "Quero dizer, você é uma *dama* dama. Tipo, você cresceu em uma mansão enorme."

# game/data/travel_events/travel_banter.rpy:142
translate ptPT travelmodebanter_map_elena_markus_1_9316f5fc:

    # ELENA @ smile "Yes. The ones with the very long tables and lots of food on them."
    ELENA @ smile "Sim. As que têm mesas muito compridas e bastante comida nelas."

# game/data/travel_events/travel_banter.rpy:143
translate ptPT travelmodebanter_map_elena_markus_1_f6ced7d6:

    # ELENA @ smile "Are you going somewhere with this?"
    ELENA @ smile "Você está indo a algum lugar com isso?"

# game/data/travel_events/travel_banter.rpy:144
translate ptPT travelmodebanter_map_elena_markus_1_a54c70bc:

    # MARKUS @ talk "Sensitive much?"
    MARKUS @ talk "Sensível, não?"

# game/data/travel_events/travel_banter.rpy:146
translate ptPT travelmodebanter_map_elena_markus_1_2de858ba:

    # ELENA @ talk "I can assure you, manor house or not, my time at the Thornfalls was... difficult."
    ELENA @ talk "Posso lhe assegurar, com ou sem mansão, meu tempo nos Thornfalls foi... difícil."

# game/data/travel_events/travel_banter.rpy:147
translate ptPT travelmodebanter_map_elena_markus_1_6211068f:

    # MARKUS @ think "I find that hard to believe."
    MARKUS @ think "Acho difícil acreditar nisso."

# game/data/travel_events/travel_banter.rpy:148
translate ptPT travelmodebanter_map_elena_markus_1_298cf6f7:

    # MARKUS @ think "Did you ever have to worry about where your next meal would come from?"
    MARKUS @ think "Você já teve que se preocupar de onde viria sua próxima refeição?"

# game/data/travel_events/travel_banter.rpy:149
translate ptPT travelmodebanter_map_elena_markus_1_24473bcf:

    # MARKUS @ think "Or constantly wonder when, not if, the next loved one would be taken by this infernal war?"
    MARKUS @ think "Ou se perguntar constantemente quando, e não se, o próximo ente querido seria levado por esta guerra infernal?"

# game/data/travel_events/travel_banter.rpy:150
translate ptPT travelmodebanter_map_elena_markus_1_3cdbde5f:

    # ELENA @ angry "No..."
    ELENA @ angry "Não..."

# game/data/travel_events/travel_banter.rpy:152
translate ptPT travelmodebanter_map_elena_markus_1_77cdaa2f:

    # ELENA @ angry "I just spent every night living in fear."
    ELENA @ angry "Eu apenas passava todas as noites vivendo com medo."

# game/data/travel_events/travel_banter.rpy:153
translate ptPT travelmodebanter_map_elena_markus_1_d313e372:

    # ELENA @ angry "Let me tell you something, Markus."
    ELENA @ angry "Deixe-me lhe contar uma coisa, Markus."

# game/data/travel_events/travel_banter.rpy:154
translate ptPT travelmodebanter_map_elena_markus_1_f52bc4d7:

    # ELENA @ angry "It's one kind of hell to starve... it's another entirely to wonder if every meal you're served will be your last."
    ELENA @ angry "É um tipo de inferno passar fome... é outro totalmente se perguntar se cada refeição que lhe servem será a última."

# game/data/travel_events/travel_banter.rpy:164
translate ptPT travelmodebanter_map_elena_markus_2_6b1dd249:

    # MARKUS @ talk "Tell me, Elena."
    MARKUS @ talk "Diga-me, Elena."

# game/data/travel_events/travel_banter.rpy:166
translate ptPT travelmodebanter_map_elena_markus_2_10d78c40:

    # MARKUS @ talk "You must have spent some time traveling around before meeting us."
    MARKUS @ talk "Você deve ter passado algum tempo viajando por aí antes de nos encontrar."

# game/data/travel_events/travel_banter.rpy:167
translate ptPT travelmodebanter_map_elena_markus_2_2f0ee648:

    # MARKUS @ smile "Got any interesting stories to tell?"
    MARKUS @ smile "Tem alguma história interessante para contar?"

# game/data/travel_events/travel_banter.rpy:168
translate ptPT travelmodebanter_map_elena_markus_2_c983087c:

    # ELENA @ grumpy "...A while back, while I was in Newyark, I heard about a 'wolf woman' and naturally, my interest was piqued."
    ELENA @ grumpy "...Há um tempo atrás, enquanto eu estava em Newyark, ouvi falar de uma 'mulher lobo' e naturalmente, meu interesse foi despertado."

# game/data/travel_events/travel_banter.rpy:169
translate ptPT travelmodebanter_map_elena_markus_2_71871438:

    # ELENA @ talk "It didn't sound like any kind of Katai, so I thought perhaps I might finally find another of my kind."
    ELENA @ talk "Não parecia nenhum tipo de Katai, então pensei que talvez eu finalmente encontrasse outro da minha espécie."

# game/data/travel_events/travel_banter.rpy:170
translate ptPT travelmodebanter_map_elena_markus_2_e936c5f8:

    # MARKUS @ think "What did you find?"
    MARKUS @ think "O que você encontrou?"

# game/data/travel_events/travel_banter.rpy:171
translate ptPT travelmodebanter_map_elena_markus_2_2dd61dd9:

    # ELENA @ shock "It was a woman who had made some kind of... fur suit from different pelts of wolves."
    ELENA @ shock "Era uma mulher que tinha feito uma espécie de... roupa de pele com diferentes peles de lobo."

# game/data/travel_events/travel_banter.rpy:173
translate ptPT travelmodebanter_map_elena_markus_2_03538783:

    # ELENA @ shock "She was running around on stage pretending to be a wolf!"
    ELENA @ shock "Ela estava correndo pelo palco fingindo ser um lobo!"

# game/data/travel_events/travel_banter.rpy:174
translate ptPT travelmodebanter_map_elena_markus_2_cc301a3c:

    # ELENA @ shock "Can you imagine people doing such a strange thing?"
    ELENA @ shock "Você pode imaginar pessoas fazendo uma coisa tão estranha?"

# game/data/travel_events/travel_banter.rpy:175
translate ptPT travelmodebanter_map_elena_markus_2_0f3ab35d:

    # MARKUS @ think "...Too much salt in the air from the sea."
    MARKUS @ think "...Muito sal no ar do mar."

# game/data/travel_events/travel_banter.rpy:176
translate ptPT travelmodebanter_map_elena_markus_2_f1fa7ebb:

    # MARKUS @ think "That's why all those Newyark folk are so strange."
    MARKUS @ think "É por isso que todas aquelas pessoas de Newyark são tão estranhas."

# game/data/travel_events/travel_banter.rpy:186
translate ptPT travelmodebanter_map_elena_markus_3_8008183f:

    # ELENA @ smile "Markus, I'm curious about something..."
    ELENA @ smile "Markus, estou curioso sobre algo..."

# game/data/travel_events/travel_banter.rpy:188
translate ptPT travelmodebanter_map_elena_markus_3_a04187b6:

    # MARKUS @ talk "Ask away."
    MARKUS @ talk "Pergunte."

# game/data/travel_events/travel_banter.rpy:189
translate ptPT travelmodebanter_map_elena_markus_3_aaf4f0d0:

    # ELENA @ talk "I'm aware of [player_name!t]'s... umm, {i}paramours and dalliances.{/i}"
    ELENA @ talk "Estou ciente dos... hum, {i}amantes e casos amorosos{/i} de [player_name!t]."

# game/data/travel_events/travel_banter.rpy:190
translate ptPT travelmodebanter_map_elena_markus_3_10dd5267:

    # ELENA @ grumpy "But I never see you with anyone."
    ELENA @ grumpy "Mas eu nunca te vejo com ninguém."

# game/data/travel_events/travel_banter.rpy:191
translate ptPT travelmodebanter_map_elena_markus_3_33702753:

