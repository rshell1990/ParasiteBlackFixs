# game/data/travel_events/wagon.rpy:5
translate ptPT travel_event_wagon_wreck_20e774cc:

    # "Heading out into a clearing in the forest, I heard the sounds of crows squawking as they circled overhead the wreckage of a wagon."
    "Saindo para uma clareira na floresta, ouvi o som de corvos grasnando enquanto circulavam sobre os destroços de uma carroça."

# game/data/travel_events/wagon.rpy:6
translate ptPT travel_event_wagon_wreck_63887fd2:

    # "Littered around the decimated remains of the overturned wagon, the bloodied, torn to shred remains of a few Alderian soldiers."
    "Espalhados pelos restos destruídos da carroça virada, os restos ensanguentados e despedaçados de alguns soldados Alderianos."

# game/data/travel_events/wagon.rpy:7
translate ptPT travel_event_wagon_wreck_6b8bd854:

    # "The blood still dripped down from the tips of the pikes as the horrible, sickening smell nearly made me convulse."
    "O sangue ainda pingava das pontas das lanças enquanto o cheiro horrível e nauseante quase me fazia convulsionar."

# game/data/travel_events/wagon.rpy:8
translate ptPT travel_event_wagon_wreck_2cc698e3:

    # "As I lightly dipped my finger into one of the pools of blood, it was not warm, but not cold either."
    "Ao mergulhar levemente o dedo em uma das poças de sangue, ele não estava quente, mas também não estava frio."

# game/data/travel_events/wagon.rpy:9
translate ptPT travel_event_wagon_wreck_37aa5862:

    # "These men were not slain that long ago..."
    "Esses homens não foram mortos há muito tempo..."

# game/data/travel_events/wagon.rpy:12
translate ptPT travel_event_wagon_wreck_dae18eb3:

    # MARKUS "Let's walk around... I've got a bad feeling about this."
    MARKUS "Vamos dar uma volta por aqui... Tenho um mau pressentimento sobre isso."

# game/data/travel_events/wagon.rpy:16
translate ptPT travel_event_wagon_wreck_a04b9dc6:

    # ELENA @ sad "These poor men."
    ELENA @ sad "Esses pobres homens."

# game/data/travel_events/wagon.rpy:17
translate ptPT travel_event_wagon_wreck_e1aaad3d:

    # ELENA @ sad "What could have done this?"
    ELENA @ sad "O que poderia ter feito isso?"

# game/data/travel_events/wagon.rpy:21
translate ptPT travel_event_wagon_wreck_03a2822c:

    # REGINA "...Hmm."
    REGINA "...Hmm."

# game/data/travel_events/wagon.rpy:25
translate ptPT travel_event_wagon_wreck_ff50a6f7:

    # VES @ talk "There might be something worth taking on that wagon."
    VES @ talk "Pode haver algo que valha a pena levar naquela carroça."

# game/data/travel_events/wagon.rpy:26
translate ptPT travel_event_wagon_wreck_bd54deef:

    # VES "But is it worth it?"
    VES "Mas vale a pena?"

# game/data/travel_events/wagon.rpy:30
translate ptPT travel_event_wagon_wreck_9efb476e:

    # MYU @ scared "M-Myu...!"
    MYU @ scared "M-Myu...!"

# game/data/travel_events/wagon.rpy:32
translate ptPT travel_event_wagon_wreck_c344b979:

    # MC "(Hm... What should I do?)"
    MC "(Hmm... O que devo fazer?)"

# game/data/travel_events/wagon.rpy:35
translate ptPT travel_event_wagon_wreck_e9715c76:

    # MC "(Nothing ventured, nothing gained!)"
    MC "(Quem não arrisca, não petisca!)"

# game/data/travel_events/wagon.rpy:36
translate ptPT travel_event_wagon_wreck_f8e1da93:

    # "As I stepped cautiously towards the wagon..."
    "Enquanto me aproximava cautelosamente da carroça..."

# game/data/travel_events/wagon.rpy:48
translate ptPT travel_event_wagon_wreck_c9e10750:

    # MC "(No, why take unnecessary risks?)"
    MC "(Não, por que correr riscos desnecessários?)"

# game/data/travel_events/wagon.rpy:49
translate ptPT travel_event_wagon_wreck_39332743:

    # MC "(I imagine that thing has been looted already.)"
    MC "(Imagino que aquela coisa já tenha sido saqueada.)"

# game/data/travel_events/wagon.rpy:50
translate ptPT travel_event_wagon_wreck_987aff00:

    # "Deciding it was best to ignore the bloody wreck, we took a slightly longer route around... Avoiding passing by it entirely."
    "Decidindo que era melhor ignorar a carroça ensanguentada, seguimos por uma rota um pouco mais longa... Evitando passar por ela completamente."

# game/data/travel_events/wagon.rpy:54
translate ptPT travel_event_wagon_wreck_demorai_c90e163a:

    # "I found my foot pressed up against a wire tied across the path, connected from one of the many littered corpses to a loud bell attached to the wagon."
    "Encontrei meu pé pressionado contra um fio amarrado no caminho, ligado de um dos muitos cadáveres espalhados a um sino barulhento preso à carroça."

# game/data/travel_events/wagon.rpy:55
translate ptPT travel_event_wagon_wreck_demorai_3bc104b5:

    # "As it rang out, a small horde of Demorai soldiers came rushing out to face us!"
    "Quando ele tocou, uma pequena horda de soldados Demorai saiu correndo para nos enfrentar!"

# game/data/travel_events/wagon.rpy:57
translate ptPT travel_event_wagon_wreck_demorai_c53c31e6:

    # MC @ scared "DEMORAIIII!"
    MC @ scared "DEMORAIIII!"

# game/data/travel_events/wagon.rpy:61
translate ptPT travel_event_wagon_wreck_demorai_45351050:

    # "With the last of the Demorai foot-soldiers slain at my feet, I caught my breath as I wiped the blood off from me."
    "Com os últimos soldados de infantaria Demorai mortos aos meus pés, recuperei o fôlego enquanto limpava o sangue de mim."

# game/data/travel_events/wagon.rpy:62
translate ptPT travel_event_wagon_wreck_demorai_124fec4b:

    # "The wagon indeed was completely ransacked; what few bags were there had been tied up and loaded with random rocks and wood to give the {i}appearance{/i} there was still something worth taking."
    "A carroça estava, de fato, completamente saqueada; as poucas bolsas que havia estavam amarradas e carregadas com pedras e madeira aleatórias para dar a {i}aparência{/i} de que ainda havia algo que valesse a pena levar."

# game/data/travel_events/wagon.rpy:63
translate ptPT travel_event_wagon_wreck_demorai_7b79d6b1:

    # MC "(I have to be more careful... The Demorai likely have more ambushes like these all over these roads!)"
    MC "(Tenho que ter mais cuidado... Provavelmente os Demorai têm mais emboscadas como essas por todas estas estradas!)"

# game/data/travel_events/wagon.rpy:65
translate ptPT travel_event_wagon_wreck_demorai_2d19fda2:

    # ELENA "Is everyone alright?"
    ELENA "Todos estão bem?"

# game/data/travel_events/wagon.rpy:67
translate ptPT travel_event_wagon_wreck_demorai_85ecd8d8:

    # REGINA @ smile "Never better, dear!"
    REGINA @ smile "Nunca estive melhor, querido!"

# game/data/travel_events/wagon.rpy:68
translate ptPT travel_event_wagon_wreck_demorai_588fed4a:

    # REGINA @ smile "What's a little blood to ruin my day?"
    REGINA @ smile "O que é um pouco de sangue para estragar meu dia?"

# game/data/travel_events/wagon.rpy:70
translate ptPT travel_event_wagon_wreck_demorai_800484cb:

    # VES @ angry "These damn things are tough to kill... Much tougher than the scouts they usually send out."
    VES @ angry "Essas coisas malditas são difíceis de matar... Muito mais difíceis do que os batedores que eles costumam enviar."

# game/data/travel_events/wagon.rpy:72
translate ptPT travel_event_wagon_wreck_demorai_4ea7e921:

    # MARKUS @ angry "Could we {i}please{/i} next time avoid the massacred sites in the hopes of finding what? A bag of coins and some bread?"
    MARKUS @ angry "Poderíamos {i}por favor{/i} da próxima vez evitar os locais massacrados na esperança de encontrar o quê? Um saco de moedas e um pouco de pão?"

# game/data/travel_events/wagon.rpy:76
translate ptPT travel_event_wagon_wreck_bandits_48587d14:

    # "I heard a sharp whistle, and as I turned to look around swiftly, from the tall grass and trees, we found ourselves surrounded by a group of bandits."
    "Ouvi um assobio agudo e, ao me virar rapidamente para olhar em volta, da grama alta e das árvores, nos vimos cercados por um grupo de bandidos."

# game/data/travel_events/wagon.rpy:78
translate ptPT travel_event_wagon_wreck_bandits_523b71f5:

    # BANDIT "Going somewhere, are we?"
    BANDIT "Indo a algum lugar, hein?"

# game/data/travel_events/wagon.rpy:79
translate ptPT travel_event_wagon_wreck_bandits_881eafe4:

    # BANDIT "Heh... You've got to pay the toll first."
    BANDIT "Heh... Você tem que pagar o pedágio primeiro."

# game/data/travel_events/wagon.rpy:80
translate ptPT travel_event_wagon_wreck_bandits_69920114:

    # MC @ angry "{i}The toll?{/i}"
    MC @ angry "{i}O pedágio?{/i}"

# game/data/travel_events/wagon.rpy:81
translate ptPT travel_event_wagon_wreck_bandits_c5707737:

    # BANDIT "Either you give us three hundred coins, or we take {i}all{/i} your coins."
    BANDIT "Ou você nos dá trezentas moedas, ou pegamos {i}todas{/i} as suas moedas."

# game/data/travel_events/wagon.rpy:87
translate ptPT travel_event_wagon_wreck_bandits_b370d451:

    # BANDIT "You can try!"
    BANDIT "Pode tentar!"

# game/data/travel_events/wagon.rpy:93
translate ptPT travel_event_wagon_wreck_bandits_dcb47741:

    # "As the last of the bandits pleaded, desperately dragging himself across the floor with his hand raised towards me, he squealed."
    "Enquanto o último dos bandidos implorava, se arrastando desesperadamente pelo chão com a mão erguida em minha direção, ele guinchou."

# game/data/travel_events/wagon.rpy:94
translate ptPT travel_event_wagon_wreck_bandits_2f0ce3de:

    # BANDIT "P-Please! Don't!"
    BANDIT "P-Por favor! Não!"

# game/data/travel_events/wagon.rpy:98
translate ptPT travel_event_wagon_wreck_bandits_5c8f9b60:

    # "He let out one final ghastly scream as I took his head."
    "Ele soltou um último grito horripilante enquanto eu lhe cortava a cabeça."

# game/data/travel_events/wagon.rpy:100
translate ptPT travel_event_wagon_wreck_bandits_612d79cb:

    # BANDIT "T-Thank you!"
    BANDIT "O-Obrigado!"

# game/data/travel_events/wagon.rpy:101
translate ptPT travel_event_wagon_wreck_bandits_c09ae34e:

    # "The bandit got up and sprinted into the trees to escape."
    "O bandido se levantou e disparou para dentro das árvores para fugir."

# game/data/travel_events/wagon.rpy:102
translate ptPT travel_event_wagon_wreck_bandits_464f93f3:

    # MC "(These roads become more and more dangerous everyday.)"
    MC "(Estas estradas tornam-se cada vez mais perigosas a cada dia.)"

# game/data/travel_events/wagon.rpy:103
translate ptPT travel_event_wagon_wreck_bandits_cb62e30d:

    # MC "(I need to be more careful...)"
    MC "(Preciso ter mais cuidado...)"

# game/data/travel_events/wagon.rpy:107
translate ptPT travel_event_wagon_wreck_bandits_6a4c3f61:

    # BANDIT "...H-How about you just head on through, and we pretend this never happened?"
    BANDIT "...Q-Que tal você simplesmente seguir em frente e fingirmos que isso nunca aconteceu?"

# game/data/travel_events/wagon.rpy:108
translate ptPT travel_event_wagon_wreck_bandits_2fe00004:

    # BANDIT "You go your way, we go ours..."
    BANDIT "Você segue o seu caminho, nós seguimos o nosso..."

# game/data/travel_events/wagon.rpy:109
translate ptPT travel_event_wagon_wreck_bandits_0bd78c8b:

    # MC @ angry "Fine."
    MC @ angry "Tudo bem."

# game/data/travel_events/wagon.rpy:111
translate ptPT travel_event_wagon_wreck_bandits_efa2979b:

    # "The terrified bandits step aside as we made our way past the bloody wreckage..."
    "Os bandidos aterrorizados se afastam enquanto passávamos pelos destroços ensanguentados..."

# game/data/travel_events/wagon.rpy:116
translate ptPT travel_event_wagon_wreck_bandits_08a7dae1:

    # BANDIT "Pleasure doing business with ya, heh..."
    BANDIT "Prazer em fazer negócios com você, hein..."

# game/data/travel_events/wagon.rpy:117
translate ptPT travel_event_wagon_wreck_bandits_aff07431:

    # "We passed on through uninterrupted."
    "Passamos adiante sem interrupções."

# game/data/travel_events/wagon.rpy:121
translate ptPT travel_event_wagon_wreck_bandits_0c8a7fad:

    # BANDIT "W-What?"
    BANDIT "O-O quê?"

# game/data/travel_events/wagon.rpy:122
translate ptPT travel_event_wagon_wreck_bandits_787175ea:

    # MC @ serious "That wagon you just slew? Who do you think was on it?"
    MC @ serious "Aquela carroça que você acabou de matar? Quem você acha que estava nela?"

# game/data/travel_events/wagon.rpy:123
translate ptPT travel_event_wagon_wreck_bandits_7f9b6f73:

    # MC @ talk "They're inquisitor agents, you fools!"
    MC @ talk "Eles são agentes da Inquisição, seus tolos!"

# game/data/travel_events/wagon.rpy:124
translate ptPT travel_event_wagon_wreck_bandits_c00af213:

    # BANDIT "I-"
    BANDIT "Eu-"

# game/data/travel_events/wagon.rpy:125
translate ptPT travel_event_wagon_wreck_bandits_01e0b0b5:

    # "I continued to lie as easily as I breathed."
    "Continuei mentindo tão facilmente quanto respirava."

# game/data/travel_events/wagon.rpy:126
translate ptPT travel_event_wagon_wreck_bandits_dca4e3a1:

    # MC @ serious "Why do you think we're here? We were sent to head along this path and find the lost wagon!"
    MC @ serious "Por que vocês acham que estamos aqui? Fomos enviados para seguir por este caminho e encontrar a carroça perdida!"

# game/data/travel_events/wagon.rpy:127
translate ptPT travel_event_wagon_wreck_bandits_0e9be35d:

    # BANDIT "...Shit."
    BANDIT "...Merda."

# game/data/travel_events/wagon.rpy:128
translate ptPT travel_event_wagon_wreck_bandits_f6a5f83b:

    # MC @ serious "{i}Do you know what they'll do to you once you're caught?{/i}"
    MC @ serious "{i}Você sabe o que eles farão com você quando for pego?{/i}"

# game/data/travel_events/wagon.rpy:129
translate ptPT travel_event_wagon_wreck_bandits_2487190c:

    # BANDIT "U-Uhh, how'sabout we jus' go our seperate ways?"
    BANDIT "U-Uhh, que tal seguirmos caminhos separados?"

# game/data/travel_events/wagon.rpy:130
translate ptPT travel_event_wagon_wreck_bandits_293380ad:

    # BANDIT "Uhh, m-me and the boys will do our 'business' elsewhere."
    BANDIT "Uhh, e-eu e os rapazes faremos nossos 'negócios' em outro lugar."

# game/data/travel_events/wagon.rpy:131
translate ptPT travel_event_wagon_wreck_bandits_0715d594:

    # MC @ talk "Better hurry then."
    MC @ talk "Melhor se apressar então."

# game/data/travel_events/wagon.rpy:132
translate ptPT travel_event_wagon_wreck_bandits_8ee1ec60:

    # MC @ serious "The others will be here soon."
    MC @ serious "Os outros chegarão em breve."

# game/data/travel_events/wagon.rpy:133
translate ptPT travel_event_wagon_wreck_bandits_b26cb662:

    # BANDIT "Boys! Pack it up! We're leaving!"
    BANDIT "Rapazes! Arrumem tudo! Vamos embora!"

# game/data/travel_events/wagon.rpy:135
translate ptPT travel_event_wagon_wreck_bandits_171ff5bf:

    # "The bandit leader motioned for them to follow, and the other bandits, with mild grumbling and protests, sheepishly hurried off into the woods."
    "O líder dos bandidos fez sinal para que o seguissem, e os outros bandidos, com resmungos e protestos leves, apressaram-se envergonhadamente para a floresta."

# game/data/travel_events/wagon.rpy:136
translate ptPT travel_event_wagon_wreck_bandits_73f1c8c7:

    # MC "(Idiots.)"
    MC "(Idiotas.)"

# game/data/travel_events/wagon.rpy:146
translate ptPT travel_event_wagon_wreck_no_trap_1339d9fc:

    # "Stepping closer to the wagon, I inspected the spilled-over bags of goods."
    "Aproximando-me da carroça, inspecionei os sacos de mercadorias derramados."

# game/data/travel_events/wagon.rpy:147
translate ptPT travel_event_wagon_wreck_no_trap_790a939f:

    # MC "(Looks like whoever ambushed them came to kill and nothing else.)"
    MC "(Parece que quem os emboscou veio para matar e nada mais.)"

# game/data/travel_events/wagon.rpy:150
translate ptPT travel_event_wagon_wreck_no_trap_80473180:

    # "Rummaging through the bags, I found a few coins and some useful things."
    "Remexendo nos sacos, encontrei algumas moedas e algumas coisas úteis."

# game/data/travel_events/wagon.rpy:151
translate ptPT travel_event_wagon_wreck_no_trap_7cd93ab6:

    # MC "(Hm, it's something at least.)"
    MC "(Hm, é alguma coisa, pelo menos.)"

# game/data/travel_events/wagon.rpy:152
translate ptPT travel_event_wagon_wreck_no_trap_c649acab:

    # "For a moment, I contemplated burying the poor souls, but being stuck out in one spot on these roads for two long was too dangerous an idea."
    "Por um momento, pensei em enterrar as pobres almas, mas ficar parado em um lugar nestas estradas por muito tempo era uma ideia perigosa demais."

# game/data/travel_events/wagon.rpy:153
translate ptPT travel_event_wagon_wreck_no_trap_3ff61275:

    # "I resigned myself to reporting about the wagon to someone when I had the chance..."
    "Resignei-me a relatar sobre a carroça a alguém quando tivesse oportunidade..."

# game/data/travel_events/wagon.rpy:158
translate ptPT travel_event_wagon_wreck_no_trap_empty_1339d9fc:

    # "Stepping closer to the wagon, I inspected the spilled-over bags of goods."
    "Aproximando-me da carroça, inspecionei os sacos de mercadorias derramados."

# game/data/travel_events/wagon.rpy:159
translate ptPT travel_event_wagon_wreck_no_trap_empty_790a939f:

    # MC "(Looks like whoever ambushed them came to kill and nothing else.)"
    MC "(Parece que quem os emboscou veio para matar e nada mais.)"

# game/data/travel_events/wagon.rpy:160
translate ptPT travel_event_wagon_wreck_no_trap_empty_ccd6244f:

    # "Rummaging through the bags, I only found sacks of grain, too heavy for us to carry, unfortunately."
    "Remexendo as sacolas, só encontrei sacos de grãos, pesados demais para carregarmos, infelizmente."

# game/data/travel_events/wagon.rpy:161
translate ptPT travel_event_wagon_wreck_no_trap_empty_824bd4dd:

    # MC "(Damn... What a waste.)"
    MC "(Droga... Que desperdício.)"

# game/data/travel_events/wagon.rpy:162
translate ptPT travel_event_wagon_wreck_no_trap_empty_c649acab:

    # "For a moment, I contemplated burying the poor souls, but being stuck out in one spot on these roads for two long was too dangerous an idea."
    "Por um momento, pensei em enterrar as pobres almas, mas ficar parado nessas estradas por muito tempo era uma ideia perigosa demais."

# game/data/travel_events/wagon.rpy:163
translate ptPT travel_event_wagon_wreck_no_trap_empty_3ff61275:

    # "I resigned myself to reporting about the wagon to someone when I had the chance..."
    "Resignei-me a relatar sobre a carroça a alguém quando tivesse a chance..."

