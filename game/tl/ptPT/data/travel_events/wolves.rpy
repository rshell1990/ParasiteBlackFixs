# game/data/travel_events/wolves.rpy:3
translate ptPT travel_event_wolves_d9365df9:

    # "While trekking my way through the forests, I heard the distinct sound of...{i}howling?{/i}"
    "Enquanto eu caminhava pelas florestas, ouvi o som distinto de...{i}uivos?{/i}"

# game/data/travel_events/wolves.rpy:4
translate ptPT travel_event_wolves_9123a2e4:

    # "From the tree lines, a pack of hungry wolves descended upon me, snarling and circling."
    "Das linhas das árvores, uma matilha de lobos famintos desceu sobre mim, rosnando e circulando."

# game/data/travel_events/wolves.rpy:7
translate ptPT travel_event_wolves_b05c7a7b:

    # "The wolves whined and howled as they scattered the winds."
    "Os lobos ganiam e uivavam enquanto se dispersavam ao vento."

# game/data/travel_events/wolves.rpy:8
translate ptPT travel_event_wolves_cda900f2:

    # MC "(Damn beasts!)"
    MC "(Malditas bestas!)"

# game/data/travel_events/wolves.rpy:16
translate ptPT travel_event_wolves_f567ab41:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Com o último dos lobos ganindo de dor angustiada, rapidamente pus fim ao seu sofrimento."

# game/data/travel_events/wolves.rpy:17
translate ptPT travel_event_wolves_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Suspiro*{/i}"

# game/data/travel_events/wolves.rpy:18
translate ptPT travel_event_wolves_ed59b7aa:

    # MC "(These poor things are half-starved, no wonder they're attacking on sight...)"
    MC "(Estas pobres criaturas estão meio famintas, não é de admirar que ataquem à vista...)"

# game/data/travel_events/wolves.rpy:22
translate ptPT travel_event_wolves_04301006:

    # MC @ think "I don't suppose {i}you{/i} could handle this?"
    MC @ think "Não imagino que {i}você{/i} possa lidar com isso?"

# game/data/travel_events/wolves.rpy:23
translate ptPT travel_event_wolves_c3f644c4:

    # ELENA "I mean, {i}I could try.{/i}"
    ELENA "Quero dizer, {i}eu poderia tentar.{/i}"

# game/data/travel_events/wolves.rpy:25
translate ptPT travel_event_wolves_b6bd6149:

    # "Elena stepped forward and snarled towards the wolves, who tilted their heads curiously in understanding."
    "Elena deu um passo à frente e rosnou para os lobos, que inclinaram a cabeça curiosamente em compreensão."

# game/data/travel_events/wolves.rpy:26
translate ptPT travel_event_wolves_632809bd:

    # "After some brief barking, Elena turns towards you."
    "Depois de alguns latidos breves, Elena se vira para você."

# game/data/travel_events/wolves.rpy:27
translate ptPT travel_event_wolves_6b567ed4:

    # ELENA @ sad "They're starving... They only want some food, and they'll leave us alone."
    ELENA @ sad "Eles estão famintos... Eles só querem um pouco de comida, e nos deixarão em paz."

# game/data/travel_events/wolves.rpy:35
translate ptPT travel_event_wolves_5484d21a:

    # "Tossing the meat towards them, the wolves happily whined and barked as they chowed down."
    "Jogando a carne para eles, os lobos ganiam e latiam alegremente enquanto comiam vorazmente."

# game/data/travel_events/wolves.rpy:36
translate ptPT travel_event_wolves_a23af468:

    # "Satisfied with their meal, they sped off into the forests, their leader looking back to give one last bark of appreciation."
    "Satisfeitos com sua refeição, eles correram para a floresta, seu líder olhando para trás para dar um último latido de agradecimento."

# game/data/travel_events/wolves.rpy:38
translate ptPT travel_event_wolves_058c8ebb:

    # ELENA @ smile "Looks like you've made a few new friends..."
    ELENA @ smile "Parece que você fez alguns novos amigos..."

# game/data/travel_events/wolves.rpy:41
translate ptPT travel_event_wolves_937daf18:

    # "The wolves sadly whined... but then, once more, they began to snarl and bear their fangs."
    "Os lobos ganiam tristemente... mas então, mais uma vez, começaram a rosnar e mostrar seus dentes."

# game/data/travel_events/wolves.rpy:42
translate ptPT travel_event_wolves_3b747ef8:

    # ELENA "I don't think they're taking no for an answer!"
    ELENA "Acho que eles não vão aceitar um não como resposta!"

# game/data/travel_events/wolves.rpy:48
translate ptPT travel_event_wolves_f567ab41_1:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Com o último dos lobos ganindo de dor angustiada, rapidamente acabei com seu sofrimento."

# game/data/travel_events/wolves.rpy:49
translate ptPT travel_event_wolves_a4f1e169_1:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*Suspiro*{/i}"

# game/data/travel_events/wolves.rpy:50
translate ptPT travel_event_wolves_579541dd:

    # MC "(Well, that could have gone better.)"
    MC "(Bem, isso poderia ter sido melhor.)"

