translate ptPT event_Elena_nightmares_3dd7af0a:

    # ELENA @ sad "...Only when I misbehaved."
    ELENA @ sad "...Só quando eu me comportava mal."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:42
translate ptPT event_Elena_nightmares_fece7692:

