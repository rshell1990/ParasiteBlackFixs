    MC @ talk "Parece mais que eles te usaram, que te abusaram, do que qualquer outra coisa..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:66
translate ptPT event_Elena_nightmares_f28a909b:

    # ELENA @ sad "Maybe so..."
    ELENA @ sad "Talvez sim..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:67
translate ptPT event_Elena_nightmares_c9329dcf:

