    ELENA @ cry "Quando eu disse que vi {i}coisas{/i} lá embaixo, coisas horríveis..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:50
translate ptPT event_Elena_nightmares_c2ced3cf:

