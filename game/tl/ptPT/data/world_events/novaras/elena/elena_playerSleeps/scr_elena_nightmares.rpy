translate ptPT event_Elena_nightmares_14f9b5ea:

    # ELENA @ sad "And only sometimes, I was unfortunate enough to catch a glimpse of it."
    ELENA @ sad "E apenas às vezes, eu tinha o azar de vislumbrar um pouco disso."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:64
translate ptPT event_Elena_nightmares_0aae521e:

