translate ptPT event_Elena_nightmares_4c67c501:

    # ELENA @ sad "He didn't hurt me... He knew he didn't need to."
    ELENA @ sad "Ele não me machucou... Ele sabia que não precisava."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:44
translate ptPT event_Elena_nightmares_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "O que você quer dizer?"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:45
translate ptPT event_Elena_nightmares_219a7915:

    # ELENA @ sad "When I misbehaved too much, he would have the staff take me down to the old Thornfall mines."
    ELENA @ sad "Quando eu me comportava muito mal, ele mandava os funcionários me levarem para as antigas minas de Thornfall."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:46
translate ptPT event_Elena_nightmares_ad25dd50:

    # ELENA @ sad "He would have me put into a steel cage and lowered into the mines, long abandoned by this point but..."
    ELENA @ sad "Ele me colocaria em uma jaula de aço e me baixaria nas minas, há muito abandonadas até então, mas..."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:47
translate ptPT event_Elena_nightmares_a3d31628:

    # ELENA @ sad "{i}Things... Moved down there.{/i}"
    ELENA @ sad "{i}Coisas... Se moviam lá embaixo.{/i}"

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:48
translate ptPT event_Elena_nightmares_7950d08f:

    # ELENA @ cry "I would spend the whole night in terror, frozen."
    ELENA @ cry "Eu passava a noite inteira aterrorizado, paralisado."

# game/data/world_events/novaras/elena/elena_playerSleeps/scr_elena_nightmares.rpy:49
translate ptPT event_Elena_nightmares_eb32411e:

