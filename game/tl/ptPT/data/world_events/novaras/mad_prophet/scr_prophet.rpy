# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:2
translate ptPT ev_madprophet_var1_15aab633:

    # MAD_PROPHET "HAVE ANY OF YOU ASKED WHY THE SAVIOUR ABANDONED US? WHY NEWHEART LEFT HIS MORTAL FLESH BEHIND IN OUR DARKEST HOURS?"
    MAD_PROPHET "ALGUM DE VOCÊS PERGUNTOU POR QUE O SALVADOR NOS ABANDONOU? POR QUE NEWHEART DEIXOU SUA CARNE MORTAL PARA TRÁS EM NOSSAS HORAS MAIS SOMBRIAS?"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:3
translate ptPT ev_madprophet_var1_a3116029:

    # MAD_PROPHET "SINS! SINS AND BLACKNESS THAT HAS TAKEN SWAY THE SPIRIT OF MAN!"
    MAD_PROPHET "PECADOS! PECADOS E A ESCURIDÃO QUE DOMINOU O ESPÍRITO DO HOMEM!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:4
translate ptPT ev_madprophet_var1_495ef4f7:

    # MAD_PROPHET "THE GODS GIFTED US WITH THE SAVIOUR AND NOW IN PUNISHMENT HAVE TAKEN HIM FROM US AGAIN!"
    MAD_PROPHET "OS DEUSES NOS PRESENTEARAM COM O SALVADOR E AGORA, COMO CASTIGO, O TOMARAM DE NÓS NOVAMENTE!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:5
translate ptPT ev_madprophet_var1_a83b9be4:

    # MAD_PROPHET "REPENT! REPENT NOW YOU FOOLS AND WORSHIP THE NEW GODS ONCE AGAIN! RESTORE THE TEMPLES TO THEIR GLORY AND BURN THE HEATHENS WHO STILL CALL UPON THE OLD GODS FOR SALVATION!"
    MAD_PROPHET "ARREPENDAM-SE! ARREPENDAM-SE AGORA, SEUS TOLOS, E ADOREM OS NOVOS DEUSES MAIS UMA VEZ! RESTAUREM OS TEMPLOS À SUA GLÓRIA E QUEIMEM OS PAGÃOS QUE AINDA CLAMAM AOS ANTIGOS DEUSES POR SALVAÇÃO!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:6
translate ptPT ev_madprophet_var1_df5b3353:

    # "Some of the crowd began to clap and applaud the mad old man, whereas others, slipped away with a look of disgust on their face."
    "Algumas pessoas da multidão começaram a bater palmas e aplaudir o velho louco, enquanto outras se afastaram com uma expressão de nojo no rosto."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:10
translate ptPT ev_madprophet_var2_15ce3e42:

    # MAD_PROPHET "THE DEMORAI ARE A PLAGUE UPON THIS LAND!"
    MAD_PROPHET "OS DEMORAI SÃO UMA PRAGA SOBRE ESTA TERRA!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:11
translate ptPT ev_madprophet_var2_f121e7ac:

    # MAD_PROPHET "BOUGHT ONTO US FOR THE SIN OF LOSING OUR FAITH IN THE NEW GODS!"
    MAD_PROPHET "TROUXERAM SOBRE NÓS PELO PECADO DE PERDERMOS A FÉ NOS NOVOS DEUSES!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:12
translate ptPT ev_madprophet_var2_db6d9af5:

    # MAD_PROPHET "WHICH FOOLS AMONGST YOU HAVE TURNED BACK TO THE OLD GODS FOR SALVATION?"
    MAD_PROPHET "QUAIS TOLOS DENTRE VOCÊS VOLTARAM AOS DEUSES ANTIGOS POR SALVAÇÃO?"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:13
translate ptPT ev_madprophet_var2_f9b71979:

    # MAD_PROPHET "ONLY ONCE WE HAVE PURGED THE SINNERS BY FIRE AND RESTORED THE TEMPLES AND OUR FAITH TO THE NEW GODS ONCE AGAIN, WILL NEWHEART RETURN TO SAVE US ALL!"
    MAD_PROPHET "SOMENTE QUANDO TIVERMOS PURGADO OS PECADORES PELO FOGO E RESTAURADO OS TEMPLOS E NOSSA FÉ NOS NOVOS DEUSES MAIS UMA VEZ, NEWHEART RETORNARÁ PARA SALVAR A TODOS NÓS!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:14
translate ptPT ev_madprophet_var2_5b184151:

    # "Some in the crowd whistled and loudly applauded to this, the idea that Newheart would return to {i}save us all{/i} remained a popular notion amongst fanatics who deified him."
    "Algumas pessoas na multidão assobiaram e aplaudiram ruidosamente a isso, a ideia de que Newheart retornaria para {i}salvar a todos nós{/i} permaneceu uma noção popular entre os fanáticos que o deificavam."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:15
translate ptPT ev_madprophet_var2_6bc6f540:

    # "...Not that there was any sign yet of his return, of course."
    "...Não que houvesse qualquer sinal de seu retorno, é claro."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:19
translate ptPT ev_madprophet_var3_7f722a0b:

    # MAD_PROPHET "THE FALSE EMPEROR PREACHES TO US ABOUT {i}MILITARY PLANS AND STRATEGY,{/i} YET WHERE IS HIS PLAN FOR OUR CRUMBLING FAITH?"
    MAD_PROPHET "O FALSO IMPERADOR NOS PREGA SOBRE {i}PLANOS E ESTRATÉGIAS MILITARES,{/i} MAS ONDE ESTÁ SEU PLANO PARA NOSSA FÉ EM RUÍNAS?"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:20
translate ptPT ev_madprophet_var3_d341bd4c:

    # MAD_PROPHET "WHERE IS HIS PLAN TO STOP THE DARK TIDE OF BLACK MAGES INFESTING OUR KINGDOM? WHOSE FILTH POISONS THE VERY LAND!"
    MAD_PROPHET "ONDE ESTÁ SEU PLANO PARA PARAR A MARÉ NEGRA DE MAGOS NEGROS INFESTANDO NOSSO REINO? CUJA SUJEIRA ENVENENA A PRÓPRIA TERRA!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:21
translate ptPT ev_madprophet_var3_71581485:

    # MAD_PROPHET "MAKE NO MISTAKE CITIZENS, THIS WAR AND THESE SO CALLED {i}DEMORAI...{/i}"
    MAD_PROPHET "NÃO SE ENGANEM, CIDADÃOS, ESTA GUERRA E ESTES TÃO CHAMADOS {i}DEMORAI...{/i}"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:22
translate ptPT ev_madprophet_var3_f90725db:

    # MAD_PROPHET "THEY ARE NOTHING MORE THAN A CURSE BOUGHT DOWN UPON US!"
    MAD_PROPHET "ELES NÃO SÃO NADA MAIS DO QUE UMA MALDIÇÃO LANÇADA SOBRE NÓS!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:23
translate ptPT ev_madprophet_var3_254427f2:

    # MAD_PROPHET "ONLY THROUGH THE WORSHIP OF THE NEW GODS AND REJECTION OF THE OLD CAN WE HOPE TO END THIS BLIGHT UPON OUR LAND!"
    MAD_PROPHET "SOMENTE ATRAVÉS DA ADORAÇÃO AOS NOVOS DEUSES E DA REJEIÇÃO DOS ANTIGOS PODEMOS ESPERAR ACABAR COM ESTA PRAGA SOBRE NOSSA TERRA!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:24
translate ptPT ev_madprophet_var3_a06dc741:

    # "Some in the crowd whistled and applauded the Mad man while others listened with stoic faces."
    "Alguns na multidão assobiavam e aplaudiam o homem louco enquanto outros ouviam com rostos estoicos."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:25
translate ptPT ev_madprophet_var3_03ce97d1:

    # "The gods were silent, and all our prayers thus far remained unanswered... The idea that they would somehow come down and save us after all this time seemed like fanciful delusions at best, harmful poisonous ideas at worst."
    "Os deuses estavam em silêncio, e todas as nossas preces até agora permaneciam sem resposta... A ideia de que eles de alguma forma desceriam e nos salvariam depois de todo esse tempo parecia, na melhor das hipóteses, ilusões fantasiosas, e na pior, ideias venenosas prejudiciais."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:29
translate ptPT ev_madprophet_var4_b11451d9:

    # MAD_PROPHET "REPENT... REPENT! REPENT! REPENT!"
    MAD_PROPHET "ARREPENDAM-SE... ARREPENDAM-SE! ARREPENDAM-SE! ARREPENDAM-SE!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:30
translate ptPT ev_madprophet_var4_8ea7e21d:

    # MAD_PROPHET "SALVATION FOR ALDERIANS CAN ONLY BE FOUND BY RESTORING OUR FAITH IN THE NEW GODS!"
    MAD_PROPHET "A SALVAÇÃO PARA OS ALDERIANOS SÓ PODE SER ENCONTRADA RESTAURANDO NOSSA FÉ NOS NOVOS DEUSES!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:31
translate ptPT ev_madprophet_var4_1f93e411:

    # MAD_PROPHET "THOSE AMONGST YOU STILL CLINGING TO THE FAITH OF THE OLD GODS HAVE LED US ASTRAY!"
    MAD_PROPHET "AQUELES DENTRE VOCÊS QUE AINDA SE AGARRAM À FÉ DOS VELHOS DEUSES NOS DESENCAMINHARAM!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:32
translate ptPT ev_madprophet_var4_42c9f513:

    # MAD_PROPHET "WE MUST FIND THOSE WHO STILL WORSHIP THE OLD GODS AND PURGE THEM FROM OUR LANDS!"
    MAD_PROPHET "DEVEMOS ENCONTRAR AQUELES QUE AINDA ADORAM OS VELHOS DEUSES E EXPURGÁ-LOS DE NOSSAS TERRAS!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:33
translate ptPT ev_madprophet_var4_90cf8069:

    # MAD_PROPHET "ONLY THEN WILL THE NEW GODS REWARD US WITH OUR SALVATION!"
    MAD_PROPHET "SÓ ENTÃO OS NOVOS DEUSES NOS RECOMPENSARÃO COM A NOSSA SALVAÇÃO!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:34
translate ptPT ev_madprophet_var4_5d3b5e1e:

    # "Some in the crowd clapped and cheered, whilst others, clinging to the edges stared at the Mad Prophet expressionless."
    "Alguns na multidão aplaudiram e vibraram, enquanto outros, agarrados às bordas, encaravam o Profeta Louco sem expressão."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:38
translate ptPT ev_madprophet_var5_3423f21c:

    # MAD_PROPHET "WHEN WAS THE LAST TIME OUR PEOPLE SAW GREAT VICTORIES?"
    MAD_PROPHET "QUANDO FOI A ÚLTIMA VEZ QUE NOSSO POVO VIU GRANDES VITÓRIAS?"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:39
translate ptPT ev_madprophet_var5_a79b0c45:

    # MAD_PROPHET "THE LAND BLEEDS AS WE HIDE BEHIND OUR WALLS AND PIECE BY PIECE, THE DEMORAI CONSUME OUR LANDS!"
    MAD_PROPHET "A TERRA SANGRA ENQUANTO NOS ESCONDEMOS ATRÁS DE NOSSAS MURALHAS E, PEDAÇO POR PEDAÇO, OS DEMORAI CONSOMEM NOSSAS TERRAS!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:40
translate ptPT ev_madprophet_var5_1edea92e:

    # MAD_PROPHET "THE GODS ARE ANGERED WE STRAYED THE PATH AND ALLOWED THE FALSE EMPEROR TO OVERTHROW THE GODS CHOSEN KING!"
    MAD_PROPHET "OS DEUSES ESTÃO FURIOSOS POR NOS DESVIARMOS DO CAMINHO E PERMITIMOS QUE O FALSO IMPERADOR DERRUBASSE O REI ESCOLHIDO PELOS DEUSES!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:41
translate ptPT ev_madprophet_var5_2553b944:

    # MAD_PROPHET "WE MUST RESTORE OUR FAITH ONCE AGAIN IF WE ARE TO HAVE ANY HOPE OF TURNING THE DARK TIDE OF THESE WRETCHED TIMES!"
    MAD_PROPHET "DEVEMOS RESTAURAR NOSSA FÉ MAIS UMA VEZ SE QUISERMOS TER ALGUMA ESPERANÇA DE INVERTER A MARÉ SOMBRIA DESTES TEMPOS DESGRAÇADOS!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:42
translate ptPT ev_madprophet_var5_37329a7f:

    # "There was noticebly not many applause with this speech, as the attention and glares of some passing guards and a inquisitor quickly drained the energy of the crowd."
    "Não houve muitos aplausos neste discurso, já que a atenção e os olhares de alguns guardas que passavam e de um inquisidor rapidamente drenaram a energia da multidão."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:46
translate ptPT ev_madprophet_var6_79d3fbaa:

    # MAD_PROPHET "I SEE RIVERS OF BLOOD AND FIRES BURNING THROUGHOUT THE LAND!"
    MAD_PROPHET "EU VEJO RIOS DE SANGUE E INCÊNDIOS ARDENDO POR TODA A TERRA!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:47
translate ptPT ev_madprophet_var6_f2864eec:

    # MAD_PROPHET "I SEE THE SMOKE RISING FROM THE SHATTERED ARMIES ON THE FINAL BATTLEFIELDS!"
    MAD_PROPHET "EU VEJO A FUMAÇA SUBINDO DOS EXÉRCITOS DESTROÇADOS NOS CAMPOS DE BATALHA FINAIS!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:48
translate ptPT ev_madprophet_var6_6ead09cc:

    # MAD_PROPHET "I SEE OUR FALSE EMPEROR, DOWN ON HIS KNEES AS HE WEEPS WATCHING HIS KINGDOM BURN!"
    MAD_PROPHET "EU VEJO NOSSO FALSO IMPERADOR, DE JOELHOS ENQUANTO CHORA VENDO SEU REINO QUEIMAR!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:49
translate ptPT ev_madprophet_var6_3b9635ab:

    # MAD_PROPHET "ONLY THROUGH RESTORING OUR FAITH IN THE NEW GODS CAN WE SAVE OURSELVES FROM THIS TERRIBLE FATE!"
    MAD_PROPHET "SOMENTE RESTAURANDO NOSSA FÉ NOS NOVOS DEUSES PODEMOS NOS SALVAR DESTE TERRÍVEL DESTINO!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:50
translate ptPT ev_madprophet_var6_a5cd1e67:

    # "Some in the crowd clapped more enthusiastically than others, others murmured fearful about the Mad prophet's word."
    "Alguns na multidão aplaudiram com mais entusiasmo do que outros, outros murmuravam temerosos sobre as palavras do Profeta Louco."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:54
translate ptPT ev_madprophet_var7_6bb279ac:

    # MAD_PROPHET "BLACK MAGES WALK AMONGST US! PRACTITIONERS OF THE OLD GODS!"
    MAD_PROPHET "MAGOS NEGROS ANDAM ENTRE NÓS! PRATICANTES DOS ANTIGOS DEUSES!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:55
translate ptPT ev_madprophet_var7_fd97c62b:

    # MAD_PROPHET "THE FOOLS WOULD CONDEMN US ALL IN THEIR UNSATIBLE APPETITE FOR MORE POWER!"
    MAD_PROPHET "OS TOLOS NOS CONDENARIAM A TODOS EM SEU APETITE INSACIÁVEL POR MAIS PODER!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:56
translate ptPT ev_madprophet_var7_8a479377:

    # MAD_PROPHET "THEIR WICKED ART THAT HAS FLOURISHED THROUGHOUT THE LAND AND THE FAILURE OF OUR SO-CALLED {i}INQUISITOR{/i} HAS LEFT THE NEW GODS FURIOUS!"
    MAD_PROPHET "SUA ARTE PERVERSSA QUE FLORESCEU POR TODA A TERRA E O FRACASSO DO NOSSO SUPOSTO {i}INQUISIDOR{/i} DEIXOU OS NOVOS DEUSES FURIOSOS!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:57
translate ptPT ev_madprophet_var7_c4565f96:

    # MAD_PROPHET "ONLY ONCE WE HAVE PURGED AND EXTERMINATED ALL OF THESE FOUL BEINGS AND RESTORED OUR FAITH IN THE NEW GODS WILL THE DEMORAI PLAGUE CEASE!"
    MAD_PROPHET "SOMENTE QUANDO TIVERMOS PURGADO E EXTERMINADO TODOS ESSES SERES IMUNDOS E RESTAURADO NOSSA FÉ NOS NOVOS DEUSES A PRAGA DEMORAI CESSARÁ!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:58
translate ptPT ev_madprophet_var7_b0c15ff0:

    # "There was some heavy applause and chatter amongst the more religious zealots."
    "Houve aplausos pesados e conversas entre os fanáticos religiosos mais fervorosos."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:59
translate ptPT ev_madprophet_var7_8504cce5:

    # "The topic of Dark Mages always seemed to invoke this kind of blood-thirsty rhetoric, anything short was not met with pleasure by the Inquisitors."
    "O tópico dos Magos Negros sempre parecia invocar esse tipo de retórica sanguinária, qualquer coisa aquém não era bem recebida pelos Inquisidores."

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:63
translate ptPT ev_madprophet_var8_c12400d4:

    # MAD_PROPHET "WHEN THE NEW GODS DETHRONED AND CAST OUT THE WRETCHED OLD GODS, THEY DID SO FOR OUR BENEFIT!"
    MAD_PROPHET "QUANDO OS NOVOS DEUSES DESTRONARAM E EXPULSARAM OS VELHOS DEUSES PERVERSOS, FIZERAM-NO PARA O NOSSO BENEFÍCIO!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:64
translate ptPT ev_madprophet_var8_fd16ecf2:

    # MAD_PROPHET "WE FLOURISHED UNDER THE NEW GODS... AND HOW DID WE THANK THEM?"
    MAD_PROPHET "NÓS FLORESCEMOS SOB OS NOVOS DEUSES... E COMO OS AGRADECEMOS?"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:65
translate ptPT ev_madprophet_var8_54981ab8:

    # MAD_PROPHET "TREACHERY... DISBELIEF... THE TEMPLES SHADOWS OF THEIR FORMER SELVES!"
    MAD_PROPHET "TRAIÇÃO... DESCRENÇA... OS TEMPLOS, SOMBRAS DO QUE FORAM!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:66
translate ptPT ev_madprophet_var8_127b8569:

    # MAD_PROPHET "THE DEMORAI ARE A SICKNESS BOUGHT UPON US FOR OUR FAILURE TO KEEP OUR FAITH!"
    MAD_PROPHET "OS DEMORAI SÃO UMA DOENÇA TRAZIDA SOBRE NÓS PELA NOSSA FALHA EM MANTER A FÉ!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:67
translate ptPT ev_madprophet_var8_07c6f4a7:

    # MAD_PROPHET "REPENT NOW! RESTORE THE TEMPLES AND BURN THE HERETIC DARK MAGES!"
    MAD_PROPHET "ARREPENDEI-VOS AGORA! RESTAURAI OS TEMPLOS E QUEIMAI OS MAGOS NEGROS HEREGES!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:68
translate ptPT ev_madprophet_var8_fc968a07:

    # MAD_PROPHET "ONLY THEN WILL THE NEW GODS RETURN AND SHOW US THE WAY!"
    MAD_PROPHET "SÓ ENTÃO OS NOVOS DEUSES RETORNARÃO E NOS MOSTRARÃO O CAMINHO!"

# game/data/world_events/novaras/mad_prophet/scr_prophet.rpy:69
translate ptPT ev_madprophet_var8_299f69ac:

    # "A couple in the crowd applauded, the rest murmured and debated the mad prophet's words in hushed tones amongst themselves."
    "Um casal na multidão aplaudiu, o resto murmurou e debateu as palavras do profeta louco em tons baixos entre si."

