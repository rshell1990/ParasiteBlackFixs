    MC @ talk "O que isso realmente muda?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:35
translate ptPT ev_Markus_tavern_postTwoEmps_329e2755:

    # MC @ talk "If the Demorai really aren't willing to stop, should people really know?"
    MC @ talk "Se os Demorai realmente não estão dispostos a parar, as pessoas deveriam realmente saber?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:36
translate ptPT ev_Markus_tavern_postTwoEmps_6fc25b58:

    # MC @ talk "I mean, doesn't it make it {i}easier{/i} to fight them thinking they really are just savage beasts?"
    MC @ talk "Quer dizer, não torna {i}mais fácil{/i} lutar contra eles pensando que realmente são apenas bestas selvagens?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:37
translate ptPT ev_Markus_tavern_postTwoEmps_034b71f7:

    # MC @ talk "Do {i}you{/i} really want to be thinking every time we have fight one of those things about who they are?"
    MC @ talk "{i}Você{/i} realmente quer ficar pensando, toda vez que temos que lutar contra uma dessas coisas, sobre quem eles são?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:38
translate ptPT ev_Markus_tavern_postTwoEmps_0fa3928a:

    # MC @ talk "{i}Do they have families? Children and loved ones waiting at home like us? Do they mourn when their brothers and sisters fall?{/i}"
    MC @ talk "{i}Eles têm famílias? Crianças e entes queridos esperando em casa como nós? Eles lamentam quando seus irmãos e irmãs caem?{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:39
translate ptPT ev_Markus_tavern_postTwoEmps_b1427ed4:

    # MC @ talk "Are those the kind of questions you really want to be putting in people's heads during a war?"
    MC @ talk "São essas as perguntas que você realmente quer colocar na cabeça das pessoas durante uma guerra?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:40
translate ptPT ev_Markus_tavern_postTwoEmps_e33600fa:

    # MARKUS @ angry "We've been lied to since we were children, [player_name!t]."
    MARKUS @ angry "Mentiram para nós desde crianças, [player_name!t]."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:41
translate ptPT ev_Markus_tavern_postTwoEmps_df78f4bd:

    # MARKUS @ angry "Who knows what else they've been keeping from us."
    MARKUS @ angry "Quem sabe o que mais eles têm escondido de nós."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:43
translate ptPT ev_Markus_tavern_postTwoEmps_f0f60350:

    # MC @ talk "That Demorai... That girl back in those ruins, Sypha."
    MC @ talk "Aquela Demorai... Aquela garota lá nas ruínas, Sypha."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:45
translate ptPT ev_Markus_tavern_postTwoEmps_40666aed:

    # MC @ talk "She led us out safely like she said she would."
    MC @ talk "Ela nos conduziu para fora em segurança, como disse que faria."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:46
translate ptPT ev_Markus_tavern_postTwoEmps_0750dbb7:

    # MC @ talk "AND she showed a willingness to work together... That means there has to be hope for other Demorai to do the same."
    MC @ talk "E ela mostrou disposição para trabalhar juntos... Isso significa que deve haver esperança de que outros Demorai façam o mesmo."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:48
translate ptPT ev_Markus_tavern_postTwoEmps_4f5c25bc:

    # MC @ talk "She tried to help us and... We didn't listen."
    MC @ talk "Ela tentou nos ajudar e... Nós não ouvimos."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:49
translate ptPT ev_Markus_tavern_postTwoEmps_e7a5d09d:

    # MC @ talk "{i}She was telling the truth.{/i}"
    MC @ talk "{i}Ela estava dizendo a verdade.{/i}"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:50
translate ptPT ev_Markus_tavern_postTwoEmps_b4a91270:

    # MC @ talk "If we can't keep our minds open at all to even the {i}possibility{/i} of negotiations or peace, we rule them out entirely before they have a chance."
    MC @ talk "Se não conseguimos manter a mente aberta nem mesmo para a {i}possibilidade{/i} de negociações ou paz, nós as descartamos totalmente antes que tenham uma chance."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:51
translate ptPT ev_Markus_tavern_postTwoEmps_02222f86:

    # MARKUS "So, you {i}do{/i} think there's a chance for peace talks?"
    MARKUS "Então, você {i}realmente{/i} acha que há uma chance de conversas de paz?"

