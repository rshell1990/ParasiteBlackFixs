    MC @ talk "Sempre soubemos que estávamos sendo enganados sobre certas coisas."

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:29
translate ptPT ev_Markus_tavern_postTwoEmps_b12d1541:

    # MARKUS @ angry "Not this! Not fucking this!"
    MARKUS @ angry "Isso não! Isso não, caralho!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:30
translate ptPT ev_Markus_tavern_postTwoEmps_95a99166:

    # MARKUS "Surely you can't agree with what they've done?"
    MARKUS "Certamente você não pode concordar com o que eles fizeram?"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:33
translate ptPT ev_Markus_tavern_postTwoEmps_c399b696:

    # MARKUS @ angry "What? How can you say that!"
    MARKUS @ angry "O quê? Como você pode dizer isso!"

# game/data/world_events/novaras/markus_tavern_post_twoEmperors/scr_0.rpy:34
translate ptPT ev_Markus_tavern_postTwoEmps_a2cc5969:

