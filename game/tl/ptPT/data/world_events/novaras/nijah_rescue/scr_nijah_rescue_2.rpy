translate ptPT evscr_nijah_rescue_2_cee23ab1:

    # UNKNOWN "T-Thank you stranger."
    UNKNOWN "O-Obrigada, estranho."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:16
translate ptPT evscr_nijah_rescue_2_607f82ee:

    # MC @ talk "Here, let me help you up."
    MC @ talk "Aqui, deixe-me ajudá-la a se levantar."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:17
translate ptPT evscr_nijah_rescue_2_cd373b13:

    # "With my hand out-stretched, I reached out and held her soft hand as I gently pulled her back to her feet."
    "Com a mão estendida, peguei sua mão macia e a puxei gentilmente de volta para os pés."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:18
translate ptPT evscr_nijah_rescue_2_63c5e807:

    # MC @ talk "Did they hurt you?"
    MC @ talk "Eles te machucaram?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:19
translate ptPT evscr_nijah_rescue_2_177e3578:

    # UNKNOWN "No, I iz fine..."
    UNKNOWN "Não, estou bem..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:20
translate ptPT evscr_nijah_rescue_2_4d72dedb:

    # "As the woman unwrapped her headscarf to look at me, her eyes now settling from the panic fear."
    "Enquanto a mulher desenrolava o lenço da cabeça para me olhar, seus olhos agora se acalmando do pânico e medo."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:23
translate ptPT evscr_nijah_rescue_2_90c622eb:

    # "I immediately recognised who she was."
    "Imediatamente reconheci quem ela era."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:24
translate ptPT evscr_nijah_rescue_2_e5cfdaf0:

    # MC @ talk "You... You're that woman I met at the pleasure district!"
    MC @ talk "Você... Você é aquela mulher que eu conheci no distrito do prazer!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:25
translate ptPT evscr_nijah_rescue_2_9de1b7a2:

    # "The woman looked at me quizzically for a moment, not quite able to place my face."
    "A mulher me olhou interrogativamente por um momento, sem conseguir reconhecer meu rosto."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:26
translate ptPT evscr_nijah_rescue_2_74a6ea16:

    # MC @ talk "... Nijah?"
    MC @ talk "... Nijah?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:27
translate ptPT evscr_nijah_rescue_2_56014db0:

    # "Her eyes squinted towards me before recognition dawned on her face as well."
    "Os olhos dela se apertaram na minha direção antes que o reconhecimento também surgisse em seu rosto."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:29
translate ptPT evscr_nijah_rescue_2_aed3993e:

    # NIJAH "You... You were za boy..."
    NIJAH "Você... Você era o garoto..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:30
translate ptPT evscr_nijah_rescue_2_6e091bb8:

    # NIJAH "The one joining zer Scouts..."
    NIJAH "Aquele que se juntou aos Scouts..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:31
translate ptPT evscr_nijah_rescue_2_aa308a53:

    # NIJAH "... You looks zerrrr..."
    NIJAH "... Você parece..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:32
translate ptPT evscr_nijah_rescue_2_f8144a4e:

    # NIJAH "{i}Different?{/i}"
    NIJAH "{i}Diferente?{/i}"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:33
translate ptPT evscr_nijah_rescue_2_cbb2fa12:

    # MC @ talk "Yeah, uh... it’s a long story."
    MC @ talk "Sim, uh... é uma longa história."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:34
translate ptPT evscr_nijah_rescue_2_3c1cb32d:

    # MC @ talk "Listen, we can’t stay here, okay?"
    MC @ talk "Escuta, não podemos ficar aqui, certo?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:35
translate ptPT evscr_nijah_rescue_2_36980459:

    # MC @ talk "Come with me."
    MC @ talk "Vem comigo."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:36
translate ptPT evscr_nijah_rescue_2_d1b6f294:

    # "Holding out my hand once again, Nijah reached out to gently take it, still slightly shaking in fear."
    "Estendendo minha mão mais uma vez, Nijah estendeu a mão para pegá-la gentilmente, ainda tremendo um pouco de medo."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:37
translate ptPT evscr_nijah_rescue_2_2c647830:

    # "By hand, I led her out of the alleys and towards the main streets once again, away from what had just happened."
    "Pela mão, eu a conduzi para fora dos becos e em direção às ruas principais novamente, longe do que tinha acabado de acontecer."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:38
translate ptPT evscr_nijah_rescue_2_97e6c1f8:

    # NIJAH "Where are zu taking me?"
    NIJAH "Aonde você está me levando?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:39
translate ptPT evscr_nijah_rescue_2_e6f22d0d:

    # MC @ talk "Somewhere safe we can talk..."
    MC @ talk "Algum lugar seguro onde possamos conversar..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:42
translate ptPT evscr_nijah_rescue_2_da170cde:

    # "The beautiful dark tanned beauty looked up to me, eyes bright as her lip quivered."
    "A bela de pele morena escura olhou para mim, com os olhos brilhantes e os lábios trêmulos."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:43
translate ptPT evscr_nijah_rescue_2_a85d10dc:

    # MC @ talk "My name is [player_name!t]."
    MC @ talk "Meu nome é [player_name!t]."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:44
translate ptPT evscr_nijah_rescue_2_acf9b5aa:

    # UNKNOWN "I... I am Nijah."
    UNKNOWN "Eu... eu sou Nijah."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:45
translate ptPT evscr_nijah_rescue_2_fcd69050:

    # "Looking around to see the prying eyes watching from the windows, I knew it could quickly become dangerous here if we didn't leave soon."
    "Olhando ao redor para ver os olhares curiosos observando das janelas, eu sabia que poderia se tornar perigoso aqui rapidamente se não saíssemos logo."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:46
translate ptPT evscr_nijah_rescue_2_bf2088f4:

    # MC @ talk "Well Nijah, I don't think it's safe to stay here."
    MC @ talk "Bem, Nijah, acho que não é seguro ficar aqui."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:47
translate ptPT evscr_nijah_rescue_2_e3c99b27:

    # MC @ talk "You should come with me."
    MC @ talk "Você deveria vir comigo."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:48
translate ptPT evscr_nijah_rescue_2_d1b6f294_1:

    # "Holding out my hand once again, Nijah reached out to gently take it, still slightly shaking in fear."
    "Estendendo minha mão mais uma vez, Nijah a alcançou para segurá-la delicadamente, ainda trêmula de medo."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:49
translate ptPT evscr_nijah_rescue_2_2c647830_1:

    # "By hand, I led her out of the alleys and towards the main streets once again, away from what had just happened."
    "Pela mão, conduzi-a para fora dos becos e de volta às ruas principais, para longe do que acabara de acontecer."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:51
translate ptPT evscr_nijah_rescue_2_97e6c1f8_1:

    # NIJAH "Where are zu taking me?"
    NIJAH "Onde você está me levando?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:52
translate ptPT evscr_nijah_rescue_2_7ef8cfa8:

    # MC @ talk "Somewhere safe, away from here..."
    MC @ talk "Em algum lugar seguro, longe daqui..."

