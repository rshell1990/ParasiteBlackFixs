# game/data/world_interactions/black_diamond_arena/aio.rpy:38
translate ptPT black_diamond_arena_firstEnter_2471c171:

    # "As I stumbled down the flight of stairs, I heard the bellowing roar of cheers and something snarling down below."
    "Enquanto eu tropeçava pela escada, ouvi o rugido ensurdecedor de aplausos e algo rosnando lá embaixo."

# game/data/world_interactions/black_diamond_arena/aio.rpy:39
translate ptPT black_diamond_arena_firstEnter_1352313f:

    # "Coming upon a great darkened underground Arena, men gathered around and cheered as two reptilian beasts slashed and tore at each other in the fight pit below."
    "Chegando a uma grande arena subterrânea escura, homens se reuniram e aplaudiam enquanto duas feras reptilianas se cortavam e dilaceravam na arena de luta abaixo."

# game/data/world_interactions/black_diamond_arena/aio.rpy:40
translate ptPT black_diamond_arena_firstEnter_8b799890:

    # "The one leapt and gripped the others throat with its teeth, ripping it out in a violent bloody display that the crowd roared with pleasure too."
    "Um saltou e agarrou a garganta do outro com os dentes, arrancando-a em uma exibição violenta e sangrenta que a multidão também rugiu de prazer."

# game/data/world_interactions/black_diamond_arena/aio.rpy:41
translate ptPT black_diamond_arena_firstEnter_b2c9c7fd:

    # MC "(What is this place?)"
    MC "(O que é este lugar?)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:45
translate ptPT black_diamond_arena_firstEnter_51fba3e4:

    # BOOKKEEPER "Oi!"
    BOOKKEEPER "Ei!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:46
translate ptPT black_diamond_arena_firstEnter_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "Hein?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:47
translate ptPT black_diamond_arena_firstEnter_557daccb:

    # BOOKKEEPER "Zer are no freeloaders! Either place a bet, or fuck off!"
    BOOKKEEPER "Não há folgados! Ou faz uma aposta, ou cai fora!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:48
translate ptPT black_diamond_arena_firstEnter_fc48861a:

    # MC @ talk "A bet?"
    MC @ talk "Uma aposta?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:49
translate ptPT black_diamond_arena_firstEnter_6faeae54:

    # BOOKKEEPER "Iz stupid or something?"
    BOOKKEEPER "É estúpido ou algo?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:56
translate ptPT black_diamond_bookkeeper_talk_2fb4960b:

    # BOOKKEEPER "No. You off limit. Come back in a few dayz."
    BOOKKEEPER "Não. Você está proibido de entrar. Volte em alguns dias."

# game/data/world_interactions/black_diamond_arena/aio.rpy:57
translate ptPT black_diamond_bookkeeper_talk_615eedc7:

    # MC "Okay."
    MC "Certo."

# game/data/world_interactions/black_diamond_arena/aio.rpy:59
translate ptPT black_diamond_bookkeeper_talk_73727c63:

    # BOOKKEEPER "Beasts fight below, you bet."
    BOOKKEEPER "As feras lutam lá embaixo, você aposta."

# game/data/world_interactions/black_diamond_arena/aio.rpy:60
translate ptPT black_diamond_bookkeeper_talk_376ff848:

    # BOOKKEEPER "Your beast wins, you get coin."
    BOOKKEEPER "Sua fera vence, você ganha moedas."

# game/data/world_interactions/black_diamond_arena/aio.rpy:61
translate ptPT black_diamond_bookkeeper_talk_cba48cb5:

    # BOOKKEEPER "Zat's it, you want bet?"
    BOOKKEEPER "É isso, quer apostar?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:64
translate ptPT black_diamond_bookkeeper_talk_menu_26b1e50b:

    # BOOKKEEPER "How much?"
    BOOKKEEPER "Quanto?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:76
translate ptPT black_diamond_bookkeeper_talk_menu_8a0c5ec4:

    # BOOKKEEPER "Very good!"
    BOOKKEEPER "Muito bem!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:77
translate ptPT black_diamond_bookkeeper_talk_menu_83429a1e:

    # BOOKKEEPER "Enjoy fight! Collect coin after if win!"
    BOOKKEEPER "Divirta-se com a luta! Pegue as moedas depois, se vencer!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:80
translate ptPT black_diamond_bookkeeper_talk_menu_577c9037:

    # BOOKKEEPER "Rules iz simple!"
    BOOKKEEPER "Regras é simples!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:81
translate ptPT black_diamond_bookkeeper_talk_menu_824d265f:

    # BOOKKEEPER "You bet on either creature to win, first to kill zer other wins."
    BOOKKEEPER "Você aposta em qualquer criatura para vencer, a primeira a matar a outra vence."

# game/data/world_interactions/black_diamond_arena/aio.rpy:82
translate ptPT black_diamond_bookkeeper_talk_menu_ba9aaef0:

    # BOOKKEEPER "Az newbie, you iz only able to bet one thousand coins a week."
    BOOKKEEPER "Como novato, você só pode apostar mil moedas por semana."

# game/data/world_interactions/black_diamond_arena/aio.rpy:83
translate ptPT black_diamond_bookkeeper_talk_menu_ec70c2c2:

    # BOOKKEEPER "Coin pay upfront before bet go on."
    BOOKKEEPER "Pague a moeda adiantado antes que a aposta prossiga."

# game/data/world_interactions/black_diamond_arena/aio.rpy:84
translate ptPT black_diamond_bookkeeper_talk_menu_b6289d56:

    # MC @ talk "That seems odd, why the limit?"
    MC @ talk "Isso parece estranho, por que o limite?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:85
translate ptPT black_diamond_bookkeeper_talk_menu_40d9f557:

    # BOOKKEEPER "Too many try cheat."
    BOOKKEEPER "Muitos tentam trapacear."

# game/data/world_interactions/black_diamond_arena/aio.rpy:86
translate ptPT black_diamond_bookkeeper_talk_menu_2ade3781:

    # BOOKKEEPER "One try poisoning a beasty and placing huge bet on other."
    BOOKKEEPER "Um tentou envenenar uma criatura e apostar alto na outra."

# game/data/world_interactions/black_diamond_arena/aio.rpy:87
translate ptPT black_diamond_bookkeeper_talk_menu_f8b9be59:

    # BOOKKEEPER "Now, only trusted members can make big bets."
    BOOKKEEPER "Agora, apenas membros confiáveis podem fazer grandes apostas."

# game/data/world_interactions/black_diamond_arena/aio.rpy:90
translate ptPT black_diamond_bookkeeper_talk_menu_b72566e1:

    # BOOKKEEPER "Than leave already!"
    BOOKKEEPER "Então vá embora já!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:108
translate ptPT black_diamond_arena_fight_349520bc:

    # MC "(Damn... I lost.)"
    MC "(Droga... Eu perdi.)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:110
translate ptPT black_diamond_arena_fight_3b26aa88:

    # MC "(Well... That's wasn't the easiest thing to watch.)"
    MC "(Bem... Isso não foi a coisa mais fácil de se ver.)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:111
translate ptPT black_diamond_arena_fight_e66f7113:

    # MC "(Looks like I won though!)"
    MC "(Mas parece que eu ganhei!)"

