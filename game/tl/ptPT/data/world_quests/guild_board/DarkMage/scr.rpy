# game/data/world_quests/guild_board/DarkMage/scr.rpy:194
translate ptPT qst_guild_darkmage_wall_enter_menu_e1b08a29:

    # "Looking over at his research notes, I figured that if I can find a buyer, they could make a pretty coin."
