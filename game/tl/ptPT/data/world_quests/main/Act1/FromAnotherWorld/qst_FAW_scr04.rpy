    MARKUS "Estou tentando canalizar meus pensamentos para focar!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:100
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_45dd95ce:

