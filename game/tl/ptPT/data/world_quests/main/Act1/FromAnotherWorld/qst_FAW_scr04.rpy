    VES @ talk "Humilhação, genocídio e estupro nas mãos da ‘Grande Companhia de Comércio’ de vocês humanos."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:373
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_e5eac3f6:

    # VES @ talk "Yet WE are the ones baying for blood?"
    VES @ talk "No entanto, NÓS somos os que clamam por sangue?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:374
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_91d75c2c:

    # MARKUS "Those lot are nothing to do with Alderay!"
    MARKUS "Esses aí não têm nada a ver com Alderay!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:375
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_ef3d9a11:

    # VES @ talk "Lies! We know of your trades; you aid the slave masters wherever you can, for gold is all you humans care for!"
    VES @ talk "Mentiras! Sabemos de seus negócios; vocês ajudam os mestres escravistas sempre que podem, pois ouro é tudo com que vocês humanos se importam!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:376
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_9cef8231:

    # VES @ talk "We will not help you win some war that does not concern us just to trade one master for another!"
    VES @ talk "Não vamos ajudá-los a vencer uma guerra que não nos diz respeito apenas para trocar um mestre por outro!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:377
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_91bec22b:

    # MARKUS "Oh, how noble of you! How very fucking noble! Well, I’m glad you’ve clearly made peace with sitting back and allowing the continued mindless slaughter of innocent men, women and children!"
    MARKUS "Oh, que nobre da sua parte! Que porra de nobreza! Bem, fico feliz que você claramente tenha feito as pazes com ficar de braços cruzados e permitir o contínuo massacre sem sentido de homens, mulheres e crianças inocentes!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:378
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_b283f5aa:

    # MARKUS "You’re nothing more than glorified bandits on a fucking martyrdom course!"
    MARKUS "Vocês não passam de bandidos glorificados numa porra de curso de martírio!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:379
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_810ac15c:

    # "Ves scowled, the two seemed ready to fight there and then."
    "Ves fez uma careta, os dois pareciam prontos para lutar ali mesmo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:380
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_e21407f4:

    # MC @ talk "Hey, hey! Both of you, settle down..."
    MC @ talk "Ei, ei! Vocês dois, acalmem-se..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:381
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_be283dc6:

    # MC @ talk "The real enemy is the Demorai, REMEMBER that."
    MC @ talk "O verdadeiro inimigo é o Demorai, LEMBRE-SE disso."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:382
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_9baa98b0:

    # VES @ talk "...{i}*Sigh*{/i}"
    VES @ talk "...{i}*Suspiro*{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:383
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_e003c46b:

    # MC @ talk "Do you live nearby?"
    MC @ talk "Você mora por perto?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:384
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_4999deb8_1:

    # VES @ talk "..."
    VES @ talk "..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:385
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_ab534fc9:

    # MC @ talk "We mean you no harm."
    MC @ talk "Não lhe faremos mal."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:386
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_d2f6cd4f:

    # MC @ talk "Ves answered hesitantly."
    MC @ talk "Ves respondeu hesitante."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:387
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_a7a9e275:

    # VES @ talk "I have my own camp, yes."
    VES @ talk "Eu tenho meu próprio acampamento, sim."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:388
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_fa13c08a:

    # MC @ talk "Then let us escort you there."
    MC @ talk "Então nos deixe acompanhá-lo até lá."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:389
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_3618aa06:

    # VES @ talk "I’m fine."
    VES @ talk "Estou bem."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:390
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_fd038f47:

    # MC @ talk "You’re hurt."
    MC @ talk "Você está ferido."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:391
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_87a37788:

    # MC @ talk "And you have no idea how many other Demorai linger."
    MC @ talk "E você não tem ideia de quantos outros Demorai permanecem."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:392
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_d0daa289:

    # MC @ talk "Ves sized me up as she tried to decipher whether I was telling the truth or not."
    MC @ talk "Ves me avaliou enquanto tentava decifrar se eu estava falando a verdade ou não."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:393
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_8a6cda6d:

    # VES @ talk "How do I know you won’t just send other humans after me once I’ve shown you the camp?"
    VES @ talk "Como eu sei que você não vai simplesmente enviar outros humanos atrás de mim depois que eu tiver mostrado o acampamento?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:394
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_cab756f3:

    # MC @ talk "Because you’ve seen our other forms."
    MC @ talk "Porque você viu nossas outras formas."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:395
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_f91c8b09:

    # MC @ talk "They’re just as likely to imprison or kill us as they are you."
    MC @ talk "Eles são tão propensos a nos aprisionar ou matar quanto a você."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:396
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_318a1947:

    # VES @ talk "... Fine."
    VES @ talk "... Está bem."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:397
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_7dca5bb3:

    # VES @ talk "But only because you are not fully human, I lend you this trust."
    VES @ talk "Mas apenas porque você não é totalmente humano, eu lhe concedo essa confiança."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:399
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_f504d473:

    # "I nodded in understanding."
    "Eu assenti em compreensão."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:400
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_d38b4da3:

    # VES @ talk "Stay a few feet behind me..."
    VES @ talk "Fique alguns passos atrás de mim..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:401
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_7330bee0:

    # VES @ talk "I trust neither of you THAT much."
    VES @ talk "Eu não confio em nenhum de vocês TANTO assim."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:402
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_d8414235:

    # "Ves began to march across the hot desert sand as Markus placed his hand on my shoulder from behind."
    "Ves começou a marchar pela areia quente do deserto enquanto Markus colocava a mão no meu ombro por trás."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:404
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_57043d3c:

    # MARKUS "And now..."
    MARKUS "E agora..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:405
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_e05217fb:

    # MARKUS "We’re willingly following her into an orc ambush... Great."
    MARKUS "Estamos seguindo-a voluntariamente para uma emboscada de orcs... Ótimo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:406
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_67c8c556:

    # MC @ talk "You don’t know that."
    MC @ talk "Você não sabe disso."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:407
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_2b83dcd7:

    # MARKUS "She’s an orc, or have you forgotten Kalliban’s first war?"
    MARKUS "Ela é uma orc, ou você esqueceu a primeira guerra de Kalliban?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:408
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_5a06cd1f:

    # "Markus trapsed on ahead, letting his displeasure with the situation be known with every step."
    "Markus seguiu em frente, deixando transparecer seu descontentamento com a situação a cada passo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:409
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_2e68127a:

    # MARKUS "She’s the last thing we should be trusting..."
    MARKUS "Ela é a última coisa em que deveríamos confiar..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:411
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_7173cdcb:

    # "After about twenty minutes of wandering through the hot desert, we finally arrived at Ves’ camp."
    "Depois de cerca de vinte minutos vagando pelo deserto quente, finalmente chegamos ao acampamento de Ves."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:421
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_fdfee624:

    # "It was small but well-equipped from the outside."
    "Era pequeno, mas bem equipado por fora."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:422
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_ec1cb5b9:

    # "A large tent had been erected, with some stones cobbled together around what looked to be a hastily constructed spit roast fire that was burning in an almost cheerful manner."
    "Uma grande tenda havia sido montada, com algumas pedras juntas ao redor do que parecia ser uma fogueira de espeto feita às pressas, que ardia de maneira quase alegre."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:423
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_252c94a6:

    # "Littered around the place was the occasional bowl that, presumably, she kept out to gather what water she could when it rained."
    "Espalhadas pelo lugar estavam tigelas ocasionais que, presumivelmente, ela deixava para recolher a água que pudesse quando chovia."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:424
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_c6230fe6:

    # VES @ talk "Well, this is my camp."
    VES @ talk "Bem, este é o meu acampamento."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:425
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_7ae53218:

    # VES @ talk "Thank you for... your assistance."
    VES @ talk "Obrigado por... sua ajuda."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:426
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_2a91549c:

    # VES @ talk "Here, take this."
    VES @ talk "Aqui, pegue isso."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:432
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_446a87c0:

    # VES @ talk "From my many salvage exploits in this land."
    VES @ talk "De minhas muitas explorações de salvamento nesta terra."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:433
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_b4e00217:

    # MARKUS "You never told us what you’re doing all the way out here."
    MARKUS "Você nunca nos contou o que está fazendo aqui tão longe."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:434
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_8787c2d8:

    # VES @ talk "I am lost from my clan."
    VES @ talk "Estou perdido do meu clã."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:435
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_eb72ccf2:

    # MC @ talk "You mean there’s more of you?"
    MC @ talk "Quer dizer que há mais de vocês?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:436
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_9ad80ba1:

    # MARKUS "Oh great... more of you."
    MARKUS "Ah, ótimo... mais de vocês."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:437
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_311d15dc:

    # "Ves growled, not quite under her breath."
    "Ves rosnou, não exatamente baixinho."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:438
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_39b039a2:

    # VES @ talk "I will say no more."
    VES @ talk "Não direi mais nada."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:439
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_77d7f3b2:

    # MC @ talk "Do you know where the others went?"
    MC @ talk "Você sabe para onde os outros foram?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:440
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_b6a04c88:

    # VES @ talk "No... We were separated while moving camp."
    VES @ talk "Não... Fomos separados enquanto mudávamos o acampamento."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:441
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_2e8ee320:

    # VES @ talk "I am alone."
    VES @ talk "Estou sozinha."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:442
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_28d8e035:

    # "Markus didn’t seem to entirely believe her story, but he didn’t argue with it either."
    "Markus não parecia acreditar totalmente na história dela, mas também não discutiu."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:443
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_331311b2:

    # MARKUS "Well, as fun as this has been..."
    MARKUS "Bem, por mais divertido que isso tenha sido..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:444
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_905cc806:

    # MARKUS "We must get back to Novaras soon."
    MARKUS "Precisamos voltar logo para Novaras."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:445
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_775fe98e:

    # "As Markus turned to leave, I couldn’t help but ask Ves..."
    "Quando Markus se virou para sair, não pude deixar de perguntar a Ves..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:446
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_eaa19993:

    # MC @ talk "Would you mind me coming to check in on you sometime if I’m out this way?"
    MC @ talk "Você se importaria se eu viesse dar uma olhada em você algum dia, se eu estiver por esta região?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:447
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_a787910b:

    # VES @ talk "... Why?"
    VES @ talk "... Por quê?"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:448
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_597402b2:

    # MC @ talk "I’m worried about you being out here on your own like this, it’s dangerous."
    MC @ talk "Estou preocupado com você estar aqui sozinho assim, é perigoso."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:449
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_fea238c3:

    # VES @ talk "It’s more dangerous to move in large groups."
    VES @ talk "É mais perigoso mover-se em grandes grupos."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:450
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_57f23063:

    # VES @ talk "I am fine, I can take care of myself."
    VES @ talk "Estou bem, posso cuidar de mim mesmo."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:451
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_bc5fff60:

    # "Ves sighed and relented slightly."
    "Ves suspirou e cedeu um pouco."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:452
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_7e74d92d:

    # VES @ talk "But..."
    VES @ talk "Mas..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:453
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_5651fc94:

    # VES @ talk "Do as you wish."
    VES @ talk "Faça como quiser."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:454
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_8c115df7:

    # VES @ talk "I will welcome you if you come."
    VES @ talk "Eu te receberei bem se você vier."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:455
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_48384169:

    # "Markus gave me a {i}look.{/i}"
    "Markus me deu um {i}olhar.{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:456
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_94d2e812:

    # MARKUS "Okay, I'll be heading out back to Novaras."
    MARKUS "Certo, estou voltando para Novaras."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:457
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_362f6e55:

    # MARKUS "Meet me at the tavern later, [player_name!t]."
    MARKUS "Encontre-me na taverna mais tarde, [player_name!t]."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:458
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_afe1882c:

    # MARKUS "We have to figure out what to do next."
    MARKUS "Temos que descobrir o que fazer a seguir."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:459
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_778cdb73:

    # MARKUS "Goodbye."
    MARKUS "Adeus."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:460
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_f041bd88:

    # MARKUS "And you, orc lady."
    MARKUS "E você, senhora orc."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:462
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_43de5b53:

    # "Markus left, leaving us two alone in the Valley."
    "Markus foi embora, deixando nós dois sozinhos no Vale."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:464
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_9f4e4d23:

    # "Indifferent to me, Ves headed off to her tent and slid inside."
    "Indiferente a mim, Ves foi para sua tenda e entrou."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:465
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_768bbe64:

    # MC "...Some day."
    MC "...Algum dia."

