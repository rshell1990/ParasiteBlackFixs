    MARKUS "Consegues senti-lo? É como fogo nas minhas veias!"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:142
translate ptPT qst_FromAnotherWorld_GoToValleyWithMarkus_1dfde4e8:

    # MC "I feel... {i}strong,{/i}"
    MC "Sinto-me... {i}forte,{/i}"

