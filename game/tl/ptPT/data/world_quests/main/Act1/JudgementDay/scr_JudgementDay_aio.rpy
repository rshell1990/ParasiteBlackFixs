    NYX @ angry "Consegui trazer mais guardas para defender a cidade, mas os inquisidores continuaram a bloquear as buscas por mais ninhos daquelas bestas imundas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:55
translate ptPT qst_JudgementDay_SiegeStart_af24b38a:

    # MC @ angry "What about Markus? Where is-"
    MC @ angry "E o Markus? Onde está-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:58
translate ptPT qst_JudgementDay_SiegeStart_54b023b2:

    # NYX @ angry "I need you with me, damn it!"
    NYX @ angry "Preciso de você comigo, droga!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:59
