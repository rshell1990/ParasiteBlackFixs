    ERIKA "Concentre-se. Estamos quase no topo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1857
translate ptPT qst_JudgementDay_GotToTheWall_a17a25b5:

    # "After a few agonizing minutes, the lift finally came to a grinding halt."
    "Depois de alguns minutos agonizantes, o elevador finalmente parou com um rangido."

