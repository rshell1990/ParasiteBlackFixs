    # MC "Myu! Markus—have you seen him?"
    MC "Myu! Markus—você o viu?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:261
translate ptPT qst_JudgementDay_SiegeStart_23258adb:

    # "Myu shook her head."
