    "O príncipe agarrou-se firmemente ao Cavaleiro de Prata, tremendo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1808
translate ptPT qst_JudgementDay_RescueMages_MoveOn_f110ccdb:

    # SILVER_KNIGHT "I will keep you safe, Naran."
    SILVER_KNIGHT "Eu o manterei seguro, Naran."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1810
translate ptPT qst_JudgementDay_RescueMages_MoveOn_5346539a:

    # SILVER_KNIGHT "But we must move now."
    SILVER_KNIGHT "Mas precisamos nos mover agora."

