translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_088be4d0:

    # HIRRAH "Or is it, {i}Shyahtan?{/i}"
    HIRRAH "Ou seria, {i}Shyahtan?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3699
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_d745a6ac:

    # "The strange being seemed to chuckle, her soft voice so strangely hypnotic and soothing."
    "O estranho ser pareceu rir, sua voz suave tão estranhamente hipnótica e calmante."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3700
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_4989ee90:

    # HIRRAH "Always so hard to keep up these days."
    HIRRAH "Sempre tão difícil de acompanhar nos dias de hoje."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3701
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_82579f71:

    # PHOAH @ angry "We're wasting time, Hirrah."
    PHOAH @ angry "Estamos perdendo tempo, Hirrah."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3702
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_e85088b4:

    # HIRRAH "The last thing we need is to frighten him."
    HIRRAH "A última coisa que precisamos é assustá-lo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3703
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_5800b448:

    # MC "Who... Who are you both?"
    MC "Quem... Quem são vocês dois?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3704
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_fad590e3:

    # MC "What am I doing here?!"
    MC "O que estou fazendo aqui?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3705
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_270e83dd:

    # PHOAH @ angry "See? Now the human is panicking anyway!"
    PHOAH @ angry "Viu? Agora o humano está em pânico de qualquer forma!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3706
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_c5966931:

    # HIRRAH "Human might be quite the stretch given the circumstances."
    HIRRAH "Humano pode ser um exagero, dadas as circunstâncias."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3707
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_914501fa:

    # MC "W-Where am I?"
    MC "O-Onde estou?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3708
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_8899306e:

    # MC "What is this place??"
    MC "O que é este lugar??"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3709
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_3249a9fb:

    # MC "WHO ARE YOU?"
    MC "QUEM SÃO VOCÊS?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3710
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_b8c817a1:

    # PHOAH @ talk "{i}*Sigh*{/i}"
    PHOAH @ talk "{i}*Suspiro*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3711
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_03dbc9d5:

    # PHOAH @ angry "I am Phoah, goddess of justice."
    PHOAH @ angry "Eu sou Phoah, deusa da justiça."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3712
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_2025b956:

    # PHOAH @ talk "This is Hirrah, goddess of fertility."
    PHOAH @ talk "Esta é Hirrah, deusa da fertilidade."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3713
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_9ef7dad6:

    # "I stared at the strange beings before me in disbelief."
    "Olhei para os seres estranhos à minha frente, incrédulo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3714
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_741be655:

    # "Were they..."
    "Seriam eles..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3715
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_3e1c9fce:

    # "No, gods and goddesses... Such a ridiculous thing!"
    "Não, deuses e deusas... Que coisa ridícula!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3716
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_901a1c10:

    # "This was nothing but some fever dream! A trick of the mind! A-"
    "Isso não era nada além de um sonho febril! Um truque da mente! Um-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3717
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_390ecba2:

    # PHOAH @ talk "We're real."
    PHOAH @ talk "Somos reais."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3718
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_6ddce6b3:

    # MC "You... You can hear my thoughts?"
    MC "Você... Você pode ouvir meus pensamentos?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3719
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_10192e1c:

    # HIRRAH "This place is not real, rather, a neural link projection we've created to speak to you."
    HIRRAH "Este lugar não é real, mas sim uma projeção de link neural que criamos para falar com você."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3720
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_8749ecba:

    # MC "...{i}A what?{/i}"
    MC "...{i}Um quê?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3721
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_601508d9:

    # HIRRAH "... I-"
    HIRRAH "… Eu-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3722
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_826861e5:

    # HIRRAH "It matters not."
    HIRRAH "Não importa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3723
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_fda2299b:

    # PHOAH @ angry "Look, human, we need your help."
    PHOAH @ angry "Olhe, humano, precisamos de sua ajuda."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3724
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_a6825e69:

    # MC "{i}Me?{/i}"
    MC "{i}Eu?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3725
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_36f9cc51:

    # PHOAH @ talk "Listen carefully, human."
    PHOAH @ talk "Ouça com atenção, humano."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3726
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_c0534bbf:

    # PHOAH @ talk "This world... It has become the focus of the great deciever's dark plan."
    PHOAH @ talk "Este mundo... Tornou-se o foco do plano sombrio do grande enganador."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3727
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_eabc2515:

    # MC "{i}... The great deciever?{/i}"
    MC "{i}... O grande enganador?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3728
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_de037a92:

    # "The goddess' hands tightened into tight fists."
    "As mãos da deusa cerraram-se em punhos firmes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3729
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_9fb2387c:

    # PHOAH @ angry "The lord of lies..."
    PHOAH @ angry "O senhor das mentiras..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3730
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_024f2b0d:

    # PHOAH @ angry "{b}Malakai.{/b}"
    PHOAH @ angry "{b}Malakai.{/b}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3731
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_013508b0:

    # PHOAH @ angry "The one who bought ruin upon both the old gods and the new with his treacherous war."
    PHOAH @ angry "Aquele que trouxe ruína tanto aos deuses antigos quanto aos novos com sua guerra traiçoeira."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3732
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_89848511:

    # PHOAH @ angry "No doubt he yearns to take a physical form once more."
    PHOAH @ angry "Sem dúvida, ele anseia por assumir uma forma física mais uma vez."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3733
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_75a790db:

    # MC "I... I don't understand."
    MC "Eu... Eu não entendo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3734
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_a323a245:

    # MC "Malakai? {i}The{/i} Malakai?"
    MC "Malakai? {i}O{/i} Malakai?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3735
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_3126cf19:

    # "The dark god himself... Every child in Alderay knew the story of Malakai."
    "O próprio deus das trevas... Toda criança em Alderay conhecia a história de Malakai."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3736
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_5c7fea02:

    # "Legend speak of how his betrayal destroyed the old and new gods in the greatest war to ever be fought."
    "As lendas falam de como sua traição destruiu os deuses antigos e novos na maior guerra já travada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3737
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_5e1d502e:

    # MC "This is... This cannot be..."
    MC "Isso é... Isso não pode ser..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3738
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_61b39614:

    # MC "He... {i}He's real?{/i}"
    MC "Ele... {i}Ele é real?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3739
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_c2ee7902:

    # HIRRAH "His flesh may be gone, but his spirit survives... Trapped beyond the gate of midnight."
    HIRRAH "Sua carne pode ter desaparecido, mas seu espírito sobrevive... Aprisionado além do portal da meia-noite."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3740
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_b514f426:

    # HIRRAH "{i}Imprisoned with Arda.{/i}"
    HIRRAH "{i}Aprisionado com Arda.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3741
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_50736f37:

    # PHOAH @ talk "Zanarak, his chosen champion has arrived to serve some purpose we do not fully understand."
    PHOAH @ talk "Zanarak, seu campeão escolhido, chegou para servir a algum propósito que não compreendemos completamente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3742
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_2419d9f9:

    # PHOAH @ talk "And if that wasn't enough proof, {i}she{/i} is here."
    PHOAH @ talk "E como se isso não fosse prova suficiente, {i}ela{/i} está aqui."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3743
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_e6bffe1a:

    # PHOAH @ talk "Malakai's right hand, the chaos goddess, Gimera has taken form once more and walks this place."
    PHOAH @ talk "A mão direita de Malakai, a deusa do caos, Gimera, tomou forma mais uma vez e caminha neste lugar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3744
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_0bf94686:

    # HIRRAH "Human... You must help us."
    HIRRAH "Humano... Você deve nos ajudar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3745
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_a7e0d8f5:

    # HIRRAH "Serve as our champion."
    HIRRAH "Sirva como nosso campeão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3746
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_4f4136b8:

    # HIRRAH "While we find and stop Gimera, we must work together!"
    HIRRAH "Enquanto encontrarmos e pararmos Gimera, devemos trabalhar juntos!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3747
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_e91157ba:

    # HIRRAH "No matter the cost..."
    HIRRAH "A qualquer custo..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3748
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_644eb481:

    # HIRRAH "{i}Malakai can never be allowed to walk the physical planes once more.{/i}"
    HIRRAH "{i}Malakai nunca pode ser permitido a andar pelos planos físicos novamente.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3751
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_8e7bf52d:

    # PHOAH @ talk "Malakai destroyed everything we had built."
    PHOAH @ talk "Malakai destruiu tudo o que havíamos construído."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3752
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2b4ac252:

    # PHOAH @ talk "All our hopes and dreams, everything Arda spent countless millenia working to achieve."
    PHOAH @ talk "Todas as nossas esperanças e sonhos, tudo pelo qual Arda passou incontáveis milênios trabalhando para alcançar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3753
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2c206515:

    # PHOAH @ talk "{i}The gateways to unite the realms, the unity of the old gods and new...{/i}"
    PHOAH @ talk "{i}Os portais para unir os reinos, a unidade dos deuses antigos e novos...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3754
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_0eb52d5f:

    # PHOAH @ talk "All of it was undone by Malakai in his quest to re-forge reality in his image."
    PHOAH @ talk "Tudo isso foi desfeito por Malakai em sua busca para re-forjar a realidade à sua imagem."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3755
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_782b7b35:

    # "Phoah paused for a moment, the rage slightly softening as she seemed to be thinking back to those dark days."
    "Phoah fez uma pausa por um momento, a raiva ligeiramente amenizada enquanto ela parecia estar pensando naqueles dias sombrios."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3756
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2e97c5dc:

    # PHOAH @ sad "{i}... It wasn't always so though.{/i}"
    PHOAH @ sad "{i}... No entanto, nem sempre foi assim.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3757
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2dc1e7da:

    # PHOAH @ sad "Before that monster, Gimera decieved him into opening the {i}Macarum,{/i} Malakai went by a different name."
    PHOAH @ sad "Antes daquele monstro, Gimera o enganou para que abrisse o {i}Macarum,{/i} Malakai atendia por um nome diferente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3758
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_b127e26a:

    # PHOAH @ sad "Malayan the curious."
    PHOAH @ sad "Malayan, o curioso."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3759
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2a09741c:

    # MC "The Macarum?"
    MC "O Macarum?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3760
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_cbdac6af:

    # PHOAH @ talk "{i}When Arda was born, he was a made a being of pure good, pure love.{/i}"
    PHOAH @ talk "{i}Quando Arda nasceu, ele foi feito um ser de pura bondade, puro amor.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3761
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_f3b5dcfb:

    # PHOAH @ talk "... But in order to become that, he cast off his darkness... sealed it away into a forbidden box beyond the knowledge and reach of even the gods."
    PHOAH @ talk "... Mas para se tornar isso, ele se livrou de sua escuridão... a selou em uma caixa proibida além do conhecimento e do alcance até mesmo dos deuses."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3762
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_062aedaa:

    # PHOAH @ angry "Guided by terrible visions of an impending war between the old gods and the new, Gimera decieved Malayan that only the power of the box could prevent the war."
    PHOAH @ angry "Guiada por visões terríveis de uma guerra iminente entre os deuses antigos e os novos, Gimera enganou Malayan fazendo-o acreditar que apenas o poder da caixa poderia impedir a guerra."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3763
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_c432b0f4:

    # PHOAH @ sad "Little did Malayan know by opening it, the visions he fought to stop would come true."
    PHOAH @ sad "Malayan mal sabia que, ao abri-la, as visões que ele lutou para impedir se tornariam realidade."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3767
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_36b03c3f:

    # "Hirrah let out a sharp chuckle."
    "Hirrah soltou uma risada aguda."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3768
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_cd066754:

    # HIRRAH "And who is supposed to answer?"
    HIRRAH "E quem deveria responder?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3769
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_5abe17b2:

    # PHOAH @ angry "Hirrah!"
    PHOAH @ angry "Hirrah!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3770
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_418142c0:

    # HIRRAH "Do not coddle the human... Letting him put his faith in what can never answer will lead him down a path of destruction."
    HIRRAH "Não mime o humano... Deixá-lo depositar sua fé naquilo que nunca responderá o levará por um caminho de destruição."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3771
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7208330b:

    # MC "{i}The... The gods no longer heard us?{/i}"
    MC "{i}Os... Os deuses já não nos ouviam?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3772
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_88785898:

    # PHOAH @ talk "After the war, so few of us remain, even now."
    PHOAH @ talk "Após a guerra, tão poucos de nós permanecem, mesmo agora."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3773
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_ac5cf9c8:

    # PHOAH @ sad "So many died... Yhoshan... Taruna... Palam."
    PHOAH @ sad "Tantos morreram... Yhoshan... Taruna... Palam."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3774
translate ptPT qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_59eb52b3:

