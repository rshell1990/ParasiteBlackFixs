translate ptPT qst_JudgementDay_RescueMages_Prep_46309dca:

    # "We scoured the district, but neither I nor Markus could pick up their scent through the thick smoke."
    "Vasculhamos o distrito, mas nem eu nem Markus conseguimos seguir o rastro deles por entre a fumaça densa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1476
translate ptPT qst_JudgementDay_RescueMages_Prep_838c0731:

    # "Suddenly, a sharp cry echoed through the air."
    "De repente, um grito agudo ecoou pelo ar."

