translate ptPT qst_TheJudgementDay_GoToMageDist_9243a9da:

    # DIVINE "[player_name!t]!"
    DIVINE "[player_name!t]!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:985
translate ptPT qst_TheJudgementDay_GoToMageDist_68d9d74f:

    # "I turned to see Sister Divine, flanked by a company of battle-ready mages."
    "Virei-me e vi a Irmã Divine, ladeada por uma companhia de magos prontos para a batalha."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:986
translate ptPT qst_TheJudgementDay_GoToMageDist_8748e9c2:

    # "Some of them eyed me warily, hands hovering over their staffs—until Divine raised a hand."
    "Alguns deles me olharam cautelosamente, as mãos pairando sobre seus cajados—até que Divine ergueu a mão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:987
translate ptPT qst_TheJudgementDay_GoToMageDist_82a2979a:

    # MC "The mage towers—are they still standing?"
    MC "As torres dos magos—ainda estão de pé?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:988
translate ptPT qst_TheJudgementDay_GoToMageDist_739360ad:

    # DIVINE "For now."
    DIVINE "Por enquanto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:989
translate ptPT qst_TheJudgementDay_GoToMageDist_fa337b01:

    # DIVINE "We're taking as many wounded as we can into the Tower of Palam."
    DIVINE "Estamos levando tantos feridos quanto podemos para a Torre de Palam."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:990
translate ptPT qst_TheJudgementDay_GoToMageDist_e35c2908:

    # MC "What do you need?"
    MC "Do que você precisa?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:991
translate ptPT qst_TheJudgementDay_GoToMageDist_59f6b854:

    # DIVINE "Some of my girls—they were sent out to help recover the wounded. They haven't returned."
    DIVINE "Algumas das minhas garotas—foram enviadas para ajudar a resgatar os feridos. Elas não voltaram."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:992
translate ptPT qst_TheJudgementDay_GoToMageDist_97d92b9e:

    # DIVINE "Please, you must help me!"
    DIVINE "Por favor, você precisa me ajudar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:993
translate ptPT qst_TheJudgementDay_GoToMageDist_7dbae29a:

    # MC "Where were they last sent?"
    MC "Para onde elas foram enviadas por último?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:994
translate ptPT qst_TheJudgementDay_GoToMageDist_62877735:

    # DIVINE "South-east, near the ruined chapel. Please... find them if you can!"
    DIVINE "Sudeste, perto da capela em ruínas. Por favor... encontre-as se puder!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:995
translate ptPT qst_TheJudgementDay_GoToMageDist_aa8b42d0:

    # MC "I will see what can be done."
    MC "Verei o que pode ser feito."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:996
translate ptPT qst_TheJudgementDay_GoToMageDist_b864bbd2:

    # DIVINE "Wait!"
    DIVINE "Espere!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:998
translate ptPT qst_TheJudgementDay_GoToMageDist_32059291:

    # "Raising her hands, she muttered a prayer, and a warmth spread through my body."
    "Erguendo as mãos, ela murmurou uma oração, e um calor se espalhou pelo meu corpo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:999
translate ptPT qst_TheJudgementDay_GoToMageDist_cc5ad301:

    # "{i}A surge of divine magic washed over me, closing my wounds.{/i}"
    "{i}Uma onda de magia divina me envolveu, fechando minhas feridas.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1008
translate ptPT qst_TheJudgementDay_GoToMageDist_4a44e709:

    # "Divine staggered slightly, a mage catching her arm."
    "Divine cambaleou um pouco, um mago segurando seu braço."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1009
translate ptPT qst_TheJudgementDay_GoToMageDist_12040647:

    # DIVINE "I'm fine... Now go! Find the girls!"
    DIVINE "Estou bem... Agora vá! Encontre as garotas!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1020
translate ptPT qst_JudgementDay_GoToHousingDist_a77b2e16:

    # "The houses of so many we'd come to know burned around us."
    "As casas de tantos que conhecíamos queimavam ao nosso redor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1022
translate ptPT qst_JudgementDay_GoToHousingDist_83d40aaa:

    # "Torn apart bodies littered the streets—men, women, children..."
    "Corpos dilacerados espalhavam-se pelas ruas — homens, mulheres, crianças..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1024
translate ptPT qst_JudgementDay_GoToHousingDist_a5ab804c:

    # "In that moment, my thoughts turned to [regina_ref!t], to Adara, to Erika — to everyone I loved."
    "Naquele momento, meus pensamentos se voltaram para [regina_ref!t], para Adara, para Erika — para todos que eu amava."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1027
translate ptPT qst_JudgementDay_GoToHousingDist_f66d6826:

    # MC "Markus, I need to know [regina_ref!t] and the others are safe."
    MC "Markus, preciso saber que [regina_ref!t] e os outros estão seguros."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1028
translate ptPT qst_JudgementDay_GoToHousingDist_6ade0628:

    # MARKUS "Then let's move quickly."
    MARKUS "Então vamos nos apressar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1029
translate ptPT qst_JudgementDay_GoToHousingDist_84a36cfc:

    # MARKUS "I don't know how long we have before this whole city turns to ash."
    MARKUS "Não sei quanto tempo temos até que esta cidade inteira se transforme em cinzas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1035
translate ptPT qst_JudgementDay_GoToHousingDist_c9ecc7ca:

    # "...We wasted no time, rushing towards my home."
    "...Não perdemos tempo, correndo para minha casa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1036
translate ptPT qst_JudgementDay_GoToHousingDist_fff3e3bc:

    # "By some miracle, the house remained unburned."
    "Por algum milagre, a casa escapou das chamas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1039
translate ptPT qst_JudgementDay_GoToHousingDist_497d2a22:

    # "Without hesitation, I burst inside."
    "Sem hesitar, entrei correndo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1041
translate ptPT qst_JudgementDay_GoToHousingDist_f51f6037:

    # MC "[regina_ref!t]! Erika!"
    MC "[regina_ref!t]! Erika!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1043
translate ptPT qst_JudgementDay_GoToHousingDist_e5f0bd28:

    # "I searched the empty, silent home."
    "Procurei pela casa vazia e silenciosa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1044
translate ptPT qst_JudgementDay_GoToHousingDist_b06759cc:

    # MC "(No one's here.)"
    MC "(Ninguém está aqui.)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1047
translate ptPT qst_JudgementDay_GoToHousingDist_bb204652:

    # MARKUS "[player_name!t], we can't stay. We need to go!"
    MARKUS "[player_name!t], não podemos ficar. Precisamos ir!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1050
translate ptPT qst_JudgementDay_GoToHousingDist_7156b8fe:

    # MC "([regina_ref!t]... Erika... Where are you both?)"
    MC "([regina_ref!t]... Erika... Onde vocês duas estão?)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1057
translate ptPT qst_JudgementDay_GoToHousingDist_bf6bf4a5:

    # "... A short, frantic trip to Adara's followed."
    "... Uma curta viagem frenética até a casa de Adara se seguiu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1059
translate ptPT qst_JudgementDay_GoToHousingDist_91e4c5e9:

    # "To my relief, her home was empty—cold, abandoned."
    "Para meu alívio, a casa dela estava vazia — fria, abandonada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1061
translate ptPT qst_JudgementDay_GoToHousingDist_b11e4ddd:

    # MC "(Thank the gods…)"
    MC "(Graças aos deuses…)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1062
translate ptPT qst_JudgementDay_GoToHousingDist_32c48bc0:

    # MC "(It looks like they made it out before the lockdown.)"
    MC "(Parece que eles conseguiram sair antes do bloqueio.)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1064
translate ptPT qst_JudgementDay_GoToHousingDist_0d65f503:

    # MARKUS "Is she here?"
    MARKUS "Ela está aqui?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1065
translate ptPT qst_JudgementDay_GoToHousingDist_93991100:

    # MC "No. They got out."
    MC "Não. Eles saíram."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1066
translate ptPT qst_JudgementDay_GoToHousingDist_1bd2b144:

    # MARKUS "Gods be praised. At least someone is safe."
    MARKUS "Louvados sejam os deuses. Pelo menos alguém está a salvo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1067
translate ptPT qst_JudgementDay_GoToHousingDist_e3892c55:

    # MARKUS "Let's keep moving!"
    MARKUS "Vamos continuar andando!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1071
translate ptPT qst_JudgementDay_GoToHousingDist_d4e305b1:

    # "As we arrived, dread filled my gut."
    "Quando chegamos, um pavor me encheu o estômago."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1077
translate ptPT qst_JudgementDay_GoToHousingDist_864aa28f:

    # "The door was destroyed, the wood shredded like a beast had raked its claws through it."
    "A porta estava destruída, a madeira dilacerada como se uma besta tivesse passado suas garras por ela."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1078
translate ptPT qst_JudgementDay_GoToHousingDist_2beca68a:

    # "Inside, blood stained the floors and walls."
    "Dentro, sangue manchava o chão e as paredes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1079
translate ptPT qst_JudgementDay_GoToHousingDist_63b4ace8:

    # "A monstrous corpse lay sprawled, a knife lodged deep into its back."
    "Um cadáver monstruoso jazia esparramado, com uma faca cravada profundamente em suas costas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1080
translate ptPT qst_JudgementDay_GoToHousingDist_08a154c0:

    # "Adara sat in the center of the carnage, cradling her father's lifeless body, blood pooling beneath her."
    "Adara estava sentada no centro da carnificina, embalando o corpo sem vida do pai, com sangue se acumulando sob ela."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1082
translate ptPT qst_JudgementDay_GoToHousingDist_9169fdf8:

    # "When she saw me, her eyes went wide—then filled with terror."
    "Quando ela me viu, seus olhos se arregalaram—então se encheram de terror."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1088
translate ptPT qst_JudgementDay_GoToHousingDist_8769010d:

    # ADARA "GET BACK! GET AWAY FROM ME!"
    ADARA "SAIA! AFASTE-SE DE MIM!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1089
translate ptPT qst_JudgementDay_GoToHousingDist_5148edd9:

    # "Her cries twisted into panicked sobs."
    "Seus gritos se transformaram em soluços apavorados."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1091
translate ptPT qst_JudgementDay_GoToHousingDist_3031e3a6:

    # ADARA "HAVEN'T YOU TAKEN ENOUGH FROM ME?!"
    ADARA "NÃO JÁ ME TIROU O SUFICIENTE?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1093
translate ptPT qst_JudgementDay_GoToHousingDist_ae082923:

    # "I knelt, reaching for her, but she recoiled violently, scrambling back."
    "Ajoelhei-me, tentando alcançá-la, mas ela recuou violentamente, recuando apressadamente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1094
translate ptPT qst_JudgementDay_GoToHousingDist_83e45577:

    # MC "Adara! It's me!"
    MC "Adara! Sou eu!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1096
translate ptPT qst_JudgementDay_GoToHousingDist_b673860c:

    # MC "ADARA!"
    MC "ADARA!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1097
translate ptPT qst_JudgementDay_GoToHousingDist_bd8f033c:

    # "She stopped resisting, staring up at me, her face frozen in confusion and grief."
    "Ela parou de resistir, olhando para cima para mim, o rosto congelado em confusão e tristeza."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1098
translate ptPT qst_JudgementDay_GoToHousingDist_8b3cf18a:

    # MC "It's me… It's [player_name!t]."
    MC "Sou eu… É [player_name!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1099
translate ptPT qst_JudgementDay_GoToHousingDist_2dbbc4be:

    # "Tears streamed down her face."
    "Lágrimas escorriam pelo seu rosto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1100
translate ptPT qst_JudgementDay_GoToHousingDist_d3233b1f:

    # ADARA "...[player_name!t]."
    ADARA "...[player_name!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1101
translate ptPT qst_JudgementDay_GoToHousingDist_ff882493:

    # ADARA "You're..."
    ADARA "Você é..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1102
translate ptPT qst_JudgementDay_GoToHousingDist_dc1f29a9:

    # MC "I came as quickly as I could. I—"
    MC "Eu vim o mais rápido que pude. Eu—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1103
translate ptPT qst_JudgementDay_GoToHousingDist_11e82624:

    # "Adara shoved me away."
    "Adara me empurrou para longe."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1105
translate ptPT qst_JudgementDay_GoToHousingDist_b0d30d8a:

    # ADARA "GET AWAY FROM ME!"
    ADARA "SAIA DE PERTO DE MIM!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1106
translate ptPT qst_JudgementDay_GoToHousingDist_3af255fd:

    # "Snatching a knife, she pointed it at me with trembling hands."
    "Apanhando uma faca, ela apontou-a para mim com as mãos trêmulas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1108
translate ptPT qst_JudgementDay_GoToHousingDist_5221be73:

    # ADARA "You're one of them! You've been lying to me this whole time!"
    ADARA "Você é um deles! Você tem mentido para mim esse tempo todo!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1110
translate ptPT qst_JudgementDay_GoToHousingDist_3083de2b:

    # MARKUS "[player_name!t], what is—?"
    MARKUS "[player_name!t], o que é—?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1111
translate ptPT qst_JudgementDay_GoToHousingDist_a27c5f77:

    # ADARA "Y-You too?!"
    ADARA "V-Você também?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1112
translate ptPT qst_JudgementDay_GoToHousingDist_59e86c56:

    # MC "Adara, no! Listen to me!"
    MC "Adara, não! Escute-me!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1113
translate ptPT qst_JudgementDay_GoToHousingDist_6d204bbe:

    # MC "We're trying to save the city! I swear it!"
    MC "Estamos tentando salvar a cidade! Eu juro!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1114
translate ptPT qst_JudgementDay_GoToHousingDist_cec5bea6:

    # ADARA "I… I don't know what to believe!"
    ADARA "Eu... Eu não sei no que acreditar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1116
translate ptPT qst_JudgementDay_GoToHousingDist_e3f34393:

    # "Before I could say another word, she bolted."
    "Antes que eu pudesse dizer outra palavra, ela saiu correndo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1117
translate ptPT qst_JudgementDay_GoToHousingDist_caac121e:

    # ADARA "GET OUT OF MY HOUSE!"
    ADARA "SAIA DA MINHA CASA!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1118
translate ptPT qst_JudgementDay_GoToHousingDist_ccd8064e:

    # MC "Adara! Wait!"
    MC "Adara! Espere!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1120
translate ptPT qst_JudgementDay_GoToHousingDist_e831d4dd:

    # "As she slammed the door, I considered chasing after her—but Markus grabbed my shoulder, yanking me back."
    "Enquanto ela batia a porta, pensei em correr atrás dela — mas Markus agarrou meu ombro, me puxando de volta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1121
translate ptPT qst_JudgementDay_GoToHousingDist_588381ab:

    # MARKUS "There will be time to explain later!"
    MARKUS "Haverá tempo para explicar depois!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1122
translate ptPT qst_JudgementDay_GoToHousingDist_e35cb94e:

    # MARKUS "We CANNOT stay here!"
    MARKUS "Não PODEMOS ficar aqui!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1124
translate ptPT qst_JudgementDay_GoToHousingDist_ff9963c7:

    # "As much as it pained me, I knew he was right."
    "Por mais que me doesse, eu sabia que ele estava certo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1127
translate ptPT qst_JudgementDay_GoToHousingDist_e1c3fc6b:

    # "We fled into the burning streets once more."
    "Fugimos para as ruas em chamas mais uma vez."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1141
translate ptPT qst_JudgementDay_GoToHousingDist_da031e0a:

    # NIJAH "AHHHHHHHHH!"
    NIJAH "AHHHHHHHHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1147
translate ptPT qst_JudgementDay_GoToHousingDist_cb704491:

    # MC "NIJAH!"
    MC "NIJAH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1148
translate ptPT qst_JudgementDay_GoToHousingDist_2919dbd4:

    # "A terrified Nijah fended off a snarling skin walker, flinging a pot of steaming broth at it."
    "Uma Nijah aterrorizada afastou um skin walker rosnante, atirando uma panela de caldo fumegante nele."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1150
translate ptPT qst_JudgementDay_GoToHousingDist_fef566b8:

    # "The thing shrieked as the scalding liquid sizzled its flesh, but as it smacked the pot aside, it raised its claws to strike."
    "A coisa guinchou enquanto o líquido escaldante chiava em sua carne, mas, ao afastar a panela, ergueu as garras para atacar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1152
translate ptPT qst_JudgementDay_GoToHousingDist_f9bf7b63:

    # "She closed her eyes, bracing for the blow that never came."
    "Ela fechou os olhos, preparando-se para o golpe que nunca veio."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1161
translate ptPT qst_JudgementDay_GoToHousingDist_90c17f83:

    # "When she opened them, the ghoul was severed in half, and I stood over its corpse."
    "Quando ela os abriu, o carniçal estava partido ao meio, e eu estava de pé sobre seu cadáver."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1162
translate ptPT qst_JudgementDay_GoToHousingDist_17035206:

    # NIJAH @ shock "{i}*Gasp!*{/i}"
    NIJAH @ shock "{i}*Ah!*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1163
translate ptPT qst_JudgementDay_GoToHousingDist_5e21c480:

    # NIJAH @ shock "[player_name!t]!"
    NIJAH @ shock "[player_name!t]!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1165
translate ptPT qst_JudgementDay_GoToHousingDist_7871316e:

    # "Nijah threw herself at me, arms wrapping tight around my body."
    "Nijah se jogou em mim, seus braços me envolvendo com força."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1166
translate ptPT qst_JudgementDay_GoToHousingDist_a5fbb10f:

    # NIJAH "You came! You saved me!"
    NIJAH "Você veio! Você me salvou!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1167
translate ptPT qst_JudgementDay_GoToHousingDist_50e4fa0d:

    # MC "Nijah, what are you doing out here? It's not safe!"
    MC "Nijah, o que você está fazendo aqui fora? Não é seguro!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1168
translate ptPT qst_JudgementDay_GoToHousingDist_8e234dad:

    # NIJAH @ sad "I let friendz shelter in my home during battle."
    NIJAH @ sad "Deixei amigos se abrigarem na minha casa durante a batalha."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1169
translate ptPT qst_JudgementDay_GoToHousingDist_5f133ac4:

    # NIJAH @ sad "One was hurt, zo I went to find mage or medicine!"
    NIJAH @ sad "Um estava ferido, então fui buscar um mago ou remédio!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1170
translate ptPT qst_JudgementDay_GoToHousingDist_c831d100:

    # NIJAH @ scared "T-Then those monsters came and I couldn't get back!"
    NIJAH @ scared "E-Então aqueles monstros apareceram e eu não consegui voltar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1171
translate ptPT qst_JudgementDay_GoToHousingDist_ff7e7271:

    # MC "Can you make it home safely now?"
    MC "Você pode chegar em casa em segurança agora?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1172
translate ptPT qst_JudgementDay_GoToHousingDist_fc032e0e:

    # MARKUS "[player_name!t]! We don't have time for this!"
    MARKUS "[player_name!t]! Não temos tempo para isso!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1173
translate ptPT qst_JudgementDay_GoToHousingDist_8031a768:

    # "Nijah gently rested her hand on my chest."
    "Nijah gentilmente apoiou a mão no meu peito."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1175
translate ptPT qst_JudgementDay_GoToHousingDist_cc06e485:

    # NIJAH @ scared "Go! I will be alright!"
    NIJAH @ scared "Vá! Eu ficarei bem!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1176
translate ptPT qst_JudgementDay_GoToHousingDist_79c7b0c1:

    # NIJAH "Hurry! Others will need help!"
    NIJAH "Rápido! Outros precisarão de ajuda!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1177
translate ptPT qst_JudgementDay_GoToHousingDist_0454ada0:

    # MC "...Be safe."
    MC "...Fique seguro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1179
translate ptPT qst_JudgementDay_GoToHousingDist_eeafaa68:

    # NIJAH @ sad "...Be safe, my love."
    NIJAH @ sad "...Fique seguro, meu amor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1197
translate ptPT qst_JudgementDay_GoToHousingDist_8e238a6e:

    # MARKUS "The castle district isn't far, we should—"
    MARKUS "O distrito do castelo não é longe, deveríamos—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1198
translate ptPT qst_JudgementDay_GoToHousingDist_e88ee10b:

    # "Markus suddenly stopped."
    "Markus de repente parou."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1199
translate ptPT qst_JudgementDay_GoToHousingDist_56bb8c5f:

    # MC "Markus?"
    MC "Markus?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1200
translate ptPT qst_JudgementDay_GoToHousingDist_803cd4bd:

    # MC "What is—"
    MC "O que é—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1205
translate ptPT qst_JudgementDay_GoToHousingDist_5b4dda25:

    # "As I turned to look at what he was staring at, I froze."
    "Quando me virei para ver o que ele estava encarando, congelei."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1207
translate ptPT qst_JudgementDay_GoToHousingDist_eb836cd6:

    # "Nijah's body—each limb torn off and pierced on a bloody, jagged spike—was placed in macabre display for all to see."
    "O corpo de Nijah—cada membro arrancado e perfurado em um espigão ensanguentado e irregular—foi colocado em exibição macabra para que todos vissem."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1208
translate ptPT qst_JudgementDay_GoToHousingDist_dcac6ec4:

    # "My knees began to shake as my eyes locked on her lifeless expression."
    "Meus joelhos começaram a tremer quando meus olhos se fixaram em sua expressão sem vida."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1210
translate ptPT qst_JudgementDay_GoToHousingDist_de0d0eff:

    # "Markus reached out, catching me before I collapsed."
    "Markus estendeu a mão, me segurando antes que eu desmoronasse."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1216
translate ptPT qst_JudgementDay_GoToHousingDist_2fdc28eb:

    # MC "Markus... They've..."
    MC "Markus... Eles..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1217
translate ptPT qst_JudgementDay_GoToHousingDist_ec24c958:

    # MARKUS "Don't look at her, [player_name!t]!"
    MARKUS "Não olhe para ela, [player_name!t]!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1218
translate ptPT qst_JudgementDay_GoToHousingDist_17407b40:

    # MC "...She did nothing to them. She—"
    MC "...Ela não fez nada a eles. Ela—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1219
translate ptPT qst_JudgementDay_GoToHousingDist_49ab9499:

    # MARKUS "[player_name!t]."
    MARKUS "[player_name!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1220
translate ptPT qst_JudgementDay_GoToHousingDist_38bdadb3:

    # MC "...How... how could—"
    MC "...Como... como poderia—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1221
translate ptPT qst_JudgementDay_GoToHousingDist_7b28c3e1:

    # "Markus grabbed my face, forcing me to look away."
    "Markus agarrou meu rosto, forçando-me a desviar o olhar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1223
translate ptPT qst_JudgementDay_GoToHousingDist_6755bdfa:

    # MARKUS "There are still people alive right now who need us!"
    MARKUS "Ainda há pessoas vivas agora que precisam de nós!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1224
translate ptPT qst_JudgementDay_GoToHousingDist_040f38a7:

    # MARKUS "We have to go—you can mourn later!"
    MARKUS "Temos que ir — você pode lamentar depois!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1225
translate ptPT qst_JudgementDay_GoToHousingDist_6c83698b:

    # MC "I... Yes, you're right."
    MC "Eu... Sim, você está certo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1226
translate ptPT qst_JudgementDay_GoToHousingDist_2b2df3a7:

    # MARKUS "Come."
    MARKUS "Venha."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1227
translate ptPT qst_JudgementDay_GoToHousingDist_b09f930f:

    # MARKUS "Let us move on from this infernal place, quickly."
    MARKUS "Vamos sair deste lugar infernal, rapidamente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1229
translate ptPT qst_JudgementDay_GoToHousingDist_ba97f096:

    # "As we left, I took one last look over my shoulder at Nijah's body, a deep, tremendous pain echoing through me..."
    "Ao sair, dei uma última olhada por cima do ombro para o corpo de Nijah, uma dor profunda e tremenda ecoando dentro de mim..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1230
translate ptPT qst_JudgementDay_GoToHousingDist_c24bd7be:

    # "...But the pain quickly gave way to pure rage."
    "...Mas a dor rapidamente deu lugar a uma raiva pura."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1231
translate ptPT qst_JudgementDay_GoToHousingDist_445ed3f2:

    # MC "(I'll kill them... I'LL KILL THEM ALL!)"
    MC "(Eu vou matá-los... VOU MATAR TODOS!)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1241
translate ptPT qst_JudgementDay_GoToCentreDist_d15a4e80:

    # "The castle was in lockdown."
    "O castelo estava em estado de sítio."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1242
translate ptPT qst_JudgementDay_GoToCentreDist_22ddf7c8:

    # "Scorched and battered, its walls remained unbreached."
    "Chamuscadas e castigadas, suas muralhas permaneciam intactas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1243
translate ptPT qst_JudgementDay_GoToCentreDist_712d2d29:

    # "Outside, torn-apart guards and skin walkers littered the grounds."
    "Do lado de fora, guardas dilacerados e caminhantes de pele jaziam espalhados pelo terreno."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1244
translate ptPT qst_JudgementDay_GoToCentreDist_173cfcbd:

    # "But most horrifying were the corpses stacked against the gate—ordinary people who had pleaded for sanctuary."
    "Mas o mais horripilante eram os cadáveres empilhados contra o portão — pessoas comuns que tinham implorado por santuário."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1245
translate ptPT qst_JudgementDay_GoToCentreDist_74841ed7:

    # "... And were denied."
    "... E foram recusados."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1246
translate ptPT qst_JudgementDay_GoToCentreDist_8cc846a4:

    # "Their bodies were charred black, the stench of burning flesh and ale heavy in the air."
    "Seus corpos estavam carbonizados, o fedor de carne queimada e cerveja pesava no ar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1247
translate ptPT qst_JudgementDay_GoToCentreDist_30af6c48:

    # "Above, music played softly from within the castle walls."
    "Acima, música tocava suavemente de dentro das muralhas do castelo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1248
translate ptPT qst_JudgementDay_GoToCentreDist_bda0f0f0:

    # "Were they drowning out the slaughter outside?"
    "Estariam eles abafando o massacre lá fora?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1249
translate ptPT qst_JudgementDay_GoToCentreDist_c1f86d1f:

    # "Were they *celebrating* as we died?"
    "Estariam eles *celebrando* enquanto morríamos?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1250
translate ptPT qst_JudgementDay_GoToCentreDist_75386a3d:

    # "A burning rage welled in my chest."
    "Uma raiva ardente brotou em meu peito."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1251
translate ptPT qst_JudgementDay_GoToCentreDist_5ed57ae9:

    # MARKUS "We need to keep moving—more guards are bound to reinforce—"
    MARKUS "Precisamos continuar andando — mais guardas certamente virão como reforço —"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1253
translate ptPT qst_JudgementDay_GoToCentreDist_fc825f22:

    # GUARD "Princess, please! It isn't safe!"
    GUARD "Princesa, por favor! Não é seguro!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1255
translate ptPT qst_JudgementDay_GoToCentreDist_f76f3062:

    # "My eyes snapped toward her—Princess Cecilia."
    "Meus olhos se voltaram para ela—Princesa Cecilia."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1256
translate ptPT qst_JudgementDay_GoToCentreDist_ec861cd4:

    # "Clad in royal regalia, she picked her way through the bloodied corpses, a fierce determination in her eyes."
    "Vestida em trajes reais, ela abriu caminho entre os cadáveres ensanguentados, com uma determinação feroz nos olhos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1258
translate ptPT qst_JudgementDay_GoToCentreDist_e2c548aa:

    # PRINCESS_CECILIA "My brother is still out in the city!"
    PRINCESS_CECILIA "Meu irmão ainda está na cidade!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1259
translate ptPT qst_JudgementDay_GoToCentreDist_6d9907df:

    # PRINCESS_CECILIA "I cannot leave him!"
    PRINCESS_CECILIA "Não posso deixá-lo!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1261
translate ptPT qst_JudgementDay_GoToCentreDist_e54b055f:

    # GUARD "Princess Cecilia, please!"
    GUARD "Princesa Cecilia, por favor!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1262
translate ptPT qst_JudgementDay_GoToCentreDist_251de269:

    # GUARD "This is too dangerous!"
    GUARD "Isso é perigoso demais!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1263
translate ptPT qst_JudgementDay_GoToCentreDist_6e34a4db:

    # "As she looked upon the sea of bodies, I heard her heartbeat quicken."
    "Ao olhar para o mar de corpos, ouvi o batimento cardíaco dela acelerar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1264
translate ptPT qst_JudgementDay_GoToCentreDist_2f1f313f:

    # PRINCESS_CECILIA "....Gods, there's so many of them."
    PRINCESS_CECILIA "....Deuses, há tantos deles."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1265
translate ptPT qst_JudgementDay_GoToCentreDist_ca60af05:

    # GUARD "We must return to the castle—"
    GUARD "Precisamos voltar ao castelo—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1267
translate ptPT qst_JudgementDay_GoToCentreDist_9b8278e0:

    # "From beneath the corpses, monstrous figures lunged, surrounding her."
    "De debaixo dos cadáveres, figuras monstruosas saltaram, cercando-a."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1268
translate ptPT qst_JudgementDay_GoToCentreDist_8fef4312:

    # GUARD "PRINCESS! GET BACK!"
    GUARD "PRINCESA! VOLTE!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1269
translate ptPT qst_JudgementDay_GoToCentreDist_93a5d1eb:

    # "The guards raised their swords, but they were outnumbered."
    "Os guardas ergueram as espadas, mas estavam em desvantagem numérica."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1270
translate ptPT qst_JudgementDay_GoToCentreDist_c43dec24:

    # "Without thinking, I leapt forward, claws bared!"
    "Sem pensar, eu dei um salto à frente, com as garras à mostra!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1272
translate ptPT qst_JudgementDay_GoToCentreDist_c66184e0:

    # MARKUS "[player_name!t]! Wait!"
    MARKUS "[player_name!t]! Espere!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1273
translate ptPT qst_JudgementDay_GoToCentreDist_29a7c4a1:

    # MARKUS "Damn it!"
    MARKUS "Droga!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1281
translate ptPT qst_JudgementDay_GoToCentreDist_a809d696:

    # "As the last beast fell, the guards turned their swords on *us*."
    "Quando a última fera caiu, os guardas viraram suas espadas contra *nós*."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1283
translate ptPT qst_JudgementDay_GoToCentreDist_02b0ebc9:

    # GUARD "Princess! Stand back!"
    GUARD "Princesa! Afaste-se!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1284
translate ptPT qst_JudgementDay_GoToCentreDist_881ede42:

    # GUARD "Back, fiend!"
    GUARD "Para trás, monstro!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1285
translate ptPT qst_JudgementDay_GoToCentreDist_53234ca0:

    # PRINCESS_CECILIA "Wait!"
    PRINCESS_CECILIA "Espere!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1287
translate ptPT qst_JudgementDay_GoToCentreDist_00f46702:

    # "She stepped between us."
    "Ela se colocou entre nós."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1288
translate ptPT qst_JudgementDay_GoToCentreDist_96b44b75:

    # GUARD "Princess! What are you doing?!"
    GUARD "Princesa! O que está fazendo?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1289
translate ptPT qst_JudgementDay_GoToCentreDist_c452e649:

    # GUARD "Get back!"
    GUARD "Volte!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1290
translate ptPT qst_JudgementDay_GoToCentreDist_815cfca6:

    # PRINCESS_CECILIA "I do not believe these creatures seek to do us harm!"
    PRINCESS_CECILIA "Eu não acredito que essas criaturas queiram nos fazer mal!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1292
translate ptPT qst_JudgementDay_GoToCentreDist_d9a959f7:

    # GUARD "Princess, return at once!"
    GUARD "Princesa, volte imediatamente!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1293
translate ptPT qst_JudgementDay_GoToCentreDist_966d4f4f:

    # "She turned to me, hesitant but composed."
    "Ela se virou para mim, hesitante mas composta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1294
translate ptPT qst_JudgementDay_GoToCentreDist_ecc61594:

    # PRINCESS_CECILIA "Do you... understand me?"
    PRINCESS_CECILIA "Você... me entende?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1295
translate ptPT qst_JudgementDay_GoToCentreDist_f8d1acbc:

    # MC "...Yes."
    MC "...Sim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1296
translate ptPT qst_JudgementDay_GoToCentreDist_f73fe119:

    # "The guards stiffened as her breath hitched."
    "Os guardas se enrijeceram quando a respiração dela falhou."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1297
translate ptPT qst_JudgementDay_GoToCentreDist_4336e05e:

    # PRINCESS_CECILIA "You speak..."
    PRINCESS_CECILIA "Você fala..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1298
translate ptPT qst_JudgementDay_GoToCentreDist_990fedcd:

    # PRINCESS_CECILIA "I... Thank you for—"
    PRINCESS_CECILIA "Eu... Obrigado por—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1299
translate ptPT qst_JudgementDay_GoToCentreDist_fc1f12fc:

    # "A corpse rolled over—then lunged at her."
    "Um cadáver rolou—então avançou contra ela."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1300
translate ptPT qst_JudgementDay_GoToCentreDist_5894ee6a:

    # "The guards were too slow."
    "Os guardas foram lentos demais."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1304
translate ptPT qst_JudgementDay_GoToCentreDist_fa984604:

    # "I grabbed her, pulling her back as my tail severed the creature's head in one clean strike."
    "Eu a agarrei, puxando-a para trás enquanto minha cauda decepava a cabeça da criatura num golpe limpo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1305
translate ptPT qst_JudgementDay_GoToCentreDist_bde082c4:

    # PRINCESS_CECILIA "..."
    PRINCESS_CECILIA "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1306
translate ptPT qst_JudgementDay_GoToCentreDist_6e963c41:

    # MC "Are you alright, Princess?"
    MC "Você está bem, Princesa?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1307
translate ptPT qst_JudgementDay_GoToCentreDist_5191c8d3:

    # PRINCESS_CECILIA "Y-Yes..."
    PRINCESS_CECILIA "S-Sim..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1308
translate ptPT qst_JudgementDay_GoToCentreDist_f063924a:

    # GUARD "PRINCESS!"
    GUARD "PRINCESA!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1310
translate ptPT qst_JudgementDay_GoToCentreDist_9a443648:

    # "The guards yanked her away, weapons still drawn."
