    MC @ angry "Do que estou sendo acusado?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2289
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_d6bc35d8:

    # MC @ angry "We saved this city!"
    MC @ angry "Nós salvamos esta cidade!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2290
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_1afd1403:

    # ALCOTT @ talk "Head Inquisitor Marion has charged you with treason and consorting with dark mages."
    ALCOTT @ talk "O Inquisidor-Chefe Marion te acusou de traição e de conspirar com magos sombrios."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2291
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_de3508db:

    # MC @ think "What?!"
    MC @ think "O quê?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2292
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_1ab3ff90:

    # ALCOTT @ talk "You have been accused of spying for the Demorai."
    ALCOTT @ talk "Você foi acusado de espionar para os Demorai."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2293
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_5ee94fb5:

    # MC @ angry "That's absurd! I fought against them! I saved {i}hundreds!{/i}"
    MC @ angry "Isso é absurdo! Eu lutei contra eles! Eu salvei {i}centenas!{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2294
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_346ecd1f:

    # ALCOTT @ talk "It does not matter."
    ALCOTT @ talk "Não importa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2295
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_dc9687c2:

    # ALCOTT @ talk "Marion doesn't need to be {i}right{/i}—she only needs to convince the lords that you are too great a threat to keep alive."
    ALCOTT @ talk "Marion não precisa estar {i}certa{/i}—ela só precisa convencer os lordes de que você é uma ameaça grande demais para se manter vivo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2296
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_403fc54c:

    # MC @ talk "...So, will you speak on my behalf?"
    MC @ talk "...Então, você falará em meu nome?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2297
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_5ba55a50:

    # ALCOTT @ talk "I cannot."
    ALCOTT @ talk "Não posso."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2298
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_3b4ca7fc:

    # ALCOTT @ talk "I must remain impartial."
    ALCOTT @ talk "Devo permanecer imparcial."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2299
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_24886635:

    # MC @ angry "Then why are you here?"
    MC @ angry "Então por que você está aqui?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2300
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_0fe20ea3:

    # ALCOTT @ talk "...Because you can still win this trial."
    ALCOTT @ talk "...Porque você ainda pode vencer este julgamento."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2301
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_8bcd69fe:

    # ALCOTT @ talk "Marion will prey on their fear."
    ALCOTT @ talk "Marion se aproveitará do medo deles."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2302
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_81b3050a:

    # ALCOTT @ talk "So {i}you{/i} must prey on their {i}greed.{/i}"
    ALCOTT @ talk "Então {i}você{/i} deve se aproveitar da {i}ganância{/i} deles."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2306
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_78268096:

    # "The Emperor turned away, calling for the guards."
    "O Imperador se virou, chamando pelos guardas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2308
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_ad603be8:

    # MC "...Prey on their hope."
    MC "...Aproveite-se da esperança deles."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2309
translate ptPT qst_JudgementDay_SiegeOverPrison_alcott_menu_8d25bef7:

    # MC "(Prey on their greed...)"
    MC "(Aproveite-se da ganância deles...)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2316
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_a9cf84ff:

    # "As darkness fell in my cell that night, I waited restlessly for my trial to come."
    "Enquanto a escuridão caía em minha cela naquela noite, esperei inquieto pelo meu julgamento."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2319
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_2d1c7d48:

    # "The aching agony continued to burn, to scorch my hot blood."
    "A agonia dolorosa continuava a queimar, a escaldar meu sangue quente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2320
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_0264d4d3:

    # "I became pale, sweat dripping profusely from me as I dazed in and out of consciousness."
    "Fiquei pálido, suor escorrendo profusamente de mim enquanto eu entrava e saía da consciência."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2321
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_fd3655df:

    # "Would I even make it to the trial by morning's light?"
    "Será que eu sequer conseguiria chegar ao julgamento ao amanhecer?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2322
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_e6f0d6bf:

    # REGINA "... Oh, dear."
    REGINA "... Oh, céus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2325
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_fac0e51d:

    # "I looked up to the black shadow stood beyond the bars of my cell."
    "Olhei para a sombra negra que estava além das grades da minha cela."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2326
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_8d9e3641:

    # "Shifting and moving, they took form as [regina_ref!t] emerged from the shadows."
    "Movendo-se e mudando, tomaram forma quando [regina_ref!t] emergiu das sombras."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2327
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_dc72f708:

    # REGINA @ sad "You poor thing... You look like you're in so much pain."
    REGINA @ sad "Pobre coitado... Você parece estar com tanta dor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2328
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_c7036a05:

    # "Her attire was different now, from head to toe she wore black, with a strange pointed hat, and the way she carried herself felt different, it felt... {i}dangerous.{/i}"
    "Sua vestimenta era diferente agora, da cabeça aos pés ela usava preto, com um estranho chapéu pontudo, e a maneira como ela se portava parecia diferente, parecia... {i}perigosa.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2329
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_f56dd946:

    # "Her hands reached through the bars."
    "Ela estendeu as mãos por entre as grades."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2330
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_5ffe3e24:

    # REGINA "Poor baby, come... Come to [regina_ref!t]."
    REGINA "Pobre bebê, venha... Venha para [regina_ref!t]."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2331
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_da06ef9c:

    # "I slapped her hand away as I pulled back."
    "Dei um tapa na mão dela e me afastei."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2332
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_615f5fd0:

    # MC @ angry "... Who are you?"
    MC @ angry "... Quem é você?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2333
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_6eb8fe7a:

    # "[regina_ref_cap!t] delicately pulled back her hand, her face slightly crestfellen."
    "[regina_ref_cap!t] puxou delicadamente a mão de volta, com o rosto ligeiramente abatido."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2334
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_407ed983:

    # REGINA @ sad "You know who I am... I'm still the same person I've always been."
    REGINA @ sad "Você sabe quem eu sou... Ainda sou a mesma pessoa que sempre fui."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2335
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_38cab1e6:

    # MC @ angry "Don't lie to me! Not anymore!"
    MC @ angry "Não minta para mim! Não mais!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2336
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_39ba6b8c:

    # REGINA @ angry "I've been trying to protect you!"
    REGINA @ angry "Eu tenho tentado te proteger!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2337
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_4acb35e3:

    # MC @ angry "All these years... All these years I've pretended not to see what's staring me in the face."
    MC @ angry "Todos esses anos... Todos esses anos eu fingi não ver o que está bem na minha cara."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2338
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_f834a9d3:

    # MC @ angry "Our whole lives you've been LYING to me and Erika about who and what you really are!"
    MC @ angry "Durante toda a nossa vida você MENTIU para mim e para a Erika sobre quem e o que você realmente é!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2339
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_7be10a23:

    # MC @ angry "No more! Who are you really?"
    MC @ angry "Sem mais! Quem é você de verdade?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2340
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_c0bf3f94:

    # MC @ angry "...{i}What are you?{/i}"
    MC @ angry "...{i}O que você é?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2341
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_e57e169f:

    # "The concerning softness on [regina_ref!t]'s expression faded, as in a moment, she became completely calm and collected, with a cold quality to her tone."
    "A suavidade preocupante na expressão de [regina_ref!t] desvaneceu, pois num momento ela se tornou completamente calma e composta, com uma qualidade fria em seu tom."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2342
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_4f5e4d50:

    # REGINA @ talk "... I was born four centuries ago in the village of Lockshire."
    REGINA @ talk "... Eu nasci há quatro séculos na vila de Lockshire."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2343
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_2467e2ae:

    # "I listened intently, feeling the room close in around us."
    "Eu ouvi atentamente, sentindo o quarto se fechar ao nosso redor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2344
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_e116d747:

    # REGINA @ talk "Times were different then, my people were just another school of magecraft, one often misunderstood... And yet, respected as the others were."
    REGINA @ talk "Os tempos eram diferentes então, meu povo era apenas mais uma escola de magia, muitas vezes incompreendida... E ainda assim, respeitada como as outras."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2345
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_4fc3f3e9:

    # "I felt the sickly blood turn ice cold as I listened."
    "Senti o sangue doentio se tornar gelado enquanto eu ouvia."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2346
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_6beb8743:

    # MC @ surprised "So it is true then..."
    MC @ surprised "Então é verdade..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2347
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_fac91196:

    # MC @ surprised "{i}You're a dark mage.{/i}"
    MC @ surprised "{i}Você é um mago das trevas.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2348
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_689c49b0:

    # REGINA "..."
    REGINA "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2349
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_d58b1863:

    # MC @ angry "... Say it!"
    MC @ angry "... Diga!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2355
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_fee25212:

    # REGINA @ talk "... I am."
    REGINA @ talk "... Eu sou."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2356
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_11b77947:

    # "Her confession stung like a hot knife pressed into my very soul."
    "A confissão dela doeu como uma faca quente cravada em minha própria alma."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2357
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_a5a156cc:

    # MC @ surprised "Oh gods..."
    MC @ surprised "Oh, deuses..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2358
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_289a6298:

    # MC @ surprised "No... I..."
    MC @ surprised "Não... Eu..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2359
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_bbefb2bd:

    # MC @ sad "How could I not see it?"
    MC @ sad "Como eu pude não ver?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2360
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_499c67ea:

    # REGINA @ talk "I was going to tell you... One day."
    REGINA @ talk "Eu ia te contar... Um dia."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2361
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_f9e5c130:

    # MC @ angry "Grghh! And you let Erika become an inquisitor anyway?!"
    MC @ angry "Grghh! E você deixou Erika se tornar uma inquisidora mesmo assim?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2362
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_2491c2c1:

    # MC @ angry "Knowing full well what you are!"
    MC @ angry "Sabendo muito bem o que você é!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2363
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_fd3fbd07:

    # MC @ angry "ARE YOU MAD?!"
    MC @ angry "VOCÊ ENLOUQUECEU?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2364
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_1d2de62a:

    # REGINA @ talk "You and her happiness, is the only thing I care about."
    REGINA @ talk "A sua felicidade e a dela é a única coisa com que me importo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2365
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_1cf2a9ea:

    # REGINA @ talk "If Erika chooses to hate me, then so be it."
    REGINA @ talk "Se Erika escolher me odiar, que assim seja."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2366
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_278ef5ad:

    # REGINA @ talk "But I knew one way or another, if Erika never learned to channel her magecraft, she would only resent herself."
    REGINA @ talk "Mas eu sabia que, de um jeito ou de outro, se Erika nunca aprendesse a canalizar sua magia, ela apenas se ressentiria de si mesma."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2367
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_2d6ae603:

    # MC @ angry "Don't try and pretend this is just about OUR happiness!"
    MC @ angry "Não tente fingir que isso é apenas sobre a NOSSA felicidade!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2368
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_89d68b37:

    # MC @ angry "You could have done more! We would have understood!"
    MC @ angry "Você poderia ter feito mais! Nós teríamos entendido!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2369
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_dce9bff1:

    # REGINA @ angry "And confined you to a life of keeping secrets?"
    REGINA @ angry "E confinado você a uma vida de guardar segredos?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2370
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_bd5c3416:

    # REGINA @ talk "No... I wanted you both to live a normal life, I wanted you both to be happy and make choices for yourselves, not because of me."
    REGINA @ talk "Não... Eu queria que vocês dois vivessem uma vida normal, eu queria que ambos fossem felizes e fizessem escolhas por si mesmos, não por minha causa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2371
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_52300684:

    # MC @ sad "... Is Regina even your real name?"
    MC @ sad "... Regina é mesmo o seu nome verdadeiro?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2372
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_f397476d:

    # REGINA @ talk "I've gone by many names over the years."
    REGINA @ talk "Usei muitos nomes ao longo dos anos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2373
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_2ae14994:

    # REGINA @ talk "But Regina was the name I was born with."
    REGINA @ talk "Mas Regina foi o nome com o qual nasci."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2374
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_f587dd25:

    # REGINA @ talk "I brought it back because I wanted to hear you two call me it."
    REGINA @ talk "Eu o trouxe de volta porque queria ouvir vocês dois me chamarem assim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2375
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2376
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_2b5d97c5:

    # MC @ sad "You're no ordinary dark mage, are you?"
    MC @ sad "Você não é um mago das trevas comum, não é?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2377
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_51cbcbf1:

    # MC @ sad "I've never heard of a dark mage living that long."
    MC @ sad "Nunca ouvi falar de um mago das trevas que vivesse tanto tempo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2378
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_9fabe2e5:

    # "There was a long pause, before Regina finally answered me."
    "Houve uma longa pausa antes de Regina finalmente me responder."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2379
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_3acc27e1:

    # REGINA @ talk "{i}... I am the witch of Barakan.{/i}"
    REGINA @ talk "{i}... Eu sou a bruxa de Barakan.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2380
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_d79fb17e:

    # "I felt my skin begin to crawl."
    "Senti minha pele começar a arrepiar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2381
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_e0b21ae9:

    # "The witch of Barakan..."
