    MC "(O quê? Do que você está falando?)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:155
translate ptPT qst_JudgementDay_SiegeStart_5468f875:

    # BLACK "({i}I sense predators all around us.{/i})"
    BLACK "({i}Eu sinto predadores ao nosso redor.{/i})"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:156
translate ptPT qst_JudgementDay_SiegeStart_7f5471da:

    # MC "(What?)"
    MC "(O quê?)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:157
translate ptPT qst_JudgementDay_SiegeStart_c7b53baf:

    # "I looked once more toward the guards who were making their way toward us."
    "Olhei novamente para os guardas que se aproximavam de nós."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:158
translate ptPT qst_JudgementDay_SiegeStart_9a4b6ec2:

    # "There was something strange in the way they shuffled closer, as though they were drunk."
    "Havia algo estranho na maneira como eles se arrastavam mais perto, como se estivessem bêbados."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:159
translate ptPT qst_JudgementDay_SiegeStart_aab1fd60:

    # "And yet, something felt wrong... {i}something felt very wrong.{/i}"
    "E ainda assim, algo parecia errado... {i}algo parecia muito errado.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:160
translate ptPT qst_JudgementDay_SiegeStart_9c54eddd:

    # MC "(...The guards, what are they—)"
    MC "(...Os guardas, o que eles estão—)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:161
translate ptPT qst_JudgementDay_SiegeStart_7fc09f6c:

    # "A sudden, dreadful chill rushed through me, the hairs on my arms standing up."
    "Um calafrio súbito e terrível percorreu meu corpo, os pelos dos meus braços se arrepiando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:165
translate ptPT qst_JudgementDay_SiegeStart_57b46f4a:

    # MC @ surprised "GET AWAY FROM THEM!"
    MC @ surprised "FIQUE LONGE DELES!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:167
translate ptPT qst_JudgementDay_SiegeStart_e101284f:

    # "As the child stopped in his tracks, he looked back at me for a moment in hesitation, ready to turn back."
    "Enquanto o menino parava no meio do caminho, ele olhou para mim por um momento, hesitante, pronto para voltar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:168
translate ptPT qst_JudgementDay_SiegeStart_79277854:

    # "But before he could, springing from the bloody chest of one of the guards, a pale ghoul slashed at the boy's throat."
    "Mas antes que pudesse, saltando do peito ensanguentado de um dos guardas, um ghoul pálido cortou a garganta do menino."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:170
translate ptPT qst_JudgementDay_SiegeStart_901c2e1b:

    # "The boy's parents, alongside the now panicking crowd, began to scream and try to flee, but most of them found themselves running straight into the path of more ghouls."
    "Os pais do garoto, junto com a multidão agora em pânico, começaram a gritar e tentar fugir, mas a maioria acabou correndo direto para o caminho de mais carniçais."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:173
translate ptPT qst_JudgementDay_SiegeStart_8fe69b0e:

    # MAD_PROPHET "STOP! THIS WASN'T SUPPOSED TO HAPPEN!"
    MAD_PROPHET "PARE! ISSO NÃO ERA PARA ACONTECER!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:174
translate ptPT qst_JudgementDay_SiegeStart_097f8cb0:

    # MAD_PROPHET "NEWHEART WILL COME TO-"
    MAD_PROPHET "NEWHEART VIRÁ-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:175
translate ptPT qst_JudgementDay_SiegeStart_36ef9536:

    # "A ghoul charged onto the stage, and with one sudden swipe of its vicious claws, disemboweled the mad preacher."
    "Um carniçal avançou até o palco e, com um golpe repentino de suas garras cruéis, estripou o pregador louco."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:176
translate ptPT qst_JudgementDay_SiegeStart_4f76bcc4:

    # "With a sharp, breathless cry, he dropped to his knees, desperate to push his guts back into his stomach futilely."
    "Com um grito agudo e sem fôlego, ele caiu de joelhos, tentando em vão empurrar suas entranhas de volta para o estômago."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:177
translate ptPT qst_JudgementDay_SiegeStart_c50fe535:

    # MAD_PROPHET "N-Noo, God! Why have you..."
    MAD_PROPHET "N-Não, Deus! Por que você nos..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:178
translate ptPT qst_JudgementDay_SiegeStart_f996ed42:

    # MAD_PROPHET "Forsaken us?"
    MAD_PROPHET "Abandonou?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:179
translate ptPT qst_JudgementDay_SiegeStart_0e2dc7f7:

    # "With a thud, the mad preacher's head hit the ground, his lifeless eyes staring blankly ahead."
    "Com um baque, a cabeça do pregador louco caiu no chão, seus olhos sem vida encarando o vazio."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:181
translate ptPT qst_JudgementDay_SiegeStart_79d72e0f:

    # "I reached for my sword as the ghouls moved through the crowd, tearing people limb from limb as the streets ran red with blood."
    "Peguei minha espada enquanto os carniçais se moviam pela multidão, dilacerando pessoas membro por membro enquanto as ruas ficavam vermelhas de sangue."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:182
translate ptPT qst_JudgementDay_SiegeStart_3bf57e62:

    # MC @ angry "(There's too many of them for just my blade!)"
    MC @ angry "(Há muitos deles para apenas minha lâmina!)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:188
translate ptPT qst_JudgementDay_SiegeStart_69530527:

    # MC @ angry "(But... There's so many eyes! If I change-)"
    MC @ angry "(Mas... Tem tantos olhos! Se eu mudar-)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:190
translate ptPT qst_JudgementDay_SiegeStart_39deb827:

    # "A small child, cowering in her mother's arms, screamed as one of the ghoulish creatures, claws raised, prepared to slash them down."
    "Uma criança pequena, encolhida nos braços da mãe, gritou quando uma das criaturas horripilantes, com as garras erguidas, preparou-se para dilacerá-las."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:193
translate ptPT qst_JudgementDay_SiegeStart_ab601fc9:

    # "...As the little girl closed her eyes and waited for the death blow, she must have heard the sound of something razor-sharp, but when no pain came,"
    "...Enquanto a garotinha fechava os olhos e esperava o golpe mortal, ela deve ter ouvido o som de algo afiado como navalha, mas quando a dor não veio,"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:198
translate ptPT qst_JudgementDay_SiegeStart_1efcca36:

    # "Her eyes opened to see the hulking tentacle monster in front of her, cutting down the ghoulish beasts!"
    "Seus olhos se abriram para ver o monstruoso monstro tentaculado à sua frente, derrubando as bestas horripilantes!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:200
translate ptPT qst_JudgementDay_SiegeStart_20b8350a:

    # BLACK "{i}Go. Now!{/i}"
    BLACK "{i}Vá. Agora!{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:201
translate ptPT qst_JudgementDay_SiegeStart_769fcdbc:

    # "The little girl, staring in awe, was pulled by her terrified mother as they fled, while the ghouls now turned their attention toward me."
    "A garotinha, encarando maravilhada, foi puxada pela mãe aterrorizada enquanto fugiam, enquanto os ghouls agora voltavam sua atenção para mim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:204
translate ptPT qst_JudgementDay_SiegeStart_a19998ff:

    # "With my blades at the ready, I snarled and roared at the ghoulish monstrosities."
    "Com minhas lâminas prontas, eu rosnei e rugi para as monstruosidades horripilantes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:212
translate ptPT qst_JudgementDay_SiegeStart_3703fd79:

    # "...Just then, before they could set upon me, a blue wolf came charging in to tackle one of the beasts."
    "...Naquele exato momento, antes que pudessem me atacar, um lobo azul veio investindo para derrubar uma das bestas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:213
translate ptPT qst_JudgementDay_SiegeStart_9abbc337:

    # MC "ELENA!"
    MC "ELENA!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:214
translate ptPT qst_JudgementDay_SiegeStart_cc74b041:

    # "Having knocked the thing back with her body and managing to tear a chunk from one of the creature's hands, she barked defiantly!"
    "Tendo empurrado a coisa para trás com seu corpo e conseguindo arrancar um pedaço de uma das mãos da criatura, ela latiu desafiadoramente!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:216
translate ptPT qst_JudgementDay_SiegeStart_017cd4e0:

    # ELENA "{i}*BARK!*{/i}"
    ELENA "{i}*Au!*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:221
translate ptPT qst_JudgementDay_SiegeStart_ff05f8bf:

    # "Suddenly feeling a wetness on my foot, I looked down to see a blue slime slithering past, before rising up to take her full form."
    "De repente, sentindo uma umidade no meu pé, olhei para baixo e vi uma gosma azul rastejando, antes de se erguer para assumir sua forma completa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:223
translate ptPT qst_JudgementDay_SiegeStart_e0798488:

    # MYU @ angry "B-Bad monsters everywhere!"
    MYU @ angry "M-Maus monstros por toda parte!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:229
translate ptPT qst_JudgementDay_SiegeStart_d48f5035:

    # "Before I could say another word, the ghouls lunged towards us!"
    "Antes que eu pudesse dizer outra palavra, os ghouls avançaram contra nós!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:231
translate ptPT qst_JudgementDay_SiegeStart_aa1cde60:

    # "The remaining ghouls lunged towards me!"
    "Os ghouls restantes avançaram contra mim!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:250
translate ptPT qst_JudgementDay_SiegeStart_173f1ae0:

    # "... As the last of the foul things fell, I looked around at the bloody massacre surrounding me."
    "... Enquanto a última das coisas imundas caía, olhei ao redor para a carnificina sangrenta ao meu redor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:254
translate ptPT qst_JudgementDay_SiegeStart_0443d4a1:

    # "The city was aflame, those things no doubt springing up all across the damn place."
    "A cidade estava em chamas, aquelas coisas sem dúvida surgindo por todo o maldito lugar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:255
translate ptPT qst_JudgementDay_SiegeStart_bd1b5a50:

    # MC @ serious "Markus... I need to find him!"
    MC @ serious "Markus... Eu preciso encontrá-lo!"

