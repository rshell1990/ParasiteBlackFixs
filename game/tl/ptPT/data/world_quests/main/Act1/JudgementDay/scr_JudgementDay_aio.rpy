# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2485
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_1efd2573:

    # REGINA "You need your energy for what's to come."
    REGINA "Você precisa da sua energia para o que está por vir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2487
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_c4a7603d:

    # "The cell blurred before my eyes. My strength left me."
    "A cela ficou embaçada diante dos meus olhos. Minhas forças me abandonaram."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2491
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_fc8bfd5a:

    # "The last thing I saw before the world faded to black... were [regina_ref!t]'s glowing, violet eyes watching me with something deeper than desire—"
    "A última coisa que vi antes de o mundo desaparecer na escuridão... foram os olhos violetas brilhantes de [regina_ref!t] me observando com algo mais profundo que o desejo—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2494
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_7af1c229:

    # "Something ancient."
    "Algo antigo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2497
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_8261940e:

    # "And then... darkness."
    "E então... escuridão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2498
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_625d90bd:

    # REGINA "Wake up, Shyahtan."
    REGINA "Acorda, Shyahtan."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2500
translate ptPT qst_JudgementDay_SiegeOverPrison_ReginaVisit_0208f99c:

    # REGINA "WAKE UP!"
    REGINA "ACORDA!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2510
translate ptPT qst_JudgementDay_TrialStart_729f26f0:

    # "A sudden splash of cold water shocked my system, forcing a desperate gasp from my lips."
    "Um jorro repentino de água fria chocou meu organismo, forçando um suspiro desesperado de meus lábios."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2514
translate ptPT qst_JudgementDay_TrialStart_00595328:

    # "I coughed, struggling for breath, my vision swimming as I slowly came to."
    "Eu tossi, lutando para respirar, minha visão turva enquanto lentamente voltava a mim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2516
translate ptPT qst_JudgementDay_TrialStart_e7095267:

    # "As my surroundings became clearer, I saw them."
    "Conforme o ambiente ao meu redor ficava mais claro, eu os vi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2518
translate ptPT qst_JudgementDay_TrialStart_425895dc:

    # "Guards. Watching. Spears pointed."
    "Guardas. Observando. Lanças apontadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2519
translate ptPT qst_JudgementDay_TrialStart_9e7c1a0d:

    # GUARD "Get up."
    GUARD "Levante-se."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2520
translate ptPT qst_JudgementDay_TrialStart_16394309:

    # GUARD "Your trial will begin shortly."
    GUARD "Seu julgamento começará em breve."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2522
translate ptPT qst_JudgementDay_TrialStart_8626a9cf:

    # "Before I even had the chance to rise, rough hands seized me."
    "Antes que eu tivesse a chance de me levantar, mãos ásperas me agarraram."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2523
translate ptPT qst_JudgementDay_TrialStart_6ad143bd:

    # "Cold metal clamped around my wrists and ankles as I was bound in chains."
    "Metal frio prendeu meus pulsos e tornozelos enquanto eu era acorrentado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2529
translate ptPT qst_JudgementDay_TrialStart_1ebf7804:

    # "They dragged me from my cell, my feet barely able to find the ground as I was pulled through the winding halls."
    "Arrastaram-me da minha cela, meus pés mal conseguindo tocar o chão enquanto eu era puxado pelos corredores sinuosos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2530
translate ptPT qst_JudgementDay_TrialStart_c3a4dd44:

    # "At last, we stopped before great, heavy, ornate doors."
    "Por fim, paramos diante de portas grandes, pesadas e ornamentadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2531
translate ptPT qst_JudgementDay_TrialStart_0f1cc5fe:

    # "They groaned open, revealing my fate."
    "Elas se abriram com um rangido, revelando meu destino."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2535
translate ptPT qst_JudgementDay_TrialStart_e1220ead:

    # "The courtroom."
    "O tribunal."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2536
translate ptPT qst_JudgementDay_TrialStart_fbb742c0:

    # "To my left, seated in perfect rows, were men in deep blue and purple robes, their faces obscured behind silver masks."
    "À minha esquerda, sentados em fileiras perfeitas, estavam homens com túnicas azul-escuras e roxas, seus rostos ocultos atrás de máscaras prateadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2537
translate ptPT qst_JudgementDay_TrialStart_6c66f9f3:

    # "Above them, seated upon high stone podiums flanking two burning firepits, sat three more figures."
    "Acima deles, sentados em altos pódios de pedra que ladeavam duas fogueiras acesas, estavam mais três figuras."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2538
translate ptPT qst_JudgementDay_TrialStart_ca7194e9:

    # "Their robes were red, their masks gleaming."
    "Suas túnicas eram vermelhas, suas máscaras reluzentes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2540
translate ptPT qst_JudgementDay_TrialStart_fa6810be:

    # "Shoved forward into the center of the chamber, I scanned the crowd for familiar faces."
    "Empurrado para o centro da câmara, examinei a multidão em busca de rostos conhecidos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2541
translate ptPT qst_JudgementDay_TrialStart_258a0cfd:

    # "None."
    "Nenhum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2542
translate ptPT qst_JudgementDay_TrialStart_92747b53:

    # "Only more masked figures. Watching. Waiting."
    "Apenas mais figuras mascaradas. Observando. Esperando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2543
translate ptPT qst_JudgementDay_TrialStart_2160188b:

    # GUARD "Judge Falwind. I present to you the prisoner."
    GUARD "Juiz Falwind. Apresento-lhe o prisioneiro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2544
translate ptPT qst_JudgementDay_TrialStart_3002041b:

    # "The murmurs around the chamber quieted as all eyes turned to me."
    "Os murmúrios pelo salão se aquietaram quando todos os olhos se voltaram para mim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2545
translate ptPT qst_JudgementDay_TrialStart_72502109:

    # JUDGE_FALWIND "Good morning, prisoner nine-six-one."
    JUDGE_FALWIND "Bom dia, prisioneiro nove-seis-um."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2546
translate ptPT qst_JudgementDay_TrialStart_c2cba07d:

    # JUDGE_FALWIND "Are you aware of the charges laid against you by Head Inquisitor Marion?"
    JUDGE_FALWIND "Você está ciente das acusações feitas contra você pelo Inquisidor-Chefe Marion?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2549
translate ptPT qst_JudgementDay_TrialStart_3c0000a5:

    # JUDGE_FALWIND "Good. Then you understand the seriousness of the matter."
    JUDGE_FALWIND "Ótimo. Então você entende a gravidade da questão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2551
translate ptPT qst_JudgementDay_TrialStart_5b07853c:

    # JUDGE_FALWIND "That is for the court to decide, nine-six-one."
    JUDGE_FALWIND "Isso cabe ao tribunal decidir, nove-seis-um."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2555
translate ptPT qst_JudgementDay_TrialStart_7c8f63d4:

    # "Angry murmurs erupted across the courtroom until Judge Falwind slammed his gavel down."
    "Murmúrios raivosos irromperam pelo tribunal até que o Juiz Falwind bateu seu martelo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2558
translate ptPT qst_JudgementDay_TrialStart_53dd2759:

    # JUDGE_FALWIND "I will not tolerate such behavior in my courtroom. I suggest you rethink your actions immediately."
    JUDGE_FALWIND "Não tolerarei tal comportamento em meu tribunal. Sugiro que repense suas ações imediatamente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2561
translate ptPT qst_JudgementDay_TrialStart_5241f00d:

    # "The judge skimmed over a stack of papers, stroking his beard as he located the page he sought."
    "O juiz folheou uma pilha de papéis, acariciando a barba enquanto localizava a página que procurava."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2562
translate ptPT qst_JudgementDay_TrialStart_7924de91:

    # JUDGE_FALWIND "Hmm..."
    JUDGE_FALWIND "Hmm..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2563
translate ptPT qst_JudgementDay_TrialStart_e3555e30:

    # JUDGE_FALWIND "Where is the other one?"
    JUDGE_FALWIND "Onde está o outro?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2564
translate ptPT qst_JudgementDay_TrialStart_ce8407d2:

    # JUDGE_FALWIND "There was to be one more on trial, was there not?"
    JUDGE_FALWIND "Deveria haver mais um em julgamento, não é?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2566
translate ptPT qst_JudgementDay_TrialStart_cd1bd15b:

    # "The doors swung open again."
    "As portas se abriram novamente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2567
translate ptPT qst_JudgementDay_TrialStart_16f92352:

    # "A beaten, disheveled Markus was dragged into the chamber."
    "Um Markus espancado e desgrenhado foi arrastado para a câmara."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2568
translate ptPT qst_JudgementDay_TrialStart_03e586ea:

    # "He was barely conscious."
    "Ele mal estava consciente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2570
translate ptPT qst_JudgementDay_TrialStart_0c3a177d:

    # MC @ surprised "MARKUS!"
    MC @ surprised "MARKUS!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2571
translate ptPT qst_JudgementDay_TrialStart_126e9dbc:

    # "I moved to reach him, but the guards immediately blocked my path."
    "Eu me movi para alcançá-lo, mas os guardas bloquearam meu caminho imediatamente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2572
translate ptPT qst_JudgementDay_TrialStart_bf497fdc:

    # JUDGE_FALWIND "Remain still, prisoner nine-six-one."
    JUDGE_FALWIND "Fique parado, prisioneiro nove-seis-um."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2575
translate ptPT qst_JudgementDay_TrialStart_f5383f45:

    # "With a cruel *thud,* they dropped Markus beside me."
    "Com um *baque* cruel, eles o largaram ao meu lado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2576
translate ptPT qst_JudgementDay_TrialStart_eb59abcc:

    # "He coughed up blood, his voice weak."
    "Ele tossiu sangue, com a voz fraca."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2577
translate ptPT qst_JudgementDay_TrialStart_91cc76d8:

    # MARKUS "{i}*Weakly*{/i} [player_name!t]..."
    MARKUS "{i}*Fracamente*{/i} [player_name!t]..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2580
translate ptPT qst_JudgementDay_TrialStart_02699468:

    # MC @ angry "How is he supposed to defend himself?!"
    MC @ angry "Como ele deveria se defender?!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2581
translate ptPT qst_JudgementDay_TrialStart_ca60b975:

    # MC @ angry "He can barely stand, let alone speak!"
    MC @ angry "Ele mal consegue ficar de pé, quanto mais falar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2582
translate ptPT qst_JudgementDay_TrialStart_d3515b39:

    # "Judge Falwind's gaze turned toward the guards."
    "O olhar do Juiz Falwind se voltou para os guardas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2583
translate ptPT qst_JudgementDay_TrialStart_9dc22665:

    # JUDGE_FALWIND "Explain prisoner eight-four-one's condition."
    JUDGE_FALWIND "Explique a condição do prisioneiro oito-quatro-um."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2585
translate ptPT qst_JudgementDay_TrialStart_13ea9dda:

    # GUARD "Apologies, Judge Falwind. The prisoner was… uncooperative."
    GUARD "Desculpas, Juiz Falwind. O prisioneiro estava… não cooperativo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2586
translate ptPT qst_JudgementDay_TrialStart_f0053ee9:

    # GUARD "We had to use severe restraint."
    GUARD "Tivemos que usar contenção severa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2588
translate ptPT qst_JudgementDay_TrialStart_7fad3231:

    # MC @ angry "YOU BEAT HIM HALF TO DEATH!"
    MC @ angry "VOCÊS O ESPANCARAM ATÉ QUASE A MORTE!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2591
translate ptPT qst_JudgementDay_TrialStart_be7b5f6d:

    # "*BANG!*"
    "*BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2592
translate ptPT qst_JudgementDay_TrialStart_f6fda186:

    # "Falwind's gavel slammed down."
    "O martelo de Falwind bateu com força."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2594
translate ptPT qst_JudgementDay_TrialStart_f154a8d0:

    # JUDGE_FALWIND "Control your emotions, nine-six-one, or I shall have you reprimanded further."
    JUDGE_FALWIND "Controle suas emoções, nove-seis-um, ou terei que repreendê-lo ainda mais."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2595
translate ptPT qst_JudgementDay_TrialStart_6f0d1973:

    # "With a heavy sigh, he glanced back at Markus, who lay crumpled on the floor."
    "Com um suspiro pesado, ele olhou de volta para Markus, que jazia amassado no chão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2596
translate ptPT qst_JudgementDay_TrialStart_643281fa:

    # JUDGE_FALWIND "Given the unfortunate state of your accomplice, we will proceed with your testimony speaking on his behalf."
    JUDGE_FALWIND "Dado o estado lamentável do seu cúmplice, prosseguiremos com o seu testemunho falando em nome dele."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2601
translate ptPT qst_JudgementDay_TrialStart_5b071465:

    # JUDGE_FALWIND "Hold your tongue, nine-six-one! I will not tolerate contempt in my court!"
    JUDGE_FALWIND "Segure sua língua, nove-seis-um! Não tolerarei desacato no meu tribunal!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2604
translate ptPT qst_JudgementDay_TrialStart_38318e26:

    # "The judge hesitated, then waved a hand dismissively."
    "O juiz hesitou, então fez um gesto desdenhoso com a mão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2605
translate ptPT qst_JudgementDay_TrialStart_42e2d16d:

    # JUDGE_FALWIND "Very well. Summon a Mage of Palam to tend to him."
    JUDGE_FALWIND "Muito bem. Convoquem um Mago de Palam para cuidar dele."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2607
translate ptPT qst_JudgementDay_TrialStart_4f2b5c04:

    # "The judge nodded, satisfied with my compliance."
    "O juiz assentiu, satisfeito com a minha submissão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2609
translate ptPT qst_JudgementDay_TrialStart_14adb04d:

    # JUDGE_FALWIND "Has the prosecution arrived?"
    JUDGE_FALWIND "A acusação chegou?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2610
translate ptPT qst_JudgementDay_TrialStart_fdc8f651:

    # GUARD "She has, Judge Falwind."
    GUARD "Ela chegou, Juiz Falwind."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2611
translate ptPT qst_JudgementDay_TrialStart_cd89cb8b:

    # JUDGE_FALWIND "Send her in."
    JUDGE_FALWIND "Mande-a entrar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2612
translate ptPT qst_JudgementDay_TrialStart_47151da1:

    # "The massive doors opened once more."
    "As enormes portas se abriram mais uma vez."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2613
translate ptPT qst_JudgementDay_TrialStart_36d06b98:

    # "A figure stepped forward."
    "Uma figura avançou."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2614
translate ptPT qst_JudgementDay_TrialStart_4fc678a8:

    # "Not Inquisitor Henvak, as expected."
    "Não o Inquisidor Henvak, como esperado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2615
translate ptPT qst_JudgementDay_TrialStart_af94376b:

    # "But an older woman. Head Inquisitor Marion."
    "Mas uma mulher mais velha. Inquisidora Chefe Marion."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2617
translate ptPT qst_JudgementDay_TrialStart_e682a58d:

    # "Uneasy murmurs rose across the court."
    "Murmúrios inquietos surgiram por todo o tribunal."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2618
translate ptPT qst_JudgementDay_TrialStart_32fb436b:

    # "Even Judge Falwind stiffened at the sight of her."
    "Até o Juiz Falwind enrijeceu ao vê-la."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2619
translate ptPT qst_JudgementDay_TrialStart_6ebe2672:

    # JUDGE_FALWIND "H-Head Inquisitor!"
    JUDGE_FALWIND "C-Chefe Inquisidora!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2620
translate ptPT qst_JudgementDay_TrialStart_8d9108b7:

    # MARION "I trust I am not late."
    MARION "Espero não estar atrasada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2622
translate ptPT qst_JudgementDay_TrialStart_f9ebf287:

    # JUDGE_FALWIND "E-Er, no, Inquisitor. But… on the paperwork, it states that Inquisitor Henvak was to handle the prosecution."
    JUDGE_FALWIND "É-Er, não, Inquisidora. Mas… na documentação, consta que o Inquisidor Henvak deveria conduzir a acusação."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2623
translate ptPT qst_JudgementDay_TrialStart_90e8994d:

    # MARION "Henvak is indisposed."
    MARION "Henvak está indisposto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2624
translate ptPT qst_JudgementDay_TrialStart_b657aaee:

    # MARION "Given the attention this trial has drawn, I have decided to intercede."
    MARION "Dada a atenção que este julgamento atraiu, decidi interceder."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2625
translate ptPT qst_JudgementDay_TrialStart_a4e6991c:

    # JUDGE_FALWIND "I… see. But Head Inquisitor, this is most unorthodox. Have you had adequate time to prepare?"
    JUDGE_FALWIND "Eu... vejo. Mas Inquisidora-Chefe, isso é muito pouco ortodoxo. Você teve tempo adequado para se preparar?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2626
translate ptPT qst_JudgementDay_TrialStart_30dfe46f:

    # MARION "I have, your honor."
    MARION "Sim, meritíssimo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2627
translate ptPT qst_JudgementDay_TrialStart_273760c0:

    # "The judge clearly did not like this."
    "O juiz claramente não gostou disso."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2628
translate ptPT qst_JudgementDay_TrialStart_3c7efe4d:

    # "But denying Marion's authority was… unwise."
    "Mas negar a autoridade de Marion foi... imprudente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2629
translate ptPT qst_JudgementDay_TrialStart_ce31a9d3:

    # JUDGE_FALWIND "Very well."
    JUDGE_FALWIND "Muito bem."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2630
translate ptPT qst_JudgementDay_TrialStart_982fa314:

    # JUDGE_FALWIND "With all parties present, would the prosecution like to make its opening statement?"
    JUDGE_FALWIND "Com todas as partes presentes, a acusação gostaria de fazer sua declaração de abertura?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2631
translate ptPT qst_JudgementDay_TrialStart_2eb85663:

    # MARION "I would, your honor."
    MARION "Sim, meritíssimo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2632
translate ptPT qst_JudgementDay_TrialStart_f15830e3:

    # "The Head Inquisitor stepped forward."
    "A Inquisidora-Chefe deu um passo à frente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2633
translate ptPT qst_JudgementDay_TrialStart_14740c7f:

    # "Her voice cut through the chamber, sharp and commanding."
    "Sua voz cortou o ar da câmara, afiada e imponente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2634
translate ptPT qst_JudgementDay_TrialStart_a1d051f8:

    # MARION "Today, the prosecution will prove—beyond doubt—that this creature is the result of dark magecraft!"
    MARION "Hoje, a acusação provará — sem sombra de dúvida — que esta criatura é fruto de magia negra!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2635
translate ptPT qst_JudgementDay_TrialStart_7b0f4d51:

    # MARION "That it has been consorting with the Demorai."
    MARION "Que tem estado em conluio com os Demorai."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2636
translate ptPT qst_JudgementDay_TrialStart_90e0a29b:

    # MARION "That it is at the very heart of a conspiracy to corrupt this city's highest officials!"
    MARION "Que está no centro de uma conspiração para corromper as mais altas autoridades desta cidade!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2638
translate ptPT qst_JudgementDay_TrialStart_8f14909a:

    # "The courtroom exploded in voices."
    "O tribunal explodiu em vozes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2639
translate ptPT qst_JudgementDay_TrialStart_1c998cdd:

    # "Gasps. Whispers. Outright accusations."
    "Suspiros. Sussurros. Acusações diretas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2641
translate ptPT qst_JudgementDay_TrialStart_be7b5f6d_1:

    # "*BANG!*"
    "*BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2642
translate ptPT qst_JudgementDay_TrialStart_be7b5f6d_2:

    # "*BANG!*"
    "*BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2643
translate ptPT qst_JudgementDay_TrialStart_b7f53723:

    # JUDGE_FALWIND "ORDER! ORDER!"
    JUDGE_FALWIND "ORDEM! ORDEM!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2645
translate ptPT qst_JudgementDay_TrialStart_b42540ba:

    # "As silence returned, he exhaled deeply."
    "Assim que o silêncio retornou, ele exalou profundamente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2646
translate ptPT qst_JudgementDay_TrialStart_cb980af3:

    # JUDGE_FALWIND "Prosecutor Marion, these are serious accusations on an already charged case. Do you have evidence to support such claims?"
    JUDGE_FALWIND "Promotor Marion, estas são acusações sérias em um caso já carregado. Você tem evidências para sustentar tais alegações?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2647
translate ptPT qst_JudgementDay_TrialStart_868965c1:

    # MARION "I do, your honor."
    MARION "Eu aceito, Meritíssimo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2648
translate ptPT qst_JudgementDay_TrialStart_76365bfb:

    # JUDGE_FALWIND "Then let us proceed."
    JUDGE_FALWIND "Então, prossigamos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2649
translate ptPT qst_JudgementDay_TrialStart_514b8f61:

    # "His gaze turned to me."
    "Seu olhar se voltou para mim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2650
translate ptPT qst_JudgementDay_TrialStart_6114110e:

    # JUDGE_FALWIND "And you, nine-six-one—"
    JUDGE_FALWIND "E você, nove-seis-um—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2651
translate ptPT qst_JudgementDay_TrialStart_2d0862fc:

    # JUDGE_FALWIND "What is your opening statement?"
    JUDGE_FALWIND "Qual é a sua declaração inicial?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2655
translate ptPT qst_JudgementDay_TrialStart_0f402d51:

    # MC @ angry "We are loyal subjects of Alderay! We fought and bled for this empire a thousand times!"
    MC @ angry "Somos leais súditos de Alderay! Lutamos e sangramos por este império mil vezes!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2656
translate ptPT qst_JudgementDay_TrialStart_6ea465c8:

    # MC @ angry "And we would do it a thousand times more!"
    MC @ angry "E faríamos isso mais mil vezes!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2658
translate ptPT qst_JudgementDay_TrialStart_b07c67fe:

    # "There was a murmur of approval among the jury."
    "Houve um murmúrio de aprovação entre o júri."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2662
translate ptPT qst_JudgementDay_TrialStart_16cb8271:

    # "My voice was steady. Determined."
    "Minha voz estava firme. Determinada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2668
translate ptPT qst_JudgementDay_TrialStart_cb6d2bee:

    # "The jury turned against me. Angry whispers spread like wildfire."
    "O júri se voltou contra mim. Sussurros raivosos se espalharam como fogo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2669
translate ptPT qst_JudgementDay_TrialStart_a26d35f8:

    # "Marion smiled."
    "Marion sorriu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2671
translate ptPT qst_JudgementDay_TrialStart_be7b5f6d_3:

    # "*BANG!*"
    "*BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2673
translate ptPT qst_JudgementDay_TrialStart_be7b5f6d_4:

    # "*BANG!*"
    "*BANG!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2674
translate ptPT qst_JudgementDay_TrialStart_9a7d3f70:

    # JUDGE_FALWIND "ORDER! I will not tolerate outbursts in this court!"
    JUDGE_FALWIND "ORDEM! Não tolerarei explosões neste tribunal!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2675
translate ptPT qst_JudgementDay_TrialStart_cb7bd914:

    # "The judge sighed."
    "O juiz suspirou."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2678
translate ptPT qst_JudgementDay_TrialStart_c9d2f94e:

    # JUDGE_FALWIND "Head Inquisitor Marion, present your first witness."
    JUDGE_FALWIND "Inquisidor-Chefe Marion, apresente sua primeira testemunha."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2679
translate ptPT qst_JudgementDay_TrialStart_74d2e78e:

    # MARION @ smile "Gladly, your honor."
    MARION @ smile "Com prazer, Meritíssimo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2680
translate ptPT qst_JudgementDay_TrialStart_a1365872:

    # MARION @ talk "The prosecution calls…"
    MARION @ talk "A acusação chama…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2681
translate ptPT qst_JudgementDay_TrialStart_1591d5dc:

    # MARION @ talk "Captain Nyx of the City Guard."
    MARION @ talk "Capitã Nyx da Guarda da Cidade."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2684
translate ptPT qst_JudgementDay_TrialStart_591b5abe:

    # "Quiet murmurs rose up as the doors swung open and Captain Nyx, stood proud, made her way silently to the stand, refusing to break her utterly neutral expression."
    "Murmúrios baixos surgiram enquanto as portas se abriam e a Capitã Nyx, orgulhosa, dirigiu-se silenciosamente ao banco das testemunhas, recusando-se a quebrar sua expressão totalmente neutra."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2686
translate ptPT qst_JudgementDay_TrialStart_a62bf6d9:

    # MARION @ talk "Captain Nyx... Could you tell us more about your rank and what your duty entails?"
    MARION @ talk "Capitão Nyx... Poderia nos contar mais sobre sua patente e o que seu dever implica?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2687
translate ptPT qst_JudgementDay_TrialStart_b3dd3d77:

    # NYX @ talk "I am Captain of the city guard of Novaras, I am charged with keeping the city safe both internally and externally from threats, and maintaining peace within the city's walls."
    NYX @ talk "Eu sou o Capitão da guarda da cidade de Novaras, sou encarregado de manter a cidade segura tanto internamente quanto externamente contra ameaças, e manter a paz dentro dos muros da cidade."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2688
translate ptPT qst_JudgementDay_TrialStart_1412d041:

    # MARION @ smile "I see..."
    MARION @ smile "Entendo..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2689
translate ptPT qst_JudgementDay_TrialStart_a854db35:

    # MARION @ talk "And tell me, what are you direct resonsibilites when it pertains to inquisitor business?"
    MARION @ talk "E diga-me, quais são suas responsabilidades diretas quando se trata de assuntos da inquisição?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2690
translate ptPT qst_JudgementDay_TrialStart_f114f57d:

    # NYX @ angry "... To report anything suspect of Dark magecraft to the inquisition at once, or anything related to a Demorai pressence in the city."
    NYX @ angry "... Relatar qualquer coisa suspeita de magia negra à inquisição imediatamente, ou qualquer coisa relacionada à presença Demorai na cidade."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2691
translate ptPT qst_JudgementDay_TrialStart_71cf5aa5:

    # MARION @ smile "Interesting..."
    MARION @ smile "Interessante..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2692
translate ptPT qst_JudgementDay_TrialStart_6879d8fd:

    # MARION @ talk "So, tell me."
    MARION @ talk "Então, diga-me."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2693
translate ptPT qst_JudgementDay_TrialStart_3a4ddeeb:

    # MARION @ talk "Are these your signatures on these reports?"
    MARION @ talk "Estas são suas assinaturas nestes relatórios?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2694
translate ptPT qst_JudgementDay_TrialStart_105627b8:

    # "In her hands, the head inquisitor waved about a series of papers before throwing them down in front of Nyx, who uncomfortably inspected them."
    "Em suas mãos, a inquisidora-chefe balançou uma série de papéis antes de jogá-los na frente de Nyx, que os inspecionou desconfortavelmente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2695
translate ptPT qst_JudgementDay_TrialStart_a03c590d:

    # NYX @ angry "Yes... This is my signature."
    NYX @ angry "Sim... Esta é minha assinatura."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2696
translate ptPT qst_JudgementDay_TrialStart_c33784e9:

    # MARION @ angry "Why then, did you choose to send false reports when asked to investigate prisoners nine-six-one and eight-four-one?"
    MARION @ angry "Por que então escolheu enviar relatórios falsos quando lhe pediram para investigar os prisioneiros nove-seis-um e oito-quatro-um?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2697
translate ptPT qst_JudgementDay_TrialStart_3ad74a5b:

    # "There was a heavy, long pause."
    "Houve uma pausa longa e pesada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2698
translate ptPT qst_JudgementDay_TrialStart_7f75cc04:

    # JUDGE_FALWIND "... Captain Nyx, the prosecution has asked you-"
    JUDGE_FALWIND "... Capitão Nyx, a promotoria lhe perguntou-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2699
translate ptPT qst_JudgementDay_TrialStart_bad2afae:

    # NYX @ angry "Everything I have done, I have done to defend this city."
    NYX @ angry "Tudo o que fiz, fiz para defender esta cidade."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2700
translate ptPT qst_JudgementDay_TrialStart_1c354aac:

    # NYX @ angry "The guard is woefully desperate and I-"
    NYX @ angry "A guarda está terrivelmente desesperada e eu-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2701
translate ptPT qst_JudgementDay_TrialStart_de61f8b4:

    # MARION @ angry "You chose to dangerously override the authority of all others and directly disobey the chain of command!"
    MARION @ angry "Você escolheu perigosamente anular a autoridade de todos os outros e desobedecer diretamente à cadeia de comando!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2702
translate ptPT qst_JudgementDay_TrialStart_1d415769:

    # MARION @ angry "Your reckless decisions could have endangered everyone in this city!"
    MARION @ angry "Suas decisões imprudentes poderiam ter colocado todos nesta cidade em perigo!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2703
translate ptPT qst_JudgementDay_TrialStart_8ab4967d:

    # NYX @ angry "EVERYONE IS ALREADY ENDANGERED!"
    NYX @ angry "TODOS JÁ ESTÃO EM PERIGO!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2704
translate ptPT qst_JudgementDay_TrialStart_08f6cc85:

    # "The gavel came down once more."
    "O martelo bateu mais uma vez."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2705
translate ptPT qst_JudgementDay_TrialStart_ff11b318:

    # JUDGE_FALWIND "Control yourself, please."
    JUDGE_FALWIND "Controle-se, por favor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2706
translate ptPT qst_JudgementDay_TrialStart_daf4db0b:

    # MARION @ angry "I submit, that Captain Nyx directly defied orders, disobeying the chain of command and endangered everyone."
    MARION @ angry "Afirmo que a Capitã Nyx desafiou diretamente as ordens, desobedecendo à cadeia de comando e colocando todos em perigo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2707
translate ptPT qst_JudgementDay_TrialStart_339f8052:

    # JUDGE_FALWIND "Inquisitor Marion, with all due respect, this is not the Captain's trial-"
    JUDGE_FALWIND "Inquisidor Marion, com todo o respeito, este não é o julgamento da Capitã-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2708
translate ptPT qst_JudgementDay_TrialStart_2368c107:

    # MARION @ angry "Captain Nyx recognized the potential power of this dark, magecraft abomination and chose to strike a bargain with it!"
    MARION @ angry "A Capitã Nyx reconheceu o poder potencial desta abominação sombria da magia e escolheu fazer um acordo com ela!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2709
translate ptPT qst_JudgementDay_TrialStart_985279fc:

    # MARION @ angry "It would serve her bidding and earn her prestige, in return, she actively has chose to hide it's secrets and protect it whenever she could!"
    MARION @ angry "Ela a serviria e lhe traria prestígio, em troca, ela optou ativamente por esconder seus segredos e protegê-la sempre que podia!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2710
translate ptPT qst_JudgementDay_TrialStart_62c07c2b:

    # MARION @ angry "The two cases are inexplicably linked!"
    MARION @ angry "Os dois casos estão inexplicavelmente ligados!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2711
translate ptPT qst_JudgementDay_TrialStart_8929fa87:

    # JUDGE_FALWIND "That be so... I must ask you keep the focus more towards those on trial, inquisitor from now on."
    JUDGE_FALWIND "Sendo assim... Devo pedir que mantenha o foco mais nos que estão sendo julgados, inquisidor, de agora em diante."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2712
translate ptPT qst_JudgementDay_TrialStart_3bb8fd45:

    # JUDGE_FALWIND "Captain Nyx's trial is a seperate matter."
    JUDGE_FALWIND "O julgamento da Capitã Nyx é uma questão separada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2713
translate ptPT qst_JudgementDay_TrialStart_11124689:

    # MARION @ angry "Tsch..."
    MARION @ angry "Tsch..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2714
translate ptPT qst_JudgementDay_TrialStart_c2a8c4d5:

    # MARION @ smile "Of course, your honor."
    MARION @ smile "Claro, meritíssimo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2716
translate ptPT qst_JudgementDay_TrialStart_61493824:

    # "Judge Falwind's eyes lifted towards me."
    "Os olhos do Juiz Falwind se ergueram em minha direção."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2717
translate ptPT qst_JudgementDay_TrialStart_31c13124:

    # JUDGE_FALWIND "Would you like to ask any questions to the witness?"
    JUDGE_FALWIND "Gostaria de fazer alguma pergunta à testemunha?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2722
translate ptPT qst_JudgementDay_Trial_questions_bea314c4:

    # NYX @ talk "The state of the guard is in complete disorrey."
    NYX @ talk "O estado do guarda está completamente desordenado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2723
translate ptPT qst_JudgementDay_Trial_questions_3f4274bc:

    # NYX @ talk "We are woefully short of everything, including men."
    NYX @ talk "Estamos terrivelmente escassos de tudo, incluindo homens."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2724
translate ptPT qst_JudgementDay_Trial_questions_938bcd45:

    # MC @ talk "And why have you been unable to fix these issues, Captain? Isn't it your job?"
    MC @ talk "E por que você não conseguiu resolver esses problemas, Capitão? Não é seu trabalho?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2725
translate ptPT qst_JudgementDay_Trial_questions_35ffae84:

    # NYX @ talk "Resources are given to the city guard {i}last,{/i} and request for supplies and men often takes months to arrive."
    NYX @ talk "Os recursos são dados à guarda da cidade {i}por último,{/i} e os pedidos de suprimentos e homens muitas vezes levam meses para chegar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2726
translate ptPT qst_JudgementDay_Trial_questions_606288ee:

    # MC @ talk "Could your explain your actions in recruiting my help?"
    MC @ talk "Você poderia explicar suas ações ao recrutar minha ajuda?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2727
translate ptPT qst_JudgementDay_Trial_questions_d1cadab9:

    # "There was another long pause."
    "Houve outra longa pausa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2728
translate ptPT qst_JudgementDay_Trial_questions_3bedea18:

    # NYX @ talk "I weighed heavily on the thought of what report to send."
    NYX @ talk "Ponderei intensamente sobre qual relatório enviar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2729
translate ptPT qst_JudgementDay_Trial_questions_2fca19d7:

    # NYX @ talk "But I {i}believed{/i}, you and your friend were good men, who served and fought bravely in the scouts."
    NYX @ talk "Mas eu {i}acreditava{/i} que você e seu amigo eram bons homens, que serviram e lutaram bravamente nos batedores."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2730
translate ptPT qst_JudgementDay_Trial_questions_da96bb03:

    # NYX @ talk "And in a moment of desperation, or perhaps madness, I took a risk on the two of you."
    NYX @ talk "E num momento de desespero, ou talvez loucura, arrisquei com vocês dois."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2731
translate ptPT qst_JudgementDay_Trial_questions_3beef95f:

    # MARION @ angry "She admits it!"
    MARION @ angry "Ela admite!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2732
translate ptPT qst_JudgementDay_Trial_questions_4c6570b9:

    # JUDGE_FALWIND "Order! Inquisitor Marion!"
    JUDGE_FALWIND "Ordem! Inquisidor Marion!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2733
translate ptPT qst_JudgementDay_Trial_questions_a06822ef:

    # JUDGE_FALWIND "The defence is not done with it's line of questioning."
    JUDGE_FALWIND "A defesa ainda não terminou sua linha de interrogatório."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2734
translate ptPT qst_JudgementDay_Trial_questions_11124689:

    # MARION @ angry "Tsch..."
    MARION @ angry "Tsc..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2735
translate ptPT qst_JudgementDay_Trial_questions_56268c21:

