translate ptPT qst_JudgementDay_GotToTheWall_c9bf0fae:

    # "Archers and mages fired relentlessly at the invading forces below, doing everything in their power to hold the line."
    "Arqueiros e magos disparavam implacavelmente contra as forças invasoras abaixo, fazendo tudo ao seu alcance para manter a linha."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1863
translate ptPT qst_JudgementDay_GotToTheWall_71f4d550:

    # MC "…Fuck."
    MC "…Merda."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1865
translate ptPT qst_JudgementDay_GotToTheWall_21733e58:

    # ERIKA "Come on. Don't get distracted."
    ERIKA "Vamos. Não se distraia."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1866
