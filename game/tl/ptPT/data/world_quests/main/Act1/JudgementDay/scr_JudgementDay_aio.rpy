translate ptPT qst_JudgementDay_GotToTheWall_4913ab10:

    # "In that instant, I heard it—that terrifying, inhuman screech."
    "Naquele instante, eu a ouvi — aquele grito aterrorizante e desumano."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1870
translate ptPT qst_JudgementDay_GotToTheWall_fd6c3497:

    # "The one I had tried so desperately to forget."
    "Aquele que eu tinha tentado desesperadamente esquecer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1871
translate ptPT qst_JudgementDay_GotToTheWall_99243f1e:

    # ERIKA "This way! Hurry!"
    ERIKA "Por aqui! Rápido!"

