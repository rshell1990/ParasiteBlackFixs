translate ptPT qst_JudgementDay_RescueMages_Prep_a350cb10:

    # "Erika stepped forward, slamming her fist against the door."
    "Erika deu um passo à frente, batendo o punho contra a porta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1489
translate ptPT qst_JudgementDay_RescueMages_Prep_14f45b1f:

    # ERIKA "By order of the Inquisition, I demand you open this door!"
    ERIKA "Por ordem da Inquisição, exijo que abra esta porta!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1490
translate ptPT qst_JudgementDay_RescueMages_Prep_4a41de21:

    # "There was a long pause before a sheepish face peeked through the gap."
    "Houve uma longa pausa antes que um rosto envergonhado espiasse pela fresta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1493
translate ptPT qst_JudgementDay_RescueMages_Prep_329c6e6a:

    # "A woman, disheveled and covered in ash, but distinctly noble, oddly resembled Adara in appearance."
    "Uma mulher, desgrenhada e coberta de cinzas, mas distintamente nobre, estranhamente se assemelhava a Adara na aparência."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1495
translate ptPT qst_JudgementDay_RescueMages_Prep_ee6d7f8e:

    # "Upon seeing me and Markus, she gasped and attempted to slam the door shut, but Erika wedged her foot in before she could."
    "Ao ver a mim e a Markus, ela ofegou e tentou fechar a porta com força, mas Erika enfiou o pé antes que ela pudesse."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1497
translate ptPT qst_JudgementDay_RescueMages_Prep_8e798dd8:

    # SOPHIRA "G-Get back!"
    SOPHIRA "S-Saia!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1498
translate ptPT qst_JudgementDay_RescueMages_Prep_e1310062:

    # ERIKA "Hold!"
    ERIKA "Alto!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1499
translate ptPT qst_JudgementDay_RescueMages_Prep_10c0580a:

    # ERIKA "They are with me."
    ERIKA "Eles estão comigo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1500
translate ptPT qst_JudgementDay_RescueMages_Prep_cf899e87:

    # "The woman's wide, fearful eyes darted back and forth between me and Markus before she hesitantly turned back to Erika."
    "Os olhos arregalados e medrosos da mulher iam e vinham entre mim e Markus antes que ela, hesitante, se virasse novamente para Erika."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1501
translate ptPT qst_JudgementDay_RescueMages_Prep_c1aa6fc5:

    # ERIKA "Who are you?"
    ERIKA "Quem é você?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1502
translate ptPT qst_JudgementDay_RescueMages_Prep_ca9584e7:

    # SOPHIRA "...I..."
    SOPHIRA "...Eu..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1503
translate ptPT qst_JudgementDay_RescueMages_Prep_f34e4dec:

    # SOPHIRA "I am Lady Maringott, but call me Sophira."
    SOPHIRA "Sou Lady Maringott, mas me chame de Sophira."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1505
translate ptPT qst_JudgementDay_RescueMages_Prep_dcfb449e:

    # ERIKA "The Mages of Palam—are they here?"
    ERIKA "Os Magos de Palam—estão aqui?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1506
translate ptPT qst_JudgementDay_RescueMages_Prep_0988535a:

    # SOPHIRA "Y-Yes... Come quickly."
    SOPHIRA "S-Sim... Venha rápido."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1510
translate ptPT qst_JudgementDay_RescueMages_Prep_89f25f4f:

    # "Sophira led us into the main hall of the manor, now a makeshift infirmary littered with wounded men and women."
    "Sophira nos conduziu ao salão principal da mansão, agora uma enfermaria improvisada repleta de homens e mulheres feridos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1511
translate ptPT qst_JudgementDay_RescueMages_Prep_18de3914:

    # "The air was filled with pained groans as bloodied civilians and soldiers writhed on hastily arranged beds."
    "O ar estava cheio de gemidos dolorosos enquanto civis e soldados ensanguentados se contorciam em camas improvisadas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1512
translate ptPT qst_JudgementDay_RescueMages_Prep_ef679b7f:

    # "Exhausted Mages of Palam moved frantically, tending to the wounded."
    "Os exaustos Magos de Palam se moviam freneticamente, cuidando dos feridos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1515
translate ptPT qst_JudgementDay_RescueMages_Prep_be997334:

    # "The chaos of the scene meant few even looked up at us."
    "O caos da cena fazia com que poucos sequer olhassem para nós."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1519
translate ptPT qst_JudgementDay_RescueMages_Prep_4cb32837:

    # ERIKA "What is going on here?"
    ERIKA "O que está acontecendo aqui?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1520
translate ptPT qst_JudgementDay_RescueMages_Prep_32a7d9bc:

    # SOPHIRA "The attack came so suddenly..."
    SOPHIRA "O ataque veio tão de repente..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1521
translate ptPT qst_JudgementDay_RescueMages_Prep_ab1b8518:

    # SOPHIRA "We opened our doors to shelter as many as we could, but the wounded kept piling in."
    SOPHIRA "Abrimos nossas portas para abrigar o máximo que pudemos, mas os feridos continuavam chegando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1522
translate ptPT qst_JudgementDay_RescueMages_Prep_08869913:

    # "Her face darkened."
    "O rosto dela escureceu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1523
translate ptPT qst_JudgementDay_RescueMages_Prep_46f9b89b:

    # SOPHIRA "...Some of the mages didn't make it."
    SOPHIRA "...Alguns dos magos não conseguiram."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1524
translate ptPT qst_JudgementDay_RescueMages_Prep_c277dfeb:

    # SOPHIRA "But those who remain have been a blessing from the gods."
    SOPHIRA "Mas aqueles que permaneceram têm sido uma bênção dos deuses."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1525
translate ptPT qst_JudgementDay_RescueMages_Prep_ba99da2c:

    # SOPHIRA "I fear many more would have perished without them."
    SOPHIRA "Temo que muitos mais teriam perecido sem eles."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1526
translate ptPT qst_JudgementDay_RescueMages_Prep_288b2912:

    # ERIKA "Where is your husband?"
    ERIKA "Onde está seu marido?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1527
translate ptPT qst_JudgementDay_RescueMages_Prep_2b343ada:

    # SOPHIRA "My husband lost his legs many years ago."
    SOPHIRA "Meu marido perdeu as pernas há muitos anos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1528
translate ptPT qst_JudgementDay_RescueMages_Prep_d5a91e24:

    # SOPHIRA "I've confined him to his room for safety until this nightmare ends."
    SOPHIRA "Eu o confinei ao quarto dele por segurança até que este pesadelo termine."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1529
translate ptPT qst_JudgementDay_RescueMages_Prep_9804f65a:

    # MC "What can we do to help?"
    MC "O que podemos fazer para ajudar?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1530
translate ptPT qst_JudgementDay_RescueMages_Prep_3cc7ceca:

    # SOPHIRA "Please... We need more medicine. The mages are exhausted."
    SOPHIRA "Por favor... Precisamos de mais remédios. Os magos estão exaustos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1531
translate ptPT qst_JudgementDay_RescueMages_Prep_6260956e:

    # ERIKA "Take these people to the main fort. There will be—"
    ERIKA "Levem essas pessoas para o forte principal. Haverá—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1532
translate ptPT qst_JudgementDay_RescueMages_Prep_08946951:

    # SOPHIRA "No!"
    SOPHIRA "Não!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1533
translate ptPT qst_JudgementDay_RescueMages_Prep_16119eaf:

    # SOPHIRA "None of the wounded can fight, and the mages are too drained."
    SOPHIRA "Nenhum dos feridos pode lutar, e os magos estão exaustos demais."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1534
translate ptPT qst_JudgementDay_RescueMages_Prep_8bff53d6:

    # SOPHIRA "We'd be slaughtered if we tried to move now."
    SOPHIRA "Seríamos massacrados se tentássemos nos mover agora."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1535
translate ptPT qst_JudgementDay_RescueMages_Prep_b0728f26:

    # MC "Then what do you suggest?"
    MC "Então o que você sugere?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1536
translate ptPT qst_JudgementDay_RescueMages_Prep_cbc9f014:

    # SOPHIRA "The basement."
    SOPHIRA "O porão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1537
translate ptPT qst_JudgementDay_RescueMages_Prep_94f195d8:

    # SOPHIRA "There are more medical supplies, food, and water down there."
    SOPHIRA "Há mais suprimentos médicos, comida e água lá embaixo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1538
translate ptPT qst_JudgementDay_RescueMages_Prep_1fc6089c:

    # ERIKA "Then why haven't you retrieved them already?"
    ERIKA "Então por que você ainda não os pegou?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1539
translate ptPT qst_JudgementDay_RescueMages_Prep_8e33a28a:

    # SOPHIRA "{i}...Something is down there.{/i}"
    SOPHIRA "{i}...Tem algo lá embaixo.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1540
translate ptPT qst_JudgementDay_RescueMages_Prep_069e8943:

    # SOPHIRA "When everything started, we heard strange noises coming from the basement."
    SOPHIRA "Quando tudo começou, ouvimos barulhos estranhos vindo do porão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1541
translate ptPT qst_JudgementDay_RescueMages_Prep_519c41a4:

    # SOPHIRA "We sent two guards down to check, and then... we heard the most awful sounds."
    SOPHIRA "Enviamos dois guardas para verificar, e então... ouvimos os sons mais terríveis."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1542
translate ptPT qst_JudgementDay_RescueMages_Prep_856a2c1b:

    # ERIKA "Is the basement secure now?"
    ERIKA "O porão está seguro agora?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1543
translate ptPT qst_JudgementDay_RescueMages_Prep_6cd2601f:

    # SOPHIRA "Yes... We bolted and barricaded it shut."
    SOPHIRA "Sim... Nós trancamos e barricamos a porta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1544
translate ptPT qst_JudgementDay_RescueMages_Prep_4df24ebb:

    # SOPHIRA "{i}But we can still hear something moving down there...{/i}"
    SOPHIRA "{i}Mas ainda podemos ouvir algo se movendo lá embaixo...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1545
translate ptPT qst_JudgementDay_RescueMages_Prep_3ca32141:

    # MC "Where is this basement?"
    MC "Onde fica esse porão?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1546
translate ptPT qst_JudgementDay_RescueMages_Prep_1307e2ea:

    # SOPHIRA "Wait...! Before you go."
    SOPHIRA "Espere...! Antes de você ir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1547
translate ptPT qst_JudgementDay_RescueMages_Prep_f0cc9421:

    # SOPHIRA "Take these."
    SOPHIRA "Pegue isto."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1552
translate ptPT qst_JudgementDay_RescueMages_Prep_fb70bf95:

    # SOPHIRA "I can't spare much, but... hopefully, you'll be able to clear out whatever's down there."
    SOPHIRA "Não posso dispor de muito, mas... espero que você consiga eliminar o que quer que esteja lá embaixo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1553
translate ptPT qst_JudgementDay_RescueMages_Prep_bf0933ee:

    # ERIKA "Take us to the basement."
    ERIKA "Leve-nos ao porão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1554
translate ptPT qst_JudgementDay_RescueMages_Prep_ed135172:

    # ERIKA "We don't have much time."
    ERIKA "Não temos muito tempo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1563
translate ptPT qst_JudgementDay_RescueMages_Prep_de8d52ca:

    # "...The basement door was heavily barricaded, tables and chairs stacked against it in a desperate attempt to keep something locked inside."
    "...A porta do porão estava fortemente barricada, mesas e cadeiras empilhadas contra ela numa tentativa desesperada de manter algo trancado lá dentro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1564
translate ptPT qst_JudgementDay_RescueMages_Prep_5510eb32:

    # "It took several minutes to clear away the debris before we reached the door itself."
    "Levamos vários minutos para limpar os destroços antes de chegar à porta propriamente dita."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1565
translate ptPT qst_JudgementDay_RescueMages_Prep_2d08aad9:

    # "Sophira hesitated, stepping back as I reached for the handle."
    "Sophira hesitou, recuando quando alcancei a maçaneta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1569
translate ptPT qst_JudgementDay_RescueMages_Prep_f2fd1f30:

    # "As the door creaked open, an eerie darkness stretched down into the unknown."
    "Quando a porta rangeu ao abrir, uma escuridão arrepiante se estendia para o desconhecido."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1571
translate ptPT qst_JudgementDay_RescueMages_Prep_9f7bb532:

    # MARKUS "...You first."
    MARKUS "...Você primeiro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1572
translate ptPT qst_JudgementDay_RescueMages_Prep_2464d270:

    # "Step by step, we descended into the oppressive darkness, the cold stone beneath our feet making every movement feel heavier."
    "Passo a passo, descemos na escuridão opressiva, a pedra fria sob nossos pés tornando cada movimento mais pesado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1574
translate ptPT qst_JudgementDay_RescueMages_Prep_a5faaf6e:

    # "Elena whined nervously behind me."
    "Elena gemeu nervosamente atrás de mim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1576
translate ptPT qst_JudgementDay_RescueMages_Prep_20c6c022:

    # MC "Calm, Elena."
    MC "Calma, Elena."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1580
translate ptPT qst_JudgementDay_RescueMages_Prep_05531ad1:

    # MYU "T-This seems like a bad idea to Myu..."
    MYU "I-Isso parece uma má ideia para Myu..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1585
translate ptPT qst_JudgementDay_RescueMages_Prep_784f60a8:

    # "Finally, we reached the bottom."
    "Finalmente, chegamos ao fundo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1586
translate ptPT qst_JudgementDay_RescueMages_Prep_a1b18879:

    # "Even in the dim light, I could see the place was a mess—broken crates, toppled shelves, and shattered bottles lay scattered across the floor."
    "Mesmo na penumbra, pude ver que o lugar estava um caos—caixotes quebrados, prateleiras caídas e garrafas estilhaçadas espalhadas pelo chão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1587
translate ptPT qst_JudgementDay_RescueMages_Prep_d10a2b67:

    # "Food, medicine, and supplies lay in ruined heaps as though some wild beast had rampaged through here."
    "Comida, remédios e suprimentos estavam em montes arruinados, como se alguma fera selvagem tivesse passado por aqui em fúria."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1588
translate ptPT qst_JudgementDay_RescueMages_Prep_b06dde3e:

    # "Most disturbing of all was the heavy trail of blood that led deeper into the room... only to suddenly disappear in the middle of the floor."
    "O mais perturbador era a trilha pesada de sangue que levava ao fundo da sala... apenas para desaparecer de repente no meio do chão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1589
translate ptPT qst_JudgementDay_RescueMages_Prep_84dbeb44:

    # "Erika tightened her grip on her sword as a strange dragging sound echoed through the chamber."
    "Erika apertou o punho da espada enquanto um estranho som de arrasto ecoava pelo aposento."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1590
translate ptPT qst_JudgementDay_RescueMages_Prep_f34d9a6e:

    # ERIKA "{i}It's still here...{/i}"
    ERIKA "{i}Ainda está aqui...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1591
translate ptPT qst_JudgementDay_RescueMages_Prep_fc93b91b:

    # "A sinister, wet slithering noise grew louder, circling us from the shadows."
    "Um sinistro e molhado ruído de deslizar ficou mais alto, nos cercando das sombras."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1592
translate ptPT qst_JudgementDay_RescueMages_Prep_07a3131b:

    # "And then, as if the very darkness itself was shifting, everything went still..."
    "E então, como se a própria escuridão estivesse se movendo, tudo ficou imóvel..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1602
translate ptPT qst_JudgementDay_RescueMages_Prep_7b8076d7:

    # "Writhing in agony, the creature let out a sickening bellow as blood sprayed across the walls."
    "Contorcendo-se em agonia, a criatura soltou um bramido nauseante enquanto o sangue respingava pelas paredes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1604
translate ptPT qst_JudgementDay_RescueMages_Prep_b620a0e1:

    # "In a final desperate lunge, it attempted to strike—but with a swift swipe of my tail, its head tumbled to the floor, lifeless."
    "Em uma investida final desesperada, ela tentou atacar—mas com um golpe rápido do meu rabo, sua cabeça caiu ao chão, sem vida."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1606
translate ptPT qst_JudgementDay_RescueMages_Prep_503eb673:

    # MARKUS "{i}*Huff*{/i} What in all the gods was that thing?"
    MARKUS "{i}*Huff*{/i} O que, em nome de todos os deuses, era aquela coisa?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1608
translate ptPT qst_JudgementDay_RescueMages_Prep_836a7533:

    # ERIKA "{i}I've seen creatures like this before...{/i}"
    ERIKA "{i}Já vi criaturas assim antes...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1609
translate ptPT qst_JudgementDay_RescueMages_Prep_e7942df9:

    # MARKUS "You have?"
    MARKUS "Você já viu?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1610
translate ptPT qst_JudgementDay_RescueMages_Prep_8b418497:

    # ERIKA "Dark mages can create many horrors..."
    ERIKA "Magos das trevas podem criar muitos horrores..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1611
translate ptPT qst_JudgementDay_RescueMages_Prep_4c777b59:

    # MARKUS "Wait, are you saying dark mages are working with the Demorai?"
    MARKUS "Espere, você está dizendo que os magos das trevas estão trabalhando com os Demorai?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1612
translate ptPT qst_JudgementDay_RescueMages_Prep_a7d1cbb7:

    # ERIKA "Who knows? We don't have time to speculate."
    ERIKA "Quem sabe? Não temos tempo para especular."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1613
translate ptPT qst_JudgementDay_RescueMages_Prep_00904404:

    # ERIKA "Let's go back and tell Sophira it's safe."
    ERIKA "Vamos voltar e dizer à Sophira que está seguro."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1622
translate ptPT qst_JudgementDay_RescueMages_Prep_cc1017a7:

    # SOPHIRA "You're back!"
    SOPHIRA "Vocês voltaram!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1623
translate ptPT qst_JudgementDay_RescueMages_Prep_d8f05fb2:

    # SOPHIRA "We heard terrible noises—I feared the worst!"
    SOPHIRA "Ouvimos barulhos terríveis — eu temi o pior!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1624
translate ptPT qst_JudgementDay_RescueMages_Prep_249d38dc:

    # ERIKA "It's safe now."
    ERIKA "Está seguro agora."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1625
translate ptPT qst_JudgementDay_RescueMages_Prep_66fbe380:

    # ERIKA "Though I'm afraid much of the medicine may be lost..."
    ERIKA "Embora eu tema que muito do medicamento possa ter sido perdido..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1626
translate ptPT qst_JudgementDay_RescueMages_Prep_bea94ee9:

    # SOPHIRA "We'll make do. Thank you."
    SOPHIRA "Daremos um jeito. Obrigado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1627
translate ptPT qst_JudgementDay_RescueMages_Prep_3a185799:

    # "Sophira turned toward me and Markus, her expression softening."
    "Sophira virou-se para mim e Markus, com a expressão se abrandando."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1628
translate ptPT qst_JudgementDay_RescueMages_Prep_a3550950:

    # SOPHIRA "...Thank you."
    SOPHIRA "...Obrigado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1629
translate ptPT qst_JudgementDay_RescueMages_Prep_8e36738f:

    # SOPHIRA "You may have saved a lot of lives today."
    SOPHIRA "Você pode ter salvado muitas vidas hoje."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1635
translate ptPT qst_JudgementDay_RescueMages_Prep_46afb077:

    # MYU "Hooray! Myu did a good!"
    MYU "Eba! A Myu fez uma boa!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1636
translate ptPT qst_JudgementDay_RescueMages_Prep_42980294:

    # SOPHIRA "A-Ahh... Yes, you did."
    SOPHIRA "A-Ahh... Sim, você fez."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1639
translate ptPT qst_JudgementDay_RescueMages_Prep_90da61ed:

    # ERIKA "We need to go."
    ERIKA "Precisamos ir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1640
translate ptPT qst_JudgementDay_RescueMages_Prep_98331877:

    # ERIKA "We've wasted enough time."
    ERIKA "Já perdemos tempo suficiente."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1641
translate ptPT qst_JudgementDay_RescueMages_Prep_8f616c48:

    # SOPHIRA "Wait! Before you leave..."
    SOPHIRA "Espere! Antes de você sair..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1642
translate ptPT qst_JudgementDay_RescueMages_Prep_5139d402:

    # SOPHIRA "Let one of the mages tend to your wounds. It's the least we can do."
    SOPHIRA "Deixe que um dos magos cuide de seus ferimentos. É o mínimo que podemos fazer."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1646
translate ptPT qst_JudgementDay_RescueMages_Prep_b9f6f48a:

    # "...After being healed by one of the mages, we made our way out."
    "...Depois de ser curado por um dos magos, saímos de lá."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1650
translate ptPT qst_JudgementDay_RescueMages_Unprep_9e4944f2:

    # ERIKA "Fine, but we must hurry!"
    ERIKA "Tudo bem, mas precisamos nos apressar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1658
translate ptPT qst_JudgementDay_RescueMages_Unprep_46309dca:

    # "We scoured the district, but neither I nor Markus could pick up their scent through the thick smoke."
    "Vasculhamos o distrito, mas nem eu nem Markus conseguimos sentir o cheiro deles através da fumaça densa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1659
translate ptPT qst_JudgementDay_RescueMages_Unprep_838c0731:

    # "Suddenly, a sharp cry echoed through the air."
    "De repente, um grito agudo ecoou pelo ar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1661
translate ptPT qst_JudgementDay_RescueMages_Unprep_65fb0b3b:

    # MC "This way!"
    MC "Por aqui!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1662
translate ptPT qst_JudgementDay_RescueMages_Unprep_d983de2b:

    # "We followed the sound, hurrying through the burning streets to find the entrance of a noble's manor."
    "Seguimos o som, correndo pelas ruas em chamas até encontrar a entrada da mansão de um nobre."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1663
translate ptPT qst_JudgementDay_RescueMages_Unprep_e92cf3e1:

    # "From inside, I could hear muffled cries of pain."
    "De dentro, eu podia ouvir gritos abafados de dor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1665
translate ptPT qst_JudgementDay_RescueMages_Unprep_f2d64bb0:

    # "Slamming my fist against it I called out to only be met with silence as my answer."
    "Bati meu punho contra ela e gritei, apenas para ser recebido pelo silêncio como resposta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1667
translate ptPT qst_JudgementDay_RescueMages_Unprep_f5320ddb:

    # "Gripping at the door with my tentacles, I tore the thing open with ease and stepped inside."
    "Agarrando a porta com meus tentáculos, rasguei a coisa com facilidade e entrei."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1671
translate ptPT qst_JudgementDay_RescueMages_Unprep_b6d10b53:

    # "The walls were laced in blood, bodies torn to shreds littered the place."
    "As paredes estavam manchadas de sangue, corpos dilacerados cobriam o lugar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1672
translate ptPT qst_JudgementDay_RescueMages_Unprep_8caf742f:

    # "Here and there, a bit of bloodied blue flesh and skin as the sickly smell of blood and death filled the air."
    "Aqui e ali, um pouco de carne e pele azul ensanguentadas enquanto o cheiro doentio de sangue e morte preenchia o ar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1673
translate ptPT qst_JudgementDay_RescueMages_Unprep_46abadc0:

    # "It appears the mansion had been used as some kind of makeshift hospital."
    "Parece que a mansão havia sido usada como uma espécie de hospital improvisado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1674
translate ptPT qst_JudgementDay_RescueMages_Unprep_d5c2bc59:

    # "Or at least, it {i}was{/i} before something got in."
    "Ou pelo menos, {i}era{/i} antes que algo entrasse."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1677
translate ptPT qst_JudgementDay_RescueMages_Unprep_812649d0:

    # "Erika turned a shade of white as she struggled not to throw up."
    "Erika ficou pálida enquanto lutava para não vomitar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1678
translate ptPT qst_JudgementDay_RescueMages_Unprep_d43eae69:

    # ERIKA "Gods... What happened in here?"
    ERIKA "Deuses... O que aconteceu aqui?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1680
translate ptPT qst_JudgementDay_RescueMages_Unprep_17e1d435:

    # MARKUS "It doesn't look like they managed to put up much of a fight..."
    MARKUS "Não parece que conseguiram oferecer muita resistência..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1681
translate ptPT qst_JudgementDay_RescueMages_Unprep_9cbf423d:

    # "A snapping sound echoed through the halls, followed by another ghastly scream."
    "Um som de estalo ecoou pelos corredores, seguido por outro grito medonho."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1685
translate ptPT qst_JudgementDay_RescueMages_Unprep_18f10e05:

    # UNKNOWN "AHHHHHHHH!"
    UNKNOWN "AHHHHHHHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1686
translate ptPT qst_JudgementDay_RescueMages_Unprep_65fb0b3b_1:

    # MC "This way!"
    MC "Por aqui!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1689
translate ptPT qst_JudgementDay_RescueMages_Unprep_9893b43a:

    # "Chasing the screams led us down a hallway towards a strange entranceway leading underground."
    "Seguir os gritos nos levou por um corredor até uma entrada estranha que levava ao subsolo."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1690
translate ptPT qst_JudgementDay_RescueMages_Unprep_3e65ada3:

    # "With shattered chains around the entranceway, {i}something{/i} must have broken out."
    "Com correntes quebradas ao redor da entrada, {i}algo{/i} deve ter escapado."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1691
translate ptPT qst_JudgementDay_RescueMages_Unprep_3cc2ee74:

    # "A bone-chilling crunching sound was heard as we descended the stairs into that deep and terrible darkness."
    "Um som de trituração de arrepiar os ossos foi ouvido enquanto descíamos as escadas naquela escuridão profunda e terrível."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1694
translate ptPT qst_JudgementDay_RescueMages_Unprep_fd50f717:

    # "There... waving a torch around the flooded basement, the water up to our ankles, we looked around for the source of the sound."
    "Lá... agitando uma tocha pelo porão inundado, a água até os tornozelos, procuramos a fonte do som."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1695
translate ptPT qst_JudgementDay_RescueMages_Unprep_b164bb17:

    # "Slowly moving the light from left to right across the debris, there...{i}we saw it.{/i}"
    "Movendo lentamente a luz da esquerda para a direita pelos escombros, lá...{i}nós o vimos.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1697
translate ptPT qst_JudgementDay_RescueMages_Unprep_cdd450ae:

    # "A snake like creature with a humanoid like body, sinking it's teeth once more into the woman in a blue dress."
    "Uma criatura semelhante a uma cobra com um corpo humanóide, afundando seus dentes mais uma vez na mulher de vestido azul."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1698
translate ptPT qst_JudgementDay_RescueMages_Unprep_2d53ad4b:

    # "She let out one last raspy cry of pain as the thing chewed on her, the deep red sinking through and overpowering the blue."
    "Ela soltou um último grito rouco de dor enquanto a coisa a mastigava, o vermelho profundo infiltrando-se e dominando o azul."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1699
translate ptPT qst_JudgementDay_RescueMages_Unprep_ae6c5a83:

    # "Pale white, she seemed completely drained of all life as the eyes of her ghastly, skeleton white face rolled up."
    "Pálida como um cadáver, ela parecia completamente drenada de toda a vida enquanto os olhos de seu rosto espectral e esquelético se reviravam."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1700
translate ptPT qst_JudgementDay_RescueMages_Unprep_18470e76:

    # "The creature snarled, tosing her now lifeless body aside, letting it slam against one of the walls as we heard the bones break."
    "A criatura rosnou, jogando seu corpo agora sem vida de lado, deixando-o bater contra uma das paredes enquanto ouvíamos os ossos se quebrarem."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1703
translate ptPT qst_JudgementDay_RescueMages_Unprep_1a712d20:

    # "It licked at it's bloody fangs before lunging towards us!"
    "Lambeu suas presas ensanguentadas antes de se lançar em nossa direção!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1713
translate ptPT qst_JudgementDay_RescueMages_Unprep_96fa915c:

    # "Slicing my claws across the creature's throat, the snakeman waved back and force, reaching at it's gaping wound where it's throat once was."
    "Cortando minhas garras pela garganta da criatura, o homem-cobra se debateu, alcançando sua ferida aberta onde antes estava sua garganta."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1714
translate ptPT qst_JudgementDay_RescueMages_Unprep_1027db08:

    # "After letting out a desperate, raspy cry, it collapsed face first into the water, twitching for a few moments before falling completely still."
    "Após soltar um grito desesperado e rouco, caiu de cara na água, tremendo por alguns momentos antes de ficar completamente imóvel."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1715
translate ptPT qst_JudgementDay_RescueMages_Unprep_0374e7bc:

    # MC "What in the hells is this thing?"
    MC "O que diabos é essa coisa?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1716
translate ptPT qst_JudgementDay_RescueMages_Unprep_4b2c1c99:

    # MC "Some kind of... dark magecraft abomination?"
    MC "Algum tipo de... abominação de magia negra?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1718
translate ptPT qst_JudgementDay_RescueMages_Unprep_79c627e2:

    # ERIKA "I... I've never seen anything like it before."
    ERIKA "Eu... eu nunca vi nada assim antes."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1719
translate ptPT qst_JudgementDay_RescueMages_Unprep_591afddc:

    # ERIKA "It appears to be... {i}part human?{/i}"
    ERIKA "Parece ser... {i}parte humano?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1721
translate ptPT qst_JudgementDay_RescueMages_Unprep_ec77576a:

    # MARKUS "We should leave this place, whatever this {i}thing{/i} is, the inquisitors and whoever can look at the damn thing when we're done."
    MARKUS "Devemos sair deste lugar, seja lá o que essa {i}coisa{/i} for, os inquisidores e quem quer que seja podem dar uma olhada nessa droga quando terminarmos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1723
translate ptPT qst_JudgementDay_RescueMages_Unprep_38177186:

    # "I nodded in agreement as we made our way back up through the mansion estate."
    "Assenti em concordância enquanto voltávamos pela propriedade da mansão."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1725
translate ptPT qst_JudgementDay_RescueMages_Unprep_8bfc939c:

    # "I took one last look at the dead bodies littered around... Perhaps..."
    "Dei uma última olhada nos corpos espalhados ao redor... Talvez..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1727
translate ptPT qst_JudgementDay_RescueMages_Unprep_6725b4fe:

    # "{i}Perhaps if things were different, I could have saved them.{/i}"
    "{i}Talvez se as coisas fossem diferentes, eu poderia tê-los salvado.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1729
translate ptPT qst_JudgementDay_RescueMages_Unprep_bb0c8ed4:

    # ERIKA "[player_name!t], let's go."
    ERIKA "[player_name!t], vamos."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1738
translate ptPT qst_JudgementDay_RescueMages_MoveOn_e1032b47:

    # "Navigating through the chaotic streets, Erika guided us through a series of alleyways and back routes."
    "Navegando pelas ruas caóticas, Erika nos guiou por uma série de becos e rotas alternativas."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1739
translate ptPT qst_JudgementDay_RescueMages_MoveOn_ff091e7a:

    # "Finally, pushing through to the main street, we hurried toward our destination."
    "Finalmente, abrindo caminho até a rua principal, corremos em direção ao nosso destino."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1740
translate ptPT qst_JudgementDay_RescueMages_MoveOn_f2ac90ca:

    # ERIKA "We must move quickly before—"
    ERIKA "Precisamos nos mover rapidamente antes que—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1742
translate ptPT qst_JudgementDay_RescueMages_MoveOn_58420e88:

    # "There, amidst a heap of mangled corpses, sat the gleaming, towering figure of the Silver Knight."
    "Lá, em meio a uma pilha de cadáveres mutilados, estava a figura reluzente e imponente do Cavaleiro de Prata."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1743
translate ptPT qst_JudgementDay_RescueMages_MoveOn_1df97ea7:

    # "His cape fluttered in the wind as the city burned around him, his presence eerily still in the midst of carnage."
    "Sua capa esvoaçava ao vento enquanto a cidade ardia ao seu redor, sua presença estranhamente imóvel em meio à carnificina."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1744
translate ptPT qst_JudgementDay_RescueMages_MoveOn_042dbc76:

    # "Despite the splattering of blood across his armor, his silver plating still shined brilliantly through the filth."
    "Apesar das manchas de sangue em sua armadura, seu revestimento prateado ainda brilhava intensamente através da sujeira."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1749
translate ptPT qst_JudgementDay_RescueMages_MoveOn_78e5318e:

    # SILVER_KNIGHT "..."
    SILVER_KNIGHT "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1751
translate ptPT qst_JudgementDay_RescueMages_MoveOn_e51a3c47:

    # "Slowly, he tilted his head up, locking his piercing gaze onto us."
    "Lentamente, ele ergueu a cabeça, fixando seu olhar penetrante em nós."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1753
translate ptPT qst_JudgementDay_RescueMages_MoveOn_31385b2d:

    # "His grip on his massive sword tightened as he rose to his feet, advancing in our direction."
    "Seu aperto na espada maciça se intensificou enquanto ele se levantava, avançando em nossa direção."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1754
translate ptPT qst_JudgementDay_RescueMages_MoveOn_a455176a:

    # MARKUS "F-Fuck! It's him! It's the Silver Knight himself!"
    MARKUS "M-Merda! É ele! É o próprio Cavaleiro de Prata!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1755
translate ptPT qst_JudgementDay_RescueMages_MoveOn_0aea49c7:

    # "The Silver Knight... A warrior of legend, chosen to serve and die for the royal family of Alderay."
    "O Cavaleiro de Prata... Um guerreiro lendário, escolhido para servir e morrer pela família real de Alderay."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1756
translate ptPT qst_JudgementDay_RescueMages_MoveOn_3702506d:

    # "Possessing unmatched skill in both blade and magecraft, it was said that he was perhaps the only man who could have challenged Newheart and won."
    "Possuindo habilidade incomparável tanto na espada quanto na magia, dizia-se que ele era talvez o único homem que poderia ter desafiado Newheart e vencido."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1757
translate ptPT qst_JudgementDay_RescueMages_MoveOn_485f73a4:

    # "...And now, he was coming straight for us."
    "...E agora, ele vinha direto para nós."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1758
translate ptPT qst_JudgementDay_RescueMages_MoveOn_ad3944f0:

    # ERIKA "Hold, Sir Knight! HOLD!"
    ERIKA "Pare, Sir Cavaleiro! PARE!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1760
translate ptPT qst_JudgementDay_RescueMages_MoveOn_7b45065b:

    # "The Silver Knight stopped in his tracks, eyes narrowing as he examined me and Markus."
    "O Cavaleiro de Prata parou em seu caminho, estreitando os olhos enquanto examinava a mim e a Markus."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1761
translate ptPT qst_JudgementDay_RescueMages_MoveOn_5fe8b642:

    # "His posture remained unreadable, but his grip on his weapon remained firm."
    "Sua postura permaneceu indecifrável, mas seu aperto na arma permaneceu firme."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1763
translate ptPT qst_JudgementDay_RescueMages_MoveOn_6ddf1665:

    # SILVER_KNIGHT "…What are they?"
    SILVER_KNIGHT "…O que são eles?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1764
translate ptPT qst_JudgementDay_RescueMages_MoveOn_8709d483:

    # ERIKA "As of now, these... creatures are under the order of the Inquisition."
    ERIKA "A partir de agora, essas... criaturas estão sob ordem da Inquisição."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1765
translate ptPT qst_JudgementDay_RescueMages_MoveOn_e74bc1de:

    # SILVER_KNIGHT "I do not concern myself with the affairs of the Inquisition."
    SILVER_KNIGHT "Não me preocupo com os assuntos da Inquisição."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1766
translate ptPT qst_JudgementDay_RescueMages_MoveOn_ff96d9a5:

    # SILVER_KNIGHT "Only that the royal family remains safe."
    SILVER_KNIGHT "Apenas que a família real permaneça segura."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1767
