# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:3
translate ptPT qst_bloodhound_2_lake_27c44724:

    # "Stepping closer towards the water bank, I glanced down at my reflection flickering in the water for a moment."
    "Aproximando-me da margem, olhei para baixo para o meu reflexo tremeluzindo na água por um instante."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:4
translate ptPT qst_bloodhound_2_lake_6c633067:

    # "I noticed {i}something red and glimmering{/i} approaching almost hypnotically slow."
    "Percebi {i}algo vermelho e cintilante{/i} se aproximando de forma quase hipnoticamente lenta."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:5
translate ptPT qst_bloodhound_2_lake_0b4100ee:

    # "I felt every hair stand on my neck as I felt the sudden urge to leap back."
    "Senti cada fio de cabelo do meu pescoço se arrepiar enquanto sentia um impulso súbito de recuar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:6
translate ptPT qst_bloodhound_2_lake_8258d701:

    # "As I did so, the thing emerged violently from the water, it's single red eye glaring towards me."
    "Ao fazer isso, a coisa emergiu violentamente da água, seu único olho vermelho fitando-me com fúria."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:11
translate ptPT qst_bloodhound_2_lake_6ce7cf8c:

    # "Bound inside its horrifying seal, the Guardians were half dissolved, most already dead, lifelessly floating in the acidic mass."
    "Presos dentro de seu selo horripilante, os Guardiões estavam meio dissolvidos, a maioria já morta, flutuando sem vida na massa ácida."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:13
translate ptPT qst_bloodhound_2_lake_b34c3a87:

    # "One though, a girl, all bones with her eyes peeled back as she cried did her best to stretch out a dissolved hand to me."
    "Uma, porém, uma garota, só ossos com os olhos revirados enquanto chorava, fez o possível para estender uma mão dissolvida para mim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:14
translate ptPT qst_bloodhound_2_lake_2beac591:

    # "Screaming inside her silent prison, the slime forced its way down her throat and she trembled as her eyes rolled white."
    "Gritando dentro de sua prisão silenciosa, o lodo forçou passagem pela garganta dela e ela tremeu enquanto seus olhos ficaram brancos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:15
translate ptPT qst_bloodhound_2_lake_a94588ca:

    # "Then, she was as lifeless as all the others."
    "Então, ela ficou tão sem vida quanto todos os outros."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:17
translate ptPT qst_bloodhound_2_lake_37f5d75c:

    # "With little time to waste, I tore away at my flesh and stared down the horrific monstrosity before me."
    "Com pouco tempo a perder, arranquei minha própria carne e encarei a monstruosidade horripilante diante de mim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:31
translate ptPT qst_bloodhound_2_lake_3a2cf159:

    # "Dissolving into the ground and sizziling, the growling monstrosity's cries began to die down into a distorted murmur till it lay silent."
    "Dissolvendo-se no chão e chiando, os gritos da monstruosidade rosnante começaram a diminuir para um murmúrio distorcido até ficar em silêncio."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:39
translate ptPT qst_bloodhound_2_lake_postbattle_04ed3727:

    # MC @ talk "{i}*Huff... Huff*{/i}"
    MC @ talk "{i}*Uff... Uff*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:41
translate ptPT qst_bloodhound_2_lake_postbattle_e0522a7a:

    # MC "(That was too close.)"
    MC "(Foi por muito pouco.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:42
translate ptPT qst_bloodhound_2_lake_postbattle_6e156aba:

    # "From behind, I could hear the sounds of painful grunts and scuffling."
    "Por trás, ouvi sons de grunhidos dolorosos e de luta."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:43
translate ptPT qst_bloodhound_2_lake_postbattle_1a0739a8:

    # "I turned quickly expecting some other horror from the lake ready to strike."
    "Virei-me rapidamente, esperando algum outro horror do lago pronto para atacar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:44
translate ptPT qst_bloodhound_2_lake_postbattle_a1ea6482:

    # "Instead, I saw a young knight clad in armour dragging his way across the grass away from me."
    "Em vez disso, vi um jovem cavaleiro vestido em armadura arrastando-se pela grama, afastando-se de mim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:45
translate ptPT qst_bloodhound_2_lake_postbattle_362573b6:

    # "His left leg missing as he dragged a trail of blood behind him, I approached him cautiously, reaching out towards him with my hand outstretched."
    "Com a perna esquerda faltando, enquanto arrastava um rastro de sangue atrás de si, aproximei-me cautelosamente, estendendo a mão em sua direção."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:46
translate ptPT qst_bloodhound_2_lake_postbattle_9b24d71e:

    # "The man turned weakly to swing his sword at me, but I managed to pull back in time and dodge it."
    "O homem virou-se fracamente para brandir a espada contra mim, mas consegui recuar a tempo e esquivar-me."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:52
translate ptPT qst_bloodhound_2_lake_postbattle_bad462e1:

    # "His face was ghosty white, his eyes wide in fear as he cried at me between his heavy, desperate breaths."
    "Seu rosto estava pálido como um fantasma, com os olhos arregalados de medo, enquanto gritava comigo entre suas respirações pesadas e desesperadas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:54
translate ptPT qst_bloodhound_2_lake_postbattle_c147c09c:

    # UNKNOWN "Back! BACK!"
    UNKNOWN "Para trás! PARA TRÁS!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:55
translate ptPT qst_bloodhound_2_lake_postbattle_811721cd:

    # MC "Hold! I am not here to hurt you!"
    MC "Alto! Não estou aqui para te machucar!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:56
translate ptPT qst_bloodhound_2_lake_postbattle_1d8f5d96:

    # UNKNOWN "You... You speak, {i}beast?{/i}"
    UNKNOWN "Você... Você fala, {i}besta?{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:57
translate ptPT qst_bloodhound_2_lake_postbattle_507e8001:

    # MC "I'm here for the guardians."
    MC "Estou aqui pelos guardiões."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:58
translate ptPT qst_bloodhound_2_lake_postbattle_b72ffe15:

    # "The man began to laugh, and then cry as tears streamed down his eyes."
    "O homem começou a rir, e depois chorar enquanto lágrimas escorriam de seus olhos."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:59
translate ptPT qst_bloodhound_2_lake_postbattle_538d0203:

    # UNKNOWN "Hahahaha!"
    UNKNOWN "Hahahaha!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:60
translate ptPT qst_bloodhound_2_lake_postbattle_c4d9c865:

    # UNKNOWN "You've found them!"
    UNKNOWN "Você os encontrou!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:61
translate ptPT qst_bloodhound_2_lake_postbattle_68d2559e:

    # UNKNOWN "At least {i}*cough*{/i} the bits and pieces left of us."
    UNKNOWN "Pelo menos {i}*tosse*{/i} os pedaços e restos que sobraram de nós."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:62
translate ptPT qst_bloodhound_2_lake_postbattle_a54a637c:

    # MC "You're bleeding out, if we don't get the wound treated and sealed soon you'll die."
    MC "Você está sangrando, se não tratarmos e selarmos o ferimento logo, você vai morrer."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:63
translate ptPT qst_bloodhound_2_lake_postbattle_3e8bf0ee:

    # UNKNOWN "{i}*Cough!*{/i} It's hopeless... I'm finished."
    UNKNOWN "{i}*Tosse!*{/i} É inútil... Estou acabado."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:64
translate ptPT qst_bloodhound_2_lake_postbattle_86322c55:

    # MC "Who are you?"
    MC "Quem é você?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:65
translate ptPT qst_bloodhound_2_lake_postbattle_0f09202a:

    # UNKNOWN "Dravenham... At your service... What's left of it."
    UNKNOWN "Dravenham... Ao seu dispor... O que resta de mim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:67
translate ptPT qst_bloodhound_2_lake_postbattle_7f2bdaab:

    # DRAVENHAM "They sent {i}you{/i} to rescue us?"
    DRAVENHAM "Eles enviaram {i}você{/i} para nos resgatar?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:68
translate ptPT qst_bloodhound_2_lake_postbattle_bacefd2e:

    # DRAVENHAM "I've never seen a beast like you before."
    DRAVENHAM "Nunca vi uma fera como você antes."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:69
translate ptPT qst_bloodhound_2_lake_postbattle_291e3248:

    # MC "I'm afraid there's no rescue party."
    MC "Receio que não haja nenhum grupo de resgate."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:70
translate ptPT qst_bloodhound_2_lake_postbattle_7c3c7716:

    # MC "I came looking for information on a missing person."
    MC "Vim buscar informações sobre uma pessoa desaparecida."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:71
translate ptPT qst_bloodhound_2_lake_postbattle_073fa195:

    # DRAVENHAM "What?! Are you fucki- *cough*"
    DRAVENHAM "O quê?! Você tá de brincadei- *tosse*"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:72
translate ptPT qst_bloodhound_2_lake_postbattle_e8e7195c:

    # MC "No one knows how dire your adventure ended up."
    MC "Ninguém sabe o quão terrível sua aventura terminou."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:73
translate ptPT qst_bloodhound_2_lake_postbattle_8595b89d:

    # "The man began to sob once again, barely managing to hold himself together."
    "O homem começou a soluçar mais uma vez, mal conseguindo se recompor."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:74
translate ptPT qst_bloodhound_2_lake_postbattle_15ba15f6:

    # DRAVENHAM "Elsa... Roca... Twhain... I failed them..."
    DRAVENHAM "Elsa... Roca... Twhain... Eu falhei com eles..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:75
translate ptPT qst_bloodhound_2_lake_postbattle_a8eea1de:

    # MC "Dravenham, I know you are in pain but I fear our time together is short, I can hear your heartbeat slow down."
    MC "Dravenham, sei que está sofrendo, mas temo que nosso tempo juntos seja curto, posso ouvir seu batimento cardíaco diminuir."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:76
translate ptPT qst_bloodhound_2_lake_postbattle_c448d59c:

    # DRAVENHAM "Then ask, {i}beast{/i}... Ask whatever it is you have to."
    DRAVENHAM "Então pergunte, {i}fera{/i}... Pergunte o que quiser."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:81
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_5305a2f1:

    # DRAVENHAM "None... The thing only kept me alive to let its young feed on me."
    DRAVENHAM "Nada... A coisa só me manteve viva para que seus filhotes se alimentassem de mim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:82
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_a48cb7f1:

    # DRAVENHAM "{i}*Huff*{/i} It wouldn't let me leave... It wouldn't let me fucking leave!"
    DRAVENHAM "{i}*Huff*{/i} Não me deixava sair... Não me deixava sair, porra!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:83
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_6fb79e61:

    # MC "Stay with me Dravenham."
    MC "Fique comigo, Dravenham."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:84
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_9b9da1a5:

    # DRAVENHAM "Please... Everything is so numb now."
    DRAVENHAM "Por favor... Tudo está tão dormente agora."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:88
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_1c097716:

    # DRAVENHAM "We weren't just here for the quest..."
    DRAVENHAM "Nós não estávamos aqui apenas pela missão..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:89
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_1c698585:

    # DRAVENHAM "A servant of some minor nobles offered to pay us triple if we could capture a baby slimelark and bring it back."
    DRAVENHAM "Um servo de alguns nobres menores nos ofereceu pagar o triplo se pudéssemos capturar um filhote de slimelark e trazê-lo de volta."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:90
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_d69f71d0:

    # MC "But why?"
    MC "Mas por quê?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:91
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_ee00bc87:

    # DRAVENHAM "The young... Slimelarks can take many forms, including beautiful women, if trained."
    DRAVENHAM "Os filhotes... Slimelarks podem assumir muitas formas, incluindo belas mulheres, se treinados."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:92
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_17540028:

    # DRAVENHAM "The fucking perverts wanted to keep a few as their own private slaves."
    DRAVENHAM "Os malditos pervertidos queriam manter alguns como seus próprios escravos particulares."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:93
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_b6fbbabd:

    # MC "Who?"
    MC "Quem?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:94
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_cb60938e:

    # DRAVENHAM "Don't know... The servant only told us he was acting as a intermediary."
    DRAVENHAM "Não sei... O servo só nos disse que ele estava agindo como intermediário."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:95
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_28c2a94f:

    # DRAVENHAM "None of them care about us, we're all just expendable to them."
    DRAVENHAM "Nenhum deles se importa conosco, somos todos apenas descartáveis para eles."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:96
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_272db056:

    # DRAVENHAM "Urghh... I feel so dizzy..."
    DRAVENHAM "Urghh... Estou tão tonto..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:97
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_e9b9815c:

    # MC "Focus! Just a little more!"
    MC "Concentre-se! Só mais um pouco!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:103
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_dbbff41e:

    # DRAVENHAM "Azul? Yes... I know of him."
    DRAVENHAM "Azul? Sim... eu sei quem é."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:104
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_def48cf3:

    # DRAVENHAM "He would offer us advice on our quests..."
    DRAVENHAM "Ele nos oferecia conselhos em nossas missões..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:105
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_046e0255:

    # DRAVENHAM "For coin."
    DRAVENHAM "Por moedas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:106
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_eb43210d:

    # DRAVENHAM "Something hap-*cough* happened?"
    DRAVENHAM "Algo acon-*tosse* aconteceu?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:107
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_90a466a3:

    # MC "He's gone missing."
    MC "Ele desapareceu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:108
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_c1daa0a7:

    # MC "What did he talk to you about the last time you saw him?"
    MC "Sobre o que ele falou com você da última vez que o viu?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:109
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_f051d7a2:

    # DRAVENHAM "Missing? Crap..."
    DRAVENHAM "Desapareceu? Droga..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:110
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_c0de04b1:

    # DRAVENHAM "He was afraid of something."
    DRAVENHAM "Ele estava com medo de algo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:111
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_652cae32:

    # DRAVENHAM "He said he had information that could end up in..."
    DRAVENHAM "Ele disse que tinha informações que poderiam acabar em..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:112
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_85baa545:

    # "Dravenham mustered himself, grasping for life slipping away."
    "Dravenham se recompôs, agarrando-se à vida que se esvaía."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:113
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_0d88fc3a:

    # DRAVENHAM "...In the wrong hands."
    DRAVENHAM "...Nas mãos erradas."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:114
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_91226212:

    # DRAVENHAM "\"Send the whole guild into chaos\" he said..."
    DRAVENHAM "\"Lançar toda a guilda no caos\" ele disse..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:115
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_10740462:

    # DRAVENHAM "He then asked if he could hire us for protection, but by then, we'd already taken on... this."
    DRAVENHAM "Ele então perguntou se poderia nos contratar para proteção, mas a essa altura já havíamos aceitado... isso."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:116
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_0e6917de:

    # DRAVENHAM "We were going to help him afterwards..."
    DRAVENHAM "Nós o ajudaríamos depois..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:117
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_89117cef:

    # DRAVENHAM "Ha... I guess as you can see, that didn't work out."
    DRAVENHAM "Ha... Acho que, como você pode ver, não deu certo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:118
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_eb69671d:

    # MC "Where is he now?"
    MC "Onde ele está agora?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:119
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_1d788dbb:

    # DRAVENHAM "He gave... {i}Urghh...{/i} an address to a safehouse of his."
    DRAVENHAM "Ele deu... {i}Urghh...{/i} um endereço de um esconderijo dele."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:120
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_a77bf48e:

    # DRAVENHAM "Told us it was too dangerous for him to be out in public anymore."
    DRAVENHAM "Disse-nos que era muito perigoso para ele continuar a aparecer em público."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:121
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_9bae290d:

    # DRAVENHAM "That {i}some people were after him{/i}."
    DRAVENHAM "Que {i}algumas pessoas estavam atrás dele{/i}."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:122
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_f941d70a:

    # "Hand slid into his breastplate, Dravenham pulled out a bloodied note with something scrawled on it and handed it to me."
    "A mão deslizou para dentro da couraça, Dravenham tirou um bilhete ensanguentado com algo rabiscado e entregou-mo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.5.rpy:123
translate ptPT qst_bloodhound_2_lake_postbattle_dravenham_1e5ea53c:

