translate ptPT qst_bloodhound_2_camp_menu_b8f7998f:

    # MC "(It's been snapped right in two.)"
    MC "(Foi partido bem ao meio.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:15
translate ptPT qst_bloodhound_2_camp_menu_8f187d87:

    # MC "(Hm? Why's this box been chained up?)"
    MC "(Hm? Por que esta caixa está acorrentada?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:16
translate ptPT qst_bloodhound_2_camp_menu_e0a8dfaa:

    # MC "(I could try tear it open... But I might damage whatever is inside.)"
    MC "(Eu poderia tentar rasgá-la... Mas posso danificar o que estiver dentro.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:17
translate ptPT qst_bloodhound_2_camp_menu_27834b37:

    # MC "(Maybe I should try and find a key first?)"
    MC "(Talvez eu devesse tentar encontrar uma chave primeiro?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:21
translate ptPT qst_bloodhound_2_camp_menu_c356aa46:

    # MC "(Let's try open this...)"
    MC "(Vamos tentar abrir isto...)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:24
translate ptPT qst_bloodhound_2_camp_menu_5ce602f5:

    # MC "(This looks like a guild party sigil... It must be them!)"
    MC "(Isto parece um sigilo de grupo de guilda... Deve ser eles!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:25
translate ptPT qst_bloodhound_2_camp_menu_8de7d72a:

    # MC "(But... Where are they? There's nobody in sight.)"
    MC "(Mas... Onde eles estão? Não há ninguém à vista.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:29
translate ptPT qst_bloodhound_2_camp_menu_cd3844b9:

    # MC "(An extinguished fire pit... Been dead for a while now.)"
    MC "(Uma fogueira apagada... Já está morta há um tempo.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:30
translate ptPT qst_bloodhound_2_camp_menu_07b572b5:

    # MC "(...Wait, there's something there in the pit!)"
    MC "(...Espere, há algo ali na fogueira!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:31
translate ptPT qst_bloodhound_2_camp_menu_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:32
translate ptPT qst_bloodhound_2_camp_menu_43190bbe:

    # MC "(A letter?)"
    MC "(Uma carta?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:33
translate ptPT qst_bloodhound_2_camp_menu_1031de16:

    # "{i}We've captured a baby slimelark as per the clients request, but the big one is getting more and more agitated.{/i}"
    "{i}Nós capturamos um filhote de slimelark conforme o pedido do cliente, mas o grande está ficando cada vez mais agitado.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:34
translate ptPT qst_bloodhound_2_camp_menu_4d7ce016:

    # "{i}...Managed to hold it at bay for now, but-{/i}"
    "{i}...Conseguimos mantê-lo à distância por enquanto, mas-{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:35
translate ptPT qst_bloodhound_2_camp_menu_dac4dbf1:

    # MC "(The rest of it is burned beyond readability.)"
    MC "(O resto está queimado demais para ser lido.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:36
translate ptPT qst_bloodhound_2_camp_menu_6bf2865f:

    # MC "(I best stay away from the bank... For now at least.)"
    MC "(É melhor eu ficar longe do banco... Pelo menos por enquanto.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:40
translate ptPT qst_bloodhound_2_camp_menu_c9614dee:

    # MC "(Let's move on.)"
    MC "(Vamos seguir em frente.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:49
translate ptPT qst_bloodhound_2_lake_openbox_9d3fcc85:

    # "As the lock dropped off the from the box, I opened it up to peer inside."
    "Assim que a fechadura caiu da caixa, eu a abri para espiar lá dentro."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:50
translate ptPT qst_bloodhound_2_lake_openbox_9ff2a2e4:

    # "Inside, a jar with an enchantment on it was filled with the slimelark-like substance."
    "Dentro, um frasco com um encantamento estava cheio com a substância parecida com slimelark."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:51
translate ptPT qst_bloodhound_2_lake_openbox_2302ca8f:

    # MC "(This is what they came for.)"
    MC "(Era para isso que eles vieram.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:52
translate ptPT qst_bloodhound_2_lake_openbox_138ba29f:

    # MC "(A baby slimelark.)"
    MC "(Um bebê slimelark.)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:53
translate ptPT qst_bloodhound_2_lake_openbox_a497c3f3:

    # MC "(Well, what should I do with it?)"
    MC "(Bem, o que devo fazer com ele?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:56
translate ptPT qst_bloodhound_2_lake_openbox_b4080175:

    # "While what happened here was no doubt horrific, something about punishing the youngling felt wrong."
    "Embora o que aconteceu aqui fosse, sem dúvida, horrível, algo em punir o filhote pareceu errado."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:57
translate ptPT qst_bloodhound_2_lake_openbox_f3f2fecd:

    # "Even if it {i}was{/i} the offspring of a slimelark."
    "Mesmo que {i}fosse{/i} a cria de um slimelark."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:58
translate ptPT qst_bloodhound_2_lake_openbox_3fafabb6:

    # "With the jar in hand, I threw it straight into the lake, watching as it plumetted down with a splash."
    "Com o frasco na mão, joguei-o direto no lago, observando enquanto ele caía com um espirro d'água."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:61
translate ptPT qst_bloodhound_2_lake_openbox_407d78e6:

    # "Looking around at the horror inflicted by one of these beasts, I decided it was simply too much risk to keep it alive."
    "Olhando ao redor para o horror infligido por uma dessas feras, decidi que era simplesmente um risco muito grande mantê-lo vivo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:62
translate ptPT qst_bloodhound_2_lake_openbox_f8ceeff3:

    # "It was young now... But it would grow up."
    "Era jovem agora... Mas iria crescer."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:63
translate ptPT qst_bloodhound_2_lake_openbox_7f274017:

    # "Shattering the glass, the slimelark squealed in a death cry as I hacked away at the thing till it dissolved like its parent."
    "Ao estilhaçar o vidro, o slimelark guinchou em um grito de morte enquanto eu retalhava a coisa até que se dissolveu como seu progenitor."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:67
translate ptPT qst_bloodhound_2_lake_openbox_927f5c91:

    # "For some strange reason, I felt compelled to take the jar with me."
    "Por alguma razão estranha, senti-me compelido a levar o frasco comigo."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:68
translate ptPT qst_bloodhound_2_lake_openbox_1a2610a5:

    # "Oddly, as I held up the jar to inspect it more, the colour of the slime briefly turned pink."
    "Estranhamente, ao erguer o frasco para inspecioná-lo melhor, a cor da gosma ficou brevemente rosa."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:69
translate ptPT qst_bloodhound_2_lake_openbox_94e3d87f:

    # "I thought for a moment I could hear a soft cooing sound from inside the jar, but after a few seconds more of inspection, the thing was silent again."
    "Por um momento, pensei ouvir um som suave de arrulho vindo do interior do frasco, mas depois de mais alguns segundos de inspeção, a coisa ficou em silêncio novamente."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:71
translate ptPT qst_bloodhound_2_lake_openbox_156904e7:

    # MC "(I hope I don't end up regretting this.)"
    MC "(Espero não acabar me arrependendo disso.)"

