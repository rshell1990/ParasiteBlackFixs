    # NYX @ talk "So... Can I count on you with this?"
    NYX @ talk "Então... Posso contar com você para isso?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:114
translate ptPT qst_DarkKnight_1_atCaptainNyxOffice_menu_b0f2fa21:

