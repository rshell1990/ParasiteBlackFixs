translate ptPT qst_DarkKnight_1_atCaptainNyxOffice_menu_c94421e2:

    # NYX @ talk "Not to mention the fact they've actively started laying traps for us now."
    NYX @ talk "Sem falar no fato de que eles começaram ativamente a preparar armadilhas para nós."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:86
translate ptPT qst_DarkKnight_1_atCaptainNyxOffice_menu_c8d8ea69:

    # MC @ talk "Laying traps?"
    MC @ talk "Preparando armadilhas?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:87
translate ptPT qst_DarkKnight_1_atCaptainNyxOffice_menu_77df70a0:

    # NYX @ talk "Yep, baiting us into tight alleyways or feeding us false information."
    NYX @ talk "Sim, nos atraindo para becos apertados ou nos passando informações falsas."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:88
translate ptPT qst_DarkKnight_1_atCaptainNyxOffice_menu_52f4e6ce:

    # NYX @ angry "They've managed to ambush and take out a few of us like that, sneaky bastards, the lot of them."
    NYX @ angry "Eles conseguiram nos emboscar e eliminar alguns de nós assim, uns bastardos sorrateiros, todos eles."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:89
translate ptPT qst_DarkKnight_1_atCaptainNyxOffice_menu_9267291e:

    # NYX @ talk "Something drastic needs to be done, something that will bring them back into line."
    NYX @ talk "Algo drástico precisa ser feito, algo que os traga de volta à linha."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:94
