# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:59
translate ptPT qst_DarkKnight_1_GoToCaptainNyxOffice_02682086:

    # NYX @ talk "Your services are called upon to serve the Kingdom once again."
    NYX @ talk "Seus serviços são convocados para servir o Reino mais uma vez."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:60
translate ptPT qst_DarkKnight_1_GoToCaptainNyxOffice_d9e10f0a:

    # NYX @ talk "I don't know how aware you are with how 'fragile' things can be in this city, but suffice to say, I'm in need of a sellsword like yourself."
    NYX @ talk "Não sei o quanto você está ciente de como as coisas podem ser 'frágeis' nesta cidade, mas basta dizer que preciso de um mercenário como você."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:61
translate ptPT qst_DarkKnight_1_GoToCaptainNyxOffice_6f18111b:

    # NYX @ talk "You'll be well compensated for your services."
    NYX @ talk "Você receberá uma boa compensação por seus serviços."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:62
translate ptPT qst_DarkKnight_1_GoToCaptainNyxOffice_4b2d3807:

    # MC @ talk "Depends on the job."
    MC @ talk "Depende do trabalho."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:63
translate ptPT qst_DarkKnight_1_GoToCaptainNyxOffice_d2a7d24e:

    # NYX @ talk "These last few months, we've seen an explosion in banditry around the city."
    NYX @ talk "Nos últimos meses, vimos uma explosão de banditismo ao redor da cidade."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:64
translate ptPT qst_DarkKnight_1_GoToCaptainNyxOffice_b450829f:

    # NYX @ talk "It seems some of the smaller crime factions inside the city have splintered, and the ensuing chaos is spilling out onto the street."
    NYX @ talk "Parece que algumas das facções criminosas menores dentro da cidade se fragmentaram, e o caos resultante está se espalhando pelas ruas."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:65
translate ptPT qst_DarkKnight_1_GoToCaptainNyxOffice_87b2aadb:

    # NYX @ angry "Soon the fuckers will be trying to rob people in bloody daylight if we don't stomp it out now."
    NYX @ angry "Logo os desgraçados vão tentar roubar as pessoas em plena luz do dia se não acabarmos com isso agora."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:66
translate ptPT qst_DarkKnight_1_GoToCaptainNyxOffice_5090010f:

