translate ptPT qst_TwoEmperors_0_fa4e7f02:

    # MC @ talk "Company? No, I-"
    MC @ talk "Visitas? Não, eu-"

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:11
translate ptPT qst_TwoEmperors_0_40a8fd8c:

    # LUKKAN "Open up! By order of Emperor Alcott!"
    LUKKAN "Abram! Por ordem do Imperador Alcott!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_0.rpy:13
