translate ptPT qst_TheBeastOfNovaras_SpecialFightBloodworks_84ec40fb:

    # "Clanging his blades together, he charged for the door, roaring loud enough to rattle the walls."
    "Batendo suas lâminas uma contra a outra, ele avançou em direção à porta, rugindo alto o suficiente para fazer as paredes tremerem."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:600
translate ptPT qst_TheBeastOfNovaras_SpecialFightBloodworks_55ff3d01:

    # YARRICK "{i}*Sigh*{/i}"
    YARRICK "{i}*Suspiro*{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:601
translate ptPT qst_TheBeastOfNovaras_SpecialFightBloodworks_4cdd4d2f:

