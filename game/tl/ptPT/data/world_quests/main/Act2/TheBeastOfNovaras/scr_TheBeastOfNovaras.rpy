translate ptPT qst_TheBeastOfNovaras_SpecialFightBloodworks_a94355fb:

    # SAVAGE_KAIN "This is what a real killer looks like!"
    SAVAGE_KAIN "É assim que um verdadeiro assassino se parece!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:594
translate ptPT qst_TheBeastOfNovaras_SpecialFightBloodworks_cd9b2c3a:

    # SAVAGE_KAIN "I'M A FUCKING LEGEND BOYS!"
