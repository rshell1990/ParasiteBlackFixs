translate ptPT qst_ForgedInFire_TalkKiaraSuicidePill_b621a53b:

    # KIARA @ sad "You see, the Demorai will likely just kill men on sight."
    KIARA @ sad "Veja bem, os Demorai provavelmente matarão homens assim que os virem."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:248
translate ptPT qst_ForgedInFire_TalkKiaraSuicidePill_2ae75f60:

    # "There was a long pause before she spoke again."
    "Houve uma longa pausa antes que ela falasse novamente."

