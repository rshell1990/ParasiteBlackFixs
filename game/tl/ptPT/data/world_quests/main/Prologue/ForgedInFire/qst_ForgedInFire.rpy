# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:196
translate ptPT qst_ForgedInFire_YourBunk_0fa8e0c6:

    # MC "(I won't be allowed any pillow-time with the sun still up.)"
    MC "(Não vou ter permissão para dormir enquanto o sol ainda estiver alto.)"

