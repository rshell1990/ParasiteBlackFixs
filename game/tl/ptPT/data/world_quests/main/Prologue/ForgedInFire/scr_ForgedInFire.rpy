    "Duprey saltou da plataforma e se dirigiu a uma área do forte de onde vinha o som de espadas se chocando."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:163
translate ptPT qst_ForgedInFire_ReturnToYard_bb84b5e5:

    # DUPREY "On me!"
    DUPREY "Comigo!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:164
translate ptPT qst_ForgedInFire_ReturnToYard_e1fbe915:

