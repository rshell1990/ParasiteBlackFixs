    MARKUS "O quê? Vamos lááá, é só uma brincadeira, né, [player_name!t]?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:380
translate ptPT qst_Terminus_EnterPalace_7b6a0436:

    # ADARA @ angry "The royal family is our oldest and most respected institute!"
    ADARA @ angry "A família real é nossa instituição mais antiga e mais respeitada!"

