    # MC "Markus!"
    MC "Marcos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:8
translate ptPT qst_Terminus_intro_f3542d5e:

    # MC "Run! RUN!"
    MC "Corra! CORRA!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:9
translate ptPT qst_Terminus_intro_e144dd44:

    # "We sprinted down deeper into the darkness of the unknown, the sounds of metal clanking, beasts snarling, and cries of agony followed behind us."
    "Corremos mais fundo na escuridão do desconhecido, com os sons de metal retinindo, feras rosnando e gritos de agonia nos seguiam."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:11
translate ptPT qst_Terminus_intro_265a452b:

    # MARKUS "They’re gaining on us!"
    MARKUS "Estão nos alcançando!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:12
translate ptPT qst_Terminus_intro_bc178804:

    # MC "Keep running! Don’t stop!"
    MC "Continue correndo! Não pare!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:13
translate ptPT qst_Terminus_intro_891fbb8d:

    # MARKUS "But... {b}{i}the others!{/i}{/b}"
    MARKUS "Mas... {b}{i}os outros!{/i}{/b}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:14
translate ptPT qst_Terminus_intro_db8ca703:

    # MC "There’s nothing we can do! We have to get to—"
    MC "Não há nada que possamos fazer! Temos que chegar—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:17
translate ptPT qst_Terminus_intro_b6fac791:

    # "A Demorai claws its way through the catacomb wall, blocking their path. Standing in front of [player_name!t] and Markus, it snarls savagely."
    "Um Demorai arranha seu caminho pela parede da catacumba, bloqueando o caminho deles. Parado na frente de [player_name!t] e Markus, rosna selvagemente."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:18
translate ptPT qst_Terminus_intro_3f5de290:

    # MARKUS "L-Look at it!"
    MARKUS "O-Olhe para ele!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:19
translate ptPT qst_Terminus_intro_91c3f48f:

    # MC "Markus! Draw your sword, damn it!"
    MC "Markus! Saque sua espada, droga!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:20
translate ptPT qst_Terminus_intro_a1ddd20f:

    # "Unsheathing his blade with trembling hands, Markus fumbled and dropped it to the floor with a loud clank."
    "Desembainhando sua lâmina com mãos trêmulas, Markus atrapalhou-se e a deixou cair no chão com um alto estrondo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:21
translate ptPT qst_Terminus_intro_a8f4e15d:

    # MARKUS "Sh-Shit!"
    MARKUS "M-Merda!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:22
translate ptPT qst_Terminus_intro_aa4f252c:

    # MC "MARKUS!"
    MC "MARCO!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:23
translate ptPT qst_Terminus_intro_80342e3b:

    # "The beast charges at Markus, but is suddenly attacked by one of the soldiers fighting the demonic creatures throughout the caves."
    "A besta avança sobre Markus, mas é subitamente atacada por um dos soldados que lutam contra as criaturas demoníacas por toda a caverna."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:26
translate ptPT qst_Terminus_intro_207c971f:

    # SCOUT "Go! GO NOW!"
    SCOUT "Vá! VÁ AGORA!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:27
translate ptPT qst_Terminus_intro_9fcbf27a:

    # MC "Markus, quickly!"
    MC "Markus, rápido!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:28
translate ptPT qst_Terminus_intro_6f2ce96a:

    # MARKUS "Right!"
    MARKUS "Certo!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:29
translate ptPT qst_Terminus_intro_71f2a840:

    # "Darting around the battle, we managed to burst our way through into the Forbidden Chamber."
    "Esquivando-nos da luta, conseguimos irromper para dentro da Câmara Proibida."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:30
translate ptPT qst_Terminus_intro_f45bd3a6:

    # MC "Seal the door! SEAL THE FUCKING DOOR!"
    MC "Sele a porta! SELE A PORRA DA PORTA!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:31
translate ptPT qst_Terminus_intro_473f4bcc:

    # MARKUS "But he—"
    MARKUS "Mas ele—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:32
translate ptPT qst_Terminus_intro_b8303e9d:

    # MC "DO IT!"
    MC "FAÇA ISSO!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:34
translate ptPT qst_Terminus_intro_045294e7:

    # "As Markus moved to try and activate the seal by pulling the strange mechanical levers to our left, I looked up through the deep, seemingly endless darkness of the catacombs."
    "Enquanto Markus se movia para tentar ativar o selo puxando as estranhas alavancas mecânicas à nossa esquerda, eu olhei para cima através da escuridão profunda e aparentemente interminável das catacumbas."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:35
translate ptPT qst_Terminus_intro_ddae734c:

    # "I watched as the monstrosity before me took a hold of the Scout with both of its colossal, wretched, claw like hands and held the flailing man out."
    "Eu observei enquanto a monstruosidade diante de mim agarrava o Batedor com ambas as suas mãos colossais, abomináveis e em forma de garras, e estendia o homem que se debatia."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:36
translate ptPT qst_Terminus_intro_cc7a069b:

    # "His cloak flapped helplessly as he swung desperately at the beast, retching up blood, unable to break free from its deathly grip."
    "Sua capa sacudia desamparadamente enquanto ele golpeava a besta desesperadamente, vomitando sangue, incapaz de se libertar do seu aperto mortal."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:37
translate ptPT qst_Terminus_intro_fa086f51:

    # "The creature relished the moment, feverishly lapping up his blood, snarling in sick pleasure as the Scout croakily managed to cry out."
    "A criatura saboreou o momento, lambendo febrilmente seu sangue, rosnando com um prazer doentio enquanto o Batedor, com voz rouca, conseguia gritar."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:38
translate ptPT qst_Terminus_intro_7337b94e:

    # SCOUT "FUCK YOU!"
    SCOUT "VAI SE FODER!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:39
translate ptPT qst_Terminus_intro_bb463d92:

    # SCOUT "I HOPE YOU FUCKING CHO—"
    SCOUT "ESPERO QUE VOCÊ SE ENGASG—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:40
translate ptPT qst_Terminus_intro_b3d4450b:

    # "We watched in horror as the beast twisted the body of the man, his cries of pain contorting into an animal like squeal."
    "Nós observamos horrorizados enquanto a besta torcia o corpo do homem, seus gritos de dor se contorcendo em um guincho animalesco."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:42
translate ptPT qst_Terminus_intro_2675f8e6:

    # "What followed was a terrible snapping as he tore the body in two, flinging the man’s halves aside."
    "O que se seguiu foi um estalo terrível quando ele rasgou o corpo em dois, arremessando as metades do homem para o lado."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:43
translate ptPT qst_Terminus_intro_81cfc0fe:

    # "Behind it, barely visible was a myriad of other monsters, clawing and clambering their way down towards us."
    "Atrás dela, mal visível, havia uma miríade de outros monstros, arranhando e escalando seu caminho em nossa direção."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:44
translate ptPT qst_Terminus_intro_ddba1310:

    # MC "Markus... hurry."
    MC "Markus... rápido."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:45
translate ptPT qst_Terminus_intro_463d4592:

    # "The beast roared and charged at us once again! A behemoth of tooth and claw, galloping, ready."
    "A besta rugiu e avançou contra nós mais uma vez! Um gigante de dentes e garras, galopando, pronto."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:47
translate ptPT qst_Terminus_intro_4170c645:

    # MC "HURRY!"
    MC "RÁPIDO!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:48
translate ptPT qst_Terminus_intro_7ad62c8c:

    # MARKUS "It won’t close!"
    MARKUS "Não fecha!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:49
translate ptPT qst_Terminus_intro_d7589ccf:

    # MC "CLOSE IT! CLOSE THE FUCKING DOOR!"
    MC "FECHA! FECHA A PORRA DA PORTA!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:51
translate ptPT qst_Terminus_intro_ef27cd89:

    # MARKUS "I’m trying!"
    MARKUS "Estou tentando!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:52
translate ptPT qst_Terminus_intro_2cd10d35:

    # MC "MARKUS! HURRY! IT’S NEARLY—"
    MC "MARKUS! RÁPIDO! ESTÁ QUASE—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:70
translate ptPT qst_Terminus_intro_135591ef:

    # MC "Ah... Today’s the day... {i}Terminus Ceremony.{/i}"
    MC "Ah... Hoje é o dia... {i}Cerimônia Terminus.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:71
translate ptPT qst_Terminus_intro_3b92041f:

    # "Rising from my bed, I was hit by a {i}shockwave{/i}."
    "Ao me levantar da cama, fui atingido por uma {i}onda de choque{/i}."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:72
translate ptPT qst_Terminus_intro_7ae716df:

    # MC "Urgh... {i}My head...{/i}"
    MC "Urgh... {i}Minha cabeça...{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:73
translate ptPT qst_Terminus_intro_b98a473f:

    # MC "Why did I let Markus talk me into drinking so much last night?"
    MC "Por que eu deixei Markus me convencer a beber tanto na noite passada?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:74
translate ptPT qst_Terminus_intro_47517399:

    # MC "Well, better get ready."
    MC "Bem, melhor me preparar."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:75
translate ptPT qst_Terminus_intro_19314b42:

    # MC "I should grab some gold before I head out, it is {i}a ceremony{/i} after all."
    MC "Eu deveria pegar um pouco de ouro antes de sair, é {i}uma cerimônia{/i}, afinal."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:81
translate ptPT qst_Terminus_KitchenEnterMorning_d39399b8:

    # "Hm... Where is everyone?"
    "Hm... Onde está todo mundo?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:82
translate ptPT qst_Terminus_KitchenEnterMorning_232c2f5f:

    # "Looks like Regina is in her room."
    "Parece que Regina está no quarto dela."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:83
translate ptPT qst_Terminus_KitchenEnterMorning_4ce9008c:

    # "...Should I?"
    "...Devo?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:85
translate ptPT qst_Terminus_KitchenEnterMorning_7aa86cfe:

    # MC "...Should I?" nointeract
    MC "...Devo?" nointeract

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:89
translate ptPT qst_Terminus_KitchenEnterMorning_c3e50393:

    # "Leaning in, I peered through the small gap in the door to watch as [regina_ref!t] was getting dressed, bare naked as she hummed happily to herself, slowly moving to put on her dress for the morning."
    "Inclinando-me, espiei pela pequena fresta na porta para ver enquanto [regina_ref!t] se vestia, completamente nua, cantarolando feliz para si mesma, movendo-se lentamente para vestir o vestido da manhã."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:91
translate ptPT qst_Terminus_KitchenEnterMorning_8060ab4f:

    # MC "I... I shouldn’t watch this! This is... {i}perverse{/i}."
    MC "Eu... Eu não deveria assistir isso! Isso é... {i}perverso{/i}."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:92
translate ptPT qst_Terminus_KitchenEnterMorning_a8c437e9:

    # MC "... But she does look {i}really{/i} pretty."
    MC "... Mas ela está {i}realmente{/i} bonita."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:93
translate ptPT qst_Terminus_KitchenEnterMorning_c5430cc0:

    # MC "Gah! What’s wrong with me? It’s [regina_ref!t] for Rohark’s sake!"
    MC "Gah! O que há de errado comigo? É [regina_ref!t] pelo amor de Rohark!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:98
translate ptPT qst_Terminus_KitchenEnterMorning_2403981d:

    # MC "No, of course I’m not gonna do that! What the hell am I even thinking?"
    MC "Não, claro que não vou fazer isso! O que diabos estou pensando?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:104
translate ptPT qst_Terminus_KitchenEnterMorning_788ecab3:

    # ERIKA @ smile_talk "Well, good morning [player_name!t]."
    ERIKA @ smile_talk "Bem, bom dia [player_name!t]."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:105
translate ptPT qst_Terminus_KitchenEnterMorning_3525008c:

    # "Following the death of both Erika’s mother and my own due to winter fever, our fathers were sent to the front."
    "Após a morte da mãe de Erika e da minha própria devido à febre do inverno, nossos pais foram enviados para o front."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:106
translate ptPT qst_Terminus_KitchenEnterMorning_42b425f3:

    # "Regina, a friend to both families agreed to look after us till our respective fathers came home from the war."
    "Regina, uma amiga de ambas as famílias, concordou em cuidar de nós até que nossos respectivos pais voltassem para casa da guerra."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:107
translate ptPT qst_Terminus_KitchenEnterMorning_30cb1de3:

    # "Sadly, Erika’s father perished two years ago in battle, leaving [regina_ref!t] and myself the closest thing to family she had left."
    "Infelizmente, o pai de Erika faleceu há dois anos em batalha, deixando [regina_ref!t] e eu como a coisa mais próxima de uma família que ela tinha."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:108
translate ptPT qst_Terminus_KitchenEnterMorning_feb83ee4:

    # MC "Erika! I wasn’t expecting you to be here today!"
    MC "Erika! Eu não esperava que você estivesse aqui hoje!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:109
translate ptPT qst_Terminus_KitchenEnterMorning_6f2e862b:

    # MC "Aren’t you supposed to be on top secret Inquisitor work?"
    MC "Você não deveria estar em um trabalho ultrassecreto de Inquisidor?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:110
translate ptPT qst_Terminus_KitchenEnterMorning_c8360b21:

    # ERIKA @ talk "I couldn’t miss seeing you on your big day."
    ERIKA @ talk "Eu não poderia perder a chance de ver você no seu grande dia."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:111
translate ptPT qst_Terminus_KitchenEnterMorning_91f2bc0b:

    # MC "You didn’t need to come but it means the world to me that you have."
    MC "Você não precisava vir, mas significa o mundo para mim que você tenha vindo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:112
translate ptPT qst_Terminus_KitchenEnterMorning_650e053a:

    # "Erika, thanks to her outstanding grades and increasing aptitude for magic, was snatched up and positioned with the Inquisitors on her final schooling day."
    "Erika, graças às suas notas excelentes e à sua crescente aptidão para magia, foi recrutada e colocada com os Inquisidores no seu último dia de escola."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:113
translate ptPT qst_Terminus_KitchenEnterMorning_f0e4df88:

    # "I must admit, I missed her deeply as she went off, gallivanting around on great adventures..."
    "Devo admitir, senti muito a falta dela quando partiu, passeando por aí em grandes aventuras..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:114
translate ptPT qst_Terminus_KitchenEnterMorning_41ebf0a9:

    # "But I knew the work she did was particularly important, so I was always proud of her."
    "Mas eu sabia que o trabalho que ela fazia era particularmente importante, por isso sempre tive orgulho dela."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:119
translate ptPT qst_Terminus_KitchenEnterMorning_d146fea1:

    # "Now dressed, [regina_ref!t] stepped out into the hallway, gasping with delight once she saw Erika."
    "Agora vestida, [regina_ref!t] saiu para o corredor, soltando um suspiro de alegria quando viu Erika."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:120
translate ptPT qst_Terminus_KitchenEnterMorning_c77314f7:

    # REGINA @ talk "[player_name!t], I hope you haven’t—"
    REGINA @ talk "[player_name!t], espero que você não tenha—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:121
translate ptPT qst_Terminus_KitchenEnterMorning_3dc6f6d9:

    # REGINA @ shock_talk "Erika!"
    REGINA @ shock_talk "Érika!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:122
translate ptPT qst_Terminus_KitchenEnterMorning_9166de94:

    # ERIKA @ smile_talk "Hello, [regina_ref!t]."
    ERIKA @ smile_talk "Olá, [regina_ref!t]."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:123
translate ptPT qst_Terminus_KitchenEnterMorning_c6e8ca81:

    # REGINA @ smile_talk "Oooh! Come here, my love!"
    REGINA @ smile_talk "Oooh! Venha cá, meu amor!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:128
translate ptPT qst_Terminus_KitchenEnterMorning_edd7277b:

    # "[regina_ref_cap!t] darted over to give Erika a hug, squeezing her tightly, which Erika clearly found a little uncomfortable."
    "[regina_ref_cap!t] correu para dar um abraço em Erika, apertando-a com força, o que Erika claramente achou um pouco desconfortável."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:129
translate ptPT qst_Terminus_KitchenEnterMorning_2133ccb1:

    # ERIKA @ surp_talk "Uhh, [regina_ref!t]?"
    ERIKA @ surp_talk "Ah, [regina_ref!t]?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:130
translate ptPT qst_Terminus_KitchenEnterMorning_83439c50:

    # ERIKA @ surp_talk "Can’t... {i}breathe!{/i}"
    ERIKA @ surp_talk "Não consigo... {i}respirar!{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:131
translate ptPT qst_Terminus_KitchenEnterMorning_5b0fac1a:

    # REGINA @ shy_talk "Oh! Sorry, dear!"
    REGINA @ shy_talk "Oh! Desculpe, querida!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:134
translate ptPT qst_Terminus_KitchenEnterMorning_f5edd23e:

    # REGINA @ smile_talk "I can’t believe you’re already eighteen."
    REGINA @ smile_talk "Não acredito que já tens dezoito anos."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:135
translate ptPT qst_Terminus_KitchenEnterMorning_88b2e62e:

    # REGINA @ smile_talk "Your father would be so proud!"
    REGINA @ smile_talk "O teu pai estaria tão orgulhoso!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:136
translate ptPT qst_Terminus_KitchenEnterMorning_d8c4e46b:

    # MC "Thanks, [regina_ref!t]."
    MC "Obrigada, [regina_ref!t]."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:137
translate ptPT qst_Terminus_KitchenEnterMorning_e0dadf01:

    # MC "... Is there any news on Father?"
    MC "... Há alguma notícia sobre o Pai?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:139
translate ptPT qst_Terminus_KitchenEnterMorning_b8e7f843:

    # REGINA @ talk "... Well..."
    REGINA @ talk "... Bem..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:141
translate ptPT qst_Terminus_KitchenEnterMorning_8bbedfc6:

    # REGINA @ sad_talk "No, but..."
    REGINA @ sad_talk "Não, mas..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:142
translate ptPT qst_Terminus_KitchenEnterMorning_aa290b42:

