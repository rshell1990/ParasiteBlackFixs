    ERIKA @ smile_talk "Hoje, você tem a gloriosa honra de esfregar as latrinas até ficarem limpas!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:160
translate ptPT qst_Terminus_KitchenEnterMorning_ef69be91:

    # MC @ smile "... Ha-ha, how funny you are."
    MC @ smile "... Ha-ha, como você é engraçado."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:161
translate ptPT qst_Terminus_KitchenEnterMorning_de748599:

    # ERIKA @ smile_talk "Oh, lighten up, it’s an important day, right, [regina_ref!t]?"
    ERIKA @ smile_talk "Ah, anime-se, é um dia importante, não é, [regina_ref!t]?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:162
translate ptPT qst_Terminus_KitchenEnterMorning_5bc91582:

    # REGINA @ smile_talk "Both he and Markus have been working tirelessly on their studies for months."
    REGINA @ smile_talk "Tanto ele quanto Markus têm trabalhado incansavelmente em seus estudos por meses."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:163
translate ptPT qst_Terminus_KitchenEnterMorning_15991414:

    # ERIKA @ smile_talk "Glad to hear it, and here I was worried you’d both spend too much time chasing girls."
    ERIKA @ smile_talk "Fico feliz em ouvir isso, e eu estava preocupada que vocês dois passassem muito tempo correndo atrás de garotas."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:164
translate ptPT qst_Terminus_KitchenEnterMorning_27ffcbae:

    # MC @ smile "And risk our great chance at the palace?"
    MC @ smile "E arriscar nossa grande chance no palácio?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:165
translate ptPT qst_Terminus_KitchenEnterMorning_8d17beaa:

    # ERIKA @ lewd_talk "Ah yes, I forgot, you want to chase beautiful AND rich girls."
    ERIKA @ lewd_talk "Ah sim, esqueci, você quer perseguir garotas bonitas E ricas."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:166
translate ptPT qst_Terminus_KitchenEnterMorning_28eda718:

    # MC "I’m a man with reputable tastes, Erika."
    MC "Sou um homem de gostos renomados, Erika."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:167
translate ptPT qst_Terminus_KitchenEnterMorning_41eb3cb0:

    # ERIKA @ smile_talk "Tastes well above your station, I might add."
    ERIKA @ smile_talk "Gostos bem acima da sua posição social, devo acrescentar."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:168
translate ptPT qst_Terminus_KitchenEnterMorning_3f3dc3f8:

    # REGINA "So, I take it you’re both still planning on being administrators in the Royal Court, isn’t that right?"
    REGINA "Então, presumo que ambos ainda estão planejando ser administradores na Corte Real, não é mesmo?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:172
translate ptPT qst_Terminus_KitchenEnterMorning_b61df758:

    # ERIKA @ smile_talk "Hoping for a nice easy life, huh?"
    ERIKA @ smile_talk "Esperando uma vida boa e fácil, hein?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:173
translate ptPT qst_Terminus_KitchenEnterMorning_7434d5e2:

    # REGINA @ talk "Oh stop, Erika! Him and every other student is hoping to be designated a nicer role like that."
    REGINA @ talk "Ah, pare com isso, Erika! Ele e todos os outros alunos esperam ser designados para um papel mais agradável como esse."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:174
translate ptPT qst_Terminus_KitchenEnterMorning_2a39ea4a:

    # ERIKA @ talk "Most of them are also daydreaming about sleeping with the Princess."
    ERIKA @ talk "A maioria deles também está sonhando acordada em dormir com a Princesa."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:175
translate ptPT qst_Terminus_KitchenEnterMorning_f192bed0:

    # REGINA @ shock_talk "Erika! Your mouth, young lady!"
    REGINA @ shock_talk "Erika! Sua boca, mocinha!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:178
translate ptPT qst_Terminus_KitchenEnterMorning_e7b4bc47:

    # REGINA @ talk "Y-You’re joking, right?"
    REGINA @ talk "V-Você está brincando, né?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:179
translate ptPT qst_Terminus_KitchenEnterMorning_cba23fe7:

    # ERIKA @ smile_talk "Finally! A job I think you two pervs would actually be good at!"
    ERIKA @ smile_talk "Finalmente! Um trabalho que acho que vocês dois tarados realmente seriam bons!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:181
translate ptPT qst_Terminus_KitchenEnterMorning_662ec96d:

    # REGINA @ lewd_talk "AHEM! I hope that wasn’t a {i}serious{/i} suggestion, I don’t know I’d be able to live with the embarrassment of having to explain your new role to people."
    REGINA @ lewd_talk "AHEM! Espero que isso não tenha sido uma sugestão {i}séria{/i}, não sei se conseguiria viver com a vergonha de ter que explicar seu novo papel para as pessoas."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:182
translate ptPT qst_Terminus_KitchenEnterMorning_ac18dfc3:

    # MC "Yes, I’m only playing."
    MC "Sim, estou apenas brincando."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:183
translate ptPT qst_Terminus_KitchenEnterMorning_6c06afb5:

    # REGINA @ talk "I should hope so too!"
    REGINA @ talk "Também espero que sim!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:184
translate ptPT qst_Terminus_KitchenEnterMorning_07d7d654:

    # REGINA @ talk "You’ve both worked far too hard and are far too bright for that kind of work."
    REGINA @ talk "Vocês dois trabalharam muito duro e são inteligentes demais para esse tipo de trabalho."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:186
translate ptPT qst_Terminus_KitchenEnterMorning_71b3d9fe:

    # REGINA "... Well, that’s odd, it’s all the two of you have talked about for the last few years!"
    REGINA "... Bem, isso é estranho, é tudo o que vocês dois têm falado nos últimos anos!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:187
translate ptPT qst_Terminus_KitchenEnterMorning_b6d9af33:

    # ERIKA "Yeah, why the sudden change of heart? Realised there’s no way in hell you’d be able to woo the Princess, huh?"
    ERIKA "Sim, por que a mudança repentina de coração? Percebeu que não há a menor chance de você conseguir cortejar a Princesa, hein?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:188
translate ptPT qst_Terminus_KitchenEnterMorning_a8b0989d:

    # MC "Cute."
    MC "Fofo."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:189
translate ptPT qst_Terminus_KitchenEnterMorning_8e4eb0b8:

    # MC "And I dunno, I guess..."
    MC "E não sei, acho que..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:190
translate ptPT qst_Terminus_KitchenEnterMorning_f56653ee:

    # MC "{i}I’m just not quite sure what I want.{/i}"
    MC "{i}Eu só não tenho muita certeza do que eu quero.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:191
translate ptPT qst_Terminus_KitchenEnterMorning_3fec9308:

    # REGINA "... Well... I’m sure you’ll be good at whatever you end up doing, sweetie."
    REGINA "... Bem... Tenho certeza de que você será bom em qualquer coisa que acabar fazendo, querido."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:192
translate ptPT qst_Terminus_KitchenEnterMorning_70857d8b:

    # ERIKA @ talk "Well, this has been fun, but I really must get going."
    ERIKA @ talk "Bem, isso foi divertido, mas eu realmente preciso ir."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:194
translate ptPT qst_Terminus_KitchenEnterMorning_f078974e:

    # REGINA @ sad_talk "So soon? We haven’t seen you in weeks!"
    REGINA @ sad_talk "Tão cedo? Não te vemos há semanas!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:195
translate ptPT qst_Terminus_KitchenEnterMorning_319e2dc2:

    # ERIKA @ sad_talk "I know, I know... But there’s some particularly troubling business that needs my full attention."
    ERIKA @ sad_talk "Eu sei, eu sei... Mas há um assunto particularmente preocupante que precisa de toda a minha atenção."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:196
translate ptPT qst_Terminus_KitchenEnterMorning_36627c23:

    # REGINA @ sad_talk "... Hunting more Dark Mages, I suppose?"
    REGINA @ sad_talk "... Caçando mais Magos das Trevas, suponho?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:197
translate ptPT qst_Terminus_KitchenEnterMorning_01793ebd:

    # ERIKA @ talk "You know I can’t discuss Inquisitor work."
    ERIKA @ talk "Você sabe que não posso discutir o trabalho de Inquisidor."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:198
translate ptPT qst_Terminus_KitchenEnterMorning_4fc03764:

    # REGINA @ sad_talk "If we only talked to them more—"
    REGINA @ sad_talk "Se ao menos conversássemos mais com eles—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:199
translate ptPT qst_Terminus_KitchenEnterMorning_96760879:

    # ERIKA @ sad_talk "We will {i}not{/i} allow tainted magic into Novaras."
    ERIKA @ sad_talk "Nós {i}não{/i} permitiremos magia corrompida em Novaras."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:200
translate ptPT qst_Terminus_KitchenEnterMorning_ab53317b:

    # REGINA @ talk "But times have changed! Our survival depends on cooperation now, not more division."
    REGINA @ talk "Mas os tempos mudaram! Nossa sobrevivência depende de cooperação agora, não de mais divisão."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:201
translate ptPT qst_Terminus_KitchenEnterMorning_80d8ffc8:

    # ERIKA @ talk "We have enough problems as it is without letting loose dangerous Black Mages across the city."
    ERIKA @ talk "Já temos problemas suficientes sem soltar Magos Negros perigosos pela cidade."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:203
translate ptPT qst_Terminus_KitchenEnterMorning_3b050990:

    # REGINA @ angry_talk "But we need all the mages we can get!"
    REGINA @ angry_talk "Mas precisamos de todos os magos que pudermos conseguir!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:205
translate ptPT qst_Terminus_KitchenEnterMorning_effab067:

    # ERIKA @ angry_talk "It’s the law, and one I am sworn to uphold."
    ERIKA @ angry_talk "É a lei, e uma que jurei defender."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:206
translate ptPT qst_Terminus_KitchenEnterMorning_23843033:

    # REGINA @ angry_talk "Urgh... You’re definitely spending too much time with those Inquisitors; you’re starting to sound just like them."
    REGINA @ angry_talk "Urgh... Você está definitivamente passando tempo demais com aqueles Inquisidores; está começando a soar exatamente como eles."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:207
translate ptPT qst_Terminus_KitchenEnterMorning_b86f4408:

    # ERIKA @ angry_talk "You barely know what you’re talking about!"
    ERIKA @ angry_talk "Você mal sabe do que está falando!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:209
translate ptPT qst_Terminus_KitchenEnterMorning_b7fa50d6:

    # ERIKA @ talk "I’ve seen with my own eyes some of the horrors from their twisted magic."
    ERIKA @ talk "Eu vi com meus próprios olhos alguns dos horrores de sua magia distorcida."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:211
translate ptPT qst_Terminus_KitchenEnterMorning_c0c3f0c3:

    # REGINA @ talk "Not all magic is pretty, Erika."
    REGINA @ talk "Nem toda magia é bonita, Erika."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:212
translate ptPT qst_Terminus_KitchenEnterMorning_9fe99013:

    # ERIKA @ talk "[regina_ref_cap!t], please, you must learn to keep those kinds of beliefs quiet."
    ERIKA @ talk "[regina_ref_cap!t], por favor, você precisa aprender a manter esse tipo de crença em silêncio."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:213
translate ptPT qst_Terminus_KitchenEnterMorning_13a6fd6f:

    # REGINA @ talk "They are born with their magic, you know this."
    REGINA @ talk "Eles nascem com sua magia, você sabe disso."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:214
translate ptPT qst_Terminus_KitchenEnterMorning_a140ae77:

    # REGINA @ angry_talk "It’s not a crime to have sympathy for them. "
    REGINA @ angry_talk "Não é crime ter simpatia por eles."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:215
translate ptPT qst_Terminus_KitchenEnterMorning_02857159:

    # ERIKA @ talk "No, it’s not, but you know full well that being a sympathiser will lead to Inquisitors like myself investigating you and that will make things very {i}very{/i} difficult."
    ERIKA @ talk "Não, não é, mas você sabe muito bem que ser simpatizante levará Inquisidores como eu a investigá-la e isso tornará as coisas muito {i}muito{/i} difíceis."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:216
translate ptPT qst_Terminus_KitchenEnterMorning_56987547:

    # ERIKA @ talk "... For {i}both{/i} of us."
    ERIKA @ talk "... Para {i}ambos{/i} de nós."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:217
translate ptPT qst_Terminus_KitchenEnterMorning_662000c9:

    # REGINA @ angry_talk "Well, I’m sorry Erika but my opinions on the matter—"
    REGINA @ angry_talk "Bem, me desculpe Erika, mas minhas opiniões sobre o assunto—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:218
translate ptPT qst_Terminus_KitchenEnterMorning_1b91f8e7:

    # MC angry "That’s enough! Both of you."
    MC angry "Já chega! Vocês dois."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:219
translate ptPT qst_Terminus_KitchenEnterMorning_cbfd6a46:

    # REGINA @ sad_talk "... Sorry dear, we shouldn’t be squabbling like this on your big day."
    REGINA @ sad_talk "... Desculpe querida, não deveríamos estar brigando assim no seu grande dia."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:220
translate ptPT qst_Terminus_KitchenEnterMorning_502af9bf:

    # ERIKA @ talk "You’re right, now is not the time for debating politics."
    ERIKA @ talk "Você tem razão, agora não é hora de debater política."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:221
translate ptPT qst_Terminus_KitchenEnterMorning_5b77c2d3:

    # ERIKA @ talk "Especially matters as important as this."
    ERIKA @ talk "Especialmente assuntos tão importantes como este."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:223
translate ptPT qst_Terminus_KitchenEnterMorning_513aa734:

    # MC "Will you be back when I get home, Erika?"
    MC "Você estará de volta quando eu chegar em casa, Erika?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:224
translate ptPT qst_Terminus_KitchenEnterMorning_d9bcd695:

    # ERIKA @ talk "No, unfortunately, I’m afraid not..."
    ERIKA @ talk "Não, infelizmente, receio que não..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:225
translate ptPT qst_Terminus_KitchenEnterMorning_5cc55978:

    # MC @ sad "... Oh... Well, I understand, I guess."
    MC @ sad "... Ah... Bem, eu entendo, eu acho."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:226
translate ptPT qst_Terminus_KitchenEnterMorning_205e64ec:

    # ERIKA @ smile_talk "But I promise I will be back soon! And you and I can both go and celebrate properly together then, I swear it."
    ERIKA @ smile_talk "Mas eu prometo que voltarei em breve! E você e eu poderemos ir e comemorar adequadamente juntos então, eu juro."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:227
translate ptPT qst_Terminus_KitchenEnterMorning_e12ad870:

    # MC smile "That would be good..."
    MC smile "Isso seria bom..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:228
translate ptPT qst_Terminus_KitchenEnterMorning_1b68ba29:

    # MC sad "... I’ve missed you greatly."
    MC sad "... Senti muito a sua falta."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:229
translate ptPT qst_Terminus_KitchenEnterMorning_9f47caa8:

    # ERIKA @ smile_talk "And I you."
    ERIKA @ smile_talk "E eu você."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:230
translate ptPT qst_Terminus_KitchenEnterMorning_54bd5cc3:

    # ERIKA @ talk "... Anyhow, I must get going now."
    ERIKA @ talk "... De qualquer forma, preciso ir agora."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:231
translate ptPT qst_Terminus_KitchenEnterMorning_cd64f564:

    # REGINA @ talk "... Be safe, dear."
    REGINA @ talk "... Tenha cuidado, querido."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:232
translate ptPT qst_Terminus_KitchenEnterMorning_f0bc2f6f:

    # ERIKA @ talk "Will do, and you too, [player_name!t]."
    ERIKA @ talk "Pode deixar, e você também, [player_name!t]."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:233
translate ptPT qst_Terminus_KitchenEnterMorning_ca2df092:

    # ERIKA @ talk "Look after [regina_ref!t] while I’m gone."
    ERIKA @ talk "Cuide de [regina_ref!t] enquanto eu estiver fora."

