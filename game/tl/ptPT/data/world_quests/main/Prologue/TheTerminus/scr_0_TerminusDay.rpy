translate ptPT qst_Terminus_KitchenEnterMorning_d7e14922:

    # MC "[regina_ref_cap!t]!"
    MC "[regina_ref_cap!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:259
