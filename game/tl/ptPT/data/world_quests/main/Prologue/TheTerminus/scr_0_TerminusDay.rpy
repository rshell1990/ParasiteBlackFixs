translate ptPT qst_Terminus_KitchenEnterMorning_6ecfd72e:

    # ERIKA @ smile_talk "Yes! [player_name!t]!"
    ERIKA @ smile_talk "Sim! [player_name!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:159
translate ptPT qst_Terminus_KitchenEnterMorning_f60e5636:

