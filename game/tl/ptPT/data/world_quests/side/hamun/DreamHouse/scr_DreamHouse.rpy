# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:7
translate ptPT qst_dreamhouse_primer_letter_6eb8ca0a:

    # GUARD "Ladies Anya and Chanyi of Faymore estate wish to speak with you."
    GUARD "As senhoras Anya e Chanyi da propriedade Faymore desejam falar com você."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:8
translate ptPT qst_dreamhouse_primer_letter_a1356f46:

    # MC @ think "Who?"
    MC @ think "Quem?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:9
translate ptPT qst_dreamhouse_primer_letter_e8cbf5b6:

    # GUARD "I would suggest heading to their home at once."
    GUARD "Eu sugiro que vá à casa delas imediatamente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:10
translate ptPT qst_dreamhouse_primer_letter_aa935952:

    # GUARD "Lady Chanyi is not to be ignored..."
    GUARD "A senhora Chanyi não deve ser ignorada..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:13
translate ptPT qst_dreamhouse_primer_letter_4f5e4e99:

    # "The guard handed over a small document with the house sigil of a butterfly attached."
    "O guarda entregou um pequeno documento com o sigilo da casa, uma borboleta, anexado."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:19
translate ptPT qst_dreamhouse_primer_letter_1ba1677f:

    # MC @ serious "(What am I getting myself into this time?)"
    MC @ serious "(No que estou me metendo desta vez?)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:26
translate ptPT qst_dreamhouse_primer_approach_estate_141568b6:

    # "The guard carefully inspected the document, and then, after looking up towards me, stepped aside."
    "O guarda inspecionou cuidadosamente o documento e, após olhar para mim, deu um passo para o lado."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:28
translate ptPT qst_dreamhouse_primer_approach_estate_61bc238b:

    # GUARD "Be on your best behaviour, or you will be removed by force at Lady Anya and Chanyi's pleasure."
    GUARD "Comporte-se da melhor maneira, ou será removido à força pelo prazer das senhoras Anya e Chanyi."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:50
translate ptPT qst_dreamhouse_enter_manor_66d36d33:

    # "Entering through the doors, I was greeted by the strangest sight."
    "Ao entrar pelas portas, fui recebido pela visão mais estranha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:51
translate ptPT qst_dreamhouse_enter_manor_21d8a104:

    # "The great hall seemed split in two halves: one made of black marble and stone, with macabre statues of old gods and skulls, like the home of some terrifying vampire lord."
    "O grande salão parecia dividido em duas metades: uma feita de mármore preto e pedra, com estátuas macabras de deuses antigos e caveiras, como o lar de algum terrível lorde vampiro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:53
translate ptPT qst_dreamhouse_enter_manor_06d4ecae:

    # "The other half was made of white marble and pink stone, complete with statues of majestic horses and beauty."
    "A outra metade era feita de mármore branco e pedra rosa, completa com estátuas de cavalos majestosos e beleza."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:55
translate ptPT qst_dreamhouse_enter_manor_90cd288e:

    # ANYA @ happy "OHHH! You made it!"
    ANYA @ happy "OHHH! Você chegou!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:57
translate ptPT qst_dreamhouse_enter_manor_be279b5e:

    # "The excited, cheerful woman rushed over once she saw me."
    "A mulher animada e alegre correu até mim assim que me viu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:58
translate ptPT qst_dreamhouse_enter_manor_57e46665:

    # MC @ think "Umm, you know who I am?"
    MC @ think "Umm, você sabe quem eu sou?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:59
translate ptPT qst_dreamhouse_enter_manor_e9aa6d62:

    # ANYA @ happy "Of course, everyone's heard about you and what happened in that arena!"
    ANYA @ happy "Claro, todo mundo já ouviu falar de você e do que aconteceu naquela arena!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:60
translate ptPT qst_dreamhouse_enter_manor_0e09dc00:

    # "The woman motioned towards herself."
    "A mulher gesticulou em direção a si mesma."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:62
translate ptPT qst_dreamhouse_enter_manor_0a99219c:

    # ANYA @ talk "I am Anya Faymore."
    ANYA @ talk "Eu sou Anya Faymore."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:64
translate ptPT qst_dreamhouse_enter_manor_c21b8a2a:

    # ANYA @ happy "Thank you for accepting our invitation."
    ANYA @ happy "Obrigada por aceitar nosso convite."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:65
translate ptPT qst_dreamhouse_enter_manor_94e5fabf:

    # MC @ think "Right... But..."
    MC @ think "Certo... Mas..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:66
translate ptPT qst_dreamhouse_enter_manor_aca35653:

    # MC @ think "What is this about?"
    MC @ think "Do que se trata?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:67
translate ptPT qst_dreamhouse_enter_manor_e9248fac:

    # CHANYI "Our daughter, sellsword."
    CHANYI "Nossa filha, mercenária."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:69
translate ptPT qst_dreamhouse_enter_manor_53d7755c:

    # "Descending the great stairs, another woman, this one a katai, adorned in a beautiful black dress, made her way over towards us."
    "Descendo as grandes escadarias, outra mulher, desta vez uma katai, adornada com um belo vestido preto, aproximou-se de nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:70
translate ptPT qst_dreamhouse_enter_manor_544cfb14:

    # ANYA @ happy "This is my beautiful wife, Chanyi!"
    ANYA @ happy "Esta é a minha bela esposa, Chanyi!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:71
translate ptPT qst_dreamhouse_enter_manor_48aabfb9:

    # ANYA @ talk "Should I get us some tea or—"
    ANYA @ talk "Devo trazer um chá para nós ou—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:72
translate ptPT qst_dreamhouse_enter_manor_f5ce4cbf:

    # CHANYI @ talk "Our daughter is missing. Given you and your party's set of *skills*, I want you to get her back for us."
    CHANYI @ talk "Nossa filha está desaparecida. Dado o conjunto de *habilidades* de você e seu grupo, quero que a tragam de volta para nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:73
translate ptPT qst_dreamhouse_enter_manor_0e3bd004:

    # ANYA @ sad "Chanyi, we said we'd take our time explaining things, not just—"
    ANYA @ sad "Chanyi, dissemos que explicaríamos as coisas com calma, não apenas—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:75
translate ptPT qst_dreamhouse_enter_manor_069f8250:

    # CHANYI @ talk "Our daughter is missing."
    CHANYI @ talk "Nossa filha está desaparecida."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:76
translate ptPT qst_dreamhouse_enter_manor_87b30b1f:

    # CHANYI @ talk "We can waste time drinking tea when she's back."
    CHANYI @ talk "Podemos perder tempo bebendo chá quando ela estiver de volta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:78
translate ptPT qst_dreamhouse_enter_manor_b4bfe7e1:

    # ANYA @ sad "Y-Yes... Of course."
    ANYA @ sad "S-Sim... Claro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:83
translate ptPT qst_dreamhouse_enter_manor_menu_1d2326ed:

    # ANYA @ emb "W-Well... You see."
    ANYA @ emb "B-Bem... Veja você."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:84
translate ptPT qst_dreamhouse_enter_manor_menu_ba70a7ea:

    # ANYA @ talk "I used to be very different."
    ANYA @ talk "Eu costumava ser muito diferente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:85
translate ptPT qst_dreamhouse_enter_manor_menu_9d68f0eb:

    # ANYA @ talk "I was in a difficult place until I met Chanyi here!"
    ANYA @ talk "Eu estava em uma situação difícil até que conheci Chanyi aqui!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:86
translate ptPT qst_dreamhouse_enter_manor_menu_9892746a:

    # ANYA @ happy "She just swooped me off my feet when I was at my lowest!"
    ANYA @ happy "Ela simplesmente me tirou do chão quando eu estava no meu pior momento!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:87
translate ptPT qst_dreamhouse_enter_manor_menu_31b1e459:

    # CHANYI @ laugh "You and I have very different recollections of swooping you off your feet."
    CHANYI @ laugh "Você e eu temos lembranças muito diferentes de te tirar do chão."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:88
translate ptPT qst_dreamhouse_enter_manor_menu_e8330fa4:

    # CHANYI @ laugh "I seem to remember it involved a lot more biting and pinning you against walls."
    CHANYI @ laugh "Parece que me lembro de que envolvia muito mais mordidas e te prensar contra as paredes."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:89
translate ptPT qst_dreamhouse_enter_manor_menu_90f4456f:

    # ANYA @ shock "CHANYI!"
    ANYA @ shock "CHANYI!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:90
translate ptPT qst_dreamhouse_enter_manor_menu_2b6d89e3:

    # ANYA @ emb "Must you always tell people that?"
    ANYA @ emb "Precisa sempre contar isso para as pessoas?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:93
translate ptPT qst_dreamhouse_enter_manor_menu_2473bc2e:

    # CHANYI "Anya is her birth mother."
    CHANYI "Anya é a mãe biológica dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:94
translate ptPT qst_dreamhouse_enter_manor_menu_27b3c41a:

    # CHANYI "But I have raised her since she was three."
    CHANYI "Mas eu a criei desde os três anos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:95
translate ptPT qst_dreamhouse_enter_manor_menu_10c177a9:

    # ANYA @ sad "We're both terribly worried!"
    ANYA @ sad "Estamos ambas terrivelmente preocupadas!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:96
translate ptPT qst_dreamhouse_enter_manor_menu_25d399ca:

    # MC @ think "And the father is...?"
    MC @ think "E o pai é...?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:97
translate ptPT qst_dreamhouse_enter_manor_menu_015c7327:

    # ANYA @ sad "Umm... We are no longer together."
    ANYA @ sad "Umm... Não estamos mais juntos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:98
translate ptPT qst_dreamhouse_enter_manor_menu_2ca16687:

    # ANYA @ sad "It's... a long story."
    ANYA @ sad "É... uma longa história."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:99
translate ptPT qst_dreamhouse_enter_manor_menu_6188caea:

    # MC @ talk "I see."
    MC @ talk "Entendo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:102
translate ptPT qst_dreamhouse_enter_manor_menu_a8bdbc3d:

    # CHANYI @ talk "Her name is Serafina. She's eighteen."
    CHANYI @ talk "Ela se chama Serafina. Tem dezoito anos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:103
translate ptPT qst_dreamhouse_enter_manor_menu_2d50000a:

    # CHANYI @ talk "She disappeared about a month ago."
    CHANYI @ talk "Ela desapareceu há cerca de um mês."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:104
translate ptPT qst_dreamhouse_enter_manor_menu_08652879:

    # CHANYI @ angry "No doubt taken by that righteous cunt of a father of hers."
    CHANYI @ angry "Sem dúvida, raptada por aquele cuzão moralista do pai dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:105
translate ptPT qst_dreamhouse_enter_manor_menu_b521d354:

    # ANYA @ sad "Chanyi, we don't know for sure it was him."
    ANYA @ sad "Chanyi, não temos certeza de que foi ele."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:106
translate ptPT qst_dreamhouse_enter_manor_menu_498c730e:

    # CHANYI @ angry "Who else could it be?"
    CHANYI @ angry "Quem mais poderia ser?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:107
translate ptPT qst_dreamhouse_enter_manor_menu_73e06ee7:

    # CHANYI @ angry "That prick has never accepted you leaving him for me!"
    CHANYI @ angry "Aquele idiota nunca aceitou você deixá-lo por mim!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:108
translate ptPT qst_dreamhouse_enter_manor_menu_19f38f0d:

    # MC @ think "Who is the father?"
    MC @ think "Quem é o pai?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:109
translate ptPT qst_dreamhouse_enter_manor_menu_06209599:

    # ANYA @ sad "His name is Davik... He's an inquisitor."
    ANYA @ sad "O nome dele é Davik... Ele é um inquisidor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:113
translate ptPT qst_dreamhouse_enter_manor_menu2_12f42a82:

    # CHANYI @ angry "Six months ago, I found a letter he wrote begging to see her."
    CHANYI @ angry "Seis meses atrás, encontrei uma carta que ele escreveu implorando para vê-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:114
translate ptPT qst_dreamhouse_enter_manor_menu2_33af69a7:

    # CHANYI @ talk "She swore she never wrote him back, but I'm not convinced."
    CHANYI @ talk "Ela jurou que nunca lhe respondeu, mas não estou convencido."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:115
translate ptPT qst_dreamhouse_enter_manor_menu2_2393b2af:

    # CHANYI @ angry "He's just trying to get in her head! He hardly had time for her or Anya when he was too busy running around playing inquisitor."
    CHANYI @ angry "Ele está apenas tentando entrar na cabeça dela! Ele mal tinha tempo para ela ou Anya quando estava ocupado demais correndo por aí bancando o inquisidor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:119
translate ptPT qst_dreamhouse_enter_manor_menu2_fbfd608b:

    # "The two women shifted uncomfortably at the question."
    "As duas mulheres se mexeram desconfortavelmente com a pergunta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:120
translate ptPT qst_dreamhouse_enter_manor_menu2_ee8bdeea:

    # MC @ think "What? What's the matter?"
    MC @ think "O quê? Qual é o problema?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:121
translate ptPT qst_dreamhouse_enter_manor_menu2_96c2a3da:

    # ANYA @ sad "Serafina had... a gift."
    ANYA @ sad "Serafina tinha... um dom."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:122
translate ptPT qst_dreamhouse_enter_manor_menu2_990f99c8:

    # MC @ talk "A gift?"
    MC @ talk "Um dom?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:123
translate ptPT qst_dreamhouse_enter_manor_menu2_ed1a1ac6:

    # CHANYI @ talk "Her nightmares would come true."
    CHANYI @ talk "Os pesadelos dela se tornavam realidade."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:124
translate ptPT qst_dreamhouse_enter_manor_menu2_bc5fb14a:

    # MC @ surprised "... What?"
    MC @ surprised "... O quê?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:125
translate ptPT qst_dreamhouse_enter_manor_menu2_cbe3bb55:

    # ANYA @ talk "She was a normal girl until her sixteenth birthday, then..."
    ANYA @ talk "Ela era uma garota normal até seu décimo sexto aniversário, então..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:126
translate ptPT qst_dreamhouse_enter_manor_menu2_df61acad:

    # CHANYI @ talk "Then the nightmares came."
    CHANYI @ talk "Então os pesadelos vieram."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:127
translate ptPT qst_dreamhouse_enter_manor_menu2_7a819cb1:

    # MC @ serious "Slow down, what do you mean her nightmares came true?"
    MC @ serious "Devagar, o que você quer dizer com os pesadelos dela se tornaram realidade?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:128
translate ptPT qst_dreamhouse_enter_manor_menu2_5293d8d0:

    # CHANYI @ talk "When she turned sixteen, a group of men tried to kidnap her."
    CHANYI @ talk "Quando ela fez dezesseis anos, um grupo de homens tentou sequestrá-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:129
translate ptPT qst_dreamhouse_enter_manor_menu2_16316f5b:

    # CHANYI @ talk "No doubt to ransom her off, but our guards managed to get her to safety."
    CHANYI @ talk "Sem dúvida para pedir resgate, mas nossos guardas conseguiram levá-la para um local seguro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:130
translate ptPT qst_dreamhouse_enter_manor_menu2_a270fe11:

    # CHANYI @ talk "She was shaken up though, and that night... she woke up screaming."
    CHANYI @ talk "Ela estava abalada, no entanto, e naquela noite... ela acordou gritando."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:131
translate ptPT qst_dreamhouse_enter_manor_menu2_460f4982:

    # CHANYI @ talk "She told us that she dreamed she was a monster chasing down the men who tried to kidnap her."
    CHANYI @ talk "Ela nos contou que sonhou que era um monstro perseguindo os homens que tentaram sequestrá-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:132
translate ptPT qst_dreamhouse_enter_manor_menu2_46c39d9f:

    # CHANYI @ talk "She described it in such vivid detail... I thought it was just an overactive imagination at first."
    CHANYI @ talk "Ela descreveu com tantos detalhes vívidos... Pensei que fosse apenas uma imaginação fértil no começo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:133
translate ptPT qst_dreamhouse_enter_manor_menu2_520a156e:

    # ANYA @ talk "... Then the bodies were found in the morning."
    ANYA @ talk "... Então os corpos foram encontrados pela manhã."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:134
translate ptPT qst_dreamhouse_enter_manor_menu2_3b6cf756:

    # ANYA @ talk "Each man torn apart in exactly the way she told us her nightmare went."
    ANYA @ talk "Cada homem foi dilacerado exatamente da forma como ela nos contou que seu pesadelo aconteceu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:135
translate ptPT qst_dreamhouse_enter_manor_menu2_51647ab0:

    # MC @ think "... And there have been more nightmares since?"
    MC @ think "... E desde então houve mais pesadelos?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:136
translate ptPT qst_dreamhouse_enter_manor_menu2_003d4670:

    # ANYA @ sad "Yes... First it was one of our gardeners."
    ANYA @ sad "Sim... Primeiro foi um dos nossos jardineiros."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:137
translate ptPT qst_dreamhouse_enter_manor_menu2_715fe614:

    # ANYA @ sad "Then others died in her nightmares."
    ANYA @ sad "Depois outros morreram em seus pesadelos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:138
translate ptPT qst_dreamhouse_enter_manor_menu2_f57b8969:

    # ANYA @ sad "It got so bad, we started asking the staff to wear masks so she wouldn't see their faces... in case she dreamed about them."
    ANYA @ sad "Ficou tão ruim que começamos a pedir que os funcionários usassem máscaras para que ela não visse seus rostos... caso ela sonhasse com eles."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:141
translate ptPT qst_dreamhouse_enter_manor_menu3_034157f6:

    # CHANYI @ angry "Absolutely not!"
    CHANYI @ angry "De jeito nenhum!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:142
translate ptPT qst_dreamhouse_enter_manor_menu3_c1a4a64d:

    # CHANYI @ angry "In a best-case scenario, they would take her away from us."
    CHANYI @ angry "Na melhor das hipóteses, eles a levariam para longe de nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:143
translate ptPT qst_dreamhouse_enter_manor_menu3_1cfa090e:

    # CHANYI @ angry "In a worst case, those infernal inquisitors might see her as a dark mage."
    CHANYI @ angry "Na pior das hipóteses, aqueles inquisidores infernais poderiam vê-la como uma maga das trevas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:146
translate ptPT qst_dreamhouse_enter_manor_menu3_5eeba76c:

    # ANYA @ sad "Gods, no!"
    ANYA @ sad "Deuses, não!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:147
translate ptPT qst_dreamhouse_enter_manor_menu3_c9dbcbe5:

    # CHANYI @ angry "You can't know that for sure, Anya."
    CHANYI @ angry "Você não pode ter certeza disso, Anya."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:148
translate ptPT qst_dreamhouse_enter_manor_menu3_1d04be5e:

    # ANYA @ talk "He loved her, he wanted to be in her life."
    ANYA @ talk "Ele a amava, ele queria estar na vida dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:149
translate ptPT qst_dreamhouse_enter_manor_menu3_f85862f1:

    # ANYA @ talk "No matter what happens, I know he wouldn't want to hurt her!"
    ANYA @ talk "Não importa o que aconteça, sei que ele não gostaria de machucá-la!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:150
translate ptPT qst_dreamhouse_enter_manor_menu3_1ec4142f:

    # MC @ talk "Can you tell me more about why you separated from your husband?"
    MC @ talk "Você pode me contar mais sobre por que se separou do seu marido?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:151
translate ptPT qst_dreamhouse_enter_manor_menu3_a75f67f7:

    # ANYA @ sad "To be married to an inquisitor isn't an easy thing."
    ANYA @ sad "Ser casada com um inquisidor não é fácil."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:152
translate ptPT qst_dreamhouse_enter_manor_menu3_35bf1749:

    # ANYA @ sad "At first, they're gone for days, just here and there."
    ANYA @ sad "No começo, eles ficam fora por dias, só de vez em quando."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:153
translate ptPT qst_dreamhouse_enter_manor_menu3_3f497119:

    # ANYA @ sad "Days become weeks."
    ANYA @ sad "Os dias se tornam semanas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:154
translate ptPT qst_dreamhouse_enter_manor_menu3_d513c84a:

    # ANYA @ sad "Weeks become months."
    ANYA @ sad "As semanas se tornam meses."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:155
translate ptPT qst_dreamhouse_enter_manor_menu3_1120c6e6:

    # ANYA @ sad "The loneliness is crushing, and soon, you're not living with someone you love anymore, but just another stranger in your home."
    ANYA @ sad "A solidão é esmagadora, e logo você não está mais vivendo com alguém que ama, mas apenas mais um estranho em sua casa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:156
translate ptPT qst_dreamhouse_enter_manor_menu3_1299b19f:

    # MC @ talk "You chose to marry an inquisitor. You must have known how absent he would have to be?"
    MC @ talk "Você escolheu se casar com um inquisidor. Deveria saber o quanto ele teria que estar ausente?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:157
translate ptPT qst_dreamhouse_enter_manor_menu3_deb3e3e7:

    # CHANYI @ angry "Easy to say when you're not the one coming home to an empty house every night."
    CHANYI @ angry "Fácil de dizer quando você não é a pessoa que chega em casa para uma casa vazia todas as noites."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:158
translate ptPT qst_dreamhouse_enter_manor_menu3_7438cf98:

    # ANYA @ angry "Chanyi!"
    ANYA @ angry "Chanyi!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:159
translate ptPT qst_dreamhouse_enter_manor_menu3_c20b8a8b:

    # ANYA @ sad "... Yes, I knew how demanding the job would be."
    ANYA @ sad "... Sim, eu sabia o quão exigente o trabalho seria."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:160
translate ptPT qst_dreamhouse_enter_manor_menu3_0f293903:

    # ANYA @ sad "And the first time I kissed Chanyi, the guilt nearly killed me..."
    ANYA @ sad "E a primeira vez que beijei Chanyi, a culpa quase me matou..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:161
translate ptPT qst_dreamhouse_enter_manor_menu3_7a8f7bab:

    # ANYA @ talk "Till I saw him with *her.*"
    ANYA @ talk "Até que o vi com *ela.*"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:162
translate ptPT qst_dreamhouse_enter_manor_menu3_e621970b:

    # MC @ think "Your husband was having an affair?"
    MC @ think "Seu marido estava tendo um caso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:163
translate ptPT qst_dreamhouse_enter_manor_menu3_7c5fc914:

    # ANYA @ talk "I don't know."
    ANYA @ talk "Eu não sei."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:164
translate ptPT qst_dreamhouse_enter_manor_menu3_8227f847:

    # MC @ think "Then I don't understand..."
    MC @ think "Então eu não entendo..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:165
translate ptPT qst_dreamhouse_enter_manor_menu3_a69bd54e:

    # ANYA @ talk "She was an inquisitor like him. The two of them were smiling and laughing."
    ANYA @ talk "Ela era uma inquisidora como ele. Os dois estavam sorrindo e rindo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:166
translate ptPT qst_dreamhouse_enter_manor_menu3_be299f41:

    # ANYA @ talk "They looked at each other the way we used to look, and I understood. He was lonely too."
    ANYA @ talk "Eles se olhavam da mesma forma que costumávamos olhar, e eu entendi. Ele também estava sozinho."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:167
translate ptPT qst_dreamhouse_enter_manor_menu3_6d21daf7:

    # ANYA @ talk "No one was happy, so I decided to do the only thing I could... I left."
    ANYA @ talk "Ninguém estava feliz, então eu decidi fazer a única coisa que podia... Eu fui embora."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:168
translate ptPT qst_dreamhouse_enter_manor_menu3_d35928b2:

    # MC @ talk "I take it your husband didn't take well to the news."
    MC @ talk "Presumo que o seu marido não tenha reagido bem à notícia."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:169
translate ptPT qst_dreamhouse_enter_manor_menu3_82b833a6:

    # CHANYI @ talk "Neither did her cunt of a family."
    CHANYI @ talk "Nem a família de merda dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:170
translate ptPT qst_dreamhouse_enter_manor_menu3_92ddb07f:

    # CHANYI @ talk "I told them to fuck off too."
    CHANYI @ talk "Eu também lhes disse para irem à merda."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:171
translate ptPT qst_dreamhouse_enter_manor_menu3_e6b5c25a:

    # ANYA @ sad "But that's the full story, alright?"
    ANYA @ sad "Mas essa é a história toda, certo?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:176
translate ptPT qst_dreamhouse_enter_manor_menu3_7177258e:

    # CHANYI @ talk "A servant came to bring her breakfast, only to find the bed empty and a window open."
    CHANYI @ talk "Um servo veio trazer o café da manhã, só para encontrar a cama vazia e uma janela aberta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:177
translate ptPT qst_dreamhouse_enter_manor_menu3_589adbe4:

    # CHANYI @ talk "A note was left on the bed."
    CHANYI @ talk "Um bilhete foi deixado na cama."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:178
translate ptPT qst_dreamhouse_enter_manor_menu3_966c9990:

    # "Lady Chanyi handed me the letter."
    "Lady Chanyi me entregou a carta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:181
translate ptPT qst_dreamhouse_enter_manor_menu3_698d1a8a:

    # CHANYI @ talk "It's her handwriting."
    CHANYI @ talk "É a letra dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:182
translate ptPT qst_dreamhouse_enter_manor_menu3_d0f3753a:

    # MC @ think "And you're certain the father took her?"
    MC @ think "E tem certeza de que foi o pai que a levou?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:183
translate ptPT qst_dreamhouse_enter_manor_menu3_e4764e4c:

    # CHANYI @ talk "Her father visited Hamun two nights before she was taken. He never came to see us, but it's far too much of a coincidence."
    CHANYI @ talk "O pai dela visitou Hamun duas noites antes de ela ser levada. Ele nunca veio nos ver, mas é coincidência demais."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:184
translate ptPT qst_dreamhouse_enter_manor_menu3_08bbda20:

    # CHANYI @ talk "Find her father, and you will find our daughter."
    CHANYI @ talk "Encontre o pai dela, e você encontrará nossa filha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:185
translate ptPT qst_dreamhouse_enter_manor_menu3_24c4a8ef:

    # MC @ talk "... And what's in it for me?"
    MC @ talk "... E o que eu ganho com isso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:186
translate ptPT qst_dreamhouse_enter_manor_menu3_9c59ac09:

    # MC @ talk "I *am* a sellsword after all."
    MC @ talk "Eu *sou* um mercenário, afinal."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:187
translate ptPT qst_dreamhouse_enter_manor_menu3_e14a7728:

    # ANYA @ talk "W-We can pay you a lot of coin, or—"
    ANYA @ talk "N-Nós podemos te pagar muitas moedas, ou—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:188
translate ptPT qst_dreamhouse_enter_manor_menu3_8341995f:

    # CHANYI @ talk "Ass."
    CHANYI @ talk "Babaca."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:190
translate ptPT qst_dreamhouse_enter_manor_menu3_91b77494:

    # ANYA @ emb "C-CHANYI!"
    ANYA @ emb "C-CHANYI!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:191
translate ptPT qst_dreamhouse_enter_manor_menu3_4ec4f932:

    # CHANYI @ talk "What? It would not be the first time we took a man to join us in our bed."
    CHANYI @ talk "O quê? Não seria a primeira vez que levamos um homem para se juntar a nós na nossa cama."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:192
translate ptPT qst_dreamhouse_enter_manor_menu3_5d1495e5:

    # "Chanyi's eyes wandered over me lustfully."
    "Os olhos de Chanyi percorreram meu corpo com luxúria."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:193
translate ptPT qst_dreamhouse_enter_manor_menu3_6f97690d:

    # CHANYI @ laugh "Given the amount of women swooning over you since your little performance at the arena..."
    CHANYI @ laugh "Dada a quantidade de mulheres suspirando por você desde sua pequena apresentação na arena..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:194
translate ptPT qst_dreamhouse_enter_manor_menu3_716cdc6c:

    # CHANYI @ laugh "Well, I do like us being the envy of this city..."
    CHANYI @ laugh "Bem, eu realmente gosto de sermos a inveja desta cidade..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:195
translate ptPT qst_dreamhouse_enter_manor_menu3_0ab6e7cc:

    # MC @ think "So, a night with you two or coin?"
    MC @ think "Então, uma noite com vocês dois ou dinheiro?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:196
translate ptPT qst_dreamhouse_enter_manor_menu3_1bd0b4ad:

    # CHANYI @ laugh "Oh, it's more than just a night we want."
    CHANYI @ laugh "Ah, é mais do que apenas uma noite que queremos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:197
translate ptPT qst_dreamhouse_enter_manor_menu3_8825479f:

    # CHANYI @ laugh "Myself and Anya discussed bringing in a more 'regular' toy for our amusement."
    CHANYI @ laugh "Eu e Anya discutimos trazer um brinquedo mais 'regular' para nossa diversão."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:198
translate ptPT qst_dreamhouse_enter_manor_menu3_68eb11f2:

    # CHANYI @ talk "So, here's the choice."
    CHANYI @ talk "Então, aqui está a escolha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:199
translate ptPT qst_dreamhouse_enter_manor_menu3_86b1224e:

    # CHANYI @ talk "Either we'll pay you five thousand coins and gift you something extra as a *gift.*"
    CHANYI @ talk "Ou pagaremos a você cinco mil moedas e lhe daremos algo extra como um *presente.*"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:200
translate ptPT qst_dreamhouse_enter_manor_menu3_bfb259f2:

    # "Chanyi's tail swished from side to side as she smirked."
    "A cauda de Chanyi balançava de um lado para o outro enquanto ela sorria maliciosamente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:201
translate ptPT qst_dreamhouse_enter_manor_menu3_8e028f8b:

    # CHANYI @ laugh "Orrrr we could take you as our toy lover."
    CHANYI @ laugh "Ouuuu podemos te tomar como nosso amante de brinquedo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:202
translate ptPT qst_dreamhouse_enter_manor_menu3_25b974f4:

    # "Anya's cheeks burned bright red."
    "As bochechas de Anya queimaram de vermelho intenso."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:203
translate ptPT qst_dreamhouse_enter_manor_menu3_fdd0874f:

    # CHANYI @ think "So, what will it be?"
    CHANYI @ think "Então, qual será?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:207
translate ptPT qst_dreamhouse_enter_manor_menu3_92b23448:

    # CHANYI @ talk "Hm... Can't say I'm not a little disappointed."
    CHANYI @ talk "Hm... Não posso dizer que não estou um pouco desapontado."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:208
translate ptPT qst_dreamhouse_enter_manor_menu3_6da1472d:

    # CHANYI @ talk "Very well, though."
    CHANYI @ talk "Muito bem, no entanto."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:211
translate ptPT qst_dreamhouse_enter_manor_menu3_338674fc:

    # CHANYI @ laugh "See, Anya?"
    CHANYI @ laugh "Está vendo, Anya?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:212
translate ptPT qst_dreamhouse_enter_manor_menu3_2d73b8f6:

    # CHANYI @ laugh "Of course he was going to pick the fun choice."
    CHANYI @ laugh "Claro que ele ia escolher a opção divertida."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:213
translate ptPT qst_dreamhouse_enter_manor_menu3_ff770ce0:

    # CHANYI @ talk "Now go find our daughter."
    CHANYI @ talk "Agora vá encontrar nossa filha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:216
translate ptPT qst_dreamhouse_enter_manor_menu3_b8955a1b:

    # CHANYI @ talk "Her father was last seen visiting the Hamun library... I suggest you start there."
    CHANYI @ talk "O pai dela foi visto pela última vez visitando a biblioteca Hamun... Sugiro que comece por lá."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:228
translate ptPT qst_dreamhouse_enter_manor_menu3_1eef34a0:

    # SYPHA @ happy "I have some rope if you're interested."
    SYPHA @ happy "Tenho um pouco de corda, se estiver interessado."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:229
translate ptPT qst_dreamhouse_enter_manor_menu3_e79f9605:

    # SYPHA @ happy "Personally, I prefer Chaniya. I imagine it'll be more fun breaking her in."
    SYPHA @ happy "Pessoalmente, prefiro Chaniya. Imagino que será mais divertido domá-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:232
translate ptPT qst_dreamhouse_enter_manor_menu3_1a4fd4fd:

    # KIARA @ sad "..."
    KIARA @ sad "..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:233
translate ptPT qst_dreamhouse_enter_manor_menu3_85b7ba28:

    # SYPHA @ talk "Stop pouting."
    SYPHA @ talk "Pare de fazer beicinho."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:234
translate ptPT qst_dreamhouse_enter_manor_menu3_974ba9ca:

    # SYPHA @ talk "If you're jealous, just kill the whores and fuck him."
    SYPHA @ talk "Se você está com ciúmes, simplesmente mate as putas e foda ele."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:235
translate ptPT qst_dreamhouse_enter_manor_menu3_0dc1f9e5:

    # KIARA @ angry "M-Mistress!"
    KIARA @ angry "M-Mestra!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:236
translate ptPT qst_dreamhouse_enter_manor_menu3_74be9eed:

    # MC @ angry "No, no killing."
    MC @ angry "Não, nada de matar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:237
translate ptPT qst_dreamhouse_enter_manor_menu3_5b77b986:

    # SYPHA @ talk "Then tie them up and assert yourself as their master."
    SYPHA @ talk "Então amarre-as e imponha-se como mestre delas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:238
translate ptPT qst_dreamhouse_enter_manor_menu3_6771b044:

    # SYPHA @ think "You Alderians... so indecisive!"
    SYPHA @ think "Vocês Alderianos... tão indecisos!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:241
translate ptPT qst_dreamhouse_enter_manor_menu3_90c44513:

    # SYPHA @ sad "Boo. Those two were a delightful treat."
    SYPHA @ sad "Buu. Aquelas duas foram uma delícia."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:242
translate ptPT qst_dreamhouse_enter_manor_menu3_6d8fbb23:

    # SYPHA @ sad "They would have made delightful lesser concubines."
    SYPHA @ sad "Elas teriam sido deliciosas concubinas inferiores."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:246
translate ptPT qst_dreamhouse_enter_manor_menu3_4d3340cb:

    # VES @ angry "He does not need more women!"
    VES @ angry "Ele não precisa de mais mulheres!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:247
translate ptPT qst_dreamhouse_enter_manor_menu3_4f2f7859:

    # VES @ blush "Having to share him with you is more than enough!"
    VES @ blush "Ter que dividi-lo com você já é mais do que suficiente!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:248
translate ptPT qst_dreamhouse_enter_manor_menu3_dae2bb76:

    # SYPHA @ happy "You just don't appreciate the fun of all the mind games to be had."
    SYPHA @ happy "Você só não aprecia a diversão de todos os jogos mentais que existem."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:249
translate ptPT qst_dreamhouse_enter_manor_menu3_b3e5f013:

    # SYPHA @ happy "... And if you get bored of them, you can always just poison them."
    SYPHA @ happy "... E se você se cansar delas, sempre pode envenená-las."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:250
translate ptPT qst_dreamhouse_enter_manor_menu3_5339ed43:

    # VES @ angry "Careful, Demorai. I may just slip some of that poison in your drink while I'm at it!"
    VES @ angry "Cuidado, Demorai. Posso acabar colocando um pouco desse veneno na sua bebida enquanto estou nisso!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:251
translate ptPT qst_dreamhouse_enter_manor_menu3_fbff7415:

    # SYPHA @ happy "Flirting will get you everywhere with me."
    SYPHA @ happy "Flertar vai te levar longe comigo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:257
translate ptPT qst_dreamhouse_numa_talk_b52c8f90:

    # NUMA @ talk "Hm?"
    NUMA @ talk "Hum?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:258
translate ptPT qst_dreamhouse_numa_talk_888a972e:

    # NUMA @ talk "Now that you mention it, an inquisitor did come by here about a month ago."
    NUMA @ talk "Agora que você menciona, um inquisidor passou por aqui há cerca de um mês."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:261
translate ptPT qst_dreamhouse_numa_talk_menu_ada96b9b:

    # NUMA @ talk "Not that I can remember..."
    NUMA @ talk "Não que eu me lembre..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:262
translate ptPT qst_dreamhouse_numa_talk_menu_2e4d787a:

    # NUMA @ talk "Though it was a while ago."
    NUMA @ talk "Embora tenha sido há um tempo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:266
translate ptPT qst_dreamhouse_numa_talk_menu_63867335:

    # NUMA @ talk "I can't quite remember."
    NUMA @ talk "Não consigo me lembrar bem."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:267
translate ptPT qst_dreamhouse_numa_talk_menu_b043dfff:

    # NUMA @ think "I remember him being particularly interested in texts about dreams and dark magecraft."
    NUMA @ think "Lembro que ele estava particularmente interessado em textos sobre sonhos e magia das trevas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:270
translate ptPT qst_dreamhouse_numa_talk_menu2_5c657e14:

    # NUMA @ talk "In general, yes."
    NUMA @ talk "Em geral, sim."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:271
translate ptPT qst_dreamhouse_numa_talk_menu2_821d0b7c:

    # NUMA @ talk "But this is the Free City, and the Inquisition doesn't have the same authority here as in the rest of Alderay."
    NUMA @ talk "Mas esta é a Cidade Livre, e a Inquisição não tem a mesma autoridade aqui como no resto de Alderay."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:272
translate ptPT qst_dreamhouse_numa_talk_menu2_316d271f:

    # "Numa shrugged."
    "Numa deu de ombros."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:273
translate ptPT qst_dreamhouse_numa_talk_menu2_bd5733ac:

    # NUMA @ talk "Unless a dark mage is particularly troublesome, the merchant lords are unlikely to pursue the matter."
    NUMA @ talk "A menos que um mago das trevas seja particularmente problemático, é improvável que os senhores mercadores deem continuidade ao assunto."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:276
translate ptPT qst_dreamhouse_numa_talk_menu2_fcc181bd:

    # NUMA @ talk "I don't know. He kept asking all manner of strange questions."
    NUMA @ talk "Eu não sei. Ele continuava fazendo todo tipo de perguntas estranhas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:277
translate ptPT qst_dreamhouse_numa_talk_menu2_36bdc973:

    # NUMA @ talk "Something about peering beyond the veil."
    NUMA @ talk "Algo sobre espiar além do véu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:278
translate ptPT qst_dreamhouse_numa_talk_menu2_ae7b26bf:

    # NUMA @ talk "To be quite frank, I find talking to most inquisitors distasteful."
    NUMA @ talk "Para ser bem franco, acho desagradável conversar com a maioria dos inquisidores."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:279
translate ptPT qst_dreamhouse_numa_talk_menu2_b8a87335:

    # NUMA @ angry "Most of them are borderline more mad than the supposed dark mages they claim to hate."
    NUMA @ angry "A maioria deles é quase mais louca do que os supostos magos das trevas que afirmam odiar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:283
translate ptPT qst_dreamhouse_numa_talk_menu2_b6e91710:

    # NUMA @ talk "No, but..."
    NUMA @ talk "Não, mas..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:284
translate ptPT qst_dreamhouse_numa_talk_menu2_b75f5bf2:

    # NUMA @ talk "He had a strange companion."
    NUMA @ talk "Ele tinha um companheiro estranho."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:285
translate ptPT qst_dreamhouse_numa_talk_menu2_5cc5872a:

    # NUMA @ angry "A mage who reeked of death."
    NUMA @ angry "Um mago que cheirava a morte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:286
translate ptPT qst_dreamhouse_numa_talk_menu2_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "O quê?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:287
translate ptPT qst_dreamhouse_numa_talk_menu2_b8a26ee0:

    # MC @ think "A dark mage and an inquisitor..."
    MC @ think "Um mago das trevas e um inquisidor..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:288
translate ptPT qst_dreamhouse_numa_talk_menu2_7d277977:

    # MC @ think "{i}Together?{/i}"
    MC @ think "{i}Juntos?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:289
translate ptPT qst_dreamhouse_numa_talk_menu2_344bb29f:

    # SYPHA @ happy "Oooh! The intrigue!"
    SYPHA @ happy "Oooh! A intriga!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:290
translate ptPT qst_dreamhouse_numa_talk_menu2_8f336829:

    # SYPHA @ happy "What a delightful mystery this is becoming!"
    SYPHA @ happy "Que mistério encantador isso está se tornando!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:291
translate ptPT qst_dreamhouse_numa_talk_menu2_1472fb5f:

    # MC @ think "What is it they were interested in? Just books?"
    MC @ think "Em que eles estavam interessados? Apenas livros?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:292
translate ptPT qst_dreamhouse_numa_talk_menu2_3ee7d130:

    # NUMA @ think "No, he mentioned he was looking to recruit some sellswords to his service."
    NUMA @ think "Não, ele mencionou que estava procurando recrutar alguns mercenários para seu serviço."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:293
translate ptPT qst_dreamhouse_numa_talk_menu2_35019590:

    # NUMA @ talk "Perhaps it might be worth asking around?"
    NUMA @ talk "Talvez valha a pena perguntar por aí?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:294
translate ptPT qst_dreamhouse_numa_talk_menu2_2006ca11:

    # NUMA @ think "Whatever he was planning, he'd likely need to stock up on supplies for it."
    NUMA @ think "O que quer que ele estivesse planejando, ele provavelmente precisaria estocar suprimentos para isso."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:295
translate ptPT qst_dreamhouse_numa_talk_menu2_0a2ee6a0:

    # NUMA @ talk "Anyway, that is all I know on the matter."
    NUMA @ talk "De qualquer forma, isso é tudo o que sei sobre o assunto."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:302
translate ptPT qst_dreamhouse_talk_katiya_a3464295:

    # KATIYA @ shock "Yes! How did you know?"
    KATIYA @ shock "Sim! Como você sabia?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:303
translate ptPT qst_dreamhouse_talk_katiya_ccbb11c4:

    # MC @ talk "Did he say what he was doing?"
    MC @ talk "Ele disse o que estava fazendo?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:304
translate ptPT qst_dreamhouse_talk_katiya_14a11cc5:

    # KATIYA @ talk "I try not to ask too much when it comes to inquisitors."
    KATIYA @ talk "Tento não perguntar muito quando se trata de inquisidores."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:305
translate ptPT qst_dreamhouse_talk_katiya_3fdaa08c:

    # KATIYA @ think "But... he did place a large order for general supplies."
    KATIYA @ think "Mas... ele fez um grande pedido de suprimentos gerais."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:306
translate ptPT qst_dreamhouse_talk_katiya_5738ea83:

    # KATIYA @ talk "Food, potions, and even asked me to procure horses."
    KATIYA @ talk "Comida, poções, e até me pediu para conseguir cavalos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:307
translate ptPT qst_dreamhouse_talk_katiya_9cda5238:

    # MC @ think "Did he say where he was staying in Hamun?"
    MC @ think "Ele disse onde estava hospedado em Hamun?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:308
translate ptPT qst_dreamhouse_talk_katiya_5d6d0ed7:

    # KATIYA @ think "No. In fact, I'm pretty sure he's long left the city by now."
    KATIYA @ think "Não. Na verdade, tenho certeza de que ele já deixou a cidade há muito tempo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:309
translate ptPT qst_dreamhouse_talk_katiya_7295fc09:

    # MC @ angry "(Damn it.)"
    MC @ angry "(Droga!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:310
translate ptPT qst_dreamhouse_talk_katiya_ab1c2c98:

    # KATIYA @ think "{i}Buttttt...{/i}"
    KATIYA @ think "{i}Masssss...{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:311
translate ptPT qst_dreamhouse_talk_katiya_6faf311e:

    # KATIYA @ talk "He placed an order for me to deliver by wagon to {i}this{/i} location."
    KATIYA @ talk "Ele fez um pedido para eu entregar de carroça para {i}este{/i} local."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:312
translate ptPT qst_dreamhouse_talk_katiya_09da2d23:

    # KATIYA @ sad "I sent the wagon, but neither it nor the driver have returned."
    KATIYA @ sad "Enviei a carroça, mas nem ela nem o condutor retornaram."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:313
translate ptPT qst_dreamhouse_talk_katiya_5b27a447:

    # KATIYA @ talk "If you promise to return my wagon and my man to me, should he still be alive, I will give you the location."
    KATIYA @ talk "Se você prometer devolver minha carroça e meu homem para mim, caso ele ainda esteja vivo, eu lhe darei a localização."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:318
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_23b6032e:

    # KATIYA @ think "What do you want?"
    KATIYA @ think "O que você quer?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:321
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_1e9af1fb:

    # KATIYA @ think "Really?"
    KATIYA @ think "Sério?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:322
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_0ebb14c4:

    # KATIYA @ talk "{i}*Sigh*{/i} Very well, pervert, as you wish."
    KATIYA @ talk "{i}*Suspiro*{/i} Muito bem, pervertido, como quiser."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:326
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_6a75b523:

    # KATIYA @ think "Five percent."
    KATIYA @ think "Cinco por cento."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:327
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_c6c3d43d:

    # MC @ talk "Ten percent."
    MC @ talk "Dez por cento."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:328
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_9579a7fb:

    # KATIYA @ talk "Hmm... Very well, I will give you a ten percent discount on all goods from now on."
    KATIYA @ talk "Hmm... Muito bem, vou lhe dar um desconto de dez por cento em todas as mercadorias de agora em diante."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:332
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_80a75cf1:

    # KATIYA @ think "Hmmm... I don't have much spare stock lying around."
    KATIYA @ think "Hmmm... Não tenho muito estoque extra sobrando."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:333
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_df3bf324:

    # KATIYA @ talk "But I do have some of these goblin stimulants I bought from a merchant recently."
    KATIYA @ talk "Mas eu tenho alguns destes estimulantes de goblin que comprei de um mercador recentemente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:334
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_f9e763d7:

    # KATIYA @ happy "I think they will be of great use to you."
    KATIYA @ happy "Acho que serão de grande utilidade para você."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:344
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_3c794f79:

    # KATIYA @ happy "Perfect."
    KATIYA @ happy "Perfeito."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:345
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_e9b06e7c:

    # KATIYA @ talk "Here, it's far, but..."
    KATIYA @ talk "Aqui, é longe, mas..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:346
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_aca27f39:

    # KATIYA @ talk "This is where he ordered the supply wagon to."
    KATIYA @ talk "É aqui que ele mandou a carroça de suprimentos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:355
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_4295e5b6:

    # KATIYA @ sad "Well... my wagon is still missing, so..."
    KATIYA @ sad "Bem... minha carroça ainda está desaparecida, então..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:356
translate ptPT qst_dreamhouse_talk_katiya_wagonmenu_72d1795d:

    # KATIYA @ sad "Let me know if you change your mind, I suppose."
    KATIYA @ sad "Avise-me se mudar de ideia, suponho."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:360
translate ptPT qst_dreamhouse_katiya_rep_3ee09630:

    # KATIYA @ think "Well?"
    KATIYA @ think "Bem?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:368
translate ptPT qst_dreamhouse_after_katiya_970e8fed:

    # "As I left the store, a man, shrouded in robes, moved closer towards me."
    "Ao sair da loja, um homem, envolto em túnicas, aproximou-se de mim."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:369
translate ptPT qst_dreamhouse_after_katiya_337feb6d:

    # "Instinctively, I reached for my blade, but he raised his hand defensively."
    "Instintivamente, levei a mão à minha lâmina, mas ele ergueu a mão defensivamente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:370
translate ptPT qst_dreamhouse_after_katiya_3ae215c6:

    # UNKNOWN "Hold, sir knight."
    UNKNOWN "Alto, senhor cavaleiro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:371
translate ptPT qst_dreamhouse_after_katiya_27c2def6:

    # MC @ angry "What is this about?"
    MC @ angry "Do que se trata?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:372
translate ptPT qst_dreamhouse_after_katiya_cb5766dd:

    # UNKNOWN "I know the Faymore women have sent you to try and recover their daughter."
    UNKNOWN "Sei que as mulheres Faymore te enviaram para tentar recuperar a filha delas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:373
translate ptPT qst_dreamhouse_after_katiya_54069cd9:

    # UNKNOWN "... Don't."
    UNKNOWN "... Não."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:374
translate ptPT qst_dreamhouse_after_katiya_ad135d3e:

    # UNKNOWN "Abandon this quest, for everyone's sake."
    UNKNOWN "Abandone esta missão, pelo bem de todos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:375
translate ptPT qst_dreamhouse_after_katiya_095511c3:

    # MC @ angry "Explain yourself."
    MC @ angry "Explique-se."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:376
translate ptPT qst_dreamhouse_after_katiya_e4b8151a:

    # UNKNOWN "The girl, her gift... Her curse."
    UNKNOWN "A garota, seu dom... Sua maldição."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:377
translate ptPT qst_dreamhouse_after_katiya_a2036a8f:

    # UNKNOWN "Her parents do not know what horrors they will unleash."
    UNKNOWN "Os pais dela não sabem que horrores vão desencadear."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:378
translate ptPT qst_dreamhouse_after_katiya_9c03b932:

    # UNKNOWN "Do not come for her."
    UNKNOWN "Não venha buscá-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:381
translate ptPT qst_dreamhouse_after_katiya_cac33baa:

    # "In a moment, the man dissolved away into a flurry of crows that screeched and flew off as his voice whispered one last time."
    "Num instante, o homem se dissolveu em um bando de corvos que grasnaram e voaram para longe enquanto sua voz sussurrou uma última vez."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:382
translate ptPT qst_dreamhouse_after_katiya_0b78f89c:

    # UNKNOWN "{i}Do not come...{/i}"
    UNKNOWN "{i}Não venha...{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:385
translate ptPT qst_dreamhouse_after_katiya_34242efd:

    # MC @ surprised "What foul magecraft was that?!"
    MC @ surprised "Que bruxaria abominável foi essa?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:388
translate ptPT qst_dreamhouse_after_katiya_e7e9914a:

    # KIARA @ think "If there is one thing I have learned from my brief time with the Demorai,"
    KIARA @ think "Se há uma coisa que aprendi em meu breve tempo com os Demorai,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:389
translate ptPT qst_dreamhouse_after_katiya_6f4feda5:

    # KIARA @ think "it is that there is a sea of magecraft we still hardly understand."
    KIARA @ think "é que há um mar de magia que ainda mal compreendemos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:393
translate ptPT qst_dreamhouse_after_katiya_dad4d111:

    # VES @ think "Should we not heed his advice?"
    VES @ think "Não deveríamos dar ouvidos ao conselho dele?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:394
translate ptPT qst_dreamhouse_after_katiya_61a02149:

    # VES @ sad "I have... the strangest feeling we could end up making things worse."
    VES @ sad "Eu tenho... a sensação mais estranha de que podemos acabar piorando as coisas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:396
translate ptPT qst_dreamhouse_after_katiya_891cd8db:

    # SYPHA @ happy "And where's the fun in just giving up?"
    SYPHA @ happy "E qual é a graça em simplesmente desistir?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:397
translate ptPT qst_dreamhouse_after_katiya_06fea809:

    # SYPHA @ happy "Besides, a damsel is in distress, is she not?"
    SYPHA @ happy "Além disso, uma donzela está em perigo, não está?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:398
translate ptPT qst_dreamhouse_after_katiya_812b516a:

    # VES @ talk "Are we sure that is what this is?"
    VES @ talk "Temos certeza de que é isso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:399
translate ptPT qst_dreamhouse_after_katiya_b293a621:

    # VES @ sad "What if... her father really is doing the right thing here?"
    VES @ sad "E se... o pai dela realmente está fazendo a coisa certa aqui?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:400
translate ptPT qst_dreamhouse_after_katiya_8924a84d:

    # SYPHA @ think "Then we will not know until we find out more."
    SYPHA @ think "Então não saberemos até descobrirmos mais."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:401
translate ptPT qst_dreamhouse_after_katiya_76112219:

    # SYPHA @ talk "Trust me, only start making assumptions once you have enough pieces."
    SYPHA @ talk "Confie em mim, só comece a fazer suposições quando tiver peças suficientes."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:402
translate ptPT qst_dreamhouse_after_katiya_d46642ef:

    # SYPHA @ talk "Then you'll know who to plunge your dagger into."
    SYPHA @ talk "Então você saberá em quem cravar sua adaga."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:412
translate ptPT qst_dreamhouse_enter_forest_e3c659ce:

    # MC @ think "... What is this place?"
    MC @ think "... O que é este lugar?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:414
translate ptPT qst_dreamhouse_enter_forest_868e1464:

    # "The house itself seemed painfully out of place."
    "A casa em si parecia dolorosamente fora de lugar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:415
translate ptPT qst_dreamhouse_enter_forest_ee344ad5:

    # "Across the vastness of the forest, its winding trees and lands untouched by man,"
    "Através da vastidão da floresta, suas árvores sinuosas e terras intocadas pelo homem,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:416
translate ptPT qst_dreamhouse_enter_forest_cd867ce0:

    # "here lay a decrepit manor..."
    "aqui jazia uma mansão decrépita..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:417
translate ptPT qst_dreamhouse_enter_forest_c38e57f4:

    # "As though it was plucked out of thin air and slammed onto the ground here without thought or reason."
    "Como se tivesse sido arrancada do nada e atirada ao chão aqui sem pensamento ou razão."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:418
translate ptPT qst_dreamhouse_enter_forest_86c4ecb1:

    # "The earth around it decayed and rotted, as the house itself gave off an eerie, uneasy presence."
    "A terra ao redor dela apodreceu e deteriorou, enquanto a casa em si emanava uma presença sinistra e inquietante."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:423
translate ptPT qst_dreamhouse_enter_forest_6a170834:

    # KIARA @ scared "{i}... It's like the house is staring back at me.{/i}"
    KIARA @ scared "{i}... É como se a casa estivesse me encarando de volta.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:424
translate ptPT qst_dreamhouse_enter_forest_d5056759:

    # MC @ angry "(This place... There's something.)"
    MC @ angry "(Este lugar... Há algo.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:425
translate ptPT qst_dreamhouse_enter_forest_f68f3728:

    # MC @ angry "({i}Off{/i} about it.)"
    MC @ angry "({i}Estranho{/i} nele.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:426
translate ptPT qst_dreamhouse_enter_forest_f8df61e6:

    # SHYAHTAN "(Caution.)"
    SHYAHTAN "(Cuidado.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:435
translate ptPT qst_dreamhouse_enter_house_d574a24f:

    # "As we entered the house, the door bolt locked behind us."
    "Ao entrarmos na casa, o trinco da porta se trancou atrás de nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:439
translate ptPT qst_dreamhouse_enter_house_fbe9feed:

    # "I grabbed at the door, attempting to unlock it, to no avail."
