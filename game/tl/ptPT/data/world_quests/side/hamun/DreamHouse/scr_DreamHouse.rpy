    MC @ smile "(Eu... Uma coroa? Um trono? Quer dizer, não é possível, eu não—)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2652
translate ptPT qst_dreamhouse_final_housescene_cd2a9d8d:

