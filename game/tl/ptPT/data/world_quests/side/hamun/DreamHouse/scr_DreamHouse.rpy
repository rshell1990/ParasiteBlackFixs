translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_9979a58c:

    # "Right?"
    "Certo?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2043
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_2938cfcc:

    # "{i}He said no.{/i}"
    "{i}Ele disse não.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2045
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_9f2a8d42:

    # "The book suddenly burst into flames in my hands!"
    "O livro de repente pegou fogo nas minhas mãos!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2046
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_dbff601d:

    # MC @ surprised "FUCK!"
    MC @ surprised "PORRA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2049
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_8210fe36:

    # "Mother has just told me her friend, the lady with the cat tail, is now also my mommy."
    "Minha mãe acabou de me dizer que sua amiga, a senhora com rabo de gato, agora também é minha mamãe."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2050
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_be1e4a83:

    # "She seems nice, but maybe a little strict."
    "Ela parece legal, mas talvez um pouco rigorosa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2051
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_103805ec:

    # "... But I don't think I need another mother."
    "... Mas acho que não preciso de outra mãe."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2052
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_cda5af69:

    # "I just really miss father."
    "Eu só sinto muita falta do meu pai."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2055
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_f05f2d15:

    # "I see father less and less."
    "Vejo meu pai cada vez menos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2056
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_99c2275b:

    # "It's been months now."
    "Já se passaram meses agora."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2057
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_e03bcff2:

    # "... Maybe he's just never coming back?"
    "... Talvez ele nunca mais volte?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2058
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_382f2858:

    # "Mother is talking about us leaving and heading to live in a place far away."
    "Mãe está a falar de partirmos e irmos viver para um lugar distante."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2059
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_a0bb76e0:

    # "If that happens, will father still visit?"
    "Se isso acontecer, o pai ainda nos visitará?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2060
translate ptPT qst_dreamhouse_l4_library_bookshelf_1_menu_11402407:

    # "{i}... Does he still love me?{/i}"
    "{i}... Será que ele ainda me ama?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2071
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_99cef191:

    # "A man tried to kidnap me tonight. Thankfully, our guards managed to stop him."
    "Um homem tentou raptar-me esta noite. Felizmente, os nossos guardas conseguiram detê-lo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2072
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_5db348b5:

    # "My mothers are terrified, but..."
    "As minhas mães estão aterrorizadas, mas..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2073
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_514db6e3:

    # "I'm more frightened about what I might dream happens tonight."
    "Estou mais assustada com o que posso sonhar esta noite."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2074
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_ca0a8285:

    # "... Between the pages, a green skull key fell out."
    "... Entre as páginas, caiu uma chave de caveira verde."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2078
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_5ac5c20e:

    # "I wish I had more actual friends."
    "Gostava de ter mais amigos verdadeiros."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2079
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_a1157de1:

    # "I mean, the people at the academy are fine,"
    "Quer dizer, as pessoas da academia são legais,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2080
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_e5f52d0d:

    # "but it's all cliques and coin and..."
    "mas é tudo panelinhas e dinheiro e..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2081
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_fa990cff:

    # "No one is friends with anyone, really. It's all just strategic alignments."
    "Ninguém é amigo de ninguém, na verdade. São apenas alinhamentos estratégicos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2082
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_9b223944:

    # "... Fuck, I just wish someone was real for once."
    "... Porra, eu só queria que alguém fosse real pelo menos uma vez."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2085
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_d47f9121:

    # "Father returned with a strange man."
    "Meu pai voltou com um homem estranho."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2086
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_c3456a70:

    # "He said the two of them were going to help me get rid of the nightmares once and for all."
    "Ele disse que os dois iam me ajudar a me livrar dos pesadelos de uma vez por todas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2087
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_4ef80800:

    # "Father... You still remembered me!"
    "Pai... Você ainda se lembrava de mim!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2090
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_b537a0dd:

    # "I had a strange dream tonight. A man, handsome with black hair."
    "Eu tive um sonho estranho esta noite. Um homem, bonito, de cabelo preto."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2091
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_d64178bc:

    # "But he wasn't fully human. Inside of him... there was another soul."
    "Mas ele não era totalmente humano. Dentro dele... havia outra alma."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2092
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_1b253a90:

    # "He swore he would save me, but it's so strange..."
    "Ele jurou que me salvaria, mas é tão estranho..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2093
translate ptPT qst_dreamhouse_l4_library_bookshelf_2_menu_7b0b2236:

    # "I've never even seen this man before in my life?"
    "Eu nunca vi este homem antes na minha vida?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2101
translate ptPT qst_dreamhouse_l4_library_portrait_8ffbc82d:

    # "Why would anyone paint this?"
    "Por que alguém pintaria isso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2121
translate ptPT qst_dreamhouse_l5_start_352f5d88:

    # "As we pushed on once more through the bright light, we found ourselves again in the entrance hallway of the house,"
