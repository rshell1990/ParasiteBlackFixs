translate ptPT qst_dreamhouse_final_housescene_e3c21322:

    # "but certainly quicker than how we had travelled before."
    "mas certamente mais rápida do que como havíamos viajado antes."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2667
translate ptPT qst_dreamhouse_final_housescene_2d453ab3:

    # "When we arrived upon Hamun, I returned the wagon to Katiya."
    "Quando chegamos a Hamun, devolvi a carroça para Katiya."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2673
translate ptPT qst_dreamhouse_final_housescene_23927e6e:

    # KATIYA @ happy "You're alive!"
    KATIYA @ happy "Você está vivo!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2674
translate ptPT qst_dreamhouse_final_housescene_427f3ee1:

    # KATIYA @ talk "I mean, uh... Well done!"
    KATIYA @ talk "Quero dizer, uh... Muito bem!"

