# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2718
translate ptPT qst_dreamhouse_conclusion_serafina_father_ed5b7a7a:

    # "No sooner had I entered the estate's walls than I was beset by a furious Chanyi and a tearful Anya."
    "Mal entrei nas paredes da propriedade, fui assaltado por uma Chanyi furiosa e uma Anya chorosa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2722
translate ptPT qst_dreamhouse_conclusion_serafina_father_c0fe1dc4:

    # CHANYI @ angry "WHERE IS SHE?"
    CHANYI @ angry "ONDE ELA ESTÁ?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2723
translate ptPT qst_dreamhouse_conclusion_serafina_father_12e894c8:

    # CHANYI @ angry "WHERE IS OUR DAUGHTER?"
    CHANYI @ angry "ONDE ESTÁ NOSSA FILHA?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2724
translate ptPT qst_dreamhouse_conclusion_serafina_father_2e4978d6:

    # ANYA @ sad "Serafina wrote us a letter. She said she is safe but is heading to Novaras with her father!"
    ANYA @ sad "Serafina nos escreveu uma carta. Ela disse que está segura, mas está indo para Novaras com o pai dela!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2725
translate ptPT qst_dreamhouse_conclusion_serafina_father_2f62b8e9:

    # MC @ talk "Your daughter is safe."
    MC @ talk "Sua filha está segura."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2726
translate ptPT qst_dreamhouse_conclusion_serafina_father_5f9e5376:

    # MC @ talk "But she is with her father to learn how to—"
    MC @ talk "Mas ela está com o pai dela para aprender como—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2727
translate ptPT qst_dreamhouse_conclusion_serafina_father_37ad2343:

    # "Anya burst into tears, covering her face with her hands."
    "Anya irrompeu em lágrimas, cobrindo o rosto com as mãos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2729
translate ptPT qst_dreamhouse_conclusion_serafina_father_06e1034f:

    # ANYA @ sad "No!"
    ANYA @ sad "Não!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2731
translate ptPT qst_dreamhouse_conclusion_serafina_father_e7d871d8:

    # CHANYI @ angry "You idiot! You were supposed to bring her back to us!"
    CHANYI @ angry "Seu idiota! Era para você trazê-la de volta para nós!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2735
translate ptPT qst_dreamhouse_conclusion_serafina_father_328fc3ae:

    # CHANYI @ angry "FUCK THE INQUISITION!"
    CHANYI @ angry "FODA-SE A INQUISIÇÃO!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2736
translate ptPT qst_dreamhouse_conclusion_serafina_father_09829f3d:

    # CHANYI @ angry "Damn you! It wasn't your choice to make!"
    CHANYI @ angry "Que se dane! Não era escolha sua!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2737
translate ptPT qst_dreamhouse_conclusion_serafina_father_e7da20b9:

    # ANYA @ sad "Chanyi... I..."
    ANYA @ sad "Chanyi... Eu..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2738
translate ptPT qst_dreamhouse_conclusion_serafina_father_23a61086:

    # ANYA @ sad "Maybe it's for the best."
    ANYA @ sad "Talvez seja o melhor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2739
translate ptPT qst_dreamhouse_conclusion_serafina_father_2b5ddd82:

    # CHANYI @ shock "What?!"
    CHANYI @ shock "O quê?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2740
translate ptPT qst_dreamhouse_conclusion_serafina_father_9f79da27:

    # ANYA @ sad "Serafina... She needs... She needs people who can help her, who can—"
    ANYA @ sad "Serafina... Ela precisa... Ela precisa de pessoas que possam ajudá-la, que possam—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2741
translate ptPT qst_dreamhouse_conclusion_serafina_father_99b75564:

    # CHANYI @ angry "It wasn't his choice to make!"
    CHANYI @ angry "Não foi escolha dele!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2745
translate ptPT qst_dreamhouse_conclusion_serafina_father_00599a34:

    # CHANYI @ angry "What was best for her was bringing her back to US!"
    CHANYI @ angry "O que era melhor para ela era trazê-la de volta para NÓS!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2746
translate ptPT qst_dreamhouse_conclusion_serafina_father_d42bf7c2:

    # CHANYI @ angry "Her fucking father is an inquisitor!"
    CHANYI @ angry "O maldito pai dela é um inquisidor!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2747
translate ptPT qst_dreamhouse_conclusion_serafina_father_9b82ec0a:

    # CHANYI @ angry "What if they just decide she's too dangerous to keep alive, hmm?"
    CHANYI @ angry "E se eles simplesmente decidirem que ela é perigosa demais para ser mantida viva, hmm?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2748
translate ptPT qst_dreamhouse_conclusion_serafina_father_f6632a9b:

    # CHANYI @ angry "Or that her powers are tainted by dark magecraft?"
    CHANYI @ angry "Ou que seus poderes estão contaminados pela magia negra?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2750
translate ptPT qst_dreamhouse_conclusion_serafina_father_edb464fc:

    # CHANYI @ angry "WHAT THEN, HMM?"
    CHANYI @ angry "E ENTÃO, HMM?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2751
translate ptPT qst_dreamhouse_conclusion_serafina_father_be3d8041:

    # ANYA @ sad "Chanyi... Please... Please stop."
    ANYA @ sad "Chanyi... Por favor... Por favor, pare."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2754
translate ptPT qst_dreamhouse_conclusion_serafina_father_dba22c89:

    # MC @ sad "I'm sorry, but if you saw what I saw..."
    MC @ sad "Sinto muito, mas se você visse o que eu vi..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2755
translate ptPT qst_dreamhouse_conclusion_serafina_father_b3b7bba7:

    # MC @ sad "you'd understand why her powers need guidance and—"
    MC @ sad "você entenderia por que os poderes dela precisam de orientação e—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2757
translate ptPT qst_dreamhouse_conclusion_serafina_father_e8f8e2a2:

    # CHANYI @ angry "Get out, GET OUT!"
    CHANYI @ angry "Saia, SAIA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2758
translate ptPT qst_dreamhouse_conclusion_serafina_father_0a0dece0:

    # CHANYI @ angry "FUCKING LEAVE US!"
    CHANYI @ angry "SAIAM DAQUI, PORRA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2759
translate ptPT qst_dreamhouse_conclusion_serafina_father_e74343d2:

    # "Grabbing a half bag of coins, Chanyi flung it towards me angrily."
    "Agarrando um saco meio cheio de moedas, Chanyi o arremessou em minha direção com raiva."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2760
translate ptPT qst_dreamhouse_conclusion_serafina_father_e00aed57:

    # CHANYI @ angry "Half pay for half a fucking job!"
    CHANYI @ angry "Metade do pagamento por metade de um trabalho de merda!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2767
translate ptPT qst_dreamhouse_conclusion_serafina_father_f67e5017:

    # MC @ sad "... That could have gone better."
    MC @ sad "... Aquilo poderia ter corrido melhor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2769
translate ptPT qst_dreamhouse_conclusion_serafina_father_f8d932a1:

    # KIARA @ sad "Did you really expect any other reaction from them?"
    KIARA @ sad "Você realmente esperava alguma outra reação deles?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2770
translate ptPT qst_dreamhouse_conclusion_serafina_father_86d91e81:

    # MC @ think "So you think I chose wrong?"
    MC @ think "Então você acha que eu escolhi errado?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2771
translate ptPT qst_dreamhouse_conclusion_serafina_father_3e37dc95:

    # KIARA @ sad "No, just... I don't think they'd ever see it that way."
    KIARA @ sad "Não, é só que... Não acho que eles algum dia veriam as coisas dessa forma."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2773
translate ptPT qst_dreamhouse_conclusion_serafina_father_f560d240:

    # MARKUS @ talk "You made the right call... They mean well, but..."
    MARKUS @ talk "Você tomou a decisão certa... Eles têm boas intenções, mas..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2774
translate ptPT qst_dreamhouse_conclusion_serafina_father_d45fc904:

    # MARKUS @ talk "If she doesn't learn to control that power and get a grip on it, she could become too dangerous."
    MARKUS @ talk "Se ela não aprender a controlar esse poder e a dominá-lo, ela pode se tornar perigosa demais."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2777
translate ptPT qst_dreamhouse_conclusion_serafina_father_9215089c:

    # SYPHA @ sad "With your inquisitors, she may now never fully know what she was capable of."
    SYPHA @ sad "Com seus inquisidores, ela pode agora nunca saber completamente do que era capaz."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2778
translate ptPT qst_dreamhouse_conclusion_serafina_father_0ad7945a:

    # SYPHA @ sad "How... sad."
    SYPHA @ sad "Que... triste."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2779
translate ptPT qst_dreamhouse_conclusion_serafina_father_197454c8:

    # MC @ think "Do you really think another dark mage is what this world needs?"
    MC @ think "Você realmente acha que outro mago das trevas é o que este mundo precisa?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2780
translate ptPT qst_dreamhouse_conclusion_serafina_father_04f63e19:

    # SYPHA @ talk "Are you so sure it doesn't?"
    SYPHA @ talk "Você tem tanta certeza que não?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2783
translate ptPT qst_dreamhouse_conclusion_serafina_father_216065cb:

    # VES @ talk "She's a strong girl."
    VES @ talk "Ela é uma garota forte."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2784
translate ptPT qst_dreamhouse_conclusion_serafina_father_a1a240d6:

    # VES @ smile "I believe whatever path she walks, she will be alright."
    VES @ smile "Eu acredito que, qualquer que seja o caminho que ela trilhar, ela ficará bem."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2796
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_45227697:

    # "Upon entry, the two Faymore women stood beside Serafina, but their eyes were firmly locked onto the dark mage beside her, explaining everything."
    "Ao entrar, as duas mulheres Faymore ficaram ao lado de Serafina, mas seus olhos estavam firmemente fixos no mago das trevas ao lado dela, explicando tudo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2797
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_7e0c1a59:

    # VIRGO "So you see, that is why it is imperative you allow me to continue her—"
    VIRGO "Então, você vê, é por isso que é imperativo que você me permita continuar a—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2799
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_bda4c517:

    # SERAFINA @ smile "[player_name]!"
    SERAFINA @ smile "[player_name]!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2800
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_8688d268:

    # MC @ smile "Serafina."
    MC @ smile "Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2801
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_ed77b680:

    # CHANYI @ talk "This... mage here was explaining everything that has happened."
    CHANYI @ talk "Este... mago aqui estava explicando tudo o que aconteceu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2803
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_5ede04a0:

    # ANYA @ happy "Thank you, thank you, thank you, thank you!"
    ANYA @ happy "Obrigado, obrigado, obrigado, obrigado!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2804
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_16e34a54:

    # ANYA @ happy "You've brought our daughter home!"
    ANYA @ happy "Você trouxe nossa filha de volta!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2805
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_d22bb5ed:

    # "Chanyi smiled as well, but she seemed more... reserved and unsure."
    "Chanyi também sorriu, mas ela parecia mais... reservada e insegura."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2806
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_483c07bc:

    # CHANYI @ serious "So just to be clear, you wish to stay here and tutor our daughter, yes?"
    CHANYI @ serious "Então, só para esclarecer, você deseja ficar aqui e ensinar a nossa filha, sim?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2807
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_d0e7e352:

    # VIRGO "Yes."
    VIRGO "Sim."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2808
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_09d74b6f:

    # CHANYI @ serious "And you are..."
    CHANYI @ serious "E você é..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2809
translate ptPT qst_dreamhouse_conclusion_serafina_virgo_ea9d704a:

    # "She paused for a moment."
    "Ela fez uma pausa por um momento."

