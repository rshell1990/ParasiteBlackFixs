    # "A book literally rots away in my hand as I try to pick it up."
    "Um livro literalmente se desfaz na minha mão enquanto tento pegá-lo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2278
translate ptPT qst_dreamhouse_l5_library_portrait_2280a906:

    # "... Creepy."
    "... Sinistro."

