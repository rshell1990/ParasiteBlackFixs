# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2361
translate ptPT qst_dreamhouse_l5_gator_counter_9bd08993:

    # MARKUS @ angry "FUCK OFF, FUCK OFF, FUCK OFF!"
    MARKUS @ angry "SAI FORA, SAI FORA, SAI FORA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2362
translate ptPT qst_dreamhouse_l5_gator_counter_a41d008e:

    # "Markus furiously struck at the creature, which for a moment seemed like it might limp away."
    "Markus golpeou furiosamente a criatura, que por um momento pareceu que poderia se afastar mancando."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2365
translate ptPT qst_dreamhouse_l5_gator_counter_60cb9149:

    # "With a defiant hiss, he charged towards Markus, knocking him off his feet as he charged straight towards the black water!"
    "Com um silvo desafiador, avançou contra Markus, derrubando-o de seus pés enquanto investia direto para a água negra!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2367
translate ptPT qst_dreamhouse_l5_gator_counter_7994b0d4:

    # MC @ angry "MARKUSSSS!"
    MC @ angry "MARKUSSS!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2370
translate ptPT qst_dreamhouse_l5_gator_counter_8b156072:

    # "Markus struggled as a tremendous splash erupted in the black waters... and then... nothing."
    "Markus se debateu enquanto um tremendo respingo irrompia nas águas negras... e então... nada."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2372
translate ptPT qst_dreamhouse_l5_gator_counter_e0a46523:

    # MC @ scared "(Markus...)"
    MC @ scared "(Marcos...)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2373
translate ptPT qst_dreamhouse_l5_gator_counter_4501d554:

    # MC @ scared "(Don't you dare die on me!)"
    MC @ scared "(Não se atreva a morrer!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2377
translate ptPT qst_dreamhouse_l5_gator_counter_6cb5ad6b:

    # "The creature whined as it retreated and lowered itself for a moment."
    "A criatura gemeu ao recuar e se abaixar por um momento."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2378
translate ptPT qst_dreamhouse_l5_gator_counter_3593dc7f:

    # SYPHA @ happy "Ha! How pitiful!"
    SYPHA @ happy "Ha! Que patético!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2379
translate ptPT qst_dreamhouse_l5_gator_counter_3d65ee80:

    # SYPHA @ happy "Starting a fight and then cowering when you realize you can't even fin-"
    SYPHA @ happy "Começar uma briga e depois se acovardar quando percebe que nem consegue termi-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2380
translate ptPT qst_dreamhouse_l5_gator_counter_e55af38e:

    # "Suddenly, the gator flung itself forward!"
    "De repente, o jacaré se lançou para frente!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2382
translate ptPT qst_dreamhouse_l5_gator_counter_389542a0:

    # SYPHA @ shock "{i}*Gasp!*{/i}"
    SYPHA @ shock "{i}*Suspiro!*{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2384
translate ptPT qst_dreamhouse_l5_gator_counter_4a80e501:

    # "Before she could react, she and the gator were rolling across the ground as she struggled against it."
    "Antes que ela pudesse reagir, ela e o jacaré estavam rolando pelo chão enquanto ela lutava contra ele."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2385
translate ptPT qst_dreamhouse_l5_gator_counter_771b87c2:

    # SYPHA "GET OFF OF ME!"
    SYPHA "SAI DE CIMA DE MIM!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2388
translate ptPT qst_dreamhouse_l5_gator_counter_d2e90b4a:

    # "I hurried to help her, but before I knew it, the creature had dragged her beneath the black waters... and there was only silence."
    "Eu corri para ajudá-la, mas antes que eu percebesse, a criatura a havia arrastado para baixo das águas negras... e só havia silêncio."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2391
translate ptPT qst_dreamhouse_l5_gator_counter_0d09bc89:

    # MC @ surprised "SYPHA!"
    MC @ surprised "SIFHA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2395
translate ptPT qst_dreamhouse_l5_gator_counter_be49b57a:

    # "The creature snarled, desperately charging towards us."
    "A criatura rosnou, investindo desesperadamente em nossa direção."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2397
translate ptPT qst_dreamhouse_l5_gator_counter_79b9372a:

    # MC @ surprised "NO!"
    MC @ surprised "NÃO!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2399
translate ptPT qst_dreamhouse_l5_gator_counter_809f4890:

    # "As it dragged another member of my party beneath the black water with a splash, I waited for something... anything... to resurface."
    "Enquanto arrastava outro membro do meu grupo para baixo da água negra com um respingo, esperei por algo... qualquer coisa... ressurgir."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2401
translate ptPT qst_dreamhouse_l5_gator_counter_2ae5d1be:

    # "... But nothing came."
    "... Mas nada veio."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2403
translate ptPT qst_dreamhouse_l5_gator_counter_b00e6915:

    # MC @ surprised "Where did they go?!"
    MC @ surprised "Para onde eles foram?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2404
translate ptPT qst_dreamhouse_l5_gator_counter_7961cb75:

    # "The black water calmed as it rippled softly... And then there was silence."
    "A água negra se acalmou enquanto ondulava suavemente... E então houve silêncio."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2414
translate ptPT qst_dreamhouse_final_housescene_88a79f84:

    # "This time, as we pushed through the doorway, we found ourselves, for the first time, not looping back to the entrance hallway,"
    "Desta vez, ao passarmos pela porta, nos encontramos, pela primeira vez, sem voltar ao corredor de entrada,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2415
translate ptPT qst_dreamhouse_final_housescene_8a10ab7f:

    # "but within the master bedroom itself at last... Or at least,"
    "mas dentro do quarto principal em si finalmente... Ou pelo menos,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2416
translate ptPT qst_dreamhouse_final_housescene_7a3da93b:

    # "what I thought was supposed to be the master bedroom."
    "o que eu pensei que deveria ser o quarto principal."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2417
translate ptPT qst_dreamhouse_final_housescene_bdc04444:

    # "Looking behind me, I could see everyone was back—dazed and confused, perhaps—but... alive and present."
    "Olhando para trás, pude ver que todos estavam de volta — atordoados e confusos, talvez — mas... vivos e presentes."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2424
translate ptPT qst_dreamhouse_final_housescene_8c5e33ae:

    # "A blonde girl turned to face me as I entered. Stood stoically behind her, an elderly mage watched."
    "Uma garota loira virou-se para me encarar quando entrei. De pé estoicamente atrás dela, um mago idoso observava."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2425
translate ptPT qst_dreamhouse_final_housescene_6a42290d:

    # VIRGO "Ah, good, you made it through."
    VIRGO "Ah, bom, você conseguiu passar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2426
translate ptPT qst_dreamhouse_final_housescene_0ba9a927:

    # SERAFINA @ shock "You..."
    SERAFINA @ shock "Você..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2427
translate ptPT qst_dreamhouse_final_housescene_c9936f06:

    # SERAFINA @ shock "You're the one from my dreams!"
    SERAFINA @ shock "Você é a pessoa dos meus sonhos!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2428
translate ptPT qst_dreamhouse_final_housescene_bde6c2b6:

    # MC @ think "What?"
    MC @ think "O quê?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2429
translate ptPT qst_dreamhouse_final_housescene_d04f2520:

    # VIRGO "Where is Davik? Did he send for you?"
    VIRGO "Onde está Davik? Ele mandou te chamar?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2430
translate ptPT qst_dreamhouse_final_housescene_ab371a2b:

    # MC @ talk "No, we were sent here by the girl's mothers."
    MC @ talk "Não, fomos enviados aqui pelas mães da garota."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2431
translate ptPT qst_dreamhouse_final_housescene_089a5c83:

    # "I raised a brow at the youthful face in front of me."
    "Eu ergui uma sobrancelha para o rosto jovem à minha frente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2432
translate ptPT qst_dreamhouse_final_housescene_f858472b:

    # MC @ think "You're Serafina, I take it?"
    MC @ think "Você é Serafina, presumo?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2433
translate ptPT qst_dreamhouse_final_housescene_bc9fad83:

    # "The girl nodded."
    "A garota assentiu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2434
translate ptPT qst_dreamhouse_final_housescene_92966b94:

    # SERAFINA @ sad "Where is father?"
    SERAFINA @ sad "Onde está o pai?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2435
translate ptPT qst_dreamhouse_final_housescene_94af89f6:

    # SERAFINA @ sad "He went back through the house to gather supplies."
    SERAFINA @ sad "Ele voltou pela casa para pegar suprimentos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2436
translate ptPT qst_dreamhouse_final_housescene_4a3076d3:

    # SERAFINA @ scared "We need him back before {i}it{/i} comes!"
    SERAFINA @ scared "Precisamos que ele volte antes que {i}isso{/i} venha!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2437
translate ptPT qst_dreamhouse_final_housescene_cbeb8405:

    # MC @ think "{i}It?{/i}"
    MC @ think "{i}Isso?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2438
translate ptPT qst_dreamhouse_final_housescene_ce9d8fbd:

    # VIRGO "This house was designed for containment."
    VIRGO "Esta casa foi projetada para contenção."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2439
translate ptPT qst_dreamhouse_final_housescene_e39f9a4f:

    # VIRGO "A place to store and contain her nightmares..."
    VIRGO "Um lugar para armazenar e conter os pesadelos dela..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2440
translate ptPT qst_dreamhouse_final_housescene_b5e226e9:

    # VIRGO "And hopefully, to gain mastery of her powers."
    VIRGO "E, esperançosamente, dominar os poderes dela."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2443
translate ptPT qst_dreamhouse_final_housescene_00884ec5:

    # SYPHA @ talk "You still haven't answered what {i}it{/i} is."
    SYPHA @ talk "Você ainda não respondeu o que {i}isso{/i} é."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2444
translate ptPT qst_dreamhouse_final_housescene_31ab88d3:

    # "Around us, the world seems to bend and crackle, as {i}something{/i} fights its way through."
    "Ao nosso redor, o mundo parece se dobrar e estalar, enquanto {i}algo{/i} luta para atravessar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2445
translate ptPT qst_dreamhouse_final_housescene_fc91cc92:

    # "Serafina's eyes glow purple, bleeding tears streaming down her face as she clutches her head, teeth gritted in pain."
    "Os olhos de Serafina brilham em roxo, lágrimas de sangue escorrendo pelo seu rosto enquanto ela aperta a cabeça, os dentes cerrados de dor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2446
translate ptPT qst_dreamhouse_final_housescene_9bf78591:

    # SERAFINA @ scared "I can't hold it back much longer!"
    SERAFINA @ scared "Não consigo segurar por muito mais tempo!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2447
translate ptPT qst_dreamhouse_final_housescene_91568ef1:

    # VIRGO "The heart of her fears—it has manifested itself as this creature."
    VIRGO "O coração dos medos dela — manifestou-se como esta criatura."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2448
translate ptPT qst_dreamhouse_final_housescene_5e22b05c:

    # VIRGO "And it refuses to stay a prisoner here."
    VIRGO "E se recusa a permanecer prisioneiro aqui."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2450
translate ptPT qst_dreamhouse_final_housescene_7e1a7dc2:

    # "The sky ripples and tears as the creature begins to force its way into this reality."
    "O céu ondula e se rasga quando a criatura começa a forçar sua entrada nesta realidade."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2451
translate ptPT qst_dreamhouse_final_housescene_d233aee6:

    # MC @ serious "What do we do?"
    MC @ serious "O que fazemos?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2452
translate ptPT qst_dreamhouse_final_housescene_1b4a865c:

    # "With a tap of his staff, I felt a surge of energy rush through me!"
    "Com um toque de seu cajado, senti uma onda de energia percorrer meu corpo!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2457
translate ptPT qst_dreamhouse_final_housescene_c3bcd573:

    # VIRGO "Damn it... It seems we can wait no longer for your father, Serafina."
    VIRGO "Droga... Parece que não podemos mais esperar pelo seu pai, Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2458
translate ptPT qst_dreamhouse_final_housescene_400ef679:

    # "The dark mage motioned to all of us."
    "O mago das trevas fez um gesto para todos nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2459
translate ptPT qst_dreamhouse_final_housescene_969edbea:

    # VIRGO "You hold the creature back!"
    VIRGO "Você segura a criatura!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2460
translate ptPT qst_dreamhouse_final_housescene_997a7bc7:

    # VIRGO "{i}I'll seal the rift...{/i}"
    VIRGO "{i}Eu vou selar a fenda...{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2463
translate ptPT qst_dreamhouse_final_housescene_452972d0:

    # MARKUS @ scared "That's..."
    MARKUS @ scared "Isso é..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2464
translate ptPT qst_dreamhouse_final_housescene_660c9d06:

    # MARKUS @ scared "{i}big.{/i}"
    MARKUS @ scared "{i}grande.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2465
translate ptPT qst_dreamhouse_final_housescene_cfccf33a:

    # "Kiara and Sypha readied themselves."
    "Kiara e Sypha se prepararam."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2466
translate ptPT qst_dreamhouse_final_housescene_8cf086f6:

    # SYPHA @ angry "The power radiating from that thing... This won't be easy!"
    SYPHA @ angry "O poder irradiando daquela coisa... Isso não vai ser fácil!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2468
translate ptPT qst_dreamhouse_final_housescene_a81fe26e:

    # "Ves tightened her hands around her axe."
    "Ves apertou as mãos em volta de seu machado."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2469
translate ptPT qst_dreamhouse_final_housescene_998e5eb8:

    # VES @ angry "Let it come!"
    VES @ angry "Que venha!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2470
translate ptPT qst_dreamhouse_final_housescene_3814d0d1:

    # "The sky ripped open, revealing a black void behind it."
    "O céu se rasgou, revelando um vazio negro atrás dele."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2471
translate ptPT qst_dreamhouse_final_housescene_3ce9111e:

    # "Two great, pale hands reached through as the creature's head pushed through the darkness,"
    "Duas mãos grandes e pálidas se estenderam enquanto a cabeça da criatura forçava através da escuridão,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2472
translate ptPT qst_dreamhouse_final_housescene_43dd8aa1:

    # "scowling at us as it opened its mouth to roar!"
    "olhando carrancudo para nós enquanto abria a boca para rugir!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2476
translate ptPT qst_dreamhouse_final_housescene_6d447bc0:

    # MC @ surprised "Here we go!"
    MC @ surprised "Aqui vamos nós!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2477
translate ptPT qst_dreamhouse_final_housescene_786f0070:

    # MC @ angry "ALL AT ONCE!"
    MC @ angry "TODOS DE UMA VEZ!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2481
translate ptPT qst_dreamhouse_final_housescene_cd8088ca:

    # VIRGO "NOW!"
    VIRGO "AGORA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2483
translate ptPT qst_dreamhouse_final_housescene_d1be9a81:

    # "The nightmare creature retreated, pushed back into the darkness from which it tore through."
    "A criatura do pesadelo recuou, empurrada de volta para a escuridão da qual havia irrompido."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2484
translate ptPT qst_dreamhouse_final_housescene_e78b915d:

    # "With trembling hands, Virgo's body was pushed to its aboslute limits, the veins in his arms and temples seeming ready to burst at any moment,"
    "Com mãos trêmulas, o corpo de Virgo foi levado aos seus limites absolutos, as veias em seus braços e têmporas parecendo prestes a estourar a qualquer momento,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2485
translate ptPT qst_dreamhouse_final_housescene_c9ab07b2:

    # "the great tear was slowly sealed shut, until at last, it was gone."
    "a grande fenda foi lentamente selada, até que finalmente desapareceu."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2489
translate ptPT qst_dreamhouse_final_housescene_9d720c32:

    # "Dropping to his knees breathlessly, he looked up towards us."
    "Caindo de joelhos sem fôlego, ele olhou para nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2492
translate ptPT qst_dreamhouse_final_housescene_c1696d9b:

    # VIRGO "Thank you... Your assistance was..."
    VIRGO "Obrigado... Sua assistência foi..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2493
translate ptPT qst_dreamhouse_final_housescene_86502b92:

    # VIRGO "welcomed."
    VIRGO "bem-vinda."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2494
translate ptPT qst_dreamhouse_final_housescene_8599621e:

    # "No sooner had he finished than Davik appeared through the doorway."
    "Mal ele terminou, Davik apareceu na porta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2496
translate ptPT qst_dreamhouse_final_housescene_fa694f5d:

    # DAVIK "Serafina! SERAFINA!"
    DAVIK "Serafina! SERAFINA!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2497
translate ptPT qst_dreamhouse_final_housescene_1f482d17:

    # SERAFINA @ smile "Father!"
    SERAFINA @ smile "Pai!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2498
translate ptPT qst_dreamhouse_final_housescene_af99b283:

    # DAVIK "Are you alright, girl?"
    DAVIK "Você está bem, garota?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2499
translate ptPT qst_dreamhouse_final_housescene_1e866a89:

    # DAVIK "What happened?"
    DAVIK "O que aconteceu?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2500
translate ptPT qst_dreamhouse_final_housescene_8b371310:

    # SERAFINA @ smile "It's alright... Father."
    SERAFINA @ smile "Está tudo bem... Pai."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2501
translate ptPT qst_dreamhouse_final_housescene_b6d8e9f9:

    # SERAFINA @ smile "We did it, we sealed it away!"
    SERAFINA @ smile "Conseguimos, nós o selamos!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2502
translate ptPT qst_dreamhouse_final_housescene_6c3e818e:

    # DAVIK "Thank the gods..."
    DAVIK "Graças aos deuses..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2503
translate ptPT qst_dreamhouse_final_housescene_cfd08e31:

    # "Davik turned towards me."
    "Davik se virou para mim."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2506
translate ptPT qst_dreamhouse_final_housescene_33c95ccd:

    # DAVIK "You have my eternal thanks for helping save my daughter."
    DAVIK "Você tem a minha eterna gratidão por ajudar a salvar minha filha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2509
translate ptPT qst_dreamhouse_final_housescene_c7d70e1d:

    # DAVIK "Come, Serafina, let's go..."
    DAVIK "Venha, Serafina, vamos..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2510
translate ptPT qst_dreamhouse_final_housescene_e9b40ebe:

    # MC @ think "Wait, hold for a moment."
    MC @ think "Espere, aguarde um momento."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2511
translate ptPT qst_dreamhouse_final_housescene_3f368aa9:

    # MC @ talk "I've been ordered to bring Serafina back to her mother."
    MC @ talk "Recebi ordens para trazer Serafina de volta para sua mãe."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2514
translate ptPT qst_dreamhouse_final_housescene_3553ec16:

    # DAVIK "You must think me a fool to just hand her back over!"
    DAVIK "Você deve me achar um tolo para simplesmente entregá-la de volta!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2515
translate ptPT qst_dreamhouse_final_housescene_33a83dce:

    # DAVIK "Not after all these years!"
    DAVIK "Não depois de todos esses anos!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2516
translate ptPT qst_dreamhouse_final_housescene_f6b52ec0:

    # VIRGO "WAIT!"
    VIRGO "ESPERE!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2517
translate ptPT qst_dreamhouse_final_housescene_7d375837:

    # VIRGO "Both of you..."
    VIRGO "Vocês dois..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2520
translate ptPT qst_dreamhouse_final_housescene_2e1f113b:

    # "Slowly, the dark mage rose back to his feet."
    "Lentamente, o mago das trevas se levantou novamente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2521
translate ptPT qst_dreamhouse_final_housescene_39f0c626:

    # VIRGO "Bring the girl back to her mothers and let me take the girl as an apprentice."
    VIRGO "Traga a garota de volta para suas mães e deixe-me levar a garota como aprendiz."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2522
translate ptPT qst_dreamhouse_final_housescene_56420d6a:

    # DAVIK "ARE YOU INSANE?"
    DAVIK "VOCÊ ESTÁ LOUCO?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2523
translate ptPT qst_dreamhouse_final_housescene_28cb88a0:

    # DAVIK "Your vile services were hired just to help me protect MY daughter!"
    DAVIK "Seus serviços vis foram contratados apenas para me ajudar a proteger MINHA filha!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2524
translate ptPT qst_dreamhouse_final_housescene_d926361c:

    # DAVIK "I'm an inquisitor! You really think I'm going to let a fucking dark mage tutor her?"
    DAVIK "Eu sou um inquisidor! Você realmente acha que vou deixar um maldito mago das trevas ensiná-la?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2525
translate ptPT qst_dreamhouse_final_housescene_f101a247:

    # DAVIK "No! She will come back with me to Novaras. There, she will learn under the Inquisition."
    DAVIK "Não! Ela voltará comigo para Novaras. Lá, ela aprenderá sob a Inquisição."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2526
translate ptPT qst_dreamhouse_final_housescene_442d1d68:

    # VIRGO "Don't be a fool!"
    VIRGO "Não seja tolo!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2527
translate ptPT qst_dreamhouse_final_housescene_bcb28e67:

    # VIRGO "The Inquisition will only leash her!"
    VIRGO "A Inquisição apenas a colocará na coleira!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2528
translate ptPT qst_dreamhouse_final_housescene_56e4b672:

    # VIRGO "Her power is too valuable! With my help, she could learn to master it and turn the tide of this war!"
    VIRGO "O poder dela é valioso demais! Com minha ajuda, ela poderia aprender a dominá-lo e mudar o rumo desta guerra!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2529
translate ptPT qst_dreamhouse_final_housescene_f231572e:

    # SERAFINA @ shock "S-STOP FIGHTING!"
    SERAFINA @ shock "P-PAREM DE LUTAR!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2530
translate ptPT qst_dreamhouse_final_housescene_2c9605f9:

    # SERAFINA @ sad "... You."
    SERAFINA @ sad "... Você."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2531
translate ptPT qst_dreamhouse_final_housescene_3f9d9321:

    # "Serafina's gaze turns towards me."
    "O olhar de Serafina se volta para mim."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2532
translate ptPT qst_dreamhouse_final_housescene_3c96fcdf:

    # SERAFINA @ sad "What do you think I should do?"
    SERAFINA @ sad "O que você acha que eu deveria fazer?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2533
translate ptPT qst_dreamhouse_final_housescene_53426c3f:

    # DAVIK "You can't seriously be—"
    DAVIK "Você não pode estar falando sério—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2534
translate ptPT qst_dreamhouse_final_housescene_417f4d9c:

    # SERAFINA @ talk "I saw him... {i}father.{/i}"
    SERAFINA @ talk "Eu o vi... {i}pai.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2535
translate ptPT qst_dreamhouse_final_housescene_580bfb09:

    # SERAFINA @ talk "In my dreams."
    SERAFINA @ talk "Em meus sonhos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2536
translate ptPT qst_dreamhouse_final_housescene_5241ae73:

    # SERAFINA @ talk "I think he's the one to tell me which way to go!"
    SERAFINA @ talk "Eu acho que é ele quem vai me dizer qual caminho seguir!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2537
translate ptPT qst_dreamhouse_final_housescene_58544e5d:

    # VIRGO "... Interesting."
    VIRGO "... Interessante."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2538
translate ptPT qst_dreamhouse_final_housescene_d5521272:

    # SERAFINA @ talk "So then... What do you think I should do?"
    SERAFINA @ talk "Então... O que você acha que eu deveria fazer?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2543
translate ptPT qst_dreamhouse_final_housescene_706a2cac:

    # SERAFINA @ sad "If... If that is the path you think I should take."
    SERAFINA @ sad "Se... Se esse é o caminho que você acha que eu deveria seguir."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2544
translate ptPT qst_dreamhouse_final_housescene_2deb28e8:

    # SERAFINA @ talk "Father, I'll come with you."
    SERAFINA @ talk "Pai, vou com você."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2545
translate ptPT qst_dreamhouse_final_housescene_91c9e242:

    # VIRGO "Damn fools."
    VIRGO "Malditos tolos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2546
translate ptPT qst_dreamhouse_final_housescene_a3cb29c2:

    # VIRGO "You're wasting your potential with the Inquisition!"
    VIRGO "Você está desperdiçando seu potencial com a Inquisição!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2547
translate ptPT qst_dreamhouse_final_housescene_bd12dc3f:

    # VIRGO "They'll show you the ceiling, but never show you how to break through it!"
    VIRGO "Eles vão te mostrar o teto, mas nunca te mostrarão como ultrapassá-lo!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2548
translate ptPT qst_dreamhouse_final_housescene_341ba180:

    # DAVIK "And that's fine with me!"
    DAVIK "E para mim, está tudo bem!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2549
translate ptPT qst_dreamhouse_final_housescene_4c9801a7:

    # DAVIK "She's my daughter, not a damn weapon!"
    DAVIK "Ela é minha filha, não uma maldita arma!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2550
translate ptPT qst_dreamhouse_final_housescene_c53b35fd:

    # VIRGO "No... Now she's going to become something worse."
    VIRGO "Não... Agora ela vai se tornar algo pior."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2551
translate ptPT qst_dreamhouse_final_housescene_d7f40314:

    # VIRGO "Just a puppet for the Inquisition."
    VIRGO "Apenas uma marionete para a Inquisição."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2552
translate ptPT qst_dreamhouse_final_housescene_a355eb8e:

    # "Davik carefully took his daughter's hand."
    "Davik cuidadosamente pegou a mão de sua filha."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2553
translate ptPT qst_dreamhouse_final_housescene_d65f64a0:

    # DAVIK "Come on, let's leave this place. We have a long journey ahead of us."
    DAVIK "Vamos, vamos embora deste lugar. Temos uma longa jornada pela frente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2556
translate ptPT qst_dreamhouse_final_housescene_de24f820:

    # "Davik turned to me once more, nodding."
    "Davik virou-se para mim mais uma vez, assentindo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2557
translate ptPT qst_dreamhouse_final_housescene_5ef15c38:

    # DAVIK "I promise you, I will repay this debt."
    DAVIK "Prometo a você, retribuirei essa dívida."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2558
translate ptPT qst_dreamhouse_final_housescene_24db7a4b:

    # VIRGO "Tschh...!"
    VIRGO "Tsc...!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2559
translate ptPT qst_dreamhouse_final_housescene_91f28077:

    # SERAFINA @ shock "Wait! Father!"
    SERAFINA @ shock "Espere! Pai!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2562
translate ptPT qst_dreamhouse_final_housescene_326b28e0:

    # SERAFINA @ talk "Before we go..."
    SERAFINA @ talk "Antes de irmos..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2565
translate ptPT qst_dreamhouse_final_housescene_b77e439d:

    # VIRGO "Finally, someone making sense."
    VIRGO "Finalmente, alguém que faz sentido."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2566
translate ptPT qst_dreamhouse_final_housescene_7220859e:

    # DAVIK "You cannot seriously expect me to just let you take—"
    DAVIK "Você não pode esperar seriamente que eu simplesmente deixe você levar—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2567
translate ptPT qst_dreamhouse_final_housescene_684132be:

    # "As he reached for the hilt of his blade, Serafina stepped in to stop him, grabbing at his hands."
    "Quando ele alcançou o punho de sua lâmina, Serafina interveio para detê-lo, agarrando suas mãos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2568
translate ptPT qst_dreamhouse_final_housescene_e883d34b:

    # SERAFINA @ shock "Father! No!"
    SERAFINA @ shock "Pai! Não!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2569
translate ptPT qst_dreamhouse_final_housescene_274b4ace:

    # DAVIK "Serafina, I—"
    DAVIK "Serafina, eu—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2570
translate ptPT qst_dreamhouse_final_housescene_05f887e3:

    # SERAFINA @ sad "He's right, father."
    SERAFINA @ sad "Ele está certo, pai."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2571
translate ptPT qst_dreamhouse_final_housescene_686c395b:

    # SERAFINA @ sad "This power... If I can wield it better, I can do some good."
    SERAFINA @ sad "Este poder... Se eu puder manejá-lo melhor, posso fazer algum bem."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2572
translate ptPT qst_dreamhouse_final_housescene_3993813b:

    # DAVIK "You cannot trust a dark mage, Serafina!"
    DAVIK "Você não pode confiar em um mago das trevas, Serafina!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2573
translate ptPT qst_dreamhouse_final_housescene_5771ca4f:

    # DAVIK "If you walk this path... I... I don't know if I can—"
    DAVIK "Se você seguir por este caminho... Eu... Eu não sei se posso—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2574
translate ptPT qst_dreamhouse_final_housescene_dce16f76:

    # SERAFINA @ sad "Father... {i}I have to do this.{/i}"
    SERAFINA @ sad "Pai... {i}Eu tenho que fazer isso.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2575
translate ptPT qst_dreamhouse_final_housescene_edebb3fa:

    # SERAFINA @ sad "I have to try."
    SERAFINA @ sad "Eu tenho que tentar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2576
translate ptPT qst_dreamhouse_final_housescene_ace00135:

    # DAVIK "..."
    DAVIK "..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2579
translate ptPT qst_dreamhouse_final_housescene_cfd08e31_1:

    # "Davik turned towards me."
    "Davik virou-se para mim."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2580
translate ptPT qst_dreamhouse_final_housescene_d3329b40:

    # DAVIK "I won't forgive you for this."
    DAVIK "Não vou te perdoar por isso."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2583
translate ptPT qst_dreamhouse_final_housescene_504123c6:

    # VIRGO "Come, Serafina."
    VIRGO "Venha, Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2584
translate ptPT qst_dreamhouse_final_housescene_9cc00ff6:

    # VIRGO "Let us take you home."
    VIRGO "Deixe-nos levá-la para casa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2585
translate ptPT qst_dreamhouse_final_housescene_505899f4:

    # SERAFINA @ talk "Wait!"
    SERAFINA @ talk "Espere!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2587
translate ptPT qst_dreamhouse_final_housescene_e7afb7c7:

    # SERAFINA @ sad "... In my dreams, I saw {i}things.{/i}"
    SERAFINA @ sad "... Em meus sonhos, eu vi {i}coisas.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2588
translate ptPT qst_dreamhouse_final_housescene_ede36390:

    # MC @ think "Things?"
    MC @ think "Coisas?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2589
translate ptPT qst_dreamhouse_final_housescene_2ee42113:

    # SERAFINA @ sad "I saw you on a throne with a blood-stained crown."
    SERAFINA @ sad "Eu vi você em um trono com uma coroa manchada de sangue."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2590
translate ptPT qst_dreamhouse_final_housescene_5d618e6e:

    # SERAFINA @ sad "Amidst a battlefield, skulls at your feet."
    SERAFINA @ sad "Em meio a um campo de batalha, caveiras aos seus pés."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2591
translate ptPT qst_dreamhouse_final_housescene_4eb7a167:

    # SERAFINA @ sad "... And a dozen knives in your back."
    SERAFINA @ sad "... E uma dúzia de facas nas suas costas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2592
translate ptPT qst_dreamhouse_final_housescene_522cf4e9:

    # MC @ surprised "I..."
    MC @ surprised "Eu..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2593
translate ptPT qst_dreamhouse_final_housescene_f90ffdfa:

    # SERAFINA @ sad "I wish you well in what's to come."
    SERAFINA @ sad "Desejo-lhe boa sorte no que está por vir."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2594
translate ptPT qst_dreamhouse_final_housescene_14fadba7:

    # SERAFINA @ sad "... I think you're going to need it."
    SERAFINA @ sad "... Acho que você vai precisar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2595
translate ptPT qst_dreamhouse_final_housescene_e7a4c5bd:

    # MC @ serious "Your dreams then, they can show you the future?"
    MC @ serious "Seus sonhos então, eles podem lhe mostrar o futuro?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2596
translate ptPT qst_dreamhouse_final_housescene_3a0a209c:

    # SERAFINA @ sad "No... More like something that can be."
    SERAFINA @ sad "Não... Mais como algo que pode ser."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2597
translate ptPT qst_dreamhouse_final_housescene_abcfa321:

    # "She lowered her head."
    "Ela abaixou a cabeça."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2598
translate ptPT qst_dreamhouse_final_housescene_e57c9609:

    # SERAFINA @ sad "I'm sorry I can't help you more,"
    SERAFINA @ sad "Sinto muito, não posso ajudar você mais,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2599
translate ptPT qst_dreamhouse_final_housescene_dc6508fc:

    # SERAFINA @ sad "but while we are here..."
    SERAFINA @ sad "mas já que estamos aqui..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2600
translate ptPT qst_dreamhouse_final_housescene_2c790cbd:

    # "Closing her eyes, Serafina waved her hand towards us."
    "Fechando os olhos, Serafina acenou com a mão para nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2601
translate ptPT qst_dreamhouse_final_housescene_556de380:

    # SERAFINA @ talk "{i}I can dream you and your friends are better.{/i}"
    SERAFINA @ talk "{i}Posso sonhar que você e seus amigos estão melhores.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2606
translate ptPT qst_dreamhouse_final_housescene_29d4805e:

    # MC @ surprised "That was..."
    MC @ surprised "Aquilo foi..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2607
translate ptPT qst_dreamhouse_final_housescene_ab56e9d7:

    # SERAFINA @ talk "Before I go."
    SERAFINA @ talk "Antes de eu ir."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2608
translate ptPT qst_dreamhouse_final_housescene_ece9d172:

    # SERAFINA @ smile "What is your name?"
    SERAFINA @ smile "Qual é o seu nome?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2609
translate ptPT qst_dreamhouse_final_housescene_26aa9e2a:

    # MC @ smile "[player_name]."
    MC @ smile "[player_name]."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2610
translate ptPT qst_dreamhouse_final_housescene_fc79dc84:

    # "Serafina smiles warmly."
    "Serafina sorri calorosamente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2611
translate ptPT qst_dreamhouse_final_housescene_24f43961:

    # SERAFINA @ smile "Then I look forward to seeing you again soon, [player_name]."
    SERAFINA @ smile "Então, espero revê-lo em breve, [player_name]."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2613
translate ptPT qst_dreamhouse_final_housescene_27ae9ddc:

    # "With that, Serafina snapped her fingers, and there was a bright flash."
    "Com isso, Serafina estalou os dedos e houve um clarão brilhante."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2623
translate ptPT qst_dreamhouse_final_housescene_7e250470:

    # MC @ surprised "I... Where are—"
    MC @ surprised "Eu... Onde estão—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2626
translate ptPT qst_dreamhouse_final_housescene_d80294f0:

    # MARKUS @ smile "Oh, thank the gods we made it out of that place!"
    MARKUS @ smile "Oh, graças aos deuses, conseguimos sair daquele lugar!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2628
translate ptPT qst_dreamhouse_final_housescene_49b2b098:

    # KIARA @ smile "Air... Sunlight... Warmth!"
    KIARA @ smile "Ar... Luz do sol... Calor!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2630
translate ptPT qst_dreamhouse_final_housescene_e01bdb19:

    # "Sypha pointed towards something."
    "Sypha apontou para algo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2631
translate ptPT qst_dreamhouse_final_housescene_28eaf8ce:

    # SYPHA @ think "Is that not the wagon that the shop woman was looking for?"
    SYPHA @ think "Não é aquela a carroça que a mulher da loja estava procurando?"

