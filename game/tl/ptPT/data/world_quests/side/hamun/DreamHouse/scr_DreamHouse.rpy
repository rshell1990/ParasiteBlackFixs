    # MC @ surprised "Upstairs!"
    MC @ surprised "Lá em cima!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:693
translate ptPT qst_dreamhouse_l2_start_77e9e664:

    # MC @ surprised "... What the f-"
    MC @ surprised "... Mas que p-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:703
translate ptPT qst_dreamhouse_l2_start_9865fb96:

    # MARKUS @ scared "How in the hells did we end up back down here?!"
    MARKUS @ scared "Como diabos acabamos aqui embaixo de novo?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:706
translate ptPT qst_dreamhouse_l2_start_eae3cdc8:

    # KIARA @ scared "Uhh... Does this place look..."
    KIARA @ scared "Uhh... Este lugar parece..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:707
translate ptPT qst_dreamhouse_l2_start_00107977:

    # KIARA @ scared "{i}Different?{/i}"
    KIARA @ scared "{i}Diferente?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:708
translate ptPT qst_dreamhouse_l2_start_cd543de7:

    # "As I looked around, I realized Kiara was indeed right."
    "Enquanto eu olhava ao redor, percebi que Kiara estava mesmo certa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:710
translate ptPT qst_dreamhouse_l2_start_39e3975c:

    # "The house had become an even more twisted version of itself, now drenched in blood, with tombstones littered around the place as a light fog swept through."
    "A casa havia se tornado uma versão ainda mais distorcida de si mesma, agora encharcada de sangue, com lápides espalhadas pelo local enquanto uma leve neblina percorria o ambiente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:711
translate ptPT qst_dreamhouse_l2_start_81bf3e55:

    # "The house itself seemed to breathe, when suddenly, wounded and stumbling through the corridor towards us..."
    "A própria casa parecia respirar, quando de repente, ferido e cambaleando pelo corredor em nossa direção..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:712
translate ptPT qst_dreamhouse_l2_start_0c6c5de5:

    # "... An inquisitor?"
    "... Um inquisidor?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:714
translate ptPT qst_dreamhouse_l2_start_5a2f5fba:

    # UNKNOWN "Who the fuck are you?!"
    UNKNOWN "Quem caralho é você?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:715
translate ptPT qst_dreamhouse_l2_start_cb46b19f:

    # UNKNOWN "Help me! QUICKLY!"
    UNKNOWN "Ajude-me! RÁPIDO!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:716
translate ptPT qst_dreamhouse_l2_start_d2876313:

    # "Before I could answer him, hurling itself around the corner, came a horde of walking corpses."
    "Antes que eu pudesse responder, lançando-se da esquina, veio uma horda de cadáveres ambulantes."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:719
translate ptPT qst_dreamhouse_l2_start_a2f921c8:

    # "I barely had time to reach for my sword before they were upon us!"
    "Mal tive tempo de alcançar minha espada antes que eles estivessem sobre nós!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:721
translate ptPT qst_dreamhouse_l2_start_637933df:

    # "Slaying the last of the creatures with a clean swipe to sever its head, I turned towards inquisitor."
    "Matando a última das criaturas com um golpe limpo para decepar sua cabeça, virei-me para o inquisidor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:727
translate ptPT qst_dreamhouse_l2_start_ef2310fb:

    # MC @ serious "What in the hells is this?"
    MC @ serious "O que diabos é isso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:728
translate ptPT qst_dreamhouse_l2_start_0189c0ba:

    # UNKNOWN "Ahhh! Damn things tore right through my armour..."
    UNKNOWN "Ahhh! As malditas coisas rasgaram direto minha armadura..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:729
translate ptPT qst_dreamhouse_l2_start_5c2fec4a:

    # UNKNOWN "My name is Davik."
    UNKNOWN "Meu nome é Davik."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:730
translate ptPT qst_dreamhouse_l2_start_5f66bb5c:

    # DAVIK "Who sent you? You people shouldn't be here!"
    DAVIK "Quem te enviou? Vocês não deveriam estar aqui!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:731
translate ptPT qst_dreamhouse_l2_start_7252ef9f:

    # MC @ talk "I was sent by the Faymore Estate to bring back their daughter."
    MC @ talk "Fui enviado pela Mansão Faymore para buscar a filha deles."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:732
translate ptPT qst_dreamhouse_l2_start_206ba41c:

    # DAVIK "{i}*Sigh*{/i} Of fucking course you were."
    DAVIK "{i}*Suspiro*{/i} Claro que você foi, porra."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:733
translate ptPT qst_dreamhouse_l2_start_0d13c2c9:

    # DAVIK "Well, you're trapped here now, same as everyone who enters this place."
    DAVIK "Bem, você está preso aqui agora, assim como todos que entram neste lugar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:734
translate ptPT qst_dreamhouse_l2_start_35dc42b6:

    # MC @ serious "Start giving me some answers."
    MC @ serious "Comece a me dar algumas respostas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:735
translate ptPT qst_dreamhouse_l2_start_c4c51bc0:

    # MC @ think "What the fuck is going on?"
    MC @ think "O que diabos está acontecendo?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:736
translate ptPT qst_dreamhouse_l2_start_fd640b80:

    # DAVIK "This place... She made it all."
    DAVIK "Este lugar... Ela criou tudo isso."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:737
translate ptPT qst_dreamhouse_l2_start_c9b24c7b:

    # DAVIK "She conjured it up in her dream."
    DAVIK "Ela o conjurou em seu sonho."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:738
translate ptPT qst_dreamhouse_l2_start_8370e8af:

    # DAVIK "It was supposed to contain all her nightmares and set her free, but..."
    DAVIK "Era para conter todos os seus pesadelos e libertá-la, mas..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:739
translate ptPT qst_dreamhouse_l2_start_b6aaa31d:

    # DAVIK "The house hungers, it's taking a life of its own."
    DAVIK "A casa tem fome, está ganhando vida própria."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:740
translate ptPT qst_dreamhouse_l2_start_9cce26fd:

    # MC @ surprised "{i}This house... came from her dreams?{/i}"
    MC @ surprised "{i}Esta casa... veio dos sonhos dela?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:741
translate ptPT qst_dreamhouse_l2_start_e4e07003:

    # DAVIK "Yes..."
    DAVIK "Sim..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:744
translate ptPT qst_dreamhouse_l2_start_menu_f48bc021:

    # DAVIK "I... Only a few hours!"
    DAVIK "Eu... Apenas algumas horas!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:745
translate ptPT qst_dreamhouse_l2_start_menu_f40870e9:

    # MC @ think "Davik... It's been over a month since the disappearance."
    MC @ think "Davik... Faz mais de um mês desde o desaparecimento."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:746
translate ptPT qst_dreamhouse_l2_start_menu_ae25cb01:

    # DAVIK "I... No."
    DAVIK "Eu... Não."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:747
translate ptPT qst_dreamhouse_l2_start_menu_b530f543:

    # DAVIK "This house is... It's messing with me!"
    DAVIK "Esta casa está... Está mexendo comigo!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:750
translate ptPT qst_dreamhouse_l2_start_menu_cd19d76d:

    # DAVIK "Dead."
    DAVIK "Morto."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:751
translate ptPT qst_dreamhouse_l2_start_menu_b6258352:

    # DAVIK "I've been running from room to room, nightmare to nightmare, trying to reach Serafina."
    DAVIK "Eu tenho corrido de quarto em quarto, de pesadelo em pesadelo, tentando alcançar Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:752
translate ptPT qst_dreamhouse_l2_start_menu_81ac1bae:

    # DAVIK "My men, one by one, have been picked off by... {i}things.{/i}"
    DAVIK "Meus homens, um por um, foram eliminados por... {i}coisas.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:753
translate ptPT qst_dreamhouse_l2_start_menu_1488c923:

    # DAVIK "Trust me, the walking dead is the least of your worries."
    DAVIK "Confie em mim, os mortos-vivos são a menor das suas preocupações."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:756
translate ptPT qst_dreamhouse_l2_start_menu_124e6aae:

    # DAVIK "Nightmares made flesh."
    DAVIK "Pesadelos feitos carne."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:757
translate ptPT qst_dreamhouse_l2_start_menu_35bc71c1:

    # DAVIK "Whatever it is, the house is responding to one of Serafina's fears."
    DAVIK "Seja o que for, a casa está a responder a um dos medos de Serafina."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:762
translate ptPT qst_dreamhouse_l2_start_menu_fdfafa9a:

    # DAVIK "I had no choice!"
    DAVIK "Eu não tive escolha!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:763
translate ptPT qst_dreamhouse_l2_start_menu_715e6591:

    # DAVIK "Once I confirmed how dangerous her powers had become, I knew I had to find a way to help her contain them!"
    DAVIK "Assim que confirmei o quão perigosos os poderes dela se tinham tornado, soube que tinha de encontrar uma forma de a ajudar a contê-los!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:764
translate ptPT qst_dreamhouse_l2_start_menu_40021d59:

    # DAVIK "{i}... Else my brothers and sisters would treat her as something too dangerous to live.{/i}"
    DAVIK "{i}... Senão, os meus irmãos e irmãs tratá-la-iam como algo demasiado perigoso para viver.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:765
translate ptPT qst_dreamhouse_l2_start_menu_a12cdbf1:

    # MC @ think "So you found a dark mage?"
    MC @ think "Então você encontrou um mago das trevas?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:766
translate ptPT qst_dreamhouse_l2_start_menu_92b1c15d:

    # DAVIK "How did you-"
    DAVIK "Como é que você-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:767
translate ptPT qst_dreamhouse_l2_start_menu_93e278f0:

    # DAVIK "{i}*Sigh*{/i} Yes, a man named Virgo."
    DAVIK "{i}*Suspiro*{/i} Sim, um homem chamado Virgo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:768
translate ptPT qst_dreamhouse_l2_start_menu_1ce3dafb:

    # DAVIK "He promised to help me contain her powers. In return, I set him free."
    DAVIK "Ele prometeu ajudar-me a conter os poderes dela. Em troca, libertei-o."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:769
translate ptPT qst_dreamhouse_l2_start_menu_a622a66c:

    # MARKUS @ shock "Are you mad?"
    MARKUS @ shock "Você está louco?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:770
translate ptPT qst_dreamhouse_l2_start_menu_de4f638e:

    # MARKUS @ angry "YOU... An inquisitor set a dark mage free!"
    MARKUS @ angry "VOCÊ... Um inquisidor libertou um mago das trevas!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:771
translate ptPT qst_dreamhouse_l2_start_menu_fdfafa9a_1:

    # DAVIK "I had no choice!"
    DAVIK "Não tive escolha!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:772
translate ptPT qst_dreamhouse_l2_start_menu_eca32403:

    # DAVIK "Virgo might be mad, but he's at least more reasonable than the rest."
    DAVIK "Virgo pode estar bravo, mas pelo menos ele é mais razoável do que os outros."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:773
translate ptPT qst_dreamhouse_l2_start_menu_ae18ced1:

    # DAVIK "He told us the ritual would at least take a day."
    DAVIK "Ele nos disse que o ritual levaria pelo menos um dia."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:774
translate ptPT qst_dreamhouse_l2_start_menu_340b03a0:

    # DAVIK "This house, he helped her channel her dream to forge it."
    DAVIK "Esta casa, ele a ajudou a canalizar o sonho dela para forjá-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:775
translate ptPT qst_dreamhouse_l2_start_menu_4080b336:

    # DAVIK "It was supposed to be a prison for her nightmares, but it's..."
    DAVIK "Deveria ser uma prisão para os pesadelos dela, mas é..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:776
translate ptPT qst_dreamhouse_l2_start_menu_1b051032:

    # "There was a loud crash, the sounds of groaning as the dead banged on the windows from outside."
    "Houve um estrondo alto, sons de gemidos enquanto os mortos batiam nas janelas do lado de fora."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:777
translate ptPT qst_dreamhouse_l2_start_menu_59e4ce8f:

    # DAVIK "Damn it!"
    DAVIK "Droga!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:778
translate ptPT qst_dreamhouse_l2_start_menu_db576fef:

    # DAVIK "Find the keys, do you hear me?"
    DAVIK "Encontre as chaves, está me ouvindo?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:779
translate ptPT qst_dreamhouse_l2_start_menu_164ad445:

    # DAVIK "Serafina and Virgo are at the core of this nightmare!"
    DAVIK "Serafina e Virgo estão no centro deste pesadelo!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:780
translate ptPT qst_dreamhouse_l2_start_menu_fe86acf9:

    # DAVIK "Each key through the master bedroom will take you one layer closer!"
    DAVIK "Cada chave através do quarto principal o levará uma camada mais perto!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:783
translate ptPT qst_dreamhouse_l2_start_menu_2a477ca6:

    # MC @ surprised "Wait! Where are you going?"
    MC @ surprised "Espere! Aonde você vai?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:784
translate ptPT qst_dreamhouse_l2_start_menu_68507330:

    # DAVIK "We're not on the same layer right now, not really!"
    DAVIK "Não estamos na mesma camada agora, não realmente!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:785
translate ptPT qst_dreamhouse_l2_start_menu_0c900b16:

    # DAVIK "The key I need to find isn't the same as yours!"
    DAVIK "A chave que eu preciso encontrar não é a mesma que a sua!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:786
translate ptPT qst_dreamhouse_l2_start_menu_cd345043:

    # DAVIK "Go, hurry!"
    DAVIK "Vá, depressa!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:787
translate ptPT qst_dreamhouse_l2_start_menu_933bc08f:

    # DAVIK "I will meet you at the center!"
    DAVIK "Eu te encontrarei no centro!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:788
translate ptPT qst_dreamhouse_l2_start_menu_732a35ab:

    # DAVIK "Then we can get my daughter out of this!"
    DAVIK "Então podemos tirar minha filha disso!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:791
translate ptPT qst_dreamhouse_l2_start_menu_162cd578:

    # MC @ surprised "Wait! Hold on a min-"
    MC @ surprised "Espere! Espere um minu-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:792
translate ptPT qst_dreamhouse_l2_start_menu_d1ed37c2:

    # "Davik hurried as quickly as he could around a corner, slightly limping as he did so."
    "Davik correu o mais rápido que pôde ao virar uma esquina, mancando levemente enquanto fazia isso."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:794
translate ptPT qst_dreamhouse_l2_start_menu_b047e486:

    # "I tried to stop him, but as he exited through one of the doors, it slammed shut behind him."
    "Tentei pará-lo, mas quando ele saiu por uma das portas, ela bateu com força atrás dele."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:795
translate ptPT qst_dreamhouse_l2_start_menu_70252298:

    # "Markus hurried over to try and rip the door open, only to find it bolted shut."
    "Markus correu para tentar arrancar a porta, apenas para descobrir que estava trancada."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:799
translate ptPT qst_dreamhouse_l2_start_menu_8fcd722f:

    # MARKUS @ angry "It's locked!"
    MARKUS @ angry "Está trancada!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:801
translate ptPT qst_dreamhouse_l2_start_menu_1049c4ec:

    # MC @ angry "Shit!"
    MC @ angry "Merda!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:802
translate ptPT qst_dreamhouse_l2_start_menu_90df1efb:

    # MC @ think "The key has to be somewhere here... We just need to find it."
    MC @ think "A chave tem que estar em algum lugar aqui... Só precisamos encontrá-la."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:803
translate ptPT qst_dreamhouse_l2_start_menu_e1c93801:

    # KIARA @ scared "Sure... As long as we don't get eaten first."
    KIARA @ scared "Claro... Desde que não sejamos comidos primeiro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:808
translate ptPT qst_dreamhouse_l2_bathtub_39e9d55f:

    # "Looks like a mercenary... Maybe one of Davik's men?"
    "Parece um mercenário... Talvez um dos homens de Davik?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:809
translate ptPT qst_dreamhouse_l2_bathtub_e44e84bf:

    # "I noticed something shimmer in the mixed blood water of the bath."
    "Percebi algo brilhando na água misturada com sangue da banheira."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:812
translate ptPT qst_dreamhouse_l2_bathtub_427359f5:

    # "Shoving my hand into the bloody water, I pulled out a small, dull key."
    "Enfiando a mão na água ensanguentada, puxei uma chave pequena e fosca."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:815
translate ptPT qst_dreamhouse_l2_bathtub_854dd011:

    # KIARA @ scared "I think I might be sick..."
    KIARA @ scared "Acho que vou vomitar..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:818
translate ptPT qst_dreamhouse_l2_bathtub_dd99af82:

    # "(No way am I putting my hand in that.)"
    "(De jeito nenhum vou colocar a mão nisso.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:823
translate ptPT qst_dreamhouse_l2_mirror_665c1b26:

    # "Looks like there was a struggle in here."
    "Parece que houve uma luta aqui."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:830
translate ptPT qst_dreamhouse_l2_bathroom_oneoff_ca772e26:

    # "Entering the bathroom, a man lay dead in the tub, half-eaten as a strange specter appeared to be laping up his blood."
    "Ao entrar no banheiro, um homem jazia morto na banheira, meio comido, enquanto um espectro estranho parecia lamber seu sangue."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:831
translate ptPT qst_dreamhouse_l2_bathroom_oneoff_d56cf1ec:

    # "It tilted its head towards me as I drew my blade!"
    "Ele inclinou a cabeça para mim enquanto eu sacava minha lâmina!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:838
translate ptPT qst_dreamhouse_l2_bathroom_oneoff_8e572365:

    # MC @ surprised "Was that a fucking ghost?!"
    MC @ surprised "Aquilo era um maldito fantasma?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:839
translate ptPT qst_dreamhouse_l2_bathroom_oneoff_2d14ed26:

    # KIARA @ scared "No, no, no, no, no!"
    KIARA @ scared "Não, não, não, não, não!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:840
translate ptPT qst_dreamhouse_l2_bathroom_oneoff_05a808cd:

    # KIARA @ scared "You've got to be kidding me!"
    KIARA @ scared "Você só pode estar brincando comigo!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:847
translate ptPT qst_dreamhouse_l2_nursery_oneoff_aec2ef82:

    # "Entering the room, the twisted corpses inside turned their attention towards us."
    "Ao entrar no quarto, os cadáveres retorcidos lá dentro voltaram a atenção para nós."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:848
translate ptPT qst_dreamhouse_l2_nursery_oneoff_f98f618e:

    # MC @ scared "Shit!"
    MC @ scared "Merda!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:860
translate ptPT qst_dreamhouse_l2_toys_caf4fb7b:

    # "Blood-stained and torn up toys."
    "Brinquedos manchados de sangue e rasgados."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:864
translate ptPT qst_dreamhouse_l2_crib_fd87f1dd:

    # "A crib stained in blood."
    "Um berço manchado de sangue."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:869
translate ptPT qst_dreamhouse_l2_bedroom_door_8e18cd77:

    # MC "(We need the key to unlock this!)"
    MC "(Precisamos da chave para destrancar isso!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:873
translate ptPT qst_dreamhouse_l2_bedroom_door_918f304d:

    # "Inserting the key into the lock, the door swung open as we scrambled through,"
    "Inserindo a chave na fechadura, a porta se abriu enquanto nos apressávamos para entrar,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:876
translate ptPT qst_dreamhouse_l2_bedroom_door_538a8f11:

    # "a bright white light enveloping us all as we did so."
    "uma luz branca brilhante envolvendo todos nós enquanto fazíamos isso."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:884
translate ptPT qst_dreamhouse_l2_candle_4040ce45:

    # MC @ think "(A blue flame... Why?)"
    MC @ think "(Uma chama azul... Por quê?)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:890
translate ptPT qst_dreamhouse_l2_dining_oneoff_82f181a3:

    # "Entering the dining hall, the table had become a ghoulish display of gore, as the creatures crowded around it."
    "Entrando no salão de jantar, a mesa se tornara uma exibição macabra de tripas, enquanto as criaturas se aglomeravam ao redor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:891
translate ptPT qst_dreamhouse_l2_dining_oneoff_d8a8a7a0:

    # "Guts, blood, and indiscernible flesh sprawled across the table as they grabbed at the meat with their bare hands and devoured it."
    "Tripas, sangue e carne irreconhecível espalhados pela mesa enquanto eles agarravam a carne com as mãos nuas e a devoravam."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:892
translate ptPT qst_dreamhouse_l2_dining_oneoff_d34ae079:

    # "The wretched smell of rot and death was too much for Kiara, who hurled onto the floor."
    "O cheiro horrível de podridão e morte era demais para Kiara, que vomitou no chão."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:893
translate ptPT qst_dreamhouse_l2_dining_oneoff_fdae0222:

    # KIARA @ scared "Oh gods..."
    KIARA @ scared "Oh deuses..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:894
translate ptPT qst_dreamhouse_l2_dining_oneoff_6f1abb01:

    # "As she did so, the dead looked up, dropping the meat in their hands as they began shambling towards us!"
    "Enquanto ela fazia isso, os mortos olharam para cima, largando a carne em suas mãos e começaram a cambalear em nossa direção!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:897
translate ptPT qst_dreamhouse_l2_dining_oneoff_6e8ae10d:

    # MARKUS @ angry "I FUCKING HATE THIS HOUSE!"
    MARKUS @ angry "EU ODEIO ESTA CASA PRA CARALHO!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:905
translate ptPT qst_dreamhouse_l2_dining_oneoff_a623fccf:

    # MARKUS @ shock "{i}*Huff*{/i} I think that's the last of them."
    MARKUS @ shock "{i}*Huff*{/i} Acho que são os últimos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:908
translate ptPT qst_dreamhouse_l2_dining_oneoff_fdd90545:

    # VES @ angry "These creatures only fall when their head is cleaved from their neck!"
    VES @ angry "Essas criaturas só caem quando suas cabeças são decepadas do pescoço!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:910
translate ptPT qst_dreamhouse_l2_dining_oneoff_b8b1ec09:

    # VES @ angry "How tedious!"
    VES @ angry "Que tedioso!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:913
translate ptPT qst_dreamhouse_l2_dining_oneoff_4b748bc8:

    # SYPHA @ think "We can't stay here, come on."
    SYPHA @ think "Não podemos ficar aqui, vamos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:918
translate ptPT qst_dreamhouse_l2_table_f89a89b8:

    # "(... Gods, what a nightmare.)"
    "(... Deuses, que pesadelo.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:923
translate ptPT qst_dreamhouse_l2_wolfhead_a1f17cb0:

    # "BARK!"
    "AU AU!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:924
translate ptPT qst_dreamhouse_l2_wolfhead_4f314bba:

    # "The mounted head snapped towards me with its jaws."
    "A cabeça montada estalou em minha direção com suas mandíbulas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:925
translate ptPT qst_dreamhouse_l2_wolfhead_41224f04:

    # "(Is it... Is it still alive?)"
    "(Está... Ainda está vivo?)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:930
translate ptPT qst_dreamhouse_l2_portrait_d934f7a2:

    # "That's... disturbing."
    "Isso é... perturbador."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:936
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_b0b44ff1:

    # "As we entered the kitchen, I heard the slamming of the cleaver as we looked to find one of the dead,"
    "Quando entramos na cozinha, ouvi o bater do cutelo enquanto olhávamos e encontrávamos um dos mortos,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:938
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_f0272186:

    # "a huge, decrepit, bulking figure hacking away at a man."
    "uma figura enorme, decrépita e volumosa retalhando um homem."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:939
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_ec7e5b88:

    # "Still barely alive and choking on blood, the man reached out towards us in one desperate final act, only for the creature to hack off his fingers with the cleaver."
    "Ainda mal respirando e engasgado com sangue, o homem estendeu a mão para nós num ato final desesperado, apenas para a criatura decepar seus dedos com o cutelo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:940
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_e99e910f:

    # "As the fingers dropped to the floor, the ghoulish creature turned towards us, placing down a platter of the man's remains on the table,"
    "Enquanto os dedos caíam no chão, a criatura macabra virou-se para nós, colocando uma travessa com os restos do homem sobre a mesa,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:941
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_b108b59f:

    # "it then stared blankly towards us, expectantly."
    "e então nos encarou fixamente, de forma expectante."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:942
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_64cf87e1:

    # MARKUS @ scared "Does... Does this fucking thing expect us to eat that?!"
    MARKUS @ scared "Será que... Será que essa porra de coisa espera que a gente coma isso?!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:945
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_53d44a4b:

    # "Carefully, I reached over to grab a piece of the meat."
    "Cuidadosamente, estendi a mão para pegar um pedaço da carne."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:946
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_2f9ce75e:

    # "With a shaky hand, I pushed the wet meat into my mouth as the creature offered a drooling grin of approval."
    "Com a mão trêmula, enfiei a carne úmida na boca enquanto a criatura oferecia um sorriso babado de aprovação."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:947
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_ed932dcd:

    # "Markus pulled back in revulsion as Kiara looked like she was about to hurl."
    "Markus recuou com repulsa enquanto Kiara parecia prestes a vomitar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:948
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_2bce3932:

    # "The wet meat squeelched between my teeth, almost making me wretch as my eyes began to water from the foul taste."
    "A carne úmida rangeu entre meus dentes, quase me fazendo vomitar enquanto meus olhos começaram a lacrimejar com o gosto podre."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:949
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_cf947b80:

    # KIARA @ sad "Oh gods... I might... I think I'm gonna be sick."
    KIARA @ sad "Oh deuses... Eu posso... Acho que vou vomitar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:950
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_d069021e:

    # MARKUS @ scared "What in the hells is wrong with you?"
    MARKUS @ scared "Que diabos há de errado com você?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:951
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_d73d8a37:

    # SYPHA @ think "... Is this is some kind of masochistic ritual humans perform?"
    SYPHA @ think "... Isso é algum tipo de ritual masoquista que os humanos realizam?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:954
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_18ca7ff7:

    # VES @ think "... Why no salt?"
    VES @ think "... Por que sem sal?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:956
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_c5034d4e:

    # "Seemingly satisfied that I had tasted his *food,* the creature went back to cooking, seemingly ignoring us and allowing us to pass."
    "Aparentemente satisfeito por eu ter provado sua *comida,* a criatura voltou a cozinhar, aparentemente nos ignorando e nos permitindo passar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:960
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_806c733b:

    # "The ghoulish dead creature stared for a moment,"
    "A criatura morta e macabra encarou por um momento,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:961
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_1eb9fc7b:

    # "and realizing none of us will eat its {i}food,{/i}"
    "e percebendo que nenhum de nós comeria sua {i}comida,{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:962
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_5633d180:

    # "it grabbed for the cleaver and swung it wildly towards us!"
    "agarrou o cutelo e o balançou descontroladamente em nossa direção!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:970
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_4dc50c36:

    # "Stumbling backwards, blood running from the seeping gash in its head from where I struck,"
    "Cambaleando para trás, sangue escorrendo do corte na cabeça de onde eu bati,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:971
translate ptPT qst_dreamhouse_l2_kitchen_oneoff_4e90e46e:

    # "in the creature's final moments, it reached up to grab a chunk of meat, stuffing its mouth full of it before it fell silent."
    "nos momentos finais da criatura, ela estendeu a mão para pegar um pedaço de carne, enchendo a boca com ele antes de cair em silêncio."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:978
translate ptPT qst_dreamhouse_l2_kitchen_cupboards_57333fb4:

    # "The cupboards bled and were filled with nothing but pungent meat in a gory mess."
    "Os armários sangravam e estavam cheios de nada além de carne pungente em uma bagunça sangrenta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:979
translate ptPT qst_dreamhouse_l2_kitchen_cupboards_529ca2a3:

    # MC "(I think I'll pass on dessert.)"
    MC "(Acho que vou pular a sobremesa.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:984
translate ptPT qst_dreamhouse_l2_kitchen_pot_4b656435:

    # MC "A boiled, severed head floated to the top of the blood stew."
    MC "Uma cabeça decepada e fervida flutuou para o topo do ensopado de sangue."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:989
translate ptPT qst_dreamhouse_l2_kitchen_table_0fe1d924:

    # "{i}Why does no one believe me?{/i}"
    "{i}Por que ninguém acredita em mim?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:990
translate ptPT qst_dreamhouse_l2_kitchen_table_00252d94:

    # "{i}We buried the servant boy the other day, mother says his lungs were sick.{/i}"
    "{i}Enterramos o menino servo no outro dia, a mãe diz que seus pulmões estavam doentes.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:991
translate ptPT qst_dreamhouse_l2_kitchen_table_e5462dc5:

    # "{i}I swear I saw him move, but no one believed me.{/i}"
    "{i}Juro que o vi se mexer, mas ninguém acreditou em mim.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:992
translate ptPT qst_dreamhouse_l2_kitchen_table_d7e1df6c:

    # "{i}I dreamed he was still moving in that box, and he came to see me that night.{/i}"
    "{i}Sonhei que ele ainda se mexia naquela caixa, e ele veio me ver naquela noite.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:993
translate ptPT qst_dreamhouse_l2_kitchen_table_d2e54c8d:

    # "{i}He was all mangled and gross, I screamed, but he was gone when mother came...{/i}"
    "{i}Ele estava todo mutilado e nojento, gritei, mas ele desapareceu quando a mãe chegou...{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:998
translate ptPT qst_dreamhouse_l2_kitchen_to_cellar_9dd37f09:

    # MC @ think "Damn, it's locked!"
    MC @ think "Droga, está trancado!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1003
translate ptPT qst_dreamhouse_l2_kitchen_to_cellar_d24c6466:

    # "The door clicked as it unlocked."
    "A porta fez um clique ao destrancar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1012
translate ptPT qst_dreamhouse_l2_cellar_barrel_61b14339:

    # "No wine, only blood it seems... warm to the touch."
    "Nada de vinho, apenas sangue, ao que parece... quente ao toque."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1018
translate ptPT qst_dreamhouse_l2_dead_mercenary_5b189511:

    # "Inspecting the corpse of the man, I found clutched in his coiled, dead hand, the blue skull key."
    "Inspecionando o cadáver do homem, encontrei agarrada em sua mão retorcida e morta a chave azul do crânio."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1025
translate ptPT qst_dreamhouse_l2_library_oneoff_b461b23a:

    # "Upon entering the room, the swarm of dead shuffling around turned their attention towards us!"
    "Ao entrar na sala, o enxame de mortos se arrastando voltou sua atenção para nós!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1035
translate ptPT qst_dreamhouse_l2_library_fireplace_9aefa7d9:

    # "A still-lit fireplace."
    "Uma lareira ainda acesa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1036
translate ptPT qst_dreamhouse_l2_library_fireplace_a3ca41df:

    # "The fire crackled as it burned the wood, but it radiated no warmth."
    "O fogo estalava enquanto queimava a lenha, mas não irradiava calor."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1041
translate ptPT qst_dreamhouse_l2_library_bookshelf_1_29465ee2:

    # "The pages were ruined and covered in blood."
    "As páginas estavam arruinadas e cobertas de sangue."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1046
translate ptPT qst_dreamhouse_l2_library_bookshelf_2_0a77bcf4:

    # "... Just what kind of nightmares did this girl have?"
    "... Que tipo de pesadelos essa garota tinha?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1051
translate ptPT qst_dreamhouse_l2_library_portrait_26eb8738:

    # "There's a depiction of what seems to be a man devouring raw, bloody, flesh... How macabre."
    "Há uma representação do que parece ser um homem devorando carne crua e ensanguentada... Que macabro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1052
translate ptPT qst_dreamhouse_l2_library_portrait_dcac9c61:

    # "There's no keyhole this time."
    "Não há fechadura desta vez."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1068
translate ptPT qst_dreamhouse_l3_start_e6b4e9df:

    # MC @ surprised "Gods, what is this place?"
    MC @ surprised "Deuses, o que é este lugar?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1069
translate ptPT qst_dreamhouse_l3_start_594000fe:

    # MC @ think "Does anyone-"
    MC @ think "Alguém-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1071
translate ptPT qst_dreamhouse_l3_start_af6f165f:

    # "As I turned to look back, I realized the others were not with me."
    "Quando me virei para olhar para trás, percebi que os outros não estavam comigo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1072
translate ptPT qst_dreamhouse_l3_start_0ce3e770:

    # MC @ surprised "Markus?"
    MC @ surprised "Marcos?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1073
translate ptPT qst_dreamhouse_l3_start_3e21602a:

    # MC @ surprised "Kiara?"
    MC @ surprised "Kiara?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1075
translate ptPT qst_dreamhouse_l3_start_3ef76725:

    # MC @ surprised "{i}Anyone?{/i}"
    MC @ surprised "{i}Alguém?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1077
translate ptPT qst_dreamhouse_l3_start_cbea66c9:

    # MC @ serious "... Fuck."
    MC @ serious "... Merda."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1078
translate ptPT qst_dreamhouse_l3_start_8bdaee21:

    # MC "(Alright, you know what to do. Find the key, move onto the next floor.)"
    MC "(Certo, você sabe o que fazer. Encontre a chave, vá para o próximo andar.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1079
translate ptPT qst_dreamhouse_l3_start_d7232d72:

    # MC @ sad "(I just hope the others are fine.)"
    MC @ sad "(Só espero que os outros estejam bem.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1085
translate ptPT qst_dreamhouse_l3_bathtub_c67fdbca:

    # "The water is black..."
    "A água está preta..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1091
translate ptPT qst_dreamhouse_l3_mirror_0d811e85:

    # "Looking into it, I saw my own reflection, but it was distorted."
    "Olhando para ela, vi meu próprio reflexo, mas estava distorcido."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1095
translate ptPT qst_dreamhouse_l3_mirror_44dde62d:

    # "As I placed my hand onto the mirror, I felt it go {i}through{/i} the glass into the other side."
    "Quando coloquei a mão no espelho, senti que ela passou {i}através{/i} do vidro para o outro lado."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1096
translate ptPT qst_dreamhouse_l3_mirror_8f466d6a:

    # "It was cool, and as I pushed my hand deeper, I grabbed at something."
    "Estava frio, e quando empurrei a mão mais fundo, agarrei algo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1098
translate ptPT qst_dreamhouse_l3_mirror_a6a16a82:

    # "Pulling my hand and whatever it was out, something clawed at me!"
    "Ao puxar minha mão e o que quer que fosse, algo me arranhou!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1101
translate ptPT qst_dreamhouse_l3_mirror_eaf73d4a:

    # MC @ surprised "AHH!"
    MC @ surprised "AHH!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1102
translate ptPT qst_dreamhouse_l3_mirror_84c4e35d:

    # "I ripped back my hand, staring at the gash of blood."
    "Puxei minha mão de volta, encarando o corte sangrento."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1103
translate ptPT qst_dreamhouse_l3_mirror_cc6cfb05:

    # "Clutched in my hand, though, was a small, strange totem."
    "Porém, na minha mão estava agarrado um pequeno e estranho totem."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1105
translate ptPT qst_dreamhouse_l3_mirror_b7b8af7c:

    # MC "(What is this?)"
    MC "(O que é isso?)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1108
translate ptPT qst_dreamhouse_l3_mirror_6fab40d8:

    # "(Probably not a good idea.)"
    "(Provavelmente não é uma boa ideia.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1144
translate ptPT qst_dreamhouse_l3_granny_bathroom_415eeec1:

    # MC "(She's coming!)"
    MC "(Ela está vindo!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1147
translate ptPT qst_dreamhouse_l3_granny_bathroom_a6b7cd71:

    # "I hid behind the bath."
    "Me escondi atrás da banheira."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1150
translate ptPT qst_dreamhouse_l3_granny_bathroom_7681aefe:

    # "Crouched beside it, the figure entered the bathroom and peered around, looking for me."
    "Agachada ao lado dela, a figura entrou no banheiro e olhou ao redor, me procurando."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1152
translate ptPT qst_dreamhouse_l3_granny_bathroom_767c5417:

    # "Crouched down behind the bathtub, the figure glanced from left to right for a moment before, thankfully, shuffling off."
    "Agachada atrás da banheira, a figura olhou da esquerda para a direita por um momento antes de, felizmente, se afastar arrastando os pés."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1160
translate ptPT qst_dreamhouse_l3_granny_bathroom_4cbc2d3b:

    # "Deciding there was no point in hiding, I readied myself to try and slip past her!"
    "Decidindo que não havia motivo para me esconder, me preparei para tentar passar por ela!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1162
translate ptPT qst_dreamhouse_l3_granny_bathroom_5ad74a8f:

    # "Barging through the figure, I barely managed to dodge the snap of her blades as I escaped!"
    "Atravessando a figura, mal consegui desviar do estalo de suas lâminas enquanto escapava!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1170
translate ptPT qst_dreamhouse_l3_granny_diningroom_134a3e83:

    # MC @ scared "(I need to hide!)"
    MC @ scared "(Preciso me esconder!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1176
translate ptPT qst_dreamhouse_l3_granny_diningroom_38cbb1be:

    # "Dropping to my knees, I crawled beneath the table and waited with bated breath."
    "Deixando-me cair de joelhos, rastejei para debaixo da mesa e esperei com a respiração suspensa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1180
translate ptPT qst_dreamhouse_l3_granny_diningroom_f75a4f61:

    # "As I heard the sound of the shear blade snapping draw closer, the door to the dining room was kicked in as the figure walked on by."
    "Enquanto ouvia o som do estalar da lâmina de tesoura se aproximar, a porta da sala de jantar foi chutada enquanto a figura passava."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1181
translate ptPT qst_dreamhouse_l3_granny_diningroom_1010a24a:

    # GRANNY_OH_DREARY "Precious... Where are you precious?"
    GRANNY_OH_DREARY "Precioso... Onde você está, precioso?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1182
translate ptPT qst_dreamhouse_l3_granny_diningroom_95eeac9e:

    # GRANNY_OH_DREARY "Come... Let granny take care of you forever!"
    GRANNY_OH_DREARY "Venha... Deixe a vovó cuidar de você para sempre!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1183
translate ptPT qst_dreamhouse_l3_granny_diningroom_2f4f3719:

    # "They stopped for a moment, looking around, before moving on into the next room."
    "Eles pararam por um momento, olhando ao redor, antes de seguir para o próximo cômodo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1186
translate ptPT qst_dreamhouse_l3_granny_diningroom_31130542:

    # MC "(That was close...)"
    MC "(Foi por pouco...)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1193
translate ptPT qst_dreamhouse_l3_granny_diningroom_2300535e:

    # "I grabbed the nearest chair,"
    "Peguei a cadeira mais próxima,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1195
translate ptPT qst_dreamhouse_l3_granny_diningroom_6959b464:

    # "As the door burst open, I flung it towards her before fleeing!"
    "Quando a porta se abriu de repente, atirei-o em direção a ela antes de fugir!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1197
translate ptPT qst_dreamhouse_l3_granny_diningroom_476cb8e0:

    # GRANNY_OH_DREARY "YOU CAN'T RUN FOREVER!"
    GRANNY_OH_DREARY "VOCÊ NÃO PODE FUGIR PARA SEMPRE!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1206
translate ptPT qst_dreamhouse_l3_granny_kitchen_077c9c3b:

    # MC "(I can hear her coming!)"
    MC "(Consigo ouvi-la chegar!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1210
translate ptPT qst_dreamhouse_l3_granny_kitchen_7cc40527:

    # "I crawled beneath the kitchen table and waited, hoping the monstrous figure would simply pass on by."
    "Rastejei para debaixo da mesa da cozinha e esperei, na esperança de que a figura monstruosa simplesmente passasse por ali."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1214
translate ptPT qst_dreamhouse_l3_granny_kitchen_76c47b00:

    # "The kitchen door swung open, shears snapping violently and tormentingly as she walked,"
    "A porta da cozinha abriu-se, as tesouras a estalar violenta e atormentadamente enquanto ela andava,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1215
translate ptPT qst_dreamhouse_l3_granny_kitchen_86895518:

    # GRANNY_OH_DREARY "There's no need to run!"
    GRANNY_OH_DREARY "Não precisas de fugir!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1216
translate ptPT qst_dreamhouse_l3_granny_kitchen_fba385a5:

    # GRANNY_OH_DREARY "You'll make lots of friends with the other children!"
    GRANNY_OH_DREARY "Vais fazer muitos amigos com as outras crianças!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1219
translate ptPT qst_dreamhouse_l3_granny_kitchen_c51bbaec:

    # "Granny Oh Dreary passed on by without noticing me... For now."
    "A Avó Oh Dreary passou sem me notar... Por enquanto."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1225
translate ptPT qst_dreamhouse_l3_granny_kitchen_906d9207:

    # "Quickly, I moved to push the table against the door, blockading it."
    "Rapidamente, tratei de empurrar a mesa contra a porta, bloqueando-a."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1227
translate ptPT qst_dreamhouse_l3_granny_kitchen_3c3c1697:

    # "From the other side, I could hear loud banging on the door."
    "Do outro lado, podia ouvir fortes batidas na porta."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1228
translate ptPT qst_dreamhouse_l3_granny_kitchen_c379ad4a:

    # MC @ serious "(It won't hold long.)"
    MC @ serious "(Isso não vai aguentar muito.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1229
translate ptPT qst_dreamhouse_l3_granny_kitchen_8754c925:

    # MC @ serious "(I need to get out of here!)"
    MC @ serious "(Preciso sair daqui!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1237
translate ptPT qst_dreamhouse_l3_granny_cellar_bc8f7802:

    # MC @ scared "(Shit! She's coming!)"
    MC @ scared "(Merda! Ela está vindo!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1241
translate ptPT qst_dreamhouse_l3_granny_cellar_77fbc12d:

    # "Crouched down, I hide behind some of the many rows of potions and strange bottles."
    "Agachado, me escondo atrás de algumas das muitas fileiras de poções e garrafas estranhas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1245
translate ptPT qst_dreamhouse_l3_granny_cellar_8ba4c879:

    # "As the door opened, the figure stepped inside, shears snapping as she looked from left to right."
    "Quando a porta se abriu, a figura entrou, tesouras estalando enquanto olhava de um lado para o outro."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1246
translate ptPT qst_dreamhouse_l3_granny_cellar_cd5316aa:

    # GRANNY_OH_DREARY "Are you here, deary?"
    GRANNY_OH_DREARY "Você está aqui, queridinha?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1247
translate ptPT qst_dreamhouse_l3_granny_cellar_97223560:

    # GRANNY_OH_DREARY "Come give granny a hug!"
    GRANNY_OH_DREARY "Venha dar um abraço na vovó!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1250
translate ptPT qst_dreamhouse_l3_granny_cellar_c8c5fa4d:

    # "I pulled back at the last second as she looked towards me, and as I did so, I heard the snapping sound grow distant as she moved on."
    "Recuei no último segundo quando ela olhou na minha direção, e enquanto fazia isso, ouvi o som de estalo se distanciar à medida que ela seguia em frente."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1256
translate ptPT qst_dreamhouse_l3_granny_cellar_a284fed4:

    # "I didn't hesitate, grabbing the nearest bottle and launching it towards her as soon as she entered the room."
    "Não hesitei, agarrei a garrafa mais próxima e a lancei contra ela assim que entrou no quarto."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1258
translate ptPT qst_dreamhouse_l3_granny_cellar_1aaab80a:

    # "By pure luck, the bottle {i}somehow{/i} seemed to actually hit her."
    "Por pura sorte, a garrafa {i}de alguma forma{/i} parecia realmente tê-la atingido."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1262
translate ptPT qst_dreamhouse_l3_granny_cellar_6ad10df8:

    # "She screamed and wailed as it sizzled her, white steam rising from her as she seemed to shimmer."
    "Ela gritou e gemeu enquanto aquilo a queimava, vapor branco subindo dela enquanto parecia brilhar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1263
translate ptPT qst_dreamhouse_l3_granny_cellar_0582b976:

    # GRANNY_OH_DREARY "GAHHH! NAUGHTY! NAUGHTY FUCKING BRAT!"
    GRANNY_OH_DREARY "GAHHH! TRAVESSA! TRAVESSA DO CARALHO!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1266
translate ptPT qst_dreamhouse_l3_granny_cellar_78e6daf4:

    # "She retreated... For now, at least."
    "Ela recuou... Pelo menos por enquanto."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1267
translate ptPT qst_dreamhouse_l3_granny_cellar_4250636f:

    # MC "(Too bad I didn't douse my sword in whatever that was first.)"
    MC "(Pena que não molhei minha espada naquilo que fosse antes.)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1274
translate ptPT qst_dreamhouse_l3_granny_library_3f5054a7:

    # "{i}*SNAP!*{/i}"
    "{i}*SNAP!*{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1275
translate ptPT qst_dreamhouse_l3_granny_library_147920de:

    # GRANNY_OH_DREARY "Come out, prettyyyy!"
    GRANNY_OH_DREARY "Saia, lindaaa!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1276
translate ptPT qst_dreamhouse_l3_granny_library_98f0f9eb:

    # GRANNY_OH_DREARY "Don't hide from grandmaaa!"
    GRANNY_OH_DREARY "Não se esconda da vovóóó!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1282
translate ptPT qst_dreamhouse_l3_granny_library_78c77d80:

    # "Crouched down, I watched and waited patiently as Granny entered the library."
    "Agachado, observei e esperei pacientemente enquanto a Vovó entrava na biblioteca."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1283
translate ptPT qst_dreamhouse_l3_granny_library_cb478fab:

    # "She glanced left."
    "Ela olhou para a esquerda."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1284
translate ptPT qst_dreamhouse_l3_granny_library_46553a4a:

    # "Then right."
    "Depois para a direita."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1287
translate ptPT qst_dreamhouse_l3_granny_library_a27d0a99:

    # "Then slowly turned to leave as I breathed a sigh of relief."
    "Então, lentamente me virei para sair enquanto soltava um suspiro de alívio."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1296
translate ptPT qst_dreamhouse_l3_granny_library_f1839d3d:

    # "I timed it perfectly, waiting carefully for her to enter the room. Crouched low, I moved as silently as possible."
    "Cronometrei perfeitamente, esperando cuidadosamente que ela entrasse na sala. Agachado, movi-me o mais silenciosamente possível."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1299
translate ptPT qst_dreamhouse_l3_granny_library_1c2cbc14:

    # "Before she knew it, I had managed to slip behind her and hurry out."
    "Antes que ela percebesse, eu consegui deslizar atrás dela e sair correndo."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1309
translate ptPT qst_dreamhouse_l3_granny_wrongchoice_5282681b:

    # "As Granny lunged towards me, the strange totem began to glow brightly,"
    "Quando a Vovó avançou em minha direção, o estranho totem começou a brilhar intensamente,"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1310
translate ptPT qst_dreamhouse_l3_granny_wrongchoice_99fcaa70:

    # "and as it did so, Granny shielded her eyes and fled from the room!"
    "e ao fazê-lo, a Vovó protegeu os olhos e fugiu da sala!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1316
translate ptPT qst_dreamhouse_l3_granny_wrongchoice_0b5a0ed1:

    # "As the totem dimmed, it cracked, crumbling away in my hands."
    "Quando o totem se apagou, ele rachou, desintegrando-se em minhas mãos."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1317
translate ptPT qst_dreamhouse_l3_granny_wrongchoice_eb97fb6f:

    # MC "(... The totems... I need to find more of them if I can!)"
    MC "(... Os totens... Preciso encontrar mais deles se eu puder!)"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1334
translate ptPT qst_dreamhouse_l3_toys_4cc3a2b0:

    # "Dolls."
    "Bonecas."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1335
translate ptPT qst_dreamhouse_l3_toys_8be0926e:

    # "... Oh gods."
    "... Oh, deuses."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1336
translate ptPT qst_dreamhouse_l3_toys_c4fb2060:

    # "Are those... {i}faces stitched to the dolls?{/i}"
    "São aqueles... {i}rostos costurados nas bonecas?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1341
translate ptPT qst_dreamhouse_l3_crib_2aac05f3:

    # "Inside the crib was a doll clutching a small, diamond-head-shaped key."
    "Dentro do berço havia uma boneca segurando uma pequena chave em forma de cabeça de diamante."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1346
translate ptPT qst_dreamhouse_l3_crib_9014a260:

    # "I grabbed hold of the key."
    "Peguei a chave."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1352
translate ptPT qst_dreamhouse_l3_crib_6e176177:

    # "As I took the key, from the shadowed corner of the room, I heard rocking."
    "Ao pegar a chave, do canto sombrio do quarto, ouvi um balanço."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1354
translate ptPT qst_dreamhouse_l3_crib_10844fab:

    # "Reaching for my blade, I turned to see a hunched, shrouded figure sitting in a rocking chair."
    "Pegando minha lâmina, me virei e vi uma figura curvada e envolta em panos sentada em uma cadeira de balanço."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1355
translate ptPT qst_dreamhouse_l3_crib_cb4235c7:

    # "Had she been here this whole time?"
    "Ela esteve aqui o tempo todo?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1356
translate ptPT qst_dreamhouse_l3_crib_66840beb:

    # MC @ think "... Hello?"
    MC @ think "... Olá?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1357
translate ptPT qst_dreamhouse_l3_crib_a86fe40a:

    # GRANNY_OH_DREARY "..."
    GRANNY_OH_DREARY "..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1358
translate ptPT qst_dreamhouse_l3_crib_b18389e7:

    # "The woman stopped rocking in her chair."
    "A mulher parou de balançar em sua cadeira."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1359
translate ptPT qst_dreamhouse_l3_crib_2548988e:

    # MC @ scared "... I'm looking for-"
    MC @ scared "... Estou procurando por-"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1360
translate ptPT qst_dreamhouse_l3_crib_3fd19343:

    # GRANNY_OH_DREARY "Do you know my song?"
    GRANNY_OH_DREARY "Você conhece minha canção?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1361
translate ptPT qst_dreamhouse_l3_crib_bde6c2b6:

    # MC @ think "What?"
    MC @ think "O quê?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1362
translate ptPT qst_dreamhouse_l3_crib_f49508d7:

    # "I felt the air suck from the room as I took a step back."
    "Senti o ar sugar da sala quando dei um passo para trás."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1363
translate ptPT qst_dreamhouse_l3_crib_ebf60601:

    # "The hair stood on end."
    "Os cabelos se arrepiaram."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1364
translate ptPT qst_dreamhouse_l3_crib_639f7396:

    # GRANNY_OH_DREARY "Granny Oh Dreary, don't let children grow..."
    GRANNY_OH_DREARY "Vovó Oh Dreary, não deixe as crianças crescerem..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1366
translate ptPT qst_dreamhouse_l3_crib_c25bbe0f:

    # "The woman rose from her rocking chair. She was tall... {i}too tall.{/i}"
    "A mulher se levantou de sua cadeira de balanço. Ela era alta... {i}alta demais.{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1367
translate ptPT qst_dreamhouse_l3_crib_c5a9bee6:

    # GRANNY_OH_DREARY "Snips off their faces so no one will know."
    GRANNY_OH_DREARY "Corta seus rostos para que ninguém saiba."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1368
translate ptPT qst_dreamhouse_l3_crib_d462b8b0:

    # GRANNY_OH_DREARY "Stay little, stay sweet, don't ever get tall…"
    GRANNY_OH_DREARY "Fique pequeno, fique doce, nunca fique alto…"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1369
translate ptPT qst_dreamhouse_l3_crib_96d74cac:

    # GRANNY_OH_DREARY "Her dolls on the shelf used to speak, after all!"
    GRANNY_OH_DREARY "Suas bonecas na estante costumavam falar, afinal!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1370
translate ptPT qst_dreamhouse_l3_crib_881e3d92:

    # "From under her robes came the sharp glint of a huge pair of shears."
    "De sob suas vestes veio o brilho afiado de uma enorme tesoura."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1371
translate ptPT qst_dreamhouse_l3_crib_832ccf11:

    # GRANNY_OH_DREARY "Stitch up your smile, pull tight at the seam—"
    GRANNY_OH_DREARY "Costure seu sorriso, aperte firme a costura—"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1372
translate ptPT qst_dreamhouse_l3_crib_2ae64287:

    # MC @ scared "... Oh fuck."
    MC @ scared "... Oh, porra."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1374
translate ptPT qst_dreamhouse_l3_crib_f15e001d:

    # "I stepped back, retreating as she pressed the blades together, grinning a hideous, oversized smile."
    "Eu recuei, afastando-me enquanto ela pressionava as lâminas uma contra a outra, sorrindo um sorriso horrendo e exagerado."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1375
translate ptPT qst_dreamhouse_l3_crib_93b00313:

    # "And as she inched closer, I could see {i}she was wearing someone's face.{/i}"
    "E à medida que ela se aproximava, eu pude ver {i}que ela estava usando o rosto de alguém.{/i}"

