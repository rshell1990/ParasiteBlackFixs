# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2122
translate ptPT qst_dreamhouse_l5_start_5122da77:

    # "only to face a brand new horror..."
    "apenas para encarar um horror totalmente novo..."

