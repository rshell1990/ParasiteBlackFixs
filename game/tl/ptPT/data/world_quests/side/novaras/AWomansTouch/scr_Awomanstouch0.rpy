# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:47
translate ptPT scr_WomansTouch_primer_3f1d3ec6:

    # ELENA @ talk "One day though, as we grew older... I was bathing once beneath some falls in the privacy of the woods."
