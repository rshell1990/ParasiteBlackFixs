    ELENA @ lewd "Era excitante... Ver um homem me desejando daquele jeito."

# game/data/world_quests/side/novaras/AWomansTouch/scr_Awomanstouch0.rpy:53
translate ptPT scr_WomansTouch_primer_6695437a:

