    CARINA @ smile "Muito bem, então são negócios."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:92
translate ptPT qst_beneath_shadows_enter_bordello_meet_carina_0aae20ad:

