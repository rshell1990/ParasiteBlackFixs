    MC @ talk "E é isso que você é?"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:96
translate ptPT qst_beneath_shadows_enter_bordello_meet_carina_82b13d1b:

