    CARINA @ talk "É quase uma pena, no entanto... Com um corpo como o dela, ela poderia facilmente ter evitado metade do estresse em sua vida se tivesse escolhido um caminho diferente!"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:116
translate ptPT qst_beneath_shadows_enter_bordello_meet_carina_menu_2aff2c96:

    # MC @ angry "Is this going somewhere?"
    MC @ angry "Isso está indo a algum lugar?"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:117
