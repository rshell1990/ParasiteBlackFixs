    CARINA @ talk "Eu, por minha vez, retribuo os favores para manter nosso relacionamento saudável."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:104
translate ptPT qst_beneath_shadows_enter_bordello_meet_carina_c0f99fde:

    # CARINA @ smile "Do you understand?"
    CARINA @ smile "Você entende?"

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:109
translate ptPT qst_beneath_shadows_enter_bordello_meet_carina_menu_1c4547a5:

