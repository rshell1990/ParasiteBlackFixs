# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:4
translate ptPT qst_DamzelDizzt_1_35069f7f:

    # "I have found Markus at his home."
    "Eu encontrei Markus em sua casa."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:5
translate ptPT qst_DamzelDizzt_1_debc0b3c:

    # "With the two of us, we should be able to deal with Nijah's situation easily enough."
    "Com nós dois, devemos conseguir lidar com a situação de Nijah com facilidade."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:10
translate ptPT qst_DamzelDizzt_1_a513ce4a:

    # MARKUS "What brings you here [player_name!t]?"
    MARKUS "O que traz você aqui [player_name!t]?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:11
translate ptPT qst_DamzelDizzt_1_403c03f6:

    # MC @ talk "Markus, I need your help with something..."
    MC @ talk "Markus, preciso da sua ajuda com algo..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:12
translate ptPT qst_DamzelDizzt_1_74ded93e:

    # MARKUS "Oh no..."
    MARKUS "Ah, não..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:13
translate ptPT qst_DamzelDizzt_1_3034a906:

    # MARKUS "Not that face, I can tell when you have THAT face it isn’t going to be anything I want to be involved in."
    MARKUS "Não essa cara, sei quando você está com ESSA cara, não vai ser nada em que eu queira me envolver."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:14
translate ptPT qst_DamzelDizzt_1_6fabec6f:

    # MC @ talk "I want your help clearing out a gang who are preying on the Ramonian people."
    MC @ talk "Quero sua ajuda para eliminar uma gangue que está atacando o povo ramoniano."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:15
translate ptPT qst_DamzelDizzt_1_3ed75d07:

    # MARKUS "Anddddd there it is!"
    MARKUS "Eeeee aí está!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:16
translate ptPT qst_DamzelDizzt_1_ac7ff2dc:

    # MARKUS "Impressive, one sentence in and I'm already shaking my head!"
    MARKUS "Impressionante, uma frase e já estou balançando a cabeça!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:17
translate ptPT qst_DamzelDizzt_1_fdca2051:

    # MC @ talk "Come on Markus!"
    MC @ talk "Vamos, Markus!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:18
translate ptPT qst_DamzelDizzt_1_57fc6b2b:

    # MARKUS "Why in all of Alderay are you dragging me into this mess?"
    MARKUS "Por que, por tudo em Alderay, você está me arrastando para essa confusão?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:19
translate ptPT qst_DamzelDizzt_1_6959558f:

    # MC @ talk "Because with our {i}‘gifts’{/i} we can have them gone by tonight!"
    MC @ talk "Porque com os nossos {i}‘dons’{/i} podemos nos livrar deles até esta noite!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:20
translate ptPT qst_DamzelDizzt_1_e98840aa:

    # MARKUS "Urghh! Always trying to be the bloody hero!"
    MARKUS "Urghh! Sempre tentando ser o maldito herói!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:21
translate ptPT qst_DamzelDizzt_1_a9be0c42:

    # MARKUS "... This is about a girl, isn’t it?"
    MARKUS "... Isso é sobre uma garota, não é?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:22
translate ptPT qst_DamzelDizzt_1_63a416dc:

    # MC @ talk "That... That doesn’t matter!"
    MC @ talk "Isso... Isso não importa!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:23
translate ptPT qst_DamzelDizzt_1_61d9172e:

    # MARKUS "Uhuh, yeah, it’s about a girl."
    MARKUS "Uhuh, sim, é sobre uma garota."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:24
translate ptPT qst_DamzelDizzt_1_8362d5b0:

    # MC @ talk "Markus!"
    MC @ talk "Markus!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:25
translate ptPT qst_DamzelDizzt_1_ce2626dc:

    # MARKUS "I don’t see why this is our business."
    MARKUS "Não vejo por que isso é da nossa conta."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:26
translate ptPT qst_DamzelDizzt_1_b3da4bfc:

    # MARKUS "Let the Ramonians sort out their own!"
    MARKUS "Deixe os ramonianos resolverem seus próprios problemas!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:27
translate ptPT qst_DamzelDizzt_1_d2020b8b:

    # MARKUS "They keep to their end; I keep to mine."
    MARKUS "Eles cumprem a parte deles; eu cumpro a minha."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:28
translate ptPT qst_DamzelDizzt_1_a042b2ed:

    # MC @ talk "I need you for this one."
    MC @ talk "Preciso de você para esta."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:29
translate ptPT qst_DamzelDizzt_1_d5cb57af:

    # MC @ talk "I'm going to do it with, or without you."
    MC @ talk "Vou fazer isso com ou sem você."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:30
translate ptPT qst_DamzelDizzt_1_4f3400b3:

    # MARKUS "..."
    MARKUS "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:31
translate ptPT qst_DamzelDizzt_1_1897d03c:

    # MC @ talk "Now either you'll help me, or you won't."
    MC @ talk "Agora ou você me ajuda, ou não."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:32
translate ptPT qst_DamzelDizzt_1_b85d7e3a:

    # "Markus thought about it for a moment before sighing,"
    "Markus pensou sobre isso por um momento antes de suspirar,"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:33
translate ptPT qst_DamzelDizzt_1_75bfbc25:

    # MARKUS "... Fine."
    MARKUS "... Tudo bem."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:34
translate ptPT qst_DamzelDizzt_1_fbbbbf0e:

    # MARKUS "You know if I didn’t love you like a brother this would never happen, right?"
    MARKUS "Você sabe que se eu não te amasse como um irmão, isso nunca aconteceria, certo?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:35
translate ptPT qst_DamzelDizzt_1_d9069cd6:

    # MC @ talk "I owe you for this, Markus."
    MC @ talk "Te devo essa, Markus."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:36
translate ptPT qst_DamzelDizzt_1_b6bca739:

    # MARKUS "You owe me nothing you bloody fool."
    MARKUS "Você não me deve nada, seu tolo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:37
translate ptPT qst_DamzelDizzt_1_dd6bcf04:

    # MC @ talk "Then come, we have to head back to mine to plan for tonight..."
    MC @ talk "Então venha, temos que voltar para a minha casa para planejar a noite de hoje..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:38
translate ptPT qst_DamzelDizzt_1_b66b98c0:

    # "Markus nodded as he traipsed behind me back to mine."
    "Markus assentiu enquanto me seguia de volta para a minha."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:51
translate ptPT qst_DamzelDizzt_1_c2812d37:

    # MARKUS "Well, are you ready to discuss whatever you've just dragged me into?"
    MARKUS "Bem, você está pronto para discutir o que quer que tenha me arrastado para isso?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:53
translate ptPT qst_DamzelDizzt_1_c672a5c1:

    # "Nijah explained to us everything she could about Tarek and his men."
    "Nijah nos explicou tudo o que pôde sobre Tarek e seus homens."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:55
translate ptPT qst_DamzelDizzt_1_1854e7fe:

    # "She told us what she could remember of visiting the {i}Black Diamond{/i} herself when she came seeking a loan,"
    "Ela nos contou o que conseguia lembrar de ter visitado o {i}Black Diamond{/i} pessoalmente quando veio buscar um empréstimo,"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:56
translate ptPT qst_DamzelDizzt_1_8cedb000:

    # "And she told us that we should expect nearly two dozen of them inside, including Tarek himself."
    "E nos disse que deveríamos esperar quase duas dúzias deles lá dentro, incluindo o próprio Tarek."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:57
translate ptPT qst_DamzelDizzt_1_9f57a2c5:

    # "Through a complex series of heavy bribes, Tarek and his men have been allowed to continue uninterrupted by the City Guard,"
    "Através de uma complexa série de subornos pesados, Tarek e seus homens puderam continuar sem interrupções da Guarda da Cidade,"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:58
translate ptPT qst_DamzelDizzt_1_37072507:

    # "So it seems taking the matter to the law was now out of the question entirely."
    "Então parece que levar o caso à lei agora estava totalmente fora de questão."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:67
translate ptPT qst_DamzelDizzt_1_9696dba6:

    # MARKUS "That’s... a lot of men, you know."
    MARKUS "Isso é... muitos homens, sabe."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:68
translate ptPT qst_DamzelDizzt_1_fde497bf:

    # MARKUS "If we kick the door in, claws out, no doubt the City Guard will come to see what the ruckus is about."
    MARKUS "Se arrombarmos a porta, garras à mostra, sem dúvida a Guarda da Cidade virá ver o que é o barulho."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:69
translate ptPT qst_DamzelDizzt_1_13ff6a8a:

    # NIJAH "Tarek's Office below..."
    NIJAH "O Escritório de Tarek abaixo..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:70
translate ptPT qst_DamzelDizzt_1_a579157d:

    # MARKUS "Below?"
    MARKUS "Embaixo?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:71
translate ptPT qst_DamzelDizzt_1_a67dc49b:

    # NIJAH "Yis, zer is a iron door zat leads to his office below..."
    NIJAH "Sim, há uma porta de ferro que leva ao seu escritório lá embaixo..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:72
translate ptPT qst_DamzelDizzt_1_7430f31b:

    # MARKUS "They’re no doubt armed and ready... This might be like trying to storm a small fortress."
    MARKUS "Eles estão sem dúvida armados e prontos... Isto pode ser como tentar invadir uma pequena fortaleza."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:73
translate ptPT qst_DamzelDizzt_1_b44c150a:

    # MARKUS "Not to mention the people already there who might get caught up in the fight."
    MARKUS "Sem falar nas pessoas que já estão lá e podem ser apanhadas no meio da luta."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:74
translate ptPT qst_DamzelDizzt_1_95ab635e:

    # MC @ talk "You’re not bailing out on me, right?"
    MC @ talk "Você não vai me abandonar, certo?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:75
translate ptPT qst_DamzelDizzt_1_602c4eda:

    # MARKUS "Of course not, I've been itchin' to test our powers some more."
    MARKUS "Claro que não, eu estava louco para testar nossos poderes mais um pouco."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:76
translate ptPT qst_DamzelDizzt_1_4dc282fe:

    # MARKUS "But this isn't exactly what I had in mind."
    MARKUS "Mas isso não é exatamente o que eu tinha em mente."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:77
translate ptPT qst_DamzelDizzt_1_2f7c0e92:

    # "Nijah raised a curious eyebrow at the phrase."
    "Nijah ergueu uma sobrancelha curiosa com a frase."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:78
translate ptPT qst_DamzelDizzt_1_47f4e66c:

    # NIJAH "Powers?"
    NIJAH "Poderes?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:79
translate ptPT qst_DamzelDizzt_1_b2c12961:

    # MARKUS "Uhh, never mind."
    MARKUS "Uhh, deixa pra lá."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:80
translate ptPT qst_DamzelDizzt_1_9ca4de31:

    # MC @ talk "So, any ideas then?"
    MC @ talk "Então, alguma ideia?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:81
translate ptPT qst_DamzelDizzt_1_16cd313d:

    # MARKUS "Well, our first option is that we just kick the door in and slaughter everyone inside."
    MARKUS "Bem, nossa primeira opção é simplesmente chutar a porta e matar todo mundo lá dentro."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:82
translate ptPT qst_DamzelDizzt_1_4841c7eb:

    # MARKUS "The second, if what Nijah is telling us is right, is that Tarek seems to be the only one holding together a loose connection of gangs."
    MARKUS "A segunda, se o que Nijah está nos dizendo estiver certo, é que Tarek parece ser o único que mantém unida uma conexão frouxa de gangues."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:83
translate ptPT qst_DamzelDizzt_1_5ae2fd2f:

    # "As long as we can get rid of him one way or another, we shouldn’t need to deal with the others."
    "Desde que possamos nos livrar dele de um jeito ou de outro, não precisaremos lidar com os outros."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:84
translate ptPT qst_DamzelDizzt_1_1db74374:

    # MARKUS "They’ll fall apart without him."
    MARKUS "Eles vão se desintegrar sem ele."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:85
translate ptPT qst_DamzelDizzt_1_81686189:

    # MC @ talk "Any other ideas?"
    MC @ talk "Mais alguma ideia?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:86
translate ptPT qst_DamzelDizzt_1_87531cb4:

    # MARKUS "Hmm... I guess we could try persuading him very nicely to leave but..."
    MARKUS "Hmm... Acho que poderíamos tentar convencê-lo muito educadamente a ir embora, mas..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_1.rpy:87
translate ptPT qst_DamzelDizzt_1_42fe984c:

    # MARKUS "Something tells me that isn’t going to work."
    MARKUS "Algo me diz que isso não vai funcionar."

