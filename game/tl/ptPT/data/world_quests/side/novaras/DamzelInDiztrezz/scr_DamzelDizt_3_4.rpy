translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_78b70b60:

    # MC @ talk "We plan to set you up in the Bay of Valor."
    MC @ talk "Planejamos estabelecê-lo na Baía do Valor."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:101
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_066f3add:

    # MC @ talk "We think you’ll be more useful to us smuggling there."
    MC @ talk "Achamos que você será mais útil para nós contrabandeando lá."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:102
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_2f43dddf:

    # TAREK "Tsch! You want me to leave Novaras for some second-rate dock city?"
    TAREK "Tsc! Quer que eu deixe Novaras por uma cidade portuária de segunda categoria?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:103
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_8e65d3f7:

    # MC @ talk "It’s more lucrative there than you imagine."
    MC @ talk "É mais lucrativo lá do que você imagina."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:104
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_3799b249:

    # MC @ talk "Access to the Port will give you reach to Synmaria and more, only a fool couldn't see the value in that."
    MC @ talk "O acesso ao Porto lhe dará alcance a Synmaria e mais, só um tolo não veria o valor nisso."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:105
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_60a2e3b2:

    # TAREK "Hmph... We shall see."
    TAREK "Hmph... Veremos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:106
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_09692602:

    # MC @ talk "And... to help smooth things over, that is why we have brought you Nijah."
    MC @ talk "E... para ajudar a suavizar as coisas, é por isso que trouxemos Nijah para você."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:107
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_139efba1_5:

    # TAREK "..."
    TAREK "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:108
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_239aa8f7:

    # "Nijah's eyes refused to lift from the floor."
    "Os olhos de Nijah se recusavam a se erguer do chão."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:109
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_f681d47e:

    # MC @ talk "To take with you on your travels. A companion for... {i}all of your needs.{/i}"
    MC @ talk "Para levar com você em suas viagens. Um companheiro para... {i}todas as suas necessidades.{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:110
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_4e34dc0e:

    # "Nijah looked away in disgust as Tarek smiled."
    "Nijah desviou o olhar com desgosto enquanto Tarek sorria."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:111
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_26a45b77:

    # TAREK "I suppose something good has come from this."
    TAREK "Suponho que algo de bom tenha surgido disso."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:112
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_dde0c440:

    # "Pouring out the cup of wine, I handed it to him."
    "Derramando a taça de vinho, eu a entreguei a ele."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:113
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_92e1c239:

    # MC @ talk "For the riches yet to come."
    MC @ talk "Pelas riquezas que ainda estão por vir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:114
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_e877fb5b:

    # TAREK "Well... That sounds like something I might be willing to drink to."
    TAREK "Bem... Isso soa como algo pelo qual eu estaria disposto a beber."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:115
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_e573f174:

    # "As Tarek held up the cup, he tormentingly remarked to Nijah."
    "Enquanto Tarek erguia a taça, ele fez um comentário atormentador a Nijah."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:116
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_540e8055:

    # TAREK "I always told you in the end you would be mine Nijah, one way or another."
    TAREK "Eu sempre te disse que no fim você seria minha, Nijah, de um jeito ou de outro."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:117
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_fbd49721:

    # NIJAH "..."
    NIJAH "..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:118
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_dff85687:

    # TAREK "Friends, drink with me."
    TAREK "Amigos, bebam comigo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:119
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_248b2a40:

    # "Me and Markus shared a nervous glance for a moment."
    "Eu e Markus trocamos um olhar nervoso por um momento."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:120
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_78f307c6:

    # BLACK "Drink... Fear not..."
    BLACK "Bebam... Não temam..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:121
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_8ddf6569:

    # "Tarek stared at us uncertainly, guaging our delay and reaction."
    "Tarek nos encarou incerto, avaliando nossa hesitação e reação."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:122
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_51d7ad26:

    # TAREK "...Is something wrong friends?"
    TAREK "...Há algo errado, amigos?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:123
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_707f20c7:

    # MC @ talk "Not at all Tarek, we just prefer not to drink on the job ourselves."
    MC @ talk "De forma alguma, Tarek, apenas preferimos não beber durante o trabalho."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:124
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_407c76e6:

    # "Feigning as much confidence as I could, I poured me and Markus a cup each."
    "Fingindo o máximo de confiança que pude, servi uma xícara para mim e para o Markus."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:125
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_892f9cf9:

    # MC "(Fuck fuck fuck, are we actually about to drink poison? By the gods monster if you're-)"
    MC "(Merda merda merda, estamos realmente prestes a beber veneno? Pelos deuses, monstro, se você está-)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:126
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_e70f96ee:

    # BLACK "Trust"
    BLACK "Confie"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:127
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_730215d9:

    # WHITE "Us."
    WHITE "em nós."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:128
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_48d0f839:

    # MC "(Should I?)"
    MC "(Devo?)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:129
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_2ddadf32:

    # MC "(So far these things inside of us have not lied before.)"
    MC "(Até agora, essas coisas dentro de nós não mentiram antes.)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:130
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_09613066:

    # MC "(But now they are asking us to trust them and drink literal poison...)"
    MC "(Mas agora eles estão nos pedindo para confiar neles e beber veneno literal...)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:133
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_275b6aad:

    # MC @ talk "Neither of us drink, sorry."
    MC @ talk "Nenhum de nós bebe, desculpe."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:134
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_d10f1028:

    # "Tarek looked down at the cup, the swirling red liquid in his drink before his eyes raised and looked deathly towards us."
    "Tarek olhou para o copo, o líquido vermelho girando em sua bebida antes de levantar os olhos e olhar mortalmente para nós."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:135
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_080e9ca4:

    # TAREK "{i}...Deceivers.{/i}"
    TAREK "{i}...Enganadores.{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:136
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_b0227428:

    # MC @ talk "(Shit!)"
    MC @ talk "(Merda!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:137
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_52a45021:

    # TAREK "ASSASSINS! MEN! DRAW YOUR BLADES!"
    TAREK "ASSASSINOS! HOMENS! PUXEM SUAS LÂMINAS!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:138
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_97c5ba11:

    # MARKUS "Well, time for plan B!"
    MARKUS "Bem, hora do plano B!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:142
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_82b10757:

    # "I sighed, looking to Markus to give a nod of approval as we both gulped down the wine together."
    "Eu suspirei, olhando para Markus para dar um aceno de aprovação enquanto ambos engolíamos o vinho juntos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:143
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_99172c4a:

    # "Tarek waited a few seconds, his eyes looking over to see if we were about to drop dead at any moment."
    "Tarek esperou alguns segundos, seus olhos observando para ver se íamos cair mortos a qualquer momento."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:144
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_d532ff0a:

    # "Satisfied when we did not, he smiled."
    "Satisfeito quando não caímos, ele sorriu."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:145
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_1e681fd0:

    # "Tarek gulped the wine down, confident that despite the setback, he would restart his ‘empire’ elsewhere."
    "Tarek engoliu o vinho de uma vez, confiante de que, apesar do contratempo, recomeçaria seu 'império' em outro lugar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:146
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_85e88380:

    # "But this time, with Nijah, subservient at his side and warming his bed every night."
    "Mas desta vez, com Nijah, submissa ao seu lado e aquecendo sua cama todas as noites."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:147
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_bc75c2c8:

    # "Perhaps even, with access to the dock, he would make riches beyond his wildest dreams."
    "Talvez até, com acesso ao cais, fizesse riquezas além dos seus sonhos mais loucos."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:148
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_7fbddc5e:

    # "...But that dream was short-lived."
    "...Mas esse sonho durou pouco."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:149
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_4ce2d32b:

    # "After a few seconds passed by, Tarek stopped smiling."
    "Após alguns segundos, Tarek parou de sorrir."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:150
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_a5370807:

    # "With a shaking hand, he dropped the cup to the floor and the wine poured out all over it."
    "Com a mão trêmula, deixou cair a taça no chão e o vinho se derramou por todo o chão."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:151
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_783b00ad:

    # "The two guards who waited behind us drew their blades in a panic but I turned too quickly for them to even unsheathe their blades in time."
    "Os dois guardas que esperavam atrás de nós sacaram suas lâminas em pânico, mas eu me virei rápido demais para que eles conseguissem desembainhar suas lâminas a tempo."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:156
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_7dd553e9:

    # "From my back, two protruding tentacles quickly emerged and slammed their heads against the wall."
    "Das minhas costas, dois tentáculos protuberantes emergiram rapidamente e bateram as cabeças deles contra a parede."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:157
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_5ad22fb5:

    # "As I severed their heads off, the two corpses slumped down lifelessly against the wall, leaving behind dragging blood trails."
    "Ao decepar suas cabeças, os dois corpos caíram sem vida contra a parede, deixando para trás trilhas de sangue."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:167
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_914bd7e2:

    # "Nijah, now terrified, kicked away her chair as she jumped away from us, ready to scream in terror."
    "Nijah, agora aterrorizada, afastou a cadeira com um chute enquanto pulava para longe de nós, pronta para gritar de terror."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:168
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_9b3f7f14:

    # "I motioned desperately for her to be silent, but there was a wide-eyed terror in her eyes and I knew she might scream any moment."
    "Fiz sinal desesperadamente para que ela ficasse em silêncio, mas havia um terror de olhos arregalados em seus olhos e eu sabia que ela poderia gritar a qualquer momento."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:169
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_16e76f01:

    # "Markus quickly rose to his feet, and grabbed her."
    "Markus rapidamente se levantou e a agarrou."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:170
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_d815c03a:

    # "Covering her mouth as he motioned again for her to be quiet."
    "Cobrindo sua boca enquanto sinalizava novamente para que ela ficasse quieta."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:171
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_1b45bda4:

    # MARKUS "If you scream this place will become a bloodbath!"
    MARKUS "Se você gritar, este lugar se tornará um banho de sangue!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:172
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_aa600d0f:

    # "After a few minues of restless breathing, Nijah slowly began to calm."
    "Após alguns minutos de respiração inquieta, Nijah começou a se acalmar lentamente."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:173
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_a7730668:

    # MARKUS "You weren't supposed to see that... But we need you to stay calm, can you do that?"
    MARKUS "Você não deveria ter visto isso... Mas precisamos que você fique calma, pode fazer isso?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:174
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_bd842606:

    # "Nijah nodded anxiously as Markus slowly loosened his grip over her mouth."
    "Nijah assentiu ansiosamente enquanto Markus afrouxava lentamente o aperto sobre sua boca."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:175
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_71a25315:

    # "Tarek, now writhing in agony on the floor, desperately wheezed as he struggled to breathe."
    "Tarek, agora se contorcendo de agonia no chão, chiava desesperadamente enquanto lutava para respirar."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:176
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_d7439580:

    # "His eyes rolled white as his jaw locked and he began to foam at the mouth. He clawed furiously at his throat..."
    "Seus olhos reviraram e ficaram brancos enquanto sua mandíbula travava e ele começou a espumar pela boca. Ele arranhou furiosamente a própria garganta..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:177
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_92d6cbf9:

    # "Tearing through his own neck, the violent convulsions stopped as two bloody trails emerged from both of his eyes and dripped down onto the floor."
    "Rasgando o próprio pescoço, as violentas convulsões pararam quando dois rastros sanguinolentos emergiram de ambos os olhos e pingaram no chão."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:178
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_428a3c12:

    # "After a few more convulsions, Tarek stopped, blood gurgling out of his mouth."
    "Depois de mais algumas convulsões, Tarek parou, com sangue borbulhando de sua boca."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:179
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_dfe2dc08:

    # MC @ talk "... Is he dead?"
    MC @ talk "... Ele está morto?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:180
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_9511ec9b:

    # "...I finally asked after a few moments of silence passed."
    "...Eu finalmente perguntei depois que alguns momentos de silêncio se passaram."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:181
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_4bf231fb:

    # MARKUS "He’s seen better days."
    MARKUS "Ele já teve dias melhores."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:182
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_843da995:

    # NIJAH "We go, {i}now!{/i}"
    NIJAH "Nós vamos, {i}agora!{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:184
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_bd7f1c1d:

    # "Both me and Markus nodded and transformed back into our human forms."
    "Tanto eu quanto Markus assentimos com a cabeça e nos transformamos de volta em nossas formas humanas."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:185
translate ptPT qst_DamzelDizzt_3_talkTarek_successCharm_a0d78fb7:

    # "About to leave, I snatched a hefty pouch of gold from Tarek's table."
    "Prestes a sair, peguei uma pesada bolsa de ouro da mesa de Tarek."

translate ptPT strings:

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:10
