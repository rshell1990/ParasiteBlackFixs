# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:4
translate ptPT qst_DaughterOfMetal_02_e49702b7:

    # "Arlena approached me with a drink in her hand."
    "Arlena se aproximou de mim com uma bebida na mão."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:6
translate ptPT qst_DaughterOfMetal_02_f40ee011:

