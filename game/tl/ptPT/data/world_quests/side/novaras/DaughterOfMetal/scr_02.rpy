    MC @ talk "Nem eu nem Markus jamais tivemos a intenção de machucar ninguém."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:75
translate ptPT qst_DaughterOfMetal_02_0d507896:

    # "Arlena fidgeted, she seemed to be trying to hide herself in the bottom of her drink."
    "Arlena se remexeu, parecia estar tentando se esconder no fundo do seu copo."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:76
translate ptPT qst_DaughterOfMetal_02_0d0b128f:

