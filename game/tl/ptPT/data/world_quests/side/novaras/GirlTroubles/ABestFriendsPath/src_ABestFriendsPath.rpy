translate ptPT qst_a_best_friends_path_10_29e9743d:

    # DIVINE @ sad "You have never been a disappointment to me, Mika."
    DIVINE @ sad "Nunca foste uma desilusão para mim, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:947
translate ptPT qst_a_best_friends_path_10_6fee3cf3:

    # DIVINE @ sad "You, nor any of the other girls."
    DIVINE @ sad "Tu, nem nenhuma das outras raparigas."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:948
translate ptPT qst_a_best_friends_path_10_c2471857:

    # "Mika didn't answer; she bowed her head ashamedly to the floor, still sniffling."
    "Mika não respondeu; baixou a cabeça envergonhada para o chão, ainda a fungar."

