translate ptPT qst_a_best_friends_path_10_314a3574:

    # "Sister Divine tilted her head towards me, her eyes meeting mine."
    "A Irmã Divine inclinou a cabeça para mim, os olhos a encontrarem-se com os meus."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:963
translate ptPT qst_a_best_friends_path_10_4ae73fa7:

    # DIVINE @ think "{i}And Mika must never know that the letters never arrived.{/i}"
    DIVINE @ think "{i}E a Mika nunca deve saber que as cartas nunca chegaram.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:964
translate ptPT qst_a_best_friends_path_10_cd44bde4:

    # "Understanding that was an order, not a suggestion, I nodded in agreement."
    "Compreendendo que era uma ordem, não uma sugestão, assenti em concordância."

