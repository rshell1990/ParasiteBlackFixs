    # DIVINE @ think "I can sense a great change within Mika... Tomorrow, her training will be complete."
    DIVINE @ think "Consigo sentir uma grande mudança na Mika... Amanhã, o treino dela estará completo."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:967
translate ptPT qst_a_best_friends_path_10_d789b742:

    # MC @ think "How can you be sure?"
    MC @ think "Como podes ter a certeza?"

