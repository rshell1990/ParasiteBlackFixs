translate ptPT qst_a_best_friends_path_12_102b4a4c:

    # "As I smiled at her, I could feel the absolute adoration emitting from her eyes."
    "Enquanto lhe sorria, conseguia sentir a adoração absoluta a emanar dos olhos dela."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1012
translate ptPT qst_a_best_friends_path_12_5789ab10:

    # MC @ smile "You'll do great things, Mika, of that I'm sure."
