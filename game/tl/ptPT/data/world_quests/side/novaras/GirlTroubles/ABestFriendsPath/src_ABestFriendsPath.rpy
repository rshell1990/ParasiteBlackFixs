translate ptPT qst_a_best_friends_path_10_9dc108f5:

    # DIVINE @ happy "She's still afraid... But she's no longer letting it hold her back."
    DIVINE @ happy "Ela ainda tem medo... Mas já não está a deixar que isso a prenda."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:970
