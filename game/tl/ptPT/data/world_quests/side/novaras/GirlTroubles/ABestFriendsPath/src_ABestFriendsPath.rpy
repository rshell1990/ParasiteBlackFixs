translate ptPT qst_a_best_friends_path_10_e9eb2636:

    # "Her expression was stern, but the pain beneath the mask was visible beneath the cracks."
    "A sua expressão era severa, mas a dor sob a máscara era visível nas fissuras."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:982
translate ptPT qst_a_best_friends_path_12_796311fa:

    # MIKA @ talk "I - I'm ready for my final test!"
    MIKA @ talk "Eu - Estou pronta para o meu teste final!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:985
translate ptPT qst_a_best_friends_path_12_dbf800f2:

    # MIKA @ smile "This time, I'll definitely win!"
    MIKA @ smile "Desta vez, vou ganhar de certeza!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:995
translate ptPT qst_a_best_friends_path_12_7b2ca3a2:

    # MIKA @ sad "D-Damn it!"
    MIKA @ sad "M-Maldição!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:996
translate ptPT qst_a_best_friends_path_12_a17c8474:

    # MC @ talk "{i}*Huff*{/i} Don't put yourself down..."
    MC @ talk "{i}*Bufo*{/i} Não te rebaixes..."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:997
translate ptPT qst_a_best_friends_path_12_5aa7d33e:

    # MC @ smile "You're ready, Mika."
    MC @ smile "Estás pronta, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:998
translate ptPT qst_a_best_friends_path_12_ea52f159:

    # MIKA @ shock "But... {i}I lost!{/i}"
    MIKA @ shock "Mas... {i}Eu perdi!{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:999
translate ptPT qst_a_best_friends_path_12_251b742b:

    # MC @ smile "Trust me, you can handle a few Demorai."
    MC @ smile "Confia em mim, consegues lidar com uns quantos Demorai."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1000
translate ptPT qst_a_best_friends_path_12_4a01728e:

    # MC @ smile "{i}You're ready.{/i}"
    MC @ smile "{i}Estás pronta.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1002
translate ptPT qst_a_best_friends_path_12_56a568cd:

    # MIKA @ shock "I... {i}I did it!{/i}"
    MIKA @ shock "Eu... {i}Consegui!{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1003
translate ptPT qst_a_best_friends_path_12_d3e6b05e:

    # MC @ smile "Well done, Mika."
    MC @ smile "Muito bem, Mika."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1004
translate ptPT qst_a_best_friends_path_12_949782d6:

    # MC @ smile "You're definitely ready."
    MC @ smile "Estás definitivamente pronta."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1006
translate ptPT qst_a_best_friends_path_12_805ce692:

    # "Mika leapt into my arms for a tight hug, squealing happily before pulling herself away."
    "A Mika saltou para os meus braços para um abraço apertado, guinchando feliz antes de se afastar."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1007
translate ptPT qst_a_best_friends_path_12_a5cfade8:

    # MIKA @ smile "I did it! I can't believe I actually did it!"
    MIKA @ smile "Consegui! Não acredito que consegui mesmo!"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1008
translate ptPT qst_a_best_friends_path_12_48530dcf:

    # MC @ smile "I'll let Sister Divine know you're ready."
    MC @ smile "Vou dizer à Irmã Divine que estás pronta."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1009
translate ptPT qst_a_best_friends_path_12_e1e68368:

    # MIKA @ smile "T-Thank you... [player_name!t]."
    MIKA @ smile "O-Obrigada... [player_name!t]."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:1010
translate ptPT qst_a_best_friends_path_12_458cfc4d:

    # MIKA @ smile "For believing in me."
    MIKA @ smile "Por acreditares em mim."

