translate ptPT qst_a_best_friends_path_10_4d3cd16e:

    # DIVINE @ sad "We'll speak of this again, just the two of us, do you understand?"
    DIVINE @ sad "Falaremos disto outra vez, só nós as duas, percebes?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:950
translate ptPT qst_a_best_friends_path_10_f4592411:

