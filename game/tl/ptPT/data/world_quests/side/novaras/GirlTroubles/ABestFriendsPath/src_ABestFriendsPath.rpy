translate ptPT qst_a_best_friends_path_10_39bb73e7:

    # MC @ talk "...Will the families ever receive those letters she wrote?"
    MC @ talk "...As famílias alguma vez receberão aquelas cartas que ela escreveu?"

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:959
translate ptPT qst_a_best_friends_path_10_fb9ddaad:

    # DIVINE @ think "No."
    DIVINE @ think "No."

# game/data/world_quests/side/novaras/GirlTroubles/ABestFriendsPath/src_ABestFriendsPath.rpy:961
translate ptPT qst_a_best_friends_path_10_86429564:

    # DIVINE @ think "To let them out would risk another scandal we can't afford."
    DIVINE @ think "Deixá-las sair arriscaria outro escândalo que não podemos pagar."

