# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:2
translate ptPT scr_SharedInThorns_askForClues_c2e0d1b4:

    # ELENA @ grumpy "Hm? Well, I'll try answer whatever questions you may have."
    ELENA @ grumpy "Hum? Bem, tentarei responder a quaisquer perguntas que você possa ter."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:5
translate ptPT scr_SharedInThorns_askForClues_menu_d79a3cc5:

    # ELENA @ grumpy "I was found abandoned as a child by the then lord of the Thornfall Estate on the boundaries of their land."
    ELENA @ grumpy "Fui encontrada abandonada quando era criança pelo então senhor da Herdade Thornfall nos limites das suas terras."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:6
translate ptPT scr_SharedInThorns_askForClues_menu_e5ab6524:

    # ELENA @ grumpy "Lord Vront Thornfall."
    ELENA @ grumpy "Lorde Vront Thornfall."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:7
translate ptPT scr_SharedInThorns_askForClues_menu_4d98b88b:

    # MC @ talk "What happened to your parents?"
    MC @ talk "O que aconteceu com seus pais?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:8
translate ptPT scr_SharedInThorns_askForClues_menu_7c32d875:

    # ELENA @ sad "I do not know."
    ELENA @ sad "Não sei."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:9
translate ptPT scr_SharedInThorns_askForClues_menu_860cfc4e:

    # ELENA @ sad "I was found sick and alone."
    ELENA @ sad "Fui encontrado doente e sozinho."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:10
translate ptPT scr_SharedInThorns_askForClues_menu_f26b0328:

    # ELENA @ grumpy "Lord Vront nursed me back to health, but made me swear to always protect his only heir, the lady Grace."
    ELENA @ grumpy "Lord Vront tratou-me de volta à saúde, mas fez-me jurar proteger sempre a sua única herdeira, a senhora Grace."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:11
translate ptPT scr_SharedInThorns_askForClues_menu_56b1b419:

    # MC @ talk "Strange for a Lord to only have one daughter."
    MC @ talk "Estranho um Lord ter apenas uma filha."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:12
translate ptPT scr_SharedInThorns_askForClues_menu_2fe2c041:

    # ELENA @ sad "Yes... Lord Vront was a complex man, he rarely opened up but as I understood it, much tragedy had befallen him in the past."
    ELENA @ sad "Sim... Lord Vront era um homem complexo, raramente se abria, mas pelo que percebi, muita tragédia tinha caído sobre ele no passado."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:13
translate ptPT scr_SharedInThorns_askForClues_menu_9ac95035:

    # MC @ talk "Tragedy?"
    MC @ talk "Tragédia?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:14
translate ptPT scr_SharedInThorns_askForClues_menu_87c336c4:

    # ELENA @ grumpy "He wouldn't discuss such things with me, all that matters is that I kept his vow."
    ELENA @ grumpy "Ele não discutia tais coisas comigo, tudo o que importa é que eu mantivesse o seu voto."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:15
translate ptPT scr_SharedInThorns_askForClues_menu_18958e13:

    # MC "(It may be worth looking up to see if I can find anything about the Thornfall family's history, perhaps it may offer some clues as to the Lady Grace.)"
    MC "(Pode valer a pena investigar para ver se consigo encontrar algo sobre a história da família Thornfall, talvez possa oferecer algumas pistas sobre a Senhora Grace.)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:24
translate ptPT scr_SharedInThorns_askForClues_menu_9fd852c4:

    # ELENA @ talk "She was blonde with long curly hair when I last saw her."
    ELENA @ talk "Ela era loira com longos cabelos cacheados quando a vi pela última vez."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:25
translate ptPT scr_SharedInThorns_askForClues_menu_370c4084:

    # ELENA @ talk "...It has been a few years."
    ELENA @ talk "...Já passaram uns anos."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:26
translate ptPT scr_SharedInThorns_askForClues_menu_45314067:

    # MC @ talk "You didn't keep in touch?"
    MC @ talk "Você não manteve contato?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:27
translate ptPT scr_SharedInThorns_askForClues_menu_5429ff7b:

    # ELENA @ sad "We exchanged letters for a while but the war caused such long delays it became impossible."
    ELENA @ sad "Troçámos cartas durante algum tempo, mas a guerra causou atrasos tão longos que se tornou impossível."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:28
translate ptPT scr_SharedInThorns_askForClues_menu_dc4364b5:

    # MC @ talk "I see... No portraits of the lady remain?"
    MC @ talk "Entendo... Não restam retratos da senhora?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:29
translate ptPT scr_SharedInThorns_askForClues_menu_b691c649:

    # ELENA @ talk "None in my possession, and those that littered the Estate were her as a child."
    ELENA @ talk "Nenhum na minha posse, e os que estavam espalhados pela Herdade eram dela quando criança."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:30
translate ptPT scr_SharedInThorns_askForClues_menu_1876764f:

    # ELENA @ grumpy "Of little used to us now I am afraid."
    ELENA @ grumpy "De pouco acostumado a nós agora, receio."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:33
translate ptPT scr_SharedInThorns_askForClues_menu_2_b7723557:

    # ELENA @ grumpy "The lady Grace once mentioned she was funding some kind of expedition overseas, but she refused to elaborate on what it was she was looking for or where it was..."
    ELENA @ grumpy "A senhora Grace mencionou uma vez que estava financiando algum tipo de expedição no exterior, mas se recusou a explicar o que estava procurando ou onde estava..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:34
translate ptPT scr_SharedInThorns_askForClues_menu_2_7fd973eb:

    # MC @ talk "Did Lord Vront mention this expedition?"
    MC @ talk "Lord Vront mencionou esta expedição?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:35
translate ptPT scr_SharedInThorns_askForClues_menu_2_19256f3a:

    # ELENA @ shock "He said it was a matter of most urgency."
    ELENA @ shock "Ele disse que era um assunto da maior urgência."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:36
translate ptPT scr_SharedInThorns_askForClues_menu_2_4daadf86:

    # ELENA @ talk "He said when the time came, he would explain everything..."
    ELENA @ talk "Ele disse que quando chegasse a hora ele explicaria tudo..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:37
translate ptPT scr_SharedInThorns_askForClues_menu_2_7e9fdbba:

    # ELENA @ sad "But then one night, he cast himself off the cliffs onto the rocks below, let the tide take him out."
    ELENA @ sad "Mas então, uma noite, ele se jogou dos penhascos nas rochas abaixo, deixando a maré levá-lo."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:38
translate ptPT scr_SharedInThorns_askForClues_menu_2_f2cbd5a2:

    # MC @ talk "What? What possessed him to do such a thing?"
    MC @ talk "O quê? O que o possuiu para fazer tal coisa?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:39
translate ptPT scr_SharedInThorns_askForClues_menu_2_18f6709b:

    # ELENA @ sad "I do not know... He was quieter than normal with the days leading up to his dead."
    ELENA @ sad "Não sei... Ele estava mais calmo do que o normal nos dias que antecederam a sua morte."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:40
translate ptPT scr_SharedInThorns_askForClues_menu_2_364286f4:

    # MC "(Foreign expeditions... Perhaps someone might know something of this?)"
    MC "(Expedições estrangeiras... Talvez alguém saiba algo sobre isso?)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:50
translate ptPT scr_SharedInThorns_askForClues_menu_2_2b9a6d68:

    # ELENA @ grumpy "Strange?"
    ELENA @ grumpy "Estranho?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:51
translate ptPT scr_SharedInThorns_askForClues_menu_2_a5511ea2:

    # ELENA @ grumpy "You mean aside from humans willing to take in one such as myself?"
    ELENA @ grumpy "Queres dizer, além de humanos dispostos a acolher alguém como eu?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:52
translate ptPT scr_SharedInThorns_askForClues_menu_2_f14763c1:

    # MC @ talk "Think... Was there anything you found strange in all your years there?"
    MC @ talk "Pense... Houve alguma coisa que você achou estranho em todos os seus anos lá?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:53
translate ptPT scr_SharedInThorns_askForClues_menu_2_4aa067c8:

    # "Elena seemed to ponder my question for a while before she answered sheepishly."
    "Elena pareceu ponderar a minha pergunta durante algum tempo antes de responder timidamente."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:54
translate ptPT scr_SharedInThorns_askForClues_menu_2_cfb39a1b:

    # ELENA @ grumpy "...Lord Vront had various bolts and locks on his room door from the outside."
    ELENA @ grumpy "...Lorde Vront tinha vários ferrolhos e fechaduras na porta de seu quarto pelo lado de fora."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:55
translate ptPT scr_SharedInThorns_askForClues_menu_2_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "O que?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:56
translate ptPT scr_SharedInThorns_askForClues_menu_2_d385cc7e:

    # ELENA @ grumpy "The servants every night would lock the door and open it come morning."
    ELENA @ grumpy "Os criados todas as noites trancavam a porta e a abriam pela manhã."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:57
translate ptPT scr_SharedInThorns_askForClues_menu_2_580d3cbd:

    # MC @ talk "Did you ever hear anything the other side of the door?"
    MC @ talk "Você já ouviu alguma coisa do outro lado da porta?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:58
translate ptPT scr_SharedInThorns_askForClues_menu_2_4c0113b4:

    # ELENA @ grumpy "I wasn't even allowed in that wing of the Estate come nightfall."
    ELENA @ grumpy "Eu nem tinha permissão para entrar naquela ala da propriedade ao anoitecer."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:59
translate ptPT scr_SharedInThorns_askForClues_menu_2_507661c5:

    # ELENA @ grumpy "The guards would patrol the Estate and kept me confined to my room."
    ELENA @ grumpy "Os guardas patrulhavam a Herdade e mantinham-me confinada ao meu quarto."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:60
translate ptPT scr_SharedInThorns_askForClues_menu_2_ae369e54:

    # ELENA @ grumpy "I only saw the locks in passing during the day."
    ELENA @ grumpy "Só vi as fechaduras de passagem durante o dia."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:61
translate ptPT scr_SharedInThorns_askForClues_menu_2_b81a6f39:

    # MC @ talk "Did you ever hear any sounds or anything that might sound unnatural?"
    MC @ talk "Você já ouviu algum som ou algo que possa parecer pouco natural?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:62
translate ptPT scr_SharedInThorns_askForClues_menu_2_e76384e8:

    # ELENA @ sad "...Once I sneaked passed the guards when I was still small."
    ELENA @ sad "...Uma vez eu passei furtivamente pelos guardas quando ainda era pequeno."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:63
translate ptPT scr_SharedInThorns_askForClues_menu_2_f6c6ed4a:

    # ELENA @ sad "Curiosity got the best of me."
    ELENA @ sad "A curiosidade levou a melhor de mim."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:64
translate ptPT scr_SharedInThorns_askForClues_menu_2_20df8f14:

    # ELENA @ shock "I heard... {i}Scratching.{/i}"
    ELENA @ shock "Eu ouvi... {i}Coçar.{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:65
translate ptPT scr_SharedInThorns_askForClues_menu_2_83567ec7:

    # ELENA @ shock "Frantic Scratching and then banging against the door when they heard me make the slightest sound."
    ELENA @ shock "Arranhões frenéticos e depois batidas contra a porta quando me ouviam fazer o mais pequeno som."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:66
translate ptPT scr_SharedInThorns_askForClues_menu_2_2b477956:

    # ELENA @ sad "That was the only time I sneaked out at night."
    ELENA @ sad "Essa foi a única vez que escapei à noite."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:67
translate ptPT scr_SharedInThorns_askForClues_menu_2_443258d8:

    # MC @ talk "I see..."
    MC @ talk "Eu vejo..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:68
translate ptPT scr_SharedInThorns_askForClues_menu_2_e9e494f1:

    # MC "(Perhaps some kind of curse afflicted the family line? But what?)"
    MC "(Talvez algum tipo de maldição tenha afetado a linhagem familiar? Mas o quê?)"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:80
translate ptPT scr_SharedInThorns_askForClues_menu_2_4fb0eea4:

    # ELENA @ talk "Ask whatever you wish."
    ELENA @ talk "Pergunte o que quiser."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:83
translate ptPT scr_SharedInThorns_askForClues_menu_2_fac91fb9:

    # ELENA @ talk "After Lord Vronts sudden death, I had to remain in hiding or risk exposure."
    ELENA @ talk "Após a morte repentina de Lord Vronts, tive que permanecer escondido ou correria o risco de ficar exposto."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:84
translate ptPT scr_SharedInThorns_askForClues_menu_2_6a7dabff:

    # ELENA @ talk "The few servants who remained kept my secret as the Estate without any heir was re-absorbed back under the jurisdiction of the Alderian government."
    ELENA @ talk "Os poucos criados que restaram mantiveram o meu segredo pois a Herdade sem qualquer herdeiro foi reabsorvida sob a jurisdição do governo Alderiano."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:85
translate ptPT scr_SharedInThorns_askForClues_menu_2_1d344075:

    # ELENA @ grumpy "I was then taken to that oaf of a man who tried to sell me off to any party who would have me."
    ELENA @ grumpy "Fui depois levada para aquele brutamontes de homem que tentou vender-me a qualquer parte que me quisesse."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:86
translate ptPT scr_SharedInThorns_askForClues_menu_2_5755195f:

    # ELENA @ talk "...Then in you walked."
    ELENA @ talk "...Então você entrou."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_askForClues.rpy:89
translate ptPT scr_SharedInThorns_askForClues_menu_2_57f5b4c7:

    # ELENA @ talk "Very well, I hope it was of use to you."
    ELENA @ talk "Muito bem, espero que tenha sido útil para você."

