translate ptPT qst_HumanExp_9_valaLearnSlimelarks_0ba33670:

    # MC "(Damn it, what's taking so long? It's nearly been an hour!)"
    MC "(Raios, o que está a demorar tanto? Já passou quase uma hora!)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:669
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_3a1b2e7e:

    # MC "(I need to get back and-)"
    MC "(Preciso de voltar e-)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:671
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_3b14a3b0:

    # VALA "Phew!"
    VALA "Ufa!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:672
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_b19bd620:

    # VALA "Well, there was a lot on Slimelarks but not much talking about what they eat."
    VALA "Bem, havia muito em Slimelarks mas não muito sobre o que eles comem."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:673
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_cbdd3e29:

    # MC @ talk "What did you find?"
    MC @ talk "O que encontraste?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:674
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_e36d030e:

    # VALA "This seems to be the best source of reference."
    VALA "Esta parece ser a melhor fonte de referência."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:675
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_f7233d18:

    # VALA "It was one of the earlier studies on Slimelarks, but it's one of the few that goes into their natural lives rather than just discussing the quickest way to kill them."
    VALA "Era um dos primeiros estudos sobre Cotovias de Lodo, mas é um dos poucos que explora as suas vidas naturais em vez de apenas discutir a forma mais rápida de as matar."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:676
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_1003da7c:

    # MC @ talk "Ah, thank you, Vala."
    MC @ talk "Ah, obrigado, Vala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:677
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_60f52a26:

    # VALA "Just leave the book here when you're done."
    VALA "Deixa o livro aqui quando acabares."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:679
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_8de5398c:

    # "{i}Slimelarks, by their very nature, are omnivorous predators.{/i}"
    "{i}As Cotovias de Lodo, pela sua própria natureza, são predadoras omnívoras.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:680
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_0069e7e7:

    # "{i}In their infancy, they rely far more on raw meat, often provided to them by their mothers, in order to build up their strength.{/i}"
    "{i}Na sua infância, dependem muito mais de carne crua, muitas vezes fornecida pelas mães, para ganhar força.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:681
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_8bfd7566:

    # "{i}However, this is only one component of the slimelarks diet, it is essential for their growth they then move on to consume other substances, such as wildflower.{/i}"
    " T0  No entanto, este é apenas um componente da dieta de slimelarks, é essencial para o seu crescimento que eles então passam a consumir outras substâncias, como a flor silvestre.   T1 "

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:682
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_d31c9191:

    # "{i}Slimelarks do not possess any sort of organs similar to mammals, and thus, they rely on consuming various substances in order to compensate for their internal processes.{/i}"
    " T0  Slimelarks não possuem qualquer tipo de órgãos semelhantes aos mamíferos, e assim, eles dependem de consumir várias substâncias, a fim de compensar seus processos internos.  T1 "

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:683
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_26377531:

