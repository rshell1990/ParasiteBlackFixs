    MC "(Ela comeu a carne bem antes, porque não agora?)"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:648
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_3b987541:

    # VALA "Slimelarks?"
    VALA "Cotovias de lodo?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:649
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_cfc74e71:

    # VALA "Umm, I think they're mentioned in a couple bestiaries, but there's nothing devoted just to them."
    VALA "Acho que são mencionados em alguns bestiários, mas não há nada dedicado apenas a eles."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:650
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_fbc08ab9:

    # MC @ talk "Do you have one of these bestiaries?"
    MC @ talk "Tens algum destes bestiários?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:651
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_e33b273c:

    # VALA "I can try gather you up some if that's what you want..."
    VALA "Posso tentar recolher algumas se é isso que queres..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:652
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_29beeb65:

    # VALA "What's this about?"
    VALA "Do que se trata?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:653
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_7943dd4f:

    # VALA "It might help if I knew what you were looking to find out about them."
    VALA "Podia ajudar se soubesse o que procuras descobrir sobre elas."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:654
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_0ce2104b:

    # MC @ think "Uhh, their diet I guess."
    MC @ think "Uhh, a dieta delas, acho."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:655
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_db9498b4:

    # VALA "Their diet?"
    VALA "A dieta delas?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:656
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_5f9b271e:

    # VALA "OOOH! Are you writing a new research journal on them?!"
    VALA "OOOH! Você está escrevendo um novo diário de pesquisa sobre eles?!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:657
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_f4e0442a:

    # MC @ think "Uhh, not exactly..."
    MC @ think "Uhh, não exatamente..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:658
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_3eab76be:

    # VALA "Hmmmm, interesting."
    VALA "Hmmmm, interessante."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:659
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_d5f50d4e:

    # VALA "Well, okay then."
    VALA "Bem, okay então."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:660
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_1522084b:

    # VALA "I'll try narrow down the books to the most useful for you then."
    VALA "Vou tentar restringir os livros aos mais úteis para ti."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:661
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_400bf3f5:

    # MC @ smile "Thank you, Vala."
    MC @ smile "Obrigado, Vala."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:662
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_b76cebc3:

    # VALA "Don't mention it! Always happy to help a fellow keen mind!"
    VALA "De nada! É sempre um prazer ajudar um colega com a mente aguçada!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:664
translate ptPT qst_HumanExp_9_valaLearnSlimelarks_1e512692:

