translate ptPT qst_HumanExp_8_shayGetBetterFood_0980d96f:

    # SHAY @ smile "Ah! I'm so glad to hear that!"
    SHAY @ smile "Ah! Fico tão contente por ouvir isso!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:596
translate ptPT qst_HumanExp_8_shayGetBetterFood_b5f23e75:

    # SHAY @ talk "Nice to see my cooking is still up to standard then!"
    SHAY @ talk "É bom ver que a minha cozinha ainda está ao nível!"

