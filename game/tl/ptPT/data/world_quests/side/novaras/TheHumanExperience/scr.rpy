# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:935
translate ptPT qst_HumanExp_12_goHunting_022d254d:

    # "The Blood splatter on her body was absorbed through her skin, and the cute innocence she had conveyed until now was all but gone."
    "Os salpicos de sangue no corpo dela foram absorvidos pela pele, e a fofa inocência que tinha transmitido até agora desapareceu completamente."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:936
translate ptPT qst_HumanExp_12_goHunting_fa64eac2:

    # "Only this ghastly nightmare stood before me, lapping up the warm blood like milk."
    "Só este pesadelo horrível estava diante de mim, batendo no sangue quente como leite."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:937
translate ptPT qst_HumanExp_12_goHunting_c728332a:

    # "One of the bandits still squirmed as she pressed her bladed hand into his body."
    "Um dos bandidos ainda se contorceu quando ela apertou a mão com lâmina no corpo dele."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:939
translate ptPT qst_HumanExp_12_goHunting_796deab9:

    # "Small tendrils pushed through his ripped open eye sockets and mouth."
    "Pequenos tentáculos empurraram através das órbitas e boca rasgadas dele."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:940
translate ptPT qst_HumanExp_12_goHunting_011a31cb:

    # "Tentacles tore their way through his body and could be seen shifting about beneath the skin."
    "Tentáculos rasgaram caminho através do corpo e podiam ser vistos a mover-se debaixo da pele."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:942
translate ptPT qst_HumanExp_12_goHunting_cc0c4ed1:

    # "He gargled and choked as the tentacles seemed to puppeteer him briefly till he finally fell still, dead and drained pale white."
    "Ele gargarejou e engasgou quando os tentáculos pareciam marioneteá-lo brevemente até que ele finalmente caiu parado, morto e drenado branco pálido."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:943
translate ptPT qst_HumanExp_12_goHunting_d06fcedc:

    # "For a moment, I considered abandoning this... {i}thing{/i} right here."
    "Por um momento, considerei abandonar isto... Aqui."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:944
translate ptPT qst_HumanExp_12_goHunting_fbf28920:

    # "I could escape, let the City Guard handle this {i}monster{/i} standing before me."
    "Eu poderia escapar, deixar a Guarda Municipal lidar com isso   T0   monster  T1       diante de mim."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:946
translate ptPT qst_HumanExp_12_goHunting_5512e3fe:

    # "Myu, noticing my expression, stopped eating and dragged her way towards me, the voice once again sweet as that innocent face of hers returned."
    "Myu, percebendo minha expressão, parou de comer e arrastou seu caminho em minha direção, a voz mais uma vez doce como aquele rosto inocente dela voltou."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:950
translate ptPT qst_HumanExp_12_goHunting_2534e2b7:

    # MYU @ sad "We... Go?"
    MYU @ sad "Nós... Ir?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:951
translate ptPT qst_HumanExp_12_goHunting_f41c9653:

    # MC @ sad "...Y-Yes, we go."
    MC @ sad "...S-Sim, vamos."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:955
translate ptPT qst_HumanExp_12_goHunting_49eba397:

    # "The two of us hurried as we slipped away into the darkness back home before the guards stumbled upon the grizzly scene left in our wake."
    "Nós os dois corremos enquanto escorregávamos para a escuridão lá em casa antes que os guardas tropeçassem na cena parda deixada no nosso rastro."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:961
translate ptPT qst_HumanExp_12_goHunting_b449b2ec:

    # MYU @ sad "...[player_name!t]?"
    MYU @ sad "...       ?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:962
translate ptPT qst_HumanExp_12_goHunting_4ac8c646:

    # MC @ talk "Myu? What is it?"
    MC @ talk "Myu? O que é?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:963
translate ptPT qst_HumanExp_12_goHunting_6010b8f6:

    # MYU @ sad "{i}Why... Look at Myu like that...{/i}"
    MYU @ sad "{i}Porquê... Olhar para a Myu assim...{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:964
translate ptPT qst_HumanExp_12_goHunting_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "Hã?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:965
translate ptPT qst_HumanExp_12_goHunting_72fee8b8:

    # MYU @ sad "Back in alley..."
    MYU @ sad "No beco..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:966
translate ptPT qst_HumanExp_12_goHunting_0299ab02:

    # MYU @ sad "Not seen look at me like that before."
    MYU @ sad "Nunca vi olhar para mim assim antes."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:967
translate ptPT qst_HumanExp_12_goHunting_02c4c377:

    # MYU @ sad "Was Myu bad?"
    MYU @ sad "A Myu foi má?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:968
translate ptPT qst_HumanExp_12_goHunting_69c9834e:

    # MC @ sad "I-"
    MC @ sad "Eu-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:969
translate ptPT qst_HumanExp_12_goHunting_89017916:

    # MC @ sad "No, Myu, you weren't bad."
    MC @ sad "Não, Myu, não foste mau."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:970
translate ptPT qst_HumanExp_12_goHunting_14f50b3f:

    # MC @ talk "I've just never seen you like that before."
    MC @ talk "Só nunca te vi assim antes."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:971
translate ptPT qst_HumanExp_12_goHunting_b51439e1:

    # MYU @ sad "Like what?"
    MYU @ sad "Como assim?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:972
translate ptPT qst_HumanExp_12_goHunting_f47d7bb8:

    # MC @ think "Just..."
    MC @ think "Só..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:973
translate ptPT qst_HumanExp_12_goHunting_ed3f878c:

    # "I didn't know how to answer her, what {i}could{/i} I say after what I just saw?"
    "Não sabia como responder, o que {i}poderia{/i} dizer depois do que acabei de ver?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:974
translate ptPT qst_HumanExp_12_goHunting_7d580b52:

    # MC @ smile "Myu, why don't you get some rest?"
    MC @ smile "Myu, porque não descansas um pouco?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:975
translate ptPT qst_HumanExp_12_goHunting_11db02de:

    # MC @ smile "Its been a long night."
    MC @ smile "Foi uma longa noite."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:976
translate ptPT qst_HumanExp_12_goHunting_89de05dc:

    # "Myu nodded softly, making her way towards the bedroom."
    "A Myu acenou suavemente, dirigindo-se para o quarto."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:980
translate ptPT qst_HumanExp_12_goHunting_73488014:

    # REGINA @ talk "How did it go?"
    REGINA @ talk "Como correu?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:982
translate ptPT qst_HumanExp_12_goHunting_ab4c4d36:

    # MC @ surprised "[regina_ref_cap!t]! How long have you-"
    MC @ surprised "[regina_ref_cap!t]! Há quanto tempo estás-"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:983
translate ptPT qst_HumanExp_12_goHunting_46eac9a6:

    # REGINA @ smile "Oh, I just slipped in earlier to see how Myu was doing!"
    REGINA @ smile "Oh, só entrei mais cedo para ver como a Myu estava!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:984
translate ptPT qst_HumanExp_12_goHunting_ee978acf:

    # REGINA @ talk "When I noticed she was gone, I figured the two of you must have been {i}out,{/i} so I decided to wait for you."
    REGINA @ talk "Quando reparei que ela tinha ido, imaginei que os dois deviam ter {i}saído,{/i} por isso decidi esperar por ti."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:985
translate ptPT qst_HumanExp_12_goHunting_b1b3ce81:

    # MC @ think "O-Oh, right, of course."
    MC @ think "Certo, claro."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:989
translate ptPT qst_HumanExp_12_goHunting_b78cb548:

    # REGINA @ sad "...So, how was it?"
    REGINA @ sad "...Então, como foi?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:990
translate ptPT qst_HumanExp_12_goHunting_b060895f:

    # MC @ serious "It was... Difficult seeing her do that."
    MC @ serious "Foi... É difícil vê-la fazer isso."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:991
translate ptPT qst_HumanExp_12_goHunting_b0c66fe1:

    # MC @ sad "Like, it felt like I was dealing with another {i}monster.{/i}"
    MC @ sad "Tipo, parecia que estava a lidar com outro {i}monstro.{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:992
translate ptPT qst_HumanExp_12_goHunting_07f65605:

    # REGINA @ sad "{i}*Sigh*{/i}"
    REGINA @ sad "{i}*Suspiro*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:993
translate ptPT qst_HumanExp_12_goHunting_5c6cb119:

    # REGINA @ sad "It's her nature, [player_name!t], no matter how much she learns to be around humans, that killer instinct will always be there."
    REGINA @ sad "É a sua natureza,   T0  , não importa o quanto ela aprenda a estar perto de humanos, esse instinto assassino estará sempre lá."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:994
translate ptPT qst_HumanExp_12_goHunting_1ccd9609:

    # MC @ talk "...Is she safe to keep around?"
    MC @ talk "...É seguro mantê-la por perto?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:995
translate ptPT qst_HumanExp_12_goHunting_d3a8eb26:

    # "[regina_ref_cap!t] shrugged."
    "[regina_ref_cap!t] encolheu os ombros."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:996
translate ptPT qst_HumanExp_12_goHunting_e3a90034:

    # REGINA @ talk "People have kept and trained slimes before."
    REGINA @ talk "As pessoas já mantiveram e treinaram slimes antes."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:997
translate ptPT qst_HumanExp_12_goHunting_f3037070:

    # REGINA @ talk "But its not like keeping a dog."
    REGINA @ talk "Mas não é como ter um cão."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:998
translate ptPT qst_HumanExp_12_goHunting_fa93a8fa:

    # REGINA @ talk "Even if they {i}*can*{/i} speak, they can still switch at a moment's notice."
    REGINA @ talk "Mesmo se eles   T0  *can*  T1     falar, eles ainda podem mudar em um aviso prévio."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:999
translate ptPT qst_HumanExp_12_goHunting_84335a2a:

    # MC @ surprised "But, you said she's imprinted on me, right?"
    MC @ surprised "Mas disseste que ela me tinha gravado, certo?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1000
translate ptPT qst_HumanExp_12_goHunting_a399f7bc:

    # REGINA @ talk "Doesn't mean she wont attack others if she gets overwhelmed or any number of things could happen..."
    REGINA @ talk "Não significa que não vá atacar outros se ficar sobrecarregada ou várias coisas podem acontecer..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1001
translate ptPT qst_HumanExp_12_goHunting_7821a17c:

    # MC @ talk "Then what should I do with her?"
    MC @ talk "Então o que devo fazer com ela?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1002
translate ptPT qst_HumanExp_12_goHunting_9898c219:

    # REGINA @ talk "Just keep an eye on her, that's all."
    REGINA @ talk "Mantém-na debaixo de olho, só isso."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1003
translate ptPT qst_HumanExp_12_goHunting_4d3c2876:

    # REGINA @ talk "Only time will tell."
    REGINA @ talk "Só o tempo dirá."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1004
translate ptPT qst_HumanExp_12_goHunting_9d8f7bf6:

    # MC @ talk "{i}*Sigh*{/i}"
    MC @ talk "{i}*Suspiro*{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1005
translate ptPT qst_HumanExp_12_goHunting_4f113424:

    # MC @ talk "I need some room."
    MC @ talk "Preciso de algum espaço."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1012
translate ptPT qst_HumanExp_12_goHunting_a1873268:

    # MYU @ sad "..."
    MYU @ sad "..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1013
translate ptPT qst_HumanExp_12_goHunting_7159a1e6:

    # MYU @ sad "Myu is..."
    MYU @ sad "A Myu é..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:1014
translate ptPT qst_HumanExp_12_goHunting_3a796eb3:

    # MYU @ sad "{i}Monster.{/i}"
    MYU @ sad "{i}Monstro.{/i}"

translate ptPT strings:

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:82
    old "I'm hoping to improve my own mastery of the language."
    new "Espero melhorar o meu próprio domínio da língua."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:87
    old "My reasons are my own."
    new "As minhas razões são minhas."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:89
    old "I'm trying to teach someone."
    new "Estou a tentar ensinar alguém."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:110
    old "Is there no way you could sell it to me cheaper?"
    new "Não há maneira de me venderes mais barato?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:121
    old "Here is the coin."
    new "Aqui estão as moedas."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:138
    old "I will be back soon."
    new "Volto em breve."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:226
    old "How about we get to know each other a little more first?"
    new "Que tal conhecermo-nos melhor primeiro?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:233
    old "Oh yeah, your ass belongs to me."
    new "Sim, o teu rabo pertence-me."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:256
    old "Myu, I'm sorry, I don't see you that way."
    new "Myu, desculpa, não te vejo dessa forma."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:361
    old "There's a difference between expecting people with more money and power to be more responsible, and {i}punishing{/i} them for their wealth."
    new "Há uma diferença entre esperar que as pessoas com mais dinheiro e poder sejam mais responsáveis, e   T0   punindo  T1    eles por sua riqueza."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:364
    old "Personally, I think we could do without any of the Aristocracy... We could manage better on our own."
    new "Pessoalmente, acho que podíamos passar sem qualquer aristocracia... Podíamos fazer melhor sozinhos."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:369
    old "Someone needs to be in charge, they have tough decisions to make themselves."
    new "Alguém precisa de estar no comando, eles têm decisões difíceis para tomar."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:572
    old "Hm, I will come back another time then."
    new "Hm, então volto outra vez."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:793
    old "So, you {i}don't{/i} want me to get rid of her?"
    new "Então, queres que me livre dela?"

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:801
    old "I figured you'd be more afraid when you saw her..."
    new "Imaginei que ficarias mais assustado quando a viste..."

    # game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:809
    old "So... What now?"
    new "Então... E agora?"

