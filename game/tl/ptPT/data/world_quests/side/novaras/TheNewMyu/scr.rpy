translate ptPT qst_NewMyu_4_findMyuChurch_menu_7d6bdbfd:

    # "Before she dissolved, Myu turned to face me once more."
    "Antes de se dissolver, a Myu virou-se para mim mais uma vez."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:307
translate ptPT qst_NewMyu_4_findMyuChurch_menu_e0576a98:

    # MYU @ talk "Do... [player_name!t] not want to be Myu husband?"
    MYU @ talk "O... [player_name!t] não quer ser marido da Myu?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:308
translate ptPT qst_NewMyu_4_findMyuChurch_menu_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "O quê?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:309
translate ptPT qst_NewMyu_4_findMyuChurch_menu_6d33c1a7:

    # MYU @ sad "Myu... Understand now, things not as she thought."
    MYU @ sad "A Myu... Percebe agora, as coisas não são como ela pensava."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:310
translate ptPT qst_NewMyu_4_findMyuChurch_menu_fa435c59:

    # MYU @ sad "Even though Myu wants [player_name!t], not fair to force someone to love who doesn't love back."
    MYU @ sad "Mesmo que Myu queira [player_name!t], não é justo forçar alguém a amar quem não ama de volta."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:311
translate ptPT qst_NewMyu_4_findMyuChurch_menu_8bcea43e:

    # MYU @ sad "So, what does [player_name!t] want?"
    MYU @ sad "Então, o que é que [player_name!t] quer?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:317
translate ptPT qst_NewMyu_4_findMyuChurch_menu_9fdc3e39:

    # MYU @ sad "Myu... Myu understand."
    MYU @ sad "Myu... Myu percebe."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:318
translate ptPT qst_NewMyu_4_findMyuChurch_menu_31ceb390:

    # MYU @ sad "Myu is sorry for trying to force what cannot be."
    MYU @ sad "Myu pede desculpa por tentar forçar o que não pode ser."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:319
translate ptPT qst_NewMyu_4_findMyuChurch_menu_c2a891a5:

    # MC @ talk "I will still keep you safe and look after you Myu, I promise."
    MC @ talk "Vou continuar a manter-te segura e a cuidar de ti Myu, prometo."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:320
translate ptPT qst_NewMyu_4_findMyuChurch_menu_a1015a7d:

    # MC @ talk "I just can't be what you {i}want{/i} me to be."
    MC @ talk "Eu só não posso ser o que tu {i}queres{/i} que eu seja."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:321
translate ptPT qst_NewMyu_4_findMyuChurch_menu_2a791db4:

    # MYU @ sad "...Very well, Myu will help when she can."
    MYU @ sad "...Muito bem, Myu vai ajudar quando puder."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:322
translate ptPT qst_NewMyu_4_findMyuChurch_menu_59807ae7:

    # MYU @ smile "And maybe, along the way, Myu will find someone who {i}does{/i} want her that way."
    MYU @ smile "E talvez, pelo caminho, Myu encontre alguém que {i}realmente{/i} a queira dessa forma."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:323
translate ptPT qst_NewMyu_4_findMyuChurch_menu_e2d535af:

    # MC @ talk "Maybe Myu, maybe."
    MC @ talk "Talvez Myu, talvez."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:324
translate ptPT qst_NewMyu_4_findMyuChurch_menu_4c680e03:

    # MC "(I hope I have made the right choice with this.)"
    MC "(Espero ter feito a escolha certa com isto.)"

