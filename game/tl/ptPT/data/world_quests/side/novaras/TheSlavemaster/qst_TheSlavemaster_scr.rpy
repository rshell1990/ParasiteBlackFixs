translate ptPT qsttheslavemaster_intro_ed55590b:

    # "As I made my way out through the city gates, I heard a voice calling behind me."
    "Ao sair pelos portões da cidade, ouvi uma voz atrás de mim."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:5
translate ptPT qsttheslavemaster_intro_def3145f:

    # UNKNOWN "Wait! STOPPPP!"
    UNKNOWN "Espera! PAREEEEE!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:9
translate ptPT qsttheslavemaster_intro_5d48b0bd:

    # "Behind me, a young boy, huffing and panting, sprinted up and handed me a sealed letter."
    "Atrás de mim, um jovem, ofegante e ofegante, correu e me entregou uma carta selada."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:11
translate ptPT qsttheslavemaster_intro_6394fbb0:

    # UNKNOWN "{i}*Huff!*{/i} An urgent letter for you mi'lord from Captain Nyx!"
    UNKNOWN "{i}*Huff!*{/i} Uma carta urgente para vós milorde do Capitão Nyx!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:12
translate ptPT qsttheslavemaster_intro_09b56699:

    # MC @ talk "Captain Nyx? Did she say what this was about?"
    MC @ talk "Capitão Nyx? Ela disse sobre o que era?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:13
translate ptPT qsttheslavemaster_intro_a2c653f8:

    # UNKNOWN "No mi'lord! But she said you must read it at once!"
    UNKNOWN "Não, meu senhor! Mas ela disse que você deve lê-lo imediatamente!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:14
translate ptPT qsttheslavemaster_intro_f2d783ef:

    # MC @ talk "How did you know where to-"
    MC @ talk "Como soubeste onde-"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:17
translate ptPT qsttheslavemaster_intro_67ca6e19:

    # "The boy was already hurrying off once again before I could even finish my sentence, sprinting back towards the gate, and soon, he was gone entirely from my line of sight."
    "O rapaz já se apressava a sair novamente antes que eu pudesse terminar a frase, correndo de volta para o portão, e em breve, desapareceu completamente da minha vista."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:18
translate ptPT qsttheslavemaster_intro_a26e1014:

    # "I tore open the letter and read its contents inside."
    "Rasguei a carta e li o seu conteúdo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:19
translate ptPT qsttheslavemaster_intro_201ed5f8:

    # "{i} [player_name!t], please come at once to see me ...{/i}"
    "Por favor, venha ver-me imediatamente."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:20
translate ptPT qsttheslavemaster_intro_cbb5587c:

    # "{i}I need to call upon your services once again.{/i}"
    "{i}Preciso de recorrer aos teus serviços novamente.{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:21
translate ptPT qsttheslavemaster_intro_d2dd0882:

    # "{i}Captain Nyx{/i}"
    "{i}Capitão Nyx{/i}"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:22
translate ptPT qsttheslavemaster_intro_a54258cb:

    # MC "(I should head over there once I have some time, see what she wants.)"
    MC "(Devo ir até lá quando tiver algum tempo, ver o que ela quer.)"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:33
translate ptPT qsttheslavemaster_pitch_2224139c:

    # NYX @ talk "Ah, there you are."
    NYX @ talk "Ah, aí estás."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:34
translate ptPT qsttheslavemaster_pitch_0a23a13b:

    # NYX @ talk "Just the person I've been looking for."
    NYX @ talk "Exatamente a pessoa que procurava."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:35
translate ptPT qsttheslavemaster_pitch_756e61c9:

    # MC @ think "What's this about?"
    MC @ think "Do que se trata?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:36
translate ptPT qsttheslavemaster_pitch_29d937a5:

    # NYX @ talk "Not long ago, we received word of a notorious slave master who we {i}think{/i} has arrived in Novaras."
    NYX @ talk "Não faz muito tempo, recebemos a notícia de um notório mestre escravo que   T0  think  T1    chegou em Novaras."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:37
translate ptPT qsttheslavemaster_pitch_8efb590f:

    # NYX @ angry "They call him 'Angharad of a thousand chains.'"
    NYX @ angry "Chamam-lhe «Angharade de mil correntes»."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:38
translate ptPT qsttheslavemaster_pitch_a7e01fe2:

    # NYX @ talk "From what we've gathered, Angharad's been investing a lot of time and resources in the power struggle going on between the gangs in the city right now, and has struck some type of deal with the Khazahs."
    NYX @ talk "Pelo que vimos, Angharad tem investido muito tempo e recursos na luta de poder que está acontecendo entre as gangues da cidade agora, e fez algum tipo de acordo com os Khazahs."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:39
translate ptPT qsttheslavemaster_pitch_96b86ea7:

    # NYX @ talk "We believe he's been supplying them with additional weapons, drugs, and armour in return for being the only slave master they consult with."
    NYX @ talk "Acreditamos que ele tem estado a fornecê-los com armas, drogas e armaduras adicionais em troca de ser o único mestre de escravos que consultam."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:40
translate ptPT qsttheslavemaster_pitch_b8ea4e4b:

    # MC @ think "I see... And where do I fit into all this?"
    MC @ think "Entendo... E onde me encaixo nisto tudo?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:41
translate ptPT qsttheslavemaster_pitch_2fed62ec:

    # NYX @ angry "We've managed to convince Angharad to attend what he believes is a business meeting with another high-profile slaver interested in working with him."
    NYX @ angry "Conseguimos convencer o Angharad a ir ao que ele acredita ser uma reunião de negócios com outro escravista interessado em trabalhar com ele."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:42
translate ptPT qsttheslavemaster_pitch_55bd058f:

    # NYX @ talk "The plan is simple ... One of our men pretends to be the other slave master, goes in, finds proof it's definately Angharad at the meeting and not one of his men sent on his behalf,"
    NYX @ talk "O plano é simples ... Um dos nossos homens faz-se passar pelo outro mestre de escravos, entra, encontra provas de que é definitivamente Angharad na reunião e não um dos seus homens enviados em seu nome,"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:43
translate ptPT qsttheslavemaster_pitch_0a8956f7:

    # NYX @ talk "And once Angharad is confirmed to be present and agrees to the deal, the other city guards on standby will swarm the place and seize him."
    NYX @ talk "E assim que Angharad for confirmado presente e concordar com o acordo, os outros guardas da cidade em espera irão invadir o local e capturá-lo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:44
translate ptPT qsttheslavemaster_pitch_8eb76fb4:

    # MC @ talk "I take it this is where I come in?"
    MC @ talk "Presumo que seja aqui que eu entro?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:45
translate ptPT qsttheslavemaster_pitch_ab17c8ac:

    # NYX @ talk "Well, aren't you clever?"
    NYX @ talk "Bem, não és tu esperto?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:46
translate ptPT qsttheslavemaster_pitch_1dd21de2:

    # NYX @ talk "As you know, I'm stretched thin on manpower as it is, but to make matters worse, Angharad's done his research and knows who many of my men are."
    NYX @ talk "Como sabem, já estou cansado da mão-de-obra, mas para piorar as coisas, o Angharad fez a sua pesquisa e sabe quem são muitos dos meus homens."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:47
translate ptPT qsttheslavemaster_pitch_0e67101c:

    # NYX @ talk "I need a fresh face to go in and pretend to be the other slave master to negotiate with him."
    NYX @ talk "Preciso de uma cara nova para fingir ser o outro mestre de escravos para negociar com ele."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:48
translate ptPT qsttheslavemaster_pitch_3635700b:

    # NYX @ talk "Are we clear?"
    NYX @ talk "Estamos entendidos?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:52
translate ptPT qsttheslavemaster_pitch_menu_426d1e67:

    # NYX @ talk "I'll walk you through everything as best as I can, just push the thought of 'people' to the back of your mind and remember it's {i}product{/i} you're discussing."
    NYX @ talk "Eu vou levá-lo através de tudo o melhor que eu puder, basta empurrar o pensamento de 'pessoas' para o fundo da sua mente e lembre-se que é   T0  product  T1   você está discutindo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:53
translate ptPT qsttheslavemaster_pitch_menu_ab611a5e:

    # NYX @ talk "Assisting you will be one of my very best pretending to be a slave concubine of yours."
    NYX @ talk "Ajudar-te será um dos meus melhores a fingir ser tua concubina escrava."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:59
translate ptPT qsttheslavemaster_pitch_menu_94a5723b:

    # NYX @ angry "We need to confirm it's really him."
    NYX @ angry "Precisamos de confirmar que é mesmo ele."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:60
translate ptPT qsttheslavemaster_pitch_menu_811f98c6:

    # NYX @ talk "In the past, he's sent others impersonating him to handle negotiations."
    NYX @ talk "No passado, ele enviou outros a fazer-se passar por ele para lidar com negociações."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:61
translate ptPT qsttheslavemaster_pitch_menu_0a4a920a:

    # NYX @ angry "We can't let him slip away, no matter what."
    NYX @ angry "Não podemos deixá-lo escapar, aconteça o que acontecer."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:62
translate ptPT qsttheslavemaster_pitch_menu_6817b429:

    # MC @ talk "And how will I be able to {i}'prove'{/i} it's really him?"
    MC @ talk "E como vou eu conseguir {i}'provar'{/i} que é mesmo ele?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:63
translate ptPT qsttheslavemaster_pitch_menu_6363e661:

    # NYX @ sad "That's the tricky part ... But we'll have to find it."
    NYX @ sad "Essa é a parte complicada ... Mas vamos ter de descobrir."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:64
translate ptPT qsttheslavemaster_pitch_menu_61767dca:

    # NYX @ talk "If we arrest one his men acting on his behalf, Angharad will only hide himself further underground."
    NYX @ talk "Se prendermos um dos seus homens a agir em seu nome, Angharad só se esconderá ainda mais."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:67
translate ptPT qsttheslavemaster_pitch_menu_3d8f1a37:

    # NYX @ talk "Any other questions?"
    NYX @ talk "Mais alguma pergunta?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:70
translate ptPT qsttheslavemaster_pitch_menu_f2a55cd8:

    # NYX @ angry "Angharad is no ordinary slave master, he's destabilised whole regions before."
    NYX @ angry "Angharad não é um escravo qualquer, já desestabilizaram regiões inteiras antes."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:71
translate ptPT qsttheslavemaster_pitch_menu_6970770f:

    # NYX @ talk "If we capture him alive, we can use his connections to weed out dozens if not hundreds of criminals in the city."
    NYX @ talk "Se o capturarmos vivo, podemos usar as suas conexões para eliminar dúzias se não centenas de criminosos na cidade."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:72
translate ptPT qsttheslavemaster_pitch_menu_935cb587:

    # NYX @ angry "But, if he entrenches himself here before we can do that, we'll never be able to uproot him."
    NYX @ angry "Mas, se ele se entrincheirar aqui antes de podermos fazer isso, nunca poderemos desenraizá-lo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:78
translate ptPT qsttheslavemaster_pitch_menu_5617f1f3:

    # NYX @ talk "So then, can I count on you with this?"
    NYX @ talk "Então, posso contar contigo para isto?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:81
translate ptPT qsttheslavemaster_pitch_menu_219c9373:

    # NYX @ laugh "My undying gratitude?"
    NYX @ laugh "A minha gratidão eterna?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:82
translate ptPT qsttheslavemaster_pitch_menu_b212ba9d:

    # MC @ talk "Nice try."
    MC @ talk "Boa tentativa."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:83
translate ptPT qsttheslavemaster_pitch_menu_a53116a5:

    # NYX @ angry "Fine, what do you want?"
    NYX @ angry "Está bem, o que queres?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:86
translate ptPT qsttheslavemaster_pitch_menu_3270b237:

    # NYX @ talk "Fine, how does six hundred sound?"
    NYX @ talk "Certo, que tal seiscentos?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:89
translate ptPT qsttheslavemaster_pitch_menu_95795d08:

    # NYX @ talk "Fine ... Seven-fifty and not a coin more."
    NYX @ talk "Está bem... Sete-cinquenta e nem mais uma moeda."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:95
translate ptPT qsttheslavemaster_pitch_menu_675f81f3:

    # NYX @ shock "Equipment?"
    NYX @ shock "Equipamento?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:96
translate ptPT qsttheslavemaster_pitch_menu_43854ff0:

    # NYX @ talk "Well ... I could give you some health potions, and, while I can't give you any armour and weapons,"
    NYX @ talk "Bem ... Posso dar-te algumas poções de vida, e, embora não possa dar-te armaduras e armas,"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:97
translate ptPT qsttheslavemaster_pitch_menu_99899405:

    # NYX @ talk "I can give you this amulet that offers some protection."
    NYX @ talk "Posso dar-te este amuleto que oferece alguma proteção."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:100
translate ptPT qsttheslavemaster_pitch_menu_fd5c4a81:

    # NYX @ laugh "Excellent."
    NYX @ laugh "Excelente."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:104
translate ptPT qsttheslavemaster_pitch_menu_b5146dc2:

    # NYX @ disg "You ... you what?!"
    NYX @ disg "Tu ... Tu o quê?!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:105
translate ptPT qsttheslavemaster_pitch_menu_c3ccfe27:

    # NYX @ angry "Be serious!"
    NYX @ angry "Sê sério!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:108
translate ptPT qsttheslavemaster_pitch_menu_9d4d3b62:

    # NYX @ angry "Ask me that again and I'll cut your balls off!"
    NYX @ angry "Pergunta-me isso outra vez e corto-te os tomates!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:111
translate ptPT qsttheslavemaster_pitch_menu_a1946fb6:

    # NYX @ arrogant "It ... It doesn't even make any sense asking for my panties!"
    NYX @ arrogant "Isso ... Isso nem sequer faz sentido pedir as minhas cuecas!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:112
translate ptPT qsttheslavemaster_pitch_menu_c8668323:

    # NYX @ arrogant "What benefit are they to you?"
    NYX @ arrogant "Que benefício têm para ti?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:114
translate ptPT qsttheslavemaster_pitch_menu_fef62dd5:

    # MC @ lewd "Doesn't it make even less sense to deny me?"
    MC @ lewd "Não faz menos sentido negar-me?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:116
translate ptPT qsttheslavemaster_pitch_menu_1fc525bf:

    # NYX @ disg "W-What are you talking about?"
    NYX @ disg "D-Do que estás a falar?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:117
translate ptPT qsttheslavemaster_pitch_menu_3b140a9a:

    # MC @ lewd "Rather than waste precious resources, all I ask for are the panties you're wearing."
    MC @ lewd "Em vez de desperdiçar recursos preciosos, tudo o que peço são as cuecas que estás a usar."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:118
translate ptPT qsttheslavemaster_pitch_menu_55b415c4:

    # MC @ lewd "What better deal could you get than that?"
    MC @ lewd "Que melhor negócio poderias conseguir?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:120
translate ptPT qsttheslavemaster_pitch_menu_68f36c38:

    # NYX @ arrogant "... F-Fine."
    NYX @ arrogant "... E-Está bem."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:121
translate ptPT qsttheslavemaster_pitch_menu_3cc6f07a:

    # NYX @ arrogant "But this degradation will not be forgotten!"
    NYX @ arrogant "Mas esta degradação não será esquecida!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:122
translate ptPT qsttheslavemaster_pitch_menu_f944af57:

    # MC @ lewd "Oh, I'm sure it won't."
    MC @ lewd "Oh, tenho a certeza que não."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:124
translate ptPT qsttheslavemaster_pitch_menu_cf4f3f87:

    # NYX @ angry "And no payment till AFTER the job is done!"
    NYX @ angry "E nenhum pagamento até depois do trabalho está feito!"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:125
translate ptPT qsttheslavemaster_pitch_menu_317840ab:

    # MC @ smile "Of course, I always live up to my end of the deal."
    MC @ smile "Claro, eu sempre cumpro a minha parte do acordo."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:127
translate ptPT qsttheslavemaster_pitch_menu_e37719bc:

    # "Captain Nyx pouted at the comment as her cheeks burned red."
    "A Capitã Nyx fez um comentário enquanto as bochechas dela queimavam vermelho."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:131
translate ptPT qsttheslavemaster_pitch_menu_4e5d8af1:

    # NYX @ angry "Now that's out of the way, can we focus on the task at hand please?"
    NYX @ angry "Agora que isso está resolvido, podemos concentrar-nos na tarefa em questão?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:133
translate ptPT qsttheslavemaster_pitch_menu_5344b784:

    # MC @ talk "What needs to be done first?"
    MC @ talk "O que precisa de ser feito primeiro?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:134
translate ptPT qsttheslavemaster_pitch_menu_15acb208:

    # "From her table, Captain Nyx handed me a selection of sheets."
    "Da mesa dela, o Capitão Nyx deu-me uma selecção de lençóis."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:135
translate ptPT qsttheslavemaster_pitch_menu_787b7698:

    # NYX @ talk "Wrote here are some details about various trade routes and things, as well as the common price of raza and slaves these days."
    NYX @ talk "Aqui estão alguns detalhes sobre várias rotas e coisas comerciais, bem como o preço comum de raza e escravos hoje em dia."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:136
translate ptPT qsttheslavemaster_pitch_menu_6577aed4:

    # NYX @ talk "These things are common knowledge for any trader, and even more so for a criminal like Angharad."
    NYX @ talk "Estas coisas são de conhecimento geral para qualquer comerciante, e ainda mais para um criminoso como Angharad."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:137
translate ptPT qsttheslavemaster_pitch_menu_827983a1:

    # NYX @ talk "Learn these things well, and report back to me when you're ready to begin the next part of our plan."
    NYX @ talk "Aprende bem estas coisas, e reporta-me quando estiveres pronto para começar a próxima parte do nosso plano."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:143
translate ptPT qsttheslavemaster_pitch_menu_0ce9d935:

    # NYX @ talk "Have you read the book thoroughly?"
    NYX @ talk "Leste o livro completamente?"

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:144
translate ptPT qsttheslavemaster_pitch_menu_4bb5bdec:

    # NYX @ talk "You'll need to memorise as much of it as you can to pass as the real deal."
    NYX @ talk "Terás de memorizar o máximo que puderes para passares por verdadeiro."

# game/data/world_quests/side/novaras/TheSlavemaster/qst_TheSlavemaster_scr.rpy:145
translate ptPT qsttheslavemaster_pitch_menu_89740cfd:

    # NYX @ talk "Are you sure you're ready for the next stage?"
    NYX @ talk "Tens a certeza que estás pronto para a próxima fase?"

