translate ptPT rom_ArlenaIntroDoggy_f6e99e92:

    # "The door opened inch by inch as Arlena’s face peeped surreptitiously through the gap."
    "A porta abriu-se centímetro a centímetro enquanto a cara da Arlena espreitava sub-repticiamente pela fresta."

# game/data/world_romance/arlena/intro_doggy.rpy:3
translate ptPT rom_ArlenaIntroDoggy_47123286:

    # "She averted her gaze as the air touched her rosy cheeks."
    "Ela desviou o olhar quando o ar tocou as suas bochechas rosadas."

# game/data/world_romance/arlena/intro_doggy.rpy:4
translate ptPT rom_ArlenaIntroDoggy_c41453c7:

    # MC @ talk "Arlena? Is everything alright?"
    MC @ talk "Arlena? Está tudo bem?"

# game/data/world_romance/arlena/intro_doggy.rpy:5
translate ptPT rom_ArlenaIntroDoggy_250c2268:

    # ARLENA "Yes, just give me a moment..."
    ARLENA "Sim, é só dar-me um momento..."

# game/data/world_romance/arlena/intro_doggy.rpy:10
translate ptPT rom_ArlenaIntroDoggy_2b255700:

    # "She sealed the door shut for a moment before opening it fully to allow me to inspect what was on the other side."
    "Ela selou a porta por um momento antes de a abrir totalmente para me permitir inspecionar o que estava do outro lado."

# game/data/world_romance/arlena/intro_doggy.rpy:11
translate ptPT rom_ArlenaIntroDoggy_f160d8e1:

    # "Arlena smiled, wrapped in a warm furry blanket that hung off her bare shoulders."
    "A Arlena sorriu, envolta num cobertor quente e peludo que pendia dos seus ombros nus."

# game/data/world_romance/arlena/intro_doggy.rpy:12
translate ptPT rom_ArlenaIntroDoggy_17cf5076:

    # "I had to tear my eyes away from the cute little mole on her collar bone, wanting nothing more than to reach out and touch her."
    "Tive de arrancar os olhos da sua marquinha fofa na clavícula, querendo mais que tudo estender a mão e tocar-lhe."

# game/data/world_romance/arlena/intro_doggy.rpy:13
translate ptPT rom_ArlenaIntroDoggy_dfb9c9c2:

    # "She had placed various candles around the room, illuminating it with a warm, soft kind of light."
    "Ela tinha colocado várias velas à volta do quarto, iluminando-o com um tipo de luz quente e suave."

# game/data/world_romance/arlena/intro_doggy.rpy:14
translate ptPT rom_ArlenaIntroDoggy_8a2997f2:

    # "Placed on the floor was a small white blanket, keenly laid out with a few pieces of food she had managed to pull together in a wooden bowl."
    "Colocada no chão estava uma pequena manta branca, cuidadosamente estendida com alguns pedaços de comida que ela tinha conseguido juntar numa tigela de madeira."

# game/data/world_romance/arlena/intro_doggy.rpy:15
translate ptPT rom_ArlenaIntroDoggy_0f98a9a9:

    # "Sat beside it was a half empty bottle of wine with two glasses already poured out waiting for us."
    "Sentada ao lado estava uma garrafa de vinho meio vazia com dois copos já servidos à nossa espera."

# game/data/world_romance/arlena/intro_doggy.rpy:16
translate ptPT rom_ArlenaIntroDoggy_360d119a:

    # ARLENA "It isn’t much but..."
    ARLENA "Não é muito mas..."

# game/data/world_romance/arlena/intro_doggy.rpy:17
translate ptPT rom_ArlenaIntroDoggy_2aa2b523:

    # ARLENA "It’s all I could cobble together."
    ARLENA "Foi tudo o que consegui arranjar."

# game/data/world_romance/arlena/intro_doggy.rpy:20
translate ptPT rom_ArlenaIntroDoggy_60ace262:

    # ARLENA "And ruin the surprise? Please."
    ARLENA "E estragar a surpresa? Por favor."

# game/data/world_romance/arlena/intro_doggy.rpy:21
translate ptPT rom_ArlenaIntroDoggy_e3382014:

    # ARLENA "You’re a guest, I didn’t want to trouble you with petty tasks after everything you’ve done for me already."
    ARLENA "És um convidado, não te queria incomodar com tarefas menores depois de tudo o que já fizeste por mim."

# game/data/world_romance/arlena/intro_doggy.rpy:22
translate ptPT rom_ArlenaIntroDoggy_bf065817:

    # MC @ talk "Look at you being nice."
    MC @ talk "Olha para ti a ser simpática."

# game/data/world_romance/arlena/intro_doggy.rpy:24
translate ptPT rom_ArlenaIntroDoggy_5638156f:

    # ARLENA "Glad you think so."
    ARLENA "Ainda bem que achas isso."

# game/data/world_romance/arlena/intro_doggy.rpy:26
translate ptPT rom_ArlenaIntroDoggy_9d365dc3:

    # ARLENA "It’s... It’s cold is all!"
    ARLENA "É... É só que está frio!"

# game/data/world_romance/arlena/intro_doggy.rpy:27
translate ptPT rom_ArlenaIntroDoggy_96c1e2d5:

    # ARLENA "Come on, let’s dig in..."
    ARLENA "Vá lá, vamos atacar..."

# game/data/world_romance/arlena/intro_doggy.rpy:29
translate ptPT rom_ArlenaIntroDoggy_97590d4b:

    # "We split the food in the bowl between us and laughed over old stories as we made our way through the wine."
    "Dividimos a comida na tigela entre nós e rimo-nos de velhas histórias enquanto dávamos conta do vinho."

# game/data/world_romance/arlena/intro_doggy.rpy:30
translate ptPT rom_ArlenaIntroDoggy_6364ebb4:

    # ARLENA "Hahaha! Do you remember Viktor’s ‘Great Potato Scam’?"
    ARLENA "Hahaha! Lembras-te do «Grande Esquema da Batata» do Viktor?"

# game/data/world_romance/arlena/intro_doggy.rpy:31
translate ptPT rom_ArlenaIntroDoggy_b6285f18:

    # MC @ talk "Oh yes, he swore hands down he had figured out a way to grow them himself faster than all the farmers could combined."
    MC @ talk "Oh sim, ele jurava a pés juntos que tinha descoberto uma forma de as cultivar sozinho mais depressa do que todos os agricultores juntos."

# game/data/world_romance/arlena/intro_doggy.rpy:32
translate ptPT rom_ArlenaIntroDoggy_5521c0f9:

    # MC @ talk "He was offering huge sacks of potatoes for practically nothing."
    MC @ talk "Ele estava a oferecer sacos enormes de batatas por praticamente nada."

# game/data/world_romance/arlena/intro_doggy.rpy:37
translate ptPT rom_ArlenaIntroDoggy_b285fc8e:

    # "Between snorts of laughter, Arlena struggled to hold down her mouthful of wine as she reminisced."
    "Entre bufos de riso, a Arlena lutava para segurar o seu gole de vinho enquanto recordava."

# game/data/world_romance/arlena/intro_doggy.rpy:38
translate ptPT rom_ArlenaIntroDoggy_1342b385:

    # ARLENA @ smile "The little shit only had the top layer be actual potatoes, beneath all that he’d just painted a load of rocks! "
    ARLENA @ smile "O cabrãozinho só tinha a camada de cima com batatas de verdade, por baixo daquilo tudo ele só tinha pintado um monte de pedras!"

# game/data/world_romance/arlena/intro_doggy.rpy:39
translate ptPT rom_ArlenaIntroDoggy_663dcfdf:

    # ARLENA @ smile "I still remember the mob chasing him now!"
    ARLENA @ smile "Ainda me lembro da multidão a persegui-lo!"

# game/data/world_romance/arlena/intro_doggy.rpy:40
translate ptPT rom_ArlenaIntroDoggy_a613ced5:

    # MC @ talk "He swore blind they were just funny shaped, hard, ‘exotic’ potatoes!"
    MC @ talk "Ele jurava a pés juntos que eram só batadas estranhas, duras, ‘exóticas’!"

# game/data/world_romance/arlena/intro_doggy.rpy:41
translate ptPT rom_ArlenaIntroDoggy_d757d49d:

    # ARLENA "Didn’t someone break his nose for that?"
    ARLENA "Não houve alguém que lhe partiu o nariz por isso?"

# game/data/world_romance/arlena/intro_doggy.rpy:42
translate ptPT rom_ArlenaIntroDoggy_51202ee1:

    # MC @ talk "Yes! When he caught up to him, he said something like ‘here’s something ‘exotic’ for you to try, boy!’ "
    MC @ talk "Sim! Quando o apanhou, disse algo como ‘toma lá algo ‘exótico’ para experimentares, rapaz!’"

# game/data/world_romance/arlena/intro_doggy.rpy:43
translate ptPT rom_ArlenaIntroDoggy_7366dea8:

    # "Arlena laughed once again as we remembered Viktor being dropped by the old farmer’s punch."
    "A Arlena riu-se mais uma vez enquanto nos lembrávamos do Viktor a ser derrubado pelo murro do velho agricultor."

# game/data/world_romance/arlena/intro_doggy.rpy:44
translate ptPT rom_ArlenaIntroDoggy_b3a9f82c:

    # ARLENA "As much of an ass he was, he was quite cute."
    ARLENA "Por mais parvo que ele fosse, ele era bastante giro."

# game/data/world_romance/arlena/intro_doggy.rpy:45
translate ptPT rom_ArlenaIntroDoggy_f8f38e67:

    # MC @ talk "Who? The old farmer?"
    MC @ talk "Quem? O velho agricultor?"

# game/data/world_romance/arlena/intro_doggy.rpy:46
translate ptPT rom_ArlenaIntroDoggy_bb71a8bc:

    # ARLENA "Noooo, Viktor of course!"
    ARLENA "Nããão, o Viktor claro!"

# game/data/world_romance/arlena/intro_doggy.rpy:47
translate ptPT rom_ArlenaIntroDoggy_bf6f3526:

    # ARLENA "{i}Dumbass.{/i}"
    ARLENA "{i}Idiota.{/i}"

# game/data/world_romance/arlena/intro_doggy.rpy:48
translate ptPT rom_ArlenaIntroDoggy_68d1fd89:

    # MC @ talk "Oh no..."
    MC @ talk "Oh não..."

# game/data/world_romance/arlena/intro_doggy.rpy:49
translate ptPT rom_ArlenaIntroDoggy_722badb0:

    # ARLENA "He was! He had this little button nose!"
    ARLENA "Ele era! Tinha este narizinho de botão!"

# game/data/world_romance/arlena/intro_doggy.rpy:50
translate ptPT rom_ArlenaIntroDoggy_4931e836:

    # MC @ talk "His voice sounded like a cat drowning."
    MC @ talk "A voz dele parecia um gato a afogar-se."

# game/data/world_romance/arlena/intro_doggy.rpy:51
translate ptPT rom_ArlenaIntroDoggy_f2f0745d:

    # ARLENA "Well, I liked him."
    ARLENA "Bem, eu gostava dele."

# game/data/world_romance/arlena/intro_doggy.rpy:52
translate ptPT rom_ArlenaIntroDoggy_98ae856a:

    # MC @ talk "... You liked Viktor?"
    MC @ talk "... Tu gostavas do Viktor?"

# game/data/world_romance/arlena/intro_doggy.rpy:53
translate ptPT rom_ArlenaIntroDoggy_7b6bb866:

    # ARLENA "We went out once..."
    ARLENA "Nós saímos uma vez..."

# game/data/world_romance/arlena/intro_doggy.rpy:54
translate ptPT rom_ArlenaIntroDoggy_5e90ebf6:

    # MC @ talk "Oh? Just the once?"
    MC @ talk "Oh? Só uma vez?"

# game/data/world_romance/arlena/intro_doggy.rpy:55
translate ptPT rom_ArlenaIntroDoggy_ba8c73f7:

    # ARLENA "Yeah, but nothing happened or anything like that."
    ARLENA "Sim, mas não aconteceu nada nem nada disso."

# game/data/world_romance/arlena/intro_doggy.rpy:56
translate ptPT rom_ArlenaIntroDoggy_44044d4c:

    # ARLENA "Just didn’t feel right."
    ARLENA "Só não me pareceu certo."

# game/data/world_romance/arlena/intro_doggy.rpy:57
translate ptPT rom_ArlenaIntroDoggy_159bf8b3:

    # MC @ talk "How come?"
    MC @ talk "Porquê?"

# game/data/world_romance/arlena/intro_doggy.rpy:58
translate ptPT rom_ArlenaIntroDoggy_5180d965:

    # "Arlena paused for a moment, choosing her words with care as she took a sip of her wine."
    "A Arlena fez uma pausa por um momento, escolhendo as palavras com cuidado enquanto bebia um gole do seu vinho."

# game/data/world_romance/arlena/intro_doggy.rpy:59
translate ptPT rom_ArlenaIntroDoggy_6d1923e8:

    # ARLENA "Well..."
    ARLENA "Bem..."

# game/data/world_romance/arlena/intro_doggy.rpy:60
translate ptPT rom_ArlenaIntroDoggy_304e9042:

    # ARLENA "I had someone else on my mind at the time, so..."
    ARLENA "Tinha outra pessoa na cabeça na altura, por isso..."

# game/data/world_romance/arlena/intro_doggy.rpy:61
translate ptPT rom_ArlenaIntroDoggy_d674520f:

    # "As Arlena shyly looked away, it dawned on me exactly {i}who{/i} had been on her mind."
    "Enquanto a Arlena timidamente desviava o olhar, apercebi-me exatamente de {i}quem{/i} tinha estado na mente dela."

# game/data/world_romance/arlena/intro_doggy.rpy:62
translate ptPT rom_ArlenaIntroDoggy_186fc647:

    # MC @ talk "... Ah."
    MC @ talk "... Ah."

# game/data/world_romance/arlena/intro_doggy.rpy:63
translate ptPT rom_ArlenaIntroDoggy_8a61850d:

    # ARLENA "It’s fine, it was a long time ago, my standards were extremely low."
    ARLENA "Está tudo bem, foi há muito tempo, os meus padrões eram extremamente baixos."

# game/data/world_romance/arlena/intro_doggy.rpy:64
translate ptPT rom_ArlenaIntroDoggy_20af471b:

    # ARLENA "... And you were an ass."
    ARLENA "... E tu eras um idiota."

# game/data/world_romance/arlena/intro_doggy.rpy:65
translate ptPT rom_ArlenaIntroDoggy_22ff4802:

    # MC @ talk "... But I’m likable now, huh?"
    MC @ talk "... Mas agora sou mais simpático, hã?"

# game/data/world_romance/arlena/intro_doggy.rpy:66
translate ptPT rom_ArlenaIntroDoggy_90004009:

    # "Arlena smiled alluringly before once again reaching to grab her wine."
    "A Arlena sorriu sedutoramente antes de estender a mão outra vez para pegar no seu vinho."

# game/data/world_romance/arlena/intro_doggy.rpy:67
translate ptPT rom_ArlenaIntroDoggy_a1831a05:

    # ARLENA "Yes..."
    ARLENA "Sim..."

# game/data/world_romance/arlena/intro_doggy.rpy:68
translate ptPT rom_ArlenaIntroDoggy_1627ab5c:

    # ARLENA "You are {i}tolerable{/i}."
    ARLENA "Tu és {i}tolerável{/i}."

# game/data/world_romance/arlena/intro_doggy.rpy:69
translate ptPT rom_ArlenaIntroDoggy_64ecede6:

    # MC @ talk "As are you, m’lady."
    MC @ talk "Assim como tu, m'lady."

# game/data/world_romance/arlena/intro_doggy.rpy:70
translate ptPT rom_ArlenaIntroDoggy_8983e408:

    # "I raised my drink."
    "Ergui a minha bebida."

# game/data/world_romance/arlena/intro_doggy.rpy:71
translate ptPT rom_ArlenaIntroDoggy_fb88f9c8:

    # MC @ talk "Here’s to being tolerable."
    MC @ talk "A ser tolerável."

# game/data/world_romance/arlena/intro_doggy.rpy:72
translate ptPT rom_ArlenaIntroDoggy_d25deed9:

    # "Arlena playfully clinked her drink against mine, but after swigging the last of it down and reaching over for the bottle to refill it, she realised it was empty."
    "A Arlena fez um brinde brincalhão com o copo contra o meu, mas depois de beber o último gole e estender a mão para a garrafa para reabastecer, apercebeu-se que estava vazia."

# game/data/world_romance/arlena/intro_doggy.rpy:73
translate ptPT rom_ArlenaIntroDoggy_4ec86ff2:

    # ARLENA "Oh! We’re out of wine..."
    ARLENA "Oh! Ficámos sem vinho..."

# game/data/world_romance/arlena/intro_doggy.rpy:74
translate ptPT rom_ArlenaIntroDoggy_c5bed80f:

    # ARLENA "Heh... Time flies, huh? "
    ARLENA "Heh... O tempo voa, hã?"

# game/data/world_romance/arlena/intro_doggy.rpy:80
translate ptPT rom_ArlenaIntroDoggy_adc08c4b:

    # "Changing the subject, we spent the rest of the... date contentedly chatting about other things till finally, she waved me off into the cool night air to make my way home."
    "Mudando de assunto, passámos o resto do... encontro a conversar contentes sobre outras coisas até que finalmente, ela me acenou para o ar frio da noite para eu fazer o meu caminho para casa."

# game/data/world_romance/arlena/intro_doggy.rpy:81
translate ptPT rom_ArlenaIntroDoggy_b39cecf2:

    # "I couldn’t help but notice, despite the pleasantness of the evening, there was {i}a tinge of disappointment{/i} in her voice as I made my move to leave."
    "Não pude deixar de notar, apesar da agradabilidade da noite, que havia {i}um toque de desapontamento{/i} na sua voz quando eu fiz o movimento de sair."

# game/data/world_romance/arlena/intro_doggy.rpy:86
translate ptPT rom_ArlenaIntroDoggy_dfe1d604:

    # ARLENA "Thanks for a good time, turns out you CAN be a gentleman when you put your mind to it."
    ARLENA "Obrigada por um bom momento, afinal TU podes ser um cavalheiro quando te aplicas."

# game/data/world_romance/arlena/intro_doggy.rpy:87
translate ptPT rom_ArlenaIntroDoggy_afd647ee:

    # MC @ talk "Yeah, thank you too!"
    MC @ talk "Sim, obrigada a ti também!"

# game/data/world_romance/arlena/intro_doggy.rpy:88
translate ptPT rom_ArlenaIntroDoggy_a51aef82:

    # MC @ talk "I'll be going now."
    MC @ talk "Vou-me embora agora."

# game/data/world_romance/arlena/intro_doggy.rpy:89
translate ptPT rom_ArlenaIntroDoggy_cee7a7a3:

    # MC @ talk "Take care, Arlena."
    MC @ talk "Tem cuidado, Arlena."

# game/data/world_romance/arlena/intro_doggy.rpy:90
translate ptPT rom_ArlenaIntroDoggy_d633fcc7:

    # "With a heavy heart, I left the smithy."
    "Com o coração pesado, deixei a forja."

# game/data/world_romance/arlena/intro_doggy.rpy:96
translate ptPT rom_ArlenaIntroDoggy_0bd83054:

    # ARLENA "W-What do you mean?"
    ARLENA "O-O que queres dizer?"

# game/data/world_romance/arlena/intro_doggy.rpy:97
translate ptPT rom_ArlenaIntroDoggy_9d168846:

    # MC @ talk "... Well."
    MC @ talk "... Bem."

# game/data/world_romance/arlena/intro_doggy.rpy:98
translate ptPT rom_ArlenaIntroDoggy_173d1d2a:

    # MC @ talk "It’s just, tell me if I’m reading this wrong but..."
    MC @ talk "É só, diz-me se eu estiver a perceber mal, mas..."

# game/data/world_romance/arlena/intro_doggy.rpy:99
translate ptPT rom_ArlenaIntroDoggy_27744584:

    # MC @ talk "You didn’t just invite me here tonight to reminisce about our time at school, did you?"
    MC @ talk "Não me convidaste aqui esta noite só para recordar o nosso tempo na escola, pois não?"

# game/data/world_romance/arlena/intro_doggy.rpy:100
translate ptPT rom_ArlenaIntroDoggy_640ae29c:

    # "Arlena said nothing, her mouth hung slightly open as she stared wide eyed at me in waiting."
    "A Arlena não disse nada, a boca ficou ligeiramente aberta enquanto olhava para mim de olhos arregalados à espera."

# game/data/world_romance/arlena/intro_doggy.rpy:103
translate ptPT rom_ArlenaIntroDoggy_f684eedb:

    # "I inched towards Arlena, never breaking eye contact before placing a tender kiss onto her lips."
    "Eu aproximei-me da Arlena, sem nunca quebrar o contacto visual antes de colocar um beijo terno nos seus lábios."

# game/data/world_romance/arlena/intro_doggy.rpy:104
translate ptPT rom_ArlenaIntroDoggy_641115a0:

    # "For just a moment, Arlena hesitated, her breath hot and heavy on my face, before she sunk into the kiss and slipped her soft tongue into my mouth."
    "Por apenas um momento, a Arlena hesitou, o seu hálito quente e pesado na minha cara, antes de se afundar no beijo e deslizar a sua língua macia para dentro da minha boca."

# game/data/world_romance/arlena/intro_doggy.rpy:105
translate ptPT rom_ArlenaIntroDoggy_baa8fc70:

    # ARLENA "... Fuck it."
    ARLENA "... Que se foda."

# game/data/world_romance/arlena/intro_doggy.rpy:109
translate ptPT rom_ArlenaIntroDoggy_edf29e6c:

    # "Dropping the fur blanket to the floor, Arlena revealed the see-through night gown she wore beneath."
    "Deixando cair a manta de peles ao chão, a Arlena revelou a camisa de noite transparente que vestia por baixo."

# game/data/world_romance/arlena/intro_doggy.rpy:110
translate ptPT rom_ArlenaIntroDoggy_d114ebfb:

    # "It hung off her small frame, slipping over the curves of her body like silk."
    "Pendia da sua pequena estrutura, deslizando sobre as curvas do seu corpo como seda."

# game/data/world_romance/arlena/intro_doggy.rpy:111
translate ptPT rom_ArlenaIntroDoggy_f4816b4f:

    # "She took my hand and lead me over to her bed with another passionate kiss."
    "Ela pegou na minha mão e guiou-me para a sua cama com outro beijo apaixonado."

# game/data/world_romance/arlena/intro_doggy.rpy:112
translate ptPT rom_ArlenaIntroDoggy_ff443ffc:

    # ARLENA "Mmm..."
    ARLENA "Mmm..."

# game/data/world_romance/arlena/intro_doggy.rpy:113
translate ptPT rom_ArlenaIntroDoggy_56b416ba:

    # ARLENA "I’ve wanted this for a long time."
    ARLENA "Eu quero isto há muito tempo."

# game/data/world_romance/arlena/intro_doggy.rpy:114
translate ptPT rom_ArlenaIntroDoggy_72ca64ae:

    # MC @ talk "How do you—"
    MC @ talk "Como é que tu—"

# game/data/world_romance/arlena/intro_doggy.rpy:115
translate ptPT rom_ArlenaIntroDoggy_2d300459:

    # ARLENA "Shut up and take me."
    ARLENA "Cala-te e toma-me."

# game/data/world_romance/arlena/intro_doggy.rpy:116
translate ptPT rom_ArlenaIntroDoggy_b38f62b2:

    # "She began stripping my clothes off with an animal like passion, ripping my shirt over my head and then tracing the lines of my muscles with her fingertips."
    "Ela começou a despir-me com uma paixão animalesca, rasgando a minha camisa pela cabeça e depois traçando as linhas dos meus músculos com as pontas dos dedos."

# game/data/world_romance/arlena/intro_doggy.rpy:117
translate ptPT rom_ArlenaIntroDoggy_dcef3b16:

    # "As she took off my trousers, her eyes widened when she saw the size of my hardening member."
    "Enquanto ela me tirava as calças, os seus olhos arregalaram-se quando viu o tamanho do meu membro a endurecer."

# game/data/world_romance/arlena/intro_doggy.rpy:118
translate ptPT rom_ArlenaIntroDoggy_e59c4837:

    # ARLENA "That’s... {i}big.{/i}"
    ARLENA "Isso é... {i}grande.{/i}"

# game/data/world_romance/arlena/intro_doggy.rpy:119
translate ptPT rom_ArlenaIntroDoggy_7a30e52d:

    # MC @ talk "... Do you—"
    MC @ talk "... Tu—"

# game/data/world_romance/arlena/intro_doggy.rpy:120
