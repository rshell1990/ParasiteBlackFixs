    # SHYAHTAN "(I have its scent.)"
    SHYAHTAN "(Tenho o seu cheiro.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:8
translate ptPT rom_marbella_shared_the_face_049df98c:

    # MC @ think "(You mean whatever's killing the Khazah?)"
    MC @ think "(Queres dizer o que quer que esteja a matar os Khazah?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:9
translate ptPT rom_marbella_shared_the_face_6b394e0f:

    # SHYAHTAN "(We can pursue it... should you wish.)"
    SHYAHTAN "(Podemos persegui-lo... se desejares.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:11
translate ptPT rom_marbella_shared_the_face_7af6f9a4_1:

    # SHYAHTAN "(I have its scent.)"
    SHYAHTAN "(Tenho o seu cheiro.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:12
translate ptPT rom_marbella_shared_the_face_d1649a6b:

    # SHYAHTAN "(We should pursue.)"
    SHYAHTAN "(Devemos perseguir.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:18
translate ptPT rom_marbella_shared_the_face_4c5cd0e2:

    # SHYAHTAN "(The creature will return to hunt another night, no doubt...)"
    SHYAHTAN "(A criatura voltará para caçar noutra noite, sem dúvida...)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:25
translate ptPT rom_marbella_shared_the_face_68b0d87d:

    # "The scent was thick with heavy blood. Had the creature found a victim?"
    "O cheiro era denso com sangue pesado. Terá a criatura encontrado uma vítima?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:26
translate ptPT rom_marbella_shared_the_face_adb713b3:

    # "What even was it?"
    "Afinal o que era?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:30
translate ptPT rom_marbella_shared_the_face_e49976b9:

    # "Down the dark alleyways, kicking up cold sand, I turned a corner to see... {i}it.{/i}"
    "Pelas ruelas escuras, levantando areia fria, virei uma esquina para ver... {i}a coisa.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:31
translate ptPT rom_marbella_shared_the_face_c9566933:

    # "A woman — a prostitute — pressing a man up against a wall."
    "Uma mulher — uma prostituta — a pressionar um homem contra uma parede."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:32
translate ptPT rom_marbella_shared_the_face_2c12ecca:

    # "Her red lips were pressed to his throat, his eyes rolled back, his face deathly white."
    "Os seus lábios vermelhos estavam pressionados contra a garganta dele, os olhos dele revirados, a cara mortalmente pálida."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:33
translate ptPT rom_marbella_shared_the_face_1bcca6ca:

    # "The creature snapped her neck toward me, revealing the huge, gaping wound in the man's neck and the blood splattered around her mouth."
    "A criatura virou o pescoço na minha direção, revelando a enorme ferida aberta no pescoço do homem e o sangue salpicado à volta da sua boca."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:34
translate ptPT rom_marbella_shared_the_face_a2c1a49b:

    # "Her eyes glowed yellow as she inched closer, taking in a deep inhale."
    "Os seus olhos brilhavam amarelos enquanto ela se aproximava, fazendo uma inspiração profunda."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:35
translate ptPT rom_marbella_shared_the_face_a9c43efc:

    # "Before I knew it, the fleshy skin of the woman dropped to the floor as though it was a suit... her severed head rolling along the floor."
    "Antes que me apercebesse, a pele carnuda da mulher caiu no chão como se fosse um fato... a sua cabeça decepada a rolar pelo chão."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:36
translate ptPT rom_marbella_shared_the_face_29b36423:

    # "The creature... The real creature, perhaps sensing something was {i}different{/i} about me too,"
    "A criatura... A verdadeira criatura, talvez sentindo algo de {i}diferente{/i} em mim também,"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:37
translate ptPT rom_marbella_shared_the_face_05e13833:

    # "appeared before me in all it's hideous, terror."
    "apareceu diante de mim em todo o seu horror hediondo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:42
translate ptPT rom_marbella_shared_the_face_a857fd35:

    # THE_FACE "You're not human."
    THE_FACE "Não és humano."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:43
translate ptPT rom_marbella_shared_the_face_1c4ec264:

    # THE_FACE "At least not fully... Who are you?"
    THE_FACE "Pelo menos não totalmente... Quem és tu?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:44
translate ptPT rom_marbella_shared_the_face_a7e9b266:

    # THE_FACE "{i}... What are you?{/i}"
    THE_FACE "{i}...O que és tu?{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:49
translate ptPT rom_marbella_shared_the_face_menu_c6af2dbb:

    # "The creature grinned."
    "A criatura sorriu."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:50
translate ptPT rom_marbella_shared_the_face_menu_19136f53:

    # THE_FACE "I'm you."
    THE_FACE "Sou tu."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:51
translate ptPT rom_marbella_shared_the_face_menu_107c286b:

    # THE_FACE "I'm them."
    THE_FACE "Sou eles."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:52
translate ptPT rom_marbella_shared_the_face_menu_f9227432:

    # THE_FACE "I'm whatever face I wear."
    THE_FACE "Sou qualquer cara que eu usar."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:56
translate ptPT rom_marbella_shared_the_face_menu_6dc791f0:

    # THE_FACE "Cheap imitations."
    THE_FACE "Imitações baratas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:57
translate ptPT rom_marbella_shared_the_face_menu_1359da5a:

    # THE_FACE "Toys of the one called Zanarak."
    THE_FACE "Brinquedos daquele que se chama Zanarak."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:58
translate ptPT rom_marbella_shared_the_face_menu_8268f71e:

    # "The face grinned."
    "A cara sorriu."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:59
translate ptPT rom_marbella_shared_the_face_menu_00cbccde:

    # THE_FACE "We are older."
    THE_FACE "Somos mais antigos."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:60
translate ptPT rom_marbella_shared_the_face_menu_0e779db2:

    # MC @ think "Is there many of you left?"
    MC @ think "Ainda há muitos de vocês?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:61
translate ptPT rom_marbella_shared_the_face_menu_c2715630:

    # THE_FACE "I have not sensed another of my kind in over four-hundred years."
    THE_FACE "Não sinto outro da minha espécie há mais de quatrocentos anos."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:62
translate ptPT rom_marbella_shared_the_face_menu_7eff8b9b:

    # MC @ think "... Then maybe you're the last?"
    MC @ think "...Então talvez sejas o último?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:63
translate ptPT rom_marbella_shared_the_face_menu_c6af2dbb_1:

    # "The creature grinned."
    "A criatura sorriu."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:64
translate ptPT rom_marbella_shared_the_face_menu_ffd72ac8:

    # THE_FACE "{i}No.{/i}"
    THE_FACE "{i}Não.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:70
translate ptPT rom_marbella_shared_the_face_menu_87f6b424:

    # THE_FACE "And what do you want... [player_name!t]?"
    THE_FACE "E o que é que queres... [player_name!t]?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:72
translate ptPT rom_marbella_shared_the_face_menu_9c9ec1b9:

    # SHYAHTAN "{i}To eat you.{/i}"
    SHYAHTAN "{i}Para te comer.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:73
translate ptPT rom_marbella_shared_the_face_menu_aa8b5630:

    # MC "(Gods be damned, man! Why would you blurt that out?!)"
    MC "(Raios te partam, homem! Porque é que foste dizer isso?!)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:74
translate ptPT rom_marbella_shared_the_face_menu_f6e6be2e:

    # THE_FACE "... Interesting."
    THE_FACE "...Interessante."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:75
translate ptPT rom_marbella_shared_the_face_menu_6c6fde8c:

    # THE_FACE "Then let me make you an offer."
    THE_FACE "Então deixa-me fazer-te uma oferta."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:76
translate ptPT rom_marbella_shared_the_face_menu_e3946eb2:

    # THE_FACE "I will give you a piece to eat if you leave me alone."
    THE_FACE "Dou-te um pedaço para comer se me deixares em paz."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:77
translate ptPT rom_marbella_shared_the_face_menu_1dacda77:

    # MC "... What?"
    MC "...O quê?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:78
translate ptPT rom_marbella_shared_the_face_menu_692a2e7d:

    # MC "(This thing is unnerving as all seven hells.)"
    MC "(Esta coisa é tão inquietante como todos os sete infernos.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:79
translate ptPT rom_marbella_shared_the_face_menu_2c2b6b44:

    # MC "(Should we take its offer?)"
    MC "(Aceitamos a oferta dele?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:80
translate ptPT rom_marbella_shared_the_face_menu_2643f325:

    # MC "(Will a piece of it be enough?)"
    MC "(Será que um pedaço dela será suficiente?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:81
translate ptPT rom_marbella_shared_the_face_menu_ead25a14:

    # SHYAHTAN "(Yes.)"
    SHYAHTAN "(Sim.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:82
translate ptPT rom_marbella_shared_the_face_menu_7bd068a0:

    # "My eyes drifted toward the poor bastard the creature was devouring."
    "Os meus olhos desviaram-se para o pobre diabo que a criatura estava a devorar."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:83
translate ptPT rom_marbella_shared_the_face_menu_6db09147:

    # SHYAHTAN "(That is, if you are fine with letting this creature continue what it's doing...)"
    SHYAHTAN "(Isto é, se não te importares de deixar esta criatura continuar o que está a fazer...)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:86
translate ptPT rom_marbella_shared_the_face_menu_b2b6d0b3:

    # MC @ talk "You to leave this city."
    MC @ talk "Que saias desta cidade."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:87
translate ptPT rom_marbella_shared_the_face_menu_cb4efca3:

    # THE_FACE "And why would I do that?"
    THE_FACE "E porque é que eu faria isso?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:88
translate ptPT rom_marbella_shared_the_face_menu_3c3b1657:

    # MC @ talk "You've preyed on the wrong people. They sent me to deal with you, one way or another."
    MC @ talk "Atacaste as pessoas erradas. Enviaram-me para lidar contigo, de uma forma ou de outra."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:89
translate ptPT rom_marbella_shared_the_face_menu_2e8c2376:

    # THE_FACE "And why should I not just kill you... and then kill them?"
    THE_FACE "E porque não haveria de simplesmente matar-te... e depois matá-los?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:90
translate ptPT rom_marbella_shared_the_face_menu_1bf20a23:

    # THE_FACE "I rather like this hunting ground."
    THE_FACE "Gosto bastante deste campo de caça."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:96
translate ptPT rom_marbella_shared_the_face_menu_ddd9a544:

    # THE_FACE "I can always find a new face to wear."
    THE_FACE "Posso sempre arranjar uma cara nova para vestir."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:97
translate ptPT rom_marbella_shared_the_face_menu_bc03026e:

    # MC @ serious "But whatever the hells you are, you need to feed."
    MC @ serious "Mas seja o que for que tu és, precisas de te alimentar."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:98
translate ptPT rom_marbella_shared_the_face_menu_ed137a9a:

    # MC @ think "The bodies are stacking up. It won't be long before the merchant lords hire inquisitors or someone worse."
    MC @ think "Os corpos estão a acumular-se. Não vai demorar muito até os lordes mercadores contratarem inquisidores ou alguém pior."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:99
translate ptPT rom_marbella_shared_the_face_menu_6755aa3d:

    # MC @ talk "Then it's only a matter of time."
    MC @ talk "Então é só uma questão de tempo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:100
translate ptPT rom_marbella_shared_the_face_menu_4867ba98:

    # "The creature seemed to contemplate my words."
    "A criatura pareceu contemplar as minhas palavras."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:101
translate ptPT rom_marbella_shared_the_face_menu_b2c0a385:

    # THE_FACE "... Hm."
    THE_FACE "...Hm."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:102
translate ptPT rom_marbella_shared_the_face_menu_63f5e52d:

    # THE_FACE "Perhaps it is time I found a new hunting ground."
    THE_FACE "Talvez seja hora de encontrar um novo terreno de caça."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:108
translate ptPT rom_marbella_shared_the_face_menu_03235ba9:

    # "The creature grinned as it ripped off its arm and threw it toward me."
    "A criatura sorriu enquanto arrancava o próprio braço e o atirava na minha direção."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:109
translate ptPT rom_marbella_shared_the_face_menu_5c574a52:

    # "Strange tendrils still writhed from the open flesh wound."
    "Tentáculos estranhos ainda se contorciam da ferida aberta na carne."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:110
translate ptPT rom_marbella_shared_the_face_menu_4e2c4d3e:

    # MC @ scared "... What. The. Fuck."
    MC @ scared "...Mas. Que. Merda."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:111
translate ptPT rom_marbella_shared_the_face_menu_42ddfa67:

    # THE_FACE "A wise choice."
    THE_FACE "Uma escolha sábia."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:116
translate ptPT rom_marbella_shared_the_face_menu_8761e6c2:

    # THE_FACE "... Wearing your skin is going to be fun."
    THE_FACE "...Usar a tua pele vai ser divertido."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:120
translate ptPT rom_marbella_shared_the_face_menu_7e6a4ecc:

    # "With a death rattle, the creature writhed on the ground in agony."
    "Com um estertor de morte, a criatura contorceu-se no chão em agonia."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:121
translate ptPT rom_marbella_shared_the_face_menu_cf5660e2:

    # "A pool of blood spread from its wounds until at last it lay still."
    "Uma poça de sangue espalhou-se das suas feridas até que, por fim, ficou imóvel."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:125
translate ptPT rom_marbella_shared_the_face_menu_465c70d7:

    # MC @ scared "(... What in the hells was that?)"
    MC @ scared "(...Que raio foi aquilo?)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:128
translate ptPT rom_marbella_shared_the_face_menu_7c9c4372:

    # SHYAHTAN "(Just another predator trying to survive.)"
    SHYAHTAN "(Apenas mais um predador a tentar sobreviver.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:129
translate ptPT rom_marbella_shared_the_face_menu_1ba06388:

    # MC @ think "(Well... I should head back to the Khazah at least.)"
    MC @ think "(Bem... Pelo menos devo voltar para os Khazah.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:131
translate ptPT rom_marbella_shared_the_face_menu_aeebd902:

    # SHYAHTAN "(Food.)"
    SHYAHTAN "(Comida.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:132
translate ptPT rom_marbella_shared_the_face_menu_79ad5e9a:

    # MC @ angry "(Is that really all you can think about?!)"
    MC @ angry "(É só nisso que consegues pensar?!)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:133
translate ptPT rom_marbella_shared_the_face_menu_261fccd8:

    # "I felt my own hand fight against me, rising toward the creature's body."
    "Senti a minha própria mão a lutar contra mim, a erguer-se na direção do corpo da criatura."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:134
translate ptPT rom_marbella_shared_the_face_menu_647fb08d:

    # "Black tendrils pushed out, wrapping around and inspecting the corpse."
    "Tentáculos negros empurraram para fora, enrolaram-se e inspecionaram o cadáver."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:135
translate ptPT rom_marbella_shared_the_face_menu_b4187bec:

    # "Suddenly, one of the tendrils pierced the flesh, draining it until, within moments, it became a withered husk."
    "De repente, um dos tentáculos perfurou a carne, drenando-a até que, em poucos instantes, se tornou uma casca ressequida."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:136
translate ptPT rom_marbella_shared_the_face_menu_4aea6492:

    # MC @ talk "Uhh, you got what you needed?"
    MC @ talk "Hã, conseguiste o que precisavas?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:137
translate ptPT rom_marbella_shared_the_face_menu_a240a5ea:

    # SHYAHTAN "Yes."
    SHYAHTAN "Sim."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:138
translate ptPT rom_marbella_shared_the_face_menu_9f7a6c71:

    # SHYAHTAN "Now we can return to our mate tomorrow."
    SHYAHTAN "Agora podemos voltar para a nossa companheira amanhã."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:139
translate ptPT rom_marbella_shared_the_face_menu_56c9cbc1:

    # MC "Right..."
    MC "Certo..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:144
translate ptPT rom_marbella_shared_the_face_negotiate_0909f5b7:

    # "To my horror, I watched as the creature made short work of the man, stuffing it's face with his inards before turning it's gaze back towards the lifeless body of the woman."
    "Para meu horror, observei a criatura despachar o homem, enfiando a cara nas suas entranhas antes de virar o olhar de volta para o corpo sem vida da mulher."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:145
translate ptPT rom_marbella_shared_the_face_negotiate_03091605:

    # "Clambering back inside of her, the skin stretching over the flesh unnaturally, and then, it began to settle over the the strange creature's body as it contorted itself into shape."
    "A trepar de volta para dentro dela, a pele a esticar-se sobre a carne de forma não natural, e depois, começou a assentar sobre o corpo da estranha criatura enquanto se contorcia para tomar forma."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:146
translate ptPT rom_marbella_shared_the_face_negotiate_c2f1fa26:

    # "Bones breaking and snapping into place as the creature shrink, fitting itself inside of her."
    "Ossos a partir-se e a estalar ao encaixarem-se enquanto a criatura encolhia, a caber dentro dela."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:147
translate ptPT rom_marbella_shared_the_face_negotiate_98122aeb:

    # "It grabbed the severed head, with tendrils protruding from the open wound of the neck and connected the head there, almost as if it was screwing the head back on."
    "Agarrou na cabeça decepada, com tentáculos a sair da ferida aberta do pescoço e ligou a cabeça ali, quase como se estivesse a aparafusar a cabeça de volta."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:148
translate ptPT rom_marbella_shared_the_face_negotiate_76fbf04d:

    # "From the open wound where his head had been, the lifeless face moved once more."
    "Da ferida aberta onde estivera a cabeça, a cara sem vida mexeu-se mais uma vez."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:149
translate ptPT rom_marbella_shared_the_face_negotiate_1eda4053:

    # "In a few gory moments, sinew, flesh, and skin covered all wounds."
    "Em poucos momentos sangrentos, tendões, carne e pele cobriram todas as feridas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:150
translate ptPT rom_marbella_shared_the_face_negotiate_80623e6a:

    # "The eyes opened."
    "Os olhos abriram-se."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:151
translate ptPT rom_marbella_shared_the_face_negotiate_e7dbd68e:

    # "{i}It looked like a normal woman.{/i}"
    "{i}Parecia uma mulher normal.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:156
translate ptPT rom_marbella_shared_the_face_negotiate_da31ff86:

    # "It smiled at me."
    "Sorriu-me."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:157
translate ptPT rom_marbella_shared_the_face_negotiate_ce2bbed9:

    # THE_FACE @ smile "Now I take my leave."
    THE_FACE @ smile "Agora retiro-me."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:158
translate ptPT rom_marbella_shared_the_face_negotiate_de8d54d9:

    # THE_FACE @ smile "Perhaps we will meet again one day?"
    THE_FACE @ smile "Talvez nos voltemos a encontrar um dia?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:159
translate ptPT rom_marbella_shared_the_face_negotiate_8129db98:

    # THE_FACE "You are..."
    THE_FACE "Tu és..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:160
translate ptPT rom_marbella_shared_the_face_negotiate_9aa8c348:

    # THE_FACE @ smile "{i}Interesting.{/i}"
    THE_FACE @ smile "{i}Interessante.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:161
translate ptPT rom_marbella_shared_the_face_negotiate_6cc75be9:

    # MC @ talk "You never told me your name."
    MC @ talk "Nunca me disseste o teu nome."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:162
translate ptPT rom_marbella_shared_the_face_negotiate_259b0362:

    # "The creature grinned again, its eyes black as it bared razor-thin teeth."
    "A criatura voltou a sorrir, os olhos negros enquanto mostrava dentes finos como navalhas."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:163
translate ptPT rom_marbella_shared_the_face_negotiate_3070413d:

    # THE_FACE @ smile "I don't have a name... I just take them."
    THE_FACE @ smile "Não tenho nome... Apenas os tomo."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:164
translate ptPT rom_marbella_shared_the_face_negotiate_9266cbab:

    # THE_FACE "... People like to think when they're alone, they're safe."
    THE_FACE "...As pessoas gostam de pensar que quando estão sozinhas, estão seguras."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:165
translate ptPT rom_marbella_shared_the_face_negotiate_307da707:

    # "It stepped back, disappearing into the darkness."
    "Deu um passo atrás, desaparecendo na escuridão."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:167
translate ptPT rom_marbella_shared_the_face_negotiate_47aac664:

    # "The last thing I saw were its razor teeth and glowing yellow eyes."
    "A última coisa que vi foram os seus dentes afiados e olhos amarelos brilhantes."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:168
translate ptPT rom_marbella_shared_the_face_negotiate_ba425c3c:

    # THE_FACE "{i}But we are waiting for them every night.{/i}"
    THE_FACE "{i}Mas nós esperamos por elas todas as noites.{/i}"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:169
translate ptPT rom_marbella_shared_the_face_negotiate_197a0fbf:

    # "And with that, it was gone."
    "E com isso, desapareceu."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:171
translate ptPT rom_marbella_shared_the_face_negotiate_d9d519af:

    # MC @ scared "That... thing..."
    MC @ scared "Aquela... coisa..."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:172
translate ptPT rom_marbella_shared_the_face_negotiate_307cc04c:

    # MC @ scared "How many of those things walk among us?"
    MC @ scared "Quantas dessas coisas andam entre nós?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:173
translate ptPT rom_marbella_shared_the_face_negotiate_8dd99207:

    # SHYAHTAN "(In our travels, I have occasionally sensed their presence.)"
    SHYAHTAN "(Nas nossas viagens, senti ocasionalmente a sua presença.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:174
translate ptPT rom_marbella_shared_the_face_negotiate_e51f39a9:

    # SHYAHTAN "(They are very few in number.)"
    SHYAHTAN "(São muito poucos em número.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:175
translate ptPT rom_marbella_shared_the_face_negotiate_de542541:

    # SHYAHTAN "({i}But they are out there...{/i})"
    SHYAHTAN "({i}Mas eles andam por aí...{/i})"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:176
translate ptPT rom_marbella_shared_the_face_negotiate_e3faf380:

    # "Pushing the thought aside, I looked down at the severed arm and reached to pick it up."
    "Afastando o pensamento, olhei para o braço decepado e estendi a mão para o apanhar."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:178
translate ptPT rom_marbella_shared_the_face_negotiate_f7b4d877:

    # MC @ think "(With that sorted, I should head back to the Khazah and let them know this won't be a problem anymore.)"
    MC @ think "(Com isso resolvido, devo voltar aos Khazah e avisá-los de que isto já não será um problema.)"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:180
translate ptPT rom_marbella_shared_the_face_negotiate_71bd67e9:

    # "From my other hand, Shyahtan's black tendrils pushed out, wrapping around and inspecting the arm."
    "Da minha outra mão, os tentáculos negros de Shyahtan empurraram para fora, enrolaram-se e inspecionaram o braço."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:181
translate ptPT rom_marbella_shared_the_face_negotiate_b4187bec:

    # "Suddenly, one of the tendrils pierced the flesh, draining it until, within moments, it became a withered husk."
    "De repente, um dos tentáculos perfurou a carne, drenando-a até que, em poucos instantes, se tornou uma casca ressequida."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:182
translate ptPT rom_marbella_shared_the_face_negotiate_4aea6492:

    # MC @ talk "Uhh, you got what you needed?"
    MC @ talk "Hã, conseguiste o que precisavas?"

# game/data/world_romance/marbella/rom_marbella_shared.rpy:183
translate ptPT rom_marbella_shared_the_face_negotiate_a240a5ea:

    # SHYAHTAN "Yes."
    SHYAHTAN "Sim."

# game/data/world_romance/marbella/rom_marbella_shared.rpy:184
translate ptPT rom_marbella_shared_the_face_negotiate_9f7a6c71:

    # SHYAHTAN "Now we can return to our mate tomorrow."
    SHYAHTAN "Agora podemos voltar para a nossa companheira amanhã."

