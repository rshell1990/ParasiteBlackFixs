# game/data/world_romance/nijah/scr_firstpreg.rpy:8
translate ptPT preg_Nijah_goodNews_intro_88e7e95f:

    # "As I entered her home, Nijah came to me with hands clasped, nervous."
    "Quando entrei na casa dela, Nijah veio até mim de mãos postas, nervosa."

# game/data/world_romance/nijah/scr_firstpreg.rpy:9
translate ptPT preg_Nijah_goodNews_intro_1fa9f7ad:

    # NIJAH "Must speak with you."
    NIJAH "Devo falar com você."

# game/data/world_romance/nijah/scr_firstpreg.rpy:10
translate ptPT preg_Nijah_goodNews_intro_b7dc45a3:

    # "Sensing her distress, I placed my hands on her shoulders."
    "Sentindo sua angústia, coloquei minhas mãos em seus ombros."

# game/data/world_romance/nijah/scr_firstpreg.rpy:11
translate ptPT preg_Nijah_goodNews_intro_89f5ce92:

    # MC @ talk "Nijah, what’s wrong?"
    MC @ talk "Nijah, o que há de errado?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:12
translate ptPT preg_Nijah_goodNews_intro_82be8c65:

    # NIJAH "I... I carry your child."
    NIJAH "Eu... eu carrego seu filho."

# game/data/world_romance/nijah/scr_firstpreg.rpy:13
translate ptPT preg_Nijah_goodNews_intro_f3a940fc:

    # "I pulled back, surprised at the comment."
    "Eu me afastei, surpreso com o comentário."

# game/data/world_romance/nijah/scr_firstpreg.rpy:14
translate ptPT preg_Nijah_goodNews_intro_4f601cd6:

    # MC @ talk "...{i}You’re pregnant?{/i}"
    MC @ talk "...{i}Você está grávida?{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:15
translate ptPT preg_Nijah_goodNews_intro_a5178513:

    # "Nijah sheepishly nodded."
    "Nijah assentiu timidamente."

# game/data/world_romance/nijah/scr_firstpreg.rpy:16
translate ptPT preg_Nijah_goodNews_intro_9a450cee:

    # NIJAH "...Zis not problem?"
    NIJAH "...Não é problema?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:17
translate ptPT preg_Nijah_goodNews_intro_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "O que queres dizer?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:18
translate ptPT preg_Nijah_goodNews_intro_12df316d:

    # NIJAH "M-any Alderian men... They get Ramonian girls with child and go."
    NIJAH "M-quaisquer homens Alderianos... Eles pegam meninas Ramonianas grávidas e vão embora."

# game/data/world_romance/nijah/scr_firstpreg.rpy:19
translate ptPT preg_Nijah_goodNews_intro_75857ca2:

    # NIJAH "...many forced to get rid of child while still in womb."
    NIJAH "...muitos foram forçados a se livrar dos filhos ainda no útero."

# game/data/world_romance/nijah/scr_firstpreg.rpy:20
translate ptPT preg_Nijah_goodNews_intro_5df92709:

    # NIJAH "But... I want to keep your child."
    NIJAH "Mas... eu quero ficar com seu filho."

# game/data/world_romance/nijah/scr_firstpreg.rpy:21
translate ptPT preg_Nijah_goodNews_intro_ff1bdef9:

    # BLACK "She is fit to carry many of our young."
    BLACK "Ela está preparada para carregar muitos de nossos jovens."

# game/data/world_romance/nijah/scr_firstpreg.rpy:22
translate ptPT preg_Nijah_goodNews_intro_d75d061d:

    # BLACK "We should keep this one close as a mate."
    BLACK "Devíamos manter este por perto como companheiro."

# game/data/world_romance/nijah/scr_firstpreg.rpy:23
translate ptPT preg_Nijah_goodNews_intro_2cebcdc8:

    # MC @ talk "...Nijah, I-"
    MC @ talk "...Nijah, eu-"

# game/data/world_romance/nijah/scr_firstpreg.rpy:24
translate ptPT preg_Nijah_goodNews_intro_2cb4cedf:

    # NIJAH "I do not care if child can change into monster like you."
    NIJAH "Não me importa se a criança pode transformar-se em monstro como tu."

# game/data/world_romance/nijah/scr_firstpreg.rpy:25
translate ptPT preg_Nijah_goodNews_intro_ac59f889:

    # NIJAH "It is {i}our{/i} baby, and that is good enough for me."
    NIJAH "É o {i}nosso{/i} bebé, e isso é suficiente para mim."

# game/data/world_romance/nijah/scr_firstpreg.rpy:26
translate ptPT preg_Nijah_goodNews_intro_a51e43f2:

    # "Nijah seemed to wait anxiously for a few moments. Almost stand-offish, perhaps expecting me to tell her to get rid of the child or that I didn’t want to see her anymore."
    "Nijah pareceu esperar ansiosamente por alguns momentos. Quase defensiva, talvez à espera que eu lhe dissesse para se livrar da criança ou que não queria vê-la mais."

# game/data/world_romance/nijah/scr_firstpreg.rpy:27
translate ptPT preg_Nijah_goodNews_intro_abd548b8:

    # MC @ talk "Nijah... {i}You are mine.{/i}"
    MC @ talk "Nijah... {i}Você é meu.{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:28
translate ptPT preg_Nijah_goodNews_intro_e7158e0a:

    # MC @ talk "I am pleased you carry my child."
    MC @ talk "Estou feliz que você carregue meu filho."

# game/data/world_romance/nijah/scr_firstpreg.rpy:29
translate ptPT preg_Nijah_goodNews_intro_d62be6ae:

    # "Nijah’s eyes seemed to light up."
    "Os olhos de Nijah pareceram brilhar."

# game/data/world_romance/nijah/scr_firstpreg.rpy:30
translate ptPT preg_Nijah_goodNews_intro_84ee69e2:

    # NIJAH "R-Really?"
    NIJAH "R-Sério?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:31
translate ptPT preg_Nijah_goodNews_intro_78ec95d9:

    # "With a bright smile, Nijah flung herself onto me, planting kiss onto my lips."
    "Com um sorriso radiante, Nijah atirou-se para cima de mim, plantando um beijo nos meus lábios."

# game/data/world_romance/nijah/scr_firstpreg.rpy:32
translate ptPT preg_Nijah_goodNews_intro_6bcb1c75:

    # NIJAH "M-Master... I love you so much!"
    NIJAH "M-Mestre... eu te amo muito!"

# game/data/world_romance/nijah/scr_firstpreg.rpy:33
translate ptPT preg_Nijah_goodNews_intro_cb9042a3:

    # MC @ talk "Nijah, you know you don’t need to-"
    MC @ talk "Nijah, você sabe que não precisa-"

# game/data/world_romance/nijah/scr_firstpreg.rpy:34
translate ptPT preg_Nijah_goodNews_intro_436f3b45:

    # "Nijah interrupted me again mid-sentence to plant another kiss on my lips."
    "Nijah interrompeu-me outra vez a meio da frase para plantar outro beijo nos meus lábios."

# game/data/world_romance/nijah/scr_firstpreg.rpy:35
translate ptPT preg_Nijah_goodNews_intro_0a0c7479:

    # NIJAH "I shall get some dinner on, stay a while."
    NIJAH "Vou preparar o jantar, fica mais um pouco."

# game/data/world_romance/nijah/scr_firstpreg.rpy:36
translate ptPT preg_Nijah_goodNews_intro_2eb2dd4a:

    # "With that, Nijah turned, humming happily to herself as she made her way to the kitchen to prepare some food."
    "Com aquilo, Nijah virou-se, a cantarolar feliz para si mesma enquanto se dirigia para a cozinha para preparar comida."

# game/data/world_romance/nijah/scr_firstpreg.rpy:41
translate ptPT preg_Nijah_goodNews_intro_6c38b146:

    # "After eating with Nijah, I departed once again, thinking about my soon to be new-born child I was now having with Nijah."
    "Depois de comer com Nijah, parti mais uma vez, pensando no meu filho recém-nascido que agora teria com Nijah."

