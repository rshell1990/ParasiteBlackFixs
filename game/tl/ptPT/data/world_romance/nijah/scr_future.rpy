# game/data/world_romance/nijah/scr_future.rpy:5
translate ptPT rom_Nijah_stage1_future_lines_57b30ffe:

    # NIJAH "I suppose I could go back to working at za Pleasure District..."
    NIJAH "Suponho que poderia voltar a trabalhar no za Pleasure District..."

# game/data/world_romance/nijah/scr_future.rpy:6
translate ptPT rom_Nijah_stage1_future_lines_c606d148:

    # NIJAH "... The money is good, but iz not the safest job..."
    NIJAH "... O dinheiro é bom, mas não é o trabalho mais seguro..."

# game/data/world_romance/nijah/scr_future.rpy:7
translate ptPT rom_Nijah_stage1_future_lines_43fc26ca:

    # MC @ talk "... Is that your only option?"
    MC @ talk "... Essa é sua única opção?"

# game/data/world_romance/nijah/scr_future.rpy:8
translate ptPT rom_Nijah_stage1_future_lines_a57cee14:

    # NIJAH "There is other way, but I’d need investors."
    NIJAH "Existe outra maneira, mas eu precisaria de investidores."

# game/data/world_romance/nijah/scr_future.rpy:9
translate ptPT rom_Nijah_stage1_future_lines_6e7816fb:

    # MC @ talk "Investors? What are you planning?"
    MC @ talk "Investidores? O que você está planejando?"

# game/data/world_romance/nijah/scr_future.rpy:10
translate ptPT rom_Nijah_stage1_future_lines_dd91a10a:

    # NIJAH "I can cook food..."
    NIJAH "Eu posso cozinhar comida..."

# game/data/world_romance/nijah/scr_future.rpy:11
translate ptPT rom_Nijah_stage1_future_lines_0a687ef1:

    # MC @ talk "What? Like bakery food?"
    MC @ talk "O que? Gosta de comida de padaria?"

# game/data/world_romance/nijah/scr_future.rpy:12
translate ptPT rom_Nijah_stage1_future_lines_8199ae0d:

    # NIJAH "No, no... Ramonian street food!"
    NIJAH "No, no... Ramonian street food!"

# game/data/world_romance/nijah/scr_future.rpy:13
translate ptPT rom_Nijah_stage1_future_lines_a41c5243:

    # NIJAH "Food quick, tasty for people to eat while on go..."
    NIJAH "Comida rápida e saborosa para as pessoas comerem em trânsito."

# game/data/world_romance/nijah/scr_future.rpy:14
translate ptPT rom_Nijah_stage1_future_lines_9e9890a6:

    # MC @ smile "Ha-ha! You're full of surprises..."
    MC @ smile "Ha-ha! Você está cheio de surpresas..."

# game/data/world_romance/nijah/scr_future.rpy:15
translate ptPT rom_Nijah_stage1_future_lines_09e880c3:

    # MC @ talk "Well how much do you need?"
    MC @ talk "Não, não... Comida de rua Ramónica!"

# game/data/world_romance/nijah/scr_future.rpy:16
translate ptPT rom_Nijah_stage1_future_lines_e049698d:

    # NIJAH "Enough for stall... Plus ingredients and cooking equipment..."
    NIJAH "O suficiente para a barraca... Além de ingredientes e equipamentos de cozinha..."

# game/data/world_romance/nijah/scr_future.rpy:17
translate ptPT rom_Nijah_stage1_future_lines_6ca852ee:

    # NIJAH "At least thousand gold..."
    NIJAH "Pelo menos mil ouro..."

# game/data/world_romance/nijah/scr_future.rpy:18
translate ptPT rom_Nijah_stage1_future_lines_806b841b:

    # "(That’s quite a lot.)"
    "Bem, quanto é que precisas?"

# game/data/world_romance/nijah/scr_future.rpy:19
translate ptPT rom_Nijah_stage1_future_lines_8c4ad5bf:

    # "(What should I encourage her to do?)"
    "(Isso é bastante.)"

# game/data/world_romance/nijah/scr_future.rpy:22
translate ptPT rom_Nijah_stage1_future_lines_menu_02182bf6:

    # NIJAH @ happy "...!"
    NIJAH @ happy "...!"

# game/data/world_romance/nijah/scr_future.rpy:23
translate ptPT rom_Nijah_stage1_future_lines_menu_d82da894:

    # NIJAH @ smile "You will?"
    NIJAH @ smile "Você vai?"

# game/data/world_romance/nijah/scr_future.rpy:24
translate ptPT rom_Nijah_stage1_future_lines_menu_9f0aa4e9:

    # NIJAH @ smile "A thousand gold?"
    NIJAH @ smile "(O que devo encorajá-la a fazer?)"

# game/data/world_romance/nijah/scr_future.rpy:25
translate ptPT rom_Nijah_stage1_future_lines_menu_d58cad19:

    # NIJAH "I... I cannot ask you to do zis!"
    NIJAH "Mil de ouro?"

# game/data/world_romance/nijah/scr_future.rpy:30
translate ptPT rom_Nijah_stage1_future_lines_menu_97fa787e:

    # NIJAH "Zis is..."
    NIJAH "Zis é..."

# game/data/world_romance/nijah/scr_future.rpy:31
translate ptPT rom_Nijah_stage1_future_lines_menu_cdf45d1e:

    # "Nijah started to cry"
    "Nijah começou a chorar"

# game/data/world_romance/nijah/scr_future.rpy:32
translate ptPT rom_Nijah_stage1_future_lines_menu_04f17e1e:

    # NIJAH @ sad "... You haz done too much for me."
    NIJAH @ sad "Eu... Eu não vosso pedir zisso!"

# game/data/world_romance/nijah/scr_future.rpy:34
translate ptPT rom_Nijah_stage1_future_lines_menu_a6b98d5f:

    # "Nijah hurried forward, wrapping her arms around me in a tight hug, when she pulled back, she smiled warmly, tears streaming down her cheeks in joy."
    "... Tu fazeste demais por mim."

# game/data/world_romance/nijah/scr_future.rpy:38
translate ptPT rom_Nijah_stage1_future_lines_menu_a997409b:

    # NIJAH "Alright... I trust you... I shall wait for you."
    NIJAH "Tudo bem... eu confio em você... vou esperar por você."

# game/data/world_romance/nijah/scr_future.rpy:42
translate ptPT rom_Nijah_stage1_future_lines_menu_b41866ee:

    # NIJAH "You... Vat?"
    NIJAH "Você... Iva?"

# game/data/world_romance/nijah/scr_future.rpy:43
translate ptPT rom_Nijah_stage1_future_lines_menu_88ce21a9:

    # MC @ talk "I’ll pay for you to have your own room."
    MC @ talk "Pagarei para você ter seu próprio quarto."

# game/data/world_romance/nijah/scr_future.rpy:44
translate ptPT rom_Nijah_stage1_future_lines_menu_ba9be3de:

    # MC @ talk "As a Novaras citizen, I can quickly and legally get the paperwork you need."
    MC @ talk "Nijah apressou-se para a frente, a envolver os braços à minha volta num abraço apertado, quando se afastou, sorriu calorosamente, lágrimas a escorrer-lhe pelas bochechas de alegria."

# game/data/world_romance/nijah/scr_future.rpy:45
translate ptPT rom_Nijah_stage1_future_lines_menu_1ef1adfd:

    # MC @ talk "I can also guarantee you have some protection that before you was not privy to."
    MC @ talk "Também posso garantir que você tem alguma proteção que antes não conhecia."

# game/data/world_romance/nijah/scr_future.rpy:46
translate ptPT rom_Nijah_stage1_future_lines_menu_a4b7cc57:

    # MC "Nijah pondered the thought a moment, hesistant about the idea of returning to her old line of work."
    MC "Como cidadão de Novaras, posso obter rapidamente e legalmente a papelada de que precisas."

# game/data/world_romance/nijah/scr_future.rpy:47
translate ptPT rom_Nijah_stage1_future_lines_menu_9cc15501:

    # NIJAH "This... would be better."
    NIJAH "Isso... seria melhor."

# game/data/world_romance/nijah/scr_future.rpy:48
translate ptPT rom_Nijah_stage1_future_lines_menu_1364cda5:

    # NIJAH "{i}But...{/i}"
    NIJAH "{i}Mas...{/i}"

# game/data/world_romance/nijah/scr_future.rpy:49
translate ptPT rom_Nijah_stage1_future_lines_menu_e66bab01:

    # MC "Nijah opened her mouth to protest, but instead, her eyes simply dropped to the floor as she reached and grabbed at her other arm anxiously."
    MC "Nijah ponderou o pensamento por um momento, hesitante sobre a ideia de voltar à sua antiga linha de trabalho."

# game/data/world_romance/nijah/scr_future.rpy:50
translate ptPT rom_Nijah_stage1_future_lines_menu_6f13d691:

    # NIJAH "In return, you want share of gold I earn?"
    NIJAH "Em troca, você quer uma parte do ouro que eu ganho?"

# game/data/world_romance/nijah/scr_future.rpy:51
translate ptPT rom_Nijah_stage1_future_lines_menu_83589d81:

    # MC @ talk "I do."
    MC @ talk "I do."

# game/data/world_romance/nijah/scr_future.rpy:52
translate ptPT rom_Nijah_stage1_future_lines_menu_79b06185:

    # NIJAH "... Thirty percent?"
    NIJAH "... Trinta por cento?"

# game/data/world_romance/nijah/scr_future.rpy:55
translate ptPT rom_Nijah_stage1_future_lines_menu_568c2bf8:

    # MC @ talk "Yeah, that's a deal."
    MC @ talk "Nijah abriu a boca para protestar, mas em vez disso, os seus olhos simplesmente caíram para o chão enquanto ela estendia a mão e agarrava o outro braço ansiosamente."

# game/data/world_romance/nijah/scr_future.rpy:58
translate ptPT rom_Nijah_stage1_future_lines_menu_991a9c2d:

    # NIJAH "Alright... I suppose after all you have done zis iz fair..."
    NIJAH "Tudo bem... suponho que depois de tudo que você fez é justo..."

# game/data/world_romance/nijah/scr_future.rpy:59
translate ptPT rom_Nijah_stage1_future_lines_menu_25a09a38:

    # NIJAH "I come with you to speak to men in charge of district..."
    NIJAH "Venho contigo falar com os responsáveis ​​do distrito..."

# game/data/world_romance/nijah/scr_future.rpy:62
translate ptPT rom_Nijah_stage1_future_lines_menu_ded37cfe:

    # "Following Nijah down to the District, she introduced me to one of the officials there, a tall and uninspiring rake of a man who sat down in one of the few ‘offices’ littered around the District that the girls use when they want to lodge complaints."
    "Sim, é um acordo."

# game/data/world_romance/nijah/scr_future.rpy:63
translate ptPT rom_Nijah_stage1_future_lines_menu_620526a0:

    # "When I showed him my gold, it didn’t exactly take long to have the right paperwork and such in place. In just a few hours, we were set to go..."
    "Seguindo Nijah até ao Distrito, ela apresentou-me a um dos oficiais lá, um homem alto e desinspirador, magricela, que se sentou num dos poucos 'escritórios' espalhados pelo Distrito que as raparigas usam quando querem apresentar queixas."

# game/data/world_romance/nijah/scr_future.rpy:64
translate ptPT rom_Nijah_stage1_future_lines_menu_59f434a3:

    # "Nijah had her own room, and it was known to all that she was a protected girl now."
    "Nijah tinha o seu próprio quarto, e era sabido por todos que ela era agora uma rapariga protegida."

# game/data/world_romance/nijah/scr_future.rpy:71
translate ptPT rom_Nijah_stage1_future_lines_menu_8f0508e3:

    # NIJAH "Zat was... very quick."
    NIJAH "Zat foi... muito rápido."

# game/data/world_romance/nijah/scr_future.rpy:72
translate ptPT rom_Nijah_stage1_future_lines_menu_a8cbf7ee:

    # NIJAH "It would take a Ramonian like me weeks to get anywhere with them."
    NIJAH "Levaria semanas para um Ramónico como eu chegar a algum lado com eles."

# game/data/world_romance/nijah/scr_future.rpy:73
translate ptPT rom_Nijah_stage1_future_lines_menu_5f7e87c5:

    # MC @ talk "Being a citizen has its benefits."
    MC @ talk "Ser cidadão tem os seus benefícios."

# game/data/world_romance/nijah/scr_future.rpy:74
translate ptPT rom_Nijah_stage1_future_lines_menu_7e9393ab:

    # NIJAH "I suppose I better get back to za work... Stop by to collect your money once a fortnight."
    NIJAH "Suponho que é melhor eu voltar ao trabalho... Passa por cá para recolheres o teu dinheiro uma vez a cada quinze dias."

# game/data/world_romance/nijah/scr_future.rpy:75
translate ptPT rom_Nijah_stage1_future_lines_menu_e35850f4:

    # MC @ talk "Let me know if there are any problems, remember, you are protected by me now."
    MC @ talk "Avisa-me se houver algum problema, lembra-te, agora estás sob a minha proteção."

# game/data/world_romance/nijah/scr_future.rpy:76
translate ptPT rom_Nijah_stage1_future_lines_menu_518f3315:

    # MC @ talk "I will see to it that no harm comes to you."
    MC @ talk "Tratarei para que nenhum mal te aconteça."

# game/data/world_romance/nijah/scr_future.rpy:77
translate ptPT rom_Nijah_stage1_future_lines_menu_4e16aac8:

    # "Nijah smiled unconvincingly, but nodded anyway."
    "Nijah sorriu de forma pouco convincente, mas assentiu mesmo assim."

# game/data/world_romance/nijah/scr_future.rpy:78
translate ptPT rom_Nijah_stage1_future_lines_menu_7b19a276:

    # NIJAH "T-Thank you... Now if you excuse me, I should get ready."
    NIJAH "O-Obrigada... Agora, se me dás licença, devo preparar-me."

# game/data/world_romance/nijah/scr_future.rpy:79
translate ptPT rom_Nijah_stage1_future_lines_menu_10f6a25a:

    # MC "I watched as Nijah headed off, no doubt to prepare for her {i}'clients'{/i}"
    MC "Observei Nijah enquanto ela se afastava, sem dúvida para se preparar para os seus {i}'clientes'{/i}"

# game/data/world_romance/nijah/scr_future.rpy:81
translate ptPT rom_Nijah_stage1_future_lines_menu_49528545:

    # "And just like that, Nijah returned to her old work... A part of me wondered if I’d made the right choice, if perhaps, Nijah wanted and deserved better than this life?"
    "E assim, Nijah voltou ao seu antigo trabalho... Uma parte de mim perguntava-se se eu tinha feito a escolha certa, se talvez, Nijah quisesse e merecesse melhor do que esta vida?"

# game/data/world_romance/nijah/scr_future.rpy:82
translate ptPT rom_Nijah_stage1_future_lines_menu_da7e2faa:

    # "But, as I reminded myself, she was now safer than before... And my pockets were going to get a lot heavier. Morality aside, maybe this was for the best."
    "Mas, como me lembrei a mim mesmo, ela agora estava mais segura do que antes... E os meus bolsos iam ficar muito mais pesados. Moralidade à parte, talvez isto fosse o melhor."

