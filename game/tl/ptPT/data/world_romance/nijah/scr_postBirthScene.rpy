    # MC @ surprised "Is that-"
    MC @ surprised "Isso é-"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:6
translate ptPT nijah_post_birth_scene_b6c5054e:

    # NIJAH "Look, our child..."
    NIJAH "Olha, o nosso filho..."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:7
translate ptPT nijah_post_birth_scene_fa57f756:

    # "Nijah held out and showed the small baby to me, whose eyes seemed identical to mine."
    "Nijah estendeu e mostrou-me o bebé pequeno, cujos olhos pareciam idênticos aos meus."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:8
translate ptPT nijah_post_birth_scene_4ef09e4c:

    # BLACK "{i}(The seed is strong... Ours shall be a strong warrior).{/i}"
    BLACK "{i}(A semente é forte... O nosso será um guerreiro forte).{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:11
translate ptPT nijah_post_birth_scene_84b2c1e6:

    # NIJAH "Hmm, [PregNijah().LastBornBabyName] iz a good name!"
    NIJAH "Hmm, [PregNijah().LastBornBabyName] é um bom nome!"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:12
translate ptPT nijah_post_birth_scene_f419fd3c:

    # MC @ talk "How are you feeling?"
    MC @ talk "Como te estás a sentir?"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:13
translate ptPT nijah_post_birth_scene_d6a41399:

    # NIJAH "Tired, but went well."
    NIJAH "Cansada, mas correu bem."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:14
translate ptPT nijah_post_birth_scene_ff1e5fa2:

    # NIJAH "Midwives were surprised, they said our child's birth was the easiest they had ever seen."
    NIJAH "As parteiras ficaram surpreendidas, disseram que o parto do nosso filho foi o mais fácil que já tinham visto."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:15
translate ptPT nijah_post_birth_scene_72e3a616:

    # NIJAH "...Zis because of your {i}gift?{/i}"
    NIJAH "...É por causa do teu {i}dom?{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:16
translate ptPT nijah_post_birth_scene_1a193db3:

    # BLACK "{i}(Yes, it is good to not allow hosts to die when they can sire many young for us).{/i}"
    BLACK "{i}(Sim, é bom não deixar os hospedeiros morrer quando podem gerar tantas crias para nós).{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:17
translate ptPT nijah_post_birth_scene_70eb3d22:

    # MC @ talk "Uhh, yes."
    MC @ talk "Uhh, sim."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:18
translate ptPT nijah_post_birth_scene_2baa7256:

    # NIJAH "Zis is good to know because..."
    NIJAH "É bom saber isto porque..."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:19
translate ptPT nijah_post_birth_scene_f1f3684e:

    # "Nijah alluringly stepped towards me, pressing her breasts against my chest as her hands run down my chest."
    "Nijah aproximou-se de mim de forma sedutora, pressionando os seios contra o meu peito enquanto as suas mãos desciam pelo meu peito."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:20
translate ptPT nijah_post_birth_scene_71299bb6:

    # NIJAH @ lewd "{i}We must have a very big family!{/i}"
    NIJAH @ lewd "{i}Temos de ter uma família muito grande!{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:21
translate ptPT nijah_post_birth_scene_a6155343:

    # MC @ surprised "{i}*Gulp!*{/i}"
    MC @ surprised "{i}*Gulp!*{/i}"

# game/data/world_romance/nijah/scr_postBirthScene.rpy:23
translate ptPT nijah_post_birth_scene_b55b6da8:

    # "For the next hour or so, I spent some time with Nijah and our new-born child, playing and watching them with a new-found pride."
    "Durante a hora seguinte, passei algum tempo com Nijah e o nosso filho recém-nascido, a brincar e a observá-los com um orgulho recém-descoberto."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:24
translate ptPT nijah_post_birth_scene_506f49d3:

    # "Whether it was by the {i}Dark passengers{/i} design within me, or my own natural paternal instincts stiring, I felt rejuvenated and stronger as I watched my child playfully reach out to grab my hand."
    "Quer fosse pelo desígnio dos {i}Passageiros Sombrios{/i} dentro de mim, ou pelos meus próprios instintos paternais naturais a despertar, senti-me rejuvenescido e mais forte enquanto via o meu filho a estender a mão de forma brincalhona para agarrar a minha."

# game/data/world_romance/nijah/scr_postBirthScene.rpy:25
translate ptPT nijah_post_birth_scene_e00fed67:

    # "A short while later, I left Nijah alone once again, onwards towards whatever was next."
    "Pouco tempo depois, deixei Nijah outra vez sozinha, seguindo em direção ao que viesse a seguir."

