    MC "(Hm... Se calhar ela não vem mesmo.)"

# game/data/world_romance/nyx/rom_nyx_love.rpy:84
translate ptPT rom_nyx_love_unicorn_date_4652382c:

    # "In that moment I felt someone nudge up against me, and as I turned, I looked to see a robbed figure stood before me."
    "Nesse momento, senti alguém encostar-se a mim e, quando me virei, vi uma figura encapuzada à minha frente."

# game/data/world_romance/nyx/rom_nyx_love.rpy:86
translate ptPT rom_nyx_love_unicorn_date_ecb0d696:

    # "As she tilted her head up, I could see clearly through the hood it was Captain Nyx."
    "Quando ela inclinou a cabeça para cima, consegui ver claramente através do capuz que era a Capitã Nyx."

# game/data/world_romance/nyx/rom_nyx_love.rpy:87
translate ptPT rom_nyx_love_unicorn_date_11b28b5c:

    # MC @ smile "Ah! Captain-"
    MC @ smile "Ah! Capitã-"

# game/data/world_romance/nyx/rom_nyx_love.rpy:88
translate ptPT rom_nyx_love_unicorn_date_ca71b39d:

    # NYX @ angry "Shh! Not so loud!"
    NYX @ angry "Shh! Não tão alto!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:89
translate ptPT rom_nyx_love_unicorn_date_304aa174:

    # MC @ smile "Ahh ... That explains the disguise then."
    MC @ smile "Ahh... Isso explica o disfarce então."

# game/data/world_romance/nyx/rom_nyx_love.rpy:90
translate ptPT rom_nyx_love_unicorn_date_ff069f4c:

    # "Nyx sighed uneasily, looking around the tavern for signs of anyone she recognized."
    "Nyx suspirou inquieta, olhando pela taberna à procura de sinais de alguém que reconhecesse."

# game/data/world_romance/nyx/rom_nyx_love.rpy:91
translate ptPT rom_nyx_love_unicorn_date_195c857b:

    # NYX @ think "Why did you choose to bring me here?"
    NYX @ think "Porque é que escolheste trazer-me aqui?"

