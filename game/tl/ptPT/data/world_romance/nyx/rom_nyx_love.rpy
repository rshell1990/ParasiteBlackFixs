translate ptPT rom_nyx_love_unicorn_date_627bcae2:

    # NYX @ talk "Right, yes ...'fun.'"
    NYX @ talk "Certo, sim... 'divertir.'"

# game/data/world_romance/nyx/rom_nyx_love.rpy:96
translate ptPT rom_nyx_love_unicorn_date_0bf6acba:

    # MC @ talk "What are you drinking?"
    MC @ talk "O que estás a beber?"

