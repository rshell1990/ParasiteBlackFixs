translate ptPT rom_nyx_love_unicorn_date_80b0281b:

    # NYX @ talk "Ale."
    NYX @ talk "Cerveja."

# game/data/world_romance/nyx/rom_nyx_love.rpy:98
translate ptPT rom_nyx_love_unicorn_date_9b9e3f77:

    # MC @ talk "Two ales, coming up..."
    MC @ talk "Duas cervejas, a caminho..."

