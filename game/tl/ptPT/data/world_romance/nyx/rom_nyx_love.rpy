    "Nyx pareceu surpreendida com o comentário, mas rapidamente voltou ao seu estado habitual."

# game/data/world_romance/nyx/rom_nyx_love.rpy:56
translate ptPT rom_nyx_love_1_60c586d4:

    # NYX @ think "Y-You agree?"
    NYX @ think "T-Tu aceitas?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:58
translate ptPT rom_nyx_love_1_0e455826:

    # NYX @ sad "Right, well, yes ... It's for the best."
    NYX @ sad "Certo, bem, sim... É o melhor."

# game/data/world_romance/nyx/rom_nyx_love.rpy:59
translate ptPT rom_nyx_love_1_c42c7fdf:

    # MC @ talk "Are you alright?"
    MC @ talk "Estás bem?"

