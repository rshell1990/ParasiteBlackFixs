translate ptPT rom_nyx_love_1_577a1c71:

    # NYX @ think "You know what? Forget it, I will see you at the {i}Iron Unicorn{/i} this Evening."
    NYX @ think "Sabes que mais? Esquece, vejo-te no {i}Unicórnio de Ferro{/i} esta noite."

# game/data/world_romance/nyx/rom_nyx_love.rpy:45
translate ptPT rom_nyx_love_1_5dfd0491:

    # MC @ smile "I shall see you then."
    MC @ smile "Vejo-te então."

# game/data/world_romance/nyx/rom_nyx_love.rpy:55
translate ptPT rom_nyx_love_1_1df973fb:

