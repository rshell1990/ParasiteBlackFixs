translate ptPT rom_nyx_love_1_540f65c6:

    # NYX @ sad "I'm fine, now, if that's all you came to say you can go."
    NYX @ sad "Estou bem, agora, se é só isso que vieste dizer podes ir."

# game/data/world_romance/nyx/rom_nyx_love.rpy:61
translate ptPT rom_nyx_love_1_23893bea:

    # NYX @ think "And the two of us can forget this little 'incident' ever happened..."
    NYX @ think "E nós os dois podemos esquecer que este pequeno 'incidente' alguma vez aconteceu..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:78
translate ptPT rom_nyx_love_unicorn_date_4423f9a9:

    # "I looked around for any sign of Captain Nyx, to no-avail."
    "Procurei qualquer sinal da Capitã Nyx, sem sucesso."

# game/data/world_romance/nyx/rom_nyx_love.rpy:79
translate ptPT rom_nyx_love_unicorn_date_7e2105d4:

