translate ptPT rom_nyx_love_unicorn_date_a37cf216:

    # NYX @ think "There are too many people."
    NYX @ think "Há demasiadas pessoas."

# game/data/world_romance/nyx/rom_nyx_love.rpy:93
translate ptPT rom_nyx_love_unicorn_date_5ef67c6d:

    # MC @ talk "Relax, Nyx."
    MC @ talk "Relaxa, Nyx."

