    "A Nyx bebeu um gole da cerveja no seu copo e sorriu."

# game/data/world_romance/nyx/rom_nyx_love.rpy:110
translate ptPT rom_nyx_love_unicorn_date_a5cc2a4c:

    # NYX @ laugh "Have to admit, I can't remember the last time I drank this much..."
    NYX @ laugh "Tenho de admitir, não me lembro da última vez que bebi tanto..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:111
translate ptPT rom_nyx_love_unicorn_date_6edc882f:

    # MC @ smile "Are you trying to tell me the great Captain Nyx can't handle her drink?"
    MC @ smile "Estás a tentar dizer-me que a grande Capitã Nyx não aguenta a bebida?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:113
translate ptPT rom_nyx_love_unicorn_date_d0135504:

    # "Nyx seemed flustered at my comment."
    "Nyx pareceu perturbada com o meu comentário."

# game/data/world_romance/nyx/rom_nyx_love.rpy:114
translate ptPT rom_nyx_love_unicorn_date_a44e6481:

    # NYX @ blush "I enjoy a glass of wine sometimes alone in my chambers..."
    NYX @ blush "Às vezes, desfruto de um copo de vinho sozinha nos meus aposentos..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:116
translate ptPT rom_nyx_love_unicorn_date_ef5d2b6b:

    # NYX @ talk "If any of the men actually saw me drunk and in disarray, they'd-"
    NYX @ talk "Se algum dos homens me visse bêbeda e desgrenhada, eles—"

# game/data/world_romance/nyx/rom_nyx_love.rpy:117
translate ptPT rom_nyx_love_unicorn_date_50f65b83:

    # MC @ talk "Nyx, don't you think that perhaps you're holding yourself to an unreasonable standard?"
    MC @ talk "Nyx, não achas que talvez estejas a impor-te um padrão irrazoável?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:118
translate ptPT rom_nyx_love_unicorn_date_1acdd7a2:

    # MC @ talk "The men would have seen their own commanders drunk at least a thousand times."
    MC @ talk "Os homens já teriam visto os seus próprios comandantes bêbedos pelo menos mil vezes."

# game/data/world_romance/nyx/rom_nyx_love.rpy:119
translate ptPT rom_nyx_love_unicorn_date_b586922b:

    # NYX @ angry "Their {i}male{/i} commanders."
    NYX @ angry "Os comandantes {i}homens{/i} delas."

# game/data/world_romance/nyx/rom_nyx_love.rpy:120
translate ptPT rom_nyx_love_unicorn_date_1203310c:

    # NYX @ angry "For them, such a thing is fine, but for me? One of the first female Captains? My enemies would just use it against me..."
    NYX @ angry "Para eles, tal coisa é normal, mas para mim? Uma das primeiras Capitãs? Os meus inimigos usariam isso contra mim..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:121
translate ptPT rom_nyx_love_unicorn_date_6cb749a7:

    # "Nyx paused for a moment, looking around uneasily for anyone she might recognise."
    "A Nyx fez uma pausa, olhando nervosamente à volta para alguém que pudesse reconhecer."

# game/data/world_romance/nyx/rom_nyx_love.rpy:122
translate ptPT rom_nyx_love_unicorn_date_a89586ab:

    # MC @ sad "...It must get tiresome, being paranoid all the time."
    MC @ sad "...Deve ser cansativo, estar sempre paranoica."

# game/data/world_romance/nyx/rom_nyx_love.rpy:123
translate ptPT rom_nyx_love_unicorn_date_1fefa8a1:

    # MC @ think "Always having to keep your guard up like that."
    MC @ think "Ter sempre de manter a guarda assim."

# game/data/world_romance/nyx/rom_nyx_love.rpy:124
translate ptPT rom_nyx_love_unicorn_date_295efc33:

    # NYX @ talk "Mmm, it's difficult."
    NYX @ talk "Mmm, é difícil."

# game/data/world_romance/nyx/rom_nyx_love.rpy:125
translate ptPT rom_nyx_love_unicorn_date_f819b706:

    # MC @ talk "...And lonely."
    MC @ talk "...E solitário."

# game/data/world_romance/nyx/rom_nyx_love.rpy:126
translate ptPT rom_nyx_love_unicorn_date_fbb838ed:

    # NYX @ sad "..."
    NYX @ sad "..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:127
translate ptPT rom_nyx_love_unicorn_date_a481c864:

    # NYX @ talk "Enough dwelling on me, tell me about you."
    NYX @ talk "Chega de falar de mim, conta-me sobre ti."

# game/data/world_romance/nyx/rom_nyx_love.rpy:128
translate ptPT rom_nyx_love_unicorn_date_80623b65:

    # MC @ talk "Me?"
    MC @ talk "Me?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:129
translate ptPT rom_nyx_love_unicorn_date_16fe6311:

    # NYX @ talk "Yes, {i}you.{/i}"
    NYX @ talk "Sim, {i}tu.{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:130
translate ptPT rom_nyx_love_unicorn_date_bef30c74:

    # NYX @ talk "Not only are you a curiosity given your 'gift,' you've successfully dragged me out here on a night out."
    NYX @ talk "Não só és uma curiosidade por causa do teu 'dom', como também conseguiste arrastar-me para aqui para uma saída à noite."

# game/data/world_romance/nyx/rom_nyx_love.rpy:131
translate ptPT rom_nyx_love_unicorn_date_7447bcbc:

    # NYX @ talk "Can't a girl at least be a little curious?"
    NYX @ talk "Uma rapariga não pode ser ao menos um bocadinho curiosa?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:132
translate ptPT rom_nyx_love_unicorn_date_dd6427db:

    # MC @ smile "You weren't curious before."
    MC @ smile "Não estavas curioso antes."

# game/data/world_romance/nyx/rom_nyx_love.rpy:133
translate ptPT rom_nyx_love_unicorn_date_d525b156:

    # NYX @ talk "That was business, this is supposed to be leisure ... Now, I'm curious."
    NYX @ talk "Aquilo eram negócios, isto é suposto ser lazer... Agora, estou curiosa."

# game/data/world_romance/nyx/rom_nyx_love.rpy:134
translate ptPT rom_nyx_love_unicorn_date_57bc53a9:

    # MC @ talk "What do you want to know?"
    MC @ talk "O que queres saber?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:135
translate ptPT rom_nyx_love_unicorn_date_0393ffd2:

    # NYX @ talk "First, tell me a little about yourself."
    NYX @ talk "Primeiro, conta-me um pouco sobre ti."

# game/data/world_romance/nyx/rom_nyx_love.rpy:136
translate ptPT rom_nyx_love_unicorn_date_62a82ca4:

    # NYX @ talk "I take it you didn't plan to go into the Scouts, hardly anyone ever does ... So, what did you want to be?"
    NYX @ talk "Presumo que não planeaste entrar nos Escuteiros, quase ninguém planeia... Então, o que querias ser?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:139
translate ptPT rom_nyx_love_unicorn_date_ed6973b7:

    # NYX @ shock "Really?"
    NYX @ shock "A sério?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:140
translate ptPT rom_nyx_love_unicorn_date_e58b3b37:

    # NYX @ talk "That's... surprising."
    NYX @ talk "Isso é... surpreendente."

# game/data/world_romance/nyx/rom_nyx_love.rpy:141
translate ptPT rom_nyx_love_unicorn_date_9abd2c86:

    # MC @ talk "How so?"
    MC @ talk "Como assim?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:142
translate ptPT rom_nyx_love_unicorn_date_61bfee97:

    # NYX @ talk "You carry yourself as an Adventurer so well, I just thought you'd have wanted a more ..."
    NYX @ talk "Portas-te tão bem como Aventureiro que pensei que quisesses algo mais..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:143
translate ptPT rom_nyx_love_unicorn_date_8e8a0efd:

    # NYX @ talk "Never mind, it's not like I can hardly blame you for wanting a job like that."
    NYX @ talk "Esquece, também não te posso censurar por quereres um trabalho desses."

# game/data/world_romance/nyx/rom_nyx_love.rpy:144
translate ptPT rom_nyx_love_unicorn_date_6da35f09:

    # MC @ talk "I figured you'd be disappointed by that answer."
    MC @ talk "Pensei que ficarias desapontado com essa resposta."

# game/data/world_romance/nyx/rom_nyx_love.rpy:145
translate ptPT rom_nyx_love_unicorn_date_51752f04:

    # NYX @ laugh "Not at all, if anything, we could do with more {i}effective{/i} people running administration."
    NYX @ laugh "De modo algum, se tanto, precisamos de mais pessoas {i}eficazes{/i} a gerir a administração."

# game/data/world_romance/nyx/rom_nyx_love.rpy:146
translate ptPT rom_nyx_love_unicorn_date_708d6718:

    # "Nyx's face became solemn."
    "O rosto de Nyx ficou solene."

# game/data/world_romance/nyx/rom_nyx_love.rpy:147
translate ptPT rom_nyx_love_unicorn_date_7b0f0bdd:

    # NYX @ talk "Besides ... You and I both know what it's really like out there."
    NYX @ talk "Além disso... Tu e eu sabemos como realmente é lá fora."

# game/data/world_romance/nyx/rom_nyx_love.rpy:148
translate ptPT rom_nyx_love_unicorn_date_0cca6b85:

    # NYX @ talk "I could hardly blame anyone for wanting to stay as far away as possible from that."
    NYX @ talk "Dificilmente poderia censurar alguém por querer manter-se o mais longe possível disso."

# game/data/world_romance/nyx/rom_nyx_love.rpy:149
translate ptPT rom_nyx_love_unicorn_date_85d819a4:

    # NYX @ talk "Well, onto my next question!"
    NYX @ talk "Bem, à próxima pergunta!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:152
translate ptPT rom_nyx_love_unicorn_date_29f5966b:

    # NYX @ talk "Ahhh ... That fits."
    NYX @ talk "Ahhh... Isso encaixa."

# game/data/world_romance/nyx/rom_nyx_love.rpy:153
translate ptPT rom_nyx_love_unicorn_date_8b78d05e:

    # NYX @ talk "Well, you've certainly taken well to the role it seems."
    NYX @ talk "Bem, certamente te adaptaste bem ao papel, ao que parece."

