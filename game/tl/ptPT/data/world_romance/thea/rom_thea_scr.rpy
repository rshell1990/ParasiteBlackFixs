# game/data/world_romance/thea/rom_thea_scr.rpy:3
translate ptPT rom_thea_invite_335cb5c3:

    # THEA @ smile "... Would you be interested perhaps in buying me a drink this evening?"
    THEA @ smile "... Estarias interessado talvez em comprar-me uma bebida esta noite?"

# game/data/world_romance/thea/rom_thea_scr.rpy:4
translate ptPT rom_thea_invite_0cfc087b:

    # MC @ smile "What's brought this on?"
    MC @ smile "O que motivou isto?"

# game/data/world_romance/thea/rom_thea_scr.rpy:5
translate ptPT rom_thea_invite_caddc8f2:

    # THEA @ blush "I've been watching you ... You're already C-tier so fast, normally, it would take adventurers weeks or even months to get where you are."
    THEA @ blush "Tenho andado a observar-te... Já estás no nível C tão depressa, normalmente os aventureiros levam semanas ou meses para chegar onde tu estás."

# game/data/world_romance/thea/rom_thea_scr.rpy:6
translate ptPT rom_thea_invite_5b9971e5:

    # THEA @ blush "I suppose I want to see what's so special."
    THEA @ blush "Acho que quero ver o que tens de tão especial."

# game/data/world_romance/thea/rom_thea_scr.rpy:9
translate ptPT rom_thea_invite_8737dc3f:

    # THEA @ blush "I would like that."
    THEA @ blush "Gostaria disso."

# game/data/world_romance/thea/rom_thea_scr.rpy:10
translate ptPT rom_thea_invite_488d699c:

    # THEA @ smile "I'll be waiting for you there ..."
    THEA @ smile "Estarei à tua espera lá..."

# game/data/world_romance/thea/rom_thea_scr.rpy:16
translate ptPT rom_thea_invite_aeabb3e0:

    # THEA @ talk "I-"
    THEA @ talk "E-"

# game/data/world_romance/thea/rom_thea_scr.rpy:17
translate ptPT rom_thea_invite_51503df8:

    # THEA @ talk "Very well, let me know when you're more free, perhaps."
    THEA @ talk "Muito bem, avisa-me quando estiveres mais livre, talvez."

# game/data/world_romance/thea/rom_thea_scr.rpy:23
translate ptPT rom_thea_unicorn_12d98976:

    # MC "(I shouldn't bother her anymore tonight.)"
    MC "(Não a devo incomodar mais esta noite.)"

# game/data/world_romance/thea/rom_thea_scr.rpy:30
translate ptPT rom_thea_unicorn_3345d6b7:

    # "When Thea saw me from across the room, she smiled and waved, coaxing me over."
    "Quando a Thea me viu do outro lado da sala, ela sorriu e acenou, incitando-me a ir ter com ela."

# game/data/world_romance/thea/rom_thea_scr.rpy:31
translate ptPT rom_thea_unicorn_8a756982:

    # THEA @ talk "So glad you could make it."
    THEA @ talk "Ainda bem que pudeste vir."

# game/data/world_romance/thea/rom_thea_scr.rpy:32
translate ptPT rom_thea_unicorn_fc4b9d6f:

    # THEA @ smile "Come, join me for a while ..."
    THEA @ smile "Vem, junta-te a mim um pouco..."

# game/data/world_romance/thea/rom_thea_scr.rpy:36
translate ptPT rom_thea_unicorn_menu1_7429efc5:

    # THEA @ smile2 "Mmm, eager to spend all that coin you've earned adventuring, are you?"
    THEA @ smile2 "Mmm, ansiosa para gastar todas as moedas que ganhaste nas aventuras, não é?"

# game/data/world_romance/thea/rom_thea_scr.rpy:37
translate ptPT rom_thea_unicorn_menu1_432f2bae:

    # THEA @ smile "There's a nice wine bottle I've been eyeing up, {i}'Huville Cépage'{/i}"
    THEA @ smile "Há uma bela garrafa de vinho que tenho estado a namorar, {i}'Huville Cépage'{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:38
translate ptPT rom_thea_unicorn_menu1_2eadc668:

    # THEA @ talk "What do you say we share it?"
    THEA @ talk "O que dizes de a partilharmos?"

# game/data/world_romance/thea/rom_thea_scr.rpy:45
translate ptPT rom_thea_unicorn_menu2_c07e4cd5:

    # THEA @ smile2 "Oooh!"
    THEA @ smile2 "Oooh!"

# game/data/world_romance/thea/rom_thea_scr.rpy:46
translate ptPT rom_thea_unicorn_menu2_c94f142b:

    # "I ordered for the bottle to be fetched, placing the small pouch of coins in Shay's hand as she grabbed it for us."
    "Pedi que a garrafa fosse buscada, colocando o pequeno saco de moedas na mão da Shay enquanto ela a ia buscar para nós."

# game/data/world_romance/thea/rom_thea_scr.rpy:47
translate ptPT rom_thea_unicorn_menu2_7eaabd57:

    # THEA @ smile "Cheers!"
    THEA @ smile "Saúde!"

# game/data/world_romance/thea/rom_thea_scr.rpy:48
translate ptPT rom_thea_unicorn_menu2_ce8ed3e8:

    # MC @ talk "So then, how does a girl like you end up running the Adventures Guild in Novaras?"
    MC @ talk "Então, como é que uma rapariga como tu acaba a gerir a Guilda de Aventureiros em Novaras?"

# game/data/world_romance/thea/rom_thea_scr.rpy:49
translate ptPT rom_thea_unicorn_menu2_8f95d09a:

    # THEA @ smile "Ahh ... good question!"
    THEA @ smile "Ahh... boa pergunta!"

# game/data/world_romance/thea/rom_thea_scr.rpy:50
translate ptPT rom_thea_unicorn_menu2_9f46be7b:

    # THEA @ talk "My parents travelled to Alderay to settle when I was very young."
    THEA @ talk "Os meus pais viajaram para Alderay para se estabelecerem quando eu era muito nova."

# game/data/world_romance/thea/rom_thea_scr.rpy:51
translate ptPT rom_thea_unicorn_menu2_e416d7df:

    # THEA @ talk "Back then, Alderay was welcoming skilled businesses and migrants, and the old owner of the guild house here was ready to retire."
    THEA @ talk "Nessa altura, Alderay acolhia negócios qualificados e migrantes, e o antigo dono da guilda aqui estava pronto para se reformar."

# game/data/world_romance/thea/rom_thea_scr.rpy:52
translate ptPT rom_thea_unicorn_menu2_b6c617a0:

    # THEA @ talk "So, we bought it off them, and the rest is history."
    THEA @ talk "Então, comprámos-lhes o negócio, e o resto é história."

# game/data/world_romance/thea/rom_thea_scr.rpy:53
translate ptPT rom_thea_unicorn_menu2_ac230468:

    # MC @ talk "Where did you come from originally?"
    MC @ talk "De onde eras originalmente?"

# game/data/world_romance/thea/rom_thea_scr.rpy:54
translate ptPT rom_thea_unicorn_menu2_eb131af5:

    # THEA @ talk "Ah, my family comes from Ramon."
    THEA @ talk "Ah, a minha família vem de Ramon."

# game/data/world_romance/thea/rom_thea_scr.rpy:55
translate ptPT rom_thea_unicorn_menu2_12edaa55:

    # MC @ surprised "Ramon? But, you're-"
    MC @ surprised "Ramon? Mas, tu és-"

# game/data/world_romance/thea/rom_thea_scr.rpy:56
translate ptPT rom_thea_unicorn_menu2_7b41d1ba:

    # "I stopped myself from prodding too deeply, but Thea just smiled."
    "Parei de investigar demasiado, mas a Thea apenas sorriu."

# game/data/world_romance/thea/rom_thea_scr.rpy:57
translate ptPT rom_thea_unicorn_menu2_44532423:

    # THEA @ smile "It's fine, people always ask about my complexion."
    THEA @ smile "Está tudo bem, as pessoas perguntam sempre sobre a minha tez."

# game/data/world_romance/thea/rom_thea_scr.rpy:58
translate ptPT rom_thea_unicorn_menu2_4808f1cb:

    # THEA @ talk "You see, we all come from Ramon, but my people, the Khashan, come from the eastern side of the Darjan desert."
    THEA @ talk "Vês, todos viemos de Ramon, mas o meu povo, os Khashan, vêm do lado oriental do deserto de Darjan."

# game/data/world_romance/thea/rom_thea_scr.rpy:59
translate ptPT rom_thea_unicorn_menu2_8cc07133:

    # THEA @ talk "The first of us travelled to Alderay to avoid the many hardships of the land."
    THEA @ talk "Os primeiros de nós viajaram para Alderay para evitar as muitas dificuldades da terra."

# game/data/world_romance/thea/rom_thea_scr.rpy:60
translate ptPT rom_thea_unicorn_menu2_f57c063a:

    # THEA @ talk "Unlike the West and South-Lands, the East of Ramon is a hard place to live ... Nothing truly grows beneath the scorched sun."
    THEA @ talk "Ao contrário das Terras do Oeste e do Sul, o Leste de Ramon é um lugar difícil de viver... Nada cresce verdadeiramente sob o sol escaldante."

# game/data/world_romance/thea/rom_thea_scr.rpy:65
translate ptPT rom_thea_unicorn_menu3_4b1f9620:

    # THEA @ talk "Hmm ... I miss the Darjan mountains, they stretched as far as the eye could see."
    THEA @ talk "Hmm... Tenho saudades das montanhas Darjan, estendiam-se até onde a vista alcançava."

# game/data/world_romance/thea/rom_thea_scr.rpy:66
translate ptPT rom_thea_unicorn_menu3_8fe065a0:

    # THEA @ talk "As barren and brutal a place as it was to live, it was quite beautiful."
    THEA @ talk "Por mais árido e brutal que fosse o lugar para viver, era bastante belo."

# game/data/world_romance/thea/rom_thea_scr.rpy:72
translate ptPT rom_thea_unicorn_menu3_3dfa0b6a:

    # THEA @ angry "What's there to say? They're a greedy, ungrateful bunch."
    THEA @ angry "O que há para dizer? São um bando ganancioso e ingrato."

# game/data/world_romance/thea/rom_thea_scr.rpy:73
translate ptPT rom_thea_unicorn_menu3_8742f5fd:

    # MC @ talk "That's ... surprising to hear."
    MC @ talk "Isso é... surpreendente de ouvir."

# game/data/world_romance/thea/rom_thea_scr.rpy:74
translate ptPT rom_thea_unicorn_menu3_93fcdb03:

    # THEA @ sad "Sorry, Ramonian politics is a difficult thing."
    THEA @ sad "Desculpa, a política Ramónia é uma coisa difícil."

# game/data/world_romance/thea/rom_thea_scr.rpy:75
translate ptPT rom_thea_unicorn_menu3_06c01088:

    # THEA @ angry "Let's just say there are reasons we headed to Alderay and didn't just join our cousins in the West."
    THEA @ angry "Digamos que há razões para termos vindo para Alderay e não nos termos juntado aos nossos primos no Oeste."

# game/data/world_romance/thea/rom_thea_scr.rpy:76
translate ptPT rom_thea_unicorn_menu3_b488a395:

    # THEA @ angry "They spent years being the oppressors, and now expect sympathy when they wouldn't shed a tear for the rest of us."
    THEA @ angry "Eles passaram anos a ser os opressores, e agora esperam simpatia quando não derramariam uma lágrima pelo resto de nós."

# game/data/world_romance/thea/rom_thea_scr.rpy:82
translate ptPT rom_thea_unicorn_menu3_dc53db05:

    # THEA @ smile "Ahh, it was ... different!"
    THEA @ smile "Ahh, foi... diferente!"

# game/data/world_romance/thea/rom_thea_scr.rpy:83
translate ptPT rom_thea_unicorn_menu3_ce050630:

    # THEA @ talk "I grew up watching adventurers come and go."
    THEA @ talk "Cresci a ver aventureiros irem e virem."

# game/data/world_romance/thea/rom_thea_scr.rpy:84
translate ptPT rom_thea_unicorn_menu3_c48d55de:

    # THEA @ smile "I quickly learned to pick up which ones I thought had a chance of climbing the ranks, and I usually got pretty good predicting where their limit would be."
    THEA @ smile "Aprendi rapidamente a escolher quais eu achava que tinham hipóteses de subir nas classificações, e geralmente tornei-me bastante boa a prever onde estaria o limite deles."

# game/data/world_romance/thea/rom_thea_scr.rpy:91
translate ptPT rom_thea_unicorn_menu3_3328c8e0:

    # THEA @ smile "Where's the fun in telling you that?"
    THEA @ smile "Onde está a piada de te contar isso?"

# game/data/world_romance/thea/rom_thea_scr.rpy:92
translate ptPT rom_thea_unicorn_menu3_d535c815:

    # THEA @ smile2 "{i}... Surprise me.{/i}"
    THEA @ smile2 "{i}... Surpreende-me.{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:95
translate ptPT rom_thea_unicorn_menu3_14af6c46:

    # THEA @ talk "Quite a few."
    THEA @ talk "Alguns."

# game/data/world_romance/thea/rom_thea_scr.rpy:96
translate ptPT rom_thea_unicorn_menu3_96fa62ee:

    # THEA @ talk "Lohan the Great, Marhaka {i}'the silver arrow.'{/i}"
    THEA @ talk "Lohan, o Grande, Marhaka {i}'a flecha prateada.'{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:97
translate ptPT rom_thea_unicorn_menu3_9561e086:

    # THEA @ sad "But that was all when I was still little."
    THEA @ sad "Mas isso foi tudo quando eu ainda era pequena."

# game/data/world_romance/thea/rom_thea_scr.rpy:98
translate ptPT rom_thea_unicorn_menu3_0679a78b:

    # THEA @ talk "There aren't really many names left who'd I'd think qualify as legendary these days."
    THEA @ talk "Já não há muitos nomes que eu considerasse que se qualificam como lendários hoje em dia."

# game/data/world_romance/thea/rom_thea_scr.rpy:99
translate ptPT rom_thea_unicorn_menu3_13f5176a:

    # MC @ talk "What about Celeste?"
    MC @ talk "E a Celeste?"

# game/data/world_romance/thea/rom_thea_scr.rpy:100
translate ptPT rom_thea_unicorn_menu3_82af972f:

    # THEA @ sad "I-"
    THEA @ sad "E-"

# game/data/world_romance/thea/rom_thea_scr.rpy:101
translate ptPT rom_thea_unicorn_menu3_f59122f5:

    # THEA @ sad "There's something about her I don't like ... But I can't put my finger on why."
    THEA @ sad "Há algo nela que não me agrada... Mas não consigo perceber porquê."

# game/data/world_romance/thea/rom_thea_scr.rpy:104
translate ptPT rom_thea_unicorn_menu3_bccad9a6:

    # MC @ smile "So, why did you only agree to meet with me now?"
    MC @ smile "Então, porque é que só concordaste em encontrar-te comigo agora?"

# game/data/world_romance/thea/rom_thea_scr.rpy:105
translate ptPT rom_thea_unicorn_menu3_612151ad:

    # "Thea smiled, twirling her hair."
    "Thea sorriu, enrolando o cabelo."

# game/data/world_romance/thea/rom_thea_scr.rpy:106
translate ptPT rom_thea_unicorn_menu3_cef13fe0:

    # THEA @ smile "Well ... You see, the thing is."
    THEA @ smile "Bem... A coisa é assim."

# game/data/world_romance/thea/rom_thea_scr.rpy:107
translate ptPT rom_thea_unicorn_menu3_fcd2fdda:

    # THEA @ smile "I usually spent my time growing up watching adventurers flirt with my mother, and I guess it kinda rubbed off on me."
    THEA @ smile "Eu normalmente passava o meu tempo a crescer a ver aventureiros a flertar com a minha mãe, e acho que de certa forma isso colou-se a mim."

# game/data/world_romance/thea/rom_thea_scr.rpy:108
translate ptPT rom_thea_unicorn_menu3_40e310f1:

    # MC @ talk "What about your father, though? He couldn't have liked that."
    MC @ talk "E o teu pai? Ele não podia ter gostado disso."

# game/data/world_romance/thea/rom_thea_scr.rpy:109
translate ptPT rom_thea_unicorn_menu3_8ff3ce86:

    # THEA @ talk "There wasn't a lot he could do, besides, Mother was just flirting to buy a few more rounds between quests."
    THEA @ talk "Não havia muito que ele pudesse fazer, além disso, a Mãe só estava a flertar para comprar mais umas rondas entre missões."

# game/data/world_romance/thea/rom_thea_scr.rpy:110
translate ptPT rom_thea_unicorn_menu3_d0c386b6:

    # THEA @ blush "T-Though sometimes the adventurers did get a little 'handsy' with her, I suppose."
    THEA @ blush "E-Embora às vezes os aventureiros ficassem um bocado «atrevidos» com ela, suponho."

# game/data/world_romance/thea/rom_thea_scr.rpy:111
translate ptPT rom_thea_unicorn_menu3_40b97817:

    # THEA @ smile "But I'm sure she never let it go too far!"
    THEA @ smile "Mas tenho a certeza que ela nunca deixou ir longe demais!"

# game/data/world_romance/thea/rom_thea_scr.rpy:112
translate ptPT rom_thea_unicorn_menu3_55848778:

    # MC "(I think I'm beginning to see where this fetish of hers has come from)."
    MC "(Acho que estou a começar a ver de onde veio este fetiche dela.)"

# game/data/world_romance/thea/rom_thea_scr.rpy:113
translate ptPT rom_thea_unicorn_menu3_79def2ed:

    # THEA @ smile2 "So, how would you like to come back to mine this evening?"
    THEA @ smile2 "Então, que tal vires à minha casa esta noite?"

# game/data/world_romance/thea/rom_thea_scr.rpy:114
translate ptPT rom_thea_unicorn_menu3_78109663:

    # THEA @ blush "I think I might have something to help {i}'motivate'{/i} you on your quests."
    THEA @ blush "Acho que posso ter algo para ajudar a {i}'motivar'{/i}-te nas tuas missões."

# game/data/world_romance/thea/rom_thea_scr.rpy:117
translate ptPT rom_thea_unicorn_menu3_7e4761fb:

    # THEA @ smile2 "Follow me."
    THEA @ smile2 "Segue-me."

# game/data/world_romance/thea/rom_thea_scr.rpy:120
translate ptPT rom_thea_unicorn_menu3_ffc63a93:

    # THEA @ sad "Oh? Well ... Alright then."
    THEA @ sad "Oh? Bem... Está bem então."

# game/data/world_romance/thea/rom_thea_scr.rpy:125
translate ptPT rom_thea_unicorn_menu3_3b8245a4:

    # THEA @ smile "It is."
    THEA @ smile "É."

# game/data/world_romance/thea/rom_thea_scr.rpy:126
translate ptPT rom_thea_unicorn_menu3_31d970ec:

    # THEA @ smile2 "But do you think I'm worth it?"
    THEA @ smile2 "Mas achas que eu valho a pena?"

# game/data/world_romance/thea/rom_thea_scr.rpy:132
translate ptPT rom_thea_unicorn_menu3_10603dd0:

    # THEA @ sad "{i}*Sigh*{/i}... Never mind then."
    THEA @ sad "{i}*Suspiro*{/i}... Esquece então."

# game/data/world_romance/thea/rom_thea_scr.rpy:133
translate ptPT rom_thea_unicorn_menu3_cc5378c3:

    # THEA @ talk "Mmm, don't you think you should at least buy a girl a drink first?"
    THEA @ talk "Mmm, não achas que devias pelo menos comprar uma bebida a uma rapariga primeiro?"

# game/data/world_romance/thea/rom_thea_scr.rpy:134
translate ptPT rom_thea_unicorn_menu3_db87ce59:

    # THEA @ talk "You should definitely buy me one when you have some more coin... I'd love to hear more of your adventuring tales."
    THEA @ talk "Devias definitivamente comprar-me uma quando tiveres mais dinheiro... Adorava ouvir mais das tuas histórias de aventura."

# game/data/world_romance/thea/rom_thea_scr.rpy:139
translate ptPT rom_thea_unicorn_menu3_9a148b52:

    # THEA @ talk "Booo ..."
    THEA @ talk "Buuu..."

# game/data/world_romance/thea/rom_thea_scr.rpy:140
translate ptPT rom_thea_unicorn_menu3_06d4a6e1:

    # THEA @ smile "Well maybe next time then."
    THEA @ smile "Bem, talvez para a próxima então."

# game/data/world_romance/thea/rom_thea_scr.rpy:153
translate ptPT rom_thea_after_date_e86c7592:

    # "Thea led me back towards the Adventurers Guild, but this time, she led me behind the counter up the stairs towards her bedroom."
    "A Thea guiou-me de volta para a Guilda de Aventureiros, mas desta vez, ela guiou-me por trás do balcão pelas escadas acima em direção ao seu quarto."

# game/data/world_romance/thea/rom_thea_scr.rpy:159
translate ptPT rom_thea_after_date_6b744a36:

    # "Into her bedroom, Thea led me, quickly getting the fire going before she twirled around and smiled alluringly."
    "Para o seu quarto, a Thea guiou-me, acendendo rapidamente o fogo antes de girar e sorrir sedutoramente."

# game/data/world_romance/thea/rom_thea_scr.rpy:160
translate ptPT rom_thea_after_date_cd42ee40:

    # MC @ smile "So then, what was it you wanted to give me?"
    MC @ smile "Então, o que era que me querias dar?"

# game/data/world_romance/thea/rom_thea_scr.rpy:165
translate ptPT rom_thea_after_date_e56d5240:

    # THEA @ smile "Ah, hello again... I trust you've been busy with all your adventures?"
    THEA @ smile "Ah, olá outra vez... Confio que tens andado ocupado com as tuas aventuras?"

# game/data/world_romance/thea/rom_thea_scr.rpy:167
translate ptPT rom_thea_after_date_6917aa30:

    # THEA @ talk "Do you mind waiting here for a moment, this will only take a few minutes."
    THEA @ talk "Importas-te de esperar aqui por um momento, isto só vai demorar uns minutos."

# game/data/world_romance/thea/rom_thea_scr.rpy:168
translate ptPT rom_thea_after_date_a3b52944:

    # MC @ smile "Of course."
    MC @ smile "Claro."

# game/data/world_romance/thea/rom_thea_scr.rpy:170
translate ptPT rom_thea_after_date_2ecf6da7:

    # "Thea hurried off for a few moments, and after briefly looking around her room, the door swung open, and Thea re-emerged."
    "A Thea apressou-se por uns momentos, e após olhar brevemente à volta do seu quarto, a porta abriu-se, e a Thea ressurgiu."

# game/data/world_romance/thea/rom_thea_scr.rpy:174
translate ptPT rom_thea_after_date_42fc426f:

    # THEA @ blush "{i}... Do you think 'this' will help motivate you?{/i}"
    THEA @ blush "{i}... Achas que «isto» te vai ajudar a motivar?{/i}"

# game/data/world_romance/thea/rom_thea_scr.rpy:175
translate ptPT rom_thea_after_date_4c4699f9:

    # MC @ lewd "I'm feeling motivated already."
    MC @ lewd "Já me sinto motivado."

# game/data/world_romance/thea/rom_thea_scr.rpy:178
translate ptPT rom_thea_after_date_9c1a9a0d:

    # "Giggling to herself, Thea stepped forward and pushed me down onto her bed, moving swiftly to strip the clothes off of me."
    "Rindo para si mesma, a Thea avançou e empurrou-me para a sua cama, movendo-se rapidamente para me despir as roupas."

# game/data/world_romance/thea/rom_thea_scr.rpy:179
translate ptPT rom_thea_after_date_9fc4282e:

    # THEA "I've been working on a little ... {i}dance{/i} that I want to show you."
    THEA "Tenho andado a trabalhar numa pequena... {i}dança{/i} que te quero mostrar."

# game/data/world_romance/thea/rom_thea_scr.rpy:180
translate ptPT rom_thea_after_date_a092ffec:

    # THEA "Tell me ... What do you think of what I'm wearing?"
    THEA "Diz-me... O que achas do que estou a vestir?"

# game/data/world_romance/thea/rom_thea_scr.rpy:190
