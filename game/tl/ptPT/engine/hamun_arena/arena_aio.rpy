# game/engine/hamun_arena/arena_aio.rpy:161
translate ptPT hamun_arena_master_questions_menu_first_time_94a74e82:

    # HAMUN_ARENA_MASTER "You pay in blood here."
    HAMUN_ARENA_MASTER "Aqui paga-se em sangue."

# game/engine/hamun_arena/arena_aio.rpy:164
translate ptPT hamun_arena_master_questions_menu_first_time_beb6daa1:

    # HAMUN_ARENA_MASTER "There are five ranks within the arena."
    HAMUN_ARENA_MASTER "Há cinco ranks na arena."

# game/engine/hamun_arena/arena_aio.rpy:165
translate ptPT hamun_arena_master_questions_menu_first_time_5d206716:

    # HAMUN_ARENA_MASTER "To move between ranks, you must defeat ten opponents in each rank."
    HAMUN_ARENA_MASTER "Para subir de rank, tens de derrotar dez oponentes em cada rank."

# game/engine/hamun_arena/arena_aio.rpy:166
translate ptPT hamun_arena_master_questions_menu_first_time_f1d4b60a:

    # HAMUN_ARENA_MASTER "Followed by a special match of our choosing."
    HAMUN_ARENA_MASTER "Seguido de um combate especial à nossa escolha."

# game/engine/hamun_arena/arena_aio.rpy:167
translate ptPT hamun_arena_master_questions_menu_first_time_1b9223ca:

    # HAMUN_ARENA_MASTER "...As a word of warning, we may restrict your access to some of the higher ranks if we don't feel you're ready."
    HAMUN_ARENA_MASTER "...Como palavra de aviso, podemos restringir o teu acesso a alguns dos ranks mais altos se não sentirmos que estás pronto."

# game/engine/hamun_arena/arena_aio.rpy:168
translate ptPT hamun_arena_master_questions_menu_first_time_5b2e12c5:

    # HAMUN_ARENA_MASTER "We want a glorious battle on the sand... not a bloody massacre before the audience even sits down."
    HAMUN_ARENA_MASTER "Queremos uma batalha gloriosa na areia... não um massacre sangrento antes de a audiência sequer se sentar."

# game/engine/hamun_arena/arena_aio.rpy:171
translate ptPT hamun_arena_master_questions_menu_first_time_ab7228a3:

    # HAMUN_ARENA_MASTER "Monsters, warriors... strange creatures from faraway lands."
