    # ADARA @ smile "I am well, [player_name!t], thank you for asking."
    ADARA @ smile "Я в порядке, [player_name!t], спасибо, что спросил."

# game/data/characters/adara/dialogue.rpy:48
translate ru adara_talk_howareyou_7fe3643a:

    # ADARA @ talk "Did you hear about the commotion in the pleasure district? Some kind of ... {i}monster{/i} attacked one of the gangs, at least, that's the rumour."
    ADARA @ talk "Ты слышал о шуме в районе удовольствий? Какое-то... {i}чудовище{/i} напало на одну из банд, по крайней мере, так говорят слухи."

# game/data/characters/adara/dialogue.rpy:50
translate ru adara_talk_howareyou_0c7cccc7:

    # ADARA @ smile "I am well thank you! Have you seen that new market stall selling Ramonian food? It's very popular!"
    ADARA @ smile "Я в порядке, спасибо! Ты видел тот новый рыночный прилавок с Рамонской едой? Он очень популярен!"

# game/data/characters/adara/dialogue.rpy:52
