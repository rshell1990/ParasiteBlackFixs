
# game/data/characters/arlena/dialogue.rpy:33
translate ru arlena_room_first_entry_341a0073:

    # "Arlena's boxed room was compact but filled with drawings of schematics littered all about the place."
    "Комната Арлены была компактной, но наполненой валяющимся чертежами и схемами заполняя место повсюду."

# game/data/characters/arlena/dialogue.rpy:34
translate ru arlena_room_first_entry_9caafbc0:

    # "Here and there were the essentials, a single soft straw bed, a draw for some clothes and a workbench for her to sit at."
    "Здесь и там стояли необходимые вещи: одна мягкая соломенная кровать, ящик для одежды и верстак, за которым она сидела."

# game/data/characters/arlena/dialogue.rpy:38
translate ru arlena_room_first_entry_07a0d7a5:

    # MC "{b}OUCH!{/b}"
    MC "{b}АЙ!{/b}"

# game/data/characters/arlena/dialogue.rpy:38
translate ru arlena_room_first_entry_3d8c7c56:

    # ARLENA @ angry "[player_name!t]?! Fucking idiot, what's wrong with you sneaking around like that?!"
    ARLENA @ angry "[player_name!t]?! Грёбаный идиот, что ты себе позволяешь подкрадываясь вот так?!"

# game/data/characters/arlena/dialogue.rpy:40
translate ru arlena_room_first_entry_d49d44c5:

    # MC "Sorry! The door was unlocked..."
    MC "Извини! Дверь была не заперта..."

# game/data/characters/arlena/dialogue.rpy:41
translate ru arlena_room_first_entry_e4a3cc26:

    # MC "Did you just hit me with a-"
    MC "Ты что, ударила меня та-"

# game/data/characters/arlena/dialogue.rpy:42
translate ru arlena_room_first_entry_2e815ce5:

    # ARLENA @ angry "YES! A stool!"
    ARLENA @ angry "ДА! Табуреткой!"

# game/data/characters/arlena/dialogue.rpy:43
translate ru arlena_room_first_entry_eaf74097:

    # "Surprisingly, Arlena seemed to cool down right before my eyes."
    "К удивлению, Арлена быстро остыла прямо на моих глазах."

# game/data/characters/arlena/dialogue.rpy:44
translate ru arlena_room_first_entry_1d9cbd20:

    # "Perhaps I really {i}did{/i} sneak up on her."
    "Возможно, я действительно {i}подкрался{/i} к ней."

# game/data/characters/arlena/dialogue.rpy:45
translate ru arlena_room_first_entry_c8d99ccc:

    # ARLENA "Anyway, welcome to my High Castle."
    ARLENA "В любом случае, добро пожаловать в мой Высокий Замок."

# game/data/characters/arlena/dialogue.rpy:46
translate ru arlena_room_first_entry_bf198958:

    # ARLENA "I sketch out some of the more unique designs for armour and weapons here."
    ARLENA "Я набрасываю здесь некоторые из наиболее уникальных дизайнов доспехов и оружия."

# game/data/characters/arlena/dialogue.rpy:47
translate ru arlena_room_first_entry_648653a1:

    # ARLENA "There is something else I’ve been working on too..."
    ARLENA "Есть ещё кое-что, над чем я работала..."

# game/data/characters/arlena/dialogue.rpy:48
translate ru arlena_room_first_entry_49a216f8:

    # ARLENA "Now if you don't mind, I'd rather get back to work."
    ARLENA "А теперь, если ты не против, я бы предпочла вернуться к работе."

# game/data/characters/arlena/dialogue.rpy:50
translate ru arlena_room_first_entry_1eed06d6:

    # ARLENA "...idiot."
    ARLENA "...идиот."

# game/data/characters/arlena/dialogue.rpy:58
translate ru arlena_talk_465a4cbc:

    # ARLENA "Yes? What is it?"
    ARLENA "Да? Что такое?"

# game/data/characters/arlena/dialogue.rpy:63
translate ru arlena_bye_8b373c54:

    # ARLENA "Alright, see ya 'round."
    ARLENA "Ладно, увидимся."

# game/data/characters/arlena/dialogue.rpy:68
translate ru arlena_gems_for_gold_a149c7a4:

    # ARLENA @ smile "Oh did you now?"
    ARLENA @ smile "Оу, неужели?"

# game/data/characters/arlena/dialogue.rpy:69
translate ru arlena_gems_for_gold_5da849b6:

    # MC "Yeah!"
    MC "Ага!"

# game/data/characters/arlena/dialogue.rpy:70
translate ru arlena_gems_for_gold_a2a3f60a:

    # MC "Here you go..."
    MC "Держи..."

# game/data/characters/arlena/dialogue.rpy:74
translate ru arlena_gems_for_gold_98536a5d:

    # "I handed over a hefty pouch of gems, as Arlena's eyes began to glow with passion."
    "Я протянул увесистый мешочек с самоцветами, и глаза Арлены загорелись страстью."

# game/data/characters/arlena/dialogue.rpy:75
translate ru arlena_gems_for_gold_5157952d:

    # ARLENA "This is... Great!"
    ARLENA "Это... Отлично!"

# game/data/characters/arlena/dialogue.rpy:76
translate ru arlena_gems_for_gold_deb47eb2:

    # ARLENA "Here's your cut."
    ARLENA "Вот твоя доля."

# game/data/characters/arlena/dialogue.rpy:78
translate ru arlena_gems_for_gold_87779370:

    # ARLENA "Pleasure doing business with ya!"
    ARLENA "Приятно иметь с тобой дело!"

# game/data/characters/arlena/dialogue.rpy:81
translate ru arlena_gems_for_gold_not_enough_a26f4c82:

