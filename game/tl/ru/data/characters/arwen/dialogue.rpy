# game/data/characters/arwen/dialogue.rpy:100
translate ru dialogue_arwen_services_cel_779f3c4e:

    # ARWEN @ angry "Do you know how much this outfit cost to make?"
    ARWEN @ angry "Ты знаешь, сколько стоило сделать этот наряд?"

# game/data/characters/arwen/dialogue.rpy:101
translate ru dialogue_arwen_services_cel_0f93cc2b:

    # ARWEN @ talk "Plus all the rallies and things I had to attend to learn to act like her a bit."
    ARWEN @ talk "Плюс все митинги и мероприятия, которые мне пришлось посетить, чтобы научиться вести себя немного как она."

# game/data/characters/arwen/dialogue.rpy:102
translate ru dialogue_arwen_services_cel_84c11618:

    # ARWEN @ laugh "Besides... I offer a {i}unique{/i} experience unlike what my clients normally get."
    ARWEN @ laugh "Кроме того... Я предлагаю {i}уникальный{/i} опыт, в отличие от того, что обычно получают мои клиенты."

# game/data/characters/arwen/dialogue.rpy:103
translate ru dialogue_arwen_services_cel_c7c5bcc5:

    # ARWEN @ talk "So, fifteen hundred. Interested?"
    ARWEN @ talk "Итак, полторы тысячи. Заинтересован?"

# game/data/characters/arwen/dialogue.rpy:106
translate ru dialogue_arwen_services_cel_67a3c006:

    # ARWEN @ talk "Then if you don't mind, other customers are waiting."
    ARWEN @ talk "Тогда, если не возражаешь, меня ждут другие клиенты."

