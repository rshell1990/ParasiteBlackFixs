# game/data/characters/arwen/dialogue.rpy:79
translate ru arwen_talk_celeste_30f5cc47:

    # ARWEN @ talk "Tell me, {i}how much coin would you pay to spend a night with the beautiful Celeste?{/i}"
    ARWEN @ talk "Скажи, {i}сколько монет ты заплатил бы, чтобы провести ночь с прекрасной Селестой?{/i}"

# game/data/characters/arwen/dialogue.rpy:80
translate ru arwen_talk_celeste_4f6d740f:

    # ARWEN @ talk "Actually, don't even answer that!"
    ARWEN @ talk "Вообще-то, даже не отвечай!"

# game/data/characters/arwen/dialogue.rpy:81
translate ru arwen_talk_celeste_da29d70f:

    # ARWEN @ talk "We both know that such priceless things would be worth their weight in gold... {i}till now.{/i}"
    ARWEN @ talk "Мы оба знаем, что такие бесценные вещи стоили бы своего веса в золоте... {i}до сих пор.{/i}"

# game/data/characters/arwen/dialogue.rpy:86
translate ru arwen_bye_cel_84e04ea5:

    # ARWEN @ talk "Very well."
    ARWEN @ talk "Очень хорошо."

# game/data/characters/arwen/dialogue.rpy:90
translate ru arwen_whyCeleste_259711d9:

    # ARWEN @ laugh "Because... {i}Who doesn't want to fuck the most beautiful, famous heroine around?{/i}"
    ARWEN @ laugh "Потому что... {i}Кто не хочет трахнуть самую красивую, знаменитую героиню в округе?{/i}"

# game/data/characters/arwen/dialogue.rpy:91
translate ru arwen_whyCeleste_9530a2ec:

    # ARWEN @ talk "People will pay whatever I ask if they think they'll get at least a taste of what it might be like to have her."
    ARWEN @ talk "Люди готовы заплатить всё, что я попрошу, если будут думать что получают хотя бы вкус того, каково это — обладать ею."

# game/data/characters/arwen/dialogue.rpy:92
translate ru arwen_whyCeleste_e7a80d41:

    # ARWEN @ talk "Fantasy is a powerful thing... The reality of something rarely meets the expectation."
    ARWEN @ talk "Фантазия — мощная штука... Реальность редко соответствует ожиданиям."

# game/data/characters/arwen/dialogue.rpy:93
