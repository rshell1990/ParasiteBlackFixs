translate ru arwen_whyCeleste_aa10a873:

    # ARWEN @ laugh "I try."
    ARWEN @ laugh "Стараюсь."

# game/data/characters/arwen/dialogue.rpy:98
translate ru dialogue_arwen_services_cel_ec508417:

    # ARWEN @ talk "Fifteen hundred coins and {i}Celeste{/i} is all yours."
    ARWEN @ talk "Полторы тысячи монет, и {i}Селеста{/i} твоя."

# game/data/characters/arwen/dialogue.rpy:99
translate ru dialogue_arwen_services_cel_8b30ba46:

    # MC @ talk "That's more than your normal rates..."
