
# game/data/characters/arwen/scr_dialogue.rpy:2
translate ru dialogue_arwen_othergirls_d6300ee5:

    # ARWEN @ talk "Tell me darling, who in all of Mirnos would you want to talk about them... when {i}I'm{/i} by your side?"
    ARWEN @ talk "Скажи мне, дорогой, о ком во всём Мирносе ты хотел бы поговорить... когда {i}я{/i} рядом с тобой?"

# game/data/characters/arwen/scr_dialogue.rpy:5
translate ru dialogue_arwen_othergirls_menu_bbb61fd6:

    # ARWEN @ blush "Gods... I bet you have half the women in this city wrapped around your finger, don't you handsome?"
    ARWEN @ blush "Боги... Спорю, у тебя половина женщин в этом городе на крючке, не так ли, красавчик?"

# game/data/characters/arwen/scr_dialogue.rpy:6
translate ru dialogue_arwen_othergirls_menu_e8995dc3:

    # MC @ smile "{i}Would you like to be wrapped around my finger, Arwen?{/i}"
    MC @ smile "{i}Хотела ли бы ты, оказаться на моём крючке, Арвен?{/i}"

# game/data/characters/arwen/scr_dialogue.rpy:7
translate ru dialogue_arwen_othergirls_menu_7bca3054:

    # ARWEN @ laugh "Haha! Alright..."
    ARWEN @ laugh "Ха-ха! Ладно..."

# game/data/characters/arwen/scr_dialogue.rpy:8
translate ru dialogue_arwen_othergirls_menu_bcc3804b:

    # ARWEN @ talk "What do you want to know?"
    ARWEN @ talk "Что ты хочешь узнать?"

# game/data/characters/arwen/scr_dialogue.rpy:11
translate ru dialogue_arwen_othergirls_menu_f72c231a:

    # ARWEN @ talk "Well... Now you're speaking a girls favourite language!"
    ARWEN @ talk "Ну... Вот теперь ты говоришь на любимом языке девушек!"

# game/data/characters/arwen/scr_dialogue.rpy:13
translate ru dialogue_arwen_othergirls_menu_ab602309:

    # ARWEN @ talk "Was there someone specific you wanted to ask about?"
    ARWEN @ talk "Была ли у тебя на примете конкретная личность?"

# game/data/characters/arwen/scr_dialogue.rpy:16
translate ru dialogue_arwen_othergirls_menu_paid_5c4b33c4:

    # ARWEN @ angry "Hm? Oh, {i}her{/i} I'd avoid her if I was you."
    ARWEN @ angry "Хм? Ох, {i}она{/i}... Я бы избегала её на твоём месте."

# game/data/characters/arwen/scr_dialogue.rpy:17
translate ru dialogue_arwen_othergirls_menu_paid_d42b7565:

    # ARWEN @ angry "Overpriced to put it mildly, you'd think she was a virgin princess with how highly she views herself."
    ARWEN @ angry "Сказать, что она завышает цены — ничего не сказать. Можно подумать, она девственная принцесса, судя по тому как высоко себя ценит."

# game/data/characters/arwen/scr_dialogue.rpy:18
translate ru dialogue_arwen_othergirls_menu_paid_1950d15a:

    # ARWEN @ blush "Don't worry though, I'll show you what a {i}real{/i} woman can do."
    ARWEN @ blush "Не волнуйся, я покажу тебе, на что способна {i}настоящая{/i} женщина."

# game/data/characters/arwen/scr_dialogue.rpy:21
translate ru dialogue_arwen_othergirls_menu_paid_77c1d01c:

    # ARWEN @ think "Hmm, nice enough girl."
    ARWEN @ think "Хм, достаточно милая девушка."

# game/data/characters/arwen/scr_dialogue.rpy:22
translate ru dialogue_arwen_othergirls_menu_paid_879dd5c5:

    # ARWEN @ talk "But I think she's a little {i}too{/i} desperate to work in here."
    ARWEN @ talk "Но думаю, она {i}слишком{/i} отчаянно хочет здесь работать."

# game/data/characters/arwen/scr_dialogue.rpy:23
translate ru dialogue_arwen_othergirls_menu_paid_35cb4a19:

    # ARWEN @ talk "As far as I know, they let her stay and serve clients outside for a reduced rate, but I doubt she'll get through the door."
    ARWEN @ talk "Насколько я знаю, ей разрешили остаться и обслуживать клиентов снаружи по сниженной ставке, но сомневаюсь, что она пройдёт через дверь."

# game/data/characters/arwen/scr_dialogue.rpy:24
translate ru dialogue_arwen_othergirls_menu_paid_da22f4ce:

    # MC @ talk "Why's that?"
    MC @ talk "Почему это?"

# game/data/characters/arwen/scr_dialogue.rpy:25
translate ru dialogue_arwen_othergirls_menu_paid_8e2a16c2:

    # ARWEN @ talk "Look around you, we're not the {i}Black Diamond,{/i} we general serve adventurers and merchants with coin to burn."
    ARWEN @ talk "Оглянись вокруг, мы не {i}Чёрный Алмаз,{/i} мы в основном обслуживаем искателей приключений и купцов с горящими монетами."

# game/data/characters/arwen/scr_dialogue.rpy:26
translate ru dialogue_arwen_othergirls_menu_paid_e4fcf857:

    # ARWEN @ talk "And she's out there letting the city guard take put it in her ass behind a wall... Hardly a good fit."
    ARWEN @ talk "А она там позволяет городской страже присунуть в её зад за стеной... Вряд ли подходящая кандидатура."

# game/data/characters/arwen/scr_dialogue.rpy:27
translate ru dialogue_arwen_othergirls_menu_paid_33eafac5:

    # MC @ talk "That seems rather harsh..."
    MC @ talk "Это кажется довольно жестоким..."

# game/data/characters/arwen/scr_dialogue.rpy:28
translate ru dialogue_arwen_othergirls_menu_paid_8c61c9e1:

    # ARWEN @ talk "It's just business darling... it's always cut-throat, no matter the trade."
    ARWEN @ talk "Это просто бизнес, дорогой... он всегда беспощаден, независимо от ремесла."

# game/data/characters/arwen/scr_dialogue.rpy:31
translate ru dialogue_arwen_othergirls_menu_paid_480f5c90:

    # ARWEN @ talk "Alright then, was there something else?"
    ARWEN @ talk "Ладно тогда, есть что-то ещё?"

# game/data/characters/arwen/scr_dialogue.rpy:34
translate ru dialogue_arwen_othergirls_menu_paid_7417b5c7:

    # ARWEN @ talk "Alright then, let's hear it."
    ARWEN @ talk "Хорошо, тогда давай послушаем."

translate ru strings:

    # game/data/characters/arwen/scr_dialogue.rpy:4
    old "Come on, {i}you can tell me...{/i}"
    new "Давай, {i}ты можешь мне рассказать...{/i}"

    # game/data/characters/arwen/scr_dialogue.rpy:10
    old "Would some coin loosen your tongue?"
    new "Может, монетка развяжет тебе язык?"

