
# game/data/characters/drax/dialogue.rpy:61
translate ru drax_talk_74b153d3:

    # DRAX "How can I help?"
    DRAX "Чем могу помочь?"

# game/data/characters/drax/dialogue.rpy:67
translate ru drax_bronzeDeliverRepeat_f426fc41:

    # DRAX "No, that won't do."
    DRAX "Нет, это не подходит."

# game/data/characters/drax/dialogue.rpy:68
translate ru drax_bronzeDeliverRepeat_f30b4de7:

    # DRAX "Come back after you've scavenged more bronze."
    DRAX "Возвращайся, когда добудешь больше бронзы."

# game/data/characters/drax/dialogue.rpy:73
translate ru drax_bronzeDeliverRepeat_5650b7ba:

    # DRAX "ARLENAAAAA!"
    DRAX "АРЛЕНАААА!"

# game/data/characters/drax/dialogue.rpy:74
translate ru drax_bronzeDeliverRepeat_0492f5f9:

    # DRAX "WE HAVE BRONZE!"
    DRAX "У НАС ЕСТЬ БРОНЗА!"

# game/data/characters/drax/dialogue.rpy:76
translate ru drax_bronzeDeliverRepeat_ba0ec503:

    # "Arlena emerged once again with her arms folded."
    "Арлена снова появилась, скрестив руки."

# game/data/characters/drax/dialogue.rpy:81
translate ru drax_bronzeDeliverRepeat_d11ff72d:

    # ARLENA "Not bad... Who knows? Maybe one day you'll be able to improve your personality like you've done your work ethic!"
    ARLENA "Неплохо... Кто знает? Может однажды ты сможешь улучшить свою личность, как улучшил свою рабочую этику!"

# game/data/characters/drax/dialogue.rpy:83
translate ru drax_bronzeDeliverRepeat_dfe83138:

    # ARLENA "Hmph... It's better than nothing I suppose. Don't be getting sloppy on us now!"
    ARLENA "Хмф... Это лучше чем ничего, полагаю. Только не начинай халтурить!"

# game/data/characters/drax/dialogue.rpy:85
translate ru drax_bronzeDeliverRepeat_b203b2ec:

    # ARLENA "I'm almost impressed!"
    ARLENA "Я почти впечатлена!"

# game/data/characters/drax/dialogue.rpy:87
translate ru drax_bronzeDeliverRepeat_269c09d7:

    # ARLENA "Urgh... Just take your gold and get out of here, I'm in no mood for you today."
    ARLENA "Ургх... Просто забирай своё золото и проваливай, сегодня я не в настроении для тебя."

# game/data/characters/drax/dialogue.rpy:97
translate ru drax_shop_first_e2d8bf63:

    # DRAX "Of course."
    DRAX "Конечно."

# game/data/characters/drax/dialogue.rpy:98
translate ru drax_shop_first_697cf030:

    # DRAX "Take a peak and see if anything catches your eye..."
    DRAX "Посмотри, не зацепит ли что-нибудь взгляд..."

# game/data/characters/drax/dialogue.rpy:112
translate ru drax_shop_7918a933:

    # DRAX "Take a look."
    DRAX "Взгляни."

# game/data/characters/drax/dialogue.rpy:117
translate ru drax_questions_53c1e4f7:

    # DRAX "What do you want to know?"
    DRAX "Что ты хочешь узнать?"

# game/data/characters/drax/dialogue.rpy:121
translate ru drax_qChanges_3056e47e:

    # DRAX "Not much to be honest, business carries on as usual here."
    DRAX "Честно говоря, немного, дела здесь идут как обычно."

# game/data/characters/drax/dialogue.rpy:122
translate ru drax_qChanges_90be5fd6:

    # DRAX "Usual petty neighbour drama shite, more Black Mages getting caught..."
    DRAX "Обычное дерьмо с соседскими драмами, всё больше Черных Магов попадаются..."

# game/data/characters/drax/dialogue.rpy:123
translate ru drax_qChanges_7d6bd86a:

    # DRAX "Biggest thing that’s happened for a while is you two coming home the way you did!"
    DRAX "Самое большое событие за последнее время — это то, как вы двое вернулись домой!"

# game/data/characters/drax/dialogue.rpy:127
translate ru drax_qBooks_629545c6:

    # DRAX "If you figure that one out..."
    DRAX "Если разберешься в этом..."

# game/data/characters/drax/dialogue.rpy:128
translate ru drax_qBooks_ddd935a1:

    # "Drax placed his hand on my shoulder as he smiled."
    "Дракс положил руку мне на плечо и улыбнулся."

# game/data/characters/drax/dialogue.rpy:129
translate ru drax_qBooks_27cb4f61:

    # DRAX "... Let me know!"
    DRAX "... Дай мне знать!"

# game/data/characters/drax/dialogue.rpy:133
translate ru drax_qEnd_d0d69c30:

    # DRAX "What else do you need?"
    DRAX "Что ещё тебе нужно?"

# game/data/characters/drax/dialogue.rpy:137
translate ru drax_bye_987ddf0d:

    # DRAX "Come back anytime."
    DRAX "Возвращайся в любое время."

# game/data/characters/drax/dialogue.rpy:141
translate ru drax_craft_a1dec31f:

    # DRAX "Ah! You need something forged?"
    DRAX "Ах! Тебе нужно что-то выковать?"

# game/data/characters/drax/dialogue.rpy:146
translate ru drax_craft_00afb801:

    # DRAX "Anytime."
    DRAX "В любое время."

# game/data/characters/drax/dialogue.rpy:150
translate ru drax_craft_b9b6a99a:

    # DRAX "I can smelt you just about any kind of armor and weapons you'd like, trouble is, it ain't just about the coin."
    DRAX "Я могу выковать для тебя практически любые доспехи и оружие, но проблема не только в монетах."

# game/data/characters/drax/dialogue.rpy:151
translate ru drax_craft_78db8fb0:

    # DRAX "There's a shortage of raw materials coming in, and most of what {i}does{/i} come in goes to the war effort."
    DRAX "Сырье поступает с перебоями, и большая часть того, что {i}поступает{/i}, идёт на военные нужды."

# game/data/characters/drax/dialogue.rpy:152
translate ru drax_craft_54c95bbc:

    # DRAX "If you want me to make you something, you may have to source the raw materials yourself..."
    DRAX "Если хочешь, чтобы я что-то для тебя сделал, возможно, тебе придётся самому добывать сырьё..."

# game/data/characters/drax/dialogue.rpy:156
translate ru drax_craft_8e531321:

    # DRAX "Very well then... Let me know if you need anything!"
    DRAX "Что ж, хорошо... Дай знать, если что-то понадобится!"

translate ru strings:

    # game/data/characters/drax/dialogue.rpy:2
    old "Drax needs bronze scraps"
    new "Драксу нужен бронзовый лом"

    # game/data/characters/drax/dialogue.rpy:2
    old "A blacksmith of Novaras will take any bronze scraps I might scavenge in exchange for gold. He is only interested in batches of five, for whatever reason."
    new "Кузнец из Новараса возьмёт любой бронзовый лом, который я смогу раздобыть, в обмен на золото. Он почему-то интересуется только партиями по пять штук."

    # game/data/characters/drax/dialogue.rpy:26
    old "Here is some more bronze you wanted."
    new "Вот ещё немного бронзы, которую ты хотел."

    # game/data/characters/drax/dialogue.rpy:29
    old "Can I see your wares?"
    new "Могу я посмотреть твои товары?"

    # game/data/characters/drax/dialogue.rpy:33
    old "I wanted to talk to you about crafting something for me."
    new "Я хотел поговорить с тобой о создании чего-то для меня."

    # game/data/characters/drax/dialogue.rpy:34
    old "I have a few questions..."
    new "У меня есть несколько вопросов..."

    # game/data/characters/drax/dialogue.rpy:38
    old "Has much changed since I left?"
    new "Многое изменилось с тех пор, как я ушёл?"

    # game/data/characters/drax/dialogue.rpy:39
    old "Any ideas on getting into Arlena’s good books?"
    new "Есть идеи, как попасть в милость к Арлене?"

    # game/data/characters/drax/dialogue.rpy:40
    old "That’s all for now."
    new "На этом пока всё."

    # game/data/characters/drax/dialogue.rpy:143
    old "Yes, there's something I'd like you to make for me..."
    new "Да, я бы хотел, чтобы ты кое-что приготовил для меня..."

    # game/data/characters/drax/dialogue.rpy:149
    old "Could you explain it to me?"
    new "Можешь объяснить мне это?"

    # game/data/characters/drax/dialogue.rpy:155
    old "Nevermind, I've changed my mind."
    new "Неважно, я передумал."

