    "Жерар улыбнулся и кивнул."

# game/data/characters/gerard/dialogue.rpy:72
translate ru gerard_firstmeet_475bdcd4:

    # GERARD @ happy "Well, you're welcome in our home anytime, [player_name!t]."
    GERARD @ happy "Что ж, ты всегда желанный гость в нашем доме, [player_name!t]."

# game/data/characters/gerard/dialogue.rpy:72
translate ru gerard_firstmeet_fb898fac:

    # GERARD @ happy "Now when are you going to make an honest woman of my daughter?"
    GERARD @ happy "А когда ты собираешься сделать из моей дочери честную женщину?"

# game/data/characters/gerard/dialogue.rpy:73
translate ru gerard_firstmeet_229b9884:

    # "Adara's eyes widened in horror."
    "Глаза Адары расширились от ужаса."

# game/data/characters/gerard/dialogue.rpy:74
translate ru gerard_firstmeet_0f68b999:

    # ADARA @ shock "FATHER!"
    ADARA @ shock "ОТЕЦ!"

# game/data/characters/gerard/dialogue.rpy:75
translate ru gerard_firstmeet_90918178:

    # MC @ surprised "U-Uhh...!"
    MC @ surprised "О-ооуу...!"

