translate ru gerard_firstmeet_fb51ca06:

    # GERARD "Yes, that is a good question..."
    GERARD "Да, хороший вопрос..."

# game/data/characters/gerard/dialogue.rpy:67
translate ru gerard_firstmeet_9ba588d3:

    # GERARD "What brings you here, [player_name!t]?"
    GERARD "Что привело тебя сюда, [player_name!t]?"

# game/data/characters/gerard/dialogue.rpy:67
translate ru gerard_firstmeet_821aecf2:

    # MC @ lewd "Ah, I actually came to see how Adara was doing..."
    MC @ lewd "А, я вообще-то пришёл проведать, как поживает Адара..."

# game/data/characters/gerard/dialogue.rpy:68
translate ru gerard_firstmeet_63c7d2ef:

    # "Adara's cheeks burned red as her father looked back and forth from me to her."
    "Щёки Адары пылали румянцем, пока её отец смотрел то на меня, то на неё."

# game/data/characters/gerard/dialogue.rpy:69
translate ru gerard_firstmeet_e0dd8443:

    # ADARA "Y-You don't need to trouble yourself worrying about me."
    ADARA "Т-Тебе не нужно беспокоиться обо мне."

# game/data/characters/gerard/dialogue.rpy:70
translate ru gerard_firstmeet_0cc6e9de:

