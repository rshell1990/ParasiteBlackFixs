translate ru gerard_firstmeet_473b8004:

    # MC @ surprised "Gerard, it's me! It's [player_name!t]!"
    MC @ surprised "Жерар, это я! Это [player_name!t]!"

# game/data/characters/gerard/dialogue.rpy:50
translate ru gerard_firstmeet_dc142611:

    # "Gerard's eyes wandered over me from top to bottom, as though unconvinced."
    "Глаза Жерара скользнули по мне сверху вниз, словно он не был убеждён."

# game/data/characters/gerard/dialogue.rpy:51
translate ru gerard_firstmeet_a01e7045:

    # "Then, when the realization hit, he smiled brightly."
    "Затем, когда до него дошло, он ярко улыбнулся."

# game/data/characters/gerard/dialogue.rpy:53
translate ru gerard_firstmeet_863787d9:

    # GERARD @ happy "Ah! [player_name!t]! It's good to see you!"
    GERARD @ happy "Ах! [player_name!t]! Рад тебя видеть!"

# game/data/characters/gerard/dialogue.rpy:53
translate ru gerard_firstmeet_c419d1f7:

    # MC @ smile "Hello. Gerard, how do you fair?"
    MC @ smile "Здравствуй. Жерар, как твои дела?"

# game/data/characters/gerard/dialogue.rpy:54
translate ru gerard_firstmeet_1d579dac:

    # "Adara's father coughed and spluttered before offering a faint, sickly smile."
    "Отец Адары кашлянул и задохнулся, прежде чем предложить слабую, болезненную улыбку."

# game/data/characters/gerard/dialogue.rpy:55
translate ru gerard_firstmeet_4ff4c591:

    # GERARD @ happy "I struggle to move around much these days, but I keep going all the same."
    GERARD @ happy "В эти дни мне трудно много двигаться, но я всё равно продолжаю жить."

# game/data/characters/gerard/dialogue.rpy:56
translate ru gerard_firstmeet_31bef116:

    # GERARD @ shock "By the gods though, you've changed!"
    GERARD @ shock "Клянусь богами, но ты изменился!"

# game/data/characters/gerard/dialogue.rpy:57
translate ru gerard_firstmeet_0db8be50:

    # MC @ smile "Ah, well, a lot's happened since you last saw me..."
    MC @ smile "Ах, ну, многое случилось с тех пор, как ты видел меня в последний раз..."

# game/data/characters/gerard/dialogue.rpy:58
translate ru gerard_firstmeet_58db3fa1:

    # "Adara emerged from the upstairs, calling out to her father."
    "Адара появилась с верхнего этажа, окликнув отца."

# game/data/characters/gerard/dialogue.rpy:60
translate ru gerard_firstmeet_0ea16926:

