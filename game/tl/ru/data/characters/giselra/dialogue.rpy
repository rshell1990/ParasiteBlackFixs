# game/data/characters/giselra/dialogue.rpy:21
translate ru giselra_talk_a70b638e:

    # GISELRA @ shock "Welcome to Giselra’s!"
    GISELRA @ shock "Добро пожаловать в Гизельра!"

# game/data/characters/giselra/dialogue.rpy:22
translate ru giselra_talk_c34ff831:

    # GISELRA @ smile "Looking for something tailored, perhaps?"
    GISELRA @ smile "Ищете что-то по индивидуальному заказу, полагаю?"

# game/data/characters/giselra/dialogue.rpy:27
translate ru giselra_bye_412dc7b0:

    # GISELRA @ smile "Bye, lovely."
    GISELRA @ smile "До свидания, милый."

translate ru strings:

    # game/data/characters/giselra/dialogue.rpy:12
    old "Talk to Giselra"
    new "Поговорить с Гизельрой"

# game/data/characters/giselra/dialogue.rpy:22
translate ru giselra_talk_firstmeet_14cc07a6:

    # "The tailor's voice called from the back of the store."
    "Голос портной донёсся из глубины магазина."

# game/data/characters/giselra/dialogue.rpy:23
translate ru giselra_talk_firstmeet_97f4d434:

    # GISELRA "One moment please!"
    GISELRA "Одну минутку пожалуйста!"

# game/data/characters/giselra/dialogue.rpy:24
translate ru giselra_talk_firstmeet_e38541a5:

    # "I turned slowly, looking at the many intricately crafted dresses on display."
    "Я медленно осмотрелся, разглядывая множество изысканно сшитых платьев на витринах."

# game/data/characters/giselra/dialogue.rpy:25
translate ru giselra_talk_firstmeet_a05f0e9d:

    # "Whoever this tailor was, she was indeed of exceptional skill."
    "Кем бы ни была эта портная, её мастерство явно было исключительным."

# game/data/characters/giselra/dialogue.rpy:26
translate ru giselra_talk_firstmeet_e71e1997:

    # "I heard soft footsteps, turning my head as an older, black woman stepped forward,"
    "Я услышал мягкие шаги и повернул голову, ко мне вышла пожилая, чернокожая женщина,"

# game/data/characters/giselra/dialogue.rpy:27
translate ru giselra_talk_firstmeet_cfa5b9c1:

    # "With an infectiously warm smile, she greeted me."
    "Она поприветствовала меня заразительно теплой улыбкой."

# game/data/characters/giselra/dialogue.rpy:29
translate ru giselra_talk_firstmeet_44893887:

    # GISELRA @ smile "Welcome to Giselra's handsome."
    GISELRA @ smile "Добро пожаловать в ателье Гизельры, красавчик."

# game/data/characters/giselra/dialogue.rpy:30
translate ru giselra_talk_firstmeet_ec7dbf09:

    # GISELRA @ smile "The finest tailor in ALL of Hamun."
    GISELRA @ smile "Лучший портной во всём Хамуне."

# game/data/characters/giselra/dialogue.rpy:31
translate ru giselra_talk_firstmeet_e5ba6b5b:

    # MC @ smile "The finest you say?"
    MC @ smile "Лучший, говорите?"

# game/data/characters/giselra/dialogue.rpy:32
translate ru giselra_talk_firstmeet_e713de8a:

    # GISELRA @ talk "Of course, whatever clothes you desire, I can see them crafted."
    GISELRA @ talk "Конечно, какие бы одежды ты ни пожелал, я смогу их сшить."

# game/data/characters/giselra/dialogue.rpy:33
translate ru giselra_talk_firstmeet_ddff3fa8:

    # GISELRA @ smile "{i}For a price, of course...{/i}"
    GISELRA @ smile "{i}За плату, разумеется...{/i}"

# game/data/characters/giselra/dialogue.rpy:34
translate ru giselra_talk_firstmeet_c79a39bc:

    # GISELRA @ talk "Let me know if my services are of used."
    GISELRA @ talk "Дай знать, если мои услуги тебе понадобятся."

# game/data/characters/giselra/dialogue.rpy:35
translate ru giselra_talk_firstmeet_81658a7e:

    # MC @ talk "Will do."
    MC @ talk "Обязательно."

# game/data/characters/giselra/dialogue.rpy:37
translate ru giselra_talk_firstmeet_f8120a53:

    # MC "(Always handy to know a good tailor.)"
    MC "(Всегда полезно знать хорошего портного.)"

