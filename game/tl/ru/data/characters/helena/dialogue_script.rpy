
# game/data/characters/helena/dialogue_script.rpy:4
translate ru nov_helena_firstmeet_a4c50776:

    # HELENA @ talk "Ahh, good evening sir."
    HELENA @ talk "Ахх, добрый вечер, сэр."

# game/data/characters/helena/dialogue_script.rpy:5
translate ru nov_helena_firstmeet_fcddae28:

    # HELENA @ talk "How do you find yourself this Evening?"
    HELENA @ talk "Как вы себя чувствуете в этот вечер?"

# game/data/characters/helena/dialogue_script.rpy:6
translate ru nov_helena_firstmeet_e63ccf3e:

    # HELENA @ smile "I am Helena, and yourself?"
    HELENA @ smile "Я Хелена, а вы?"

# game/data/characters/helena/dialogue_script.rpy:7
translate ru nov_helena_firstmeet_638d46d2:

    # MC @ talk "A pleasure to meet you Helena, I am called [player_name!t]."
    MC @ talk "Приятно познакомиться, Хелена, меня зовут [player_name!t]."

# game/data/characters/helena/dialogue_script.rpy:8
translate ru nov_helena_firstmeet_48a9321b:

    # HELENA @ talk "Hmm, your name sounds familiar..."
    HELENA @ talk "Хмм, ваше имя звучит знакомо..."

# game/data/characters/helena/dialogue_script.rpy:9
translate ru nov_helena_firstmeet_4659a883:

    # HELENA @ shock "Wait, I know of you."
    HELENA @ shock "Подождите, я знаю о вас."

# game/data/characters/helena/dialogue_script.rpy:10
translate ru nov_helena_firstmeet_e1f13c50:

    # HELENA @ talk "You and your friend are the scouts who survived the recent expedition."
    HELENA @ talk "Вы и ваш друг — те разведчики, что выжили в недавней экспедиции."

# game/data/characters/helena/dialogue_script.rpy:11
translate ru nov_helena_firstmeet_d2fa7c7f:

    # HELENA @ lewd "I see they did not exagerrate when they spoke of how handsome you are."
    HELENA @ lewd "Вижу, они не преувеличивали, говоря о вашей привлекательности."

# game/data/characters/helena/dialogue_script.rpy:17
translate ru nov_helena_services_c3c21da7:

    # HELENA @ talk "I am afraid my services aren't for you."
    HELENA @ talk "Боюсь, мои услуги не для вас."

# game/data/characters/helena/dialogue_script.rpy:18
translate ru nov_helena_services_c513028d:

    # MC @ talk "Wait, what?"
    MC @ talk "Подожди, что?"

# game/data/characters/helena/dialogue_script.rpy:19
translate ru nov_helena_services_46c3977b:

    # HELENA @ smile "My clients are a small reserved of a certain social class."
    HELENA @ smile "Мои клиенты — это небольшой, избранный круг определённого социального класса."

# game/data/characters/helena/dialogue_script.rpy:20
translate ru nov_helena_services_1a47015e:

    # HELENA @ talk "Only a certain social class I'm afraid."
    HELENA @ talk "Боюсь, только определённого социального класса."

# game/data/characters/helena/dialogue_script.rpy:21
translate ru nov_helena_services_2a12bf32:

    # MC @ talk "You mean aristocrats and nobles then?"
    MC @ talk "Ты имеешь в виду аристократов и дворян?"

# game/data/characters/helena/dialogue_script.rpy:22
translate ru nov_helena_services_052927c7:

    # HELENA @ lewd2 "Not necessarily... I make special priced exceptions for men who have truly carved out a name for themselves."
    HELENA @ lewd2 "Не обязательно... Я делаю исключения по специальным ценам для мужчин, которые действительно создали себе имя."

# game/data/characters/helena/dialogue_script.rpy:23
translate ru nov_helena_services_074a27e5:

    # HELENA @ smile "Men who get tongues wagging when they see me speaking with them."
    HELENA @ smile "Мужчин, от которых начинают шептаться, когда видят, что я с ними разговариваю."

# game/data/characters/helena/dialogue_script.rpy:24
translate ru nov_helena_services_aa047f0d:

    # MC @ talk "Such as?"
    MC @ talk "Например?"

# game/data/characters/helena/dialogue_script.rpy:25
translate ru nov_helena_services_a5c33d70:

    # HELENA @ smile "I never kiss and tell."
    HELENA @ smile "Я никогда не выбалтываю секретов."

# game/data/characters/helena/dialogue_script.rpy:26
translate ru nov_helena_services_ca2c4f8b:

    # HELENA @ joy "But let's just say some adventurers who'd rather have their names kept a secret have come to me before."
    HELENA @ joy "Но скажем так, некоторые искатели приключений, которые предпочли бы сохранить свои имена в тайне, уже обращались ко мне."

# game/data/characters/helena/dialogue_script.rpy:27
translate ru nov_helena_services_60e8bb1f:

    # MC @ talk "Humor me, what are your normal prices."
    MC @ talk "Пожалуйста, удовлетвори моё любопытство — какие у тебя обычные цены?"

# game/data/characters/helena/dialogue_script.rpy:28
translate ru nov_helena_services_e1271a49:

    # HELENA @ smile "A night with me would cost you more than ten thousand coins."
    HELENA @ smile "Ночь со мной обойдётся тебе больше чем в десять тысяч монет."

# game/data/characters/helena/dialogue_script.rpy:29
translate ru nov_helena_services_74ca5542:

    # "I felt the blood drain from my face."
    "Я почувствовал, как кровь отлила от моего лица."

# game/data/characters/helena/dialogue_script.rpy:30
translate ru nov_helena_services_0449bb90:

    # MC @ talk "T-Ten... thousand?"
    MC @ talk "Д-Десять... тысяч?"

# game/data/characters/helena/dialogue_script.rpy:31
translate ru nov_helena_services_99b30993:

    # MC @ talk "What about charging per act?"
    MC @ talk "А как насчёт оплаты за акт?"

# game/data/characters/helena/dialogue_script.rpy:32
translate ru nov_helena_services_307909da:

    # HELENA @ talk "I'm afraid such a thing is far more becoming of a common whore than a courtesan."
    HELENA @ talk "Боюсь, подобное гораздо больше подходит обычной шлюхе, чем куртизанке."

# game/data/characters/helena/dialogue_script.rpy:33
translate ru nov_helena_services_9bb1df98:

    # HELENA @ talk "The clients a courtesan takes on expect us to be more reserved and discreit, our bodies not used by every passing traveler."
    HELENA @ talk "Клиенты, которых принимает куртизанка, ожидают от нас большей сдержанности и скромности, наши тела не предназначены для каждого проходящего путника."

# game/data/characters/helena/dialogue_script.rpy:34
translate ru nov_helena_services_f2a6779b:

    # HELENA @ sad "Such a thing could ruin a courtesan's reputation should she behave like an ordinary lady of the night."
    HELENA @ sad "Такое может разрушить репутацию куртизанки, если она будет вести себя как обычная ночная бабочка."

# game/data/characters/helena/dialogue_script.rpy:35
translate ru nov_helena_services_326690ca:

    # HELENA @ talk "Thus, our companionship is sold for the whole evening... Partly to avoid too much scrutiny."
    HELENA @ talk "Таким образом, наше общество продаётся на весь вечер... Отчасти чтобы избежать излишнего внимания."

# game/data/characters/helena/dialogue_script.rpy:36
translate ru nov_helena_services_dc064c48:

    # HELENA @ smile "And sometimes our clients simply want us to be a delight on their arms and make other lords and such jealous."
    HELENA @ smile "А иногда наши клиенты просто хотят, чтобы мы украшали их руку и вызывали зависть у других лордов и им подобных."

# game/data/characters/helena/dialogue_script.rpy:37
translate ru nov_helena_services_dd4dfd06:

    # MC @ talk "Hmm, I see."
    MC @ talk "Хм, понятно."

# game/data/characters/helena/dialogue_script.rpy:38
translate ru nov_helena_services_771bb20d:

    # MC "(Unless I want to spend a small fortune on her, I'll need to build my reputation through adventuring and such before she offers me better rates for her 'sevices'.)"
    MC "(Если я не хочу потратить на неё целое состояние, мне придётся сначала заработать репутацию через приключения и тому подобное, прежде чем она предложит мне лучшие условия для своих 'услуг'.)"

# game/data/characters/helena/dialogue_script.rpy:42
translate ru nov_helena_about_a754025e:

    # HELENA @ talk "Hm? I prefer to keep my past to myself... I find men are more drawn to what they see as some alluring mystery."
    HELENA @ talk "Хм? Я предпочитаю оставлять своё прошлое при себе... Мне кажется, мужчин больше привлекает то, что они видят как загадочную тайну."

# game/data/characters/helena/dialogue_script.rpy:43
translate ru nov_helena_about_8999f46f:

    # HELENA @ lewd2 "Perhaps one day I will tell you."
    HELENA @ lewd2 "Возможно, однажды я расскажу тебе."

# game/data/characters/helena/dialogue_script.rpy:47
translate ru nov_helena_bye_a0f4734c:

    # HELENA @ talk "Speak soon."
    HELENA @ talk "Еще поговорим."

