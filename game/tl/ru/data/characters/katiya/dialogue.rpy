# game/data/characters/katiya/dialogue.rpy:48
translate ru katiya_store_talk_e0fcf082:

    # KATIYA "Ah! Welcome! Welcome to my store!"
    KATIYA "Ах! Добро пожаловать! Добро пожаловать в мой магазин!"

# game/data/characters/katiya/dialogue.rpy:49
translate ru katiya_store_talk_6f815309:

    # KATIYA "How may Katiya help you today?"
    KATIYA "Чем Катя может помочь тебе сегодня?"

# game/data/characters/katiya/dialogue.rpy:56
translate ru katiya_trade_ffd38123:

    # KATIYA "Katiya has many things to show... For a price."
    KATIYA "У Кати есть много чего показать... За определённую плату."

# game/data/characters/katiya/dialogue.rpy:59
translate ru katiya_trade_e3565c59:

    # KATIYA "You will be back soon, I can tell!"
    KATIYA "Ты скоро вернёшься, я это чувствую!"

# game/data/characters/katiya/dialogue.rpy:64
translate ru katiya_bye_72bda86e:

    # KATIYA "Sure, feel free to."
    KATIYA "Конечно, не стесняйся."

# game/data/characters/katiya/dialogue.rpy:69
translate ru katiya_good_alderian_6eda821e:

    # KATIYA "Is that so?"
    KATIYA "Неужели?"

# game/data/characters/katiya/dialogue.rpy:70
translate ru katiya_good_alderian_66a4d476:

    # KATIYA "My father is Alderian, he taught me to speak your tongue well from a young age."
    KATIYA "Мой отец — Алдереец, он с детства научил меня хорошо говорить на твоем языке."

# game/data/characters/katiya/dialogue.rpy:71
translate ru katiya_good_alderian_fd9e21cd:

    # MC @ smile "Oh, that’s impressive."
    MC @ smile "Оу, это впечатляет."

# game/data/characters/katiya/dialogue.rpy:72
translate ru katiya_good_alderian_38d06199:

    # MC @ talk "Is your father still well?"
    MC @ talk "Твой отец ещё жив здоров?"

# game/data/characters/katiya/dialogue.rpy:73
translate ru katiya_good_alderian_785bcc2d:

    # KATIYA "Tsch... He is a drunkard who left me and my mother for some Alderian merchants daughter."
    KATIYA "Пфф... Он пьяница, который бросил меня и мою мать ради дочери какого-то Алдереанского купца."

# game/data/characters/katiya/dialogue.rpy:74
translate ru katiya_good_alderian_832c1e56:

    # MC @ sad "Oh, I’m... Sorry."
    MC @ sad "Ох, я... Извини."

# game/data/characters/katiya/dialogue.rpy:75
translate ru katiya_good_alderian_78167e0b:

    # KATIYA "It is life. Many daughters have had worse fathers."
    KATIYA "Такова жизнь. У многих дочерей были отцы и похуже."

# game/data/characters/katiya/dialogue.rpy:79
translate ru katiya_flash_ask_3b52cb1a:

    # KATIYA "Fifty coins and I’ll let you look, but no touch."
    KATIYA "Пятьдесят монет, и я позволю посмотреть, но не трогать."

# game/data/characters/katiya/dialogue.rpy:83
translate ru katiya_flash_ask_c6b8d76d:

    # KATIYA "Enjoy thinking about them tonight ~"
    KATIYA "Наслаждайся мыслями о них сегодня вечером ~"

# game/data/characters/katiya/dialogue.rpy:93
translate ru katiya_flash_ask_c84964e3:

    # KATIYA "When you have the coin, you let me know."
    KATIYA "Когда будут монеты, дай мне знать."

