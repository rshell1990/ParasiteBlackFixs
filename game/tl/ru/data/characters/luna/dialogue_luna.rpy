
# game/data/characters/luna/dialogue_luna.rpy:24
translate ru luna_talk_fe2ebf70:

    # LUNA @ smile "Hello! May I help you with something?"
    LUNA @ smile "Здравствуйте! Могу я вам чем-то помочь?"

# game/data/characters/luna/dialogue_luna.rpy:29
translate ru luna_bye_e42febf0:

    # LUNA "See you around!"
    LUNA "Увидимся!"

# game/data/characters/luna/dialogue_luna.rpy:34
translate ru luna_talk_cantgothere_58ea8463:

    # LUNA "Hey! You can't just walk in there."
    LUNA "Эй! Вы не можете просто туда войти."

# game/data/characters/luna/dialogue_luna.rpy:39
translate ru luna_use_baths_03aa7676:

    # LUNA @ smile "Certainly!"
    LUNA @ smile "Конечно!"

# game/data/characters/luna/dialogue_luna.rpy:40
translate ru luna_use_baths_2f547f8a:

    # LUNA @ smile "For you and your companions that'll be two hundred and fifty coins."
    LUNA @ smile "Для вас и ваших спутников это будет двести пятьдесят монет."

# game/data/characters/luna/dialogue_luna.rpy:46
translate ru luna_use_baths_c0c26f2f:

    # LUNA @ talk "Okay then, should you make the decision, the {i}Princess' Dream{/i} is always ready to recieve guests."
    LUNA @ talk "Хорошо, если вы примете решение, {i}Мечта Принцессы{/i} всегда готова принять гостей."

# game/data/characters/luna/dialogue_luna.rpy:52
translate ru luna_questions_9469500d:

    # LUNA @ talk "Hm? Questions?"
    LUNA @ talk "Хм? Вопросы?"

# game/data/characters/luna/dialogue_luna.rpy:53
translate ru luna_questions_46ef7612:

    # LUNA @ talk "What do you want to know?"
    LUNA @ talk "Что вы хотите узнать?"

# game/data/characters/luna/dialogue_luna.rpy:56
translate ru luna_questions_menu_71d4ef92:

    # LUNA @ talk "Ahh..."
    LUNA @ talk "Ахх..."

# game/data/characters/luna/dialogue_luna.rpy:57
translate ru luna_questions_menu_64ef36ae:

    # LUNA @ talk "My husband was sea captain of a small merchant vessel."
    LUNA @ talk "Мой муж был капитаном небольшого торгового судна."

# game/data/characters/luna/dialogue_luna.rpy:58
translate ru luna_questions_menu_2b407674:

    # LUNA @ talk "The coin was good, but the months at sea were long."
    LUNA @ talk "Монета была хороша, но месяцы в море были долгими."

# game/data/characters/luna/dialogue_luna.rpy:59
translate ru luna_questions_menu_c067ca27:

    # LUNA @ think "That's why we saved up what money we could,"
    LUNA @ think "Вот почему мы откладывали все деньги, какие могли,"

# game/data/characters/luna/dialogue_luna.rpy:60
translate ru luna_questions_menu_7c370a02:

    # MC @ talk "He planned to retire and have us open up a store."
    MC @ talk "Он планировал уйти на покой и открыть с нами магазин."

# game/data/characters/luna/dialogue_luna.rpy:61
translate ru luna_questions_menu_51681a50:

    # LUNA @ sad "That is... until his ship was taken by a storm."
    LUNA @ sad "Так было... пока его корабль не забрала буря."

# game/data/characters/luna/dialogue_luna.rpy:62
translate ru luna_questions_menu_234263d1:

    # MC @ sad "I am sorry to hear that."
    MC @ sad "Мне жаль это слышать."

# game/data/characters/luna/dialogue_luna.rpy:63
translate ru luna_questions_menu_02f03353:

    # LUNA @ sad "It's alright, it was a long time ago now."
    LUNA @ sad "Все в порядке, это было давно."

# game/data/characters/luna/dialogue_luna.rpy:64
translate ru luna_questions_menu_e8411806:

    # LUNA @ sad "It's... easier to talk about now."
    LUNA @ sad "Теперь... об этом легче говорить."

# game/data/characters/luna/dialogue_luna.rpy:65
translate ru luna_questions_menu_b6df5634:

    # LUNA @ think "Anyway, after my husband died, I was left with the coin we had managed to save up."
    LUNA @ think "В любом случае, после смерти мужа у меня остались монеты, которые нам удалось накопить."

# game/data/characters/luna/dialogue_luna.rpy:66
translate ru luna_questions_menu_465a393c:

    # LUNA @ smile "I thought, well, no point running off with my tail between my leg."
    LUNA @ smile "Я подумала, ну, нет смысла убегать поджав хвост."

# game/data/characters/luna/dialogue_luna.rpy:67
translate ru luna_questions_menu_34b15857:

    # LUNA @ smile "So, I looked around, and decided instead of a store,"
    LUNA @ smile "Так что, я осмотрелась, и решила вместо магазина,"

# game/data/characters/luna/dialogue_luna.rpy:68
translate ru luna_questions_menu_e4722a60:

    # LUNA @ smile "A bathhouse sounded more fun to run."
    LUNA @ smile "Управлять баней, это оказалось более интересным."

# game/data/characters/luna/dialogue_luna.rpy:69
translate ru luna_questions_menu_661169f5:

    # LUNA @ smile "Heh... Plus I get a warm bath whenever I want now."
    LUNA @ smile "Хех... К тому же, теперь я могу принимать тёплую ванну, когда захочу."

# game/data/characters/luna/dialogue_luna.rpy:70
translate ru luna_questions_menu_8a3ca43c:

    # LUNA @ talk "Hope that answers your question."
    LUNA @ talk "Надеюсь, это ответило на ваш вопрос."

# game/data/characters/luna/dialogue_luna.rpy:73
translate ru luna_questions_menu_94fb1e89:

    # LUNA @ talk "There's not many other places for a katai to start a business."
    LUNA @ talk "Для катай не так много мест, чтобы начать бизнес."

# game/data/characters/luna/dialogue_luna.rpy:74
translate ru luna_questions_menu_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Что?"

# game/data/characters/luna/dialogue_luna.rpy:75
translate ru luna_questions_menu_86a14c5e:

    # MC @ think "It's illegal for a katai to own a businss in Novaras or something?"
    MC @ think "Катай запрещено владеть бизнесом в Новарасе или что-то в этом роде?"

# game/data/characters/luna/dialogue_luna.rpy:76
translate ru luna_questions_menu_23fd0367:

    # LUNA @ think "Not exactly."
    LUNA @ think "Не совсем."

# game/data/characters/luna/dialogue_luna.rpy:77
translate ru luna_questions_menu_4b66451e:

    # LUNA @ sad "They just don't refuse to hand out any business licences."
    LUNA @ sad "Они просто отказываются выдавать какие-либо бизнес-лицензии."

# game/data/characters/luna/dialogue_luna.rpy:78
translate ru luna_questions_menu_d4ac178e:

    # MC @ think "... None?"
    MC @ think "... Вообще никакие?"

# game/data/characters/luna/dialogue_luna.rpy:79
translate ru luna_questions_menu_9432b0bb:

    # LUNA @ talk "Well, they either outright refuse to grant permits and licences,"
    LUNA @ talk "Ну, они либо прямо отказывают в выдаче разрешений и лицензий,"

# game/data/characters/luna/dialogue_luna.rpy:80
translate ru luna_questions_menu_9b87abaa:

    # LUNA @ talk "Or, they charge ludicrous rates that no one in their right mind would pay."
    LUNA @ talk "Или они ставят безумные цены, которые никто в здравом уме не стал бы платить."

# game/data/characters/luna/dialogue_luna.rpy:81
translate ru luna_questions_menu_f068c751:

    # LUNA @ talk "Sometimes as high as five times as much the asking price of a normal human."
    LUNA @ talk "Иногда вплоть до пятикратной стоимости обычного человека."

# game/data/characters/luna/dialogue_luna.rpy:82
translate ru luna_questions_menu_5fae091a:

    # LUNA @ sad "They tolerate some of the more powerful merchants when it comes to trade."
    LUNA @ sad "Они терпят некоторых из более влиятельных торговцев, когда дело доходит до обмена."

# game/data/characters/luna/dialogue_luna.rpy:83
translate ru luna_questions_menu_8866674a:

    # LUNA @ sad "For the rest of us though?"
    LUNA @ sad "Но что касается остальных из нас?"

# game/data/characters/luna/dialogue_luna.rpy:84
translate ru luna_questions_menu_9b6f6a12:

    # LUNA @ sad "They're only interested in hiring us katai as either servants or whores."
    LUNA @ sad "Они заинтересованы только в том чтобы нанимать нас, катай, либо в качестве слуг, либо в качестве проституток."

# game/data/characters/luna/dialogue_luna.rpy:85
translate ru luna_questions_menu_209bb546:

    # MC @ talk "So that's why katai come here instead?"
    MC @ talk "Так вот почему катай приходят сюда вместо этого?"

# game/data/characters/luna/dialogue_luna.rpy:86
translate ru luna_questions_menu_6a433e62:

    # LUNA @ talk "As dangerous as the free city is, it's {i}free.{/i}"
    LUNA @ talk "Как бы опасен ни был свободный город, он {i}свободен.{/i}"

# game/data/characters/luna/dialogue_luna.rpy:87
translate ru luna_questions_menu_804b4e81:

    # LUNA @ talk "At least here, we can etch out a life for ourselves."
    LUNA @ talk "По крайней мере, здесь мы можем выковать себе жизнь."

# game/data/characters/luna/dialogue_luna.rpy:90
translate ru luna_questions_menu_393b14e5:

    # LUNA @ talk "Alright then."
    LUNA @ talk "Хорошо тогда."

translate ru strings:

    # game/data/characters/luna/dialogue_luna.rpy:12
    old "Talk to Luna"
    new "Поговорить с Луной"

    # game/data/characters/luna/dialogue_luna.rpy:18
    old "I have a few questions."
    new "У меня есть несколько вопросов."

    # game/data/characters/luna/dialogue_luna.rpy:19
    old "I'd like to use your baths."
    new "Я хочу воспользоваться твоими банями."

    # game/data/characters/luna/dialogue_luna.rpy:20
    old "Bye."
    new "До свидания."

    # game/data/characters/luna/dialogue_luna.rpy:42
    old "Here you go"
    new "Вот, пожалуйста."

    # game/data/characters/luna/dialogue_luna.rpy:55
    old "How does a katai end up running a bathhouse in Hamun?"
    new "Как катай оказалась управляющим баней в Хамуне?"

    # game/data/characters/luna/dialogue_luna.rpy:72
    old "I see a lot of katai around Hamun... How come?"
    new "Я вижу много катай вокруг Хамуна... Почему?"

    # game/data/characters/luna/dialogue_luna.rpy:89
    old "That's all I wanted to ask."
    new "Это всё, что я хотел спросить."

