
# game/data/characters/numa/dialogue.rpy:42
translate ru numa_moreaboutpeople_4dff1363:

    # NUMA @ talk "Speak the wave, and I shall answer."
    NUMA @ talk "Говори на волне, и я отвечу."

# game/data/characters/numa/dialogue.rpy:45
translate ru numa_moreaboutpeople_menu_f26655da:

    # NUMA @ talk "Once a month, our people wash up on the docks bringing supplies and gifts."
    NUMA @ talk "Раз в месяц, наш народ прибивает к докам, принося припасы и дары."

# game/data/characters/numa/dialogue.rpy:46
translate ru numa_moreaboutpeople_menu_0f7b9bbf:

    # NUMA @ talk "Treasure from sunken ships, pearls, some fish..."
    NUMA @ talk "Сокровища с затонувших кораблей, жемчуг, немного рыбы..."

# game/data/characters/numa/dialogue.rpy:47
translate ru numa_moreaboutpeople_menu_f222a1c7:

    # NUMA @ talk "In return, we are given weapons and armours forged."
    NUMA @ talk "Взамен нам дают выкованное оружие и доспехи."

# game/data/characters/numa/dialogue.rpy:48
translate ru numa_moreaboutpeople_menu_b1ea096b:

    # MC @ think "Why would you need such things?"
    MC @ think "Зачем вам такие вещи?"

# game/data/characters/numa/dialogue.rpy:49
translate ru numa_moreaboutpeople_menu_93d5f8b3:

    # NUMA @ serious "... The waves are a turbulent thing."
    NUMA @ serious "... Волны — неспокойная стихия."

# game/data/characters/numa/dialogue.rpy:50
translate ru numa_moreaboutpeople_menu_088c241e:

    # NUMA @ talk "They turn towards war."
    NUMA @ talk "Они поворачиваются к войне."

# game/data/characters/numa/dialogue.rpy:51
translate ru numa_moreaboutpeople_menu_416963ed:

    # MC @ think "War? What war?"
    MC @ think "Война? Какая война?"

# game/data/characters/numa/dialogue.rpy:52
translate ru numa_moreaboutpeople_menu_7ed5d058:

    # NUMA @ talk "It matters not for you surface breathers."
    NUMA @ talk "Это не имеет значения для вас, дышащих воздухом."

# game/data/characters/numa/dialogue.rpy:53
translate ru numa_moreaboutpeople_menu_ad0fd71f:

    # NUMA @ talk "There are many fiefdoms vying for power below the currents."
    NUMA @ talk "Под течениями много феодальных владений, борющихся за власть."

# game/data/characters/numa/dialogue.rpy:54
translate ru numa_moreaboutpeople_menu_35287cb9:

    # NUMA @ talk "The senate-"
    NUMA @ talk "Сенат-"

# game/data/characters/numa/dialogue.rpy:55
translate ru numa_moreaboutpeople_menu_e906b857:

    # "She stopped herself, her lips curling into a forced smile."
    "Она остановилась, её губы изогнулись в вынужденную улыбку."

# game/data/characters/numa/dialogue.rpy:56
translate ru numa_moreaboutpeople_menu_24708383:

    # NUMA @ smile "Forgive me, your Thalvën is so good, I forgot myself for a moment."
    NUMA @ smile "Простите, ваш Тальвён так хорош, что я на мгновение забылась."

# game/data/characters/numa/dialogue.rpy:60
translate ru numa_moreaboutpeople_menu_f6a7145e:

    # NUMA @ talk "In order to maintain good relations with the merchants, a few of our Thalay kin were asked to work within the city."
    NUMA @ talk "Чтобы поддерживать хорошие отношения с купцами, некоторых из наших сородичей, Талай, попросили работать в городе."

# game/data/characters/numa/dialogue.rpy:61
translate ru numa_moreaboutpeople_menu_38f5e1d4:

    # NUMA @ talk "It is purely for diplomatic reasons, they even asked what role we would like."
    NUMA @ talk "Это исключительно по дипломатическим причинам, они даже спросили, какую роль мы бы хотели."

# game/data/characters/numa/dialogue.rpy:62
translate ru numa_moreaboutpeople_menu_dc0e7cd8:

    # NUMA @ smile "I asked to help run a library, so they had built this place to accomodate my needs."
    NUMA @ smile "Я попросила помогать управлять библиотекой, поэтому они построили это место, чтобы удовлетворить мои потребности."

# game/data/characters/numa/dialogue.rpy:63
translate ru numa_moreaboutpeople_menu_b4acba9f:

    # MC @ think "They built a whole library for you?"
    MC @ think "Они построили целую библиотеку для вас?"

# game/data/characters/numa/dialogue.rpy:64
translate ru numa_moreaboutpeople_menu_3fbd73b2:

    # NUMA @ talk "No, they built a whole library to keep my kin happy... I just happen to work within it."
    NUMA @ talk "Нет, они построили целую библиотеку, чтобы мои сородичи были довольны... Я просто случайно работаю в ней."

# game/data/characters/numa/dialogue.rpy:68
translate ru numa_moreaboutpeople_menu_32267830:

    # NUMA @ talk "Of course... It pleases me to be able to talk to one as clearly as you."
    NUMA @ talk "Конечно... Мне приятно иметь возможность говорить с кем-то так же ясно, как с вами."

# game/data/characters/numa/dialogue.rpy:73
translate ru numa_whatareyou_711b6f6a:

    # "Numa's eyelids blinked twice as she tilted her head once more."
    "Веки Нумы дважды моргнули, когда она снова склонила голову."

# game/data/characters/numa/dialogue.rpy:74
translate ru numa_whatareyou_38893e4f:

    # NUMA @ talk "How can one speak the wave so well and not know what we are?"
    NUMA @ talk "Как можно так хорошо говорить на волне и не знать, кто мы?"

# game/data/characters/numa/dialogue.rpy:75
translate ru numa_whatareyou_c79bb790:

    # MC @ think "It's... complicated."
    MC @ think "Это... сложно объяснить."

# game/data/characters/numa/dialogue.rpy:76
translate ru numa_whatareyou_7c8b810c:

    # NUMA @ talk "... I see."
    NUMA @ talk "... Понятно."

# game/data/characters/numa/dialogue.rpy:77
translate ru numa_whatareyou_53b96c9d:

    # NUMA @ talk "Then to answer your question, I am Thalay."
    NUMA @ talk "Тогда, отвечая на твой вопрос, я — Талай."

# game/data/characters/numa/dialogue.rpy:78
translate ru numa_whatareyou_09fc90be:

    # NUMA @ smile "I presume I may be one of the first, or perhaps THE first, of my kind you've seen since arriving in Hamun."
    NUMA @ smile "Полагаю, я могу быть одним из первых, а возможно и САМЫМ первым из моего рода, кого ты увидел с прибытия в Хамун."

# game/data/characters/numa/dialogue.rpy:79
translate ru numa_whatareyou_ec863f7f:

    # MC @ talk "Yes."
    MC @ talk "Да."

# game/data/characters/numa/dialogue.rpy:80
translate ru numa_whatareyou_12452374:

    # NUMA @ talk "Mmm... It is not surprising."
    NUMA @ talk "М-м... Это неудивительно."

# game/data/characters/numa/dialogue.rpy:81
translate ru numa_whatareyou_3fe64a20:

    # NUMA @ talk "Our people conduct only limited business with land breathers."
    NUMA @ talk "Наш народ ведёт лишь ограниченные дела с дышащими воздухом."

# game/data/characters/numa/dialogue.rpy:87
translate ru numa_talk_d20b5586:

    # NUMA @ smile "Greetings again, how may I help?"
    NUMA @ smile "Снова приветствую, чем могу помочь?"

# game/data/characters/numa/dialogue.rpy:92
translate ru numa_bye_aaff2ad9:

    # NUMA @ smile "Come back anytime... It pleases me to have someone I can actually speak the wave with."
    NUMA @ smile "Возвращайся в любое время... Мне приятно встретить того, с кем я действительно могу говорить на волне."

# game/data/characters/numa/dialogue.rpy:97
translate ru numa_firstmeet_2a75a3f6:

    # "Entering into the Hamun library was... an unusual sight."
    "Вход в библиотеку Хамуна был... необычным зрелищем."

# game/data/characters/numa/dialogue.rpy:98
translate ru numa_firstmeet_8bc35701:

    # "While the usual rows of books were neatly stacked up high as one would expect, a deep, decorated pool lay in the center of the library,"
    "Хотя обычные ряды книг были аккуратно сложены до самого верха как и следовало ожидать, в центре библиотеки лежал глубокий, украшенный бассейн,"

# game/data/characters/numa/dialogue.rpy:99
translate ru numa_firstmeet_7c9fd79f:

    # "Complete with a strange water fountain statue of what appeared to be a mage striking up a bargain with a strange fish like humanoid."
    "В комплекте со странным фонтаном в виде статуи, изображающей мага, заключающего сделку со странным гуманоидом, похожим на рыбу."

# game/data/characters/numa/dialogue.rpy:100
translate ru numa_firstmeet_6d119730:

    # "Looking around, I could see no one in the library."
    "Оглядевшись, я не увидел никого в библиотеке."

# game/data/characters/numa/dialogue.rpy:101
translate ru numa_firstmeet_27bb84f3:

    # MC @ think "Hello? Is anyone here?"
    MC @ think "Эй? Здесь есть кто-нибудь?"

# game/data/characters/numa/dialogue.rpy:102
translate ru numa_firstmeet_730a3730:

    # "A shadow appeared along waters of the pool, and in a moment, the blue skinned humanoid like woman emerged."
    "Над водой бассейна появилась тень, и через мгновение, из воды вышла голубокожая человекоподобная женщина."

# game/data/characters/numa/dialogue.rpy:105
translate ru numa_firstmeet_db1efe9f:

    # "Naked, and covered in scales as the water dripped from her body, the gilged creature turned it's gaze towards me."
    "Обнажённая, и покрытая чешуёй, с которой стекала вода, позолоченное существо обратило свой взгляд на меня."

# game/data/characters/numa/dialogue.rpy:106
translate ru numa_firstmeet_fe773dc3:

    # UNKNOWN "Lora'shen... Vaalra korril'neth, sollan?"
    UNKNOWN "Лора'шен... Ваалра коррил'нет, соллан?"

# game/data/characters/numa/dialogue.rpy:107
translate ru numa_firstmeet_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Что?"

# game/data/characters/numa/dialogue.rpy:108
translate ru numa_firstmeet_574271cf:

    # "The strange creature tilted it's head, before motioning towards the many books with it's hand."
    "Странное существо наклонило голову, а затем жестом руки указало на множество книг."

# game/data/characters/numa/dialogue.rpy:109
translate ru numa_firstmeet_ca45be32:

    # UNKNOWN "Ssharaa… Vellunaa shor'kai, raal ithen vashan…"
    UNKNOWN "Шшараа… Веллунаа шор'кай, раал итхен вашан…"

# game/data/characters/numa/dialogue.rpy:110
translate ru numa_firstmeet_cb8a202f:

    # MC @ talk "Sorry, I can't-"
    MC @ talk "Извини, я не могу-"

# game/data/characters/numa/dialogue.rpy:111
translate ru numa_firstmeet_606a8bfb:

    # BLACK "({i}Language analysis complete. Sub-acquatic species dialect ready for mimic and translation.{/i})"
    BLACK "({i}Анализ языка завершен. Диалект подводного вида готов к имитации и переводу.{/i})"

# game/data/characters/numa/dialogue.rpy:112
translate ru numa_firstmeet_8cf93702:

    # MC "(Wait, what?)"
    MC "(Подожди, чего?)"

# game/data/characters/numa/dialogue.rpy:113
translate ru numa_firstmeet_865cd248:

    # BLACK "({i}The echo quality to their voice relies on duplicated syllables and liquid-heavy phonemes like l,r,n and-{/i})"
    BLACK "({i}Эхо-эффект в их голосе достигается за счет удвоения слогов и жидкостных фонем, таких как л,р,н и-{/i})"

# game/data/characters/numa/dialogue.rpy:114
translate ru numa_firstmeet_06fd44e3:

    # MC "(What are you even-)"
    MC "(О чем ты вообще-)"

# game/data/characters/numa/dialogue.rpy:116
translate ru numa_firstmeet_21e16c80:

    # UNKNOWN @ angry "... You must be new here, surface-breather."
    UNKNOWN @ angry "... Ты, должно быть новичок здесь, поверхностно-дышащий."

# game/data/characters/numa/dialogue.rpy:117
translate ru numa_firstmeet_ddf856bd:

    # MC @ surprised "I can understand you!"
    MC @ surprised "Я понимаю тебя!"

# game/data/characters/numa/dialogue.rpy:118
translate ru numa_firstmeet_35fb6662:

    # "My reply to her, almost instinctively, was one I understood... {i}but it was not Alderian words which flowed from my lips.{/i}"
    "Мой ответ ей, почти инстинктивно, был тем что я понимал... {i}но это были не Алдереанские слова что полились с моих губ.{/i}"

# game/data/characters/numa/dialogue.rpy:119
translate ru numa_firstmeet_14312edc:

    # "The fish like woman seemed taken aback."
    "Рыбообразная женщина, кажется, была ошеломлена."

# game/data/characters/numa/dialogue.rpy:120
translate ru numa_firstmeet_02d8a1e7:

    # UNKNOWN @ surprised "... Your Thalvënn is excellent!"
    UNKNOWN @ surprised "... Ваш Тальвенн превосходен!"

# game/data/characters/numa/dialogue.rpy:121
translate ru numa_firstmeet_a4eeee01:

    # UNKNOWN @ smile "I don't think I've ever heard a surface breather speak the wave so clearly!"
    UNKNOWN @ smile "Не думаю, что когда-либо слышала, чтобы дышащий поверхностью говорил на волне так ясно!"

# game/data/characters/numa/dialogue.rpy:122
translate ru numa_firstmeet_af35acdf:

    # MC "(How did you-)"
    MC "(Как ты-)"

# game/data/characters/numa/dialogue.rpy:123
translate ru numa_firstmeet_2c8c109d:

    # BLACK "(The same way I learned your tongue.)"
    BLACK "(Так же, как я выучил и ваш язык.)"

# game/data/characters/numa/dialogue.rpy:124
translate ru numa_firstmeet_b10ec70e:

    # BLACK "(By adapting.)"
    BLACK "(Адаптируясь.)"

# game/data/characters/numa/dialogue.rpy:125
translate ru numa_firstmeet_a82d45bc:

    # UNKNOWN "Are you well?"
    UNKNOWN "Вы в порядке?"

# game/data/characters/numa/dialogue.rpy:126
translate ru numa_firstmeet_4d3ad600:

    # UNKNOWN "Your mind seems adrift."
    UNKNOWN "Ваш разум, кажется, отплыл."

# game/data/characters/numa/dialogue.rpy:128
translate ru numa_firstmeet_cd4486e0:

    # MC @ talk "Sorry, I was just lost in thought a moment."
    MC @ talk "Извините, я просто на мгновение погрузился в мысли."

# game/data/characters/numa/dialogue.rpy:129
translate ru numa_firstmeet_ffd9b202:

    # NUMA @ smile "I am Numa."
    NUMA @ smile "Я Нума."

# game/data/characters/numa/dialogue.rpy:161
translate ru numa_firstmeet_e3698fca:

    # MC @ smile "[player_name!t]."
    MC @ smile "[player_name!t]."

# game/data/characters/numa/dialogue.rpy:162
translate ru numa_firstmeet_2ebb1ff3:

    # NUMA @ smile "How may I help you today, [player_name!t]?"
    NUMA @ smile "Чем я могу помочь вам сегодня, [player_name!t]?"

# game/data/characters/numa/dialogue.rpy:136
translate ru numa_somebooks_d05e8401:

    # NUMA @ talk "There are many books here available."
    NUMA @ talk "Здесь доступно множество книг."

# game/data/characters/numa/dialogue.rpy:137
translate ru numa_somebooks_e1d6e861:

    # NUMA @ talk "I have found you surface breather's cultures... most interesting."
    NUMA @ talk "Я нахожу культуру, вас, дышащих воздухом... весьма интересной."

translate ru strings:

    # game/data/characters/numa/dialogue.rpy:12
    old "I hate to ask but... What are you?"
    new "Не хотелось бы спрашивать, но... Что вы такое?"

    # game/data/characters/numa/dialogue.rpy:15
    old "I'd like to look at some books."
    new "Я хотел бы посмотреть некоторые книги."

    # game/data/characters/numa/dialogue.rpy:17
    old "Can you tell me more about your people?"
    new "Можете рассказать больше о вашем народе?"

    # game/data/characters/numa/dialogue.rpy:30
    old "Talk to Numa"
    new "Поговорить с Нумой"

    # game/data/characters/numa/dialogue.rpy:33
    old "Bookshelves"
    new "Книжные полки"

    # game/data/characters/numa/dialogue.rpy:44
    old "Your people... What do you do here in Hamun?"
    new "Ваш народ... Чем вы занимаетесь здесь, в Хамуне?"

    # game/data/characters/numa/dialogue.rpy:59
    old "Why are you working in a library?"
    new "Почему вы работаете в библиотеке?"

    # game/data/characters/numa/dialogue.rpy:67
    old "That's all the questions I have for now."
    new "На этом у меня пока все вопросы."

# game/data/characters/numa/dialogue.rpy:119
translate ru numa_books_trade_e8d2f9b6:

    # NUMA @ talk "Okay."
    NUMA @ talk "Хорошо."

# game/data/characters/numa/dialogue.rpy:120
translate ru numa_books_trade_b1ba029d:

    # NUMA @ talk "Let's take a look then..."
    NUMA @ talk "Давай посмотрим тогда..."

# game/data/characters/numa/dialogue.rpy:122
translate ru numa_books_trade_c787f2b4:

    # NUMA @ talk "Is there anything else?"
    NUMA @ talk "Что-нибудь еще?"

translate ru strings:

    # game/data/characters/numa/dialogue.rpy:30
    old "I have books to trade."
    new "У меня есть книги для обмена."

