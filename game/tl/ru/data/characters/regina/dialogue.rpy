# game/data/characters/regina/dialogue.rpy:29
translate ru regina_talk_55b8a330:

    # REGINA @ talk "Ah! There you are!"
    REGINA @ talk "Ах! Вот и ты!"

# game/data/characters/regina/dialogue.rpy:37
translate ru regina_askAllRight_5d1257bc:

    # REGINA @ talk "Hm? Everything’s fine, dear! "
    REGINA @ talk "Хм? Всё в порядке, дорогой!"

# game/data/characters/regina/dialogue.rpy:39
translate ru regina_askAllRight_a71bc698:

    # REGINA @ talk "I’m just about to put some food on, will you be staying long?"
    REGINA @ talk "Я как раз собираюсь приготовить еду, ты надолго задержишься?"

# game/data/characters/regina/dialogue.rpy:41
translate ru regina_askAllRight_18a361e9:

    # REGINA @ talk "That Town Crier is still ranting about how Newheart will save us all... Doesn’t he ever give up?"
    REGINA @ talk "Тот городской глашатай всё ещё разглагольствует о том как Ньюхарт спасёт нас всех... Он что, никогда не сдаётся?"

# game/data/characters/regina/dialogue.rpy:43
translate ru regina_askAllRight_673ae436:

    # REGINA @ talk "Have you been to a temple recently? It might be a good idea to receive some blessings from the Gods after what’s happened..."
    REGINA @ talk "Ты недавно был в храме? Возможно, стоит получить благословение богов после всего случившегося..."

# game/data/characters/regina/dialogue.rpy:47
translate ru regina_askSubMenu_1c73d4db:

    # REGINA @ talk "What do you want to ask?"
    REGINA @ talk "О чём ты хочешь спросить?"

# game/data/characters/regina/dialogue.rpy:51
translate ru regina_askFather_f4aa87d5:

    # REGINA @ talk "Yes, apparently he’s working on some kind of excavation, with Lord Psydon’s blessing..."
    REGINA @ talk "Да, по-видимому, он работает над какими-то раскопками с благословения Лорда Псидона..."

# game/data/characters/regina/dialogue.rpy:52
translate ru regina_askFather_b0926daa:

    # REGINA @ talk "No idea what it’s all about but he’s alright, dear."
    REGINA @ talk "Понятия не имею что это такое, но он в порядке, дорогой."

# game/data/characters/regina/dialogue.rpy:56
translate ru regina_askErika_e28593af:

    # REGINA @ talk "Erika is just fine, like I said, she’s off galivanting around with those Inquisitors doing God only knows what."
    REGINA @ talk "Эрика в полном порядке, как я и говорила, она разъезжает повсюду с теми инквизиторами, занимаясь Бог знает чем."

# game/data/characters/regina/dialogue.rpy:57
translate ru regina_askErika_3b7377a3:

    # MC @ talk "That’s all you know?"
    MC @ talk "Это всё что ты знаешь?"

# game/data/characters/regina/dialogue.rpy:58
translate ru regina_askErika_dbb029de:

    # REGINA @ talk "I’m afraid she doesn’t share much else, not even with me."
    REGINA @ talk "Боюсь, она больше ничем не делится, даже со мной."

# game/data/characters/regina/dialogue.rpy:59
translate ru regina_askErika_5c391be4:

    # REGINA @ talk "Very top secret and all that. "
    REGINA @ talk "Совершенно секретно и всё такое."

# game/data/characters/regina/dialogue.rpy:63
translate ru regina_askAdara_43aee9c0:

    # REGINA @ talk "Oh yes, you should see her if you haven’t already."
    REGINA @ talk "Ах да, тебе стоит её навестить, если ещё не был."

# game/data/characters/regina/dialogue.rpy:64
translate ru regina_askAdara_d7388496:

    # REGINA @ talk "The girl has been quite frantic without you."
    REGINA @ talk "Девушка была в полной панике без тебя."

# game/data/characters/regina/dialogue.rpy:65
translate ru regina_askAdara_1e36f099:

    # REGINA @ talk "And maybe just a tad bit annoying..."
    REGINA @ talk "И может, немного надоедливой..."

# game/data/characters/regina/dialogue.rpy:62
translate ru regina_askAdara_cdfb6f3a:

    # MC @ talk "[regina_ref_cap!t]!"
    MC @ talk "[regina_ref_cap!t]!"

# game/data/characters/regina/dialogue.rpy:67
translate ru regina_askAdara_3d2ba6aa:

    # REGINA @ talk "What? She came by ALL the time, it was sweet, but it got old after the hundredth time..."
    REGINA @ talk "Что? Она заходила ПОСТОЯННО, это было мило, но надоело после сотого раза..."

# game/data/characters/regina/dialogue.rpy:71
translate ru regina_goodbye_3cf37582:

    # REGINA @ talk "Be safe!"
    REGINA @ talk "Береги себя!"

