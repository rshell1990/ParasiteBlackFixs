# game/data/characters/serafina/dialogue.rpy:22
translate ru talk_serafina_5389b536:

    # SERAFINA @ smile "Oh, have you come to see me, or...?"
    SERAFINA @ smile "Оу, ты пришёл навестить меня, или...?"

# game/data/characters/serafina/dialogue.rpy:27
translate ru talk_serafina_training_94a619e3:

    # SERAFINA @ talk "As well as it can, I suppose."
    SERAFINA @ talk "Настолько хорошо, насколько это возможно, полагаю."

# game/data/characters/serafina/dialogue.rpy:28
translate ru talk_serafina_training_6ffa521c:

    # SERAFINA @ talk "Virgo is a strict instructor, but I know he means well."
    SERAFINA @ talk "Вирго строгий наставник, но я знаю, что он желает мне добра."

# game/data/characters/serafina/dialogue.rpy:29
translate ru talk_serafina_training_71f3de73:

    # MC @ think "And the magecraft he teaches you... is it—"
    MC @ think "И магия, которой он тебя обучает... она—"

# game/data/characters/serafina/dialogue.rpy:30
translate ru talk_serafina_training_6aaef64c:

    # SERAFINA @ smile "{i}Powerful.{/i}"
    SERAFINA @ smile "{i}Сильная.{/i}"

# game/data/characters/serafina/dialogue.rpy:31
translate ru talk_serafina_training_f3f67cf2:

    # SERAFINA @ talk "But it's also kind of terrifying."
    SERAFINA @ talk "Но она также немного пугает."

# game/data/characters/serafina/dialogue.rpy:32
translate ru talk_serafina_training_b99aeecf:

    # SERAFINA @ talk "I have taken some private lessons before on magecraft."
    SERAFINA @ talk "Я раньше уже брала некие частные уроки по магии."

# game/data/characters/serafina/dialogue.rpy:33
translate ru talk_serafina_training_ed0b2156:

    # SERAFINA @ surprised "But this is like a whole different world."
    SERAFINA @ surprised "Но вот это, словно совсем другой мир."

# game/data/characters/serafina/dialogue.rpy:34
translate ru talk_serafina_training_cd8bbe04:

    # MC @ serious "Be careful, Serafina. Many a mage has said the same thing,"
    MC @ serious "Будь осторожна, Серафина. Многие маги говорили то же самое,"

# game/data/characters/serafina/dialogue.rpy:35
translate ru talk_serafina_training_34d9062b:

    # MC @ serious "only to come undone by the madness of digging too deep."
    MC @ serious "а потом были сломлены безумием, копая слишком глубоко."

# game/data/characters/serafina/dialogue.rpy:36
translate ru talk_serafina_training_bf7b05d4:

    # SERAFINA @ smile "Don't worry, I'll be safe!"
    SERAFINA @ smile "Не волнуйся, я буду осторожна!"

# game/data/characters/serafina/dialogue.rpy:40
translate ru talk_serafina_father_063c3e47:

    # SERAFINA @ sad "No..."
    SERAFINA @ sad "Нет..."

# game/data/characters/serafina/dialogue.rpy:41
translate ru talk_serafina_father_35b4e32d:

    # SERAFINA @ sad "But now I know where he might receive my letters, so I'm still going to try."
    SERAFINA @ sad "Но теперь я знаю, куда можно отправить ему письма, поэтому я всё равно попробую."

# game/data/characters/serafina/dialogue.rpy:42
translate ru talk_serafina_father_38d3fa5a:

    # SERAFINA @ sad "I just hope he understands why I made the choice I did."
    SERAFINA @ sad "Я просто надеюсь что он поймёт, почему я сделала такой выбор."

# game/data/characters/serafina/dialogue.rpy:46
translate ru talk_serafina_wives_8ee34734:

    # SERAFINA @ sad "{i}*Sigh*{/i} I learned a long time ago about their... {i}tastes.{/i}"
    SERAFINA @ sad "{i}*Вздох*{/i} Я узнала уже очень давно об этих их... {i}вкусах.{/i}"

# game/data/characters/serafina/dialogue.rpy:47
translate ru talk_serafina_wives_8299d0af:

    # SERAFINA @ talk "They aren't exactly subtle about it."
    SERAFINA @ talk "Они и не особо это скрывают."

# game/data/characters/serafina/dialogue.rpy:48
translate ru talk_serafina_wives_1a5c91b5:

    # SERAFINA @ talk "But they do care for me a great deal."
    SERAFINA @ talk "Но они очень заботятся обо мне."

# game/data/characters/serafina/dialogue.rpy:49
translate ru talk_serafina_wives_d0edb860:

    # SERAFINA @ talk "Just don't make things difficult for them, alright?"
    SERAFINA @ talk "Просто не усложняй им жизнь, ладно?"

# game/data/characters/serafina/dialogue.rpy:50
translate ru talk_serafina_wives_8bc6c1f2:

    # SERAFINA @ talk "Chanyi may act strong, but she's more sensitive than she lets on."
    SERAFINA @ talk "Чаньи может казаться сильной, но на самом деле она гораздо чувствительнее, чем выглядит."

# game/data/characters/serafina/dialogue.rpy:51
translate ru talk_serafina_wives_c8f7cec7:

    # SERAFINA @ think "And mother is just... well... mother."
    SERAFINA @ think "А мама просто... ну-у... мама."

# game/data/characters/serafina/dialogue.rpy:55
translate ru talk_serafina_bye_bdb817ba:

    # SERAFINA @ smile "Alright then."
    SERAFINA @ smile "Хорошо тогда."

# game/data/characters/serafina/dialogue.rpy:63
translate ru talk_virgo_e35d5f7e:

    # VIRGO "Greetings."
    VIRGO "Приветствую."

# game/data/characters/serafina/dialogue.rpy:66
translate ru talk_virgo_menu_9a8f3997:

    # VIRGO "The girl is a prodigy."
    VIRGO "Девочка — настоящее дарование."

# game/data/characters/serafina/dialogue.rpy:67
translate ru talk_virgo_menu_197001cc:

    # VIRGO "Even if she doesn't understand it yet."
    VIRGO "Даже если она пока этого не понимает."

# game/data/characters/serafina/dialogue.rpy:68
translate ru talk_virgo_menu_9da465ac:

    # VIRGO "She will make an excellent mage one day."
    VIRGO "Однажды, она станет превосходным магом."

# game/data/characters/serafina/dialogue.rpy:69
translate ru talk_virgo_menu_b90b4597:

    # MC @ think "What kind of mage?"
    MC @ think "Каким именно магом?"

# game/data/characters/serafina/dialogue.rpy:70
translate ru talk_virgo_menu_88c6c0b7:

    # VIRGO "One where her talents are not wasted..."
    VIRGO "Таким, в котором её таланты не пропадут даром..."

# game/data/characters/serafina/dialogue.rpy:73
translate ru talk_virgo_menu_da6cf2b8:

    # VIRGO "Until we meet again then."
    VIRGO "Тогда до следующей встречи."

