
# game/data/characters/thea/dialogue.rpy:29
translate ru nov_thea_talk_5f6496d4:

    # THEA @ smile "Oh hey! Can I help you with something?"
    THEA @ smile "Оу, привет! Могу я чем-то помочь?"

# game/data/characters/thea/dialogue.rpy:34
translate ru nov_thea_bye_9e54ad83:

    # THEA @ talk "Alright, see ya around!"
    THEA @ talk "Ладно, увидимся!"

# game/data/characters/thea/dialogue.rpy:35
translate ru nov_thea_bye_d20135b7:

    # THEA @ smile "Good luck on your adventures!"
    THEA @ smile "Удачи в твоих приключениях!"

# game/data/characters/thea/dialogue.rpy:39
translate ru nov_thea_adv_questions_1a2ee70f:

    # THEA @ talk "Ask away."
    THEA @ talk "Спрашивай."

# game/data/characters/thea/dialogue.rpy:42
translate ru nov_thea_adv_questions_menu_bbc22857:

    # THEA @ talk "Over on the board over there is our list of current jobs needing to be done."
    THEA @ talk "На той доске вон там — наш список текущих заданий, которые нужно выполнить."

# game/data/characters/thea/dialogue.rpy:43
translate ru nov_thea_adv_questions_menu_0ab4d2cb:

    # THEA @ talk "Just select the one you want, and we'll handle the paperwork while you get to work."
    THEA @ talk "Просто выбери то что хочешь, а мы оформим бумаги, пока ты приступишь к работе."

# game/data/characters/thea/dialogue.rpy:44
translate ru nov_thea_adv_questions_menu_e0200cc9:

    # THEA @ talk "Remember though, you can only choose a quest within your rank as an adventurer."
    THEA @ talk "Но помни: ты можешь выбрать только квест, соответствующий твоему рангу авантюриста."

# game/data/characters/thea/dialogue.rpy:47
translate ru nov_thea_adv_questions_menu_d0988ac6:

    # THEA @ talk "It's important to understand how the ranking works."
    THEA @ talk "Важно понимать, как работает система рангов."

# game/data/characters/thea/dialogue.rpy:48
translate ru nov_thea_adv_questions_menu_a160af5e:

    # THEA @ talk "All beginner adventurers are ranked as D-listers."
    THEA @ talk "Все начинающие авантюристы имеют ранг D-листа."

# game/data/characters/thea/dialogue.rpy:49
translate ru nov_thea_adv_questions_menu_691c77f1:

    # THEA @ talk "These are the most straightforward and simple quests available to any adventurer."
    THEA @ talk "Это самые простые и незамысловатые квесты, доступные любому авантюристу."

# game/data/characters/thea/dialogue.rpy:50
translate ru nov_thea_adv_questions_menu_359a935e:

    # THEA @ talk "Ranking progresses from D-tier all the way to S-Tier, the rank of legendary adventurers."
    THEA @ talk "Ранги прогрессируют от D-уровня до S-уровня — уровня легендарных искателей приключений."

# game/data/characters/thea/dialogue.rpy:51
translate ru nov_thea_adv_questions_menu_71f3b316:

    # THEA @ talk "Of course, as the danger and difficulty of the quests increase each rank, so does the rewards to compensate."
    THEA @ talk "Конечно, с каждым рангом опасность и сложность заданий возрастают, но и награды увеличиваются соответственно."

# game/data/characters/thea/dialogue.rpy:54
translate ru nov_thea_adv_questions_menu_9ae80558:

    # THEA @ talk "There's a set number of quests per rank that will need to be completed a minimum of at least once."
    THEA @ talk "Для каждого ранга установлено определённое количество заданий, которые нужно выполнить как минимум один раз."

# game/data/characters/thea/dialogue.rpy:55
translate ru nov_thea_adv_questions_menu_42fcd1da:

    # THEA @ talk "After you've beaten your ranks guild quests, a special one-time quest will open up that once you've completed, your rank will increase."
    THEA @ talk "После того как ты выполнишь задания гильдии своего ранга, откроется специальное разовое задание, и после его завершения твой ранг повысится."

# game/data/characters/thea/dialogue.rpy:56
translate ru nov_thea_adv_questions_menu_0b3f27c1:

    # THEA @ talk "Oh ... And don't worry about running out of quests."
    THEA @ talk "Оу... И не беспокойся о том, что задания закончатся."

# game/data/characters/thea/dialogue.rpy:57
translate ru nov_thea_adv_questions_menu_003922e8:

    # THEA @ talk "Outside of the special guild quests, most guild quests are usually full time occupations in themselves, you'll be able to re-do those quests as many times as you like."
    THEA @ talk "Помимо специальных заданий гильдии, большинство заданий гильдии обычно являются полноценной работой сами по себе, и ты сможешь перепроходить эти задания сколько угодно раз."

# game/data/characters/thea/dialogue.rpy:60
translate ru nov_thea_adv_questions_menu_fa5b1639:

    # THEA @ talk "Sure, was there anything else?"
    THEA @ talk "Конечно, есть что-то ещё?"

# game/data/characters/thea/dialogue.rpy:64
translate ru nov_thea_adv_questions_notAdventurer_dff28a07:

    # THEA @ talk "Sorry, but I don't remember you being an adventurer."
    THEA @ talk "Извини, но я не помню чтобы ты был искателем приключений."

# game/data/characters/thea/dialogue.rpy:65
translate ru nov_thea_adv_questions_notAdventurer_4a075af6:

    # MC "What do you mean?"
    MC "Что вы имеете в виду?"

# game/data/characters/thea/dialogue.rpy:66
translate ru nov_thea_adv_questions_notAdventurer_bd5ff809:

    # THEA @ talk "Well, you can get yourself a drink or something, but I can't waste my time explaining the inner workings of the guild to you."
    THEA @ talk "Ну, ты можешь взять себе выпить или что-то в этом роде, но я не могу тратить время на объяснение внутренней работы гильдии тебе."

# game/data/characters/thea/dialogue.rpy:67
translate ru nov_thea_adv_questions_notAdventurer_e1770810:

    # MC "Can I become an adventurer?"
    MC "Могу ли я стать искателем приключений?"

# game/data/characters/thea/dialogue.rpy:68
translate ru nov_thea_adv_questions_notAdventurer_416abe62:

    # "Thea let out a quiet sigh..."
    "Тея тихо вздохнула..."

# game/data/characters/thea/dialogue.rpy:69
translate ru nov_thea_adv_questions_notAdventurer_e5da05a6:

    # THEA @ talk "That's a three-hundred fifty-something time I've been asked this."
    THEA @ talk "Это уже примерно триста пятьдесят какой-то раз, когда меня об этом спрашивают."

# game/data/characters/thea/dialogue.rpy:70
translate ru nov_thea_adv_questions_notAdventurer_811a066b:

    # THEA @ talk "Have you reached your Terminus yet?"
    THEA @ talk "Ты уже достиг своего Терминуса?"

# game/data/characters/thea/dialogue.rpy:71
translate ru nov_thea_adv_questions_notAdventurer_5d73558e:

    # "I swallowed hard."
    "Я сглотнул."

# game/data/characters/thea/dialogue.rpy:72
translate ru nov_thea_adv_questions_notAdventurer_7b56f981:

    # MC "Y-yeah."
    MC "Д-Да."

# game/data/characters/thea/dialogue.rpy:73
translate ru nov_thea_adv_questions_notAdventurer_2da5a787:

    # THEA @ talk "You did? Well, that is how you become an adventurer, you're {i}assigned{/i} this role at your Terminus."
    THEA @ talk "Правда? Что ж, именно так и становятся искателями приключений — тебе {i}назначают{/i} эту роль на Терминусе."

# game/data/characters/thea/dialogue.rpy:74
translate ru nov_thea_adv_questions_notAdventurer_fe9f792d:

    # THEA @ talk "What role did the kingdom bestow upon you?"
    THEA @ talk "Какую роль тебе даровало королевство?"

# game/data/characters/thea/dialogue.rpy:75
translate ru nov_thea_adv_questions_notAdventurer_522de8a4:

    # MC "(Cannon fodder.)"
    MC "(Пушечное мясо.)"

# game/data/characters/thea/dialogue.rpy:76
translate ru nov_thea_adv_questions_notAdventurer_e8f39a65:

    # MC "I... I should go."
    MC "Я... Мне пора идти."

# game/data/characters/thea/dialogue.rpy:77
translate ru nov_thea_adv_questions_notAdventurer_4349caf7:

    # "Thea raised an eyebrow."
    "Тея приподняла бровь."

# game/data/characters/thea/dialogue.rpy:78
translate ru nov_thea_adv_questions_notAdventurer_d34359c3:

    # THEA @ talk "Okay, safe travels then!"
    THEA @ talk "Ладно, тогда счастливого пути!"

# game/data/characters/thea/dialogue.rpy:80
translate ru nov_thea_adv_questions_notAdventurer_bfd46478:

    # MC "I should get to the fort now."
    MC "Мне пора в форт."

# game/data/characters/thea/dialogue.rpy:85
translate ru nov_thea_drink_4968c955:

    # THEA @ talk "Improve your standing at the guild and maybe we'll talk."
    THEA @ talk "Улучши свою репутацию в гильдии, и возможно мы поговорим."

# game/data/characters/thea/dialogue.rpy:89
translate ru nov_thea_drink_8bb85580:

    # THEA @ smile "I hope you don't think you're the first one to try that."
    THEA @ smile "Надеюсь, ты не думаешь что ты первый, кто попробовал это."

# game/data/characters/thea/dialogue.rpy:90
translate ru nov_thea_drink_cef616c3:

    # MC @ smile "I was hoping I'd be the first one you'd say yes to."
    MC @ smile "Я надеялся что я буду первым, кому ты скажешь да."

# game/data/characters/thea/dialogue.rpy:91
translate ru nov_thea_drink_af5adb3e:

    # THEA @ talk "Hmm, well, I'll think about it ..."
    THEA @ talk "Хмм, что ж, я подумаю об этом..."

# game/data/characters/thea/dialogue.rpy:92
translate ru nov_thea_drink_4d231e9b:

    # THEA @ talk "I'm sure you're used to girls just falling into your lap, but it takes a little more than that to get me interested."
    THEA @ talk "Я уверена ты привык, что девушки сами падают тебе в руки, но чтобы заинтересовать меня, нужно немного больше."

# game/data/characters/thea/dialogue.rpy:93
translate ru nov_thea_drink_e9545907:

    # MC @ smile "Oh?"
    MC @ smile "Ооо?"

# game/data/characters/thea/dialogue.rpy:94
translate ru nov_thea_drink_08d238b8:

    # THEA @ smile "{i}I wanna see what you can do.{/i}"
    THEA @ smile "{i}Хочу посмотреть, на что ты способен.{/i}"

# game/data/characters/thea/dialogue.rpy:95
translate ru nov_thea_drink_fb6bc2c6:

    # MC @ think "What I can do?"
    MC @ think "Что я могу делать?"

# game/data/characters/thea/dialogue.rpy:96
translate ru nov_thea_drink_95135937:

    # THEA @ smile "Here, {i}at this guild.{/i}"
    THEA @ smile "Здесь, {i}в этой гильдии.{/i}"

# game/data/characters/thea/dialogue.rpy:97
translate ru nov_thea_drink_306fe303:

    # THEA @ smile2 "There's something about this place that just-"
    THEA @ smile2 "В этом месте есть что-то, что просто-"

# game/data/characters/thea/dialogue.rpy:98
translate ru nov_thea_drink_c7bdae38:

    # THEA @ smile "Mmm ... Better not think too hard on it, need to stay focused for work."
    THEA @ smile "Ммм... Лучше не думать об этом слишком много, нужно сосредоточиться на работе."

# game/data/characters/thea/dialogue.rpy:99
translate ru nov_thea_drink_ef2975b7:

    # MC @ talk "So, you've got a thing for Adventurers then?"
    MC @ talk "Так, у тебя слабость к Искателям приключений?"

# game/data/characters/thea/dialogue.rpy:100
translate ru nov_thea_drink_79a5953f:

    # THEA @ smile2 "A-Ah...Maybe a little?"
    THEA @ smile2 "А-Ах... Может быть, немного?"

# game/data/characters/thea/dialogue.rpy:101
translate ru nov_thea_drink_c0c81c71:

    # THEA @ smile "But not just any adventurer walking in off the street, one whose metal has been seriously proven."
    THEA @ smile "Но не к любому искателю приключений зашедшему с улицы, а к тому, чья сталь была серьёзно испытана."

# game/data/characters/thea/dialogue.rpy:102
translate ru nov_thea_drink_211b3ff7:

    # THEA @ blush "Think you've got what it takes?"
    THEA @ blush "Думаешь у тебя есть то что нужно?"

# game/data/characters/thea/dialogue.rpy:103
translate ru nov_thea_drink_8ba32743:

    # MC @ talk "I guess we'll see, won't we?"
    MC @ talk "Полагаю мы увидим, не так ли?"

translate ru strings:

    # game/data/characters/thea/dialogue.rpy:15
    old "Talk to Thea"
    new "Поговорить с Теей"

    # game/data/characters/thea/dialogue.rpy:21
