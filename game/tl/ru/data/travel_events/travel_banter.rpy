# game/data/travel_events/travel_banter.rpy:38
translate ru travelmodebanter_map_elena_mc_1_1d4d5faf:

    # ELENA @ talk "Have you ever thought about leaving Alderay?"
    ELENA @ talk "Ты когда-нибудь думал о том, чтобы покинуть Алдерей?"

# game/data/travel_events/travel_banter.rpy:39
translate ru travelmodebanter_map_elena_mc_1_4a2613e4:

    # MC @ think "Where'd that come from?"
    MC @ think "Откуда такой вопрос?"

# game/data/travel_events/travel_banter.rpy:40
translate ru travelmodebanter_map_elena_mc_1_9828a89f:

    # ELENA @ talk "Just... curiosity."
    ELENA @ talk "Просто... из любопытства."

# game/data/travel_events/travel_banter.rpy:41
translate ru travelmodebanter_map_elena_mc_1_e722756d:

    # ELENA @ talk "Growing up at Thornfalls, I dreamt of faraway places and adventures."
    ELENA @ talk "Взрослея у Торнфоллов, я мечтала о далёких местах и приключениях."

# game/data/travel_events/travel_banter.rpy:42
translate ru travelmodebanter_map_elena_mc_1_6308ffa5:

    # ELENA @ smile "It seems silly now, but... I still think about the places I want to see."
    ELENA @ smile "Сейчас это кажется глупым, но... я всё ещё думаю о местах, которые хочу увидеть."

# game/data/travel_events/travel_banter.rpy:45
translate ru travelmodebanter_map_elena_mc_1_96b1d0a3:

    # ELENA @ shock "Just like that?"
    ELENA @ shock "И всё? Просто так?"

# game/data/travel_events/travel_banter.rpy:46
translate ru travelmodebanter_map_elena_mc_1_bb7eda56:

    # MC @ smile "There's a whole world out there."
    MC @ smile "Там, снаружи, целый мир."

# game/data/travel_events/travel_banter.rpy:47
translate ru travelmodebanter_map_elena_mc_1_c579fce3:

    # ELENA @ smile "And would there be room for one more?"
    ELENA @ smile "И найдётся ли в нём место ещё для одного?"

# game/data/travel_events/travel_banter.rpy:48
translate ru travelmodebanter_map_elena_mc_1_6bc977b7:

    # MC @ smile2 "I'm sure I could fit you in."
    MC @ smile2 "Уверен, я смогу тебя пристроить."

# game/data/travel_events/travel_banter.rpy:49
translate ru travelmodebanter_map_elena_mc_1_5b4dee46:

    # ELENA @ smile "I must admit, I'm surprised."
    ELENA @ smile "Должна признать, я удивлена."

# game/data/travel_events/travel_banter.rpy:50
translate ru travelmodebanter_map_elena_mc_1_082ad89d:

    # ELENA @ smile "Markus told me all you two wanted was a quiet life behind palace walls."
    ELENA @ smile "Маркус говорил мне, что вы оба хотели только тихой жизни за дворцовыми стенами."

# game/data/travel_events/travel_banter.rpy:51
translate ru travelmodebanter_map_elena_mc_1_0d739712:

    # MC @ talk "Funny, isn't it?"
    MC @ talk "Странно, не правда ли?"

# game/data/travel_events/travel_banter.rpy:52
translate ru travelmodebanter_map_elena_mc_1_995149d2:

    # MC @ talk "That dream started feeling more like a cage after... everything."
    MC @ talk "Эта мечта начала казаться больше клеткой после... всего."

# game/data/travel_events/travel_banter.rpy:53
translate ru travelmodebanter_map_elena_mc_1_e5753e06:

    # ELENA @ smile "No. Not strange at all. Not to me."
    ELENA @ smile "Нет. Совсем не странно. По крайней мере, для меня."

# game/data/travel_events/travel_banter.rpy:55
translate ru travelmodebanter_map_elena_mc_1_19758ec6:

    # ELENA @ talk "Ahh, you seem more like a homebody."
    ELENA @ talk "Ахх, вы кажетесь больше домоседами."

# game/data/travel_events/travel_banter.rpy:56
translate ru travelmodebanter_map_elena_mc_1_b3517fc1:

    # MC @ think "Oh?"
    MC @ think "Оу?"

# game/data/travel_events/travel_banter.rpy:57
translate ru travelmodebanter_map_elena_mc_1_01b971be:

    # ELENA @ grumpy "You and Markus dreamed of royal service, didn't you?"
    ELENA @ grumpy "Вы с Маркусом мечтали о службе при дворе, верно?"

# game/data/travel_events/travel_banter.rpy:58
translate ru travelmodebanter_map_elena_mc_1_6204f33e:

    # ELENA @ smile "Not exactly an adventurous life."
    ELENA @ smile "Не самая полная приключений жизнь."

# game/data/travel_events/travel_banter.rpy:59
translate ru travelmodebanter_map_elena_mc_1_ab966d56:

    # MC @ talk "Is wanting a quiet life so wrong?"
    MC @ talk "Разве желание тихой жизни, это так уж неправильно?"

# game/data/travel_events/travel_banter.rpy:60
translate ru travelmodebanter_map_elena_mc_1_4ca3d53f:

    # ELENA @ smile "Not at all."
    ELENA @ smile "Вовсе нет."

# game/data/travel_events/travel_banter.rpy:61
translate ru travelmodebanter_map_elena_mc_1_b2753dd2:

    # ELENA @ smile "It's your life to live."
    ELENA @ smile "Это твоя жизнь, и ты её проживаешь."

# game/data/travel_events/travel_banter.rpy:62
translate ru travelmodebanter_map_elena_mc_1_cdd397f7:

    # MC @ think "{i}... And when this war is one day over.{/i}"
    MC @ think "{i}... И когда эта война однажды закончится.{/i}"

# game/data/travel_events/travel_banter.rpy:63
translate ru travelmodebanter_map_elena_mc_1_1cfe520f:

    # MC @ think "{i}Is it a life you'd want to be a part of?{/i}"
    MC @ think "{i}Захочешь ли ты быть частью такой жизни?{/i}"

# game/data/travel_events/travel_banter.rpy:64
translate ru travelmodebanter_map_elena_mc_1_4c9bb63b:

    # ELENA @ lewd "L-Let's leave that question for another day."
    ELENA @ lewd "Д-Давай оставим этот вопрос на другой день."

# game/data/travel_events/travel_banter.rpy:74
translate ru travelmodebanter_map_elena_mc_2_dfcc99a2:

    # ELENA @ grumpy "...Does it hurt?"
    ELENA @ grumpy "...Тебе больно?"

# game/data/travel_events/travel_banter.rpy:76
translate ru travelmodebanter_map_elena_mc_2_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Что?"

# game/data/travel_events/travel_banter.rpy:77
translate ru travelmodebanter_map_elena_mc_2_4b60e47a:

    # ELENA @ grumpy "When you change into that thing... does it hurt?"
    ELENA @ grumpy "Когда ты превращаешься в это существо... тебе больно?"

# game/data/travel_events/travel_banter.rpy:78
translate ru travelmodebanter_map_elena_mc_2_3496abfa:

    # MC @ talk "It... did. At first."
    MC @ talk "Это... да. По началу."

# game/data/travel_events/travel_banter.rpy:80
translate ru travelmodebanter_map_elena_mc_2_0a297aba:

    # MC @ talk "It was agony."
    MC @ talk "Это была агония."

# game/data/travel_events/travel_banter.rpy:81
translate ru travelmodebanter_map_elena_mc_2_54e3ddd7:

    # MC @ talk "But it gets easier every time."
    MC @ talk "Но с каждым разом становится легче."

# game/data/travel_events/travel_banter.rpy:83
translate ru travelmodebanter_map_elena_mc_2_c2fc29a5:

    # MC @ talk "Why do you ask?"
    MC @ talk "Почему ты спрашиваешь?"

# game/data/travel_events/travel_banter.rpy:84
translate ru travelmodebanter_map_elena_mc_2_ede2ccf2:

    # ELENA @ sad "Just worried about you."
    ELENA @ sad "Просто беспокоюсь о тебе."

# game/data/travel_events/travel_banter.rpy:85
translate ru travelmodebanter_map_elena_mc_2_7cedfe97:

    # ELENA @ talk "How are you holding up? After everything that's happened so fast..."
    ELENA @ talk "Как ты держишься? После всего, что случилось так быстро..."

# game/data/travel_events/travel_banter.rpy:88
translate ru travelmodebanter_map_elena_mc_2_cf94bad7:

    # ELENA @ shock "Really? I'm surprised... most people would struggle."
    ELENA @ shock "Правда? Я удивлена... большинство людей не справились бы."

# game/data/travel_events/travel_banter.rpy:89
translate ru travelmodebanter_map_elena_mc_2_094bce6b:

    # MC @ talk "There are doubts, sure. But we can actually change things now."
    MC @ talk "Сомнения есть, конечно. Но теперь мы действительно можем что-то изменить."

# game/data/travel_events/travel_banter.rpy:90
translate ru travelmodebanter_map_elena_mc_2_e1f4d040:

    # MC @ smile "Before the gift, I felt powerless. Like my life wasn't mine."
    MC @ smile "До дара, я чувствовал себя беспомощным. Как будто моя жизнь мне не принадлежала."

# game/data/travel_events/travel_banter.rpy:91
translate ru travelmodebanter_map_elena_mc_2_92dfa1e6:

    # MC @ smile "Now? It's like we finally have... {i}hope.{/i}"
    MC @ smile "А теперь? Как будто у нас наконец-то появилась... {i}надежда.{/i}"

# game/data/travel_events/travel_banter.rpy:92
translate ru travelmodebanter_map_elena_mc_2_73c0b9f3:

    # ELENA @ smile "You're starting to sound like a hero from the old tales."
    ELENA @ smile "Ты начинаешь звучать как герой из старых сказок."

# game/data/travel_events/travel_banter.rpy:93
translate ru travelmodebanter_map_elena_mc_2_f18990c6:

    # MC @ smile "Let's not go that far."
    MC @ smile "Не будем заходить так далеко."

# game/data/travel_events/travel_banter.rpy:94
translate ru travelmodebanter_map_elena_mc_2_91c8e0b3:

    # ELENA @ smile "Come. Let's keep moving."
    ELENA @ smile "Пойдём. Давай продолжим двигаться."

# game/data/travel_events/travel_banter.rpy:96
translate ru travelmodebanter_map_elena_mc_2_a4311795:

    # ELENA @ sad "That's... a relief. You can talk to me, you know."
    ELENA @ sad "Это... облегчает. Ты можешь поговорить со мной, знаешь ли."

# game/data/travel_events/travel_banter.rpy:97
translate ru travelmodebanter_map_elena_mc_2_b067621a:

    # MC @ smile "That means more than you think."
    MC @ smile "Это значит больше, чем ты думаешь."

# game/data/travel_events/travel_banter.rpy:98
translate ru travelmodebanter_map_elena_mc_2_42ddcd91:

    # ELENA @ smile "Come on. Let's keep moving."
    ELENA @ smile "Давай. Продолжим движение."

# game/data/travel_events/travel_banter.rpy:100
translate ru travelmodebanter_map_elena_mc_2_2f15a7d9:

    # ELENA @ sad "I'm here if you want to talk."
    ELENA @ sad "Я здесь, если захочешь поговорить."

# game/data/travel_events/travel_banter.rpy:101
translate ru travelmodebanter_map_elena_mc_2_30d77ce8:

    # ELENA @ sad "It weighs heavy, doesn't it? Memories that won't let go..."
    ELENA @ sad "Они тяжело давят, не так ли? Воспоминания, которые не отпускают..."

# game/data/travel_events/travel_banter.rpy:102
translate ru travelmodebanter_map_elena_mc_2_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/travel_events/travel_banter.rpy:103
translate ru travelmodebanter_map_elena_mc_2_6c08d76e:

    # ELENA @ sad "A-Anyway! I just wanted you to know you're not alone."
    ELENA @ sad "В-В любом случае! Я просто хотела чтобы ты знал, что ты не одинок."

# game/data/travel_events/travel_banter.rpy:104
translate ru travelmodebanter_map_elena_mc_2_1a43d7a9:

    # ELENA @ talk "I'm here if you need me."
    ELENA @ talk "Я здесь, если я тебе понадоблюсь."

# game/data/travel_events/travel_banter.rpy:105
translate ru travelmodebanter_map_elena_mc_2_ddf70b53:

    # MC @ smile "Thank you, Elena."
    MC @ smile "Спасибо, Елена."

# game/data/travel_events/travel_banter.rpy:106
translate ru travelmodebanter_map_elena_mc_2_0403d166:

    # ELENA @ smile "Come. Let's keep going."
    ELENA @ smile "Пойдём. Продолжим путь."

# game/data/travel_events/travel_banter.rpy:116
translate ru travelmodebanter_map_elena_mc_3_romance_ed8a1411:

    # "While walking, something soft brushed against my side."
    "Идя по дороге, я почувствовал как что-то мягкое коснулось моего бока."

# game/data/travel_events/travel_banter.rpy:118
translate ru travelmodebanter_map_elena_mc_3_romance_899cf127:

    # "Elena passed me with a coy smile and a soft hum."
    "Елена прошла мимо меня с кокетливой улыбкой и тихим напеванием."

# game/data/travel_events/travel_banter.rpy:119
translate ru travelmodebanter_map_elena_mc_3_romance_fe9303c4:

    # ELENA @ smile "{i}*Happy humming*{/i}"
    ELENA @ smile "{i}*Счастливое напевание*{/i}"

# game/data/travel_events/travel_banter.rpy:120
translate ru travelmodebanter_map_elena_mc_3_romance_3321ea6a:

    # MC @ smile "Someone's in a good mood."
    MC @ smile "Кто-то сегодня в хорошем настроении."

# game/data/travel_events/travel_banter.rpy:122
translate ru travelmodebanter_map_elena_mc_3_romance_07f53f05:

    # ELENA @ smile "Of course. The weather's pleasant, the air is clean..."
    ELENA @ smile "Конечно. Погода прекрасна, воздух чистый..."

# game/data/travel_events/travel_banter.rpy:123
translate ru travelmodebanter_map_elena_mc_3_romance_bc9974f6:

    # "She glanced back, her sultry eyes dancing."
    "Она оглянулась, её соблазнительные глаза играли."

# game/data/travel_events/travel_banter.rpy:124
translate ru travelmodebanter_map_elena_mc_3_romance_3f6ec57a:

    # ELENA @ smile "And {i}the view{/i} is quite nice, too."
    ELENA @ smile "И {i}вид{/i} тоже довольно приятный."

# game/data/travel_events/travel_banter.rpy:125
translate ru travelmodebanter_map_elena_mc_3_romance_eaad9ebd:

    # MC @ smile "The view, huh?"
    MC @ smile "Вид, хах?"

# game/data/travel_events/travel_banter.rpy:126
translate ru travelmodebanter_map_elena_mc_3_romance_80da6f9e:

    # "Her tail brushed me again playfully as she walked ahead."
    "Её хвост снова игриво коснулся меня пока она шла впереди."

# game/data/travel_events/travel_banter.rpy:127
translate ru travelmodebanter_map_elena_mc_3_romance_f4fe840d:

    # ELENA @ smile "Yes. It's been on my mind a lot lately."
    ELENA @ smile "Да. Я много об этом думала в последнее время."

# game/data/travel_events/travel_banter.rpy:130
translate ru travelmodebanter_map_elena_mc_3_romance_c670f114:

    # MC @ smile "(Cute.)"
    MC @ smile "(Мило.)"

# game/data/travel_events/travel_banter.rpy:137
translate ru travelmodebanter_map_elena_markus_1_ddfff1fd:

    # MARKUS @ think "So, you're a lady, then?"
    MARKUS @ think "Значит выходит, ты леди?"

# game/data/travel_events/travel_banter.rpy:139
translate ru travelmodebanter_map_elena_markus_1_abecf88a:

    # ELENA @ talk "Yes, I do indeed belong to the female gender."
    ELENA @ talk "Да, я действительно принадлежу к женскому полу."

# game/data/travel_events/travel_banter.rpy:140
translate ru travelmodebanter_map_elena_markus_1_d0033b5e:

    # MARKUS @ angry "You know that wasn't what I was talking about!"
    MARKUS @ angry "Ну ты же знаешь что я не об этом!"

# game/data/travel_events/travel_banter.rpy:141
translate ru travelmodebanter_map_elena_markus_1_3213a1a5:

    # MARKUS @ talk "I mean, you're a *lady* lady. Like, you grew up in some huge estate house."
    MARKUS @ talk "Я имею в виду, что ты *настоящая* леди. Якобы, выросла в каком-то огромном поместье."

# game/data/travel_events/travel_banter.rpy:142
translate ru travelmodebanter_map_elena_markus_1_9316f5fc:

    # ELENA @ smile "Yes. The ones with the very long tables and lots of food on them."
    ELENA @ smile "Да. С очень длинными столами и множеством блюд на них."

# game/data/travel_events/travel_banter.rpy:143
translate ru travelmodebanter_map_elena_markus_1_f6ced7d6:

    # ELENA @ smile "Are you going somewhere with this?"
    ELENA @ smile "Ты к чему-то ведёшь?"

# game/data/travel_events/travel_banter.rpy:144
translate ru travelmodebanter_map_elena_markus_1_a54c70bc:

    # MARKUS @ talk "Sensitive much?"
    MARKUS @ talk "Слишком деликатно?"

# game/data/travel_events/travel_banter.rpy:146
translate ru travelmodebanter_map_elena_markus_1_2de858ba:

    # ELENA @ talk "I can assure you, manor house or not, my time at the Thornfalls was... difficult."
    ELENA @ talk "Могу заверить, что поместье или нет, моё время в Торнфоллах было... тяжёлым."

# game/data/travel_events/travel_banter.rpy:147
translate ru travelmodebanter_map_elena_markus_1_6211068f:

    # MARKUS @ think "I find that hard to believe."
    MARKUS @ think "В это трудно поверить."

# game/data/travel_events/travel_banter.rpy:148
translate ru travelmodebanter_map_elena_markus_1_298cf6f7:

    # MARKUS @ think "Did you ever have to worry about where your next meal would come from?"
    MARKUS @ think "Тебе когда-нибудь приходилось беспокоиться о том, откуда будет твой следующий приём пищи?"

# game/data/travel_events/travel_banter.rpy:149
translate ru travelmodebanter_map_elena_markus_1_24473bcf:

    # MARKUS @ think "Or constantly wonder when, not if, the next loved one would be taken by this infernal war?"
    MARKUS @ think "Или постоянно гадать когда, а не если, следующий любимый человек будет унесён этой адской войной?"

# game/data/travel_events/travel_banter.rpy:150
translate ru travelmodebanter_map_elena_markus_1_3cdbde5f:

    # ELENA @ angry "No..."
    ELENA @ angry "Нет..."

# game/data/travel_events/travel_banter.rpy:152
translate ru travelmodebanter_map_elena_markus_1_77cdaa2f:

    # ELENA @ angry "I just spent every night living in fear."
    ELENA @ angry "Я просто каждую ночь жила в страхе."

# game/data/travel_events/travel_banter.rpy:153
translate ru travelmodebanter_map_elena_markus_1_d313e372:

    # ELENA @ angry "Let me tell you something, Markus."
    ELENA @ angry "Позволь мне кое-что сказать, Маркус."

# game/data/travel_events/travel_banter.rpy:154
translate ru travelmodebanter_map_elena_markus_1_f52bc4d7:

    # ELENA @ angry "It's one kind of hell to starve... it's another entirely to wonder if every meal you're served will be your last."
    ELENA @ angry "Одно дело — голодать... и совсем другое — гадать, не станет ли каждый поданный тебе обед последним."

# game/data/travel_events/travel_banter.rpy:164
translate ru travelmodebanter_map_elena_markus_2_6b1dd249:

    # MARKUS @ talk "Tell me, Elena."
    MARKUS @ talk "Скажи мне, Елена."

# game/data/travel_events/travel_banter.rpy:166
translate ru travelmodebanter_map_elena_markus_2_10d78c40:

    # MARKUS @ talk "You must have spent some time traveling around before meeting us."
    MARKUS @ talk "Ты наверное, какое-то время путешествовала прежде чем встретить нас."

# game/data/travel_events/travel_banter.rpy:167
translate ru travelmodebanter_map_elena_markus_2_2f0ee648:

    # MARKUS @ smile "Got any interesting stories to tell?"
    MARKUS @ smile "Есть интересные истории?"

# game/data/travel_events/travel_banter.rpy:168
translate ru travelmodebanter_map_elena_markus_2_c983087c:

    # ELENA @ grumpy "...A while back, while I was in Newyark, I heard about a 'wolf woman' and naturally, my interest was piqued."
    ELENA @ grumpy "...Не так давно, когда я была в Ньюярке, я услышала о 'женщине-волке', и естественно, мой интерес пробудился."

# game/data/travel_events/travel_banter.rpy:169
translate ru travelmodebanter_map_elena_markus_2_71871438:

    # ELENA @ talk "It didn't sound like any kind of Katai, so I thought perhaps I might finally find another of my kind."
    ELENA @ talk "Это не звучало как о какой-либо Катай, поэтому я подумала, что возможно наконец-то найду другого из своего рода."

# game/data/travel_events/travel_banter.rpy:170
translate ru travelmodebanter_map_elena_markus_2_e936c5f8:

    # MARKUS @ think "What did you find?"
    MARKUS @ think "И что ты нашла?"

# game/data/travel_events/travel_banter.rpy:171
translate ru travelmodebanter_map_elena_markus_2_2dd61dd9:

    # ELENA @ shock "It was a woman who had made some kind of... fur suit from different pelts of wolves."
    ELENA @ shock "Это была женщина, которая сшила какой-то... меховой костюм из разных волчьих шкур."

# game/data/travel_events/travel_banter.rpy:173
translate ru travelmodebanter_map_elena_markus_2_03538783:

    # ELENA @ shock "She was running around on stage pretending to be a wolf!"
    ELENA @ shock "Она бегала по сцене, притворяясь волком!"

# game/data/travel_events/travel_banter.rpy:174
translate ru travelmodebanter_map_elena_markus_2_cc301a3c:

    # ELENA @ shock "Can you imagine people doing such a strange thing?"
    ELENA @ shock "Ты можешь представить что люди делают такие странные вещи?"

# game/data/travel_events/travel_banter.rpy:175
translate ru travelmodebanter_map_elena_markus_2_0f3ab35d:

    # MARKUS @ think "...Too much salt in the air from the sea."
