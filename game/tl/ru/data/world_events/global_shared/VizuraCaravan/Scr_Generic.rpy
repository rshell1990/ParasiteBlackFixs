
# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:10
translate ru vizura_caravan_revisit_talk_669a050d:

    # VIZURA @ happy "Ahh! Welcome back!"
    VIZURA @ happy "Ах! С возвращением!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:11
translate ru vizura_caravan_revisit_talk_950e49d7:

    # VIZURA @ talk "How's the roads treatin' ya? What can Vizura do for you?"
    VIZURA @ talk "Как дороги тебя принимают? Что Визура может для тебя сделать?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:18
translate ru vizura_caravan_talk_menu_917cd195:

    # VIZURA @ happy "Ho ho! Take a looksie!"
    VIZURA @ happy "Хо-хо! Взгляни-ка!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:28
translate ru vizura_caravan_talk_menu_3194ac1b:

    # VIZURA @ happy "Anything else you need?"
    VIZURA @ happy "Нужно что-нибудь ещё?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:33
translate ru vizura_caravan_talk_menu_5afb3c15:

    # VIZURA @ talk "Hmm, tempting."
    VIZURA @ talk "Хм, заманчиво."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:34
translate ru vizura_caravan_talk_menu_e6fc278d:

    # VIZURA @ talk "But sadly, I ain't got time to roll around in the hay with you, we gotta be on the move soon."
    VIZURA @ talk "Но увы, у меня нет времени валяться с тобой в сене, нам скоро нужно выдвигаться."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:35
translate ru vizura_caravan_talk_menu_b9b03a72:

    # VIZURA @ talk "Let me know if you want anything else though."
    VIZURA @ talk "Дай знать, если захочешь чего-нибудь ещё."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:38
translate ru vizura_caravan_talk_menu_da7af367:

    # VIZURA @ lewd "Fufu, couldn't stop thinking about this green arse, hm?"
    VIZURA @ lewd "Фу-фу, не мог перестать думать об этой зелёной заднице, хм?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:41
translate ru vizura_caravan_talk_menu_9179da90:

    # "Vizura stripped her clothes off in front of me, uncaring at anyone who might see as she smirked."
    "Визура сняла одежду передо мной, не заботясь о том, кто может увидеть, и усмехнулась."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:42
translate ru vizura_caravan_talk_menu_806a9b32:

    # VIZURA @ lewd "Step into my office, {i}love.{/i}"
    VIZURA @ lewd "Заходи в мой офис, {i}любовник.{/i}"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:50
translate ru vizura_caravan_talk_menu_8fb87d97:

    # VIZURA @ think "You got some kinda funny seed?"
    VIZURA @ think "У тебя там какое-то странное семя?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:51
translate ru vizura_caravan_talk_menu_93cb9ef4:

    # VIZURA @ surp "He's bigger and stronger than any other littlun I've ever seen!"
    VIZURA @ surp "Он больше и сильнее любого другого малыша, которого я когда-либо видела!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:52
translate ru vizura_caravan_talk_menu_b09dd3ff:

    # VIZURA @ lewd "Let's go make another! Just thinking about how strong our children are is doing it for me!"
    VIZURA @ lewd "Пойдём сделаем ещё одного! Одна мысль о том, какие сильные наши дети, уже заводит меня!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:54
translate ru vizura_caravan_talk_menu_36553582:

    # VIZURA @ talk "Fufu, aren't you a sweetheart, worryin' about our spawn?"
    VIZURA @ talk "Фу-фу, разве ты не милашка, беспокоишься о нашем потомстве?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:55
translate ru vizura_caravan_talk_menu_edf7ca9e:

    # VIZURA @ happy "Don't you worry, he's doing just fine."
    VIZURA @ happy "Не волнуйся, у него всё отлично."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:56
translate ru vizura_caravan_talk_menu_46ac6ffc:

    # VIZURA @ talk "Lookin' at the size of his {i}'sword'{/i} already, he's gonna make some goblin girls very happy when we head home!"
    VIZURA @ talk "Судя по размеру его {i}'меча'{/i} уже сейчас, он осчастливит немало гоблинских девушек, когда мы вернёмся домой!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:58
translate ru vizura_caravan_talk_menu_40ce4b7f:

    # VIZURA @ surp "Ehh?! You really wanna know?"
    VIZURA @ surp "Эээ?! Ты правда хочешь знать?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:59
translate ru vizura_caravan_talk_menu_76f84bda:

    # VIZURA @ lewd "Fufu, I'm gonna come back and expect you to put another in me soon if you keep being sweet like that you know..."
    VIZURA @ lewd "Фу-фу, я вернусь и буду ждать, что ты скоро снова меня заполнишь, если будешь продолжать быть таким милым, знаешь ли..."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:60
translate ru vizura_caravan_talk_menu_caefbebb:

    # VIZURA @ talk "And the littlun's fine, gonna prove one strong bastard when he's grown up fully!"
    VIZURA @ talk "И с малышом всё хорошо, вырастет крепким чертякой, когда полностью повзрослеет!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:61
translate ru vizura_caravan_talk_menu_b178677a:

    # VIZURA @ think "He might even become a chieftain if he keeps growin' at this rate..."
    VIZURA @ think "Он может даже стать вождём, если будет продолжать расти такими темпами..."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:65
translate ru vizura_caravan_talk_menu_cd87ab5b:

    # VIZURA @ talk "Fine, but make them quick, time is money and all that."
    VIZURA @ talk "Ладно, но давай быстрее, время — деньги и всё такое."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:68
translate ru vizura_caravan_talk_menu_questions_b47f48a1:

    # VIZURA @ angry "Tsch! You tryna' say somethin' human?"
    VIZURA @ angry "Цсс! Ты что-то хочешь сказать, человек?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:69
translate ru vizura_caravan_talk_menu_questions_da37266b:

    # VIZURA @ angry "Ain't nothin' illegal about a goblin travellin!'"
    VIZURA @ angry "Нет ничего незаконного в том, чтобы гоблин путешествовал!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:70
translate ru vizura_caravan_talk_menu_questions_969aa5fb:

    # VIZURA @ talk "Well, if you must know, I'm what they call a {i}freehelm{/i} goblin."
    VIZURA @ talk "Ну, если уж ты должен знать, я — то, что называют {i}вольным шлемом{/i} среди гоблинов."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:71
translate ru vizura_caravan_talk_menu_questions_60a0fb7e:

    # VIZURA @ talk "We get permission and what-not with the various kingdoms to travel across borders and do some business as we go."
    VIZURA @ talk "Мы получаем разрешения и всё такое в разных королевствах, чтобы пересекать границы и по пути вести дела."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:72
translate ru vizura_caravan_talk_menu_questions_be6c2f06:

    # MC @ talk "And the rulers don't mind that?"
    MC @ talk "И правители не против этого?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:73
translate ru vizura_caravan_talk_menu_questions_e798e29c:

    # VIZURA @ talk "Don't matter if they {i}don't{/i} like it, if you're gonna be allied to Irydian, one of the terms are to allow us freehelm folk passage to do business."
    VIZURA @ talk "Неважно, {i}нравится{/i} им это или нет, если ты собираешься быть союзником Иридиана, одно из условий — позволить нам, вольным шлемам, проход для ведения дел."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:74
translate ru vizura_caravan_talk_menu_questions_98785572:

    # VIZURA @ talk "We don't intervere with human politics and what-not, so most just begrudingly accept us for the sake of wider trade."
    VIZURA @ talk "Мы не вмешиваемся в человеческую политику и всё такое, так что большинство просто нехотя принимает нас ради более широкой торговли."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:78
translate ru vizura_caravan_talk_menu_questions_8c818204:

    # VIZURA @ surp "AND PAY TAXES? ARE YOU FUCKING CRAZY HUMAN?"
    VIZURA @ surp "И ПЛАТИТЬ НАЛОГИ? ТЫ СОВСЕМ ОХРЕНЕЛ, ЧЕЛОВЕК?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:79
translate ru vizura_caravan_talk_menu_questions_81579575:

    # VIZURA @ angry "Bloody thiefing bastards!"
    VIZURA @ angry "Чёртовы ворюги-ублюдки!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:80
translate ru vizura_caravan_talk_menu_questions_b34488ef:

    # VIZURA @ talk "{i}Oooh! We use your taxes to improve the roads and things though!{/i}"
    VIZURA @ talk "{i}Ооох! Но мы же используем ваши налоги на улучшение дорог и прочее!{/i}"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:81
translate ru vizura_caravan_talk_menu_questions_4d98591a:

    # VIZURA @ angry "You seen the roads recently? My ass is fucking sore from bouncing on all the uneven bumps!"
    VIZURA @ angry "Вы видели дороги в последнее время? У меня задница болит от того, что подпрыгиваю на всех этих неровностях!"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:85
translate ru vizura_caravan_talk_menu_questions_36bd8a82:

    # VIZURA @ talk "I dunno, like, a dozen of us maybe?"
    VIZURA @ talk "Не знаю, ну, нас может быть дюжина?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:86
translate ru vizura_caravan_talk_menu_questions_9cb7ffb4:

    # MC @ talk "Why so many?"
    MC @ talk "Почему так много?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:87
translate ru vizura_caravan_talk_menu_questions_c7e022a9:

    # VIZURA @ talk "Goblins are strong in numbers, gotta keep the caravan safe in case of thieves and what-not."
    VIZURA @ talk "Гоблины сильны числом, надо охранять караван на случай воров и всего такого."

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:91
translate ru vizura_caravan_talk_menu_questions_69c8d000:

    # VIZURA @ talk "Great, any other business?"
    VIZURA @ talk "Отлично, есть ещё дела?"

# game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:95
translate ru vizura_caravan_talk_menu_questions_889d49a4:

    # VIZURA @ happy "Very well, until next time, handsome."
    VIZURA @ happy "Очень хорошо, до следующей встречи, красавчик."

