    old "I have some questions..."
    new "У меня есть несколько вопросов..."

    # game/data/world_events/global_shared/VizuraCaravan/Scr_Generic.rpy:67
    old "What's a goblin doing in Alderay?"
    new "Что гоблин делает в Алдерее?"

