    # ADARA @ shame "I don't know what came over me."
    ADARA @ shame "Не знаю, что на меня нашло."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:144
translate ru ev_KrishanaDay_regina_dialogue_menu_1ae2a282:

    # ADARA @ joy "T-Thanks..."
    ADARA @ joy "С-спасибо..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:145
translate ru ev_KrishanaDay_regina_dialogue_menu_31f59c82:

    # ADARA @ shame "(Gods, I'm going to die of embarrassement!)"
    ADARA @ shame "(Боги, я умру от смущения!)"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:146
translate ru ev_KrishanaDay_regina_dialogue_menu_a5e19cd0:

    # ADARA @ shame "(I can't believe I just said that!)"
    ADARA @ shame "(Не могу поверить, что только что это сказала!)"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:148
translate ru ev_KrishanaDay_regina_dialogue_menu_484db046:

    # ADARA @ smile "J-Just wanted to wish you a happy Krishana day I guess..."
    ADARA @ smile "П-просто хотела поздравить с днём Кришаны, наверное..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:149
translate ru ev_KrishanaDay_regina_dialogue_menu_d64c644f:

    # "Adara paused sheepishly, her hands clasping at her dress tightly."
    "Адара застенчиво замолчала, крепко сжимая платье в руках."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:150
translate ru ev_KrishanaDay_regina_dialogue_menu_7a497736:

    # ADARA @ shame "I was wondering if perhaps maybe we c-could..."
    ADARA @ shame "Я думала, может быть, мы см-сможем..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:151
translate ru ev_KrishanaDay_regina_dialogue_menu_54779c02:

    # ADARA @ joy "G-Go for a walk?"
    ADARA @ joy "П-Пойти прогуляться?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:153
translate ru ev_KrishanaDay_regina_dialogue_menu_7c3775eb:

    # MC @ lewd "Where shall we head to?"
    MC @ lewd "Куда бы нам направиться?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:154
translate ru ev_KrishanaDay_regina_dialogue_menu_0abbaba0:

    # ADARA @ smile "There's quite a lot going on at the Market I'm told, perhaps we should head there?"
    ADARA @ smile "Говорят, на Рынке сейчас много всего происходит, может, пойдём туда?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:155
translate ru ev_KrishanaDay_regina_dialogue_menu_ce53fb2e:

    # MC @ smile2 "Alright, that sounds good to me."
    MC @ smile2 "Хорошо, звучит неплохо."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:158
translate ru ev_KrishanaDay_regina_dialogue_menu_a3ef7502:

    # "The two of us made our way through the winding Novaras streets, the gentle snow falling onto the ground as children hurried through excitedly to meet their friends."
    "Мы вдвоём пробирались по извилистым улицам Новараса, пока нежный снег падал на землю, а дети радостно спешили встретиться с друзьями."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:164
translate ru ev_KrishanaDay_regina_dialogue_menu_042dbacd:

    # "At the Market, it was like a kind of festive carnival."
    "На Рынке царила атмосфера праздничного карнавала."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:165
translate ru ev_KrishanaDay_regina_dialogue_menu_e76869d8:

    # "Merchants, roasted meat over open fires that filled the air with a sweet aroma, with small crowds gathering around eager for a taste."
    "Торговцы жарили мясо на открытом огне, наполняя воздух сладким ароматом, вокруг которого собирались небольшие группы жаждущих попробовать."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:166
translate ru ev_KrishanaDay_regina_dialogue_menu_c36b411f:

    # "Children hurried around, throwing snowballs at their friends, parents watched and chatted amongst themselves from afar."
    "Дети бегали вокруг, кидаясь снежками в друзей, а родители наблюдали и общались между собой поодаль."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:167
translate ru ev_KrishanaDay_regina_dialogue_menu_be8b2752:

    # "One merchant with huge mead barrels opened, poured patrons small cups who huddled together and laughed to themselves merrily."
    "Один торговец с огромными открытыми бочками медовухи разливал маленькие чашки посетителям, которые теснились вместе и весело смеялись."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:168
translate ru ev_KrishanaDay_regina_dialogue_menu_3d1b9cdc:

    # "For a brief moment in time, it was as though everyone forgot about the wars existence outside these city walls..."
    "На мгновение казалось, будто все забыли о войне за стенами этого города..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:169
translate ru ev_KrishanaDay_regina_dialogue_menu_da28cac1:

    # ADARA @ smile "Isn't it nice to see everyone out and so cheery?"
    ADARA @ smile "Разве не прекрасно видеть всех на улице такими радостными?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:170
translate ru ev_KrishanaDay_regina_dialogue_menu_684e7350:

    # MC @ think "The last time it was like this was when-"
    MC @ think "В последний раз так было, когда-"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:171
translate ru ev_KrishanaDay_regina_dialogue_menu_db480df9:

    # "I pushed the thought of the Terminus ceremony to the back of my mind."
    "Я отогнал мысль о церемонии Терминуса на задний план."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:172
translate ru ev_KrishanaDay_regina_dialogue_menu_1833ec0b:

    # "This was a happy time."
    "Это было счастливое время."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:173
translate ru ev_KrishanaDay_regina_dialogue_menu_681613ed:

    # ADARA @ smile "Look at this place! Isn't it wonderful?"
    ADARA @ smile "Посмотри на это место! Разве не чудесно?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:174
translate ru ev_KrishanaDay_regina_dialogue_menu_8c941941:

    # "I smiled as the children chasing each other with snowballs hurried out in front of us."
    "Я улыбнулся, когда дети, гоняющиеся друг за другом снежками, поспешно пробежали перед нами."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:175
translate ru ev_KrishanaDay_regina_dialogue_menu_99be07bb:

    # MC @ smile2 "Yes, it's nice."
    MC @ smile2 "Да, это здорово."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:176
translate ru ev_KrishanaDay_regina_dialogue_menu_149e2884:

    # ADARA @ joy "What should we do now?"
    ADARA @ joy "Что нам теперь делать?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:180
translate ru ev_KrishanaDay_regina_dialogue_menu_664cc199:

    # "The time went by quickly as we had fun, it was always easy letting time drift by with Adara."
    "Время пролетело быстро, пока мы веселились, с Адарой всегда было легко позволять времени утекать."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:182
translate ru ev_KrishanaDay_regina_dialogue_menu_c8fe2941:

    # MAD_PROPHET "GATHER! GATHER ALL!"
    MAD_PROPHET "СОБИРАЙТЕСЬ! СОБИРАЙТЕСЬ ВСЕ!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:188
translate ru ev_KrishanaDay_regina_dialogue_menu_397e2913:

    # ADARA @ shock "Isn't he cold wearing so little in this weather?"
    ADARA @ shock "Разве ему не холодно в такую погоду в такой легкой одежде?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:189
translate ru ev_KrishanaDay_regina_dialogue_menu_58374c5f:

    # MAD_PROPHET "Come and hear the tale of Krishana the ice dragon!"
    MAD_PROPHET "Подходите и послушайте историю о ледяном драконе Кришане!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:190
translate ru ev_KrishanaDay_regina_dialogue_menu_5506bc64:

    # ADARA @ smile "What do you think? Wanna listen?"
    ADARA @ smile "Что думаешь? Хочешь послушать?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:197
translate ru ev_KrishanaDay_regina_dialogue_menu_53aaa9a4:

    # "The two of us stepped closer and joined the growing crowd, mainly comprised of children but a few adults lingered."
    "Мы оба подошли ближе и присоединились к растущей толпе, состоящей в основном из детей, но несколько взрослых тоже задержались."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:198
translate ru ev_KrishanaDay_regina_dialogue_menu_8b9e7ec0:

    # MAD_PROPHET "And so we begin, centuries long past, Krishana, the great ice dragon, sat on her ice throne in the mountains of Angmurus!"
    MAD_PROPHET "Итак, мы начинаем, много веков назад, Кришана, великий ледяной дракон, восседала на своем ледяном троне в горах Ангмуруса!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:199
translate ru ev_KrishanaDay_regina_dialogue_menu_7a95d963:

    # MAD_PROPHET "{i}Bored!{/i}"
    MAD_PROPHET "{i}Скучно!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:200
translate ru ev_KrishanaDay_regina_dialogue_menu_e98b016a:

    # "The crowd laughed a little."
    "Толпа слегка рассмеялась."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:201
translate ru ev_KrishanaDay_regina_dialogue_menu_b6989b01:

    # MAD_PROPHET "{i}'I know!'{/i} Thought the mighty dragon, {i}'I shall see what the humans down south are up to!'{/i}"
    MAD_PROPHET "{i}'Знаю!'{/i} Подумал могучий дракон, {i}'Пойду-ка посмотрю, чем заняты люди на юге!'{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:202
translate ru ev_KrishanaDay_regina_dialogue_menu_e6c8eed8:

    # MAD_PROPHET "As her mighty wings soared, she headed down south, perching herself up on a small mountain, watching the villagers down below!"
    MAD_PROPHET "Когда её могучие крылья взмыли ввысь, она направилась на юг, устроившись на небольшой горе и наблюдая за жителями деревни внизу!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:203
translate ru ev_KrishanaDay_regina_dialogue_menu_5452de45:

    # MAD_PROPHET "The people revered but feared the mighty dragons! And each parent warned the children not to approach the great Krishana!"
    MAD_PROPHET "Люди почитали, но боялись могучих драконов! И каждый родитель предупреждал детей не приближаться к великой Кришане!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:204
translate ru ev_KrishanaDay_regina_dialogue_menu_bf4a2f15:

    # MAD_PROPHET "Some young children, brave and adventurous, ignoring their parents advice, scaled the small mountain and approached the dragoness!"
    MAD_PROPHET "Некоторые юные дети, храбрые и любопытные, пренебрегая советами родителей, взобрались на небольшую гору и приблизились к драконице!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:205
translate ru ev_KrishanaDay_regina_dialogue_menu_7e9a0589:

    # MAD_PROPHET "{i}'But what brings you small humans here?'{/i} The dragoness asked!"
    MAD_PROPHET "{i}'Но что привело вас, маленькие люди, сюда?'{/i} — спросила драконица!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:206
translate ru ev_KrishanaDay_regina_dialogue_menu_aa79a142:

    # MAD_PROPHET "{i}'Oh great Krishana! It has not snowed in these lands for so long! Can you not make it so?{/i}"
    MAD_PROPHET "{i}'О великая Кришана! В этих землях так долго не было снега! Не могла бы ты это исправить?{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:207
translate ru ev_KrishanaDay_regina_dialogue_menu_5fa83f8d:

    # MAD_PROPHET "The dragon laughed, and laughed and laughed!"
    MAD_PROPHET "Дракон рассмеялся, и смеялся, и смеялся!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:208
translate ru ev_KrishanaDay_regina_dialogue_menu_7ecbd013:

    # MAD_PROPHET "{i}But what in return shall thy give thee?{/i} The dragoness asked."
    MAD_PROPHET "{i}Но что взамен вы предложите мне?{/i} — спросила драконица."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:209
translate ru ev_KrishanaDay_regina_dialogue_menu_1a3da702:

    # MAD_PROPHET "{i}For my hordes of gold are vast, and I never suffer hunger long!{/i}"
    MAD_PROPHET "{i}Ибо мои груды золота огромны, и я никогда долго не страдаю от голода!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:210
translate ru ev_KrishanaDay_regina_dialogue_menu_ef09375e:

    # MAD_PROPHET "{i}What could you possibly have to offer me?{/i}"
    MAD_PROPHET "{i}Что вы вообще можете предложить мне?{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:211
translate ru ev_KrishanaDay_regina_dialogue_menu_8f1a64cc:

    # MAD_PROPHET "The children looked amongst themselves for a moment, till one stepped forward and offered the great Krishana a small stone."
    MAD_PROPHET "Дети на мгновение переглянулись, пока один не выступил вперёд и не предложил великой Кришане маленький камень."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:212
translate ru ev_KrishanaDay_regina_dialogue_menu_70d2ab96:

    # MAD_PROPHET "{i}But what is this?{/i} The dragoness asked."
    MAD_PROPHET "{i}Но что это?{/i} — спросила драконица."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:213
translate ru ev_KrishanaDay_regina_dialogue_menu_d33e7b2d:

    # MAD_PROPHET "{i}It is a waystone!{/i} the child answered!"
    MAD_PROPHET "{i}Это путеводный камень!{/i} — ответил ребёнок!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:214
translate ru ev_KrishanaDay_regina_dialogue_menu_60db9f86:

    # MAD_PROPHET "{i}So no matter where you fly, you will always be able to find your way home here!{/i}"
    MAD_PROPHET "{i}Так что, куда бы ты ни полетела, ты всегда сможешь найти дорогу домой сюда!{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:215
translate ru ev_KrishanaDay_regina_dialogue_menu_9e7dd2b0:

    # MAD_PROPHET "Krishana took the small gift, and boomed, {i}'HOME? HERE? FOR ME?'{/i}"
    MAD_PROPHET "Кришана взяла маленький подарок и громогласно произнесла: {i}'ДОМ? ЗДЕСЬ? ДЛЯ МЕНЯ?'{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:216
translate ru ev_KrishanaDay_regina_dialogue_menu_0229275b:

    # MAD_PROPHET "The dragoness, so touched by the gift, said with a cool blow of air, {i}I've never had a home before.{/i}"
    MAD_PROPHET "Драконица, тронутая подарком, сказала с прохладным дуновением воздуха: {i}У меня никогда не было дома.{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:217
translate ru ev_KrishanaDay_regina_dialogue_menu_2bb02a72:

    # MAD_PROPHET "Before the children could answer, the mighty Kirshana unleashed her icy breath into the sky, and the children celebrated as the snow fell down!"
    MAD_PROPHET "Прежде чем дети успели ответить, могучая Киршана выпустила своё ледяное дыхание в небо, и дети ликовали, пока падал снег!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:218
translate ru ev_KrishanaDay_regina_dialogue_menu_dda3abaf:

    # MAD_PROPHET "And so it was, Krishana returned every year to bring forth the snow in exchange for the children's gifts!"
    MAD_PROPHET "И вот так, Кришана возвращалась каждый год, чтобы принести снег в обмен на подарки детей!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:219
translate ru ev_KrishanaDay_regina_dialogue_menu_9885251b:

    # MAD_PROPHET "And thus, that is why yearly we share gifts amongst loved ones and friends! To celebrate this most joyous of times!"
    MAD_PROPHET "И поэтому каждый год мы обмениваемся подарками с близкими и друзьями! Чтобы отпраздновать это самое радостное время!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:220
translate ru ev_KrishanaDay_regina_dialogue_menu_c64f40ac:

    # "The crowd clapped and handed over some coins towards the man, who collected them in a small jar."
    "Толпа аплодировала и передавала несколько монет мужчине, который собирал их в маленькую банку."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:225
translate ru ev_KrishanaDay_regina_dialogue_menu_29f9f809:

    # ADARA @ smile "Krishana was always one of my favorite stories growing up."
    ADARA @ smile "Кришана всегда была одной из моих любимых историй в детстве."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:226
translate ru ev_KrishanaDay_regina_dialogue_menu_51eae6f2:

    # ADARA @ smile "Isn't it nice to just hear a story not always about death and violence once in a while?"
    ADARA @ smile "Разве не приятно иногда просто послушать историю не всегда о смерти и насилии?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:228
translate ru ev_KrishanaDay_regina_dialogue_menu_ed83f52f:

    # ADARA @ talk "Ah, okay then..."
    ADARA @ talk "Ах, хорошо тогда..."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:229
translate ru ev_KrishanaDay_regina_dialogue_menu_5ccedec9:

    # ADARA @ talk "It's getting quite late."
    ADARA @ talk "Уже довольно поздно."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:230
translate ru ev_KrishanaDay_regina_dialogue_menu_46b5b0ad:

    # ADARA @ shame "Do you mind walking me home?"
    ADARA @ shame "Не возражаешь, если проводишь меня домой?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:231
translate ru ev_KrishanaDay_regina_dialogue_menu_0ca268ac:

    # MC @ lewd "Do you even need to ask that?"
    MC @ lewd "А нужно ли вообще это спрашивать?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:232
translate ru ev_KrishanaDay_regina_dialogue_menu_1454db55:

    # "Adara smiled."
    "Адара улыбнулась."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:234
translate ru ev_KrishanaDay_regina_dialogue_menu_e2b4bf66:

    # ADARA @ talk "C-Come on then, it's cold just standing here talking!"
    ADARA @ talk "Д-Давай уже, холодно просто стоять здесь и разговаривать!"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:242
translate ru ev_KrishanaDay_regina_dialogue_menu_6f95fffc:

    # "{i}After a short walk back to Adara's home...{/i}"
    "{i}После короткой прогулки обратно к дому Адары...{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:248
translate ru ev_KrishanaDay_regina_dialogue_menu_2af513bf:

    # ADARA @ talk "Thank you for walking me home, [player_name!t]."
    ADARA @ talk "Спасибо, что проводил меня домой, [player_name!t]."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:248
translate ru ev_KrishanaDay_regina_dialogue_menu_cf81e8c8:

    # MC @ smile "Anytime, Adara."
    MC @ smile "Всегда, Адара."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:249
