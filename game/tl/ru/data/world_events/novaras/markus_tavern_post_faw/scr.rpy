translate ru ev_markus_tavern_301a5089:

    # MARKUS @ smile "This is our chance [player_name!t], we can make something good with this."
    MARKUS @ smile "Это наш шанс, [player_name!t], мы можем сделать из этого что-то хорошее."

# game/data/world_events/novaras/markus_tavern_post_faw/scr.rpy:52
translate ru act1scene8_menu_3e3a04a9:

    # MARKUS "What about it?"
    MARKUS "А что насчёт нее?"

