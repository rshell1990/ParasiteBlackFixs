
# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:10
translate ru evscr_nijah_rescue_2_4fbc34b2:

    # "I turned towards the woman cowering on the floor. As I approached her, she raised her arm defensively in the air."
    "Я повернулся к женщине, съёжившейся на полу. Подходя к ней, она защищающе подняла руку в воздух."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:11
translate ru evscr_nijah_rescue_2_deb6c08a:

    # MC @ talk "It’s alright, I’m not going to hurt you."
    MC @ talk "Всё в порядке, я не причиню тебе вреда."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:13
translate ru evscr_nijah_rescue_2_bf84c919:

    # UNKNOWN "..."
    UNKNOWN "..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:14
translate ru evscr_nijah_rescue_2_cee23ab1:

    # UNKNOWN "T-Thank you stranger."
    UNKNOWN "С-Спасибо, незнакомец."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:16
translate ru evscr_nijah_rescue_2_607f82ee:

    # MC @ talk "Here, let me help you up."
    MC @ talk "Вот, позволь помочь тебе подняться."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:17
translate ru evscr_nijah_rescue_2_cd373b13:

    # "With my hand out-stretched, I reached out and held her soft hand as I gently pulled her back to her feet."
    "Протянув руку, я взял её мягкую ладонь и осторожно помог ей встать на ноги."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:18
translate ru evscr_nijah_rescue_2_63c5e807:

    # MC @ talk "Did they hurt you?"
    MC @ talk "Они тебя ранили?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:19
translate ru evscr_nijah_rescue_2_177e3578:

    # UNKNOWN "No, I iz fine..."
    UNKNOWN "Нет, я в порядке..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:20
translate ru evscr_nijah_rescue_2_4d72dedb:

    # "As the woman unwrapped her headscarf to look at me, her eyes now settling from the panic fear."
    "Женщина размотала головной платок, чтобы взглянуть на меня, и её глаза постепенно успокаивались после панического страха."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:23
translate ru evscr_nijah_rescue_2_90c622eb:

    # "I immediately recognised who she was."
    "Я тут же узнал, кто она такая."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:24
translate ru evscr_nijah_rescue_2_e5cfdaf0:

    # MC @ talk "You... You're that woman I met at the pleasure district!"
    MC @ talk "Вы... Вы та женщина, которую я встретил в районе удовольствий!"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:25
translate ru evscr_nijah_rescue_2_9de1b7a2:

    # "The woman looked at me quizzically for a moment, not quite able to place my face."
    "Женщина на мгновение озадаченно посмотрела на меня, не совсем узнавая мое лицо."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:26
translate ru evscr_nijah_rescue_2_74a6ea16:

    # MC @ talk "... Nijah?"
    MC @ talk "... Ниджа?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:27
translate ru evscr_nijah_rescue_2_56014db0:

    # "Her eyes squinted towards me before recognition dawned on her face as well."
    "Её глаза прищурились в мою сторону, прежде чем в них тоже мелькнуло узнавание."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:29
translate ru evscr_nijah_rescue_2_aed3993e:

    # NIJAH "You... You were za boy..."
    NIJAH "Ты... Ты был тем юношей..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:30
translate ru evscr_nijah_rescue_2_6e091bb8:

    # NIJAH "The one joining zer Scouts..."
    NIJAH "Тем, кто присоединился к Разведчикам..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:31
translate ru evscr_nijah_rescue_2_aa308a53:

    # NIJAH "... You looks zerrrr..."
    NIJAH "... Ты выглядишь совсееем..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:32
translate ru evscr_nijah_rescue_2_f8144a4e:

    # NIJAH "{i}Different?{/i}"
    NIJAH "{i}Иначе?{/i}"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:33
translate ru evscr_nijah_rescue_2_cbb2fa12:

    # MC @ talk "Yeah, uh... it’s a long story."
    MC @ talk "Да, э-э... это долгая история."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:34
translate ru evscr_nijah_rescue_2_3c1cb32d:

    # MC @ talk "Listen, we can’t stay here, okay?"
    MC @ talk "Слушай, мы не можем здесь оставаться, хорошо?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:35
translate ru evscr_nijah_rescue_2_36980459:

    # MC @ talk "Come with me."
    MC @ talk "Пойдем со мной."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:36
translate ru evscr_nijah_rescue_2_d1b6f294:

    # "Holding out my hand once again, Nijah reached out to gently take it, still slightly shaking in fear."
    "Снова протянув руку, Ниджа потянулась, чтобы осторожно взять её, всё ещё слегка дрожа от страха."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:37
translate ru evscr_nijah_rescue_2_2c647830:

    # "By hand, I led her out of the alleys and towards the main streets once again, away from what had just happened."
    "Взяв её за руку, я вывел её из переулков и снова направился к главным улицам, подальше от того, что только что произошло."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:38
translate ru evscr_nijah_rescue_2_97e6c1f8:

    # NIJAH "Where are zu taking me?"
    NIJAH "Куда ты меня ведёшь?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:39
translate ru evscr_nijah_rescue_2_e6f22d0d:

    # MC @ talk "Somewhere safe we can talk..."
    MC @ talk "В безопасное место, где мы можем поговорить..."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:42
translate ru evscr_nijah_rescue_2_da170cde:

    # "The beautiful dark tanned beauty looked up to me, eyes bright as her lip quivered."
    "Прекрасная темнокожая красавица подняла на меня глаза, её взгляд был ясным, а губы дрожали."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:43
translate ru evscr_nijah_rescue_2_a85d10dc:

    # MC @ talk "My name is [player_name!t]."
    MC @ talk "Меня зовут [player_name!t]."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:44
translate ru evscr_nijah_rescue_2_acf9b5aa:

    # UNKNOWN "I... I am Nijah."
    UNKNOWN "Я... Я Ниджа."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:45
translate ru evscr_nijah_rescue_2_fcd69050:

    # "Looking around to see the prying eyes watching from the windows, I knew it could quickly become dangerous here if we didn't leave soon."
    "Оглядевшись и увидев любопытные взгляды, наблюдающие из окон, я понял, что здесь может быстро стать опасно, если мы не уйдём в ближайшее время."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:46
translate ru evscr_nijah_rescue_2_bf2088f4:

    # MC @ talk "Well Nijah, I don't think it's safe to stay here."
    MC @ talk "Что ж, Ниджа, я не думаю, что здесь безопасно оставаться."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:47
translate ru evscr_nijah_rescue_2_e3c99b27:

    # MC @ talk "You should come with me."
    MC @ talk "Ты должна пойти со мной."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:48
translate ru evscr_nijah_rescue_2_d1b6f294_1:

    # "Holding out my hand once again, Nijah reached out to gently take it, still slightly shaking in fear."
    "Снова протянув руку, я почувствовал, как Ниджа осторожно взяла её, всё ещё слегка дрожа от страха."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:49
translate ru evscr_nijah_rescue_2_2c647830_1:

    # "By hand, I led her out of the alleys and towards the main streets once again, away from what had just happened."
    "Взяв её за руку, я вывел её из переулков обратно на главные улицы, подальше от того, что только что произошло."

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:51
translate ru evscr_nijah_rescue_2_97e6c1f8_1:

    # NIJAH "Where are zu taking me?"
    NIJAH "Куда ты меня ведёшь?"

# game/data/world_events/novaras/nijah_rescue/scr_nijah_rescue_2.rpy:52
translate ru evscr_nijah_rescue_2_7ef8cfa8:

    # MC @ talk "Somewhere safe, away from here..."
    MC @ talk "В безопасное место, подальше отсюда..."

