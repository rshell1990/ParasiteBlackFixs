# game/data/world_interactions/black_diamond_arena/aio.rpy:37
translate ru black_diamond_arena_firstEnter_2471c171:

    # "As I stumbled down the flight of stairs, I heard the bellowing roar of cheers and something snarling down below."
    "Спотыкаясь, я спускался по лестнице и услышал оглушительный рёв толпы и что-то рычащее внизу."

# game/data/world_interactions/black_diamond_arena/aio.rpy:38
translate ru black_diamond_arena_firstEnter_1352313f:

    # "Coming upon a great darkened underground Arena, men gathered around and cheered as two reptilian beasts slashed and tore at each other in the fight pit below."
    "Войдя в огромную тёмную подземную Арену, я увидел, как мужчины собрались вокруг и ликовали, пока две рептилии рвали друг друга в боевой яме внизу."

# game/data/world_interactions/black_diamond_arena/aio.rpy:39
translate ru black_diamond_arena_firstEnter_8b799890:

    # "The one leapt and gripped the others throat with its teeth, ripping it out in a violent bloody display that the crowd roared with pleasure too."
    "Одна из них прыгнула и вцепилась зубами в горло другой, вырвав его в кровавом зрелище, от которого толпа взревела от восторга."

# game/data/world_interactions/black_diamond_arena/aio.rpy:40
translate ru black_diamond_arena_firstEnter_b2c9c7fd:

    # MC "(What is this place?)"
    MC "(Что это за место?)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:44
translate ru black_diamond_arena_firstEnter_51fba3e4:

    # BOOKKEEPER "Oi!"
    BOOKKEEPER "Эй!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:45
translate ru black_diamond_arena_firstEnter_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "Хах?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:46
translate ru black_diamond_arena_firstEnter_557daccb:

    # BOOKKEEPER "Zer are no freeloaders! Either place a bet, or fuck off!"
    BOOKKEEPER "Здесь нет нахлебников! Или делай ставку, или проваливай!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:47
translate ru black_diamond_arena_firstEnter_fc48861a:

    # MC @ talk "A bet?"
    MC @ talk "Ставку?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:48
translate ru black_diamond_arena_firstEnter_6faeae54:

    # BOOKKEEPER "Iz stupid or something?"
    BOOKKEEPER "Ты тупой, что ли?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:55
translate ru black_diamond_bookkeeper_talk_2fb4960b:

    # BOOKKEEPER "No. You off limit. Come back in a few dayz."
    BOOKKEEPER "Нет. Ты не допущен. Возвращайся через несколько дней."

# game/data/world_interactions/black_diamond_arena/aio.rpy:56
translate ru black_diamond_bookkeeper_talk_615eedc7:

    # MC "Okay."
    MC "Ладно."

# game/data/world_interactions/black_diamond_arena/aio.rpy:58
translate ru black_diamond_bookkeeper_talk_73727c63:

    # BOOKKEEPER "Beasts fight below, you bet."
    BOOKKEEPER "Звери дерутся внизу, делаешь ставку."

# game/data/world_interactions/black_diamond_arena/aio.rpy:59
translate ru black_diamond_bookkeeper_talk_376ff848:

    # BOOKKEEPER "Your beast wins, you get coin."
    BOOKKEEPER "Твой зверь побеждает — получаешь монеты."

# game/data/world_interactions/black_diamond_arena/aio.rpy:60
translate ru black_diamond_bookkeeper_talk_cba48cb5:

    # BOOKKEEPER "Zat's it, you want bet?"
    BOOKKEEPER "Вот и всё, хочешь поставить?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:63
translate ru black_diamond_bookkeeper_talk_menu_26b1e50b:

    # BOOKKEEPER "How much?"
    BOOKKEEPER "Сколько?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:75
translate ru black_diamond_bookkeeper_talk_menu_8a0c5ec4:

    # BOOKKEEPER "Very good!"
    BOOKKEEPER "Очень хорошо!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:76
translate ru black_diamond_bookkeeper_talk_menu_83429a1e:

    # BOOKKEEPER "Enjoy fight! Collect coin after if win!"
    BOOKKEEPER "Наслаждайся боем! Забирай монеты после победы!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:79
translate ru black_diamond_bookkeeper_talk_menu_577c9037:

    # BOOKKEEPER "Rules iz simple!"
    BOOKKEEPER "Правила просты!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:80
translate ru black_diamond_bookkeeper_talk_menu_824d265f:

    # BOOKKEEPER "You bet on either creature to win, first to kill zer other wins."
    BOOKKEEPER "Ставь на любого зверя, кто первый убьёт другого — побеждает."

# game/data/world_interactions/black_diamond_arena/aio.rpy:81
translate ru black_diamond_bookkeeper_talk_menu_ba9aaef0:

    # BOOKKEEPER "Az newbie, you iz only able to bet one thousand coins a week."
    BOOKKEEPER "Как новичок, ты можешь ставить только тысячу монет в неделю."

# game/data/world_interactions/black_diamond_arena/aio.rpy:82
translate ru black_diamond_bookkeeper_talk_menu_ec70c2c2:

    # BOOKKEEPER "Coin pay upfront before bet go on."
    BOOKKEEPER "Монеты платят заранее, до начала ставок."

# game/data/world_interactions/black_diamond_arena/aio.rpy:83
translate ru black_diamond_bookkeeper_talk_menu_b6289d56:

    # MC @ talk "That seems odd, why the limit?"
    MC @ talk "Это кажется странным, почему ограничение?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:84
translate ru black_diamond_bookkeeper_talk_menu_40d9f557:

    # BOOKKEEPER "Too many try cheat."
    BOOKKEEPER "Слишком много попыток сжульничать."

# game/data/world_interactions/black_diamond_arena/aio.rpy:85
translate ru black_diamond_bookkeeper_talk_menu_2ade3781:

    # BOOKKEEPER "One try poisoning a beasty and placing huge bet on other."
    BOOKKEEPER "Один попытался отравить зверя и поставить огромную ставку на другого."

# game/data/world_interactions/black_diamond_arena/aio.rpy:86
translate ru black_diamond_bookkeeper_talk_menu_f8b9be59:

    # BOOKKEEPER "Now, only trusted members can make big bets."
    BOOKKEEPER "Теперь только проверенные участники могут делать большие ставки."

# game/data/world_interactions/black_diamond_arena/aio.rpy:89
translate ru black_diamond_bookkeeper_talk_menu_b72566e1:

    # BOOKKEEPER "Than leave already!"
    BOOKKEEPER "Тогда уходи уже!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:133
translate ru black_diamond_arena_fight_3b26aa88:

    # MC "(Well... That's wasn't the easiest thing to watch.)"
    MC "(Что ж... Это было не самое лёгкое зрелище.)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:134
translate ru black_diamond_arena_fight_e66f7113:

    # MC "(Looks like I won though!)"
    MC "(Похоже, я всё же выиграл!)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:137
translate ru black_diamond_arena_fight_349520bc:

    # MC "(Damn... I lost.)"
    MC "(Чёрт... Я проиграл.)"

