
# game/data/world_locations/novaras/district_centre/dist_centre.rpy:49
translate ru lockedLines_novaras_palace_guards_0ecbb8d5:

    # "As I approached the Royal Palace, a couple of guards blocked my path."
    "Когда я приблизился к Королевскому дворцу, пара стражников преградила мне путь."

# game/data/world_locations/novaras/district_centre/dist_centre.rpy:54
translate ru lockedLines_novaras_palace_guards_37fdb915:

    # GUARD "Halt!"
    GUARD "Стой!"

# game/data/world_locations/novaras/district_centre/dist_centre.rpy:55
translate ru lockedLines_novaras_palace_guards_9000f7c1:

    # GUARD "State your business at the Royal Palace, citizen."
    GUARD "Назовите цель своего визита в Королевский дворец, гражданин."

# game/data/world_locations/novaras/district_centre/dist_centre.rpy:56
translate ru lockedLines_novaras_palace_guards_e9b16a80:

    # MC "I... don't really have any."
    MC "У меня... её, собственно, нет."

# game/data/world_locations/novaras/district_centre/dist_centre.rpy:57
translate ru lockedLines_novaras_palace_guards_e15dbbad:

    # "The other guard asked, in a surprisingly friendly tone:"
    "Второй стражник спросил удивительно дружелюбным тоном:"

# game/data/world_locations/novaras/district_centre/dist_centre.rpy:58
translate ru lockedLines_novaras_palace_guards_50148230:

    # GUARD "Sightseeing, eh?"
    GUARD "Осматриваешь достопримечательности, да?"

# game/data/world_locations/novaras/district_centre/dist_centre.rpy:60
translate ru lockedLines_novaras_palace_guards_0c1fdccc:

    # GUARD "Move on."
    GUARD "Проходи."

# game/data/world_locations/novaras/district_centre/dist_centre.rpy:62
translate ru lockedLines_novaras_palace_guards_5ad106e7:

    # "The guards clanged their way back to the immense gate."
    "Стража с лязгом вернулась к огромным воротам."

# game/data/world_locations/novaras/district_centre/dist_centre.rpy:63
translate ru lockedLines_novaras_palace_guards_2575acf3:

    # MC "Well, guess I'm not entering that place."
    MC "Что ж, похоже, мне туда не попасть."

