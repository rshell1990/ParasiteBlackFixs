# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:76
translate ru qst_guild_price_life_daughter_negotiate_12c9101e:

    # MARAUDER_LEADER "Hmm ... I suppose after all the trouble she's caused, the sooner I get her out of my hands, the better."
    MARAUDER_LEADER "Хм... Пожалуй, учитывая все проблемы, которые она причинила, чем скорее я избавлюсь от неё, тем лучше."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:77
translate ru qst_guild_price_life_daughter_negotiate_36584c3a:

