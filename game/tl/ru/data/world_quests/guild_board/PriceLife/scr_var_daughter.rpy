# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:65
translate ru qst_guild_price_life_daughter_threaten_a7eaedb0:

    # "Letting the Merchant's daughter out of the cage, she sheepishly hurried to hide behind me."
    "Выпустив дочь торговца из клетки, она робко поспешила спрятаться за моей спиной."

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:66
translate ru qst_guild_price_life_daughter_threaten_a6b2f2ca:

