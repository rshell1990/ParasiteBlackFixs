translate ru qst_guild_price_life_daughter_threaten_426baa97:

    # MARAUDER_LEADER "You think we're just going to walk away from here with nothing after risking our necks?!"
    MARAUDER_LEADER "Думаешь, мы просто так уйдём отсюда ни с чем, после того как рисковали своими шкурами?!"

# game/data/world_quests/guild_board/PriceLife/scr_var_daughter.rpy:58
translate ru qst_guild_price_life_daughter_threaten_cf373bd0:

