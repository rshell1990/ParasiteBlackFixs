# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:74
translate ru qst_guild_price_life_son_negotiate_8db2fb38:

    # MARAUDER_LEADER "Hmm ... I suppose after all the trouble he's caused, the sooner I get him out of my hands, the better."
    MARAUDER_LEADER "Хм... Пожалуй, после всех проблем которые он причинил, чем скорее я избавлюсь от него, тем лучше."

# game/data/world_quests/guild_board/PriceLife/scr_var_son.rpy:75
translate ru qst_guild_price_life_son_negotiate_9ade727a:

    # MARAUDER_LEADER "Fine, give us the coin and he's yours."
