# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3179
translate ru qst_JudgementDay_TrialOver_Banishment_53bfae89:

    # "At some point, one of the jury members threw a punch at another, and soon, the entire courtroom broke into a small brawl."
