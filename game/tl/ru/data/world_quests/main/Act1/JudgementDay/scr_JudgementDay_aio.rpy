translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_b70528c0:

    # KIARA @ angry "We should be meeting a friend here in one of the rooms upstairs."
    KIARA @ angry "Мы должны встретиться с другом здесь, в одной из комнат наверху."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3630
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_0d2e6967:

    # KIARA @ talk "{i}The one with a view so you might see the dragon to the east.{/i}"
    KIARA @ talk "{i}Та, из которой открывается вид, чтобы вы могли увидеть дракона на востоке.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3631
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6b161c8d:

    # "Rania's eyes widened as she smiled."
    "Глаза Рании расширились, и она улыбнулась."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3632
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_26dbca39:

    # RANIA @ smile "Ahh... Yes."
    RANIA @ smile "Ах... Да."

