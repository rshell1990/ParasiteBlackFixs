# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3543
translate ru qst_JudgementDay_PostQuestArrivedToHamun_ad7dd3d2:

    # "The guard looked us up and down before laughing."
    "Страж оглядел нас с ног до головы и рассмеялся."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3544
translate ru qst_JudgementDay_PostQuestArrivedToHamun_7454ce35:

    # GUARD "Only if you cause trouble."
    GUARD "Только если ты устроишь проблемы."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3545
translate ru qst_JudgementDay_PostQuestArrivedToHamun_9786878e:

    # GUARD "You start something, don't be surprised if you find yourself losing your head."
    GUARD "Начнёшь что-то — не удивляйся, если окажешься без головы."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3549
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_233a9947:

    # GUARD "Neigh."
    GUARD "Нет."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3550
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_a5c97cc1:

    # GUARD "But no laws doesn't mean no ones in charge."
    GUARD "Но отсутствие законов не значит, что здесь нет главных."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3551
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_592f6245:

    # GUARD "Pretty much every business in the city has some kind of security... Fuck around, and you'll find yourself skewed on the pointy end of one of them."
    GUARD "Практически у каждого бизнеса в городе есть какая-то охрана... Начнёшь выёживаться — и окажешься насаженным на острый конец у кого-нибудь из них."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3554
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_1b30c97c:

    # GUARD "{i}Lord{/i} Iryiad runs the most powerful clique, the Zizi, they run the security detail around the city and control the docks."
    GUARD "{i}Лорд{/i} Ириад возглавляет самую могущественную клику — Зизи, они обеспечивают охрану в городе и контролируют доки."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3555
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_148038fe:

    # GUARD "But there's also the Quaygon, the Vulmar and an endless sea of smaller gangs who manage the whores, the raza, and the {i}'protection'{/i} of the local businesses."
    GUARD "Но есть ещё Квейгон, Вульмар и бесконечное море мелких банд, которые управляют шлюхами, разой и {i}'защитой'{/i} местного бизнеса."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3556
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_3712bd09:

    # MC @ think "You seem very forthcoming with all this."
    MC @ think "Ты очень охотно всё это рассказываешь."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3557
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_659b07b0:

    # GUARD "Some people come here and think because we've no laws they can just do {i}whatever{/i} they like."
    GUARD "Некоторые приезжают сюда и думают, что раз у нас нет законов, то можно делать {i}что угодно{/i}."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3558
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_2750a12b:

    # GUARD "It's best to let them know that would be a poor choice."
    GUARD "Лучше дать им понять, что это плохая идея."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3561
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_d13669b0:

    # GUARD "Do I look like a tour guide?"
    GUARD "Я похож на экскурсовода?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3562
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_d3bb6433:

    # GUARD "Fuck off, buy yourself a couple sellswords and have them show you around!"
    GUARD "Отвали, найми пару наёмников и пусть они тебе всё тут покажут!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3566
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_276c314a:

    # GUARD "Go on then, in ya get."
    GUARD "Ну давай тогда, заходи."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3574
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_15e2997a:

    # KIARA @ happy "Ahh... Finally! We've made it."
    KIARA @ happy "Ах... Наконец-то! Мы добрались."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3575
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_310c3340:

