translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6eec3fc9:

    # MC @ talk "So, what's your plan now you're here?"
    MC @ talk "Итак, какие у тебя планы теперь, когда ты здесь?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3597
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_64bb87e3:

    # VES @ talk "I'm looking for someone."
    VES @ talk "Я ищу одного человека."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3598
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_17dd6ac1:

    # VES @ blush "... But, perhaps if you don't mind, I could stay with you and the others for a while."
    VES @ blush "... Но, возможно если ты не против, я могла бы пожить какое-то время с тобой и остальными."

