translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_3a698037:

    # KIARA @ talk "{i}The Pale Dragon.{/i}"
    KIARA @ talk "{i}Бледный Дракон.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3577
translate ru qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_6351a36b:

