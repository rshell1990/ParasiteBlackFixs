    PRINCESS_CECILIA "Вы будете молчать, уважаемый судья."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3200
translate ru qst_JudgementDay_TrialOver_Banishment_f6e05147:

