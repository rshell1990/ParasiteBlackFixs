    JUDGE_FALWIND "ПОРЯДОК! ПОРЯДОК!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3182
translate ru qst_JudgementDay_TrialOver_Banishment_c4828506:

