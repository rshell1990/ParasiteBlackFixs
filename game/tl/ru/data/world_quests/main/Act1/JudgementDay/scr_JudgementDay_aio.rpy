# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3178
translate ru qst_JudgementDay_TrialOver_Banishment_d4fec73d:

    # "Judge Falwind smashed his gavel down repeatedly, but the room was already spiraling out of control."
