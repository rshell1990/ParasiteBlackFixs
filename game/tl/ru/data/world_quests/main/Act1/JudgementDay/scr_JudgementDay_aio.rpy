    GUARD "Нам пришлось применить жёсткие меры сдерживания."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2588
translate ru qst_JudgementDay_TrialStart_7fad3231:

    # MC @ angry "YOU BEAT HIM HALF TO DEATH!"
    MC @ angry "ВЫ ИЗБИЛИ ЕГО ДО ПОЛУСМЕРТИ!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2591
translate ru qst_JudgementDay_TrialStart_be7b5f6d:

    # "*BANG!*"
    "*БАМ!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2592
translate ru qst_JudgementDay_TrialStart_f6fda186:

    # "Falwind's gavel slammed down."
    "Молоток Фолвинда обрушился на стол."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2594
translate ru qst_JudgementDay_TrialStart_f154a8d0:

    # JUDGE_FALWIND "Control your emotions, nine-six-one, or I shall have you reprimanded further."
    JUDGE_FALWIND "Контролируйте свои эмоции, девять-шесть-один, или я прикажу наказать вас ещё строже."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2595
translate ru qst_JudgementDay_TrialStart_6f0d1973:

    # "With a heavy sigh, he glanced back at Markus, who lay crumpled on the floor."
    "Тяжело вздохнув, он взглянул на Маркуса, который лежал на полу сжавшись в комок."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2596
translate ru qst_JudgementDay_TrialStart_643281fa:

    # JUDGE_FALWIND "Given the unfortunate state of your accomplice, we will proceed with your testimony speaking on his behalf."
    JUDGE_FALWIND "Учитывая плачевное состояние вашего сообщника, мы продолжим ваши показания, выступая от его имени."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2601
translate ru qst_JudgementDay_TrialStart_5b071465:

    # JUDGE_FALWIND "Hold your tongue, nine-six-one! I will not tolerate contempt in my court!"
    JUDGE_FALWIND "Придержите язык, девять-шесть-один! Я не потерплю неуважения в своём суде!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2604
translate ru qst_JudgementDay_TrialStart_38318e26:

    # "The judge hesitated, then waved a hand dismissively."
    "Судья замешкался, затем отмахнулся рукой."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2605
translate ru qst_JudgementDay_TrialStart_42e2d16d:

    # JUDGE_FALWIND "Very well. Summon a Mage of Palam to tend to him."
    JUDGE_FALWIND "Хорошо. Вызовите Мага Палама чтобы позаботиться о нём."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2607
translate ru qst_JudgementDay_TrialStart_4f2b5c04:

    # "The judge nodded, satisfied with my compliance."
    "Судья кивнул, удовлетворённый моей покорностью."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2609
translate ru qst_JudgementDay_TrialStart_14adb04d:

    # JUDGE_FALWIND "Has the prosecution arrived?"
    JUDGE_FALWIND "Прокурор уже прибыл?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2610
translate ru qst_JudgementDay_TrialStart_fdc8f651:

    # GUARD "She has, Judge Falwind."
    GUARD "Она здесь, Судья Фолвинд."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2611
translate ru qst_JudgementDay_TrialStart_cd89cb8b:

    # JUDGE_FALWIND "Send her in."
    JUDGE_FALWIND "Впустите её."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2612
translate ru qst_JudgementDay_TrialStart_47151da1:

    # "The massive doors opened once more."
    "Массивные двери снова открылись."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2613
translate ru qst_JudgementDay_TrialStart_36d06b98:

    # "A figure stepped forward."
    "Вперёд вышел человек."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2614
translate ru qst_JudgementDay_TrialStart_4fc678a8:

    # "Not Inquisitor Henvak, as expected."
    "Не Инквизитор Хенвак, как ожидалось."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2615
translate ru qst_JudgementDay_TrialStart_af94376b:

    # "But an older woman. Head Inquisitor Marion."
    "А пожилая женщина. Главный Инквизитор Марион."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2617
translate ru qst_JudgementDay_TrialStart_e682a58d:

    # "Uneasy murmurs rose across the court."
    "По залу прокатился тревожный шёпот."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2618
translate ru qst_JudgementDay_TrialStart_32fb436b:

    # "Even Judge Falwind stiffened at the sight of her."
    "Даже Судья Фолвинд напрягся при её виде."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2619
translate ru qst_JudgementDay_TrialStart_6ebe2672:

    # JUDGE_FALWIND "H-Head Inquisitor!"
    JUDGE_FALWIND "Г-Главный Инквизитор!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2620
translate ru qst_JudgementDay_TrialStart_8d9108b7:

    # MARION "I trust I am not late."
    MARION "Надеюсь, я не опоздала."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2622
translate ru qst_JudgementDay_TrialStart_f9ebf287:

    # JUDGE_FALWIND "E-Er, no, Inquisitor. But… on the paperwork, it states that Inquisitor Henvak was to handle the prosecution."
    JUDGE_FALWIND "Э-э, нет, Инквизитор. Но… в документах указано, что обвинение должен вести Инквизитор Хенвак."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2623
translate ru qst_JudgementDay_TrialStart_90e8994d:

    # MARION "Henvak is indisposed."
    MARION "Хенвак нездоров."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2624
translate ru qst_JudgementDay_TrialStart_b657aaee:

    # MARION "Given the attention this trial has drawn, I have decided to intercede."
    MARION "Учитывая внимание, которое привлекло это судебное разбирательство, я решила вмешаться."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2625
translate ru qst_JudgementDay_TrialStart_a4e6991c:

    # JUDGE_FALWIND "I… see. But Head Inquisitor, this is most unorthodox. Have you had adequate time to prepare?"
    JUDGE_FALWIND "Я… понимаю. Но Главный Инквизитор, это крайне необычно. У вас было достаточно времени на подготовку?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2626
translate ru qst_JudgementDay_TrialStart_30dfe46f:

    # MARION "I have, your honor."
    MARION "Было, ваша честь."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2627
translate ru qst_JudgementDay_TrialStart_273760c0:

    # "The judge clearly did not like this."
    "Судье явно это не понравилось."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2628
translate ru qst_JudgementDay_TrialStart_3c7efe4d:

    # "But denying Marion's authority was… unwise."
    "Но оспаривать полномочия Марион было… неразумно."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2629
translate ru qst_JudgementDay_TrialStart_ce31a9d3:

    # JUDGE_FALWIND "Very well."
    JUDGE_FALWIND "Очень хорошо."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2630
translate ru qst_JudgementDay_TrialStart_982fa314:

    # JUDGE_FALWIND "With all parties present, would the prosecution like to make its opening statement?"
    JUDGE_FALWIND "При наличии всех сторон, обвинение желает сделать вступительное заявление?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2631
translate ru qst_JudgementDay_TrialStart_2eb85663:

    # MARION "I would, your honor."
    MARION "Желаю, ваша честь."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2632
translate ru qst_JudgementDay_TrialStart_f15830e3:

    # "The Head Inquisitor stepped forward."
    "Главный Инквизитор выступила вперёд."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2633
translate ru qst_JudgementDay_TrialStart_14740c7f:

    # "Her voice cut through the chamber, sharp and commanding."
    "Её голос прорезал зал, резкий и властный."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2634
translate ru qst_JudgementDay_TrialStart_a1d051f8:

    # MARION "Today, the prosecution will prove—beyond doubt—that this creature is the result of dark magecraft!"
    MARION "Сегодня, обвинение докажет — вне всяких сомнений — что это существо является результатом тёмного магического искусства!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2635
translate ru qst_JudgementDay_TrialStart_7b0f4d51:

    # MARION "That it has been consorting with the Demorai."
    MARION "Что оно вступило в сговор с Деморай."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2636
translate ru qst_JudgementDay_TrialStart_90e0a29b:

    # MARION "That it is at the very heart of a conspiracy to corrupt this city's highest officials!"
    MARION "Что оно находится в самом центре заговора по разложению высших чиновников этого города!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2638
translate ru qst_JudgementDay_TrialStart_8f14909a:

    # "The courtroom exploded in voices."
    "Зал суда взорвался голосами."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2639
translate ru qst_JudgementDay_TrialStart_1c998cdd:

    # "Gasps. Whispers. Outright accusations."
    "Вздохи. Шёпот. Открытые обвинения."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2641
translate ru qst_JudgementDay_TrialStart_be7b5f6d_1:

    # "*BANG!*"
    "*БАМ!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2642
translate ru qst_JudgementDay_TrialStart_be7b5f6d_2:

    # "*BANG!*"
    "*БАМ!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2643
translate ru qst_JudgementDay_TrialStart_b7f53723:

    # JUDGE_FALWIND "ORDER! ORDER!"
    JUDGE_FALWIND "ПОРЯДОК! ПОРЯДОК!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2645
translate ru qst_JudgementDay_TrialStart_b42540ba:

    # "As silence returned, he exhaled deeply."
    "Когда воцарилась тишина, он глубоко выдохнул."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2646
translate ru qst_JudgementDay_TrialStart_cb980af3:

    # JUDGE_FALWIND "Prosecutor Marion, these are serious accusations on an already charged case. Do you have evidence to support such claims?"
    JUDGE_FALWIND "Прокурор Марион, это серьёзные обвинения по и без того напряжённому делу. У вас есть доказательства, подтверждающие такие заявления?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2647
translate ru qst_JudgementDay_TrialStart_868965c1:

    # MARION "I do, your honor."
    MARION "Да, ваша честь."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2648
translate ru qst_JudgementDay_TrialStart_76365bfb:

    # JUDGE_FALWIND "Then let us proceed."
    JUDGE_FALWIND "Тогда продолжим."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2649
translate ru qst_JudgementDay_TrialStart_514b8f61:

    # "His gaze turned to me."
    "Его взгляд обратился ко мне."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2650
translate ru qst_JudgementDay_TrialStart_6114110e:

    # JUDGE_FALWIND "And you, nine-six-one—"
    JUDGE_FALWIND "А вы, девять-шесть-один—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2651
translate ru qst_JudgementDay_TrialStart_2d0862fc:

    # JUDGE_FALWIND "What is your opening statement?"
    JUDGE_FALWIND "Каково ваше вступительное слово?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2655
translate ru qst_JudgementDay_TrialStart_0f402d51:

    # MC @ angry "We are loyal subjects of Alderay! We fought and bled for this empire a thousand times!"
    MC @ angry "Мы — верные подданные Алдерея! Мы тысячу раз сражались и проливали кровь за эту империю!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2656
translate ru qst_JudgementDay_TrialStart_6ea465c8:

    # MC @ angry "And we would do it a thousand times more!"
    MC @ angry "И мы сделали бы это ещё тысячу раз!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2658
translate ru qst_JudgementDay_TrialStart_b07c67fe:

    # "There was a murmur of approval among the jury."
    "Среди присяжных пробежал одобрительный ропот."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2662
translate ru qst_JudgementDay_TrialStart_16cb8271:

    # "My voice was steady. Determined."
    "Мой голос был твёрдым. Решительным."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2668
translate ru qst_JudgementDay_TrialStart_cb6d2bee:

    # "The jury turned against me. Angry whispers spread like wildfire."
    "Присяжные повернулись против меня. Гневные шёпоты распространились, как лесной пожар."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2669
translate ru qst_JudgementDay_TrialStart_a26d35f8:

    # "Marion smiled."
    "Марион улыбнулась."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2671
translate ru qst_JudgementDay_TrialStart_be7b5f6d_3:

    # "*BANG!*"
    "*БАХ!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2673
translate ru qst_JudgementDay_TrialStart_be7b5f6d_4:

    # "*BANG!*"
    "*БАХ!*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2674
translate ru qst_JudgementDay_TrialStart_9a7d3f70:

    # JUDGE_FALWIND "ORDER! I will not tolerate outbursts in this court!"
    JUDGE_FALWIND "ПОРЯДОК! Я не потерплю вспышек в этом зале суда!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2675
translate ru qst_JudgementDay_TrialStart_cb7bd914:

    # "The judge sighed."
    "Судья вздохнул."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2678
translate ru qst_JudgementDay_TrialStart_c9d2f94e:

    # JUDGE_FALWIND "Head Inquisitor Marion, present your first witness."
    JUDGE_FALWIND "Главный инквизитор Марион, представьте своего первого свидетеля."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2679
translate ru qst_JudgementDay_TrialStart_74d2e78e:

    # MARION @ smile "Gladly, your honor."
    MARION @ smile "С удовольствием, ваша честь."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2680
translate ru qst_JudgementDay_TrialStart_a1365872:

    # MARION @ talk "The prosecution calls…"
    MARION @ talk "Обвинение вызывает…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2681
translate ru qst_JudgementDay_TrialStart_1591d5dc:

    # MARION @ talk "Captain Nyx of the City Guard."
    MARION @ talk "Капитана Никс из городской стражи."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2684
translate ru qst_JudgementDay_TrialStart_591b5abe:

    # "Quiet murmurs rose up as the doors swung open and Captain Nyx, stood proud, made her way silently to the stand, refusing to break her utterly neutral expression."
    "Тихий ропот поднялся, когда двери распахнулись, и Капитан Никс, гордо выпрямившись, молча направилась к свидетельскому месту, сохраняя совершенно нейтральное выражение лица."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2686
translate ru qst_JudgementDay_TrialStart_a62bf6d9:

    # MARION @ talk "Captain Nyx... Could you tell us more about your rank and what your duty entails?"
    MARION @ talk "Капитан Никс... Не могли бы вы рассказать нам подробнее о вашем звании и ваших обязанностях?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2687
translate ru qst_JudgementDay_TrialStart_b3dd3d77:

    # NYX @ talk "I am Captain of the city guard of Novaras, I am charged with keeping the city safe both internally and externally from threats, and maintaining peace within the city's walls."
    NYX @ talk "Я Капитан городской стражи Новараса. На мне лежит ответственность за безопасность города как от внутренних, так и от внешних угроз, а также за поддержание порядка в пределах городских стен."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2688
translate ru qst_JudgementDay_TrialStart_1412d041:

    # MARION @ smile "I see..."
    MARION @ smile "Понятно..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2689
translate ru qst_JudgementDay_TrialStart_a854db35:

    # MARION @ talk "And tell me, what are you direct resonsibilites when it pertains to inquisitor business?"
    MARION @ talk "И скажите мне, каковы ваши прямые обязанности в том, что касается дел инквизиции?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2690
translate ru qst_JudgementDay_TrialStart_f114f57d:

    # NYX @ angry "... To report anything suspect of Dark magecraft to the inquisition at once, or anything related to a Demorai pressence in the city."
    NYX @ angry "... Немедленно докладывать инквизиции обо всём подозрительном связанном с тёмным колдовством, или о любом присутствии Деморай в городе."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2691
translate ru qst_JudgementDay_TrialStart_71cf5aa5:

    # MARION @ smile "Interesting..."
    MARION @ smile "Интересно..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2692
translate ru qst_JudgementDay_TrialStart_6879d8fd:

    # MARION @ talk "So, tell me."
    MARION @ talk "Итак, скажите."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2693
translate ru qst_JudgementDay_TrialStart_3a4ddeeb:

    # MARION @ talk "Are these your signatures on these reports?"
    MARION @ talk "Это ваши подписи на этих отчётах?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2694
translate ru qst_JudgementDay_TrialStart_105627b8:

    # "In her hands, the head inquisitor waved about a series of papers before throwing them down in front of Nyx, who uncomfortably inspected them."
    "В руках верховного инквизитора замелькала стопка бумаг, прежде чем она швырнула их перед Никс, которая неловко принялась их изучать."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2695
translate ru qst_JudgementDay_TrialStart_a03c590d:

    # NYX @ angry "Yes... This is my signature."
    NYX @ angry "Да... Это мои подписи."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2696
translate ru qst_JudgementDay_TrialStart_c33784e9:

    # MARION @ angry "Why then, did you choose to send false reports when asked to investigate prisoners nine-six-one and eight-four-one?"
    MARION @ angry "Тогда почему вы решили отправить ложные отчёты, когда вас попросили расследовать дела заключённых девять-шесть-один и восемь-четыре-один?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2697
translate ru qst_JudgementDay_TrialStart_3ad74a5b:

    # "There was a heavy, long pause."
