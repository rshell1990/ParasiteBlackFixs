    # SILVER_KNIGHT "…Then you also have my thanks."
    SILVER_KNIGHT "…Тогда и вам моя благодарность."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1794
translate ru qst_JudgementDay_RescueMages_MoveOn_6186d54d:

    # ERIKA "We're heading up the wall. Is the prince safe?"
    ERIKA "Мы направляемся на стену. Принц в безопасности?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1795
translate ru qst_JudgementDay_RescueMages_MoveOn_c6f5af92:

    # "The knight nodded slightly."
