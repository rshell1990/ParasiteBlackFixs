    # NYX "I don't know how much longer they can hold out up there with the lines severed!"
    NYX "Я не знаю, сколько ещё они продержатся там наверху с оборванными линиями!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1403
translate ru qst_JudgementDay_GoToArmyDist_fbf6224f:

    # ERIKA "Yes, Captain."
    ERIKA "Да, Капитан."

