
# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:2
translate ru qst_bloodhound_0_pitch_8a8224c2:

    # NYX @ talk "Well, looks like you can handle yourself at least."
    NYX @ talk "Ну, похоже, ты хотя бы можешь за себя постоять."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:3
translate ru qst_bloodhound_0_pitch_8c24fcd7:

    # NYX @ talk "I have another job for you, if you're still interested in a bit more coin that is."
    NYX @ talk "У меня для тебя есть ещё одна работа, если ты всё ещё заинтересован в небольшой прибавке к монетам."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:4
translate ru qst_bloodhound_0_pitch_42970179:

    # MC @ talk "Tell me about the job first."
    MC @ talk "Сначала расскажи о работе."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:5
translate ru qst_bloodhound_0_pitch_cf6ed62f:

    # NYX @ talk "An informant of ours named Azul has gone missing and I can't spare the men to check on him."
    NYX @ talk "Наш информатор по имени Азул пропал, и у меня нет свободных людей, чтобы проверить, что с ним."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:7
translate ru qst_bloodhound_0_pitch_aa937f61:

    # NYX @ talk "The last time he made contact he was... {i}erratic.{/i}"
    NYX @ talk "В последний раз, когда он выходил на связь, он был... {i}неадекватным.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:8
translate ru qst_bloodhound_0_pitch_fb490735:

    # NYX @ talk "I think he was on to something heavy, but now, no one can find him."
    NYX @ talk "Думаю, он напал на что-то серьёзное, но теперь его никто не может найти."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:9
translate ru qst_bloodhound_0_pitch_2aa577bc:

    # MC @ talk "Is he dead?"
    MC @ talk "Он мёртв?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:10
translate ru qst_bloodhound_0_pitch_5ef3b5fb:

    # NYX @ shock "I hope not, he's one of our best."
    NYX @ shock "Надеюсь, что нет, он один из наших лучших."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:11
translate ru qst_bloodhound_0_pitch_268c87af:

    # NYX @ talk "You can't miss him, he carries around that fucking bird on his shoulder wherever he goes..."
    NYX @ talk "Ты его не пропустишь, он таскает эту чёртову птицу на плече, куда бы ни пошёл..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:12
translate ru qst_bloodhound_0_pitch_5498adaf:

    # NYX @ angry "Damn thing shit all over my desk once."
    NYX @ angry "Проклятая тварь как-то раз обгадила весь мой стол."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:13
translate ru qst_bloodhound_0_pitch_2f501b8f:

    # NYX @ talk "So... What do you say?"
    NYX @ talk "Итак... Что скажешь?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:16
translate ru qst_bloodhound_0_pitch_260c1b2a:

    # NYX @ talk "Look, I have a limited fund I can spare on you, unlike {i}some{/i} divisions."
    NYX @ talk "Слушай, у меня ограниченный фонд, который я могу выделить на тебя, в отличие от {i}некоторых{/i} подразделений."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:17
translate ru qst_bloodhound_0_pitch_50c41c6b:

    # NYX @ talk "I don't have some infinite pool of coin and resources to pull from."
    NYX @ talk "У меня нет какого-то бесконечного запаса монет и ресурсов, из которого можно черпать."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:18
translate ru qst_bloodhound_0_pitch_2414a40b:

    # NYX @ talk "That said, you'll be paid well enough."
    NYX @ talk "Тем не менее, тебе будут платить достаточно хорошо."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:19
translate ru qst_bloodhound_0_pitch_0e46659a:

    # NYX @ talk "How does five hundred coins sound?"
    NYX @ talk "Как насчёт пятисот монет?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:22
translate ru qst_bloodhound_0_pitch_1f41cbe0:

    # NYX @ talk "...Fine, six hundred coins and not coin more."
    NYX @ talk "...Ладно, шестьсот монет и ни монетой больше."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:26
translate ru qst_bloodhound_0_pitch_004e4ebe:

    # NYX @ talk "I can't give you anything from the armory but, here, take these from my personal stash."
    NYX @ talk "Я не могу дать тебе ничего из арсенала, но вот, возьми это из моего личного запаса."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:31
translate ru qst_bloodhound_0_pitch_fd5c4a81:

    # NYX @ laugh "Excellent."
    NYX @ laugh "Отлично."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:32
translate ru qst_bloodhound_0_pitch_529b6398:

    # NYX @ talk "There you go."
    NYX @ talk "Вот, держи."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:36
translate ru qst_bloodhound_0_pitch_d49b20da:

    # NYX @ angry "Don't waste my time, return when you've made up your mind."
    NYX @ angry "Не трать моё время, возвращайся, когда примешь решение."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:39
translate ru qst_bloodhound_0_pitch_5c47a36b:

    # NYX @ talk "Last time Azul was seen, he was speaking to some Adventurers at the Guild."
    NYX @ talk "Последний раз Азула видели, когда он разговаривал с некоторыми Искателями приключений в Гильдии."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:40
translate ru qst_bloodhound_0_pitch_b8b70251:

    # NYX @ talk "Some small time D-listers, call themselves {i}The Guardians of the Realm...{/i}"
    NYX @ talk "Какие-то мелкие сошки, звёзды уровня D, называют себя {i}Хранителями Реальности...{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:41
translate ru qst_bloodhound_0_pitch_3cc49680:

    # NYX @ angry "Pretentious cocksuckers, anyway, I'd start with them."
    NYX @ angry "Самодовольные мудаки, в любом случае, я бы начала с них."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:46
translate ru qst_bloodhound_0_pitch_revisit_74439026:

