    MC "(Кто-то здесь должен знать что-то о 'Стражах королевства', может, стоит спросить Тею?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:9
translate ru qst_bloodhound_1_TheaOnGuardians_189d4acd:

    # THEA @ talk "Hm? Well, not too much."
    THEA @ talk "Хм? Ну, не слишком много."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:10
translate ru qst_bloodhound_1_TheaOnGuardians_9f40d81a:

    # THEA @ talk "They're newcomers but they seem quite popular."
    THEA @ talk "Они новички, но кажутся довольно популярными."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:11
translate ru qst_bloodhound_1_TheaOnGuardians_dd63aafe:

    # THEA @ scared "Maybe a little too cocky though."
    THEA @ scared "Хотя, возможно, немного слишком самоуверенные."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:12
translate ru qst_bloodhound_1_TheaOnGuardians_b6feebab:

    # MC @ talk "Not a fan?"
    MC @ talk "Не фанат?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:13
translate ru qst_bloodhound_1_TheaOnGuardians_68490604:

    # THEA @ talk "Mm, every rookie team thinks they're the chosen ones or something."
    THEA @ talk "Мм, каждая команда новичков думает, что они избранные или что-то в этом роде."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:14
translate ru qst_bloodhound_1_TheaOnGuardians_07b3b10c:

    # THEA @ smile2 "I prefer the ones who actually manage to stick around."
    THEA @ smile2 "Я предпочитаю тех, кто действительно умудряется задержаться."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:15
translate ru qst_bloodhound_1_TheaOnGuardians_7805f446:

    # MC @ talk "Where are they now?"
    MC @ talk "Где они сейчас?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:16
translate ru qst_bloodhound_1_TheaOnGuardians_47145c71:

    # THEA @ talk "They took on a quest to take on a giant slimelark."
    THEA @ talk "Они взяли квест на гигантского слаймларка."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:17
translate ru qst_bloodhound_1_TheaOnGuardians_4e1580f2:

    # MC @ surprised "A what?"
    MC @ surprised "На что?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:18
translate ru qst_bloodhound_1_TheaOnGuardians_f7d02ddf:

    # THEA @ talk "Uhh, think a very angry sentient pool of gunk that will force its way into you and consume you inside out."
    THEA @ talk "Эээ, представь себе очень злую разумную лужу слизи, которая пробивается внутрь тебя и пожирает изнутри."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:19
translate ru qst_bloodhound_1_TheaOnGuardians_1cdd0735:

    # MC @ talk "Can they handle it?"
    MC @ talk "Они справятся?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:20
translate ru qst_bloodhound_1_TheaOnGuardians_a2519c48:

    # THEA @ sad "I don't know... A slimelark isn't something to shrug off if you're a rookie."
    THEA @ sad "Не знаю... Слаймларк — это не то, что можно просто отмахнуться, если ты новичок."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:21
translate ru qst_bloodhound_1_TheaOnGuardians_2455d26f:

    # THEA @ sad "Especially the one that's been causing so much trouble."
    THEA @ sad "Особенно тот, который причиняет столько проблем."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:22
translate ru qst_bloodhound_1_TheaOnGuardians_022994e2:

    # THEA @ sad "I told them not to take it but, when you've got something to prove..."
    THEA @ sad "Я говорила им не браться за это, но когда нужно что-то доказать..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:23
translate ru qst_bloodhound_1_TheaOnGuardians_c1b60765:

    # THEA @ talk "Anyway, the thing has been sighted near lake Balun, you know, a short hike to the West?"
    THEA @ talk "В любом случае, эту штуку видели возле озера Балун, знаешь, короткий поход на запад?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:24
translate ru qst_bloodhound_1_TheaOnGuardians_261d13c3:

    # THEA @ scared "Apparently its been pulling people in when they get too close to the water."
    THEA @ scared "Похоже, он затягивает людей, когда они подходят слишком близко к воде."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:25
translate ru qst_bloodhound_1_TheaOnGuardians_23817d50:

    # MC @ talk "Thanks for the information."
    MC @ talk "Спасибо за информацию."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:26
translate ru qst_bloodhound_1_TheaOnGuardians_d05df937:

    # THEA @ sad "If you're thinking of going after them, I'd suggest being prepared..."
    THEA @ sad "Если ты думаешь пойти за ними, я бы посоветовала подготовиться..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:27
translate ru qst_bloodhound_1_TheaOnGuardians_8f6a6938:

    # THEA @ talk "Slimelarks are difficult beasts."
    THEA @ talk "Слаймларки — трудные звери."

# game/data/world_quests/main/Act1/TheBloodhound/scr_1.rpy:28
translate ru qst_bloodhound_1_TheaOnGuardians_a9bcd73d:

    # MC @ talk "I'll take your word for it."
    MC @ talk "Поверю тебе на слово."

