# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:97
translate ru qst_bloodhound_3_toBasement_eaa30016:

    # "Heading down into the darkness with a lit torch, each step echoing as I descended down."
    "Спускаясь в темноту с зажжённым факелом, каждый шаг отдавался эхом по мере моего спуска."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:100
translate ru qst_bloodhound_3_toBasement_510bae7c:

    # "Down the stairs, I could hear the sound of dripping grow louder."
    "Спускаясь по лестнице, я слышал, как звук капель становился громче."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:101
translate ru qst_bloodhound_3_toBasement_04b96fb8:

    # "Through a small underground passage, I could see a light at the end of the tunnel."
    "Через небольшой подземный проход я увидел свет в конце туннеля."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:102
translate ru qst_bloodhound_3_toBasement_c439e1b9:

    # "Moving towards and peering around the corner..."
    "Продвигаясь вперёд и заглядывая за угол..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:103
translate ru qst_bloodhound_3_toBasement_69649a42:

    # "A nightmare awaited me."
    "Меня ждал кошмар."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:110
translate ru qst_bloodhound_3_toBasement_6706efee:

    # "The man I presumed to be Azul hung upside down, his lower jaw broken and hang by the thinnest thread of flesh."
    "Человек, которого я предположительно принял за Азула, висел вниз головой, его нижняя челюсть была сломана и держалась на тончайшей нити плоти."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:111
translate ru qst_bloodhound_3_toBasement_8f6c41e0:

    # "His eyes were torn out leaving red trails of blood decorating his horrified, pale face."
    "Его глаза были вырваны, оставляя красные следы крови, украшавшие его ужасное, бледное лицо."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:112
translate ru qst_bloodhound_3_toBasement_0d45b3d7:

    # "His body desecrated, long hooks dug into the flesh pulling back sheets of flesh as a pool of blood circled his body beneath."
    "Его тело было осквернено: длинные крюки впились в плоть, оттягивая пласты кожи, а лужа крови растекалась под его телом."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:113
translate ru qst_bloodhound_3_toBasement_661276f1:

    # "In his exposed ribcage, a crude cage was formed with sharp metal shards, inside a black crow cried as it pecked at his insides angrily."
    "В его обнажённой грудной клетке была сооружена грубая клетка из острых металлических осколков, внутри которой чёрный ворон кричал, яростно клюя его внутренности."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:114
translate ru qst_bloodhound_3_toBasement_810f6de6:

    # MC @ talk "{i}...Gods.{/i}"
    MC @ talk "{i}...Боги.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:115
translate ru qst_bloodhound_3_toBasement_3f254257:

    # "The repugnant smell of rotting flesh began to make me nearly hurl as a dozen flies circled around the pale flesh."
    "Отвратительный запах гниющей плоти начал вызывать у меня рвотные позывы, в то время как дюжина мух кружила вокруг бледной кожи."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:116
translate ru qst_bloodhound_3_toBasement_c3c642d0:

    # "Behind me, I heard the sounds of some mechanism ticking..."
    "Позади меня я услышал звук какого-то механизма, тикающего..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:119
translate ru qst_bloodhound_3_toBasement_19ed433f:

    # "Sensing danger, I turned."
    "Почувствовав опасность, я обернулся."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:123
translate ru qst_bloodhound_3_toBasement_c0466f52:

    # "A man in black stood before me, his face not visible behind the mask and strange goggles, unnerving ticking sound coming from inside his chest."
    "Передо мной стоял человек в чёрном, его лицо не было видно из-за маски и странных очков, а из его груди доносился тревожный тикающий звук."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:124
translate ru qst_bloodhound_3_toBasement_988c5159:

    # "The thing moved jankily, making strange sounds as it curiously turned its head to look at me before drawing out the long blades from its arms."
    "Эта штука двигалась рывками, издавая странные звуки, любопытно повернула голову, чтобы взглянуть на меня, а затем вытащила длинные лезвия из своих рук."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:125
translate ru qst_bloodhound_3_toBasement_4277bc35:

    # MC @ angry "I take it talking is out of the question?"
    MC @ angry "Полагаю, разговор исключён?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:126
translate ru qst_bloodhound_3_toBasement_c8cb10b4:

    # "The thing stepped forward, its hand shaking slightly."
    "Существо шагнуло вперёд, его рука слегка дрожала."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:131
translate ru qst_bloodhound_3_toBasement_9a8e3593:

    # MC @ angry "Fuck!"
    MC @ angry "Чёрт!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:140
translate ru qst_bloodhound_3_toBasement_3ff24643:

    # "Once again, I quickly tore from my flesh just as the thing was about to strike, barely blocking it in time with my own claws and managing to push it back."
    "Вновь я резко вырвался из плоти как раз в тот момент, когда существо собиралось нанести удар, едва успев блокировать его собственными когтями и сумев оттолкнуть его."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:142
translate ru qst_bloodhound_3_toBasement_ee112fff:

    # MC "No choice now!"
    MC "Выбора больше нет!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:157
translate ru qst_bloodhound_3_toBasement_c0b25ad9:

    # "Dodging left and right, the man in black moved quicker than I anticipated, dodging most of my strikes and managing to land hit after hit against me."
    "Уворачиваясь влево и вправо, человек в чёрном двигался быстрее, чем я ожидал, уклоняясь от большинства моих ударов и успевая наносить удар за ударом по мне."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:158
translate ru qst_bloodhound_3_toBasement_ec059881:

    # "Its blades were unlike any other blade I'd seen before."
    "Его клинки были непохожи ни на один другой клинок, что я видел прежде."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:159
translate ru qst_bloodhound_3_toBasement_4532cba5:

    # "Perhaps they were enchanted, but they seemed sharper and able to cut at my flesh unlike any other."
    "Возможно, они были зачарованы, но казались острее и способными резать мою плоть, как никакие другие."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:160
translate ru qst_bloodhound_3_toBasement_b7befe8a:

    # "I managed to strike it with my tail, piercing a gaping hole through its chest."
    "Мне удалось ударить его хвостом, пробив зияющую дыру в его груди."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:161
translate ru qst_bloodhound_3_toBasement_1c0b9dcc:

    # "But instead of turning limp, it slashed down, causing a painful wound in my tail as it continued on despite its horrific injury."
    "Но вместо того, чтобы обмякнуть, он рубанул вниз, нанеся болезненную рану на моём хвосте, и продолжил действовать, несмотря на ужасное ранение."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:162
translate ru qst_bloodhound_3_toBasement_40f4935f:

    # MC "(What the fuck is this thing?!)"
    MC "(Что это за хрень?!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:163
translate ru qst_bloodhound_3_toBasement_b29379dc:

    # MC "(Is it even killable?)"
    MC "(Его вообще можно убить?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:164
translate ru qst_bloodhound_3_toBasement_323868cf:

    # "Once again, the thing leapt forward, and after a few clashes of our blades, it suddenly pierced through me with one of it's claw hands."
    "Снова эта тварь прыгнула вперёд, и после нескольких столкновений наших клинков она внезапно пронзила меня одной из своих когтистых рук."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:165
translate ru qst_bloodhound_3_toBasement_d327c627:

    # "Screaming in pain, I charged forward, managing to knock the man in black against the opposing wall but it dodged my subsequent lethal swipe to take its head off."
    "Крича от боли, я бросился вперёд, сумев отбросить человека в чёрном к противоположной стене, но он уклонился от моего последующего смертельного удара, направленного на отсечение головы."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:166
translate ru qst_bloodhound_3_toBasement_39009672:

    # "It felt like a horrific dance as the thing moved around me, taking piece after piece."
    "Это было похоже на ужасный танец, пока тварь двигалась вокруг меня, отрывая кусок за куском."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:167
translate ru qst_bloodhound_3_toBasement_b5c60d7e:

    # "I began to feel dizzy and increasingly weak..."
    "Я начал чувствовать головокружение и нарастающую слабость..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:168
translate ru qst_bloodhound_3_toBasement_3f7ba3ac:

    # "Just how much longer could I keep this up?"
    "Сколько ещё я смогу продержаться?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:169
translate ru qst_bloodhound_3_toBasement_733ec587:

    # MC "(F-Fuck! Can you help me out here?)"
    MC "(Ч-чёрт! Можешь помочь тут?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:170
translate ru qst_bloodhound_3_toBasement_d0ca6432:

    # BLACK "Flee."
    BLACK "Беги."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:171
translate ru qst_bloodhound_3_toBasement_e28f5ee5:

    # MC "(Flee?! You can't be serious!)"
    MC "(Беги?! Ты это серьёзно?!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:172
translate ru qst_bloodhound_3_toBasement_6e2d0cec:

    # BLACK "Cannot stabilize damage much longer."
    BLACK "Не могу стабилизировать повреждения чуть дольше."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:173
translate ru qst_bloodhound_3_toBasement_60f0bc89:

    # BLACK "His blades are coated with something slowing the rapid healing response."
    BLACK "Его клинки покрыты чем-то, замедляющим быструю регенерацию."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:174
translate ru qst_bloodhound_3_toBasement_872010a3:

    # MC "(Fuck! FUCK!)"
    MC "(Чёрт! ЧЁРТ!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:175
translate ru qst_bloodhound_3_toBasement_35522119:

    # "I looked towards the stairs once again."
    "Я снова посмотрел на лестницу."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:176
translate ru qst_bloodhound_3_toBasement_2dbdb956:

    # "The man in black blocked my path, blades ready."
    "Человек в чёрном преградил мне путь, клинки наготове."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:177
translate ru qst_bloodhound_3_toBasement_92f5db33:

    # MC "(I have to try, I just need to get past!)"
    MC "(Я должен попытаться, мне просто нужно прорваться!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:178
translate ru qst_bloodhound_3_toBasement_05ee5938:

    # "I darted onto the side wall, springing off from my foot to bounce off as I twisted my whole body and swung my tail to try and knock the man back."
    "Я рванул на боковую стену, оттолкнувшись ногой, чтобы отскочить, и, скрутив всё тело, взмахнул хвостом, пытаясь отбросить человека назад."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:179
translate ru qst_bloodhound_3_toBasement_6a1754bb:

    # "It grabbed onto my tail as I slammed it against the wall, sending shards of stone flying."
    "Он ухватился за мой хвост, когда я врезал им в стену, разбросав осколки камня."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:180
translate ru qst_bloodhound_3_toBasement_d7df702e:

    # "The man in black refused to give up, forcing blades through my tail."
    "Человек в чёрном отказался сдаваться, проталкивая клинки сквозь мой хвост."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:181
translate ru qst_bloodhound_3_toBasement_20d8f036:

    # "I screeched out in pain but the man in black kept coming no matter what I did."
    "Я взвизгнул от боли, но человек в чёрном продолжал наступать, что бы я ни делал."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:182
translate ru qst_bloodhound_3_toBasement_cb953dbd:

    # "Only now did I realize how close death was..."
    "Только сейчас я осознал, насколько близка была смерть..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:183
translate ru qst_bloodhound_3_toBasement_0e939507:

    # UNKNOWN "{i}*Whistles*{/i}"
    UNKNOWN "{i}*Свистит*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:185
translate ru qst_bloodhound_3_toBasement_9afc807c:

    # "As the man in black turned sharply towards the sound, he was suddenly blasted back by a bolt of lightning."
    "Когда человек в чёрном резко повернулся на звук, его внезапно отбросило назад ударом молнии."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:186
translate ru qst_bloodhound_3_toBasement_13c9ce29:

    # "Beside Captain Nyx, four mages stood at the ready, their staffs pointed towards the convulsing automaton."
    "Рядом с капитаном Никс стояли наготове четыре мага, направив свои посохи на конвульсирующего автоматона."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:214
translate ru qst_bloodhound_3_toBasement_98ef091a:

    # "It struggled and rose to its feet again, charging towards the Captain and the mages."
    "Он из последних сил поднялся на ноги и снова бросился на капитана и магов."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:221
translate ru qst_bloodhound_3_toBasement_9304bfda:

    # "...But another blast sent him wheeling backwards."
    "...Но ещё один удар отбросил его назад."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:223
translate ru qst_bloodhound_3_toBasement_18e5bb6b:

    # "Clambering back to its feet before they could finish it off, the man in black charged forward, dodging the third blast right through the Captain and her mages, scurrying its way up the stairs."
    "Успев подняться на ноги прежде, чем они успели его добить, человек в чёрном рванул вперёд, увернулся от третьего залпа, пронёсся сквозь капитана и её магов и устремился вверх по лестнице."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:224
translate ru qst_bloodhound_3_toBasement_53131c31:

    # NYX @ angry "AFTER HIM!"
    NYX @ angry "ЗА НИМ!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:225
translate ru qst_bloodhound_3_toBasement_03084257:

    # MAGE "But... What about the other one?"
    MAGE "Но... что насчёт другого?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:226
translate ru qst_bloodhound_3_toBasement_f1f00a2f:

    # NYX @ angry "Leave him!"
    NYX @ angry "Оставь его!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:227
translate ru qst_bloodhound_3_toBasement_235c9198:

    # NYX @ angry "{i}He's with us.{/i}"
    NYX @ angry "{i}Он с нами.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:236
translate ru qst_bloodhound_3_toBasement_26742987:

    # "The mages followed after him as I weakly stumbled behind them deliriously, blood pouring out of me."
    "Маги последовали за ним, в то время как я слабо спотыкался позади них в бреду, истекая кровью."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:238
translate ru qst_bloodhound_3_toBasement_e2baa4ae:

    # "Dizzy, I saw mages and Nyx fight the thing relentlessly."
    "В головокружении я видел, как маги и Никс безжалостно сражались с этим существом."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:239
translate ru qst_bloodhound_3_toBasement_45fc3d08:

    # "After a few blows, the Man in black knocked back Captain Nyx before leaping through one of the glass windows, shattering it."
    "После нескольких ударов Человек в черном отбросил капитана Никс, прежде чем выпрыгнуть через одно из стеклянных окон, разбив его."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:245
translate ru qst_bloodhound_3_toBasement_b7f2c043:

    # "From outside, we watched as he contorted his body with unnatural speed, dragging himself up unto a building and moving away too fast for us to even see."
    "Снаружи мы наблюдали, как он неестественно быстро изгибал свое тело, вскарабкиваясь на здание и удаляясь слишком быстро, чтобы мы могли даже разглядеть."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:246
translate ru qst_bloodhound_3_toBasement_58688400:

    # MAGE "Captain! Do we pursue?"
    MAGE "Капитан! Преследуем?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:247
translate ru qst_bloodhound_3_toBasement_b9c6a5a9:

    # SECOND_MAGE "We need more time to prepare another charge!"
    SECOND_MAGE "Нам нужно больше времени, чтобы подготовить новый заряд!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:261
translate ru qst_bloodhound_3_toBasement_fdeb4bdc:

    # NYX @ angry "No... Whatever that thing is, its gone."
    NYX @ angry "Нет... Что бы это ни было, оно ушло."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:262
translate ru qst_bloodhound_3_toBasement_d1beeab3:

    # "Unable to handle a single step more my buckling legs gave and I dropped to my knees."
    "Не в силах сделать ни шага больше, мои подкашивающиеся ноги подогнулись, и я рухнул на колени."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:264
translate ru qst_bloodhound_3_toBasement_2fb16082:

    # "Blood poured from all over my mangled body as I crashed forward with a thud."
    "Кровь хлестала из всего моего изувеченного тела, когда я с глухим стуком упал вперед."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:267
translate ru qst_bloodhound_3_toBasement_6859ac9e:

    # NYX "SHIT!"
    NYX "ДЕРЬМО!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:268
translate ru qst_bloodhound_3_toBasement_c58b41a1:

    # "Darkness."
    "Тьма."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:283
translate ru qst_bloodhound_3_toBasement_3e507460:

    # NYX @ shock "...Hey, HEY! He's opening his eyes!"
    NYX @ shock "...Эй, ЭЙ! Он открывает глаза!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:284
translate ru qst_bloodhound_3_toBasement_96bf910a:

    # MC "Urghh..."
    MC "Ургх..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:285
translate ru qst_bloodhound_3_toBasement_ad80ee54:

    # MAGE_TALL "We did our best to heal the creatures wounds but-"
    MAGE_TALL "Мы сделали всё возможное, чтобы залечить раны существа, но-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:286
translate ru qst_bloodhound_3_toBasement_1d30ae43:

    # MAGE_TALL "Captain... What is this thing?"
    MAGE_TALL "Капитан... Что это за штука?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:287
translate ru qst_bloodhound_3_toBasement_113a6d97:

    # MAGE_SLIM "It... It looks like a man, but earlier-"
    MAGE_SLIM "Оно... Оно похоже на человека, но раннее-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:288
translate ru qst_bloodhound_3_toBasement_52521e89:

    # NYX @ angry "Never you mind."
    NYX @ angry "Не твоё дело."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:289
translate ru qst_bloodhound_3_toBasement_a42b3df1:

    # NYX @ talk "Now help him back to his feet!"
    NYX @ talk "А теперь помогите ему подняться на ноги!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:292
translate ru qst_bloodhound_3_toBasement_c6e0476f:

    # "The mages weakly helped me back to my feet which trembled and shook, barely able to hold me upright."
    "Маги слабо помогли мне подняться на ноги, которые дрожали и тряслись, едва удерживая меня в вертикальном положении."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:311
translate ru qst_bloodhound_3_toBasement_07dd01bf:

    # MC @ talk "{i}*Cough*{/i} How did you-"
    MC @ talk "{i}*Кхе*{/i} Как ты-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:312
translate ru qst_bloodhound_3_toBasement_06fdd052:

    # NYX @ talk "We will talk later, I will explain everything soon."
    NYX @ talk "Поговорим позже, я всё объясню в ближайшее время."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:313
translate ru qst_bloodhound_3_toBasement_9ae00cf0:

    # "Captain Nyx turned towards the other mages."
    "Капитан Никс повернулась к другим магам."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:316
translate ru qst_bloodhound_3_toBasement_33bce3a6:

    # NYX @ angry "None of you will speak of what you have seen today, understand?"
    NYX @ angry "Никто из вас не будет говорить о том, что видел сегодня, понятно?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:317
translate ru qst_bloodhound_3_toBasement_f9a9e350:

    # "The mages look at each other sheepishly."
    "Маги смущённо переглянулись."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:318
translate ru qst_bloodhound_3_toBasement_675dbf11:

    # NYX @ angry "I assure you, {i}the fates will not favor you for a lack of discretion, ladies.{/i}"
    NYX @ angry "Уверяю вас, {i}судьбы не будут благосклонны к вам за отсутствие скромности, дамы.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:319
translate ru qst_bloodhound_3_toBasement_4abde0dd:

    # "The mages all nervously nodded."
    "Все маги нервно кивнули."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:329
translate ru qst_bloodhound_3_toBasement_d626dae3:

    # NYX @ talk "Now help me dress him."
    NYX @ talk "А теперь помогите мне его одеть."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:333
translate ru qst_bloodhound_3_toBasement_4896de1a:

    # "The Mages eyes looked downwards as their cheeks flushed red."
    "Взгляды магов опустились вниз, а их щёки покраснели."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:334
translate ru qst_bloodhound_3_toBasement_7a8a690f:

    # NYX @ angry "...Oh for the love of-"
    NYX @ angry "...Ох, ради всего святого-"

