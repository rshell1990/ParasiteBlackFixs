    # NYX @ blush "{i}Don't get killed, idiot.{/i}"
    NYX @ blush "{i}Не дай себя убить, идиот.{/i}"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1421
translate ru qst_thecomingstorm_return_to_nyx_after_ambush_54c57dd4:

    # "She turned, {i}masking her expression.{/i}"
    "Она отвернулась, {i}скрывая своё выражение лица.{/i}"

# game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_aio.rpy:1424
