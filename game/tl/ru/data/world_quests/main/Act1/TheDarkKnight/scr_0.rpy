# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:6
translate ru qst_DarkKnight_0_startEvent_5edd6a24:

    # REGINA @ talk "Ah, [player_name!t], there you are."
    REGINA @ talk "Ах, [player_name!t], вот и ты."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:7
translate ru qst_DarkKnight_0_startEvent_cef4d643:

    # MC @ talk "[regina_ref_cap!t]? What is it?"
    MC @ talk "[regina_ref_cap!t]? Что случилось?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:8
translate ru qst_DarkKnight_0_startEvent_bdd287cb:

    # REGINA @ talk "An Officer came by with some men today, Lukkan I think it was?"
    REGINA @ talk "Сегодня заходил офицер с людьми, кажется, Луккан?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:9
translate ru qst_DarkKnight_0_startEvent_a927b653:

    # REGINA @ talk "He brought a letter which I've left on your bed, says he has some urgent work for you to do."
    REGINA @ talk "Он принёс письмо, я оставила его на твоей кровати. Говорит, у него для тебя срочная работа."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:10
translate ru qst_DarkKnight_0_startEvent_84357043:

    # REGINA @ talk "Any idea what all this is about?"
    REGINA @ talk "Есть какие-то догадки, что всё это значит?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:11
translate ru qst_DarkKnight_0_startEvent_e50dbf2b:

    # MC @ talk "No clue."
    MC @ talk "Понятия не имею."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:12
translate ru qst_DarkKnight_0_startEvent_7e740501:

    # REGINA @ talk "Hmm, well, hopefully it's nothing too dangerous dear..."
    REGINA @ talk "Хм, что ж, надеюсь, ничего слишком опасного, дорогой..."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:15
translate ru qst_DarkKnight_0_startEvent_e0397941:

    # REGINA @ talk "I know you will dear."
    REGINA @ talk "Я знаю что ты справишься, дорогой."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:16
translate ru qst_DarkKnight_0_startEvent_063e1639:

    # REGINA @ talk "I know you can handle yourself, but that doesn't mean you're invincible."
    REGINA @ talk "Я знаю что ты умеешь постоять за себя, но это не значит, что ты неуязвим."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:17
translate ru qst_DarkKnight_0_startEvent_66b69b31:

    # REGINA @ talk "Take your time and prepare for something if you don't feel ready."
    REGINA @ talk "Не торопись и подготовься как следует, если чувствуешь, что ещё не готов."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:20
translate ru qst_DarkKnight_0_startEvent_15705e04:

    # REGINA @ talk "No, he just 'congratulated' me for raising one of the Scouts' finest and told me to give you that letter."
    REGINA @ talk "Нет, он просто 'поздравил' меня с тем, что я воспитала одного из лучших Разведчиков, и велел передать тебе это письмо."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:21
translate ru qst_DarkKnight_0_startEvent_dd26150b:

    # MC @ talk "I take it you didn't like him?"
    MC @ talk "Полагаю, он тебе не понравился?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:22
translate ru qst_DarkKnight_0_startEvent_5588edc5:

    # REGINA @ talk "Hmph, not him but say... More I'd never trust anyone in the Alderian government."
    REGINA @ talk "Хмф, не он конкретно, а скажем так... Я бы никогда не доверяла никому в правительстве Алдерея."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:25
translate ru qst_DarkKnight_0_startEvent_d6ab8297:

    # "[regina_ref_cap!t] feigned a smile at the remark."
    "[regina_ref_cap!t] притворно улыбнулась в ответ на это замечание."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:26
translate ru qst_DarkKnight_0_startEvent_eb02d764:

    # REGINA @ talk "Dear... You need to learn to use more than your fists to win every fight."
    REGINA @ talk "Дорогой... Тебе нужно научиться выигрывать каждый бой не только кулаками."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:27
translate ru qst_DarkKnight_0_startEvent_c4f2687f:

    # MC @ talk "That's why I have my blade."
    MC @ talk "Для этого у меня есть клинок."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:28
translate ru qst_DarkKnight_0_startEvent_ab8e2076:

    # REGINA @ talk "That's not..."
    REGINA @ talk "Это не то..."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:29
translate ru qst_DarkKnight_0_startEvent_da54c8ca:

    # MC @ talk "Don't worry [regina_ref!t], I know what you meant."
    MC @ talk "Не волнуйся, [regina_ref!t], я понял что ты имела в виду."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:31
translate ru qst_DarkKnight_0_startEvent_c065d263:

    # REGINA @ talk "Anyway, I shall leave you to it."
    REGINA @ talk "В любом случае, я оставлю тебя."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:32
translate ru qst_DarkKnight_0_startEvent_90397aa1:

    # MC @ talk "Thanks [regina_ref!t]."
    MC @ talk "Спасибо, [regina_ref!t]."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:39
translate ru qst_DarkKnight_0_startEvent_7efd249c:

    # MC "(Hmm...)"
    MC "(Хм...)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:40
translate ru qst_DarkKnight_0_startEvent_05049959:

    # MC "(The letter has the official seal on it, so it looks like it means business.)"
    MC "(На письме стоит официальная печать, так что, похоже это серьёзно.)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:41
translate ru qst_DarkKnight_0_startEvent_04a0c64d:

    # MC "(Let's see...)"
    MC "(Посмотрим...)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:42
translate ru qst_DarkKnight_0_startEvent_d27c8688:

    # LUKKAN "[player_name!t], it has come to my attention that Captain Nyx of the City Watch is in dire need of some support tackling security issues inside and outside the Capital."
    LUKKAN "[player_name!t], мне стало известно, что капитан Никс из Городской Стражи остро нуждается в поддержке в решении вопросов безопасности внутри и за пределами Столицы."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:43
translate ru qst_DarkKnight_0_startEvent_988d3553:

    # LUKKAN "I have put forward your name for this endeavor, and request you speak to her as soon as possible - Head down to her office at the city fort."
    LUKKAN "Я предложил твою кандидатуру для этого дела, и прошу тебя как можно скорее поговорить с ней — Отправляйся в её кабинет в городской крепости."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:44
translate ru qst_DarkKnight_0_startEvent_d00256d8:

    # LUKKAN "Any work you do for her will be graciously rewarded."
    LUKKAN "Любая работа, которую ты для неё выполнишь, будет щедро вознаграждена."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:45
translate ru qst_DarkKnight_0_startEvent_94652cee:

    # MC "(Great... So much for all our worries being behind us.)"
    MC "(Отлично... Вот и все наши тревоги остались позади.)"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:46
translate ru qst_DarkKnight_0_startEvent_68f73bdc:

    # MC "(I should look into this as soon as I can... It's not wise to keep officials waiting.)"
    MC "(Мне стоит заняться этим как можно скорее... Неразумно заставлять официальных лиц ждать.)"

translate ru strings:

    # game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:14
    old "Don't worry, I'll be careful."
    new "Не волнуйся, я буду осторожен."

    # game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:19
    old "Did he say anything else?"
    new "Он ещё что-нибудь сказал?"

    # game/data/world_quests/main/Act1/TheDarkKnight/scr_0.rpy:24
    old "I am the danger."
    new "Я — опасность."

