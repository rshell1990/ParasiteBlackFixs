# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1759
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_fb2ef6b1:

