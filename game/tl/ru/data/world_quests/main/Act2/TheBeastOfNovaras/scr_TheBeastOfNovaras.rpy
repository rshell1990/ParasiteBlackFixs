    YARRICK @ smile "Я слышал, что даже появилась новая песня барда о великом Шьяхтане."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1797
translate ru qst_TheBeastOfNovaras_ReturnToYarrickAfterCaltrack_bfcf74f4:

