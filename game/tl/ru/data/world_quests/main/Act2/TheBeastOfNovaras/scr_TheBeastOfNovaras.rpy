# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1714
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_3cecdb0b:

    # "Her hand lingered on the doorframe, just long enough for me to notice the tremor in her fingers. When she spoke, her voice was velvet and steel at once."
