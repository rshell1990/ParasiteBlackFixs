translate ru qst_TheBeastOfNovaras_TalkToGarenBar_b58f3630:

    # SYPHA @ happy "Oh, I am."
    SYPHA @ happy "О, да."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2028
translate ru qst_TheBeastOfNovaras_TalkToGarenBar_f9cd6c18:

