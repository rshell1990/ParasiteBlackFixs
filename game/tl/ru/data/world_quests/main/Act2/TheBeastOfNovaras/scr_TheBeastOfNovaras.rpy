translate ru qst_TheBeastOfNovaras_TalkToGarenBar_4690fb80:

    # SYPHA @ happy "Meet me there after dark, and I'll give you what you're craving."
    SYPHA @ happy "Встреть меня там после наступления темноты, и я дам тебе то, чего ты жаждешь."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:2033
translate ru qst_TheBeastOfNovaras_TalkToGarenBar_93d92d0b:

