# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1725
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_syphatalkmenu_f8487f08:

    # SHYAHTAN "... A fine mate she shall make."
    SHYAHTAN "... Прекрасной парой она станет."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1732
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_eebd995f:

    # SHYAHTAN "I {i}was{/i} different."
    SHYAHTAN "Я и {i}был{/i} другим."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1733
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_e1dce769:

    # SHYAHTAN "I saw banners burning beneath twin suns. Screams. Concubines without faces. A child's hand reaching... then nothing."
    SHYAHTAN "Я видел горящие знамёна под двойным солнцем. Крики. Наложниц без лиц. Детскую руку, тянущуюся... затем ничего."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1734
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_02828b98:

    # SHYAHTAN "Fragments. Nothing whole."
    SHYAHTAN "Осколки. Ничего целого."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1738
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_21c07cf7:

    # SHYAHTAN "Flashes. Wars on nameless worlds."
    SHYAHTAN "Вспышки. Войны на безымянных мирах."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1739
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_33a7dc7e:

    # SHYAHTAN "Blood rivers, screams in alien tongues."
    SHYAHTAN "Реки крови, крики на чужих языках."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1740
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_5b5f717f:

    # SHYAHTAN "I do not like these feelings. They are heavy... illogical. Painful."
    SHYAHTAN "Мне не нравятся эти чувства. Они тяжёлые... нелогичные. Болезненные."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1744
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_91d14552:

    # SHYAHTAN "Pieces. Wars beneath strange skies. Feasts after slaughter. Concubines by the hundred, nameless, blurred."
    SHYAHTAN "Фрагменты. Войны под чужими небесами. Пиршества после бойни. Сотни наложниц, безымянные, размытые."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1745
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_9d4fc3c1:

    # SHYAHTAN "There is more. Locked away. Waiting."
    SHYAHTAN "Есть ещё. Запертое. Ожидающее."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1749
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_527b51a7:

    # SHYAHTAN "I do not know."
    SHYAHTAN "Я не знаю."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1750
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_116cb9b7:

    # SHYAHTAN "Out there still, among the stars."
    SHYAHTAN "Там всё ещё, среди звёзд."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1751
translate ru qst_TheBeastOfNovaras_WakeUpInTavernPostBattle_shyahtantalkmenu_9ac4149d:

