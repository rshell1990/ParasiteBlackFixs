# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:5
translate ru qst_TheTarbecks2_enter_manor_db0d0daf:

    # GUARD "Ah, Lady Tarbeck said to escort you straight to her upon arrival."
    GUARD "Ах, Леди Тарбек велела сразу проводить вас к ней, как только вы прибудете."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:6
translate ru qst_TheTarbecks2_enter_manor_349cc5c0:

    # GUARD "Please, come with me."
    GUARD "Прошу, пройдите за мной."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:12
translate ru qst_TheTarbecks2_enter_manor_481fbd81:

    # "Following the guard, he led me towards the dining room where Lady Tarbeck sat, carefully sipping at her tea."
    "Следуя за стражником, он привёл меня в столовую, где Леди Тарбек сидела и осторожно отхлёбывала свой чай."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:14
translate ru qst_TheTarbecks2_enter_manor_fc103b1a:

    # "Her eyes slowly lifted towards me with distant displeasure."
    "Её взгляд медленно поднялся на меня с холодным недовольством."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:15
translate ru qst_TheTarbecks2_enter_manor_c393822e:

    # LADY_TARBECK @ think "Thank you for coming."
    LADY_TARBECK @ think "Благодарю, что пришел."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:16
translate ru qst_TheTarbecks2_enter_manor_fce49781:

    # LADY_TARBECK @ angry "Now that you're here, I want to make one thing clear..."
    LADY_TARBECK @ angry "Раз уж ты здесь, я хочу сразу же прояснить одну вещь..."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:17
translate ru qst_TheTarbecks2_enter_manor_13abf134:

    # LADY_TARBECK @ angry "{i}I have no need of you, nor do I have any interest in my husband's perverted games.{/i}"
    LADY_TARBECK @ angry "{i}Ты мне не нужен, и меня совершенно не интересуют извращённые игры моего мужа.{/i}"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:18
translate ru qst_TheTarbecks2_enter_manor_9e811334:

    # LADY_TARBECK @ angry "And I CERTAINLY have no interest in helping those ghoulish GTC monsters."
    LADY_TARBECK @ angry "И я ОПРЕДЕЛЕННО вовсе не собираюсь помогать этим упырям из ВТК."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:19
translate ru qst_TheTarbecks2_enter_manor_00a57388:

    # LADY_TARBECK @ happy "So, I'm afraid you're just wasting your time here."
    LADY_TARBECK @ happy "Так что, боюсь, ты просто зря теряешь здесь время."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:20
translate ru qst_TheTarbecks2_enter_manor_db3b6296:

    # SHYAHTAN "(Slow... Go slow for this one.)"
    SHYAHTAN "(Неспеша... С этой нужно очень неспеша.)"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:21
translate ru qst_TheTarbecks2_enter_manor_842a0196:

    # MC @ talk "... Very well."
    MC @ talk "... Что ж, хорошо."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:22
translate ru qst_TheTarbecks2_enter_manor_6cbfaf09:

    # MC @ smile "Then at least allow me to walk with you and guard you for the day."
    MC @ smile "Тогда хотя бы позвольте мне пройтись с вами и охранять вас сегодня."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:23
translate ru qst_TheTarbecks2_enter_manor_8d946ca7:

    # LADY_TARBECK @ think "Didn't you just hear what I said?"
    LADY_TARBECK @ think "Ты что, не слышал, что я сказала?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:24
translate ru qst_TheTarbecks2_enter_manor_6119f1bd:

    # LADY_TARBECK @ angry "I have no interest in these games!"
    LADY_TARBECK @ angry "Меня не интересуют эти игры!"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:25
translate ru qst_TheTarbecks2_enter_manor_6ce06e3a:

    # MC @ talk "Be it so, my lady, your husband won't be pleased should we do nothing."
    MC @ talk "Как скажете, миледи, но ваш муж будет недоволен, если мы ничего не будем делать."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:26
translate ru qst_TheTarbecks2_enter_manor_f88170b4:

    # MC @ smile "So what is the harm in letting me walk with you?"
    MC @ smile "Так какой вред в том, что я просто пройдусь с вами?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:27
translate ru qst_TheTarbecks2_enter_manor_de2b975a:

    # MC @ talk "It's not like Hamun isn't a dangerous place..."
    MC @ talk "Хамун — далеко не самое безопасное место..."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:28
translate ru qst_TheTarbecks2_enter_manor_b80e2687:

    # MC @ smile "Is it truly so terrible to have the savior of Novaras as your guard for the day?"
    MC @ smile "Неужели так ужасно иметь спасителя Новараса в качестве вашей охраны на один день?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:29
translate ru qst_TheTarbecks2_enter_manor_67689c8d:

    # LADY_TARBECK "Funny... I hear people still call you the beast of Novaras."
    LADY_TARBECK "Забавно... Я слышала, люди до сих пор называют тебя Зверем Новараса."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:30
translate ru qst_TheTarbecks2_enter_manor_33e402dd:

    # LADY_TARBECK "So which is it? Are you a noble man, or just a beast?"
    LADY_TARBECK "Так кто же ты? Благородный мужчина, или просто зверь?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:33
translate ru qst_TheTarbecks2_enter_manor_b3c29779:

    # LADY_TARBECK @ sad "How... Unreassuring."
    LADY_TARBECK @ sad "Как... Неутешительно."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:35
translate ru qst_TheTarbecks2_enter_manor_7e622f10:

    # LADY_TARBECK @ angry "Many a man has said something similar to justify the terrible things he's done."
    LADY_TARBECK @ angry "Многие мужчины говорили подобное, чтобы оправдать ужасные вещи, которые они творили."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:37
translate ru qst_TheTarbecks2_enter_manor_04a88133:

    # LADY_TARBECK @ think "And you're content with that?"
    LADY_TARBECK @ think "И тебя это устраивает?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:38
translate ru qst_TheTarbecks2_enter_manor_3a02a8f2:

    # LADY_TARBECK @ sad "How... Sad."
    LADY_TARBECK @ sad "Как... печально."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:39
translate ru qst_TheTarbecks2_enter_manor_2b8107ad:

    # MC @ talk "Well... What will it be, my lady?"
    MC @ talk "Что ж... Каков будет ваш ответ, миледи?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:40
translate ru qst_TheTarbecks2_enter_manor_0ecc95c4:

    # "Lady Tarbeck paused for a long moment before sighing."
    "Леди Тарбек надолго замолчала, а затем вздохнула."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:41
translate ru qst_TheTarbecks2_enter_manor_c84a19ee:

    # LADY_TARBECK @ talk "Fine..."
    LADY_TARBECK @ talk "Ладно..."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:42
translate ru qst_TheTarbecks2_enter_manor_62f4d186:

    # LADY_TARBECK @ angry "But you ask nothing of me and expect nothing for this."
    LADY_TARBECK @ angry "Но ты ничего у меня не попросишь, и ничего не ждёшь взамен."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:43
translate ru qst_TheTarbecks2_enter_manor_1a666479:

    # LADY_TARBECK @ angry "I do this only to appease my husband so he might relent."
    LADY_TARBECK @ angry "Я делаю это лишь для того, чтобы успокоить мужа и заставить его уступить."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:44
translate ru qst_TheTarbecks2_enter_manor_847e9558:

    # LADY_TARBECK @ talk "And hopefully this foolishness of his can end and we can all go back to being just miserable again."
    LADY_TARBECK @ talk "И надеюсь, эта его глупость наконец закончится, и мы все сможем вернуться к привычному унынию."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:45
translate ru qst_TheTarbecks2_enter_manor_f93acea7:

    # MC @ talk "... Did you have anywhere you wished to go today, my lady?"
    MC @ talk "... У вас есть место куда вы хотели бы сегодня пойти, миледи?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:46
translate ru qst_TheTarbecks2_enter_manor_a407e266:

    # LADY_TARBECK @ talk "Hmph."
    LADY_TARBECK @ talk "Хмф."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:47
translate ru qst_TheTarbecks2_enter_manor_fa36d093:

    # LADY_TARBECK @ angry "No talking. Just follow."
    LADY_TARBECK @ angry "Без болтовни. Просто следуй за мной."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:49
translate ru qst_TheTarbecks2_enter_manor_40b4a315:

    # "As Lady Tarbeck stormed her way past me, I shadowed behind her..."
    "Леди Тарбек решительно прошла мимо меня, а я последовал за ней..."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:51
translate ru qst_TheTarbecks2_enter_manor_2c13a07f:

    # MC "(This needs to work, you know.)"
    MC "(Это должно сработать, ты знаешь.)"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:52
translate ru qst_TheTarbecks2_enter_manor_aa1d7b31:

    # SHYAHTAN "(It will.)"
    SHYAHTAN "(И сработает.)"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:58
translate ru qst_TheTarbecks2_enter_manor_79728c74:

    # "... Following Lady Tarbeck's lead, I watched as she turned down towards the city markets."
    "... Следуя за Леди Тарбек, я наблюдал, как она свернула в сторону городских рынков."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:60
translate ru qst_TheTarbecks2_enter_manor_c3521b26:

    # "Behind us, always shadowing in the distance, at least three to four guards."
    "Позади нас, постоянно держась на расстоянии, следовали как минимум три-четыре стражника."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:61
translate ru qst_TheTarbecks2_enter_manor_50be7b0b:

    # "And those were just the ones I could see."
    "И это были только те, кого я замечал."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:66
translate ru qst_TheTarbecks2_enter_manor_c10c881a:

    # "Carefully I watched as Lady Tarbeck explored around the different market stalls."
    "Я внимательно наблюдал, как Леди Тарбек ходит между рыночными прилавками."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:67
translate ru qst_TheTarbecks2_enter_manor_8f73a92d:

    # MC @ think "I must admit, my lady, this doesn't quite seem like the place for a lady of your station."
    MC @ think "Вынужден признать, миледи, это место не совсем подходит для леди вашего положения."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:68
translate ru qst_TheTarbecks2_enter_manor_d12b1466:

    # LADY_TARBECK @ talk "I'm a merchant lord's wife, I'd be laughed out of true noble circles, make no mistake."
    LADY_TARBECK @ talk "Я жена торгового лорда, меня высмеяли бы в настоящих благородных кругах, уж поверь."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:69
translate ru qst_TheTarbecks2_enter_manor_cc37fb0d:

    # MC @ talk "But here-"
    MC @ talk "Но здесь—"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:71
translate ru qst_TheTarbecks2_enter_manor_e2122402:

    # LADY_TARBECK @ angry "Your job isn't to speak."
    LADY_TARBECK @ angry "Твоя работа не болтать."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:73
translate ru qst_TheTarbecks2_enter_manor_599d8a10:

    # LADY_TARBECK @ talk "It's to follow and protect me... silently."
    LADY_TARBECK @ talk "А следовать за мной и охранять меня... молча."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:75
translate ru qst_TheTarbecks2_enter_manor_c7714909:

    # "I pulled back, allowing Lady Tarbeck to inspect some jewelled trinkets which she bartered softly over."
    "Я отступил назад, позволяя Леди Тарбек рассматривать ювелирные безделушки, за которые она тихо торговалась."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:76
translate ru qst_TheTarbecks2_enter_manor_9ef0ed63:

    # "Handing over a pouch of coins for a small, almost gimmicky wrist piece, she smiled at it before turning her soft gaze towards me and sighing."
    "Отдав кошель с монетами за небольшой, довольно безвкусный браслет, она улыбнулась ему, а затем обратила мягкий взгляд на меня и вздохнула."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:78
translate ru qst_TheTarbecks2_enter_manor_f6c28dbf:

    # LADY_TARBECK @ think "I am done here, come."
    LADY_TARBECK @ think "Я закончила здесь, идём."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:81
translate ru qst_TheTarbecks2_enter_manor_42b79bb8:

    # "As the lady wandered off in another direction, I couldn't help but roll my eyes."
    "Когда леди направилась в другую сторону, я не смог сдержаться и закатил глаза."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:83
translate ru qst_TheTarbecks2_enter_manor_6d326a9d:

    # MC "(Am I even going to {i}want{/i} to fuck her at the end of this?)"
    MC "(А мне вообще в конце всего этого {i}захочется{/i} её трахнуть?)"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:87
translate ru qst_TheTarbecks2_enter_manor_83e1a223:

    # "The next hour was spent within the libraries of Hamun, as Lady Tarbeck traced her fingers along the books."
    "Следующий час мы провели в библиотеках Хамуна, пока Леди Тарбек водила пальцами по верхушкам книг."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:88
translate ru qst_TheTarbecks2_enter_manor_b7a2dd24:

    # "Occasionally, she would pull one out to read a few pages before carefully putting it back."
    "Иногда, она вытаскивала какую-нибудь книгу, читала пару страниц и аккуратно ставила её обратно."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:93
translate ru qst_TheTarbecks2_enter_manor_85098d37:

    # MC @ think "... Do you come here to read often, my lady?"
    MC @ think "... Вы часто приходите сюда почитать, миледи?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:94
translate ru qst_TheTarbecks2_enter_manor_340461e1:

    # LADY_TARBECK @ think "I thought we were walking in silence?"
    LADY_TARBECK @ think "Мне казалось, мы шли в тишине?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:95
translate ru qst_TheTarbecks2_enter_manor_859d0af0:

    # MC @ talk "Well first you might actually want to find a book you like before we drag out the silence."
    MC @ talk "Ну, сперва, может вы действительно захотите найти книгу которая вам понравится, прежде чем мы затянем молчание."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:96
translate ru qst_TheTarbecks2_enter_manor_9aa8d5db:

    # LADY_TARBECK @ angry "And you're going to recommend me my next read?"
    LADY_TARBECK @ angry "И ты собираешься порекомендовать мне, что почитать?"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:97
translate ru qst_TheTarbecks2_enter_manor_a3f448cf:

    # "She folded her arms, her brow creasing."
    "Она скрестила руки на груди, нахмурив брови."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:98
translate ru qst_TheTarbecks2_enter_manor_5fb6b12c:

    # LADY_TARBECK @ angry "As you refuse to shut up, let's hear it then."
    LADY_TARBECK @ angry "Раз уж ты не можешь заткнуться, давай послушаем."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:101
translate ru qst_TheTarbecks2_enter_manor_ba86ccff:

    # LADY_TARBECK @ angry "Macabre."
    LADY_TARBECK @ angry "Мрачно."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:102
translate ru qst_TheTarbecks2_enter_manor_81b7be15:

    # LADY_TARBECK @ think "Something for teenage girls to swoon over."
    LADY_TARBECK @ think "Что-то, от чего только будут падать в обморок подростки."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:103
translate ru qst_TheTarbecks2_enter_manor_631d7823:

    # LADY_TARBECK @ think "No respectable woman would be interested in such a beast."
    LADY_TARBECK @ think "Ни одна уважающая себя женщина не заинтересуется таким зверем."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:105
translate ru qst_TheTarbecks2_enter_manor_eda52db6:

    # LADY_TARBECK @ think "Boring."
    LADY_TARBECK @ think "Скучно."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:106
translate ru qst_TheTarbecks2_enter_manor_61c855ed:

    # MC @ surprised "It's a classic!"
    MC @ surprised "Это классика!"

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:107
translate ru qst_TheTarbecks2_enter_manor_7de0a37d:

    # LADY_TARBECK @ think "Yes, and it was all the rage... Ten years ago."
    LADY_TARBECK @ think "Да, и она была в моде... десять лет назад."

# game/data/world_quests/main/Act2/TheTarbecksPt2/scr_TheTarbecks2.rpy:108
