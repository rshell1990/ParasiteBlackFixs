    # MC "Yeah... Too bad the {i}‘real’{/i} people are all starving."
    MC "Да... Жаль, что {i}‘настоящие’{/i} люди все голодают."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:328
translate ru qst_TheDarkPass_CampTalkKiara_ebc0d635:

    # KIARA "Aye, that’s why we’ve gotta get this war won, get back to looking after our own."
    KIARA "Ага, поэтому мы должны выиграть эту войну, вернуться к заботе о своих."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:329
translate ru qst_TheDarkPass_CampTalkKiara_96ada1e9:

    # KIARA "... Anyway, go on, shoo, I’d better get back to my duties."
    KIARA "... В любом случае, давай, иди, мне лучше вернуться к своим обязанностям."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:330
translate ru qst_TheDarkPass_CampTalkKiara_1953ebce:

    # MC "Alright, talk soon."
    MC "Ладно, скоро поговорим."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:331
translate ru qst_TheDarkPass_CampTalkKiara_2efd37f9:

    # KIARA "Yeah... Talk soon."
    KIARA "Да... Скоро поговорим."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:337
translate ru qst_TheDarkPass_CampTalkKiara_rep_71f72ca7:

    # MC "Hey."
    MC "Привет."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:338
translate ru qst_TheDarkPass_CampTalkKiara_rep_181644a0:

    # KIARA "Shoo, [player_name!t]. I need to stand watch."
    KIARA "Кыш, [player_name!t]. Мне нужно стоять на посту."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:340
translate ru qst_TheDarkPass_CampTalkKiara_rep_142937d2:

    # KIARA @ happy "We'll see each other {i}later tonight{/i}, promise."
    KIARA @ happy "Мы увидимся {i}сегодня вечером{/i}, обещаю."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:341
translate ru qst_TheDarkPass_CampTalkKiara_rep_615eedc7:

    # MC "Okay."
    MC "Хорошо."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:348
translate ru qst_TheDarkPass_CampTalkDuprey_000bea1b:

    # "Captain Duprey was sitting around one of the fires chatting to the men."
    "Капитан Дюпре сидел у одного из костров, болтая с солдатами."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:349
translate ru qst_TheDarkPass_CampTalkDuprey_781f6770:

    # "As he gnawed into some bland looking chicken and swigged at his flask, he seemed more relaxed than usual as he spoke."
    "Пока он грыз какую-то безвкусную на вид курицу и прихлёбывал из своей фляжки, он казался более расслабленным, чем обычно, когда говорил."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:350
translate ru qst_TheDarkPass_CampTalkDuprey_b55e09f4:

    # "When he saw me approach, he looked and gave a small nod of his head."
    "Увидев что я подхожу, он взглянул и слегка кивнул головой."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:353
translate ru qst_TheDarkPass_CampTalkDuprey_caff3e37:

    # MC "Evening, Captain."
    MC "Добрый вечер, Капитан."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:354
translate ru qst_TheDarkPass_CampTalkDuprey_9f5fc7d6:

    # DUPREY "You are one of the lads Borras took up on the ridge earlier, yes?"
    DUPREY "Ты один из тех парней, которых Боррас взял на хребте сегодня, верно?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:355
translate ru qst_TheDarkPass_CampTalkDuprey_8cd502b3:

    # MC "Yes, sir."
    MC "Да, сэр."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:356
translate ru qst_TheDarkPass_CampTalkDuprey_0057be0d:

    # DUPREY "Hm, nicely done, lad."
    DUPREY "Хм, хорошо сработано, парень."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:357
translate ru qst_TheDarkPass_CampTalkDuprey_217a3175:

    # "The Captain offered me a swig of his drink which I accepted gratefully, and then welcomed me to sit."
    "Капитан предложил мне глоток из своего напитка, который я с благодарностью принял, а затем пригласил присесть."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:359
translate ru qst_TheDarkPass_CampTalkDuprey_b4e53b47:

    # MC "Thank you, sir."
    MC "Спасибо, сэр."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:360
translate ru qst_TheDarkPass_CampTalkDuprey_481f280e:

    # DUPREY "So, how’ve you settled in?"
    DUPREY "Итак, как ты устроился?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:361
translate ru qst_TheDarkPass_CampTalkDuprey_5adf567d:

    # MC "Fine I think, sir."
    MC "Думаю, хорошо, сэр."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:362
translate ru qst_TheDarkPass_CampTalkDuprey_b05e07d5:

    # DUPREY "Good, good..."
    DUPREY "Хорошо, хорошо..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:363
translate ru qst_TheDarkPass_CampTalkDuprey_d7ab3938:

    # MC "... Could I ask you about a couple things, sir?"
    MC "... Могу я спросить вас о паре вещей, сэр?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:364
translate ru qst_TheDarkPass_CampTalkDuprey_0c3978ea:

    # DUPREY "Hm?"
    DUPREY "Хм?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:365
translate ru qst_TheDarkPass_CampTalkDuprey_d0300c61:

    # MC "If you don’t mind..."
    MC "Если вы не против..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:366
translate ru qst_TheDarkPass_CampTalkDuprey_13a1b492:

    # DUPREY "Aye, feel free."
    DUPREY "Ага, не стесняйся."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:374
translate ru qst_TheDarkPass_CampTalkDuprey_menu_7bb579f6:

    # DUPREY "Lost count a long time ago."
    DUPREY "Сбился со счёта очень давно."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:375
translate ru qst_TheDarkPass_CampTalkDuprey_menu_6c8a02b9:

    # DUPREY "I’ve been here since the beginning..."
    DUPREY "Я здесь с самого начала..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:376
translate ru qst_TheDarkPass_CampTalkDuprey_menu_dcc31424:

    # MC "You mean—"
    MC "Вы имеете в виду—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:377
translate ru qst_TheDarkPass_CampTalkDuprey_menu_c9e369aa:

    # DUPREY "When it all first started, we never took it seriously, far more concerned with the threat of Kalliban O’Nok and his army of orcs crossing the seas to invade..."
    DUPREY "Когда всё только начиналось, мы не воспринимали это всерьёз, гораздо больше беспокоясь об угрозе Каллибана О'Нока и его армии орков, пересекающих моря для вторжения..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:378
translate ru qst_TheDarkPass_CampTalkDuprey_menu_d579e16c:

    # MC "{i}The winter of 1149.{/i}"
    MC "{i}Зима 1149 года.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:379
translate ru qst_TheDarkPass_CampTalkDuprey_menu_9b165412:

    # DUPREY "Alright, clever clogs. That’s what they called it, aye."
    DUPREY "Ладно, умник. Так они это называли, да."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:380
translate ru qst_TheDarkPass_CampTalkDuprey_menu_2d277bc7:

    # DUPREY "Villagers talked about {i}‘ghosts in the night’{/i} snatching people up... We figured it was just bandits."
    DUPREY "Деревенские говорили о {i}‘призраках в ночи’{/i}, которые похищали людей... Мы думали, что это просто бандиты."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:381
translate ru qst_TheDarkPass_CampTalkDuprey_menu_4792dca5:

    # DUPREY "More ‘n’ more had been spotted what with all the famine; we were preoccupied with the kind of threats we could understand."
    DUPREY "Их видели всё чаще и чаще из-за так называемого голода; мы были озабочены теми угрозами, которые могли понять."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:382
translate ru qst_TheDarkPass_CampTalkDuprey_menu_8ba9597e:

    # MC "I know this part! After they found more and more bloody scenes, The High Lords and King Mesamor finally relented and got the High Mages and Inquisitors to investigate."
    MC "Я знаю эту часть! После того как они находили всё больше кровавых сцен, Верховные Лорды и король Месамор наконец уступили и привлекли Верховных Магов и Инквизиторов для расследования."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:383
translate ru qst_TheDarkPass_CampTalkDuprey_menu_f269264d:

    # "Captain Duprey raised a curious eyebrow."
    "Капитан Дюпре с любопытством приподнял бровь."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:384
translate ru qst_TheDarkPass_CampTalkDuprey_menu_ecde942b:

    # DUPREY @ think "Hmm... How’d you know all that? Most don’t know the full story."
    DUPREY @ think "Хм... Откуда ты всё это знаешь? Большинство не знает всей истории."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:385
translate ru qst_TheDarkPass_CampTalkDuprey_menu_1cc6d473:

    # MC "I studied it."
    MC "Я изучал это."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:386
translate ru qst_TheDarkPass_CampTalkDuprey_menu_b77999dc:

    # DUPREY @ laugh "Ha! How very wise of you..."
    DUPREY @ laugh "Ха! Как мудро с твоей стороны..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:387
translate ru qst_TheDarkPass_CampTalkDuprey_menu_c8488904:

    # DUPREY "Always good to know how you got to where you’re at but I’m afraid there aren’t many more lessons to learn from it that’d be useful."
    DUPREY "Всегда полезно знать, как ты оказался там, где находишься, но боюсь, из этого можно извлечь не так уж много полезных уроков."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:388
translate ru qst_TheDarkPass_CampTalkDuprey_menu_424524d9:

    # DUPREY "We underestimated the enemy, and we still thought at the time it was all some grand scheme from Kalliban. We overestimated him."
    DUPREY "Мы недооценили врага и всё ещё думали тогда, что это какая-то грандиозная схема Каллибана. Мы переоценили его."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:389
translate ru qst_TheDarkPass_CampTalkDuprey_menu_04cc0520:

    # DUPREY "We were ordered to defend the neighbouring villages and towns when we should have had the army brought in and amassed an all-out assault, they’d caught us on the backfoot. We were still naive then."
    DUPREY "Нам приказали защищать соседние деревни и города, когда следовало ввести армию и начать полномасштабное наступление — они застали нас врасплох. Мы тогда были ещё наивны."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:390
translate ru qst_TheDarkPass_CampTalkDuprey_menu_52865a48:

    # "Captain Duprey took another sip of his drink, he seemed lost in his memories."
    "Капитан Дюпре сделал ещё один глоток своего напитка, казалось, он погрузился в воспоминания."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:391
translate ru qst_TheDarkPass_CampTalkDuprey_menu_9841065b:

    # DUPREY "We paid the price for those mistakes at Meadow Plains."
    DUPREY "Мы заплатили за эти ошибки на Равнинах Лугов."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:392
translate ru qst_TheDarkPass_CampTalkDuprey_menu_1d6c3970:

    # MC "{i}You{/i} were at The Battle of Meadow Plains?"
    MC "{i}Вы{/i} были в Битве на Равнинах Лугов?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:393
translate ru qst_TheDarkPass_CampTalkDuprey_menu_a7267a8b:

    # DUPREY "That I was."
    DUPREY "Был."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:394
translate ru qst_TheDarkPass_CampTalkDuprey_menu_3e8e0a2d:

    # DUPREY "I remember the bloodshed in the streets from the towns that had been annihilated."
    DUPREY "Я помню кровопролитие на улицах уничтоженных городов."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:395
translate ru qst_TheDarkPass_CampTalkDuprey_menu_22d390e2:

    # DUPREY "Every corner you turned around had death waiting for you on the other side."
    DUPREY "За каждым углом тебя поджидала смерть."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:396
translate ru qst_TheDarkPass_CampTalkDuprey_menu_36fdb802:

    # DUPREY "And there was the mad rush of thousands fleeing to Novaras to hide behind its walls."
    DUPREY "И было безумное бегство тысяч людей в Новарас, чтобы укрыться за его стенами."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:397
translate ru qst_TheDarkPass_CampTalkDuprey_menu_06bc1e0b:

    # DUPREY "The butchered bodies of the mages and Inquisitors before we arrived to offer relief."
    DUPREY "Изуродованные тела магов и инквизиторов до того, как мы прибыли оказать помощь."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:398
translate ru qst_TheDarkPass_CampTalkDuprey_menu_2020af46:

    # DUPREY "But most of all, I remember THAT battle."
    DUPREY "Но больше всего я помню ТУ битву."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:399
translate ru qst_TheDarkPass_CampTalkDuprey_menu_92a7cec2:

    # "We had all heard tales about the first great battle for Alderay and of how the ‘legendary General Newheart’ fell trying to relieve Fort Rook, the supposedly impenetrable Fortress of the South."
    "Мы все слышали рассказы о первой великой битве за Алдерей и о том, как 'легендарный генерал Ньюхарт' пал, пытаясь освободить Форт Рук, якобы неприступную крепость Юга."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:400
translate ru qst_TheDarkPass_CampTalkDuprey_menu_6539d583:

    # MC "... Were you there when General Newheart—"
    MC "... Вы были там, когда генерал Ньюхарт—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:401
translate ru qst_TheDarkPass_CampTalkDuprey_menu_db751ab3:

    # DUPREY "Old Iron Heart? Aye, we were friends."
    DUPREY "Старое Железное Сердце? Да, мы были друзьями."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:403
translate ru qst_TheDarkPass_CampTalkDuprey_menu_975a2b8e:

    # MC "... No way!"
    MC "... Не может быть!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:404
translate ru qst_TheDarkPass_CampTalkDuprey_menu_9b54e0a7:

    # MC "You knew General Newheart?"
    MC "Вы знали генерала Ньюхарта?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:405
translate ru qst_TheDarkPass_CampTalkDuprey_menu_de87c018:

    # MC "As in, THE Newheart? "
    MC "Того самого, НЬЮХАРТА?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:406
translate ru qst_TheDarkPass_CampTalkDuprey_menu_e1d8f53c:

    # DUPREY "He always hated how they changed his name, Lucan Erunheart was his real name before he was ‘blessed’ with ‘Newheart, Defender of The Realm’."
    DUPREY "Он всегда ненавидел как они изменили его имя, Лукан Эрунхарт было его настоящим именем, прежде чем его 'удостоили' именем 'Ньюхарт, Защитник Королевства'."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:407
translate ru qst_TheDarkPass_CampTalkDuprey_menu_409e8321:

    # DUPREY "But yes, I knew him alright."
    DUPREY "Но да, я его знал, конечно."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:408
translate ru qst_TheDarkPass_CampTalkDuprey_menu_191438df:

    # DUPREY "I was there at the war table with him; we strategized many a battle together."
    DUPREY "Я был с ним за военным столом; мы планировали множество битв вместе."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:409
translate ru qst_TheDarkPass_CampTalkDuprey_menu_8d6c11d2:

    # DUPREY "It was the two of us that pushed back Kalliban’s first invasion AND the Dark Elf King’s encroach. "
    DUPREY "Это мы вдвоем отбросили первое вторжение Каллибана И вторжение короля Тёмных Эльфов."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:410
translate ru qst_TheDarkPass_CampTalkDuprey_menu_89a0558d:

    # MC "That’s... That’s incredible!"
    MC "Это... Это невероятно!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:411
translate ru qst_TheDarkPass_CampTalkDuprey_menu_8523b42e:

    # DUPREY "Bah... I was a younger man back then, I ain’t as fast as I used to be."
    DUPREY "Бах... Я был моложе тогда, я уже не так быстр, как раньше."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:412
translate ru qst_TheDarkPass_CampTalkDuprey_menu_77f64d26:

    # DUPREY "Newheart though? The best warrior I’d ever met and a brilliant commander in the field."
    DUPREY "Но Ньюхарт? Лучший воин которого я когда-либо встречал, и блестящий командир в поле."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:413
translate ru qst_TheDarkPass_CampTalkDuprey_menu_bc2aaa32:

    # DUPREY "Handsome bastard as well, got all the girls swooning after him."
    DUPREY "Красавчик-ублюдок, все девушки по нему сходили с ума."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:414
translate ru qst_TheDarkPass_CampTalkDuprey_menu_0f58b1c0:

    # DUPREY "They still singing about him?"
    DUPREY "О нём до сих пор поют?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:415
translate ru qst_TheDarkPass_CampTalkDuprey_menu_0453fc0f:

    # MC "All the time! The man’s a legend!"
    MC "Постоянно! Этот человек — легенда!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:416
translate ru qst_TheDarkPass_CampTalkDuprey_menu_d3379069:

    # MC "I can’t believe you actually met him! You’re bound to hear at least one song about him in any of the taverns once people have had a drink or two!"
    MC "Не могу поверить, что вы действительно встречали его! Вы обязательно услышите хотя бы одну песню о нём в любой таверне, как только люди выпьют пару кружек!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:417
translate ru qst_TheDarkPass_CampTalkDuprey_menu_3829efd5:

    # DUPREY @ think "Hmph..."
    DUPREY @ think "Хмф..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:418
translate ru qst_TheDarkPass_CampTalkDuprey_menu_cc702e61:

    # MC "... Where did it all go wrong?"
    MC "... Где же всё пошло не так?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:419
translate ru qst_TheDarkPass_CampTalkDuprey_menu_56d22cd3:

    # "The Captain had become morose as he reminisced, but his anger was now evident as his eyes glared into the embers of the fire."
    "Капитан погрузился в уныние, вспоминая прошлое, но теперь его гнев стал очевиден, когда его глаза уставились на тлеющие угли костра."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:420
translate ru qst_TheDarkPass_CampTalkDuprey_menu_c44cfa87:

    # DUPREY "{i}Mesamor happened.{/i}"
    DUPREY "{i}Случился Месамор.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:421
translate ru qst_TheDarkPass_CampTalkDuprey_menu_4a075af6:

    # MC "What do you mean?"
    MC "Что вы имеете в виду?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:422
translate ru qst_TheDarkPass_CampTalkDuprey_menu_95893d7d:

    # DUPREY "I mean that old prick decided the siege tactics we had laid out would have taken too long."
    DUPREY "Я имею в виду, что этот старый ублюдок решил, что осадная тактика которую мы разработали, заняла бы слишком много времени."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:423
translate ru qst_TheDarkPass_CampTalkDuprey_menu_182fc79b:

    # DUPREY "So, he decided in his infinite fucking wisdom to push through some other general’s much more aggressive strategy."
    DUPREY "Поэтому, в своей бесконечной долбаной мудрости, он решил протолкнуть гораздо более агрессивную стратегию какого-то другого генерала."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:424
translate ru qst_TheDarkPass_CampTalkDuprey_menu_546d1fd8:

    # DUPREY "Mesamor couldn’t stand the idea of a prolonged war, he wanted to take back Fort Rook as quickly as possible and march south to take back everything else he’d lost."
    DUPREY "Месамор не выносил мысли о затяжной войне, он хотел как можно быстрее отбить Форт Рук и двинуться на юг, чтобы вернуть всё остальное, что он потерял."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:425
translate ru qst_TheDarkPass_CampTalkDuprey_menu_90a9bd26:

    # MC "I take it you didn’t approve."
    MC "Полагаю, вы не одобряли."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:426
translate ru qst_TheDarkPass_CampTalkDuprey_menu_07a85dee:

    # DUPREY "Years of actual battle experience and advice were cast out the window for the sake of bureaucracy, what do you think?"
    DUPREY "Годы реального боевого опыта и советов были выброшены за борт ради бюрократии, как ты думаешь?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:427
translate ru qst_TheDarkPass_CampTalkDuprey_menu_fdd64753:

    # MC "... So, what do you remember of the battle itself?"
    MC "... Итак, что вы помните о самой битве?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:428
translate ru qst_TheDarkPass_CampTalkDuprey_menu_42fc440a:

    # DUPREY "Lots of fighting... Dead everywhere... I saw more bodies that day than most men see in a lifetime."
    DUPREY "Много сражений... Мёртвые повсюду... В тот день я увидел больше тел, чем большинство мужчин видят за всю жизнь."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:429
translate ru qst_TheDarkPass_CampTalkDuprey_menu_719f6fe6:

    # DUPREY "From all the smoke and what felt like an avalanche of blood, it was hard just to breathe, never mind making sense of the field..."
    DUPREY "Из-за всего дыма и того, что ощущалось как лавина крови, было трудно просто дышать, не говоря уже о том, чтобы разобраться в происходящем на поле боя..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:430
translate ru qst_TheDarkPass_CampTalkDuprey_menu_5b6ff3e4:

    # DUPREY "Across the way on a small hill, I saw Newheart in that shimmering armour you lot like singing about so much. "
    DUPREY "На другом конце, на небольшом холме, я увидел Ньюхарта в той сверкающей броне, о которой вы так любите петь."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:431
translate ru qst_TheDarkPass_CampTalkDuprey_menu_021f89e6:

    # DUPREY "He stood alone against the Demorai General, a monstrous thing I can’t seem to forget even when I try..."
    DUPREY "Он стоял один против генерала Деморай, чудовищного существа, которое я не могу забыть, даже когда пытаюсь..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:432
translate ru qst_TheDarkPass_CampTalkDuprey_menu_5d817988:

    # DUPREY "{i}Zanarak.{/i}"
    DUPREY "{i}Занарак.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:433
translate ru qst_TheDarkPass_CampTalkDuprey_menu_cff33da7:

    # "{i}Zanarak{/i}, the bogeyman of every child in Alderay."
    "{i}Занарак{/i}, бабай для каждого ребёнка в Алдерее."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:434
translate ru qst_TheDarkPass_CampTalkDuprey_menu_0d9c3b4c:

    # "Stories spread far and wide of a supposed leader of the Demorai’s armies, unstoppable and ruthless, wings so large they could block out the sun and plunge an entire battlefield into a darkness as awful as himself..."
    "Истории распространились далеко и широко о предполагаемом лидере армий Деморай, неостановимом и безжалостном, с крыльями такими огромными, что они могли затмить солнце и погрузить всё поле боя во тьму, столь же ужасную, как и он сам..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:435
translate ru qst_TheDarkPass_CampTalkDuprey_menu_6cc1af85:

    # "Some doubt if he ever existed, so few survivors remain whenever he’s claimed to have been sighted and the tales they told were wilder than the legends of Newheart."
    "Некоторые сомневаются, существовал ли он вообще, ведь так мало выживших остаётся, когда его замечают, а их рассказы были ещё невероятнее, чем легенды о Ньюхарте."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:436
translate ru qst_TheDarkPass_CampTalkDuprey_menu_ba79f724:

    # MC "He’s... {i}real?{/i}"
    MC "Он... {i}реален?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:437
translate ru qst_TheDarkPass_CampTalkDuprey_menu_42eb289b:

    # DUPREY "As real as you and me, boy... Make no mistake about that."
    DUPREY "Так же реален, как ты и я, мальчик... Не сомневайся в этом."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:438
translate ru qst_TheDarkPass_CampTalkDuprey_menu_aaabade5:

    # DUPREY "{i}*Sigh*{/i} He fought bravely..."
    DUPREY "{i}*Вздох*{/i} Он сражался храбро..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:439
translate ru qst_TheDarkPass_CampTalkDuprey_menu_445ed618:

    # MC "How did—"
    MC "Как же—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:440
translate ru qst_TheDarkPass_CampTalkDuprey_menu_ab292432:

    # DUPREY "It took his head."
    DUPREY "Оно оторвало ему голову."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:441
translate ru qst_TheDarkPass_CampTalkDuprey_menu_7c0a6889:

    # DUPREY "I still remember that thing clutching him by the hair and holding it up for us all to see..."
    DUPREY "Я до сих пор помню, как эта штука схватила его за волосы и подняла, чтобы все мы увидели..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:442
translate ru qst_TheDarkPass_CampTalkDuprey_menu_42c2bad6:

    # DUPREY "Boasting of his kill, gloating at how easy it had been to take down the very best of us."
    DUPREY "Хвастаясь своей добычей, злорадствуя о том, как легко было одолеть лучшего из нас."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:443
translate ru qst_TheDarkPass_CampTalkDuprey_menu_5ee5ad2c:

    # "A chilling sense of dread slithered into every bone in my body... {i}What if we encountered some monster Zanarak while we were scouting out here now?{/i}"
    "Леденящее чувство страха просочилось в каждую кость моего тела... {i}А что, если мы встретим какого-нибудь монстра Занарака, пока будем разведывать местность сейчас?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:444
translate ru qst_TheDarkPass_CampTalkDuprey_menu_aa8fdbe9:

    # DUPREY "After that, you know the rest."
    DUPREY "После этого ты знаешь остальное."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:445
translate ru qst_TheDarkPass_CampTalkDuprey_menu_e8c1063f:

    # DUPREY "Lots of fighting, {i}Daggerfall.{/i}"
    DUPREY "Много сражений, {i}Даггерфолл.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:446
translate ru qst_TheDarkPass_CampTalkDuprey_menu_f2837818:

    # DUPREY "Mesamor deposed and Alcott declaring himself Emperor..."
    DUPREY "Месамор свергнут, и Алкотт провозглашает себя Императором..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:447
translate ru qst_TheDarkPass_CampTalkDuprey_menu_eaa48d0c:

    # MC "Can I hear some more about Daggerfall?"
    MC "Можно я услышу ещё о Даггерфолле?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:448
translate ru qst_TheDarkPass_CampTalkDuprey_menu_75f1addb:

    # DUPREY "I’m not a history teacher, lad."
    DUPREY "Я не учитель истории, парень."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:449
translate ru qst_TheDarkPass_CampTalkDuprey_menu_d246bf3c:

    # MC "I know sir, sorry I... guess I just to wish to hear from someone who was actually there."
    MC "Я знаю, сэр, извините, я... полагаю просто хочу услышать от того, кто на самом деле там был."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:450
translate ru qst_TheDarkPass_CampTalkDuprey_menu_e1044f79:

    # MC "I’m not sure how reliable those books we were given are."
    MC "Я не уверен, насколько надёжны те книги, что нам выдали."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:451
translate ru qst_TheDarkPass_CampTalkDuprey_menu_0014520a:

    # DUPREY "Hmph... Wise boy, you are... They probably try to paint a rosier picture than it really was."
    DUPREY "Хм... Мудрый парень, да... Наверное они пытаются нарисовать картину более радужной, чем она была на самом деле."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:452
translate ru qst_TheDarkPass_CampTalkDuprey_menu_e9a51bd0:

    # DUPREY "Don’t wanna give you kids too many nightmares, we’d never get you fighting for us otherwise!"
    DUPREY "Не хотят вам, детишкам, слишком много кошмаров навевать, а то мы бы никогда не заставили вас за нас сражаться!"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:453
translate ru qst_TheDarkPass_CampTalkDuprey_menu_69ce2041:

    # DUPREY "Operation Daggerfall was our last real gamble."
    DUPREY "Операция 'Даггерфолл' была нашей последней реальной ставкой."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:454
translate ru qst_TheDarkPass_CampTalkDuprey_menu_a90a9028:

    # DUPREY "We had managed some years before, when the war with the Demorai first really started, to suspend previous conflicts and form a loose alliance with the other kingdoms and races;"
    DUPREY "Нам удалось несколькими годами ранее, когда война с Деморай по-настоящему началась, приостановить прежние конфликты и сформировать непростой альянс с другими королевствами и расами;"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:455
translate ru qst_TheDarkPass_CampTalkDuprey_menu_077b901a:

    # DUPREY "Elves, Dwarves, Orcs, even the bloody Greater Trading Company..."
    DUPREY "Эльфы, Гномы, Орки, даже чёртова Великая Торговая Компания..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:456
translate ru qst_TheDarkPass_CampTalkDuprey_menu_005134d0:

    # DUPREY "Didn’t do much good though when the bastards kept showing up everywhere."
    DUPREY "Мало толку было, когда эти ублюдки продолжали появляться повсюду."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:457
translate ru qst_TheDarkPass_CampTalkDuprey_menu_c64175ec:

    # DUPREY "Following the failure of The Great Demorai Siege, we were in high spirits after our first major win."
    DUPREY "После провала Великой осады Деморай наш боевой дух был высок после первой крупной победы."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:458
translate ru qst_TheDarkPass_CampTalkDuprey_menu_55e137af:

    # DUPREY "We tried pushing back harder and faster to reclaim the South, but we were losing far too many men."
    DUPREY "Мы пытались оттеснить их сильнее и быстрее, чтобы вернуть Юг, но теряли слишком много людей."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:459
translate ru qst_TheDarkPass_CampTalkDuprey_menu_3792fe3b:

    # DUPREY "We had left people starving on the home front and many were starting to think the whole thing was a mistake, that a new strategy was needed."
    DUPREY "Мы оставили людей голодать в тылу, и многие начали думать, что вся эта затея была ошибкой, что нужна новая стратегия."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:460
translate ru qst_TheDarkPass_CampTalkDuprey_menu_5e0c932f:

    # DUPREY "I still remember stealing boots from some dead lieutenant because mine were literally rotting away..."
    DUPREY "Я до сих пор помню, как украл сапоги у какого-то мертвого лейтенанта, потому что мои буквально сгнили..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:461
translate ru qst_TheDarkPass_CampTalkDuprey_menu_c8369a76:

    # DUPREY "{i}*Sigh*{/i} Then came {i}Daggerfall{/i}."
    DUPREY "{i}*Вздох*{/i} А потом случился {i}Даггерфолл{/i}."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:462
translate ru qst_TheDarkPass_CampTalkDuprey_menu_928e3931:

    # "The Captain took another uneasy swig of his drink, as if pushing down some vile memory."
    "Капитан сделал ещё один нервный глоток своего напитка, словно пытаясь загнать вглубь какое-то отвратительное воспоминание."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:463
translate ru qst_TheDarkPass_CampTalkDuprey_menu_dbc2b92f:

    # DUPREY "{i}Fucking Daggerfall.{/i}"
    DUPREY "{i}Чёртов Даггерфолл.{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:464
translate ru qst_TheDarkPass_CampTalkDuprey_menu_6883b9ab:

    # MC "They tried to tell us in class that {i}Daggerfall{/i} wasn’t a total failure, that—"
    MC "Они пытались говорить нам на занятиях, что {i}Даггерфолл{/i} не был полным провалом, что—"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:465
translate ru qst_TheDarkPass_CampTalkDuprey_menu_99061ed9:

    # DUPREY "Oh, did they now?"
    DUPREY "Ох, неужели?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:466
translate ru qst_TheDarkPass_CampTalkDuprey_menu_78fa766f:

    # DUPREY "Bullshit, it was a disaster, and don’t you ever let any fancy prick in shiny armour who wasn’t even there tell you otherwise."
    DUPREY "Чушь, это была катастрофа, и никогда не позволяй какому-нибудь вычурному ублюдку в блестящих доспехах, которого там даже не было, говорить тебе обратное."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:467
translate ru qst_TheDarkPass_CampTalkDuprey_menu_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:468
translate ru qst_TheDarkPass_CampTalkDuprey_menu_fcc5db74:

    # DUPREY "It was Mesamor’s last real throw of the dice."
    DUPREY "Это была последняя серьёзная ставка Месамора."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:469
translate ru qst_TheDarkPass_CampTalkDuprey_menu_bd72acb9:

    # DUPREY "He thought to divide the army in two and have them sweep down like scythes, hoping to crush the enemy between them on two fronts."
    DUPREY "Он решил разделить армию на две части и заставить их двигаться вниз, как косы, надеясь раздавить врага между ними на двух фронтах."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:470
translate ru qst_TheDarkPass_CampTalkDuprey_menu_b1240136:

    # DUPREY "By that point, what was it? 1155? 1156 maybe?"
    DUPREY "К тому моменту, какой это был? 1155? 1156, может быть?"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:471
translate ru qst_TheDarkPass_CampTalkDuprey_menu_d1ee329d:

    # DUPREY "Either way, we had neither the manpower nor the resources to pull it off, they quickly broke through our lines and we had to retreat, weaker than ever."
    DUPREY "Так или иначе, у нас не было ни людей, ни ресурсов чтобы справиться, они быстро прорвали наши линии, и нам пришлось отступать, слабее чем когда-либо."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:472
translate ru qst_TheDarkPass_CampTalkDuprey_menu_2e122687:

    # DUPREY "... After that, Alcott led his coup, Mesamor became just a puppet, a monarch in name and nothing more, and the kingdom got split into factions."
    DUPREY "... После этого Алкотт устроил свой переворот, Месамор стал просто марионеткой, монархом по названию и не более, а королевство раскололось на фракции."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:473
translate ru qst_TheDarkPass_CampTalkDuprey_menu_c49fd91e:

    # MC "... I see."
    MC "... Понятно."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:477
translate ru qst_TheDarkPass_CampTalkDuprey_menu_e3b0a5e0:

    # DUPREY "Don’t know, orders are to secure the site and bring back the relics, that’s it."
    DUPREY "Не знаю, приказы — закрепиться на месте и забрать реликвии, вот и всё."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:478
translate ru qst_TheDarkPass_CampTalkDuprey_menu_35505111:

    # DUPREY "Frankly, I couldn’t give a shit about what we’re picking up."
    DUPREY "Честно говоря, мне плевать что мы забираем."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:479
translate ru qst_TheDarkPass_CampTalkDuprey_menu_4a7e500e:

    # DUPREY "In and out is my only concern."
    DUPREY "Войти и выйти — вот моя единственная забота."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:482
translate ru qst_TheDarkPass_CampTalkDuprey_menu_439e127d:

    # DUPREY "My wife passed to fever."
    DUPREY "Моя жена умерла от лихорадки."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:483
translate ru qst_TheDarkPass_CampTalkDuprey_menu_328b738e:

    # MC "Oh... I’m sorry, sir."
    MC "Оу... Соболезную, сэр."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:484
