    # MC "He must already be at the ceremony!"
    MC "Он уже должен быть на церемонии!"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:205
translate ru qst_Terminus_PathBlockMarkusHouse_d7e9e5d2:

    # MC "I should get to the Royal Palace."
    MC "Мне следует отправиться в Королевский дворец."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:209
