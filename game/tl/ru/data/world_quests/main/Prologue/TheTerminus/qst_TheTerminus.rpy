# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:210
translate ru qst_Terminus_PathBlockMarkusHouse2_f2338d07:

    # MC "Whatever tomorrow brings, we better face it well-rested..."
    MC "Что бы завтра ни принесло, нам лучше встретить это выспавшимися..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:214
