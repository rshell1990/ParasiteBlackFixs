translate ru qst_dreamhouse_talk_katiya_5d6d0ed7:

    # KATIYA @ think "No. In fact, I'm pretty sure he's long left the city by now."
    KATIYA @ think "Нет. На самом деле я почти уверена, что он уже давно покинул город."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:309
translate ru qst_dreamhouse_talk_katiya_7295fc09:

    # MC @ angry "(Damn it.)"
    MC @ angry "(Чёрт.)"

