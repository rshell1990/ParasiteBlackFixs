translate ru qst_dreamhouse_talk_katiya_wagonmenu_80a75cf1:

    # KATIYA @ think "Hmmm... I don't have much spare stock lying around."
    KATIYA @ think "Хммм... У меня почти нет свободного товара."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:333
translate ru qst_dreamhouse_talk_katiya_wagonmenu_df3bf324:

    # KATIYA @ talk "But I do have some of these goblin stimulants I bought from a merchant recently."
    KATIYA @ talk "Но у меня есть немного гоблинских стимуляторов, которые я недавно купила у одного торговца."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:334
translate ru qst_dreamhouse_talk_katiya_wagonmenu_f9e763d7:

    # KATIYA @ happy "I think they will be of great use to you."
    KATIYA @ happy "Я думаю, они тебе очень пригодятся."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:344
translate ru qst_dreamhouse_talk_katiya_wagonmenu_3c794f79:

    # KATIYA @ happy "Perfect."
    KATIYA @ happy "Отлично."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:345
translate ru qst_dreamhouse_talk_katiya_wagonmenu_e9b06e7c:

    # KATIYA @ talk "Here, it's far, but..."
    KATIYA @ talk "Вот, это далеко, но..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:346
translate ru qst_dreamhouse_talk_katiya_wagonmenu_aca27f39:

    # KATIYA @ talk "This is where he ordered the supply wagon to."
    KATIYA @ talk "Это именно сюда он заказал доставить повозку."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:355
translate ru qst_dreamhouse_talk_katiya_wagonmenu_4295e5b6:

    # KATIYA @ sad "Well... my wagon is still missing, so..."
    KATIYA @ sad "Что ж... моя повозка до сих потеряна, поэтому..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:356
translate ru qst_dreamhouse_talk_katiya_wagonmenu_72d1795d:

    # KATIYA @ sad "Let me know if you change your mind, I suppose."
    KATIYA @ sad "Дай мне знать если ты передумаешь, я надеюсь."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:360
translate ru qst_dreamhouse_katiya_rep_3ee09630:

    # KATIYA @ think "Well?"
    KATIYA @ think "Ну?"

