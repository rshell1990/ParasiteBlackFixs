translate ru qst_dreamhouse_after_katiya_06fea809:

    # SYPHA @ happy "Besides, a damsel is in distress, is she not?"
    SYPHA @ happy "К тому же, девица в беде, разве нет?"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:398
translate ru qst_dreamhouse_after_katiya_812b516a:

    # VES @ talk "Are we sure that is what this is?"
