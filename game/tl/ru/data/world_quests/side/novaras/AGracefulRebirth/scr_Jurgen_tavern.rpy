
# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:7
translate ru jurgen_0_tavern_c4ac02dd:

    # UNKNOWN "Hm? What do you want?"
    UNKNOWN "Хм? Что тебе нужно?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:8
translate ru jurgen_0_tavern_3e2e5224:

    # MC @ talk "You wouldn't happen to know a guard by the name of Jurgen, would you?"
    MC @ talk "Ты случайно не знаешь стражника по имени Юрген?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:11
translate ru jurgen_0_tavern_e861c212:

    # JURGEN "You're speaking to him, now what do you want?"
    JURGEN "Ты с ним и разговариваешь, так что тебе нужно?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:14
translate ru jurgen_0_tavern_4f4483bd:

    # JURGEN "Quit wasting my time!"
    JURGEN "Хватит тратить моё время!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:16
translate ru jurgen_0_tavern_06b0cd39:

    # MC "(Okay, that's our mark.)"
    MC "(Ладно, это наш человек.)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:21
translate ru jurgen_0_tavern_11eac3fe:

    # JURGEN "I'm sure they would."
    JURGEN "Уверен, они бы согласились."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:22
translate ru jurgen_0_tavern_655866dd:

    # JURGEN "So, are you the lap dog they've sent then?"
    JURGEN "Так ты и есть тот шавка, которого они прислали?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:23
translate ru jurgen_0_tavern_ff6effaf:

    # MC @ talk "What will it take to get you to back off?"
    MC @ talk "Что нужно, чтобы ты отстал?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:24
translate ru jurgen_0_tavern_d9ae11fe:

    # JURGEN "Nothing."
    JURGEN "Ничего."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:25
translate ru jurgen_0_tavern_5b247ea3:

    # MC @ talk "Really?"
    MC @ talk "Серьёзно?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:26
translate ru jurgen_0_tavern_9a1bc016:

    # JURGEN "If the Merchants wish to come clean, they may do so at their leisure for a less harsh sentence when the time comes."
    JURGEN "Если торговцы хотят чистосердечно признаться, они могут сделать это в удобное время для более мягкого приговора, когда придёт срок."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:27
translate ru jurgen_0_tavern_196e233b:

    # JURGEN "But {i}I know{/i} that the Merchant's guild no doubt has tied itself to the Black Market, however much they deny it."
    JURGEN "Но {i}я знаю{/i}, что гильдия торговцев, несомненно связана с Чёрным рынком, как бы они это ни отрицали."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:28
translate ru jurgen_0_tavern_4787ce7c:

    # JURGEN "And nothing you offer me is going to be worth the promotion when I'm done."
    JURGEN "И ничто, что ты мне предложишь, не будет стоить того повышения, когда я закончу."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:29
translate ru jurgen_0_tavern_07ea95c8:

    # MC @ talk "It's far more likely you'll be killed than rewarded."
    MC @ talk "Вероятность того что тебя убьют гораздо выше, чем того что тебя наградят."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:30
translate ru jurgen_0_tavern_d3b7bce7:

    # JURGEN "Ha! You think you can fool me?"
    JURGEN "Ха! Ты думаешь сможешь обмануть меня?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:31
translate ru jurgen_0_tavern_a1de09c2:

    # MC @ talk "Do you really think anyone is going to thank you for causing them a bureaucratic nightmare?"
    MC @ talk "Ты правда думаешь, что кто-то скажет тебе спасибо за то, что ты устроил им бюрократический кошмар?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:32
translate ru jurgen_0_tavern_8f90f6f9:

    # MC @ talk "You're a single guard crossing some powerful people on both sides... All you're going to do is get yourself cared."
    MC @ talk "Ты всего лишь один стражник, который перешёл дорогу влиятельным людям с обеих сторон... Всё, чего ты добьёшься — это того, что о тебе позаботятся."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:33
translate ru jurgen_0_tavern_c189d170:

    # JURGEN "C-Cease your lies!"
    JURGEN "П-Прекрати эту ложь!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:34
translate ru jurgen_0_tavern_5c2dd762:

    # JURGEN "Now leave me be at once before I have you arrested for attempting to bribe an officer!"
    JURGEN "А теперь оставь меня в покое, пока я не арестовал тебя за попытку дать взятку офицеру!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:35
translate ru jurgen_0_tavern_5f21cd05:

    # MC "(This is fruitless... I will need to find a different solution.)"
    MC "(Это бесплодно... Мне нужно найти другое решение.)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:36
translate ru jurgen_0_tavern_e25f9129:

    # MC "(Perhaps I could slip something into his drink?)"
    MC "(Может, подсыпать что-нибудь в его напиток?)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:43
translate ru jurgen_0_tavern_revisit_ebdf3e15:

    # JURGEN "What do you want?"
    JURGEN "Что ты хочешь?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:47
translate ru jurgen_0_tavern_revisit_8ac30186:

    # "Jurgen chuckled and turned away, as if he saw Alcott stand in my place, naked."
    "Юрген усмехнулся и отвернулся, словно увидел на моём месте обнажённого Алкотта."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:48
translate ru jurgen_0_tavern_revisit_f5e18757:

    # MC @ talk "(Yeah, this clearly doesn't work.)"
    MC @ talk "(Да, это явно не работает.)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:52
translate ru jurgen_0_tavern_revisit_6e3668f3:

    # JURGEN "What is this about?"
    JURGEN "О чём это?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:56
translate ru jurgen_0_tavern_revisit_b228b028:

    # JURGEN "Show me."
    JURGEN "Покажи."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:64
translate ru jurgen_0_tavern_revisit_c1cad31b:

    # MC "(Okay, let's do this...)"
    MC "(Ладно, сделаем это...)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:68
translate ru jurgen_0_tavern_revisit_4b8b9504:

    # JURGEN "Yeah you better!"
    JURGEN "Да, тебе лучше так и сделать!"

