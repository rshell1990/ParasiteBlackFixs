
# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:4
translate ru dros_4_getDros_c3e1c3d1:

    # DROS @ shock "A-Already?"
    DROS @ shock "У-Уже?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:5
translate ru dros_4_getDros_b46ef0f5:

    # DROS @ talk "Very well, lead the way."
    DROS @ talk "Очень хорошо, веди."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:14
translate ru dros_4_getDros_a45925f9:

    # DIVINE "Ah, Dros... You've arrived."
    DIVINE "Ах, Дрос... Ты прибыл."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:15
translate ru dros_4_getDros_e9db4a2e:

    # DROS @ smile "It is good to see you, Sister Divine."
    DROS @ smile "Рад вас видеть, Сестра Дивайн."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:16
translate ru dros_4_getDros_8d01fe15:

    # DIVINE @ angry "Given the trouble you've caused us in the past, I normally could not say the same..."
    DIVINE @ angry "Учитывая проблемы, которые ты причинял нам в прошлом, я обычно не могла бы сказать того же..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:17
translate ru dros_4_getDros_0f98b4f3:

    # DIVINE "But I suppose these are special circumstances."
    DIVINE "Но полагаю, сейчас особые обстоятельства."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:18
translate ru dros_4_getDros_33d35a12:

    # DROS @ sad "A-Ah... My behaviour has perhaps not always been the best, I admit, b-but-"
    DROS @ sad "А-Ах... Моё поведение, возможно не всегда было лучшим, признаю, н-но-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:19
translate ru dros_4_getDros_38babc78:

    # DIVINE "Come, Dros, I have prepared the ritual."
    DIVINE "Пойдём, Дрос, я подготовила ритуал."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:20
translate ru dros_4_getDros_251fb961:

    # DROS @ sad "Will... Will it hurt?"
    DROS @ sad "Будет... Будет больно?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:21
translate ru dros_4_getDros_5e8d612e:

    # DIVINE "...Hopefully not, Dros."
    DIVINE "...Надеюсь что нет, Дрос."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:22
translate ru dros_4_getDros_e213b104:

    # DIVINE "Are you truly sure you wish to-"
    DIVINE "Ты действительно уверен, что хочешь-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:23
translate ru dros_4_getDros_70e62fbb:

    # DROS @ talk "Yes... I'm sure."
    DROS @ talk "Да... Я уверен."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:24
translate ru dros_4_getDros_62e755a5:

    # DIVINE "Very well, follow me then."
    DIVINE "Хорошо, тогда следуй за мной."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:25
translate ru dros_4_getDros_11db2ad8:

    # "As Dros and Sister Divine headed down one of the Hallways, Sister Divine stopped me."
    "Когда Дрос и Сестра Дивайн направились по одному из коридоров, Сестра Дивайн остановила меня."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:26
translate ru dros_4_getDros_22b78691:

    # DIVINE "I'm afraid this is as far as you go."
    DIVINE "Боюсь, дальше тебе нельзя."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:27
translate ru dros_4_getDros_6a7a9ddd:

    # DIVINE "There are certain rules and traditions us Mages must follow."
    DIVINE "Есть определённые правила и традиции, которым мы, маги, должны следовать."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:28
translate ru dros_4_getDros_1d3ecee1:

    # DIVINE "You need to wait here."
    DIVINE "Тебе нужно подождать здесь."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:29
translate ru dros_4_getDros_0f5e1ab6:

    # DIVINE "We will return when ready."
    DIVINE "Мы вернёмся, когда будем готовы."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:30
translate ru dros_4_getDros_85fc1f08:

    # MC @ talk "Very well."
    MC @ talk "Хорошо."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:31
translate ru dros_4_getDros_1f14740f:

    # "Dros sheepishly glanced over his shoulder and looked at me as Sister Divine led him on."
    "Дрос робко оглянулся через плечо и посмотрел на меня, пока Сестра Дивайн вела его дальше."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:32
translate ru dros_4_getDros_52993c9d:

    # "After turning a corner, the two of them were finally out of sight, and I was left completely alone to ponder my thoughts."
    "Повернув за угол, они оба наконец скрылись из виду, и я остался в полном одиночестве, погружённый в свои мысли."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:34
translate ru dros_4_getDros_eb2e433a:

    # MC "(Hm, I hope this was the right decision.)"
    MC "(Хм, надеюсь это было правильное решение.)"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:36
translate ru dros_4_getDros_7812e635:

    # "It felt like I was waiting for hours, when I heard the sudden strange sounds and bright lights flash from around the corner Dros and Sister Divine headed down."
    "Мне показалось, что я прождал часами, когда вдруг услышал странные звуки и увидел яркие вспышки света из-за угла, куда направились Дрос и сестра Дивайн."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:38
translate ru dros_4_getDros_e9cbe315:

    # "With my hand at my blade, I took a few steps forward, when suddenly, Sister Divine emerged once again, smiling triumphantly."
    "С рукой на рукояти меча я сделал несколько шагов вперёд, как вдруг снова появилась сестра Дивайн, сияя торжествующей улыбкой."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:43
translate ru dros_4_getDros_f06c2614:

    # DIVINE "It pleases me to say, it was a success."
    DIVINE "С удовольствием сообщаю, что всё прошло успешно."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:44
translate ru dros_4_getDros_19b296f9:

    # MC @ talk "Where is Dros?"
    MC @ talk "Где Дрос?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:45
translate ru dros_4_getDros_846690e3:

    # DIVINE "Dros is gone..."
    DIVINE "Дроса больше нет..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:46
translate ru dros_4_getDros_43179f5d:

    # DIVINE "Draya! Come here!"
    DIVINE "Драя! Иди сюда!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:52
translate ru dros_4_getDros_924ba1fb:

    # "From around the corner, the beautiful elven girl shyly approached."
    "Из-за угла робко приблизилась прекрасная эльфийская девушка."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:55
translate ru dros_4_getDros_c325415b:

    # "For a moment, I did not recognize him, from the softening of the face to the widening of the hips, he looked so different than before."
    "На мгновение я не узнал его: смягчившиеся черты лица, расширившиеся бёдра — он выглядел так непохоже на прежнего."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:56
translate ru dros_4_getDros_5a77c6d2:

    # "As he spoke, the voice was a higher pitch, and unmistakenly feminine."
    "Пока он говорил, голос был выше по тону и несомненно женственным."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:57
translate ru dros_4_getDros_fdb5396b:

    # DROS @ talk "H-Hello."
    DROS @ talk "П-Привет."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:58
translate ru dros_4_getDros_3d7deb1d:

    # MC @ talk "Dros? Is that really-"
    MC @ talk "Дрос? Это правда ты-"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:59
translate ru dros_4_getDros_e9f0f02d:

    # DROS @ smile "{i}*Cough*{/i} I prefer to go by Draya now."
    DROS @ smile "{i}*Кашель*{/i} Я предпочитаю, чтобы меня называли Драя."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:60
translate ru dros_4_getDros_df31ef06:

    # MC @ talk "Oh... I see."
    MC @ talk "Оу... Понятно."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:61
translate ru dros_4_getDros_3e63ffe0:

    # DIVINE "My work here is done."
    DIVINE "Моя работа здесь завершена."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:62
translate ru dros_4_getDros_4a3811a7:

    # MC @ talk "What do I owe you for your services, Sister?"
    MC @ talk "Чем я обязан за ваши услуги, сестра?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:63
translate ru dros_4_getDros_61070ae7:

    # DIVINE "Nothing."
    DIVINE "Ничем."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:64
translate ru dros_4_getDros_662a3f30:

    # DIVINE "This spell was... enlightening."
    DIVINE "Это заклинание было... поучительным."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:65
translate ru dros_4_getDros_2034d8f3:

    # DIVINE "Consider it a gift."
    DIVINE "Считайте это подарком."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:66
translate ru dros_4_getDros_cf18f36a:

    # MC @ talk "Thank you."
    MC @ talk "Спасибо."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:67
translate ru dros_4_getDros_796540ce:

    # DIVINE "You're most welcome... Now, if you don't mind."
    DIVINE "Всегда пожалуйста... А теперь, если ты не против."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:68
translate ru dros_4_getDros_f475c049:

    # DIVINE "I have other business to attend."
    DIVINE "Мне нужно заняться другими делами."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:69
translate ru dros_4_getDros_638c51ac:

    # MC @ talk "Of course."
    MC @ talk "Конечно."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:71
translate ru dros_4_getDros_0ea1a5c9:

    # "Sister Divine led us outside, and an ecstatic Draya leapt into my arms to hug me before I pulled her off."
    "Сестра Дивайн вывела нас наружу, и восторженная Драя прыгнула мне в объятия, чтобы обнять прежде чем я её отцепил."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:78
translate ru dros_4_getDros_1da34f0d:

    # DROS @ smile "I... I can't believe it."
    DROS @ smile "Я... Я не могу в это поверить."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:79
translate ru dros_4_getDros_9866b910:

    # DROS @ smile "After all this time, I'm-"
    DROS @ smile "После всего этого времени, я..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:80
translate ru dros_4_getDros_bf8269dc:

    # DROS @ smile "I feel so alive!"
    DROS @ smile "Я чувствую себя такой живой!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:81
translate ru dros_4_getDros_985848dc:

    # MC @ talk "I am glad to help you, {i}Draya.{/i}"
    MC @ talk "Я рад помочь тебе, {i}Драя.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:83
translate ru dros_4_getDros_c222fa2d:

    # DROS @ talk "And don't think I forgot what we mentioned."
    DROS @ talk "И не думай что я забыла о том, о чём мы говорили."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:84
translate ru dros_4_getDros_d9034de3:

    # DROS @ smile "I'll give you a permanent fifteen percent discount on my store from now on."
    DROS @ smile "Отныне я дам тебе постоянную скидку в пятнадцать процентов в моём магазине."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:89
translate ru dros_4_getDros_87568343:

    # DROS @ talk "{i}*Cough*{/i} I see you still drive a hard bargain... Very well, twenty percent."
    DROS @ talk "{i}*Кашель*{/i} Вижу, ты всё ещё жёстко торгуешься... Ладно, двадцать процентов."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:92
translate ru dros_4_getDros_660a0896:

    # "Draya began to blush."
    "Драя начала краснеть."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:96
translate ru dros_4_getDros_c92f763d:

    # DROS @ lewd "There um, is {i}one{/i} more thing I wanted to talk with you about."
    DROS @ lewd "Тут, эм, есть {i}ещё одна{/i} вещь, о которой я хотела с тобой поговорить."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:97
translate ru dros_4_getDros_e46ff672:

    # MC @ talk "Oh?"
    MC @ talk "Оо?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:98
translate ru dros_4_getDros_fe2fa700:

    # DROS @ lewd "I suppose I should just come out and say it, shouldn't I?"
    DROS @ lewd "Полагаю, мне стоит просто выложить это прямо, да?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:99
translate ru dros_4_getDros_2994bbc9:

    # DROS @ lewd "You're... {i}Very attractive.{/i}"
    DROS @ lewd "Ты... {i}Очень привлекателен.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:100
translate ru dros_4_getDros_11b3ff7b:

    # "The comment was a surprising one, if they had given any hints prior to this, they certainly went over my head."
    "Комментарий был неожиданным; если до этого были какие-то намёки, я их точно пропустил."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:101
translate ru dros_4_getDros_027e0d9e:

    # DROS @ smile "I mean, you've done so much for me."
    DROS @ smile "Я имею в виду, ты сделал для меня так много."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:102
translate ru dros_4_getDros_89e312b0:

    # DROS @ smile "And now I look like this, I finally feel I have the confidence to ask these things."
    DROS @ smile "И теперь, когда я выгляжу так, я наконец чувствую уверенность чтобы спрашивать о таких вещах."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:103
translate ru dros_4_getDros_06fcfb5f:

    # MC @ talk "Draya, I..."
    MC @ talk "Драя, я..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:104
translate ru dros_4_getDros_b5f20c3b:

    # DROS @ shock "D-Don't feel you have to say yes!"
    DROS @ shock "Н-Не думай, что ты должен сказать да!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:105
translate ru dros_4_getDros_0fff7896:

    # DROS @ sad "I mean, I would understand if not... Just..."
    DROS @ sad "В смысле, я бы поняла, если нет... Просто..."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:106
translate ru dros_4_getDros_9897dbce:

    # "Draya smiled shyly."
    "Драя застенчиво улыбнулась."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:107
translate ru dros_4_getDros_2eef98ba:

    # DROS @ talk "Well?"
    DROS @ talk "Ну?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:120
translate ru dros_4_getDros_c0933bab:

    # "Despite her claims I did not have to say yes, my answer clearly left her a little deflated."
    "Несмотря на её слова, что мне не обязательно соглашаться, мой ответ явно немного огорчил её."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:121
translate ru dros_4_getDros_f09331be:

    # DROS @ sad "I... I see."
    DROS @ sad "Я... Понятно."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:122
translate ru dros_4_getDros_23ad4bbb:

    # DROS @ sad "Well, thank for being honest at least."
    DROS @ sad "Что ж, спасибо что был честен, по крайней мере."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:123
translate ru dros_4_getDros_ccac0064:

    # DROS @ talk "It's no matter though! I shall see you around, {i}friend.{/i}"
    DROS @ talk "Но это не важно! Увидимся, {i}друг.{/i}"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:124
translate ru dros_4_getDros_a330cb86:

    # "With that, Draya headed off, presumably back to their Tailor shop."
    "С этими словами Драя ушла, предположительно обратно в свою портновскую лавку."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:127
translate ru dros_4_getDros_b23df8f0:

    # DROS @ shock "You... You do?"
    DROS @ shock "Ты... Правда?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:128
translate ru dros_4_getDros_5dca7b91:

    # DROS @ lewd "I... Well, that's good!"
    DROS @ lewd "Я... Что ж, это хорошо!"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:129
translate ru dros_4_getDros_88578b00:

    # "Draya seemed to ponder the thought before giggling."
    "Драя, кажется задумалась над этим, прежде чем рассмеяться."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:130
translate ru dros_4_getDros_9465b4d8:

    # DROS @ lewd "So, what are we?"
    DROS @ lewd "Так кто мы друг другу?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:131
translate ru dros_4_getDros_0ca03866:

    # DROS @ lewd "I'm sorry, I'm still getting used to all this."
    DROS @ lewd "Прости, я всё ещё привыкаю ко всему этому."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:132
translate ru dros_4_getDros_93c8966a:

    # DROS @ lewd "What should I call you, [player_name!t]?"
    DROS @ lewd "Как мне тебя называть, [player_name!t]?"

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:135
translate ru dros_4_getDros_03d15310:

    # DROS @ smile "[dros_player_ref!t]? Well... If that's what you wish."
    DROS @ smile "[dros_player_ref!t]? Что ж... Если ты этого хочешь."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_getDrosAndRitual.rpy:138
