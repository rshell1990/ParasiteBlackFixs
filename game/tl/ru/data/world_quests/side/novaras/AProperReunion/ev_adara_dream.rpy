# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:61
translate ru ev_AdaraDream_a5eb4489:

    # BLACK "As our minds have melded, you now have access to my memories and dreams."
    BLACK "Поскольку наши умы слились, теперь у тебя есть доступ к моим воспоминаниям и снам."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:63
translate ru ev_AdaraDream_dd705834:

    # MC @ talk "I thought you couldn’t remember much about the time before?"
    MC @ talk "Я думал, ты мало что помнишь о времени до?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:64
translate ru ev_AdaraDream_25f93f64:

    # BLACK "Like glass shattered... My memories are fractured but still there."
    BLACK "Как разбитое стекло... Мои воспоминания раздроблены, но всё ещё здесь."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:65
translate ru ev_AdaraDream_9383871b:

    # BLACK "Buried deep."
    BLACK "Погребены глубоко."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:66
translate ru ev_AdaraDream_ae9783af:

    # MC @ talk "...What is this place? Why do you remember this?"
    MC @ talk "...Что это за место? Почему ты это помнишь?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:67
translate ru ev_AdaraDream_9a134f9f:

    # BLACK "Across the stars we came..."
    BLACK "Через звёзды мы пришли..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:68
translate ru ev_AdaraDream_9c89dcd3:

    # BLACK "Crashing down on worlds like some terrible wave."
    BLACK "Обрушиваясь на миры, словно ужасная волна."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:69
translate ru ev_AdaraDream_25ca0bc0:

    # MC @ talk "...Are these memories? {i}Or dreams?{/i}"
    MC @ talk "...Это воспоминания? {i}Или сны?{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:70
translate ru ev_AdaraDream_c92e89b3:

    # BLACK "I do not know anymore..."
    BLACK "Я уже не знаю..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:72
translate ru ev_AdaraDream_f54ced0b:

    # BLACK "But I dream of fire."
    BLACK "Но я вижу сны об огне."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:73
translate ru ev_AdaraDream_8f88444a:

    # BLACK "Fire scorching world to world as we move through the darkness of the cosmos."
    BLACK "Огонь, испепеляющий мир за миром, пока мы движемся сквозь космическую тьму."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:74
translate ru ev_AdaraDream_582666ea:

    # BLACK "With only one message prevailing... Chasing us as we move."
    BLACK "И лишь одно послание остаётся... Преследуя нас в пути."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:75
translate ru ev_AdaraDream_f3ab4321:

    # BLACK "{i}The hive must grow... The Hive must survive.{/i}"
    BLACK "{i}Рой должен расти... Рой должен выжить.{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:76
translate ru ev_AdaraDream_0a4d1ac6:

    # MC @ talk "What? "
    MC @ talk "Что?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:77
translate ru ev_AdaraDream_b44b37fc:

    # BLACK "With every blink, I see a world, a lifetime, memories of wars and strange things."
    BLACK "С каждым морганием я вижу мир, целую жизнь, воспоминания о войнах и странных вещах."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:78
translate ru ev_AdaraDream_472feaec:

    # MC @ talk "Your people... There was a war?"
    MC @ talk "Твой народ... Там была война?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:79
translate ru ev_AdaraDream_e58b1434:

    # MC @ talk "You’re not making any sense! "
    MC @ talk "Ты несешь полную чушь!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:80
translate ru ev_AdaraDream_2b9d1912:

    # BLACK "I cannot remember..."
    BLACK "Я не могу вспомнить..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:82
translate ru ev_AdaraDream_2137d59c:

    # BLACK "These memories are hazy, like trying to see clear through a storm."
    BLACK "Эти воспоминания туманны, словно пытаешься разглядеть что-то сквозь бурю."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:83
translate ru ev_AdaraDream_92e6a230:

    # BLACK "...But there’s a girl... A girl deep behind that storm."
    BLACK "...Но там есть девушка... Девушка глубоко за этой бурей."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:84
translate ru ev_AdaraDream_20553359:

    # BLACK "I can’t remember her face, or her name..."
    BLACK "Я не могу вспомнить её лицо или её имя..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:85
translate ru ev_AdaraDream_bcd2de67:

    # BLACK "But she’s there..."
    BLACK "Но она там..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:86
translate ru ev_AdaraDream_3a4c335f:

    # MC @ talk "Who? What are you talking about?"
    MC @ talk "Кто? О чём ты говоришь?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:87
translate ru ev_AdaraDream_743d9c9e:

    # BLACK "{i}Sleep...{/i} "
    BLACK "{i}Спать...{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:88
translate ru ev_AdaraDream_08fc79b0:

    # BLACK "{i}Rest...{/i}"
    BLACK "{i}Отдыхать...{/i}"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:89
translate ru ev_AdaraDream_08f62a8d:

    # MC @ talk "Wait! No! Don’t go!"
    MC @ talk "Стой! Нет! Не уходи!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:98
translate ru ev_AdaraDream_eecf2163:

    # "Springing up from my bed, sweat dripping off from me with wide eyed panic, I startled poor Adara who stumbled and nearly fell backwards from my abruptness. "
    "Вскочив с кровати, с меня капал пот, а глаза были широко раскрыты от паники. Я напугал бедную Адару, которая пошатнулась и чуть не упала назад от моей внезапности."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:101
translate ru ev_AdaraDream_df72778a:

    # MC @ talk "...!"
    MC @ talk "...!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:103
translate ru ev_AdaraDream_658d94b2:

    # ADARA @ shock "[player_name!t]! Calm yourself! "
    ADARA @ shock "[player_name!t]! Успокойся! "

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:104
translate ru ev_AdaraDream_52d96bc9:

    # MC @ talk "Where am I? "
    MC @ talk "Где я?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:105
translate ru ev_AdaraDream_5b30c851:

    # ADARA @ shock "In your room!"
    ADARA @ shock "В твоей комнате!"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:106
translate ru ev_AdaraDream_bcf69661:

    # MC @ talk "I... I am?"
    MC @ talk "Я... Я?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:108
translate ru ev_AdaraDream_3185e4bb:

    # ADARA @ talk "You’ve been running a fever."
    ADARA @ talk "У тебя была температура."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:109
translate ru ev_AdaraDream_e92f63c5:

    # ADARA @ talk "Neither I nor Regina have been able to wake you."
    ADARA @ talk "Ни я, ни Регина не смогли тебя разбудить."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:111
translate ru ev_AdaraDream_40cfc1d6:

    # MC "[regina_ref_cap!t]... Where is she?"
    MC "[regina_ref_cap!t]... Где она?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:112
translate ru ev_AdaraDream_8befebf9:

    # ADARA @ talk "Gone to fetch some herbs to help ease the fever."
    ADARA @ talk "Ушла за травами, чтобы помочь снять жар."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:113
translate ru ev_AdaraDream_01e74d2b:

    # "With a heavy sigh, I pressed my hands into my face."
    "С тяжёлым вздохом я прикрыл лицо руками."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:114
translate ru ev_AdaraDream_33d80bfe:

    # "That was unlike any dream... {i}Memory...{/i} Whatever it was."
    "Это был непохожий на любой сон... {i}Воспоминание...{/i} Что бы это ни было."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:117
translate ru ev_AdaraDream_58e2f1c1:

    # "Gently, I felt Adara’s hand rest onto me."
    "Нежно я почувствовал, как рука Адары легла на меня."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:118
translate ru ev_AdaraDream_7121cd5d:

    # ADARA @ talk "You had me really worried there."
    ADARA @ talk "Ты меня очень напугал."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:119
translate ru ev_AdaraDream_4ba51f06:

    # MC @ talk "What are you doing here anyway?"
    MC @ talk "Что ты вообще здесь делаешь?"

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:120
translate ru ev_AdaraDream_ae1c0dd5:

    # ADARA @ talk "I came here to see how you are."
    ADARA @ talk "Я пришла проведать, как ты."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:121
translate ru ev_AdaraDream_80ce1635:

    # ADARA @ talk "Regina said you've been like this for a while..."
    ADARA @ talk "Регина сказала, ты уже давно в таком состоянии..."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:122
translate ru ev_AdaraDream_25e7de18:

    # ADARA @ talk "Thrashing around unconscious, muttering something about 'stars' and 'fire' or something."
    ADARA @ talk "Беспокойно ворочишься в бессознательном состоянии, бормоча что-то о 'звёздах' и 'огне' или вроде того."

# game/data/world_quests/side/novaras/AProperReunion/ev_adara_dream.rpy:123
translate ru ev_AdaraDream_8418a966:

    # MC @ talk "..."
    MC @ talk "..."

