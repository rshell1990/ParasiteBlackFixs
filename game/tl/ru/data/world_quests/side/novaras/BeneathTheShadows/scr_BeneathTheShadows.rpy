    CARINA @ talk "Я, в свою очередь, возвращаю услуги чтобы поддерживать наши отношения здоровыми."

# game/data/world_quests/side/novaras/BeneathTheShadows/scr_BeneathTheShadows.rpy:104
translate ru qst_beneath_shadows_enter_bordello_meet_carina_c0f99fde:

    # CARINA @ smile "Do you understand?"
    CARINA @ smile "Теперь понимаешь?"

