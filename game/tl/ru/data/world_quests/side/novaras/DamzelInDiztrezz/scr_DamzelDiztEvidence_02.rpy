    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:5
    old "Follow the man..."
    new "Следовать за мужчиной..."

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_02.rpy:7
    old "Do nothing."
