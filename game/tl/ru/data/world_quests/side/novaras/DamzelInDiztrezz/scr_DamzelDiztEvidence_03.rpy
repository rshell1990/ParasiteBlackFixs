
# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:2
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_2a800512:

    # "Knocking on the iron door, a slider opened as two piercing eyes looked the other side."
    "Постучав в железную дверь, я увидел как открылась щель, и с другой стороны на меня уставились два пронзительных глаза."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:4
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6037568e:

    # THUG @ talk "Password?"
    THUG @ talk "Пароль?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:5
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_12b02307:

    # MC @ talk "Silver tits on top of a golden ass."
    MC @ talk "Серебряные сиськи на золотой заднице."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:6
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3b865931:

    # THUG @ talk "Wha~"
    THUG @ talk "Чт~"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:7
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d6761cbb:

    # MC @ talk "Go tell Tarek we've brought proof!"
    MC @ talk "Иди скажи Тареку, что мы принесли доказательства!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:9
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c2d8c402:

    # "After some muffled cursing, I heard the thug on the other side shuffle away."
    "После приглушённого ругательства я услышал, как громила с той стороны пошел прочь."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:10
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_bd24aa47:

    # "In a moment, a door opened and we were let in."
    "Через мгновение дверь открылась, и нас впустили."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:11
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_45402abc:

    # "Tarek awaited in his office."
    "Тарек ждал в своём кабинете."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:19
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_24c2dbf9:

    # MC @ talk "I have the proof you require Tarek."
    MC @ talk "У меня есть доказательства, которые ты требовал, Тарек."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:20
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_9b7fdd62:

    # TAREK @ shock "What?! Show me!"
    TAREK @ shock "Что?! Покажи!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:24
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_61e1b66d:

    # "I handed over the bloodied scroll to Tarek."
    "Я передал окровавленный свиток Тареку."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:25
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_a8317f86:

    # MC @ talk "The other factions are about to turn on you, the Vulshan and Khazah's know you are trying to weaken them by handing over their territory to the lesser factions."
    MC @ talk "Другие фракции вот-вот выступят против тебя, Вулшаны и Хазахи знают что ты пытаешься ослабить их, передавая их территории младшим фракциям."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:26
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_60cee6bc:

    # TAREK "I-"
    TAREK "Я-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:27
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5380f6ab:

    # "Tarek's face became sullen as the reality dawned on him."
    "Лицо Тарека потемнело, когда до него дошла реальность."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:28
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_b804709f:

    # TAREK @ sad "Yes... I can see now, it's all falling apart."
    TAREK @ sad "Да... Теперь я вижу, всё рушится."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:29
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_579d4c44:

    # MC @ talk "Surely you must have known trying to weaken their factions would result on them to turn on you?"
    MC @ talk "Неужели ты не понимал, что попытка ослабить их фракции приведёт к тому, что они выступят против тебя?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:30
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_1d4e9018:

    # TAREK "The Vulshan and Khazahs have been fighting for decades, I knew both were undermining my authority so what else was I supposed to do?"
    TAREK "Вулшаны и Хазахи воюют десятилетиями, я знал что обе стороны подрывают мой авторитет, так что что ещё мне оставалось делать?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:31
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6ca2cf51:

    # TAREK @ sad "Not that it matters now... You were right it seems, this was inevitable."
    TAREK @ sad "Не то чтобы это теперь важно... Похоже, ты был прав, это было неизбежно."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:32
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_74bf3445:

    # MC @ talk "What will you do now?"
    MC @ talk "Что ты будешь делать теперь?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:33
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_3e90c048:

    # TAREK "Worry not, I will keep my word and leave..."
    TAREK "Не беспокойся, я сдержу слово и уйду..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:34
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_36997e06:

    # TAREK "...But not before I let loose and hand over all the information I have to the inquisitors!"
    TAREK "...Но не раньше, чем я раскроюсь и передам всю имеющуюся у меня информацию инквизиторам!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:35
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4ff0ec6b:

    # MC @ talk "You'll try strike a deal with them?"
    MC @ talk "Ты попытаешься заключить с ними сделку?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:36
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e1c147f8:

    # TAREK "Why not? As it stands, I am a dead man... At least if I can offer them something in return, perhaps I may just walk away from all this with something to show still..."
    TAREK "А почему нет? В нынешнем положении я — мёртвый человек... По крайней мере, если я смогу предложить им что-то взамен, возможно, я ещё смогу уйти от всего этого с чем-то на руках..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:37
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_33c1f58a:

    # MC @ talk "...And Nijah?"
    MC @ talk "...А Ниджа?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:38
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_d4b7407a:

    # TAREK "Consider her debt settled."
    TAREK "Считай её долг погашенным."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:39
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_06188b6a:

    # TAREK "Before I go, you should know in my absence things may become more... {i}violent{/i} for a while."
    TAREK "Прежде чем я уйду, тебе следует знать, что в моё отсутствие на какое-то время всё может стать более... {i}жестоким{/i}."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:40
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_257af9a7:

    # TAREK @ angry "The violence I've tried to hold back will spill out in the power struggle to follow."
    TAREK @ angry "Насилие которое я пытался сдерживать, выплеснется наружу в борьбе за власть, которая последует."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:41
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_64af8631:

    # MC @ talk "Where will you go?"
    MC @ talk "Куда ты отправишься?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:42
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffa0994f:

    # TAREK "Who knows!"
    TAREK "Кто знает!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:43
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_4bef9a69:

    # TAREK "Perhaps we may even run into each other again..."
    TAREK "Возможно, мы даже снова столкнёмся друг с другом..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:44
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_6074ce3c:

    # TAREK "Don't worry, I won't forget what you did for me here today."
    TAREK "Не волнуйся, я не забуду, что ты для меня сегодня сделал."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:45
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_c9b5c36a:

    # TAREK "You could have just tried to kill me."
    TAREK "Ты мог просто попытаться убить меня."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:46
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_5d2a16c6:

    # MC @ talk "That's not my way."
    MC @ talk "Это не в моих правилах."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:47
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_ffbfa8ae:

    # TAREK "Hm... Perhaps there are still honest men in this land then."
    TAREK "Хм... Возможно, в этой земле ещё остались честные люди."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:48
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_e81bba9c:

    # TAREK "Farewell friend, I will be gone by nightfall."
    TAREK "Прощай, друг, я уйду до наступления ночи."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDiztEvidence_03.rpy:51
translate ru scr_nijah_damzelDizztrezz_goToTarekOfficeWithEvidence_52dc527f:

    # MC @ talk "Farewell, Tarek."
    MC @ talk "Прощай, Тарек."

