translate ru qst_DamzelDizzt_2_frontal_pit_4d4b4bfa:

    # MARKUS "...Just after one more bite."
    MARKUS "...Только ещё один кусочек."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:201
translate ru qst_DamzelDizzt_2_frontal_pit_b516b0d3:

    # "I stopped Markus from indulging further."
    "Я остановил Маркуса, не дав ему предаться дальнейшему."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:202
translate ru qst_DamzelDizzt_2_frontal_pit_2acd2fdb:

    # MC "Nijah! Bring her up quickly!"
    MC "Ниджа! Быстро подними её!"

