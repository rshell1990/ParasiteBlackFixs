    TAREK @ angry "Так что, звери, хотите взять меня?"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:178
translate ru qst_DamzelDizzt_2_frontal_pit_588153f2:

