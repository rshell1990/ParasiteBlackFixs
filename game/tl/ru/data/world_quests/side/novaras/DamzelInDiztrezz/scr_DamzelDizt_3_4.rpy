translate ru qst_DamzelDizzt_3_talkTarek_successCharm_730215d9:

    # WHITE "Us."
    WHITE "Нам."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:128
