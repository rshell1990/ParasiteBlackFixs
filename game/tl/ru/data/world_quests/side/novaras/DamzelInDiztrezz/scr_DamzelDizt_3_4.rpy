translate ru qst_DamzelDizzt_3_talkTarek_successCharm_73ddf738:

    # TAREK "I shall leave this city and take those who follow with me."
    TAREK "Я покину этот город и заберу с собой тех, кто следует за мной."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:59
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_bd91eba6:

    # MC @ talk "Then our business here is settled."
    MC @ talk "Тогда наше дело здесь улажено."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:60
