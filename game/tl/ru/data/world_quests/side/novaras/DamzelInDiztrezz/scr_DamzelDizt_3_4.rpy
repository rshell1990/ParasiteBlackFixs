# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:32
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_90fa2e1e:

    # MC @ talk "(Damn it, I hope Nijah doesn’t overreact to this next part!)"
    MC @ talk "(Чёрт возьми, надеюсь, Ниджа не слишком остро отреагирует на следующую часть!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:33
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_a7aad635:

    # "Looking at Markus, he gave me an incredulous look as I nodded, and he reluctantly nodded back in understanding."
    "Глядя на Маркуса, я увидел его недоверчивый взгляд, я кивнул, и он неохотно кивнул в ответ, понимая."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:35
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_13b82b37:

    # "Rising to our feet, the two of us transformed."
    "Поднявшись на ноги, мы оба преобразились."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:37
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_faee13cd:

    # "Nijah kicked her seat backwards in fear, petrified as she stared at the strange beasts before her."
    "Ниджа в страхе отшвырнула свой стул, окаменев и уставившись на странных зверей перед ней."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:38
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_ddf6cddc:

    # "Tarek, himself taken back, rose from his chair and moved with his back up against the wall, reaching for his blade as he turned pale white at the sight of the beasts before him."
    "Тарек, сам ошеломлённый, поднялся со стула и отступил к стене, хватаясь за свой клинок, его лицо побелело при виде зверей перед ним."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:48
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_cfdf0299:

    # MC @ talk "As you can see, we are telling you the truth."
    MC @ talk "Как видите, мы говорим вам правду."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:49
