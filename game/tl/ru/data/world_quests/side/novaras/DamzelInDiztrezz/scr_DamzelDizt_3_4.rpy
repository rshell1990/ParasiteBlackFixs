# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:4
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_97674a88:

    # MC @ talk "It is in all of our interests to avoid a messy investigation."
    MC @ talk "В интересах всех нас избежать грязного расследования."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:5
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_743a9061:

    # "Tarek angrily slammed his fist onto the table, grumbling beneath his breath."
    "Тарек сердито ударил кулаком по столу, бормоча что-то себе под нос."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:6
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_fff8ff65:

    # TAREK "You force us all into misery, you give us no choice but to become thieves and criminals to make a true living!"
    TAREK "Вы ввергаете нас всех в нищету, вы не оставляете нам выбора, кроме как становиться ворами и преступниками, чтобы заработать на жизнь!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:7
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_3c2e4270:

    # TAREK "We play by your rules and what do we get? Nothing but lies and more misery!"
    TAREK "Мы играем по вашим правилам, и что мы получаем? Одни лишь лживые обещания и ещё больше страданий!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:8
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_30eb797a:

    # TAREK "What choice is there for us stranded in this wretched city of yours? You make monsters of us all!"
    TAREK "Какой выбор есть у нас, застрявших в этом вашем жалком городе? Вы делаете из нас всех монстров!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:11
