    # TAREK "Perhaps you are who you say you are, perhaps not."
    TAREK "Возможно, ты тот, за кого себя выдаёшь, а возможно, и нет."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:27
translate ru qst_DamzelDizzt_3_talkTarek_successCharm_d75279c6:

    # TAREK "You ask a lot but give no proof other than your word..."
    TAREK "Ты много спрашиваешь, но не даёшь никаких доказательств, кроме своих слов..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_4.rpy:31
