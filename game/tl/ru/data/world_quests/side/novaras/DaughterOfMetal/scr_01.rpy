
# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:5
translate ru qst_DaughterOfMetal_01_492bc4af:

    # ARLENA "You’ve been busy lately..."
    ARLENA "Ты в последнее время был занят..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:8
translate ru qst_DaughterOfMetal_01_b941f80f:

    # ARLENA "See this is what I’m talking about!"
    ARLENA "Видишь, о чём я говорю!"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:9
translate ru qst_DaughterOfMetal_01_5eb137ef:

    # ARLENA "You’re such a fucking ass at times."
    ARLENA "Ты иногда такой гребаный мудак."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:10
translate ru qst_DaughterOfMetal_01_1dda88c0:

    # MC @ talk "Oh, yeah, because you’ve been so friendly?"
    MC @ talk "О, да, потому что ты была такой дружелюбной?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:12
translate ru qst_DaughterOfMetal_01_7eeeb87d:

    # ARLENA "Nice to see you too, asshole."
    ARLENA "Рада тебя видеть тоже, мудак."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:13
translate ru qst_DaughterOfMetal_01_480cd147:

    # ARLENA "Well... I actually wanted to know if you were free after dark."
    ARLENA "Ну... Вообще-то я хотела узнать, свободен ли ты после наступления темноты."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:14
translate ru qst_DaughterOfMetal_01_2eb2c8c0:

    # MC @ talk "Free? For what?"
    MC @ talk "Свободен? Для чего?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:15
translate ru qst_DaughterOfMetal_01_5e88f657:

    # ARLENA "A few of us are meeting at the {i}Iron Unicorn{/i}."
    ARLENA "Несколько из нас собираются в {i}Железном Единороге{/i}."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:16
translate ru qst_DaughterOfMetal_01_e619a84d:

    # ARLENA "I figured you might want to join us."
    ARLENA "Я подумала, ты, возможно захочешь присоединиться."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:17
translate ru qst_DaughterOfMetal_01_f47a248f:

    # ARLENA "You know, when you’re all done swallowing the swords of noblemen."
    ARLENA "Знаешь, когда закончишь глотать мечи благородных господ."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:18
translate ru qst_DaughterOfMetal_01_1c297c34:

    # MC @ talk "... You’re inviting me out?"
    MC @ talk "... Ты приглашаешь меня куда-то?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:19
translate ru qst_DaughterOfMetal_01_7fb745e1:

    # ARLENA "Yes."
    ARLENA "Да."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:20
translate ru qst_DaughterOfMetal_01_75b10289:

    # MC @ talk "... To have some drinks?"
    MC @ talk "... Выпить?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:21
translate ru qst_DaughterOfMetal_01_7fb745e1_1:

    # ARLENA "Yes."
    ARLENA "Да."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:22
translate ru qst_DaughterOfMetal_01_57027d0d:

    # MC @ talk "... So, you want me and you to—"
    MC @ talk "... Значит, ты хочешь, чтобы мы с тобой—"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:23
translate ru qst_DaughterOfMetal_01_a789db95:

    # ARLENA "Gods be fucking damned! YES! I am inviting you out, idiot!"
    ARLENA "Чтоб тебя, чёрт возьми! ДА! Я приглашаю тебя, идиот!"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:24
translate ru qst_DaughterOfMetal_01_5d3ad7f2:

    # ARLENA "Get that into your thick skull."
    ARLENA "Пропусти это через свою толстую башку."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:25
translate ru qst_DaughterOfMetal_01_bd0af062:

    # "I reached out to touch Arlena’s forehead before she slapped my hand away, a look of disgust on her face."
    "Я потянулся, чтобы дотронуться до лба Арлены, но она шлёпнула мою руку прочь, с отвращением глядя на меня."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:26
translate ru qst_DaughterOfMetal_01_09e2cf91:

    # ARLENA "What are you doing?"
    ARLENA "Что ты делаешь?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:27
translate ru qst_DaughterOfMetal_01_4856fc73:

    # MC @ talk "Just making sure you aren’t suffering a fever right now."
    MC @ talk "Просто проверяю, не температуришь ли ты сейчас."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:28
translate ru qst_DaughterOfMetal_01_dd465c0b:

    # ARLENA "Urgh... Turn up, don’t turn up."
    ARLENA "Ургх... Приходи, не приходи."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:29
translate ru qst_DaughterOfMetal_01_f21fbb7c:

    # ARLENA "I don’t give a shit."
    ARLENA "Мне насрать."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:31
translate ru qst_DaughterOfMetal_01_b017b264:

    # "With that, Arlena strode back inside, presumably to work out her annoyance at me by hammering the shit out of something on an anvil."
    "С этими словами Арлена зашагала обратно внутрь, вероятно чтобы выместить на мне своё раздражение, от души поколотив что-нибудь на наковальне."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:32
translate ru qst_DaughterOfMetal_01_324d1571:

    # MC "... Well... that was unexpected."
    MC "... Что ж... этого я не ожидал."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:33
translate ru qst_DaughterOfMetal_01_da5a206a:

    # MC "It might be worth joining Arlena and the others later if this is her way of holding out an olive branch."
    MC "Возможно, стоит присоединиться позже к Арлене и остальным, если это её способ протянуть оливковую ветвь."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_01.rpy:34
translate ru qst_DaughterOfMetal_01_1a258d0c:

    # MC "... That is, if I even want to accept it."
    MC "... То есть, если я вообще захочу её принять."

