
# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:2
translate ru qst_girl_troubles_main_label_f9953638:

    # "Sister Divine raised an eyebrow."
    "Сестра Дивайн приподняла бровь."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:3
translate ru qst_girl_troubles_main_label_0fca2510:

    # DIVINE @ talk "Which one?"
    DIVINE @ talk "Какой именно?"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:7
translate ru qst_girl_troubles_main_label_menu_24cedbd2:

    # DIVINE @ angry "Urghh, that girl..."
    DIVINE @ angry "Ургхх, эта девушка..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:8
translate ru qst_girl_troubles_main_label_menu_fa1af782:

    # DIVINE @ angry "I've told her {i}no{/i} dozens of times, but she continues to persist on the matter!"
    DIVINE @ angry "Я говорила ей {i}нет{/i} десятки раз, но она продолжает настаивать на этом!"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:9
translate ru qst_girl_troubles_main_label_menu_87d61d5d:

    # DIVINE @ angry "The garden isn't just for her, it's for {i}everyone.{/i}"
    DIVINE @ angry "Сад не только для неё, он для {i}всех.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:10
translate ru qst_girl_troubles_main_label_menu_93d2269a:

    # DIVINE @ angry "Not to mention that if she leaves the tower, who exactly is supposed to tend to this farming patch in her absence?"
    DIVINE @ angry "Не говоря уже о том, что если она покинет башню, кто именно должен будет ухаживать за этой грядкой в её отсутствие?"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:11
translate ru qst_girl_troubles_main_label_menu_55796b30:

    # MC @ talk "Surely you can spare some small section of the garden for her?"
    MC @ talk "Неужели вы не можете выделить ей какой-нибудь небольшой участок сада?"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:12
translate ru qst_girl_troubles_main_label_menu_7806a4fd:

    # DIVINE @ talk "{i}*Sigh*{/i}"
    DIVINE @ talk "{i}*Вздох*{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:13
translate ru qst_girl_troubles_main_label_menu_745474fe:

    # DIVINE @ talk "Any such decisions would have to be reviewed and approved by other council members."
    DIVINE @ talk "Любые подобные решения должны быть рассмотрены и одобрены другими членами совета."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:14
translate ru qst_girl_troubles_main_label_menu_f3038604:

    # DIVINE @ talk "Things are...very stringent around here."
    DIVINE @ talk "Здесь всё... очень строго."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:17
translate ru qst_girl_troubles_main_label_menu_2_ea7fcfec:

    # DIVINE @ talk "All of the mages have strict rules and regulations on most matters, even who you marry."
    DIVINE @ talk "У всех магов есть строгие правила и предписания по большинству вопросов, даже по поводу того, на ком жениться."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:18
translate ru qst_girl_troubles_main_label_menu_2_4e619828:

    # MC @ talk "Who you marry?"
    MC @ talk "На ком жениться?"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:19
translate ru qst_girl_troubles_main_label_menu_2_c62d19f2:

    # DIVINE @ talk "A mage can prove to be a powerful political asset for anyone; any binding unions need to seek the approval of the high council before they can get married."
    DIVINE @ talk "Маг может оказаться мощным политическим активом для любого; любые союзы, создающие обязательства, должны получить одобрение верховного совета, прежде чем можно будет вступить в брак."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:20
translate ru qst_girl_troubles_main_label_menu_2_a761da03:

    # MC @ talk "I suppose that makes sense, though I imagine it leaves many a mage in an awkward position should they fall in love with the wrong person."
    MC @ talk "Полагаю, это имеет смысл, хотя, думаю это ставит многих магов в неловкое положение, если они влюбятся не в того человека."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:21
translate ru qst_girl_troubles_main_label_menu_2_5550ab39:

    # "Sister Divine sighed softly."
    "Сестра Дивайн тихо вздохнула."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:22
translate ru qst_girl_troubles_main_label_menu_2_0572dcf9:

    # DIVINE @ sad "{i}It does indeed...{/i}"
    DIVINE @ sad "{i}Это действительно так...{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:44
translate ru qst_girl_troubles_main_label_menu_2_c3d62ed4:

    # DIVINE @ talk "With great risk, [player_name!t]... Great risk to my own station."
    DIVINE @ talk "С большим риском, [player_name!t]... Большим риском для моего собственного положения."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:28
translate ru qst_girl_troubles_main_label_menu_2_7806a4fd:

    # DIVINE @ talk "{i}*Sigh*{/i}"
    DIVINE @ talk "{i}*Вздох*{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:29
translate ru qst_girl_troubles_main_label_menu_2_29a60b44:

    # DIVINE @ talk "I suppose I could {i}attempt{/i} to pull some strings once more, even if it was just to keep the patch for her temporarily."
    DIVINE @ talk "Полагаю, я могла бы {i}попытаться{/i} снова надавить на нужные рычаги, даже если бы это было лишь для того, чтобы временно сохранить для неё грядку."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:30
translate ru qst_girl_troubles_main_label_menu_2_7b106cd0:

    # DIVINE @ talk "But ... What can you offer me in return?"
    DIVINE @ talk "Но... Что ты можешь предложить мне взамен?"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:33
translate ru qst_girl_troubles_main_label_menu_3_ba415944:

    # "Sister Divine's breathing became heavy as she shivered to my touch."
    "Дыхание Сестры Дивайн участилось, и она задрожала от моего прикосновения."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:34
translate ru qst_girl_troubles_main_label_menu_3_4ce3b50b:

    # DIVINE @ shock "I..."
    DIVINE @ shock "Я..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:35
translate ru qst_girl_troubles_main_label_menu_3_59ecb4a2:

    # DIVINE @ embar "Alright, fine!"
    DIVINE @ embar "Ладно, хорошо!"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:36
translate ru qst_girl_troubles_main_label_menu_3_e602f508:

    # DIVINE @ lewd "You better make good on that offer."
    DIVINE @ lewd "Лучше бы ты выполнил это обещание."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:37
translate ru qst_girl_troubles_main_label_menu_3_4caa9ae7:

    # MC @ lewd "Oh, don't worry, I plan on making it {i}unforgettable{/i} for you."
    MC @ lewd "О, не волнуйся, я планирую сделать это {i}незабываемым{/i} для тебя."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:38
translate ru qst_girl_troubles_main_label_menu_3_8422454d:

    # "Sister Divine let out another excited, trembling hot breath as she tried to keep herself composed."
    "Сестра Дивайн издала ещё один взволнованный, дрожащий горячий вздох, пытаясь сохранить самообладание."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:39
translate ru qst_girl_troubles_main_label_menu_3_37a611c2:

    # DIVINE @ lewd "I look forward to it ... Now tell Mika she has her farming patch, for now, at least."
    DIVINE @ lewd "С нетерпением жду этого... Теперь скажи Мике, что её грядка у неё, по крайней мере, пока что."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:44
translate ru qst_girl_troubles_main_label_menu_3_3b9bc389:

    # DIVINE @ talk "Hmm ... I suppose coin would certainly soften the blow of any criticisms at the next council meeting."
    DIVINE @ talk "Хм... Полагаю, монеты определённо смягчат удар от любой критики на следующем заседании совета."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:45
translate ru qst_girl_troubles_main_label_menu_3_d9d37a65:

    # DIVINE @ talk "Say, [QstLittleLies().divinePersuasionCost] should suffice..."
    DIVINE @ talk "Скажем, [QstLittleLies().divinePersuasionCost] должно хватить..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:49
translate ru qst_girl_troubles_main_label_menu_4_e2005c67:

    # DIVINE @ happy "Very good. Tell Mika the patch she wants is hers, at least for now."
    DIVINE @ happy "Очень хорошо. Скажи Мике, что нужная ей грядка — её, по крайней мере, пока что."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:55
translate ru qst_girl_troubles_main_label_menu_4_fddc0898:

    # DIVINE @ talk "Urgh, very well, I suppose I can make do with two thousand ... But not a coin less!"
    DIVINE @ talk "Уф, ладно пожалуй, я смогу обойтись двумя тысячами... Но ни монетой меньше!"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:58
translate ru qst_girl_troubles_main_label_menu_4_0659d7ff:

    # DIVINE @ talk "I can't go to the council without some kind of offering to ease any questions."
    DIVINE @ talk "Я не могу идти в совет без какого-либо подношения, чтобы смягчить возможные вопросы."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:59
translate ru qst_girl_troubles_main_label_menu_4_7fefe1d1:

    # DIVINE @ talk "Return when you have the coin..."
    DIVINE @ talk "Вернись, когда у тебя будут деньги..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:62
translate ru qst_girl_troubles_main_label_menu_4_c3ec61e5:

    # DIVINE @ talk "Well ... There is {i}one{/i} thing that I believe could persuade me."
    DIVINE @ talk "Ну... Есть {i}одна{/i} вещь, которая как я верю, могла бы меня убедить."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:63
translate ru qst_girl_troubles_main_label_menu_4_fd215e94:

    # MC @ talk "Speak it?"
    MC @ talk "Говори?"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:64
translate ru qst_girl_troubles_main_label_menu_4_56ff34f3:

    # DIVINE @ talk "A great white bear, exceptionally rare and particularly aggressive, known as a {i}rhuvan.{/i}"
    DIVINE @ talk "Большой белый медведь, исключительно редкий и особенно агрессивный, известный как {i}руван.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:65
translate ru qst_girl_troubles_main_label_menu_4_3f57fbb1:

    # DIVINE @ talk "Their hide is exceptionally prized and could be used as a gift to carry favor with many a lord and such."
    DIVINE @ talk "Их шкура исключительно ценится и может быть использована как подарок для завоевания благосклонности многих лордов и тому подобных."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:66
translate ru qst_girl_troubles_main_label_menu_4_2e78ce9d:

    # DIVINE @ talk "Should you be able to slay one of them and bring me its hide, I could give Mika her gardening patch in return."
    DIVINE @ talk "Если ты сможешь убить одного из них и принести мне его шкуру, я могла бы отдать Мике её садовый участок взамен."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:67
translate ru qst_girl_troubles_main_label_menu_4_d4880874:

    # MC @ think "Hm, I shall think on it."
    MC @ think "Хм, я подумаю над этим."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:2
translate ru qst_girl_troubles_about_rhuvan_1cfdff76:

    # DIVINE @ talk "Yes? Do you have its hide?"
    DIVINE @ talk "Да? У тебя есть его шкура?"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:8
translate ru qst_girl_troubles_about_rhuvan_ec917ed8:

    # DIVINE @ happy "Perfect!"
    DIVINE @ happy "Отлично!"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:9
translate ru qst_girl_troubles_about_rhuvan_d49e6166:

    # DIVINE @ happy "This should smooth any issues over with the council..."
    DIVINE @ happy "Это должно сгладить любые проблемы с советом..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:10
translate ru qst_girl_troubles_about_rhuvan_f4a09cac:

    # DIVINE @ happy "Tell Mika the patch is hers, for now, at least."
    DIVINE @ happy "Скажи Мике, что грядка её, по крайней мере, пока."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:17
translate ru qst_girl_troubles_about_rhuvan_5f2f1939:

    # DIVINE @ talk "Let me know if you have it."
    DIVINE @ talk "Дай мне знать, если она у тебя."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:87
translate ru qst_girl_troubles_main_label_menu_4_ea37f955:

    # DIVINE @ happy "Yes, I've {i}seen.{/i}"
    DIVINE @ happy "Да, я {i}видела.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:88
translate ru qst_girl_troubles_main_label_menu_4_ad7cb217:

    # DIVINE @ happy "She's come so much out of her shell since you've started helping her."
    DIVINE @ happy "Она так раскрылась с тех пор, как ты начал ей помогать."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:89
translate ru qst_girl_troubles_main_label_menu_4_6648b615:

    # MC @ talk "She's ready to face whatever's out there."
    MC @ talk "Она готова встретить всё, что там есть."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:90
translate ru qst_girl_troubles_main_label_menu_4_d48d0774:

    # DIVINE @ talk "Well... No one's truly ever {i}ready.{/i}"
    DIVINE @ talk "Ну... Никто никогда не бывает по-настоящему {i}готов.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:91
translate ru qst_girl_troubles_main_label_menu_4_fdf7a669:

    # DIVINE @ talk "But I think now her fate is in the hands of the gods to keep her safe."
    DIVINE @ talk "Но я думаю, теперь её судьба в руках богов, чтобы сохранить её в безопасности."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:96
translate ru qst_girl_troubles_main_label_menu_4_c7d53906:

    # DIVINE @ happy "Well done, [player_name!t], here's your reward..."
    DIVINE @ happy "Отличная работа, [player_name!t], вот твоя награда..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:99
translate ru qst_girl_troubles_main_label_menu_4_c0800976:

    # DIVINE @ talk "{i}Intimate?{/i}"
    DIVINE @ talk "{i}Интимных?{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:100
translate ru qst_girl_troubles_main_label_menu_4_46740ede:

    # "Suddenly realizing what Mika was asking for, Sister Divine panicked as she offered sheepish protest."
    "Внезапно осознав, о чём спрашивает Мика, сестра Дивайн запаниковала и застенчиво запротестовала."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:101
translate ru qst_girl_troubles_main_label_menu_4_f18d7bb4:

    # DIVINE @ shock "I- I never cross boundaries with any of the girls! I-I'm their-"
    DIVINE @ shock "Я- Я никогда не перехожу границы с девушками! Я их-"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:102
translate ru qst_girl_troubles_main_label_menu_4_289c6df4:

    # MC @ talk "Sister Divine, Mika told me everything."
    MC @ talk "Сестра Дивайн, Мика мне всё рассказала."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:103
translate ru qst_girl_troubles_main_label_menu_4_d9eff049:

    # DIVINE @ sad "... I see."
    DIVINE @ sad "... Понятно."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:104
translate ru qst_girl_troubles_main_label_menu_4_61e8ed36:

    # DIVINE @ sad "I - I understand this probably isn't something you approve of, but..."
    DIVINE @ sad "Я- Я понимаю, что ты вероятно, не одобряешь это, но..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:105
translate ru qst_girl_troubles_main_label_menu_4_d23b7c9a:

    # DIVINE @ sad "Kindly keep this knowledge to yourself."
    DIVINE @ sad "Пожалуйста, сохрани это знание при себе."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:106
translate ru qst_girl_troubles_main_label_menu_4_7bdaee64:

    # DIVINE @ sad "The girls ... Us Mages of Palam, it's a terribly lonely life."
    DIVINE @ sad "Девушки... Мы, маги Палама, ведём ужасно одинокую жизнь."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:107
translate ru qst_girl_troubles_main_label_menu_4_e13d3ea2:

    # DIVINE @ sad "The expectations to be these saint-like figures is crushing, especially for those who don't want it."
    DIVINE @ sad "Ожидания быть такими святыми фигурами — это тяжкое бремя, особенно для тех, кто этого не хочет."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:108
translate ru qst_girl_troubles_main_label_menu_4_d6fdf35c:

    # DIVINE @ sad "A life without love is terrible, and love to a Mage of Palam is a delicate, often impossible thing to keep."
    DIVINE @ sad "Жизнь без любви ужасна, а любовь для мага Палама — хрупкая, часто невозможная для сохранения вещь."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:109
translate ru qst_girl_troubles_main_label_menu_4_3a76119c:

    # DIVINE @ sad "But grown women still have needs ... So we find what we can of it amongst ourselves."
    DIVINE @ sad "Но взрослые женщины всё ещё имеют потребности... Поэтому мы находим, что можем, среди себя."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:110
translate ru qst_girl_troubles_main_label_menu_4_10285b36:

    # MC @ talk "You don't need to explain yourself to me, sister."
    MC @ talk "Тебе не нужно объясняться передо мной, сестра."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:111
translate ru qst_girl_troubles_main_label_menu_4_4014a5dc:

    # MC @ talk "I only mentioned it because Mika has asked me to persuade you to give her the same affection as you give the others."
    MC @ talk "Я упомянул это лишь потому, что Мика попросила меня уговорить тебя дать ей такую же ласку, как и остальным."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:112
translate ru qst_girl_troubles_main_label_menu_4_c7f64210:

    # DIVINE @ sad "I-"
    DIVINE @ sad "Я..."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:113
translate ru qst_girl_troubles_main_label_menu_4_cc9e4cc1:

    # DIVINE @ talk "I didn't quite realize she felt that way, I never intended to make her feel unwanted."
    DIVINE @ talk "Я не совсем понимала, что она так чувствует, я не хотела, чтобы она чувствовала себя нежеланной."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:114
translate ru qst_girl_troubles_main_label_menu_4_91c8563f:

    # DIVINE @ embar "... Very well, tell Mika to meet me in the tower bathhouse tonight."
    DIVINE @ embar "... Хорошо, скажи Мике встретиться со мной сегодня вечером в бане башни."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:115
translate ru qst_girl_troubles_main_label_menu_4_6ab76246:

    # DIVINE @ embar "I shall make it up to her in full."
    DIVINE @ embar "Я полностью заглажу свою вину перед ней."

