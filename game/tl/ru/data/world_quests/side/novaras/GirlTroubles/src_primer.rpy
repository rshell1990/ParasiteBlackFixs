
# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:3
translate ru primer_girl_troubles_1_fc4cddb5:

    # MESSENGER "Wait! Hold up!"
    MESSENGER "Погодите! Подождите!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:5
translate ru primer_girl_troubles_1_0ed1380f:

    # "Stopping in my tracks, I turned to face the young boy hurrying towards me."
    "Остановившись на полном ходу, я повернулся к молодому парню, спешащему ко мне."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:7
translate ru primer_girl_troubles_1_cc1bdfcf:

    # MC @ think "Can I help you?"
    MC @ think "Я могу тебе помочь?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:8
translate ru primer_girl_troubles_1_b9d4697a:

    # MESSENGER "Sister Divine requests your presence at the tower of Palam at once."
    MESSENGER "Сестра Дивайн просит вас немедленно явиться в башню Палама."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:9
translate ru primer_girl_troubles_1_ff0934a5:

    # MC @ talk "Sister Divine?"
    MC @ talk "Сестра Дивайн?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:10
translate ru primer_girl_troubles_1_bef6b9ee:

    # MC @ talk "Did you say why?"
    MC @ talk "Она сказала, зачем?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:11
translate ru primer_girl_troubles_1_4755a9a3:

    # MESSENGER "No sir, but she said it was a matter most urgent."
    MESSENGER "Нет, сэр, но она сказала, что это дело крайней важности."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:12
translate ru primer_girl_troubles_1_2e49f35d:

    # MESSENGER "Now, if you'll excuse me, I've got to deliver my next message!"
    MESSENGER "А теперь, если позволите, мне нужно доставить следующее сообщение!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:16
translate ru primer_girl_troubles_1_bd996885:

    # MC "(Hmm... I should stop by the tower of Palam when I get a chance.)"
    MC "(Хм... Мне стоит заглянуть в башню Палама, когда будет возможность.)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:26
translate ru primer_girl_troubles_2_4fb8f212:

    # DIVINE @ talk "Ah, there you are."
    DIVINE @ talk "А, вот и ты."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:27
translate ru primer_girl_troubles_2_bd6dbff0:

    # "Divine steps out from behind her desk, a playful glint in her eye as she moves closer."
    "Дивайн выходит из-за своего стола, с игривым блеском в глазах приближаясь ко мне."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:32
translate ru primer_girl_troubles_2_4630b090:

    # "Without a word, she wraps her arms around me, her lips finding mine in a slow, deliberate kiss."
    "Без единого слова она обвивает меня руками, её губы встречаются с моими в медленном, обдуманном поцелуе."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:33
translate ru primer_girl_troubles_2_dd678d35:

    # MC "(Her touch is familiar, warm...)"
    MC "(Её прикосновение знакомое, тёплое...)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:34
translate ru primer_girl_troubles_2_01941bc7:

    # "My hand drifts down instinctively, fingers grazing her waist before resting on her backside."
    "Моя рука инстинктивно опускается вниз, пальцы скользят по её талии, прежде чем остановиться на её ягодицах."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:35
translate ru primer_girl_troubles_2_e70ed2d3:

    # DIVINE @ happy "Mmm... You never change, do you?"
    DIVINE @ happy "М-м-м... Ты никогда не меняешься, правда?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:36
translate ru primer_girl_troubles_2_964d7d25:

    # "She lets out a soft, breathy laugh, before gently pushing away, cheeks flushed."
    "Она издаёт тихий, прерывистый смешок, прежде чем мягко отстраниться, с покрасневшими щеками."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:41
translate ru primer_girl_troubles_2_db756b90:

    # MC @ smile "That's quite a desk you’ve got there, you know. I'd love to see you—"
    MC @ smile "У тебя довольно интересный стол, знаешь ли. Я бы с удовольствием посмотрел, как ты—"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:42
translate ru primer_girl_troubles_2_ef0995eb:

    # DIVINE @ laugh "Easy, easy! I didn’t call you here for {i}that.{/i}"
    DIVINE @ laugh "Тише, тише! Я позвала тебя сюда не для {i}этого.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:43
translate ru primer_girl_troubles_2_a93764bb:

    # DIVINE @ happy "Though, maybe later... if there's time."
    DIVINE @ happy "Хотя, может быть, позже... если будет время."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:45
translate ru primer_girl_troubles_2_dde96000:

    # "Sister Divine stands behind her desk, her expression unreadable as she watches me enter."
    "Сестра Дивайн стоит за своим столом, её выражение лица нечитаемо, пока она наблюдает, как я вхожу."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:46
translate ru primer_girl_troubles_2_b9dbb770:

    # DIVINE @ talk "It’s good to see you again. I’ve been meaning to speak with you."
    DIVINE @ talk "Рада снова тебя видеть. Я давно хотела с тобой поговорить."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:48
translate ru primer_girl_troubles_2_559540db:

    # MC @ talk "So, what's this about?"
    MC @ talk "Так, о чём это?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:49
translate ru primer_girl_troubles_2_1eea1aea:

    # DIVINE @ talk "Tell me, what do you know about the tower?"
    DIVINE @ talk "Скажи, что ты знаешь о башне?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:50
translate ru primer_girl_troubles_2_399a0353:

    # MC @ think "Hm? Not much..."
    MC @ think "Хм? Не особо много..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:51
translate ru primer_girl_troubles_2_63c38e46:

    # MC @ talk "I know mages of Palam are taken from their parents from a young age to join the order."
    MC @ talk "Я знаю, что магов Палама забирают у родителей в юном возрасте, чтобы они вступили в орден."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:52
translate ru primer_girl_troubles_2_51c5a5cf:

    # DIVINE @ talk "Being a mage is a lifelong commitment, and many start young at one of the smaller holds before coming here."
    DIVINE @ talk "Быть магом — это пожизненное обязательство, и многие начинают рано в одном из небольших фортов, прежде чем попасть сюда."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:53
translate ru primer_girl_troubles_2_a09d053a:

    # DIVINE @ talk "It's best to think of this tower as a kind of university, but to mages, any hold under their magecraft is considered a second home they're expected to return to throughout their life periodically."
    DIVINE @ talk "Лучше всего думать об этой башне как о своего рода университете, но для магов любой форт под их магическим контролем считается вторым домом, в который они должны периодически возвращаться на протяжении всей жизни."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:54
translate ru primer_girl_troubles_2_eec6e3a7:

    # DIVINE @ talk "Suffice it to say I care for each and every girl who comes here, many of whom I've known to some degree since they were small."
    DIVINE @ talk "Достаточно сказать, что я забочусь о каждой девушке, которая приходит сюда, многих из которых я знаю в той или иной степени с детства."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:55
translate ru primer_girl_troubles_2_df064ee4:

    # MC @ talk "I see... But why the urgent summoning? Where do I fit into all this?"
    MC @ talk "Понятно... Но почему срочный вызов? Какое я имею ко всему этому отношение?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:56
translate ru primer_girl_troubles_2_a9467911:

    # DIVINE @ talk "Since this war began, Mages have been, with the end of every terminus ceremony, sent towards the front."
    DIVINE @ talk "С начала этой войны магов после каждой завершающей церемонии терминуса отправляли на фронт."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:57
translate ru primer_girl_troubles_2_af61e39a:

    # DIVINE @ talk "Thankfully, many of my girls are usually kept back to help deal with the wounded, so losses are limited."
    DIVINE @ talk "К счастью, многих моих девушек обычно оставляют в тылу, чтобы помогать с ранеными, так что потери ограничены."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:58
translate ru primer_girl_troubles_2_a8a38eea:

    # DIVINE @ talk "With that said, Alcott's government continues to put more and more pressure on getting out the door, regardless of capabilities."
    DIVINE @ talk "Тем не менее, правительство Алкотта продолжает оказывать всё больше давления, чтобы мы выходили на задания, несмотря на возможности."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:59
translate ru primer_girl_troubles_2_8241cd14:

    # "Sister Divine paused uncomfortably."
    "Сестра Дивайн сделала неловкую паузу."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:60
translate ru primer_girl_troubles_2_836dcfe9:

    # DIVINE @ talk "... Last month, four of my girls stationed at a camp were killed by a surprise ambush."
    DIVINE @ talk "... В прошлом месяце четыре мои девушки, находившиеся в лагере, были убиты во время внезапной засады."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:61
translate ru primer_girl_troubles_2_eae6fb6b:

    # DIVINE @ talk "From what reports I have, the girls panicked and fumbled their spells."
    DIVINE @ talk "Судя по имеющимся у меня отчётам, девушки запаниковали и не смогли правильно применить заклинания."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:62
translate ru primer_girl_troubles_2_1cd0a9e5:

    # DIVINE @ sad "... They weren't ready."
    DIVINE @ sad "... Они не были готовы."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:63
translate ru primer_girl_troubles_2_c3780307:

    # MC @ sad "That's horrible."
    MC @ sad "Это ужасно."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:64
translate ru primer_girl_troubles_2_ead16311:

    # DIVINE @ angry "Standards are slipping..."
    DIVINE @ angry "Стандарты падают..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:65
translate ru primer_girl_troubles_2_3eeccae0:

    # DIVINE @ sad "And my girls are dying for it."
    DIVINE @ sad "И мои девушки расплачиваются за это жизнями."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:68
translate ru primer_girl_troubles_2_menu_685b6d3d:

    # DIVINE @ talk "I've tried."
    DIVINE @ talk "Я пыталась."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:69
translate ru primer_girl_troubles_2_menu_3a9ef15e:

    # DIVINE @ talk "The officials don't care for the quality of Mages, only that there {i}are{/i} Mages."
    DIVINE @ talk "Чиновникам не важны качества магов, им важно лишь, что маги {i}вообще есть{/i}."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:70
translate ru primer_girl_troubles_2_menu_9c138b9c:

    # DIVINE @ talk "My concerns fall on deaf ears."
    DIVINE @ talk "Мои опасения остаются без внимания."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:73
translate ru primer_girl_troubles_2_menu_75a8f7bf:

    # DIVINE @ angry "I am aware people 'die' in war; I'm not a fool."
    DIVINE @ angry "Я знаю, что на войне люди 'погибают'; Я не дура."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:74
translate ru primer_girl_troubles_2_menu_16b704db:

    # DIVINE @ talk "But there are only ever so many mages per year, and magecraft is a lifelong commitment to master."
    DIVINE @ talk "Но каждый год появляется лишь ограниченное число магов, а магическое искусство требует пожизненной преданности для освоения."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:75
translate ru primer_girl_troubles_2_menu_6917f041:

    # DIVINE @ talk "It's not as simple as replacing a simple grunt... No offense."
    DIVINE @ talk "Это не так просто, как заменить простого солдата... Без обид."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:76
translate ru primer_girl_troubles_2_menu_c8f104a8:

    # MC @ talk "None taken."
    MC @ talk "Никаких обид."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:79
translate ru primer_girl_troubles_2_menu_b528cbb1:

    # DIVINE @ talk "Three girls of mine, troublesome issues with each."
    DIVINE @ talk "Три мои ученицы, у каждой — свои проблемные моменты."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:80
translate ru primer_girl_troubles_2_menu_5be2fe8f:

    # DIVINE @ talk "I've put my foot down and held them back from being assigned to the front."
    DIVINE @ talk "Я проявила твёрдость и удержала их от отправки на фронт."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:81
translate ru primer_girl_troubles_2_menu_ac431a22:

    # MC @ talk "Why?"
    MC @ talk "Почему?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:82
translate ru primer_girl_troubles_2_menu_e02e14c6:

    # DIVINE @ talk "They're not ready... And I'm not prepared to knowingly send some of my girls to their deaths."
    DIVINE @ talk "Они не готовы... И я не готова сознательно отправлять своих учениц на верную смерть."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:83
translate ru primer_girl_troubles_2_menu_cd04b852:

    # DIVINE @ talk "Now, I don't have time to resolve these issues myself; I have to prepare the next batch of mages, who are already showing similar issues, for next year's terminus ceremony."
    DIVINE @ talk "Сейчас у меня нет времени решать эти проблемы самостоятельно; Мне нужно подготовить следующую группу магов, у которых уже проявляются схожие трудности, к церемонии терминуса в следующем году."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:84
translate ru primer_girl_troubles_2_menu_97eba329:

    # DIVINE @ talk "I want you to become their... Mentor."
    DIVINE @ talk "Я хочу чтобы ты стал их... Наставником."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:85
translate ru primer_girl_troubles_2_menu_592cb8fe:

    # MC @ surprised "Mentor? Me? I don't even possess any magecraft!"
    MC @ surprised "Наставник? Я? У меня даже нет магических способностей!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:86
translate ru primer_girl_troubles_2_menu_f412c6a1:

    # DIVINE @ talk "Ah, but that's where you and your 'gift' come in nicely."
    DIVINE @ talk "Ах, но именно здесь ты и твой 'дар' прекрасно подходят."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:87
translate ru primer_girl_troubles_2_menu_70c53a8b:

    # DIVINE @ talk "The Alderian government have refused to send me a mage capable of helping me, so I need the next best thing."
    DIVINE @ talk "Правительство Алдерея отказалось прислать мне мага способного мне помочь, поэтому мне нужна лучшая альтернатива."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:88
translate ru primer_girl_troubles_2_menu_560ed043:

    # DIVINE @ talk "Someone capable of really motivating these girls."
    DIVINE @ talk "Кто-то, кто действительно сможет мотивировать этих девушек."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:89
translate ru primer_girl_troubles_2_menu_0d85e87a:

    # MC "(Meaning someone she can threaten to blackmail if I ever speak about what I see in here.)"
    MC "(То есть кто-то, кого она сможет шантажировать, если я когда-нибудь расскажу о том, что увижу здесь.)"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:90
translate ru primer_girl_troubles_2_menu_59433de1:

    # MC @ talk "How am I supposed to do that?"
    MC @ talk "И как я должен это сделать?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:91
translate ru primer_girl_troubles_2_menu_de2af97e:

    # DIVINE @ talk "The method doesn't concern me; as long as the girls aren't harmed, I don't care what you do. "
    DIVINE @ talk "Методы меня не волнуют; пока девушкам не причинят вреда, мне всё равно, что ты делаешь."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:92
translate ru primer_girl_troubles_2_menu_7d5dfde8:

    # DIVINE @ talk "For each girl dealt with, I'll give you seven hundred coins. Does that sound fair?"
    DIVINE @ talk "За каждую исправленную девушку я дам тебе семь сотен монет. Справедливо?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:95
translate ru primer_girl_troubles_2_menu_2_270e239c:

    # DIVINE @ talk "Because I need someone I can trust with this,"
    DIVINE @ talk "Потому что мне нужен кто-то, кому я могу доверить это,"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:96
translate ru primer_girl_troubles_2_menu_2_bf1e2acc:

    # DIVINE @ talk "And after hearing from Captain Nyx about your recent help with her, it only made sense to ask you."
    DIVINE @ talk "И после того, как капитан Никс рассказала о твоей недавней помощи ей, было логично обратиться к тебе."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:97
translate ru primer_girl_troubles_2_menu_2_beee84fb:

    # MC @ talk "Wait ... Captain Nyx?"
    MC @ talk "Погоди... Капитан Никс?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:98
translate ru primer_girl_troubles_2_menu_2_2010828e:

    # DIVINE @ talk "The Captain and I are ... {i}often aligned{/i} when necessary."
    DIVINE @ talk "Капитан и я... {i}часто действуем сообща{/i}, когда это необходимо."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:99
translate ru primer_girl_troubles_2_menu_2_308a2582:

    # DIVINE @ talk "I'd hardly call us friends, but we've come to depend on each other's resources sometimes."
    DIVINE @ talk "Я бы не назвала нас друзьями, но иногда мы полагаемся на ресурсы друг друга."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:102
translate ru primer_girl_troubles_2_menu_2_c7d4f56a:

    # DIVINE @ talk "I mean, {i}I don't care what you do.{/i}"
    DIVINE @ talk "В прямом, {i}мне всё равно, что ты делаешь.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:103
translate ru primer_girl_troubles_2_menu_2_8cc9e6dd:

    # DIVINE @ talk "As long as they are not hurt, and you don't make a public spectacle of whatever you do with them, I only care about the end results."
    DIVINE @ talk "Пока им не причиняют вреда, и ты не устраиваешь публичное шоу из того что с ними делаешь, меня волнует только конечный результат."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:106
translate ru primer_girl_troubles_2_menu_2_960647d4:

    # DIVINE @ talk "I cannot tell you until you agree to my request, but I will do my best to answer anymore questions you have."
    DIVINE @ talk "Я не могу сказать тебе, пока ты не согласишься на мою просьбу, но я сделаю всё возможное, чтобы ответить на остальные твои вопросы."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:109
translate ru primer_girl_troubles_2_menu_3_7d9b1b5b:

    # MC @ talk "Mages of Palam are holy ordained, after all."
    MC @ talk "Маги Палама, посвящены в святые, в конце концов."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:110
translate ru primer_girl_troubles_2_menu_3_dfe1bc33:

    # DIVINE @ angry "It is shameful when you're praying for a strong male heir or a daughter that you can marry off to another rich noble."
    DIVINE @ angry "Это позор, когда ты молишься о сильном наследнике мужского пола или дочери, которую можно выдать замуж за другого богатого дворянина."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:111
translate ru primer_girl_troubles_2_menu_3_a6aa2eef:

    # DIVINE @ talk "Us Mages of Palam are seen as a dead end."
    DIVINE @ talk "Нас, Магов Палама, считают тупиковой ветвью."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:112
translate ru primer_girl_troubles_2_menu_3_5492d872:

    # MC @ talk "But can't Mages of Palam continue a bloodline?"
    MC @ talk "Но разве Маги Палама не могут продолжить род?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:113
translate ru primer_girl_troubles_2_menu_3_778e69e4:

    # MC @ talk "You can sire young with women and can get pregnant yourselves, can you not?"
    MC @ talk "Вы можете иметь детей с женщинами и сами можете забеременеть, разве нет?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:114
translate ru primer_girl_troubles_2_menu_3_df70b7f3:

    # MC @ think "How then are you a dead end?"
    MC @ think "Тогда почему вы тупиковая ветвь?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:115
translate ru primer_girl_troubles_2_menu_3_d60e62c4:

    # "Sister Divine smiled."
    "Сестра Дивайн улыбнулась."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:116
translate ru primer_girl_troubles_2_menu_3_b412a3ab:

    # DIVINE @ happy "It's best not to dwell on such things; we're an uncomfortable blot they've had to learn to accept and tolerate {i}on their terms.{/i}"
    DIVINE @ happy "Лучше не задумываться о таких вещах; мы — неудобное пятно, которое им пришлось научиться принимать и терпеть {i}на их условиях.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:117
translate ru primer_girl_troubles_2_menu_3_7a2d28cb:

    # DIVINE @ talk "They prefer the fantasy of us as saint like beings, not real people with real wants and desires."
    DIVINE @ talk "Они предпочитают фантазию о нас, как о святых существах, а не о реальных людях с реальными потребностями и желаниями."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:120
translate ru primer_girl_troubles_2_menu_3_6d652bd9:

    # DIVINE @ talk "Yes, to which I expect you to speak to no one."
    DIVINE @ talk "Да, и я ожидаю, что ты ни с кем об этом не заговоришь."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:121
translate ru primer_girl_troubles_2_menu_3_198ed38b:

    # DIVINE @ talk "I cannot stress how important these families expect privacy."
    DIVINE @ talk "Не могу не подчеркнуть, насколько эти семьи ценят конфиденциальность."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:122
translate ru primer_girl_troubles_2_menu_3_1cf3949f:

    # DIVINE @ talk "If they believe we're making a spectacle, those {i}generous donations{/i} will very quickly dry up."
    DIVINE @ talk "Если они решат, что мы устраиваем спектакль, эти {i}щедрые пожертвования{/i} очень быстро иссякнут."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:125
translate ru primer_girl_troubles_2_menu_3_186c3225:

    # DIVINE @ happy "Good, it pleases me to hear that."
    DIVINE @ happy "Хорошо, мне приятно это слышать."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:126
translate ru primer_girl_troubles_2_menu_3_c4dc71ec:

    # MC @ talk "So what now?"
    MC @ talk "И что теперь?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:127
translate ru primer_girl_troubles_2_menu_3_1f4f778f:

    # DIVINE @ talk "Now you've agreed, I can talk more about the girls in question."
    DIVINE @ talk "Теперь, когда ты согласился, я могу рассказать больше о девушках."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:128
translate ru primer_girl_troubles_2_menu_3_edbe2a65:

    # DIVINE @ talk "There's Jana, Zara and Mika."
    DIVINE @ talk "Это Джана, Зара и Мика."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:129
translate ru primer_girl_troubles_2_menu_3_a7336069:

    # DIVINE @ talk "Which one do you want to know about?"
    DIVINE @ talk "О ком ты хочешь узнать?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:133
translate ru primer_girl_troubles_2_menu_4_c8c3f0f1:

    # DIVINE @ talk "Ah, Jana Rosenval..."
    DIVINE @ talk "Ах, Джана Розенвал..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:134
translate ru primer_girl_troubles_2_menu_4_c2684d19:

    # DIVINE @ talk "Her abilities are extremely promising, and she is one of the highest potential candidates I've seen in years."
    DIVINE @ talk "Её способности чрезвычайно перспективны, и она один из кандидатов с наивысшим потенциалом, которых я видела за годы."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:135
translate ru primer_girl_troubles_2_menu_4_53984bd0:

    # MC @ talk "Then what's the issue?"
    MC @ talk "Тогда в чём проблема?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:136
translate ru primer_girl_troubles_2_menu_4_6461bc7c:

    # DIVINE @ angry "Her attitude."
    DIVINE @ angry "Её отношение."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:137
translate ru primer_girl_troubles_2_menu_4_0751d562:

    # DIVINE @ angry "She's been consistently troublesome for as long as I've known her, but the situation this last year has spiraled completely out of hand."
    DIVINE @ angry "Она постоянно доставляла неприятности всё время, что я её знаю, но за последний год ситуация полностью вышла из-под контроля."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:138
translate ru primer_girl_troubles_2_menu_4_587a4d08:

    # MC @ talk "How {i}'out of hand?'{/i}"
    MC @ talk "Как это {i}'вышло из-под контроля?'{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:139
translate ru primer_girl_troubles_2_menu_4_d7b30e0f:

    # DIVINE @ talk "Setting a lecture hall on fire, sneaking out and being caught dancing topless at a tavern, constantly getting it brawls with the other girls... The list goes on."
    DIVINE @ talk "Поджог лекционного зала, побег из школы и поимка за танцами топлес в таверне, постоянные драки с другими девушками... Список можно продолжать."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:140
translate ru primer_girl_troubles_2_menu_4_4890c460:

    # MC @ talk "Any idea what's causing the trouble?"
    MC @ talk "Есть идеи, что вызывает проблемы?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:141
translate ru primer_girl_troubles_2_menu_4_3d603c8c:

    # DIVINE @ talk "She does come from a particularly {i}'troubled'{/i} home, and it's always been a difficult subject for her to talk about."
    DIVINE @ talk "Она действительно из особенно {i}'неблагополучной'{/i} семьи, и эта тема всегда была для неё болезненной."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:142
translate ru primer_girl_troubles_2_menu_4_fe36ef6d:

    # MC @ talk "How troubled?"
    MC @ talk "Насколько неблагополучной?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:143
translate ru primer_girl_troubles_2_menu_4_08cdecc7:

    # DIVINE @ talk "There were signs of physical abuse, but she's never been willing to talk about it."
    DIVINE @ talk "Были признаки физического насилия, но она никогда не хотела об этом говорить."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:144
translate ru primer_girl_troubles_2_menu_4_d0271e56:

    # DIVINE @ talk "I need you to help curb her personality issues and deal with whatever's going on in her head."
    DIVINE @ talk "Мне нужно, чтобы ты помог обуздать её проблемы с характером, и разобраться с тем что творится у неё в голове."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:149
translate ru primer_girl_troubles_2_menu_4_5087813e:

    # DIVINE @ talk "Hm, yes, Zara Dawnmoore."
    DIVINE @ talk "Хм, да, Зара Рассветная."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:150
translate ru primer_girl_troubles_2_menu_4_15776ea7:

    # DIVINE @ talk "She comes from a wealthy aristocratic family from the south before the war forced them to flee North."
    DIVINE @ talk "Она из богатой аристократической семьи с юга, которая была вынуждена бежать на Север из-за войны."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:151
translate ru primer_girl_troubles_2_menu_4_f90c3862:

    # DIVINE @ talk "She was a perfect student during her time here, consistently scoring highest on her arcane knowledge and abilities."
    DIVINE @ talk "Она была идеальной ученицей во время своего пребывания здесь, постоянно получая высшие баллы по магическим знаниям и способностям."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:152
translate ru primer_girl_troubles_2_menu_4_8e5d193b:

    # DIVINE @ talk "Then, during the terminus ceremony, the {i}'incident'{/i} occurred."
    DIVINE @ talk "Затем, во время церемонии завершения, произошел {i}'инцидент'{/i}."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:153
translate ru primer_girl_troubles_2_menu_4_caee25ea:

    # MC @ think "The 'incident?'"
    MC @ think "'Инцидент?'"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:154
translate ru primer_girl_troubles_2_menu_4_7a8a5198:

    # DIVINE @ talk "Before the ceremony, Zara was reported to be in high spirits, if a little tense and on edge."
    DIVINE @ talk "Перед церемонией сообщалось, что Зара была в приподнятом настроении, хотя немного напряжена и на взводе."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:155
translate ru primer_girl_troubles_2_menu_4_601dc7e4:

    # DIVINE @ talk "But the same could be said of any of the mages at the time, so it was dismissed as the usual pre-ceremony anxiety."
    DIVINE @ talk "Но то же самое можно было сказать о любом из магов в то время, поэтому это списали на обычное предцеремониальное беспокойство."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:156
translate ru primer_girl_troubles_2_menu_4_7d354705:

    # DIVINE @ talk "A short while after the ceremony, however, Zara received a letter from her parents, who couldn't attend."
    DIVINE @ talk "Однако вскоре после церемонии Зара получила письмо от своих родителей, которые не смогли присутствовать."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:157
translate ru primer_girl_troubles_2_menu_4_305b4b7a:

    # DIVINE @ talk "She burned the letter before anyone could read it, but whatever was in that letter triggered something within her."
    DIVINE @ talk "Она сожгла письмо, прежде чем кто-либо успел его прочитать, но что бы в том письме ни было, это что-то спровоцировало в ней."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:158
translate ru primer_girl_troubles_2_menu_4_11d29735:

    # DIVINE @ talk "In the night, she went on a rampage, attacking everyone in sight."
    DIVINE @ talk "Ночью она устроила бойню, нападая на всех, кто попадался на глаза."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:159
translate ru primer_girl_troubles_2_menu_4_91d2d69a:

    # DIVINE @ talk "It took myself and two other high mages to restrain her abilities, and in the meanwhile, over a dozen students were hurt."
    DIVINE @ talk "Понадобились я и еще двое верховных магов, чтобы сдержать её способности, и за это время пострадало более десятка учеников."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:160
translate ru primer_girl_troubles_2_menu_4_a4d6ed27:

    # DIVINE @ talk "We thought it might have been {i}'Mages madness,'{/i} but there was no sign of it."
    DIVINE @ talk "Мы думали, что это могло быть {i}'Магическое безумие,'{/i} но признаков его не было."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:161
translate ru primer_girl_troubles_2_menu_4_cffae37d:

    # MC @ talk "What was in the letter?"
    MC @ talk "Что было в том письме?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:162
translate ru primer_girl_troubles_2_menu_4_af9b8334:

    # DIVINE @ talk "We don't know, and Zara won't say."
    DIVINE @ talk "Мы не знаем, и Зара ничего не говорит."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:163
translate ru primer_girl_troubles_2_menu_4_b98ef904:

    # DIVINE @ talk "Now Zara is pretending she had some momentary lapse of judgment and is acting her usual self again."
    DIVINE @ talk "Теперь Зара притворяется, что у неё был какой-то временный провал в суждениях, и снова ведёт себя как обычно."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:164
translate ru primer_girl_troubles_2_menu_4_42755e18:

    # DIVINE @ talk "I'm not going to risk sending her out knowing she could explode at any moment."
    DIVINE @ talk "Я не собираюсь рисковать, отправляя её, зная что она может взорваться в любой момент."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:165
translate ru primer_girl_troubles_2_menu_4_3b071047:

    # MC @ talk "I don't remember hearing about this incident anywhere?"
    MC @ talk "Не помню, чтобы слышал об этом инциденте где-либо?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:166
translate ru primer_girl_troubles_2_menu_4_9d1d538f:

    # DIVINE @ talk "That's because we've buried it and managed the incident in-house ... For now, at least."
    DIVINE @ talk "Это потому что мы его похоронили и разобрались с инцидентом внутри дома... Пока что, по крайней мере."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:167
translate ru primer_girl_troubles_2_menu_4_c4225b75:

    # DIVINE @ talk "I need you to get to the bottom of this issue and deal with it ... fast."
    DIVINE @ talk "Мне нужно, чтобы ты докопался до сути этой проблемы и разобрался с ней... быстро."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:172
translate ru primer_girl_troubles_2_menu_4_1469252a:

    # DIVINE @ talk "Yes, Mika Ursan, a lovely girl."
    DIVINE @ talk "Да, Мика Урсан, милая девушка."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:173
translate ru primer_girl_troubles_2_menu_4_a993509d:

    # DIVINE @ talk "Afraid of her own shadow, but lovely."
    DIVINE @ talk "Боится собственной тени, но милая."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:174
translate ru primer_girl_troubles_2_menu_4_6e2f9ef2:

    # MC @ talk "{i}Afraid of her own shadow?{/i}"
    MC @ talk "{i}Боится собственной тени?{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:175
translate ru primer_girl_troubles_2_menu_4_dd45cd20:

    # DIVINE @ laugh "I know, I know, but believe me—she panics at the sight of a sparring partner."
    DIVINE @ laugh "Знаю, знаю, но поверь мне — она паникует при виде спарринг-партнёра."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:176
translate ru primer_girl_troubles_2_menu_4_c2e8c608:

    # DIVINE @ talk "Mika's an odd case; her family adore her and refused to hand her over till much, {i}much{/i} later than we usually take on mages."
    DIVINE @ talk "Мика — особый случай; её семья обожает её и отказалась отдавать её нам до гораздо, {i}гораздо{/i} более позднего возраста, чем мы обычно принимаем магов."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:177
translate ru primer_girl_troubles_2_menu_4_cf3cdd5f:

    # DIVINE @ talk "As such, she has a strong natural sense of her abilities despite displaying very average arcane knowledge."
    DIVINE @ talk "Поэтому у неё сильное естественное чувство своих способностей, несмотря на весьма посредственные знания в области магии."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:178
translate ru primer_girl_troubles_2_menu_4_11d4c714:

    # MC @ talk "So, what's the issue?"
    MC @ talk "Так в чём же проблема?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:179
translate ru primer_girl_troubles_2_menu_4_138e55c7:

    # DIVINE @ talk "{i}The girl is terrified of fighting...{/i}"
    DIVINE @ talk "{i}Девушка ужасно боится сражений...{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:180
translate ru primer_girl_troubles_2_menu_4_154fbaad:

    # DIVINE @ talk "She completely failed in any and all practical combat training classes previously."
    DIVINE @ talk "Она полностью провалила все практические занятия по боевой подготовке ранее."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:181
translate ru primer_girl_troubles_2_menu_4_bd85b2d5:

    # DIVINE @ talk "She just ... cowered."
    DIVINE @ talk "Она просто... сжималась в комок."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:182
translate ru primer_girl_troubles_2_menu_4_9c43d061:

    # MC @ talk "Then how has she got this far?"
    MC @ talk "Тогда как она дошла до этого этапа?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:183
translate ru primer_girl_troubles_2_menu_4_5bcd82c2:

    # DIVINE @ talk "Because practical combat for mages of the Palam is the one thing you {i}can{/i} still fail at and still be allowed to serve in the rear as a healer."
    DIVINE @ talk "Потому что практический бой для магов Палама — это единственное, в чём ты {i}можешь{/i} провалиться и всё ещё быть допущенным служить в тылу целителем."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:184
translate ru primer_girl_troubles_2_menu_4_6272c3d1:

    # DIVINE @ angry "Suffice it to say this push to get mages to the front in quantity rather than quality has been a great source of tension between the council of Mages and the Alderian government."
    DIVINE @ angry "Достаточно сказать, что это стремление отправить магов на фронт в количестве, а не качестве, стало большим источником напряжённости между советом магов и правительством Алдерея."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:185
translate ru primer_girl_troubles_2_menu_4_86ac58e5:

    # DIVINE @ talk "Now, whilst combat isn't the priority for a mage of Palam, {i}I firmly believe every mage must be able to defend herself in times of crisis.{/i}"
    DIVINE @ talk "Теперь, хотя бой и не является приоритетом для мага Палама, {i}я твёрдо верю, что каждый маг должен уметь защитить себя в критические моменты.{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:186
translate ru primer_girl_troubles_2_menu_4_99e3957b:

    # "Sister Divine's face fell darkly."
    "Лицо Сестры Дивайн потемнело."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:187
translate ru primer_girl_troubles_2_menu_4_a90549ec:

    # DIVINE @ sad "If the recent deaths are anything to go by ... I've only been proven right."
    DIVINE @ sad "Если судить по недавним смертям... меня только подтвердили в правоте."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:188
translate ru primer_girl_troubles_2_menu_4_8ab36be3:

    # MC @ think "So, you want me to train the girl to fight?"
    MC @ think "Итак, ты хочешь, чтобы я обучил девушку сражаться?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:189
translate ru primer_girl_troubles_2_menu_4_bd65f2f7:

    # DIVINE @ talk "I need you to teach her to conquer her fears."
    DIVINE @ talk "Мне нужно, чтобы ты научил её побеждать свои страхи."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:190
translate ru primer_girl_troubles_2_menu_4_d6ca7303:

    # DIVINE @ talk "She {i}has{/i} to be able to fight if the time comes."
    DIVINE @ talk "Она {i}должна{/i} уметь сражаться, если придёт время."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:191
translate ru primer_girl_troubles_2_menu_4_3a9c4c09:

    # MC @ talk "And if she refuses to listen? She's an adult now; she doesn't have to listen to either of us."
    MC @ talk "А если она откажется слушать? Она теперь взрослая; она не обязана слушать ни тебя, ни меня."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:192
translate ru primer_girl_troubles_2_menu_4_88df11d8:

    # DIVINE @ talk "I don't care {i}how{/i} you get her to agree, but I need to know she can handle herself out there."
    DIVINE @ talk "Мне всё равно, {i}как{/i} ты добьёшься её согласия, но я должна знать, что она сможет постоять за себя там, снаружи."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:199
translate ru primer_girl_troubles_2_menu_4_89c9874e:

    # DIVINE @ talk "Now then, should I introduce you to the girls?"
    DIVINE @ talk "Что ж, представить тебя девушкам?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:202
translate ru primer_girl_troubles_2_menu_5_ecf2e41a:

    # DIVINE @ talk "Alright, which one?"
    DIVINE @ talk "Хорошо, какую из них?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:208
translate ru primer_girl_troubles_2_menu_5_190030f6:

    # DIVINE @ talk "Alright, come with me, I shall introduce you."
    DIVINE @ talk "Хорошо, пойдём со мной, я тебя представлю."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:211
translate ru primer_girl_troubles_2_menu_5_29b7d599:

    # DIVINE @ talk "Return as soon as you can ... I want this trouble behind me sooner rather than later."
    DIVINE @ talk "Возвращайся как можно скорее... Я хочу покончить с этой проблемой как можно раньше."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:217
translate ru primer_girl_troubles_2_menu_5_1c582cf8:

    # DIVINE @ talk "Of course, but please, give me your answer soon ... Time is a luxury we don't have."
    DIVINE @ talk "Конечно, но пожалуйста, дай мне ответ в ближайшее время... Время — это роскошь, которую мы не можем себе позволить."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:235
translate ru primer_girl_troubles_2_menu_5_aa4cc931:

    # "A short journey later to the girl's dorm..."
    "Короткое путешествие спустя к женскому общежитию..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:236
translate ru primer_girl_troubles_2_menu_5_edf5f908:

    # "Upon entering the girls' dorm, the immediate warmth of the room hit me from the warm blazing fire."
    "При входе в женское общежитие меня сразу же окутало тепло от горящего камина."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:237
translate ru primer_girl_troubles_2_menu_5_81e60903:

    # "We all knew mages had it easy compared to the rest of us, even young apprentices, but this was leaps and bounds ahead of my experiences."
    "Мы все знали, что магам живётся легче, чем остальным, даже юным ученикам, но это было на голову выше моего опыта."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:238
translate ru primer_girl_troubles_2_menu_5_7883e851:

    # DIVINE @ happy "Girls! Come!"
    DIVINE @ happy "Девочки! Идите сюда!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:242
translate ru primer_girl_troubles_2_menu_5_40b40c14:

    # "Sister Divine clapped her hands, and two girls approached, one, the blonde, still yawning after she rolled herself off the side of her bed before dragging herself towards us."
    "Сестра Дивайн хлопнула в ладоши, и две девушки подошли: одна, блондинка, всё ещё зевала, после того как скатилась с кровати и поплелась к нам."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:243
translate ru primer_girl_troubles_2_menu_5_7a248ec2:

    # "When the two girls saw me, the dark-haired one remained stoically unmoved, but the blonde blushed and smiled."
    "Когда две девушки увидели меня, темноволосая осталась стоически невозмутимой, а блондинка покраснела и улыбнулась."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:244
translate ru primer_girl_troubles_2_menu_5_ce372275:

    # MIKA @ blush "Ooooh! H-Hello!"
    MIKA @ blush "Оооох! П-Привет!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:245
translate ru primer_girl_troubles_2_menu_5_ef151daf:

    # DIVINE @ think "Mika."
    DIVINE @ think "Мика."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:246
translate ru primer_girl_troubles_2_menu_5_bc47b5bb:

    # MIKA @ shock "W-What I do this time?"
    MIKA @ shock "Ч-Что я такого сделала?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:247
translate ru primer_girl_troubles_2_menu_5_25c61541:

    # "The second, much more serious girl adjusted her glasses before speaking."
    "Вторая, гораздо более серьёзная девушка поправила очки, прежде чем заговорить."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:248
translate ru primer_girl_troubles_2_menu_5_850b8b33:

    # ZARA @ talk "Try to control yourself, Mika."
    ZARA @ talk "Постарайся контролировать себя, Мика."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:249
translate ru primer_girl_troubles_2_menu_5_22480155:

    # MIKA @ angry "I - I was just saying hello!"
    MIKA @ angry "Я - Я просто поздоровалась!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:250
translate ru primer_girl_troubles_2_menu_5_f57b3817:

    # MIKA @ sad "W-We never get any men visiting us hardly!"
    MIKA @ sad "У нас почти никогда не бывает мужчин в гостях!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:251
translate ru primer_girl_troubles_2_menu_5_8cd305e9:

    # MIKA @ blush "Especially not m-men so..."
    MIKA @ blush "Особенно таких м-мужчин..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:252
translate ru primer_girl_troubles_2_menu_5_3c5d1011:

    # "A shy, blushing Mika averted her gaze and giggled lightly."
    "Застенчивая, покрасневшая Мика отвела взгляд и тихонько хихикнула."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:253
translate ru primer_girl_troubles_2_menu_5_eb7cf5c5:

    # MIKA @ blush "Y-You look like you could plow a whole field with just one hand..."
    MIKA @ blush "Т-Ты выглядишь так, будто можешь вспахать целое поле одной рукой..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:257
translate ru primer_girl_troubles_2_menu_5_d68b4ad3:

    # "The other girl, Zara, lightly slapped Mika over the back of the head."
    "Другая девушка, Зара, слегка шлёпнула Мику по затылку."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:258
translate ru primer_girl_troubles_2_menu_5_19af103e:

    # MIKA @ angry "O-Ow!"
    MIKA @ angry "А-ай!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:259
translate ru primer_girl_troubles_2_menu_5_d10b1262:

    # ZARA @ talk "We both know the only {i}field{/i} you want to have plowed isn't on any farm."
    ZARA @ talk "Мы оба знаем, что единственное {i}поле{/i}, которое ты хочешь вспахать, не находится ни на одной ферме."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:260
translate ru primer_girl_troubles_2_menu_5_42becbac:

    # MIKA @ angry "Grrrr!"
    MIKA @ angry "Грррр!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:261
translate ru primer_girl_troubles_2_menu_5_3191578c:

    # DIVINE @ angry "Oh, for the love of-"
    DIVINE @ angry "Ох, ради всего святого-"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:262
translate ru primer_girl_troubles_2_menu_5_420b2e66:

    # DIVINE @ talk "Right, as I'm sure you've guessed, this is Mika and Zara."
    DIVINE @ talk "Итак, как ты наверное уже догадался, это Мика и Зара."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:263
translate ru primer_girl_troubles_2_menu_5_1438940e:

    # MIKA @ smile "N-Nice to meet you!"
    MIKA @ smile "П-Приятно познакомиться!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:264
translate ru primer_girl_troubles_2_menu_5_a52308f1:

    # ZARA @ talk "A pleasure, I'm sure."
    ZARA @ talk "Очень приятно, уверена."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:266
translate ru primer_girl_troubles_2_menu_5_8ae8cbb1:

    # DIVINE @ talk "This is [player_name!t]; he will be acting as my assistant for a while, so do treat him with the same respect as you would me."
    DIVINE @ talk "Это [player_name!t]; он будет работать моим помощником какое-то время, так что относитесь к нему с таким же уважением, как ко мне."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:266
translate ru primer_girl_troubles_2_menu_5_417c9081:

    # "The two girls seemed bewildered, though Mika let it show far more."
    "Девушки казались ошеломлёнными, хотя Мика проявляла это гораздо явнее."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:267
translate ru primer_girl_troubles_2_menu_5_1a6f6c22:

    # MIKA @ shock "H-HUH?!"
    MIKA @ shock "Ч-ЧТО?!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:268
translate ru primer_girl_troubles_2_menu_5_7543fc2a:

    # MIKA @ shock "You m-mean ... A MAN'S ACTUALLY GOING TO BE WORKING HERE?!"
    MIKA @ shock "Т-ты имеешь в виду... МУЖЧИНА БУДЕТ ЗДЕСЬ РАБОТАТЬ?!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:269
translate ru primer_girl_troubles_2_menu_5_f897d4fa:

    # ZARA @ shock "Is this person even qualified? I don't sense any magecraft coming from the person."
    ZARA @ shock "Этот человек вообще квалифицирован? Я не чувствую никакого магического искусства от него."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:270
translate ru primer_girl_troubles_2_menu_5_c8f907fe:

    # DIVINE @ talk "I assure you, Zara, there are no rules {i}requiring{/i} people to have magecraft to work within the tower, nor are men technically barred."
    DIVINE @ talk "Уверяю тебя, Зара, нет правил {i}требующих{/i}, чтобы люди обладали магическим искусством для работы в башне, да и мужчины технически не запрещены."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:271
translate ru primer_girl_troubles_2_menu_5_9723359e:

    # ZARA @ talk "Hmph ... Very well."
    ZARA @ talk "Хмф... Ну ладно."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:272
translate ru primer_girl_troubles_2_menu_5_fbeffd6d:

    # MIKA @ angry "Hey! We want {i}more{/i} men around here! Not less!"
    MIKA @ angry "Эй! Мы хотим {i}больше{/i} мужчин здесь! А не меньше!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:273
translate ru primer_girl_troubles_2_menu_5_06cffc58:

    # ZARA @ talk "All you think about is farming and flirting with boys!"
    ZARA @ talk "Ты думаешь только о фермерстве и флирте с мальчиками!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:274
translate ru primer_girl_troubles_2_menu_5_be482aca:

    # MIKA @ talk "T-That's not true! I think about - {i}*Yawn*{/i}"
    MIKA @ talk "Э-Это неправда! Я думаю о - {i}*Зевает*{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:275
translate ru primer_girl_troubles_2_menu_5_7d9c27ba:

    # DIVINE @ talk "Mika, were you sleeping again?"
    DIVINE @ talk "Мика, ты опять спала?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:276
translate ru primer_girl_troubles_2_menu_5_27f81d7f:

    # MIKA @ sad "N-No...?"
    MIKA @ sad "Н-Нет...?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:277
translate ru primer_girl_troubles_2_menu_5_2af4c1d3:

    # DIVINE @ angry "How convincing..."
    DIVINE @ angry "Как убедительно..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:278
translate ru primer_girl_troubles_2_menu_5_f626b5af:

    # ZARA @ talk "Mika tried to sneak out again under Jana's guidance."
    ZARA @ talk "Мика снова пыталась улизнуть под руководством Джаны."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:279
translate ru primer_girl_troubles_2_menu_5_aecba179:

    # MIKA @ angry "N-No I didn't!"
    MIKA @ angry "Н-Нет, это не так!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:280
translate ru primer_girl_troubles_2_menu_5_801875ef:

    # DIVINE @ angry "MIKA!"
    DIVINE @ angry "МИКА!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:281
translate ru primer_girl_troubles_2_menu_5_be26913c:

    # MIKA @ shock "It ... It wasn't my fault!"
    MIKA @ shock "Это... Это была не моя вина!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:282
translate ru primer_girl_troubles_2_menu_5_3d17de9e:

    # MIKA @ shock "Jana said-"
    MIKA @ shock "Джана сказала-"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:283
translate ru primer_girl_troubles_2_menu_5_4ca2584c:

    # DIVINE @ angry "Jana says a lot of things! You know better!"
    DIVINE @ angry "Джана много чего говорит! Ты должна знать лучше!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:284
translate ru primer_girl_troubles_2_menu_5_8ac99721:

    # "Sister Divine looked around the room."
    "Сестра Дивайн оглядела комнату."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:285
translate ru primer_girl_troubles_2_menu_5_6f90d041:

    # DIVINE @ shock "...Wait, where is Jana?"
    DIVINE @ shock "...Погодите-ка, а где Джана?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:286
translate ru primer_girl_troubles_2_menu_5_d1685f04:

    # "The two girls stared at each other, uncertain how to answer, then back towards Sister Divine."
    "Две девочки уставились друг на друга, не зная как ответить, затем снова на Сестру Дивайн."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:287
translate ru primer_girl_troubles_2_menu_5_707de91d:

    # MIKA @ talk "Uhhh..."
    MIKA @ talk "Эээ..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:288
translate ru primer_girl_troubles_2_menu_5_f0f959f7:

    # DIVINE @ angry "Mika."
    DIVINE @ angry "Мика."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:289
translate ru primer_girl_troubles_2_menu_5_8dd093ea:

    # DIVINE @ angry "Where is she?"
    DIVINE @ angry "Где она?"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:290
translate ru primer_girl_troubles_2_menu_5_b95f8c38:

    # MIKA @ talk "W-Well, funny story..."
    MIKA @ talk "Н-Ну, забавная история..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:291
translate ru primer_girl_troubles_2_menu_5_9d751dd8:

    # MIKA @ smile "J-Jana, you see, s-said to go back to the tower without her..."
    MIKA @ smile "Д-Джана, понимаешь, с-сказала вернуться в башню без неё..."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:292
translate ru primer_girl_troubles_2_menu_5_676a7648:

    # DIVINE @ shock "WHAT?!"
    DIVINE @ shock "ЧТО?!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:293
translate ru primer_girl_troubles_2_menu_5_bbe22db0:

    # MIKA @ shock "I t-tried to talk her into coming back, but she wouldn't listen!"
    MIKA @ shock "Я п-пыталась уговорить её вернуться, но она не слушала!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:294
translate ru primer_girl_troubles_2_menu_5_081ea1de:

    # DIVINE @ angry "Grghh! That girl is-"
    DIVINE @ angry "Гррхх! Эта девчонка просто—"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:295
translate ru primer_girl_troubles_2_menu_5_120cd555:

    # DIVINE @ talk "{i}*Deep breath*{/i}"
    DIVINE @ talk "{i}*Глубокий вдох*{/i}"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:297
translate ru primer_girl_troubles_2_menu_5_969c5023:

    # DIVINE @ talk "I'm going to find Jana. The two of you are to follow under [player_name!t]'s direction while I'm gone."
    DIVINE @ talk "Я пойду искать Джану. А пока меня нет, вы двое будете следовать указаниям [player_name!t]."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:297
translate ru primer_girl_troubles_2_menu_5_b39cc149:

    # ZARA @ angry "I don't need to be watched over by someone like a child; in fact, the reasoning behind me being held back at all is ludicrous."
    ZARA @ angry "Мне не нужно, чтобы за мной присматривали как за ребёнком; более того, сама причина по которой меня задерживают нелепа."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:298
translate ru primer_girl_troubles_2_menu_5_06e4de92:

    # MIKA @ angry "Yeah! Me too! I p-passed everything just fine!"
    MIKA @ angry "Да! Я тоже! Я в-всё сдала без проблем!"

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:299
translate ru primer_girl_troubles_2_menu_5_eabd1e52:

    # DIVINE @ angry "Neither of you are moving on till I'm satisfied."
    DIVINE @ angry "Никто из вас не двинется дальше, пока я не буду удовлетворена."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:300
translate ru primer_girl_troubles_2_menu_5_708b05a9:

    # DIVINE @ angry "Now excuse me, I have places to be."
    DIVINE @ angry "А теперь извините, у меня есть дела."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:301
translate ru primer_girl_troubles_2_menu_5_57b8ffbe:

    # "Sister Divine looked knowingly towards me."
    "Сестра Дивайн многозначительно посмотрела на меня."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:302
translate ru primer_girl_troubles_2_menu_5_13f86484:

    # DIVINE @ happy "Let me know if they try anything funny."
    DIVINE @ happy "Дай мне знать, если они вытворят что-то не то."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:303
translate ru primer_girl_troubles_2_menu_5_ba0262a7:

    # DIVINE @ angry "I have more than one way of punishing disobedient brats."
    DIVINE @ angry "У меня есть больше одного способа наказывать непослушных сорванцов."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:304
translate ru primer_girl_troubles_2_menu_5_a7a2cb5e:

    # MIKA @ shock "I ain't a rat!"
    MIKA @ shock "Я не рванец!"

