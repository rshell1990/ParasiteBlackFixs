    DIVINE "Так что... как насчёт этого?"

# game/data/world_quests/side/novaras/HighFashion/frog_sewer.rpy:133
translate ru palam_sewer_058d9062:

    # DIVINE "We could learn so much from each other..."
    DIVINE "Мы могли бы многому научиться друг у друга..."

