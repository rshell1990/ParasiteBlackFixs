    BABAZHUL_MAD @ talk "Всё это золото, какая прелесть!"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_ClueBaba.rpy:32
translate ru scr_SharedInThorns_babazhulClue_e4dc13d4:

