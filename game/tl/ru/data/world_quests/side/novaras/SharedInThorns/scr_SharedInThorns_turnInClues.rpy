    ELENA @ talk "{i}Я даже не знала, что она навещала Рамон до сих пор...{/i}"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:32
translate ru scr_SharedInThorns_turnInClues_menu_854e3f0c:

    # MC @ talk "Could she still be there now?"
    MC @ talk "Могла ли она всё ещё быть там?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:33
translate ru scr_SharedInThorns_turnInClues_menu_62735895:

    # ELENA @ grumpy "It's possible..."
    ELENA @ grumpy "Возможно..."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:34
translate ru scr_SharedInThorns_turnInClues_menu_012585ee:

    # MC @ talk "Surely the lady Grace must have told you something?"
    MC @ talk "Наверняка Леди Грейс что-то тебе рассказала?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:35
translate ru scr_SharedInThorns_turnInClues_menu_17f6ff97:

    # ELENA @ sad "We spoke of many things, but... She told me her work overseas was 'family business' and would elaborate no further."
    ELENA @ sad "Мы говорили о многом, но... Она сказала, что её работа за границей — это 'семейное дело', и не стала вдаваться в подробности."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:36
translate ru scr_SharedInThorns_turnInClues_menu_53eee9e8:

