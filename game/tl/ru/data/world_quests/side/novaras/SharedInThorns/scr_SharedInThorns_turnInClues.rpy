    MC @ talk "Ну, ты лично знала покойного Лорда Вронта."

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:12
translate ru scr_SharedInThorns_turnInClues_menu_1e5423b5:

