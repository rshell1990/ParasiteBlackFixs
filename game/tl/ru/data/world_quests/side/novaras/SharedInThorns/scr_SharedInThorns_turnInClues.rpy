    MC @ talk "Как при колдовстве, или демоническую?"

# game/data/world_quests/side/novaras/SharedInThorns/scr_SharedInThorns_turnInClues.rpy:11
translate ru scr_SharedInThorns_turnInClues_menu_ae1b86f1:

