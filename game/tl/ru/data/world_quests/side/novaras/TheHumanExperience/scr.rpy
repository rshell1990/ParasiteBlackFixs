translate ru qst_HumanExp_11_returnFlowers_menu_6750e14d:

    # REGINA @ smile "...Not very homely, is it?"
    REGINA @ smile "...Не очень уютно, правда?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:839
translate ru qst_HumanExp_11_returnFlowers_menu_e1e58f16:

    # MC @ talk "It's the best I could do on short notice."
    MC @ talk "Это лучшее, что я смог найти в короткие сроки."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:840
translate ru qst_HumanExp_11_returnFlowers_menu_0c652db2:

    # REGINA @ talk "It'll serve it's purpose."
    REGINA @ talk "Оно послужит своей цели."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:841
translate ru qst_HumanExp_11_returnFlowers_menu_911b8b2a:

    # "[regina_ref_cap!t] smiled as she turned to face Myu."
    "[regina_ref_cap!t] улыбнулась, повернувшись к Мью."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:842
translate ru qst_HumanExp_11_returnFlowers_menu_f137887c:

    # REGINA @ smile "Anyway, it was nice to meet you Myu!"
    REGINA @ smile "В любом случае, было приятно познакомиться, Мью!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:843
translate ru qst_HumanExp_11_returnFlowers_menu_26d2afaf:

    # MYU @ joy "Thank you for food!"
    MYU @ joy "Спасибо за еду!"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:844
translate ru qst_HumanExp_11_returnFlowers_menu_7284c4cb:

    # REGINA @ smile "You're very welcome."
    REGINA @ smile "Всегда пожалуйста."

