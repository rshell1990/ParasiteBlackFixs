translate ru qst_HumanExp_11_returnFlowers_83dd4c14:

    # REGINA @ talk "Is there any real difference in nobility between you killing people and her eating them?"
    REGINA @ talk "Есть ли реальная разница в благородстве между тем, как ты убиваешь людей, и тем, как она их поедает?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:788
translate ru qst_HumanExp_11_returnFlowers_71c402fc:

    # REGINA @ talk "The end result is the same."
    REGINA @ talk "Конечный результат одинаков."

