    REGINA @ talk "Как я уже сказала, я выросла рядом с ними, можем ли мы теперь сменить тему, пожалуйста?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:807
translate ru qst_HumanExp_11_returnFlowers_menu_21ce3cf3:

