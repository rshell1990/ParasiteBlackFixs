    # MC @ talk "So, what should I do when that happens?"
    MC @ talk "Так, что же мне делать, когда это происходит?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:776
translate ru qst_HumanExp_11_returnFlowers_17ababba:

    # REGINA @ talk "Find her a human to eat."
    REGINA @ talk "Найди ей человека, чтобы съесть."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:777
translate ru qst_HumanExp_11_returnFlowers_87334860:

