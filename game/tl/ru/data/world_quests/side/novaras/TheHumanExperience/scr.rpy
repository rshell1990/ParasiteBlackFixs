# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:770
translate ru qst_HumanExp_11_returnFlowers_40f0cc8e:

    # MC @ surprised "[regina_ref_cap!t]!"
    MC @ surprised "[regina_ref_cap!t]!"

