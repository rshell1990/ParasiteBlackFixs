translate ru qst_NewMyu_4_findMyuChurch_menu_2634160e:

    # MC @ serious "But you're not defined by what you are, but {i}who{/i} you are."
    MC @ serious "Но ты определяешься не тем, что ты есть, а тем, {i}кто{/i} ты есть."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:247
translate ru qst_NewMyu_4_findMyuChurch_menu_43cccb6a:

    # MYU @ sad "...Is [player_name!t] scared of Myu?"
    MYU @ sad "...[player_name!t] боится Мью?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:249
translate ru qst_NewMyu_4_findMyuChurch_menu_667c4a7d:

    # MC @ talk "...No, Myu."
    MC @ talk "...Нет, Мью."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:250
translate ru qst_NewMyu_4_findMyuChurch_menu_5feaf410:

    # MYU @ sad "W-Why?"
    MYU @ sad "П-Почему?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:251
translate ru qst_NewMyu_4_findMyuChurch_menu_44cf84ff:

    # MYU @ sad "{i}You said Myu was a monster.{/i}"
    MYU @ sad "{i}Ты сказал, что Мью — монстр.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:252
translate ru qst_NewMyu_4_findMyuChurch_menu_b62129ee:

    # MYU @ sad "Monsters are bad, monsters are the worst..."
    MYU @ sad "Монстры — это плохо, монстры — худшие..."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:253
translate ru qst_NewMyu_4_findMyuChurch_menu_916c466a:

    # MC @ talk "You're not a monster Myu... You're just a scared girl trying to understand a scary world."
    MC @ talk "Ты не монстр, Мью... Ты просто испуганная девочка, пытающаяся понять этот страшный мир."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:254
translate ru qst_NewMyu_4_findMyuChurch_menu_0ea19dfc:

    # MC @ talk "I'm sorry I made you feel the way you did, and truth is, you {i}did{/i} scare me a little."
    MC @ talk "Прости, что заставил тебя так чувствовать, и правда в том, что ты {i}немного{/i} напугала меня."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:255
translate ru qst_NewMyu_4_findMyuChurch_menu_d5d364dc:

    # "Myu's eyes dropped to the floor dejectedly."
    "Глаза Мью упали на пол в унынии."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:256
translate ru qst_NewMyu_4_findMyuChurch_menu_8b40679b:

    # MC @ talk "But... That's okay."
    MC @ talk "Но... Это нормально."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:257
translate ru qst_NewMyu_4_findMyuChurch_menu_01cd8043:

    # MC @ smile "{i}Because I guess I'm kinda scary too sometimes.{/i}"
    MC @ smile "{i}Потому что, наверное, я тоже иногда бываю немного страшным.{/i}"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:258
translate ru qst_NewMyu_4_findMyuChurch_menu_3443b8a7:

    # MC @ smile "And just because you're a little different, it doesn't make you a monster."
    MC @ smile "И то, что ты немного отличаешься, не делает тебя монстром."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:259
translate ru qst_NewMyu_4_findMyuChurch_menu_bb741f1e:

    # MYU "..."
    MYU "..."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:264
translate ru qst_NewMyu_4_findMyuChurch_menu_51e28bb2:

    # "Myu leapt forward to hug me."
    "Мью прыгнула вперёд, чтобы обнять меня."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:265
translate ru qst_NewMyu_4_findMyuChurch_menu_6dca0e04:

    # MC "Whoa, easy now!"
    MC "Воу, полегче!"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:266
translate ru qst_NewMyu_4_findMyuChurch_menu_587718cb:

    # MYU "{i}*Sniff*{/i} Myu is ready to go home now."
    MYU "{i}*Шмыг*{/i} Мью готова идти домой."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:267
translate ru qst_NewMyu_4_findMyuChurch_menu_75df1b81:

    # MC "Come then, Myu, let's get you home."
    MC "Ну тогда пойдём, Мью, отведём тебя домой."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:269
translate ru qst_NewMyu_4_findMyuChurch_menu_397c7208:

    # KYLISA @ talk "I take it all is resolved?"
    KYLISA @ talk "Я так понимаю, всё улажено?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:274
translate ru qst_NewMyu_4_findMyuChurch_menu_d07dee5f:

    # MC @ smile "I think so."
    MC @ smile "Думаю, да."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:275
translate ru qst_NewMyu_4_findMyuChurch_menu_1918d395:

    # KYLISA @ smile "Good."
    KYLISA @ smile "Хорошо."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:276
translate ru qst_NewMyu_4_findMyuChurch_menu_1ae85692:

    # MC @ talk "Thank you for helping her."
    MC @ talk "Спасибо, что помогли ей."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:277
translate ru qst_NewMyu_4_findMyuChurch_menu_5c7b44a3:

    # MC @ talk "I know many wouldn't."
    MC @ talk "Я знаю, многие бы не стали."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:278
translate ru qst_NewMyu_4_findMyuChurch_menu_15eff0cd:

    # KYLISA @ talk "I am sure one day in the future, you may return this act of kindness."
    KYLISA @ talk "Уверена, однажды в будущем вы сможете вернуть этот акт доброты."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:279
translate ru qst_NewMyu_4_findMyuChurch_menu_1fd3c380:

    # KYLISA @ talk "...Tell me something though."
    KYLISA @ talk "...Но скажите мне кое-что."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:280
translate ru qst_NewMyu_4_findMyuChurch_menu_d669e126:

    # KYLISA @ talk "Why are {i}you{/i} helping this slimelark?"
    KYLISA @ talk "Почему {i}вы{/i} помогаете этому слаймларку?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:283
translate ru qst_NewMyu_4_findMyuChurch_menu_6824b63e:

    # KYLISA @ talk "...Very well, as good an answer as any I suppose."
    KYLISA @ talk "...Что ж, ответ не хуже любого другого, полагаю."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:285
translate ru qst_NewMyu_4_findMyuChurch_menu_54991cbc:

    # KYLISA @ talk "...I see."
    KYLISA @ talk "...Понятно."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:286
translate ru qst_NewMyu_4_findMyuChurch_menu_f9a7a2d5:

    # KYLISA @ talk "Well I hope you and your companion chose wisely in this war and the wars to come."
    KYLISA @ talk "Что ж, надеюсь вы, и ваш спутник, сделали мудрый выбор в этой войне и в войнах грядущих."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:288
translate ru qst_NewMyu_4_findMyuChurch_menu_f0530664:

    # "...The phrase jumped out of me in a tone so... {i}alien{/i}."
    "...Эта фраза вырвалась у меня таким... {i}чужим{/i} тоном."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:289
translate ru qst_NewMyu_4_findMyuChurch_menu_277775a1:

    # KYLISA @ blush "I... Right, well, as long as {i}she's{/i} happy with that as well I suppose."
    KYLISA @ blush "Я... Ладно, что ж, если {i}она{/i} тоже с этим согласна, полагаю."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:290
translate ru qst_NewMyu_4_findMyuChurch_menu_d87ee605:

    # KYLISA @ talk "Perhaps you might want to consider leaving Novaras if that's your long term-plan with her."
    KYLISA @ talk "Возможно, тебе стоит подумать о том, чтобы покинуть Новарас, если это твой долгосрочный план с ней."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:291
translate ru qst_NewMyu_4_findMyuChurch_menu_3f3c80c2:

    # KYLISA @ talk "The inquisition have punished many... With child or not."
    KYLISA @ talk "Инквизиция наказала многих... Беременных или нет."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:292
translate ru qst_NewMyu_4_findMyuChurch_menu_843d3cc8:

    # KYLISA @ talk "Anyway, you two should leave now, before someone else comes inquiring."
    KYLISA @ talk "В любом случае, вам двоим стоит уйти сейчас, пока кто-то ещё не пришёл с расспросами."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:293
translate ru qst_NewMyu_4_findMyuChurch_menu_6fd3619a:

    # MC @ talk "Thank you, Kylisa."
    MC @ talk "Спасибо, Киллиса."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:295
translate ru qst_NewMyu_4_findMyuChurch_menu_e2cf7747:

    # "After that, the two of us slipped away back home safely."
    "После этого мы вдвоём благополучно улизнули домой."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:304
translate ru qst_NewMyu_4_findMyuChurch_menu_a00b8bf6:

    # MYU @ talk "Myu tired, can... can we talk more soon?"
    MYU @ talk "Мью устала, можно... можно поговорить позже?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:305
translate ru qst_NewMyu_4_findMyuChurch_menu_b7078ada:

    # MC @ talk "Of course, Myu."
    MC @ talk "Конечно, Мью."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:309
translate ru qst_NewMyu_4_findMyuChurch_menu_7d6bdbfd:

    # "Before she dissolved, Myu turned to face me once more."
    "Перед тем как раствориться, Мью снова повернулась ко мне."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:309
translate ru qst_NewMyu_4_findMyuChurch_menu_e0576a98:

    # MYU @ talk "Do... [player_name!t] not want to be Myu husband?"
    MYU @ talk "Разве... [player_name!t] не хочет быть мужем Мью?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:311
translate ru qst_NewMyu_4_findMyuChurch_menu_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "Что?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:312
translate ru qst_NewMyu_4_findMyuChurch_menu_6d33c1a7:

    # MYU @ sad "Myu... Understand now, things not as she thought."
    MYU @ sad "Мью... Теперь понимает, всё было не так, как она думала."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:312
translate ru qst_NewMyu_4_findMyuChurch_menu_fa435c59:

    # MYU @ sad "Even though Myu wants [player_name!t], not fair to force someone to love who doesn't love back."
    MYU @ sad "Хотя Мью хочет [player_name!t], несправедливо заставлять кого-то любить того, кто не любит в ответ."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:313
translate ru qst_NewMyu_4_findMyuChurch_menu_8bcea43e:

    # MYU @ sad "So, what does [player_name!t] want?"
    MYU @ sad "Так, чего же хочет [player_name!t]?"

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:320
translate ru qst_NewMyu_4_findMyuChurch_menu_9fdc3e39:

    # MYU @ sad "Myu... Myu understand."
    MYU @ sad "Мью... Мью понимает."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:321
translate ru qst_NewMyu_4_findMyuChurch_menu_31ceb390:

    # MYU @ sad "Myu is sorry for trying to force what cannot be."
    MYU @ sad "Мью сожалеет, что пыталась заставить случиться то, что не может."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:322
translate ru qst_NewMyu_4_findMyuChurch_menu_c2a891a5:

    # MC @ talk "I will still keep you safe and look after you Myu, I promise."
    MC @ talk "Я всё равно буду защищать тебя и заботиться о тебе, Мью, я обещаю."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:323
translate ru qst_NewMyu_4_findMyuChurch_menu_a1015a7d:

    # MC @ talk "I just can't be what you {i}want{/i} me to be."
    MC @ talk "Я просто не могу быть тем, кем ты {i}хочешь{/i}, чтобы я был."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:324
translate ru qst_NewMyu_4_findMyuChurch_menu_2a791db4:

    # MYU @ sad "...Very well, Myu will help when she can."
    MYU @ sad "...Хорошо, Мью будет помогать, когда сможет."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:325
translate ru qst_NewMyu_4_findMyuChurch_menu_59807ae7:

    # MYU @ smile "And maybe, along the way, Myu will find someone who {i}does{/i} want her that way."
    MYU @ smile "И, возможно, по пути Мью найдёт того, кто {i}захочет{/i} её именно такой."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:326
translate ru qst_NewMyu_4_findMyuChurch_menu_e2d535af:

    # MC @ talk "Maybe Myu, maybe."
    MC @ talk "Возможно, Мью, возможно."

# game/data/world_quests/side/novaras/TheNewMyu/scr.rpy:327
translate ru qst_NewMyu_4_findMyuChurch_menu_4c680e03:

    # MC "(I hope I have made the right choice with this.)"
    MC "(Надеюсь, я сделал правильный выбор.)"

