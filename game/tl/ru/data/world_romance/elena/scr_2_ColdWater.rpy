
# game/data/world_romance/elena/scr_2_ColdWater.rpy:2
translate ru rom_Elena_WaterCold_910e6556:

    # "Elena's eyes seemed to dim slightly, her whole body slumping slightly as she awkwardly looked away in rejection."
    "Глаза Елены казалось слегка потускнели, всё её тело немного обмякло, когда она неловко отвернулась, получив отказ."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:3
translate ru rom_Elena_WaterCold_c080e665:

    # ELENA @ sad "Oh..."
    ELENA @ sad "Ох..."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:4
translate ru rom_Elena_WaterCold_3f64276b:

    # ELENA @ sad "I understand."
    ELENA @ sad "Я понимаю."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:5
translate ru rom_Elena_WaterCold_677657a2:

    # ELENA @ grumpy "Umm, I shall be out shortly."
    ELENA @ grumpy "Эм-м, я скоро выйду."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:6
translate ru rom_Elena_WaterCold_4a80105f:

    # "With that Elena headed into [regina_ref!t]'s room, where I heard the continuous pouring of water."
    "С этими словами Елена направилась в комнату [regina_ref!t], откуда я услышал непрерывный звук льющейся воды."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:8
translate ru rom_Elena_WaterCold_655f0d8d:

    # MC "(Hm... Perhaps I need to set some boundaries with Elena.)"
    MC "(Хм... Возможно, мне нужно установить некоторые границы с Еленой.)"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:9
translate ru rom_Elena_WaterCold_ad9ecaac:

    # MC "(That is... {i}If I want boundaries{/i}.)"
    MC "(То есть... {i}Если я хочу границ{/i}.)"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:10
translate ru rom_Elena_WaterCold_1b9393e6:

    # "A short while later, a mostly dried off Elena re-emerged."
    "Спустя короткое время появилась почти высохшая Елена."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:12
translate ru rom_Elena_WaterCold_0517ef7d:

    # ELENA @ talk "Thank you for that [player_name!t]."
    ELENA @ talk "Спасибо за это, [player_name!t]."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:13
translate ru rom_Elena_WaterCold_7969e85b:

    # ELENA @ talk "I'll go back to reading my book now..."
    ELENA @ talk "Я вернусь к чтению своей книги сейчас..."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:16
translate ru rom_Elena_WaterCold_f3d00ea3:

    # "Elena turned to look at me."
    "Елена повернулась, чтобы посмотреть на меня."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:17
translate ru rom_Elena_WaterCold_7ff7020e:

    # ELENA @ sad "Huh?"
    ELENA @ sad "А?"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:18
translate ru rom_Elena_WaterCold_2eb3c81d:

    # "Suddenly moving forward, I placed my lips onto Elena's."
    "Внезапно двинувшись вперед, я прикоснулся губами к губам Елены."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:23
translate ru rom_Elena_WaterCold_76d2e5b5:

    # "Elena's eyes widened in shock as her cheeks blushed."
    "Глаза Елены расширились от шока, а щеки покраснели."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:24
translate ru rom_Elena_WaterCold_c8c3718c:

    # ELENA "Mhmm?!"
    ELENA "Мхм?!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:25
translate ru rom_Elena_WaterCold_18a0bdb6:

    # "Pulling back from her, Elena broke free from my grasp."
    "Отстранившись от нее, Елена вырвалась из моих объятий."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:30
translate ru rom_Elena_WaterCold_c796d455:

    # ELENA @ shock "You... Why did you do that?!"
    ELENA @ shock "Ты... Зачем ты это сделал?!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:31
translate ru rom_Elena_WaterCold_094a4ea1:

    # MC @ talk "Because I wanted to."
    MC @ talk "Потому что я хотел."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:32
translate ru rom_Elena_WaterCold_9c527a87:

    # ELENA @ lewd "You... I don't understand."
    ELENA @ lewd "Ты... Я не понимаю."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:33
translate ru rom_Elena_WaterCold_f9d3a2cc:

    # ELENA @ shock "You... You didn't join me earlier!"
    ELENA @ shock "Ты... Ты не присоединился ко мне раньше!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:34
translate ru rom_Elena_WaterCold_9265b8e8:

    # ELENA @ grumpy "I... I thought..."
    ELENA @ grumpy "Я... Я думала..."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:35
translate ru rom_Elena_WaterCold_b5da0c33:

    # "Elena shook her head and hurried off into my room, slamming the door behind her."
    "Елена покачала головой и поспешно ушла в мою комнату, захлопнув за собой дверь."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:38
translate ru rom_Elena_WaterCold_afac7bab:

    # MC "Elena!"
    MC "Елена!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:39
translate ru rom_Elena_WaterCold_30b61dcd:

    # ELENA "Leave me alone!"
    ELENA "Оставь меня в покое!"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:40
translate ru rom_Elena_WaterCold_3835623a:

    # MC @ sad "(What was I thinking?)"
    MC @ sad "(О чём я думал?)"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:41
translate ru rom_Elena_WaterCold_ac01335d:

    # MC @ sad "(Now I've just given her mixed messages... Damn it, I really need to make my mind up on what {i}we{/i} are.)"
    MC @ sad "(Теперь я только запутал её своими противоречивыми сигналами... Чёрт, мне действительно нужно определиться, кто {i}мы{/i} друг для друга.)"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:47
translate ru rom_Elena_WaterCold_e23bd047:

    # ELENA @ talk "Mmm, will do."
    ELENA @ talk "М-м, так и сделаю."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:48
translate ru rom_Elena_WaterCold_758614c4:

    # "Elena gently closed the door to my room behind her."
    "Елена тихо закрыла за собой дверь в мою комнату."

# game/data/world_romance/elena/scr_2_ColdWater.rpy:49
translate ru rom_Elena_WaterCold_078472d4:

    # MC "(Yes, it's best not to over-complicate things.)"
    MC "(Да, лучше не усложнять дела.)"

# game/data/world_romance/elena/scr_2_ColdWater.rpy:50
translate ru rom_Elena_WaterCold_2c027692:

    # MC "(Remaining just friends and allies is the best course... for the both of us.)"
    MC "(Оставаться просто друзьями и союзниками — лучший путь... для нас обоих.)"

