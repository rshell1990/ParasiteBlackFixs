
# game/data/world_romance/nijah/scr_firstpreg.rpy:8
translate ru preg_Nijah_goodNews_intro_88e7e95f:

    # "As I entered her home, Nijah came to me with hands clasped, nervous."
    "Когда я вошел в её дом, Ниджа подошла ко мне, сложив руки, нервничая."

# game/data/world_romance/nijah/scr_firstpreg.rpy:9
translate ru preg_Nijah_goodNews_intro_1fa9f7ad:

    # NIJAH "Must speak with you."
    NIJAH "Должна поговорить с тобой."

# game/data/world_romance/nijah/scr_firstpreg.rpy:10
translate ru preg_Nijah_goodNews_intro_b7dc45a3:

    # "Sensing her distress, I placed my hands on her shoulders."
    "Почувствовав её беспокойство, я положил руки ей на плечи."

# game/data/world_romance/nijah/scr_firstpreg.rpy:11
translate ru preg_Nijah_goodNews_intro_89f5ce92:

    # MC @ talk "Nijah, what’s wrong?"
    MC @ talk "Ниджа, что случилось?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:12
translate ru preg_Nijah_goodNews_intro_82be8c65:

    # NIJAH "I... I carry your child."
    NIJAH "Я... Я ношу твоего ребёнка."

# game/data/world_romance/nijah/scr_firstpreg.rpy:13
translate ru preg_Nijah_goodNews_intro_f3a940fc:

    # "I pulled back, surprised at the comment."
    "Я отпрянул, удивлённый её словами."

# game/data/world_romance/nijah/scr_firstpreg.rpy:14
translate ru preg_Nijah_goodNews_intro_4f601cd6:

    # MC @ talk "...{i}You’re pregnant?{/i}"
    MC @ talk "...{i}Ты беременна?{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:15
translate ru preg_Nijah_goodNews_intro_a5178513:

    # "Nijah sheepishly nodded."
    "Ниджа смущённо кивнула."

# game/data/world_romance/nijah/scr_firstpreg.rpy:16
translate ru preg_Nijah_goodNews_intro_9a450cee:

    # NIJAH "...Zis not problem?"
    NIJAH "...Это не проблема?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:17
translate ru preg_Nijah_goodNews_intro_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "Что ты имеешь в виду?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:18
translate ru preg_Nijah_goodNews_intro_12df316d:

    # NIJAH "M-any Alderian men... They get Ramonian girls with child and go."
    NIJAH "Многие Алдереанские мужчины... Они заводят детей от Рамонских девушек и уходят."

# game/data/world_romance/nijah/scr_firstpreg.rpy:19
translate ru preg_Nijah_goodNews_intro_75857ca2:

    # NIJAH "...many forced to get rid of child while still in womb."
    NIJAH "...многих вынуждают избавиться от ребёнка ещё в утробе."

# game/data/world_romance/nijah/scr_firstpreg.rpy:20
translate ru preg_Nijah_goodNews_intro_5df92709:

    # NIJAH "But... I want to keep your child."
    NIJAH "Но... Я хочу сохранить твоего ребёнка."

# game/data/world_romance/nijah/scr_firstpreg.rpy:21
translate ru preg_Nijah_goodNews_intro_ff1bdef9:

    # BLACK "She is fit to carry many of our young."
    BLACK "Она способна выносить многих из нашего потомства."

# game/data/world_romance/nijah/scr_firstpreg.rpy:22
translate ru preg_Nijah_goodNews_intro_d75d061d:

    # BLACK "We should keep this one close as a mate."
    BLACK "Мы должны держать эту особь рядом как партнёршу."

# game/data/world_romance/nijah/scr_firstpreg.rpy:23
translate ru preg_Nijah_goodNews_intro_2cebcdc8:

    # MC @ talk "...Nijah, I-"
    MC @ talk "...Ниджа, я-"

# game/data/world_romance/nijah/scr_firstpreg.rpy:24
translate ru preg_Nijah_goodNews_intro_2cb4cedf:

    # NIJAH "I do not care if child can change into monster like you."
    NIJAH "Мне не важно, может ли ребёнок превращаться в монстра, как ты."

# game/data/world_romance/nijah/scr_firstpreg.rpy:25
translate ru preg_Nijah_goodNews_intro_ac59f889:

    # NIJAH "It is {i}our{/i} baby, and that is good enough for me."
    NIJAH "Это {i}наш{/i} ребёнок, и этого для меня достаточно."

# game/data/world_romance/nijah/scr_firstpreg.rpy:26
translate ru preg_Nijah_goodNews_intro_a51e43f2:

    # "Nijah seemed to wait anxiously for a few moments. Almost stand-offish, perhaps expecting me to tell her to get rid of the child or that I didn’t want to see her anymore."
    "Ниджа, казалось несколько мгновений тревожно ждала. Почти отстранённо, возможно ожидая что я скажу ей избавиться от ребёнка или что не хочу больше её видеть."

# game/data/world_romance/nijah/scr_firstpreg.rpy:27
translate ru preg_Nijah_goodNews_intro_abd548b8:

    # MC @ talk "Nijah... {i}You are mine.{/i}"
    MC @ talk "Ниджа... {i}Ты моя.{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:28
translate ru preg_Nijah_goodNews_intro_e7158e0a:

    # MC @ talk "I am pleased you carry my child."
    MC @ talk "Я рад, что ты носишь моего ребенка."

# game/data/world_romance/nijah/scr_firstpreg.rpy:29
translate ru preg_Nijah_goodNews_intro_d62be6ae:

    # "Nijah’s eyes seemed to light up."
    "Глаза Ниджи, казалось, загорелись."

# game/data/world_romance/nijah/scr_firstpreg.rpy:30
translate ru preg_Nijah_goodNews_intro_84ee69e2:

    # NIJAH "R-Really?"
    NIJAH "П-правда?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:31
translate ru preg_Nijah_goodNews_intro_78ec95d9:

    # "With a bright smile, Nijah flung herself onto me, planting kiss onto my lips."
    "С сияющей улыбкой Ниджа бросилась на меня, прижавшись губами к моим."

# game/data/world_romance/nijah/scr_firstpreg.rpy:32
translate ru preg_Nijah_goodNews_intro_6bcb1c75:

    # NIJAH "M-Master... I love you so much!"
    NIJAH "Х-Хозяин... Я так тебя люблю!"

# game/data/world_romance/nijah/scr_firstpreg.rpy:33
translate ru preg_Nijah_goodNews_intro_cb9042a3:

    # MC @ talk "Nijah, you know you don’t need to-"
    MC @ talk "Ниджа, ты же знаешь, что не обязана-"

# game/data/world_romance/nijah/scr_firstpreg.rpy:34
translate ru preg_Nijah_goodNews_intro_436f3b45:

    # "Nijah interrupted me again mid-sentence to plant another kiss on my lips."
    "Ниджа снова прервала меня на полуслове, чтобы поцеловать в губы."

# game/data/world_romance/nijah/scr_firstpreg.rpy:35
translate ru preg_Nijah_goodNews_intro_0a0c7479:

    # NIJAH "I shall get some dinner on, stay a while."
    NIJAH "Я приготовлю ужин, останься ненадолго."

# game/data/world_romance/nijah/scr_firstpreg.rpy:36
translate ru preg_Nijah_goodNews_intro_2eb2dd4a:

    # "With that, Nijah turned, humming happily to herself as she made her way to the kitchen to prepare some food."
    "С этими словами, Ниджа повернулась, напевая себе под нос пока направлялась на кухню чтобы приготовить еду."

# game/data/world_romance/nijah/scr_firstpreg.rpy:40
translate ru preg_Nijah_goodNews_intro_6c38b146:

    # "After eating with Nijah, I departed once again, thinking about my soon to be new-born child I was now having with Nijah."
    "Поужинав с Ниджей, я снова отправился в путь, думая о своем будущем новорожденном ребенке, которого теперь жду с Ниджей."

