# game/data/world_romance/nijah/scr_future.rpy:2
translate ru rom_Nijah_stage1_future_lines_98050e9d:

    # MC @ talk "Say... Now that Tarek is dealt with, what are you going to do?"
    MC @ talk "Скажи... Теперь, когда с Тареком разобрались, что ты собираешься делать?"

# game/data/world_romance/nijah/scr_future.rpy:3
translate ru rom_Nijah_stage1_future_lines_aaa26ffd:

    # "Nijah pondered the thought for a moment, unsure of an opportunity she had never expected to have."
    "Ниджа задумалась на мгновение, не уверенная в возможности, которую никогда не ожидала получить."

# game/data/world_romance/nijah/scr_future.rpy:4
translate ru rom_Nijah_stage1_future_lines_7138364c:

    # NIJAH "I don’t know..."
    NIJAH "Я не знаю..."

# game/data/world_romance/nijah/scr_future.rpy:5
translate ru rom_Nijah_stage1_future_lines_57b30ffe:

    # NIJAH "I suppose I could go back to working at za Pleasure District..."
    NIJAH "Полагаю, я могла бы вернуться к работе в Районе Удовольствий..."

# game/data/world_romance/nijah/scr_future.rpy:6
translate ru rom_Nijah_stage1_future_lines_c606d148:

    # NIJAH "... The money is good, but iz not the safest job..."
    NIJAH "... Деньги хорошие, но это не самая безопасная работа..."

# game/data/world_romance/nijah/scr_future.rpy:7
translate ru rom_Nijah_stage1_future_lines_43fc26ca:

    # MC @ talk "... Is that your only option?"
    MC @ talk "... Это твой единственный вариант?"

# game/data/world_romance/nijah/scr_future.rpy:8
translate ru rom_Nijah_stage1_future_lines_a57cee14:

    # NIJAH "There is other way, but I’d need investors."
    NIJAH "Есть другой путь, но мне понадобятся инвесторы."

# game/data/world_romance/nijah/scr_future.rpy:9
translate ru rom_Nijah_stage1_future_lines_6e7816fb:

    # MC @ talk "Investors? What are you planning?"
    MC @ talk "Инвесторы? Что ты планируешь?"

# game/data/world_romance/nijah/scr_future.rpy:10
translate ru rom_Nijah_stage1_future_lines_dd91a10a:

    # NIJAH "I can cook food..."
    NIJAH "Я умею готовить еду..."

# game/data/world_romance/nijah/scr_future.rpy:11
translate ru rom_Nijah_stage1_future_lines_0a687ef1:

    # MC @ talk "What? Like bakery food?"
    MC @ talk "Что? Типа, выпечку?"

# game/data/world_romance/nijah/scr_future.rpy:12
translate ru rom_Nijah_stage1_future_lines_8199ae0d:

    # NIJAH "No, no... Ramonian street food!"
    NIJAH "Нет, нет... Рамонская уличная еда!"

# game/data/world_romance/nijah/scr_future.rpy:13
translate ru rom_Nijah_stage1_future_lines_a41c5243:

    # NIJAH "Food quick, tasty for people to eat while on go..."
    NIJAH "Еда быстрая, вкусная, чтобы люди ели на ходу..."

# game/data/world_romance/nijah/scr_future.rpy:14
translate ru rom_Nijah_stage1_future_lines_9e9890a6:

    # MC @ smile "Ha-ha! You're full of surprises..."
    MC @ smile "Ха-ха! Ты полна сюрпризов..."

# game/data/world_romance/nijah/scr_future.rpy:15
translate ru rom_Nijah_stage1_future_lines_09e880c3:

    # MC @ talk "Well how much do you need?"
    MC @ talk "Ну, сколько тебе нужно?"

# game/data/world_romance/nijah/scr_future.rpy:16
translate ru rom_Nijah_stage1_future_lines_e049698d:

    # NIJAH "Enough for stall... Plus ingredients and cooking equipment..."
    NIJAH "Достаточно для ларька... Плюс ингредиенты и кухонное оборудование..."

# game/data/world_romance/nijah/scr_future.rpy:17
translate ru rom_Nijah_stage1_future_lines_6ca852ee:

    # NIJAH "At least thousand gold..."
    NIJAH "Как минимум тысяча золотых..."

# game/data/world_romance/nijah/scr_future.rpy:18
translate ru rom_Nijah_stage1_future_lines_806b841b:

    # "(That’s quite a lot.)"
    "(Это довольно много.)"

# game/data/world_romance/nijah/scr_future.rpy:19
translate ru rom_Nijah_stage1_future_lines_8c4ad5bf:

    # "(What should I encourage her to do?)"
    "(Что мне посоветовать ей сделать?)"

# game/data/world_romance/nijah/scr_future.rpy:22
translate ru rom_Nijah_stage1_future_lines_menu_02182bf6:

    # NIJAH @ happy "...!"
    NIJAH @ happy "...!"

# game/data/world_romance/nijah/scr_future.rpy:23
translate ru rom_Nijah_stage1_future_lines_menu_d82da894:

    # NIJAH @ smile "You will?"
    NIJAH @ smile "Ты согласен?"

# game/data/world_romance/nijah/scr_future.rpy:24
translate ru rom_Nijah_stage1_future_lines_menu_9f0aa4e9:

    # NIJAH @ smile "A thousand gold?"
    NIJAH @ smile "Тысяча золотых?"

# game/data/world_romance/nijah/scr_future.rpy:25
translate ru rom_Nijah_stage1_future_lines_menu_d58cad19:

    # NIJAH "I... I cannot ask you to do zis!"
    NIJAH "Я... Я не могу просить тебя об этом!"

# game/data/world_romance/nijah/scr_future.rpy:30
translate ru rom_Nijah_stage1_future_lines_menu_97fa787e:

    # NIJAH "Zis is..."
    NIJAH "Это же..."

# game/data/world_romance/nijah/scr_future.rpy:31
translate ru rom_Nijah_stage1_future_lines_menu_cdf45d1e:

    # "Nijah started to cry"
    "Ниджа заплакала"

# game/data/world_romance/nijah/scr_future.rpy:32
translate ru rom_Nijah_stage1_future_lines_menu_04f17e1e:

    # NIJAH @ sad "... You haz done too much for me."
    NIJAH @ sad "... Ты уже сделал для меня слишком много."

# game/data/world_romance/nijah/scr_future.rpy:34
translate ru rom_Nijah_stage1_future_lines_menu_a6b98d5f:

    # "Nijah hurried forward, wrapping her arms around me in a tight hug, when she pulled back, she smiled warmly, tears streaming down her cheeks in joy."
    "Ниджа бросилась вперед, обхватив меня в крепких объятиях, а когда отстранилась, тепло улыбнулась, и слезы радости потекли по ее щекам."

# game/data/world_romance/nijah/scr_future.rpy:38
translate ru rom_Nijah_stage1_future_lines_menu_a997409b:

    # NIJAH "Alright... I trust you... I shall wait for you."
    NIJAH "Хорошо... Я верю тебе... Я буду ждать тебя."

# game/data/world_romance/nijah/scr_future.rpy:42
translate ru rom_Nijah_stage1_future_lines_menu_b41866ee:

    # NIJAH "You... Vat?"
    NIJAH "Ты... Что?"

# game/data/world_romance/nijah/scr_future.rpy:43
translate ru rom_Nijah_stage1_future_lines_menu_88ce21a9:

    # MC @ talk "I’ll pay for you to have your own room."
    MC @ talk "Я заплачу за отдельную комнату для тебя."

# game/data/world_romance/nijah/scr_future.rpy:44
translate ru rom_Nijah_stage1_future_lines_menu_ba9be3de:

    # MC @ talk "As a Novaras citizen, I can quickly and legally get the paperwork you need."
    MC @ talk "Как гражданин Новараса, я могу быстро и легально оформить все необходимые документы."

# game/data/world_romance/nijah/scr_future.rpy:45
translate ru rom_Nijah_stage1_future_lines_menu_1ef1adfd:

    # MC @ talk "I can also guarantee you have some protection that before you was not privy to."
    MC @ talk "Я также могу гарантировать, что у тебя будет защита, о которой раньше ты не знала."

# game/data/world_romance/nijah/scr_future.rpy:46
translate ru rom_Nijah_stage1_future_lines_menu_a4b7cc57:

    # MC "Nijah pondered the thought a moment, hesistant about the idea of returning to her old line of work."
    MC "Ниджа задумалась на мгновение, сомневаясь в идее возвращения к своей старой работе."

# game/data/world_romance/nijah/scr_future.rpy:47
translate ru rom_Nijah_stage1_future_lines_menu_9cc15501:

    # NIJAH "This... would be better."
    NIJAH "Это... было бы лучше."

# game/data/world_romance/nijah/scr_future.rpy:48
translate ru rom_Nijah_stage1_future_lines_menu_1364cda5:

    # NIJAH "{i}But...{/i}"
    NIJAH "{i}Но...{/i}"

# game/data/world_romance/nijah/scr_future.rpy:49
translate ru rom_Nijah_stage1_future_lines_menu_e66bab01:

    # MC "Nijah opened her mouth to protest, but instead, her eyes simply dropped to the floor as she reached and grabbed at her other arm anxiously."
    MC "Ниджа открыла рот, чтобы возразить, но вместо этого её глаза просто опустились на пол, пока она беспокойно хваталась за свою другую руку."

# game/data/world_romance/nijah/scr_future.rpy:50
translate ru rom_Nijah_stage1_future_lines_menu_6f13d691:

    # NIJAH "In return, you want share of gold I earn?"
    NIJAH "Взамен ты хочешь долю от золота, которое я заработаю?"

# game/data/world_romance/nijah/scr_future.rpy:51
translate ru rom_Nijah_stage1_future_lines_menu_83589d81:

    # MC @ talk "I do."
    MC @ talk "Да."

# game/data/world_romance/nijah/scr_future.rpy:52
translate ru rom_Nijah_stage1_future_lines_menu_79b06185:

    # NIJAH "... Thirty percent?"
    NIJAH "... Тридцать процентов?"

# game/data/world_romance/nijah/scr_future.rpy:55
translate ru rom_Nijah_stage1_future_lines_menu_568c2bf8:

    # MC @ talk "Yeah, that's a deal."
    MC @ talk "Да, так пойдет."

# game/data/world_romance/nijah/scr_future.rpy:58
translate ru rom_Nijah_stage1_future_lines_menu_991a9c2d:

    # NIJAH "Alright... I suppose after all you have done zis iz fair..."
    NIJAH "Хорошо... Полагаю, после всего что ты сделал, это справедливо..."

# game/data/world_romance/nijah/scr_future.rpy:59
translate ru rom_Nijah_stage1_future_lines_menu_25a09a38:

    # NIJAH "I come with you to speak to men in charge of district..."
    NIJAH "Я пойду с тобой поговорить с людьми, отвечающими за район..."

# game/data/world_romance/nijah/scr_future.rpy:62
translate ru rom_Nijah_stage1_future_lines_menu_ded37cfe:

    # "Following Nijah down to the District, she introduced me to one of the officials there, a tall and uninspiring rake of a man who sat down in one of the few ‘offices’ littered around the District that the girls use when they want to lodge complaints."
    "Следуя за Ниджей вниз к Району, она представила меня одному из местных чиновников, высокому и невпечатляющему тощему мужчине, который сидел в одном из немногих ‘офисов’, разбросанных по Району, которые девушки используют, когда хотят подать жалобу."

# game/data/world_romance/nijah/scr_future.rpy:63
translate ru rom_Nijah_stage1_future_lines_menu_620526a0:

    # "When I showed him my gold, it didn’t exactly take long to have the right paperwork and such in place. In just a few hours, we were set to go..."
    "Когда я показал ему своё золото, оформление нужных документов и всего прочего заняло совсем немного времени. Уже через несколько часов мы были готовы к отъезду..."

# game/data/world_romance/nijah/scr_future.rpy:64
translate ru rom_Nijah_stage1_future_lines_menu_59f434a3:

    # "Nijah had her own room, and it was known to all that she was a protected girl now."
    "У Ниджи была своя комната, и все знали, что теперь она — защищённая девушка."

# game/data/world_romance/nijah/scr_future.rpy:71
translate ru rom_Nijah_stage1_future_lines_menu_8f0508e3:

    # NIJAH "Zat was... very quick."
    NIJAH "Это было... очень быстро."

# game/data/world_romance/nijah/scr_future.rpy:72
translate ru rom_Nijah_stage1_future_lines_menu_a8cbf7ee:

    # NIJAH "It would take a Ramonian like me weeks to get anywhere with them."
    NIJAH "Такой Рамонианке как я, потребовались бы недели, чтобы чего-то добиться от них."

# game/data/world_romance/nijah/scr_future.rpy:73
translate ru rom_Nijah_stage1_future_lines_menu_5f7e87c5:

    # MC @ talk "Being a citizen has its benefits."
    MC @ talk "Быть гражданином имеет свои преимущества."

# game/data/world_romance/nijah/scr_future.rpy:74
translate ru rom_Nijah_stage1_future_lines_menu_7e9393ab:

    # NIJAH "I suppose I better get back to za work... Stop by to collect your money once a fortnight."
    NIJAH "Полагаю, мне лучше вернуться к работе... Приходи за деньгами раз в две недели."

# game/data/world_romance/nijah/scr_future.rpy:75
translate ru rom_Nijah_stage1_future_lines_menu_e35850f4:

    # MC @ talk "Let me know if there are any problems, remember, you are protected by me now."
    MC @ talk "Дай мне знать, если возникнут проблемы, помни, теперь ты под моей защитой."

# game/data/world_romance/nijah/scr_future.rpy:76
translate ru rom_Nijah_stage1_future_lines_menu_518f3315:

    # MC @ talk "I will see to it that no harm comes to you."
    MC @ talk "Я позабочусь о том, чтобы тебе не причинили вреда."

# game/data/world_romance/nijah/scr_future.rpy:77
translate ru rom_Nijah_stage1_future_lines_menu_4e16aac8:

    # "Nijah smiled unconvincingly, but nodded anyway."
    "Ниджа неубедительно улыбнулась, но всё равно кивнула."

# game/data/world_romance/nijah/scr_future.rpy:78
translate ru rom_Nijah_stage1_future_lines_menu_7b19a276:

    # NIJAH "T-Thank you... Now if you excuse me, I should get ready."
    NIJAH "С-Спасибо... А теперь, если позволишь, мне нужно подготовиться."

# game/data/world_romance/nijah/scr_future.rpy:79
translate ru rom_Nijah_stage1_future_lines_menu_10f6a25a:

    # MC "I watched as Nijah headed off, no doubt to prepare for her {i}'clients'{/i}"
    MC "Я наблюдал как Ниджа ушла, без сомнений что бы подготовиться к своим {i}'клиентам'{/i}."

# game/data/world_romance/nijah/scr_future.rpy:81
translate ru rom_Nijah_stage1_future_lines_menu_49528545:

    # "And just like that, Nijah returned to her old work... A part of me wondered if I’d made the right choice, if perhaps, Nijah wanted and deserved better than this life?"
    "И вот так Ниджа вернулась к своей старой работе... Часть меня задавалась вопросом, правильно ли я поступил, и возможно, Ниджа хотела и заслуживала лучшей жизни, чем эта?"

# game/data/world_romance/nijah/scr_future.rpy:82
translate ru rom_Nijah_stage1_future_lines_menu_da7e2faa:

    # "But, as I reminded myself, she was now safer than before... And my pockets were going to get a lot heavier. Morality aside, maybe this was for the best."
    "Но, как я напомнил себе, теперь она была в большей безопасности, чем раньше... И мои карманы скоро станут намного тяжелее. Если отбросить мораль, возможно так будет лучше."

