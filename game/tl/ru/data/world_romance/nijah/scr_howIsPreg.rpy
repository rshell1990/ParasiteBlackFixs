
# game/data/world_romance/nijah/scr_howIsPreg.rpy:4
translate ru rom_nijah_howIsBaby_94f50b3d:

    # NIJAH "I can feel zer baby kick a lot today."
    NIJAH "Я чувствую, как малыш сегодня много пинается."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:5
translate ru rom_nijah_howIsBaby_a3912238:

    # NIJAH "He will be strong like his father no doubt!"
    NIJAH "Он будет сильным, как его отец, без сомнений!"

# game/data/world_romance/nijah/scr_howIsPreg.rpy:7
translate ru rom_nijah_howIsBaby_7a8a70e5:

    # NIJAH "L-Lot of pain today."
    NIJAH "С-Сегодня много боли."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:8
translate ru rom_nijah_howIsBaby_900d2ac1:

    # NIJAH "Need to sit down more..."
    NIJAH "Нужно больше сидеть..."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:10
translate ru rom_nijah_howIsBaby_25d7ff2c:

    # "Nijah laughed as she rubbed at her round belly."
    "Ниджаа смеялась, потирая свой круглый живот."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:11
translate ru rom_nijah_howIsBaby_4a31d51e:

    # NIJAH "Iz silly, but I keep rubbing my belly."
    NIJAH "Это глупо, но я продолжаю тереть живот."

# game/data/world_romance/nijah/scr_howIsPreg.rpy:12
translate ru rom_nijah_howIsBaby_29041c7b:

    # NIJAH "And when I think it iz our child, I am very happy!"
    NIJAH "И когда я думаю, что это наш ребёнок, я очень счастлива!"

