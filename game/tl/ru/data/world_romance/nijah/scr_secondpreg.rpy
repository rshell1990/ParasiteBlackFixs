    # NIJAH "Uhh, my love?"
    NIJAH "Ээ, любимый?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:6
translate ru preg_Nijah_secondPreg_ccbd6626:

    # MC @ talk "What is it, Nijah?"
    MC @ talk "Что такое, Ниджа?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:7
translate ru preg_Nijah_secondPreg_c62c397f:

    # NIJAH @ smile "You did it again."
    NIJAH @ smile "Ты снова это сделал."

# game/data/world_romance/nijah/scr_secondpreg.rpy:8
translate ru preg_Nijah_secondPreg_2b7a6d10:

    # "Nijah happily rubbed her belly."
    "Ниджа счастливо потерла свой живот."

# game/data/world_romance/nijah/scr_secondpreg.rpy:9
translate ru preg_Nijah_secondPreg_2c6a0c4d:

    # NIJAH @ smile "I am with child once more."
    NIJAH @ smile "Я снова жду ребенка."

# game/data/world_romance/nijah/scr_secondpreg.rpy:10
translate ru preg_Nijah_secondPreg_530a0797:

    # "Nijah took my hand and placed it over her belly, where once again I could feel the swelling life and power coursing inside of her."
    "Ниджа взяла мою руку и положила её на свой живот, где я снова мог почувствовать пульсирующую жизнь и силу внутри неё."

# game/data/world_romance/nijah/scr_secondpreg.rpy:11
translate ru preg_Nijah_secondPreg_c9ecd207:

    # NIJAH "Are you pleased, master?"
    NIJAH "Вы довольны, хозяин?"

# game/data/world_romance/nijah/scr_secondpreg.rpy:12
translate ru preg_Nijah_secondPreg_43ba64e3:

    # MC @ smile "Very much so, Nijah."
    MC @ smile "Очень даже, Ниджа."

# game/data/world_romance/nijah/scr_secondpreg.rpy:13
translate ru preg_Nijah_secondPreg_f2c2b4bc:

    # NIJAH @ smile "I have missed you much, come... Let me serve you food."
    NIJAH @ smile "Я очень по тебе скучала, иди... Позволь мне подать тебе еду."

# game/data/world_romance/nijah/scr_secondpreg.rpy:14
translate ru preg_Nijah_secondPreg_0ff7edaf:

    # NIJAH @ smile "Iz good our children will have lots of brothers and sisters!"
    NIJAH @ smile "Хорошо, что у наших детей будет много братьев и сестёр!"

# game/data/world_romance/nijah/scr_secondpreg.rpy:16
translate ru preg_Nijah_secondPreg_9053ae27:

    # "Nijah did her best to chat away with me as she cooked and served me some food."
    "Ниджа изо всех сил пыталась болтать со мной, пока готовила и подавала мне еду."

# game/data/world_romance/nijah/scr_secondpreg.rpy:17
translate ru preg_Nijah_secondPreg_3ad40bab:

    # "Her Alderian was still broken, but she did her best to learn and was constantly moving between rooms, attending to our already born children and devoting lavishly on me."
    "Её Алдереанский всё ещё был ломаным, но она изо всех сил старалась учиться и постоянно перемещалась между комнатами, ухаживая за нашими уже родившимися детьми и щедро уделяя внимание мне."

# game/data/world_romance/nijah/scr_secondpreg.rpy:18
translate ru preg_Nijah_secondPreg_2500c393:

    # "Finally, with a kiss goodbye and a squeeze of her round ass, I was off once again, assuring Nijah I would return."
    "Наконец, с прощальным поцелуем и шлепком по её круглой заднице, я снова отправился в путь, уверяя Ниджу, что вернусь."

