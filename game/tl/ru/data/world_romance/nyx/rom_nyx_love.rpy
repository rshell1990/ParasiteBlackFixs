    # NYX "Yeshhh!"
    NYX "Даааа!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:510
translate ru nyx_love_unicorn_date_menu_c2cb5f07:

    # "I sighed, smiling towards her as I began to take off my armor."
    "Я вздохнул, улыбаясь ей, и начал снимать доспехи."

# game/data/world_romance/nyx/rom_nyx_love.rpy:511
translate ru nyx_love_unicorn_date_menu_34869000:

    # "She was a demanding drunk, but a surprisingly adorable one."
    "Она была требовательной пьяницей, но удивительно милой."

# game/data/world_romance/nyx/rom_nyx_love.rpy:514
translate ru nyx_love_unicorn_date_menu_a820c7cf:

    # "Slipping into the bed alongside her, Nyx rested her head on my chest before dreamily begining to drift off to sleep."
    "Забравшись в кровать рядом с ней, Никс положила голову мне на грудь и начала мечтательно засыпать."

# game/data/world_romance/nyx/rom_nyx_love.rpy:515
translate ru nyx_love_unicorn_date_menu_210045c0:

    # NYX "Pleasheee ... Stahyyy from nowh on."
    NYX "Пожааалуйста... Остааавайся со мной отныне."

# game/data/world_romance/nyx/rom_nyx_love.rpy:516
translate ru nyx_love_unicorn_date_menu_d55a46ed:

    # NYX "I feelshsoo, {i}lonely...{/i}"
    NYX "Мне тааак {i}одиноко...{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:517
translate ru nyx_love_unicorn_date_menu_ef6bdac4:

    # "And like that, Nyx was asleep."
    "И после этого, Никс уснула."

# game/data/world_romance/nyx/rom_nyx_love.rpy:518
translate ru nyx_love_unicorn_date_menu_068b1625:

    # "Gently, I stroked her hair softly till I too, began to drift off."
    "Нежно я гладил её волосы, пока и сам не начал засыпать."

# game/data/world_romance/nyx/rom_nyx_love.rpy:529
translate ru nyx_love_unicorn_date_menu_37c594d7:

    # "As I open my eyes, I sit-upright to find I'm alone in Captain Nyx's bed."
    "Открыв глаза, я резко сажусь и обнаруживаю, что один в кровати капитана Никс."

# game/data/world_romance/nyx/rom_nyx_love.rpy:530
translate ru nyx_love_unicorn_date_menu_08a3ecb7:

    # MC @ talk "Nyx?"
    MC @ talk "Никс?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:532
translate ru nyx_love_unicorn_date_menu_d50f673b:

    # "Beside the bed, a small note is left with a key beside it."
    "Рядом с кроватью оставлена маленькая записка, а рядом с ней ключ."

# game/data/world_romance/nyx/rom_nyx_love.rpy:534
translate ru nyx_love_unicorn_date_menu_a20dcd6b:

    # "{i}I didn't want to wake you, I've been called to deal with some urgent work at once.{/i}"
    "{i}Не хотела тебя будить, меня срочно вызвали по работе.{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:535
translate ru nyx_love_unicorn_date_menu_0256e04f:

    # "{i}Thank you for last night, I didn't realise how much I needed it.{/i}"
    "{i}Спасибо за прошлую ночь, я и не осознавала, как сильно мне это было нужно.{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:536
translate ru nyx_love_unicorn_date_menu_6edd8291:

    # "{i}...And thanks for the worst hangover I've had in years.{/i}"
    "{i}...И спасибо за худшее похмелье за последние годы.{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:537
translate ru nyx_love_unicorn_date_menu_627e8963:

    # "{i}Come see me soon, please... We have much to discuss.{/i}"
    "{i}Приходи скорее, пожалуйста... Нам нужно многое обсудить.{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:538
translate ru nyx_love_unicorn_date_menu_58acec7e:

    # "{i}-Nyx{/i}"
    "{i}-Никс{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:540
translate ru nyx_love_unicorn_date_menu_d6ae9711:

    # MC "(I should give it a day or so before trying to visit Nyx again.)"
    MC "(Стоит подождать день или два, прежде чем снова навещать Никс.)"

# game/data/world_romance/nyx/rom_nyx_love.rpy:541
translate ru nyx_love_unicorn_date_menu_e49ae314:

    # MC "(Give her time to deal with her work and think about what happened.)"
    MC "(Дать ей время разобраться с работой и обдумать произошедшее.)"

# game/data/world_romance/nyx/rom_nyx_love.rpy:542
translate ru nyx_love_unicorn_date_menu_a6865cfb:

    # MC "(Damn, what a night!)"
    MC "(Чёрт, вот это ночка!)"

translate ru strings:

    # game/data/world_romance/nyx/rom_nyx_love.rpy:18
    old "Come with me tonight to the {i}Iron Unicorn.{/i}"
    new "Пойдём со мной сегодня вечером к {i}Железному Единорогу.{/i}"

    # game/data/world_romance/nyx/rom_nyx_love.rpy:53
    old "You're right, we should keep things professional. {image=[ICON.HEART_CROSS]}"
    new "Ты права, нам следует сохранять профессионализм. {image=[ICON.HEART_CROSS]}"

    # game/data/world_romance/nyx/rom_nyx_love.rpy:101
    old "A short while later..."
    new "Немного позже..."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:137
    old "In truth, I just wanted a paperwork job within the royal Palace."
    new "По правде говоря, я просто хотел работу с бумагами в королевском Дворце."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:150
    old "I wanted to be an Adventurer."
    new "Я хотел стать Искателем приключений."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:162
    old "I wanted to work at the brothels."
    new "Я хотел работать в борделях."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:183
    old "I'd like to just settle down, hopefully comfortably, with someone I love I think."
    new "Я бы хотел просто осесть, желательно комфортно, с кем-то, кого люблю, наверное."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:187
    old "I'm not sure ... I guess I'll just see how things play out."
    new "Я не уверен... Полагаю, просто посмотрю, как всё сложится."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:193
    old "Power is everything ... And I intend to grab as much of it as I can."
    new "Сила — это всё... И я намерен захватить её как можно больше."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:206
    old "I think you're funny."
    new "Я думаю, ты забавная."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:223
    old "That's why I like you, you're unlike any woman I've ever met before."
    new "Вот почему ты мне нравишься, ты не похожа ни на одну женщину, которую я когда-либо встречал."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:241
    old "Have you ever been in love before?"
    new "Ты когда-нибудь была влюблена?"

    # game/data/world_romance/nyx/rom_nyx_love.rpy:254
    old "Do you like your job?"
    new "Тебе нравится твоя работа?"

    # game/data/world_romance/nyx/rom_nyx_love.rpy:272
    old "Where are you parents now?"
    new "Где сейчас твои родители?"

    # game/data/world_romance/nyx/rom_nyx_love.rpy:295
    old "I think I've asked enough questions."
    new "Думаю, я задал достаточно вопросов."

    # game/data/world_romance/nyx/rom_nyx_love.rpy:302
    old "A couple hours later..."
    new "Пару часов спустя..."

