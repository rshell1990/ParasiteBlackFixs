
# game/data/world_romance/nyx/rom_nyx_love.rpy:4
translate ru rom_nyx_love_1_8a057542:

    # MC "Nyx isn't here. I'll try tomorrow."
    MC "Никс здесь нет. Попробую завтра."

# game/data/world_romance/nyx/rom_nyx_love.rpy:12
translate ru rom_nyx_love_1_79969df8:

    # "Upon entering into her Office, Nyx stormed over angrily towards me, hands balled up into fists."
    "Войдя в её кабинет, Никс гневно бросилась ко мне, сжав руки в кулаки."

# game/data/world_romance/nyx/rom_nyx_love.rpy:13
translate ru rom_nyx_love_1_d545ac2c:

    # NYX @ angry "Was I not clear before?"
    NYX @ angry "Разве я не была ясна раньше?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:14
translate ru rom_nyx_love_1_1583fce0:

    # NYX @ angry "What in the seven hells are you doing here?"
    NYX @ angry "Что, чёрт возьми, ты здесь делаешь?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:15
translate ru rom_nyx_love_1_e7723627:

    # MC @ talk "I came here to speak to you."
    MC @ talk "Я пришёл поговорить с тобой."

# game/data/world_romance/nyx/rom_nyx_love.rpy:16
translate ru rom_nyx_love_1_bcb3903c:

    # NYX @ think "About what? There is nothing to discuss."
    NYX @ think "О чём? Нам нечего обсуждать."

# game/data/world_romance/nyx/rom_nyx_love.rpy:20
translate ru rom_nyx_love_1_9e2a7ee2:

    # NYX @ shock "E-Excuse me?"
    NYX @ shock "П-Прости?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:21
translate ru rom_nyx_love_1_5029d028:

    # MC @ talk "You can't work all the time; you need a break every once in a while."
    MC @ talk "Ты не можешь работать всё время; тебе нужен перерыв время от времени."

# game/data/world_romance/nyx/rom_nyx_love.rpy:22
translate ru rom_nyx_love_1_f23ff399:

    # NYX @ angry "Are you even hearing yourself?!"
    NYX @ angry "Ты себя вообще слышишь?!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:24
translate ru rom_nyx_love_1_f8707b9c:

    # NYX @ arrogant "I'm the captain of the city guard ... Not some peasant girl you're courting!"
    NYX @ arrogant "Я капитан городской стражи... А не какая-то крестьянка, за которой ты ухаживаешь!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:25
translate ru rom_nyx_love_1_b22b2824:

    # MC @ smile "And does the captain of the city guard never take a day-off?"
    MC @ smile "И разве капитан городской стражи никогда не берёт выходной?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:26
translate ru rom_nyx_love_1_e7085def:

    # NYX @ arrogant "My duties and responsibilities come first."
    NYX @ arrogant "Мои обязанности и ответственность на первом месте."

# game/data/world_romance/nyx/rom_nyx_love.rpy:27
translate ru rom_nyx_love_1_d66b89f3:

    # MC @ talk "Surely you can't fulfil those duties as well without taking a break every now and then?"
    MC @ talk "Неужели ты не можешь выполнять эти обязанности так же хорошо без перерыва время от времени?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:29
translate ru rom_nyx_love_1_4263f98d:

    # NYX @ angry "Must you persist in this matter?"
    NYX @ angry "Зачем ты должен настаивать на этом?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:30
translate ru rom_nyx_love_1_bd72f8b4:

    # MC @ smile "Because I care about you."
    MC @ smile "Потому что я забочусь о тебе."

# game/data/world_romance/nyx/rom_nyx_love.rpy:32
translate ru rom_nyx_love_1_1c9a7cfb:

    # "Nyx blushed at the comment, grumbling beneath her breath how 'stupid' I was being while averting her gaze."
    "Никс покраснела от комментария, пробормотав себе под нос, какой я 'глупый', и отвела взгляд."

# game/data/world_romance/nyx/rom_nyx_love.rpy:33
translate ru rom_nyx_love_1_4df40c75:

    # NYX @ think "{i}*Sigh*{/i}"
    NYX @ think "{i}*Вздох*{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:35
translate ru rom_nyx_love_1_db4c46e8:

    # NYX @ angry "What if someone sees me, hm? How do you propose I explain that one?"
    NYX @ angry "Что, если кто-то увидит меня, хм? Как ты предлагаешь мне это объяснить?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:36
translate ru rom_nyx_love_1_22ed2d9d:

    # MC @ talk "Am I supposed to believe you're incapable of disguising yourself?"
    MC @ talk "Я должен поверить, что ты не способна замаскироваться?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:37
translate ru rom_nyx_love_1_d2159437:

    # MC @ talk "Outside of that armor, how many are honestly going to recognize you?"
    MC @ talk "Вне этого доспеха, сколько людей действительно тебя узнают?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:39
translate ru rom_nyx_love_1_482d7b74:

    # NYX @ think "...Fine, FINE!"
    NYX @ think "...Ладно, ХОРОШО!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:40
translate ru rom_nyx_love_1_78b039bd:

    # NYX @ angry "But push aside silly notions of this being anything more than a chance for me to take a break from work."
    NYX @ angry "Но отбрось глупые мысли о том, что это что-то большее, чем возможность для меня сделать перерыв в работе."

# game/data/world_romance/nyx/rom_nyx_love.rpy:41
translate ru rom_nyx_love_1_aef727ce:

    # NYX @ think "What happened last time {i}won't{/i} happen again."
    NYX @ think "То, что случилось в прошлый раз, {i}не{/i} повторится."

# game/data/world_romance/nyx/rom_nyx_love.rpy:42
translate ru rom_nyx_love_1_0746b417:

    # MC @ smile "If you say so."
    MC @ smile "Как скажешь."

# game/data/world_romance/nyx/rom_nyx_love.rpy:43
translate ru rom_nyx_love_1_1da137f4:

    # NYX @ angry "Don't be so-"
    NYX @ angry "Не будь таким-"

# game/data/world_romance/nyx/rom_nyx_love.rpy:44
translate ru rom_nyx_love_1_577a1c71:

    # NYX @ think "You know what? Forget it, I will see you at the {i}Iron Unicorn{/i} this Evening."
    NYX @ think "Знаешь что? Забудь, увидимся в {i}Железном Единороге{/i} сегодня вечером."

# game/data/world_romance/nyx/rom_nyx_love.rpy:45
translate ru rom_nyx_love_1_5dfd0491:

    # MC @ smile "I shall see you then."
    MC @ smile "Тогда до встречи."

# game/data/world_romance/nyx/rom_nyx_love.rpy:55
translate ru rom_nyx_love_1_1df973fb:

    # "Nyx seemed surprised at the comment, but quickly returned to her usual self."
    "Никс, казалось удивилась комментарию, но быстро вернулась к своему обычному состоянию."

# game/data/world_romance/nyx/rom_nyx_love.rpy:56
translate ru rom_nyx_love_1_60c586d4:

    # NYX @ think "Y-You agree?"
    NYX @ think "Т-Ты согласен?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:58
translate ru rom_nyx_love_1_0e455826:

    # NYX @ sad "Right, well, yes ... It's for the best."
    NYX @ sad "Точно, ну, да... Так будет лучше."

# game/data/world_romance/nyx/rom_nyx_love.rpy:59
translate ru rom_nyx_love_1_c42c7fdf:

    # MC @ talk "Are you alright?"
    MC @ talk "Ты в порядке?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:60
translate ru rom_nyx_love_1_540f65c6:

    # NYX @ sad "I'm fine, now, if that's all you came to say you can go."
    NYX @ sad "Теперь я в порядке, если ты только за этим пришёл, можешь идти."

# game/data/world_romance/nyx/rom_nyx_love.rpy:61
translate ru rom_nyx_love_1_23893bea:

    # NYX @ think "And the two of us can forget this little 'incident' ever happened..."
    NYX @ think "И мы оба можем забыть, что этот маленький 'инцидент' когда-либо случался..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:78
translate ru rom_nyx_love_unicorn_date_4423f9a9:

    # "I looked around for any sign of Captain Nyx, to no-avail."
    "Я осмотрелся в поисках хоть какого-нибудь следа капитана Никс, но безрезультатно."

# game/data/world_romance/nyx/rom_nyx_love.rpy:79
translate ru rom_nyx_love_unicorn_date_7e2105d4:

    # MC "(Hm ...Maybe she really isn't coming.)"
    MC "(Хм... Может, она и правда не придёт.)"

# game/data/world_romance/nyx/rom_nyx_love.rpy:84
translate ru rom_nyx_love_unicorn_date_4652382c:

    # "In that moment I felt someone nudge up against me, and as I turned, I looked to see a robbed figure stood before me."
    "В тот момент я почувствовал, как кто-то толкнул меня, и обернувшись, я увидел перед собой фигуру в робе."

# game/data/world_romance/nyx/rom_nyx_love.rpy:86
translate ru rom_nyx_love_unicorn_date_ecb0d696:

    # "As she tilted her head up, I could see clearly through the hood it was Captain Nyx."
    "Когда она подняла голову, я сквозь капюшон ясно разглядел капитана Никс."

# game/data/world_romance/nyx/rom_nyx_love.rpy:87
translate ru rom_nyx_love_unicorn_date_11b28b5c:

    # MC @ smile "Ah! Captain-"
    MC @ smile "Ах! Капитан-"

# game/data/world_romance/nyx/rom_nyx_love.rpy:88
translate ru rom_nyx_love_unicorn_date_ca71b39d:

    # NYX @ angry "Shh! Not so loud!"
    NYX @ angry "Тшш! Не так громко!"

# game/data/world_romance/nyx/rom_nyx_love.rpy:89
translate ru rom_nyx_love_unicorn_date_304aa174:

    # MC @ smile "Ahh ... That explains the disguise then."
    MC @ smile "Ах... Это объясняет маскировку."

# game/data/world_romance/nyx/rom_nyx_love.rpy:90
translate ru rom_nyx_love_unicorn_date_ff069f4c:

    # "Nyx sighed uneasily, looking around the tavern for signs of anyone she recognized."
    "Никс беспокойно вздохнула, оглядывая таверну в поисках знакомых лиц."

# game/data/world_romance/nyx/rom_nyx_love.rpy:91
translate ru rom_nyx_love_unicorn_date_195c857b:

    # NYX @ think "Why did you choose to bring me here?"
    NYX @ think "Зачем ты решил привести меня именно сюда?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:92
translate ru rom_nyx_love_unicorn_date_a37cf216:

    # NYX @ think "There are too many people."
    NYX @ think "Здесь слишком много людей."

# game/data/world_romance/nyx/rom_nyx_love.rpy:93
translate ru rom_nyx_love_unicorn_date_5ef67c6d:

    # MC @ talk "Relax, Nyx."
    MC @ talk "Расслабься, Никс."

# game/data/world_romance/nyx/rom_nyx_love.rpy:94
translate ru rom_nyx_love_unicorn_date_226f3248:

    # MC @ talk "We're here to have some fun, remember?"
    MC @ talk "Мы здесь, чтобы повеселиться, помнишь?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:95
translate ru rom_nyx_love_unicorn_date_627bcae2:

    # NYX @ talk "Right, yes ...'fun.'"
    NYX @ talk "Да, верно... 'повеселиться'."

# game/data/world_romance/nyx/rom_nyx_love.rpy:96
translate ru rom_nyx_love_unicorn_date_0bf6acba:

    # MC @ talk "What are you drinking?"
    MC @ talk "Что ты будешь пить?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:97
translate ru rom_nyx_love_unicorn_date_80b0281b:

    # NYX @ talk "Ale."
    NYX @ talk "Эль."

# game/data/world_romance/nyx/rom_nyx_love.rpy:98
translate ru rom_nyx_love_unicorn_date_9b9e3f77:

    # MC @ talk "Two ales, coming up..."
    MC @ talk "Два эля, сейчас будет..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:108
translate ru rom_nyx_love_unicorn_date_2f6662c7:

    # "Nyx took a sip of the ale in her cup and smiled."
    "Никс отхлебнула эль из своей кружки и улыбнулась."

# game/data/world_romance/nyx/rom_nyx_love.rpy:109
translate ru rom_nyx_love_unicorn_date_a5cc2a4c:

    # NYX @ laugh "Have to admit, I can't remember the last time I drank this much..."
    NYX @ laugh "Признаюсь, не помню когда в последний раз пила столько..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:110
translate ru rom_nyx_love_unicorn_date_6edc882f:

    # MC @ smile "Are you trying to tell me the great Captain Nyx can't handle her drink?"
    MC @ smile "Ты хочешь сказать, что великая капитан Никс не справляется с выпивкой?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:112
translate ru rom_nyx_love_unicorn_date_d0135504:

    # "Nyx seemed flustered at my comment."
    "Никс смутилась от моего комментария."

# game/data/world_romance/nyx/rom_nyx_love.rpy:113
translate ru rom_nyx_love_unicorn_date_a44e6481:

    # NYX @ blush "I enjoy a glass of wine sometimes alone in my chambers..."
    NYX @ blush "Иногда я наслаждаюсь бокалом вина в одиночестве в своих покоях..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:115
translate ru rom_nyx_love_unicorn_date_ef5d2b6b:

    # NYX @ talk "If any of the men actually saw me drunk and in disarray, they'd-"
    NYX @ talk "Если бы кто-то из мужчин увидел меня пьяной и растрёпанной, они бы..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:116
translate ru rom_nyx_love_unicorn_date_50f65b83:

    # MC @ talk "Nyx, don't you think that perhaps you're holding yourself to an unreasonable standard?"
    MC @ talk "Никс, не думаешь ли ты, что возможно предъявляешь к себе неразумные требования?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:117
translate ru rom_nyx_love_unicorn_date_1acdd7a2:

    # MC @ talk "The men would have seen their own commanders drunk at least a thousand times."
    MC @ talk "Мужчины видели своих собственных командиров пьяными как минимум тысячу раз."

# game/data/world_romance/nyx/rom_nyx_love.rpy:118
translate ru rom_nyx_love_unicorn_date_b586922b:

    # NYX @ angry "Their {i}male{/i} commanders."
    NYX @ angry "Своих {i}мужских{/i} командиров."

# game/data/world_romance/nyx/rom_nyx_love.rpy:119
translate ru rom_nyx_love_unicorn_date_1203310c:

    # NYX @ angry "For them, such a thing is fine, but for me? One of the first female Captains? My enemies would just use it against me..."
    NYX @ angry "Для них это нормально, но для меня? Одной из первых женщин-капитанов? Мои враги просто используют это против меня..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:120
translate ru rom_nyx_love_unicorn_date_6cb749a7:

    # "Nyx paused for a moment, looking around uneasily for anyone she might recognise."
    "Никс на мгновение замолчала, беспокойно оглядываясь в поисках знакомых лиц."

# game/data/world_romance/nyx/rom_nyx_love.rpy:121
translate ru rom_nyx_love_unicorn_date_a89586ab:

    # MC @ sad "...It must get tiresome, being paranoid all the time."
    MC @ sad "...Должно быть, это утомительно — постоянно быть параноиком."

# game/data/world_romance/nyx/rom_nyx_love.rpy:122
translate ru rom_nyx_love_unicorn_date_1fefa8a1:

    # MC @ think "Always having to keep your guard up like that."
    MC @ think "Всегда приходится быть настороже."

# game/data/world_romance/nyx/rom_nyx_love.rpy:123
translate ru rom_nyx_love_unicorn_date_295efc33:

    # NYX @ talk "Mmm, it's difficult."
    NYX @ talk "Ммм, это сложно."

# game/data/world_romance/nyx/rom_nyx_love.rpy:124
translate ru rom_nyx_love_unicorn_date_f819b706:

    # MC @ talk "...And lonely."
    MC @ talk "...И одиноко."

# game/data/world_romance/nyx/rom_nyx_love.rpy:125
translate ru rom_nyx_love_unicorn_date_fbb838ed:

    # NYX @ sad "..."
    NYX @ sad "..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:126
translate ru rom_nyx_love_unicorn_date_a481c864:

    # NYX @ talk "Enough dwelling on me, tell me about you."
    NYX @ talk "Хватит размышлять обо мне, расскажи о себе."

# game/data/world_romance/nyx/rom_nyx_love.rpy:127
translate ru rom_nyx_love_unicorn_date_80623b65:

    # MC @ talk "Me?"
    MC @ talk "Обо мне?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:128
translate ru rom_nyx_love_unicorn_date_16fe6311:

    # NYX @ talk "Yes, {i}you.{/i}"
    NYX @ talk "Да, {i}о тебе.{/i}"

# game/data/world_romance/nyx/rom_nyx_love.rpy:129
translate ru rom_nyx_love_unicorn_date_bef30c74:

    # NYX @ talk "Not only are you a curiosity given your 'gift,' you've successfully dragged me out here on a night out."
    NYX @ talk "Ты не только диковинка со своим 'даром', но и успешно вытащил меня сюда на вечернюю прогулку."

# game/data/world_romance/nyx/rom_nyx_love.rpy:130
translate ru rom_nyx_love_unicorn_date_7447bcbc:

    # NYX @ talk "Can't a girl at least be a little curious?"
    NYX @ talk "Разве девушка не может быть хоть немного любопытной?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:131
translate ru rom_nyx_love_unicorn_date_dd6427db:

    # MC @ smile "You weren't curious before."
    MC @ smile "Раньше тебе не было любопытно."

# game/data/world_romance/nyx/rom_nyx_love.rpy:132
translate ru rom_nyx_love_unicorn_date_d525b156:

    # NYX @ talk "That was business, this is supposed to be leisure ... Now, I'm curious."
    NYX @ talk "То был бизнес, а это предполагается как отдых... Теперь, мне любопытно."

# game/data/world_romance/nyx/rom_nyx_love.rpy:133
translate ru rom_nyx_love_unicorn_date_57bc53a9:

    # MC @ talk "What do you want to know?"
    MC @ talk "Что ты хочешь узнать?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:134
translate ru rom_nyx_love_unicorn_date_0393ffd2:

    # NYX @ talk "First, tell me a little about yourself."
    NYX @ talk "Сначала, расскажи немного о себе."

# game/data/world_romance/nyx/rom_nyx_love.rpy:135
translate ru rom_nyx_love_unicorn_date_62a82ca4:

    # NYX @ talk "I take it you didn't plan to go into the Scouts, hardly anyone ever does ... So, what did you want to be?"
    NYX @ talk "Полагаю, ты не планировал идти в Разведчики, почти никто никогда не планирует... Так кем ты хотел стать?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:138
translate ru rom_nyx_love_unicorn_date_ed6973b7:

    # NYX @ shock "Really?"
    NYX @ shock "Правда?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:139
translate ru rom_nyx_love_unicorn_date_e58b3b37:

    # NYX @ talk "That's... surprising."
    NYX @ talk "Это... удивительно."

# game/data/world_romance/nyx/rom_nyx_love.rpy:140
translate ru rom_nyx_love_unicorn_date_9abd2c86:

    # MC @ talk "How so?"
    MC @ talk "В каком смысле?"

# game/data/world_romance/nyx/rom_nyx_love.rpy:141
translate ru rom_nyx_love_unicorn_date_61bfee97:

    # NYX @ talk "You carry yourself as an Adventurer so well, I just thought you'd have wanted a more ..."
    NYX @ talk "Ты так хорошо держишься как Искатель приключений, я просто думала, что ты хотел бы более..."

# game/data/world_romance/nyx/rom_nyx_love.rpy:142
translate ru rom_nyx_love_unicorn_date_8e8a0efd:

    # NYX @ talk "Never mind, it's not like I can hardly blame you for wanting a job like that."
    NYX @ talk "Неважно, вряд ли я могу винить тебя за желание иметь такую работу."

# game/data/world_romance/nyx/rom_nyx_love.rpy:143
translate ru rom_nyx_love_unicorn_date_6da35f09:

    # MC @ talk "I figured you'd be disappointed by that answer."
    MC @ talk "Я так и думал, что ты разочаруешься таким ответом."

# game/data/world_romance/nyx/rom_nyx_love.rpy:144
translate ru rom_nyx_love_unicorn_date_51752f04:

    # NYX @ laugh "Not at all, if anything, we could do with more {i}effective{/i} people running administration."
    NYX @ laugh "Вовсе нет, если что, нам бы не помешало больше {i}эффективных{/i} людей в управлении."

# game/data/world_romance/nyx/rom_nyx_love.rpy:145
