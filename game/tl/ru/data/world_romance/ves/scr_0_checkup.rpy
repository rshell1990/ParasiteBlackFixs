# game/data/world_romance/ves/scr_0_checkup.rpy:2
translate ru rom_Ves_0_checkup_48262153:

    # "Ves raised a curious eyebrow at my comment."
    "Вес подняла любопытную бровь в ответ на мои слова."

# game/data/world_romance/ves/scr_0_checkup.rpy:3
translate ru rom_Ves_0_checkup_469dc015:

    # VES @ talk "... I’m fine."
    VES @ talk "... Я в порядке."

# game/data/world_romance/ves/scr_0_checkup.rpy:4
translate ru rom_Ves_0_checkup_ed5670c3:

    # VES @ talk "Why do you ask, human?”"
    VES @ talk "Почему ты спрашиваешь, человек?"

# game/data/world_romance/ves/scr_0_checkup.rpy:5
translate ru rom_Ves_0_checkup_a42cd6a3:

    # MC @ talk "Just out of concern, you’re out here all alone."
    MC @ talk "Просто из беспокойства, ты здесь совсем одна."

# game/data/world_romance/ves/scr_0_checkup.rpy:6
translate ru rom_Ves_0_checkup_c1e12f59:

    # MC @ talk "It’s not safe."
    MC @ talk "Это небезопасно."

# game/data/world_romance/ves/scr_0_checkup.rpy:7
translate ru rom_Ves_0_checkup_b340494c:

    # VES @ talk "... Where is safe for an orc in this land?"
    VES @ talk "... Где в этих землях безопасно для орка?"

# game/data/world_romance/ves/scr_0_checkup.rpy:8
translate ru rom_Ves_0_checkup_45eff587:

    # VES @ talk "I have survived this long... I will find my kin eventually and leave this empty place."
    VES @ talk "Я прожила так долго... Я найду своих сородичей и покину это пустое место."

# game/data/world_romance/ves/scr_0_checkup.rpy:9
translate ru rom_Ves_0_checkup_ed4c078c:

    # MC @ talk "And what if you don’t find them?"
    MC @ talk "А что, если не найдешь их?"

# game/data/world_romance/ves/scr_0_checkup.rpy:10
translate ru rom_Ves_0_checkup_744ae15a:

    # VES @ talk "I will."
    VES @ talk "Найду."

# game/data/world_romance/ves/scr_0_checkup.rpy:11
translate ru rom_Ves_0_checkup_62e7a458:

    # MC @ talk "But what if you {i}don’t?{/i}"
    MC @ talk "Но что, если ты {i}не найдешь?{/i}"

# game/data/world_romance/ves/scr_0_checkup.rpy:12
translate ru rom_Ves_0_checkup_ba851fe0:

    # VES @ talk "{i}Tsch...{/i} Why do you care what happens to an orc anyway?"
    VES @ talk "{i}Тсч...{/i} Почему тебя вообще волнует, что случится с орком?"

# game/data/world_romance/ves/scr_0_checkup.rpy:13
translate ru rom_Ves_0_checkup_7d0e199f:

    # VES @ talk "Humans and orcs do not mix."
    VES @ talk "Люди и орки несовместимы."

# game/data/world_romance/ves/scr_0_checkup.rpy:14
translate ru rom_Ves_0_checkup_5c4216b3:

    # MC @ talk "You weren’t complaining when we saved you the other day."
    MC @ talk "Ты не жаловалась, когда мы спасли тебя на днях."

# game/data/world_romance/ves/scr_0_checkup.rpy:15
translate ru rom_Ves_0_checkup_129b2aec:

    # "Ves growled menacingly at the comment."
    "Вес угрожающе зарычала в ответ на это замечание."

# game/data/world_romance/ves/scr_0_checkup.rpy:16
translate ru rom_Ves_0_checkup_26e75fc3:

    # VES @ talk "First off, you didn’t {i}save{/i} me."
    VES @ talk "Во-первых, вы меня не {i}спасали{/i}."

# game/data/world_romance/ves/scr_0_checkup.rpy:17
translate ru rom_Ves_0_checkup_40079bd4:

    # VES @ talk "I could have handled that just fine on my own."
    VES @ talk "Я бы и сама прекрасно справилась."

# game/data/world_romance/ves/scr_0_checkup.rpy:18
translate ru rom_Ves_0_checkup_c6813cab:

    # MC @ talk "... I didn’t come here to fight."
    MC @ talk "... Я пришёл сюда не для драки."

# game/data/world_romance/ves/scr_0_checkup.rpy:19
translate ru rom_Ves_0_checkup_2592e15a:

    # VES @ talk "Then why did you come here?"
    VES @ talk "Тогда зачем ты пришёл?"

# game/data/world_romance/ves/scr_0_checkup.rpy:20
translate ru rom_Ves_0_checkup_cefa8f2f:

    # "Ves pointed her axe towards me."
    "Вес направила свой топор в мою сторону."

# game/data/world_romance/ves/scr_0_checkup.rpy:21
translate ru rom_Ves_0_checkup_f49d81a0:

    # VES @ talk "You may not be fully human..."
    VES @ talk "Возможно, ты не совсем человек..."

# game/data/world_romance/ves/scr_0_checkup.rpy:22
translate ru rom_Ves_0_checkup_d48f8d2a:

    # VES @ talk "But I’ve come to know the ways of man."
    VES @ talk "Но я познала человеческие обычаи."

# game/data/world_romance/ves/scr_0_checkup.rpy:23
translate ru rom_Ves_0_checkup_35d87cd4:

    # VES @ talk "You’ll be no different to the rest of them."
    VES @ talk "Ты не будешь отличаться от остальных."

# game/data/world_romance/ves/scr_0_checkup.rpy:24
translate ru rom_Ves_0_checkup_32a697de:

    # MC @ talk "... Do you need some hel— "
    MC @ talk "... Тебе нужна помо—"

# game/data/world_romance/ves/scr_0_checkup.rpy:25
translate ru rom_Ves_0_checkup_56c871d8:

    # VES @ talk "No."
    VES @ talk "Нет."

# game/data/world_romance/ves/scr_0_checkup.rpy:26
translate ru rom_Ves_0_checkup_2be4cc67:

    # "Rising from her feet, Ves stretched and sauntered out the tent with her axe in hand, barging past my shoulder as she remarked."
    "Поднявшись на ноги, Вес потянулась и неспешно вышла из палатки с топором в руке, пройдя мимо задев мое плечо, и отметила."

# game/data/world_romance/ves/scr_0_checkup.rpy:27
translate ru rom_Ves_0_checkup_c025746f:

    # VES @ talk "You’ve seen that I am well... Now {i}leave.{/i}"
    VES @ talk "Ты видел, что со мной всё в порядке... Теперь {i}уходи.{/i}"

# game/data/world_romance/ves/scr_0_checkup.rpy:30
translate ru rom_Ves_0_checkup_5664a9d7:

    # "With that, I watched as Ves made her way alone across the dunes of the Valley of Death, slowly disappearing into the distant blistering waves of heat."
    "После этого, я наблюдал как Вес в одиночестве направилась через дюны Долины Смерти, медленно исчезая в далёких знойных волнах жары."

# game/data/world_romance/ves/scr_0_checkup.rpy:31
translate ru rom_Ves_0_checkup_f0a51a0c:

    # "I called after her, asking where she was going, and she turned, still walking backwards as she cried out ‘to hunt!’ And like that, she was gone... Leaving me alone in the swirling hot sands of her campsite."
    "Я окликнул её, спросив куда она направляется, и она обернулась, всё ещё идя спиной вперёд, и крикнула 'на охоту!' И вот так, она исчезла... Оставив меня одного в клубящихся горячих песках её лагеря."

# game/data/world_romance/ves/scr_0_checkup.rpy:32
translate ru rom_Ves_0_checkup_1343e993:

    # MC @ talk "(... Well... That could have gone better.) "
    MC @ talk "(... Что ж... Это могло пойти и лучше.)"

# game/data/world_romance/ves/scr_0_checkup.rpy:33
translate ru rom_Ves_0_checkup_fdc78933:

    # MC @ talk "(Maybe I should check on her another time?)"
    MC @ talk "(Может, мне стоит проверить как она, в другой раз?)"

