
# game/engine/gallery/babazhul_label.rpy:5
translate ru nov_soothsayer_gallery_f7cac0c8:

    # BABAZHUL @ talk "So be it..."
    BABAZHUL @ talk "Так тому и быть..."

# game/engine/gallery/babazhul_label.rpy:7
translate ru nov_soothsayer_gallery_e2fab751:

    # BABAZHUL @ talk "But remember child, the past has already come and gone, only the present is a gift."
    BABAZHUL @ talk "Но помни, дитя, прошлое уже пришло и ушло, только настоящее — это дар."

# game/engine/gallery/babazhul_label.rpy:8
translate ru nov_soothsayer_gallery_7ad6ec43:

    # BABAZHUL @ talk "Do not linger too long on the shadows that have already vanished."
    BABAZHUL @ talk "Не задерживайся слишком долго на тенях, что уже исчезли."

# game/engine/gallery/babazhul_label.rpy:9
translate ru nov_soothsayer_gallery_57fdbdbd:

    # BABAZHUL @ talk "How easy it is to become lost to their sweetness..."
    BABAZHUL @ talk "Как легко потеряться в их сладости..."

# game/engine/gallery/babazhul_label.rpy:55
translate ru nov_soothsayer_gallery_4424f154:

    # BABAZHUL @ talk "You do not possess enough coin, child, return when you do."
    BABAZHUL @ talk "У тебя недостаточно монет, дитя, возвращайся когда будут."

