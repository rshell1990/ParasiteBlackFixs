    # ARWEN @ talk "What do you want to know?"
    ARWEN @ talk "Ne bilmek istiyorsun?"

# game/data/characters/arwen/scr_dialogue.rpy:11
translate tr dialogue_arwen_othergirls_menu_f72c231a:

    # ARWEN @ talk "Well... Now you're speaking a girls favourite language!"
    ARWEN @ talk "Pekala... Şimdi bir kızın en sevdiği dili konuşuyorsun!"

# game/data/characters/arwen/scr_dialogue.rpy:13
translate tr dialogue_arwen_othergirls_menu_ab602309:

    # ARWEN @ talk "Was there someone specific you wanted to ask about?"
    ARWEN @ talk "Hakkında sormak istediğin belirli biri var mıydı?"

# game/data/characters/arwen/scr_dialogue.rpy:16
translate tr dialogue_arwen_othergirls_menu_paid_5c4b33c4:

    # ARWEN @ angry "Hm? Oh, {i}her{/i} I'd avoid her if I was you."
    ARWEN @ angry "Hm? Ah, {i}onu{/i} diyorsan, yerinde olsam ondan uzak dururdum."

# game/data/characters/arwen/scr_dialogue.rpy:17
translate tr dialogue_arwen_othergirls_menu_paid_d42b7565:

    # ARWEN @ angry "Overpriced to put it mildly, you'd think she was a virgin princess with how highly she views herself."
    ARWEN @ angry "Nazikçe söylemek gerekirse aşırı pahalı, kendine ne kadar yüksek değer biçtiğine bakılırsa bakire bir prenses olduğunu sanırsın."

# game/data/characters/arwen/scr_dialogue.rpy:18
translate tr dialogue_arwen_othergirls_menu_paid_1950d15a:

    # ARWEN @ blush "Don't worry though, I'll show you what a {i}real{/i} woman can do."
    ARWEN @ blush "Endişelenme ama, sana {i}gerçek{/i} bir kadının neler yapabileceğini göstereceğim."

# game/data/characters/arwen/scr_dialogue.rpy:21
translate tr dialogue_arwen_othergirls_menu_paid_77c1d01c:

    # ARWEN @ think "Hmm, nice enough girl."
    ARWEN @ think "Hmm, yeterince hoş bir kız."

# game/data/characters/arwen/scr_dialogue.rpy:22
translate tr dialogue_arwen_othergirls_menu_paid_879dd5c5:

    # ARWEN @ talk "But I think she's a little {i}too{/i} desperate to work in here."
    ARWEN @ talk "Ama sanırım burada çalışmak için biraz {i}fazla{/i} çaresiz."

# game/data/characters/arwen/scr_dialogue.rpy:23
translate tr dialogue_arwen_othergirls_menu_paid_35cb4a19:

    # ARWEN @ talk "As far as I know, they let her stay and serve clients outside for a reduced rate, but I doubt she'll get through the door."
    ARWEN @ talk "Bildiğim kadarıyla, kalmasına ve dışarıda müşterilere indirimli ücretle hizmet etmesine izin verdiler, ama kapıdan geçeceğinden şüpheliyim."

# game/data/characters/arwen/scr_dialogue.rpy:24
translate tr dialogue_arwen_othergirls_menu_paid_da22f4ce:

    # MC @ talk "Why's that?"
    MC @ talk "Nedenmiş o?"

# game/data/characters/arwen/scr_dialogue.rpy:25
translate tr dialogue_arwen_othergirls_menu_paid_8e2a16c2:

    # ARWEN @ talk "Look around you, we're not the {i}Black Diamond,{/i} we general serve adventurers and merchants with coin to burn."
    ARWEN @ talk "Etrafına bak, biz {i}Kara Elmas{/i} değiliz, genelde yakacak parası olan maceracılara ve tüccarlara hizmet veririz."

# game/data/characters/arwen/scr_dialogue.rpy:26
translate tr dialogue_arwen_othergirls_menu_paid_e4fcf857:

    # ARWEN @ talk "And she's out there letting the city guard take put it in her ass behind a wall... Hardly a good fit."
    ARWEN @ talk "Ve o dışarıda şehir muhafızlarının duvarın arkasında kıçına sokmasına izin veriyor... Pek uygun değil."

# game/data/characters/arwen/scr_dialogue.rpy:27
translate tr dialogue_arwen_othergirls_menu_paid_33eafac5:

    # MC @ talk "That seems rather harsh..."
    MC @ talk "Bu oldukça sert görünüyor..."

# game/data/characters/arwen/scr_dialogue.rpy:28
translate tr dialogue_arwen_othergirls_menu_paid_8c61c9e1:

    # ARWEN @ talk "It's just business darling... it's always cut-throat, no matter the trade."
    ARWEN @ talk "Bu sadece iş sevgilim... her zaman acımasızdır, ticaret ne olursa olsun."

# game/data/characters/arwen/scr_dialogue.rpy:31
translate tr dialogue_arwen_othergirls_menu_paid_480f5c90:

    # ARWEN @ talk "Alright then, was there something else?"
    ARWEN @ talk "Pekala, başka bir şey var mıydı?"

# game/data/characters/arwen/scr_dialogue.rpy:34
translate tr dialogue_arwen_othergirls_menu_paid_7417b5c7:

    # ARWEN @ talk "Alright then, let's hear it."
    ARWEN @ talk "Pekala, duyalım."

