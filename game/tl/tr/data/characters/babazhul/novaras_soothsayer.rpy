# game/data/characters/babazhul/novaras_soothsayer.rpy:49
translate tr nov_soothsayer_firstmeet_90717a1f:

    # "Entering into the darkened room of the soothsayer I looked around."
    "Kahinin karanlık odasına girerek etrafa baktım."

# game/data/characters/babazhul/novaras_soothsayer.rpy:50
translate tr nov_soothsayer_firstmeet_7bd2c3f6:

    # "The room was dimly lit only by pale candle light, with strange trinkets from faraway lands adorning every corner of the room, strange skulls and books in ancient tongues long since dead."
    "Oda sadece solgun mum ışığıyla loş bir şekilde aydınlatılmıştı, uzak diyarlardan garip süs eşyaları odanın her köşesini süslüyordu, garip kafatasları ve çoktan ölmüş kadim dillerde kitaplar."

# game/data/characters/babazhul/novaras_soothsayer.rpy:51
translate tr nov_soothsayer_firstmeet_406bc049:

    # "Here and there was a stuffed bird or some scroll with strange markings on it littered around on the floor amongst the pile of many books."
    "Yer yer doldurulmuş bir kuş ya da üzerinde garip işaretler olan bir parşömen, birçok kitap yığınının arasında zemine saçılmıştı."

# game/data/characters/babazhul/novaras_soothsayer.rpy:52
translate tr nov_soothsayer_firstmeet_5d595e11:

    # "The old hag was sat down at her seat, hunched over her desk looming over a crystal ball as she looked towards me expectantly."
    "Yaşlı kocakarı koltuğuna oturmuştu, masasının üzerine kamburlaşmış, kristal bir kürenin üzerinde yükseliyor, bana beklentiyle bakıyordu."

# game/data/characters/babazhul/novaras_soothsayer.rpy:54
translate tr nov_soothsayer_firstmeet_f1746c4b:

    # BABAZHUL "Greetings, child of tooth and claw."
    BABAZHUL "Selamlar, diş ve pençenin çocuğu."

# game/data/characters/babazhul/novaras_soothsayer.rpy:55
translate tr nov_soothsayer_firstmeet_783baad9:

    # BABAZHUL "How may Babazhul help you?"
    BABAZHUL "Babazhul sana nasıl yardım edebilir?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:56
translate tr nov_soothsayer_firstmeet_44f8b91f:

    # MC "Hm? Child of what?"
    MC "Hm? Neyin çocuğu?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:57
translate tr nov_soothsayer_firstmeet_5ce13e03:

    # MC "What are you talking about?"
    MC "Neden bahsediyorsun?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:62
translate tr nov_soothsayer_firstmeet_70e666cf:

    # BABAZHUL "{i}The old gods stir with the new, the great games' next chapter shall soon begin.{/i}"
    BABAZHUL "{i}Eski tanrılar yeniyle kıpırdanıyor, büyük oyunların sonraki bölümü yakında başlayacak.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:63
translate tr nov_soothsayer_firstmeet_909f2c0d:

    # BABAZHUL "{i}A great warrior shall join you, the great tooth and claw, a forgotten lord from a time lost beyond the stars.{/i}"
    BABAZHUL "{i}Büyük bir savaşçı sana katılacak, büyük diş ve pençe, yıldızların ötesinde kaybolmuş bir zamandan unutulmuş bir lord.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:64
translate tr nov_soothsayer_firstmeet_92a43a18:

    # BABAZHUL "{i}To battle the dreaming king, whose restless fury shall scorch these lands.{/i}"
    BABAZHUL "{i}Huzursuz öfkesi bu toprakları kavuracak olan rüya gören kralla savaşmak için.{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:65
translate tr nov_soothsayer_firstmeet_127488ac:

    # MC "What the~"
    MC "Bu da ne~"

# game/data/characters/babazhul/novaras_soothsayer.rpy:66
translate tr nov_soothsayer_firstmeet_086e21f9:

    # MC "Gods? A Dreaming king? Great warriors?"
    MC "Tanrılar mı? Rüya gören bir kral mı? Büyük savaşçılar mı?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:69
translate tr nov_soothsayer_firstmeet_8e3236f6:

    # "The soothsayer went silent for a moment, before continuing in her raspy voice:"
    "Kahin bir an sessizleşti, sonra boğuk sesiyle devam etti:"

# game/data/characters/babazhul/novaras_soothsayer.rpy:70
translate tr nov_soothsayer_firstmeet_ccab7ebe:

    # BABAZHUL "In time ... All will be clear, [player_name!t]."
    BABAZHUL "Zamanla... Her şey netleşecek, [player_name!t]."

# game/data/characters/babazhul/novaras_soothsayer.rpy:71
translate tr nov_soothsayer_firstmeet_9cbf7f9a:

    # MC "...How did you know my-"
    MC "...Adımı nasıl bildin-"

# game/data/characters/babazhul/novaras_soothsayer.rpy:72
translate tr nov_soothsayer_firstmeet_f1768875:

    # BABAZHUL "Hahahaha!"
    BABAZHUL "Hahahaha!"

# game/data/characters/babazhul/novaras_soothsayer.rpy:75
translate tr nov_soothsayer_firstmeet_725e3592:

    # BABAZHUL @ talk "{i}I knew you would come,{/i} [player_name!t]."
    BABAZHUL @ talk "{i}Geleceğini biliyordum,{/i} [player_name!t]."

# game/data/characters/babazhul/novaras_soothsayer.rpy:76
translate tr nov_soothsayer_firstmeet_3d82d3ee:

    # MC "How did you know my name?"
    MC "Adımı nereden biliyorsun?"

# game/data/characters/babazhul/novaras_soothsayer.rpy:77
translate tr nov_soothsayer_firstmeet_f14bc448:

    # BABAZHUL @ talk "Babazhul knows many names, many things that have passed and are yet to pass."
    BABAZHUL @ talk "Babazhul birçok isim bilir, geçmiş ve henüz geçmemiş birçok şeyi."

# game/data/characters/babazhul/novaras_soothsayer.rpy:80
translate tr nov_soothsayer_firstmeet_ea08ba0d:

    # BABAZHUL @ talk "Now tell me child of tooth and claw, do you seek your past... {i}or your future?{/i}"
    BABAZHUL @ talk "Şimdi söyle bana diş ve pençenin çocuğu, geçmişini mi arıyorsun... {i}yoksa geleceğini mi?{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:81
translate tr nov_soothsayer_firstmeet_c58e7a45:

    # BABAZHUL @ talk "For but five gold, it can be yours..."
    BABAZHUL @ talk "Sadece beş altına, senin olabilir..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:91
translate tr nov_soothsayer_talk_c96029cf:

    # BABAZHUL @ talk "Welcome back, child of tooth and claw."
    BABAZHUL @ talk "Tekrar hoş geldin, diş ve pençenin çocuğu."

# game/data/characters/babazhul/novaras_soothsayer.rpy:92
translate tr nov_soothsayer_talk_ea89362c:

    # BABAZHUL @ talk "Make your choice."
    BABAZHUL @ talk "Seçimini yap."

# game/data/characters/babazhul/novaras_soothsayer.rpy:102
translate tr nov_soothsayer_future_b2637f25:

    # BABAZHUL @ talk "So be it."
    BABAZHUL @ talk "Öyle olsun."

# game/data/characters/babazhul/novaras_soothsayer.rpy:105
translate tr nov_soothsayer_future_c6eccf04:

    # "Babazhul hands lightly touched over her crystal ball, which brightly began to glow and illuminate as she stared deeply into it with her half blind eyes."
    "Babazhul'un elleri kristal küresine hafifçe dokundu, yarı kör gözleriyle derinlemesine bakarken küre parlak bir şekilde parlamaya ve aydınlanmaya başladı."

# game/data/characters/babazhul/novaras_soothsayer.rpy:117
translate tr nov_soothsayer_future_3add1f07:

    # BABAZHUL @ talk "In time, perhaps, there might be clarity..."
    BABAZHUL @ talk "Zamanla, belki, bir netlik olabilir..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:118
translate tr nov_soothsayer_future_fbf25a5c:

    # BABAZHUL @ talk "For now, I can see no more."
    BABAZHUL @ talk "Şimdilik, daha fazlasını göremiyorum."

# game/data/characters/babazhul/novaras_soothsayer.rpy:122
translate tr nov_soothsayer_future_4424f154:

    # BABAZHUL @ talk "You do not possess enough coin, child, return when you do."
    BABAZHUL @ talk "Yeterli paran yok, çocuk, olduğunda geri dön."

# game/data/characters/babazhul/novaras_soothsayer.rpy:128
translate tr nov_soothsayer_goodbye_91ee6e03:

    # BABAZHUL @ talk "{i}*Laughs*{/i} Of course you will return... I've already foreseen it."
    BABAZHUL @ talk "{i}*Güler*{/i} Elbette geri döneceksin... Bunu zaten öngördüm."

# game/data/characters/babazhul/novaras_soothsayer.rpy:136
translate tr nov_soothsayer_future0_bd41ac2b:

    # BABAZHUL @ talk "I see a great shadow following you, a warrior of a thousand worlds."
    BABAZHUL @ talk "Seni takip eden büyük bir gölge görüyorum, bin dünyanın savaşçısı."

# game/data/characters/babazhul/novaras_soothsayer.rpy:137
translate tr nov_soothsayer_future0_62ae2cf6:

    # BABAZHUL @ talk "Sitting on a throne of bones, so alone and so cold."
    BABAZHUL @ talk "Kemiklerden bir tahtta oturan, çok yalnız ve çok soğuk."

# game/data/characters/babazhul/novaras_soothsayer.rpy:138
translate tr nov_soothsayer_future0_1c0474f3:

    # BABAZHUL @ talk "He would sit forever... Enjoy the silence, if not for his master's call."
    BABAZHUL @ talk "Efendisinin çağrısı olmasa sonsuza dek oturacaktı... Sessizliğin tadını çıkar."

# game/data/characters/babazhul/novaras_soothsayer.rpy:146
translate tr nov_soothsayer_future1_c59e6106:

    # BABAZHUL @ talk "Hahaha! I see her fire, Princess raised by shadows and knives, born into a lie."
    BABAZHUL @ talk "Hahaha! Onun ateşini görüyorum, gölgeler ve bıçaklarla büyütülmüş Prenses, bir yalanın içine doğmuş."

# game/data/characters/babazhul/novaras_soothsayer.rpy:147
translate tr nov_soothsayer_future1_34e35823:

    # BABAZHUL @ talk "The great stars lay before her, and perhaps you at her side."
    BABAZHUL @ talk "Büyük yıldızlar onun önünde uzanıyor ve belki de sen onun yanında."

# game/data/characters/babazhul/novaras_soothsayer.rpy:148
translate tr nov_soothsayer_future1_36bd14f0:

    # BABAZHUL @ talk "Oh child of tooth and claw, we shall see if love can truly conquer all!"
    BABAZHUL @ talk "Ah diş ve pençenin çocuğu, aşkın gerçekten her şeyi fethedip fethedemeyeceğini göreceğiz!"

# game/data/characters/babazhul/novaras_soothsayer.rpy:156
translate tr nov_soothsayer_future2_d966afcc:

    # BABAZHUL @ talk "The imitation stalks these lands, a beautiful souless beast."
    BABAZHUL @ talk "Taklit bu topraklarda geziniyor, güzel bir ruhsuz canavar."

# game/data/characters/babazhul/novaras_soothsayer.rpy:157
translate tr nov_soothsayer_future2_beae5065:

    # BABAZHUL @ talk "Nothing but death awaits, yet how sweet will she be when she poisons your soul with honey."
    BABAZHUL @ talk "Ölümden başka bir şey beklemiyor, ama ruhunu bal ile zehirlediğinde ne kadar tatlı olacak."

# game/data/characters/babazhul/novaras_soothsayer.rpy:158
translate tr nov_soothsayer_future2_9bd746f0:

    # BABAZHUL @ talk "See past the lies and beware, beware child of tooth and claw:"
    BABAZHUL @ talk "Yalanların ötesini gör ve sakın, sakın diş ve pençenin çocuğu:"

# game/data/characters/babazhul/novaras_soothsayer.rpy:159
translate tr nov_soothsayer_future2_02815b56:

    # BABAZHUL @ talk "The beautiful souless beast may be your demise."
    BABAZHUL @ talk "Güzel ruhsuz canavar senin sonun olabilir."

# game/data/characters/babazhul/novaras_soothsayer.rpy:166
translate tr nov_soothsayer_future3_f914e12e:

    # BABAZHUL @ talk "My my, child! Such sweet fruits await! One in green, one in blue, one with scales, one so small, you could carry four! Hahaha!"
    BABAZHUL @ talk "Aman aman, çocuk! Ne tatlı meyveler bekliyor! Biri yeşil, biri mavi, biri pullu, biri çok küçük, dördünü taşıyabilirsin! Hahaha!"

# game/data/characters/babazhul/novaras_soothsayer.rpy:167
translate tr nov_soothsayer_future3_5a07672c:

    # BABAZHUL @ talk "Their love will guide you through the darkness to come, cling to it, embrace it, hold them dear and close."
    BABAZHUL @ talk "Onların sevgisi gelecek karanlıkta sana rehberlik edecek, ona sarıl, onu kucakla, onları sevgili ve yakın tut."

# game/data/characters/babazhul/novaras_soothsayer.rpy:168
translate tr nov_soothsayer_future3_f7410e2c:

    # BABAZHUL @ talk "For when the time comes, you must face the darkness alone..."
    BABAZHUL @ talk "Çünkü zamanı geldiğinde, karanlıkla tek başına yüzleşmelisin..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:176
translate tr nov_soothsayer_future4_37ac8a1d:

    # BABAZHUL @ talk "He sits at the helm of ultimate destruction, more ghost than man but he will return home."
    BABAZHUL @ talk "Nihai yıkımın dümeninde oturuyor, insandan çok hayalet ama eve dönecek."

# game/data/characters/babazhul/novaras_soothsayer.rpy:177
translate tr nov_soothsayer_future4_68e013f7:

    # BABAZHUL @ talk "Oh child of tooth and claw, to forever be reaching for the past is a terrible thing."
    BABAZHUL @ talk "Ah diş ve pençenin çocuğu, sonsuza dek geçmişe uzanmak korkunç bir şeydir."

# game/data/characters/babazhul/novaras_soothsayer.rpy:178
translate tr nov_soothsayer_future4_41a33087:

    # BABAZHUL @ talk "It may make monsters of us all..."
    BABAZHUL @ talk "Hepimizi canavar yapabilir..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:185
translate tr nov_soothsayer_future5_521823e0:

    # BABAZHUL @ talk "I see two brothers, stood on opposite cliffs."
    BABAZHUL @ talk "İki kardeş görüyorum, karşılıklı uçurumlarda duruyorlar."

# game/data/characters/babazhul/novaras_soothsayer.rpy:186
translate tr nov_soothsayer_future5_9eb10f6e:

    # BABAZHUL @ talk "A terrible storm rages, the black waves thrashing beneath their feet."
    BABAZHUL @ talk "Korkunç bir fırtına kasıp kavuruyor, kara dalgalar ayaklarının altında çarpıyor."

# game/data/characters/babazhul/novaras_soothsayer.rpy:187
translate tr nov_soothsayer_future5_60b3ce80:

    # BABAZHUL @ talk "Both weep... But the fire inside makes them scream."
    BABAZHUL @ talk "İkisi de ağlıyor... Ama içlerindeki ateş onları çığlık attırıyor."

# game/data/characters/babazhul/novaras_soothsayer.rpy:188
translate tr nov_soothsayer_future5_2126ec51:

    # BABAZHUL @ talk "How the ones we love cut so deep."
    BABAZHUL @ talk "Sevdiklerimiz nasıl da derin kesiyor."

# game/data/characters/babazhul/novaras_soothsayer.rpy:195
translate tr nov_soothsayer_future6_7454759e:

    # BABAZHUL @ talk "Grief... I feel his grief."
    BABAZHUL @ talk "Keder... Onun kederini hissediyorum."

# game/data/characters/babazhul/novaras_soothsayer.rpy:196
translate tr nov_soothsayer_future6_d647c32f:

    # BABAZHUL @ talk "It has made a monster of him, and it drives him to do terrible things."
    BABAZHUL @ talk "Onu bir canavar yaptı ve onu korkunç şeyler yapmaya sürüklüyor."

# game/data/characters/babazhul/novaras_soothsayer.rpy:197
translate tr nov_soothsayer_future6_7a7c1972:

    # BABAZHUL @ talk "But his fate is not yet sealed."
    BABAZHUL @ talk "Ama kaderi henüz mühürlenmedi."

# game/data/characters/babazhul/novaras_soothsayer.rpy:198
translate tr nov_soothsayer_future6_c96105ba:

    # BABAZHUL @ talk "What will become of him?"
    BABAZHUL @ talk "Ona ne olacak?"

