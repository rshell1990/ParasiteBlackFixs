translate tr luna_talk_fe2ebf70:

    # LUNA @ smile "Hello! May I help you with something?"
    LUNA @ smile "Merhaba! Size bir konuda yardım edebilir miyim?"

# game/data/characters/luna/dialogue_luna.rpy:25
translate tr luna_bye_e42febf0:

    # LUNA "See you around!"
    LUNA "Görüşürüz!"

# game/data/characters/luna/dialogue_luna.rpy:30
translate tr luna_talk_cantgothere_58ea8463:

    # LUNA "Hey! You can't just walk in there."
    LUNA "Hey! Oraya öylece giremezsin."

# game/data/characters/luna/dialogue_luna.rpy:35
translate tr luna_use_baths_03aa7676:

    # LUNA @ smile "Certainly!"
    LUNA @ smile "Elbette!"

# game/data/characters/luna/dialogue_luna.rpy:36
translate tr luna_use_baths_2f547f8a:

    # LUNA @ smile "For you and your companions that'll be two hundred and fifty coins."
    LUNA @ smile "Siz ve yoldaşlarınız için iki yüz elli altın."

# game/data/characters/luna/dialogue_luna.rpy:42
translate tr luna_use_baths_c0c26f2f:

    # LUNA @ talk "Okay then, should you make the decision, the {i}Princess' Dream{/i} is always ready to recieve guests."
    LUNA @ talk "Pekala, karar verirseniz, {i}Prensesin Rüyası{/i} misafirleri kabul etmeye her zaman hazırdır."

# game/data/characters/luna/dialogue_luna.rpy:48
translate tr luna_questions_9469500d:

    # LUNA @ talk "Hm? Questions?"
    LUNA @ talk "Hm? Sorular mı?"

# game/data/characters/luna/dialogue_luna.rpy:49
translate tr luna_questions_46ef7612:

    # LUNA @ talk "What do you want to know?"
    LUNA @ talk "Ne bilmek istiyorsun?"

# game/data/characters/luna/dialogue_luna.rpy:52
translate tr luna_questions_menu_71d4ef92:

    # LUNA @ talk "Ahh..."
    LUNA @ talk "Ah..."

# game/data/characters/luna/dialogue_luna.rpy:53
translate tr luna_questions_menu_64ef36ae:

    # LUNA @ talk "My husband was sea captain of a small merchant vessel."
    LUNA @ talk "Kocam küçük bir ticaret gemisinin deniz kaptanıydı."

# game/data/characters/luna/dialogue_luna.rpy:54
translate tr luna_questions_menu_2b407674:

    # LUNA @ talk "The coin was good, but the months at sea were long."
    LUNA @ talk "Para iyiydi, ama denizdeki aylar uzundu."

# game/data/characters/luna/dialogue_luna.rpy:55
translate tr luna_questions_menu_c067ca27:

    # LUNA @ think "That's why we saved up what money we could,"
    LUNA @ think "Bu yüzden biriktirebildiğimiz kadar para biriktirdik,"

# game/data/characters/luna/dialogue_luna.rpy:56
translate tr luna_questions_menu_7c370a02:

    # MC @ talk "He planned to retire and have us open up a store."
    MC @ talk "Emekli olup bir dükkan açmamızı planladı."

# game/data/characters/luna/dialogue_luna.rpy:57
translate tr luna_questions_menu_51681a50:

    # LUNA @ sad "That is... until his ship was taken by a storm."
    LUNA @ sad "Ta ki... gemisi bir fırtınaya yakalanana kadar."

# game/data/characters/luna/dialogue_luna.rpy:58
translate tr luna_questions_menu_234263d1:

    # MC @ sad "I am sorry to hear that."
    MC @ sad "Bunu duyduğuma üzüldüm."

# game/data/characters/luna/dialogue_luna.rpy:59
translate tr luna_questions_menu_02f03353:

    # LUNA @ sad "It's alright, it was a long time ago now."
    LUNA @ sad "Sorun değil, artık uzun zaman önceydi."

# game/data/characters/luna/dialogue_luna.rpy:60
translate tr luna_questions_menu_e8411806:

    # LUNA @ sad "It's... easier to talk about now."
    LUNA @ sad "Şimdi... hakkında konuşmak daha kolay."

# game/data/characters/luna/dialogue_luna.rpy:61
translate tr luna_questions_menu_b6df5634:

    # LUNA @ think "Anyway, after my husband died, I was left with the coin we had managed to save up."
    LUNA @ think "Her neyse, kocam öldükten sonra, biriktirmeyi başardığımız parayla baş başa kaldım."

# game/data/characters/luna/dialogue_luna.rpy:62
translate tr luna_questions_menu_465a393c:

    # LUNA @ smile "I thought, well, no point running off with my tail between my leg."
    LUNA @ smile "Düşündüm, peki, kuyruğumu bacaklarımın arasına sıkıştırıp kaçmanın anlamı yok."

# game/data/characters/luna/dialogue_luna.rpy:63
translate tr luna_questions_menu_34b15857:

    # LUNA @ smile "So, I looked around, and decided instead of a store,"
    LUNA @ smile "Böylece etrafa baktım ve bir dükkan yerine,"

# game/data/characters/luna/dialogue_luna.rpy:64
translate tr luna_questions_menu_e4722a60:

    # LUNA @ smile "A bathhouse sounded more fun to run."
    LUNA @ smile "Bir hamam işletmek daha eğlenceli geldi."

# game/data/characters/luna/dialogue_luna.rpy:65
translate tr luna_questions_menu_661169f5:

    # LUNA @ smile "Heh... Plus I get a warm bath whenever I want now."
    LUNA @ smile "Heh... Artı artık istediğim zaman sıcak bir banyo alabiliyorum."

# game/data/characters/luna/dialogue_luna.rpy:66
translate tr luna_questions_menu_8a3ca43c:

    # LUNA @ talk "Hope that answers your question."
    LUNA @ talk "Umarım sorunu cevaplamıştır."

# game/data/characters/luna/dialogue_luna.rpy:69
translate tr luna_questions_menu_94fb1e89:

    # LUNA @ talk "There's not many other places for a katai to start a business."
    LUNA @ talk "Bir katai'nin iş kurması için pek fazla yer yok."

# game/data/characters/luna/dialogue_luna.rpy:70
translate tr luna_questions_menu_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Ne?"

# game/data/characters/luna/dialogue_luna.rpy:71
translate tr luna_questions_menu_86a14c5e:

    # MC @ think "It's illegal for a katai to own a businss in Novaras or something?"
    MC @ think "Novaras'ta bir katai'nin iş sahibi olması yasa dışı falan mı?"

# game/data/characters/luna/dialogue_luna.rpy:72
translate tr luna_questions_menu_23fd0367:

    # LUNA @ think "Not exactly."
    LUNA @ think "Tam olarak değil."

# game/data/characters/luna/dialogue_luna.rpy:73
translate tr luna_questions_menu_4b66451e:

    # LUNA @ sad "They just don't refuse to hand out any business licences."
    LUNA @ sad "Sadece hiçbir işletme ruhsatı vermeyi reddetmiyorlar."

# game/data/characters/luna/dialogue_luna.rpy:74
translate tr luna_questions_menu_d4ac178e:

    # MC @ think "... None?"
    MC @ think "... Hiç mi?"

# game/data/characters/luna/dialogue_luna.rpy:75
translate tr luna_questions_menu_9432b0bb:

    # LUNA @ talk "Well, they either outright refuse to grant permits and licences,"
    LUNA @ talk "Pekala, ya izin ve ruhsat vermeyi düpedüz reddediyorlar,"

# game/data/characters/luna/dialogue_luna.rpy:76
translate tr luna_questions_menu_9b87abaa:

    # LUNA @ talk "Or, they charge ludicrous rates that no one in their right mind would pay."
    LUNA @ talk "Ya da aklı başında kimsenin ödemeyeceği gülünç ücretler talep ediyorlar."

# game/data/characters/luna/dialogue_luna.rpy:77
translate tr luna_questions_menu_f068c751:

    # LUNA @ talk "Sometimes as high as five times as much the asking price of a normal human."
    LUNA @ talk "Bazen normal bir insanın istenen fiyatının beş katı kadar yüksek."

# game/data/characters/luna/dialogue_luna.rpy:78
translate tr luna_questions_menu_5fae091a:

    # LUNA @ sad "They tolerate some of the more powerful merchants when it comes to trade."
    LUNA @ sad "Ticaret söz konusu olduğunda daha güçlü tüccarlardan bazılarını tolere ediyorlar."

# game/data/characters/luna/dialogue_luna.rpy:79
translate tr luna_questions_menu_8866674a:

    # LUNA @ sad "For the rest of us though?"
    LUNA @ sad "Geri kalanımız için mi?"

# game/data/characters/luna/dialogue_luna.rpy:80
translate tr luna_questions_menu_9b6f6a12:

    # LUNA @ sad "They're only interested in hiring us katai as either servants or whores."
    LUNA @ sad "Bizi katai olarak sadece hizmetçi ya da fahişe olarak kiralamakla ilgileniyorlar."

# game/data/characters/luna/dialogue_luna.rpy:81
translate tr luna_questions_menu_209bb546:

    # MC @ talk "So that's why katai come here instead?"
    MC @ talk "Bu yüzden mi katai onun yerine buraya geliyor?"

# game/data/characters/luna/dialogue_luna.rpy:82
translate tr luna_questions_menu_6a433e62:

    # LUNA @ talk "As dangerous as the free city is, it's {i}free.{/i}"
    LUNA @ talk "Özgür şehir ne kadar tehlikeli olsa da, {i}özgür.{/i}"

# game/data/characters/luna/dialogue_luna.rpy:83
translate tr luna_questions_menu_804b4e81:

    # LUNA @ talk "At least here, we can etch out a life for ourselves."
    LUNA @ talk "En azından burada, kendimize bir hayat kurabiliriz."

# game/data/characters/luna/dialogue_luna.rpy:86
translate tr luna_questions_menu_393b14e5:

    # LUNA @ talk "Alright then."
    LUNA @ talk "Pekala öyleyse."

