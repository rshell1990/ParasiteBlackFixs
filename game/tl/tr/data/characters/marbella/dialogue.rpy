translate tr strings:

    # game/data/characters/marbella/dialogue.rpy:2
    old "Crooked Shaft expedition"
    new "Eğri Kuyu seferi"

    # game/data/characters/marbella/dialogue.rpy:2
    old "I've commissioned an expedition at the Crooked Shaft Mining Co. in Hamun City. I should pick up my order when it arrives."
    new "Hamun Şehri'ndeki Eğri Kuyu Madencilik Ltd. Şti'nde bir sefer görevlendirdim. Geldiğinde siparişimi almalıyım."

    # game/data/characters/marbella/dialogue.rpy:7
    old "Mining company income"
    new "Maden şirketi geliri"

    # game/data/characters/marbella/dialogue.rpy:7
    old "I've invested a hefty sum into the Crooked Shaft Mining Co at Hamun. I can collect my share of the profits weekly now."
    new "Hamun'daki Eğri Kuyu Madencilik Ltd. Şti'ne yüklü bir meblağ yatırdım. Artık haftalık olarak kar payımı toplayabilirim."

    # game/data/characters/marbella/dialogue.rpy:45
    old "Talk to the Chief Miner"
    new "Baş Madenci ile konuş"

    # game/data/characters/marbella/dialogue.rpy:50
    old "About that expedition..."
    new "Şu sefer hakkında..."

    # game/data/characters/marbella/dialogue.rpy:52
    old "About the profits..."
    new "Karlar hakkında..."

    # game/data/characters/marbella/dialogue.rpy:54
    old "I'd like to discuss investing in your company."
    new "Şirketinize yatırım yapmayı görüşmek isterim."

    # game/data/characters/marbella/dialogue.rpy:55
    old "I'd like to commission a mining expedition."
    new "Bir maden seferi görevlendirmek isterim."

    # game/data/characters/marbella/dialogue.rpy:57
    old "Nothing for now."
    new "Şimdilik bir şey yok."

    # game/data/characters/marbella/dialogue.rpy:148
    old "Can you explain to me more about these enchantment runes?"
    new "Bana bu büyü rünleri hakkında daha fazla bilgi verebilir misin?"

    # game/data/characters/marbella/dialogue.rpy:156
    old "You mentioned you were looking for investors... Could I ask why?"
    new "Yatırımcı aradığınızdan bahsettiniz... Nedenini sorabilir miyim?"

    # game/data/characters/marbella/dialogue.rpy:171
    old "How does a dwarf end up in Hamun starting a mining company?"
    new "Bir cüce nasıl Hamun'da bir maden şirketi kurar hale gelir?"

    # game/data/characters/marbella/dialogue.rpy:178
    old "That's all for questions for now."
    new "Sorular için şimdilik bu kadar."

    # game/data/characters/marbella/dialogue.rpy:216
    old "Here you go."
    new "Buyrun."

    # game/data/characters/marbella/dialogue.rpy:228
    old "I don't have that kind of coin on me right now..."
    new "Şu anda üzerimde o kadar para yok..."

    # game/data/characters/marbella/dialogue.rpy:265
    old "Ten percent is too low for such high investments on an upstart business with high risks — make it fifteen percent."
    new "Yüksek riskli yeni başlayan bir işletmede bu kadar yüksek yatırımlar için yüzde on çok düşük — yüzde on beş yap."

    # game/data/characters/marbella/dialogue.rpy:272
    old "Sounds good to me."
    new "Bana uyar."

    # game/data/characters/marbella/dialogue.rpy:300
    old "Iron ore"
    new "Demir cevheri"

    # game/data/characters/marbella/dialogue.rpy:308
    old "40 iron ore."
    new "40 demir cevheri."

    # game/data/characters/marbella/dialogue.rpy:320
    old "20 iron ore."
    new "20 demir cevheri."

    # game/data/characters/marbella/dialogue.rpy:328
