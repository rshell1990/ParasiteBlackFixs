    new "10 demir cevheri."

    # game/data/characters/marbella/dialogue.rpy:340
    old "Copper ore"
    new "Bakır cevheri"

    # game/data/characters/marbella/dialogue.rpy:344
    old "40 Copper ore."
    new "40 Bakır cevheri."

    # game/data/characters/marbella/dialogue.rpy:355
    old "20 Copper ore."
    new "20 Bakır cevheri."

    # game/data/characters/marbella/dialogue.rpy:363
    old "10 Copper ore."
    new "10 Bakır cevheri."

    # game/data/characters/marbella/dialogue.rpy:376
    old "Syax Ore"
    new "Syax Cevheri"

    # game/data/characters/marbella/dialogue.rpy:382
    old "How about some enchantment runes?"
    new "Biraz büyü rününe ne dersin?"

    # game/data/characters/marbella/dialogue.rpy:386
