# game/data/characters/serafina/dialogue.rpy:27
translate tr talk_serafina_training_94a619e3:

    # SERAFINA @ talk "As well as it can, I suppose."
    SERAFINA @ talk "Olabildiği kadar iyi, sanırım."

# game/data/characters/serafina/dialogue.rpy:28
translate tr talk_serafina_training_6ffa521c:

    # SERAFINA @ talk "Virgo is a strict instructor, but I know he means well."
    SERAFINA @ talk "Virgo katı bir eğitmen, ama iyi niyetli olduğunu biliyorum."

# game/data/characters/serafina/dialogue.rpy:29
translate tr talk_serafina_training_71f3de73:

    # MC @ think "And the magecraft he teaches you... is it—"
    MC @ think "Ve sana öğrettiği büyü sanatı... acaba—"

# game/data/characters/serafina/dialogue.rpy:30
translate tr talk_serafina_training_6aaef64c:

    # SERAFINA @ smile "{i}Powerful.{/i}"
    SERAFINA @ smile "{i}Powerful.{/i}"

# game/data/characters/serafina/dialogue.rpy:31
translate tr talk_serafina_training_f3f67cf2:

    # SERAFINA @ talk "But it's also kind of terrifying."
    SERAFINA @ talk "Ama aynı zamanda biraz ürkütücü."

# game/data/characters/serafina/dialogue.rpy:32
translate tr talk_serafina_training_b99aeecf:

    # SERAFINA @ talk "I have taken some private lessons before on magecraft."
    SERAFINA @ talk "Daha önce büyü sanatı üzerine özel dersler aldım."

# game/data/characters/serafina/dialogue.rpy:33
translate tr talk_serafina_training_ed0b2156:

    # SERAFINA @ surprised "But this is like a whole different world."
    SERAFINA @ surprised "Ama bu sanki tamamen farklı bir dünya gibi."

# game/data/characters/serafina/dialogue.rpy:34
translate tr talk_serafina_training_cd8bbe04:

    # MC @ serious "Be careful, Serafina. Many a mage has said the same thing,"
    MC @ serious "Dikkatli ol, Serafina. Birçok büyücü aynı şeyi söyledi,"

# game/data/characters/serafina/dialogue.rpy:35
translate tr talk_serafina_training_34d9062b:

    # MC @ serious "only to come undone by the madness of digging too deep."
    MC @ serious "sadece çok derine kazmanın deliliğiyle çözülmek için."

# game/data/characters/serafina/dialogue.rpy:36
translate tr talk_serafina_training_bf7b05d4:

    # SERAFINA @ smile "Don't worry, I'll be safe!"
    SERAFINA @ smile "Endişelenme, güvende olacağım!"

# game/data/characters/serafina/dialogue.rpy:40
translate tr talk_serafina_father_063c3e47:

    # SERAFINA @ sad "No..."
    SERAFINA @ sad "Hayır..."

# game/data/characters/serafina/dialogue.rpy:41
translate tr talk_serafina_father_35b4e32d:

    # SERAFINA @ sad "But now I know where he might receive my letters, so I'm still going to try."
    SERAFINA @ sad "Ama artık mektuplarımı nerede alabileceğini biliyorum, o yüzden denemeye devam edeceğim."

# game/data/characters/serafina/dialogue.rpy:42
translate tr talk_serafina_father_38d3fa5a:

    # SERAFINA @ sad "I just hope he understands why I made the choice I did."
    SERAFINA @ sad "Umarım neden bu seçimi yaptığımı anlar."

# game/data/characters/serafina/dialogue.rpy:46
translate tr talk_serafina_wives_8ee34734:

    # SERAFINA @ sad "{i}*Sigh*{/i} I learned a long time ago about their... {i}tastes.{/i}"
    SERAFINA @ sad "{i}*İç çekiş*{/i} Uzun zaman önce onların... {i}zevklerini{/i} öğrendim."

# game/data/characters/serafina/dialogue.rpy:47
translate tr talk_serafina_wives_8299d0af:

    # SERAFINA @ talk "They aren't exactly subtle about it."
    SERAFINA @ talk "Bu konuda pek de ince davranmıyorlar."

# game/data/characters/serafina/dialogue.rpy:48
translate tr talk_serafina_wives_1a5c91b5:

    # SERAFINA @ talk "But they do care for me a great deal."
    SERAFINA @ talk "Ama beni gerçekten çok önemsiyorlar."

# game/data/characters/serafina/dialogue.rpy:49
translate tr talk_serafina_wives_d0edb860:

    # SERAFINA @ talk "Just don't make things difficult for them, alright?"
    SERAFINA @ talk "Sadece onlar için işleri zorlaştırma, tamam mı?"

# game/data/characters/serafina/dialogue.rpy:50
translate tr talk_serafina_wives_8bc6c1f2:

    # SERAFINA @ talk "Chanyi may act strong, but she's more sensitive than she lets on."
    SERAFINA @ talk "Chanyi güçlü davranabilir, ama gösterdiğinden daha hassastır."

# game/data/characters/serafina/dialogue.rpy:51
translate tr talk_serafina_wives_c8f7cec7:

    # SERAFINA @ think "And mother is just... well... mother."
    SERAFINA @ think "Ve annem de işte... şey... anne işte."

# game/data/characters/serafina/dialogue.rpy:55
translate tr talk_serafina_bye_bdb817ba:

    # SERAFINA @ smile "Alright then."
    SERAFINA @ smile "Pekala o zaman."

# game/data/characters/serafina/dialogue.rpy:63
translate tr talk_virgo_e35d5f7e:

    # VIRGO "Greetings."
    VIRGO "Selamlar."

# game/data/characters/serafina/dialogue.rpy:66
translate tr talk_virgo_menu_9a8f3997:

    # VIRGO "The girl is a prodigy."
    VIRGO "Kız bir dahi."

# game/data/characters/serafina/dialogue.rpy:67
translate tr talk_virgo_menu_197001cc:

    # VIRGO "Even if she doesn't understand it yet."
    VIRGO "Henüz anlamasa bile."

# game/data/characters/serafina/dialogue.rpy:68
translate tr talk_virgo_menu_9da465ac:

    # VIRGO "She will make an excellent mage one day."
    VIRGO "Bir gün mükemmel bir büyücü olacak."

# game/data/characters/serafina/dialogue.rpy:69
translate tr talk_virgo_menu_b90b4597:

    # MC @ think "What kind of mage?"
    MC @ think "Ne tür bir büyücü?"

# game/data/characters/serafina/dialogue.rpy:70
translate tr talk_virgo_menu_88c6c0b7:

    # VIRGO "One where her talents are not wasted..."
    VIRGO "Yeteneklerinin boşa gitmediği bir tür..."

# game/data/characters/serafina/dialogue.rpy:73
translate tr talk_virgo_menu_da6cf2b8:

    # VIRGO "Until we meet again then."
    VIRGO "Tekrar görüşene dek o zaman."

