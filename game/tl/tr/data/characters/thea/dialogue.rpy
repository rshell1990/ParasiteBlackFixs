# game/data/characters/thea/dialogue.rpy:28
translate tr nov_thea_talk_5f6496d4:

    # THEA @ smile "Oh hey! Can I help you with something?"
    THEA @ smile "Ah hey! Sana bir konuda yardım edebilir miyim?"

# game/data/characters/thea/dialogue.rpy:33
translate tr nov_thea_bye_9e54ad83:

    # THEA @ talk "Alright, see ya around!"
    THEA @ talk "Pekala, görüşürüz!"

# game/data/characters/thea/dialogue.rpy:34
translate tr nov_thea_bye_d20135b7:

    # THEA @ smile "Good luck on your adventures!"
    THEA @ smile "Maceralarında iyi şanslar!"

# game/data/characters/thea/dialogue.rpy:38
translate tr nov_thea_adv_questions_1a2ee70f:

    # THEA @ talk "Ask away."
    THEA @ talk "Sor bakalım."

# game/data/characters/thea/dialogue.rpy:41
translate tr nov_thea_adv_questions_menu_bbc22857:

    # THEA @ talk "Over on the board over there is our list of current jobs needing to be done."
    THEA @ talk "Şuradaki panoda yapılması gereken mevcut işlerin listesi var."

# game/data/characters/thea/dialogue.rpy:42
translate tr nov_thea_adv_questions_menu_0ab4d2cb:

    # THEA @ talk "Just select the one you want, and we'll handle the paperwork while you get to work."
    THEA @ talk "Sadece istediğini seç, sen işe koyulurken biz evrak işlerini hallederiz."

# game/data/characters/thea/dialogue.rpy:43
translate tr nov_thea_adv_questions_menu_e0200cc9:

    # THEA @ talk "Remember though, you can only choose a quest within your rank as an adventurer."
    THEA @ talk "Unutma ama, sadece bir maceracı olarak rütben dahilindeki bir görevi seçebilirsin."

# game/data/characters/thea/dialogue.rpy:46
translate tr nov_thea_adv_questions_menu_d0988ac6:

    # THEA @ talk "It's important to understand how the ranking works."
    THEA @ talk "Sıralamanın nasıl çalıştığını anlamak önemli."

# game/data/characters/thea/dialogue.rpy:47
translate tr nov_thea_adv_questions_menu_a160af5e:

    # THEA @ talk "All beginner adventurers are ranked as D-listers."
    THEA @ talk "Tüm acemi maceracılar D-listesi olarak sıralanır."

# game/data/characters/thea/dialogue.rpy:48
translate tr nov_thea_adv_questions_menu_691c77f1:

    # THEA @ talk "These are the most straightforward and simple quests available to any adventurer."
    THEA @ talk "Bunlar herhangi bir maceracı için mevcut en basit ve en kolay görevlerdir."

# game/data/characters/thea/dialogue.rpy:49
translate tr nov_thea_adv_questions_menu_359a935e:

    # THEA @ talk "Ranking progresses from D-tier all the way to S-Tier, the rank of legendary adventurers."
    THEA @ talk "Sıralama D-kademesinden taa S-Kademesine, efsanevi maceracıların rütbesine ilerler."

# game/data/characters/thea/dialogue.rpy:50
translate tr nov_thea_adv_questions_menu_71f3b316:

    # THEA @ talk "Of course, as the danger and difficulty of the quests increase each rank, so does the rewards to compensate."
    THEA @ talk "Elbette, her rütbede görevlerin tehlikesi ve zorluğu arttıkça, bunu telafi etmek için ödüller de artar."

# game/data/characters/thea/dialogue.rpy:53
translate tr nov_thea_adv_questions_menu_9ae80558:

    # THEA @ talk "There's a set number of quests per rank that will need to be completed a minimum of at least once."
    THEA @ talk "Her rütbede en az bir kez tamamlanması gereken belirli sayıda görev vardır."

# game/data/characters/thea/dialogue.rpy:54
translate tr nov_thea_adv_questions_menu_42fcd1da:

    # THEA @ talk "After you've beaten your ranks guild quests, a special one-time quest will open up that once you've completed, your rank will increase."
    THEA @ talk "Kendi rütbelerinizdeki lonca görevlerini bitirdikten sonra, tamamladığınızda rütbenizin artacağı özel bir kerelik görev açılacak."

# game/data/characters/thea/dialogue.rpy:55
translate tr nov_thea_adv_questions_menu_0b3f27c1:

    # THEA @ talk "Oh ... And don't worry about running out of quests."
    THEA @ talk "Ah ... Ve görevlerin tükenmesi konusunda endişelenme."

# game/data/characters/thea/dialogue.rpy:56
translate tr nov_thea_adv_questions_menu_003922e8:

    # THEA @ talk "Outside of the special guild quests, most guild quests are usually full time occupations in themselves, you'll be able to re-do those quests as many times as you like."
    THEA @ talk "Özel lonca görevlerinin dışında, çoğu lonca görevi genellikle kendi başlarına tam zamanlı mesleklerdir, bu görevleri istediğin kadar tekrar yapabileceksin."

# game/data/characters/thea/dialogue.rpy:59
translate tr nov_thea_adv_questions_menu_fa5b1639:

    # THEA @ talk "Sure, was there anything else?"
    THEA @ talk "Tabii, başka bir şey var mıydı?"

# game/data/characters/thea/dialogue.rpy:63
translate tr nov_thea_adv_questions_notAdventurer_dff28a07:

    # THEA @ talk "Sorry, but I don't remember you being an adventurer."
    THEA @ talk "Üzgünüm, ama seni bir maceracı olarak hatırlamıyorum."

# game/data/characters/thea/dialogue.rpy:64
translate tr nov_thea_adv_questions_notAdventurer_4a075af6:

    # MC "What do you mean?"
    MC "Ne demek istiyorsun?"

# game/data/characters/thea/dialogue.rpy:65
translate tr nov_thea_adv_questions_notAdventurer_bd5ff809:

    # THEA @ talk "Well, you can get yourself a drink or something, but I can't waste my time explaining the inner workings of the guild to you."
    THEA @ talk "Pekala, kendine bir içki falan alabilirsin, ama loncanın iç işleyişini sana açıklamakla zamanımı harcayamam."

# game/data/characters/thea/dialogue.rpy:66
translate tr nov_thea_adv_questions_notAdventurer_e1770810:

    # MC "Can I become an adventurer?"
    MC "Maceracı olabilir miyim?"

# game/data/characters/thea/dialogue.rpy:67
translate tr nov_thea_adv_questions_notAdventurer_416abe62:

    # "Thea let out a quiet sigh..."
    "Thea sessiz bir iç çekti..."

# game/data/characters/thea/dialogue.rpy:68
translate tr nov_thea_adv_questions_notAdventurer_e5da05a6:

    # THEA @ talk "That's a three-hundred fifty-something time I've been asked this."
    THEA @ talk "Bu bana üç yüz elli küsur kez soruldu."

# game/data/characters/thea/dialogue.rpy:69
translate tr nov_thea_adv_questions_notAdventurer_811a066b:

    # THEA @ talk "Have you reached your Terminus yet?"
    THEA @ talk "Terminus'una ulaştın mı?"

# game/data/characters/thea/dialogue.rpy:70
translate tr nov_thea_adv_questions_notAdventurer_5d73558e:

    # "I swallowed hard."
    "Yutkundum."

# game/data/characters/thea/dialogue.rpy:71
translate tr nov_thea_adv_questions_notAdventurer_7b56f981:

    # MC "Y-yeah."
    MC "E-evet."

# game/data/characters/thea/dialogue.rpy:72
translate tr nov_thea_adv_questions_notAdventurer_2da5a787:

    # THEA @ talk "You did? Well, that is how you become an adventurer, you're {i}assigned{/i} this role at your Terminus."
    THEA @ talk "Ulaştın mı? İşte, maceracı böyle olunur, Terminus'unda bu rol {i}atanırsın.{/i}"

# game/data/characters/thea/dialogue.rpy:73
translate tr nov_thea_adv_questions_notAdventurer_fe9f792d:

    # THEA @ talk "What role did the kingdom bestow upon you?"
    THEA @ talk "Krallık sana hangi rolü bahşetti?"

# game/data/characters/thea/dialogue.rpy:74
translate tr nov_thea_adv_questions_notAdventurer_522de8a4:

    # MC "(Cannon fodder.)"
    MC "(Top yemi.)"

# game/data/characters/thea/dialogue.rpy:75
translate tr nov_thea_adv_questions_notAdventurer_e8f39a65:

    # MC "I... I should go."
    MC "Ben... Gitmem gerek."

# game/data/characters/thea/dialogue.rpy:76
translate tr nov_thea_adv_questions_notAdventurer_4349caf7:

    # "Thea raised an eyebrow."
    "Thea bir kaşını kaldırdı."

# game/data/characters/thea/dialogue.rpy:77
translate tr nov_thea_adv_questions_notAdventurer_d34359c3:

    # THEA @ talk "Okay, safe travels then!"
    THEA @ talk "Tamam, güvenli yolculuklar o zaman!"

# game/data/characters/thea/dialogue.rpy:79
translate tr nov_thea_adv_questions_notAdventurer_bfd46478:

    # MC "I should get to the fort now."
    MC "Şimdi kaleye gitmeliyim."

# game/data/characters/thea/dialogue.rpy:84
translate tr nov_thea_drink_4968c955:

    # THEA @ talk "Improve your standing at the guild and maybe we'll talk."
    THEA @ talk "Loncadaki konumunu iyileştir ve belki konuşuruz."

# game/data/characters/thea/dialogue.rpy:88
translate tr nov_thea_drink_8bb85580:

    # THEA @ smile "I hope you don't think you're the first one to try that."
    THEA @ smile "Umarım bunu deneyen ilk kişi olduğunu düşünmüyorsundur."

# game/data/characters/thea/dialogue.rpy:89
translate tr nov_thea_drink_cef616c3:

    # MC @ smile "I was hoping I'd be the first one you'd say yes to."
    MC @ smile "Evet diyeceğin ilk kişi olmayı umuyordum."

# game/data/characters/thea/dialogue.rpy:90
translate tr nov_thea_drink_af5adb3e:

    # THEA @ talk "Hmm, well, I'll think about it ..."
    THEA @ talk "Hmm, peki, bunu düşüneceğim ..."

# game/data/characters/thea/dialogue.rpy:91
translate tr nov_thea_drink_4d231e9b:

    # THEA @ talk "I'm sure you're used to girls just falling into your lap, but it takes a little more than that to get me interested."
    THEA @ talk "Eminim kızların kucağına düşmesine alışıksındır, ama beni ilgilendirmek bundan biraz daha fazlasını gerektirir."

# game/data/characters/thea/dialogue.rpy:92
translate tr nov_thea_drink_e9545907:

    # MC @ smile "Oh?"
    MC @ smile "Öyle mi?"

# game/data/characters/thea/dialogue.rpy:93
translate tr nov_thea_drink_08d238b8:

    # THEA @ smile "{i}I wanna see what you can do.{/i}"
    THEA @ smile "{i}Ne yapabileceğini görmek istiyorum.{/i}"

# game/data/characters/thea/dialogue.rpy:94
translate tr nov_thea_drink_fb6bc2c6:

    # MC @ think "What I can do?"
    MC @ think "Ne yapabileceğimi mi?"

# game/data/characters/thea/dialogue.rpy:95
translate tr nov_thea_drink_95135937:

    # THEA @ smile "Here, {i}at this guild.{/i}"
    THEA @ smile "Burada, {i}bu loncada.{/i}"

# game/data/characters/thea/dialogue.rpy:96
translate tr nov_thea_drink_306fe303:

    # THEA @ smile2 "There's something about this place that just-"
    THEA @ smile2 "Bu yer hakkında bir şey var ki-"

# game/data/characters/thea/dialogue.rpy:97
translate tr nov_thea_drink_c7bdae38:

    # THEA @ smile "Mmm ... Better not think too hard on it, need to stay focused for work."
    THEA @ smile "Mmm ... Çok fazla düşünmemek daha iyi, iş için odaklanmış kalmam gerek."

# game/data/characters/thea/dialogue.rpy:98
translate tr nov_thea_drink_ef2975b7:

    # MC @ talk "So, you've got a thing for Adventurers then?"
    MC @ talk "Yani, Maceracılara karşı bir şeyin var öyle mi?"

# game/data/characters/thea/dialogue.rpy:99
translate tr nov_thea_drink_79a5953f:

    # THEA @ smile2 "A-Ah...Maybe a little?"
    THEA @ smile2 "A-Ah...Belki biraz?"

# game/data/characters/thea/dialogue.rpy:100
translate tr nov_thea_drink_c0c81c71:

    # THEA @ smile "But not just any adventurer walking in off the street, one whose metal has been seriously proven."
    THEA @ smile "Ama sadece sokaktan içeri giren herhangi bir maceracı değil, metali ciddi şekilde kanıtlanmış biri."

# game/data/characters/thea/dialogue.rpy:101
translate tr nov_thea_drink_211b3ff7:

    # THEA @ blush "Think you've got what it takes?"
    THEA @ blush "Gerekenlere sahip olduğunu düşünüyor musun?"

# game/data/characters/thea/dialogue.rpy:102
translate tr nov_thea_drink_8ba32743:

    # MC @ talk "I guess we'll see, won't we?"
    MC @ talk "Sanırım göreceğiz, değil mi?"

