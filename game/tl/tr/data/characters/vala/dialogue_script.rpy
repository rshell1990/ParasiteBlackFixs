# game/data/characters/vala/dialogue_script.rpy:4
translate tr nov_vala_scr_firstmeet_1c716be8:

    # "As I stepped into the Library, I was greeted by the sudden warmth as I stepped through the door, the fire going as musky books laid scattered around on various tables."
    "Kütüphaneye adım attığımda, kapıdan içeri girerken ani sıcaklıkla karşılandım, ateş yanarken misk kokulu kitaplar çeşitli masalarda dağılmış haldeydi."

# game/data/characters/vala/dialogue_script.rpy:5
translate tr nov_vala_scr_firstmeet_9b7620e7:

    # MC @ talk "Hello? Is anyone here?"
    MC @ talk "Merhaba? Burada kimse var mı?"

# game/data/characters/vala/dialogue_script.rpy:6
translate tr nov_vala_scr_firstmeet_1e9e0401:

    # VALA "Just a minute!"
    VALA "Bir dakika!"

# game/data/characters/vala/dialogue_script.rpy:7
translate tr nov_vala_scr_firstmeet_b7a4fdc6:

    # "Peering around, I noticed a blonde girl high up on some ladder, putting away a few old books they she slides back into place."
    "Etrafa göz gezdirince, yüksek bir merdivende, yerine kaydırdığı birkaç eski kitabı kaldıran sarışın bir kız fark ettim."

# game/data/characters/vala/dialogue_script.rpy:9
translate tr nov_vala_scr_firstmeet_3ed51ef9:

    # "Reaching onto her tip toes, the girl out-stretched her arms as she tried to reach the bookshelf, and her skirt begin to hike up, revealing the soft panties she wore beneath."
    "Parmak uçlarına uzanarak, kız kitaplığa ulaşmaya çalışırken kollarını uzattı ve eteği yukarı sıyrılmaya başladı, altında giydiği yumuşak külotları ortaya çıkardı."

# game/data/characters/vala/dialogue_script.rpy:11
translate tr nov_vala_scr_firstmeet_7a78c0c0:

    # VALA "Just... a little more!"
    VALA "Sadece... biraz daha!"

# game/data/characters/vala/dialogue_script.rpy:13
translate tr nov_vala_scr_firstmeet_2ab10cd7:

    # MC @ talk "Are you okay up there? That ladder looks a little... {i}old.{/i}"
    MC @ talk "Orada iyi misin? O merdiven biraz... {i}eski{/i} görünüyor."

# game/data/characters/vala/dialogue_script.rpy:14
translate tr nov_vala_scr_firstmeet_4cc79bf2:

    # VALA "I’ll be fine! We’re getting a new-"
    VALA "İyi olacağım! Yeni bir tane alıyoruz-"

# game/data/characters/vala/dialogue_script.rpy:15
translate tr nov_vala_scr_firstmeet_d2a7a758:

    # "Suddenly, the weak ladder snapped beneath her foot as the girl began falling down!"
    "Aniden, zayıf merdiven ayağının altında kırıldı ve kız düşmeye başladı!"

# game/data/characters/vala/dialogue_script.rpy:20
translate tr nov_vala_scr_firstmeet_e7b98bff:

    # VALA "AHHHHH!"
    VALA "Ahhhh!"

# game/data/characters/vala/dialogue_script.rpy:21
translate tr nov_vala_scr_firstmeet_061f8483:

    # "Running forward, I managed to catch the girl just in time with my agile reflexes, gently letting her down safely."
    "İleri koşarak, çevik reflekslerimle kızı tam zamanında yakalamayı başardım, nazikçe güvenli bir şekilde yere indirdim."

# game/data/characters/vala/dialogue_script.rpy:24
translate tr nov_vala_scr_firstmeet_93bbef6a:

    # VALA "Phew...! Thank you for that!"
    VALA "Phew...! Bunun için teşekkür ederim!"

# game/data/characters/vala/dialogue_script.rpy:25
translate tr nov_vala_scr_firstmeet_9eb70956:

    # "Stood before me, I now finally had a good chance to look at the girl properly, she was short, with long blonde hair and spectacle glasses."
    "Önümde dururken, sonunda kıza düzgünce bakmak için iyi bir şansım oldu, kısa boyluydu, uzun sarı saçlı ve gözlüklüydü."

# game/data/characters/vala/dialogue_script.rpy:27
translate tr nov_vala_scr_firstmeet_214f3a9e:

    # "Smiling cutely at me, I looked down to see the curves of her body and felt the tinge of the Parasite getting excited once again."
    "Bana sevimli sevimli gülümseyerek, bedeninin kıvrımlarını görmek için aşağı baktım ve Parazitin bir kez daha heyecanlandığının kırbacını hissettim."

# game/data/characters/vala/dialogue_script.rpy:28
translate tr nov_vala_scr_firstmeet_0a1deb0a:

    # MC @ talk "No problem."
    MC @ talk "Sorun değil."

# game/data/characters/vala/dialogue_script.rpy:29
translate tr nov_vala_scr_firstmeet_9dcd4662:

    # "The girl outstretched her hand for it to be shaken."
    "Kız sıkılmak için elini uzattı."

# game/data/characters/vala/dialogue_script.rpy:30
translate tr nov_vala_scr_firstmeet_16215314:

    # VALA "Vala Bluestone at your service!"
    VALA "Hizmetinizde Vala Bluestone!"

# game/data/characters/vala/dialogue_script.rpy:32
translate tr nov_vala_scr_firstmeet_90781931:

    # "I reached out my hand to shake hers."
    "Onun elini sıkmak için elimi uzattım."

# game/data/characters/vala/dialogue_script.rpy:33
translate tr nov_vala_scr_firstmeet_6fa3a6ae:

    # MC @ talk "A pleasure to meet you Vala Bluestone, I am [player_name!t]."
    MC @ talk "Tanıştığımıza memnun oldum Vala Bluestone, ben [player_name!t]."

# game/data/characters/vala/dialogue_script.rpy:34
translate tr nov_vala_scr_firstmeet_ce593ffd:

    # VALA "So, what brings you here?"
    VALA "Peki, seni buraya getiren nedir?"

# game/data/characters/vala/dialogue_script.rpy:35
translate tr nov_vala_scr_firstmeet_0ad6f9ca:

    # MC @ talk "I was perhaps hoping to read a book or two..."
    MC @ talk "Belki bir ya da iki kitap okumayı umuyordum..."

# game/data/characters/vala/dialogue_script.rpy:36
translate tr nov_vala_scr_firstmeet_c606f5f8:

    # VALA "Ah, well the library is free for all, and always open."
    VALA "Ah, peki kütüphane herkese ücretsiz ve her zaman açık."

# game/data/characters/vala/dialogue_script.rpy:37
translate tr nov_vala_scr_firstmeet_f0e406e2:

    # VALA "Just remember, while we can put books in the hold for you to keep reading once you come back, we can’t allow you to take any of the books with you."
    VALA "Sadece hatırla, geri döndüğünde okumaya devam etmen için kitapları ambarda tutabilirken, kitaplardan hiçbirini yanında götürmene izin veremeyiz."

# game/data/characters/vala/dialogue_script.rpy:38
translate tr nov_vala_scr_firstmeet_7c81cc89:

    # "After so many students complained and asked for the library to be opened due to the ever-growing stress around studies, the education board agreed to give it extra funding to do so."
    "Pek çok öğrenci çalışmalarla ilgili giderek artan stres nedeniyle kütüphanenin açılmasından şikayet edip talep ettikten sonra, eğitim kurulu bunu yapmak için ekstra fon vermeyi kabul etti."

# game/data/characters/vala/dialogue_script.rpy:39
translate tr nov_vala_scr_firstmeet_c486209e:

    # "Me and Markus, albeit reluctantly, were forced to spend a fair few of our evenings here."
    "Ben ve Markus, isteksizce de olsa, akşamlarımızın bir kısmını burada geçirmeye zorlandık."

# game/data/characters/vala/dialogue_script.rpy:40
translate tr nov_vala_scr_firstmeet_ef9ee76e:

    # "How long ago that all seems now..."
    "Bütün bunlar şimdi ne kadar uzun zaman önce geliyor..."

# game/data/characters/vala/dialogue_script.rpy:41
translate tr nov_vala_scr_firstmeet_0d47b440:

    # VALA "Is something the matter?"
    VALA "Bir sorun mu var?"

# game/data/characters/vala/dialogue_script.rpy:42
translate tr nov_vala_scr_firstmeet_bf61c54a:

    # MC @ talk "Hmm?"
    MC @ talk "Hmm?"

# game/data/characters/vala/dialogue_script.rpy:43
translate tr nov_vala_scr_firstmeet_c9952985:

    # VALA "You seemed... {i}lost in thought{/i} for a second there."
    VALA "Bir an için... {i}düşünceye dalmış{/i} gibiydin."

# game/data/characters/vala/dialogue_script.rpy:44
translate tr nov_vala_scr_firstmeet_d5717343:

    # MC @ talk "Oh, never mind."
    MC @ talk "Ah, boşver."

# game/data/characters/vala/dialogue_script.rpy:45
translate tr nov_vala_scr_firstmeet_67a9c63c:

    # MC @ talk "Just remembering some things, nothing important."
    MC @ talk "Sadece bazı şeyleri hatırlıyordum, önemli bir şey değil."

# game/data/characters/vala/dialogue_script.rpy:46
translate tr nov_vala_scr_firstmeet_bf0e67a2:

    # VALA "Well, if you need anything, I’ll be around! Okay?"
    VALA "Pekala, bir şeye ihtiyacın olursa, buralarda olacağım! Tamam mı?"

# game/data/characters/vala/dialogue_script.rpy:47
translate tr nov_vala_scr_firstmeet_830159c6:

    # MC @ talk "Sounds good."
    MC @ talk "Kulağa iyi geliyor."

# game/data/characters/vala/dialogue_script.rpy:48
translate tr nov_vala_scr_firstmeet_618cb924:

    # "As Vala smiled and waved shyly, I watched her cute butt as she sauntered off to go grab more books."
    "Vala gülümseyip utangaçça el sallarken, daha fazla kitap almaya giderken sevimli kalçasını izledim."

# game/data/characters/vala/dialogue_script.rpy:51
translate tr nov_vala_scr_firstmeet_db0c26de:

    # BLACK "Her heartbeat raised when she saw you, and her hands began to sweat."
    BLACK "Seni gördüğünde kalp atışı hızlandı ve elleri terlemeye başladı."

# game/data/characters/vala/dialogue_script.rpy:52
translate tr nov_vala_scr_firstmeet_a97dcc2e:

    # BLACK "With some commitment, she would be a willing and good mate."
    BLACK "Biraz kararlılıkla, gönüllü ve iyi bir eş olurdu."

# game/data/characters/vala/dialogue_script.rpy:53
translate tr nov_vala_scr_firstmeet_7be498ca:

    # MC "Stop... I... "
    MC "Dur... Ben..."

# game/data/characters/vala/dialogue_script.rpy:54
translate tr nov_vala_scr_firstmeet_81498102:

    # "I shook my head to try push aside the dark thoughts."
    "Karanlık düşünceleri bir kenara itmeye çalışmak için başımı salladım."

# game/data/characters/vala/dialogue_script.rpy:55
translate tr nov_vala_scr_firstmeet_bd8e6530:

    # MC @ angry "We’re here to try and gather some information, not hunting for another ‘mate’"
    MC @ angry "Bilgi toplamaya çalışmak için buradayız, başka bir 'eş' avlamak için değil."

# game/data/characters/vala/dialogue_script.rpy:56
translate tr nov_vala_scr_firstmeet_296d9d43:

    # BLACK "As you wish."
    BLACK "Nasıl istersen."

# game/data/characters/vala/dialogue_script.rpy:57
translate tr nov_vala_scr_firstmeet_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*İç çekiş*{/i}"

# game/data/characters/vala/dialogue_script.rpy:58
translate tr nov_vala_scr_firstmeet_7c3d9a85:

    # "Now, where to start? This place is huge..."
    "Şimdi, nereden başlamalı? Burası kocaman..."

