# game/data/characters/winward_mrs/dialogue.rpy:325
translate tr nov_mrs_winward_brought_hides_29b26bfa:

    # MRS_WINWARD @ embarr "I promise it won't happen again."
    MRS_WINWARD @ embarr "Bir daha olmayacağına söz veriyorum."

# game/data/characters/winward_mrs/dialogue.rpy:326
translate tr nov_mrs_winward_brought_hides_fff826b3:

    # "Wiping her tears away, Mrs Winward did her best to smile and reverted to her usual self."
    "Gözyaşlarını silerek, Bayan Winward gülümsemek için elinden geleni yaptı ve her zamanki haline geri döndü."

# game/data/characters/winward_mrs/dialogue.rpy:327
translate tr nov_mrs_winward_brought_hides_fb20b64f:

