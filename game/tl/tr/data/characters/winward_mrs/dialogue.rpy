translate tr nov_mrs_winward_brought_hides_779e9646:

    # MRS_WINWARD @ lewd "T-This is all too much excitement for these old bones! Haha!"
    MRS_WINWARD @ lewd "B-Bunlar hepsi bu yaşlı kemikler için çok fazla heyecan! Haha!"

# game/data/characters/winward_mrs/dialogue.rpy:319
translate tr nov_mrs_winward_brought_hides_21eb893b:

    # "Mrs Winward laughed awkwardly, but it was clear she was struggling to stay focused after what happened."
    "Bayan Winward garip bir şekilde güldü, ama olanlardan sonra odaklanmakta zorlandığı açıktı."

# game/data/characters/winward_mrs/dialogue.rpy:320
translate tr nov_mrs_winward_brought_hides_5be74a7e:

    # "Regardless, I decided it was a good idea not to push my luck too far... yet."
    "Her halükarda, şansımı çok fazla zorlamamak için iyi bir fikir olduğuna karar verdim... henüz."

# game/data/characters/winward_mrs/dialogue.rpy:324
translate tr nov_mrs_winward_brought_hides_05f5a0ca:

    # MRS_WINWARD @ embarr "Y-Yes, I understand."
