translate tr strings:

    # game/data/characters/winward_mrs/dialogue.rpy:2
    old "Leather to pick up"
    new "Alınacak deri"

    # game/data/characters/winward_mrs/dialogue.rpy:2
    old "I've commissioned Mrs. Winward of Novaras tannery to process some animal hides into leather. I should pick it up in about a week."
    new "Novaras tabakhanesindeki Bayan Winward'a bazı hayvan derilerini deriye dönüştürmesi için sipariş verdim. Yaklaşık bir hafta içinde almalıyım."

    # game/data/characters/winward_mrs/dialogue.rpy:7
    old "Tanner's shop needs animal hides"
    new "Tabakçının dükkanının hayvan derisine ihtiyacı var"

    # game/data/characters/winward_mrs/dialogue.rpy:7
    old "If I gather animal hides during my travels, I can bring them to Mrs Winward, a leatherworker lady at the tanner's shop in Novaras. She can process these hides into usable leather."
    new "Seyahatlerim sırasında hayvan derisi toplarsam, onları Novaras'taki tabakçı dükkanında bir deri işçisi hanımefendi olan Bayan Winward'a götürebilirim. Bu derileri kullanılabilir deriye dönüştürebilir."

    # game/data/characters/winward_mrs/dialogue.rpy:52
    old "Talk to Mrs. Winward"
    new "Bayan Winward ile konuş"

    # game/data/characters/winward_mrs/dialogue.rpy:57
    old "Could you make me some leather from these hides?"
    new "Bu derilerden benim için biraz deri yapabilir misiniz?"

    # game/data/characters/winward_mrs/dialogue.rpy:59
    old "Can you please explain what it is that you do again?"
    new "Yine ne iş yaptığınızı açıklayabilir misiniz lütfen?"

    # game/data/characters/winward_mrs/dialogue.rpy:61
    old "Tell me a little more about yourself, Mrs Winward."
    new "Bana kendiniz hakkında biraz daha bilgi verin, Bayan Winward."

    # game/data/characters/winward_mrs/dialogue.rpy:62
    old "That's all, Mrs. Winward."
    new "Hepsi bu kadar, Bayan Winward."

    # game/data/characters/winward_mrs/dialogue.rpy:90
    old "One."
    new "Bir."

    # game/data/characters/winward_mrs/dialogue.rpy:95
    old "Two."
    new "İki."

    # game/data/characters/winward_mrs/dialogue.rpy:100
    old "Three."
    new "Üç."

    # game/data/characters/winward_mrs/dialogue.rpy:105
    old "Ah, on second thought..."
    new "Ah, ikinci düşünüşte..."

    # game/data/characters/winward_mrs/dialogue.rpy:113
    old "How long have you lived in Novaras?"
    new "Novaras'ta ne kadar zamandır yaşıyorsunuz?"

    # game/data/characters/winward_mrs/dialogue.rpy:129
    old "How long have you been married?"
    new "Ne kadar zamandır evlisiniz?"

    # game/data/characters/winward_mrs/dialogue.rpy:241
    old "THAT'S ENOUGH!"
    new "YETER ARTIK!"

    # game/data/characters/winward_mrs/dialogue.rpy:247
    old "I don't know; something of mine is certainly 'getting up' for her."
    new "Bilmiyorum; benim bir şeyim onun için kesinlikle 'kalkıyor'."

    # game/data/characters/winward_mrs/dialogue.rpy:288
    old "{image=[ICON.HEART]} I was rather enjoying the attention..."
    new "{i}İlginin tadını çıkarıyordum...{/i}"

    # game/data/characters/winward_mrs/dialogue.rpy:323
    old "{image=[ICON.HEART_CROSS]} I understand, but I would appreciate not being dragged into your marital issues."
    new "{i}Anlıyorum, ama evlilik sorunlarınıza sürüklenmek istemem.{/i}"

