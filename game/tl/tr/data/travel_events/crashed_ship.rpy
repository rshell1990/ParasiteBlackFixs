translate tr travel_event_crashed_ship_c7f49737:

    # BLACK "{i}...Going wrong way.{/i}"
    BLACK "{i}...Yanlış yöne gidiyor.{/i}"

# game/data/travel_events/crashed_ship.rpy:15
translate tr travel_event_crashed_ship_73790772:

    # MC @ angry "We are not going the wrong way!"
    MC @ angry "Yanlış yöne gitmiyoruz!"

# game/data/travel_events/crashed_ship.rpy:16
translate tr travel_event_crashed_ship_1cd0e33a:

    # BLACK "{i}We are lost.{/i}"
    BLACK "{i}Kaybolduk.{/i}"

# game/data/travel_events/crashed_ship.rpy:17
translate tr travel_event_crashed_ship_71d2cf05:

    # MC @ angry "We are not lost!"
    MC @ angry "Kaybolmadık!"

# game/data/travel_events/crashed_ship.rpy:19
translate tr travel_event_crashed_ship_66dfd255:

    # MC @ talk "We just—"
    MC @ talk "Biz sadece—"

# game/data/travel_events/crashed_ship.rpy:21
translate tr travel_event_crashed_ship_90844184:

    # MC @ talk "We just need to find our—"
    MC @ talk "Biz sadece bulmamız lazım—"

# game/data/travel_events/crashed_ship.rpy:23
translate tr travel_event_crashed_ship_88b2ee55:

    # "Suddenly, I felt the earth crumble beneath me."
    "Aniden, ayağımın altındaki toprağın çöktüğünü hissettim."

# game/data/travel_events/crashed_ship.rpy:26
translate tr travel_event_crashed_ship_934fef82:

    # "I gasped as I plummeted into a great chasm below."
    "Aşağıdaki büyük bir yarığa düşerken nefesim kesildi."

# game/data/travel_events/crashed_ship.rpy:28
translate tr travel_event_crashed_ship_a4b26b88:

    # "The fall lasted only moments, wind whipping past as panic surged through me."
    "Düşüş sadece anlar sürdü, içimden panik yükselirken rüzgar hızla geçti."

# game/data/travel_events/crashed_ship.rpy:29
translate tr travel_event_crashed_ship_b71673c2:

    # "One of my blackened tentacles shot out, anchoring into the wall and halting my descent."
    "Kararmış dokunaçlarımdan biri fırladı, duvara tutunup inişimi durdurdu."

# game/data/travel_events/crashed_ship.rpy:30
translate tr travel_event_crashed_ship_e352090c:

    # MARKUS @ shock "[player_name!t]!"
    MARKUS @ shock "«oyuncu_adı»!"

# game/data/travel_events/crashed_ship.rpy:32
translate tr travel_event_crashed_ship_81a47010:

    # "Lowering myself carefully, I landed on a patch of dirt below, lit faintly by the chasm's natural opening."
    "Kendimi dikkatlice indirirken, yarığın doğal açıklığıyla hafifçe aydınlanan aşağıdaki bir toprak parçasına indim."

# game/data/travel_events/crashed_ship.rpy:33
translate tr travel_event_crashed_ship_dda0aa4b:

    # MARKUS "Can you hear me?!"
    MARKUS "Beni duyuyor musun?!"

# game/data/travel_events/crashed_ship.rpy:34
translate tr travel_event_crashed_ship_354115c9:

    # MC @ talk "I'm alright."
    MC @ talk "Ben iyiyim."

# game/data/travel_events/crashed_ship.rpy:35
translate tr travel_event_crashed_ship_6baba279:

    # "As my eyes adjusted, the full scale of the pit became clear."
    "Gözlerim alıştıkça, çukurun tam ölçeği netleşti."

# game/data/travel_events/crashed_ship.rpy:41
translate tr travel_event_crashed_ship_141d7189:

    # MC @ think "Is this... some kind of cave?"
    MC @ think "Burası... bir tür mağara mı?"

# game/data/travel_events/crashed_ship.rpy:43
translate tr travel_event_crashed_ship_f02ac22b:

    # "There, partially submerged in shallow water, was something metallic—a ship?"
    "Orada, kısmen sığ suya batmış, metalik bir şey vardı—bir gemi?"

# game/data/travel_events/crashed_ship.rpy:44
translate tr travel_event_crashed_ship_e26d324c:

    # "Ruined and entangled in vines, the strange relic beckoned."
    "Harap olmuş ve sarmaşıklara dolanmış, garip kalıntı çağırdı."

# game/data/travel_events/crashed_ship.rpy:45
translate tr travel_event_crashed_ship_b3c9f1a5:

    # MARKUS "What do you see down there?!"
    MARKUS "Orada ne görüyorsun?!"

# game/data/travel_events/crashed_ship.rpy:46
translate tr travel_event_crashed_ship_8ec5fa0b:

    # MC @ serious "You might want to come down here."
    MC @ serious "Buraya inmeni isteyebilirsin."

# game/data/travel_events/crashed_ship.rpy:48
translate tr travel_event_crashed_ship_4001a4a4:

    # "The others climbed down with caution."
    "Diğerleri dikkatle aşağı tırmandı."

# game/data/travel_events/crashed_ship.rpy:50
translate tr travel_event_crashed_ship_f5a0c50b:

    # MARKUS @ shock "What in seven hells is that thing?"
    MARKUS @ shock "Yedi cehennem adına o şey ne?"

# game/data/travel_events/crashed_ship.rpy:51
translate tr travel_event_crashed_ship_11bcc543:

    # MC @ think "Some kind of ship?"
    MC @ think "Bir tür gemi mi?"

# game/data/travel_events/crashed_ship.rpy:52
translate tr travel_event_crashed_ship_539ee9fb:

    # MARKUS @ talk "Where are its sails?"
    MARKUS @ talk "Yelkenleri nerede?"

# game/data/travel_events/crashed_ship.rpy:53
translate tr travel_event_crashed_ship_3dad54df:

    # MC @ think "Never seen a vessel like this... and this far from any sea?"
    MC @ think "Hiç böyle bir gemi görmedim... ve bu herhangi bir denizden bu kadar uzakta mı?"

# game/data/travel_events/crashed_ship.rpy:57
translate tr travel_event_crashed_ship_0208f36a:

    # MYU @ scared "M-Myu? Metal thing scary..."
    MYU @ scared "M-Myu? Metal şey korkutucu..."

# game/data/travel_events/crashed_ship.rpy:62
translate tr travel_event_crashed_ship_8138fa88:

    # VES @ think "I've heard rumors of the Greater Trading Company reinforcing ships with armor, but this..."
    VES @ think "Büyük Ticaret Şirketi'nin gemileri zırhla güçlendirdiğine dair söylentiler duydum, ama bu..."

# game/data/travel_events/crashed_ship.rpy:63
translate tr travel_event_crashed_ship_e9cd7d09:

    # VES @ talk "This is nothing like anything I've ever seen."
    VES @ talk "Bu gördüğüm hiçbir şeye benzemiyor."

# game/data/travel_events/crashed_ship.rpy:68
translate tr travel_event_crashed_ship_ba8e8344:

    # ELENA @ grumpy "Perhaps... a relic of the old gods?"
    ELENA @ grumpy "Belki... eski tanrıların bir kalıntısı?"

# game/data/travel_events/crashed_ship.rpy:69
translate tr travel_event_crashed_ship_c90ffbe7:

    # ELENA @ grumpy "Judging by how deep this cavern is, it must've been buried here for thousands of years."
    ELENA @ grumpy "Bu mağaranın ne kadar derin olduğuna bakılırsa, binlerce yıldır burada gömülü olmalı."

# game/data/travel_events/crashed_ship.rpy:75
translate tr travel_event_crashed_ship_985866dd:

    # SYPHA @ talk "{i}And so, in ages past, they rode mechanical beasts across the stars.{/i}"
    SYPHA @ talk "{i}Ve böylece, geçmiş çağlarda, yıldızlar arasında mekanik canavarları sürdüler.{/i}"

# game/data/travel_events/crashed_ship.rpy:76
translate tr travel_event_crashed_ship_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Ne?"

# game/data/travel_events/crashed_ship.rpy:77
translate tr travel_event_crashed_ship_c24c1193:

    # SYPHA @ think "Nothing. Just old legends from childhood."
    SYPHA @ think "Hiçbir şey. Sadece çocukluktan eski efsaneler."

# game/data/travel_events/crashed_ship.rpy:84
translate tr travel_event_crashed_ship_16bf6a3c:

    # MC @ serious "Whatever it is, I don't like it."
    MC @ serious "Her neyse, bundan hoşlanmadım."

# game/data/travel_events/crashed_ship.rpy:85
translate tr travel_event_crashed_ship_cfd774db:

    # MC @ talk "Let's leave sleeping ghosts to rest."
    MC @ talk "Uyuyan hayaletleri dinlenmeye bırakalım."

# game/data/travel_events/crashed_ship.rpy:86
translate tr travel_event_crashed_ship_516553f1:

    # MARKUS @ talk "Agreed. Nothing good comes from disturbing the dead."
    MARKUS @ talk "Katılıyorum. Ölüleri rahatsız etmekten iyi bir şey gelmez."

# game/data/travel_events/crashed_ship.rpy:88
translate tr travel_event_crashed_ship_013b3791:

    # "We climbed back out of the rift and resumed our journey."
    "Yarıktan geri tırmandık ve yolculuğumuza devam ettik."

# game/data/travel_events/crashed_ship.rpy:95
translate tr travel_event_crashed_ship_inside_4a677239:

    # "Carefully, I approached the wreck."
    "Dikkatlice, enkaza yaklaştım."

# game/data/travel_events/crashed_ship.rpy:96
translate tr travel_event_crashed_ship_inside_c1071274:

    # "I stepped into the freezing water and laid my hand on the cold metal hull."
    "Dondurucu suya adım attım ve elimi soğuk metal gövdeye koydum."

# game/data/travel_events/crashed_ship.rpy:99
translate tr travel_event_crashed_ship_inside_08beff35:

    # MARKUS @ shock "[player_name!t]! What are you doing?"
    MARKUS @ shock "[player_name!t]! Ne yapıyorsun?"

# game/data/travel_events/crashed_ship.rpy:101
translate tr travel_event_crashed_ship_inside_9ec1a37a:

    # "A hiss of steam sounded as the metal twisted open like a door."
    "Metal bir kapı gibi açılırken bir buhar tıslaması duyuldu."

# game/data/travel_events/crashed_ship.rpy:102
translate tr travel_event_crashed_ship_inside_79a0bb39:

    # MARKUS @ shock "You're not actually going inside that thing, are you?"
    MARKUS @ shock "Gerçekten o şeyin içine girmeyecek misin?"

# game/data/travel_events/crashed_ship.rpy:103
translate tr travel_event_crashed_ship_inside_026bc247:

    # "I stepped in."
    "İçeri adım attım."

# game/data/travel_events/crashed_ship.rpy:104
translate tr travel_event_crashed_ship_inside_970d0f74:

    # MARKUS @ angry "Gods be damned, man."
    MARKUS @ angry "Tanrıların belası, adamım."

# game/data/travel_events/crashed_ship.rpy:109
translate tr travel_event_crashed_ship_inside_bc2341db:

    # "Inside, it was cold."
    "İçerisi soğuktu."

# game/data/travel_events/crashed_ship.rpy:112
translate tr travel_event_crashed_ship_inside_4f0eba80:

    # "Our footsteps echoed across the metal floor."
    "Ayak seslerimiz metal zeminde yankılandı."

# game/data/travel_events/crashed_ship.rpy:113
translate tr travel_event_crashed_ship_inside_b2b6c7a4:

    # "Pipes snaked along the walls, choked in vines and pierced by jagged rock."
    "Borular duvarlarda kıvrılıyor, sarmaşıklarda boğulmuş ve sivri kayalarla delinmişti."

# game/data/travel_events/crashed_ship.rpy:118
translate tr travel_event_crashed_ship_inside_bd8053a5:

    # "A ghostly figure flickered into view inside a glowing circle."
    "Parıldayan bir dairenin içinde hayaletimsi bir figür belirdi."

# game/data/travel_events/crashed_ship.rpy:119
translate tr travel_event_crashed_ship_inside_472ec9d8:

    # MC @ angry "Who are you, specter?"
    MC @ angry "Kimsin sen, hayalet?"

# game/data/travel_events/crashed_ship.rpy:120
translate tr travel_event_crashed_ship_inside_bf2aaff8:

    # ANDRAS "This is Captain Andras of the Maylark."
    ANDRAS "Ben Maylark'ın Kaptanı Andras."

# game/data/travel_events/crashed_ship.rpy:121
translate tr travel_event_crashed_ship_inside_365bbf88:

    # ANDRAS "Day four-hundred and ninety-six since the end of... well, everything."
    ANDRAS "Her şeyin sonundan beri dört yüz doksan altıncı gün... eh, her şeyin."

# game/data/travel_events/crashed_ship.rpy:122
translate tr travel_event_crashed_ship_inside_bf38bc6e:

    # MARKUS @ think "Uhhh... hello?"
    MARKUS @ think "Ahhh... merhaba?"

# game/data/travel_events/crashed_ship.rpy:123
translate tr travel_event_crashed_ship_inside_18baf767:

    # MC @ think "I don't think he can hear us."
    MC @ think "Bizi duyabildiğini sanmıyorum."

# game/data/travel_events/crashed_ship.rpy:124
translate tr travel_event_crashed_ship_inside_b20d5e02:

    # ANDRAS "...{i}*Sigh*{/i} I don't even know why I bother with these things anymore."
    ANDRAS "...{i}*İç çekiş*{/i} Artık bunları neden yaptığımı bile bilmiyorum."

# game/data/travel_events/crashed_ship.rpy:125
translate tr travel_event_crashed_ship_inside_96afb379:

    # ANDRAS "It's not like there's actually anyone left to log it."
    ANDRAS "Kaydedecek kimse kalmamış gibi."

# game/data/travel_events/crashed_ship.rpy:126
translate tr travel_event_crashed_ship_inside_62cfcc16:

    # ANDRAS "For over a year and a half we've jumped from one dead star to the next."
    ANDRAS "Bir buçuk yılı aşkın süredir bir ölü yıldızdan sonrakine atladık."

# game/data/travel_events/crashed_ship.rpy:127
translate tr travel_event_crashed_ship_inside_881f07eb:

    # ANDRAS "One nightmarish, monster infested world to another, searching for someplace safe."
    ANDRAS "Bir korkunç, canavar dolu dünyadan diğerine, güvenli bir yer arıyoruz."

# game/data/travel_events/crashed_ship.rpy:128
translate tr travel_event_crashed_ship_inside_e84fa312:

    # ANDRAS "I still tell the crew that's what we're looking for... Someplace safe."
    ANDRAS "Hala mürettebata aradığımız şeyin bu olduğunu söylüyorum... Güvenli bir yer."

# game/data/travel_events/crashed_ship.rpy:129
translate tr travel_event_crashed_ship_inside_ec95d44a:

    # ANDRAS "I'd just settle for finding some food, fuel... anything now."
    ANDRAS "Biraz yiyecek, yakıt bulmaya razıyım... artık herhangi bir şeye."

# game/data/travel_events/crashed_ship.rpy:130
translate tr travel_event_crashed_ship_inside_b3b6925c:

    # ANDRAS "It's been months since we found any survivors."
    ANDRAS "Hayatta kalan bulalı aylar oldu."

# game/data/travel_events/crashed_ship.rpy:131
translate tr travel_event_crashed_ship_inside_9fb46d95:

    # ANDRAS "Well, unless you count the cannibals and freaks."
    ANDRAS "Şey, yamyamları ve ucubeleri saymazsan."

# game/data/travel_events/crashed_ship.rpy:132
translate tr travel_event_crashed_ship_inside_89d8f69d:

    # ANDRAS "... We have enough fuel for one last try, some unknown world ready on the edge of the Zelma ring."
    ANDRAS "... Son bir deneme için yeterli yakıtımız var, Zelma halkasının kenarında hazır bilinmeyen bir dünya."

# game/data/travel_events/crashed_ship.rpy:133
translate tr travel_event_crashed_ship_inside_5b2a8029:

    # ANDRAS "Atmospheric readings look good from orbit, and there seems to be no visual signs of corruption."
    ANDRAS "Yörüngeden atmosferik okumalar iyi görünüyor ve görsel yozlaşma işareti yok."

# game/data/travel_events/crashed_ship.rpy:134
translate tr travel_event_crashed_ship_inside_8cd54f27:

    # ANDRAS "We'll probably stall out on the landing, but hopefully with power routed to the shields, we can at least survive the crash."
    ANDRAS "Muhtemelen inişte duracağız, ama umarım kalkanlara yönlendirilen güçle, en azından kazadan sağ çıkabiliriz."

# game/data/travel_events/crashed_ship.rpy:135
translate tr travel_event_crashed_ship_inside_bfea744e:

    # ANDRAS "May the new gods... Ahhh, fuck it."
    ANDRAS "Yeni tanrılar... Ahhh, siktir et."

# game/data/travel_events/crashed_ship.rpy:136
translate tr travel_event_crashed_ship_inside_737f7819:

    # ANDRAS "{i}It's not like they're listening anymore anyway.{/i}"
    ANDRAS "{i}Zaten artık dinlemiyorlar.{/i}"

# game/data/travel_events/crashed_ship.rpy:137
translate tr travel_event_crashed_ship_inside_9e72f391:

    # "There was momentary flickering of the strange figure summoned."
    "Çağrılan garip figürde anlık bir titreşme oldu."

# game/data/travel_events/crashed_ship.rpy:138
translate tr travel_event_crashed_ship_inside_0742b26c:

    # ANDRAS "Day, five hundred and two."
    ANDRAS "Gün, beş yüz iki."

# game/data/travel_events/crashed_ship.rpy:139
translate tr travel_event_crashed_ship_inside_ce1c3d26:

    # ANDRAS "We survived the landing, but the ship's hull is too badly damaged to repair."
    ANDRAS "İnişten sağ kurtulduk, ama geminin gövdesi tamir edilemeyecek kadar kötü hasar gördü."

# game/data/travel_events/crashed_ship.rpy:140
translate tr travel_event_crashed_ship_inside_7ca46618:

    # ANDRAS "{i}*Chuckles*{/i} Not that we have to fuel left to go anywhere anyway."
    ANDRAS "{i}*Kıkırdar*{/i} Zaten gidecek yakıtımız da kalmadı."

# game/data/travel_events/crashed_ship.rpy:141
translate tr travel_event_crashed_ship_inside_ece942c3:

    # ANDRAS "The crew and I have decided to salvage what we can from the ship and head out."
    ANDRAS "Mürettebat ve ben gemiden kurtarabildiklerimizi toplayıp yola çıkmaya karar verdik."

# game/data/travel_events/crashed_ship.rpy:142
translate tr travel_event_crashed_ship_inside_7d01dea4:

    # ANDRAS "Maybe we can etch out some kind of existence out here."
    ANDRAS "Belki burada bir tür varoluş kazıyabiliriz."

# game/data/travel_events/crashed_ship.rpy:143
translate tr travel_event_crashed_ship_inside_9c0c2393:

    # ANDRAS "It might be a simple life... {i}But at least we're alive.{/i}"
    ANDRAS "Basit bir hayat olabilir... {i}Ama en azından hayattayız.{/i}"

# game/data/travel_events/crashed_ship.rpy:144
translate tr travel_event_crashed_ship_inside_2d52d85d:

    # ANDRAS "... The gods."
    ANDRAS "... Tanrılar."

# game/data/travel_events/crashed_ship.rpy:145
translate tr travel_event_crashed_ship_inside_6c5751a7:

    # ANDRAS "How the fuck did it come to this?"
    ANDRAS "Bu nasıl bu hale geldi?"

# game/data/travel_events/crashed_ship.rpy:146
translate tr travel_event_crashed_ship_inside_94c58f75:

    # ANDRAS "We blame it all on Malakai and his damned war, but in the end, maybe it was just our blind faith that sealed our fates."
    ANDRAS "Hepsini Malakai'ye ve onun lanet savaşına bağlıyoruz, ama sonunda, belki de kaderimizi mühürleyen sadece kör inancımızdı."

# game/data/travel_events/crashed_ship.rpy:147
translate tr travel_event_crashed_ship_inside_2820ff0b:

    # ANDRAS "We always presumed the gods were better than us, wiser, {i}more{/i} than us."
    ANDRAS "Her zaman tanrıların bizden daha iyi, daha bilge, {i}daha fazlası{/i} olduğunu varsaydık."

# game/data/travel_events/crashed_ship.rpy:148
translate tr travel_event_crashed_ship_inside_b9ea5e3e:

    # ANDRAS "{i}But in the end, they fell to all the same trappings we do.{/i}"
    ANDRAS "{i}Ama sonunda, onlar da bizim düştüğümüz aynı tuzaklara düştüler.{/i}"

# game/data/travel_events/crashed_ship.rpy:149
translate tr travel_event_crashed_ship_inside_e5b270d3:

    # ANDRAS "{i}And they dragged everyone down with them.{/i}"
    ANDRAS "{i}Ve herkesi kendileriyle birlikte aşağı sürüklediler.{/i}"

# game/data/travel_events/crashed_ship.rpy:150
translate tr travel_event_crashed_ship_inside_8a41f029:

    # ANDRAS "... Fuck the gods."
    ANDRAS "... Tanrıların canı cehenneme."

# game/data/travel_events/crashed_ship.rpy:151
translate tr travel_event_crashed_ship_inside_1216340c:

    # ANDRAS "This is Captain Andras of the Maylark, signing off for the last time."
    ANDRAS "Ben Maylark Kaptanı Andras, son kez çıkış yapıyorum."

# game/data/travel_events/crashed_ship.rpy:152
translate tr travel_event_crashed_ship_inside_10ce0df8:

    # "The image flickered, then began replaying."
    "Görüntü titreşti, sonra tekrar oynamaya başladı."

# game/data/travel_events/crashed_ship.rpy:155
translate tr travel_event_crashed_ship_inside_9d9f6087:

    # MC @ think "What do you make of that?"
    MC @ think "Bundan ne çıkarıyorsun?"

# game/data/travel_events/crashed_ship.rpy:157
translate tr travel_event_crashed_ship_inside_df5f47d2:

    # MARKUS @ talk "Jumping stars... Malakai's war... If this is from the Second War of the Gods... it's ancient."
    MARKUS @ talk "Yıldızları atlamak... Malakai'nin savaşı... Eğer bu İkinci Tanrı Savaşı'ndan ise... çok eski."

# game/data/travel_events/crashed_ship.rpy:161
translate tr travel_event_crashed_ship_inside_ad56e14d:

    # SYPHA @ talk "We shouldn't linger."
    SYPHA @ talk "Oyalanmamalıyız."

# game/data/travel_events/crashed_ship.rpy:162
translate tr travel_event_crashed_ship_inside_613528ce:

    # SYPHA @ think "Let ghosts rest."
    SYPHA @ think "Hayaletleri dinlensin."

# game/data/travel_events/crashed_ship.rpy:171
translate tr travel_event_crashed_ship_inside_17813b31:

    # "Most of it had decayed."
    "Çoğu çürümüştü."

# game/data/travel_events/crashed_ship.rpy:172
translate tr travel_event_crashed_ship_inside_1bcd7585:

    # "Anything that once had purpose crumbled in my hands."
    "Bir zamanlar amacı olan her şey ellerimde ufalandı."

# game/data/travel_events/crashed_ship.rpy:173
translate tr travel_event_crashed_ship_inside_e4d9e770:

    # "Except... one thing."
    "...bir şey hariç."

# game/data/travel_events/crashed_ship.rpy:174
translate tr travel_event_crashed_ship_inside_d79ab9c3:

    # "A small metal box."
    "Küçük bir metal kutu."

# game/data/travel_events/crashed_ship.rpy:175
translate tr travel_event_crashed_ship_inside_4b38b6fa:

    # "Inside, a glowing blue crystal pulsed rhythmically."
    "İçinde, parlayan mavi bir kristal ritmik olarak nabız gibi atıyordu."

# game/data/travel_events/crashed_ship.rpy:179
translate tr travel_event_crashed_ship_inside_50da1bb3:

    # "I reached in and took the orb."
    "Uzanıp küreyi aldım."

# game/data/travel_events/crashed_ship.rpy:180
translate tr travel_event_crashed_ship_inside_1343b6dc:

    # "It detached easily from its cables."
    "Kablolarından kolayca ayrıldı."

# game/data/travel_events/crashed_ship.rpy:181
translate tr travel_event_crashed_ship_inside_1797a4db:

    # "As I did, the specter's loop stopped."
    "Bunu yaptığımda, hayaletin döngüsü durdu."

# game/data/travel_events/crashed_ship.rpy:184
translate tr travel_event_crashed_ship_inside_eb9a0d09:

    # MARKUS @ angry "What did you do?"
    MARKUS @ angry "Ne yaptın?"

# game/data/travel_events/crashed_ship.rpy:185
translate tr travel_event_crashed_ship_inside_c2f71451:

    # MC @ talk "I just took this."
    MC @ talk "Sadece bunu aldım."

# game/data/travel_events/crashed_ship.rpy:186
translate tr travel_event_crashed_ship_inside_62d7245e:

    # MC @ talk "Looks like a power crystal, doesn't it?"
    MC @ talk "Güç kristaline benziyor, değil mi?"

# game/data/travel_events/crashed_ship.rpy:187
translate tr travel_event_crashed_ship_inside_bfea208f:

    # MARKUS @ think "Not like any I've seen."
    MARKUS @ think "Gördüğüm hiçbir şeye benzemiyor."

# game/data/travel_events/crashed_ship.rpy:188
translate tr travel_event_crashed_ship_inside_4bb30869:

    # MARKUS @ talk "Let's get out of here."
    MARKUS @ talk "Buradan çıkalım."

# game/data/travel_events/crashed_ship.rpy:190
translate tr travel_event_crashed_ship_inside_bb73d609:

    # MC @ talk "Yeah..."
    MC @ talk "Evet..."

# game/data/travel_events/crashed_ship.rpy:192
translate tr travel_event_crashed_ship_inside_9204ef9e:

    # "I decided not to touch anything."
    "Hiçbir şeye dokunmamaya karar verdim."

# game/data/travel_events/crashed_ship.rpy:194
translate tr travel_event_crashed_ship_inside_fdc2c975:

    # MARKUS @ talk "Ready to go?"
    MARKUS @ talk "Gitmeye hazır mısın?"

# game/data/travel_events/crashed_ship.rpy:195
translate tr travel_event_crashed_ship_inside_9ea05690:

    # MC @ talk "Yeah, let's leave this place."
    MC @ talk "Evet, burayı terk edelim."

# game/data/travel_events/crashed_ship.rpy:197
translate tr travel_event_crashed_ship_inside_6abc0e34:

    # MC @ talk "Let's leave then."
    MC @ talk "Hadi gidelim o zaman."

# game/data/travel_events/crashed_ship.rpy:199
translate tr travel_event_crashed_ship_inside_0babc806:

    # "We climbed out of the chasm and continued on."
    "Yarıktan tırmandık ve yolumuza devam ettik."

