# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:5
translate tr fortress_inn_vivian_firsttime_6915a7ba:

    # "Upon entering, a cheerful dark-haired woman made her way towards me with a frothing ale in hand."
    "İçeri girdiğimde, neşeli, koyu saçlı bir kadın elinde köpüren bir birayla bana doğru yürüdü."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:7
translate tr fortress_inn_vivian_firsttime_bc4ecc67:

    # VIVIAN @ smile "Welcome... Welcome to {i}The Dancing Frog.{/i}"
    VIVIAN @ smile "Hoş geldiniz... {i}Dans Eden Kurbağa'ya{/i} hoş geldiniz."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:8
translate tr fortress_inn_vivian_firsttime_ebf65c0e:

    # VIVIAN @ talk "Call me Vivian. If you need anything, please ask."
    VIVIAN @ talk "Bana Vivian de. Bir şeye ihtiyacın olursa lütfen sor."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:9
translate tr fortress_inn_vivian_firsttime_a4972b9d:

    # VIVIAN @ talk "Moharius! We have new guests!"
    VIVIAN @ talk "Moharius! Yeni misafirlerimiz var!"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:10
translate tr fortress_inn_vivian_firsttime_c533aae6:

    # "The tavern owner nodded, wiping one of his cups clean. He said nothing, simply nodding."
    "Meyhane sahibi başını salladı, bardaklarından birini temizledi. Hiçbir şey söylemedi, sadece başını salladı."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:15
translate tr fortress_inn_vivian_talk_a6684897:

    # VIVIAN @ smile "How can I help?"
    VIVIAN @ smile "Nasıl yardımcı olabilirim?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:18
translate tr fortress_inn_vivian_talk_menu_7a2ece67:

    # VIVIAN @ smile "Drink or food, sir?"
    VIVIAN @ smile "İçecek mi yemek mi, beyefendi?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:22
translate tr fortress_inn_vivian_talk_menu_9d55b0d6:

    # VIVIAN @ smile "Ale, I presume?"
    VIVIAN @ smile "Bira, tahmin ediyorum?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:23
translate tr fortress_inn_vivian_talk_menu_3c65e305:

    # VIVIAN @ smile "Or would you prefer some of our wine?"
    VIVIAN @ smile "Yoksa şarabımızdan tercih eder misiniz?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:24
translate tr fortress_inn_vivian_talk_menu_c6944597:

    # MC @ smile "Ale will do nicely."
    MC @ smile "Bira gayet iyi olur."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:25
translate tr fortress_inn_vivian_talk_menu_4cd2cfea:

    # VIVIAN @ talk "Of course, sir."
    VIVIAN @ talk "Tabii ki, beyefendi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:26
translate tr fortress_inn_vivian_talk_menu_a7a07c2a:

    # "Vivian made her way to the bar before returning with a jug of ale topped with a thick white froth, which she carefully placed before me."
    "Vivian bara gitti, sonra üstü kalın beyaz köpükle kaplı bir sürahi birayla döndü, dikkatlice önüme koydu."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:27
translate tr fortress_inn_vivian_talk_menu_b64a9558:

    # VIVIAN @ smile "Please, enjoy."
    VIVIAN @ smile "Lütfen, afiyet olsun."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:29
translate tr fortress_inn_vivian_talk_menu_30543096:

    # "I sipped the drink... It was a remarkably good ale."
    "İçkiden bir yudum aldım... Oldukça güzel bir biraydı."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:32
translate tr fortress_inn_vivian_talk_menu_8e6e58c9:

    # VIVIAN @ smile "Of course, sir. We have roasted rabbit with vegetables as today's special."
    VIVIAN @ smile "Tabii ki, beyefendi. Bugünün spesiyali olarak sebzeli kızarmış tavşanımız var."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:33
translate tr fortress_inn_vivian_talk_menu_e557b61a:

    # MC @ smile "I'll take that."
    MC @ smile "Onu alayım."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:36
translate tr fortress_inn_vivian_talk_menu_90c131f1:

    # "Vivian left and returned a short while later with a steaming plate of well-cooked food."
    "Vivian gitti ve kısa bir süre sonra dumanı tüten, iyi pişmiş bir tabak yemekle döndü."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:41
translate tr fortress_inn_vivian_talk_menu_b64a9558_1:

    # VIVIAN @ smile "Please, enjoy."
    VIVIAN @ smile "Lütfen, afiyet olsun."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:42
translate tr fortress_inn_vivian_talk_menu_a63081a3:

    # "She turned her attention to another table."
    "Dikkatini başka bir masaya çevirdi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:44
translate tr fortress_inn_vivian_talk_menu_60042db1:

    # VIVIAN @ talk "I'll come back shortly and give you some more time to decide."
    VIVIAN @ talk "Birazdan dönerim, karar vermen için biraz daha zaman veririm."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:48
translate tr fortress_inn_vivian_talk_menu_fc99ef41:

    # VIVIAN @ smile "What do you mean?"
    VIVIAN @ smile "Ne demek istiyorsun?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:49
translate tr fortress_inn_vivian_talk_menu_61561464:

    # VIVIAN @ smile "Merchants pass through. They want somewhere safe to rest, a comfortable bed, and food already prepared."
    VIVIAN @ smile "Tüccarlar geçiyor. Dinlenmek için güvenli bir yer, rahat bir yatak ve hazırlanmış yemek istiyorlar."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:50
translate tr fortress_inn_vivian_talk_menu_70200908:

    # VIVIAN @ talk "With the number of bandits and Demorai stalking the roads these days, setting up camp is a risky venture."
    VIVIAN @ talk "Bu günlerde yolları arşınlayan haydut ve Demorai sayısıyla kamp kurmak riskli bir girişim."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:51
translate tr fortress_inn_vivian_talk_menu_13c5ec22:

    # MC @ think "But what stops those same bandits and Demorai from looting these places and burning them down?"
    MC @ think "Peki aynı haydutların ve Demorai'nin buraları yağmalayıp yakmasını ne engelliyor?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:52
translate tr fortress_inn_vivian_talk_menu_4a7f29e8:

    # VIVIAN @ think "You ask a lot of questions, sir."
    VIVIAN @ think "Çok soru soruyorsunuz, beyefendi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:53
translate tr fortress_inn_vivian_talk_menu_f7359012:

    # MC @ talk "I'm curious how 'safe' this place really is before I lay my head here."
    MC @ talk "Başımı buraya koymadan önce buranın gerçekten ne kadar 'güvenli' olduğunu merak ediyorum."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:54
translate tr fortress_inn_vivian_talk_menu_d5f3b7cb:

    # "Vivian laughed softly."
    "Vivian yumuşakça güldü."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:55
translate tr fortress_inn_vivian_talk_menu_a5aba31f:

    # VIVIAN @ smile "I can assure you, sir, these inns aren't just safe because we have guards stationed nearby, {i}which we do.{/i}"
    VIVIAN @ smile "Sizi temin ederim beyefendi, bu hanlar sadece yakınlarda nöbetçi muhafızlarımız olduğu için güvenli değil, {i}ki var.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:56
translate tr fortress_inn_vivian_talk_menu_fb26d4e4:

    # VIVIAN @ talk "They're also partially funded by the GTC."
    VIVIAN @ talk "Ayrıca kısmen GTC tarafından finanse ediliyorlar."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:57
translate tr fortress_inn_vivian_talk_menu_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Ne?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:58
translate tr fortress_inn_vivian_talk_menu_91893563:

    # VIVIAN @ talk "It's fairly straightforward. The GTC offers generous loans to inns like ours and rotates guards between them to help keep each one secure."
    VIVIAN @ talk "Oldukça basit. GTC bizimki gibi hanlara cömert krediler sunuyor ve her birini güvende tutmaya yardımcı olması için aralarında muhafız değiştiriyor."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:59
translate tr fortress_inn_vivian_talk_menu_98295ad7:

    # VIVIAN @ talk "{i}Sometimes{/i}, they don't even offer loans... They simply hand over ownership of an inn."
    VIVIAN @ talk "{i}Bazen{/i} kredi bile teklif etmezler... Doğrudan bir hanın sahipliğini devrederler."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:60
translate tr fortress_inn_vivian_talk_menu_9befcaeb:

    # MC @ think "Generosity and the GTC aren't two things I'd ever expect to hear in the same sentence."
    MC @ think "Cömertlik ve GTC, aynı cümle içinde duymayı asla beklemeyeceğim iki şey."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:61
translate tr fortress_inn_vivian_talk_menu_874c91da:

    # VIVIAN @ talk "They don't do it out of generosity. They do it because it's pragmatic, sir."
    VIVIAN @ talk "Bunu cömertlikten yapmıyorlar. Pragmatik olduğu için yapıyorlar, beyefendi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:62
translate tr fortress_inn_vivian_talk_menu_4b2e1a23:

    # VIVIAN @ talk "If the roads aren't safe enough... If merchants no longer wish to travel them... Then the GTC loses far more coin than it spends investing in us."
    VIVIAN @ talk "Yollar yeterince güvenli değilse... Tüccarlar artık seyahat etmek istemezlerse... O zaman GTC bize yatırım yapmaktan çok daha fazla para kaybeder."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:63
translate tr fortress_inn_vivian_talk_menu_516cf5a4:

    # VIVIAN @ smile "That's all there is to it."
    VIVIAN @ smile "Olay bundan ibaret."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:67
translate tr fortress_inn_vivian_talk_menu_dc266b8e:

    # VIVIAN @ angry "{i}*Ahem!*{/i}"
    VIVIAN @ angry "{i}*Öhöm!*{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:68
translate tr fortress_inn_vivian_talk_menu_774e67a7:

    # "She gently kicked me beneath the table."
    "Masanın altından beni nazikçe tekmeledi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:69
translate tr fortress_inn_vivian_talk_menu_e14695e6:

    # MC @ angry "Ow."
    MC @ angry "Ah."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:70
translate tr fortress_inn_vivian_talk_menu_61c12544:

    # VIVIAN @ smile "The little one is fine."
    VIVIAN @ smile "Ufaklık iyi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:71
translate tr fortress_inn_vivian_talk_menu_f38d8de3:

    # VIVIAN @ angry "Her {i}father{/i} continues to be absent from her life."
    VIVIAN @ angry "{i}Babası{/i} onun hayatında olmamaya devam ediyor."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:72
translate tr fortress_inn_vivian_talk_menu_efbc1159:

    # MC @ surprised "I-"
    MC @ surprised "Ben-"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:73
translate tr fortress_inn_vivian_talk_menu_a028078b:

    # VIVIAN @ sad "{i}*Sigh*{/i}"
    VIVIAN @ sad "{i}*İç çekiş*{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:74
translate tr fortress_inn_vivian_talk_menu_5538ba29:

    # VIVIAN @ talk "It's fine, please... I understand."
    VIVIAN @ talk "Sorun değil, lütfen... Anlıyorum."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:75
translate tr fortress_inn_vivian_talk_menu_25e85aed:

    # "She paused."
    "Durdu."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:76
translate tr fortress_inn_vivian_talk_menu_fd3b88ce:

    # VIVIAN @ talk "{i}What we have.{/i}"
    VIVIAN @ talk "{i}Bizimki.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:77
translate tr fortress_inn_vivian_talk_menu_3d540872:

    # VIVIAN @ talk "But if you're not going to be a steady figure in her life, I'd prefer you kept your distance until she's old enough."
    VIVIAN @ talk "Ama onun hayatında sabit bir figür olmayacaksan, yeterince büyüyene kadar mesafeni korumanı tercih ederim."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:78
translate tr fortress_inn_vivian_talk_menu_afad818b:

    # "Her words stung slightly, but given my travels and the path I was on, perhaps she was right."
    "Sözleri biraz incitti, ama seyahatlerim ve olduğum yol düşünüldüğünde, belki de haklıydı."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:82
translate tr fortress_inn_vivian_talk_menu_7ee21ce0:

    # "Vivian didn't answer immediately. Instead, she studied me to make sure we meant the same thing."
    "Vivian hemen cevap vermedi. Bunun yerine aynı şeyi kastettiğimizden emin olmak için beni süzdü."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:83
translate tr fortress_inn_vivian_talk_menu_78c4f91c:

    # "Satisfied we did, she smiled coyly."
    "Öyle olduğuna ikna olunca mahcupça gülümsedi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:84
translate tr fortress_inn_vivian_talk_menu_df2b9f3a:

    # VIVIAN @ smile "... Yes, sir."
    VIVIAN @ smile "... Evet, beyefendi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:85
translate tr fortress_inn_vivian_talk_menu_7c5cb1fd:

    # VIVIAN @ smile "I can provide you with some drinks and... {i}companionship{/i} this evening."
    VIVIAN @ smile "Bu akşam size içkiler ve biraz... {i}arkadaşlık{/i} sağlayabilirim."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:86
translate tr fortress_inn_vivian_talk_menu_02a671e2:

    # VIVIAN @ lewd "... For an additional fee."
    VIVIAN @ lewd "... Ek bir ücret karşılığında."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:87
translate tr fortress_inn_vivian_talk_menu_0b0ca66a:

    # VIVIAN @ talk "You'll have to get a room here, of course."
    VIVIAN @ talk "Tabii ki burada bir oda tutmanız gerekecek."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:88
translate tr fortress_inn_vivian_talk_menu_15bdbee2:

    # VIVIAN @ lewd "Are you... {i}interested in some evening entertainment, sir?{/i}"
    VIVIAN @ lewd "Bu akşam biraz... {i}akşam eğlencesiyle ilgileniyor musunuz, beyefendi?{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:92
translate tr fortress_inn_vivian_talk_menu_6897ffea:

    # VIVIAN @ smile "I shall stop by your room tonight with a bottle of wine then, sir."
    VIVIAN @ smile "O zaman bu gece bir şişe şarapla odanıza uğrarım, beyefendi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:94
translate tr fortress_inn_vivian_talk_menu_191654cc:

    # VIVIAN @ talk "Very well..."
    VIVIAN @ talk "Pekala..."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:97
translate tr fortress_inn_vivian_talk_menu_f2b1990d:

    # VIVIAN @ smile "Stay safe on the roads, sir."
    VIVIAN @ smile "Yollarda güvende kalın, beyefendi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:102
translate tr fortress_inn_moharius_talk_501fe4f3:

    # MOHARIUS @ talk "Can I help you?"
    MOHARIUS @ talk "Yardımcı olabilir miyim?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:105
translate tr fortress_inn_moharius_talk_menu_a63d05bd:

    # MOHARIUS @ talk "Two hundred coins."
    MOHARIUS @ talk "İki yüz altın."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:110
translate tr fortress_inn_moharius_talk_menu_bfc5ecec:

    # "Carefully, he placed a small, faded iron key into my palm."
    "Dikkatlice, küçük, solmuş bir demir anahtarı avucuma koydu."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:111
translate tr fortress_inn_moharius_talk_menu_94757f82:

    # MOHARIUS @ talk "Furthest room on the right."
    MOHARIUS @ talk "Sağdaki en uçtaki oda."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:112
translate tr fortress_inn_moharius_talk_menu_42235545:

    # MOHARIUS @ talk "We hope you enjoy your stay with us."
    MOHARIUS @ talk "Bizimle konaklamanızın keyfini çıkarmanızı umuyoruz."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:115
translate tr fortress_inn_moharius_talk_menu_974ae7e2:

    # MOHARIUS @ talk "Let me know if you want a room."
    MOHARIUS @ talk "Bir oda isterseniz haber verin."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:116
translate tr fortress_inn_moharius_talk_menu_5cecbad1:

    # MOHARIUS @ talk "Otherwise, Vivian can sort you out with food and drinks, sir."
    MOHARIUS @ talk "Aksi takdirde, Vivian size yiyecek ve içecek konusunda yardımcı olabilir, efendim."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:119
translate tr fortress_inn_moharius_talk_menu_531f9628:

    # MOHARIUS @ talk "Come see me if you need accommodation for the evening, sir."
    MOHARIUS @ talk "Akşam için konaklamaya ihtiyacınız olursa bana gelin, efendim."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:126
translate tr fortress_inn_vivian_night_92afe15c:

    # "... That night, there was a gentle knock at my door."
    "... O gece, kapımda hafif bir vuruş duyuldu."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:133
translate tr fortress_inn_vivian_night_916a0157:

    # "As I turned to open it, Vivian carefully stepped into the room, her hips swaying with a slightly exaggerated, playful rhythm."
    "Açmak için döndüğümde, Vivian kalçalarını hafifçe abartılı, şakacı bir ritimle sallayarak dikkatlice odaya girdi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:134
translate tr fortress_inn_vivian_night_ffd02301:

    # VIVIAN @ smile "Sir..."
    VIVIAN @ smile "Efendim..."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:135
translate tr fortress_inn_vivian_night_b5ab9d58:

    # VIVIAN @ smile "Before we begin, there is the matter of my fee."
    VIVIAN @ smile "Başlamadan önce, ücretim meselesi var."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:136
translate tr fortress_inn_vivian_night_07e3cb7b:

    # MC @ think "Go on?"
    MC @ think "Devam et?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:137
translate tr fortress_inn_vivian_night_9a9c9b4a:

    # VIVIAN @ smile "Three hundred for my mouth, five hundred and fifty for my womanhood..."
    VIVIAN @ smile "Ağzım için üç yüz, kadınlığım için beş yüz elli..."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:138
translate tr fortress_inn_vivian_night_a36de539:

    # VIVIAN @ smile "And seven fifty for my..."
    VIVIAN @ smile "Ve yedi elli... şeyim için..."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:139
translate tr fortress_inn_vivian_night_082ddbf4:

    # "She paused, letting the word linger."
    "Duraksadı, kelimenin havada kalmasına izin verdi."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:140
translate tr fortress_inn_vivian_night_334e2f14:

    # VIVIAN @ lewd "{i}Rear.{/i}"
    VIVIAN @ lewd "{i}Arka taraf.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:147
translate tr replay_vivian_bj_acbef988:

    # VIVIAN @ smile "Good choice."
    VIVIAN @ smile "İyi seçim."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:148
translate tr replay_vivian_bj_6b6b29ec:

    # "Vivian stripped herself naked, letting her clothes slip from her body and fall to the floor."
