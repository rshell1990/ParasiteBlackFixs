# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:415
translate tr fortress_inn_vivian_impreg_e25f5309:

    # "My eyes drifted down towards her belly as I almost instinctively sensed the change."
    "Gözlerim neredeyse içgüdüsel olarak değişimi hissettiğim için karnına kaydı."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:416
translate tr fortress_inn_vivian_impreg_66b2de91:

    # MC @ surprised "Are you-"
    MC @ surprised "Yoksa sen-"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:418
translate tr fortress_inn_vivian_impreg_9dcc9313:

    # VIVIAN @ talk "Yes, and it's yours."
    VIVIAN @ talk "Evet, ve o senin."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:419
translate tr fortress_inn_vivian_impreg_acfaa8e7:

    # MC @ talk "... Do you need coin or anything from me?"
    MC @ talk "... Benden para ya da bir şey istiyor musun?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:420
translate tr fortress_inn_vivian_impreg_b78b683f:

    # VIVIAN @ talk "No."
    VIVIAN @ talk "Hayır."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:421
translate tr fortress_inn_vivian_impreg_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "Ne?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:422
translate tr fortress_inn_vivian_impreg_3d9d7297:

    # VIVIAN @ sad "Just... I'd prefer if you weren't in and out of her life."
    VIVIAN @ sad "Sadece... Onun hayatına girip çıkmasan daha iyi olur."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:423
translate tr fortress_inn_vivian_impreg_6ae44f1c:

    # VIVIAN @ sad "You're with the Adventurers' Guild. You're hardly the settling-down type."
    VIVIAN @ sad "Sen Maceracılar Loncası'ndansın. Yerleşik hayata pek uygun biri değilsin."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:424
translate tr fortress_inn_vivian_impreg_357a23bb:

    # VIVIAN @ sad "I don't mind you passing by to see how the littlun is doing, but please..."
    VIVIAN @ sad "Ufaklığın nasıl olduğunu görmek için uğraman sorun değil, ama lütfen..."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:425
translate tr fortress_inn_vivian_impreg_4a0e8b31:

    # VIVIAN @ talk "I'll tell her that her father is a brave adventurer, but I'm not making promises about when you'll be back."
    VIVIAN @ talk "Ona babasının cesur bir maceracı olduğunu söyleyeceğim, ama ne zaman döneceğin konusunda söz veremem."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:426
translate tr fortress_inn_vivian_impreg_2c355828:

    # VIVIAN @ talk "If you want to get to know your daughter."
    VIVIAN @ talk "Eğer kızını tanımak istiyorsan."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:429
translate tr fortress_inn_vivian_impreg_09ad922e:

    # VIVIAN @ talk "Yes... {i}Again.{/i}"
    VIVIAN @ talk "Evet... {i}Yine.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:430
translate tr fortress_inn_vivian_impreg_8d4c87e8:

    # VIVIAN @ angry "Have you considered {i}not{/i} finishing inside me so often?"
    VIVIAN @ angry "İçime bu kadar sık boşalmamayı {i}hiç{/i} düşündün mü?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:431
translate tr fortress_inn_vivian_impreg_4daa591b:

    # MC @ talk "Have you considered not begging me to?"
    MC @ talk "Bana bunun için yalvarmamayı düşündün mü?"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:432
translate tr fortress_inn_vivian_impreg_496aa71a:

    # VIVIAN @ talk "Hmph... Point taken."
    VIVIAN @ talk "Hıh... Haklısın."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:433
translate tr fortress_inn_vivian_impreg_0076e300:

    # VIVIAN @ talk "Nothing has changed. The same rules apply."
    VIVIAN @ talk "Hiçbir şey değişmedi. Aynı kurallar geçerli."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:434
translate tr fortress_inn_vivian_impreg_181a7131:

    # VIVIAN @ talk "If you want to know this little one as well."
    VIVIAN @ talk "Bu ufaklığı da tanımak istiyorsan."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:436
translate tr fortress_inn_vivian_impreg_dcdf2687:

    # VIVIAN @ talk "{i}If you're still alive by then.{/i}"
    VIVIAN @ talk "{i}O zamana kadar hâlâ hayattaysan.{/i}"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:437
translate tr fortress_inn_vivian_impreg_4268be46:

    # VIVIAN @ talk "Come back when she's old enough."
    VIVIAN @ talk "Yeterince büyüdüğünde geri gel."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:439
translate tr fortress_inn_vivian_impreg_645057ef:

    # "With that, Vivian turned to tend to the other tables."
    "Bunun üzerine Vivian diğer masalarla ilgilenmek için döndü."

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:441
translate tr fortress_inn_vivian_impreg_193677a4:

    # MC @ sad "(As depressing as her words were... Perhaps there was some truth in them.)"
    MC @ sad "(Sözleri ne kadar iç karartıcı olsa da... Belki içlerinde bir parça doğruluk vardı.)"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:442
translate tr fortress_inn_vivian_impreg_415a8152:

    # MC "(Still, hopefully there was a future for me in her life.)"
    MC "(Yine de, umarım onun hayatında benim için bir gelecek vardır.)"

# game/data/travel_events/fortress_inn/fortress_inn_2_vivian_frog.rpy:443
translate tr fortress_inn_vivian_impreg_6e9e356e:

    # MC "(... Presuming this infernal war didn't kill me first.)"
    MC "(... Tabii bu cehennemi savaş beni önce öldürmezse.)"

