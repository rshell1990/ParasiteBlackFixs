    # ELENA @ talk "Have you ever thought about leaving Alderay?"
    ELENA @ talk "Hiç Alderay'den ayrılmayı düşündün mü?"

# game/data/travel_events/travel_banter.rpy:39
translate tr travelmodebanter_map_elena_mc_1_4a2613e4:

    # MC @ think "Where'd that come from?"
    MC @ think "Bu da nereden çıktı?"

# game/data/travel_events/travel_banter.rpy:40
translate tr travelmodebanter_map_elena_mc_1_9828a89f:

    # ELENA @ talk "Just... curiosity."
    ELENA @ talk "Sadece... merak."

# game/data/travel_events/travel_banter.rpy:41
translate tr travelmodebanter_map_elena_mc_1_e722756d:

    # ELENA @ talk "Growing up at Thornfalls, I dreamt of faraway places and adventures."
    ELENA @ talk "Thornfalls'te büyürken, uzak yerleri ve maceraları hayal ederdim."

# game/data/travel_events/travel_banter.rpy:42
translate tr travelmodebanter_map_elena_mc_1_6308ffa5:

    # ELENA @ smile "It seems silly now, but... I still think about the places I want to see."
    ELENA @ smile "Şimdi aptalca geliyor, ama... Hala görmek istediğim yerleri düşünüyorum."

# game/data/travel_events/travel_banter.rpy:45
translate tr travelmodebanter_map_elena_mc_1_96b1d0a3:

    # ELENA @ shock "Just like that?"
    ELENA @ shock "Aynen böyle mi?"

# game/data/travel_events/travel_banter.rpy:46
translate tr travelmodebanter_map_elena_mc_1_bb7eda56:

    # MC @ smile "There's a whole world out there."
    MC @ smile "Dışarıda bütün bir dünya var."

# game/data/travel_events/travel_banter.rpy:47
translate tr travelmodebanter_map_elena_mc_1_c579fce3:

    # ELENA @ smile "And would there be room for one more?"
    ELENA @ smile "Peki bir kişiye daha yer olur muydu?"

# game/data/travel_events/travel_banter.rpy:48
translate tr travelmodebanter_map_elena_mc_1_6bc977b7:

    # MC @ smile2 "I'm sure I could fit you in."
    MC @ smile2 "Eminim seni sığdırabilirim."

# game/data/travel_events/travel_banter.rpy:49
translate tr travelmodebanter_map_elena_mc_1_5b4dee46:

    # ELENA @ smile "I must admit, I'm surprised."
    ELENA @ smile "İtiraf etmeliyim, şaşırdım."

# game/data/travel_events/travel_banter.rpy:50
translate tr travelmodebanter_map_elena_mc_1_082ad89d:

    # ELENA @ smile "Markus told me all you two wanted was a quiet life behind palace walls."
    ELENA @ smile "Markus bana ikinizin tek istediğinin saray duvarları arkasında sessiz bir hayat olduğunu söyledi."

# game/data/travel_events/travel_banter.rpy:51
translate tr travelmodebanter_map_elena_mc_1_0d739712:

    # MC @ talk "Funny, isn't it?"
    MC @ talk "Komik, değil mi?"

# game/data/travel_events/travel_banter.rpy:52
translate tr travelmodebanter_map_elena_mc_1_995149d2:

    # MC @ talk "That dream started feeling more like a cage after... everything."
    MC @ talk "O rüya, her şeyden sonra... daha çok bir kafes gibi gelmeye başladı."

# game/data/travel_events/travel_banter.rpy:53
translate tr travelmodebanter_map_elena_mc_1_e5753e06:

    # ELENA @ smile "No. Not strange at all. Not to me."
    ELENA @ smile "Hayır. Hiç de garip değil. Bana göre değil."

# game/data/travel_events/travel_banter.rpy:55
translate tr travelmodebanter_map_elena_mc_1_19758ec6:

    # ELENA @ talk "Ahh, you seem more like a homebody."
    ELENA @ talk "Ahh, sen daha çok ev kuşu gibi görünüyorsun."

# game/data/travel_events/travel_banter.rpy:56
translate tr travelmodebanter_map_elena_mc_1_b3517fc1:

    # MC @ think "Oh?"
    MC @ think "Oh?"

# game/data/travel_events/travel_banter.rpy:57
translate tr travelmodebanter_map_elena_mc_1_01b971be:

    # ELENA @ grumpy "You and Markus dreamed of royal service, didn't you?"
    ELENA @ grumpy "Sen ve Markus kraliyet hizmetini hayal ettiniz, değil mi?"

# game/data/travel_events/travel_banter.rpy:58
translate tr travelmodebanter_map_elena_mc_1_6204f33e:

    # ELENA @ smile "Not exactly an adventurous life."
    ELENA @ smile "Pek macera dolu bir hayat değil."

# game/data/travel_events/travel_banter.rpy:59
translate tr travelmodebanter_map_elena_mc_1_ab966d56:

    # MC @ talk "Is wanting a quiet life so wrong?"
    MC @ talk "Sessiz bir hayat istemek bu kadar yanlış mı?"

# game/data/travel_events/travel_banter.rpy:60
translate tr travelmodebanter_map_elena_mc_1_4ca3d53f:

    # ELENA @ smile "Not at all."
    ELENA @ smile "Hiç de değil."

# game/data/travel_events/travel_banter.rpy:61
translate tr travelmodebanter_map_elena_mc_1_b2753dd2:

    # ELENA @ smile "It's your life to live."
    ELENA @ smile "Bu senin yaşayacağın hayat."

# game/data/travel_events/travel_banter.rpy:62
translate tr travelmodebanter_map_elena_mc_1_cdd397f7:

    # MC @ think "{i}... And when this war is one day over.{/i}"
    MC @ think "{i}... Ve bu savaş bir gün bittiğinde.{/i}"

# game/data/travel_events/travel_banter.rpy:63
translate tr travelmodebanter_map_elena_mc_1_1cfe520f:

    # MC @ think "{i}Is it a life you'd want to be a part of?{/i}"
    MC @ think "{i}Bu onun bir parçası olmak isteyeceğin bir hayat mı?{/i}"

# game/data/travel_events/travel_banter.rpy:64
translate tr travelmodebanter_map_elena_mc_1_4c9bb63b:

    # ELENA @ lewd "L-Let's leave that question for another day."
    ELENA @ lewd "B-Bu soruyu başka bir güne bırakalım."

# game/data/travel_events/travel_banter.rpy:74
translate tr travelmodebanter_map_elena_mc_2_dfcc99a2:

    # ELENA @ grumpy "...Does it hurt?"
    ELENA @ grumpy "...Canın acıyor mu?"

# game/data/travel_events/travel_banter.rpy:76
translate tr travelmodebanter_map_elena_mc_2_bde6c2b6:

    # MC @ think "What?"
    MC @ think "Ne?"

# game/data/travel_events/travel_banter.rpy:77
translate tr travelmodebanter_map_elena_mc_2_4b60e47a:

    # ELENA @ grumpy "When you change into that thing... does it hurt?"
    ELENA @ grumpy "O şeye dönüştüğünde... canın acıyor mu?"

# game/data/travel_events/travel_banter.rpy:78
translate tr travelmodebanter_map_elena_mc_2_3496abfa:

    # MC @ talk "It... did. At first."
    MC @ talk "Eskiden... acıyordu. İlk başta."

# game/data/travel_events/travel_banter.rpy:80
translate tr travelmodebanter_map_elena_mc_2_0a297aba:

    # MC @ talk "It was agony."
    MC @ talk "İşkence gibiydi."

# game/data/travel_events/travel_banter.rpy:81
translate tr travelmodebanter_map_elena_mc_2_54e3ddd7:

    # MC @ talk "But it gets easier every time."
    MC @ talk "Ama her seferinde daha kolay oluyor."

# game/data/travel_events/travel_banter.rpy:83
translate tr travelmodebanter_map_elena_mc_2_c2fc29a5:

    # MC @ talk "Why do you ask?"
    MC @ talk "Neden soruyorsun?"

# game/data/travel_events/travel_banter.rpy:84
translate tr travelmodebanter_map_elena_mc_2_ede2ccf2:

    # ELENA @ sad "Just worried about you."
    ELENA @ sad "Sadece senin için endişelendim."

# game/data/travel_events/travel_banter.rpy:85
translate tr travelmodebanter_map_elena_mc_2_7cedfe97:

    # ELENA @ talk "How are you holding up? After everything that's happened so fast..."
    ELENA @ talk "Nasıl dayanıyorsun? Bu kadar hızlı olan her şeyden sonra..."

# game/data/travel_events/travel_banter.rpy:88
translate tr travelmodebanter_map_elena_mc_2_cf94bad7:

    # ELENA @ shock "Really? I'm surprised... most people would struggle."
    ELENA @ shock "Gerçekten mi? Şaşırdım... çoğu insan zorlanırdı."

# game/data/travel_events/travel_banter.rpy:89
translate tr travelmodebanter_map_elena_mc_2_094bce6b:

    # MC @ talk "There are doubts, sure. But we can actually change things now."
    MC @ talk "Şüpheler var, tabii. Ama şimdi gerçekten bir şeyleri değiştirebiliriz."

# game/data/travel_events/travel_banter.rpy:90
translate tr travelmodebanter_map_elena_mc_2_e1f4d040:

    # MC @ smile "Before the gift, I felt powerless. Like my life wasn't mine."
    MC @ smile "Hediye'den önce, güçsüz hissediyordum. Sanki hayatım benim değildi."

# game/data/travel_events/travel_banter.rpy:91
translate tr travelmodebanter_map_elena_mc_2_92dfa1e6:

    # MC @ smile "Now? It's like we finally have... {i}hope.{/i}"
    MC @ smile "Şimdi? Sanki sonunda... {i}umudumuz{/i} var."

# game/data/travel_events/travel_banter.rpy:92
translate tr travelmodebanter_map_elena_mc_2_73c0b9f3:

    # ELENA @ smile "You're starting to sound like a hero from the old tales."
    ELENA @ smile "Eski hikayelerdeki bir kahraman gibi konuşmaya başlıyorsun."

# game/data/travel_events/travel_banter.rpy:93
translate tr travelmodebanter_map_elena_mc_2_f18990c6:

    # MC @ smile "Let's not go that far."
    MC @ smile "O kadar ileri gitmeyelim."

# game/data/travel_events/travel_banter.rpy:94
translate tr travelmodebanter_map_elena_mc_2_91c8e0b3:

    # ELENA @ smile "Come. Let's keep moving."
    ELENA @ smile "Gel. Yürümeye devam edelim."

# game/data/travel_events/travel_banter.rpy:96
translate tr travelmodebanter_map_elena_mc_2_a4311795:

    # ELENA @ sad "That's... a relief. You can talk to me, you know."
    ELENA @ sad "Bu... rahatlatıcı. Benimle konuşabilirsin, biliyorsun."

# game/data/travel_events/travel_banter.rpy:97
translate tr travelmodebanter_map_elena_mc_2_b067621a:

    # MC @ smile "That means more than you think."
    MC @ smile "Bu sandığından daha fazla şey ifade ediyor."

# game/data/travel_events/travel_banter.rpy:98
translate tr travelmodebanter_map_elena_mc_2_42ddcd91:

    # ELENA @ smile "Come on. Let's keep moving."
    ELENA @ smile "Hadi. Yürümeye devam edelim."

# game/data/travel_events/travel_banter.rpy:100
translate tr travelmodebanter_map_elena_mc_2_2f15a7d9:

    # ELENA @ sad "I'm here if you want to talk."
    ELENA @ sad "Konuşmak istersen buradayım."

# game/data/travel_events/travel_banter.rpy:101
translate tr travelmodebanter_map_elena_mc_2_30d77ce8:

    # ELENA @ sad "It weighs heavy, doesn't it? Memories that won't let go..."
    ELENA @ sad "Ağır geliyor, değil mi? Bırakmayan anılar..."

# game/data/travel_events/travel_banter.rpy:102
translate tr travelmodebanter_map_elena_mc_2_1dce2974:

    # MC @ sad "..."
    MC @ sad "..."

# game/data/travel_events/travel_banter.rpy:103
translate tr travelmodebanter_map_elena_mc_2_6c08d76e:

    # ELENA @ sad "A-Anyway! I just wanted you to know you're not alone."
    ELENA @ sad "N-Neyse! Sadece yalnız olmadığını bilmeni istedim."

# game/data/travel_events/travel_banter.rpy:104
translate tr travelmodebanter_map_elena_mc_2_1a43d7a9:

    # ELENA @ talk "I'm here if you need me."
    ELENA @ talk "Bana ihtiyacın olursa buradayım."

# game/data/travel_events/travel_banter.rpy:105
translate tr travelmodebanter_map_elena_mc_2_ddf70b53:

    # MC @ smile "Thank you, Elena."
    MC @ smile "Teşekkür ederim, Elena."

# game/data/travel_events/travel_banter.rpy:106
translate tr travelmodebanter_map_elena_mc_2_0403d166:

    # ELENA @ smile "Come. Let's keep going."
    ELENA @ smile "Gel. Devam edelim."

# game/data/travel_events/travel_banter.rpy:116
translate tr travelmodebanter_map_elena_mc_3_romance_ed8a1411:

    # "While walking, something soft brushed against my side."
    "Yürürken, yumuşak bir şey yanıma sürtündü."

# game/data/travel_events/travel_banter.rpy:118
translate tr travelmodebanter_map_elena_mc_3_romance_899cf127:

    # "Elena passed me with a coy smile and a soft hum."
    "Elena çapkın bir gülümseme ve yumuşak bir mırıltıyla yanımdan geçti."

# game/data/travel_events/travel_banter.rpy:119
translate tr travelmodebanter_map_elena_mc_3_romance_fe9303c4:

    # ELENA @ smile "{i}*Happy humming*{/i}"
    ELENA @ smile "{i}*Mutlu mırıltı*{/i}"

# game/data/travel_events/travel_banter.rpy:120
translate tr travelmodebanter_map_elena_mc_3_romance_3321ea6a:

    # MC @ smile "Someone's in a good mood."
    MC @ smile "Birisi keyifli galiba."

# game/data/travel_events/travel_banter.rpy:122
translate tr travelmodebanter_map_elena_mc_3_romance_07f53f05:

    # ELENA @ smile "Of course. The weather's pleasant, the air is clean..."
    ELENA @ smile "Tabii ki. Hava hoş, hava temiz..."

# game/data/travel_events/travel_banter.rpy:123
translate tr travelmodebanter_map_elena_mc_3_romance_bc9974f6:

    # "She glanced back, her sultry eyes dancing."
    "Geri baktı, ateşli gözleri dans ediyordu."

# game/data/travel_events/travel_banter.rpy:124
translate tr travelmodebanter_map_elena_mc_3_romance_3f6ec57a:

    # ELENA @ smile "And {i}the view{/i} is quite nice, too."
    ELENA @ smile "Ve {i}manzara{/i} da oldukça güzel."

# game/data/travel_events/travel_banter.rpy:125
translate tr travelmodebanter_map_elena_mc_3_romance_eaad9ebd:

    # MC @ smile "The view, huh?"
    MC @ smile "Manzara, ha?"

# game/data/travel_events/travel_banter.rpy:126
translate tr travelmodebanter_map_elena_mc_3_romance_80da6f9e:

    # "Her tail brushed me again playfully as she walked ahead."
    "Kuyruğu yürürken beni tekrar şakacı bir şekilde sürtündü."

# game/data/travel_events/travel_banter.rpy:127
translate tr travelmodebanter_map_elena_mc_3_romance_f4fe840d:

    # ELENA @ smile "Yes. It's been on my mind a lot lately."
    ELENA @ smile "Evet. Son zamanlarda aklımda çok yer etti."

# game/data/travel_events/travel_banter.rpy:130
translate tr travelmodebanter_map_elena_mc_3_romance_c670f114:

    # MC @ smile "(Cute.)"
    MC @ smile "(Sevimli.)"

# game/data/travel_events/travel_banter.rpy:137
translate tr travelmodebanter_map_elena_markus_1_ddfff1fd:

    # MARKUS @ think "So, you're a lady, then?"
    MARKUS @ think "Yani, sen bir leydi misin?"

# game/data/travel_events/travel_banter.rpy:139
translate tr travelmodebanter_map_elena_markus_1_abecf88a:

    # ELENA @ talk "Yes, I do indeed belong to the female gender."
    ELENA @ talk "Evet, gerçekten de kadın cinsiyetine aidim."

# game/data/travel_events/travel_banter.rpy:140
translate tr travelmodebanter_map_elena_markus_1_d0033b5e:

    # MARKUS @ angry "You know that wasn't what I was talking about!"
    MARKUS @ angry "Bunu kastetmediğimi biliyorsun!"

# game/data/travel_events/travel_banter.rpy:141
translate tr travelmodebanter_map_elena_markus_1_3213a1a5:

    # MARKUS @ talk "I mean, you're a *lady* lady. Like, you grew up in some huge estate house."
    MARKUS @ talk "Yani, sen bir *leydi* leydisin. Hani, büyük bir malikanede büyüdün."

# game/data/travel_events/travel_banter.rpy:142
translate tr travelmodebanter_map_elena_markus_1_9316f5fc:

    # ELENA @ smile "Yes. The ones with the very long tables and lots of food on them."
    ELENA @ smile "Evet. Çok uzun masaları ve üzerlerinde bol yemek olanlar."

# game/data/travel_events/travel_banter.rpy:143
translate tr travelmodebanter_map_elena_markus_1_f6ced7d6:

    # ELENA @ smile "Are you going somewhere with this?"
    ELENA @ smile "Bunun bir amacı var mı?"

# game/data/travel_events/travel_banter.rpy:144
translate tr travelmodebanter_map_elena_markus_1_a54c70bc:

    # MARKUS @ talk "Sensitive much?"
    MARKUS @ talk "Alıngan mıyız biraz?"

# game/data/travel_events/travel_banter.rpy:146
translate tr travelmodebanter_map_elena_markus_1_2de858ba:

    # ELENA @ talk "I can assure you, manor house or not, my time at the Thornfalls was... difficult."
    ELENA @ talk "Seni temin ederim, malikane evi ya da değil, Thornfalls'teki zamanım... zordu."

# game/data/travel_events/travel_banter.rpy:147
translate tr travelmodebanter_map_elena_markus_1_6211068f:

    # MARKUS @ think "I find that hard to believe."
    MARKUS @ think "Buna inanmak zor."

# game/data/travel_events/travel_banter.rpy:148
translate tr travelmodebanter_map_elena_markus_1_298cf6f7:

    # MARKUS @ think "Did you ever have to worry about where your next meal would come from?"
    MARKUS @ think "Hiç bir sonraki öğününün nereden geleceğini merak etmek zorunda kaldın mı?"

# game/data/travel_events/travel_banter.rpy:149
translate tr travelmodebanter_map_elena_markus_1_24473bcf:

    # MARKUS @ think "Or constantly wonder when, not if, the next loved one would be taken by this infernal war?"
    MARKUS @ think "Ya da sürekli ne zaman, eğer değil, bir sonraki sevilen kişinin bu lanet savaş tarafından alınacağını merak ettin mi?"

# game/data/travel_events/travel_banter.rpy:150
translate tr travelmodebanter_map_elena_markus_1_3cdbde5f:

    # ELENA @ angry "No..."
    ELENA @ angry "Hayır..."

# game/data/travel_events/travel_banter.rpy:152
translate tr travelmodebanter_map_elena_markus_1_77cdaa2f:

    # ELENA @ angry "I just spent every night living in fear."
    ELENA @ angry "Ben sadece her geceyi korku içinde yaşayarak geçirdim."

# game/data/travel_events/travel_banter.rpy:153
translate tr travelmodebanter_map_elena_markus_1_d313e372:

    # ELENA @ angry "Let me tell you something, Markus."
    ELENA @ angry "Sana bir şey söyleyeyim, Markus."

# game/data/travel_events/travel_banter.rpy:154
translate tr travelmodebanter_map_elena_markus_1_f52bc4d7:

    # ELENA @ angry "It's one kind of hell to starve... it's another entirely to wonder if every meal you're served will be your last."
    ELENA @ angry "Açlıktan ölmek bir tür cehennemdir... sana servis edilen her öğünün son öğünün olup olmadığını merak etmek tamamen başka bir şeydir."

# game/data/travel_events/travel_banter.rpy:164
translate tr travelmodebanter_map_elena_markus_2_6b1dd249:

    # MARKUS @ talk "Tell me, Elena."
    MARKUS @ talk "Söyle bana, Elena."

# game/data/travel_events/travel_banter.rpy:166
translate tr travelmodebanter_map_elena_markus_2_10d78c40:

    # MARKUS @ talk "You must have spent some time traveling around before meeting us."
    MARKUS @ talk "Bizimle tanışmadan önce seyahat ederek biraz zaman geçirmiş olmalısın."

# game/data/travel_events/travel_banter.rpy:167
translate tr travelmodebanter_map_elena_markus_2_2f0ee648:

    # MARKUS @ smile "Got any interesting stories to tell?"
    MARKUS @ smile "Anlatacak ilginç hikayelerin var mı?"

# game/data/travel_events/travel_banter.rpy:168
translate tr travelmodebanter_map_elena_markus_2_c983087c:

    # ELENA @ grumpy "...A while back, while I was in Newyark, I heard about a 'wolf woman' and naturally, my interest was piqued."
    ELENA @ grumpy "...Bir süre önce, Newyark'tayken, bir 'kurt kadın' hakkında duydum ve doğal olarak, ilgim uyandı."

# game/data/travel_events/travel_banter.rpy:169
translate tr travelmodebanter_map_elena_markus_2_71871438:

    # ELENA @ talk "It didn't sound like any kind of Katai, so I thought perhaps I might finally find another of my kind."
    ELENA @ talk "Hiçbir Katai türüne benzemiyordu, bu yüzden belki sonunda kendi türümden birini bulabilirim diye düşündüm."

# game/data/travel_events/travel_banter.rpy:170
translate tr travelmodebanter_map_elena_markus_2_e936c5f8:

    # MARKUS @ think "What did you find?"
    MARKUS @ think "Ne buldun?"

# game/data/travel_events/travel_banter.rpy:171
translate tr travelmodebanter_map_elena_markus_2_2dd61dd9:

    # ELENA @ shock "It was a woman who had made some kind of... fur suit from different pelts of wolves."
    ELENA @ shock "Farklı kurt postlarından bir tür... kürk takım elbise yapmış bir kadındı."

# game/data/travel_events/travel_banter.rpy:173
translate tr travelmodebanter_map_elena_markus_2_03538783:

    # ELENA @ shock "She was running around on stage pretending to be a wolf!"
    ELENA @ shock "Sahnede kurtmuş gibi koşuyordu!"

# game/data/travel_events/travel_banter.rpy:174
translate tr travelmodebanter_map_elena_markus_2_cc301a3c:

    # ELENA @ shock "Can you imagine people doing such a strange thing?"
    ELENA @ shock "İnsanların böyle garip bir şey yaptığını hayal edebiliyor musun?"

# game/data/travel_events/travel_banter.rpy:175
translate tr travelmodebanter_map_elena_markus_2_0f3ab35d:

    # MARKUS @ think "...Too much salt in the air from the sea."
    MARKUS @ think "...Denizden gelen havada çok fazla tuz var."

# game/data/travel_events/travel_banter.rpy:176
translate tr travelmodebanter_map_elena_markus_2_f1fa7ebb:

    # MARKUS @ think "That's why all those Newyark folk are so strange."
    MARKUS @ think "Bu yüzden tüm o Newyark halkı çok garip."

# game/data/travel_events/travel_banter.rpy:186
translate tr travelmodebanter_map_elena_markus_3_8008183f:

    # ELENA @ smile "Markus, I'm curious about something..."
    ELENA @ smile "Markus, bir şeyi merak ediyorum..."

# game/data/travel_events/travel_banter.rpy:188
translate tr travelmodebanter_map_elena_markus_3_a04187b6:

    # MARKUS @ talk "Ask away."
    MARKUS @ talk "Sor bakalım."

