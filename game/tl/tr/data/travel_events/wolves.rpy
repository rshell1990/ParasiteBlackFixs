# game/data/travel_events/wolves.rpy:3
translate tr travel_event_wolves_d9365df9:

    # "While trekking my way through the forests, I heard the distinct sound of...{i}howling?{/i}"
    "Ormanlarda ilerlerken, belirgin sesi duydum...{i}uluma mı?{/i}"

# game/data/travel_events/wolves.rpy:4
translate tr travel_event_wolves_9123a2e4:

    # "From the tree lines, a pack of hungry wolves descended upon me, snarling and circling."
    "Ağaç sınırlarından, bir paket aç kurt üzerime çullandı, hırlayıp daire çizdi."

# game/data/travel_events/wolves.rpy:7
translate tr travel_event_wolves_b05c7a7b:

    # "The wolves whined and howled as they scattered the winds."
    "Kurtlar rüzgarlara dağılırken inleyip uldular."

# game/data/travel_events/wolves.rpy:8
translate tr travel_event_wolves_cda900f2:

    # MC "(Damn beasts!)"
    MC "(Lanet canavarlar!)"

# game/data/travel_events/wolves.rpy:16
translate tr travel_event_wolves_f567ab41:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Son kurt da acı içinde inlerken, şeyi hızla acısından kurtardım."

# game/data/travel_events/wolves.rpy:17
translate tr travel_event_wolves_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*İç çekiş*{/i}"

# game/data/travel_events/wolves.rpy:18
translate tr travel_event_wolves_ed59b7aa:

    # MC "(These poor things are half-starved, no wonder they're attacking on sight...)"
    MC "(Bu zavallı şeyler yarı açlıktan ölüyor, görür görmez saldırmalarına şaşmamalı...)"

# game/data/travel_events/wolves.rpy:22
translate tr travel_event_wolves_04301006:

    # MC @ think "I don't suppose {i}you{/i} could handle this?"
    MC @ think "Sanırım {i}bunu{/i} sen halledemezsin?"

# game/data/travel_events/wolves.rpy:23
translate tr travel_event_wolves_c3f644c4:

    # ELENA "I mean, {i}I could try.{/i}"
    ELENA "Yani, {i}deneyebilirim.{/i}"

# game/data/travel_events/wolves.rpy:25
translate tr travel_event_wolves_b6bd6149:

    # "Elena stepped forward and snarled towards the wolves, who tilted their heads curiously in understanding."
    "Elena öne adım attı ve kurtlara doğru hırladı, onlar başlarını merakla anlayışla eğdiler."

# game/data/travel_events/wolves.rpy:26
translate tr travel_event_wolves_632809bd:

    # "After some brief barking, Elena turns towards you."
    "Kısa bir havlamadan sonra, Elena sana döndü."

# game/data/travel_events/wolves.rpy:27
translate tr travel_event_wolves_6b567ed4:

    # ELENA @ sad "They're starving... They only want some food, and they'll leave us alone."
    ELENA @ sad "Açlıktan ölüyorlar... Sadece biraz yiyecek istiyorlar ve bizi rahat bırakacaklar."

# game/data/travel_events/wolves.rpy:35
translate tr travel_event_wolves_5484d21a:

    # "Tossing the meat towards them, the wolves happily whined and barked as they chowed down."
    "Eti onlara doğru fırlatırken, kurtlar mutlulukla inleyip yemlerini yerken havladılar."

# game/data/travel_events/wolves.rpy:36
translate tr travel_event_wolves_a23af468:

    # "Satisfied with their meal, they sped off into the forests, their leader looking back to give one last bark of appreciation."
    "Öğünlerinden memnun, ormanlara doğru hızlandılar, liderleri takdirle son bir havlamak için geri baktı."

# game/data/travel_events/wolves.rpy:38
translate tr travel_event_wolves_058c8ebb:

    # ELENA @ smile "Looks like you've made a few new friends..."
    ELENA @ smile "Görünüşe göre birkaç yeni arkadaş edindin..."

# game/data/travel_events/wolves.rpy:41
translate tr travel_event_wolves_937daf18:

    # "The wolves sadly whined... but then, once more, they began to snarl and bear their fangs."
    "Kurtlar ne yazık ki inledi... ama sonra, bir kez daha, hırlamaya ve dişlerini göstermeye başladılar."

# game/data/travel_events/wolves.rpy:42
translate tr travel_event_wolves_3b747ef8:

    # ELENA "I don't think they're taking no for an answer!"
    ELENA "Hayır cevabını kabul ettiklerini sanmıyorum!"

# game/data/travel_events/wolves.rpy:48
translate tr travel_event_wolves_f567ab41_1:

    # "With the last of the wolves yelping out in anguished pain, I quickly put the thing out of its misery."
    "Son kurt da acı içinde inlerken, şeyi hızla acısından kurtardım."

# game/data/travel_events/wolves.rpy:49
translate tr travel_event_wolves_a4f1e169_1:

    # MC "{i}*Sigh*{/i}"
