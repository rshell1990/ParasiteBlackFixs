    # game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:53
    old "Happy Krishana day to you too, [regina_ref!t]"
    new "Sana da mutlu Krishana günü, [regina_ref!t]"

    # game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:144
    old "It's fine ... You smell nice too."
    new "Sorun değil... Sen de güzel kokuyorsun."

    # game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:148
