    MC @ smile "Hm? Bu nedir?"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:817
translate tr ev_KrishanaDay_gifts_38530319:

    # "Taking the book from her mouth, Elena's tail wagged as she waited for me look at it."
    "Kitabı ağzından alırken, Elena'nın kuyruğu sallandı, bakmamı bekledi."

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:818
translate tr ev_KrishanaDay_gifts_a77399d3:

    # "{i}The dreams of Ashara - A love story.{/i}"
    "{i}Ashara'nın rüyaları— Bir aşk hikayesi.{/i}"

# game/data/world_events/novaras/KrishanaEvent/ev_krishana_day.rpy:819
translate tr ev_KrishanaDay_gifts_fce6108b:

