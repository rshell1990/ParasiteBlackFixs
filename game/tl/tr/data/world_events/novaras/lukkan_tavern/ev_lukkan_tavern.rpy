translate tr ev_lukkan_tavern_talk_d33c877c:

    # LUKKAN @ talk "Oh no... Not when I'm off work kid."
    LUKKAN @ talk "Ah hayır... İşte olmadığım zaman değil çocuk."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:25
translate tr ev_lukkan_tavern_talk_aaecfe7c:

    # LUKKAN @ talk "Leave me to drink in peace, would you?"
    LUKKAN @ talk "Beni huzur içinde içkime bırak, olur mu?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:30
translate tr ev_lukkan_tavern_bye_d1d7e9f8:

    # "Lukkan turned away and continued to sip at his drink ignoring me."
    "Lukkan arkasını döndü ve beni görmezden gelerek içkisini yudumlamaya devam etti."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:34
translate tr ev_lukkan_tavern_talk_2_601ac674:

    # LUKKAN @ talk "Well I don't care to answer it."
    LUKKAN @ talk "Pekala cevaplamak umurumda değil."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:35
translate tr ev_lukkan_tavern_talk_2_8ef6a3d8:

    # LUKKAN @ talk "Harrass me in work all you like, not during my downtime."
    LUKKAN @ talk "İşte istediğin kadar rahatsız et, molamda değil."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:38
translate tr ev_lukkan_tavern_talk_2_0dcda6d1:

    # LUKKAN @ talk "Finally."
    LUKKAN @ talk "Nihayet."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:42
translate tr ev_lukkan_tavern_talk_2_82872103:

    # LUKKAN @ talk "Urghh... Fine."
    LUKKAN @ talk "Urghh... Peki."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:43
translate tr ev_lukkan_tavern_talk_2_8ff38180:

    # LUKKAN @ talk "What do you want?"
    LUKKAN @ talk "Ne istiyorsun?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:46
translate tr ev_lukkan_tavern_talk_2_menu_c1c93262:

    # LUKKAN @ talk "...Who, {i}me?{/i}"
    LUKKAN @ talk "...Kim, {i}ben mi?{/i}"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:47
translate tr ev_lukkan_tavern_talk_2_menu_2041d5ec:

    # LUKKAN @ talk "I signed up when I was just a lad, barely fifteen."
    LUKKAN @ talk "Daha bir delikanlıyken kaydoldum, ancak on beş."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:48
translate tr ev_lukkan_tavern_talk_2_menu_f047a6f1:

    # LUKKAN @ talk "Must have been... At least thirty years ago?"
    LUKKAN @ talk "Olmuş olmalı... En az otuz yıl önce?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:49
translate tr ev_lukkan_tavern_talk_2_menu_d0d4ea41:

    # LUKKAN @ talk "Things were different back then... {i}Better.{/i}"
    LUKKAN @ talk "O zamanlar işler farklıydı... {i}Daha iyi.{/i}"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:50
translate tr ev_lukkan_tavern_talk_2_menu_43e9ad4e:

    # LUKKAN @ talk "I mean you still have the usual shite to deal with, always some cunt knocking about somewhere causing trouble."
    LUKKAN @ talk "Yani hala başa çıkılması gereken her zamanki şeyler var, her zaman bir yerde sorun çıkaran bir pislik olur."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:51
translate tr ev_lukkan_tavern_talk_2_menu_694204d0:

    # LUKKAN @ talk "But even the bad days never came close to this."
    LUKKAN @ talk "Ama en kötü günler bile buna asla yaklaşmadı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:52
translate tr ev_lukkan_tavern_talk_2_menu_075d0251:

    # MC @ talk "If you served that long, did you ever meet Newheart?"
    MC @ talk "Eğer bu kadar uzun süre hizmet ettiysen, hiç Newheart ile tanıştın mı?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:53
translate tr ev_lukkan_tavern_talk_2_menu_95b660d8:

    # LUKKAN @ talk "I saw him a few times in passing, even followed under his command briefly."
    LUKKAN @ talk "Geçerken birkaç kez gördüm, hatta kısa bir süre komutası altında takip ettim."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:54
translate tr ev_lukkan_tavern_talk_2_menu_a73c4b88:

    # LUKKAN @ talk "But I never knew him as a man."
    LUKKAN @ talk "Ama onu bir adam olarak asla tanımadım."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:55
translate tr ev_lukkan_tavern_talk_2_menu_9807b8f5:

    # LUKKAN @ talk "Only a living legend... Gods, how his armour glimmered in the light."
    LUKKAN @ talk "Sadece yaşayan bir efsane... Tanrılar, zırhı ışıkta nasıl parlıyordu."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:56
translate tr ev_lukkan_tavern_talk_2_menu_f6f84d27:

    # MC @ talk "Were you there at Meadow Plains when he fell?"
    MC @ talk "Düştüğünde Meadow Plains'te orada mıydın?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:57
translate tr ev_lukkan_tavern_talk_2_menu_62a0cb10:

    # LUKKAN @ talk "Nah, I was pulled away to fight in the Eastern Front while all that was going down, chasing off some straggler forces that were looping around Hamun trying to wreak havoc behind our lines."
    LUKKAN @ talk "Yok, tüm bunlar olurken Doğu Cephesi'nde savaşmaya çekildim, hatlarımızın arkasında tahribat yaratmaya çalışan bazı başıboş kuvvetleri kovaladım, Hamun etrafında dolanıyorlardı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:58
translate tr ev_lukkan_tavern_talk_2_menu_7708ff43:

    # LUKKAN @ talk "Heard about the shitshow that went down though and read the battle reports after... Wasn't pretty."
    LUKKAN @ talk "Gerçi olan şeyler hakkında duydum ve sonra savaş raporlarını okudum... Hoş değildi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:59
translate tr ev_lukkan_tavern_talk_2_menu_ca4c8415:

    # "Lukkan took another sip of Ale from his mug."
    "Lukkan kupasından bir yudum daha aldı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:60
translate tr ev_lukkan_tavern_talk_2_menu_d4c6a22d:

    # LUKKAN @ talk "But I can't say I'm surprised, the leadership back then had no real fucking common sense."
    LUKKAN @ talk "Ama şaşırdığımı söyleyemem, o zamanlar liderliğin gerçek bir lanet sağduyusu yoktu."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:61
translate tr ev_lukkan_tavern_talk_2_menu_0a84b181:

    # LUKKAN @ talk "I mean, really? What the fuck kind of plan was that?"
    LUKKAN @ talk "Yani, cidden mi? Bu nasıl bir plandı?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:62
translate tr ev_lukkan_tavern_talk_2_menu_0fdb7a58:

    # LUKKAN @ talk "{i}Trying to seige the largest fort we ever built while Newheart and a couple men tried some merry-band-of-heroes bullshit sneaking through a secret passage inside the fort to force down the drawbridge?{/i}"
    LUKKAN @ talk "{i}İnşa ettiğimiz en büyük kaleyi kuşatmaya çalışırken, Newheart ve birkaç adamın, asma köprüyü zorla indirmek için kalenin içindeki gizli bir geçitten gizlice geçme gibi neşeli-kahramanlar-grubu saçmalığı denemesi mi?{/i}"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:63
translate tr ev_lukkan_tavern_talk_2_menu_f9c07b15:

    # LUKKAN @ talk "No one had been down in those shafts in years, they had no idea whether the passageway was still even accessible but off they went anyway."
    LUKKAN @ talk "Yıllardır kimse o kuyulara inmemişti, geçidin hala erişilebilir olup olmadığı hakkında hiçbir fikirleri yoktu ama yine de gittiler."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:64
translate tr ev_lukkan_tavern_talk_2_menu_5c9899b8:

    # LUKKAN @ talk "Not to mention the sheer volume of Demorai inside the fort and the fortifications they had been building up around it."
    LUKKAN @ talk "Kalenin içindeki Demorai'nin salt hacminden ve etrafında inşa ettikleri tahkimatlardan bahsetmiyorum bile."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:65
translate tr ev_lukkan_tavern_talk_2_menu_eb24454b:

    # LUKKAN @ talk "Granted the fort had been damaged a little when the Demorai first took it, but still!"
    LUKKAN @ talk "Kabul, Demorai kaleyi ilk aldığında biraz hasar görmüştü, ama yine de!"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:66
translate tr ev_lukkan_tavern_talk_2_menu_0be8cc89:

    # LUKKAN @ talk "It was a damn meat-grinder for those charging in!"
    LUKKAN @ talk "Oraya hücum edenler için lanet bir kıyma makinesiydi!"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:67
translate tr ev_lukkan_tavern_talk_2_menu_a7fcd7ba:

    # MC @ talk "Sounds like you blame Newheart."
    MC @ talk "Newheart'ı suçluyor gibisin."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:68
translate tr ev_lukkan_tavern_talk_2_menu_9019604b:

    # LUKKAN @ talk "Well... I do blame him a little, sacrilege though it may be seen."
    LUKKAN @ talk "Eh... Onu biraz suçluyorum, her ne kadar küfür olarak görülse de."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:69
translate tr ev_lukkan_tavern_talk_2_menu_de542c95:

    # LUKKAN @ talk "Adventurers are cocky glory-hound bastards all of them, and even Newheart still couldn't shake that 'Adventurer' mindset fully I think."
    LUKKAN @ talk "Maceracıların hepsi kibirli şöhret avcısı piçlerdir ve Newheart bile o 'Maceracı' zihniyetini tamamen üzerinden atamadı sanırım."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:70
translate tr ev_lukkan_tavern_talk_2_menu_ac6a7933:

    # LUKKAN @ talk "Why did he {i}personally{/i} have to lead the men down there?"
    LUKKAN @ talk "Adamları neden {i}şahsen{/i} oraya götürmek zorundaydı ki?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:71
translate tr ev_lukkan_tavern_talk_2_menu_7fc24c42:

    # LUKKAN @ talk "He could never sit back and just be a fucking {i}general,{/i} he had to always plant himself in the thick of battle somewhere."
    LUKKAN @ talk "Asla geri çekilip sadece lanet bir {i}general{/i} olamazdı, her zaman kendini savaşın tam ortasına dikmek zorundaydı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:72
translate tr ev_lukkan_tavern_talk_2_menu_79930734:

    # LUKKAN @ talk "And sure, he was a damn demon on the battlefield, and it usually inspired the men like nothing else!"
    LUKKAN @ talk "Ve tabii, savaş alanında lanet bir iblisti ve genellikle adamları hiçbir şey gibi ilhamlandırırdı!"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:73
translate tr ev_lukkan_tavern_talk_2_menu_47890319:

    # LUKKAN @ talk "But that's the catch isn't it? Because when he was then slain right there fucking in front of everyone, that morale boost he always gave came right back around and nearly finished us there and then."
    LUKKAN @ talk "Ama işin püf noktası bu değil mi? Çünkü o zaman tam orada herkesin önünde katledildiğinde, her zaman verdiği o moral artışı hemen geri döndü ve bizi neredeyse o anda bitirdi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:74
translate tr ev_lukkan_tavern_talk_2_menu_cbe580ab:

    # LUKKAN @ talk "Morale plummeted into total despair, the line fell apart because men started fleeing for their lives because of course they did? The 'great hero' just got butchered in front of them, what chance did they have?"
    LUKKAN @ talk "Moral tamamen umutsuzluğa düştü, hat dağıldı çünkü adamlar hayatları için kaçmaya başladı, çünkü tabii ki? 'Büyük kahraman' önlerinde doğranmıştı, onların ne şansı vardı?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:75
translate tr ev_lukkan_tavern_talk_2_menu_bc406b3a:

    # LUKKAN @ talk "But... It wasn't all on him, his orders came down to take the Fort before the Demorai reinforcements arrived from the South and hold the line there."
    LUKKAN @ talk "Ama... Hepsi onda değildi, emirleri Güney'den Demorai takviyeleri gelmeden önce Kale'yi almak ve orada hattı tutmaktı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:76
translate tr ev_lukkan_tavern_talk_2_menu_65ea403e:

    # LUKKAN @ talk "He pleaded with them to dig in for a long war, to forget about Fort Rook for now and to lift the sieges at Gerano and Inma first to free up the trapped forces."
    LUKKAN @ talk "Onlara uzun bir savaş için siper kazmaları, şimdilik Fort Rook'u unutmaları ve sıkışmış kuvvetleri serbest bırakmak için önce Gerano ve Inma'daki kuşatmaları kaldırmaları için yalvardı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:77
translate tr ev_lukkan_tavern_talk_2_menu_fec0b494:

    # LUKKAN @ talk "But Mesamor and the high lords had their way and constantly meddled in military matters they had no business dealing with."
    LUKKAN @ talk "Ama Mesamor ve yüksek lordlar onların istediğini yaptı ve sürekli olarak hiç ilgilenmemeleri gereken askeri meselelere karıştılar."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:78
translate tr ev_lukkan_tavern_talk_2_menu_c1262440:

    # LUKKAN @ talk "Well, the rest is history."
    LUKKAN @ talk "Eh, gerisi tarih."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:79
translate tr ev_lukkan_tavern_talk_2_menu_eb459e92:

    # "Lukkan bitterly sipped at his drink."
    "Lukkan acı bir şekilde içkisini yudumladı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:82
translate tr ev_lukkan_tavern_talk_2_menu_b111f700:

    # LUKKAN @ talk "...What's it to you, kid?"
    LUKKAN @ talk "...Sana ne bundan, çocuk?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:83
translate tr ev_lukkan_tavern_talk_2_menu_f57a8267:

    # MC @ talk "I guess I just want to know more about it."
    MC @ talk "Sanırım sadece bu konuda daha fazla bilmek istiyorum."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:84
translate tr ev_lukkan_tavern_talk_2_menu_79750a5b:

    # MC @ talk "I hear a couple royalists grumble about Alcott's {i}'crimes'{/i} and I guess I wanted to hear the other side."
    MC @ talk "Birkaç kraliyetçinin Alcott'un {i}'suçları'{/i} hakkında homurdandığını duyuyorum ve sanırım diğer tarafı duymak istedim."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:85
translate tr ev_lukkan_tavern_talk_2_menu_3a3a2118:

    # LUKKAN @ talk "Fuck the Royalists, we'd all be worm food by now if we were still listening to them."
    LUKKAN @ talk "Kraliyetçilerin canı cehenneme, hala onları dinliyor olsaydık şimdiye kadar hepimiz kurt yemi olurduk."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:86
translate tr ev_lukkan_tavern_talk_2_menu_e10908ed:

    # MC @ talk "So you did side with Alcott?"
    MC @ talk "Yani Alcott'un tarafını tuttun?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:87
translate tr ev_lukkan_tavern_talk_2_menu_77eda8c8:

    # LUKKAN @ talk "...I did... Hardest decision I ever made."
    LUKKAN @ talk "...Tuttum... Verdiğim en zor karardı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:88
translate tr ev_lukkan_tavern_talk_2_menu_65a07d48:

    # LUKKAN @ talk "Had to be done though."
    LUKKAN @ talk "Yine de yapılması gerekiyordu."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:89
translate tr ev_lukkan_tavern_talk_2_menu_ff2493dc:

    # LUKKAN @ talk "I was appointed one of Alcott's personal guards and followed him wherever he went."
    LUKKAN @ talk "Alcott'un kişisel muhafızlarından biri olarak atandım ve nereye giderse gitsin onu takip ettim."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:90
translate tr ev_lukkan_tavern_talk_2_menu_d2483d79:

    # LUKKAN @ talk "I became privy as a silent observer to some of the madness in Mesamor's court."
    LUKKAN @ talk "Sessiz bir gözlemci olarak Mesamor'un sarayındaki bazı deliliklere vakıf oldum."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:91
translate tr ev_lukkan_tavern_talk_2_menu_04594668:

    # MC @ talk "What {i}really{/i} happened?"
    MC @ talk "{i}Gerçekten{/i} ne oldu?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:92
translate tr ev_lukkan_tavern_talk_2_menu_1f230a8f:

    # LUKKAN @ talk "It's hard to explain truthfully, it wasn't just one thing but something built up over time."
    LUKKAN @ talk "Dürüst olmak gerekirse açıklaması zor, sadece tek bir şey değil de zamanla biriken bir şeydi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:93
translate tr ev_lukkan_tavern_talk_2_menu_febbcc48:

    # LUKKAN @ talk "After Alcott rose up and managed to repel the Demorai during the Great Seige, he was appointed head of the War council and supreme commander of all forces."
    LUKKAN @ talk "Alcott yükselip Büyük Kuşatma sırasında Demorai'yi püskürtmeyi başardıktan sonra, Savaş konseyinin başı ve tüm kuvvetlerin yüce komutanı olarak atandı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:94
translate tr ev_lukkan_tavern_talk_2_menu_8a26670d:

    # LUKKAN @ talk "Only Mesamor himself had any authority higher than him, and very quickly the relationship between them fell apart."
    LUKKAN @ talk "Sadece Mesamor'un kendisi ondan daha yüksek bir yetkiye sahipti ve çok hızlı bir şekilde aralarındaki ilişki parçalandı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:95
translate tr ev_lukkan_tavern_talk_2_menu_9abd2c86:

    # MC @ talk "How so?"
    MC @ talk "Nasıl yani?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:96
translate tr ev_lukkan_tavern_talk_2_menu_f278db0b:

    # LUKKAN @ talk "When we managed to catch a second wind after repelling the Demorai, Mesamor took it as a sign we now had the enemy on the backfoot, and we needed to press the advance immediately."
    LUKKAN @ talk "Demorai'yi püskürttükten sonra ikinci bir rüzgar yakalamayı başardığımızda, Mesamor bunu düşmanı şimdi geri adımdayken yakaladığımızın bir işareti olarak aldı ve derhal ilerlemeye basmamız gerektiğini söyledi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:97
translate tr ev_lukkan_tavern_talk_2_menu_b9bc826d:

    # LUKKAN @ talk "Alcott's position was always that Newheart's initial assessment was correct, we needed time and to make drastic changes to our forces before any kind of real counter offensive would pay off."
    LUKKAN @ talk "Alcott'un pozisyonu her zaman Newheart'ın başlangıçtaki değerlendirmesinin doğru olduğuydu, herhangi bir tür gerçek karşı saldırının karşılığını vermesinden önce zamana ve kuvvetlerimizde köklü değişiklikler yapmaya ihtiyacımız vardı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:98
translate tr ev_lukkan_tavern_talk_2_menu_650c5975:

    # LUKKAN @ talk "And every single time, Mesamor was reluctant to embrace any kind of practical change."
    LUKKAN @ talk "Ve her seferinde, Mesamor herhangi bir tür pratik değişikliği kucaklamakta isteksizdi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:101
translate tr ev_lukkan_tavern_talk_2_menu2_327daf84:

    # LUKKAN @ talk "Tell me, did you ever see the {i}old{/i} Alderian armour?"
    LUKKAN @ talk "Söyle bana, hiç {i}eski{/i} Alderian zırhını gördün mü?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:102
translate tr ev_lukkan_tavern_talk_2_menu2_c5ffce20:

    # LUKKAN @ talk "Beautiful stuff, purple and black cloaked, made by Syaxian ore."
    LUKKAN @ talk "Güzel şeydi, mor ve siyah pelerinli, Syaxian cevherinden yapılmıştı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:103
translate tr ev_lukkan_tavern_talk_2_menu2_e85184cf:

    # LUKKAN @ talk "It was some of the most durable and flexible armour around, light as a bloody feather too."
    LUKKAN @ talk "Etraftaki en dayanıklı ve esnek zırhlardan biriydi, aynı zamanda lanet bir tüy kadar hafifti."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:104
translate tr ev_lukkan_tavern_talk_2_menu2_3f8031db:

    # LUKKAN @ talk "...And it was fucking useless."
    LUKKAN @ talk "...Ve lanet olası işe yaramazdı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:105
translate tr ev_lukkan_tavern_talk_2_menu2_023cc10d:

    # MC @ talk "Huh? How come?"
    MC @ talk "Ha? Nasıl olur?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:106
translate tr ev_lukkan_tavern_talk_2_menu2_c236f049:

    # LUKKAN @ talk "Because the ore was {i}always{/i} in short supply, limited to many of the mines found in the south which we were no longer in control of."
    LUKKAN @ talk "Çünkü cevher {i}her zaman{/i} kıt arzdaydı, artık kontrolümüzde olmayan güneydeki birçok madenle sınırlıydı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:107
translate tr ev_lukkan_tavern_talk_2_menu2_4d42870d:

    # LUKKAN @ talk "And frankly, the armour took {i}far{/i} too long to produce."
    LUKKAN @ talk "Ve açıkçası, zırhın üretimi {i}çok{/i} uzun sürüyordu."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:108
translate tr ev_lukkan_tavern_talk_2_menu2_996e4e50:

    # LUKKAN @ talk "Sure, in peace time when you have the luxury of time, it's fine."
    LUKKAN @ talk "Tabii, barış zamanında zaman lüksün varken, sorun değil."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:109
translate tr ev_lukkan_tavern_talk_2_menu2_64776b2c:

    # LUKKAN @ talk "You can slowly plod on while you collect all your ore."
    LUKKAN @ talk "Tüm cevherini toplarken yavaşça ağır ağır ilerleyebilirsin."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:110
translate tr ev_lukkan_tavern_talk_2_menu2_3515bc69:

    # LUKKAN @ talk "But what happens when ten thousand men are slain on the battlefield in one day, leaving behind all that armour?"
    LUKKAN @ talk "Ama bir günde savaş alanında on bin adam katledildiğinde, tüm o zırhı geride bırakarak ne olur?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:111
translate tr ev_lukkan_tavern_talk_2_menu2_fa8eec20:

    # LUKKAN @ talk "That armour doesn't just 'magically' return to re-stock itself."
    LUKKAN @ talk "O zırh kendini yeniden stoklamak için 'sihirli bir şekilde' geri dönmez."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:112
translate tr ev_lukkan_tavern_talk_2_menu2_b2a5d91c:

    # LUKKAN @ talk "And just like that, it dawns on them, pretty soon, they won't be able to produce anywhere near the amount of armour they need for fresh troops."
    LUKKAN @ talk "Ve işte böyle, farkına varırlar, çok yakında, yeni birlikler için ihtiyaç duydukları zırh miktarının yakınında bile üretemeyecekler."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:113
translate tr ev_lukkan_tavern_talk_2_menu2_ec33bd11:

    # LUKKAN @ talk "So what did Alcott do? Well, he wanted to use a cheaper iron-based ore far more readily available that we could use to quickly churn out armour and weapons to every able hand and body."
    LUKKAN @ talk "Peki Alcott ne yaptı? Eh, çok daha kolay bulunabilen daha ucuz demir tabanlı bir cevher kullanmak istedi, böylece her eli ve bedeni donatmak için hızlıca zırh ve silah üretebilirdik."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:114
translate tr ev_lukkan_tavern_talk_2_menu2_1f95f6f4:

    # LUKKAN @ talk "Don't get me wrong, this stuff is shite compared to what we {i}used{/i} to have."
    LUKKAN @ talk "Beni yanlış anlama, bu şey {i}eskiden{/i} sahip olduğumuzla karşılaştırıldığında çöp."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:115
translate tr ev_lukkan_tavern_talk_2_menu2_cfb4a88c:

    # LUKKAN @ talk "But which is better? To have ten men who have average armour and passable swords? Or to have three men with great armour and weapons, but the other seven have nothing?"
    LUKKAN @ talk "Ama hangisi daha iyi? Ortalama zırhlı ve geçer kılıçlı on adama sahip olmak mı? Yoksa harika zırhlı ve silahlı üç adama sahip olup diğer yedisinin hiçbir şeyi olmaması mı?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:116
translate tr ev_lukkan_tavern_talk_2_menu2_3facbe0b:

    # LUKKAN @ talk "The armoury’s ore master though, a man called Charlan Croshire, refused to compromise on quality and fought with Alcott."
    LUKKAN @ talk "Ancak cephaneliğin cevher ustası, Charlan Croshire adında bir adam, kaliteden ödün vermeyi reddetti ve Alcott ile savaştı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:117
translate tr ev_lukkan_tavern_talk_2_menu2_8ff0d3cc:

    # LUKKAN @ talk "So Alcott goes back to Mesamor to replace the Ore master, but Mesamor refused."
    LUKKAN @ talk "Böylece Alcott Cevher ustasını değiştirmek için Mesamor'a geri gider, ama Mesamor reddetti."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:118
translate tr ev_lukkan_tavern_talk_2_menu2_c8b7a5e6:

    # LUKKAN @ talk "It was a matter of national pride to him, his ego-overrode practicality."
    LUKKAN @ talk "Bu onun için bir milli gurur meselesiydi, egosu pratikliği geçersiz kıldı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:119
translate tr ev_lukkan_tavern_talk_2_menu2_cc3a0ab0:

    # LUKKAN @ talk "And that's just ONE example, there are dozens of other decisions Mesamor interfered with that constantly caused issues and resentment."
    LUKKAN @ talk "Ve bu sadece BİR örnek, Mesamor'un sürekli sorunlara ve küskünlüğe neden olan müdahale ettiği düzinelerce başka karar var."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:122
translate tr ev_lukkan_tavern_talk_2_menu2_f85d8de2:

    # LUKKAN @ talk "{i}Daggerfall...{/i}"
    LUKKAN @ talk "{i}Hançer Düşüşü...{/i}"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:123
translate tr ev_lukkan_tavern_talk_2_menu2_46a67cc0:

    # LUKKAN @ talk "It wasn't the worst plan to be honest, at least, not at first."
    LUKKAN @ talk "Dürüst olmak gerekirse en kötü plan değildi, en azından, başlangıçta değil."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:124
translate tr ev_lukkan_tavern_talk_2_menu2_2eb28da9:

    # LUKKAN @ talk "The idea was to split the army into two and strike while the metal was still hot."
    LUKKAN @ talk "Fikir orduyu ikiye bölüp demir sıcakken vurmaktı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:125
translate tr ev_lukkan_tavern_talk_2_menu2_d53505ef:

    # LUKKAN @ talk "Gerano had fallen, but the city of Hamun was surprisingly holding it's own pretty well, as did Inma to the East."
    LUKKAN @ talk "Gerano düşmüştü, ama Hamun şehri şaşırtıcı bir şekilde kendi başına oldukça iyi dayanıyordu, Doğu'daki Inma da öyle."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:126
translate tr ev_lukkan_tavern_talk_2_menu2_d32cebd3:

    # LUKKAN @ talk "The idea was for us to lift the sieges at both Inma and Hamun and then re-group to begin a long seige to re-take Fort Rook once those two were secured."
    LUKKAN @ talk "Fikir, hem Inma hem de Hamun'daki kuşatmaları kaldırmamız ve sonra bu ikisi güvenceye alındıktan sonra Fort Rook'u geri almak için uzun bir kuşatma başlatmak için yeniden toplanmamızdı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:127
translate tr ev_lukkan_tavern_talk_2_menu2_ec7dfac2:

    # LUKKAN @ talk "Once we re-took Fort Rook, we could establish a new front line and safely leap-frog to any number of regions to support."
    LUKKAN @ talk "Fort Rook'u geri aldığımızda, yeni bir cephe hattı kurabilir ve herhangi bir sayıda bölgeye destek için güvenle sıçrayabilirdik."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:128
translate tr ev_lukkan_tavern_talk_2_menu2_82200767:

    # LUKKAN @ talk "I was sent to the Eastern Front to relive Hamun, and for a while, it seemed to be working."
    LUKKAN @ talk "Doğu Cephesi'ne Hamun'u rahatlatmak için gönderildim ve bir süreliğine, işliyor gibiydi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:129
translate tr ev_lukkan_tavern_talk_2_menu2_0c13669b:

    # LUKKAN @ talk "On our side, we managed to reach Hamun safely and began to help push back the Demorai forces there."
    LUKKAN @ talk "Bizim tarafımızda, Hamun'a güvenle ulaşmayı başardık ve oradaki Demorai kuvvetlerini geri itmeye başladık."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:130
translate tr ev_lukkan_tavern_talk_2_menu2_43288abb:

    # LUKKAN @ talk "The Western Front though? That was a whole different game... Poor bastards."
    LUKKAN @ talk "Batı Cephesi ise? O tamamen farklı bir oyundu... Zavallı piçler."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:131
translate tr ev_lukkan_tavern_talk_2_menu2_d350cedb:

    # MC @ talk "Where do you think it went wrong?"
    MC @ talk "Sence nerede yanlış gitti?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:132
translate tr ev_lukkan_tavern_talk_2_menu2_1156be38:

    # LUKKAN @ talk "Take your pick?"
    LUKKAN @ talk "Seç beğen al?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:133
translate tr ev_lukkan_tavern_talk_2_menu2_fba77149:

    # LUKKAN @ talk "Mesamor refused to listen to Alcott and insisted we didn't wait for the Summer, but struck now just before Winter begun."
    LUKKAN @ talk "Mesamor, Alcott'u dinlemeyi reddetti ve Yaz'ı beklemememiz, ama Kış başlamadan hemen önce şimdi vurmamız konusunda ısrar etti."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:134
translate tr ev_lukkan_tavern_talk_2_menu2_03b26c87:

    # LUKKAN @ talk "Him and the High lords figured that with the Demorai now on the backfoot following the great siege, they wouldn't expect such a quick counter-offensive."
    LUKKAN @ talk "O ve Yüksek lordlar, büyük kuşatmadan sonra Demorai'nin şimdi geri adımda olduğu için, bu kadar hızlı bir karşı saldırıyı beklemeyeceklerini düşündüler."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:135
translate tr ev_lukkan_tavern_talk_2_menu2_e7fa2894:

    # LUKKAN @ talk "Mesamor reasoned if we waited till the Summer, we would lose the window of opportunity to strike, and the Demorai forces would have recovered too much by then to nullify whatever offensive we mustered."
    LUKKAN @ talk "Mesamor, Yaz'a kadar beklersek, vurma fırsat penceresini kaybedeceğimizi ve Demorai kuvvetlerinin o zamana kadar toparlayabileceğimiz herhangi bir saldırıyı geçersiz kılmak için çok fazla iyileşmiş olacağını düşündü."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:136
translate tr ev_lukkan_tavern_talk_2_menu2_00cfa798:

    # LUKKAN @ talk "...Which leads into the second major problem."
    LUKKAN @ talk "...Bu da ikinci büyük soruna yol açıyor."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:137
translate tr ev_lukkan_tavern_talk_2_menu2_aa0ddc83:

    # LUKKAN @ talk "We were already struggling to supply our troops with proper armour and equipment, now, we were moving two massive forces simultaneously and our supply lines simply buckled."
    LUKKAN @ talk "Zaten birliklerimize düzgün zırh ve ekipman sağlamakta zorlanıyorduk, şimdi, iki büyük kuvveti eşzamanlı olarak hareket ettiriyorduk ve ikmal hatlarımız basitçe çöktü."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:138
translate tr ev_lukkan_tavern_talk_2_menu2_91a2c702:

    # LUKKAN @ talk "See that's the thing about Mesamor and all those High Lords, they only focused on the immediate statistics they thought were relevant."
    LUKKAN @ talk "Bak Mesamor ve tüm şu Yüksek Lordlar ile ilgili mesele şu, sadece ilgili olduğunu düşündükleri anlık istatistiklere odaklandılar."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:139
translate tr ev_lukkan_tavern_talk_2_menu2_1b819086:

    # LUKKAN @ talk "Things like troop numbers and which weapons were proving most effective in killing Demorai..."
    LUKKAN @ talk "Birlik sayıları ve hangi silahların Demorai öldürmede en etkili olduğunu kanıtladığı gibi şeyler..."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:140
translate tr ev_lukkan_tavern_talk_2_menu2_e95114bc:

    # LUKKAN @ talk "What they were never concerned with though, was considering the amount of {i}food{/i} they'd need to send to these massive forces day to day."
    LUKKAN @ talk "Ancak hiç endişe duymadıkları şey, bu büyük kuvvetlere günden güne göndermeleri gereken {i}yiyecek{/i} miktarını dikkate almaktı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:141
translate tr ev_lukkan_tavern_talk_2_menu2_4e50f015:

    # LUKKAN @ talk "They never considered the possibility that this 'counter offensive' could drag on into the long winter, and that the men would need Winter uniforms."
    LUKKAN @ talk "Bu 'karşı saldırının' uzun kışa sürüklenme olasılığını ve adamların Kış üniformalarına ihtiyaç duyacağını asla düşünmediler."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:142
translate tr ev_lukkan_tavern_talk_2_menu2_6ea0c11a:

    # LUKKAN @ talk "And that's exactly what happened... Just some half-starved, poorly-equipped nearly frozen to death men in the West."
    LUKKAN @ talk "Ve tam olarak olan buydu... Sadece bazı yarı aç, kötü donanımlı, neredeyse donarak ölmüş adamlar Batı'da."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:143
translate tr ev_lukkan_tavern_talk_2_menu2_00be4855:

    # LUKKAN @ talk "We had to abandon our plans to meet at Fort Rook and move quickly to reform a new defence line deeper in-land to stop the Demorai and help the straggling forces there."
    LUKKAN @ talk "Fort Rook'ta buluşma planlarımızdan vazgeçmek ve Demorai'yi durdurmak ve oradaki başıboş kuvvetlere yardım etmek için iç kısımda daha derinde yeni bir savunma hattı oluşturmak için hızla hareket etmek zorunda kaldık."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:144
translate tr ev_lukkan_tavern_talk_2_menu2_df783d89:

    # MC @ talk "And that's when Alcott had enough?"
    MC @ talk "Ve o zaman Alcott yeter artık dedi?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:145
translate tr ev_lukkan_tavern_talk_2_menu2_ca594e67:

    # LUKKAN @ talk "No... The final straw was when Mesamor ordered Alcott to try the same thing {i}again.{/i}"
    LUKKAN @ talk "Hayır... Bardığı taşıran son damla, Mesamor'un Alcott'a aynı şeyi {i}tekrar{/i} denemesini emretmesiydi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:146
translate tr ev_lukkan_tavern_talk_2_menu2_e1ebe8d2:

    # LUKKAN @ talk "He was delusional, telling everyone in Court that we {i}actually{/i} were on the verge of pushing through in the West and should have never retreated, that we should have ordered those men to wait till reinforcements arrived."
    LUKKAN @ talk "Hayal görüyordu, Saray'daki herkese Batı'da {i}aslında{/i} geçmenin eşiğinde olduğumuzu ve asla geri çekilmememiz gerektiğini, o adamlara takviyeler gelene kadar beklemelerini emretmemiz gerektiğini söylüyordu."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:147
translate tr ev_lukkan_tavern_talk_2_menu2_44cbec2b:

    # LUKKAN @ talk "Gods, I can remember them arguing now..."
    LUKKAN @ talk "Tanrılar, şimdi tartışmalarını hatırlayabiliyorum..."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:148
translate tr ev_lukkan_tavern_talk_2_menu2_38507a13:

    # "Lukkan took a sip of his drink as he began to paraphrase his memory."
    "Lukkan hafızasını başka sözlerle aktarırken içkisinden bir yudum aldı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:149
translate tr ev_lukkan_tavern_talk_2_menu2_7ccf1608:

    # LUKKAN @ talk "{i}Gather some fresh troops and begin a new offensive at once Alcott! You cannot be such a fool to let this chance slip from your grasp!{/i}"
    LUKKAN @ talk "{i}Biraz yeni birlik topla ve derhal yeni bir saldırı başlat Alcott! Bu şansı elinden kaçıracak kadar aptal olamazsın!{/i}"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:150
translate tr ev_lukkan_tavern_talk_2_menu2_35172724:

    # LUKKAN @ talk "{i}Find more men!{/i}"
    LUKKAN @ talk "{i}Daha fazla adam bul!{/i}"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:151
translate tr ev_lukkan_tavern_talk_2_menu2_0a36646f:

    # "Lukkan boomed, doing his best impression of Alcott's voice."
    "Lukkan gürledi, Alcott'un sesinin en iyi taklidini yaparak."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:152
translate tr ev_lukkan_tavern_talk_2_menu2_6bf5dbd8:

    # LUKKAN @ talk "{i}THERE IS NO MORE MEN TO SPARE FOR YOUR FOOLISH PLANS!{/i}"
    LUKKAN @ talk "{i}SENİN APTAL PLANLARIN İÇİN HARCANACAK DAHA FAZLA ADAM YOK!{/i}"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:153
translate tr ev_lukkan_tavern_talk_2_menu2_b81b7ff5:

    # "Lukkan chuckled."
    "Lukkan kıkırdadı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:154
translate tr ev_lukkan_tavern_talk_2_menu2_abdf74a4:

    # LUKKAN @ talk "After that, Alcott was imprisoned by Mesamor briefly."
    LUKKAN @ talk "Ondan sonra, Alcott Mesamor tarafından kısa süreliğine hapsedildi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:155
translate tr ev_lukkan_tavern_talk_2_menu2_c60934cf:

    # LUKKAN @ talk "By then, most of the war council had enough of Mesamor, and the co-conspirators broke Alcott out and well..."
    LUKKAN @ talk "O zamana kadar, savaş konseyinin çoğu Mesamor'dan bıkmıştı ve komplo ortakları Alcott'u kaçırdı ve işte..."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:156
translate tr ev_lukkan_tavern_talk_2_menu2_3989bc68:

    # LUKKAN @ talk "The rest is history."
    LUKKAN @ talk "Gerisi tarih."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:157
translate tr ev_lukkan_tavern_talk_2_menu2_103ade9a:

    # LUKKAN @ talk "Mesamor was usurped and finally this war was run properly."
    LUKKAN @ talk "Mesamor tahttan indirildi ve sonunda bu savaş düzgünce yürütüldü."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:158
translate tr ev_lukkan_tavern_talk_2_menu2_015e59bb:

    # MC @ talk "Why did Mesamor constantly interfere the way he did?"
    MC @ talk "Mesamor neden sürekli böyle müdahale etti?"

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:159
translate tr ev_lukkan_tavern_talk_2_menu2_b0dcf253:

    # "Lukkan shrugged."
    "Lukkan omuz silkti."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:160
translate tr ev_lukkan_tavern_talk_2_menu2_dd053458:

    # LUKKAN @ talk "Who knows? Court politics is a funny thing, and I imagine he had his reasons."
    LUKKAN @ talk "Kim bilir? Saray politikası komik bir şeydir ve nedenleri olduğunu hayal ediyorum."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:161
translate tr ev_lukkan_tavern_talk_2_menu2_67fd60a5:

    # LUKKAN @ talk "...Or maybe, he really was just mad in the end."
    LUKKAN @ talk "...Ya da belki, sonunda gerçekten delirmişti."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:162
translate tr ev_lukkan_tavern_talk_2_menu2_48689f8c:

    # LUKKAN @ talk "Doesn't matter now though, what's done is done."
    LUKKAN @ talk "Gerçi artık fark etmez, olan oldu."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:163
translate tr ev_lukkan_tavern_talk_2_menu2_1ce7afe1:

    # LUKKAN @ talk "Anyway, that's enough history, don't you think."
    LUKKAN @ talk "Neyse, bu kadar tarih yeter, değil mi."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:164
translate tr ev_lukkan_tavern_talk_2_menu2_346f20f9:

    # LUKKAN @ talk "Now if you don't mind, I'd like finish this drink in peace..."
    LUKKAN @ talk "Şimdi sakıncası yoksa, bu içkiyi huzur içinde bitirmek istiyorum..."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:165
translate tr ev_lukkan_tavern_talk_2_menu2_2fdbb7eb:

    # "As Lukkan took a sip of his drink, he seemed pre-occupied with stirred up memories, shaking his head before taking another sip."
    "Lukkan içkisinden bir yudum alırken, karıştırılmış anılarla meşgul göründü, başka bir yudum almadan önce başını salladı."

# game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:166
translate tr ev_lukkan_tavern_talk_2_menu2_27c8b67d:

    # MC @ talk "Thank you for talking to me, Lukkan... I will leave you be."
    MC @ talk "Benimle konuştuğun için teşekkür ederim, Lukkan... Seni rahat bırakayım."

translate tr strings:

    # game/data/world_events/novaras/lukkan_tavern/ev_lukkan_tavern.rpy:15
    old "Talk to Lukkan"
    new "Lukkan ile konuş."

