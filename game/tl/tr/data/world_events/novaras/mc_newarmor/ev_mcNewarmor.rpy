    # MC @ talk "Ahh! Careful!"
    MC @ talk "Ahh! Dikkatli ol!"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:28
translate tr event_mc_newarmor_fdd3b5c9:

    # REGINA @ sad "What happened?"
    REGINA @ sad "Ne oldu?"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:29
translate tr event_mc_newarmor_101035ab:

    # REGINA @ sad "I heard you were seen being carried off towards the doctors, then the next thing I knew, I was told you were fighting for your life!"
    REGINA @ sad "Doktorlara doğru taşındığını duydum, sonra bir an da ne oldu, hayatın için savaştığın söylendi!"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:32
translate tr event_mc_newarmor_b1d7f9ea:

    # REGINA @ sad "I told you to be careful."
    REGINA @ sad "Dikkatli olmanı söylemiştim."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:33
translate tr event_mc_newarmor_cc49f520:

    # REGINA @ angry "You need to listen to me more!"
    REGINA @ angry "Beni daha çok dinlemelisin!"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:34
translate tr event_mc_newarmor_7d248de6:

    # REGINA @ sad "Being an Adventurer is dangerous [player_name!t]."
    REGINA @ sad "Maceracı olmak tehlikelidir [player_name!t]."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:36
translate tr event_mc_newarmor_84cdfdb7:

    # REGINA @ sad "{i}*Sigh*{/i} Please be more careful."
    REGINA @ sad "{i}*İç çekiş*{/i} Lütfen daha dikkatli ol."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:37
translate tr event_mc_newarmor_651acbbd:

    # REGINA @ sad "I don't know what I would do with myself if something happened to you."
    REGINA @ sad "Başına bir şey gelse ne yapardım bilmiyorum."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:38
translate tr event_mc_newarmor_417f0ac4:

    # "The thought lingered for a moment on how close to death once again I truly had come."
    "Ölüme bir kez daha ne kadar yaklaştığım düşüncesi bir an oyalandı."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:39
translate tr event_mc_newarmor_16180672:

    # "I had become perhaps too arrogant with my newfound powers."
    "Yeni bulduğum güçlerle belki çok kibirli olmuştum."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:40
translate tr event_mc_newarmor_98f0f479:

    # "Death as a prospect seemed to have slipped further and further away since I merged with the dark passenger."
    "Karanlık yolcuyla birleştiğimden beri ölümün bir ihtimal olarak giderek daha da uzaklaştığı görünüyordu."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:41
translate tr event_mc_newarmor_2dc6ae13:

    # "But now... Now I remembered I {i}was{/i} still vulnerable, and should I meet my end, those most precious to me would be left to fend for themselves without me."
    "Ama şimdi... Şimdi {i}hala{/i} savunmasız olduğumu hatırladım ve sonumla karşılaşırsam, benim için en değerli olanlar bensiz kendi başlarına idare etmek zorunda kalacaklardı."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:42
translate tr event_mc_newarmor_9f04f515:

    # MC @ sad "...I promise I will be more careful."
    MC @ sad "...Söz veriyorum daha dikkatli olacağım."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:43
translate tr event_mc_newarmor_f4eb3f16:

    # "I gently caressed [regina_ref!t]'s face and brought her into an embrace."
    "[regina_ref!t]'in yüzünü nazikçe okşadım ve onu kucaklayıp kollarıma aldım."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:44
translate tr event_mc_newarmor_3baf8be0:

    # "She smelt good, like freshly cut wildflowers."
    "Güzel kokuyordu, yeni kesilmiş kır çiçekleri gibi."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:45
translate tr event_mc_newarmor_3c9c0ec0:

    # "She reluctantly pulled away and said,"
    "İsteksizce çekildi ve dedi ki,"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:46
translate tr event_mc_newarmor_c511e082:

    # REGINA @ talk "There is some good news."
    REGINA @ talk "Bazı iyi haberler var."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:47
translate tr event_mc_newarmor_6ab64f68:

    # REGINA @ talk "Your father has sent word and had delivered a gift for you."
    REGINA @ talk "Baban haber gönderdi ve sana bir hediye teslim etti."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:48
translate tr event_mc_newarmor_9ae375a2:

    # MC @ surprised "Father?"
    MC @ surprised "Babam mı?"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:49
translate tr event_mc_newarmor_feb968f0:

    # REGINA @ talk "Yes... Some new armour and a letter for us each."
    REGINA @ talk "Evet... Biraz yeni zırh ve her birimiz için bir mektup."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:50
translate tr event_mc_newarmor_3373e8dd:

    # REGINA @ talk "I brought it into your room for when you want to read it."
    REGINA @ talk "Okumak istediğinde diye odana getirdim."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:51
translate tr event_mc_newarmor_cf18f36a:

    # MC @ talk "Thank you."
    MC @ talk "Teşekkür ederim."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:52
translate tr event_mc_newarmor_342e3913:

    # REGINA @ sad "How are your wounds? Are they-"
    REGINA @ sad "Yaraların nasıl? Onlar—"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:53
translate tr event_mc_newarmor_cea14b40:

    # MC @ talk "I am still sore but, I am fine."
    MC @ talk "Hala ağrım var ama, iyiyim."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:54
translate tr event_mc_newarmor_9651a39e:

    # MC @ talk "I promise you."
    MC @ talk "Sana söz veriyorum."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:55
translate tr event_mc_newarmor_b6c79774:

    # "Reluctantly, [regina_ref!t] relented, pulling back as she remarked she would put some food on for later, no doubt distracting herself with regards to her worries for me."
    "İsteksizce, [regina_ref!t] yumuşadı, geri çekildi, daha sonra için biraz yemek koyacağını söyledi, şüphesiz benim için endişeleriyle ilgili kendini oyaladı."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:59
translate tr event_mc_newarmor_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*İç çekiş*{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:61
translate tr event_mc_newarmor_39b10682:

    # MC "(I should see what father has brought me.)"
    MC "(Babamın bana ne getirdiğine bakmalıyım.)"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:67
translate tr event_mc_newarmor_bce5ed0b:

    # "The armour was laid out for me on the bed with the note held down beneath one of the gauntlet."
    "Zırh benim için yatakta serilmişti, not ellerliklerden birinin altında tutuluyordu."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:68
translate tr event_mc_newarmor_05ccf7f6:

    # "I held up the note and began to read it."
    "Notu kaldırdım ve okumaya başladım."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:69
translate tr event_mc_newarmor_a857a5b5:

    # "{i}My son,{/i}"
    "{i}Oğlum,{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:70
translate tr event_mc_newarmor_155a8472:

    # "{i}I am both troubled and proud to hear of your services to the Scouts corps.{/i}"
    "{i}İzci birliklerine hizmetlerini duymaktan hem sıkıntılı hem de gururluyum.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:71
translate tr event_mc_newarmor_1bd0e806:

    # "{i}I am angered as to why you were sent there to begin with, despite the assurances of those of higher stations than mine, that you and your friends places were secured with administrative roles only.{/i}"
    "{i}En başta neden oraya gönderildiğine kızgınım, benden daha yüksek makamdakilerin, senin ve arkadaşlarının yerlerinin sadece idari rollerle güvence altına alındığına dair güvencelerine rağmen.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:72
translate tr event_mc_newarmor_879aa470:

    # "{i}Despite what I can only assume to be the result of clerical errors, I have heard of you and Markus' bravery, and how you both were the sole survivors of a mission gone awry.{/i}"
    "{i}Sadece katiplik hatalarının sonucu olduğunu varsayabildiğime rağmen, senin ve Markus'un cesaretini ve ikinizin nasıl ters giden bir görevin tek hayatta kalanları olduğunuzu duydum.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:73
translate tr event_mc_newarmor_36456eef:

    # "{i}There is no greater fear for a father, than to lose his only son, and it pleases me greatly to know you are still hopefully well by the time this letter reaches you.{/i}"
    "{i}Bir baba için, tek oğlunu kaybetmekten daha büyük bir korku yoktur ve bu mektup sana ulaştığında hala umarım iyi olduğunu bilmek beni büyük ölçüde memnun eder.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:74
translate tr event_mc_newarmor_980ce1e6:

    # "{i}My work here is important, but it is so far mostly safe, despite the days dragging long tediously.{/i}"
    "{i}Buradaki işim önemli, ama şimdiye kadar çoğunlukla güvenli, günler uzun ve sıkıcı geçse de.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:75
translate tr event_mc_newarmor_bdff8cf2:

    # "{i}I look forward to seeing you, Erika, and everyone soon in the next few months.{/i}"
    "{i}Seni, Erika'yı ve herkesi önümüzdeki birkaç ay içinde yakında görmeyi dört gözle bekliyorum.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:76
translate tr event_mc_newarmor_58cdd376:

    # "{i}In the last letter I received, it mentioned you and that Adara girl were still close.{/i}"
    "{i}Aldığım son mektupta, senin ve şu Adara kızının hala yakın olduğundan bahsediliyordu.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:77
translate tr event_mc_newarmor_a593e099:

    # "{i}Perhaps when I am back, I could speak to her father to arrange your betrothal if you wish?{/i}"
    "{i}Belki döndüğümde, eğer istersen nişanınızı ayarlamak için babasıyla konuşabilirim?{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:78
translate tr event_mc_newarmor_a25b1eff:

    # "{i}It would be good for some good to come from all this darkness recently...{/i}"
    "{i}Son zamanlardaki tüm bu karanlıktan bazı iyi şeyler çıkması iyi olurdu...{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:79
translate tr event_mc_newarmor_92e51415:

    # "{i}Now, I have sent to you a gift as I am sure you have received with this letter.{/i}"
    "{i}Şimdi, bu mektupla birlikte aldığınızdan emin olduğum gibi sana bir hediye gönderdim.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:80
translate tr event_mc_newarmor_89cc93c0:

    # "{i}I have been told that you have been entered involuntarily into the Adventurers Guild as per the Emperor's will.{/i}"
    "{i}İmparatorun iradesine göre gönülsüzce Maceracılar Loncası'na kaydedildiğin söylendi.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:81
translate tr event_mc_newarmor_79c549a8:

    # "{i}Despite my complete displeasure at the events that have unfolded, we must do the best we can with the cards dealt.{/i}"
    "{i}Gerçekleşen olaylardan tamamen memnuniyetsiz olmama rağmen, dağıtılan kartlarla elimizden gelenin en iyisini yapmalıyız.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:82
translate tr event_mc_newarmor_c350386b:

    # "{i}Therefore, I cannot bear the thought of you running around in whatever scrap metal they have given you and called 'armour' for your line of work.{/i}"
    "{i}Bu nedenle, sana verdikleri ve işin için 'zırh' diye adlandırdıkları her tür hurda metalin içinde koştuğunu düşünmeye dayanamıyorum.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:83
translate tr event_mc_newarmor_716596ef:

    # "{i}I have spent of my own coin to have fashioned for your armour that may actually protect you.{/i}"
    "{i}Seni gerçekten koruyabilecek zırhın senin için yaptırılması için kendi paramdan harcadım.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:84
translate tr event_mc_newarmor_6191ad84:

    # "{i}I have heard you are far larger now since I last saw you, and I hope given the reports I received that I have gotten the right size.{/i}"
    "{i}Seni en son gördüğümden beri çok daha büyük olduğunu duydum ve aldığım raporlara göre doğru bedeni ayarladığımı umuyorum.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:85
translate tr event_mc_newarmor_6f096071:

    # "{i}I hope it serves and protects you well my son, I will pray for your safety along with my own.{/i}"
    "{i}Umarım sana iyi hizmet eder ve seni korur oğlum, kendiminkiyle birlikte güvenliğin için dua edeceğim.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:86
translate tr event_mc_newarmor_7be7e97d:

    # "{i}Love, your father.{/i}"
    "{i}Sevgiler, baban.{/i}"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:87
translate tr event_mc_newarmor_b721a6c6:

    # MC "(...Father.)"
    MC "(...Babam.)"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:89
translate tr event_mc_newarmor_f879d3c7:

    # "Placing down the letter, I looked over towards the armour and after stripping down, placed it on piece by piece."
    "Mektubu bırakarak, zırha doğru baktım ve soyunduktan sonra, parça parça üzerime koydum."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:91
translate tr event_mc_newarmor_b0a71ca1:

    # "It was certainly heavier than the old armour, yet not by much, and it fit my frame surprisingly well."
    "Eski zırhtan kesinlikle daha ağırdı, ama çok değil ve çerçeveme şaşırtıcı derecede iyi uydu."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:96
translate tr event_mc_newarmor_edd2f054:

    # "As I looked down towards my hand, I crunched it tightly into a ball."
    "Elime doğru bakarken, sıkıca bir top haline getirdim."

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:97
translate tr event_mc_newarmor_ef4bd956:

    # MC "(Next time.)"
    MC "(Bir dahaki sefere.)"

# game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:98
translate tr event_mc_newarmor_67adc9b3:

    # MC "(Next time I'll be ready for whatever comes.)"
    MC "(Bir dahaki sefere ne gelirse hazır olacağım.)"

translate tr strings:

    # game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:31
    old "I was attacked by... {i}something.{/i}"
    new "...{i}bir şey{/i} tarafından saldırıya uğradım."

    # game/data/world_events/novaras/mc_newarmor/ev_mcNewarmor.rpy:35
    old "I'm fine... They're over-exaggerating."
    new "İyiyim... Aşırı abartıyorlar."

