# game/data/world_interactions/black_diamond_arena/aio.rpy:38
translate tr black_diamond_arena_firstEnter_2471c171:

    # "As I stumbled down the flight of stairs, I heard the bellowing roar of cheers and something snarling down below."
    "Merdivenlerin alt katına sendelerken, aşağıda tezahüratların kükreyen kükremesini ve bir şeyin hırladığını duydum."

# game/data/world_interactions/black_diamond_arena/aio.rpy:39
translate tr black_diamond_arena_firstEnter_1352313f:

    # "Coming upon a great darkened underground Arena, men gathered around and cheered as two reptilian beasts slashed and tore at each other in the fight pit below."
    "Büyük, karanlık bir yeraltı Arenası'na geldiğimde, aşağıdaki dövüş çukurunda iki sürüngen canavar birbirini kesip parçalarken adamlar toplanıp tezahürat yaptı."

# game/data/world_interactions/black_diamond_arena/aio.rpy:40
translate tr black_diamond_arena_firstEnter_8b799890:

    # "The one leapt and gripped the others throat with its teeth, ripping it out in a violent bloody display that the crowd roared with pleasure too."
    "Biri sıçradı ve diğerinin boğazını dişleriyle kavradı, şiddetli kanlı bir gösteriyle kopardı, kalabalık da buna zevkle kükredi."

# game/data/world_interactions/black_diamond_arena/aio.rpy:41
translate tr black_diamond_arena_firstEnter_b2c9c7fd:

    # MC "(What is this place?)"
    MC "(Burası ne böyle?)"

# game/data/world_interactions/black_diamond_arena/aio.rpy:45
translate tr black_diamond_arena_firstEnter_51fba3e4:

    # BOOKKEEPER "Oi!"
    BOOKKEEPER "Hey!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:46
translate tr black_diamond_arena_firstEnter_ac3da786:

    # MC @ surprised "Huh?"
    MC @ surprised "Ha?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:47
translate tr black_diamond_arena_firstEnter_557daccb:

    # BOOKKEEPER "Zer are no freeloaders! Either place a bet, or fuck off!"
    BOOKKEEPER "Bedavacı olmaz iz! Ya bahis oyna, ya defol!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:48
translate tr black_diamond_arena_firstEnter_fc48861a:

    # MC @ talk "A bet?"
    MC @ talk "Bahis mi?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:49
translate tr black_diamond_arena_firstEnter_6faeae54:

    # BOOKKEEPER "Iz stupid or something?"
    BOOKKEEPER "Aptal falan mı iz?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:56
translate tr black_diamond_bookkeeper_talk_2fb4960b:

    # BOOKKEEPER "No. You off limit. Come back in a few dayz."
    BOOKKEEPER "Hayır. Sen yasak. Birkaç gün sonra geri gel."

# game/data/world_interactions/black_diamond_arena/aio.rpy:57
translate tr black_diamond_bookkeeper_talk_615eedc7:

    # MC "Okay."
    MC "Tamam."

# game/data/world_interactions/black_diamond_arena/aio.rpy:59
translate tr black_diamond_bookkeeper_talk_73727c63:

    # BOOKKEEPER "Beasts fight below, you bet."
    BOOKKEEPER "Canavarlar aşağıda dövüşüyor, sen bahis oynuyorsun."

# game/data/world_interactions/black_diamond_arena/aio.rpy:60
translate tr black_diamond_bookkeeper_talk_376ff848:

    # BOOKKEEPER "Your beast wins, you get coin."
    BOOKKEEPER "Senin canavarın kazanırsa, para alıyorsun."

# game/data/world_interactions/black_diamond_arena/aio.rpy:61
translate tr black_diamond_bookkeeper_talk_cba48cb5:

    # BOOKKEEPER "Zat's it, you want bet?"
    BOOKKEEPER "İşte bu, bahis oynamak ister misin?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:64
translate tr black_diamond_bookkeeper_talk_menu_26b1e50b:

    # BOOKKEEPER "How much?"
    BOOKKEEPER "Ne kadar?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:76
translate tr black_diamond_bookkeeper_talk_menu_8a0c5ec4:

    # BOOKKEEPER "Very good!"
    BOOKKEEPER "Çok iyi!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:77
translate tr black_diamond_bookkeeper_talk_menu_83429a1e:

    # BOOKKEEPER "Enjoy fight! Collect coin after if win!"
    BOOKKEEPER "Dövüş keyfini çıkar! Kazanırsan sonra para al!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:80
translate tr black_diamond_bookkeeper_talk_menu_577c9037:

    # BOOKKEEPER "Rules iz simple!"
    BOOKKEEPER "Kurallar basit iz!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:81
translate tr black_diamond_bookkeeper_talk_menu_824d265f:

    # BOOKKEEPER "You bet on either creature to win, first to kill zer other wins."
    BOOKKEEPER "Sen hangi yaratığın kazanacağına bahis oynuyorsun, diğerini ilk öldüren kazanır."

# game/data/world_interactions/black_diamond_arena/aio.rpy:82
translate tr black_diamond_bookkeeper_talk_menu_ba9aaef0:

    # BOOKKEEPER "Az newbie, you iz only able to bet one thousand coins a week."
    BOOKKEEPER "Çaylak olarak, haftada sadece bin paraya bahis oynayabilirsin iz."

# game/data/world_interactions/black_diamond_arena/aio.rpy:83
translate tr black_diamond_bookkeeper_talk_menu_ec70c2c2:

    # BOOKKEEPER "Coin pay upfront before bet go on."
    BOOKKEEPER "Para bahis başlamadan peşin ödenir."

# game/data/world_interactions/black_diamond_arena/aio.rpy:84
translate tr black_diamond_bookkeeper_talk_menu_b6289d56:

    # MC @ talk "That seems odd, why the limit?"
    MC @ talk "Bu garip görünüyor, neden limit?"

# game/data/world_interactions/black_diamond_arena/aio.rpy:85
translate tr black_diamond_bookkeeper_talk_menu_40d9f557:

    # BOOKKEEPER "Too many try cheat."
    BOOKKEEPER "Çok fazla kişi hile yapmaya çalışıyor."

# game/data/world_interactions/black_diamond_arena/aio.rpy:86
translate tr black_diamond_bookkeeper_talk_menu_2ade3781:

    # BOOKKEEPER "One try poisoning a beasty and placing huge bet on other."
    BOOKKEEPER "Biri bir canavarcığı zehirleyip diğerine büyük bahis oynadı."

# game/data/world_interactions/black_diamond_arena/aio.rpy:87
translate tr black_diamond_bookkeeper_talk_menu_f8b9be59:

    # BOOKKEEPER "Now, only trusted members can make big bets."
    BOOKKEEPER "Şimdi, sadece güvenilir üyeler büyük bahisler yapabilir."

# game/data/world_interactions/black_diamond_arena/aio.rpy:90
translate tr black_diamond_bookkeeper_talk_menu_b72566e1:

    # BOOKKEEPER "Than leave already!"
    BOOKKEEPER "O zaman çoktan git!"

# game/data/world_interactions/black_diamond_arena/aio.rpy:108
