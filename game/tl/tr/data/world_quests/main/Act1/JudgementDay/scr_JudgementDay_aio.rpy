    "Önümdeki garip varlıklara inançsızlıkla baktım."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3720
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_741be655:

    # "Were they..."
    "Onlar mıydı..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3721
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_3e1c9fce:

