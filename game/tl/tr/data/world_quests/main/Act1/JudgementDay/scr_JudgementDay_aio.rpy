    ELENA @ grumpy "Şehirler yeniden inşa edilebilir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1847
translate tr qst_JudgementDay_GotToTheWall_656dce71:

