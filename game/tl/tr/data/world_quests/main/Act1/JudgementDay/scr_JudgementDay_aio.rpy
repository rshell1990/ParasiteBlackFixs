translate tr qst_JudgementDay_GoToHousing2_dbd95526:

    # "...The district, like the others, was ablaze, yet there was an ominous, distinct lack of cries or clashing blades, as though the entire place had fallen silent."
    "...Bu bölge, diğerleri gibi, alev almıştı, ancak uğursuz, belirgin bir çığlık veya çarpışan bıçak eksikliği vardı, sanki tüm yer sessizliğe gömülmüştü."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1440
translate tr qst_JudgementDay_GoToHousing2_a5458705:

    # "The sickening stench of burning flesh filled the air, thick and heavy."
    "Yanan etin mide bulandırıcı kokusu havayı doldurdu, kalın ve ağır."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1442
translate tr qst_JudgementDay_GoToHousing2_615f551f:

    # "As we pressed forward, the eerie quiet only made everything more unsettling."
    "İlerlerken, ürkütücü sessizlik sadece her şeyi daha rahatsız edici hale getirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1444
translate tr qst_JudgementDay_GoToHousing2_a9cf6c8e:

    # ERIKA "We must keep moving..."
    ERIKA "Hareket etmeye devam etmeliyiz..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1445
translate tr qst_JudgementDay_GoToHousing2_237601c4:

    # MARKUS "Sister Divine asked us to find the missing Mages of Palam."
    MARKUS "Rahibe Divine kayıp Palam Büyücülerini bulmamızı istedi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1447
translate tr qst_JudgementDay_GoToHousing2_5af1a6cd:

    # ERIKA "There is no time for detours!"
    ERIKA "Dolaplar için zamanımız yok!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1448
translate tr qst_JudgementDay_GoToHousing2_7b3dbf60:

    # ERIKA "The city's safety takes priority!"
    ERIKA "Şehrin güvenliği önceliklidir!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1458
translate tr qst_JudgementDay_GoToHousing2_16b0163e:

    # ERIKA "This way... I know a shortcut."
    ERIKA "Bu taraftan... Bir kestirme biliyorum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1467
translate tr qst_JudgementDay_RescueMages_Prep_9e4944f2:

    # ERIKA "Fine, but we must hurry!"
    ERIKA "Peki, ama acele etmeliyiz!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1474
translate tr qst_JudgementDay_RescueMages_Prep_46309dca:

    # "We scoured the district, but neither I nor Markus could pick up their scent through the thick smoke."
    "Bölgeyi taradık, ama ne ben ne de Markus kalın dumanın içinde kokularını alamadık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1476
translate tr qst_JudgementDay_RescueMages_Prep_838c0731:

    # "Suddenly, a sharp cry echoed through the air."
    "Aniden, keskin bir çığlık havada yankılandı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1478
translate tr qst_JudgementDay_RescueMages_Prep_65fb0b3b:

    # MC "This way!"
    MC "Bu taraftan!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1479
translate tr qst_JudgementDay_RescueMages_Prep_d983de2b:

    # "We followed the sound, hurrying through the burning streets to find the entrance of a noble's manor."
    "Sesi takip ettik, yanan sokaklardan acele ederek bir asilzadenin malikanesinin girişini bulduk."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1480
translate tr qst_JudgementDay_RescueMages_Prep_e92cf3e1:

    # "From inside, I could hear muffled cries of pain."
    "İçeriden, boğuk acı çığlıkları duyabiliyordum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1482
translate tr qst_JudgementDay_RescueMages_Prep_910eb21e:

    # "Slamming a fist against the bolted door, I called out."
    "Sürgülü kapıya bir yumruk indirerek, seslendim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1483
translate tr qst_JudgementDay_RescueMages_Prep_92b4ade6:

    # SOPHIRA "Go away! Be gone, creature!"
    SOPHIRA "Git! Defol, yaratık!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1484
translate tr qst_JudgementDay_RescueMages_Prep_357ae423:

    # MC "Sister Divine sent us! We're looking for the lost Palam mages who never returned!"
    MC "Rahibe Divine bizi gönderdi! Geri dönmeyen kayıp Palam büyücülerini arıyoruz!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1485
translate tr qst_JudgementDay_RescueMages_Prep_778ec10a:

    # SOPHIRA "L-Lies! Begone, monster!"
    SOPHIRA "Y-Yalanlar! Defol, canavar!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1488
translate tr qst_JudgementDay_RescueMages_Prep_a350cb10:

    # "Erika stepped forward, slamming her fist against the door."
    "Erika öne çıktı, yumruğunu kapıya indirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1489
translate tr qst_JudgementDay_RescueMages_Prep_14f45b1f:

    # ERIKA "By order of the Inquisition, I demand you open this door!"
    ERIKA "Engizisyonun emriyle, bu kapıyı açmanı talep ediyorum!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1490
translate tr qst_JudgementDay_RescueMages_Prep_4a41de21:

    # "There was a long pause before a sheepish face peeked through the gap."
    "Uzun bir duraklama oldu, sonra aralıktan mahcup bir yüz baktı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1493
translate tr qst_JudgementDay_RescueMages_Prep_329c6e6a:

    # "A woman, disheveled and covered in ash, but distinctly noble, oddly resembled Adara in appearance."
    "Bir kadın, dağınık ve küle bulanmış, ama belirgin şekilde asil, garip bir şekilde görünüşte Adara'yı andırıyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1495
translate tr qst_JudgementDay_RescueMages_Prep_ee6d7f8e:

    # "Upon seeing me and Markus, she gasped and attempted to slam the door shut, but Erika wedged her foot in before she could."
    "Beni ve Markus'u görünce, nefesini tuttu ve kapıyı çarparak kapatmaya çalıştı, ama Erika yapamadan ayağını sıkıştırdı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1497
translate tr qst_JudgementDay_RescueMages_Prep_8e798dd8:

    # SOPHIRA "G-Get back!"
    SOPHIRA "G-Geri çekilin!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1498
translate tr qst_JudgementDay_RescueMages_Prep_e1310062:

    # ERIKA "Hold!"
    ERIKA "Bekle!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1499
translate tr qst_JudgementDay_RescueMages_Prep_10c0580a:

    # ERIKA "They are with me."
    ERIKA "Onlar benimle."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1500
translate tr qst_JudgementDay_RescueMages_Prep_cf899e87:

    # "The woman's wide, fearful eyes darted back and forth between me and Markus before she hesitantly turned back to Erika."
    "Kadının büyümüş, korkulu gözleri ben ve Markus arasında gidip geldi, sonra tereddütle Erika'ya geri döndü."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1501
translate tr qst_JudgementDay_RescueMages_Prep_c1aa6fc5:

    # ERIKA "Who are you?"
    ERIKA "Kimsiniz?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1502
translate tr qst_JudgementDay_RescueMages_Prep_ca9584e7:

    # SOPHIRA "...I..."
    SOPHIRA "...Ben..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1503
translate tr qst_JudgementDay_RescueMages_Prep_f34e4dec:

    # SOPHIRA "I am Lady Maringott, but call me Sophira."
    SOPHIRA "Ben Leydi Maringott, ama bana Sophira de."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1505
translate tr qst_JudgementDay_RescueMages_Prep_dcfb449e:

    # ERIKA "The Mages of Palam—are they here?"
    ERIKA "Palam Büyücüleri—buradalar mı?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1506
translate tr qst_JudgementDay_RescueMages_Prep_0988535a:

    # SOPHIRA "Y-Yes... Come quickly."
    SOPHIRA "E-Evet... Çabuk gelin."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1510
translate tr qst_JudgementDay_RescueMages_Prep_89f25f4f:

    # "Sophira led us into the main hall of the manor, now a makeshift infirmary littered with wounded men and women."
    "Sophira bizi malikanenin ana salonuna yönlendirdi, şimdi yaralı erkek ve kadınlarla dolu derme çatma bir revir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1511
translate tr qst_JudgementDay_RescueMages_Prep_18de3914:

    # "The air was filled with pained groans as bloodied civilians and soldiers writhed on hastily arranged beds."
    "Hava, kanlı siviller ve askerler aceleyle düzenlenmiş yataklarda kıvranırken acı dolu inlemelerle doluydu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1512
translate tr qst_JudgementDay_RescueMages_Prep_ef679b7f:

    # "Exhausted Mages of Palam moved frantically, tending to the wounded."
    "Bitkin Palam Büyücüleri çılgınca hareket etti, yaralılarla ilgileniyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1515
translate tr qst_JudgementDay_RescueMages_Prep_be997334:

    # "The chaos of the scene meant few even looked up at us."
    "Sahnenin kaosu, çok azının bize bakması anlamına geliyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1519
translate tr qst_JudgementDay_RescueMages_Prep_4cb32837:

    # ERIKA "What is going on here?"
    ERIKA "Burada neler oluyor?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1520
translate tr qst_JudgementDay_RescueMages_Prep_32a7d9bc:

    # SOPHIRA "The attack came so suddenly..."
    SOPHIRA "Saldırı çok ani geldi..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1521
translate tr qst_JudgementDay_RescueMages_Prep_ab1b8518:

    # SOPHIRA "We opened our doors to shelter as many as we could, but the wounded kept piling in."
    SOPHIRA "Kapılarımızı olabildiğince barınak için açtık, ama yaralılar yığılmaya devam etti."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1522
translate tr qst_JudgementDay_RescueMages_Prep_08869913:

    # "Her face darkened."
    "Yüzü karardı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1523
translate tr qst_JudgementDay_RescueMages_Prep_46f9b89b:

    # SOPHIRA "...Some of the mages didn't make it."
    SOPHIRA "...Bazı büyücüler başaramadı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1524
translate tr qst_JudgementDay_RescueMages_Prep_c277dfeb:

    # SOPHIRA "But those who remain have been a blessing from the gods."
    SOPHIRA "Ama kalanlar tanrılardan bir kutsama oldu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1525
translate tr qst_JudgementDay_RescueMages_Prep_ba99da2c:

    # SOPHIRA "I fear many more would have perished without them."
    SOPHIRA "Onlar olmasa çok daha fazlası can verirdi korkarım."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1526
translate tr qst_JudgementDay_RescueMages_Prep_288b2912:

    # ERIKA "Where is your husband?"
    ERIKA "Kocanız nerede?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1527
translate tr qst_JudgementDay_RescueMages_Prep_2b343ada:

    # SOPHIRA "My husband lost his legs many years ago."
    SOPHIRA "Kocam yıllar önce bacaklarını kaybetti."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1528
translate tr qst_JudgementDay_RescueMages_Prep_d5a91e24:

    # SOPHIRA "I've confined him to his room for safety until this nightmare ends."
    SOPHIRA "Bu kâbus bitene kadar onu güvenlik için odasına kapattım."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1529
translate tr qst_JudgementDay_RescueMages_Prep_9804f65a:

    # MC "What can we do to help?"
    MC "Yardım etmek için ne yapabiliriz?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1530
translate tr qst_JudgementDay_RescueMages_Prep_3cc7ceca:

    # SOPHIRA "Please... We need more medicine. The mages are exhausted."
    SOPHIRA "Lütfen... Daha fazla ilaca ihtiyacımız var. Büyücüler bitkin."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1531
translate tr qst_JudgementDay_RescueMages_Prep_6260956e:

    # ERIKA "Take these people to the main fort. There will be—"
    ERIKA "Bu insanları ana kaleye götür. Orada—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1532
translate tr qst_JudgementDay_RescueMages_Prep_08946951:

    # SOPHIRA "No!"
    SOPHIRA "Hayır!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1533
translate tr qst_JudgementDay_RescueMages_Prep_16119eaf:

    # SOPHIRA "None of the wounded can fight, and the mages are too drained."
    SOPHIRA "Yaralıların hiçbiri savaşamaz ve büyücüler çok tükenmiş."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1534
translate tr qst_JudgementDay_RescueMages_Prep_8bff53d6:

    # SOPHIRA "We'd be slaughtered if we tried to move now."
    SOPHIRA "Şimdi taşınmaya çalışsak katlediliriz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1535
translate tr qst_JudgementDay_RescueMages_Prep_b0728f26:

    # MC "Then what do you suggest?"
    MC "O zaman ne öneriyorsunuz?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1536
translate tr qst_JudgementDay_RescueMages_Prep_cbc9f014:

    # SOPHIRA "The basement."
    SOPHIRA "Bodrum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1537
translate tr qst_JudgementDay_RescueMages_Prep_94f195d8:

    # SOPHIRA "There are more medical supplies, food, and water down there."
    SOPHIRA "Aşağıda daha fazla tıbbi malzeme, yiyecek ve su var."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1538
translate tr qst_JudgementDay_RescueMages_Prep_1fc6089c:

    # ERIKA "Then why haven't you retrieved them already?"
    ERIKA "O zaman neden onları zaten çıkarmadınız?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1539
translate tr qst_JudgementDay_RescueMages_Prep_8e33a28a:

    # SOPHIRA "{i}...Something is down there.{/i}"
    SOPHIRA "{i}...Aşağıda bir şey var.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1540
translate tr qst_JudgementDay_RescueMages_Prep_069e8943:

    # SOPHIRA "When everything started, we heard strange noises coming from the basement."
    SOPHIRA "Her şey başladığında, bodrumdan garip sesler geliyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1541
translate tr qst_JudgementDay_RescueMages_Prep_519c41a4:

    # SOPHIRA "We sent two guards down to check, and then... we heard the most awful sounds."
    SOPHIRA "Kontrol etmeleri için iki muhafız gönderdik, ve sonra... en berbat sesleri duyduk."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1542
translate tr qst_JudgementDay_RescueMages_Prep_856a2c1b:

    # ERIKA "Is the basement secure now?"
    ERIKA "Bodrum şimdi güvende mi?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1543
translate tr qst_JudgementDay_RescueMages_Prep_6cd2601f:

    # SOPHIRA "Yes... We bolted and barricaded it shut."
    SOPHIRA "Evet... Sürgüledik ve barikatladık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1544
translate tr qst_JudgementDay_RescueMages_Prep_4df24ebb:

    # SOPHIRA "{i}But we can still hear something moving down there...{/i}"
    SOPHIRA "{i}Ama hala aşağıda bir şeyin hareket ettiğini duyabiliyoruz...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1545
translate tr qst_JudgementDay_RescueMages_Prep_3ca32141:

    # MC "Where is this basement?"
    MC "Bu bodrum nerede?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1546
translate tr qst_JudgementDay_RescueMages_Prep_1307e2ea:

    # SOPHIRA "Wait...! Before you go."
    SOPHIRA "Bekleyin...! Gitmeden önce."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1547
translate tr qst_JudgementDay_RescueMages_Prep_f0cc9421:

    # SOPHIRA "Take these."
    SOPHIRA "Bunları alın."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1552
translate tr qst_JudgementDay_RescueMages_Prep_fb70bf95:

    # SOPHIRA "I can't spare much, but... hopefully, you'll be able to clear out whatever's down there."
    SOPHIRA "Fazla ayıramam, ama... umarım orada ne varsa temizleyebilirsiniz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1553
translate tr qst_JudgementDay_RescueMages_Prep_bf0933ee:

    # ERIKA "Take us to the basement."
    ERIKA "Bizi bodruma götürün."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1554
translate tr qst_JudgementDay_RescueMages_Prep_ed135172:

    # ERIKA "We don't have much time."
    ERIKA "Fazla zamanımız yok."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1563
translate tr qst_JudgementDay_RescueMages_Prep_de8d52ca:

    # "...The basement door was heavily barricaded, tables and chairs stacked against it in a desperate attempt to keep something locked inside."
    "...Bodrum kapısı ağırca barikatlanmıştı, masalar ve sandalyeler içeride bir şeyi kilitli tutmak umutsuz bir çabayla ona karşı yığılmıştı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1564
translate tr qst_JudgementDay_RescueMages_Prep_5510eb32:

    # "It took several minutes to clear away the debris before we reached the door itself."
    "Kapıya ulaşmadan önce enkazı temizlemek birkaç dakika sürdü."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1565
translate tr qst_JudgementDay_RescueMages_Prep_2d08aad9:

    # "Sophira hesitated, stepping back as I reached for the handle."
    "Sophira tereddüt etti, ben kilit koluna uzandığımda geri adım attı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1569
translate tr qst_JudgementDay_RescueMages_Prep_f2fd1f30:

    # "As the door creaked open, an eerie darkness stretched down into the unknown."
    "Kapı gıcırdayarak açılırken, ürkütücü bir karanlık bilinmeyene doğru uzandı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1571
translate tr qst_JudgementDay_RescueMages_Prep_9f7bb532:

    # MARKUS "...You first."
    MARKUS "...Önce sen."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1572
translate tr qst_JudgementDay_RescueMages_Prep_2464d270:

    # "Step by step, we descended into the oppressive darkness, the cold stone beneath our feet making every movement feel heavier."
    "Adım adım, baskıcı karanlığa indik, ayaklarımızın altındaki soğuk taş her hareketi daha ağır hissettiriyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1574
translate tr qst_JudgementDay_RescueMages_Prep_a5faaf6e:

    # "Elena whined nervously behind me."
    "Elena arkamda sinirli bir şekilde inledi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1576
translate tr qst_JudgementDay_RescueMages_Prep_20c6c022:

    # MC "Calm, Elena."
    MC "Sakin, Elena."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1580
translate tr qst_JudgementDay_RescueMages_Prep_05531ad1:

    # MYU "T-This seems like a bad idea to Myu..."
    MYU "B-Bu Myu'ya kötü bir fikir gibi geliyor..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1585
translate tr qst_JudgementDay_RescueMages_Prep_784f60a8:

    # "Finally, we reached the bottom."
    "Sonunda, dibe ulaştık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1586
translate tr qst_JudgementDay_RescueMages_Prep_a1b18879:

    # "Even in the dim light, I could see the place was a mess—broken crates, toppled shelves, and shattered bottles lay scattered across the floor."
    "Loş ışıkta bile, yerin bir pislik olduğunu görebiliyordum—kırık kasalar, devrilmiş raflar ve parçalanmış şişeler yere saçılmıştı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1587
translate tr qst_JudgementDay_RescueMages_Prep_d10a2b67:

    # "Food, medicine, and supplies lay in ruined heaps as though some wild beast had rampaged through here."
    "Yiyecek, ilaç ve malzemeler, vahşi bir canavarın burayı yağmalamış gibi harap yığınlarda yatıyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1588
translate tr qst_JudgementDay_RescueMages_Prep_b06dde3e:

    # "Most disturbing of all was the heavy trail of blood that led deeper into the room... only to suddenly disappear in the middle of the floor."
    "En rahatsız edici olanı, odanın derinliklerine doğru giden ağır kan iziydi... ancak aniden zeminin ortasında kayboldu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1589
translate tr qst_JudgementDay_RescueMages_Prep_84dbeb44:

    # "Erika tightened her grip on her sword as a strange dragging sound echoed through the chamber."
    "Erika, garip bir sürüklenme sesi odayı yankıladığında kılıcındaki kavrayışını sıkılaştırdı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1590
translate tr qst_JudgementDay_RescueMages_Prep_f34d9a6e:

    # ERIKA "{i}It's still here...{/i}"
    ERIKA "{i}Hala burada...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1591
translate tr qst_JudgementDay_RescueMages_Prep_fc93b91b:

    # "A sinister, wet slithering noise grew louder, circling us from the shadows."
    "Uğursuz, ıslak bir sürünme sesi yükseldi, gölgelerden bizi daire içine aldı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1592
translate tr qst_JudgementDay_RescueMages_Prep_07a3131b:

    # "And then, as if the very darkness itself was shifting, everything went still..."
    "Ve sonra, sanki karanlığın kendisi kayıyor gibi, her şey durdu..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1602
translate tr qst_JudgementDay_RescueMages_Prep_7b8076d7:

    # "Writhing in agony, the creature let out a sickening bellow as blood sprayed across the walls."
    "Istırap içinde kıvranan yaratık, duvarlara kan fışkırırken mide bulandırıcı bir böğürtü saldı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1604
translate tr qst_JudgementDay_RescueMages_Prep_b620a0e1:

    # "In a final desperate lunge, it attempted to strike—but with a swift swipe of my tail, its head tumbled to the floor, lifeless."
    "Son umutsuz bir atılımda, vurmaya çalıştı—ama kuyruğumun hızlı bir darbesiyle, kafası yere yuvarlandı, cansız."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1606
translate tr qst_JudgementDay_RescueMages_Prep_503eb673:

    # MARKUS "{i}*Huff*{/i} What in all the gods was that thing?"
    MARKUS "{i}*Huff*{/i} O şey de tüm tanrılar aşkına neydi?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1608
translate tr qst_JudgementDay_RescueMages_Prep_836a7533:

    # ERIKA "{i}I've seen creatures like this before...{/i}"
    ERIKA "{i}Böyle yaratıkları daha önce gördüm...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1609
translate tr qst_JudgementDay_RescueMages_Prep_e7942df9:

    # MARKUS "You have?"
    MARKUS "Gördün mü?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1610
translate tr qst_JudgementDay_RescueMages_Prep_8b418497:

    # ERIKA "Dark mages can create many horrors..."
    ERIKA "Kara büyücüler birçok korkunçluk yaratabilir..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1611
translate tr qst_JudgementDay_RescueMages_Prep_4c777b59:

    # MARKUS "Wait, are you saying dark mages are working with the Demorai?"
    MARKUS "Bekle, kara büyücülerin Demorai ile çalıştığını mı söylüyorsun?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1612
translate tr qst_JudgementDay_RescueMages_Prep_a7d1cbb7:

    # ERIKA "Who knows? We don't have time to speculate."
    ERIKA "Kim bilir? Spekülasyon yapacak zamanımız yok."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1613
translate tr qst_JudgementDay_RescueMages_Prep_00904404:

    # ERIKA "Let's go back and tell Sophira it's safe."
    ERIKA "Geri dönüp Sophira'ya güvenli olduğunu söyleyelim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1622
translate tr qst_JudgementDay_RescueMages_Prep_cc1017a7:

    # SOPHIRA "You're back!"
    SOPHIRA "Döndünüz!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1623
translate tr qst_JudgementDay_RescueMages_Prep_d8f05fb2:

    # SOPHIRA "We heard terrible noises—I feared the worst!"
    SOPHIRA "Korkunç sesler duyduk—En kötüsünden korktum!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1624
translate tr qst_JudgementDay_RescueMages_Prep_249d38dc:

    # ERIKA "It's safe now."
    ERIKA "Artık güvenli."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1625
translate tr qst_JudgementDay_RescueMages_Prep_66fbe380:

    # ERIKA "Though I'm afraid much of the medicine may be lost..."
    ERIKA "Yine de ilacın çoğu kaybolmuş olabilir korkarım..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1626
translate tr qst_JudgementDay_RescueMages_Prep_bea94ee9:

    # SOPHIRA "We'll make do. Thank you."
    SOPHIRA "İdare ederiz. Teşekkür ederim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1627
translate tr qst_JudgementDay_RescueMages_Prep_3a185799:

    # "Sophira turned toward me and Markus, her expression softening."
    "Sophira bana ve Markus'a döndü, ifadesi yumuşadı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1628
translate tr qst_JudgementDay_RescueMages_Prep_a3550950:

    # SOPHIRA "...Thank you."
    SOPHIRA "...Teşekkür ederim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1629
translate tr qst_JudgementDay_RescueMages_Prep_8e36738f:

    # SOPHIRA "You may have saved a lot of lives today."
    SOPHIRA "Bugün birçok hayat kurtarmış olabilirsiniz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1635
translate tr qst_JudgementDay_RescueMages_Prep_46afb077:

    # MYU "Hooray! Myu did a good!"
    MYU "Yaşasın! Myu iyi yaptı!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1636
translate tr qst_JudgementDay_RescueMages_Prep_42980294:

    # SOPHIRA "A-Ahh... Yes, you did."
    SOPHIRA "A-Ahh... Evet, yaptın."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1639
translate tr qst_JudgementDay_RescueMages_Prep_90da61ed:

    # ERIKA "We need to go."
    ERIKA "Gitmeliyiz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1640
translate tr qst_JudgementDay_RescueMages_Prep_98331877:

    # ERIKA "We've wasted enough time."
    ERIKA "Yeterince zaman harcadık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1641
translate tr qst_JudgementDay_RescueMages_Prep_8f616c48:

    # SOPHIRA "Wait! Before you leave..."
    SOPHIRA "Bekleyin! Gitmeden önce..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1642
translate tr qst_JudgementDay_RescueMages_Prep_5139d402:

    # SOPHIRA "Let one of the mages tend to your wounds. It's the least we can do."
    SOPHIRA "Bir büyücünün yaralarınıza bakmasına izin verin. Yapabileceğimizin en azı bu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1646
translate tr qst_JudgementDay_RescueMages_Prep_b9f6f48a:

    # "...After being healed by one of the mages, we made our way out."
    "...Büyücülerden biri tarafından iyileştirildikten sonra, dışarı çıktık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1650
translate tr qst_JudgementDay_RescueMages_Unprep_9e4944f2:

    # ERIKA "Fine, but we must hurry!"
    ERIKA "Peki, ama acele etmeliyiz!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1658
translate tr qst_JudgementDay_RescueMages_Unprep_46309dca:

    # "We scoured the district, but neither I nor Markus could pick up their scent through the thick smoke."
    "Bölgeyi taradık, ama ne ben ne de Markus kalın dumanın içinde kokularını alamadık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1659
translate tr qst_JudgementDay_RescueMages_Unprep_838c0731:

    # "Suddenly, a sharp cry echoed through the air."
    "Aniden, keskin bir çığlık havada yankılandı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1661
translate tr qst_JudgementDay_RescueMages_Unprep_65fb0b3b:

    # MC "This way!"
    MC "Bu taraftan!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1662
translate tr qst_JudgementDay_RescueMages_Unprep_d983de2b:

    # "We followed the sound, hurrying through the burning streets to find the entrance of a noble's manor."
    "Sesi takip ettik, yanan sokaklardan acele ederek bir asilzadenin malikanesinin girişini bulduk."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1663
translate tr qst_JudgementDay_RescueMages_Unprep_e92cf3e1:

    # "From inside, I could hear muffled cries of pain."
    "İçeriden, boğuk acı çığlıkları duyabiliyordum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1665
translate tr qst_JudgementDay_RescueMages_Unprep_f2d64bb0:

    # "Slamming my fist against it I called out to only be met with silence as my answer."
    "Kapıya yumruğumu indirerek seslendim, sadece cevap olarak sessizlikle karşılandım."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1667
translate tr qst_JudgementDay_RescueMages_Unprep_f5320ddb:

    # "Gripping at the door with my tentacles, I tore the thing open with ease and stepped inside."
    "Dokunaçlarımla kapıyı kavrayarak, şeyi kolayca kopardım ve içeri adım attım."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1671
translate tr qst_JudgementDay_RescueMages_Unprep_b6d10b53:

    # "The walls were laced in blood, bodies torn to shreds littered the place."
    "Duvarlar kana bulanmıştı, parçalanmış cesetler yere saçılmıştı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1672
translate tr qst_JudgementDay_RescueMages_Unprep_8caf742f:

    # "Here and there, a bit of bloodied blue flesh and skin as the sickly smell of blood and death filled the air."
    "Yer yer, biraz kanlı mavi et ve deri, kan ve ölümün mide bulandırıcı kokusu havayı dolduruyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1673
translate tr qst_JudgementDay_RescueMages_Unprep_46abadc0:

    # "It appears the mansion had been used as some kind of makeshift hospital."
    "Görünüşe göre malikane bir tür derme çatma hastane olarak kullanılmıştı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1674
translate tr qst_JudgementDay_RescueMages_Unprep_d5c2bc59:

    # "Or at least, it {i}was{/i} before something got in."
    "Ya da en azından, bir şey girmeden önce {i}öyleydi{/i}."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1677
translate tr qst_JudgementDay_RescueMages_Unprep_812649d0:

    # "Erika turned a shade of white as she struggled not to throw up."
    "Erika kusmamak için zorlanırken beyaz bir tona döndü."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1678
translate tr qst_JudgementDay_RescueMages_Unprep_d43eae69:

    # ERIKA "Gods... What happened in here?"
    ERIKA "Tanrılar... Burada ne oldu?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1680
translate tr qst_JudgementDay_RescueMages_Unprep_17e1d435:

    # MARKUS "It doesn't look like they managed to put up much of a fight..."
    MARKUS "Fazla bir mücadele verebilmiş gibi görünmüyorlar..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1681
translate tr qst_JudgementDay_RescueMages_Unprep_9cbf423d:

    # "A snapping sound echoed through the halls, followed by another ghastly scream."
    "Bir çıtırtı sesi koridorlarda yankılandı, ardından başka korkunç bir çığlık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1685
translate tr qst_JudgementDay_RescueMages_Unprep_18f10e05:

    # UNKNOWN "AHHHHHHHH!"
    UNKNOWN "AHHHHHHHH!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1686
translate tr qst_JudgementDay_RescueMages_Unprep_65fb0b3b_1:

    # MC "This way!"
    MC "Bu taraftan!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1689
translate tr qst_JudgementDay_RescueMages_Unprep_9893b43a:

    # "Chasing the screams led us down a hallway towards a strange entranceway leading underground."
    "Çığlıkları takip etmek bizi bir koridordan, yeraltına giden garip bir girişe doğru götürdü."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1690
translate tr qst_JudgementDay_RescueMages_Unprep_3e65ada3:

    # "With shattered chains around the entranceway, {i}something{/i} must have broken out."
    "Girişin etrafında parçalanmış zincirlerle, {i}bir şey{/i} kurtulmuş olmalı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1691
translate tr qst_JudgementDay_RescueMages_Unprep_3cc2ee74:

    # "A bone-chilling crunching sound was heard as we descended the stairs into that deep and terrible darkness."
    "O derin ve korkunç karanlığa, merdivenlerden inerken kemik donduran bir çıtırtı sesi duyuldu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1694
translate tr qst_JudgementDay_RescueMages_Unprep_fd50f717:

    # "There... waving a torch around the flooded basement, the water up to our ankles, we looked around for the source of the sound."
    "Orada... bir meşale, sular altındaki bodrumda sallanıyor, su ayak bileklerimize kadar, sesin kaynağını aradık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1695
translate tr qst_JudgementDay_RescueMages_Unprep_b164bb17:

    # "Slowly moving the light from left to right across the debris, there...{i}we saw it.{/i}"
    "Işığı yavaşça enkazın üzerinde soldan sağa hareket ettirirken, orada...{i}onu gördük.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1697
translate tr qst_JudgementDay_RescueMages_Unprep_cdd450ae:

    # "A snake like creature with a humanoid like body, sinking it's teeth once more into the woman in a blue dress."
    "Yılan benzeri, insansı bedenli bir yaratık, mavi elbiseli kadına dişlerini bir kez daha geçiriyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1698
translate tr qst_JudgementDay_RescueMages_Unprep_2d53ad4b:

    # "She let out one last raspy cry of pain as the thing chewed on her, the deep red sinking through and overpowering the blue."
    "Şey onu çiğnerken son bir boğuk acı çığlığı attı, derin kırmızı içine işleyip maviyi bastırdı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1699
translate tr qst_JudgementDay_RescueMages_Unprep_ae6c5a83:

    # "Pale white, she seemed completely drained of all life as the eyes of her ghastly, skeleton white face rolled up."
    "Bembeyaz, tüm hayattan tamamen boşalmış görünüyordu, korkunç, iskelet beyazı yüzünün gözleri yuvarlandı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1700
translate tr qst_JudgementDay_RescueMages_Unprep_18470e76:

    # "The creature snarled, tosing her now lifeless body aside, letting it slam against one of the walls as we heard the bones break."
    "Yaratık hırladı, onun şimdi cansız bedenini kenara fırlattı, kemiklerin kırıldığını duydukça duvarlardan birine çarpmasına izin verdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1703
translate tr qst_JudgementDay_RescueMages_Unprep_1a712d20:

    # "It licked at it's bloody fangs before lunging towards us!"
    "Bize doğru atılmadan önce kanlı dişlerini yaladı!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1713
translate tr qst_JudgementDay_RescueMages_Unprep_96fa915c:

    # "Slicing my claws across the creature's throat, the snakeman waved back and force, reaching at it's gaping wound where it's throat once was."
    "Pençelerimi yaratığın boğazına geçirirken, yılan adam ileri geri sallandı, bir zamanlar boğazının olduğu açık yarasına uzandı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1714
translate tr qst_JudgementDay_RescueMages_Unprep_1027db08:

    # "After letting out a desperate, raspy cry, it collapsed face first into the water, twitching for a few moments before falling completely still."
    "Umutsuz, boğuk bir çığlık attıktan sonra, yüzüstü suya yığıldı, birkaç dakika seğirdikten sonra tamamen hareketsiz kaldı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1715
translate tr qst_JudgementDay_RescueMages_Unprep_0374e7bc:

    # MC "What in the hells is this thing?"
    MC "Bu şey de ne cehennem?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1716
translate tr qst_JudgementDay_RescueMages_Unprep_4b2c1c99:

    # MC "Some kind of... dark magecraft abomination?"
    MC "Bir tür... kara büyü iğrençliği mi?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1718
translate tr qst_JudgementDay_RescueMages_Unprep_79c627e2:

    # ERIKA "I... I've never seen anything like it before."
    ERIKA "Ben... Daha önce hiç böyle bir şey görmedim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1719
translate tr qst_JudgementDay_RescueMages_Unprep_591afddc:

    # ERIKA "It appears to be... {i}part human?{/i}"
    ERIKA "Görünüşe göre... {i}kısmen insan?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1721
translate tr qst_JudgementDay_RescueMages_Unprep_ec77576a:

    # MARKUS "We should leave this place, whatever this {i}thing{/i} is, the inquisitors and whoever can look at the damn thing when we're done."
    MARKUS "Bu yeri terk etmeliyiz, bu {i}şey{/i} her neyse, engizitörler ve her kimse işimiz bittiğinde lanet şeye bakabilir."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1723
translate tr qst_JudgementDay_RescueMages_Unprep_38177186:

    # "I nodded in agreement as we made our way back up through the mansion estate."
    "Malikane arazisinden yukarı geri dönerken onayla başımı salladım."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1725
translate tr qst_JudgementDay_RescueMages_Unprep_8bfc939c:

    # "I took one last look at the dead bodies littered around... Perhaps..."
    "Etrafa saçılmış ölü bedenlere son bir kez baktım... Belki..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1727
translate tr qst_JudgementDay_RescueMages_Unprep_6725b4fe:

    # "{i}Perhaps if things were different, I could have saved them.{/i}"
    "{i}Belki de şeyler farklı olsaydı, onları kurtarabilirdim.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1729
translate tr qst_JudgementDay_RescueMages_Unprep_bb0c8ed4:

    # ERIKA "[player_name!t], let's go."
    ERIKA "[player_name!t], gidelim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1738
translate tr qst_JudgementDay_RescueMages_MoveOn_e1032b47:

    # "Navigating through the chaotic streets, Erika guided us through a series of alleyways and back routes."
    "Kaotik sokaklarda gezinirken, Erika bizi bir dizi ara sokak ve arka yoldan geçirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1739
translate tr qst_JudgementDay_RescueMages_MoveOn_ff091e7a:

    # "Finally, pushing through to the main street, we hurried toward our destination."
    "Sonunda, ana caddeye iterek, varış noktamıza doğru acele ettik."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1740
translate tr qst_JudgementDay_RescueMages_MoveOn_f2ac90ca:

    # ERIKA "We must move quickly before—"
    ERIKA "Önce hızlıca hareket etmeliyiz—"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1742
translate tr qst_JudgementDay_RescueMages_MoveOn_58420e88:

    # "There, amidst a heap of mangled corpses, sat the gleaming, towering figure of the Silver Knight."
    "Orada, paramparça ceset yığınının ortasında, Gümüş Şövalye'nin parıldayan, yüksek figürü oturdu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1743
translate tr qst_JudgementDay_RescueMages_MoveOn_1df97ea7:

    # "His cape fluttered in the wind as the city burned around him, his presence eerily still in the midst of carnage."
    "Şehir etrafında yanarken pelerini rüzgârda dalgalandı, varlığı katliamın ortasında ürkütücü şekilde durgundu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1744
translate tr qst_JudgementDay_RescueMages_MoveOn_042dbc76:

    # "Despite the splattering of blood across his armor, his silver plating still shined brilliantly through the filth."
    "Zırhına sıçrayan kana rağmen, gümüş kaplaması hala pisliğin içinden parlakça parlıyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1749
translate tr qst_JudgementDay_RescueMages_MoveOn_78e5318e:

    # SILVER_KNIGHT "..."
    SILVER_KNIGHT "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1751
translate tr qst_JudgementDay_RescueMages_MoveOn_e51a3c47:

    # "Slowly, he tilted his head up, locking his piercing gaze onto us."
    "Yavaşça, başını yukarı eğdi, delici bakışını bize kilitledi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1753
translate tr qst_JudgementDay_RescueMages_MoveOn_31385b2d:

    # "His grip on his massive sword tightened as he rose to his feet, advancing in our direction."
    "Muazzam kılıcındaki kavrayışı ayağa kalkarken sıkılaştı, bizim yönümüzde ilerledi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1754
translate tr qst_JudgementDay_RescueMages_MoveOn_a455176a:

    # MARKUS "F-Fuck! It's him! It's the Silver Knight himself!"
    MARKUS "S-Siktir! Bu o! Bu Gümüş Şövalye'nin ta kendisi!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1755
translate tr qst_JudgementDay_RescueMages_MoveOn_0aea49c7:

    # "The Silver Knight... A warrior of legend, chosen to serve and die for the royal family of Alderay."
    "Gümüş Şövalye... Efsanenin bir savaşçısı, Alderay kraliyet ailesine hizmet etmek ve onun için ölmek üzere seçilmiş."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1756
translate tr qst_JudgementDay_RescueMages_MoveOn_3702506d:

    # "Possessing unmatched skill in both blade and magecraft, it was said that he was perhaps the only man who could have challenged Newheart and won."
    "Hem kılıçta hem de büyü sanatlarında eşsiz yetenek sahibi olarak, belki de Newheart'a meydan okuyup kazanabilecek tek adam olduğu söylenirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1757
translate tr qst_JudgementDay_RescueMages_MoveOn_485f73a4:

    # "...And now, he was coming straight for us."
    "...Ve şimdi, doğrudan bize geliyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1758
translate tr qst_JudgementDay_RescueMages_MoveOn_ad3944f0:

    # ERIKA "Hold, Sir Knight! HOLD!"
    ERIKA "Durun, Sör Şövalye! DURUN!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1760
translate tr qst_JudgementDay_RescueMages_MoveOn_7b45065b:

    # "The Silver Knight stopped in his tracks, eyes narrowing as he examined me and Markus."
    "Gümüş Şövalye adımlarını durdurdu, gözleri kısıldı, beni ve Markus'u inceledi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1761
translate tr qst_JudgementDay_RescueMages_MoveOn_5fe8b642:

    # "His posture remained unreadable, but his grip on his weapon remained firm."
    "Duruşu okunaksız kaldı, ama silahındaki kavrayışı sıkı kaldı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1763
translate tr qst_JudgementDay_RescueMages_MoveOn_6ddf1665:

    # SILVER_KNIGHT "…What are they?"
    SILVER_KNIGHT "…Onlar ne?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1764
translate tr qst_JudgementDay_RescueMages_MoveOn_8709d483:

    # ERIKA "As of now, these... creatures are under the order of the Inquisition."
    ERIKA "Şu an itibarıyla, bu... yaratıklar Engizisyonun emri altında."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1765
translate tr qst_JudgementDay_RescueMages_MoveOn_e74bc1de:

    # SILVER_KNIGHT "I do not concern myself with the affairs of the Inquisition."
    SILVER_KNIGHT "Engizisyonun işleriyle ilgilenmem."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1766
translate tr qst_JudgementDay_RescueMages_MoveOn_ff96d9a5:

    # SILVER_KNIGHT "Only that the royal family remains safe."
    SILVER_KNIGHT "Sadece kraliyet ailesinin güvende kalmasıyla."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1767
translate tr qst_JudgementDay_RescueMages_MoveOn_cd3ce366:

    # "Erika gulped, the color draining from her face as she likely questioned whether even all of us combined could stop the Silver Knight."
    "Erika yutkundu, rengi yüzünden çekildi, muhtemelen hepimizin birleşik olarak Gümüş Şövalye'yi durdurup durduramayacağını sorguladı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1768
translate tr qst_JudgementDay_RescueMages_MoveOn_e5d01a38:

    # MC "Princess Cecilia has tasked us with finding her brother, Prince Naran, and returning him to the castle."
    MC "Prenses Cecilia bizi erkek kardeşi Prens Naran'ı bulup onu kaleye geri götürmekle görevlendirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1769
translate tr qst_JudgementDay_RescueMages_MoveOn_15b97946:

    # "The Silver Knight studied me carefully before turning his gaze to Erika."
    "Gümüş Şövalye dikkatle beni inceledi, sonra bakışını Erika'ya çevirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1770
translate tr qst_JudgementDay_RescueMages_MoveOn_f04727a6:

    # SILVER_KNIGHT "Princess Cecilia should be in the castle."
    SILVER_KNIGHT "Prenses Cecilia kalede olmalı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1771
translate tr qst_JudgementDay_RescueMages_MoveOn_2be6c7a0:

    # SILVER_KNIGHT "How did this creature approach her?"
    SILVER_KNIGHT "Bu yaratık ona nasıl yaklaştı?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1772
translate tr qst_JudgementDay_RescueMages_MoveOn_bb21353a:

    # MARKUS "We saved her damn life!"
    MARKUS "Onun lanet hayatını kurtardık!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1773
translate tr qst_JudgementDay_RescueMages_MoveOn_c4aef209:

    # "In an instant, the Silver Knight's blade was pointed directly at Markus' throat."
    "Bir anda, Gümüş Şövalye'nin kılıcı doğrudan Markus'un boğazına doğrultuldu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1775
translate tr qst_JudgementDay_RescueMages_MoveOn_a64caac8:

    # SILVER_KNIGHT "Her 'damn life' is worth far more than yours, creature."
    SILVER_KNIGHT "Onun 'lanet hayatı' seninkinden çok daha değerli, yaratık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1776
translate tr qst_JudgementDay_RescueMages_MoveOn_0a0e5149:

    # SILVER_KNIGHT "Remember that when you speak of her."
    SILVER_KNIGHT "Onun hakkında konuşurken bunu hatırla."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1777
translate tr qst_JudgementDay_RescueMages_MoveOn_c3c73447:

    # "I stepped between Markus and the blade."
    "Markus ile kılıç arasına adım attım."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1778
translate tr qst_JudgementDay_RescueMages_MoveOn_aa0c27d2:

    # MC "Princess Cecilia attempted to sneak out in search of her brother."
    MC "Prenses Cecilia erkek kardeşini aramak için gizlice çıkmaya çalıştı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1779
translate tr qst_JudgementDay_RescueMages_MoveOn_4bbbaae0:

    # MC "She was ambushed by Demorai, but we saved her."
    MC "Demorai tarafından pusuya düşürüldü, ama biz onu kurtardık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1780
translate tr qst_JudgementDay_RescueMages_MoveOn_221b8639:

    # "The Silver Knight paused, seemingly weighing my words."
    "Gümüş Şövalye duraksadı, sözlerimi tartıyor gibi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1781
translate tr qst_JudgementDay_RescueMages_MoveOn_32de8b7a:

    # SILVER_KNIGHT "…If what you say is true."
    SILVER_KNIGHT "…Söylediğin doğruysa."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1783
translate tr qst_JudgementDay_RescueMages_MoveOn_517e555a:

    # "He withdrew his blade, bringing his gauntleted hand over his chest in a tight salute."
    "Kılıcını geri çekti, eldivenli elini sıkı bir selamla göğsüne getirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1784
translate tr qst_JudgementDay_RescueMages_MoveOn_4eeeca06:

    # SILVER_KNIGHT "I owe you my thanks."
    SILVER_KNIGHT "Sana teşekkür borçluyum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1787
translate tr qst_JudgementDay_RescueMages_MoveOn_d03a2c08:

    # MYU "Myu helped too!"
    MYU "Myu da yardım etti!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1789
translate tr qst_JudgementDay_RescueMages_MoveOn_408a648a:

    # MYU "As did Elena!"
    MYU "Elena da!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1790
translate tr qst_JudgementDay_RescueMages_MoveOn_9ce74b32:

    # "Elena averted her gaze nervously."
    "Elena bakışlarını sinirli bir şekilde kaçırdı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1791
translate tr qst_JudgementDay_RescueMages_MoveOn_eb378171:

    # ELENA "H-Hello…"
    ELENA "M-Merhaba…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1792
translate tr qst_JudgementDay_RescueMages_MoveOn_538e24d3:

    # SILVER_KNIGHT "…Then you also have my thanks."
    SILVER_KNIGHT "…O zaman sana da teşekkürler."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1794
translate tr qst_JudgementDay_RescueMages_MoveOn_6186d54d:

    # ERIKA "We're heading up the wall. Is the prince safe?"
    ERIKA "Duvara çıkıyoruz. Prens güvende mi?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1795
translate tr qst_JudgementDay_RescueMages_MoveOn_c6f5af92:

    # "The knight nodded slightly."
    "Şövalye hafifçe başını salladı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1796
translate tr qst_JudgementDay_RescueMages_MoveOn_d71c3886:

    # SILVER_KNIGHT "He is safe now, my prince."
    SILVER_KNIGHT "O şimdi güvende, prensim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1797
translate tr qst_JudgementDay_RescueMages_MoveOn_aeb7f7dd:

    # "From behind a narrow alley, a short, timid figure emerged."
    "Dar bir ara sokaktan, kısa boylu, ürkek bir figür belirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1799
translate tr qst_JudgementDay_RescueMages_MoveOn_0adbee41:

    # "His features were delicate, almost effeminate."
    "Yüz hatları narindi, neredeyse kadınsı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1800
translate tr qst_JudgementDay_RescueMages_MoveOn_70af855b:

    # "His wide, uncertain eyes flickered between me and my companions."
    "Geniş, belirsiz gözleri ben ve yoldaşlarım arasında gidip geldi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1801
translate tr qst_JudgementDay_RescueMages_MoveOn_efd77777:

    # SILVER_KNIGHT "They are not a threat, my lord."
    SILVER_KNIGHT "Onlar bir tehdit değil, lordum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1802
translate tr qst_JudgementDay_RescueMages_MoveOn_a4943c53:

    # "The young prince hesitated, his voice soft and uncertain."
    "Genç prens tereddüt etti, sesi yumuşak ve belirsizdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1803
translate tr qst_JudgementDay_RescueMages_MoveOn_60479631:

    # PRINCE_NARAN "Volsta… W-What manner of creatures are these?"
    PRINCE_NARAN "Volsta… B-Bunlar ne tür yaratıklar?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1804
translate tr qst_JudgementDay_RescueMages_MoveOn_6a63e30d:

    # SILVER_KNIGHT "I do not know, my prince."
    SILVER_KNIGHT "Bilmiyorum, prensim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1805
translate tr qst_JudgementDay_RescueMages_MoveOn_cfc016bf:

    # SILVER_KNIGHT "But we must return you to the castle at once."
    SILVER_KNIGHT "Ama sizi hemen kaleye geri götürmeliyiz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1806
translate tr qst_JudgementDay_RescueMages_MoveOn_557191f0:

    # PRINCE_NARAN "But… those monsters are still everywhere!"
    PRINCE_NARAN "Ama… o canavarlar hala her yerde!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1807
translate tr qst_JudgementDay_RescueMages_MoveOn_d0d11aac:

    # "The prince clung tightly to the Silver Knight, trembling."
    "Prens Gümüş Şövalye'ye sımsıkı yapıştı, titriyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1808
translate tr qst_JudgementDay_RescueMages_MoveOn_f110ccdb:

    # SILVER_KNIGHT "I will keep you safe, Naran."
    SILVER_KNIGHT "Seni güvende tutacağım, Naran."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1810
translate tr qst_JudgementDay_RescueMages_MoveOn_5346539a:

    # SILVER_KNIGHT "But we must move now."
    SILVER_KNIGHT "Ama şimdi hareket etmeliyiz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1812
translate tr qst_JudgementDay_RescueMages_MoveOn_b772a928:

    # "Above us, a deafening explosion rocked the sky as a section of the wall burst into flames."
    "Üzerimizde, sağır edici bir patlama gökyüzünü salladı, duvarın bir bölümü alev aldı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1813
translate tr qst_JudgementDay_RescueMages_MoveOn_1b696125:

    # ERIKA "We need to hurry, quickly!"
    ERIKA "Acele etmeliyiz, çabuk!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1818
translate tr qst_JudgementDay_RescueMages_MoveOn_71348209:

    # "Suddenly, from the surrounding buildings and alleyways, a chorus of unnatural growls echoed."
    "Aniden, çevredeki binalardan ve ara sokaklardan, doğa dışı hırlamalar korosu yankılandı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1819
translate tr qst_JudgementDay_RescueMages_MoveOn_010ca37a:

    # "More of those monstrous ghouls began to emerge, shambling toward us from every direction."
    "O canavar gulyabanilerden daha fazlası belirmeye başladı, her yönden bize doğru sendeleyerek."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1820
translate tr qst_JudgementDay_RescueMages_MoveOn_29b99d09:

    # PRINCE_NARAN "J-Jaras!"
    PRINCE_NARAN "J-Jaras!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1821
translate tr qst_JudgementDay_RescueMages_MoveOn_9a9ed357:

    # "The prince recoiled, hiding behind the Silver Knight as he slowly unsheathed his blade."
    "Prens geri çekildi, Gümüş Şövalye yavaşça kılıcını kınından çıkarırken arkasına saklandı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1822
translate tr qst_JudgementDay_RescueMages_MoveOn_990d309c:

    # SILVER_KNIGHT "Stay behind me, my prince."
    SILVER_KNIGHT "Arkamda kalın, prensim."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1823
translate tr qst_JudgementDay_RescueMages_MoveOn_1047baf5:

    # "The knight briefly glanced toward us."
    "Şövalye kısaca bize baktı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1824
translate tr qst_JudgementDay_RescueMages_MoveOn_d64ff1da:

    # SILVER_KNIGHT "Go. Secure the wall."
    SILVER_KNIGHT "Git. Duvarı güvenceye al."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1825
translate tr qst_JudgementDay_RescueMages_MoveOn_576c8cba:

    # SILVER_KNIGHT "{i}I will handle the monsters…{/i}"
    SILVER_KNIGHT "{i}Ben canavarlarla ilgileneceğim…{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1831
translate tr qst_JudgementDay_GotToTheWall_3fcc22a5:

    # "We didn't waste a second, sprinting toward the large wooden lift."
    "Bir saniye bile kaybetmeden, büyük ahşap asansöre doğru koştuk."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1832
translate tr qst_JudgementDay_GotToTheWall_6073686b:

    # ERIKA "This should take us straight to the top."
    ERIKA "Bu bizi doğrudan tepeye çıkarmalı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1834
translate tr qst_JudgementDay_GotToTheWall_9dbc9a64:

    # MARKUS "We'll be completely exposed up there!"
    MARKUS "Yukarıda tamamen açıkta olacağız!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1835
translate tr qst_JudgementDay_GotToTheWall_27615f39:

    # MARKUS "Does it even still work?"
    MARKUS "Hala çalışıyor mu?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1836
translate tr qst_JudgementDay_GotToTheWall_aa491b95:

    # ERIKA "We don't have time to take the stairs! We're going up now!"
    ERIKA "Merdivenleri çıkacak zamanımız yok! Şimdi yukarı çıkıyoruz!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1837
translate tr qst_JudgementDay_GotToTheWall_0897d6bb:

    # "With a sharp pull of the lever, the mechanical gears below groaned as the wooden lift jolted to life, carrying us upward."
    "Kilit kolunun keskin bir çekişiyle, aşağıdaki mekanik dişliler inledi, ahşap asansör hayata sarsıldı, bizi yukarı taşıdı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1838
translate tr qst_JudgementDay_GotToTheWall_16d33ca3:

    # "As we ascended, the devastation of the city became clearer."
    "Yükselirken, şehrin yıkımı daha net hale geldi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1839
translate tr qst_JudgementDay_GotToTheWall_bacb7b9b:

    # "The once-proud walls of Novaras were engulfed in fire and smoke."
