# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3723
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_390ecba2:

    # PHOAH @ talk "We're real."
    PHOAH @ talk "Biz gerçeğiz."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3724
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_6ddce6b3:

    # MC "You... You can hear my thoughts?"
    MC "Sen... Düşüncelerimi duyabiliyor musun?"

