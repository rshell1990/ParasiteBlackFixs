    MAD_PROPHET "BÜYÜK NEWHEART'IN YENİDEN DOĞMUŞ HALİNİN BİZE KENDİSİNİ BURADA TOPLANDIĞIMIZDA GÖSTERECEĞİNİ SÖZ VERDİ!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:133
translate tr qst_JudgementDay_SiegeStart_be7909d4:

