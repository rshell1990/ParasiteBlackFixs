translate tr qst_JudgementDay_SiegeStart_437e7875:

    # MAD_PROPHET "YOU HAVE ALL BEEN GATHERED HERE FOR A REASON!"
    MAD_PROPHET "HEPSİNİZİN BURADA TOPLANMASININ BİR NEDENİ VAR!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:131
translate tr qst_JudgementDay_SiegeStart_1e81b318:

    # MAD_PROPHET "SEVERAL MOONS AGO, A PALE GOD CAME TO VISIT ME IN THE FLESH WITH HIS DISCIPLES!"
    MAD_PROPHET "BİRKAÇ AY ÖNCE, SOLGUN BİR TANRI MÜRİTLERİYLE BEDENEN BENİ ZİYARETE GELDİ!"

