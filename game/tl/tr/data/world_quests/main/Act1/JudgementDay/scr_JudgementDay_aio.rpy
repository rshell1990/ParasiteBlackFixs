    HIRRAH "Bu yer gerçek değil, daha ziyade, sizinle konuşmak için yarattığımız bir sinirsel bağ projeksiyonu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3726
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_8749ecba:

    # MC "...{i}A what?{/i}"
    MC "...{i}Bir ne?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3727
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_601508d9:

    # HIRRAH "... I-"
    HIRRAH "... Ben-"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3728
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_826861e5:

    # HIRRAH "It matters not."
    HIRRAH "Fark etmez."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3729
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_fda2299b:

    # PHOAH @ angry "Look, human, we need your help."
    PHOAH @ angry "Bak, insan, yardımına ihtiyacımız var."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3730
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_a6825e69:

    # MC "{i}Me?{/i}"
    MC "{i}Benim mi?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3731
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_36f9cc51:

    # PHOAH @ talk "Listen carefully, human."
    PHOAH @ talk "Dikkatlice dinle, insan."

