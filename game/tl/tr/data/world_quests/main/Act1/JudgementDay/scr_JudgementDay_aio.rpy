# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2247
translate tr qst_JudgementDay_SiegeOverPrison_alcott_menu_6ea9380f:

    # ALCOTT @ talk "Tell me everything that happened."
