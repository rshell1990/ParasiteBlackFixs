translate tr strings:

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:636
    old "The blacksmith's daughter"
    new "Demircinin kızı"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1001
    old "Your party has been healed!"
    new "Partin iyileştirildi!"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1450
    old "I won't abandon the mages."
    new "Büyücüleri terk etmeyeceğim."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1456
    old "You're right, let's keep moving..."
    new "Haklısın, hareket etmeye devam edelim..."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1508
    old "Noble manor"
    new "Asil malikanesi"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2112
    old "Prison cell"
    new "Hapishane hücresi"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2180
    old "Is Erika alright? Markus? The others?"
    new "Erika iyi mi? Markus? Diğerleri?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2185
    old "I... can't remember what happened after I fell unconscious."
    new "Ben... bilincimi kaybettikten sonra ne olduğunu hatırlayamıyorum."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2193
    old "What do you want from me?"
    new "Benden ne istiyorsun?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2203
    old "I am a man at heart."
    new "Özümde bir adamım."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2205
    old "I'm a monster... but I'm not your enemy."
    new "Bir canavarım... ama düşmanınız değilim."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2207
    old "I'm whatever you pay me to be."
    new "Ne ödersen osun."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2532
    old "Courtroom"
    new "Mahkeme salonu"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2548
    old "I'm charged with treason and consorting with dark mages."
    new "Vatana ihanet ve kara büyücülerle iş birliğiyle suçlanıyorum."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2550
    old "These charges are outrageous! I'm an innocent man!"
    new "Bu suçlamalar rezalet! Ben masum bir adamım!"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2552
    old "I'm charged with the crime of having a bigger cock than you all."
    new "Hepinizden daha büyük bir aleme sahip olma suçuyla suçlanıyorum."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2599
    old "That is outrageous!"
    new "Bu rezalet!"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2602
    old "My friend... Can't someone tend to his wounds while I give testimony?"
    new "Arkadaşım... Ben ifade verirken biri onun yaralarına bakamaz mı?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2606
    old "I will do as you ask, Judge Falwind."
    new "Dediğinizi yapacağım, Yargıç Falwind."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2653
    old "...My name is not nine-six-one. I am [player_name!t]! And my friends and I saved this city! We are innocent men, wrongly accused!"
    new "...Benim adım dokuz-altı-bir değil. Ben [player_name!t]! Ve arkadaşlarım ve ben bu şehri kurtardık! Biz masum adamlarız, yanlışça suçlanmış!"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2661
    old "Your honor, I will prove our innocence and expose these falsehoods. We are innocent."
    new "Sayın yargıç, masumiyetimizi kanıtlayıp bu yalanları ifşa edeceğim. Biz masumuz."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2665
    old "You bastards owe us your lives! Without us, NONE OF YOU WOULD BE HERE!"
    new "Siz piçler bize hayatlarınızı borçlusunuz! Biz olmasaydık, HİÇBİRİNİZ BURADA OLMAZDINIZ!"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2720
    old "Captain Nyx... Could you tell us more about the state of the city guard?"
    new "Kaptan Nyx... Bize şehir muhafızlarının durumu hakkında daha fazla bilgi verebilir misiniz?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2746
    old "Captain Nyx, I am accused of being a Demorai spy... during the siege, whose side did I fight with?"
    new "Kaptan Nyx, Demorai casusu olmakla suçlanıyorum... kuşatma sırasında, hangi tarafta savaştım?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2753
    old "No further questions, your honor."
    new "Başka soru yok, sayın yargıç."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2808
    old "How is it fair that your research is withheld from this trial?"
    new "Araştırmanızın bu davadan saklanması nasıl adil?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2818
    old "How can we be sure she hasn't been corrupted?"
    new "Onun yozlaşmadığından nasıl emin olabiliriz?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2823
    old "I shall move on, your honor."
    new "Devam edeceğim, sayın yargıç."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2826
    old "Lady Jadeway… did you not already examine me and Markus for signs of dark magecraft?"
    new "Leydi Jadeway… beni ve Markus'u kara büyü işaretleri için zaten incelemediniz mi?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2834
    old "Have you ever personally encountered such a high level of dark magecraft before?"
    new "Daha önce böyle yüksek seviyede bir kara büyüyle kişisel olarak karşılaştınız mı?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2839
    old "But I possess no magecraft {i}at all.{/i}"
    new "Ama {i}hiç{/i} büyü sanatına sahip değilim."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2899
    old "We fought hard and pushed him back."
    new "Sertçe savaştık ve onu geri ittik."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2906
    old "Actually... We lost."
    new "Aslında... Kaybettik."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2920
    old "I had no idea she was a dark mage!"
    new "Onun bir kara büyücü olduğu hakkında hiçbir fikrim yoktu!"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2926
    old "Neither did your own inquisitor!"
    new "Kendi engizitörünüzün de yoktu!"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2934
    old "She hid it from me!"
    new "Benden sakladı!"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2938
    old "I refuse to answer."
    new "Cevap vermeyi reddediyorum."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2949
    old "That proves nothing."
    new "Bu hiçbir şeyi kanıtlamaz."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2951
    old "What about the rest of my squad? Are they on trial, too?"
    new "Ya mangamın geri kalanı? Onlar da mı yargılanıyor?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2975
    old "Summon Sister Divine"
    new "Rahibe Divine'i çağır"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3042
    old "Summon Lady Sophira Marginott"
    new "Leydi Sophira Marginott'u çağır"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3079
    old "Summon Adara"
    new "Adara'yı çağır"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3095
    old "Summon Nijah"
    new "Nijah'ı çağır"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3106
    old "I have no further witnesses to call"
    new "Çağıracak başka tanığım yok"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3192
    old "Bow."
    new "Eğil."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3195
    old "Don't bow."
    new "Eğilme."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3247
    old "{size=150}ACT 2{/size}"
    new "{size=150}2. PERDE{/size}"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3365
    old "How exactly did you survive?"
    new "Tam olarak nasıl hayatta kaldın?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3372
    old "Where have you been this whole time?"
    new "Bunca zamandır neredeydin?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3379
    old "Who is this mistress you speak of?"
    new "Bahsettiğin bu hanım kim?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3390
    old "Why did you - I mean, your mistress warn us about the attack?"
    new "Sen - yani, hanımın neden bizi saldırı hakkında uyardı?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3396
    old "Why Hamun?"
    new "Neden Hamun?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3548
    old "Is there really no laws in the free city?"
    new "Özgür şehirde gerçekten hiç kanun yok mu?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3553
    old "Who are the merchant lords who run this place?"
    new "Burayı işleten tüccar lordları kim?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3560
    old "Got any advice for me around the city?"
    new "Şehir etrafında bana tavsiyen var mı?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3565
    old "Thanks for the advice..."
    new "Tavsiye için teşekkürler..."

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3756
    old "Who... {i}What{/i} is Malakai?"
    new "Kim... {i}Ne{/i} Malakai?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3772
    old "Where are the gods? Why do they not answer our prayers to help with this damned war?"
    new "Tanrılar nerede? Neden bu lanetli savaşta yardım için dualarımıza cevap vermiyorlar?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3786
    old "Tzenvachian... Or whatever you call him, what happened to him?"
    new "Tzenvachian... Ya da ona her ne diyorsan, ona ne oldu?"

    # game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3801
    old "Do all of the gods look so... {i}different?{/i}"
    new "Tüm tanrılar bu kadar... {i}farklı{/i} mı görünüyor?"

