translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_c0534bbf:

    # PHOAH @ talk "This world... It has become the focus of the great deciever's dark plan."
    PHOAH @ talk "Bu dünya... Büyük aldatıcının karanlık planının odağı haline geldi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3733
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_eabc2515:

    # MC "{i}... The great deciever?{/i}"
    MC "{i}... Büyük aldatıcı mı?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3734
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_de037a92:

    # "The goddess' hands tightened into tight fists."
    "Tanrıçanın elleri sıkı yumruklara sıkılaştı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3735
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_9fb2387c:

    # PHOAH @ angry "The lord of lies..."
    PHOAH @ angry "Yalanların lordu..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3736
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_024f2b0d:

    # PHOAH @ angry "{b}Malakai.{/b}"
    PHOAH @ angry "{b}Malakai.{/b}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3737
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_013508b0:

    # PHOAH @ angry "The one who bought ruin upon both the old gods and the new with his treacherous war."
    PHOAH @ angry "Hain savaşıyla hem eski tanrılara hem de yenilere yıkım getiren."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3738
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_89848511:

    # PHOAH @ angry "No doubt he yearns to take a physical form once more."
    PHOAH @ angry "Şüphesiz bir kez daha fiziksel bir form almayı arzuluyor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3739
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_75a790db:

    # MC "I... I don't understand."
    MC "Ben... Anlamıyorum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3740
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_a323a245:

    # MC "Malakai? {i}The{/i} Malakai?"
    MC "Malakai? {i}O mu{/i} Malakai?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3741
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_3126cf19:

    # "The dark god himself... Every child in Alderay knew the story of Malakai."
    "Kara tanrının kendisi... Alderay'daki her çocuk Malakai'nin hikayesini bilirdi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3742
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_5c7fea02:

    # "Legend speak of how his betrayal destroyed the old and new gods in the greatest war to ever be fought."
    "Efsane ihanetinin şimdiye kadar yapılmış en büyük savaşta eski ve yeni tanrıları nasıl yok ettiğini anlatır."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3743
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_5e1d502e:

    # MC "This is... This cannot be..."
    MC "Bu... Bu olamaz..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3744
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_61b39614:

    # MC "He... {i}He's real?{/i}"
    MC "O... {i}O gerçek mi?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3745
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_c2ee7902:

    # HIRRAH "His flesh may be gone, but his spirit survives... Trapped beyond the gate of midnight."
    HIRRAH "Eti gitmiş olabilir, ama ruhu hayatta kalır... Gece yarısı kapısının ötesinde hapsedilmiş."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3746
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_b514f426:

    # HIRRAH "{i}Imprisoned with Arda.{/i}"
    HIRRAH "{i}Arda ile hapsedilmiş.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3747
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_50736f37:

    # PHOAH @ talk "Zanarak, his chosen champion has arrived to serve some purpose we do not fully understand."
    PHOAH @ talk "Zanarak, seçilmiş şampiyonu, tam olarak anlamadığımız bir amaca hizmet etmek için geldi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3748
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_2419d9f9:

    # PHOAH @ talk "And if that wasn't enough proof, {i}she{/i} is here."
    PHOAH @ talk "Ve eğer bu yeterli kanıt değilse, {i}o{/i} burada."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3749
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_e6bffe1a:

    # PHOAH @ talk "Malakai's right hand, the chaos goddess, Gimera has taken form once more and walks this place."
    PHOAH @ talk "Malakai'nin sağ kolu, kaos tanrıçası Gimera bir kez daha form aldı ve bu yerde yürüyor."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3750
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_0bf94686:

    # HIRRAH "Human... You must help us."
    HIRRAH "İnsan... Bize yardım etmelisin."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3751
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_a7e0d8f5:

    # HIRRAH "Serve as our champion."
    HIRRAH "Bizim şampiyonumuz olarak hizmet et."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3752
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_4f4136b8:

    # HIRRAH "While we find and stop Gimera, we must work together!"
    HIRRAH "Gimera'yı bulup durdururken, birlikte çalışmalıyız!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3753
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_e91157ba:

    # HIRRAH "No matter the cost..."
    HIRRAH "Ne pahasına olursa olsun..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3754
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_644eb481:

    # HIRRAH "{i}Malakai can never be allowed to walk the physical planes once more.{/i}"
    HIRRAH "{i}Malakai'nin bir kez daha fiziksel düzlemlerde yürümesine asla izin verilemez.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3757
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_8e7bf52d:

    # PHOAH @ talk "Malakai destroyed everything we had built."
    PHOAH @ talk "Malakai inşa ettiğimiz her şeyi yok etti."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3758
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2b4ac252:

    # PHOAH @ talk "All our hopes and dreams, everything Arda spent countless millenia working to achieve."
    PHOAH @ talk "Tüm umutlarımız ve hayallerimiz, Arda'nın başarmak için sayısız binyıl harcadığı her şey."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3759
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2c206515:

    # PHOAH @ talk "{i}The gateways to unite the realms, the unity of the old gods and new...{/i}"
    PHOAH @ talk "{i}Diyarları birleştirmek için kapılar, eski tanrıların ve yenilerin birliği...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3760
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_0eb52d5f:

    # PHOAH @ talk "All of it was undone by Malakai in his quest to re-forge reality in his image."
    PHOAH @ talk "Hepsi Malakai tarafından gerçekliği kendi imgesinde yeniden dövme arayışında geri alındı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3761
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_782b7b35:

    # "Phoah paused for a moment, the rage slightly softening as she seemed to be thinking back to those dark days."
    "Phoah bir an duraksadı, o karanlık günleri düşünüyor gibi, öfke hafifçe yumuşadı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3762
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2e97c5dc:

    # PHOAH @ sad "{i}... It wasn't always so though.{/i}"
    PHOAH @ sad "{i}... Yine de her zaman böyle değildi.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3763
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2dc1e7da:

    # PHOAH @ sad "Before that monster, Gimera decieved him into opening the {i}Macarum,{/i} Malakai went by a different name."
    PHOAH @ sad "O canavar Gimera, onu {i}Macarum'u{/i} açmaya kandırmadan önce, Malakai farklı bir isimle anılırdı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3764
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_b127e26a:

    # PHOAH @ sad "Malayan the curious."
    PHOAH @ sad "Meraklı Malayan."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3765
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2a09741c:

    # MC "The Macarum?"
    MC "Macarum mu?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3766
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_cbdac6af:

    # PHOAH @ talk "{i}When Arda was born, he was a made a being of pure good, pure love.{/i}"
    PHOAH @ talk "{i}Arda doğduğunda, saf iyilik, saf sevginin bir varlığı yapıldı.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3767
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_f3b5dcfb:

    # PHOAH @ talk "... But in order to become that, he cast off his darkness... sealed it away into a forbidden box beyond the knowledge and reach of even the gods."
    PHOAH @ talk "... Ama bu olabilmek için, karanlığını attı... onu tanrıların bile bilgisinin ve erişiminin ötesinde yasaklı bir kutuya mühürledi."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3768
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_062aedaa:

    # PHOAH @ angry "Guided by terrible visions of an impending war between the old gods and the new, Gimera decieved Malayan that only the power of the box could prevent the war."
    PHOAH @ angry "Eski tanrılar ve yeniler arasında yaklaşan bir savaşın korkunç vizyonlarıyla yönlendirilen Gimera, Malayan'ı yalnızca kutunun gücünün savaşı önleyebileceğine kandırdı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3769
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_c432b0f4:

    # PHOAH @ sad "Little did Malayan know by opening it, the visions he fought to stop would come true."
    PHOAH @ sad "Malayan onu açarak durdurmak için savaştığı vizyonların gerçekleşeceğini bilmiyordu."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3773
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_36b03c3f:

    # "Hirrah let out a sharp chuckle."
    "Hirrah keskin bir kıkırdama çıkardı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3774
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_cd066754:

    # HIRRAH "And who is supposed to answer?"
    HIRRAH "Ve kimin cevap vermesi gerekiyor?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3775
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_5abe17b2:

    # PHOAH @ angry "Hirrah!"
    PHOAH @ angry "Hirrah!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3776
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_418142c0:

    # HIRRAH "Do not coddle the human... Letting him put his faith in what can never answer will lead him down a path of destruction."
    HIRRAH "İnsanı şımartma... İnancını asla cevap veremeyecek olana koymasına izin vermek onu bir yıkım yoluna sürükler."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3777
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7208330b:

    # MC "{i}The... The gods no longer heard us?{/i}"
    MC "{i}... Tanrılar artık bizi duymuyor muydu?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3778
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_88785898:

    # PHOAH @ talk "After the war, so few of us remain, even now."
    PHOAH @ talk "Savaştan sonra, şimdi bile, çok azımız kaldık."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3779
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_ac5cf9c8:

    # PHOAH @ sad "So many died... Yhoshan... Taruna... Palam."
    PHOAH @ sad "Birçoğu öldü... Yhoshan... Taruna... Palam."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3780
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_59eb52b3:

    # HIRRAH "Once, during Arda's reign, thousands of us roamed the stars."
    HIRRAH "Bir zamanlar, Arda'nın hükümdarlığı sırasında, binlercemiz yıldızlarda dolaştı."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3781
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_91cef8f1:

    # HIRRAH "Now, perhaps only a few hundred remain... {i}if that.{/i}"
    HIRRAH "Şimdi, belki sadece birkaç yüz tane kaldı... {i}eğer o kadarsa.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3782
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_7cc2b286:

    # MC "... So, we truly stand alone then?"
    MC "... Öyleyse, gerçekten yalnız mıyız?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3783
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_9cadd45f:

    # PHOAH @ talk "{i}The gods won't answer your prayers, because the gods can't even save themselves right now.{/i}"
    PHOAH @ talk "{i}Tanrılar dualarınıza cevap vermeyecek, çünkü tanrılar şu anda kendilerini bile kurtaramaz.{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3787
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_2b832d9a:

    # PHOAH @ talk "Surely you know the stories?"
    PHOAH @ talk "Elbette hikayeleri biliyorsundur?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3788
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_492b8793:

    # PHOAH @ talk "Has it truly been that long that truth has become some kind of warped myth?"
    PHOAH @ talk "Gerçekten gerçeğin bir tür çarpıtılmış efsane haline gelmesi bu kadar uzun mu sürdü?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3789
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_59d51f4b:

    # MC "I know he waged war against Tzenvachian and the new gods."
    MC "Tzenvachian'a ve yeni tanrılara karşı savaş açtığını biliyorum."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3790
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_5370bf83:

    # "The two goddess' shared a strange look with each other."
    "İki tanrıça birbirleriyle garip bir bakış paylaştılar."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3791
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_76aa7f84:

    # PHOAH @ talk "Tzenvachian...?"
    PHOAH @ talk "Tzenvachian...?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3792
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_00d0e69d:

    # PHOAH @ talk "Hmm... Arda took many names, I wonder where that one came from?"
    PHOAH @ talk "Hmm... Arda birçok isim aldı, merak ediyorum o nereden geldi?"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3793
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_1dcbee42:

    # MC "His name was {i}Arda?{/i}"
    MC "Adı {i}Arda mıydı?{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3794
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_eec23752:

    # PHOAH @ talk "That is how {i}we{/i} knew him long ago..."
    PHOAH @ talk "Onu {i}uzun zaman önce{/i} böyle tanırdık..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3795
translate tr qst_JudgementDay_PostQuestArrivedToHamun_Dream_Menu_fc689b9a:

    # PHOAH @ sad "So very... very, long ago."
