translate tr qst_JudgementDay_SiegeOverPrison_alcott_menu_5ee94fb5:

    # MC @ angry "That's absurd! I fought against them! I saved {i}hundreds!{/i}"
    MC @ angry "Bu absürt! Onlara karşı savaştım! {i}Yüzlercesini{/i} kurtardım!"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2294
translate tr qst_JudgementDay_SiegeOverPrison_alcott_menu_346ecd1f:

    # ALCOTT @ talk "It does not matter."
    ALCOTT @ talk "Fark etmez."

