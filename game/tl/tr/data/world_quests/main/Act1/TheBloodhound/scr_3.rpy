# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:103
translate tr qst_bloodhound_3_toBasement_69649a42:

    # "A nightmare awaited me."
    "Beni bir kâbus bekliyordu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:110
translate tr qst_bloodhound_3_toBasement_6706efee:

    # "The man I presumed to be Azul hung upside down, his lower jaw broken and hang by the thinnest thread of flesh."
    "Azul olduğunu tahmin ettiğim adam baş aşağı asılıydı, alt çenesi kırılmış ve en ince et ipliğinden sallanıyordu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:111
translate tr qst_bloodhound_3_toBasement_8f6c41e0:

    # "His eyes were torn out leaving red trails of blood decorating his horrified, pale face."
    "Gözleri koparılmış, dehşete düşmüş, solgun yüzünü süsleyen kırmızı kan izleri bırakmıştı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:112
translate tr qst_bloodhound_3_toBasement_0d45b3d7:

    # "His body desecrated, long hooks dug into the flesh pulling back sheets of flesh as a pool of blood circled his body beneath."
    "Bedenine saygısızlık edilmiş, uzun kancalar ete kazınmış, et tabakalarını geri çekmiş, altında bir kan gölü bedenini daire içine almıştı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:113
translate tr qst_bloodhound_3_toBasement_661276f1:

    # "In his exposed ribcage, a crude cage was formed with sharp metal shards, inside a black crow cried as it pecked at his insides angrily."
    "Açıkta kalan göğüs kafesinde, keskin metal parçalarla kaba bir kafes oluşturulmuştu, içinde siyah bir karga iç organlarını öfkeyle gagalarken ağlıyordu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:114
translate tr qst_bloodhound_3_toBasement_810f6de6:

    # MC @ talk "{i}...Gods.{/i}"
    MC @ talk "{i}...Tanrılar.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:115
translate tr qst_bloodhound_3_toBasement_3f254257:

    # "The repugnant smell of rotting flesh began to make me nearly hurl as a dozen flies circled around the pale flesh."
    "Çürüyen etin iğrenç kokusu, bir düzine sinek solgun etin etrafında dönerken neredeyse kusmama neden oldu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:116
translate tr qst_bloodhound_3_toBasement_c3c642d0:

    # "Behind me, I heard the sounds of some mechanism ticking..."
    "Arkamda, bir mekanizmanın tıklama seslerini duydum..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:119
translate tr qst_bloodhound_3_toBasement_19ed433f:

    # "Sensing danger, I turned."
    "Tehlikeyi hissederek, döndüm."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:123
translate tr qst_bloodhound_3_toBasement_c0466f52:

    # "A man in black stood before me, his face not visible behind the mask and strange goggles, unnerving ticking sound coming from inside his chest."
    "Siyahtaki bir adam önümde durdu, yüzü maske ve garip gözlüklerin ardında görünmüyor, göğsünün içinden ürkütücü tıklama sesi geliyordu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:124
translate tr qst_bloodhound_3_toBasement_988c5159:

    # "The thing moved jankily, making strange sounds as it curiously turned its head to look at me before drawing out the long blades from its arms."
    "Şey sarsıntılı hareket etti, garip sesler çıkardı, kollarından uzun bıçakları çekmeden önce merakla kafasını bana bakmak için çevirdi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:125
translate tr qst_bloodhound_3_toBasement_4277bc35:

    # MC @ angry "I take it talking is out of the question?"
    MC @ angry "Konuşmak söz konusu değil sanırım?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:126
translate tr qst_bloodhound_3_toBasement_c8cb10b4:

    # "The thing stepped forward, its hand shaking slightly."
    "Şey öne adım attı, eli hafifçe titredi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:131
translate tr qst_bloodhound_3_toBasement_9a8e3593:

    # MC @ angry "Fuck!"
    MC @ angry "Siktir!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:139
translate tr qst_bloodhound_3_toBasement_3ff24643:

    # "Once again, I quickly tore from my flesh just as the thing was about to strike, barely blocking it in time with my own claws and managing to push it back."
    "Bir kez daha, şey tam vuracakken hızla etimden koptum, kendi pençelerimle zamanında zar zor bloklayıp onu geri itmeyi başardım."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:141
translate tr qst_bloodhound_3_toBasement_ee112fff:

    # MC "No choice now!"
    MC "Artık seçenek yok!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:156
translate tr qst_bloodhound_3_toBasement_c0b25ad9:

    # "Dodging left and right, the man in black moved quicker than I anticipated, dodging most of my strikes and managing to land hit after hit against me."
    "Sağa sola kaçarak, siyahtaki adam beklediğimden daha hızlı hareket etti, vuruşlarımın çoğundan kaçtı ve bana vuruş üzerine vuruş indirmeyi başardı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:157
translate tr qst_bloodhound_3_toBasement_ec059881:

    # "Its blades were unlike any other blade I'd seen before."
    "Bıçakları daha önce gördüğüm hiçbir bıçağa benzemiyordu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:158
translate tr qst_bloodhound_3_toBasement_4532cba5:

    # "Perhaps they were enchanted, but they seemed sharper and able to cut at my flesh unlike any other."
    "Belki büyülenmişlerdi, ama daha keskindi ve etimi diğerlerinden farklı olarak kesebiliyor gibiydiler."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:159
translate tr qst_bloodhound_3_toBasement_b7befe8a:

    # "I managed to strike it with my tail, piercing a gaping hole through its chest."
    "Kuyruğumla vurmayı başardım, göğsünde açık bir delik deldim."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:160
translate tr qst_bloodhound_3_toBasement_1c0b9dcc:

    # "But instead of turning limp, it slashed down, causing a painful wound in my tail as it continued on despite its horrific injury."
    "Ama gevşek dönmek yerine, aşağı kesti, korkunç yarasına rağmen devam ederken kuyruğumda acılı bir yaraya neden oldu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:161
translate tr qst_bloodhound_3_toBasement_40f4935f:

    # MC "(What the fuck is this thing?!)"
    MC "(Bu ne lanet şey?!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:162
translate tr qst_bloodhound_3_toBasement_b29379dc:

    # MC "(Is it even killable?)"
    MC "(Öldürülebilir mi ki?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:163
translate tr qst_bloodhound_3_toBasement_323868cf:

    # "Once again, the thing leapt forward, and after a few clashes of our blades, it suddenly pierced through me with one of it's claw hands."
    "Bir kez daha, şey ileri atladı ve bıçaklarımızın birkaç çarpışmasından sonra, aniden pençeli ellerinden biriyle beni deldi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:164
translate tr qst_bloodhound_3_toBasement_d327c627:

    # "Screaming in pain, I charged forward, managing to knock the man in black against the opposing wall but it dodged my subsequent lethal swipe to take its head off."
    "Acı içinde çığlık atarak, ileri hücum ettim, siyahtaki adamı karşı duvara çarpmayı başardım ama kafasını almak için sonraki öldürücü darbemden kaçtı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:165
translate tr qst_bloodhound_3_toBasement_39009672:

    # "It felt like a horrific dance as the thing moved around me, taking piece after piece."
    "Şey etrafımda hareket ederken, parça parça alırken korkunç bir dans gibi hissettirdi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:166
translate tr qst_bloodhound_3_toBasement_b5c60d7e:

    # "I began to feel dizzy and increasingly weak..."
    "Başım dönmeye başladı ve giderek daha zayıf hissettim..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:167
translate tr qst_bloodhound_3_toBasement_3f7ba3ac:

    # "Just how much longer could I keep this up?"
    "Bunu daha ne kadar sürdürebilirdim?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:168
translate tr qst_bloodhound_3_toBasement_733ec587:

    # MC "(F-Fuck! Can you help me out here?)"
    MC "(S-Siktir! Burada bana yardım edebilir misin?)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:169
translate tr qst_bloodhound_3_toBasement_d0ca6432:

    # BLACK "Flee."
    BLACK "Kaç."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:170
translate tr qst_bloodhound_3_toBasement_e28f5ee5:

    # MC "(Flee?! You can't be serious!)"
    MC "(Kaç?! Ciddi olamazsın!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:171
translate tr qst_bloodhound_3_toBasement_6e2d0cec:

    # BLACK "Cannot stabilize damage much longer."
    BLACK "Hasardan daha uzun süre stabilize edemem."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:172
translate tr qst_bloodhound_3_toBasement_60f0bc89:

    # BLACK "His blades are coated with something slowing the rapid healing response."
    BLACK "Bıçakları hızlı iyileşme tepkisini yavaşlatan bir şeyle kaplı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:173
translate tr qst_bloodhound_3_toBasement_872010a3:

    # MC "(Fuck! FUCK!)"
    MC "(Siktir! SİKTİR!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:174
translate tr qst_bloodhound_3_toBasement_35522119:

    # "I looked towards the stairs once again."
    "Bir kez daha merdivenlere baktım."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:175
translate tr qst_bloodhound_3_toBasement_2dbdb956:

    # "The man in black blocked my path, blades ready."
    "Siyahtaki adam yolumuzu kesti, bıçaklar hazır."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:176
translate tr qst_bloodhound_3_toBasement_92f5db33:

    # MC "(I have to try, I just need to get past!)"
    MC "(Denemeliyim, sadece geçmem gerekiyor!)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:177
translate tr qst_bloodhound_3_toBasement_05ee5938:

    # "I darted onto the side wall, springing off from my foot to bounce off as I twisted my whole body and swung my tail to try and knock the man back."
    "Yan duvara fırladım, ayağımdan fırlayarak tüm bedenimi büktüm ve adamı geri vurmayı denemek için kuyruğumu savurdum."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:178
translate tr qst_bloodhound_3_toBasement_6a1754bb:

    # "It grabbed onto my tail as I slammed it against the wall, sending shards of stone flying."
    "Kuyruğumu yakaladı, onu duvara çarptığımda taş parçaları uçuştu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:179
translate tr qst_bloodhound_3_toBasement_d7df702e:

    # "The man in black refused to give up, forcing blades through my tail."
    "Siyahtaki adam pes etmeyi reddetti, bıçakları kuyruğumun içinden zorladı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:180
translate tr qst_bloodhound_3_toBasement_20d8f036:

    # "I screeched out in pain but the man in black kept coming no matter what I did."
    "Acıyla tiz bir çığlık attım ama siyahtaki adam ne yaparsam yapayım gelmeye devam etti."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:181
translate tr qst_bloodhound_3_toBasement_cb953dbd:

    # "Only now did I realize how close death was..."
    "Sadece şimdi ölümün ne kadar yakın olduğunu fark ettim..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:182
translate tr qst_bloodhound_3_toBasement_0e939507:

    # UNKNOWN "{i}*Whistles*{/i}"
    UNKNOWN "{i}*Islık çalar*{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:184
translate tr qst_bloodhound_3_toBasement_9afc807c:

    # "As the man in black turned sharply towards the sound, he was suddenly blasted back by a bolt of lightning."
    "Siyahtaki adam keskin bir şekilde sese dönerken, aniden bir yıldırım cıvatasıyla geriye fırlatıldı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:185
translate tr qst_bloodhound_3_toBasement_13c9ce29:

    # "Beside Captain Nyx, four mages stood at the ready, their staffs pointed towards the convulsing automaton."
    "Kaptan Nyx'in yanında, dört büyücü hazırda durdu, asaları sarsılan otomatona doğrultulmuştu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:213
translate tr qst_bloodhound_3_toBasement_98ef091a:

    # "It struggled and rose to its feet again, charging towards the Captain and the mages."
    "Boğuştu ve ayaklarının üzerine tekrar kalktı, Kaptan ve büyücülere doğru hücum etti."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:220
translate tr qst_bloodhound_3_toBasement_9304bfda:

    # "...But another blast sent him wheeling backwards."
    "...Ama başka bir patlama onu tekerleklendi geri gönderdi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:222
translate tr qst_bloodhound_3_toBasement_18e5bb6b:

    # "Clambering back to its feet before they could finish it off, the man in black charged forward, dodging the third blast right through the Captain and her mages, scurrying its way up the stairs."
    "Onun işini bitirmeden önce ayaklarının üzerine tırmanarak, siyahtaki adam ileri hücum etti, üçüncü patlamadan Kaptan ve büyücülerinin tam arasından kaçarak merdivenlerden yukarı sıvıştı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:223
translate tr qst_bloodhound_3_toBasement_53131c31:

    # NYX @ angry "AFTER HIM!"
    NYX @ angry "PEŞİNDEN!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:224
translate tr qst_bloodhound_3_toBasement_03084257:

    # MAGE "But... What about the other one?"
    MAGE "Ama... Ya diğeri?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:225
translate tr qst_bloodhound_3_toBasement_f1f00a2f:

    # NYX @ angry "Leave him!"
    NYX @ angry "Bırak onu!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:226
translate tr qst_bloodhound_3_toBasement_235c9198:

    # NYX @ angry "{i}He's with us.{/i}"
    NYX @ angry "{i}O bizimle.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:235
translate tr qst_bloodhound_3_toBasement_26742987:

    # "The mages followed after him as I weakly stumbled behind them deliriously, blood pouring out of me."
    "Büyücüler peşinden gitti, ben zayıfça arkalarından sayıklayarak sendeleyerek takip ettim, içimden kan akıyordu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:237
translate tr qst_bloodhound_3_toBasement_e2baa4ae:

    # "Dizzy, I saw mages and Nyx fight the thing relentlessly."
    "Başım dönüyor, büyücüler ve Nyx'in şeyle amansızca savaştığını gördüm."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:238
translate tr qst_bloodhound_3_toBasement_45fc3d08:

    # "After a few blows, the Man in black knocked back Captain Nyx before leaping through one of the glass windows, shattering it."
    "Birkaç darbeden sonra, Siyahtaki Adam cam pencerelerden birinden atlayıp onu kırmadan önce Kaptan Nyx'i geri vurdu."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:244
translate tr qst_bloodhound_3_toBasement_b7f2c043:

    # "From outside, we watched as he contorted his body with unnatural speed, dragging himself up unto a building and moving away too fast for us to even see."
    "Dışarıdan, bedenini doğa dışı bir hızla büktüğünü, kendini bir binaya yukarı sürüklediğini ve göremeyeceğimiz kadar hızlı uzaklaştığını izledik."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:245
translate tr qst_bloodhound_3_toBasement_58688400:

    # MAGE "Captain! Do we pursue?"
    MAGE "Kaptan! Takip ediyor muyuz?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:246
translate tr qst_bloodhound_3_toBasement_b9c6a5a9:

    # SECOND_MAGE "We need more time to prepare another charge!"
    SECOND_MAGE "Başka bir yük hazırlamak için daha fazla zamana ihtiyacımız var!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:260
translate tr qst_bloodhound_3_toBasement_fdeb4bdc:

    # NYX @ angry "No... Whatever that thing is, its gone."
    NYX @ angry "Hayır... O şey her neyse, gitti."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:261
translate tr qst_bloodhound_3_toBasement_d1beeab3:

    # "Unable to handle a single step more my buckling legs gave and I dropped to my knees."
    "Tek bir adım daha atamayarak, çöken bacaklarım pes etti ve dizlerime düştüm."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:263
translate tr qst_bloodhound_3_toBasement_2fb16082:

    # "Blood poured from all over my mangled body as I crashed forward with a thud."
    "Paramparça bedenimin her yerinden kan döküldü, bir gümbürtüyle öne yığıldım."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:266
translate tr qst_bloodhound_3_toBasement_6859ac9e:

    # NYX "SHIT!"
    NYX "SİKTİR!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:267
translate tr qst_bloodhound_3_toBasement_c58b41a1:

    # "Darkness."
    "Karanlık."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:282
translate tr qst_bloodhound_3_toBasement_3e507460:

    # NYX @ shock "...Hey, HEY! He's opening his eyes!"
    NYX @ shock "...Hey, HEY! Gözlerini açıyor!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:283
translate tr qst_bloodhound_3_toBasement_96bf910a:

    # MC "Urghh..."
    MC "Ahhhh..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:284
translate tr qst_bloodhound_3_toBasement_ad80ee54:

    # MAGE_TALL "We did our best to heal the creatures wounds but-"
    MAGE_TALL "Yaratığın yaralarını iyileştirmek için elimizden geleni yaptık ama-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:285
translate tr qst_bloodhound_3_toBasement_1d30ae43:

    # MAGE_TALL "Captain... What is this thing?"
    MAGE_TALL "Kaptan... Bu şey ne?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:286
translate tr qst_bloodhound_3_toBasement_113a6d97:

    # MAGE_SLIM "It... It looks like a man, but earlier-"
    MAGE_SLIM "Bu... Bir adama benziyor, ama daha önce-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:287
translate tr qst_bloodhound_3_toBasement_52521e89:

    # NYX @ angry "Never you mind."
    NYX @ angry "Boş verin."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:288
translate tr qst_bloodhound_3_toBasement_a42b3df1:

    # NYX @ talk "Now help him back to his feet!"
    NYX @ talk "Şimdi onu ayaklarına geri kaldırmaya yardım edin!"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:291
translate tr qst_bloodhound_3_toBasement_c6e0476f:

    # "The mages weakly helped me back to my feet which trembled and shook, barely able to hold me upright."
    "Büyücüler beni zayıfça ayaklarıma geri kaldırmaya yardım etti, bacaklarım titredi ve sallandı, beni dik tutmaya zar zor yetebildi."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:310
translate tr qst_bloodhound_3_toBasement_07dd01bf:

    # MC @ talk "{i}*Cough*{/i} How did you-"
    MC @ talk "{i}*Öksürük*{/i} Nasıl-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:311
translate tr qst_bloodhound_3_toBasement_06fdd052:

    # NYX @ talk "We will talk later, I will explain everything soon."
    NYX @ talk "Sonra konuşuruz, yakında her şeyi açıklayacağım."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:312
translate tr qst_bloodhound_3_toBasement_9ae00cf0:

    # "Captain Nyx turned towards the other mages."
    "Kaptan Nyx diğer büyücülere döndü."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:315
translate tr qst_bloodhound_3_toBasement_33bce3a6:

    # NYX @ angry "None of you will speak of what you have seen today, understand?"
    NYX @ angry "Hiçbiriniz bugün gördükleriniz hakkında konuşmayacaksınız, anlaşıldı mı?"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:316
translate tr qst_bloodhound_3_toBasement_f9a9e350:

    # "The mages look at each other sheepishly."
    "Büyücüler mahcupça birbirlerine baktılar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:317
translate tr qst_bloodhound_3_toBasement_675dbf11:

    # NYX @ angry "I assure you, {i}the fates will not favor you for a lack of discretion, ladies.{/i}"
    NYX @ angry "Sizi temin ederim ki, {i}kader takdir yetkisi eksikliği için sizi desteklemez, hanımlar.{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:318
translate tr qst_bloodhound_3_toBasement_4abde0dd:

    # "The mages all nervously nodded."
    "Büyücüler hep birlikte sinirli bir şekilde başlarını salladılar."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:328
translate tr qst_bloodhound_3_toBasement_d626dae3:

    # NYX @ talk "Now help me dress him."
    NYX @ talk "Şimdi onu giydirmeme yardım edin."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:332
translate tr qst_bloodhound_3_toBasement_4896de1a:

    # "The Mages eyes looked downwards as their cheeks flushed red."
    "Büyücülerin gözleri aşağı baktı, yanakları kırmızı kızardı."

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:333
translate tr qst_bloodhound_3_toBasement_7a8a690f:

    # NYX @ angry "...Oh for the love of-"
    NYX @ angry "...Ah Tanrı aşkına-"

# game/data/world_quests/main/Act1/TheBloodhound/scr_3.rpy:334
translate tr qst_bloodhound_3_toBasement_28ca6b76:

    # NYX @ blush "Sisters... {i}Eyes up{/i} and focus."
    NYX @ blush "Kardeşler... {i}Gözler yukarı{/i} ve odaklanın."

