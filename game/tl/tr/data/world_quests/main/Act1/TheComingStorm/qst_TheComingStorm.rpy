    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:2
    old "Attend the meeting"
    new "Toplantıya katıl"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:2
    old "I was prompted to come to the guild after dark. Something important's going down."
    new "Karanlık bastıktan sonra loncaya gelmem istendi. Önemli bir şeyler oluyor."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:27
