    new "Paketi geri alma zamanı, gerçekten şimdi."

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:29
    old "Bring the parcel to Vala"
    new "Paketi Vala'ya getir"

    # game/data/world_quests/main/Act1/TheComingStorm/qst_TheComingStorm.rpy:29
