translate tr strings:

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:98
    old "Our blades..."
    new "Kılıçlarımız..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:100
    old "Our souls..."
    new "Ruhlarımız..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:102
    old "Our enemies..."
    new "Düşmanlarımız..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:104
    old "Our hands..."
    new "Ellerimiz..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:108
    old "...Were unbroken..."
    new "...Kırılmamıştı..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:110
    old "...Remain pure..."
    new "...Saf kalır..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:112
    old "...Were bloodied..."
    new "...Kanlıydı..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:114
    old "...Were destroyed..."
    new "...Yok edildi..."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:118
    old "...So the kingdom might endure."
    new "...Böylece krallık dayanabilsin."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:120
    old "...So thine could stay clean."
    new "...Böylece seninki temiz kalabilsin."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:122
    old "...For the promise of the dawn."
    new "...Şafağın vaadi için."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:124
    old "...So thy could remember our oath."
    new "...Böylece sen yeminimizi hatırlayabilesin."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:163
    old "I'll get your parcel."
    new "Paketini alacağım."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:169
    old "What's in the parcel?"
    new "Pakette ne var?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:315
    old "Throw some coin into the air to distract everyone!"
    new "Herkesin dikkatini dağıtmak için havaya biraz para fırlat!"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:330
    old "Barge past the men!"
    new "Adamların yanından zorla geç!"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:438
    old "Hide the coin behind the brick."
    new "Parayı tuğlanın arkasına sakla."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:606
    old "Why go through all these loops if you just wanted me to kill them?"
    new "Sadece onları öldürmemi istiyorsan neden tüm bu döngülerden geç?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:631
    old "Don't you have a uniform to wear?"
    new "Giymek için bir üniforman yok mu?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:640
    old "So... Your real name is Saren?"
    new "Yani... Gerçek adın Saren mi?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:648
    old "Why are you helping me now? Aren't you helping Erika investigate me?"
    new "Bana şimdi neden yardım ediyorsun? Erika'nın beni soruşturmasına yardım etmiyor musun?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:661
    old "What do you know about Poltrik and his men then?"
    new "O zaman Poltrik ve adamları hakkında ne biliyorsun?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:705
    old "{i}*Give in*{/i}"
    new "{i}*Teslim ol*{/i}"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_AltInvestigation.rpy:708
    old "No... I can't."
    new "Hayır... Yapamam."

