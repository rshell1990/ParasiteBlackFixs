    # MC "(Perhaps there's something else I can do in the meanwhile?)"
    MC "(Belki bu arada yapabileceğim başka bir şey vardır?)"

translate tr strings:

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:31
    old "For such a valued customer as myself?"
    new "Benim gibi değerli bir müşteri için mi?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:37
    old "Here is your coin."
    new "İşte paran."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:58
    old "I don't have the coin."
    new "Param yok."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:95
    old "{image=[ICON.SWORDS]} You can't kill me... You all are already dead."
    new "{image=[ICON.SWORDS]} Beni öldüremezsin... Siz hepiniz zaten ölüsünüz."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:157
    old "Because I'll slaughter all of you before you stand a chance."
    new "Çünkü bir şansınız olmadan hepinizi katlederim."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:164
    old "Because I might be your only chance of survival."
    new "Çünkü hayatta kalma şansınız olan tek kişi ben olabilirim."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:169
    old "You're a wanted bandit... I could have come here with a dozen guards."
    new "Sen aranan bir haydutsun... Buraya bir düzine muhafızla gelebilirdim."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:180
    old "You've made a lot of enemies... Why haven't you left the city already?"
    new "Bir sürü düşman edindin... Neden şehri çoktan terk etmedin?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:185
    old "So you plan to fight them?"
    new "Yani onlarla savaşmayı mı planlıyorsun?"

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:189
    old "You can't hide forever. They're going to find you."
    new "Sonsuza kadar saklanamazsın. Seni bulacaklar."

    # game/data/world_quests/main/Act1/TheComingStorm/scr_TheComingStorm_valchek.rpy:192
    old "Carina doesn't care if you're dead or not, but she wants you gone."
    new "Carina ölü olup olmadığını umursamaz, ama gitmeni istiyor."

