    GUARD "Ama—"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:39
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_266d52f6:

    # NYX @ angry "That was an order, not a request."
    NYX @ angry "Bu bir emirdi, bir rica değil."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:40
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_19d2c49e:

