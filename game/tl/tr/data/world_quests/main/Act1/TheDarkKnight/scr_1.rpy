translate tr qst_DarkKnight_1_atCaptainNyxOfficeRevisit_a949c99b:

    # NYX @ laugh "Finally, someone useful around here."
    NYX @ laugh "Nihayet, buralarda işe yarar biri."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:131
translate tr qst_DarkKnight_1_atCaptainNyxOfficeRevisit_3fda12e3:

    # NYX @ talk "Good, I look forward to hearing your progress."
    NYX @ talk "Güzel, ilerlemeni duymayı dört gözle bekliyorum."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:135
translate tr qst_DarkKnight_1_atCaptainNyxOfficeRevisit_16f82085:

    # NYX @ angry "Well don't think too long, either you do it, or I have to find some other idiot to fill in for you."
    NYX @ angry "Pekala çok uzun düşünme, ya yaparsın, ya da senin yerini dolduracak başka bir aptal bulmak zorundayım."

