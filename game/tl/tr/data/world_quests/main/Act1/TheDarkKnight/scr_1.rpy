    GUARD "...Evet hanımefendi."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:41
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_25e04db1:

    # GUARD "You may proceed."
    GUARD "İlerleyebilirsin."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:47
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_8c8a82db:

    # NYX @ angry "You do know I can have you thrown in a cell for threatening guards like that."
    NYX @ angry "Biliyorsun değil mi, muhafızları böyle tehdit ettiğin için seni hücreye attırabilirim."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:48
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_a14d861d:

    # MC @ talk "I don't really like being told what to do."
    MC @ talk "Bana ne yapmam gerektiğinin söylenmesinden pek hoşlanmam."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:49
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_924be6cd:

    # NYX @ angry "Hmph, well you better get used to it."
    NYX @ angry "Hmph, pekala alışsan iyi olur."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:50
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_f905f88e:

    # NYX @ angry "The only way to get anywhere here is to learn when to kiss ass and shut up."
    NYX @ angry "Burada bir yere varmanın tek yolu ne zaman kıç öpüp susacağını öğrenmektir."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:53
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_8557ad27:

    # NYX @ shock "Oh, {i}really?{/i} Would you like to get to know me better with my boot up your fucking ass?"
    NYX @ shock "Ah, {i}gerçekten mi?{/i} Kıçına botumu sokarak beni daha iyi tanımak ister misin?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:54
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_74a11e6f:

    # NYX @ angry "Pay attention, I'm not one of your sluts, nor am I here to fuck around with some happy go lucky {i}'Adventurer'{/i}..."
    NYX @ angry "Dikkatini ver, ben senin fahişelerinden biri değilim, ne de buraya mutlu mesut bir {i}'Maceraperest'{/i} ile oyalanmaya geldim..."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:55
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_1d6bf6ef:

    # NYX @ angry "...whose probably gonna get skullfucked to death by a pissed off Demorai soon anyway."
    NYX @ angry "...ki zaten yakında kızgın bir Demorai tarafından muhtemelen ölesiye sikilecek."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:59
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_02682086:

    # NYX @ talk "Your services are called upon to serve the Kingdom once again."
    NYX @ talk "Hizmetlerin bir kez daha Krallığa hizmet etmek için çağrıldı."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:60
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_d9e10f0a:

    # NYX @ talk "I don't know how aware you are with how 'fragile' things can be in this city, but suffice to say, I'm in need of a sellsword like yourself."
    NYX @ talk "Bu şehirde işlerin ne kadar 'kırılgan' olabileceğinin ne kadar farkındasın bilmiyorum, ama yeter ki söyleyeyim, senin gibi bir kiralık kılıca ihtiyacım var."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:61
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_6f18111b:

    # NYX @ talk "You'll be well compensated for your services."
    NYX @ talk "Hizmetlerin için iyi tazmin edileceksin."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:62
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_4b2d3807:

    # MC @ talk "Depends on the job."
    MC @ talk "İşe bağlı."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:63
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_d2a7d24e:

    # NYX @ talk "These last few months, we've seen an explosion in banditry around the city."
    NYX @ talk "Son birkaç aydır, şehrin etrafında haydutlukta bir patlama gördük."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:64
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_b450829f:

    # NYX @ talk "It seems some of the smaller crime factions inside the city have splintered, and the ensuing chaos is spilling out onto the street."
    NYX @ talk "Görünüşe göre şehir içindeki daha küçük suç gruplarından bazıları parçalanmış ve ardından gelen kaos sokağa taşıyor."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:65
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_87b2aadb:

    # NYX @ angry "Soon the fuckers will be trying to rob people in bloody daylight if we don't stomp it out now."
    NYX @ angry "Yakında o pislikler onu şimdi ezmezsek, insanları güpegündüz soymaya çalışacaklar."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:66
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_5090010f:

    # NYX @ talk "I want you to go out and send a message."
    NYX @ talk "Dışarı çıkıp bir mesaj iletmeni istiyorum."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:67
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_b860df6b:

    # NYX @ talk "Find them, and take them out."
    NYX @ talk "Onları bul ve ortadan kaldır."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:68
translate tr qst_DarkKnight_1_GoToCaptainNyxOffice_c2211533:

    # NYX @ angry "I'll string up a few of the bodies when you're done, then they'll know not to fuck around."
    NYX @ angry "İşin bittiğinde birkaç cesedi asacağım, o zaman uğraşmamayı bilirler."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:72
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_f1792b2d:

    # NYX @ angry "Because we're stretched thin enough as it is, Alcott keeps pulling my men into whatever division he thinks is most important for the day and he's leaving me severely short-handed."
    NYX @ angry "Çünkü zaten yeterince ince gerildik, Alcott sürekli adamlarımı gün için en önemli olduğunu düşündüğü bölüğe çekiyor ve beni ciddi şekilde eksik adamla bırakıyor."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:73
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_a52b06f6:

    # NYX @ angry "The fucker's so busy worrying about the enemy beyond the wall, he forgets about the threats from within."
    NYX @ angry "O pislik duvarın ötesindeki düşman için endişelenmekle o kadar meşgul ki, içerideki tehditleri unutuyor."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:74
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_7d5932ee:

    # MC @ talk "I take it you don't approve of his leadership?"
    MC @ talk "Anladığım kadarıyla liderliğini onaylamıyor musun?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:75
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_3443fedc:

    # NYX @ talk "Better than Mesamor, but even the best fruit is doomed to fall if the tree's rotten."
    NYX @ talk "Mesamor'dan daha iyi, ama en iyi meyve bile ağaç çürükse düşmeye mahkumdur."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:76
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_97dfcab2:

    # MC @ talk "That's... quite the metaphor."
    MC @ talk "Bu... epey bir metafor."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:77
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_a6180854:

    # NYX @ talk "We can discuss politics all you want when you're done."
    NYX @ talk "İşin bittiğinde istediğin kadar siyaset tartışabiliriz."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:82
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_5e99b9b0:

    # NYX @ angry "In case you really are this stupid, let me spell it out for you."
    NYX @ angry "Eğer gerçekten bu kadar aptalsan, senin için heceleyeyim."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:83
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_29fee2e8:

    # NYX @ angry "{i}We. Do. Not. Have. The. Men.{/i}"
    NYX @ angry "{i}Bizim. Adamımız. Yok.{/i}"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:84
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_f7b66a95:

    # NYX @ angry "What do you expect me to do? Kill all the bandits by myself?"
    NYX @ angry "Ne yapmamı bekliyorsun? Tüm haydutları tek başıma mı öldüreyim?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:85
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_c94421e2:

    # NYX @ talk "Not to mention the fact they've actively started laying traps for us now."
    NYX @ talk "Üstelik artık aktif olarak bizim için tuzaklar kurmaya başladılar."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:86
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_c8d8ea69:

    # MC @ talk "Laying traps?"
    MC @ talk "Tuzak kurmak mı?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:87
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_77df70a0:

    # NYX @ talk "Yep, baiting us into tight alleyways or feeding us false information."
    NYX @ talk "Evet, bizi dar ara sokaklara çekiyor veya bize yanlış bilgi yediriyorlar."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:88
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_52f4e6ce:

    # NYX @ angry "They've managed to ambush and take out a few of us like that, sneaky bastards, the lot of them."
    NYX @ angry "Birkaçımızı böyle pusuya düşürüp ortadan kaldırmayı başardılar, sinsi piçler, hepsi."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:89
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_9267291e:

    # NYX @ talk "Something drastic needs to be done, something that will bring them back into line."
    NYX @ talk "Köklü bir şey yapılması gerekiyor, onları hizaya getirecek bir şey."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:94
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_ab515118:

    # NYX @ smile "Feeling a little bloodthirsty today, aren't we?"
    NYX @ smile "Bugün biraz kana susamış hissediyoruz, değil mi?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:95
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_a9c73586:

    # NYX @ laugh "Never mind, I just wish the rest of my men shared your enthusiasm."
    NYX @ laugh "Boş ver, sadece keşke adamlarımın geri kalanı senin gayretini paylaşsaydı."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:96
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_f25df481:

    # NYX @ angry "Half of them act like they've just had their balls cut off."
    NYX @ angry "Yarısı sanki az önce taşakları kesilmiş gibi davranıyor."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:101
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_8961b27f:

    # NYX @ angry "Do you really think if things weren't that bad, Lukkan would be calling upon someone from the fucking Adventurers Guild of all things to help me out?"
    NYX @ angry "Eğer işler o kadar kötü olmasaydı, Lukkan'ın tüm şeylerden Maceraperestler Loncası'ndan birini bana yardım etmesi için çağıracağını gerçekten düşünüyor musun?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:102
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_57c218cb:

    # MC @ angry "What's wrong with the Adventurers Guild?"
    MC @ angry "Maceraperestler Loncası'nın nesi var?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:103
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_17a86af6:

    # NYX @ smile "Haha! Wow, you are new to all this, aren't you?"
    NYX @ smile "Haha! Vay, tüm bunlara gerçekten yenisin, değil mi?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:104
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_53359bec:

    # NYX @ angry "I'll tell you what, do your job, and maybe I'll tell you my 'opinions' on the Adventure Guild afterwards."
    NYX @ angry "Sana ne diyeceğim, işini yap, belki sonrasında sana Macera Loncası hakkındaki 'görüşlerimi' söylerim."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:110
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_a2abb0bb:

    # NYX @ talk "Finally."
    NYX @ talk "Nihayet."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:111
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_83e60d6b:

    # NYX @ talk "So... Can I count on you with this?"
    NYX @ talk "Peki... Bu konuda sana güvenebilir miyim?"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:114
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_b0f2fa21:

    # NYX @ smile "Finally, someone useful around here."
    NYX @ smile "Nihayet, buralarda işe yarar biri."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:115
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_3fda12e3:

    # NYX @ talk "Good, I look forward to hearing your progress."
    NYX @ talk "Güzel, ilerlemeni duymayı dört gözle bekliyorum."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:116
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_17ec0421:

    # NYX @ talk "Remember, I need at least three groups of them slain, try wandering around at night and seeing what you find."
    NYX @ talk "Unutma, en az üç grup öldürülmelerine ihtiyacım var, geceleyin dolaşıp ne bulduğuna bakmayı dene."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:121
translate tr qst_DarkKnight_1_atCaptainNyxOffice_menu_d6b43d78:

    # NYX @ angry "Well, don't think too long, either you do it, or I have to find some other idiot to fill in for you."
    NYX @ angry "Pekala, çok uzun düşünme, ya yaparsın, ya da senin yerini dolduracak başka bir aptal bulmak zorundayım."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:125
translate tr qst_DarkKnight_1_atCaptainNyxOfficeRevisit_a2ca27cc:

    # NYX @ talk "Yeah, I need you to patrol the streets at night."
    NYX @ talk "Evet, geceleyin sokakları devriye gezmeni istiyorum."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:126
translate tr qst_DarkKnight_1_atCaptainNyxOfficeRevisit_36b1eb9b:

    # NYX @ talk "Deal with at least three bandit groups."
    NYX @ talk "En az üç haydut grubuyla ilgilen."

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:127
translate tr qst_DarkKnight_1_atCaptainNyxOfficeRevisit_83e60d6b:

    # NYX @ talk "So... Can I count on you with this?"
    NYX @ talk "Peki... Bu konuda sana güvenebilir miyim?"

