translate tr qst_TwoEmperors_2_74552aff:

    # "Both me and Markus cautiously looked around, half-expecting an ambush from Demorai amidst the dunes."
    "İkimiz de dikkatle etrafa baktık, kumulların arasında bir Demorai pususunu yarı bekledik."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:176
translate tr qst_TwoEmperors_2_0937ddc8:

