translate tr qst_TwoEmperors_2_47374a90:

    # SYPHA @ happy "{i}To end this war, of course.{/i}"
    SYPHA @ happy "{i}Bu savaşı bitirmek, elbette.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:183
translate tr qst_TwoEmperors_2_6e508b48:

    # MARKUS "With your side winning, right?"
    MARKUS "Sizin tarafın kazanmasıyla, değil mi?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:184
translate tr qst_TwoEmperors_2_bf2e3a2d:

