# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:3
translate tr qst_TwoEmperors_2_63ee727d:

    # "From the depths of the cavern, the sound of drums... Drums beating in the depths of the darkness."
    "Mağaranın derinliklerinden, davul sesleri... Karanlığın derinliklerinde çalan davullar."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:9
translate tr qst_TwoEmperors_2_dcd0cb47:

    # MARKUS "What is that?"
    MARKUS "O ne?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:10
translate tr qst_TwoEmperors_2_96b7d8a2:

    # MC "...Come on, let's get closer."
    MC "...Hadi, yaklaşalım."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:14
translate tr qst_TwoEmperors_2_bc88f2af:

    # MARKUS "...F-Fuck?! Are you not hearing the same thing as me?"
    MARKUS "...S-Siktir?! Benimle aynı şeyi duymuyor musun?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:15
translate tr qst_TwoEmperors_2_567a8d97:

    # MC "Shh! Just follow me damn it!"
    MC "Şşş! Sadece beni takip et lanet olsun!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:16
translate tr qst_TwoEmperors_2_160d87e9:

    # MARKUS "{i}*Sigh*{/i} ...Fuck!"
    MARKUS "{i}*İç çekiş*{/i} ...Siktir!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:19
translate tr qst_TwoEmperors_2_d30fcc76:

    # "Following the sounds, we decided it was best to avoid the main pathway where the others would have walked, and instead clambered our way through one of the other connecting winding passages."
    "Sesleri takip ederek, diğerlerinin yürümüş olacağı ana yoldan kaçınmanın en iyisi olduğuna karar verdik, ve onun yerine diğer bağlayan dolambaçlı geçitlerden birinden tırmandık."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:20
translate tr qst_TwoEmperors_2_3c7a1c5e:

    # "The less traversed pathway rose up as we continued to walk along it, till finally, we stumbled upon an opening which we cautiously approached."
    "Daha az katedilmiş yol, yürümeye devam ettikçe yükseldi, ta ki nihayet, dikkatle yaklaştığımız bir açıklığa rastlayana dek."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:24
translate tr qst_TwoEmperors_2_f103c1d0:

    # "Peering through the opening cautiously, we could see we were high above the many thousands of Demorai down below in the great Cavern like hall."
    "Açıklığa dikkatle bakarak, aşağıda büyük Mağara benzeri salondaki binlerce Demorai'nin çok yukarısında olduğumuzu görebildik."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:25
translate tr qst_TwoEmperors_2_907217ef:

    # "Organized into neat rows, the Demorai forces gathered and waited patiently, staring down at some great oval stone stage with strange markings on it and lit burning iron fire pits all around."
    "Düzenli sıralara ayrılmış, Demorai güçleri toplandı ve sabırla bekledi, üzerinde garip işaretler olan ve etrafta yanan demir ateş ocaklarıyla büyük oval bir taş sahneye bakarak."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:26
translate tr qst_TwoEmperors_2_907b832d:

    # "The front row beat their drums in a synchronized steady rhythm, each boom echoing deeply through the ruins."
    "Ön sıra davullarını senkronize bir sabit ritimle çaldı, her gümbürtü harabelerde derinden yankılandı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:27
translate tr qst_TwoEmperors_2_4174dccb:

    # "Markus and I shared a brief look of bewilderment as we continued to watch the scene unfold below us."
    "Markus ve ben, aşağıda gelişen sahneyi izlemeye devam ederken kısa bir şaşkınlık bakışı paylaştık."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:28
translate tr qst_TwoEmperors_2_64e08ffa:

    # "Down below, one group of the Demorai stood away from the rest, many of them robed and distinctly on the fringes."
    "Aşağıda, bir grup Demorai diğerlerinden ayrı durdu, birçoğu cübbeli ve belirgin şekilde kenarlarda."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:29
translate tr qst_TwoEmperors_2_30771f5e:

    # "Amongst them though, an old, hunched woman with ashen skin, and beside her, perhaps the most strangely ethereally beautiful, and yet, oddly baleful woman I had ever laid my eyes on, who watched the whole affair with arms crossed looking sternly ahead towards the stage."
    "Aralarında ancak, küllü tenli yaşlı, kambur bir kadın, ve onun yanında, belki de hayatımda gözlerimi diktiğim en garip uhrevi güzel, ve yine de, garip şekilde uğursuz kadın, kolları kavuşturulmuş sertçe sahneye doğru ileri bakarak tüm olayı izledi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:30
translate tr qst_TwoEmperors_2_84b9de98:

    # "Finally, the drum beats abruptly stopped as a robed figure emerged onto the stage."
    "Nihayet, davul vuruşları aniden durdu, cübbeli bir figür sahneye çıktı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:37
translate tr qst_TwoEmperors_2_0e766aec:

    # DARK_EMPEROR "{i}...How long since we last stood in these hallowed halls?{/i}"
    DARK_EMPEROR "{i}...En son bu kutsal salonlarda durduğumuzdan beri ne kadar zaman geçti?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:38
translate tr qst_TwoEmperors_2_29ff24ea:

    # "Me and Markus shared another look towards each other."
    "Ben ve Markus birbirimize doğru başka bir bakış paylaştık."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:39
translate tr qst_TwoEmperors_2_96d7be6e:

    # MC "({i}It speaks... A fucking Demorai speaks!{/i})"
    MC "({i}Konuşuyor... Lanet bir Demorai konuşuyor!{/i})"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:40
translate tr qst_TwoEmperors_2_44d8ced1:

    # DARK_EMPEROR "How long since our great dream began and led us to this most sacred war?"
    DARK_EMPEROR "Büyük rüyamız başlayalı ve bizi bu en kutsal savaşa yönlendireli ne kadar zaman geçti?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:41
translate tr qst_TwoEmperors_2_bad90604:

    # DARK_EMPEROR "The sacrifices our people have shouldered to bring us this far have been immeasurable."
    DARK_EMPEROR "Halkımızın bizi buraya kadar getirmek için omuzladığı fedakarlıklar ölçülemez oldu."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:42
translate tr qst_TwoEmperors_2_aaa2fb79:

    # DARK_EMPEROR "From the bloody battle rivers of Ashara to the black mines of Helenos, we have fought, and we have prevailed."
    DARK_EMPEROR "Ashara'nın kanlı savaş ırmaklarından Helenos'un kara madenlerine kadar, savaştık ve galip geldik."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:43
translate tr qst_TwoEmperors_2_80466b4e:

    # DARK_EMPEROR "Now your Emperor calls upon you once again..."
    DARK_EMPEROR "Şimdi İmparatorunuz sizi bir kez daha çağırıyor..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:44
translate tr qst_TwoEmperors_2_b285ac6b:

    # DARK_EMPEROR "It is no secret this war has taken longer than any of us first expected."
    DARK_EMPEROR "Bu savaşın herhangi birimizin ilk başta beklediğinden daha uzun sürdüğü bir sır değil."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:45
translate tr qst_TwoEmperors_2_e3fbe0ab:

    # DARK_EMPEROR "Our mistakes early on cost us dearly... But now, the time has come to end this endless stalemate!"
    DARK_EMPEROR "Başlangıçtaki hatalarımız bize pahalıya mal oldu... Ama şimdi, bu sonsuz çıkmaza son verme zamanı geldi!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:46
translate tr qst_TwoEmperors_2_dcd1cbc5:

    # "The mass of Demorai roared in excitement."
    "Demorai kitlesi heyecanla kükredi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:47
translate tr qst_TwoEmperors_2_eafb5cde:

    # DARK_EMPEROR "Malakai blesses us with Lord Zanarak's return from his great crusade, and with his aid, I pledge to you."
    DARK_EMPEROR "Malakai, Lord Zanarak'ın büyük seferinden dönüşüyle bizi kutsuyor ve onun yardımıyla, size söz veriyorum."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:48
translate tr qst_TwoEmperors_2_c715dea1:

    # DARK_EMPEROR "WE SHALL CAST OUT THOSE WHO STAND IN OUR WAY AND SWEEP AWAY THEIR ARMIES LIKE DUST!"
    DARK_EMPEROR "YOLUMUZDA DURANLARI ATACAĞIZ VE ORDULARINI TOZ GİBİ SÜPÜRECEĞİZ!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:49
translate tr qst_TwoEmperors_2_cdfa84e5:

    # DARK_EMPEROR "THE LAND SHALL FLOW RED WITH THEIR BLOOD TILL THEY ARE BUT A FORGOTTEN DREAM WE ONE DAY TELL OUR YOUNG!"
    DARK_EMPEROR "TOPRAK ONLARIN KANIYLA KIRMIZI AKACAK, TA Kİ BİR GÜN GENÇLERİMİZE ANLATACAĞIMIZ UNUTULMUŞ BİR RÜYADAN İBARET OLANA KADAR!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:50
translate tr qst_TwoEmperors_2_376b76ab:

    # "The Demorai horde had now been worked up into a roaring frenzy."
    "Demorai sürüsü şimdi kükreyen bir çılgınlığa sürüklenmişti."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:51
translate tr qst_TwoEmperors_2_1c6020c2:

    # DARK_EMPEROR "Do you hear it my children?"
    DARK_EMPEROR "Duyuyor musunuz çocuklarım?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:52
translate tr qst_TwoEmperors_2_9f278520:

    # DARK_EMPEROR "The drums of war beat once again... Our great plan is finally set in motion!"
    DARK_EMPEROR "Savaş davulları bir kez daha çalıyor... Büyük planımız nihayet harekete geçirildi!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:53
translate tr qst_TwoEmperors_2_572abbfa:

    # DARK_EMPEROR "Our Empire stands on the edge of victory! Will you shed your blood with me one final time till the sweet night sings our people songs once again?"
    DARK_EMPEROR "İmparatorluğumuz zaferin eşiğinde duruyor! Tatlı gece bir kez daha halkımızın şarkılarını söyleyene kadar kanınızı benimle son bir kez dökecek misiniz?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:54
translate tr qst_TwoEmperors_2_6abc444e:

    # DARK_EMPEROR "WILL YOU?!"
    DARK_EMPEROR "DÖKECEK MİSİNİZ?!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:56
translate tr qst_TwoEmperors_2_48164ee7:

    # "The Demorai beat at the drums wildly as the Demorai crowds now roared so loud it was almost painful to the ears."
    "Demorai kalabalıkları şimdi o kadar yüksek sesle kükredi ki neredeyse kulaklara acı vericiydi, Demorai davullara çılgınca vurdu."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:57
translate tr qst_TwoEmperors_2_3d00b271:

    # "The dark emperor rose up his arms into the air as he cried out."
    "Kara imparator çığlık atarken kollarını havaya kaldırdı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:58
translate tr qst_TwoEmperors_2_09cd027b:

    # DARK_EMPEROR "LET THE CELEBRATIONS BEGIN!"
    DARK_EMPEROR "KUTLAMALAR BAŞLASIN!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:61
translate tr qst_TwoEmperors_2_44a1e136:

    # "The Demorai roared out in thunderous cries of jubilation, huge trays of beautifully cooked food were brought and shared amongst them."
    "Demorai gök gürültülü sevinç çığlıklarıyla kükredi, güzelce pişmiş yemek devasa tepsiler getirildi ve aralarında paylaşıldı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:62
translate tr qst_TwoEmperors_2_24bc9b33:

    # "The drum beat now became faster and other instruments tuned in."
    "Davul vuruşu şimdi daha hızlı oldu ve diğer enstrümanlar katıldı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:63
translate tr qst_TwoEmperors_2_72e6dbb6:

    # "It was perhaps the most bizarre thing I ever witnessed, the Demorai, the unspeakable terrors thought as nothing more than savage beasts... jovial and dancing with glee."
    "Belki de tanık olduğum en tuhaf şeydi, Demorai, vahşi canavarlardan başka bir şey olmadığı düşünülen söylenemez dehşetler... neşeli ve keyifle dans ediyor."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:64
translate tr qst_TwoEmperors_2_08557dd6:

    # "In the corner as they danced still, that same stern ethereal woman stood unfazed, arms folded as she watched the scene unfold before her."
    "Hala dans ederlerken köşede, aynı sert uhrevi kadın sarsılmamış durdu, kolları katlanmış, önünde gelişen sahneyi izledi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:65
translate tr qst_TwoEmperors_2_62acc847:

    # "I could barely pull my eyes away from her beauty till I found Markus' claw on my shoulder as he leaned over to whisper to me."
    "Gözlerimi onun güzelliğinden zar zor ayırabiliyordum, ta ki Markus'un pençesini omzumda bulana dek, bana fısıldamak için eğildi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:66
translate tr qst_TwoEmperors_2_758541a6:

    # MARKUS "We should leave."
    MARKUS "Gitmeliyiz."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:67
translate tr qst_TwoEmperors_2_7398bf84:

    # "I nodded, and the two of us crawled our way backwards away from the strange party and made our way back the way we came."
    "Başımı salladım, ve ikimiz garip partiden uzaklaşarak geriye emekledik ve geldiğimiz yoldan geri döndük."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:71
translate tr qst_TwoEmperors_2_7d97d050:

    # UNKNOWN "...I see we continue to dance on the edge of oblivion."
    UNKNOWN "...Görüyorum ki yok oluşun eşiğinde dans etmeye devam ediyoruz."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:73
translate tr qst_TwoEmperors_2_d3f17625:

    # UNKNOWN "{i}...I trust you saw them?{/i}"
    UNKNOWN "{i}...Onları gördüğüne güveniyorum?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:75
translate tr qst_TwoEmperors_2_b548957e:

    # UNKNOWN "Of course."
    UNKNOWN "Elbette."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:76
translate tr qst_TwoEmperors_2_556a9aef:

    # UNKNOWN "{i}Then you know what to do, girl.{/i}"
    UNKNOWN "{i}O zaman ne yapacağını biliyorsun, kız.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:78
translate tr qst_TwoEmperors_2_c790737a:

    # UNKNOWN "Of course, High Mother."
    UNKNOWN "Elbette, Yüce Ana."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:81
translate tr qst_TwoEmperors_2_85f74344:

    # "As we made our way hastily back, the jovial sounds of the party became more and more distant behind us."
    "Aceleyle geri dönerken, partinin neşeli sesleri arkamızda giderek daha uzak oldu."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:82
translate tr qst_TwoEmperors_2_cbc2033f:

    # MARKUS "Fucking hells... Now there's {i}two{/i} Emperors?"
    MARKUS "Lanet cehennemler... Şimdi {i}iki{/i} mi İmparator var?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:83
translate tr qst_TwoEmperors_2_f6a04ec0:

    # MARKUS "One was enough!"
    MARKUS "Bir tane yeterdi!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:84
translate tr qst_TwoEmperors_2_a39f2156:

    # MARKUS "We need to tell the others what we've seen."
    MARKUS "Diğerlerine gördüklerimizi söylemeliyiz."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:86
translate tr qst_TwoEmperors_2_8a11ccd4:

    # MARKUS "The Demorai... They-"
    MARKUS "Demorai... Onlar—"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:87
translate tr qst_TwoEmperors_2_e15d6484:

    # UNKNOWN "{i}Talk?{/i}"
    UNKNOWN "{i}Konuşuyor mu?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:100
translate tr qst_TwoEmperors_2_f5b08b87:

    # "The two of us spun around, claws ready as we stared down at the same ethereal beauty I had seen earlier."
    "İkimiz döndük, pençeler hazır, daha önce gördüğüm aynı uhrevi güzelliğe bakarken."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:101
translate tr qst_TwoEmperors_2_06ae9a6c:

    # MC "How did you-"
    MC "Nasıl—"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:102
translate tr qst_TwoEmperors_2_8a42a2c0:

    # UNKNOWN "Please... You make pitiful spies."
    UNKNOWN "Lütfen... Acınası casuslar oluyorsunuz."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:103
translate tr qst_TwoEmperors_2_25cde490:

    # MC "What do you want, Demorai?"
    MC "Ne istiyorsun, Demorai?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:104
translate tr qst_TwoEmperors_2_537bfc02:

    # "The girl laughed."
    "Kız güldü."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:105
translate tr qst_TwoEmperors_2_eb3d71ec:

    # UNKNOWN "My name is Sypha... Sypha of House Lamont."
    UNKNOWN "Adım Sypha... Hanedan Lamont'tan Sypha."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:106
translate tr qst_TwoEmperors_2_28fc5efd:

    # MC "House... {i}Lamont?{/i}"
    MC "Hanedan... {i}Lamont mu?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:107
translate tr qst_TwoEmperors_2_4ab09aa4:

    # "The Demorai known as Sypha pointed first towards me."
    "Sypha olarak bilinen Demorai önce bana işaret etti."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:108
translate tr qst_TwoEmperors_2_6402b508:

    # SYPHA @ laugh "And you are [player_name!t]."
    SYPHA @ laugh "Ve sen [player_name!t]'sin."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:109
translate tr qst_TwoEmperors_2_8a002215:

    # "Then, she pointed towards Markus."
    "Sonra, Markus'a işaret etti."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:111
translate tr qst_TwoEmperors_2_ea5290d0:

    # SYPHA @ laugh "And you are Markus."
    SYPHA @ laugh "Ve sen de Markus'sun."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:112
translate tr qst_TwoEmperors_2_5b597001:

    # MC "You... Know who we are?"
    MC "Sen... Kim olduğumuzu biliyor musun?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:113
translate tr qst_TwoEmperors_2_f10011c4:

    # SYPHA @ smug "{i}I know many things.{/i}"
    SYPHA @ smug "{i}Birçok şey biliyorum.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:114
translate tr qst_TwoEmperors_2_49fb5000:

    # "The two of us nervously glanced towards each other, how was our secrecy so easily exposed?"
    "İkimiz sinirle birbirimize baktık, gizliliğimiz nasıl bu kadar kolay açığa çıkmıştı?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:115
translate tr qst_TwoEmperors_2_39d14c74:

    # SYPHA @ talk "Now, you should come with me if you want to make it out of this place alive."
    SYPHA @ talk "Şimdi, bu yerden canlı çıkmak istiyorsan benimle gelmelisin."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:117
translate tr qst_TwoEmperors_2_89f19a5d:

    # MARKUS "No chance, Demorai."
    MARKUS "Asla olmaz, Demorai."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:118
translate tr qst_TwoEmperors_2_ff6edd96:

    # "Markus readied himself for battle."
    "Markus kendini savaşa hazırladı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:119
translate tr qst_TwoEmperors_2_8a368e42:

    # SYPHA @ angry "There are hordes of guards now stationed outside the entrance which you came in through."
    SYPHA @ angry "Şimdi girişin dışında, içinden girdiğin kapının önünde muhafız sürüleri konuşlandı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:120
translate tr qst_TwoEmperors_2_c4a8b650:

    # "Sypha shrugged."
    "Sypha omuz silkti."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:121
translate tr qst_TwoEmperors_2_be59f236:

    # SYPHA @ think "Perhaps you will be able to fight your way through them all, perhaps not."
    SYPHA @ think "Belki hepsinin arasından dövüşerek geçebilirsin, belki geçemezsin."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:122
translate tr qst_TwoEmperors_2_be3ae20d:

    # SYPHA @ talk "But if you follow me, I can lead you out safely."
    SYPHA @ talk "Ama beni takip edersen, seni güvenle dışarı çıkarabilirim."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:123
translate tr qst_TwoEmperors_2_9c56adeb:

    # MC "Why in all of the hells would we trust you?"
    MC "Neden tüm cehennemler adına sana güvenelim?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:124
translate tr qst_TwoEmperors_2_fe829bce:

    # "Sypha smiled."
    "Sypha gülümsedi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:125
translate tr qst_TwoEmperors_2_084492fa:

    # SYPHA @ smug "...You really don't have any idea about what's {i}really{/i} going on, do you?"
    SYPHA @ smug "...Gerçekten nelerin {i}gerçekten{/i} olduğu hakkında hiçbir fikrin yok, değil mi?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:126
translate tr qst_TwoEmperors_2_ca8c137f:

    # "Once again me and Markus shared another glance at each other, unsure of how to proceed."
    "Bir kez daha ben ve Markus nasıl ilerleyeceğimizden emin olmayarak birbirimize başka bir bakış paylaştık."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:127
translate tr qst_TwoEmperors_2_10486110:

    # SYPHA @ happy "Let us just say that I am a friend."
    SYPHA @ happy "Sadece bir dost olduğumu söyleyelim."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:128
translate tr qst_TwoEmperors_2_e3aab580:

    # SYPHA @ think "And the situation you two have found yourself in is vastly more complicated than you could ever imagine."
    SYPHA @ think "Ve siz ikinizin kendinizi içinde bulduğu durum hayal edebileceğinizden çok daha karmaşık."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:129
translate tr qst_TwoEmperors_2_221a3ffd:

    # "Behind us, we heard the sounds of footsteps drawing ever closer."
    "Arkamızda, giderek daha yakına gelen ayak seslerini duyduk."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:130
translate tr qst_TwoEmperors_2_3679e5dc:

    # SYPHA @ talk "I imagine all that fighting while you're both stuck in that tunnel will only draw the attention of more Demorai though."
    SYPHA @ talk "Tahmin ediyorum ki ikiniz o tünelde sıkışmışken tüm o dövüşme sadece daha fazla Demorai'nin dikkatini çeker."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:131
translate tr qst_TwoEmperors_2_06bf9efc:

    # SYPHA @ angry "Won't be very pleasant... Squeezed in shoulder to shoulder like that, desperately trying to fight your way out."
    SYPHA @ angry "Pek hoş olmaz... Omuz omuza sıkışmış halde, çaresizce dışarı dövüşerek çıkmaya çalışmak."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:132
translate tr qst_TwoEmperors_2_739f3509:

    # SYPHA @ talk "Probably turn into a real bloodbath."
    SYPHA @ talk "Muhtemelen gerçek bir kan banyosuna dönüşür."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:133
translate tr qst_TwoEmperors_2_e97731b7:

    # "The sound of footsteps continued to grow louder as me and Markus remained frozen in indecision, my heart racing."
    "Ayak sesleri büyümeye devam etti, ben ve Markus kararsızlıkta donmuş kaldık, kalbim yarıştı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:134
translate tr qst_TwoEmperors_2_d8783583:

    # SYPHA @ angry "Mmm, sounds like times running out... Make your choice."
    SYPHA @ angry "Mmm, zaman tükeniyor gibi... Seçimini yap."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:135
translate tr qst_TwoEmperors_2_468880d2:

    # MARKUS "It's a trick [player_name!t]! She's just trying to lead us astray!"
    MARKUS "Bu bir numara [player_name!t]! Sadece bizi yoldan çıkarmaya çalışıyor!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:136
translate tr qst_TwoEmperors_2_4eea648d:

    # MARKUS "She'll walk us right into a fucking trap!"
    MARKUS "Bizi doğruca lanet bir tuzağa yürütecek!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:137
translate tr qst_TwoEmperors_2_f1f49466:

    # MC "(Fuck... What should I do?)"
    MC "(Siktir... Ne yapmalıyım?)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:140
translate tr qst_TwoEmperors_2_78aa8a05:

    # "Markus stared at me, jaw hung open in shock as Sypha smiled."
    "Markus bana baktı, Sypha gülümserken çenesi şokla açık kaldı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:143
translate tr qst_TwoEmperors_2_65cbaabd:

    # MARKUS "You... You can't be serious!"
    MARKUS "Sen... Sen ciddi olamazsın!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:144
translate tr qst_TwoEmperors_2_603b4759:

    # MARKUS "[player_name!t]! She's a fucking Demorai!"
    MARKUS "[player_name!t]! O lanet bir Demorai!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:145
translate tr qst_TwoEmperors_2_37812168:

    # SYPHA @ talk "Follow me, quickly!"
    SYPHA @ talk "Beni takip et, çabuk!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:150
translate tr qst_TwoEmperors_2_e70bac09:

    # "As I followed after Sypha, Markus very reluctantly followed behind, still voicing his displeasure at what a terrible idea this was."
    "Sypha'nın ardından takip ederken, Markus çok isteksizce arkadan izledi, bunun ne korkunç bir fikir olduğu konusundaki hoşnutsuzluğunu hala dile getirdi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:151
translate tr qst_TwoEmperors_2_2c0611f4:

    # "Sypha continued to lead us down another winding path, and as we followed after her, the sounds of footsteps behind us grew quieter and quieter."
    "Sypha bizi başka bir dolambaçlı yoldan götürmeye devam etti ve onu takip ederken, arkamızdaki ayak sesleri giderek daha sessizleşti."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:152
translate tr qst_TwoEmperors_2_525807a3:

    # "There was an eerie echo throughout the strange cave like tunnels as we followed her through, and for a moment, I thought perhaps this might have been a mistake."
    "Onu takip ederken garip mağara benzeri tüneller boyunca ürkütücü bir yankı vardı ve bir an, belki bunun bir hata olmuş olabileceğini düşündüm."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:153
translate tr qst_TwoEmperors_2_461e2beb:

    # "Who knows where she was really taking us?"
    "Bizi gerçekten nereye götürdüğünü kim bilir?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:154
translate tr qst_TwoEmperors_2_02f2b9ae:

    # "In my haste, I agreed to follow her, but why?"
    "Aceleyle, onu takip etmeyi kabul ettim, ama neden?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:155
translate tr qst_TwoEmperors_2_c94f965e:

    # "I had no reason to trust her, in fact, I have every reason {i}not{/i} to trust her."
    "Ona güvenmek için hiçbir nedenim yoktu, aslında, ona güvenmemek {i}için{/i} her nedenim var."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:156
translate tr qst_TwoEmperors_2_eeed5d51:

    # "And yet, I followed her all the same into the strange depths of this dark abyss world."
    "Ve yine de, aynı şekilde onu bu karanlık uçurum dünyasının garip derinliklerine kadar takip ettim."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:157
translate tr qst_TwoEmperors_2_8eca7023:

    # MC "...Why are you helping us?"
    MC "...Neden bize yardım ediyorsun?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:158
translate tr qst_TwoEmperors_2_eb84e11c:

    # SYPHA @ talk "Everything will be made clear in time."
    SYPHA @ talk "Her şey zamanla açıklığa kavuşacak."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:159
translate tr qst_TwoEmperors_2_e84e894c:

    # SYPHA @ talk "I don't have time to explain everything now."
    SYPHA @ talk "Şimdi her şeyi açıklamak için zamanım yok."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:160
translate tr qst_TwoEmperors_2_6ceb12d8:

    # MARKUS "Well what the fuck is this place even?"
    MARKUS "Pekala bu yer lanet ne peki?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:161
translate tr qst_TwoEmperors_2_f3145e93:

    # SYPHA "..."
    SYPHA "..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:162
translate tr qst_TwoEmperors_2_4f1eb2e7:

    # "Sypha didn't answer, she cast a glance over her shoulder to make sure we were still following."
    "Sypha cevap vermedi, hala takip edip etmediğimizden emin olmak için omzunun üzerinden bir bakış attı."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:163
translate tr qst_TwoEmperors_2_0b65b231:

    # "Deeper and deeper through the winding paths we tread, till finally, an opening up ahead."
    "Dolambaçlı patikalardan daha derin ve daha derin adımladık, ta ki nihayet, ileride bir açıklık."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:173
translate tr qst_TwoEmperors_2_5efbad91:

    # "Leading us out into the open desert, Sypha pointed off into the distance."
    "Bizi açık çöle çıkararak, Sypha uzak mesafeye işaret etti."

# game/data/world_quests/main/Act1/TwoEmperors/scr_2.rpy:174
translate tr qst_TwoEmperors_2_885a7f1b:

