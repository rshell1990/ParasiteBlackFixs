translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_a5ca9e15:

    # ALCOTT @ talk "But I know for us there is no seat for us at any negotiations table."
    ALCOTT @ talk "Ama biliyorum ki bizim için herhangi bir müzakere masasında yerimiz yok."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:117
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_b9e9e364:

    # ALCOTT @ talk "We are no more to them than vermin that need to be wiped out."
    ALCOTT @ talk "Onlar için biz yok edilmesi gereken haşereden fazlası değiliz."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:119
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_f3683e6e:

    # ALCOTT @ talk "I don't have all day, so speak quickly."
    ALCOTT @ talk "Bütün günüm yok, o yüzden çabuk konuş."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:123
