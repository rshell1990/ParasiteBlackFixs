translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_832d1377:

    # ALCOTT @ talk "The Demorai have zero interest in any sort of {i}negotiations{/i} while their 'Emperor' rules over them."
    ALCOTT @ talk "Demorai'nin 'İmparator'ları onları yönetirken herhangi bir tür {i}müzakereye{/i} sıfır ilgisi var."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:114
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_0a615b3b:

    # MC @ talk "But why? Why are they doing all this?"
    MC @ talk "Ama neden? Tüm bunları neden yapıyorlar?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:115
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_5ada5ffe:

    # ALCOTT @ talk "Even I do not know that..."
    ALCOTT @ talk "Onu ben bile bilmiyorum..."

