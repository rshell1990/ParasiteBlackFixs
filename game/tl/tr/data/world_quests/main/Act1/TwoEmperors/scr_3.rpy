translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_73773068:

    # ALCOTT @ talk "While we do not know much of their society, much like ours, it seems to be at least somewhat factional."
    ALCOTT @ talk "Toplumları hakkında fazla bir şey bilmesek de, bizimki gibi, en azından biraz hizipçi gibi görünüyor."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:125
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_3f6c32f7:

    # ALCOTT @ talk "{i}One{/i} of these factions has conducted secret meetings with us."
    ALCOTT @ talk "Bu hiziplerden {i}biri{/i} bizimle gizli toplantılar düzenledi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:126
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_39a762c7:

    # MC @ talk "You... {i}Meetings with the Demorai?{/i}"
    MC @ talk "Sen... {i}Demorai ile toplantılar mı?{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:127
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_cacc4648:

    # ALCOTT @ talk "{i}A faction of Demorai,{/i} yes."
    ALCOTT @ talk "{i}Bir Demorai hizbiyle,{/i} evet."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:128
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_3a49c1c8:

    # ALCOTT @ talk "And while they have been very vague on exactly what their intentions are, they have made it clear they want this war ended."
    ALCOTT @ talk "Ve tam olarak niyetlerinin ne olduğu konusunda çok muğlak olsalar da, bu savaşın bitmesini istediklerini açıkça belirttiler."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:131
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_d94b4801:

    # ALCOTT @ talk "I said {i}while{/i} their Emperor rules there is no room for negotiation."
    ALCOTT @ talk "Ben, İmparatorları yönetirken müzakerelere yer olmadığını söyledim {i}iken{/i}."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:132
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_402dde06:

    # MC @ think "Wait... Does that mean they want-"
    MC @ think "Bekle... Bu onların istediği—"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:133
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_9389c8ee:

    # ALCOTT @ talk "I do not know for sure, but before, we have privately assisted each other in matters of intelligence."
    ALCOTT @ talk "Kesin olarak bilmiyorum, ama daha önce, istihbarat konularında özel olarak birbirimize yardım ettik."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:134
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_b81b0a56:

    # ALCOTT @ talk "And while they are not our allies by any stretch of the imagination... I do believe they perhaps have their own designs outside of their dark Emperors plans."
    ALCOTT @ talk "Ve hayal gücünün hiçbir esnemesiyle müttefikimiz olmasalar da... Belki de kara İmparatorlarının planlarının dışında kendi tasarımları olduğuna inanıyorum."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:136
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_a6618470:

    # ALCOTT @ talk "We don't know fully."
    ALCOTT @ talk "Tam olarak bilmiyoruz."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:137
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_9b21440b:

    # ALCOTT @ talk "All I have is one contact to communicate with them through."
    ALCOTT @ talk "Tek sahip olduğum, onlarla iletişim kurmak için bir temas."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:138
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_6eb471bf:

    # ALCOTT @ talk "And no, I'm not sharing who the contact is, before you ask."
    ALCOTT @ talk "Ve hayır, sormadan önce, temasın kim olduğunu paylaşmıyorum."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:141
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_dbc0a2fa:

    # "Alcott smiled, but it had no warmth to it."
    "Alcott gülümsedi, ama sıcaklığı yoktu."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:142
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_3b67a2ce:

    # ALCOTT @ smile "{i}...My reasons are my own.{/i}"
    ALCOTT @ smile "{i}...Sebeplerim benim kendime.{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:143
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_226f494e:

    # ALCOTT @ talk "Now, you've served the realm well, here, your coin as promised."
    ALCOTT @ talk "Şimdi, diyarı iyi hizmet ettin, işte, söz verildiği gibi paran."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:145
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_e87d4ae5:

    # ALCOTT @ talk "Oh, and suffice to say..."
    ALCOTT @ talk "Ah, ve yeter ki söyleyeyim..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:146
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_bcd2aa9e:

    # ALCOTT @ talk "Nothing I have said leaves this room, are we clear?"
    ALCOTT @ talk "Söylediğim hiçbir şey bu odayı terk etmez, açık mıyız?"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:147
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_850c7dda:

    # ALCOTT @ talk "There would be {i}severe{/i} consequences for that."
    ALCOTT @ talk "Bunun için {i}ciddi{/i} sonuçlar olurdu."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:148
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_51f735a3:

    # "Understanding the implication, I nodded."
    "İmayı anlayarak, başımı salladım."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:149
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_856a2fed:

    # MC @ talk "Yes... Emperor."
    MC @ talk "Evet... İmparator."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:150
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_32dc7ef4:

    # ALCOTT @ talk "Now, you are dismissed."
    ALCOTT @ talk "Şimdi, izniniz verildi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:153
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_b4d63e3d:

    # "Deciding it unwise to stay any longer, I turned to leave and was escorted out of the Fort by the guards."
    "Daha fazla kalmanın akıllıca olmadığına karar vererek, gitmek için döndüm ve muhafızlar tarafından Kale'den dışarı refakat edildim."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:154
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_40224433:

    # MC "(I need to meet with Markus at the {i}Iron Unicorn{/i} later.)"
    MC "(Sonra {i}Demir Tekboynuz'da{/i} Markus ile buluşmam gerekiyor.)"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:155
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_bc0cbfce:

    # MC "(I need to tell him what I know.)"
    MC "(Ona bildiklerimi söylemeliyim.)"

translate tr strings:

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:103
    old "So all this time you've been lying to people!?"
    new "Yani tüm bu zaman boyunca insanlara yalan mı söylüyordunuz!?"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:110
    old "But this means we can talk to the Demorai! Perhaps even negotiate a ceasefire or something!"
    new "Ama bu Demorai ile konuşabileceğimiz anlamına geliyor! Belki bir ateşkes veya bir şey müzakere edebiliriz!"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:118
    old "I still have more questions!"
    new "Hala daha fazla sorum var!"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:121
    old "How did you know?"
    new "Nasıl bildin?"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:130
    old "I thought you said there was no room for negotiation?"
    new "Müzakerelere yer olmadığını söylememiş miydin?"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:135
    old "Who is this faction you speak of?"
    new "Bahsettiğin bu hizip kim?"

    # game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:140
    old "Why are you telling me all this?"
    new "Tüm bunları bana neden söylüyorsun?"

