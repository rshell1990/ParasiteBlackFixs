    MC @ surprised "Ama... Demorai... Onların olması gerekmiyor—"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:98
translate tr qst_TwoEmperors_3_guardDebrief_2851dedb:

    # ALCOTT @ angry "As far as most people are concerned, the Demorai are just savage beasts ready to rip and tear."
    ALCOTT @ angry "Çoğu insana göre, Demorai sadece yırtıp koparmaya hazır vahşi canavarlardır."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:99
translate tr qst_TwoEmperors_3_guardDebrief_e7ea30f8:

    # ALCOTT @ talk "It is best for everyone's sake we keep it that way."
    ALCOTT @ talk "Bunu öyle tutmak herkesin iyiliği için en iyisi."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:100
translate tr qst_TwoEmperors_3_guardDebrief_e22de872:

    # ALCOTT @ talk "Muddying the waters only invites unnecessary divisive discussions."
    ALCOTT @ talk "Suları bulandırmak sadece gereksiz bölücü tartışmalara davet eder."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:105
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_8b289247:

    # ALCOTT @ talk "It is a soft lie that the Demorai are unintelligible savages."
    ALCOTT @ talk "Demorai'nin anlaşılmaz vahşiler olduğu yumuşak bir yalandır."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:106
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_dc64c7cf:

    # ALCOTT @ angry "Make no mistake, intelligent or not, their only goal is to see our destruction."
    ALCOTT @ angry "Yanlış anlama, zeki ya da değil, tek hedefleri bizim yok oluşumuzu görmektir."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:107
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_1eaa1316:

    # ALCOTT @ talk "We must keep that {i}ethical debate{/i} door shut, for questioning our means will only lead us astray."
    ALCOTT @ talk "O {i}etik tartışma{/i} kapısını kapalı tutmalıyız, çünkü araçlarımızı sorgulamak bizi sadece yoldan çıkarır."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:108
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_509e5fae:

    # ALCOTT @ talk "We must focus on military victory only; we cannot afford to be distracted and risk dividing ourselves further."
    ALCOTT @ talk "Sadece askeri zafere odaklanmalıyız; dikkatimizin dağılmasına ve kendimizi daha fazla bölme riskine giremeyiz."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:111
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_136c0ac1:

    # ALCOTT @ joy "Ha!"
    ALCOTT @ joy "Ha!"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:112
translate tr qst_TwoEmperors_3_guardDebrief_rootMenu_3b36fad1:

    # ALCOTT @ angry "Listen to me now, and listen good, boy."
    ALCOTT @ angry "Beni şimdi dinle, ve iyi dinle, oğlan."

