translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_501706f4:

    # YARRICK @ talk "When you hear the trumpet and the roar of the crowd, it's time."
    YARRICK @ talk "Borazanı ve kalabalığın kükremesini duyduğunda, zamanı geldi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:623
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_35bf5a71:

