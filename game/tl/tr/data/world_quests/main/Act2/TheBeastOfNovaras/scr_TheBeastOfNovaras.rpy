translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_180588cc:

    # SAVAGE_KAIN "When I'm done carving up whatever poor bastard they throw at me, it's you and me."
    SAVAGE_KAIN "Bana attıkları zavallı piçi doğradıktan sonra, sıra sen ve bende."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:572
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_d5457160:

