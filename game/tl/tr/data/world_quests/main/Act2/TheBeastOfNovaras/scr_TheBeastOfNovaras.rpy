translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_2c7e9a02:

    # "The noise was unlike anything I had ever felt, like standing at the heart of a storm."
    "Gürültü daha önce hissettiğim hiçbir şeye benzemiyordu, bir fırtınanın kalbinde durmak gibi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:651
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_8858e26a:

    # HAMUN_ARENA_ANNOUNCER "BUT MOST OF ALL…"
    HAMUN_ARENA_ANNOUNCER "AMA HEPSİNDEN ÖNEMLİSİ…"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:652
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_ddbf8956:

    # HAMUN_ARENA_ANNOUNCER "They say the Beast of Novaras would bless our sands!"
    HAMUN_ARENA_ANNOUNCER "Novaras'ın Canavarı'nın kumlarımızı kutsayacağını söylüyorlar!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:653
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_dbbbcc7e:

    # HAMUN_ARENA_ANNOUNCER "And today... You will tell your children you were here when history was forged!"
    HAMUN_ARENA_ANNOUNCER "Ve bugün... Çocuklarınıza tarih dövülürken burada olduğunuzu söyleyeceksiniz!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:654
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_dff32b96:

    # HAMUN_ARENA_ANNOUNCER "WHEN THE BEAST BECAME A GOD OF THE ARENA!"
    HAMUN_ARENA_ANNOUNCER "CANAVAR ARENA'NIN BİR TANRISI OLDUĞUNDA!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:655
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_91f5f1ea:

    # HAMUN_ARENA_ANNOUNCER "…OR DIED TRYING!"
    HAMUN_ARENA_ANNOUNCER "…YA DA DENERKEN ÖLDÜ!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:656
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_e725f414:

    # "I stepped into the sun."
    "Güneşe adım attım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:657
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_52147403:

    # "The desert heat burned against my skin as thousands of eyes devoured me."
    "Binlerce göz beni yuttu, çöl sıcağı tenime yandı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:658
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_497ae8d7:

    # "A freak, a monster, a saviour. All things at once, and none of them."
    "Bir ucube, bir canavar, bir kurtarıcı. Hepsi aynı anda, ve hiçbiri."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:659
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_08cc94f5:

    # "The arena was vast, grander than any pit I'd ever known."
    "Arena uçsuz bucaksızdı, bildiğim her çukurdan daha görkemliydi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:660
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_1e6d9b15:

    # "More gates screeched open."
    "Daha fazla kapı gıcırdayarak açıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:662
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_1bf941cc:

    # "Markus shuffled uneasily, eyes wide at the crowd."
    "Markus huzursuzca ayak sürüdü, gözleri kalabalığa kocaman açılmış."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:663
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_eee48055:

    # "His eyes nervously meeting mine briefly as the crowd roared once more."
    "Kalabalık bir kez daha kükrerken gözleri kısaca benimkilerle endişeyle buluştu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:665
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_adf3885e:

    # "Sypha basked in their cheers, smiling, blowing kisses."
    "Sypha tezahüratlarında güneşlendi, gülümsedi, öpücükler attı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:667
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_5b9941d8:

    # "Ves snarled as boos rained down, her glare cold enough to cut stone."
    "Ves yuhalamalar yağarken hırladı, bakışı taşı kesecek kadar soğuktu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:669
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_641e34dc:

    # "Then the announcer's voice rose higher still."
    "Sonra sunucunun sesi daha da yükseldi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:670
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_be2b8f65:

    # HAMUN_ARENA_ANNOUNCER "And if that wasn't enough... we have a most honoured guest tonight!"
    HAMUN_ARENA_ANNOUNCER "Ve bu yeterli değilmiş gibi... bu gece en onurlu bir misafirimiz var!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:671
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_cb0dc03f:

    # HAMUN_ARENA_ANNOUNCER "You know her, you love her, empires have risen and fallen at her beauty!"
    HAMUN_ARENA_ANNOUNCER "Onu tanıyorsunuz, onu seviyorsunuz, imparatorluklar onun güzelliğinde yükseldi ve düştü!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:672
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_eb5ce05f:

    # HAMUN_ARENA_ANNOUNCER "THE HERO CELESTE!"
    HAMUN_ARENA_ANNOUNCER "KAHRAMAN CELESTE!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:675
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_1e898c1f:

    # "The roar was deafening, a tsunami of sound that rattled my bones."
    "Kükreme sağır ediciydi, kemiklerimi sarsan bir ses tsunamisi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:676
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_0e20e77c:

    # "Up on the raised, ornate seats, Celeste stood."
    "Yukarıda, yükseltilmiş, süslü koltuklarda, Celeste durdu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:677
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_c4cd9cdb:

    # "Radiant, her silver hair shimmering, her smile effortless, her presence commanding even the merchant lords beside her."
    "Işıl ışıl, gümüş saçları parıldadı, gülümsemesi zahmetsiz, varlığı yanındaki tüccar lordlarına bile hükmedici."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:678
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_fc4ed75f:

    # "For a moment her eyes met mine. My breath caught. My chest tightened as though some unseen hand gripped it."
    "Bir an için gözleri benimkilerle buluştu. Nefesim tutuldu. Görünmez bir elin kavradığı gibi göğsüm sıkılaştı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:679
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_469e86e2:

    # "Celeste, {i}the{/i} Celeste, the jewel of Alderay, saviour of her own legendary party, was watching {i}me.{/i}"
    "Celeste, {i}o{/i} Celeste, Alderay'ın mücevheri, kendi efsanevi partisinin kurtarıcısı, {i}beni{/i} izliyordu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:680
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_8c761b15:

    # "Awe, terror, and something nameless flooded through me."
    "Huşu, dehşet ve isimsiz bir şey içimden taştı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:681
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_8816e17b:

    # "I felt small. I felt unworthy. And yet, for the first time, I wanted to be seen."
    "Küçük hissettim. Değersiz hissettim. Ve yine de, ilk kez, görülmek istedim."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:685
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_a2c5884d:

    # HAMUN_ARENA_ANNOUNCER "But what is a legend without his rival?"
    HAMUN_ARENA_ANNOUNCER "Ama rakibi olmayan bir efsane nedir?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:686
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_33219d5a:

    # HAMUN_ARENA_ANNOUNCER "Tonight, we bring you the perfect rival to make this match TRULY LEGENDARY!"
    HAMUN_ARENA_ANNOUNCER "Bu gece, bu maçı GERÇEKTEN EFSANEVİ yapmak için mükemmel rakibi getiriyoruz!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:687
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_c98e1382:

    # "The portcullis across the sands began to lift with the cogs grinding like the growl of a beast. Darkness loomed beyond."
    "Kumların karşısındaki portcullis, bir canavarın hırlaması gibi öğüten çarklarla yükselmeye başladı. Ötede karanlık belirdi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:689
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_21131c50:

    # "I braced. Claws curled. My heartbeat pounded with each mechanical grind."
    "Hazırlandım. Pençeler kıvrıldı. Kalp atışım her mekanik gıcırtıyla gümbürdedi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:690
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_727323b4:

    # "With a loud THUD, the cogs stopped as the portcullis was fully raised."
    "Yüksek bir GÜMBÜRTÜ ile, portcullis tamamen kaldırıldığında çarklar durdu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:692
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_3b40e804:

    # HAMUN_ARENA_ANNOUNCER "Dragged from the deserts of Ramon… a nightmare born of the old gods' wars!"
    HAMUN_ARENA_ANNOUNCER "Ramon çöllerinden sürüklenmiş… eski tanrı savaşlarından doğmuş bir kabus!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:694
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_bae4938d:

    # "A roar shrieked from the black."
    "Karanlıktan bir kükreme çığlık attı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:695
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_545482fe:

    # "High, piercing, primal."
    "Yüksek, delici, ilkel."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:697
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_548d924e:

    # "Dust shook from the walls as titanic footsteps echoed closer."
    "Devasa ayak sesleri daha yakına yankılandıkça duvarlardan toz sarsıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:698
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_0f75b6ac:

    # HAMUN_ARENA_ANNOUNCER "A beast so cursed, adventurers whisper its name with dread!"
    HAMUN_ARENA_ANNOUNCER "O kadar lanetli bir canavar ki, maceraperestler adını korkuyla fısıldar!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:699
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_2db45dc3:

    # "A massive leg stepped forward, reptilian, clawed, each talon the size of a man's arm."
    "Devasa bir bacak ileri adım attı, sürüngen, pençeli, her pençe bir adamın kolu büyüklüğünde."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:704
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_4e5ddb29:

    # "Another step, and its colossal body rolled into the light."
    "Başka bir adım, ve devasa bedeni ışığa yuvarlandı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:706
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_5ff641e0:

    # "Bronze scales glinted. Its great lashing tail gouged the sand."
    "Bronz pullar parıldadı. Büyük kırbaçlanan kuyruğu kumu oydu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:707
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_91ad1313:

    # "Three serpent heads swayed on their long necks, tongues flicking, red eyes glimmering with hunger."
    "Üç yılan başı uzun boyunlarında sallandı, dilleri çaktı, kırmızı gözleri açlıkla parıldadı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:708
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_23746d75:

    # HAMUN_ARENA_ANNOUNCER "THE CALTRACK!"
    HAMUN_ARENA_ANNOUNCER "CALTRACK!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:712
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_f891ea51:

    # "The crowd howled in frenzy as the monster reared, all three heads snapping, hissing with enough force to whip the air."
    "Kalabalık çılgınlıkla uludu, canavar şaha kalktı, üç başı da havayı kırbaçlayacak kadar kuvvetle çıt çıt etti, tısladı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:713
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_c2f40ffc:

    # "The heat of its breath washed over me..."
    "Nefesinin sıcağı üzerimden yıkandı..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:714
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_2cd21fb7:

    # "Sulphur and blood, rancid and suffocating."
    "Kükürt ve kan, kokuşmuş ve boğucu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:715
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_bc78bb04:

    # "Dust swirled at my feet, whipped up by its sheer presence."
    "Toz ayaklarımın dibinde girdaplandı, sırf varlığıyla kamçılanmış."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:716
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_c85a5624:

    # "The sun beat down. Weapons raised."
    "Güneş vurdu. Silahlar kalktı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:718
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_5b00440c:

    # "The sands would drink blood this day."
    "Kumlar bu gün kan içecekti."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:719
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_43390d5d:

    # "...Ours, or its."
    "...Bizimki, ya da onunki."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:720
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_0fe995f4:

    # "And then… it struck!"
    "Ve sonra… saldırdı!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:729
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_8400cac0:

    # "The beast roared, its heads swaying as it fell, crashing down onto the hot sands."
    "Canavar kükredi, başları sallandı, düştü, sıcak kumlara çakıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:731
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_b5dfffd6:

    # "The crowd cheered in frenzied excitement as, exhausted, I turned towards the others, nodding at Markus."
    "Kalabalık çılgınca heyecanla alkışladı, bitkin halde, diğerlerine döndüm, Markus'a baş salladım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:732
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_a984c2e0:

    # "I turned my gaze towards the lady Celeste, hoping, if a little vainly, that she would be cheering and applauding me for our efforts."
    "Bakışlarımı hanımefendi Celeste'ye çevirdim, umarak, biraz boşuna da olsa, çabalarımız için tezahürat yapıp alkışlayacağını."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:735
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_970d6fb0:

    # "...And yet, with her face buried in her hand, she seemed..."
    "...Ve yine de, yüzü eline gömülmüş halde, görünüyordu ki..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:736
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_63bba3f7:

    # "{i}Bored.{/i}"
    "{i}Sıkılmış.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:737
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_655695d6:

    # "Not bored. Not exactly."
    "Sıkılmış değil. Tam olarak değil."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:738
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_850283b2:

    # "Her shoulders trembled, not with sorrow but with a stifled laugh."
    "Omuzları titredi, kederle değil ama bastırılmış bir kahkahayla."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:739
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_eac5591e:

    # "When her hand slipped, I caught the faintest glint in her eyes."
    "Eli kaydığında, gözlerindeki en zayıf parıltıyı yakaladım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:740
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_754c03c9:

    # "Hungry, feverish."
    "Aç, ateşli."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:741
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_c8c04867:

    # "The crowd sought a hero's blessing, but Celeste's lips curved in something else entirely."
    "Kalabalık bir kahramanın kutsamasını aradı, ama Celeste'nin dudakları tamamen başka bir şeye kıvrıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:742
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_8c7b8d0b:

    # "Not joy. Not pride. A strange, dark delight she tried to hide."
    "Sevinç değil. Gurur değil. Saklamaya çalıştığı garip, karanlık bir keyif."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:743
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_210bd6c4:

    # "I was taken aback."
    "Şaşkına dönmüştüm."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:744
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_265bb6dd:

    # "After felling such a great beast, did it really not even elicit a-"
    "Böyle büyük bir canavarı devirdikten sonra, gerçekten bir—"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:745
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_3bd13251:

    # "The tail suddenly whipped out, slamming Markus against one of the stone walls."
    "Kuyruk aniden kamçıladı, Markus'u taş duvarlardan birine çarptı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:749
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_2f9553d4:

    # "He screeched in pain as the Caltrack sprung back into furious life."
    "Caltrack öfkeli hayata geri sıçrarken acıyla çığlık attı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:750
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_7d10190f:

    # "For the first time, Sypha's cool expression cracked as in a sudden panic she dodged one of the heads slamming into the sand next to her."
    "İlk kez, Sypha'nın soğukkanlı ifadesi çatladı, ani bir panikle yanındaki kuma çarpan başlardan birini atlattı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:752
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_73769de7:

    # "Ves cried out enraged as she began to hack at the thing with her axes."
    "Ves baltalarıyla şeye saldırmaya başlarken öfkeyle çığlık attı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:753
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_ef51e80e:

    # "Piercing through the thick hide of the beast, it let out a deafening screech, snapping its jaws at her, barely missing before slamming its head back to knock her to the ground."
    "Canavarın kalın derisini delerek, sağır edici bir çığlık attı, çenelerini ona kaptı, zar zor ıskaladı, sonra başını geri çarparak onu yere devirdi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:755
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_e3c26667:

    # "The audience's voice once again rose in a choir of excitement, then cracked into shrieks."
    "Seyircilerin sesi bir kez daha bir heyecan korosunda yükseldi, sonra çığlıklara çatladı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:757
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_9dd06716:

    # "The Caltrack's heads writhed into the stands, one maw snapping a man in half."
    "Caltrack'in başları tribünlere kıvrıldı, bir ağız bir adamı ikiye kaptı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:759
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_6b1b7818:

    # "Blood sprayed across the seats."
    "Kan koltuklara sıçradı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:761
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_3f328742:

    # "Children wailed."
    "Çocuklar ağlaştı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:762
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_ff2fcb4a:

    # "People shoved and clawed at each other in blind terror, trampling the fallen as they rushed for the exits."
    "İnsanlar kör terörle birbirini itip pençeledi, çıkışlara koşarken düşenleri ezdi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:763
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_691d232b:

    # "Even the presenters seemed shaken at the beast's blind fury."
    "Sunucular bile canavarın kör öfkesi karşısında sarsılmış göründü."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:764
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_ac003e39:

    # "Suddenly, the neck of one of the heads stretched forward, grabbing a spectator from the stands and thrashing him until the body broke apart like a doll."
    "Birden, başlardan birinin boynu ileri uzandı, tribünlerden bir seyirciyi kaptı ve bedeni bir oyuncak bebek gibi kopana kadar onu savurdu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:765
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_29473d6d:

    # "There was a split second of disbelief."
    "Bir anlık inanmazlık oldu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:766
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_ef1c6027:

    # "Then the crowd realized it could be {i}their{/i} blood next."
    "Sonra kalabalık sıradakinin {i}kendi{/i} kanları olabileceğini fark etti."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:767
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_7c4628f3:

    # "Cheers turned to chaos as the masses surged toward the exit gates, clogging the narrow tunnels. Dozens were crushed, pinned, screaming."
    "Tezahüratlar kitleler çıkış kapılarına doğru akarken kaosa dönüştü, dar tünelleri tıkadı. Düzinelerce ezildi, sıkıştı, çığlık attı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:768
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_f886f0e1:

    # "Total fear took over as the announcer bellowed out."
    "Sunucu böğürürken tam korku ele geçirdi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:769
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_3da310a1:

    # HAMUN_ARENA_ANNOUNCER "REMAIN CALM! THE ARENA GUARD WILL ARRIVE MOMENTARILY AND-"
    HAMUN_ARENA_ANNOUNCER "SAKİN OLUN! ARENA MUHAFIZLARI BİRAZDAN GELECEK VE—"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:770
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_bbc6d68f:

    # "A loud whip of the Caltrack's tail left a huge gash in the stone wall; at this rate, the thing would bring the whole arena down!"
    "Caltrack'in kuyruğunun yüksek bir kamçısı taş duvarda büyük bir yarık bıraktı; bu hızla, şey tüm arenayı yıkacaktı!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:771
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_cb11b859:

    # "The organizers and high lords turned to each other in a panic, snapping orders to guards who rushed uselessly about."
    "Organizatörler ve yüksek lordlar panikle birbirlerine döndü, işe yaramazca oraya buraya koşuşturan muhafızlara emirler yağdırdı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:772
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_a6b474b0:

    # "Celeste leaned forward now, elbows on her knees."
    "Celeste şimdi öne eğildi, dirsekleri dizlerinde."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:773
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_be872dc2:

    # "At first glance, her face was the mask of irritation, as though waiting for wine."
    "İlk bakışta, yüzü tahriş maskesiydi, sanki şarap bekliyormuş gibi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:774
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_0cff6a4a:

    # "But her lips were parted, just slightly, as her breath quickened."
    "Ama dudakları aralanmıştı, çok hafifçe, nefesi hızlandı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:775
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_45cda8cd:

    # "Her eyes gleaming with... {i}excitement?{/i}"
    "Gözleri... {i}heyecanla{/i} parladı mı?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:776
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_3540a22f:

    # "Or was it something else?"
    "Yoksa başka bir şey miydi?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:777
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_48abe61c:

    # "Either way, she did not act... What in the hells was she waiting for?"
    "Her iki durumda da, harekete geçmedi... Ne cehennemi bekliyordu?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:778
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_af97aa62:

    # "As the enraged heads of the Caltrack now focused on the mass of people attempting to escape, I hurled myself forward, driving my claws deep into one of the creature's feet."
    "Caltrack'in öfkeli başları şimdi kaçmaya çalışan insan kitlesine odaklandığında, kendimi ileri fırlattım, pençelerimi yaratığın ayaklarından birine derinden sapladım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:779
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_696dac13:

    # "As the blades pierced flesh, it bellowed in pain, turning its attention away from the helpless towards me."
    "Bıçaklar ete saplanırken, acıyla böğürdü, dikkatini çaresizlerden bana çevirdi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:780
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_b90a2e25:

    # "I held out, but the frenzied beast moved faster, {i}hit harder.{/i}"
    "Dayandım, ama çılgına dönmüş canavar daha hızlı hareket etti, {i}daha sert vurdu.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:783
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_8b56e889:

    # "Slammed against the wall as it used its powerful neck to smash me aside, I dropped to the floor, agony giving way to exhaustion."
    "Güçlü boynunu kullanarak beni kenara çarptığı duvara çarpıldım, yere düştüm, ıstırap tükenmeye yol verdi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:784
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_f34c4613:

    # "My ribs screamed. My vision blurred red."
    "Kaburgalarım çığlık attı. Görüşüm kırmızıya bulandı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:785
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_8024e747:

    # "I clawed at the stone, nails scraping, but my arms trembled uselessly."
    "Taşa pençeledim, tırnaklar kazıdı, ama kollarım işe yaramazca titredi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:786
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_32811b57:

    # "Blood filled my mouth as I spat onto the sand, every breath fire through broken lungs."
    "Ağzım kanla doldu, kuma tükürdüm, her nefes kırık akciğerlerden ateş."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:787
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_dd569637:

    # "Every limb, every muscle refused to move as I struggled against them."
    "Her uzuv, her kas onlara karşı mücadele ederken hareket etmeyi reddetti."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:788
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_622d2eeb:

    # "The long, elongated necks loomed over me, fangs bared and dripping, breath hot and rancid on my skin."
    "Uzun, uzamış boyunlar üzerime belirdi, dişler açık ve damladı, nefes sıcak ve tenimde kokuşmuş."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:789
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_3bdd27b2:

    # "A terrible sense of dread washed over me, not fear, but what comes after it."
    "Korkunç bir dehşet duygusu üzerimden yıkandı, korku değil, ama ondan sonra gelen."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:790
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_a3fa2ec4:

    # "{i}Acceptance.{/i}"
    "{i}Kabullenme.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:791
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_29575268:

    # "This… this really was it."
    "Bu… bu gerçekten buydu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:792
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_f72c936e:

    # "I had only narrowly escaped the jaws of death with Zanarak to find myself here."
    "Zanarak ile ölümün çenelerinden sadece kıl payı kurtulup kendimi burada bulmuştum."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:793
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_6292dec3:

    # "Once more in death's grasp, once more unable to fight."
    "Bir kez daha ölümün pençesinde, bir kez daha dövüşemez halde."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:794
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_09449849:

    # "Weak."
    "Zayıf."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:795
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_e12ce3cf:

    # "Powerless."
    "Güçsüz."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:798
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_959f33b2:

    # "WEAK."
    "ZAYIF."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:801
translate tr qst_TheBeastOfNovaras_SpecialFightBloodworks_f8ca43b7:

    # "{i}POWERLESS.{/i}"
    "{i}GÜÇSÜZ.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:808
translate tr qst_TheBeastOfNovaras_FlashbackBattleDeathLines_1774e897:

    # SHYAHTAN "{i}Organs failing...{/i}"
    SHYAHTAN "{i}Organlar iflas ediyor...{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:809
translate tr qst_TheBeastOfNovaras_FlashbackBattleDeathLines_41bb01a5:

    # SHYAHTAN "No... This was no..."
    SHYAHTAN "Hayır... Bu hayırdı..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:810
translate tr qst_TheBeastOfNovaras_FlashbackBattleDeathLines_15d5a5cb:

    # SHYAHTAN "Not what happened."
    SHYAHTAN "Olan bu değildi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:811
translate tr qst_TheBeastOfNovaras_FlashbackBattleDeathLines_5d7e6c5c:

    # SHYAHTAN "Why? Why can't I remember?"
    SHYAHTAN "Neden? Neden hatırlayamıyorum?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:812
translate tr qst_TheBeastOfNovaras_FlashbackBattleDeathLines_55ff7cac:

    # SHYAHTAN "Darkness... Darkness all around."
    SHYAHTAN "Karanlık... Her yerde karanlık."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:827
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_751e6058:

    # ZERO_ONE_FOUR_NINE "... Lord Shyahtan."
    ZERO_ONE_FOUR_NINE "... Lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:828
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_46631c27:

    # ZERO_ONE_FOUR_NINE "Your Zarpod is ready."
    ZERO_ONE_FOUR_NINE "Zarpod'un hazır."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:829
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_1a2603d2:

    # SHYAHTAN "What is the status of the siege?"
    SHYAHTAN "Kuşatmanın durumu nedir?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:830
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_209eca19:

    # ZERO_ONE_FOUR_NINE "Their capital still holds."
    ZERO_ONE_FOUR_NINE "Başkentleri hala dayanıyor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:831
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_eba210aa:

    # ZERO_ONE_FOUR_NINE "Our Terran brothers have yet to breach the walls."
    ZERO_ONE_FOUR_NINE "Terran kardeşlerimiz henüz duvarları yaramadı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:832
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_27786fe0:

    # ZERO_ONE_FOUR_NINE "It falls upon our clan to bring honor once more."
    ZERO_ONE_FOUR_NINE "Onuru bir kez daha getirmek klanımıza düşüyor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:833
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_e3618b8d:

    # SHYAHTAN "As is always the way."
    SHYAHTAN "Her zamanki yol olduğu gibi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:834
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_06e54ca1:

    # "I rose from my seat, the neural link tendrils withdrawing from my arms back into the hull of the ship."
    "Koltuğumdan kalktım, sinir bağlantı dalları kollarımdan geminin gövdesine geri çekildi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:835
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_a6e1d6db:

    # SHYAHTAN "How many of our kin stand ready to orbital drop?"
    SHYAHTAN "Akrabalarımızdan kaçı yörüngesel inişe hazır bekliyor?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:836
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_bb8ee9da:

    # ZERO_ONE_FOUR_NINE "Three thousand strong. Another ten thousand of the other clans already claw at the walls."
    ZERO_ONE_FOUR_NINE "Üç bin güçlü. Diğer klanlardan on bin daha şimdiden duvarları pençeliyor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:837
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_df2f8f41:

    # SHYAHTAN "{i}And the enemy?{/i}"
    SHYAHTAN "{i}Ve düşman?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:838
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_5e022e8b:

    # ZERO_ONE_FOUR_NINE "Thirty thousand Merlanians man the defenses. Five thousand royal guard."
    ZERO_ONE_FOUR_NINE "Otuz bin Merlanialı savunmayı yönetiyor. Beş bin kraliyet muhafızı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:839
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_319a5e66:

    # "There was a pause."
    "Bir duraklama oldu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:840
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_aee1f639:

    # ZERO_ONE_FOUR_NINE "{i}Shame… they would have sired fine warriors for us to convert.{/i}"
    ZERO_ONE_FOUR_NINE "{i}Yazık… dönüştürmemiz için güzel savaşçılar yetiştirirlerdi.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:841
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_213c13a4:

    # SHYAHTAN "Their bodies will feed the young. Death does not excuse them from service."
    SHYAHTAN "Bedenleri gençleri besleyecek. Ölüm onları hizmetten muaf tutmaz."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:842
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_cb5cb230:

    # ZERO_ONE_FOUR_NINE "Of course, my lord. Their artillery still holds the clans at bay."
    ZERO_ONE_FOUR_NINE "Elbette, lordum. Topçuları hala klanları körfezde tutuyor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:843
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_bd6f0a03:

    # ZERO_ONE_FOUR_NINE "The Tarakan requests we prioritize their rail guns."
    ZERO_ONE_FOUR_NINE "Tarakan ray toplarına öncelik vermemizi talep ediyor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:844
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_a3a15569:

    # SHYAHTAN "The reinforcements will not be necessary."
    SHYAHTAN "Takviyeye gerek kalmayacak."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:845
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_95eb463e:

    # SHYAHTAN "{b}The honor shall be ours alone.{/b}"
    SHYAHTAN "{b}Onur yalnız bizim olacak.{/b}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:846
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_22b50137:

    # ZERO_ONE_FOUR_NINE "... What are your orders, my lord?"
    ZERO_ONE_FOUR_NINE "... Emirleriniz nedir, lordum?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:847
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_d8fc21fe:

    # SHYAHTAN "Alert the others. They follow me down."
    SHYAHTAN "Diğerlerini uyar. Beni aşağı takip etsinler."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:848
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_a5fd93d9:

    # ZERO_ONE_FOUR_NINE "Yes, Lord Shyahtan."
    ZERO_ONE_FOUR_NINE "Evet, Lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:849
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_63e033c4:

    # "The officer pressed his palm to the hull."
    "Subay avucunu gövdeye bastırdı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:851
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_3fd364ff:

    # "Tendrils erupted from the walls to pierce his flesh, carrying my orders to the others."
    "Dallar duvarlardan fırlayarak etini deldi, emirlerimi diğerlerine taşıdı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:853
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_7d2c090c:

    # "I strode to the launch bay, where the fleshy maws of the Zarpods yawned open, their insides pulsing wetly with nervous anticipation."
    "Fırlatma bölmesine yürüdüm, Zarpod'ların etli ağızları açıldı, içleri sinirli beklentiyle ıslakça zonkladı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:854
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_a34ed116:

    # "I climbed inside. Its walls throbbed around me, veins glowing faintly as my tendrils sank into its flesh."
    "İçeriye tırmandım. Duvarları etrafımda çarptı, damarları dallarım etine batarken zayıfça parladı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:855
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_2de5a45d:

    # "The bond was instant: its fear, its hunger, its obedience all became mine."
    "Bağ anlıktı: korkusu, açlığı, itaati hepsi benim oldu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:856
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_3140e262:

    # SHYAHTAN "{i}Calm…{/i}"
    SHYAHTAN "{i}Sakin…{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:857
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_37c2d7fc:

    # "{i}Zarpod rumbled in response...{/i}"
    "{i}Zarpod cevap olarak gürledi...{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:858
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_dc0b2d02:

    # SHYAHTAN "Once more into battle."
    SHYAHTAN "Bir kez daha savaşa."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:863
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_f7cdf5b6:

    # "The beast roared and hurled itself into the void."
    "Canavar kükredi ve kendini boşluğa fırlattı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:864
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_e160f24e:

    # "Dozens, then hundreds followed, a swarm of living meteors plummeting toward the Merlanian world."
    "Düzinelerce, sonra yüzlerce takip etti, Merlanian dünyasına doğru hızla düşen canlı meteorlar sürüsü."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:865
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_119954dc:

    # "The atmosphere screamed as we tore through it. Heat scorched the Zarpod's hide; fire licked its body until it glowed like a star."
    "Atmosfer onu yırtarken çığlık attı. Sıcaklık Zarpod'un derisini kavurdu; ateş bir yıldız gibi parlayana kadar bedenini yaladı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:866
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_1550b613:

    # "Around me, others burned, their carcasses bursting into flaming shrapnel. But still we fell."
    "Etrafımda, diğerleri yandı, leşleri alevli şarapnel olarak patladı. Ama yine de düştük."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:867
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_af83a862:

    # "A railgun beam seared past, a line of blue death. One struck a kin to my left, annihilating him and his beast in a burst of ash."
    "Bir ray tabancası demeti yakından geçti, bir mavi ölüm hattı. Biri solumdaki bir akrabaya çarptı, onu ve canavarını bir kül patlamasında yok etti."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:868
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_4c6c0e65:

    # "Their screams joined the roar of re-entry. It did not matter."
    "Çığlıkları yeniden girişin kükremesine katıldı. Fark etmedi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:869
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_d1d140f9:

    # "{i}We had breached.{/i}"
    "{i}Yarmıştık.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:874
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_3631c7d6:

    # "The cities inner defences were little match for the speed of the Zarpod."
    "Şehrin iç savunmaları Zarpod'un hızına çok az rakipti."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:875
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_620e1748:

    # "If their orbital defences couldn't stop them, the desperate cannons built to defend against ground forces were far too slow."
    "Eğer yörüngesel savunmaları onları durduramazsa, kara kuvvetlerine karşı savunmak için inşa edilmiş çaresiz toplar çok yavaştı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:876
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_249acc3e:

    # "The city, already hanging on by a thread from the assault outside, descended into full blown chaos."
    "Şehir, zaten dışarıdaki saldırıdan iplikle asılı halde, tam patlayan kaosa indi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:877
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_b1f26c6f:

    # "My Zarpod slammed into a tower, stone shattering, fire blossoming."
    "Zarpod'um bir kuleye çarptı, taş parçalandı, ateş çiçeklendi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:878
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_c3886354:

    # "Rubble engulfed me as others crashed nearby, entire streets erased in a rain of monsters."
    "Moloz beni yuttu, diğerleri yakınlarda çakıldı, tüm sokaklar bir canavar yağmurunda silindi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:880
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_26079cbf:

    # "Through smoke and dust, yellow-skinned Merlanian soldiers scrambled, their weapons trembling as they circled, hoping we had perished in the fall."
    "Duman ve tozun arasından, sarı tenli Merlanian askerleri telaşla seğirtti, silahları titredi, düşüşte can verdiğimizi umarak daire çizdiler."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:881
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_1b228b8f:

    # "They shared anxious looks behind their visors, terrified at the strange, motionless creature before them."
    "Siperliklerinin arkasından endişeli bakışlar paylaştılar, önlerindeki garip, hareketsiz yaratıktan dehşete kapıldılar."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:882
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_ed58493e:

    # "Nervously, they took a brave step closer, and..."
    "Endişeyle, cesur bir adım daha yakına geldiler ve..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:884
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_de41726f:

    # "My Zarpod's tendrils exploded outward, skewering two, snapping their bodies like twigs."
    "Zarpod'umun dalları dışarı patladı, iki tanesini şişledi, bedenlerini dal gibi kırdı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:885
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_76eb6352:

    # "Their blood ran hot across the rubble as the beast roared triumphant."
    "Kanları molozun üzerinde sıcak aktı, canavar zaferle kükredi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:886
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_ae51adcb:

    # "Those around screamed, fleeing the scene as they watched their finest warrior's blood and guts decorate the floor."
    "Etraftakiler çığlık attı, en iyi savaşçılarının kanının ve bağırsaklarının zemini süslediğini izlerken sahneden kaçtı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:887
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_59dc5101:

    # "Their bodies in their final moments still twitched, a foot here, a trembling hand there."
    "Bedenleri son anlarında hala seğirdi, burada bir ayak, orada titreyen bir el."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:888
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_2bb9fbd3:

    # "It mattered not, next time though, I would ensure my Zarpod focused more on the heads or piercing the hearts."
    "Fark etmedi, bir dahaki sefere olsa da, Zarpod'umun kafalara veya kalpleri delmeye daha fazla odaklanmasını sağlayacaktım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:889
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_6f4baf4e:

    # "{i}Quicker that way...{/i}"
    "{i}O şekilde daha hızlı...{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:896
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_f3b1b5bb:

    # "The alarms screamed as the building burned around me."
    "Etrafımda bina yanarken alarmlar çığlık attı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:897
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_8bce8ab4:

    # "My Zarpod turned its heads toward me, expectant, grumbling."
    "Zarpod'um başlarını bana çevirdi, beklentili, homurdandı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:898
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_950ff7d8:

    # SHYAHTAN "I sense a trap outside, be ready to provide air support."
    SHYAHTAN "Dışarıda bir tuzak hissediyorum, hava desteği sağlamaya hazır ol."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:905
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_72b4cc5b:

    # "It bowed and soared skyward as I marched into the city streets, my weapon humming with hunger."
    "Eğildi ve şehir sokaklarına yürürken gökyüzüne süzüldü, silahım açlıkla uğuldadı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:911
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_56c74ac9:

    # "There on the city streets, a Merlanian patrol swarmed me."
    "Orada şehir sokaklarında, bir Merlanian devriyesi beni sardı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:912
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_f5aa81e4:

    # MERLANIAN "DEATH TO THE FALSE GODS!"
    MERLANIAN "SAHTE TANRILARA ÖLÜM!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:913
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_27ac8b96:

    # "They raised their weapons ready to fire as the battle raged all around us."
    "Silahlarını ateşe hazır kaldırdılar, savaş etrafımızda şiddetlenirken."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:916
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_095b78da:

    # "Before their rounds could hit, my Zarpod slammed in front to take the brunt of the damage for me."
    "Mermileri isabet etmeden önce, Zarpod'um hasarın darbesini benim için almak için önüme çarptı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:917
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_0e60cb8f:

    # "I plugged into the Zarpod's flesh, raising my flesheater as a few Merlanian warriors did their best to rush me."
    "Zarpod'un etine bağlandım, etoburumu kaldırdım, birkaç Merlanian savaşçısının bana hücum etmek için elinden geleni yaptığı sırada."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:919
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_dd43f9da:

    # "The swarm shrieked as it erupted, devouring them to bone in the blink of an eye."
    "Sürü patlarken çığlık attı, onları bir göz kırpmasında kemiğe kadar yuttu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:920
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_32f83ba6:

    # "The hungry bugs quickly buzzed off when they were done, off to find someone else to eat."
    "Aç böcekler işleri bittiğinde çabucak vızıldayarak uzaklaştı, yiyecek başka birini bulmaya."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:924
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_9f218650:

    # SHYAHTAN "I can take it alone from here."
    SHYAHTAN "Buradan tek başıma alabilirim."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:925
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_1e2065c8:

    # SHYAHTAN "Destroy their rail guns. I will open the gate."
    SHYAHTAN "Ray toplarını yok et. Kapıyı açacağım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:932
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_29606faf:

    # "My Zarpod launched itself upwards into the sky once more, joining the others in the attack on the city's rail guns."
    "Zarpod'um kendini bir kez daha gökyüzüne fırlattı, diğerlerine şehrin ray toplarına saldırıda katıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:934
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_b1e50cfc:

    # "Rushing towards me, more Merlanian guards desperately charged in."
    "Bana doğru hücum ederek, daha fazla Merlanian muhafızı çaresizce içeri daldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:937
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_211058d5:

    # MERLANIAN "Stop him! Open fire at will!"
    MERLANIAN "Durdurun onu! İstediğiniz gibi ateş açın!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:938
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_0e68d335:

    # SHYAHTAN "{i}Cute.{/i}"
    SHYAHTAN "{i}Şirin.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:942
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_7516928c:

    # "Overhead, I watched as some Zarpods slammed into one of the railguns, tearing the thing apart in their immense jaws as they let the wreck crash down onto the city below."
    "Tepede, bazı Zarpod'ların ray toplarından birine çarptığını, devasa çenelerinde şeyi parçaladıklarını, enkazı aşağıdaki şehrin üzerine düşürdüklerini izledim."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:943
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_86cd6962:

    # "A few of the Merlanians were still desperately trying to hold out, rallying to defend the gate to their precious capital from both the siege outside {i}and{/i} within."
    "Birkaç Merlanialı hala çaresizce dayanmaya çalışıyordu, değerli başkentlerinin kapısını hem dışarıdaki kuşatmaya {i}hem de{/i} içeriye karşı savunmak için toplandı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:944
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_664afd37:

    # "The leader among them, armored and bearing the marks of rank, screamed orders of air support: futile prayers to gods long deaf."
    "Aralarındaki lider, zırhlı ve rütbe işaretleri taşıyan, hava desteği emirleri çığlık attı: çoktan sağır tanrılara boş dualar."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:945
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_d71ba03d:

    # "He turned to me, weapon raised, and charged with a final cry."
    "Bana döndü, silahı kalkmış, son bir çığlıkla hücum etti."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:946
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_5a060713:

    # MERLANIAN "FOR THE REPUBLIC!"
    MERLANIAN "CUMHURİYET İÇİN!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:949
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_004cec4e:

    # "Before I could deliver the killing blow, a Zarpod slammed into the ground and devoured him whole."
    "Öldürücü darbeyi indiremeden, bir Zarpod yere çarptı ve onu bütün olarak yuttu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:951
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_bfc88bd5:

    # SHYAHTAN "How... {i}disappointing.{/i}"
    SHYAHTAN "Ne... {i}hayal kırıklığı yaratıcı.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:952
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_f602a0ea:

    # "What strange words he spoke. 'Republic'... I will have one of the captured explain its meaning later."
    "Ne garip sözler konuştu. 'Cumhuriyet'... Esirlerden birine anlamını sonra açıklatacağım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:954
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_730ec02a:

    # "Another foolish name for another doomed system of rule."
    "Başka bir mahkum yönetim sistemi için başka bir aptalca isim."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:958
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_436f6d45:

    # "With each conquest I learned."
    "Her fetihle öğrendim."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:959
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_1b9c4780:

    # "Kings, queens, gods, emperors... so many words, so much foolishness."
    "Krallar, kraliçeler, tanrılar, imparatorlar... çok fazla söz, çok fazla aptallık."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:960
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_7f15f82c:

    # "Why did they choose to refuse joining us Terrans?"
    "Bize Terranlara katılmayı neden reddetmeyi seçtiler?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:961
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_b1f1919a:

    # "Could they not see the fight was impossible?"
    "Dövüşün imkansız olduğunu göremediler mi?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:962
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_db10681a:

    # "Could they not see the unity we offered?"
    "Sunduğumuz birliği göremediler mi?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:963
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_f088dcd2:

    # "Once their children were made Terran like us, they understood, {i}they became one.{/i}"
    "Çocukları bizim gibi Terran yapıldığında, anladılar, {i}bir oldular.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:964
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_742a1873:

    # "It was always the same. We welcomed their lust, it was in our very nature to do so."
    "Hep aynıydı. Şehvetlerini karşıladık, bunu yapmak doğamızdaydı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:965
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_0d82393d:

    # "...And they, no matter the race, could not resist."
    "...Ve onlar, ırk ne olursa olsun, karşı koyamadı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:966
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_9f2bd1fe:

    # "A wise race accepted the end."
    "Bilge bir ırk sonu kabul etti."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:967
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_e82a6bb5:

    # "They accepted we would breed with them, that their children were perfect candidates to become Terrans, to merge with the sanja."
    "Onlarla çiftleşeceğimizi, çocuklarının Terran olmak, sanja ile birleşmek için mükemmel adaylar olduğunu kabul ettiler."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:968
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_e6a21265:

    # "Their worlds ended peacefully, joyously, as they served the Hive in mating and in rest."
    "Dünyaları barışçılca, neşeyle sona erdi, çiftleşmede ve dinlenmede Kovan'a hizmet ederken."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:969
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_03795d2e:

    # "But some uncovered our truth too early. Some chose violence."
    "Ama bazıları gerçeğimizi çok erken ortaya çıkardı. Bazıları şiddeti seçti."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:970
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_cee3c525:

    # "And when persuasion failed, violence always prevailed."
    "Ve ikna başarısız olduğunda, şiddet her zaman galip geldi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:971
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_fcc7d99d:

    # "As I watched my clansmen tear apart the last guards at the gate, the walls themselves fell."
    "Klan kardeşlerimin kapıdaki son muhafızları parçalamasını izlerken, duvarların kendisi düştü."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:972
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_ebe88814:

    # "Terrans clambered over, flooding the city in a tide of black flesh and steel."
    "Terranlar tırmandı, şehri siyah et ve çelik bir gelgitte doldurdu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:973
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_110c4481:

    # "There was nothing left now, except claim the final piece of glory."
    "Şimdi, şanın son parçasını almak dışında hiçbir şey kalmamıştı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:974
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_592cf2bc:

    # "Their leader. King, queen, it mattered not."
    "Liderleri. Kral, kraliçe, fark etmezdi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:975
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_4690d4b9:

    # "{i}I would return with their head.{/i}"
    "{i}Kafalarıyla dönecektim.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:978
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_a1792337:

    # "The last of them stood on the steps, decorative armor glinting."
    "Sonuncuları basamaklarda durdu, dekoratif zırhları parıldadı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:979
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_2df0c028:

    # "Royal guard. High guard. Whatever their name, they died the same."
    "Kraliyet muhafızı. Yüksek muhafız. İsimleri ne olursa olsun, aynı şekilde öldüler."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:980
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_66cf6782:

    # "I had expected more. But only a handful remained, the rest fled like cowards."
    "Daha fazlasını beklemiştim. Ama sadece bir avuç kaldı, geri kalanı korkaklar gibi kaçtı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:981
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_fa83589b:

    # "I would at least grant those who fought the mercy of a swift death."
    "En azından dövüşenlere hızlı bir ölümün merhametini bağışlayacaktım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:982
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_d56f962b:

    # "The deserters I would leave to the flesheaters."
    "Firarileri etoburlara bırakacaktım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:983
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_50dfb77e:

    # "Ascending the steps, I pushed open the doors to their highest temple."
    "Basamakları tırmanarak, en yüksek tapınaklarının kapılarını iterek açtım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:988
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_55c8284f:

    # "...This temple was not as expected."
    "...Bu tapınak beklendiği gibi değildi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:989
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_ec691a98:

    # "No cowering women. No warrior awaiting a last duel."
    "Sinmiş kadınlar yok. Son bir düello bekleyen savaşçı yok."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:990
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_f6897fe4:

    # "Only a vast chamber, darkness broken by the blue glow of a circular pool."
    "Sadece uçsuz bucaksız bir oda, karanlık dairesel bir havuzun mavi parıltısıyla kırıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:992
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_3cb36d55:

    # "I stepped closer. The doors sealed behind me."
    "Daha yakına adım attım. Kapılar arkamdan mühürlendi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:994
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_8e538da2:

    # MYSTERIOUS_WOMAN "All hail... Shyahtan."
    MYSTERIOUS_WOMAN "Tüm selam... Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:996
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_699dd9a7:

    # "A frail figure emerged from the shadows, cloaked, circling the pool like a carrion bird."
    "Kırılgan bir figür gölgelerden ortaya çıktı, pelerinli, havuzun etrafında leş kuşu gibi daire çizdi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:997
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_68fbf483:

    # MYSTERIOUS_WOMAN "The lord of a thousand stars, master of the Black Terran clan."
    MYSTERIOUS_WOMAN "Bin yıldızın lordu, Kara Terran klanının efendisi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:998
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_493edf5c:

    # SHYAHTAN "...Who are you, witch?"
    SHYAHTAN "...Sen kimsin, cadı?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:999
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_9141e277:

    # SHYAHTAN "How do you know my name?"
    SHYAHTAN "Adımı nasıl biliyorsun?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1000
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_c7965320:

    # MYSTERIOUS_WOMAN "Hahaha!"
    MYSTERIOUS_WOMAN "Hahaha!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1001
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_a67c7680:

    # MYSTERIOUS_WOMAN "I know many things, Shyahtan."
    MYSTERIOUS_WOMAN "Birçok şey biliyorum, Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1002
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_234d4038:

    # SHYAHTAN "Have you come to challenge me to battle?"
    SHYAHTAN "Beni savaşa davet etmeye mi geldin?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1003
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_a5c0a3cf:

    # MYSTERIOUS_WOMAN "Oh dear..."
    MYSTERIOUS_WOMAN "Ah canım..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1004
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_edadd79f:

    # MYSTERIOUS_WOMAN "Always so preoccupied with the fight before you. You cannot see the war beyond."
    MYSTERIOUS_WOMAN "Her zaman önündeki dövüşle bu kadar meşgul. Ötedeki savaşı göremiyorsun."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1005
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_14af19a0:

    # SHYAHTAN "You speak in riddles."
    SHYAHTAN "Bilmecelerle konuşuyorsun."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1006
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_024a4834:

    # SHYAHTAN "Make sense, or I will peel your cackling head from your shoulders."
    SHYAHTAN "Anlamlı konuş, yoksa kıkırdayan kelleni omuzlarından soyacağım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1007
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_3fbc8d8b:

    # MYSTERIOUS_WOMAN "I give you truth."
    MYSTERIOUS_WOMAN "Sana gerçeği veriyorum."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1008
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_b7214c04:

    # MYSTERIOUS_WOMAN "The great Shyahtan will be destroyed by the one reflected in that pool."
    MYSTERIOUS_WOMAN "Büyük Shyahtan, o havuzda yansıyan kişi tarafından yok edilecek."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1009
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_ce742105:

    # "I looked at the water, then back to her."
    "Suya baktım, sonra ona geri."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1010
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_19630258:

    # SHYAHTAN "{i}Mockery?{/i}"
    SHYAHTAN "{i}Alay mı?{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1011
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_128ebffb:

    # SHYAHTAN "Do you know what I will do to you, and the scraps of your people?"
    SHYAHTAN "Sana ve halkının artıklarına ne yapacağımı biliyor musun?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1012
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_904c64ce:

    # MYSTERIOUS_WOMAN "I speak truth. Or does the great Shyahtan fear truth?"
    MYSTERIOUS_WOMAN "Gerçeği konuşuyorum. Yoksa büyük Shyahtan gerçekten korkar mı?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1013
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_1f9327cc:

    # SHYAHTAN "Tschh!"
    SHYAHTAN "Tschh!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1015
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_10a6bde5:

    # "I looked closer into the water. The ripples stilled. The reflection cleared."
    "Suya daha yakından baktım. Dalgacıklar duruldu. Yansıma berraklaştı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1016
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_ab3063a6:

    # "{i}Only myself stared back.{/i}"
    "{i}Sadece kendim baktı.{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1022
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_453e5b30:

    # "Enraged, I slashed the pool, water spraying."
    "Öfkeyle, havuzu kestim, su sıçradı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1023
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_40f28474:

    # SHYAHTAN "WHAT MOCKERY IS THIS?"
    SHYAHTAN "BU NE ALAYDIR?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1024
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_c6bb91ca:

    # SHYAHTAN "I ONLY SEE MYSELF!"
    SHYAHTAN "SADECE KENDİMİ GÖRÜYORUM!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1027
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_8e47f22a:

    # "The figure was gone. Only her echoing laugh remained."
    "Figür gitmişti. Sadece yankılanan kahkahası kaldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1028
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_0f312c5f:

    # MYSTERIOUS_WOMAN "Rejoice, Shyahtan! The truth shall set you free of your chains!"
    MYSTERIOUS_WOMAN "Sevin, Shyahtan! Gerçek seni zincirlerinden kurtaracak!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1030
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_395a5258:

    # "I spun."
    "Döndüm."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1031
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_ef2d3e7d:

    # "Empty halls, only laughter."
    "Boş salonlar, sadece kahkaha."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1033
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_c9c5cbdb:

    # "The doors burst open as one of my clansmen stumbled in."
    "Bir klan kardeşim tökezleyerek içeri daldı, kapılar patlayarak açıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1035
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_662d561e:

    # ZERO_ONE_FOUR_NINE "Lord Shyahtan! The city is ours!"
    ZERO_ONE_FOUR_NINE "Lord Shyahtan! Şehir bizim!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1036
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_0c3bbd7f:

    # SHYAHTAN "Good."
    SHYAHTAN "Güzel."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1037
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_fb94766b:

    # ZERO_ONE_FOUR_NINE "Are you wounded, my lord? Should I prepare-"
    ZERO_ONE_FOUR_NINE "Yaralı mısınız, lordum? Hazırlamalı mıyım—"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1038
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_6a433ffe:

    # SHYAHTAN "I am fine."
    SHYAHTAN "İyiyim."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1039
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_a008082e:

    # ZERO_ONE_FOUR_NINE "My lord... What happened here?"
    ZERO_ONE_FOUR_NINE "Lordum... Burada ne oldu?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1040
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_d9acc812:

    # SHYAHTAN "..."
    SHYAHTAN "..."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1041
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_8cade88a:

    # SHYAHTAN "Nothing. The temple was empty."
    SHYAHTAN "Hiçbir şey. Tapınak boştu."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1042
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_82fa99f6:

    # SHYAHTAN "Prepare my Zarpod. We return to the Primaris."
    SHYAHTAN "Zarpod'umu hazırla. Primaris'e dönüyoruz."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1043
translate tr qst_TheBeastOfNovaras_ParasiteShipFlashback_0dc316be:

    # SHYAHTAN "{i}This world is ours...{/i}"
    SHYAHTAN "{i}Bu dünya bizim...{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1049
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_a940ec88:

    # "...The journey back to the Primaris, my most prized ship, was short."
    "...En değerli gemim Primaris'e dönüş yolculuğu kısaydı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1050
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_eb617a3a:

    # "Of eighteen hundred and ninety-six conquests, this was my one hundred and twenty-second in its name."
    "Bin sekiz yüz doksan altı fetihten, bu onun adına yüz yirmi ikincisiydi."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1051
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_7e50f849:

    # "Through the rift gates we leapt across space and time, as though reality folded just for us."
    "Yarık kapılarından uzay ve zaman boyunca sıçradık, sanki gerçeklik sadece bizim için katlandı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1052
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_fe377075:

    # "Sweet poisoned kisses or claws of steel, world by world joined the Hive."
    "Tatlı zehirli öpücükler veya çelik pençeler, dünya dünya Kovan'a katıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1053
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_7abf2db2:

    # "I often wondered the true intent of the rift gates, these ancient monoliths found on every world."
    "Sık sık yarık kapılarının gerçek niyetini merak ettim, her dünyada bulunan bu kadim monolitler."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1054
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_6e7574dd:

    # "Relics older than empires, yet still they functioned, weaving all worlds in their hidden tapestry."
    "İmparatorluklardan daha eski kalıntılar, yine de hala çalıştılar, tüm dünyaları gizli goblenlerinde dokudular."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1055
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_e0d3aa49:

    # "My Zarpod pressed through the ship's flesh, muscle and bone parting to let it nest in its berth."
    "Zarpod'um geminin etine bastırdı, kas ve kemik onu yuvasında yuvalamasına izin vermek için ayrıldı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1063
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_74710b33:

    # "I crawled out and strode to the bridge."
    "Dışarı emekledim ve köprüye yürüdüm."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1064
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_d83a381f:

    # DRAMORA @ smile "Once more, you bring honor to our clan, Lord Shyahtan."
    DRAMORA @ smile "Bir kez daha, klanımıza onur getirdin, Lord Shyahtan."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1066
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_b39d20d6:

    # "I moved closer toward Dramora, my most prized concubine."
    "En değerli cariyem Dramora'ya doğru daha yakına hareket ettim."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1067
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_9715ad8d:

    # SHYAHTAN "You were ordered to stay on Kalagon, zero-seven-nine."
    SHYAHTAN "Kalagon'da kalman emredilmişti, sıfır-yedi-dokuz."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1068
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_39a7f0c1:

    # DRAMORA "Forgive me, my lord. The Hive Lord himself wishes to congratulate you."
    DRAMORA "Affedin beni, lordum. Kovan Lordu bizzat sizi tebrik etmek istiyor."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1069
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_9e998458:

    # DRAMORA "I thought it wise to prepare for his arrival."
    DRAMORA "Onun gelişine hazırlanmanın akıllıca olduğunu düşündüm."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1070
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_29fa3d4f:

    # MC "So soon? The council has not even convened to discuss the next conquest."
    MC "Bu kadar çabuk mu? Konsey bir sonraki fethi tartışmak için bile toplanmadı."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1071
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_09530cdb:

    # DRAMORA "Apparently it is for another matter, one they would not disclose."
    DRAMORA "Görünüşe göre başka bir mesele için, açıklamadıkları bir mesele."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1072
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_1ffe3e62:

    # "She wanted to embrace me, but held back. Affection was strange for our kind, but she was half-breed. Remnants of her old self persisted."
    "Beni kucaklamak istedi, ama geri durdu. Sevgi bizim türümüz için garipti, ama o yarı kandı. Eski benliğinin kalıntıları sürdü."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1073
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_b39d1753:

    # SHYAHTAN "When does the Hive Lord arrive?"
    SHYAHTAN "Kovan Lordu ne zaman varıyor?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1074
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_90e09b71:

    # DRAMORA "Soon... his flagship joins us within the hour. I have arranged a feast, and two of our best to mate with him."
    DRAMORA "Yakında... amiral gemisi bir saat içinde bize katılıyor. Bir ziyafet ayarladım ve onunla çiftleşmeleri için en iyilerimizden ikisini."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1075
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_d3ee64fa:

    # SHYAHTAN "Bah!"
    SHYAHTAN "Bah!"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1076
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_f36e67e9:

    # SHYAHTAN "He had best come to reward me. Once again, it is my clan that secures victory while others fail."
    SHYAHTAN "En iyisi beni ödüllendirmeye gelsin. Bir kez daha, diğerleri başarısız olurken zaferi güvenceye alan benim klanım."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1077
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_9414b382:

    # DRAMORA @ smile "I couldn't agree more, my lord."
    DRAMORA @ smile "Daha fazla katılamazdım, lordum."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1078
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_71b9b322:

    # "She stepped closer, tracing her finger down my chest. Other Terrans would have dragged her away for presumption. I found her disobedience… entertaining."
    "Daha yakına adım attı, parmağını göğsümden aşağı sürttü. Diğer Terranlar onu küstahlık için sürüklerdi. Onun itaatsizliğini… eğlenceli buldum."

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1079
translate tr qst_TheBeastOfNovaras_ReturnFromMerlanians_4af985e0:

    # DRAMORA "Shall I wait in your quarters? Or send another to please you? Perhaps one of the captured females?"
    DRAMORA "Odalarında bekleyeyim mi? Yoksa seni memnun etmesi için başka birini mi göndereyim? Belki esir alınan dişilerden birini?"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1080
