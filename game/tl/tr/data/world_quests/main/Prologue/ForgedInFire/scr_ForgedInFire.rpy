# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:743
translate tr qst_ForgedInFire_Training2Teamwork_2ff1717a:

    # DUPREY "But if you don't have a warrior, a true battle brother you are dead sure in at your side,"
    DUPREY "Ama yanında bir savaşçı, gerçek bir savaş kardeşin, ölümüne emin olduğun biri yoksa,"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:744
translate tr qst_ForgedInFire_Training2Teamwork_ff502967:

    # DUPREY "One who would stand with you no matter what is coming at you..."
    DUPREY "Sana ne gelirse gelsin seninle duracak biri..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:745
translate tr qst_ForgedInFire_Training2Teamwork_95d64e38:

    # "Duprey's expression turned pale for a moment, as if his mind's eye erupted with memories."
    "Duprey'in ifadesi bir an soldu, sanki zihin gözü anılarla patladı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:746
translate tr qst_ForgedInFire_Training2Teamwork_fa17f4b8:

    # DUPREY "You {i}will be{/i} obliterated."
    DUPREY "{i}Yok olacaksınız.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:747
translate tr qst_ForgedInFire_Training2Teamwork_828b281f:

    # "Me and Markus looked at each other and nodded stoically, but Duprey's usual commanding tone snapped us out of it quick:"
    "Ben ve Markus birbirimize baktık ve stoik bir şekilde başımızı salladık, ama Duprey'in her zamanki emredici tonu bizi hızla kendine getirdi:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:748
translate tr qst_ForgedInFire_Training2Teamwork_b5b6ec4e:

    # DUPREY "None of us would want that to happen, right you maggots?!"
    DUPREY "Hiçbirimiz bunun olmasını istemezdik, değil mi sizi kurtçuklar?!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:750
translate tr qst_ForgedInFire_Training2Teamwork_41a3cf71:

    # DUPREY "Today, you will spar in teams of two!"
    DUPREY "Bugün, ikili takımlar halinde tartışacaksınız!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:751
translate tr qst_ForgedInFire_Training2Teamwork_dfb15ac9:

    # DUPREY "Partner up, and get to it!"
    DUPREY "Eşleşin, ve başlayın!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:752
translate tr qst_ForgedInFire_Training2Teamwork_6e24ff53:

    # DUPREY "...BEGIN!"
    DUPREY "...BAŞLAYIN!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:776
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_22336bc1:

    # MARKUS "Phew... You guys kicked our ass!"
    MARKUS "Phew... Kıçımızı tekmelediniz!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:777
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_d5403c39:

    # MARKUS "Let's go again now!"
    MARKUS "Hadi tekrar yapalım şimdi!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:778
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_d4066694:

    # MARKUS "I swear you won't get us this time!"
    MARKUS "Yemin ederim bu sefer bizi yakalayamazsınız!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:780
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_4303ca27:

    # "Markus and his teammate both looked at us two."
    "Markus ve takım arkadaşı ikimiz ikimize baktı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:781
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_4c68b6fe:

    # MARKUS "Come on guys, remember what Duprey said!"
    MARKUS "Hadi çocuklar, Duprey'in ne dediğini hatırlayın!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:782
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_072ed379:

    # MARKUS "Be a single force!"
    MARKUS "Tek bir kuvvet olun!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:783
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_7e6c58ca:

    # "His teammate interrupted:"
    "Takım arkadaşı araya girdi:"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:785
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_c87c6273:

    # RECRUIT "Actually... it was me who said it..."
    RECRUIT "Aslında... söyleyen bendim..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:786
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_76d4b651:

    # "I let out a laugh which echoed painfully all over my body."
    "Tüm vücudumda acıyla yankılanan bir kahkaha attım."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:787
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_33a51547:

    # MARKUS "... Whatever! Come on, let's go for another round!"
    MARKUS "... Her neyse! Hadi, bir raunt daha yapalım!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:790
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_2af51c90:

    # MARKUS "That's what I like to hear!"
    MARKUS "Duymak istediğim bu!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:791
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_102beb74:

    # MARKUS @ smile "Let's see if our 'army' defeats yours this time!"
    MARKUS @ smile "Bakalım bu sefer bizim 'ordumuz' sizinkini yenecek mi!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:795
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_82ab4d75:

    # MARKUS "Okay then."
    MARKUS "Tamam o zaman."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:796
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_1506ca74:

    # MARKUS "I've sprained my ankle anyways..."
    MARKUS "Zaten bileğimi burktum..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:799
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_3c091867:

    # "The rest of the day we have spent learning more nuances about working together as a combat unit."
    "Günün geri kalanını bir savaş birimi olarak birlikte çalışma hakkında daha fazla incelik öğrenerek harcadık."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:800
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_1da7d2b2:

    # "As we have come to realize the importance of teamwork in practice, Duprey's initial statement of it being the crucial aspect of warfare became clear as day."
    "Takım çalışmasının önemini pratikte fark ettiğimiz gibi, Duprey'in bunun savaşın hayati bir yönü olduğuna dair ilk ifadesi gün gibi açık hale geldi."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:801
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_73c0dac8:

    # "We had to {i}become{/i} the Second Scouts Division."
    "İkinci İzci Tümeni {i}olmak{/i} zorundaydık."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:806
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_5d262372:

    # DUPREY "...So, that will be it for today, Scouts."
    DUPREY "...Peki, bugün için bu kadar olacak, İzciler."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:807
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_b8c44b07:

    # DUPREY "And one more thing..."
    DUPREY "Ve bir şey daha..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:808
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_f2c412ef:

    # DUPREY "We can't be training in this cage forever,"
    DUPREY "Bu kafeste sonsuza kadar eğitim yapamayız,"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:809
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_fc3f4089:

    # "Duprey waved at the walls,"
    "Duprey duvarları işaret etti,"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:810
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_5bc59c1b:

    # DUPREY "But before we begin any real training maneuvers, I need to see just how much you lot had learned since you've got here."
    DUPREY "Ama herhangi bir gerçek eğitim manevrasına başlamadan önce, buraya geldiğinizden beri ne kadar öğrendiğinizi görmem gerek."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:811
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_37c4720a:

    # DUPREY "Hit that bunk hard for there will be a test tomorrow!"
    DUPREY "O ranzayı sıkı vurun çünkü yarın bir test olacak!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:812
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_ee4f7f5b:

    # DUPREY "Dismissed!"
    DUPREY "Dağılın!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:817
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_70c270b5:

    # "Me and Markus exchanged looks."
    "Ben ve Markus bakıştık."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:818
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_5dbd6a38:

    # MARKUS "A test, huh?"
    MARKUS "Bir test, ha?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:819
translate tr qst_ForgedInFire_Training2Teamwork_repBattle_0da95cfe:

    # MC "Whatever it is, let's go get some sleep."
    MC "Her neyse, hadi gidip biraz uyuyalım."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:836
translate tr qst_ForgedInFire_Training2NightEvent_6d3b7e65:

    # "In the dead of night, I was restless."
    "Gecenin köründe, huzursuzdum."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:841
translate tr qst_ForgedInFire_Training2NightEvent_8c266e01:

    # "Opening my eyes, I sat-upright in my bunk and looked around."
    "Gözlerimi açarak, ranzamda dimdik oturdum ve etrafa baktım."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:843
translate tr qst_ForgedInFire_Training2NightEvent_ccd5a8ea:

    # "Everyone around me was deep in sleep still, including Markus."
    "Etrafımdaki herkes hala derin uykudaydı, Markus dahil."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:844
translate tr qst_ForgedInFire_Training2NightEvent_03bec688:

    # "I sighed, rubbing my forehead as I climbed out of bed."
    "İç çektim, yataktan çıkarken alnımı ovdum."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:845
translate tr qst_ForgedInFire_Training2NightEvent_b9564fe7:

    # "{i}Just a short walk around the fort grounds{/i} I told myself..."
    "{i}Sadece kale arazisinde kısa bir yürüyüş{/i} dedim kendime..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:846
translate tr qst_ForgedInFire_Training2NightEvent_af74cbd2:

    # "I'll be back before anyone even realizes I'm gone."
    "Kimse gittiğimi fark etmeden geri döneceğim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:853
translate tr qst_ForgedInFire_Training2NightEvent_59eaf8b8:

    # "As the cold night air hit my lungs, I thought about heading back inside before I heard Captain Duprey's voice."
    "Soğuk gece havası ciğerlerime çarptığında, Kaptan Duprey'in sesini duymadan önce içeri geri dönmeyi düşündüm."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:854
translate tr qst_ForgedInFire_Training2NightEvent_4acebe14:

    # DUPREY "Thank you all for coming..."
    DUPREY "Geldiğiniz için hepinize teşekkür ederim..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:855
translate tr qst_ForgedInFire_Training2NightEvent_14ad4098:

    # MC "(Hm? What's going on?)"
    MC "(Hm? Ne oluyor?)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:856
translate tr qst_ForgedInFire_Training2NightEvent_b6dd5166:

    # MC "(It sounds like it's coming from the training yard.)"
    MC "(Eğitim alanından geliyor gibi.)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:867
translate tr qst_ForgedInFire_Training2NightEvent_f159a15b:

    # "Peering around the corner, Captain Duprey stood alongside Borras as two figures joined them."
    "Köşeden bakarken, Kaptan Duprey, Borras ile birlikte duruyordu, onlara iki figür katıldı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:870
translate tr qst_ForgedInFire_Training2NightEvent_683fa502:

    # "The first, a beautiful, yet stern and cold looking blonde in a hooded robe."
    "İlki, kapüşonlu bir cübbede güzel, ama sert ve soğuk görünümlü bir sarışın."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:871
translate tr qst_ForgedInFire_Training2NightEvent_39c09853:

    # "The other, a man of larger stature who I had not seen either."
    "Diğeri, daha iri yapılı bir adam, onu da daha önce görmemiştim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:873
translate tr qst_ForgedInFire_Training2NightEvent_c3816f8a:

    # NYX_BLONDE @ angry "Well, out with it."
    NYX_BLONDE @ angry "Pekala, söyle."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:874
translate tr qst_ForgedInFire_Training2NightEvent_829708c2:

    # NYX_BLONDE @ angry "Why did you ask us to meet here and not in my office?"
    NYX_BLONDE @ angry "Neden ofisimde değil de burada buluşmamızı istedin?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:875
translate tr qst_ForgedInFire_Training2NightEvent_0e5dab11:

    # NYX_BLONDE @ angry "I'm freezing my tits off out here you know."
    NYX_BLONDE @ angry "Burada dışarıda memelerim donuyor biliyor musun."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:876
translate tr qst_ForgedInFire_Training2NightEvent_f5d90ff9:

    # LUKKAN_THE_BIG_GUY @ happy "I could keep them warm for you if you wish."
    LUKKAN_THE_BIG_GUY @ happy "İstersen onları senin için sıcak tutabilirim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:878
translate tr qst_ForgedInFire_Training2NightEvent_8cce2042:

    # NYX_BLONDE @ angry "Lay a hand on me and you will never {i}touch{/i} anything again."
    NYX_BLONDE @ angry "Bana bir el sür ve bir daha asla bir şeye {i}dokunamazsın.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:879
translate tr qst_ForgedInFire_Training2NightEvent_ccb33939:

    # LUKKAN_THE_BIG_GUY @ happy "Feisty as always."
    LUKKAN_THE_BIG_GUY @ happy "Her zamanki gibi ateşli."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:880
translate tr qst_ForgedInFire_Training2NightEvent_7d3baf97:

    # DUPREY "I'm sorry for summoning you both at such a late hour."
    DUPREY "Sizi böyle geç bir saatte çağırdığım için üzgünüm."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:881
translate tr qst_ForgedInFire_Training2NightEvent_438696b5:

    # DUPREY "I couldn't risk the potential of spies listening in on what I had to say now."
    DUPREY "Şimdi söylemek zorunda olduğum şeyi casusların dinleme ihtimalini riske edemezdim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:882
translate tr qst_ForgedInFire_Training2NightEvent_15a278d5:

    # NYX_BLONDE @ angry "And out here is safer than my office how?"
    NYX_BLONDE @ angry "Ve burası ofisimden nasıl daha güvenli?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:883
translate tr qst_ForgedInFire_Training2NightEvent_8ea753ae:

    # DUPREY "{i}*Sigh*{/i} I recently conducted a private search across the whole fortress with only my most trusted men."
    DUPREY "{i}*İç çekiş*{/i} Geçenlerde tüm kaleyi sadece en güvendiğim adamlarımla özel bir arama yaptım."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:884
translate tr qst_ForgedInFire_Training2NightEvent_627d96fc:

    # DUPREY "I found echo crystals everywhere... including your office."
    DUPREY "Her yerde yankı kristalleri buldum... ofisiniz dahil."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:885
translate tr qst_ForgedInFire_Training2NightEvent_0e306341:

    # NYX_BLONDE @ shock "You..."
    NYX_BLONDE @ shock "Sen..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:886
translate tr qst_ForgedInFire_Training2NightEvent_2b146927:

    # NYX_BLONDE @ shock "{i}Echo crystals?{/i}"
    NYX_BLONDE @ shock "{i}Yankı kristalleri mi?{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:887
translate tr qst_ForgedInFire_Training2NightEvent_c7cc2c81:

    # NYX_BLONDE @ angry "That can't be right, I have my office checked, I-"
    NYX_BLONDE @ angry "Bu doğru olamaz, ofisimi kontrol ettiririm, ben—"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:888
translate tr qst_ForgedInFire_Training2NightEvent_7233b5ac:

    # "Duprey nodded, holding up a small, glowing yellow crystal that he tossed to the robed blonde."
    "Duprey başını salladı, küçük, parlayan sarı bir kristal tutup cübbeli sarışına fırlattı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:890
translate tr qst_ForgedInFire_Training2NightEvent_b21cd245:

    # DUPREY "I'm afraid it's so."
    DUPREY "Korkarım öyle."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:891
translate tr qst_ForgedInFire_Training2NightEvent_3e335085:

    # "The woman inspected the crystal and gritted her teeth in anger at it."
    "Kadın kristali inceledi ve öfkeyle dişlerini gıcırdattı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:892
translate tr qst_ForgedInFire_Training2NightEvent_1faccc03:

    # DUPREY "It seems our great {i}'emperor'{/i} does not hold our loyalty in high regard."
    DUPREY "Görünüşe göre büyük {i}'imparatorumuz'{/i} sadakatimizi pek de yüksek görmüyor."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:893
translate tr qst_ForgedInFire_Training2NightEvent_d6956b86:

    # "The larger man chuckled."
    "İri adam kıkırdadı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:894
translate tr qst_ForgedInFire_Training2NightEvent_cac71787:

    # LUKKAN_THE_BIG_GUY @ happy "After everything that's happened, can you truly blame him?"
    LUKKAN_THE_BIG_GUY @ happy "Bunca olan bitenden sonra, onu gerçekten suçlayabilir misin?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:895
translate tr qst_ForgedInFire_Training2NightEvent_e7113e66:

    # "The blonde woman seemed more frustrated than the others, coiling her one hand into a tight fist."
    "Sarışın kadın diğerlerinden daha sinirli görünüyordu, bir elini sıkı bir yumruğa sardı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:896
translate tr qst_ForgedInFire_Training2NightEvent_897edc9c:

    # LUKKAN_THE_BIG_GUY @ happy "Come now, this is all part of the game."
    LUKKAN_THE_BIG_GUY @ happy "Hadi ama, bunların hepsi oyunun bir parçası."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:897
translate tr qst_ForgedInFire_Training2NightEvent_da595d25:

    # NYX_BLONDE @ angry "Yes, I... I am aware."
    NYX_BLONDE @ angry "Evet, ben... Farkındayım."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:898
translate tr qst_ForgedInFire_Training2NightEvent_aed55156:

    # DUPREY "The guards only patrol this area periodically, and it's the one place no echo crystals turned up during the search."
    DUPREY "Muhafızlar bu alanda sadece periyodik olarak devriye geziyor ve bu, arama sırasında hiç yankı kristali bulunmayan tek yer."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:899
translate tr qst_ForgedInFire_Training2NightEvent_cf9fe043:

    # DUPREY "I suppose they figured the chatter of grunts wasn't worth hearing."
    DUPREY "Sanırım askerlerin gevezeliğinin duymaya değmediğine karar verdiler."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:900
translate tr qst_ForgedInFire_Training2NightEvent_4b3ecc3c:

    # DUPREY "Which is exactly why we're meeting here now."
    DUPREY "İşte bu yüzden şu anda burada buluşuyoruz."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:901
translate tr qst_ForgedInFire_Training2NightEvent_97cd58fc:

    # "The larger man raised his brow."
    "İri adam kaşını kaldırdı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:902
translate tr qst_ForgedInFire_Training2NightEvent_c4efb787:

    # LUKKAN_THE_BIG_GUY @ think "That's all well and good... But why exactly is {i}he{/i} here?"
    LUKKAN_THE_BIG_GUY @ think "Hepsi iyi hoş... Ama tam olarak neden {i}o{/i} burada?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:903
translate tr qst_ForgedInFire_Training2NightEvent_0ecda2cd:

    # "The man pointed towards Borras, whose brow furrowed at the comment."
    "Adam Borras'ı işaret etti, onun kaşları yoruma çatıldı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:904
translate tr qst_ForgedInFire_Training2NightEvent_a377fbed:

    # LUKKAN_THE_BIG_GUY @ angry "He's hardly fit to stand here with the rest of us."
    LUKKAN_THE_BIG_GUY @ angry "Bizimle burada duracak durumda değil."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:905
translate tr qst_ForgedInFire_Training2NightEvent_000b3a6c:

    # DUPREY "Officer Borras will be replacing me for command of the Second Scouts Division, within a year or so."
    DUPREY "Subay Borras, bir yıl içinde falan, İkinci İzci Tümeni'nin komutası için beni değiştirecek."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:906
translate tr qst_ForgedInFire_Training2NightEvent_ade1214e:

    # NYX_BLONDE @ shock "You're leaving?"
    NYX_BLONDE @ shock "Ayrılıyor musun?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:907
translate tr qst_ForgedInFire_Training2NightEvent_2897e861:

    # DUPREY "My time is nearly up... I'm slowing down too much."
    DUPREY "Zamanım neredeyse doldu... Çok fazla yavaşlıyorum."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:908
translate tr qst_ForgedInFire_Training2NightEvent_1d99c218:

    # "While the blonde seemed saddened to hear this, the larger man opened his palm upwards towards the sky."
    "Sarışın bunu duymaya üzgün görünürken, iri adam avcunu gökyüzüne doğru açtı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:909
translate tr qst_ForgedInFire_Training2NightEvent_c246e162:

    # LUKKAN_THE_BIG_GUY @ talk "I hope you didn't drag us out here to discuss your future retirement plans you old fuck."
    LUKKAN_THE_BIG_GUY @ talk "Umarım bizi gelecekteki emeklilik planlarını tartışmak için buraya sürüklememişsindir, seni yaşlı pislik."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:910
translate tr qst_ForgedInFire_Training2NightEvent_dd633049:

    # DUPREY "Hmph..."
    DUPREY "Hmph..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:911
translate tr qst_ForgedInFire_Training2NightEvent_07d9c1a1:

    # DUPREY "Officer Borras, hand them the reports."
    DUPREY "Subay Borras, onlara raporları ver."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:912
translate tr qst_ForgedInFire_Training2NightEvent_85fc15c1:

    # BORRAS @ talk "Yes Captain."
    BORRAS @ talk "Evet Kaptan."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:914
translate tr qst_ForgedInFire_Training2NightEvent_a550ea4e:

    # "Borras handed over a few sheets of paper towards the robed pair."
    "Borras cübbeli çifte doğru birkaç sayfa kağıt verdi."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:915
translate tr qst_ForgedInFire_Training2NightEvent_e077ed9f:

    # LUKKAN_THE_BIG_GUY @ talk "What's this?"
    LUKKAN_THE_BIG_GUY @ talk "Bu ne?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:916
translate tr qst_ForgedInFire_Training2NightEvent_cbb0024b:

    # DUPREY "A report that Alcott attempted to suppress."
    DUPREY "Alcott'un bastırmaya çalıştığı bir rapor."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:917
translate tr qst_ForgedInFire_Training2NightEvent_0873ff5f:

    # LUKKAN_THE_BIG_GUY @ think "About?"
    LUKKAN_THE_BIG_GUY @ think "Hakkında?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:918
translate tr qst_ForgedInFire_Training2NightEvent_dfb5dc62:

    # DUPREY "...{i}Zanarak has returned.{/i}"
    DUPREY "...{i}Zanarak geri döndü.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:919
translate tr qst_ForgedInFire_Training2NightEvent_dbf78d30:

    # "A great unease filled the air and I felt a shiver tingle it's way up my spine."
    "Büyük bir huzursuzluk havayı doldurdu ve omurgamda yukarı doğru gıdıklayan bir ürperti hissettim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:920
translate tr qst_ForgedInFire_Training2NightEvent_506be64d:

    # "The name crawled and dragged its way horribly across my thoughts."
    "İsim düşüncelerimde korkunç bir şekilde süründü ve sürüklendi."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:921
translate tr qst_ForgedInFire_Training2NightEvent_04766be0:

    # LUKKAN_THE_BIG_GUY @ happy "There hasn't been a sighting in years."
    LUKKAN_THE_BIG_GUY @ happy "Yıllardır bir görülme olmadı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:922
translate tr qst_ForgedInFire_Training2NightEvent_ad6d35ce:

    # NYX_BLONDE @ talk "Wasn't it reported that the beast was hunted down by the Inquisition?"
    NYX_BLONDE @ talk "Canavarın Engizisyon tarafından yakalanıp avlandığı bildirilmemiş miydi?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:923
translate tr qst_ForgedInFire_Training2NightEvent_cbbee22b:

    # DUPREY "A lie told to ease panicking nobles."
    DUPREY "Panikleyen soyluları yatıştırmak için söylenen bir yalan."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:924
translate tr qst_ForgedInFire_Training2NightEvent_38a43a2d:

    # DUPREY "While it is true the beast has vanished for the last few years, this cannot be ignored."
    DUPREY "Canavarın son birkaç yıldır ortadan kaybolduğu doğru olsa da, bu görmezden gelinemez."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:925
translate tr qst_ForgedInFire_Training2NightEvent_78892759:

    # DUPREY "The beast's return... changes things."
    DUPREY "Canavarın dönüşü... şeyleri değiştirir."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:926
translate tr qst_ForgedInFire_Training2NightEvent_7a86413b:

    # LUKKAN_THE_BIG_GUY @ talk "A specter, a boogeyman..."
    LUKKAN_THE_BIG_GUY @ talk "Bir hayalet, bir öcü..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:927
translate tr qst_ForgedInFire_Training2NightEvent_a777b442:

    # LUKKAN_THE_BIG_GUY @ talk "There are dozens of Demorai over the years that people have wrongly mistaken for being Zanarak."
    LUKKAN_THE_BIG_GUY @ talk "Yıllar boyunca insanların yanlışlıkla Zanarak sandığı düzinelerce Demorai var."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:928
translate tr qst_ForgedInFire_Training2NightEvent_086782c0:

    # "The man belligerently crossed his arms."
    "Adam kavgacı bir şekilde kollarını kavuşturdu."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:929
translate tr qst_ForgedInFire_Training2NightEvent_ee8e9a7d:

    # LUKKAN_THE_BIG_GUY @ talk "...I'm not even convinced this Zanarak was real to begin with."
    LUKKAN_THE_BIG_GUY @ talk "...Bu Zanarak'ın gerçekten var olduğuna bile ikna olmuş değilim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:930
translate tr qst_ForgedInFire_Training2NightEvent_8ebb0762:

    # DUPREY "Oh... He's as real as you and I alright."
    DUPREY "Oh... O da sen ve ben kadar gerçek, tamam mı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:931
translate tr qst_ForgedInFire_Training2NightEvent_ba99ad23:

    # DUPREY "Make no mistake about that."
    DUPREY "Bundan hiç şüphen olmasın."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:932
translate tr qst_ForgedInFire_Training2NightEvent_6b72d9c8:

    # DUPREY "...And when he comes, all of us need to be prepared."
    DUPREY "...Ve o geldiğinde, hepimizin hazır olması gerekiyor."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:933
translate tr qst_ForgedInFire_Training2NightEvent_2bce0fc0:

    # DUPREY "With, {i}or without{/i} the Emperors knowledge."
    DUPREY "İmparatorun bilgisi {i}dahilinde{/i} ya da {i}hariç{/i}."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:934
translate tr qst_ForgedInFire_Training2NightEvent_3cdbebf1:

    # NYX_BLONDE @ angry "What are you saying, Duprey?"
    NYX_BLONDE @ angry "Ne diyorsun, Duprey?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:935
translate tr qst_ForgedInFire_Training2NightEvent_59e5864b:

    # DUPREY "I'm saying, Alcott can bury his head in the fucking sand and play politics all he wants to try and appease wet-fart nobles."
    DUPREY "Diyorum ki, Alcott lanet kafasını kuma gömüp, sulu osuruk soyluları yatıştırmak için istediği kadar politika oynayabilir."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:936
translate tr qst_ForgedInFire_Training2NightEvent_fcc3f2c9:

    # DUPREY "{i}But we need to be prepared for what's to come whether this knowledge is made public or not.{/i}"
    DUPREY "{i}Ama bu bilgi halka açıklansın ya da açıklanmasın, gelecek olana hazır olmamız gerek.{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:937
translate tr qst_ForgedInFire_Training2NightEvent_18e7a24a:

    # NYX_BLONDE @ talk "Duprey... You need to tread carefully with this."
    NYX_BLONDE @ talk "Duprey... Bu konuda dikkatli davranman gerek."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:938
translate tr qst_ForgedInFire_Training2NightEvent_5b839082:

    # NYX_BLONDE @ talk "How exactly did {i}you{/i} manage to get your hands on this report anyway?"
    NYX_BLONDE @ talk "Bu raporu tam olarak {i}sen{/i} nasıl eline geçirdin zaten?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:939
translate tr qst_ForgedInFire_Training2NightEvent_a2aca459:

    # BORRAS @ talk "By pure chance."
    BORRAS @ talk "Tamamen şans eseri."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:940
translate tr qst_ForgedInFire_Training2NightEvent_a174e1ce:

    # "Borras stepped forward."
    "Borras ileri adım attı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:941
translate tr qst_ForgedInFire_Training2NightEvent_913c0dc3:

    # BORRAS @ talk "I was on a normal patrol through the Valley of Death when I stumbled upon a small, slaughtered convoy."
    BORRAS @ talk "Ölüm Vadisi'nde normal bir devriye gezerken katledilmiş küçük bir kervana rastladım."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:942
translate tr qst_ForgedInFire_Training2NightEvent_787647a3:

    # BORRAS @ talk "Amongst their dead was an Inquisitor, who with his dying breath handed me this report."
    BORRAS @ talk "Ölüleri arasında bir Engizitör vardı, ölmek üzereyken bana bu raporu verdi."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:943
translate tr qst_ForgedInFire_Training2NightEvent_a7d9dd7a:

    # LUKKAN_THE_BIG_GUY @ talk "The dying words of a delusional Inquisitor on death's door mean very little."
    LUKKAN_THE_BIG_GUY @ talk "Ölümün kapısındaki sayıklayan bir Engizitörün son sözleri çok az şey ifade eder."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:944
translate tr qst_ForgedInFire_Training2NightEvent_46254da9:

    # BORRAS @ talk "There was other reports..."
    BORRAS @ talk "Başka raporlar da vardı..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:945
translate tr qst_ForgedInFire_Training2NightEvent_f3335e6e:

    # LUKKAN_THE_BIG_GUY @ think "What?"
    LUKKAN_THE_BIG_GUY @ think "Ne?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:946
translate tr qst_ForgedInFire_Training2NightEvent_825a1215:

    # BORRAS @ talk "Suppressed as soon as they arrive, but more and more scant reports from our men on the fringes have reported seeing it."
    BORRAS @ talk "Gelir gelmez bastırılıyor, ama sınırlardaki adamlarımızdan giderek daha fazla kıt rapor onu gördüğünü bildiriyor."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:947
translate tr qst_ForgedInFire_Training2NightEvent_0d7eadc0:

    # "Both the woman and man were troubled the more they heard."
    "Hem kadın hem de adam duydukça daha çok rahatsız oldu."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:948
translate tr qst_ForgedInFire_Training2NightEvent_f2428e23:

    # DUPREY "From now on, the three of us need to work closer together."
    DUPREY "Bundan sonra, üçümüzün daha yakın çalışması gerekiyor."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:949
translate tr qst_ForgedInFire_Training2NightEvent_a899d6c2:

    # NYX_BLONDE @ angry "The city guard is barely holding on as it is, what exactly do you expect me to do?"
    NYX_BLONDE @ angry "Şehir muhafızları zaten zor dayanıyor, tam olarak ne yapmamı bekliyorsun?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:950
translate tr qst_ForgedInFire_Training2NightEvent_b10a0545:

    # DUPREY "Whatever you have to do when the time comes."
    DUPREY "Zamanı geldiğinde ne yapman gerekiyorsa."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:951
translate tr qst_ForgedInFire_Training2NightEvent_6afc1660:

    # "Duprey seemed to be working himself up into a feverish plea."
    "Duprey kendini ateşli bir yakarışa kaptırıyor gibiydi."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:952
translate tr qst_ForgedInFire_Training2NightEvent_104f25e1:

    # DUPREY "These little camps everyone's set up is leaving us more divided than ever, it'll be the ruin of us all!"
    DUPREY "Herkesin kurduğu bu küçük kamplar bizi her zamankinden daha fazla bölüyor, hepimizin mahvı olacak!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:953
translate tr qst_ForgedInFire_Training2NightEvent_2e21a987:

    # DUPREY "We need to unite and pledge to each other that when the time comes-"
    DUPREY "Birleşmeli ve birbirimize söz vermeliyiz ki zamanı geldiğinde-"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:954
translate tr qst_ForgedInFire_Training2NightEvent_59c8c819:

    # LUKKAN_THE_BIG_GUY @ talk "I promise you nothing, Duprey."
    LUKKAN_THE_BIG_GUY @ talk "Sana hiçbir şey vaat etmiyorum, Duprey."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:955
translate tr qst_ForgedInFire_Training2NightEvent_e629b28d:

    # "The broad man's words cut through Duprey's like ice."
    "Geniş adamın sözleri Duprey'ninkileri buz gibi kesti."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:956
translate tr qst_ForgedInFire_Training2NightEvent_b4c2c3b7:

    # LUKKAN_THE_BIG_GUY @ talk "...But I shall look into these reports myself."
    LUKKAN_THE_BIG_GUY @ talk "...Ama bu raporları kendim araştıracağım."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:957
translate tr qst_ForgedInFire_Training2NightEvent_ebf4078c:

    # LUKKAN_THE_BIG_GUY @ talk "And depending on what I find, {i}perhaps{/i} there will be more to discuss."
    LUKKAN_THE_BIG_GUY @ talk "Ve ne bulduğuma bağlı olarak, {i}belki{/i} tartışacak daha çok şey olacak."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:958
translate tr qst_ForgedInFire_Training2NightEvent_e102cb4c:

    # "The broad man turned to leave, and as he did so, Captain Duprey looked towards the woman."
    "Geniş adam gitmek için döndü ve bunu yaparken, Kaptan Duprey kadına doğru baktı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:959
translate tr qst_ForgedInFire_Training2NightEvent_6ff2487b:

    # NYX_BLONDE @ sad "... I don't know, Duprey, this just maybe isn't the right time."
    NYX_BLONDE @ sad "... Bilmiyorum, Duprey, bu belki de doğru zaman değil."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:960
translate tr qst_ForgedInFire_Training2NightEvent_ece5bef6:

    # NYX_BLONDE @ sad "The more we unite our forces, the more we paint ourselves a target for the other factions."
    NYX_BLONDE @ sad "Kuvvetlerimizi ne kadar birleştirirsek, kendimizi diğer gruplar için o kadar hedef haline getiririz."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:961
translate tr qst_ForgedInFire_Training2NightEvent_f5cdc275:

    # DUPREY "... I don't care about the factions."
    DUPREY "... Gruplar umurumda değil."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:962
translate tr qst_ForgedInFire_Training2NightEvent_361df80b:

    # DUPREY "I don't care about the politics of the damn thing."
    DUPREY "Bu lanet şeyin politikaları umurumda değil."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:963
translate tr qst_ForgedInFire_Training2NightEvent_538b8cf8:

    # DUPREY "What does any of that matter if there's no one left in the end?"
    DUPREY "Sonunda kimse kalmadıktan sonra bunların ne önemi var?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:964
translate tr qst_ForgedInFire_Training2NightEvent_c7e9daac:

    # DUPREY "Newheart is gone... There's no one left to save us but ourselves now."
    DUPREY "Newheart gitti... Artık bizi kendimizden başka kurtaracak kimse yok."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:965
translate tr qst_ForgedInFire_Training2NightEvent_0e94a49a:

    # NYX_BLONDE @ sad "...Goodnight, Duprey."
    NYX_BLONDE @ sad "...İyi geceler, Duprey."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:966
translate tr qst_ForgedInFire_Training2NightEvent_2d5676a4:

    # NYX_BLONDE @ sad "I hope you're wrong about all this... I really do."
    NYX_BLONDE @ sad "Tüm bunlarda haksız olmanı umuyorum... Gerçekten umuyorum."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:967
translate tr qst_ForgedInFire_Training2NightEvent_3bff260d:

    # "The woman turned to leave and join the broad man, leaving Captain Duprey to stand beside Officer Borras alone."
    "Kadın gitmek ve geniş adama katılmak için döndü, Kaptan Duprey'i Subay Borras ile yalnız bıraktı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:971
translate tr qst_ForgedInFire_Training2NightEvent_9b060e61:

    # "As the two figures passed me by, I hid myself behind a barrel and waited for them to be out of sight."
    "İki figür yanımdan geçerken, kendimi bir varilin arkasına sakladım ve gözden kaybolmalarını bekledim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:974
translate tr qst_ForgedInFire_Training2NightEvent_d553e83d:

    # BORRAS @ talk "Captain..."
    BORRAS @ talk "Kaptan..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:975
translate tr qst_ForgedInFire_Training2NightEvent_eba06326:

    # DUPREY "Return to your quarters, Borras."
    DUPREY "Odalarına dön, Borras."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:976
translate tr qst_ForgedInFire_Training2NightEvent_6fa2cda7:

    # DUPREY "Speak nothing of what has been said tonight."
    DUPREY "Bu gece söylenenler hakkında hiçbir şey konuşma."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:977
translate tr qst_ForgedInFire_Training2NightEvent_f9c712a9:

    # BORRAS @ sad "But-"
    BORRAS @ sad "Ama-"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:978
translate tr qst_ForgedInFire_Training2NightEvent_87e8ae86:

    # DUPREY "I'm tired Borras... So very tired."
    DUPREY "Yoruldum Borras... Çok yoruldum."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:979
translate tr qst_ForgedInFire_Training2NightEvent_0ae2d5a5:

    # DUPREY "The next battle can wait for another day."
    DUPREY "Bir sonraki savaş başka bir günü bekleyebilir."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:982
translate tr qst_ForgedInFire_Training2NightEvent_a5187100:

    # "Slowly, I watched as Captain Duprey slumped towards the barracks, likely back to his quarters."
    "Yavaşça, Kaptan Duprey'nin kışlaya doğru çöktüğünü, muhtemelen odalarına geri döndüğünü izledim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:984
translate tr qst_ForgedInFire_Training2NightEvent_e034c8e5:

    # MC "(Zanarak... Can it really be?)"
    MC "(Zanarak... Gerçekten olabilir mi?)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:986
translate tr qst_ForgedInFire_Training2NightEvent_97d93231:

    # "I shook my head, pushing the terrible thoughts away."
    "Başımı salladım, korkunç düşünceleri bir kenara ittim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:987
translate tr qst_ForgedInFire_Training2NightEvent_d2897e6b:

    # MC "(I need to return to my bed, before someone sees me.)"
    MC "(Yatağıma dönmem gerek, biri beni görmeden.)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:993
translate tr qst_ForgedInFire_Training2NightEvent_97284131:

    # "As I laid down onto the bed, dark, terrible thoughts and dreams returned."
    "Yatağa uzandığımda, karanlık, korkunç düşünceler ve rüyalar geri döndü."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:994
translate tr qst_ForgedInFire_Training2NightEvent_af180033:

    # "Returned to torment me for the rest of the night."
    "Gecenin geri kalanında bana işkence etmek için geri döndü."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1009
translate tr qst_ForgedInFire_Training3Final_eb24fb27:

    # DUPREY "Alright maggots, today I will see whether you lot have made any progress or had you just wasted my time!"
    DUPREY "Pekala kurtçuklar, bugün sizlerin herhangi bir ilerleme kaydedip kaydetmediğinizi yoksa sadece zamanımı mı harcadığınızı göreceğim!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1010
translate tr qst_ForgedInFire_Training3Final_884243ea:

    # DUPREY "We will start with duels first!"
    DUPREY "Önce düellolarla başlayacağız!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1011
translate tr qst_ForgedInFire_Training3Final_62189e19:

    # DUPREY "Partner up, grab yourself a healing vial, and fight as if your life depended on it!"
    DUPREY "Eşleşin, kendinize bir iyileştirme şişesi alın ve hayatınız buna bağlıymış gibi dövüşün!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1016
translate tr qst_ForgedInFire_Training3Final_761342c6:

    # MC "Shit got real, huh?"
    MC "İşler ciddileşti, ha?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1017
translate tr qst_ForgedInFire_Training3Final_67044540:

    # "Markus was certainly not going to fool around this time."
    "Markus bu sefer kesinlikle şaka yapmayacaktı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1018
translate tr qst_ForgedInFire_Training3Final_d92306b7:

    # MARKUS @ angry "Come on, [player_name!t], let's do this!"
    MARKUS @ angry "Hadi, [player_name!t], yapalım şunu!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1019
translate tr qst_ForgedInFire_Training3Final_bc95234e:

    # MC @ angry "Alright, bring it on then!"
    MC @ angry "Tamam, getir bakalım o zaman!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1053
translate tr qst_ForgedInFire_Training3Final_Lose_1263e952:

    # "Ouch."
    "Ah."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1054
translate tr qst_ForgedInFire_Training3Final_Lose_c58b41a1:

    # "Darkness."
    "Karanlık."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1055
translate tr qst_ForgedInFire_Training3Final_Lose_8f6cd72d:

    # "Then, dim light telling shapes apart."
    "Sonra, şekilleri ayırt eden loş ışık."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1056
translate tr qst_ForgedInFire_Training3Final_Lose_ce93bfa4:

    # "A vision."
    "Bir görü."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1057
translate tr qst_ForgedInFire_Training3Final_Lose_a05d37f2:

    # "A vision of Alderay under demonic onslaught."
    "Şeytani saldırı altındaki Alderay'ın bir görüsü."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1058
translate tr qst_ForgedInFire_Training3Final_Lose_f32b1941:

    # "Of me, defending it's people."
    "Benim, halkını koruyorum."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1059
translate tr qst_ForgedInFire_Training3Final_Lose_27cd56c1:

    # "Uniting them under my banners."
    "Onları sancaklarım altında birleştiriyorum."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1060
translate tr qst_ForgedInFire_Training3Final_Lose_63b84b20:

    # "Power."
    "Güç."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1061
translate tr qst_ForgedInFire_Training3Final_Lose_008f17f9:

    # "Wealth."
    "Zenginlik."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1062
translate tr qst_ForgedInFire_Training3Final_Lose_d7eea514:

    # "Women..."
    "Kadınlar..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1063
translate tr qst_ForgedInFire_Training3Final_Lose_b6ce6190:

    # "However, there is something else."
    "Ancak, başka bir şey daha var."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1064
translate tr qst_ForgedInFire_Training3Final_Lose_8bf4ebd2:

    # "Something that drives me onwards, something from outside..."
    "Beni ileriye iten bir şey, dışarıdan gelen bir şey..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1065
translate tr qst_ForgedInFire_Training3Final_Lose_90b93b6a:

    # "It's..."
    "Bu..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1068
translate tr qst_ForgedInFire_Training3Final_Lose_d1df3db6:

    # "Ice-cold water!"
    "Buz gibi su!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1074
translate tr qst_ForgedInFire_Training3Final_Lose_bc5c4518:

    # DUPREY "{b}ON YOUR FEET, MAGGOT!{/b}"
    DUPREY "{b}AYAĞA KALK, KURTÇUK!{/b}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1075
translate tr qst_ForgedInFire_Training3Final_Lose_5ad11caa:

    # "Captain Duprey's heavy kick quickly stood me up straight, recent knockout echoing in my head with an irritating, pulsing pain."
    "Kaptan Duprey'nin ağır tekmesi beni hızla dimdik ayağa kaldırdı, son nakavt kafamda rahatsız edici, nabız gibi bir acıyla yankılandı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1076
translate tr qst_ForgedInFire_Training3Final_Lose_e7a57264:

    # DUPREY "Go again, Demorai won't wait for you to come back to your senses!"
    DUPREY "Tekrar yap, Demorai sense geri gelmeni beklemeyecek!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1077
translate tr qst_ForgedInFire_Training3Final_Lose_032e9f26:

    # MC "(Gotta get a grip...)"
    MC "(Toparlanmam gerek...)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1078
translate tr qst_ForgedInFire_Training3Final_Lose_523ecf6e:

    # DUPREY @ angry "I'm trying to be nice to you maggot, now go again!"
    DUPREY @ angry "Sana iyi davranmaya çalışıyorum kurtçuk, şimdi tekrar yap!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1090
translate tr qst_ForgedInFire_FinalSparring_Complete_6a4925e0:

    # MARKUS "Gah! You sure know how to make it hurt!"
    MARKUS "Gah! Nasıl acıtacağını gerçekten biliyorsun!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1091
translate tr qst_ForgedInFire_FinalSparring_Complete_0fb6a986:

    # MC "{i}*Huff*{/i} Someone’s had to knock some sense into you!"
    MC "{i}*Huff*{/i} Birinin sana biraz akıl sokması gerekiyordu!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1092
translate tr qst_ForgedInFire_FinalSparring_Complete_66516ca5:

    # "As me and Markus caught our breath, I noticed an unusual figure dressed in fine fabrics speaking to the Captain."
    "Ben ve Markus nefesimizi toplarken, Kaptana konuşan, ince kumaşlar giymiş sıra dışı bir figür fark ettim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1093
translate tr qst_ForgedInFire_FinalSparring_Complete_163ee6d6:

    # "The Captain seemed unimpressed with whatever the man was saying and seemed to be refusing him something before being handed what seemed like a very official looking letter."
    "Kaptan adamın söylediği her neyse ondan etkilenmemiş görünüyordu ve çok resmi görünen bir mektup verilmeden önce bir şeyi reddediyor gibiydi."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1094
translate tr qst_ForgedInFire_FinalSparring_Complete_783e0863:

    # "I thought I could make out the royal seal."
    "Kraliyet mührünü seçebildiğimi sandım."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1095
translate tr qst_ForgedInFire_FinalSparring_Complete_edb3c6df:

    # "I couldn’t hear what was being said, but I managed to figure out the words escaping his lips, {i}‘They’re not ready yet!’{/i}"
    "Ne söylendiğini duyamadım, ama dudaklarından kaçan kelimeleri çıkarmayı başardım, {i}'Daha hazır değiller!'{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1096
translate tr qst_ForgedInFire_FinalSparring_Complete_7e66af39:

    # MARKUS "What’s going on?"
    MARKUS "Ne oluyor?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1097
translate tr qst_ForgedInFire_FinalSparring_Complete_28993885:

    # "I nudged him to look over towards Duprey."
    "Duprey'e doğru bakması için onu dürttüm."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1098
translate tr qst_ForgedInFire_FinalSparring_Complete_78c93499:

    # MARKUS "... Is that someone from the palace?"
    MARKUS "... O saraydan biri mi?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1099
translate tr qst_ForgedInFire_FinalSparring_Complete_6da37e5e:

    # MC "I think so."
    MC "Sanırım öyle."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1100
translate tr qst_ForgedInFire_FinalSparring_Complete_c390d19a:

    # MARKUS "Since when did the palace send its fancy officials down to us mud and grunts?"
    MARKUS "Saray ne zamandan beri süslü memurlarını çamur ve askerlerin arasına gönderiyor?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1101
translate tr qst_ForgedInFire_FinalSparring_Complete_d52535a2:

    # MARKUS "What do you think they want? It must be serious."
    MARKUS "Ne istediklerini düşünüyorsun? Ciddi olmalı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1102
translate tr qst_ForgedInFire_FinalSparring_Complete_67965d23:

    # MC "I don’t know... but I don’t think it’s going to be anything good."
    MC "Bilmiyorum... ama iyi bir şey olacağını sanmıyorum."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1107
translate tr qst_ForgedInFire_FinalSparring_Complete_452c6b58:

    # "All of a sudden, the Captain heaved himself reluctantly onto the wooden platform and cried out for our attention."
    "Birdenbire, Kaptan isteksizce kendini tahta platforma çıkardı ve dikkatimiz için haykırdı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1108
translate tr qst_ForgedInFire_FinalSparring_Complete_4074b31d:

    # DUPREY "FORM RANKS!"
    DUPREY "SAFLARA GEÇİN!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1110
translate tr qst_ForgedInFire_FinalSparring_Complete_7bdc104e:

    # "The tired and weary Scouts hastily moved to form neat rows and face the Captain, hanging on his every word."
    "Yorgun ve bitkin İzciler aceleyle düzgün sıralar oluşturdu ve Kaptana döndü, her kelimesine asıldı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1111
translate tr qst_ForgedInFire_FinalSparring_Complete_d0187a8e:

    # DUPREY "We have been ordered on early leave for a mission."
    DUPREY "Bir görev için erken izne gönderilme emri aldık."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1112
translate tr qst_ForgedInFire_FinalSparring_Complete_af5fac36:

    # "Confused mutterings swept through the ranks, as most of us expected the training to last for months."
    "Acemilerin çoğu eğitimin aylarca sürmesini beklediği için şaşkın mırıltılar safları süpürdü."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1113
translate tr qst_ForgedInFire_FinalSparring_Complete_41c2d6b4:

    # DUPREY "SILENCE!!!"
    DUPREY "SESSİZLİK!!!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1114
translate tr qst_ForgedInFire_FinalSparring_Complete_219c5f53:

    # DUPREY "This order has come down from Emperor Alcott himself and has been approved by King Mesamor."
    DUPREY "Bu emir bizzat İmparator Alcott'tan geldi ve Kral Mesamor tarafından onaylandı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1115
translate tr qst_ForgedInFire_FinalSparring_Complete_8b792546:

    # DUPREY "We leave come first light tomorrow."
    DUPREY "Yarın ilk ışıkta ayrılıyoruz."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1116
translate tr qst_ForgedInFire_FinalSparring_Complete_0fa47cd9:

    # DUPREY "Get to bed early, make sure you’re well fed and be absolutely certain that your equipment is clean and ready."
    DUPREY "Erken yatın, iyi beslendiğinizden ve ekipmanınızın temiz ve hazır olduğundan kesinlikle emin olun."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1117
translate tr qst_ForgedInFire_FinalSparring_Complete_cae6e8d4:

    # "A timid hand was raised from the crowd."
    "Kalabalıktan çekingen bir el kaldırıldı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1118
translate tr qst_ForgedInFire_FinalSparring_Complete_c2e2d792:

    # DUPREY "What is it?"
    DUPREY "Ne var?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1120
translate tr qst_ForgedInFire_FinalSparring_Complete_13b24539:

    # RECRUIT "Where are we to be sent, sir?"
    RECRUIT "Nereye gönderileceğiz, efendim?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1121
translate tr qst_ForgedInFire_FinalSparring_Complete_544b0d7d:

    # DUPREY "The mission is top secret, all I can tell you is that you will be recovering relics from a lost fortress south of here."
    DUPREY "Görev çok gizli, size söyleyebileceğim tek şey, buradan güneyde kayıp bir kaleden kalıntılar toplayacağınız."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1122
translate tr qst_ForgedInFire_FinalSparring_Complete_0ac7589b:

    # DUPREY "Expect at least six weeks march, take this into consideration with your prep."
    DUPREY "En az altı haftalık yürüyüş bekleyin, hazırlığınızda bunu dikkate alın."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1123
translate tr qst_ForgedInFire_FinalSparring_Complete_ee4f7f5b:

    # DUPREY "Dismissed!"
    DUPREY "Dağılın!"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1126
translate tr qst_ForgedInFire_FinalSparring_Complete_8cfa9b03:

    # "With that, the Captain stormed his way off stage, angrily shoving the sealed letter back into the fumbling hands of the palace official before stalking back to his quarters."
    "Bununla, Kaptan öfkeyle sahneden indi, mühürlü mektubu sinirle saray memurunun beceriksiz ellerine geri iterken odalarına doğru yürüdü."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1127
translate tr qst_ForgedInFire_FinalSparring_Complete_fa69c2ee:

    # "The men soon dissolved the ranks and the process of packing up for our departure began."
    "Adamlar kısa sürede safları dağıttı ve ayrılışımız için toplanma süreci başladı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1133
translate tr qst_ForgedInFire_FinalSparring_Complete_73d9be9c:

    # "There was much confused chatter about what this {i}‘secret mission’{/i} entailed, and more so the worry of now being confronted by the Demorai so clearly unprepared."
    "Bu {i}"gizli görevin"Bu {i}'gizli görevin'{/i} neyi gerektirdiğine dair bolca şaşkın gevezelik ve daha da fazlası, şimdi bu kadar açıkça hazırlıksız bir şekilde Demorai ile karşılaşma endişesi vardı."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1134
translate tr qst_ForgedInFire_FinalSparring_Complete_d33077f7:

    # MARKUS "What the fuck was all that about?"
    MARKUS "Tüm bunlar da neydi lan?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1135
translate tr qst_ForgedInFire_FinalSparring_Complete_07f11245:

    # MC "I don’t know, looks like some higher up bullshit to me."
    MC "Bilmiyorum, bana üst düzey bir saçmalık gibi geldi."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1136
translate tr qst_ForgedInFire_FinalSparring_Complete_3e0ef9c5:

    # MC "Guess we'll be skipping the test then..."
    MC "Sanırım testi atlayacağız o zaman..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1137
translate tr qst_ForgedInFire_FinalSparring_Complete_52b2a82f:

    # MARKUS "Hm... I’ll make sure to pack some extra bread for you, okay?"
    MARKUS "Hm... Senin için biraz ekstra ekmek paketleyeceğim, tamam mı?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1138
translate tr qst_ForgedInFire_FinalSparring_Complete_f6d7e7b6:

    # MC "Where’d you get the extra rations from, you fancy fuck?"
    MC "Ekstra erzakları nereden aldın, seni süslü pislik?"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1139
translate tr qst_ForgedInFire_FinalSparring_Complete_a1c732d3:

    # MARKUS "My brother sent it to me the other day, figured we could split it..."
    MARKUS "Kardeşim geçen gün gönderdi, bölüşebileceğimizi düşündüm..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1140
translate tr qst_ForgedInFire_FinalSparring_Complete_ce4a9c8a:

    # MC "Oh, thank you."
    MC "Ah, teşekkür ederim."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1141
translate tr qst_ForgedInFire_FinalSparring_Complete_7ff3445a:

    # MARKUS "In return I want some of that sweet wine you got!"
