    "Etrafa bakınca fark ettim ki... {i}Fort Sebastian?{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1464
translate tr qst_TheDarkPass_ObelisksRoomCheckObelisks_06f0eaca:

