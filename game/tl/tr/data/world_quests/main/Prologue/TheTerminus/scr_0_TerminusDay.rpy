# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:436
translate tr qst_Terminus_EnterPalace_1e39f10a:

    # ALCOTT @ smile "It has been fourteen years since our war with the Demorai began. Fourteen years of sacrifices..."
    ALCOTT @ smile "Demorai ile savaşımız başlayalı on dört yıl oldu. On dört yıl fedakarlıklar..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:437
translate tr qst_Terminus_EnterPalace_4872ab72:

    # ALCOTT " Fourteen years of losses too great to put into words."
    ALCOTT "Kelimelere dökülemeyecek kadar büyük kayıpların on dört yılı."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:438
translate tr qst_Terminus_EnterPalace_8be50508:

    # ALCOTT "Each of us has lost someone in this conflict, but the battle continues even now, with many of our kin away from home helping to secure and restore our once great kingdom!"
    ALCOTT "Her birimiz bu çatışmada birini kaybettik, ama savaş şimdi bile devam ediyor, akrabalarımızın çoğu evden uzakta, bir zamanlar büyük olan krallığımızı güvenceye almaya ve yeniden kurmaya yardım ediyor!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:439
translate tr qst_Terminus_EnterPalace_5dd048a4:

    # ALCOTT "The road ahead is hard, it is brutal... {i}and it is bloody.{/i} "
    ALCOTT "Önümüzdeki yol zor, acımasız... {i}ve kanlı.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:440
translate tr qst_Terminus_EnterPalace_a11fa683:

    # ALCOTT "But today is a day of new hope!"
    ALCOTT "Ama bugün yeni bir umudun günü!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:441
translate tr qst_Terminus_EnterPalace_a9388680:

    # ALCOTT "A day for a new generation to lead the fight!"
    ALCOTT "Yeni bir neslin savaşı yönetme günü!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:442
translate tr qst_Terminus_EnterPalace_a1dfe190:

    # ALCOTT "And we WILL be victorious in this conflict!"
    ALCOTT "Ve bu çatışmada galip geleceğiz!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:443
translate tr qst_Terminus_EnterPalace_7395f2c2:

    # ALCOTT "We will survive and we WILL thrive once again!"
    ALCOTT "Hayatta kalacağız ve bir kez daha gelişeceğiz!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:444
translate tr qst_Terminus_EnterPalace_b5393478:

    # ALCOTT "And most importantly, we will do it for them!"
    ALCOTT "Ve en önemlisi, bunu onlar için yapacağız!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:445
translate tr qst_Terminus_EnterPalace_fdf784a9:

    # ALCOTT "We will build the world they fought for, the world they wanted you to have!"
    ALCOTT "Onların savaştığı dünyayı, sizin sahip olmanızı istedikleri dünyayı inşa edeceğiz!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:446
translate tr qst_Terminus_EnterPalace_5b213438:

    # ALCOTT "To those of you now bearing the responsibility of helping us restore this kingdom to its former glory, whether soldier or baker, blacksmith or humble street sweeper..."
    ALCOTT "İster asker ister fırıncı, ister demirci ister mütevazı sokak süpürücüsü olsun, bu krallığı eski ihtişamına kavuşturmamıza yardım etme sorumluluğunu şimdi taşıyan sizlere..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:447
translate tr qst_Terminus_EnterPalace_9a4b160d:

    # ALCOTT "I salute you!"
    ALCOTT "Sizi selamlıyorum!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:448
translate tr qst_Terminus_EnterPalace_d9a239d2:

    # ALCOTT "HEIL!"
    ALCOTT "HEIL!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:451
translate tr qst_Terminus_EnterPalace_4834d82f:

    # CROWD "HEIL EMPEROR ALCOTT! HEIL THE NEW ALDERIAN EMPIRE!"
    CROWD "HEIL İMPARATOR ALCOTT! HEIL YENİ ALDERIAN İMPARATORLUĞU!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:452
translate tr qst_Terminus_EnterPalace_debab30d:

    # ALCOTT "Go now and do your Emperor proud! Do your country proud and do yourselves proud!"
    ALCOTT "Şimdi gidin ve İmparatorunuzu gururlandırın! Ülkenizi gururlandırın ve kendinizi gururlandırın!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:459
translate tr qst_Terminus_EnterPalace_bbe6fc24:

    # "And with that, Emperor Alcott descended from the podium, escorted back towards the fort from which he ruled and administered his government duties from."
    "Ve bununla, İmparator Alcott podyumdan indi, yönettiği ve hükümet görevlerini yürüttüğü kaleye geri götürüldü."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:460
translate tr qst_Terminus_EnterPalace_47d3e974:

    # "As he passed by me, he looked at me for a moment, with the coldest eyes I had ever seen, as though his gaze could cut through and freeze my very soul."
    "Yanımdan geçerken, bir an bana baktı, gördüğüm en soğuk gözlerle, sanki bakışı ruhumu kesip dondurabilirmiş gibi."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:465
translate tr qst_Terminus_EnterPalace_a8edd937:

    # ADARA @ talk "He’s so scary..."
    ADARA @ talk "O çok korkutucu..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:466
translate tr qst_Terminus_EnterPalace_afc8cc1f:

    # MC "Yeah..."
    MC "Evet..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:467
translate tr qst_Terminus_EnterPalace_49080373:

    # MARKUS "He might be scary, but without him this city would have fallen long ago."
    MARKUS "Korkutucu olabilir, ama onsuz bu şehir çoktan düşerdi."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:468
translate tr qst_Terminus_EnterPalace_525dee60:

    # MARKUS "We need more leaders like him. Leaders who will do what has to be done."
    MARKUS "Onun gibi daha fazla lidere ihtiyacımız var. Yapılması gerekeni yapacak liderlere."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:469
translate tr qst_Terminus_EnterPalace_6fa51ea6:

    # ADARA @ talk "Mmm, I’m not so sure... Not after deposing the King like that..."
    ADARA @ talk "Mmm, o kadar emin değilim... Kralı böyle tahttan indirdikten sonra değil..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:470
translate tr qst_Terminus_EnterPalace_db5a5efc:

    # MARKUS "Alcott led troops and repelled The Great Invasion from taking Novaras while the King continued to squander more troops lives pointlessly."
    MARKUS "Alcott, Kral daha fazla askerin hayatını anlamsızca israf etmeye devam ederken birliklere önderlik etti ve Büyük İstila'nın Novaras'ı almasını püskürttü."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:471
translate tr qst_Terminus_EnterPalace_ae457738:

    # MARKUS "If it wasn’t for him, this place would have fallen in 1152."
    MARKUS "O olmasaydı, burası 1152'de düşerdi."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:472
translate tr qst_Terminus_EnterPalace_48dd72c2:

    # ADARA @ talk "He also split the alliance in half with his little coup!"
    ADARA @ talk "Aynı zamanda küçük darbesiyle ittifakı ikiye böldü!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:473
translate tr qst_Terminus_EnterPalace_39239c03:

    # MC "Urgh, do you two need to keep arguing politics?"
    MC "Urgh, siz ikinizin siyaset tartışmaya devam etmesi gerekiyor mu?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:474
translate tr qst_Terminus_EnterPalace_fc35ca54:

    # ADARA @ angry "Hmph..."
    ADARA @ angry "Hmph..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:475
translate tr qst_Terminus_EnterPalace_fc582d37:

    # MARKUS "Alright, let’s just drop it."
    MARKUS "Tamam, hadi konuyu bırakalım."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:476
translate tr qst_Terminus_EnterPalace_315cc143:

    # MARKUS "Anyway, come on, it’s time we finally got our results, [player_name!t]!"
    MARKUS "Her neyse, hadi, sonuçlarımızı nihayet alma zamanı, [player_name!t]!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:477
translate tr qst_Terminus_EnterPalace_8bbd0124:

    # MC "Ah, right."
    MC "Ah, doğru."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:478
translate tr qst_Terminus_EnterPalace_6fd5686c:

    # ADARA @ talk "Goodluck, guys, I best get in my queue as well!"
    ADARA @ talk "İyi şanslar, çocuklar, ben de sırama geçsem iyi olur!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:480
translate tr qst_Terminus_EnterPalace_bf5aeb7d:

    # MC "Good luck, Adara!"
    MC "İyi şanslar, Adara!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:482
translate tr qst_Terminus_EnterPalace_8da82e65:

    # MARKUS "Same, good luck to you."
    MARKUS "Aynen, sana da iyi şanslar."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:485
translate tr qst_Terminus_EnterPalace_052cae9b:

    # "Each of us headed over to our respective queues, where hundreds of students would now wait for hours to receive the letter that would decide their life."
    "Her birimiz ilgili sıralarımıza yöneldik, yüzlerce öğrenci hayatlarını belirleyecek mektubu almak için saatlerce bekleyecekti."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:486
translate tr qst_Terminus_EnterPalace_488e3fc8:

    # "Sometimes, the wait would leave some to not find out until the early hours of the next morning..."
    "Bazen, bekleme bazılarının ertesi sabahın erken saatlerine kadar öğrenememesine yol açardı..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:487
translate tr qst_Terminus_EnterPalace_19e073a7:

    # "After five hours, I finally arrived at the stall."
    "Beş saat sonra, nihayet tezgaha vardım."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:489
translate tr qst_Terminus_EnterPalace_e7442a13:

    # "Markus had already come and gone half an hour before, after he’d managed to slip into the queue slightly ahead of me."
    "Markus benden biraz önce sıraya kaymayı başardıktan sonra, yarım saat önce gelip gitmişti."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:490
translate tr qst_Terminus_EnterPalace_386634eb:

    # "He’d promised to meet me afterwards outside his home, then we’d head out to celebrate together."
    "Daha sonra evinin dışında buluşmaya söz vermişti, sonra birlikte kutlamaya çıkacaktık."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:493
translate tr qst_Terminus_EnterPalace_dedd2831:

    # "The woman looked up at me, smiling warmly."
    "Kadın bana baktı, sıcakça gülümsedi."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:494
translate tr qst_Terminus_EnterPalace_3f349202:

    # WOMAN "Name?"
    WOMAN "İsim?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:495
translate tr qst_Terminus_EnterPalace_af2df090:

    # MC "[player_name!t]."
    MC "[player_name!t]."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:496
translate tr qst_Terminus_EnterPalace_210a4852:

    # WOMAN "Class number?"
    WOMAN "Sınıf numarası?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:497
translate tr qst_Terminus_EnterPalace_a75d1844:

    # MC "4D."
    MC "4D."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:498
translate tr qst_Terminus_EnterPalace_a088cd90:

    # WOMAN "Student number?"
    WOMAN "Öğrenci numarası?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:499
translate tr qst_Terminus_EnterPalace_675612db:

    # MC "Three-Two-Six-Nine-One."
    MC "Üç-İki-Alti-Dokuz-Bir."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:500
translate tr qst_Terminus_EnterPalace_757e00c2:

    # "The woman shuffled through the envelopes stamped down with the red wax seal of the Royal Court, and after finding mine, handed it over to me which I snatched greedily from her hands."
    "Kadın, Kraliyet Sarayı'nın kırmızı mum mührüyle damgalanmış zarfları karıştırdı ve benimkini bulduktan sonra, onu açgözlüce ellerinden kaptığım bana verdi."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:501
translate tr qst_Terminus_EnterPalace_70c7cba8:

    # WOMAN "Good luck!"
    WOMAN "İyi şanslar!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:502
translate tr qst_Terminus_EnterPalace_19f340fd:

    # MC "Thank you!"
    MC "Teşekkür ederim!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:503
translate tr qst_Terminus_EnterPalace_12fca38c:

    # "This is it! This is my destiny in my hands!"
    "İşte bu! Kaderim ellerimde!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:504
translate tr qst_Terminus_EnterPalace_403df7de:

    # "All these years of work are finally going to pay off!"
    "Tüm bu yıllarca çalışma nihayet karşılığını verecek!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:505
translate tr qst_Terminus_EnterPalace_40d11fb3:

    # "Feverishly, I ripped into the letter with sweaty hands, my heart beating frantically."
    "Ateşli bir şekilde, terli ellerle mektuba daldım, kalbim çılgınca atıyordu."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:520
translate tr qst_Terminus_EnterPalace_85bbe6f7:

    # "I read that tiny bit of text a couple times over before it actually started to make sense..."
    "O minik metin parçasını, gerçekten anlam kazanmaya başlamadan önce birkaç kez okudum..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:521
translate tr qst_Terminus_EnterPalace_27570ac7:

    # MC "My... Training?"
    MC "Benim... Eğitim mi?"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:522
translate tr qst_Terminus_EnterPalace_a20cefa7:

    # "..."
    "..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:523
translate tr qst_Terminus_EnterPalace_5c3e3f1d:

    # MC "Capital... What?!"
    MC "Başkent... Ne?!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:524
translate tr qst_Terminus_EnterPalace_1d5e8c4b:

    # MC "I... {i}I’m going to the Scouts?{/i}"
    MC "Ben... {i}İzcilere mi gidiyorum?{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:525
translate tr qst_Terminus_EnterPalace_b8535060:

    # MC "... No... No! This is... This is wrong!"
    MC "... Hayır... Hayır! Bu... Bu yanlış!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:526
translate tr qst_Terminus_EnterPalace_20b35e97:

    # MC "I can’t be in the Scouts! This is..."
    MC "İzcilerde olamam! Bu..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:530
translate tr qst_Terminus_EnterPalace_b1631114:

    # "Looking up, I hurried back over the stall, frantically trying to speak to the lady but was immediately restrained by the guards."
    "Yukarı bakarak, aceleyle tezgaha geri döndüm, çılgınca hanımefendiyle konuşmaya çalıştım ama hemen muhafızlar tarafından zapt edildim."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:531
translate tr qst_Terminus_EnterPalace_5f57996f:

    # "Other students berated me for cutting the line."
    "Diğer öğrenciler sırayı kestiğim için beni azarladı."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:532
translate tr qst_Terminus_EnterPalace_170b6a29:

    # WOMAN "Sir! Please wait in line for—"
    WOMAN "Efendim! Lütfen sırada bekleyin—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:533
translate tr qst_Terminus_EnterPalace_5818611d:

    # MC "This! This has to be a mistake! I can’t be in the Scouts! I’m not—"
    MC "Bu! Bu bir hata olmalı! İzcilerde olamam! Ben—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:534
translate tr qst_Terminus_EnterPalace_4f67789a:

    # WOMAN "If it’s got your name on the front and that’s what’s written, then I’m afraid you are, sir."
    WOMAN "Önünde adın yazıyorsa ve yazılan buysa, korkarım öylesin, efendim."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:535
translate tr qst_Terminus_EnterPalace_4475949c:

    # MC "But I... I—"
    MC "Ama ben... Ben—"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:536
translate tr qst_Terminus_EnterPalace_95125b1b:

    # GUARD "Oi! Go on, son! Get out of here now!"
    GUARD "Oi! Git, oğlum! Hemen çık buradan!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:537
translate tr qst_Terminus_EnterPalace_25dc304d:

    # "The guard shoved me back sharply, making me stumble as I fell on my ass, tears springing behind my eyes as I muttered to myself."
    "Muhafız beni sertçe itti, tökezlememe ve kıçımın üzerine düşmeme neden oldu, kendi kendime mırıldanırken gözlerimin arkasında yaşlar birikti."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:538
translate tr qst_Terminus_EnterPalace_52378a4f:

    # MC "No... {i}No this can’t be!{/i}"
    MC "Hayır... {i}Hayır, bu olamaz!{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:539
translate tr qst_Terminus_EnterPalace_f20c8d0d:

    # MC "I can’t... {i}This...{/i}... This is a nightmare!"
    MC "Yapamam... {i}Bu...{/i}... Bu bir kabus!"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:540
translate tr qst_Terminus_EnterPalace_fd8e9f7a:

    # MC "{i}It can’t be real!{/i}"
    MC "{i}Gerçek olamaz!{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:546
translate tr qst_Terminus_EnterPalace_903a92c1:

    # "Dazed, I walked the streets aimlessly for what seemed like an eternity, until I found myself in the housing district."
    "Sersemlemiş, sokakları amaçsızca, sonsuzluk gibi görünen bir süre boyunca yürüdüm, ta ki kendimi konut bölgesinde bulana kadar."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:547
translate tr qst_Terminus_EnterPalace_62f22980:

    # "I dragged myself over to Markus’ home, dejected, destroyed... {i}broken.{/i}"
    "Kendimi Markus'un evine sürükledim, çökmüş, yıkılmış... {i}parçalanmış.{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:554
translate tr qst_Terminus_EnterPalace_0c816036:

    # "I found him slouched against the wall by his front door, a solemn look on his face as he turned to me, still holding his own sheet in his hands."
    "Onu ön kapısının yanında duvara yığılmış buldum, bana dönerken yüzünde hüzünlü bir ifade, hala kendi kağıdını elinde tutuyordu."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:555
translate tr qst_Terminus_EnterPalace_25c532ca:

    # MARKUS "... I’ve been placed in the Scouts."
    MARKUS "... Ben İzcilere yerleştirildim."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:556
translate tr qst_Terminus_EnterPalace_d92e9348:

    # "He said with a lifeless look in his eyes, my eyes widened in shock."
    "Gözlerinde cansız bir ifadeyle söyledi, gözlerim şokla genişledi."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:557
translate tr qst_Terminus_EnterPalace_dd0c95fc:

    # MC "... Y-You’re..."
    MC "... S-Sen..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:558
translate tr qst_Terminus_EnterPalace_06928b06:

    # MARKUS "Yes."
    MARKUS "Evet."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:559
translate tr qst_Terminus_EnterPalace_569f4dc6:

