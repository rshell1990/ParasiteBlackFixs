    # SYPHA @ talk "The old gods did have a rather nasty penchant for demanding blood sacrifices."
    SYPHA @ talk "Eski tanrıların kan kurbanları talep etme konusunda oldukça kötü bir eğilimi vardı."

# game/data/world_quests/side/hamun/BigTroubleLittleHamun/BigTroubleLH_golem.rpy:311
translate tr qst_BigTroubleLHamun_temple_dials_first_enter_7e093939:

