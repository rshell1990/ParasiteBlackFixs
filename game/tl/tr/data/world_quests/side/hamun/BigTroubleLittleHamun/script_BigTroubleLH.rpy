    new "Sana ne anlaşması teklif ediyorlar?"

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:42
    old "How long has this been going on?"
    new "Bu ne zamandır sürüyor?"

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:48
    old "What are you gonna do?"
    new "Ne yapacaksın?"

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:144
    old "Marbella, the owner of the Crooked Shaft Mining Co., is in need of protection."
    new "Crooked Shaft Madencilik Şti.'nin sahibi Marbella'nın korumaya ihtiyacı var."

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:186
    old "Never mind, actually."
    new "Boş ver, aslında."

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:209
    old "Kick it away!"
    new "Onu tekmeyle uzaklaştır!"

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:230
    old "Try to move away!"
    new "Uzaklaşmaya çalış!"

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:313
    old "Lord Zanzibat is willing to make a deal."
    new "Lord Zanzibat bir anlaşma yapmaya razı."

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:318
    old "The Khazah are willing to lend you their muscle."
    new "Khazah sana bilek güçlerini ödünç vermeye razı."

    # game/data/world_quests/side/hamun/BigTroubleLittleHamun/script_BigTroubleLH.rpy:323
    old "I can buy you a golem, for security."
    new "Sana bir golem satın alabilirim, güvenlik için."

