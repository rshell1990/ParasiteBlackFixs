# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1998
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_99cef191:

    # "A man tried to kidnap me tonight. Thankfully, our guards managed to stop him."
