# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2007
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_e5f52d0d:

    # "but it's all cliques and coin and..."
    "ama hepsi klikler ve para ve..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2008
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_fa990cff:

    # "No one is friends with anyone, really. It's all just strategic alignments."
    "Kimse gerçekten kimseyle arkadaş değil. Hepsi sadece stratejik hizalanmalar."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2009
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_9b223944:

    # "... Fuck, I just wish someone was real for once."
    "... Siktir, keşke bir kere biri gerçek olsa."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2012
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_d47f9121:

    # "Father returned with a strange man."
    "Babam garip bir adamla geri döndü."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2013
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_c3456a70:

    # "He said the two of them were going to help me get rid of the nightmares once and for all."
    "İkisinin bir kez ve tamamen kabuslardan kurtulmama yardım edeceklerini söyledi."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2014
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_4ef80800:

    # "Father... You still remembered me!"
    "Babacığım... Hala beni hatırladın!"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2017
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_b537a0dd:

    # "I had a strange dream tonight. A man, handsome with black hair."
    "Bu gece garip bir rüya gördüm. Bir adam, siyah saçlı, yakışıklı."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2018
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_d64178bc:

    # "But he wasn't fully human. Inside of him... there was another soul."
    "Ama tamamen insan değildi. İçinde... başka bir ruh vardı."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2019
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_1b253a90:

    # "He swore he would save me, but it's so strange..."
    "Beni kurtaracağına yemin etti, ama çok garip..."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2020
translate tr qst_dreamhouse_l4_library_bookshelf_2_menu_7b0b2236:

    # "I've never even seen this man before in my life?"
