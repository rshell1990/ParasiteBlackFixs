    # MC @ think "{i}It?{/i}"
    MC @ think "{i}O?{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2237
translate tr qst_dreamhouse_final_housescene_ce9d8fbd:

    # VIRGO "This house was designed for containment."
    VIRGO "Bu ev kontrol altına almak için tasarlandı."

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:2238
translate tr qst_dreamhouse_final_housescene_e39f9a4f:

    # VIRGO "A place to store and contain her nightmares..."
    VIRGO "Kabuslarını depolamak ve kontrol altına almak için bir yer..."

