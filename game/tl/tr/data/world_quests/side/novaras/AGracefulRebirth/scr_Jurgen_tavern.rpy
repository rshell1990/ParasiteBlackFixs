translate tr jurgen_0_tavern_revisit_8ac30186:

    # "Jurgen chuckled and turned away, as if he saw Alcott stand in my place, naked."
    "Jurgen kıkırdadı ve arkasını döndü, sanki benim yerimde Alcott'u çıplak duruyormuş gibi gördü."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:48
translate tr jurgen_0_tavern_revisit_f5e18757:

