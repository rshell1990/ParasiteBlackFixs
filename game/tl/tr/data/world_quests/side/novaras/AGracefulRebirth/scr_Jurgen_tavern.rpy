translate tr jurgen_0_tavern_revisit_b228b028:

    # JURGEN "Show me."
    JURGEN "Göster bana."

# game/data/world_quests/side/novaras/AGracefulRebirth/scr_Jurgen_tavern.rpy:64
translate tr jurgen_0_tavern_revisit_c1cad31b:

