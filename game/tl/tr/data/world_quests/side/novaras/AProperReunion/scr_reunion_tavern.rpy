translate tr qst_reunion_tavern_dad6bcef:

    # ADARA @ talk "I mean, I heard you came back {i}in a week.{/i}"
    ADARA @ talk "Yani, {i}bir haftada{/i} döndüğünüzü duydum."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:104
translate tr qst_reunion_tavern_48a07b7c:

    # MC @ talk "Oh, uh..."
    MC @ talk "Ah, uh..."

