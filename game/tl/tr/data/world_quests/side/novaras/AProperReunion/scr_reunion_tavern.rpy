    MC @ talk "Sanırım savaştan kaçmışlardı ve birkaçı bizim olduğumuz yere doğru tökezlemişti."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:100
translate tr qst_reunion_tavern_77748251:

    # ADARA @ talk "...R-Right."
    ADARA @ talk "...D-Doğru."

