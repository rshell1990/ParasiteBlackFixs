    MC @ talk "Bir arka geçit bulmayı başardık ve olabildiğince hızlı bir şekilde Novaras'a geri sürmeye devam ettik."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:97
translate tr qst_reunion_tavern_6e95d48d:

