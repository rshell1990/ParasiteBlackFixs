translate tr qst_BiteBark_6_McRoomResolution_menu2_1a04c9a7:

    # "[regina_ref_cap!t] opened her mouth to say something, but instead she angrily slammed the side of the fist lightly into the wall muttering under her breathe."
    "[regina_ref_cap!t] bir şey söylemek için ağzını açtı, ama onun yerine öfkeyle yumruğunun yanını hafifçe duvara vurdu, nefesinin altında mırıldandı."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:144
translate tr qst_BiteBark_6_McRoomResolution_menu2_a83859d8:

    # REGINA @ angry "{i}Damn it...{/i}"
    REGINA @ angry "{i}Lanet olsun...{/i}"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:146
translate tr qst_BiteBark_6_McRoomResolution_menu2_fadfc224:

    # MC @ sad "(I feel bad I couldn't help her but... I'd only be taking on more unnecessary risk for myself.)"
    MC @ sad "(Ona yardım edemediğim için kötü hissediyorum ama... Sadece kendim için daha fazla gereksiz risk alıyor olurdum.)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:147
translate tr qst_BiteBark_6_McRoomResolution_menu2_3aa6a878:

    # MC "(I hope she finds what she is looking for, perhaps one day our paths will cross again?)"
    MC "(Umarım aradığını bulur, belki bir gün yollarımız yeniden kesişir?)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:156
translate tr qst_BiteBark_6_McRoomResolution_menu2_6544531e:

    # ELENA @ grumpy "Oh... One thing... While in this city, I will likely have to remain in my wolf form in a fight."
    ELENA @ grumpy "Ah... Bir şey... Bu şehirdeyken, bir dövüşte muhtemelen kurt formumda kalmak zorunda kalacağım."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:157
translate tr qst_BiteBark_6_McRoomResolution_menu2_1b0a7479:

    # ELENA @ grumpy "Too dangerous to show my true form."
    ELENA @ grumpy "Gerçek formumu göstermek çok tehlikeli."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:158
translate tr qst_BiteBark_6_McRoomResolution_menu2_e377fd11:

    # MC @ talk "I understand."
    MC @ talk "Anlıyorum."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:159
translate tr qst_BiteBark_6_McRoomResolution_menu2_4dd203d1:

    # "As my eyes scanned the wolf girl up and down, I felt the tinge of excitement staring at her slender, nude body."
    "Gözlerim kurt kızı baştan aşağı tararken, onun ince, çıplak bedenine bakarken bir heyecan kıpırtısı hissettim."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:160
translate tr qst_BiteBark_6_McRoomResolution_menu2_fc5d377c:

    # "Noticing this, Elena raised an eyebrow inquiring."
    "Bunu fark ederek, Elena sorgulayarak bir kaşını kaldırdı."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:161
translate tr qst_BiteBark_6_McRoomResolution_menu2_e454529d:

    # ELENA @ grumpy "Is something the matter?"
    ELENA @ grumpy "Bir sorun mu var?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:162
translate tr qst_BiteBark_6_McRoomResolution_menu2_2aba70ac:

    # MC @ surprised "I... Well you're..."
    MC @ surprised "Ben... Peki sen..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:163
translate tr qst_BiteBark_6_McRoomResolution_menu2_5b9077b4:

    # ELENA @ grumpy "...My form bothers you?"
    ELENA @ grumpy "...Formum seni rahatsız mı ediyor?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:164
translate tr qst_BiteBark_6_McRoomResolution_menu2_7cda0677:

    # MC @ surprised "N-No! You look beautiful!"
    MC @ surprised "H-Hayır! Güzel görünüyorsun!"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:165
translate tr qst_BiteBark_6_McRoomResolution_menu2_231e2faf:

    # MC @ talk "But, perhaps some clothes are in order?"
    MC @ talk "Ama, belki biraz kıyafet uygun olur?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:166
translate tr qst_BiteBark_6_McRoomResolution_menu2_e413c0fa:

    # ELENA @ grumpy "Urgh, why are you humans so determined to coat yourselves in fabrics and such?"
    ELENA @ grumpy "Urgh, siz insanlar neden kendinizi kumaşlara falan sarmakta bu kadar kararlısınız?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:167
translate tr qst_BiteBark_6_McRoomResolution_menu2_d3216100:

    # ELENA @ talk "You all seem so ashamed almost of your natural forms."
    ELENA @ talk "Hepiniz neredeyse doğal formlarınızdan utanıyor gibi görünüyorsunuz."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:168
translate tr qst_BiteBark_6_McRoomResolution_menu2_b304f3d6:

    # MC @ talk "We're not ashamed, just more reserved."
    MC @ talk "Utanmıyoruz, sadece daha çekingeniz."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:169
translate tr qst_BiteBark_6_McRoomResolution_menu2_1d981bd9:

    # MC @ talk "And there may call for an occasion where clothes {i}are{/i} needed."
    MC @ talk "Ve kıyafetlerin {i}gerektiği{/i} bir durum olabilir."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:170
translate tr qst_BiteBark_6_McRoomResolution_menu2_ff974651:

    # ELENA @ talk "Hmph... A valid point I suppose."
    ELENA @ talk "Hmph... Geçerli bir nokta sanırım."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:171
translate tr qst_BiteBark_6_McRoomResolution_menu2_6deab029:

    # ELENA @ talk "I have these rags I found scavenging..."
    ELENA @ talk "Toplayıcılık yaparken bulduğum bu paçavralar var..."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:172
translate tr qst_BiteBark_6_McRoomResolution_menu2_ccbe29ff:

    # "Elena presented to me the loose torn rags which she wrapped around herself."
    "Elena, kendine sardığı gevşek yırtık paçavraları bana sundu."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:173
translate tr qst_BiteBark_6_McRoomResolution_menu2_4e6f3ba0:

    # ELENA @ talk "Better?"
    ELENA @ talk "Daha iyi?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:174
translate tr qst_BiteBark_6_McRoomResolution_menu2_c9013ca0:

    # MC @ talk "Well... That's better than nothing."
    MC @ talk "Pekala... Bu hiç yoktan iyidir."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:175
translate tr qst_BiteBark_6_McRoomResolution_menu2_f1b02700:

    # MC @ talk "But I think something a little more pragmatic is in order than just rags."
    MC @ talk "Ama sanırım paçavralardan biraz daha pragmatik bir şey uygun olur."

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:176
translate tr qst_BiteBark_6_McRoomResolution_menu2_fb3a6f91:

    # ELENA @ grumpy "But who could we trust to make something for me?"
    ELENA @ grumpy "Ama benim için bir şey yapması için kime güvenebiliriz?"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:179
translate tr qst_BiteBark_6_McRoomResolution_menu2_f259aa9d:

    # MC "(Hmm... Perhaps the elf might be of assistance?)"
    MC "(Hmm... Belki elf yardımcı olabilir?)"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:182
translate tr qst_BiteBark_6_McRoomResolution_menu2_619ae15f:

    # MC "(I suppose I should look around the city more... There has to be someone who can help.)"
    MC "(Sanırım şehri daha fazla dolaşmalıyım... Yardım edebilecek biri olmak zorunda.)"

translate tr strings:

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:15
    old "You're not a real wolf... Are you?"
    new "Sen gerçek bir kurt değilsin... Değil mi?"

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:19
    old "Elena... Your name is Elena?"
    new "Elena... Adın Elena mı?"

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:23
    old "Why did you run off like that?"
    new "Neden öylece kaçtın?"

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:27
    old "What or who are you looking for?"
    new "Ne veya kimi arıyorsun?"

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:49
    old "Elena (wolf form)"
    new "Elena (kurt formu)"

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:74
    old "I will help you... Elena."
    new "Sana yardım edeceğim... Elena."

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:79
    old "Remain a companion to me on my travels and I will help you find Lady Thornfall."
    new "Seyahatlerimde bana bir yoldaş olarak kal ve Leydi Thornfall'ı bulmana yardım edeceğim."

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:84
    old "Do you have any coin?"
    new "Hiç akçen var mı?"

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:91
    old "Turn around for me."
    new "Benim için arkanı dön."

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:114
    old "Who is this girl? If I am to help you, I need to know more."
    new "Kim bu kız? Eğer sana yardım edeceksem, daha fazlasını bilmeliyim."

    # game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:124
    old "{image=[ICON.HEART_BROKE]} I am sorry Elena, I cannot help you"
    new "{image=[ICON.HEART_BROKE]} Üzgünüm Elena, sana yardım edemem"

