    # MARKUS "The commotion will likely draw the attention of the guards and if they see us we’re in trouble..."
    MARKUS "Kargaşa muhtemelen muhafızların dikkatini çekecek ve bizi görürlerse başımız belada..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:5
translate tr qst_DamzelDizzt_2_frontal_7c9fd421:

    # NIJAH "Y-You intend to fight zem all?!"
    NIJAH "H-Hepsiniyle dövüşmeyi mi düşünüyorsun?!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:6
translate tr qst_DamzelDizzt_2_frontal_83589d81:

