    TAREK "Yapabiliyorsanız beni öldürün!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:83
translate tr qst_DamzelDizzt_2_frontal_pit_d295606c:

    # "Tarek's lifeless body fell to the floor, torn to shreds by tooth and claw as both me and Markus greedily began to rip apart and devour pieces of his flesh."
    "Tarek'in cansız bedeni yere düştü, hem ben hem de Markus, etinin parçalarını açgözlülükle koparmaya ve yemeye başlarken diş ve pençeyle paramparça oldu."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:84
translate tr qst_DamzelDizzt_2_frontal_pit_d5cfc95c:

    # "The parasites inside grumbled in appreciation as we lapped up the delicious red meat."
    "İçerideki parazitler, lezzetli kırmızı eti höpürdetirken takdirle homurdandı."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:85
translate tr qst_DamzelDizzt_2_frontal_pit_20808736:

    # "Slowly, I pried myself away from the bloodlust towards Nijah's body, holding her in both of my arms as she gasped for air..."
    "Yavaşça, kendimi kan şehvetinden Nijah'ın bedenine doğru çektim, onu iki kolumda tuttum, o hava için nefes nefese kaldı..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:86
translate tr qst_DamzelDizzt_2_frontal_pit_1321618a:

    # "As the adrenaline passed and the beast subsided, I felt this sickening feeling inside me, my stomach twisting in knots as I looked down at her ever paler face."
    "Adrenalin geçip canavar yatışırken, içimde bu mide bulandırıcı hissi hissettim, midem düğümlendi, onun giderek daha solgun yüzüne baktım."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:87
translate tr qst_DamzelDizzt_2_frontal_pit_9326cc1e:

    # "I felt myself begin to shake as something moved within me, tears beginning to form around my glassy eyes."
    "İçimde bir şey kıpırdarken titremeye başladığımı hissettim, camsı gözlerimin etrafında yaşlar oluşmaya başladı."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:88
translate tr qst_DamzelDizzt_2_frontal_pit_238768ab:

    # "Gently, she raised a hand towards my face, carressing it before her hand went limp."
    "Nazikçe, bir elini yüzüme doğru kaldırdı, okşadı, sonra eli cansız düştü."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:93
translate tr qst_DamzelDizzt_2_frontal_pit_c57fb469:

    # MC "I'm sorry... I'm so sorry... I didn't mean for this! This wasn't supposed to happen!"
    MC "Üzgünüm... Çok üzgünüm... Bunu kastetmemiştim! Bunun olmaması gerekiyordu!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:94
translate tr qst_DamzelDizzt_2_frontal_pit_44a0beba:

    # "I roared loudly into the air, shaking the very foundations of the building as Markus reached out to grab my shoulder."
    "Havaya yüksek sesle kükredim, binanın temellerini salladım, Markus uzanıp omzumu tuttu."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:101
translate tr qst_DamzelDizzt_2_frontal_pit_f049087c:

    # MARKUS "[player_name!t]! We must go!"
    MARKUS "[player_name!t]! Gitmeliyiz!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:102
translate tr qst_DamzelDizzt_2_frontal_pit_ba6c43de:

    # MARKUS "The guards are here!"
    MARKUS "Muhafızlar burada!"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:103
translate tr qst_DamzelDizzt_2_frontal_pit_715fab03:

    # "From outside, I could hear the footsteps of the guards rushing towards us, and only at Markus' further insistance did I pull away from her."
    "Dışarıdan, muhafızların bize doğru koşan ayak seslerini duyabildim, ve sadece Markus'ın daha fazla ısrarıyla ondan uzaklaştım."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:104
translate tr qst_DamzelDizzt_2_frontal_pit_34e822c7:

    # MARKUS "(We must go! We must go now!)"
    MARKUS "(Gitmeliyiz! Şimdi gitmeliyiz!)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_3.rpy:105
translate tr qst_DamzelDizzt_2_frontal_pit_a99c644d:

