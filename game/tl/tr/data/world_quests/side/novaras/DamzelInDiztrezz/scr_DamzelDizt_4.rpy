translate tr qst_DamzelDizzt_2_afterAction_9ffb4d28:

    # NIJAH "I owe you much..."
    NIJAH "Sana çok şey borçluyum..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:33
translate tr qst_DamzelDizzt_2_afterAction_3f16aeb9:

    # "I turned to Markus who gave me a look of ‘Is she going to actually keep this quiet or not?’"
    "Markus'a döndüm, o bana 'Bunu gerçekten sessiz tutacak mı tutmayacak mı?' bakışı attı."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_4.rpy:34
translate tr qst_DamzelDizzt_2_afterAction_098d9497:

    # MC @ talk "Markus, thank you for helping me."
