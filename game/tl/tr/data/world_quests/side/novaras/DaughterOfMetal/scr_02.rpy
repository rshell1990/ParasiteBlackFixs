translate tr qst_DaughterOfMetal_02_8669d174:

    # "Arlena added, her voice faltering."
    "Arlena ekledi, sesi titriyordu."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:73
translate tr qst_DaughterOfMetal_02_eb072413:

    # "Arlena stared at me, astonished."
    "Arlena bana hayretle baktı."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:74
translate tr qst_DaughterOfMetal_02_2b558533:

    # MC @ talk "Neither me nor Markus ever meant to hurt anyone."
    MC @ talk "Ne ben ne de Markus asla kimseyi incitmek istemedik."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:75
translate tr qst_DaughterOfMetal_02_0d507896:

    # "Arlena fidgeted, she seemed to be trying to hide herself in the bottom of her drink."
    "Arlena kıpırdandı, kendini içkisinin dibinde saklamaya çalışıyor gibiydi."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:76
translate tr qst_DaughterOfMetal_02_0d0b128f:

    # MC @ talk "And we certainly never saw ourselves as better than anyone else."
    MC @ talk "Ve kesinlikle kendimizi asla kimseden daha iyi görmedik."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:77
translate tr qst_DaughterOfMetal_02_5ddef2dc:

    # MC @ talk "Yes, we wanted to climb to the top, but what kid didn’t?"
    MC @ talk "Evet, zirveye tırmanmak istedik, ama hangi çocuk istemezdi?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:78
translate tr qst_DaughterOfMetal_02_092940d3:

    # ARLENA "..."
    ARLENA "..."

