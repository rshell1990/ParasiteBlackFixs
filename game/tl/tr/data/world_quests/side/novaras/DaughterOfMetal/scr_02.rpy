translate tr qst_DaughterOfMetal_02_892b0f76:

    # ARLENA "...What?"
    ARLENA "...Ne?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:87
translate tr qst_DaughterOfMetal_02_71ada273:

    # MC @ talk "Our studies were our only shot at getting out of here."
    MC @ talk "Çalışmalarımız buradan kurtulmak için tek şansımızdı."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:88
translate tr qst_DaughterOfMetal_02_30c0104f:

    # MC @ talk "Look around you, everything is hanging on by a thread."
    MC @ talk "Etrafına bir bak, her şey pamuk ipliğine bağlı."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:89
translate tr qst_DaughterOfMetal_02_e469ca71:

    # MC @ talk "The food situation gets worse every day, between bandits choking the roads and the threat of the Demorai storming the North any day now."
    MC @ talk "Yiyecek durumu her gün daha da kötüleşiyor, haydutların yolları tıkaması ve Demorai'nin her an Kuzey'i basma tehdidi arasında."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:90
translate tr qst_DaughterOfMetal_02_c3fbba3d:

    # MC @ talk "Why are you blaming us for chasing a better life?"
    MC @ talk "Neden bizi daha iyi bir hayat kovalamakla suçluyorsun?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:91
