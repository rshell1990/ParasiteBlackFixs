translate tr qst_DaughterOfMetal_02_155f3ed5:

    # MC @ talk "Me and Markus were never opposed to having fun, y’know."
    MC @ talk "Ben ve Markus eğlenmeye asla karşı değildik, biliyorsun."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:26
translate tr qst_DaughterOfMetal_02_ee822f6b:

    # MC @ talk "We were just trying to get the grades we wanted."
    MC @ talk "Sadece istediğimiz notları almaya çalışıyorduk."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:27
translate tr qst_DaughterOfMetal_02_64f8d49b:

    # "Arlena nearly spat out her drink as she laughed."
    "Arlena gülerken içkisini neredeyse tükürüyordu."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:28
translate tr qst_DaughterOfMetal_02_9bdbfd73:

    # ARLENA "Please! You guys always thought you were better than everyone else!"
    ARLENA "Lütfen! Siz her zaman herkesten daha iyi olduğunuzu düşündünüz!"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:31
translate tr qst_DaughterOfMetal_02_d2bbd1b3:

    # ARLENA "Neither of you had the time of day for ANYONE."
    ARLENA "İkinizin de KİMSE için zamanı yoktu."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:32
translate tr qst_DaughterOfMetal_02_22fa9412:

    # ARLENA "Even that girl that followed you around like some sick little puppy."
    ARLENA "Hatta sizi hasta küçük bir köpek yavrusu gibi takip eden o kız bile."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:33
translate tr qst_DaughterOfMetal_02_29246092:

    # ARLENA "What was her name? Adi or somethin’? "
    ARLENA "Adı neydi? Adi falan mı?"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:34
translate tr qst_DaughterOfMetal_02_27137b8c:

    # ARLENA "You guys looked down your noses at EVERYONE."
    ARLENA "Herkese burnunuzun ucundan baktınız."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:35
translate tr qst_DaughterOfMetal_02_17aa9040:

    # ARLENA "{i}Assholes.{/i}"
    ARLENA "{i}Pislikler.{/i}"

