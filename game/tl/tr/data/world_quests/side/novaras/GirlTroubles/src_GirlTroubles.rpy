    # DIVINE @ sad "I-"
    DIVINE @ sad "Onun bu şekilde hissettiğini pek fark etmemiştim, onu istenmeyen hissettirmeyi asla kastetmedim."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:117
translate tr qst_girl_troubles_main_label_menu_4_cc9e4cc1:

    # DIVINE @ talk "I didn't quite realize she felt that way, I never intended to make her feel unwanted."
    DIVINE @ talk "... Pekala, Mika'ya bu akşam kule hamamında benimle buluşmasını söyle."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:118
translate tr qst_girl_troubles_main_label_menu_4_91c8563f:

    # DIVINE @ embar "... Very well, tell Mika to meet me in the tower bathhouse tonight."
    DIVINE @ embar "Onun borcunu tamamen kapatacağım."

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:119
