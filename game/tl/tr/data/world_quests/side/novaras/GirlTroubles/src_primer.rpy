    # "The two girls scurried away ... Looks like this might be tougher than it looks."
    "İki kız aceleyle kaçtı... Görünüşe göre bu, göründüğünden daha zor olabilir."

# game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:328
translate tr primer_girl_troubles_2_menu_repeat_5fce831d:

    # DIVINE @ talk "Have you decided whether you'll help me?"
    DIVINE @ talk "Bana yardım edip etmeyeceğine karar verdin mi?"

translate tr strings:

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:67
    old "Have you tried appealing to the higher-ups?"
    new "Üst makamlara başvurmayı denedin mi?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:72
    old "Forgive me, but people die in war... As horrible as it may be Sister, it's almost inevitable some won't come home."
    new "Affedersiniz, ama insanlar savaşta ölür... Ne kadar korkunç olsa da Kız Kardeş, bazılarının eve dönmemesi neredeyse kaçınılmazdır."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:78
    old "I'm still waiting to hear what I have to do with this..."
    new "Hala bununla ne ilgim olduğunu duymayı bekliyorum..."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:94
    old "But why ask me?"
    new "Ama neden bana soruyorsun?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:101
    old "What do you mean by {i}you don't care what I do?{/i}"
    new "{i}Ne yaptığım umurumda değil{/i} ile ne demek istiyorsun?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:105
    old "Who are the girls?"
    new "Kızlar kim?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:108
    old "Is it truly that shameful for them?"
    new "Bu, onlar için gerçekten o kadar utanç verici mi?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:119
    old "And one of these girls comes from these families, I take it?"
    new "Ve bu kızlardan biri, bu ailelerden geliyor, anladığım kadarıyla?"

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:124
    old "I will help you."
    new "Sana yardım edeceğim."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:132
    old "Tell me about Jana."
    new "Bana Jana'dan bahset."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:148
    old "Tell me about Zara."
    new "Bana Zara'dan bahset."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:171
    old "Tell me about Mika."
    new "Bana Mika'dan bahset."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:197
    old "I think that's it."
    new "Sanırım bu kadar."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:201
    old "Tell me about the girls again."
    new "Bana kızlar hakkında tekrar bahset."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:206
    old "Let's meet the girls."
    new "Kızlarla tanışalım."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:211
    old "I'll get back to you on it shortly."
    new "Yakında sana döneceğim."

    # game/data/world_quests/side/novaras/GirlTroubles/src_primer.rpy:217
    old "I'll need some time to think on this."
    new "Bunun üzerinde düşünmek için biraz zamana ihtiyacım olacak."

