translate tr qst_HumanExp_9_valaLearnSlimelarks_cfc74e71:

    # VALA "Umm, I think they're mentioned in a couple bestiaries, but there's nothing devoted just to them."
    VALA "Umm, sanırım birkaç bestiary'de bahsediliyorlar, ama sadece onlara adanmış bir şey yok."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:650
translate tr qst_HumanExp_9_valaLearnSlimelarks_fbc08ab9:

    # MC @ talk "Do you have one of these bestiaries?"
    MC @ talk "Bu bestiary'lerden biri sende var mı?"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:651
translate tr qst_HumanExp_9_valaLearnSlimelarks_e33b273c:

    # VALA "I can try gather you up some if that's what you want..."
    VALA "Eğer istediğin buysa, senin için onları toplamayı deneyebilirim..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:652
translate tr qst_HumanExp_9_valaLearnSlimelarks_29beeb65:

    # VALA "What's this about?"
    VALA "Bu ne hakkında?"

