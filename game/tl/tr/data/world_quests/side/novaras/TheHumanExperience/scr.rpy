translate tr qst_HumanExp_8_shayGetBetterFood_b5f23e75:

    # SHAY @ talk "Nice to see my cooking is still up to standard then!"
    SHAY @ talk "Yemek pişirmemin hala standartta olduğunu görmek güzel o zaman!"

