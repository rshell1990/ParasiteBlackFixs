# game/data/world_romance/nijah/scr_firstpreg.rpy:8
translate tr preg_Nijah_goodNews_intro_88e7e95f:

    # "As I entered her home, Nijah came to me with hands clasped, nervous."
    "Evine girdiğimde, Nijah ellerini kavuşturmuş, gergin bir şekilde bana geldi."

# game/data/world_romance/nijah/scr_firstpreg.rpy:9
translate tr preg_Nijah_goodNews_intro_1fa9f7ad:

    # NIJAH "Must speak with you."
    NIJAH "Seninle konuşmam gerek."

# game/data/world_romance/nijah/scr_firstpreg.rpy:10
translate tr preg_Nijah_goodNews_intro_b7dc45a3:

    # "Sensing her distress, I placed my hands on her shoulders."
    "Sıkıntısını sezerek, ellerimi omuzlarına koydum."

# game/data/world_romance/nijah/scr_firstpreg.rpy:11
translate tr preg_Nijah_goodNews_intro_89f5ce92:

    # MC @ talk "Nijah, what’s wrong?"
    MC @ talk "Nijah, sorun ne?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:12
translate tr preg_Nijah_goodNews_intro_82be8c65:

    # NIJAH "I... I carry your child."
    NIJAH "Ben... Ben senin çocuğunu taşıyorum."

# game/data/world_romance/nijah/scr_firstpreg.rpy:13
translate tr preg_Nijah_goodNews_intro_f3a940fc:

    # "I pulled back, surprised at the comment."
    "Yoruma şaşırarak geri çekildim."

# game/data/world_romance/nijah/scr_firstpreg.rpy:14
translate tr preg_Nijah_goodNews_intro_4f601cd6:

    # MC @ talk "...{i}You’re pregnant?{/i}"
    MC @ talk "...{i}Hamile misin?{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:15
translate tr preg_Nijah_goodNews_intro_a5178513:

    # "Nijah sheepishly nodded."
    "Nijah mahcupça başını salladı."

# game/data/world_romance/nijah/scr_firstpreg.rpy:16
translate tr preg_Nijah_goodNews_intro_9a450cee:

    # NIJAH "...Zis not problem?"
    NIJAH "...Bu sorun değil mi?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:17
translate tr preg_Nijah_goodNews_intro_b323444e:

    # MC @ talk "What do you mean?"
    MC @ talk "Ne demek istiyorsun?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:18
translate tr preg_Nijah_goodNews_intro_12df316d:

    # NIJAH "M-any Alderian men... They get Ramonian girls with child and go."
    NIJAH "B-Birçok Alderialı erkek... Ramonian kızlarını çocuk sahibi yapıp gidiyorlar."

# game/data/world_romance/nijah/scr_firstpreg.rpy:19
translate tr preg_Nijah_goodNews_intro_75857ca2:

    # NIJAH "...many forced to get rid of child while still in womb."
    NIJAH "...birçoğu daha rahimdeyken çocuktan kurtulmaya zorlanıyor."

# game/data/world_romance/nijah/scr_firstpreg.rpy:20
translate tr preg_Nijah_goodNews_intro_5df92709:

    # NIJAH "But... I want to keep your child."
    NIJAH "Ama... Ben senin çocuğunu tutmak istiyorum."

# game/data/world_romance/nijah/scr_firstpreg.rpy:21
translate tr preg_Nijah_goodNews_intro_ff1bdef9:

    # BLACK "She is fit to carry many of our young."
    BLACK "O, bizim birçok yavrumuzu taşımaya uygun."

# game/data/world_romance/nijah/scr_firstpreg.rpy:22
translate tr preg_Nijah_goodNews_intro_d75d061d:

    # BLACK "We should keep this one close as a mate."
    BLACK "Bunu eş olarak yakın tutmalıyız."

# game/data/world_romance/nijah/scr_firstpreg.rpy:23
translate tr preg_Nijah_goodNews_intro_2cebcdc8:

    # MC @ talk "...Nijah, I-"
    MC @ talk "...Nijah, ben—"

# game/data/world_romance/nijah/scr_firstpreg.rpy:24
translate tr preg_Nijah_goodNews_intro_2cb4cedf:

    # NIJAH "I do not care if child can change into monster like you."
    NIJAH "Çocuğun senin gibi canavara dönüşüp dönüşmemesi umurumda değil."

# game/data/world_romance/nijah/scr_firstpreg.rpy:25
translate tr preg_Nijah_goodNews_intro_ac59f889:

    # NIJAH "It is {i}our{/i} baby, and that is good enough for me."
    NIJAH "O {i}bizim{/i} bebeğimiz, ve bu benim için yeterince iyi."

# game/data/world_romance/nijah/scr_firstpreg.rpy:26
translate tr preg_Nijah_goodNews_intro_a51e43f2:

    # "Nijah seemed to wait anxiously for a few moments. Almost stand-offish, perhaps expecting me to tell her to get rid of the child or that I didn’t want to see her anymore."
    "Nijah birkaç an endişeyle bekledi. Neredeyse mesafeli, belki de ona çocuktan kurtulmasını ya da artık onu görmek istemediğimi söylememi bekliyordu."

# game/data/world_romance/nijah/scr_firstpreg.rpy:27
translate tr preg_Nijah_goodNews_intro_abd548b8:

    # MC @ talk "Nijah... {i}You are mine.{/i}"
    MC @ talk "Nijah... {i}Sen benimsin.{/i}"

# game/data/world_romance/nijah/scr_firstpreg.rpy:28
translate tr preg_Nijah_goodNews_intro_e7158e0a:

    # MC @ talk "I am pleased you carry my child."
    MC @ talk "Çocuğumu taşıdığın için memnunum."

# game/data/world_romance/nijah/scr_firstpreg.rpy:29
translate tr preg_Nijah_goodNews_intro_d62be6ae:

    # "Nijah’s eyes seemed to light up."
    "Nijah'ın gözleri parladı gibiydi."

# game/data/world_romance/nijah/scr_firstpreg.rpy:30
translate tr preg_Nijah_goodNews_intro_84ee69e2:

    # NIJAH "R-Really?"
    NIJAH "G-Gerçekten mi?"

# game/data/world_romance/nijah/scr_firstpreg.rpy:31
translate tr preg_Nijah_goodNews_intro_78ec95d9:

    # "With a bright smile, Nijah flung herself onto me, planting kiss onto my lips."
    "Parlak bir gülümsemeyle, Nijah kendini bana attı, dudaklarıma öpücük kondurdu."

# game/data/world_romance/nijah/scr_firstpreg.rpy:32
translate tr preg_Nijah_goodNews_intro_6bcb1c75:

    # NIJAH "M-Master... I love you so much!"
    NIJAH "E-Efendi... Seni çok seviyorum!"

# game/data/world_romance/nijah/scr_firstpreg.rpy:33
translate tr preg_Nijah_goodNews_intro_cb9042a3:

    # MC @ talk "Nijah, you know you don’t need to-"
    MC @ talk "Nijah, buna gerek olmadığını—"

# game/data/world_romance/nijah/scr_firstpreg.rpy:34
translate tr preg_Nijah_goodNews_intro_436f3b45:

    # "Nijah interrupted me again mid-sentence to plant another kiss on my lips."
    "Nijah cümle ortasında dudaklarıma başka bir öpücük kondurmak için beni tekrar böldü."

# game/data/world_romance/nijah/scr_firstpreg.rpy:35
translate tr preg_Nijah_goodNews_intro_0a0c7479:

    # NIJAH "I shall get some dinner on, stay a while."
    NIJAH "Akşam yemeği hazırlayayım, biraz kal."

# game/data/world_romance/nijah/scr_firstpreg.rpy:36
translate tr preg_Nijah_goodNews_intro_2eb2dd4a:

    # "With that, Nijah turned, humming happily to herself as she made her way to the kitchen to prepare some food."
    "Bununla, Nijah döndü, biraz yemek hazırlamak için mutfağa giderken kendi kendine mutlu bir şekilde mırıldandı."

# game/data/world_romance/nijah/scr_firstpreg.rpy:41
translate tr preg_Nijah_goodNews_intro_6c38b146:

    # "After eating with Nijah, I departed once again, thinking about my soon to be new-born child I was now having with Nijah."
    "Nijah ile yemek yedikten sonra, yakında Nijah ile sahip olacağım yeni doğacak çocuğumu düşünerek bir kez daha ayrıldım."

