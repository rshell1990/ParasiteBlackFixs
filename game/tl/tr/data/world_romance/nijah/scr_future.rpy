translate tr rom_Nijah_stage1_future_lines_menu_88ce21a9:

    # MC @ talk "I’ll pay for you to have your own room."
    MC @ talk "Sana kendi odanı alman için para vereceğim."

# game/data/world_romance/nijah/scr_future.rpy:44
translate tr rom_Nijah_stage1_future_lines_menu_ba9be3de:

    # MC @ talk "As a Novaras citizen, I can quickly and legally get the paperwork you need."
    MC @ talk "Bir Novaras vatandaşı olarak, ihtiyacın olan evrak işlerini hızlı ve yasal olarak halledebilirim."

# game/data/world_romance/nijah/scr_future.rpy:45
translate tr rom_Nijah_stage1_future_lines_menu_1ef1adfd:

    # MC @ talk "I can also guarantee you have some protection that before you was not privy to."
    MC @ talk "Ayrıca daha önce sahip olmadığın bir koruma sağlayabilirim."

# game/data/world_romance/nijah/scr_future.rpy:46
translate tr rom_Nijah_stage1_future_lines_menu_a4b7cc57:

    # MC "Nijah pondered the thought a moment, hesistant about the idea of returning to her old line of work."
    MC "Nijah düşünceyi bir an düşündü, eski işine dönme fikri konusunda tereddütlüydü."

# game/data/world_romance/nijah/scr_future.rpy:47
translate tr rom_Nijah_stage1_future_lines_menu_9cc15501:

    # NIJAH "This... would be better."
    NIJAH "Bu... daha iyi olur."

