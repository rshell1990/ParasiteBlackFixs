# game/data/world_romance/nijah/scr_future.rpy:34
translate tr rom_Nijah_stage1_future_lines_menu_a6b98d5f:

    # "Nijah hurried forward, wrapping her arms around me in a tight hug, when she pulled back, she smiled warmly, tears streaming down her cheeks in joy."
    "Nijah ileri acele etti, kollarını sıkı bir sarılmada bana doladı, geri çekildiğinde, sıcak bir şekilde gülümsedi, yanaklarından sevinçle yaşlar süzüldü."

# game/data/world_romance/nijah/scr_future.rpy:38
translate tr rom_Nijah_stage1_future_lines_menu_a997409b:

    # NIJAH "Alright... I trust you... I shall wait for you."
    NIJAH "Pekala... Sana güveniyorum... Seni bekleyeceğim."

# game/data/world_romance/nijah/scr_future.rpy:42
translate tr rom_Nijah_stage1_future_lines_menu_b41866ee:

    # NIJAH "You... Vat?"
    NIJAH "Sen... Ne?"

