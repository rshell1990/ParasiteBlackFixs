# game/data/characters/arwen/dialogue.rpy:103
translate zh dialogue_arwen_services_cel_779f3c4e:

    # ARWEN @ angry "Do you know how much this outfit cost to make?"
    ARWEN @ angry "你知道这套装扮花了多少钱吗？"

# game/data/characters/arwen/dialogue.rpy:104
translate zh dialogue_arwen_services_cel_0f93cc2b:

    # ARWEN @ talk "Plus all the rallies and things I had to attend to learn to act like her a bit."
    ARWEN @ talk "还有我为了学她举止参加的所有集会活动。"

# game/data/characters/arwen/dialogue.rpy:105
translate zh dialogue_arwen_services_cel_84c11618:

    # ARWEN @ laugh "Besides... I offer a {i}unique{/i} experience unlike what my clients normally get."
    ARWEN @ laugh "而且...我提供{i}独特{/i}的体验，与客户平常得到的完全不同。"

# game/data/characters/arwen/dialogue.rpy:106
translate zh dialogue_arwen_services_cel_c7c5bcc5:

    # ARWEN @ talk "So, fifteen hundred. Interested?"
    ARWEN @ talk "所以，一千五。有兴趣吗？"

# game/data/characters/arwen/dialogue.rpy:109
translate zh dialogue_arwen_services_cel_67a3c006:

    # ARWEN @ talk "Then if you don't mind, other customers are waiting."
    ARWEN @ talk "那么如果你不介意的话，其他客人还在等着呢。"

