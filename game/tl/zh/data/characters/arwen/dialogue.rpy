# game/data/characters/arwen/dialogue.rpy:79
translate zh arwen_talk_celeste_324c5a69:

    # ARWEN @ talk "Why hello there brave adventurer!"
    ARWEN @ talk "哎呀，勇敢的冒险家你好呀！"

# game/data/characters/arwen/dialogue.rpy:80
translate zh arwen_talk_celeste_30f5cc47:

    # ARWEN @ talk "Tell me, {i}how much coin would you pay to spend a night with the beautiful Celeste?{/i}"
    ARWEN @ talk "告诉我，{i}你愿意花多少金币与美丽的塞莱斯特共度良宵？{/i}"

# game/data/characters/arwen/dialogue.rpy:81
translate zh arwen_talk_celeste_4f6d740f:

    # ARWEN @ talk "Actually, don't even answer that!"
    ARWEN @ talk "其实，你都不用回答！"

# game/data/characters/arwen/dialogue.rpy:82
translate zh arwen_talk_celeste_da29d70f:

    # ARWEN @ talk "We both know that such priceless things would be worth their weight in gold... {i}till now.{/i}"
    ARWEN @ talk "我们都知道这种无价之宝值得用等重的黄金交换...{i}直到现在{/i}。"

# game/data/characters/arwen/dialogue.rpy:88
translate zh arwen_bye_cel_84e04ea5:

    # ARWEN @ talk "Very well."
    ARWEN @ talk "好吧。"

# game/data/characters/arwen/dialogue.rpy:93
translate zh arwen_whyCeleste_259711d9:

    # ARWEN @ laugh "Because... {i}Who doesn't want to fuck the most beautiful, famous heroine around?{/i}"
    ARWEN @ laugh "因为...{i}谁不想和这附近最美丽著名的女英雄上床呢？{/i}"

# game/data/characters/arwen/dialogue.rpy:94
translate zh arwen_whyCeleste_9530a2ec:

    # ARWEN @ talk "People will pay whatever I ask if they think they'll get at least a taste of what it might be like to have her."
    ARWEN @ talk "只要人们觉得能尝到拥有她的滋味，无论我要价多少他们都会付。"

# game/data/characters/arwen/dialogue.rpy:95
translate zh arwen_whyCeleste_e7a80d41:

    # ARWEN @ talk "Fantasy is a powerful thing... The reality of something rarely meets the expectation."
    ARWEN @ talk "幻想是强大的力量...现实很少能满足期望。"

# game/data/characters/arwen/dialogue.rpy:96
translate zh arwen_whyCeleste_67cb03f1:

    # MC @ talk "Very insightful of you."
    MC @ talk "你真是洞见深刻。"

# game/data/characters/arwen/dialogue.rpy:97
translate zh arwen_whyCeleste_aa10a873:

    # ARWEN @ laugh "I try."
    ARWEN @ laugh "我会尽力而为的。"

# game/data/characters/arwen/dialogue.rpy:101
translate zh dialogue_arwen_services_cel_ec508417:

    # ARWEN @ talk "Fifteen hundred coins and {i}Celeste{/i} is all yours."
    ARWEN @ talk "一千五百金币，{i}塞莱斯特{/i}就归你了。"

# game/data/characters/arwen/dialogue.rpy:102
translate zh dialogue_arwen_services_cel_8b30ba46:

    # MC @ talk "That's more than your normal rates..."
