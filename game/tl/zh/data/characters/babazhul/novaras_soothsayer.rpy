# game/data/characters/babazhul/novaras_soothsayer.rpy:44
translate zh nov_soothsayer_firstmeet_90717a1f:

    # "Entering into the darkened room of the soothsayer I looked around."
    "走进预言家昏暗的房间，我环顾四周。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:45
translate zh nov_soothsayer_firstmeet_7bd2c3f6:

    # "The room was dimly lit only by pale candle light, with strange trinkets from faraway lands adorning every corner of the room, strange skulls and books in ancient tongues long since dead."
    "房间仅靠微弱的烛光照亮，每个角落都装饰着来自遥远国度的奇异小饰品，古怪的头骨和用早已消亡的古老语言写成的书籍。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:46
translate zh nov_soothsayer_firstmeet_406bc049:

    # "Here and there was a stuffed bird or some scroll with strange markings on it littered around on the floor amongst the pile of many books."
    "地板上散落着成堆的书籍，其间零星可见填充的鸟类标本或刻有奇异符号的卷轴。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:47
translate zh nov_soothsayer_firstmeet_5d595e11:

    # "The old hag was sat down at her seat, hunched over her desk looming over a crystal ball as she looked towards me expectantly."
    "那个老巫婆坐在她的座位上，佝偻着身子伏在书桌上，凝视着一个水晶球，同时满怀期待地望向我。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:49
translate zh nov_soothsayer_firstmeet_f1746c4b:

    # BABAZHUL "Greetings, child of tooth and claw."
    BABAZHUL "欢迎到来，利齿与利爪之子。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:50
translate zh nov_soothsayer_firstmeet_783baad9:

    # BABAZHUL "How may Babazhul help you?"
    BABAZHUL "芭芭祖能为你做些什么？"

# game/data/characters/babazhul/novaras_soothsayer.rpy:51
translate zh nov_soothsayer_firstmeet_44f8b91f:

    # MC "Hm? Child of what?"
    MC "嗯？什么之子？"

# game/data/characters/babazhul/novaras_soothsayer.rpy:52
translate zh nov_soothsayer_firstmeet_5ce13e03:

    # MC "What are you talking about?"
    MC "你在说什么？"

# game/data/characters/babazhul/novaras_soothsayer.rpy:57
translate zh nov_soothsayer_firstmeet_70e666cf:

    # BABAZHUL "{i}The old gods stir with the new, the great games' next chapter shall soon begin.{/i}"
    BABAZHUL "{i}旧神与新神一同骚动，伟大游戏的下一个篇章即将开启。{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:58
translate zh nov_soothsayer_firstmeet_909f2c0d:

    # BABAZHUL "{i}A great warrior shall join you, the great tooth and claw, a forgotten lord from a time lost beyond the stars.{/i}"
    BABAZHUL "{i}一位伟大的战士将加入你，那伟大的利齿与利爪，一位来自星辰之外失落时代的被遗忘之主。{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:59
translate zh nov_soothsayer_firstmeet_92a43a18:

    # BABAZHUL "{i}To battle the dreaming king, whose restless fury shall scorch these lands.{/i}"
    BABAZHUL "{i}去对抗那梦中之王吧，他那永不安息的怒火将焚毁这片土地。{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:60
translate zh nov_soothsayer_firstmeet_127488ac:

    # MC "What the~"
    MC "搞什么~"

# game/data/characters/babazhul/novaras_soothsayer.rpy:61
translate zh nov_soothsayer_firstmeet_086e21f9:

    # MC "Gods? A Dreaming king? Great warriors?"
    MC "神？梦中之王？伟大的战士？"

# game/data/characters/babazhul/novaras_soothsayer.rpy:64
translate zh nov_soothsayer_firstmeet_8e3236f6:

    # "The soothsayer went silent for a moment, before continuing in her raspy voice:"
    "预言家沉默了片刻，然后用她沙哑的声音继续说道："

# game/data/characters/babazhul/novaras_soothsayer.rpy:66
translate zh nov_soothsayer_firstmeet_9cbf7f9a:

    # MC "...How did you know my-"
    MC "...你怎么知道我的-"

# game/data/characters/babazhul/novaras_soothsayer.rpy:67
translate zh nov_soothsayer_firstmeet_f1768875:

    # BABAZHUL "Hahahaha!"
    BABAZHUL "哈哈哈！"

# game/data/characters/babazhul/novaras_soothsayer.rpy:71
translate zh nov_soothsayer_firstmeet_3d82d3ee:

    # MC "How did you know my name?"
    MC "你怎么知道我的名字？"

# game/data/characters/babazhul/novaras_soothsayer.rpy:72
translate zh nov_soothsayer_firstmeet_f14bc448:

    # BABAZHUL @ talk "Babazhul knows many names, many things that have passed and are yet to pass."
    BABAZHUL @ talk "芭芭祖知晓许多名字，许多已然发生和尚未发生的事情。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:75
translate zh nov_soothsayer_firstmeet_ea08ba0d:

    # BABAZHUL @ talk "Now tell me child of tooth and claw, do you seek your past... {i}or your future?{/i}"
    BABAZHUL @ talk "现在告诉我，利齿与利爪之子，你追寻的是你的过去...{i}还是你的未来？{/i}"

# game/data/characters/babazhul/novaras_soothsayer.rpy:76
translate zh nov_soothsayer_firstmeet_c58e7a45:

    # BABAZHUL @ talk "For but five gold, it can be yours..."
    BABAZHUL @ talk "只需五枚金币，它就能属于你..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:86
translate zh nov_soothsayer_talk_c96029cf:

    # BABAZHUL @ talk "Welcome back, child of tooth and claw."
    BABAZHUL @ talk "欢迎回来，利齿与利爪之子。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:87
translate zh nov_soothsayer_talk_ea89362c:

    # BABAZHUL @ talk "Make your choice."
    BABAZHUL @ talk "做出你的选择吧。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:98
translate zh nov_soothsayer_future_b2637f25:

    # BABAZHUL @ talk "So be it."
    BABAZHUL @ talk "那就如你所愿。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:101
translate zh nov_soothsayer_future_c6eccf04:

    # "Babazhul hands lightly touched over her crystal ball, which brightly began to glow and illuminate as she stared deeply into it with her half blind eyes."
    "芭芭祖的手轻轻拂过她的水晶球，当她用半盲的双眼深深凝视它时，水晶球开始发出明亮的光芒。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:112
translate zh nov_soothsayer_future_3add1f07:

    # BABAZHUL @ talk "In time, perhaps, there might be clarity..."
    BABAZHUL @ talk "假以时日，或许会有清晰的景象..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:113
translate zh nov_soothsayer_future_fbf25a5c:

    # BABAZHUL @ talk "For now, I can see no more."
    BABAZHUL @ talk "但现在，我无法看到更多了。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:117
translate zh nov_soothsayer_future_4424f154:

    # BABAZHUL @ talk "You do not possess enough coin, child, return when you do."
    BABAZHUL @ talk "你的金币不够，孩子，等你有了再来吧。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:124
translate zh nov_soothsayer_goodbye_91ee6e03:

    # BABAZHUL @ talk "{i}*Laughs*{/i} Of course you will return... I've already foreseen it."
    BABAZHUL @ talk "{i}*大笑*{/i} 你当然会回来...我早已预见到了。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:133
translate zh nov_soothsayer_future0_bd41ac2b:

    # BABAZHUL @ talk "I see a great shadow following you, a warrior of a thousand worlds."
    BABAZHUL @ talk "我看见一个巨大的阴影跟随着你，一位来自千界的战士。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:134
translate zh nov_soothsayer_future0_62ae2cf6:

    # BABAZHUL @ talk "Sitting on a throne of bones, so alone and so cold."
    BABAZHUL @ talk "坐在骸骨的王座上，如此孤独，如此冰冷。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:135
translate zh nov_soothsayer_future0_1c0474f3:

    # BABAZHUL @ talk "He would sit forever... Enjoy the silence, if not for his master's call."
    BABAZHUL @ talk "他本可永远坐下去...享受那份寂静，若非他主人的召唤。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:143
translate zh nov_soothsayer_future1_c59e6106:

    # BABAZHUL @ talk "Hahaha! I see her fire, Princess raised by shadows and knives, born into a lie."
    BABAZHUL @ talk "哈哈哈！我看到了她的火焰，被阴影与利刃抚养长大的公主，生于谎言之中。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:144
translate zh nov_soothsayer_future1_34e35823:

    # BABAZHUL @ talk "The great stars lay before her, and perhaps you at her side."
    BABAZHUL @ talk "浩瀚星辰铺展在她面前，而你或许就在她身边。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:145
translate zh nov_soothsayer_future1_36bd14f0:

    # BABAZHUL @ talk "Oh child of tooth and claw, we shall see if love can truly conquer all!"
    BABAZHUL @ talk "哦，利齿与利爪之子，我们将见证爱是否真能征服一切！"

# game/data/characters/babazhul/novaras_soothsayer.rpy:153
translate zh nov_soothsayer_future2_d966afcc:

    # BABAZHUL @ talk "The imitation stalks these lands, a beautiful souless beast."
    BABAZHUL @ talk "那仿制品在这片土地上潜行，一只美丽而无魂的野兽。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:154
translate zh nov_soothsayer_future2_beae5065:

    # BABAZHUL @ talk "Nothing but death awaits, yet how sweet will she be when she poisons your soul with honey."
    BABAZHUL @ talk "等待你的唯有死亡，然而当她用蜜糖毒害你的灵魂时，她将是多么甜美。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:155
translate zh nov_soothsayer_future2_9bd746f0:

    # BABAZHUL @ talk "See past the lies and beware, beware child of tooth and claw:"
    BABAZHUL @ talk "看穿谎言并小心，小心啊利齿与利爪之子："

# game/data/characters/babazhul/novaras_soothsayer.rpy:156
translate zh nov_soothsayer_future2_02815b56:

    # BABAZHUL @ talk "The beautiful souless beast may be your demise."
    BABAZHUL @ talk "那美丽而无魂的野兽或许就是你的终结。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:164
translate zh nov_soothsayer_future3_f914e12e:

    # BABAZHUL @ talk "My my, child! Such sweet fruits await! One in green, one in blue, one with scales, one so small, you could carry four! Hahaha!"
    BABAZHUL @ talk "哎呀呀，孩子！如此甜美的果实正等待着你！一个绿衣，一个蓝衣，一个身披鳞片，一个娇小玲珑，你足以怀抱四个！哈哈哈！"

# game/data/characters/babazhul/novaras_soothsayer.rpy:165
translate zh nov_soothsayer_future3_5a07672c:

    # BABAZHUL @ talk "Their love will guide you through the darkness to come, cling to it, embrace it, hold them dear and close."
    BABAZHUL @ talk "她们的爱将指引你穿越即将到来的黑暗，紧握它，拥抱它，珍视她们，将她们拥在身旁。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:166
translate zh nov_soothsayer_future3_f7410e2c:

    # BABAZHUL @ talk "For when the time comes, you must face the darkness alone..."
    BABAZHUL @ talk "因为当那一刻来临，你必须独自面对黑暗..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:174
translate zh nov_soothsayer_future4_37ac8a1d:

    # BABAZHUL @ talk "He sits at the helm of ultimate destruction, more ghost than man but he will return home."
    BABAZHUL @ talk "他执掌着终极毁灭之舵，与其说是人不如说是幽灵，但他终将归家。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:175
translate zh nov_soothsayer_future4_68e013f7:

    # BABAZHUL @ talk "Oh child of tooth and claw, to forever be reaching for the past is a terrible thing."
    BABAZHUL @ talk "哦，利齿与利爪之子，永远沉溺于过去是件可怕的事。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:176
translate zh nov_soothsayer_future4_41a33087:

    # BABAZHUL @ talk "It may make monsters of us all..."
    BABAZHUL @ talk "它可能将我们所有人都变成怪物..."

# game/data/characters/babazhul/novaras_soothsayer.rpy:184
translate zh nov_soothsayer_future5_521823e0:

    # BABAZHUL @ talk "I see two brothers, stood on opposite cliffs."
    BABAZHUL @ talk "我看见两兄弟，站在相对的悬崖上。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:185
translate zh nov_soothsayer_future5_9eb10f6e:

    # BABAZHUL @ talk "A terrible storm rages, the black waves thrashing beneath their feet."
    BABAZHUL @ talk "一场可怕的风暴肆虐着，黑色的海浪在他们脚下翻腾。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:186
translate zh nov_soothsayer_future5_60b3ce80:

    # BABAZHUL @ talk "Both weep... But the fire inside makes them scream."
    BABAZHUL @ talk "两人都在哭泣...但内心的火焰让他们嘶吼。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:187
translate zh nov_soothsayer_future5_2126ec51:

    # BABAZHUL @ talk "How the ones we love cut so deep."
    BABAZHUL @ talk "我们所爱之人伤我们如此之深。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:195
translate zh nov_soothsayer_future6_7454759e:

    # BABAZHUL @ talk "Grief... I feel his grief."
    BABAZHUL @ talk "悲痛...我感受到了他的悲痛。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:196
translate zh nov_soothsayer_future6_d647c32f:

    # BABAZHUL @ talk "It has made a monster of him, and it drives him to do terrible things."
    BABAZHUL @ talk "这已将他变成了怪物，并驱使他做出可怕之事。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:197
translate zh nov_soothsayer_future6_7a7c1972:

    # BABAZHUL @ talk "But his fate is not yet sealed."
    BABAZHUL @ talk "但他的命运尚未注定。"

# game/data/characters/babazhul/novaras_soothsayer.rpy:198
translate zh nov_soothsayer_future6_c96105ba:

    # BABAZHUL @ talk "What will become of him?"
    BABAZHUL @ talk "他将何去何从？"

translate zh strings:

    # game/data/characters/babazhul/novaras_soothsayer.rpy:22
    old "Talk to Babazhul"
    new "与芭芭祖对话"

    # game/data/characters/babazhul/novaras_soothsayer.rpy:32
    old "Speak to me of the future, soothsayer."
    new "预言家，告诉我未来之事。"

    # game/data/characters/babazhul/novaras_soothsayer.rpy:34
    old "I long to walk through my past once again."
    new "我渴望再次漫步于我的过去。"

    # game/data/characters/babazhul/novaras_soothsayer.rpy:36
    old "I will return in time."
    new "我会适时回来的。"
