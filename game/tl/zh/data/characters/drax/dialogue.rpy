translate zh drax_bronzeDeliverRepeat_f426fc41:

    # DRAX "No, that won't do."
    DRAX "不行，这不够。"

# game/data/characters/drax/dialogue.rpy:65
translate zh drax_bronzeDeliverRepeat_f30b4de7:

    # DRAX "Come back after you've scavenged more bronze."
    DRAX "收集更多青铜后再来找我。"

# game/data/characters/drax/dialogue.rpy:70
translate zh drax_bronzeDeliverRepeat_5650b7ba:

    # DRAX "ARLENAAAAA!"
    DRAX "艾琳娜——！"

# game/data/characters/drax/dialogue.rpy:71
translate zh drax_bronzeDeliverRepeat_0492f5f9:

    # DRAX "WE HAVE BRONZE!"
    DRAX "青铜到货了！"

# game/data/characters/drax/dialogue.rpy:73
translate zh drax_bronzeDeliverRepeat_ba0ec503:

    # "Arlena emerged once again with her arms folded."
    "艾琳娜再次出现，双臂交叉抱在胸前。"

# game/data/characters/drax/dialogue.rpy:78
translate zh drax_bronzeDeliverRepeat_d11ff72d:

    # ARLENA "Not bad... Who knows? Maybe one day you'll be able to improve your personality like you've done your work ethic!"
    ARLENA "还不赖...谁知道呢？说不定哪天你的性格也能像工作态度这样长进些！"

# game/data/characters/drax/dialogue.rpy:80
translate zh drax_bronzeDeliverRepeat_dfe83138:

    # ARLENA "Hmph... It's better than nothing I suppose. Don't be getting sloppy on us now!"
    ARLENA "哼...总比没还好。可别现在就开始偷懒！"

# game/data/characters/drax/dialogue.rpy:82
translate zh drax_bronzeDeliverRepeat_b203b2ec:

    # ARLENA "I'm almost impressed!"
    ARLENA "我差点就要对你刮目相看了！"

# game/data/characters/drax/dialogue.rpy:84
translate zh drax_bronzeDeliverRepeat_269c09d7:

    # ARLENA "Urgh... Just take your gold and get out of here, I'm in no mood for you today."
    ARLENA "呃...拿着你的金币赶紧走，今天没心情应付你。"

# game/data/characters/drax/dialogue.rpy:94
translate zh drax_shop_first_e2d8bf63:

    # DRAX "Of course."
    DRAX "当然可以。"

# game/data/characters/drax/dialogue.rpy:95
translate zh drax_shop_first_697cf030:

    # DRAX "Take a peak and see if anything catches your eye..."
    DRAX "看看有没有中意的..."

# game/data/characters/drax/dialogue.rpy:109
translate zh drax_shop_7918a933:

    # DRAX "Take a look."
    DRAX "看看吧。"

# game/data/characters/drax/dialogue.rpy:114
translate zh drax_questions_53c1e4f7:

    # DRAX "What do you want to know?"
    DRAX "你想知道什么？"

# game/data/characters/drax/dialogue.rpy:118
translate zh drax_qChanges_3056e47e:

    # DRAX "Not much to be honest, business carries on as usual here."
    DRAX "老实说没什么变化，生意照常。"

# game/data/characters/drax/dialogue.rpy:119
translate zh drax_qChanges_90be5fd6:

    # DRAX "Usual petty neighbour drama shite, more Black Mages getting caught..."
    DRAX "老一套的邻里八卦破事，更多黑法师被抓..."

# game/data/characters/drax/dialogue.rpy:120
translate zh drax_qChanges_7d6bd86a:

    # DRAX "Biggest thing that’s happened for a while is you two coming home the way you did!"
    DRAX "这段时间最大的事就是你们俩这样回来了！"

# game/data/characters/drax/dialogue.rpy:124
translate zh drax_qBooks_629545c6:

    # DRAX "If you figure that one out..."
    DRAX "要是你能找到办法..."

# game/data/characters/drax/dialogue.rpy:125
translate zh drax_qBooks_ddd935a1:

    # "Drax placed his hand on my shoulder as he smiled."
    "德拉克斯微笑着把手搭在我肩上。"

# game/data/characters/drax/dialogue.rpy:126
translate zh drax_qBooks_27cb4f61:

    # DRAX "... Let me know!"
    DRAX "...记得告诉我！"

# game/data/characters/drax/dialogue.rpy:130
translate zh drax_qEnd_d0d69c30:

    # DRAX "What else do you need?"
    DRAX "还需要什么？"

# game/data/characters/drax/dialogue.rpy:134
translate zh drax_bye_987ddf0d:

    # DRAX "Come back anytime."
    DRAX "随时欢迎再来。"

# game/data/characters/drax/dialogue.rpy:138
translate zh drax_craft_a1dec31f:

    # DRAX "Ah! You need something forged?"
    DRAX "啊！需要打造东西？"

# game/data/characters/drax/dialogue.rpy:143
translate zh drax_craft_00afb801:

    # DRAX "Anytime."
    DRAX "随时效劳。"

# game/data/characters/drax/dialogue.rpy:148
translate zh drax_craft_b9b6a99a:

    # DRAX "I can smelt you just about any kind of armor and weapons you'd like, trouble is, it ain't just about the coin."
    DRAX "我能给你打造任何盔甲武器，问题是这不光靠金币就能解决。"

# game/data/characters/drax/dialogue.rpy:149
translate zh drax_craft_78db8fb0:

    # DRAX "There's a shortage of raw materials coming in, and most of what {i}does{/i} come in goes to the war effort."
    DRAX "原材料供应短缺，而且大部分{i}到货的{/i}都送去支援前线了。"

# game/data/characters/drax/dialogue.rpy:150
translate zh drax_craft_54c95bbc:

    # DRAX "If you want me to make you something, you may have to source the raw materials yourself..."
    DRAX "若要我为你打造，你可能得自己去找原材料..."

# game/data/characters/drax/dialogue.rpy:154
translate zh drax_craft_8e531321:

    # DRAX "Very well then... Let me know if you need anything!"
    DRAX "那好吧...有需要随时告诉我！"

translate zh strings:

    # game/data/characters/drax/dialogue.rpy:2
    old "Drax needs bronze scraps"
    new "德拉克斯需要青铜废料"

    # game/data/characters/drax/dialogue.rpy:2
    old "A blacksmith of Novaras will take any bronze scraps I might scavenge in exchange for gold. He is only interested in batches of five, for whatever reason."
    new "诺瓦拉斯的铁匠会收我收集的青铜废料换金币。不知为何他只收五份一批的。"

    # game/data/characters/drax/dialogue.rpy:22
    old "Here is some more bronze you wanted."
    new "这是你要的更多青铜。"

    # game/data/characters/drax/dialogue.rpy:25
    old "Can I see your wares?"
    new "能看看你的货物吗？"

    # game/data/characters/drax/dialogue.rpy:29
    old "I wanted to talk to you about crafting something for me."
    new "我想请你为我打造些东西。"

    # game/data/characters/drax/dialogue.rpy:30
    old "I have a few questions..."
    new "我有些问题..."

    # game/data/characters/drax/dialogue.rpy:34
    old "Has much changed since I left?"
    new "我离开后变化大吗？"

    # game/data/characters/drax/dialogue.rpy:35
    old "Any ideas on getting into Arlena’s good books?"
    new "有办法讨艾琳娜欢心吗？"

    # game/data/characters/drax/dialogue.rpy:36
    old "That’s all for now."
    new "暂时就这些。"

    # game/data/characters/drax/dialogue.rpy:139
    old "Yes, there's something I'd like you to make for me..."
    new "是的，有样东西想请你打造..."

    # game/data/characters/drax/dialogue.rpy:139
    old "Could you explain it to me?"
    new "能详细说明下吗？"

    # game/data/characters/drax/dialogue.rpy:139
    old "Nevermind, I've changed my mind."
    new "算了，我改主意了。"