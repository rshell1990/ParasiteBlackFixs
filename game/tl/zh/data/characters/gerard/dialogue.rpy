

# game/data/characters/gerard/dialogue.rpy:31
translate zh gerard_talk_7b6c0322:

    # GERARD @ happy "Ah! There you are."
    GERARD @ happy "啊！你来了。"

# game/data/characters/gerard/dialogue.rpy:32
translate zh gerard_talk_fe549c5e:

    # GERARD @ happy "Could you be a good lad and ask 阿达拉 when my soup will be ready?"
    GERARD @ happy "好孩子，能帮我问问阿达拉我的汤什么时候好吗？"

# game/data/characters/gerard/dialogue.rpy:33
translate zh gerard_talk_093b4dbd:

    # GERARD "I'm starting to feel quite ... {i}quite tired{/i} again..."
    GERARD "我又开始觉得...{i}非常疲惫{/i}了..."

# game/data/characters/gerard/dialogue.rpy:34
translate zh gerard_talk_60f0e6d9:

    # MC @ talk "...Gerard?"
    MC @ talk "...杰拉德？"

# game/data/characters/gerard/dialogue.rpy:36
translate zh gerard_talk_e5f7d154:

    # GERARD "..."
    GERARD "..."

# game/data/characters/gerard/dialogue.rpy:37
translate zh gerard_talk_39a9d760:

    # MC "(Seems he's gone to sleep again.)"
    MC "(看来他又睡着了。)"

# game/data/characters/gerard/dialogue.rpy:47
translate zh gerard_firstmeet_5344a7f6:

    # "Upon seeing me, Gerard, 阿达拉的 father withdrew further into his seat."
    "见到我时，阿达拉的父亲杰拉德往椅子里缩了缩身子。"

# game/data/characters/gerard/dialogue.rpy:49
translate zh gerard_firstmeet_c4349c69:

    # GERARD @ shock "Who... Who are you?"
    GERARD @ shock "你...你是谁？"

# game/data/characters/gerard/dialogue.rpy:50
translate zh gerard_firstmeet_5d03fbc4:

    # GERARD @ angry "What are you doing in my home?"
    GERARD @ angry "你在我家里做什么？"

# game/data/characters/gerard/dialogue.rpy:52
translate zh gerard_firstmeet_dc142611:

    # "Gerard's eyes wandered over me from top to bottom, as though unconvinced."
    "杰拉德的目光上下打量着我，似乎不太相信。"

# game/data/characters/gerard/dialogue.rpy:53
translate zh gerard_firstmeet_a01e7045:

    # "Then, when the realization hit, he smiled brightly."
    "接着他突然认出了我，脸上绽开灿烂的笑容。"

# game/data/characters/gerard/dialogue.rpy:55
translate zh gerard_firstmeet_c419d1f7:

    # MC @ smile "Hello. Gerard, how do you fair?"
    MC @ smile "你好，杰拉德，最近身体怎么样？"

# game/data/characters/gerard/dialogue.rpy:56
translate zh gerard_firstmeet_1d579dac:

    # "阿达拉的 father coughed and spluttered before offering a faint, sickly smile."
    "阿达拉的父亲咳嗽着喘了几口气，挤出一个虚弱无力的微笑。"

# game/data/characters/gerard/dialogue.rpy:57
translate zh gerard_firstmeet_4ff4c591:

    # GERARD @ happy "I struggle to move around much these days, but I keep going all the same."
    GERARD @ happy "最近走动有些吃力，但我还是坚持着。"

# game/data/characters/gerard/dialogue.rpy:58
translate zh gerard_firstmeet_31bef116:

    # GERARD @ shock "By the gods though, you've changed!"
    GERARD @ shock "天哪，你变化真大！"

# game/data/characters/gerard/dialogue.rpy:59
translate zh gerard_firstmeet_0db8be50:

    # MC @ smile "Ah, well, a lot's happened since you last saw me..."
    MC @ smile "啊，是啊，自从上次见面后发生了很多事..."

# game/data/characters/gerard/dialogue.rpy:60
translate zh gerard_firstmeet_58db3fa1:

    # "阿达拉 emerged from the upstairs, calling out to her father."
    "阿达拉从楼上走出来，呼唤着她的父亲。"

# game/data/characters/gerard/dialogue.rpy:62
translate zh gerard_firstmeet_0ea16926:

    # ADARA @ talk "Father, I've prepared your bed for-"
    ADARA @ talk "父亲，我已经给您铺好床了——"

# game/data/characters/gerard/dialogue.rpy:63
translate zh gerard_firstmeet_3a50d24d:

    # "阿达拉的 eyes widened when she saw me."
    "看到我时，阿达拉瞪大了眼睛。"

# game/data/characters/gerard/dialogue.rpy:66
translate zh gerard_firstmeet_a9ee7ae1:

    # ADARA "W-What are you doing here?"
    ADARA "你——你怎么会在这里？"

# game/data/characters/gerard/dialogue.rpy:67
translate zh gerard_firstmeet_fb51ca06:

    # GERARD "Yes, that is a good question..."
    GERARD "是啊，我也正想问..."

# game/data/characters/gerard/dialogue.rpy:69
translate zh gerard_firstmeet_821aecf2:

    # MC @ lewd "Ah, I actually came to see how 阿达拉 was doing..."
    MC @ lewd "啊，其实我是来看看阿达拉过得怎么样..."

# game/data/characters/gerard/dialogue.rpy:70
translate zh gerard_firstmeet_63c7d2ef:

    # "阿达拉的 cheeks burned red as her father looked back and forth from me to her."
    "当她的父亲来回打量我们两人时，阿达拉的脸颊变得通红。"

# game/data/characters/gerard/dialogue.rpy:71
translate zh gerard_firstmeet_e0dd8443:

    # ADARA "Y-You don't need to trouble yourself worrying about me."
    ADARA "你——你不用费心担心我的。"

# game/data/characters/gerard/dialogue.rpy:72
translate zh gerard_firstmeet_0cc6e9de:

    # "Gerard smiled and nodded."
    "杰拉德微笑着点点头。"

# game/data/characters/gerard/dialogue.rpy:74
translate zh gerard_firstmeet_fb898fac:

    # GERARD @ happy "Now when are you going to make an honest woman of my daughter?"
    GERARD @ happy "那你打算什么时候娶我女儿过门啊？"

# game/data/characters/gerard/dialogue.rpy:75
translate zh gerard_firstmeet_229b9884:

    # "阿达拉的 eyes widened in horror."
    "阿达拉惊恐地睁大了眼睛。"

# game/data/characters/gerard/dialogue.rpy:76
translate zh gerard_firstmeet_0f68b999:

    # ADARA @ shock "FATHER!"
    ADARA @ shock "父亲！"

# game/data/characters/gerard/dialogue.rpy:77
translate zh gerard_firstmeet_90918178:

    # MC @ surprised "U-Uhh...!"
    MC @ surprised "呃——这个...！"

# game/data/characters/gerard/dialogue.rpy:78
translate zh gerard_firstmeet_abf6ffcf:

    # "Gerard laughed, and that laugh soon turned into another cough and splutter."
    "杰拉德大笑起来，但笑声很快又变成了一阵咳嗽和喘息。"

# game/data/characters/gerard/dialogue.rpy:79
translate zh gerard_firstmeet_c596294a:

    # GERARD @ happy "What? You two have known each other since you were small, I always {i}presumed{/i} it was coming one day."
    GERARD @ happy "怎么？你们俩从小认识，我一直{i}以为{/i}这事迟早会发生。"

# game/data/characters/gerard/dialogue.rpy:80
translate zh gerard_firstmeet_1dcbc052:

    # ADARA "W-We're just friends, that's all."
    ADARA "我——我们只是朋友，仅此而已。"

# game/data/characters/gerard/dialogue.rpy:81
translate zh gerard_firstmeet_771eca78:

    # GERARD "Friends, hm?"
    GERARD "朋友，嗯？"

# game/data/characters/gerard/dialogue.rpy:82
translate zh gerard_firstmeet_1900663f:

    # GERARD "Me and your mother used to say the same-"
    GERARD "我和你母亲当年也这么说——"

# game/data/characters/gerard/dialogue.rpy:84
translate zh gerard_firstmeet_3ba1263d:

    # "阿达拉的 father began to cough and splutter once again, the persistent cough this time refusing to let up."
    "阿达拉的父亲又开始咳嗽喘息，这次剧烈的咳嗽久久无法平息。"

# game/data/characters/gerard/dialogue.rpy:85
translate zh gerard_firstmeet_3a531e08:

    # "阿达拉 gave Gerard some water and gently rubbed his back."
    "阿达拉给杰拉德喂了些水，轻轻拍着他的背。"

# game/data/characters/gerard/dialogue.rpy:86
translate zh gerard_firstmeet_f37451d8:

    # GERARD "Urghh ... I need some more rest it seems."
    GERARD "呃...看来我还需要再休息会儿。"

# game/data/characters/gerard/dialogue.rpy:87
translate zh gerard_firstmeet_dc85f7a9:

    # GERARD "阿达拉, tend to our ... our ..."
    GERARD "阿达拉，照顾好我们的...我们的..."

# game/data/characters/gerard/dialogue.rpy:88
translate zh gerard_firstmeet_38cc805a:

    # "Gerard seemed to doze off."
    "杰拉德似乎昏睡过去了。"

# game/data/characters/gerard/dialogue.rpy:90
translate zh gerard_firstmeet_cc0e3ce6:

    # ADARA @ sad "{i}*Sigh*{/i}"
    ADARA @ sad "{i}*叹气*{/i}"

# game/data/characters/gerard/dialogue.rpy:91
translate zh gerard_firstmeet_1c50e008:

    # MC @ sad "Has his condition shown no sign of improving?"
    MC @ sad "他的病情没有任何好转迹象吗？"

# game/data/characters/gerard/dialogue.rpy:92
translate zh gerard_firstmeet_3390d462:

    # ADARA @ sad "His health seems to be improving slowly."
    ADARA @ sad "他的健康状况似乎在缓慢好转。"

# game/data/characters/gerard/dialogue.rpy:93
translate zh gerard_firstmeet_f470412b:

    # ADARA @ sad "{i}Very slowly.{/i}"
    ADARA @ sad "{i}非常缓慢。{/i}"

# game/data/characters/gerard/dialogue.rpy:94
translate zh gerard_firstmeet_443258d8:

    # MC @ talk "I see..."
    MC @ talk "明白了..."

# game/data/characters/gerard/dialogue.rpy:96
translate zh gerard_firstmeet_55db4aa4:

    # ADARA @ sad "Just let father rest for now, come ... I'll be in my room should you need me for anything."
    ADARA @ sad "先让父亲休息吧，来...我就在房间里，有事随时找我。"

