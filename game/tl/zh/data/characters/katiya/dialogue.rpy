    MC @ talk "您父亲还好吗？"

# game/data/characters/katiya/dialogue.rpy:78
translate zh katiya_good_alderian_785bcc2d:

    # KATIYA "Tsch... He is a drunkard who left me and my mother for some Alderian merchants daughter."
