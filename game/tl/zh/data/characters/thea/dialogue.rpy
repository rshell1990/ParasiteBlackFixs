

# game/data/characters/thea/dialogue.rpy:29
translate zh nov_thea_talk_5f6496d4:

    # THEA @ smile "Oh hey! Can I help you with something?"
    THEA @ smile "哦嘿！有什么我可以帮您的吗？"

# game/data/characters/thea/dialogue.rpy:36
translate zh nov_thea_bye_9e54ad83:

    # THEA @ talk "Alright, see ya around!"
    THEA @ talk "好的，再见！"

# game/data/characters/thea/dialogue.rpy:37
translate zh nov_thea_bye_d20135b7:

    # THEA @ smile "Good luck on your adventures!"
    THEA @ smile "祝您冒险成功！"

# game/data/characters/thea/dialogue.rpy:43
translate zh nov_thea_adv_questions_1a2ee70f:

    # THEA @ talk "Ask away."
    THEA @ talk "尽管问吧。"

# game/data/characters/thea/dialogue.rpy:46
translate zh nov_thea_adv_questions_menu_bbc22857:

    # THEA @ talk "Over on the board over there is our list of current jobs needing to be done."
    THEA @ talk "那边的公告板上列出了当前需要完成的任务清单。"

# game/data/characters/thea/dialogue.rpy:47
translate zh nov_thea_adv_questions_menu_0ab4d2cb:

    # THEA @ talk "Just select the one you want, and we'll handle the paperwork while you get to work."
    THEA @ talk "只需选择您想要的任务，我们会处理文书工作，您直接开始执行即可。"

# game/data/characters/thea/dialogue.rpy:48
translate zh nov_thea_adv_questions_menu_e0200cc9:

    # THEA @ talk "Remember though, you can only choose a quest within your rank as an adventurer."
    THEA @ talk "但请记住，您只能选择与您冒险者等级相符的任务。"

# game/data/characters/thea/dialogue.rpy:51
translate zh nov_thea_adv_questions_menu_d0988ac6:

    # THEA @ talk "It's important to understand how the ranking works."
    THEA @ talk "了解等级制度如何运作很重要。"

# game/data/characters/thea/dialogue.rpy:52
translate zh nov_thea_adv_questions_menu_a160af5e:

    # THEA @ talk "All beginner adventurers are ranked as D-listers."
    THEA @ talk "所有新手冒险者都从D级开始。"

# game/data/characters/thea/dialogue.rpy:53
translate zh nov_thea_adv_questions_menu_691c77f1:

    # THEA @ talk "These are the most straightforward and simple quests available to any adventurer."
    THEA @ talk "这是对所有冒险者开放的最直接简单的任务。"

# game/data/characters/thea/dialogue.rpy:54
translate zh nov_thea_adv_questions_menu_359a935e:

    # THEA @ talk "Ranking progresses from D-tier all the way to S-Tier, the rank of legendary adventurers."
    THEA @ talk "等级从D级逐步提升至S级，那是传奇冒险者的等级。"

# game/data/characters/thea/dialogue.rpy:55
translate zh nov_thea_adv_questions_menu_71f3b316:

    # THEA @ talk "Of course, as the danger and difficulty of the quests increase each rank, so does the rewards to compensate."
    THEA @ talk "当然，随着任务危险性和难度逐级提升，相应的报酬也会增加作为补偿。"

# game/data/characters/thea/dialogue.rpy:58
translate zh nov_thea_adv_questions_menu_9ae80558:

    # THEA @ talk "There's a set number of quests per rank that will need to be completed a minimum of at least once."
    THEA @ talk "每个等级都有固定数量的任务需要至少完成一次。"

# game/data/characters/thea/dialogue.rpy:59
translate zh nov_thea_adv_questions_menu_42fcd1da:

    # THEA @ talk "After you've beaten your ranks guild quests, a special one-time quest will open up that once you've completed, your rank will increase."
    THEA @ talk "完成您当前等级的所有公会任务后，会解锁一个特殊的一次性任务，完成后您的等级就会提升。"

# game/data/characters/thea/dialogue.rpy:60
translate zh nov_thea_adv_questions_menu_0b3f27c1:

    # THEA @ talk "Oh ... And don't worry about running out of quests."
    THEA @ talk "哦... 别担心任务会枯竭。"

# game/data/characters/thea/dialogue.rpy:61
translate zh nov_thea_adv_questions_menu_003922e8:

    # THEA @ talk "Outside of the special guild quests, most guild quests are usually full time occupations in themselves, you'll be able to re-do those quests as many times as you like."
    THEA @ talk "除了特殊公会任务外，大多数公会任务本身就是全职工作，您可以随意重复完成这些任务。"

# game/data/characters/thea/dialogue.rpy:64
translate zh nov_thea_adv_questions_menu_fa5b1639:

    # THEA @ talk "Sure, was there anything else?"
    THEA @ talk "当然，还有其他问题吗？"

# game/data/characters/thea/dialogue.rpy:68
translate zh nov_thea_adv_questions_notAdventurer_dff28a07:

    # THEA @ talk "Sorry, but I don't remember you being an adventurer."
    THEA @ talk "抱歉，我不记得您是冒险者。"

# game/data/characters/thea/dialogue.rpy:69
translate zh nov_thea_adv_questions_notAdventurer_4a075af6:

    # MC "What do you mean?"
    MC "什么意思？"

# game/data/characters/thea/dialogue.rpy:70
translate zh nov_thea_adv_questions_notAdventurer_bd5ff809:

    # THEA @ talk "Well, you can get yourself a drink or something, but I can't waste my time explaining the inner workings of the guild to you."
    THEA @ talk "嗯，您可以自己点杯饮料什么的，但我不能浪费时间向您解释公会的内部运作。"

# game/data/characters/thea/dialogue.rpy:71
translate zh nov_thea_adv_questions_notAdventurer_e1770810:

    # MC "Can I become an adventurer?"
    MC "我能成为冒险者吗？"

# game/data/characters/thea/dialogue.rpy:72
translate zh nov_thea_adv_questions_notAdventurer_416abe62:

    # "Thea let out a quiet sigh..."
    "西娅轻声叹了口气..."

# game/data/characters/thea/dialogue.rpy:73
translate zh nov_thea_adv_questions_notAdventurer_e5da05a6:

    # THEA @ talk "That's a three-hundred fifty-something time I've been asked this."
    THEA @ talk "这已经是我第350多次被问这个问题了。"

# game/data/characters/thea/dialogue.rpy:74
translate zh nov_thea_adv_questions_notAdventurer_811a066b:

    # THEA @ talk "Have you reached your Terminus yet?"
    THEA @ talk "您达到您的Terminus了吗？"

# game/data/characters/thea/dialogue.rpy:75
translate zh nov_thea_adv_questions_notAdventurer_5d73558e:

    # "I swallowed hard."
    "我艰难地咽了口唾沫。"

# game/data/characters/thea/dialogue.rpy:76
translate zh nov_thea_adv_questions_notAdventurer_7b56f981:

    # MC "Y-yeah."
    MC "是-是的。"

# game/data/characters/thea/dialogue.rpy:77
translate zh nov_thea_adv_questions_notAdventurer_2da5a787:

    # THEA @ talk "You did? Well, that is how you become an adventurer, you're {i}assigned{/i} this role at your Terminus."
    THEA @ talk "达到了？嗯，这就是成为冒险者的方式，在Terminus时您会被{i}分配{/i}这个角色。"

# game/data/characters/thea/dialogue.rpy:78
translate zh nov_thea_adv_questions_notAdventurer_fe9f792d:

    # THEA @ talk "What role did the kingdom bestow upon you?"
    THEA @ talk "王国授予了您什么角色？"

# game/data/characters/thea/dialogue.rpy:79
translate zh nov_thea_adv_questions_notAdventurer_522de8a4:

    # MC "(Cannon fodder.)"
    MC "(炮灰。)"

# game/data/characters/thea/dialogue.rpy:80
translate zh nov_thea_adv_questions_notAdventurer_e8f39a65:

    # MC "I... I should go."
    MC "我... 我该走了。"

# game/data/characters/thea/dialogue.rpy:81
translate zh nov_thea_adv_questions_notAdventurer_4349caf7:

    # "Thea raised an eyebrow."
    "西娅挑起眉毛。"

# game/data/characters/thea/dialogue.rpy:82
translate zh nov_thea_adv_questions_notAdventurer_d34359c3:

    # THEA @ talk "Okay, safe travels then!"
    THEA @ talk "好吧，那祝您一路平安！"

# game/data/characters/thea/dialogue.rpy:84
translate zh nov_thea_adv_questions_notAdventurer_bfd46478:

    # MC "I should get to the fort now."
    MC "我现在该去堡垒了。"

# game/data/characters/thea/dialogue.rpy:89
translate zh nov_thea_drink_4968c955:

    # THEA @ talk "Improve your standing at the guild and maybe we'll talk."
    THEA @ talk "提升您在公会的地位，也许那时我们可以聊聊。"

# game/data/characters/thea/dialogue.rpy:93
translate zh nov_thea_drink_8bb85580:

    # THEA @ smile "I hope you don't think you're the first one to try that."
    THEA @ smile "希望您不会以为自己是第一个尝试这招的人。"

# game/data/characters/thea/dialogue.rpy:94
translate zh nov_thea_drink_cef616c3:

    # MC @ smile "I was hoping I'd be the first one you'd say yes to."
    MC @ smile "我本希望自己是您第一个答应的人。"

# game/data/characters/thea/dialogue.rpy:95
translate zh nov_thea_drink_af5adb3e:

    # THEA @ talk "Hmm, well, I'll think about it ..."
    THEA @ talk "嗯，好吧，我会考虑一下..."

# game/data/characters/thea/dialogue.rpy:96
translate zh nov_thea_drink_4d231e9b:

    # THEA @ talk "I'm sure you're used to girls just falling into your lap, but it takes a little more than that to get me interested."
    THEA @ talk "我敢肯定您习惯了女孩们主动投怀送抱，但要引起我的兴趣，光这样可不够。"

# game/data/characters/thea/dialogue.rpy:97
translate zh nov_thea_drink_e9545907:

    # MC @ smile "Oh?"
    MC @ smile "哦？"

# game/data/characters/thea/dialogue.rpy:98
translate zh nov_thea_drink_08d238b8:

    # THEA @ smile "{i}I wanna see what you can do.{/i}"
    THEA @ smile "{i}我想看看您能做什么。{/i}"

# game/data/characters/thea/dialogue.rpy:99
translate zh nov_thea_drink_fb6bc2c6:

    # MC @ think "What I can do?"
    MC @ think "我能做什么？"

# game/data/characters/thea/dialogue.rpy:100
translate zh nov_thea_drink_95135937:

    # THEA @ smile "Here, {i}at this guild.{/i}"
    THEA @ smile "在这里，{i}在这个公会里。{/i}"

# game/data/characters/thea/dialogue.rpy:101
translate zh nov_thea_drink_306fe303:

    # THEA @ smile2 "There's something about this place that just-"
    THEA @ smile2 "这个地方有种特别的——"

# game/data/characters/thea/dialogue.rpy:102
translate zh nov_thea_drink_c7bdae38:

    # THEA @ smile "Mmm ... Better not think too hard on it, need to stay focused for work."
    THEA @ smile "嗯... 还是别想太多，工作需要保持专注。"

# game/data/characters/thea/dialogue.rpy:103
translate zh nov_thea_drink_ef2975b7:

    # MC @ talk "So, you've got a thing for Adventurers then?"
    MC @ talk "所以，您对冒险者有特殊好感？"

# game/data/characters/thea/dialogue.rpy:104
translate zh nov_thea_drink_79a5953f:

    # THEA @ smile2 "A-Ah...Maybe a little?"
    THEA @ smile2 "啊...也许有一点？"

# game/data/characters/thea/dialogue.rpy:105
translate zh nov_thea_drink_c0c81c71:

    # THEA @ smile "But not just any adventurer walking in off the street, one whose metal has been seriously proven."
    THEA @ smile "但不是随便哪个街头冒险者，而是真正证明过自己实力的人。"

# game/data/characters/thea/dialogue.rpy:106
translate zh nov_thea_drink_211b3ff7:

    # THEA @ blush "Think you've got what it takes?"
    THEA @ blush "觉得自己够格吗？"

# game/data/characters/thea/dialogue.rpy:107
translate zh nov_thea_drink_8ba32743:

    # MC @ talk "I guess we'll see, won't we?"
    MC @ talk "我想我们会知道的，不是吗？"

