translate zh nov_vala_scr_firstmeet_6fa3a6ae:

    # MC @ talk "A pleasure to meet you Vala Bluestone, I am [player_name!t]."
    MC @ talk "很高兴认识你，瓦拉·布鲁斯通，我是[player_name!t]。"
