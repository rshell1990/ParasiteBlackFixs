# game/data/world_events/KrishanaEvent/ev_krishana_day.rpy:817
translate zh ev_KrishanaDay_gifts_38530319:

    # "Taking the book from her mouth, 俄蕾娜的 tail wagged as she waited for me look at it."
    "从她嘴里接过书，俄蕾娜摇着尾巴等我查看。"

# game/data/world_events/KrishanaEvent/ev_krishana_day.rpy:818
translate zh ev_KrishanaDay_gifts_a77399d3:

    # "{i}The dreams of Ashara - A love story.{/i}"
    "{i}《阿莎拉之梦——一个爱情故事》{/i}"

# game/data/world_events/KrishanaEvent/ev_krishana_day.rpy:819
translate zh ev_KrishanaDay_gifts_fce6108b:

    # MC "(This is that book I've heard everyone is reading ... Apparently it's very good.)"
    MC "(这就是我听说大家都在读的那本书...据说非常棒。)"

# game/data/world_events/KrishanaEvent/ev_krishana_day.rpy:820
translate zh ev_KrishanaDay_gifts_ddf70b53:

    # MC @ smile "Thank you, 俄蕾娜."
    MC @ smile "谢谢你，俄蕾娜。"

# game/data/world_events/KrishanaEvent/ev_krishana_day.rpy:821
translate zh ev_KrishanaDay_gifts_2e68abed:

    # MC @ talk "When Erika leaves, we'll talk properly."
    MC @ talk "等艾丽卡走了，我们再好好聊聊。"

# game/data/world_events/KrishanaEvent/ev_krishana_day.rpy:822
