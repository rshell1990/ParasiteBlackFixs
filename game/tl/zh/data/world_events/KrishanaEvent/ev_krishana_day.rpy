    MC @ lewd "还有呃...希望你今天过得愉快。"

# game/data/world_events/KrishanaEvent/ev_krishana_day.rpy:250
translate zh ev_KrishanaDay_regina_dialogue_menu_9feb8b98:

    # ADARA @ joy "M-Mmm, I did..."
    ADARA @ joy "嗯-嗯，很愉快..."

