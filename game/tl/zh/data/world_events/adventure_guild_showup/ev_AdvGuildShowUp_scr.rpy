

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:3
translate zh ev_AdvGuildShowUpPostFaw_scr_97f88b80:

    # MC "Yeah, that should be the place..."
    MC "嗯，应该就是那里了..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:11
translate zh ev_AdvGuildShowUpPostFaw_scr_dbc72fd5:

    # MARKUS "Hey there."
    MARKUS "嘿，你好啊。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:13
translate zh ev_AdvGuildShowUpPostFaw_scr_3ba81735:

    # MC @ talk "Gosh!!! Were you following me?"
    MC @ talk "天哪！！！你一直在跟踪我吗？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:14
translate zh ev_AdvGuildShowUpPostFaw_scr_9a80b0c9:

    # MARKUS "Haha! No, just walked in myself. Could tell your new imposing figure from miles away."
    MARKUS "哈哈！没有，我自己刚进来。你如今这魁梧的身材，老远就能认出来。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:16
translate zh ev_AdvGuildShowUpPostFaw_scr_4c6b712c:

    # MC @ talk "Okay then... Let's get this over with."
    MC @ talk "好吧...那咱们赶紧把这事办完。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:18
translate zh ev_AdvGuildShowUpPostFaw_scr_ed28eecd:

    # MC @ talk "How’s your brother faring?"
    MC @ talk "你弟弟最近怎么样？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:19
translate zh ev_AdvGuildShowUpPostFaw_scr_20bb5a54:

    # MARKUS "He’s taking a few days rest from the mines, wants to spend some time with me."
    MARKUS "他从矿上休息几天，想跟我聚聚。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:20
translate zh ev_AdvGuildShowUpPostFaw_scr_420061c3:

    # MARKUS "Had some boar prepared for us both, would you believe it?"
    MARKUS "信不信，他还准备了野猪肉给我们俩？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:21
translate zh ev_AdvGuildShowUpPostFaw_scr_c96deed8:

    # MC @ talk "What? A whole boar?"
    MC @ talk "什么？一整头野猪？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:22
translate zh ev_AdvGuildShowUpPostFaw_scr_853d3fc9:

    # MC @ talk "You should 'nearly die' more often."
    MC @ talk "看来你该多'差点死掉'几回。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:23
translate zh ev_AdvGuildShowUpPostFaw_scr_8725796b:

    # MARKUS "Wouldn’t tell me how he got it, just said he was glad I was back."
    MARKUS "不肯说怎么弄到的，只说很高兴我回来了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:24
translate zh ev_AdvGuildShowUpPostFaw_scr_a8b4f73d:

    # "I smirked, his brother had always had a few connections with some of the shadier residents of Novaras, so being able to poach a whole boar for himself didn’t come as much of a shock."
    "我暗自好笑，他弟弟向来和诺瓦拉斯某些来路不明的居民有交情，所以能给自己搞到整头野猪也不算太意外。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:25
translate zh ev_AdvGuildShowUpPostFaw_scr_4c007296:

    # MC @ talk "Who should we talk to around here?"
    MC @ talk "在这儿该找谁谈？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:26
translate zh ev_AdvGuildShowUpPostFaw_scr_81706a27:

    # MARKUS "The girl at the front desk should handle every—"
    MARKUS "前台那个姑娘应该能处理所有——"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:28
translate zh ev_AdvGuildShowUpPostFaw_scr_46622842:

    # RANDOM_MAN "IT’S CELESTE! EVERYONE! CELESTE HAS RETURNED!"
    RANDOM_MAN "是赛莱斯特！大家！赛莱斯特回来了！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:29
translate zh ev_AdvGuildShowUpPostFaw_scr_e9496487:

    # "As the entire room began to rumble in anticipation, there was a mad rush to head outside and see the returning Hero."
    "整个大厅因期待而骚动起来，人们疯狂涌向门外，想一睹这位归来的英雄。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:30
translate zh ev_AdvGuildShowUpPostFaw_scr_84e6f09e:

    # "I glanced uncertainly at 马库斯 who was now beaming with excitement."
    "我迟疑地瞥了一眼马库斯，他此刻正兴奋得容光焕发。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:31
translate zh ev_AdvGuildShowUpPostFaw_scr_a05b9ce7:

    # MC @ talk "Celeste? Here?"
    MC @ talk "赛莱斯特？在这儿？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:32
translate zh ev_AdvGuildShowUpPostFaw_scr_e860b253:

    # MARKUS "Come on! Let’s join the others!"
    MARKUS "快走！我们也跟上去！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:42
translate zh ev_AdvGuildShowUpPostFaw_scr_debaa932:

    # "Forcing our way out the front to join the gathering crowds of Heroes and common folk alike, the Hero, Celeste, and her party, ‘The Red Daggers’, returned to rapturous applause."
    "我们挤到前面，加入英雄和平民组成的人群。英雄赛莱斯特和她的队伍‘红匕’在热烈的欢呼声中归来。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:43
translate zh ev_AdvGuildShowUpPostFaw_scr_609bae40:

    # "Celeste and her legend seemed to grow day by day, her feats and accomplishments almost taking on a life of their own as stories of them were scattered through the streets of the city."
    "赛莱斯特和她的传说似乎日益壮大，她的功绩与成就随着街头巷尾的传颂，几乎拥有了自己的生命。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:44
translate zh ev_AdvGuildShowUpPostFaw_scr_e422b608:

    # "In an age where Heroes seemed to either perish or fade away into obfuscation, Celeste was a bright star on the blackest night."
    "在这个英雄要么陨落要么湮没无闻的时代，赛莱斯特犹如至暗夜空中一颗璀璨的明星。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:45
translate zh ev_AdvGuildShowUpPostFaw_scr_0acd5a1c:

    # "And she was beautiful."
    "而且她如此美丽。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:46
translate zh ev_AdvGuildShowUpPostFaw_scr_1bbca653:

    # "Donning her ornate gold armour, she smiled and waved to the crowds, her soft, short hair hung down just past her chin, and my eyes were drawn curiously to how the color split, half a silvery white, and half black."
    "她身着华丽的金甲，微笑着向人群挥手。柔软短发垂至下颌，我好奇地注意到那发色泾渭分明：一半银白，一半乌黑。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:47
translate zh ev_AdvGuildShowUpPostFaw_scr_eaf81588:

    # "Athletic yet graceful, many a young man dreamed of sharing Adventures with her."
    "健美而不失优雅，多少年轻男子梦想着能与她共赴冒险。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:48
translate zh ev_AdvGuildShowUpPostFaw_scr_07421466:

    # "Many more fantasised of a budding, if explicit, romance where they no doubt wooed her with incredible feats of heroism."
    "更多人则幻想着与她萌生一段炽热的罗曼史——毫无疑问，他们会用惊人的英雄壮举来赢得她的芳心。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:49
translate zh ev_AdvGuildShowUpPostFaw_scr_883cc96c:

    # "Behind her slugged the Red Arrows, a small band who seemed wearier than her, more stoic, exhibiting many scars and scratches across their faces and armour."
    "她身后步履沉重的是'红箭'小队，这支小队伍显得比她更疲惫，也更坚忍，脸上盔甲上布满伤痕与刮痕。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:50
translate zh ev_AdvGuildShowUpPostFaw_scr_a0ba91ad:

    # "Despite this, they still offered the occasional wave and faint smile of appreciation for the adoring fans."
    "尽管如此，他们仍不时挥手，向狂热粉丝报以淡淡的感激微笑。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:51
translate zh ev_AdvGuildShowUpPostFaw_scr_479cd176:

    # "One of the Red Arrows, an archer riddled with scars, lingered further back than the rest."
    "其中一位满身伤痕的弓箭手落在队伍最后。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:52
translate zh ev_AdvGuildShowUpPostFaw_scr_24a035fb:

    # "Keeping the hood of her green cloak firmly up, she seemed to offer nothing compared to her fellow warriors, not even a smile."
    "她牢牢拉起绿色斗篷的风帽，比起其他战士显得格外冷漠，连一丝笑容也无。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:53
translate zh ev_AdvGuildShowUpPostFaw_scr_4cbbcaae:

    # "As I studied her, intrigued, for the briefest of moments, her eyes seemed to meet mine and lock."
    "当我饶有兴致地观察她时，有那么短暂一瞬，她的目光似乎与我的交汇锁定。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:54
translate zh ev_AdvGuildShowUpPostFaw_scr_16a2a0e6:

    # "Her features broke into what appeared to be a truly genuine smile before it took on an alluring and seductive tone."
    "她的面容先是绽开一个看似真诚的微笑，随即又带上诱人而挑逗的意味。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:55
translate zh ev_AdvGuildShowUpPostFaw_scr_05e83d2a:

    # "She averted her gaze, smiling warmly at the crowds for a second before retreating behind her hood once more."
    "她移开视线，朝人群温暖地微笑了一秒，便又隐回风帽之后。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:56
translate zh ev_AdvGuildShowUpPostFaw_scr_fa47146a:

    # "From between the feet of the crowd, a small child on the verge of tears rushed towards Celeste."
    "人群中钻出一个泪眼汪汪的小男孩，冲向赛莱斯特。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:57
translate zh ev_AdvGuildShowUpPostFaw_scr_6aec7b19:

    # "Celeste looked curiously at the child as she crouched down to him."
    "赛莱斯特好奇地看着孩子，蹲下身来。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:61
translate zh ev_AdvGuildShowUpPostFaw_scr_474f72b1:

    # "A hush fell over the crowd, eager to hear what was being said."
    "人群安静下来，急切想听清他们的对话。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:62
translate zh ev_AdvGuildShowUpPostFaw_scr_653b4a8c:

    # CELESTE @ laugh "Hello there, young master!"
    CELESTE @ laugh "你好啊，小少爷！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:63
translate zh ev_AdvGuildShowUpPostFaw_scr_33d8fc19:

    # "Celeste’s voice was soft yet dynamic, seductive yet commanding."
    "赛莱斯特的声音柔和却充满活力，魅惑又不失威严。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:64
translate zh ev_AdvGuildShowUpPostFaw_scr_138d2342:

    # "People could listen to her for hours, especially men."
    "人们——尤其是男人——能听她说话听上几个小时。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:66
translate zh ev_AdvGuildShowUpPostFaw_scr_2487149d:

    # ERON "Did you find my father’s ship?"
    ERON "你们找到我爸爸的船了吗？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:67
translate zh ev_AdvGuildShowUpPostFaw_scr_2068d967:

    # CELESTE @ talk "Your father? What was his name child?"
    CELESTE @ talk "你父亲？孩子，他叫什么名字？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:68
translate zh ev_AdvGuildShowUpPostFaw_scr_c4432ca6:

    # ERON "Drona! Captain Drona!"
    ERON "德罗纳！德罗纳船长！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:69
translate zh ev_AdvGuildShowUpPostFaw_scr_5cae0b61:

    # "Celeste looked up muttering the name again and again in a theatrical display."
    "赛莱斯特抬起头，戏剧性地反复念叨着这个名字。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:70
translate zh ev_AdvGuildShowUpPostFaw_scr_4ff27ddd:

    # CELESTE @ talk "Ahh..."
    CELESTE @ talk "啊..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:71
translate zh ev_AdvGuildShowUpPostFaw_scr_171d1c66:

    # "She smiled playfully."
    "她顽皮地笑了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:72
translate zh ev_AdvGuildShowUpPostFaw_scr_250cfa03:

    # CELESTE @ talk "Then that must make you Master Eron."
    CELESTE @ talk "那么你一定是埃隆少爷了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:73
translate zh ev_AdvGuildShowUpPostFaw_scr_c678dd98:

    # ERON "You... You know my name? "
    ERON "你...你知道我的名字？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:74
translate zh ev_AdvGuildShowUpPostFaw_scr_c0c799fa:

    # "Celeste smiled ardently and rose to address the crowd."
    "赛莱斯特热情地微笑着站起身，面向人群。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:75
translate zh ev_AdvGuildShowUpPostFaw_scr_d4150165:

    # CELESTE @ talk "As some of you may know, we were sent to recover the wreckage of The Prophetic, which has been missing for the last three months."
    CELESTE @ talk "想必有人知道，我们奉命寻找三个月前失踪的'预言号'残骸。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:76
# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:77
translate zh ev_AdvGuildShowUpPostFaw_scr_6bfbb70b:

    # "There were some murmurs of acknowledgement mixed with a sense of unease that ran through the crowd, many had already heard the story of The Prophetic."
    "人群中响起混杂着不安的窃窃私语，许多人都听说过'预言号'的故事。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:78
translate zh ev_AdvGuildShowUpPostFaw_scr_694749f5:

    # "Celeste’s smile radiated through the crowd as her voice rose."
    "赛莱斯特提高嗓音，笑容如阳光般洒向人群。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:79
translate zh ev_AdvGuildShowUpPostFaw_scr_c27e72bd:

    # CELESTE @ talk "We found the crew and they will ALL be returning home shortly!"
    CELESTE @ talk "我们找到了全体船员，他们很快都将回家！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:80
translate zh ev_AdvGuildShowUpPostFaw_scr_b2f997e2:

    # "There was a tumultuous roar and cheers of applause as the child began to weep tears of joy, his grin apparent even from far away."
    "人群爆发出震耳欲聋的欢呼与掌声，男孩喜极而泣，即使从远处也能看清他咧开的嘴角。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:81
translate zh ev_AdvGuildShowUpPostFaw_scr_17e64f3a:

    # ERON "My father’s coming home?!"
    ERON "我爸爸要回家了？！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:82
translate zh ev_AdvGuildShowUpPostFaw_scr_c5da6b7e:

    # CELESTE @ talk "Yes! Your father is coming home, Master Eron!"
    CELESTE @ talk "是的！埃隆少爷，你父亲就要回家了！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:83
translate zh ev_AdvGuildShowUpPostFaw_scr_3f1fb060:

    # CELESTE @ talk "After being attacked by a pirate vessel, he and his crew washed up on a small island off the coast off Synmaria, surviving only on the fruits and vegetation they could scavenge."
    CELESTE @ talk "他们遭遇海盗船袭击后，被冲上辛玛利亚海岸附近的小岛，只能靠采集野果野菜维生。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:84
translate zh ev_AdvGuildShowUpPostFaw_scr_28e60873:

    # CELESTE @ talk "But after a great battle with a Demorai ship, we recovered them all!"
    CELESTE @ talk "但在与德莫莱舰船激战后，我们救出了所有人！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:85
translate zh ev_AdvGuildShowUpPostFaw_scr_8ce7de82:

    # ERON "Where is he!? Where is my father!"
    ERON "他在哪儿！？我爸爸在哪儿！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:86
translate zh ev_AdvGuildShowUpPostFaw_scr_f5e5f858:

    # CELESTE @ talk "Why..."
    CELESTE @ talk "这个嘛..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:87
translate zh ev_AdvGuildShowUpPostFaw_scr_6425ffe9:

    # CELESTE @ talk "{i}He’s right here!{/i}"
    CELESTE @ talk "{i}他就在这里！{/i}"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:88
translate zh ev_AdvGuildShowUpPostFaw_scr_38199cd1:

    # "Celeste motioned behind her with her hand and the bedraggled crew of The Prophetic shuffled forward through the crowd."
    "赛莱斯特朝身后示意，预言号那群衣衫褴褛的船员便从人群中蹒跚走出。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:89
translate zh ev_AdvGuildShowUpPostFaw_scr_3e17ab30:

    # "Upon seeing his father, the boy cried out in elation."
    "一见到父亲，男孩欣喜地大叫起来。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:91
translate zh ev_AdvGuildShowUpPostFaw_scr_17bd2c4b:

    # ERON "FATHER!"
    ERON "爸爸！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:92
translate zh ev_AdvGuildShowUpPostFaw_scr_df685b32:

    # CAPTAIN_DRONA "Eron!"
    CAPTAIN_DRONA "埃隆！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:93
translate zh ev_AdvGuildShowUpPostFaw_scr_7ae73cc9:

    # "As the boy rushed into the Captain’s arms, the crowd erupted into even wilder screams and shouts and Celeste raised both of her arms, revelling in the applause."
    "男孩冲进船长怀中时，人群爆发出更狂热的尖叫呐喊。赛莱斯特高举双臂，沉醉在掌声中。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:94
translate zh ev_AdvGuildShowUpPostFaw_scr_fc254c85:

    # "Enthralled by what we’d just witnessed, it was impossible to take my eyes off Celeste as she commanded the attention of those around her with the potency of her sheer presence."
    "我们被眼前景象深深吸引，无法将目光从赛莱斯特身上移开——她仅凭自身气场就牢牢掌控着周围所有人的注意力。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:98
translate zh ev_AdvGuildShowUpPostFaw_scr_e7725567:

    # CELESTE @ talk "PEOPLE OF NOVARAS!"
    CELESTE @ talk "诺瓦拉斯的子民们！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:99
translate zh ev_AdvGuildShowUpPostFaw_scr_c5ce9c8e:

    # CELESTE @ talk "CITIZENS OF ALDERAY!"
    CELESTE @ talk "奥尔德雷的公民们！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:100
translate zh ev_AdvGuildShowUpPostFaw_scr_7d4edbff:

    # CELESTE @ talk " HEAR ME NOW!"
    CELESTE @ talk " 此刻听我宣言！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:101
translate zh ev_AdvGuildShowUpPostFaw_scr_93665fcc:

    # "The crowd fell silent once again as she spoke with fiery passion."
    "她以炽热的激情演说，人群再度陷入寂静。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:102
translate zh ev_AdvGuildShowUpPostFaw_scr_612f509c:

    # CELESTE @ talk "I have felt and shared in your pain these last few years and want you to know I stand not just with you..."
    CELESTE @ talk "过去数年，我感受并分担着你们的痛苦。此刻我要让你们知道，我不仅与你们同在..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:103
translate zh ev_AdvGuildShowUpPostFaw_scr_fdaf9eb8:

    # CELESTE @ talk "BUT FOR YOU!"
    CELESTE @ talk "更为你们而战！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:104
translate zh ev_AdvGuildShowUpPostFaw_scr_dadb9942:

    # CELESTE @ talk "I will not rest until the plight of the Demorai ends and peace is restored upon our lands!"
    CELESTE @ talk "德莫莱的暴行不终结，和平不重归故土，我誓不罢休！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:105
translate zh ev_AdvGuildShowUpPostFaw_scr_12c05095:

    # CELESTE @ talk "This nightmare shall end!"
    CELESTE @ talk "这场噩梦必将终结！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:106
translate zh ev_AdvGuildShowUpPostFaw_scr_49c93d91:

    # CELESTE @ talk "Be it against demon or beast my blade is your blade!"
    CELESTE @ talk "无论面对恶魔还是野兽，我的剑即是你们的剑！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:107
translate zh ev_AdvGuildShowUpPostFaw_scr_ccb5f3ef:

    # CELESTE @ talk "My blood is your blood!"
    CELESTE @ talk "我的血就是你们的血！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:108
translate zh ev_AdvGuildShowUpPostFaw_scr_e98a92d4:

    # CELESTE @ talk "And though the night belongs to them..."
    CELESTE @ talk "纵使黑夜属于他们..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:109
translate zh ev_AdvGuildShowUpPostFaw_scr_a9f1dc83:

    # CELESTE @ laugh "I pledge to you; WE SHALL HAVE THE DAY!"
    CELESTE @ laugh "我向你们起誓：白昼终将属于我们！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:110
translate zh ev_AdvGuildShowUpPostFaw_scr_55a5d2cd:

    # "The crowd burst into utter jubilation."
    "人群陷入彻底的欢腾。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:111
translate zh ev_AdvGuildShowUpPostFaw_scr_cccb6fb9:

    # "In a sea of mediocre Heroes taking about glory and honour that could, at best, gain a passive smirk or nod of approval, Celeste could rally any crowd into total furore."
    "平庸的英雄们谈论着至多换来一丝哂笑或点头的荣耀，而赛莱斯特却能让任何人群陷入狂热的浪潮。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:118
translate zh ev_AdvGuildShowUpPostFaw_scr_f41e9dbf:

    # "Alive with excitement, we headed back into the Guild."
    "带着满心激动，我们返回公会大厅。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:119
translate zh ev_AdvGuildShowUpPostFaw_scr_b986cee7:

    # "As we did, Celeste passed by me, offering the briefest of glances that made my stomach turn in knots before the crowds shuffled in eagerly behind her."
    "途中赛莱斯特与我擦肩而过，短暂一瞥让我的胃部紧张得打结，人群随即急切地簇拥着她涌入。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:120
translate zh ev_AdvGuildShowUpPostFaw_scr_7afe3f0a:

    # MARKUS "Whoa... she’s..."
    MARKUS "哇哦...她真是..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:121
translate zh ev_AdvGuildShowUpPostFaw_scr_27d48f45:

    # MARKUS "{i}Incredible.{/i}"
    MARKUS "{i}不可思议。{/i}"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:122
translate zh ev_AdvGuildShowUpPostFaw_scr_dc8bb5a6:

    # "Shaking my head, I tried to regain some composure."
    "我摇摇头，试图恢复些镇定。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:123
translate zh ev_AdvGuildShowUpPostFaw_scr_e97c023c:

    # MARKUS "Hey, do you think there’s maybe a girl down at the Pleasure District who looks a little like her?"
    MARKUS "嘿，你说欢愉区会不会有姑娘长得像她？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:137
translate zh ev_AdvGuildShowUpPostFaw_scr_11051189:

    # UNKNOWN "Hello there!"
    UNKNOWN "你们好！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:138
translate zh ev_AdvGuildShowUpPostFaw_scr_bd7c5c11:

    # THEA "My name’s Thea, how can I help you both today?"
    THEA "我叫西娅，今天有什么能帮二位的？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:140
translate zh ev_AdvGuildShowUpPostFaw_scr_c59cca9b:

    # MC @ talk "We’re the new Adventurers, I guess."
    MC @ talk "我想...我们就是新来的冒险者。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:141
translate zh ev_AdvGuildShowUpPostFaw_scr_d258435c:

    # "马库斯 chuckled quietly."
    "马库斯轻声笑了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:142
translate zh ev_AdvGuildShowUpPostFaw_scr_4aeafa86:

    # THEA "Oh! You must be the two we were informed about!"
    THEA "哦！你们一定就是接到通知的那两位！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:143
translate zh ev_AdvGuildShowUpPostFaw_scr_3892c652:

    # THEA "Let me be the first to welcome you to the Adventurers Guild!"
    THEA "请允许我第一个欢迎你们加入冒险者公会！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:144
translate zh ev_AdvGuildShowUpPostFaw_scr_e48ead57:

    # THEA "If you have any questions, now’s the time to ask them."
    THEA "有任何疑问，现在尽管提出来。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:149
translate zh act1scene3menu_b0add572:

    # THEA "Should you wish to embark on a quest, you need only put your name down on the Quest Board for whatever one it is you’re pursuing."
    THEA "若想承接任务，只需在任务板上对应任务下登记姓名即可。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:150
translate zh act1scene3menu_d65a75dc:

    # THEA "Quests are ranked by their difficulty."
    THEA "任务按难度分级。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:151
translate zh act1scene3menu_54d83324:

    # THEA "The greater the difficulty, the greater the risk... and the reward."
    THEA "难度越高，风险越大...报酬也越丰厚。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:155
translate zh act1scene3menu_72d04b25:

    # THEA "Nope! Anyone who puts their name down is eligible to participate."
    THEA "不！任何登记姓名者都有资格参与。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:156
translate zh act1scene3menu_fa00c2a1:

    # THEA "Keep in mind that multiple parties may attempt the same quest, we {i}only{/i} reward the successful candidates."
    THEA "请注意，多个队伍可能尝试同一任务，我们{i}只{/i}奖励成功者。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:157
translate zh act1scene3menu_1db0d6d9:

    # THEA "It’s also up to you to decide how to split any shares between yourselves, we offer a lump sum as reward."
    THEA "报酬分配也由你们自行协商，我们只提供总额奖金。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:161
translate zh act1scene3menu_22043f0c:

    # THEA "Now? Less than five hundred remain..."
    THEA "现在？不足五百人了..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:162
translate zh act1scene3menu_b91edc24:

    # THEA "I have to admit, it’s a far cry from the glory days of Newheart."
    THEA "不得不承认，比起纽哈特的辉煌年代差远了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:163
translate zh act1scene3menu_12885e37:

    # THEA "Back then we nearly had two thousand Guild members running around! Can you believe that?"
    THEA "那时公会成员将近两千！你能想象吗？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:164
translate zh act1scene3menu_38c0753f:

    # THEA "But... we make do with what we have!"
    THEA "但...我们尽力而为！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:165
translate zh act1scene3menu_c02c736f:

    # THEA "And there are still some exciting new names making their own legends!"
    THEA "而且仍有令人振奋的新名字在缔造传奇！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:166
translate zh act1scene3menu_0dee6fd5:

    # THEA "Who knows... maybe you two will make a legend of yourselves!"
    THEA "谁知道呢...也许你们俩也会成为传奇！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:170
translate zh act1scene3menu_cf69118c:

    # THEA "Okay, glad to be of assistance!"
    THEA "好的，很高兴能帮上忙！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:171
translate zh act1scene3menu_1027174a:

    # THEA "I've got to return to my work now."
    THEA "我得回去工作了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:173
translate zh act1scene3menu_9299fc0b:

    # MC @ talk "Well, at least that’s done now."
    MC @ talk "呼，至少这事办完了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:175
translate zh act1scene3menu_863a2563:

    # MARKUS "Yeah, one headache less..."
    MARKUS "是啊，少了个麻烦..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:177
translate zh act1scene3menu_30b20d66:

    # MARKUS "Yeah. Up for a drink later? Remember, you promised!"
    MARKUS "嗯。晚点去喝一杯？记得你答应过的！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:178
translate zh act1scene3menu_7ca81017:

    # MC "But I didn't!"
    MC "我可没答应！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:179
# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:182
translate zh act1scene3menu_8ef74120:

    # "As we turned to leave, I bumped straight into Celeste who was busy dealing with her many adoring fans, regaling them with titillating details of her adventures."
    "我们转身离开时，我正撞上赛莱斯特——她正忙于应付众多崇拜者，讲述冒险中引人入胜的细节。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:185
translate zh act1scene3menu_d9f01d4d:

    # "Spinning around sharply, her eyes met mine and for a moment, they were daggers."
    "她猛地转身，目光如利刃般刺向我。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:186
translate zh act1scene3menu_ef59baf2:

    # "But just as quickly, she relaxed, an easy smile spread across her face."
    "但转瞬之间她放松下来，脸上浮现从容的微笑。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:187
translate zh act1scene3menu_66c01fcc:

    # CELESTE @ talk "I know you..."
    CELESTE @ talk "我认得你..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:188
translate zh act1scene3menu_80c5dfd9:

    # CELESTE @ talk "You two are the lone survivors, right?"
    CELESTE @ talk "你们俩是仅存的幸存者，对吧？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:189
translate zh act1scene3menu_5acbcff2:

    # "The crowd formed a captivated circle around us."
    "人群围着我们形成一个着迷的圆圈。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:190
translate zh act1scene3menu_ee1182d9:

    # MARKUS "That’s us, ma’am!"
    MARKUS "正是我们，女士！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:191
translate zh act1scene3menu_e7c5f4c3:

    # "Celeste laughed delicately."
    "赛莱斯特优雅地笑了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:192
translate zh act1scene3menu_285a0a19:

    # CELESTE @ talk "Very impressive, boys!"
    CELESTE @ talk "令人印象深刻啊，小伙子们！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:193
translate zh act1scene3menu_b0d59f86:

    # CELESTE @ talk "You’ll have to tell me all about it the next time we meet."
    CELESTE @ talk "下次见面你们得好好跟我讲讲。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:194
translate zh act1scene3menu_5fc5c665:

    # CELESTE @ talk "Tell me..."
    CELESTE @ talk "告诉我..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:195
translate zh act1scene3menu_48a301dc:

    # CELESTE @ talk "What are your names?"
    CELESTE @ talk "你们叫什么名字？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:196
translate zh act1scene3menu_f929b4eb:

    # "Her voice had an alluringly hypnotic quality to it."
    "她的声音带着蛊惑人心的魔力。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:198
translate zh act1scene3menu_3ae7807c:

    # "Celeste said my name, letting her tongue twist and twirl around it."
    "赛莱斯特念着我的名字，舌尖仿佛在名字上缠绕打转。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:199
translate zh act1scene3menu_4084ca52:

    # "Something about the way she said it was... {i}appealing{/i}."
    "那语调中有种...{i}撩人{/i}的意味。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:200
translate zh act1scene3menu_21a93bcc:

    # CELESTE @ talk "Well... {i}I{/i} look forward to meeting you again."
    CELESTE @ talk "那么...{i}我{/i}很期待与你们再会。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:201
translate zh act1scene3menu_3727e20d:

    # CELESTE @ talk "Perhaps we will get to have Adventures with one another soon?"
    CELESTE @ talk "也许很快我们就能并肩冒险？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:202
translate zh act1scene3menu_772f97e6:

    # "I blushed crimson at the thought, something in her eyes made me feel a tinge of excitement that I hoped no one would notice as it pressed against my trousers."
    "想到这我满脸通红，她眼中的某种东西让我感到一阵兴奋，我祈祷没人注意到裤裆被顶起的窘态。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:203
translate zh act1scene3menu_ea65fdab:

    # MARKUS "We’d love to, ma’am! Anytime just let us know!"
    MARKUS "我们求之不得，女士！随时听候差遣！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:204
translate zh act1scene3menu_76e68d92:

    # "Celeste laughed once again."
    "赛莱斯特再次笑了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:205
translate zh act1scene3menu_69f07d64:

    # CELESTE @ talk "I look forward to it..."
    CELESTE @ talk "我很期待..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:206
translate zh act1scene3menu_6d28f3f1:

    # CELESTE @ talk "Now, if you’ll excuse me."
    CELESTE @ talk "那么，恕我失陪。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:209
translate zh act1scene3menu_def2df26:

    # "As Celeste made her way past me, I caught her sweet scent and felt myself turn rock hard almost instinctively."
    "赛莱斯特经过我身旁时，我嗅到她甜美的气息，几乎本能地感到自己硬如岩石。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:210
translate zh act1scene3menu_13d57d6f:

    # "The crowd followed behind her, calling out her name with questions, begging for her attention."
    "人群追随其后，呼喊着她的名字提问，渴求她的关注。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:211
translate zh act1scene3menu_66c2ed1d:

    # "I traced her strut and bit my lower lip staring at her tightly-armored behind."
    "我目送她昂首阔步，咬着下唇凝视她紧身盔甲包裹的臀部。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:213
translate zh act1scene3menu_4e2a0008:

    # MARKUS "Holy..."
    MARKUS "天哪..."

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:214
translate zh act1scene3menu_48916eb6:

    # MARKUS "I call that one."
    MARKUS "这个归我了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:215
translate zh act1scene3menu_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "什么？"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:216
translate zh act1scene3menu_a05d5ae9:

    # MC @ talk "You don’t get to call that one!"
    MC @ talk "你没资格说那个！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:217
translate zh act1scene3menu_9398bd39:

    # MARKUS "Yep! Just did."
    MARKUS "没错！我就是说了。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:218
translate zh act1scene3menu_74799834:

    # MC @ talk "Nuh-uh."
    MC @ talk "那个不算。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:219
translate zh act1scene3menu_2783c591:

    # MARKUS "Uh-uh!"
    MARKUS "就是算！"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:220
translate zh act1scene3menu_b88f9cab:

    # MC @ talk "Stop being such a child about it."
    MC @ talk "别这么幼稚行不行。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:221
translate zh act1scene3menu_4c1cd8ea:

    # MC @ talk "She’s probably not even interested in either of us that way anyway."
    MC @ talk "而且她多半对咱俩都没那种意思。"

# game/data/world_events/adventure_guild_showup/ev_AdvGuildShowUp_scr.rpy:222
