# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:39
translate zh ev_blackDiamondFawhaOnReturn_68ba2e87:

    # FAWHA @ talk "We've been told to offer our services to you both for free."
