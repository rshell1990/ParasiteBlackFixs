# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:25
translate zh ev_blackDiamondFawhaOnReturn_da9e306b:

    # FAWHA @ talk "After Tarek was killed, the rival factions have been tearing each other apart to grab what they can of Tarek's old territory."
    FAWHA @ talk "塔雷克被杀后，敌对派系一直在互相撕扯，争夺他留下的地盘。"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:26
translate zh ev_blackDiamondFawhaOnReturn_7a940b86:

    # FAWHA @ talk "The Khazhah have managed to push out the rival factions and take over management here."
    FAWHA @ talk "卡扎帮成功赶走了敌对派系，接管了这里。"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:27
translate zh ev_blackDiamondFawhaOnReturn_ca4ecab6:

    # MC @ talk "Are you treated well?"
    MC @ talk "他们对你们好吗？"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:28
translate zh ev_blackDiamondFawhaOnReturn_a26c51b6:

    # FAWHA @ talk "Khazah's treat us well enough I suppose, but they're flooding the place with more raza than the Vulshan's ever did."
    FAWHA @ talk "卡扎帮对我们还算可以，但他们往这里塞的拉扎人比伏尔珊帮多得多。"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:29
translate zh ev_blackDiamondFawhaOnReturn_d37638f8:

    # FAWHA @ sad "Things are becoming more violent than ever now... I fear things will only get worse before they get better."
    FAWHA @ sad "现在暴力事件比以往任何时候都多...恐怕情况在好转前会变得更糟。"

# game/data/world_events/blackDiamondFawhaOnReturn/scr_blackDiamondFawhaOnReturn.rpy:32
