translate zh ev_markus_tavern_053903ef:

    # MC @ talk "马库斯, we hardly know anything about what's happened to us aside from what we've been told."
    MC @ talk "马库斯，除了他们告知的信息，我们对自身遭遇几乎一无所知。"

# game/data/world_events/markus_tavern_post_faw/scr.rpy:41
translate zh ev_markus_tavern_fceb992d:

    # MARKUS "What more do you need to know?"
    MARKUS "你还需要知道什么？"

# game/data/world_events/markus_tavern_post_faw/scr.rpy:42
translate zh ev_markus_tavern_f355bdbb:

    # MARKUS "They made the rules fairly clear friend, and quite frankly, I'm looking forward to {i}finally{/i} having things easy for a while."
    MARKUS "规则说得很明白了朋友，坦白讲，我期待{i}终于{/i}能轻松一阵子。"

# game/data/world_events/markus_tavern_post_faw/scr.rpy:43
translate zh ev_markus_tavern_c3f06f55:

    # MC @ talk "Will it be easy though 马库斯, {i}will it really?{/i}"
    MC @ talk "但真会轻松吗马库斯，{i}当真如此？{/i}"

# game/data/world_events/markus_tavern_post_faw/scr.rpy:44
translate zh ev_markus_tavern_b25bf2ac:

    # MARKUS "{i}*Sigh*{/i}"
    MARKUS "{i}*叹气*{/i}"

