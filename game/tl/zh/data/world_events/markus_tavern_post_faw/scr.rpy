# game/data/world_events/markus_tavern_post_faw/scr.rpy:37
translate zh ev_markus_tavern_54702566:

    # MARKUS @ angry "You over worry."
    MARKUS @ angry "你过度焦虑了。"

# game/data/world_events/markus_tavern_post_faw/scr.rpy:38
translate zh ev_markus_tavern_e9f73ef7:

    # MC @ talk "And you don't worry enough."
    MC @ talk "而你却毫不担忧。"

# game/data/world_events/markus_tavern_post_faw/scr.rpy:39
translate zh ev_markus_tavern_e49e0a40:

    # MARKUS @ angry "Bah!"
    MARKUS @ angry "呸！"

