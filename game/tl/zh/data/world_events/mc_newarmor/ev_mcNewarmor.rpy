

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:30
translate zh event_mc_newarmor_27802282:

    # "I struggled to pull away from her tight grip as I tried to calm her."
    "我努力想从她紧箍的怀抱中挣脱，同时试图安抚她。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:31
translate zh event_mc_newarmor_cf02347d:

    # MC @ talk "Ahh! Careful!"
    MC @ talk "啊！小心点！"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:32
translate zh event_mc_newarmor_fdd3b5c9:

    # REGINA @ sad "What happened?"
    REGINA @ sad "发生什么事了？"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:33
translate zh event_mc_newarmor_101035ab:

    # REGINA @ sad "I heard you were seen being carried off towards the doctors, then the next thing I knew, I was told you were fighting for your life!"
    REGINA @ sad "我听说有人看见你被抬去医生那儿，紧接着就被告知你在生死线上挣扎！"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:36
translate zh event_mc_newarmor_b1d7f9ea:

    # REGINA @ sad "I told you to be careful."
    REGINA @ sad "我告诉过你要小心的。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:37
translate zh event_mc_newarmor_cc49f520:

    # REGINA @ angry "You need to listen to me more!"
    REGINA @ angry "你得多听听我的话！"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:40
translate zh event_mc_newarmor_84cdfdb7:

    # REGINA @ sad "{i}*Sigh*{/i} Please be more careful."
    REGINA @ sad "{i}*叹气*{/i} 请务必更加小心。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:41
translate zh event_mc_newarmor_651acbbd:

    # REGINA @ sad "I don't know what I would do with myself if something happened to you."
    REGINA @ sad "如果你出了什么事，我真不知道自己该怎么办。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:42
translate zh event_mc_newarmor_417f0ac4:

    # "The thought lingered for a moment on how close to death once again I truly had come."
    "我再次真切地意识到自己离死亡有多近，这个念头在我脑海中萦绕不去。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:43
translate zh event_mc_newarmor_16180672:

    # "I had become perhaps too arrogant with my newfound powers."
    "或许是因为获得了新力量，我变得太过自负了。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:44
translate zh event_mc_newarmor_98f0f479:

    # "Death as a prospect seemed to have slipped further and further away since I merged with the dark passenger."
    "自从与黑暗共生体融合后，死亡的可能性似乎离我越来越远。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:45
translate zh event_mc_newarmor_2dc6ae13:

    # "But now... Now I remembered I {i}was{/i} still vulnerable, and should I meet my end, those most precious to me would be left to fend for themselves without me."
    "但现在...现在我想起来了，我{i}依然{/i}脆弱。如果我死了，那些我最珍视的人将失去依靠，独自面对一切。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:46
translate zh event_mc_newarmor_9f04f515:

    # MC @ sad "...I promise I will be more careful."
    MC @ sad "...我保证我会更加小心的。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:48
translate zh event_mc_newarmor_3baf8be0:

    # "She smelt good, like freshly cut wildflowers."
    "她闻起来很香，像新采摘的野花。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:49
translate zh event_mc_newarmor_3c9c0ec0:

    # "She reluctantly pulled away and said,"
    "她不情愿地抽身，说道："

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:50
translate zh event_mc_newarmor_c511e082:

    # REGINA @ talk "There is some good news."
    REGINA @ talk "有个好消息。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:51
translate zh event_mc_newarmor_6ab64f68:

    # REGINA @ talk "Your father has sent word and had delivered a gift for you."
    REGINA @ talk "你父亲捎来了消息，还给你送了件礼物。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:52
translate zh event_mc_newarmor_9ae375a2:

    # MC @ surprised "Father?"
    MC @ surprised "父亲？"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:53
translate zh event_mc_newarmor_feb968f0:

    # REGINA @ talk "Yes... Some new armour and a letter for us each."
    REGINA @ talk "是的...一些新的盔甲，还有给我们每人的信。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:54
translate zh event_mc_newarmor_3373e8dd:

    # REGINA @ talk "I brought it into your room for when you want to read it."
    REGINA @ talk "我把它放在你房间了，你随时可以去看。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:55
translate zh event_mc_newarmor_cf18f36a:

    # MC @ talk "Thank you."
    MC @ talk "谢谢你。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:56
translate zh event_mc_newarmor_342e3913:

    # REGINA @ sad "How are your wounds? Are they-"
    REGINA @ sad "你的伤怎么样了？它们-"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:57
translate zh event_mc_newarmor_cea14b40:

    # MC @ talk "I am still sore but, I am fine."
    MC @ talk "还有点疼，但我没事。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:58
translate zh event_mc_newarmor_9651a39e:

    # MC @ talk "I promise you."
    MC @ talk "我向你保证。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:63
translate zh event_mc_newarmor_a4f1e169:

    # MC "{i}*Sigh*{/i}"
    MC "{i}*叹气*{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:65
translate zh event_mc_newarmor_39b10682:

    # MC "(I should see what father has brought me.)"
    MC "(我该去看看父亲给我带了什么。)"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:71
translate zh event_mc_newarmor_bce5ed0b:

    # "The armour was laid out for me on the bed with the note held down beneath one of the gauntlet."
    "盔甲被摊开摆放在我的床上，信笺压在一只护手下面。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:72
translate zh event_mc_newarmor_05ccf7f6:

    # "I held up the note and began to read it."
    "我拿起信笺读了起来。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:73
translate zh event_mc_newarmor_a857a5b5:

    # "{i}My son,{/i}"
    "{i}吾儿，{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:74
translate zh event_mc_newarmor_155a8472:

    # "{i}I am both troubled and proud to hear of your services to the Scouts corps.{/i}"
    "{i}听闻你为侦察兵团效力，我既忧心忡忡又深感骄傲。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:75
translate zh event_mc_newarmor_1bd0e806:

    # "{i}I am angered as to why you were sent there to begin with, despite the assurances of those of higher stations than mine, that you and your friends places were secured with administrative roles only.{/i}"
    "{i}令我愤怒的是你为何会被派往那里。尽管那些位阶高于我的人曾保证过，你和你的朋友们只会担任行政职务。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:76
translate zh event_mc_newarmor_879aa470:

    # "{i}Despite what I can only assume to be the result of clerical errors, I have heard of you and 马库斯的 bravery, and how you both were the sole survivors of a mission gone awry.{/i}"
    "{i}尽管我只能将其归咎于文书失误，但我已听闻你和马库斯的英勇事迹，以及你们如何成为那次失败任务中仅有的幸存者。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:77
translate zh event_mc_newarmor_36456eef:

    # "{i}There is no greater fear for a father, than to lose his only son, and it pleases me greatly to know you are still hopefully well by the time this letter reaches you.{/i}"
    "{i}对一位父亲而言，最大的恐惧莫过于失去独子。得知此信送达时你安然无恙，我倍感欣慰。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:78
translate zh event_mc_newarmor_980ce1e6:

    # "{i}My work here is important, but it is so far mostly safe, despite the days dragging long tediously.{/i}"
    "{i}我在此地的工作虽重要，但迄今大体安全，尽管日子漫长而乏味。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:79
translate zh event_mc_newarmor_bdff8cf2:

    # "{i}I look forward to seeing you, Erika, and everyone soon in the next few months.{/i}"
    "{i}期待在未来几个月内能见到你、艾瑞卡和大家。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:80
translate zh event_mc_newarmor_58cdd376:

    # "{i}In the last letter I received, it mentioned you and that 阿达拉 girl were still close.{/i}"
    "{i}上一封信中提到你和那位叫阿达拉的姑娘依然亲近。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:81
translate zh event_mc_newarmor_a593e099:

    # "{i}Perhaps when I am back, I could speak to her father to arrange your betrothal if you wish?{/i}"
    "{i}或许等我归来，若你愿意，我可以和她父亲谈谈，为你们安排订婚？{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:82
translate zh event_mc_newarmor_a25b1eff:

    # "{i}It would be good for some good to come from all this darkness recently...{/i}"
    "{i}若能从近来的阴霾中生出些好事来...那也不错...{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:83
translate zh event_mc_newarmor_92e51415:

    # "{i}Now, I have sent to you a gift as I am sure you have received with this letter.{/i}"
    "{i}现在，我已寄去一份礼物，想必你已随此信收到。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:84
translate zh event_mc_newarmor_89cc93c0:

    # "{i}I have been told that you have been entered involuntarily into the Adventurers Guild as per the Emperor's will.{/i}"
    "{i}我被告知，根据皇帝陛下的旨意，你已被迫加入了冒险者公会。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:85
translate zh event_mc_newarmor_79c549a8:

    # "{i}Despite my complete displeasure at the events that have unfolded, we must do the best we can with the cards dealt.{/i}"
    "{i}尽管我对事态发展极为不满，但我们必须尽己所能，打好手中这副牌。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:86
translate zh event_mc_newarmor_c350386b:

    # "{i}Therefore, I cannot bear the thought of you running around in whatever scrap metal they have given you and called 'armour' for your line of work.{/i}"
    "{i}因此，想到你穿着他们随便给的、美其名曰“盔甲”的破铜烂铁四处冒险，我就无法忍受。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:87
translate zh event_mc_newarmor_716596ef:

    # "{i}I have spent of my own coin to have fashioned for your armour that may actually protect you.{/i}"
    "{i}我自掏腰包，为你定制了一套真正能保护你的盔甲。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:88
translate zh event_mc_newarmor_6191ad84:

    # "{i}I have heard you are far larger now since I last saw you, and I hope given the reports I received that I have gotten the right size.{/i}"
    "{i}听闻你比我上次见时魁梧许多。但愿根据我收到的报告，尺寸是对的。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:89
translate zh event_mc_newarmor_6f096071:

    # "{i}I hope it serves and protects you well my son, I will pray for your safety along with my own.{/i}"
    "{i}愿它能护你周全，我的儿子。我会为你的安全祈祷，如同为我自己祈祷一样。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:90
translate zh event_mc_newarmor_7be7e97d:

    # "{i}Love, your father.{/i}"
    "{i}爱你的父亲。{/i}"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:91
translate zh event_mc_newarmor_b721a6c6:

    # MC "(...Father.)"
    MC "(...父亲。)"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:93
translate zh event_mc_newarmor_f879d3c7:

    # "Placing down the letter, I looked over towards the armour and after stripping down, placed it on piece by piece."
    "放下信笺，我看向那套盔甲。脱去衣物后，我一件件将它穿戴起来。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:95
translate zh event_mc_newarmor_b0a71ca1:

    # "It was certainly heavier than the old armour, yet not by much, and it fit my frame surprisingly well."
    "它确实比旧盔甲重些，但并未重太多，而且出乎意料地贴合我的身形。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:100
translate zh event_mc_newarmor_edd2f054:

    # "As I looked down towards my hand, I crunched it tightly into a ball."
    "我低头看着自己的手，紧紧攥成了拳头。"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:101
translate zh event_mc_newarmor_ef4bd956:

    # MC "(Next time.)"
    MC "(下一次。)"

# game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:102
translate zh event_mc_newarmor_67adc9b3:

    # MC "(Next time I'll be ready for whatever comes.)"
    MC "(下一次，无论面对什么，我都会做好准备。)"

translate zh strings:

    # game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:34
    old "I was attacked by... {i}something.{/i}"
    new "我被... {i}某个东西{/i}袭击了。"

    # game/data/world_events/mc_newarmor/ev_mcNewarmor.rpy:34
    old "I'm fine... They're over-exaggerating."
    new "我没事...他们太夸张了。"
