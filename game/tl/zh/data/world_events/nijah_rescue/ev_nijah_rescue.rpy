

# game/data/world_events/nijah_rescue/ev_nijah_rescue.rpy:65
translate zh ev_nijah_rescue_0_f3d96e92:

    # "Making my way through the streets of Novaras, In the distance, I heard the shrieking sounds of a cry and panicked pleading."
    "我走在诺瓦拉斯的街道上，远处传来一阵尖叫声和惊慌的哀求声。"

# game/data/world_events/nijah_rescue/ev_nijah_rescue.rpy:66
translate zh ev_nijah_rescue_0_51009b86:

    # "Looking around, People went about their business obliviously, unable to hear the cries that to me were almost deafening."
    "环顾四周，人们浑然不觉地忙着自己的事，似乎听不到那对我而言震耳欲聋的哭喊。"

# game/data/world_events/nijah_rescue/ev_nijah_rescue.rpy:67
translate zh ev_nijah_rescue_0_a041d644:

    # MC "(What is that sound?)"
    MC "(那是什么声音？)"

# game/data/world_events/nijah_rescue/ev_nijah_rescue.rpy:68
translate zh ev_nijah_rescue_0_f2f55c46:

    # MC "(It sounds like it's nearby...)"
    MC "(听起来就在附近...)"

translate zh strings:

