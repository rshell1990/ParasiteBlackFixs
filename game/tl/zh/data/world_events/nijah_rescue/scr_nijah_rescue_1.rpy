

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:3
translate zh evscr_nijah_rescue_1_53260509:

    # MC "Sounds like sure trouble... Should I?" nointeract
    MC "听起来肯定有麻烦...我要管吗？" nointeract

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:6
translate zh evscr_nijah_rescue_1_f8d6d024:

    # "I turned sharply as I made my way through a series of dark and fetid alleyways, chasing the sounds."
    "我猛地转身，循着声音穿过一连串阴暗恶臭的小巷。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:7
translate zh evscr_nijah_rescue_1_843b0aa0:

    # "Stumbling over dislodged cobblestones and piles of rubbish, I finally came across a woman, terrified and cowering."
    "我踉跄地踏过松动的鹅卵石和垃圾堆，终于发现一个惊恐蜷缩的女子。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:8
translate zh evscr_nijah_rescue_1_bba0ea96:

    # "Her face was shrouded by rags as the men surrounded her brandishing their blades."
    "男人们挥舞着刀刃包围她时，破布遮住了她的脸。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:9
translate zh evscr_nijah_rescue_1_db49222d:

    # "The largest amongst them, a fat, repulsive bearded thug, towered over her."
    "其中最魁梧的是个肥胖恶心的胡须暴徒，居高临下地瞪着她。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:10
translate zh evscr_nijah_rescue_1_275c7a43:

    # THUG @ talk "Stupid fucking whore."
    THUG @ talk "蠢婊子。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:11
translate zh evscr_nijah_rescue_1_9caf38da:

    # THUG @ talk "You still owe us gold, girl!"
    THUG @ talk "丫头，你还欠我们钱！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:12
translate zh evscr_nijah_rescue_1_9e522f02:

    # "The frightened, muffled voice pleaded back."
    "惊恐而沉闷的声音哀求着回应。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:13
translate zh evscr_nijah_rescue_1_87ee3a0e:

    # UNKNOWN @ talk "Please! Need time!"
    UNKNOWN @ talk "求求你！再给我点时间！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:14
translate zh evscr_nijah_rescue_1_39c7b05d:

    # THUG @ talk "No more time, you pay NOW!"
    THUG @ talk "没时间了，现在就还钱！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:21
translate zh evscr_nijah_rescue_1_afadeed1:

    # "From the shadows I emerged, and the men turned to face me."
    "我从阴影中现身，那些男人转身面对我。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:22
translate zh evscr_nijah_rescue_1_568bf043:

    # THUG @ talk "Who are you?"
    THUG @ talk "你是谁？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:23
translate zh evscr_nijah_rescue_1_5a8de8fb:

    # THUG @ talk "Stay out of this, this does nor a concern you."
    THUG @ talk "少管闲事，这与你无关。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:24
translate zh evscr_nijah_rescue_1_73cc7d0a:

    # "Looking around, I could see dozens of eyes watching from every open crevice and window."
    "环顾四周，我能看到无数眼睛从每道缝隙和窗口窥视。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:25
translate zh evscr_nijah_rescue_1_cef271a4:

    # MC "(Damn... I better be careful here, it’s too risky to transform)"
    MC "(该死...我得小心点，变身太冒险了)"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:26
translate zh evscr_nijah_rescue_1_d5d88d8b:

    # MC "(If I fight them, I’ll have to do it in my normal form)"
    MC "(如果动手，只能用普通形态战斗)"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:39
translate zh evscr_nijah_rescue_1_thugsmenu_0ba34b00:

    # THUG @ talk "Bah! There are three of us and only one of you!"
    THUG @ talk "哈！我们有三个人，你只有孤身一个！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:40
translate zh evscr_nijah_rescue_1_thugsmenu_e049bb73:

    # THUG @ talk "You’ll have to do better than that!"
    THUG @ talk "想吓唬我们还不够格！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:45
translate zh evscr_nijah_rescue_1_thugsmenu_b57efaae:

    # THUG @ talk "Kill him, you fools!"
    THUG @ talk "干掉他，蠢货们！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:50
translate zh evscr_nijah_rescue_1_thugsmenu_6e045b1a:

    # "As their lifeless bodies littered the alleyway, the blood flowed freely into the cracks of the cobblestone."
    "当他们的尸体横陈小巷时，鲜血肆意渗入鹅卵石的缝隙。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:51
translate zh evscr_nijah_rescue_1_thugsmenu_350520a2:

    # "I sighed with relief, wiping the sweat from my brow but quickly realised I couldn’t stay here long or else I risked drawing the ire of the guards."
    "我如释重负地叹息，抹去额头的汗水，但随即意识到不能久留——否则可能招来卫兵的怒火。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:55
translate zh evscr_nijah_rescue_1_thugsmenu_83ae0dcb:

    # THUG @ talk "This is not your business, stranger!"
    THUG @ talk "这不关你的事，陌生人！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:56
translate zh evscr_nijah_rescue_1_thugsmenu_f5ad7f49:

    # THUG @ talk "This woman owes us money and she will pay it!"
    THUG @ talk "这女人欠我们钱，她必须还！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:57
translate zh evscr_nijah_rescue_1_thugsmenu_03518bd4:

    # MC @ talk "How much is her debt?"
    MC @ talk "她欠多少？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:58
translate zh evscr_nijah_rescue_1_thugsmenu_b02d4725:

    # THUG @ talk "Two hundred coins now... the rest later."
    THUG @ talk "现在两百金币...剩下的之后再说。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:62
translate zh evscr_nijah_rescue_1_thugsmenu_3a22e377:

    # THUG @ talk "Hmm..."
    THUG @ talk "唔..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:63
translate zh evscr_nijah_rescue_1_thugsmenu_9a589a68:

    # THUG @ talk "You have bought yourself some time, {i}for now,{/i} girl..."
    THUG @ talk "你给自己争取了点时间，{i}暂时而已{/i}，丫头..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:64
translate zh evscr_nijah_rescue_1_thugsmenu_276b253c:

    # THUG @ talk "Pleasure doing business with you, stranger, heh..."
    THUG @ talk "和你做生意很愉快，陌生人，呵..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:68
translate zh evscr_nijah_rescue_1_thugsmenu_6dfebd14:

    # THUG @ talk "Men! Draw your blades!"
    THUG @ talk "弟兄们！拔刀！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:76
translate zh evscr_nijah_rescue_1_thugsmenu_b711464f:

    # THUG @ talk "A wise decision..."
    THUG @ talk "明智的决定..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:80
translate zh evscr_nijah_rescue_1_thugsmenu_f5d8de19:

    # MC "(As I left the alley, I could hear the strangely familiar voice pleading behind me for mercy.)"
    MC "(离开小巷时，我听见身后传来奇怪的熟悉声音在乞求怜悯。)"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:82
translate zh evscr_nijah_rescue_1_thugsmenu_cd817b72:

    # MC "(As I left the alley, I could hear a female voice pleading behind me for mercy.)"
    MC "(离开小巷时，我听见身后传来女性的乞求声。)"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:83
translate zh evscr_nijah_rescue_1_thugsmenu_316d5d01:

    # MC "(I wondered if I could, or should, have done something different there.)"
    MC "(我思索着当时能否或本该采取不同的行动。)"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_1.rpy:84
translate zh evscr_nijah_rescue_1_thugsmenu_8dd41211:

    # MC "(But, it's best to leave Ramonians to handle their own affairs.)"
    MC "(但最好让罗莫尼亚人自行处理他们的事务。)"

