

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:9
translate zh evscr_nijah_rescue_2_4fbc34b2:

    # "I turned towards the woman cowering on the floor. As I approached her, she raised her arm defensively in the air."
    "我转向蜷缩在地的女子。走近时，她防备地举起手臂。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:10
translate zh evscr_nijah_rescue_2_deb6c08a:

    # MC @ talk "It’s alright, I’m not going to hurt you."
    MC @ talk "没事了，我不会伤害你。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:12
translate zh evscr_nijah_rescue_2_bf84c919:

    # UNKNOWN "..."
    UNKNOWN "..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:13
translate zh evscr_nijah_rescue_2_cee23ab1:

    # UNKNOWN "T-Thank you stranger."
    UNKNOWN "谢-谢谢你，陌生人。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:15
translate zh evscr_nijah_rescue_2_607f82ee:

    # MC @ talk "Here, let me help you up."
    MC @ talk "来，我扶你起来。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:16
translate zh evscr_nijah_rescue_2_cd373b13:

    # "With my hand out-stretched, I reached out and held her soft hand as I gently pulled her back to her feet."
    "我伸出手，握住她柔软的手，轻轻将她拉起来。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:17
translate zh evscr_nijah_rescue_2_63c5e807:

    # MC @ talk "Did they hurt you?"
    MC @ talk "他们伤到你了吗？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:18
translate zh evscr_nijah_rescue_2_177e3578:

    # UNKNOWN "No, I iz fine..."
    UNKNOWN "没有，我...我没事..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:19
translate zh evscr_nijah_rescue_2_4d72dedb:

    # "As the woman unwrapped her headscarf to look at me, her eyes now settling from the panic fear."
    "当女子解开头巾看向我时，她眼中的惊恐已逐渐平复。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:22
translate zh evscr_nijah_rescue_2_90c622eb:

    # "I immediately recognised who she was."
    "我立刻认出了她是谁。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:23
translate zh evscr_nijah_rescue_2_e5cfdaf0:

    # MC @ talk "You... You're that woman I met at the pleasure district!"
    MC @ talk "你...你是欢愉区遇到的那位女士！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:24
translate zh evscr_nijah_rescue_2_9de1b7a2:

    # "The woman looked at me quizzically for a moment, not quite able to place my face."
    "女子困惑地看了我片刻，一时想不起我的样貌。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:25
translate zh evscr_nijah_rescue_2_74a6ea16:

    # MC @ talk "... Nijah?"
    MC @ talk "...妮雅？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:26
translate zh evscr_nijah_rescue_2_56014db0:

    # "Her eyes squinted towards me before recognition dawned on her face as well."
    "她眯眼打量我，随后脸上也浮现出恍然大悟的神情。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:28
translate zh evscr_nijah_rescue_2_aed3993e:

    # NIJAH "You... You were za boy..."
    NIJAH "你...你是那个男孩..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:29
translate zh evscr_nijah_rescue_2_6e091bb8:

    # NIJAH "The one joining zer Scouts..."
    NIJAH "加入调查兵团的那个..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:30
translate zh evscr_nijah_rescue_2_aa308a53:

    # NIJAH "... You looks zerrrr..."
    NIJAH "...你看起来..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:31
translate zh evscr_nijah_rescue_2_f8144a4e:

    # NIJAH "{i}Different?{/i}"
    NIJAH "{i}不太一样了？{/i}"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:32
translate zh evscr_nijah_rescue_2_cbb2fa12:

    # MC @ talk "Yeah, uh... it’s a long story."
    MC @ talk "呃，是啊...说来话长。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:33
translate zh evscr_nijah_rescue_2_3c1cb32d:

    # MC @ talk "Listen, we can’t stay here, okay?"
    MC @ talk "听着，我们不能留在这里，好吗？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:34
translate zh evscr_nijah_rescue_2_36980459:

    # MC @ talk "Come with me."
    MC @ talk "跟我来。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:35
translate zh evscr_nijah_rescue_2_d1b6f294:

    # "Holding out my hand once again, Nijah reached out to gently take it, still slightly shaking in fear."
    "我再次伸出手，妮雅轻轻握住，身体仍因恐惧微微颤抖。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:36
translate zh evscr_nijah_rescue_2_2c647830:

    # "By hand, I led her out of the alleys and towards the main streets once again, away from what had just happened."
    "我牵着她的手走出小巷回到主街，远离方才的惊魂时刻。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:37
translate zh evscr_nijah_rescue_2_97e6c1f8:

    # NIJAH "Where are zu taking me?"
    NIJAH "你要带我去哪里？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:38
translate zh evscr_nijah_rescue_2_e6f22d0d:

    # MC @ talk "Somewhere safe we can talk..."
    MC @ talk "找个安全的地方说话..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:41
translate zh evscr_nijah_rescue_2_da170cde:

    # "The beautiful dark tanned beauty looked up to me, eyes bright as her lip quivered."
    "这位美丽的深肤色女子仰望着我，眼眸明亮，嘴唇微微发颤。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:43
translate zh evscr_nijah_rescue_2_acf9b5aa:

    # UNKNOWN "I... I am Nijah."
    UNKNOWN "我...我叫妮雅。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:44
translate zh evscr_nijah_rescue_2_fcd69050:

    # "Looking around to see the prying eyes watching from the windows, I knew it could quickly become dangerous here if we didn't leave soon."
    "环顾四周从窗口窥视的眼睛，我知道若不尽快离开，此地随时可能变得危险。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:45
translate zh evscr_nijah_rescue_2_bf2088f4:

    # MC @ talk "Well Nijah, I don't think it's safe to stay here."
    MC @ talk "妮雅，我觉得留在这里不安全。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:46
translate zh evscr_nijah_rescue_2_e3c99b27:

    # MC @ talk "You should come with me."
    MC @ talk "你该跟我走。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:47
translate zh evscr_nijah_rescue_2_d1b6f294_1:

    # "Holding out my hand once again, Nijah reached out to gently take it, still slightly shaking in fear."
    "我再次伸出手，妮雅轻轻握住，身体仍因恐惧微微颤抖。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:48
translate zh evscr_nijah_rescue_2_2c647830_1:

    # "By hand, I led her out of the alleys and towards the main streets once again, away from what had just happened."
    "我牵着她的手走出小巷回到主街，远离方才的惊魂时刻。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:50
translate zh evscr_nijah_rescue_2_97e6c1f8_1:

    # NIJAH "Where are zu taking me?"
    NIJAH "你要带我去哪里？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_2.rpy:51
translate zh evscr_nijah_rescue_2_7ef8cfa8:

    # MC @ talk "Somewhere safe, away from here..."
    MC @ talk "安全的地方，远离此地..."
