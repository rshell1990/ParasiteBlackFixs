    MC @ talk "当然没有！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:52
translate zh evscr_nijah_rescue_3_8b7025b9:

    # BLACK "{b}YET.{/b}"
    BLACK "{b}暂时没有。{/b}"

