    # REGINA @ talk "Well... Aren’t you going to introduce me to this {i}'friend?'{/i}"
    REGINA @ talk "那么...不给我介绍下这位{i}'朋友'？{/i}"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:15
translate zh evscr_nijah_rescue_3_a7c1a9f3:

