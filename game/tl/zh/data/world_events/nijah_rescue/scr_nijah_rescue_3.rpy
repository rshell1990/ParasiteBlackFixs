translate zh evscr_nijah_rescue_3_d67fc98f:

    # REGINA @ talk "{i}*Sigh*{/i} Please tell me you aren’t in love with her..."
    REGINA @ talk "{i}*叹气*{/i} 求你别告诉我你爱上她了..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:49
translate zh evscr_nijah_rescue_3_a021a920:

    # MC @ talk "What? No..."
    MC @ talk "什么？不..."

