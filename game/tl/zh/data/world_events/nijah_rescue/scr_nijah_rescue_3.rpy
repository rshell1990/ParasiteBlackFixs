translate zh evscr_nijah_rescue_3_f9032156:

    # MC @ talk "I told you! I just saved her back there!"
    MC @ talk "我说了！我刚刚救了她！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:54
translate zh evscr_nijah_rescue_3_23b6fc4c:

    # REGINA @ talk "Good, because she can’t stay here."
    REGINA @ talk "很好，因为她不能留在这里。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:55
translate zh evscr_nijah_rescue_3_3ce837b8:

