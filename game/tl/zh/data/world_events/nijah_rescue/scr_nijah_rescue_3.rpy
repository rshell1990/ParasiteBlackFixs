# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:41
translate zh evscr_nijah_rescue_3_b77d275d:

    # REGINA @ talk "What in the seven hells do you think you're doing?!"
    REGINA @ talk "你他妈到底在干什么？！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:42
translate zh evscr_nijah_rescue_3_d83a1db9:

    # MC @ talk "It’s not what you think!"
    MC @ talk "不是你想的那样！"

