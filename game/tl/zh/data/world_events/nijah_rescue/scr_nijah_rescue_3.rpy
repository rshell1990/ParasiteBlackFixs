translate zh evscr_nijah_rescue_3_ecf833b4:

    # REGINA @ talk "...So instead of just going to the guards, you thought to bring her {i}here?{/i}"
    REGINA @ talk "...所以你不找卫兵，反倒把她带{i}到这儿？{/i}"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:21
translate zh evscr_nijah_rescue_3_3ec77cbf:

    # MC @ talk "Well I didn't know where else to take her!"
    MC @ talk "我不知道还能带她去哪儿！"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:22
translate zh evscr_nijah_rescue_3_26be51c2:

    # REGINA @ talk "{i}*Sigh*{/i} Well, does she have a name?"
    REGINA @ talk "{i}*叹气*{/i} 好吧，她有名字吗？"

