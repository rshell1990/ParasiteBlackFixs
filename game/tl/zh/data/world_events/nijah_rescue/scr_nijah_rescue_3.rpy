    "蕾吉娜恼火地揉着眉心。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_3.rpy:60
translate zh evscr_nijah_rescue_3_e88e6824:

    # REGINA @ talk "She can stay the night but... that’s the best I can do, I’m sorry, dear."
