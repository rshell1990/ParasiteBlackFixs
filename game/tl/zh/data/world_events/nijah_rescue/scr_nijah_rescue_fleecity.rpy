

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:2
translate zh evscr_nijah_rescue_fleecity_1bd3e812:

    # MC @ talk "I think you should flee the city."
    MC @ talk "我觉得你应该逃离这座城市。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:3
translate zh evscr_nijah_rescue_fleecity_c68400fe:

    # NIJAH "You mean... Leave?"
    NIJAH "你是说...离开？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:4
translate zh evscr_nijah_rescue_fleecity_05dbc256:

    # MC @ talk "Yes, get out of here before these thugs get to you one way or another."
    MC @ talk "是的，趁那些暴徒还没找上你之前离开这里。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:5
translate zh evscr_nijah_rescue_fleecity_bfa35e45:

    # NIJAH "But I will need gold..."
    NIJAH "但我需要金币..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:6
translate zh evscr_nijah_rescue_fleecity_555f5491:

    # MC @ talk "I'll help you with that."
    MC @ talk "这个我来帮你解决。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:7
translate zh evscr_nijah_rescue_fleecity_204559f8:

    # MC "(500 gold should suffice for her to leave safely)"
    MC "(500金币应该足够她安全离开了)"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:10
translate zh evscr_nijah_rescue_fleecity_b178399b:

    # NIJAH "I-I shall wait here."
    NIJAH "我-我就在这里等着。"


# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:17
translate zh evscr_nijah_rescue_fleecity_f1d5be5f:

    # NIJAH "But where... Where will I go?"
    NIJAH "可是...我该去哪里？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:18
translate zh evscr_nijah_rescue_fleecity_8e8c2e72:

    # MC @ talk "I don’t know Nijah, head towards one of the villages but stay in the North."
    MC @ talk "我不知道，妮雅。往北方的村落去吧，但别离开北部地区。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:20
translate zh evscr_nijah_rescue_fleecity_51554d47:

    # "Dejected and defeated, Nijah leaned forward to hug me."
    "妮雅沮丧而颓然地倾身拥抱了我。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:21
translate zh evscr_nijah_rescue_fleecity_1711c02d:

    # NIJAH "Thank zu for saving me... {i}friend.{/i}"
    NIJAH "谢谢你救了我...{i}朋友{/i}。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:22
translate zh evscr_nijah_rescue_fleecity_bf703b93:

    # NIJAH "I will pay zu back one day... If I can."
    NIJAH "总有一天我会报答你的...如果我能做到的话。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:23
translate zh evscr_nijah_rescue_fleecity_35fc147e:

    # MC @ talk "... Take some food and gold with you at least."
    MC @ talk "...至少带上些食物和金币吧。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:24
translate zh evscr_nijah_rescue_fleecity_1fd87699:

    # "As tears began to swell in her eyes, Nijah added pitifully:"
    "泪水开始在妮雅眼中打转，她凄然补充道："

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:26
translate zh evscr_nijah_rescue_fleecity_30593b01:

    # NIJAH "You are the only Alderian to treat with kindness..."
    NIJAH "你是唯一善待我的奥尔德人..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:31
translate zh evscr_nijah_rescue_fleecity_48f5640a:

    # "Placing the handful of gold I gave her in a small pouch with some food, Nijah tearfully waved as she headed off towards the city gate..."
    "妮雅将我给她的金币和食物收进小布袋，含泪挥手走向城门..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:32
translate zh evscr_nijah_rescue_fleecity_a1698216:

    # "No one would stop a refugee from wanting to leave."
    "没人会阻拦想要离开的难民。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:33
translate zh evscr_nijah_rescue_fleecity_a1b4912b:

    # "No one would enquire or care."
    "没人会过问或在意。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:34
translate zh evscr_nijah_rescue_fleecity_e8d5fbd0:

    # "I wondered if I’d made the right choice, but in the end... it was perhaps the most sensible."
    "我怀疑自己是否做了正确选择，但最终...这或许是最明智的决定。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:35
translate zh evscr_nijah_rescue_fleecity_79d87d53:

    # "Maybe one day she’ll find a better life."
    "也许终有一天她会找到更好的生活。"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:36
translate zh evscr_nijah_rescue_fleecity_e141c216:

    # "Maybe one day we’ll cross paths again..."
    "也许终有一天我们会重逢..."

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:43
translate zh evscr_nijah_rescue_fleecity_c79bcb5f:

    # NIJAH "H-Huh?"
    NIJAH "呃-呃？"

# game/data/world_events/nijah_rescue/scr_nijah_rescue_fleecity.rpy:44
translate zh evscr_nijah_rescue_fleecity_e8d0a824:

    # NIJAH "Then what are you going to do?"
    NIJAH "那你打算怎么办？"

