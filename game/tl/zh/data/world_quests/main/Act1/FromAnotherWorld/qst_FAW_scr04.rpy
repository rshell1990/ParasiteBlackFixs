# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:107
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_10213d19:

    # "Clamping my eyes shut, I tried to reach deep into myself, thinking about changing into... whatever I was supposed to be changing into."
    "我紧闭双眼，试图深入自己的内心，想着要变成...无论我应该变成什么东西。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:108
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_3339eefd:

    # "As the moments passed, I was growing ever more hopeless, convinced that whatever I was trying to reach was impossible without an understanding of what it actually was. "
    "时间一分一秒过去，我越来越绝望，确信如果没有真正理解它是什么，我所尝试触及的东西都是不可能的。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:109
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_f3ded08f:

    # MC @ talk "It’s not work—"
    MC @ talk "这行不——"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:110
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_83be9d34:

    # "All of a sudden, I felt a strange pain surge through my body."
    "突然，我感到一阵奇怪的剧痛涌遍全身。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:112
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_57a9c601:

    # "马库斯 suddenly bent double, clutching at his stomach as he gasped for air."
    "马库斯突然弯下腰，捂着肚子，大口喘着气。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:114
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_7e498c11:

    # MC @ talk "马库斯... I can feel—"
    MC @ talk "马库斯...我感觉——"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:117
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_06af2d05:

    # "A sharp pain coursed through me and I screamed like a man possessed."
    "一阵剧痛贯穿了我，我像个被附身的人一样尖叫起来。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:118
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_909046ac:

    # "I felt my bones shatter in quick succession and then form again, the broken pieces growing, becoming larger, stronger."
    "我感到我的骨头接连碎裂，然后又重新成形，破碎的碎片生长着，变得更大、更强壮。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:119
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_235205d7:

    # "The pain forced me to my knees, and I let out a roar of agony as I felt my spine elongating before the pain travelled to my head and my mind cracked."
    "剧痛迫使我跪倒在地，当感觉到脊柱在拉长时，我发出一声痛苦的咆哮，随后疼痛蔓延到头部，我的意识崩溃了。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:120
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_0d94ada9:

    # "Fragments of my thoughts were being melded with the symbiote; I could feel its long fingers on the inside of my skull as it picked through my mind."
    "我思维的碎片正在与共生体融合；我能感觉到它那长长的手指在我头骨内部，翻检着我的思想。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:121
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_fdf206a5:

    # "My whole body burned as I felt it mould and shape itself to me, creating a monstrous new form."
    "我感到它在塑造自身以适应我，创造出一个骇人的新形态，我的整个身体都在燃烧。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:122
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_a01885fa:

    # "Somewhere on the edge of my vision I could see 马库斯 lying on the floor, his head in his hands, screaming."
    "在我视野边缘的某处，我看到马库斯躺在地上，双手抱头，尖叫着。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:123
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_85ca6baf:

    # "Any hopes of it being a painless transformation were thwarted as the agonising ordeal continued."
    "当这痛苦的折磨持续时，任何关于它是无痛变身的希望都破灭了。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:124
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_9f8d681b:

    # "Finally, as I felt strange snake like creatures force their way out of my back, I stood upright to stare at 马库斯... or at least... what I {i}knew{/i} was 马库斯."
    "终于，当我感到像蛇一样的奇怪生物从我后背强行钻出时，我站直身体，凝视着马库斯...或者至少...我{i}知道{/i}那是马库斯。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:131
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_4fdfcee7:

    # "His voice was distorted, {i}inhuman{/i}."
    "他的声音扭曲了，{i}非人{/i}的。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:132
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_2a306dbb:

    # "I gawped down at my clawed hands and then towards the slither of one of my tentacles as it slid over my shoulder and turned to look at me inquisitively before retreating."
    "我目瞪口呆地看着自己带爪的手，然后看着一根触须滑过我的肩膀，它好奇地转向我看了看，然后缩了回去。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:133
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_0cfb0550:

    # "Curiously, 马库斯 did not possess any of the strange tentacles that protruded from my back, but instead, large white wings that kicked up the hot sand as they beat ferociously behind him."
    "奇怪的是，马库斯没有像我背上那样伸出奇怪的触须，取而代之的是巨大的白色翅膀，在他身后猛烈拍打时扬起了滚烫的沙子。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:134
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_747d7458:

    # MC "How do you feel?"
    MC "你感觉怎么样？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:135
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_2b15eed7:

    # "It seemed both of our voices had changed to be more guttural, but they were clear enough to understand."
    "似乎我们俩的声音都变得更加低沉沙哑了，但还足够清晰可辨。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:136
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_209f5300:

    # BLACK "It will be less painful the next time..."
    BLACK "下次就不会这么痛了..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:137
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_8efe98d9:

    # WHITE "Quicker as well..."
    WHITE "也会更快..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:138
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_d4859430:

    # "Examining ourselves thoroughly, 马库斯 began to laugh."
    "仔细检查完彼此后，马库斯笑了起来。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:139
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_28b878b7:

    # MARKUS "Incredible!"
    MARKUS "太不可思议了！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:141
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_d4e32c2f:

    # MARKUS "Can you feel it? It’s like fire in my veins!"
    MARKUS "你能感觉到吗？就像火焰在我的血管里流淌！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:142
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_1dfde4e8:

    # MC "I feel... {i}strong,{/i}"
    MC "我感觉...{i}很强壮，{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:143
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_4b04075e:

    # MARKUS "I wonder..."
    MARKUS "我在想..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:145
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_3d171ada:

    # "马库斯 sprinted forward, launching himself into the air as his wings lifted him off the ground."
    "马库斯向前冲刺，翅膀将他带离地面，跃入空中。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:146
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_a1321702:

    # "With an elated cry of joy, he called to me to keep up with him."
    "他发出一声欣喜若狂的呼喊，叫我跟上他。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:149
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_0c33d2bc:

    # "Chasing him like some great bird in the sky, I found instinctively that sprinting after him on all fours meant that I could achieve speeds faster than any human could ever hope to."
    "我像追逐天空中的巨鸟一样追着他，本能地发现用四肢奔跑意味着我能达到任何人类都望尘莫及的速度。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:151
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_71005e1e:

    # "Suddenly, my tentacles slammed into the ground, throwing me along in steady motions as we crossed huge swathes of land in no time."
    "突然，我的触须猛击地面，以稳定的动作将我向前推进，我们瞬间穿越了大片土地。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:152
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_42c07e27:

    # "Finally, I caught up to 马库斯 and the two of us settled down to catch our breath."
    "终于，我追上了马库斯，我们俩停下来喘口气。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:157
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_662e09b6:

    # MARKUS "Ha... Not bad!"
    MARKUS "哈...不错嘛！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:158
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_c6a9a4fd:

    # MC "马库斯, do you know what this means?"
    MC "马库斯，你知道这意味着什么吗？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:159
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_4e743bf4:

    # MC "This changes everything! We can turn the tides of the war with these things!"
    MC "这改变了一切！有了这些东西，我们就能扭转战争的局势！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:160
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_328c3275:

    # MARKUS "... Heh... Let’s not get too ahead of ourselves."
    MARKUS "...呵...别得意忘形了。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:161
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_d663e663:

    # MARKUS "How about we just focus on {i}our{/i} plan."
    MARKUS "我们还是专注于{i}我们{/i}的计划吧。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:162
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_d3aa162c:

    # MARKUS "Let’s save ourselves first before we think about saving the kingd—"
    MARKUS "在考虑拯救王国之前，先想想怎么救我们自己——"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:163
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_5f9e5b68:

    # "Suddenly, we both heard the sound of a battle cry and blades loudly clashing."
    "突然，我们俩都听到了一声战吼和刀刃猛烈撞击的声音。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:164
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_30e8207c:

    # MC "... Could it be Scouts?"
    MC "...会是侦察兵吗？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:165
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_dcca44f6:

    # MARKUS "We’d have spotted them if it was."
    MARKUS "如果是的话我们早就发现他们了。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:166
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_ddc1f1da:

    # MC "Come on! Let’s take a look!"
    MC "来吧！去看看！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:168
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_1869deac:

    # MC "As we made our way towards the erratic sounds, we came across a group of Demorai ferociously attacking an..."
    MC "当我们循着杂乱的声音走去时，遇到了一群德莫莱正在凶猛地攻击一个..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:172
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_c91cc98c:

    # MC "{i}Orc?{/i}"
    MC "{i}兽人？{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:173
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_32603ed4:

    # MARKUS "What is an orc doing in Alderay?"
    MARKUS "一个兽人在奥尔德雷干什么？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:174
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_a88f4b0f:

    # "As one of the beasts lunged at her, she swung her axes with ferocious speed, slamming the blade through its skull as it reached out to grab her."
    "当其中一头野兽扑向她时，她以凶猛的速度挥动双斧，在它伸手抓她的瞬间，将斧刃劈进了它的头颅。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:175
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_b99f8061:

    # "She spun on her heels, deflecting a blow from the other before slicing through its neck and severing its head in one quick, clean cut."
    "她转身躲开另一头的攻击，然后干净利落地一刀切断了它的脖子，砍下了它的脑袋。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:176
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_7713ce0a:

    # "As she pulled her blade from the skull of the first, more Demorai descended, incensed by the bloodshed."
    "当她从第一头野兽的头骨中拔出斧刃时，更多的德莫莱被血腥味激怒，蜂拥而至。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:177
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_9d459c1c:

    # MARKUS "What should we do?"
    MARKUS "我们该怎么办？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:185
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_6d560f29:

    # "Me and 马库斯 hastily departed the scene, listening as we heard the clashing of blades followed by screams... {i}And then the most awful silence.{/i}"
    "我和马库斯匆忙离开了现场，听着刀剑碰撞声，接着是尖叫声...{i}然后是死一般的寂静。{/i}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:192
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_7a5f7610:

    # "Making our way back to Novaras, we've barely exchanged looks, let alone words."
    "返回诺瓦拉斯的路上，我们几乎没有任何眼神交流，更别说交谈了。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:193
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_c2fbf28b:

    # "Our minds racing with questions, we found ourselves in front of the city's massive walls again."
    "我们脑中充斥着疑问，不知不觉又回到了城市巨大的城墙前。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:200
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_0920d4d8:

    # MARKUS "These {i}things{/i} inside us..."
    MARKUS "我们体内的这些{i}东西{/i}..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:201
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_8e11f116:

    # MC "Yeah, I think we should~"
    MC "是啊，我也觉得我们应该~"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:202
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_59c7b32a:

    # MARKUS "I'll take a walk. Alone."
    MARKUS "我去散散步。一个人。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:203
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_88a37e3c:

    # MARKUS "Join me later in the tavern, we'll talk."
    MARKUS "晚点酒馆见，我们再谈。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:205
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_69f8dfa8:

    # "There I stood, my new inner companion keenly observing every thought drifting across my mind."
    "我站在那里，新的内在伙伴敏锐地观察着我脑海中掠过的每一个念头。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:206
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_916656da:

    # "As I watched 马库斯 walking towards the city gates, I couldn't help but wonder..."
    "看着马库斯走向城门，我不禁想知道..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:207
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_630c2e0c:

    # MC "...What do we do now?"
    MC "...我们现在该做什么？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:208
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_9a8a330c:

    # MC "What do {i}I{/i} do now?"
    MC "{i}我{/i}现在该做什么？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:214
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_80ff883a:

    # MARKUS "But it’s an orc!"
    MARKUS "可那是个兽人！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:215
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_26079539:

    # MC "It doesn’t matter! They’re going to rip her apart!"
    MC "那不重要！它们会把她撕碎的！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:216
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_3fea1c49:

    # MARKUS "Aaargh! Fine!"
    MARKUS "啊啊啊啊！行行行！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:217
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_01b98172:

    # MC "HEY! OVER HERE!"
    MC "嘿！这边！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:218
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_2f323b10:

    # MC "As the orc spun around to look our way, the Demorai were momentarily distracted as we came hurtling towards them."
    MC "当兽人转身看向我们时，德莫莱人因我们猛冲过去而分心了片刻。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:225
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_b4651d8d:

    # MC "For a moment, the orc drew her weapons against us, expecting us to attack her before we launched ourselves backwards and began to slash at the Demorai."
    MC "有那么一瞬间，兽人举起武器对准我们，以为我们要攻击她，结果我们却向后跃起，转而劈向德莫莱人。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:226
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_ca17ee27:

    # VES @ angry "What the hell are {b}you?!{/b}"
    VES @ angry "你们{b}到底是?!{/b}"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:227
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_307e2408:

    # MARKUS "Lady, questions later!"
    MARKUS "女士，问题待会儿再说！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:228
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_883b7548:

    # MARKUS "FIGHTING NOW!"
    MARKUS "先打架！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:240
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_baeed6be:

    # MC @ talk "{i}*Huff*{/i} Are you—"
    MC @ talk "{i}*喘气*{/i} 你没事——"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:247
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_33b06d92:

    # "The orc drew her bloodied axes in our direction."
    "兽人将染血的斧头指向我们。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:248
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_26f15437:

    # VES @ angry "What are you?"
    VES @ angry "你们是什么东西？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:249
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_840dcc09:

    # VES @ angry "Some kinds of... demons?"
    VES @ angry "某种...恶魔？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:257
# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:258
# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:259
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_3ada0a82:

    # VES @ angry "Don’t look like no humans I ever saw."
    VES @ angry "我可没见过长你们这样的人类。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:263
# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:268
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_0f306027:

    # "The orc began to relax as she smirked at us both."
    "兽人看着我们两个，露出一丝坏笑，身体放松下来。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:269
