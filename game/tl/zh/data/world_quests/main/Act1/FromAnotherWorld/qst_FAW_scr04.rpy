

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:8
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_da215666:

    # "马库斯 stood just outside the house, tense, eager to take off."
    "马库斯站在屋外，神情紧绷，急不可待地想要出发。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:9
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_1a7284ee:

    # MC "So 马库斯... What now?"
    MC "那么马库斯...现在怎么办？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:10
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_14c45b53:

    # MC "We are so fucked."
    MC "我们完蛋了。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:11
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_9db36875:

    # MC "Those things... If what they’re saying is true..."
    MC "那些东西...如果他们说的是真的..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:12
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_f45c2726:

    # MARKUS "Let's go now."
    MARKUS "我们现在就走。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:13
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_57421384:

    # MC "Yeah, I doubt the Guild will be as scary as the Scouts..."
    MC "是啊，我觉得公会应该不会像侦察兵那么吓人..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:14
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_57f6ae64:

    # MARKUS "We're not going to the guild. Not yet."
    MARKUS "我们不去公会。现在不去。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:15
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_e1a9bffd:

    # MC @ talk "Huh?"
    MC @ talk "哈？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:16
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_95b51cb1:

    # MARKUS "Come now, we’re heading into {i}the Valley of Death{/i}."
    MARKUS "来吧，我们要去{i}死亡谷{/i}。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:17
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_1c1920d2:

    # MC @ talk "What?!"
    MC @ talk "什么？！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:18
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_5728f581:

    # MARKUS "It's going to be alright."
    MARKUS "会没事的。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:19
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_b1f50d7d:

    # MARKUS "We just need to get out of sight to practice changing into..."
    MARKUS "我们只需要找个没人的地方练习变身成..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:20
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_e3011a99:

    # MARKUS "{i}Whatever{/i} it is we’re going to change into."
    MARKUS "{i}无论{/i}我们要变成什么东西。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:21
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_e9e72c1d:

    # MC @ talk "马库斯?!"
    MC @ talk "马库斯？！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:29
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_c5ba082c:

    # MC @ talk "马库斯? Hold up!"
    MC @ talk "马库斯？等等！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:30
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_db826fed:

    # MARKUS "I’ve thought about what they said..."
    MARKUS "我仔细想了想他们说的话..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:32
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_19c7f03a:

    # "马库斯 looked around, making sure no one listens in:"
    "马库斯环顾四周，确保没人偷听："

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:33
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_0014df9f:

    # MARKUS "If what they say is true, perhaps this could be the key to having the life we’ve always wanted."
    MARKUS "如果他们说属实，也许这正是我们获得梦寐以求生活的关键。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:34
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_6dfc9096:

    # MC @ talk "By being cursed?"
    MC @ talk "通过被诅咒？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:35
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_f52b36e0:

    # MARKUS "It’s not a curse if we can manage it."
    MARKUS "如果我们能掌控它，这就不是诅咒。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:36
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_87e3f786:

    # MARKUS "Anyway, you heard them... they have already given us a lot of benefits."
    MARKUS "总之，你也听到了...他们已经给了我们很多好处。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:37
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_2374f272:

    # MARKUS "AND we owe those things our lives."
    MARKUS "而且我们欠那些东西一条命。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:38
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_c24ddfec:

    # MC @ talk "马库斯, we have no actual idea of what’s going on with us!"
    MC @ talk "马库斯，我们根本不清楚自己身上发生了什么！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:39
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_a83dacb2:

    # MARKUS "And we’re not ever going to know if we don’t at least try to understand them!"
    MARKUS "如果我们不至少尝试去理解它们，就永远也不会知道！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:40
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_1a988a98:

    # MARKUS "We have to give them a chance."
    MARKUS "我们必须给它们一个机会。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:41
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_32d97cab:

    # MARKUS "If what those {i}things{/i} told us is true, this is the only way."
    MARKUS "如果那些{i}东西{/i}告诉我们的是真的，这就是唯一的办法。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:49
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_f86ed6dc:

    # "As we passed through the city gate, I felt all kinds of distressing thoughts popping in and out of existence."
    "当我们穿过城门时，我感到各种令人不安的念头不断涌现又消失。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:51
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_83b48436:

    # MC "(What are we doing? Will whatever 马库斯 has in mind work? What exactly is going to happen to us now? Is there a 'cure' or something?)"
    MC "(我们在做什么？马库斯的想法能行吗？我们现在到底会怎样？有'解药'之类的东西吗？)"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:53
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_f7d13ea9:

    # "Confident, 马库斯 simply began making his way towards the expanse of the desert."
    "马库斯信心十足，径直朝着广阔的沙漠走去。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:55
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_6cc0ac7f:

    # MC "Snapping out of it, I followed 马库斯."
    MC "我回过神来，跟上了马库斯。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:64
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_4a46d39e:

    # MC @ talk "... I still don’t like this."
    MC @ talk "...我还是不喜欢这样。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:65
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_51fb4329:

    # MC @ talk "How will we explain to anyone what we were doing beyond the walls?"
    MC @ talk "我们该怎么向别人解释我们在墙外做了什么？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:66
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_832fb5ad:

    # MARKUS "Easy, we’re part of the Adventurer’s Guild now, remember? Just say we were patrolling for enemies or whatever..."
    MARKUS "简单，我们现在是冒险者公会的人了，记得吗？就说我们在巡逻找敌人什么的..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:67
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_be0c9c6e:

    # MARKUS "Come on, as long as we’re out of view of the wall it should be safe enough for us."
    MARKUS "来吧，只要离开城墙的视线范围，对我们来说应该就足够安全了。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:68
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_78360619:

    # MC @ talk "As long as we don’t get clawed or bitten or disembowelled by some passing Demorai..."
    MC @ talk "只要别被路过的德莫莱抓伤、咬伤或开膛破肚就行..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:69
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_c0c49e59:

    # "Trekking towards the great dunes of the valley, we finally arrived at a spot safely away from the gaze of any watchers on the walls."
    "我们跋涉向山谷的巨大沙丘，终于抵达了一个安全避开城墙上任何瞭望者视线的地方。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:70
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_fa07fe14:

    # MARKUS "Okay... This should do."
    MARKUS "好了...这里应该可以。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:71
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_2b9f8100:

    # MC @ talk "...Well, what now?"
    MC @ talk "...那么，现在呢？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:72
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_3e4c2a46:

    # MARKUS "I guess, we just change..."
    MARKUS "我想，我们就变身..."

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:73
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_ebf63fbe:

    # MC @ talk "...How do we do it exactly?"
    MC @ talk "...具体该怎么做？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:74
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_b55c30a7:

    # MARKUS "They said we needed to focus, like it was some extra limb that we just needed to think about using."
    MARKUS "他们说我们需要集中精神，就像它是我们只需想着去使用的额外肢体。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:75
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_ebdf1655:

    # MC @ talk "Easier said than done! "
    MC @ talk "说来容易做来难！"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:76
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_91821a33:

    # "Without warning, 马库斯 began to strip off his clothes."
    "毫无预兆地，马库斯开始脱衣服。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:77
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_4239b98e:

    # MC @ talk "...What are you doing?"
    MC @ talk "...你在干什么？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:78
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_b16baa77:

    # MARKUS "Whatever we change into is likely to tear through our clothes, right?"
    MARKUS "无论我们变成什么样子，都很可能把衣服撕破，对吧？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:79
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_5118a23d:

    # MARKUS "I don’t particularly want to have to walk through Novaras naked when we return."
    MARKUS "我特别不想在回去时赤身裸体地走过诺瓦拉斯。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:80
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_0033c658:

    # MC @ talk "...You sure you’re into girls?"
    MC @ talk "...你确定你喜欢的是女孩？"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:81
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_f1f40c61:

    # MC @ talk "Because this might be the clumsiest come on ever."
    MC @ talk "因为这可能是史上最笨拙的搭讪了。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:82
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_b76c5147:

    # "马库斯 shot me a look of ‘shut up and just do it’, clearly taking this too seriously to acknowledge the ridiculousness of the situation."
    "马库斯瞪了我一眼，意思是‘闭嘴照做’，显然他太认真了，顾不上承认这情况的荒谬性。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:83
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_16cfcfe4:

    # "I sighed and begrudgingly began to strip."
    "我叹了口气，不情愿地开始脱衣服。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:84
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_0845cb17:

    # MARKUS "We’ll keep the clothes by this rock for when we return."
    MARKUS "我们把衣服放在这块石头旁边，回来时穿。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:85
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_864ca015:

    # MARKUS "Should be easy to find with that dead hooked tree over there nearby."
    MARKUS "有那边那棵枯死的弯树在旁边，应该很容易找到。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:88
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_3ae1d182:

    # MC @ talk "If you say so."
    MC @ talk "既然你这么说。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:91
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_f817b1cf:

    # "Now stark naked, I looked to 马库斯 awaiting his next suggestion."
    "现在一丝不挂，我看向马库斯，等待他的下一步建议。"

# game/data/world_quests/main/Act1/FromAnotherWorld/qst_FAW_scr04.rpy:92
translate zh qst_FromAnotherWorld_GoToValleyWithMarkus_53b5a59f:

    # MARKUS "Okay... Let’s just try and think."
