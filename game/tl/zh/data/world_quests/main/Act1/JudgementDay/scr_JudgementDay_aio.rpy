# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2614
translate zh qst_JudgementDay_TrialStart_4fc678a8:

    # "Not Inquisitor Henvak, as expected."
    "并非预想的亨瓦克审判官。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2615
translate zh qst_JudgementDay_TrialStart_af94376b:

    # "But an older woman. Head Inquisitor Marion."
    "而是一位年长女性。首席审判官玛丽安。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2617
translate zh qst_JudgementDay_TrialStart_e682a58d:

    # "Uneasy murmurs rose across the court."
    "不安的低语在法庭蔓延。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2618
translate zh qst_JudgementDay_TrialStart_32fb436b:

    # "Even Judge Falwind stiffened at the sight of her."
    "连法尔温法官见到她也瞬间僵硬。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2619
translate zh qst_JudgementDay_TrialStart_6ebe2672:

    # JUDGE_FALWIND "H-Head Inquisitor!"
    JUDGE_FALWIND "首-首席审判官！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2620
translate zh qst_JudgementDay_TrialStart_8d9108b7:

    # MARION "I trust I am not late."
    MARION "希望我没有迟到。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2622
translate zh qst_JudgementDay_TrialStart_f9ebf287:

    # JUDGE_FALWIND "E-Er, no, Inquisitor. But… on the paperwork, it states that Inquisitor Henvak was to handle the prosecution."
    JUDGE_FALWIND "呃-呃，没有，审判官。但文件注明应由亨瓦克审判官负责检方。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2623
translate zh qst_JudgementDay_TrialStart_90e8994d:

    # MARION "Henvak is indisposed."
    MARION "亨瓦克不便出席。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2624
translate zh qst_JudgementDay_TrialStart_b657aaee:

    # MARION "Given the attention this trial has drawn, I have decided to intercede."
    MARION "鉴于本案受关注程度，我决定亲自介入。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2625
translate zh qst_JudgementDay_TrialStart_a4e6991c:

    # JUDGE_FALWIND "I… see. But Head Inquisitor, this is most unorthodox. Have you had adequate time to prepare?"
    JUDGE_FALWIND "我...明白。但首席审判官，这不合常规。您有充足时间准备吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2626
translate zh qst_JudgementDay_TrialStart_30dfe46f:

    # MARION "I have, your honor."
    MARION "准备充分，法官大人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2627
translate zh qst_JudgementDay_TrialStart_273760c0:

    # "The judge clearly did not like this."
    "法官显然不悦。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2628
translate zh qst_JudgementDay_TrialStart_3c7efe4d:

    # "But denying Marion's authority was… unwise."
    "但否认玛丽安的权威...实属不智。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2629
translate zh qst_JudgementDay_TrialStart_ce31a9d3:

    # JUDGE_FALWIND "Very well."
    JUDGE_FALWIND "好吧。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2630
translate zh qst_JudgementDay_TrialStart_982fa314:

    # JUDGE_FALWIND "With all parties present, would the prosecution like to make its opening statement?"
    JUDGE_FALWIND "各方均已就位，检方是否进行开场陈词？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2631
translate zh qst_JudgementDay_TrialStart_2eb85663:

    # MARION "I would, your honor."
    MARION "是的，法官大人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2632
translate zh qst_JudgementDay_TrialStart_f15830e3:

    # "The Head Inquisitor stepped forward."
    "首席审判官迈步上前。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2633
translate zh qst_JudgementDay_TrialStart_14740c7f:

    # "Her voice cut through the chamber, sharp and commanding."
    "她锐利而威严的声音穿透大厅。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2634
translate zh qst_JudgementDay_TrialStart_a1d051f8:

    # MARION "Today, the prosecution will prove—beyond doubt—that this creature is the result of dark magecraft!"
    MARION "今日，检方将无可辩驳地证明——此造物乃黑暗法术的产物！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2635
translate zh qst_JudgementDay_TrialStart_7b0f4d51:

    # MARION "That it has been consorting with the Demorai."
    MARION "其与迪莫莱族勾结！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2636
translate zh qst_JudgementDay_TrialStart_90e0a29b:

    # MARION "That it is at the very heart of a conspiracy to corrupt this city's highest officials!"
    MARION "更是腐化本城最高官员阴谋的核心！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2638
translate zh qst_JudgementDay_TrialStart_8f14909a:

    # "The courtroom exploded in voices."
    "法庭哗然。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2639
translate zh qst_JudgementDay_TrialStart_1c998cdd:

    # "Gasps. Whispers. Outright accusations."
    "惊呼。私语。直白的指控。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2641
translate zh qst_JudgementDay_TrialStart_be7b5f6d_1:

    # "*BANG!*"
    "*砰！*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2642
translate zh qst_JudgementDay_TrialStart_be7b5f6d_2:

    # "*BANG!*"
    "*砰！*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2643
translate zh qst_JudgementDay_TrialStart_b7f53723:

    # JUDGE_FALWIND "ORDER! ORDER!"
    JUDGE_FALWIND "肃静！肃静！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2645
translate zh qst_JudgementDay_TrialStart_b42540ba:

    # "As silence returned, he exhaled deeply."
    "当寂静回归，他深深呼气。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2646
translate zh qst_JudgementDay_TrialStart_cb980af3:

    # JUDGE_FALWIND "Prosecutor Marion, these are serious accusations on an already charged case. Do you have evidence to support such claims?"
    JUDGE_FALWIND "玛丽安检察官，本案本已指控严重，你是否有证据支持此等论断？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2647
translate zh qst_JudgementDay_TrialStart_868965c1:

    # MARION "I do, your honor."
    MARION "我宣誓，法官大人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2648
translate zh qst_JudgementDay_TrialStart_76365bfb:

    # JUDGE_FALWIND "Then let us proceed."
    JUDGE_FALWIND "那么，我们继续。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2649
translate zh qst_JudgementDay_TrialStart_514b8f61:

    # "His gaze turned to me."
    "他的目光转向我。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2650
translate zh qst_JudgementDay_TrialStart_6114110e:

    # JUDGE_FALWIND "And you, nine-six-one—"
    JUDGE_FALWIND "而你，九六一——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2651
translate zh qst_JudgementDay_TrialStart_2d0862fc:

    # JUDGE_FALWIND "What is your opening statement?"
    JUDGE_FALWIND "你的开场陈述是什么？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2655
translate zh qst_JudgementDay_TrialStart_0f402d51:

    # MC @ angry "We are loyal subjects of Alderay! We fought and bled for this empire a thousand times!"
    MC @ angry "我们是奥尔德雷的忠诚子民！我们为这个帝国浴血奋战了千百次！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2656
translate zh qst_JudgementDay_TrialStart_6ea465c8:

    # MC @ angry "And we would do it a thousand times more!"
    MC @ angry "我们愿意再战千百次！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2658
translate zh qst_JudgementDay_TrialStart_b07c67fe:

    # "There was a murmur of approval among the jury."
    "陪审团中响起一阵赞同的低语。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2662
translate zh qst_JudgementDay_TrialStart_16cb8271:

    # "My voice was steady. Determined."
    "我的声音平稳而坚定。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2668
translate zh qst_JudgementDay_TrialStart_cb6d2bee:

    # "The jury turned against me. Angry whispers spread like wildfire."
    "陪审团转而反对我。愤怒的私语如野火般蔓延。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2669
translate zh qst_JudgementDay_TrialStart_a26d35f8:

    # "Marion smiled."
    "玛丽恩露出了微笑。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2671
translate zh qst_JudgementDay_TrialStart_be7b5f6d_3:

    # "*BANG!*"
    "*砰！*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2673
translate zh qst_JudgementDay_TrialStart_be7b5f6d_4:

    # "*BANG!*"
    "*砰！*"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2674
translate zh qst_JudgementDay_TrialStart_9a7d3f70:

    # JUDGE_FALWIND "ORDER! I will not tolerate outbursts in this court!"
    JUDGE_FALWIND "肃静！本法庭绝不容忍喧哗！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2675
translate zh qst_JudgementDay_TrialStart_cb7bd914:

    # "The judge sighed."
    "法官叹了口气。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2678
translate zh qst_JudgementDay_TrialStart_c9d2f94e:

    # JUDGE_FALWIND "Head Inquisitor Marion, present your first witness."
    JUDGE_FALWIND "首席审判官玛丽恩，传唤你的第一位证人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2679
translate zh qst_JudgementDay_TrialStart_74d2e78e:

    # MARION @ smile "Gladly, your honor."
    MARION @ smile "遵命，法官大人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2680
translate zh qst_JudgementDay_TrialStart_a1365872:

    # MARION @ talk "The prosecution calls…"
    MARION @ talk "检方传唤……"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2681
translate zh qst_JudgementDay_TrialStart_1591d5dc:

    # MARION @ talk "Captain 妮克斯 of the City Guard."
    MARION @ talk "城市卫队的妮克斯上尉。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2684
translate zh qst_JudgementDay_TrialStart_591b5abe:

    # "Quiet murmurs rose up as the doors swung open and Captain 妮克斯, stood proud, made her way silently to the stand, refusing to break her utterly neutral expression."
    "大门打开，妮克斯上尉昂首挺胸，表情坚决保持中立，默默走向证人席，人群中响起了低语。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2686
translate zh qst_JudgementDay_TrialStart_a62bf6d9:

    # MARION @ talk "Captain 妮克斯... Could you tell us more about your rank and what your duty entails?"
    MARION @ talk "妮克斯上尉……你能详细说明你的军衔和职责范围吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2687
translate zh qst_JudgementDay_TrialStart_b3dd3d77:

    # NYX @ talk "I am Captain of the city guard of Novaras, I am charged with keeping the city safe both internally and externally from threats, and maintaining peace within the city's walls."
    NYX @ talk "我是诺瓦拉斯城卫队上尉，职责是保护城市免受内外威胁，并维持城墙内的和平。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2688
translate zh qst_JudgementDay_TrialStart_1412d041:

    # MARION @ smile "I see..."
    MARION @ smile "我明白了……"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2689
translate zh qst_JudgementDay_TrialStart_a854db35:

    # MARION @ talk "And tell me, what are you direct resonsibilites when it pertains to inquisitor business?"
    MARION @ talk "那么告诉我，当涉及审判庭事务时，你的直接责任是什么？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2690
translate zh qst_JudgementDay_TrialStart_f114f57d:

    # NYX @ angry "... To report anything suspect of Dark magecraft to the inquisition at once, or anything related to a Demorai pressence in the city."
    NYX @ angry "... 立即向审判庭报告任何疑似黑暗法术的事件，或与德莫莱在城中活动相关的任何情况。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2691
translate zh qst_JudgementDay_TrialStart_71cf5aa5:

    # MARION @ smile "Interesting..."
    MARION @ smile "有意思……"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2692
translate zh qst_JudgementDay_TrialStart_6879d8fd:

    # MARION @ talk "So, tell me."
    MARION @ talk "那么，告诉我。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2693
translate zh qst_JudgementDay_TrialStart_3a4ddeeb:

    # MARION @ talk "Are these your signatures on these reports?"
    MARION @ talk "这些报告上的签名是你的吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2694
translate zh qst_JudgementDay_TrialStart_105627b8:

    # "In her hands, the head inquisitor waved about a series of papers before throwing them down in front of 妮克斯, who uncomfortably inspected them."
    "首席审判官手中挥舞着一叠文件，然后将它们摔在妮克斯面前，后者不安地检查着。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2695
translate zh qst_JudgementDay_TrialStart_a03c590d:

    # NYX @ angry "Yes... This is my signature."
    NYX @ angry "是的……这是我的签名。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2696
translate zh qst_JudgementDay_TrialStart_c33784e9:

    # MARION @ angry "Why then, did you choose to send false reports when asked to investigate prisoners nine-six-one and eight-four-one?"
    MARION @ angry "那么，为什么在要求你调查囚犯九六一和八四一时，你却选择发送虚假报告？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2697
translate zh qst_JudgementDay_TrialStart_3ad74a5b:

    # "There was a heavy, long pause."
    "一阵沉重而漫长的停顿。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2698
translate zh qst_JudgementDay_TrialStart_7f75cc04:

    # JUDGE_FALWIND "... Captain 妮克斯, the prosecution has asked you-"
    JUDGE_FALWIND "... 妮克斯上尉，检方在问你——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2699
translate zh qst_JudgementDay_TrialStart_bad2afae:

    # NYX @ angry "Everything I have done, I have done to defend this city."
    NYX @ angry "我所做的一切，都是为了保卫这座城市。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2700
translate zh qst_JudgementDay_TrialStart_1c354aac:

    # NYX @ angry "The guard is woefully desperate and I-"
    NYX @ angry "卫队处境绝望，而我——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2701
translate zh qst_JudgementDay_TrialStart_de61f8b4:

    # MARION @ angry "You chose to dangerously override the authority of all others and directly disobey the chain of command!"
    MARION @ angry "你选择危险地凌驾于所有其他权威之上，直接违抗指挥链！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2702
translate zh qst_JudgementDay_TrialStart_1d415769:

    # MARION @ angry "Your reckless decisions could have endangered everyone in this city!"
    MARION @ angry "你鲁莽的决定本可能危及这座城市里的每一个人！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2703
translate zh qst_JudgementDay_TrialStart_8ab4967d:

    # NYX @ angry "EVERYONE IS ALREADY ENDANGERED!"
    NYX @ angry "每个人早已身处险境！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2704
translate zh qst_JudgementDay_TrialStart_08f6cc85:

    # "The gavel came down once more."
    "法槌再次落下。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2705
translate zh qst_JudgementDay_TrialStart_ff11b318:

    # JUDGE_FALWIND "Control yourself, please."
    JUDGE_FALWIND "请控制好你的情绪。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2706
translate zh qst_JudgementDay_TrialStart_daf4db0b:

    # MARION @ angry "I submit, that Captain 妮克斯 directly defied orders, disobeying the chain of command and endangered everyone."
    MARION @ angry "我主张，妮克斯上尉公然违抗命令，不服从指挥链，危及了所有人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2707
translate zh qst_JudgementDay_TrialStart_339f8052:

    # JUDGE_FALWIND "Inquisitor Marion, with all due respect, this is not the Captain's trial-"
    JUDGE_FALWIND "玛丽恩审判官，恕我直言，这不是上尉的审判——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2708
translate zh qst_JudgementDay_TrialStart_2368c107:

    # MARION @ angry "Captain 妮克斯 recognized the potential power of this dark, magecraft abomination and chose to strike a bargain with it!"
    MARION @ angry "妮克斯上尉认出了这个黑暗法术怪物的潜在力量，并选择与它做交易！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2709
translate zh qst_JudgementDay_TrialStart_985279fc:

    # MARION @ angry "It would serve her bidding and earn her prestige, in return, she actively has chose to hide it's secrets and protect it whenever she could!"
    MARION @ angry "它为她效命，为她赢得声望，作为回报，她积极选择隐藏它的秘密，并尽可能地保护它！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2710
translate zh qst_JudgementDay_TrialStart_62c07c2b:

    # MARION @ angry "The two cases are inexplicably linked!"
    MARION @ angry "这两个案件有着不可分割的联系！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2711
translate zh qst_JudgementDay_TrialStart_8929fa87:

    # JUDGE_FALWIND "That be so... I must ask you keep the focus more towards those on trial, inquisitor from now on."
    JUDGE_FALWIND "即便如此……我必须要求你从现在起将重点更多地放在受审者身上，审判官。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2712
translate zh qst_JudgementDay_TrialStart_3bb8fd45:

    # JUDGE_FALWIND "Captain 妮克斯的 trial is a seperate matter."
    JUDGE_FALWIND "妮克斯上尉的审判是另一回事。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:2713
translate zh qst_JudgementDay_TrialStart_11124689:

