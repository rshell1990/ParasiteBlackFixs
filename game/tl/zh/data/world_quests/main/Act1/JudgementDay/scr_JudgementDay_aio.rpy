translate zh qst_JudgementDay_PostQuestArrivedToHamun_04843039:

    # MC @ serious "Does it matter?"
    MC @ serious "重要吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3543
translate zh qst_JudgementDay_PostQuestArrivedToHamun_ad7dd3d2:

