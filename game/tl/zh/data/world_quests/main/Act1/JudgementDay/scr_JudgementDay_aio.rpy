    JUDGE_FALWIND "法庭今天不会听取阿达拉女士的证词。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3092
translate zh qst_JudgementDay_TrialStart_SummonMenu_31befe5e:

