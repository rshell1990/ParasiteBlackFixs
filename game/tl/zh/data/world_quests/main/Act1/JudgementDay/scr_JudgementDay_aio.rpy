translate zh qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_1b256352:

    # "维斯 opened her mouth to say something, but she paused and smiled awkwardly, changing the subject quickly."
    "薇丝欲言又止，尴尬一笑迅速转移了话题。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3601
