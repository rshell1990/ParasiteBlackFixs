    MC "这边！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1479
translate zh qst_JudgementDay_RescueMages_Prep_d983de2b:

    # "We followed the sound, hurrying through the burning streets to find the entrance of a noble's manor."
    "我们循声穿过燃烧的街道，来到一座贵族宅邸的入口。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1480
translate zh qst_JudgementDay_RescueMages_Prep_e92cf3e1:

    # "From inside, I could hear muffled cries of pain."
    "门内传来压抑的痛苦呻吟。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1482
translate zh qst_JudgementDay_RescueMages_Prep_910eb21e:

    # "Slamming a fist against the bolted door, I called out."
    "我用拳头砸向闩住的大门，高声喊道。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1483
translate zh qst_JudgementDay_RescueMages_Prep_92b4ade6:

    # SOPHIRA "Go away! Be gone, creature!"
    SOPHIRA "走开！滚开，怪物！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1484
translate zh qst_JudgementDay_RescueMages_Prep_357ae423:

    # MC "Sister Divine sent us! We're looking for the lost Palam mages who never returned!"
    MC "圣洁修女派我们来的！我们在找那些没回来的帕拉姆法师！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1485
translate zh qst_JudgementDay_RescueMages_Prep_778ec10a:

    # SOPHIRA "L-Lies! Begone, monster!"
    SOPHIRA "骗...骗人！滚开，怪物！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1488
translate zh qst_JudgementDay_RescueMages_Prep_a350cb10:

    # "Erika stepped forward, slamming her fist against the door."
    "艾丽卡上前一步，用拳头砸门。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1489
translate zh qst_JudgementDay_RescueMages_Prep_14f45b1f:

    # ERIKA "By order of the Inquisition, I demand you open this door!"
    ERIKA "以审判庭之名，命令你开门！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1490
translate zh qst_JudgementDay_RescueMages_Prep_4a41de21:

    # "There was a long pause before a sheepish face peeked through the gap."
    "漫长的沉默后，一张怯生生的脸从门缝探出。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1493
translate zh qst_JudgementDay_RescueMages_Prep_329c6e6a:

    # "A woman, disheveled and covered in ash, but distinctly noble, oddly resembled 阿达拉 in appearance."
    "一位女子，衣衫凌乱沾满灰烬，但贵族气质难掩，样貌竟与阿达拉有几分神似。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1495
translate zh qst_JudgementDay_RescueMages_Prep_ee6d7f8e:

    # "Upon seeing me and 马库斯, she gasped and attempted to slam the door shut, but Erika wedged her foot in before she could."
    "看到我和马克斯，她倒抽一口气想关门，却被艾丽卡抢先一步用脚卡住。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1497
translate zh qst_JudgementDay_RescueMages_Prep_8e798dd8:

    # SOPHIRA "G-Get back!"
    SOPHIRA "退...退后！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1498
translate zh qst_JudgementDay_RescueMages_Prep_e1310062:

    # ERIKA "Hold!"
    ERIKA "站住！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1499
translate zh qst_JudgementDay_RescueMages_Prep_10c0580a:

    # ERIKA "They are with me."
    ERIKA "他们和我一起的。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1500
translate zh qst_JudgementDay_RescueMages_Prep_cf899e87:

    # "The woman's wide, fearful eyes darted back and forth between me and 马库斯 before she hesitantly turned back to Erika."
    "女子惊恐的双眼在我和马克斯之间来回扫视，才迟疑地转向艾丽卡。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1501
translate zh qst_JudgementDay_RescueMages_Prep_c1aa6fc5:

    # ERIKA "Who are you?"
    ERIKA "你是谁？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1502
translate zh qst_JudgementDay_RescueMages_Prep_ca9584e7:

    # SOPHIRA "...I..."
    SOPHIRA "...我..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1503
translate zh qst_JudgementDay_RescueMages_Prep_f34e4dec:

    # SOPHIRA "I am Lady Maringott, but call me Sophira."
    SOPHIRA "我是马林戈特夫人，叫我索菲拉就好。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1505
translate zh qst_JudgementDay_RescueMages_Prep_dcfb449e:

    # ERIKA "The Mages of Palam—are they here?"
    ERIKA "帕拉姆法师——他们在这里吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1506
translate zh qst_JudgementDay_RescueMages_Prep_0988535a:

    # SOPHIRA "Y-Yes... Come quickly."
    SOPHIRA "是...是的...快请进。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1510
translate zh qst_JudgementDay_RescueMages_Prep_89f25f4f:

    # "Sophira led us into the main hall of the manor, now a makeshift infirmary littered with wounded men and women."
    "索菲拉领我们进入宅邸主厅，这里已成临时医务所，躺满受伤的男女。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1511
translate zh qst_JudgementDay_RescueMages_Prep_18de3914:

    # "The air was filled with pained groans as bloodied civilians and soldiers writhed on hastily arranged beds."
    "空气中充斥着痛苦的呻吟，血污的平民和士兵在匆忙布置的床铺上扭动。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1512
translate zh qst_JudgementDay_RescueMages_Prep_ef679b7f:

    # "Exhausted Mages of Palam moved frantically, tending to the wounded."
    "疲惫的帕拉姆法师穿梭忙碌，救治伤员。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1515
translate zh qst_JudgementDay_RescueMages_Prep_be997334:

    # "The chaos of the scene meant few even looked up at us."
    "现场的混乱让少有人抬头看我们。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1519
translate zh qst_JudgementDay_RescueMages_Prep_4cb32837:

    # ERIKA "What is going on here?"
    ERIKA "这里发生了什么？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1520
translate zh qst_JudgementDay_RescueMages_Prep_32a7d9bc:

    # SOPHIRA "The attack came so suddenly..."
    SOPHIRA "袭击来得太突然了..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1521
translate zh qst_JudgementDay_RescueMages_Prep_ab1b8518:

    # SOPHIRA "We opened our doors to shelter as many as we could, but the wounded kept piling in."
    SOPHIRA "我们敞开大门收容尽可能多的人，但伤员不断涌入。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1522
translate zh qst_JudgementDay_RescueMages_Prep_08869913:

    # "Her face darkened."
    "她脸色一沉。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1523
translate zh qst_JudgementDay_RescueMages_Prep_46f9b89b:

    # SOPHIRA "...Some of the mages didn't make it."
    SOPHIRA "...有些法师没能挺住。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1524
translate zh qst_JudgementDay_RescueMages_Prep_c277dfeb:

    # SOPHIRA "But those who remain have been a blessing from the gods."
    SOPHIRA "但活下来的都是神赐的恩典。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1525
translate zh qst_JudgementDay_RescueMages_Prep_ba99da2c:

    # SOPHIRA "I fear many more would have perished without them."
    SOPHIRA "没有他们，恐怕会有更多人丧命。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1526
translate zh qst_JudgementDay_RescueMages_Prep_288b2912:

    # ERIKA "Where is your husband?"
    ERIKA "你丈夫在哪儿？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1527
translate zh qst_JudgementDay_RescueMages_Prep_2b343ada:

    # SOPHIRA "My husband lost his legs many years ago."
    SOPHIRA "我丈夫多年前失去了双腿。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1528
translate zh qst_JudgementDay_RescueMages_Prep_d5a91e24:

    # SOPHIRA "I've confined him to his room for safety until this nightmare ends."
    SOPHIRA "为安全起见，我将他关在房里，直到这场噩梦结束。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1529
translate zh qst_JudgementDay_RescueMages_Prep_9804f65a:

    # MC "What can we do to help?"
    MC "我们能帮什么忙？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1530
translate zh qst_JudgementDay_RescueMages_Prep_3cc7ceca:

    # SOPHIRA "Please... We need more medicine. The mages are exhausted."
    SOPHIRA "求求你们...我们需要更多药品。法师们精疲力尽了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1531
translate zh qst_JudgementDay_RescueMages_Prep_6260956e:

    # ERIKA "Take these people to the main fort. There will be—"
    ERIKA "带这些人去主堡垒。那里会——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1532
translate zh qst_JudgementDay_RescueMages_Prep_08946951:

    # SOPHIRA "No!"
    SOPHIRA "不行！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1533
translate zh qst_JudgementDay_RescueMages_Prep_16119eaf:

    # SOPHIRA "None of the wounded can fight, and the mages are too drained."
    SOPHIRA "伤员无法战斗，法师们也耗尽法力。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1534
translate zh qst_JudgementDay_RescueMages_Prep_8bff53d6:

    # SOPHIRA "We'd be slaughtered if we tried to move now."
    SOPHIRA "现在转移只会被屠杀。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1535
translate zh qst_JudgementDay_RescueMages_Prep_b0728f26:

    # MC "Then what do you suggest?"
    MC "那你有何建议？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1536
translate zh qst_JudgementDay_RescueMages_Prep_cbc9f014:

    # SOPHIRA "The basement."
    SOPHIRA "地下室。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1537
translate zh qst_JudgementDay_RescueMages_Prep_94f195d8:

    # SOPHIRA "There are more medical supplies, food, and water down there."
    SOPHIRA "下面有更多医疗物资、食物和水。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1538
translate zh qst_JudgementDay_RescueMages_Prep_1fc6089c:

    # ERIKA "Then why haven't you retrieved them already?"
    ERIKA "那你们为何不早去取？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1539
translate zh qst_JudgementDay_RescueMages_Prep_8e33a28a:

    # SOPHIRA "{i}...Something is down there.{/i}"
    SOPHIRA "{i}...下面有东西。{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1540
translate zh qst_JudgementDay_RescueMages_Prep_069e8943:

    # SOPHIRA "When everything started, we heard strange noises coming from the basement."
    SOPHIRA "袭击开始时，我们听到地下室传来怪声。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1541
translate zh qst_JudgementDay_RescueMages_Prep_519c41a4:

    # SOPHIRA "We sent two guards down to check, and then... we heard the most awful sounds."
    SOPHIRA "派了两名卫兵下去查看，然后...就听到了最可怕的声响。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1542
translate zh qst_JudgementDay_RescueMages_Prep_856a2c1b:

    # ERIKA "Is the basement secure now?"
    ERIKA "地下室现在安全吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1543
translate zh qst_JudgementDay_RescueMages_Prep_6cd2601f:

    # SOPHIRA "Yes... We bolted and barricaded it shut."
    SOPHIRA "是的...我们闩上门还堵死了入口。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1544
translate zh qst_JudgementDay_RescueMages_Prep_4df24ebb:

    # SOPHIRA "{i}But we can still hear something moving down there...{/i}"
    SOPHIRA "{i}但仍能听见下面有动静...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1545
translate zh qst_JudgementDay_RescueMages_Prep_3ca32141:

    # MC "Where is this basement?"
    MC "地下室在哪儿？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1546
translate zh qst_JudgementDay_RescueMages_Prep_1307e2ea:

    # SOPHIRA "Wait...! Before you go."
    SOPHIRA "等等...！在你离开之前。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1547
translate zh qst_JudgementDay_RescueMages_Prep_f0cc9421:

    # SOPHIRA "Take these."
    SOPHIRA "拿着这些。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1552
translate zh qst_JudgementDay_RescueMages_Prep_fb70bf95:

    # SOPHIRA "I can't spare much, but... hopefully, you'll be able to clear out whatever's down there."
    SOPHIRA "我能给的不多，但...希望你们能清理掉下面的东西。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1553
translate zh qst_JudgementDay_RescueMages_Prep_bf0933ee:

    # ERIKA "Take us to the basement."
    ERIKA "带我们去地下室。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1554
translate zh qst_JudgementDay_RescueMages_Prep_ed135172:

    # ERIKA "We don't have much time."
    ERIKA "我们时间不多了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1563
translate zh qst_JudgementDay_RescueMages_Prep_de8d52ca:

    # "...The basement door was heavily barricaded, tables and chairs stacked against it in a desperate attempt to keep something locked inside."
    "...地下室的门被重重封锁，桌椅堆叠在门前，拼命想把什么东西锁在里面。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1564
translate zh qst_JudgementDay_RescueMages_Prep_5510eb32:

    # "It took several minutes to clear away the debris before we reached the door itself."
    "我们花了几分钟清理障碍物才抵达门边。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1565
translate zh qst_JudgementDay_RescueMages_Prep_2d08aad9:

    # "Sophira hesitated, stepping back as I reached for the handle."
    "索菲拉犹豫着后退，当我伸手去抓门把时。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1569
translate zh qst_JudgementDay_RescueMages_Prep_f2fd1f30:

    # "As the door creaked open, an eerie darkness stretched down into the unknown."
    "门吱呀打开时，诡异的黑暗向下延伸至未知深处。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1571
translate zh qst_JudgementDay_RescueMages_Prep_9f7bb532:

    # MARKUS "...You first."
    MARKUS "...你先走。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1572
translate zh qst_JudgementDay_RescueMages_Prep_2464d270:

    # "Step by step, we descended into the oppressive darkness, the cold stone beneath our feet making every movement feel heavier."
    "我们一步步踏入压抑的黑暗，脚下冰冷的石板让每个动作都愈发沉重。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1574
translate zh qst_JudgementDay_RescueMages_Prep_a5faaf6e:

    # "俄蕾娜 whined nervously behind me."
    "俄蕾娜在我身后紧张地呜咽着。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1576
translate zh qst_JudgementDay_RescueMages_Prep_20c6c022:

    # MC "Calm, 俄蕾娜."
    MC "冷静，俄蕾娜。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1580
translate zh qst_JudgementDay_RescueMages_Prep_05531ad1:

    # MYU "T-This seems like a bad idea to 米尤..."
    MYU "喵、喵觉得这不是好主意..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1585
translate zh qst_JudgementDay_RescueMages_Prep_784f60a8:

    # "Finally, we reached the bottom."
    "终于，我们抵达了底部。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1586
translate zh qst_JudgementDay_RescueMages_Prep_a1b18879:

    # "Even in the dim light, I could see the place was a mess—broken crates, toppled shelves, and shattered bottles lay scattered across the floor."
    "昏暗光线下，仍可见此地一片狼藉——破碎的板条箱、倾倒的货架、碎裂的瓶子散落满地。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1587
translate zh qst_JudgementDay_RescueMages_Prep_d10a2b67:

    # "Food, medicine, and supplies lay in ruined heaps as though some wild beast had rampaged through here."
    "食物、药品和补给品散乱成堆，仿佛有野兽在此肆虐过。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1588
translate zh qst_JudgementDay_RescueMages_Prep_b06dde3e:

    # "Most disturbing of all was the heavy trail of blood that led deeper into the room... only to suddenly disappear in the middle of the floor."
    "最令人不安的是那浓重的血迹延伸至房间深处...却在地板中央戛然而止。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1589
translate zh qst_JudgementDay_RescueMages_Prep_84dbeb44:

    # "Erika tightened her grip on her sword as a strange dragging sound echoed through the chamber."
    "俄蕾娜握紧剑柄，诡异的拖拽声在厅内回荡。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1590
translate zh qst_JudgementDay_RescueMages_Prep_f34d9a6e:

    # ERIKA "{i}It's still here...{/i}"
    ERIKA "{i}它还在...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1591
translate zh qst_JudgementDay_RescueMages_Prep_fc93b91b:

    # "A sinister, wet slithering noise grew louder, circling us from the shadows."
    "阴湿的滑行声逐渐逼近，在阴影中环绕着我们。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1592
translate zh qst_JudgementDay_RescueMages_Prep_07a3131b:

    # "And then, as if the very darkness itself was shifting, everything went still..."
    "接着，仿佛黑暗本身在移动，万物陷入死寂..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1602
translate zh qst_JudgementDay_RescueMages_Prep_7b8076d7:

    # "Writhing in agony, the creature let out a sickening bellow as blood sprayed across the walls."
    "怪物痛苦扭动，发出令人作呕的咆哮，鲜血喷溅在墙壁上。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1604
translate zh qst_JudgementDay_RescueMages_Prep_b620a0e1:

    # "In a final desperate lunge, it attempted to strike—but with a swift swipe of my tail, its head tumbled to the floor, lifeless."
    "它绝望地发起最后扑击——但我的尾巴迅疾扫过，它的头颅滚落地面，生机尽失。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1606
translate zh qst_JudgementDay_RescueMages_Prep_503eb673:

    # MARKUS "{i}*Huff*{/i} What in all the gods was that thing?"
    MARKUS "{i}*喘气*{/i} 诸神在上，那到底是什么东西？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1608
translate zh qst_JudgementDay_RescueMages_Prep_836a7533:

    # ERIKA "{i}I've seen creatures like this before...{/i}"
    ERIKA "{i}我以前见过这种生物...{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1609
translate zh qst_JudgementDay_RescueMages_Prep_e7942df9:

    # MARKUS "You have?"
    MARKUS "你见过？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1610
translate zh qst_JudgementDay_RescueMages_Prep_8b418497:

    # ERIKA "Dark mages can create many horrors..."
    ERIKA "黑暗法师能制造无数恐怖造物..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1611
translate zh qst_JudgementDay_RescueMages_Prep_4c777b59:

    # MARKUS "Wait, are you saying dark mages are working with the Demorai?"
    MARKUS "等等，你是说黑暗法师在和德莫莱合作？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1612
translate zh qst_JudgementDay_RescueMages_Prep_a7d1cbb7:

    # ERIKA "Who knows? We don't have time to speculate."
    ERIKA "天知道？我们没时间猜测了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1613
translate zh qst_JudgementDay_RescueMages_Prep_00904404:

    # ERIKA "Let's go back and tell Sophira it's safe."
    ERIKA "回去告诉索菲拉这里安全了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1622
translate zh qst_JudgementDay_RescueMages_Prep_cc1017a7:

    # SOPHIRA "You're back!"
    SOPHIRA "你们回来了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1623
translate zh qst_JudgementDay_RescueMages_Prep_d8f05fb2:

    # SOPHIRA "We heard terrible noises—I feared the worst!"
    SOPHIRA "我们听到可怕的声音——还以为最坏的情况发生了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1624
translate zh qst_JudgementDay_RescueMages_Prep_249d38dc:

    # ERIKA "It's safe now."
    ERIKA "现在安全了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1625
translate zh qst_JudgementDay_RescueMages_Prep_66fbe380:

    # ERIKA "Though I'm afraid much of the medicine may be lost..."
    ERIKA "但恐怕大部分药品都毁了..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1626
translate zh qst_JudgementDay_RescueMages_Prep_bea94ee9:

    # SOPHIRA "We'll make do. Thank you."
    SOPHIRA "我们会想办法的。谢谢你们。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1627
translate zh qst_JudgementDay_RescueMages_Prep_3a185799:

    # "Sophira turned toward me and 马库斯, her expression softening."
    "索菲拉转向我和马库斯，神色柔和下来。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1628
translate zh qst_JudgementDay_RescueMages_Prep_a3550950:

    # SOPHIRA "...Thank you."
    SOPHIRA "...谢谢。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1629
translate zh qst_JudgementDay_RescueMages_Prep_8e36738f:

    # SOPHIRA "You may have saved a lot of lives today."
    SOPHIRA "你们今天可能救了很多人的命。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1635
translate zh qst_JudgementDay_RescueMages_Prep_46afb077:

    # MYU "Hooray! 米尤 did a good!"
    MYU "好耶！喵立大功！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1636
translate zh qst_JudgementDay_RescueMages_Prep_42980294:

    # SOPHIRA "A-Ahh... Yes, you did."
    SOPHIRA "啊...是的，你做得很好。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1639
translate zh qst_JudgementDay_RescueMages_Prep_90da61ed:

    # ERIKA "We need to go."
    ERIKA "我们得走了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1640
translate zh qst_JudgementDay_RescueMages_Prep_98331877:

    # ERIKA "We've wasted enough time."
    ERIKA "已经浪费太多时间了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1641
translate zh qst_JudgementDay_RescueMages_Prep_8f616c48:

    # SOPHIRA "Wait! Before you leave..."
    SOPHIRA "等等！在你们离开前..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1642
translate zh qst_JudgementDay_RescueMages_Prep_5139d402:

    # SOPHIRA "Let one of the mages tend to your wounds. It's the least we can do."
    SOPHIRA "让法师治疗你们的伤。这是我们至少能做的。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1646
translate zh qst_JudgementDay_RescueMages_Prep_b9f6f48a:

    # "...After being healed by one of the mages, we made our way out."
    "...在被法师治疗后，我们动身离开。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1650
translate zh qst_JudgementDay_RescueMages_Unprep_9e4944f2:

    # ERIKA "Fine, but we must hurry!"
    ERIKA "好吧，但我们必须快！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1658
translate zh qst_JudgementDay_RescueMages_Unprep_46309dca:

    # "We scoured the district, but neither I nor 马库斯 could pick up their scent through the thick smoke."
    "我们搜遍整个城区，但我和马克斯都无法在浓烟中分辨出他们的气味。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1659
translate zh qst_JudgementDay_RescueMages_Unprep_838c0731:

    # "Suddenly, a sharp cry echoed through the air."
    "突然，一声尖锐的哭喊划破空气。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1661
translate zh qst_JudgementDay_RescueMages_Unprep_65fb0b3b:

    # MC "This way!"
    MC "这边！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1662
translate zh qst_JudgementDay_RescueMages_Unprep_d983de2b:

    # "We followed the sound, hurrying through the burning streets to find the entrance of a noble's manor."
    "我们循声穿过燃烧的街道，来到一座贵族宅邸的入口。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1663
translate zh qst_JudgementDay_RescueMages_Unprep_e92cf3e1:

    # "From inside, I could hear muffled cries of pain."
    "门内传来压抑的痛苦呻吟。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1665
translate zh qst_JudgementDay_RescueMages_Unprep_f2d64bb0:

    # "Slamming my fist against it I called out to only be met with silence as my answer."
    "我猛捶大门呼喊，却只得到死寂作为回应。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1667
translate zh qst_JudgementDay_RescueMages_Unprep_f5320ddb:

    # "Gripping at the door with my tentacles, I tore the thing open with ease and stepped inside."
    "我用触手缠住门扉，轻易将其撕开踏入其中。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1671
translate zh qst_JudgementDay_RescueMages_Unprep_b6d10b53:

    # "The walls were laced in blood, bodies torn to shreds littered the place."
    "墙壁溅满血迹，撕碎的尸体遍布各处。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1672
translate zh qst_JudgementDay_RescueMages_Unprep_8caf742f:

    # "Here and there, a bit of bloodied blue flesh and skin as the sickly smell of blood and death filled the air."
    "四处散落着染血的蓝色皮肉，血腥与死亡的气息弥漫在空气中。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1673
translate zh qst_JudgementDay_RescueMages_Unprep_46abadc0:

    # "It appears the mansion had been used as some kind of makeshift hospital."
    "这座宅邸似乎被用作临时医院。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1674
translate zh qst_JudgementDay_RescueMages_Unprep_d5c2bc59:

    # "Or at least, it {i}was{/i} before something got in."
    "或者说，在某个东西闯入{i}之前{/i}曾是。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1677
translate zh qst_JudgementDay_RescueMages_Unprep_812649d0:

    # "Erika turned a shade of white as she struggled not to throw up."
    "俄蕾娜脸色惨白，强忍着呕吐的冲动。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1678
translate zh qst_JudgementDay_RescueMages_Unprep_d43eae69:

    # ERIKA "Gods... What happened in here?"
    ERIKA "诸神啊...这里发生了什么？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1680
translate zh qst_JudgementDay_RescueMages_Unprep_17e1d435:

    # MARKUS "It doesn't look like they managed to put up much of a fight..."
    MARKUS "看起来他们根本没机会反抗..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1681
translate zh qst_JudgementDay_RescueMages_Unprep_9cbf423d:

    # "A snapping sound echoed through the halls, followed by another ghastly scream."
    "折断声在走廊回荡，紧接着是另一声凄厉尖叫。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1685
translate zh qst_JudgementDay_RescueMages_Unprep_18f10e05:

    # UNKNOWN "AHHHHHHHH!"
    UNKNOWN "啊啊啊啊啊！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1686
translate zh qst_JudgementDay_RescueMages_Unprep_65fb0b3b_1:

    # MC "This way!"
    MC "这边！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1689
translate zh qst_JudgementDay_RescueMages_Unprep_9893b43a:

    # "Chasing the screams led us down a hallway towards a strange entranceway leading underground."
    "追随着尖叫，我们穿过走廊来到通往地下的诡异入口。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1690
translate zh qst_JudgementDay_RescueMages_Unprep_3e65ada3:

    # "With shattered chains around the entranceway, {i}something{/i} must have broken out."
    "入口处散落着断裂的锁链，{i}某个东西{/i}肯定破门而出了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1691
translate zh qst_JudgementDay_RescueMages_Unprep_3cc2ee74:

    # "A bone-chilling crunching sound was heard as we descended the stairs into that deep and terrible darkness."
    "当我们走下楼梯踏入深邃的恐怖黑暗时，令人毛骨悚然的咀嚼声传来。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1694
translate zh qst_JudgementDay_RescueMages_Unprep_fd50f717:

    # "There... waving a torch around the flooded basement, the water up to our ankles, we looked around for the source of the sound."
    "在齐踝深的水中...我们挥动火把环顾被淹的地下室，搜寻声音来源。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1695
translate zh qst_JudgementDay_RescueMages_Unprep_b164bb17:

    # "Slowly moving the light from left to right across the debris, there...{i}we saw it.{/i}"
    "火光缓缓扫过瓦砾...在那里...{i}我们看见了它{/i}。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1697
translate zh qst_JudgementDay_RescueMages_Unprep_cdd450ae:

    # "A snake like creature with a humanoid like body, sinking it's teeth once more into the woman in a blue dress."
    "蛇形人身的怪物，正将利齿再次咬进蓝裙女子的身体。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1698
translate zh qst_JudgementDay_RescueMages_Unprep_2d53ad4b:

    # "She let out one last raspy cry of pain as the thing chewed on her, the deep red sinking through and overpowering the blue."
    "当怪物啃噬她时，她发出最后嘶哑的痛呼，深红血色浸透并吞噬了蓝色衣裙。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1699
translate zh qst_JudgementDay_RescueMages_Unprep_ae6c5a83:

    # "Pale white, she seemed completely drained of all life as the eyes of her ghastly, skeleton white face rolled up."
    "她面色惨白如骨，眼珠上翻，仿佛被抽干了所有生机。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1700
translate zh qst_JudgementDay_RescueMages_Unprep_18470e76:

    # "The creature snarled, tosing her now lifeless body aside, letting it slam against one of the walls as we heard the bones break."
    "怪物咆哮着将尸体甩向墙壁，我们听见骨头断裂的脆响。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1703
translate zh qst_JudgementDay_RescueMages_Unprep_1a712d20:

    # "It licked at it's bloody fangs before lunging towards us!"
    "它舔舐染血的尖牙，随即向我们扑来！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1713
translate zh qst_JudgementDay_RescueMages_Unprep_96fa915c:

    # "Slicing my claws across the creature's throat, the snakeman waved back and force, reaching at it's gaping wound where it's throat once was."
    "我的利爪划过怪物咽喉，蛇人抽搐着抓挠曾经是喉咙的血洞。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1714
translate zh qst_JudgementDay_RescueMages_Unprep_1027db08:

    # "After letting out a desperate, raspy cry, it collapsed face first into the water, twitching for a few moments before falling completely still."
    "发出绝望的嘶鸣后，它面朝下栽进水中，抽搐片刻便彻底静止。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1715
translate zh qst_JudgementDay_RescueMages_Unprep_0374e7bc:

    # MC "What in the hells is this thing?"
    MC "这到底是什么鬼东西？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1716
translate zh qst_JudgementDay_RescueMages_Unprep_4b2c1c99:

    # MC "Some kind of... dark magecraft abomination?"
    MC "某种...黑暗法术的造物？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1718
translate zh qst_JudgementDay_RescueMages_Unprep_79c627e2:

    # ERIKA "I... I've never seen anything like it before."
    ERIKA "我...从未见过这种东西。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1719
translate zh qst_JudgementDay_RescueMages_Unprep_591afddc:

    # ERIKA "It appears to be... {i}part human?{/i}"
    ERIKA "它似乎是...{i}半人形？{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1721
translate zh qst_JudgementDay_RescueMages_Unprep_ec77576a:

    # MARKUS "We should leave this place, whatever this {i}thing{/i} is, the inquisitors and whoever can look at the damn thing when we're done."
    MARKUS "我们该离开这鬼地方，管它是什么{i}玩意{/i}，等完事了让审判官慢慢研究去。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1723
translate zh qst_JudgementDay_RescueMages_Unprep_38177186:

    # "I nodded in agreement as we made our way back up through the mansion estate."
    "我点头同意，随后我们穿过庄园向上撤离。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1725
translate zh qst_JudgementDay_RescueMages_Unprep_8bfc939c:

    # "I took one last look at the dead bodies littered around... Perhaps..."
    "我最后瞥了一眼遍布的尸体...或许..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1727
translate zh qst_JudgementDay_RescueMages_Unprep_6725b4fe:

    # "{i}Perhaps if things were different, I could have saved them.{/i}"
    "{i}如果情况不同，我本可以救下他们{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1738
translate zh qst_JudgementDay_RescueMages_MoveOn_e1032b47:

    # "Navigating through the chaotic streets, Erika guided us through a series of alleyways and back routes."
    "俄蕾娜带领我们在混乱的街道穿行，拐入错综复杂的小巷与后路。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1739
translate zh qst_JudgementDay_RescueMages_MoveOn_ff091e7a:

    # "Finally, pushing through to the main street, we hurried toward our destination."
    "终于冲破阻碍来到主街，我们匆忙赶往目的地。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1740
translate zh qst_JudgementDay_RescueMages_MoveOn_f2ac90ca:

    # ERIKA "We must move quickly before—"
    ERIKA "必须趁现在快走——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1742
translate zh qst_JudgementDay_RescueMages_MoveOn_58420e88:

    # "There, amidst a heap of mangled corpses, sat the gleaming, towering figure of the Silver Knight."
    "在堆积的残破尸体间，端坐着银甲生辉的高大身影——银骑士。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1743
translate zh qst_JudgementDay_RescueMages_MoveOn_1df97ea7:

    # "His cape fluttered in the wind as the city burned around him, his presence eerily still in the midst of carnage."
    "披风在风中翻飞，城市在他周围燃烧，而他在屠场中静默如雕塑。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1744
translate zh qst_JudgementDay_RescueMages_MoveOn_042dbc76:

    # "Despite the splattering of blood across his armor, his silver plating still shined brilliantly through the filth."
    "尽管盔甲溅满血污，银甲仍在污秽中闪耀着寒光。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1749
translate zh qst_JudgementDay_RescueMages_MoveOn_78e5318e:

    # SILVER_KNIGHT "..."
    SILVER_KNIGHT "..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1751
translate zh qst_JudgementDay_RescueMages_MoveOn_e51a3c47:

    # "Slowly, he tilted his head up, locking his piercing gaze onto us."
    "他缓缓抬头，锐利目光锁定了我们。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1753
translate zh qst_JudgementDay_RescueMages_MoveOn_31385b2d:

    # "His grip on his massive sword tightened as he rose to his feet, advancing in our direction."
    "他握紧巨剑起身，朝我们步步逼近。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1754
translate zh qst_JudgementDay_RescueMages_MoveOn_a455176a:

    # MARKUS "F-Fuck! It's him! It's the Silver Knight himself!"
    MARKUS "操！是他！银骑士本人！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1755
translate zh qst_JudgementDay_RescueMages_MoveOn_0aea49c7:

    # "The Silver Knight... A warrior of legend, chosen to serve and die for the royal family of Alderay."
    "银骑士...传说中的战士，被选中为奥尔德雷王室效死。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1756
translate zh qst_JudgementDay_RescueMages_MoveOn_3702506d:

    # "Possessing unmatched skill in both blade and magecraft, it was said that he was perhaps the only man who could have challenged Newheart and won."
    "据传他拥有无双的剑术与法术，或许是唯一能击败纽哈特的人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1757
translate zh qst_JudgementDay_RescueMages_MoveOn_485f73a4:

    # "...And now, he was coming straight for us."
    "...而现在，他正朝我们径直走来。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1758
translate zh qst_JudgementDay_RescueMages_MoveOn_ad3944f0:

    # ERIKA "Hold, Sir Knight! HOLD!"
    ERIKA "停下，骑士大人！请止步！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1760
translate zh qst_JudgementDay_RescueMages_MoveOn_7b45065b:

    # "The Silver Knight stopped in his tracks, eyes narrowing as he examined me and 马库斯."
    "银骑士停住脚步，眯眼审视我和马库斯。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1761
translate zh qst_JudgementDay_RescueMages_MoveOn_5fe8b642:

    # "His posture remained unreadable, but his grip on his weapon remained firm."
    "他的姿态难以捉摸，但握剑的手依然坚定。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1763
translate zh qst_JudgementDay_RescueMages_MoveOn_6ddf1665:

    # SILVER_KNIGHT "…What are they?"
    SILVER_KNIGHT "…这些是什么？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1764
translate zh qst_JudgementDay_RescueMages_MoveOn_8709d483:

    # ERIKA "As of now, these... creatures are under the order of the Inquisition."
    ERIKA "目前这些...生物受审判庭调遣。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1765
translate zh qst_JudgementDay_RescueMages_MoveOn_e74bc1de:

    # SILVER_KNIGHT "I do not concern myself with the affairs of the Inquisition."
    SILVER_KNIGHT "我不关心审判庭的事务。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1766
translate zh qst_JudgementDay_RescueMages_MoveOn_ff96d9a5:

    # SILVER_KNIGHT "Only that the royal family remains safe."
    SILVER_KNIGHT "只在乎王室的安危。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1767
translate zh qst_JudgementDay_RescueMages_MoveOn_cd3ce366:

    # "Erika gulped, the color draining from her face as she likely questioned whether even all of us combined could stop the Silver Knight."
    "俄蕾娜喉头滚动，脸色发白，显然在怀疑我们联手能否对抗银骑士。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1768
translate zh qst_JudgementDay_RescueMages_MoveOn_e5d01a38:

    # MC "Princess Cecilia has tasked us with finding her brother, Prince Naran, and returning him to the castle."
    MC "塞西莉亚公主命我们寻找其兄纳兰王子并护送回城堡。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1769
translate zh qst_JudgementDay_RescueMages_MoveOn_15b97946:

    # "The Silver Knight studied me carefully before turning his gaze to Erika."
    "银骑士仔细审视我，随后将目光转向俄蕾娜。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1770
translate zh qst_JudgementDay_RescueMages_MoveOn_f04727a6:

    # SILVER_KNIGHT "Princess Cecilia should be in the castle."
    SILVER_KNIGHT "塞西莉亚公主应在城堡中。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1771
translate zh qst_JudgementDay_RescueMages_MoveOn_2be6c7a0:

    # SILVER_KNIGHT "How did this creature approach her?"
    SILVER_KNIGHT "这东西如何接近她的？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1772
translate zh qst_JudgementDay_RescueMages_MoveOn_bb21353a:

    # MARKUS "We saved her damn life!"
    MARKUS "我们救了她的命！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1773
translate zh qst_JudgementDay_RescueMages_MoveOn_c4aef209:

    # "In an instant, the Silver Knight's blade was pointed directly at 马库斯的 throat."
    "银骑士的剑尖瞬间抵住马库斯的咽喉。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1775
translate zh qst_JudgementDay_RescueMages_MoveOn_a64caac8:

    # SILVER_KNIGHT "Her 'damn life' is worth far more than yours, creature."
    SILVER_KNIGHT "她的命比你这怪物珍贵千万倍。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1776
translate zh qst_JudgementDay_RescueMages_MoveOn_0a0e5149:

    # SILVER_KNIGHT "Remember that when you speak of her."
    SILVER_KNIGHT "谈论她时记住这一点。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1777
translate zh qst_JudgementDay_RescueMages_MoveOn_c3c73447:

    # "I stepped between 马库斯 and the blade."
    "我挡在马库斯与剑刃之间。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1778
translate zh qst_JudgementDay_RescueMages_MoveOn_aa0c27d2:

    # MC "Princess Cecilia attempted to sneak out in search of her brother."
    MC "塞西莉亚公主曾试图溜出城堡寻找王弟。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1779
translate zh qst_JudgementDay_RescueMages_MoveOn_4bbbaae0:

    # MC "She was ambushed by Demorai, but we saved her."
    MC "她遭德莫莱伏击，是我们救了她。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1780
translate zh qst_JudgementDay_RescueMages_MoveOn_221b8639:

    # "The Silver Knight paused, seemingly weighing my words."
    "银骑士停顿片刻，似乎在权衡我的话。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1781
translate zh qst_JudgementDay_RescueMages_MoveOn_32de8b7a:

    # SILVER_KNIGHT "…If what you say is true."
    SILVER_KNIGHT "…若你所言属实。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1783
translate zh qst_JudgementDay_RescueMages_MoveOn_517e555a:

    # "He withdrew his blade, bringing his gauntleted hand over his chest in a tight salute."
    "他收剑入鞘，铁拳紧贴胸前致意。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1784
translate zh qst_JudgementDay_RescueMages_MoveOn_4eeeca06:

    # SILVER_KNIGHT "I owe you my thanks."
    SILVER_KNIGHT "我欠你们一声感谢。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1787
translate zh qst_JudgementDay_RescueMages_MoveOn_d03a2c08:

    # MYU "米尤 helped too!"
    MYU "喵也帮忙了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1789
translate zh qst_JudgementDay_RescueMages_MoveOn_408a648a:

    # MYU "As did 俄蕾娜!"
    MYU "俄蕾娜也是！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1790
translate zh qst_JudgementDay_RescueMages_MoveOn_9ce74b32:

    # "俄蕾娜 averted her gaze nervously."
    "俄蕾娜紧张地移开视线。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1791
translate zh qst_JudgementDay_RescueMages_MoveOn_eb378171:

    # ELENA "H-Hello…"
    ELENA "你、你好…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1792
translate zh qst_JudgementDay_RescueMages_MoveOn_538e24d3:

    # SILVER_KNIGHT "…Then you also have my thanks."
    SILVER_KNIGHT "…那么也感谢你们。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1794
translate zh qst_JudgementDay_RescueMages_MoveOn_6186d54d:

    # ERIKA "We're heading up the wall. Is the prince safe?"
    ERIKA "我们要去城墙。王子安全吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1795
translate zh qst_JudgementDay_RescueMages_MoveOn_c6f5af92:

    # "The knight nodded slightly."
    "骑士微微颔首。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1796
translate zh qst_JudgementDay_RescueMages_MoveOn_d71c3886:

    # SILVER_KNIGHT "He is safe now, my prince."
    SILVER_KNIGHT "殿下现已安全。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1797
translate zh qst_JudgementDay_RescueMages_MoveOn_aeb7f7dd:

    # "From behind a narrow alley, a short, timid figure emerged."
    "狭窄巷口后，畏缩地走出一个矮小身影。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1799
translate zh qst_JudgementDay_RescueMages_MoveOn_0adbee41:

    # "His features were delicate, almost effeminate."
    "他面容精致，近乎阴柔。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1800
translate zh qst_JudgementDay_RescueMages_MoveOn_70af855b:

    # "His wide, uncertain eyes flickered between me and my companions."
    "惶惑的双眼在我和同伴间游移不定。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1801
translate zh qst_JudgementDay_RescueMages_MoveOn_efd77777:

    # SILVER_KNIGHT "They are not a threat, my lord."
    SILVER_KNIGHT "他们并非威胁，殿下。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1802
translate zh qst_JudgementDay_RescueMages_MoveOn_a4943c53:

    # "The young prince hesitated, his voice soft and uncertain."
    "年轻的王子犹豫着，声音轻柔而不确定。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1803
translate zh qst_JudgementDay_RescueMages_MoveOn_60479631:

    # PRINCE_NARAN "Volsta… W-What manner of creatures are these?"
    PRINCE_NARAN "沃尔斯塔…这-这些是什么怪物？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1804
translate zh qst_JudgementDay_RescueMages_MoveOn_6a63e30d:

    # SILVER_KNIGHT "I do not know, my prince."
    SILVER_KNIGHT "我不知道，殿下。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1805
translate zh qst_JudgementDay_RescueMages_MoveOn_cfc016bf:

    # SILVER_KNIGHT "But we must return you to the castle at once."
    SILVER_KNIGHT "但我们必须立刻护送您回城堡。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1806
translate zh qst_JudgementDay_RescueMages_MoveOn_557191f0:

    # PRINCE_NARAN "But… those monsters are still everywhere!"
    PRINCE_NARAN "可…那些怪物到处都是！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1807
translate zh qst_JudgementDay_RescueMages_MoveOn_d0d11aac:

    # "The prince clung tightly to the Silver Knight, trembling."
    "王子紧紧抓住银骑士，浑身发抖。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1808
translate zh qst_JudgementDay_RescueMages_MoveOn_f110ccdb:

    # SILVER_KNIGHT "I will keep you safe, Naran."
    SILVER_KNIGHT "我会保护您的安全，纳兰。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1810
translate zh qst_JudgementDay_RescueMages_MoveOn_5346539a:

    # SILVER_KNIGHT "But we must move now."
    SILVER_KNIGHT "但我们现在必须行动。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1812
translate zh qst_JudgementDay_RescueMages_MoveOn_b772a928:

    # "Above us, a deafening explosion rocked the sky as a section of the wall burst into flames."
    "头顶传来震耳欲聋的爆炸，一段城墙燃起烈焰，天空为之震颤。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1813
translate zh qst_JudgementDay_RescueMages_MoveOn_1b696125:

    # ERIKA "We need to hurry, quickly!"
    ERIKA "我们必须快点，快！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1818
translate zh qst_JudgementDay_RescueMages_MoveOn_71348209:

    # "Suddenly, from the surrounding buildings and alleyways, a chorus of unnatural growls echoed."
    "突然间，非自然的咆哮声从周围的建筑和巷弄中此起彼伏地回荡。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1819
translate zh qst_JudgementDay_RescueMages_MoveOn_010ca37a:

    # "More of those monstrous ghouls began to emerge, shambling toward us from every direction."
    "更多可怖的食尸鬼开始涌现，从四面八方蹒跚着向我们逼近。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1820
translate zh qst_JudgementDay_RescueMages_MoveOn_29b99d09:

    # PRINCE_NARAN "J-Jaras!"
    PRINCE_NARAN "贾-贾拉斯！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1821
translate zh qst_JudgementDay_RescueMages_MoveOn_9a9ed357:

    # "The prince recoiled, hiding behind the Silver Knight as he slowly unsheathed his blade."
    "王子惊恐后退，躲在银骑士身后，而骑士正缓缓拔出佩剑。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1822
translate zh qst_JudgementDay_RescueMages_MoveOn_990d309c:

    # SILVER_KNIGHT "Stay behind me, my prince."
    SILVER_KNIGHT "躲在我身后，殿下。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1823
translate zh qst_JudgementDay_RescueMages_MoveOn_1047baf5:

    # "The knight briefly glanced toward us."
    "骑士短暂地瞥了我们一眼。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1824
translate zh qst_JudgementDay_RescueMages_MoveOn_d64ff1da:

    # SILVER_KNIGHT "Go. Secure the wall."
    SILVER_KNIGHT "走。去守住城墙。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1825
translate zh qst_JudgementDay_RescueMages_MoveOn_576c8cba:

    # SILVER_KNIGHT "{i}I will handle the monsters…{/i}"
    SILVER_KNIGHT "{i}怪物交给我…{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1831
translate zh qst_JudgementDay_GotToTheWall_3fcc22a5:

    # "We didn't waste a second, sprinting toward the large wooden lift."
    "我们不敢耽搁一秒，全速冲向巨大的木制升降梯。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1832
translate zh qst_JudgementDay_GotToTheWall_6073686b:

    # ERIKA "This should take us straight to the top."
    ERIKA "这能直达城墙顶部。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1834
translate zh qst_JudgementDay_GotToTheWall_9dbc9a64:

    # MARKUS "We'll be completely exposed up there!"
    MARKUS "我们在上面会完全暴露的！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1835
translate zh qst_JudgementDay_GotToTheWall_27615f39:

    # MARKUS "Does it even still work?"
    MARKUS "这东西还能用吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1836
translate zh qst_JudgementDay_GotToTheWall_aa491b95:

    # ERIKA "We don't have time to take the stairs! We're going up now!"
    ERIKA "没时间走楼梯了！现在就上去！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1837
translate zh qst_JudgementDay_GotToTheWall_0897d6bb:

    # "With a sharp pull of the lever, the mechanical gears below groaned as the wooden lift jolted to life, carrying us upward."
    "随着杠杆被猛地拉动，下方的机械齿轮发出呻吟，木制升降梯猛然启动，载着我们上升。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1838
translate zh qst_JudgementDay_GotToTheWall_16d33ca3:

    # "As we ascended, the devastation of the city became clearer."
    "随着上升，城市的惨状愈发清晰。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1839
translate zh qst_JudgementDay_GotToTheWall_bacb7b9b:

    # "The once-proud walls of Novaras were engulfed in fire and smoke."
    "诺瓦拉斯曾经引以为傲的城墙被烈火与浓烟吞噬。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1840
translate zh qst_JudgementDay_GotToTheWall_00f72ca3:

    # "From above, Demorai siege weapons continued their relentless assault, launching massive fireballs against the city's defenses."
    "德莫莱的攻城武器从上方持续发动无情攻击，向城市防御工事投掷巨大的火球。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1841
translate zh qst_JudgementDay_GotToTheWall_2c227e01:

    # MARKUS "By the gods… Will there even be a city left after this?"
    MARKUS "诸神在上…这场仗打完城市还能剩下什么？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1844
translate zh qst_JudgementDay_GotToTheWall_fa61c815:

    # MYU @ sad "…M-米尤."
    MYU @ sad "…M-米尤。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1846
translate zh qst_JudgementDay_GotToTheWall_25b4d31a:

    # ELENA @ grumpy "Cities can be rebuilt."
    ELENA @ grumpy "城市可以重建。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1847
translate zh qst_JudgementDay_GotToTheWall_656dce71:

    # ELENA @ grumpy "But battles can only be won or lost once."
    ELENA @ grumpy "但战役的胜负只有一次机会。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1849
translate zh qst_JudgementDay_GotToTheWall_f908c05a:

    # ERIKA "Stay focused. We're almost at the top."
    ERIKA "集中精神。快到顶了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1857
translate zh qst_JudgementDay_GotToTheWall_a17a25b5:

    # "After a few agonizing minutes, the lift finally came to a grinding halt."
    "煎熬的几分钟后，升降梯终于嘎吱一声停了下来。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1858
translate zh qst_JudgementDay_GotToTheWall_f29fff7d:

    # "The scene atop the wall was grim—scattered corpses of Alderian soldiers and Demorai invaders lay piled on top of one another."
    "城墙上的景象惨不忍睹——奥尔德利亚士兵与德莫莱入侵者的尸体散落各处，层层叠叠。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1859
translate zh qst_JudgementDay_GotToTheWall_d8b69886:

