# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:956
translate zh qst_TheJudgementDay_GoToMageDist_f1d516c6:

    # MC "Our families, our loved ones?"
    MC "我们的家人，我们爱的人？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:957
translate zh qst_TheJudgementDay_GoToMageDist_215b9f44:

    # MC "You can't just leave them!"
    MC "你不能抛下他们！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:958
translate zh qst_TheJudgementDay_GoToMageDist_b35c2e8d:

    # MARKUS "They're probably already dead!"
    MARKUS "他们可能早死了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:959
translate zh qst_TheJudgementDay_GoToMageDist_7308821b:

    # MARKUS "Even if we stay and help, we're FUCKED!"
    MARKUS "就算留下帮忙我们也死定了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:961
translate zh qst_TheJudgementDay_GoToMageDist_cbbdb044:

    # MC "...Then go."
    MC "...那你走吧。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:962
translate zh qst_TheJudgementDay_GoToMageDist_60c99c63:

    # MC "But I'm staying."
    MC "但我要留下。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:964
translate zh qst_TheJudgementDay_GoToMageDist_da94293d:

    # MARKUS "What?!"
    MARKUS "什么？！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:965
translate zh qst_TheJudgementDay_GoToMageDist_9ff92ec1:

    # MC "I won't abandon my friends."
    MC "我不会抛弃朋友。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:966
translate zh qst_TheJudgementDay_GoToMageDist_1fd0bf96:

    # MC "I won't abandon this city."
    MC "我不会抛弃这座城市。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:970
translate zh qst_TheJudgementDay_GoToMageDist_0387a25d:

    # "As I turned to leave, I heard him shout behind me."
    "当我转身离开时，听见他在身后怒吼。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:971
translate zh qst_TheJudgementDay_GoToMageDist_0542804d:

    # MARKUS "FUCKING—FUCK! FUCK! FUCK! ARE YOU FUCKING KIDDING ME!?"
    MARKUS "操——他妈的！该死！见鬼！你他妈在逗我吗！？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:972
translate zh qst_TheJudgementDay_GoToMageDist_daa4c7a5:

    # "For a moment, I heard the powerful flap of his wings..."
    "片刻间，我听见他有力的振翅声..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:974
translate zh qst_TheJudgementDay_GoToMageDist_2c3a24bd:

    # MARKUS "...I fucking hate you sometimes!"
    MARKUS "...我他妈有时真恨你！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:975
translate zh qst_TheJudgementDay_GoToMageDist_d3b6571d:

    # "Despite the carnage, I couldn't help but smirk."
    "尽管身处屠场，我还是忍不住咧嘴一笑。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:978
translate zh qst_TheJudgementDay_GoToMageDist_910bbb87:

    # "...As we made our way through the burning district, a familiar voice rang out."
    "...我们穿越燃烧的街区时，一个熟悉的声音响起。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:985
translate zh qst_TheJudgementDay_GoToMageDist_68d9d74f:

    # "I turned to see Sister Divine, flanked by a company of battle-ready mages."
    "我转身看见圣洁修女，身旁簇拥着一队备战法师。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:986
translate zh qst_TheJudgementDay_GoToMageDist_8748e9c2:

    # "Some of them eyed me warily, hands hovering over their staffs—until Divine raised a hand."
    "部分法师警惕地盯着我，手悬在法杖上——直到圣洁抬手制止。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:987
translate zh qst_TheJudgementDay_GoToMageDist_82a2979a:

    # MC "The mage towers—are they still standing?"
    MC "法师塔——还完好吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:988
translate zh qst_TheJudgementDay_GoToMageDist_739360ad:

    # DIVINE "For now."
    DIVINE "暂时完好。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:989
translate zh qst_TheJudgementDay_GoToMageDist_fa337b01:

    # DIVINE "We're taking as many wounded as we can into the Tower of Palam."
    DIVINE "我们正将伤员尽可能多地送入帕拉姆之塔。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:990
translate zh qst_TheJudgementDay_GoToMageDist_e35c2908:

    # MC "What do you need?"
    MC "需要我做什么？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:991
translate zh qst_TheJudgementDay_GoToMageDist_59f6b854:

    # DIVINE "Some of my girls—they were sent out to help recover the wounded. They haven't returned."
    DIVINE "我的一些女孩——她们被派去救助伤员，至今未归。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:992
translate zh qst_TheJudgementDay_GoToMageDist_97d92b9e:

    # DIVINE "Please, you must help me!"
    DIVINE "求你了，帮帮我！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:993
translate zh qst_TheJudgementDay_GoToMageDist_7dbae29a:

    # MC "Where were they last sent?"
    MC "她们最后被派往何处？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:994
translate zh qst_TheJudgementDay_GoToMageDist_62877735:

    # DIVINE "South-east, near the ruined chapel. Please... find them if you can!"
    DIVINE "东南方向，靠近废弃小教堂。拜托...如果可能，找到她们！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:995
translate zh qst_TheJudgementDay_GoToMageDist_aa8b42d0:

    # MC "I will see what can be done."
    MC "我尽力而为。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:996
translate zh qst_TheJudgementDay_GoToMageDist_b864bbd2:

    # DIVINE "Wait!"
    DIVINE "等等！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:998
translate zh qst_TheJudgementDay_GoToMageDist_32059291:

    # "Raising her hands, she muttered a prayer, and a warmth spread through my body."
    "她双手抬起低诵祷文，暖流涌遍我全身。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:999
translate zh qst_TheJudgementDay_GoToMageDist_cc5ad301:

    # "{i}A surge of divine magic washed over me, closing my wounds.{/i}"
    "{i}神圣魔法洪流般冲刷全身，治愈了我的伤口。{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1008
translate zh qst_TheJudgementDay_GoToMageDist_4a44e709:

    # "Divine staggered slightly, a mage catching her arm."
    "圣洁踉跄了一下，一名法师扶住她的手臂。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1009
translate zh qst_TheJudgementDay_GoToMageDist_12040647:

    # DIVINE "I'm fine... Now go! Find the girls!"
    DIVINE "我没事...快去吧！找到那些女孩！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1020
translate zh qst_JudgementDay_GoToHousingDist_a77b2e16:

    # "The houses of so many we'd come to know burned around us."
    "无数熟识之人的房屋在我们四周燃烧。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1022
translate zh qst_JudgementDay_GoToHousingDist_83d40aaa:

    # "Torn apart bodies littered the streets—men, women, children..."
    "街道上散落着被撕裂的尸体——男人，女人，孩子..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1028
translate zh qst_JudgementDay_GoToHousingDist_6ade0628:

    # MARKUS "Then let's move quickly."
    MARKUS "那就快行动。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1029
translate zh qst_JudgementDay_GoToHousingDist_84a36cfc:

    # MARKUS "I don't know how long we have before this whole city turns to ash."
    MARKUS "不知道这座城市还能撑多久。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1035
translate zh qst_JudgementDay_GoToHousingDist_c9ecc7ca:

    # "...We wasted no time, rushing towards my home."
    "...我们毫不迟疑地冲向我的家。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1036
translate zh qst_JudgementDay_GoToHousingDist_fff3e3bc:

    # "By some miracle, the house remained unburned."
    "奇迹般地，房屋完好无损。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1039
translate zh qst_JudgementDay_GoToHousingDist_497d2a22:

    # "Without hesitation, I burst inside."
    "我毫不犹豫破门而入。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1043
translate zh qst_JudgementDay_GoToHousingDist_e5f0bd28:

    # "I searched the empty, silent home."
    "我搜查了这座空寂无声的屋子。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1044
translate zh qst_JudgementDay_GoToHousingDist_b06759cc:

    # MC "(No one's here.)"
    MC "(这里没人。)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1057
translate zh qst_JudgementDay_GoToHousingDist_bf6bf4a5:

    # "... A short, frantic trip to 阿达拉的 followed."
    "...接着是去阿达拉家的短暂而慌乱的行程。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1059
translate zh qst_JudgementDay_GoToHousingDist_91e4c5e9:

    # "To my relief, her home was empty—cold, abandoned."
    "令我松口气的是，她家空无一人——冰冷、被遗弃了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1061
translate zh qst_JudgementDay_GoToHousingDist_b11e4ddd:

    # MC "(Thank the gods…)"
    MC "(感谢诸神…)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1062
translate zh qst_JudgementDay_GoToHousingDist_32c48bc0:

    # MC "(It looks like they made it out before the lockdown.)"
    MC "(看来他们在封锁前成功逃出去了。)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1064
translate zh qst_JudgementDay_GoToHousingDist_0d65f503:

    # MARKUS "Is she here?"
    MARKUS "她在这儿吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1065
translate zh qst_JudgementDay_GoToHousingDist_93991100:

    # MC "No. They got out."
    MC "不，他们都逃出去了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1066
translate zh qst_JudgementDay_GoToHousingDist_1bd2b144:

    # MARKUS "Gods be praised. At least someone is safe."
    MARKUS "赞美诸神。至少还有人安全。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1067
translate zh qst_JudgementDay_GoToHousingDist_e3892c55:

    # MARKUS "Let's keep moving!"
    MARKUS "我们继续前进！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1071
translate zh qst_JudgementDay_GoToHousingDist_d4e305b1:

    # "As we arrived, dread filled my gut."
    "当我们抵达时，恐惧攫住了我的五脏六腑。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1077
translate zh qst_JudgementDay_GoToHousingDist_864aa28f:

    # "The door was destroyed, the wood shredded like a beast had raked its claws through it."
    "门被摧毁了，木头被撕得粉碎，仿佛有野兽用爪子抓过。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1078
translate zh qst_JudgementDay_GoToHousingDist_2beca68a:

    # "Inside, blood stained the floors and walls."
    "屋内，鲜血染红了地板和墙壁。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1079
translate zh qst_JudgementDay_GoToHousingDist_63b4ace8:

    # "A monstrous corpse lay sprawled, a knife lodged deep into its back."
    "一具怪物的尸体瘫在地上，背上深深插着一把刀。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1080
translate zh qst_JudgementDay_GoToHousingDist_08a154c0:

    # "阿达拉 sat in the center of the carnage, cradling her father's lifeless body, blood pooling beneath her."
    "阿达拉坐在屠杀现场中央，抱着父亲毫无生气的身体，鲜血在她身下汇聚成泊。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1082
translate zh qst_JudgementDay_GoToHousingDist_9169fdf8:

    # "When she saw me, her eyes went wide—then filled with terror."
    "当她看见我时，眼睛睁得老大——随即充满了恐惧。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1088
translate zh qst_JudgementDay_GoToHousingDist_8769010d:

    # ADARA "GET BACK! GET AWAY FROM ME!"
    ADARA "退后！离我远点！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1089
translate zh qst_JudgementDay_GoToHousingDist_5148edd9:

    # "Her cries twisted into panicked sobs."
    "她的哭喊变成了惊慌的抽泣。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1091
translate zh qst_JudgementDay_GoToHousingDist_3031e3a6:

    # ADARA "HAVEN'T YOU TAKEN ENOUGH FROM ME?!"
    ADARA "你们从我这里夺走得还不够多吗？！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1093
translate zh qst_JudgementDay_GoToHousingDist_ae082923:

    # "I knelt, reaching for her, but she recoiled violently, scrambling back."
    "我跪下，伸手想碰她，但她猛烈地退缩，手脚并用地向后爬。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1094
translate zh qst_JudgementDay_GoToHousingDist_83e45577:

    # MC "阿达拉! It's me!"
    MC "阿达拉！是我啊！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1096
translate zh qst_JudgementDay_GoToHousingDist_b673860c:

    # MC "ADARA!"
    MC "ADARA！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1097
translate zh qst_JudgementDay_GoToHousingDist_bd8f033c:

    # "She stopped resisting, staring up at me, her face frozen in confusion and grief."
    "她停止了抵抗，抬头盯着我，脸上凝固着困惑和悲痛。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1099
translate zh qst_JudgementDay_GoToHousingDist_2dbbc4be:

    # "Tears streamed down her face."
    "泪水从她脸上流下。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1101
translate zh qst_JudgementDay_GoToHousingDist_ff882493:

    # ADARA "You're..."
    ADARA "你…"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1102
translate zh qst_JudgementDay_GoToHousingDist_dc1f29a9:

    # MC "I came as quickly as I could. I—"
    MC "我尽可能快地赶来了。我——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1103
translate zh qst_JudgementDay_GoToHousingDist_11e82624:

    # "阿达拉 shoved me away."
    "阿达拉把我推开。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1105
translate zh qst_JudgementDay_GoToHousingDist_b0d30d8a:

    # ADARA "GET AWAY FROM ME!"
    ADARA "离我远点！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1106
translate zh qst_JudgementDay_GoToHousingDist_3af255fd:

    # "Snatching a knife, she pointed it at me with trembling hands."
    "她抓起一把刀，用颤抖的手指向我。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1108
translate zh qst_JudgementDay_GoToHousingDist_5221be73:

    # ADARA "You're one of them! You've been lying to me this whole time!"
    ADARA "你是它们的一员！你一直都在骗我！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1111
translate zh qst_JudgementDay_GoToHousingDist_a27c5f77:

    # ADARA "Y-You too?!"
    ADARA "你——你也是？！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1112
translate zh qst_JudgementDay_GoToHousingDist_59e86c56:

    # MC "阿达拉, no! Listen to me!"
    MC "阿达拉，不！听我说！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1113
translate zh qst_JudgementDay_GoToHousingDist_6d204bbe:

    # MC "We're trying to save the city! I swear it!"
    MC "我们是在拯救这座城市！我发誓！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1114
translate zh qst_JudgementDay_GoToHousingDist_cec5bea6:

    # ADARA "I… I don't know what to believe!"
    ADARA "我…我不知道该相信什么！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1116
translate zh qst_JudgementDay_GoToHousingDist_e3f34393:

    # "Before I could say another word, she bolted."
    "我还来不及再说一个字，她就冲了出去。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1117
translate zh qst_JudgementDay_GoToHousingDist_caac121e:

    # ADARA "GET OUT OF MY HOUSE!"
    ADARA "滚出我的房子！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1118
translate zh qst_JudgementDay_GoToHousingDist_ccd8064e:

    # MC "阿达拉! Wait!"
    MC "阿达拉！等等！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1120
translate zh qst_JudgementDay_GoToHousingDist_e831d4dd:

    # "As she slammed the door, I considered chasing after her—but 马库斯 grabbed my shoulder, yanking me back."
    "当她砰地关上门时，我想追上去——但马库斯抓住我的肩膀，猛地把我拽了回来。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1121
translate zh qst_JudgementDay_GoToHousingDist_588381ab:

    # MARKUS "There will be time to explain later!"
    MARKUS "以后会有时间解释的！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1122
translate zh qst_JudgementDay_GoToHousingDist_e35cb94e:

    # MARKUS "We CANNOT stay here!"
    MARKUS "我们绝不能留在这里！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1124
translate zh qst_JudgementDay_GoToHousingDist_ff9963c7:

    # "As much as it pained me, I knew he was right."
    "尽管痛苦万分，但我知道他是对的。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1127
translate zh qst_JudgementDay_GoToHousingDist_e1c3fc6b:

    # "We fled into the burning streets once more."
    "我们再次逃入燃烧的街道。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1141
translate zh qst_JudgementDay_GoToHousingDist_da031e0a:

    # NIJAH "AHHHHHHHHH!"
    NIJAH "啊啊啊啊啊啊！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1147
translate zh qst_JudgementDay_GoToHousingDist_cb704491:

    # MC "NIJAH!"
    MC "NIJAH！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1148
translate zh qst_JudgementDay_GoToHousingDist_2919dbd4:

    # "A terrified Nijah fended off a snarling skin walker, flinging a pot of steaming broth at it."
    "惊恐的妮娅正抵御一只咆哮的剥皮行者，将一锅滚烫的肉汤朝它泼去。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1150
translate zh qst_JudgementDay_GoToHousingDist_fef566b8:

    # "The thing shrieked as the scalding liquid sizzled its flesh, but as it smacked the pot aside, it raised its claws to strike."
    "那东西在滚烫液体灼烧皮肉时尖啸着，但打飞锅后，它举起了爪子准备攻击。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1152
translate zh qst_JudgementDay_GoToHousingDist_f9bf7b63:

    # "She closed her eyes, bracing for the blow that never came."
    "她闭上眼睛，准备承受那并未到来的打击。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1161
translate zh qst_JudgementDay_GoToHousingDist_90c17f83:

    # "When she opened them, the ghoul was severed in half, and I stood over its corpse."
    "当她睁开眼时，食尸鬼已被斩成两段，我站在它的尸体旁。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1162
translate zh qst_JudgementDay_GoToHousingDist_17035206:

    # NIJAH @ shock "{i}*Gasp!*{/i}"
    NIJAH @ shock "{i}*倒抽一口气！*{/i}"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1165
translate zh qst_JudgementDay_GoToHousingDist_7871316e:

    # "Nijah threw herself at me, arms wrapping tight around my body."
    "妮娅扑向我，双臂紧紧环抱住我的身体。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1166
translate zh qst_JudgementDay_GoToHousingDist_a5fbb10f:

    # NIJAH "You came! You saved me!"
    NIJAH "你来了！你救了我！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1167
translate zh qst_JudgementDay_GoToHousingDist_50e4fa0d:

    # MC "Nijah, what are you doing out here? It's not safe!"
    MC "妮娅，你在这里做什么？太危险了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1168
translate zh qst_JudgementDay_GoToHousingDist_8e234dad:

    # NIJAH @ sad "I let friendz shelter in my home during battle."
    NIJAH @ sad "战斗时我让朋友们躲在我家里。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1169
translate zh qst_JudgementDay_GoToHousingDist_5f133ac4:

    # NIJAH @ sad "One was hurt, zo I went to find mage or medicine!"
    NIJAH @ sad "有人受伤了，所以我去找法师或药物！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1170
translate zh qst_JudgementDay_GoToHousingDist_c831d100:

    # NIJAH @ scared "T-Then those monsters came and I couldn't get back!"
    NIJAH @ scared "接-接着那些怪物来了，我回不去了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1171
translate zh qst_JudgementDay_GoToHousingDist_ff7e7271:

    # MC "Can you make it home safely now?"
    MC "你现在能安全回家吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1173
translate zh qst_JudgementDay_GoToHousingDist_8031a768:

    # "Nijah gently rested her hand on my chest."
    "妮娅轻轻把手放在我的胸口。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1175
translate zh qst_JudgementDay_GoToHousingDist_cc06e485:

    # NIJAH @ scared "Go! I will be alright!"
    NIJAH @ scared "快走！我会没事的！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1176
translate zh qst_JudgementDay_GoToHousingDist_79c7b0c1:

    # NIJAH "Hurry! Others will need help!"
    NIJAH "快点！其他人需要帮助！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1177
translate zh qst_JudgementDay_GoToHousingDist_0454ada0:

    # MC "...Be safe."
    MC "...注意安全。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1179
translate zh qst_JudgementDay_GoToHousingDist_eeafaa68:

    # NIJAH @ sad "...Be safe, my love."
    NIJAH @ sad "...注意安全，我的爱人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1197
translate zh qst_JudgementDay_GoToHousingDist_8e238a6e:

    # MARKUS "The castle district isn't far, we should—"
    MARKUS "城堡区不远了，我们应该——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1198
translate zh qst_JudgementDay_GoToHousingDist_e88ee10b:

    # "马库斯 suddenly stopped."
    "马库斯突然停下了脚步。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1199
translate zh qst_JudgementDay_GoToHousingDist_56bb8c5f:

    # MC "马库斯?"
    MC "马库斯？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1200
translate zh qst_JudgementDay_GoToHousingDist_803cd4bd:

    # MC "What is—"
    MC "那是——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1205
translate zh qst_JudgementDay_GoToHousingDist_5b4dda25:

    # "As I turned to look at what he was staring at, I froze."
    "当我转身看向他凝视的方向时，我僵住了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1207
translate zh qst_JudgementDay_GoToHousingDist_eb836cd6:

    # "Nijah's body—each limb torn off and pierced on a bloody, jagged spike—was placed in macabre display for all to see."
    "妮娅的躯体——四肢被撕裂，穿刺在血淋淋的锯齿状尖刺上——被放置在骇人的展示中供所有人观看。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1208
translate zh qst_JudgementDay_GoToHousingDist_dcac6ec4:

    # "My knees began to shake as my eyes locked on her lifeless expression."
    "当我的目光锁定她毫无生气的表情时，我的膝盖开始发抖。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1210
translate zh qst_JudgementDay_GoToHousingDist_de0d0eff:

    # "马库斯 reached out, catching me before I collapsed."
    "马库斯伸出手，在我瘫倒前扶住了我。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1216
translate zh qst_JudgementDay_GoToHousingDist_2fdc28eb:

    # MC "马库斯... They've..."
    MC "马库斯... 他们..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1218
translate zh qst_JudgementDay_GoToHousingDist_17407b40:

    # MC "...She did nothing to them. She—"
    MC "...她什么都没对他们做。她——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1220
translate zh qst_JudgementDay_GoToHousingDist_38bdadb3:

    # MC "...How... how could—"
    MC "...怎么... 怎么能——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1221
translate zh qst_JudgementDay_GoToHousingDist_7b28c3e1:

    # "马库斯 grabbed my face, forcing me to look away."
    "马库斯抓住我的脸，强迫我移开视线。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1223
translate zh qst_JudgementDay_GoToHousingDist_6755bdfa:

    # MARKUS "There are still people alive right now who need us!"
    MARKUS "现在还有活着的人需要我们！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1224
translate zh qst_JudgementDay_GoToHousingDist_040f38a7:

    # MARKUS "We have to go—you can mourn later!"
    MARKUS "我们必须走——你可以之后再哀悼！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1225
translate zh qst_JudgementDay_GoToHousingDist_6c83698b:

    # MC "I... Yes, you're right."
    MC "我... 是的，你是对的。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1226
translate zh qst_JudgementDay_GoToHousingDist_2b2df3a7:

    # MARKUS "Come."
    MARKUS "来吧。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1227
translate zh qst_JudgementDay_GoToHousingDist_b09f930f:

    # MARKUS "Let us move on from this infernal place, quickly."
    MARKUS "让我们快点离开这个地狱般的地方。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1229
translate zh qst_JudgementDay_GoToHousingDist_ba97f096:

    # "As we left, I took one last look over my shoulder at Nijah's body, a deep, tremendous pain echoing through me..."
    "离开时，我最后一次回头望向妮娅的遗体，一种深沉、巨大的痛苦在我体内回荡..."

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1230
translate zh qst_JudgementDay_GoToHousingDist_c24bd7be:

    # "...But the pain quickly gave way to pure rage."
    "...但痛苦很快让位给了纯粹的怒火。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1231
translate zh qst_JudgementDay_GoToHousingDist_445ed3f2:

    # MC "(I'll kill them... I'LL KILL THEM ALL!)"
    MC "(我要杀了他们...我要把他们全杀光！)"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1241
translate zh qst_JudgementDay_GoToCentreDist_d15a4e80:

    # "The castle was in lockdown."
    "城堡处于封锁状态。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1242
translate zh qst_JudgementDay_GoToCentreDist_22ddf7c8:

    # "Scorched and battered, its walls remained unbreached."
    "墙壁焦黑破损，但未被攻破。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1243
translate zh qst_JudgementDay_GoToCentreDist_712d2d29:

    # "Outside, torn-apart guards and skin walkers littered the grounds."
    "外面，被撕碎的守卫和剥皮行者尸体遍布地面。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1244
translate zh qst_JudgementDay_GoToCentreDist_173cfcbd:

    # "But most horrifying were the corpses stacked against the gate—ordinary people who had pleaded for sanctuary."
    "但最骇人的是堆积在城门旁的尸体——那些曾乞求庇护的普通人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1245
translate zh qst_JudgementDay_GoToCentreDist_74841ed7:

    # "... And were denied."
    "...却被拒之门外。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1246
translate zh qst_JudgementDay_GoToCentreDist_8cc846a4:

    # "Their bodies were charred black, the stench of burning flesh and ale heavy in the air."
    "他们的尸体烧得焦黑，空气中弥漫着浓烈的皮肉焦糊味和麦酒味。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1247
translate zh qst_JudgementDay_GoToCentreDist_30af6c48:

    # "Above, music played softly from within the castle walls."
    "城堡墙内，上方飘来轻柔的音乐声。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1248
translate zh qst_JudgementDay_GoToCentreDist_bda0f0f0:

    # "Were they drowning out the slaughter outside?"
    "他们是在掩盖外面的屠杀声吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1249
translate zh qst_JudgementDay_GoToCentreDist_c1f86d1f:

    # "Were they *celebrating* as we died?"
    "在我们死去时，他们是在*庆祝*吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1250
translate zh qst_JudgementDay_GoToCentreDist_75386a3d:

    # "A burning rage welled in my chest."
    "一股灼热的怒火在我胸中翻腾。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1251
translate zh qst_JudgementDay_GoToCentreDist_5ed57ae9:

    # MARKUS "We need to keep moving—more guards are bound to reinforce—"
    MARKUS "我们得继续前进——肯定会有更多守卫来增援——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1253
translate zh qst_JudgementDay_GoToCentreDist_fc825f22:

    # GUARD "Princess, please! It isn't safe!"
    GUARD "公主，求您了！这里不安全！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1255
translate zh qst_JudgementDay_GoToCentreDist_f76f3062:

    # "My eyes snapped toward her—Princess Cecilia."
    "我的目光猛地转向她——塞西莉亚公主。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1256
translate zh qst_JudgementDay_GoToCentreDist_ec861cd4:

    # "Clad in royal regalia, she picked her way through the bloodied corpses, a fierce determination in her eyes."
    "她身着王室盛装，在血淋淋的尸体间穿行，眼中带着强烈的决心。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1258
translate zh qst_JudgementDay_GoToCentreDist_e2c548aa:

    # PRINCESS_CECILIA "My brother is still out in the city!"
    PRINCESS_CECILIA "我弟弟还在城里！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1259
translate zh qst_JudgementDay_GoToCentreDist_6d9907df:

    # PRINCESS_CECILIA "I cannot leave him!"
    PRINCESS_CECILIA "我不能丢下他！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1261
translate zh qst_JudgementDay_GoToCentreDist_e54b055f:

    # GUARD "Princess Cecilia, please!"
    GUARD "塞西莉亚公主，求您了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1262
translate zh qst_JudgementDay_GoToCentreDist_251de269:

    # GUARD "This is too dangerous!"
    GUARD "这太危险了！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1263
translate zh qst_JudgementDay_GoToCentreDist_6e34a4db:

    # "As she looked upon the sea of bodies, I heard her heartbeat quicken."
    "当她望向尸山血海时，我听到她的心跳加快了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1264
translate zh qst_JudgementDay_GoToCentreDist_2f1f313f:

    # PRINCESS_CECILIA "....Gods, there's so many of them."
    PRINCESS_CECILIA "....天啊，有这么多人。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1265
translate zh qst_JudgementDay_GoToCentreDist_ca60af05:

    # GUARD "We must return to the castle—"
    GUARD "我们必须回城堡去——"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1267
translate zh qst_JudgementDay_GoToCentreDist_9b8278e0:

    # "From beneath the corpses, monstrous figures lunged, surrounding her."
    "从尸体下方，怪物般的生物猛扑出来，包围了她。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1268
translate zh qst_JudgementDay_GoToCentreDist_8fef4312:

    # GUARD "PRINCESS! GET BACK!"
    GUARD "公主！退后！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1269
translate zh qst_JudgementDay_GoToCentreDist_93a5d1eb:

    # "The guards raised their swords, but they were outnumbered."
    "守卫们举起了剑，但他们寡不敌众。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1270
translate zh qst_JudgementDay_GoToCentreDist_c43dec24:

    # "Without thinking, I leapt forward, claws bared!"
    "我不假思索地向前跃去，利爪尽显！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1273
translate zh qst_JudgementDay_GoToCentreDist_29a7c4a1:

    # MARKUS "Damn it!"
    MARKUS "该死！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1281
translate zh qst_JudgementDay_GoToCentreDist_a809d696:

    # "As the last beast fell, the guards turned their swords on *us*."
    "当最后一只野兽倒下时，守卫们将剑指向*我们*。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1283
translate zh qst_JudgementDay_GoToCentreDist_02b0ebc9:

    # GUARD "Princess! Stand back!"
    GUARD "公主！站到后面去！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1284
translate zh qst_JudgementDay_GoToCentreDist_881ede42:

    # GUARD "Back, fiend!"
    GUARD "退后，恶魔！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1285
translate zh qst_JudgementDay_GoToCentreDist_53234ca0:

    # PRINCESS_CECILIA "Wait!"
    PRINCESS_CECILIA "等等！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1287
translate zh qst_JudgementDay_GoToCentreDist_00f46702:

    # "She stepped between us."
    "她走到我们之间。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1288
translate zh qst_JudgementDay_GoToCentreDist_96b44b75:

    # GUARD "Princess! What are you doing?!"
    GUARD "公主！您在做什么？！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1289
translate zh qst_JudgementDay_GoToCentreDist_c452e649:

    # GUARD "Get back!"
    GUARD "退后！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1290
translate zh qst_JudgementDay_GoToCentreDist_815cfca6:

    # PRINCESS_CECILIA "I do not believe these creatures seek to do us harm!"
    PRINCESS_CECILIA "我不相信这些生物意图伤害我们！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1292
translate zh qst_JudgementDay_GoToCentreDist_d9a959f7:

    # GUARD "Princess, return at once!"
    GUARD "公主，请立刻回去！"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1293
translate zh qst_JudgementDay_GoToCentreDist_966d4f4f:

    # "She turned to me, hesitant but composed."
    "她转向我，有些犹豫但依然镇定。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1294
translate zh qst_JudgementDay_GoToCentreDist_ecc61594:

    # PRINCESS_CECILIA "Do you... understand me?"
    PRINCESS_CECILIA "你...能听懂我说话吗？"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1295
translate zh qst_JudgementDay_GoToCentreDist_f8d1acbc:

    # MC "...Yes."
    MC "...是的。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1296
translate zh qst_JudgementDay_GoToCentreDist_f73fe119:

    # "The guards stiffened as her breath hitched."
    "她倒吸一口气，守卫们瞬间僵住了。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:1297
translate zh qst_JudgementDay_GoToCentreDist_4336e05e:

    # PRINCESS_CECILIA "You speak..."
    PRINCESS_CECILIA "你会说话..."

