# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:176
translate zh qst_JudgementDay_SiegeStart_4f76bcc4:

    # "With a sharp, breathless cry, he dropped to his knees, desperate to push his guts back into his stomach futilely."
