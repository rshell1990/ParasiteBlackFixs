    MARION @ angry "我反对这位证人的证词。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3084
translate zh qst_JudgementDay_TrialStart_SummonMenu_53e4fd5b:

