    VES @ smile "改天...再告诉你。"

# game/data/world_quests/main/Act1/JudgementDay/scr_JudgementDay_aio.rpy:3602
translate zh qst_JudgementDay_PostQuestArrivedToHamun_GuardMenu_f97d9bbc:

