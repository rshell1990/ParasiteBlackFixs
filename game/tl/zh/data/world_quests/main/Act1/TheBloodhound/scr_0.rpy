

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:2
translate zh qst_bloodhound_0_pitch_8a8224c2:

    # NYX @ talk "Well, looks like you can handle yourself at least."
    NYX @ talk "看来你至少能照顾好自己。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:3
translate zh qst_bloodhound_0_pitch_8c24fcd7:

    # NYX @ talk "I have another job for you, if you're still interested in a bit more coin that is."
    NYX @ talk "我这还有个活给你，如果你还对多赚点金币感兴趣的话。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:4
translate zh qst_bloodhound_0_pitch_42970179:

    # MC @ talk "Tell me about the job first."
    MC @ talk "先说说什么活。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:5
translate zh qst_bloodhound_0_pitch_cf6ed62f:

    # NYX @ talk "An informant of ours named Azul has gone missing and I can't spare the men to check on him."
    NYX @ talk "我们有个叫阿祖尔的线人失踪了，我抽不出人手去查看他的情况。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:7
translate zh qst_bloodhound_0_pitch_aa937f61:

    # NYX @ talk "The last time he made contact he was... {i}erratic.{/i}"
    NYX @ talk "他最后一次联系时...有点{i}疯疯癫癫{/i}。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:8
translate zh qst_bloodhound_0_pitch_fb490735:

    # NYX @ talk "I think he was on to something heavy, but now, no one can find him."
    NYX @ talk "我觉得他发现了什么不得了的事，但现在没人能找到他。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:9
translate zh qst_bloodhound_0_pitch_2aa577bc:

    # MC @ talk "Is he dead?"
    MC @ talk "他死了？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:10
translate zh qst_bloodhound_0_pitch_5ef3b5fb:

    # NYX @ shock "I hope not, he's one of our best."
    NYX @ shock "希望没有，他可是我们最得力的线人之一。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:11
translate zh qst_bloodhound_0_pitch_268c87af:

    # NYX @ talk "You can't miss him, he carries around that fucking bird on his shoulder wherever he goes..."
    NYX @ talk "你不可能认错他，他走到哪儿肩膀上总带着那只该死的鸟..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:12
translate zh qst_bloodhound_0_pitch_5498adaf:

    # NYX @ angry "Damn thing shit all over my desk once."
    NYX @ angry "那鬼东西有一次拉得我满桌子都是。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:13
translate zh qst_bloodhound_0_pitch_2f501b8f:

    # NYX @ talk "So... What do you say?"
    NYX @ talk "所以... 你怎么说？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:16
translate zh qst_bloodhound_0_pitch_260c1b2a:

    # NYX @ talk "Look, I have a limited fund I can spare on you, unlike {i}some{/i} divisions."
    NYX @ talk "听着，我能给你的经费有限，可不像{i}某些{/i}部门。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:17
translate zh qst_bloodhound_0_pitch_50c41c6b:

    # NYX @ talk "I don't have some infinite pool of coin and resources to pull from."
    NYX @ talk "我可没有取之不尽的金币和资源库。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:18
translate zh qst_bloodhound_0_pitch_2414a40b:

    # NYX @ talk "That said, you'll be paid well enough."
    NYX @ talk "话虽如此，报酬还是很丰厚的。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:19
translate zh qst_bloodhound_0_pitch_0e46659a:

    # NYX @ talk "How does five hundred coins sound?"
    NYX @ talk "五百金币怎么样？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:22
translate zh qst_bloodhound_0_pitch_1f41cbe0:

    # NYX @ talk "...Fine, six hundred coins and not coin more."
    NYX @ talk "...好吧，六百金币，一个子儿也不能再多了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:26
translate zh qst_bloodhound_0_pitch_004e4ebe:

    # NYX @ talk "I can't give you anything from the armory but, here, take these from my personal stash."
    NYX @ talk "军械库的东西我不能给你，不过，给，这些是我私人储备的。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:31
translate zh qst_bloodhound_0_pitch_fd5c4a81:

    # NYX @ laugh "Excellent."
    NYX @ laugh "很好。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:32
translate zh qst_bloodhound_0_pitch_529b6398:

    # NYX @ talk "There you go."
    NYX @ talk "给你。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:36
translate zh qst_bloodhound_0_pitch_d49b20da:

    # NYX @ angry "Don't waste my time, return when you've made up your mind."
    NYX @ angry "别浪费我的时间，想好了再来找我。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:41
translate zh qst_bloodhound_0_pitch_5c47a36b:

    # NYX @ talk "Last time Azul was seen, he was speaking to some Adventurers at the Guild."
    NYX @ talk "阿祖尔最后一次被看见是在公会里和一些冒险者交谈。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:42
translate zh qst_bloodhound_0_pitch_b8b70251:

    # NYX @ talk "Some small time D-listers, call themselves {i}The Guardians of the Realm...{/i}"
    NYX @ talk "几个三流角色，自称{i}王国守护者...{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_0.rpy:43
translate zh qst_bloodhound_0_pitch_3cc49680:

    # NYX @ angry "Pretentious cocksuckers, anyway, I'd start with them."
    NYX @ angry "一群装腔作势的傻逼，总之，我建议你从他们入手。"

