translate zh qst_bloodhound_2_camp_menu_8f187d87:

    # MC "(Hm? Why's this box been chained up?)"
    MC "(嗯？这箱子怎么锁着链子？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:23
translate zh qst_bloodhound_2_camp_menu_e0a8dfaa:

    # MC "(I could try tear it open... But I might damage whatever is inside.)"
    MC "(可以强行撬开... 但可能会损坏里面的东西。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:24
translate zh qst_bloodhound_2_camp_menu_27834b37:

    # MC "(Maybe I should try and find a key first?)"
    MC "(或许该先找找钥匙？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:28
translate zh qst_bloodhound_2_camp_menu_c356aa46:

