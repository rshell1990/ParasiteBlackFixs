    MC "(试试打开这个...)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:31
translate zh qst_bloodhound_2_camp_menu_5ce602f5:

    # MC "(This looks like a guild party sigil... It must be them!)"
    MC "(像是公会队伍的徽记... 肯定是他们！)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:32
translate zh qst_bloodhound_2_camp_menu_8de7d72a:

    # MC "(But... Where are they? There's nobody in sight.)"
    MC "(但是... 人呢？完全不见踪影。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:36
translate zh qst_bloodhound_2_camp_menu_cd3844b9:

    # MC "(An extinguished fire pit... Been dead for a while now.)"
    MC "(熄灭的篝火堆... 已经冷了很久。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:37
translate zh qst_bloodhound_2_camp_menu_07b572b5:

    # MC "(...Wait, there's something there in the pit!)"
    MC "(...等等，灰堆里有东西！)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:38
translate zh qst_bloodhound_2_camp_menu_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:39
translate zh qst_bloodhound_2_camp_menu_43190bbe:

    # MC "(A letter?)"
    MC "(一封信？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:40
translate zh qst_bloodhound_2_camp_menu_1031de16:

    # "{i}We've captured a baby slimelark as per the clients request, but the big one is getting more and more agitated.{/i}"
    "{i}按雇主需求捕获了幼年史莱姆，但成年体越来越狂躁了。{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:41
translate zh qst_bloodhound_2_camp_menu_4d7ce016:

    # "{i}...Managed to hold it at bay for now, but-{/i}"
    "{i}...目前还能勉强抵挡，但是——{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:42
translate zh qst_bloodhound_2_camp_menu_dac4dbf1:

    # MC "(The rest of it is burned beyond readability.)"
    MC "(剩余部分烧焦无法辨认。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:43
translate zh qst_bloodhound_2_camp_menu_6bf2865f:

    # MC "(I best stay away from the bank... For now at least.)"
    MC "(最好远离湖岸... 至少暂时如此。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:47
translate zh qst_bloodhound_2_camp_menu_c9614dee:

    # MC "(Let's move on.)"
    MC "(继续前进吧。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:56
translate zh qst_bloodhound_2_lake_openbox_9d3fcc85:

    # "As the lock dropped off the from the box, I opened it up to peer inside."
    "锁头从箱子上脱落，我打开箱子向内窥视。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:57
translate zh qst_bloodhound_2_lake_openbox_9ff2a2e4:

    # "Inside, a jar with an enchantment on it was filled with the slimelark-like substance."
    "箱内有个附魔的罐子，装满史莱姆般的胶质物。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:58
translate zh qst_bloodhound_2_lake_openbox_2302ca8f:

    # MC "(This is what they came for.)"
    MC "(这就是他们的目标。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:59
translate zh qst_bloodhound_2_lake_openbox_138ba29f:

    # MC "(A baby slimelark.)"
    MC "(史莱姆的幼体。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:60
translate zh qst_bloodhound_2_lake_openbox_a497c3f3:

    # MC "(Well, what should I do with it?)"
    MC "(该怎么处理它呢？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:63
translate zh qst_bloodhound_2_lake_openbox_b4080175:

    # "While what happened here was no doubt horrific, something about punishing the youngling felt wrong."
    "虽然现场惨状触目惊心，但惩罚幼崽总觉不妥。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:64
translate zh qst_bloodhound_2_lake_openbox_f3f2fecd:

    # "Even if it {i}was{/i} the offspring of a slimelark."
    "即便它{i}是{/i}史莱姆的后代。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:65
translate zh qst_bloodhound_2_lake_openbox_3fafabb6:

    # "With the jar in hand, I threw it straight into the lake, watching as it plumetted down with a splash."
    "我抓起罐子径直抛入湖中，看着它溅起水花沉入水底。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:68
translate zh qst_bloodhound_2_lake_openbox_407d78e6:

    # "Looking around at the horror inflicted by one of these beasts, I decided it was simply too much risk to keep it alive."
    "环视这头野兽制造的惨剧，我认定留它活口风险太大。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:69
translate zh qst_bloodhound_2_lake_openbox_f8ceeff3:

    # "It was young now... But it would grow up."
    "现在尚幼... 但终将长大。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:70
translate zh qst_bloodhound_2_lake_openbox_7f274017:

    # "Shattering the glass, the slimelark squealed in a death cry as I hacked away at the thing till it dissolved like its parent."
    "砸碎玻璃罐，史莱姆发出濒死尖啸。我持续劈砍直至它如亲代般溶解消散。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:74
translate zh qst_bloodhound_2_lake_openbox_927f5c91:

    # "For some strange reason, I felt compelled to take the jar with me."
    "出于某种莫名的冲动，我决定带走罐子。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:75
translate zh qst_bloodhound_2_lake_openbox_1a2610a5:

    # "Oddly, as I held up the jar to inspect it more, the colour of the slime briefly turned pink."
    "怪异的是，当我举起罐子细看时，粘液颜色忽然泛起粉红。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:76
translate zh qst_bloodhound_2_lake_openbox_94e3d87f:

    # "I thought for a moment I could hear a soft cooing sound from inside the jar, but after a few seconds more of inspection, the thing was silent again."
    "恍惚间似有轻柔咕噜声从罐中传出，但再凝神细听时，它又归于沉寂。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_2.rpy:78
translate zh qst_bloodhound_2_lake_openbox_156904e7:

    # MC "(I hope I don't end up regretting this.)"
    MC "(希望不会后悔这个决定。)"

