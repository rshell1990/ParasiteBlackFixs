# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:154
translate zh qst_bloodhound_4_hospital_nyxChoices_4b0c0176:

    # NYX @ angry "Perhaps as a warning... A message, in case that monster failed."
    NYX @ angry "也许是个警告...一个讯息，以防那怪物失手。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:155
translate zh qst_bloodhound_4_hospital_nyxChoices_4331e288:

