translate zh qst_bloodhound_4_hospital_nyxChoices_47394e6f:

    # "What kind of a person leaves a warning like {i}that?{/i}"
    "什么样的人会留下{i}那样的{/i}警告？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:157
translate zh qst_bloodhound_4_hospital_nyxChoices_91172795:

