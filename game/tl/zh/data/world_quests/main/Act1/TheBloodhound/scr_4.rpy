    NYX @ talk "无论阿祖尔发现了什么，都让他被某些{i}权势滔天{/i}的人物盯上了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:147
translate zh qst_bloodhound_4_hospital_nyxChoices_a0d4bfdb:

    # NYX @ talk "That thing didn't just kill him, it destroyed all of the sensitive information Azul had been gathering."
    NYX @ talk "那东西不仅杀了他，还销毁了阿祖尔收集的所有敏感信息。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:148
translate zh qst_bloodhound_4_hospital_nyxChoices_c1fe3b09:

    # NYX @ angry "Whatever he found, Azul got too close."
    NYX @ angry "无论他发现了什么，阿祖尔都靠得太近了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:149
translate zh qst_bloodhound_4_hospital_nyxChoices_a70e4233:

    # MC @ talk "...If that {i}thing{/i} had already killed Azul, why leave the body like that?"
    MC @ talk "...如果那个{i}东西{/i}已经杀了阿祖尔，为什么那样处理尸体？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:150
translate zh qst_bloodhound_4_hospital_nyxChoices_7eb21b6a:

    # MC @ talk "Why was the thing still down there... {i}waiting?{/i}"
    MC @ talk "为什么那东西还在下面...{i}等着？{/i}"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:151
translate zh qst_bloodhound_4_hospital_nyxChoices_19b37a1a:

    # NYX @ angry "I believe it was waiting {i}for me.{/i}"
    NYX @ angry "我相信它在等{i}我{/i}。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:152
translate zh qst_bloodhound_4_hospital_nyxChoices_0a6e91e3:

    # NYX @ angry "No doubt whoever is at play here knows of my involvement and would rather have me silenced."
    NYX @ angry "毫无疑问，幕后主使知道我的介入，更想让我永远闭嘴。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:153
translate zh qst_bloodhound_4_hospital_nyxChoices_a8914fff:

    # NYX @ angry "As for why the body was left there?"
