

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:2
translate zh qst_bloodhound_4_atFort_aed6965c:

    # "The next hour was a kind of blur as the mages dressed me and helped me stumble by way back towards Fort Sebastian."
    "接下来的一个小时一片模糊，法师们帮我穿上衣服，搀着我跌跌撞撞地返回塞巴斯蒂安要塞。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:6
translate zh qst_bloodhound_4_atFort_dbd56900:

    # "Brought into the Medical Ward, the nuns hurried over to treat me alongside the influx of other poor bastards."
    "被送进医疗病房后，修女们匆忙赶来救治我，同时涌入的还有其他倒霉的家伙们。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:9
translate zh qst_bloodhound_4_atFort_6af63c0b:

    # "Here and there I noticed were a few Scouts."
    "我注意到零星躺着几名侦察兵。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:10
translate zh qst_bloodhound_4_atFort_5d3a3559:

    # "Battered, broken, some had limbs missing."
    "遍体鳞伤，支离破碎，有些人缺胳膊少腿。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:11
translate zh qst_bloodhound_4_atFort_7327635b:

    # "Laying beside them, I remembered how I hoped never to end up here again."
    "躺在他们身边时，我想起自己曾发誓再也不要回到这种地方。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:12
translate zh qst_bloodhound_4_atFort_b0c99eb3:

    # "Yet, here I was."
    "然而，我还是来了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:16
translate zh qst_bloodhound_4_atFort_08507bf0:

    # "Captain 妮克斯 spoke to some of the Nuns."
    "妮克斯上尉正在和几位修女交谈。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:20
translate zh qst_bloodhound_4_atFort_3357746f:

    # "As I struggled to stay awake, I couldn't focus on what was being said..."
    "当我挣扎着保持清醒时，完全听不清他们在说什么..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:24
translate zh qst_bloodhound_4_atFort_1c58eea8:

    # "At some point, one of the nuns came to see me and fed me some holly sap for the pain."
    "后来，一位修女过来看我，喂我喝了些冬青汁缓解疼痛。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:28
translate zh qst_bloodhound_4_atFort_217b2342:

    # "Since my {i}change{/i}, I hadn't experienced pain like this."
    "自从{i}蜕变{/i}以来，我还从未经历过这样的痛苦。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:32
translate zh qst_bloodhound_4_atFort_32efdd9d:

    # "Every muscle ached as I felt numerous broken bones inside me struggling to mend."
    "每块肌肉都在疼痛，我能感觉到体内多处断裂的骨头正艰难地愈合。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:36
translate zh qst_bloodhound_4_atFort_fc7016e4:

    # MC "(What happened back there?)"
    MC "(刚才到底发生了什么？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:37
translate zh qst_bloodhound_4_atFort_e7f55388:

    # MC "(Shit shit! How in all the damn hells did she know about me?)"
    MC "(该死！她到底怎么知道我的事的？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:38
translate zh qst_bloodhound_4_atFort_0422337d:

    # MC "(Urghh... Why is the healing taking so long?)"
    MC "(呃啊...为什么恢复得这么慢？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:39
translate zh qst_bloodhound_4_atFort_78cfcf79:

    # BLACK "The effects of the poison are still active within our bloodstream."
    BLACK "毒素仍在我们血液中发挥作用。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:40
translate zh qst_bloodhound_4_atFort_6f610828:

    # MC "(That thing it... {i}It nearly killed us{/i}.)"
    MC "(那东西...{i}差点杀了我们{/i}。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:41
translate zh qst_bloodhound_4_atFort_4ba8b71c:

    # BLACK "Yes."
    BLACK "是的。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:42
translate zh qst_bloodhound_4_atFort_10d9725d:

    # MC "(But how? I thought we were like, nearly impossible to kill or something!)"
    MC "(但怎么会？我以为我们几乎不可能被杀死！)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:43
translate zh qst_bloodhound_4_atFort_0be017dd:

    # BLACK "This assessment is incorrect."
    BLACK "这个判断是错误的。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:44
translate zh qst_bloodhound_4_atFort_14f01e94:

    # MC "(What? Well... We've handled everything until now!)"
    MC "(什么？可是...我们之前明明应付了所有情况！)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:45
translate zh qst_bloodhound_4_atFort_f1fae085:

    # BLACK "Our battle form is durable but {i}not invincible{/i}, there are no doubt plenty of beings capable of killing us."
    BLACK "战斗形态虽然坚韧，但{i}并非无敌{/i}，毫无疑问存在许多能杀死我们的存在。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:46
translate zh qst_bloodhound_4_atFort_cc99b660:

    # MC "(Well, there goes my power fantasy I guess.)"
    MC "(好吧，我的力量幻想破灭了。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:47
translate zh qst_bloodhound_4_atFort_5e79a34e:

    # BLACK "The battle form, like all abilities, must be nurtured to develop."
    BLACK "战斗形态如同所有能力，必须通过培养才能成长。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:48
translate zh qst_bloodhound_4_atFort_c7d003c0:

    # MC "(You mean like, I have to train more?)"
    MC "(你的意思是，我需要更多训练？)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:49
translate zh qst_bloodhound_4_atFort_e6b63194:

    # BLACK "Yes, your body will adapt and evolve to handle greater threats."
    BLACK "是的，你的身体会适应并进化以应对更大的威胁。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:50
translate zh qst_bloodhound_4_atFort_f7a97492:

    # MC "(Great... That's something at least.)"
    MC "(好吧...至少这算是个盼头。)"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:52
translate zh qst_bloodhound_4_atFort_17a87d51:

    # "The thought of facing that {i}thing{/i} again filled me with dread."
    "想到要再次面对那个{i}东西{/i}，我就充满恐惧。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:53
translate zh qst_bloodhound_4_atFort_339483ae:

    # "As the holly sap took effect, I drifted off to sleep, haunted by the images of it's horrible face charging towards me."
    "随着冬青汁生效，我渐渐入睡，但那张恐怖的脸向我冲来的画面萦绕在脑海。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:60
translate zh qst_bloodhound_4_atFort_b88fb49b:

    # "Towards {i}us{/i}."
    "向着{i}我们{/i}冲来。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:65
translate zh qst_bloodhound_4_atFort_0cf7c79e:

    # "A few hours later..."
    "几小时后..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:77
translate zh qst_bloodhound_4_atFort_9efa6cee:

    # NYX @ shock "Feeing alright?"
    NYX @ shock "感觉还好吗？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:79
translate zh qst_bloodhound_4_atFort_b8905269:

    # MC @ talk "Yeah... Never better."
    MC @ talk "嗯...再好不过了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:80
translate zh qst_bloodhound_4_atFort_359034a0:

    # NYX @ talk "You look like shit."
    NYX @ talk "你看起来糟透了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:81
translate zh qst_bloodhound_4_atFort_dfbe28ad:

    # MC @ talk "Well, I feel like shit so..."
    MC @ talk "是啊，我感觉糟透了所以..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:83
translate zh qst_bloodhound_4_atFort_b9fc5142:

    # "Captain 妮克斯 forced a faint smile before nodding softly."
    "妮克斯上尉挤出一丝勉强的微笑，轻轻点了点头。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:84
translate zh qst_bloodhound_4_atFort_b01b2cf5:

    # NYX @ talk "I suppose you've got questions."
    NYX @ talk "我想你有很多问题要问。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:85
translate zh qst_bloodhound_4_atFort_291c5b81:

    # MC @ talk "Damn right."
    MC @ talk "一点没错。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:90
translate zh qst_bloodhound_4_hospital_nyxChoices_e4ee6136:

    # NYX @ talk "I've had you both followed since your return."
    NYX @ talk "从你们回来后，我就派人跟踪了你们俩。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:91
translate zh qst_bloodhound_4_hospital_nyxChoices_edb6a0a6:

    # MC @ surprised "What?"
    MC @ surprised "什么？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:92
translate zh qst_bloodhound_4_hospital_nyxChoices_27426e03:

    # NYX @ angry "When you and your friend returned, under the circumstances you did, I didn't buy that you just strolled your way back to Novaras in record time."
    NYX @ angry "当你们俩以那种状态回来时，我才不信你们能优哉游哉地以破纪录的速度走回诺瓦拉斯。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:93
translate zh qst_bloodhound_4_hospital_nyxChoices_b21889a2:

    # NYX @ angry "At first, I considered you being Demorai spies."
    NYX @ angry "起初，我怀疑你们是德莫莱的间谍。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:94
translate zh qst_bloodhound_4_hospital_nyxChoices_6004d9d1:

    # NYX @ talk "So, I called in some favors and had you followed."
    NYX @ talk "所以我动用了些人情，派人跟踪你们。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:95
translate zh qst_bloodhound_4_hospital_nyxChoices_9e1a4c12:

    # MC @ angry "Why not just tell me!"
    MC @ angry "为什么不直接告诉我！"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:96
translate zh qst_bloodhound_4_hospital_nyxChoices_b1ccbf77:

    # NYX @ talk "I needed to test where your loyalties laid."
    NYX @ talk "我需要测试你的忠诚度。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:97
translate zh qst_bloodhound_4_hospital_nyxChoices_c5e54f3e:

    # NYX @ laugh "Oh, and the whole strolling into the desert to change thing? Not very smart."
    NYX @ laugh "哦，还有大摇大摆走进沙漠变身那事？可不太聪明。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:98
translate zh qst_bloodhound_4_hospital_nyxChoices_bae1966c:

    # NYX @ angry "Did you really think heading out there wasn't going to draw some attention?"
    NYX @ angry "你真以为去那儿不会引起注意？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:99
translate zh qst_bloodhound_4_hospital_nyxChoices_2221d04f:

    # NYX @ talk "You're going to need to learn to be smarter than that."
    NYX @ talk "你得学着更聪明点。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:100
translate zh qst_bloodhound_4_hospital_nyxChoices_98840fbf:

    # MC @ angry "You used me."
    MC @ angry "你利用了我。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:101
translate zh qst_bloodhound_4_hospital_nyxChoices_c9fb01dc:

    # NYX @ angry "This is war, you'll get used to being used."
    NYX @ angry "这是战争，你会习惯被利用的。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:105
translate zh qst_bloodhound_4_hospital_nyxChoices_9310a365:

    # NYX @ talk "I have no idea."
    NYX @ talk "我完全不清楚。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:106
translate zh qst_bloodhound_4_hospital_nyxChoices_811b6a5f:

    # MC @ talk "What?"
    MC @ talk "什么？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:107
translate zh qst_bloodhound_4_hospital_nyxChoices_1b3b6fcb:

    # NYX @ shock "I knew Azul was onto something big but... I didn't anticipate that."
    NYX @ shock "我知道阿祖尔在追查大事...但没料到是这种东西。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:108
translate zh qst_bloodhound_4_hospital_nyxChoices_d155dda6:

    # NYX @ angry "All of Azul's private documents and scrolls have been taken, no doubt destroyed."
    NYX @ angry "阿祖尔所有的私人文件和卷轴都被拿走了，肯定已被销毁。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:112
translate zh qst_bloodhound_4_hospital_nyxChoices_564cd451:

    # NYX @ shock "...I'm sorry, I predicted there might be a trap waiting for whoever I sent."
    NYX @ shock "...抱歉，我预料到我派去的人可能会遭遇陷阱。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:113
translate zh qst_bloodhound_4_hospital_nyxChoices_1a9930c7:

    # NYX @ talk "I knew that, with your abilities, you had a better chance handling whatever was thrown at you."
    NYX @ talk "我知道以你的能力，更有机会应付任何突发状况。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:114
translate zh qst_bloodhound_4_hospital_nyxChoices_c34a59ad:

    # NYX @ talk "But I still made sure to tail you, I couldn't be sure for whatever was waiting and expected the worst."
    NYX @ talk "但我还是安排了跟踪，因为无法确定会遭遇什么，做好了最坏打算。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:115
translate zh qst_bloodhound_4_hospital_nyxChoices_1efaa6b8:

    # MC @ talk "Could have done better with you about five minutes earlier into the fight."
    MC @ talk "要是你能早五分钟加入战斗就好了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:116
translate zh qst_bloodhound_4_hospital_nyxChoices_6442fbae:

    # NYX @ angry "We moved as quickly as we could without drawing attention."
    NYX @ angry "我们已在不引起注意的前提下尽快行动了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:120
translate zh qst_bloodhound_4_hospital_nyxChoices_230bd269:

    # NYX @ talk "No."
    NYX @ talk "不会。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:121
translate zh qst_bloodhound_4_hospital_nyxChoices_2d204a49:

    # MC "..."
    MC "..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:122
translate zh qst_bloodhound_4_hospital_nyxChoices_69710195:

    # NYX @ talk "You're a valuable asset, and I'm fairly confident now whose side you're on."
    NYX @ talk "你是宝贵的资产，而且我现在很确定你站在哪边。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:123
translate zh qst_bloodhound_4_hospital_nyxChoices_e9e95609:

    # NYX @ angry "That said, others may not feel the same."
    NYX @ angry "不过，其他人可能不这么想。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:124
translate zh qst_bloodhound_4_hospital_nyxChoices_bb396a64:

    # MC @ talk "So... No one else knows?"
    MC @ talk "所以...没有其他人知道？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:125
translate zh qst_bloodhound_4_hospital_nyxChoices_8e345629:

    # NYX @ talk "Your secret is still safe."
    NYX @ talk "你的秘密依然安全。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:126
translate zh qst_bloodhound_4_hospital_nyxChoices_27b1a111:

    # MC @ talk "But, the inquisitors-"
    MC @ talk "但是，审判官们——"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:127
translate zh qst_bloodhound_4_hospital_nyxChoices_543f491c:

    # NYX @ angry "Fuck the inquisitors."
    NYX @ angry "去他妈的审判官。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:128
translate zh qst_bloodhound_4_hospital_nyxChoices_078ca3b0:

    # NYX @ angry "And fuck Lukkan and the others."
    NYX @ angry "还有卢坎和其他那些混蛋也一样。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:129
translate zh qst_bloodhound_4_hospital_nyxChoices_e295341a:

    # NYX @ angry "The city Watch needs all the help it can get, and none of those fuckers are willing to lift a damn finger to help if it involves pulling from their precious sectors."
    NYX @ angry "城市守卫需要一切能得到的帮助，而那些混蛋只要涉及他们宝贵辖区的人力，就他妈的连根手指头都不愿动。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:130
translate zh qst_bloodhound_4_hospital_nyxChoices_3ff61c69:

    # NYX @ talk "I may call upon you again, for help."
    NYX @ talk "我可能还会需要你的帮助。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:131
translate zh qst_bloodhound_4_hospital_nyxChoices_0466bb7a:

    # NYX @ angry "You may be one of the only few in this wretched city I actually know I can trust."
    NYX @ angry "你可能是这座该死的城市里，我真正确定能信任的少数人之一。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:134
translate zh qst_bloodhound_4_hospital_nyxChoices_0f796eb3:

    # MC @ talk "I'm done with questions..."
    MC @ talk "我没有问题了..."

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:135
translate zh qst_bloodhound_4_hospital_nyxChoices_310c3340:

    # MC @ talk "What now?"
    MC @ talk "现在怎么办？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:136
translate zh qst_bloodhound_4_hospital_nyxChoices_c93cf8f4:

    # NYX @ talk "Not much, you go back to doing whatever it is you were doing before."
    NYX @ talk "没什么特别的，回去做你之前在做的事吧。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:137
translate zh qst_bloodhound_4_hospital_nyxChoices_8d9965eb:

    # MC @ talk "But... The investigation?"
    MC @ talk "但是...调查呢？"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:138
translate zh qst_bloodhound_4_hospital_nyxChoices_d08d005d:

    # NYX @ talk "Not your responsibility anymore."
    NYX @ talk "不再是你的责任了。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:139
translate zh qst_bloodhound_4_hospital_nyxChoices_e5b291a8:

    # NYX @ talk "At least, until I can do some more digging into what Azul found."
    NYX @ talk "至少，在我能进一步深挖阿祖尔发现了什么之前是这样。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:141
translate zh qst_bloodhound_4_hospital_nyxChoices_83b8fbc8:

    # MC @ talk "...That {i}thing.{/i}"
    MC @ talk "...那个{i}东西{/i}。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:142
translate zh qst_bloodhound_4_hospital_nyxChoices_df7f4b5b:

    # NYX @ talk "Returned to its master, no doubt."
    NYX @ talk "无疑已回到它的主人身边。"

# game/data/world_quests/main/Act1/TheBloodhound/scr_4.rpy:143
translate zh qst_bloodhound_4_hospital_nyxChoices_4bcd9b36:

    # MC @ talk "{i}Master?{/i} You mean-"
