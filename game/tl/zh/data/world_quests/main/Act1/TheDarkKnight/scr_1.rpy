translate zh qst_DarkKnight_1_atCaptainNyxOfficeInProg_e0648fef:

    # NYX @ talk"Yes? Did you do as I asked?"
    NYX @ talk "嗯？按我说的做了吗？"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:148
