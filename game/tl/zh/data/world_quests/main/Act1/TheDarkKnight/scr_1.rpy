translate zh qst_DarkKnight_1_atCaptainNyxOfficeRevisit_a2ca27cc:

    # NYX @ talk "Yeah, I need you to patrol the streets at night."
    NYX @ talk "对，我需要你夜间在街上巡逻。"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:130
translate zh qst_DarkKnight_1_atCaptainNyxOfficeRevisit_36b1eb9b:

    # NYX @ talk "Deal with at least three bandit groups."
    NYX @ talk "解决至少三伙强盗。"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:131
translate zh qst_DarkKnight_1_atCaptainNyxOfficeRevisit_83e60d6b:

    # NYX @ talk "So... Can I count on you with this?"
    NYX @ talk "那么...这事我能指望你吗？"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:134
translate zh qst_DarkKnight_1_atCaptainNyxOfficeRevisit_a949c99b:

    # NYX @ laugh "Finally, someone useful around here."
    NYX @ laugh "终于来了个有用的人。"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:135
translate zh qst_DarkKnight_1_atCaptainNyxOfficeRevisit_3fda12e3:

    # NYX @ talk "Good, I look forward to hearing your progress."
    NYX @ talk "很好，我期待听到你的进展。"

# game/data/world_quests/main/Act1/TheDarkKnight/scr_1.rpy:141
translate zh qst_DarkKnight_1_atCaptainNyxOfficeRevisit_16f82085:

    # NYX @ angry "Well don't think too long, either you do it, or I have to find some other idiot to fill in for you."
    NYX @ angry "别想太久，要么你干，要么我找别的蠢货顶替你。"

