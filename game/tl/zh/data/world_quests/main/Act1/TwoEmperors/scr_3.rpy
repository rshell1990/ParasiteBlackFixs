    "刚进城，我就听到身后传来盔甲碰撞的声响。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:31
translate zh qst_TwoEmperors_3_guardDebrief_9ff1ce7e:

    # GUARD "The Emperor wishes to speak to you."
    GUARD "皇帝陛下要见你。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:32
translate zh qst_TwoEmperors_3_guardDebrief_b932b683:

    # GUARD "Right away."
    GUARD "立刻。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:33
translate zh qst_TwoEmperors_3_guardDebrief_fcfd1a28:

