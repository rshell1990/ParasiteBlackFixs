    MC @ think "皇帝？"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:34
translate zh qst_TwoEmperors_3_guardDebrief_d695d013:

    # MC @ talk "But, I'm supposed to report to-"
    MC @ talk "但我应该向——"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:35
translate zh qst_TwoEmperors_3_guardDebrief_195911eb:

    # GUARD "The Emperor wishes to hear your report directly."
    GUARD "陛下要亲自听取你的汇报。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:36
translate zh qst_TwoEmperors_3_guardDebrief_9b85a882:

    # MC @ talk "Where is he?"
    MC @ talk "他在哪儿？"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:37
translate zh qst_TwoEmperors_3_guardDebrief_d5d543cb:

    # GUARD "He is waiting in Captain 妮克斯的 Office."
    GUARD "他在妮克斯队长的办公室等候。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:38
translate zh qst_TwoEmperors_3_guardDebrief_3f907879:

    # GUARD "He requests you come immediately."
    GUARD "要求你即刻前往。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:39
translate zh qst_TwoEmperors_3_guardDebrief_f0b76b43:

    # MC "Well, lead the way then."
    MC "那就带路吧。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:43
translate zh qst_TwoEmperors_3_guardDebrief_7dc379c8:

    # "Upon entering Captain 妮克斯的 Office, she was in a fierce mood as she argued with the stoic Emperor."
    "走进妮克斯队长的办公室时，她正情绪激动地与面无表情的皇帝争论。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:51
translate zh qst_TwoEmperors_3_guardDebrief_fabade8f:

    # NYX @ angry "I have no more men to pull! My resources are stretched thin as it is!"
    NYX @ angry "我没人可调了！资源已经捉襟见肘！"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:52
translate zh qst_TwoEmperors_3_guardDebrief_d544e067:

    # ALCOTT @ talk "Did Lukkan not send you that someone from the Adventurers Guild?"
    ALCOTT @ talk "卢坎没给你派冒险者公会的人吗？"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:53
translate zh qst_TwoEmperors_3_guardDebrief_f42166ff:

    # ALCOTT @ talk "Did he not succeed in his tasks as instructed?"
    ALCOTT @ talk "他没按要求完成任务？"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:54
translate zh qst_TwoEmperors_3_guardDebrief_413a23ba:

    # NYX @ angry "Y-Yes!"
    NYX @ angry "完-完成了！"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:55
translate zh qst_TwoEmperors_3_guardDebrief_b6e613a3:

    # NYX @ angry "But it was a band wrap solution to a gaping wound!"
    NYX @ angry "但这只是给撕裂伤贴创可贴！"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:56
translate zh qst_TwoEmperors_3_guardDebrief_3783ce75:

    # NYX @ angry "I need {i}more{/i} men to keep this city under control! Not less!"
    NYX @ angry "我需要{i}更多{/i}人手控制城市！而不是更少！"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:57
translate zh qst_TwoEmperors_3_guardDebrief_1f135222:

    # ALCOTT @ talk "Then I will pull some lower tier Adventurers from their quests to assist you for a few months till the situation settles."
    ALCOTT @ talk "那我就抽调些低阶冒险者暂停任务来帮你，直到局势稳定。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:58
translate zh qst_TwoEmperors_3_guardDebrief_85d58729:

    # ALCOTT @ talk "But for now, it's far more important some of your men are posted elsewhere."
    ALCOTT @ talk "但眼下更重要的是把你部分人手调往他处。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:59
translate zh qst_TwoEmperors_3_guardDebrief_381ff1e6:

    # "Captain 妮克斯 stared in disbelief."
    "妮克斯队长难以置信地瞪大眼睛。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:60
translate zh qst_TwoEmperors_3_guardDebrief_33ced028:

    # NYX @ shock "...{i}The Adventurers Guild?{/i}"
    NYX @ shock "...{i}冒险者公会？{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:61
translate zh qst_TwoEmperors_3_guardDebrief_f0d187ab:

    # NYX @ angry "Emperor... Please, I need trained men."
    NYX @ angry "陛下... 求您了，我需要训练有素的士兵。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:62
translate zh qst_TwoEmperors_3_guardDebrief_570f78ed:

    # NYX @ angry "Not a bunch of undisciplined mercenaries!"
    NYX @ angry "不是一群散漫的雇佣兵！"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:63
translate zh qst_TwoEmperors_3_guardDebrief_95a85796:

    # ALCOTT @ angry "Captain 妮克斯, you will follow orders whether you like them or not, are we clear?"
    ALCOTT @ angry "妮克斯队长，无论你是否愿意都必须服从命令，明白吗？"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:64
translate zh qst_TwoEmperors_3_guardDebrief_b1118b3b:

    # NYX "...Yes... Emperor."
    NYX "...是... 陛下。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:65
translate zh qst_TwoEmperors_3_guardDebrief_9dc3c60d:

    # NYX "My apologies for my conduct."
    NYX "我为我的失态道歉。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:66
translate zh qst_TwoEmperors_3_guardDebrief_e64ef127:

    # "The Emperor finally turned to notice me stood waiting in the doorway."
    "皇帝终于转身注意到我站在门口等候。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:67
translate zh qst_TwoEmperors_3_guardDebrief_98335569:

    # ALCOTT @ talk "Ah, there you are."
    ALCOTT @ talk "啊，你来了。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:68
translate zh qst_TwoEmperors_3_guardDebrief_a29f96a6:

    # ALCOTT @ talk "Captain 妮克斯, you are dismissed."
    ALCOTT @ talk "妮克斯队长，你可以退下了。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:69
translate zh qst_TwoEmperors_3_guardDebrief_2bf3e2d4:

    # NYX @ shock "But this is my-"
    NYX @ shock "但这是我的——"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:70
translate zh qst_TwoEmperors_3_guardDebrief_67f093d8:

    # ALCOTT @ angry "I would speak with my man now, {i}alone.{/i}"
    ALCOTT @ angry "我要和我的手下{i}单独{/i}谈谈。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:71
translate zh qst_TwoEmperors_3_guardDebrief_a73acec6:

    # ALCOTT @ angry "You are dismissed, Captain 妮克斯."
    ALCOTT @ angry "退下吧，妮克斯队长。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:72
translate zh qst_TwoEmperors_3_guardDebrief_93c383a5:

    # NYX "...Very well, Emperor."
    NYX "...遵命，陛下。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:73
translate zh qst_TwoEmperors_3_guardDebrief_8ade1e4a:

    # "Captain 妮克斯 after bringing her fist against her chest in a salute, turned to leave."
    "妮克斯队长握拳捶胸行礼后，转身离开。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:78
translate zh qst_TwoEmperors_3_guardDebrief_ed969e90:

    # "As she passed by me, we both shared a knowing glance as the guards closed the door behind her."
    "她经过我身边时，我们交换了一个心照不宣的眼神，随后守卫关上了门。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:81
translate zh qst_TwoEmperors_3_guardDebrief_bbda2531:

    # ALCOTT @ talk "So, what news do you bring?"
    ALCOTT @ talk "那么，带来了什么消息？"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:82
translate zh qst_TwoEmperors_3_guardDebrief_a6fe90e1:

    # ALCOTT @ talk "And where is your friend? I had the two of you sent."
    ALCOTT @ talk "你朋友呢？我派了你们两人同去。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:83
translate zh qst_TwoEmperors_3_guardDebrief_c2e57570:

    # MC @ talk "He's fine, just... Perhaps a little shaken by what we saw."
    MC @ talk "他没事，只是... 可能被所见之事吓到了。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:84
translate zh qst_TwoEmperors_3_guardDebrief_6125bb1e:

    # "Alcott raised an eyebrow at the comment, waiting on me to elaborate."
    "阿尔科特闻言挑眉，等我详细说明。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:86
translate zh qst_TwoEmperors_3_guardDebrief_caa1b21f:

    # "After relaying the events to him to the best of my knowledge..."
    "在我尽己所能向他叙述事件经过后..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:93
translate zh qst_TwoEmperors_3_guardDebrief_8e5b9894:

    # ALCOTT @ talk "...Hmm, I see."
    ALCOTT @ talk "...嗯，明白了。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:94
translate zh qst_TwoEmperors_3_guardDebrief_515de8c1:

    # ALCOTT @ talk "So another major offensive is likely being planned soon."
    ALCOTT @ talk "看来很快会有另一场大规模进攻。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:95
translate zh qst_TwoEmperors_3_guardDebrief_6bddee75:

    # ALCOTT @ talk "It is as I feared."
    ALCOTT @ talk "果然如我所料。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:96
translate zh qst_TwoEmperors_3_guardDebrief_82fa4775:

    # MC @ think "Uhh, you don't seem very surprised."
    MC @ think "呃，你似乎并不惊讶。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:97
translate zh qst_TwoEmperors_3_guardDebrief_e896e76d:

    # ALCOTT @ talk "That's because I'm not."
    ALCOTT @ talk "因为确实不惊讶。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:98
translate zh qst_TwoEmperors_3_guardDebrief_cda1b98f:

    # ALCOTT @ talk "I've known for quite some time about their dark {i}Emperor.{/i}"
    ALCOTT @ talk "我早就知道他们有个黑暗{i}帝王{/i}。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:99
translate zh qst_TwoEmperors_3_guardDebrief_a65f726f:

    # "I felt my heart sink into my stomach, turning pale white as I took a step back in disbelief."
    "我的心沉到谷底，难以置信地后退一步，脸色惨白。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:100
translate zh qst_TwoEmperors_3_guardDebrief_406e523a:

    # "They knew... After all these years of telling us the Demorai were nothing more than savage monsters of primitive mind, {i}they knew the truth.{/i}"
    "他们知道... 多年来一直宣称德莫莱只是原始野蛮的怪物，{i}他们却知道真相{/i}。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:101
translate zh qst_TwoEmperors_3_guardDebrief_b431e554:

    # MC @ surprised "You... {i}You knew?{/i}"
    MC @ surprised "你... {i}你早就知道？{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:102
translate zh qst_TwoEmperors_3_guardDebrief_d7350415:

    # MC @ surprised "But... The Demorai... They're not supposed to be-"
    MC @ surprised "但... 德莫莱... 他们不该是——"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:103
translate zh qst_TwoEmperors_3_guardDebrief_2851dedb:

    # ALCOTT @ angry "As far as most people are concerned, the Demorai are just savage beasts ready to rip and tear."
    ALCOTT @ angry "对多数人而言，德莫莱只是随时会撕碎猎物的野蛮野兽。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:104
translate zh qst_TwoEmperors_3_guardDebrief_e7ea30f8:

    # ALCOTT @ talk "It is best for everyone's sake we keep it that way."
    ALCOTT @ talk "维持这种认知对所有人都有利。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:105
translate zh qst_TwoEmperors_3_guardDebrief_e22de872:

    # ALCOTT @ talk "Muddying the waters only invites unnecessary divisive discussions."
    ALCOTT @ talk "混淆视听只会引发无谓的分裂性争论。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:110
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_8b289247:

    # ALCOTT @ talk "It is a soft lie that the Demorai are unintelligible savages."
    ALCOTT @ talk "说德莫莱是愚昧野蛮人只是个善意的谎言。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:111
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_dc64c7cf:

    # ALCOTT @ angry "Make no mistake, intelligent or not, their only goal is to see our destruction."
    ALCOTT @ angry "别搞错，无论是否智慧，他们的目标只有毁灭我们。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:112
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_1eaa1316:

    # ALCOTT @ talk "We must keep that {i}ethical debate{/i} door shut, for questioning our means will only lead us astray."
    ALCOTT @ talk "必须关上{i}道德辩论{/i}的大门，质疑手段只会让我们误入歧途。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:113
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_509e5fae:

    # ALCOTT @ talk "We must focus on military victory only; we cannot afford to be distracted and risk dividing ourselves further."
    ALCOTT @ talk "必须专注于军事胜利；我们经不起分心，更不能冒险加剧内部分裂。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:116
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_136c0ac1:

    # ALCOTT @ joy "Ha!"
    ALCOTT @ joy "哈！"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:117
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_3b36fad1:

    # ALCOTT @ angry "Listen to me now, and listen good, boy."
    ALCOTT @ angry "现在听好，小子，给我仔细听。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:118
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_832d1377:

    # ALCOTT @ talk "The Demorai have zero interest in any sort of {i}negotiations{/i} while their 'Emperor' rules over them."
    ALCOTT "只要他们的'帝王'还在统治，德莫莱对任何{i}谈判{/i}都毫无兴趣。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:119
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_0a615b3b:

    # MC @ talk "But why? Why are they doing all this?"
    MC @ talk "但为什么？他们为何要这么做？"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:120
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_5ada5ffe:

    # ALCOTT @ talk "Even I do not know that..."
    ALCOTT @ talk "连我自己也不清楚..."

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:121
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_a5ca9e15:

    # ALCOTT @ talk "But I know for us there is no seat for us at any negotiations table."
    ALCOTT @ talk "但我知道谈判桌上不会有我们的位置。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:122
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_b9e9e364:

    # ALCOTT @ talk "We are no more to them than vermin that need to be wiped out."
    ALCOTT @ talk "在他们眼里我们只是待清除的害虫。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:124
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_f3683e6e:

    # ALCOTT @ talk "I don't have all day, so speak quickly."
    ALCOTT @ talk "我没时间耗，有话快说。"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:128
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_e5d688df:

    # ALCOTT "{i}*Sigh*{/i}"
    ALCOTT "{i}*叹气*{/i}"

# game/data/world_quests/main/Act1/TwoEmperors/scr_3.rpy:129
translate zh qst_TwoEmperors_3_guardDebrief_rootMenu_73773068:

