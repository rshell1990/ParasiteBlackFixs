    "当亚里克迈步上前时，守卫拦住了他。"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1870
translate zh qst_TheBeastOfNovaras_ZanzibatHouse_ed310237:

    # GUARD "Not you."
    GUARD "不是你。"

