translate zh qst_TheBeastOfNovaras_ZanzibatHouse_e4e67f64:

    # GUARD "{i}Him.{/i}"
    GUARD "{i}是他。{/i}"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1872
translate zh qst_TheBeastOfNovaras_ZanzibatHouse_539c85ab:

