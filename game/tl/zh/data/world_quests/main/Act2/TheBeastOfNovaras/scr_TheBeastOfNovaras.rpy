# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1820
translate zh qst_TheBeastOfNovaras_ReturnToYarrickAfterCaltrack_yarrickreturntalk_700053ef:

    # MC @ surprised "Really?"
    MC @ surprised "真的？"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1821
translate zh qst_TheBeastOfNovaras_ReturnToYarrickAfterCaltrack_yarrickreturntalk_c417cba1:

