    REGINA @ sad "我一直都在这里为你，现在也是如此。"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1368
translate zh qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_5f85dca9:

