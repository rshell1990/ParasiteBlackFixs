# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1336
translate zh qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_7884caad:

    # REGINA "...Poor, sweet baby."
    REGINA "...可怜又可爱的孩子。"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1342
translate zh qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_d41c0b74:

    # "My eyes open, and I find myself back home in my bedroom, the fire lit as I look around."
    "我睁开双眼，发现自己回到了家中的卧室，炉火燃着，我环顾四周。"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1343
translate zh qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_9f9545d0:

