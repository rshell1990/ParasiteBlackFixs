    "只有希法露出了得意的笑容。"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1325
translate zh qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_298515e0:

    # "And just like that, the power snapped out of me as control returned."
    "就在那时，力量从我体内抽离，控制权回归。"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1331
