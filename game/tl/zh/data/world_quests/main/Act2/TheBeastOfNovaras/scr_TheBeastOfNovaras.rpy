    MC @ angry "省省你的担心吧。"

# game/data/world_quests/main/Act2/TheBeastOfNovaras/scr_TheBeastOfNovaras.rpy:1354
translate zh qst_TheBeastOfNovaras_FlashbackOverCaltrackFinish_6c557f09:

