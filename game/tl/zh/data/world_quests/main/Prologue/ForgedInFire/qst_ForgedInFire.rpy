translate zh qst_ForgedInFire_TalkKiaraSuicidePill_96a5b6d5:

    # KIARA @ scared "You mean, {i}you don't have them?{/i}"
    KIARA @ scared "你是说，{i}你没有这东西？{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:251
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_a06c0c45:

    # MC @ think "Have what?"
    MC @ think "没有什么？"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:252
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_d88a130f:

    # KIARA @ sad "...I suppose it makes sense they'd only give these to the women."
    KIARA @ sad "...看来他们只给女性发这个是有道理的。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:253
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_7807f448:

    # "My thoughts naturally gravitated towards it being some type of contraceptive, but from 琪亚拉的 deathly face, I got the impression this was something else entirely..."
    "我自然想到这是某种避孕药，但琪亚拉死灰般的脸色让我感觉这完全是另一回事..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:254
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_2f447204:

    # MC @ talk "What is it?"
    MC @ talk "到底是什么？"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:255
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_bf3a5617:

    # KIARA @ sad "{i}Poison.{/i}"
    KIARA @ sad "{i}毒药。{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:256
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_1024ba5b:

    # MC @ scared "Poison?"
    MC @ scared "毒药？"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:257
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_11458c35:

    # KIARA @ sad "Yes... Poison."
    KIARA @ sad "对...毒药。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:258
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_b621a53b:

    # KIARA @ sad "You see, the Demorai will likely just kill men on sight."
    KIARA @ sad "你看，德莫莱人可能见到男人就直接杀掉。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:259
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_2ae75f60:

    # "There was a long pause before she spoke again."
    "她沉默了许久才再次开口。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:260
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_1a69e9d1:

    # KIARA @ sad "...But, if they know it's a woman, then-"
    KIARA @ sad "...但如果他们知道是女人，那么——"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:261
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_0eb7df76:

    # "琪亚拉 let the sentence trail off into nothing as her eyes looked up to meet mine."
    "琪亚拉的话音逐渐消失，她抬眼与我对视。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:262
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_de58e436:

    # MC @ talk "...I see."
    MC @ talk "...我明白了。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:263
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_dfe507b5:

    # "Clearly uncomfortable with the thought, 琪亚拉 put the poisoned vial around her neck away."
    "显然对这个想法感到不适，琪亚拉收起了挂在脖子上的毒药瓶。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:264
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_a7d48f38:

    # KIARA "Well, I best get back to it."
    KIARA "好吧，我得回去了。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:265
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_dcdb40a3:

    # MC @ talk "...琪亚拉."
    MC @ talk "...琪亚拉。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:266
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_17362382:

    # KIARA "Hm?"
    KIARA "嗯？"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:267
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_d772a6ab:

    # MC @ talk "I don't know how, but..."
    MC @ talk "我不知道怎么做，但是..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:268
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_c54f2fa9:

    # MC @ talk "We're gonna survive this somehow, I promise."
    MC @ talk "我们总会活下去的，我保证。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:269
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_8ac203f7:

