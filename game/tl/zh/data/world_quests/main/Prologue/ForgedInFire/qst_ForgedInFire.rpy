translate zh qst_ForgedInFire_TalkKiaraSuicidePill_b69d3c76:

    # "The girl looked at me."
    "女孩看向我。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:239
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_54cef13c:

    # KIARA "Yeah?"
    KIARA "有事？"

