translate zh qst_ForgedInFire_TalkKiaraSuicidePill_9a55b3f3:

    # "She paused quizzically, as if I asked her to recite the entire pantheon of the old Alderian gods..."
    "她困惑地停顿了一下，仿佛我让她背诵整个奥尔德古神谱系..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:243
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_2af745ee:

    # KIARA "Oh, I'm 琪亚拉, sorry, it's just, this..."
    KIARA "哦，我叫琪亚拉，抱歉，只是这个..."

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:247
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_abf0dbd1:

    # "琪亚拉 glanced at the trinket in her hand."
    "琪亚拉瞥了一眼手中的挂饰。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:248
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_693376bc:

    # MC @ talk "What's that?"
    MC @ talk "这是什么？"

