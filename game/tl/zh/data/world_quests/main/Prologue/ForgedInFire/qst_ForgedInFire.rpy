    "琪亚拉笑了。"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:271
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_8f992da3:

    # KIARA @ happy "Bloody optimist, aren't ya?"
    KIARA @ happy "真是个死乐观派，是吧？"

# game/data/world_quests/main/Prologue/ForgedInFire/qst_ForgedInFire.rpy:273
translate zh qst_ForgedInFire_TalkKiaraSuicidePill_ac511b10:

    # "琪亚拉 left with a smile on her face."
    "琪亚拉面带微笑离开了。"

