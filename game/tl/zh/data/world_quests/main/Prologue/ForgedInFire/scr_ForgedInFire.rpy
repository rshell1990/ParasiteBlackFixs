translate zh qst_ForgedInFire_Training2Teamwork_repBattle_4c68b6fe:

    # MARKUS "Come on guys, remember what Duprey said!"
    MARKUS "来吧伙计们，记住杜普雷的话！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:813
translate zh qst_ForgedInFire_Training2Teamwork_repBattle_072ed379:

    # MARKUS "Be a single force!"
    MARKUS "凝聚成整体！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:814
translate zh qst_ForgedInFire_Training2Teamwork_repBattle_7e6c58ca:

    # "His teammate interrupted:"
    "他的队友插话："

