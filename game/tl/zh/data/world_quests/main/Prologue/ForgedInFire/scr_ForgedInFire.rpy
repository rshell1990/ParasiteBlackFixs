    MARKUS "...管他呢！来，再打一轮！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:821
translate zh qst_ForgedInFire_Training2Teamwork_repBattle_2af51c90:

    # MARKUS "That's what I like to hear!"
    MARKUS "我就爱听这话！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:822
translate zh qst_ForgedInFire_Training2Teamwork_repBattle_102beb74:

