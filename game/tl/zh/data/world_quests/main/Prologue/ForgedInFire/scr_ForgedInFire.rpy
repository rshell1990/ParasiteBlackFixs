translate zh qst_ForgedInFire_Training2NightEvent_2b146927:

    # NYX_BLONDE @ shock "{i}Echo crystals?{/i}"
    NYX_BLONDE @ shock "{i}回音水晶？{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:920
translate zh qst_ForgedInFire_Training2NightEvent_c7cc2c81:

