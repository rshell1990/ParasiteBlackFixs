    KIARA @ scared "但是... {i}怎么会？{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:282
translate zh qst_ForgedInFire_AtTrainingYard_9fcae072:

