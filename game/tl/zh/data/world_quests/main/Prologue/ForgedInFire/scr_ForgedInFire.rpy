translate zh qst_ForgedInFire_Training2NightEvent_1d99c218:

    # "While the blonde seemed saddened to hear this, the larger man opened his palm upwards towards the sky."
    "金发女子面露哀伤，魁梧男子却向天摊开手掌。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:943
translate zh qst_ForgedInFire_Training2NightEvent_c246e162:

    # LUKKAN_THE_BIG_GUY @ talk "I hope you didn't drag us out here to discuss your future retirement plans you old fuck."
    LUKKAN_THE_BIG_GUY @ talk "希望你不是为退休计划把老子拖出来挨冻，老东西。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:944
translate zh qst_ForgedInFire_Training2NightEvent_dd633049:

    # DUPREY "Hmph..."
    DUPREY "哼..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:945
translate zh qst_ForgedInFire_Training2NightEvent_07d9c1a1:

    # DUPREY "Officer Borras, hand them the reports."
    DUPREY "博拉斯军官，把报告给他们。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:946
translate zh qst_ForgedInFire_Training2NightEvent_85fc15c1:

    # BORRAS @ talk "Yes Captain."
    BORRAS @ talk "是，队长。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:948
translate zh qst_ForgedInFire_Training2NightEvent_a550ea4e:

    # "Borras handed over a few sheets of paper towards the robed pair."
    "博拉斯将几页文件递给长袍二人组。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:949
translate zh qst_ForgedInFire_Training2NightEvent_e077ed9f:

    # LUKKAN_THE_BIG_GUY @ talk "What's this?"
    LUKKAN_THE_BIG_GUY @ talk "这是什么？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:950
translate zh qst_ForgedInFire_Training2NightEvent_cbb0024b:

    # DUPREY "A report that Alcott attempted to suppress."
    DUPREY "阿尔科特试图压制的报告。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:951
translate zh qst_ForgedInFire_Training2NightEvent_0873ff5f:

    # LUKKAN_THE_BIG_GUY @ think "About?"
    LUKKAN_THE_BIG_GUY @ think "关于什么？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:952
translate zh qst_ForgedInFire_Training2NightEvent_dfb5dc62:

    # DUPREY "...{...{i}Zanarak has returned.{/i}"
    DUPREY "...{i}扎纳拉克回来了。{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:953
translate zh qst_ForgedInFire_Training2NightEvent_dbf78d30:

    # "A great unease filled the air and I felt a shiver tingle it's way up my spine."
    "强烈的不安弥漫空中，我脊背窜过一阵寒意。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:954
translate zh qst_ForgedInFire_Training2NightEvent_506be64d:

    # "The name crawled and dragged its way horribly across my thoughts."
    "这个名字阴森地爬进我的脑海。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:955
translate zh qst_ForgedInFire_Training2NightEvent_04766be0:

    # LUKKAN_THE_BIG_GUY @ happy "There hasn't been a sighting in years."
    LUKKAN_THE_BIG_GUY @ happy "多年未有目击报告了。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:956
translate zh qst_ForgedInFire_Training2NightEvent_ad6d35ce:

    # NYX_BLONDE @ talk "Wasn't it reported that the beast was hunted down by the Inquisition?"
    NYX_BLONDE @ talk "不是有报告说异端审判庭猎杀了那怪物吗？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:957
translate zh qst_ForgedInFire_Training2NightEvent_cbbee22b:

    # DUPREY "A lie told to ease panicking nobles."
    DUPREY "安抚恐慌贵族的谎言。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:959
translate zh qst_ForgedInFire_Training2NightEvent_78892759:

    # DUPREY "The beast's return... changes things."
    DUPREY "这野兽的归来...改变了一切。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:960
translate zh qst_ForgedInFire_Training2NightEvent_7a86413b:

    # LUKKAN_THE_BIG_GUY @ talk "A specter, a boogeyman..."
    LUKKAN_THE_BIG_GUY @ talk "幽灵，吓小孩的怪物..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:961
translate zh qst_ForgedInFire_Training2NightEvent_a777b442:

    # LUKKAN_THE_BIG_GUY @ talk "There are dozens of Demorai over the years that people have wrongly mistaken for being Zanarak."
    LUKKAN_THE_BIG_GUY @ talk "多年来有几十个德莫莱被误认为扎纳拉克。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:962
translate zh qst_ForgedInFire_Training2NightEvent_086782c0:

    # "The man belligerently crossed his arms."
    "男子挑衅地抱起双臂。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:963
translate zh qst_ForgedInFire_Training2NightEvent_ee8e9a7d:

    # LUKKAN_THE_BIG_GUY @ talk "...I'm not even convinced this Zanarak was real to begin with."
    LUKKAN_THE_BIG_GUY @ talk "...我甚至怀疑扎纳拉克是否真实存在。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:964
translate zh qst_ForgedInFire_Training2NightEvent_8ebb0762:

    # DUPREY "Oh... He's as real as you and I alright."
    DUPREY "呵...它真实得如同你我。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:965
translate zh qst_ForgedInFire_Training2NightEvent_ba99ad23:

    # DUPREY "Make no mistake about that."
    DUPREY "这点毋庸置疑。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:966
translate zh qst_ForgedInFire_Training2NightEvent_6b72d9c8:

    # DUPREY "...And when he comes, all of us need to be prepared."
    DUPREY "...当它降临时，我们都必须做好准备。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:967
translate zh qst_ForgedInFire_Training2NightEvent_2bce0fc0:

    # DUPREY "With, {i}or without{/ without} the Emperors knowledge."
    DUPREY "无论皇帝{i}知情与否{/i}。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:968
translate zh qst_ForgedInFire_Training2NightEvent_3cdbebf1:

    # NYX_BLONDE @ angry "What are you saying, Duprey?"
    NYX_BLONDE @ angry "你什么意思，杜普雷？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:969
translate zh qst_ForgedInFire_Training2NightEvent_59e5864b:

    # DUPREY "I'm saying, Alcott can bury his head in the fucking sand and play politics all he wants to try and appease wet-fart nobles."
    DUPREY "我是说，阿尔科特尽可当缩头乌龟玩政治游戏，讨好那些放屁都带水声的贵族。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:970
translate zh qst_ForgedInFire_Training2NightEvent_fcc3f2c9:

    # DUPREY "{i}But we need to be prepared for what's to come whether this knowledge is made public or not.{/i}"
    DUPREY "{i}但无论消息是否公开，我们都必须为即将来临的灾难做好准备。{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:971
translate zh qst_ForgedInFire_Training2NightEvent_18e7a24a:

    # NYX_BLONDE @ talk "Duprey... You need to tread carefully with this."
    NYX_BLONDE @ talk "杜普雷...此事需万分谨慎。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:972
translate zh qst_ForgedInFire_Training2NightEvent_5b839082:

    # NYX_BLONDE @ talk "How exactly did {i}you{/i} manage to get your hands on this report anyway?"
    NYX_BLONDE @ talk "你究竟如何弄到这份报告的？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:973
translate zh qst_ForgedInFire_Training2NightEvent_a2aca459:

    # BORRAS @ talk "By pure chance."
    BORRAS @ talk "纯属偶然。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:974
translate zh qst_ForgedInFire_Training2NightEvent_a174e1ce:

    # "Borras stepped forward."
    "博拉斯上前一步。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:975
translate zh qst_ForgedInFire_Training2NightEvent_913c0dc3:

    # BORRAS @ talk "I was on a normal patrol through the Valley of Death when I stumbled upon a small, slaughtered convoy."
    BORRAS @ talk "我在死亡谷例行巡逻时，发现一支遭屠杀的小型车队。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:976
translate zh qst_ForgedInFire_Training2NightEvent_787647a3:

    # BORRAS @ talk "Amongst their dead was an Inquisitor, who with his dying breath handed me this report."
    BORRAS @ talk "死者中有位审判官，临终时递给我这份报告。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:977
translate zh qst_ForgedInFire_Training2NightEvent_a7d9dd7a:

    # LUKKAN_THE_BIG_GUY @ talk "The dying words of a delusional Inquisitor on death's door mean very little."
    LUKKAN_THE_BIG_GUY @ talk "将死审判官的胡话不足为信。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:978
translate zh qst_ForgedInFire_Training2NightEvent_46254da9:

    # BORRAS @ talk "There was other reports..."
    BORRAS @ talk "还有其他报告..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:979
translate zh qst_ForgedInFire_Training2NightEvent_f3335e6e:

    # LUKKAN_THE_BIG_GUY @ think "What?"
    LUKKAN_THE_BIG_GUY @ think "什么？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:980
translate zh qst_ForgedInFire_Training2NightEvent_825a1215:

    # BORRAS @ talk "Suppressed as soon as they arrive, but more and more scant reports from our men on the fringes have reported seeing it."
    BORRAS @ talk "报告送达即被压制，但前线士兵的零星目击报告越来越多。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:981
translate zh qst_ForgedInFire_Training2NightEvent_0d7eadc0:

    # "Both the woman and man were troubled the more they heard."
    "两人听得越多，神色越凝重。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:982
translate zh qst_ForgedInFire_Training2NightEvent_f2428e23:

    # DUPREY "From now on, the three of us need to work closer together."
    DUPREY "从今往后，我们三人需紧密合作。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:983
translate zh qst_ForgedInFire_Training2NightEvent_a899d6c2:

    # NYX_BLONDE @ angry "The city guard is barely holding on as it is, what exactly do you expect me to do?"
    NYX_BLONDE @ angry "城防军已自身难保，你指望我能做什么？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:984
translate zh qst_ForgedInFire_Training2NightEvent_b10a0545:

    # DUPREY "Whatever you have to do when the time comes."
    DUPREY "事到临头时该做的一切。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:985
translate zh qst_ForgedInFire_Training2NightEvent_6afc1660:

    # "Duprey seemed to be working himself up into a feverish plea."
    "杜普雷情绪激动得近乎狂热。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:986
translate zh qst_ForgedInFire_Training2NightEvent_104f25e1:

    # DUPREY "These little camps everyone's set up is leaving us more divided than ever, it'll be the ruin of us all!"
    DUPREY "各自为政的小团体让我们四分五裂，这会毁了我们所有人！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:987
translate zh qst_ForgedInFire_Training2NightEvent_2e21a987:

    # DUPREY "We need to unite and pledge to each other that when the time comes-"
    DUPREY "我们必须团结立誓，当那一刻降临时——"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:988
translate zh qst_ForgedInFire_Training2NightEvent_59c8c819:

    # LUKKAN_THE_BIG_GUY @ talk "I promise you nothing, Duprey."
    LUKKAN_THE_BIG_GUY @ talk "我不会承诺任何事，杜普雷。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:989
translate zh qst_ForgedInFire_Training2NightEvent_e629b28d:

    # "The broad man's words cut through Duprey's like ice."
    "魁梧男子的话语如冰刃刺穿杜普雷的恳求。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:990
translate zh qst_ForgedInFire_Training2NightEvent_b4c2c3b7:

    # LUKKAN_THE_BIG_GUY @ talk "...But I shall look into these reports myself."
    LUKKAN_THE_BIG_GUY @ talk "...但我会亲自调查这些报告。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:991
translate zh qst_ForgedInFire_Training2NightEvent_ebf4078c:

    # LUKKAN_THE_BIG_GUY @ talk "And depending on what I find, {i}perhaps{/i} there will be more to discuss."
    LUKKAN_THE_BIG_GUY @ talk "根据调查结果，{i}或许{/i}还有讨论余地。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:992
translate zh qst_ForgedInFire_Training2NightEvent_e102cb4c:

    # "The broad man turned to leave, and as he did so, Captain Duprey looked towards the woman."
    "魁梧男子转身离去，杜普雷队长看向女子。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:993
translate zh qst_ForgedInFire_Training2NightEvent_6ff2487b:

    # NYX_BLONDE @ sad "... I don't know, Duprey, this just maybe isn't the right time."
    NYX_BLONDE @ sad "...我不知道，杜普雷，现在可能时机不对。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:994
translate zh qst_ForgedInFire_Training2NightEvent_ece5bef6:

    # NYX_BLONDE @ sad "The more we unite our forces, the more we paint ourselves a target for the other factions."
    NYX_BLONDE @ sad "我们越团结力量，就越会成为其他派系的靶子。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:995
translate zh qst_ForgedInFire_Training2NightEvent_f5cdc275:

    # DUPREY "... I don't care about the factions."
    DUPREY "...我不在乎派系。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:996
translate zh qst_ForgedInFire_Training2NightEvent_361df80b:

    # DUPREY "I don't care about the politics of the damn thing."
    DUPREY "我他妈不在乎政治游戏。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:997
translate zh qst_ForgedInFire_Training2NightEvent_538b8cf8:

    # DUPREY "What does any of that matter if there's no one left in the end?"
    DUPREY "若最终无人幸存，这些还有什么意义？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:998
translate zh qst_ForgedInFire_Training2NightEvent_c7e9daac:

    # DUPREY "Newheart is gone... There's no one left to save us but ourselves now."
    DUPREY "纽哈特已逝...如今能拯救我们的只有自己。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:999
translate zh qst_ForgedInFire_Training2NightEvent_0e94a49a:

    # NYX_BLONDE @ sad "...Goodnight, Duprey."
    NYX_BLONDE @ sad "...晚安，杜普雷。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1000
translate zh qst_ForgedInFire_Training2NightEvent_2d5676a4:

    # NYX_BLONDE @ sad "I hope you're wrong about all this... I really do."
    NYX_BLONDE @ sad "愿你所说皆是虚妄...真心希望如此。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1001
translate zh qst_ForgedInFire_Training2NightEvent_3bff260d:

    # "The woman turned to leave and join the broad man, broad man, leaving Captain Duprey to stand beside Officer Borras alone."
    "女子转身离去，加入魁梧男子的行列，留下杜普雷队长与博拉斯军官孑然而立。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1005
translate zh qst_ForgedInFire_Training2NightEvent_9b060e61:

    # "As the two figures passed me by, I hid myself behind a barrel and waited for them to be out of sight."
    "当两人经过时，我藏身木桶后等待他们消失。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1009
translate zh qst_ForgedInFire_Training2NightEvent_d553e83d:

    # BORRAS @ talk "Captain..."
    BORRAS @ talk "队长..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1010
translate zh qst_ForgedInFire_Training2NightEvent_eba06326:

    # DUPREY "Return to your quarters, Borras."
    DUPREY "回营房去，博拉斯。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1011
translate zh qst_ForgedInFire_Training2NightEvent_6fa2cda7:

    # DUPREY "Speak nothing of what has been said tonight."
    DUPREY "今夜所言不得外传。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1012
translate zh qst_ForgedInFire_Training2NightEvent_f9c712a9:

    # BORRAS @ sad "But-"
    BORRAS @ sad "可是——"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1013
translate zh qst_ForgedInFire_Training2NightEvent_87e8ae86:

    # DUPREY "I'm tired Borras... So very tired."
    DUPREY "我累了，博拉斯...精疲力竭。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1014
translate zh qst_ForgedInFire_Training2NightEvent_0ae2d5a5:

    # DUPREY "The next battle can wait for another day."
    DUPREY "下一场战斗改日再说。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1017
translate zh qst_ForgedInFire_Training2NightEvent_a5187100:

    # "Slowly, I watched as Captain Duprey slumped towards the barracks, likely back to his quarters."
    "我目送杜普雷队长蹒跚走向营房，应是返回住处。"

# game/data/world_quests_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1019
translate zh qst_ForgedInFire_Training2NightEvent_e034c8e5:

    # MC "(Zanarak... Can it really be?)"
    MC "(扎纳拉克...这竟是真的？)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1021:translate zh qst_ForgedInFire_Training2NightEvent_97d93231:

    # "I shook my head, pushing the terrible thoughts away."
    "我摇头驱散可怕念头。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1022
translate zh qst_ForgedInFire_Training2NightEvent_d2897e6b:

    # MC "(I need to return to my bed, before someone sees me.)"
    MC "(得在被发现前回床铺去。)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1028
translate zh qst_ForgedInFire_Training2NightEvent_97284131:

    # "As I laid down onto the bed, dark, terrible thoughts and dreams returned."
    "躺回床铺时，黑暗的思绪与梦魇再度袭来。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1029
translate zh qst_ForgedInFire_Training2NightEvent_af180033:

    # "Returned to torment me for the rest of the night."
    "整夜折磨着我。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1047
translate zh qst_ForgedInFire_Training3Final_eb24fb27:

    # DUPREY "Alright maggots, today I will see whether you lot have made any progress or had you just wasted my time!"
    DUPREY "听着，蛆虫们！今天我要看看你们是长进了还是浪费老子时间！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1048
translate zh qst_ForgedInFire_Training3Final_884243ea:

    # DUPREY "We will start with duels first!"
    DUPREY "从对决开始！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1049
translate zh qst_ForgedInFire_Training3Final_62189e19:

    # DUPREY "Partner up, grab yourself a healing vial, and fight as if your life depended on it!"
    DUPREY "组队！拿好治疗药水！像拼命一样战斗！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1054
translate zh qst_ForgedInFire_Training3Final_761342c6:

    # MC "Shit got real, huh?"
    MC "动真格了啊？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1055
translate zh qst_ForgedInFire_Training3Final_67044540:

    # "马库斯 was certainly not going to fool around this time."
    "这次马库斯显然不会手下留情。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1057
translate zh qst_ForgedInFire_Training3Final_bc95234e:

    # MC @ angry "Alright, bring it on then!"
    MC @ angry "好，放马过来！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1080
translate zh qst_ForgedInFire_Training3Final_Lose_1263e952:

    # "Ouch."
    "呃啊。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1081
translate zh qst_ForgedInFire_Training3Final_Lose_c58b41a1:

    # "Darkness."
    "黑暗。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1082
translate zh qst_ForgedInFire_Training3Final_Lose_8f6cd72d:

    # "Then, dim light telling shapes apart."
    "接着，微光勾勒出轮廓。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1083
translate zh qst_ForgedInFire_Training3Final_Lose_ce93bfa4:

    # "A vision."
    "幻象。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1084
translate zh qst_ForgedInFire_Training3Final_Lose_a05d37f2:

    # "A vision of Alderay under demonic onslaught."
    "恶魔肆虐下的奥尔德雷。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1085
translate zh qst_ForgedInFire_Training3Final_Lose_f32b1941:

    # "Of me, defending it's people."
    "我守护着它的人民。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1086
translate zh qst_ForgedInFire_Training3Final_Lose_27cd56c1:

    # "Uniting them under my banners."
    "在我的旗帜下团结一致。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1087
translate zh qst_ForgedInFire_Training3Final_Lose_63b84b20:

    # "Power."
    "力量。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1088
translate zh qst_ForgedInFire_Training3Final_Lose_008f17f9:

    # "Wealth."
    "财富。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1090
translate zh qst_ForgedInFire_Training3Final_Lose_b6ce6190:

    # "However, there is something else."
    "但还有别的东西。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1091
translate zh qst_ForgedInFire_Training3Final_Lose_8bf4ebd2:

    # "Something that drives me onwards, something from outside..."
    "某种驱使我前进的东西，来自外部的某种力量..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1092
translate zh qst_ForgedInFire_Training3Final_Lose_90b93b6a:

    # "It's..."
    "那是..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1095
translate zh qst_ForgedInFire_Training3Final_Lose_d1df3db6:

    # "Ice-cold water!"
    "冰冷刺骨的水！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1102
translate zh qst_ForgedInFire_Training3Final_Lose_bc5c4518:

    # DUPREY "{b}ON YOUR FEET, MAGGOT!{/b}"
    DUPREY "{b}给我站起来，废物！{/b}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1103
translate zh qst_ForgedInFire_Training3Final_Lose_5ad11caa:

    # "Captain Duprey's heavy kick quickly stood me up straight, recent knockout echoing in my head with an irritating, pulsing pain."
    "杜普雷上尉狠狠一脚让我瞬间站直，刚才被击昏的记忆在脑中回荡，带来恼人的阵阵抽痛。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1104
translate zh qst_ForgedInFire_Training3Final_Lose_e7a57264:

    # DUPREY "Go again, Demorai won't wait for you to come back to your senses!"
    DUPREY "再来！德莫莱人可不会等你清醒过来！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1105
translate zh qst_ForgedInFire_Training3Final_Lose_032e9f26:

    # MC "(Gotta get a grip...)"
    MC "(必须振作起来...)"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1106
translate zh qst_ForgedInFire_Training3Final_Lose_523ecf6e:

    # DUPREY @ angry "I'm trying to be nice to you maggot, now go again!"
    DUPREY @ angry "老子对你够客气了，废物！现在再来！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1118
translate zh qst_ForgedInFire_FinalSparring_Complete_6a4925e0:

    # MARKUS "Gah! You sure know how to make it hurt!"
    MARKUS "啊！你还真知道怎么让人疼！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1119
translate zh qst_ForgedInFire_FinalSparring_Complete_0fb6a986:

    # MC "{i}*Huff*{/i} Someone’s had to knock some sense into you!"
    MC "{i}*喘气*{/i} 总得有人把你打醒！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1120
translate zh qst_ForgedInFire_FinalSparring_Complete_66516ca5:

    # "As me and 马库斯 caught our breath, I noticed an unusual figure dressed in fine fabrics speaking to the Captain."
    "当我和马库斯喘着气时，我注意到一个身着华服的不寻常身影正在和上尉交谈。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1121
translate zh qst_ForgedInFire_FinalSparring_Complete_163ee6d6:

    # "The Captain seemed unimpressed with whatever the man was saying and seemed to be refusing him something before being handed what seemed like a very official looking letter."
    "上尉似乎对那人的话不以为然，像是在拒绝什么要求，直到对方递来一封看起来非常正式的信函。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1122
translate zh qst_ForgedInFire_FinalSparring_Complete_783e0863:

    # "I thought I could make out the royal seal."
    "我依稀辨认出那是皇家印章。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1123
translate zh qst_ForgedInFire_FinalSparring_Complete_edb3c6df:

    # "I couldn’t hear what was being said, but I managed to figure out the words escaping his lips, {i}‘They’re not ready yet!’{/i}"
    "我听不清谈话内容，但勉强读懂了从他唇间迸出的字眼：{i}‘他们还没准备好！’{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1124
translate zh qst_ForgedInFire_FinalSparring_Complete_7e66af39:

    # MARKUS "What’s going on?"
    MARKUS "怎么回事？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1125
translate zh qst_ForgedInFire_FinalSparring_Complete_28993885:

    # "I nudged him to look over towards Duprey."
    "我用胳膊肘碰了碰他，示意他看向杜普雷那边。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1126
translate zh qst_ForgedInFire_FinalSparring_Complete_78c93499:

    # MARKUS "... Is that someone from the palace?"
    MARKUS "...那是宫里来的人？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1127
translate zh qst_ForgedInFire_FinalSparring_Complete_6da37e5e:

    # MC "I think so."
    MC "我想是的。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1128
translate zh qst_ForgedInFire_FinalSparring_Complete_c390d19a:

    # MARKUS "Since when did the palace send its fancy officials down to us mud and grunts?"
    MARKUS "宫里那些花里胡哨的官员什么时候会屈尊来我们这群泥腿子这儿了？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1129
translate zh qst_ForgedInFire_FinalSparring_Complete_d52535a2:

    # MARKUS "What do you think they want? It must be serious."
    MARKUS "你觉得他们想干嘛？肯定没好事。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1130
translate zh qst_ForgedInFire_FinalSparring_Complete_67965d23:

    # MC "I don’t know... but I don’t think it’s going to be anything good."
    MC "不知道...但肯定不是什么好事。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1136
translate zh qst_ForgedInFire_FinalSparring_Complete_452c6b58:

    # "All of a sudden, the Captain heaved himself reluctantly onto the wooden platform and cried out for our attention."
    "突然，上尉不情愿地登上木台，高声命令我们集合。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1137
translate zh qst_ForgedInFire_FinalSparring_Complete_4074b31d:

    # DUPREY "FORM RANKS!"
    DUPREY "列队！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1139
translate zh qst_ForgedInFire_FinalSparring_Complete_7bdc104e:

    # "The tired and weary Scouts hastily moved to form neat rows and face the Captain, hanging on his every word."
    "疲惫不堪的侦察兵们匆忙排成整齐队列面向上尉，屏息凝神等待他的命令。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1140
translate zh qst_ForgedInFire_FinalSparring_Complete_d0187a8e:

    # DUPREY "We have been ordered have been ordered on early leave for a mission."
    DUPREY "我们接到命令提前结束训练执行任务。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1141
translate zh qst_ForgedInFire_FinalSparring_Complete_af5fac36:

    # "Confused mutterings swept through the ranks, as most of us expected the training to last for months."
    "队伍中响起困惑的低语，大多数人原以为训练将持续数月。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1142
translate zh qst_ForgedInFire_FinalSparring_Complete_41c2d6b4:

    # DUPREY "SILENCE!!!"
    DUPREY "肃静！！！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1143
translate zh qst_ForgedInFire_FinalSparring_Complete_219c5f53:

    # DUPREY "This order has come down has come down from Emperor Alcott himself and has been approved by King Mesamor."
    DUPREY "此令由阿尔科特皇帝陛下亲自下达，并获梅萨莫尔国王批准。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1144
translate zh qst_ForgedInFire_FinalSparring_Complete_8b792546:

    #:

    DUPREY "明日破晓时分出发。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1145
translate zh qst_ForgedInFire_FinalSparring_Complete_0fa47cd9:

    # DUPREY "Get to bed early, make sure you’re well fed and be absolutely certain that your equipment is clean and ready."
    DUPREY "今晚早睡，确保吃饱喝足，武器装备必须擦拭干净准备就绪。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1146
translate zh qst_ForgedInFire_FinalSparring_Complete_cae6e8d4:

    # "A timid hand was raised from the crowd."
    "人群中怯生生地举起一只手。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1147
translate zh qst_ForgedInFire_FinalSparring_Complete_c2e2d792:

    # DUPREY "What is it?"
    DUPREY "什么事？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1149
translate zh qst_ForgedInFire_FinalSparring_Complete_13b24539:

    # RECRUIT "Where are we to be sent to be sent, sir?"
    RECRUIT "长官，我们要被派往何处？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1150
translate zh qst_ForgedInFire_FinalSparring_Complete_544b0d7d:

    # DUPREY "The mission is top secret, all I can tell you is that you will be recovering relics from a lost fortress south of here."
    DUPREY "任务属最高机密，我只能告诉你们要去此地南方一处失落堡垒回收遗物。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1151:1152
translate zh qst_ForgedInFire_FinalSparring_Complete_0ac7589b:

    # DUPREY "Expect at least six weeks march, take this into consideration with your prep."
    DUPREY "预计至少六周行军，准备物资时务必考虑这点。"
    DUPREY "解散！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1155
translate zh qst_ForgedInFire_FinalSparring_Complete_8cfa9b03:

    # "With that, the Captain stormed his way off stage, angrily shoving the sealed letter back into the fumbling hands of the palace official before stalking back to his quarters."
    "说罢，上尉怒气冲冲走下台，将密封信函粗暴地塞回手忙脚乱的宫廷官员手中，随即大步流星走回营房。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1156
translate zh qst_ForgedInFire_FinalSparring_Complete_fa69c2ee:

    # "The men soon dissolved the ranks and the process of packing up for our departure began."
    "士兵们迅速解散，开始为出发打点行装。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1162
translate zh qst_ForgedInFire_FinalSparring_Complete_73d9be9c:

    # "There was much confused chatter about what this {i}‘secret mission’{/i} entailed, and more so the worry of now being confronted by the Demorai so clearly unprepared."
    "关于{i}‘秘密任务’{/i}的困惑议论四起，更多人则担忧要以如此准备不足的状态直面德莫莱人。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1163
translate zh qst_ForgedInFire_FinalSparring_Complete_d33077f7:

    # MARKUS "What the fuck was all that about?"
    MARKUS "这他妈到底怎么回事？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1164
translate zh qst_ForgedInFire_FinalSparring_Complete_07f11245:

    # MC "I don’t know, looks like some higher up bullshit to me."
    MC "谁知道，我看就是高层搞的鬼把戏。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1165
translate zh qst_ForgedInFire_FinalSparring_Complete_3e0ef9c5:

    # MC "Guess we'll be skipping the test then..."
    MC "看来考核要跳过了..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1166
translate zh qst_ForgedInFire_FinalSparring_Complete_52b2a82f:

    # MARKUS "Hm... I’ll make sure to pack some extra bread for you, okay?"
    MARKUS "嗯...我会多给你带些面包，行吧？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1167
translate zh qst_ForgedInFire_FinalSparring_Complete_f6d7e7b6:

    # MC "Where’d you get the extra rations from, you fancy fuck?"
    MC "你从哪儿搞的额外口粮，骚包？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1168
translate zh qst_ForgedInFire_FinalSparring_Complete_a1c732d3:

    # MARKUS "My brother sent it to me the other day, figured we could split it..."
    MARKUS "我哥前几天寄来的，想着可以分你点..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1169
translate zh qst_ForgedInFire_FinalSparring_Complete_ce4a9c8a:

    # MC "Oh, thank you."
    MC "哦，谢了。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1170
translate zh qst_ForgedInFire_FinalSparring_Complete_7ff3445a:

    # MARKUS "In return I want some of that sweet wine you got!"
    MARKUS "作为回报我要喝你藏的好酒！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1171
translate zh qst_ForgedInFire_FinalSparring_Complete_95e59f81:

    # MC "What?!"
    MC "什么？！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1173
translate zh qst_ForgedInFire_FinalSparring_Complete_8b5596df:

    # MC "Alright, alright, {i}we’ll share.{/i}"
    MC "行行行，{i}分你一半。{/i}"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1174
translate zh qst_ForgedInFire_FinalSparring_Complete_31c038e0:

    # MARKUS "That’s more like it!"
    MARKUS "这还差不多！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1175
translate zh qst_ForgedInFire_FinalSparring_Complete_fbd1034e:

    # MARKUS "Didn’t want to have to bust your balls the whole trip if I die of dehydration because you wouldn’t spare {i}‘a single drop’{/i} for your dearest and oldest friend!"
    MARKUS "我可不想因为你对最亲的老友{i}‘一滴都不给’{/i}害我渴死，然后全程听你哭丧！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1176
translate zh qst_ForgedInFire_FinalSparring_Complete_9f87cee2:

    # MC "But then how would I achieve my dream of becoming a drunk?"
    MC "不然我怎么实现当酒鬼的梦想？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1177
translate zh qst_ForgedInFire_FinalSparring_Complete_957e6607:

    # MARKUS "I have every confidence that you’ll find a way, no matter what."
    MARKUS "我坚信你总有办法达成目标。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1179
translate zh qst_ForgedInFire_FinalSparring_Complete_a370dbb4:

    # "Suddenly, the ginger haired girl strutted over to us, a coy little smile on her face."
    "突然，红发女孩昂首走来，脸上挂着狡黠的微笑。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1180
translate zh qst_ForgedInFire_FinalSparring_Complete_d469bfc4:

    # KIARA "Looks like I’ve been partnered up with you two for the march."
    KIARA "看来行军时我被分到和你们俩一组了。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1181
translate zh qst_ForgedInFire_FinalSparring_Complete_8cea643d:

    # MARKUS "Oh?"
    MARKUS "哦？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1182
translate zh qst_ForgedInFire_FinalSparring_Complete_5926d935:

    # KIARA @ happy "Aye, that won’t be a problem, will it?"
    KIARA @ happy "怎么，有问题吗？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1183
translate zh qst_ForgedInFire_FinalSparring_Complete_f3de8e53:

    # MARKUS "After that little show you put on with the Captain when we first got here? It’ll be our pleasure."
    MARKUS "就凭你刚来时跟上尉那场好戏？荣幸之至。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1184
translate zh qst_ForgedInFire_FinalSparring_Complete_4e8676e6:

    # MARKUS "I’ll be sure to let you soften the Demorai up before I get there!"
    MARKUS "我保证让你先上去给德莫莱人松松筋骨！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1185
translate zh qst_ForgedInFire_FinalSparring_Complete_0739d47d:

    # KIARA "How {i}valiant{/i} of you."
    KIARA "您可真是{i}英勇无畏{/i}啊。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1187
translate zh qst_ForgedInFire_FinalSparring_Complete_2cba1877:

    # "I caught her gaze and nodded:"
    "我迎上她的目光点头示意："

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1189
translate zh qst_ForgedInFire_FinalSparring_Complete_107ca765:

    # "琪亚拉 nodded and smiled mischievously."
    "琪亚拉点头回应，露出顽皮的笑容。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1190
translate zh qst_ForgedInFire_FinalSparring_Complete_1b1ca23b:

    # KIARA "What do they call your cute friend here?"
    KIARA "你这位可爱的朋友怎么称呼？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1191
translate zh qst_ForgedInFire_FinalSparring_Complete_435e4d75:

    # MARKUS "Hey! I can hear you!"
    MARKUS "喂！我听得见！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1192
translate zh qst_ForgedInFire_FinalSparring_Complete_217ebd58:

    # KIARA "I know, honey. So?"
    KIARA "我知道，亲爱的。所以呢？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1193
translate zh qst_ForgedInFire_FinalSparring_Complete_65cbbe79:

    # MARKUS "...It's 马库斯."
    MARKUS "...马库斯。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1194
translate zh qst_ForgedInFire_FinalSparring_Complete_246faf04:

    # KIARA @ happy "Well then, pleasure to meet you, 马库斯."
    KIARA @ happy "幸会，马库斯。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1195
translate zh qst_ForgedInFire_FinalSparring_Complete_0757128a:

    # KIARA "I'll take the rear, is that alright with you guys?"
    KIARA "我殿后，你们没意见吧？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1198
translate zh qst_ForgedInFire_FinalSparring_Complete_deaeaf6f:

    # MC "What’s your name?"
    MC "你叫什么名字？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1199
translate zh qst_ForgedInFire_FinalSparring_Complete_5e61be4f:

    # KIARA "琪亚拉, love."
    KIARA "琪亚拉，亲爱的。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1202
translate zh qst_ForgedInFire_FinalSparring_Complete_8ae7bf84:

    # "琪亚拉 smiled and winked mischievously."
    "琪亚拉狡黠地笑着眨眨眼。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1203
translate zh qst_ForgedInFire_FinalSparring_Complete_a0467524:

    # KIARA "What do they call you cuties then?"
    KIARA "那两位小可爱怎么称呼？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1204
translate zh qst_ForgedInFire_FinalSparring_Complete_f39a4545:

    # MARKUS "Oooh, did you hear that? She thinks we’re cute!"
    MARKUS "噢——听见没？她说我们可爱！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1205
translate zh qst_ForgedInFire_FinalSparring_Complete_e8544c91:

    # KIARA "Not when you speak, but I’ve seen worse looking."
    KIARA "不说话时还行，更丑的我也见过。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1206
translate zh qst_ForgedInFire_FinalSparring_Complete_d5d404a7:

    # KIARA "Even if you are pale as a ghost!"
    KIARA "虽然你白得像鬼！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1207
translate zh qst_ForgedInFire_FinalSparring_Complete_fbeafcd2:

    # MARKUS "Hey!"
    MARKUS "喂！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1209
translate zh qst_ForgedInFire_FinalSparring_Complete_a74d1cac:

    # MARKUS "马库斯."
    MARKUS "马库斯。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1210
translate zh qst_ForgedInFire_FinalSparring_Complete_e4d4b219:

    # MARKUS @ angry "And I ain’t no ghost!"
    MARKUS @ angry "而且我才不是鬼！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1211
translate zh qst_ForgedInFire_FinalSparring_Complete_36300c92:

    # KIARA "Pleasure to meet you both, I’ll take the rear?"
    KIARA "幸会二位，我殿后如何？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1213
translate zh qst_ForgedInFire_FinalSparring_Complete_35e56202:

    # MC "I don’t see why not."
    MC "没问题。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1214
translate zh qst_ForgedInFire_FinalSparring_Complete_f81a48ca:

    # KIARA "Thanks, makes a change from you always looking at {i}my{/i} rear."
    KIARA "谢啦，总比你们老盯着{i}我屁股{/i}强。"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:1215
translate zh qst_ForgedInFire_FinalSparring_Complete_2accebc1:

    # MARKUS "Ha! She’s caught you out good!"
    MARKUS "哈！被她逮个正着！"

