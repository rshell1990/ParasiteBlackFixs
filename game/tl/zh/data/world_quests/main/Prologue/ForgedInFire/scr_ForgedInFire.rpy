    MARKUS @ smile "看看这次谁的'军队'更强！"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:825
translate zh qst_ForgedInFire_Training2Teamwork_repBattle_82ab4d75:

