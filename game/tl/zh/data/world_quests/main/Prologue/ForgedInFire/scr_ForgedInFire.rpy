    MARKUS "再打一场，如何？"

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:370
translate zh qst_ForgedInFire_Training0FirstFight_repBattle_c9b50785:

    # MARKUS "Let's learn to handle these sticks of ours proper..."
    MARKUS "让我们学会好好驾驭这些棍子..."

# game/data/world_quests/main/Prologue/ForgedInFire/scr_ForgedInFire.rpy:371
