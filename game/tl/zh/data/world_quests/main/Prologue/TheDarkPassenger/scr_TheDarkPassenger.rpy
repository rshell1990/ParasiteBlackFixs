# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1446
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_b13f2d6c:

    # MARKUS"Why did you touch it?!"
    MARKUS "你为什么要碰它？！"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1447
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_7f1d5238:

    # MC"I don't know! I felt I had to—"
    MC "我不知道！我感觉我必须——"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1451
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_5df8b429:

    # "{b}A black mass of slithering tentacles{/b} erupted from the monument I fixed my gaze upon."
    "{b}一团蠕动的黑色触手{/b}从我注视的纪念碑中爆发出来。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1452
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_4ff3e97c:

    # "Shocked, I instinctively tried to swing my sword at it, only to find my arm firmly locked in place, one of the squirmy limbs coiling tightly around it."
    "震惊之下，我本能地挥剑砍去，却发现手臂被牢牢锁住，一条蠕动的肢体紧紧缠绕着它。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1453
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_64fdced3:

    # "In an instant, I was engulfed by the dark entity."
    "刹那间，我被黑暗实体吞噬了。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1454
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_1c5eec72:

    # "Unable to fight it I broke into a desperate struggle, primordial terror clawing its way into my very soul."
    "无力反抗的我开始绝望挣扎，原始的恐惧深深刺入我的灵魂。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1456
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_31afbfe4:

    # "The last thing I saw was 马库斯, devoured by a similar abomination bursting out from the second monument..."
    "我最后看到的是马库斯，被从第二座纪念碑爆发的类似怪物吞噬..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1457
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_6ea3e288:

    # "...only of {i}pure white{/i}."
    "...那怪物是{i}纯白色的{/i}。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1469
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_b5509755:

    # "Dark dreams circled in my head..."
    "黑暗的梦境在我脑海中盘旋..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1470
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_c2ef21b2:

    # "...visions of hundreds of naked women of all the different races I had never seen..."
    "...幻象中是数百名我从未见过的各族裸体女子..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1471
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_ac79c46e:

    # "...fawning over me desperately, moaning in intense pleasure as I sat on what seemed like a golden throne..."
    "...她们疯狂地讨好我，当我坐在似乎是黄金王座上时，她们在极乐中呻吟..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1472
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_15801940:

    # "...storm clouds gathering overhead as lightning forked to the world below..."
    "...头顶乌云密布，闪电劈向下方的世界..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1487
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_7ebda109:

    # "My eyes shot open as I sat bolt upright in horror."
    "我惊恐地直挺挺坐起，猛地睁开眼睛。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1488
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_c8ca8afa:

    # "Drenched in sweat, I looked around frantically to get some sense of bearing on where I was."
    "我浑身冷汗，疯狂地环顾四周，试图弄清自己身在何处。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1489
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_5f8b107a:

    # "I was sitting on one of many rows of beds made up in a stone-cold room."
    "我坐在一个冰冷石室里成排的其中一张床上。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1491
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_af2e3de3:

    # "Looking around I realised I was in... {i}Fort Sebastian?{/i}"
    "环顾四周，我意识到自己在... {i}塞巴斯蒂安要塞？{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1492
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_06f0eaca:

    # "{i}The medical ward{/i}?"
    "{i}医疗区{/i}？"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1495
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_8cd3553f:

    # "I turned my head to look to my side, 马库斯 was leaning on the wall near the next bed, looking even paler than usual, his eyes dark and foreboding."
    "我转头看向身旁，马库斯靠在隔壁床的墙边，脸色比平时更加苍白，眼神阴沉而不祥。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1496
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_5aaca9bd:

    # "One would think he was on death's door as he spoke to me."
    "他说话的样子让人以为他命不久矣。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1497
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_dfd2fec5:

    # MC"How did we... {i}get here?{/i}"
    MC "我们怎么... {i}到这里的？{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1498
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_3feec716:

    # MARKUS"I don't know... The nurses told me..."
    MARKUS "我不知道...护士告诉我..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1499
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_2fb985d3:

    # MARKUS"They found us naked outside the gates."
    MARKUS "他们发现我们赤身裸体地躺在城门外。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1500
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_077ab260:

    # MC"The gates? Are we—"
    MC "城门？我们难道——"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1501
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_64a2f0c8:

    # MARKUS"Yeah... We're home."
    MARKUS "是的...我们回家了。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1502
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_87b6f681:

    #"Despite my mind being awash with questions, I could at least allow a deep sigh of relief that we had by some miracle survived {i}the horrors of that abandoned fort{/i}."
    "尽管满心疑问，我至少能松一口气——我们奇迹般地活了下来，逃离了{i}那座废弃要塞的恐怖{/i}。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1503
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_4b98f3a0:

    #"My mind turned to Captain Duprey, Borras... {i}琪亚拉...{/i}"
    "我想起了杜普雷上尉、博拉斯...{i}琪亚拉...{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1504
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_92d4e80e:

    #"I heard a clanking sound approaching and looked towards it."
    "我听到金属碰撞声靠近，循声望去。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1505
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_05f226df:

    #"A huge figure walked towards us, accompanied by four heavily armed guards and a beautiful mage."
    "一个巨大的身影向我们走来，身旁跟着四名全副武装的守卫和一位美丽的女法师。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1507
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_7ff991c7:

    #"Naturally, the mage caught my wandering gaze, but just as I managed to focus a familiar, menacing voice opened up..."
    "自然，女法师吸引了我的目光，但当我刚定睛细看时，一个熟悉而危险的声音响起..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1509
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_68fb8823:

    # MENACING_VOICE"Check them both."
    MENACING_VOICE "检查他们两个。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1510
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_665817ca:

    # BEAUTIFUL_MAGE"Of course, my lord."
    BEAUTIFUL_MAGE "遵命，大人。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1512
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_4dbe0bba:

    #"As the mage stepped forward, I could not help but stare at her chest, deep cutout of her robes displaying a fair portion of her breasts."
    "女法师走上前时，我忍不住盯着她的胸口——法袍的深V剪裁展露出她大半个乳房。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1513
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_5a9888e7:

    #"My heartbeat rose, an unnatural wave of passion caressing my weakened body..."
    "我的心跳加速，一股反常的激情浪潮抚过我虚弱的身体..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1514
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_f72558e8:

    #"She spoke in a soft, raspy voice, pointing her staff at me:"
    "她用沙哑的柔声说着，法杖指向我："

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1515
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_9e803c89:

    # BEAUTIFUL_MAGE"Hold still."
    BEAUTIFUL_MAGE "别动。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1521
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_32a24889:

    #"Her staff lit up, warm light following its cryptic tip as she slowly held it over my body, head to toe."
    "她的法杖亮起，随着她将神秘的杖尖缓缓从我头顶移到脚底，温暖的光芒笼罩了我的身体。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1522
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_b4bb5c70:

    #"马库斯 was next, the procedure seemingly soothing his aching psyche."
    "接着是马库斯，这过程似乎安抚了他痛苦的灵魂。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1523
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_324b2179:

    #"In a few moments the mage was through examining us."
    "片刻之后，女法师完成了检查。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1526
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_bbae3533:

    #"Her full, purple lips let out a conclusive mutter, then she spoke up:"
    "她丰满的紫色嘴唇发出最后的低语，随后说道："

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1527
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_9d14bd22:

    # 美丽法师"They do not possess magic, nor do they reek of any magical essence that shows they have been possessed or tainted by the Demorai's magic."
    BEAUTIFUL_MAGE "他们体内没有魔法，也没有任何被德莫莱魔法附身或污染的魔法气息。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1529
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_8e787395:

    # MENACING_VOICE "Thank you, Kylisa, you may go now."
    MENACING_VOICE "谢谢你，凯莉莎，你可以退下了。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1531
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_31cce257:

    # "Kylisa bowed, as she stepped away and left the ward."
    "凯莉莎鞠躬后转身离开了医疗区。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1533
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_5c00a2f0:

    # "Emperor Alcott's attention was fully diverted to us now."
    "阿尔科特皇帝的注意力完全转向了我们。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1534
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_32ac97cc:

    # 奥尔科特"It is good to see you awake."
    ALCOTT "很高兴看到你们醒了。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1535
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_dacb22da:

    # 奥尔科特"Now then, it's time you boys told me what the hell happened out there."
    ALCOTT "那么现在，该告诉我外面到底发生了什么了。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1536
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_3c28cd0c:

    # "Clearly still deranged, I questioned if I was still dreaming..."
    "我仍有些恍惚，怀疑自己是否还在梦中..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1537
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_efd13d1e:

    # "...or was it indeed Emperor Alcott himself, standing before me and 马库斯, giving a damn about what we've got to say."
    "...还是阿尔科特皇帝本人真的站在我和马库斯面前，关心我们要说的话。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1538
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_7daffe81:

    # 奥尔科特"... You two deaf?"
    ALCOTT "...你们聋了吗？"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1539
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_1e27a783:

    #"I did my best to muster an answer."
    "我尽力组织回答。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1540
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_031d7429:

    # 主角"I... My lord... I..."
    MC "我...陛下...我..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1541
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_82c15c63:

    # 奥尔科特"Out with it!"
    ALCOTT "快说！"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1542
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_74abaf0e:

    # 主角"We reached the fort as instructed, my lord."
    MC "我们按命令抵达了要塞，陛下。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1543
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_182d39fe:

    # 主角"It was abandoned, but we were hit by a huge Demorai force."
    MC "那里已被废弃，但我们遭遇了大批德莫莱军队。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1544
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_ef36cc08:

    # 奥尔科特"How many?"
    ALCOTT "多少人？"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1545
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_0898c1cf:

    # MC"I don't know, sir... Hundreds... maybe thousands..."
    MC "我不知道，大人...数百...也许数千..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1546
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_a4e4ae45:

    # ALCOTT "...Hmm..."
    ALCOTT "...嗯..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1547
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_b3696be1:

    # MC "... {i}That thing{/i}... it killed Captain Duprey."
    MC "...{i}那个东西{/i}...它杀了杜普雷上尉。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1548
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_1bddb1d5:

    # ALCOTT "Who? What thing? What are you talking about?"
    ALCOTT "谁？什么东西？你在说什么？"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1549
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_b21ba69a:

    # MC "Demorai... Captain Duprey called it {i}Zanarak.{/i} It was there..."
    MC "德莫莱...杜普雷上尉称它为{i}扎纳拉克{/i}。它就在那里..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1550
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_618237ff:

    # "For just a moment, the Emperor's stoic face cracked as he heard those words, even his armed guards turned to glance at each other, the scent of fear now hanging in the air."
    "听到这个名字时，皇帝冷漠的面容瞬间闪过一丝波动，连武装守卫也交换了眼神，空气中弥漫着恐惧的气息。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1551
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_c69602a0:

    # ALCOTT"I see..."
    ALCOTT "我明白了..."

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1552
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_346d70be:

    #"After a brief pause, he proceeded:"
    "短暂停顿后，他继续问道："

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1553
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_d8c65580:

    # ALCOTT"What did you find in the fort? Did you recover anything?"
    ALCOTT "你们在要塞里发现了什么？找回任何东西了吗？"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1554
translate zh qst_TheDarkPass_ObelisksRoomCheckObelisks_6e12cd42:

    # MC"As I searched for an answer, I suddenly felt the faintest voice in the back of my head whispering something."
    MC "当我思索答案时，突然感到脑海深处有个微弱的声音在低语。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:1555
