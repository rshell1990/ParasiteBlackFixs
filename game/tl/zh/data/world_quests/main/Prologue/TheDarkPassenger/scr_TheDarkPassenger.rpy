# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:465
translate zh qst_TheDarkPass_CampTalkDuprey_menu_c64175ec:

    # DUPREY "Following the failure of The Great Demorai Siege, we were in high spirits after our first major win."
