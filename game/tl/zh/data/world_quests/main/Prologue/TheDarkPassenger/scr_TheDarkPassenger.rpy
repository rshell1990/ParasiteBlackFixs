translate zh qst_TheDarkPass_LeaveCampToBurnedOutVillage_0a68cb52:

    # "Both for her dignity and due to my own discomfort, I tore my eyes away."
    "为她的尊严与自身不适感，我移开视线。"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:818
translate zh qst_TheDarkPass_LeaveCampToBurnedOutVillage_c7f7f07b:

    # BORRAS "My lord... {i}What have they done to you?{/i}"
    BORRAS "天啊...{i}他们对你做了什么？{/i}"

# game/data/world_quests/main/Prologue/TheDarkPassenger/scr_TheDarkPassenger.rpy:820
translate zh qst_TheDarkPass_LeaveCampToBurnedOutVillage_42312e84:

