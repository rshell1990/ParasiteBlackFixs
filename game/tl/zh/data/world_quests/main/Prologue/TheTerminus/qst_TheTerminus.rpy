# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:212
translate zh qst_Terminus_PathBlockLibrary_eff605ae:

    # MC "City library."
    MC "市立图书馆。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:213
translate zh qst_Terminus_PathBlockLibrary_7203c1ee:

    # MC "I never been too much of a reader, but the ladies here are quite a sight."
    MC "我向来不爱读书，但这儿的女士们倒是赏心悦目。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:214
translate zh qst_Terminus_PathBlockLibrary_56f67843:

    # MC "However, today I'll get to steal a glimpse of the princess herself at the Royal Palace!"
    MC "不过今天在皇宫我就能亲眼见到公主本人了！"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:215
translate zh qst_Terminus_PathBlockLibrary_5254cca9:

    # MC "She is quite unmatched in many departments."
    MC "她在很多方面都无可匹敌。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:219
translate zh qst_Terminus_PathBlockGates_2c4ccd68:

    # "As I approached the city gates, I couldn't help but marvel at the colossal defenses."
    "走近城门时，我不禁为这宏伟的防御工事惊叹。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:220
translate zh qst_Terminus_PathBlockGates_fab2fd55:

    # MC "These gates are the only way in and out of the city."
    MC "这些城门是进出城市的唯一通道。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:221
translate zh qst_Terminus_PathBlockGates_79e20ae5:

    # MC "Encircled by walls so formidable, Novaras truly is an impenetrable city."
    MC "被如此坚固的城墙环绕，诺瓦拉斯真是座固若金汤的城市。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:222
translate zh qst_Terminus_PathBlockGates_f5ef103a:

    # MC "...or, a death trap."
    MC "...或者说，是个死亡陷阱。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:226
translate zh qst_Terminus_PathBlockSebastian_e082facf:

    # MC "The great Fort Sebastian. City garrison is stationed here, along with a considerable detachment of Emperor Alcott's army."
    MC "宏伟的塞巴斯蒂安要塞。城防军驻扎于此，还有艾尔科特皇帝的大批军队。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:227
translate zh qst_Terminus_PathBlockSebastian_2b3b2820:

    # "As I was ogling the walls and towers of the old but well-maintained fort, a guard strolled over my way."
    "正当我凝视着这座古老但维护良好的堡垒城墙和塔楼时，一名卫兵朝我走来。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:229
translate zh qst_Terminus_PathBlockSebastian_671b5a1a:

    # GUARD "Citizen! Shouldn't you be at the ceremony?"
    GUARD "市民！你不是该在仪式现场吗？"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:230
translate zh qst_Terminus_PathBlockSebastian_86ce00c5:

    # MC "Oh, I'm on my way there."
    MC "哦，我正要去。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:231
translate zh qst_Terminus_PathBlockSebastian_b2c4cc1d:

    # "The guard observed me suspiciously as I moved on."
    "卫兵用怀疑的目光目送我离开。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:236
translate zh qst_Terminus_WalkIntoMarket_afeb28d0:

    # MC "This place is the heart of the city's commerce."
    MC "这里是城市商业的核心地带。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:237
translate zh qst_Terminus_WalkIntoMarket_48731046:

    # MC "{b}Everything{/b} is being bought or sold here, especially during such an important day of the year."
    MC "在这里可以买卖{b}任何东西{/b}，尤其是在一年中如此重要的日子。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:238
translate zh qst_Terminus_WalkIntoMarket_f4161ff2:

    # "As I walked through the market, I heard various merchants hollering at an agitated crowd of commoners headed towards the Royal Palace."
    "穿过市场时，我听到商贩们对着涌向皇宫的躁动人群叫卖。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:239
translate zh qst_Terminus_WalkIntoMarket_d7f4f1ec:

    # MC "What exactly am I doing wandering about here?"
    MC "我到底在这儿瞎逛什么？"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:243
translate zh qst_Terminus_PathBlockClothesStore_056fedf8:

    # MC "If memory serves, this place is where all the top ladies go to get some... exquisite garments."
    MC "没记错的话，这里是名媛们购置...精致服饰的地方。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:244
translate zh qst_Terminus_PathBlockClothesStore_4bbd5a66:

    # MC "Not that I needed something like that at the moment."
    MC "虽然我现在不需要这类东西。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:248
translate zh qst_Terminus_PathBlockClothesStore_2_2e7bef50:

    # MC "That's weird, the place seems to be locked down in a hurry."
    MC "真奇怪，这地方像是匆忙关闭的。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:249
translate zh qst_Terminus_PathBlockClothesStore_2_52ddd3cb:

    # MC "There's a paper nailed to the front door..."
    MC "前门钉着一张纸..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:250
translate zh qst_Terminus_PathBlockClothesStore_2_91d70ba4:

    # "{i}I had to shut down the store and move out of the city.{/i}"
    "{i}我不得不关闭店铺搬离城市。{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:251
translate zh qst_Terminus_PathBlockClothesStore_2_1e78dfdf:

    # "{i}I present my sincerest apology to all the regular clientele.{/i}"
    "{i}谨向所有老主顾致以最诚挚的歉意。{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:252
translate zh qst_Terminus_PathBlockClothesStore_2_d7106dd8:

    # "{i}It was the only way to avoid a preposterous scandal.{/i}"
    "{i}这是避免荒唐丑闻的唯一方法。{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:253
translate zh qst_Terminus_PathBlockClothesStore_2_5becfda9:

    # "{i}I won't go into further details here, the only thing I will say is, {b}fuck elves.{/b}{/i}"
    "{i}细节恕不赘述，我只想说：{b}去他妈的精灵。{/b}{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:254
translate zh qst_Terminus_PathBlockClothesStore_2_fa7b7aba:

    # "{i}— Klaus Nevelinge, your humble fashionista.{/i}"
    "{i}——克劳斯·内维林格，您谦卑的时尚顾问{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:255
translate zh qst_Terminus_PathBlockClothesStore_2_6465b0fc:

    # MC "Elves "Elves? What could that be about?"
    MC "精灵？这到底怎么回事？"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:259
translate zh qst_Terminus_PathBlockGeneralStore_b7caea95:

    # MC"City general store."
    MC "城市杂货店。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:260
translate zh qst_Terminus_PathBlockGeneralStore_bd0bccc2:

    # MC"Anything you cannot find at the market can be found in here."
    MC "市场上找不到的东西这里都有。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:264
translate zh qst_Terminus_PathBlockAdventurersGuild_5dbfbf31:

    # MC"Oh, the Adventurers Guild."
    MC "啊，冒险者公会。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:265
translate zh qst_Terminus_PathBlockAdventurersGuild_44f3d8b3:

    # MC"A very bizzare way to encourage people to deal with the problems the Emperor's regime can't handle..."
    MC "用这种方式鼓励民众处理帝国政权无法解决的问题真是古怪..."

# game/data/world_quests/main/Prologue/TheTheTerminus/qst_TheTerminus.rpy:266
translate zh qst_Terminus_PathBlockAdventurersGuild_e0788ece:

    # MC"Although the guild members are quite popular, given the nature of the job."
    MC "不过鉴于工作性质，公会成员倒是很受欢迎。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:270
translate zh qst_Terminus_GuildBoard_fda4112a:

    # MC"A guild quest board."
    MC "公会任务板。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:271
translate zh qst_Terminus_GuildBoard_df11ef65:

    # MC"From what I know about the guild, it is {i}the{/i} way the adventurers are employed."
    MC "据我所知，这是冒险者{i}唯一{/i}的雇佣途径。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:272
translate zh qst_Terminus_GuildBoard_c2463f28:

    # MC"Any trouble the state can't handle can be turned into a 'quest' for the guild to present as a contract."
    MC "任何国家无法处理的麻烦都能变成'任务'，由公会作为契约发布。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:273
translate zh qst_Terminus_GuildBoard_308e9108:

    # MC "Not like I'll be involved in any of this, now that I'm a scout..."
    MC "反正我现在是侦察兵了，跟这些事也扯不上关系..."

# game/data/world_quests/main/Prologue/TheTheTerminus/qst_TheTerminus.rpy:277
translate zh qst_Terminus_PathBlockTavern_f0943a05:

    # MC "The Iron Unicorn, a place me and 马库斯 are regulars of."
    MC "铁角兽酒馆，我和马库斯是这里的常客。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:278
translate zh qst_Terminus_PathBlockTavern_d08ca8f4:

    # MC "I can only imagine what the place will turn into after today's celebration..."
    MC "真不敢想象今天的庆典之后这里会变成什么样..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTermTheTerminus.rpy:282
translate zh qst_Terminus_PathBlockTavern2_1e32b18e:

    # MC"I can hear the celebration from the outside..."
    MC "在外面都能听到里面的欢闹声..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:283
translate zh qst_Terminus_PathBlockTavern2_d372b0e7:

    # MC"*Sigh* time to head home for today."
    MC "*叹气* 今天该回家了。"

# game/data/world_quests/main/Prologue/TheTheTerminus/qst_TheTerminus.rpy:287
translate zh qst_Terminus_PathBlockBordelloInterior_17b6376a:

    # MC"I've had enough 'fun' today..."
    MC "今天的'乐子'够多了..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:288
translate zh qst_Terminus_PathBlockBordelloInterior_ecb58a18:

    # MC "Gotta head home now."
    MC "现在得回家了。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:292
translate zh qst_Terminus_PathBlockWitchHouse_891058fa:

    # MC "Even standing nearby that cabin gives me the creeps..."
    MC "光是站在那小屋附近就让我毛骨悚然..."

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:293
translate zh qst_Terminus_PathBlockWitchHouse_b2fa8c73:

    # MC "I should go to the ceremony."
    MC "我该去参加仪式了。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:297
translate zh qst_Terminus_CantSleep_350d2cb3:

    # MC "Now is not the time to rest."
    MC "现在不是休息的时候。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:298
translate zh qst_Terminus_CantSleep_87513176:

    # MC "That comes later."
    MC "休息的事以后再说。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:302
translate zh qst_Terminus_CantGoHomeNow_569f96b2:

    # MC "I... No."
    MC "我...不行。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:304
translate zh qst_Terminus_CantGoHomeNow_f68170be:

    # MC "Let's get on with it and go to Fort Sebastian."
    MC "继续吧，去塞巴斯蒂安要塞。"

translate zh strings:

    # game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:4
    old "Get gold from the chest"
    new "从箱子拿金币"

    old "I will certainly need some currency to handle whatever today brings. There must be some in my chest."
    new "今天无论发生什么都需要钱打点，我箱子里应该还有些积蓄。"

    old "Head out of your room"
    new "离开房间"
    old"It's time to head out."
    new "该出发了。"

    old "Attend the Terminus Ceremony"
    new "参加终焉仪式"

    old "The Terminus Ceremony is held in the Royal Palace, at the very heart of the City of Novaras. I should make haste."
    new "终焉仪式在诺瓦拉斯城中心的皇宫举行，我得抓紧时间。"

    old "Meet Adara at the tavern\nor visit the bordello"
    new "在酒馆见阿达拉\n或去妓院"

    old "Struck by the prospect of joining the Scouts Corp, I am unsure how to spend the remainder of today. Markus went for the pleasure district to get laid. I remember Adara talking about catching up at the Iron Unicorn tavern, after the ceremony."
    new "加入侦察兵团的消息让我不知所措，不知如何度过今日余下的时光。马库斯去红灯区寻欢了。我记得阿达拉提过仪式后在铁角兽酒馆聚聚。"

    old "Return home"
    new "回家"

    old "There goes my last night in the city as a free citizen. I should head home and try to get some sleep."
    new "这是我作为自由市民在城里的最后一夜了。该回家试着睡会儿。"

    old "Report to Fort Sebastian"
    new "向塞巴斯蒂安要塞报到"

    old "During the Terminus Ceremony held yesterday I have found out that I am to be a part of the Scouts Corp, the reconnaissance branch of Emperor Alcott's army. I am to report to Fort Sebastian to begin my training. Some graduation..."
    new "昨日的终焉仪式上，我得知自己将被编入侦察兵团——艾尔科特皇帝军队的侦察部队。我需前往塞巴斯蒂安要塞接受训练。真是特别的毕业礼..."

    old "The Terminus"
    new "终焉仪式"

    old "As I have come of age, the Terminus Ceremony is about to decide my future for life. I will find out what fate has our kingdom blessed me with. Hopefully, I am prepared for it."
    new "成年之际，终焉仪式将决定我的人生轨迹。我将知晓王国赐予我的命运。但愿我已做好准备。"

    old "I should grab my gold first."
    new "我得先拿上金币。"

    old "Loyal Citizen!"
    new "忠诚的市民！"

    old "You have been bestowed the honor and privilege of joining\nthe Scouts Corp!"
    new "现授予您加入\n侦察兵团的荣誉与特权！"

    old "Please report to Fort Sebastian to begin your training at once!"
    new "请立即前往塞巴斯蒂安要塞报到受训！"

    old "Warning: failure to show up in a day since removing the seal from\nthis letter is a capital offense as of 1134.03.19"
    new "警告：自拆封日起一日内未报到\n将按1134.03.19法令以死罪论处"

    old "Royal Prosecutor Horace Abertix, 1163.04.20"
    new "皇家检察官霍勒斯·阿伯蒂克斯，1163.04.20"
translate zh qst_Terminus_PathBlockChurch_78722971:

    # MC"Never really worked for me, though."
    MC "不过这招对我从来就不管用。"

