# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:198
translate zh qst_Terminus_PathBlockSmithy_3da856ab:

    # MC "His daughter, Arlena, is quite a piece of work."
    MC "他女儿艾琳娜可真是个难缠的主儿。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:199
translate zh qst_Terminus_PathBlockSmithy_384b5404:

    # MC "I should really get going."
    MC "我真该走了。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:200
