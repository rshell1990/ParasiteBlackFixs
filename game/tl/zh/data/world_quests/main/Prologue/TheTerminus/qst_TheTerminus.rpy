# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:187
translate zh qst_Terminus_PathBlockChurch_34e6c1bf:

    # MC "People come here to sate their spiritual hunger."
    MC "人们来这里满足精神需求。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:192
translate zh qst_Terminus_PathBlockPalam_8255ded6:

    # MC "The Mages of Palam tower, the place they study the arcane in."
    MC "帕拉姆法师塔，他们研究奥术的地方。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:193
