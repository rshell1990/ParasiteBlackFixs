    # MC "Looks like nobody's home."
    MC "看来没人在家。"

# game/data/world_quests/main/Prologue/TheTerminus/qst_TheTerminus.rpy:208
translate zh qst_Terminus_PathBlockSmithy2_d9d30c05:

    # MC "I should go."
