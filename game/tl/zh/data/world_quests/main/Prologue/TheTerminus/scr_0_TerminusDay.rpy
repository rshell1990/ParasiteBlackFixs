    # MC "马库斯!"
    MC "马库斯！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:8
translate zh qst_Terminus_intro_f3542d5e:

    # MC "Run! RUN!"
    MC "快跑！快跑啊！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:9
translate zh qst_Terminus_intro_e144dd44:

    # "We sprinted down deeper into the darkness of the unknown, the sounds of metal clanking, beasts snarling, and cries of agony followed behind us."
    "我们朝着未知的黑暗深处狂奔，身后传来金属碰撞声、野兽咆哮声和痛苦的哀嚎。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:11
translate zh qst_Terminus_intro_265a452b:

    # MARKUS "They’re gaining on us!"
    MARKUS "它们追上来了！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:12
translate zh qst_Terminus_intro_bc178804:

    # MC "Keep running! Don’t stop!"
    MC "继续跑！别停下！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:13
translate zh qst_Terminus_intro_891fbb8d:

    # MARKUS "But... {b}{i}the others!{/i}{/b}"
    MARKUS "可是... {b}{i}其他人呢！{/i}{/b}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:14
translate zh qst_Terminus_intro_db8ca703:

    # MC "There’s nothing we can do! We have to get to—"
    MC "我们无能为力！必须赶到——"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:18
translate zh qst_Terminus_intro_3f5de290:

    # MARKUS "L-Look at it!"
    MARKUS "看...看它！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:19
translate zh qst_Terminus_intro_91c3f48f:

    # MC "马库斯! Draw your sword, damn it!"
    MC "马库斯！拔剑啊，该死！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_TerminusDay.rpy:20
translate zh qst_Terminus_intro_a1ddd20f:

    # "Unsheathing his blade with trembling hands, 马库斯 fumbled and dropped it to the floor with a loud clank."
    "马库斯双手颤抖着拔剑，却失手将它哐当一声掉在地上。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:21
translate zh qst_Terminus_intro_a8f4e15d:

    # MARKUS "Sh-Shit!"
    MARKUS "该...该死！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:22
translate zh qst_Terminus_intro_aa4f252c:

    # MC "MARKUS!"
    MC "马库斯！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:23
translate zh qst_Terminus_intro_80342e3b:

    # "The beast charges at 马库斯, but is suddenly attacked by one of the soldiers fighting the demonic creatures throughout the caves."
    "那怪物扑向马库斯，却被一名在洞穴中与魔物战斗的士兵突袭拦截。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:26
translate zh qst_Terminus_intro_207c971f:

    # SCOUT "Go! GO NOW!"
    SCOUT "走！快走！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:27
translate zh qst_Terminus_intro_9fcbf27a:

    # MC "马库斯, quickly!"
    MC "马库斯，快点！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:28
translate zh qst_Terminus_intro_6f2ce96a:

    # MARKUS "Right!"
    MARKUS "好！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:29
translate zh qst_Terminus_intro_71f2a840:

    # "Darting around the battle, we managed to burst our way through into the Forbidden Chamber."
    "我们绕过战斗，终于冲进了禁室。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:30
translate zh qst_Terminus_intro_f45bd3a6:

    # MC "Seal the door! SEAL THE FUCKING DOOR!"
    MC "封门！把这该死的门封上！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:32
translate zh qst_Terminus_intro_b8303e9d:

    # MC "DO IT!"
    MC "快封！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:34
translate zh qst_Terminus_intro_045294e7:

    # "As 马库斯 moved to try and activate the seal by pulling the strange mechanical levers to our left, I looked up through the deep, seemingly endless darkness of the catacombs."
    "当马库斯拉动左侧奇异的机械杠杆试图启动封印时，我抬头望向墓穴深处那仿佛永无止境的黑暗。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:35
translate zh qst_Terminus_intro_ddae734c:

    # "I watched as the monstrosity before me took a hold of the Scout with both of its colossal, wretched, claw like hands and held the flailing man out."
    "我看见那怪物用两只巨大而扭曲的利爪抓住侦察兵，将挣扎的男人高举在半空。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:36
translate zh qst_Terminus_intro_cc7a069b:

    # "His cloak flapped helplessly as he swung desperately at the beast, retching up blood, unable to break free from its deathly grip."
    "他徒劳地挥砍着怪物，呕出鲜血，斗篷无助地飘动，却无法挣脱那致命的钳制。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:37
translate zh qst_Terminus_intro_fa086f51:

    # "The creature relished the moment, feverishly lapping up his blood, snarling in sick pleasure as the Scout croakily managed to cry out."
    "怪物陶醉其中，贪婪地舔舐鲜血，在侦察兵嘶哑的呐喊中发出病态的愉悦低吼。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:38
translate zh qst_Terminus_intro_7337b94e:

    # SCOUT "FUCK YOU!"
    SCOUT "去你妈的！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:39
translate zh qst_Terminus_intro_bb463d92:

    # SCOUT "I HOPE YOU FUCKING CHO—"
    SCOUT "愿你他妈的噎——"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:40
translate zh qst_Terminus_intro_b3d4450b:

    # "We watched in horror as the beast twisted the body of the man, his cries of pain contorting into an animal like squeal."
    "我们惊恐地看着怪物扭绞那男人的身体，他的痛苦惨叫扭曲成了野兽般的尖啸。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:42
translate zh qst_Terminus_intro_2675f8e6:

    # "What followed was a terrible snapping as he tore the body in two, flinging the man’s halves aside."
    "紧接着是可怕的撕裂声——它将那身体撕成两半，残躯被甩向两侧。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:43
translate zh qst_Terminus_intro_81cfc0fe:

    # "Behind it, barely visible was a myriad of other monsters, clawing and clambering their way down towards us."
    "它身后，隐约可见无数其他怪物正撕扯攀爬着向我们涌来。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:44
translate zh qst_Terminus_intro_ddba1310:

    # MC "马库斯... hurry."
    MC "马库斯...快点。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:45
translate zh qst_Terminus_intro_463d4592:

    # "The beast roared and charged at us once again! A behemoth of tooth and claw, galloping, ready."
    "怪物再次咆哮的冲向我们！这獠牙利爪的巨兽奔腾着，蓄势待发。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:47
translate zh qst_Terminus_intro_4170c645:

    # MC "HURRY!"
    MC "快啊！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:48
translate zh qst_Terminus_intro_7ad62c8c:

    # MARKUS "It won’t close!"
    MARKUS "门关不上！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:49
translate zh qst_Terminus_intro_d7589ccf:

    # MC "CLOSE IT! CLOSE THE FUCKING DOOR!"
    MC "关上！把这该死的门关上！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:51
translate zh qst_Terminus_intro_ef27cd89:

    # MARKUS "I’m trying!"
    MARKUS "我在试！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:52
translate zh qst_Terminus_intro_2cd10d35:

    # MC "MARKUS! HURRY! IT’S NEARLY—"
    MC "马库斯！快！它就要——"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:69
translate zh qst_Terminus_intro_135591ef:

    # MC "Ah... Today’s the day... {i}Terminus Ceremony.{/i}"
    MC "啊...就是今天了...{i}终焉仪式{/i}。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:70
translate zh qst_Terminus_intro_3b92041f:

    # "Rising from my bed, I was hit by a {i}shockwave{/i}."
    "从床上起身时，一阵{i}冲击波{/i}席卷而来。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:71
translate zh qst_Terminus_intro_7ae716df:

    # MC "Urgh... {i}My head...{/i}"
    MC "呃...{i}我的头...{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:72
translate zh qst_Terminus_intro_b98a473f:

    # MC "Why did I let 马库斯 talk me into drinking so much last night?"
    MC "昨晚怎么就听马库斯的劝喝了那么多？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:73
translate zh qst_Terminus_intro_47517399:

    # MC "Well, better get ready."
    MC "算了，该准备了。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:74
translate zh qst_Terminus_intro_19314b42:

    # MC "I should grab some gold before I head out, it is {i}a ceremony{/i} after all."
    MC "出门前得带点金币，毕竟是{i}仪式{/i}嘛。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:86
translate zh qst_Terminus_KitchenEnterMorning_d39399b8:

    # "Hm... Where is everyone?"
    "嗯...人都去哪了？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:87
translate zh qst_Terminus_KitchenEnterMorning_232c2f5f:

    # "Looks like Regina is in her room."
    "雷吉娜好像在她房间。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:88
translate zh qst_Terminus_KitchenEnterMorning_4ce9008c:

    # "...Should I?"
    "...要偷看吗？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:90
translate zh qst_Terminus_KitchenEnterMorning_7aa86cfe:

    # MC "...Should I?" nointeract
    MC "...要偷看吗？" nointeract

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:96
translate zh qst_Terminus_KitchenEnterMorning_8060ab4f:

    # MC "I... I shouldn’t watch this! This is... {i}perverse{/i}."
    MC "我...不该看这个！这太...{i}下流了{/i}。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:97
translate zh qst_Terminus_KitchenEnterMorning_a8c437e9:

    # MC "... But she does look {i}really{/i} pretty."
    MC "...可她{i}确实{/i}很美。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:103
translate zh qst_Terminus_KitchenEnterMorning_2403981d:

    # MC "No, of course I’m not gonna do that! What the hell am I even thinking?"
    MC "不，当然不能看！我到底在想什么？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:110
translate zh qst_Terminus_KitchenEnterMorning_3525008c:

    # "Following the death of both Erika’s mother and my own due to winter fever, our fathers were sent to the front."
    "艾丽卡的母亲和我母亲都死于寒热病后，我们的父亲被派往前线。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:111
translate zh qst_Terminus_KitchenEnterMorning_42b425f3:

    # "Regina, a friend to both families agreed to look after us till our respective fathers came home from the war."
    "两家的朋友雷吉娜答应照顾我们，直到各自的父亲从战场归来。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:113
translate zh qst_Terminus_KitchenEnterMorning_feb83ee4:

    # MC "Erika! I wasn’t expecting you to be here today!"
    MC "艾丽卡！没想到你今天会来！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:114
translate zh qst_Terminus_KitchenEnterMorning_6f2e862b:

    # MC "Aren’t you supposed to be on top secret Inquisitor work?"
    MC "你不是该执行审判官的机密任务吗？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:115
translate zh qst_Terminus_KitchenEnterMorning_c8360b21:

    # ERIKA @ talk "I couldn’t miss seeing you on your big day."
    ERIKA @ talk "怎能错过你的大日子。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:116
translate zh qst_Terminus_KitchenEnterMorning_91f2bc0b:

    # MC "You didn’t need to come but it means the world to me that you have."
    MC "你不必专程来的，但你能来我真的很开心。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:117
translate zh qst_Terminus_KitchenEnterMorning_650e053a:

    # "Erika, thanks to her outstanding grades and increasing aptitude for magic, was snatched up and positioned with the Inquisitors on her final schooling day."
    "艾丽卡因优异的成绩和日益增长的魔法天赋，在毕业当天就被审判官组织招揽。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:118
translate zh qst_Terminus_KitchenEnterMorning_f0e4df88:

    # "I must admit, I missed her deeply as she went off, gallivanting around on great adventures..."
    "必须承认，她四处冒险时我十分想念她..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:119
translate zh qst_Terminus_KitchenEnterMorning_41ebf0a9:

    # "But I knew the work she did was particularly important, so I was always proud of her."
    "但我知道她的工作至关重要，始终为她骄傲。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:126
translate zh qst_Terminus_KitchenEnterMorning_3dc6f6d9:

    # REGINA @ shock_talk "Erika!"
    REGINA @ shock_talk "艾丽卡！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:128
translate zh qst_Terminus_KitchenEnterMorning_c6e8ca81:

    # REGINA @ smile_talk "Oooh! Come here, my love!"
    REGINA @ smile_talk "噢！快过来，亲爱的！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:135
translate zh qst_Terminus_KitchenEnterMorning_83439c50:

    # ERIKA @ surp_talk "Can’t... {i}breathe!{/i}"
    ERIKA @ surp_talk "喘...{i}不过气了！{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:136
translate zh qst_Terminus_KitchenEnterMorning_5b0fac1a:

    # REGINA @ shy_talk "Oh! Sorry, dear!"
    REGINA @ shy_talk "啊！抱歉亲爱的！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:139
translate zh qst_Terminus_KitchenEnterMorning_f5edd23e:

    # REGINA @ smile_talk "I can’t believe you’re already eighteen."
    REGINA @ smile_talk "真不敢相信你已经十八岁了。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:140
translate zh qst_Terminus_KitchenEnterMorning_88b2e62e:

    # REGINA @ smile_talk "Your father would be so proud!"
    REGINA @ smile_talk "你父亲会为你骄傲的！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:142
translate zh qst_Terminus_KitchenEnterMorning_e0dadf01:

    # MC "... Is there any news on Father?"
    MC "...父亲有消息吗？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:144
translate zh qst_Terminus_KitchenEnterMorning_b8e7f843:

    # REGINA @ talk "... Well..."
    REGINA @ talk "...这个..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:146
translate zh qst_Terminus_KitchenEnterMorning_8bbedfc6:

    # REGINA @ sad_talk "No, but..."
    REGINA @ sad_talk "没有，不过..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:147
translate zh qst_Terminus_KitchenEnterMorning_aa290b42:

    # MC sad "..."
    MC sad "..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:149
translate zh qst_Terminus_KitchenEnterMorning_76751a70:

    # ERIKA @ talk "I’m sure he’s fine, he’s been sent to help with the negotiations with Lord Psydon."
    ERIKA @ talk "他肯定没事，只是去协助与赛顿勋爵的谈判了。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:151
translate zh qst_Terminus_KitchenEnterMorning_ccbfcfda:

    # MC "That was six months ago."
    MC "那是半年前的事了。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:152
translate zh qst_Terminus_KitchenEnterMorning_4b917138:

    # ERIKA @ talk "Yes, but you know how these things are..."
    ERIKA @ talk "是啊，但你知道这类事务..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:153
translate zh qst_Terminus_KitchenEnterMorning_528993a6:

    # ERIKA @ talk "The travel alone can take weeks, even months sometimes."
    ERIKA @ talk "光路途就可能耗时数周甚至数月。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:154
translate zh qst_Terminus_KitchenEnterMorning_d7fb3292:

    # MC "Has he sent any letters at least?"
    MC "至少寄过信吧？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:155
translate zh qst_Terminus_KitchenEnterMorning_9f665cf0:

    # REGINA @ talk "No, the last I received was him letting us know he was safe and that the men in his company were in good spirits."
    REGINA @ talk "没有，最后一封是说他和部下平安且士气高昂。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:156
translate zh qst_Terminus_KitchenEnterMorning_ef3818f6:

    # REGINA @ talk "I’m sure he will write to us as soon as he can."
    REGINA @ talk "他定会尽快来信的。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:157
translate zh qst_Terminus_KitchenEnterMorning_9130bb88:

    # MC @ sad "{i}*Sigh*{/i}... I hope he’s okay."
    MC @ sad "{i}*叹气*{/i}...希望他平安。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:158
translate zh qst_Terminus_KitchenEnterMorning_e035c6b1:

    # MC @ sad "And I wish he was here."
    MC @ sad "真希望他在场。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:160
translate zh qst_Terminus_KitchenEnterMorning_be4f1677:

    # REGINA @ talk "We all do, my love..."
    REGINA @ talk "我们都希望如此，亲爱的..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:161
translate zh qst_Terminus_KitchenEnterMorning_54c9401a:

    # REGINA @ smile_talk "But come now! Today’s a big day!"
    REGINA @ smile_talk "打起精神！今天可是大日子！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:164
translate zh qst_Terminus_KitchenEnterMorning_f60e5636:

    # ERIKA @ smile_talk "Today, you have the glorious honour of scrubbing the outhouses clean!"
