translate zh qst_Terminus_EnterPalace_25dc304d:

    # "The guard shoved me back sharply, making me stumble as I fell on my ass, tears springing behind my eyes as I muttered to myself."
    "卫兵猛力推搡，我踉跄跌倒。泪水在眼眶打转，我喃喃自语。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:536
translate zh qst_Terminus_EnterPalace_52378a4f:

    # MC "No... {i}No this can’t be!{/i}"
    MC "不...{i}这不可能！{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:537
translate zh qst_Terminus_EnterPalace_f20c8d0d:

    # MC "I can’t... {i}This...{/i}... This is a nightmare!"
    MC "我不能...{i}这...{/i}...简直是噩梦！"

# game/data/world_quests/main/Palogue/TheTerminus/scr_0_TerminusDay.rpy:538
translate zh qst_Terminus_EnterPalace_fd8e9f7a:

    # MC "{i}It can’t be real!{/i}"
    MC "{i}不可能是真的！{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:545
translate zh qst_Terminus_EnterPalace_903a92c1:

    # "Dazed, I walked the streets aimlessly for what seemed like an eternity, until I found myself in the housing district."
    "我神志恍惚，漫无目的走了许久，直至来到住宅区。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:546
translate zh qst_Terminus_EnterPalace_62f22980:

    # "I dragged myself over to 马库斯’ home, dejected, destroyed... {i}broken.{/i}"
    "我拖着脚步走向马克斯家，沮丧，崩溃...{i}支离破碎{/i}。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:553
translate zh qst_Terminus_EnterPalace_0c816036:

    # "I found him slouched against the wall by his front door, a solemn look on his face as he turned to me, still holding his own sheet in his hands."
    "见他颓然倚靠家门边的墙，转身看我时面色凝重，手中仍攥着自己的文书。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:554
translate zh qst_Terminus_EnterPalace_25c532ca:

    # MARKUS "... I’ve been placed in the Scouts."
    MARKUS "...我被分到侦察兵团。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:555
translate zh qst_Terminus_EnterPalace_d92e9348:

    # "He said with a lifeless look in his eyes, my eyes widened in shock."
    "他眼神空洞地说着，我震惊地睁大双眼。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:556
translate zh qst_Terminus_EnterPalace_dd0c95fc:

    # MC "... Y-You’re..."
    MC "...你-你也..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:557
translate zh qst_Terminus_EnterPalace_06928b06:

    # MARKUS "Yes."
    MARKUS "对。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:558
translate zh qst_Terminus_EnterPalace_569f4dc6:

    # "I gulped hard, nodding."
    "我用力咽下口水，点了点头。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:559
translate zh qst_Terminus_EnterPalace_55c52802:

    # MC "... {i}Me too.{/i}"
    MC "...{i}我也是{/i}。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:560
translate zh qst_Terminus_EnterPalace_e70ab855:

    # "马库斯’ mouth hung open in shock, all our dreams and hopes... just like that, {i}gone.{/i}"
    "马克斯震惊得张大嘴，我们所有的梦想与希望...就这样{i}烟消云散{/i}。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:561
translate zh qst_Terminus_EnterPalace_01020745:

    # MARKUS "... No, you mean—"
    MARKUS "...不，你是说——"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:562
translate zh qst_Terminus_EnterPalace_605f37ff:

    # MC "... Heh... Well, looks like we’re still stuck together... Just..."
    MC "...呵...看来我们还是绑在一起...只是..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:563
translate zh qst_Terminus_EnterPalace_0f584615:

    # MC "Not in the way we hoped."
    MC "并非如我们所愿的方式。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:564
translate zh qst_Terminus_EnterPalace_66cfca50:

    # MARKUS "... Yeah..."
    MARKUS "...是啊..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:565
translate zh qst_Terminus_EnterPalace_57bce272:

    # MARKUS  "Instead of eating well and wooing court ladies together."
    MARKUS "不能一起锦衣玉食追求宫廷贵妇了。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:566
