# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:518
translate zh qst_Terminus_EnterPalace_85bbe6f7:

    # "I read that tiny bit of text a couple times over before it actually started to make sense..."
