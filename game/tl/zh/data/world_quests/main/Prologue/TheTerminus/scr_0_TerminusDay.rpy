translate zh qst_Terminus_EnterPalace_757e00c2:

    # "The woman shuffled through the envelopes stamped down with the red wax seal of the Royal Court, and after finding mine, handed it over to me which I snatched greedily from her hands."
    "女人翻查盖有王室红蜡印的信封，找到我的后递来。我急切地一把抓过。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:499
translate zh qst_Terminus_EnterPalace_70c7cba8:

