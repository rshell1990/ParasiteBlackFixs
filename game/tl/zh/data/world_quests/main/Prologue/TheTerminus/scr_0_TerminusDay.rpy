    # MARKUS "{i}We’re gonna fucking die...{/i}"
    MARKUS "{i}我们他妈死定了...{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:567
translate zh qst_Terminus_EnterPalace_d58e0d46:

    # MC "We don’t know that! Come on, we’ll—"
    MC "别这么说！听着，我们会——"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:569
translate zh qst_Terminus_EnterPalace_555ad1e1:

    # MARKUS "Frankly, I’m half tempted just to get a rope and save myself the agony of dying by {i}their{/i} hands."
    MARKUS "老实说，我差点想找根绳子自我了断，省得遭{i}它们{/i}毒手。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:570
translate zh qst_Terminus_EnterPalace_1ebe35b7:

    # MC "Don’t joke about that!"
    MC "别开这种玩笑！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:571
translate zh qst_Terminus_EnterPalace_80e3fd99:

    # MARKUS "Why not? We’re fucked anyway."
    MARKUS "有何不可？反正我们完蛋了。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:572
translate zh qst_Terminus_EnterPalace_ed1242e8:

    # MC "Well, you’ll definitely be fucked if you do that!"
    MC "真要那样你才彻底完了！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:rpy:573
translate zh qst_Terminus_EnterPalace_e160c276:

    # MC "And you’ll be fucking me over! I need someone to have my back out {i}there!{/i}"
    MC "还会连累我！我需要有人在{i}外面{/i}支援我！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:575
translate zh qst_Terminus_EnterPalace_f699c54d:

    # MC "Don’t give me that shit! We’ve stuck together since we were kids, we’re gonna stick together and get through this now! Understand?"
    MC "少来这套！我们从小就在一起，现在也要共渡难关！明白吗？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:576
translate zh qst_Terminus_EnterPalace_d42ade9c:

    # "马库斯 sighed deeply, not really believing me but playing along anyway."
    "马克斯深深叹息，虽不真信我言，仍配合着点头。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:577
translate zh qst_Terminus_EnterPalace_571fda6d:

    # MARKUS "... Yeah... We’ll make it out."
    MARKUS "...行...我们会活下去。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:578
translate zh qst_Terminus_EnterPalace_72a150fc:

    # MARKUS "{i}*Sigh*{/i} Look, I don’t know about you, but for my last goddamn night of freedom I’m gonna head down the Pleasure District, you coming?"
    MARKUS "{i}*叹气*{/i} 听着，我要去欢愉区过这最后的自由之夜，你呢？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:579
translate zh qst_Terminus_EnterPalace_27a83521:

    # "My eyes lit up in surprise."
    "我惊讶地睁大眼。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:580
translate zh qst_Terminus_EnterPalace_8009daa6:

    # MC "You’re... You’re going to get a girl {i}down there?{/i}"
    MC "你...你要去{i}那儿{/i}找姑娘？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:581
translate zh qst_Terminus_EnterPalace_5c828bc0:

    # MARKUS "Come on, we both know you’re not a virgin."
    MARKUS "得了吧，我们都知道你不是处男。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:582
translate zh qst_Terminus_EnterPalace_cf6a14ef:

    # MC "Y-Yeah, but..."
    MC "是-是啊，可是..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:583
translate zh qst_Terminus_EnterPalace_45164ee2:

    # MC "{i}It’s not really my thing...{/i}"
    MC "{i}我不太喜欢那样...{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:584
translate zh qst_Terminus_EnterPalace_6051b7dd:

    # MARKUS "It’s not mine either, but chances are we aren’t going to get any for a couple months... and that’s assuming we survive so, I want to make the most of the time I have left."
    MARKUS "我也不喜欢，但接下来几个月怕是没机会了...还得假设我们能活下来。所以我想充分利用剩余时间。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:585
translate zh qst_Terminus_EnterPalace_2d204a49_1:

    # MC "..."
    MC "..."

