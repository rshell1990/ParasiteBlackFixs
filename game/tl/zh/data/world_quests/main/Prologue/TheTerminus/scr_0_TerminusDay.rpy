translate zh qst_Terminus_EnterPalace_afc8cc1f:

    # MC "Yeah..."
    MC "是啊..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:464
translate zh qst_Terminus_EnterPalace_49080373:

    # MARKUS "He might be scary, but without him this city would have fallen long ago."
    MARKUS "他或许可怕，但若没有他，这城市早沦陷了。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:465
translate zh qst_Terminus_EnterPalace_525dee60:

    # MARKUS "We need more leaders like him. Leaders who will do what has to be done."
    MARKUS "我们需要更多他这样的领袖。敢于采取必要行动的领袖。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:466
translate zh qst_Terminus_EnterPalace_6fa51ea6:

    # ADARA @ talk "Mmm, I’m not so sure... Not after deposing the King like that..."
    ADARA @ talk "唔，我不确定...尤其在他那样废黜国王之后..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:467
translate zh qst_Terminus_EnterPalace_db5a5efc:

    # MARKUS "Alcott led troops and repelled The Great Invasion from taking Novaras while the King continued to squander more troops lives pointlessly."
    MARKUS "国王无谓消耗将士生命时，是阿尔科特率军击退大入侵保住了诺瓦拉斯。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:468
translate zh qst_Terminus_EnterPalace_ae457738:

    # MARKUS "If it wasn’t for him, this place would have fallen in 1152."
