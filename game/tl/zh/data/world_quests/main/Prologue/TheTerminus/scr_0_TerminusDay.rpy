# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:519
translate zh qst_Terminus_EnterPalace_27570ac7:

    # MC "My... Training?"
    MC "我的...训练？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:520
translate zh qst_Terminus_EnterPalace_a20cefa7:

    # "..."
    "..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:521
translate zh qst_Terminus_EnterPalace_5c3e3f1d:

    # MC "Capital... What?!"
    MC "首都...什么？！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:522
translate zh qst_Terminus_EnterPalace_1d5e8c4b:

    # MC "I... {i}I’m going to the Scouts?{/i}"
    MC "我...{i}要加入侦察兵团？{/i}"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:523
translate zh qst_Terminus_EnterPalace_b8535060:

    # MC "... No... No! This is... This is wrong!"
    MC "...不...不！这...搞错了！"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:524
translate zh qst_Terminus_EnterPalace_20b35e97:

    # MC "I can’t be in the Scouts! This is..."
    MC "我不该进侦察兵团！这..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:528
translate zh qst_Terminus_EnterPalace_b1631114:

    # "Looking up, I hurried back over the stall, frantically trying to speak to the lady but was immediately restrained by the guards."
    "我猛地抬头冲回登记处，发狂般想对那女人说话，却被卫兵当即拦住。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:529
translate zh qst_Terminus_EnterPalace_5f57996f:

    # "Other students berated me for cutting the line."
    "其他学生因我插队而斥责。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:530
translate zh qst_Terminus_EnterPalace_170b6a29:

    # WOMAN "Sir! Please wait in line for—"
    "女士！请排队等候——"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:531
translate zh qst_Terminus_EnterPalace_5818611d:

    # MC "This! This has to be a mistake! I can’t be in the Scouts! I’m not—"
    MC "这个！一定是弄错了！我不该进侦察兵团！我不是——"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:532
translate zh qst_Terminus_EnterPalace_4f67789a:

    # WOMAN "If it’s got your name on the front and that’s what’s written, then I’m afraid you are, sir."
    WOMAN "若封面是您名字且内容如此，恐怕确实如此，先生。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:533
translate zh qst_Terminus_EnterPalace_4475949c:

    # MC "But I... I—"
    MC "可我...我——"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:534
