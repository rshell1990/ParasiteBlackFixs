translate zh qst_Terminus_EnterPalace_f1887912:

    # MARKUS "... So, you coming?"
    MARKUS "...所以，来吗？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:587
translate zh qst_Terminus_EnterPalace_9cfa39df:

    # MC "I was thinking about joining 阿达拉 at the tavern."
    MC "我正想去酒馆找阿达拉。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:588
translate zh qst_Terminus_EnterPalace_9606cbca:

    # MARKUS "Hmm... I guess that’s fair enough."
    MARKUS "嗯...也行。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:589
translate zh qst_Terminus_EnterPalace_186dd28b:

    # MC "I'll think about it..."
    MC "我再考虑下..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:590
translate zh qst_Terminus_EnterPalace_4e7af60a:

    # MARKUS "{i}*Sigh*{/i} Either way, I guess we'll see each other tomorrow, at the fort."
    MARKUS "{i}*叹气*{/i} 无论如何，明天堡垒见吧。"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:591
translate zh qst_Terminus_EnterPalace_8c2da12d:

    # MC "Y-Yeah..."
    MC "好-好的..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:597
translate zh qst_Terminus_EnterPalace_dd7df583:

    # MC "Yeah?"
    MC "嗯？"

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:594
translate zh qst_Terminus_EnterPalace_f3a2929b:

    # MARKUS "If you do go and meet 阿达拉, tell her how you really feel..."
    MARKUS "如果你去见阿达拉，告诉她你的真实感受..."

# game/data/world_quests/main/Prologue/TheTerminus/scr_0_TerminusDay.rpy:595
