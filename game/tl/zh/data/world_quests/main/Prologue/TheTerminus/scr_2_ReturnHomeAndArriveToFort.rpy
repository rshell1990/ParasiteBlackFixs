# game/data/world_quests/main/Prologue/TheTerminus/scr_2_ReturnHomeAndArriveToFort.rpy:52
translate zh qst_Terminus_ReturnHomeFromEitherTavernOrBordello_aa1ba36f:

    # "I promised her I would be okay, and she made me promise I would come home safe."
