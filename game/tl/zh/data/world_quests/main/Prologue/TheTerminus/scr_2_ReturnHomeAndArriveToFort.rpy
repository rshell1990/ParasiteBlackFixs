# game/data/world_quests/main/Prologue/TheTerminus/scr_2_ReturnHomeAndArriveToFort.rpy:80
translate zh qst_Terminus_ArriveToFort_3a5d6e74:

    # "It was not a welcoming place, cold, bare, and utterly practical."
