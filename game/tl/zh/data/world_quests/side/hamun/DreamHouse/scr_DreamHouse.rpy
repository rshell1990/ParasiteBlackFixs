translate zh qst_dreamhouse_l2_start_menu_68507330:

    # DAVIK "We're not on the same layer right now, not really!"
    DAVIK "我们现在不在同一层，不是真正的同一层！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:779
translate zh qst_dreamhouse_l2_start_menu_0c900b16:

    # DAVIK "The key I need to find isn't the same as yours!"
    DAVIK "我要找的钥匙和你的不一样！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:780
translate zh qst_dreamhouse_l2_start_menu_cd345043:

    # DAVIK "Go, hurry!"
    DAVIK "快去，快！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:781
translate zh qst_dreamhouse_l2_start_menu_933bc08f:

    # DAVIK "I will meet you at the center!"
    DAVIK "我会在中心和你汇合！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:782
translate zh qst_dreamhouse_l2_start_menu_732a35ab:

    # DAVIK "Then we can get my daughter out of this!"
    DAVIK "然后我们就能把我女儿救出去！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:785
translate zh qst_dreamhouse_l2_start_menu_162cd578:

    # MC @ surprised "Wait! Hold on a min-"
    MC @ surprised "等等！等一下——"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:786
translate zh qst_dreamhouse_l2_start_menu_d1ed37c2:

    # "Davik hurried as quickly as he could around a corner, slightly limping as he did so."
    "达维克尽力快步绕过拐角，走路时微微跛行。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:787
translate zh qst_dreamhouse_l2_start_menu_b047e486:

    # "I tried to stop him, but as he exited through one of the doors, it slammed shut behind him."
    "我试图拦住他，但当他从一扇门出去时，门在他身后砰地关上了。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:788
translate zh qst_dreamhouse_l2_start_menu_70252298:

    # "Markus hurried over to try and rip the door open, only to find it bolted shut."
    "马库斯冲过去试图把门扯开，却发现它被闩死了。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:791
translate zh qst_dreamhouse_l2_start_menu_8fcd722f:

    # MARKUS @ angry "It's locked!"
    MARKUS @ angry "锁着的！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:793
translate zh qst_dreamhouse_l2_start_menu_1049c4ec:

    # MC @ angry "Shit!"
    MC @ angry "妈的！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:794
translate zh qst_dreamhouse_l2_start_menu_90df1efb:

    # MC @ think "The key has to be somewhere here... We just need to find it."
    MC @ think "钥匙一定在这附近什么地方……我们只需要找到它。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:795
translate zh qst_dreamhouse_l2_start_menu_e1c93801:

    # KIARA @ scared "Sure... As long as we don't get eaten first."
    KIARA @ scared "当然……只要我们先不被吃掉。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:802
translate zh qst_dreamhouse_l2_bathtub_d56cf1ec:

    # "It tilted its head towards me as I drew my blade!"
    "它歪着头看向我，我拔出了剑！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:812
translate zh qst_dreamhouse_l2_bathtub_e44e84bf:

    # "I noticed something shimmer in the mixed blood water of the bath."
    "我注意到浴缸里混合的血水中有什么东西在闪烁。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:815
translate zh qst_dreamhouse_l2_bathtub_427359f5:

    # "Shoving my hand into the bloody water, I pulled out a small, dull key."
    "我把手伸进血水中，掏出了一把小小的钝钥匙。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:818
translate zh qst_dreamhouse_l2_bathtub_854dd011:

    # KIARA @ scared "I think I might be sick..."
    KIARA @ scared "我想我可能要吐了……"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:821
translate zh qst_dreamhouse_l2_bathtub_dd99af82:

    # "(No way am I putting my hand in that.)"
    "（我才不会把手伸进去呢。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:828
translate zh qst_dreamhouse_l2_mirror_665c1b26:

    # "Looks like there was a struggle in here."
    "看来这里发生过搏斗。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:833
translate zh qst_dreamhouse_l2_bathtub_afterbattle_39e9d55f:

    # "Looks like a mercenary... Maybe one of Davik's men?"
    "看起来像个雇佣兵……也许是达维克的人？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:834
translate zh qst_dreamhouse_l2_bathtub_afterbattle_e44e84bf:

    # "I noticed something shimmer in the mixed blood water of the bath."
    "我注意到浴缸里混合的血水中有什么东西在闪烁。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:837
translate zh qst_dreamhouse_l2_bathtub_afterbattle_427359f5:

    # "Shoving my hand into the bloody water, I pulled out a small, dull key."
    "我把手伸进血水中，掏出了一把小小的钝钥匙。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:840
translate zh qst_dreamhouse_l2_bathtub_afterbattle_854dd011:

    # KIARA @ scared "I think I might be sick..."
    KIARA @ scared "我想我可能要吐了……"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:843
translate zh qst_dreamhouse_l2_bathtub_afterbattle_dd99af82:

    # "(No way am I putting my hand in that.)"
    "（我才不会把手伸进去呢。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:849
translate zh qst_dreamhouse_l2_nursery_oneoff_aec2ef82:

    # "Entering the room, the twisted corpses inside turned their attention towards us."
    "进入房间，里面扭曲的尸体将注意力转向了我们。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:850
translate zh qst_dreamhouse_l2_nursery_oneoff_f98f618e:

    # MC @ scared "Shit!"
    MC @ scared "妈的！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:864
translate zh qst_dreamhouse_l2_toys_caf4fb7b:

    # "Blood-stained and torn up toys."
    "沾满血迹、破烂不堪的玩具。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:868
translate zh qst_dreamhouse_l2_crib_fd87f1dd:

    # "A crib stained in blood."
    "染血的婴儿床。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:873
translate zh qst_dreamhouse_l2_bedroom_door_8e18cd77:

    # MC "(We need the key to unlock this!)"
    MC "（我们需要钥匙来打开这个！）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:877
translate zh qst_dreamhouse_l2_bedroom_door_918f304d:

    # "Inserting the key into the lock, the door swung open as we scrambled through,"
    "把钥匙插入锁孔，门打开了，我们争先恐后地穿了过去，"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:879
translate zh qst_dreamhouse_l2_bedroom_door_538a8f11:

    # "a bright white light enveloping us all as we did so."
    "一道明亮的白光笼罩了我们所有人。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:887
translate zh qst_dreamhouse_l2_candle_4040ce45:

    # MC @ think "(A blue flame... Why?)"
    MC @ think "（一道蓝色的火焰……为什么？）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:893
translate zh qst_dreamhouse_l2_dining_oneoff_82f181a3:

    # "Entering the dining hall, the table had become a ghoulish display of gore, as the creatures crowded around it."
    "进入餐厅，桌子变成了一幅食尸鬼般的血腥景象，怪物们围聚在周围。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:894
translate zh qst_dreamhouse_l2_dining_oneoff_d8a8a7a0:

    # "Guts, blood, and indiscernible flesh sprawled across the table as they grabbed at the meat with their bare hands and devoured it."
    "内脏、鲜血和无法辨认的肉块散落在桌子上，它们徒手抓起肉狼吞虎咽。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:895
translate zh qst_dreamhouse_l2_dining_oneoff_d34ae079:

    # "The wretched smell of rot and death was too much for Kiara, who hurled onto the floor."
    "腐烂和死亡的恶臭让琪亚拉受不了，她吐在了地上。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:896
translate zh qst_dreamhouse_l2_dining_oneoff_fdae0222:

    # KIARA @ scared "Oh gods..."
    KIARA @ scared "哦天啊……"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:897
translate zh qst_dreamhouse_l2_dining_oneoff_6f1abb01:

    # "As she did so, the dead looked up, dropping the meat in their hands as they began shambling towards us!"
    "她这么一吐，死者们抬起头，扔掉手中的肉，开始蹒跚着向我们走来！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:900
translate zh qst_dreamhouse_l2_dining_oneoff_6e8ae10d:

    # MARKUS @ angry "I FUCKING HATE THIS HOUSE!"
    MARKUS @ angry "我他妈恨死这栋房子了！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:911
translate zh qst_dreamhouse_l2_dining_oneoff_a623fccf:

    # MARKUS @ shock "{i}*Huff*{/i} I think that's the last of them."
    MARKUS @ shock "{i}*喘气*{/i} 我觉得这是最后一批了。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:914
translate zh qst_dreamhouse_l2_dining_oneoff_fdd90545:

    # VES @ angry "These creatures only fall when their head is cleaved from their neck!"
    VES @ angry "这些怪物只有头被从脖子上斩下来才会倒下！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:916
translate zh qst_dreamhouse_l2_dining_oneoff_b8b1ec09:

    # VES @ angry "How tedious!"
    VES @ angry "多麻烦！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:919
translate zh qst_dreamhouse_l2_dining_oneoff_4b748bc8:

    # SYPHA @ think "We can't stay here, come on."
    SYPHA @ think "我们不能待在这里，走吧。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:924
translate zh qst_dreamhouse_l2_table_f89a89b8:

    # "(... Gods, what a nightmare.)"
    "（……天啊，真是噩梦。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:929
translate zh qst_dreamhouse_l2_wolfhead_a1f17cb0:

    # "BARK!"
    "汪！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:930
translate zh qst_dreamhouse_l2_wolfhead_4f314bba:

    # "The mounted head snapped towards me with its jaws."
    "那个标本头张开嘴猛地咬向我。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:931
translate zh qst_dreamhouse_l2_wolfhead_41224f04:

    # "(Is it... Is it still alive?)"
    "（它……它还活着吗？）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:936
translate zh qst_dreamhouse_l2_portrait_d934f7a2:

    # "That's... disturbing."
    "这……令人不安。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:942
translate zh qst_dreamhouse_l2_kitchen_oneoff_b0b44ff1:

    # "As we entered the kitchen, I heard the slamming of the cleaver as we looked to find one of the dead,"
    "我们走进厨房，听到砍刀的剁击声，我们看到一个亡灵，"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:943
translate zh qst_dreamhouse_l2_kitchen_oneoff_f0272186:

    # "a huge, decrepit, bulking figure hacking away at a man."
    "一个巨大、腐朽、魁梧的身影正在砍剁一个男人。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:944
translate zh qst_dreamhouse_l2_kitchen_oneoff_ec7e5b88:

    # "Still barely alive and choking on blood, the man reached out towards us in one desperate final act, only for the creature to hack off his fingers with the cleaver."
    "那男人还勉强活着，被血呛着，在绝望的最后挣扎中向我们伸出手，但那怪物用砍刀砍掉了他的手指。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:945
translate zh qst_dreamhouse_l2_kitchen_oneoff_e99e910f:

    # "As the fingers dropped to the floor, the ghoulish creature turned towards us, placing down a platter of the man's remains on the table,"
    "手指掉到地上，那个食尸鬼般的生物转向我们，把一盘那男人的残骸放在桌上，"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:946
translate zh qst_dreamhouse_l2_kitchen_oneoff_b108b59f:

    # "it then stared blankly towards us, expectantly."
    "然后它茫然地盯着我们，带着期待。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:947
translate zh qst_dreamhouse_l2_kitchen_oneoff_64cf87e1:

    # MARKUS @ scared "Does... Does this fucking thing expect us to eat that?!"
    MARKUS @ scared "这……这他妈怪物想让我们吃那个？！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:950
translate zh qst_dreamhouse_l2_kitchen_oneoff_53d44a4b:

    # "Carefully, I reached over to grab a piece of the meat."
    "我小心翼翼地伸手抓起一块肉。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:951
translate zh qst_dreamhouse_l2_kitchen_oneoff_2f9ce75e:

    # "With a shaky hand, I pushed the wet meat into my mouth as the creature offered a drooling grin of approval."
    "用颤抖的手，我把湿漉漉的肉塞进嘴里，那生物流着口水露出赞许的笑容。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:952
translate zh qst_dreamhouse_l2_kitchen_oneoff_ed932dcd:

    # "Markus pulled back in revulsion as Kiara looked like she was about to hurl."
    "马库斯厌恶地向后退，琪亚拉看起来快要吐了。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:953
translate zh qst_dreamhouse_l2_kitchen_oneoff_2bce3932:

    # "The wet meat squeelched between my teeth, almost making me wretch as my eyes began to water from the foul taste."
    "湿肉在我齿间吱嘎作响，恶心的味道让我差点吐出来，眼泪都开始涌出来。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:954
translate zh qst_dreamhouse_l2_kitchen_oneoff_cf947b80:

    # KIARA @ sad "Oh gods... I might... I think I'm gonna be sick."
    KIARA @ sad "哦天啊……我可能……我觉得我要吐了。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:955
translate zh qst_dreamhouse_l2_kitchen_oneoff_d069021e:

    # MARKUS @ scared "What in the hells is wrong with you?"
    MARKUS @ scared "你到底有什么毛病？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:956
translate zh qst_dreamhouse_l2_kitchen_oneoff_d73d8a37:

    # SYPHA @ think "... Is this is some kind of masochistic ritual humans perform?"
    SYPHA @ think "……这是人类某种受虐狂的仪式吗？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:959
translate zh qst_dreamhouse_l2_kitchen_oneoff_18ca7ff7:

    # VES @ think "... Why no salt?"
    VES @ think "……怎么没放盐？"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:961
translate zh qst_dreamhouse_l2_kitchen_oneoff_c5034d4e:

    # "Seemingly satisfied that I had tasted his *food,* the creature went back to cooking, seemingly ignoring us and allowing us to pass."
    "似乎满意于我尝了它的*食物*，那生物回去继续烹饪，似乎无视了我们，让我们通过。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:965
translate zh qst_dreamhouse_l2_kitchen_oneoff_806c733b:

    # "The ghoulish dead creature stared for a moment,"
    "那个食尸鬼般的亡灵盯着看了一会儿，"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:966
translate zh qst_dreamhouse_l2_kitchen_oneoff_1eb9fc7b:

    # "and realizing none of us will eat its {i}food,{/i}"
    "意识到我们谁也不会吃它的{i}食物{/i}，"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:967
translate zh qst_dreamhouse_l2_kitchen_oneoff_5633d180:

    # "it grabbed for the cleaver and swung it wildly towards us!"
    "它抓起砍刀，疯狂地向我们挥来！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:977
translate zh qst_dreamhouse_l2_kitchen_oneoff_4dc50c36:

    # "Stumbling backwards, blood running from the seeping gash in its head from where I struck,"
    "我踉跄后退，它头上被我砍出的伤口渗着血，"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:978
translate zh qst_dreamhouse_l2_kitchen_oneoff_4e90e46e:

    # "in the creature's final moments, it reached up to grab a chunk of meat, stuffing its mouth full of it before it fell silent."
    "在生命的最后时刻，那生物伸手抓起一块肉，塞满嘴巴，然后沉默了。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:985
translate zh qst_dreamhouse_l2_kitchen_cupboards_57333fb4:

    # "The cupboards bled and were filled with nothing but pungent meat in a gory mess."
    "橱柜渗着血，里面全是刺鼻的肉块，一片血腥。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:986
translate zh qst_dreamhouse_l2_kitchen_cupboards_529ca2a3:

    # MC "(I think I'll pass on dessert.)"
    MC "（我想甜点就免了吧。）"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:991
translate zh qst_dreamhouse_l2_kitchen_pot_4b656435:

    # MC "A boiled, severed head floated to the top of the blood stew."
    MC "一颗煮熟的断头浮到了血炖汤的表面。"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:996
translate zh qst_dreamhouse_l2_kitchen_table_0fe1d924:

    # "{i}Why does no one believe me?{/i}"
    "{i}为什么没有人相信我？{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:997
translate zh qst_dreamhouse_l2_kitchen_table_00252d94:

    # "{i}We buried the servant boy the other day, mother says his lungs were sick.{/i}"
    "{i}前几天我们埋葬了那个仆人男孩，妈妈说他的肺病了。{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:998
translate zh qst_dreamhouse_l2_kitchen_table_e5462dc5:

    # "{i}I swear I saw him move, but no one believed me.{/i}"
    "{i}我发誓我看到他动了，但没有人相信我。{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:999
translate zh qst_dreamhouse_l2_kitchen_table_d7e1df6c:

    # "{i}I dreamed he was still moving in that box, and he came to see me that night.{/i}"
    "{i}我梦到他在那个盒子里还在动，那天晚上他来看我了。{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1000
translate zh qst_dreamhouse_l2_kitchen_table_d2e54c8d:

    # "{i}He was all mangled and gross, I screamed, but he was gone when mother came...{/i}"
    "{i}他浑身破烂恶心，我尖叫了，但妈妈来的时候他已经不见了……{/i}"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1007
translate zh qst_dreamhouse_l2_kitchen_to_cellar_9dd37f09:

    # MC @ think "Damn, it's locked!"
    MC @ think "该死，锁着的！"

# game/data/world_quests/side/hamun/DreamHouse/scr_DreamHouse.rpy:1012
