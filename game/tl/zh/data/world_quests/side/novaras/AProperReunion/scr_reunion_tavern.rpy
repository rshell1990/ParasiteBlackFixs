    MC @ talk "天知道审判官发现后会做什么..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:86
translate zh qst_reunion_tavern_e840b16a:

    # MC @ talk "阿达拉, you have to keep quiet about this."
    MC @ talk "阿达拉，你必须对此保密。"

