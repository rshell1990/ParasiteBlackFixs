translate zh qst_reunion_tavern_972a7844:

    # ADARA @ talk "And I will but..."
    ADARA @ talk "我会的，但是..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:88
translate zh qst_reunion_tavern_5921e895:

    # MC @ talk "阿达拉, I’m fine, okay?"
    MC @ talk "阿达拉，我很好，好吗？"

