    ADARA @ talk "发生了什么？"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:30
translate zh qst_reunion_tavern_2844dd59:

    # ADARA @ talk "It must have been terrible... whatever you saw."
    ADARA @ talk "一定很可怕吧...无论你看到了什么。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:44
translate zh qst_reunion_tavern_244b3124:

