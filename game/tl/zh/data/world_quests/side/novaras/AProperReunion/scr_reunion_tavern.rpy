translate zh qst_reunion_tavern_cb51eacf:

    # MC @ talk "Just don’t worry."
    MC @ talk "别担心。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:90
translate zh qst_reunion_tavern_3ab605e9:

    # ADARA @ talk "How can you ask me to not worry about you?"
    ADARA @ talk "你怎么能要求我不担心你？"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:91
translate zh qst_reunion_tavern_df83141d:

    # MC @ talk "阿达拉, {i}I’m fine.{/i}"
    MC @ talk "阿达拉，{i}我很好{/i}。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:92
translate zh qst_reunion_tavern_af768121:

    # MC @ talk "I {i}feel{/i} fine."
    MC @ talk "我{i}感觉{/i}很好。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:93
translate zh qst_reunion_tavern_45e38243:

    # ADARA @ talk "...Alright, if you say so."
    ADARA @ talk "...好吧，既然你这么说。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:94
translate zh qst_reunion_tavern_80c2c498:

    # ADARA @ talk "But if something happens you have to promise me you’ll get it looked at."
    ADARA @ talk "但如果发生什么情况，你必须答应我会去检查。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:95
translate zh qst_reunion_tavern_0c84ba6a:

    # MC @ talk "I promise."
    MC @ talk "我保证。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:96
translate zh qst_reunion_tavern_0a8b4028:

    # "阿达拉 smiled faintly, still anxious and perhaps not entirely believing towards my comment."
    "阿达拉微微笑了笑，仍然焦虑，或许并不完全相信我的话。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:99
translate zh qst_reunion_tavern_ab73a38f:

    # MC @ talk "I can hardly remember much of it."
    MC @ talk "我几乎记不清太多细节。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:100
translate zh qst_reunion_tavern_7453a280:

    # MC @ talk "There was just too much adrenaline coursing through both of us."
    MC @ talk "我们俩当时肾上腺素飙升得太厉害了。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:101
translate zh qst_reunion_tavern_b6dfe4f8:

    # MC @ talk "We managed to find a back passage out and just kept riding back to Novaras as fast as we could."
    MC @ talk "我们设法找到了一条后路，然后以最快速度骑马返回诺瓦拉斯。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:102
translate zh qst_reunion_tavern_6e95d48d:

    # ADARA @ talk "Where did the horses come from?"
    ADARA @ talk "马是从哪儿来的？"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:103
translate zh qst_reunion_tavern_67eacfe5:

    # MC @ talk "They uh, they were just roaming."
    MC @ talk "它们呃，只是随处游荡的马。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:104
translate zh qst_reunion_tavern_42cc88be:

    # MC @ talk "I think they had bolted from the battle and a few had stumbled their way around where we were."
    MC @ talk "我想它们是从战场上逃出来的，有几匹碰巧溜达到了我们所在的地方。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:105
translate zh qst_reunion_tavern_77748251:

    # ADARA @ talk "...R-Right."
    ADARA @ talk "...好-好吧。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:106
translate zh qst_reunion_tavern_0ecc4fca:

    # MC @ talk "阿达拉 didn’t seem entirely convinced with my story, not that it was exactly a very good one."
    MC @ talk "阿达拉似乎并不完全相信我的故事，虽然这故事本身也不算高明。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:107
translate zh qst_reunion_tavern_c473d9e4:

    # ADARA @ talk "...But how did you get back so fast?"
    ADARA @ talk "...但你们怎么回来得这么快？"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:108
translate zh qst_reunion_tavern_dad6bcef:

    # ADARA @ talk "I mean, I heard you came back {i}in a week.{/i}"
    ADARA @ talk "我是说，我听说你们{i}一周内{/i}就回来了。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:109
translate zh qst_reunion_tavern_48a07b7c:

    # MC @ talk "Oh, uh..."
    MC @ talk "哦，呃..."

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:110
translate zh qst_reunion_tavern_cc2d6668:

    # MC @ talk "Well you see, we {i}actually{/i} arrived back about a month ago."
    MC @ talk "其实我们{i}实际上{/i}大约一个月前就回来了。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:111
translate zh qst_reunion_tavern_3526ce6c:

    # ADARA @ talk "A month?"
    ADARA @ talk "一个月？"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:112
translate zh qst_reunion_tavern_45e3abcc:

    # MC @ talk "Yeah, apparently we just collapsed and we’ve been bed-ridden and in and out of consciousness for days."
    MC @ talk "是的，显然我们当时就昏倒了，卧床不起，意识时有时无地持续了好几天。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:113
translate zh qst_reunion_tavern_0f5a8f6f:

    # ADARA @ talk "Really?"
    ADARA @ talk "真的吗？"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:114
translate zh qst_reunion_tavern_ba0e1c6b:

    # MC @ talk "Yeah... really."
    MC @ talk "是的...真的。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:115
translate zh qst_reunion_tavern_d5d1bb96:

    # "I hate lying to her like this, but it’s for the best."
    "我讨厌这样对她撒谎，但这是最好的选择。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:116
translate zh qst_reunion_tavern_8dd6d326:

    # MC @ talk "Sorry to be the bearer of bad news."
    MC @ talk "很抱歉带来坏消息。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:117
translate zh qst_reunion_tavern_b42f44d2:

    # MC @ talk "Our ‘legendary’ ride home is quite the exaggeration."
    MC @ talk "我们'传奇'的归途其实被夸大了很多。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:118
translate zh qst_reunion_tavern_dd17a88e:

    # MC @ talk "No dragons I’m afraid."
    MC @ talk "恐怕没有什么龙。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:119
translate zh qst_reunion_tavern_e63ba1c1:

    # ADARA @ talk "You make a joke out of everything."
    ADARA @ talk "你什么事都能开玩笑。"

# game/data/world_quests/sside/novaras/AProperReunion/scr_reunion_tavern.rpy:120
translate zh qst_reunion_tavern_eca25d5b:

    # MC @ talk "Only the serious stuff."
    MC @ talk "只对严肃的事情开玩笑。"

# game/data/world_quests/side/novaras/AProperReunion/scr_reunion_tavern.rpy:121
translate zh qst_reunion_tavern_8c3f7998:

    # "She sighed, and concluded:"
