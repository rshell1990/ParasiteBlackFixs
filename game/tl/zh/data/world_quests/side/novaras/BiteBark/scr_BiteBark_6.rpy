    MC @ bitelip "我想好好看看你。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:95
translate zh qst_BiteBark_6_McRoomResolution_menu2_c53b50ab:

    # "From the grin on my face, 俄蕾娜 realized quickly what I wanted, and with flushed cheeks she nervously turned around."
    "从我脸上的笑容，俄蕾娜很快明白了我的意图，她脸颊泛红，紧张地转过身去。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:102
translate zh qst_BiteBark_6_McRoomResolution_menu2_c817d36f:

