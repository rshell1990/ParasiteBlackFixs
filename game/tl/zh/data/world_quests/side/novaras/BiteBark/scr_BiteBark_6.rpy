    # ELENA @ smile "Alright, moving on...!"
    ELENA @ smile "好吧，继续...！"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:116
translate zh qst_BiteBark_6_McRoomResolution_menu2_91e61981:

    # ELENA @ grumpy "Lady Grace Thornfall, the last of the Thornfall line."
    ELENA @ grumpy "格蕾丝·索恩菲尔女士，索恩菲尔家族的最后血脉。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:117
translate zh qst_BiteBark_6_McRoomResolution_menu2_e6107bb9:

    # ELENA @ grumpy "Her father Lord Vront made me swear a vow before his passing that I would protect her."
    ELENA @ grumpy "她的父亲弗龙特勋爵在去世前让我发誓要保护她。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:118
translate zh qst_BiteBark_6_McRoomResolution_menu2_80659d8e:

    # ELENA @ grumpy "She was meant to return home from her business abroad but... She has simply vanished."
    ELENA @ grumpy "她本该从国外公务返回家中，但是...她就这样消失了。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:119
translate zh qst_BiteBark_6_McRoomResolution_menu2_bfadb57a:

    # ELENA @ grumpy "I have been looking for her since... Trying to find what I can."
    ELENA @ grumpy "从那以后我一直在寻找她...尽力寻找线索。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:120
translate zh qst_BiteBark_6_McRoomResolution_menu2_d5331bde:

    # MC @ talk "How do you know she isn't just dead?"
    MC @ talk "你怎么知道她不是已经死了？"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:121
translate zh qst_BiteBark_6_McRoomResolution_menu2_41638300:

    # ELENA @ sad "I do not know... Yet whatever the answer, I must know."
    ELENA @ sad "我不知道...但无论答案如何，我必须知道。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:122
translate zh qst_BiteBark_6_McRoomResolution_menu2_95b720bb:

    # ELENA @ sad "So, will you help me?"
    ELENA @ sad "那么，你会帮我吗？"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:126
translate zh qst_BiteBark_6_McRoomResolution_menu2_00475e23:

    # ELENA @ sad "{i}*sigh*{/i} very well... I am sorry for deceiving you so."
    ELENA @ sad "{i}*叹气*{/i} 很好...我很抱歉这样欺骗你。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:127
translate zh qst_BiteBark_6_McRoomResolution_menu2_7a52806a:

    # ELENA @ grumpy "But I must go now."
    ELENA @ grumpy "但我现在必须走了。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:128
translate zh qst_BiteBark_6_McRoomResolution_menu2_265e00c6:

    # MC @ surprised "Are you sure you don't wish to stay? There is no need to leave so soon."
    MC @ surprised "你确定不想留下来吗？没必要这么快离开。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:129
translate zh qst_BiteBark_6_McRoomResolution_menu2_21ba51a9:

    # ELENA @ grumpy "Your offer is kind, but no... She's still out there, I can feel it."
    ELENA @ grumpy "你的提议很友善，但是不...她还在某处，我能感觉到。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:130
translate zh qst_BiteBark_6_McRoomResolution_menu2_3c39cda2:

    # ELENA @ sad "I cannot rest till the lady is safe."
    ELENA @ sad "在女士安全之前，我不能休息。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:131
translate zh qst_BiteBark_6_McRoomResolution_menu2_eca75fbc:

    # ELENA @ grumpy "Farewell... Strange traveller."
    ELENA @ grumpy "再见...奇怪的旅行者。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:135
translate zh qst_BiteBark_6_McRoomResolution_menu2_367cbda8:

    # "In that moment, 俄蕾娜 once again morphed herself down into her blue wolf form, and before I knew it, she had sprinted past me out of the door."
    "那一刻，俄蕾娜再次变回她的蓝色狼形态，还没等我反应过来，她已经从我身边冲出门外。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:142
translate zh qst_BiteBark_6_McRoomResolution_menu2_41405de6:

    # REGINA @ shock_talk "What happened? The wolf-"
    REGINA @ shock_talk "发生了什么？那只狼——"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:143
translate zh qst_BiteBark_6_McRoomResolution_menu2_fea45294:

    # MC @ sad "It's alright, just let her go."
    MC @ sad "没关系，就让她走吧。"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:145
translate zh qst_BiteBark_6_McRoomResolution_menu2_a83859d8:

    # REGINA @ angry "{i}Damn it...{/i}"
    REGINA @ angry "{i}该死...{/i}"

