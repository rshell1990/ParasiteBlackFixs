translate zh qst_BiteBark_6_McRoomResolution_menu2_65150043:

    # MC @ smile "Always happy to help a beautiful lady in need!"
    MC @ smile "总是很乐意帮助有需要的美丽女士！"

# game/data/world_quests/side/novaras/BiteBark/scr_BiteBark_6.rpy:112
translate zh qst_BiteBark_6_McRoomResolution_menu2_027be4c2:

    # ELENA @ shock "{i}Beautiful?{/i}"
    ELENA @ shock "{i}美丽？{/i}"

