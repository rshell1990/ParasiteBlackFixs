    # MARKUS "Fine, but we’ll have to be quick..."
    MARKUS "好吧，但我们必须速战速决..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:4
translate zh qst_DamzelDizzt_2_frontal_2972c58e:

    # MARKUS "The commotion will likely draw the attention of the guards and if they see us we’re in trouble..."
    MARKUS "骚动很可能会引来守卫的注意，如果他们看到我们，我们就麻烦了..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:5
translate zh qst_DamzelDizzt_2_frontal_7c9fd421:

    # NIJAH "Y-You intend to fight zem all?!"
    NIJAH "你-你打算和所有银打？！"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:6
translate zh qst_DamzelDizzt_2_frontal_83589d81:

    # MC @ talk "I do."
    MC @ talk "是的。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:7
translate zh qst_DamzelDizzt_2_frontal_2c197c20:

    # NIJAH "But... You will die!"
    NIJAH "但是...你会死的！"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:8
translate zh qst_DamzelDizzt_2_frontal_8e039c33:

    # MC @ talk "Trust me Nijah, we will not be the ones dying tonight..."
    MC @ talk "相信我，尼雅，今晚死的不会是我们..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:9
translate zh qst_DamzelDizzt_2_frontal_881ada47:

    # MC @ talk "But the guards are a problem 马库斯, you're right."
    MC @ talk "但守卫是个问题，马库斯，你说得对。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:10
translate zh qst_DamzelDizzt_2_frontal_c645d33e:

    # MARKUS "We should scout the place out first at night, before anything."
    MARKUS "我们应该先趁夜侦察一下那个地方。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:11
translate zh qst_DamzelDizzt_2_frontal_c54d1155:

    # MARKUS "At least try get some kind of understanding of what we're up against..."
    MARKUS "至少试着了解一下我们要面对的是什么..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:12
translate zh qst_DamzelDizzt_2_frontal_34a71376:

    # MC @ talk "That's a good idea."
    MC @ talk "好主意。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:13
translate zh qst_DamzelDizzt_2_frontal_b47005bb:

    # MARKUS "Meet me in the Pleasure District tonight, we'll do some scouting from there."
    MARKUS "今晚在欢愉区见我，我们从那里开始侦察。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:14
translate zh qst_DamzelDizzt_2_frontal_d4f4b8d8:

    # NIJAH "I come."
    NIJAH "我也去。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:15
translate zh qst_DamzelDizzt_2_frontal_e87bac32:

    # MC @ talk "It's too dangerous Nijah, if they see you with us they could try something."
    MC @ talk "太危险了，尼雅，如果他们看到你和我们在一起，他们可能会采取行动。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:16
translate zh qst_DamzelDizzt_2_frontal_6d31a3ce:

    # NIJAH @ sad "But-"
    NIJAH @ sad "但是-"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:17
translate zh qst_DamzelDizzt_2_frontal_cb4922bc:

    # MC @ talk "Can you handle a sword?"
    MC @ talk "你会用剑吗？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:18
translate zh qst_DamzelDizzt_2_frontal_a6530312:

    # NIJAH "I... No."
    NIJAH "我...不会。"

# game/data/world_quests/sside/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:19
translate zh qst_DamzelDizzt_2_frontal_b11ddb34:

    # MC @ talk "If they catch us Nijah, we might not be able to protect you."
    MC @ talk "如果他们抓到我们，尼雅，我们可能保护不了你。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:20
translate zh qst_DamzelDizzt_2_frontal_f0d24a92:

    # MC @ talk "It's too dangerous..."
    MC @ talk "太危险了..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:21
translate zh qst_DamzelDizzt_2_frontal_849a9251:

    # "Nijah looked like she might say something at first, but instead she bite her lip and nodded reluctantly."
    "尼雅起初似乎想说什么，但她咬住嘴唇，不情愿地点了点头。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:22
translate zh qst_DamzelDizzt_2_frontal_83dc5d60:

    # NIJAH "Y-Yes, I stay."
    NIJAH "好-好的，我留下。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:23
translate zh qst_DamzelDizzt_2_frontal_9d5a99fb:

    # MC @ talk "We'll be back shortly, promise."
    MC @ talk "我们很快回来，我保证。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:24
translate zh qst_DamzelDizzt_2_frontal_2c1af5ac:

    # NIJAH "A-Alright..."
    NIJAH "好-好吧..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:37
translate zh qst_DamzelDizzt_2_ScoutDiamond_e64bc50d:

    # MARKUS "There you are."
    MARKUS "你来了。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:38
translate zh qst_DamzelDizzt_2_ScoutDiamond_5df5f812:

    # MARKUS "Are you ready for this?"
    MARKUS "准备好了吗？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:41
translate zh qst_DamzelDizzt_2_ScoutDiamond_b3e0fd21:

    # MARKUS "Alright, let's head up onto some of these rooftops and scout out the perimeter."
    MARKUS "好了，我们上这些屋顶，侦察一下周边。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:42
translate zh qst_DamzelDizzt_2_ScoutDiamond_9e409d08:

    # MC @ talk "Sounds like a plan."
    MC @ talk "听你的。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:46
translate zh qst_DamzelDizzt_2_ScoutDiamond_0ccccc57:

    # "Clambering onto the rooftops, we moved our way as silently as we could and watched from afar."
    "我们爬上屋顶，尽可能悄无声息地移动，从远处观察。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:47
translate zh qst_DamzelDizzt_2_ScoutDiamond_98aa6d51:

    # "Here and there the odd guards, always in twos, would patrol around the boundaries of the Black Diamond, while another two always stayed at the Entrance."
    "零星散落的守卫，总是两人一组，在黑钻边界巡逻，而另外两人总是守在入口处。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:48
translate zh qst_DamzelDizzt_2_ScoutDiamond_b8cf3b79:

    # "From inside, I focused and could hear a few dozen heart beats, but it was impossible to tell the difference between the clients, girls and guards."
    "从内部，我集中精神能听到几十个心跳，但无法区分客人、女孩和守卫。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:49
translate zh qst_DamzelDizzt_2_ScoutDiamond_b484682b:

    # "After some time we decided to take a closer look."
    "过了一段时间，我们决定靠近些观察。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:50
translate zh qst_DamzelDizzt_2_ScoutDiamond_6f33ab64:

    # "Climbing in through one of the windows, we watched and looked down from the rafters concealed in darkness... Seeing the Black Diamond below."
    "我们从一扇窗户爬进去，躲在黑暗的椽木上向下观察...看着下方的黑钻。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:58
translate zh qst_DamzelDizzt_2_ScoutDiamond_18b3f7b5:

    # MC "(Can you hear me?)"
    MC "(能听到我说话吗？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:59
translate zh qst_DamzelDizzt_2_ScoutDiamond_ff3583df:

    # MARKUS "(Yes, now quit shouting!)"
    MARKUS "(能，现在别喊了！)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:60
translate zh qst_DamzelDizzt_2_ScoutDiamond_3681b84f:

    # MC "(I'm not shouting! I'm just not used to talking with my mouth shut!)"
    MC "(我没喊！我只是不习惯闭嘴说话！)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:61
translate zh qst_DamzelDizzt_2_ScoutDiamond_8c1d2014:

    # MARKUS "(Bah! Focus! How many guards can you see?)"
    MARKUS "(呸！集中精神！你能看到多少守卫？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:62
translate zh qst_DamzelDizzt_2_ScoutDiamond_e9934e8c:

    # "Through the darkness I peered around, my vision once I focused in, was able to make out through these strange red like outlines where people stood even in pitch black corners."
    "我在黑暗中环顾四周，一旦集中精神，我的视野就能透过这些奇怪的红色轮廓分辨出人们的位置，即使在漆黑的角落也是如此。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:63
translate zh qst_DamzelDizzt_2_ScoutDiamond_d6466b18:

    # MC "(...I count fourteen here.)"
    MC "(...我这里数到十四个。)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:64
translate zh qst_DamzelDizzt_2_ScoutDiamond_60823c7e:

    # MARKUS "(There is probably more upstairs.)"
    MARKUS "(楼上可能还有更多。)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:65
translate zh qst_DamzelDizzt_2_ScoutDiamond_d8176576:

    # MC "(Don't suppose you two have anything to say.)"
    MC "(你们俩没什么要说的吗？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:66
translate zh qst_DamzelDizzt_2_ScoutDiamond_3abf4d2e:

    # BLACK "{i}(Something beneath feet...){/i}"
    BLACK "{i}(脚下有东西……){/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:67
translate zh qst_DamzelDizzt_2_ScoutDiamond_d916bdad:

    # BLACK "{i}(Can hear it... rumbling.){/i}"
    BLACK "{i}(能听到……轰隆声。){/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:68
translate zh qst_DamzelDizzt_2_ScoutDiamond_411aa358:

    # WHITE "{i}(Cautious... More danger than appears.){/i}"
    WHITE "{i}(要小心……危险超乎想象。){/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:69
translate zh qst_DamzelDizzt_2_ScoutDiamond_4cb5d00d:

    # MARKUS "(Well, what is it?)"
    MARKUS "(嗯，是什么？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:70
translate zh qst_DamzelDizzt_2_ScoutDiamond_cae525a0:

    # MARKUS "(...Hello? HELLO!)"
    MARKUS "(...喂？喂！)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:71
translate zh qst_DamzelDizzt_2_ScoutDiamond_9fd7c1db:

    # MARKUS "(Fucking hells! Why do they just stop talking like that?)"
    MARKUS "(他妈的真见鬼！他们为什么就那样不说话了？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:72
translate zh qst_DamzelDizzt_2_ScoutDiamond_259dbccd:

    # MC "(We should go 马库斯, before someone notices us here.)"
    MC "(我们该走了，马库斯，趁还没人发现我们。)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:73
translate zh qst_DamzelDizzt_2_ScoutDiamond_69dbec03:

    # MARKUS "(Yes, we should-)"
    MARKUS "(是的，我们应该-)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:74
translate zh qst_DamzelDizzt_2_ScoutDiamond_d3d687e0:

    # MARKUS "(Hold on, that one... Is that our man?)"
    MARKUS "(等等，那个...是我们的目标吗？)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:75
translate zh qst_DamzelDizzt_2_ScoutDiamond_57d0ba51:

    # "We watched as the one bandit strolled his way into the Black Diamond, he looked different than the others, and four bandit guards walked protectively alongside him."
    "我们看着那个匪徒漫步走进黑钻，他看起来和其他人不同，四名匪徒守卫保护性地走在他身边。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:76
translate zh qst_DamzelDizzt_2_ScoutDiamond_f21f5bbd:

    # "As he entered, all eyes seemed to turn towards him, and one of the bandits moved out to greet him."
    "当他进入时，所有的目光似乎都转向了他，其中一个匪徒走出来迎接他。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:86
translate zh qst_DamzelDizzt_2_ScoutDiamond_2c87a044:

    # BANDIT "Great Khan, I am here to deliver your tribute from your vassals."
    BANDIT "伟大的可汗，我来此献上您封臣的贡品。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:87
translate zh qst_DamzelDizzt_2_ScoutDiamond_01329b9a:

    # TAREK "And who pays me greatest tribute today?"
    TAREK "今天谁献给我的贡品最多？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:88
translate zh qst_DamzelDizzt_2_ScoutDiamond_9fe53e57:

    # BANDIT "...The khazahs my khan."
    BANDIT "...是卡扎部族，我的可汗。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:89
translate zh qst_DamzelDizzt_2_ScoutDiamond_086a66c9:

    # TAREK "The Khazahs... {i}again?{/i}"
    TAREK "卡扎部族... {i}又是他们？{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:90
translate zh qst_DamzelDizzt_2_ScoutDiamond_420bfaae:

    # TAREK @ angry "Should I always expect the Vulshans to fall behind everytime now?"
    TAREK @ angry "我现在是不是该每次都预料到瓦尔珊部族会落后？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:91
translate zh qst_DamzelDizzt_2_ScoutDiamond_2ca400bc:

    # BANDIT "We are pushing our men as hard as we can!"
    BANDIT "我们已经在尽全力督促我们的人了！"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:92
translate zh qst_DamzelDizzt_2_ScoutDiamond_f02ad6a1:

    # BANDIT "But with your restrictions, things are... {i}difficult.{/i}"
    BANDIT "但有了您的限制，事情就... {i}难办了。{/i}"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:93
translate zh qst_DamzelDizzt_2_ScoutDiamond_f27624bd:

    # TAREK "My rules are in place to protect all of us."
    TAREK "我的规则是为了保护我们所有人。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:94
translate zh qst_DamzelDizzt_2_ScoutDiamond_209850d6:

    # TAREK @ angry "But I don't see the Khazahs complaining about them."
    TAREK @ angry "但我没看到卡扎部族对此有怨言。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:95
translate zh qst_DamzelDizzt_2_ScoutDiamond_91981a6f:

    # BANDIT "...Of course Great Khan, we will do better next time."
    BANDIT "...当然，伟大的可汗，我们下次会做得更好。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:96
translate zh qst_DamzelDizzt_2_ScoutDiamond_234ae860:

    # TAREK "See it done."
    TAREK "务必做到。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:103
translate zh qst_DamzelDizzt_2_ScoutDiamond_76b5605d:

    # "As Tarek marched off, I could sense the furious rage brewing inside the man he just spoke to."
    "塔雷克大步离开时，我能感觉到刚才与他交谈的那个人内心酝酿着狂怒。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:104
translate zh qst_DamzelDizzt_2_ScoutDiamond_7ec425d1:

    # "If I didn't know any better, one would think he wanted to {i}kill{/i} Tarek."
    "如果我不知道内情，会以为他想{i}杀了{/i}塔雷克。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:109
translate zh qst_DamzelDizzt_2_ScoutDiamond_25a5b2ae:

    # MC "(I've seen enough, come on, before we are seen...)"
    MC "(我看够了，走吧，趁还没被发现...)"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:114
translate zh qst_DamzelDizzt_2_ScoutDiamond_cbd1dccc:

    # MARKUS "Don't be too long."
    MARKUS "别耽搁太久。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:128
translate zh qst_DamzelDizzt_2_frontal_return_b20d2376:

    # NIJAH "You're back!"
    NIJAH "你们回来了！"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:129
translate zh qst_DamzelDizzt_2_frontal_return_42308e1f:

    # MC @ talk "We scouted the place out, it's heavily guarded but we think we can take it."
    MC @ talk "我们侦察了那个地方，守卫森严，但我们认为能拿下。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:131
translate zh qst_DamzelDizzt_2_frontal_return_0e20432e:

    # MARKUS "And that amount of guards is nothing to laugh at!"
    MARKUS "而且那么多守卫可不是闹着玩的！"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:132
translate zh qst_DamzelDizzt_2_frontal_return_459c414c:

    # MC @ talk "We'll need to be prepared for it..."
    MC @ talk "我们需要为此做好准备..."

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_2_1.rpy:133
translate zh qst_DamzelDizzt_2_frontal_return_5505452a:

