    THUG @ talk "你知道吗？就...走开，等你回来再试一次，好吗？"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_2.rpy:15
translate zh qst_DamzelDizzt_3_headToOffice_f84bcf96:

