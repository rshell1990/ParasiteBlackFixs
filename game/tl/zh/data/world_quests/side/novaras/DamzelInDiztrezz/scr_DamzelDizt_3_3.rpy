translate zh qst_DamzelDizzt_3_ruckus_TarekDead_2131a5b9:

    # MC @ talk "We don’t have time to explain, we have to leave now!"
    MC @ talk "我们没有时间解释，必须马上离开！"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:142
translate zh qst_DamzelDizzt_3_ruckus_TarekDead_0dfc2cee:

    # "Nijah, still pale white from seeing us feasting on Tarek, led us back up the stairs in a hurry."
    "妮雅看到我们吞噬塔雷克的场景后仍然脸色苍白，匆忙带我们回到楼梯上。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:143
translate zh qst_DamzelDizzt_3_ruckus_TarekDead_57aa45b0:

    # NIJAH "We go now! Guards coming!"
    NIJAH "我们现在就走！守卫来了！"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:147
translate zh qst_DamzelDizzt_3_ruckus_TarekDead_f24beaea:

    # "In the distance, we could hear the shouts of the guards heading our way, and quickly clambered onto the rooftops of buildings where under the veil of darkness we crept out of the Pleasure District."
    "在远处，我们能听到守卫朝我们方向来的喊叫声，迅速爬上了建筑物的屋顶，在黑暗的掩护下爬出了欢愉区。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:148
translate zh qst_DamzelDizzt_3_ruckus_TarekDead_8bb9ae24:

    # "Somehow, we had pulled it off, and behind me down below, I could see the guards rushing towards the chaos below."
    "不知何故，我们成功了，在我身后下方，我可以看到守卫冲向下面的混乱场面。"

# game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:149
translate zh qst_DamzelDizzt_3_ruckus_TarekDead_031f2483:

    # "But by then, we had long vanished."
    "但到那时，我们早已消失无踪。"

translate zh strings:

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:3
    old "*Lie* We are working for the Inquisitors; we have been watching you for a while now."
    new "*撒谎* 我们是审判官的人；我们已经监视你有一阵子了。"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:3
    old "I want you to leave Novaras."
    new "我要你离开诺瓦拉斯。"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:3
    old "{image=[ICON.HEART_BROKE]} We want gold in exchange for Nijah, we know you want her."
    new "{image=[ICON.HEART_BROKE]} 我们要用妮雅换黄金，我们知道你想要她。"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:3
    old "Are you ready for the sweet embrace of death?"
    new "你准备好接受死亡的甜蜜拥抱了吗？"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:25
    old "The uniform tends to draw too attention for more... {i}delicate{/i} matters such as this."
    new "制服对于像这样更...{i}微妙{/i}的事情来说太容易引人注目了。"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:25
    old "Fuck it, all this talking is starting to bore me. I'd much rather just fucking eviscerate you."
    new "去他妈的，所有这些谈话开始让我厌烦了。我他妈更宁愿直接把你开膛破肚。"

    # game/data/world_quests/side/novaras/DamzelInDiztrezz/scr_DamzelDizt_3_3.rpy:25
