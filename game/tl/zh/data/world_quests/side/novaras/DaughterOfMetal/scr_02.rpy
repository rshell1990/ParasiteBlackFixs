# game/data/world_quests/sside/novaras/DaughterOfMetal/scr_02.rpy:218
translate zh qst_DaughterOfMetal_02_2_a72738d6:

    # MC "... Not exactly the reaction I was hoping for..."
    MC "... 不是我期望的反应..."

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:219
translate zh qst_DaughterOfMetal_02_2_75937733:

    # MC "I better leave her be."
    MC "我还是别打扰她了。"

# game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:220
translate zh qst_DaughterOfMetal_02_2_84b4da34:

    # "I left the Blacksmiths, closing the door behind me as I did so."
    "我离开了铁匠铺，随手关上了门。"

translate zh strings:

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:32
    old "What are you talking about?"
    new "你在说什么？"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:32
    old "For what? Wanting jobs where we weren’t at risk of starving?"
    new "为了什么？想要一份不会饿死的工作？"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:32
    old "I know, it’s hard being better than everyone else sometimes, but I try."
    new "我知道，有时候比别人优秀是很难，但我在努力。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:74
    old "I’m sorry."
    new "我很抱歉。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:74
    old "{image=[ICON.HEART_BROKE]} I’m not sorry."
    new "{image=[ICON.HEART_BROKE]} 我不觉得抱歉。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:125
    old "You don’t want to know."
    new "你不会想知道的。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:173
    old "Novaras Farmlands"
    new "诺瓦拉斯农田"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:196
    old "Go to bed. You’re drunk."
    new "去睡觉吧。你醉了。"

    # game/data/world_quests/side/novaras/DaughterOfMetal/scr_02.rpy:196
    old "Humour her."
    new "配合她一下。"

