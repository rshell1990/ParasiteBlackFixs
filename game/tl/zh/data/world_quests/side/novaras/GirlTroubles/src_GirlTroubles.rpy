    # DIVINE @ talk "I didn't quite realize she felt that way, I never intended to make her feel unwanted."
    DIVINE @ talk "我没有完全意识到她有这种感觉，我从未想让她感到被冷落。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:120
translate zh qst_girl_troubles_main_label_menu_4_91c8563f:

    # DIVINE @ embar "... Very well, tell 美嘉 to meet me in the tower bathhouse tonight."
    DIVINE @ embar "...很好，告诉美嘉今晚在塔楼浴场见我。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:121
