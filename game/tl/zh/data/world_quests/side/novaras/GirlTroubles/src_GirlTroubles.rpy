translate zh qst_girl_troubles_main_label_menu_4_7bdaee64:

    # DIVINE @ sad "The girls ... Us Mages of Palam, it's a terribly lonely life."
    DIVINE @ sad "这些女孩……我们帕拉姆的法师，生活非常孤独。"

# game/data/world_quests/side/novaras/GirlTroubles/src_GirlTroubles.rpy:113
