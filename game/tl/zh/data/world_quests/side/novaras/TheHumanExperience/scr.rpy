    MC @ talk "每个地方都称为'区'，它们都有不同的用途。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:315
translate zh qst_HumanExp_6_cityTour_697157e2:

    # MYU "Are the other districts nicer than this one?"
    MYU "其他区比这个更好吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:316
translate zh qst_HumanExp_6_cityTour_b755bb64:

    # MC @ talk "Of course, much nicer."
    MC @ talk "当然，好得多。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:317
translate zh qst_HumanExp_6_cityTour_092e4223_1:

    # MYU "...Why?"
    MYU "...为什么？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:318
translate zh qst_HumanExp_6_cityTour_5a4637c8:

    # MYU "Are the people here... {i}not needed?{/i}"
    MYU "这里的人...{i}不被需要？{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:319
translate zh qst_HumanExp_6_cityTour_82fc95a5:

    # MC @ smile "The people here are the most important, they keep everything going."
    MC @ smile "这里的人是最重要的，他们维持一切运转。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:320
translate zh qst_HumanExp_6_cityTour_a03f9770:

    # MYU "...Then why do they not live in the nice districts?"
    MYU "...那他们为什么不住在好区？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:321
translate zh qst_HumanExp_6_cityTour_0e744dc8:

    # MC @ sad "It's... complicated."
    MC @ sad "这...很复杂。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:322
translate zh qst_HumanExp_6_cityTour_4fd8abf7:

    # MC @ sad "Things are harder now because of the war."
    MC @ sad "因为战争，现在情况更艰难了。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:323
translate zh qst_HumanExp_6_cityTour_cd8d44d9:

    # MC @ talk "Hopefully after the war, people will go back to living much better lives like they used to before."
    MC @ talk "希望战争结束后，人们能回到以前那样的更好生活。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:324
translate zh qst_HumanExp_6_cityTour_d81b8530:

    # MYU "Do the rich people live harder lives as well?"
    MYU "有钱人也生活得更艰难吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:325
translate zh qst_HumanExp_6_cityTour_d37ab87f:

    # MC @ think "Well, not exactly."
    MC @ think "嗯，不完全是这样。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:326
translate zh qst_HumanExp_6_cityTour_092e4223_2:

    # MYU "...Why?"
    MYU "...为什么？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:327
translate zh qst_HumanExp_6_cityTour_0e70507b:

    # MC @ talk "It depends on the person, 米尤."
    MC @ talk "这取决于个人，米尤。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:328
translate zh qst_HumanExp_6_cityTour_a8c013cf:

    # MC @ talk "Even if they have suffered because of the war, many still have enough wealth to get by comfortably."
    MC @ talk "即使他们因战争遭受损失，许多人仍有足够的财富舒适度日。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:329
translate zh qst_HumanExp_6_cityTour_27ce3319:

    # MC @ talk "Let's move on now."
    MC @ talk "我们继续走吧。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:330
translate zh qst_HumanExp_6_cityTour_6060f786:

    # MC @ talk "There's much more to see."
    MC @ talk "还有很多要看的地方。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:338
translate zh qst_HumanExp_6_cityTour_a636ce6d:

    # MC @ talk "There is where students come to learn how to use their magic."
    MC @ talk "这是学生们学习如何使用魔法的地方。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:339
translate zh qst_HumanExp_6_cityTour_05fa9bc8:

    # MYU "Do you have magic?"
    MYU "你有魔法吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:340
translate zh qst_HumanExp_6_cityTour_4800c544:

    # MC @ talk "No, I failed every test on it."
    MC @ talk "没有，我所有的测试都失败了。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:342
translate zh qst_HumanExp_6_cityTour_39c86d5f:

    # MC @ talk "Or, you get stuck with the regular schooling like the rest of us."
    MC @ talk "或者，像我们其他人一样接受常规教育。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:343
translate zh qst_HumanExp_6_cityTour_3235e42a:

    # MYU "...Is 米尤 magic?"
    MYU "...米尤是魔法吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:344
translate zh qst_HumanExp_6_cityTour_c8bb141f:

    # MC @ think "You're a being of magical descent, so you likely have {i}some{/i} magic."
    MC @ think "你是魔法后裔，所以可能拥有{i}一些{/i}魔法。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:345
translate zh qst_HumanExp_6_cityTour_bfd4899f:

    # MYU "Hrghhhhh!"
    MYU "呃啊啊啊！"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:346
translate zh qst_HumanExp_6_cityTour_60ccbb87:

    # MC @ surprised "What are you doing?"
    MC @ surprised "你在做什么？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:347
translate zh qst_HumanExp_6_cityTour_9209d41d:

    # MYU "Trying to magic! I wanna see if I can make bacon appear!"
    MYU "尝试使用魔法！我想看看能不能变出培根！"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:348
translate zh qst_HumanExp_6_cityTour_75426a97:

    # MC @ smile2 "It doesn't quite work like that."
    MC @ smile2 "魔法不是这样工作的。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:349
translate zh qst_HumanExp_6_cityTour_b0674f86:

    # MYU "Aww..."
    MYU "啊..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:350
translate zh qst_HumanExp_6_cityTour_d3335976:

    # MC @ talk "There's a lot of rules to magic, all of which, I don't even fully understand myself."
    MC @ talk "魔法有很多规则，其中很多我自己都不完全理解。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:351
translate zh qst_HumanExp_6_cityTour_0dc3a2f7:

    # MC @ talk "Anyway, let's keep moving, shall we?"
    MC @ talk "总之，我们继续前进吧？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:359
translate zh qst_HumanExp_6_cityTour_89b56d18:

    # MC @ talk "There is where farmers work and live."
    MC @ talk "这是农民工作和生活的地方。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:360
translate zh qst_HumanExp_6_cityTour_6ff4798e:

    # MC @ talk "Huge fields of land inside these walls are used for farming so that Novaras can sustain itself in the event of a siege."
    MC @ talk "城墙内的大片土地用于耕作，这样Novaras在被围困时能够自给自足。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:361
translate zh qst_HumanExp_6_cityTour_f47ac91e:

    # MYU "Siege?"
    MYU "围困？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:362
translate zh qst_HumanExp_6_cityTour_fccbf799:

    # MC @ serious "If the Demorai tries to take this place, we could hold out for months, hopefully waiting on reinforcements from the North."
    MC @ serious "如果Demorai试图占领这里，我们可以坚持数月，希望等待北方的援军。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:363
translate zh qst_HumanExp_6_cityTour_a450f072:

    # MYU "Ooooooh."
    MYU "哦哦哦。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:364
translate zh qst_HumanExp_6_cityTour_bb20e0aa:

    # MYU "So, can we get food here?"
    MYU "那么，我们能在这里弄到食物吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:365
translate zh qst_HumanExp_6_cityTour_c02730c7:

    # MYU "米尤, hungry."
    MYU "米尤，饿了。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:366
translate zh qst_HumanExp_6_cityTour_a640ddce:

    # MC @ talk "No, the food here is rationed out to the army and districts."
    MC @ talk "不行，这里的食物是配给军队和各区的。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:367
translate zh qst_HumanExp_6_cityTour_10d1c41a:

    # MC @ talk "Everyone is given a bit of food, some more than others depending on their district."
    MC @ talk "每个人都会分到一些食物，根据所在区的不同，有些人分到的更多。"

# game/data/world_quests/sside/novaras/TheHumanExperience/scr.rpy:368
translate zh qst_HumanExp_6_cityTour_9eee31e8:

    # MC @ talk "But you can buy additional food from what they allocate to the merchants to sell."
    MC @ talk "但你可以从分配给商人出售的份额中购买额外的食物。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:369
translate zh qst_HumanExp_6_cityTour_45ea512f:

    # MYU "Why..."
    MYU "为什么..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:370
translate zh qst_HumanExp_6_cityTour_06a8db09:

    # "米尤 puzzled out her thoughts."
    "米尤困惑地思考着。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:371
translate zh qst_HumanExp_6_cityTour_95c66aed:

    # MYU "Some get more than others?"
    MYU "有些人得到的比其他人多？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:372
translate zh qst_HumanExp_6_cityTour_4c622349:

    # MYU "If they are rich, Why they not just buy more food anyway?"
    MYU "如果他们有钱，为什么他们不直接买更多食物呢？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:373
translate zh qst_HumanExp_6_cityTour_07a7a739:

    # MYU "Then more food... For poor."
    MYU "那样就有更多食物...给穷人。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:374
translate zh qst_HumanExp_6_cityTour_2ca9bbe8:

    # MC @ think "Well, yes..."
    MC @ think "嗯，是的..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:375
translate zh qst_HumanExp_6_cityTour_3b20968d:

    # MC @ smile "I guess no one's ever really thought about it much."
    MC @ smile "我想没人真正深入思考过这个问题。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:376
translate zh qst_HumanExp_6_cityTour_a812c05c:

    # MC @ think "This is all some of us have ever known."
    MC @ think "这就是我们一些人所知道的一切。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:377
translate zh qst_HumanExp_6_cityTour_0d3e6227:

    # MYU "Not seem fair."
    MYU "似乎不公平。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:380
translate zh qst_HumanExp_6_cityTour_aff12971:

    # MYU "...Okay, 米尤 think on what you said."
    MYU "...好吧，米尤会思考你说的话。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:381
translate zh qst_HumanExp_6_cityTour_e55b4a01:

    # MYU "But, if they {i}aren't{/i} responsible with money and power, is it not okay to punish them then?"
    MYU "但是，如果他们{i}不能{/i}负责任地使用金钱和权力，那么惩罚他们不对吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:383
translate zh qst_HumanExp_6_cityTour_556bd6d7:

    # MYU "Mmm, won't people get hurt if you try get rid of them though?"
    MYU "嗯，但如果你试图除掉他们，不会有人受伤吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:384
translate zh qst_HumanExp_6_cityTour_e624755c:

    # MYU "米尤 would be sad to see people hurt."
    MYU "米尤会为看到人们受伤而难过。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:385
translate zh qst_HumanExp_6_cityTour_f6a22ab9:

    # MYU "And more people might be upset if you DO get rid of them, so even more people get hurt then."
    MYU "而且如果你真的除掉他们，可能会有更多人不满，那样受伤的人会更多。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:386
translate zh qst_HumanExp_6_cityTour_607c1516:

    # MC @ smile "Very perceptive, 米尤."
    MC @ smile "很有洞察力，米尤。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:388
translate zh qst_HumanExp_6_cityTour_b82a42dc:

    # MYU "But, who put them in charge?"
    MYU "但是，是谁让他们负责的？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:389
translate zh qst_HumanExp_6_cityTour_989e19c4:

    # MYU "It sounds to 米尤 like they also {i}have{/i} more just for making choices for everyone else."
    MYU "在米尤听来，他们似乎{i}拥有{/i}更多，只因为他们为其他人做决定。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:390
translate zh qst_HumanExp_6_cityTour_ee1c3eb6:

    # MYU "And, those choices seem to be more good for them than everyone."
    MYU "而且，这些选择似乎对他们自己比对大家更有利。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:391
translate zh qst_HumanExp_6_cityTour_a3f80df8:

    # MC @ smile "Heh, you're learning to speak and think way too fast for your own good sometimes, 米尤."
    MC @ smile "嘿，你学习和思考的速度有时快得对你自己没好处，米尤。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:392
translate zh qst_HumanExp_6_cityTour_7368d55b:

    # MYU "... 米尤 do bad?"
    MYU "...米尤做错了吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:393
translate zh qst_HumanExp_6_cityTour_48449b6e:

    # MC @ smile "Not at all, 米尤."
    MC @ smile "完全没有，米尤。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:394
translate zh qst_HumanExp_6_cityTour_0d7cba86:

    # MC @ talk "Anyway, moving on..."
    MC @ talk "总之，继续前进..."

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:402
translate zh qst_HumanExp_6_cityTour_6dadeaea:

    # MC @ talk "This is where most normal students are taught."
    MC @ talk "这是大多数普通学生学习的地方。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:403
translate zh qst_HumanExp_6_cityTour_7506ecb0:

    # MYU "Its so big!"
    MYU "好大啊！"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:404
translate zh qst_HumanExp_6_cityTour_208990a5:

    # MC @ talk "Hundreds if not thousands are taught here every day."
    MC @ talk "每天有数百甚至数千人在这里学习。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:405
translate zh qst_HumanExp_6_cityTour_4667a551:

    # MYU "What do you learn?"
    MYU "你们学什么？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:406
translate zh qst_HumanExp_6_cityTour_9f10a707:

    # MC @ smile "A lot actually, everything from basic defense to economics to about a hundred other things."
    MC @ smile "实际上很多，从基本防御到经济学，大约有一百多种东西。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:407
translate zh qst_HumanExp_6_cityTour_fe04ca43:

    # MC @ talk "The idea is they delegate you into a job best suited to your results during a festival we call the Terminus ceremony."
    MC @ talk "目的是在我们称为Terminus仪式的节日期间，根据你的成绩将你分配到最适合的工作。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:408
translate zh qst_HumanExp_6_cityTour_0f714875:

    # MYU "What if you get a job you don't like?"
    MYU "如果你得到一份不喜欢的工作怎么办？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:409
translate zh qst_HumanExp_6_cityTour_c971a6fc:

    # MC @ talk "Well, you're stuck with it."
    MC @ talk "嗯，你只能接受。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:410
translate zh qst_HumanExp_6_cityTour_7a523241:

    # MC @ talk "At least, until this war is over."
    MC @ talk "至少，直到这场战争结束。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:411
translate zh qst_HumanExp_6_cityTour_0d4f6c3b:

    # MC @ talk "But it doesn't always stay that way anyway, I mean, I was a scout, and now I'm officially employed by the Adventurers Guild."
    MC @ talk "但并不总是这样，我的意思是，我曾经是侦察兵，现在正式受雇于冒险者公会。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:412
translate zh qst_HumanExp_6_cityTour_2656b8c9:

    # MC @ talk "But those changes aren't the norm, more like, special circumstances."
    MC @ talk "但这些变化不是常态，更像是特殊情况。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:413
translate zh qst_HumanExp_6_cityTour_d31503ba:

    # MYU "米尤 see."
    MYU "米尤明白了。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:414
translate zh qst_HumanExp_6_cityTour_7bd3d9dc:

    # MYU "Do all students learn together?"
    MYU "所有学生都一起学习吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:415
translate zh qst_HumanExp_6_cityTour_cc27e227:

    # MC @ talk "Mostly."
    MC @ talk "大部分是。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:416
translate zh qst_HumanExp_6_cityTour_f2f40a67:

    # MYU "{i}...Mostly?{/i}"
    MYU "{i}...大部分？{/i}"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:417
translate zh qst_HumanExp_6_cityTour_f19c15dd:

    # MC @ talk "The rich students tend to have different teachers and some additional classes than most of us."
    MC @ talk "有钱的学生往往有不同的老师，还有一些我们大多数人没有的额外课程。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:418
translate zh qst_HumanExp_6_cityTour_d5c5fa1d:

    # MC @ talk "But other than that, yeah, we share lessons."
    MC @ talk "但除此之外，是的，我们共享课程。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:419
translate zh qst_HumanExp_6_cityTour_dbf0e0be:

    # MYU "So, do rich students get jobs they don't like?"
    MYU "那么，有钱的学生会得到他们不喜欢的工作吗？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:420
translate zh qst_HumanExp_6_cityTour_69419140:

    # MC @ think "Uhh, that doesn't really happen."
    MC @ think "呃，这通常不会发生。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:421
translate zh qst_HumanExp_6_cityTour_092e4223_3:

    # MYU "...Why?"
    MYU "...为什么？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:422
translate zh qst_HumanExp_6_cityTour_b8e27f65:

    # MC @ talk "Because it's expected that those students will fill in for their parents when they're gone."
    MC @ talk "因为预计这些学生将在父母离开后接替他们的位置。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:423
translate zh qst_HumanExp_6_cityTour_a5acadba:

    # MYU "But what if they're dumb?"
    MYU "但如果他们很笨呢？"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:424
translate zh qst_HumanExp_6_cityTour_0d40bee1:

    # MC @ smile "Well, bad luck for all of us I guess!"
    MC @ smile "嗯，那对我们大家来说都是坏运气！"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:425
translate zh qst_HumanExp_6_cityTour_5fc0802e:

    # MYU "Except the dumb person?"
    MYU "除了那个笨人？"

