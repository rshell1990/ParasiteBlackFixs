    MC @ talk "米尤，在这里等着，我去找东西让你藏身。"

# game/data/world_quests/side/novaras/TheHumanExperience/scr.rpy:901
translate zh qst_HumanExp_12_goHunting_13e96976:

    # MYU @ talk "No... 米尤... help."
    MYU @ talk "不...米尤...帮忙。"

