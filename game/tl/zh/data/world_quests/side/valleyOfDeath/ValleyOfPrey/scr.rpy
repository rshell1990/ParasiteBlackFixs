

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:4
translate zh qst_ValleyOfPrey_93f8fa7b:

    # VES @ smile_talk "Good!"
    VES @ smile_talk "很好！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:5
translate zh qst_ValleyOfPrey_40e98cec:

    # VES @ talk "Give me a moment to get my stuff..."
    VES @ talk "给我点时间拿装备..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:7
translate zh qst_ValleyOfPrey_f3afe333:

    # "维斯 pushed open the flap of her tent as she headed inside of it once again. My thoughts turned to the Skorn."
    "维斯再次掀开帐篷门帘走了进去，我的思绪转向了斯考恩兽。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:8
translate zh qst_ValleyOfPrey_00ba4f91:

    # "I had heard about them in class, the great desert bison that roamed the harsh Valley of Death but had never seen one before with my own eyes."
    "课堂上听说过它们——那些游荡在残酷死亡谷的巨大沙漠野牛，但我从未亲眼见过。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:13
translate zh qst_ValleyOfPrey_8917f7b8:

    # "维斯 quickly returned holding her sharpened axes, a spear, and other such equipment."
    "维斯很快回来了，拿着她磨利的斧头、长矛和其他装备。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:14
translate zh qst_ValleyOfPrey_ea1b9968:

    # VES @ talk "Are you ready?"
    VES @ talk "准备好了吗？"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:15
translate zh qst_ValleyOfPrey_69b977f8:

    # MC @ talk "As I’ll ever be."
    MC @ talk "随时可以。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:16
translate zh qst_ValleyOfPrey_ddd012a7:

    # VES @ talk "It’s at least an hour or so trek on foot... I’ve got water but be prepared, the desert is harsher than you know."
    VES @ talk "步行至少要一小时...我带了水，但做好准备，沙漠比你想象的更残酷。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:17
translate zh qst_ValleyOfPrey_b9615875:

    # MC @ talk "... I think I can speed things up."
    MC @ talk "...我想我能加快速度。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:21
translate zh qst_ValleyOfPrey_41855953:

    # "维斯’ eyes widened and she flushed red watching me strip off my clothes in front of her."
    "维斯眼睛瞪大，看着我当她的面脱衣服，脸涨得通红。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:22
translate zh qst_ValleyOfPrey_7830f23f:

    # VES @ surp_talk "W-What are you doing?!"
    VES @ surp_talk "你-你在干什么？！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:23
translate zh qst_ValleyOfPrey_a90fa2cc:

    # "维斯的 eyes stared down at the cock dangling in front of her."
    "维斯的眼睛盯着在她面前晃荡的肉棒。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:24
translate zh qst_ValleyOfPrey_6893e75d:

    # MC @ talk "I’m going to transform."
    MC @ talk "我要变形了。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:25
translate zh qst_ValleyOfPrey_c9cfd6f3:

    # MC @ talk "I can get us across the desert and back much faster in my other form."
    MC @ talk "用另一种形态我能更快带我们穿越沙漠往返。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:26
translate zh qst_ValleyOfPrey_5a9db378:

    # "Turning paler white than I had ever seen her before, 维斯 looked away anxiously."
    "维斯的脸色变得比以往任何时候都苍白，她焦虑地移开视线。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:27
translate zh qst_ValleyOfPrey_f37a4c98:

    # VES @ surp_talk "I... Yes, that makes sense."
    VES @ surp_talk "我...是的，有道理。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:29
translate zh qst_ValleyOfPrey_49a9f33d:

    # "As I took off the last of my clothes, now accustomed to the once agonizing, brutal transformation after some painful ‘adjustments’..."
    "当我脱下最后一件衣服时，经过一些痛苦的‘调整’，现在已经习惯了曾经折磨人的残酷变形..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:31
translate zh qst_ValleyOfPrey_cb457db2:

    # "I changed myself into my second form in record time."
    "我以创纪录的速度变成了第二形态。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:36
translate zh qst_ValleyOfPrey_72b75bad:

    # MC "Are you ready?"
    MC "准备好了吗？"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:37
translate zh qst_ValleyOfPrey_630a7504:

    # VES @ surp_talk "How will you—"
    VES @ surp_talk "你要怎么——"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:38
translate zh qst_ValleyOfPrey_6678a294:

    # VES @ surp_talk "H-HEY!"
    VES @ surp_talk "嘿-嘿！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:39
translate zh qst_ValleyOfPrey_9eb609df:

    # "I scoped 维斯 up under my arm."
    "我把维斯夹在腋下。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:40
translate zh qst_ValleyOfPrey_29bb6266:

    # MC "Which way?"
    MC "哪个方向？"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:41
translate zh qst_ValleyOfPrey_6000cfb1:

    # VES @ surp_talk "... T-That way."
    VES @ surp_talk "...那-那边。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:48
translate zh qst_ValleyOfPrey_45ffaade:

    # "维斯 pointed in the direction, and I followed."
    "维斯指向那个方向，我跟了上去。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:49
translate zh qst_ValleyOfPrey_a057a701:

    # "With 维斯 in my arms, I quickly began to propel us across the hot desert sands with the thick tentacles swinging us across like vines, covering miles in mere moments."
    "抱着维斯，我迅速用粗壮的触手像藤蔓一样摆荡着推动我们穿越炎热的沙漠，片刻间就跨越了数英里。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:50
translate zh qst_ValleyOfPrey_59b56fc8:

    # "维斯 seemed slightly unsure of what to do as she was cradled in my arms."
    "维斯被我抱在怀里，似乎有点不知所措。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:51
translate zh qst_ValleyOfPrey_d63ba394:

    # "I towered over her in this form, and no doubt this shape still had some strange, terrifying quality to those unaccustomed to seeing it."
    "在这个形态下我高耸于她之上，毫无疑问，对于不习惯看到它的人来说，这个形态仍然有些奇怪、可怕的特质。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:52
translate zh qst_ValleyOfPrey_f9c04db8:

    # "Still, as the sun beat on my back and the cool breeze passed us by, she seemed to relax, curiously tracing her fingers along the hard exterior of my flesh inquisitively."
    "尽管如此，当阳光灼烧我的背部，凉风拂过我们时，她似乎放松下来，好奇地用手指探究地划过我坚硬的肉体外表。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:54
translate zh qst_ValleyOfPrey_44e2d2f3:

    # "Finally, we arrived upon some great flat valley where just across the ridge below revealed a great herd of Skorn."
    "终于，我们到达了一片广阔的平坦山谷，就在下方山脊对面，出现了一大群斯考恩兽。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:55
translate zh qst_ValleyOfPrey_d83ff686:

    # "Huge towering three-eyed beasts with legs the size of small buildings, their long trunks pushed deep down into the desert, finding water in minutes that would take men hours to dig far enough down to find."
    "巨大的三眼巨兽，腿如小型建筑般粗壮，它们的长鼻深深插入沙漠，几分钟内就能找到水源，而人类需要挖掘数小时才能达到足够深度找到水。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:56
translate zh qst_ValleyOfPrey_7104dc8c:

    # MC "...They are... bigger than I imagined."
    MC "...它们...比我想象的还要大。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:57
translate zh qst_ValleyOfPrey_5fb0397f:

    # VES "Come... We must take the strongest one."
    VES "来...我们必须猎取最强壮的那头。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:58
translate zh qst_ValleyOfPrey_e1f6d48f:

    # MC "Huh? Why do you—"
    MC "嗯？你为什么——"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:59
translate zh qst_ValleyOfPrey_1eb152e3:

    # VES "To go for the weak or young is shameful..."
    VES "猎杀弱小或年幼者是可耻的..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:60
translate zh qst_ValleyOfPrey_f55dd0c3:

    # VES "When we hunt, {i}what{/i} we hunt is of great importance."
    VES "当我们狩猎时，{i}猎取什么{/i}至关重要。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:61
translate zh qst_ValleyOfPrey_50e59b58:

    # "Readying her axes, 维斯 scanned across the many Skorn before pointing out one of the largest amongst them with a slightly darker complexion."
    "维斯准备好斧头，扫视众多斯考恩兽，然后指向其中肤色略深的最大的一头。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:62
translate zh qst_ValleyOfPrey_f992c33d:

    # "Its ram-like horns formidable in size, made it appear like some ancient god of the desert."
    "它公羊般的角尺寸惊人，使它看起来像沙漠的某种古老神灵。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:63
translate zh qst_ValleyOfPrey_75419991:

    # MC "What’s the plan to—"
    MC "计划是——"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:64
translate zh qst_ValleyOfPrey_42a2e82a:

    # "Before I could finish my sentence, 维斯 charged like a woman possessed with both her axes towards the colossal Skorn."
    "没等我说完，维斯就像着了魔一样双手持斧冲向那头巨大的斯考恩兽。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:65
translate zh qst_ValleyOfPrey_0c5d5516:

    # VES "GRGHHHHH!"
    VES "嘎啊啊啊！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:66
translate zh qst_ValleyOfPrey_93c13848:

    # MC "(... Well, fuck.)"
    MC "(...好吧，妈的。)"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:67
translate zh qst_ValleyOfPrey_94f9d7ee:

    # "Following after her, the other now spooked Skorn noticing her presence instinctively began to flee."
    "跟在她后面，其他受惊的斯考恩兽注意到她的存在，本能地开始逃跑。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:68
translate zh qst_ValleyOfPrey_8bff3b26:

    # "Soon there was a massive stampede of the beasts fleeing across the desert plains."
    "很快，兽群大规模奔逃，穿越沙漠平原。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:69
translate zh qst_ValleyOfPrey_cc06e623:

    # "Following behind 维斯, I quickly grabbed her once again as the stampede hurried shoulder to shoulder, often smashing and barging violently into each other as they fled."
    "跟在维斯后面，我再次迅速抓住她，兽群肩并肩匆忙奔逃，经常在逃跑时猛烈碰撞冲撞彼此。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:70
translate zh qst_ValleyOfPrey_a7f5d255:

    # VES "Don’t lose him!"
    VES "别跟丢它！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:71
translate zh qst_ValleyOfPrey_b494e7db:

    # "维斯 shouted, pointing towards the great Skorn whose trunk smashed into the bulk of a smaller Skorn sending it toppling over onto its side as it fled from us."
    "维斯大喊道，指向那头巨大的斯考恩兽，它的鼻子撞到一头较小斯考恩兽的身体，使其在逃离我们时侧翻倒地。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:72
translate zh qst_ValleyOfPrey_c0795b88:

    # VES "Quick! Throw me!"
    VES "快！把我扔过去！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:73
translate zh qst_ValleyOfPrey_95e59f81:

    # MC "What?!"
    MC "什么？！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:74
translate zh qst_ValleyOfPrey_8e960187:

    # VES "Just do it!"
    VES "照做！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:75
translate zh qst_ValleyOfPrey_985e4c6e:

    # "Throwing 维斯 hurtling through the air, she climbed onto the back of one of the Skorn and scaled her way up its hide."
    "将维斯抛向空中，她爬上一头斯考恩兽的背部，沿着它的皮毛向上攀爬。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:76
translate zh qst_ValleyOfPrey_0d1d99ed:

    # "I watched with surprise as she leapt from Skorn to Skorn, gaining on the great beast with greater speed than even I was!"
    "我惊讶地看着她在斯考恩兽之间跳跃，以比我还快的速度逼近那头巨兽！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:77
translate zh qst_ValleyOfPrey_526e6bcb:

    # "Narrowly dodging the crazed Skorn, the two of us were finally catching up and close behind the when suddenly..."
    "勉强躲开发狂的斯考恩兽，我们俩终于追上并接近了它，这时突然..."

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:78
translate zh qst_ValleyOfPrey_16c73f3f:

    # "The ground began to vibrate greater than even the herds stamping could cause."
    "地面开始震动，其剧烈程度甚至超过了兽群践踏所能引起的。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:79
translate zh qst_ValleyOfPrey_79d5ca08:

    # "The sand ahead of us began to move as a small whirlpool formed and seemed to sink the ground, dragging nearby Skorn into its pull."
    "我们前方的沙子开始移动，形成一个小漩涡，似乎使地面下沉，将附近的斯考恩兽拖入其中。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:84
translate zh qst_ValleyOfPrey_47e05a7e:

    # "Suddenly, a great beast flung itself out of the sands and collided with our Skorn, its huge jaws clasping down onto the beast as it slammed it into the desert sands."
    "突然，一头巨兽从沙中跃出，与我们的斯考恩兽相撞，它巨大的下颚咬住这头野兽，将其猛砸进沙漠中。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:85
translate zh qst_ValleyOfPrey_ee1cc2b0:

    # VES "It’s a {i}bazark!{/i}"
    VES "是{i}巴扎克兽！{/i}"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:87
translate zh qst_ValleyOfPrey_98cf9cee:

    # "维斯 cried out in disbelief, watching as the Skorn screamed out and tried to escape before the bazark slammed its teeth around the throat of the Skorn, violently squeezing and shaking many times till it snapped its neck."
    "维斯难以置信地喊道，看着斯考恩兽尖叫着试图逃跑，然后巴扎克兽的牙齿咬住斯考恩兽的喉咙，猛烈挤压摇晃多次直至扭断其脖颈。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:88
translate zh qst_ValleyOfPrey_42cd1029:

    # "Digging its colossal jaws into the soft hide of the Skorn, it gnashed and tore as it swallowed down pieces of its flesh."
    "它巨大的下颚咬进斯考恩兽柔软的皮毛，咀嚼撕扯，吞下大块血肉。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:89
translate zh qst_ValleyOfPrey_1e436363:

    # "Then with a glint in its eye it noticed us still stood there rooted to the ground watching, and turned its attention towards us, snarling malevolently."
    "接着它眼中闪过一丝光芒，注意到我们仍站在原地观看，便将注意力转向我们，恶意地咆哮着。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:91
translate zh qst_ValleyOfPrey_345b9452:

    # MC "VES!"
    MC "维斯！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:112
translate zh qst_ValleyOfPrey_0eaf0c74:

    # "As the bloodied and battered bazark shook its head in a daze, blood dripping down its face onto the hot desert sand, 维斯 turned to me and shouted breathlessly."
    "当血迹斑斑、伤痕累累的巴扎克兽恍惚地摇头，鲜血从脸上滴落到滚烫的沙漠沙地上时，维斯转向我，上气不接下气地喊道。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:113
translate zh qst_ValleyOfPrey_0733abdf:

    # VES @ talk "{i}*Huff*{/i} It just won’t stop coming!"
    VES @ talk "{i}*喘气*{/i}它就是不停下来！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:114
translate zh qst_ValleyOfPrey_a09b5db4:

    # "As the bazark continued to shake violently, it pulled up enough of its hide to reveal the soft underbelly of the great beast, revealing some beating organ covered below the thin flesh."
    "巴扎克兽继续剧烈摇晃，掀起了足够的皮毛，露出了巨兽柔软的腹部，显露出薄薄皮层下覆盖着的某个搏动器官。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:115
translate zh qst_ValleyOfPrey_75c5b05a:

    # MC "...维斯 I have an idea!"
    MC "...维斯我有个主意！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:116
translate zh qst_ValleyOfPrey_1ca27af3:

    # VES @ talk "What are you—"
    VES @ talk "你要——"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:117
translate zh qst_ValleyOfPrey_bef099ca:

    # VES @ talk "Whoa!"
    VES @ talk "哇！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:119
translate zh qst_ValleyOfPrey_8643fe33:

    # "Grabbing 维斯 once again, with frantic motions I began to claw my way up the bazark, my tentacles slamming into the sides of its flesh, tearing out chunks of it as I swung towards the top of the thing."
    "再次抓住维斯，我疯狂地开始爬上巴扎克兽，我的触手猛击它身体两侧，撕下大块血肉，同时向这东西的顶部摆荡。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:120
translate zh qst_ValleyOfPrey_0daf41b6:

    # "Its claws flailed and slashed around frantically as though we were some itch it needed to scratch, only narrowly missing us as the thing took a swipe at itself, leaving bloody claw marks on its own scaled flesh."
    "它的爪子疯狂地挥舞劈砍，仿佛我们是需要挠掉的痒处，这东西挥爪抓向自己时险些击中我们，在自己鳞片皮肤上留下血淋淋的爪痕。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:121
translate zh qst_ValleyOfPrey_6110d4ad:

    # "Finally reaching the top of the bazark, 维斯 slammed her axes into the flesh to hold herself in place as the thing tried once more to shake us off. 维斯 looked to me uncertain of what to do next."
    "终于到达巴扎克兽顶部，维斯将斧头砸进肉里以固定自己，这东西再次试图甩掉我们。维斯看着我，不确定下一步该怎么做。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:122
translate zh qst_ValleyOfPrey_608e1009:

    # VES "Now what?"
    VES "现在呢？"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:123
translate zh qst_ValleyOfPrey_aabd5273:

    # MC "I need you to go for its eyes!"
    MC "我需要你去攻击它的眼睛！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:124
translate zh qst_ValleyOfPrey_abaae829:

    # VES "What!"
    VES "什么！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:125
translate zh qst_ValleyOfPrey_0e70d411:

    # MC "Its eyes! Just go for its eyes!"
    MC "它的眼睛！就去攻击它的眼睛！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:126
translate zh qst_ValleyOfPrey_498ce095:

    # "Quickly, I swung in a circular descent towards the ground once again, feeling the rush of cool air and kicked up desert sand as I felt one of its swinging claws narrowly miss me, forcing me to drop and roll harshly onto the hot desert sand."
    "迅速地，我再次环形下降摆向地面，感受到凉风的冲击和扬起的沙漠沙尘，同时感觉到它摆动的一只爪子险些击中我，迫使我在滚烫的沙漠沙地上重重跌落翻滚。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:127
translate zh qst_ValleyOfPrey_b8af20a2:

    # "Under normal circumstances, a few bones would have been broken, but thanks to the parasite’s hard exterior I was left a little bruised but mostly unscathed."
    "正常情况下，几根骨头可能已经断了，但由于寄生体的坚硬外表，我只受了些擦伤，基本无恙。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:128
translate zh qst_ValleyOfPrey_b9703b57:

    # "Struggling to stay still on the bazark’s back as it tried desperately to rip her from itself, 维斯 dragged herself forward with swings of her axes."
    "维斯在巴扎克兽背上挣扎着保持不动，而它拼命想把她扯下来，她借助斧头的挥动拖着自己向前。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:129
translate zh qst_ValleyOfPrey_c4a82167:

    # "Piercing through the flesh to anchor herself in place till she made it to the front of the beast’s reptilian head."
    "刺穿皮肉以固定自己，直到她到达这野兽爬行动物般的头部前方。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:130
translate zh qst_ValleyOfPrey_8516d036:

    # "Its eyes twitched and focused on her when it noticed her lurking there above it, axes raised."
    "当它注意到她潜伏在上方举起斧头时，它的眼睛抽动着聚焦于她。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:131
translate zh qst_ValleyOfPrey_0b90ec4e:

    # "维斯 cried out as she slammed her axe into soft eye of the bazark but there was little it could do."
    "维斯大喊着将斧头砸进巴扎克兽柔软的眼睛，但它无能为力。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:132
translate zh qst_ValleyOfPrey_39aa3e79:

    # "Throwing itself backwards, the great beast flailed helplessly, unsure of what to do with its arms, unable to reach the orc on its head."
    "巨兽向后猛仰，无助地挥舞着，不知该如何使用手臂，无法够到头上的兽人。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:133
translate zh qst_ValleyOfPrey_1063faa4:

    # "For a moment, the thing seemed ready to slam itself onto its back and submerge back into the depths of the desert sands, if only to get rid of the orc still hacking away at its eyes."
    "有一刻，这东西似乎准备仰面倒地，重新沉入沙漠深处，只为了摆脱仍在劈砍它眼睛的兽人。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:134
translate zh qst_ValleyOfPrey_3a444327:

    # "But now, with its underbelly exposed once again I lunged forward, claws ready as I slashed through the flesh and forced myself inside the beast."
    "但现在，随着它的腹部再次暴露，我猛扑向前，利爪准备就绪，撕裂皮肉，强行进入野兽体内。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:135
translate zh qst_ValleyOfPrey_8092cf6c:

    # "It now changed course in blind agonising panic and bellowed forward, obviously aware of my presence but it was again too late."
    "它现在在盲目的痛苦恐慌中改变方向，向前咆哮，显然意识到我的存在，但再次为时已晚。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:136
translate zh qst_ValleyOfPrey_0ca8dfbe:

    # "Slashing and clawing my way through the bazark’s soft flesh with ease, it began desperately to claw at the gaping wound in its soft underbelly to try and pull me out, but it was impossible."
    "轻松地撕扯抓穿巴扎克兽柔软的肉体，它开始绝望地抓挠柔软腹部上裂开的伤口，试图把我拉出来，但这是不可能的。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:137
translate zh qst_ValleyOfPrey_f8711ba7:

    # "Forcing my way through the back of the beast I tore my way out in a spray of violence and blood, thick chunks of red meat dropped down onto the coarse sand floor from the gaping hole in which I had emerged from."
    "强行穿过野兽背部，我在暴力和血液的喷溅中撕扯而出，大块红色肉块从我出现的裂口掉落到粗糙的沙地上。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:139
translate zh qst_ValleyOfPrey_059bc863:

    # "With one final whimpering howl, the thing slammed dead into the hot sand, its mouth hanging open and quivering for a final few sickening motions in defeat."
    "随着最后一声呜咽般的嚎叫，这东西重重砸进滚烫的沙地中死去，嘴巴张开，在失败中颤抖着做出最后几下令人作呕的动作。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:145
translate zh qst_ValleyOfPrey_03637734:

    # MC "{i}*Huff*{/i} 维斯! Are you okay?"
    MC "{i}*喘气*{/i} 维斯！你没事吧？"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:146
translate zh qst_ValleyOfPrey_8d8378a9:

    # "I looked around frantically for her."
    "我疯狂地四处寻找她。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:147
translate zh qst_ValleyOfPrey_e63f8036:

    # MC "维斯!"
    MC "维斯！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:152
translate zh qst_ValleyOfPrey_e746bb12:

    # VES @ talk "I’m alright..."
    VES @ talk "我没事……"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:153
translate zh qst_ValleyOfPrey_31805282:

    # MC "I can’t believe we actually managed to bring that thing down!"
    MC "真不敢相信我们居然真的把那家伙干掉了！"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:154
translate zh qst_ValleyOfPrey_216df0f5:

    # "Stepping forward towards the mouth of the dead beast, 维斯 reached down to carve out and take one of its scales."
    "维丝走向那头死去的巨兽嘴边，俯身割下并取走了一片鳞片。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:155
translate zh qst_ValleyOfPrey_989a4394:

    # VES @ talk "For such a prized kill as this, we’d normally take the skull to honour a War Hall."
    VES @ talk "像这样珍贵的猎物，我们通常会把它的头骨带回去，用来装饰战争大厅以示荣耀。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:156
translate zh qst_ValleyOfPrey_0d3e54d4:

    # VES @ talk "{i}*Sigh*{/i} But I suppose this will have to do..."
    VES @ talk "{i}叹气{/i} 不过我想，有这个也够了……"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:157
translate zh qst_ValleyOfPrey_42d4318b:

    # "Looking over at the dead Skorn we were hunting earlier, I glanced at 维斯 uncertainly."
    "我望向之前我们猎杀的那只死去的斯考恩，不确定地瞥了维丝一眼。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:158
translate zh qst_ValleyOfPrey_7c7f45a7:

    # MC "Hey, how are we going to carry this damn thing back now?"
    MC "嘿，我们现在要怎么把这该死的东西运回去？"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:159
translate zh qst_ValleyOfPrey_91a4bf23:

    # "维斯 looked at me and smiled."
    "维丝看着我，笑了。"

# game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:160
translate zh qst_ValleyOfPrey_5a09e725:

    # MC "... Oh no."
    MC "... 靠."

translate zh strings:

    # game/data/world_quests/side/valleyOfDeath/ValleyOfPrey/scr.rpy:47
    old "Valley of Death"
    new "死亡谷"

