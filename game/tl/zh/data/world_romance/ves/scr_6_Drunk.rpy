translate zh rom_Ves_6_Drunk_366f724b:

    # MC @ talk "There’s more to life than death, 维斯."
    MC @ talk "生命不止有死亡，维斯。"
    

# game/data/world_romance/ves/scr_6_Drunk.rpy:167
translate zh rom_Ves_6_Drunk_3292e2bf:

    # VES @ talk "... I’d like you to show me this one day."
    VES @ talk "... 我希望有一天你能向我展示。"
    

# game/data/world_romance/ves/scr_6_Drunk.rpy:169
translate zh rom_Ves_6_Drunk_6d5279b0:

