    VES @ talk "对我的族人来说，在战斗中为保护我们所爱之人... 我们在乎之人而死..."
    

# game/data/world_romance/ves/scr_6_Drunk.rpy:158
translate zh rom_Ves_6_Drunk_e9ffc2f1:

    # VES @ talk "There is no better way to die."
    VES @ talk "没有比这更好的死法了。"
    

# game/data/world_romance/ves/scr_6_Drunk.rpy:161
translate zh rom_Ves_6_Drunk_b9fc2750:

    # VES @ talk "... Strange."
    VES @ talk "... 奇怪。"
    

# game/data/world_romance/ves/scr_6_Drunk.rpy:162
translate zh rom_Ves_6_Drunk_e6ddc3fe:

    # MC @ talk "What, why is that strange?"
    MC @ talk "什么，为什么奇怪？"
    

