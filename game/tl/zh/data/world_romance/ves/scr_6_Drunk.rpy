    VES @ talk "这是个古老的传统……有些人不喜欢，但……"
    

# game/data/world_romance/ves/scr_6_Drunk.rpy:182
translate zh rom_Ves_6_Drunk_988d95b0:

    # MC @ smile "I can imagine!"
    MC @ smile "我能想象！"
    

# game/data/world_romance/ves/scr_6_Drunk.rpy:183
translate zh rom_Ves_6_Drunk_a3045e18:

    # "维斯 shrugged apathetically."
    "维斯漠不关心地耸了耸肩。"
    

